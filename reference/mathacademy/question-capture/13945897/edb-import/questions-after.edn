10\\cdot 4}{2} \\\\  & =\\frac{40}{2} \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252362 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6c58537-344e-5842-b68c-d9b5a9d7ca96" :knowledge-point/title "Calculating the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e227642-a7f7-5639-927d-f35b3924cd12" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186252364} {:answer/id #uuid "1a825caa-2702-5d42-a761-ce44df9e5919" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186252365} {:answer/id #uuid "b709ece3-ef3d-5228-a2fa-2f7462cb5122" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186252366} {:answer/id #uuid "a6d490b8-74a6-5973-8970-38bc7fc5ce3b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186252367} {:answer/id #uuid "f6aceb63-aeba-5577-8036-1b4d70e2f91e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252368}] :answer-field/correct {:answer/id #uuid "6e227642-a7f7-5639-927d-f35b3924cd12" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186252364} :answer-field/id #uuid "a4ddf02c-14c2-5620-8060-cdbbbd12c0be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252363}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "90c32b9e-f450-5edd-b07c-6f6a0047c39a" :question/math-academy-id "q-53147" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/b8fdc38797fd763fbffccccd7ca7e6cdc39ce99445440e9ebb918ef11d5c23d9.png)\n\nFind the area of the triangle $△ABC.$\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as\n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\nwhere $b$ is a base and $h$ is the corresponding height.\n\nWe can see that the base is $BC=4$ and the corresponding height is $AH=6.$ Therefore, the area is\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{4\\cdot 6}{2} \\\\  & =\\frac{24}{2} \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252369 :knowledge-point/_questions [{:knowledge-point/id #uuid "b6c58537-344e-5842-b68c-d9b5a9d7ca96" :knowledge-point/title "Calculating the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddbb53be-242c-523d-b8bb-ee6b732eabd8" :answer/type {:db/ident :answer.type/math} :answer/value "20\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186252371} {:answer/id #uuid "c5985773-b216-5fc1-babc-ad7b6ad233b9" :answer/type {:db/ident :answer.type/math} :answer/value "60\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186252372} {:answer/id #uuid "eb07f978-ce3f-5462-81c7-eca1dd8137f6" :answer/type {:db/ident :answer.type/math} :answer/value "35\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186252373} {:answer/id #uuid "7c76cf22-e394-5305-b783-6f8ee444fd8b" :answer/type {:db/ident :answer.type/math} :answer/value "30\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186252374} {:answer/id #uuid "006f0705-1138-5692-8391-a8489a0af9bb" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186252375}] :answer-field/correct {:answer/id #uuid "7c76cf22-e394-5305-b783-6f8ee444fd8b" :answer/type {:db/ident :answer.type/math} :answer/value "30\\,{\\text{m}}^{2}" :db/id #edb/ref 17592186252374} :answer-field/id #uuid "9ac34b03-c36d-5af9-bd41-28c67dafa6a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252370}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "823b1b37-db73-5eaa-b884-1ecc4dfb7bdf" :question/math-academy-id "q-53154" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/40a654166838ab16d5dc300e3c0eab894a6754a47edc68051336f4ea2a5db2e8.png)\n\nWhat is the area of the triangle $△ABC$ shown above?\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is a base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the base is \n\n$$\nb=AB=5\\,\\text{m}\n$$\n\nand the corresponding height is \n\n$$\nh=12\\,\\text{m}.\n$$\n\nTherefore, the area is\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{5\\cdot 12}{2} \\\\  & =\\frac{60}{2} \\\\  & =30\\,{\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252376 :knowledge-point/_questions [{:knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155204d3-ad95-582d-a551-ac33f557a565" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186252378} {:answer/id #uuid "016a3e56-b5e7-54f5-9362-6e0a3485b714" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252379} {:answer/id #uuid "6f625826-c1e0-5901-9a56-39107b441684" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186252380} {:answer/id #uuid "f9ccccf7-2576-57c7-9818-470a24ddcbe8" :answer/type {:db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186252381} {:answer/id #uuid "761308d7-1146-5103-a57e-b450fe2106d2" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186252382}] :answer-field/correct {:answer/id #uuid "016a3e56-b5e7-54f5-9362-6e0a3485b714" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186252379} :answer-field/id #uuid "959f1786-70d2-5d8e-b5e2-91f82f9d8441" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252377}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "473c8bba-775b-550a-837b-454ea2b658e8" :question/math-academy-id "q-87801" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13945897/assets/f18be4b42008423fe08b165fea4b3807b247813112b92a6ad0932c07a33ba8b6.png)\n\nWhat is the area of the right triangle $ABC$ shown above?" :question/worked-solution "Since $m∠A=m∠C$, we have an isosceles triangle, where $AB=BC.$\n\nHence, the area of the triangle is \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot {4}^{2} \\\\  & =\\frac{1}{2}\\cdot 16 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186252383 :knowledge-point/_questions [{:knowledge-point/id #uuid "6445834c-7788-5427-a72c-30b06cc8e6ab" :knowledge-point/title "Calculating the Area of an Isosceles Right Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c1f038-93e6-5440-be66-4a7801a7f464" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186252385} {:answer/id #uuid "fdd180c5-293e-557d-bceb-cfc1bcf577e3" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186252386} {:answer/id #uuid "c0ed016c-6c54-5548-a51e-b8b7ae2f0427" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186252387} {:answer/id #uuid "368f8ecf-69c9-590e-a865-51e71e953a15" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186252388} {:answer/id #uuid "89f04961-66c9-5bd5-abb8-ea8fe203aa07" :answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186252389}] :answer-field/correct {:answer/id #uuid "fdd180c5-293e-557d-bceb-cfc1bcf577e3" :answer/type {:db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186252386} :answer-field/id #uuid "82593235-1179-5b02-bec2-3a04b6e9765a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 1759218625238