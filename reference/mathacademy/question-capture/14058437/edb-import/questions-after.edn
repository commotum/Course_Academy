#{[{:db/id #edb/ref 17592186172519 :knowledge-point/_questions [{:knowledge-point/id #uuid "be11193b-a241-5812-a1c1-54d233ae9ddd" :knowledge-point/title "Determining the Value of a Binomial Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be00d555-2d9c-54c0-853b-66de575cea0b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186171080} {:answer/id #uuid "d2a670d6-e686-5c39-be96-25fdea579604" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186171081} {:answer/id #uuid "f60adffc-b735-5787-8639-a4d08eea2662" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186171082} {:answer/id #uuid "55b370f1-ab37-5cbf-9b0b-53c3176ab320" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186171083} {:answer/id #uuid "7cd618f0-1f9a-5e78-a7c2-b9f3803af94b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186171084}] :answer-field/correct {:answer/id #uuid "7cd618f0-1f9a-5e78-a7c2-b9f3803af94b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186171084} :answer-field/id #uuid "edfd8209-ca91-5906-866e-8343af53df60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171079}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "06ddb4b2-4449-51a2-b958-2943b449bfc6" :question/math-academy-id "q-69653" :question/problem "Use Pascal's triangle to determine the value of $(\\genfrac{}{}{0pt}{}{5}{4}).$" :question/worked-solution "To find the value of $(\\genfrac{}{}{0pt}{}{5}{4}),$ we need to find the number that is located in row $5$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $5$ and position $4$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & 1 \\\\  &  &  &  &  &  & 1 &  & 1 \\\\  &  &  &  &  & 1 &  & 2 &  & 1 \\\\  &  &  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  &  &  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\  &  & 1 &  & 5 &  & 10 &  & 10 &  & 5 &  & 1 \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $(\\genfrac{}{}{0pt}{}{5}{4})=5.$"}] [{:db/id #edb/ref 17592186336774 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249cb78e-5b68-58eb-a78c-d49edae20131" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186336776} {:answer/id #uuid "888968b8-e65a-51dd-8f75-2b83a4c7c269" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186336777} {:answer/id #uuid "57b0513f-ccaf-5d85-a461-c2396b53e628" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186336778} {:answer/id #uuid "682df283-50d6-55ad-a59e-e4e9ab4876cd" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186336779} {:answer/id #uuid "bcc7f4bb-5f12-50ba-8093-d6403531e4fe" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186336780}] :answer-field/correct {:answer/id #uuid "888968b8-e65a-51dd-8f75-2b83a4c7c269" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186336777} :answer-field/id #uuid "a87f4679-1131-5e52-83e3-fe60c7dc19e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336775}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "077c732c-f40a-5a81-8fab-6738873b6464" :question/math-academy-id "q-70307" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{7}{6}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=6.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{7}{6}) & =\\frac{7!}{(7-6)!\\cdot 6!} \\\\  & =\\frac{7\\cdot 6!}{1!\\cdot 6!} \\\\  & =\\frac{7\\cdot \\cancel{6!}}{1\\cdot \\cancel{6!}} \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336781 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9520f682-47fd-51d1-a6f0-8092bcf2dcab" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186336783} {:answer/id #uuid "3dcdb364-197e-5e2f-a5b7-102719be7723" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336784} {:answer/id #uuid "2742539a-60d4-5165-89a0-3dc974331d54" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186336785} {:answer/id #uuid "fa58f065-0c26-5359-8f7d-803898a196fd" :answer/type {:db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186336786} {:answer/id #uuid "6f352359-45fd-5284-b659-72c5d4b96647" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186336787}] :answer-field/correct {:answer/id #uuid "2742539a-60d4-5165-89a0-3dc974331d54" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186336785} :answer-field/id #uuid "e4a44f70-53ab-5374-9d4a-110ecbb4a93e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336782}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1fe678fa-9c18-52f9-8e88-784061527928" :question/math-academy-id "q-70324" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{8}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=8$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{8}{3}) & =\\frac{8!}{(8-3)!\\cdot 3!} \\\\  & =\\frac{8\\cdot 7\\cdot 6\\cdot 5!}{5!\\cdot 3!} \\\\  & =\\frac{8\\cdot 7\\cdot \\cancel{6}\\cdot \\cancel{5!}}{\\cancel{5!}\\cdot \\cancel{6}} \\\\  & =8\\cdot 7 \\\\  & =56.\\end{aligned}\n$$"}]}
