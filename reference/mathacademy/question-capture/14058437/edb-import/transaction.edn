[{:db/id [:question/math-academy-id "q-69653"] :question/problem "Use Pascal's triangle to determine the value of $(\\genfrac{}{}{0pt}{}{5}{4}).$" :question/worked-solution "To find the value of $(\\genfrac{}{}{0pt}{}{5}{4}),$ we need to find the number that is located in row $5$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $5$ and position $4$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & 1 \\\\  &  &  &  &  &  & 1 &  & 1 \\\\  &  &  &  &  & 1 &  & 2 &  & 1 \\\\  &  &  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  &  &  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\  &  & 1 &  & 5 &  & 10 &  & 10 &  & 5 &  & 1 \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $(\\genfrac{}{}{0pt}{}{5}{4})=5.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-70307/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "249cb78e-5b68-58eb-a78c-d49edae20131" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-70307/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "888968b8-e65a-51dd-8f75-2b83a4c7c269" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-70307/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "bcc7f4bb-5f12-50ba-8093-d6403531e4fe" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-70307/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "682df283-50d6-55ad-a59e-e4e9ab4876cd" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-70307/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "57b0513f-ccaf-5d85-a461-c2396b53e628" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-70307/selection" :answer-field/id #uuid "a87f4679-1131-5e52-83e3-fe60c7dc19e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70307/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-70307/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-70307/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-70307/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" "q-70307/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-70307/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee"] :db/ensure [:answer-field/validate]} {:db/id "q-70307" :question/id #uuid "077c732c-f40a-5a81-8fab-6738873b6464" :question/math-academy-id "q-70307" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{7}{6}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=6.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{7}{6}) & =\\frac{7!}{(7-6)!\\cdot 6!} \\\\  & =\\frac{7\\cdot 6!}{1!\\cdot 6!} \\\\  & =\\frac{7\\cdot \\cancel{6!}}{1\\cdot \\cancel{6!}} \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70307/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2"] :knowledge-point/questions ["q-70307"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70324/selection/ad7a3824e2b90d316aedd9968e2fdff13c67ee5110546b7a43eeb384aa267fd0" :answer/id #uuid "fa58f065-0c26-5359-8f7d-803898a196fd" :answer/type :answer.type/math :answer/value "112" :db/ensure [:answer/validate]} {:db/id "q-70324/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "6f352359-45fd-5284-b659-72c5d4b96647" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-70324/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "2742539a-60d4-5165-89a0-3dc974331d54" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-70324/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "3dcdb364-197e-5e2f-a5b7-102719be7723" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-70324/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "9520f682-47fd-51d1-a6f0-8092bcf2dcab" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-70324/selection" :answer-field/id #uuid "e4a44f70-53ab-5374-9d4a-110ecbb4a93e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70324/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer-field/choices ["q-70324/selection/ad7a3824e2b90d316aedd9968e2fdff13c67ee5110546b7a43eeb384aa267fd0" "q-70324/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-70324/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" "q-70324/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-70324/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458"] :db/ensure [:answer-field/validate]} {:db/id "q-70324" :question/id #uuid "1fe678fa-9c18-52f9-8e88-784061527928" :question/math-academy-id "q-70324" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{8}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=8$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{8}{3}) & =\\frac{8!}{(8-3)!\\cdot 3!} \\\\  & =\\frac{8\\cdot 7\\cdot 6\\cdot 5!}{5!\\cdot 3!} \\\\  & =\\frac{8\\cdot 7\\cdot \\cancel{6}\\cdot \\cancel{5!}}{\\cancel{5!}\\cdot \\cancel{6}} \\\\  & =8\\cdot 7 \\\\  & =56.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70324/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2"] :knowledge-point/questions ["q-70324"] :db/ensure [:knowledge-point/validate]}]
