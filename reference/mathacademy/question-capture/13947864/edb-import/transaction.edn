\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡\\theta }\\operatorname{sin}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta }{{cos}^{4}⁡\\theta +{cos}^{2}⁡\\theta {sin}^{2}⁡\\theta }=\\operatorname{tan}⁡\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65249/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689"] :knowledge-point/questions ["q-65249"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65248/selection/03484197378e594bfc0047bad4382df3e3fc52c48559336d4bda04c39ac8193f" :answer/id #uuid "4f02f473-9f74-5589-8eb6-5719be61a940" :answer/type :answer.type/math :answer/value "-\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65248/selection/0ecd8130b3138cc0d0b6f7dcff937e8b23344457055155bb5dd25cda061cdc23" :answer/id #uuid "a5faf8a6-1e60-5284-b285-cd4d887becc7" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65248/selection/75692e2af5f10c8a5a9cd964ba7987d08d791913525c7c2f6c47e226c666ec46" :answer/id #uuid "8bad9c67-a453-58bf-b8f0-88a29fd9843e" :answer/type :answer.type/math :answer/value "{cot}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-65248/selection/82c45f4df2439620e53b221a8cd624df48d9a9a6f528bc089ec82dd3f3a9dba5" :answer/id #uuid "02d0d7a6-df9e-5a36-8a57-315f9079fae3" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-65248/selection/1d5624cafe7c20ca810694651cdcfba47ea00ca45f428753634f2d904c5221cf" :answer/id #uuid "c9f67bce-62a0-56c2-8778-209f3a6836a