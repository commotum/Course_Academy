}^{2}⁡x$  from the first two terms:\n\n$$\n{sin}^{2}⁡x{cos}^{2}⁡x+{cos}^{4}⁡x+{sin}^{2}⁡x={cos}^{2}⁡x\\cdot ({sin}^{2}⁡x+{cos}^{2}⁡x)+{sin}^{2}⁡x\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the given expression:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x\\cdot ({sin}^{2}⁡x+{cos}^{2}⁡x)+{sin}^{2}⁡x & ={cos}^{2}⁡x\\cdot 1+{sin}^{2}⁡x \\\\  & ={cos}^{2}⁡x+{sin}^{2}⁡x \\\\  & =1\\end{aligned}\n$$\n\nWe conclude that\n\n$$\n{sin}^{2}⁡x{cos}^{2}⁡x+{cos}^{4}⁡x+{sin}^{2}⁡x=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65243/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b"] :knowledge-point/questions ["q-65243"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119371/selection/30b0ea1e04fd80e15224ff2c947861bdee85317bf4fde3595fa57223b09f7c30" :answer/id #uuid "3e0c90c8-6aa0-5b10-ba66-e7ad1ee52811" :answer/type :answer.type/math :answer/value "1-\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119371/selection/21ebf210dd14508d00b26881ba35644aeff73d34f4ef3f680cdff123b1fe2a55" :answer/id #uuid "e91d17ac-40d2-5dba-a35f-73009ee920ff" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119371/selection/ced7f0bb48d9b88153933bee8c894cdf825178dadf90f2d7fcd34f587d0a87e6" :answer/id #uuid "3f0beb6d-c093-5d35-96c3-0aeca2b47823" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-119371/selection/666c6d7ba3b02659c92dfbb0ecb00485bb7834f6d10d30ed5962175d5affbaac" :answer/id #uuid "36379d93-653f-52f1-ae5f-de903f4341b6" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡\\theta +1" :db/ensure [:answer/validate]} {:db/id "q-119371/selection/17f068ab922e13c653374e369e944fcec0fb8c0a596dd74294992baabbff23a2" :answer/id #uuid "85fa7a30-8470-5d67-924b-5cb149febfd8" :answer/type :answer.type/math :answer/value "