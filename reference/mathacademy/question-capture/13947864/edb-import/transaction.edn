\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n2\\operatorname{sin}⁡\\theta -{cos}^{3}⁡\\theta -\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta =2\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119367/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b"] :knowledge-point/questions ["q-119367"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72711/selection/a67aac93160c6684d3a85494c97debd2787b25187a005159c1cead7331c0a983" :answer/id #uuid "aa4fea81-d457-5d8d-9bd7-9dabfcdbdc07" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72711/selection/9d1f1c1bb3bf7c397115453c17c17919918e608806bb8a2bbfcfa14cbb2ce84a" :answer/id #uuid "ead98285-9b82-58d6-9a3a-a486f8beedd9" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72711/selection/ce1f02cd8d85c1e6e6873800b24b8c1c62e4c1fc0745097c32d5a8d4e35b90a5" :answer/id #uuid "3620c990-9edf-50ca-beec-6e368b36a7f2" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72711/selection/9f102881d2e0157911025f48098c9aa2dbb5003067224e5b85720a33f8e13b40" :answer/id #uuid "d5156149-d27c-5e0b-9cdc-404e744e22fb" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72711/selection/aca3379b16c19bbcc5942a2dd6e6ff2464ebb657e5b2d45c6b7df19e49c2dee3" :answer/id #uuid "cd57a8b1-e5aa-5580-84f3-1eed37a59f53" :answer/type :answer.type/math :answer/value "-2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72711/selection" :answer-field/id #uuid "077f1aab-c195-52f9-9442-3a58daedabd9" :answer-field/key "selection" :answer-fiel