n/c6320ec392e90656124bec836a388a81515802396f2025168d0ca9dac75dacd2" "q-119379/selection/522d4eb4fde3d596e5e8b3f6e6a61ac7d646590d2af89054457b690d365b9a17" "q-119379/selection/35c0d04af9622de3840be4b9057e0e217b5b397382260d5721b234450e0a3153"] :db/ensure [:answer-field/validate]} {:db/id "q-119379" :question/id #uuid "61188e95-01a2-5109-b80e-5a0ee0202f78" :question/math-academy-id "q-119379" :question/problem "$\\frac{{sin}^{3}⁡x{cos}^{2}⁡x+\\operatorname{sin}⁡x{cos}^{4}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}=$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\frac{{sin}^{3}⁡x{cos}^{2}⁡x+\\operatorname{sin}⁡x{cos}^{4}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}=\\frac{\\operatorname{sin}⁡x{cos}^{2}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}\\,\\,\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x{cos}^{2}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x{cos}^{2}⁡x\\cdot 1}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x{cos}^{2}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x\\cdot \\operatorname{cos}⁡x\\cdot \\operatorname{cos}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\cancel{\\operatorname{sin}⁡x}\\cdot \\cancel{\\operatorname{cos}⁡x}\\cdot \\operatorname{cos}⁡x}{\\cancel{\\operatorname{cos}⁡x}\\cancel{\\operatorname{sin}⁡x}} \\\\  & =\\frac{\\operatorname{cos}⁡x}{1} \\\\  & =\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{{sin}^{3}⁡x{cos}^{2}⁡x+\\operatorname{sin}⁡x{cos}^{4}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}=\\operatorname{cos}⁡x.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119379/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689"] :knowledge-point/questions ["q-119379"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119764/selection/3d463c240b7756551927a12c1000add78fefbb3f30f2b64484d64fc31f26e06f" :answer/id #uuid "80fab331-80c5-5498-b2c2-f14d08a434c2" :answer/type :answer.type/math :answer/value "\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-119764/selection/0bfacb99ba5edf3a415bb5253450d0ec4e545a9b33ea664b606df8f2b1fca0fd" :answer/id #uuid "5e2e0c4f-3f6f-598d-ad82-a2d0810ce0a2" :answer/type :answer.type/math :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-119764/selection/65892833b7f78f1ddd17ad89a52dac1806cf36c9bff43c8f12757cf1415edd22" :answer/id #uuid "79dd7b94-72b2-58cc-ada3-9fd34c66564c" :answer/type :answer.type/math :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-119764/selection/4db2ccf9a0ddf3dcfd7700daf37845f968e4e0efc6d1a9e25437421dcc562a66" :answer/id #uuid "6c5d4bb1-8b42-5105-9758-25703be29a9c" :answer/type :answer.type/math :answer/value "\\frac{1-{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-119764/selection/d1c16afe93fe0f3fc6ac12b7bad96d2679aa805a3b05352221a6f23937d7d588" :answer/id #uuid "11c5a9ff-2ae0-54b7-addd-8a6afdb1631f" :answer/type :answer.type/math :answer/value "\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-119764/selection" :answer-field/id #uuid "f5bcad66-2a74-5df9-9f28-2f374449287b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119764/selection/0bfacb99ba5edf3a415bb5253450d0ec4e545a9b33ea664b606df8f2b1fca0fd" :answer-field/choices ["q-119764/selection/3d463c240b7756551927a12c1000add78fefbb3f30f2b64484d64fc31f26e06f" "q-119764/selection/0bfacb99ba5edf3a415bb5253450d0ec4e545a9b33ea664b606df8f2b1fca0fd" "q-119764/selection/65892833b7f78f1ddd17ad89a52dac1806cf36c9bff43c8f12757cf1415edd22" "q-119764/selection/4db2ccf9a0ddf3dcfd7700daf37845f968e4e0efc6d1a9e25437421dcc562a66" "q-119764/selection/d1c16afe93fe0f3fc6ac12b7bad96d2679aa805a3b05352221a6f23937d7d588"] :db/ensure [:answer-field/validate]} {:db/id "q-119764" :question/id #uuid "16e67eb5-9ab5-5db6-972a-fe73b4e9d7ec" :question/math-academy-id "q-119764" :question/problem "Simplify the trigonometric expression $\\operatorname{tan}⁡x-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}.$" :question/worked-solution "First, we rewrite the first term using the definition of $\\operatorname{tan}⁡x.$ This gives\n\n$$\n\\operatorname{tan}⁡x-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}.\n$$\n\nNow, we put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x} & =\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x}-\\frac{(1-\\operatorname{cos}⁡x)\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{{sin}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}-\\frac{\\operatorname{cos}⁡x-{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{{sin}^{2}⁡x-(\\operatorname{cos}⁡x-{cos}^{2}⁡x)}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{{sin}^{2}⁡x-\\operatorname{cos}⁡x+{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡x-\\operatorname{cos}⁡x+{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\operatorname{tan}⁡x-\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119764/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-119764"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119770/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b057a6ec-8c6e-5e24-9422-bb2017715602" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-119770/selection/522d4eb4fde3d596e5e8b3f6e6a61ac7d646590d2af89054457b690d365b9a17" :answer/id #uuid "1968475b-8db5-51d2-ae0e-0c05a65b12c0" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x+1" :db/ensure [:answer/validate]} {:db/id "q-119770/selection/c6320ec392e90656124bec836a388a81515802396f2025168d0ca9dac75dacd2" :answer/id #uuid "07370b15-579e-54a7-9139-cca64bc6cdd0" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119770/selection/aec903952ab7a1aa6a6a87392036510631fb67237e61586043dc0a496a15b1a4" :answer/id #uuid "3baeed5d-a91e-553c-b2a5-210d36c4da33" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119770/selection/33f84dac408867e4a6524943ad44443f79437696496e99d4e90c21f9132ec5e2" :answer/id #uuid "3608fce5-7a36-59cc-a03e-8b319fb750ad" :answer/type :answer.type/math :answer/value "1-\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-119770/selection" :answer-field/id #uuid "a1a74c6d-2940-57e2-93fc-fbc471b9da48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119770/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-119770/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-119770/selection/522d4eb4fde3d596e5e8b3f6e6a61ac7d646590d2af89054457b690d365b9a17" "q-119770/selection/c6320ec392e90656124bec836a388a81515802396f2025168d0ca9dac75dacd2" "q-119770/selection/aec903952ab7a1aa6a6a87392036510631fb67237e61586043dc0a496a15b1a4" "q-119770/selection/33f84dac408867e4a6524943ad44443f79437696496e99d4e90c21f9132ec5e2"] :db/ensure [:answer-field/validate]} {:db/id "q-119770" :question/id #uuid "18cf754a-f949-5f84-80b0-3481b58e5682" :question/math-academy-id "q-119770" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{2+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119770/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-119770"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72715/selection/29f1cc7ebd7d8755927ea511c63056bad88bb093d9c29c58d676038bbb75ea73" :answer/id #uuid "f8eb1ad0-d6f6-5e7c-ae54-8a2f5e985ae0" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-72715/selection/2bd63c4284af30761260717bdc3c447fad29f5a3696101e8da0014a8b3f90a2a" :answer/id #uuid "cfedd0b7-55e5-5a90-95f0-473d9224b56b" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-72715/selection/c1db49cd50245ae94adefd45be45ad39c13a365541a1dc696964a37280bcae78" :answer/id #uuid "1f15bf8c-1a8b-59a8-b25f-33330d9dcc59" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{cos}⁡x-1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-72715/selection/17fe139cff6459041fc42bb41d8fa22962b03cc5de91bdf7125cac451ae34623" :answer/id #uuid "c2724473-e724-50db-a638-d8de10a1e471" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-72715/selection/b5b13d6e9c76cfbd37b5f22762294446740388e29bf05cd77bd2704093e623eb" :answer/id #uuid "9d79977e-ea42-527c-9a76-287b7c71e1e8" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cos}⁡x-1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-72715/selection" :answer-field/id #uuid "a500c715-0776-5236-aa09-d237e03c000f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72715/selection/29f1cc7ebd7d8755927ea511c63056bad88bb093d9c29c58d676038bbb75ea73" :answer-field/choices ["q-72715/selection/29f1cc7ebd7d8755927ea511c63056bad88bb093d9c29c58d676038bbb75ea73" "q-72715/selection/2bd63c4284af30761260717bdc3c447fad29f5a3696101e8da0014a8b3f90a2a" "q-72715/selection/c1db49cd50245ae94adefd45be45ad39c13a365541a1dc696964a37280bcae78" "q-72715/selection/17fe139cff6459041fc42bb41d8fa22962b03cc5de91bdf7125cac451ae34623" "q-72715/selection/b5b13d6e9c76cfbd37b5f22762294446740388e29bf05cd77bd2704093e623eb"] :db/ensure [:answer-field/validate]} {:db/id "q-72715" :question/id #uuid "b5e04a73-9223-5f7f-8ad0-01a1759b4633" :question/math-academy-id "q-72715" :question/problem "Simplify the trigonometric expression $\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x.$" :question/worked-solution "First, we rewrite the second term using the definition of $\\operatorname{tan}⁡x.$ This gives:\n\n$$\n\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\n$$\n\nWe put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\frac{(1+\\operatorname{cos}⁡x)\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}+\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x+{cos}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}+\\frac{{sin}^{2}⁡x}{\\operatorname{cos}⁡x\\operatorname{sin}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x+{cos}^{2}⁡x+{sin}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x+{cos}^{2}⁡x+{sin}^{2}⁡x}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} & =\\frac{\\operatorname{cos}⁡x+({cos}^{2}⁡x+{sin}^{2}⁡x)}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & =\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{1+\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}+\\operatorname{tan}⁡x=\\frac{\\operatorname{cos}⁡x+1}{\\operatorname{sin}⁡x\\operatorname{cos}⁡x}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72715/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-72715"] :db/ensure [:knowledge-point/validate]} {:db/id "q-43298/selection/1632a186c521f0ec5e3025cb718dd54c74b6a8d5f6bff38328c7d4ea29d74100" :answer/id #uuid "ac096f3b-4116-551c-99fb-ead3b28b60bf" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡t+1" :db/ensure [:answer/validate]} {:db/id "q-43298/selection/eea7ba04cb2451d3fd68f15ddc3b3c50f575fbb53b8e2937c8830756e0468b0c" :answer/id #uuid "86691e56-de82-5341-a222-d83bcd938a2a" :answer/type :answer.type/math :answer/value "-\\operatorname{sec}⁡t" :db/ensure [:answer/validate]} {:db/id "q-43298/selection/02360738dc6c5c4a2ec507fb82fe86bf7c03bfee3fbb1310680dd1de1d5e8c45" :answer/id #uuid "f9d03c6b-ffa9-5e09-bf6e-1d1974df4eac" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡t" :db/ensure [:answer/validate]} {:db/id "q-43298/selection/38411ff19a7201b7bb2689c6edb9eed87602bdd407fe048816a4a67f58c16cab" :answer/id #uuid "9a5c6a24-e8ec-5ce2-a02e-15841cfada8b" :answer/type :answer.type/math :answer/value "-\\operatorname{sec}⁡t-1" :db/ensure [:answer/validate]} {:db/id "q-43298/selection/4a58f1b62c5ce0845ff549e1d614f7d3d97fce27748b04e1c37a0c2e0fa20532" :answer/id #uuid "bdb81bf9-aea3-5bc7-91ff-90f9b8effe06" :answer/type :answer.type/math :answer/value "-\\operatorname{sec}⁡t+1" :db/ensure [:answer/validate]} {:db/id "q-43298/selection" :answer-field/id #uuid "4c64d797-0ea1-5452-90e3-ae2360aeb0a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-43298/selection/02360738dc6c5c4a2ec507fb82fe86bf7c03bfee3fbb1310680dd1de1d5e8c45" :answer-field/choices ["q-43298/selection/1632a186c521f0ec5e3025cb718dd54c74b6a8d5f6bff38328c7d4ea29d74100" "q-43298/selection/eea7ba04cb2451d3fd68f15ddc3b3c50f575fbb53b8e2937c8830756e0468b0c" "q-43298/selection/02360738dc6c5c4a2ec507fb82fe86bf7c03bfee3fbb1310680dd1de1d5e8c45" "q-43298/selection/38411ff19a7201b7bb2689c6edb9eed87602bdd407fe048816a4a67f58c16cab" "q-43298/selection/4a58f1b62c5ce0845ff549e1d614f7d3d97fce27748b04e1c37a0c2e0fa20532"] :db/ensure [:answer-field/validate]} {:db/id "q-43298" :question/id #uuid "653aef88-f856-52e1-a486-3e093039ce1a" :question/math-academy-id "q-43298" :question/problem "$\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}) & =\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t}{\\operatorname{sin}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\cancel{\\operatorname{sin}⁡t}}{\\cancel{\\operatorname{sin}⁡t}}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\operatorname{cos}⁡t+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nWe put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta +\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} & =\\frac{\\operatorname{cos}⁡t}{1}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t}{1\\cdot \\operatorname{cos}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}=\\frac{1}{\\operatorname{cos}⁡t}=\\operatorname{sec}⁡t\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=\\operatorname{sec}⁡t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-43298/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-43298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65254/selection/2fdfa3a4b1e25faca4a0de4a99667d00002e30ee5747b74970a5da78ede57749" :answer/id #uuid "48a3eccf-a2b6-59b8-b9eb-8e4bf5301b49" :answer/type :answer.type/math :answer/value "\\frac{{sin}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-65254/selection/eb3a7832a652a83556f4372b2fd076f2620f00749fc60d6ad7acda4354fb0e86" :answer/id #uuid "722fb7af-7218-5327-9ca4-6b8aaf2e7c46" :answer/type :answer.type/math :answer/value "\\frac{1-\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-65254/selection/88b279f1abe722318f0691977e3a8dd60147afc55aa89c14b640d78fc7db06d1" :answer/id #uuid "4dfd2733-3e5f-5571-825c-48b266e9beb5" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-65254/selection/8e54c50b73f509918e1dd63070a0cb99054d480e82beb34f13436a9578d457db" :answer/id #uuid "e478993f-1811-5166-b1f2-9b1ddc0ffe13" :answer/type :answer.type/math :answer/value "\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-65254/selection/a8b667502cf559d8fad4f052ee42111ac7629ea16fbbc8b00636f1f5b0b92fff" :answer/id #uuid "3c1a775b-d564-5678-92ce-9413c57a6f6b" :answer/type :answer.type/math :answer/value "\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-65254/selection" :answer-field/id #uuid "5007e5c4-a4a7-58a5-a51a-3a7b7de8e52e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65254/selection/8e54c50b73f509918e1dd63070a0cb99054d480e82beb34f13436a9578d457db" :answer-field/choices ["q-65254/selection/2fdfa3a4b1e25faca4a0de4a99667d00002e30ee5747b74970a5da78ede57749" "q-65254/selection/eb3a7832a652a83556f4372b2fd076f2620f00749fc60d6ad7acda4354fb0e86" "q-65254/selection/88b279f1abe722318f0691977e3a8dd60147afc55aa89c14b640d78fc7db06d1" "q-65254/selection/8e54c50b73f509918e1dd63070a0cb99054d480e82beb34f13436a9578d457db" "q-65254/selection/a8b667502cf559d8fad4f052ee42111ac7629ea16fbbc8b00636f1f5b0b92fff"] :db/ensure [:answer-field/validate]} {:db/id "q-65254" :question/id #uuid "014608d1-fbaf-5fcc-9043-6ed08ac54812" :question/math-academy-id "q-65254" :question/problem "$\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\operatorname{sin}⁡x=$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & \\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\frac{\\operatorname{sin}⁡x(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{1(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x} & =\\frac{{cos}^{2}⁡x+{sin}^{2}⁡x+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x} \\\\  & =\\frac{({cos}^{2}⁡x+{sin}^{2}⁡x)+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}+\\operatorname{sin}⁡x=\\frac{1+\\operatorname{sin}⁡x\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65254/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2"] :knowledge-point/questions ["q-65254"] :db/ensure [:knowledge-point/validate]}]
