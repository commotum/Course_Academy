de2f8289294ba942c92a31db89022deaedcbba62f6a6ff5e" "q-317288/selection/5f288fc9e88af39be5e6fbde195d459becd7af6cac08a731a21aaa4cec5a273e"] :db/ensure [:answer-field/validate]} {:db/id "q-317288" :question/id #uuid "9dea313d-b72c-5519-83b1-358690e83675" :question/math-academy-id "q-317288" :question/problem "Which of the following is the graph of $y=-{5}^{x}+4?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={5}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981901/assets/09798cb8c62aabe483490ad24f4c13918138c4292ffb19a8d6612ab4efe18497.png)\n\n- Reflect it on the $x$-axis to give $y=-{5}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n- Then, vertically shift it by $4$ units up to give $y=-{5}^{x}+4.$ The point $(0,-1)$ moves to $(0,3)$ and the horizontal asymptote moves from $y=0$ to $y=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317288/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542"] :knowledge-point/questions ["q-317288"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40030/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "d94a3d52-0f16-5e25-ab40-30ba4a3ca954" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-40030/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "eae4ba94-e9b8-5bbb-bb69-20ded2bbfb44" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-40030/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "0d0f8337-ad59-568e-85d3-ac9595a6c899" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-40030/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "91be3907-c716-5987-a5b3-09abc540e46b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-40030/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "3a5d195b-bbfd-5035-8e28-dfa550cb4438" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-40030/selection" :answer-field/id #uuid "e90b041d-9bd3-5018-a809-23259c9b6d38" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40030/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-40030/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-40030/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-40030/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-40030/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-40030/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-40030" :question/id #uuid "3b94e205-84ae-5402-93e4-aef9ed193fea" :question/math-academy-id "q-40030" :question/problem "The domain of the function $f(x)=\\frac{8}{2x+b}$ is $(-\\infty ,4)\\cup (4,+\\infty ).$ What is the value of $b?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}2x+b & =0 \\\\ 2x & =-b \\\\ x & =-\\frac{b}{2}.\\end{aligned}\n$$\n\n \n\nSo, the point that must be excluded from the domain is $x=-\\frac{b}{2}.$ \n\nOn the other hand, we can see that $x=4$ is excluded from the domain. Equating this to $-\\frac{b}{2},$ we get\n\n$$\n\\begin{aligned}-\\frac{b}{2} & =4 \\\\ -b & =8 \\\\ b & =-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40030/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858"] :knowledge-point/questions ["q-40030"] :db/ensure [:knowledge-point/validate]} {:db/id "q-62069/selection/f5f2ebd7083c06b0e6794fa766605fb859818f89c3da74ef816d22b43a99e2bc" :answer/id #uuid "8ee6067e-b2d8-5f2b-8ffb-c1fa7443c0fa" :answer/type :answer.type/math :answer/value "192\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-62069/selection/e06201847481719cab9335b10f0d8465879e21994c1aebad8ea66cd1bf38737b" :answer/id #uuid "1cbb37d1-7078-508e-b8eb-dccdf6e1c076" :answer/type :answer.type/math :answer/value "148\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-62069/selection/7591dd509bd7e49cd2958a8d6f63219b761622f93e5c4d7f84d4c8d3ec618a1b" :answer/id #uuid "8f4c7eef-f32c-5c45-ada3-775718a01d18" :answer/type :answer.type/math :answer/value "154\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-62069/selection/aa4fe181e9cefabfbea16092c1d115db78d411e497807f0ba4acd37ee43eb3e7" :answer/id #uuid "9608091a-fd2d-58b8-a4b9-2d319281afae" :answer/type :answer.type/math :answer/value "172\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-62069/selection/cdfd2f7593edcd55e444512947987c5e53a329fcacded7789ec2fbddcdf1df9b" :answer/id #uuid "88b29c1a-6178-5cda-a89d-0e466bda990d" :answer/type :answer.type/math :answer/value "124\\,{\\text{cm}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-62069/selection" :answer-field/id #uuid "2661080f-2c65-5431-b05e-ccb9e40eddbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-62069/selection/f5f2ebd7083c06b0e6794fa766605fb859818f89c3da74ef816d22b43a99e2bc" :answer-field/choices ["q-62069/selection/f5f2ebd7083c06b0e6794fa766605fb859818f89c3da74ef816d22b43a99e2bc" "q-62069/selection/e06201847481719cab9335b10f0d8465879e21994c1aebad8ea66cd1bf38737b" "q-62069/selection/7591dd509bd7e49cd2958a8d6f63219b761622f93e5c4d7f84d4c8d3ec618a1b" "q-62069/selection/aa4fe181e9cefabfbea16092c1d115db78d411e497807f0ba4acd37ee43eb3e7" "q-62069/selection/cdfd2f7593edcd55e444512947987c5e53a329fcacded7789ec2fbddcdf1df9b"] :db/ensure [:answer-field/validate]} {:db/id "q-62069" :question/id #uuid "7ddd59ad-58ff-5804-a895-8e6dabf22244" :question/math-academy-id "q-62069" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981901/assets/b9668f2d9988488c64e2bb7edb55ae94b1b84b947e249fbc96c506b1c5095d4d.png)\n\nA manufacturer produces a triangular prism-shaped box to hold chocolate candies. In the figure, the areas of some of the faces are displayed in a net of the prism. What is the total surface area of the box?" :question/worked-solution "The surface area of our prism consists of $2$ triangles (base and top) and $3$ rectangles (central and side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+2\\times (\\text{Area of the side faces}) \\\\  & +1\\times (\\text{Area of the central face}) \\\\  & =2\\times 24+2\\times 45+54 \\\\  & =48+90+54 \\\\  & =192\\,{\\text{cm}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/requires-calculator true :question/answer-fields ["q-62069/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8"] :knowledge-point/questions ["q-62069"] :db/ensure [:knowledge-point/validate]}]
