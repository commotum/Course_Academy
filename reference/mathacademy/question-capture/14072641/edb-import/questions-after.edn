1)) \\\\  & +P((X,Y)=(3,2)) \\\\  & +P((X,Y)=(3,3)) \\\\  & =f(3,1)+f(3,2)+f(3,3) \\\\  & =0.05+0.05+0.1 \\\\  & =0.2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379138 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0e20c64-85be-5cb5-acde-17ffd8b6aff5" :knowledge-point/title "Calculating a Joint Probability From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bc6b33f-8a2a-5df8-9aeb-bcbb4ffc5db0" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186379140} {:answer/id #uuid "4176ad44-f6c2-5141-8a71-e4c974365400" :answer/type {:db/ident :answer.type/math} :answer/value "0.14" :db/id #edb/ref 17592186379141} {:answer/id #uuid "5542f28b-0bce-5162-90a8-4f58d79a60fe" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186379142} {:answer/id #uuid "6cf94fef-46a7-55ec-9b80-bcd5875f8cd7" :answer/type {:db/ident :answer.type/math} :answer/value "0.32" :db/id #edb/ref 17592186379143} {:answer/id #uuid "0395db7b-7417-555b-9136-808527ad5bea" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186379144}] :answer-field/correct {:answer/id #uuid "0395db7b-7417-555b-9136-808527ad5bea" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186379144} :answer-field/id #uuid "631cab03-0dad-52c0-b0b6-c4be5e05251f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379139}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2d6d6edb-c620-5943-ae59-92e06b1cd996" :question/math-academy-id "q-110964" :question/problem "|  | $Y=0$ | $Y=1$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.01$ | $0.04$ | $0.2$ |\n| $X=1$ | $0.04$ | $0.1$ | $0.2$ | $0.04$ |\n| $X=2$ | $0.02$ | $0.04$ | $0.01$ | $0.2$ |\n\nCalculate $P(Y=2X)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(Y=2X) & =P(X=0,Y=0)+P(X=1,Y=2)+P(X=2,Y=4) \\\\  & =f(0,0)+f(1,2)+f(2,4) \\\\  & =0.1+0.2+0.2 \\\\  & =0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379145 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577f67de-ab21-5a16-9d77-19b52dc8f102" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186379147} {:answer/id #uuid "586874ce-322b-5bc2-895e-84fabba64d85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186379148} {:answer/id #uuid "61a5cb72-c30e-530e-98a9-4b9bea86c173" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186379149} {:answer/id #uuid "9e92fbe5-85eb-5899-b371-4195056ce162" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186379150} {:answer/id #uuid "df89d005-7ec7-5e94-bc3c-8221e80d32fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186379151}] :answer-field/correct {:answer/id #uuid "df89d005-7ec7-5e94-bc3c-8221e80d32fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186379151} :answer-field/id #uuid "cf53391d-9f82-5903-92bd-82e985d4a40d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379146}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "312eeba5-4942-5978-ace2-eb484b2888d3" :question/math-academy-id "q-111032" :question/problem "|  | $Y=2$ | $Y=3$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{2}$ | $\\frac{1}{8}$ |\n| $X=2$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n\nCompute $P(X=2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X=2) & =P((X,Y)\\in {(2,2),(2,3)}) \\\\  & =P((X,Y)=(2,2))+P((X,Y)=(2,3)) \\\\  & =f(2,2)+f(2,3) \\\\  & =\\frac{1}{8}+\\frac{1}{4} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379152 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f4b07d0-3a16-596e-a229-1d8dbb461021" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186379154} {:answer/id #uuid "ad0893cd-de94-579c-bbdc-96ab99364384" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186379155} {:answer/id #uuid "07c33ca8-4c57-5fd8-804c-3d5cce8a2f46" :answer/type {:db/ident :answer.type/math} :answer/value "0.15" :db/id #edb/ref 17592186379156} {:answer/id #uuid "3e8500eb-f41e-5f92-b4fc-0bbd2b7b653b" :answer/type {:db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186379157} {:answer/id #uuid "852112fb-1d2f-52a4-9a12-85ecbf4704da" :answer/type {:db/ident :answer.type/math} :answer/value "0.75" :db/id #edb/ref 17592186379158}] :answer-field/correct {:answer/id #uuid "ad0893cd-de94-579c-bbdc-96ab99364384" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186379155} :answer-field/id #uuid "2c197925-6863-5200-9fa6-5c5f99c10594" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379153}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "645c0735-ad62-55c8-b08b-f61b32522613" :question/math-academy-id "q-111041" :question/problem "|  | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=1$ | $0.2$ | $0.05$ |\n| $X=2$ | $0.05$ | $0.1$ |\n| $X=3$ | $0.1$ | $0.05$ |\n| $X=4$ | $0.15$ | $0.1$ |\n| $X=5$ | $0.05$ | $0.15$ |\n\nCompute $P(X>2\\,\\,\\text{and}\\,\\text{ }Y=1)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X>2\\,\\,\\text{and}\\,\\text{ }Y=1) & =P((X,Y)\\in {(3,1),(4,1),(5,1)}) \\\\  & =P((X,Y)=(3,1))+P((X,Y)=(4,1))+P((X,Y)=(5,1)) \\\\  & =f(3,1)+f(4,1)+f(5,1) \\\\  & =0.05+0.1+0.15 \\\\  & =0.3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341728 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a68bf074-8843-576f-8be3-003edb5c91c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186341730} {:answer/id #uuid "f7c3699a-7723-50af-825e-cca81fe31162" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186341731} {:answer/id #uuid "16d8c98c-55e5-5ee6-8930-388393c14cc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186341732} {:answer/id #uuid "34dfa4bb-f428-5716-ac21-8d8d5250a24e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186341733} {:answer/id #uuid "aab664d5-16f8-53d0-bbf1-fe261209e5fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186341734}] :answer-field/correct {:answer/id #uuid "a68bf074-8843-576f-8be3-003edb5c91c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186341730} :answer-field/id #uuid "d4ca3894-8e96-53c6-8a07-6cdc833484d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341729}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "58ffa5cf-73c4-5d38-bbb0-2b8060cfb4fe" :question/math-academy-id "q-111076" :question/problem "|  | $Y=1$ | $Y=3$ | $Y=5$ |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{6}$ | $\\frac{1}{6}$ | $\\frac{2}{9}$ |\n| $X=4$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ | $\\frac{1}{9}$ |\n\nCompute $P(X=4\\,\\,\\text{or}\\,\\,Y>4)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X=4\\,\\,\\text{or}\\,\\,Y>4) & =P((X,Y)\\in {(2,5),(4,1),(4,3),(4,5)}) \\\\  & =P((X,Y)=(2,5))+P((X,Y)=(4,1)) \\\\  & +P((X,Y)=(4,3))+P((X,Y)=(4,5)) \\\\  & =f(2,5)+f(4,1)+f(4,3)+f(4,5) \\\\  & =\\frac{2}{9}+\\frac{1}{9}+\\frac{2}{9}+\\frac{1}{9} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341735 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd9d5481-9f73-50d6-96d2-4a9d2bd7cf8a" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186341737} {:answer/id #uuid "b27a0c2f-df85-5b01-b779-1b18e7785775" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186341738} {:answer/id #uuid "a4b65303-e420-5a2e-95bb-999ff2ede7a2" :answer/type {:db/ident :answer.type/math} :answer/value "0.65" :db/id #edb/ref 17592186341739} {:answer/id #uuid "d1481559-6d1e-5832-9a80-c6110c63f379" :answer/type {:db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186341740} {:answer/id #uuid "7629299a-98f1-53ab-8ebb-2088c8b3e894" :answer/type {:db/ident :answer.type/math} :answer/value "0.55" :db/id #edb/ref 17592186341741}] :answer-field/correct {:answer/id #uuid "cd9d5481-9f73-50d6-96d2-4a9d2bd7cf8a" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186341737} :answer-field/id #uuid "c5403483-e723-5180-915e-e846a4ee6d23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341736}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "226be118-3237-5a6d-bb73-42ee9dce8ee2" :question/math-academy-id "q-111080" :question/problem "|  | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=2$ | $0.1$ | $0.15$ | $0.3$ |\n| $X=3$ | $0.2$ | $0.1$ | $0.15$ |\n\nCompute $P(X<3\\,\\,\\text{or}\\,\\,Y>2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X<3\\,\\,\\text{or}\\,\\,Y>2) & =P((X,Y)\\in {(2,1),(2,2),(2,3),(3,3)}) \\\\  & =P((X,Y)=(2,1))+P((X,Y)=(2,2)) \\\\  & +P((X,Y)=(2,3))+P((X,Y)=(3,3)) \\\\  & =f(2,1)+f(2,2)+f(2,3)+f(3,3) \\\\  & =0.1+0.15+0.3+0.15 \\\\  & =0.7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341742 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5ba6b5c-ff60-5b34-a0af-9bdacdd0f4ef" :answer/type {:db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186341744} {:answer/id #uuid "168b07ef-264c-51e9-9152-c48239a92234" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186341745} {:answer/id #uuid "f611bd8d-e965-5740-bd78-5912a1f6ce70" :answer/type {:db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186341746} {:answer/id #uuid "1db6068d-4a9b-50ed-844c-e3e4dae7b8f5" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186341747} {:answer/id #uuid "bed37fe7-ac0d-581e-927c-e1eb23b6085e" :answer/type {:db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186341748}] :answer-field/correct {:answer/id #uuid "1db6068d-4a9b-50ed-844c-e3e4dae7b8f5" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186341747} :answer-field/id #uuid "2f87787d-dc49-51d0-8813-8cf6df012033" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341743}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87831530-3a25-531e-9050-ede8e0edb856" :question/math-academy-id "q-111081" :question/problem "|  | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.15$ | $0.2$ | $0.06$ |\n| $X=1$ | $0.1$ | $0.2$ | $0.04$ |\n| $X=2$ | $0.05$ | $0.1$ | $0.1$ |\n\nCompute $P(X>1\\,\\,\\text{or}\\,\\,Y=0)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X>1\\,\\,\\text{or}\\,\\,Y=0) & =P((X,Y)\\in {(0,0),(1,0),(2,0),(2,1),(2,2)}) \\\\  & =P((X,Y)=(0,0))+P((X,Y)=(1,0))+P((X,Y)=(2,0)) \\\\  & +P((X,Y)=(2,1))+P((X,Y)=(2,2)) \\\\  & =f(0,0)+f(1,0)+f(2,0)+f(2,1)+f(2,2) \\\\  & =0.15+0.1+0.05+0.1+0.1 \\\\  & =0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341749 :knowledge-point/_questions [{:knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d66dd33-8d1c-539f-9bde-8d792d0cbd8e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186341751} {:answer/id #uuid "2d33475a-00ee-54b5-84bf-510e3ed60604" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341752} {:answer/id #uuid "10a21add-589e-5877-8ea9-0f19150358d9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341753} {:answer/id #uuid "cbca439b-f6c0-5f83-8b39-34a24e099008" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341754} {:answer/id #uuid "ce2bb0e8-37ed-5a89-8b71-03422fb70ad9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341755}] :answer-field/correct {:answer/id #uuid "4d66dd33-8d1c-539f-9bde-8d792d0cbd8e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186341751} :answer-field/id #uuid "297b63dc-d9e4-54dd-8557-fe1d23e6297d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341750}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e8d3156b-d3ae-5be3-a7d2-cf6d81a3de37" :question/math-academy-id "q-143865" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.4$ | $0.3$ |\n| $X=1$ | $0.2$ | $0.1$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.4+0.3+0.2+0.1=1\\,✓\\end{aligned}\n$$\n\n- Condition III is true. Because $f(x,y)$ satisfies conditions I and II, it is a valid probability mass function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186379159 :knowledge-point/_questions [{:knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e04ab26-496a-51b4-8b38-716698e51199" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186379161} {:answer/id #uuid "16d318d0-93e5-576e-aabb-cd16fd8c009d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186379162} {:answer/id #uuid "080a80b6-6235-5e9b-8ef7-b36c7417d479" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186379163} {:answer/id #uuid "8edeb96c-6031-5df4-abb1-3df449e4374b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186379164} {:answer/id #uuid "7fc8d990-6f09-535c-9699-3fa60dc7c30f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186379165}] :answer-field/correct {:answer/id #uuid "7e04ab26-496a-51b4-8b38-716698e51199" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186379161} :answer-field/id #uuid "90a7c3a1-ec01-53e6-9562-eb7077525232" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379160}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "265e1000-0088-5050-9691-488b4c209467" :question/math-academy-id "q-143866" :question/problem "| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=1$ | $0.42$ | $0.18$ |\n| $X=3$ | $0.33$ | $0.07$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.42+0.18+0.33+0.07=1\\,✓\\end{aligned}\n$$\n\n- Condition III is true. Because $f(x,y)$ satisfies conditions I and II, it is a valid probability mass function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186341770 :knowledge-point/_questions [{:knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35812893-2a08-55c2-9a25-8c3297aedde0" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186341772} {:answer/id #uuid "231a1222-1212-5eef-8d83-c8268576663a" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341773} {:answer/id #uuid "2d2a49c8-ba03-568d-923c-27c7e9ebce88" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341774} {:answer/id #uuid "6619a143-1e92-524d-aac2-318a25008d6a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341775} {:answer/id #uuid "0bca9555-ad00-597c-aca3-b4f7973c368f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341776}] :answer-field/correct {:answer/id #uuid "0bca9555-ad00-597c-aca3-b4f7973c368f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341776} :answer-field/id #uuid "e6a090f6-fff7-5ea7-9582-c7dff5e36b98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341771}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9acee360-e512-531a-a3ce-040acc04714c" :question/math-academy-id "q-143869" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.2$ | $0.15$ |\n| $X=2$ | $0.16$ | $-0.1$ |\n| $X=3$ | $0.24$ | $0.35$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is false. The value of $f(2,2)$ in the table does not satisfy $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.2+0.15+0.16-0.1+0.24+0.35=1\\,✓\\end{aligned}\n$$\n\n- Condition III is false. Because $f(x,y)$ does not satisfy condition I, it is *not* a valid probability mass function.\n\nTherefore, the correct answer is \"II only.\""}]}
