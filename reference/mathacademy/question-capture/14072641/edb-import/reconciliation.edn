 \\\\  & =P((X,Y)=(2,1))+P((X,Y)=(2,2)) \\\\  & +P((X,Y)=(2,3))+P((X,Y)=(3,3)) \\\\  & =f(2,1)+f(2,2)+f(2,3)+f(3,3) \\\\  & =0.1+0.15+0.3+0.15 \\\\  & =0.7.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/state.json" "file_sha256" "2cf15f25bcd789adb92916666c6445cd85a212d03e4252cedf295e30c27779cc" "basis" 1974 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/edb-import/verification.json"} {"question" "q-111080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/activity-metadata.json" "file_sha256" "2593e76e422fc7bb1e37da6fb58566d366c5e77c9286cc7866c1595c7f20b31a" "basis" 1974 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/edb-import/verification.json"} {"question" "q-111080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/state.json" "file_sha256" "2cf15f25bcd789adb92916666c6445cd85a212d03e4252cedf295e30c27779cc" "basis" 1974 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/edb-import/verification.json"} {"question" "q-111080" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "0.3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061806/state.json" "file_sha256" "2cf15f25bcd789adb92916666c6445cd85a212d03e4252cedf295e30c27779cc" "basis" 1974 "verification" "/home/jake/Developer/Course_Academy/referen