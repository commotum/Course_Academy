)+f(4,5) \\\\  & =\\frac{2}{9}+\\frac{1}{9}+\\frac{2}{9}+\\frac{1}{9} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111076" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/activity-metadata.json" "file_sha256" "1a95abc9dbf1014f0fd42a2ebbc90e95e65ca663e6f022132972e58f996c7892"} {"question" "q-111076" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111076" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{3}"] ["math" "\\frac{1}{9}"] ["math" "\\frac{2}{3}"] ["math" "\\frac{4}{9}"] ["math" "\\frac{5}{9}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111076" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111080" "field" nil "attribute" "question/problem" "value" "|  | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=2$ | $0.1$ | $0.15$ | $0.3$ |\n| $X=3$ | $0.2$ | $0.1$ | $0.15$ |\n\nCompute $P(X<3\\,\\,\\text{or}\\,\\,Y>2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111080" "field" nil "attribute" "question/worked-solution" "value" "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X<3\\,\\,\\text{or}\\,\\,Y>2) & =P((X,Y)\\in {(2,1),(2,2),(2,3),(3,3)}) \\\\  & =P((X,Y)=(2,1))+P((X,Y)=(2,2)) \\\\  & +P((X,Y)=(2,3))+P((X,Y)=(3,3)) \\\\  & =f(2,1)+f(2,2)+f(2,3)+f(3,3) \\\\  & =0.1+0.15+0.3+0.15 \\\\  & =0.7.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/activity-metadata.json" "file_sha256" "1a95abc9dbf1014f0fd42a2ebbc90e95e65ca663e6f022132972e58f996c7892"} {"question" "q-111080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111080" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.3"] ["math" "0.45"] ["math" "0.55"] ["math" "0.65"] ["math" "0.7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111080" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111032" "field" nil "attribute" "question/problem" "value" "|  | $Y=2$ | $Y=3$ |\n| --- | --- | --- |\n| $X=1$ | $\\frac{1}{2}$ | $\\frac{1}{8}$ |\n| $X=2$ | $\\frac{1}{8}$ | $\\frac{1}{4}$ |\n\nCompute $P(X=2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111032" "field" nil "attribute" "question/worked-solution" "value" "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X=2) & =P((X,Y)\\in {(2,2),(2,3)}) \\\\  & =P((X,Y)=(2,2))+P((X,Y)=(2,3)) \\\\  & =f(2,2)+f(2,3) \\\\  & =\\frac{1}{8}+\\frac{1}{4} \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111032" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/activity-metadata.json" "file_sha256" "1a95abc9dbf1014f0fd42a2ebbc90e95e65ca663e6f022132972e58f996c7892"} {"question" "q-111032" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111032" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{2}"] ["math" "\\frac{1}{4}"] ["math" "\\frac{1}{8}"] ["math" "\\frac{3}{8}"] ["math" "\\frac{5}{8}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111032" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{8}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111041" "field" nil "attribute" "question/problem" "value" "|  | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=1$ | $0.2$ | $0.05$ |\n| $X=2$ | $0.05$ | $0.1$ |\n| $X=3$ | $0.1$ | $0.05$ |\n| $X=4$ | $0.15$ | $0.1$ |\n| $X=5$ | $0.05$ | $0.15$ |\n\nCompute $P(X>2\\,\\,\\text{and}\\,\\text{ }Y=1)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111041" "field" nil "attribute" "question/worked-solution" "value" "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X>2\\,\\,\\text{and}\\,\\text{ }Y=1) & =P((X,Y)\\in {(3,1),(4,1),(5,1)}) \\\\  & =P((X,Y)=(3,1))+P((X,Y)=(4,1))+P((X,Y)=(5,1)) \\\\  & =f(3,1)+f(4,1)+f(5,1) \\\\  & =0.05+0.1+0.15 \\\\  & =0.3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111041" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/activity-metadata.json" "file_sha256" "1a95abc9dbf1014f0fd42a2ebbc90e95e65ca663e6f022132972e58f996c7892"} {"question" "q-111041" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111041" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0.15"] ["math" "0.3"] ["math" "0.35"] ["math" "0.4"] ["math" "0.75"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "q-111041" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0.3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/state.json" "file_sha256" "e17b471c17cbc8d8b65a72e2e3eb3651d24fbc446c9937df7263b0c30d4d1d95"} {"question" "e-9126" "field" nil "attribute" "question/problem" "value" "|  | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $\\dfrac a2$ | $a$ |\n| $X=1$ | $a$ | $\\dfrac 52a$ |\n\nThe joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given above. Find the value of $a.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/example-9126.json" "file_sha256" "83f37d13971d1d37ec7e30988c3313f61caf3d4e510265e73b44fceaee237569"} {"question" "e-9126" "field" nil "attribute" "question/worked-solution" "value" "The support of $X$ is $S_X = \\{0,1\\},$ the support of $Y$ is $S_Y = \\{0,1\\},$ and therefore the joint support $S$ is\n\n$$\nS= S_X\\times S_Y = \\left\\{(0,0),  (0,1),  (1,0),  (1,1) \\right\\}.\n$$\n\nSince we're given a joint probability distribution $f(x,y),$ we must have \n\n$$\n\\displaystyle \\sum\\limits_{(x,y) \\in S} f(x,y) = 1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}f(0,0)+f(0,1)+f(1,0)+f(1,1) & =1 \\\\ \\frac{a}{2}+a+a+\\frac{5}{2}a & =1 \\\\ 5a & =1 \\\\ a & =\\frac{1}{5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/example-9126.json" "file_sha256" "83f37d13971d1d37ec7e30988c3313f61caf3d4e510265e73b44fceaee237569"} {"question" "e-9203" "field" nil "attribute" "question/problem" "value" "|  | $Y=1$ | $Y=3$ |\n| --- | --- | --- |\n| $X=2$ | $0.05$ | $0.25$ |\n| $X=4$ | $0.2$ | $0.05$ |\n| $X=6$ | $0.3$ | $0.15$ |\n\nCompute $P\\Big( (X,Y) \\in \\{(2,3), (6,1) \\}\\Big)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/example-9203.json" "file_sha256" "0cc334ec9a524c7aebcf66ffae1dcd26f8a7e27f0fe442090c28d01d54621dfa"} {"question" "e-9203" "field" nil "attribute" "question/worked-solution" "value" "Using the values in the table, we have\n\n$$\n\\begin{aligned}P((X,Y)\\in {(2,3),(6,1)}) & =P((X,Y)=(2,3))+P((X,Y)=(6,1)) \\\\  & =f(2,3)+f(6,1) \\\\  & =0.25+0.3 \\\\  & =0.55.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/example-9203.json" "file_sha256" "0cc334ec9a524c7aebcf66ffae1dcd26f8a7e27f0fe442090c28d01d54621dfa"} {"question" "e-9204" "field" nil "attribute" "question/problem" "value" "|  | $Y=0$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.15$ | $0.1$ | $0.1$ |\n| $X=1$ | $0.05$ | $0.1$ | $0.05$ |\n| $X=2$ | $0.05$ | $0.25$ | $0.15$ |\n\nCompute $P\\left( X\\cdot Y \\geq 4 \\right)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/example-9204.json" "file_sha256" "734d99b667a52eb3a0b390e635d94858e8497995c13439e4a7c38110154dbe21"} {"question" "e-9204" "field" nil "attribute" "question/worked-solution" "value" "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X\\cdot Y\\ge 4) & =P((X,Y)\\in {(1,4),(2,2),(2,4)}) \\\\  & =P((X,Y)=(1,4))+P((X,Y)=(2,2))+P((X,Y)=(2,4)) \\\\  & =f(1,4)+f(2,2)+f(2,4) \\\\  & =0.05+0.25+0.15 \\\\  & =0.45.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072641/example-9204.json" "file_sha256" "734d99b667a52eb3a0b390e635d94858e8497995c13439e4a7c38110154dbe21"}] "usage" {"q-110931" [] "q-109686" [] "q-111081" [] "q-143865" [] "e-9204" [] "q-143869" [] "q-109335" [] "e-9203" [] "q-111076" [] "q-111080" [] "e-9126" []} "basis" 2691 "retractions" [[17592186162213 :question/problem "|  | $Y = 2$ | $Y = 4$ | $Y = 6$ |\n| --- | ---: | ---: | ---: |\n| $X = 1$ | $0.1$ | $0.25$ | $0.25$ |\n| $X = 2$ | $0.05$ | $0.15$ | $0.2$ |\n\nCompute $P((X, Y) ∈ {(1, 4), (1, 6), (2, 6)})$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x, y)$ shown in the table above."]] "immutable_answers" [17592186158821 17592186158822 17592186158823 17592186158824 17592186158825 17592186158887 17592186158888 17592186158889 17592186158890 17592186158891 17592186341709 17592186341710 17592186341711 17592186341712 17592186341713 17592186341730 17592186341731 17592186341732 17592186341733 17592186341734 17592186341737 17592186341738 17592186341739 17592186341740 17592186341741 17592186341744 17592186341745 17592186341746 17592186341747 17592186341748 17592186341751 1759218