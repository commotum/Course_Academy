6313454 1000 #edb/ref 17592186313458 13194139534835 true] [17592186313454 1000 #edb/ref 17592186313459 13194139534835 true] [17592186313454 1040 #edb/ref 17592186045450 13194139534835 true] [17592186313454 1041 "selection" 13194139534835 true] [17592186313454 1104 #edb/ref 17592186313455 13194139534835 true] [17592186313454 1110 #uuid "f67d1dfe-3a13-519d-8ab9-ea6af168825e" 13194139534835 true] [17592186313455 1034 "p=-2,q=-8" 13194139534835 true] [17592186313455 1103 #edb/ref 17592186045453 13194139534835 true] [17592186313455 1111 #uuid "46bbb13c-ab62-57bc-9023-58dd905ed711" 13194139534835 true] [17592186313456 1034 "p=-2,q=3" 13194139534835 true] [17592186313456 1103 #edb/ref 17592186045453 13194139534835 true] [17592186313456 1111 #uuid "92fa84e7-8288-5fe8-88e2-2c3b2c32e2c9" 13194139534835 true] [17592186313457 1034 "p=-1,q=4" 13194139534835 true] [17592186313457 1103 #edb/ref 17592186045453 13194139534835 true] [17592186313457 1111 #uuid "5d50f5ac-1165-5b25-8272-dbd5d92ba7ad" 13194139534835 true] [17592186313458 1034 "p=-1,q=-4" 13194139534835 true] [17592186313458 1103 #edb/ref 17592186045453 13194139534835 true] [17592186313458 1111 #uuid "03ca134f-54ff-51be-9740-1b6a99a86ec2" 13194139534835 true] [17592186313459 1034 "p=-4,q=2" 13194139534835 true] [17592186313459 1103 #edb/ref 17592186045453 13194139534835 true] [17592186313459 1111 #uuid "4807703d-ea87-5aad-a030-79582c32c7dd" 13194139534835 true] [17592186313460 1017 #edb/ref 17592186313461 13194139534835 true] [17592186313460 1089 "q-160049" 13194139534835 true] [17592186313460 1091 #edb/ref 17592186045465 13194139534835 true] [17592186313460 1100 "Given that $5=(p+q\\text{i})(3+\\text{i})$, calculate $p$ and $q.$" 13194139534835 true] [17592186313460 1113 #uuid "050685d3-106a-556e-94cf-f2ab6b33d435" 13194139534835 true] [17592186313460 1145 "First, we divide both sides of the equation by $3+\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}5 & =(p+q\\text{i})(3+\\text{i}) \\\\ \\frac{5}{3+\\text