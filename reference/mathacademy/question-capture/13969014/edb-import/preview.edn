2}+8x+8 & <x+2 \\\\ {x}^{2}+7x+6 & <0 \\\\ (x+6)(x+1) & <0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $(x+6)(x+1)=0.$ The roots are $x=-6$ and $x=-1,$ and they split the number line into the $3$ subintervals $(-\\infty ,-6),$ $(-6,-1),$ and $(-1,\\infty ).$\n\nNow, we construct a sign table with the list of intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-6)$ | $(-6,-1)$ | $(-1,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+6$ | $-$ | $+$ | $+$ |\n| $x+1$ | $-$ | $-$ | $+$ |\n| $(x+6)(x+1)$ | $+$ | $-$ | $+$ |\n\nFinally, to solve the quadratic inequality $(x+6)(x+1)<0,$ we look at the bottom row to find out where the expression $(x+6)(x+1)$ is negative.\n\nWe see that the expression is negative on the interval $(-6,-1).$\n\nTherefore, we conclude that ${x}^{2}+8x+8<x+2$ for all \n\n$$\nx\\in (-6,-1).\n$$" 13194139534094 true] [17592186277447 1000 #edb/ref 17592186277448 13194139534094 true] [17592186277447 1000 #edb/ref 17592186277449 13194139534094 true] [17592186277447 1040 #edb/ref 17592186045449 13194139534094 true] [17592186277447 1041 "field-1" 13194139534094 true] [17592186277447 1104 #edb/ref 17592186277449 13194139534094 true] [17592186277447 1110 #uuid "b7a97e23-f35e-50df-8a0c-b5dff7854ded" 13194139534094 true] [17592186277448 1034 "6" 13194139534094 true] [17592186277448 1103 #edb/ref 17592186045453 13194139534094 true] [17592186277448 1111 #uuid "e46f2f2e-3718-5263-a8e4-eeea7a1c8a58" 13194139534094 true] [17592186277449 1034 "-6" 13194139534094 true] [17592186277449 1103 #edb/ref 17592186045453 13194139534094 true] [17592186277449 1111 #uuid "3e674203-a65e-5cda-bfd9-9c7901c10af2" 13194139534094 true] [17592186277450 1000 #edb/ref 17592186277451 13194139534094 true] [17592186277450 1040 #edb/ref 17592186045449 13194139534094 true] [17592186277450 1041 "field-2" 13194139534094 true] [17592186277450 1104 #edb/ref 17592