98a00c4bac0e1422b5f957652bc" "q-278489/field-3/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949"] :db/ensure [:answer-field/validate]} {:db/id "q-278489" :question/id #uuid "ac117008-5390-5446-ad55-241a34126660" :question/math-academy-id "q-278489" :question/problem "What are the missing entries in the sign table below?\n\n|  | $(-\\infty ,-5)$ | $(-5,8)$ | $(8,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | {{field-1}} | $+$ |\n| $x-8$ | $-$ | {{field-2}} | $+$ |\n| $(x+5)(x-8)$ | $+$ | {{field-3}} | $+$ |" :question/worked-solution "On the interval $(-5,8),$ we can choose a test point ${x}_{1}=1.$ Then we have\n\n$$\n\\begin{aligned}x+5 & =1+5=(+), \\\\ x-8 & =1-8=(-), \\\\ (x+5)(x-8) & =(+)\\times (-)=(-),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,-5)$ | $(-5,8)$ | $(8,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | $+$ | $+$ |\n| $x-8$ | $-$ | $-$ | $+$ |\n| $(x+5)(x-8)$ | $+$ | $-$ | $+$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278489/field-1" "q-278489/field-2" "q-278489/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b23c4da-7a8d-5076-a4e9-8bcde40bc088"] :knowledge-point/questions ["q-278489"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115864/selection/7ff87d69fa989739512c270090a2177fe123b9ee59c08a6d638950db238bea20" :answer/id #uuid "f41b1d81-eddb-585c-90fd-df8ebf3a2dd4" :answer/type :answer.type/math :answer/value "x\\in (-11,0)" :db/ensure [:answer/validate]} {:db/id "q-115864/selection/5c48faa607ccd095cc3e71eaf8b21196eab6d6d8b0d21c94e41b0218a02bde25" :answer/id #uuid "e5cad427-888c-58ee-9017-88c094335c6d" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-11)\\cup (11,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115864/selection/afd67aff8b55c9f03b5e3901da33b4388e2ddfcaeaa05d052d4aaaa80ab5edbe" :answer/id #uuid "955ff952-435e-51dd-9bd9-da57dbd8f236" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,0)\\cup (11,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115864/selection/8924e81c76a1774737b7b7c67e91a3833096016c87c85aa380a2ab88ca4519cd" :answer/id #uuid "aa33b075-b3d2-5edc-ad6c-233f1e9f8b65" :answer/type :answer.type/math :answer/value "x\\in (0,11)" :db/ensure [:answer/validate]} {:db/id "q-115864/selection/c15fa162d5ad7bf31a1177832849f6263b604a5bdc477fa9da68019ac4d31deb" :answer/id #uuid "c1f12b44-a47f-5482-b998-dfe0b0f81834" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-11)\\cup (0,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-115864/selection" :answer-field/id #uuid "9e654c33-8692-5b2d-8212-192f7f7fe456" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115864/selection/c15fa162d5ad7bf31a1177832849f6263b604a5bdc477fa9da68019ac4d31deb" :answer-field/choices ["q-115864/selection/7ff87d69fa989739512c270090a2177fe123b9ee59c08a6d638950db238bea20" "q-115864/selection/5c48faa607ccd095cc3e71eaf8b21196eab6d6d8b0d21c94e41b0218a02bde25" "q-115864/selection/afd67aff8b55c9f03b5e3901da33b4388e2ddfcaeaa05d052d4aaaa80ab5edbe" "q-115864/selection/8924e81c76a1774737b7b7c67e91a3833096016c87c85aa380a2ab88ca4519cd" "q-115864/selection/c15fa162d5ad7bf31a1177832849f6263b604a5bdc477fa9da68019ac4d31deb"] :db/ensure [:answer-field/validate]} {:db/id "q-115864" :question/id #uuid "1184723f-f681-5872-85f4-eef5244ff4da" :question/math-academy-id "q-115864" :question/problem "For which values of $x$ is ${x}^{2}+11x>0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{2}+11x & >0 \\\\ x(x+11) & >0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $x(x+11)=0.$ The roots are $x=-11$ and $x=0$ and they split the number line into the $3$ intervals $(-\\infty ,-11),$ $(-11,0),$ and $(0,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-11)$ | $(-11,0)$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| $x$ | $-$ | $-$ | $+$ |\n| $x+11$ | $-$ | $+$ | $+$ |\n| $x(x+11)$ | $(-)\\cdot (-)=+$ | $(-)\\cdot (+)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $x(x+11)>0,$ we look at the bottom row to find out where the expression $x(x+11)$ is positive.\n\nWe see that the expression is positive on the intervals $(-\\infty ,-11)$ and $(0,\\infty ).$ \nTherefore, we conclude that ${x}^{2}+11x>0$ for all $x\\in (-\\infty ,-11)\\cup (0,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115864/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7de7d614-76c9-5133-a4df-95f079467cb9"] :knowledge-point/questions ["q-115864"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278299/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "1a5de5db-af31-5967-803e-4dc8088c5057" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-278299/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "2b124310-6681-5e10-95a8-905e4be80586" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-278299/field-1" :answer-field/id #uuid "919898ec-c611-5568-93fc-0136859b3ca5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278299/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-278299/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" "q-278299/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-278299/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "94185306-df5d-5eb0