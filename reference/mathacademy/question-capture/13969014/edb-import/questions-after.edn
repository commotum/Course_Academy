-)=(-),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,-2)$ | $(-2,8)$ | $(8,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+2$ | $-$ | $+$ | $+$ |\n| $x-8$ | $-$ | $-$ | $+$ |\n| $(x+2)(x-8)$ | $+$ | $-$ | $+$ |"}] [{:db/id #edb/ref 17592186277416 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b23c4da-7a8d-5076-a4e9-8bcde40bc088" :knowledge-point/title "Completing a Table of Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98989de5-a464-5e6c-bc6a-85e34ad69351" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186277418} {:answer/id #uuid "c8259363-e429-5eea-b45a-9b66064f8561" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186277419}] :answer-field/correct {:answer/id #uuid "98989de5-a464-5e6c-bc6a-85e34ad69351" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186277418} :answer-field/id #uuid "84531ade-8e3c-5c3f-81b1-68d525b460b6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186277417} {:answer-field/choices [{:answer/id #uuid "25a12f4f-9335-5e3a-aed7-e3a987e7ec4d" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186277421} {:answer/id #uuid "7ca802ca-c0fc-5a7e-b55e-a3f9dd672c2d" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186277422}] :answer-field/correct {:answer/id #uuid "7ca802ca-c0fc-5a7e-b55e-a3f9dd672c2d" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186277422} :answer-field/id #uuid "11fb249c-83f9-578c-abcc-b37d0559d417" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186277420} {:answer-field/choices [{:answer/id #uuid "eba5d716-2359-548b-a736-ddb4399dd05a" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186277424} {:answer/id #uuid "b0