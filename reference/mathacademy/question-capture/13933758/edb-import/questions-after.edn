ield.type/radio} :db/id #edb/ref 17592186246369}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1cd55f38-093b-51a4-ae11-08c7151b5a06" :question/is-example false :question/math-academy-id "q-65832" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/6b7b001374d8ef011bc9f2e11cd84b53837c5f4e4133acc31e241cc91c9bd08d.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/dba90d9fc6f17599a41cd301247ec604726adb3454a4cee740c639d64c40618f.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $x$-axis.\n\nTherefore, the given curve is the graph of $y=-sin⁡x.$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\nsin⁡(-x)=-sin⁡x\n$$\n\nSo the graph could also be viewed as $y=sin⁡(-x).$ However, $y=sin⁡(-x)$ is not among the given options."}] [{:db/id #edb/ref 17592186060289 :knowledge-point/_questions [{:knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3b2903c-cdda-556e-85ad-58be032ed880" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\sin (-x)" :db/id #edb/ref 17592186058718} {:answer/id #uuid "d7d1fbca-f36a-545c-87a1-aebd41558814" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\cos x" :db/id #edb/ref 17592186058719} {:answer/id #uuid "5e0760c6-da35-554c-bdd0-313096e97666" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\sin x" :db/id #edb/ref 17592186058720} {:answer/id #uuid "62fc33ac-a4ee-5c27-be0f-1d80028a96a2" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\cos (-x)" :db/id #edb/ref 17592186058721} {:answer/id #uuid "74b84608-1d9a-5f8f-810c-bf823ba64469" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\cos (x - π)" :db/id #edb/ref 17592186058722}] :answer-field/correct {:answer/id #uuid "62fc33ac-a4ee-5c27-be0f-1d80028a96a2" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\cos (-x)" :db/id #edb/ref 17592186058721} :answer-field/id #uuid "e2233175-e05e-5435-8b65-c389dcfa00d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058717}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "681b918b-daff-5df7-b3b5-e24ca656fe11" :question/is-example false :question/math-academy-id "q-65833" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/259/Source/Images/q-65833.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "The given curve is the graph of $y=cos⁡x.$\n\nNotice that, because the cosine function is even, it is symmetric about the $y$-axis, i.e.,\n\n$$\ncos⁡(-x)=cos⁡x\n$$\n\nSo the graph could also be viewed as $y=cos⁡(-x).$"}] [{:db/id #edb/ref 17592186246375 :knowledge-point/_questions [{:knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a118275-99ba-58ef-8de3-20ed446bcc9a" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(x)-\\frac{1}{2}" :db/id #edb/ref 17592186246377} {:answer/id #uuid "6772008a-abb7-5543-a79d-8622da3c2a58" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(-x)-\\frac{1}{2}" :db/id #edb/ref 17592186246378} {:answer/id #uuid "5fc64020-78b6-5774-b9e0-9cbfad1dbcd6" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(x)+2" :db/id #edb/ref 17592186246379} {:answer/id #uuid "d6060610-827b-5a3d-9623-441d88362ddc" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2sin⁡(x)" :db/id #edb/ref 17592186246380} {:answer/id #uuid "96438709-bc23-5cf7-825b-356090d23f46" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{sin⁡(-x)}{2}" :db/id #edb/ref 17592186246381}] :answer-field/correct {:answer/id #uuid "96438709-bc23-5cf7-825b-356090d23f46" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{sin⁡(-x)}{2}" :db/id #edb/ref 17592186246381} :answer-field/id #uuid "4cb85581-d9bd-5417-a8de-aeaec5a2dbe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246376}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "30aee13e-9b97-5465-9710-bc5010e36469" :question/is-example false :question/math-academy-id "q-66202" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/7971e513c06a153a695cb7067514f0d69fd4c35711ea38c08184e25ccf72359a.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/5f2e6c5d15161d02edc1ce014d926447cf4915e4b00b84b8c3935f9fbd8408d4.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $\\frac{1}{2}.$\n\nTherefore, the given curve is the graph of $y=\\frac{sin⁡(-x)}{2}.$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n\\frac{sin⁡(-x)}{2}=-\\frac{sin⁡(x)}{2}\n$$\n\nSo the graph could also be viewed as $y=-\\frac{sin⁡(x)}{2}.$ However, $y=-\\frac{sin⁡(x)}{2}$ is not among the given options."}] [{:db/id #edb/ref 17592186246382 :knowledge-point/_questions [{:knowledge-point/id #uuid "f71a8f16-93d4-5e5a-9b8b-e29efc682430" :knowledge-point/title "Identifying the Reflection of a Cosine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ba79f0e-a76d-5abc-96b4-d1e25139f2ec" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x-1)" :db/id #edb/ref 17592186246384} {:answer/id #uuid "404de9b0-60d1-536c-a7c4-7770d2de7757" :answer/type {:db/ident :answer.type/math} :answer/value "y=cos⁡(x)" :db/id #edb/ref 17592186246385} {:answer/id #uuid "dc61aa6b-65d0-5ada-96ee-e7d525164ed1" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x)" :db/id #edb/ref 17592186246386} {:answer/id #uuid "c3aa3f95-e8b7-5823-8327-0e751d6e58f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x+1)" :db/id #edb/ref 17592186246387} {:answer/id #uuid "1373d257-2f44-528b-8aa5-b4223e8b4512" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x+1)-1" :db/id #edb/ref 17592186246388}] :answer-field/correct {:answer/id #uuid "dc61aa6b-65d0-5ada-96ee-e7d525164ed1" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x)" :db/id #edb/ref 17592186246386} :answer-field/id #uuid "285f2b37-eb91-5cc0-af23-769b8a0c1f8b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246383}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4668d94d-a174-5c1d-bde7-38ebd0634499" :question/is-example false :question/math-academy-id "q-6761" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/4d660b71abd6c03c817b6cf18c5320a3f27d4fbf650f1ea032d27bf1652d3066.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/867ec8135efc671ea26c6691a9aef4803c35179b86b7af3b605c4b7d1d3a2498.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\nTherefore, the given curve is the graph of $y=-cos⁡x.$"}] [{:db/id #edb/ref 17592186246389 :knowledge-point/_questions [{:knowledge-point/id #uuid "f71a8f16-93d4-5e5a-9b8b-e29efc682430" :knowledge-point/title "Identifying the Reflection of a Cosine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "696a0d59-7f3b-50d5-b555-db1a59fdc3d1" :answer/type {:db/ident :answer.type/math} :answer/value "y=2.5cos⁡(x)" :db/id #edb/ref 17592186246391} {:answer/id #uuid "49dc65ae-6b81-51df-94f4-81f8ace687ff" :answer/type {:db/ident :answer.type/math} :answer/value "y=cos⁡(x)-2.5" :db/id #edb/ref 17592186246392} {:answer/id #uuid "c544162b-e37b-5be3-babd-535454e19f70" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2.5cos⁡(x)" :db/id #edb/ref 17592186246393} {:answer/id #uuid "2df3ff00-cbc2-534c-82fb-d504457fafe9" :answer/type {:db/ident :answer.type/math} :answer/value "y=cos⁡(x)+2.5" :db/id #edb/ref 17592186246394} {:answer/id #uuid "9c73ef70-fbc5-53bd-b90e-9214663c431b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x-2.5)" :db/id #edb/ref 17592186246395}] :answer-field/correct {:answer/id #uuid "c544162b-e37b-5be3-babd-535454e19f70" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2.5cos⁡(x)" :db/id #edb/ref 17592186246393} :answer-field/id #uuid "0a46c307-a3b7-513e-b8b2-74b415ad8b70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246390}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "268d0777-909d-552f-923b-03b7162f7528" :question/is-example false :question/math-academy-id "q-6769" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/b2a714b91a3645643ac0e48696351b5d75d83cc5f79e42fdcc3f66c3210fe1d0.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/819b958aae76aa74f486ba9db7a8dcd5fcddd7bdeba9e03fcc75c479970dc690.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $2.5$ to give $y=-2.5cos⁡x$\n\nTherefore, the given curve is the graph of $y=-2.5cos⁡x.$"}] [{:db/id #edb/ref 17592186060305 :knowledge-point/_questions [{:knowledge-point/id #uuid "1fe335eb-dc4a-5ea0-83cf-ad929e19b908" :knowledge-point/title "Identifying the Reflection and Shifting of a Sine or Cosine Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94ee8e8c-fd96-5e57-853e-fbad4ae72dde" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\cos (x) + 1" :db/id #edb/ref 17592186058814} {:answer/id #uuid "ae522bd8-7849-50d0-bb77-e5c1c18ddf01" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\cos (x + 1)" :db/id #edb/ref 17592186058815} {:answer/id #uuid "dda0af92-6e09-5ced-a96c-7f4f74a06438" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\cos (x) - 1" :db/id #edb/ref 17592186058816} {:answer/id #uuid "062b1e7d-0a81-539c-a04a-0212e77b01ea" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\cos (x + 1)" :db/id #edb/ref 17592186058817} {:answer/id #uuid "5534d02a-1332-5482-90fa-6b90ed9e64c4" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\cos (x) + 1" :db/id #edb/ref 17592186058818}] :answer-field/correct {:answer/id #uuid "94ee8e8c-fd96-5e57-853e-fbad4ae72dde" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\cos (x) + 1" :db/id #edb/ref 17592186058814} :answer-field/id #uuid "fcf7a479-90ac-5524-b4ea-2f61f04400f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058813}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "27ee5b5b-7d28-5cc8-95f1-b8374e27584d" :question/is-example false :question/math-academy-id "q-6777" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/259/Source/Images/q-6777.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/c27ff316601ece28946ef45711690d6aabca92a4c35f07b0b1cc1c0982fb5d8e.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\n- Finally, translate it by $1$ unit **up** to give $y=-cos⁡x+1$\n\nTherefore, the given curve is the graph of $y=-cos⁡x+1.$"}] [{:db/id #edb/ref 17592186246396 :knowledge-point/_questions [{:knowledge-point/id #uuid "1fe335eb-dc4a-5ea0-83cf-ad929e19b908" :knowledge-point/title "Identifying the Reflection and Shifting of a Sine or Cosine Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9088a19-95ef-55ba-a2e6-308ca7d7b978" :answer/type {:db/ident :answer.type/math} :answer/value "y=cos⁡(x+3)" :db/id #edb/ref 17592186246398} {:answer/id #uuid "01d49391-68a1-55af-b2fa-3f4fbf8691b5" :answer/type {:db/ident :answer.type/math} :answer/value "y=cos⁡(x)+3" :db/id #edb/ref 17592186246399} {:answer/id #uuid "f0fa5858-2ccc-5c1c-b1bf-f538ef9d9ef9" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x)+2" :db/id #edb/ref 17592186246400} {:answer/id #uuid "6a54f0f9-b6f0-56eb-b5b7-4ef621a19d14" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x)-3" :db/id #edb/ref 17592186246401} {:answer/id #uuid "c77df695-469d-5c8c-806d-084dc45ddef1" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡(x)+3" :db/id #edb/ref 17592186246402}] :answer-field/correct {:answer/id #uuid "c77df695-469d-5c8c-806d-084dc45ddef1" :answer/type {:db/ident :ans