lue "y=sin⁡(-x)-5" :db/id #edb/ref 17592186246322} {:answer/id #uuid "1981d624-c085-5942-9c4b-76868a0a9284" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{5})" :db/id #edb/ref 17592186246323} {:answer/id #uuid "c8458d00-aab9-57a1-bfb0-671475a88144" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(-5x)" :db/id #edb/ref 17592186246324} {:answer/id #uuid "4cd46fa8-9369-5a9b-a3fc-9f183d825f7e" :answer/type {:db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186246325}] :answer-field/correct {:answer/id #uuid "4cd46fa8-9369-5a9b-a3fc-9f183d825f7e" :answer/type {:db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186246325} :answer-field/id #uuid "ee1da551-a4a2-5d93-8dfd-2dc28e4f396d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246320}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e694bf71-afc9-51ff-82ce-ddde47237115" :question/is-example false :question/math-academy-id "q-118442" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/997eb5cc08dcff78cb32f5b47b5d066546854b05f3b066953772e456e713d773.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/1e532c806d81c3c4015d78f814dc4ea3fc3483f22d34ade385894df2e8e7e3c5.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $5.$\n\nTherefore, the given curve is the graph of $y=5sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n5sin⁡(-x)=-5sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-5sin⁡x.$ However, $y=-5sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186246326 :knowledge-point/_questions [{:knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95b83bef-322b-5203-bfb5-c7cdc0979802" :answer/type {:db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186246328} {:answer/id #uuid "7e75bc71-6bb0-574e-b62f-ceb1e04e6abc" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(-x)+6" :db/id #edb/ref 17592186246329} {:answer/id #uuid "74c3cbb6-80e8-57ea-9efa-a2206b897b1a" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{6})" :db/id #edb/ref 17592186246330} {:answer/id #uuid "6e2d72b8-6c79-50e9-8b0f-8897e26aef54" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{6}sin⁡(-x)" :db/id #edb/ref 17592186246331} {:answer/id #uuid "fe8c79e3-37e6-56c9-ab59-e563c1fb180d" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(-6x)" :db/id #edb/ref 17592186246332}] :answer-field/correct {:answer/id #uuid "95b83bef-322b-5203-bfb5-c7cdc0979802" :answer/type {:db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186246328} :answer-field/id #uuid "663e4a10-d411-54ad-b580-95c63bd4d2d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246327}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ef71e5dd-2133-5139-bcc4-313a9e867ac5" :question/is-example false :question/math-academy-id "q-118443" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/f012ee5880b4ec6c4c2cad4aa44da672b789f21c7f9969dcec50a25596e47c4b.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/bc61bf27fb210e0dc849829d5c287936fcb3f73bc279e98af8a64ba4085b8309.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $6.$\n\nTherefore, the given curve is the graph of $y=6sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n6sin⁡(-x)=-6sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-6sin⁡x.$ However, $y=-6sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186246333 :knowledge-point/_questions [{:knowledge-point/id #uuid "1fe335eb-dc4a-5ea0-83cf-ad929e19b908" :knowledge-point/title "Identifying the Reflection and Shifting of a Sine or Cosine Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b4903f5-c49b-511f-8bb6-9cd51b770b8e" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡x-1" :db/id #edb/ref 17592186246335} {:answer/id #uuid "f8625dcd-2689-5277-8fdd-ea789c0707ce" :answer/type {:db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186246336} {:answer/id #uuid "ff8b23fd-ee38-5ab3-9c80-a890ddea2e2a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-sin⁡(1-x)" :db/id #edb/ref 17592186246337} {:answer/id #uuid "8e52d71a-bdfd-5069-b53f-44a27f0aad41" :answer/type {:db/ident :answer.type/math} :answer/value "y=sin⁡(1-x)" :db/id #edb/ref 17592186246338} {:answer/id #uuid "bbac96d7-9d8d-5ddd-96c6-43dd8d7c3ea0" :answer/type {:db/ident :answer.type/math} :answer/value "y=-cos⁡x" :db/id #edb/ref 17592186246339}] :answer-field/correct {:answer/id #uuid "f8625dcd-2689-5277-8fdd-ea789c0707ce" :answer/type {:db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186246336} :answer-field/i