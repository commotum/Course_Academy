question/validate]} {:db/id "q-65832/selection/c10285a48b09cf1089fc9380c64af8c17a7619e9fc452bc3c8766e506e88f6f8" :answer/id #uuid "3f11fbec-47a8-5ab3-a53e-51bb525aeb49" :answer/type :answer.type/math :answer/value "y=cos⁡(-x)" :db/ensure [:answer/validate]} {:db/id "q-65832/selection/4d4250d84c8b4ac9e79af5a831b902db404a23542eacfe379f5c898892084692" :answer/id #uuid "e5de379d-5d91-5a90-97fc-2161608cae48" :answer/type :answer.type/math :answer/value "y=cos⁡x" :db/ensure [:answer/validate]} {:db/id "q-65832/selection/54ce0be3f3b284558e45d68ede2108eaff995f1b92db47ab34993eaa8aed0aa5" :answer/id #uuid "4f4bdcb8-4a61-536a-8eb0-56b45dee010f" :answer/type :answer.type/math :answer/value "y=-sin⁡x" :db/ensure [:answer/validate]} {:db/id "q-65832/selection/df4cbd218a43eb8a30addae8f8c3accff708ae30ebcf81fbe5ff3005225b9785" :answer/id #uuid "d9767d9a-2caf-55a4-b6b7-da53d3cda97d" :answer/type :answer.type/math :answer/value "y=-cos⁡x" :db/ensure [:answer/validate]} {:db/id "q-65832/selection/bc05fd9de19e5a76fc88aa12e5dbd82bf50aef931e32c6099f68c384839c899e" :answer/id #uuid "320ddd3c-8107-5aaa-8a15-74281a5dd1e9" :answer/type :answer.type/math :answer/value "y=sin⁡x" :db/ensure [:answer/validate]} {:db/id "q-65832/selection" :answer-field/id #uuid "3bb4986f-91f0-5c86-9be0-fbab46b46036" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65832/selection/54ce0be3f3b284558e45d68ede2108eaff995f1b92db47ab34993eaa8aed0aa5" :answer-field/choices ["q-65832/selection/c10285a48b09cf1089fc9380c64af8c17a7619e9fc452bc3c8766e506e88f6f8" "q-65832/selection/4d4250d84c8b4ac9e79af5a831b902db404a23542eacfe379f5c898892084692" "q-65832/selection/54ce0be3f3b284558e45d68ede2108eaff995f1b92db47ab34993eaa8aed0aa5" "q-65832/selection/df4cbd218a43eb8a30addae8f8c3accff708ae30ebcf81fbe5ff3005225b9785" "q-65832/selection/bc05fd9de19e5a76fc88aa12e5dbd82bf50aef931e32c6099f68c384839c899e"] :db/ensure [:answer-field/validate]} {:db/id "q-65832" :question/id #uuid "1cd55f38-093b-51a4-ae11-08c7151b5a06" :question/math-academy-id "q-65832" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/6b7b001374d8ef011bc9f2e11cd84b53837c5f4e4133acc31e241cc91c9bd08d.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933758/assets/dba90d9fc6f17599a41cd301247ec604726adb3454a4cee740c639d64c40618f.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $x$-axis.\n\nTherefore, the given curve is the graph of $y=-sin⁡x.$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\nsin⁡(-x)=-sin⁡x\n$$\n\nSo the graph could also be viewed as $y=sin⁡(-x).$ However, $y=sin⁡(-x)$ is not among the given options." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65832/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64edd709-3f6c-59e1-ae1f-bca25eca0483"] :knowledge-point/questions ["q-65832"] :db/ensure [:knowledge-point/validate]} {:db/id "q-118352/selection/bd6fc8caed78c2feeff73d740757824a07819cad34a0ca48a98e0854457e08b0" :answer/id #uuid "2ed64e2a-3d34-574a-bff5-d74e89b16ccc" :answer/type :answer.type/math :answer/value "y=-0.5cos⁡x" :db/ensure [:answer/validate]} {:db/id "q-118352/selection/e3f29cce1be3e83b1e7cffe2c93e8ffb5589e8724205d4cc1ce8ad9c785da428" :answer/id #uuid "7472a9a5-f0a3-5dd6-b23e-7f24dd89189c" :answer/type :answer.type/math :answer/value "y=-cos⁡x-0.5" :db/ensure [:answer/validate]} {:db/id "q-118352/selection/f36c0ffdce5f61c96de246e88c14a396936331c6f82e4121d7cf6044a795f6eb" :answer/id #uuid "e9863649-5095-53f7-b629-413f72682e1e" :answer/type :answer.type/math :answer/value "y=-cos⁡(0.5x)" :db/ensure [:answer/validate]} {:db/id "q-118352/