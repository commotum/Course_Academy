#{[{:db/id #edb/ref 17592186265289 :knowledge-point/_questions [{:knowledge-point/id #uuid "c21c1eca-cf80-56bd-9f44-aab7989cb210" :knowledge-point/title "The Root of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb346170-5629-58f4-bc0c-d993509ceaed" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{7}{4}" :db/id #edb/ref 17592186265291} {:answer/id #uuid "9db617b5-2242-52fc-830d-2be51401cad7" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{4}" :db/id #edb/ref 17592186265292} {:answer/id #uuid "d630e4e1-4378-5d3f-8665-4e2e337f0a8c" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186265293} {:answer/id #uuid "6d9dd709-29f5-5623-8434-3ec987452c77" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{9}{4}" :db/id #edb/ref 17592186265294} {:answer/id #uuid "eb6ec23b-84fa-5cf2-baa4-3b3549673d39" :answer/type {:db/ident :answer.type/math} :answer/value "x=-9" :db/id #edb/ref 17592186265295}] :answer-field/correct {:answer/id #uuid "eb346170-5629-58f4-bc0c-d993509ceaed" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{7}{4}" :db/id #edb/ref 17592186265291} :answer-field/id #uuid "c454162e-e749-5e2c-9443-56f95f7428fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265290}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "56b20cb5-387f-5558-8ac3-be0939a0cd05" :question/math-academy-id "q-166549" :question/problem "Find the root of $f(x)={log}_{2}⁡(4-2x)+1.$" :question/worked-solution "To find the root of $f(x)$, we must solve $f(x)=0:$\n\n$$\n{log}_{2}⁡(4-2x)+1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(4-2x)+1 & =0 \\\\ {log}_{2}⁡(4-2x) & =-1 \\\\ {2}^{{log}_{2}⁡(4-2x)} & ={2}^{-1} \\\\ 4-2x & =\\frac{1}{2} \\\\ -2x & =-\\frac{7}{2} \\\\ x & =\\frac{7}{4}.\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{7}{4}.$"}] [{:db/id #edb/ref 17592186265296 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/title "The Range of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55dd2d9a-6860-50ef-874d-15a8767a00f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186265298} {:answer/id #uuid "3d951e63-07cd-5972-a7bc-f3a80bc91fb3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265299} {:answer/id #uuid "3adcc081-4e1f-5d77-b96f-e51f1a2aa5d2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186265300} {:answer/id #uuid "360b7963-8465-5400-af4e-17412f18b914" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186265301} {:answer/id #uuid "c7737274-d57e-5fbe-9fcc-c0c6da7e5a43" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ has no minimum value" :db/id #edb/ref 17592186265302}] :answer-field/correct {:answer/id #uuid "c7737274-d57e-5fbe-9fcc-c0c6da7e5a43" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ has no minimum value" :db/id #edb/ref 17592186265302} :answer-field/id #uuid "862c4f08-6f55-5ac4-8e2b-770bc13cd3fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265297}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f8fb5fda-7e9d-5035-91c4-d2897d3c5fca" :question/math-academy-id "q-166550" :question/problem "Find the minimum value of $f(x)=4{log}_{2}⁡(2x-3)+1.$" :question/worked-solution "The range of the function $y={log}_{2}⁡x$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ),$ and the function has no minimum value."}] [{:db/id #edb/ref 17592186115848 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a07bb1f9-2936-543b-96f7-393c69e6cac5" :answer/type {:db/ident :answer.type/math} :answer/value "y = 3" :db/id #edb/ref 17592186114460} {:answer/id #uuid "a5c1b451-6031-5b97-8737-627fa47b9a28" :answer/type {:db/ident :answer.type/math} :answer/value "x = 3" :db/id #edb/ref 17592186114461} {:answer/id #uuid "befea7d9-3842-5b52-a5c8-6c672be2ea48" :answer/type {:db/ident :answer.type/math} :answer/value "x = \\frac{1}{3}" :db/id #edb/ref 17592186114462} {:answer/id #uuid "e08c6926-bc3a-5d59-b9bd-dd77a581d669" :answer/type {:db/ident :answer.type/math} :answer/value "x =-3" :db/id #edb/ref 17592186114463} {:answer/id #uuid "1f873f2d-2cf0-537e-8c5c-1b74c3fbc69a" :answer/type {:db/ident :answer.type/math} :answer/value "x = 0" :db/id #edb/ref 17592186114464}] :answer-field/correct {:answer/id #uuid "a5c1b451-6031-5b97-8737-627fa47b9a28" :answer/type {:db/ident :answer.type/math} :answer/value "x = 3" :db/id #edb/ref 17592186114461} :answer-field/id #uuid "314bc716-5cd2-5606-aab5-43a420f3e571" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114459}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e608bcaa-7a23-5768-9790-7c62cbc3a9b4" :question/math-academy-id "q-66690" :question/problem "Find the equation of the vertical asymptote of the function $f(x) = \\ln (x - 3) + 1$." :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{ln}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x)$, we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}x-3 & =0 \\\\ x & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=3.$"}] [{:db/id #edb/ref 17592186265303 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/title "The Range of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c6d5183-45c5-553d-8242-4e7d3c69f6c5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186265305} {:answer/id #uuid "dd89d600-48b5-5d79-b079-7886cdb40b93" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186265306} {:answer/id #uuid "313e205b-939b-586d-b4d7-ae158eb19fd8" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186265307} {:answer/id #uuid "e7fa020a-f470-5665-bc0e-b8b55281f31f" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ has no maximum value" :db/id #edb/ref 17592186265308} {:answer/id #uuid "7a122e2c-cd9f-55ad-b2ae-88cf9483b6cc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186265309}] :answer-field/correct {:answer/id #uuid "e7fa020a-f470-5665-bc0e-b8b55281f31f" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ has no maximum value" :db/id #edb/ref 17592186265308} :answer-field/id #uuid "9d64d805-212e-5e1a-a4be-d4585e417574" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265304}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b338b5cf-801c-50c4-9622-d9ab0fa4da90" :question/math-academy-id "q-81863" :question/problem "Find the maximum value of $f(x)=4\\operatorname{ln}⁡(\\frac{x}{3}-3)+2.$" :question/worked-solution "The range of the function $y=\\operatorname{ln}⁡x$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ),$ and the function has no maximum value."}] [{:db/id #edb/ref 17592186265310 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff80dafc-f26a-5b6b-ab27-0e3d96ca267b" :answer/type {:db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186265312} {:answer/id #uuid "3f4f62e2-7c6d-5b3e-aa11-c4acc4710aba" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186265313} {:answer/id #uuid "328918db-527b-5e7f-bc8c-27adadee2483" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186265314} {:answer/id #uuid "1dfcb632-e1c3-55bc-9618-ff7d38a70e95" :answer/type {:db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186265315} {:answer/id #uuid "551d0da0-7fe7-5eea-b768-fc69d873da72" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}" :db/id #edb/ref 17592186265316}] :answer-field/correct {:answer/id #uuid "328918db-527b-5e7f-bc8c-27adadee2483" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186265314} :answer-field/id #uuid "78a3c69b-3f85-5c06-b4c9-28018089bae7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265311}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f6783c59-6d21-5916-ba26-0d8712005bc7" :question/math-academy-id "q-81992" :question/problem "Find the equation of the vertical asymptote of the function $f(x)=2{log}_{4}⁡(-3x)+6.$" :question/worked-solution "The equation of the vertical asymptote of the function $y={log}_{4}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}-3x & =0 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=0.$"}]}
