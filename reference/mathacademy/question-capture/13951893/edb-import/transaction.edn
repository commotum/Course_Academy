 :db/ensure [:answer-field/validate]} {:db/id "q-166549" :question/id #uuid "56b20cb5-387f-5558-8ac3-be0939a0cd05" :question/math-academy-id "q-166549" :question/problem "Find the root of $f(x)={log}_{2}⁡(4-2x)+1.$" :question/worked-solution "To find the root of $f(x)$, we must solve $f(x)=0:$\n\n$$\n{log}_{2}⁡(4-2x)+1=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(4-2x)+1 & =0 \\\\ {log}_{2}⁡(4-2x) & =-1 \\\\ {2}^{{log}_{2}⁡(4-2x)} & ={2}^{-1} \\\\ 4-2x & =\\frac{1}{2} \\\\ -2x & =-\\frac{7}{2} \\\\ x & =\\frac{7}{4}.\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=\\frac{7}{4}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-166549/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c21c1eca-cf80-56bd-9f44-aab7989cb210"] :knowledge-point/questions ["q-166549"] :db/ensure [:knowledge-point/validate]} {:db/id "q-166550/selection/febfda7cd0ac8c87a277957512aac90f76d32c1a93b7a0cbc89408f0c656bffb" :answer/id #uuid "c7737274-d57e-5fbe-9fcc-c0c6da7e5a43" :answer/type :answer.type/text :answer/value "$f(x)$ has no minimum value" :db/ensure [:answer/validate]} {:db/id "q-166550/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3d951e63-07cd-5972-a7bc-f3a80bc91fb3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-166550/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "3adcc081-4e1f-5d77-b96f-e51f1a2aa5d2" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-166550/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "55dd2d9a-6860-50ef-874d-15a8767a00f6" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-166550/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id