[{:db/id [:question/math-academy-id "q-66690"] :question/worked-solution "The equation of the vertical asymptote of the function $y=\\operatorname{ln}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x)$, we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}x-3 & =0 \\\\ x & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=3.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-81863/selection/c883818b4ca17ce28054953181bafc2401ccdf902930b88e553529999991227a" :answer/id #uuid "e7fa020a-f470-5665-bc0e-b8b55281f31f" :answer/type :answer.type/text :answer/value "$f(x)$ has no maximum value" :db/ensure [:answer/validate]} {:db/id "q-81863/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4c6d5183-45c5-553d-8242-4e7d3c69f6c5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-81863/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "dd89d600-48b5-5d79-b079-7886cdb40b93" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-81863/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7a122e2c-cd9f-55ad-b2ae-88cf9483b6cc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-81863/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "313e205b-939b-586d-b4d7-ae158eb19fd8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-81863/selection" :answer-field/id #uuid "9d64d805-212e-5e1a-a4be-d4585e417574" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81863/selection/c883818b4ca17ce28054953181bafc2401ccdf902930b88e553529999991227a" :answer-field/choices ["q-81863/sele