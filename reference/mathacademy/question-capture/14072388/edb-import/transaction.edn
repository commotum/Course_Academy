t{d}{y}_{2}}{\\text{d}x}+b{y}_{2}\\frac{\\text{d}{y}_{1}}{\\text{d}x})" :db/ensure [:answer/validate]} {:db/id "q-338094/field-4" :answer-field/id #uuid "3f71b01c-f16b-5354-9134-346b2d2685f5" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-338094/field-4/046965f4c4b33746637c71fadd9a6c5276a3a7b6a5704645d0414924ec0c3827" :answer-field/choices ["q-338094/field-4/046965f4c4b33746637c71fadd9a6c5276a3a7b6a5704645d0414924ec0c3827" "q-338094/field-4/9b8a6eac2f7c4ece8448c40c3dd8f9b72f009f02188d8ba0d1f1ed4ef828a7ac"] :db/ensure [:answer-field/validate]} {:db/id "q-338094/field-5/1801eb49afd418c37d4758c6270ecd785b57da55f39b3fa2df2006bd3477d242" :answer/id #uuid "bbc30202-13c6-597d-9ed9-fc499b2fbb07" :answer/type :answer.type/math :answer/value "D(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-338094/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" :answer/id #uuid "cdb3f247-e070-5f90-9763-d9cee529f24f" :answer/type :answer.type/math :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-338094/field-5" :answer-field/id #uuid "92002259-14dc-5f74-96ab-44ecfd016fda" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "q-338094/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" :answer-field/choices ["q-338094/field-5/1801eb49afd418c37d4758c6270ecd785b57da55f39b3fa2df2006bd3477d242" "q-338094/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c"] :db/ensure [:answer-field/validate]} {:db/id "q-338094/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" :answer/id #uuid "6a2a8f23-66a6-5ed9-9ef3-3f3b70fc69e0" :answer/type :answer.type/text :answer/value "nonlinear" :db/ensure [:answer/validate]} {:db/id "q-338094/field-6/12092065ff4e11bb0d25fd69995cf910e9de428f4ac180ad1cb0a43a1ec62103" :answer/id #uuid "458de00b-0d57-5eb4-a5b3-35807c18bb42" :answer/type :answer.type/text :answer/value "linear" :db/ensure [:answer/validate]} {:db/id "q-338094/field-6" :answer-field/id #uuid "748285e4-acd7-581b-986c-9e7ab286d242" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/correct "q-338094/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" :answer-field/choices ["q-338094/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" "q-338094/field-6/12092065ff4e11bb0d25fd69995cf910e9de428f4ac180ad1cb0a43a1ec62103"] :db/ensure [:answer-field/validate]} {:db/id "q-338094" :question/id #uuid "05b2756b-6060-5783-bd8d-f31a355170a0" :question/math-academy-id "q-338094" :question/problem "Consider the following differential operator:\n\n$$\nD(y)=y\\frac{\\text{d}y}{\\text{d}x}-2y\n$$\n\nFill in the steps in the reasoning below.\n\nFor any linear differential operator $L,$ we have the linearity condition\n\n$$\n{{field-1}}\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})-2(a{y}_{1}+b{y}_{2}) \\\\  & ={{field-2}}-2\\cdot {{field-3}} \\\\  & +ab\\cdot {{field-4}}.\\end{aligned}\n$$\n\nWe also have\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}-2{y}_{1}]+b[{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}-2{y}_{2}] \\\\  & =a{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}-2(a{y}_{1}+b{y}_{2}).\\end{aligned}\n$$\n\nNow, since {{field-5}} \nthe operator $D$ is {{field-6}}." :question/worked-solution "For any linear differential operator $L,$ we have the linearity condition\n\n$$\nL(a{y}_{1}+b{y}_{2})=aL({y}_{1})+bL({y}_{2})\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})-2(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})-2(a{y}_{1}+b{y}_{2}) \\\\  & ={a}^{2}{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+ab{y}_{1}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ab{y}_{2}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+{b}^{2}{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}-2a{y}_{1}-2b{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+{b}^{2}{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}-2\\cdot (a{y}_{1}+b{y}_{2}) \\\\  & +ab\\cdot ({y}_{1}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{y}_{2}\\frac{\\text{d}{y}_{1}}{\\text{d}x}) \\\\ .\\end{aligned}\n$$\n\nThis is *not* the same as the right-hand side, because\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}-2{y}_{1}]+b[{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}-2{y}_{2}] \\\\  & =a{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}-2(a{y}_{1}+b{y}_{2}).\\end{aligned}\n$$\n\nTherefore, since $D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2}),$ the operator $D$ is $\\text{nonlinear}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338094/field-1" "q-338094/field-2" "q-338094/field-3" "q-338094/field-4" "q-338094/field-5" "q-338094/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0"] :knowledge-point/questions ["q-338094"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337773/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "e24fa340-907a-52d6-a095-188a1a1ec142" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-337773/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "e68cd434-c89b-5641-91c3-4d7d8918fad4" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-337773/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "72a4cc06-be9d-5319-a415-e0e3d3a09544" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-337773/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "6be0c2da-0f70-5671-8152-1a73acbf4a4d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-337773/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "b4bb5587-4929-5e04-bcbc-b3a8a149114e" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-337773/selection" :answer-field/id #uuid "ee8db3a3-3773-5d3d-89aa-6db0b9e17b76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-337773/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-337773/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-337773/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-337773/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-337773/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-337773/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25"] :db/ensure [:answer-field/validate]} {:db/id "q-337773" :question/id #uuid "0f47da55-44c0-5b9f-b9f5-4e0250b32c15" :question/math-academy-id "q-337773" :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=\\frac{1}{1+{x}^{2}}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+\\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x}+\\sqrt{x}y$\n- ${D}_{2}(y)=\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+\\operatorname{sin}⁡(xy)\\frac{\\text{d}y}{\\text{d}x}$\n- ${D}_{3}(y)={e}^{x}\\frac{\\text{d}y}{\\text{d}x}-\\operatorname{ln}⁡(x)\\,y$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{1}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=\\frac{1}{1+{x}^{2}},{f}_{1}(x)=\\operatorname{cos}⁡(x),$ and ${f}_{0}(x)=\\sqrt{x}.$\n\n- Operator ${D}_{2}$ is *not* linear. The coefficient of the last term is $\\operatorname{sin}⁡(xy),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{3}$ is linear. It is a first-order linear differential operator of the form\n\n$$\n{D}_{3}(y)={f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{1}(x)={e}^{x},$ and ${f}_{0}(x)=-\\operatorname{ln}⁡(x).$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-337773/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397"] :knowledge-point/questions ["q-337773"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-337662"] :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-2\\frac{\\text{d}y}{\\text{d}x}$\n- ${D}_{2}(y)={y}^{2}\\frac{\\text{d}y}{\\text{d}x}$\n- ${D}_{3}(y)=2\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}-x\\frac{\\text{d}y}{\\text{d}x}+{y}^{2}$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{1}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}=x,{f}_{1}=-2,$ and ${f}_{0}=0.$\n\n- Operator ${D}_{2}$ is *not* linear. The coefficient of the first term is ${y}^{2},$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{3}$ is *not* linear. The last term contains the nonlinear term ${y}^{2},$ which fails linearity.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-65035"] :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})=4x$ and $L({y}_{2})={x}^{2}+1$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L({y}_{1}-2{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L({y}_{1}-2{y}_{2}) & =L({y}_{1})-2L({y}_{2}) \\\\  & =4x-2({x}^{2}+1) \\\\  & =-2{x}^{2}+4x-2 \\\\  & =-2({x}^{2}-2x+1) \\\\  & =-2(x-1)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-79606/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer/id #uuid "ef50d35e-0b69-5ec6-8a90-4de29a7ed011" :answer/type :answer.type/math :answer/value "{x}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-79606/selection/403cffab0b7382d462683444455b1c6c591beabbf4f575b062668dee05a6816d" :answer/id #uuid "5d9cf061-7f5e-55c8-af91-7692f3c4e70a" :answer/type :answer.type/math :answer/value "{x}^{2}+2x-1" :db/ensure [:answer/validate]} {:db/id "q-79606/selection/453cd6ee10b45c2c9a77a3187b5d86ad5dcb6ecd4665bd914132c34a11c8ae4d" :answer/id #uuid "d9a3ace8-17ed-57a9-9e8b-06e21d220cd5" :answer/type :answer.type/math :answer/value "{x}^{2}+x+3" :db/ensure [:answer/validate]} {:db/id "q-79606/selection/b315673730a8da15793ea8fa47a405177020824767401ab08a1fed495048e539" :answer/id #uuid "3dfb56cd-9d37-512e-8110-174346f5691b" :answer/type :answer.type/math :answer/value "{x}^{2}-x-4" :db/ensure [:answer/validate]} {:db/id "q-79606/selection/4fb17f261e904acf135ebcd64b2c6ee5d6d28610997d2d0c2fbe0ff4712d8f99" :answer/id #uuid "c33b5e08-82ba-5fdb-aeb7-3514f60cd69b" :answer/type :answer.type/math :answer/value "{x}^{2}+3" :db/ensure [:answer/validate]} {:db/id "q-79606/selection" :answer-field/id #uuid "76f11b98-86d4-5ab2-aa5b-2f2eda2a46ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79606/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer-field/choices ["q-79606/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" "q-79606/selection/403cffab0b7382d462683444455b1c6c591beabbf4f575b062668dee05a6816d" "q-79606/selection/453cd6ee10b45c2c9a77a3187b5d86ad5dcb6ecd4665bd914132c34a11c8ae4d" "q-79606/selection/b315673730a8da15793ea8fa47a405177020824767401ab08a1fed495048e539" "q-79606/selection/4fb17f261e904acf135ebcd64b2c6ee5d6d28610997d2d0c2fbe0ff4712d8f99"] :db/ensure [:answer-field/validate]} {:db/id "q-79606" :question/id #uuid "7e7a3c2e-9c63-59a7-997e-a36d48877090" :question/math-academy-id "q-79606" :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})={x}^{2}+3x+5$ and $L({y}_{2})=x+2$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L({y}_{1}-3{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L({y}_{1}-3{y}_{2}) & =L({y}_{1})-3L({y}_{2}) \\\\  & ={x}^{2}+3x+5-3(x+2) \\\\  & ={x}^{2}+3x+5-3x-6 \\\\  & ={x}^{2}-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79606/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68148c93-9139-5deb-8a53-a05d63ec5930"] :knowledge-point/questions ["q-79606"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130079/selection/cfc8fef17e139caa5fddf2aa821cf0d765f6ef916d009a28f07f272343f7f48b" :answer/id #uuid "ad96a296-872d-5a47-87eb-85870a316a11" :answer/type :answer.type/math :answer/value "{csc}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-130079/selection/76b4b807126ce798c91306c932d29f9159246601ba1edbc9137b690f3c35f7d3" :answer/id #uuid "f771000f-7d71-5e2c-ac7b-d1fc607679c9" :answer/type :answer.type/math :answer/value "3{csc}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-130079/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ab9982c0-c478-5d0c-b779-de2ed3353e19" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-130079/selection/f901ccd6c0b2fc2fc21749a276d9f7c3a81aafb7e6b4a22d5b484a7923896a46" :answer/id #uuid "424ef8a0-36f2-5540-bbbe-197e6fe5f6b1" :answer/type :answer.type/math :answer/value "2{csc}^{2}⁡x+4" :db/ensure [:answer/validate]} {:db/id "q-130079/selection/cd36467fb25b0d3d692a359c6ea85ccdbe478c7767be42bad03b177278138572" :answer/id #uuid "79013f64-57af-5279-b411-bf9955e8997b" :answer/type :answer.type/math :answer/value "{csc}^{2}⁡x+{cot}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "q-130079/selection" :answer-field/id #uuid "af16d01b-c365-5c24-81be-600b55e7cf0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130079/selection/cfc8fef17e139caa5fddf2aa821cf0d765f6ef916d009a28f07f272343f7f48b" :answer-field/choices ["q-130079/selection/cfc8fef17e139caa5fddf2aa821cf0d765f6ef916d009a28f07f272343f7f48b" "q-130079/selection/76b4b807126ce798c91306c932d29f9159246601ba1edbc9137b690f3c35f7d3" "q-130079/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-130079/selection/f901ccd6c0b2fc2fc21749a276d9f7c3a81aafb7e6b4a22d5b484a7923896a46" "q-130079/selection/cd36467fb25b0d3d692a359c6ea85ccdbe478c7767be42bad03b177278138572"] :db/ensure [:answer-field/validate]} {:db/id "q-130079" :question/id #uuid "ad9c70a3-99b4-5fe9-8a82-921436740f17" :question/math-academy-id "q-130079" :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})={cot}^{2}⁡x$ and $L({y}_{2})=3{csc}^{2}⁡x-4$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L(4{y}_{1}-{y}_{2})?$\n\n*Hint: Use ${csc}^{2}⁡\\theta =1+{cot}^{2}⁡\\theta .$*" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L(4{y}_{1}-{y}_{2}) & =4L({y}_{1})-L({y}_{2}) \\\\  & =4\\cdot {cot}^{2}⁡x-(3{csc}^{2}⁡x-4) \\\\  & =4{cot}^{2}⁡x+4-3{csc}^{2}⁡x \\\\  & =4(1+{cot}^{2}⁡x)-3{csc}^{2}⁡x \\\\  & =4{csc}^{2}⁡x-3{csc}^{2}⁡x \\\\  & ={csc}^{2}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130079/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68148c93-9139-5deb-8a53-a05d63ec5930"] :knowledge-point/questions ["q-130079"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130077/selection/edec7e149a1ac9ad68069cffaf517cdea709256bd845ba75b1aecb51bdf231a3" :answer/id #uuid "e582321f-ac77-5cf4-9bbb-781a02ed0501" :answer/type :answer.type/math :answer/value "{e}^{x}+5" :db/ensure [:answer/validate]} {:db/id "q-130077/selection/fd31eaefba