matrix}4 \\\\ 5 \\\\ 3\\end{bmatrix} + t\\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103795} {:answer/id #uuid "3a4fa93a-f903-5e67-90a6-c8418b66d83b" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}-1 \\\\ 2 \\\\ 0\\end{bmatrix} + t\\begin{bmatrix}-5 \\\\ -3 \\\\ 3\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103796} {:answer/id #uuid "6ca761a2-5379-5471-98b5-531ea24644fa" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}5 \\\\ 3 \\\\ 3\\end{bmatrix} + t\\begin{bmatrix}4 \\\\ 5 \\\\ 3\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103797} {:answer/id #uuid "6cf12303-1d69-55ad-ab50-e8613c7553db" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}-5 \\\\ -3 \\\\ -3\\end{bmatrix} + t\\begin{bmatrix}4 \\\\ 5 \\\\ 3\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103798}] :answer-field/correct {:answer/id #uuid "860886a8-2772-528c-965a-b839b0c95a2c" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}4 \\\\ 5 \\\\ 3\\end{bmatrix} + t\\begin{bmatrix}-5 \\\\ -3 \\\\ -3\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186103794} :answer-field/id #uuid "9f911e96-3228-59b5-9a32-d12c7b2b2380" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103793}] :question/id #uuid "3ed6737a-6704-5d6d-9ae9-04e0ade520fe" :question/math-academy-id "q-35973" :question/problem "Find a vector equation of the line that passes through the points $A(4, 5, 3)$ and $B(-1, 2, 0)$."}] [{:db/id #edb/ref 17592186311187 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03bb1d80-0e09-5279-ba61-e3b34b1934f6" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-4 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 5 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186311189} {:answer/id #uuid "3a3de85a-798b-573f-aad2-4cd3b7bca002" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}4 \\\\ 3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}3 \\\\ 2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186311190} {:answer/id #uuid "b030f7d5-dd54-5e2a-ad3e-f51a1bf0dabc" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-4 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}5 \\\\ 5 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186311191} {:answer/id #uuid "1ce76003-0b7a-50b2-b3a2-fd15f4845c69" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 2 \\\\ 4\\end{aligned}]+t[\\begin{aligned}5 \\\\ -5 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186311192} {:answer/id #uuid "1ba33e16-89dd-5424-9ffc-a5c450f1db01" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-4 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}1 \\\\ 2 \\\\ 4\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186311193}] :answer-field/correct {:answer/id #uuid "b030f7d5-dd54-5e2a-ad3e-f51a1bf0dabc" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-4 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}5 \\\\ 5 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186311191} :answer-field/id #uuid "1ff96cd7-3685-5fde-ab5c-d93df5715d3d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311188}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1b5b7d76-7995-5fd2-be2e-9a59c7b1bd88" :question/math-academy-id "q-69772" :question/problem "Find a vector equation of the line that passes through the points $K(-4,-3,-1)$ and $L(1,2,4).$" :question/worked-solution "The vector equation of the straight line passing through $K$ and parallel to $v$ is given by\n\n$$\nr=k+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $k$ is the position vector of $K.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $K(-4,-3,-1)$ and $L(1,2,4),$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{KL} \\\\  & =⟨1,2,4⟩-⟨-4,-3,-1⟩ \\\\  & =⟨5,5,5⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}-4 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}5 \\\\ 5 \\\\ 5\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186311215 :knowledge-point/_questions [{:knowledge-point/id #uuid "c338d1eb-7e13-5089-8dd3-d5ca6eefd4ba" :knowledge-point/title "Finding Points on a Line That Are a Fixed Distance From Another Point on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00372776-9900-5873-b2d8-8af723760951" :answer/type {:db/ident :answer.type/text} :answer/value "${Q}_{1}(6,2,2)$ and ${Q}_{2}(1,0,-2)$" :db/id #edb/ref 17592186311217} {:answer/id #uuid "e54b1804-49df-5963-bd11-66814707531f" :answer/type {:db/ident :answer.type/text} :answer/value "${Q}_{1}(4,2,6)$ and ${Q}_{2}(1,0,2)$" :db/id #edb/ref 17592186311218} {:answer/id #uuid "2aaa7882-74d1-5f0e-a190-932cda76b670" :answer/type {:db/ident :answer.type/text} :answer/value "${Q}_{1}(2,0,6)$ and ${Q}_{2}(0,2,-4)$" :db/id #edb/ref 17592186311219} {:answer/id #uuid "f00c74ee-9fcf-54b1-97e8-a6bac73a5b5e" :answer/type {:db/ident :answer.type/text} :answer/value "${Q}_{1}(2,0,6)$ and ${Q}_{2}(-1,3,-9)$" :db/id #edb/ref 17592186311220} {:answer/id #uuid "0cc8c193-62df-53c3-8f7c-bc7b22d80f1b" :answer/type {:db/ident :answer.type/text} :answer/value "${Q}_{1}(3,-1,11)$ and ${Q}_{2}(0,2,-4)$" :db/id #edb/ref 17592186311221}] :answer-field/correct {:answer/id #uuid "2aaa7882-74d1-5f0e-a190-932cda76b670" :answer/type {:db/ident :answer.type/text} :answer/value "${Q}_{1}(2,0,6)$ and ${Q}_{2}(0,2,-4)$" :db/id #edb/ref 17592186311219} :answer-field/id #uuid "13bc0196-3911-5c03-a822-6873c92903a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311216}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ca1265ac-23c6-5e5b-be9c-b56a47160343" :question/math-academy-id "q-77443" :question/problem "Consider the straight line that passes through $P(1,1,1)$ and is parallel to $v=⟨1,-1,5⟩.$ Find all the possible points $Q$ on that line such that $PQ=3\\sqrt{3}.$" :question/worked-solution "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨1,1,1⟩+t⟨1,-1,5⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $Q$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OQ} & =⟨1,1,1⟩+t⟨1,-1,5⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =(⟨1,1,1⟩+t⟨1,-1,5⟩)-⟨1,1,1⟩ \\\\  & =t\\,⟨1,-1,5⟩ \\\\  & =⟨t,\\,-t,\\,5t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PQ=3\\sqrt{3},$ we get:\n\n$$\n\\begin{aligned}PQ & =3\\sqrt{3} \\\\ |\\overset{\\to }{PQ}| & =3\\sqrt{3} \\\\ |⟨t,\\,-t,\\,5t⟩| & =3\\sqrt{3} \\\\ \\sqrt{{t}^{2}+(-t)^{2}+(5t)^{2}} & =3\\sqrt{3} \\\\ \\sqrt{27{t}^{2}} & =3\\sqrt{3} \\\\ \\pm 3\\sqrt{3}t & =3\\sqrt{3} \\\\ t & =\\pm 1\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 1$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{Q}_{1}}=⟨1,1,1⟩+⟨1,-1,5⟩=⟨2,0,6⟩, \\\\  & \\overset{\\to }{O{Q}_{2}}=⟨1,1,1⟩-⟨1,-1,5⟩=⟨0,2,-4⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${Q}_{1}(2,0,6)$ and ${Q}_{2}(0,2,-4).$"}]}
