5 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378914 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378914 1111 #uuid "64fc9283-cab9-51bc-be23-25d1cd96bcda" 13194139535999 true] [17592186378915 1034 "r=[\\begin{aligned}4 \\\\ 5 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 2 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378915 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378915 1111 #uuid "d8f02f12-9285-59bc-9c82-83ad34cd9a0b" 13194139535999 true] [17592186378916 1017 #edb/ref 17592186378917 13194139535999 true] [17592186378916 1089 "q-69773" 13194139535999 true] [17592186378916 1091 #edb/ref 17592186045465 13194139535999 true] [17592186378916 1100 "Find a vector equation of the line that passes through the points $H(5,7,2)$ and $S(3,4,5).$" 13194139535999 true] [17592186378916 1113 #uuid "de330e5d-d3af-5611-ac93-1e08d17f5215" 13194139535999 true] [17592186378916 1145 "The vector equation of the straight line passing through $H$ and parallel to $v$ is given by\n\n$$\nr=h+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $h$ is the position vector of $H.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $H(5,7,2)$ and $S(3,4,5),$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{HS} \\\\  & =⟨3,4,5⟩-⟨5,7,2⟩ \\\\  & =⟨-2,-3,3⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139535999 true] [17592186378917 1000 #edb/ref 17592186378918 13194139535999 true] [17592186378917 1000 #edb/ref 17592186378919 13194139535999 true] [17592186378917 1000 #edb/ref 17592186378920 13194139535999 true] [17592186378917 1000 #edb/ref 17592186378921 13194139535999 true] [17592186378917 1000 #edb/ref 17592186378922 13194139535999 true] [17592186378917 1040 #edb/ref 17592186045450 13194139535999 true] [17592186378917 1041 "selection" 13194139535999 true] [17592186378917 1104 #edb/ref 17592186378919 13194139535999 true] [17592186378917 1110 #uuid "a0373824-e32c-5e43-b21a-847d8420e64d" 13194139535999 true] [17592186378918 1034 "r=[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -3 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378918 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378918 1111 #uuid "1953663d-ab90-50f6-b08e-653bfe3446df" 13194139535999 true] [17592186378919 1034 "r=[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378919 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378919 1111 #uuid "36d8115c-bc43-5724-83b7-4520a32f47a3" 13194139535999 true] [17592186378920 1034 "r=[\\begin{aligned}3 \\\\ 4 \\\\ 5\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 3 \\\\ -3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378920 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378920 1111 #uuid "5cdb49fa-d1fe-51c5-8858-02e190fac073" 13194139535999 true] [17592186378921 1034 "r=[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}]+t[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378921 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378921 1111 #uuid "484d9fd6-a59b-59bb-9270-d5de5473dd11" 13194139535999 true] [17592186378922 1034 "r=[\\begin{aligned}2 \\\\ 5 \\\\ 0\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" 13194139535999 true] [17592186378922 1103 #edb/ref 17592186045453 13194139535999 true] [17592186378922 1111 #uuid "90894d0b-7cad-5552-839d-9145be534991" 13194139535999 true] [17592186378923 1017 #edb/ref 17592186378924 13194139535999 true] [17592186378923 1089 "q-69783" 13194139535999 true] [17592186378923 1091 #edb/ref 17592186045464 13194139535999 true] [17592186378923 1100 "Consider the straight line that passes through $P(1,0,0)$ and is parallel to $v=⟨1,1,1⟩.$ Find all the possible points $R$ on that line such that $RP=3\\sqrt{3}.$" 13194139535999 true] [17592186378923 1113 #uuid "2efe9b2b-7d22-5f68-b28a-0c83a296200e" 13194139535999 true] [17592186378923 1145 "First, we find the vector equation of the line, as follows:\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =⟨1,0,0⟩+t⟨1,1,1⟩\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSince $R$ lies on the line, we know that there must be a real number $t$ such that\n\n$$\n\\begin{aligned}\\overset{\\to }{OR} & =⟨1,0,0⟩+t⟨1,1,1⟩\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}\\overset{\\to }{PR} & =\\overset{\\to }{OR}-\\overset{\\to }{OP} \\\\  & =(⟨1,0,0⟩+t⟨1,1,1⟩)-⟨1,0,0⟩ \\\\  & =t\\,⟨1,1,1⟩ \\\\  & =⟨t,\\,t,\\,t⟩.\\end{aligned}\n$$\n\nUsing the fact that $PR=3\\sqrt{3},$ we get:\n\n$$\n\\begin{aligned}RP & =3\\sqrt{3} \\\\ |\\overset{\\to }{PR}| & =3\\sqrt{3} \\\\ |⟨t,\\,t,\\,t⟩| & =3\\sqrt{3} \\\\ \\sqrt{{t}^{2}+{t}^{2}+{t}^{2}} & =3\\sqrt{3} \\\\ \\sqrt{3{t}^{2}} & =3\\sqrt{3} \\\\ \\pm t\\sqrt{3} & =3\\sqrt{3} \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nFinally, putting the values $t=\\pm 3$ into the equation for the line, we obtain\n\n$$\n\\begin{aligned} & \\overset{\\to }{O{R}_{1}}=⟨1,0,0⟩+3⟨1,1,1⟩=⟨4,3,3⟩, \\\\  & \\overset{\\to }{O{R}_{2}}=⟨1,0,0⟩-3⟨1,1,1⟩=⟨-2,-3,-3⟩.\\end{aligned}\n$$\n\nTherefore, the points are ${R}_{1}(4,3,3)$ and ${R}_{2}(-2,-3,-3).$" 13194139535999 true] [17592186378924 1000 #edb/ref 17592186378925 13194139535999 true] [17592186378924 1000 #edb/ref 17592186378926 13194139535999 true] [17592186378924 1000 #edb/ref 17592186378927 13194139535999 true] [17592186378924 1000 #edb/ref 17592186378928 13194139535999 true] [17592186378924 1000 #edb/ref 17592186378929 13194139535999 true] [17592186378924 1040 #edb/ref 17592186045