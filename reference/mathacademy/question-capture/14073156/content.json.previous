          "correct_value": "r=[\\begin{aligned}-3 \\\\ -4 \\\\ -5\\end{aligned}]+t[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )",
