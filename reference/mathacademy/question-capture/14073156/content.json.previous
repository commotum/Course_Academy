            {
              "type": "math",
              "value": "r=[\\begin{aligned}-3 \\\\ -4 \\\\ -5\\end{aligned}]+[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}]"
            },
            {
              "type": "math",
              "value": "r=[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}]+t[\\begin{aligned}-3 \\\\ -4 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"
            },
            {
              "type": "math",
              "value": "r=[\\begin{aligned}-2 \\\\ 1 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-5 \\\\ -4 \\\\ -3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"
            },
            {
              "type": "math",
              "value": "r=[\\begin{aligned}-3 \\\\ -4 \\\\ -5\\end{aligned}]+t[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"
            },
            {
              "type": "math",
              "value": "r=[\\begin{aligned}-3 \\\\ -5 \\\\ -4\\end{aligned}]+t[\\begin{aligned}1 \\\\ -2 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )"
