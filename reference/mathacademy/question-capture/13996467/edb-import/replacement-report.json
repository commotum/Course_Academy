          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13996467/example-10535.json",
          "file_sha256": "89d86a4c8e1e0a6a01e17336950970a6c2bb822121ced029d8592aa7055ebf7a"
