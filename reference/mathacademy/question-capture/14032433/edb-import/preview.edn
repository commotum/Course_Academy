35 true] [17592186293640 1104 #edb/ref 17592186293641 13194139534535 true] [17592186293640 1110 #uuid "e92dc376-c3a9-5050-8b2f-44b8cf618769" 13194139534535 true] [17592186293641 1034 "\\frac{1}{13}" 13194139534535 true] [17592186293641 1103 #edb/ref 17592186045453 13194139534535 true] [17592186293641 1111 #uuid "fa5e20dd-581a-5af7-bfe2-4337980fa60d" 13194139534535 true] [17592186293642 1017 #edb/ref 17592186293643 13194139534535 true] [17592186293642 1089 "q-341751" 13194139534535 true] [17592186293642 1091 #edb/ref 17592186045465 13194139534535 true] [17592186293642 1100 "If $x=-\\frac{16}{\\sqrt[3]{y}}+13,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(5,8).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)}=$\n{{field-1}}" 13194139534535 true] [17592186293642 1113 #uuid "e940fea3-bcaa-58ab-8420-8e18e250d215" 13194139534535 true] [17592186293642 1145 "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{16}{\\sqrt[3]{y}}+13) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-16{y}^{-1/3}+13) \\\\  & =-16\\frac{\\text{d}}{\\text{d}y}({y}^{-1/3})+\\frac{\\text{d}}{\\text{d}y}(13) \\\\  & =-16(-\\frac{1}{3}{y}^{-4/3})+0 \\\\  & =\\frac{16}{3}{y}^{-4/3} \\\\  & =\\frac{16}{3{(\\sqrt[3]{y})}^{4}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{3{(\\sqrt[3]{y})}^{4}}{16}.\n$$\n\nFinally, substituting the point $(5,8),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)} & =\\frac{3{(\\sqrt[3]{8})}^{4}}{16} \\\\  & =\\frac{3(16)}{16} \\\\  & =3.\\end{aligned}\n$$" 13194139534535 true] [17592186293643 1000 #edb/ref 17592186293644 13194139534535 true] [17592186293643 1040 #edb/ref 17592186045449 13194139534535 true] [17592186293643 1041 "field-1" 13194139534535 true] [17592186293643 1104 #edb/ref 17592186293644 13194139534535 tru