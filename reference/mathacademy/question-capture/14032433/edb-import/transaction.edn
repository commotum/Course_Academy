[{:db/id "q-32706/selection/cc5dbf87f4dbee91d1c29e8013069443539b3fd684157fee71e97221215a4d5e" :answer/id #uuid "03287b22-331d-5e0b-bff8-0bf1b7ab2de1" :answer/type :answer.type/math :answer/value "83" :db/ensure [:answer/validate]} {:db/id "q-32706/selection/0a2bcf0b23beaf0b660371dc25fd2ff9b62fc80e085eab676caddb7c03f6120d" :answer/id #uuid "c40962be-eb02-5bb1-90ba-9f02206d11ed" :answer/type :answer.type/math :answer/value "\\frac{1}{83}" :db/ensure [:answer/validate]} {:db/id "q-32706/selection/a8dd3023a15736f67ea6d8ea5b4152008e8f88c3ce9ec6730573f2f45df5d928" :answer/id #uuid "b5c96cd1-3965-5795-becb-04fd05ce6b20" :answer/type :answer.type/math :answer/value "\\frac{1}{29}" :db/ensure [:answer/validate]} {:db/id "q-32706/selection/5c96e860ee66aaeff8bf13df8c52fdb0e38e76da507b4dd012c09a12adf24b38" :answer/id #uuid "d9a76e15-6610-5af2-a169-b2bd5e18e966" :answer/type :answer.type/math :answer/value "\\frac{1}{43}" :db/ensure [:answer/validate]} {:db/id "q-32706/selection/2341d4beafc19cb7b8396e0b9f21c544ec7f6a786fc846e9361e36afd0b43437" :answer/id #uuid "c8bd0fcf-293a-5ded-9d62-074408f317ee" :answer/type :answer.type/math :answer/value "43" :db/ensure [:answer/validate]} {:db/id "q-32706/selection" :answer-field/id #uuid "14230aa6-9a02-59c3-9fbc-02251676e493" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32706/selection/0a2bcf0b23beaf0b660371dc25fd2ff9b62fc80e085eab676caddb7c03f6120d" :answer-field/choices ["q-32706/selection/cc5dbf87f4dbee91d1c29e8013069443539b3fd684157fee71e97221215a4d5e" "q-32706/selection/0a2bcf0b23beaf0b660371dc25fd2ff9b62fc80e085eab676caddb7c03f6120d" "q-32706/selection/a8dd3023a15736f67ea6d8ea5b4152008e8f88c3ce9ec6730573f2f45df5d928" "q-32706/selection/5c96e860ee66aaeff8bf13df8c52fdb0e38e76da507b4dd012c09a12adf24b38" "q-32706/selection/2341d4beafc19cb7b8396e0b9f21c544ec7f6a786fc846e9361e36afd0b43437"] :db/ensure [:answer-field/validate]} {:db/id "q-32706" :question/id #uuid "96332eb9-d2e1-560a-b367-0be5b28bc2c3" :question/math-academy-id "q-32706" :question/problem "If $x={y}^{5}+3y-5,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(33,2).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{5}+3y-5) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{5})+3\\frac{\\text{d}}{\\text{d}y}(y)-5\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =5{y}^{4}+3(1)+0 \\\\  & =5{y}^{4}+3.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{5{y}^{4}+3}.\n$$\n\nFinally, substituting the point $(33,2),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(33,2)} & =\\frac{1}{5\\cdot {2}^{4}+3}=\\frac{1}{83}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32706/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0"] :knowledge-point/questions ["q-32706"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170188/selection/f68d7dec6477fe3015410662d3d9c623a124e735674700c5ce9d6fe94465e89a" :answer/id #uuid "85062236-047c-5c4d-bddc-e147113063e6" :answer/type :answer.type/math :answer/value "y=\\frac{x}{16}-\\frac{15}{16}" :db/ensure [:answer/validate]} {:db/id "q-170188/selection/264bcfb6daf5d49beebcc695a87c5df036c641f57a69e29e91d37ea141469108" :answer/id #uuid "3ee753f9-fec0-5431-8961-c5b744cc934a" :answer/type :answer.type/math :answer/value "y=16x+31" :db/ensure [:answer/validate]} {:db/id "q-170188/selection/4116b8a827f24de72995796f0da2bd33fc3e2d023f02643addae66a4a2aa14a4" :answer/id #uuid "44d64f00-a6e5-5d07-92db-3a3d2b55d9d7" :answer/type :answer.type/math :answer/value "y=16x-14" :db/ensure [:answer/validate]} {:db/id "q-170188/selection/18db4b822bc51036ae19fe4606a59e1b1743887aaf5ec5d16056698ec3096ac1" :answer/id #uuid "6c6813cf-ff35-56fa-9657-48ddaf31b58a" :answer/type :answer.type/math :answer/value "y=\\frac{x}{16}+\\frac{9}{8}" :db/ensure [:answer/validate]} {:db/id "q-170188/selection/159567db35a108f749b3f9c61b325fe528db0a4db84e371fa80d90fd30f3d896" :answer/id #uuid "21e1ce6a-edc7-5022-8bc0-0a6926848165" :answer/type :answer.type/math :answer/value "y=\\frac{x}{16}-\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "q-170188/selection" :answer-field/id #uuid "07119b15-3e9e-543f-b893-a8c7fb28dbfb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170188/selection/159567db35a108f749b3f9c61b325fe528db0a4db84e371fa80d90fd30f3d896" :answer-field/choices ["q-170188/selection/f68d7dec6477fe3015410662d3d9c623a124e735674700c5ce9d6fe94465e89a" "q-170188/selection/264bcfb6daf5d49beebcc695a87c5df036c641f57a69e29e91d37ea141469108" "q-170188/selection/4116b8a827f24de72995796f0da2bd33fc3e2d023f02643addae66a4a2aa14a4" "q-170188/selection/18db4b822bc51036ae19fe4606a59e1b1743887aaf5ec5d16056698ec3096ac1" "q-170188/selection/159567db35a108f749b3f9c61b325fe528db0a4db84e371fa80d90fd30f3d896"] :db/ensure [:answer-field/validate]} {:db/id "q-170188" :question/id #uuid "efc76f43-44f6-557f-a3e7-3700bed34dc2" :question/math-academy-id "q-170188" :question/problem "Given a curve $x=5{y}^{5}-3{y}^{3},$ what is the equation of the tangent to the curve at the point $(-2,-1)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(5{y}^{5}-3{y}^{3}) \\\\  & =5\\frac{\\text{d}}{\\text{d}y}({y}^{5})-3\\frac{\\text{d}}{\\text{d}y}({y}^{3}) \\\\  & =5\\cdot (5{y}^{4})-3\\cdot (3{y}^{2}) \\\\  & =25{y}^{4}-9{y}^{2}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{25{y}^{4}-9{y}^{2}}.\n$$\n\nThe slope of the tangent to the curve at the point $(-2,-1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-2,-1)} \\\\  & =\\frac{1}{25(-1)^{4}-9(-1)^{2}} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-1) & =\\frac{1}{16}(x-(-2)) \\\\ y+1 & =\\frac{1}{16}(x+2) \\\\ y & =\\frac{x}{16}+\\frac{2}{16}-1 \\\\ y & =\\frac{x}{16}+\\frac{1}{8}-1 \\\\ y & =\\frac{x}{16}-\\frac{7}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170188/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71"] :knowledge-point/questions ["q-170188"] :db/ensure [:knowledge-point/validate]} {:db/id "q-312553/field-1/58714df9d1503773e230eafbb4834023fc1975cc98bff0332dcd26ee63661723" :answer/id #uuid "f7ea7b05-7eba-5553-b109-4cfb84fccd0e" :answer/type :answer.type/math :answer/value "-\\frac{x}{3}+3" :db/ensure [:answer/validate]} {:db/id "q-312553/field-1/c2d57e635eb9e8f62f31d2de5d9c6dd0e1e08fd4da31c212153aebc572a3aac4" :answer/id #uuid "b8edf8dd-fea6-5737-be79-46ac6c949808" :answer/type :answer.type/math :answer/value "-3x+3" :db/ensure [:answer/validate]} {:db/id "q-312553/field-1" :answer-field/id #uuid "233bc82e-fabe-5cf2-aa6d-63ee891eee94" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-312553/field-1/58714df9d1503773e230eafbb4834023fc1975cc98bff0332dcd26ee63661723" :answer-field/choices ["q-312553/field-1/58714df9d1503773e230eafbb4834023fc1975cc98bff0332dcd26ee63661723" "q-312553/field-1/c2d57e635eb9e8f62f31d2de5d9c6dd0e1e08fd4da31c212153aebc572a3aac4"] :db/ensure [:answer-field/validate]} {:db/id "q-312553" :question/id #uuid "2042d891-4311-5637-9472-9d451beb8575" :question/math-academy-id "q-312553" :question/problem "Given a curve $x=3y-{y}^{2},$ what is the equation of the tangent to the curve at the point $(0,3)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(3y-{y}^{2}) \\\\  & =3\\frac{\\text{d}}{\\text{d}y}(y)-\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =3(1)-2y \\\\  & =3-2y.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{3-2y}.\n$$\n\nThe slope of the tangent to the curve at the point $(0,3)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(0,3)} \\\\  & =\\frac{1}{3-2(3)} \\\\  & =\\frac{1}{(-3)} \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =-\\frac{1}{3}\\cdot (x-0) \\\\ y & =-\\frac{1}{3}x+3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-312553/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71"] :knowledge-point/questions ["q-312553"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341634/field-1/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" :answer/id #uuid "fa5e20dd-581a-5af7-bfe2-4337980fa60d" :answer/type :answer.type/math :answer/value "\\frac{1}{13}" :db/ensure [:answer/validate]} {:db/id "q-341634/field-1" :answer-field/id #uuid "e92dc376-c3a9-5050-8b2f-44b8cf618769" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341634/field-1/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af" :answer-field/choices ["q-341634/field-1/3b526d0871203a7fa20c2a891525c650a26e23eb2a93fea36737a1cf4d4423af"] :db/ensure [:answer-field/validate]} {:db/id "q-341634" :question/id #uuid "9a37d544-3657-505d-b449-d7503348dc30" :question/math-academy-id "q-341634" :question/problem "If $x=4{y}^{4}-3y,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(1,1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(1,1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{4}-3y) \\\\  & =4\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =4(4{y}^{3})-3 \\\\  & =16{y}^{3}-3\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{16{y}^{3}-3}.\n$$\n\nFinally, substituting the point $(1,1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(1,1)} & =\\frac{1}{16({1}^{3})-3}=\\frac{1}{13}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341634/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0"] :knowledge-point/questions ["q-341634"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341751/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "081aaff5-3b58-54b8-8a54-70c6cbcf551c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-341751/field-1" :answer-field/id #uuid "fb0d617c-7e28-589a-a8a9-b734b5afb69c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341751/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-341751/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-341751" :question/id #uuid "e940fea3-bcaa-58ab-8420-8e18e250d215" :question/math-academy-id "q-341751" :question/problem "If $x=-\\frac{16}{\\sqrt[3]{y}}+13,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(5,8).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{16}{\\sqrt[3]{y}}+13) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-16{y}^{-1/3}+13) \\\\  & =-16\\frac{\\text{d}}{\\text{d}y}({y}^{-1/3})+\\frac{\\text{d}}{\\text{d}y}(13) \\\\  & =-16(-\\frac{1}{3}{y}^{-4/3})+0 \\\\  & =\\frac{16}{3}{y}^{-4/3} \\\\  & =\\frac{16}{3{(\\sqrt[3]{y})}^{4}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{3{(\\sqrt[3]{y})}^{4}}{16}.\n$$\n\nFinally, substituting the point $(5,8),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,8)} & =\\frac{3{(\\sqrt[3]{8})}^{4}}{16} \\\\  & =\\frac{3(16)}{16} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341751/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0"] :knowledge-point/questions ["q-341751"] :db/ensure [:knowledge-point/validate]}]
