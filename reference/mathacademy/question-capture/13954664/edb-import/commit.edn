31 true] [17592186266674 1000 #edb/ref 17592186266678 13194139533931 true] [17592186266674 1000 #edb/ref 17592186266679 13194139533931 true] [17592186266674 1040 #edb/ref 17592186045450 13194139533931 true] [17592186266674 1041 "selection" 13194139533931 true] [17592186266674 1104 #edb/ref 17592186266676 13194139533931 true] [17592186266674 1110 #uuid "35176d27-409c-527e-afcc-93a5edf3f3c2" 13194139533931 true] [17592186266675 1034 "{x}^{2}=4y" 13194139533931 true] [17592186266675 1103 #edb/ref 17592186045453 13194139533931 true] [17592186266675 1111 #uuid "d4f20d5e-58a8-5139-8dd5-e6df1433c437" 13194139533931 true] [17592186266676 1034 "{y}^{2}=-16x" 13194139533931 true] [17592186266676 1103 #edb/ref 17592186045453 13194139533931 true] [17592186266676 1111 #uuid "32cc0167-455d-558a-9fbc-a2bfaf637780" 13194139533931 true] [17592186266677 1034 "{y}^{2}=-\\frac{1}{16}x" 13194139533931 true] [17592186266677 1103 #edb/ref 17592186045453 13194139533931 true] [17592186266677 1111 #uuid "af22acc3-5ff2-59da-8d01-efaca6071df3" 13194139533931 true] [17592186266678 1034 "{y}^{2}=-4x" 13194139533931 true] [17592186266678 1103 #edb/ref 17592186045453 13194139533931 true] [17592186266678 1111 #uuid "3064d8da-d1e5-5196-8271-d92910221e96" 13194139533931 true] [17592186266679 1034 "{x}^{2}=-\\frac{1}{4}y" 13194139533931 true] [17592186266679 1103 #edb/ref 17592186045453 13194139533931 true] [17592186266679 1111 #uuid "18e279b8-1efe-51bb-b2ea-bfd8540b5761" 13194139533931 true] [17592186266680 1017 #edb/ref 17592186266681 13194139533931 true] [17592186266680 1089 "q-115636" 13194139533931 true] [17592186266680 1091 #edb/ref 17592186045465 13194139533931 true] [17592186266680 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13954664/assets/5742f3f1161782d06b8a785d28d6c59b1e40aec37bd6b62268d6d41e1c662ee0.png)\n\nWhat is the equation of the parabola shown above?" 13194139533931 true] [17592186266680 1113 #uuid "4a6e5633-dfb8-5833-aa29-5b1d91e7af29" 13194139533931 true] [17592186266680 1145 "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(-2,-1)$ and passes through the point $(-4,-4).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-2,-1),$ we substitute $h=-2$ and $k=-1$ into the equation above and get\n\n$$\n\\begin{aligned}(y+1)^{2} & =4p(x+2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(-4,-4),$ so we can substitute $x=-4$ and $y=-4$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y+1)^{2} & =4p(x+2) \\\\ (-4+1)^{2} & =4p(-4+2) \\\\ 9 & =-8p \\\\ p & =-\\frac{9}{8}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y+1)^{2} & =4p(x+2) \\\\ (y+1)^{2} & =4(-\\frac{9}{8})(x+2) \\\\ (y+1)^{2} & =-\\frac{9}{2}(x+2).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the left since $p=-\\frac{9}{8}$ is negative." 13194139533931 true] [17592186266681 1000 #edb/ref 17592186266682 13194139533931 true] [17592186266681 1000 #edb/ref 17592186266683 13194139533931 true] [17592186266681 1000 #edb/ref 17592186266684 13194139533931 true] [17592186266681 1000 #edb/ref 17592186266685 13194139533931 true] [17592186266681 1000 #edb/ref 17592186266686 13194139533931 true] [17592186266681 1040 #edb/ref 17592186045450 13194139533931 true] [17592186266681 1041 "selection" 13194139533931 true] [17592186266681 1104 #edb/ref 17592186266682 13194139533931 true] [17592186266681 1110 #uuid "56e190e5-5c3d-57f2-84d5-74194fc76dd0" 13194139533931 true] [17592186266682 1034 "(y+1)^{2}=-\\frac{9}{2}(x+2)" 13194139533931 true] [17592186266682 1103 #edb/ref 17592186045453 13194139533931 true] [17592186266682 1111 #uuid "08b73b54-8b69-5a59-896f-d8073bfad50c" 13194139533931 true] [17592186266683