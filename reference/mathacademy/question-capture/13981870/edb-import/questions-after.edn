#{[{:db/id #edb/ref 17592186282674 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e126b20-0507-5f22-ba34-a55157ca7fa1" :knowledge-point/title "Solving a Trigonometric Equation When the Cotangent Function Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f6ffdfa-f8d5-5191-80b1-e101f7e36314" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,300" :db/id #edb/ref 17592186282676} {:answer/id #uuid "95fad9b7-23d8-597b-9738-7b546b777c57" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,200" :db/id #edb/ref 17592186282677} {:answer/id #uuid "67846b5d-c609-50dc-9bca-2d657876d202" :answer/type {:db/ident :answer.type/math} :answer/value "37\\,800" :db/id #edb/ref 17592186282678} {:answer/id #uuid "cd48009c-ccfe-52a1-8bd2-2af1b51fc429" :answer/type {:db/ident :answer.type/math} :answer/value "27\\,000" :db/id #edb/ref 17592186282679} {:answer/id #uuid "ea120bf4-0df9-5da9-9be8-0e2dcce6b7ea" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,900" :db/id #edb/ref 17592186282680}] :answer-field/correct {:answer/id #uuid "3f6ffdfa-f8d5-5191-80b1-e101f7e36314" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,300" :db/id #edb/ref 17592186282676} :answer-field/id #uuid "56dde13a-0670-549d-b0b5-63bfaa05e94b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282675}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1e429c53-db66-50b4-900e-8aac7266bdd4" :question/math-academy-id "q-120646" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $7-\\sqrt{2}\\operatorname{cot}⁡x=3\\sqrt{2}\\operatorname{cot}⁡x+7$ for ${0}^{∘}<x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}7-\\sqrt{2}\\operatorname{cot}⁡x & =3\\sqrt{2}\\operatorname{cot}⁡x+7 \\\\ -4\\sqrt{2}\\operatorname{cot}⁡x & =0 \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & ={90}^{∘}\\end{aligned}\n$$\n\nSince this value lies inside the desired domain, our first solution is ${x}_{1}={90}^{∘}.$\n\nTo find more solutions, we add integer multiples of ${180}^{∘}$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}+{180}^{∘} \\\\  & ={90}^{∘}+{180}^{∘} \\\\  & ={270}^{∘}\\end{aligned}\n$$\n\nSo, our solutions are $x={90}^{∘},{270}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n90\\cdot 270=24\\,300.\n$$"}] [{:db/id #edb/ref 17592186115634 :knowledge-point/_questions [{:knowledge-point/id #uuid "74c9c0f6-034c-5d9c-935a-ca27dec1a648" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a173f0fe-5943-5028-a49c-6f244026a055" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π^{2}}{3}" :db/id #edb/ref 17592186113205} {:answer/id #uuid "a6cd96a4-3867-5c39-af22-be858ba5cde6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7π^{2}}{36}" :db/id #edb/ref 17592186113206} {:answer/id #uuid "e665ee40-7bac-58af-b316-344f56da0e52" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{11π^{2}}{36}" :db/id #edb/ref 17592186113207} {:answer/id #uuid "2499641e-c1d4-5e1b-889a-d98418a63338" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5π^{2}}{36}" :db/id #edb/ref 17592186113208} {:answer/id #uuid "6795acd7-656b-52db-8fb3-1f8f1bfa71d3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π^{2}}{12}" :db/id #edb/ref 17592186113209}] :answer-field/correct {:answer/id #uuid "2499641e-c1d4-5e1b-889a-d98418a63338" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5π^{2}}{36}" :db/id #edb/ref 17592186113208} :answer-field/id #uuid "2ab437f9-9b44-5d64-85f2-caaab6636ffa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113204}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "92bbda32-2fa5-5f1c-a9f9-c398f0ee3f0b" :question/math-academy-id "q-29637" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=\\sqrt{3}$ for $-\\pi <x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{\\sqrt{3}}=\\frac{\\sqrt{3}}{3}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nTo generate more solutions, we add or subtract integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-\\pi =\\frac{\\pi }{6}-\\pi =-\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-\\frac{5\\pi }{6},\\frac{\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot (-\\frac{5\\pi }{6})=-\\frac{5{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186282681 :knowledge-point/_questions [{:knowledge-point/id #uuid "74c9c0f6-034c-5d9c-935a-ca27dec1a648" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268946e7-5527-5a92-a28e-53fdc72568b9" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186282683} {:answer/id #uuid "7a5de78d-8204-59b0-97b6-53f125f809c1" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,731" :db/id #edb/ref 17592186282684} {:answer/id #uuid "7738e148-e6ef-532b-a769-a0c953fd2cdd" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,631" :db/id #edb/ref 17592186282685} {:answer/id #uuid "0c9e7c40-836a-5dad-81aa-97c4e3cb76f8" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,851" :db/id #edb/ref 17592186282686} {:answer/id #uuid "67c8944a-bc97-5cd9-8b49-1007571d465e" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,561" :db/id #edb/ref 17592186282687}] :answer-field/correct {:answer/id #uuid "268946e7-5527-5a92-a28e-53fdc72568b9" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186282683} :answer-field/id #uuid "2de1b9ec-2ce3-5f43-aef0-d2d472c22c7d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282682}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0fa4866c-44a3-53be-9ea4-1b3c073da31b" :question/math-academy-id "q-29664" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=-\\frac{3}{4}$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=-\\frac{4}{3}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{4}{3})=(-53.130\\,1…)^{∘}≈-{53.130}^{∘}\\end{aligned}\n$$\n\nSince $-{53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}=-{53.130}^{∘}.$\n\nTo generate more solutions, we add and subtract integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+x={180}^{∘}-{53.130}^{∘}={126.870}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-{53.130}^{∘},{126.870}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n-53.130\\cdot 126.870≈-6\\,741\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186282688 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e126b20-0507-5f22-ba34-a55157ca7fa1" :knowledge-point/title "Solving a Trigonometric Equation When the Cotangent Function Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a33c542-bcce-5088-aa86-76ed383a760b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186282690}] :answer-field/correct {:answer/id #uuid "3a33c542-bcce-5088-aa86-76ed383a760b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186282690} :answer-field/id #uuid "94902314-a3df-52b9-8de1-513711ccceec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186282689} {:answer-field/choices [{:answer/id #uuid "9373aa94-e594-5875-840b-af112ff604a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186282692}] :answer-field/correct {:answer/id #uuid "9373aa94-e594-5875-840b-af112ff604a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186282692} :answer-field/id #uuid "d65bd88b-96d1-5564-b9d4-1fd3cb386455" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186282691}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f29a6dbd-b262-5fdc-930e-f2d2316607f9" :question/math-academy-id "q-330708" :question/problem "Find the two solutions to the equation $\\sqrt{8-2\\operatorname{cot}⁡x}=\\sqrt{8}$ for $0<x<2\\pi .$\n\n**In ascending order,** the solutions are $x=$ \n{{field-1}}\nand $x=$ \n{{field-2}}." :question/worked-solution "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}\\sqrt{8-2\\operatorname{cot}⁡x} & =\\sqrt{8} \\\\ 8-2\\operatorname{cot}⁡x & =8 \\\\ -2\\operatorname{cot}⁡x & =0 \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & =\\frac{\\pi }{2}\\end{aligned}\n$$\n\nSince this value lies inside the desired domain, our first solution is ${x}_{1}=\\frac{\\pi }{2}.$\n\nTo find more solutions, we add integer multiples of $\\pi $ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}+\\pi  \\\\  & =\\frac{\\pi }{2}+\\pi  \\\\  & =\\frac{3\\pi }{2}\\end{aligned}\n$$\n\nTherefore, in ascending order, our solutions are $x=\\frac{\\pi }{2}$ and $x=\\frac{3\\pi }{2}.$"}] [{:db/id #edb/ref 17592186282693 :knowledge-point/_questions [{:knowledge-point/id #uuid "c71c49ee-e496-5d4e-87fa-96e28dd830ca" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d35d45-42ed-52cb-bd79-633b935f1cb5" :answer/type {:db/ident :answer.type/math} :answer/value "5.8" :db/id #edb/ref 17592186282695} {:answer/id #uuid "9fdaf85f-52f4-5772-b936-fa11de57bf3a" :answer/type {:db/ident :answer.type/math} :answer/value "5.9" :db/id #edb/ref 17592186282696} {:answer/id #uuid "5952884d-c0bc-5192-91c3-3262c4e76705" :answer/type {:db/ident :answer.type/math} :answer/value "6.2" :db/id #edb/ref 17592186282697} {:answer/id #uuid "4493d027-4c78-5dc8-a9f9-908208ae85a2" :answer/type {:db/ident :answer.type/math} :answer/value "6.8" :db/id #edb/ref 17592186282698} {:answer/id #uuid "f501b76f-6542-541e-b055-b326f9fb0f32" :answer/type {:db/ident :answer.type/math} :answer/value "6.4" :db/id #edb/ref 17592186282699}] :answer-field/correct {:answer/id #uuid "5952884d-c0bc-5192-91c3-3262c4e76705" :answer/type {:db/ident :answer.type/math} :answer/value "6.2" :db/id #edb/ref 17592186282697} :answer-field/id #uuid "9b576ac6-7d2d-5d8b-a5e0-a730d875bb02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282694}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5ccb0e75-04a0-58e0-9f38-1667d6f95491" :question/math-academy-id "q-76930" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation  $\\operatorname{cot}⁡x=\\frac{1}{5}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=5\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(5)=1.373\\,400…≈1.373\\,4\\end{aligned}\n$$\n\nSince $1.373\\,4$ lies inside the given domain, our first solution is ${x}_{1}=1.373\\,4.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=\\pi +{x}_{1}=\\pi +1.373\\,4=4.515\\,0.\\end{aligned}\n$$\n\nFinally, the value of ${x}_{1}\\cdot {x}_{2}$ is\n\n$$\n1.373\\,4\\cdot 4.515\\,0≈6.2\n$$\n\nrounded to one decimal place."}]}
