ection/64e2352d08c798ae4b0ab437382bec27b9d0e08a429ec4448bedbf9ea20b1870"] :db/ensure [:answer-field/validate]} {:db/id "q-75732" :question/id #uuid "5039e046-3a2d-50c1-a153-91577d91bce5" :question/math-academy-id "q-75732" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/312c7d003e2d856e55b3b5700402aa86b53e43dcd8f8650b4e04476b8be9b585.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $C$ corresponding to the eigenvalue $-2.$ Find the vector $Cv.$" :question/worked-solution "The eigenvector $v=[\\begin{aligned}0 \\\\ -2\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =-2.$ So, \n\n$$\n\\begin{aligned}Cv & =-2v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/1ef0448df9f0a37289e9792ce62e6c92203aeb4333f2b25f21c608b5253cf1fe.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75732/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975"] :knowledge-point/questions ["q-75732"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106892/selection/b19e95d3977192591050bfb4f50daa4d53d5e44ef6b6af67fdb84a71f3565735" :answer/id #uuid "8b146ea0-b85d-5a62-bc28-7aa8570e314f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/234cbbc4a4179a09e4bf56f1c428b2d0135961d381f800bb0c87787c444a1291.png" :db/ensure [:answer/validate]} {:db/id "q-106892/selection/a098d2d4fdbd854d6b2d475f6e433f00ee163710dd985e88805a60429fb19374" :answer/id #uuid "b0c2a2d7-46ee-57da-bdd0-acaafe70b70b" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/2e9b0004ae889fb63f5ae65bd2a79915b6e195935fd3b610d2f9957d10f6a9e7.png" :db/ensure [:answer/validate]} {:d