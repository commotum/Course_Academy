ed260c8d59" :question/math-academy-id "q-75586" :question/problem "Determine if $v=[\\begin{aligned}-5 \\\\ 1\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}-2 & 5 \\\\ 1 & 2\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}-2 & 5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}-5 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}15 \\\\ -3\\end{aligned}] \\\\  & =(-3)\\cdot [\\begin{aligned}-5 \\\\ 1\\end{aligned}] \\\\  & =-3v.\\end{aligned}\n$$\n\nSince $Av=-3v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75586/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08"] :knowledge-point/questions ["q-75586"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106775/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "0aeb963b-fbfa-56f5-89f9-e052c82bed07" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-106775/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "b2a446d5-95ea-5fde-84d1-ee7b75b562c5" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-106775/selection/6941cff48cebd9e4c9822110bc53fcdb7790ba04f618b331a0a8be09ff036b06" :answer/id #uuid "4b15870c-a2de-50b5-8309-f8086e971e65" :answer/type :answer.type/text :answer/value "$v$ is not an eigenvector of $A$" :db/ensure [:answer/validate]} {:db/id "q-106775/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "90bcdddc-cfaf-56fd-ba01-40fdf4797d42" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-106775/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "6a124d98-9f14-5eeb-9563-c3b4fae1d486" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-106775/selection" :answer-field/id #uuid "12f19e8f-2221-5360-bf0d-5edb74f3630d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106775/selection/6941cff48cebd9e4c9822110bc53fcdb7790ba04f618b331a0a8be09ff036b06" :answer-field/choices ["q-106775/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-106775/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-106775/selection/6941cff48cebd9e4c9822110bc53fcdb7790ba04f618b331a0a8be09ff036b06" "q-106775/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-106775/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-106775" :question/id #uuid "56a4f3a9-ccca-53d2-8026-09ec5330fdbb" :question/math-academy-id "q-106775" :question/problem "Determine if $v=[\\begin{aligned}2 \\\\ -4\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}6 & -1 \\\\ 2 & 3\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}6 & -1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ -8\\end{aligned}].\\end{aligned}\n$$\n\nIf $v$ is an eigenvector, then there must exist a real number $\\lambda $ such that $Av=\\lambda v.$ Hence, we have\n\n$$\n[\\begin{aligned}16 \\\\ -8\\end{aligned}]=\\lambda [\\begin{aligned}2 \\\\ -4\\end{aligned}].\n$$\n\nThis leads to the following system of equations for $\\lambda :$\n\n$$\n{\\begin{aligned}16=2\\lambda  \\\\ -8=-4\\lambda \\end{aligned}\n$$\n\nThis system has no solution. Therefore, $v$ is not an eigenvector of $A.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106775/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08"] :knowledge-point/questions ["q-106775"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37002/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "d07a8973-1325-5cc9-96be-53c772e1ba3b" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-37002/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "421cff60-88e4-54a5-8e26-c845f901e98e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-37002/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "4e2770a6-a9fd-57fd-a31f-088f75becc54" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-37002/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "0f6dcc37-3dce-50b8-8041-d5cc727515de" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-37002/selection/6941cff48cebd9e4c9822110bc53fcdb7790ba04f618b331a0a8be09ff036b06" :answer/id #uuid "7f140d17-0fc9-543e-8d35-74200daca3bd" :answer/type :answer.type/text :answer/value "$v$ is not an eigenvector of $A$" :db/ensure [:answer/validate]} {:db/id "q-37002/selection" :answer-field/id #uuid "09f5a223-b491-583b-ae08-4bc16adfc9f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37002/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-37002/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-37002/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-37002/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-37002/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-37002/selection/6941cff48cebd9e4c9822110bc53fcdb7790ba04f618b331a0a8be09ff036b06"] :db/ensure [:answer-field/validate]} {:db/id "q-37002" :question/id #uuid "8eb8915f-3db7-519d-9128-90a250479d02" :question/math-academy-id "q-37002" :question/problem "Determine if $v=[\\begin{aligned}-4 \\\\ 3\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}-5 & 0 \\\\ 3 & -1\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}-5 & 0 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}-4 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}20 \\\\ -15\\end{aligned}] \\\\  & =(-5)\\cdot [\\begin{aligned}-4 \\\\ 3\\end{aligned}] \\\\  & =-5v.\\end{aligned}\n$$\n\nSince $Av=-5v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-37002/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08"] :knowledge-point/questions ["q-37002"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75732/selection/c8b8ebcb72958b3513a239831e97d2864f12f2078bb582d9dfa0b1633693ebc2" :answer/id #uuid "658eb9c4-64cd-5528-b060-9ed62b9d2510" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/65ced0345d7acdf2dd3ed6320202f6c59b7cc65d2ca49209938821a97c021165.png" :db/ensure [:answer/validate]} {:db/id "q-75732/selection/58c5371f30ec140e16eece5b35765255552e36209eb8f53f4a0d6ca8cbc67f3d" :answer/id #uuid "313585df-bfde-5869-9925-1f7e510631a2" :answer/type :answer.type/image :answer/value "/h