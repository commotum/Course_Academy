d06" :question/math-academy-id "q-106892" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/1670f48c1bd70b2c5ddee70c4a9c893edf5e844febd7128b1ddf7773aef0f73f.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $C$ corresponding to the eigenvalue $-1.$ Find the vector $Cv.$" :question/worked-solution "The eigenvector $v=[\\begin{aligned}2 \\\\ -2\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =-1.$ So, \n\n$$\n\\begin{aligned}Cv & =-1v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/2e9b0004ae889fb63f5ae65bd2a79915b6e195935fd3b610d2f9957d10f6a9e7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106892/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975"] :knowledge-point/questions ["q-106892"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-75735"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/61ed37aa6a5e67cdc60cca2c93969a47d12e1e36f18edf96f646922877641e79.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\frac{1}{2}.$ Find the vector $Au.$" :question/worked-solution "The eigenvector $u=[\\begin{aligned}2 \\\\ 0\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =\\frac{1}{2}.$ So, \n\n$$\n\\begin{aligned}Au & =\\frac{1}{2}u.\\end{aligned}\n$$\n\nThus, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/c272ff1454ac4ab9825e312f563c9bca08ac2800faa0e95ab45e8a5e827369da.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-37091"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/190af2ef92a8c23efb6fc15c6effebf5db929d8d133da6809bd27f77a6e9292b.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $-1.$ Find the vector $Av.$" :question/worked-solution "The eigenvector $v=[\\begin{aligned}0 \\\\ 2\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =-1.$ So, \n\n$$\n\\begin{aligned}Av & =-1v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/1f778e38d2dd4d2e33675bfa45bbe13c9596b1818092ef6129e8f35b1741157e.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-106890/selection/45a58ad2838dfbd2f93caa308b87815b50ba67a8b955e4c96e12285fc462446a" :answer/id #uuid "449b6556-2c76-5e8a-9fec-c0a79a7dcb69" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/addd53cc78d53e0bb3ee5f5d51128afef8723186516db3aa092dcb97086d616f.png" :db/ensure [:answer/validate]} {:db/id "q-106890/selection/25255a58124e91c4461327a9fa8286b6d46db749b7ad48482b3e333f5d4b4bf5" :answer/id #uuid "dc4c69f1-cb9a-5bcc-be03-c2be1f367115" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/441a9f0ee158ae2ebdddb223463887ca9f2d5e84a6fc925c80b0aa9ccf4bc65c.png" :db/ensure [:answer/validate]} {:db/id "q-106890/selection/e0e3817ecceb0f56af5a8a7f9a7e58d12d85bc50cef8df3311e26f2fe495a37e" :answer/id #uuid "0a23d2d5-4039-556e-8103-c5bba1eb25e6" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/eb014dbb24f2f087c558d40d2ddb198f225c1ad50a66e6cf5daaaef7eec33021.png" :db/ensure [:answer/validate]} {:db/id "q-106890/selection/928b53d1d74de765fa01a4f512b74ff36b8cd8fc5257fc6b7ac94d29c41e785d" :answer/id #uuid "2b2f40e5-cf55-5b08-86