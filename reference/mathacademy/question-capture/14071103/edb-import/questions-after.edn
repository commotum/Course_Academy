capture/14071103/assets/1670f48c1bd70b2c5ddee70c4a9c893edf5e844febd7128b1ddf7773aef0f73f.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $C$ corresponding to the eigenvalue $-1.$ Find the vector $Cv.$" :question/worked-solution "The eigenvector $v=[\\begin{aligned}2 \\\\ -2\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =-1.$ So, \n\n$$\n\\begin{aligned}Cv & =-1v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/2e9b0004ae889fb63f5ae65bd2a79915b6e195935fd3b610d2f9957d10f6a9e7.png)"}] [{:db/id #edb/ref 17592186371202 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a1cf072-f5b2-5678-9872-81e48397fd3c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186371204} {:answer/id #uuid "9df924aa-9f87-522a-9655-5f3f3e055ed0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371205} {:answer/id #uuid "87cf909f-12d3-5fc0-b634-fafe0460db32" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371206} {:answer/id #uuid "0e8ff9be-1c48-5726-aaaa-4af5ed8d9270" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186371207} {:answer/id #uuid "4181df71-f3a3-5c22-b1a3-914f4af3f8bf" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186371208}] :answer-field/correct {:answer/id #uuid "9df924aa-9f87-522a-9655-5f3f3e055ed0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371205} :answer-field/id #uuid "bb60fbee-6593-5091-928c-930fcf23a5f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371203}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4a90b8ce-e812-571d-b6d3-16961f18158d" :question/math-academy-id "q-106902" :question/problem "The eigenvector of $A=[\\begin{aligned}k & -1 \\\\ 2 & 2k\\end{aligned}]$ corresponding to the eigenvalue $\\lambda =k+2$ is  $[\\begin{aligned}-1 \\\\ k-1\\end{aligned}].$ Determine the value of $k.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}k & -1 \\\\ 2 & 2k\\end{aligned}][\\begin{aligned}-1 \\\\ k-1\\end{aligned}] & =(k+2)[\\begin{aligned}-1 \\\\ k-1\\end{aligned}] \\\\ [\\begin{aligned}-2k+1 \\\\ -2+2{k}^{2}-2k\\end{aligned}] & =[\\begin{aligned}-k-2 \\\\ {k}^{2}+k-2\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n{\\begin{aligned}-2k+1=-k-2, \\\\ -2+2{k}^{2}-2k={k}^{2}+k-2\\end{aligned}\n$$\n\nSolving for $k$ in the first equation, we get\n\n$$\n-k=-3\\,⟹\\,k=3.\n$$\n\nNow, substituting $k=3$ into the second equation, we get\n\n$$\n\\begin{aligned}-2+2{k}^{2}-2k & ={k}^{2}+k-2 \\\\ -2+2\\cdot (3)^{2}-2\\cdot 3 & =(3)^{2}+3-2 \\\\ 10 & =10,\\end{aligned}\n$$\n\nwhich is a true statement.\n\nTherefore, the solution of the system is $k=3.$"}] [{:db/id #edb/ref 17592186371209 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebea0d86-1323-5fe5-8869-3a11a6d61a40" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186371211} {:answer/id #uuid "b87db648-1d01-51d2-adb6-b325ed28cbb9" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186371212} {:answer/id #uuid "9b1ced1c-2e75-52c2-919e-c17afd3a8559" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186371213} {:answer/id #uuid "a061c4ae-2b3b-5920-a222-a2cedffb9155" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186371214} {:answer/id #uuid "4b73500b-bfeb-5121-83dc-2bacc3649339" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186371215}] :answer-field/correct {:answer/id #uuid "9b1ced1c-2e75-52c2-919e-c17afd3a8559" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186371213} :answer-field/id #uuid "1ad6613d-e948-568a-b7f5-0eabe299c80e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371210}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "72278b28-d35d-5d52-918b-adacb550b39d" :question/math-academy-id "q-106945" :question/problem "An eigenvector of $A=[\\begin{aligned}4 & 9 \\\\ 2 & -3\\end{aligned}]$ corresponding to an eigenvalue $\\lambda =6$ is  $[\\begin{aligned}c+32 \\\\ 12\\end{aligned}].$ Determine the value of $c.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}4 & 9 \\\\ 2 & -3\\end{aligned}][\\begin{aligned}c+32 \\\\ 12\\end{aligned}] & =6[\\begin{aligned}c+32 \\\\ 12\\end{aligned}] \\\\ [\\begin{aligned}4c+236 \\\\ 2c+28\\end{aligned}] & =[\\begin{aligned}6c+192 \\\\ 72\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n{\\begin{aligned}4c+236=6c+192 \\\\ 2c+28=72\\end{aligned}\n$$\n\n- Solving for $c$ in the second equation, we get\n\n$$\n2c+28=72\\,⟹\\,c=22.\n$$\n\n- Solving for $c$ in the first equation, we get\n\n$$\n4c+236=6c+192\\,⟹\\,c=22.\n$$\n\nTherefore, the solution of the system is $c=22.$"}] [{:db/id #edb/ref 17592186371216 :knowledge-point/_questions [{:knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dec01ba0-aeec-5fcb-beae-7176e0184b80" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186371218} {:answer/id #uuid "d8423897-772a-5ab5-a0b6-f859ce44de59" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186371219} {:answer/id #uuid "4f5fa2bf-f429-5b6a-9c23-83970c257a40" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186371220} {:answer/id #uuid "2cee80e0-95a5-5db9-ad0a-e0bb7c198b70" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186371221} {:answer/id #uuid "e4a5a49c-1d87-5a55-b8a5-ab4db05c8306" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186371222}] :answer-field/correct {:answer/id #uuid "d8423897-772a-5ab5-a0b6-f859ce44de59" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186371219} :answer-field/id #uuid "b4843aca-9f17-515a-989d-db53723de0df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371217}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "43d63a39-99ac-5de8-969c-b2b73de1a528" :question/math-academy-id "q-107314" :question/problem "Which of the following statements are true?\n\n- If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =\\frac{1}{7}$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =7.$\n- An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =-1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to $\\lambda =1.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =\\frac{1}{2},$ then $-v$ is also an eigenvector of $A$ corresponding to $\\lambda =\\frac{1}{2}.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is true. By the definition of an eigenvector, we have \n\n$$\nAv=\\frac{1}{7}v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=\\frac{1}{7}{A}^{-1}v.\n$$\n\nMultiplying both sides by $7$, we get \n\n$$\n{A}^{-1}v=7v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $7.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is false. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =-1$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{-1}=-1.$\n\n- Statement III is true. We have\n\n$$\n\\begin{aligned}A(-v)=-Av=-(\\frac{1}{2}v)=\\frac{1}{2}(-v).\\end{aligned}\n$$\n\nSince, $A(-v)=\\frac{1}{2}(-v),$ and $-v\\ne 0,$ this implies that $-v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =\\frac{1}{2}.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186333586 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a18a2a3-5973-5132-8c42-b2a21fc869ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186333588} {:answer/id #uuid "5406d636-6ca2-505d-a7cf-d3fc9dcae63c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333589} {:answer/id #uuid "4714ba84-bb14-5b18-a5f9-f0fb0ec8743f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186333590} {:answer/id #uuid "2ee5723e-a201-50d2-a717-0ecc63e3f9ff" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333591} {:answer/id #uuid "3e5c6f6b-daec-5dda-adb1-f2ce1f8742c1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186333592}] :answer-field/correct {:answer/id #uuid "5406d636-6ca2-505d-a7cf-d3fc9dcae63c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333589} :answer-field/id #uuid "5a658887-26f5-54db-bfce-82ec8034d797" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333587}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "394982ad-ea62-5428-8f14-995c0f4069c3" :question/math-academy-id "q-107837" :question/problem "An eigenvector of $A=[\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}]$ corresponding to the eigenvalue $\\lambda =7$ is  $v=[\\begin{aligned}c+1 \\\\ c\\end{aligned}].$ Determine the value of $c.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}11 & -6 \\\\ -12 & 25\\end{aligned}][\\begin{aligned}c+1 \\\\ c\\end{aligned}] & =7[\\begin{aligned}c+1 \\\\ c\\end{aligned}] \\\\ [\\begin{aligned}5c+11 \\\\ 13c-12\\end{aligned}] & =[\\begin{aligned}7c+7 \\\\ 7c\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n{\\begin{aligned}5c+11=7c+7 \\\\ 13c-12=7c\\end{aligned}\n$$\n\n- Solving for $c$ in the first equation, we get\n\n$$\n5c+11=7c+7\\,⟹\\,c=2.\n$$\n\n- Solving for $c$ in the second equation, we get\n\n$$\n13c-12=7c\\,⟹\\,c=2.\n$$\n\nTherefore, the solution of the system is $c=2.$"}] [{:db/id #edb/ref 17592186371223 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "664946aa-cb50-5385-b252-05759f631373" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371225} {:answer/id #uuid "0fbb919a-74de-5e76-a351-93a9af2a2c75" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186371226} {:answer/id #uuid "24f55770-03f9-5dcf-aefd-1ce53ffa437d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186371227} {:answer/id #uuid "3821c5d3-7e4f-5757-9b80-a411995b54ec" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186371228} {:answer/id #uuid "9032fa7a-07e5-5773-8f28-b6e3b6a3c228" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186371229}] :answer-field/correct {:answer/id #uuid "664946aa-cb50-5385-b252-05759f631373" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371225} :answer-field/id #uuid "18b3c739-5ae2-5776-9cf2-6747ea639499" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371224}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6c8c1613-f0c1-51af-80b3-8266221c5212" :question/math-academy-id "q-107842" :question/problem "The eigenvector of $A=[\\begin{aligned}1 & -8+k \\\\ 3 & 5k\\end{aligned}]$ corresponding to the eigenvalue $\\lambda =2k$ is  $[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ Determine the value of $k.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}1 & -8+k \\\\ 3 & 5k\\end{aligned}][\\begin{aligned}-2 \\\\ 1\\end{aligned}] & =2k[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}k-10 \\\\ -6+5k\\end{aligned}] & =[\\begin{aligned}-4k \\\\ 2k\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n{\\begin{aligned}k-10=-4k, \\\\ -6+5k=2k\\end{aligned}\n$$\n\nSolving for $k$ in the first equation, we get\n\n$$\nk-10=-4k\\,⟹\\,k=2.\n$$\n\nNow, substituting $k=2$ into the second equation, we get\n\n$$\n\\begin{aligned}-6+5k & =2k \\\\ -6+5(2) & =2(2) \\\\ 4 & =4,\\end{aligned}\n$$\n\nwhich is a true statement.\n\nTherefore, the solution of the system is $k=2.$"}] [{:db/id #edb/ref 17592186371230 :knowledge-point/_questions [{:knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae9baf22-6b0f-5a88-848f-e8fb9c700e1a" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186371232} {:answer/id #uuid "016fd12e-792a-527b-9b0d-edbc565722ef" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186371233} {:answer/id #uuid "93eb26c5-0b3d-5382-899e-93963acebaa2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186371234} {:answer/id #uuid "f766fc58-1564-5cea-adf0-0cb51669a64d" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186371235} {:answer/id #uuid "ea35c061-fa8f-516c-83c2-fd5cfffffec9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186371236}] :answer-field/correct {:answer/id #uuid "ea35c061-fa8f-516c-83c2-fd5cfffffec9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186371236} :answer-field/id #uuid "fd2bf80e-f9fd-5288-89f6-16356c5fb6fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371231}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d6270985-6d2a-5318-afb3-6b0266d6b180" :question/math-academy-id "q-108044" :question/problem "Which of the following statements are true?\n\n- $v=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}-1 & -2 \\\\ 3 & 4\\end{aligned}]$ that corresponds to the eigenvalue $\\lambda =-1.$\n- $v=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}1 & 4 \\\\ 3 & 0\\end{aligned}]$ that corresponds to the eigenvalue $\\lambda =-3.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-2,$ then $3v$ is an eigenvector of $A$ corresponding to $\\lambda =-6.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is false. We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}-1 & -2 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =1\\cdot [\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =1v.\\end{aligned}\n$$\n\n \nSince $Av=v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =1$ (but not $-1$).\n\n- Statement II is true. We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}1 & 4 \\\\ 3 & 0\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -3\\end{aligned}] \\\\  & =-3\\cdot [\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =-3v.\\end{aligned}\n$$\n\n \nSince $Av=-3v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$\n\n- Statement III is false. We have\n\n$$\n\\begin{aligned}A(3v)=3Av=3(-2v)=-2(3v).\\end{aligned}\n$$\n\nSince, $A(3v)=-2(3v),$ and $3v\\ne 0,$ this implies that $3v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-2$ (but not $-6$).\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186333600 :knowledge-point/_questions [{:knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaca6a4e-aefd-574a-8afb-a476135d2895" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333602} {:answer/id #uuid "3f7c324b-ec86-5589-a079-7af025d55328" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186333603} {:answer/id #uuid "3bfaaa5e-dc74-5742-95e5-436b2715d23b" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186333604} {:answer/id #uuid "1b23df11-6b55-5c47-8402-d911a1800e82" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186333605} {:answer/id #uuid "c5317a8b-5c94-5072-9b2e-8d4bfda5b32c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186333606}] :answer-field/correct {:answer/id #uuid "aaca6a4e-aefd-574a-8afb-a476135d2895" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333602} :answer-field/id #uuid "f255a0b3-0887-5cad-ba83-f26df3e05d72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333601}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6af12d90-4cfe-54e1-b057-a8d41286b545" :question/math-academy-id "q-36678" :question/problem "Which of the following statements are true?\n\n- $v=[\\begin{aligned}1 \\\\ -2\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}]$ that corresponds to the eigenvalue $2.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $-v$ is an eigenvector of $A$ corresponding to $\\lambda =-2.$\n- $v=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]$ that corresponds to the eigenvalue $0.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is true. We have \n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =2[\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =2v.\\end{aligned}\n$$\n\nSince $Av=2v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n- Statement II is false. We have\n\n$$\n\\begin{aligned}A(-v)=-Av=-(2v)=2(-v).\\end{aligned}\n$$\n\nSince, $A(-v)=2(-v),$ and $-v\\ne 0,$ this implies that $-v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2$ (but not $-2$).\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement III is true. We have \n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =0[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =0v.\\end{aligned}\n$$\n\nSince $Av=0v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =0.$\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186371237 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08" :knowledge-point/title "Finding the Eigenvalue that Corresponds to a Given Eigenvector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e2770a6-a9fd-57fd-a31f-088f75becc54" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186371239} {:answer/id #uuid "d07a8973-1325-5cc9-96be-53c772e1ba3b" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186371240} {:answer/id #uuid "7f140d17-0fc9-543e-8d35-74200daca3bd" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ is not an eigenvector of $A$" :db/id #edb/ref 17592186371241} {:answer/id #uuid "0f6dcc37-3dce-50b8-8041-d5cc727515de" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186371242} {:answer/id #uuid "421cff60-88e4-54a5-8e26-c845f901e98e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186371243}] :answer-field/correct {:answer/id #uuid "4e2770a6-a9fd-57fd-a31f-088f75becc54" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186371239} :answer-field/id #uuid "09f5a223-b491-583b-ae08-4bc16adfc9f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371238}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8eb8915f-3db7-519d-9128-90a250479d02" :question/math-academy-id "q-37002" :question/problem "Determine if $v=[\\begin{aligned}-4 \\\\ 3\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}-5 & 0 \\\\ 3 & -1\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}-5 & 0 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}-4 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}20 \\\\ -15\\end{aligned}] \\\\  & =(-5)\\cdot [\\begin{aligned}-4 \\\\ 3\\end{aligned}] \\\\  & =-5v.\\end{aligned}\n$$\n\nSince $Av=-5v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-5.$"}] [{:db/id #edb/ref 17592186106228 :knowledge-point/_questions [{:knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87dbd662-bccf-50df-90c4-bcb224519fb5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1375/Source/Images/q-37091-a-2.png" :db/id #edb/ref 17592186103878} {:answer/id #uuid "a0d82049-c8b6-50d0-8edf-809c5c771fe2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1375/Source/Images/q-37091-a-5.png" :db/id #edb/ref 17592186103879} {:answer/id #uuid "e1e2a5ab-9fb2-5fa5-a536-fd1b84248079" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1375/Source/Images/q-37091-a-3.png" :db/id #edb/ref 17592186103880} {:answer/id #uuid "39768105-9da2-51ff-a007-1e02e98cf817" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1375/Source/Images/q-37091-a-4.png" :db/id #edb/ref 17592186103881} {:answer/id #uuid "7ac01776-30bb-5f60-8d1b-07ff393dd7dd" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1375/Source/Images/q-37091-a-1.png" :db/id #edb/ref 17592186103882}] :answer-field/correct {:answer/id #uuid "7ac01776-30bb-5f60-8d1b-07ff393dd7dd" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1375/Source/Images/q-37091-a-1.png" :db/id #edb/ref 17592186103882} :answer-field/id #uuid "d96f3d0a-39dd-5308-830e-5aa4141b9b29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103877}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "eeb68cad-07fc-5413-b03d-d7dfee7f1aee" :question/math-academy-id "q-37091" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/190af2ef92a8c23efb6fc15c6effebf5db929d8d133da6809bd27f77a6e9292b.png)\n\nThe vector $v$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $-1.$ Find the vector $Av.$" :question/worked-solution "The eigenvector $v=[\\begin{aligned}0 \\\\ 2\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =-1.$ So, \n\n$$\n\\begin{aligned}Av & =-1v.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/1f778e38d2dd4d2e33675bfa45bbe13c9596b1818092ef6129e8f35b1741157e.png)"}] [{:db/id #edb/ref 17592186333628 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08" :knowledge-point/title "Finding the Eigenvalue that Corresponds to a Given Eigenvector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5952ab21-3b0c-50b9-913b-305ff7c06b67" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ is not an eigenvector of $A$" :db/id #edb/ref 17592186333630} {:answer/id #uuid "a2697a81-d07b-54e2-808d-a906b013899a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333631} {:answer/id #uuid "0e40e7bc-64dc-58df-8e7b-9aae720090bf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186333632} {:answer/id #uuid "8c0f7913-f9a3-5e9c-9c60-430574c79c6c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186333633} {:answer/id #uuid "09721ffc-5370-5014-9cba-533e43e4db02" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186333634}] :answer-field/correct {:answer/id #uuid "5952ab21-3b0c-50b9-913b-305ff7c06b67" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ is not an eigenvector of $A$" :db/id #edb/ref 17592186333630} :answer-field/id #uuid "9ee20386-319d-5f3f-9497-b8386be5dbc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333629}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "740777a5-43a4-5203-8f0b-72f91859f44e" :question/math-academy-id "q-70917" :question/problem "Determine if $v=[\\begin{aligned}2 \\\\ -1\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}1 & 0 \\\\ 5 & 7\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}1 & 0 \\\\ 5 & 7\\end{aligned}][\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nIf $v$ is an eigenvector, then there must exist a real number $\\lambda $ such that $Av=\\lambda v.$ Hence, we have\n\n$$\n[\\begin{aligned}2 \\\\ 3\\end{aligned}]=\\lambda [\\begin{aligned}2 \\\\ -1\\end{aligned}].\n$$\n\nThis leads to the following system of equations for $\\lambda :$\n\n$$\n{\\begin{aligned}2=2\\lambda  \\\\ 3=-\\lambda \\end{aligned}\n$$\n\nThis system has no solution. Therefore, $v$ is not an eigenvector of $A.$"}] [{:db/id #edb/ref 17592186371244 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08" :knowledge-point/title "Finding the Eigenvalue that Corresponds to a Given Eigenvector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3d80542-5bc8-50ba-a3be-ab72d049d270" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186371246} {:answer/id #uuid "922bc24e-b624-53c9-9356-b7de8d37028c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371247} {:answer/id #uuid "0681ef85-b26d-5a02-b7e6-8fd3df2c0fdb" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ is not an eigenvector of $A$" :db/id #edb/ref 17592186371248} {:answer/id #uuid "c401fd4b-37ae-5d65-bcd1-5ad3f89d6937" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186371249} {:answer/id #uuid "7c267445-7910-5c74-a794-f2decac63c94" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186371250}] :answer-field/correct {:answer/id #uuid "c401fd4b-37ae-5d65-bcd1-5ad3f89d6937" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186371249} :answer-field/id #uuid "e41c7791-1467-51fd-884b-2b3217727656" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371245}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8df3e6f5-0623-56fd-a687-96ed260c8d59" :question/math-academy-id "q-75586" :question/problem "Determine if $v=[\\begin{aligned}-5 \\\\ 1\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}-2 & 5 \\\\ 1 & 2\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}-2 & 5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}-5 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}15 \\\\ -3\\end{aligned}] \\\\  & =(-3)\\cdot [\\begin{aligned}-5 \\\\ 1\\end{aligned}] \\\\  & =-3v.\\end{aligned}\n$$\n\nSince $Av=-3v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$"}] [{:db/id #edb/ref 17592186371251 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f5608f-a9f5-5e6a-b308-540ed8b29259" :knowledge-point/title "Determining the Value of an Unknown Given an Eigenvalue and Eigenvector of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8149b2d9-d323-521f-903c-42b115ae4c68" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371253} {:answer/id #uuid "985df5db-1f11-56a4-a917-a84b1394da5d" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186371254} {:answer/id #uuid "ee9401c3-c4c7-5492-a6c0-3ec82367ba91" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186371255} {:answer/id #uuid "684e2788-0f2c-572b-8fd5-0410e5364d04" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186371256} {:answer/id #uuid "5097ad64-b06c-5d1f-9671-c6a62c58096b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186371257}] :answer-field/correct {:answer/id #uuid "8149b2d9-d323-521f-903c-42b115ae4c68" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186371253} :answer-field/id #uuid "31c46150-14a8-5d7e-81f8-99a46e83ab9b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371252}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "1c4e0639-18e2-5768-9e5f-81dd26992565" :question/math-academy-id "q-75611" :question/problem "The eigenvector of $A=[\\begin{aligned}3 & 2 \\\\ 20-4k & 3\\end{aligned}]$ corresponding to the eigenvalue $\\lambda =2k+1$ is  $[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Determine the value of $k.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ So, we have\n\n$$\n\\begin{aligned}Av & =\\lambda v \\\\ [\\begin{aligned}3 & 2 \\\\ 20-4k & 3\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}] & =(2k+1)[\\begin{aligned}1 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}7 \\\\ 26-4k\\end{aligned}] & =[\\begin{aligned}2k+1 \\\\ 4k+2\\end{aligned}].\\end{aligned}\n$$\n\nThis gives us the following system of linear equations:\n\n$$\n{\\begin{aligned}7=2k+1, \\\\ 26-4k=4k+2\\end{aligned}\n$$\n\nSolving for $k$ in the first equation, we get\n\n$$\n7=2k+1\\,⟹\\,k=3.\n$$\n\nNow, substituting $k=3$ into the second equation, we get\n\n$$\n\\begin{aligned}26-4k & =4k+2 \\\\ 26-4\\cdot 3 & =4\\cdot 3+2 \\\\ 14 & =14,\\end{aligned}\n$$\n\nwhich is a true statement.\n\nTherefore, the solution of the system is $k=3.$"}] [{:db/id #edb/ref 17592186371258 :knowledge-point/_questions [{:knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88d3d43b-7e5e-5960-8512-650afbd429ec" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186371260} {:answer/id #uuid "b670d7bf-02b1-5311-89ce-c85f33a09e8a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186371261} {:answer/id #uuid "5f0aee3a-36e5-5b4c-86d9-7245db95edbc" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186371262} {:answer/id #uuid "3b0b9e07-f029-5bdf-8a52-3f5fa8798cb2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186371263} {:answer/id #uuid "2721dd86-c2ae-50f7-8282-f7e7cb0c5394" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186371264}] :answer-field/correct {:answer/id #uuid "2721dd86-c2ae-50f7-8282-f7e7cb0c5394" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186371264} :answer-field/id #uuid "ae1e310c-86ec-50a8-97d0-bf0935117919" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371259}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d7a91e6f-ec17-5b19-a508-d46535ff5b9a" :question/math-academy-id "q-75729" :question/problem "Which of the following statements are true?\n\n- If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =-2.$\n- An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =1.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $7v$ is also an eigenvector of $A$ corresponding to $\\lambda =\\frac{1}{2}.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement is false. By the definition of an eigenvector, we have \n\n$$\nAv=2v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=2{A}^{-1}v.\n$$\n\nDividing both sides by $2$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{2}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{2}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is true. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =1$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{1}=1.$\n\n- Statement III is false. We have\n\n$$\n\\begin{aligned}A(7v)=7Av=7(2v)=2(7v).\\end{aligned}\n$$\n\nSince, $A(7v)=2(7v),$ and $7v\\ne 0,$ this implies that $7v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186371265 :knowledge-point/_questions [{:knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e99e7e7f-1ade-5fba-80f5-ca53e99d12aa" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186371267} {:answer/id #uuid "cc606a5d-a2f8-5e2a-9047-41a81815b986" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186371268} {:answer/id #uuid "a7d15386-9280-58fc-8cf6-8e8b8ea50290" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186371269} {:answer/id #uuid "9a92bc77-efd3-5ccb-9e80-466e144a3a58" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186371270} {:answer/id #uuid "e1540114-d336-588e-b5b1-a70cccf42475" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186371271}] :answer-field/correct {:answer/id #uuid "e99e7e7f-1ade-5fba-80f5-ca53e99d12aa" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186371267} :answer-field/id #uuid "f96961ad-100f-5975-97ce-574a82ece562" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186371266}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a582afda-86b0-5457-9d06-6c4604568827" :question/math-academy-id "q-75730" :question/problem "Which of the following statements are true?\n\n- If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =\\frac{1}{4}$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =4.$\n- An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =-1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =-1.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =5,$ then $-v$ is also an eigenvector of $A$ corresponding to $\\lambda =5.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is true. By the definition of an eigenvector, we have \n\n$$\nAv=\\frac{1}{4}v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=\\frac{1}{4}{A}^{-1}v.\n$$\n\nMultiplying both sides by $4$, we get \n\n$$\n{A}^{-1}v=4v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $4.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is true. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =-1$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{-1}=-1.$\n\n- Statement III is true. We have\n\n$$\n\\begin{aligned}A(-v)=-Av=-(5v)=5(-v).\\end{aligned}\n$$\n\nSince, $A(-v)=5(-v),$ and $-v\\ne 0,$ this implies that $-v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =5.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186371272 :knowledge-point/_questions [{:knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "313585df-bfde-5869-9925-1f7e510631a2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/629a15bc2e114feaf13f7e43d2efccfd263cf081fcb2cffe423ea9b9e2103b73.png" :db/id #edb/ref 17592186371274} {:answer/id #uuid "c17effb0-6d56-57db-a7a2-bd2269bb7133" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/d45dd7a219e054d3c9192fd199c2eec28f639420f66a87a3c3230b0ff9626334.png" :db/id #edb/ref 17592186371275} {:answer/id #uuid "e9372a83-4f9b-5586-8627-7e3c9efd9d19" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/1ef0448df9f0a37289e9792ce62e6c92203aeb4333f2b25f21c608b5253cf1fe.png" :db/id #edb/ref 17592186371276} {:answer/id #uuid "d3181bfd-57bd-53e6-be85-960074ceb972" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/30cbcc85790224f64ef43e574beae6d777c9c5262dcb491dda4343ab9b42c193.png" :db/id #edb/ref 17592186371277} {:answer/id #uuid "658eb9c4-64cd-5528-b060-9ed62b9d2510" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/65ced0345d7acdf2dd3ed6320202f6c59b7cc65d2ca49209938821a97c021165.png" :db/id #edb/ref 17592186371278}] :answer-field/correct {:answer/id #uuid "e9372a83-4f9b-5