-28c3-5e3e-9983-9cedecabe094" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056271/assets/5aeec63c36be20f6d54610d4ad90de8ea047db412fca7851d0267176783bdca3.png" :db/id #edb/ref 17592186333666} {:answer/id #uuid "b284061c-5181-50fc-abed-a631a89a71c9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056271/assets/8d821e59ee37dfcd4dd5990c74ad7b0978276f55129d9c5fe00db953eadc4604.png" :db/id #edb/ref 17592186333667} {:answer/id #uuid "b412e062-f115-56f7-ab4f-9bc5542499f9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056271/assets/9e45156d033da0b7f5cb06d703e6bab2e65fae17f5ae7ae28374fab10f9da906.png" :db/id #edb/ref 17592186333668} {:answer/id #uuid "7ca71d25-3081-551c-9cdc-c3fe123ecee8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056271/assets/f3030aa3eb132ccd74991bff510393917e83a6683cce37d2c194c1526bef6e90.png" :db/id #edb/ref 17592186333669}] :answer-field/correct {:answer/id #uuid "2b255803-8093-5be6-8fc2-7640e17a1a7d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056271/assets/c272ff1454ac4ab9825e312f563c9bca08ac2800faa0e95ab45e8a5e827369da.png" :db/id #edb/ref 17592186333665} :answer-field/id #uuid "80dd2104-1296-5874-8bea-333b40680b46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186333664}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "99c608d5-32f4-5a36-a687-6d8033a11dd5" :question/math-academy-id "q-75735" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/61ed37aa6a5e67cdc60cca2c93969a47d12e1e36f18edf96f646922877641e79.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\frac{1}{2}.$ Find the vector $Au.$" :question/worked-solution "The eigenvector $u=[\\begin{aligned}2 \\\\ 0\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =\\frac{1}{2}.$ So, \n\n$$\n\\begin{aligned}Au & =\\frac{1}{2}u.\\end{aligned}\n$$\n\nThus, we have the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14071103/assets/c272ff1454ac4ab9825e312f563c9bca08ac2800faa0e95ab45e8a5e827369da.png)"}]}
