["q-23289/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "021e3349-c54d-55a8-9095-902bba933660"] :knowledge-point/questions ["q-23289"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-23273"] :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $x=-\\frac{2}{5}$ into the above and solving for $y$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {(-\\frac{2}{5})}^{2}+{y}^{2} & =1 \\\\ (\\frac{4}{25})+{y}^{2} & =1 \\\\ {y}^{2} & =1-\\frac{4}{25} \\\\ {y}^{2} & =\\frac{21}{25} \\\\ y & =\\pm \\sqrt{\\frac{21}{25}} \\\\ y & =\\pm \\frac{\\sqrt{21}}{5}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $y$ is negative in the third quadrant. So our final answer is $y=-\\frac{\\sqrt{21}}{5}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-124828/selection/ed3dbdabe89fcec5bb7ca7c78093d4d27791480c9e1bae65b3c4c9ad2c1c551a" :answer/id #uuid "097d4ba8-ff85-5627-95dc-605d48d95a5c" :answer/type :answer.type/math :answer/value "x=\\frac{\\sqrt{14}}{9}" :db/ensure [:answer/validate]} {:db/id "q-124828/selection/7eb9aaced571e682a8eb4c9e566c9bc9022a1f01b091bf0ff6df69b05400ac48" :answer/id #uuid "a68c87e6-59a2-5ba6-aedf-f80459fc1cd0" :answer/type :answer.type/math :answer/value "x=\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "q-124828/selection/1cddafd6df018542a70cb83265004f87d69b3db607acb7c018b551882e7c4509" :answer/id #uuid "fef2536b-33d4-50f9-ae6c-2f7008a2b359" :answer/type :answer.type/math :answer/value "x=\\frac{2\\sqrt{14}}{9}" :db/ensure [:answer/validate]} {:db/id "q-124828/selection/f8d77f68e4fd2ba1427c69f3f00adcdb22c35d3c2a693b3092f1c37c36805409" :answer/id #uuid "d4e5fec8-1fa7-5008-a74b-64b68cdce11b" :answer/type :answer.type/math :answer/value "x=-\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "q-124828/selection/10d07d3ab5ea4