21a81333f08e20c5ffc3" "q-24074/selection/09567dbc76421d7ead45065469979b322827fb8eebf5a4aae61ccfca899eb073" "q-24074/selection/b2a38c649e47144f88a6f904bcc179bbf9d4060764a7e174c4ff561fd58673a6"] :db/ensure [:answer-field/validate]} {:db/id "q-24074" :question/id #uuid "bf22114b-65ea-5d8a-859d-2c70937236ca" :question/math-academy-id "q-24074" :question/is-example false :question/problem "If $sin⁡\\theta =\\frac{5}{13}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $cos⁡\\theta ?$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932638/assets/d6ec4c0b71e64cd659bceea63a49f0ef09c44ee1c31353fd377963d7cdf3c3db.png)\n\nWe're given that $sin⁡\\theta =\\frac{5}{13}.$ We can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{5}{13}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{5}{13})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{169}} \\\\  & =\\pm \\sqrt{\\frac{144}{169}} \\\\  & =\\pm \\frac{12}{13}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{12}{13}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-24074/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9089ba5c-f241-574e-9592-a26e09535b69"] :knowledge-point/questions ["q-24074"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124957/selection/67f978145f83df0fb5547201b1c6b629008f2267c9af687a9be28214ddaae99d" :answer/id #uuid "b3f8cfff-141e-5381-90ac-03b6f38f2c13" :answer/type :answer.type/math :answer/value "cos⁡\\theta =\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-124957/selection/047d270b5682fab75ce67f08243032896dcb5c467ec78af9a12dfc33bd1508fe" :answer/id #uuid "07121185-336b-5744-b3eb-7033a4c7e7e6" :answer/type :answer.type/math :answer/value "cos⁡\\theta =\\frac{2\\sqrt{6}}{5}" :db/ensure [:answer/validate]} {:db/id "q-124957/selection/85eecc19ef52e8b25af937617a7106ab27f84e972dc44e08cee845fb4f5736e9" :answer/id #uuid "b046a43b-d398-5a2b-abd7-befe5112dfcb" :answer/type :answer.type/math :answer/value "cos⁡\\theta =\\frac{\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id "q-124957/selection/8975ae3ce5f9b549b5ef6d9e1ae01194f04ed862aeb9feea2187b6a2996dfb40" :answer/id #uuid "2ded9f8f-cd3a-5f87-936d-9610a17302b7" :answer/type :answer.type/math :answer/value "cos⁡\\theta =-\\frac{2\\sqrt{6}}{5}" :db/ensure [:answer/validate]} {:db/id "q-124957/selection/d23f909ef84d28abbe1fcb83631e41cb9edd5735952210585d7f031ab2355c8c" :answer/id #uuid "1f8c596f-1e74-5c15-950a-5fa06525d1d4" :answer/type :answer.type/math :answer/value "cos⁡\\theta =-\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-124957/selection" :answer-field/id #uuid "fda69e35-0662-5ecb-93a0-6aed06b94d50" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124957/selection/047d270b5682fab75ce67f08243032896dcb5c467ec78af9a12dfc33bd1508fe" :answer-field/choices ["q-124957/selection/67f978145f83df0fb5547201b1c6b629008f2267c9af687a9be28214ddaae99d" "q-124957/selection/047d270b5682fab75ce67f08243032896dcb5c467ec78af9a12dfc33bd1508fe" "q-124957/selection/85eecc19ef52e8b25af937617a7106ab27f84e972dc44e08cee845fb4f5736e9" "q-124957/selection/8975ae3ce5f9b549b5ef6d9e1ae01194f04ed862aeb9feea2187b6a2996dfb40" "q-124957/selection/d23f909ef84d28abbe1fcb83631e41cb9edd5735952210585d7f031ab2355c8c"] :db/ensure [:answer-field/validate]} {:db/id "q-124957" :question/id #uuid "998f15db-1b74-586a-8dd5-838041bed908" :question/math-academy-id "q-124957" :question/is-example false :question/problem "If $sin⁡\\theta =-\\frac{1}{5}$ and ${270}^{∘}<\\theta <{360}^{∘}$ then what is the value of $cos⁡\\theta ?$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932638/assets/01f881c353d1d113e97680cce375359cedf561e69259a6b2ba1fe15097742dda.png)\n\nWe're given that $sin⁡\\theta =-\\frac{1}{5}.$ We can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =-\\frac{1}{5}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{25}} \\\\  & =\\pm \\sqrt{\\frac{24}{25}} \\\\  & =\\pm \\frac{2\\sqrt{6}}{5}.\\end{aligned}\n$$\n\nWe select the positive answer since $cos⁡\\theta $ is positive in the fourth quadrant. So, $cos⁡\\theta =\\frac{2\\sqrt{6}}{5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124957/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9089ba5c-f241-574e-9592-a26e09535b69"] :knowledge-point/questions ["q-124957"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-42043"] :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932638/assets/948610f67267e6ec1b845d2b4e1bc4030b81a1080bcb9a44d9f974ff78c3f7b0.png)\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{\\sqrt{3}}{2}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{(\\frac{1}{2})}{(-\\frac{\\sqrt{3}}{2})}=-\\frac{1}{\\sqrt{3}}=-\\frac{\\sqrt{3}}{3}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-124974/selection/01f9efe733cc3a5181d377c6dc54fe24aeaa5b205e08df27a481f222e8cac8d0" :answer/id #uuid "2ccc3428-55ff-5a1f-81dd-aaa2cfe42bb3" :answer/type :answer.type/math :answer/value "tan⁡\\theta =\\frac{2\\sqrt{6}}{3}" :db/ensure [:answer/validate]} {:db/id "q-124974/selection/2839f334f52b793c675fdff4b3f08f7c384a17e76195383ea4b8d6575b48dbe4" :answer/id #uuid "880698f7-3783-521d-b8de-ae4d00eb8eda" :answer/type :answer.type/math :answer/value "tan⁡\\theta =-\\frac{2\\sqrt{6}}{3}" :db/ensure [:answer/validate]} {:db/id "q-124974/selection/1e33f98ce4ac858103d553a58f07f5c57d0b9ada92a3a84e7ac176eaf2064ab3" :answer/id #uuid "b2dfc134-7e11-550c-a7c8-f48893b1651e" :answer/type :answer.type/math :answer/value "tan⁡\\theta =-2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-124974/selection/a998b4bd85900c605b9b684a92c0d66f03e1d379bbd845d72f8c2ef91e014b63" :answer/id #uuid "6429f111-191f-5580-bd60-336e44760393" :answer/type :answer.type/math :answer/value "tan⁡\\theta =2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-124974/selection/73f589b9fa7810a30d81cb369708fa7d75d4210bc124c98bafea99b2e0df3f7b" :answer/id #uuid "cd5f75e8-ecb3-5836-a29d-508998a836bf" :answer/type :answer.type/math :answer/value "tan⁡\\theta =\\frac{\\sqrt{6}}{5}" :db/ensure [:answer/validate]} {:db/id "q-124974/selection" :answer-field/id #uuid "94778196-b324-5dea-a721-bf43032dec60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124974/selection/a998b4bd85900c605b9b684a92c0d66f03e1d379bbd845d72f8c2ef91e014b63" :answer-field/choices ["q-124974/selection/01f9efe733cc3a5181d377c6dc54fe24aeaa5b205e08df27a481f222e8cac8d0" "q-124974/selection/