q-124958/selection/34521af64ef9cbe392b7dc1ae5a4eba7120b76effc4aae6aa432b5bf6a49862d" "q-124958/selection/d1ef5f3321f631b5a648077462ef495473c7986a0b19b4daf48c0b844119a7ef" "q-124958/selection/374e032e7bd91b7f9a216ac390a6a62eb5f15fcc90a786425bd3c69be1f19409"] :db/ensure [:answer-field/validate]} {:db/id "q-124958" :question/id #uuid "32b575e9-a555-53bc-a62c-e87c7ca0a623" :question/math-academy-id "q-124958" :question/is-example false :question/problem "If $cos⁡\\theta =-\\frac{1}{4}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $sin⁡\\theta ?$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932638/assets/7e887638bb8b3b135c6a8e6eecf564fe8310a43f2ce26f8b565ec6966bafb89c.png)\n\nWe're given that $cos⁡\\theta =-\\frac{1}{4}.$ We can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =-\\frac{1}{4}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{4})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{16}} \\\\  & =\\pm \\sqrt{\\frac{15}{16}} \\\\  & =\\pm \\frac{\\sqrt{15}}{4}.\\end{aligned}\n$$\n\nWe select the positive answer since $sin⁡\\theta $ is positive in the second quadrant. So, $sin⁡\\theta =\\frac{\\sqrt{15}}{4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124958/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9089ba5c-f241-574e-9592-a26e09535b69"] :knowledge-point/questions ["q-124958"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-24247"] :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13932638/assets/4942cec8983dd2bddddd0ba2f8f9332b1b82f3999a44adb138b905457d39c633.png)\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{1}{3}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{3})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{9}} \\\\  & =\\pm \\sqrt{\\frac{8}{9}} \\\\  & =\\pm \\frac{2\\sqrt{2}}{3}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{2\\sqrt{2}}{3}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-124959/selection/1cec2cb2bef40325e698daada031f8931e0992d40bbee08e6149f1addaecd544" :answer/id #uuid "cbf61191-2fc0-576a-acad-8549a53c5231" :answer/type :answer.type/math :answer/value "cos⁡\\theta =-\\frac{5\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-124959/selection/b2e15f56dd11a86ab5027f16c56b4d5d9270f7d2cabdac0993f8ce6d44beebbc" :answer/id #uuid "d70cbc17-3d92-507c-ad23-665bb44a38e5" :answer/type :answer.type/math :answer/value "cos⁡\\theta =-\\frac{\\sqrt{11}}{6}" :db/ensure [:answer/validate]} {:db/id "q-124959/selection/963af11417cbd2acc641a74ccfcd172e7df271ba9f7b8400ef1b622f40c0a06a" :answer/id #uuid "abe56fe0-1ece-5bcf-8620-c851a9d6641d" :answer/type :answer.type/math :answer/value "cos⁡\\theta =-\\frac{\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-124959/selection/4e4920b2748af0dd92dd5d5dd03b119ac92b4163a407c7f6a7432af60085dd39" :answer/id #uuid "029d2f02-5172-5d88-9634-f4476bd202ab" :answer/type :answer.type/math :answer/value "cos⁡\\theta =\\frac{\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-124959/selection/674612b0f1ec44d21aa06bb358451e57b99dd95931b58658a138c5211986ae43" :answer/id #uuid "08b0afcf-b13c-5ad6-a58f-3077a4d81714" :answer/type :answer.type/math :answer/value "cos⁡\\theta =\\frac{\\sqrt{11}}{6}" :db/ensure [:answer/validate]