rm:\n\n$$\nz=\\frac{3\\sqrt{2}}{2}\\,(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4})).\n$$" 13194139533920 true] [17592186265998 1000 #edb/ref 17592186265999 13194139533920 true] [17592186265998 1040 #edb/ref 17592186045449 13194139533920 true] [17592186265998 1041 "field-1" 13194139533920 true] [17592186265998 1104 #edb/ref 17592186265999 13194139533920 true] [17592186265998 1110 #uuid "23abaa5c-f7c3-522a-b38a-bd916814fcda" 13194139533920 true] [17592186265999 1034 "\\frac{3\\sqrt{2}}{2}" 13194139533920 true] [17592186265999 1103 #edb/ref 17592186045453 13194139533920 true] [17592186265999 1111 #uuid "cc85c43c-6e60-58d9-92cf-ac6b866cbd04" 13194139533920 true] [17592186266000 1000 #edb/ref 17592186266001 13194139533920 true] [17592186266000 1040 #edb/ref 17592186045449 13194139533920 true] [17592186266000 1041 "field-2" 13194139533920 true] [17592186266000 1104 #edb/ref 17592186266001 13194139533920 true] [17592186266000 1110 #uuid "ede24cf6-2533-555c-9c03-dd872dc4268b" 13194139533920 true] [17592186266001 1034 "\\frac{\\pi}{4}" 13194139533920 true] [17592186266001 1103 #edb/ref 17592186045453 13194139533920 true] [17592186266001 1111 #uuid "ce211202-f488-5b66-b236-b347c5372f07" 13194139533920 true] [17592186266002 1000 #edb/ref 17592186266003 13194139533920 true] [17592186266002 1040 #edb/ref 17592186045449 13194139533920 true] [17592186266002 1041 "field-3" 13194139533920 true] [17592186266002 1104 #edb/ref 17592186266003 13194139533920 true] [17592186266002 1110 #uuid "d7b65906-25ce-5d9d-b427-3a70d48b6883" 13194139533920 true] [17592186266003 1034 "\\frac{\\pi}{4}" 13194139533920 true] [17592186266003 1103 #edb/ref 17592186045453 13194139533920 true] [17592186266003 1111 #uuid "ebca2134-f62d-594a-abe2-3a5853b396c0" 13194139533920 true] [17592186266004 1017 #edb/ref 17592186266005 13194139533920 true] [17592186266004 1017 #edb/ref 17592186266007 13194139533920 true] [17592186266004 1017 #edb/ref 17592186266009 13194139533920