b/id "q-17162" :question/id #uuid "bf55f526-0929-5f91-84c0-2f0248a9d9bf" :question/math-academy-id "q-17162" :question/problem "Express $z=4(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡\\frac{\\pi }{4}=\\frac{\\sqrt{2}}{2}$ and $\\operatorname{sin}⁡\\frac{\\pi }{4}=\\frac{\\sqrt{2}}{2}$, we have\n\n$$\n\\begin{aligned}z & =4(\\operatorname{cos}⁡\\frac{\\pi }{4}+\\text{i}\\operatorname{sin}⁡\\frac{\\pi }{4}) \\\\  & =4(\\frac{\\sqrt{2}}{2}+\\text{i}\\frac{\\sqrt{2}}{2}) \\\\  & =2\\sqrt{2}+2\\sqrt{2}\\,\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17162/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591"] :knowledge-point/questions ["q-17162"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321309/field-1/379c879005c951f5c680bd3d2d5b36c3a4c0aa54df8344121ae284e3302c34a1" :answer/id #uuid "de6b2d44-4e84-5d60-9079-c0c3a9cbbec7" :answer/type :answer.type/math :answer/value "-10\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-321309/field-1/45afa4ab8b584699aa7f101f770fb36cd516ebe64e699afe8e28cfb261a20578" :answer/id #uuid "65379b43-adeb-5a46-91aa-b7a24c3ee185" :answer/type :answer.type/math :answer/value "10\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-321309/field-1" :answer-field/id #uuid "642dca7e-c704-5b7e-898b-d0c07d9280ca" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321309/field-1/379c879005c951f5c680bd3d2d5b36c3a4c0aa54df8344121ae284e3302c34a1" :answer-field/choices ["q-321309/field-1/379c879005c951f5c680bd3d2d5b36c3a4c0aa54df8344121ae284e3302c34a1" "q-321309/field-1/45afa4ab8b584699aa7f101f770fb36cd516ebe64e699afe8e28cfb261a20578