2}\\,\\text{i}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321309/field-1" "q-321309/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591"] :knowledge-point/questions ["q-321309"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69967/selection/614955f503b09b81680fb3b065f6c8110cc67e9cfa51c9e0197c54b8f1c20908" :answer/id #uuid "4a9c5ca9-2e05-5d9c-9ae1-16f7e1e93a28" :answer/type :answer.type/math :answer/value "z=-1+\\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-69967/selection/a8e9a5abccd284101412a5f4fc5954c41cbcb0edf1fb08139c76142c686c4ad6" :answer/id #uuid "b72c2978-72a1-5c2a-8a34-11f6cc61ed5f" :answer/type :answer.type/math :answer/value "z=1-\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-69967/selection/96303614ae3edd14c858035b15a63424d99440aca3632d0e6cc5a21d3ea20198" :answer/id #uuid "6f0a216b-686b-57e9-b222-f06ebd093205" :answer/type :answer.type/math :answer/value "z=\\sqrt{3}-\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-69967/selection/d87506f3d73635736cfdb23e7c470f2f20823ffa484bcdd94091bb3b30a4c8fc" :answer/id #uuid "e4a28222-ca80-5e71-a22c-223f705e152d" :answer/type :answer.type/math :answer/value "z=1-\\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-69967/selection/a32c3d9b3437914410bca3540ce61119a9d02d20da14fdb4ae143743c20a71c9" :answer/id #uuid "6f7425a7-31fd-5ec4-8864-cf8c93312020" :answer/type :answer.type/math :answer/value "z=\\sqrt{3}-\\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-69967/selection" :answer-field/id #uuid "6c4fbd94-97e3-513a-a3cc-c18d1f9320c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69967/selection/d87506f3d73635736cfdb23e7c470f2f20823ffa484bcdd94091bb3b30a4c8fc" :answer-field/choices ["q-69967/selection/614955f503b09b81680fb3b065f6c8110cc67e9cfa51c9e0197c54b8f1c20908" "q-69967/selection/a8e9a5abccd284101412a5f4fc5954c41cbcb0edf1fb08139c76142c686c4ad6" "q-69967/selection/96303614ae3edd14c858035b15a63424d99440aca3632d0e6cc5a21d3ea20198" "q-69967/selection/d87506f3d73635736cfdb23e7c470f2f20823ffa484bcdd94091bb3b30a4c8fc" "q-69967/selection/a32c3d9b3437914410bca3540ce61119a9d02d20da14fdb4ae143743c20a71c9"] :db/ensure [:answer-field/validate]} {:db/id "q-69967" :question/id #uuid "14bc3738-08e4-584c-8b05-fa64bde46f62" :question/math-academy-id "q-69967" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\frac{5\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{3}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{5\\pi }{3})$ and $\\operatorname{sin}⁡(\\frac{5\\pi }{3}):$\n \n\n$$\n\\operatorname{cos}⁡(\\frac{5\\pi }{3})=\\operatorname{cos}⁡(-\\frac{\\pi }{3})=\\operatorname{cos}⁡(\\frac{\\pi }{3})=\\frac{1}{2},\n$$\n\n \n\n$$\n\\operatorname{sin}⁡(\\frac{5\\pi }{3})=\\operatorname{sin}⁡(-\\frac{\\pi }{3})=-\\operatorname{sin}⁡(\\frac{\\pi }{3})=-\\frac{\\sqrt{3}}{2}.\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\frac{5\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{5\\pi }{3})) \\\\  & =2(\\frac{1}{2}-\\text{i}\\frac{\\sqrt{3}}{2}) \\\\  & =1-\\sqrt{3}\\,\\text{i}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69967/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591"] :knowledge-point/questions ["q-69967"] :db/ensure [:knowledge-point/validate]}]
