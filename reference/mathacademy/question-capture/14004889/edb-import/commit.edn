d}x & 0 & 2 \\\\ u & 1 & 9\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\sqrt{{({x}^{3}+1)}^{3}}\\cdot 3{x}^{2}\\,\\text{d}x={\\int }_{1}^{9}\\sqrt{{u}^{3}}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{9}\\sqrt{{u}^{3}}\\,\\text{d}u & ={\\int }_{1}^{9}{u}^{3/2}\\,\\text{d}u \\\\  & ={\\frac{2}{5}{u}^{5/2}|}_{1}^{9} \\\\  & =\\frac{2}{5}({9}^{5/2}-{1}^{5/2}) \\\\  & =\\frac{2}{5}(({3}^{2})^{5/2}-1) \\\\  & =\\frac{2}{5}({3}^{5}-1) \\\\  & =\\frac{484}{5}.\\end{aligned}\n$$" 13194139534413 true] [17592186286935 1000 #edb/ref 17592186286936 13194139534413 true] [17592186286935 1000 #edb/ref 17592186286937 13194139534413 true] [17592186286935 1000 #edb/ref 17592186286938 13194139534413 true] [17592186286935 1000 #edb/ref 17592186286939 13194139534413 true] [17592186286935 1000 #edb/ref 17592186286940 13194139534413 true] [17592186286935 1040 #edb/ref 17592186045450 13194139534413 true] [17592186286935 1041 "selection" 13194139534413 true] [17592186286935 1104 #edb/ref 17592186286940 13194139534413 true] [17592186286935 1110 #uuid "8899b9d4-ec60-5237-b82a-86d8cabd9e00" 13194139534413 true] [17592186286936 1034 "\\frac{844}{5}" 13194139534413 true] [17592186286936 1103 #edb/ref 17592186045453 13194139534413 true] [17592186286936 1111 #uuid "26c816eb-4186-5d17-8d26-9bf774a9a4a9" 13194139534413 true] [17592186286937 1034 "\\frac{5}{844}" 13194139534413 true] [17592186286937 1103 #edb/ref 17592186045453 13194139534413 true] [17592186286937 1111 #uuid "05a8004e-bdbd-5828-aa03-6e55f2f0c732" 13194139534413 true] [17592186286938 1034 "\\frac{448}{5}" 13194139534413 true] [17592186286938 1103 #edb/ref 17592186045453 13194139534413 true] [17592186286938 1111 #uuid "26dfb02b-952e-51af-9728-d45ce9eb7d38" 13194139534413 true] [17592186286939 1034 "\\frac{48}{5}" 13194139534413 true] [17592186286939 1103 #edb/ref 17592186045453 13194139534413 true] [17592186286939 1111 #uuid "1a8e270b-fe9f-5