3619 true] [17592186242255 1111 #uuid "03ae6209-1d38-5b57-8430-924aeb685b35" 13194139533619 true] [17592186242256 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/0fba58dd803485e67f90d0d4083c3c795d623d5c3f49defbde56ba6a04f50e7e.png" 13194139533619 true] [17592186242256 1103 #edb/ref 17592186045452 13194139533619 true] [17592186242256 1111 #uuid "ebda6465-2a7f-5092-b34b-2d8ac88aac6e" 13194139533619 true] [17592186242257 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/3c8dd0e4726747b00e4377e43c06693326e10db2977257c9c20da4953127ddfd.png" 13194139533619 true] [17592186242257 1103 #edb/ref 17592186045452 13194139533619 true] [17592186242257 1111 #uuid "383b43fd-08f9-59ca-acaa-fcc9f07e4f44" 13194139533619 true] [17592186242258 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/23a24a5d620c86a06fdb520f0e2a5cb370d534773f5eed1d906b51fe5205b9e4.png" 13194139533619 true] [17592186242258 1103 #edb/ref 17592186045452 13194139533619 true] [17592186242258 1111 #uuid "a055ca54-797c-5018-afee-9ec2b830bb9c" 13194139533619 true] [17592186242259 1017 #edb/ref 17592186242260 13194139533619 true] [17592186242259 1089 "q-113476" 13194139533619 true] [17592186242259 1091 #edb/ref 17592186045465 13194139533619 true] [17592186242259 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/c1159b59ac6a52c570852cb47ec1ef07d0985ee8b734f2e375cf54919c8b537b.png)\n\nThe graph represents the function $y=\\frac{a}{x}+k.$ What is the value of $a+k?$" 13194139533619 true] [17592186242259 1113 #uuid "0f44a540-d3ee-5911-b389-01c797246068" 13194139533619 true] [17592186242259 1138 false 13194139533619 true] [17592186242259 1145 "First, notice that the horizontal asymptote of the graph is $y=1.5.$ This means that $k=1.5$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}+1.5.\n$$\n\nAlso, we are given that the point $(1,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}+1.5 \\\\ 3.5 & =\\frac{a}{1}+1.5 \\\\ 2 & =\\frac{a}{1} \\\\ a & =2.\\end{aligned}\n$$\n\nFinally, $a+k=2+1.5=3.5.$" 13194139533619 true] [17592186242260 1000 #edb/ref 17592186242261 13194139533619 true] [17592186242260 1000 #edb/ref 17592186242262 13194139533619 true] [17592186242260 1000 #edb/ref 17592186242263 13194139533619 true] [17592186242260 1000 #edb/ref 17592186242264 13194139533619 true] [17592186242260 1000 #edb/ref 17592186242265 13194139533619 true] [17592186242260 1040 #edb/ref 17592186045450 13194139533619 true] [17592186242260 1041 "selection" 13194139533619 true] [17592186242260 1104 #edb/ref 17592186242265 13194139533619 true] [17592186242260 1110 #uuid "a7152e3c-502d-5c73-bde3-4eaafc52b585" 13194139533619 true] [17592186242261 1034 "-2.5" 13194139533619 true] [17592186242261 1103 #edb/ref 17592186045453 13194139533619 true] [17592186242261 1111 #uuid "c0a79572-4e5c-59da-ac61-e627dd869f64" 13194139533619 true] [17592186242262 1034 "2" 13194139533619 true] [17592186242262 1103 #edb/ref 17592186045453 13194139533619 true] [17592186242262 1111 #uuid "495a7717-e793-5533-a6a0-fdca52d57811" 13194139533619 true] [17592186242263 1034 "-1.5" 13194139533619 true] [17592186242263 1103 #edb/ref 17592186045453 13194139533619 true] [17592186242263 1111 #uuid "21fbe893-f299-5c1c-9c32-458a32ba26c7" 13194139533619 true] [17592186242264 1034 "1" 13194139533619 true] [17592186242264 1103 #edb/ref 17592186045453 13194139533619 true] [17592186242264 1111 #uuid "bf30b3ee-8be8-51fe-a1a2-b8230d0b0451" 13194139533619 true] [17592186242265 1034 "3.5" 13194139533619 true] [17592186242265 1103 #edb/ref 17592186045453 13194139533619 true] [17592186242265 1111 #uuid "e2aa7b29-abd7-56f9-9a68-7248c200f040" 13194139533619 true] [17592186242266 1017 #edb/ref 17592186242267 13194139533619 true] [17592186242266 1089 "q-113478" 13194139533619 true] [