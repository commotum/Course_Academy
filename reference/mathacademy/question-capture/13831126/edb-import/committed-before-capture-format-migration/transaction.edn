radio :answer-field/correct "q-113466/selection/5ee1c4dd826a6d7ccdfb4a3edf58ea04945df2a714dc5523f8c7d2b6ad19bd2b" :answer-field/choices ["q-113466/selection/4fea5d4d79b0c0002fe3b2f4802a7ae7609ae3ecc7d9f4a332f67f254eee4456" "q-113466/selection/5ee1c4dd826a6d7ccdfb4a3edf58ea04945df2a714dc5523f8c7d2b6ad19bd2b" "q-113466/selection/8f9397dfd208fc2fdf874dd3e21ecb7dbf4556eabbaa74f9c6cbf4ae50fba2a7" "q-113466/selection/129e947743903bf147aca237af05aceff9757413b740a106d3524783bcbf0825" "q-113466/selection/6ae4fc6cbdc64b094e80caf9eb09c2bc0115e23d4c41e4fbff919a8a4ffe768f"] :db/ensure [:answer-field/validate]} {:db/id "q-113466" :question/id #uuid "4fb552b9-23bd-5131-aeec-7c1788a3eec5" :question/math-academy-id "q-113466" :question/is-example false :question/problem "Which of the following is the graph of $y=-\\frac{2}{x-2}?$" :question/worked-solution "To plot $y=-\\frac{2}{x-2},$ we apply the following steps:\n\n- Take the curve $y=-\\frac{1}{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/9da0db2e6c97e507e82b7ca801e46802fabf91ad31ff53ad3cc9ae580151370a.png)\n\n- Translate it by $2$ units to the right to get the graph of $y=-\\frac{1}{x-2}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/3c8dd0e4726747b00e4377e43c06693326e10db2977257c9c20da4953127ddfd.png)\n\n- Then, stretch the result by a scale factor of $2$ parallel to the $y$-axis to get the graph of $y=-\\frac{2}{x-2}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/207dec9757b65a75c25ba7ace7a12bec8e922bda9018e58d6511d12de47426b7.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113466/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4640f978-9caa-5960-bec4-f153a1b4cc5d"] :knowledge-point/questions ["q-113466"] :db/ensure [:knowledge-point/validate]} {:db/id "q-270750/field-1/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer/id #uuid "f0120001-d0e3-55a5-af79-ace7feafebad" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "q-270750/field-1" :answer-field/id #uuid "797bf9b8-c3fa-5c42-a54e-147479f1bbd3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270750/field-1/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer-field/choices ["q-270750/field-1/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13"] :db/ensure [:answer-field/validate]} {:db/id "q-270750/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "fb8976a6-8d64-505c-ad8f-46896b5343f9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-270750/field-2" :answer-field/id #uuid "58867d0b-0393-590f-a4ba-338da8517928" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-270750/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-270750/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-270750" :question/id #uuid "e0c5ffd4-1bef-580c-b324-7b179c12853b" :question/math-academy-id "q-270750" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/07c9680ad2a94338bcb17c51db591eb4dc76ba483f8613bc105095a37341ebd9.png)\n\nThe graph represents the function $y=\\frac{a}{x}+k.$ What are the values of $a$ and $k?$\n\n$a=$\n{{field-1}},$\\,k=$\n{{field-2}}" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=1.$ This means that $k=1$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}+1.\n$$\n\nAlso, we are given that the point $(1,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}+1 \\\\ 3.5 & =\\frac{a}{1}+1 \\\\ 3.5 & =a+1 \\\\ a & =2.5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-270750/field-1" "q-270750/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2"] :knowledge-point/questions ["q-270750"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320718/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "ddc9c45b-9d58-5a42-bf7a-5091daa99ae7" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-320718/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "14290c82-470a-5fe8-9869-5b8783b9d494" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-320718/field-1" :answer-field/id #uuid "f5dfb196-08c1-5004-a5e7-1cb3836a384c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320718/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-320718/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-320718/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-320718/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "dcadc417-5835-5c11-8854-733a7f3a065f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-320718/field-2" :answer-field/id #uuid "f289a109-e67b-5d9e-9440-cd50903c3947" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320718/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-320718/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-320718/field-3/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer/id #uuid "13bb8c66-3a63-5164-8386-a9b657887f21" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "q-320718/field-3" :answer-field/id #uuid "65f8f3de-51e5-5ae6-9e1f-9ca54c0a22ba" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320718/field-3/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer-field/choices ["q-320718/field-3/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13"] :db/ensure [:answer-field/validate]} {:db/id "q-320718" :question/id #uuid "bbc68e4c-6ec2-50b7-92e2-b678df9adbd0" :question/math-academy-id "q-320718" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/c90af67d867e33c847f66721c1abbc6768fbc34e7f39648fbc2e4f486a87ca3f.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What are the values of $a,$ $b,$ and $k?$\n\n$a=$\n{{field-1}},$\\,b=$\n{{field-2}},$\\,k=$\n{{field-3}}" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=2.5,$ while the vertical asymptote is $x=-2.$ This means that $k=2.5$ and $b=-2,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-(-2)}+2.5=\\frac{a}{x+2}+2.5.\n$$\n\nAlso, we are given that the point $(-5,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x+2}+2.5 \\\\ 3.5 & =\\frac{a}{-5+2}+2.5 \\\\ 1 & =\\frac{a}{(-3)} \\\\ a & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-320718/field-1" "q-320718/field-2" "q-320718/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2"] :knowledge-point/questions ["q-320718"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113476/selection/98825339913b96286f9751ca67affc1b40dbfb36f8a6273cb27701f4b3f223de" :answer/id #uuid "21fbe893-f299-5c1c-9c32-458a32ba26c7" :answer/type :answer.type/math :answer/value "-1.5" :db/ensure [:answer/validate]} {:db/id "q-113476/selection/03a4102f13ad3e0ac65ab53676c3f89cede3c650c4dd4e31a2b43a62847e184f" :answer/id #uuid "c0a79572-4e5c-59da-ac61-e627dd869f64" :answer/type :answer.type/math :answer/value "-2.5" :db/ensure [:answer/validate]} {:db/id "q-113476/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "495a7717-e793-5533-a6a0-fdca52d57811" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-113476/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "bf30b3ee-8be8-51fe-a1a2-b8230d0b0451" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-113476/selection/d0d01bb2e3e816b9fd6aee47accd74e6df07f3f36fe536db4d7bfbcde2546d68" :answer/id #uuid "e2aa7b29-abd7-56f9-9a68-7248c200f040" :answer/type :answer.type/math :answer/value "3.5" :db/ensure [:answer/validate]} {:db/id "q-113476/selection" :answer-field/id #uuid "a7152e3c-502d-5c73-bde3-4eaafc52b585" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113476/selection/d0d01bb2e3e816b9fd6aee47accd74e6df07f3f36fe536db4d7bfbcde2546d68" :answer-field/choices ["q-113476/selection/98825339913b96286f9751ca67affc1b40dbfb36f8a6273cb27701f4b3f223de" "q-113476/selection/03a4102f13ad3e0ac65ab53676c3f89cede3c650c4dd4e31a2b43a62847e184f" "q-113476/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-113476/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-113476/selection/d0d01bb2e3e816b9fd6aee47accd74e6df07f3f36fe536db4d7bfbcde2546d68"] :db/ensure [:answer-field/validate]} {:db/id "q-113476" :question/id #uuid "0f44a540-d3ee-5911-b389-01c797246068" :question/math-academy-id "q-113476" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/c1159b59ac6a52c570852cb47ec1ef07d0985ee8b734f2e375cf54919c8b537b.png)\n\nThe graph represents the function $y=\\frac{a}{x}+k.$ What is the value of $a+k?$" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=1.5.$ This means that $k=1.5$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}+1.5.\n$$\n\nAlso, we are given that the point $(1,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}+1.5 \\\\ 3.5 & =\\frac{a}{1}+1.5 \\\\ 2 & =\\frac{a}{1} \\\\ a & =2.\\end{aligned}\n$$\n\nFinally, $a+k=2+1.5=3.5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113476/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2"] :knowledge-point/questions ["q-113476"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113482/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" :answer/id #uuid "3e3249ec-4ce6-5a68-8f46-49e6df79cc6f" :answer/type :answer.type/math :answer/value "-0.5" :db/ensure [:answer/validate]} {:db/id "q-113482/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "60082bf3-9cc3-5b4f-a861-831ce38e0678" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-113482/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "77533ece-bdad-5eb2-87d5-83906f3edc6d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-113482/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer/id #uuid "434a8b7b-c127-5152-a15f-5c5d4b0419fb" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "q-113482/selection/dfd5f31d881889706cf6a223c90e51452850b5a5fea00254db5c20ed13cc8a7f" :answer/id #uuid "1a2388b7-1b9a-5fb4-9f91-dd1ef1b59d60" :answer/type :answer.type/math :answer/value "-4.5" :db/ensure [:answer/validate]} {:db/id "q-113482/selection" :answer-field/id #uuid "662589e3-a5e5-50aa-a3bd-abe792dd89a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113482/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer-field/choices ["q-113482/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" "q-113482/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-113482/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-113482/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" "q-113482/selection/dfd5f31d881889706cf6a223c90e51452850b5a5fea00254db5c20ed13cc8a7f"] :db/ensure [:answer-field/validate]} {:db/id "q-113482" :question/id #uuid "68cd80d2-9b66-50c1-ba50-b4572464ab27" :question/math-academy-id "q-113482" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/4d2dec8a05bc9835693c1df9dbc54618fd39d77667cbbdcd5bb6d92bf25c0d97.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What is the value of $a+b+k?$" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=0.5,$ while the vertical asymptote is $x=3.$ This means that $k=0.5$ and $b=3,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-3}+0.5.\n$$\n\nAlso, we are given that the point $(1,1.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x-3}+0.5 \\\\ 1.5 & =\\frac{a}{1-3}+0.5 \\\\ 1 & =\\frac{a}{-2} \\\\ a & =-2.\\end{aligned}\n$$\n\nFinally, $a+b+k=-2+3+0.5=1.5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113482/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2"] :knowledge-point/questions ["q-113482"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113478/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer/id #uuid "2a18019e-214f-5477-835a-64e32c114c7d" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "q-113478/selection/98825339913b96286f9751ca67affc1b40dbfb36f8a6273cb27701f4b3f223de" :answer/id #uuid "2cd33a71-84fa-5ea4-bfee-feb76b5481f6" :answer/type :answer.type/math :answer/value "-1.5" :db/ensure [:answer/validate]} {:db/id "q-113478/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "2127ed7c-8fe5-5395-9db3-5f4b6d01207c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-113478/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "e4583fd6-6504-5fa8-9281-b9f0165b87af" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-113478/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "8a257671-f05a-5fb5-83cc-592d59e1bafd" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-113478/selection" :answer-field/id #uuid "b59a60ad-efa6-5a68-9197-d1cb9cc79a88" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113478/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-113478/selection/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" "q-113478/selection/98825339913b96286f9751ca67affc1b40dbfb36f8a6273cb27701f4b3f223de" "q-113478/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-113478/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-113478/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c"] :db/ensure [:answer-field/validate]} {:db/id "q-113478" :question/id #uuid "6e98bb28-62ea-5816-b8f2-0d652d8602bf" :question/math-academy-id "q-113478" :question/is-example false :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/4f8e1c3db4120b0fcd8491a850d238b81452fb0294145a2062f96c4655164a04.png)\n\nThe graph represents the function $y=\\frac{a}{x}+k.$ What is the value of $a+k?$" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=-1.5.$ This means that $k=-1.5$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}-1.5.\n$$\n\nAlso, we are given that the point $(1,-2)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}-1.5 \\\\ -2 & =\\frac{a}{1}-1.5 \\\\ -0.5 & =\\frac{a}{1} \\\\ a & =-0.5.\\end{aligned}\n$$\n\nFinally, $a+k=-0.5-1.5=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113478/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2"] :knowledge-point/questions ["q-113478"] :db/ensure [:knowledge-point/validate]}]
