ion-capture/13831126/assets/a32495fcca947d01cf8d3218fc5cfc0cce083a34e6fb6b629d92ba9e47039a6e.png)\n\n- Stretch the result by a scale factor of $\\frac{1}{2}$ parallel to the $y$-axis to get the graph of $y=\\frac{1}{2x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/f3a1cac41b2f9d6773226d76722508e6d7f368a42a0f7e86a5d8407d6f42c149.png)"}] [{:db/id #edb/ref 17592186242280 :knowledge-point/_questions [{:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2" :knowledge-point/title "Solving for Some Unknowns Given the Graph of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0120001-d0e3-55a5-af79-ace7feafebad" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186242282}] :answer-field/correct {:answer/id #uuid "f0120001-d0e3-55a5-af79-ace7feafebad" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186242282} :answer-field/id #uuid "797bf9b8-c3fa-5c42-a54e-147479f1bbd3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242281} {:answer-field/choices [{:answer/id #uuid "fb8976a6-8d64-505c-ad8f-46896b5343f9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186242284}] :answer-field/correct {:answer/id #uuid "fb8976a6-8d64-505c-ad8f-46896b5343f9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186242284} :answer-field/id #uuid "58867d0b-0393-590f-a4ba-338da8517928" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242283}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e0c5ffd4-1bef-580c-b324-7b179c12853b" :question/math-academy-id "q-270750" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/07c9680ad2a94338bcb17c51db591eb4dc76ba483f8613bc105095a37341ebd9.png)\n\nThe graph represents the function $y=\\frac{a}{x}+k.$ What are the values of $a$ and $k?$\n\n$a=$\n{{field-1}},$\\,k=$\n{{field-2}}" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=1.$ This means that $k=1$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x}+1.\n$$\n\nAlso, we are given that the point $(1,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x}+1 \\\\ 3.5 & =\\frac{a}{1}+1 \\\\ 3.5 & =a+1 \\\\ a & =2.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242285 :knowledge-point/_questions [{:knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2" :knowledge-point/title "Solving for Some Unknowns Given the Graph of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14290c82-470a-5fe8-9869-5b8783b9d494" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186242287} {:answer/id #uuid "ddc9c45b-9d58-5a42-bf7a-5091daa99ae7" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186242288}] :answer-field/correct {:answer/id #uuid "ddc9c45b-9d58-5a42-bf7a-5091daa99ae7" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186242288} :answer-field/id #uuid "f5dfb196-08c1-5004-a5e7-1cb3836a384c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242286} {:answer-field/choices [{:answer/id #uuid "dcadc417-5835-5c11-8854-733a7f3a065f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186242290}] :answer-field/correct {:answer/id #uuid "dcadc417-5835-5c11-8854-733a7f3a065f" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186242290} :answer-field/id #uuid "f289a109-e67b-5d9e-9440-cd50903c3947" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242289} {:answer-field/choices [{:answer/id #uuid "13bb8c66-3a63-5164-8386-a9b657887f21" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186242292}] :answer-field/correct {:answer/id #uuid "13bb8c66-3a63-5164-8386-a9b657887f21" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186242292} :answer-field/id #uuid "65f8f3de-51e5-5ae6-9e1f-9ca54c0a22ba" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186242291}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bbc68e4c-6ec2-50b7-92e2-b678df9adbd0" :question/math-academy-id "q-320718" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13831126/assets/c90af67d867e33c847f66721c1abbc6768fbc34e7f39648fbc2e4f486a87ca3f.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What are the values of $a,$ $b,$ and $k?$\n\n$a=$\n{{field-1}},$\\,b=$\n{{field-2}},$\\,k=$\n{{field-3}}" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=2.5,$ while the vertical asymptote is $x=-2.$ This means that $k=2.5$ and $b=-2,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-(-2)}+2.5=\\frac{a}{x+2}+2.5.\n$$\n\nAlso, we are given that the point $(-5,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x+2}+2.5 \\\\ 3.5 & =\\frac{a}{-5+2}+2.5 \\\\ 1 & =\\frac{a}{(-3)} \\\\ a & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186242293 :knowledge-point/_questions [{:knowledge-point/id #uuid "52e11164-1929-594d-9f9e-460f6469421d" :knowledge-point/title "Graphing a Stretched Negative Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d066c0d-f025-51e