[{:db/id "q-17104/selection/1582b19cbd81a42cfa4e86e16fcfaec0db0d3f9a9f84b6b048702df8bb9432ea" :answer/id #uuid "feb40490-f91b-5dd8-b8d8-4540081830d7" :answer/type :answer.type/math :answer/value "-\\frac{2}{15}(4\\sqrt{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-17104/selection/687329d57c9c5d3e6c96d608797030ce4c0ae8b96927c8faeb7e541ae17b3ff7" :answer/id #uuid "ccdb2d42-5dff-5107-a2f2-660c01e0bb6a" :answer/type :answer.type/math :answer/value "\\frac{2}{15}(4\\sqrt{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-17104/selection/1c177b2edcd1da67bcc805cebd94685cde8a5b428e5c89199a3d2df6953e69ea" :answer/id #uuid "493ab798-c608-5ce0-b6ae-8d7af88c0a29" :answer/type :answer.type/math :answer/value "\\frac{2}{15}(2\\sqrt{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-17104/selection/f3fe448dcedbd113b4dfb757a7bcdd3ae42dd0471317f1702343598552ad1ad9" :answer/id #uuid "0215c05a-0a90-5371-96de-47c04fa167cf" :answer/type :answer.type/math :answer/value "\\frac{2}{15}(4\\sqrt{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-17104/selection/9883cead95cf6c45dc8006c06ae037a96bbdae27b21bfb4f0f82c6b56bf2a0a1" :answer/id #uuid "eb93ee76-4fc1-533c-a01e-f760a1fd5516" :answer/type :answer.type/math :answer/value "\\frac{2}{5}(4\\sqrt{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-17104/selection" :answer-field/id #uuid "a3ae8eb0-ef4a-516d-9b95-f6a084061015" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17104/selection/687329d57c9c5d3e6c96d608797030ce4c0ae8b96927c8faeb7e541ae17b3ff7" :answer-field/choices ["q-17104/selection/1582b19cbd81a42cfa4e86e16fcfaec0db0d3f9a9f84b6b048702df8bb9432ea" "q-17104/selection/687329d57c9c5d3e6c96d608797030ce4c0ae8b96927c8faeb7e541ae17b3ff7" "q-17104/selection/1c177b2edcd1da67bcc805cebd94685cde8a5b428e5c89199a3d2df6953e69ea" "q-17104/selection/f3fe448dcedbd113b4dfb757a7bcdd3ae42dd0471317f1702343598552ad1ad9" "q-17104/selection/9883cead95cf6c45dc8006c06ae037a96bbdae27b21bfb4f0f82c6b56bf2a0a1"] :db/ensure [:answer-field/validate]} {:db/id "q-17104" :question/id #uuid "b14d89ff-298c-5727-b59b-2ab6a2f9f8b1" :question/math-academy-id "q-17104" :question/problem "Evaluate the definite integral ${\\int }_{0}^{1}{x}^{2}\\sqrt{{(2-{x}^{3})}^{3}}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =2-{x}^{3} \\\\ \\frac{\\text{d}u}{\\text{d}x} & =-3{x}^{2} \\\\ \\text{d}u & =-3{x}^{2}\\,\\text{d}x \\\\ -\\frac{1}{3}\\text{d}u & ={x}^{2}\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=2-{x}^{3}.$\n\n$$\n\\begin{aligned}x & 0 & 1 \\\\ u & 2 & 1\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\sqrt{{(2-{x}^{3})}^{3}}\\cdot {x}^{2}\\,\\text{d}x={\\int }_{2}^{1}\\sqrt{{u}^{3}}\\cdot (-\\frac{1}{3})\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{2}^{1}\\sqrt{{u}^{3}}\\cdot (-\\frac{1}{3})\\text{d}u & =-\\frac{1}{3}{\\int }_{2}^{1}{u}^{3/2}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\cdot {\\frac{2}{5}{u}^{5/2}|}_{2}^{1} \\\\  & =-\\frac{1}{3}\\cdot \\frac{2}{5}({1}^{5/2}-{2}^{5/2}) \\\\  & =-\\frac{2}{15}(1-({2}^{5})^{1/2}) \\\\  & =-\\frac{2}{15}(1-4\\sqrt{2}) \\\\  & =\\frac{2}{15}(4\\sqrt{2}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-17104/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded"] :knowledge-point/questions ["q-17104"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49610"] :question/problem "Calculate the definite integral ${\\int }_{1}^{2}{(2x+1)}^{2}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =2x+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =2 \\\\ \\text{d}u & =2\\,\\text{d}x \\\\ \\frac{1}{2}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=2x+1.$\n\n$$\n\\begin{aligned}x & 1 & 2 \\\\ u & 3 & 5\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{2}{(2x+1)}^{2}\\,\\text{d}x={\\int }_{3}^{5}{u}^{2}\\cdot \\frac{1}{2}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{5}{u}^{2}\\cdot \\frac{1}{2}\\text{d}u & =\\frac{1}{2}{\\int }_{3}^{5}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\cdot \\frac{1}{3}{u}^{3}|}_{3}^{5} \\\\  & =\\frac{1}{2}\\cdot \\frac{{5}^{3}-{3}^{3}}{3} \\\\  & =\\frac{1}{2}\\cdot \\frac{125-27}{3} \\\\  & =\\frac{98}{6} \\\\  & =\\frac{49}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-113747/selection/1f707b3359a19559d763fd667b4a69c8f0678d7d07d8dfc253ed697010c36a5c" :answer/id #uuid "cd391186-a92c-5592-a01e-2ac9674d2aad" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡(3)}{6}" :db/ensure [:answer/validate]} {:db/id "q-113747/selection/5ab503a6b7e3f39085b45dbf3f781ef3c382619bc98d470fc1cc3232ee9f59a6" :answer/id #uuid "36451327-a9ef-5e0b-b379-afa9bbc0d5c6" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡(4)}{6}" :db/ensure [:answer/validate]} {:db/id "q-113747/selection/00d9dc38af93a193b2b0881f4865aa27a1679c3859cbe74a3aedc2003d701f0b" :answer/id #uuid "81d64b6a-0575-50fd-a192-5c2c079d5521" :answer/type :answer.type/math :answer/value "6\\operatorname{ln}⁡(4)" :db/ensure [:answer/validate]} {:db/id "q-113747/selection/a54b56257a209a88a22694df8952205cc38b6e09433dbd62de63b18e5d051216" :answer/id #uuid "d1b937e7-6ed8-517d-883d-69f66882cbc3" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "q-113747/selection/b7805ccf90968e88122cbc9a478ed999a7ef1dc6d71f89e46b0a447628ab44f5" :answer/id #uuid "8b2914e1-e0ad-5ad3-ae8a-40b1bd98aa60" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(4)" :db/ensure [:answer/validate]} {:db/id "q-113747/selection" :answer-field/id #uuid "cea2d314-383f-5529-b74f-92192f82fead" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113747/selection/5ab503a6b7e3f39085b45dbf3f781ef3c382619bc98d470fc1cc3232ee9f59a6" :answer-field/choices ["q-113747/selection/1f707b3359a19559d763fd667b4a69c8f0678d7d07d8dfc253ed697010c36a5c" "q-113747/selection/5ab503a6b7e3f39085b45dbf3f781ef3c382619bc98d470fc1cc3232ee9f59a6" "q-113747/selection/00d9dc38af93a193b2b0881f4865aa27a1679c3859cbe74a3aedc2003d701f0b" "q-113747/selection/a54b56257a209a88a22694df8952205cc38b6e09433dbd62de63b18e5d051216" "q-113747/selection/b7805ccf90968e88122cbc9a478ed999a7ef1dc6d71f89e46b0a447628ab44f5"] :db/ensure [:answer-field/validate]} {:db/id "q-113747" :question/id #uuid "1d07785f-2249-5bc5-ae8e-305232d37aae" :question/math-academy-id "q-113747" :question/problem "Calculate the definite integral ${\\int }_{0}^{1}\\frac{x}{3{x}^{2}+1}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =3{x}^{2}+1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =6x \\\\ \\text{d}u & =6x\\,\\text{d}x \\\\ \\frac{1}{6}\\,\\text{d}u & =x\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=3{x}^{2}+1.$\n\n$$\n\\begin{aligned}x & 0 & 1 \\\\ u & 1 & 4\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1}\\frac{1}{3{x}^{2}+1}\\cdot x\\,\\text{d}x={\\int }_{1}^{4}\\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{1}{u}\\cdot \\frac{1}{6}\\,\\text{d}u & =\\frac{1}{6}{\\int }_{1}^{4}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡(u){|}_{1}^{4} \\\\  & =\\frac{1}{6}(\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(1)) \\\\  & =\\frac{\\operatorname{ln}⁡(4)}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113747/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074"] :knowledge-point/questions ["q-113747"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336717/field-1/d4c910fdf896d2978344e97f91d0a5a3281be2e54facc94789ede9c31342dfbf" :answer/id #uuid "9ea96751-7e5f-5d66-bba6-e7ea6314d361" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\ln(\\frac{11}{3})" :db/ensure [:answer/validate]} {:db/id "q-336717/field-1/9f9d64db3c4814a6ea7bcb085d63d2fd872f72863dcb664c3ed0335ef058304b" :answer/id #uuid "4288ef09-384f-5c82-b703-b7ade9ade560" :answer/type :answer.type/math :answer/value "\\ln(11)-\\ln(3)" :db/ensure [:answer/validate]} {:db/id "q-336717/field-1" :answer-field/id #uuid "70516474-78a3-5568-be5b-981fce8fd5e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336717/field-1/d4c910fdf896d2978344e97f91d0a5a3281be2e54facc94789ede9c31342dfbf" :answer-field/choices ["q-336717/field-1/d4c910fdf896d2978344e97f91d0a5a3281be2e54facc94789ede9c31342dfbf" "q-336717/field-1/9f9d64db3c4814a6ea7bcb085d63d2fd872f72863dcb664c3ed0335ef058304b"] :db/ensure [:answer-field/validate]} {:db/id "q-336717" :question/id #uuid "c2846528-6193-5bf2-8c43-6a38ee8c80db" :question/math-academy-id "q-336717" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{1}^{3}\\frac{1}{4x-1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =4x-1 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4 \\\\ \\text{d}u & =4\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=4x-1.$\n\n$$\n\\begin{aligned}x & 1 & 3 \\\\ u & 3 & 11\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{3}\\frac{1}{(4x-1)}\\,\\text{d}x={\\int }_{3}^{11}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{11}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{3}^{11}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{3}^{11} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(11)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}ln\\,(\\frac{11}{3}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336717/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074"] :knowledge-point/questions ["q-336717"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336788/field-1/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "b7dfd30d-702d-5cde-94fe-d0d8a7ebceb1" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-336788/field-1" :answer-field/id #uuid "972beb21-214b-5576-b634-c5d8c77cc488" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336788/field-1/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-336788/field-1/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49"] :db/ensure [:answer-field/validate]} {:db/id "q-336788" :question/id #uuid "77fa2bec-a50b-5e14-b7ce-580528c25218" :question/math-academy-id "q-336788" :question/problem "Compute the exact value of the definite integral.\n\n${\\int }_{0}^{1/2}{(4x+2)}^{3}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =4x+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4 \\\\ \\text{d}u & =4\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=4x+2.$\n\n$$\n\\begin{aligned}x & 0 & \\frac{1}{2} \\\\ u & 2 & 4\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{1/2}{(4x+2)}^{3}\\,\\text{d}x={\\int }_{2}^{4}{u}^{3}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}{(4x+2)}^{3}\\,\\text{d}x & ={\\int }_{2}^{4}{u}^{3}\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}{\\int }_{2}^{4}{u}^{3}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot {\\frac{1}{4}{u}^{4}|}_{2}^{4} \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{4}({4}^{4}-{2}^{4}) \\\\  & =\\frac{1}{16}(256-16) \\\\  & =15.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336788/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded"] :knowledge-point/questions ["q-336788"] :db/ensure [:knowledge-point/validate]}]
