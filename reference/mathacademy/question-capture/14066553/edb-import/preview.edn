& =-\\frac{1}{3}\\cdot \\frac{2}{5}({1}^{5/2}-{2}^{5/2}) \\\\  & =-\\frac{2}{15}(1-({2}^{5})^{1/2}) \\\\  & =-\\frac{2}{15}(1-4\\sqrt{2}) \\\\  & =\\frac{2}{15}(4\\sqrt{2}-1).\\end{aligned}\n$$" 13194139535524 true] [17592186353629 1000 #edb/ref 17592186353630 13194139535524 true] [17592186353629 1000 #edb/ref 17592186353631 13194139535524 true] [17592186353629 1000 #edb/ref 17592186353632 13194139535524 true] [17592186353629 1000 #edb/ref 17592186353633 13194139535524 true] [17592186353629 1000 #edb/ref 17592186353634 13194139535524 true] [17592186353629 1040 #edb/ref 17592186045450 13194139535524 true] [17592186353629 1041 "selection" 13194139535524 true] [17592186353629 1104 #edb/ref 17592186353632 13194139535524 true] [17592186353629 1110 #uuid "a3ae8eb0-ef4a-516d-9b95-f6a084061015" 13194139535524 true] [17592186353630 1034 "-\\frac{2}{15}(4\\sqrt{2}-1)" 13194139535524 true] [17592186353630 1103 #edb/ref 17592186045453 13194139535524 true] [17592186353630 1111 #uuid "feb40490-f91b-5dd8-b8d8-4540081830d7" 13194139535524 true] [17592186353631 1034 "\\frac{2}{15}(2\\sqrt{2}-1)" 13194139535524 true] [17592186353631 1103 #edb/ref 17592186045453 13194139535524 true] [17592186353631 1111 #uuid "493ab798-c608-5ce0-b6ae-8d7af88c0a29" 13194139535524 true] [17592186353632 1034 "\\frac{2}{15}(4\\sqrt{2}-1)" 13194139535524 true] [17592186353632 1103 #edb/ref 17592186045453 13194139535524 true] [17592186353632 1111 #uuid "ccdb2d42-5dff-5107-a2f2-660c01e0bb6a" 13194139535524 true] [17592186353633 1034 "\\frac{2}{5}(4\\sqrt{2}-1)" 13194139535524 true] [17592186353633 1103 #edb/ref 17592186045453 13194139535524 true] [17592186353633 1111 #uuid "eb93ee76-4fc1-533c-a01e-f760a1fd5516" 13194139535524 true] [17592186353634 1034 "\\frac{2}{15}(4\\sqrt{2}+1)" 13194139535524 true] [17592186353634 1103 #edb/ref 17592186045453 13194139535524 true] [17592186353634 1111 #uuid "0215c05a-0a90-5371-96de-47c04fa167cf" 13194139535524 true] [17592186353635 1017 #edb/ref 17592186353636 13194139535