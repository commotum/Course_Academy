\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186310175} {:answer/id #uuid "c35c995a-7379-50c3-abde-73d1d455563f" :answer/type {:db/ident :answer.type/math} :answer/value "D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186310176} {:answer/id #uuid "eea79a67-ba5d-50bb-87f0-7ae25345a1c2" :answer/type {:db/ident :answer.type/math} :answer/value "A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186310177} {:answer/id #uuid "61ebcdba-6474-56b2-9ca1-fffb415731fe" :answer/type {:db/ident :answer.type/math} :answer/value "E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186310178} {:answer/id #uuid "6d3af057-d640-5f17-b234-b1e74ea7af98" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186310179}] :answer-field/correct {:answer/id #uuid "6d3af057-d640-5f17-b234-b1e74ea7af98" :answer/type {:db/ident :answer.type/math} :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186310179} :answer-field/id #uuid "a76a1147-d129-5ba9-9c8b-3218c6327cc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310174}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9af406e1-4ead-558e-9219-f0bb53a377fc" :question/math-academy-id "q-74316" :question/problem "Which of the following is a lower triangular matrix?" :question/worked-solution "Notice that $B$ is a matrix for which all entries *above* the diagonal are $0$'s:\n\n$$\nB=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]\n$$\n\nHence, it is a lower triangular matrix. \n\nBy contrast, matrices $A$, $C$, $D$, and $E$ each have at least one non-zero entry above the diagonal:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}],\\,C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}],\\,E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nSo, they are not lower triangular matrices."}] [{:db/id #edb/ref 17592186382838 :knowledge-point/_questions [{:knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a59e0e8e-177b-579d-a601-a046bcfab3b1" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382840} {:answer/id #uuid "37e42509-d7fe-525f-8e9d-40a281c6a163" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382841} {:answer/id #uuid "b47d86d8-b996-5f93-9d7d-f3de3fc8dc6e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382842} {:answer/id #uuid "5bc31d04-bde6-585b-aa28-f266b85f9e1c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382843} {:answer/id #uuid "d937b010-0a72-5665-8c64-64a033d381d1" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382844}] :answer-field/correct {:answer/id #uuid "a59e0e8e-177b-579d-a601-a046bcfab3b1" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382840} :answer-field/id #uuid "e5619de8-db8d-5149-b364-38ab97aa563c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382839}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cac8c51f-40c1-5b24-8939-c603aa9dc3ea" :question/math-academy-id "q-74319" :question/problem "Consider the matrix \n$D=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}].$\nWhich of the following statements are true?\n\n- $D$ is upper triangular\n- $D$ is lower triangular\n- ${D}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false, since $D$ has non-zero entries below the main diagonal:\n\n$$\nD=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}]\n$$\n\n- Statement II is true. All the entries above the main diagonal of $D$ are zeros:\n\n$$\nD=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}]\n$$\n\n- Statement III is true. All the entries below the main diagonal of ${D}^{T}$ are zeros:\n\n$$\n{D}^{T}=[\\begin{aligned}3 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"II and III only\"."}]}
