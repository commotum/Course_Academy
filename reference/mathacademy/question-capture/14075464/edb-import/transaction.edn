6342/selection/737ed29dfe85abe89843c2e0e81c86e7e8aabd9ae79ced44e8547ea03ce61f3c" "q-126342/selection/72c8da463af6b15a1f1b54b5381af76812080197a244de6fb4f98091599fabbf" "q-126342/selection/06285049f72ef30fee6ef6292e1826eabf19578fd3f3da4353e2d47878d19d9f"] :db/ensure [:answer-field/validate]} {:db/id "q-126342" :question/id #uuid "7e0ae1a7-d37b-5c56-b70b-849175c97c12" :question/math-academy-id "q-126342" :question/problem "How can we best describe the following matrix? \n\n$$\nC=[\\begin{aligned}2 & 1 \\\\ 0 & -4\\end{aligned}]\n$$" :question/worked-solution "Notice that $C$ is a matrix for which all entries below the diagonal are $0$'s:\n\n$$\nC=[\\begin{aligned}2 & 1 \\\\ 0 & -4\\end{aligned}]\n$$\n\nTherefore, it is an upper triangular matrix.\n\nIt is not a lower triangular matrix or a diagonal matrix since there is a non-zero element above the diagonal: ${c}_{12}=1\\ne 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126342/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff"] :knowledge-point/questions ["q-126342"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126352/selection/bb398ce695ecd9e40c4bfc1c8b82664fe19731cab01c293a4264731f946002b6" :answer/id #uuid "4db657c0-6802-5830-8da9-41b5cb9a5db7" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}0 & -1 \\\\ 5 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-126352/selection/f620e1d7c375b9b009cf3784447dce17178a98fe6ae28158e0c0f418321e5abe" :answer/id #uuid "4fd92f11-ddca-59b6-80a7-01d7e8969599" :answer/type :answer.type/math :answer/value "B=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-126352/selection/e75524d535cccab910f507fef2ecfc027d4f4513410d7842cf250b398fafedd2" :answer/id #uuid "621da94f-244a-550e-a0c9-7c63aa7c796b" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-126352/selection/0a8673f5f5a5da453638fdb733ceb7e1ae9ea5644ce94a9e052e6101c32e5117" :answer/id #uuid "938b0f8f-2c07-504a-91ac-eba22105ddbe" :answer/type :answer.type/math :answer/value "A=[\\begin{aligned}4 & 0 \\\\ 1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-126352/selection/74cfe2d5609f617ee65bb285fd3d06d3f913bdd6c78d8f801c7ec3ecf31e2c04" :answer/id #uuid "00ead7cc-e5b5-58c6-8d80-9b9234bc6e05" :answer/type :answer.type/math :answer/value "E=[\\begin{aligned}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-126352/selection" :answer-field/id #uuid "9c82e418-eee7-55cc-8944-b47e0ba42402" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126352/selection/e75524d535cccab910f507fef2ecfc027d4f4513410d7842cf250b398fafedd2" :answer-field/choices ["q-126352/selection/bb398ce695ecd9e40c4bfc1c8b82664fe19731cab01c293a4264731f946002b6" "q-126352/selection/f620e1d7c375b9b009cf3784447dce17178a98fe6ae28158e0c0f418321e5abe" "q-126352/selection/e75524d535cccab910f507fef2ecfc027d4f4513410d7842cf250b398fafedd2" "q-126352/selection/0a8673f5f5a5da453638fdb733ceb7e1ae9ea5644ce94a9e052e6101c32e5117" "q-126352/selection/74cfe2d5609f617ee65bb285fd3d06d3f913bdd6c78d8f801c7ec3ecf31e2c04"] :db/ensure [:answer-field/validate]} {:db/id "q-126352" :question/id #uuid "3cca3ca2-ad9e-5a68-b3d3-231d7c0b3f2b" :question/math-academy-id "q-126352" :question/problem "Which of the following is an upper triangular matrix?" :question/worked-solution "Notice that $D$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nD=[\\begin{aligned}-2 & 6 & 0 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 2\\end{aligned}]\n$$\n\nHence, it is an upper triangular matrix. \n\nBy contrast, matrices $A$, $B$, $C$, and $E$ each have at least one non-zero entry below the diagonal:\n\n$$\nA=[\\begin{aligned}4 & 0 \\\\ 1 & 1\\end{aligned}],\\,B=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 2 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}0 & -1 \\\\ 5 & 1\\end{aligned}],\\,E=[\\begin{aligned}-1 & 4 & 0 \\\\ 3 & 0 & 2 \\\\ 4 & 0 & 2\\end{aligned}].\n$$\n\nSo, they are not upper triangular matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126352/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc"] :knowledge-point/questions ["q-126352"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-42090"] :question/problem "Which of the following matrices are upper triangular matrices?\n\n$A=[\\begin{aligned}8 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & -4 & 5 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 6 \\\\ 0 & -1 & 3 \\\\ 5 & 7 & 11\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 0\\end{aligned}].$" :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =5\\ne 0 \\\\ {c}_{32} & =3\\ne 0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-126351/selection/919ac3c0ef2fc4b230d640dfe7555e9ba16555419592e543018e02919c52ff4b" :answer/id #uuid "b647786d-9d31-5477-9cfc-f7e5838d972c" :answer/type :answer.type/text :answer/value "$A$, $B$, and $C$" :db/ensure [:answer/validate]} {:db/id "q-126351/selection/2377e3ffc3b5cd65e1036103e0b988e5af6634b2438c63c3b7cc0592571401ab" :answer/id #uuid "eda78f6b-3a7d-5366-8e9e-1f9faa88236c" :answer/type :answer.type/text :answer/value "$A$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "q-126351/selection/e956c3af673c94782038951d8de50bf89c9a53bf4daf2ca6725a4bea4229074c" :answer/id #uuid "a52954b6-41ab-5cee-97b7-fc