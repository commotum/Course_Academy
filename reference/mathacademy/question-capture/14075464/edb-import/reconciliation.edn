ces." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/state.json" "file_sha256" "dff7fd68dacf0f385d9535782d42479a0e621010e338f5467a2c36beed07ea6b" "basis" 1474 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/edb-import/verification.json"} {"question" "q-13760" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/activity-metadata.json" "file_sha256" "e19286e95f853a52e485f58892f46cde64ab59c39f32da645ff03f5e3084e006" "basis" 1474 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/edb-import/verification.json"} {"question" "q-13760" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/state.json" "file_sha256" "dff7fd68dacf0f385d9535782d42479a0e621010e338f5467a2c36beed07ea6b" "basis" 1474 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/edb-import/verification.json"} {"question" "q-13760" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "A=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 2 & 3 \\\\ 0 & 0 & 0\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/state.json" "file_sha256" "dff7fd68dacf0f385d9535782d42479a0e621010e338f5467a2c36beed07ea6b" "basis" 1474 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14040926/edb-import/verification.json"} {"question" "q-13760" "field" "selection" "attribute" "answer/value" 