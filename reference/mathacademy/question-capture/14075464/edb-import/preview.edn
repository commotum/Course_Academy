82807 13194139536084 true] [17592186382804 1000 #edb/ref 17592186382808 13194139536084 true] [17592186382804 1000 #edb/ref 17592186382809 13194139536084 true] [17592186382804 1040 #edb/ref 17592186045450 13194139536084 true] [17592186382804 1041 "selection" 13194139536084 true] [17592186382804 1104 #edb/ref 17592186382807 13194139536084 true] [17592186382804 1110 #uuid "88e773c8-4076-5d11-b4d4-a49a4229cb82" 13194139536084 true] [17592186382805 1034 "$A$ and $C$ only" 13194139536084 true] [17592186382805 1103 #edb/ref 17592186045454 13194139536084 true] [17592186382805 1111 #uuid "eda78f6b-3a7d-5366-8e9e-1f9faa88236c" 13194139536084 true] [17592186382806 1034 "$A$, $B$, and $C$" 13194139536084 true] [17592186382806 1103 #edb/ref 17592186045454 13194139536084 true] [17592186382806 1111 #uuid "b647786d-9d31-5477-9cfc-f7e5838d972c" 13194139536084 true] [17592186382807 1034 "$A$ and $B$ only" 13194139536084 true] [17592186382807 1103 #edb/ref 17592186045454 13194139536084 true] [17592186382807 1111 #uuid "2494b0ea-1a3d-51bd-a30c-f9f3fe8101a3" 13194139536084 true] [17592186382808 1034 "$C$ only" 13194139536084 true] [17592186382808 1103 #edb/ref 17592186045454 13194139536084 true] [17592186382808 1111 #uuid "bec23df0-1c46-5546-98ec-caa0c70223ce" 13194139536084 true] [17592186382809 1034 "$B$ only" 13194139536084 true] [17592186382809 1103 #edb/ref 17592186045454 13194139536084 true] [17592186382809 1111 #uuid "a52954b6-41ab-5cee-97b7-fc8482f2960e" 13194139536084 true] [17592186382810 1017 #edb/ref 17592186382811 13194139536084 true] [17592186382810 1089 "q-126352" 13194139536084 true] [17592186382810 1091 #edb/ref 17592186045463 13194139536084 true] [17592186382810 1100 "Which of the following is an upper triangular matrix?" 13194139536084 true] [17592186382810 1113 #uuid "3cca3ca2-ad9e-5a68-b3d3-231d7c0b3f2b" 13194139536084 true] [17592186382810 1145 "Notice that $D$ is a matrix for which all entries *below* the diagonal are $0$'s:\n\n$$\nD=[\\begin{aligned}-2 & 6 & 0 \\