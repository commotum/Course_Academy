math} :answer/value "-2" :db/id #edb/ref 17592186336535} {:answer/id #uuid "589c5620-d46d-5183-8359-a008cd7a3a3c" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186336536}] :answer-field/correct {:answer/id #uuid "03b603af-12f4-59db-a7d3-a99f86e9ce26" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336533} :answer-field/id #uuid "1da1d1b3-3abd-5982-a4ce-de54ef5a7583" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336531}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "209d8d0b-5f16-5023-9c47-f445a99d48ed" :question/math-academy-id "q-47388" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057748/assets/1534153e6a5d79400a038849b48583d2ec9a62db1fc1f52a491b751e46861f51.png)\n\nThe graph of the function $y=g(x)$ is shown above. \nApproximate ${g}^{′}(x)$ at the point $x=0$ using a forward difference approximation with step size $h=2.$" :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\n \nat the point $x=0.$ Applying the above formula with $x=0$ and $h=2$ gives\n\n$$\n\\begin{aligned}{g}^{′}(0) & ≈\\frac{g(0+2)-g(0)}{2} \\\\  & =\\frac{g(2)-g(0)}{2} \\\\  & =\\frac{4-10}{2} \\\\  & =\\frac{-6}{2} \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336537 :knowledge-point/_questions [{:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2" :knowledge-point/title "Estimating a Derivative From a Table Using a Forward Difference Approximation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b74b69f-0c88-5cea-81da-b20f3f32ff23" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186336539} {:answer/id #uuid "1ae7037c-3031-5afb-82bd-8efaf834f7ae" :answer/type {:db/ident :answer.type/math} :answer/value "-4.25" :db/id #edb/ref 17592186336540} {:answer/id #uuid "6cde244a-1c70-5ca9-b4cf-a4ba4112436c" :answer/type {:db/ident :answer.type/math} :answer/value "-3.25" :db/id #edb/ref 17592186336541} {:answer/id #uuid "7c378174-ec61-59d0-828a-adfc199c407c" :answer/type {:db/ident :answer.type/math} :answer/value "1.25" :db/id #edb/ref 17592186336542} {:answer/id #uuid "5017a2d8-8924-5d34-9e82-3fe983a8b6b9" :answer/type {:db/ident :answer.type/math} :answer/value "-1.75" :db/id #edb/ref 17592186336543}] :answer-field/correct {:answer/id #uuid "6cde244a-1c70-5ca9-b4cf-a4ba4112436c" :answer/type {:db/ident :answer.type/math} :answer/value "-3.25" :db/id #edb/ref 17592186336541} :answer-field/id #uuid "db96c6c4-60e3-5021-b639-e902a5103e14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336538}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0e5d4310-2487-5d7a-87eb-f4204f832e6e" :question/math-academy-id "q-71912" :question/problem "A function $g(x)$ has values according to the table below:\n\n| $x$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $7.25$ | $8.5$ | $9.25$ | $5.75$ | $2.5$ |\n\nApproximate ${g}^{′}(x)$ at the point $x=3$ using a forward difference approximation." :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\nat the point $x=3.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives \n\n$$\n\\begin{aligned}{g}^{′}(3) & ≈\\frac{g(3+1)-g(3)}{1} \\\\  & =\\frac{g(4)-g(3)}{1} \\\\  & =2.5-5.75 \\\\  & =-3.25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336544 :knowledge-point/_questions [{:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2" :knowledge-point/title "Estimating a Derivative From a Table Using a Forward Difference Approximation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69555b09-e84a-59b2-b3f8-b3d00b8812bd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336546} {:answer/id #uuid "7af0ebb2-8e66-5ad1-965a-fd40e6f23e5d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186336547} {:answer/id #uuid "bfdabe31-6e08-5e76-aabb-d7dc70c886c1" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336548} {:answer/id #uuid "6dc37773-4579-5f50-a702-54b43e1d0846" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336549} {:answer/id #uuid "25876d32-446f-5a71-8535-53d3f7ca2352" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336550}] :answer-field/correct {:answer/id #uuid "7af0ebb2-8e66-5ad1-965a-fd40e6f23e5d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186336547} :answer-field/id #uuid "9333348c-475b-571d-9536-38d469c746b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336545}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fe76ffe7-ef96-543e-9667-2b778caf61a9" :question/math-academy-id "q-71915" :question/problem "A function $p(t)$ has values according to the table below:\n\n| $t$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $p(t)$ | $3$ | $6$ | $9$ | $5$ | $1$ | $0$ |\n\nApproximate ${p}^{′}(t)$ at the point $t=0$ using a forward difference approximation." :question/worked-solution "We use the forward difference approximation\n\n$$\n{p}^{′}(t)≈\\frac{p(t+h)-p(t)}{h}\n$$\n\nat the point $t=0.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives \n\n$$\n\\begin{aligned}{p}^{′}(0) & ≈\\frac{p(0+1)-p(0)}{1} \\\\  & =\\frac{p(1)-p(0)}{1} \\\\  & =5-9 \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336551 :knowledge-point/_questions [{:knowledge-point/id #uuid "419134c3-3177-5d7d-86f6-899a73338b1c" :knowledge-point/title "Estimating a Derivative From a Graph Using a Forward Difference Approximation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "788acd1e-84b4-501d-9ee6-52aa2b57ebcb" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336553} {:answer/id #uuid "e794dc8d-4072-5eab-8966-3de90bc88464" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336554} {:answer/id #uuid "cee8e4b7-704d-5ff9-9437-c5b2f3bec7d2" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336555} {:answer/id #uuid "3ce79765-4084-563c-9a46-7148b3cd0a99" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336556} {:answer/id #uuid "e719a2e7-c5ae-5dc9-aef3-295b63c948b7" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336557}] :answer-field/correct {:answer/id #uuid "e794dc8d-4072-5eab-8966-3de90bc88464" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336554} :answer-field/id #uuid "af88f56b-3ca8-5446-b543-beff3e762b9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336552}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c564913f-5042-5714-bdab-bf4704f2c3fc" :question/math-academy-id "q-71921" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057748/assets/21e310adffbad6309176ea26549e0e43efe3d8e3d7f2f0b018902be16781802d.png)\n\nThe graph of the function $y=g(x)$ is shown above. Approximate ${g}^{′}(x)$ at the point $x=1.5$ using a forward difference approximation with step size $h=1.$" :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\n \nat the point $x=1.5.$ Applying the above formula with $x=1.5$ and $h=1$ gives\n\n$$\n\\begin{aligned}{g}^{′}(1.5) & ≈\\frac{g(1.5+1)-g(1.5)}{1} \\\\  & =\\frac{g(2.5)-g(1.5)}{1} \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186336558 :knowledge-point/_questions [{:knowledge-point/id #uuid "5e651cb4-ae24-5ac7-9c01-d90de562b155" :knowledge-point/title "Estimating a Derivative From a Table Using a Forward Difference Approximation: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdc19acb-e216-5b95-8e16-d824106d1c77" :answer/type {:db/ident :answer.type/text} :answer/value "$38$ eggs per day" :db/id #edb/ref 17592186336560} {:answer/id #uuid "b7ac46d4-8131-5c08-a12d-cb02a4370dff" :answer/type {:db/ident :answer.type/text} :answer/value "$27$ eggs per day" :db/id #edb/ref 17592186336561} {:answer/id #uuid "2644bfd1-3e41-5e9e-bd5f-d3d0f0396273" :answer/type {:db/ident :answer.type/text} :answer/value "$45$ eggs per day" :db/id #edb/ref 17592186336562} {:answer/id #uuid "9a0cebb3-43c1-5e78-9114-f9d0b18087a3" :answer/type {:db/ident :answer.type/text} :answer/value "$43$ eggs per day" :db/id #edb/ref 17592186336563} {:answer/id #uuid "c394eb42-685b-5eaf-a02e-adebe4bdc3f6" :answer/type {:db/ident :answer.type/text} :answer/value "$32$ eggs per day" :db/id #edb/ref 17592186336564}] :answer-field/correct {:answer/id #uuid "9a0cebb3-43c1-5e78-9114-f9d0b18087a3" :answer/type {:db/ident :answer.type/text} :answer/value "$43$ eggs per day" :db/id #edb/ref 17592186336563} :answer-field/id #uuid "26f24659-ac60-59c1-b329-93f9a812b7f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186336559}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "eb0fa8c3-bd0e-5154-8c3c-3cb2dfba2a12" :question/math-academy-id "q-71925" :question/problem "The total number of eggs laid by a pen of chickens on a farm is given by the function $e(t),$ where $t$ is the number of days since the chickens arrived on the farm. The values of $e(t)$ for different values of $t$ are given in the table below:\n\n| $t$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $e(t)$ | $20$ | $45$ | $77$ | $117$ | $160$ | $195$ |\n\nApproximate the rate at which eggs are laid at the $4$th day using a forward difference approximation." :question/worked-solution "We use the forward difference approximation\n\n$$\n{e}^{′}(t)≈\\frac{e(t+h)-e(t)}{h}\n$$\n\n \nat the point $t=4.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives\n\n$$\n\\begin{aligned}{e}^{′}(4) & ≈\\frac{e(4+1)-e(4)}{1} \\\\  & =\\frac{e(5)-e(4)}{1} \\\\  & =\\frac{160-117}{1} \\\\  & =\\frac{43}{1} \\\\  & =43.\\end{aligned}\n$$\n\nSo at $t=4$ the rate at which eggs are laid is approximately $43$ eggs per day."}]}
