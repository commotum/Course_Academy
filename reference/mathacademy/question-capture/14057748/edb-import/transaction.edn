[{:db/id "q-71915/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6dc37773-4579-5f50-a702-54b43e1d0846" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-71915/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "69555b09-e84a-59b2-b3f8-b3d00b8812bd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-71915/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "7af0ebb2-8e66-5ad1-965a-fd40e6f23e5d" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-71915/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "25876d32-446f-5a71-8535-53d3f7ca2352" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-71915/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "bfdabe31-6e08-5e76-aabb-d7dc70c886c1" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-71915/selection" :answer-field/id #uuid "9333348c-475b-571d-9536-38d469c746b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71915/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-71915/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-71915/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-71915/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-71915/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-71915/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-71915" :question/id #uuid "fe76ffe7-ef96-543e-9667-2b778caf61a9" :question/math-academy-id "q-71915" :question/problem "A function $p(t)$ has values according to the table below:\n\n| $t$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $p(t)$ | $3$ | $6$ | $9$ | $5$ | $1$ | $0$ |\n\nApproximate ${p}^{′}(t)$ at the point $t=0$ using a forward difference approximation." :question/worked-solution "We use the forward difference approximation\n\n$$\n{p}^{′}(t)≈\\frac{p(t+h)-p(t)}{h}\n$$\n\nat the point $t=0.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives \n\n$$\n\\begin{aligned}{p}^{′}(0) & ≈\\frac{p(0+1)-p(0)}{1} \\\\  & =\\frac{p(1)-p(0)}{1} \\\\  & =5-9 \\\\  & =-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71915/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2"] :knowledge-point/questions ["q-71915"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342003/field-1/800dbffbdda5ce97831ade7e5e6c9f6e5e28b6d2149e4a3ae6905f42949ec499" :answer/id #uuid "4b8265b8-d983-5ed0-bc43-002b30c154f9" :answer/type :answer.type/math :answer/value "-1.21" :db/ensure [:answer/validate]} {:db/id "q-342003/field-1" :answer-field/id #uuid "1c0ee1a1-21fb-578f-afca-2b23263b2356" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342003/field-1/800dbffbdda5ce97831ade7e5e6c9f6e5e28b6d2149e4a3ae6905f42949ec499" :answer-field/choices ["q-342003/field-1/800dbffbdda5ce97831ade7e5e6c9f6e5e28b6d2149e4a3ae6905f42949ec499"] :db/ensure [:answer-field/validate]} {:db/id "q-342003" :question/id #uuid "8b775af5-e0be-50b8-a8d6-c6f7547ce3b3" :question/math-academy-id "q-342003" :question/problem "A function $d(y)$ has values according to the table below:\n\n| $y$ | $-5$ | $-3$ | $-1$ | $1$ | $3$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $d(y)$ | $-8.92$ | $-11.34$ | $-15.23$ | $-17.56$ | $-18.21$ | $-18.50$ |\n\nApproximate ${d}^{′}(y)$ at the point $y=-5$ using a forward difference approximation. Do not round the answer.\n\n${d}^{′}(-5)≈$\n{{field-1}}" :question/worked-solution "We use the forward difference approximation\n\n$$\n{d}^{′}(y)≈\\frac{d(y+h)-d(y)}{h}\n$$\n\nat the point $y=-5.$ We choose the step size $h$ to be as small as possible, in this case $h=2.$ This gives \n\n$$\n\\begin{aligned}{d}^{′}(-5) & ≈\\frac{d(-5+2)-d(-5)}{2} \\\\  & =\\frac{d(-3)-d(-5)}{2} \\\\  & =\\frac{-11.34-(-8.92)}{2} \\\\  & =\\frac{-2.42}{2} \\\\  & =-1.21.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342003/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2"] :knowledge-point/questions ["q-342003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341994/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "fbdbd2f5-dc18-51c7-bf03-c9416c70d648" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-341994/field-1/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11" :answer/id #uuid "de5c37d3-ec60-55e8-99d0-3c3c22a5d090" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "q-341994/field-1" :answer-field/id #uuid "16a8f30e-e511-558a-8e0a-3dc280f5acd3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341994/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-341994/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-341994/field-1/9b32bd1c2d85515eb67bf6ed1aa42ff7a66b88544eaafce7b11ad994fbde1d11"] :db/ensure [:answer-field/validate]} {:db/id "q-341994" :question/id #uuid "f572f1e1-b5c8-5dc8-920b-f57ce4ebd415" :question/math-academy-id "q-341994" :question/problem "A function $g(x)$ has values according to the table below:\n\n| $x$ | $0$ | $0.3$ | $0.6$ | $0.9$ | $1.2$ |\n| --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-2.7$ | $-1.6$ | $-0.4$ | $1.1$ | $3.7$ |\n\nApproximate ${g}^{′}(x)$ at the point $x=0.6$ using a forward difference approximation. Do not round the answer.\n\n${g}^{′}(0.6)≈$\n{{field-1}}" :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\nat the point $x=0.6.$ We choose the step size $h$ to be as small as possible, in this case $h=0.3.$ This gives \n\n$$\n\\begin{aligned}{g}^{′}(0.6) & ≈\\frac{g(0.6+0.3)-g(0.6)}{0.3} \\\\  & =\\frac{g(0.9)-g(0.6)}{0.3} \\\\  & =\\frac{1.1-(-0.4)}{0.3} \\\\  & =\\frac{1.5}{0.3} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341994/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2"] :knowledge-point/questions ["q-341994"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341996/field-1/c2ec7d83bd2abf852a282dd8ec132009b07df4db2fc4a8535ae9d620bcbab6e5" :answer/id #uuid "8c3ef3de-b9a8-5700-a3c5-bc3c04dd32a7" :answer/type :answer.type/math :answer/value "-1.05" :db/ensure [:answer/validate]} {:db/id "q-341996/field-1" :answer-field/id #uuid "f9100525-5208-51f6-afb2-5e3a7429aa6c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341996/field-1/c2ec7d83bd2abf852a282dd8ec132009b07df4db2fc4a8535ae9d620bcbab6e5" :answer-field/choices ["q-341996/field-1/c2ec7d83bd2abf852a282dd8ec132009b07df4db2fc4a8535ae9d620bcbab6e5"] :db/ensure [:answer-field/validate]} {:db/id "q-341996" :question/id #uuid "c1e3efff-e4fc-5ebb-adad-78ad4184693c" :question/math-academy-id "q-341996" :question/problem "A function $g(x)$ has values according to the table below:\n\n| $x$ | $-2$ | $0$ | $2$ | $4$ | $6$ | $8$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $20.4$ | $18.6$ | $16.5$ | $14.4$ | $12.3$ | $10.8$ |\n\nApproximate ${g}^{′}(x)$ at the point $x=2$ using a forward difference approximation. Do not round the answer.\n\n${g}^{′}(2)≈$\n{{field-1}}" :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\nat the point $x=2.$ We choose the step size $h$ to be as small as possible, in this case $h=2.$ This gives \n\n$$\n\\begin{aligned}{g}^{′}(2) & ≈\\frac{g(2+2)-g(2)}{2} \\\\  & =\\frac{g(4)-g(2)}{2} \\\\  & =\\frac{14.4-16.5}{2} \\\\  & =\\frac{-2.1}{2} \\\\  & =-1.05.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341996/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2"] :knowledge-point/questions ["q-341996"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71912/selection/2b254dc3e9f062fe2dc84750922b6543460981e0404d4bd80e95bf6d3f2b24b9" :answer/id #uuid "6cde244a-1c70-5ca9-b4cf-a4ba4112436c" :answer/type :answer.type/math :answer/value "-3.25" :db/ensure [:answer/validate]} {:db/id "q-71912/selection/82c06270a9acd7d2cccf259d262fdfacdb0b322c73eeaa437f1cf50ba1ae5775" :answer/id #uuid "5017a2d8-8924-5d34-9e82-3fe983a8b6b9" :answer/type :answer.type/math :answer/value "-1.75" :db/ensure [:answer/validate]} {:db/id "q-71912/selection/1c6d8bfd6542f9db699cf171d038785ba03d1ce6e62b30cc130f14cfbe2b1c77" :answer/id #uuid "1ae7037c-3031-5afb-82bd-8efaf834f7ae" :answer/type :answer.type/math :answer/value "-4.25" :db/ensure [:answer/validate]} {:db/id "q-71912/selection/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer/id #uuid "9b74b69f-0c88-5cea-81da-b20f3f32ff23" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "q-71912/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" :answer/id #uuid "7c378174-ec61-59d0-828a-adfc199c407c" :answer/type :answer.type/math :answer/value "1.25" :db/ensure [:answer/validate]} {:db/id "q-71912/selection" :answer-field/id #uuid "db96c6c4-60e3-5021-b639-e902a5103e14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71912/selection/2b254dc3e9f062fe2dc84750922b6543460981e0404d4bd80e95bf6d3f2b24b9" :answer-field/choices ["q-71912/selection/2b254dc3e9f062fe2dc84750922b6543460981e0404d4bd80e95bf6d3f2b24b9" "q-71912/selection/82c06270a9acd7d2cccf259d262fdfacdb0b322c73eeaa437f1cf50ba1ae5775" "q-71912/selection/1c6d8bfd6542f9db699cf171d038785ba03d1ce6e62b30cc130f14cfbe2b1c77" "q-71912/selection/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" "q-71912/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f"] :db/ensure [:answer-field/validate]} {:db/id "q-71912" :question/id #uuid "0e5d4310-2487-5d7a-87eb-f4204f832e6e" :question/math-academy-id "q-71912" :question/problem "A function $g(x)$ has values according to the table below:\n\n| $x$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $7.25$ | $8.5$ | $9.25$ | $5.75$ | $2.5$ |\n\nApproximate ${g}^{′}(x)$ at the point $x=3$ using a forward difference approximation." :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\nat the point $x=3.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives \n\n$$\n\\begin{aligned}{g}^{′}(3) & ≈\\frac{g(3+1)-g(3)}{1} \\\\  & =\\frac{g(4)-g(3)}{1} \\\\  & =2.5-5.75 \\\\  & =-3.25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71912/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2"] :knowledge-point/questions ["q-71912"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71921/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "788acd1e-84b4-501d-9ee6-52aa2b57ebcb" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/val