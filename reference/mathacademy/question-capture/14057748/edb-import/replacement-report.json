      "source": [
        {
          "question": "q-47380",
          "field": null,
          "attribute": "question/problem",
          "value": "The function $g(s)$ describes the amount of fuel, in liters, remaining in Samuel's car after driving $s$ miles. The values of $g(s)$ for different values of $s$ are given in the table below:\n\n| $s$ | $0$ | $2$ | $4$ | $6$ | $8$ | $10$ | $12$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $g(s)$ | $15$ | $13.5$ | $12.1$ | $9.4$ | $8.2$ | $6.6$ | $4.8$ |\n\nApproximate the rate of change in the fuel volume when $s=8$ miles using a forward difference approximation.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14057748/state.json",
          "file_sha256": "b1b53e298b7988267f7d0c5f1afaa4cc3e6ddc5d21133838fc130bd483344397"
        }
      ],
