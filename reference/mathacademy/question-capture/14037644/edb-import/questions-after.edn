#{[{:db/id #edb/ref 17592186296969 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6912ce27-4c2c-5659-8670-f0090b9c8481" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296971} {:answer/id #uuid "dc4eb2a6-0cf2-5ace-937d-557ac82e8807" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296972} {:answer/id #uuid "dfde804a-a975-53cd-a2c3-51f3c256f823" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296973} {:answer/id #uuid "41a3d2e2-f9b1-5b0f-a8af-59094f708166" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296974} {:answer/id #uuid "474b4769-44a8-5d13-8bcc-2189d784e468" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186296975}] :answer-field/correct {:answer/id #uuid "dc4eb2a6-0cf2-5ace-937d-557ac82e8807" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296972} :answer-field/id #uuid "3f3c1864-e7d4-5c97-bc7b-6f2ba2494195" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296970}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "73ee2d87-104f-5b41-bbb8-604f1e3cba8e" :question/math-academy-id "q-134156" :question/problem "Consider the following data sets:\n\n$$\nx={6,\\,4,\\,6,\\,8},\\,y={3,\\,4,\\,5,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=5.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-6)(3-5)+(4-6)(4-5)+(6-6)(5-5)+(8-6)(8-5)] \\\\  & =\\frac{1}{4}[(0)(-2)+(-2)(-1)+(0)(0)+(2)(3)] \\\\  & =\\frac{1}{4}[0+2+0+6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296976 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4cc824f-4c5a-58f2-8722-487fd8b0a394" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186296978} {:answer/id #uuid "8455dbb6-2eda-5055-929b-0bb78308c608" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186296979} {:answer/id #uuid "2eaf9693-2f72-5292-aada-cc1788c3d28b" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296980} {:answer/id #uuid "38ea8140-c0fb-56bc-a18c-80ee154525ea" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296981} {:answer/id #uuid "10cb9f08-9c8f-5d86-8420-98e257eaed50" :answer/type {:db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186296982}] :answer-field/correct {:answer/id #uuid "8455dbb6-2eda-5055-929b-0bb78308c608" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186296979} :answer-field/id #uuid "79e46315-c012-5187-bb42-4e4e41818517" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296977}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8c9a493b-3f80-5d85-8627-a0cfaf455ca6" :question/math-academy-id "q-134165" :question/problem "Consider the following data sets:\n\n$$\nx={1,\\,4,\\,7,\\,12},\\,y={2,\\,4,\\,2,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=6$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(1-6)(2-4)+(4-6)(4-4)+(7-6)(2-4)+(12-6)(8-4)] \\\\  & =\\frac{1}{4}[(-5)(-2)+(-2)(0)+(1)(-2)+(6)(4)] \\\\  & =\\frac{1}{4}[10+0-2+24] \\\\  & =\\frac{1}{4}\\cdot 32 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296983 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7859dddb-5f35-54e6-838d-fd8f46505934" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186296985} {:answer/id #uuid "4a059e6e-e0a2-51e0-8c7a-7f5e012a0b4e" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296986} {:answer/id #uuid "30c09cda-58cd-506d-bf61-6768b2fee2f2" :answer/type {:db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186296987} {:answer/id #uuid "725431a9-e973-5172-a01e-72e17b2a61e9" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186296988} {:answer/id #uuid "cff689ec-4973-5191-b599-d6fa9b5f3593" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186296989}] :answer-field/correct {:answer/id #uuid "725431a9-e973-5172-a01e-72e17b2a61e9" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186296988} :answer-field/id #uuid "2886bb9c-3683-575b-a4a5-510e7a201322" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296984}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7661bdb4-4f12-5271-b8d5-fdde69eee899" :question/math-academy-id "q-134168" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={-4,\\,2,\\,6,\\,8},\\,y={2,\\,-9,\\,3,\\,12}\n$$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-4)+2+6+8) \\\\  & =\\frac{1}{4}\\cdot 12 \\\\  & =3 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (2+(-9)+3+12) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-4-3)(2-2)+(2-3)(-9-2)+(6-3)(3-2)+(8-3)(12-2)] \\\\  & =\\frac{1}{4}[(-7)(0)+(-1)(-11)+(3)(1)+(5)(10)] \\\\  & =\\frac{1}{4}[0+11+3+50] \\\\  & =\\frac{1}{4}\\cdot 64 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296990 :knowledge-point/_questions [{:knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeeb51d7-57c5-5560-b35e-5bf0fb2a4e34" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296992} {:answer/id #uuid "96f0ac24-be31-5e28-bdb0-42230ce81ebc" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296993} {:answer/id #uuid "d534c4fa-3764-537c-9b1c-fde6b7be7f41" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296994} {:answer/id #uuid "bb3d0eb4-9621-5733-9e0b-1b60594abf48" :answer/type {:db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186296995} {:answer/id #uuid "5153f7f5-f08e-5660-be36-e10c86fc8ff6" :answer/type {:db/ident :answer.type/math} :answer/value "6.5" :db/id #edb/ref 17592186296996}] :answer-field/correct {:answer/id #uuid "96f0ac24-be31-5e28-bdb0-42230ce81ebc" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296993} :answer-field/id #uuid "27c678e2-9151-5984-bb0a-e3a87fb06293" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296991}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f14a5fa1-39fe-5e33-b04b-72da56d8f87d" :question/math-academy-id "q-134173" :question/problem "| **Time Spent Practicing, \nin hours ($x$)** | $4$ | $5$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- |\n| **Points Scored ($y$)** | $4$ | $8$ | $12$ | $16$ |\n\nThe table above shows Mary's time practicing her jump shot each week and the number of points she scores in the Friday varsity basketball game. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=6$ and $\\overset{―}{y}=10.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-6)(4-10)+(5-6)(8-10)+(7-6)(12-10)+(8-6)(16-10)] \\\\  & =\\frac{1}{4}[(-2)(-6)+(-1)(-2)+(1)(2)+(2)(6)] \\\\  & =\\frac{1}{4}[12+2+2+12] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296997 :knowledge-point/_questions [{:knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86f92d1d-38e7-5b63-9092-b62f2cc11e49" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296999} {:answer/id #uuid "7d7dae65-3c2b-516b-95f9-dd4535a2b2de" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186297000} {:answer/id #uuid "6fc03c4e-23a8-55a1-b961-aa1a408f5bfb" :answer/type {:db/ident :answer.type/math} :answer/value "25.75" :db/id #edb/ref 17592186297001} {:answer/id #uuid "b360325f-5f0f-5677-8158-e94c48ffd632" :answer/type {:db/ident :answer.type/math} :answer/value "20.3" :db/id #edb/ref 17592186297002} {:answer/id #uuid "9e9d942f-91c2-5475-8351-b576e5cece74" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186297003}] :answer-field/correct {:answer/id #uuid "7d7dae65-3c2b-516b-95f9-dd4535a2b2de" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186297000} :answer-field/id #uuid "eba7bd24-46b2-5f99-8d4a-ab79bf86d487" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296998}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7f588070-7dc4-50a4-a416-ae7710680281" :question/math-academy-id "q-134211" :question/problem "| **Time Watching TV per Week, \nin hours ($x$)** | $4$ | $8$ | $12$ | $16$ |\n| --- | --- | --- | --- | --- |\n| **Grades, in percents ($y$)** | $64$ | $78$ | $76$ | $82$ |\n\nThe table above shows the relationship between the amount of time four of Mike's classmates watch TV per week and their overall math scores. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=75.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4\\,-\\,10)(64\\,-\\,75)+(8\\,-\\,10)(78\\,-\\,75)+(12\\,-\\,10)(76\\,-\\,75)+(16\\,-\\,10)(82\\,-\\,75)] \\\\  & =\\frac{1}{4}[(-6)(-11)+(-2)(3)+(2)(1)+(6)(7)] \\\\  & =\\frac{1}{4}[66-6+2+42] \\\\  & =\\frac{1}{4}\\cdot 104 \\\\  & =26.\\end{aligned}\n$$"}]}
