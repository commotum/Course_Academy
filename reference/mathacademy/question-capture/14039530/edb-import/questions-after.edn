#{[{:db/id #edb/ref 17592186305123 :knowledge-point/_questions [{:knowledge-point/id #uuid "141d61c7-1d82-52fe-b977-19daa910da9b" :knowledge-point/title "Simplifying an Expression by Factoring Alternative Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd9fe57d-dd10-51cb-86c0-f06cb604e5b5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305125} {:answer/id #uuid "3b148bdf-88c4-53cd-84fa-c47a42cb5f7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305126} {:answer/id #uuid "67076f2c-6e27-52da-af5f-0af95a2b3f7c" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305127} {:answer/id #uuid "77f41043-5605-52c7-8e79-cfec97b0aca3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305128} {:answer/id #uuid "4d171dcf-75ae-52b2-8a27-80f1a38fd5d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta -1" :db/id #edb/ref 17592186305129}] :answer-field/correct {:answer/id #uuid "4d171dcf-75ae-52b2-8a27-80f1a38fd5d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta -1" :db/id #edb/ref 17592186305129} :answer-field/id #uuid "43a38558-1d25-5602-b3a0-d9e56a1621a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305124}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "de55be6c-a232-5cb5-9161-14509946a499" :question/math-academy-id "q-120657" :question/problem "Simplify $\\frac{{tan}^{2}⁡\\theta }{\\operatorname{sec}⁡\\theta +1}.$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\frac{{tan}^{2}⁡\\theta }{\\operatorname{sec}⁡\\theta +1}=\\frac{{sec}^{2}⁡\\theta -1}{\\operatorname{sec}⁡\\theta +1}\n$$\n\nFinally, we can further simplify our expression by factoring the numerator as a difference of squares, as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡\\theta -1}{\\operatorname{sec}⁡\\theta +1} & =\\frac{(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1)}{\\operatorname{sec}⁡\\theta +1} \\\\  & =\\frac{(\\operatorname{sec}⁡\\theta -1)\\cancel{(\\operatorname{sec}⁡\\theta +1)}}{\\cancel{(\\operatorname{sec}⁡\\theta +1)}} \\\\  & =\\operatorname{sec}⁡\\theta -1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{tan}^{2}⁡\\theta }{\\operatorname{sec}⁡\\theta +1}=\\operatorname{sec}⁡\\theta -1.\n$$"}] [{:db/id #edb/ref 17592186305130 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e8cc165-700b-5358-b4a6-100caaec34ba" :answer/type {:db/ident :answer.type/math} :answer/value "-{tan}^{2}⁡x" :db/id #edb/ref 17592186305132} {:answer/id #uuid "64e6d7f7-23ad-55a8-8a64-af3396b50349" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x+1" :db/id #edb/ref 17592186305133} {:answer/id #uuid "550e332c-bf14-5808-a76c-ba581ccd1d9b" :answer/type {:db/ident :answer.type/math} :answer/value "{tan}^{4}⁡x" :db/id #edb/ref 17592186305134} {:answer/id #uuid "0db8bb34-fe0c-58e9-8823-909c8b456d83" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186305135} {:answer/id #uuid "d52512a3-b036-5035-a515-a553d4f50b96" :answer/type {:db/ident :answer.type/math} :answer/value "2{tan}^{4}⁡x+1" :db/id #edb/ref 17592186305136}] :answer-field/correct {:answer/id #uuid "550e332c-bf14-5808-a76c-ba581ccd1d9b" :answer/type {:db/ident :answer.type/math} :answer/value "{tan}^{4}⁡x" :db/id #edb/ref 17592186305134} :answer-field/id #uuid "fdb4fc94-0364-5acf-bc66-ba461be33e84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305131}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a43b657f-c0c3-5a6c-9118-de5e5d2c332e" :question/math-academy-id "q-120806" :question/problem "Which of the following is equivalent to $({tan}^{2}⁡x+1)^{2}-2{sec}^{2}⁡x+1?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(1),$ as follows:\n\n$$\n({tan}^{2}⁡x+1)^{2}-2{sec}^{2}⁡x+1=({sec}^{2}⁡x)^{2}-2{sec}^{2}⁡x+1\n$$\n\nFinally, we can use simplify our expression and use $(2),$ as follows:\n\n$$\n\\begin{aligned}({sec}^{2}⁡x)^{2}-2\\cdot {sec}^{2}⁡x\\cdot 1+{1}^{2} & =({sec}^{2}⁡x-1)^{2} \\\\  & =({tan}^{2}⁡x)^{2} \\\\  & ={tan}^{4}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n({tan}^{2}⁡x+1)^{2}-2{sec}^{2}⁡x+1={tan}^{4}⁡x.\n$$"}] [{:db/id #edb/ref 17592186305137 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c55efbf5-288f-5d7a-bf61-06a245a4db1e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sec}⁡\\theta +1)\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305139} {:answer/id #uuid "867bc63c-2d9c-58e3-827e-7d3f5268ae4f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305140} {:answer/id #uuid "dc6c6aca-c399-5b05-bdd4-e7fae523d193" :answer/type {:db/ident :answer.type/math} :answer/value "({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305141} {:answer/id #uuid "e0ce7173-f4b3-5f9e-ba00-8b13d90d5799" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\operatorname{sec}⁡\\theta )\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305142} {:answer/id #uuid "82615682-029d-506d-8e25-6420b1fe06fb" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta +1" :db/id #edb/ref 17592186305143}] :answer-field/correct {:answer/id #uuid "dc6c6aca-c399-5b05-bdd4-e7fae523d193" :answer/type {:db/ident :answer.type/math} :answer/value "({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186305141} :answer-field/id #uuid "a820c3e6-b18e-5b82-b9d6-b3054217bbf6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305138}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b0ac21ed-6171-55c2-8a5d-5fa5adfb32f3" :question/math-academy-id "q-120808" :question/problem "Which of the following is equivalent to ${tan}^{3}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta ?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(1),$ as follows:\n\n$$\n\\begin{aligned}{tan}^{3}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta  & =\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta \\,({tan}^{2}⁡\\theta +1) \\\\  & =\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta \\,{sec}^{2}⁡\\theta \\end{aligned}\n$$\n\nFinally, we can further simplify and use $(2),$ as follows:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta {sec}^{2}⁡\\theta  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot \\frac{1}{{cos}^{2}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{tan}⁡\\theta \\cdot \\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & ={tan}^{2}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta  \\\\  & =({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{tan}^{3}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta =({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186305144 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f67adda-8d06-5267-81cf-4f5ce23e1430" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{4}⁡x+1" :db/id #edb/ref 17592186305146} {:answer/id #uuid "a7c20415-3410-5c92-be26-9039e85be700" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186305147} {:answer/id #uuid "6749b367-296f-5303-8486-76871b191f6e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{4}⁡x" :db/id #edb/ref 17592186305148} {:answer/id #uuid "214ebae6-4a58-52db-927f-5a713dbed38d" :answer/type {:db/ident :answer.type/math} :answer/value "-{sec}^{2}⁡x" :db/id #edb/ref 17592186305149} {:answer/id #uuid "44bdc117-eee3-5894-aa1a-74467fccc099" :answer/type {:db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡x-1" :db/id #edb/ref 17592186305150}] :answer-field/correct {:answer/id #uuid "6749b367-296f-5303-8486-76871b191f6e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{4}⁡x" :db/id #edb/ref 17592186305148} :answer-field/id #uuid "916585b1-5b6c-554f-b4a5-6f1b1457f08c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305145}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "819bec50-d532-5f76-be3c-858299107c18" :question/math-academy-id "q-120811" :question/problem "Which of the following is equivalent to $({sec}^{2}⁡x-1)^{2}+2{tan}^{2}⁡x+1?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}({sec}^{2}⁡x-1)^{2}+2{tan}^{2}⁡x+1 & =({tan}^{2}⁡x)^{2}+2\\cdot {tan}^{2}⁡x\\cdot 1+{1}^{2} \\\\  & =({tan}^{2}⁡x+1)^{2}\\end{aligned}\n$$\n\nFinally, we can use $(1),$ as follows:\n\n$$\n\\begin{aligned}({tan}^{2}⁡x+1)^{2} & =({sec}^{2}⁡x)^{2} \\\\  & ={sec}^{4}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n({sec}^{2}⁡x-1)^{2}+2{tan}^{2}⁡x+1={sec}^{4}⁡x.\n$$"}] [{:db/id #edb/ref 17592186305151 :knowledge-point/_questions [{:knowledge-point/id #uuid "141d61c7-1d82-52fe-b977-19daa910da9b" :knowledge-point/title "Simplifying an Expression by Factoring Alternative Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "175c8ed8-f0e0-568e-9f7a-9d945054cf42" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{sec}^{2}⁡x-1}" :db/id #edb/ref 17592186305153} {:answer/id #uuid "febaddc3-a571-56a1-84eb-3d65b6b699a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sec}⁡x+1}" :db/id #edb/ref 17592186305154} {:answer/id #uuid "7a7b10ee-cee1-5942-9ccc-b133fe4e0c48" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x-1" :db/id #edb/ref 17592186305155} {:answer/id #uuid "9f1da193-8d77-5d92-90e1-e16407f49c9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sec}⁡x-1}" :db/id #edb/ref 17592186305156} {:answer/id #uuid "04145b0d-89a5-59ff-9eca-2384cd8a69cf" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186305157}] :answer-field/correct {:answer/id #uuid "febaddc3-a571-56a1-84eb-3d65b6b699a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{sec}⁡x+1}" :db/id #edb/ref 17592186305154} :answer-field/id #uuid "a1650285-f2ad-567f-828b-8a1eb9e57c8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305152}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "920e5801-1ca0-5acf-bc38-c3bd2a6130c4" :question/math-academy-id "q-74166" :question/problem "Simplify $\\frac{\\operatorname{sec}⁡x-1}{{tan}^{2}⁡x}.$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\frac{\\operatorname{sec}⁡x-1}{{tan}^{2}⁡x}=\\frac{\\operatorname{sec}⁡x-1}{{sec}^{2}⁡x-1}\n$$\n\nFinally, we can further simplify our expression by factoring the denominator as a difference of squares, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sec}⁡x-1}{{sec}^{2}⁡x-1} & =\\frac{\\operatorname{sec}⁡x-1}{(\\operatorname{sec}⁡x+1)(\\operatorname{sec}⁡x-1)} \\\\  & =\\frac{\\cancel{(\\operatorname{sec}⁡x-1)}}{(\\operatorname{sec}⁡x+1)\\cancel{(\\operatorname{sec}⁡x-1)}} \\\\  & =\\frac{1}{\\operatorname{sec}⁡x+1}\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sec}⁡x-1}{{tan}^{2}⁡x}=\\frac{1}{\\operatorname{sec}⁡x+1}.\n$$"}]}
