#{[{:db/id #edb/ref 17592186292055 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c9958ee-c8b0-5d33-8755-e61cb445b0de" :knowledge-point/title "Finding the Intervals on Which a Logarithmic Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd9cec0c-8fb4-5b2f-8851-6a18c358fc52" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{6},\\infty )" :db/id #edb/ref 17592186292057} {:answer/id #uuid "d9c06a7e-5bc1-529c-a385-4ff4892eb7c1" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,\\frac{1}{6})" :db/id #edb/ref 17592186292058} {:answer/id #uuid "f93c4250-078a-5f1f-a73f-c10bc8b22cfc" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,\\frac{1}{6}]" :db/id #edb/ref 17592186292059} {:answer/id #uuid "4ad8ecfc-4584-51ae-98ce-1e89057e918d" :answer/type {:db/ident :answer.type/math} :answer/value "[6,\\infty )" :db/id #edb/ref 17592186292060} {:answer/id #uuid "dc2c4429-aab3-56a2-8b60-f4888dac6365" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,6)" :db/id #edb/ref 17592186292061}] :answer-field/correct {:answer/id #uuid "d9c06a7e-5bc1-529c-a385-4ff4892eb7c1" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,\\frac{1}{6})" :db/id #edb/ref 17592186292058} :answer-field/id #uuid "64c55b1d-e216-5bf7-b4f9-8e7537034f22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292056}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ee7ffabe-8459-55eb-9ebc-f1c0c89dd1a2" :question/math-academy-id "q-105478" :question/problem "Find the largest interval of continuity for the function $f(x)=\\operatorname{log}⁡(3-18x).$" :question/worked-solution "The logarithmic function $\\operatorname{log}⁡(3-18x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n3-18x>0\\,⟹\\,18x<3\\,⟹\\,x<\\frac{1}{6}\n$$\n\nTherefore, the function $f(x)=\\operatorname{log}⁡(3-18x)$ is continuous on the interval $(-\\infty ,\\frac{1}{6}).$"}] [{:db/id #edb/ref 17592186292062 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c9958ee-c8b0-5d33-8755-e61cb445b0de" :knowledge-point/title "Finding the Intervals on Which a Logarithmic Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e741bdde-6e51-5645-b1e9-e95ec0d909a3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186292064} {:answer/id #uuid "0c7d0675-605a-5108-87b1-92aa89feb0ba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186292065}] :answer-field/correct {:answer/id #uuid "0c7d0675-605a-5108-87b1-92aa89feb0ba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186292065} :answer-field/id #uuid "fe0aa779-56b8-54c6-9b22-3c3e38b4f730" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292063} {:answer-field/choices [{:answer/id #uuid "683f26a8-70c6-55a0-9587-86aaa763f1e0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292067}] :answer-field/correct {:answer/id #uuid "683f26a8-70c6-55a0-9587-86aaa763f1e0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186292067} :answer-field/id #uuid "d02a1074-551d-58a9-a25e-6666d32ea75a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292066}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fd0c453d-32e1-55c5-a5a4-68b680a3fa5c" :question/math-academy-id "q-340069" :question/problem "The largest interval of continuity for the function $f(x)={log}_{e}⁡(10-5x)$ is\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}$).$" :question/worked-solution "The logarithmic function ${log}_{e}⁡(10-5x)$ is continuous at all points in its domain. However, the logarithm is only defined for positive inputs, so to find its domain, we set the expression inside the logarithm to be greater than zero:\n\n$$\n10-5x>0\\,⟹\\,5x<10\\,⟹\\,x<2\n$$\n\nTherefore, the function $f(x)={log}_{e}⁡(10-5x)$ is continuous on the interval $(-\\infty ,2).$"}] [{:db/id #edb/ref 17592186292068 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ad95b4e-e367-5e26-800c-1a87a537ca83" :knowledge-point/title "Finding the Intervals on Which a Trigonometric Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71290c29-b822-55ca-b003-1b116fe3f6cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186292070}] :answer-field/correct {:answer/id #uuid "71290c29-b822-55ca-b003-1b116fe3f6cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186292070} :answer-field/id #uuid "89e9ea8e-b4d8-520b-8367-50b4da5e8125" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292069} {:answer-field/choices [{:answer/id #uuid "3d0136a6-fdd2-51b7-9343-f689089153fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186292072}] :answer-field/correct {:answer/id #uuid "3d0136a6-fdd2-51b7-9343-f689089153fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi" :db/id #edb/ref 17592186292072} :answer-field/id #uuid "82caa028-7582-5f0d-b6e3-15d04b7cf487" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292071} {:answer-field/choices [{:answer/id #uuid "b49fc6c8-b276-51a8-bfed-9a9cc74811e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186292074}] :answer-field/correct {:answer/id #uuid "b49fc6c8-b276-51a8-bfed-9a9cc74811e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi}{2}" :db/id #edb/ref 17592186292074} :answer-field/id #uuid "29aecd50-7b4b-5f80-92bd-eea8b3301c17" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292073}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5ca2a6ed-44b6-5aff-b569-b654686bca4d" :question/math-academy-id "q-340088" :question/problem "The interval $I$ consists of all real numbers $x$ such that $\\frac{\\pi }{2}\\le x\\le \\frac{3\\pi }{2}.$ The largest subset of $I$ on which the function $f(x)=\\operatorname{cot}⁡(x)+\\operatorname{sin}⁡(2x)$ is continuous is\n\n$\\,[\\frac{\\pi }{2},$\n{{field-1}}$)⋃($\n{{field-2}}\n$,$\n{{field-3}}$].$" :question/worked-solution "Trigonometric functions are continuous at all points in their respective domains.\n\nThe function $\\operatorname{sin}⁡2x$ is continuous over the entire interval $[\\frac{\\pi }{2},\\frac{3\\pi }{2}],$ but the function $\\operatorname{cot}⁡x$ is not defined at $x=\\pi .$ \n\nTherefore, the domain of $f(x)$ consists of the union of the intervals $[\\frac{\\pi }{2},\\pi ),$ and $(\\pi ,\\frac{3\\pi }{2}],$ namely\n\n$$\n[\\frac{\\pi }{2},\\pi )\\cup (\\pi ,\\frac{3\\pi }{2}]\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186292075 :knowledge-point/_questions [{:knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "594e0a41-d91b-5a09-ab6d-1d7bd929b27e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186292077} {:answer/id #uuid "03006e1c-75e1-5baa-ac61-775e73227490" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (3,\\infty )" :db/id #edb/ref 17592186292078} {:answer/id #uuid "f6f412a8-b9bf-5f0e-bc28-0f0803d90126" :answer/type {:db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186292079} {:answer/id #uuid "1e9db80c-6e89-549a-869b-d42285e53c7a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186292080} {:answer/id #uuid "43e92eec-2d9c-5166-8b44-e74d41a903fa" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186292081}] :answer-field/correct {:answer/id #uuid "1e9db80c-6e89-549a-869b-d42285e53c7a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186292080} :answer-field/id #uuid "7ee96b7b-31f6-5120-8ddb-19534ea8d5bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292076}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0823f14a-58fd-5bcb-8d22-3fa3daf4ef45" :question/math-academy-id "q-38829" :question/problem "Determine the largest union of intervals on which the function $f(x)=\\frac{3-x}{{x}^{2}-3x}$ is continuous." :question/worked-solution "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{3-x}{{x}^{2}-3x} \\\\  & =\\frac{3-x}{x(x-3)} \\\\  & =-\\frac{1}{x},\\end{aligned}\n$$\n\n \n\nwhere $x\\ne 3.$\n\nThis function is continuous everywhere except at the excluded points $x=0$ and $x=3.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,0),$ $(0,3),$ and $(3,\\infty ),$ namely\n\n$$\n(-\\infty ,0)\\cup (0,3)\\cup (3,\\infty )\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186292082 :knowledge-point/_questions [{:knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181a74cf-634b-5740-8f07-21d2de59a1bd" :answer/type {:db/ident :answer.type/math} :answer/value "(2,\\infty )" :db/id #edb/ref 17592186292084} {:answer/id #uuid "d4e48017-42ad-51b7-a729-1af672290fae" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186292085} {:answer/id #uuid "47707dd2-a711-5f88-8cfc-92415bd6484b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,4)\\cup (4,\\infty )" :db/id #edb/ref 17592186292086} {:answer/id #uuid "63ace388-eb2b-53b3-9060-02a69d1f8b4b" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,2)" :db/id #edb/ref 17592186292087} {:answer/id #uuid "f2851b1e-d0e5-59f4-96f6-c87e75506e18" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186292088}] :answer-field/correct {:answer/id #uuid "f2851b1e-d0e5-59f4-96f6-c87e75506e18" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186292088} :answer-field/id #uuid "70be2966-9efa-545a-96b3-a61251a572bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292083}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a89dd586-4b9e-5d3d-a4da-8685e2264ec3" :question/math-academy-id "q-76069" :question/problem "Determine the largest union of intervals on which the function $f(x)=\\frac{x-2}{4{x}^{2}-16x+16}$ is continuous." :question/worked-solution "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-2}{4{x}^{2}-16x+16} \\\\  & =\\frac{x-2}{4({x}^{2}-4x+4)} \\\\  & =\\frac{x-2}{4(x-2)^{2}} \\\\  & =\\frac{1}{4(x-2)}\\end{aligned}\n$$\n\n \n\nThis function is continuous everywhere except at the excluded point $x=2.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,2)$ and $(2,\\infty ),$ namely\n\n$$\n(-\\infty ,2)\\cup (2,\\infty )\n$$\n\nand the function is also continuous on these intervals."}]}
