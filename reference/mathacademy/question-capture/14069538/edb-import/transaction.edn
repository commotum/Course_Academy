t}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=3,$ $b=x,$ and $n=5,$ we obtain\n\n$$\n\\begin{aligned}{(3+x)}^{5} & =(\\genfrac{}{}{0pt}{}{5}{0}){(3)}^{5}{(x)}^{0}+(\\genfrac{}{}{0pt}{}{5}{1}){(3)}^{5-1}{(x)}^{1}+(\\genfrac{}{}{0pt}{}{5}{2}){(3)}^{5-2}{(x)}^{2}+⋯ \\\\  & =1{(3)}^{5}+5{(3)}^{4}{(x)}^{1}+10{(3)}^{3}{(x)}^{2}+⋯ \\\\  & =243+5(81)(x)+10(27)({x}^{2})+⋯ \\\\  & =243+405x+270{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(3+x)}^{5}≈243+405x+270{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.04$ into the above approximation of $(3+x)^{5}:$\n\n$$\n\\begin{aligned}(2.96)^{5} & =(3+(-0.04))^{5} \\\\  & ≈243+405(-0.04)+270(-0.04)^{2} \\\\  & =243-405(0.04)+270(0.001\\,6) \\\\  & =243-16.2+0.432 \\\\  & =227.232,\\end{aligned}\n$$\n\nto three decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-134648/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4395c989-325f-5ac7-bdb3-f577f18695ed"] :knowledge-point/questions ["q-134648"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134649/selection/fc3b42c198c42f8f0526f294ddf31bd641cc92c120447c5167ee8af6cdbb15c6" :answer/id #uuid "6bab6ecb-8e9a-5165-bbf1-9228fa0c2a49" :answer/type :answer.type/math :answer/value "890.892" :db/ensure [:answer/validate]} {:db/id "q-134649/selection/bc36fca2744c458dcf75fa48ce23181c8509c4ed38b45548966abe239e4c32db" :answer/id #uuid "3f3af2ef-0d7c-5251-be0d-2b920e181058" :answer/type :answer.type/math :answer/value "890.734" :db/ensure [:answer/validate]} {:db/id "q-134649/selection/8f07c83a662cd5fa837e31d6e347250f70f3e0f1bc4f70be2f48cf7ec126c32e" :answer/id #uuid "17c99e8d-90d3-5931-b7e5-c94972cd3384" :answer/type :answer.type/math :answer/value "890.825" :db/ensure [:answer/validate]} {:db/id "q-134649/selection/1eb7d0b481dc31dde6cc06176d0a2e4c580f882061b43646f6e33e15d6a2f56d" :answer/id #uuid "f5ab57bc-ec91-5e7d-8b75-9d62f010dced" :answer/type :answer.type/math :answer/value "890.944" :db/ensure [:answer/validate]} {:db/id "q-134649/selection/10222c58d2ad0f01c21c52f407b2f3cd8803b9a0ec13ba9952cb588471a76fea" :answer/id #uuid "1c393c44-972e-5df3-8fca-49cbdad70e2d" :answer/type :answer.type/math :answer/value "890.967" :db/ensure [:answer/validate]} {:db/id "q-134649/selection" :answer-field/id #uuid "1d24c616-560e-5dd3-b38d-764794e030d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-134649/selection/1eb7d0b481dc31dde6cc06176d0a2e4c580f882061b43646f6e33e15d6a2f56d" :answer-field/choices ["q-134649/selection/fc3b42c198c42f8f0526f294ddf31bd641cc92c120447c5167ee8af6cdbb15c6" "q-134649/selection/bc36fca2744c458dcf75fa48ce23181c8509c4ed38b45548966abe239e4c32db" "q-134649/selection/8f07c83a662cd5fa837e31d6e347250f70f3e0f1bc4f70be2f48cf7ec126c32e" "q-134649/selection/1eb7d0b481dc31dde6cc06176d0a2e4c580f882061b43646f6e33e15d6a2f56d" "q-134649/selection/10222c58d2ad0f01c21c52f407b2f3cd8803b9a0ec13ba9952cb588471a76fea"] :db/ensure [:answer-field/validate]} {:db/id "q-134649" :question/id #uuid "ba3987c2-6256-5fcd-86e5-b9ea2e0dfd95" :question/math-academy-id "q-134649" :question/problem "Use the first three terms of the binomial expansion of $(4+x)^{5}$ in ascending powers of $x$ to approximate $(3.89)^{5}.$ Give your answer to three decimal places." :question/worked-solution "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=4,$ $b=x,$ and $n=5,$ we obtain\n\n$$\n\\begin{aligned}{(4+x)}^{5} & =(\\genfrac{}{}{0pt}{}{5}{0}){(4)}^{5}{(x)}^{0}+(\\genfrac{}{}{0pt}{}{5}{1}){(4)}^{5-1}{(x)}^{1}+(\\genfrac{}{}{0pt}{}{5}{2}){(4)}^{5-2}{(x)}^{2}+⋯ \\\\  & =1{(4)}^{5}+5{(4)}^{4}{(x)}^{1}+10{(4)}^{3}{(x)}^{2}+⋯ \\\\  & =1\\,024+5(256)(x)+10(64)({x}^{2})+⋯ \\\\  & =1\\,024+1\\,280x+640{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(4+x)}^{5}≈1\\,024+1\\,280x+640{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.11$ into the above approximation of $(4+x)^{5}:$\n\n$$\n\\begin{aligned}(3.89)^{5} & =(4+(-0.11))^{5} \\\\  & ≈1\\,024+1\\,280(-0.11)+640(-0.11)^{2} \\\\  & =1\\,024-1\\,280(0.11)+640(0.012\\,1) \\\\  & =1\\,024-140.8+7.744 \\\\  & =890.944,\\end{aligned}\n$$\n\nto three decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-134649/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4395c989-325f-5ac7-bdb3-f577f18695ed"] :knowledge-point/questions ["q-134649"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134653/selection/6b31914e33931390df2d84444706a58ea8fa3c8b97639b47ddae8d5150c79917" :answer/id #uuid "0d9cb765-5674-5468-aad6-4e206122bcf4" :answer/type :answer.type/math :answer/value "149.53" :db/ensure [:answer/validate]} {:db/id "q-134653/selection/9f7cb5786ac03d07213a8174b2f3a29e7137f9bfa95f5a1c6990f071dd0566a1" :answer/id #uuid "070116c9-ac35-5859-ae1f-1254f662aba9" :answer/type :answer.type/math :answer/value "151.13" :db/ensure [:answer/validate]} {:db/id "q-134653/selection/be67ad3869248d8942a94fa1b37e0327c9c942dbecda30ea9d0e876d1ccc2f42" :answer/id #uuid "e5e179da-26a0-528b-827a-aa7cbf42a47f" :answer/type :answer.type/math :answer/value "153.16" :db/ensure [:answer/validate]} {:db/id "q-134653/selection/80aab2e6ac108ac0f34eca4b980ee6d3a0addf2b0cad23da6432420fed42b82d" :answer/id #uuid "8a2505fb-9eb9-5306-8b96-aceada560c2b" :answer/type :answer.type/math :answer/value "152.23" :db/ensure [:answer/validate]} {:db/id "q-134653/selection/9300ac0b3ab0c3f67314aae938a0b9719e0b3b7f9690218315f915dfb2e4a22c" :answer/id #uuid "6847021e-f1d1-5e7b-b2e4-d1e034ffddad" :answer/type :answer.type/math :answer/value "150.45" :db/ensure [:answer/validate]} {:db/id "q-134653/selection" :answer-field/id #uuid "6f89c09f-65d9-52bc-86e3-129b69b1c81c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-134653/selection/be67ad3869248d8942a94fa1b37e0327c9c942dbecda30ea9d0e876d1ccc2f42" :answer-field/choices ["q-134653/selection/6b31914e33931390df2d84444706a58ea8fa3c8b97639b47ddae8d5150c79917" "q-134653/selection/9f7cb5786ac03d07213a8174b2f3a29e7137f9bfa95f5a1c6990f071dd0566a1" "q-134653/selection/be67ad3869248d8942a94fa1b37e0327c9c942dbecda30ea9d0e876d1ccc2f42" "q-134653/selection/80aab2e6ac108ac0f34eca4b980ee6d3a0addf2b0cad23da6432420fed42b82d" "q-134653/selection/9300ac0b3ab0c3f67314aae938a0b9719e0b3b7f9690218315f915dfb2e4a22c"] :db/ensure [:answer-field/validate]} {:db/id "q-134653" :question/id #uuid "95b99090-20e3-5633-8179-164b3d77b56d" :question/math-academy-id "q-134653" :question/problem "Use the first three terms of the binomial expansion of $(2+x)^{8}$ in ascending powers of $x$ to approximate $(1.87)^{8}.$ Give your answer to two decimal places." :question/worked-solution "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=2,$ $b=x,$ and $n=8,$ we obtain\n\n$$\n\\begin{aligned}{(2+x)}^{8} & =(\\genfrac{}{}{0pt}{}{8}{0}){(2)}^{8}{(x)}^{0}+(\\genfrac{}{}{0pt}{}{8}{1}){(2)}^{8-1}{(x)}^{1}+(\\genfrac{}{}{0pt}{}{8}{2}){(2)}^{8-2}{(x)}^{2}+⋯ \\\\  & =1{(2)}^{8}+8{(2)}^{7}{(x)}^{1}+28{(2)}^{6}{(x)}^{2}+⋯ \\\\  & =256+8(128)(x)+28(64)({x}^{2})+⋯ \\\\  & =256+1\\,024x+1\\,792{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(2+x)}^{8}≈256+1\\,024x+1\\,792{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.13$ into the above approximation of $(2+x)^{8}:$\n\n$$\n\\begin{aligned}(1.87)^{8} & =(2+(-0.13))^{8} \\\\  & ≈256+1\\,024(-0.13)+1\\,792(-0.13)^{2} \\\\  & =256-1\\,024(0.13)+1\\,792(0.016\\,9) \\\\  & =256-133.12+30.284\\,8 \\\\  & =153.16,\\end{aligned}\n$$\n\nto two decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-134653/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4395c989-325f-5ac7-bdb3-f577f18695ed"] :knowledge-point/questions ["q-134653"] :db/ensure [:knowledge-point/validate]} {:db/id "q-178289/selection/6206b0172ae4070ce91a46e692a7dd10a9c0c91e9f9f4342b7d5061f3d48c00b" :answer/id #uuid "b42493b9-8cc8-527b-852c-dbb0b4ca01b2" :answer/type :answer.type/math :answer/value "0.999\\,950" :db/ensure [:answer/validate]} {:db/id "q-178289/selection/b47e2cbf0c4b7e3f1604c4175834ba002281daff1ba65bd01ffadf7bd94e5847" :answer/id #uuid "30eae97d-bc28-50db-b152-8e61d6d26260" :answer/type :answer.type/math :answer/value "0.990\\,043" :db/ensure [:answer/validate]} {:db/id "q-178289/selection/1a2a91db87601d5aef930a895ef4791b6f59ae1afb919ee2dc25be30443ef6ac" :answer/id #uuid "c87fa59e-ff39-5893-9f73-36a746d12b91" :answer/type :answer.type/math :answer/value "0.009\\,955" :db/ensure [:answer/validate]} {:db/id "q-178289/selection/ed64a8b1de0aa9fd6f7595defbc9a98ba51eb2bf27aa55cc22fb47463af207de" :answer/id #uuid "1370a51f-41f6-5407-bde2-74c0cab3a192" :answer/type :answer.type/math :answer/value "1.010\\,045" :db/ensure [:answer/validate]} {:db/id "q-178289/selection/d6ef151240decfe49357b2fdab0c2ae8000b9f38d7a0d6050ddd0f0b4fe3acf4" :answer/id #uuid "cff75207-ac40-5eb5-aae7-73974a57dcfa" :answer/type :answer.type/math :answer/value "0.990\\,045" :db/ensure [:answer/validate]} {:db/id "q-178289/selection" :answer-field/id #uuid "84b4fcd5-82ef-55b9-a533-781c5113666d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-178289/selection/d6ef151240decfe49357b2fdab0c2ae8000b9f38d7a0d6050ddd0f0b4fe3acf4" :answer-field/choices ["q-178289/selection/6206b0172ae4070ce91a46e692a7dd10a9c0c91e9f9f4342b7d5061f3d48c00b" "q-178289/selection/b47e2cbf0c4b7e3f1604c4175834ba002281daff1ba65bd01ffadf7bd94e5847" "q-178289/selection/1a2a91db87601d5aef930a895ef4791b6f59ae1afb919ee2dc25be30443ef6ac" "q-178289/selection/ed64a8b1de0aa9fd6f7595defbc9a98ba51eb2bf27aa55cc22fb47463af207de" "q-178289/selection/d6ef151240decfe49357b2fdab0c2ae8000b9f38d7a0d6050ddd0f0b4fe3acf4"] :db/ensure [:answer-field/validate]} {:db/id "q-178289" :question/id #uuid "7b5a6c60-057a-5d0b-a3f1-c5e6e25a1f51" :question/math-academy-id "q-178289" :question/problem "Use the first three terms of the binomial expansion of $(1+x)^{10}$ in ascending powers of $x$ to approximate $(0.999)^{10}.$ Give your answer to six decimal places." :question/worked-solution "Recall that when $n$ is a positive integer, \n\n$$\n(1+x)^{n}=1+nx+\\frac{1}{2!}n(n-1){x}^{2}+⋯+{x}^{n}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{(1+x)}^{10} & =1+10x+\\frac{1}{2}\\cdot 10\\cdot 9\\cdot {x}^{2}+⋯+{x}^{10} \\\\  & =1+10x+45{x}^{2}+⋯+{x}^{10}.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(1+x)}^{10}≈1+10x+45{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.001$ into the above approximation of $(1+x)^{10}:$ \n\n$$\n\\begin{aligned}(0.999)^{10} & =(1+(-0.001))^{10} \\\\  & ≈1+10(-0.001)+45(-0.001)^{2} \\\\  & =1-10(0.001)+45(0.000\\,001) \\\\  & =1-0.01+0.000\\,045 \\\\  & =0.990\\,045,\\end{aligned}\n$$\n\nto six decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-178289/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13e430ab-a814-5613-a45d-d8cdd3c14a0f"] :knowledge-point/questions ["q-178289"] :db/ensure [:knowledge-point/validate]}]
