,024+1\\,280x+640{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(4+x)}^{5}≈1\\,024+1\\,280x+640{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.11$ into the above approximation of $(4+x)^{5}:$\n\n$$\n\\begin{aligned}(3.89)^{5} & =(4+(-0.11))^{5} \\\\  & ≈1\\,024+1\\,280(-0.11)+640(-0.11)^{2} \\\\  & =1\\,024-1\\,280(0.11)+640(0.012\\,1) \\\\  & =1\\,024-140.8+7.744 \\\\  & =890.944,\\end{aligned}\n$$\n\nto three decimal places." 13194139535690 true] [17592186361531 1000 #edb/ref 17592186361532 13194139535690 true] [17592186361531 1000 #edb/ref 17592186361533 13194139535690 true] [17592186361531 1000 #edb/ref 17592186361534 13194139535690 true] [17592186361531 1000 #edb/ref 17592186361535 13194139535690 true] [17592186361531 1000 #edb/ref 17592186361536 13194139535690 true] [17592186361531 1040 #edb/ref 17592186045450 13194139535690 true] [17592186361531 1041 "selection" 13194139535690 true] [17592186361531 1104 #edb/ref 17592186361533 13194139535690 true] [17592186361531 1110 #uuid "1d24c616-560e-5dd3-b38d-764794e030d3" 13194139535690 true] [17592186361532 1034 "890.967" 13194139535690 true] [17592186361532 1103 #edb/ref 17592186045453 13194139535690 true] [17592186361532 1111 #uuid "1c393c44-972e-5df3-8fca-49cbdad70e2d" 13194139535690 true] [17592186361533 1034 "890.944" 13194139535690 true] [17592186361533 1103 #edb/ref 17592186045453 13194139535690 true] [17592186361533 1111 #uuid "f5ab57bc-ec91-5e7d-8b75-9d62f010dced" 13194139535690 true] [17592186361534 1034 "890.825" 13194139535690 true] [17592186361534 1103 #edb/ref 17592186045453 13194139535690 true] [17592186361534 1111 #uuid "17c99e8d-90d3-5931-b7e5-c94972cd3384" 13194139535690 true] [17592186361535 1034 "890.734" 13194139535690 true] [17592186361535 1103 #edb/ref 17592186045453 13194139535690 true] [17592186361535 1111 #uuid "3f3af2ef-0d7c-5251-be0d-2b920e181058" 13194139535690 true] [17592186361536 1034 "890.892" 13194139535690 true] [17592186361536 1103 #edb/ref 17592186045453 1319413