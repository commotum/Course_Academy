#{[{:db/id #edb/ref 17592186250285 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aa30e16-fb89-5f63-b2fd-d91407ee49f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|x|}{5}+C" :db/id #edb/ref 17592186250287} {:answer/id #uuid "18a0496a-ccc4-5097-9dc8-841e78b4bbf8" :answer/type {:db/ident :answer.type/math} :answer/value "5+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250288} {:answer/id #uuid "559d13df-72d2-5cda-b5d2-af330986e8a3" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250289} {:answer/id #uuid "e908a26f-a0e2-54a0-9278-1432dd5d812e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250290} {:answer/id #uuid "dc97a57e-9fd5-53b8-8e0a-bb353da266a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{\\operatorname{ln}⁡|x|}+C" :db/id #edb/ref 17592186250291}] :answer-field/correct {:answer/id #uuid "559d13df-72d2-5cda-b5d2-af330986e8a3" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250289} :answer-field/id #uuid "b0f0d744-84b4-51ea-a1c9-cc96b8478494" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250286}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8fc6231a-b956-5ba4-98e6-075eb6f03f5a" :question/math-academy-id "q-103369" :question/problem "Calculate $\\int \\frac{5}{x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $5$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{5}{x}\\,\\text{d}x & =5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =5\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250292 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2d6fe6f-8eae-567d-9dea-90b7d5157218" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{3/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250294} {:answer/id #uuid "7668c788-98b3-51e2-bd1a-52cae21b39b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{5/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250295} {:answer/id #uuid "1fce1b83-deb1-5ab4-a42c-c41a40c94396" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}{x}^{3/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250296} {:answer/id #uuid "4be80ff3-1b3b-5e71-b2e9-1371b757622e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}{x}^{5/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250297} {:answer/id #uuid "a7408c64-3fb6-5a07-9cd4-7f0ab853ebce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250298}] :answer-field/correct {:answer/id #uuid "a7408c64-3fb6-5a07-9cd4-7f0ab853ebce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250298} :answer-field/id #uuid "4f7f4c6f-37c5-5504-b65e-fb3646a79d73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250293}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f6168e0f-95d3-5bb7-aa52-ddc60f3cb1e5" :question/math-academy-id "q-103593" :question/problem "Calculate $\\int ({x}^{3/2}+\\frac{1}{2}{x}^{-1})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{3/2}+\\frac{1}{2}{x}^{-1})\\,\\text{d}x=\\int {x}^{3/2}\\,\\text{d}x+\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{3/2}\\,\\text{d}x+\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{3/2+1}}{\\frac{3}{2}+1}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250299 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a978206-6017-5bd1-8b0e-72c43b05fbae" :answer/type {:db/ident :answer.type/math} :answer/value "2x-\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186250301} {:answer/id #uuid "9c1f87c6-0ec1-5d29-9b42-93b4b1eedba3" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186250302} {:answer/id #uuid "1e0b6d48-31b3-57cc-ba54-4810982c2af7" :answer/type {:db/ident :answer.type/math} :answer/value "2x+\\operatorname{ln}⁡(|x|+K)" :db/id #edb/ref 17592186250303} {:answer/id #uuid "f230377c-ba24-53bb-a49a-77160503441d" :answer/type {:db/ident :answer.type/math} :answer/value "2x+\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186250304} {:answer/id #uuid "5cfa26b9-e523-5a59-af88-a097ff241327" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186250305}] :answer-field/correct {:answer/id #uuid "8a978206-6017-5bd1-8b0e-72c43b05fbae" :answer/type {:db/ident :answer.type/math} :answer/value "2x-\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186250301} :answer-field/id #uuid "82405685-59a1-5e2c-a847-3310686c49d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250300}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "de38dc2b-38ee-5deb-9b32-6e4c664420c5" :question/math-academy-id "q-103605" :question/problem "What is the antiderivative of $\\frac{2x-1}{x}?$" :question/worked-solution "We separate the integrand into the sum of two fractions so that we can simplify each term. So, we get\n\n$$\n\\begin{aligned}\\int \\frac{2x-1}{x}\\,\\text{d}x & =\\int (\\frac{2x}{x}-\\frac{1}{x})\\,\\text{d}x \\\\  & =\\int (2-\\frac{1}{x})\\,\\text{d}x \\\\  & =2\\int \\,\\text{d}x-\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =2x-\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\operatorname{ln}⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\operatorname{ln}⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{2x-1}{x}\\,\\text{d}x & =2x-\\operatorname{ln}⁡|x|+C \\\\  & =2x-\\operatorname{ln}⁡|x|-\\operatorname{ln}⁡K \\\\  & =2x-(\\operatorname{ln}⁡|x|+\\operatorname{ln}⁡K) \\\\  & =2x-\\operatorname{ln}⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105978 :knowledge-point/_questions [{:knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aff26970-53ec-5277-8825-c21e73152a4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\ln (8K \\mid x \\mid)" :db/id #edb/ref 17592186102116} {:answer/id #uuid "c3f7a70c-780d-509d-a5ea-5f1e38f2075b" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln (\\frac{8}{3}K \\mid x \\mid)" :db/id #edb/ref 17592186102117} {:answer/id #uuid "26a9ff41-130d-52ba-9222-0800f9350be9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\ln (8 \\mid x \\mid + K)" :db/id #edb/ref 17592186102118} {:answer/id #uuid "3db936cc-e034-5c03-a80e-3bf41dc2dc3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\ln (K \\mid x \\mid)" :db/id #edb/ref 17592186102119} {:answer/id #uuid "5015c766-17a6-5acb-a8e2-9656abd9a0d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\ln (\\mid x \\mid + K)" :db/id #edb/ref 17592186102120}] :answer-field/correct {:answer/id #uuid "3db936cc-e034-5c03-a80e-3bf41dc2dc3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\ln (K \\mid x \\mid)" :db/id #edb/ref 17592186102119} :answer-field/id #uuid "2f8ec85d-9892-5d0b-bbb7-f715e7188cec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102115}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4863b144-6916-5476-8b2b-08b73058b19d" :question/math-academy-id "q-15717" :question/problem "What is the antiderivative of $\\frac{8}{3x}$?" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $\\frac{8}{3}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int \\frac{8}{3x}\\text{d}x & =\\frac{8}{3}\\int \\frac{1}{x}\\text{d}x \\\\  & =\\frac{8}{3}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=\\frac{8}{3}\\operatorname{ln}⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $\\frac{8}{3}\\operatorname{ln}⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{8}{3x}\\text{d}x & =\\frac{8}{3}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{8}{3}\\operatorname{ln}⁡|x|+\\frac{8}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{8}{3}(\\operatorname{ln}⁡|x|+\\operatorname{ln}⁡K) \\\\  & =\\frac{8}{3}\\operatorname{ln}⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250306 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cdd1613-c193-5531-b4b3-85a2b86f8aa1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡x}{5}{x}^{5/3}+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250308} {:answer/id #uuid "fe940d4c-1be7-5233-beb3-e7ec924193be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{4/3}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250309} {:answer/id #uuid "736449a4-ac71-5767-b3fc-e14d9a921eb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{11/3}+\\sqrt{5}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250310} {:answer/id #uuid "10662836-c250-5b2b-ac39-d78242a32aec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{5}{x}^{7/3}+\\sqrt{3}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250311} {:answer/id #uuid "934471f6-fc89-51ea-b95d-ba62554e17f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250312}] :answer-field/correct {:answer/id #uuid "934471f6-fc89-51ea-b95d-ba62554e17f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186250312} :answer-field/id #uuid "b0da6736-bbca-5bea-9f9b-514f7721c773" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250307}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a1fd3399-f36e-569b-89f9-d06cadb048a9" :question/math-academy-id "q-29885" :question/problem "Calculate $\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x=\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{2/3+1}}{\\frac{2}{3}+1}+\\sqrt{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"}]}
