[{:db/id "q-78957/selection/14168e0efa1e0258a186c9e33e92dcd3b79799a5f740ef289aa787a15ae55bce" :answer/id #uuid "a39ef54d-fdf7-5321-ae0c-4dd7560b65c7" :answer/type :answer.type/math :answer/value "3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "q-78957/selection/c23cede99cf5957c6dea253310da801cc682f148180eaaa54ea5e1f0ab2eca81" :answer/id #uuid "0a22ac3b-850b-5111-8490-aa88cd470302" :answer/type :answer.type/math :answer/value "9{x}^{3}\\operatorname{ln}⁡x-3{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "q-78957/selection/3783bdb4b6160c7495136270a60c2c793633c5e65e9548ab9e5baf51e64bf709" :answer/id #uuid "2dd9bed0-a5e8-502b-a71b-f8e4960f863b" :answer/type :answer.type/math :answer/value "{x}^{4}-4{x}^{3}\\operatorname{ln}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-78957/selection/bd4802f87d25923eb3220a8fb58db12e083f357b9a1b73459bca12ec123630d2" :answer/id #uuid "5291b6f8-e057-570d-bc40-27e97e5d6a13" :answer/type :answer.type/math :answer/value "3{x}^{3}+9{x}^{3}\\operatorname{ln}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-78957/selection" :answer-field/id #uuid "2ca2a420-07b7-59b4-a0f5-01f083a15766" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78957/selection/14168e0efa1e0258a186c9e33e92dcd3b79799a5f740ef289aa787a15ae55bce" :answer-field/choices ["q-78957/selection/14168e0efa1e0258a186c9e33e92dcd3b79799a5f740ef289aa787a15ae55bce" "q-78957/selection/c23cede99cf5957c6dea253310da801cc682f148180eaaa54ea5e1f0ab2eca81" "q-78957/selection/3783bdb4b6160c7495136270a60c2c793633c5e65e9548ab9e5baf51e64bf709" "q-78957/selection/bd4802f87d25923eb3220a8fb58db12e083f357b9a1b73459bca12ec123630d2"] :db/ensure [:answer-field/validate]} {:db/id "q-78957" :question/id #uuid "f2ce12b4-39fc-58da-90fb-99d831518db3" :question/math-academy-id "q-78957" :question/problem "$\\int 9{x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=9{x}^{2}\\, & ⟹\\,v=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x\\cdot 3{x}^{3}-\\int 3{x}^{3}(\\frac{1}{x})\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡x-\\int 3{x}^{2}\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78957/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-78957"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78883/selection/b357d4179ea838dd896361196f9b5b87b8181df0789d7088ba29f891c9937934" :answer/id #uuid "5171b084-ff23-530e-a0d3-2d4d1456ae5e" :answer/type :answer.type/math :answer/value "12{e}^{3}-4" :db/ensure [:answer/validate]} {:db/id "q-78883/selection/c053f84aae3abc401304d3b7bc13734e82d4fceff6ca7d9694228fb7a37a27ee" :answer/id #uuid "ae38d866-6ea9-5cec-8554-f80a8737e1b9" :answer/type :answer.type/math :answer/value "12{e}^{3}+4" :db/ensure [:answer/validate]} {:db/id "q-78883/selection/5d9c9bb9408752179710a65c8aef2591536b8295d8def6ce31c7c9192ad7af73" :answer/id #uuid "f6fc9108-7748-5b9a-9b90-e43d8e6b1222" :answer/type :answer.type/math :answer/value "8{e}^{3}+4" :db/ensure [:answer/validate]} {:db/id "q-78883/selection/c627affcbefdd7b7bf57e51d685de720b1ab1ae2af381b60c1825ca41c0bc3ca" :answer/id #uuid "26fe678a-5530-5eea-8fe7-3d770cc0657a" :answer/type :answer.type/math :answer/value "8{e}^{3}-12" :db/ensure [:answer/validate]} {:db/id "q-78883/selection/1e94d4d1ca0479a4b4619f84439682eccced929ae737f75d9fac0df9ac837653" :answer/id #uuid "7c805eea-d7ab-5933-aa2e-676591efd3c4" :answer/type :answer.type/math :answer/value "4{e}^{3}-4" :db/ensure [:answer/validate]} {:db/id "q-78883/selection" :answer-field/id #uuid "bb1911c3-8a81-51b6-820e-711e4c21c602" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78883/selection/5d9c9bb9408752179710a65c8aef2591536b8295d8def6ce31c7c9192ad7af73" :answer-field/choices ["q-78883/selection/b357d4179ea838dd896361196f9b5b87b8181df0789d7088ba29f891c9937934" "q-78883/selection/c053f84aae3abc401304d3b7bc13734e82d4fceff6ca7d9694228fb7a37a27ee" "q-78883/selection/5d9c9bb9408752179710a65c8aef2591536b8295d8def6ce31c7c9192ad7af73" "q-78883/selection/c627affcbefdd7b7bf57e51d685de720b1ab1ae2af381b60c1825ca41c0bc3ca" "q-78883/selection/1e94d4d1ca0479a4b4619f84439682eccced929ae737f75d9fac0df9ac837653"] :db/ensure [:answer-field/validate]} {:db/id "q-78883" :question/id #uuid "5038b062-144f-58db-8c18-619c12a2718f" :question/math-academy-id "q-78883" :question/problem "${\\int }_{1}^{{e}^{2}}9\\sqrt{x}\\operatorname{ln}⁡x\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=9\\sqrt{x} & \\,⟹\\,v=\\int 9\\sqrt{x}\\,dx=6{x}^{3/2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}9\\sqrt{x}\\operatorname{ln}⁡x\\,\\text{d}x & ={\\int }_{1}^{{e}^{2}}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(6{x}^{3/2}){|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}\\frac{6{x}^{3/2}}{x}\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡({e}^{2})(6{({e}^{2})}^{3/2})-\\operatorname{ln}⁡1(6(1)^{3/2})]-{\\int }_{1}^{{e}^{2}}6\\sqrt{x}\\,\\text{d}x \\\\  & =12{e}^{3}-4{x}^{3/2}{|}_{1}^{{e}^{2}} \\\\  & =12{e}^{3}-(4{({e}^{2})}^{3/2}-4(1)^{3/2}) \\\\  & =12{e}^{3}-4{e}^{3}+4 \\\\  & =8{e}^{3}+4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-78883/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-78883"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350964/field-1/772b1b3fb8da3c62bba8473ae261db3a179e1352e0d452dccfb7500204698bec" :answer/id #uuid "7e40235f-ddd1-5b91-96eb-82793327b786" :answer/type :answer.type/math :answer/value "\\frac{112}{9}e^9+\\frac{14}{9}" :db/ensure [:answer/validate]} {:db/id "q-350964/field-1/1cbf87faf26af59d47d2389269d431054c475a22a94e12750942e0b45d00843a" :answer/id #uuid "5e9e0ecc-16be-54a5-9fce-490c475ff59a" :answer/type :answer.type/math :answer/value "\\frac{112}{9}e^9-\\frac{14}{9}" :db/ensure [:answer/validate]} {:db/id "q-350964/field-1" :answer-field/id #uuid "7e56c318-0074-58c5-b739-f9192314f52e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350964/field-1/772b1b3fb8da3c62bba8473ae261db3a179e1352e0d452dccfb7500204698bec" :answer-field/choices ["q-350964/field-1/772b1b3fb8da3c62bba8473ae261db3a179e1352e0d452dccfb7500204698bec" "q-350964/field-1/1cbf87faf26af59d47d2389269d431054c475a22a94e12750942e0b45d00843a"] :db/ensure [:answer-field/validate]} {:db/id "q-350964" :question/id #uuid "9b8ff269-1424-55b4-84ed-67c003d12084" :question/math-academy-id "q-350964" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{3}}7{x}^{2}\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{2}) & \\,⟹\\,{u}^{′}=\\frac{2}{x} \\\\ {v}^{′}=7{x}^{2} & \\,⟹\\,v=\\int 7{x}^{2}\\,dx=\\frac{7{x}^{3}}{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{3}}7{x}^{2}\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x & ={\\int }_{1}^{{e}^{3}}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{3}}-{\\int }_{1}^{{e}^{3}}v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{2})(\\frac{7{x}^{3}}{3}){|}_{1}^{{e}^{3}}-{\\int }_{1}^{{e}^{3}}(\\frac{7{x}^{3}}{3})(\\frac{2}{x})\\,\\text{d}x \\\\  & =[\\frac{7({e}^{3})^{3}\\operatorname{ln}⁡(({e}^{3})^{2})}{3}-\\frac{7(1)^{3}\\operatorname{ln}⁡((1)^{2})}{3}]-\\frac{14}{3}{\\int }_{1}^{{e}^{3}}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{7{e}^{9}\\operatorname{ln}⁡({e}^{6})}{3}-\\frac{14{x}^{3}}{9}{|}_{1}^{{e}^{3}} \\\\  & =14{e}^{9}-(\\frac{14{e}^{9}}{9}-\\frac{14}{9}) \\\\  & =\\frac{1}{9}(126{e}^{9}-14{e}^{9}+14) \\\\  & =\\frac{14}{9}(8{e}^{9}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350964/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-350964"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12573/selection/f3b8b9b48b365ad24a74ac8865834a6f6b5efd0ca80ae901dee40c520575626a" :answer/id #uuid "af3459a1-862b-5808-a104-ece7d60650b5" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}\\operatorname{ln}⁡x}{2}-7\\operatorname{ln}⁡x-\\frac{{x}^{2}}{4}-7{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-12573/selection/8a30d2ceb4f9c9207daa64c42764ad96ef8d187ca59bf848f9b2bf9dc4403889" :answer/id #uuid "0cb1ad74-0ddf-591a-a83b-388cef01dd1f" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}\\operatorname{ln}⁡x}{2}+7x\\operatorname{ln}⁡x-\\frac{{x}^{2}}{4}-7x+C" :db/ensure [:answer/validate]} {:db/id "q-12573/selection/d01b2146162559f34f28720e5d45f02311dbd3388c916987e8e97a924528025c" :answer/id #uuid "caaad1f2-f17b-50eb-b0e1-dddf4b14cf61" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{ln}⁡x}{2}+7x\\operatorname{ln}⁡x-\\frac{x}{4}-7{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-12573/selection/b450c2e9f9ed79f6367d2686017ad341aa72dcf15d5c059732862aa890b99847" :answer/id #uuid "d79fb862-748b-5e76-ab02-bc440f18ad12" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{ln}⁡x}{2}-7\\operatorname{ln}⁡x-\\frac{{x}^{2}}{4}+7x+C" :db/ensure [:answer/validate]} {:db/id "q-12573/selection/31b429eabea9c26bc95438e214d801a67895eb30f7c02e4dff2fbc0418650342" :answer/id #uuid "058af3d2-4de9-51f1-b45e-c4f6450388df" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}\\operatorname{ln}⁡x}{2}+7\\operatorname{ln}⁡x+\\frac{{x}^{2}}{4}-7x+C" :db/ensure [:answer/validate]} {:db/id "q-12573/selection" :answer-field/id #uuid "7e0d112d-a83b-571f-8593-0c01ad5a42de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12573/selection/8a30d2ceb4f9c9207daa64c42764ad96ef8d187ca59bf848f9b2bf9dc4403889" :answer-field/choices ["q-12573/selection/f3b8b9b48b365ad24a74ac8865834a6f6b5efd0ca80ae901dee40c520575626a" "q-12573/selection/8a30d2ceb4f9c9207daa64c42764ad96ef8d187ca59bf848f9b2bf9dc4403889" "q-12573/selection/d01b2146162559f34f28720e5d45f02311dbd3388c916987e8e97a924528025c" "q-12573/selection/b450c2e9f9ed79f6367d2686017ad341aa72dcf15d5c059732862aa890b99847" "q-12573/selection/31b429eabea9c26bc95438e214d801a67895eb30f7c02e4dff2fbc0418650342"] :db/ensure [:answer-field/validate]} {:db/id "q-12573" :question/id #uuid "252da65e-a015-52db-8aca-5c1050a5b779" :question/math-academy-id "q-12573" :question/problem "$\\int (x+7)\\operatorname{ln}⁡x\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=x+7\\, & ⟹\\,v=\\int (x+7)\\,\\text{d}x=\\frac{{x}^{2}}{2}+7x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int (x+7)\\operatorname{ln}⁡x\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\frac{{x}^{2}}{2}+7x)-\\int (\\frac{{x}^{2}}{2}+7x)(\\frac{1}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{2}+7x\\operatorname{ln}⁡x-\\frac{1}{2}\\int x\\text{d}x-7\\int \\,\\text{d}x \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{2}+7x\\operatorname{ln}⁡x-\\frac{{x}^{2}}{4}-7x+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-12573/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-12573"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49716/selection/31954cc8098cbcba0aa3a0af7a13a8fe0bfd0dbb8765217dbbaf5a7d6542cd8c" :answer/id #uuid "3706d4b6-6af3-5407-a509-caf27e00c6bb" :answer/type :answer.type/math :answer/value "5{e}^{-4}+1" :db/ensure [:answer/validate]} {:db/id "q-49716/selection/3953b1a85191a1e84b57647c645273aaafe3f159a1c0ede3d2f869cfc2a2bb23" :answer/id #uuid "79edb51e-31bf-58da-8d9a-3876cb60f095" :answer/type :answer.type/math :answer/value "1-5{e}^{4}" :db/ensure [:answer/validate]} {:db/id "q-49716/selection/bec8f06cf587c09dd402ce03fc7e657a2385ad2e3b972b8a52212263d2b19162" :answer/id #uuid "4347eaca-a588-5bb2-a088-8cfd61908654" :answer/type :answer.type/math :answer/value "1-4{e}^{-5}" :db/ensure [:answer/validate]} {:db/id "q-49716/selection/4994b881b1d19487af9182c092e1e9870f79a7393a727448c3c166a221abfa3d" :answer/id #uuid "dc063778-1fcc-5e34-aff7-aeab4d4a27a4" :answer/type :answer.type/math :answer/value "1-5{e}^{-4}" :db/ensure [:answer/validate]} {:db/id "q-49716/selection/4f52c91cd409e4c577e97b7872e4812327e5c5ed2477d2c2b335e83c2ef15d37" :answer/id #uuid "8d69b0c8-17df-5bd0-959c-85219414766c" :answer/type :answer.type/math :answer/value "4{e}^{5}+1" :db/ensure [:answer/validate]} {:db/id "q-49716/selection" :answer-field/id #uuid "bd054f15-2a74-59d9-8154-9f8487b6d2cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49716/selection/4994b881b1d19487af9182c092e1e9870f79a7393a727448c3c166a221abfa3d" :answer-field/choices ["q-49716/selection/31954cc8098cbcba0aa3a0af7a13a8fe0bfd0dbb8765217dbbaf5a7d6542cd8c" "q-49716/selection/3953b1a85191a1e84b57647c645273aaafe3f159a1c0ede3d2f869cfc2a2bb23" "q-49716/selection/bec8f06cf587c09dd402ce03fc7e657a2385ad2e3b972b8a52212263d2b19162" "q-49716/selection/4994b881b1d19487af9182c092e1e9870f79a7393a727448c3c166a221abfa3d" "q-49716/selection/4f52c91cd409e4c577e97b7872e4812327e5c5ed2477d2c2b335e83c2ef15d37"] :db/ensure [:answer-field/validate]} {:db/id "q-49716" :question/id #uuid "64016032-3db7-586b-bd02-0efaddca45c3" :question/math-academy-id "q-49716" :question/problem "${\\int }_{1}^{{e}^{4}}\\frac{\\operatorname{ln}⁡x}{{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=\\frac{1}{{x}^{2}} & \\,⟹\\,v=\\int \\frac{1}{{x}^{2}}\\,dx=-\\frac{1}{x}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{4}}\\frac{\\operatorname{ln}⁡x}{{x}^{2}}\\,\\text{d}x & ={\\int }_{1}^{{e}^{4}}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{4}}-{\\int }_{1}^{{e}^{4}}v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(-\\frac{1}{x}){|}_{1}^{{e}^{4}}-{\\int }_{1}^{{e}^{4}}(-\\frac{1}{x})(\\frac{1}{x})\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡({e}^{4})(-\\frac{1}{{e}^{4}})-\\operatorname{ln}⁡(1)(-\\frac{1}{1})]+{\\int }_{1}^{{e}^{4}}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =-\\frac{4}{{e}^{4}}\\operatorname{ln}⁡(e)-\\frac{1}{x}{|}_{1}^{{e}^{4}} \\\\  & =-\\frac{4}{{e}^{4}}-(\\frac{1}{{e}^{4}}-\\frac{1}{1}) \\\\  & =1-5{e}^{-4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49716/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-49716"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-12570"] :question/problem "Calculate $\\int \\frac{{log}_{3}⁡x}{{x}^{3}}\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{3}⁡x\\cdot (-\\frac{1}{2{x}^{2}})-\\int (-\\frac{1}{2{x}^{2}})(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =-\\frac{{log}_{3}⁡x}{2{x}^{2}}+\\frac{1}{2\\operatorname{ln}⁡3}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{3}⁡x}{2{x}^{2}}-\\frac{1}{4{x}^{2}\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{\\operatorname{ln}⁡x}{2{x}^{2}\\operatorname{ln}⁡3}-\\frac{1}{4{x}^{2}\\operatorname{ln}⁡3}+C \\\\  & =-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{2}\\operatorname{ln}⁡3}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-114553/selection/6f09241ea88d821a83d51e3bd88758b15d9a059f5177df945c135d7df81e88ef" :answer/id #uuid "8c8e01d5-889e-5b4a-9acb-3c0c035897a1" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-114553/selection/cb3294ef42a8d807224356c3870b0257591423d6e82ab441f1fe6950ba82a753" :answer/id #uuid "736ab1b5-d37e-536f-886c-19bb16961a18" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{\\operatorname{ln}⁡2}(4\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-114553/selection/e643456bbebe62a388632f47443d092017ed7baddeffc3edc49c5f7cd96a916e" :answer/id #uuid "d3877c7f-5c76-5950-9f56-cf76e73251f7" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-114553/selection/390aaa16501c40f942ba6b0bd50abc66e580a28cce70c71583ed966f1543f0f0" :answer/id #uuid "4c8a9b38-30a3-52b1-9fff-2a4d191e1c43" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-114553/selection/6bc3c27bb96cd05761da12a1639702c87465c5aed6ee83800d488ad7530cda14" :answer/id #uuid "7a0aee70-f173-5908-827f-5f89cb4c0afb" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(4\\operatorname{ln}⁡x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-114553/selection" :answer-field/id #uuid "12cfabff-92bf-56e2-9172-fe6f118c2de8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114553/selection/e643456bbebe62a388632f47443d092017ed7baddeffc3edc49c5f7cd96a916e" :answer-field/choices ["q-114553/selection/6f09241ea88d821a83d51e3bd88758b15d9a059f5177df945c135d7df81e88ef" "q-114553/selection/cb3294ef42a8d807224356c3870b0257591423d6e82ab441f1fe6950ba82a753" "q-114553/selection/e643456bbebe62a388632f47443d092017ed7baddeffc3edc49c5f7cd96a916e" "q-114553/selection/390aaa16501c40f942ba6b0bd50abc66e580a28cce70c71583ed966f1543f0f0" "q-114553/selection/6bc3c27bb96cd05761da12a1639702c87465c5aed6ee83800d488ad7530cda14"] :db/ensure [:answer-field/validate]} {:db/id "q-114553" :question/id #uuid "5e6583e6-92e6-5c07-b4f7-1730072676de" :question/math-academy-id "q-114553" :question/problem "Calculate $\\int x{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=x\\, & ⟹\\,v=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int x{log}_{2}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(x)(\\frac{{x}^{2}}{2})-\\int (\\frac{{x}^{2}}{2})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{2}⁡(x)}{2}-\\frac{1}{2\\operatorname{ln}⁡2}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{2}⁡(x)}{2}-\\frac{1}{2\\operatorname{ln}⁡2}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{2\\operatorname{ln}⁡2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114553/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-114553"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114557/selection/4678a5d7d99d38d477a641d52dbada03c1b8114688b386a13a1c256d811b4936" :answer/id #uuid "8f5551ec-5a91-5363-81d0-33b0cb469957" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{ln}⁡x+2}{{x}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "q-114557/selection/12aab87c2dfbfed17632d920b846051b09a5feb9a0b76cba00e4d48a885eedf0" :answer/id #uuid "285bdb56-5409-582c-800d-189504dbf9ff" :answer/type :answer.type