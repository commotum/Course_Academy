#{[{:db/id #edb/ref 17592186291907 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdd4a2e4-b0e6-54e8-972c-3dc194ce4ab3" :knowledge-point/title "Computing the One-Sided Limits of a Piecewise Function when the Limits Do Not Coincide"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aea0dacb-d87b-5fd7-bc9c-a8eb5528949b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291909} {:answer/id #uuid "71d04fdb-0d00-55ed-844a-a2c4185b844a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291910}] :answer-field/correct {:answer/id #uuid "71d04fdb-0d00-55ed-844a-a2c4185b844a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291910} :answer-field/id #uuid "891f76e1-63c8-5a59-825b-d32f074b5f11" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291908} {:answer-field/choices [{:answer/id #uuid "c9cc27b4-bc6f-5cde-824b-08f458204387" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291912}] :answer-field/correct {:answer/id #uuid "c9cc27b4-bc6f-5cde-824b-08f458204387" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291912} :answer-field/id #uuid "e40b92ef-a03f-583b-8a51-53e5cb68f087" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291911}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e6ea74d6-4e6e-569c-beb1-916ee0855aa7" :question/math-academy-id "q-302096" :question/problem "Find the left-sided and the right-sided limits at $x=2$ for the function\n\n$$\ng(x)={\\begin{aligned}{x}^{2}+x-2 & \\text{ for }\\,x<2 \\\\ \\frac{3-\\sqrt{x+7}}{{x}^{2}-1} & \\text{ for }\\,x\\ge 2.\\end{aligned}\n$$\n\n${lim}_{x\\to {2}^{-}}g(x)=$\n{{field-1}}\n$\\,$ and $\\,$\n${lim}_{x\\to {2}^{+}}g(x)=$\n{{field-2}}" :question/worked-solution "Approaching from the left, we have $x<2,$ so we use the expression $g(x)={x}^{2}+x-2.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}g(x) & ={lim}_{x\\to {2}^{-}}({x}^{2}+x-2) \\\\  & ={2}^{2}+2-2 \\\\  & =4.\\end{aligned}\n$$\n\nApproaching from the right, we have $x\\ge 2,$ so we use the expression $g(x)=\\frac{3-\\sqrt{x+7}}{{x}^{2}-1}.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}g(x) & ={lim}_{x\\to {2}^{+}}\\frac{3-\\sqrt{x+7}}{{x}^{2}-1} \\\\  & =\\frac{3-\\sqrt{2+7}}{{2}^{2}-1} \\\\  & =\\frac{3-\\sqrt{9}}{4-1} \\\\  & =\\frac{3-3}{3} \\\\  & =\\frac{0}{3} \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {2}^{-}}g(x)=4,\\,{lim}_{x\\to {2}^{+}}g(x)=0.\n$$"}] [{:db/id #edb/ref 17592186291913 :knowledge-point/_questions [{:knowledge-point/id #uuid "bdd4a2e4-b0e6-54e8-972c-3dc194ce4ab3" :knowledge-point/title "Computing the One-Sided Limits of a Piecewise Function when the Limits Do Not Coincide"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37007a92-d46b-5f53-9b1d-7f12e0198668" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186291915}] :answer-field/correct {:answer/id #uuid "37007a92-d46b-5f53-9b1d-7f12e0198668" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi" :db/id #edb/ref 17592186291915} :answer-field/id #uuid "b9e1aeed-4d02-588e-a9ed-024eb0e5e3e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291914}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "56a3bc6b-7613-5691-931d-82b071475907" :question/math-academy-id "q-339885" :question/problem "Find the left-sided limit at $x=\\pi $ for the function\n\n$$\nf(x)={\\begin{aligned}x+\\pi  & \\text{ for }\\,x<\\pi  \\\\ \\operatorname{cos}⁡x & \\text{ for }\\,x\\ge \\pi .\\end{aligned}\n$$\n\n${lim}_{x\\to {\\pi }^{-}}f(x)=$\n{{field-1}}" :question/worked-solution "Approaching from the left, we have $x<\\pi ,$ so we use the expression $f(x)=x+\\pi .$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {\\pi }^{-}}f(x) & ={lim}_{x\\to {\\pi }^{-}}(x+\\pi ) \\\\  & =\\pi +\\pi  \\\\  & =2\\pi .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291916 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd" :knowledge-point/title "Computing Limits of Piecewise Functions with a Gap in the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ac5718e-bc95-59a6-96e2-b0c9874e4a14" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186291918} {:answer/id #uuid "c4755181-8e25-5da9-8c84-4cdf3a87d4f9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186291919}] :answer-field/correct {:answer/id #uuid "0ac5718e-bc95-59a6-96e2-b0c9874e4a14" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186291918} :answer-field/id #uuid "d9f8e89e-ad7b-5ca0-b126-75ebd0893ac4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291917} {:answer-field/choices [{:answer/id #uuid "66bedc67-9dc6-5efe-b558-de80d10ab6d7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186291921}] :answer-field/correct {:answer/id #uuid "66bedc67-9dc6-5efe-b558-de80d10ab6d7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186291921} :answer-field/id #uuid "389dab2b-0dcb-5527-baf5-9ee2f09551f1" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291920}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e004bed6-6db1-5e30-858a-94d361c47d3f" :question/math-academy-id "q-339938" :question/problem "Find ${lim}_{x\\to (-2)^{-}}f(x)$ and ${lim}_{x\\to {4}^{+}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}(x+2)^{3}+7 & \\text{ for }\\,x<-2 \\\\ \\sqrt{x-4}-1 & \\text{ for }\\,x\\ge 4.\\end{aligned}\n$$\n\n${lim}_{x\\to (-2)^{-}}f(x)=$\n{{field-1}}\n$\\,$ and $\\,$\n${lim}_{x\\to {4}^{+}}f(x)=$\n{{field-2}}" :question/worked-solution "Approaching $x=-2$ from the left, we have $x<-2,$ so we use the expression $f(x)=(x+2)^{3}+7.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-2)^{-}}f(x) & ={lim}_{x\\to (-2)^{-}}[(x+2)^{3}+7] \\\\  & =(-2+2)^{3}+7 \\\\  & ={0}^{3}+7 \\\\  & =7.\\end{aligned}\n$$\n\nOn the other hand, approaching $x=4$ from the right, we have $x\\ge 4,$ so we use the expression $f(x)=\\sqrt{x-4}-1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}f(x) & ={lim}_{x\\to {4}^{+}}(\\sqrt{x-4}-1) \\\\  & =\\sqrt{4-4}-1 \\\\  & =\\sqrt{0}-1 \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291922 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4014376-4dae-56f1-b981-b35d3afab874" :knowledge-point/title "Solving for a Constant Such that the Limit of a Piecewise Function Exists"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a199e1c1-57a6-56fe-935a-3200978e45cc" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291924}] :answer-field/correct {:answer/id #uuid "a199e1c1-57a6-56fe-935a-3200978e45cc" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291924} :answer-field/id #uuid "aebce52a-a8f3-58e7-ae9d-066b29ee8bb0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291923}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "392b6b9a-c949-59f8-bea1-4e97e207c540" :question/math-academy-id "q-340291" :question/problem "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}c\\, & \\text{ for }\\,x<2 \\\\ \\frac{1}{3}\\, & \\text{ for }\\,x=2 \\\\ {x}^{3}-3\\, & \\text{ for }\\,x>2\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to 2}f(x)$ exists. What is the value of constant $c?$\n\n$c=$\n{{field-1}}" :question/worked-solution "In order for ${lim}_{x\\to 2}f(x)$ to exist, the left and right-sided limits must both exist and be equal.\n\n- Approaching from the left, we have $x<2,$ so we use the expression $f(x)=c.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{-}}c \\\\  & =c\\,.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>2,$ so we use the expression $f(x)={x}^{3}-3.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}{x}^{3}-3 \\\\  & ={(2)}^{3}-3 \\\\  & =8-3 \\\\  & =5\\,.\\end{aligned}\n$$\n\nFinally, since the left and right-sided limits must be equal, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{+}}f(x) \\\\ c & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186291925 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd" :knowledge-point/title "Computing Limits of Piecewise Functions with a Gap in the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f58bda2b-e535-5d39-8b25-03c73a0a0477" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 1}f(x)=\\text{DNE}" :db/id #edb/ref 17592186291927} {:answer/id #uuid "feec2791-40ba-5ca0-a4bb-e88410476244" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 1}f(x)=0" :db/id #edb/ref 17592186291928} {:answer/id #uuid "acab8d3f-9626-52ae-a5af-ad01fb606608" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 1}f(x)=1" :db/id #edb/ref 17592186291929} {:answer/id #uuid "7650816d-6e25-5d12-a8f4-baab7c91faeb" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 1}f(x)=-2" :db/id #edb/ref 17592186291930} {:answer/id #uuid "3c91f850-841d-5c18-a28a-11c161400db2" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 1}f(x)=2" :db/id #edb/ref 17592186291931}] :answer-field/correct {:answer/id #uuid "f58bda2b-e535-5d39-8b25-03c73a0a0477" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 1}f(x)=\\text{DNE}" :db/id #edb/ref 17592186291927} :answer-field/id #uuid "c48282ab-d3b2-58b1-96d0-5c6fcd626c52" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291926}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e54b505f-a312-5171-a5d1-68f09bb4fd20" :question/math-academy-id "q-67894" :question/problem "Find ${lim}_{x\\to 1}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}(x-1)^{3}-2\\, & \\text{ for }\\,x\\le -1 \\\\ \\operatorname{ln}⁡x+2\\, & \\text{ for }\\,1\\le x\\le 10.\\end{aligned}\n$$" :question/worked-solution "To compute ${lim}_{x\\to \\,1}f(x),$ we must compute the left and right-sided limits separately.\n\nHowever, the left-sided limit ${lim}_{x\\to \\,{1}^{-}}f(x)$ does not exist since $f(x)$ is not defined on the interval $x\\in (-1,1).$ \n\nConsequently, the overall limit does not exist either:\n\n$$\n{lim}_{x\\to 1}f(x)=\\text{DNE}.\n$$"}]}
