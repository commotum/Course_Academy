{sec}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248321} {:answer/id #uuid "2f88b1b1-eb3a-541b-8255-d4220b389369" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}\\operatorname{sec}⁡x(1-\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186248322}] :answer-field/correct {:answer/id #uuid "1d25c12c-aba2-56c2-aa45-d948533b244f" :answer/type {:db/ident :answer.type/math} :answer/value "{5}^{x}\\operatorname{sec}⁡x(\\operatorname{ln}⁡5+\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186248319} :answer-field/id #uuid "527bfa4f-96a4-5415-b46a-0889d7dac335" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248317}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "18aca6a2-231b-5041-8475-9bc740bea6ad" :question/is-example false :question/math-academy-id "q-105314" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y={5}^{x}sec⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({5}^{x}sec⁡x) \\\\  & ={5}^{x}ln⁡5sec⁡x+{5}^{x}sec⁡xtan⁡x \\\\  & ={5}^{x}sec⁡x(ln⁡5+tan⁡x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248323 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc6f4b5-cd38-5902-b7bc-95cffdfb6d4f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248325} {:answer/id #uuid "bd4a4aaf-d76e-58fa-9d71-614ff1876269" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248326} {:answer/id #uuid "a3f037ea-14ea-54bc-85c3-758e31fec8dd" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x+\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248327} {:answer/id #uuid "baecd47c-39f2-5e20-80e8-9ff7938690fd" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{cos}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248328} {:answer/id #uuid "a02d6ef0-8b0b-5dc3-be56-3a499c1b26ed" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\operatorname{cos}⁡x+\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248329}] :answer-field/correct {:answer/id #uuid "a3f037ea-14ea-54bc-85c3-758e31fec8dd" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x+\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248327} :answer-field/id #uuid "73183b13-e74f-59a9-b553-8cc1fcd86acc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248324}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6e17e4fe-e07b-5fc3-a2d3-a050c6fe71f7" :question/is-example false :question/math-academy-id "q-105316" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=3sin⁡x+sec⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3sin⁡x+sec⁡x) \\\\  & =3cos⁡x+sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248330 :knowledge-point/_questions [{:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c2513ec-1082-5958-a49f-be06ae5fa466" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-5\\sqrt{3}" :db/id #edb/ref 17592186248332} {:answer/id #uu