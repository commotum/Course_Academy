29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81caba8c-b35f-55ea-aa9f-4f7525dc2df3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2} + 2" :db/id #edb/ref 17592186112132} {:answer/id #uuid "85a93792-6822-5624-9a01-d8eab7517405" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\sqrt{2} + 2" :db/id #edb/ref 17592186112133} {:answer/id #uuid "34d13a55-4bcb-5a5c-8068-6674ed55a575" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186112134} {:answer/id #uuid "3c1d8fd6-69ae-5ff7-848a-20c2cb70a2c6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186112135} {:answer/id #uuid "4f738990-bad6-5d69-9587-257793a2d580" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\sqrt{2} + 2" :db/id #edb/ref 17592186112136}] :answer-field/correct {:answer/id #uuid "3c1d8fd6-69ae-5ff7-848a-20c2cb70a2c6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186112135} :answer-field/id #uuid "ca85db3f-af30-56e9-b03c-876d66be035c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186112131}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "18111828-8d82-5c70-b695-6858b89927bd" :question/is-example false :question/math-academy-id "q-1905" :question/problem "Find the slope of $y = f(x)$ at $x = \\frac{π}{4}$ if $f(x) = 2x - \\sqrt{2}\\sec x$." :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\sqrt{2}sec⁡x) \\\\  & =2-\\sqrt{2}sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =2-\\sqrt{2}sec⁡(\\frac{\\pi }{4})tan⁡(\\frac{\\pi }{4}) \\\\  & =2-\\sqrt{2}(\\sqrt{2})(1) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248337 :knowledge-point/_questions [{:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "665cfc6c-b240-51a1-abc0-4c0c0ba22de8" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x+8{x}^{3}\\operatorname{tan}⁡x" :db/id #edb/ref 17592186248339} {:answer/id #uuid "27d3685a-10a2-5d34-a1df-952638e8d888" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}\\operatorname{cot}⁡x" :db/id #edb/ref 17592186248340} {:answer/id #uuid "519437be-f1c5-5434-912c-79009afffaed" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}\\operatorname{csc}⁡x" :db/id #edb/ref 17592186248341} {:answer/id #uuid "b7c4f2a3-d3dd-541a-8b3d-23af2df9bb6a" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}\\operatorname{csc}⁡x-8{x}^{3}\\operatorname{cot}⁡x" :db/id #edb/ref 17592186248342} {:answer/id #uuid "6ff0a0bc-4321-514c-87e4-4f14d92c295d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{4}{csc}^{2}⁡x+8{x}^{3}\\operatorname{cot}⁡x" :db/id #edb/ref 17592186248343}] :answer-field/correct {:answer/id #uuid "27d3685a-10a2-5d34-a1df-952638e8d888" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}\\operatorname{cot}⁡x" :db/id #edb/ref 17592186248340} :answer-field/id #uuid "f0086c1d-8f94-5c67-b080-6297d1802723" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248338}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" :question/is-example false :question/math-academy-id "q-1913" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115646 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89070b51-a91e-5bac-8fab-d64273777e65" :answer/type {:db/ident :answer.type/math} :answer/value "2 + 6\\csc x\\cot x" :db/id #edb/ref 17592186113277} {:answer/id #uuid "cfc4d32d-5441-5fc6-bb07-960546c82fd0" :answer/type {:db/ident :answer.type/math} :answer/value "x + 6\\csc x\\cot x" :db/id #edb/ref 17592186113278} {:answer/id #uuid "f49473ea-7771-58f4-92f8-4a029713502c" :answer/type {:db/ident :answer.type/math} :answer/value "-2 + 6\\csc x\\cot x" :db/id #edb/ref 17592186113279} {:answer/id #uuid "329b6d0c-3a3f-5fd1-983e-5edcb43f5b84" :answer/type {:db/ident :answer.type/math} :answer/value "2x + 6\\csc x\\cot x" :db/id #edb/ref 17592186113280} {:answer/id #uuid "54471c81-e5d9-5639-9aa3-ef01a2478c79" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2} - 6\\csc x\\cot x" :db/id #edb/ref 17592186113281}] :answer-field/correct {:answer/id #uuid "329b6d0c-3a3f-5fd1-983e-5edcb43f5b84" :answer/type {:db/ident :answer.type/math} :answer/value "2x + 6\\csc x\\cot x" :db/id #edb/ref 17592186113280} :answer-field/id #uuid "9af8db79-d780-5f33-bc61-831906ed00b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113276}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "683c5003-d2ff-5388-892e-f05923834b32" :question/is-example false :question/math-academy-id "q-31283" :question/problem "Find $f^{′}(x)$ if $f(x) = x^{2} - 6\\csc x$." :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248344 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c9a6e30-1ed5-566b-892c-b0f064c9e1c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\pi^2}{8}-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186248346}] :answer-field/correct {:answer/id #uuid "9c9a6e30-1ed5-566b-892c-b0f064c9e1c1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\pi^2}{8}-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186248346} :answer-field/id #uuid "9c1c16f8-5204-5de0-b085-2395bd994751" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248345}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e38e3d3d-441a-5691-b22b-ea5f67ffb69b" :question/is-example false :question/math-academy-id "q-313723" :question/problem "Find ${g}^{′}(\\frac{\\pi }{4})$ if $g(x)=csc⁡x-2{x}^{3}+cos⁡x.$\n\n${g}^{′}(\\frac{\\pi }{4})=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-csc⁡x-2{x}^{3}+cos⁡x) \\\\  & =(-csc⁡xcot⁡x)-2\\cdot 3{x}^{2}+(-sin⁡x) \\\\  & =-csc⁡xcot⁡x-6{x}^{2}-sin⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{g}^{′}(\\frac{\\pi }{4}) & =-csc\\,(\\frac{\\pi }{4})cot\\,(\\frac{\\pi }{4})-6{(\\frac{\\pi }{4})}^{2}-sin\\,(\\frac{\\pi }{4}) \\\\  & =-\\sqrt{2}\\cdot 1-6\\cdot \\frac{{\\pi }^{2}}{16}-\\frac{\\sqrt{2}}{2} \\\\  & =-\\sqrt{2}-\\frac{3}{8}{\\pi }^{2}-\\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{3\\sqrt{2}}{2}-\\frac{3}{8}{\\pi }^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248347 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a20da55a-a615-54c7-96fb-a569f94f1d58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\csc(x)}{x}-\\ln(x)\\csc(x)\\cot(x)" :db/id #edb/ref 17592186248349}] :answer-field/correct {:answer/id #uuid "a20da55a-a615-54c7-96fb-a569f94f1d58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\csc(x)}{x}-\\ln(x)\\csc(x)\\cot(x)" :db/id #edb/ref 17592186248349} :answer-field/id #uuid "e621f423-45ec-5e3c-a3b5-b2f1e4f5fd94" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248348}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0f0c92e7-9605-5116-b371-d3f8bfe6c5d5" :question/is-example false :question/math-academy-id "q-340582" :question/problem "Find ${h}^{′}(x)$ if $h(x)=ln⁡(x)csc⁡(x).$\n\n${h}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡(x)csc⁡(x)) \\\\  & =\\frac{1}{x}(csc⁡x)+(ln⁡(x))(-csc⁡(x)cot⁡(x)) \\\\  & =\\frac{csc⁡(x)}{x}-ln⁡(x)csc⁡(x)cot⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248350 :knowledge-point/_questions [{:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fceed02a-0bc5-54ed-81d2-43001dd880a3" :answer/type {:db/ident :answer.type/math} :answer/value "e^x+3\\csc(x)^2" :db/id #edb/ref 17592186248352} {:answer/id #uuid "81ec6284-4a94-5a73-8fc5-279f040d69fe" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248353}] :answer-field/correct {:answer/id #uuid "fceed02a-0bc5-54ed-81d2-43001dd880a3" :answer/type {:db/ident :answer.type/math} :answer/value "e^x+3\\csc(x)^2" :db/id #edb/ref 17592186248352} :answer-field/id #uuid "fd5c5e8a-f705-58c1-8dc6-58adcd341ea9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248351}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cfb10a82-cd73-580a-aec5-6b5ad59c979b" :question/is-example false :question/math-academy-id "q-340595" :question/problem "Find ${g}^{′}(x)$ for $g(x)={e}^{x}-3cot⁡(x).$\n\n${g}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}-3cot⁡(x)) \\\\  & ={e}^{x}-3(-{csc}^{2}⁡(x)) \\\\  & ={e}^{x}+3{csc}^{2}⁡(x)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248354 :knowledge-point/_questions [{:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a1d27d-d0d2-544d-9d8b-277f676a1b0d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln(x)" :db/id #edb/ref 17592186248356}] :answer-field/correct {:answer/id #uuid "26a1d27d-d0d2-544d-9d8b-277f676a1b0d" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln(x)" :db/id #edb/ref 17592186248356} :answer-field/id #uuid "35443022-9ce3-52de-9b20-161ceb713a84" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248355}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5590f803-8e7f-5668-b204-8536711df7f2" :question/is-example false :question/math-academy-id "q-340599" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{ln⁡(x)}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+{csc}^{2}⁡(x)\\,\\cdot ${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | $x{cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{ln⁡(x)}{cot⁡(x)}) \\\\  & =\\frac{cot⁡(x)\\cdot \\frac{1}{x}-ln⁡(x)(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{(\\frac{cot⁡(x)+xln⁡(x){csc}^{2}⁡(x)}{x})}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+{csc}^{2}⁡(x)\\cdot xln⁡(x)}{x{cot}^{2}⁡(x)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248357 :knowledge-point/_questions [{:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "635913af-b51d-5190-8154-251819a31add" :answer/type {:db/ident :answer.type/math} :answer/value "x\\csc(x)^2" :db/id #edb/ref 17592186248359}] :answer-field/correct {:answer/id #uuid "635913af-b51d-5190-8154-251819a31add" :answer/type {:db/ident :answer.type/math} :answer/value "x\\csc(x)^2" :db/id #edb/ref 17592186248359} :answer-field/id #uuid "213581d5-9d37-559e-9720-2cbcc8f82230" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248358}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4e711de5-a0c0-5af2-abb7-8219d1bb62f9" :question/is-example false :question/math-academy-id "q-340603" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{x}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | ${cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x}{cot⁡(x)}) \\\\  & =\\frac{1(cot⁡(x))-x(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+x{csc}^{2}⁡(x)}{{cot}^{2}⁡(x)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248360 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e57f163a-d59d-5308-93d5-905315bf8377" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\tan(x)" :db/id #edb/ref 17592186248362}] :answer-field/correct {:answer/id #uuid "e57f163a-d59d-5308-93d5-905315bf8377" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\tan(x)" :db/id #edb/ref 17592186248362} :answer-field/id #uuid "b1920661-9f97-5f48-899d-1f8fc7d75f66" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248361}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0000b85f-6157-5780-9b70-cfb929de24a0" :question/is-example false :question/math-academy-id "q-340611" :question/problem "Find the derivative of $y={e}^{x}sec⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}={e}^{x}sec⁡(x)($\n{{field-1}}\n$)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}sec⁡(x)) \\\\  & ={e}^{x}sec⁡(x)+{e}^{x}sec⁡(x)tan⁡(x) \\\\  & ={e}^{x}sec⁡(x)(1+tan⁡(x))\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248363 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1" :knowledge-point/title "Differentiating Expressions Involving the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08549195-a47a-5fa4-ab8e-3f5e7acec6a6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248365} {:answer/id #uuid "85942753-9a4b-5e5d-a17c-eef4497be3db" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248366}] :answer-field/correct {:answer/id #uuid "08549195-a47a-5fa4-ab8e-3f5e7acec6a6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248365} :answer-field/id #uuid "ab818232-130c-5669-aac9-c02f0a913360" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248364}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e9a0112c-8d06-50cb-abb3-2e50f0c33d41" :question/is-example false :question/math-academy-id "q-340620" :question/problem "Find the derivative of $y=4sec⁡x+{e}^{x}$ at $x=0.$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{0}=$\n{{field-1}}" :question/worked-solution "First, we take the derivative of each term and then add them:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(4sec⁡x+{e}^{x}) \\\\  & =4sec⁡xtan⁡x+{e}^{x}\\end{aligned}\n$$\n\nThen, we substitute $x=0$:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{x=0} & =(4sec⁡xtan⁡x+{e}^{x})\\,{|}_{x=0} \\\\  & =4sec⁡(0)tan⁡(0)+{e}^{0} \\\\  & =4\\cdot 1\\cdot 0+1 \\\\  & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248367 :knowledge-point/_questions [{:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83203724-9811-5652-9aeb-d163c10e0f68" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248369}] :answer-field/correct {:answer/id #uuid "83203724-9811-5652-9aeb-d163c10e0f68" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248369} :answer-field/id #uuid "76630e26-b79d-564b-b494-4714436171a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186248368}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b78ab795-e8d2-50ae-9a52-e6435a26846f" :question/is-example false :question/math-academy-id "q-340660" :question/problem "Find the slope of $y=f(x)$ at $x=0$ if $f(x)=\\frac{4x}{sec⁡x}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4x}{sec⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(4x)\\cdot sec⁡x-4x\\cdot \\frac{\\text{d}}{\\text{d}x}(sec⁡x)}{{sec}^{2}⁡x} \\\\  & =\\frac{4sec⁡x-4x\\cdot sec⁡xtan⁡x}{{sec}^{2}⁡x} \\\\  & =\\frac{4sec⁡x(1-xtan⁡x)}{{sec}^{2}⁡x} \\\\  & =\\frac{4(1-xtan⁡x)}{sec⁡x}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=0$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(0) & =\\frac{4(1-0\\cdot tan⁡0)}{sec⁡0} \\\\  & =\\frac{4(1-0)}{1} \\\\  & =4\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248370 :knowledge-point/_questions [{:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5543b276-97ac-5383-bfc7-c60629b03cd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi -2" :db/id #edb/ref 17592186248372} {:answer/id #uuid "9f3dac35-4ec2-5d86-a651-58ce2181094a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }+2" :db/id #edb/ref 17592186248373} {:answer/id #uuid "744f5a72-1966-5991-bd5c-5a78e20f2053" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }" :db/id #edb/ref 17592186248374} {:answer/id #uuid "e1cd4266-acb8-54a9-90e0-3d93964bb653" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186248375} {:answer/id #uuid "f18d7e18-32f6-5edf-8147-8be227baa19c" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\frac{3}{\\pi }" :db/id #edb/ref 17592186248376}] :answer-field/correct {:answer/id #uuid "e1cd4266-acb8-54a9-90e0-3d93964bb653" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186248375} :answer-field/id #uuid "e0177d43-7d6e-5ed6-9145-89eed77483e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248371}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67654ac3-52fe-5ff0-9885-df3668f8c10a" :question/is-example false :question/math-academy-id "q-70874" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=ln⁡x+3csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+3csc⁡x) \\\\  & =\\frac{1}{x}+3(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}-3csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =\\frac{1}{(\\frac{\\pi }{3})}-3csc⁡(\\frac{\\pi }{3})cot⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{\\sqrt{3}})(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{3}) \\\\  & =\\frac{3}{\\pi }-2.\\end{aligned}\\end{aligned}\n$$"}]}
