point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272"] :knowledge-point/questions ["q-105309"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1913/selection/cee25ec94bc366a0648e1bbb15b46ab486f28a9808c19f60113227deced35a90" :answer/id #uuid "6ff0a0bc-4321-514c-87e4-4f14d92c295d" :answer/type :answer.type/math :answer/value "{x}^{4}{csc}^{2}⁡x+8{x}^{3}\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-1913/selection/3153d1ae680a158482675595c87acf1c46da49be2e7d5d10e212ad9d64e424c5" :answer/id #uuid "665cfc6c-b240-51a1-abc0-4c0c0ba22de8" :answer/type :answer.type/math :answer/value "2{x}^{4}{csc}^{2}⁡x+8{x}^{3}\\operatorname{tan}⁡x" :db/ensure [:answer/validate]} {:db/id "q-1913/selection/564701440dba5eb1f95c8435648324fd557b43112d5cb97a167d75cdcd53320a" :answer/id #uuid "27d3685a-10a2-5d34-a1df-952638e8d888" :answer/type :answer.type/math :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-1913/selection/b07605c8600ad42221940b3e174daa60ddd0f736d1f4ca10ac2490fe14a1f483" :answer/id #uuid "519437be-f1c5-5434-912c-79009afffaed" :answer/type :answer.type/math :answer/value "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}\\operatorname{csc}⁡x" :db/ensure [:answer/validate]} {:db/id "q-1913/selection/c6aa24e18839e743c9de311289b5b01ab8fbdfcd68b71a9c6122d70a551c471a" :answer/id #uuid "b7c4f2a3-d3dd-541a-8b3d-23af2df9bb6a" :answer/type :answer.type/math :answer/value "2{x}^{2}\\operatorname{csc}⁡x-8{x}^{3}\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-1913/selection" :answer-field/id #uuid "f0086c1d-8f94-5c67-b080-6297d1802723" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1913/selection/564701440dba5eb1f95c8435648324fd557b43112d5cb97a167d75cdcd53320a" :answer-field/choices ["q-1913/selection/cee25ec94bc366a0648e1bbb15b46ab486f28a9808c19f60113227deced35a90" "q-1913/selection/3153d1ae680a158482675595c87acf1c46da49be2e7d5d10e212ad9d64e424c5" "q-1913/selection/564701440dba5eb1f95c8435648324fd557b43112d5cb97a167d75cdcd53320a" "q-1913/selection/b07605c8600ad42221940b3e174daa60ddd0f736d1f4ca10ac2490fe14a1f483" "q-1913/selection/c6aa24e18839e743c9de311289b5b01ab8fbdfcd68b71a9c6122d70a551c471a"] :db/ensure [:answer-field/validate]} {:db/id "q-1913" :question/id #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" :question/math-academy-id "q-1913" :question/is-example false :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-1913/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272"] :knowledge-point/questions ["q-1913"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340599/field-1/f0edbc638edad7ae74101cc9cb65350e3715a0126e0ab5566ecb99f04edea9c5" :answer/id #uuid "26a1d27d-d0d2-544d-9d8b-277f676a1b0d" :answer/type :answer.type/math :answer/value "x\\ln(x)" :db/ensure [:answer/validate]} {:db/id "q-340599/field-1" :answer-field/id #uuid "35443022-9ce3-52de-9b20-161ceb713a84" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340599/field-1/f0edbc638edad7ae74101cc9cb65350e3715a0126e0ab5566ecb99f04edea9c5" :answer-field/choices ["q-340599/field-1/f0edbc638edad7ae74101cc9cb65350e3715a0126e0ab5566ecb99f04edea9c5"] :db/ensure [:answer-field/validate]} {:db/id "q-340599" :question/id #uuid "5590f803-8e7f-5668-b204-8536711df7f2" :question/math-academy-id "q-340599" :question/is-example false :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{ln⁡(x)}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+{csc}^{2}⁡(x)\\,\\cdot ${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | $x{cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(\\frac{ln⁡(x)}{cot⁡(x)}) \\\\  & =\\frac{cot⁡(x)\\cdot \\frac{1}{x}-ln⁡(x)(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{(\\frac{cot⁡(x)+xln⁡(x){csc}^{2}⁡(x)}{x})}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+{csc}^{2}⁡(x)\\cdot xln⁡(x)}{x{cot}^{2}⁡(x)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340599/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272"] :knowledge-point/questions ["q-340599"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105316/selection/e79ae5f548d06abe7f467eec0e893813ecafe41a5550ca7a24d7fba905b6f94a" :answer/id #uuid "baecd47c-39f2-5e20-80e8-9ff7938690fd" :answer/type :answer.type/math :answer/value "-3\\operatorname{cos}⁡x-\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/ensure [:answer/validate]} {:db/id "q-105316/selection/99f21a7ec4730f371e8086cdb37d4bc1e9889ceab62a3fa9f37301b5c67298f2" :answer/id #uuid "a3f037ea-14ea-54bc-85c3-758e31fec8dd" :answer/type :answer.type/math :answer/value "3\\operatorname{cos}⁡x+\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/ensure [:answer/validate]} {:db/id "q-105316/selection/ff8c404ef0747e7d0a72c25ba361c5cb61d54f112901c43c5882fec452aa10e5" :answer/id #uuid "a02d6ef0-8b0b-5dc3-be56-3a499c1b26ed" :answer/type :answer.type/math :answer/value "-3\\operatorname{cos}⁡x+\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/ensure [:answer/validate]} {:db/id "q-105316/selection/8fbab54de83d604b059099eaf30dee10f9e4f6fe0c8e1cce97c00d0cc45a4502" :answer/id #uuid "bd4a4aaf-d76e-58fa-9d71-614ff1876269" :answer/type :answer.type/math :answer/value "3\\operatorname{cos}⁡x-\\operatorname{sec}⁡x\\operatorn