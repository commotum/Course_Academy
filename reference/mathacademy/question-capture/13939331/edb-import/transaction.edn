[{:db/id "q-105299/selection/2b86497a59abebf29b7a4727d6285b8a2f2af3f3cfeb7d08f2e47cd7be09545a" :answer/id #uuid "c7e91844-248e-5809-aa65-409d71626870" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡x({2}^{x}\\operatorname{ln}⁡2+\\operatorname{cot}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-105299/selection/493546f0a4f2bfb970a077e5b19c987c7e58758d3aa5199fec0457501afd7ccb" :answer/id #uuid "7e0be612-d93c-5992-8885-5f1d9728fef4" :answer/type :answer.type/math :answer/value "{2}^{x}\\operatorname{csc}⁡x(\\operatorname{ln}⁡2+\\operatorname{cot}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-105299/selection/4f4e5e3ff0b397e784c8136db80c09af3ff4a90f6b12e16c38b904e6a4f30ba5" :answer/id #uuid "a0a3580b-6bcb-5431-9270-274a54f06c54" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡x({2}^{x}\\operatorname{ln}⁡2-\\operatorname{cot}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-105299/selection/c6fe165643846c50af9feee5faa724bf89e075cddeec6465c0bacb7b2843df1e" :answer/id #uuid "bc88fae1-84aa-51b8-99e6-9bb1a2410a77" :answer/type :answer.type/math :answer/value "{2}^{x}\\operatorname{csc}⁡x(\\operatorname{ln}⁡2-\\operatorname{cot}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-105299/selection/4ef9300c458723869a3d469d2f46b6e1448710b437726169f119e0111d8cb728" :answer/id #uuid "2f94eff4-ad11-5f48-8a9d-77f6ba7d6c7c" :answer/type :answer.type/math :answer/value "{2}^{x}\\operatorname{ln}⁡2\\operatorname{csc}⁡x\\operatorname{cot}⁡x" :db/ensure [:answer/validate]} {:db/id "q-105299/selection" :answer-field/id #uuid "7723083b-417e-5b5a-ac24-b958be334814" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105299/selection/c6fe165643846c50af9feee5faa724bf89e075cddeec6465c0bacb7b2843df1e" :answer-field/choices ["q-105299/selection/2b86497a59abebf29b7a4727d6285b8a2f2af3f3cfeb7d08f2e47cd7be09545a" "q-105299/selection/493546f0a4f2bfb970a077e5b19c987c7e58758d3aa5199fec0457501afd7ccb" "q-105299/selection/4f4e5e3ff0b397e784c8136db80c09af3ff4a90f6b12e16c38b904e6a4f30ba5" "q-105299/selection/c6fe165643846c50af9feee5faa724bf89e075cddeec6465c0bacb7b2843df1e" "q-105299/selection/4ef9300c458723869a3d469d2f46b6e1448710b437726169f119e0111d8cb728"] :db/ensure [:answer-field/validate]} {:db/id "q-105299" :question/id #uuid "191f4c6b-bf0a-5363-8304-95a5223cc0b0" :question/math-academy-id "q-105299" :question/is-example false :question/problem "Find ${f}^{′}(x)$ if $f(x)={2}^{x}csc⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({2}^{x}csc⁡x) \\\\  & ={2}^{x}ln⁡2(csc⁡x)+{2}^{x}(-csc⁡xcot⁡x) \\\\  & ={2}^{x}csc⁡x(ln⁡2-cot⁡x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105299/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6"] :knowledge-point/questions ["q-105299"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-31283"] :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-313723/field-1/79d3845af077f7f932301a89f5e0c3ee8b02be250ab7fbb09cf823b92b4f87bb" :answer/id #uuid "9c9a6e30-1ed5-566b-892c-b0f064c9e1c1" :answer/type :answer.type/math :answer/value "-\\frac{3\\pi^2}{8}-\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-313723/field-1" :answer-field/id #uuid "9c1c16f8-5204-5de0-b085-2395bd994751" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-313723/field-1/79d3845af077f7f932301a89f5e0c3ee8b02be250ab7fbb09cf823b92b4f87bb" :answer-field/choices ["q-313723/field-1/79d3845af077f7f932301a89f5e0c3ee8b02be250ab7fbb09cf823b92b4f87bb"] :db/ensure [:answer-field/validate]} {:db/id "q-313723" :question/id #uuid "e38e3d3d-441a-5691-b22b-ea5f67ffb69b" :question/math-academy-id "q-313723" :question/is-example false :question/problem "Find ${g}^{′}(\\frac{\\pi }{4})$ if $g(x)=csc⁡x-2{x}^{3}+cos⁡x.$\n\n${g}^{′}(\\frac{\\pi }{4})=$\n{{field-1}}" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-csc⁡x-2{x}^{3}+cos⁡x) \\\\  & =(-csc⁡xcot⁡x)-2\\cdot 3{x}^{2}+(-sin⁡x) \\\\  & =-csc⁡xcot⁡x-6{x}^{2}-sin⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{g}^{′}(\\frac{\\pi }{4}) & =-csc\\,(\\frac{\\pi }{4})cot\\,(\\frac{\\pi }{4})-6{(\\frac{\\pi }{4})}^{2}-sin\\,(\\frac{\\pi }{4}) \\\\  & =-\\sqrt{2}\\cdot 1-6\\cdot \\frac{{\\pi }^{2}}{16}-\\frac{\\sqrt{2}}{2} \\\\  & =-\\sqrt{2}-\\frac{3}{8}{\\pi }^{2}-\\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{3\\sqrt{2}}{2}-\\frac{3}{8}{\\pi }^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-313723/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6"] :knowledge-point/questions ["q-313723"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105298/selection/c533210a654a3084648f543f7572caf62aab9952c4b6f8c01915498fb9aa4288" :answer/id #uuid "509de197-28ee-5d5a-a2d5-ea3bfa1556dc" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }+5" :db/ensure [:answer/validate]} {:db/id "q-105298/selection/a319e2074b264fdb964c2b6eb43d32d763280e23b0599a55d545f0a58e6fea9e" :answer/id #uuid "4e6c67a4-9d16-5ff0-a360-6319d37406d1" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-105298/selection/6f036b864db4b90c48c649dbedb671e5366d4fc25b46734a17cb134174579fc4" :answer/id #uuid "aa17aceb-3f32-59c6-bbf6-9f5ea5b86981" :answer/type :answer.type/math :answer/value "\\frac{10}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-105298/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "dacb83f6-6faf-522c-8e58-34a2c9461f13" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-105298/selection/004974907485d961daee2eabbf61927aedf09a145e74776b91dfc3616bdb6b62" :answer/id #uuid "daacc65a-5e8d-5439-8749-4207676e0203" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }-5" :db/ensure [:answer/validate]} {:db/id "q-105298/selection" :answer-field/id #uuid "5848f73e-6a5d-5454-b5ca-1f19912d7ecc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105298/selection/a319e2074b264fdb964c2b6eb43d32d763280e23b0599a55d545f0a58e6fea9e" :answer-field/choices ["q-105298/selection/c533210a654a3084648f543f7572caf62aab9952c4b6f8c01915498fb9aa4288" "q-105298/selection/a319e2074b264fdb964c2b6eb43d32d763280e23b0599a55d545f0a58e6fea9e" "q-105298/selection/6f036b864db4b90c48c649dbedb671e5366d4fc25b46734a17cb134174579fc4" "q-105298/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-105298/selection/004974907485d961daee2eabbf61927aedf09a145e74776b91dfc3616bdb6b62"] :db/ensure [:answer-field/validate]} {:db/id "q-105298" :question/id #uuid "760a6beb-1c0b-5274-bb23-84beaeb824a7" :question/math-academy-id "q-105298" :question/is-example false :question/problem "Find ${f}^{′}(\\frac{\\pi }{2})$ if $f(x)=ln⁡x-5csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x-5csc⁡x) \\\\  & =\\frac{1}{x}-5(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}+5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{2}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =\\frac{1}{(\\frac{\\pi }{2})}+5csc⁡(\\frac{\\pi }{2})cot⁡(\\frac{\\pi }{2}) \\\\  & =\\frac{2}{\\pi }+5\\cdot 1\\cdot 0 \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105298/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6"] :knowledge-point/questions ["q-105298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340582/field-1/954d9581cb8c0018bc5bb6d4b5c8a070a25c251c47bb7b7447f7275a070346a4" :answer/id #uuid "a20da55a-a615-54c7-96fb-a569f94f1d58" :answer/type :answer.type/math :answer/value "\\frac{\\csc(x)}{x}-\\ln(x)\\csc(x)\\cot(x)" :db/ensure [:answer/validate]} {:db/id "q-340582/field-1" :answer-field/id #uuid "e621f423-45ec-5e3c-a3b5-b2f1e4f5fd94" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340582/field-1/954d9581cb8c0018bc5bb6d4b5c8a070a25c251c47bb7b7447f7275a070346a4" :answer-field/choices ["q-340582/field-1/954d9581cb8c0018bc5bb6d4b5c8a070a25c251c47bb7b7447f7275a070346a4"] :db/ensure [:answer-field/validate]} {:db/id "q-340582" :question/id #uuid "0f0c92e7-9605-5116-b371-d3f8bfe6c5d5" :question/math-academy-id "q-340582" :question/is-example false :question/problem "Find ${h}^{′}(x)$ if $h(x)=ln⁡(x)csc⁡(x).$\n\n${h}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}{h}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡(x)csc⁡(x)) \\\\  & =\\frac{1}{x}(csc⁡x)+(ln⁡(x))(-csc⁡(x)cot⁡(x)) \\\\  & =\\frac{csc⁡(x)}{x}-ln⁡(x)csc⁡(x)cot⁡(x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340582/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6"] :knowledge-point/questions ["q-340582"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340603/field-1/caf6c5b8f617a6a52c32d96f9ffef96401084222c322ec4aca2220e12e12a9e7" :answer/id #uuid "635913af-b51d-5190-8154-251819a31add" :answer/type :answer.type/math :answer/value "x\\csc(x)^2" :db/ensure [:answer/validate]} {:db/id "q-340603/field-1" :answer-field/id #uuid "213581d5-9d37-559e-9720-2cbcc8f82230" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340603/field-1/caf6c5b8f617a6a52c32d96f9ffef96401084222c322ec4aca2220e12e12a9e7" :answer-field/choices ["q-340603/field-1/caf6c5b8f617a6a52c32d96f9ffef96401084222c322ec4aca2220e12e12a9e7"] :db/ensure [:answer-field/validate]} {:db/id "q-340603" :question/id #uuid "4e711de5-a0c0-5af2-abb7-8219d1bb62f9" :question/math-academy-id "q-340603" :question/is-example false :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{x}{cot⁡(x)}.$\n\n| $\\text{d}y$ | $=$ | $cot⁡(x)\\,+${{field-1}} |\n| --- | --- | --- |\n| $\\text{d}x$ |  | ${cot}^{2}⁡(x)$ |" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x}{cot⁡(x)}) \\\\  & =\\frac{1(cot⁡(x))-x(-{csc}^{2}⁡(x))}{{cot}^{2}⁡(x)} \\\\  & =\\frac{cot⁡(x)+x{csc}^{2}⁡(x)}{{cot}^{2}⁡(x)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340603/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272"] :knowledge-point/questions ["q-340603"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340595/field-1/93e947babcf858cf22ba7803f608d86b2bf3832ff7c4e6e89d41e39a7035b6f5" :answer/id #uuid "fceed02a-0bc5-54ed-81d2-43001dd880a3" :answer/type :answer.type/math :answer/value "e^x+3\\csc(x)^2" :db/ensure [:answer/validate]} {:db/id "q-340595/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "81ec6284-4a94-5a73-8fc5-279f040d69fe" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {