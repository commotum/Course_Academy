sure [:answer-field/validate]} {:db/id "q-104325" :question/id #uuid "1b368b0a-0220-5cfb-93f5-8a417e2e96fc" :question/math-academy-id "q-104325" :question/is-example false :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ if $y=\\frac{3sec⁡x}{{e}^{x}}.$" :question/worked-solution "We calculate the derivative using the quotient rule, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3sec⁡x}{{e}^{x}}) \\\\  & =\\frac{(3sec⁡xtan⁡x)({e}^{x})-(3sec⁡x)({e}^{x})}{({e}^{x})^{2}} \\\\  & =\\frac{3{e}^{x}sec⁡x(tan⁡x-1)}{{e}^{2x}} \\\\  & =\\frac{3sec⁡x(tan⁡x-1)}{{e}^{x}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104325/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1"] :knowledge-point/questions ["q-104325"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105314/selection/c7d698768f1169f13b6504db2c0fe869881fbc1ef3203b8e90c5bf2bc945a68c" :answer/id #uuid "2f88b1b1-eb3a-541b-8255-d4220b389369" :answer/type :answer.type/math :answer/value "{5}^{x}\\operatorname{sec}⁡x(1-\\operatorname{tan}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-105314/selection/0c751b46aed046b6204bd12b44bd3bb0a01f65b0c12232c8e03ec799c4e610f2" :answer/id #uuid "bf647cbd-c147-5e5d-8788-314a5f995318" :answer/type :answer.type/math :answer/value "{5}^{x}\\operatorname{sec}⁡x(\\operatorname{ln}⁡5-\\operatorname{tan}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-105314/selection/6848782b351af4cb8068cfb175ece448934e3c72e2795e229be18a15e2bb514e" :answer/id #uuid "9505ce85-30e4-570e-b2f8-f10543fad8f8" :answer/type :answer.type/math :answer/value "{5}^{x}\\operatorname{sec}⁡x\\operatorname{tan}⁡x" :db/ensure [:answer/validate]} {:db/id "q-105314/selection/466ceba92898fc2170e3921fcca20584dd162c1e4823c0037c0214501f709ffc" :answer/id #uuid "1d25c12c-aba2-56c2-aa45-d948533b244f" :answer/type :answer.type/math :answer/valu