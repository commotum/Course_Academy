e695906b10d5ff46b48944a81db0388edf7d8ad0cf106bd3a" :answer/id #uuid "e57f163a-d59d-5308-93d5-905315bf8377" :answer/type :answer.type/math :answer/value "1+\\tan(x)" :db/ensure [:answer/validate]} {:db/id "q-340611/field-1" :answer-field/id #uuid "b1920661-9f97-5f48-899d-1f8fc7d75f66" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340611/field-1/a0a5f02b5c84792e695906b10d5ff46b48944a81db0388edf7d8ad0cf106bd3a" :answer-field/choices ["q-340611/field-1/a0a5f02b5c84792e695906b10d5ff46b48944a81db0388edf7d8ad0cf106bd3a"] :db/ensure [:answer-field/validate]} {:db/id "q-340611" :question/id #uuid "0000b85f-6157-5780-9b70-cfb929de24a0" :question/math-academy-id "q-340611" :question/is-example false :question/problem "Find the derivative of $y={e}^{x}sec⁡(x).$\n\n$\\frac{\\text{d}y}{\\text{d}x}={e}^{x}sec⁡(x)($\n{{field-1}}\n$)$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,({e}^{x}sec⁡(x)) \\\\  & ={e}^{x}sec⁡(x)+{e}^{x}sec⁡(x)tan⁡(x) \\\\  & ={e}^{x}sec⁡(x)(1+tan⁡(x))\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340611/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e4b3974-1288-524e-a34c-8091c0e072f1"] :knowledge-point/questions ["q-340611"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70874/selection/97375290b81e58c863d99ebc79dd604a5ab486012e3992a0d939adbdb236f45e" :answer/id #uuid "744f5a72-1966-5991-bd5c-5a78e20f2053" :answer/type :answer.type/math :answer/value "\\frac{3}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-70874/selection/cb0f9423a94b3c0ff3579788926167ac6623151dbb7c8b583be72f453f52b17e" :answer/id #uuid "f18d7e18-32f6-5edf-8147-8be227baa19c" :answer/type :answer.type/math :answer/value "2-\\frac{3}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-70874/selection/5e998c0052a4a4790d6fd34847866973a8aa4b043de231aee64f32305d89a72c" :answer/id #uuid "9f3dac35-4ec2-5d86-a651-58ce2181094a" :answer/type :answer.type/math :answer/value "\\frac{3}{\\pi }+2" :db/ensure [:answer/validate]} {:db/id "q-70874/selection/25896a72f5d013c50bb7cb627bf4b333dd1dedb6f0f4e897db2f1ea33bb9ec65" :answer/id #uuid "5543b276-97ac-5383-bfc7-c60629b03cd1" :answer/type :answer.type/math :answer/value "\\pi -2" :db/ensure [:answer/validate]} {:db/id "q-70874/selection/98b0c6e31c5e73bc1e2a7124e8eda5933cd0340bce9b3f9df9074b7e224b9a96" :answer/id #uuid "e1cd4266-acb8-54a9-90e0-3d93964bb653" :answer/type :answer.type/math :answer/value "\\frac{3}{\\pi }-2" :db/ensure [:answer/validate]} {:db/id "q-70874/selection" :answer-field/id #uuid "e0177d43-7d6e-5ed6-9145-89eed77483e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70874/selection/98b0c6e31c5e73bc1e2a7124e8eda5933cd0340bce9b3f9df9074b7e224b9a96" :answer-field/choices ["q-70874/selection/97375290b81e58c863d99ebc79dd604a5ab486012e3992a0d939adbdb236f45e" "q-70874/selection/cb0f9423a94b3c0ff3579788926167ac6623151dbb7c8b583be72f453f52b17e" "q-70874/selection/5e998c0052a4a4790d6fd34847866973a8aa4b043de231aee64f32305d89a72c" "q-70874/selection/25896a72f5d013c50bb7cb627bf4b333dd1dedb6f0f4e897db2f1ea33bb9ec65" "q-70874/selection/98b0c6e31c5e73bc1e2a7124e8eda5933cd0340bce9b3f9df9074b7e224b9a96"] :db/ensure [:answer-field/validate]} {:db/id "q-70874" :question/id #uuid "67654ac3-52fe-5ff0-9885-df3668f8c10a" :question/math-academy-id "q-70874" :question/is-example false :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=ln⁡x+3csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+3csc⁡x) \\\\  & =\\frac{1}{x}+3(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}-3csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =\\frac{1}{(\\frac{\\pi }{3})}-3csc⁡(\\frac{\\pi }{3})cot⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{\\sqrt{3}})(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{3}) \\\\  & =\\frac{3}{\\pi }-2.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70874/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8"] :knowledge-point/questions ["q-70874"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-1905"] :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-\\sqrt{2}sec⁡x) \\\\  & =2-\\sqrt{2}sec⁡xtan⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{4}$ in the derivative and get\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{4}) & =2-\\sqrt{2}sec⁡(\\frac{\\pi }{4})tan⁡(\\frac{\\pi }{4}) \\\\  & =2-\\sqrt{2}(\\sqrt{2})(1) \\\\  & =2-2 \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-1904/selection/56d4a372ec136de04caba8efc363a04c65a6eb02e6e86eeec0d400f95465e34b" :answer/id #uuid "3c2513ec-1082-5958-a49f-be06ae5fa466" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{3}-5\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-1904/selection/ca6830b866f15cb1b67147472e65fec149cd777cbd7473c825f834c1fa8f57ef" :answer/id #uuid "3b46fefc-63ec-5ed9-b76f-98751122be45" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{6}-10\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-1904/selection/d82c572b86c9ed8859e954861e561836e445229b5d11043ec6849a2fc036887d" :answer/id #uuid "82eb801d-fc3b-5cc2-b11e-1519763b3763" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}-10\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-1904/selection/7bcfa9662ceaeec3d1a17c55b24eceeb40670d12a2fcdda8f46516494fd03666" :answer/id #uuid "5e0c4ea8-66a8-5f8d-9d05-535d5e2314f2" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-1904/selection/ab504bede70000c98450074015134a5b3a36f1da3b190db76cbf8471fc5bfcf4" :answer/id #uuid "e52fa01b-dcda-5584-9445-4fec6f6a3052" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}+10\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-1904/selection" :answer-field/id #uuid "25e9d045-32e0-54e9-93ad-f4ffc8fe37f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1904/selection/7bcfa9662ceaeec3d1a17c55b24eceeb40670d12a2fcdda8f46516494fd03666" :answer-field/choices ["q-1904/selection/56d4a372ec136de04caba8efc363a04c65a6eb02e6e86eeec0d400f95465e34b" "q-1904/selection/ca6830b866f15cb1b67147472e65fec149cd777cbd7473c825f834c1fa8f57ef" "q-1904/selection/d82c572b86c9ed8859e954861e561836e445229b5d11043ec6849a2fc036887d" "q-1904/selection/7bcfa9662ceaeec3d1a17c55b24eceeb40670d12a2fcdda8f46516494fd03666" "q-1904/selection/ab504bede70000c98450074015134a5b3a36f1da3b190db76cbf8471fc5bfcf4"] :db/ensure [:answer-field/validate]} {:db/id "q-1904" :question/id #uuid "cc9a114c-1206-5cc5-8e3b-10ea91c883ad" :question/math-academy-id "q-1904" :question/is-example false :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{6}$ if $f(x)=-{x}^{2}+5csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{d}{dx}(-{x}^{2}+5csc⁡x) \\\\  & =2\\cdot (-x)+5(-csc⁡xcot⁡x) \\\\  & =-2x-5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ into the derivative and get:\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{6}) & =-2(\\frac{\\pi }{6})-5csc⁡(\\frac{\\pi }{6})cot⁡(\\frac{\\pi }{6}) \\\\  & =-\\frac{\\pi }{3}-5\\cdot 2\\cdot \\sqrt{3} \\\\  & =-\\frac{\\pi }{3}-10\\sqrt{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1904/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8"] :knowledge-point/questions ["q-1904"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104442/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "9c58ab88-5b11-5129-8a45-ef2705f61378" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-104442/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "3cf19b6c-af92-5d90-bcd1-8078b0ad20f7" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-104442/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f4eed6e5-eae5-5e6b-801a-b25c696c2cbd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-104442/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "36517077-3145-59b3-b2af-bc2ba33d330b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-104442/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5858c024-44a6-55dc-807c-3b31aa22a22f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-104442/selection" :answer-field/id #uuid "8a0d3914-f422-5228-818f-9386cc9c4aff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104442/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-104442/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-104442/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-104442/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-104442/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-104442/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-104442" :question/id #uuid "166ab305-d740-5b5f-8db8-e4dc0cbb781b" :question/math-academy-id "q-104442" :question/is-example false :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=\\frac{sec⁡x}{\\sqrt{3}}+\\frac{3{x}^{2}}{\\pi }.$" :question/worked-solution "First, we take the derivative of each term and then add them, as follows:\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{sec⁡x}{\\sqrt{3}}+\\frac{3{x}^{2}}{\\pi }) \\\\  & =\\frac{sec⁡xtan⁡x}{\\sqrt{3}}+\\frac{6x}{\\pi }\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{\\pi /3} & =\\frac{1}{\\sqrt{3}}\\cdot sec⁡(\\frac{\\pi }{3})\\cdot tan⁡(\\frac{\\pi }{3})+\\frac{6}{\\pi }\\cdot \\frac{\\pi }{3} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot 2\\cdot \\sqrt{3}+2 \\\\  & =2+2 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104442/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8"] :knowledge-point/questions ["q-104442"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340660/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "83203724-9811-5652-9aeb-d163c10e0f68" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-340660/field-1" :answer-field/id #uuid "76630e26-b79d-564b-b494-4714436171a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340660/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-340660/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-340660" :question/id #uuid "b78ab795-e8d2-50ae-9a52-e6435a26846f" :question/math-academy-id "q-340660" :question/is-example false :question/problem "Find the slope of $y=f(x)$ at $x=0$ if $f(x)=\\frac{4x}{sec⁡x}.$\n\n$m=$\n{{field-1}}" :question/worked-solution "First, we calculate the derivative using the quotient rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4x}{sec⁡x}) \\\\  & =\\frac{\\frac{\\text{d}}{\\text{d}x}(4x)\\cdot sec⁡x-4x\\cdot \\frac{\\text{d}}{\\text{d}x}(sec⁡x)}{{sec}^{2}⁡x} \\\\  & =\\frac{4sec⁡x-4x\\cdot sec⁡xtan⁡x}{{sec}^{2}⁡x} \\\\  & =\\frac{4sec⁡x(1-xtan⁡x)}{{sec}^{2}⁡x} \\\\  & =\\frac{4(1-xtan⁡x)}{sec⁡x}\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=0$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(0) & =\\frac{4(1-0\\cdot tan⁡0)}{sec⁡0} \\\\  & =\\frac{4(1-0)}{1} \\\\  & =4\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340660/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8"] :knowledge-point/questions ["q-340660"] :db/ensure [:knowledge-point/validate]}]
