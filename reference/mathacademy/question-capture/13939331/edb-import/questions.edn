answer/value "2x + 6\\csc x\\cot x" :db/id #edb/ref 17592186113280} {:answer/id #uuid "54471c81-e5d9-5639-9aa3-ef01a2478c79" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2} - 6\\csc x\\cot x" :db/id #edb/ref 17592186113281}] :answer-field/correct {:answer/id #uuid "329b6d0c-3a3f-5fd1-983e-5edcb43f5b84" :answer/type {:db/ident :answer.type/math} :answer/value "2x + 6\\csc x\\cot x" :db/id #edb/ref 17592186113280} :answer-field/id #uuid "9af8db79-d780-5f33-bc61-831906ed00b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113276}] :question/id #uuid "683c5003-d2ff-5388-892e-f05923834b32" :question/is-example false :question/math-academy-id "q-31283" :question/problem "Find $f^{′}(x)$ if $f(x) = x^{2} - 6\\csc x$."}]}
