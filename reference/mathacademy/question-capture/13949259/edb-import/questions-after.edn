#{[{:db/id #edb/ref 17592186262882 :knowledge-point/_questions [{:knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31" :knowledge-point/title "Adding Rational Expressions in One Variable With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f4454ad-7f7a-51aa-b749-67d749dafbd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7n+2}{n-2}" :db/id #edb/ref 17592186262884} {:answer/id #uuid "40a6b1b0-cd27-556b-a616-c849f8373410" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3n-2}{n-2}" :db/id #edb/ref 17592186262885} {:answer/id #uuid "71fd9806-50ac-5cdf-a503-dd74cd0b14e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7n-4}{n-2}" :db/id #edb/ref 17592186262886} {:answer/id #uuid "b2c73fa1-e9fd-565e-b9c9-8acca44b6459" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3n+2}{n-2}" :db/id #edb/ref 17592186262887} {:answer/id #uuid "eafb2417-5183-5106-b91c-d554a54996e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5n+4}{n-2}" :db/id #edb/ref 17592186262888}] :answer-field/correct {:answer/id #uuid "5f4454ad-7f7a-51aa-b749-67d749dafbd2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7n+2}{n-2}" :db/id #edb/ref 17592186262884} :answer-field/id #uuid "5c1cca89-ea8c-53d4-88b6-17a5f1c0ba3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262883}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c78ad5bb-bc8b-5f94-a2c4-c8f19012e47a" :question/math-academy-id "q-113291" :question/problem "Given that $\\frac{5n+3}{n-2}=b$ and $\\frac{2n-1}{2-n}=c,$ what is $b-c?$" :question/worked-solution "We wish to subtract the following fractions:\n\n$$\nb-c=\\frac{5n+3}{n-2}-\\frac{2n-1}{2-n}\n$$\n\nIn order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $n-2$ if we multiply the top and bottom of the second fraction by $-1:$\n\n$$\n\\begin{aligned}\\frac{5n+3}{n-2}-\\frac{2n-1}{2-n} & = \\\\ \\frac{5n+3}{n-2}-\\frac{(-1)}{(-1)}\\cdot \\frac{2n-1}{2-n} & = \\\\ \\frac{5n+3}{n-2}-\\frac{-2n+1}{n-2} & = \\\\ \\frac{(5n+3)-(-2n+1)}{n-2} & = \\\\ \\frac{5n+3+2n-1}{n-2} & = \\\\ \\frac{7n+2}{n-2} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262889 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f14af5e-a475-526b-b312-49c4de7c0b4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5d+1}" :db/id #edb/ref 17592186262891} {:answer/id #uuid "9c7ac4af-8c06-5487-ad9f-0f6b06ab768c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5-c}{c(5d+1)}" :db/id #edb/ref 17592186262892} {:answer/id #uuid "00fc3de1-a5bd-5886-803b-641fe90ffac8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3-5c}{c(5d+1)}" :db/id #edb/ref 17592186262893} {:answer/id #uuid "30786d3b-7295-5698-bbbe-48dfecc6811b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3(3-5c)}{c(5d+1)}" :db/id #edb/ref 17592186262894} {:answer/id #uuid "d3365ae9-5a52-50ea-9cf2-5bf6c6d6b860" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3-c}{5d+1}" :db/id #edb/ref 17592186262895}] :answer-field/correct {:answer/id #uuid "00fc3de1-a5bd-5886-803b-641fe90ffac8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3-5c}{c(5d+1)}" :db/id #edb/ref 17592186262893} :answer-field/id #uuid "63ff4e3d-d602-505f-9820-a761f8b09f4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262890}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6ba90662-7772-5325-a0fa-de3561d4b7e7" :question/math-academy-id "q-113315" :question/problem "Simplify $\\frac{3}{c(5d+1)}-\\frac{5}{5d+1}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $c(5d+1)$ if we multiply the top and bottom of the second fraction by $c:$\n\n$$\n\\begin{aligned}\\frac{3}{c(5d+1)}-\\frac{5}{5d+1} & = \\\\ \\frac{3}{c(5d+1)}-\\frac{c}{c}\\cdot \\frac{5}{5d+1} & = \\\\ \\frac{3}{c(5d+1)}-\\frac{5c}{c(5d+1)} & = \\\\ \\frac{3-5c}{c(5d+1)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069251 :knowledge-point/_questions [{:knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31" :knowledge-point/title "Adding Rational Expressions in One Variable With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dbbdd81-87a0-5af3-b57e-66350ca57a2f" :answer/type {:db/ident :answer.type/math} :answer/value "(-14y + 45)/(5(1 - 2y))" :db/id #edb/ref 17592186067038} {:answer/id #uuid "b976a41a-12e0-5e78-b23d-b236f8211848" :answer/type {:db/ident :answer.type/math} :answer/value "(14y)/(5(1 - 2y))" :db/id #edb/ref 17592186067039} {:answer/id #uuid "c0135121-bd25-55e7-9647-a0f9bbca305f" :answer/type {:db/ident :answer.type/math} :answer/value "(26y - 45)/(5(1 - 2y))" :db/id #edb/ref 17592186067040} {:answer/id #uuid "d5e98dde-d609-5682-968a-db59a39925a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2y + 9}{1 - 2y}" :db/id #edb/ref 17592186067041} {:answer/id #uuid "66e82220-47aa-5172-bf57-b17394519a67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{45}{1 - 2y}" :db/id #edb/ref 17592186067042}] :answer-field/correct {:answer/id #uuid "8dbbdd81-87a0-5af3-b57e-66350ca57a2f" :answer/type {:db/ident :answer.type/math} :answer/value "(-14y + 45)/(5(1 - 2y))" :db/id #edb/ref 17592186067038} :answer-field/id #uuid "d44511d1-180e-50c5-a1f9-0880e9ec893c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067037}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e010d20d-afd2-59fa-8a1c-50d451ce4776" :question/math-academy-id "q-41576" :question/problem "Given that $(6y)/(5(1 - 2y)) = p$ and $\\frac{9 - 4y}{1 - 2y} = q$, what is $p + q$?" :question/worked-solution "We wish to add the following fractions:\n\n$$\np+q=\\frac{6y}{5(1-2y)}+\\frac{9-4y}{1-2y}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $5(1-2y)$ if we multiply the top and bottom of the second fraction by $5:$\n\n$$\n\\begin{aligned}\\frac{6y}{5(1-2y)}+\\frac{9-4y}{1-2y} & = \\\\ \\frac{6y}{5(1-2y)}+\\frac{5}{5}\\cdot \\frac{9-4y}{1-2y} & = \\\\ \\frac{6y}{5(1-2y)}+\\frac{5(9-4y)}{5(1-2y)} & = \\\\ \\frac{6y+5(9-4y)}{5(1-2y)} & = \\\\ \\frac{6y+45-20y}{5(1-2y)} & = \\\\ \\frac{-14y+45}{5(1-2y)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262896 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4aca8816-daba-580a-bc0c-f9b2043231c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{b}{a(b-3)}" :db/id #edb/ref 17592186262898} {:answer/id #uuid "e3137c0f-ccfc-59b8-80d7-9c2599de0c3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{a-3b}{b-3}" :db/id #edb/ref 17592186262899} {:answer/id #uuid "7de195a4-3939-5bdd-8de1-abf752a1afe6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3a+b-3}{a(b-3)}" :db/id #edb/ref 17592186262900} {:answer/id #uuid "d1848bc6-24c8-5fa8-a073-8c9d1dcca81b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3a-b}{b-3}" :db/id #edb/ref 17592186262901} {:answer/id #uuid "f7d788fe-0f7c-587b-8317-4b143dca4fcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{b-6}{a(b-3)}" :db/id #edb/ref 17592186262902}] :answer-field/correct {:answer/id #uuid "4aca8816-daba-580a-bc0c-f9b2043231c4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{b}{a(b-3)}" :db/id #edb/ref 17592186262898} :answer-field/id #uuid "72c488d0-4778-5bf8-ba17-c45063ec0fee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262897}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dca27562-adcf-5b7b-acbc-fbf75664689d" :question/math-academy-id "q-70327" :question/problem "Simplify $\\frac{3}{a(b-3)}+\\frac{1}{a}.$" :question/worked-solution "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $a(b-3)$ if we multiply the top and bottom of the second fraction by $b-3:$\n\n$$\n\\begin{aligned}\\frac{3}{a(b-3)}+\\frac{1}{a} & = \\\\ \\frac{3}{a(b-3)}+\\frac{b-3}{b-3}\\cdot \\frac{1}{a} & = \\\\ \\frac{3}{a(b-3)}+\\frac{b-3}{a(b-3)} & = \\\\ \\frac{3+b-3}{a(b-3)} & = \\\\ \\frac{b}{a(b-3)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262903 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008fa48b-1306-5ca0-b7fe-4b016f5c4bf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{2(k+3t)}" :db/id #edb/ref 17592186262905} {:answer/id #uuid "98398c85-ac64-543a-b2db-bb99e14c58df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3t+k}{k+3t}" :db/id #edb/ref 17592186262906} {:answer/id #uuid "267d0bd1-f9cd-58dd-83fe-7e696bd0e90e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3t+k}{2(k+3t)}" :db/id #edb/ref 17592186262907} {:answer/id #uuid "03429441-ec10-5d13-a259-ea6b3f45b029" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{k+3t}" :db/id #edb/ref 17592186262908} {:answer/id #uuid "d02d47d4-37c3-5904-83d5-113e746cfd83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3t-2k}{2(k+3t)}" :db/id #edb/ref 17592186262909}] :answer-field/correct {:answer/id #uuid "008fa48b-1306-5ca0-b7fe-4b016f5c4bf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3t+2k}{2(k+3t)}" :db/id #edb/ref 17592186262905} :answer-field/id #uuid "d989baa2-ff9b-5adf-94ef-4b3f288eec61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262904}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c3d0773c-fc4d-5861-91f2-0a46eb244efc" :question/math-academy-id "q-79551" :question/problem "Simplify $\\frac{3t}{2(k+3t)}+\\frac{k}{k+3t}.$" :question/worked-solution "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(k+3t)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{3t}{2(k+3t)}+\\frac{k}{k+3t} & = \\\\ \\frac{3t}{2(k+3t)}+\\frac{2}{2}\\cdot \\frac{k}{k+3t} & = \\\\ \\frac{3t}{2(k+3t)}+\\frac{2k}{2(k+3t)} & = \\\\ \\frac{3t+2k}{2(k+3t)} & \\end{aligned}\n$$"}]}
