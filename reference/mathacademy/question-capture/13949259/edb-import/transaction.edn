[{:db/id [:question/math-academy-id "q-41576"] :question/worked-solution "We wish to add the following fractions:\n\n$$\np+q=\\frac{6y}{5(1-2y)}+\\frac{9-4y}{1-2y}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $5(1-2y)$ if we multiply the top and bottom of the second fraction by $5:$\n\n$$\n\\begin{aligned}\\frac{6y}{5(1-2y)}+\\frac{9-4y}{1-2y} & = \\\\ \\frac{6y}{5(1-2y)}+\\frac{5}{5}\\cdot \\frac{9-4y}{1-2y} & = \\\\ \\frac{6y}{5(1-2y)}+\\frac{5(9-4y)}{5(1-2y)} & = \\\\ \\frac{6y+5(9-4y)}{5(1-2y)} & = \\\\ \\frac{6y+45-20y}{5(1-2y)} & = \\\\ \\frac{-14y+45}{5(1-2y)} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-70327/selection/2d7c9cf9859e447f402dae575874d6f7977bab5913015f8bce4f0d6ca919c639" :answer/id #uuid "e3137c0f-ccfc-59b8-80d7-9c2599de0c3d" :answer/type :answer.type/math :answer/value "\\frac{a-3b}{b-3}" :db/ensure [:answer/validate]} {:db/id "q-70327/selection/46bbdd96966256a9db4942fe33f2165bc76d7e30b3b1862336c84228974baed4" :answer/id #uuid "7de195a4-3939-5bdd-8de1-abf752a1afe6" :answer/type :answer.type/math :answer/value "\\frac{3a+b-3}{a(b-3)}" :db/ensure [:answer/validate]} {:db/id "q-70327/selection/de0bfeb59dce3a880ec07ae9e3bc1fe5a3106837db68141181c8035554175b3c" :answer/id #uuid "f7d788fe-0f7c-587b-8317-4b143dca4fcb" :answer/type :answer.type/math :answer/value "\\frac{b-6}{a(b-3)}" :db/ensure [:answer/validate]} {:db/id "q-70327/selection/ae598993f39d9a07730bcfd9c74cb25b112908baa51f1030d5fb906938d9af2c" :answer/id #uuid "d1848bc6-24c8-5fa8-a073-8c9d1dcca81b" :answer/type :answer.type/math :answer/value "\\frac{3a-b}{b-3}" :db/ensure [:answer/validate]} {:db/id "q-70327/selection/256b57e7719014874c385ffe287c6fa5185584f9c7c63fd32d728dfb71f5ecb5" :answer/id #uuid "4aca8816-daba-580a-bc0c-f9b2043231c4" :answer/type :answer.type/math :answer/value "\\frac{b}{a(b-3)}" :db/ensure [:answer/validate]} {:db/id "q-70327/selection" :answer-field/id #uuid "72c488d0-4778-5bf8-ba17-c45063ec0fee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70327/selection/256b57e7719014874c385ffe287c6fa5185584f9c7c63fd32d728dfb71f5ecb5" :answer-field/choices ["q-70327/selection/2d7c9cf9859e447f402dae575874d6f7977bab5913015f8bce4f0d6ca919c639" "q-70327/selection/46bbdd96966256a9db4942fe33f2165bc76d7e30b3b1862336c84228974baed4" "q-70327/selection/de0bfeb59dce3a880ec07ae9e3bc1fe5a3106837db68141181c8035554175b3c" "q-70327/selection/ae598993f39d9a07730bcfd9c74cb25b112908baa51f1030d5fb906938d9af2c" "q-70327/selection/256b57e7719014874c385ffe287c6fa5185584f9c7c63fd32d728dfb71f5ecb5"] :db/ensure [:answer-field/validate]} {:db/id "q-70327" :question/id #uuid "dca27562-adcf-5b7b-acbc-fbf75664689d" :question/math-academy-id "q-70327" :question/problem "Simplify $\\frac{3}{a(b-3)}+\\frac{1}{a}.$" :question/worked-solution "In order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $a(b-3)$ if we multiply the top and bottom of the second fraction by $b-3:$\n\n$$\n\\begin{aligned}\\frac{3}{a(b-3)}+\\frac{1}{a} & = \\\\ \\frac{3}{a(b-3)}+\\frac{b-3}{b-3}\\cdot \\frac{1}{a} & = \\\\ \\frac{3}{a(b-3)}+\\frac{b-3}{a(b-3)} & = \\\\ \\frac{3+b-3}{a(b-3)} & = \\\\ \\frac{b}{a(b-3)} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70327/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc"] :knowledge-point/questions ["q-70327"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79551/selection/b8a96ffdc2add6d91b5eba79e1ea2c8054255e78c37c389d20e6bc2d4ca16f46" :answer/id #uuid "d02d47d4-37c3-5904-83d5-113e746cfd83" :answer/type :answer.type/math :answer/value "\\frac{3t-2k}{2(k+3t)}" :db/ensure [:answer/validate]} {:db/id "q-79551/selection/5788c8d1