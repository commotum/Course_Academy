a8a11a5727b6cadcbcb080" :answer/id #uuid "901e3945-b616-58fd-8109-35770c0b765a" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-328234/field-4" :answer-field/id #uuid "08feb553-cce5-5bb9-9009-5aa815a0fd3f" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328234/field-4/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" :answer-field/choices ["q-328234/field-4/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080"] :db/ensure [:answer-field/validate]} {:db/id "q-328234" :question/id #uuid "c4c87835-c9a6-5cbd-ac5a-906e93e64385" :question/math-academy-id "q-328234" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}4 \\\\ -12\\end{aligned}]$ and $T(v)=[\\begin{aligned}7 \\\\ -21\\end{aligned}],$ what is the standard matrix $T$ of $T?$\n\n| $T=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}7 \\\\ -21\\end{aligned}] \\\\  & =\\frac{7}{4}\\cdot [\\begin{aligned}4 \\\\ -12\\end{aligned}] \\\\  & =\\frac{7}{4}v\\end{aligned}\n$$\n\nSo we have $T(v)=\\frac{7}{4}v,$ and so the linear transformation $T$ is a dilation with scale factor $k=\\frac{7}{4}.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}\\frac{7}{4} & 0 \\\\ 0 & \\frac{7}{4}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328234/field-1" "q-328234/field-2" "q-328234/field-3" "q-328234/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508"] :knowledge-point/questions ["q-328234"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78247/selection/2d8035f49bd58348c1f56162bfb7337883628018c03db1809944e8b11d2d00e4" :answer/id #uuid "db586b66-6d18-5494-a52e-33e8b3dbdddc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 0 \\\\ 0 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78247/selection/5f37db60f004bda9f0720e319361a2886eb7e864b9b15dceb53bd38f9b9aab87" :answer/id #uuid "0655f82e-fa0a-5084-ae08-81af20bc668b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 8 \\\\ 8 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78247/selection/71f89853cf32da386c4ec501feaba02fd9eb91e3a6ad6ffbf35e16c19c836d73" :answer/id #uuid "31b69651-4955-5ced-b538-93801be15f01" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78247/selection/a684a184e398a127ddebf7b5702fe8259b40d842ed23557b5720d8cb3b3ba858" :answer/id #uuid "76b4fbb5-4dd8-551a-af39-1b134ee55171" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & 1 \\\\ 1 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78247/selection/4e17330e453a94923c2db698d0e0bff4160889746211f52f8d693e92487ad55e" :answer/id #uuid "a4620a0d-b9bf-51e7-845d-b9e04b0d5e9e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 & -5 \\\\ 9 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-78247/selection" :answer-field/id #uuid "b63f5e75-b270-591d-9a68-fe9a98042bd3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78247/selection/2d8035f49bd58348c1f56162bfb7337883628018c03db1809944e8b11d2d00e4" :answer-field/choices ["q-78247/selection/2d8035f49bd58348c1f56162bfb7337883628018c03db1809944e8b11d2d00e4" "q-78247/selection/5f37db60f004bda9f0720e319361a2886eb7e864b9b15dceb53bd38f9b9aab87" "q-78247/selection/71f89853cf32da386c4ec501feaba02fd9eb91e3a6ad6ffbf35e16c19c836d73" "q-78247/selection/a684a184e398a127ddebf7b5702fe8259b40d842ed23557b5720d8cb3b3ba858" "q-78247/selection/4e17330e453a94923c2db698d0e0bff4160889746211f52f8d693e92487ad55e"] :db/ensure [:answer-field/validate]} {:db/id "q-78247" :question/id #uuid "954d7834-0128-5286-a434-cb6d547ab390" :question/math-academy-id "q-78247" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}9 \\\\ -5\\end{aligned}]$ and $T(v)=[\\begin{aligned}72 \\\\ -40\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}72 \\\\ -40\\end{aligned}] \\\\  & =8\\cdot [\\begin{aligned}9 \\\\ -5\\end{aligned}] \\\\  & =8v\\end{aligned}\n$$\n\nSo we have $T(v)=8v,$ and so the linear transformation $T$ is a dilation with scale factor $k=8.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}8 & 0 \\\\ 0 & 8\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78247/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508"] :knowledge-point/questions ["q-78247"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328216/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "addc8e22-aaac-5014-909f-83097d927c11" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-328216/field-1" :answer-field/id #uuid "0d962377-d3df-5162-9e8a-b71395e2942f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328216/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-328216/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-328216/field-2/d