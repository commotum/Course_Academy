4}^{\\pi /2} \\\\  & =-\\operatorname{csc}⁡(\\frac{\\pi }{2})-(-\\operatorname{csc}⁡(\\frac{\\pi }{4})) \\\\  & =-1-(-\\sqrt{2}) \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293393 :knowledge-point/_questions [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ae73d99-ec01-5e80-990b-771ae534e27c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}+1" :db/id #edb/ref 17592186293395} {:answer/id #uuid "05ea7cd5-d632-5009-8832-dae237e11bf7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}-1" :db/id #edb/ref 17592186293396} {:answer/id #uuid "4eb4b9a3-597e-5d45-b1d9-6767ac6c6faf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186293397} {:answer/id #uuid "e153662d-f505-5623-ac5d-fae6d487a78d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}-1" :db/id #edb/ref 17592186293398} {:answer/id #uuid "bf2104bf-ca7f-5137-a624-5aad40796e98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186293399}] :answer-field/correct {:answer/id #uuid "4eb4b9a3-597e-5d45-b1d9-6767ac6c6faf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186293397} :answer-field/id #uuid "fb41ef25-a32f-5088-a21a-cfdecc0dadca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293394}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "27bbe5a2-beb3-5de6-9f4a-7d889d9aada9" :question/math-academy-id "q-103659" :question/problem "Calculate ${\\int }_{\\pi /2}^{5\\pi /6}{csc}^{2}⁡x\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /2}^{5\\pi /6}{csc}^{2}⁡x\\,\\text{d}x & =-\\operatorname{cot}⁡x{|}_{\\pi /2}^{5\\pi /6} \\\\  & =-\\operatorname{cot}⁡(\\frac{5\\pi }{6})-(-\\operatorname{cot}⁡(\\frac{\\pi }{2})) \\\\  & =-(-\\sqrt{3})-0 \\\\  & =\\sqrt{3}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293400 :knowledge-point/_questions [{:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff" :knowledge-point/title "Evaluating the Definite Integral of an Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f639e136-9be1-574f-bb7e-62d0195da0e8" :answer/type {:db/ident :answer.type/math} :answer/value "e^5-e^2" :db/id #edb/ref 17592186293402}] :answer-field/correct {:answer/id #uuid "f639e136-9be1-574f-bb7e-62d0195da0e8" :answer/type {:db/ident :answer.type/math} :answer/value "e^5-e^2" :db/id #edb/ref 17592186293402} :answer-field/id #uuid "e6dffd01-951b-5a88-9049-67cc9e1d4bb7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293401}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4b2b1843-2765-5963-851e-94d668d7babd" :question/math-academy-id "q-346080" :question/problem "Evaluate ${\\int }_{2}^{5}{e}^{x}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{2}^{5}{e}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}{e}^{x}\\,\\text{d}x & ={e}^{x}\\,{|}_{2}^{5} \\\\  & ={e}^{5}-{e}^{2} \\\\  & ={e}^{5}-{e}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293403 :knowledge-point/_questions [{:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d2e7f3a-6035-5e23-b45c-9accd15c1613" 