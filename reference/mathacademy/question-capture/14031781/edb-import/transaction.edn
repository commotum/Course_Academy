7" :question/math-academy-id "q-73286" :question/problem "${\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{3})-(-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{2}-(-1) \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73286/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-73286"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103647/selection/023e55aeaac31f14aeb9781a705054d294042e378e1f5c5db375fb90d0fc05e9" :answer/id #uuid "d76b097e-6fb9-5a2e-b307-9bdfab2b3ec2" :answer/type :answer.type/math :answer/value "\\frac{1}{{e}^{5}}-1" :db/ensure [:answer/validate]} {:db/id "q-103647/selection/15faa77e1dea27cd1d4180a7096ac2f7529e913aee656d5ef228c44a7f8c3fb3" :answer/id #uuid "72ccb475-083c-51cd-9f28-98dbfcfc2b11" :answer/type :answer.type/math :answer/value "\\frac{1}{e}-\\frac{1}{{e}^{5}}" :db/ensure [:answer/validate]} {:db/id "q-103647/selection/9730cd7914fc842ba73c803d998889575b576a7fe4baf88602202aab15ed1c31" :answer/id #uuid "1afdd4e1-7c66-5a90-9599-2904b908e548" :answer/type :answer.type/math :answer/value "1-\\frac{1}{{e}^{5}}" :db/ensure [:answer/validate]} {:db/id "q-103647/selection/04d7f54c9b0db558cb68f468594296b6a79616c9d20ce27ce6a6690e554dacf8" :answer/id #uuid "001dfff8-b24b-5cd4-adb9-82ea220feb31" :answer/type :answer.type/math :answer/value "\\frac{1}{{e}^{5}}" :db/ensure [:answer/validate]} {:db/id "q-103647/selection/86cde93969a440e18c4d43fd8dd2e2e2bd4356f9d6a4d970a330d8501a34892e" :answer/id #uuid "9bc21fb2-f267-5d7e-8d66-369033b94d7e" :answer/ty