idate]} {:db/id "q-346080" :question/id #uuid "4b2b1843-2765-5963-851e-94d668d7babd" :question/math-academy-id "q-346080" :question/problem "Evaluate ${\\int }_{2}^{5}{e}^{x}\\,\\text{d}x.$ Do not round the answer.\n\n${\\int }_{2}^{5}{e}^{x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{5}{e}^{x}\\,\\text{d}x & ={e}^{x}\\,{|}_{2}^{5} \\\\  & ={e}^{5}-{e}^{2} \\\\  & ={e}^{5}-{e}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346080/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "902a4c93-fd7e-5444-a9c0-0f3cbdb97cff"] :knowledge-point/questions ["q-346080"] :db/ensure [:knowledge-point/validate]}]
