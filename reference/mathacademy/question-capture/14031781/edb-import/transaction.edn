operatorname{csc}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\operatorname{csc}⁡(\\frac{\\pi }{2})-(-\\operatorname{csc}⁡(\\frac{\\pi }{4})) \\\\  & =-1-(-\\sqrt{2}) \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103658/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33"] :knowledge-point/questions ["q-103658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103659/selection/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" :answer/id #uuid "bf2104bf-ca7f-5137-a624-5aad40796e98" :answer/type :answer.type/math :answer/value "-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-103659/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "4eb4b9a3-597e-5d45-b1d9-6767ac6c6faf" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-103659/selection/427b217c5a8116f0643d7b84116770558c4611a120ca29fdc9758b9674668b9f" :answer/id #uuid "8ae73d99-ec01-5e80-990b-771ae534e27c" :answer/type :answer.type/math :answer/value "\\sqrt{3}+1" :db/ensure [:answer/validate]} {:db/id "q-103659/selection/59330da4451a820becf44efbb4844fec7d6652103baf83ba0a37c8c2f81ff9d2" :answer/id #uuid "05ea7cd5-d632-5009-8832-dae237e11bf7" :answer/type :answer.type/math :answer/value "-\\sqrt{3}-1" :db/ensure [:answer/validate]} {:db/id "q-103659/selection/7c6b5bc38368b6f9e40db2ccc8d97c72bad3c796a8da6f294b6fc2d08a174be1" :answer/id #uuid "e153662d-f505-5623-ac5d-fae6d487a78d" :answer/type :answer.type/math :answer/value "\\sqrt{3}-1" :db/ensure [:answer/validate]} {:db/id "q-103659/selection" :answer-field/id #uuid "fb41ef25-a32f-5088-a21a-cfdecc0dadca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103659/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-1036