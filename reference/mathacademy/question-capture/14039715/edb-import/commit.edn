}x & 1 \\\\ 1 & 3\\end{aligned}|j+|\\begin{aligned}x & 1 \\\\ 1 & 0\\end{aligned}|k \\\\  & =(3-0)i-(3x-1)j+(0-1)k \\\\  & =⟨3,1-3x,-1⟩.\\end{aligned}\n$$\n\nNow, computing the magnitude, we get\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{{3}^{2}+(1-3x)^{2}+(-1)^{2}} \\\\  & =\\sqrt{9+(9{x}^{2}-6x+1)+1} \\\\  & =\\sqrt{9{x}^{2}-6x+11}.\\end{aligned}\n$$\n\nLastly, we solve for $x$ the following equation:\n\n$$\n\\begin{aligned}|\\,a\\times b\\,| & =\\sqrt{10} \\\\ \\sqrt{9{x}^{2}-6x+11} & =\\sqrt{10} \\\\ 9{x}^{2}-6x+11 & =10 \\\\ (3x-1)^{2} & =0 \\\\ 3x-1 & =0 \\\\ x & =\\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solution is $x=\\frac{1}{3}.$" 13194139534688 true] [17592186303500 1000 #edb/ref 17592186303501 13194139534688 true] [17592186303500 1000 #edb/ref 17592186303502 13194139534688 true] [17592186303500 1040 #edb/ref 17592186045449 13194139534688 true] [17592186303500 1041 "field-1" 13194139534688 true] [17592186303500 1104 #edb/ref 17592186303501 13194139534688 true] [17592186303500 1110 #uuid "7d308653-8f1e-5f72-8077-913f2fa9da55" 13194139534688 true] [17592186303501 1034 "\\frac{1}{3}" 13194139534688 true] [17592186303501 1103 #edb/ref 17592186045453 13194139534688 true] [17592186303501 1111 #uuid "7220f6dc-804a-5952-8aa2-ece7984a6d00" 13194139534688 true] [17592186303502 1034 "0" 13194139534688 true] [17592186303502 1103 #edb/ref 17592186045453 13194139534688 true] [17592186303502 1111 #uuid "05874c5d-4db0-5490-990d-5497c811900e" 13194139534688 true]] :edb/tempids {"q-103540" 17592186303439 "q-103540/selection" 17592186303440 "q-103540/selection/0be40a41fff2075dcd7ae30d0e6284ddf7b2ec7e519882e4636a79e6edbe7cee" 17592186303441 "q-103540/selection/2d72fb9577d14e692ee0c494e42dfc349f511e1def3de9a4ad7e2ebebd23a09a" 17592186303442 "q-103540/selection/3ce4df282068008b57541e2a0e43bc84a3288a422ec13a7d88100704c030c662" 17592186303443 "q-103540/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" 17592186303444 "q-103540/selection/