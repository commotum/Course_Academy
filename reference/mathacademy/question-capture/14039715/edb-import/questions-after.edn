ross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4e154cb-d292-52a9-a635-20805bdef250" :answer/type {:db/ident :answer.type/math} :answer/value "-6i-6j-4k" :db/id #edb/ref 17592186303469} {:answer/id #uuid "30c32d60-de9b-51e3-8825-c290f07f7e0a" :answer/type {:db/ident :answer.type/math} :answer/value "-6i+6j-4k" :db/id #edb/ref 17592186303470} {:answer/id #uuid "b4b9b164-6736-5890-964b-39b682b18c1d" :answer/type {:db/ident :answer.type/math} :answer/value "-6i-4j-4k" :db/id #edb/ref 17592186303471} {:answer/id #uuid "4e7de130-624a-5f6a-bfe3-63fa65fd68eb" :answer/type {:db/ident :answer.type/math} :answer/value "-4i-6j-4k" :db/id #edb/ref 17592186303472} {:answer/id #uuid "bc726cd7-0f0b-5b5e-b392-c095d5cfb833" :answer/type {:db/ident :answer.type/math} :answer/value "6i-4j-6k" :db/id #edb/ref 17592186303473}] :answer-field/correct {:answer/id #uuid "e4e154cb-d292-52a9-a635-20805bdef250" :answer/type {:db/ident :answer.type/math} :answer/value "-6i-6j-4k" :db/id #edb/ref 17592186303469} :answer-field/id #uuid "f69200ce-c808-5bdf-abb7-e25cfe95a796" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303468}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2cf72a1b-1303-5dd3-9dc9-70f285a698c4" :question/math-academy-id "q-19789" :question/problem "Let $a=⟨-2,2,0⟩$ and $b=⟨0,2,-3⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ -2 & 2 & 0 \\\\ 0 & 2 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ 2 & -3\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ 0 & -3\\end{aligned}|j+|\\begin{aligned}-2 & 2 \\\\ 0 & 2\\end{aligned}|k \\\\  & =((2)(-3)-(2)(0))i-((-2)(-3)-(0)(0))j+((-2)(2)-(0)(2))k \\\\  & =(-6-0)i-(6-0)j+(-4-0)k \\\\  & =-6i-6j-4k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 1759218630347