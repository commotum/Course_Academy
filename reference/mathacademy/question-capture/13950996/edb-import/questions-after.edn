#{[{:db/id #edb/ref 17592186264893 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec6185fa-5c73-5586-a0a9-4e4ccb03476d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to {3}^{-}}f(x)\\ne {lim}_{x\\to {3}^{+}}f(x)" :db/id #edb/ref 17592186264895} {:answer/id #uuid "72f66ccf-ef41-54c4-ad39-c6cc4b52a20d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to {3}^{-}}f(x)\\ne f(3)" :db/id #edb/ref 17592186264896} {:answer/id #uuid "49a8b7af-e52a-57ae-8700-b3706d8389db" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to {3}^{-}}f(x)>0" :db/id #edb/ref 17592186264897} {:answer/id #uuid "956020a8-0cca-5229-8c7d-f27a91b81b6f" :answer/type {:db/ident :answer.type/text} :answer/value "$f(3)$  does not exist" :db/id #edb/ref 17592186264898} {:answer/id #uuid "37e8b8c6-05f9-5f9a-a137-d6f5fac9db4f" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to {3}^{-}}f(x)\\ne 3" :db/id #edb/ref 17592186264899}] :answer-field/correct {:answer/id #uuid "956020a8-0cca-5229-8c7d-f27a91b81b6f" :answer/type {:db/ident :answer.type/text} :answer/value "$f(3)$  does not exist" :db/id #edb/ref 17592186264898} :answer-field/id #uuid "5c8f2adf-6c82-5526-81db-8a54996ad34a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264894}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ecb21d1-c065-5b6a-a4bd-5b61570cf37e" :question/math-academy-id "q-104129" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=3?$\n\n$$\nf(x)={\\begin{aligned}\\frac{5}{x-3}, & x<3 \\\\ -\\frac{5}{x-3}, & x>3\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=3.$\n\n- We have that $f(3)$ is not defined since $x=3$ does not belong to the domain of $f(x).$ $\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=3$ because $f(3)$ does not exist."}] [{:db/id #edb/ref 17592186264900 :knowledge-point/_questions [{:knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6736a8c4-83e7-5a08-8122-a5fa3569f09c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186264902}] :answer-field/correct {:answer/id #uuid "6736a8c4-83e7-5a08-8122-a5fa3569f09c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186264902} :answer-field/id #uuid "76626e07-2f2f-5702-b3fa-1a865730c2ec" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264901}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7dfe1c04-ab2a-5512-a89e-4792c29fa3e9" :question/math-academy-id "q-342128" :question/problem "If $f(x)$ is continuous at $x=-\\frac{3}{5}$ and ${lim}_{x\\to {(-3/5)}^{-}}f(x)=7,$ then\n\n$f(-\\frac{3}{5})=$\n{{field-1}}." :question/worked-solution "We're told that $f(x)$ is continuous at $x=-\\frac{3}{5}.$ According to the definition of continuity, this means that ${lim}_{x\\to (-3/5)}f(x)$ exists, and\n\n$$\nf(-\\frac{3}{5})={lim}_{x\\to (-3/5)}f(x)={lim}_{x\\to {(-3/5)}^{-}}f(x)=7.\n$$"}] [{:db/id #edb/ref 17592186264903 :knowledge-point/_questions [{:knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48016568-2b77-5d3b-afa6-a9cf880bab44" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186264905} {:answer/id #uuid "945df1d3-7212-563c-b240-9ce35c9979be" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186264906}] :answer-field/correct {:answer/id #uuid "945df1d3-7212-563c-b240-9ce35c9979be" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186264906} :answer-field/id #uuid "92744f46-5054-52de-9c8e-4597c808d422" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264904}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "04895225-82a3-50b3-9415-2a00cdf9e287" :question/math-academy-id "q-342241" :question/problem "If $f(x)$ is continuous at $x=3$ and $f(3)=-3,$ then\n\n${lim}_{x\\to {3}^{-}}\\frac{x+(f(x))^{3}}{2}=$\n{{field-1}}." :question/worked-solution "We're told that $f(x)$ is continuous at $x=3.$ According to the definition of continuity, this means that ${lim}_{x\\to 3}f(x)$ exists and\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)={lim}_{x\\to 3}f(x)=f(3)=-3.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}\\frac{x+(f(x))^{3}}{2} & =\\frac{3+(-3)^{3}}{2}=-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264907 :knowledge-point/_questions [{:knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93493554-3828-527c-bbd2-eb64b57ecf5d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264909}] :answer-field/correct {:answer/id #uuid "93493554-3828-527c-bbd2-eb64b57ecf5d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264909} :answer-field/id #uuid "8d267e84-08f3-52b8-af3a-00d7b8f9ba73" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264908}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e227b23a-bc8f-5586-a176-238c4b7efefa" :question/math-academy-id "q-342244" :question/problem "If $f(x)$ is continuous at $x=-2$ and $f(-2)=2,$ then\n\n${lim}_{x\\to -{2}^{-}}({x}^{3}+2(f(x))^{2})=$\n{{field-1}}." :question/worked-solution "We're told that $f(x)$ is continuous at $x=-2.$ According to the definition of continuity, this means that ${lim}_{x\\to -2}f(x)$ exists and\n\n$$\n{lim}_{x\\to -{2}^{-}}f(x)={lim}_{x\\to -2}f(x)=f(-2)=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -{2}^{-}}({x}^{3}+2(f(x))^{2}) & =(-2)^{3}+2(-2)^{2}=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264910 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32cd595f-f3df-511f-8fc4-c884f5a4245b" :answer/type {:db/ident :answer.type/text} :answer/value "${lim}_{x\\to 2}f(x)$ does not exist" :db/id #edb/ref 17592186264912} {:answer/id #uuid "a0ea26bc-8a4f-54b8-a034-57df54c96c0c" :answer/type {:db/ident :answer.type/text} :answer/value "$f(2)$ does not exist" :db/id #edb/ref 17592186264913} {:answer/id #uuid "960de3b2-f53d-58c4-aca7-321be1ad9945" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 2}f(x)\\ne f(2)" :db/id #edb/ref 17592186264914} {:answer/id #uuid "aadc80df-023b-57fc-9851-53874e16937a" :answer/type {:db/ident :answer.type/text} :answer/value "${lim}_{x\\to {2}^{+}}f(x)$ does not exist" :db/id #edb/ref 17592186264915} {:answer/id #uuid "60d96c7c-bb13-5920-a2f0-e2b60689d2ed" :answer/type {:db/ident :answer.type/text} :answer/value "${lim}_{x\\to {2}^{-}}f(x)$ does not exist" :db/id #edb/ref 17592186264916}] :answer-field/correct {:answer/id #uuid "960de3b2-f53d-58c4-aca7-321be1ad9945" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{x\\to 2}f(x)\\ne f(2)" :db/id #edb/ref 17592186264914} :answer-field/id #uuid "033ea7c7-58e8-5df4-a0d8-18ff2aaba1b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264911}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "16483a30-6f65-5f41-998f-ed4512f89b1d" :question/math-academy-id "q-48102" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=2?$\n\n$$\nf(x)={\\begin{aligned}-{x}^{2}, & x<2 \\\\ 4, & x=2 \\\\ -2x, & x>2\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=2.$\n\n- $f(2)=4,$ so $f(2)$ exists. $✓$\n\n- We calculate the one-sided limits and check if they coincide:\n\n$$\n\\begin{aligned}{lim}_{x\\to {2}^{-}}f(x) & ={lim}_{x\\to {2}^{-}}(-{x}^{2}) \\\\  & =-{2}^{2} \\\\  & =-4, \\\\ {lim}_{x\\to {2}^{+}}f(x) & ={lim}_{x\\to {2}^{+}}(-2x) \\\\  & =-2\\cdot 2 \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the overall limit exists and ${lim}_{x\\to 2}f(x)=-4$ $✓$\n\n- The limit of the function is not equal to the function value: ${lim}_{x\\to 2}f(x)=-4,$ while $f(2)=4.$ $\\,\\,\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=2$ because ${lim}_{x\\to 2}f(x)\\ne f(2).$"}]}
