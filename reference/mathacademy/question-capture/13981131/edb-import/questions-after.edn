#{[{:db/id #edb/ref 17592186282608 :knowledge-point/_questions [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf90e0f9-7c4a-5e6a-ac20-f0ed53283df4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(n+1)(n+2)}" :db/id #edb/ref 17592186282610} {:answer/id #uuid "d80e5086-00be-5940-9b39-894a8690f8d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{n({n}^{2}-1)(n+2)}" :db/id #edb/ref 17592186282611} {:answer/id #uuid "266c7cde-57bc-5ee9-a830-23be47e540ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{n(n+1)(n+2)}" :db/id #edb/ref 17592186282612} {:answer/id #uuid "44c5032a-1a98-5e1e-aa1c-c9a99cc2ef94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{n(n+2)}" :db/id #edb/ref 17592186282613} {:answer/id #uuid "2cfbe13f-7079-5e45-89b4-a4c66a6007d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{n(n+1)}" :db/id #edb/ref 17592186282614}] :answer-field/correct {:answer/id #uuid "266c7cde-57bc-5ee9-a830-23be47e540ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{n(n+1)(n+2)}" :db/id #edb/ref 17592186282612} :answer-field/id #uuid "697712c1-b32b-5f0b-8ff7-96f80ef50781" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282609}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1b7a4e72-61b2-5802-9ce6-d43dfd055160" :question/math-academy-id "q-122047" :question/problem "Given that $n\\ge 1$ is an integer, simplify $\\frac{(n-1)!}{(n+2)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+2)!=(n+2)\\cdot (n+1)\\cdot n\\cdot (n-1)!\n$$\n\nThen, we cancel the $(n-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-1)!}{(n+2)!} & =\\frac{(n-1)!}{(n+2)\\cdot (n+1)\\cdot n\\cdot (n-1)!} \\\\  & =\\frac{\\cancel{(n-1)!}}{(n+2)\\cdot (n+1)\\cdot n\\cdot \\cancel{(n-1)!}} \\\\  & =\\frac{1}{n(n+1)(n+2)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180049 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1d5905c-9b73-5e6f-9326-76974967ef2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{m + 1}" :db/id #edb/ref 17592186178285} {:answer/id #uuid "101ea4a2-aa63-5e57-9c00-cb50d4e9e869" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{m^{2} - 1}" :db/id #edb/ref 17592186178286} {:answer/id #uuid "5756272e-0652-55eb-a022-752aa47e3937" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/((m + 1)^{2})" :db/id #edb/ref 17592186178287} {:answer/id #uuid "69e07193-62d0-5ef5-b4da-9fcacbab5ab6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{m}{m + 1}" :db/id #edb/ref 17592186178288} {:answer/id #uuid "74657e9c-5dd8-5bb8-96b0-c0ca6183d8d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{m^{2}}{m^{2} - 1}" :db/id #edb/ref 17592186178289}] :answer-field/correct {:answer/id #uuid "69e07193-62d0-5ef5-b4da-9fcacbab5ab6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{m}{m + 1}" :db/id #edb/ref 17592186178288} :answer-field/id #uuid "d8947fd5-a1e9-5fdc-a699-df26a95441f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178284}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "bab2b06f-cd28-5440-a811-4e8c149dd5f5" :question/math-academy-id "q-19885" :question/problem "Given that $m\\ge 1$ is an integer, $\\frac{(m!)^{2}}{(m+1)!\\,(m-1)!}=$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(m+1)! & =(m+1)\\cdot m! \\\\ m! & =m\\cdot (m-1)!\\end{aligned}\n$$\n\nThen, we can cancel the $m!$ and $(m-1)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(m!)^{2}}{(m+1)!\\,(m-1)!} & =\\frac{m!\\cdot m!}{(m+1)!\\,(m-1)!} \\\\  & =\\frac{m!\\cdot m\\cdot (m-1)!}{(m+1)\\cdot m!\\cdot (m-1)!} \\\\  & =\\frac{\\cancel{m!}\\cdot m\\cdot \\cancel{(m-1)!}}{(m+1)\\cdot \\cancel{m!}\\cdot \\cancel{(m-1)!}} \\\\  & =\\frac{m}{m+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282615 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d643a6-2d0d-5ec2-b4f0-ebd614b4ced9" :answer/type {:db/ident :answer.type/math} :answer/value "2m" :db/id #edb/ref 17592186282617} {:answer/id #uuid "5270010c-cf99-5938-901d-33f3609790b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{m+5}" :db/id #edb/ref 17592186282618} {:answer/id #uuid "ed5d4eb1-9948-59b5-9daf-4858c4801dc0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{m}{m+4}" :db/id #edb/ref 17592186282619} {:answer/id #uuid "262ea08b-065f-530a-b1af-db097b18a811" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2m}{m+4}" :db/id #edb/ref 17592186282620} {:answer/id #uuid "ab53fae0-2a00-5112-b7e4-3d94b80f5e57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2m}{m+5}" :db/id #edb/ref 17592186282621}] :answer-field/correct {:answer/id #uuid "ab53fae0-2a00-5112-b7e4-3d94b80f5e57" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2m}{m+5}" :db/id #edb/ref 17592186282621} :answer-field/id #uuid "36d8a47d-7f09-5d5f-a2c1-4768e6ddc123" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282616}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e2798d88-2e08-5f95-8346-1e7e92e844c4" :question/math-academy-id "q-19887" :question/problem "Given that $m\\ge 1$ is an integer, simplify $\\frac{(2m)!\\,(m+4)!}{(m+5)!\\,(2m-1)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(m+5)! & =(m+5)(m+4)! \\\\ 2m! & =2m(2m-1)!\\end{aligned}\n$$\n\nThen, we can cancel the $(m+4)!$ and $(2m-1)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(2m)!\\,(m+4)!}{(m+5)!\\,(2m-1)!} & =\\frac{(2m)\\,\\cdot (2m-1)!\\cdot (m+4)!}{(m+5)\\cdot (m+4)!\\cdot (2m-1)!} \\\\  & =\\frac{(2m)\\,\\cdot \\cancel{(2m-1)!}\\cdot \\cancel{(m+4)!}}{(m+5)\\cdot \\cancel{(m+4)!}\\cdot \\cancel{(2m-1)!}} \\\\  & =\\frac{2m}{m+5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180159 :knowledge-point/_questions [{:knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "850d78f4-eaac-558f-af71-3fb1c4cb7a06" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{n}" :db/id #edb/ref 17592186178830} {:answer/id #uuid "bf9d863a-9e7c-59d5-a9de-3d799d92d3cd" :answer/type {:db/ident :answer.type/math} :answer/value "(n)/((n - 1))" :db/id #edb/ref 17592186178831} {:answer/id #uuid "d3292999-b0e2-54a9-9bfe-e140718cba9f" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(n(n - 1))" :db/id #edb/ref 17592186178832} {:answer/id #uuid "d5225802-cfc7-58d0-91db-4edd7539ff14" :answer/type {:db/ident :answer.type/math} :answer/value "n(n - 1)" :db/id #edb/ref 17592186178833} {:answer/id #uuid "2af4990f-b0ec-54b8-9a25-04f6107887e5" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/((n - 1))" :db/id #edb/ref 17592186178834}] :answer-field/correct {:answer/id #uuid "d3292999-b0e2-54a9-9bfe-e140718cba9f" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(n(n - 1))" :db/id #edb/ref 17592186178832} :answer-field/id #uuid "3c0949d3-a9b1-584f-8d22-1431c8417758" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186178829}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "96125973-2703-5b2b-b91a-4e1e001f39ba" :question/math-academy-id "q-5543" :question/problem "Given that $n\\ge 2$ is an integer, simplify $\\frac{(n-2)!}{n!}.$" :question/worked-solution "First, notice the following:\n\n$$\nn!=n\\cdot (n-1)\\cdot (n-2)!\n$$\n\nThen, we cancel the $(n-2)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-2)!}{n!} & =\\frac{(n-2)!}{n\\cdot (n-1)\\cdot (n-2)!} \\\\  & =\\frac{\\cancel{(n-2)!}}{n\\cdot (n-1)\\cdot \\cancel{(n-2)!}} \\\\  & =\\frac{1}{n(n-1)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282622 :knowledge-point/_questions [{:knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8525f013-f89c-5288-b794-6d9ab07b5c4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{k+1}" :db/id #edb/ref 17592186282624} {:answer/id #uuid "5b98aa8b-a57a-5a4c-8765-0ba0f638638f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{k-1}" :db/id #edb/ref 17592186282625} {:answer/id #uuid "dd1015a3-1e3e-5d07-886b-d83b2c4e5bd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{{k}^{2}+1}" :db/id #edb/ref 17592186282626} {:answer/id #uuid "a6c13ecd-90a6-531e-b170-87ee9740fc7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{k-1}" :db/id #edb/ref 17592186282627} {:answer/id #uuid "eee6eb3e-ee39-5d2b-92cf-be91c4e00134" :answer/type {:db/ident :answer.type/math} :answer/value "{k}^{2}-1" :db/id #edb/ref 17592186282628}] :answer-field/correct {:answer/id #uuid "8525f013-f89c-5288-b794-6d9ab07b5c4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{k}{k+1}" :db/id #edb/ref 17592186282624} :answer-field/id #uuid "3fae4b84-2a2c-57fa-becb-0e4f14c1b88b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282623}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d9b61d8a-466a-5183-b36f-e0157fbe8ab3" :question/math-academy-id "q-6398" :question/problem "Given that $k\\ge 1$ is an integer, simplify $\\frac{{k}^{2}(k-1)!}{(k+1)k!}.$" :question/worked-solution "First, we notice that\n\n$$\nk!=k(k-1)!\n$$\n\nThen, we can cancel the $k(k-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{k}^{2}(k-1)!}{(k+1)k!} & =\\frac{k\\cdot k(k-1)!}{(k+1)\\cdot k(k-1)!} \\\\  & =\\frac{k\\cdot \\cancel{k(k-1)!}}{(k+1)\\cdot \\cancel{k(k-1)!}} \\\\  & =\\frac{k}{k+1}\\end{aligned}\n$$"}]}
