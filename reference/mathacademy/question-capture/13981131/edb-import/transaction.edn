[{:db/id [:question/math-academy-id "q-5543"] :question/problem "Given that $n\\ge 2$ is an integer, simplify $\\frac{(n-2)!}{n!}.$" :question/worked-solution "First, notice the following:\n\n$$\nn!=n\\cdot (n-1)\\cdot (n-2)!\n$$\n\nThen, we cancel the $(n-2)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-2)!}{n!} & =\\frac{(n-2)!}{n\\cdot (n-1)\\cdot (n-2)!} \\\\  & =\\frac{\\cancel{(n-2)!}}{n\\cdot (n-1)\\cdot \\cancel{(n-2)!}} \\\\  & =\\frac{1}{n(n-1)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-6398/selection/a3ee66e6375d97689f3dea5460980abab5937578b9f216ddc12bd3ce32625c3f" :answer/id #uuid "dd1015a3-1e3e-5d07-886b-d83b2c4e5bd3" :answer/type :answer.type/math :answer/value "\\frac{k}{{k}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-6398/selection/2130136fef0b3778f0cc19740f9d859e90a09fd8e9624ae06dd6ce7058b3044e" :answer/id #uuid "8525f013-f89c-5288-b794-6d9ab07b5c4e" :answer/type :answer.type/math :answer/value "\\frac{k}{k+1}" :db/ensure [:answer/validate]} {:db/id "q-6398/selection/fb9e8f1a4804e86136f52008acebff7ab581a1666a130cc0ea894efdfba1e61b" :answer/id #uuid "eee6eb3e-ee39-5d2b-92cf-be91c4e00134" :answer/type :answer.type/math :answer/value "{k}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-6398/selection/267de81ea7177cb8fb182fee7f620ff5ade2d4a6c599e82fe96b6f715029bcae" :answer/id #uuid "5b98aa8b-a57a-5a4c-8765-0ba0f638638f" :answer/type :answer.type/math :answer/value "\\frac{1}{k-1}" :db/ensure [:answer/validate]} {:db/id "q-6398/selection/c1e7bc96ebbce54c364c2f7a7283cd79ad6dc82cff43e9ff7635e4ddcf4c96c7" :answer/id #uuid "a6c13ecd-90a6-531e-b170-87ee9740fc7c" :answer/type :answer.type/math :answer/value "\\frac{k}{k-1}" :db/ensure [:answer/validate]} {:db/id "q-6398/selection" :answer-field/id #uuid "3fae4b84-2a2c-57fa-becb-0e4f14c1b88b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q