cancel{m!}\\cdot m\\cdot \\cancel{(m-1)!}}{(m+1)\\cdot \\cancel{m!}\\cdot \\cancel{(m-1)!}} \\\\  & =\\frac{m}{m+1}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-19887/selection/a5f5246bde3d0b7778e13694e4e9672329f1fd71d4912507692867d0b762de18" :answer/id #uuid "262ea08b-065f-530a-b1af-db097b18a811" :answer/type :answer.type/math :answer/value "\\frac{2m}{m+4}" :db/ensure [:answer/validate]} {:db/id "q-19887/selection/cf61dae0fc6dab8cfc9f7b037dd0b03c26333af16bd8ed18fc784b7319d96c5f" :answer/id #uuid "ab53fae0-2a00-5112-b7e4-3d94b80f5e57" :answer/type :answer.type/math :answer/value "\\frac{2m}{m+5}" :db/ensure [:answer/validate]} {:db/id "q-19887/selection/53272e0ae8f2c6512453c4629677a9620ab4e2548e86342b375c6e40052213b8" :answer/id #uuid "5270010c-cf99-5938-901d-33f3609790b1" :answer/type :answer.type/math :answer/value "\\frac{1}{m+5}" :db/ensure [:answer/validate]} {:db/id "q-19887/selection/06db51ddf7e7908d59861d46aaefa0584157baed0d9135def55623bda3bf3116" :answer/id #uuid "28d643a6-2d0d-5ec2-b4f0-ebd614b4ced9" :answer/type :answer.type/math :answer/value "2m" :db/ensure [:answer/validate]} {:db/id "q-19887/selection/73afa8beb419f95c0b56fc318c3b565a1f04336202101934056085cc784c71f1" :answer/id #uuid "ed5d4eb1-9948-59b5-9daf-4858c4801dc0" :answer/type :answer.type/math :answer/value "\\frac{m}{m+4}" :db/ensure [:answer/validate]} {:db/id "q-19887/selection" :answer-field/id #uuid "36d8a47d-7f09-5d5f-a2c1-4768e6ddc123" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19887/selection/cf61dae0fc6dab8cfc9f7b037dd0b03c26333af16bd8ed18fc784b7319d96c5f" :answer-field/choices ["q-19887/selection/a5f5246bde3d0b7778e13694e4e9672329f1fd71d4912507692867d0b762de18" "q-19887/selection/cf61dae0fc6dab8cfc9f7b037dd0b03c26333af16bd8ed18fc784b7319d96c5f" "q-19887/selection/53272e0ae8f2c6512453c4629677a9620ab4e2548e86342b375c6e40052213b8" "q-19887/selection/06db51ddf7e7908d5