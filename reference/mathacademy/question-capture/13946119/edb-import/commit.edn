9533806 true] [17592186252638 1113 #uuid "1386b559-f9dd-57ac-becb-7fb77e0e7576" 13194139533806 true] [17592186252638 1145 "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AB\\cdot BC.\n$$\n\nWe are given that $m∠A={60}^{∘}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AB}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AB} \\\\ \\operatorname{tan}⁡({60}^{∘}) & =\\frac{x+2}{\\sqrt{3}\\,x} \\\\ \\sqrt{3} & =\\frac{x+2}{\\sqrt{3}\\,x} \\\\ \\sqrt{3}(\\sqrt{3}\\,x) & =x+2 \\\\ 3x & =x+2 \\\\ 2x & =2 \\\\ x & =1\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}BC & =x+2=1+2=3, \\\\ AB & =\\sqrt{3}\\,x=\\sqrt{3}(1)=\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot \\sqrt{3}\\cdot 3 \\\\  & =\\frac{3\\sqrt{3}}{2}.\\end{aligned}\n$$" 13194139533806 true] [17592186252639 1000 #edb/ref 17592186252640 13194139533806 true] [17592186252639 1000 #edb/ref 17592186252641 13194139533806 true] [17592186252639 1000 #edb/ref 17592186252642 13194139533806 true] [17592186252639 1000 #edb/ref 17592186252643 13194139533806 true] [17592186252639 1000 #edb/ref 17592186252644 13194139533806 true] [17592186252639 1040 #edb/ref 17592186045450 13194139533806 true] [17592186252639 1041 "selection" 13194139533806 true] [17592186252639 1104 #edb/ref 17592186252643 13194139533806 true] [17592186252639 1110 #uuid "19e5c726-5f44-5c16-93a4-0a873dc2a2c7" 13194139533806 true] [17592186252640 1034 "\\frac{9\\sqrt{3}}{2}" 13194139533806 true] [17592186252640 1103 #edb/ref 17592186045453 13194139533806 true] [17592186252640 1111 #uuid "af187634-a302-5b48-8602-42eb66afceb0" 13194139533806 true] [17592186252641 1034 "2\\sqrt{3}" 13194139533806 true] [17592186252641 1103 #edb/ref 17592186045453 131941395338