#{[{:db/id #edb/ref 17592186087928 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a48fa181-4b87-58a5-8982-f7bd1543ffbb" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186084580} {:answer/id #uuid "b2bfd71d-be6a-5213-b584-494fc8d57128" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186084581} {:answer/id #uuid "dff8ce25-a4b5-5ebd-8746-1198b79cbdc6" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186084582} {:answer/id #uuid "fb605f8d-af27-5ebe-a9dc-17cebc5bec9b" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186084583} {:answer/id #uuid "359451d1-a627-5152-b123-4515b7d7b5af" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186084584}] :answer-field/correct {:answer/id #uuid "b2bfd71d-be6a-5213-b584-494fc8d57128" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186084581} :answer-field/id #uuid "f021e344-b1e5-51fb-adc9-8fe7c497cc1c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084579}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dd3fba16-5fcc-50bc-8866-44ee67a3b9b6" :question/math-academy-id "q-11718" :question/problem "Which of the matrices below are singular?\n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 \\\\ 1 \\\\ -2\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $A$, we have\n\n$$\ndet(A)=0\\cdot 0-1\\cdot 1=-1.\n$$\n\nBecause $det(A)\\ne 0,$ we conclude that $A$ is invertible.\n\n- The matrix $B$ is a $3\\times 1$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 0-0\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible. Since $C$ is a square matrix that is not invertible, we also say that $C$ is singular.\n\nTherefore, only $C$ is singular."}] [{:db/id #edb/ref 17592186293804 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e38e2950-b33d-57e2-ac54-303fa190d88b" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186293806} {:answer/id #uuid "dedd7c41-6862-5d00-9cc7-35fd026d3c9e" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186293807} {:answer/id #uuid "4961011c-5cfc-5a70-9553-cb8662177cca" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{2}{3}" :db/id #edb/ref 17592186293808} {:answer/id #uuid "72091842-7dda-5fe5-9f45-c59b698a6daa" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{3}{2}" :db/id #edb/ref 17592186293809} {:answer/id #uuid "93175766-554d-5f98-995c-8a8465cf6ff8" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186293810}] :answer-field/correct {:answer/id #uuid "dedd7c41-6862-5d00-9cc7-35fd026d3c9e" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186293807} :answer-field/id #uuid "ad7c601f-504d-5f29-b9cb-02750eaaed08" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293805}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "62137868-7223-57f4-91c5-f73e65369a0e" :question/math-academy-id "q-11721" :question/problem "If $Q=[\\begin{aligned}3 & 6 \\\\ x & x\\end{aligned}]$ is a singular matrix, calculate the value of $x.$" :question/worked-solution "The matrix $Q$ is singular if and only if $det(Q)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(Q) & =3\\cdot x-x\\cdot 6 \\\\  & =3x-6x \\\\  & =-3x\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-3x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nTherefore, the value of $x$ is $x=0.$"}] [{:db/id #edb/ref 17592186293811 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "467d76df-1d50-5b9c-8869-a83fa9eccf2f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186293813} {:answer/id #uuid "f9d6119f-9517-593b-9834-38494d8d00af" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186293814} {:answer/id #uuid "cbc018ff-03c6-5810-ae51-3b027c1419df" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186293815} {:answer/id #uuid "34579017-7361-5dc4-a5fe-28c2f6510e66" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186293816} {:answer/id #uuid "2ca1bd59-4484-5b5e-ad7b-e319cc4eec55" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186293817}] :answer-field/correct {:answer/id #uuid "467d76df-1d50-5b9c-8869-a83fa9eccf2f" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186293813} :answer-field/id #uuid "7d244270-8b63-5656-8fa2-5e415614be7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293812}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "37527fee-ef2e-503d-b544-20319e41e15b" :question/math-academy-id "q-127762" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}1 & 5 \\\\ 1 & 0 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}4 & 3 \\\\ -2 & -1\\end{aligned}],\\,C=[\\begin{aligned}4 & 12 \\\\ 3 & 9\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=4\\cdot (-1)-(-2)\\cdot 3=2.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=4\\cdot 9-3\\cdot 12=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."}] [{:db/id #edb/ref 17592186293818 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b143ed6d-3f8a-5a5f-9b22-6a3acb7a18ab" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186293820} {:answer/id #uuid "b0d1eee9-040f-510d-b5a6-b707a05db1ec" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293821}] :answer-field/correct {:answer/id #uuid "b0d1eee9-040f-510d-b5a6-b707a05db1ec" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293821} :answer-field/id #uuid "88f236f3-feef-563d-a98b-ee60e0ff782a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293819}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0047a425-3434-51cf-8bea-b68dedd67cd7" :question/math-academy-id "q-316782" :question/problem "If $B=[\\begin{aligned}1 & 2 \\\\ 3x+2 & 2x-4\\end{aligned}]$\nis a singular matrix, calculate the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =1\\cdot (2x-4)-2\\cdot (3x+2) \\\\  & =2x-4-6x-4 \\\\  & =-4x-8.\\end{aligned}\n$$\n\nFinally, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-4x-8 & =0 \\\\ -4x & =8 \\\\ x & =-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186293822 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f49a3a5a-a1bf-5a07-8daf-be24ac11f73b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293824}] :answer-field/correct {:answer/id #uuid "f49a3a5a-a1bf-5a07-8daf-be24ac11f73b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186293824} :answer-field/id #uuid "dcba2a08-0178-52dc-b69b-1958b893f397" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293823} {:answer-field/choices [{:answer/id #uuid "6fe14545-3f42-5112-8345-a43cf7328897" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293826}] :answer-field/correct {:answer/id #uuid "6fe14545-3f42-5112-8345-a43cf7328897" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186293826} :answer-field/id #uuid "73ed046a-6b66-5adc-8d34-be39580d96ad" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293825}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "877694df-7d13-5599-a77e-7aa2ec2835a6" :question/math-academy-id "q-316825" :question/problem "Let $B=[\\begin{aligned}2x+4 & 0 \\\\ 15 & -x-3\\end{aligned}]$\nbe a singular matrix. **In ascending order**, the values of $x$ are\n\n$x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "The matrix $B$ is singular if and only if $det(B)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(B) & =(2x+4)\\cdot (-x-3)-0\\cdot 15 \\\\  & =-2{x}^{2}-6x-4x-12 \\\\  & =-2{x}^{2}-10x-12.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $x:$\n\n$$\n\\begin{aligned}-2{x}^{2}-10x-12 & =0 \\\\ -2({x}^{2}+5x+6) & =0 \\\\ (x+3)(x+2) & =0 \\\\ x & =-3,-2\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $x$ are\n\n$$\nx=-3\\,\\text{and}\\,x=-2.\n$$"}]}
