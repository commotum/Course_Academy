}t}(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t) \\\\  & =-\\operatorname{sin}⁡t+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =t\\operatorname{cos}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t-(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{(t\\operatorname{cos}⁡t)}^{2}+{(t\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{t}^{2}{cos}^{2}⁡t+{t}^{2}{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{t}^{2}({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\sqrt{{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }t\\,\\text{d}t \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}}{2}-0 \\\\  & =2{\\pi }^{2}.\\end{aligned}\n$$" 13194139535208 true] [17592186337693 1000 #edb/ref 17592186337694 13194139535208 true] [17592186337693 1040 #edb/ref 17592186045449 13194139535208 true] [17592186337693 1041 "field-1" 13194139535208 true] [17592186337693 1104 #edb/ref 17592186337694 13194139535208 true] [17592186337693 1110 #uuid "42de287f-50e0-5642-9370-c74cd9501015" 13194139535208 true] [17592186337694 1034 "2\\pi^2" 13194139535208 true] [17592186337694 1103 #edb/ref 17592186045453 13194139535208 true] [17592186337694 1111 #uuid "f21b4205-fe95-5d61-aa2e-072832d7192a" 13194139535208 true]] :edb/tempids {"q-123027" 17592186337671 "q-123027/selection" 17592186337672 "q-123027/selection/02a712f50b68587e6da3d0e583acc9280edcb8d46df8121d35cb2158daf58aa9" 17592186337673 "q-123027/selection/3d21b06e853b67d14326e86db991591505276fb67291f1bb