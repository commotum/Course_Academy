#{[{:db/id #edb/ref 17592186343714 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24382456-110a-5c22-ac1b-99c764eaa883" :answer/type {:db/ident :answer.type/math} :answer/value "1-21t+550{t}^{2}+⋯" :db/id #edb/ref 17592186343716} {:answer/id #uuid "2b7405ef-180c-5e34-88bd-22fab1e2a45b" :answer/type {:db/ident :answer.type/math} :answer/value "1-35t+525{t}^{2}+⋯" :db/id #edb/ref 17592186343717} {:answer/id #uuid "1c8b72aa-d6c6-5592-b992-b44117372f84" :answer/type {:db/ident :answer.type/math} :answer/value "1-35t+500{t}^{2}+⋯" :db/id #edb/ref 17592186343718} {:answer/id #uuid "c31ff4a0-c2f7-5757-8408-08f8e7334d82" :answer/type {:db/ident :answer.type/math} :answer/value "1+25t+450{t}^{2}+⋯" :db/id #edb/ref 17592186343719} {:answer/id #uuid "dcea0204-2495-5161-a1c4-2c49ce230c3b" :answer/type {:db/ident :answer.type/math} :answer/value "1+35t+485{t}^{2}+⋯" :db/id #edb/ref 17592186343720}] :answer-field/correct {:answer/id #uuid "2b7405ef-180c-5e34-88bd-22fab1e2a45b" :answer/type {:db/ident :answer.type/math} :answer/value "1-35t+525{t}^{2}+⋯" :db/id #edb/ref 17592186343717} :answer-field/id #uuid "454c71e5-cccf-58a6-90ef-e67c5530faf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186343715}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "93e6b933-e61e-5a9a-86f8-80581468e410" :question/math-academy-id "q-135990" :question/problem "${(1-5t)}^{7}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-5t$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-5t)}^{7} & =1+7\\cdot (-5t)+\\frac{7(7-1)}{2!}\\cdot (-5t)^{2}+⋯ \\\\  & =1-35t+\\frac{7\\cdot 6}{2}\\cdot 25{t}^{2}+⋯ \\\\  & =1-35t+21\\cdot 25{t}^{2}+⋯ \\\\  & =1-35t+525{t}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186343721 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "836392e0-9c61-5af5-b537-1d1956bc2624" :answer/type {:db/ident :answer.type/math} :answer/value "97" :db/id #edb/ref 17592186343723}] :answer-field/correct {:answer/id #uuid "836392e0-9c61-5af5-b537-1d1956bc2624" :answer/type {:db/ident :answer.type/math} :answer/value "97" :db/id #edb/ref 17592186343723} :answer-field/id #uuid "2511b505-7340-521c-8ac6-22e68f230d06" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343722} {:answer-field/choices [{:answer/id #uuid "bd439727-a89f-5011-8022-234538a782bb" :answer/type {:db/ident :answer.type/math} :answer/value "-118" :db/id #edb/ref 17592186343725}] :answer-field/correct {:answer/id #uuid "bd439727-a89f-5011-8022-234538a782bb" :answer/type {:db/ident :answer.type/math} :answer/value "-118" :db/id #edb/ref 17592186343725} :answer-field/id #uuid "089c19c4-90bb-5e5b-877d-ea9fb78b065e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343724} {:answer-field/choices [{:answer/id #uuid "64395931-9062-5802-aaf6-d529cefdaddb" :answer/type {:db/ident :answer.type/math} :answer/value "59" :db/id #edb/ref 17592186343727}] :answer-field/correct {:answer/id #uuid "64395931-9062-5802-aaf6-d529cefdaddb" :answer/type {:db/ident :answer.type/math} :answer/value "59" :db/id #edb/ref 17592186343727} :answer-field/id #uuid "bde38d0a-ed99-5cd8-aad0-6e4a79f2944b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343726} {:answer-field/choices [{:answer/id #uuid "279a4b72-f9ce-50ac-b2ac-593bbb501a05" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186343729}] :answer-field/correct {:answer/id #uuid "279a4b72-f9ce-50ac-b2ac-593bbb501a05" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186343729} :answer-field/id #uuid "709c9dfd-3c35-5887-8504-55c653b794b3" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343728}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2b2c5b2b-c1cc-5494-8426-31e14143c9c4" :question/math-academy-id "q-279424" :question/problem "Consider the matrix $H=[\\begin{aligned}5 & -2 \\\\ 1 & 4\\end{aligned}].$ Find ${H}^{3}.$\n\n| ${H}^{3}=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "First, to find ${H}^{2},$ we multiply $H$ by itself:\n\n$$\n\\begin{aligned}{H}^{2} & =H\\cdot H \\\\  & =[\\begin{aligned}5 & -2 \\\\ 1 & 4\\end{aligned}]\\cdot [\\begin{aligned}5 & -2 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}23 & -18 \\\\ 9 & 14\\end{aligned}]\\end{aligned}\n$$\n\nNow, since ${H}^{3}={H}^{2}\\cdot H,$ we get\n\n$$\n\\begin{aligned}{H}^{3} & ={H}^{2}\\cdot H \\\\  & =[\\begin{aligned}23 & -18 \\\\ 9 & 14\\end{aligned}]\\cdot [\\begin{aligned}5 & -2 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}97 & -118 \\\\ 59 & 38\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186343730 :knowledge-point/_questions [{:knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5de5934-d762-554e-9bc6-54960f23fa75" :answer/type {:db/ident :answer.type/math} :answer/value "205" :db/id #edb/ref 17592186343732} {:answer/id #uuid "b9a344ae-c1a6-5f5f-a096-a66d926f1d2c" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186343733}] :answer-field/correct {:answer/id #uuid "d5de5934-d762-554e-9bc6-54960f23fa75" :answer/type {:db/ident :answer.type/math} :answer/value "205" :db/id #edb/ref 17592186343732} :answer-field/id #uuid "deb06272-2dd7-53c0-a9ac-40dfef3ec089" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343731} {:answer-field/choices [{:answer/id #uuid "737ee07b-e384-58c6-b1e3-24519c6cc192" :answer/type {:db/ident :answer.type/math} :answer/value "335" :db/id #edb/ref 17592186343735}] :answer-field/correct {:answer/id #uuid "737ee07b-e384-58c6-b1e3-24519c6cc192" :answer/type {:db/ident :answer.type/math} :answer/value "335" :db/id #edb/ref 17592186343735} :answer-field/id #uuid "712f34e8-a73a-51dc-8e5e-7f215f9c90ce" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343734}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "190ea00f-cebd-5a8c-93af-4aa5ffc827ba" :question/math-academy-id "q-338763" :question/problem "Expressed in **ascending order** in degrees, rounded to the nearest integer, the solutions to the equation $-\\operatorname{csc}⁡x=7+2\\operatorname{csc}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ are\n\n$x≈$\n{{field-1}}${}^{∘},\\,x≈$\n{{field-2}}${}^{∘}.$" :question/requires-calculator true :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}-\\operatorname{csc}⁡x & =7+2\\operatorname{csc}⁡x \\\\ -3\\operatorname{csc}⁡x & =7 \\\\ \\operatorname{csc}⁡x & =-\\frac{7}{3}\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{3}{7}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{3}{7})=(-25.376\\,933…)^{∘}≈-{25.377}^{∘}\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}:$\n\n$$\n{x}_{1}=-{25.377}^{∘}+{360}^{∘}={334.623}^{∘}\n$$\n\nSo,  our first solution is ${x}_{1}={334.623}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={25.377}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={25.377}^{∘}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14062614/assets/2358d2c829f52ba8727afc10a609f923ca441bb55dc398cda78c619454f6eac5.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{25.377}^{∘} \\\\  & ={205.377}^{∘}\\end{aligned}\n$$\n\nSo, in ascending order, rounded to the nearest integer, the solutions are \n\n$$\nx≈{205}^{∘},\\,x≈{335}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186343736 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d73c84b8-1e28-5cae-a18d-1cf0d787882d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+11}{7}" :db/id #edb/ref 17592186343738}] :answer-field/correct {:answer/id #uuid "d73c84b8-1e28-5cae-a18d-1cf0d787882d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+11}{7}" :db/id #edb/ref 17592186343738} :answer-field/id #uuid "86959dbd-2403-5dd4-b220-c2a739f4834b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186343737}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4c4511dd-c475-5538-9512-79a65c337158" :question/math-academy-id "q-342050" :question/problem "Given a curve $x=-\\frac{5}{y}+{y}^{2},$ what is the equation of the tangent to the curve at the point $(-4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{5}{y}+{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-5{y}^{-1}+{y}^{2}) \\\\  & =-5\\frac{\\text{d}}{\\text{d}y}({y}^{-1})+\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =-5(-{y}^{-2})+2y \\\\  & =2y+5{y}^{-2} \\\\  & =2y+\\frac{5}{{y}^{2}} \\\\  & =\\frac{2{y}^{3}+5}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{2{y}^{3}+5}.\n$$\n\nThe slope of the tangent to the curve at the point $(-4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(-4,1)} \\\\  & =\\frac{{1}^{2}}{2(1)^{3}+5} \\\\  & =\\frac{1}{2+5} \\\\  & =\\frac{1}{7}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =\\frac{1}{7}\\cdot (x-(-4)) \\\\ y & =\\frac{1}{7}x+\\frac{4}{7}+1 \\\\ y & =\\frac{1}{7}x+\\frac{11}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341026 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4409a5c3-5e66-534b-81cf-a45d267f8f33" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186341028} {:answer/id #uuid "80e9758c-9a9d-501e-acdd-8edae6497aa2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186341029} {:answer/id #uuid "1a60afa0-87a8-563c-947c-81930061bf2b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186341030} {:answer/id #uuid "0db9517c-3b12-5885-be39-a3d9a058c17a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186341031} {:answer/id #uuid "13c6a24d-e3e2-578f-8e6e-f957fd31070c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186341032}] :answer-field/correct {:answer/id #uuid "4409a5c3-5e66-534b-81cf-a45d267f8f33" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186341028} :answer-field/id #uuid "fc8d34a6-4776-5b40-b346-006e20b21505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341027}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "64dd18d8-103a-5d01-8ec8-0d7d40e61a5d" :question/math-academy-id "q-35836" :question/problem "Given that the horizontal asymptote of the function $f(x)=\\frac{24{x}^{3}-1}{2c{x}^{3}-15{x}^{2}}$ is $y=-\\frac{1}{3},$ find the value of $c.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{24{x}^{3}-1}{2c{x}^{3}-15{x}^{2}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{24{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})}{(\\frac{2c{x}^{3}}{{x}^{3}}-\\frac{15{x}^{2}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(24-\\frac{1}{{x}^{3}})}{(2c-\\frac{15}{x})} \\\\  & =\\frac{24-0}{2c-0} \\\\  & =\\frac{12}{c}.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{12}{c} & =-\\frac{1}{3} \\\\ c & =-36.\\end{aligned}\n$$"}]}
