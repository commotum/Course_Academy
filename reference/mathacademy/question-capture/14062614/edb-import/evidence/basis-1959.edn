#{[{:db/id #edb/ref 17592186341026 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4409a5c3-5e66-534b-81cf-a45d267f8f33" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186341028} {:answer/id #uuid "80e9758c-9a9d-501e-acdd-8edae6497aa2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186341029} {:answer/id #uuid "1a60afa0-87a8-563c-947c-81930061bf2b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186341030} {:answer/id #uuid "0db9517c-3b12-5885-be39-a3d9a058c17a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186341031} {:answer/id #uuid "13c6a24d-e3e2-578f-8e6e-f957fd31070c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186341032}] :answer-field/correct {:answer/id #uuid "4409a5c3-5e66-534b-81cf-a45d267f8f33" :answer/type {:db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186341028} :answer-field/id #uuid "fc8d34a6-4776-5b40-b346-006e20b21505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341027}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "64dd18d8-103a-5d01-8ec8-0d7d40e61a5d" :question/math-academy-id "q-35836" :question/problem "Given that the horizontal asymptote of the function $f(x)=\\frac{24{x}^{3}-1}{2c{x}^{3}-15{x}^{2}}$ is $y=-\\frac{1}{3},$ find the value of $c.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{24{x}^{3}-1}{2c{x}^{3}-15{x}^{2}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{24{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})}{(\\frac{2c{x}^{3}}{{x}^{3}}-\\frac{15{x}^{2}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(24-\\frac{1}{{x}^{3}})}{(2c-\\frac{15}{x})} \\\\  & =\\frac{24-0}{2c-0} \\\\  & =\\frac{12}{c}.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{12}{c} & =-\\frac{1}{3} \\\\ c & =-36.\\end{aligned}\n$$"}]}
