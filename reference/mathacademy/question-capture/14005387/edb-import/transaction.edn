1efe1c774480461a138cd5f0c3"] :db/ensure [:answer-field/validate]} {:db/id "q-12841" :question/id #uuid "26d64e14-48be-5cd9-8f9a-40fbb0ecc51d" :question/math-academy-id "q-12841" :question/problem "${(s-t)}^{9}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+…+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(s-t)}^{9},$ we have  $a=s,$ $b=-t,$ $n=9.$ \n\nTherefore, the first three terms of ${(s-t)}^{9}$ are as follows:\n\n$$\n\\begin{aligned}{(s-t)}^{9} & =(\\frac{9}{0}){(s)}^{9}{(-t)}^{0}+(\\frac{9}{1}){(s)}^{9-1}{(-t)}^{1}+(\\frac{9}{2}){(s)}^{9-2}{(-t)}^{2}+… \\\\  & =1{(s)}^{9}+9{(s)}^{8}{(-t)}^{1}+36{(s)}^{7}{(-t)}^{2}+… \\\\  & =1({s}^{9})+9({s}^{8})(-t)+36({s}^{7})({t}^{2})+… \\\\  & ={s}^{9}-9{s}^{8}t+36{s}^{7}{t}^{2}+…\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12841/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29896622-4bcb-5ad2-91d0-47c5911a619e"] :knowledge-point/questions ["q-12841"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18621/selection/f2d93ea59bd63ae2d383a218117c572dfd32c3c2bbcb56fed58e84e82187a063" :answer/id #uuid "f3688491-67a7-520d-8cf9-14d761f08153" :answer/type :answer.type/math :answer/value "560" :db/ensure [:answer/validate]} {:db/id "q-18621/selection/379e0fff5970df4d8c4f3d2af03ce2cf3d1717db20a8e2497a6551c14a07f2f6" :answer/id #uuid "13a0f83f-28b2-582f-bb78-acd923a383e1" :answer/type :answer.type/math :answer/value "880" :db/ensure [:answer/validate]} {:db/id "q-18621/selection/41418413a23436e4267a65dad3bc32d2bb228e9857dc7f524fdb94f21ff7f7fb" :answer/id #uuid "d9b5f27d-5a1d-5fa0-8f5b-772b8e15357a" :answer/type :answer.type/math :answer/value "702" :db/ensure [:answer/validate]} {:db/id "q-18621/selection/2d3e68ad0d13afe613d8a8766776d74305e72b2b5bbdf206aaa9b95a47dfe988" :answer/id #uuid "b5663ebb-e56f-550b-a880-6e7d45446d25" :answer/type :answer.type/math :answer/value "908" :db/ensure [:answer/validate]} {:db/id "q-18621/selection/de71689db3524c73722131e4d2c999a60a9161a4dc41cd04b5bc49a49e61f6ab" :answer/id #uuid "d611b0ca-b30a-5d1b-ad4b-ff28f17fd8fb" :answer/type :answer.type/math :answer/value "512" :db/ensure [:answer/validate]} {:db/id "q-18621/selection" :answer-field/id #uuid "a5768e4a-4307-59ef-ac7a-aac421db0dd7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18621/selection/41418413a23436e4267a65dad3bc32d2bb228e9857dc7f524fdb94f21ff7f7fb" :answer-field/choices ["q-18621/selection/f2d93ea59bd63ae2d383a218117c572dfd32c3c2bbcb56fed58e84e82187a063" "q-18621/selection/379e0fff5970df4d8c4f3d2af03ce2cf3d1717db20a8e2497a6551c14a07f2f6" "q-18621/selection/41418413a23436e4267a65dad3bc32d2bb228e9857dc7f524fdb94f21ff7f7fb" "q-18621/selection/2d3e68ad0d13afe613d8a8766776d74305e72b2b5bbdf206aaa9b95a47dfe988" "q-18621/selection/de71689db3524c73722131e4d2c999a60a9161a4dc41cd04b5bc49a49e61f6ab"] :db/ensure [:answer-field/validate]} {:db/id "q-18621" :question/id #uuid "eb8bdf03-c0dc-5ef8-8cc5-e037aae4166c" :question/math-academy-id "q-18621" :question/problem "The coefficient of ${x}^{22}$ in the expansion of ${(3+{x}^{2})}^{13}$ is" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+…+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(3+{x}^{2})}^{13},$ we have $a=3,$ $b={x}^{2},$ and $n=13.$ Therefore,\n\n$$\n\\begin{aligned}{(3+{x}^{2})}^{13}=(\\frac{13}{0}){3}^{13}{({x}^{2})}^{0}+(\\frac{13}{1}){3}^{13-1}{({x}^{2})}^{1}+(\\frac{13}{2}){3}^{13-2}{({x}^{2})}^{2}+⋯+(\\frac{13}{13}){3}^{13-13}{({x}^{2})}^{13}.\\end{aligned}\n$$\n\nFrom here, we see that the ${x}^{22}$ term must be\n\n$$\n(\\frac{13}{11}){3}^{13-11}{({x}^{2})}^{11}.\n$$\n\nSimplifying this term, we get\n\n$$\n\\begin{aligned}(\\frac{13}{11}){3}^{13-11}{({x}^{2})}^{11} & =78\\cdot {3}^{2}\\cdot {x}^{22} \\\\  & =78\\cdot 9\\cdot {x}^{22} \\\\  & =702{x}^{22}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{22}$ is $702.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-18621/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8de0dd63-23c6-5926-9e33-71e517949af2"] :knowledge-point/questions ["q-18621"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-113627"] :question/problem "The coefficient of ${x}^{7}$ in the expansion of ${(4+x)}^{9}$ is" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(4+x)}^{9},$ we have $a=4,$ $b=x,$ and $n=9.$ Therefore,\n\n$$\n\\begin{aligned}(4+x)^{9}=(\\frac{9}{0}){4}^{9}{x}^{0}+(\\frac{9}{1}){4}^{9-1}{x}^{1}+(\\frac{9}{2}){4}^{9-2}{x}^{2}+⋯+(\\frac{9}{9}){4}^{9-9}{x}^{9}.\\end{aligned}\n$$\n\nFrom here, we see that the ${x}^{7}$ term must be\n\n$$\n(\\frac{9}{7}){4}^{9-7}{x}^{7}.\n$$\n\nEvaluating the coefficient, we get\n\n$$\n\\begin{aligned}(\\frac{9}{7}){4}^{9-7} & =36\\cdot {4}^{2} \\\\  & =36\\cdot 16 \\\\  & =576.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{7}$ is $576.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-135896"] :question/problem "$(4-x)^{4}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of $(4-x)^{4},$ we have  $a=4,$ $b=-x,$ $n=4.$ \n\nTherefore, the first three terms of $(4-x)^{4}$ are as follows:\n\n$$\n\\begin{aligned}{(4-x)}^{4} & =(\\frac{4}{0}){(4)}^{4}{(-x)}^{0}+(\\frac{4}{1}){(4)}^{4-1}{(-x)}^{1}+(\\frac{4}{2}){(4)}^{4-2}{(-x)}^{2}+… \\\\  & =1{(4)}^{4}+4{(4)}^{3}{(-x)}^{1}+6{(4)}^{2}{(-x)}^{2}+… \\\\  & =256-256x+96{x}^{2}+⋯\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-136011/selection/6d5543d895f4a9f8f8176c71b151b08fdcc0a4300c66a81cc63b20596b8888c7" :answer/id #uuid "cd6df536-6d21-56d3-922d-f10bfb498344" :answer/type :answer.type/math :answer/value "81+27x+18{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136011/selection/8e6e9a58e39c68538428c1499006ca37df6b5ed7cb9f99c53698d9e562c239f8" :answer/id #uuid "5173a1f7-9360-56df-94fb-7347c2d3d7b4" :answer/type :answer.type/math :answer/value "81-27x+54{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136011/selection/687d31c30232f3fc21f9007eec62336dccd6b001f8e45a966b071d6fe9edef4f" :answer/id #uuid "6d55296b-5aac-5d71-9f25-b360d582e92e" :answer/type :answer.type/math :answer/value "81-108x-9{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136011/selection/fa9064b2835739ac11f2bfc7fa126efeb865f187aec6225679a1d0e6b42e85d1" :answer/id #uuid "259e697b-436f-58ea-92b5-8bc6ced2ef5a" :answer/type :answer.type/math :answer/value "81-108x+9{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136011/selection/7461a7a4323fc51f72b870554d9ebd5be2fc8e8efab409f04ef1b86e8ae66a32" :answer/id #uuid "2094cff9-99e6-5835-97b3-953308ea58a5" :answer/type :answer.type/math :answer/value "81-108x+54{x}^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-136011/selection" :answer-field/id #uuid "2ecae32b-8e41-5446-95a6-c4a7301808da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136011/selection/7461a7a4323fc51f72b870554d9ebd5be2fc8e8efab409f04ef1b86e8ae66a32" :answer-field/choices ["q-136011/selection/6d5543d895f4a9f8f8176c71b151b08fdcc0a4300c66a81cc63b20596b8888c7" "q-136011/selection