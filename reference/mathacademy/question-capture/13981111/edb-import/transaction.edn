[{:db/id [:question/math-academy-id "q-47650"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981111/assets/8e7daf95fadbe2262a09e8183f00d63075655f3b97dd363984c192ac3414ad17.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. At which points is the function $f(x)$ **not** differentiable?" :question/worked-solution "The function is not differentiable wherever it has a discontinuity, corner, cusp, or vertical tangent.\n\n- At $x=-2$ the function has a cusp, so it's not differentiable there.\n\n- At $x=0$ the function has a jump discontinuity, so it's not differentiable there.\n\n- At $x=2$ the function has an infinite discontinuity, so it's not differentiable there.\n\nTherefore, the correct answer is $x=-2$, $x=0$, and $x=2.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} [:db/retract 17592186115797 :question/answer-fields 17592186114153] {:db/id "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/99db94ef52aab7878f295e2e52208eb683dd9e069b814d2aa5485a5af9dcc5f5" :answer/id #uuid "9b585a37-6598-5862-aed2-90725e72015a" :answer/type :answer.type/math :answer/value "q(x)={\\begin{aligned}x-3, & x<3 \\\\ x+3, & x\\ge 3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/793df2a592a1633db3622edc903d47631114750daf7da3b8a9e4c4a51d7db9ca" :answer/id #uuid "efe17991-0589-557d-933d-2c09e635dbf5" :answer/type :answer.type/math :answer/value "f(x)=\\frac{3}{\\sqrt[3]{x-3}}" :db/ensure [:answer/validate]} {:db/id "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/5c6c9df76f993864839b0f56a755f90170f6bc330869e7b806e688cddf3f1ab7" :answer/id #uuid "db442a7d-d3e2-529a-9d0a-6c69508a1724" :answer/type :answer.type/math :answer/value "h(x)=\\sqrt[3]{x-3}" :db/ensure [:answer/validate]} {:db/id "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/81f997af51e0df770a5aec48ac0d40ced88575973cf06b75e4c3ebfee9b9010b" :answer/id #uuid "e5b1841a-1768-51da-a465-19b5a0c1181d" :answer/type :answer.type/math :answer/value "g(x)=3|x-3|" :db/ensure [:answer/validate]} {:db/id "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/e808ac9635806fb49bffeda4243b1542d1614482352e113737c5d922647c0031" :answer/id #uuid "e398c7b3-8f1d-5e55-b5ce-3ab659a86fcf" :answer/type :answer.type/math :answer/value "p(x)=\\sqrt{x}" :db/ensure [:answer/validate]} {:db/id "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81" :answer-field/id #uuid "c597ab9b-1332-5810-9c9a-1684379ac297" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/e808ac9635806fb49bffeda4243b1542d1614482352e113737c5d922647c0031" :answer-field/choices ["q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/99db94ef52aab7878f295e2e52208eb683dd9e069b814d2aa5485a5af9dcc5f5" "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/793df2a592a1633db3622edc903d47631114750daf7da3b8a9e4c4a51d7db9ca" "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/5c6c9df76f993864839b0f56a755f90170f6bc330869e7b806e688cddf3f1ab7" "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/81f997af51e0df770a5aec48ac0d40ced88575973cf06b75e4c3ebfee9b9010b" "q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81/e808ac9635806fb49bffeda4243b1542d1614482352e113737c5d922647c0031"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-47678"] :question/problem "Which of the following functions is differentiable at the point $x=3?$" :question/worked-solution "Notice that the function $p(x)$ is differentiable for all $x>0.$ Therefore, the correct answer is $p(x)=\\sqrt{x}.$\n\nOther functions are not differentiable at $x=3.$\n\n- The function $f(x)$ is not defined at $x=3$, so it is not differentiable there.\n\n- The function $g(x)$ has a corner point at $x=3$, so it is not differentiable there.\n\n- The function $h(x)$ has a vertical tangent at  $x=3$, so it is not differentiable there.\n\n- The function $q(x)$ has a jump discontinuity at $x=3$, so it is not differentiable there." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-47678/selection/ma-v1/46dda22a38f853d793287e6c777d7d5a4ed2aa20ff26276004b104e13e253a81"] :db/ensure [:question/validate]} {:db/id "q-51067/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "66cee65a-e733-517d-a359-982f12975856" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-51067/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "264d0e95-f1a0-5c15-a528-b2d04258ed30" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-51067/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "43c3142b-6f4c-55ce-a2c0-dcf54fb3ed94" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-51067/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7d7b7c32-db80-568a-8727-76265d71e313" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-51067/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "1b337561-3369-5032-a520-339b3b5258f8" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-51067/selection" :answer-field/id #uuid "d6654a34-2ccb-5cb