#{[{:db/id #edb/ref 17592186332843 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e68ed1-6c21-5339-b817-0dca6bed6e25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186330010} {:answer/id #uuid "13dd78f4-7836-5e2c-95cf-18fff06f843d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186330114} {:answer/id #uuid "36a4f226-546a-58fe-9e0a-5f6172d50d49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186330439} {:answer/id #uuid "8dbffc66-920f-5159-966d-348e80294b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186331207} {:answer/id #uuid "fea5d391-e5d1-5006-b2d7-39671ae5c2c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186332194}] :answer-field/correct {:answer/id #uuid "fea5d391-e5d1-5006-b2d7-39671ae5c2c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186332194} :answer-field/id #uuid "d1ab9f03-8ca5-52dc-a6f7-f2d81ee5a0b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332568}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "227ca0fe-b4ce-570a-82ea-2de7f8f95c49" :question/math-academy-id "q-51067" :question/problem "Given that a function $f(x)$ is continuous at $x=-2$, has a cusp at $x=1,$ and is differentiable at $x=3$, which of the following statements must be true for **any** $f(x)$ that satisfy these criteria?\n\nI. It is differentiable at $x=-2$\n\nII. It's **not** differentiable at $x=1$\n\nIII. ${lim}_{x\\to 3}f(x)=f(3).$" :question/worked-solution "- Statement I is false. Continuity does not imply differentiability. For example, the function $y=|x+2|$ is continuous but it's not differentiable at $x=-2.$\n\n- Statement II is true. The function has a cusp at $x=1$, so it's not differentiable there.\n\n- Statement III is true. Differentiability implies continuity. Hence, ${lim}_{x\\to 3}f(x)=f(3).$"}]}
