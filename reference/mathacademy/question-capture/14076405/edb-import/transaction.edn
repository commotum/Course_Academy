44836a040b998afe569a0f25aadf35969a66394e70ca4b07ebfe509" "q-135315/selection/a3ec761e9d0421f9b8df3d986c27e35f9b24fd36e0e5a5acae270b120873cc43" "q-135315/selection/34d54a502aa7dfbc47cb59ee6475ed5c59fb286e59589763e9b0a937ea53ec42"] :db/ensure [:answer-field/validate]} {:db/id "q-135315" :question/id #uuid "df59a1aa-1439-516c-b162-bd4f36cbb04a" :question/math-academy-id "q-135315" :question/problem "Find the inverse of the following matrix: \n\n$$\nA=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 4\\end{aligned}]\n$$" :question/worked-solution "Notice that the given matrix is diagonal.\n\nThe inverse of a diagonal matrix can be found as follows: \n\n$$\n{[\\begin{aligned}{a}_{11} & 0 & ⋯ & 0 \\\\ 0 & {a}_{22} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & {a}_{nn}\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{aligned}]\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 4\\end{aligned}]}^{-1}=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & \\frac{1}{4}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135315/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6eea26e0-2a9c-5d4c-91d3-12e7682e1858"] :knowledge-point/questions ["q-135315"] :db/ensure [:knowledge-point/validate]} {:db/id "q-135350/selection/5556cb3e765a0b81230612ece5013086135c7826bab7bc77d45c93ea94e1bbc8" :answer/id #uuid "ba3e7409-b28f-585a-a82b-38c358f5ef93" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\sqrt{5} & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-135350/selection/5a60b65187b336fbe30606776d5f631b294a5732a89e9540021cb1abf711a248" :answer/id #uuid "2b27ec3a-cde1-5559-9cef-646e35391b56" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\