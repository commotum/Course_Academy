={P}^{T}\n$$\n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]}^{T}=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "1f89989010f3075039ad99f70dfeac8431dc4a61ed72a1d546c33d74f92548f7" "basis" 2499 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/edb-import/verification.json"} {"question" "q-135366" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/activity-metadata.json" "file_sha256" "e995597b22ac8c67939a86558392bc9717625f07bdb3494f044688b5cd86a273" "basis" 2499 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/edb-import/verification.json"} {"question" "q-135366" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/state.json" "file_sha256" "1f89989010f3075039ad99f70dfeac8431dc4a61ed72a1d546c33d74f92548f7" "basis" 2499 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/edb-import/verification.json"} {"question" "q-135366" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}0 & -1 & 0 \\\\ 0 & 0 & -1 \\\\ -1 & 0 & 0\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14070476/sta