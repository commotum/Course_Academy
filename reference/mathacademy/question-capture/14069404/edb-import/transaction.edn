 | $\\,0.9783\\,$ | $\\,0.9788\\,$ |\n| $\\,2.1\\,$ | $\\,0.9826\\,$ | $\\,0.9830\\,$ | $\\,0.9834\\,$ |\n| $\\,2.2\\,$ | $\\,0.9864\\,$ | $\\,0.9868\\,$ | $\\,0.9871\\,$ |\n\nTherefore, according to the table, we have\n\n$$\nP(Z\\le 2.01)=Φ(2.01)=0.9778.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131387/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77015ca5-d392-500e-93dc-8e065dd1c06c"] :knowledge-point/questions ["q-131387"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94104/selection/4e6ad315db912955c09211629ab34f3c037025669c5c2d2886dd6469fd410455" :answer/id #uuid "3c7e3b49-1a4d-51bb-8add-2d93712672b5" :answer/type :answer.type/math :answer/value "0.2296" :db/ensure [:answer/validate]} {:db/id "q-94104/selection/c035d979bc04e2d297276a635c041e2007df956ca3668d098dcd24d226e267b4" :answer/id #uuid "64fb8d93-96ac-5830-b95f-21f75a5a7c3c" :answer/type :answer.type/math :answer/value "0.1736" :db/ensure [:answer/validate]} {:db/id "q-94104/selection/2ec8d0f0627e5b52c72d6c7e2dea69aef01fd5c34c02b9a38ccdcdec222ce252" :answer/id #uuid "f93a311d-c6e5-5785-b057-99cb01717c05" :answer/type :answer.type/math :answer/value "0.2538" :db/ensure [:answer/validate]} {:db/id "q-94104/selection/4121b4554b5037bd45610877f8f7e87f5ab2e36fc7b09296f28dfda89d336c15" :answer/id #uuid "3baa6a94-2681-58ad-bbb9-f1fea9773cb9" :answer/type :answer.type/math :answer/value "0.2061" :db/ensure [:answer/validate]} {:db/id "q-94104/selection/8774a8c007c4e12d06b314b3d141b55810264f81a00b2a8c2dd239d5cc3a2f62" :answer/id #uuid "8c59b7bf-e530-55dc-a64a-76cfb8e4bd8e" :answer/type :answer.type/math :answer/value "0.1762" :db/ensure [:answer/validate]} {:db/id "q-94104/selection" :answer-field/id #uuid "496ebf5d-279a-5bb5-98cc-f6fbb3df2101" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94104/selection/8774a8c007c4e12d06b314b3d141b55810264f81a00b2a8c2dd239d5cc3a2f62" :answer-field/ch