\\,$ | $\\,0.2327\\,$ | $\\,0.2296\\,$ |\n\nTherefore, according to the table, we have\n\n$$\nP(Z\\le -0.93)=Φ(-0.93)=0.1762.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94104/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77015ca5-d392-500e-93dc-8e065dd1c06c"] :knowledge-point/questions ["q-94104"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94098/selection/fdf041b2b5bbc9767838ae25556b1c566bf3129d1e8d1d8605d55d0f33bd5d91" :answer/id #uuid "cbd5b959-df3d-5580-b5a6-39faab7cca83" :answer/type :answer.type/math :answer/value "0.7673" :db/ensure [:answer/validate]} {:db/id "q-94098/selection/366ac1de372df7d1ce91bb646d439982a31d33d19660fd7ce684a5923f7957c0" :answer/id #uuid "e0176c69-b60a-5720-b9a5-91fdc6e2049b" :answer/type :answer.type/math :answer/value "0.7088" :db/ensure [:answer/validate]} {:db/id "q-94098/selection/3650d5bdd343090ef6dc5dceeec3d66d2ec4e40d30fc52b93a97faae100da400" :answer/id #uuid "c9e598fc-77cd-54f3-a0c5-b58a819be079" :answer/type :answer.type/math :answer/value "0.7389" :db/ensure [:answer/validate]} {:db/id "q-94098/selection/86d797924e5d76e611fefdd879e66bce521024f4a61cd13d720deceb7fcc41a5" :answer/id #uuid "8422fbe6-2a2a-5571-a6cc-83facabe0ab6" :answer/type :answer.type/math :answer/value "0.7734" :db/ensure [:answer/validate]} {:db/id "q-94098/selection/0c71b007e40ff469b6511a73dd546b453c1b7f7c594f4a7ae4928270b35a4df7" :answer/id #uuid "b3a3ad98-4ab3-556a-863a-86fb92be78e3" :answer/type :answer.type/math :answer/value "0.7054" :db/ensure [:answer/validate]} {:db/id "q-94098/selection" :answer-field/id #uuid "2ef25b9f-1174-5556-bb3e-cb3388800d47" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94098/selection/86d797924e5d76e611fefdd879e66bce521024f4a61cd13d720deceb7fcc41a5" :answer-field/choices ["q-94098/selection/fdf041b2b5bbc9767838ae25556b1c566bf3129d1e8d1d8605d55d0f33bd5d91" "q-94098/selection/366ac1de372df7d1c