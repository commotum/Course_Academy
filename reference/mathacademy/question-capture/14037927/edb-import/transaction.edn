[{:db/id [:question/math-academy-id "q-7282"] :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=9,$ where $t$ is the time. If the particle is at the position $x=0$ when $t=1,$ calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int 9\\,\\text{d}t \\\\  & =9t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $x(1)=0.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}0 & =9(1)+C \\\\ C & =-9.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=9t-9.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-102782/selection/51dc8e7f27493f17a27bf0ac47a7d2ccc6d027fabd57b8df4bf5f6ad377c30cb" :answer/id #uuid "b7e49faf-6828-5752-b7ea-5e9c5dd3527a" :answer/type :answer.type/math :answer/value "x(t)=3+\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "q-102782/selection/dc3c4ffe27acb4929962d701c3ecb39bdbda79c7415e9696a09b250b2c9bb065" :answer/id #uuid "2e3bd353-87d7-56ef-ba7f-3bcb6e3ca373" :answer/type :answer.type/math :answer/value "x(t)=3+\\operatorname{sin}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "q-102782/selection/4c81e9ce52104a3dda5042128dc445767528fb7f426afffed7dfd2b9caad0173" :answer/id #uuid "f5993b90-47b7-5904-b623-ee0dabe128b3" :answer/type :answer.type/math :answer/value "x(t)=3-\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "q-102782/selection/3c2bb87e395a1c3edc056e0687cfe69c59d667c49e93d90fa88d30e0aa708405" :answer/id #uuid "9aa4d5c6-46be-5b73-9645-fc2a754ea4b6" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "q-102782/selection/03a65816da2b6709108a57d735d5d4ee17195556eec32cb9991d257dedcd192a" :answer/id #uuid "01818edb-894c-5485-b72f-2e8d3dcef054" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t+3)" :db/ensure [:answer/validate]} {:db/id "q-102782/selection" :answer-field/id #uuid "d660a1eb-0875-5b4e-9e0f-6c115720c422" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102782/selection/51dc8e7f27493f17a27bf0ac47a7d2ccc6d027fabd57b8df4bf5f6ad377c30cb" :answer-field/choices ["q-102782/selection/51dc8e7f27493f17a27bf0ac47a7d2ccc6d027fabd57b8df4bf5f6ad377c30cb" "q-102782/selection/dc3c4ffe27acb4929962d701c3ecb39bdbda79c7415e9696a09b250b2c9bb065" "q-102782/selection/4c81e9ce52104a3dda5042128dc445767528fb7f426afffed7dfd2b9caad0173" "q-102782/selection/3c2bb87e395a1c3edc056e0687cfe69c59d667c49e93d90fa88d30e0aa708405" "q-102782/selection/03a65816da2b6709108a57d735d5d4ee17195556eec32cb9991d257dedcd192a"] :db/ensure [:answer-field/validate]} {:db/id "q-102782" :question/id #uuid "082878d7-c949-5c37-b9d7-9ff7084bdec8" :question/math-academy-id "q-102782" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=\\operatorname{cos}⁡(4t),$ where $t$ is the time. If the particle is at the position $x=3$ when $t=0,$ calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡(4t)\\,\\text{d}t \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(4t)+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $x(0)=3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}3 & =\\frac{1}{4}\\operatorname{sin}⁡(4(0))+C \\\\ 3 & =0+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is\n\n$$\nx(t)=3+\\frac{1}{4}\\operatorname{sin}⁡(4t).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102782/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd"] :knowledge-point/questions ["q-102782"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102993/selection/06474c2d26410a1a7b2db2aedea534c8832afdbd7c9c24bfedf62907b99c852b" :answer/id #uuid "f531d080-f85f-5752-b424-8850ab35296f" :answer/type :answer.type/math :answer/value "x(t)=\\frac{2}{t+1}-1" :db/ensure [:answer/validate]} {:db/id "q-102993/selection/00d26d0d0db2abee7e2cb07dc0117f47bc1201abf112abc1bea3698142a5ed47" :answer/id #uuid "f995afe7-724e-5ef1-a928-f1407e6a5677" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{t+1}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-102993/selection/70df33323754ab229f01337c106305648ebb43e68ea785ea743771cfa38df99b" :answer/id #uuid "61b0fb92-917f-5071-9363-078fd0810643" :answer/type :answer.type/math :answer/value "x(t)=\\frac{2}{t+1}" :db/ensure [:answer/validate]} {:db/id "q-102993/selection/3df8840c83beabe8c9b5a12ed6f85ec59dfd527ad5c8ef5984ce4b2cfc213e70" :answer/id #uuid "4d0e0a0c-dbfc-58b6-8260-1eb622b6709f" :answer/type :answer.type/math :answer/value "x(t)=\\frac{2}{(t+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-102993/selection/071e4df034017e625853fbdd900abe079c38534183b1a7191b8b77ded174003f" :answer/id #uuid "7fd90584-fc8d-50bb-96eb-f78fedd8cea8" :answer/type :answer.type/math :answer/value "x(t)=\\frac{4}{(t+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-102993/selection" :answer-field/id #uuid "34c88a64-9e02-5f60-9497-308b7b4648cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102993/selection/70df33323754ab229f01337c106305648ebb43e68ea785ea743771cfa38df99b" :answer-field/choices ["q-102993/selection/06474c2d26410a1a7b2db2aedea534c8832afdbd7c9c24bfedf62907b99c852b" "q-102993/selection/00d26d0d0db2abee7e2cb07dc0117f47bc1201abf112abc1bea3698142a5ed47" "q-102993/selection/70df33323754ab229f01337c106305648ebb43e68ea785ea743771cfa38df99b" "q-102993/selection/3df8840c83beabe8c9b5a12ed6f85ec59dfd527ad5c8ef5984ce4b2cfc213e70" "q-102993/selection/071e4df034017e625853fbdd900abe079c38534183b1a7191b8b77ded174003f"] :db/ensure [:answer-field/validate]} {:db/id "q-102993" :question/id #uuid "086db544-da02-585a-9178-5af9c52946c7" :question/math-academy-id "q-102993" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=\\frac{4}{(t+1)^{3}}$, where $t\\ge 0$ is the time. If the particle has position $x=1$ and velocity $v=-\\frac{1}{2}$ when $t=1$, calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\frac{4}{(t+1)^{3}}\\,\\text{d}t \\\\  & =-\\frac{2}{(t+1)^{2}}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=-\\frac{1}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-\\frac{1}{2} & =-\\frac{2}{(1+1)^{2}}+C \\\\ -\\frac{1}{2} & =-\\frac{1}{2}+C \\\\ C & =0.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=-\\frac{2}{(t+1)^{2}}.$ \n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (-\\frac{2}{(t+1)^{2}})\\,\\text{d}t \\\\  & =\\frac{2}{t+1}+K\\end{aligned}\n$$\n\nTo determine $K$, we use the fact that $x(1)=1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}1 & =\\frac{2}{1+1}+K \\\\ 1 & =1+K \\\\ K & =0.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\frac{2}{t+1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-102993/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "43e68991-37f0-543e-a4da-b78b395a8494"] :knowledge-point/questions ["q-102993"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102994/selection/c9c3ef6e6e1090238c218c608c4dd50713f316d8bd52d3d594950e6af25aa0a6" :answer/id #uuid "50656289-1263-5c63-9155-93f1e8ead703" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))" :db/ensure [:answer/validate]} {:db/id "q-102994/selection/09b8f4252b5015f72e848d2a3d41b917f7422728af3acf80eb32e83c465cee29" :answer/id #uuid "4bad7d98-8fe9-51f4-bd5d-80d57d44a118" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{16}(2-\\operatorname{sin}⁡(4t))" :db/ensure [:answer/validate]} {:db/id "q-102994/selection/8e8cece9c176b54981fb92649c2c0fa5daa24da1e0836ce72e78de2ad6670648" :answer/id #uuid "fc37b984-a029-5d49-bf09-c9b10abdefa0" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{16}(1-2\\operatorname{cos}⁡(4t))" :db/ensure [:answer/validate]} {:db/id "q-102994/selection/7a7a7b443d6d4a2cb59c6696a394871014a43b2d1ed30ae4fa88c8dcd0791156" :answer/id #uuid "93234760-5894-51fc-b07c-b4dc0d82d94a" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{16}(1+\\operatorname{sin}⁡(4t))" :db/ensure [:answer/validate]} {:db/id "q-102994/selection/9b2332576c5be2121d3264c1b63f79c3c6107112f971cfdd34df6ad6a67ce699" :answer/id #uuid "3a4e5f36-979b-51b7-ba01-5ac1cc5445d1" :answer/type :answer.type/math :answer/value "x(t)=\\frac{1}{16}(2+\\operatorname{cos}⁡(4t))" :db/ensure [:answer/validate]} {:db/id "q-102994/selection" :answer-field/id #uuid "ebc7dc10-47eb-5352-8df0-fb4b3a27ee41" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102994/selection/c9c3ef6e6e1090238c218c608c4dd50713f316d8bd52d3d594950e6af25aa0a6" :answer-field/choices ["q-102994/selection/c9c3ef6e6e1090238c218c608c4dd50713f316d8bd52d3d594950e6af25aa0a6" "q-102994/selection/09b8f4252b5015f72e848d2a3d41b917f7422728af3acf80eb32e83c465cee29" "q-102994/selection/8e8cece9c176b54981fb92649c2c0fa5daa24da1e0836ce72e78de2ad6670648" "q-102994/selection/7a7a7b443d6d4a2cb59c6696a394871014a43b2d1ed30ae4fa88c8dcd0791156" "q-102994/selection/9b2332576c5be2121d3264c1b63f79c3c6107112f971cfdd34df6ad6a67ce699"] :db/ensure [:answer-field/validate]} {:db/id "q-102994" :question/id #uuid "8985ff83-3d60-5f09-b241-0ff8efcd199d" :question/math-academy-id "q-102994" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=\\operatorname{cos}⁡(4t)$, where $t\\ge 0$ is the time. If the particle has position $x=\\frac{1}{16}$ and velocity $v=\\frac{1}{4}$ when $t=\\frac{\\pi }{8}$, calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡(4t)\\text{d}t \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(4t)+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(\\frac{\\pi }{8})=\\frac{1}{4}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{1}{4}\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{8})+C \\\\ \\frac{1}{4} & =\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})+C \\\\ \\frac{1}{4} & =\\frac{1}{4}+C \\\\ C & =0.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t).$ \n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int \\frac{1}{4}\\operatorname{sin}⁡(4t)\\text{d}t \\\\  & =-\\frac{1}{16}\\operatorname{cos}⁡(4t)+K\\end{aligned}\n$$\n\nTo determine $K,$ we use the fact that $x(\\frac{\\pi }{8})=\\frac{1}{16}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{16} & =-\\frac{1}{16}\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{8})+C \\\\ \\frac{1}{16} & =-\\frac{1}{16}\\operatorname{cos}⁡(\\frac{\\pi }{2})+C \\\\ \\frac{1}{16} & =0+C \\\\ K & =\\frac{1}{16}.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\n\\begin{aligned}x(t) & =-\\frac{1}{16}\\operatorname{cos}⁡(4t)+\\frac{1}{16} \\\\  & =\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-102994/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "43e68991-37f0-543e-a4da-b78b395a8494"] :knowledge-point/questions ["q-102994"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351552/field-1/8f340d0baafb03513c5702ed3ce7945c4624c29d2835a84735dcdbda0e871ccb" :answer/id #uuid "e04c6369-09ba-5a84-ba04-d70d81b08ed6" :answer/type :answer.type/math :answer/value "2t^3+8t+5" :db/ensure [:answer/validate]} {:db/id "q-351552/field-1" :answer-field/id #uuid "6a33a8ed-582e-5988-a942-9c1ad30646ee" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351552/field-1/8f340d0baafb03513c5702ed3ce7945c4624c29d2835a84735dcdbda0e871ccb" :answer-field/choices ["q-351552/field-1/8f340d0baafb03513c5702ed3ce7945c4624c29d2835a84735dcdbda0e871ccb"] :db/ensure [:answer-field/validate]} {:db/id "q-351552" :question/id #uuid "263e6f70-ef12-5f0f-b9a9-7f3974eb7585" :question/math-academy-id "q-351552" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=6{t}^{2}+8,$ where $t>0$ is the time. If the particle is at the position $x=15$ when $t=1,$ calculate the position $x$ of the particle at time $t.$\n\n$x(t)=$\n{{field-1}}" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (6{t}^{2}+8)\\,\\text{d}t \\\\  & =6\\cdot \\frac{{t}^{3}}{3}+8t+C \\\\  & =2{t}^{3}+8t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $x(1)=15.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}15 & =2(1)^{3}+8(1)+C \\\\ 15 & =2+8+C \\\\ C & =5.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=2{t}^{3}+8t+5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351552/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd"] :knowledge-point/questions ["q-351552"] :db/ensure [:knowledge-point/validate]}]
