#{[{:db/id #edb/ref 17592186297708 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd" :knowledge-point/title "Determining the Position of a Particle Given Its Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01818edb-894c-5485-b72f-2e8d3dcef054" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t+3)" :db/id #edb/ref 17592186297710} {:answer/id #uuid "9aa4d5c6-46be-5b73-9645-fc2a754ea4b6" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186297711} {:answer/id #uuid "f5993b90-47b7-5904-b623-ee0dabe128b3" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=3-\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186297712} {:answer/id #uuid "b7e49faf-6828-5752-b7ea-5e9c5dd3527a" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=3+\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186297713} {:answer/id #uuid "2e3bd353-87d7-56ef-ba7f-3bcb6e3ca373" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=3+\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186297714}] :answer-field/correct {:answer/id #uuid "b7e49faf-6828-5752-b7ea-5e9c5dd3527a" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=3+\\frac{1}{4}\\operatorname{sin}⁡(4t)" :db/id #edb/ref 17592186297713} :answer-field/id #uuid "d660a1eb-0875-5b4e-9e0f-6c115720c422" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297709}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "082878d7-c949-5c37-b9d7-9ff7084bdec8" :question/math-academy-id "q-102782" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=\\operatorname{cos}⁡(4t),$ where $t$ is the time. If the particle is at the position $x=3$ when $t=0,$ calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡(4t)\\,\\text{d}t \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(4t)+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $x(0)=3.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}3 & =\\frac{1}{4}\\operatorname{sin}⁡(4(0))+C \\\\ 3 & =0+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is\n\n$$\nx(t)=3+\\frac{1}{4}\\operatorname{sin}⁡(4t).\n$$"}] [{:db/id #edb/ref 17592186297715 :knowledge-point/_questions [{:knowledge-point/id #uuid "43e68991-37f0-543e-a4da-b78b395a8494" :knowledge-point/title "Determining the Position of a Particle Given Its Acceleration, Initial Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f995afe7-724e-5ef1-a928-f1407e6a5677" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{t+1}+\\frac{1}{2}" :db/id #edb/ref 17592186297717} {:answer/id #uuid "f531d080-f85f-5752-b424-8850ab35296f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{2}{t+1}-1" :db/id #edb/ref 17592186297718} {:answer/id #uuid "7fd90584-fc8d-50bb-96eb-f78fedd8cea8" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{4}{(t+1)^{2}}" :db/id #edb/ref 17592186297719} {:answer/id #uuid "4d0e0a0c-dbfc-58b6-8260-1eb622b6709f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{2}{(t+1)^{2}}" :db/id #edb/ref 17592186297720} {:answer/id #uuid "61b0fb92-917f-5071-9363-078fd0810643" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{2}{t+1}" :db/id #edb/ref 17592186297721}] :answer-field/correct {:answer/id #uuid "61b0fb92-917f-5071-9363-078fd0810643" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{2}{t+1}" :db/id #edb/ref 17592186297721} :answer-field/id #uuid "34c88a64-9e02-5f60-9497-308b7b4648cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297716}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "086db544-da02-585a-9178-5af9c52946c7" :question/math-academy-id "q-102993" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=\\frac{4}{(t+1)^{3}}$, where $t\\ge 0$ is the time. If the particle has position $x=1$ and velocity $v=-\\frac{1}{2}$ when $t=1$, calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\frac{4}{(t+1)^{3}}\\,\\text{d}t \\\\  & =-\\frac{2}{(t+1)^{2}}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=-\\frac{1}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-\\frac{1}{2} & =-\\frac{2}{(1+1)^{2}}+C \\\\ -\\frac{1}{2} & =-\\frac{1}{2}+C \\\\ C & =0.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=-\\frac{2}{(t+1)^{2}}.$ \n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (-\\frac{2}{(t+1)^{2}})\\,\\text{d}t \\\\  & =\\frac{2}{t+1}+K\\end{aligned}\n$$\n\nTo determine $K$, we use the fact that $x(1)=1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}1 & =\\frac{2}{1+1}+K \\\\ 1 & =1+K \\\\ K & =0.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\frac{2}{t+1}.\n$$"}] [{:db/id #edb/ref 17592186297722 :knowledge-point/_questions [{:knowledge-point/id #uuid "43e68991-37f0-543e-a4da-b78b395a8494" :knowledge-point/title "Determining the Position of a Particle Given Its Acceleration, Initial Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bad7d98-8fe9-51f4-bd5d-80d57d44a118" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{16}(2-\\operatorname{sin}⁡(4t))" :db/id #edb/ref 17592186297724} {:answer/id #uuid "93234760-5894-51fc-b07c-b4dc0d82d94a" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{16}(1+\\operatorname{sin}⁡(4t))" :db/id #edb/ref 17592186297725} {:answer/id #uuid "fc37b984-a029-5d49-bf09-c9b10abdefa0" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{16}(1-2\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186297726} {:answer/id #uuid "3a4e5f36-979b-51b7-ba01-5ac1cc5445d1" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{16}(2+\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186297727} {:answer/id #uuid "50656289-1263-5c63-9155-93f1e8ead703" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186297728}] :answer-field/correct {:answer/id #uuid "50656289-1263-5c63-9155-93f1e8ead703" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186297728} :answer-field/id #uuid "ebc7dc10-47eb-5352-8df0-fb4b3a27ee41" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297723}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8985ff83-3d60-5f09-b241-0ff8efcd199d" :question/math-academy-id "q-102994" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=\\operatorname{cos}⁡(4t)$, where $t\\ge 0$ is the time. If the particle has position $x=\\frac{1}{16}$ and velocity $v=\\frac{1}{4}$ when $t=\\frac{\\pi }{8}$, calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡(4t)\\text{d}t \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(4t)+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(\\frac{\\pi }{8})=\\frac{1}{4}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{1}{4}\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{8})+C \\\\ \\frac{1}{4} & =\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})+C \\\\ \\frac{1}{4} & =\\frac{1}{4}+C \\\\ C & =0.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t).$ \n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int \\frac{1}{4}\\operatorname{sin}⁡(4t)\\text{d}t \\\\  & =-\\frac{1}{16}\\operatorname{cos}⁡(4t)+K\\end{aligned}\n$$\n\nTo determine $K,$ we use the fact that $x(\\frac{\\pi }{8})=\\frac{1}{16}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{16} & =-\\frac{1}{16}\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{8})+C \\\\ \\frac{1}{16} & =-\\frac{1}{16}\\operatorname{cos}⁡(\\frac{\\pi }{2})+C \\\\ \\frac{1}{16} & =0+C \\\\ K & =\\frac{1}{16}.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\n\\begin{aligned}x(t) & =-\\frac{1}{16}\\operatorname{cos}⁡(4t)+\\frac{1}{16} \\\\  & =\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297729 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd" :knowledge-point/title "Determining the Position of a Particle Given Its Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e04c6369-09ba-5a84-ba04-d70d81b08ed6" :answer/type {:db/ident :answer.type/math} :answer/value "2t^3+8t+5" :db/id #edb/ref 17592186297731}] :answer-field/correct {:answer/id #uuid "e04c6369-09ba-5a84-ba04-d70d81b08ed6" :answer/type {:db/ident :answer.type/math} :answer/value "2t^3+8t+5" :db/id #edb/ref 17592186297731} :answer-field/id #uuid "6a33a8ed-582e-5988-a942-9c1ad30646ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186297730}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "263e6f70-ef12-5f0f-b9a9-7f3974eb7585" :question/math-academy-id "q-351552" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=6{t}^{2}+8,$ where $t>0$ is the time. If the particle is at the position $x=15$ when $t=1,$ calculate the position $x$ of the particle at time $t.$\n\n$x(t)=$\n{{field-1}}" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (6{t}^{2}+8)\\,\\text{d}t \\\\  & =6\\cdot \\frac{{t}^{3}}{3}+8t+C \\\\  & =2{t}^{3}+8t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $x(1)=15.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}15 & =2(1)^{3}+8(1)+C \\\\ 15 & =2+8+C \\\\ C & =5.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=2{t}^{3}+8t+5.\n$$"}] [{:db/id #edb/ref 17592186064860 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd" :knowledge-point/title "Determining the Position of a Particle Given Its Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8958fbf3-078b-5be6-87dc-8223f2656545" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = 9t + 1" :db/id #edb/ref 17592186063670} {:answer/id #uuid "d48a813c-64ee-5038-a595-9c6a5a7c31f2" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = 0" :db/id #edb/ref 17592186063671} {:answer/id #uuid "f8e54f37-af1c-5d33-8ccf-3324ec18149f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = 9" :db/id #edb/ref 17592186063672} {:answer/id #uuid "f996f79e-aeab-5eb3-9fd0-210579ccb529" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = 9t - 9" :db/id #edb/ref 17592186063673} {:answer/id #uuid "17236776-db26-587f-abcf-3859f04f889e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = 9t" :db/id #edb/ref 17592186063674}] :answer-field/correct {:answer/id #uuid "f996f79e-aeab-5eb3-9fd0-210579ccb529" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = 9t - 9" :db/id #edb/ref 17592186063673} :answer-field/id #uuid "8e646b67-246a-5e20-827d-b4acc62a9608" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063669}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4bcd3d6d-85e2-53be-bfd3-fe166f94d8e5" :question/math-academy-id "q-7282" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=9,$ where $t$ is the time. If the particle is at the position $x=0$ when $t=1,$ calculate the position $x$ of the particle at time $t>0.$" :question/requires-calculator true :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int 9\\,\\text{d}t \\\\  & =9t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $x(1)=0.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}0 & =9(1)+C \\\\ C & =-9.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=9t-9.\n$$"}]}
