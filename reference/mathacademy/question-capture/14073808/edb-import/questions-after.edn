#{[{:db/id #edb/ref 17592186059476 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "57187716-c00b-5428-a83a-18836d6b3d04" :knowledge-point/title "Finding the Transpose of a Matrix"}] :question/id #uuid "e3d1f202-a3d6-561f-bd4b-3e886142e5a0" :question/math-academy-id "e-4386" :question/problem "Find $C^T,$ if \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14073808/assets/d5e344ac147321b0440d313274626b1a00527214467cbc85bac199c10fee00bd.png)" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14073808/assets/d64f16633ed91692b0cd22daa4c739a6e4347ec6c0596c992d28088880ea2862.png)"}] [{:db/id #edb/ref 17592186059477 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "4cf627a0-6921-58ee-91c0-2f225d425711" :knowledge-point/title "Finding the Transpose of a Row Vector or Column Vector"}] :question/id #uuid "c8ca81da-04d3-532f-94f4-5f43703c7216" :question/math-academy-id "e-4387" :question/problem "If\n    ${A} = \n    \\left\\lbrack\n    \\matrix {\n        5 & -1 & 0 \\\n    }\n    \\right\\rbrack,$\nthen what is ${A^T} ?$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{A}^T = \n    \t\t\\left\\lbrack\n    \t\t\\matrix {\n    5 \\ \n    -1 \\ \n    0 \\  \n    \t\t}\n    \t\t\\right\\rbrack\n$$"}] [{:db/id #edb/ref 17592186059478 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321" :knowledge-point/title "Determining the Dimensions of the Transpose of a Matrix"}] :question/id #uuid "02372092-ed41-5533-8238-0361856b731d" :question/math-academy-id "e-4388" :question/problem "Consider the matrix\n    ${B} = \n    \\left\\lbrack\n    \\matrix {\n        1 & 2 & 4 & 2\\\n        4 & 4 & 1 & 1\\\n        3 & -3 & 0 & -1\n    }\n    \\right\\rbrack.$\nWhat are the dimensions of ${B}^T?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $N \\times M$ to $M \\times N.$\n\nSo, since $B$ is a $3 \\times 4$ matrix, the transpose ${B}^T$ is a $4\\times3$ matrix."}] [{:db/id #edb/ref 17592186381470 :knowledge-point/_questions [{:knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321" :knowledge-point/title "Determining the Dimensions of the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ba76589-5b73-5041-8997-1564cb2fe867" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186381472} {:answer/id #uuid "15dd1118-cb18-5e87-82fc-4f4b16a1e460" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186381473} {:answer/id #uuid "7e14d6e0-067c-5603-94ff-8456793f10f5" :answer/type {:db/ident :answer.type/math} :answer/value "3\\times 2" :db/id #edb/ref 17592186381474} {:answer/id #uuid "bff8cd66-9f37-5225-a94d-8ebe8e540370" :answer/type {:db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186381475} {:answer/id #uuid "933c844b-874f-5928-bab6-07f5956cca02" :answer/type {:db/ident :answer.type/math} :answer/value "1\\times 3" :db/id #edb/ref 17592186381476}] :answer-field/correct {:answer/id #uuid "4ba76589-5b73-5041-8997-1564cb2fe867" :answer/type {:db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186381472} :answer-field/id #uuid "141e3c41-0528-5ba4-a5b2-0bbf508ce0d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381471}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b1198b23-7816-5ec6-99d4-6bd6a01f3017" :question/math-academy-id "q-11462" :question/problem "Consider the matrix\n    $C=[\\begin{aligned}1 & 3 \\\\ 2 & 4\\end{aligned}].$\nWhat are the dimensions of ${C}^{T}?$" :que