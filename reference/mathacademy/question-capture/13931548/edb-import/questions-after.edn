emy/question-capture/13931548/assets/04899589bc5527f5c35bae7d2b8564141ea5ae49f0aab1f500e57be7d854cc05.png" :db/id #edb/ref 17592186243599} :answer-field/id #uuid "149d5b50-9d85-562a-b5b8-116741b28875" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243595}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "09d1de29-e974-591a-b590-9887d91abf1f" :question/is-example false :question/math-academy-id "q-18523" :question/problem "Which of the following is the graph of $y=2{(\\frac{1}{6})}^{x}?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/4dacecba4626f7c202777cad0a723295a2954f4b0c65fde83a81c6c849414d51.png)\n\nThen, we scale this graph by a factor of $2.$ The $y$-intercept becomes $(0,2),$ and the resulting graph is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/b747ae8c29f01b840930d81f9c4b706d049ca685ee982efff717ddb13213937d.png)"}] [{:db/id #edb/ref 17592186110861 :knowledge-point/_questions [{:knowledge-point/id #uuid "46b4837f-6ba5-5812-8dc7-4671fcd6b20d" :knowledge-point/title "Plotting a Vertically Scaled Exponential Decay Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3d99515-f674-50c5-ad14-2156fc0aa09a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-18527-a-5.png" :db/id #edb/ref 17592186107403} {:answer/id #uuid "0ac7fb61-d35d-5ab2-94cf-c21c5116cfd4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-18527-a-2.png" :db/id #edb/ref 17592186107404} {:answer/id #uuid "24f6a078-4915-543b-82fd-f4d80858fc89" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-18527-a-3.png" :db/id #edb/ref 17592186107405} {:answer/id #uuid "330e6bac-810e-5859-951d-3d1a1ac637c9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-18527-a-1.png" :db/id #edb/ref 17592186107406} {:answer/id #uuid "71c2e52d-7d76-5399-a3b5-433f95760b96" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-18527-a-4.png" :db/id #edb/ref 17592186107407}] :answer-field/correct {:answer/id #uuid "330e6bac-810e-5859-951d-3d1a1ac637c9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1531/Source/Images/q-18527-a-1.png" :db/id #edb/ref 17592186107406} :answer-field/id #uuid "4240d07e-9a25-55a8-8f4e-8b85b1fd4d70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107402}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7f0bed79-dca9-5ce1-99d3-d88986cb7da8" :question/is-example false :question/math-academy-id "q-18527" :question/problem "Which of the following is the graph of $y = \\frac{1}{2}(\\frac{1}{7})^{x}$?" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{7})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/0c779fcd96d5d197e96f954da10b1c30e9eb7fcd189fb37cc215dbb39b912f51.png)\n\nThen, we scale this graph by a factor of $\\frac{1}{2}.$ The $y$-intercept becomes $(0,\\frac{1}{2}),$ and the resulting graph is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/ba154a9d6283e9e333c484045627c1eca517a8e2771f065256ac4e69c0613126.png)"}] [{:db/id #edb/ref 17592186111068 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91e49a03-1a89-5431-b51a-c56575390c97" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186108514} {:answer/id #uuid "ab37f4ae-f230-527c-925d-b22da4c3f66b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186108515} {:answer/id #uuid "cc998639-973f-5eb8-b68b-31def45ef5ff" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186108516} {:answer/id #uuid "ccf59f9c-095a-5b9d-8e1f-6b63cca53a6a" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186108517} {:answer/id #uuid "d1f452da-aef4-53d9-ab26-5147263f9469" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186108518}] :answer-field/correct {:answer/id #uuid "ccf59f9c-095a-5b9d-8e1f-6b63cca53a6a" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186108517} :answer-field/id #uuid "d6e94ee3-fc40-51b2-a25b-345c7eb57d45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108513}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c4102b2c-f2ad-56ac-9dd6-7dd59719b972" :question/is-example false :question/math-academy-id "q-28973" :question/problem "Which of the following statements are true in relation to the function $f(x) = (\\frac{2}{7})^{x}$?\n\n1. Its domain is $x ∈ (- ∞, ∞)$\n2. Its range is $y ∈ (0, ∞)$\n3. It is a decreasing function" :question/worked-solution "Let's start by recalling the graph of ${(\\frac{2}{7})}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/c1bbffed32708d30355ed3592deae845d1a84cd1f1772ef1d0fae7ac39518295.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The function $f(x)={(\\frac{2}{7})}^{x}$ is defined for all input values $x.$\n\n- Statement II is true. The set of possible outputs of $f(x)={(\\frac{2}{7})}^{x}$ consists of all the positive numbers.\n\n- Statement III is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\nIn conclusion, statements I, II, and III are true."}] [{:db/id #edb/ref 17592186243601 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9908dc27-d052-543b-948d-d8303f54e13d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186243603} {:answer/id #uuid "699806d4-fcdc-5a97-8c7a-45b83aa7a0b9" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186243604} {:answer/id #uuid "f6a3e4bf-cbd7-51b1-b831-9e2289f8bcb5" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186243605} {:answer/id #uuid "49f6db8a-8d3b-5079-8d42-2caadc4378ea" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186243606} {:answer/id #uuid "a19adbbc-5f37-5550-8904-b4ff28eb64f3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186243607}] :answer-field/correct {:answer/id #uuid "49f6db8a-8d3b-5079-8d42-2caadc4378ea" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186243606} :answer-field/id #uuid "4aa8b7b9-ea94-5244-87cf-e7f5bc4dbcb8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243602}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "22a834b0-12be-5c28-9abb-97f954691275" :question/is-example false :question/math-academy-id "q-47747" :question/problem "Which of the following statements are true in relation to the function $f(x)={(\\frac{1}{2})}^{x}?$\n\n- Its domain is $-\\infty <x<\\infty $\n- It's a decreasing function\n- $f(x)\\to \\infty $ as $x\\to \\infty $" :question/worked-solution "Let's start by recalling the graph of $y={(\\frac{1}{2})}^{x}:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/288adf3d1da5cf4bb6e2530318aeb083b69d43639de7704f9df15672be477d0a.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The function $f(x)={(\\frac{1}{2})}^{x}$ is defined for all input values $x.$\n\n- Statement II is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\n- Statement III is false. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $f(x)\\to 0$ as $x\\to \\infty .$\n\nIn conclusion, only statements I and II are true."}] [{:db/id #edb/ref 17592186243608 :knowledge-point/_questions [{:knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a0c2b6c-9ebd-5947-92c2-9d9e5307ebde" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186243610} {:answer/id #uuid "43296e94-3876-5897-a52f-ac00eecc25e2" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186243611} {:answer/id #uuid "2726c24f-7490-5ae7-bc4d-52b27a72ad17" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243612} {:answer/id #uuid "bcb53d8e-1947-535e-b575-09e8539e4489" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186243613} {:answer/id #uuid "003ba498-ae85-5b9d-88b0-1e3b6412af9b" :answer/type {:db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186243614}] :answer-field/correct {:answer/id #uuid "003ba498-ae85-5b9d-88b0-1e3b6412af9b" :answer/type {:db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186243614} :answer-field/id #uuid "19da9a8a-1556-5c92-87c7-304f5fde2727" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243609}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ea5aef5e-bc5e-503c-ba7c-d827575c7f65" :question/is-example false :question/math-academy-id "q-7246" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13931548/assets/f960cca1134d756cded381a2236dd427efb928b1081254173e4c6903b6de150e.png)\n\nThe graph above shows $y=k{(\\frac{1}{5})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{5})}^{x},$ we take the graph of $y={(\\frac{1}{5})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,1.5)$ on the graph to $(0,k),$ we see that we must have $k=1.5.$"}]}
