i})+(5-5\\text{i}) \\\\  & =(5+5)+\\text{i}(5-5) \\\\  & =10+\\text{i}0 \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-16419/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52"] :knowledge-point/questions ["q-16419"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279463/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "6adbc1e3-3d82-5178-8b83-a1f288ac56d7" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-279463/field-1" :answer-field/id #uuid "87422d32-116a-57b0-ac9a-4205ed614475" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279463/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-279463/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-279463" :question/id #uuid "1de0640a-2c8c-5939-afc7-2ab4ac7aafb3" :question/math-academy-id "q-279463" :question/problem "If $z=6-10\\text{i}$, then $z+\\overset{―}{z}=${{field-1}}." :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=6-10\\text{i},$ the real part is $Re(z)=6,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(6) \\\\  & =12.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=6-10\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=6+10\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(6-10\\text{i})+(6+10\\text{i}) \\\\  & =(6+6)+\\text{i}(-10+10) \\\\  & =12+\\text{i}0 \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279463/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52"] :knowledge-point/questions ["q-279463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71986/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" :answer/id #uuid "402c6b2d-0ac1-5c1a-b38a-5ba938f1ce74" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "q-71986/selection/e4465a6a43e692e059bf725e1b5cfe61cc1646feb92589579e90f47290e9eaed" :answer/id #uuid "5f85ad16-c69c-5343-9af4-cd1f4f125422" :answer/type :answer.type/math :answer/value "8+14\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71986/selection/96026c62f67888dfc3400c9a4470d77ef75b3b7810ddaffecd50113c8ae39101" :answer/id #uuid "eefc7ef9-5e52-5cbb-ba38-16df4cea56d9" :answer/type :answer.type/math :answer/value "14\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71986/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "7594410a-7f01-5c04-a747-38ae6d639cf9" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-71986/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "fa580ef5-7b15-581d-93d6-0d9fbfb79fba" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-71986/selection" :answer-field/id #uuid "a5fd970f-898a-5707-aad9-e3983188c49f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71986/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-71986/selection/12b7d840a997b0af25896f37c76d366155c72a970c1525c62ec119b69786f393" "q-71986/selection/e4465a6a43e692e059bf725e1b5cfe61cc1646feb92589579e90f47290e9eaed" "q-71986/selection/96026c62f67888dfc3400c9a4470d77ef75b3b7810ddaffecd50113c8ae39101" "q-71986/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-71986/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-71986" :question/id #uuid "5aa2c32e-1630-5557-b712-bf9edc8bbed7" :question/math-academy-id "q-71986" :question/problem "If $z=4+7\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=4+7\\text{i},$ the real part is $Re(z)=4,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(4) \\\\  & =8.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=4+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=4-7\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(4+7\\text{i})+(4-7\\text{i}) \\\\  & =(4+4)+\\text{i}(7-7) \\\\  & =8+\\text{i}0 \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71986/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52"] :knowledge-point/questions ["q-71986"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71987/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "26197e56-c03f-588d-9089-73a6516ca2a6" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-71987/selection/768cf74dca4dd813660bb6962d5a6b89b880fe3634b6cfb9334c3b6a497a15f3" :answer/id #uuid "dd4c648e-8deb-5db4-accb-8562e0d53db5" :answer/type :answer.type/math :answer/value "2\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71987/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" :answer/id #uuid "d88468a9-7ac6-5911-99ee-44a3998a18b8" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "q-71987/selection/b7374d500a1c93249d8ad6a0b49365645ee9311434840138d0f84ca3b41ae4b7" :answer/id #uuid "2f1c59eb-377e-50c4-be6a-71f54b7a904f" :answer/type :answer.type/math :answer/value "-16+4\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71987/selection/dfa79ea8c0f005d192a25bc3d73b55a3e4817ec79c17e182c6efc0ffdc1e3e15" :answer/id #uuid "1a558f5c-7100-594d-938c-bafee016dd38" :answer/type :answer.type/math :answer/value "4\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71987/selection" :answer-field/id #uuid "8011169d-1837-5a72-be1f-8040492ae243" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71987/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" :answer-field/choices ["q-71987/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-71987/selection/768cf74dca4dd813660bb6962d5a6b89b880fe3634b6cfb9334c3b6a497a15f3" "q-71987/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" "q-71987/selection/b7374d500a1c93249d8ad6a0b49365645ee9311434840138d0f84ca3b41ae4b7" "q-71987/selection/dfa79ea8c0f005d192a25bc3d73b55a3e4817ec79c17e182c6efc0ffdc1e3e15"] :db/ensure [:answer-field/validate]} {:db/id "q-71987" :question/id #uuid "6a6db4d5-e37b-564c-bcd8-fef40005ff98" :question/math-academy-id "q-71987" :question/problem "If $z=-8+2\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=-8+2\\text{i},$ the real part is $Re(z)=-8,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(-8) \\\\  & =-16.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-8+2\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-8-2\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(-8+2\\text{i})+(-8-2\\text{i}) \\\\  & =(-8+(-8))+\\text{i}(2-2) \\\\  & =-16+\\text{i}0 \\\\  & =-16.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71987/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52"] :knowledge-point/questions ["q-71987"] :db/ensure [:knowledge-point/validate]} {:db/id "q-159758/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "7ad7c719-0e5a-5d78-a6ad-8e1254509584" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-159758/selection/c9470aafa189cdabc1f0fad8fb48b4c151ea20f8f211261826dd93d15e6beb1b" :answer/id #uuid "aee1a11d-6dbe-57f7-b668-d0cc72ca05ec" :answer/type :answer.type/math :answer/value "18\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-159758/selection/a5bcf5044d7131cdf0d721e80125a87ad3d00df1e947910bf38c9dd3889981de" :answer/id #uuid "1db4ff04-3eaa-5d46-979b-e92e8a439648" :answer/type :answer.type/math :answer/value "81" :db/ensure [:answer/validate]} {:db/id "q-159758/selection/f4c2248ade11afec5e9fdd86ea29798b6e8ebfc90d188b4f90633f523b221f49" :answer/id #uuid "8d209136-f6b9-5f52-80cd-705074430166" :answer/type :answer.type/math :answer/value "12\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-159758/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "e2f8ac60-74d2-52a1-9616-61f99773804b" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-159758/selection" :answer-field/id #uuid "a6a95aee-abb9-5cff-980f-0010527f0794" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-159758/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer-field/choices ["q-159758/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" "q-159758/selection/c9470aafa189cdabc1f0fad8fb48b4c151ea20f8f211261826dd93d15e6beb1b" "q-159758/selection/a5bcf5044d7131cdf0d721e80125a87ad3d00df1e947910bf38c9dd3889981de" "q-159758/selection/f4c2248ade11afec5e9fdd86ea29798b6e8ebfc90d188b4f90633f523b221f49" "q-159758/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-159758" :question/id #uuid "cb021f36-74b8-5fbc-ac1d-0f42467d1ae6" :question/math-academy-id "q-159758" :question/problem "Given that $z=9+3\\text{i},$ calculate $z\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=9+3\\text{i},$ the real part is $\\text{Re}(z)=9,$ and the imaginary part is $\\text{Im}(z)=3,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & ={9}^{2}+{3}^{2} \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=9+3\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=9-3\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(9+3\\text{i})(9-3\\text{i}) \\\\  & ={9}^{2}+(9)(3)\\text{i}+(-3)(9)\\text{i}-{\\text{i}}^{2}(3)^{2} \\\\  & =81+27\\text{i}-27\\text{i}-(-1)(9) \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-159758/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-159758"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279472/field-1/f18416f35432d431c72acfc39d7e01add033f359c3a10a94fc360561f773edf6" :answer/id #uuid "9a912c6e-2a55-50bb-9ac7-afba784111a0" :answer/type :answer.type/math :answer/value "53" :db/ensure [:answer/validate]} {:db/id "q-279472/field-1" :answer-field/id #uuid "461ff513-85b1-5bf5-9c70-d8ec1fb6ac3e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279472/field-1/f18416f35432d431c72acfc39d7e01add033f359c3a10a94fc360561f773edf6" :answer-field/choices ["q-279472/field-1/f18416f35432d431c72acfc39d7e01add033f359c3a10a94fc360561f773edf6"] :db/ensure [:answer-field/validate]} {:db/id "q-279472" :question/id #uuid "d8f85871-8277-5c6c-a96a-216de2cb3642" :question/math-academy-id "q-279472" :question/problem "If $z=-2+7\\text{i},$ then $z\\overset{―}{z}=${{field-1}}." :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=-2+7\\text{i},$ the real part is $\\text{Re}(z)=-2,$ and the imaginary part is $\\text{Im}(z)=7,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & =(-2)^{2}+{7}^{2} \\\\  & =4+49 \\\\  & =53.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-2+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-2-7\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(-2+7\\text{i})(-2-7\\text{i}) \\\\  & =(-2)^{2}+(-2)(-7)\\text{i}+(7)(-2)\\text{i}-{\\text{i}}^{2}(7)^{2} \\\\  & =4+\\cancel{14\\text{i}}-\\cancel{14\\text{i}}-(-1)(49) \\\\  & =4+49 \\\\  & =53.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279472/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-279472"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279479/field-1/913c59b7a35c2e4d81c174e7557b24de384ebd0f1742751d1a44f680a9e9c682" :answer/id #uuid "bd6104a2-fe8b-5e05-ad9a-6306d5728a87" :answer/type :answer.type/math :answer/value "73" :db/ensure [:answer/validate]} {:db/id "q-279479/field-1/0b264a929df91f183c31537acf560edd2114ab983879cbe61ea3aed58b55bda9" :answer/id #uuid "2e6d14ad-400d-59e3-9fee-6140065b9e7d" :answer/type :answer.type/math :answer/value "55" :db/ensure [:answer/validate]} {:db/id "q-279479/field-1" :answer-field/id #uuid "fba4a822-de09-55ca-ab9b-4a8a9cbf1ed0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279479/field-1/913c59b7a35c2e4d81c174e7557b24de384ebd0f1742751d1a44f680a9e9c682" :answer-field/choices ["q-279479/field-1/913c59b7a35c2e4d81c174e7557b24de384ebd0f1742751d1a44f680a9e9c682" "q-279479/field-1/0b264a929df91f183c31537acf560edd2114ab983879cbe61ea3aed58b55bda9"] :db/ensure [:answer-field/validate]} {:db/id "q-279479" :question/id #uuid "3e03097f-25e9-5676-8547-e2a4836c4d10" :question/math-academy-id "q-279479" :question/problem "If $z=-3-8\\text{i}$, then $z\\overset{―}{z}=${{field-1}}." :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=-3-8\\text{i},$ the real part is $\\text{Re}(z)=-3,$ and the imaginary part is $\\text{Im}(z)=-8,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & =(-3)^{2}+(-8)^{2} \\\\  & =9+64 \\\\  & =73.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-3-8\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-3+8\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(-3-8\\text{i})(-3+8\\text{i}) \\\\  & =(3)^{2}+(-3)(8)\\text{i}+(-8)(-3)\\text{i}-{\\text{i}}^{2}(8)^{2} \\\\  & =9-\\cancel{24\\text{i}}+\\cancel{24\\text{i}}-(-1)(64) \\\\  & =9+64 \\\\  & =73.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-279479/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-279479"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279470/field-1/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b" :answer/id #uuid "e9d8fe9a-f154-53b7-9965-c0a1e8dd7f4d" :answer/type :answer.type/math :answer/value "37" :db/ensure [:answer/validate]} {:db/id "q-279470/field-1" :answer-field/id #uuid "67468291-493e-580f-b521-868c42ee270b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279470/field-1/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b" :answer-field/choices ["q-279470/field-1/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b"] :db/ensure [:answer-field/validate]} {:db/id "q-279470" :question/id #uuid "ae6e4698-a407-5efb-9c25-7234c8cc2dd4" :question/math-academy-id "q-279470" :question/problem "If $z=-6+\\text{i},$ then $z\\overset{―}{z}=${{field-1}}." :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=-6+\\text{i},$ the real part is $\\text{Re}(z)=6,$ and the imaginary part is $\\text{Im}(z)=1,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & =(-6)^{2}+{1}^{2} \\\\  & =36+1 \\\\  & =37.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-6+\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-6-\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(-6+\\text{i})(-6-\\text{i}) \\\\  & =(-6)^{2}+(-6)(-1)\\text{i}+(1)(-6)\\text{i}-{\\text{i}}^{2}(1)^{2} \\\\  & =36+\\cancel{6\\text{i}}-\\cancel{6\\text{i}}-(-1)(1) \\\\  & =36+1 \\\\  & =37.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-279470/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-279470"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71989/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "25ddc0b7-b5e1-5d43-ab34-e7f7df5d70cb" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-71989/selection/96026c62f67888dfc3400c9a4470d77ef75b3b7810ddaffecd50113c8ae39101" :answer/id #uuid "abe138b2-1301-5695-86e1-7793505ccb80" :answer/type :answer.type/math :answer/value "14\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71989/selection/40af5a70d0d9775d218427e5d53387edaba89be1c1934edf4a800c675abb7cb9" :answer/id #uuid "b1668985-4a8b-5600-838a-54196ea0cad0" :answer/type :answer.type/math :answer/value "24\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-71989/selection/f07223adf063c43bfac440bfcfa1f5e709d54202b4c2c93d5f069881800b6a64" :answer/id #uuid "d723c870-2bd4-53a2-bbe4-48f8fe421b38" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "q-71989/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a" :answer/id #uuid "74983a08-0f6c-5edb-92fe-bc13d11a4586" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "q-71989/selection" :answer-field/id #uuid "5c470d82-0a80-56f9-85de-823e5e993ad7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71989/selection/f07223adf063c43bfac440bfcfa1f5e709d54202b4c2c93d5f069881800b6a64" :answer-field/choices ["q-71989/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-71989/selection/96026c62f67888dfc3400c9a4470d77ef75b3b7810ddaffecd50113c8ae39101" "q-71989/selection/40af5a70d0d9775d218427e5d53387edaba89be1c1934edf4a800c675abb7cb9" "q-71989/selection/f07223adf063c43bfac440bfcfa1f5e709d54202b4c2c93d5f069881800b6a64" "q-71989/selection/0674b229b15216f6ea870ccaaf87984357f5d6af66421aad0753c15d921d419a"] :db/ensure [:answer-field/validate]} {:db/id "q-71989" :question/id #uuid "4269613b-9e4c-59b0-b903-a46d5d3219ea" :question/math-academy-id "q-71989" :question/problem "Given that $z=8+6\\text{i}$, calculate $z\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=8+6\\text{i},$ the real part is $\\text{Re}(z)=8,$ and the imaginary part is $\\text{Im}(z)=6,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & ={8}^{2}+{6}^{2} \\\\  & =64+36 \\\\  & =100.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=8+6\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=8-6\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(8+6\\text{i})(8-6\\text{i}) \\\\  & ={8}^{2}+(8)(6)\\text{i}+(-6)(8)\\text{i}-{\\text{i}}^{2}(6)^{2} \\\\  & =64+48\\text{i}-48\\text{i}-(-1)(36) \\\\  & =64+36 \\\\  & =100.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71989/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-71989"] :db/ensure [:knowledge-point/validate]}]
