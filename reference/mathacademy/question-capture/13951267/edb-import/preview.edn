\  & ={9}^{2}+(9)(3)\\text{i}+(-3)(9)\\text{i}-{\\text{i}}^{2}(3)^{2} \\\\  & =81+27\\text{i}-27\\text{i}-(-1)(9) \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$" 13194139533903 true] [17592186264839 1000 #edb/ref 17592186264840 13194139533903 true] [17592186264839 1000 #edb/ref 17592186264841 13194139533903 true] [17592186264839 1000 #edb/ref 17592186264842 13194139533903 true] [17592186264839 1000 #edb/ref 17592186264843 13194139533903 true] [17592186264839 1000 #edb/ref 17592186264844 13194139533903 true] [17592186264839 1040 #edb/ref 17592186045450 13194139533903 true] [17592186264839 1041 "selection" 13194139533903 true] [17592186264839 1104 #edb/ref 17592186264844 13194139533903 true] [17592186264839 1110 #uuid "a6a95aee-abb9-5cff-980f-0010527f0794" 13194139533903 true] [17592186264840 1034 "12" 13194139533903 true] [17592186264840 1103 #edb/ref 17592186045453 13194139533903 true] [17592186264840 1111 #uuid "e2f8ac60-74d2-52a1-9616-61f99773804b" 13194139533903 true] [17592186264841 1034 "81" 13194139533903 true] [17592186264841 1103 #edb/ref 17592186045453 13194139533903 true] [17592186264841 1111 #uuid "1db4ff04-3eaa-5d46-979b-e92e8a439648" 13194139533903 true] [17592186264842 1034 "18\\text{i}" 13194139533903 true] [17592186264842 1103 #edb/ref 17592186045453 13194139533903 true] [17592186264842 1111 #uuid "aee1a11d-6dbe-57f7-b668-d0cc72ca05ec" 13194139533903 true] [17592186264843 1034 "12\\text{i}" 13194139533903 true] [17592186264843 1103 #edb/ref 17592186045453 13194139533903 true] [17592186264843 1111 #uuid "8d209136-f6b9-5f52-80cd-705074430166" 13194139533903 true] [17592186264844 1034 "90" 13194139533903 true] [17592186264844 1103 #edb/ref 17592186045453 13194139533903 true] [17592186264844 1111 #uuid "7ad7c719-0e5a-5d78-a6ad-8e1254509584" 13194139533903 true] [17592186264845 1017 #edb/ref 17592186264846 13194139533903 true] [17592186264845 1089 "q-16419" 13194139533903 true] [17592186264845 1091 #edb/ref 17592186045463 13194139533903 true] [1759218626484