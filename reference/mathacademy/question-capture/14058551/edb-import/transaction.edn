 \\\\  & =-0.3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72052/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "494ef4f7-873c-5d87-85e5-89094c6cc376"] :knowledge-point/questions ["q-72052"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72067/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "b5f35c31-2929-56ff-9839-8e226f845f66" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-72067/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "0612d428-53ce-5d4b-8ccb-8acb67fbd891" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-72067/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "942daf93-3b42-5c19-b08f-253740e4ee38" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-72067/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "77bd4ad6-3b1b-59fe-b2b5-b14e3c15d24d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-72067/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "ca07eec7-fcb8-50a6-aaa3-6c331f43d7a2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-72067/selection" :answer-field/id #uuid "dea59eec-b575-5bd4-9915-771ed028c851" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72067/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-72067/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-72067/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-72067/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-72067/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-72067/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-72067" :question/id #uuid "2365a128-ce89-54a9-89a7-9cb8a874750f" :question/math-academy-id "q-72067" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058551/assets/a93150906c0681b8654370267fb918076338fa8ab5bf68f50a0062a4ab34af1d.png)\n\nThe graph of the function $f(x)$ is shown above. \nApproximate ${f}^{′}(x)$ at the point $x=-1$ using a backward difference approximation with step size $h=2.$" :question/worked-solution "We use the backward difference approximation formula\n\n$$\n{f}^{′}(x)≈\\frac{f(x)-f(x-h)}{h},\n$$\n\n \nat the point $x=-1.$ Applying the above formula with $x=-1$ and $h=2$ gives \n\n$$\n\\begin{aligned}{f}^{′}(-1) & ≈\\frac{f(-1)-f(-1-2)}{2} \\\\  & =\\frac{f(-1)-f(-3)}{2} \\\\  & =\\frac{-1-(-2)}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72067/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b175cb1-6615-540f-9145-224a838e37d0"] :knowledge-point/questions ["q-72067"] :db/ensure [:knowledge-point/validate]} {:db/id "q-47552/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "93b9acb3-33eb-5ffb-8410-09aa06a11ab1" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-47552/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "1bc5c6c0-622e-585e-a2b9-618ad3635eac" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-47552/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "f82bfe38-b97b-5e1b-9268-8792ebb2ccd9" :answer/type :answer.type/m