[{:db/id "q-114894/selection/69ad4957c100ee0da08ebc7cd404b7f19dae858d3fe65310a0edf1f942338c57" :answer/id #uuid "1aaec8e7-d9e0-5056-846b-59b6f661819b" :answer/type :answer.type/math :answer/value "\\frac{3}{2}[17-5\\operatorname{ln}⁡3]" :db/ensure [:answer/validate]} {:db/id "q-114894/selection/8cbab967566f276abba9fe4cd48c76d2448cde8bd78dbf30db3c2c2b6eb4cae0" :answer/id #uuid "9f406faf-a81b-5420-82b1-a3036155282d" :answer/type :answer.type/math :answer/value "\\frac{2}{9}[3-17\\operatorname{ln}⁡2]" :db/ensure [:answer/validate]} {:db/id "q-114894/selection/5d9e4def48e669575afe50f52aa5823fd0659e08d742192e9d91ca790c1cc2cf" :answer/id #uuid "d7917112-ee1f-5168-bd9d-00dad674a524" :answer/type :answer.type/math :answer/value "\\frac{5}{2}[4-3\\operatorname{ln}⁡3]" :db/ensure [:answer/validate]} {:db/id "q-114894/selection/493aaa3d2e8f94bfb352a460b27d2753e916f4b1b6c9c65e04e59034471cf152" :answer/id #uuid "38ecf4bc-a696-5a90-a77a-c4aa468bb831" :answer/type :answer.type/math :answer/value "\\frac{1}{9}[3-11\\operatorname{ln}⁡2]" :db/ensure [:answer/validate]} {:db/id "q-114894/selection/af12092f8db2151469e1936acb08c7a7df210efec7765bbcd79676cca1372ec1" :answer/id #uuid "3c0af266-e4fd-5039-8031-235d28606519" :answer/type :answer.type/math :answer/value "\\frac{2}{3}[1-17\\operatorname{ln}⁡2]" :db/ensure [:answer/validate]} {:db/id "q-114894/selection" :answer-field/id #uuid "5b4e9d14-301b-524f-bf1c-982b0aaeaefb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114894/selection/8cbab967566f276abba9fe4cd48c76d2448cde8bd78dbf30db3c2c2b6eb4cae0" :answer-field/choices ["q-114894/selection/69ad4957c100ee0da08ebc7cd404b7f19dae858d3fe65310a0edf1f942338c57" "q-114894/selection/8cbab967566f276abba9fe4cd48c76d2448cde8bd78dbf30db3c2c2b6eb4cae0" "q-114894/selection/5d9e4def48e669575afe50f52aa5823fd0659e08d742192e9d91ca790c1cc2cf" "q-114894/selection/493aaa3d2e8f94bfb352a460b27d2753e916f4b1b6c9c65e04e59034471cf152" "q-114894/selection/af12092f8db2151469e1936acb08c7a7df210efec7765bbcd79676cca1372ec1"] :db/ensure [:answer-field/validate]} {:db/id "q-114894" :question/id #uuid "75fc371f-8716-5cc5-91fc-744fef7a12f0" :question/math-academy-id "q-114894" :question/problem "${\\int }_{-1}^{0}\\frac{2x+5}{3x-1}\\,\\text{d}x=$" :question/worked-solution "First, we pull out the factor of $3$ from the denominator:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}\\frac{2x+5}{3x-1}\\,\\text{d}x & ={\\int }_{-1}^{0}\\frac{2x+5}{3(x-\\frac{1}{3})}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{-1}^{0}\\frac{2x+5}{(x-\\frac{1}{3})}\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ \\frac{1}{3} & 2 & 5 \\\\  & ↓ & \\frac{2}{3} \\\\  & 2 & \\frac{17}{3}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{2x+5}{(x-\\frac{1}{3})} & =2+\\frac{(\\frac{17}{3})}{(x-\\frac{1}{3})} \\\\  & =2+\\frac{17}{3(x-\\frac{1}{3})} \\\\  & =2+\\frac{17}{3x-1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}\\frac{2x+5}{3x-1}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{-1}^{0}(2+\\frac{17}{3x-1})\\text{d}x \\\\  & =\\frac{1}{3}[2{\\int }_{-1}^{0}\\text{d}x+17{\\int }_{-1}^{0}\\frac{1}{3x-1}\\,\\text{d}x] \\\\  & =\\frac{1}{3}{[2x+\\frac{17}{3}\\operatorname{ln}⁡|3x-1|]}_{-1}^{0} \\\\  & =\\frac{1}{3}[2(0-(-1))+\\frac{17}{3}(\\operatorname{ln}⁡|3(0)-1|-\\operatorname{ln}⁡|3(-1)-1|)] \\\\  & =\\frac{1}{3}[2(1)+\\frac{17}{3}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡4)] \\\\  & =\\frac{1}{3}[2-\\frac{17}{3}\\operatorname{ln}⁡({2}^{2})] \\\\  & =\\frac{1}{3}[2-\\frac{34}{3}\\operatorname{ln}⁡2] \\\\  & =\\frac{2}{9}[3-17\\operatorname{ln}⁡2].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114894/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92"] :knowledge-point/questions ["q-114894"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352241/field-1/9fc7c9ee04032ebc8e2c1778ace8d3b3c72e61e1a82f73d8e6a40bae96d52b58" :answer/id #uuid "4c4b4082-654b-572b-bc3d-108fc664402e" :answer/type :answer.type/math :answer/value "\\frac{39}{2}" :db/ensure [:answer/validate]} {:db/id "q-352241/field-1/3122df2d14addc9e497e6628a545eb88dde4286461fbbf7063a876391a4c2940" :answer/id #uuid "6e1cd509-c711-536f-913a-a00aac0705d8" :answer/type :answer.type/math :answer/value "\\frac{37}{2}" :db/ensure [:answer/validate]} {:db/id "q-352241/field-1" :answer-field/id #uuid "5c341560-85c8-5757-9c8f-e22a92baa23c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352241/field-1/9fc7c9ee04032ebc8e2c1778ace8d3b3c72e61e1a82f73d8e6a40bae96d52b58" :answer-field/choices ["q-352241/field-1/9fc7c9ee04032ebc8e2c1778ace8d3b3c72e61e1a82f73d8e6a40bae96d52b58" "q-352241/field-1/3122df2d14addc9e497e6628a545eb88dde4286461fbbf7063a876391a4c2940"] :db/ensure [:answer-field/validate]} {:db/id "q-352241/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "ba779a34-7b59-5538-86c9-00630ce6f9ba" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-352241/field-2" :answer-field/id #uuid "974eecec-3f5d-54f9-bf1f-6077ef36d2d3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352241/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-352241/field-2/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856"] :db/ensure [:answer-field/validate]} {:db/id "q-352241" :question/id #uuid "11cd7e75-3767-59db-9c1d-67df733e47d8" :question/math-academy-id "q-352241" :question/problem "Evaluate the following integral:\n\n${\\int }_{1}^{4}\\frac{{x}^{2}+5x+3}{x+1}\\,\\text{d}x=$ \n{{field-1}} $-\\,\\operatorname{ln}⁡(${{field-2}}$)$" :question/worked-solution "The denominator of the integrand doesn't divide the numerator exactly, so we need to decompose it into its quotient and remainder. For this, we can use synthetic division.\n\nWe start by drawing up our synthetic division table:\n\n|  | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- |\n| $-1$ | $1$ | $5$ | $3$ |\n|  | $↓$ | $-1$ | $-4$ |\n|  | $1$ | $4$ | $-1$ |\n\nSo, from the synthetic division, we get that\n\n$$\n\\frac{{x}^{2}+5x+3}{x+1}=x+4-\\frac{1}{x+1}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{{x}^{2}+5x+3}{x+1}\\,\\text{d}x & ={\\int }_{1}^{4}(x+4-\\frac{1}{x+1})\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}x\\,\\text{d}x+4{\\int }_{1}^{4}\\text{d}x-{\\int }_{1}^{4}\\frac{1}{x+1}\\,\\text{d}x \\\\  & =\\frac{{x}^{2}}{2}\\,{|}_{1}^{4}+4x\\,{|}_{1}^{4}-\\operatorname{ln}⁡|x+1|\\,{|}_{1}^{4} \\\\  & =\\frac{1}{2}({4}^{2}-{1}^{2})+4(4-1)-(\\operatorname{ln}⁡|4+1|-\\operatorname{ln}⁡|1+1|) \\\\  & =\\frac{15}{2}+12-(\\operatorname{ln}⁡5-\\operatorname{ln}⁡2) \\\\  & =\\frac{39}{2}-\\operatorname{ln}⁡(\\,\\frac{5}{2}\\,).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352241/field-1" "q-352241/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f110daa3-fd31-5e34-8a88-0e002c2e418a"] :knowledge-point/questions ["q-352241"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352426/field-1/b937b5a9c9148a5914243385a1d84bacb019d6c5ff771ce01182a0f3091b9285" :answer/id #uuid "20d215d5-09cd-57a3-a85f-0ce8084bb08d" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id "q-352426/field-1/29648ef4e020fc43d1b46acbdbbedfd18f3de75ade3ca2e0ef505839d2f8c39b" :answer/id #uuid "c50146ee-33ff-540f-aeef-7e0308168805" :answer/type :answer.type/math :answer/value "\\frac{7}{5}" :db/ensure [:answer/validate]} {:db/id "q-352426/field-1" :answer-field/id #uuid "2199637e-731f-5a4c-80a3-5b917b9eb88d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352426/field-1/b937b5a9c9148a5914243385a1d84bacb019d6c5ff771ce01182a0f3091b9285" :answer-field/choices ["q-352426/field-1/b937b5a9c9148a5914243385a1d84bacb019d6c5ff771ce01182a0f3091b9285" "q-352426/field-1/29648ef4e020fc43d1b46acbdbbedfd18f3de75ade3ca2e0ef505839d2f8c39b"] :db/ensure [:answer-field/validate]} {:db/id "q-352426/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d7fbe7cc-0751-5b45-a36c-f2e21c225b87" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-352426/field-2" :answer-field/id #uuid "2288fcc5-089c-552e-b596-a5065cc3e2ab" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352426/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-352426/field-2/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-352426" :question/id #uuid "597be215-9886-599f-a0c2-2e724a7508e9" :question/math-academy-id "q-352426" :question/problem "Evaluate the following integral:\n\n${\\int }_{0}^{1}\\frac{8x-7}{5x+1}\\,\\text{d}x=$\n{{field-1}} $-\\,\\frac{43}{25}\\operatorname{ln}⁡($\n{{field-2}} $)$" :question/worked-solution "First, we pull out the factor of $5$ from the denominator:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{8x-7}{5x+1}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{8x-7}{5(x+\\frac{1}{5})}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{0}^{1}\\frac{8x-7}{(x+\\frac{1}{5})}\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n|  | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- |\n| $-\\frac{1}{5}$ | $8$ | $-7$ |\n|  | $↓$ | $-\\frac{8}{5}$ |\n|  | $8$ | $-\\frac{43}{5}$ |\n\nSo, from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{8x-7}{(x+\\frac{1}{5})} & =8-\\frac{(\\frac{43}{5})}{(x+\\frac{1}{5})} \\\\  & =8-\\frac{43}{5x+1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{8x-7}{5x+1}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{0}^{1}(8-\\frac{43}{5x+1})\\,\\text{d}x \\\\  & =\\frac{1}{5}[8{\\int }_{0}^{1}\\text{d}x-43{\\int }_{0}^{1}\\frac{1}{5x+1}\\,\\text{d}x] \\\\  & =\\frac{1}{5}{[8x-\\frac{43}{5}\\operatorname{ln}⁡|5x+1|]}_{0}^{1} \\\\  & =\\frac{1}{5}[8(1-0)-\\frac{43}{5}(\\operatorname{ln}⁡|6|-\\operatorname{ln}⁡|1|)] \\\\  & =\\frac{8}{5}-\\frac{43}{25}\\operatorname{ln}⁡(6).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-352426/field-1" "q-352426/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92"] :knowledge-point/questions ["q-352426"] :db/ensure [:knowledge-point/validate]}]
