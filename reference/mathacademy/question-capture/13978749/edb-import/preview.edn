\\theta ({csc}^{2}⁡\\theta -1)}{\\operatorname{csc}⁡\\theta -1}-\\operatorname{cot}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta (\\operatorname{csc}⁡\\theta +1)(\\operatorname{csc}⁡\\theta -1)}{\\operatorname{csc}⁡\\theta -1}-\\operatorname{cot}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta (\\operatorname{csc}⁡\\theta +1)\\cancel{(\\operatorname{csc}⁡\\theta -1)}}{\\cancel{\\operatorname{csc}⁡\\theta -1}}-\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta (\\operatorname{csc}⁡\\theta +1)-\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{csc}⁡\\theta +\\operatorname{cos}⁡\\theta -\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta +\\operatorname{cos}⁡\\theta -\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" 13194139534149 true] [17592186278794 1000 #edb/ref 17592186278795 13194139534149 true] [17592186278794 1000 #edb/ref 17592186278796 13194139534149 true] [17592186278794 1000 #edb/ref 17592186278797 13194139534149 true] [17592186278794 1000 #edb/ref 17592186278798 13194139534149 true] [17592186278794 1000 #edb/ref 17592186278799 13194139534149 true] [17592186278794 1040 #edb/ref 17592186045450 13194139534149 true] [17592186278794 1041 "selection" 13194139534149 true] [17592186278794 1104 #edb/ref 17592186278797 13194139534149 true] [17592186278794 1110 #uuid "6af0b178-0edc-555c-b1a9-86618f9f696e" 13194139534149 true] [17592186278795 1034 "1-\\operatorname{cos}⁡\\theta " 13194139534149 true] [17592186278795 1103 #edb/ref 17592186045453 13194139534149 true] [17592186278795 1111 #uuid "46ad00c6-cf0b-5e9f-a4a2-a4d68188191b" 13194139534149 true] [17592186278796 1034 "2\\operatorname{cos}⁡\\theta " 13194139534149 true] [17592186278796 1103 #edb/ref 17592186045453 13194139534149 true] [17592186278796 1111 #uuid "76801278-231d-5c53-8bb9-0f171ad67744" 13194139534149 true] [17592186278797 1034 "\\operatorname{cos}⁡\\theta " 13194139534149 true] [17592186278797 