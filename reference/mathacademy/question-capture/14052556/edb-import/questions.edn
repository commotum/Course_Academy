#{[{:db/id #edb/ref 17592186315099 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c241ca2c-bbf5-5377-99ef-435cbc377753" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.5)≈0.424" :db/id #edb/ref 17592186315101} {:answer/id #uuid "567f12c8-c922-5d6d-a930-99483ea9ef1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.5)≈0.421" :db/id #edb/ref 17592186315102} {:answer/id #uuid "9741e3d2-fd7b-5558-b19b-bdf48cbd60cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.5)≈0.415" :db/id #edb/ref 17592186315103} {:answer/id #uuid "2f228185-df63-5c8b-98a0-43513296937c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.5)≈0.412" :db/id #edb/ref 17592186315104} {:answer/id #uuid "8e2a8e6d-716f-51cb-a80f-fd19f36cadd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.5)≈0.417" :db/id #edb/ref 17592186315105}] :answer-field/correct {:answer/id #uuid "8e2a8e6d-716f-51cb-a80f-fd19f36cadd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1.5)≈0.417" :db/id #edb/ref 17592186315105} :answer-field/id #uuid "4e2e4c4f-5dd7-5f99-a0fe-b40a225fa0bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186315100}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "56b858e8-c4fa-5c2c-84ef-c3854e0367d4" :question/math-academy-id "q-126875" :question/problem "Use the first three non-zero terms of the Taylor expansion for $f(x)=\\operatorname{ln}⁡(x+1)$ about $x=0$ to approximate the value of $\\operatorname{ln}⁡(1.5).$ Give your answer to $3$ decimal places." :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=0.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(x+1) \\\\ f(0) & =\\operatorname{ln}⁡(0+1)=0 \\\\ {f}^{′}(x) & =\\frac{1}{x+1} \\\\ {f}^{′}(0) & =\\frac{1}{0+1}=1 \\\\ {f}^{″}(x) & =-\\frac{1}{(x+1)^{2}} \\\\ {f}^{″}(0) & =-\\frac{1}{(0+1)^{2}}=-1 \\\\ {f}^{‴}(x) & =\\frac{2}{(x+1)^{3}} \\\\ {f}^{‴}(0) & =\\frac{2}{(0+1)^{3}}=2.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x+1) & =(0)+(1)(x-0)+\\frac{(-1)}{2!}(x-0)^{2}+\\frac{(2)}{3!}(x-0)^{3}+⋯ \\\\  & =x-\\frac{1}{2}{x}^{2}+\\frac{1}{3}{x}^{3}+⋯\\,.\\end{aligned}\n$$\n\nWe substitute $x=0.5$ into the above to approximate $\\operatorname{ln}⁡(1.5).$ We get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡1.5 & ≈(0.5)-\\frac{1}{2}(0.5)^{2}+\\frac{1}{3}(0.5)^{3} \\\\  & =0.417\\,,\\end{aligned}\n$$\n\nto three decimal places."}] [{:db/id #edb/ref 17592186315120 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00f7733a-e203-5955-a0c4-4651f483748d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+3}=1+2(x+2)+3(x+2)^{2}+6(x+2)^{3}+⋯" :db/id #edb/ref 17592186315122} {:answer/id #uuid "4769134a-6e2d-5876-ba70-e6374cc2431f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+3}=1-(x+2)+(x+2)^{2}-(x+2)^{3}+⋯" :db/id #edb/ref 17592186315123} {:answer/id #uuid "1c1e193b-b2cd-570e-9408-725025ccf94b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+3}=1-(x+2)+\\frac{(x+2)^{2}}{2}-\\frac{(x+2)^{3}}{6}+⋯" :db/id #edb/ref 17592186315124} {:answer/id #uuid "46a98f0c-90ce-5056-b47d-e43ad80d0bfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+3}=1-(x+2)+\\frac{(x+2)^{2}}{8}-\\frac{(x+2)^{3}}{24}+⋯" :db/id #edb/ref 17592186315125} {:answer/id #uuid "1bb24355-b6fc-5261-a43e-938374eab8b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+3}=1-\\frac{(x+2)}{2}+\\frac{(x+2)^{2}}{6}-\\frac{(x+2)^{3}}{24}+⋯" :db/id #edb/ref 17592186315126}] :answer-field/correct {:answer/id #uuid "4769134a-6e2d-5876-ba70-e6374cc2431f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x+3}=1-(x+2)+(x+2)^{2}-(x+2)^{3}+⋯" :db/id #edb/ref 17592186315123} :answer-field/id #uuid "4c71e486-aef9-537f-8515-b3787190972b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186315121}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b7afe118-2a0b-56b6-9c4b-c1f500a7e109" :question/math-academy-id "q-83185" :question/problem "Find the first four non-zero terms in the Taylor expansion of $\\frac{1}{x+3}$ about the point $x=-2.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\frac{1}{x+3}$ and $a=-2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{x+3}=(x+3)^{-1} \\\\ f(-2) & =(-2+3)^{-1}=1 \\\\ {f}^{′}(x) & =-\\frac{1}{(x+3)^{2}}=-(x+3)^{-2} \\\\ {f}^{′}(-2) & =-(-2+3)^{-2}=-1 \\\\ {f}^{″}(x) & =\\frac{2}{(x+3)^{3}}=2(x+3)^{-3} \\\\ {f}^{″}(-2) & =2(-2+3)^{-3}=2 \\\\ {f}^{‴}(x) & =-\\frac{6}{(x+3)^{4}}=-6(x+3)^{-4} \\\\ {f}^{‴}(-2) & =-6(-2+3)^{-4}=-6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{x+3} & =1+(-1)(x+2)+\\frac{2}{2!}(x+2)^{2}+\\frac{(-6)}{3!}(x+2)^{3}+⋯ \\\\  & =1-(x+2)+(x+2)^{2}-(x+2)^{3}+⋯.\\end{aligned}\n$$"}]}
