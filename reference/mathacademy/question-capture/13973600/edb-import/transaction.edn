[{:db/id "q-319112/field-1/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" :answer/id #uuid "314415fe-7cd9-52b3-80ba-cb0a22a689ec" :answer/type :answer.type/math :answer/value "-28" :db/ensure [:answer/validate]} {:db/id "q-319112/field-1" :answer-field/id #uuid "64537d78-b188-5768-9579-25652dc3ba52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319112/field-1/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" :answer-field/choices ["q-319112/field-1/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64"] :db/ensure [:answer-field/validate]} {:db/id "q-319112" :question/id #uuid "f10c0b88-4a8e-58c9-9d15-7c8f967e4b7a" :question/math-academy-id "q-319112" :question/problem "For the matrix\n$C=[\\begin{aligned}5 & 2 & -1 \\\\ 0 & 3 & 4 \\\\ 7 & -2 & 6\\end{aligned}].$\nfind the minor ${M}_{12}$ of the entry ${c}_{12}.$\n\n${M}_{12}=${{field-1}}" :question/worked-solution "The minor of ${c}_{12}=2$ (first row, second column) is the determinant of the remaining entries when the column and row containing $2$ are removed: \n\n$$\nC=[\\begin{aligned}∗ & 2 & ∗ \\\\ 0 & ∗ & 4 \\\\ 7 & ∗ & 6\\end{aligned}]\n$$\n\nSo, the minor of ${c}_{12}=2$ is\n\n$$\n\\begin{aligned}{M}_{12} & =\\text{det}[\\begin{aligned}0 & 4 \\\\ 7 & 6\\end{aligned}] \\\\  & =|\\begin{aligned}0 & 4 \\\\ 7 & 6\\end{aligned}| \\\\  & =0\\cdot 6-4\\cdot 7 \\\\  & =0-28 \\\\  & =-28.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319112/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975"] :knowledge-point/questions ["q-319112"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319108/field-1/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer/id #uuid "65a64608-b3d9-5990-96f5-373a317ec442" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-319108/field-1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer/id #uuid "3739d46d-02d9-52d2-a43c-66905d92a3b2" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "q-319108/field-1" :answer-field/id #uuid "73d40608-5717-5dd1-9732-d77ac06d67e5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319108/field-1/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer-field/choices ["q-319108/field-1/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" "q-319108/field-1/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b"] :db/ensure [:answer-field/validate]} {:db/id "q-319108" :question/id #uuid "12b90c27-f9b6-5491-8e56-f08735a304f1" :question/math-academy-id "q-319108" :question/problem "For the matrix\n$B=[\\begin{aligned}1 & 2 & -3 \\\\ 4 & 0 & 5 \\\\ 7 & -2 & 6\\end{aligned}].$\nfind the minor ${M}_{22}$ of the entry ${b}_{22}.$\n\n${M}_{22}=${{field-1}}" :question/worked-solution "The minor of ${b}_{22}=0$ (second row, second column) is the determinant of the remaining entries when the column and row containing $0$ are removed: \n\n$$\nB=[\\begin{aligned}1 & ∗ & -3 \\\\ ∗ & 0 & ∗ \\\\ 7 & ∗ & 6\\end{aligned}]\n$$\n\nSo, the minor of ${b}_{22}=0$ is\n\n$$\n\\begin{aligned}{M}_{22} & =\\text{det}[\\begin{aligned}1 & -3 \\\\ 7 & 6\\end{aligned}] \\\\  & =|\\begin{aligned}1 & -3 \\\\ 7 & 6\\end{aligned}| \\\\  & =1\\cdot 6-(-3)\\cdot 7 \\\\  & =6-(-21) \\\\  & =6+21 \\\\  & =27.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-319108/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975"] :knowledge-point/questions ["q-319108"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127698/selection/0d6cb492ac07e225bfef5d0d6856c2b70440afbca873cb89f25961460b64c012" :answer/id #uuid "8cf23f1a-a86d-5d67-8724-0c726f29d882" :