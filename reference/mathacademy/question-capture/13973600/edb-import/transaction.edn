 & =x+55.\\end{aligned}\n$$\n\nWe're told that the minor of ${d}_{31}$ is $43$, so we must have:\n\n$$\n\\begin{aligned}x+55 & =43 \\\\ x & =-12\\end{aligned}\n$$\n\nTherefore, the solution is $x=-12.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-18240/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-18240"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319146/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "eda888d0-7bf8-58da-b004-4c3c684660a3" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-319146/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "21f85eeb-27c5-5051-8009-9431ecd18780" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-319146/field-1" :answer-field/id #uuid "89eaea32-a181-5ab1-8c11-39aca8439e79" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319146/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-319146/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-319146/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-319146/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "05640802-8be2-5778-9f76-e0c423c8b4ed" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-319146/field-2" :answer-field/id #uuid "bb235530-ad1e-5380-90e1-31a2ae117c83" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319146/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-319146/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-319146" :question/id #uuid "b4e0bf0c-7585-5f5b-934d-8a0791dbf0c4" :question/math-academy-id "q-319146" :question/problem "Given that the minor of ${a}_{11}$ is $0$, find all the possible values of $p$ in the matrix\n\n$$\nA=[\\begin{aligned}5 & 2 & 3 \\\\ 1 & p & 7 \\\\ 6 & -8 & p-15\\end{aligned}].\n$$\n\nIn **ascending order**, the values of $p$ are\n\n$p=$ \n{{field-1}} $\\,$ and $\\,p=$\n{{field-2}}." :question/worked-solution "To evaluate the minor of ${a}_{11},$ we remove the first row and first column:\n\n$$\nA=[\\begin{aligned}5 & ∗ & ∗ \\\\ ∗ & p & 7 \\\\ ∗ & -8 & p-15\\end{aligned}]\n$$\n\nSo, the minor of ${a}_{11}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}p & 7 \\\\ -8 & p-15\\end{aligned}] & =|\\begin{aligned}p & 7 \\\\ -8 & p-15\\end{aligned}| \\\\  & =p(p-15)-7(-8) \\\\  & ={p}^{2}-15p+56.\\end{aligned}\n$$\n\nWe're told that the minor of ${a}_{11}$ is $0$, so we get\n\n$$\n\\begin{aligned}{p}^{2}-15p+56 & =0 \\\\ (p-7)(p-8) & =0.\\end{aligned}\n$$\n\nTherefore, in ascending order, the solutions are $p=7$ and $p=8.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-319146/field-1" "q-319146/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-319146"] :db/ensure [:knowledge-point/validate]} {:db/id "q-319129/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "1d040552-271b-560e-a9ef-d46c351a354f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-319129/field-1" :answer-field/id #uuid "716ee75c-548b-593d-8812-b8ba0789037a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-319129/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-319129/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-319129" :question/id #uuid "6d45b8ed-5634-5d58-870a-718c8f538e7e" :question/math-academy-id "q-319129" :question/problem "$$\nF=[\\begin{aligned}y & 3 & 1 \\\\ 2 & 5 & 4 \\\\ 7 & 8 & 9\\end{aligned}].\n$$\n\nGiven that the minor of ${f}_{32}$ is $10$, find the value of $y$ in the matrix above.\n\n$y=$\n {{field-1}}" :question/worked-solution "To evaluate the minor of ${f}_{32},$ we remove the third row and second column: \n\n$$\nF=[\\begin{aligned}y & ∗ & 1 \\\\ 2 & ∗ & 4 \\\\ ∗ & 8 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${f}_{32}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}y & 1 \\\\ 2 & 4\\end{aligned}] & =|\\begin{aligned}y & 1 \\\\ 2 & 4\\end{aligned}| \\\\  & =y\\cdot 4-1\\cdot 2 \\\\  & =4y-2.\\end{aligned}\n$$\n\nWe're told that the minor of ${f}_{32}$ is $10$, so we get\n\n$$\n\\begin{aligned}4y-2 & =10 \\\\ 4y & =12 \\\\ y & =3.\\end{aligned}\n$$\n\nTherefore, the solution is $y=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-319129/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-319129"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42614/selection/b4f3660a9cf904ba96292908764d8d8ba5f4ad18fd8f8c80e401f74724f41606" :answer/id #uuid "665cf5ac-10dc-5b08-b1e1-50ed7f8f6ce9" :answer/type :answer.type/text :answer/value "$k=8$ and $k=-6$ only" :db/ensure [:answer/validate]} {:db/id "q-42614/selection/7c0981beda9e4cdf4c5b9764d8408b852586e78171dfc5d144a7812cbcca32ce" :answer/id #uuid "62951165-341a-54bc-a355-1e24fea0c1df" :answer/type :answer.type/text :answer/value "$k=-3$ and $k=6$ only" :db/ensure [:answer/validate]} {:db/id "q-42614/selection/b3bec289e3b9e605e95e578fb78b93cc5db44d7e289737d1419aedb220f0cc89" :answer/id #uuid "3da00856-081f-573e-b917-2dc505021757" :answer/type :answer.type/text :answer/value "$k=-6$ only" :db/ensure [:answer/validate]} {:db/id "q-42614/selection/875a1b926fb29c5e1230aace9ec8cfc868842dcec9f4486bb0d80ed06e540c9e" :answer/id #uuid "0297a401-f27a-5e46-b31e-41425ff749ef" :answer/type :answer.type/text :answer/value "$k=3$ and $k=-6$ only" :db/ensure [:answer/validate]} {:db/id "q-42614/selection/131c787bc7b740c35319c8ab1c9e22c67bc83f33298838c9ef5fa0f2cf62510a" :answer/id #uuid "070a7cda-fe29-5b98-9200-9aba9862c0f0" :answer/type :answer.type/text :answer/value "$k=3$ and $k=6$ only" :db/ensure [:answer/validate]} {:db/id "q-42614/selection" :answer-field/id #uuid "a849424b-369c-5569-8573-69570a2abc1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42614/selection/875a1b926fb29c5e1230aace9ec8cfc868842dcec9f4486bb0d80ed06e540c9e" :answer-field/choices ["q-42614/selection/b4f3660a9cf904ba96292908764d8d8ba5f4ad18fd8f8c80e401f74724f41606" "q-42614/selection/7c0981beda9e4cdf4c5b9764d8408b852586e78171dfc5d144a7812cbcca32ce" "q-42614/selection/b3bec289e3b9e605e95e578fb78b93cc5db44d7e289737d1419aedb220f0cc89" "q-42614/selection/875a1b926fb29c5e1230aace9ec8cfc868842dcec9f4486bb0d80ed06e540c9e" "q-42614/selection/131c787bc7b740c35319c8ab1c9e22c67bc83f33298838c9ef5fa0f2cf62510a"] :db/ensure [:answer-field/validate]} {:db/id "q-42614" :question/id #uuid "7d3c4b09-0a4b-5edb-9bbd-4cd83aed736b" :question/math-academy-id "q-42614" :question/problem "Given that the minor of ${m}_{22}$ is $3{k}^{2}-45$, find all the possible values of $k$ in the matrix\n\n$$\nM=[\\begin{aligned}2 & 5 & 1 \\\\ 3 & -4 & -1 \\\\ 9k-15 & 9 & -3\\end{aligned}].\n$$" :question/worked-solution "First, we remove the second row and second column:\n\n$$\nM=[\\begin{aligned}2 & ∗ & 1 \\\\ ∗ & -4 & ∗ \\\\ 9k-15 & ∗ & -3\\end{aligned}]\n$$\n\nThe minor of ${m}_{22}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}2 & 1 \\\\ 9k-15 & -3\\end{aligned}] & =|\\begin{aligned}2 & 1 \\\\ 9k-15 & -3\\end{aligned}| \\\\  & =2\\cdot (-3)-(9k-15)\\cdot 1 \\\\  & =-6-(9k-15) \\\\  & =-9k+9.\\end{aligned}\n$$\n\nWe're told that the minor of ${m}_{22}$ is $3{k}^{2}-45$, so we must have:\n\n$$\n\\begin{aligned}-9k+9 & =3{k}^{2}-45 \\\\ -3k+3 & ={k}^{2}-15 \\\\ {k}^{2}+3k-18 & =0 \\\\ (k-3)(k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=3$ and $k=-6.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-42614/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-42614"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4439"] :question/problem "Calculate the minor of the entry $b_{21}$ in the matrix\n\n$$\n[\\begin{aligned}10 & 1 & 5 \\\\ 3 & 6 & 8 \\\\ 4 & 7 & 2\\end{aligned}]\n$$" :question/worked-solution "The minor of $b_{21} = 3$ (second row, first column) is the determinant of the remaining entries when the column and row containing $3$ are removed: \n\n$$\n[\\begin{aligned}∗ & 1 & 5 \\\\ 3 & ∗ & ∗ \\\\ ∗ & 7 & 2\\end{aligned}]\n$$\n\nSo, the minor of $b_{21}=3$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}] & =|\\begin{aligned}1 & 5 \\\\ 7 & 2\\end{aligned}| \\\\  & =1\\cdot 2-5\\cdot 7 \\\\  & =2-35 \\\\  & =-33.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4440"] :question/problem "What is the minor of $c_{22}$ in the matrix\n\n$$\n[\\begin{aligned}7x & 0 & -3y \\\\ 1 & x+2y & 4 \\\\ -y & 0 & 5\\end{aligned}]\n$$" :question/worked-solution "First, we remove the second row and second column: \n\n$$\n[\\begin{aligned}7x & ∗ & -3y \\\\ ∗ & x+2y & ∗ \\\\ -y & ∗ & 5\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}] & =|\\begin{aligned}7x & -3y \\\\ -y & 5\\end{aligned}| \\\\  & =7x\\cdot 5-(-3y)\\cdot (-y) \\\\  & =35x-3{y}^{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4441"] :question/problem "Given that the minor of $a_{23}$ is $5,$ find all the possible values of $k$ in the matrix\n\n$$\n[\\begin{aligned}k & 3 & -1 \\\\ -5 & 2 & 7 \\\\ -1 & 2k & -6\\end{aligned}]\n$$" :question/worked-solution "First, we remove the second row and third column:\n\n$$\n[\\begin{aligned}k & 3 & ∗ \\\\ ∗ & ∗ & 7 \\\\ -1 & 2k & ∗\\end{aligned}]\n$$\n\nThe minor of $a_{23}$ is\n\n$$\n\\begin{aligned}det[\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}] & =|\\begin{aligned}k & 3 \\\\ -1 & 2k\\end{aligned}| \\\\  & =k\\cdot 2k-3\\cdot (-1) \\\\  & =2{k}^{2}+3.\\end{aligned}\n$$\n\nWe're told that the minor of $a_{23}$ is $5,$ so we must have:\n\n$$\n\\begin{aligned}2{k}^{2}+3 & =5 \\\\ 2{k}^{2} & =2 \\\\ {k}^{2} & =1 \\\\ k & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the solutions are $k=-1$ and $k=1.$" :db/ensure [:question/validate]}]
