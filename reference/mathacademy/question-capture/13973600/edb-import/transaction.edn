\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128030/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-128030"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69739/selection/91d3493a6fdfbfd2c4184605be70b3da0343f1f6e34cc2dcba5d1de94f4132ee" :answer/id #uuid "e9f279b7-f9a3-5932-8ea6-0235acde5c10" :answer/type :answer.type/math :answer/value "5pq" :db/ensure [:answer/validate]} {:db/id "q-69739/selection/26acf412577e10dda400fb457cb1a3a35eb3929168d29f3ca65fa7e3285affca" :answer/id #uuid "8e1fde77-77ac-535f-8692-b976c424b4bd" :answer/type :answer.type/math :answer/value "-4{q}^{2}{p}^{2}" :db/ensure [:answer/validate]} {:db/id "q-69739/selection/8cfa1f7fe49886862a5ee1d6985e77b277525675aabec4b0584dc0f568269994" :answer/id #uuid "42aeb26b-7d1f-5842-87d7-1aacf7f9ba19" :answer/type :answer.type/math :answer/value "{p}^{2}-3q" :db/ensure [:answer/validate]} {:db/id "q-69739/selection/0604eeacbbd435974f37d96aaf6062718dd16f9351b85c60c82a8de4867e0147" :answer/id #uuid "9cd72394-b125-540d-80c4-6d8e8ed61845" :answer/type :answer.type/math :answer/value "3{q}^{2}p" :db/ensure [:answer/validate]} {:db/id "q-69739/selection/d52b2452b8c2bba1fea35e8bfc1df3d60d347c556806b84650d5aa995b48d324" :answer/id #uuid "56cf3a4e-c942-5bb6-a759-4998e695c68f" :answer/type :answer.type/math :answer/value "-6pq" :db/ensure [:answer/validate]} {:db/id "q-69739/selection" :answer-field/id #uuid "3426c01c-ee4c-54ca-aad8-b05d3dc8c72e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69739/selection/91d3493a6fdfbfd2c4184605be70b3da0343f1f6e34cc2dcba5d1de94f4132ee" :answer-field/choices ["q-69739/selection/91d3493a6fdfbfd2c4184605be70b3da0343f1f6e34cc2dcba5d1de94f4132ee" "q-69739/selection/26acf412577e10dda400fb457cb1a3a35eb3929168d29f3ca65fa7e3285affca" "q-69739/selection/8cfa1f7fe49886862a5ee1d6985e77b277525675aabec4b0584dc0f568269994" "q-69739/selection/0604eeacbbd435974f37d96aaf6062718dd16f9351b85c60c82a8de4867e0147" "q-69739/selection/d52b2452b8c2bba1fea35e8bfc1df3d60d347c556806b84650d5aa995b48d324"] :db/ensure [:answer-field/validate]} {:db/id "q-69739" :question/id #uuid "83b33ace-dbbf-5ce4-ae5e-36a23887dffc" :question/math-academy-id "q-69739" :question/problem "What is the minor of ${e}_{32}$ in the matrix\n$E=[\\begin{aligned}2p & p & -q \\\\ -p & {q}^{2} & 3q \\\\ q & 0 & q\\end{aligned}]?$" :question/worked-solution "First, we remove the third row and the second column:\n\n$$\nE=[\\begin{aligned}2p & ∗ & -q \\\\ -p & ∗ & 3q \\\\ ∗ & 0 & ∗\\end{aligned}]\n$$\n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}2p & -q \\\\ -p & 3q\\end{aligned}] & =|\\begin{aligned}2p & -q \\\\ -p & 3q\\end{aligned}| \\\\  & =2p\\cdot 3q-(-q)\\cdot (-p) \\\\  & =6pq-pq \\\\  & =5pq\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-69739/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787"] :knowledge-point/questions ["q-69739"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275502/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "f1ca767d-b19c-5193-9532-f4a99bc4b26b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-275502/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "36c26cc0-0dac-5a9a-90be-3318447ef9e6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-275502/field-1" :answer-field/id #uuid "ead1b973-ab23-513f-b921-b750a8990a1a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275502/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-275502/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-275502/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-275502" :question/id #uuid "18074bc1-0ac7-5c79-ba98-6b0d1083f938" :question/math-academy-id "q-275502" :question/problem "$$\nC=[\\begin{aligned}x & 2 & 3 \\\\ 4 & 5 & 6 \\\\ 7 & 8 & 9\\end{aligned}].\n$$\n\nGiven that the minor of ${c}_{32}$ is $18$, find the value of $x$ in the matrix above.\n\n$x=$\n {{field-1}}" :question/worked-solution "To evaluate the minor of ${c}_{32},$ we remove the third row and second column: \n\n$$\nC=[\\begin{aligned}x & ∗ & 3 \\\\ 4 & ∗ & 6 \\\\ ∗ & 8 & ∗\\end{aligned}]\n$$\n\nSo, the minor of ${c}_{32}$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}x & 3 \\\\ 4 & 6\\end{aligned}] & =|\\begin{aligned}x & 3 \\\\ 4 & 6\\end{aligned}| \\\\  & =x\\cdot 6-3\\cdot 4 \\\\  & =6x-12.\\end{aligned}\n$$\n\nWe're told that the minor of ${c}_{32}$ is $18$, so we get\n\n$$\n\\begin{aligned}6x-12 & =18 \\\\ 6x & =30 \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the solution is $x=5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-275502/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4aa65a73-e750-5052-9249-7c096297ae51"] :knowledge-point/questions ["q-275502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18240/selection/1bbbc98c58333b1884462461af793863c9968622cadbf4fab30ea1ed3502da79" :answer/id #uuid "b6613d62-ff37-5db0-b287-427d552fccc4" :answer/type :answer.type/math :answer/value "x=24" :db/ensure [:answer/validate]} {:db/id "q-18240/selection/af86b5ad5980c6f8a2a4e0fb1e31ea973a090ce54491a38b8db03542271a309e" :answer/id #uuid "643f18dc-45b9-58f9-be1a-370f3d299182" :answer/type :answer.type/math :answer/value "x=-12" :db/ensure [:answer/validate]} {:db/id "q-18240/selection/7514809b5b55b9b92cbca699bbe54790ed947056550b4b65d2cbad410fe3eb94" :answer/id #uuid "2ec2ff13-3b71-5645-8344-533c2e