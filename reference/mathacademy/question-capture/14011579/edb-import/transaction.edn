gned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114164/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3"] :knowledge-point/questions ["q-114164"] :db/ensure [:knowledge-point/validate]}]
