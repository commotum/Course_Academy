d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (\\frac{2}{|x|\\sqrt{{x}^{2}-1}}-3\\operatorname{cos}⁡x)\\text{d}x \\\\  & =\\int \\frac{2}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x-\\int 3\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x-3\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2\\text{ arcsec }x-3\\operatorname{sin}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49136/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3"] :knowledge-point/questions ["q-49136"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49150/selection/5b208a75abd57447974e8aef5944a3b7ef00c34340e913db66bcb5c6caf9f44d" :answer/id #uuid "80c706bd-67a0-5c85-9210-3852ebc5350e" :answer/type :answer.type/math :answer/value "x+6\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49150/selection/543fc1757353fd6fe42bc2ffbe5071639fa514f4581708a0ae9c1ffa85f6c003" :answer/id #uuid "cc39e3d1-42b1-5be2-827e-72eeae20c794" :answer/type :answer.type/math :answer/value "x-8\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49150/selection/d3a913dec7ee1f8fa95c68114ce8caaf798a5ee932ae3681d7bfcc8894cb1f33" :answer/id #uuid "27872e7d-76fd-5be2-860c-67d277d21e7b" :answer/type :answer.type/math :answer/value "x-6\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49150/selection/c03a51da8210daa5345b630c967f22edf6af640e564b90be6b643c6189a0cf62" :answer/id #uuid "5b222add-dc3f-56e6-a868-cbf42f8f14d0" :answer/type :answer.type/math :answer/value "6x-\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49150/selection/87a2e315759d5e1922bae31a10d286f11cf61a3a274fac4044a807052a906f72" :answer/id #uuid "e44f1a76-4097-5046-80e1-47615369721c" :answer/type :answer.type/math :answer/value "8x+\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49150/selection" :answer-field/id #uuid "29bcd2d3-a8ff-5a75-b4c4-5b21d9f2982c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49150/selection/543fc1757353fd6fe42bc2ffbe5071639fa514f4581708a0ae9c1ffa85f6c003" :answer-field/choices ["q-49150/selection/5b208a75abd57447974e8aef5944a3b7ef00c34340e913db66bcb5c6caf9f44d" "q-49150/selection/543fc1757353fd6fe42bc2ffbe5071639fa514f4581708a0ae9c1ffa85f6c003" "q-49150/selection/d3a913dec7ee1f8fa95c68114ce8caaf798a5ee932ae3681d7bfcc8894cb1f33" "q-49150/selection/c03a51da8210daa5345b630c967f22edf6af640e564b90be6b643c6189a0cf62" "q-49150/selection/87a2e315759d5e1922bae31a10d286f11cf61a3a274fac4044a807052a906f72"] :db/ensure [:answer-field/validate]} {:db/id "q-49150" :question/id #uuid "f5e46f0c-2f7a-5a5a-b5e7-c87523ec7296" :question/math-academy-id "q-49150" :question/problem "$\\int \\frac{{x}^{2}-7}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression: \n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{{x}^{2}-7}{{x}^{2}+1} & =\\frac{{x}^{2}+1-1-7}{{x}^{2}+1} \\\\  & =\\frac{({x}^{2}+1)-8}{{x}^{2}+1} \\\\  & =\\frac{\\cancel{{x}^{2}+1}}{\\cancel{{x}^{2}+1}}-\\frac{8}{{x}^{2}+1} \\\\  & =1-\\frac{8}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (1-\\frac{8}{{x}^{2}+1})\\text{d}x \\\\  & =\\int \\text{d}x-\\int \\frac{8}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int \\text{d}x-8\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =x-8\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49150/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5"] :knowledge-point/questions ["q-49150"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71768/selection/fb80114514fee349d75968ee04e079e522f0f2e8ed1ae1818ccb12e59c89dbb7" :answer/id #uuid "5c3ae89d-6478-5d1c-8bf7-436df916805b" :answer/type :answer.type/math :answer/value "5{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-71768/selection/08e6a6c195c8972d68ff7e4706f8c5c58d51b57e09c2bcb9f301ace88e87bb26" :answer/id #uuid "9ea7f19d-ae1a-5554-894b-78a3d4aaaf0d" :answer/type :answer.type/math :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-71768/selection/2dbe70d18a3ba7a6de9e66935e9d8cf756782d8986670a5edb4fdf4b6f49b665" :answer/id #uuid "9a8cbc9f-7247-546d-acc0-0de1fe1ce461" :answer/type :answer.type/math :answer/value "{x}^{5}+7\\text{ arccot }x+C" :db/ensure [:answer/validate]} {:db/id "q-71768/selection/26cd9ecb4bffa38b01eb8a052a01ea0f5fa9350458ad74b94f35e664200e6f6a" :answer/id #uuid "6ec0bd8e-0378-50d7-8bf5-c3c188025b41" :answer/type :answer.type/math :answer/value "5{x}^{5}+7\\operatorname{arcsin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-71768/selection/42b0cad49880aa6be57a7cdc955bf441483f5930ee889f52d03c19a3666ab7db" :answer/id #uuid "3275e8c2-e9cc-59e4-85bd-dab4a393a9f2" :answer/type :answer.type/math :answer/value "{x}^{5}+7\\text{ arcsec }x+C" :db/ensure [:answer/validate]} {:db/id "q-71768/selection" :answer-field/id #uuid "4325ebf5-51aa-5a41-8b97-1f780f13d38c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71768/selection/08e6a6c195c8972d68ff7e4706f8c5c58d51b57e09c2bcb9f301ace88e87bb26" :answer-field/choices ["q-71768/selection/fb80114514fee349d75968ee04e079e522f0f2e8ed1ae1818ccb12e59c89dbb7" "q-71768/selection/08e6a6c195c8972d68ff7e4706f8c5c58d51b57e09c2bcb9f301ace88e87bb26" "q-71768/selection/2dbe70d18a3ba7a6de9e66935e9d8cf756782d8986670a5edb4fdf4b6f49b665" "q-71768/selection/26cd9ecb4bffa38b01eb8a052a01ea0f5fa9350458ad74b94f35e664200e6f6a" "q-71768/selection/42b0cad49880aa6be57a7cdc955bf441483f5930ee889f52d03c19a3666ab7db"] :db/ensure [:answer-field/validate]} {:db/id "q-71768" :question/id #uuid "2206a1f7-bc8c-511a-9d02-48df5081fe5d" :question/math-academy-id "q-71768" :question/problem "If ${f}^{′}(x)=5{x}^{4}+\\frac{7}{1+{x}^{2}},$ then $f(x)=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (5{x}^{4}+\\frac{7}{1+{x}^{2}})\\text{d}x \\\\  & =\\int 5{x}^{4}\\,\\text{d}x+\\int \\frac{7}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\int {x}^{4}\\,\\text{d}x+7\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\cdot \\frac{{x}^{5}}{5}+7\\operatorname{arctan}⁡x+C \\\\  & ={x}^{5}+7\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71768/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311"] :knowledge-point/questions ["q-71768"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114164/selection/dbe9c326b4ffd868b9b3f73c9755a4543450345d3781f2981d9e4a91f685772e" :answer/id #uuid "be3d0155-6a63-587c-a0dd-d2a80aa4f983" :answer/type :answer.type/math :answer/value "{x}^{3}+7\\text{ arcsec }x+C" :db/ensure [:answer/validate]} {:db/id "q-114164/selection/7583c1316a7bbb6f8ee6692c813d363515496541ecea1f0568862231149f704e" :answer/id #uuid "4c21e6c1-f899-5fb2-9843-93ff4f3623fe" :answer/type :answer.type/math :answer/value "{x}^{3}+7\\text{ arcsin }x+C" :db/ensure [:answer/validate]} {:db/id "q-114164/selection/3688acd3ce8d40a06436d6ef75fbff1dd42601385cf3318d28a1328da3e44334" :answer/id #uuid "cb887394-1d08-502c-9da9-20e28ab459cf" :answer/type :answer.type/math :answer/value "7{x}^{3}\\text{ arcsec }x+C" :d