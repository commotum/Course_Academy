#{[{:db/id #edb/ref 17592186289861 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abb12a03-ea2d-5c50-8913-2c9b0a948559" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}-7\\text{ arctan }x+C" :db/id #edb/ref 17592186289863} {:answer/id #uuid "cb887394-1d08-502c-9da9-20e28ab459cf" :answer/type {:db/ident :answer.type/math} :answer/value "7{x}^{3}\\text{ arcsec }x+C" :db/id #edb/ref 17592186289864} {:answer/id #uuid "0c3cdcd2-7beb-58a8-9a6c-a8e28efbeb29" :answer/type {:db/ident :answer.type/math} :answer/value "7{x}^{3}\\text{ arcsin }x+C" :db/id #edb/ref 17592186289865} {:answer/id #uuid "4c21e6c1-f899-5fb2-9843-93ff4f3623fe" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}+7\\text{ arcsin }x+C" :db/id #edb/ref 17592186289866} {:answer/id #uuid "be3d0155-6a63-587c-a0dd-d2a80aa4f983" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}+7\\text{ arcsec }x+C" :db/id #edb/ref 17592186289867}] :answer-field/correct {:answer/id #uuid "be3d0155-6a63-587c-a0dd-d2a80aa4f983" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}+7\\text{ arcsec }x+C" :db/id #edb/ref 17592186289867} :answer-field/id #uuid "6cf7d7c9-27e7-56fc-893d-0d753eedf468" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289862}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d062b60a-ff5c-5e61-88e3-206eea124ea3" :question/math-academy-id "q-114164" :question/problem "$\\int (3{x}^{2}+\\frac{7}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int (3{x}^{2}+\\frac{7}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x & =\\int 3{x}^{2}\\,\\text{d}x+\\int \\frac{7}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =3\\int {x}^{2}\\,\\text{d}x+7\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =3(\\frac{{x}^{3}}{3})+7(\\text{ arcsec }x)+C \\\\  & ={x}^{3}+7\\text{ arcsec }x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064562 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c41fe8f7-7b09-5137-bf6d-f32f7c950916" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289869} {:answer/id #uuid "afad22e3-1ab2-524a-9338-76541ef7622b" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186289870} {:answer/id #uuid "94693edf-5d4b-52fd-8f27-3a61c119f114" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\text{arccsc}\\,x+C" :db/id #edb/ref 17592186289871} {:answer/id #uuid "6fd54695-649d-52d6-b982-7e4483f6a9f9" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\text{arccot}\\,x+C" :db/id #edb/ref 17592186289872} {:answer/id #uuid "fda0950d-2333-5073-bb7f-8359a629f388" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\text{arcsec}\\,x+C" :db/id #edb/ref 17592186289873}] :answer-field/correct {:answer/id #uuid "c41fe8f7-7b09-5137-bf6d-f32f7c950916" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289869} :answer-field/id #uuid "4fa41951-2f21-5a21-9f47-76a982a4d80d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289868}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2ae58f45-f27a-546f-bea3-1dad22e6710d" :question/math-academy-id "q-2498" :question/problem "$\\int \\frac{4}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{{x}^{2}+1}\\,\\text{d}x & =4\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =4\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289874 :knowledge-point/_questions [{:knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36d1d6bd-52b8-55d8-b03e-603c62e4dd70" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arcsec }x-3\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186289876} {:answer/id #uuid "a36bc411-16a6-559b-b68f-392981353186" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sec}⁡x-3\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186289877} {:answer/id #uuid "41d08bf7-3d83-54d6-bb7a-caaaadce57b7" :answer/type {:db/ident :answer.type/math} :answer/value "6\\text{ arcsec }x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186289878} {:answer/id #uuid "cad086a5-ec67-5a9e-86c1-def8999bece3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arcsec }x-3\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186289879} {:answer/id #uuid "4c30a391-1d57-5df2-a726-453dfa5f969e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcsin}⁡x+3\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186289880}] :answer-field/correct {:answer/id #uuid "cad086a5-ec67-5a9e-86c1-def8999bece3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\text{ arcsec }x-3\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186289879} :answer-field/id #uuid "0d6bb721-2892-5339-bbf4-d67f54c4260d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289875}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e4f450e8-9d22-55aa-b4a5-0bc363b5f1d9" :question/math-academy-id "q-49136" :question/problem "If ${f}^{′}(x)=\\frac{2}{|x|\\sqrt{{x}^{2}-1}}-3\\operatorname{cos}⁡x,$ then $f(x)=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (\\frac{2}{|x|\\sqrt{{x}^{2}-1}}-3\\operatorname{cos}⁡x)\\text{d}x \\\\  & =\\int \\frac{2}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x-\\int 3\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x-3\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2\\text{ arcsec }x-3\\operatorname{sin}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289881 :knowledge-point/_questions [{:knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc39e3d1-42b1-5be2-827e-72eeae20c794" :answer/type {:db/ident :answer.type/math} :answer/value "x-8\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289883} {:answer/id #uuid "80c706bd-67a0-5c85-9210-3852ebc5350e" :answer/type {:db/ident :answer.type/math} :answer/value "x+6\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289884} {:answer/id #uuid "e44f1a76-4097-5046-80e1-47615369721c" :answer/type {:db/ident :answer.type/math} :answer/value "8x+\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289885} {:answer/id #uuid "5b222add-dc3f-56e6-a868-cbf42f8f14d0" :answer/type {:db/ident :answer.type/math} :answer/value "6x-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289886} {:answer/id #uuid "27872e7d-76fd-5be2-860c-67d277d21e7b" :answer/type {:db/ident :answer.type/math} :answer/value "x-6\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289887}] :answer-field/correct {:answer/id #uuid "cc39e3d1-42b1-5be2-827e-72eeae20c794" :answer/type {:db/ident :answer.type/math} :answer/value "x-8\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289883} :answer-field/id #uuid "29bcd2d3-a8ff-5a75-b4c4-5b21d9f2982c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289882}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f5e46f0c-2f7a-5a5a-b5e7-c87523ec7296" :question/math-academy-id "q-49150" :question/problem "$\\int \\frac{{x}^{2}-7}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression: \n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{{x}^{2}-7}{{x}^{2}+1} & =\\frac{{x}^{2}+1-1-7}{{x}^{2}+1} \\\\  & =\\frac{({x}^{2}+1)-8}{{x}^{2}+1} \\\\  & =\\frac{\\cancel{{x}^{2}+1}}{\\cancel{{x}^{2}+1}}-\\frac{8}{{x}^{2}+1} \\\\  & =1-\\frac{8}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (1-\\frac{8}{{x}^{2}+1})\\text{d}x \\\\  & =\\int \\text{d}x-\\int \\frac{8}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\int \\text{d}x-8\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =x-8\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186289888 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ea7f19d-ae1a-5554-894b-78a3d4aaaf0d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289890} {:answer/id #uuid "6ec0bd8e-0378-50d7-8bf5-c3c188025b41" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{5}+7\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186289891} {:answer/id #uuid "9a8cbc9f-7247-546d-acc0-0de1fe1ce461" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}+7\\text{ arccot }x+C" :db/id #edb/ref 17592186289892} {:answer/id #uuid "3275e8c2-e9cc-59e4-85bd-dab4a393a9f2" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}+7\\text{ arcsec }x+C" :db/id #edb/ref 17592186289893} {:answer/id #uuid "5c3ae89d-6478-5d1c-8bf7-436df916805b" :answer/type {:db/ident :answer.type/math} :answer/value "5{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289894}] :answer-field/correct {:answer/id #uuid "9ea7f19d-ae1a-5554-894b-78a3d4aaaf0d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186289890} :answer-field/id #uuid "4325ebf5-51aa-5a41-8b97-1f780f13d38c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289889}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2206a1f7-bc8c-511a-9d02-48df5081fe5d" :question/math-academy-id "q-71768" :question/problem "If ${f}^{′}(x)=5{x}^{4}+\\frac{7}{1+{x}^{2}},$ then $f(x)=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (5{x}^{4}+\\frac{7}{1+{x}^{2}})\\text{d}x \\\\  & =\\int 5{x}^{4}\\,\\text{d}x+\\int \\frac{7}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\int {x}^{4}\\,\\text{d}x+7\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\cdot \\frac{{x}^{5}}{5}+7\\operatorname{arctan}⁡x+C \\\\  & ={x}^{5}+7\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}]}
