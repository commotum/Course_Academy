#{[{:db/id #edb/ref 17592186275565 :knowledge-point/_questions [{:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4ed4b1f-a53a-5acd-8fe0-d61e55fc1483" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275567} {:answer/id #uuid "f50cce15-e4da-54ab-ac52-8ba0f3445d8e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275568} {:answer/id #uuid "ef3c0543-d58c-5f2b-b4bc-7944aac8322b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275569} {:answer/id #uuid "5eb3f3ee-d386-5270-bc60-3279ac537607" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275570} {:answer/id #uuid "84a55685-5435-50c0-8d31-7d0052446f98" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275571}] :answer-field/correct {:answer/id #uuid "84a55685-5435-50c0-8d31-7d0052446f98" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275571} :answer-field/id #uuid "d8c3443f-9724-5852-86a4-5aef6f6d6c0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275566}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fa1b8678-04a2-558c-8809-1cf0a3ac222d" :question/math-academy-id "q-102760" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}-\\frac{3}{2} \\\\ 1\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & -\\frac{3}{2} \\\\ -2 & 1\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & -\\frac{3}{2} \\\\ -2 & 1\\end{aligned}| \\\\  & =3\\cdot 1-(-\\frac{3}{2})\\cdot (-2) \\\\  & =3-3 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}] [{:db/id #edb/ref 17592186275572 :knowledge-point/_questions [{:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae0aaea5-c31d-5f77-bb8d-6b0cba046369" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186275574} {:answer/id #uuid "7ee11a6f-2849-5ff5-bc64-5b0de11cb7d6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275575} {:answer/id #uuid "52bd4c68-2fb1-59e4-b4d0-7d59218834d7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186275576} {:answer/id #uuid "64cae68d-5c7b-50a7-8117-5f5136bce44f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275577} {:answer/id #uuid "6bedde70-f617-56ea-a9e6-fdbeafadb617" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275578}] :answer-field/correct {:answer/id #uuid "6bedde70-f617-56ea-a9e6-fdbeafadb617" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275578} :answer-field/id #uuid "a1655cde-1907-52a4-a8da-e26ee1e3b4d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275573}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9669e911-30f7-5f87-8c37-8c4abaf97865" :question/math-academy-id "q-13939" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972686/assets/555cdb44522fab12ad67b54042ee4e47a085802df65c2b32a512eace16b92dd4.png)\n\nCalculate the area of the parallelogram in the figure." :question/worked-solution "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨1,2⟩,\\,\\text{v}=⟨2,-1⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}| \\\\  & =1\\cdot (-1)-2\\cdot 2 \\\\  & =-5\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-5\\,|=5\n$$"}] [{:db/id #edb/ref 17592186275579 :knowledge-point/_questions [{:knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfe5f91-ee8a-5252-8be6-2a9828a470cf" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186275581} {:answer/id #uuid "a7f3f431-4a20-536f-9053-222bd1fc38a2" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186275582}] :answer-field/correct {:answer/id #uuid "a7f3f431-4a20-536f-9053-222bd1fc38a2" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186275582} :answer-field/id #uuid "e8b93417-6775-5f38-8566-f0306993f132" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275580}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "168c0e01-fa73-5720-9d05-467e30424e24" :question/math-academy-id "q-320394" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13972686/assets/f63cf622acc15681e3815118bbd2a187ea6039a548d4be1773634c0dc450c343.png)\n\nDetermine the area $A$ of the parallelogram in the figure.\n\n$\\,\\,A=$ {{field-1}}" :question/worked-solution "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨4,-1⟩,\\,\\text{v}=⟨-2,-3⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}4 & -2 \\\\ -1 & -3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}4 & -2 \\\\ -1 & -3\\end{aligned}| \\\\  & =4\\cdot (-3)-(-2)\\cdot (-1) \\\\  & =-12-2 \\\\  & =-14\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-14|=14\n$$"}] [{:db/id #edb/ref 17592186275583 :knowledge-point/_questions [{:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc11e97c-2e89-5dd7-89a6-1988b866f302" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{5}" :db/id #edb/ref 17592186275585}] :answer-field/correct {:answer/id #uuid "fc11e97c-2e89-5dd7-89a6-1988b866f302" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{5}" :db/id #edb/ref 17592186275585} :answer-field/id #uuid "8683ae6b-229d-55ef-a297-19782ce2469c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275584}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ac022c96-1345-5794-bcb4-16b0c470bf27" :question/math-academy-id "q-320550" :question/problem "Given that the area spanned between the vectors $\\text{u}=⟨\\frac{3}{2},-5⟩$ and $\\text{v}=⟨a,6⟩$ equals zero, what is the value of $a?$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}\\frac{3}{2} & a \\\\ -5 & 6\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}\\frac{3}{2} & a \\\\ -5 & 6\\end{aligned}| \\\\  & =\\frac{3}{2}\\cdot 6-a\\cdot (-5) \\\\  & =9+5a\\end{aligned}\n$$\n\nFinally, setting the expression for the determinant equal to $0$ and solving for $a,$ we get\n\n$$\n\\begin{aligned}9+5a & =0 \\\\ 5a & =-9 \\\\ a & =-\\frac{9}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275586 :knowledge-point/_questions [{:knowledge-point/id #uuid "0272b8d6-8400-5a6d-b51d-fc6ca84bd166" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b57c5137-0694-57ed-966f-9cf01baa8e4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}+3" :db/id #edb/ref 17592186275588} {:answer/id #uuid "5bd7d3e5-de3a-5efe-8ba7-85f0bdfba122" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186275589} {:answer/id #uuid "73784f3f-8dbb-58b2-a8a4-6235e9e92c8d" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{5}" :db/id #edb/ref 17592186275590} {:answer/id #uuid "288363b5-106c-5fe1-bbe8-0be9f42e2925" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275591} {:answer/id #uuid "91624d7e-1595-5a2b-b442-393f32892c63" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186275592}] :answer-field/correct {:answer/id #uuid "288363b5-106c-5fe1-bbe8-0be9f42e2925" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275591} :answer-field/id #uuid "fbd12062-2714-502b-83ae-f29acbb4bbb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275587}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f0fcdf56-3d2c-5171-908b-d37d58939a01" :question/math-academy-id "q-69941" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}3 \\\\ 0\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}\\frac{\\sqrt{5}}{3} \\\\ 0\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & \\frac{\\sqrt{5}}{3} \\\\ 0 & 0\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & \\frac{\\sqrt{5}}{3} \\\\ 0 & 0\\end{aligned}| \\\\  & =3\\cdot 0-\\frac{\\sqrt{5}}{3}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,0\\,|=0\n$$"}]}
