#{[{:db/id #edb/ref 17592186276032 :knowledge-point/_questions [{:knowledge-point/id #uuid "2169053d-78fc-5714-82f4-d89fc36ff695" :knowledge-point/title "Finding the Value of an Observation, Standard Deviation, or Mean Given a Z-Score"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f7fd78c-573c-598c-9c82-1cc1ef62a9b3" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276034} {:answer/id #uuid "acf6bbe6-fd3a-545c-9d0f-eedb2a4533ba" :answer/type {:db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186276035} {:answer/id #uuid "34740987-e455-566e-aee5-6ba5b94904a7" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276036} {:answer/id #uuid "3577b720-ee3e-57ae-965f-a94b84746281" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276037} {:answer/id #uuid "1e3caeac-1f9c-5e17-b4c5-e3b27249a9c3" :answer/type {:db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186276038}] :answer-field/correct {:answer/id #uuid "34740987-e455-566e-aee5-6ba5b94904a7" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276036} :answer-field/id #uuid "f88adaa1-07a4-5ba2-8ffb-c8fcb709f11e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276033}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0b0aebfb-96ae-5fa3-a940-5c462fb218ba" :question/math-academy-id "q-170510" :question/problem "A data set has a mean $\\overset{¯}{x}=-100$ and an unknown standard deviation. An observation of the data set has the value $x=-83$ and $z$-score $z=1.7.$ Find the standard deviation of the data set." :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma \n$$\n\nSubstituting $x=-83,$ $\\overset{¯}{x}=-100,$ and $z=1.7$ into the formula and solving for $\\sigma ,$ we get\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\ -83 & =-100+1.7\\cdot \\sigma  \\\\ 17 & =1.7\\cdot \\sigma  \\\\ \\sigma  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276039 :knowledge-point/_questions [{:knowledge-point/id #uuid "2169053d-78fc-5714-82f4-d89fc36ff695" :knowledge-point/title "Finding the Value of an Observation, Standard Deviation, or Mean Given a Z-Score"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1e67dc1-2aa3-58fd-a44e-a79a9b06ad2a" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186276041}] :answer-field/correct {:answer/id #uuid "e1e67dc1-2aa3-58fd-a44e-a79a9b06ad2a" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186276041} :answer-field/id #uuid "6b95bb85-1b21-507b-a856-5875aab59ba6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276040}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2bb17eba-f9de-5bc3-a770-a3aaaef8ce60" :question/math-academy-id "q-332054" :question/problem "A data set has a mean $\\overset{―}{x}=-2$ and an unknown standard deviation. An observation of the data set has the value $x=-1$ and $z$-score $z=1.25.$ Find the standard deviation of the data set.\n\n$\\sigma =$\n{{field-1}}" :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma \n$$\n\nSubstituting $x=-1,$ $\\overset{―}{x}=-2,$ and $z=1.25$ into the formula and solving for $\\sigma ,$ we get\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\ -1 & =-2+1.25\\cdot \\sigma  \\\\ 1 & =1.25\\cdot \\sigma  \\\\ \\sigma  & =0.8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276042 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7e9daa2-4aaa-5c33-b611-231f3d0e4782" :knowledge-point/title "Z-Score: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "913cac21-9210-58fe-8219-1c19248d7309" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186276044}] :answer-field/correct {:answer/id #uuid "913cac21-9210-58fe-8219-1c19248d7309" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186276044} :answer-field/id #uuid "25f07400-997b-507a-892c-ee9aabd9e516" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186276043}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f03f2caf-4780-58ac-bbd3-6959554865f5" :question/math-academy-id "q-332274" :question/problem "In a certain video game, the mean score of all players is $\\overset{¯}{x}=10$ points with a standard deviation of $1.5$ points. A particular player's $z$-score is $z=2.$ Find this player's score $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma \n$$\n\nSubstituting $\\overset{―}{x}=10,$ $z=2,$ and $\\sigma =1.5$ into the formula, we get\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\ x & =10+2\\cdot 1.5 \\\\ x & =10+3 \\\\ x & =13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276045 :knowledge-point/_questions [{:knowledge-point/id #uuid "01100ea8-2ab9-511e-8321-6ef5588c4417" :knowledge-point/title "Solving a System of Equations to Compute an Unknown Mean or Standard Deviation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d434e76f-fb36-51e5-9c03-41b91429ca7e" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276047} {:answer/id #uuid "ac5c3b1a-ab82-5b0c-8efb-be83d3bd6c69" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186276048} {:answer/id #uuid "e1052c4d-3677-5722-9814-e1ad45329494" :answer/type {:db/ident :answer.type/math} :answer/value "12.4" :db/id #edb/ref 17592186276049} {:answer/id #uuid "5af3d026-1fd3-5ab3-a633-2c4e6c2c8d61" :answer/type {:db/ident :answer.type/math} :answer/value "10.1" :db/id #edb/ref 17592186276050} {:answer/id #uuid "b44d636f-6eee-5aff-bba0-a67ddb3254fe" :answer/type {:db/ident :answer.type/math} :answer/value "13.6" :db/id #edb/ref 17592186276051}] :answer-field/correct {:answer/id #uuid "b44d636f-6eee-5aff-bba0-a67ddb3254fe" :answer/type {:db/ident :answer.type/math} :answer/value "13.6" :db/id #edb/ref 17592186276051} :answer-field/id #uuid "7df18726-9908-507a-8db9-bc61ffbe6ec8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276046}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8be05c94-5951-5b90-8baf-ed834c5848b0" :question/math-academy-id "q-94478" :question/problem "A data set contains the observations ${x}_{1}=28,{x}_{2}=18$ with $z$-scores ${z}_{1}=3.6$ and ${z}_{2}=1.1,$ respectively. Find the mean of the data set." :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma \n$$\n\nFrom the first observation, we have\n\n$$\n\\begin{aligned}28 & =\\overset{¯}{x}+3.6\\cdot \\sigma .\\end{aligned}\n$$\n\nFrom the second observation, we have\n\n$$\n\\begin{aligned}18 & =\\overset{¯}{x}+1.1\\cdot \\sigma .\\end{aligned}\n$$\n\nSubtracting the second equation from the first and solving for $\\sigma ,$ we get\n\n$$\n\\begin{aligned}(28-18) & =(3.6-1.1)\\cdot \\sigma  \\\\ 10 & =2.5\\cdot \\sigma  \\\\ \\sigma  & =4.\\end{aligned}\n$$\n\nFinally, substituting this value back into our first equation and solving for $\\overset{¯}{x},$ we get\n\n$$\n\\begin{aligned}28 & =\\overset{¯}{x}+3.6\\cdot \\sigma  \\\\ 28 & =\\overset{¯}{x}+3.6\\cdot 4 \\\\ \\overset{¯}{x} & =13.6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186276052 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7e9daa2-4aaa-5c33-b611-231f3d0e4782" :knowledge-point/title "Z-Score: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ed3e481-33de-59bc-a03d-b76fe5e2ec15" :answer/type {:db/ident :answer.type/math} :answer/value "63.3%" :db/id #edb/ref 17592186276054} {:answer/id #uuid "d2be4df1-bbad-5e93-b4ac-fffa531a6050" :answer/type {:db/ident :answer.type/math} :answer/value "65.3%" :db/id #edb/ref 17592186276055} {:answer/id #uuid "5d431f82-a5d7-5255-8fb8-82f29f7f9209" :answer/type {:db/ident :answer.type/math} :answer/value "57.55%" :db/id #edb/ref 17592186276056} {:answer/id #uuid "8385f283-6dfc-5203-8121-e2cbddff8433" :answer/type {:db/ident :answer.type/math} :answer/value "59.05%" :db/id #edb/ref 17592186276057} {:answer/id #uuid "c32a66b0-c3d8-5e44-ac5f-5f06a6664fa9" :answer/type {:db/ident :answer.type/math} :answer/value "61.3%" :db/id #edb/ref 17592186276058}] :answer-field/correct {:answer/id #uuid "8385f283-6dfc-5203-8121-e2cbddff8433" :answer/type {:db/ident :answer.type/math} :answer/value "59.05%" :db/id #edb/ref 17592186276057} :answer-field/id #uuid "802e0282-1010-50e4-a344-1e20ba608e4e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186276053}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "41c925bc-0614-5ca6-906e-e2e70499ea14" :question/math-academy-id "q-9846" :question/problem "In a trigonometry test, the class instructor decided that students whose $z$-score is greater than or equal to $-1$ will pass the test. The mean percent score $x$ of the students of the class is $\\overset{¯}{x}=64.3%$ with a standard deviation of $\\sigma =5.25%.$ Find the minimum passing score." :question/worked-solution "To compute the value of an observation $x$ which yields a given $z$-score in a data set with mean $\\overset{―}{x}$ and standard deviation $\\sigma ,$ we can use the following formula:\n\n$$\nx=\\overset{―}{x}+z\\cdot \\sigma \n$$\n\nSubstituting $\\overset{―}{x}=64.3,$ $z=-1,$ and $\\sigma =5.25$ into the formula, we get\n\n$$\n\\begin{aligned}x & =\\overset{―}{x}+z\\cdot \\sigma  \\\\  & =64.3+(-1)\\cdot 5.25 \\\\  & =64.3-5.25 \\\\  & =59.05.\\end{aligned}\n$$\n\n \n\nTherefore, the minimum passing score is $59.05%.$"}]}
