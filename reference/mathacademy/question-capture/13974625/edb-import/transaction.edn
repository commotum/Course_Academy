903952ab7a1aa6a6a87392036510631fb67237e61586043dc0a496a15b1a4"] :db/ensure [:answer-field/validate]} {:db/id "q-141366" :question/id #uuid "cd5fa4dd-1d69-54b4-a0ce-dfa532d994db" :question/math-academy-id "q-141366" :question/problem "$\\operatorname{cos}⁡(x+{90}^{∘})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={90}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{90}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{90}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{90}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot 0-\\operatorname{sin}⁡x\\cdot 1 \\\\  & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141366/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7"] :knowledge-point/questions ["q-141366"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141374/selection/d6187f76c7170bbd222b52fb66f1715de193943502ea03b462b3dca00220a152" :answer/id #uuid "639a72c0-8aa7-5b34-865c-59d3a425abcf" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141374/selection/27caf57cffa9ecbe0f8f3fc4a54af7fc14996112136bc8a5ee67f1b6c263cdac" :answer/id #uuid "fad5a525-942a-5b4a-a486-126cb9218488" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141374/selection/f0c2bd5d925ee1ef1b7ee0eb315286445d2b385b93bddea08ad1fcbcfc7ebc22" :answer/id #uuid "0363bca1-f68b-5362-ae48-00ee0354bf59" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/ensure [:answer/validate]} {:db/id "q-141374/selection/c843592faadf2d42b42dd58ccc28f8a0ffce9bf51591b76fed91e91714507a58" :answer/id #uuid "d22b5975-d9ab-5fbb-afde-cdaa6c0613e5" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141374/selection/e55d1b1a54d6da6af22b6cd5985f2c34a2a23d72a077ac60f4f706c2621e260c" :answer/id #uuid "55c8ffcf-25b1-56a6-a295-ab5f832835cc" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/ensure [:answer/validate]} {:db/id "q-141374/selection" :answer-field/id #uuid "dc8e379e-7b6e-535e-adee-b1cb0ccca27d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-141374/selection/c843592faadf2d42b42dd58ccc28f8a0ffce9bf51591b76fed91e91714507a58" :answer-field/choices ["q-141374/selection/d6187f76c7170bbd222b52fb66f1715de193943502ea03b462b3dca00220a152" "q-141374/selection/27caf57cffa9ecbe0f8f3fc4a54af7fc14996112136bc8a5ee67f1b6c263cdac" "q-141374/selection/f0c2bd5d925ee1ef1b7ee0eb315286445d2b385b93bddea08ad1fcbcfc7ebc22" "q-141374/selection/c843592faadf2d42b42dd58ccc28f8a0ffce9bf51591b76fed91e91714507a58" "q-141374/selection/e55d1b1a54d6da6af22b6cd5985f2c34a2a23d72a077ac60f4f706c2621e260c"] :db/ensure [:answer-field/validate]} {:db/id "q-141374" :question/id #uuid "d2b05c8a-ff15-5f35-bdc7-60df8dc3e69b" :question/math-academy-id "q-141374" :question/problem "$\\operatorname{cos}⁡(x-{150}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={150}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{150}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{150}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}+\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-141374/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7"] :knowledge-point/questions ["q-141374"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274501/field-1/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046" :answer/id #uuid "287b289a-6319-5073-85aa-85386d9d2320" :answer/type :answer.type/math :answer/value "\\sin(x)" :db/ensure [:answer/validate]} {:db/id "q-274501/field-1" :answer-field/id #uuid "34ff8803-21b0-55b9-8452-1a4abb444717" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274501/field-1/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046" :answer-field/choices ["q-274501/field-1/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046"] :db/ensure [:answer-field/validate]} {:db/id "q-274501" :question/id #uuid "bb0ec836-0873-5da2-a94e-9a79ad4c164c" :question/math-academy-id "q-274501" :question/problem "Express $\\operatorname{cos}⁡(x-\\frac{\\pi }{2})$ in terms of $\\operatorname{sin}⁡x$ or $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-\\frac{\\pi }{2})=$\n{{field-1}}" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{\\pi }{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{\\pi }{2}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =\\operatorname{cos}⁡x\\cdot 0+\\operatorname{sin}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-274501/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64"] :knowledge-point/questions ["q-274501"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332512/field-1/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "ccaf8e9d-3808-50df-a35b-070fd7dbb2da" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332512/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4f8103d0-dd33-5f04-90dd-1cf7a0892480" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332512/field-1" :answer-field/id #uuid "6eb0f0ed-44bc-5df1-8004-aed84e9e195f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332512/field-1/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer-field/choices ["q-332512/field-1/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-332512/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332512/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "88de3ead-e20f-536c-be81-83c67877e2aa" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-332512/field-2" :answer-field/id #uuid "1f7c74f4-3050-5c8c-b265-5f67be670d02" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332512/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-332512/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-332512" :question/id #uuid "20959010-096a-5586-8377-f6ad342cbcf6" :question/math-academy-id "q-332512" :question/problem "Express $\\operatorname{cos}⁡(x-{60}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-{60}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{60}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{60}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}+\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332512/field-1" "q-332512/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7"] :knowledge-point/questions ["q-332512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332528/field-1/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" :answer/id #uuid "1498ce6b-cc11-57f3-b992-fd5eb4544a22" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332528/field-1" :answer-field/id #uuid "fd7171f8-3872-55db-b7e3-3fc209d10de0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332528/field-1/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec" :answer-field/choices ["q-332528/field-1/4bd87ad5cdff0b2d0aa7574d5c7450ac33fa34774f895ce16d251ca09a1932ec"] :db/ensure [:answer-field/validate]} {:db/id "q-332528/field-2/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "e17f9d60-f8ab-56f3-a87d-0dfc4e48c6eb" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-332528/field-2" :answer-field/id #uuid "33edf52e-e4c4-565c-87dc-cb3bd0ea551e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332528/field-2/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer-field/choices ["q-332528/field-2/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9"] :db/ensure [:answer-field/validate]} {:db/id "q-332528" :question/id #uuid "aefb8beb-a2da-5c5b-a0a9-be947a685799" :question/math-academy-id "q-332528" :question/problem "Express $\\operatorname{cos}⁡(x-\\frac{7\\pi }{4})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-\\frac{7\\pi }{4})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{7\\pi }{4}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{7\\pi }{4}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{7\\pi }{4})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{2}}{2}+\\operatorname{sin}⁡x\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{2}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-332528/field-1" "q-332528/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64"] :knowledge-point/questions ["q-332528"] :db/ensure [:knowledge-point/validate]}]
