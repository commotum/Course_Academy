#{[{:db/id #edb/ref 17592186275971 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "608ae595-97d2-5976-95e2-bc7dbc51afa6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186275973} {:answer/id #uuid "41a2f823-5854-5f62-b69e-754097daad62" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275974} {:answer/id #uuid "5715c09e-4ff4-5533-9bd6-8b429bf59e9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186275975} {:answer/id #uuid "97bf5c67-0076-5c6f-9cc5-802047d3d881" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186275976} {:answer/id #uuid "d2adbfd4-bd48-5cbe-b13b-022b86a49f1f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275977}] :answer-field/correct {:answer/id #uuid "d2adbfd4-bd48-5cbe-b13b-022b86a49f1f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186275977} :answer-field/id #uuid "945b8f67-5409-51d1-addb-67fff141c160" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275972}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cd5fa4dd-1d69-54b4-a0ce-dfa532d994db" :question/math-academy-id "q-141366" :question/problem "$\\operatorname{cos}⁡(x+{90}^{∘})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={90}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{90}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{90}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{90}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot 0-\\operatorname{sin}⁡x\\cdot 1 \\\\  & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275978 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fad5a525-942a-5b4a-a486-126cb9218488" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186275980} {:answer/id #uuid "d22b5975-d9ab-5fbb-afde-cdaa6c0613e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186275981} {:answer/id #uuid "639a72c0-8aa7-5b34-865c-59d3a425abcf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186275982} {:answer/id #uuid "55c8ffcf-25b1-56a6-a295-ab5f832835cc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186275983} {:answer/id #uuid "0363bca1-f68b-5362-ae48-00ee0354bf59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186275984}] :answer-field/correct {:answer/id #uuid "d22b5975-d9ab-5fbb-afde-cdaa6c0613e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186275981} :answer-field/id #uuid "dc8e379e-7b6e-535e-adee-b1cb0ccca27d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275979}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b05c8a-ff15-5f35-bdc7-60df8dc3e69b" :question/math-academy-id "q-141374" :question/problem "$\\operatorname{cos}⁡(x-{150}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={150}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{150}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{150}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}+\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275985 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "287b289a-6319-5073-85aa-85386d9d2320" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(x)" :db/id #edb/ref 17592186275987}] :answer-field/correct {:answer/id #uuid "287b289a-6319-5073-85aa-85386d9d2320" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin(x)" :db/id #edb/ref 17592186275987} :answer-field/id #uuid "34ff8803-21b0-55b9-8452-1a4abb444717" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275986}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bb0ec836-0873-5da2-a94e-9a79ad4c164c" :question/math-academy-id "q-274501" :question/problem "Express $\\operatorname{cos}⁡(x-\\frac{\\pi }{2})$ in terms of $\\operatorname{sin}⁡x$ or $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-\\frac{\\pi }{2})=$\n{{field-1}}" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{\\pi }{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{\\pi }{2}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =\\operatorname{cos}⁡x\\cdot 0+\\operatorname{sin}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275988 :knowledge-point/_questions [{:knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f8103d0-dd33-5f04-90dd-1cf7a0892480" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275990} {:answer/id #uuid "ccaf8e9d-3808-50df-a35b-070fd7dbb2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186275991}] :answer-field/correct {:answer/id #uuid "ccaf8e9d-3808-50df-a35b-070fd7dbb2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186275991} :answer-field/id #uuid "6eb0f0ed-44bc-5df1-8004-aed84e9e195f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275989} {:answer-field/choices [{:answer/id #uuid "88de3ead-e20f-536c-be81-83c67877e2aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275993}] :answer-field/correct {:answer/id #uuid "88de3ead-e20f-536c-be81-83c67877e2aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186275993} :answer-field/id #uuid "1f7c74f4-3050-5c8c-b265-5f67be670d02" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275992}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "20959010-096a-5586-8377-f6ad342cbcf6" :question/math-academy-id "q-332512" :question/problem "Express $\\operatorname{cos}⁡(x-{60}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-{60}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{60}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{60}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}+\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275994 :knowledge-point/_questions [{:knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1498ce6b-cc11-57f3-b992-fd5eb4544a22" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186275996}] :answer-field/correct {:answer/id #uuid "1498ce6b-cc11-5