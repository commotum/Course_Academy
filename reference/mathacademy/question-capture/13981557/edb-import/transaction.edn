[{:db/id "q-32662/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "c8a370b6-01ed-5fa3-b83e-674dd968e26d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-32662/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" :answer/id #uuid "c874e209-8207-5540-8a07-17f90611f186" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-32662/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "dd4fe3ec-ebd2-5f04-9129-0567f6010657" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-32662/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "60d6f4ac-a3c6-51d6-afd9-f6f899c779d5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-32662/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "cfe937ec-9637-5e8b-aaaa-003d1c7a7731" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-32662/selection" :answer-field/id #uuid "159ba4e3-9311-5f66-9c6e-effb351cb7cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32662/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-32662/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-32662/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" "q-32662/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-32662/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-32662/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-32662" :question/id #uuid "126e0124-fb57-5d08-b52d-08e4441b2ba9" :question/math-academy-id "q-32662" :question/problem "If $x=y\\sqrt{y}-\\frac{{y}^{2}}{2}+2y,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(8,4).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(y\\sqrt{y}-\\frac{{y}^{2}}{2}+2y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3/2}-\\frac{{y}^{2}}{2}+2y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3/2})-\\frac{1}{2}\\frac{\\text{d}}{\\text{d}y}({y}^{2})+2\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =\\frac{3}{2}{y}^{1/2}-\\frac{1}{2}\\cdot 2y+2 \\\\  & =\\frac{3}{2}\\sqrt{y}-y+2.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{\\frac{3}{2}\\sqrt{y}-y+2}.\n$$\n\nFinally, substituting the point $(8,4),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(8,4)} & =\\frac{1}{(\\frac{3}{2}\\sqrt{4}-4+2)}=1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32662/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0"] :knowledge-point/questions ["q-32662"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170189/selection/32c1b2ea8afb6800b3a43fdf0060bbfdd6cec974f8f0afdeaeeda8ba8f7d472d" :answer/id #uuid "b46f1128-b5ad-5281-abb2-2f4bab54ea89" :answer/type :answer.type/math :answer/value "y=-\\frac{x}{8}+\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-170189/selection/29b7fdff6cf1ed9ad5fbf2b8395372b93ef2f461e26d20e3e1b67cff9df3d460" :answer/id #uuid "cfd5b4bb-351a-5b34-9185-6aedb18e0c32" :answer/type :answer.type/math :answer/value "y=-10x+44" :db/ensure [:answer/validate]} {:db/id "q-170189/selection/8b90e280ec2a40cf8e3c79055a6da72fb8f1ec9e95b16e3801aa43d9d994d142" :answer/id #uuid "a1bc9e82-a8ad-5497-82ed-ab430cd066e4" :answer/type :answer.type/math :answer/value "y=-\\frac{x}{10}+\\frac{7}{5}" :db/ensure [:answer/validate]} {:db/id "q-170189/selection/8ac5da39f7a0972bacd1ff35ab4073d37c4a4641d65f093cce5d5121bafb2d1e" :answer/id #uuid "6393bec5-5ee8-5f8d-89df-f79a27ba3c16" :answer/type :answer.type/math :answer/value "y=-\\frac{x}{8}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-170189/selection/0a1610451c58fe58a7ce0b8c4947f67fef33bf55b49e0b83096dca6504247e44" :answer/id #uuid "0950ebef-5720-55dc-a211-3f42b18b9090" :answer/type :answer.type/math :answer/value "y=-\\frac{x}{8}+\\frac{33}{8}" :db/ensure [:answer/validate]} {:db/id "q-170189/selection" :answer-field/id #uuid "724479b8-4d64-5795-a747-dcbbaf87ff6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170189/selection/32c1b2ea8afb6800b3a43fdf0060bbfdd6cec974f8f0afdeaeeda8ba8f7d472d" :answer-field/choices ["q-170189/selection/32c1b2ea8afb6800b3a43fdf0060bbfdd6cec974f8f0afdeaeeda8ba8f7d472d" "q-170189/selection/29b7fdff6cf1ed9ad5fbf2b8395372b93ef2f461e26d20e3e1b67cff9df3d460" "q-170189/selection/8b90e280ec2a40cf8e3c79055a6da72fb8f1ec9e95b16e3801aa43d9d994d142" "q-170189/selection/8ac5da39f7a0972bacd1ff35ab4073d37c4a4641d65f093cce5d5121bafb2d1e" "q-170189/selection/0a1610451c58fe58a7ce0b8c4947f67fef33bf55b49e0b83096dca6504247e44"] :db/ensure [:answer-field/validate]} {:db/id "q-170189" :question/id #uuid "ff2a1a1b-7518-50cc-a471-db550a95b1a2" :question/math-academy-id "q-170189" :question/problem "Given a curve $x=y+\\frac{3}{{y}^{3}},$ what is the equation of the tangent to the curve at the point $(4,1)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(y+\\frac{3}{{y}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(y)+3\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{{y}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(y)+3\\frac{\\text{d}}{\\text{d}y}({y}^{-3}) \\\\  & =1+3\\cdot (-3{y}^{-4}) \\\\  & =1-9{y}^{-4} \\\\  & =1-\\frac{9}{{y}^{4}} \\\\  & =\\frac{{y}^{4}-9}{{y}^{4}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{4}}{{y}^{4}-9}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,1)} \\\\  & =\\frac{{1}^{4}}{{1}^{4}-9} \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{1}{8}(x-4) \\\\ y & =-\\frac{x}{8}+\\frac{1}{2}+1 \\\\ y & =-\\frac{x}{8}+\\frac{3}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-170189/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71"] :knowledge-point/questions ["q-170189"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170191/selection/4adec40b803cb20266276d47bfa4e61fd7e03879884f018cf0bb4d23012664cb" :answer/id #uuid "432bd697-a2c3-5462-843d-1c3e4976c443" :answer/type :answer.type/math :answer/value "y=-\\frac{3}{4}x+\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-170191/selection/2fde87453216a66191ef872c73864c6b74da41852f8cb3b227ac102b79317907" :answer/id #uuid "86422034-8832-53ac-9920-bc54ffe21652" :answer/type :answer.type/math :answer/value "y=-2x+4" :db/ensure [:answer/validate]} {:db/id "q-170191/selection/606dfe0f5040fb991509f36d5fafbd69998b40540ccec1b5e5c4b949658ed2a6" :answer/id #uuid "77d3080e-7530-58a5-a771-c0b0b778f512" :answer/type :answer.type/math :answer/value "y=-2x+5" :db/ensure [:answer/validate]} {:db/id "q-170191/selection/5bae2bd94132e44d4318526795c71e024d7e9f22869bfd3680dccbc2896345b1" :answer/id #uuid "c7c29b13-3677-5b98-8853-e13717c8c248" :answer/type :answer.type/math :answer/value "y=-2x+2" :db/ensure [:answer/validate]} {:db/id "q-170191/selection/e349e2608b45469d35ed97880245b98714c4163ddc0af0465fbfd30ad97f2985" :answer/id #uuid "ea19b9f2-1e70-5728-a1b5-debe5cc398b9" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}x+2" :db/ensure [:answer/validate]} {:db/id "q-170191/selection" :answer-field/id #uuid "1f97a50e-6654-560d-8d27-665656f083c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170191/selection/606dfe0f5040fb991509f36d5fafbd69998b40540ccec1b5e5c4b949658ed2a6" :answer-field/choices ["q-170191/selection/4adec40b803cb20266276d47bfa4e61fd7e03879884f018cf0bb4d23012664cb" "q-170191/selection/2fde87453216a66191ef872c73864c6b74da41852f8cb3b227ac102b79317907" "q-170191/selection/606dfe0f5040fb991509f36d5fafbd69998b40540ccec1b5e5c4b949658ed2a6" "q-170191/selection/5bae2bd94132e44d4318526795c71e024d7e9f22869bfd3680dccbc2896345b1" "q-170191/selection/e349e2608b45469d35ed97880245b98714c4163ddc0af0465fbfd30ad97f2985"] :db/ensure [:answer-field/validate]} {:db/id "q-170191" :question/id #uuid "b2afa7a1-e6dd-53cf-81b5-79d7bd4f9aec" :question/math-academy-id "q-170191" :question/problem "Given a curve $x=\\sqrt{{y}^{3}}+\\frac{1}{{y}^{2}},$ what is the equation of the tangent to the curve at the point $(2,1)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{{y}^{3}}+\\frac{1}{{y}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{{y}^{3}})+\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{{y}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3/2})+\\frac{\\text{d}}{\\text{d}y}({y}^{-2}) \\\\  & =\\frac{3}{2}{y}^{1/2}-2{y}^{-3} \\\\  & =\\frac{3{y}^{1/2}}{2}-\\frac{2}{{y}^{3}} \\\\  & =\\frac{3{y}^{7/2}-4}{2{y}^{3}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{2{y}^{3}}{3{y}^{7/2}-4}.\n$$\n\nThe slope of the tangent to the curve at the point $(2,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(2,1)} \\\\  & =\\frac{2(1)^{3}}{3(1)^{7/2}-4} \\\\  & =-2.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-2(x-2) \\\\ y & =-2x+4+1 \\\\ y & =-2x+5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-170191/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71"] :knowledge-point/questions ["q-170191"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341745/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "33c483fc-3b09-59d7-9da1-80912d0b30c1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-341745/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "5cccdd82-f3c3-5c82-b58e-9b5d0aa6f748" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-341745/field-1" :answer-field/id #uuid "7444f931-fe5f-5dc3-a88c-773264e771d2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341745/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-341745/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-341745/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-341745" :question/id #uuid "f192c8ec-f3c5-5496-afeb-ada7f32857a5" :question/math-academy-id "q-341745" :question/problem "If $x={y}^{4}-\\frac{3}{y},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(4,-1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{4}-\\frac{3}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =4{y}^{3}-3(-{y}^{-2}) \\\\  & =4{y}^{3}+3{y}^{-2} \\\\  & =4{y}^{3}+\\frac{3}{{y}^{2}} \\\\  & =\\frac{4{y}^{5}+3}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{4{y}^{5}+3}.\n$$\n\nFinally, substituting the point $(4,-1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)} & =\\frac{(-1)^{2}}{4(-1)^{5}+3}=-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341745/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0"] :knowledge-point/questions ["q-341745"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342061/field-1/54255218e3b730d626ae7f8897c30c5816e76ff5a205fd355745729966c8bb39" :answer/id #uuid "3852b66a-7064-59a8-a7b1-851eb54b1a47" :answer/type :answer.type/math :answer/value "-x+5" :db/ensure [:answer/validate]} {:db/id "q-342061/field-1" :answer-field/id #uuid "37dff734-38f7-53b0-8a36-e61e60c5e30e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342061/field-1/54255218e3b730d626ae7f8897c30c5816e76ff5a205fd355745729966c8bb39" :answer-field/choices ["q-342061/field-1/54255218e3b730d626ae7f8897c30c5816e76ff5a205fd355745729966c8bb39"] :db/ensure [:answer-field/validate]} {:db/id "q-342061" :question/id #uuid "b5a6f3b2-8851-548b-a826-4dcc5cd308eb" :question/math-academy-id "q-342061" :question/problem "Given a curve $x=6\\sqrt{y}-2{y}^{2},$ what is the equation of the tangent to the curve at the point $(4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(6\\sqrt{y}-2{y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y})-2\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}({y}^{1/2})-2(2y) \\\\  & =6\\cdot \\frac{1}{2}{y}^{-1/2}-4y \\\\  & =3{y}^{-1/2}-4y \\\\  & =\\frac{3}{\\sqrt{y}}-4y \\\\  & =\\frac{3-4y\\sqrt{y}}{\\sqrt{y}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{\\sqrt{y}}{3-4y\\sqrt{y}}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,1)} \\\\  & =\\frac{\\sqrt{1}}{3-4(1)\\sqrt{1}} \\\\  & =\\frac{1}{3-4} \\\\  & =-1.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-(x-4) \\\\ y & =-x+4+1 \\\\ y & =-x+5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-342061/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71"] :knowledge-point/questions ["q-342061"] :db/ensure [:knowledge-point/validate]}]
