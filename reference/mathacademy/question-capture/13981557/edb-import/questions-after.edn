#{[{:db/id #edb/ref 17592186282391 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0950ebef-5720-55dc-a211-3f42b18b9090" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{8}+\\frac{33}{8}" :db/id #edb/ref 17592186282393} {:answer/id #uuid "cfd5b4bb-351a-5b34-9185-6aedb18e0c32" :answer/type {:db/ident :answer.type/math} :answer/value "y=-10x+44" :db/id #edb/ref 17592186282394} {:answer/id #uuid "b46f1128-b5ad-5281-abb2-2f4bab54ea89" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{8}+\\frac{3}{2}" :db/id #edb/ref 17592186282395} {:answer/id #uuid "6393bec5-5ee8-5f8d-89df-f79a27ba3c16" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{8}-\\frac{1}{2}" :db/id #edb/ref 17592186282396} {:answer/id #uuid "a1bc9e82-a8ad-5497-82ed-ab430cd066e4" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{10}+\\frac{7}{5}" :db/id #edb/ref 17592186282397}] :answer-field/correct {:answer/id #uuid "b46f1128-b5ad-5281-abb2-2f4bab54ea89" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{x}{8}+\\frac{3}{2}" :db/id #edb/ref 17592186282395} :answer-field/id #uuid "724479b8-4d64-5795-a747-dcbbaf87ff6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282392}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ff2a1a1b-7518-50cc-a471-db550a95b1a2" :question/math-academy-id "q-170189" :question/problem "Given a curve $x=y+\\frac{3}{{y}^{3}},$ what is the equation of the tangent to the curve at the point $(4,1)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(y+\\frac{3}{{y}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(y)+3\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{{y}^{3}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(y)+3\\frac{\\text{d}}{\\text{d}y}({y}^{-3}) \\\\  & =1+3\\cdot (-3{y}^{-4}) \\\\  & =1-9{y}^{-4} \\\\  & =1-\\frac{9}{{y}^{4}} \\\\  & =\\frac{{y}^{4}-9}{{y}^{4}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{4}}{{y}^{4}-9}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,1)} \\\\  & =\\frac{{1}^{4}}{{1}^{4}-9} \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{1}{8}(x-4) \\\\ y & =-\\frac{x}{8}+\\frac{1}{2}+1 \\\\ y & =-\\frac{x}{8}+\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282398 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86422034-8832-53ac-9920-bc54ffe21652" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x+4" :db/id #edb/ref 17592186282400} {:answer/id #uuid "432bd697-a2c3-5462-843d-1c3e4976c443" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{3}{4}x+\\frac{5}{2}" :db/id #edb/ref 17592186282401} {:answer/id #uuid "c7c29b13-3677-5b98-8853-e13717c8c248" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x+2" :db/id #edb/ref 17592186282402} {:answer/id #uuid "77d3080e-7530-58a5-a771-c0b0b778f512" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x+5" :db/id #edb/ref 17592186282403} {:answer/id #uuid "ea19b9f2-1e70-5728-a1b5-debe5cc398b9" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+2" :db/id #edb/ref 17592186282404}] :answer-field/correct {:answer/id #uuid "77d3080e-7530-58a5-a771-c0b0b778f512" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2x+5" :db/id #edb/ref 17592186282403} :answer-field/id #uuid "1f97a50e-6654-560d-8d27-665656f083c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282399}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b2afa7a1-e6dd-53cf-81b5-79d7bd4f9aec" :question/math-academy-id "q-170191" :question/problem "Given a curve $x=\\sqrt{{y}^{3}}+\\frac{1}{{y}^{2}},$ what is the equation of the tangent to the curve at the point $(2,1)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{{y}^{3}}+\\frac{1}{{y}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{{y}^{3}})+\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{{y}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3/2})+\\frac{\\text{d}}{\\text{d}y}({y}^{-2}) \\\\  & =\\frac{3}{2}{y}^{1/2}-2{y}^{-3} \\\\  & =\\frac{3{y}^{1/2}}{2}-\\frac{2}{{y}^{3}} \\\\  & =\\frac{3{y}^{7/2}-4}{2{y}^{3}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{2{y}^{3}}{3{y}^{7/2}-4}.\n$$\n\nThe slope of the tangent to the curve at the point $(2,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(2,1)} \\\\  & =\\frac{2(1)^{3}}{3(1)^{7/2}-4} \\\\  & =-2.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-2(x-2) \\\\ y & =-2x+4+1 \\\\ y & =-2x+5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282405 :knowledge-point/_questions [{:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0" :knowledge-point/title "Calculating dy/dx at a Point Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c874e209-8207-5540-8a07-17f90611f186" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186282407} {:answer/id #uuid "c8a370b6-01ed-5fa3-b83e-674dd968e26d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186282408} {:answer/id #uuid "cfe937ec-9637-5e8b-aaaa-003d1c7a7731" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186282409} {:answer/id #uuid "dd4fe3ec-ebd2-5f04-9129-0567f6010657" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186282410} {:answer/id #uuid "60d6f4ac-a3c6-51d6-afd9-f6f899c779d5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282411}] :answer-field/correct {:answer/id #uuid "dd4fe3ec-ebd2-5f04-9129-0567f6010657" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186282410} :answer-field/id #uuid "159ba4e3-9311-5f66-9c6e-effb351cb7cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282406}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "126e0124-fb57-5d08-b52d-08e4441b2ba9" :question/math-academy-id "q-32662" :question/problem "If $x=y\\sqrt{y}-\\frac{{y}^{2}}{2}+2y,$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(8,4).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(y\\sqrt{y}-\\frac{{y}^{2}}{2}+2y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3/2}-\\frac{{y}^{2}}{2}+2y) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{3/2})-\\frac{1}{2}\\frac{\\text{d}}{\\text{d}y}({y}^{2})+2\\frac{\\text{d}}{\\text{d}y}(y) \\\\  & =\\frac{3}{2}{y}^{1/2}-\\frac{1}{2}\\cdot 2y+2 \\\\  & =\\frac{3}{2}\\sqrt{y}-y+2.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{\\frac{3}{2}\\sqrt{y}-y+2}.\n$$\n\nFinally, substituting the point $(8,4),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(8,4)} & =\\frac{1}{(\\frac{3}{2}\\sqrt{4}-4+2)}=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282412 :knowledge-point/_questions [{:knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0" :knowledge-point/title "Calculating dy/dx at a Point Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cccdd82-f3c3-5c82-b58e-9b5d0aa6f748" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186282414} {:answer/id #uuid "33c483fc-3b09-59d7-9da1-80912d0b30c1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282415}] :answer-field/correct {:answer/id #uuid "33c483fc-3b09-59d7-9da1-80912d0b30c1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282415} :answer-field/id #uuid "7444f931-fe5f-5dc3-a88c-773264e771d2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186282413}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f192c8ec-f3c5-5496-afeb-ada7f32857a5" :question/math-academy-id "q-341745" :question/problem "If $x={y}^{4}-\\frac{3}{y},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(4,-1).$\n\n$\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)}=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}({y}^{4}-\\frac{3}{y}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}({y}^{4})-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1}) \\\\  & =4{y}^{3}-3(-{y}^{-2}) \\\\  & =4{y}^{3}+3{y}^{-2} \\\\  & =4{y}^{3}+\\frac{3}{{y}^{2}} \\\\  & =\\frac{4{y}^{5}+3}{{y}^{2}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{2}}{4{y}^{5}+3}.\n$$\n\nFinally, substituting the point $(4,-1),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,-1)} & =\\frac{(-1)^{2}}{4(-1)^{5}+3}=-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282416 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3852b66a-7064-59a8-a7b1-851eb54b1a47" :answer/type {:db/ident :answer.type/math} :answer/value "-x+5" :db/id #edb/ref 17592186282418}] :answer-field/correct {:answer/id #uuid "3852b66a-7064-59a8-a7b1-851eb54b1a47" :answer/type {:db/ident :answer.type/math} :answer/value "-x+5" :db/id #edb/ref 17592186282418} :answer-field/id #uuid "37dff734-38f7-53b0-8a36-e61e60c5e30e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186282417}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b5a6f3b2-8851-548b-a826-4dcc5cd308eb" :question/math-academy-id "q-342061" :question/problem "Given a curve $x=6\\sqrt{y}-2{y}^{2},$ what is the equation of the tangent to the curve at the point $(4,1)?$\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(6\\sqrt{y}-2{y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y})-2\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =6\\frac{\\text{d}}{\\text{d}y}({y}^{1/2})-2(2y) \\\\  & =6\\cdot \\frac{1}{2}{y}^{-1/2}-4y \\\\  & =3{y}^{-1/2}-4y \\\\  & =\\frac{3}{\\sqrt{y}}-4y \\\\  & =\\frac{3-4y\\sqrt{y}}{\\sqrt{y}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{\\sqrt{y}}{3-4y\\sqrt{y}}.\n$$\n\nThe slope of the tangent to the curve at the point $(4,1)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(4,1)} \\\\  & =\\frac{\\sqrt{1}}{3-4(1)\\sqrt{1}} \\\\  & =\\frac{1}{3-4} \\\\  & =-1.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-(x-4) \\\\ y & =-x+4+1 \\\\ y & =-x+5.\\end{aligned}\n$$"}]}
