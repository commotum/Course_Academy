[{:db/id [:question/math-academy-id "q-66940"] :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{e}^{1-2x} & =5 \\\\ ln⁡({e}^{1-2x}) & =ln⁡(5) \\\\ 1-2x & =ln⁡(5) \\\\ -2x & =ln⁡(5)-1 \\\\ x & =\\frac{1-ln⁡(5)}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈-0.305\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-110536/selection/13a70591359eb52715e97f30b90d906d7bd15a361cf4700a1e61d0ae75a1167f" :answer/id #uuid "dc8b5501-3248-54dc-945d-8f74e4d64475" :answer/type :answer.type/math :answer/value "ln⁡(2)+1" :db/ensure [:answer/validate]} {:db/id "q-110536/selection/9aa063e2062d21736a9b772bf3f60c7ff86fb68cec74acecb3ff7f545055bf1b" :answer/id #uuid "91eea15e-6617-5c4d-b995-440c8f052e68" :answer/type :answer.type/math :answer/value "2ln⁡(2)" :db/ensure [:answer/validate]} {:db/id "q-110536/selection/e559b8023496bc5bfd9992407006fc8aa80eb21456042d54ec8937571e974f10" :answer/id #uuid "c839f03e-4f7e-5219-9480-23ba853c3b9b" :answer/type :answer.type/math :answer/value "ln⁡(2)-1" :db/ensure [:answer/validate]} {:db/id "q-110536/selection/79535982a68d37ecb6d21fe0bf3f734d9d00e0c01ee99791d7d672ea617f126e" :answer/id #uuid "825cabd6-8a8b-5769-b894-b4f35363cc16" :answer/type :answer.type/math :answer/value "2ln⁡(2)-1" :db/ensure [:answer/validate]} {:db/id "q-110536/selection/50974e2a9825b0d54c686155827198ffc4e44796ae222804e7f6754aa55cc3a8" :answer/id #uuid "d937a9eb-fb28-5822-93b3-3c7c683630ff" :answer/type :answer.type/math :answer/value "2ln⁡(2)+1" :db/ensure [:answer/validate]} {:db/id "q-110536/selection" :answer-field/id #uuid "c32e7bb2-8975-5a5a-9235-d0811b01d7d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110536/selection/79535982a68d37ecb6d21fe0bf3f734d9d00e0c01ee99791d7d672ea617f126e" :answer-field/choices ["q-110536/selection/13a70591359eb52715e97f30b90d906d7bd15a361cf4700a1e61d0ae75a1167f" "q-110536/selection/9aa063e2062d21736a9b772bf3f60c7ff86fb68cec74acecb3ff7f545055bf1b" "q-110536/selection/e559b8023496bc5bfd9992407006fc8aa80eb21456042d54ec8937571e974f10" "q-110536/selection/79535982a68d37ecb6d21fe0bf3f734d9d00e0c01ee99791d7d672ea617f126e" "q-110536/selection/50974e2a9825b0d54c686155827198ffc4e44796ae222804e7f6754aa55cc3a8"] :db/ensure [:answer-field/validate]} {:db/id "q-110536" :question/id #uuid "2335269b-5050-525c-bd6e-7954e002a26e" :question/math-academy-id "q-110536" :question/is-example false :question/problem "Given that ${e}^{y+1}-1=3,$ then $y=$" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{y+1}-1 & =3 \\\\ {e}^{y+1} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{y+1} & =4 \\\\ ln⁡({e}^{y+1}) & =ln⁡(4) \\\\ y+1 & =2ln⁡(2) \\\\ y & =2ln⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=2ln⁡(2)-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110536/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367"] :knowledge-point/questions ["q-110536"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263069/field-1/293c38d6b2677d16c75044304c83ee24779beb547be28bc79b6fcdbfdf11ce70" :answer/id #uuid "494921b1-4de8-5be6-8ad9-2f302e098c4c" :answer/type :answer.type/math :answer/value "2.708" :db/ensure [:answer/validate]} {:db/id "q-263069/field-1" :answer-field/id #uuid "0cd1cc7b-f1ab-5af2-8dc7-dd7f278a3ee0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-263069/field-1/293c38d6b2677d16c75044304c83ee24779beb547be28bc79b6fcdbfdf11ce70" :answer-field/choices ["q-263069/field-1/293c38d6b2677d16c75044304c83ee24779beb547be28bc79b6fcdbfdf11ce70"] :db/ensure [:answer-field/validate]} {:db/id "q-263069" :question/id #uuid "ab1fd3de-c472-5d83-8888-66e9bfebe0fa" :question/math-academy-id "q-263069" :question/is-example false :question/problem "If ${e}^{t}=15,$ then $t≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $t:$\n\n$$\n\\begin{aligned}{e}^{t} & =15 \\\\ ln⁡({e}^{t}) & =ln⁡(15) \\\\ t & =ln⁡(15)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nt≈2.708\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-263069/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe"] :knowledge-point/questions ["q-263069"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263178/field-1/39a2f9b3fa29bb7e47f11b448868a795e88ec13d4fcf51093756a5ede16cbd4c" :answer/id #uuid "4402d50c-2b4e-5568-b680-9a6bb42e5bcc" :answer/type :answer.type/math :answer/value "0.197" :db/ensure [:answer/validate]} {:db/id "q-263178/field-1/56a3132a7bf2ee257f64856e87d55f6656d4844ef08481a60a43a921b3694744" :answer/id #uuid "77f31da2-6a41-5e73-9c39-0b0b2abf4869" :answer/type :answer.type/math :answer/value "0.198" :db/ensure [:answer/validate]} {:db/id "q-263178/field-1" :answer-field/id #uuid "c0741321-9d12-5672-935d-305d6b4bce1e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-263178/field-1/39a2f9b3fa29bb7e47f11b448868a795e88ec13d4fcf51093756a5ede16cbd4c" :answer-field/choices ["q-263178/field-1/39a2f9b3fa29bb7e47f11b448868a795e88ec13d4fcf51093756a5ede16cbd4c" "q-263178/field-1/56a3132a7bf2ee257f64856e87d55f6656d4844ef08481a60a43a921b3694744"] :db/ensure [:answer-field/validate]} {:db/id "q-263178" :question/id #uuid "6d1bb954-474f-5d63-928a-1a774f1fcfa1" :question/math-academy-id "q-263178" :question/is-example false :question/problem "If ${e}^{x+2}-7=2,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{x+2}-7 & =2 \\\\ {e}^{x+2} & =2+7 \\\\ {e}^{x+2} & =9\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{x+2} & =9 \\\\ ln⁡({e}^{x+2}) & =ln⁡(9) \\\\ x+2 & =ln⁡(9) \\\\ x & =ln⁡(9)-2\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.197\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-263178/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367"] :knowledge-point/questions ["q-263178"] :db/ensure [:knowledge-point/validate]} {:db/id "q-263201/field-1/8fe8a7c9a9e93d7ab17be6b724be2c13c1a454dac9b76c579c634846cd6b95d4" :answer/id #uuid "aaf55153-14db-594e-8397-f1533fd3abcc" :answer/type :answer.type/math :answer/value "-3.198" :db/ensure [:answer/validate]} {:db/id "q-263201/field-1" :answer-field/id #uuid "69bf3242-d1be-574c-a9b9-9744824f2be4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-263201/field-1/8fe8a7c9a9e93d7ab17be6b724be2c13c1a454dac9b76c579c634846cd6b95d4" :answer-field/choices ["q-263201/field-1/8fe8a7c9a9e93d7ab17be6b724be2c13c1a454dac9b76c579c634846cd6b95d4"] :db/ensure [:answer-field/validate]} {:db/id "q-263201" :question/id #uuid "a07363ca-321c-5f56-a247-f42f3aaca570" :question/math-academy-id "q-263201" :question/is-example false :question/problem "If ${e}^{5+y/2}-9=21,$ then $y≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{5+y/2}-9 & =21 \\\\ {e}^{5+y/2} & =21+9 \\\\ {e}^{5+y/2} & =30\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{5+y/2} & =30 \\\\ ln⁡({e}^{5+y/2}) & =ln⁡(30) \\\\ 5+\\frac{y}{2} & =ln⁡(30) \\\\ \\frac{y}{2} & =ln⁡(30)-5 \\\\ y & =2ln⁡(30)-10\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈-3.198\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-263201/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367"] :knowledge-point/questions ["q-263201"] :db/ensure [:knowledge-point/validate]}]
