#{[{:db/id #edb/ref 17592186247961 :knowledge-point/_questions [{:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc8b5501-3248-54dc-945d-8f74e4d64475" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡(2)+1" :db/id #edb/ref 17592186247963} {:answer/id #uuid "d937a9eb-fb28-5822-93b3-3c7c683630ff" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡(2)+1" :db/id #edb/ref 17592186247964} {:answer/id #uuid "825cabd6-8a8b-5769-b894-b4f35363cc16" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186247965} {:answer/id #uuid "91eea15e-6617-5c4d-b995-440c8f052e68" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡(2)" :db/id #edb/ref 17592186247966} {:answer/id #uuid "c839f03e-4f7e-5219-9480-23ba853c3b9b" :answer/type {:db/ident :answer.type/math} :answer/value "ln⁡(2)-1" :db/id #edb/ref 17592186247967}] :answer-field/correct {:answer/id #uuid "825cabd6-8a8b-5769-b894-b4f35363cc16" :answer/type {:db/ident :answer.type/math} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186247965} :answer-field/id #uuid "c32e7bb2-8975-5a5a-9235-d0811b01d7d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186247962}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2335269b-5050-525c-bd6e-7954e002a26e" :question/is-example false :question/math-academy-id "q-110536" :question/problem "Given that ${e}^{y+1}-1=3,$ then $y=$" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{y+1}-1 & =3 \\\\ {e}^{y+1} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{y+1} & =4 \\\\ ln⁡({e}^{y+1}) & =ln⁡(4) \\\\ y+1 & =2ln⁡(2) \\\\ y & =2ln⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=2ln⁡(2)-1.$"}] [{:db/id #edb/ref 17592186247968 :knowledge-point/_questions [{:knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "494921b1-4de8-5be6-8ad9-2f302e098c4c" :answer/type {:db/ident :answer.type/math} :answer/value "2.708" :db/id #edb/ref 17592186247970}] :answer-field/correct {:answer/id #uuid "494921b1-4de8-5be6-8ad9-2f302e098c4c" :answer/type {:db/ident :answer.type/math} :answer/value "2.708" :db/id #edb/ref 17592186247970} :answer-field/id #uuid "0cd1cc7b-f1ab-5af2-8dc7-dd7f278a3ee0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247969}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ab1fd3de-c472-5d83-8888-66e9bfebe0fa" :question/is-example false :question/math-academy-id "q-263069" :question/problem "If ${e}^{t}=15,$ then $t≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $t:$\n\n$$\n\\begin{aligned}{e}^{t} & =15 \\\\ ln⁡({e}^{t}) & =ln⁡(15) \\\\ t & =ln⁡(15)\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nt≈2.708\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186247971 :knowledge-point/_questions [{:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4402d50c-2b4e-5568-b680-9a6bb42e5bcc" :answer/type {:db/ident :answer.type/math} :answer/value "0.197" :db/id #edb/ref 17592186247973} {:answer/id #uuid "77f31da2-6a41-5e73-9c39-0b0b2abf4869" :answer/type {:db/ident :answer.type/math} :answer/value "0.198" :db/id #edb/ref 17592186247974}] :answer-field/correct {:answer/id #uuid "4402d50c-2b4e-5568-b680-9a6bb42e5bcc" :answer/type {:db/ident :answer.type/math} :answer/value "0.197" :db/id #edb/ref 17592186247973} :answer-field/id #uuid "c0741321-9d12-5672-935d-305d6b4bce1e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247972}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "6d1bb954-474f-5d63-928a-1a774f1fcfa1" :question/is-example false :question/math-academy-id "q-263178" :question/problem "If ${e}^{x+2}-7=2,$ then $x≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{x+2}-7 & =2 \\\\ {e}^{x+2} & =2+7 \\\\ {e}^{x+2} & =9\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $x:$\n\n$$\n\\begin{aligned}{e}^{x+2} & =9 \\\\ ln⁡({e}^{x+2}) & =ln⁡(9) \\\\ x+2 & =ln⁡(9) \\\\ x & =ln⁡(9)-2\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈0.197\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186247975 :knowledge-point/_questions [{:knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaf55153-14db-594e-8397-f1533fd3abcc" :answer/type {:db/ident :answer.type/math} :answer/value "-3.198" :db/id #edb/ref 17592186247977}] :answer-field/correct {:answer/id #uuid "aaf55153-14db-594e-8397-f1533fd3abcc" :answer/type {:db/ident :answer.type/math} :answer/value "-3.198" :db/id #edb/ref 17592186247977} :answer-field/id #uuid "69bf3242-d1be-574c-a9b9-9744824f2be4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186247976}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a07363ca-321c-5f56-a247-f42f3aaca570" :question/is-example false :question/math-academy-id "q-263201" :question/problem "If ${e}^{5+y/2}-9=21,$ then $y≈${{field-1}}, rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{5+y/2}-9 & =21 \\\\ {e}^{5+y/2} & =21+9 \\\\ {e}^{5+y/2} & =30\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{5+y/2} & =30 \\\\ ln⁡({e}^{5+y/2}) & =ln⁡(30) \\\\ 5+\\frac{y}{2} & =ln⁡(30) \\\\ \\frac{y}{2} & =ln⁡(30)-5 \\\\ y & =2ln⁡(30)-10\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\ny≈-3.198\n$$\n\nrounded to $3$ decimal places."}] [{:db/id #edb/ref 17592186088206 :knowledge-point/_questions [{:knowledge-point/id #uuid "765ef63a-e3f0-503b-876d-3b4776b2cafe" :knowledge-point/title "Finding Approximate Solutions to Exponential Equations Using the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96a3ebb3-a2ea-5f02-893b-c9817c301d82" :answer/type {:db/ident :answer.type/math} :answer/value "-0.527" :db/id #edb/ref 17592186086168} {:answer/id #uuid "9c375437-7fc5-5bab-a541-f473a69c0538" :answer/type {:db/ident :answer.type/math} :answer/value "0.195" :db/id #edb/ref 17592186086169} {:answer/id #uuid "9d071905-bde4-53a5-8ec6-4d5f851d4428" :answer/type {:db/ident :answer.type/math} :answer/value "0.151" :db/id #edb/ref 17592186086170} {:answer/id #uuid "07eaf55b-4842-5832-a277-9893bdaeb841" :answer/type {:db/ident :answer.type/math} :answer/value "-0.305" :db/id #edb/ref 17592186086171} {:answer/id #uuid "70efbed3-7139-5f3d-8e7f-7967e94d987c" :answer/type {:db/ident :answer.type/math} :answer/value "0.651" :db/id #edb/ref 17592186086172}] :answer-field/correct {:answer/id #uuid "07eaf55b-4842-5832-a277-9893bdaeb841" :answer/type {:db/ident :answer.type/math} :answer/value "-0.305" :db/id #edb/ref 17592186086171} :answer-field/id #uuid "daf74767-d8d9-578e-93ec-453b44722dfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086167}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "063b851a-c4a8-502d-80ec-f9c4d61efa9a" :question/is-example false :question/math-academy-id "q-66940" :question/problem "> A scientific calculator is required to answer this question.\n\nFind the solution to the equation $e^{1 - 2x} = 5$ rounded to $3$ decimal places." :question/requires-calculator true :question/worked-solution "First, we take $ln$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{e}^{1-2x} & =5 \\\\ ln⁡({e}^{1-2x}) & =ln⁡(5) \\\\ 1-2x & =ln⁡(5) \\\\ -2x & =ln⁡(5)-1 \\\\ x & =\\frac{1-ln⁡(5)}{2}\\end{aligned}\n$$\n\nEvaluating the above expression using a calculator gives\n\n$$\nx≈-0.305\n$$\n\nrounded to $3$ decimal places."}]}
