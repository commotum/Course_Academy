9535200 true] [17592186337143 1089 "q-344341" 13194139535200 true] [17592186337143 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337143 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059223/assets/28cef739fd66e414894e830a02582f979dfdf285b3208cff5bba42b68537eefa.png)\n\nThe graph of the function $y=f(x)$ is shown above. Approximate ${f}^{′}(x)$ at the point $x=8$ using a central difference approximation with step size $h=2.$\n\n*Hint: Assume that the graph passes through the points with integer $y$-coordinates when $x=6$ and $x=10.$*\n\n${f}^{′}(8)≈$\n{{field-1}}" 13194139535200 true] [17592186337143 1113 #uuid "44c56c27-a6d5-502c-baaf-243795a3dee4" 13194139535200 true] [17592186337143 1145 "We use the central difference approximation\n\n$$\n{f}^{′}(x)≈\\frac{f(x+h)-f(x-h)}{2h},\n$$\n\nat the point $x=8$ with step size $h=2.$ This gives\n\n$$\n\\begin{aligned}{f}^{′}(8) & ≈\\frac{f(8+2)-f(8-2)}{2(2)} \\\\  & =\\frac{f(10)-f(6)}{4} \\\\  & =\\frac{-2-2}{4} \\\\  & =\\frac{(-4)}{4} \\\\  & =-1.\\end{aligned}\n$$" 13194139535200 true] [17592186337144 1000 #edb/ref 17592186337145 13194139535200 true] [17592186337144 1000 #edb/ref 17592186337146 13194139535200 true] [17592186337144 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337144 1041 "field-1" 13194139535200 true] [17592186337144 1104 #edb/ref 17592186337146 13194139535200 true] [17592186337144 1110 #uuid "104e562a-0667-5817-bbbc-d61083f8cd21" 13194139535200 true] [17592186337145 1034 "1" 13194139535200 true] [17592186337145 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337145 1111 #uuid "020b1e4f-a89f-53df-9e88-bfe48d9f3ead" 13194139535200 true] [17592186337146 1034 "-1" 13194139535200 true] [17592186337146 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337146 1111 #uuid "228e7a40-7e1b-51f7-94c0-b7675831c2dc" 13194139535200 true] [17592186337147 1017 #edb/ref 17592186337148 13194139535200 true] [17592186337147 1089 "q-344357" 13194139535200 true] [17592186337147 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337147 1100 "In an environmental study, the water level in a reservoir (in $m$) after $t$ hours is given by the function $W(t).$ The values of $W(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $0.8$ | $1.0$ | $1.2$ | $1.4$ | $1.6$ | $1.8$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| **$W(t)$** | $5.6$ | $5.3$ | $5.0$ | $4.7$ | $4.2$ | $3.9$ |\n\nApproximate the reservoir’s water level's instantaneous rate of change at $t=1.4$ using a central difference approximation with step size $h=0.2.$\n\nThe reservoir’s water level at $t=1.4$ is decreasing at approximately \n{{field-1}} $m$ per hour." 13194139535200 true] [17592186337147 1113 #uuid "ec64348f-7276-56b9-abdf-72ec76221afc" 13194139535200 true] [17592186337147 1145 "We use the central difference approximation\n\n$$\n{W}^{′}(t)≈\\frac{W(t+h)-W(t-h)}{2h},\n$$\n\nat time $t=1.4$ with step size $h=0.2.$ This gives\n\n$$\n\\begin{aligned}{W}^{′}(1.4) & ≈\\frac{W(1.4+0.2)-W(1.4-0.2)}{2(0.2)} \\\\  & =\\frac{W(1.6)-W(1.2)}{0.4} \\\\  & =\\frac{4.2-5.0}{0.4} \\\\  & =\\frac{-0.8}{0.4} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the reservoir’s water level at $t=1.4$ is decreasing at approximately $2\\,m$ per hour." 13194139535200 true] [17592186337148 1000 #edb/ref 17592186337149 13194139535200 true] [17592186337148 1000 #edb/ref 17592186337150 13194139535200 true] [17592186337148 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337148 1041 "field-1" 13194139535200 true] [17592186337148 1104 #edb/ref 17592186337149 13194139535200 true] [17592186337148 1110 #uuid "cf61ad9f-a811-5fed-a894-e836b265d4d9" 13194139535200 true] [17592186337149 1034 "2" 13194139535200 true] [17592186337149 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337149 1111 #uuid "6a72a384-ce71-59f7-9ab5-fbf72444ccda" 13194139535200 true] [17592186337150 1034 "-2" 13194139535200 true] [17592186337150 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337150 1111 #uuid "7f986d2b-3fe3-508a-a119-3e16d283640e" 13194139535200 true] [17592186337151 1017 #edb/ref 17592186337152 13194139535200 true] [17592186337151 1089 "q-344361" 13194139535200 true] [17592186337151 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337151 1100 "In a medical study, the concentration of a drug in a patient’s bloodstream (in $mg/L$) after $t$ hours is given by the function $C(t).$ The values of $C(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $2.0$ | $2.4$ | $2.8$ | $3.2$ | $3.6$ | $4.0$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| **$C(t)$** | $12.4$ | $11.8$ | $11.0$ | $10.4$ | $9.8$ | $9.2$ |\n\nApproximate the drug’s concentration instantaneous rate of change at $t=3.2$ using a central difference approximation with step size $h=0.4.$\n\nThe drug’s concentration at $t=3.2$ is decreasing at approximately \n{{field-1}} $mg/L$ per hour." 13194139535200 true] [17592186337151 1113 #uuid "9b099ac7-cdc4-5055-bbc0-2c4b0aca6b20" 13194139535200 true] [17592186337151 1145 "We use the central difference approximation\n\n$$\n{C}^{′}(t)≈\\frac{C(t+h)-C(t-h)}{2h},\n$$\n\nat time $t=3.2$ with step size $h=0.4.$ This gives\n\n$$\n\\begin{aligned}{C}^{′}(3.2) & ≈\\frac{C(3.2+0.4)-C(3.2-0.4)}{2(0.4)} \\\\  & =\\frac{C(3.6)-C(2.8)}{0.8} \\\\  & =\\frac{9.8-11.0}{0.8} \\\\  & =\\frac{(-1.2)}{0.8} \\\\  & =-1.5.\\end{aligned}\n$$\n\nTherefore, the drug’s concentration at $t=3.2$ is decreasing at approximately $1.5\\,mg/L$ per hour." 13194139535200 true] [17592186337152 1000 #edb/ref 17592186337153 13194139535200 true] [17592186337152 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337152 1041 "field-1" 13194139535200 true] [17592186337152 1104 #edb/ref 17592186337153 13194139535200 true] [17592186337152 1110 #uuid "e6a5b923-b80c-5608-8937-70eaf91cee7b" 13194139535200 true] [17592186337153 1034 "1.5" 13194139535200 true] [17592186337153 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337153 1111 #uuid "ae0f0af5-cae8-5a86-9695-b7dec452c6b0" 13194139535200 true] [17592186337154 1017 #edb/ref 17592186337155 13194139535200 true] [17592186337154 1089 "q-47504" 13194139535200 true] [17592186337154 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337154 1100 "The temperature of a certain liquid under heating is given by the function $T(t),$ where $t$ is the time in hours. The values of $T(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $1.2$ | $1.4$ | $1.6$ | $1.8$ | $2.0$ | $2.2$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $T(t)$ | $-12$ | $-10$ | $-4$ | $6$ | $10$ | $13$ |\n\n$$\n\n$$\n\nDetermine the instantaneous temperature rate at the instant of time $t=1.6$ using a central difference approximation with the step size $h=0.2.$" 13194139535200 true] [17592186337154 1113 #uuid "6a5f3525-781f-598d-b562-9b3d6c7b6d32" 13194139535200 true] [17592186337154 1145 "We use the central difference approximation\n\n$$\n{T}^{′}(t)≈\\frac{T(t+h)-T(t-h)}{2h},\n$$\n\n \nat the time $t=1.6$ with step size $h=0.2.$ This gives\n\n$$\n\\begin{aligned}{T}^{′}(1.6) & ≈\\frac{T(1.6+0.2)-T(1.6-0.2)}{2(0.2)} \\\\  & =\\frac{T(1.8)-T(1.4)}{2(0.2)} \\\\  & =\\frac{6-(-10)}{0.4} \\\\  & =\\frac{16}{0.4} \\\\  & =40.\\end{aligned}\n$$\n\nTherefore, the instantaneous temperature rate at the instant of time $t=1.6$ is ${40}^{∘}$ per hour." 13194139535200 true] [17592186337155 1000 #edb/ref 17592186337156 13194139535200 true] [17592186337155 1000 #edb/ref 17592186337157 13194139535200 true] [17592186337155 1000 #edb/ref 17592186337158 13194139535200 true] [17592186337155 1000 #edb/ref 17592186337159 13194139535200 true] [17592186337155 1000 #edb/ref 17592186337160 13194139535200 true] [17592186337155 1040 #edb/ref 17592186045450 13194139535200 true] [17592186337155 1041 "selection" 13194139535200 true] [17592186337155 1104 #edb/ref 17592186337160 13194139535200 true] [17592186337155 1110 #uuid "c23268cd-5b30-571a-896a-a5cef4c880c8" 13194139535200 true] [17592186337156 1034 "${16}^{∘}$ per hour" 13194139535200 true] [17592186337156 1103 #edb/ref 17592186045454 13194139535200 true] [17592186337156 1111 #uuid "34deacc7-fe6a-5f63-a8e8-59dbeb887e44" 13194139535200 true] [17592186337157 1034 "${20}^{∘}$ per hour" 13194139535200 true] [17592186337157 1103 #edb/ref 17592186045454 13194139535200 true] [17592186337157 1111 #uuid "a38ac727-e311-5a4b-8f43-23be410497b3" 13194139535200 true] [17592186337158 1034 "${8}^{∘}$ per hour" 13194139535200 true] [17592186337158 1103 #edb/ref 17592186045454 13194139535200 true] [17592186337158 1111 #uuid "f30f5f9b-7bf9-5e08-ac1a-5408bcf5ee29" 13194139535200 true] [17592186337159 1034 "${4}^{∘}$ per hour" 13194139535200 true] [17592186337159 1103 #edb/ref 17592186045454 13194139535200 true] [17592186337159 1111 #uuid "a1a7bf0c-5cc5-5c7e-b6ac-2fe1efd7c9b9" 13194139535200 true] [17592186337160 1034 "${40}^{∘}$ per hour" 13194139535200 true] [17592186337160 1103 #edb/ref 17592186045454 13194139535200 true] [17592186337160 1111 #uuid "4a8abf06-ed31-5b01-8473-5132f2cf283e" 13194139535200 true] [17592186337161 1017 #edb/ref 17592186337162 13194139535200 true] [17592186337161 1089 "q-51402" 13194139535200 true] [17592186337161 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337161 1100 "Sam wanted to estimate the rate of weight growth of his new puppy. He took note of its weight every week, for $7$ weeks. The results are shown in the table below, where $W(t)$ is the puppy's weight (measured in pounds) after $t$ weeks from birth.\n\n| **$t$** | $8$ | $9$ | $10$ | $11$ | $12$ | $13$ | $14$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $W(t)$ | $9$ | $10.1$ | $11.3$ | $12.4$ | $13.5$ | $14.6$ | $15.8$ |\n\n$$\n\n$$\n\nApproximate the puppy's rate of weight growth $12$ weeks after birth using a central difference approximation with step size $h=1.$" 13194139535200 true] [17592186337161 1113 #uuid "fbfaa746-7592-59a4-b95e-aa048f2cedc8" 13194139535200 true] [17592186337161 1145 "We use the central difference approximation\n\n$$\n{W}^{′}(t)≈\\frac{W(t+h)-W(t-h)}{2h},\n$$\n\n \nat the time $t=12$ and step size $h=1.$ This gives\n\n$$\n\\begin{aligned}{W}^{′}(0.2) & ≈\\frac{W(12+1)-W(12-1)}{2(1)} \\\\  & =\\frac{W(13)-W(11)}{2} \\\\  & =\\frac{14.6-12.4}{2} \\\\  & =\\frac{2.2}{2} \\\\  & =1.1.\\end{aligned}\n$$\n\nSo, the rate of weight growth at the instant of time $t=12$ is $1.1\\,\\text{lb}/\\text{week}.$" 13194139535200 true] [17592186337162 1000 #edb/ref 17592186337163 13194139535200 true] [17592186337162 1000 #edb/ref 17592186337164 13194139535200 true] [17592186337162 1000 #edb/ref 17592186337165 13194139535200 true] [17592186337162 1000 #edb/ref 17592186337166 13194139535200 true] [17592186337162 1000 #edb/ref 17592186337167 13194139535200 true] [17592186337162 1040 #edb/ref 17592186045450 13194139535200 true] [17592186337162 1041 "selection" 13194139535200 true] [17592186337162 1104 #edb/ref 17592186337163 13194139535200 true] [17592186337162 1110 #uuid "63273c97-8f73-5984-8f3b-a68ff7a99ae8" 13194139535200 true] [17592186337163 1034 "1.1\\,\\text{lb}/\\text{week}" 13194139535200 true] [17592186337163 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337163 1111 #uuid "950be1fa-d2e6-5869-8fe4-496f9574b9cc" 13194139535200 true] [17592186337164 1034 "1.05\\,\\text{lb}/\\text{week}" 13194139535200 true] [17592186337164 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337164 1111 #uuid "028aee04-da3e-5a1c-89db-1aea3bf20029" 13194139535200 true] [17592186337165 1034 "2.2\\,\\text{lb}/\\text{week}" 13194139535200 true] [17592186337165 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337165 1111 #uuid "92bc3d62-fa48-59ab-ae6a-a9ed02d7e52c" 13194139535200 true] [17592186337166 1034 "2.1\\,\\text{lb}/\\text{week}" 13194139535200 true] [17592186337166 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337166 1111 #uuid "da37e92f-5ca9-5f40-a7fa-8de