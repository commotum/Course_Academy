5200 true] [17592186337117 1034 "1" 13194139535200 true] [17592186337117 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337117 1111 #uuid "3bcab95d-d87b-5553-b53c-80f8fd95a303" 13194139535200 true] [17592186337118 1034 "0.75" 13194139535200 true] [17592186337118 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337118 1111 #uuid "92fb79b0-96e1-5306-b182-d1540785e12a" 13194139535200 true] [17592186337119 1017 #edb/ref 17592186337120 13194139535200 true] [17592186337119 1089 "q-170651" 13194139535200 true] [17592186337119 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337119 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059223/assets/7f36258f966a7af5ae9f35c4e3214bb8c2c7d0ae66039256b2484df5b34d83fb.png)\n\nThe graph of the function $y=g(x)$ is shown above. Approximate ${g}^{′}(x)$ at the point $x=3$ using a central difference approximation with step size $h=1.$" 13194139535200 true] [17592186337119 1113 #uuid "d7eb6c7c-5b6e-50a1-b81c-4f076d395815" 13194139535200 true] [17592186337119 1145 "We use the central difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x-h)}{2h},\n$$\n\nat the point $x=3$ with step size $h=1.$ This gives\n\n$$\n\\begin{aligned}{g}^{′}(3) & ≈\\frac{g(3+1)-g(3-1)}{2} \\\\  & =\\frac{g(4)-g(2)}{2} \\\\  & =\\frac{1-4}{2} \\\\  & =-\\frac{3}{2} \\\\  & =-1.5.\\end{aligned}\n$$" 13194139535200 true] [17592186337120 1000 #edb/ref 17592186337121 13194139535200 true] [17592186337120 1000 #edb/ref 17592186337122 13194139535200 true] [17592186337120 1000 #edb/ref 17592186337123 13194139535200 true] [17592186337120 1000 #edb/ref 17592186337124 13194139535200 true] [17592186337120 1000 #edb/ref 17592186337125 13194139535200 true] [17592186337120 1040 #edb/ref 17592186045450 13194139535200 true] [17592186337120 1041 "selection" 13194139535200 true] [17592186337120 1104 #edb/ref 17592186337122 13194139535200 true] [17592186337120 1110 #uuid "19d61f57-8395-5793-bdbc-a86a924d2890" 13194139535200 true] [17592186337121 1034 "-2.5" 13194139535200 true] [17592186337121 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337121 1111 #uuid "73db0455-d7f7-5108-b2f1-cbfff41b387a" 13194139535200 true] [17592186337122 1034 "-1.5" 13194139535200 true] [17592186337122 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337122 1111 #uuid "6bc6589b-018f-5f42-8f41-4a39d5454404" 13194139535200 true] [17592186337123 1034 "-3" 13194139535200 true] [17592186337123 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337123 1111 #uuid "9d5e0e09-d4b9-532a-a1d5-83e0baf68c39" 13194139535200 true] [17592186337124 1034 "-1" 13194139535200 true] [17592186337124 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337124 1111 #uuid "675c493c-c47b-574d-b67f-2160d79a51ca" 13194139535200 true] [17592186337125 1034 "-2" 13194139535200 true] [17592186337125 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337125 1111 #uuid "84aa0392-1a3e-5c3e-b5b8-8047aeeb6353" 13194139535200 true] [17592186337126 1017 #edb/ref 17592186337127 13194139535200 true] [17592186337126 1089 "q-315235" 13194139535200 true] [17592186337126 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337126 1100 "In a lab experiment, the temperature of a chemical reactor (in ${}^{∘}C$) after $t$ minutes is given by the function $T(t).$ The values of $T(t)$ for different values of $t$ are given in the table below:\n\n| **$t$** | $1.2$ | $1.6$ | $2.0$ | $2.4$ | $2.8$ | $3.2$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| **$T(t)$** | $28$ | $30$ | $32$ | $34$ | $35$ | $36$ |\n\nApproximate the reactor’s temperature instantaneous rate of change at $t=2.0$ using a central difference approximation with step size $h=0.4.$\n\nThe reactor’s temperature at $t=2.0$ is changing at approximately \n{{field-1}} ${}^{∘}C$ per minute." 13194139535200 true] [17592186337126 1113 #uuid "07578661-317b-5244-989a-6d1ed375019c" 13194139535200 true] [17592186337126 1145 "We use the central difference approximation\n\n$$\n{T}^{′}(t)≈\\frac{T(t+h)-T(t-h)}{2h},\n$$\n\nat time $t=2.0$ with step size $h=0.4.$ This gives\n\n$$\n\\begin{aligned}{T}^{′}(2.0) & ≈\\frac{T(2.0+0.4)-T(2.0-0.4)}{2(0.4)} \\\\  & =\\frac{T(2.4)-T(1.6)}{0.8} \\\\  & =\\frac{34-30}{0.8} \\\\  & =\\frac{4}{0.8} \\\\  & =5.\\end{aligned}\n$$\n\nTherefore, the reactor’s temperature at $t=2.0$ is changing at approximately $5\\,{}^{∘}C$ per minute." 13194139535200 true] [17592186337127 1000 #edb/ref 17592186337128 13194139535200 true] [17592186337127 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337127 1041 "field-1" 13194139535200 true] [17592186337127 1104 #edb/ref 17592186337128 13194139535200 true] [17592186337127 1110 #uuid "7cbd34dd-c80f-5b10-bdca-f6db24f6ad5f" 13194139535200 true] [17592186337128 1034 "5" 13194139535200 true] [17592186337128 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337128 1111 #uuid "c788e050-6d29-52f3-ae00-ac57242deb8c" 13194139535200 true] [17592186337129 1017 #edb/ref 17592186337130 13194139535200 true] [17592186337129 1089 "q-343970" 13194139535200 true] [17592186337129 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337129 1100 "A function $g(x)$ has values according to the table below:\n\n| **$x$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ |\n| --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-5.0$ | $-4.0$ | $-2.7$ | $-1.0$ | $0.5$ |\n\n$$\n\n$$\n\nApproximate ${g}^{′}(x)$ at the point $x=-1$ using a central difference approximation.\n\n${g}^{′}(-1)≈$\n{{field-1}}" 13194139535200 true] [17592186337129 1113 #uuid "c795a3d5-0d99-504a-8cda-52da7f8df108" 13194139535200 true] [17592186337129 1145 "We use the central difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x-h)}{2h}\n$$\n\n \nat the point $x=-1.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives\n\n$$\n\\begin{aligned}{g}^{′}(-1) & ≈\\frac{g(-1+1)-g(-1-1)}{2(1)} \\\\  & =\\frac{g(0)-g(-2)}{2(1)} \\\\  & =\\frac{-1.0-(-4.0)}{2} \\\\  & =\\frac{3}{2} \\\\  & =1.5.\\end{aligned}\n$$" 13194139535200 true] [17592186337130 1000 #edb/ref 17592186337131 13194139535200 true] [17592186337130 1000 #edb/ref 17592186337132 13194139535200 true] [17592186337130 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337130 1041 "field-1" 13194139535200 true] [17592186337130 1104 #edb/ref 17592186337132 13194139535200 true] [17592186337130 1110 #uuid "677f6bb2-95eb-531a-8c84-05368de32aa6" 13194139535200 true] [17592186337131 1034 "3" 13194139535200 true] [17592186337131 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337131 1111 #uuid "245651ef-31a2-5d02-bed3-6e53beb42f53" 13194139535200 true] [17592186337132 1034 "1.5" 13194139535200 true] [17592186337132 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337132 1111 #uuid "3de6bdfa-fcb7-5e86-997e-3a7b91fa3214" 13194139535200 true] [17592186337133 1017 #edb/ref 17592186337134 13194139535200 true] [17592186337133 1089 "q-343977" 13194139535200 true] [17592186337133 1091 #edb/ref 17592186045465 13194139535200 true] [17592186337133 1100 "Given that $f(4.9)=3.12$ and $f(5.1)=2.36,$ find an approximation for ${f}^{′}(5).$\n\n${f}^{′}(5)≈$\n{{field-1}}" 13194139535200 true] [17592186337133 1113 #uuid "389ac68b-8463-52b0-bca0-00a5d659e825" 13194139535200 true] [17592186337133 1145 "We use the central difference approximation\n\n$$\n{f}^{′}(x)≈\\frac{f(x+h)-f(x-h)}{2h}\n$$\n\n \nat the point $x=5$ with the step size $h=0.1.$ This gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & ≈\\frac{f(x+h)-f(x-h)}{2h} \\\\ {f}^{′}(5) & ≈\\frac{f(5+0.1)-f(5-0.1)}{2(0.1)} \\\\  & =\\frac{f(5.1)-f(4.9)}{0.2} \\\\  & =\\frac{2.36-3.12}{0.2} \\\\  & =\\frac{(-0.76)}{0.2} \\\\  & =-3.8.\\end{aligned}\n$$" 13194139535200 true] [17592186337134 1000 #edb/ref 17592186337135 13194139535200 true] [17592186337134 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337134 1041 "field-1" 13194139535200 true] [17592186337134 1104 #edb/ref 17592186337135 13194139535200 true] [17592186337134 1110 #uuid "1cef763f-0b61-5770-8850-1c31be8e3ae4" 13194139535200 true] [17592186337135 1034 "-3.8" 13194139535200 true] [17592186337135 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337135 1111 #uuid "1ce26b7b-187c-5177-8b27-c3b41c237ec6" 13194139535200 true] [17592186337136 1017 #edb/ref 17592186337137 13194139535200 true] [17592186337136 1089 "q-344006" 13194139535200 true] [17592186337136 1091 #edb/ref 17592186045463 13194139535200 true] [17592186337136 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059223/assets/ab10c9d133e6a383439b0a8b89643564f5f438d061dba647288927102e870a1b.png)\n\nThe graph of the function $y=f(x)$ is shown above. Approximate ${f}^{′}(x)$ at the point $x=-1$ using a central difference approximation with step size $h=2.$\n\n*Hint: Assume that the graph passes through the points with integer $y$-coordinates when $x=-3$ and $x=1.$*\n\n${f}^{′}(-1)≈$\n{{field-1}}" 13194139535200 true] [17592186337136 1113 #uuid "82c6adbb-7838-58fa-83a8-51e77b737ad5" 13194139535200 true] [17592186337136 1145 "We use the central difference approximation\n\n$$\n{f}^{′}(x)≈\\frac{f(x+h)-f(x-h)}{2h}\n$$\n\n \nat the point $x=-1$ with step size $h=2.$ This gives\n\n$$\n\\begin{aligned}{f}^{′}(-1) & ≈\\frac{f(-1+2)-f(-1-2)}{2(2)} \\\\  & =\\frac{f(1)-f(-3)}{4} \\\\  & =\\frac{-2-2}{4} \\\\  & =\\frac{(-4)}{4} \\\\  & =-1.\\end{aligned}\n$$" 13194139535200 true] [17592186337137 1000 #edb/ref 17592186337138 13194139535200 true] [17592186337137 1040 #edb/ref 17592186045449 13194139535200 true] [17592186337137 1041 "field-1" 13194139535200 true] [17592186337137 1104 #edb/ref 17592186337138 13194139535200 true] [17592186337137 1110 #uuid "c32dfa01-e8fe-55e5-9a1b-5271fb01221e" 13194139535200 true] [17592186337138 1034 "-1" 13194139535200 true] [17592186337138 1103 #edb/ref 17592186045453 13194139535200 true] [17592186337138 1111 #uuid "9ad4d043-9f3a-5974-aaa6-a1af4a88dcb3" 13194139535200 true] [1759