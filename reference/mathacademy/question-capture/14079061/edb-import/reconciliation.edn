 & 4 \\\\ 2 & -4 & 7 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 & -1 \\\\ 0 & 1 & -1 & 4 \\\\ 0 & 0 & 1 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 & -1 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{aligned}] & {R}_{1} & :={R}_{1}+(-3){R}_{3} \\\\  & ∼[\\begin{aligned}1 & -2 & 0 & 5 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 9 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14079061/state.json" "file_sha256" "bea1219838bc2a0c90cd431ccbac16a30fa75e03d3fcfdc1265d91b3e1b59253"} {"question" "q-131603" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14079061/activity-metadata.json" "file_sha256" "8ebf2f6de173fc8bd7ea752d048f2f6dff5564dc1ba4ce9f8594cac88eae1cd7"} {"question" "q-131603" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14079061/state.json" "file_sha256" "bea1219838bc2a0c90cd431ccbac16a30fa75e03d3fcfdc1265d91b3e1b59253"} {"question" "q-131603" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "M∼[\\begin{aligned}1 & 0 & 0 & -8 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 0 & 0 & -9 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 0 & 0 & 8 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 0 & 0 & 8 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 2\\end{aligned}]"] ["math" "M∼[\\begin{aligned}1 & 0 & 0 & 9 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{aligne