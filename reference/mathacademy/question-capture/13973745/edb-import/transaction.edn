―}{z}=4-9\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(4+9\\text{i})(4-9\\text{i}) \\\\  & ={4}^{2}+(4)(-9)\\text{i}+(4)(9)\\text{i}-{\\text{i}}^{2}(9)^{2} \\\\  & =16-36\\text{i}+36\\text{i}-(-1)(81) \\\\  & =16+81 \\\\  & =97.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-16423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-16423"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72284/selection/abcc20f0a4a4a579d1789174f218330aa2d8c672f4593758bdad1bc6f51829aa" :answer/id #uuid "d9bad5ea-f670-527c-9f7e-ae4fc60956ad" :answer/type :answer.type/math :answer/value "7\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-72284/selection/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" :answer/id #uuid "acb1a52a-e383-5afb-9cf1-e7d33ce8a6df" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "q-72284/selection/04660847baa06770d8928b15c20e5e65105b9884da58747832f2a648da66fc27" :answer/id #uuid "baad8b25-04ab-5022-a77d-328922d01009" :answer/type :answer.type/math :answer/value "8\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-72284/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "53607d26-c3cd-5553-b0da-e5e29b7ed499" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-72284/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "14416991-c1b6-56c4-8f07-f642ea4d2ab7" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-72284/selection" :answer-field/id #uuid "5e302609-03d4-58f4-8887-8594b4dba452" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72284/selection/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" :answer-field/choices ["q-72284/selection/abcc20f0a4a4a579d1789174f218330aa2d8c672f4593758bdad1bc6f51829aa" "q-72284/selection/8642573b27c8383f67a645c39127977f20fbab89a940b170bac777f18f881b9b" "q-72284/selection/04660847baa06770d8928b15c20e5e65105b9884da58747832f2a648da66fc27" "q-72284/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-72284/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f"] :db/ensure [:answer-field/validate]} {:db/id "q-72284" :question/id #uuid "786b081b-3937-58d9-97f1-dc3dd953af4b" :question/math-academy-id "q-72284" :question/problem "Given that $z=-1-7\\text{i}$, calculate $z\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=-1-7\\text{i},$ the real part is $\\text{Re}(z)=-1,$ and the imaginary part is $\\text{Im}(z)=-7,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & =(-1)^{2}+(-7)^{2} \\\\  & =1+49 \\\\  & =50.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-1-7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-1+7\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(-1-7\\text{i})(-1+7\\text{i}) \\\\  & =(-1)^{2}+(-1)(7)\\text{i}+(-7)(-1)\\text{i}-{\\text{i}}^{2}(7)^{2} \\\\  & =1-7\\text{i}+7\\text{i}-(-1)(49) \\\\  & =1+49 \\\\  & =50.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72284/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-72284"] :db/ensure [:knowledge-point/validate]} {:db/id "q-159757/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "0fca5931-9374-5543-a9ff-2701cee97ed5" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-159757/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "26ead20b-1638-5e20-b8ae-c63ed579dd32" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-159757/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "4a0d23eb-f670-5df0-be8c-a2e3beac9197" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-159757/selection/eba7fb9cb4be54964d8fe1d1adda24ada9c039f0812a79a13a604e783119959e" :answer/id #uuid "aa9e47d5-bfd0-5712-93b2-413a7c93a998" :answer/type :answer.type/math :answer/value "-18\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-159757/selection/ebc263b21b550c052088d1cde2479d9c61732c62a8f4151a81df0c80da9c820a" :answer/id #uuid "40aebf18-4cef-50e6-8ed1-e0d0dbb1242b" :answer/type :answer.type/math :answer/value "-8\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-159757/selection" :answer-field/id #uuid "be9f873f-41b2-5d03-bf29-080478d28cb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-159757/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer-field/choices ["q-159757/selection/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" "q-159757/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-159757/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" "q-159757/selection/eba7fb9cb4be54964d8fe1d1adda24ada9c039f0812a79a13a604e783119959e" "q-159757/selection/ebc263b21b550c052088d1cde2479d9c61732c62a8f4151a81df0c80da9c820a"] :db/ensure [:answer-field/validate]} {:db/id "q-159757" :question/id #uuid "1fd36fc1-63ec-5bb6-9f2e-ae3a7bacac73" :question/math-academy-id "q-159757" :question/problem "If $z=-9-\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=-9-\\text{i},$ the real part is $Re(z)=-9,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(-9) \\\\  & =-18.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-9-\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-9+\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(-9-\\text{i})+(-9+\\text{i}) \\\\  & =(-9+(-9))+\\text{i}(-1+1) \\\\  & =-18+\\text{i}\\cdot 0 \\\\  & =-18.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-159757/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52"] :knowledge-point/questions ["q-159757"] :db/ensure [:knowledge-point/validate]} {:db/id "q-279477/field-1/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" :answer/id #uuid "1413da37-d531-576a-9d27-31157308f6eb" :answer/type :answer.type/math :answer/value "125" :db/ensure [:answer/validate]} {:db/id "q-279477/field-1" :answer-field/id #uuid "b307d44c-8fdb-53b6-81af-2885341cf98b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-279477/field-1/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" :answer-field/choices ["q-279477/field-1/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1"] :db/ensure [:answer-field/validate]} {:db/id "q-279477" :question/id #uuid "594c5e35-b6c4-57d7-b7e2-3344f7754685" :question/math-academy-id "q-279477" :question/problem "If $z=-2-11\\text{i}$, then $z\\overset{―}{z}=${{field-1}}." :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=-2-11\\text{i},$ the real part is $\\text{Re}(z)=-2,$ and the imaginary part is $\\text{Im}(z)=-11,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & =(-2)^{2}+(-11)^{2} \\\\  & =4+121 \\\\  & =125.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-2-11\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-2+11\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(-2-11\\text{i})(-2+11\\text{i}) \\\\  & =(2)^{2}+(-2)(11)\\text{i}+(-11)(-2)\\text{i}-{\\text{i}}^{2}(11)^{2} \\\\  & =4-\\cancel{22\\text{i}}+\\cancel{22\\text{i}}-(-1)(121) \\\\  & =25+100 \\\\  & =125.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-279477/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f"] :knowledge-point/questions ["q-279477"] :db/ensure [:knowledge-point/validate]}]
