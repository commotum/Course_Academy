 per day." 13194139533885 true] [17592186263284 1000 #edb/ref 17592186263285 13194139533885 true] [17592186263284 1000 #edb/ref 17592186263286 13194139533885 true] [17592186263284 1000 #edb/ref 17592186263287 13194139533885 true] [17592186263284 1000 #edb/ref 17592186263288 13194139533885 true] [17592186263284 1000 #edb/ref 17592186263289 13194139533885 true] [17592186263284 1040 #edb/ref 17592186045450 13194139533885 true] [17592186263284 1041 "selection" 13194139533885 true] [17592186263284 1104 #edb/ref 17592186263288 13194139533885 true] [17592186263284 1110 #uuid "48c3353f-76d0-5076-a4d2-cc000dc9c850" 13194139533885 true] [17592186263285 1034 "$5.5$ hours" 13194139533885 true] [17592186263285 1103 #edb/ref 17592186045454 13194139533885 true] [17592186263285 1111 #uuid "336851ab-b199-5d2b-80a1-d3f3d93535f7" 13194139533885 true] [17592186263286 1034 "$4$ hours" 13194139533885 true] [17592186263286 1103 #edb/ref 17592186045454 13194139533885 true] [17592186263286 1111 #uuid "24ab886a-44d2-56a1-af51-f7102d49fb92" 13194139533885 true] [17592186263287 1034 "$6$ hours" 13194139533885 true] [17592186263287 1103 #edb/ref 17592186045454 13194139533885 true] [17592186263287 1111 #uuid "61c4344b-8f3b-5ba6-98ef-a3ef8f6954ec" 13194139533885 true] [17592186263288 1034 "$5$ hours" 13194139533885 true] [17592186263288 1103 #edb/ref 17592186045454 13194139533885 true] [17592186263288 1111 #uuid "58d982f0-5a78-5596-afe3-eb3f45850519" 13194139533885 true] [17592186263289 1034 "$4.5$ hours" 13194139533885 true] [17592186263289 1103 #edb/ref 17592186045454 13194139533885 true] [17592186263289 1111 #uuid "96f6bf0b-281f-5737-93d9-916ef9128aeb" 13194139533885 true]] :edb/tempids {"q-133880" 17592186263213 "q-133880/selection" 17592186263214 "q-133880/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" 17592186263215 "q-133880/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" 17592186263216 "q-133880/selection/7f2aea1619f9c4cbe5384e08264