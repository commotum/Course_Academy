[{:db/id "q-74207/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "f72e879f-83c5-5a60-98a7-32bb58d273de" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-74207/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "cfaa9c2d-deda-568a-8698-0c07e949813f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-74207/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "5dc02a8e-9ed1-55c7-b355-a7f1c7062846" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74207/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "8eeda361-516f-5e20-b0ee-bcc1899b8d38" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-74207/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e93e5e44-de73-5bd5-89b9-078bfc554789" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-74207/selection" :answer-field/id #uuid "ffb445fa-62c0-5a88-800f-bbcc17615a6d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74207/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-74207/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-74207/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-74207/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74207/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-74207/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-74207" :question/id #uuid "c0d238fa-1e0e-5487-8673-870efc26cffa" :question/math-academy-id "q-74207" :question/is-example false :question/problem "Find the shortest distance between the point $(-3,3)$ and the line $y=-2.$" :question/worked-solution "Let's sketch the given situation.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934287/assets/67f63247ff1f91fae17f257512849ac2415a3894d57475d1e8a7afee1094df31.png)\n\nSince the line $y=-2$ is a horizontal line, the shortest distance between this line and the point $(-3,3)$ is given by the absolute value of the difference between $y$-coordinate of the point and $-2.$ \n\nSo, the shortest distance is\n\n$$\nd=|3-(-2)|=5.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74207/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157"] :knowledge-point/questions ["q-74207"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114323/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "86ba8fd1-d20d-5cf0-b2d4-7a170b627a5c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-114323/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "204d018e-c16b-530e-bf7a-b75c329fc52d" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-114323/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d784237f-8ede-5b02-88fc-86614228987d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-114323/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "8fce9667-6b42-5bc2-8e5a-dddedd0cb878" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-114323/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "41a60c3d-1754-566b-8910-cffc9ce6f802" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-114323/selection" :answer-field/id #uuid "ce57ccc5-4582-5aa3-b24d-c0f2fe9b4412" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114323/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-114323/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-114323/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-114323/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-114323/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-114323/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-114323" :question/id #uuid "f162095a-e7b4-52b0-b16f-7a98cc60e6ca" :question/math-academy-id "q-114323" :question/is-example false :question/problem "Find the shortest distance between the point $(4,3)$ and the line $x=2.$" :question/worked-solution "Let's sketch the given situation.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934287/assets/ea64c0752738b0c917d897060351cdd43ed7bbf687cc20781b7241ee3be0ad3c.png)\n\nSince the line $x=2$ is a vertical line, the shortest distance between this line and the point $(4,3)$ is given by the absolute value of the difference between the $x$-coordinate of the point and $2.$ \n\nSo, the shortest distance is\n\n$$\nd=|4-2|=2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114323/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157"] :knowledge-point/questions ["q-114323"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-74034"] :question/worked-solution "Let's sketch the given situation.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13934287/assets/f907ee8b0bb92792cc69905678210af71088af6731e5a586eaeed0bfc7856b9c.png)\n\nSince the line $y=2$ is a horizontal line, the shortest distance between this line and the point $(5,-1)$ is given by the absolute value of the difference between $y$-coordinate of the point and $2.$ \n\nSo, the shortest distance is\n\n$$\nd=|-1-2|=3.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-74202/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "6f9fd463-2d41-5b93-9a27-d23edcbbf4ef" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-74202/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "63d0a784-836a-57c6-a646-e111b0d9485d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74202/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "b6c01bbc-ec75-5692-b96d-2afd69220b5c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-74202/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "232b6746-6d99-5de2-b1b9-5a25afc28cdd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-74202/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "e41c7aa2-119b-55cd-b769-be3a515c22e0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-74202/selection" :answer-field/id #uuid "7c644a72-fc30-5aee-b7ab-6ee59858c025" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74202/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-74202/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-74202/selection/be9eb51cc2f69