#{[{:db/id #edb/ref 17592186278285 :knowledge-point/_questions [{:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0100fe0-1a63-5601-9980-9bd0257d714f" :answer/type {:db/ident :answer.type/math} :answer/value "60\\,480" :db/id #edb/ref 17592186278287} {:answer/id #uuid "8b82456e-abe5-566b-a3dc-b37a4eb5a9b3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186278288} {:answer/id #uuid "93506760-ae07-5680-b5c0-68f32107e732" :answer/type {:db/ident :answer.type/math} :answer/value "504" :db/id #edb/ref 17592186278289} {:answer/id #uuid "abe71e53-199e-54c6-af67-2843790566a3" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186278290} {:answer/id #uuid "8bbe531b-cbd2-506f-a601-5210d8cb4132" :answer/type {:db/ident :answer.type/math} :answer/value "729" :db/id #edb/ref 17592186278291}] :answer-field/correct {:answer/id #uuid "93506760-ae07-5680-b5c0-68f32107e732" :answer/type {:db/ident :answer.type/math} :answer/value "504" :db/id #edb/ref 17592186278289} :answer-field/id #uuid "5ee13080-4c4c-5d83-898a-bac9342f2917" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278286}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "389845c9-f18b-5fa8-a95e-85a428c5db03" :question/math-academy-id "q-122228" :question/problem "A store manager is choosing $3$ employees to do the morning, afternoon, and night shifts. If the store has $9$ employees and each can work a single shift, how many ways of choosing the $3$ employees does the manager have?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $9$ employees to choose from, so $n=9.$ We want to select $3$ of them for the three different shifts, so we have $r=3.$ \n\nTherefore, the number of different choices is\n\n$$\n\\begin{aligned}{}_{9}{P}_{3} & =\\frac{9!}{(9-3)!} \\\\  & =\\frac{9!}{6!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{\\cancel{6!}} \\\\  & =9\\cdot 8\\cdot 7 \\\\  & =504.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278292 :knowledge-point/_questions [{:knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac9e41a-922a-59e1-bf55-81f088a42ae1" :answer/type {:db/ident :answer.type/math} :answer/value "32\\,760" :db/id #edb/ref 17592186278294} {:answer/id #uuid "eed9cd0f-de0e-578f-8189-c191f172b824" :answer/type {:db/ident :answer.type/math} :answer/value "360\\,360" :db/id #edb/ref 17592186278295} {:answer/id #uuid "800e9c6b-c175-52a6-85a9-f2149ca061f8" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,024" :db/id #edb/ref 17592186278296} {:answer/id #uuid "4a4ac19f-9fcd-538e-98cd-e7d7a270ea62" :answer/type {:db/ident :answer.type/math} :answer/value "759\\,375" :db/id #edb/ref 17592186278297} {:answer/id #uuid "a7b7d641-741c-5ad3-a7e1-1e22a9380984" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186278298}] :answer-field/correct {:answer/id #uuid "eed9cd0f-de0e-578f-8189-c191f172b824" :answer/type {:db/ident :answer.type/math} :answer/value "360\\,360" :db/id #edb/ref 17592186278295} :answer-field/id #uuid "1225daf8-ecfa-5258-ac0b-5c5e375249fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278293}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3a17faf1-2bcf-5207-a24d-54b14bb6a7d9" :question/math-academy-id "q-122480" :question/problem "A chocolate box has $15$ different chocolates. In how many ways can $5$ chocolates be eaten in a row?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $15$ chocolates, so $n=15.$ We want to select $5$ of those chocolates in a row so we have $r=5.$\n\nTherefore, the number of possible choices is\n\n$$\n\\begin{aligned}{}_{15}{P}_{5} & =\\frac{15!}{(15-5)!} \\\\  & =\\frac{15!}{10!} \\\\  & =\\frac{15\\cdot 14\\cdot 13\\cdot 12\\cdot 11\\cdot \\cancel{10!}}{\\cancel{10!}} \\\\  & =15\\cdot 14\\cdot 13\\cdot 12\\cdot 11 \\\\  & =360\\,360.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278299 :knowledge-point/_questions [{:knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d8a1627-76a0-579b-90f9-35ff008ce7ca" :answer/type {:db/ident :answer.type/math} :answer/value "132" :db/id #edb/ref 17592186278301} {:answer/id #uuid "3f88ff53-d6e2-5576-8920-71ed5f3802b3" :answer/type {:db/ident :answer.type/math} :answer/value "110" :db/id #edb/ref 17592186278302} {:answer/id #uuid "4dc43d6b-06cb-53e6-8dd7-91303be0e095" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186278303} {:answer/id #uuid "3c94d3d8-0001-5be1-be4f-5e114c483f65" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,728" :db/id #edb/ref 17592186278304} {:answer/id #uuid "51d857b5-47c7-5aad-b3f2-e3c8b23f2d3b" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186278305}] :answer-field/correct {:answer/id #uuid "51d857b5-47c7-5aad-b3f2-e3c8b23f2d3b" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186278305} :answer-field/id #uuid "9bae9fb3-9936-55b8-9597-f8cc98329460" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278300}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b082736c-b909-597a-96a3-16fb8a4a7ea4" :question/math-academy-id "q-122482" :question/problem "Mary has twelve different types of fruits. If she wants to choose three fruits without repetition, one for breakfast, one for lunch, and one for dinner, how many possible permutations of fruits does she have to choose from?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $12$ pieces of fruit, so $n=12.$ We want to select $3$ of those fruits so we have $r=3.$\n\nTherefore, the number of possible choices is\n\n$$\n\\begin{aligned}{}_{12}{P}_{3} & =\\frac{12!}{(12-3)!} \\\\  & =\\frac{12!}{9!} \\\\  & =\\frac{12\\cdot 11\\cdot 10\\cdot \\cancel{9!}}{\\cancel{9!}} \\\\  & =12\\cdot 11\\cdot 10 \\\\  & =1\\,320.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083482 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daa96f5a-272a-5083-ae18-a2f45cfbf76f" :answer/type {:db/ident :answer.type/math} :answer/value "51820" :db/id #edb/ref 17592186080223} {:answer/id #uuid "2a2fb398-d1ed-525d-9632-00d79ce48ad0" :answer/type {:db/ident :answer.type/math} :answer/value "28410" :db/id #edb/ref 17592186080224} {:answer/id #uuid "4383fd96-dd22-5ba3-a4c3-ab91aaa47551" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186080225} {:answer/id #uuid "43aa67da-0d77-5881-b514-101862547f73" :answer/type {:db/ident :answer.type/math} :answer/value "1365" :db/id #edb/ref 17592186080226} {:answer/id #uuid "595a2274-81fb-5635-a773-c34cf755d6e4" :answer/type {:db/ident :answer.type/math} :answer/value "32760" :db/id #edb/ref 17592186080227}] :answer-field/correct {:answer/id #uuid "595a2274-81fb-5635-a773-c34cf755d6e4" :answer/type {:db/ident :answer.type/math} :answer/value "32760" :db/id #edb/ref 17592186080227} :answer-field/id #uuid "23552c37-78fa-5adf-b4c4-e1abadb1bfda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080222}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "19bc6957-d170-5412-80aa-cd50c7d03c4c" :question/math-academy-id "q-1783" :question/problem "$P(15,4)=$" :question/requires-calculator true :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(15,4)$ means the same thing as ${}_{15}{P}_{4}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(15,4) & =\\frac{15!}{(15-4)!} \\\\  & =\\frac{15!}{11!} \\\\  & =\\frac{15\\cdot 14\\cdot 13\\cdot 12\\cdot \\cancel{11!}}{\\cancel{11!}} \\\\  & =15\\cdot 14\\cdot 13\\cdot 12 \\\\  & =32\\,760.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278306 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b122e5e-385c-5af1-9e95-df64eebb6995" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186278308} {:answer/id #uuid "c3f02217-1147-59ae-8ab3-b50d6aa085e5" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186278309} {:answer/id #uuid "94da1d85-645c-5fe0-94fd-ebe7934c5546" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186278310} {:answer/id #uuid "e5278961-de9d-53e8-b8fb-d02661d22795" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186278311} {:answer/id #uuid "a3b2f195-d613-5d94-b596-c29cd89670a1" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186278312}] :answer-field/correct {:answer/id #uuid "c3f02217-1147-59ae-8ab3-b50d6aa085e5" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186278309} :answer-field/id #uuid "a1c98b60-6e20-54d3-8121-6c6921cb7a03" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278307}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "afe6f4b2-1954-5d6f-b4fd-a70326aa15b6" :question/math-academy-id "q-5375" :question/problem "Evaluate $P(5,3).$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(5,3)$ means the same thing as ${}_{5}{P}_{3}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(5,3) & =\\frac{5!}{(5-3)!} \\\\  & =\\frac{5!}{2!} \\\\  & =\\frac{5\\cdot 4\\cdot 3\\cdot \\cancel{2!}}{\\cancel{2!}} \\\\  & =5\\cdot 4\\cdot 3 \\\\  & =60.\\end{aligned}\n$$"}]}
