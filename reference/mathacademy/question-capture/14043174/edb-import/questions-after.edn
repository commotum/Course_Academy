-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28024be1-e60c-52c4-8be3-e113dd2ae063" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186320520}] :answer-field/correct {:answer/id #uuid "28024be1-e60c-52c4-8be3-e113dd2ae063" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186320520} :answer-field/id #uuid "d5211f76-1319-5e68-9c3c-3c3c02052df9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320519}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "79b88d55-66e2-53f6-b61e-729c93ab168f" :question/math-academy-id "q-317312" :question/problem "Let $a=⟨2,-1,3⟩$, $b=⟨0,4,1⟩$ and $c=⟨-2,1,5⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}2 & -1 & 3 \\\\ 0 & 4 & 1 \\\\ -2 & 1 & 5\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}4 & 1 \\\\ 1 & 5\\end{aligned}|\\,-\\,(-1)\\cdot |\\begin{aligned}0 & 1 \\\\ -2 & 5\\end{aligned}|\\,+\\,3\\cdot |\\begin{aligned}0 & 4 \\\\ -2 & 1\\end{aligned}| \\\\  & =2\\,(4\\cdot 5-1\\cdot 1)\\,-\\,(-1)\\,(0\\cdot 5-1\\cdot (-2))\\,+\\,3\\,(0\\cdot 1-4\\cdot (-2)) \\\\  & =2\\,(19)\\,-\\,(-1)\\,(2)\\,+\\,3\\,(8) \\\\  & =38+2+24 \\\\  & =64.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320521 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e25707d-29d4-5b02-a14f-55bfafd7aae3" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186320523}] :answer-field/correct {:answer/id #uuid "0e25707d-29d4-5b02-a14f-55bfafd7aae3" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186320523} :answer-field/id #uuid "035c26d1-e476-54e3-81a9-2efec90d74f3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320522}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4d5ac22a-d2ea-5551-a038-9b2a5e99fb58" :question/math-academy-id "q-317316" :question/problem "Let $a=⟨0,2,5⟩$, $b=⟨3,1,0⟩$ and $c=⟨4,-1,-2⟩.$ Find $a\\cdot (b\\times c)$ using a determinant.\n\n$a\\cdot (b\\times c)=$\n{{field-1}}" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}0 & 2 & 5 \\\\ 3 & 1 & 0 \\\\ 4 & -1 & -2\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}1 & 0 \\\\ -1 & -2\\end{aligned}|\\,-\\,2\\cdot |\\begin{aligned}3 & 0 \\\\ 4 & -2\\end{aligned}|\\,+\\,5\\cdot |\\begin{aligned}3 & 1 \\\\ 4 & -1\\end{aligned}| \\\\  & =0\\,(1\\cdot (-2)-0\\cdot (-1))\\,-\\,2\\,(3\\cdot (-2)-0\\cdot 4)\\,+\\,5\\,(3\\cdot (-1)-1\\cdot 4) \\\\  & =0(-2)\\,-\\,2\\,(-6)\\,+\\,5\\,(-7) \\\\  & =0+12-35 \\\\  & =-23.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320524 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d50ad68-816f-572e-8949-8d9d589d732c" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186320526} {:answer/id #uuid "03cbecf2-35d0-52fc-8bac-82478409f037" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186320527} {:answer/id #uuid "d48bfb0b-5827-5081-8b15-f6364120b40d" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186320528} {:answer/id #uuid "c17e8fa2-7bef-5bff-b3fc-776b1483bc5d" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186320529} {:answer/id #uuid "5003ffc7-63f1-5367-b3ad-3f386ee6bc7d" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186320530}] :answer-field/correct {:answer/id #uuid "5003ffc7-63f1-5367-b3ad-3f386ee6bc7d" :answer/type {:db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186320530} :answer-field/id #uuid "f54c99f4-44c8-58cb-ade9-1afcce4aae47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320525}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "56a67151-433c-536b-a8d9-272b277f7ee7" :question/math-academy-id "q-73462" :question/problem "Let $p=⟨3,1,2⟩$, $q=⟨1,-2,1⟩$ and $r=⟨4,1,-2⟩.$ Find $r\\cdot (q\\times p).$" :question/worked-solution "Remember that the scalar triple product $r\\cdot (q\\times p)$ is just the determinant of the matrix whose rows are given by $r,$ $q,$ and $p.$\n\nSo, we have\n\n$$\n\\begin{aligned}r\\cdot (q\\times p) & =|\\begin{aligned}4 & 1 & -2 \\\\ 1 & -2 & 1 \\\\ 3 & 1 & 2\\end{aligned}| \\\\  & =4\\cdot |\\begin{aligned}-2 & 1 \\\\ 1 & 2\\end{aligned}|-1\\cdot |\\begin{aligned}1 & 1 \\\\ 3 & 2\\end{aligned}|+(-2)\\cdot |\\begin{aligned}1 & -2 \\\\ 3 & 1\\end{aligned}| \\\\  & =4((-2)\\cdot 2-1\\cdot 1)-(1\\cdot 2-1\\cdot 3)-2(1\\cdot 1-(-2)\\cdot 3) \\\\  & =-20+1-14 \\\\  & =-33.\\end{aligned}\n$$"}]}
