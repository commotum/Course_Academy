593 true] [17592186297681 1000 #edb/ref 17592186297684 13194139534593 true] [17592186297681 1000 #edb/ref 17592186297685 13194139534593 true] [17592186297681 1000 #edb/ref 17592186297686 13194139534593 true] [17592186297681 1040 #edb/ref 17592186045450 13194139534593 true] [17592186297681 1041 "selection" 13194139534593 true] [17592186297681 1104 #edb/ref 17592186297686 13194139534593 true] [17592186297681 1110 #uuid "8bc95c14-4898-571a-80df-1582d6d786d3" 13194139534593 true] [17592186297682 1034 "140" 13194139534593 true] [17592186297682 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297682 1111 #uuid "7d14424d-565b-5b23-89b2-08423569d234" 13194139534593 true] [17592186297683 1034 "210" 13194139534593 true] [17592186297683 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297683 1111 #uuid "168d5466-bfa8-5062-a823-014719696674" 13194139534593 true] [17592186297684 1034 "6" 13194139534593 true] [17592186297684 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297684 1111 #uuid "9c44cda1-3493-514f-9b1b-150e0040bbed" 13194139534593 true] [17592186297685 1034 "42" 13194139534593 true] [17592186297685 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297685 1111 #uuid "f2a16ac0-1eba-5fc4-9e03-5d9f85c3c976" 13194139534593 true] [17592186297686 1034 "840" 13194139534593 true] [17592186297686 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297686 1111 #uuid "2e864f98-f1ff-50f0-b40e-0fdf6506d97e" 13194139534593 true] [17592186297687 1017 #edb/ref 17592186297688 13194139534593 true] [17592186297687 1089 "q-5570" 13194139534593 true] [17592186297687 1091 #edb/ref 17592186045463 13194139534593 true] [17592186297687 1100 "Cheryl holds a bag of $40$ marbles, each one with a slightly different size or color. If she picks $5$ of them out one at a time and lines up in a row, how many different lines of $5$ marbles are possible?" 13194139534593 true] [17592186297687 1113 #uuid "9b6ce883-6a1c-54f4-85a1-b5c70b81dd2b" 13194139534593 true] [17592186297687 1145 "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $40$ marbles to choose from, so $n=40.$ We want to select $5$ of those marbles for the line, so we have $r=5.$ \n\nTherefore, the number of different ways to line up $5$ marbles is \n\n$$\n\\begin{aligned}{}_{40}{P}_{5} & =\\frac{40!}{(40-5)!} \\\\  & =\\frac{40!}{35!} \\\\  & =\\frac{40\\cdot 39\\cdot 38\\cdot 37\\cdot 36\\cdot \\cancel{35!}}{\\cancel{35!}} \\\\  & =40\\cdot 39\\cdot 38\\cdot 37\\cdot 36 \\\\  & =78\\,960\\,960.\\end{aligned}\n$$" 13194139534593 true] [17592186297688 1000 #edb/ref 17592186297689 13194139534593 true] [17592186297688 1000 #edb/ref 17592186297690 13194139534593 true] [17592186297688 1000 #edb/ref 17592186297691 13194139534593 true] [17592186297688 1000 #edb/ref 17592186297692 13194139534593 true] [17592186297688 1000 #edb/ref 17592186297693 13194139534593 true] [17592186297688 1040 #edb/ref 17592186045450 13194139534593 true] [17592186297688 1041 "selection" 13194139534593 true] [17592186297688 1104 #edb/ref 17592186297689 13194139534593 true] [17592186297688 1110 #uuid "d9982222-50bc-5805-8142-d9ad691ff7b8" 13194139534593 true] [17592186297689 1034 "78\\,960\\,960" 13194139534593 true] [17592186297689 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297689 1111 #uuid "23f86d5b-2b14-53d9-ae12-49bdedf0a0f5" 13194139534593 true] [17592186297690 1034 "780\\,560" 13194139534593 true] [17592186297690 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297690 1111 #uuid "7b688ff6-313e-579d-89d1-f792da846ef0" 13194139534593 true] [17592186297691 1034 "120\\,450" 13194139534593 true] [17592186297691 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297691 1111 #uuid "b532ab23-14d8-5d0f-a14a-9007ddf447d4" 13194139534593 true] [17592186297692 1034 "24\\,670\\,820" 13194139534593 true] [17592186297692 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297692 1111 #uuid "ee3c114f-ad25-5718-be84-b8aa1114c94c" 13194139534593 true] [17592186297693 1034 "4\\,320\\,560" 13194139534593 true] [17592186297693 1103 #edb/ref 17592186045453 13194139534593 true] [17592186297693 1111 #uuid "80a80e64-4557-5e6a-b0e2-5744154036d5" 13194139534593 true] [17592186297694 1017 #edb/ref 17592186297695 13194139534593 true] [17592186297694 1089 "q-84982" 13194139534593 true] [17592186297694 1091 #edb/ref 17592186045463 13194139534593 true] [17592186297694 1100 "Victoria has the $4$ playing cards: the ace of clubs, the ace of diamonds, the ace of hearts, and the ace of spades. She takes one card and places it in front of her. She then does the same with another card. In how many different ways can she choose a sequence of $2$ cards like this?" 13194139534593 true] [17592186297694 1113 #uuid "363fcae3-7e0b-5312-965c-3a586d93b119" 13194139534593 true] [17592186297694 1145 "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $4$ cards, so $n=4.$ We want to select $2$ of those cards to make a sequence of $2$ cards, so we have $r=2.$ \n\nTherefore, the number of different ways to choose the cards is \n\n$$\n\\begin{aligned}{}_{4}{P}_{2} & =\\frac{4!}{(4-2)!} \\\\  & =\\frac{4!}{2!} \\\\  & =\\frac{4\\cdot 3\\cdot \\cancel{2!}}{\\cancel{2!}} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$" 13194139534593 true] [17592186297695 1000 #edb/ref 17592186297696 13194139534593 true] [17592186297695 1000 #edb/ref 17592186297697 13194139534593 true] [17592186297695 1000 #edb/ref 17592186297698 13194139534593 true] [17592186297695 1000 #edb/ref 17592186297699 13194139534593 true] [17592186297695 1000 #edb/ref 17592186297700 13194139534593 true] [17592186297695 1040 #edb/ref 17592186045450 13194139534593 true] [17592186297695 1041 "selection" 13194139534593 true] [17592186297695 1104 #edb/ref 17592186297696 13194139534593 true] [17592186297695 1110 #uuid "a7