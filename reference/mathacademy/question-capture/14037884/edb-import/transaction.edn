q-5564" :question/problem "Evaluate $P(7,4).$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(7,4)$ means the same thing as ${}_{7}{P}_{4}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(7,4) & =\\frac{7!}{(7-4)!} \\\\  & =\\frac{7!}{3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =840.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-5564/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6"] :knowledge-point/questions ["q-5564"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5570/selection/ff6eff85091cb77b58b636113080639abde0a63ee4078c7285938e38babaa11b" :answer/id #uuid "ee3c114f-ad25-5718-be84-b8aa1114c94c" :answer/type :answer.type/math :answer/value "24\\,670\\,820" :db/ensure [:answer/validate]} {:db/id "q-5570/selection/8fa104c5ca6e6690bf197de3fb9f37cc4e9eed813f908d1540d50332c50dec58" :answer/id #uuid "b532ab23-14d8-5d0f-a14a-9007ddf447d4" :answer/type :answer.type/math :answer/value "120\\,450" :db/ensure [:answer/validate]} {:db/id "q-5570/selection/46bd3b055fa983502e31b7be42b968a4a37e8d5f0239491ce407ab26e196a3e4" :answer/id #uuid "23f86d5b-2b14-53d9-ae12-49bdedf0a0f5" :answer/type :answer.type/math :answer/value "78\\,960\\,960" :db/ensure [:answer/validate]} {:db/id "q-5570/selection/fffd96ac4cb86600db88077d8063f20f34e3f7523f5bb657e25514f519e070a6" :answer/id #uuid "80a80e64-4557-5e6a-b0e2-5744154036d5" :answer/type :answer.type/math :answer/value "4\\,320\\,560" :db/ensure [:answer/validate]} {:db/id "q-5570/selection/5814b38b964c25e67f8f2cd82bea5667d1f3b4f9d5e3595cb0647c2e8c10bdc6" :answer/id #uuid "7b688ff6-313e-579d-89d1-f792da846ef0" :answer/type :answer.type/math :answer/value "780\\,560" :db/ensure [:answer/validate]} {:db/id "q-5570/selection" :answer-field/id #uuid "d9982222-50bc-5805-81