#{[{:db/id #edb/ref 17592186297673 :knowledge-point/_questions [{:knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af9d7bec-fb51-585a-a11c-6f8d7f7195df" :answer/type {:db/ident :answer.type/math} :answer/value "255\\,024" :db/id #edb/ref 17592186297675} {:answer/id #uuid "1ca5ca74-2e71-5657-a772-b4366e65d08f" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,144" :db/id #edb/ref 17592186297676} {:answer/id #uuid "b7ae15ba-ad99-5e39-8f3f-54252c182bec" :answer/type {:db/ident :answer.type/math} :answer/value "13\\,824" :db/id #edb/ref 17592186297677} {:answer/id #uuid "f6411999-5d0f-59aa-9a40-48026a7dbe43" :answer/type {:db/ident :answer.type/math} :answer/value "552" :db/id #edb/ref 17592186297678} {:answer/id #uuid "a890417c-d8fe-56ae-b3bd-e9a9b00c7f10" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186297679}] :answer-field/correct {:answer/id #uuid "1ca5ca74-2e71-5657-a772-b4366e65d08f" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,144" :db/id #edb/ref 17592186297676} :answer-field/id #uuid "0edcfe88-c20c-5467-a310-658442ceea29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297674}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a016216d-8f23-59da-bb6c-067b39c3dc00" :question/math-academy-id "q-122479" :question/problem "Erik has an encyclopedia with $24$ tomes and is selecting $3$ tomes to read first, second, and third. How many different choices does Erik have?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $24$ tomes to choose from, so $n=24.$ We want to select $3$ of those tomes for Erik to read, so we have $r=3.$\n\nTherefore, the number of choices Erik has is\n\n$$\n\\begin{aligned}{}_{24}{P}_{3} & =\\frac{24!}{(24-3)!} \\\\  & =\\frac{24!}{21!} \\\\  & =\\frac{24\\cdot 23\\cdot 22\\cdot \\cancel{21!}}{\\cancel{21!}} \\\\  & =24\\cdot 23\\cdot 22 \\\\  & =12\\,144.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297680 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d14424d-565b-5b23-89b2-08423569d234" :answer/type {:db/ident :answer.type/math} :answer/value "140" :db/id #edb/ref 17592186297682} {:answer/id #uuid "168d5466-bfa8-5062-a823-014719696674" :answer/type {:db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186297683} {:answer/id #uuid "9c44cda1-3493-514f-9b1b-150e0040bbed" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297684} {:answer/id #uuid "f2a16ac0-1eba-5fc4-9e03-5d9f85c3c976" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186297685} {:answer/id #uuid "2e864f98-f1ff-50f0-b40e-0fdf6506d97e" :answer/type {:db/ident :answer.type/math} :answer/value "840" :db/id #edb/ref 17592186297686}] :answer-field/correct {:answer/id #uuid "2e864f98-f1ff-50f0-b40e-0fdf6506d97e" :answer/type {:db/ident :answer.type/math} :answer/value "840" :db/id #edb/ref 17592186297686} :answer-field/id #uuid "8bc95c14-4898-571a-80df-1582d6d786d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297681}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "18c7688a-761e-573c-aee1-10ea3de936ea" :question/math-academy-id "q-5564" :question/problem "Evaluate $P(7,4).$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(7,4)$ means the same thing as ${}_{7}{P}_{4}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(7,4) & =\\frac{7!}{(7-4)!} \\\\  & =\\frac{7!}{3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3!}} \\\\  & =840.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297687 :knowledge-point/_questions [{:knowledge-point/id #uuid "256d3a08-0ade-51e9-887b-67250d5fae21" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group of at Least Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23f86d5b-2b14-53d9-ae12-49bdedf0a0f5" :answer/type {:db/ident :answer.type/math} :answer/value "78\\,960\\,960" :db/id #edb/ref 17592186297689} {:answer/id #uuid "7b688ff6-313e-579d-89d1-f792da846ef0" :answer/type {:db/ident :answer.type/math} :answer/value "780\\,560" :db/id #edb/ref 17592186297690} {:answer/id #uuid "b532ab23-14d8-5d0f-a14a-9007ddf447d4" :answer/type {:db/ident :answer.type/math} :answer/value "120\\,450" :db/id #edb/ref 17592186297691} {:answer/id #uuid "ee3c114f-ad25-5718-be84-b8aa1114c94c" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,670\\,820" :db/id #edb/ref 17592186297692} {:answer/id #uuid "80a80e64-4557-5e6a-b0e2-5744154036d5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,320\\,560" :db/id #edb/ref 17592186297693}] :answer-field/correct {:answer/id #uuid "23f86d5b-2b14-53d9-ae12-49bdedf0a0f5" :answer/type {:db/ident :answer.type/math} :answer/value "78\\,960\\,960" :db/id #edb/ref 17592186297689} :answer-field/id #uuid "d9982222-50bc-5805-8142-d9ad691ff7b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297688}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9b6ce883-6a1c-54f4-85a1-b5c70b81dd2b" :question/math-academy-id "q-5570" :question/problem "Cheryl holds a bag of $40$ marbles, each one with a slightly different size or color. If she picks $5$ of them out one at a time and lines up in a row, how many different lines of $5$ marbles are possible?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $40$ marbles to choose from, so $n=40.$ We want to select $5$ of those marbles for the line, so we have $r=5.$ \n\nTherefore, the number of different ways to line up $5$ marbles is \n\n$$\n\\begin{aligned}{}_{40}{P}_{5} & =\\frac{40!}{(40-5)!} \\\\  & =\\frac{40!}{35!} \\\\  & =\\frac{40\\cdot 39\\cdot 38\\cdot 37\\cdot 36\\cdot \\cancel{35!}}{\\cancel{35!}} \\\\  & =40\\cdot 39\\cdot 38\\cdot 37\\cdot 36 \\\\  & =78\\,960\\,960.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297694 :knowledge-point/_questions [{:knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47e98aef-3275-5c71-9a4f-f9ed6fc8f9ef" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186297696} {:answer/id #uuid "e4ddec9e-19c3-5d9f-a932-a3ffc0f5cf9b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186297697} {:answer/id #uuid "52dac4bd-beb6-5bf2-87e3-f31174978238" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186297698} {:answer/id #uuid "d59b0054-9467-568a-a73e-e01eed80194c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186297699} {:answer/id #uuid "229ee9f7-33e7-50b2-a488-4127691f0f86" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186297700}] :answer-field/correct {:answer/id #uuid "47e98aef-3275-5c71-9a4f-f9ed6fc8f9ef" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186297696} :answer-field/id #uuid "a74b600e-14a6-520b-bff3-159964e7f630" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297695}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "363fcae3-7e0b-5312-965c-3a586d93b119" :question/math-academy-id "q-84982" :question/problem "Victoria has the $4$ playing cards: the ace of clubs, the ace of diamonds, the ace of hearts, and the ace of spades. She takes one card and places it in front of her. She then does the same with another card. In how many different ways can she choose a sequence of $2$ cards like this?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $4$ cards, so $n=4.$ We want to select $2$ of those cards to make a sequence of $2$ cards, so we have $r=2.$ \n\nTherefore, the number of different ways to choose the cards is \n\n$$\n\\begin{aligned}{}_{4}{P}_{2} & =\\frac{4!}{(4-2)!} \\\\  & =\\frac{4!}{2!} \\\\  & =\\frac{4\\cdot 3\\cdot \\cancel{2!}}{\\cancel{2!}} \\\\  & =4\\cdot 3 \\\\  & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297701 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddb1fbd2-8e84-54ab-a5e5-f9d37a424ad7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297703} {:answer/id #uuid "1584ed59-0292-55f8-afda-7ff63e3b3ee4" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186297704} {:answer/id #uuid "3a9a1d13-715c-5d8c-989e-b4275f616b59" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297705} {:answer/id #uuid "7cfa82a6-efa8-59cf-9841-f2c4b4e19d53" :answer/type {:db/ident :answer.type/math} :answer/value "450" :db/id #edb/ref 17592186297706} {:answer/id #uuid "0abbc190-82b9-5ddb-a1e8-2c0d3110631d" :answer/type {:db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186297707}] :answer-field/correct {:answer/id #uuid "ddb1fbd2-8e84-54ab-a5e5-f9d37a424ad7" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186297703} :answer-field/id #uuid "de18ceca-b5c4-5520-a157-371dff42c8f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297702}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d82adc41-e9a0-5b1a-b7a2-4072c811b801" :question/math-academy-id "q-85048" :question/problem "$P(45,0)=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(45,0)$ means the same thing as ${}_{45}{P}_{0}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(45,0) & =\\frac{45!}{(45-0)!} \\\\  & =\\frac{\\cancel{45!}}{\\cancel{45!}} \\\\  & =1.\\end{aligned}\n$$"}]}
