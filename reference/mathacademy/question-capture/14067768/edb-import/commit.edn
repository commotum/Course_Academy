0da-8298-0c30e47654fc" 13194139535567 true] [17592186355453 1145 "Since $r(\\theta )$ represents the distance of each point on the circle from the origin, the average distance is given by\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{[\\frac{\\pi }{2}-(-\\frac{\\pi }{2})]}{\\int }_{-\\pi /2}^{\\pi /2}6\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{1}{\\pi }(6\\operatorname{sin}⁡\\theta ){|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{\\pi }(6\\operatorname{sin}⁡(\\frac{\\pi }{2})-6\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{1}{\\pi }(6-(-6)) \\\\  & =\\frac{12}{\\pi }.\\end{aligned}\n$$" 13194139535567 true] [17592186355454 1000 #edb/ref 17592186355455 13194139535567 true] [17592186355454 1040 #edb/ref 17592186045449 13194139535567 true] [17592186355454 1041 "field-1" 13194139535567 true] [17592186355454 1104 #edb/ref 17592186355455 13194139535567 true] [17592186355454 1110 #uuid "7e6a6e29-11a5-5f97-b543-9b95e8daac1c" 13194139535567 true] [17592186355455 1034 "\\frac{12}{\\pi}" 13194139535567 true] [17592186355455 1103 #edb/ref 17592186045453 13194139535567 true] [17592186355455 1111 #uuid "b9fd2b99-3667-54f4-8886-9aa4d105277c" 13194139535567 true]] :edb/tempids {"q-167932" 17592186355432 "q-167932/field-1" 17592186355433 "q-167932/field-1/7c1b252a4cf04e882d7dfd9d513b0d85957e7f128a46858c508e81e4895defc9" 17592186355434 "q-167933" 17592186355435 "q-167933/field-1" 17592186355436 "q-167933/field-1/deeb614aae59c25afab30a875bf72c636d03f32a07e8791b1e42a634b53c8b72" 17592186355437 "q-167933/field-2" 17592186355438 "q-167933/field-2/dcb885435d5fe0001fee88ba00ae264f8ad40429eb6089a98fe15d57c5eee02e" 17592186355439 "q-167934" 17592186355440 "q-167934/field-1" 17592186355441 "q-167934/field-1/eb5e1cf44333e10ac3cbcf535904fae1ac294e2946394a1e4ef16804195c1090" 17592186355442 "q-167935" 17592186355443 "q-167935/field-1" 17592186355444 "q-167935/field-1/9982db5bff9549a4a168b1516c5652c57c16e506a4911d6c644dd5a473497831" 17592186355445 "q-167935/fiel