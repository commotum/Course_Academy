#{[{:db/id #edb/ref 17592186059426 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/id #uuid "31b9e2d8-1458-50b3-a920-703476825420" :question/is-example true :question/math-academy-id "e-3631" :question/problem "Find the derivative of $y = 3\\cos x + 4\\sin x + 2x^3$." :question/worked-solution "We know that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\sin x) = \\cos x\n$$\n\nand that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\cos x) = -\\sin x\n$$\n\nApplying these formulas, we have\n\n$$\n\\begin{aligned}\n\\frac{dy}{dx} &= \\frac{d}{dx}(3\\cos x + 4\\sin x + 2x^{3}) \\\\\n&= 3\\frac{d}{dx}(\\cos x) + 4\\frac{d}{dx}(\\sin x) + 2\\frac{d}{dx}(x^{3}) \\\\\n&=-3\\sin x + 4\\cos x + 2(3)x^{2} \\\\\n&=-3\\sin x + 4\\cos x + 6x^{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059427 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/id #uuid "ae922c00-2ff5-5a46-805a-62955bc5a08a" :question/is-example true :question/math-academy-id "e-3632" :question/problem "Find the slope of $y = 4\\tan x + 5x$ at $x = 0$." :question/worked-solution "The slope at $x=0$ is given by the value of the derivative $y'$ at $x=0$.\n\nFirst, we compute the derivative, using the fact that\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x} (\\tan x) = \\sec^2 x\n$$\n\nWe get\n\n$$\n\\begin{aligned}\ny^{′}(x) &= \\frac{d}{dx}(4\\tan x + 5x) \\\\\n&= 4\\sec^{2} x + 5\n\\end{aligned}\n$$\n\nEvaluating at $x=0$, we get\n\n$$\n\\begin{aligned}\ny^{′}(0) &= 4\\sec^{2} 0 + 5 \\\\\n&= 4 \\cdot 1 + 5 \\\\\n&= 9\n\\end{aligned}\n$$\n\nTherefore, the slope is $9$."}] [{:db/id #edb/ref 17592186244844 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6fef930-ce94-5334-8f1c-aa81a390501e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186244846} {:answer/id #uuid "d6e8fc17-5ede-5d63-8a4b-e210a05c5c58" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186244847} {:answer/id #uuid "f88f150a-535a-55bc-a3bc-32d8a4c7ca90" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186244848} {:answer/id #uuid "19827c60-e76e-55c1-9b0d-4e3361f3e24c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244849} {:answer/id #uuid "ed1b1f97-6292-577a-964a-cc2d263f2c66" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186244850}] :answer-field/correct {:answer/id #uuid "19827c60-e76e-55c1-9b0d-4e3361f3e24c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244849} :answer-field/id #uuid "d0270ad2-14de-59b0-917d-f57d47185e0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244845}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "24aac0fa-ecfb-54cd-928d-884ec7fb4d08" :question/is-example false :question/math-academy-id "q-17912" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=-tan⁡x$ when $x=\\pi .$" :question/worked-solution "The instantaneous rate of change  when $x=\\pi $ is given by the value of the derivative ${f}^{′}(x)$ at $x=\\pi .$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-tan⁡x) \\\\  & =-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\pi ,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =-{sec}^{2}⁡\\pi  \\\\  & =-1\\cdot (-1)^{2} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,  the instantaneous rate of change is $-1.$"}] [{:db/id #edb/ref 17592186244851 :knowledge-point/_questions [{:knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b98984b-f56c-5168-b7db-a8899eccf092" :answer/type {:db/ident :answer.type/math} :answer/value "2cos⁡x-4sin⁡x" :db/id #edb/ref 17592186244853} {:answer/id #uuid "b9f13c7c-7ce2-5dc1-bc01-e7abded1f4f9" :answer/type {:db/ident :answer.type/math} :answer/value "-4cos⁡x-2sin⁡x" :db/id #edb/ref 17592186244854} {:answer/id #uuid "e5a95266-03b6-56db-85b5-86052ed57ac2" :answer/type {:db/ident :answer.type/math} :answer/value "2cos⁡x+4sin⁡x" :db/id #edb/ref 17592186244855} {:answer/id #uuid "38a2640b-0a6d-5617-bffa-be1af541ed40" :answer/type {:db/ident :answer.type/math} :answer/value "4cos⁡x+2sin⁡x" :db/id #edb/ref 17592186244856} {:answer/id #uuid "64e3676a-7725-5311-ab4c-fcb74325cd9d" :answer/type {:db/ident :answer.type/math} :answer/value "4cos⁡x-2sin⁡x" :db/id #edb/ref 17592186244857}] :answer-field/correct {:answer/id #uuid "8b98984b-f56c-5168-b7db-a8899eccf092" :answer/type {:db/ident :answer.type/math} :answer/value "2cos⁡x-4sin⁡x" :db/id #edb/ref 17592186244853} :answer-field/id #uuid "0babbd9b-876f-523c-866b-359f84b1571f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244852}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "7631ba77-4b03-579c-8941-8bc2a0d0d349" :question/is-example false :question/math-academy-id "q-1847" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(4cos⁡x+2sin⁡x)=$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x,$ and that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(4cos⁡x+2sin⁡x) & =4(-sin⁡x)+2(cos⁡x) \\\\  & =2cos⁡x-4sin⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244858 :knowledge-point/_questions [{:knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c796fe0a-543b-5c5a-88c8-9207ad759677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186244860} {:answer/id #uuid "ce945f78-c26d-548f-9390-d2e628cf7a8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{2}" :db/id #edb/ref 17592186244861} {:answer/id #uuid "775ba39f-9d72-5923-b586-c2549f03137c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{21}{6}" :db/id #edb/ref 17592186244862} {:answer/id #uuid "74b762c0-f379-529a-9186-dcad4a68660a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186244863} {:answer/id #uuid "02948418-af43-5474-a7c0-88ffe7ad59a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{5}" :db/id #edb/ref 17592186244864}] :answer-field/correct {:answer/id #uuid "c796fe0a-543b-5c5a-88c8-9207ad759677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186244860} :answer-field/id #uuid "6c045262-f610-57a2-9bd8-11a818f85bed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244859}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0c6b9481-f9e2-5ed1-8bae-4a56b067cb7c" :question/is-example false :question/math-academy-id "q-1900" :question/problem "What is the slope of the tangent line to the curve $y=2x-5cos⁡x$ at the point $x=\\frac{\\pi }{6}?$" :question/worked-solution "The slope at $x=\\frac{\\pi }{6}$ is given by the value of the derivative ${y}^{′}$ at $x=\\frac{\\pi }{6}.$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-5cos⁡x) \\\\  & =2-5(-sin⁡x) \\\\  & =2+5sin⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{6},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(30) & =2+5sin⁡(\\frac{\\pi }{6}) \\\\  & =2+5(\\frac{1}{2}) \\\\  & =2+\\frac{5}{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore,  the instantaneous rate of change is $\\frac{9}{2}.$"}] [{:db/id #edb/ref 17592186244865 :knowledge-point/_questions [{:knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f17a371e-2b3c-5d91-8f89-49ff66c75afa" :answer/type {:db/ident :answer.type/math} :answer/value "12x+sin⁡x" :db/id #edb/ref 17592186244867} {:answer/id #uuid "c04ce12b-f1d7-5970-bce6-46647ad3a5e3" :answer/type {:db/ident :answer.type/math} :answer/value "12x-6sin⁡x" :db/id #edb/ref 17592186244868} {:answer/id #uuid "5eacd0ca-9f60-50af-9e5f-74933217b8ff" :answer/type {:db/ident :answer.type/math} :answer/value "12x+6sin⁡x" :db/id #edb/ref 17592186244869} {:answer/id #uuid "a49d9394-7b0e-57f6-86f1-17de0012ecd0" :answer/type {:db/ident :answer.type/math} :answer/value "6x+6sin⁡x" :db/id #edb/ref 17592186244870} {:answer/id #uuid "6731952a-73be-5d10-b026-039cb8ebec1b" :answer/type {:db/ident :answer.type/math} :answer/value "12x-sin⁡x" :db/id #edb/ref 17592186244871}] :answer-field/correct {:answer/id #uuid "5eacd0ca-9f60-50af-9e5f-74933217b8ff" :answer/type {:db/ident :answer.type/math} :answer/value "12x+6sin⁡x" :db/id #edb/ref 17592186244869} :answer-field/id #uuid "914366ce-ee1a-5a1f-a792-b847e72f0220" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244866}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d3b4c1d1-5611-5cf8-9d73-3b66d7580ab3" :question/is-example false :question/math-academy-id "q-30991" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for $y=6({x}^{2}-cos⁡x)+5.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6({x}^{2}-cos⁡x)+5) \\\\  & =6\\cdot 2x+6sin⁡x+0 \\\\  & =12x+6sin⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244872 :knowledge-point/_questions [{:knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccce87b2-0766-500c-8414-f648f6726d12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\cos(x)+x^3" :db/id #edb/ref 17592186244874}] :answer-field/correct {:answer/id #uuid "ccce87b2-0766-500c-8414-f648f6726d12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\cos(x)+x^3" :db/id #edb/ref 17592186244874} :answer-field/id #uuid "ce2c24aa-31e7-53b2-8b56-7dd94cd85a12" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244873}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "54ef3535-0aa2-5693-b755-d7a098606d17" :question/is-example false :question/math-academy-id "q-341383" :question/problem "Find the derivative of $y=\\frac{5sin⁡x}{4}+\\frac{{x}^{4}}{4}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{5sin⁡x}{4}+\\frac{{x}^{4}}{4}) \\\\  & =\\frac{5}{4}(cos⁡x)+\\frac{1}{4}(4{x}^{3}) \\\\  & =\\frac{5cos⁡x}{4}+{x}^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244875 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bba6895-6436-5723-9758-c63204e1959f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3\\sec(x)^2" :db/id #edb/ref 17592186244877}] :answer-field/correct {:answer/id #uuid "6bba6895-6436-5723-9758-c63204e1959f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{x}}+3\\sec(x)^2" :db/id #edb/ref 17592186244877} :answer-field/id #uuid "d1509a4e-c4bc-569a-be74-614721eda6b5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244876}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5608b24e-7159-5566-90c7-2003d5959623" :question/is-example false :question/math-academy-id "q-341495" :question/problem "Find ${f}^{′}(x)$ if $f(x)=4\\sqrt{x}+3tan⁡x.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\sqrt{x}+3tan⁡x) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+3\\frac{\\text{d}}{\\text{d}x}(tan⁡x) \\\\  & =4(\\frac{1}{2\\sqrt{x}})+3({sec}^{2}⁡x) \\\\  & =\\frac{2}{\\sqrt{x}}+3{sec}^{2}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244878 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d590af61-ad2f-5ece-8675-c834a6a40aa9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186244880}] :answer-field/correct {:answer/id #uuid "d590af61-ad2f-5ece-8675-c834a6a40aa9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186244880} :answer-field/id #uuid "be3de561-fe41-5342-89ad-3e4863540484" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186244879}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c5ceacfb-0eee-5781-840a-3727ebed8da2" :question/is-example false :question/math-academy-id "q-341858" :question/problem "Find the slope of $y=tan⁡x+2sin⁡x$ at $x=0.$\n\n${y}^{′}(0)=$\n{{field-1}}" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x$ and $\\frac{\\text{d}}{\\text{d}x}(sin⁡x)=cos⁡x.$ Applying these formulas, we have\n\n$$\n\\begin{aligned}{y}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(tan⁡x+2sin⁡x) \\\\  & ={sec}^{2}⁡x+2cos⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=0,$ we get\n\n$$\n\\begin{aligned}{y}^{′}(0) & ={sec}^{2}⁡(0)+2cos⁡(0) \\\\  & =1+2(1) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the slope is $3.$"}] [{:db/id #edb/ref 17592186244881 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25563b8c-c2d8-5e58-a3d2-8fa057fb6c74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186244883} {:answer/id #uuid "2a0baabe-ae7f-5ae4-bace-88393bbf2e05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2x{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186244884} {:answer/id #uuid "4e784b8d-2e47-56fe-a421-9ca31b0e81a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}sec⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186244885} {:answer/id #uuid "66b869a7-3f5f-5c20-a6f1-a09bca77b214" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2{sec}^{2}⁡\\sqrt{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186244886} {:answer/id #uuid "4b78b976-a759-5d3f-981f-f3ba7814f912" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186244887}] :answer-field/correct {:answer/id #uuid "4b78b976-a759-5d3f-981f-f3ba7814f912" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186244887} :answer-field/id #uuid "be5a45b8-f4ae-5e9e-a218-613f861e2f56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244882}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "56dc1610-9762-5610-97fa-b88fd7b92784" :question/is-example false :question/math-academy-id "q-47983" :question/problem "Find the derivative of $y=\\sqrt{x}+tan⁡x.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+tan⁡x) \\\\  & =\\frac{1}{2\\sqrt{x}}+{sec}^{2}⁡x \\\\  & =\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244888 :knowledge-point/_questions [{:knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5201f003-795b-5fc7-80f8-192d1fd41ddb" :answer/type {:db/ident :answer.type/math} :answer/value "-2sin⁡x+2{x}^{-3}" :db/id #edb/ref 17592186244890} {:answer/id #uuid "77dd6c43-35bf-51cb-baec-841328101de8" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-1}" :db/id #edb/ref 17592186244891} {:answer/id #uuid "41ab6a6d-5508-547c-8bac-ad02646d319f" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186244892} {:answer/id #uuid "fa359914-30b2-54f0-9eee-b4b65db8cf38" :answer/type {:db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186244893} {:answer/id #uuid "0dc22b82-a476-53f3-917d-b3f3a3e9d1d0" :answer/type {:db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-2}" :db/id #edb/ref 17592186244894}] :answer-field/correct {:answer/id #uuid "41ab6a6d-5508-547c-8bac-ad02646d319f" :answer/type {:db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186244892} :answer-field/id #uuid "659c91d4-7aeb-519a-b6b6-b0af90eb0bad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244889}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d9c245d2-880c-5ada-a406-883320d662eb" :question/is-example false :question/math-academy-id "q-47985" :question/problem "Find the derivative of $y=-2cos⁡x+{x}^{-2}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2cos⁡x+{x}^{-2}) \\\\  & =-2(-sin⁡x)+(-2){x}^{-2-1} \\\\  & =2sin⁡x-2{x}^{-3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244895 :knowledge-point/_questions [{:knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bbd69b0-760f-57f9-b6a8-3a67f53f5d2a" :answer/type {:db/ident :answer.type/math} :answer/value "x-3sec⁡x+4" :db/id #edb/ref 17592186244897} {:answer/id #uuid "59b0a84b-6e9c-52cd-b38d-5817a932349a" :answer/type {:db/ident :answer.type/math} :answer/value "6-3{cos}^{2}⁡x+4" :db/id #edb/ref 17592186244898} {:answer/id #uuid "d64757a4-3edd-5239-bad9-b6f498675ac8" :answer/type {:db/ident :answer.type/math} :answer/value "6x-2{sec}^{2}⁡x" :db/id #edb/ref 17592186244899} {:answer/id #uuid "89f55c8d-d4ea-5d82-8a8d-51c6572f1b87" :answer/type {:db/ident :answer.type/math} :answer/value "6x-6{sec}^{2}⁡x" :db/id #edb/ref 17592186244900} {:answer/id #uuid "1ce04b1a-67a0-5c4b-9487-0d611b5365fe" :answer/type {:db/ident :answer.type/math} :answer/value "3-6{sec}^{2}⁡x" :db/id #edb/ref 17592186244901}] :answer-field/correct {:answer/id #uuid "89f55c8d-d4ea-5d82-8a8d-51c6572f1b87" :answer/type {:db/ident :answer.type/math} :answer/value "6x-6{sec}^{2}⁡x" :db/id #edb/ref 17592186244900} :answer-field/id #uuid "1755f4c0-45c0-50bc-9a55-6c095ea50a9d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186244896}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "8f475d3b-3b5d-58b5-ab78-bda62e9dff0a" :question/is-example false :question/math-academy-id "q-70911" :question/problem "Find ${y}^{′}$ for $y=3({x}^{2}-2tan⁡x)+4.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}(3({x}^{2}-2tan⁡x)+4) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-6tan⁡x+4) \\\\  & =3\\cdot 2x-6{sec}^{2}⁡x+0 \\\\  & =6x-6{sec}^{2}⁡x.\\end{aligned}\n$$"}]}
