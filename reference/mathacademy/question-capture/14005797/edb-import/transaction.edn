[{:db/id "q-68176/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "0c88d18b-fdaa-500c-ae7f-5cb47c717f82" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-68176/selection/fe5a032e59d7fded868435047a730ed7188d990dd7ef43315a6539fb759cc2e5" :answer/id #uuid "0159bfbe-f426-5a9a-b4c8-e933bcc96d0f" :answer/type :answer.type/math :answer/value "x=-5" :db/ensure [:answer/validate]} {:db/id "q-68176/selection/ab0edf9af8508cb55c2c0372bb24a947e0e74ad84a3eccf461ab6b9b1d5efae9" :answer/id #uuid "4857b431-5bf6-528f-a37d-11e49408f724" :answer/type :answer.type/text :answer/value "$x=0$ and $x=-5$" :db/ensure [:answer/validate]} {:db/id "q-68176/selection/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" :answer/id #uuid "7849ded9-dc3a-5af7-adc9-06929cf3bf99" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "q-68176/selection/b50601e273d79e10e9e358058a47fa86921697a94fe57c321b8a57c239166502" :answer/id #uuid "1231498e-0a27-5ca3-bf4b-eb7883b8a561" :answer/type :answer.type/text :answer/value "$x=0$ and $x=5$" :db/ensure [:answer/validate]} {:db/id "q-68176/selection" :answer-field/id #uuid "4909bdf2-a863-5616-a720-bf164ccae8f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-68176/selection/ab0edf9af8508cb55c2c0372bb24a947e0e74ad84a3eccf461ab6b9b1d5efae9" :answer-field/choices ["q-68176/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" "q-68176/selection/fe5a032e59d7fded868435047a730ed7188d990dd7ef43315a6539fb759cc2e5" "q-68176/selection/ab0edf9af8508cb55c2c0372bb24a947e0e74ad84a3eccf461ab6b9b1d5efae9" "q-68176/selection/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" "q-68176/selection/b50601e273d79e10e9e358058a47fa86921697a94fe57c321b8a57c239166502"] :db/ensure [:answer-field/validate]} {:db/id "q-68176" :question/id #uuid "4b7d0f03-609a-5e69-8791-2efdf15750fe" :question/math-academy-id "q-68176" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{4x}-\\frac{1}{x+5}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{4x}-\\frac{1}{x+5} & =\\frac{x+5-4x}{4x(x+5)} \\\\  & =\\frac{5-3x}{4x(x+5)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n4x(x+5)=0\\,⟹\\,x=0\\,,\\,x=-5.\n$$\n\nTherefore, the vertical asymptotes are at $x=0$ and $x=-5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-68176/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-68176"] :db/ensure [:knowledge-point/validate]} {:db/id "q-107070/selection/02c2ac9730c208f517b45425f4e43eb110953149e4da3e6c03d6ca5b06cd40f6" :answer/id #uuid "2ee9654b-30ad-50a7-8a2f-6805b51ea5a5" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "q-107070/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer/id #uuid "2a0d83d8-da8f-52f9-b429-67c1f860461f" :answer/type :answer.type/text :answer/value "No vertical asymptotes" :db/ensure [:answer/validate]} {:db/id "q-107070/selection/e0a5accd7e4c478e7d7d475df644c69671b24f39ec9c4b5c54aedb00a217b4e0" :answer/id #uuid "a33ccc23-64f3-5421-9df5-a7d3ec6627d0" :answer/type :answer.type/math :answer/value "x=-1,5" :db/ensure [:answer/validate]} {:db/id "q-107070/selection/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" :answer/id #uuid "a753f6f7-9b7e-5f68-a919-5f662daff4b4" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "q-107070/selection/9380b54369550c87643bd745a6fbea68cc0059cc7a16ae9e1c37544bef69595a" :answer/id #uuid "30b5815a-645a-5fd7-b3af-3ce38e365c67" :answer/type :answer.type/math :answer/value "x=0,5" :db/ensure [:answer/validate]} {:db/id "q-107070/selection" :answer-field/id #uuid "905974fd-26d5-5b35-a2f1-07129d050534" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-107070/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" :answer-field/choices ["q-107070/selection/02c2ac9730c208f517b45425f4e43eb110953149e4da3e6c03d6ca5b06cd40f6" "q-107070/selection/00258c5932d8286b792d219a898959e49995ba251596cc2f3ce2ad266e7bf98f" "q-107070/selection/e0a5accd7e4c478e7d7d475df644c69671b24f39ec9c4b5c54aedb00a217b4e0" "q-107070/selection/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" "q-107070/selection/9380b54369550c87643bd745a6fbea68cc0059cc7a16ae9e1c37544bef69595a"] :db/ensure [:answer-field/validate]} {:db/id "q-107070" :question/id #uuid "1a5fa7c7-9fbe-52bd-ba66-480727f1d2f6" :question/math-academy-id "q-107070" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{(x-5)({x}^{3}+1)}{{x}^{2}-4x-5}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(x-5)({x}^{3}+1)}{{x}^{2}-4x-5} & =\\frac{(x-5)(x+1)({x}^{2}-x+1)}{(x-5)(x+1)} \\\\  & =\\frac{\\cancel{(x-5)(x+1)}({x}^{2}-x+1)}{\\cancel{(x-5)(x+1)}} \\\\  & ={x}^{2}-x+1\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-1,$ and $x=5.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005797/assets/bca412e444ba3f3126cc88394ea466c48c2dcb60916dcf42ffb0abecb2c5ad48.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-107070/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648"] :knowledge-point/questions ["q-107070"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339769/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "07db8baa-617a-5396-9f9e-d4d03ab0a471" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-339769/field-1" :answer-field/id #uuid "9483d567-cc86-578e-b2bd-2a5a3331dae6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339769/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-339769/field-1/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-339769/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3c7ba1b0-035c-5406-a080-9225980249ed" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-339769/field-2" :answer-field/id #uuid "cf9aa334-76cf-5e3b-bc80-e119ca2474eb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339769/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-339769/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-339769" :question/id #uuid "671ca5d9-901c-5af2-b9e3-c730af413330" :question/math-academy-id "q-339769" :question/problem "From **left to right**, the vertical asymptotes of $f(x)=\\frac{1}{x-3}-\\frac{1}{x+7}$ are\n\n$x=$\n{{field-1}} \n$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-3}-\\frac{1}{x+7} & =\\frac{x+7-(x-3)}{(x-3)(x+7)} \\\\  & =\\frac{10}{(x-3)(x+7)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-3)(x+7)=0\\,⟹\\,x=-7\\,,\\,x=3.\n$$\n\nTherefore, from left to right, the vertical asymptotes are at $x=-7$ and $x=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339769/field-1" "q-339769/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67"] :knowledge-point/questions ["q-339769"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339963/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "5721b136-8a28-58c2-babf-e9dae6210cb5" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-339963/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "35e3e0f2-c490-51b6-ba90-493f53f1eb59" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-339963/field-1" :answer-field/id #uuid "f15510aa-c3ac-5e18-8ef1-0b96438dc021" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339963/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-339963/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-339963/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-339963" :question/id #uuid "1a5b1368-2d7a-5777-a440-5ec5215cbc5f" :question/math-academy-id "q-339963" :question/problem "The vertical asymptote of $f(x)=\\frac{10x}{{x}^{2}+5x}$ is\n\n$x=$\n{{field-1}}." :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{10x}{{x}^{2}+5x} & =\\frac{10x}{x(x+5)} \\\\  & =\\frac{10\\cancel{x}}{\\cancel{x}(x+5)} \\\\  & =\\frac{10}{x+5}\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\nx+5=0\\,⟹\\,x=-5\n$$\n\nSo the *only* vertical asymptote is at $x=-5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339963/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463"] :knowledge-point/questions ["q-339963"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339975/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "7f7c4b11-95b1-530a-be26-13fd5f803fb4" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-339975/field-1" :answer-field/id #uuid "0450e6a5-d649-5849-b90f-1b38c4fb3442" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339975/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-339975/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-339975" :question/id #uuid "5997e374-fb0c-50df-9b46-f7e14f367818" :question/math-academy-id "q-339975" :question/problem "The vertical asymptote of $f(x)=\\frac{{x}^{2}-16}{{x}^{2}+6x+8}$ is\n\n$x=$\n{{field-1}}." :question/worked-solution "We start by factoring the function as much as possible and canceling the common factors:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-16}{{x}^{2}+6x+8} & =\\frac{{x}^{2}-{4}^{2}}{(x+2)(x+4)} \\\\  & =\\frac{(x-4)(x+4)}{(x+2)(x+4)} \\\\  & =\\frac{(x-4)\\cancel{(x+4)}}{(x+2)\\cancel{(x+4)}} \\\\  & =\\frac{x-4}{x+2}\\end{aligned}\n$$\n\nWe now set the denominator equal to zero:\n\n$$\nx+2=0\\,⟹\\,x=-2\n$$\n\nSo the *only* vertical asymptote is at $x=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339975/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80b8388b-ae0b-5ea6-9efc-fed1a074f463"] :knowledge-point/questions ["q-339975"] :db/ensure [:knowledge-point/validate]}]
