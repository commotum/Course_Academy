282 true] [17592186341550 1000 #edb/ref 17592186341552 13194139535282 true] [17592186341550 1040 #edb/ref 17592186045449 13194139535282 true] [17592186341550 1041 "field-1" 13194139535282 true] [17592186341550 1104 #edb/ref 17592186341552 13194139535282 true] [17592186341550 1110 #uuid "b32c4d8f-1733-5838-b609-ea37a9ad9785" 13194139535282 true] [17592186341551 1034 "889.396" 13194139535282 true] [17592186341551 1103 #edb/ref 17592186045453 13194139535282 true] [17592186341551 1111 #uuid "d25215eb-25a0-5a48-b4e4-2dbf1051f89c" 13194139535282 true] [17592186341552 1034 "889.395" 13194139535282 true] [17592186341552 1103 #edb/ref 17592186045453 13194139535282 true] [17592186341552 1111 #uuid "a1f74e46-756c-5109-9ecf-038e32a7948c" 13194139535282 true] [17592186341553 1017 #edb/ref 17592186341554 13194139535282 true] [17592186341553 1089 "q-266355" 13194139535282 true] [17592186341553 1091 #edb/ref 17592186045465 13194139535282 true] [17592186341553 1100 "Use the first three terms of the binomial expansion of $(2+x)^{9}$ in ascending powers of $x$ to approximate $(1.98)^{9}.$ Round your answer to three decimal places.\n\n$(1.98)^{9}≈$ \n{{field-1}}" 13194139535282 true] [17592186341553 1113 #uuid "ed0ff3ef-efc5-525f-8553-028e37ec293e" 13194139535282 true] [17592186341553 1145 "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=2,$ $b=x,$ and $n=9,$ we obtain\n\n$$\n\\begin{aligned}(2+x)^{9} & =(\\genfrac{}{}{0pt}{}{9}{0})(2)^{9}(x)^{0}+(\\genfrac{}{}{0pt}{}{9}{1})(2)^{9-1}(x)^{1}+(\\genfrac{}{}{0pt}{}{9}{2})(2)^{9-2}(x)^{2}+⋯ \\\\  & =1(2)^{9}+9(2)^{8}x+36(2)^{7}{x}^{2}+⋯ \\\\  & =512+9(256)x+36(128){x}^{2}+⋯ \\\\  & =512+2\\,304x+4\\,608{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n(2+x)^{9}≈512+2\\,304x+4\\,608{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.02$ into the above approximation of $(2+x)^{9}:$\n\n$$\n\\begin{aligned}(1.98)^{9} & =(2+(-0.02))^{9} \\\\  & ≈512+2\\,304(-0.02)+4\\,608(-0.02)^{2} \\\\  & =512+2\\,304(-0.02)+4\\,608(0.0004) \\\\  & =512-46.08+1.843\\,2 \\\\  & ≈467.763,\\end{aligned}\n$$\n\nrounded to three decimal places." 13194139535282 true] [17592186341554 1000 #edb/ref 17592186341555 13194139535282 true] [17592186341554 1040 #edb/ref 17592186045449 13194139535282 true] [17592186341554 1041 "field-1" 13194139535282 true] [17592186341554 1104 #edb/ref 17592186341555 13194139535282 true] [17592186341554 1110 #uuid "664cc87a-171e-5ada-8bb8-84b8d2a265fc" 13194139535282 true] [17592186341555 1034 "467.763" 13194139535282 true] [17592186341555 1103 #edb/ref 17592186045453 13194139535282 true] [17592186341555 1111 #uuid "fb4a3da7-59d3-572e-97b5-7c74e9503e9c" 13194139535282 true]] :edb/tempids {"q-134531" 17592186341465 "q-134531/selection" 17592186341466 "q-134531/selection/5647829872ec140b6283eeda77da3f86ad0a844dff27110f38e8af11e4f75b1c" 17592186341467 "q-134531/selection/5eea20dd15d2a3cca904e645aab275eb1daaf448ac7c2e09abf5cf425d53f50f" 17592186341468 "q-134531/selection/6616556259bc1e1299f7f38a37615d157845e40211941a680ed847d757b94b4e" 17592186341469 "q-134531/selection/91ebc682171ee5c5445a157731cf68599728bed03c3b31a09d9e16f79fbfb505" 17592186341470 "q-134531/selection/a152178c278ee194bae548c8e663a829641ceef521291a811a86ddab57f18dca" 17592186341471 "q-134533" 17592186341472 "q-134533/selection" 17592186341473 "q-134533/selection/02a0d58824a2681fd8b2117e101d380b97b69a871f8ddb6f5881dcc25c8f9405" 17592186341474 "q-134533/selection/3a343b253027ccbd6df8a80a4a01f29ab0cc961349bdfe9bbbc95d1daf406e66" 17592186341475 "q-134533/selection/a152178c278ee194bae548c8e663a829641ceef521291a811a86ddab57f18dca" 17592186341476 "q-134533/selection/f943f7c20316b078a7ad952abec8f9196a0cdd9b060d312424d577963284f2e5" 17592186341477 "q-134533/selection/fbe382b144ba2c123b4bbb3387fb630828b9dc35a