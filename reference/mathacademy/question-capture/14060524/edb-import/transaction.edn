0.001\\,6)-35(0.000\\,064) \\\\  & =1-0.28+0.033\\,6-0.002\\,24 \\\\  & =0.751\\,36,\\end{aligned}\n$$\n\nto five decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-178291/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13e430ab-a814-5613-a45d-d8cdd3c14a0f"] :knowledge-point/questions ["q-178291"] :db/ensure [:knowledge-point/validate]} {:db/id "q-178288/selection/0b8f08ed61afef7084ed47ed3b3701583d406f0fbec5b323157af0d8ca38a9a8" :answer/id #uuid "ce9f392a-11bc-5ac6-bb74-2880202e43fc" :answer/type :answer.type/math :answer/value "0.832\\,0" :db/ensure [:answer/validate]} {:db/id "q-178288/selection/93ecb1d8750b92d61b5b18c7eb347b07acbf45be9865bd3c26070ed0d040a8be" :answer/id #uuid "9ddea8eb-c315-5494-abeb-19e42c532aa3" :answer/type :answer.type/math :answer/value "0.067\\,9" :db/ensure [:answer/validate]} {:db/id "q-178288/selection/11e1efda92cd68691d0022181155b78e17efb52f2165421325fd636696f21ba5" :answer/id #uuid "b02eacde-d6b2-54f4-8b9b-035a832b26e3" :answer/type :answer.type/math :answer/value "1.072\\,1" :db/ensure [:answer/validate]} {:db/id "q-178288/selection/2223d1818681262602216554210ab3b10d76624e9cffb3be021c9daf8e95a2da" :answer/id #uuid "9128cf0f-e79a-5e5f-8ad2-91379152d7e3" :answer/type :answer.type/math :answer/value "1.067\\,9" :db/ensure [:answer/validate]} {:db/id "q-178288/selection/d498494c7b78c6cac7d897157f278828bfb7eefb70b1040ad68aea97e8d69eb6" :answer/id #uuid "c262e206-baad-57c0-8b9e-d005dd96d38a" :answer/type :answer.type/math :answer/value "0.932\\,1" :db/ensure [:answer/validate]} {:db/id "q-178288/selection" :answer-field/id #uuid "77f6a5ff-ce33-542f-99e3-10e481b6a62e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-178288/selection/d498494c7b78c6cac7d897157f278828bfb7eefb70b1040ad68aea97e8d69eb6" :answer-field/choices ["q-178288/selection/0b8f08ed61afef7084ed47ed3b3701583d406f0fbec5b323157af0d8ca38a9a8" "q-178288/selection/93ecb1d8750b92d61b5b18c7eb347b07acbf45be9865bd3c26070ed0d040a8be" "q-178288/selection/11e1efda92cd68691d0022181155b78e17efb52f2165421325fd636696f21ba5" "q-178288/selection/2223d1818681262602216554210ab3b10d76624e9cffb3be021c9daf8e95a2da" "q-178288/selection/d498494c7b78c6cac7d897157f278828bfb7eefb70b1040ad68aea97e8d69eb6"] :db/ensure [:answer-field/validate]} {:db/id "q-178288" :question/id #uuid "1dd05574-640c-5b9b-a9a5-c23bbe5e5973" :question/math-academy-id "q-178288" :question/problem "Use the first three terms of the binomial expansion of $(1+x)^{7}$ in ascending powers of $x$ to approximate $(0.99)^{7}.$ Give your answer to four decimal places." :question/worked-solution "Recall that when $n$ is a positive integer, \n\n$$\n(1+x)^{n}=1+nx+\\frac{1}{2!}n(n-1){x}^{2}+⋯+{x}^{n}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{(1+x)}^{7} & =1+7x+\\frac{1}{2}\\cdot 7\\cdot 6\\cdot {x}^{2}+⋯+{x}^{7} \\\\  & =1+7x+21{x}^{2}+⋯+{x}^{7}.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(1+x)}^{7}≈1+7x+21{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.01$ into the above approximation of $(1+x)^{7}:$ \n\n$$\n\\begin{aligned}(0.99)^{7} & =(1+(-0.01))^{7} \\\\  & ≈1+7(-0.01)+21(-0.01)^{2} \\\\  & =1-7(0.01)+21(0.000\\,1) \\\\  & =1-0.07+0.002\\,1 \\\\  & =0.932\\,1,\\end{aligned}\n$$\n\nto four decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-178288/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13e430ab-a814-5613-a45d-d8cdd3c14a0f"] :knowledge-point/questions ["q-178288"] :db/ensure [:knowledge-point/validate]} {:db/id "q-265992/field-1/f560644870c5a8b5fb6e469f7b1bd9584df62a7580ca3cc78d520dd93a764648" :answer/id #uuid "8eff7c4d-b3dd-5262-97ed-82de2c1a8719" :answer/type :answer.type/math :answer/value "0.571" :db/ensure [:answer/validate]} {:db/id "q-265992/field-1" :answer-field/id #uuid "ae2a0d44-4606-5140-b4a5-c1e733ef82fb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-265992/field-1/f560644870c5a8b5fb6e469f7b1bd9584df62a7580ca3cc78d520dd93a764648" :answer-field/choices ["q-265992/field-1/f560644870c5a8b5fb6e469f7b1bd9584df62a7580ca3cc78d520dd93a764648"] :db/ensure [:answer-field/validate]} {:db/id "q-265992" :question/id #uuid "061c567f-edc2-5ea9-bca1-bf6e8bfbfa7c" :question/math-academy-id "q-265992" :question/problem "Use the first three terms of the binomial expansion of $(1+x)^{5}$ in ascending powers of $x$ to approximate $(0.89)^{5}.$ Round your answer to three decimal places.\n\n$(0.89)^{5}≈$ \n{{field-1}}" :question/worked-solution "Recall that when $n$ is a positive integer, \n\n$$\n(1+x)^{n}=1+nx+\\frac{1}{2!}n(n-1){x}^{2}+⋯+{x}^{n}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{(1+x)}^{5} & =1+5x+\\frac{1}{2}\\cdot 5\\cdot 4\\cdot {x}^{2}+⋯+{x}^{5} \\\\  & =1+5x+10{x}^{2}+⋯+{x}^{5}.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(1+x)}^{5}≈1+5x+10{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.11$ into the above approximation of $(1+x)^{5}:$ \n\n$$\n\\begin{aligned}(0.89)^{5} & =(1+(-0.11))^{5} \\\\  & ≈1+5(-0.11)+10(-0.11)^{2} \\\\  & =1-5(0.11)+10(0.012\\,1) \\\\  & =1-0.55+0.121 \\\\  & ≈0.571,\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-265992/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "13e430ab-a814-5613-a45d-d8cdd3c14a0f"] :knowledge-point/questions ["q-265992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-266355/field-1/a56bf10b63e443d3769469456d2c338f322e6ab6769c32cb9d490568a9c4c608" :answer/id #uuid "fb4a3da7-59d3-572e-97b5-7c74e9503e9c" :answer/type :answer.type/math :answer/value "467.763" :db/ensure [:answer/validate]} {:db/id "q-266355/field-1" :answer-field/id #uuid "664cc87a-171e-5ada-8bb8-84b8d2a265fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-266355/field-1/a56bf10b63e443d3769469456d2c338f322e6ab6769c32cb9d490568a9c4c608" :answer-field/choices ["q-266355/field-1/a56bf10b63e443d3769469456d2c338f322e6ab6769c32cb9d490568a9c4c608"] :db/ensure [:answer-field/validate]} {:db/id "q-266355" :question/id #uuid "ed0ff3ef-efc5-525f-8553-028e37ec293e" :question/math-academy-id "q-266355" :question/problem "Use the first three terms of the binomial expansion of $(2+x)^{9}$ in ascending powers of $x$ to approximate $(1.98)^{9}.$ Round your answer to three decimal places.\n\n$(1.98)^{9}≈$ \n{{field-1}}" :question/worked-solution "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=2,$ $b=x,$ and $n=9,$ we obtain\n\n$$\n\\begin{aligned}(2+x)^{9} & =(\\genfrac{}{}{0pt}{}{9}{0})(2)^{9}(x)^{0}+(\\genfrac{}{}{0pt}{}{9}{1})(2)^{9-1}(x)^{1}+(\\genfrac{}{}{0pt}{}{9}{2})(2)^{9-2}(x)^{2}+⋯ \\\\  & =1(2)^{9}+9(2)^{8}x+36(2)^{7}{x}^{2}+⋯ \\\\  & =512+9(256)x+36(128){x}^{2}+⋯ \\\\  & =512+2\\,304x+4\\,608{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n(2+x)^{9}≈512+2\\,304x+4\\,608{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.02$ into the above approximation of $(2+x)^{9}:$\n\n$$\n\\begin{aligned}(1.98)^{9} & =(2+(-0.02))^{9} \\\\  & ≈512+2\\,304(-0.02)+4\\,608(-0.02)^{2} \\\\  & =512+2\\,304(-0.02)+4\\,608(0.0004) \\\\  & =512-46.08+1.843\\,2 \\\\  & ≈467.763,\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-266355/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4395c989-325f-5ac7-bdb3-f577f18695ed"] :knowledge-point/questions ["q-266355"] :db/ensure [:knowledge-point/validate]} {:db/id "q-266342/field-1/d7e65c8ab9be0fbca568b990eafde855364ac2be481aca12b02d9055884a259c" :answer/id #uuid "a1f74e46-756c-5109-9ecf-038e32a7948c" :answer/type :answer.type/math :answer/value "889.395" :db/ensure [:answer/validate]} {:db/id "q-266342/field-1/92a6c51697a8202594775d03b5c89fcf95416b0f2fee88391a081e27582a9840" :answer/id #uuid "d25215eb-25a0-5a48-b4e4-2dbf1051f89c" :answer/type :answer.type/math :answer/value "889.396" :db/ensure [:answer/validate]} {:db/id "q-266342/field-1" :answer-field/id #uuid "b32c4d8f-1733-5838-b609-ea37a9ad9785" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-266342/field-1/d7e65c8ab9be0fbca568b990eafde855364ac2be481aca12b02d9055884a259c" :answer-field/choices ["q-266342/field-1/d7e65c8ab9be0fbca568b990eafde855364ac2be481aca12b02d9055884a259c" "q-266342/field-1/92a6c51697a8202594775d03b5c89fcf95416b0f2fee88391a081e27582a9840"] :db/ensure [:answer-field/validate]} {:db/id "q-266342" :question/id #uuid "7cb71077-9dfd-515e-9c32-f7d8274dbcc0" :question/math-academy-id "q-266342" :question/problem "Use the first three terms of the binomial expansion of $(2+x)^{9}$ in ascending powers of $x$ to approximate $(2.13)^{9}.$ Round your answer to three decimal places.\n\n$(2.13)^{9}≈$ \n{{field-1}}" :question/worked-solution "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=2,$ $b=x,$ and $n=9,$ we obtain\n\n$$\n\\begin{aligned}(2+x)^{9} & =(\\genfrac{}{}{0pt}{}{9}{0})(2)^{9}(x)^{0}+(\\genfrac{}{}{0pt}{}{9}{1})(2)^{9-1}(x)^{1}+(\\genfrac{}{}{0pt}{}{9}{2})(2)^{9-2}(x)^{2}+⋯ \\\\  & =1(2)^{9}+9(2)^{8}(x)^{1}+36(2)^{7}(x)^{2}+⋯ \\\\  & =512+9(256)x+36(128){x}^{2}+⋯ \\\\  & =512+2\\,304x+4\\,608{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n(2+x)^{9}≈512+2\\,304x+4\\,608{x}^{2}.\n$$\n\nFinally, we substitute $x=0.13$ into the expansion of $(2+x)^{9}:$\n\n$$\n\\begin{aligned}(2.13)^{9} & =(2+0.13)^{9} \\\\  & ≈512+2\\,304(0.13)+4\\,608(0.13)^{2} \\\\  & =512+2\\,304(0.13)+4\\,608(0.016\\,9) \\\\  & =512+299.52+77.875\\,2 \\\\  & ≈889.395,\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-266342/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4395c989-325f-5ac7-bdb3-f577f18695ed"] :knowledge-point/questions ["q-266342"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-134630"] :question/problem "Use the first three terms of the binomial expansion of $(4+x)^{4}$ in ascending powers of $x$ to approximate $(4.05)^{4}.$ Give your answer to three decimal places." :question/worked-solution "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=4,$ $b=x,$ and $n=4,$ we obtain\n\n$$\n\\begin{aligned}{(4+x)}^{4} & =(\\genfrac{}{}{0pt}{}{4}{0}){(4)}^{4}{(x)}^{0}+(\\genfrac{}{}{0pt}{}{4}{1}){(4)}^{4-1}{(x)}^{1}+(\\genfrac{}{}{0pt}{}{4}{2}){(4)}^{4-2}{(x)}^{2}+⋯ \\\\  & =1{(4)}^{4}+4{(4)}^{3}{(x)}^{1}+6{(4)}^{2}{(x)}^{2}+⋯ \\\\  & =256+4(64)(x)+6(16)({x}^{2})+⋯ \\\\  & =256+256x+96{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n(4+x)^{4}≈256+256x+96{x}^{2}+⋯\\,.\n$$\n\nFinally, we substitute $x=0.05$ into the expansion of $(4+x)^{4}:$\n\n$$\n\\begin{aligned}(4.05)^{4} & =(4+0.05)^{4} \\\\  & ≈256+256(0.05)+96(0.05)^{2} \\\\  & =256+256(0.05)+96(0.002\\,5) \\\\  & =256+12.8+0.24 \\\\  & =269.040,\\end{aligned}\n$$\n\nto three decimal places." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-235253/field-1/e5aaf5d833f251f56f42cdeffe7529675385525d1352850aebb20519916bb548" :answer/id #uuid "89e02f71-b91a-57b4-9eba-ee015857305c" :answer/type :answer.type/math :answer/value "74902.82" :db/ensure [:answer/validate]} {:db/id 17592186099185 :answer-field/choices ["q-235253/field-1/e5aaf5d833f251f56f42cdeffe7529675385525d1352850aebb20519916bb548"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-235253"] :question/problem "Use the first three terms of the binomial expansion of $(5+x)^{7}$ in ascending powers of $x$ to approximate $(4.97)^{7}.$ Round your answer to two decimal places.\n\n$(4.97)^{7}≈$ \n{{field-1}}" :question/worked-solution "The binomial theorem for positive integer $n$ states that\n\n$$\n(a+b)^{n}=(\\genfrac{}{}{0pt}{}{n}{0}){a}^{n}{b}^{0}+(\\genfrac{}{}{0pt}{}{n}{1}){a}^{n-1}{b}^{1}+(\\genfrac{}{}{0pt}{}{n}{2}){a}^{n-2}{b}^{2}+…+(\\genfrac{}{}{0pt}{}{n}{n}){a}^{0}{b}^{n}.\n$$\n\nBy substituting $a=5,$ $b=x,$ and $n=7,$ we obtain\n\n$$\n\\begin{aligned}{(5+x)}^{7} & =(\\genfrac{}{}{0pt}{}{7}{0}){(5)}^{7}{(x)}^{0}+(\\genfrac{}{}{0pt}{}{7}{1}){(5)}^{7-1}{(x)}^{1}+(\\genfrac{}{}{0pt}{}{7}{2}){(5)}^{7-2}{(x)}^{2}+⋯ \\\\  & =1{(5)}^{7}+7{(5)}^{6}{(x)}^{1}+21{(5)}^{5}{(x)}^{2}+⋯ \\\\  & =78\\,125+7(15\\,625)(x)+21(3\\,125)({x}^{2})+⋯ \\\\  & =78\\,125+109\\,375x+65\\,625{x}^{2}+⋯\\,.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(5+x)}^{7}≈78\\,125+109\\,375x+65\\,625{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.03$ into the above approximation of $(5+x)^{7}:$\n\n$$\n\\begin{aligned}(4.97)^{7} & =(5+(-0.03))^{7} \\\\  & ≈78\\,125+109\\,375(-0.03)+65\\,625(-0.03)^{2} \\\\  & =78\\,125+109\\,375(-0.03)+65\\,625(0.000\\,9) \\\\  & =78\\,125-3\\,281.25+59.062\\,5 \\\\  & ≈74\\,902.81,\\end{aligned}\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-178357/selection/4eb9705c198633a99ad3c299139d9ed8232887e1b32c3bf41545bc387223f943" :answer/id #uuid "60002b58-c106-5017-ac5d-24f1597d89e4" :answer/type :answer.type/math :answer/value "253.589" :db/ensure [:answer/validate]} {:db/id "q-178357/s