#{[{:db/id #edb/ref 17592186251489 :knowledge-point/_questions [{:knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a" :knowledge-point/title "Computing the Terms of a Fibonacci Sequence Given in Sequence Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcc9b4ff-f7ba-5eb2-ba60-72db38fd51a1" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186251491} {:answer/id #uuid "cd7165dc-ba3d-5d59-b58b-e66d373a38e3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251492} {:answer/id #uuid "a485eccd-2b38-563d-9188-c03da9e6dd8d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186251493} {:answer/id #uuid "35978e4b-5b8e-51f6-9a00-929d36faa752" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186251494} {:answer/id #uuid "53ad8b61-4bc7-5ec0-ae1c-18bd008d68c8" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186251495}] :answer-field/correct {:answer/id #uuid "cd7165dc-ba3d-5d59-b58b-e66d373a38e3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186251492} :answer-field/id #uuid "054817e7-2fe5-5a36-adc7-047abd23443b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251490}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0b57e723-e6bd-5c73-bd65-41482f1edc88" :question/math-academy-id "q-103218" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=-3$ and ${a}_{2}=-1,$ then ${a}_{4}=$" :question/worked-solution "To compute ${a}_{4},$ we first need to compute ${a}_{3}.$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}{a}_{n+2} & ={a}_{n+1}+{a}_{n} \\\\ {a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =-1+(-3) \\\\ {a}_{3} & =-4\\end{aligned}\n$$\n\nNext, to compute ${a}_{4},$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =-4+(-1) \\\\ {a}_{4} & =-5\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-5.$"}] [{:db/id #edb/ref 17592186251496 :knowledge-point/_questions [{:knowledge-point/id #uuid "80d72276-63b0-52c6-b7cf-0f4e2e0392aa" :knowledge-point/title "Adding Rational Expressions With a Common Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5b06186-442f-5426-8a93-e8be287ea1a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{h-2g}{h}" :db/id #edb/ref 17592186251498} {:answer/id #uuid "a1a8cebb-e6f7-5a39-bbed-2e246876a0da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5h+g}{3h}" :db/id #edb/ref 17592186251499} {:answer/id #uuid "4391ba83-9985-5666-a874-6fd703562019" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5h-g}{h}" :db/id #edb/ref 17592186251500} {:answer/id #uuid "e448d047-c827-5a3d-aa17-5a0c41c02bb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5h-2g}{3h}" :db/id #edb/ref 17592186251501} {:answer/id #uuid "7c81c11d-9c4c-5171-8dbb-a65e4e07ebb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2h-3g}{3h}" :db/id #edb/ref 17592186251502}] :answer-field/correct {:answer/id #uuid "e448d047-c827-5a3d-aa17-5a0c41c02bb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5h-2g}{3h}" :db/id #edb/ref 17592186251501} :answer-field/id #uuid "0de04443-4625-572a-b5e2-357d359ae109" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251497}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5bcbac58-fdb7-502c-b62c-9e943dff7464" :question/math-academy-id "q-113214" :question/problem "Simplify $\\frac{5g+3h}{3h}-\\frac{7g-2h}{3h}.$" :question/worked-solution "We have a common denominator of $3h,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{5g+3h}{3h}-\\frac{7g-2h}{3h} & = \\\\ \\frac{5g+3h-(7g-2h)}{3h} & = \\\\ \\frac{5g+3h-7g+2h}{3h} & = \\\\ \\frac{5h-2g}{3h}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186251503 :knowledge-point/_questions [{:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc5da0e1-303a-5f89-b646-80cffa3bf355" :answer/type {:db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186251505} {:answer/id #uuid "29c0c536-47ed-5d55-8abb-887f77baa40f" :answer/type {:db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186251506} {:answer/id #uuid "9cc3bea2-bf18-5239-8995-bfbafbc9e79d" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186251507} {:answer/id #uuid "53135176-4823-5652-b808-f3f454f4016e" :answer/type {:db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186251508} {:answer/id #uuid "f29b12cf-0681-552a-9291-c8afe591a4d5" :answer/type {:db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186251509}] :answer-field/correct {:answer/id #uuid "9cc3bea2-bf18-5239-8995-bfbafbc9e79d" :answer/type {:db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186251507} :answer-field/id #uuid "d2318fc5-025b-5be6-92f0-578b4b9c9707" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251504}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0f82791c-ce92-593f-a20b-ca17b90c99f9" :question/math-academy-id "q-124708" :question/problem "The angle $\\theta =-{430}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{430}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{430}^{∘}+{360}^{∘}=-{70}^{∘}$\n\n- $-{430}^{∘}+2\\cdot {360}^{∘}={290}^{∘}\\,✓$\n\nSo the angle ${290}^{∘}$ is coterminal with $-{430}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944377/assets/dd07505860bd967a66911efca9f20f074798d3d1003776125bf186f7e359bd56.png)\n\nWe see that ${290}^{∘}$ lies in quadrant IV. Therefore, $-{430}^{∘}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186192842 :knowledge-point/_questions [{:knowledge-point/id #uuid "7266d5c7-67b9-59db-b994-07dcb143af1f" :knowledge-point/title "Finding the Inverse of a Simple Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cd04b16-2a0e-542f-a5b6-03501fec198e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = \\frac{x + 2}{2x + 1}" :db/id #edb/ref 17592186189902} {:answer/id #uuid "ab1742af-31aa-5927-af56-01daa746b327" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = \\frac{3x + 1}{2x + 6}" :db/id #edb/ref 17592186189903} {:answer/id #uuid "15b8c48d-e862-5f55-9089-f070f1cf8d53" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = \\frac{3x + 6}{2x + 1}" :db/id #edb/ref 17592186189904} {:answer/id #uuid "1db948a4-bf41-5da0-aca0-6cf4da2a447f" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = \\frac{x + 2}{x + 1}" :db/id #edb/ref 17592186189905} {:answer/id #uuid "7edcce43-6bfb-5053-bc3d-69cda713fb8e" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = \\frac{3x + 6}{x - 2}" :db/id #edb/ref 17592186189906}] :answer-field/correct {:answer/id #uuid "15b8c48d-e862-5f55-9089-f070f1cf8d53" :answer/type {:db/ident :answer.type/math} :answer/value "f^{-1}(x) = \\frac{3x + 6}{2x + 1}" :db/id #edb/ref 17592186189904} :answer-field/id #uuid "f15c7b56-b79b-55f1-a10e-ee5529ad2591" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186189901}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3fbadf4f-ad61-5c64-abef-b812903e691b" :question/math-academy-id "q-148297" :question/problem "Find the inverse of the function $f(x) = \\frac{x - 6}{3 - 2x}$." :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{x-6}{3-2x}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{y-6}{3-2y}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{y-6}{3-2y} \\\\ x(3-2y) & =y-6 \\\\ 3x-2xy & =y-6 \\\\ 3x+6 & =2xy+y \\\\ 3x+6 & =y(2x+1) \\\\ y & =\\frac{3x+6}{2x+1}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{3x+6}{2x+1}.\n$$"}] [{:db/id #edb/ref 17592186251510 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473" :knowledge-point/title "The Vertical Asymptote of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95ae2577-5121-5d70-84b6-b0677cab1664" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}" :db/id #edb/ref 17592186251512} {:answer/id #uuid "c8022c98-46b2-5212-8d80-04a6fdb6aa70" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186251513} {:answer/id #uuid "6af38d74-0db8-5f86-9bd5-bc3f5aaff832" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186251514} {:answer/id #uuid "53aaebdb-a1bf-5178-b7ef-0d5a738b332b" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{4}" :db/id #edb/ref 17592186251515} {:answer/id #uuid "1ad32d61-b402-5b60-bd11-5230e3f0e33c" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186251516}] :answer-field/correct {:answer/id #uuid "1ad32d61-b402-5b60-bd11-5230e3f0e33c" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186251516} :answer-field/id #uuid "2c03a5c4-d3b2-5d41-816e-495ab8b9dae9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251511}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f3d9b943-7742-5c93-9ddb-be1c3eff9200" :question/math-academy-id "q-166546" :question/problem "Find the equation of the vertical asymptote of the function $f(x)={log}_{5}⁡(2x+4)-1.$" :question/worked-solution "The equation of the vertical asymptote of the function $y={log}_{5}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=-2.$"}] [{:db/id #edb/ref 17592186251517 :knowledge-point/_questions [{:knowledge-point/id #uuid "833ac63c-235b-5059-ab7c-56eb1e44d79e" :knowledge-point/title "Finding the Argument of a Complex Number in the Second Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23294c06-5958-5083-96ba-a5b558c92e41" :answer/type {:db/ident :answer.type/math} :answer/value "2.34" :db/id #edb/ref 17592186251519} {:answer/id #uuid "27d7892a-1f33-5503-9b79-7a6cd8c1ecb2" :answer/type {:db/ident :answer.type/math} :answer/value "2.19" :db/id #edb/ref 17592186251520} {:answer/id #uuid "6377ac55-7341-58cc-a4e9-6475fb2091bb" :answer/type {:db/ident :answer.type/math} :answer/value "1.98" :db/id #edb/ref 17592186251521} {:answer/id #uuid "9d582090-d54b-5c95-987e-a9f9bdcd9c9c" :answer/type {:db/ident :answer.type/math} :answer/value "1.84" :db/id #edb/ref 17592186251522} {:answer/id #uuid "4cf96a74-bf8b-5616-b853-621704f4d9cc" :answer/type {:db/ident :answer.type/math} :answer/value "2.50" :db/id #edb/ref 17592186251523}] :answer-field/correct {:answer/id #uuid "4cf96a74-bf8b-5616-b853-621704f4d9cc" :answer/type {:db/ident :answer.type/math} :answer/value "2.50" :db/id #edb/ref 17592186251523} :answer-field/id #uuid "fccdcccf-87d1-5f86-9a3a-711bfc1d1d56" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251518}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e4cd7ee2-32ef-5737-aa3c-9d2076f2fe28" :question/math-academy-id "q-170486" :question/problem "Find, in radians to two decimal places, the argument of $z=-8+6\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944377/assets/db85a52dd73f7e908815632bb803c472e507d32f1636c2b4a7f6c72d131405d3.png)\n\nThe complex number $z$ lies in the second quadrant of the complex plane. Therefore $\\frac{\\pi }{2}<\\operatorname{arg}⁡(z)<\\pi .$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\alpha  & =\\frac{6}{8} \\\\ \\alpha  & =\\operatorname{arctan}⁡(\\frac{6}{8}) \\\\  & ≈0.643\\,50.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi -0.643\\,50≈2.50\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186251524 :knowledge-point/_questions [{:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6" :knowledge-point/title "Applying the Rule of Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b76342ef-1fa4-505e-ba84-4202ed234ccd" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186251526} {:answer/id #uuid "8d6f9e82-7377-5757-a939-be9c37e4fb77" :answer/type {:db/ident :answer.type/math} :answer/value "192" :db/id #edb/ref 17592186251527} {:answer/id #uuid "6c4aee4c-a585-5e23-9f18-7d12fa99aa67" :answer/type {:db/ident :answer.type/math} :answer/value "240" :db/id #edb/ref 17592186251528} {:answer/id #uuid "4ea52587-0bb3-58a5-b419-fecfcb389ecf" :answer/type {:db/ident :answer.type/math} :answer/value "184" :db/id #edb/ref 17592186251529} {:answer/id #uuid "41049447-59bb-5baf-a669-703dc5e17be5" :answer/type {:db/ident :answer.type/math} :answer/value "212" :db/id #edb/ref 17592186251530}] :answer-field/correct {:answer/id #uuid "b76342ef-1fa4-505e-ba84-4202ed234ccd" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186251526} :answer-field/id #uuid "3da9f444-bfcc-5af1-9541-10b98e9bb28d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251525}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "56c331b9-384a-590b-8b8b-b1ee0440652b" :question/math-academy-id "q-1782" :question/problem "How many possible outcomes are there if a six-sided die is rolled twice and a coin is flipped three times?" :question/worked-solution "For the die, there is a total of $6$ outcomes: $1,2,3,4,5,6.$\n\nFor the coin, there are just $2$ outcomes: \"Heads\" and \"Tails\".\n\nUsing the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Total Possible Outcomes} & =\\text{Number of outcomes on the }1\\text{st roll of the die} \\\\  & \\times \\text{Number of outcomes on the }2\\text{nd roll of the die} \\\\  & \\times \\text{Number of outcomes on the }1\\text{st flip of the coin} \\\\  & \\times \\text{Number of outcomes on the }2\\text{nd flip of the coin} \\\\  & \\times \\text{Number of outcomes on the }3\\text{rd flip of the coin} \\\\  & =6\\times 6\\times 2\\times 2\\times 2 \\\\  & ={6}^{2}\\times {2}^{3} \\\\  & =36\\times 8 \\\\  & =288.\\end{aligned}\n$$\n\nSo, there are $288$ possible outcomes."}] [{:db/id #edb/ref 17592186251531 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a53bf2-3144-5da3-8ee7-54d1e6c8fd7d" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Synthetic Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd392652-91cb-5de1-933c-8770d7810de7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251533}] :answer-field/correct {:answer/id #uuid "fd392652-91cb-5de1-933c-8770d7810de7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251533} :answer-field/id #uuid "4c945e3c-eb74-5d01-9877-9f3fe479a7a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186251532}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1cf51274-e075-59a8-8954-9e26897884e6" :question/math-academy-id "q-278323" :question/problem "The multiplicity of the root $x=-6$ in the polynomial $p(x)={x}^{3}+14{x}^{2}+60x+72$ is{{field-1}}." :question/worked-solution "Since $x=-6$ is a root of $p(x),$ the factor theorem tells us that $(x+6)$ is a factor of $p(x).$\n\nBecause $(x+6)$ is a factor of $p(x),$ we know that $(x+6)$ divides $p(x)$ with no remainder. So, to begin factoring $p(x),$ we can divide it by $(x+6)$ using synthetic division:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-6$ | $1$ | $14$ | $60$ | $72$ |\n|  | $↓$ | $-6$ | $-48$ | $-72$ |\n|  | $1$ | $8$ | $12$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{p(x)}{x+6}={x}^{2}+8x+12,\n$$\n\nwhich means that\n\n$$\np(x)=(x+6)({x}^{2}+8x+12).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n\\begin{aligned}p(x) & =(x+6)(x+6)(x+2) \\\\  & =(x+2)(x+6)^{2}.\\end{aligned}\n$$\n\nThe factor $(x+6)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=-6$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186083557 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c012aa96-f2a4-50b5-b4f7-67d157a075f4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{312}{2}" :db/id #edb/ref 17592186080724} {:answer/id #uuid "c361198a-d2dd-5b78-b2fe-a4f604df7adf" :answer/type {:db/ident :answer.type/math} :answer/value "22464" :db/id #edb/ref 17592186080725} {:answer/id #uuid "fdda6ebe-0408-5b1f-99a5-e22d7e22dfb2" :answer/type {:db/ident :answer.type/math} :answer/value "-22464" :db/id #edb/ref 17592186080726} {:answer/id #uuid "375534b3-dda1-540c-8c99-c417a7986603" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22464}{312}" :db/id #edb/ref 17592186080727} {:answer/id #uuid "66a683da-2d93-5d97-9219-855f9b6d484f" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cdot 22464" :db/id #edb/ref 17592186080728}] :answer-field/correct {:answer/id #uuid "c361198a-d2dd-5b78-b2fe-a4f604df7adf" :answer/type {:db/ident :answer.type/math} :answer/value "22464" :db/id #edb/ref 17592186080725} :answer-field/id #uuid "1556362e-b30e-51ce-9bc4-1758f812bce3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080723}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "06709575-a0b4-5b51-bcb8-ecba24f5bcc6" :question/math-academy-id "q-288820" :question/problem "Consider the quadratic equation\n\n$x^{2} - 312x + 22464 = 0$.\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=-312,\\,c=22\\,464.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{22\\,464}{1}=22\\,464.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186251534 :knowledge-point/_questions [{:knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63b93a46-a55f-5321-a0c7-eefb659a1f76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}z+C" :db/id #edb/ref 17592186251536} {:answer/id #uuid "3d6edf0c-ba56-5268-860c-64fdc6d92944" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{z}^{2}}{3}+C" :db/id #edb/ref 17592186251537} {:answer/id #uuid "58b2c098-1289-5bc4-83f4-6848726423aa" :answer/type {:db/ident :answer.type/math} :answer/value "3{z}^{2}+C" :db/id #edb/ref 17592186251538} {:answer/id #uuid "1b1c72b4-34db-5c86-8fbc-cd27be442d61" :answer/type {:db/ident :answer.type/math} :answer/value "3z+C" :db/id #edb/ref 17592186251539} {:answer/id #uuid "057aee6b-8e6e-5232-943d-6eca230c7ca1" :answer/type {:db/ident :answer.type/math} :answer/value "3{z}^{-1}+C" :db/id #edb/ref 17592186251540}] :answer-field/correct {:answer/id #uuid "63b93a46-a55f-5321-a0c7-eefb659a1f76" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}z+C" :db/id #edb/ref 17592186251536} :answer-field/id #uuid "286cd013-add0-5ed4-837f-d73c8b6b24ec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251535}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a0e8d259-56cb-59d3-a32e-430fed95559f" :question/math-academy-id "q-71215" :question/problem "Calculate $\\int \\frac{1}{3}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3}\\,\\text{d}z & =\\frac{1}{3}\\int 1\\,\\text{d}z \\\\  & =\\frac{1}{3}\\int {z}^{0}\\,\\text{d}z \\\\  & =\\frac{1}{3}\\cdot \\frac{{z}^{0+1}}{0+1}+C \\\\  & =\\frac{1}{3}\\cdot z+C \\\\  & =\\frac{1}{3}z+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186251541 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "488d71e1-7a56-5438-b495-f85f3fb5a321" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{8}{y}^{2}-{z}^{2}{w}^{4})(z{w}^{2}+{x}^{4}y)(z{w}^{2}-{x}^{4}y)" :db/id #edb/ref 17592186251543} {:answer/id #uuid "8ef47b29-5014-5b9c-829a-f50d7f1700f2" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{8}{y}^{2}-{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})" :db/id #edb/ref 17592186251544} {:answer/id #uuid "ec3bbf75-15d0-5004-a5e6-864563f67ca2" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})" :db/id #edb/ref 17592186251545} {:answer/id #uuid "436734c1-d16c-50fe-b5dc-5eb2c0288c8e" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{4}y+z{w}^{2})^{2}({x}^{4}y-z{w}^{2})" :db/id #edb/ref 17592186251546} {:answer/id #uuid "2315c796-17fd-5a5f-b846-a34aea2322e1" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})^{2}" :db/id #edb/ref 17592186251547}] :answer-field/correct {:answer/id #uuid "ec3bbf75-15d0-5004-a5e6-864563f67ca2" :answer/type {:db/ident :answer.type/math} :answer/value "({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})" :db/id #edb/ref 17592186251545} :answer-field/id #uuid "c692a434-24a2-563c-b7ff-e0a9ee9f85cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251542}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "151c40f6-53aa-57e2-8bf8-f090f359eaf8" :question/math-academy-id "q-79480" :question/problem "Factor the expression ${x}^{16}{y}^{4}-{z}^{4}{w}^{8}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that the expression in parenthesis can be written as a difference of squares:\n\n$$\n{x}^{16}{y}^{4}-{z}^{4}{w}^{8}=({({x}^{8}{y}^{2})}^{2}-{({z}^{2}{w}^{4})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n({({x}^{8}{y}^{2})}^{2}-{({z}^{2}{w}^{4})}^{2})=({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{8}{y}^{2}-{z}^{2}{w}^{4})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{8}{y}^{2}-{z}^{2}{w}^{4}) & =({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({({x}^{4}y)}^{2}-{(z{w}^{2})}^{2}) \\\\  & =({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186251548 :knowledge-point/_questions [{:knowledge-point/id #uuid "f88bd4db-8477-5822-9cda-a608e78039e5" :knowledge-point/title "Determining the Length of a Line Segment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "629362ce-58d2-5c8b-a96b-e6af2e3d794e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186251550} {:answer/id #uuid "4ff56dd9-adbb-53bf-8c3d-65ccbd914459" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186251551} {:answer/id #uuid "13dd0264-1b15-5b1e-a4a2-d81a936c8d15" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186251552} {:answer/id #uuid "771e8d1c-f207-5e80-8a7d-9b62f607adc7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186251553} {:answer/id #uuid "226e307f-549d-5b33-b939-2f5007c01c61" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{3}" :db/id #edb/ref 17592186251554}] :answer-field/correct {:answer/id #uuid "4ff56dd9-adbb-53bf-8c3d-65ccbd914459" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186251551} :answer-field/id #uuid "f9f20267-2184-51dc-a012-13aaf2242d7a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251549}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "cf94c466-0e89-5582-ac53-67d16fe14203" :question/math-academy-id "q-98106" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944377/assets/1108dd3f3d7114f40a483edbbb353fdc51062892d75097fbf22cb7879e4a52cb.png)\n\nWhat is the length of $\\overset{―}{PQ}$ in the diagram above?" :question/worked-solution "The length of $\\overset{―}{PQ}$ is equal to the distance between $P$ and $Q.$\n\nThe distance $d$ between two points $P({x}_{1},{y}_{1},{z}_{1})$ and $Q({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nSince $P$ and $Q$ have coordinates ${{(3,\\,-2,\\,0)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and ${{(2,0,-2)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}},$ respectively, we have\n\n$$\n\\begin{aligned}PQ & =\\sqrt{(2-3)^{2}+(0-(-2))^{2}+(-2-0)^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$"}]}
