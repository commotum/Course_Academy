[{:db/id "q-71215/selection/67c8ed2195010c645ca825f971c5c9f912a9038ef4b11623bb1e882786d9bbe5" :answer/id #uuid "3d6edf0c-ba56-5268-860c-64fdc6d92944" :answer/type :answer.type/math :answer/value "\\frac{{z}^{2}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-71215/selection/6ddda5262a57917fad217695f02a4a42d36e35bc655c0b057a6b2e7183d53526" :answer/id #uuid "1b1c72b4-34db-5c86-8fbc-cd27be442d61" :answer/type :answer.type/math :answer/value "3z+C" :db/ensure [:answer/validate]} {:db/id "q-71215/selection/6d3173380d0db3427029c238948668c4a7f042a7b43a1b7201c46ddd80321fdb" :answer/id #uuid "58b2c098-1289-5bc4-83f4-6848726423aa" :answer/type :answer.type/math :answer/value "3{z}^{2}+C" :db/ensure [:answer/validate]} {:db/id "q-71215/selection/17396cdf7393930f7158833cc29bea744c78df899af5ddf7c2ceaa9b18752f07" :answer/id #uuid "63b93a46-a55f-5321-a0c7-eefb659a1f76" :answer/type :answer.type/math :answer/value "\\frac{1}{3}z+C" :db/ensure [:answer/validate]} {:db/id "q-71215/selection/c25edcb118f37a70ec6aeeb96ffd0a3084b101578df5a719b1762feb34555592" :answer/id #uuid "057aee6b-8e6e-5232-943d-6eca230c7ca1" :answer/type :answer.type/math :answer/value "3{z}^{-1}+C" :db/ensure [:answer/validate]} {:db/id "q-71215/selection" :answer-field/id #uuid "286cd013-add0-5ed4-837f-d73c8b6b24ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71215/selection/17396cdf7393930f7158833cc29bea744c78df899af5ddf7c2ceaa9b18752f07" :answer-field/choices ["q-71215/selection/67c8ed2195010c645ca825f971c5c9f912a9038ef4b11623bb1e882786d9bbe5" "q-71215/selection/6ddda5262a57917fad217695f02a4a42d36e35bc655c0b057a6b2e7183d53526" "q-71215/selection/6d3173380d0db3427029c238948668c4a7f042a7b43a1b7201c46ddd80321fdb" "q-71215/selection/17396cdf7393930f7158833cc29bea744c78df899af5ddf7c2ceaa9b18752f07" "q-71215/selection/c25edcb118f37a70ec6aeeb96ffd0a3084b101578df5a719b1762feb34555592"] :db/ensure [:answer-field/validate]} {:db/id "q-71215" :question/id #uuid "a0e8d259-56cb-59d3-a32e-430fed95559f" :question/math-academy-id "q-71215" :question/problem "Calculate $\\int \\frac{1}{3}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3}\\,\\text{d}z & =\\frac{1}{3}\\int 1\\,\\text{d}z \\\\  & =\\frac{1}{3}\\int {z}^{0}\\,\\text{d}z \\\\  & =\\frac{1}{3}\\cdot \\frac{{z}^{0+1}}{0+1}+C \\\\  & =\\frac{1}{3}\\cdot z+C \\\\  & =\\frac{1}{3}z+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71215/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9"] :knowledge-point/questions ["q-71215"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103218/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a485eccd-2b38-563d-9188-c03da9e6dd8d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-103218/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "35978e4b-5b8e-51f6-9a00-929d36faa752" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-103218/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "cd7165dc-ba3d-5d59-b58b-e66d373a38e3" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-103218/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "53ad8b61-4bc7-5ec0-ae1c-18bd008d68c8" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-103218/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "bcc9b4ff-f7ba-5eb2-ba60-72db38fd51a1" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-103218/selection" :answer-field/id #uuid "054817e7-2fe5-5a36-adc7-047abd23443b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103218/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-103218/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-103218/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-103218/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-103218/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-103218/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-103218" :question/id #uuid "0b57e723-e6bd-5c73-bd65-41482f1edc88" :question/math-academy-id "q-103218" :question/problem "If ${a}_{n+2}={a}_{n+1}+{a}_{n}$ with ${a}_{1}=-3$ and ${a}_{2}=-1,$ then ${a}_{4}=$" :question/worked-solution "To compute ${a}_{4},$ we first need to compute ${a}_{3}.$ So, we substitute $n=1$ into the recursive formula, as follows:\n\n$$\n\\begin{aligned}{a}_{n+2} & ={a}_{n+1}+{a}_{n} \\\\ {a}_{1+2} & ={a}_{1+1}+{a}_{1} \\\\ {a}_{3} & ={a}_{2}+{a}_{1} \\\\ {a}_{3} & =-1+(-3) \\\\ {a}_{3} & =-4\\end{aligned}\n$$\n\nNext, to compute ${a}_{4},$ we substitute $n=2$ into the recursive formula:\n\n$$\n\\begin{aligned}{a}_{2+2} & ={a}_{2+1}+{a}_{2} \\\\ {a}_{4} & ={a}_{3}+{a}_{2} \\\\ {a}_{4} & =-4+(-1) \\\\ {a}_{4} & =-5\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-5.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103218/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5d4a21cd-bd8d-5572-b932-76875827170a"] :knowledge-point/questions ["q-103218"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278323/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "fd392652-91cb-5de1-933c-8770d7810de7" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-278323/field-1" :answer-field/id #uuid "4c945e3c-eb74-5d01-9877-9f3fe479a7a2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278323/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-278323/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-278323" :question/id #uuid "1cf51274-e075-59a8-8954-9e26897884e6" :question/math-academy-id "q-278323" :question/problem "The multiplicity of the root $x=-6$ in the polynomial $p(x)={x}^{3}+14{x}^{2}+60x+72$ is{{field-1}}." :question/worked-solution "Since $x=-6$ is a root of $p(x),$ the factor theorem tells us that $(x+6)$ is a factor of $p(x).$\n\nBecause $(x+6)$ is a factor of $p(x),$ we know that $(x+6)$ divides $p(x)$ with no remainder. So, to begin factoring $p(x),$ we can divide it by $(x+6)$ using synthetic division:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-6$ | $1$ | $14$ | $60$ | $72$ |\n|  | $↓$ | $-6$ | $-48$ | $-72$ |\n|  | $1$ | $8$ | $12$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{p(x)}{x+6}={x}^{2}+8x+12,\n$$\n\nwhich means that\n\n$$\np(x)=(x+6)({x}^{2}+8x+12).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n\\begin{aligned}p(x) & =(x+6)(x+6)(x+2) \\\\  & =(x+2)(x+6)^{2}.\\end{aligned}\n$$\n\nThe factor $(x+6)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=-6$ has multiplicity $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278323/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f3a53bf2-3144-5da3-8ee7-54d1e6c8fd7d"] :knowledge-point/questions ["q-278323"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1782/selection/557015e94af5fa4bd02ae0ff131d8572cb165f5648829317508c9b9e01215bfe" :answer/id #uuid "6c4aee4c-a585-5e23-9f18-7d12fa99aa67" :answer/type :answer.type/math :answer/value "240" :db/ensure [:answer/validate]} {:db/id "q-1782/selection/54cfebb7812c62c403fa4750caa00c349a4a8a6f3740641546f8b756058a6fc0" :answer/id #uuid "8d6f9e82-7377-5757-a939-be9c37e4fb77" :answer/type :answer.type/math :answer/value "192" :db/ensure [:answer/validate]} {:db/id "q-1782/selection/49f58b98d094bc5718e9bca57bba828bf6c24ca0f902b8bf7f0a9e936e7372e6" :answer/id #uuid "b76342ef-1fa4-505e-ba84-4202ed234ccd" :answer/type :answer.type/math :answer/value "288" :db/ensure [:answer/validate]} {:db/id "q-1782/selection/71cd867541a751c08f12f1f6b17514091dfaff765e3fa2745507f3aa4674fcce" :answer/id #uuid "4ea52587-0bb3-58a5-b419-fecfcb389ecf" :answer/type :answer.type/math :answer/value "184" :db/ensure [:answer/validate]} {:db/id "q-1782/selection/95ac2d914e913ce5a0646a60205eeda6ed483bffcfa34595388d6030d8225ba9" :answer/id #uuid "41049447-59bb-5baf-a669-703dc5e17be5" :answer/type :answer.type/math :answer/value "212" :db/ensure [:answer/validate]} {:db/id "q-1782/selection" :answer-field/id #uuid "3da9f444-bfcc-5af1-9541-10b98e9bb28d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1782/selection/49f58b98d094bc5718e9bca57bba828bf6c24ca0f902b8bf7f0a9e936e7372e6" :answer-field/choices ["q-1782/selection/557015e94af5fa4bd02ae0ff131d8572cb165f5648829317508c9b9e01215bfe" "q-1782/selection/54cfebb7812c62c403fa4750caa00c349a4a8a6f3740641546f8b756058a6fc0" "q-1782/selection/49f58b98d094bc5718e9bca57bba828bf6c24ca0f902b8bf7f0a9e936e7372e6" "q-1782/selection/71cd867541a751c08f12f1f6b17514091dfaff765e3fa2745507f3aa4674fcce" "q-1782/selection/95ac2d914e913ce5a0646a60205eeda6ed483bffcfa34595388d6030d8225ba9"] :db/ensure [:answer-field/validate]} {:db/id "q-1782" :question/id #uuid "56c331b9-384a-590b-8b8b-b1ee0440652b" :question/math-academy-id "q-1782" :question/problem "How many possible outcomes are there if a six-sided die is rolled twice and a coin is flipped three times?" :question/worked-solution "For the die, there is a total of $6$ outcomes: $1,2,3,4,5,6.$\n\nFor the coin, there are just $2$ outcomes: \"Heads\" and \"Tails\".\n\nUsing the **rule of product**, we have\n\n$$\n\\begin{aligned}\\text{Total Possible Outcomes} & =\\text{Number of outcomes on the }1\\text{st roll of the die} \\\\  & \\times \\text{Number of outcomes on the }2\\text{nd roll of the die} \\\\  & \\times \\text{Number of outcomes on the }1\\text{st flip of the coin} \\\\  & \\times \\text{Number of outcomes on the }2\\text{nd flip of the coin} \\\\  & \\times \\text{Number of outcomes on the }3\\text{rd flip of the coin} \\\\  & =6\\times 6\\times 2\\times 2\\times 2 \\\\  & ={6}^{2}\\times {2}^{3} \\\\  & =36\\times 8 \\\\  & =288.\\end{aligned}\n$$\n\nSo, there are $288$ possible outcomes." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-1782/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57bae420-d529-5b9d-a306-37127c523be6"] :knowledge-point/questions ["q-1782"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124708/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" :answer/id #uuid "9cc3bea2-bf18-5239-8995-bfbafbc9e79d" :answer/type :answer.type/text :answer/value "IV" :db/ensure [:answer/validate]} {:db/id "q-124708/selection/cc54ccae9ecbe61a650173303111652be25e358bea2c6fc89973c699ac869f66" :answer/id #uuid "53135176-4823-5652-b808-f3f454f4016e" :answer/type :answer.type/text :answer/value "I" :db/ensure [:answer/validate]} {:db/id "q-124708/selection/6cef23069c284027c89d195df9fea27427e9a7779aa03b92f69bdc30aa1481f3" :answer/id #uuid "29c0c536-47ed-5d55-8abb-887f77baa40f" :answer/type :answer.type/text :answer/value "III" :db/ensure [:answer/validate]} {:db/id "q-124708/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7" :answer/id #uuid "fc5da0e1-303a-5f89-b646-80cffa3bf355" :answer/type :answer.type/text :answer/value "II" :db/ensure [:answer/validate]} {:db/id "q-124708/selection/fedc83039a71afd7ff873189f6d75e2c9ac7feb2068f67bcca48fea646469135" :answer/id #uuid "f29b12cf-0681-552a-9291-c8afe591a4d5" :answer/type :answer.type/text :answer/value "Between quadrants III and IV" :db/ensure [:answer/validate]} {:db/id "q-124708/selection" :answer-field/id #uuid "d2318fc5-025b-5be6-92f0-578b4b9c9707" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124708/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" :answer-field/choices ["q-124708/selection/950b08b6ce80f3e39ed6df93387e6b27d26252dee3574ece2f6ad977f5921545" "q-124708/selection/cc54ccae9ecbe61a650173303111652be25e358bea2c6fc89973c699ac869f66" "q-124708/selection/6cef23069c284027c89d195df9fea27427e9a7779aa03b92f69bdc30aa1481f3" "q-124708/selection/4ca814a26a9344b418765bf1216091351959544cfa5933e8f718fbb4daf8fcd7" "q-124708/selection/fedc83039a71afd7ff873189f6d75e2c9ac7feb2068f67bcca48fea646469135"] :db/ensure [:answer-field/validate]} {:db/id "q-124708" :question/id #uuid "0f82791c-ce92-593f-a20b-ca17b90c99f9" :question/math-academy-id "q-124708" :question/problem "The angle $\\theta =-{430}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{430}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{430}^{∘}+{360}^{∘}=-{70}^{∘}$\n\n- $-{430}^{∘}+2\\cdot {360}^{∘}={290}^{∘}\\,✓$\n\nSo the angle ${290}^{∘}$ is coterminal with $-{430}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944377/assets/dd07505860bd967a66911efca9f20f074798d3d1003776125bf186f7e359bd56.png)\n\nWe see that ${290}^{∘}$ lies in quadrant IV. Therefore, $-{430}^{∘}$ also lies in this quadrant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124708/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee"] :knowledge-point/questions ["q-124708"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113214/selection/d14558c0a4680409672a74cb54516dd06930c44b00113c1bb2e9a9f1c44165d3" :answer/id #uuid "7c81c11d-9c4c-5171-8dbb-a65e4e07ebb7" :answer/type :answer.type/math :answer/value "\\frac{2h-3g}{3h}" :db/ensure [:answer/validate]} {:db/id "q-113214/selection/ce099b769e46d2e6534c71404dcf1c65e183f0ba9b60fe1a46b0ba3f908c3ff2" :answer/id #uuid "e448d047-c827-5a3d-aa17-5a0c41c02bb6" :answer/type :answer.type/math :answer/value "\\frac{5h-2g}{3h}" :db/ensure [:answer/validate]} {:db/id "q-113214/selection/89a4c45ac67a8b243eb0c521bd628c605fff46ee7187da199825a02d5e3daf13" :answer/id #uuid "b5b06186-442f-5426-8a93-e8be287ea1a7" :answer/type :answer.type/math :answer/value "\\frac{h-2g}{h}" :db/ensure [:answer/validate]} {:db/id "q-113214/selection/9ecfdeaa3ac1d075289406d93d54db28598a29c239a372c44461bd17e5c440eb" :answer/id #uuid "4391ba83-9985-5666-a874-6fd703562019" :answer/type :answer.type/math :answer/value "\\frac{5h-g}{h}" :db/ensure [:answer/validate]} {:db/id "q-113214/selection/8f9cac8848040af6f971c234e86d2c929bf170afdfcc20e44298bb5ca0da4cbd" :answer/id #uuid "a1a8cebb-e6f7-5a39-bbed-2e246876a0da" :answer/type :answer.type/math :answer/value "\\frac{5h+g}{3h}" :db/ensure [:answer/validate]} {:db/id "q-113214/selection" :answer-field/id #uuid "0de04443-4625-572a-b5e2-357d359ae109" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113214/selection/ce099b769e46d2e6534c71404dcf1c65e183f0ba9b60fe1a46b0ba3f908c3ff2" :answer-field/choices ["q-113214/selection/d14558c0a4680409672a74cb54516dd06930c44b00113c1bb2e9a9f1c44165d3" "q-113214/selection/ce099b769e46d2e6534c71404dcf1c65e183f0ba9b60fe1a46b0ba3f908c3ff2" "q-113214/selection/89a4c45ac67a8b243eb0c521bd628c605fff46ee7187da199825a02d5e3daf13" "q-113214/selection/9ecfdeaa3ac1d075289406d93d54db28598a29c239a372c44461bd17e5c440eb" "q-113214/selection/8f9cac8848040af6f971c234e86d2c929bf170afdfcc20e44298bb5ca0da4cbd"] :db/ensure [:answer-field/validate]} {:db/id "q-113214" :question/id #uuid "5bcbac58-fdb7-502c-b62c-9e943dff7464" :question/math-academy-id "q-113214" :question/problem "Simplify $\\frac{5g+3h}{3h}-\\frac{7g-2h}{3h}.$" :question/worked-solution "We have a common denominator of $3h,$ so we add the numerators and simplify:\n\n$$\n\\begin{aligned}\\frac{5g+3h}{3h}-\\frac{7g-2h}{3h} & = \\\\ \\frac{5g+3h-(7g-2h)}{3h} & = \\\\ \\frac{5g+3h-7g+2h}{3h} & = \\\\ \\frac{5h-2g}{3h}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113214/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "80d72276-63b0-52c6-b7cf-0f4e2e0392aa"] :knowledge-point/questions ["q-113214"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98106/selection/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" :answer/id #uuid "226e307f-549d-5b33-b939-2f5007c01c61" :answer/type :answer.type/math :answer/value "4\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-98106/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "4ff56dd9-adbb-53bf-8c3d-65ccbd914459" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-98106/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "629362ce-58d2-5c8b-a96b-e6af2e3d794e" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-98106/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "13dd0264-1b15-5b1e-a4a2-d81a936c8d15" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-98106/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "771e8d1c-f207-5e80-8a7d-9b62f607adc7" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-98106/selection" :answer-field/id #uuid "f9f20267-2184-51dc-a012-13aaf2242d7a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98106/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-98106/selection/d79808b1304c1856f3712e6e226ade34c7caf51f0407b91d3e2447e1f8a47743" "q-98106/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-98106/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" "q-98106/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-98106/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-98106" :question/id #uuid "cf94c466-0e89-5582-ac53-67d16fe14203" :question/math-academy-id "q-98106" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944377/assets/1108dd3f3d7114f40a483edbbb353fdc51062892d75097fbf22cb7879e4a52cb.png)\n\nWhat is the length of $\\overset{―}{PQ}$ in the diagram above?" :question/worked-solution "The length of $\\overset{―}{PQ}$ is equal to the distance between $P$ and $Q.$\n\nThe distance $d$ between two points $P({x}_{1},{y}_{1},{z}_{1})$ and $Q({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}+({z}_{2}-{z}_{1})^{2}}.\n$$\n\nSince $P$ and $Q$ have coordinates ${{(3,\\,-2,\\,0)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and ${{(2,0,-2)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}},$ respectively, we have\n\n$$\n\\begin{aligned}PQ & =\\sqrt{(2-3)^{2}+(0-(-2))^{2}+(-2-0)^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98106/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f88bd4db-8477-5822-9cda-a608e78039e5"] :knowledge-point/questions ["q-98106"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79480/selection/374614cc5c3b29fcd6e6052fd09d50fe039837ce3cdb6a476155362b1b57fd2e" :answer/id #uuid "8ef47b29-5014-5b9c-829a-f50d7f1700f2" :answer/type :answer.type/math :answer/value "({x}^{8}{y}^{2}-{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})" :db/ensure [:answer/validate]} {:db/id "q-79480/selection/7b134579ef946723355c8b0029f9a8f6293facb7ffd542012621675ce306b12e" :answer/id #uuid "ec3bbf75-15d0-5004-a5e6-864563f67ca2" :answer/type :answer.type/math :answer/value "({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})" :db/ensure [:answer/validate]} {:db/id "q-79480/selection/e0990155bb55d47fad97151751cc11b3489988bb0aa133a4a00a12c0a015e81f" :answer/id #uuid "2315c796-17fd-5a5f-b846-a34aea2322e1" :answer/type :answer.type/math :answer/value "({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})^{2}" :db/ensure [:answer/validate]} {:db/id "q-79480/selection/01e47f0563c838b4117f44f205221715c0145692d492e9de4527318136beccf4" :answer/id #uuid "488d71e1-7a56-5438-b495-f85f3fb5a321" :answer/type :answer.type/math :answer/value "({x}^{8}{y}^{2}-{z}^{2}{w}^{4})(z{w}^{2}+{x}^{4}y)(z{w}^{2}-{x}^{4}y)" :db/ensure [:answer/validate]} {:db/id "q-79480/selection/9840fd3185dcd8d33a99e9fc8b5f9077292ddd8b7fe5951c0e6d4d3913a6ee75" :answer/id #uuid "436734c1-d16c-50fe-b5dc-5eb2c0288c8e" :answer/type :answer.type/math :answer/value "({x}^{4}y+z{w}^{2})^{2}({x}^{4}y-z{w}^{2})" :db/ensure [:answer/validate]} {:db/id "q-79480/selection" :answer-field/id #uuid "c692a434-24a2-563c-b7ff-e0a9ee9f85cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79480/selection/7b134579ef946723355c8b0029f9a8f6293facb7ffd542012621675ce306b12e" :answer-field/choices ["q-79480/selection/374614cc5c3b29fcd6e6052fd09d50fe039837ce3cdb6a476155362b1b57fd2e" "q-79480/selection/7b134579ef946723355c8b0029f9a8f6293facb7ffd542012621675ce306b12e" "q-79480/selection/e0990155bb55d47fad97151751cc11b3489988bb0aa133a4a00a12c0a015e81f" "q-79480/selection/01e47f0563c838b4117f44f205221715c0145692d492e9de4527318136beccf4" "q-79480/selection/9840fd3185dcd8d33a99e9fc8b5f9077292ddd8b7fe5951c0e6d4d3913a6ee75"] :db/ensure [:answer-field/validate]} {:db/id "q-79480" :question/id #uuid "151c40f6-53aa-57e2-8bf8-f090f359eaf8" :question/math-academy-id "q-79480" :question/problem "Factor the expression ${x}^{16}{y}^{4}-{z}^{4}{w}^{8}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that the expression in parenthesis can be written as a difference of squares:\n\n$$\n{x}^{16}{y}^{4}-{z}^{4}{w}^{8}=({({x}^{8}{y}^{2})}^{2}-{({z}^{2}{w}^{4})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n({({x}^{8}{y}^{2})}^{2}-{({z}^{2}{w}^{4})}^{2})=({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{8}{y}^{2}-{z}^{2}{w}^{4})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{8}{y}^{2}-{z}^{2}{w}^{4}) & =({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({({x}^{4}y)}^{2}-{(z{w}^{2})}^{2}) \\\\  & =({x}^{8}{y}^{2}+{z}^{2}{w}^{4})({x}^{4}y+z{w}^{2})({x}^{4}y-z{w}^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-79480/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075"] :knowledge-point/questions ["q-79480"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-288820"] :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=-312,\\,c=22\\,464.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{22\\,464}{1}=22\\,464.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-170486/selection/dc64ec2b48b1e19c6877f2905da5591f0a197bb291ce175bb6a665c7ca5f5dbe" :answer/id #uuid "4cf96a74-bf8b-5616-b853-621704f4d9cc" :answer/type :answer.type/math :answer/value "2.50" :db/ensure [:answer/validate]} {:db/id "q-170486/selection/c2c8b804724153c9054d5064f06cfeb53187b0aaa7d0393caaed2522e3f5868a" :answer/id #uuid "9d582090-d54b-5c95-987e-a9f9bdcd9c9c" :answer/type :answer.type/math :answer/value "1.84" :db/ensure [:answer/validate]} {:db/id "q-170486/selection/857f52d8ce7e5a4d34047f99b5e32f0ad6547a21f44d2c1ea2db049eded12060" :answer/id #uuid "27d7892a-1f33-5503-9b79-7a6cd8c1ecb2" :answer/type :answer.type/math :answer/value "2.19" :db/ensure [:answer/validate]} {:db/id "q-170486/selection/b966f07f99f5777daa432cd875ce149e29d5d2d68740c817a8560493287ac468" :answer/id #uuid "6377ac55-7341-58cc-a4e9-6475fb2091bb" :answer/type :answer.type/math :answer/value "1.98" :db/ensure [:answer/validate]} {:db/id "q-170486/selection/698952e60cb27434c445983160e2f42996f41326757fe9573be6018cd47786db" :answer/id #uuid "23294c06-5958-5083-96ba-a5b558c92e41" :answer/type :answer.type/math :answer/value "2.34" :db/ensure [:answer/validate]} {:db/id "q-170486/selection" :answer-field/id #uuid "fccdcccf-87d1-5f86-9a3a-711bfc1d1d56" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170486/selection/dc64ec2b48b1e19c6877f2905da5591f0a197bb291ce175bb6a665c7ca5f5dbe" :answer-field/choices ["q-170486/selection/dc64ec2b48b1e19c6877f2905da5591f0a197bb291ce175bb6a665c7ca5f5dbe" "q-170486/selection/c2c8b804724153c9054d5064f06cfeb53187b0aaa7d0393caaed2522e3f5868a" "q-170486/selection/857f52d8ce7e5a4d34047f99b5e32f0ad6547a21f44d2c1ea2db049eded12060" "q-170486/selection/b966f07f99f5777daa432cd875ce149e29d5d2d68740c817a8560493287ac468" "q-170486/selection/698952e60cb27434c445983160e2f42996f41326757fe9573be6018cd47786db"] :db/ensure [:answer-field/validate]} {:db/id "q-170486" :question/id #uuid "e4cd7ee2-32ef-5737-aa3c-9d2076f2fe28" :question/math-academy-id "q-170486" :question/problem "Find, in radians to two decimal places, the argument of $z=-8+6\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944377/assets/db85a52dd73f7e908815632bb803c472e507d32f1636c2b4a7f6c72d131405d3.png)\n\nThe complex number $z$ lies in the second quadrant of the complex plane. Therefore $\\frac{\\pi }{2}<\\operatorname{arg}⁡(z)<\\pi .$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\alpha  & =\\frac{6}{8} \\\\ \\alpha  & =\\operatorname{arctan}⁡(\\frac{6}{8}) \\\\  & ≈0.643\\,50.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi -0.643\\,50≈2.50\n$$\n\nto two decimal places." :question/difficulty :question.difficulty/easy :question/requires-calculator true :question/answer-fields ["q-170486/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "833ac63c-235b-5059-ab7c-56eb1e44d79e"] :knowledge-point/questions ["q-170486"] :db/ensure [:knowledge-point/validate]} {:db/id "q-166546/selection/2f080de0ef65f6e5dd2806fa211066253fb2f37c1d406be458ab4efcf0eceed2" :answer/id #uuid "95ae2577-5121-5d70-84b6-b0677cab1664" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-166546/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" :answer/id #uuid "6af38d74-0db8-5f86-9bd5-bc3f5aaff832" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "q-166546/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "c8022c98-46b2-5212-8d80-04a6fdb6aa70" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-166546/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" :answer/id #uuid "1ad32d61-b402-5b60-bd11-5230e3f0e33c" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "q-166546/selection/d9163944d32fa510456dad686b640ed50b3eb5317703de9811e05483c600e0ae" :answer/id #uuid "53aaebdb-a1bf-5178-b7ef-0d5a738b332b" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-166546/selection" :answer-field/id #uuid "2c03a5c4-d3b2-5d41-816e-495ab8b9dae9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-166546/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" :answer-field/choices ["q-166546/selection/2f080de0ef65f6e5dd2806fa211066253fb2f37c1d406be458ab4efcf0eceed2" "q-166546/selection/592b9f18cf04a8c75d513e20b1b4a536540e9c3c0f5c7614ffaf1943dc6c7d15" "q-166546/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" "q-166546/selection/da6ec38f87287c48f97b7f5538a006b7adbc63bec0be5e152accc6b9f3071e1b" "q-166546/selection/d9163944d32fa510456dad686b640ed50b3eb5317703de9811e05483c600e0ae"] :db/ensure [:answer-field/validate]} {:db/id "q-166546" :question/id #uuid "f3d9b943-7742-5c93-9ddb-be1c3eff9200" :question/math-academy-id "q-166546" :question/problem "Find the equation of the vertical asymptote of the function $f(x)={log}_{5}⁡(2x+4)-1.$" :question/worked-solution "The equation of the vertical asymptote of the function $y={log}_{5}⁡x$ is $x=0.$\n\nTo find the equation of the vertical asymptote of $f(x),$ we set the argument of the logarithmic term equal to zero, and solve for $x.$ This gives\n\n$$\n\\begin{aligned}2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the vertical asymptote is $x=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-166546/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2f6f4cfa-db03-5ae6-9f43-79fd3167c473"] :knowledge-point/questions ["q-166546"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-148297"] :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{x-6}{3-2x}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{y-6}{3-2y}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{y-6}{3-2y} \\\\ x(3-2y) & =y-6 \\\\ 3x-2xy & =y-6 \\\\ 3x+6 & =2xy+y \\\\ 3x+6 & =y(2x+1) \\\\ y & =\\frac{3x+6}{2x+1}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{3x+6}{2x+1}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]}]
