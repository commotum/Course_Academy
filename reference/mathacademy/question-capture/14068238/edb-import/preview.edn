xt{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})(-{e}^{-x})\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I.\\end{aligned}\n$$\n\nFinally, substituting this back into our equation for $I,$ we can subsequently solve for $I.$ We remember to add a constant of integration $C$ at the end.\n\n$$\n\\begin{aligned}I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}J \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}+\\frac{1}{2}(-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{2}-\\frac{1}{2}I) \\\\ I & =\\frac{{e}^{-x}\\operatorname{sin}⁡(2x)}{2}-\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)}{4}-\\frac{1}{4}I \\\\ \\frac{5}{4}I & =\\frac{2{e}^{-x}\\operatorname{sin}⁡(2x)-{e}^{-x}\\operatorname{cos}⁡(2x)}{4} \\\\ I & =\\frac{{e}^{-x}(2\\operatorname{sin}⁡(2x)-\\operatorname{cos}⁡(2x))}{5}+C\\end{aligned}\n$$" 13194139535596 true] [17592186356763 1000 #edb/ref 17592186356764 13194139535596 true] [17592186356763 1000 #edb/ref 17592186356765 13194139535596 true] [17592186356763 1000 #edb/ref 17592186356766 13194139535596 true] [17592186356763 1000 #edb/ref 17592186356767 13194139535596 true] [17592186356763 1000 #edb/ref 17592186356768 13194139535596 true] [17592186356763 1040 #edb/ref 17592186045450 13194139535596 true] [17592186356763 1041 "selection" 13194139535596 true] [17592186356763 1104 #edb/ref 17592186356768 13194139535596 true] [17592186356763 1110 #uuid "2cb3061d-e7e3-519e-81c2-85723c01683e" 13194139535596 true] [17592186356764 1034 "\\frac{{e}^{-x}\\operatorname{cos}⁡(2x)-2\\operatorname{sin}⁡(2x)}{5}+C" 13194139535596 true] [17592186356764 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356764 1111 #uuid "ef328b71-5429-5c24-b16d-c38538c954b4" 13194139535596 true] [17592186356765 1034 "\\frac{{e}^{-x}(2\\operatorname{cos}⁡(2x)-\\operatorname{sin}⁡(2x))}{10}+C" 13194139535596 true] [17592186356765 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356765 1111 #uuid "2ee232f3-25a5-5b03-815a-c7b8ae0868ad" 13194139535596 true] [17592186356766 1034 "\\frac{{e}^{-x}(3\\operatorname{cos}⁡(2x)-4\\operatorname{sin}⁡(2x))}{5}+C" 13194139535596 true] [17592186356766 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356766 1111 #uuid "5c356490-5840-5014-801a-171475c60f35" 13194139535596 true] [17592186356767 1034 "\\frac{{e}^{-x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x))}{10}+C" 13194139535596 true] [17592186356767 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356767 1111 #uuid "539c164c-7a9b-5536-876e-f666e199a2e1" 13194139535596 true] [17592186356768 1034 "\\frac{{e}^{-x}(2\\operatorname{sin}⁡(2x)-\\operatorname{cos}⁡(2x))}{5}+C" 13194139535596 true] [17592186356768 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356768 1111 #uuid "55a09822-55c1-51d9-bbb2-2a2c416bcde6" 13194139535596 true] [17592186356769 1017 #edb/ref 17592186356770 13194139535596 true] [17592186356769 1089 "q-362667" 13194139535596 true] [17592186356769 1091 #edb/ref 17592186045464 13194139535596 true] [17592186356769 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}{e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x=\\frac{2}{5}($\n{{field-1}} $)$" 13194139535596 true] [17592186356769 1113 #uuid "b311e86d-b621-57b8-a97e-35353c4497de" 13194139535596 true] [17592186356769 1145 "Let's denote the indefinite integral by  $I=\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that \n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{1}{2}\\operatorname{cos}⁡(2x).\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =({e}^{-x})\\,(-\\frac{1}{2}\\operatorname{cos}⁡(2x))-\\int (-\\frac{1}{2}\\operatorname{cos}⁡(2x))(-{e}^{-x})\\,\\text{d}x \\\\  & =-\\frac{1}{2}{e}^{-x}\\operatorname{cos}⁡(2x)-\\frac{1}{2}\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{1}{2}{e}^{-x}\\operatorname{cos}⁡(2x)-\\frac{1}{2}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⇒\\,v=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{1}{2}\\operatorname{sin}⁡(2x).\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =({e}^{-x})\\,(\\frac{1}{2}\\operatorname{sin}⁡(2x))-\\int (\\frac{1}{2}\\operatorname{sin}⁡(2x))(-{e}^{-x})\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{-x}\\operatorname{sin}⁡(2x)+\\frac{1}{2}I.\\end{aligned}\n$$\n\nSubstituting this into our equation for $I,$ we solve:\n\n$$\n\\begin{aligned}I & =-\\frac{1}{2}{e}^{-x}\\operatorname{cos}⁡(2x)-\\frac{1}{2}(\\frac{1}{2}{e}^{-x}\\operatorname{sin}⁡(2x)+\\frac{1}{2}I) \\\\ I & =-\\frac{1}{2}{e}^{-x}\\operatorname{cos}⁡(2x)-\\frac{1}{4}{e}^{-x}\\operatorname{sin}⁡(2x)-\\frac{1}{4}I \\\\ \\frac{5}{4}I & =-{e}^{-x}(\\frac{1}{4}\\operatorname{sin}⁡(2x)+\\frac{1}{2}\\operatorname{cos}⁡(2x)) \\\\ I & =-\\frac{{e}^{-x}}{5}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x)).\\end{aligned}\n$$\n\nFinally, we evaluate the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{e}^{-x}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =(-\\frac{{e}^{-x}}{5}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x))){|}_{0}^{\\pi /2} \\\\  & =(-\\frac{{e}^{-\\pi /2}}{5}(0-2))-(-\\frac{1}{5}(0+2)) \\\\  & =\\frac{2{e}^{-\\pi /2}}{5}+\\frac{2}{5} \\\\  & =\\frac{2}{5}(1+{e}^{-\\pi /2}).\\end{aligned}\n$$" 13194139535596 true] [17592186356770 1000 #edb/ref 17592186356771 13194139535596 true] [17592186356770 1040 #edb/ref 17592186045449 13194139535596 true] [17592186356770 1041 "field-1" 13194139535596 true] [17592186356770 1104 #edb/ref 17592186356771 13194139535596 true] [17592186356770 1110 #uuid "47ed4d29-79e3-5321-9125-4aaaf4cd2e1f" 13194139535596 true] [17592186356771 1034 "1+e^{-\\pi/2}" 13194139535596 true] [17592186356771 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356771 1111 #uuid "f1b29cec-586c-53e9-a42e-acae9c1e9747" 13194139535596 true] [17592186356772 1017 #edb/ref 17592186356773 13194139535596 true] [17592186356772 1089 "q-83014" 13194139535596 true] [17592186356772 1091 #edb/ref 17592186045464 13194139535596 true] [17592186356772 1100 "Evaluate ${\\int }_{0}^{\\pi /3}{e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x.$" 13194139535596 true] [17592186356772 1113 #uuid "6014a799-6357-511b-912c-689499b2d877" 13194139535596 true] [17592186356772 1145 "Let's denote the indefinite integral by $I=\\int {e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x)\\, & ⇒\\,v=\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(3x)}{3}.\\end{aligned}\n$$\n\nThen, using the formula of integration by parts, we get\n\n$$\n\\begin{aligned}I & =\\int {e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(-\\frac{\\operatorname{cos}⁡(3x)}{3})-\\int (-\\frac{\\operatorname{cos}⁡(3x)}{3})(-{e}^{-x})\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}\\int {e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}J.\\end{aligned}\n$$\n\nAgain, we can use integration by parts to evaluate\n\n$$\nJ=\\int {e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x.\n$$\n\nTo do this, let's suppose that\n\n$$\n\\begin{aligned}u={e}^{-x}\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}x}=-{e}^{-x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x)\\, & ⇒\\,v=\\int \\operatorname{cos}⁡(3x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}J & =\\int {e}^{-x}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={e}^{-x}(\\frac{\\operatorname{sin}⁡(3x)}{3})-\\int (\\frac{\\operatorname{sin}⁡(3x)}{3})(-{e}^{-x})\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{3}+\\frac{1}{3}\\int {e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{3}+\\frac{1}{3}I.\\end{aligned}\n$$\n\nSo, substituting this into our equation for $I,$ we can subsequently solve for $I:$\n\n$$\n\\begin{aligned}I & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}J \\\\ I & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}(\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{3}+\\frac{1}{3}I) \\\\ I & =-\\frac{{e}^{-x}\\operatorname{cos}⁡(3x)}{3}-\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)}{9}-\\frac{1}{9}I \\\\ \\frac{10}{9}I & =-\\frac{{e}^{-x}\\operatorname{sin}⁡(3x)+3{e}^{-x}\\operatorname{cos}⁡(3x)}{9} \\\\ I & =-\\frac{{e}^{-x}(\\operatorname{sin}⁡(3x)+3\\operatorname{cos}⁡(3x))}{10}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}{e}^{-x}\\operatorname{sin}⁡(3x)\\,\\text{d}x & =(-\\frac{{e}^{-x}(\\operatorname{sin}⁡(3x)+3\\operatorname{cos}⁡(3x))}{10}){|}_{0}^{\\pi /3} \\\\  & =-\\frac{{e}^{-\\pi /3}(\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{3})+3\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{3}))}{10}+\\frac{{e}^{-0}(\\operatorname{sin}⁡(3\\cdot 0)+3\\operatorname{cos}⁡(3\\cdot 0))}{10} \\\\  & =\\frac{3{e}^{-\\pi /3}}{10}+\\frac{3}{10} \\\\  & =\\frac{3}{10}({e}^{-\\pi /3}+1)\\end{aligned}\n$$" 13194139535596 true] [17592186356773 1000 #edb/ref 17592186356774 13194139535596 true] [17592186356773 1000 #edb/ref 17592186356775 13194139535596 true] [17592186356773 1000 #edb/ref 17592186356776 13194139535596 true] [17592186356773 1000 #edb/ref 17592186356777 13194139535596 true] [17592186356773 1000 #edb/ref 17592186356778 13194139535596 true] [17592186356773 1040 #edb/ref 17592186045450 13194139535596 true] [17592186356773 1041 "selection" 13194139535596 true] [17592186356773 1104 #edb/ref 17592186356777 13194139535596 true] [17592186356773 1110 #uuid "6da96dba-f1f8-51f2-ab01-312cf0472440" 13194139535596 true] [17592186356774 1034 "\\frac{1}{5}({e}^{-\\pi /3}+3)" 13194139535596 true] [17592186356774 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356774 1111 #uuid "e341b494-3998-5018-b341-2b525d4a54d0" 13194139535596 true] [17592186356775 1034 "2{e}^{-\\pi /3}-5" 13194139535596 true] [17592186356775 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356775 1111 #uuid "217c10ff-b118-5cdf-a876-f839638f7775" 13194139535596 true] [17592186356776 1034 "3{e}^{-\\pi /3}+10" 13194139535596 true] [17592186356776 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356776 1111 #uuid "6ffccd6f-179c-535e-bc4e-0f61c4ad7278" 13194139535596 true] [17592186356777 1034 "\\frac{3}{10}({e}^{-\\pi /3}+1)" 13194139535596 true] [17592186356777 1103 #edb/ref 17592186045453 13194139535596 true] [17592186356777 1111 #uuid "0a6f3e76-2de7-5303-ae1b-616ef0f116d5" 13194139535596 true] [17592186356778 1034 "\\frac{3}{5}({e}^{-\\pi /3}-1)" 13194139535596 true] [17592186356778 1103 #edb/ref 17592186045453 13194139535596 true] 