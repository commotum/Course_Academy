Academy/reference/mathacademy/question-capture-workers/linear/14044176/state.json" "file_sha256" "d6c073ab64f52cb58db0936f6c454f3e079fc66b4306dea36c57aafb21a7b489" "basis" 1641 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/edb-import/verification.json"} {"question" "q-120303" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/assets/50b87e86bd2985e54ce0a8fe6b3e23986f7e1946a5284d0ae297d96b9cbc60f6.png)\n\nConsider the diagram above, where $\\overset{\\to }{OM}=m,$ $\\overset{\\to }{ON}=n$ and $P$ divides $\\overset{―}{MN}$ in the ratio $MP:PN=2:1.$ Find $\\overset{\\to }{OP}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/state.json" "file_sha256" "d6c073ab64f52cb58db0936f6c454f3e079fc66b4306dea36c57aafb21a7b489" "basis" 1641 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/edb-import/verification.json"} {"question" "q-120303" "field" nil "attribute" "question/worked-solution" "value" "From the diagram, we see that\n\n$$\n\\overset{\\to }{OP}=\\overset{\\to }{OM}+\\overset{\\to }{MP}.\n$$\n\nWe're told that $\\overset{\\to }{OM}=m,$ so we just need to work out $\\overset{\\to }{MP}.$\n\nFirst, from $△OMN,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{MN} & =\\overset{\\to }{MO}+\\overset{\\to }{ON} \\\\  & =-\\overset{\\to }{OM}+\\overset{\\to }{ON} \\\\  & =-m+n \\\\  & =n-m.\\end{aligned}\n$$\n\nSince $MP:PN=2:1,$ we have\n\n$$\n\\overset{\\to }{MP}=\\frac{2}{3}\\overset{\\to }{MN}=\\frac{2}{3}(n-m).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OP} & =\\overset{\\to }{OM}+\\overset{\\to }{MP} \\\\  & =m+\\frac{2}{3}(n-m) \\\\  & =\\frac{1}{3}m+\\frac{2}{3}n.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/state.json" "file_sha256" "d6c073ab64f52cb58db0936f6c454f3e079fc66b4306dea36c57aafb21a7b489" "basis" 1641 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/edb-import/verification.json"} {"question" "q-120303" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/activity-metadata.json" "file_sha256" "4f3ea802dd0f66ca870281a32fee5a331d99d3806c48f8a1e76495e29627d6a4" "basis" 1641 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/edb-import/verification.json"} {"question" "q-120303" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/state.json" "file_sha256" "d6c073ab64f52cb58db0936f6c454f3e079fc66b4306dea36c57aafb21a7b489" "basis" 1641 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/edb-import/verification.json"} {"question" "q-120303" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\overset{\\to }{OP}=\\frac{1}{2}m+\\frac{1}{2}n"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/state.json" "file_sha256" "d6c073ab64f52cb58db0936f6c454f3e079fc66b4306dea36c57aafb21a7b489" "basis" 1641 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14044176/edb-import/verification.json"} {"question" "q-120303" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\overset{\\to }{OP}=\\frac{1}{3}m+\\frac{2}{3}n"