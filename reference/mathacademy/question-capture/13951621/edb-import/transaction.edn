{i}}{1+2\\text{i}}=$" :question/worked-solution "The denominator is $1+2\\text{i}$ and its conjugate is $1-2\\text{i}.$ We multiply both the numerator and the denominator by $1-2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{15\\text{i}}{1+2\\text{i}} & =\\frac{15\\text{i}}{1+2\\text{i}}\\cdot \\frac{1-2\\text{i}}{1-2\\text{i}} \\\\  & =\\frac{15\\text{i}-30{\\text{i}}^{2}}{{1}^{2}-{2}^{2}{\\text{i}}^{2}} \\\\  & =\\frac{15\\text{i}-30(-1)}{1-4(-1)} \\\\  & =\\frac{15\\text{i}+30}{1+4} \\\\  & =\\frac{30+15\\text{i}}{5}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{30+15\\text{i}}{5}=\\frac{30}{5}+\\frac{15}{5}\\text{i}=6+3\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74644/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-74644"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316861/field-1/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" :answer/id #uuid "9661c8aa-1cb0-502a-811a-dae34f2cfbfc" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "q-316861/field-1" :answer-field/id #uuid "34939488-77e3-59a8-a8fa-c76fdafe6fa9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316861/field-1/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792" :answer-field/choices ["q-316861/field-1/8de7a84a41666d4612460439d17949f75cc9ba4883ff75d5034a1786c2a06792"] :db/ensure [:answer-field/validate]} {:db/id "q-316861/field-2/19d5466e84349f416e7f242f3eae0e8ce9f2558634cf0796beb62f8e60f5ea80" :answer/id #uuid "62964329-b2f4-5a95-a1d9-6811ee98575c" :answer/type :answer.type/math :answer/value "-\