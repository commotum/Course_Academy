[{:db/id "q-316904/field-1/3d7b8e83ef969b70be9dd86ed903a0f40e9a4e4de3c5302d5768c6e2d054a780" :answer/id #uuid "1c37ba39-e719-5983-9ff5-f6447f7e974e" :answer/type :answer.type/math :answer/value "-\\frac{16}{13}" :db/ensure [:answer/validate]} {:db/id "q-316904/field-1/67dca9eae8121d587dbf3a6645e4651b4f4ad5581f802a1da93ef77ae21c14bd" :answer/id #uuid "69274d97-1df3-54e5-a65e-c988603ba447" :answer/type :answer.type/math :answer/value "\\frac{16}{13}" :db/ensure [:answer/validate]} {:db/id "q-316904/field-1" :answer-field/id #uuid "095e16a8-3a79-5cc1-b77c-c18462414596" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316904/field-1/3d7b8e83ef969b70be9dd86ed903a0f40e9a4e4de3c5302d5768c6e2d054a780" :answer-field/choices ["q-316904/field-1/3d7b8e83ef969b70be9dd86ed903a0f40e9a4e4de3c5302d5768c6e2d054a780" "q-316904/field-1/67dca9eae8121d587dbf3a6645e4651b4f4ad5581f802a1da93ef77ae21c14bd"] :db/ensure [:answer-field/validate]} {:db/id "q-316904/field-2/a8b02441353d299eb85f741ce1b76f97bd2b0c3f5e0046fa25d39f059389d1cf" :answer/id #uuid "9bdc5b66-6608-56d4-bd89-df374350f4a6" :answer/type :answer.type/math :answer/value "\\frac{11}{13}" :db/ensure [:answer/validate]} {:db/id "q-316904/field-2" :answer-field/id #uuid "ed86f562-7f92-581c-8aba-9ee39c907bd9" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316904/field-2/a8b02441353d299eb85f741ce1b76f97bd2b0c3f5e0046fa25d39f059389d1cf" :answer-field/choices ["q-316904/field-2/a8b02441353d299eb85f741ce1b76f97bd2b0c3f5e0046fa25d39f059389d1cf"] :db/ensure [:answer-field/validate]} {:db/id "q-316904" :question/id #uuid "1599423c-9248-5ffa-9d17-823c2bf2328f" :question/math-academy-id "q-316904" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{5+2\\text{i}}{-2-3\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $-2-3\\text{i}$ and its conjugate is $-2+3\\text{i}.$ We multiply both the numerator and the denominator by $-2+3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{5+2\\text{i}}{-2-3\\text{i}} & =\\frac{5+2\\text{i}}{-2-3\\text{i}}\\cdot \\frac{-2+3\\text{i}}{-2+3\\text{i}} \\\\  & =\\frac{(5+2\\text{i})(-2+3\\text{i})}{(-2)^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{-10+15\\text{i}-4\\text{i}+6{\\text{i}}^{2}}{4-(-9)} \\\\  & =\\frac{-10+11\\text{i}+6(-1)}{13} \\\\  & =\\frac{-16+11\\text{i}}{13}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-16+11\\text{i}}{13}=(-\\frac{16}{13})+(\\frac{11}{13})\\,\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316904/field-1" "q-316904/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64d7a092-1997-5305-b44c-47c41bc9ac57"] :knowledge-point/questions ["q-316904"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74611/selection/d8ae62a5ca16d42d30f667041234db9d1bbfe47c09dc8073450d8393248d8682" :answer/id #uuid "8e22a568-2478-5da3-a7c7-65f68c1d464c" :answer/type :answer.type/math :answer/value "\\frac{5}{7}-\\frac{11}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74611/selection/682fe59f890fc78dc5680c09043a2455583480d8868606aac9addd0c21ad1bfd" :answer/id #uuid "e6895bbb-0ef0-5273-90f0-fefce543b7fe" :answer/type :answer.type/math :answer/value "\\frac{7}{5}+\\frac{11}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74611/selection/57fb9b8d99e0e3228ef83fbd8d7fea01bbc5269fb601eb662e874f42ebc1c170" :answer/id #uuid "1e890b79-f123-56bb-bcb6-694d4de346d4" :answer/type :answer.type/math :answer/value "\\frac{2}{5}-\\frac{11}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74611/selection/bbf1ee2e4a761429ffc7fd7ceabc885bc0d81bbffe79509111d9efd273a592c1" :answer/id #uuid "bf6ad37a-62c7-59a9-a400-42923d0478fc" :answer/type :answer.type/math :answer/value "-\\frac{7}{5}+\\frac{11}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74611/selection/2c1b2938bc94e7243896c9f2b7553d58f4e7f468f70f7306c905c7beccab30bd" :answer/id #uuid "19ff6e3a-a94f-5430-a9a9-d940c8251d15" :answer/type :answer.type/math :answer/value "-\\frac{7}{5}-\\frac{11}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-74611/selection" :answer-field/id #uuid "f49a89d0-e64e-5fce-a104-773446256cb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74611/selection/2c1b2938bc94e7243896c9f2b7553d58f4e7f468f70f7306c905c7beccab30bd" :answer-field/choices ["q-74611/selection/d8ae62a5ca16d42d30f667041234db9d1bbfe47c09dc8073450d8393248d8682" "q-74611/selection/682fe59f890fc78dc5680c09043a2455583480d8868606aac9addd0c21ad1bfd" "q-74611/selection/57fb9b8d99e0e3228ef83fbd8d7fea01bbc5269fb601eb662e874f42ebc1c170" "q-74611/selection/bbf1ee2e4a761429ffc7fd7ceabc885bc0d81bbffe79509111d9efd273a592c1" "q-74611/selection/2c1b2938bc94e7243896c9f2b7553d58f4e7f468f70f7306c905c7beccab30bd"] :db/ensure [:answer-field/validate]} {:db/id "q-74611" :question/id #uuid "a8c9fe5f-f092-5b94-8f94-9f25e87326f8" :question/math-academy-id "q-74611" :question/problem "if ${z}_{1}=3-5\\text{i}$ and ${z}_{2}=1+2\\text{i}$, then ${z}_{1}$ divided by ${z}_{2}$ equals" :question/worked-solution "First, we set up the fraction:\n\n$$\n\\frac{3-5\\text{i}}{1+2\\text{i}}\n$$\n\nThe denominator is $1+2\\text{i}$ and its conjugate is $1-2\\text{i}.$ We multiply both the numerator and the denominator by $1-2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{z}_{1}}{{z}_{2}} & =\\frac{3-5\\text{i}}{1+2\\text{i}} \\\\  & =\\frac{3-5\\text{i}}{1+2\\text{i}}\\cdot \\frac{1-2\\text{i}}{1-2\\text{i}} \\\\  & =\\frac{3-6\\text{i}-5\\text{i}+10{\\text{i}}^{2}}{{1}^{2}-{2}^{2}{\\text{i}}^{2}} \\\\  & =\\frac{3-11\\text{i}+10(-1)}{{1}^{2}+{2}^{2}} \\\\  & =\\frac{3-11\\text{i}-10}{1+4} \\\\  & =\\frac{-7-11\\text{i}}{5}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-7-11\\text{i}}{5}=-\\frac{7}{5}-\\frac{11}{5}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74611/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64d7a092-1997-5305-b44c-47c41bc9ac57"] :knowledge-point/questions ["q-74611"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316755/field-1/c55ed1cd846063a6fa5ea6e94164969885af62192335c3ee072fa3a06bc33e42" :answer/id #uuid "5409c2c8-8bc4-5b80-8688-416d06414c7e" :answer/type :answer.type/math :answer/value "\\frac{11}{65}" :db/ensure [:answer/validate]} {:db/id "q-316755/field-1/66361b9f6fbf2998a01cd0750ccbaccdd3870cb55520e204bc70178172da56fc" :answer/id #uuid "d84f3f85-0bac-5714-9144-2e45d672fe35" :answer/type :answer.type/math :answer/value "-\\frac{11}{65}" :db/ensure [:answer/validate]} {:db/id "q-316755/field-1" :answer-field/id #uuid "49c2262f-6afa-53cb-8968-1218151257cc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316755/field-1/c55ed1cd846063a6fa5ea6e94164969885af62192335c3ee072fa3a06bc33e42" :answer-field/choices ["q-316755/field-1/c55ed1cd846063a6fa5ea6e94164969885af62192335c3ee072fa3a06bc33e42" "q-316755/field-1/66361b9f6fbf2998a01cd0750ccbaccdd3870cb55520e204bc70178172da56fc"] :db/ensure [:answer-field/validate]} {:db/id "q-316755/field-2/45c68c38c268be1b23f3cb7ecd60ba34be25f17938ae43d28d1e0d081ff6ecdb" :answer/id #uuid "7014e7be-206b-5dfc-9e20-eaf8d844e0db" :answer/type :answer.type/math :answer/value "\\frac{62}{65}" :db/ensure [:answer/validate]} {:db/id "q-316755/field-2" :answer-field/id #uuid "40605da4-386e-554d-858c-68bff1e17dfe" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316755/field-2/45c68c38c268be1b23f3cb7ecd60ba34be25f17938ae43d28d1e0d081ff6ecdb" :answer-field/choices ["q-316755/field-2/45c68c38c268be1b23f3cb7ecd60ba34be25f17938ae43d28d1e0d081ff6ecdb"] :db/ensure [:answer-field/validate]} {:db/id "q-316755" :question/id #uuid "e153e5a9-f6b6-5107-8a56-e685d6dc9017" :question/math-academy-id "q-316755" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{-6+5\\text{i}}{4+7\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $4+7\\text{i}$ and its conjugate is $4-7\\text{i}.$ We multiply both the numerator and the denominator by $4-7\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{-6+5\\text{i}}{4+7\\text{i}} & =\\frac{-6+5\\text{i}}{4+7\\text{i}}\\cdot \\frac{4-7\\text{i}}{4-7\\text{i}} \\\\  & =\\frac{(-6+5\\text{i})(4-7\\text{i})}{(4+7\\text{i})(4-7\\text{i})} \\\\  & =\\frac{-24+42\\text{i}+20\\text{i}-35{\\text{i}}^{2}}{{4}^{2}-(7\\text{i})^{2}} \\\\  & =\\frac{-24+62\\text{i}-35(-1)}{{4}^{2}+{7}^{2}} \\\\  & =\\frac{-24+62\\text{i}+35}{16+49} \\\\  & =\\frac{11+62\\text{i}}{65}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\frac{11+62\\text{i}}{65}=(\\frac{11}{65})+(\\frac{62}{65})\\,\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316755/field-1" "q-316755/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64d7a092-1997-5305-b44c-47c41bc9ac57"] :knowledge-point/questions ["q-316755"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316773/field-1/0064d374f806cba8ea43a11831d2980495c6733de7e909ec06431bd236f4f2b3" :answer/id #uuid "138d7477-a3bd-514c-9c83-0a4d1ce00473" :answer/type :answer.type/math :answer/value "\\frac{9}{10}" :db/ensure [:answer/validate]} {:db/id "q-316773/field-1" :answer-field/id #uuid "dc9f8cbe-2713-5346-9dc2-369f432263d8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316773/field-1/0064d374f806cba8ea43a11831d2980495c6733de7e909ec06431bd236f4f2b3" :answer-field/choices ["q-316773/field-1/0064d374f806cba8ea43a11831d2980495c6733de7e909ec06431bd236f4f2b3"] :db/ensure [:answer-field/validate]} {:db/id "q-316773/field-2/bb998fc94e4aed8c97021a44fb0e00d43ddf9b9eaf1318678613a4958894cab8" :answer/id #uuid "aa3962eb-9ada-5f54-948c-b122fe607f5f" :answer/type :answer.type/math :answer/value "-\\frac{17}{10}" :db/ensure [:answer/validate]} {:db/id "q-316773/field-2" :answer-field/id #uuid "3c24b87a-3397-585e-b88a-0a6e2829cd01" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316773/field-2/bb998fc94e4aed8c97021a44fb0e00d43ddf9b9eaf1318678613a4958894cab8" :answer-field/choices ["q-316773/field-2/bb998fc94e4aed8c97021a44fb0e00d43ddf9b9eaf1318678613a4958894cab8"] :db/ensure [:answer-field/validate]} {:db/id "q-316773" :question/id #uuid "3dd3004a-0a49-58ed-9297-bdbfe14a63c8" :question/math-academy-id "q-316773" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{6+\\text{i}}{1+3\\text{i}}=($\n{{field-1}} \n$\\,)\\,+\\,($\n{{field-2}}\n$)\\text{i}$" :question/worked-solution "The denominator is $1+3\\text{i}$ and its conjugate is $1-3\\text{i}.$ We multiply both the numerator and the denominator by $1-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{6+\\text{i}}{1+3\\text{i}} & =\\frac{6+\\text{i}}{1+3\\text{i}}\\cdot \\frac{1-3\\text{i}}{1-3\\text{i}} \\\\  & =\\frac{(6+\\text{i})(1-3\\text{i})}{(1+3\\text{i})(1-3\\text{i})} \\\\  & =\\frac{6-18\\text{i}+\\text{i}-3{\\text{i}}^{2}}{{1}^{2}-(3\\text{i})^{2}} \\\\  & =\\frac{6-17\\text{i}-3(-1)}{1-(-9)} \\\\  & =\\frac{9-17\\text{i}}{10}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{9-17\\text{i}}{10}=(\\frac{9}{10})+(-\\frac{17}{10})\\,\\text{i}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316773/field-1" "q-316773/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64d7a092-1997-5305-b44c-47c41bc9ac57"] :knowledge-point/questions ["q-316773"] :db/ensure [:knowledge-point/validate]} {:db/id "q-167670/selection/26542215c1acfb271fb375e905172ff7d90f81da08dc07820b5a42103f47d333" :answer/id #uuid "59d3d44f-d9b4-542e-9cac-be461f2010af" :answer/type :answer.type/math :answer/value "-3+4\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-167670/selection/86a758792fd9eabe5ec19464afd4cfcba3f98e4e5c2a513616ff348f01c709e7" :answer/id #uuid "3763f200-ca3d-50c3-8bbc-11aba2f53880" :answer/type :answer.type/math :answer/value "\\frac{1}{2}-\\frac{7}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-167670/selection/3cafb932dc38a358da4109928d1968ab4f2f2323f9ffa58aec589319a3880fe4" :answer/id #uuid "6842d239-7e28-50a9-829f-abb73b8f2594" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}+\\frac{4}{3}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-167670/selection/fd6944ff96c79dedc4268c6370fdc1a86548748edb5bbcebca86597ea3face69" :answer/id #uuid "24b85aa9-506b-568d-a828-429d5de70927" :answer/type :answer.type/math :answer/value "\\frac{3}{4}-\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-167670/selection/54ce14152147180cdcefd149e7b0ac7928724b1f3452b9dda6f56b4d4babe640" :answer/id #uuid "f7bd2787-be10-5f08-971d-d6352b08b037" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}-\\frac{5}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-167670/selection" :answer-field/id #uuid "0fad7d82-e734-5818-b622-1f31abb5c496" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-167670/selection/86a758792fd9eabe5ec19464afd4cfcba3f98e4e5c2a513616ff348f01c709e7" :answer-field/choices ["q-167670/selection/26542215c1acfb271fb375e905172ff7d90f81da08dc07820b5a42103f47d333" "q-167670/selection/86a758792fd9eabe5ec19464afd4cfcba3f98e4e5c2a513616ff348f01c709e7" "q-167670/selection/3cafb932dc38a358da4109928d1968ab4f2f2323f9ffa58aec589319a3880fe4" "q-167670/selection/fd6944ff96c79dedc4268c6370fdc1a86548748edb5bbcebca86597ea3face69" "q-167670/selection/54ce14152147180cdcefd149e7b0ac7928724b1f3452b9dda6f56b4d4babe640"] :db/ensure [:answer-field/validate]} {:db/id "q-167670" :question/id #uuid "84548505-14f7-5f3f-bcde-d25a5f7698d7" :question/math-academy-id "q-167670" :question/problem "$\\frac{-3-4\\text{i}}{1-\\text{i}}=$" :question/worked-solution "The denominator is $1-\\text{i}$ and its conjugate is $1+\\text{i}.$ We multiply both the numerator and the denominator by $1+\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{-3-4\\text{i}}{1-\\text{i}} & =\\frac{-3-4\\text{i}}{1-\\text{i}}\\cdot \\frac{1+\\text{i}}{1+\\text{i}} \\\\  & =\\frac{-3-3\\text{i}-4\\text{i}-4{\\text{i}}^{2}}{{1}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{-3-7\\text{i}-4(-1)}{1-(-1)} \\\\  & =\\frac{-3-7\\text{i}+4}{1+1} \\\\  & =\\frac{1-7\\text{i}}{2}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{1-7\\text{i}}{2}=\\frac{1}{2}-\\frac{7}{2}\\text{i}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-167670/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64d7a092-1997-5305-b44c-47c41bc9ac57"] :knowledge-point/questions ["q-167670"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316850/field-1/980c38ae0d7927e6f29720b3d56d711e12817759775548d6a8d3dc9f60b2604c" :answer/id #uuid "1f8cbecc-c7e5-5e90-9187-28f428f47de9" :answer/type :answer.type/math :answer/value "-\\frac{32}{25}" :db/ensure [:answer/validate]} {:db/id "q-316850/field-1" :answer-field/id #uuid "91de5d4d-7126-592e-80ef-b5dadaa948be" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316850/field-1/980c38ae0d7927e6f29720b3d56d711e12817759775548d6a8d3dc9f60b2604c" :answer-field/choices ["q-316850/field-1/980c38ae0d7927e6f29720b3d56d711e12817759775548d6a8d3dc9f60b2604c"] :db/ensure [:answer-field/validate]} {:db/id "q-316850/field-2/c21d13ab5ea1690b55c39c270393b5ebd2947a5b1bfe5b8faed984fe9400166f" :answer/id #uuid "3c0e1086-ce08-5fa2-9da9-ae75f8c0bdb0" :answer/type :answer.type/math :answer/value "\\frac{24}{25}" :db/ensure [:answer/validate]} {:db/id "q-316850/field-2" :answer-field/id #uuid "909ad128-2745-53a8-9279-a0e451489ba4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316850/field-2/c21d13ab5ea1690b55c39c270393b5ebd2947a5b1bfe5b8faed984fe9400166f" :answer-field/choices ["q-316850/field-2/c21d13ab5ea1690b55c39c270393b5ebd2947a5b1bfe5b8faed984fe9400166f"] :db/ensure [:answer-field/validate]} {:db/id "q-316850" :question/id #uuid "610c8180-b5d7-5311-92f5-d44081327a2c" :question/math-academy-id "q-316850" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{8\\text{i}}{3-4\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $3-4\\text{i}$ and its conjugate is $3+4\\text{i}.$ We multiply both the numerator and the denominator by $3+4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{8\\text{i}}{3-4\\text{i}} & =\\frac{8\\text{i}}{3-4\\text{i}}\\cdot \\frac{3+4\\text{i}}{3+4\\text{i}} \\\\  & =\\frac{24\\text{i}+32{\\text{i}}^{2}}{{3}^{2}-(4\\text{i})^{2}} \\\\  & =\\frac{24\\text{i}+32(-1)}{9-(-16)} \\\\  & =\\frac{-32+24\\text{i}}{25}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-32+24\\text{i}}{25}=(-\\frac{32}{25})+(\\frac{24}{25})\\,\\text{i}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316850/field-1" "q-316850/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-316850"] :db/ensure [:knowledge-point/validate]} {:db/id "q-555/selection/3cef0c91007774d35726e0bf4a6f47c1b5d33fa60d61b19cdbaa158788933107" :answer/id #uuid "f390a28f-3d53-5253-99cf-06bb22133c3f" :answer/type :answer.type/math :answer/value "-5+\\frac{2}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-555/selection/a403657762ff5a4b7e06e222b104dfed2460a899e01f0fce1e3e263d93afc723" :answer/id #uuid "eb7dbe76-76cd-50f4-8eb3-a0cb9cac1201" :answer/type :answer.type/math :answer/value "\\frac{1}{5}-\\frac{2}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-555/selection/b34d385e172d5a95127b60ae255c7cc2dde90396576c0181c6fb2682a866762d" :answer/id #uuid "173e402b-3348-54a4-858f-b7ecfcbc646e" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}+\\frac{2}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-555/selection/1dea4215c2bb2ff2f5b315fb500d86b696428381de5c39b16c0c79ab3bc82e17" :answer/id #uuid "2f440557-d087-5155-afd1-7ceb42834f3d" :answer/type :answer.type/math :answer/value "-\\frac{3}{5}+\\frac{2}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-555/selection/45149d2fa6485fd25002f2203de7d7649779d9af916aa35a34195980ab5ba4a2" :answer/id #uuid "82fb813c-495a-5b23-8f49-feccf0d345c1" :answer/type :answer.type/math :answer/value "-1+\\frac{1}{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-555/selection" :answer-field/id #uuid "15e21387-ea93-5735-ad3b-65eaf9eecfeb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-555/selection/b34d385e172d5a95127b60ae255c7cc2dde90396576c0181c6fb2682a866762d" :answer-field/choices ["q-555/selection/3cef0c91007774d35726e0bf4a6f47c1b5d33fa60d61b19cdbaa158788933107" "q-555/selection/a403657762ff5a4b7e06e222b104dfed2460a899e01f0fce1e3e263d93afc723" "q-555/selection/b34d385e172d5a95127b60ae255c7cc2dde90396576c0181c6fb2682a866762d" "q-555/selection/1dea4215c2bb2ff2f5b315fb500d86b696428381de5c39b16c0c79ab3bc82e17" "q-555/selection/45149d2fa6485fd25002f2203de7d7649779d9af916aa35a34195980ab5ba4a2"] :db/ensure [:answer-field/validate]} {:db/id "q-555" :question/id #uuid "f68bfa55-213f-510b-8d57-1979ae37022b" :question/math-academy-id "q-555" :question/problem "$\\frac{\\text{i}}{2-\\text{i}}=$" :question/worked-solution "The denominator is $2-\\text{i}$ and its conjugate is $2+\\text{i}.$ We multiply both the numerator and the denominator by $2+\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{i}}{2-\\text{i}} & =\\frac{\\text{i}}{2-\\text{i}}\\cdot \\frac{2+\\text{i}}{2+\\text{i}} \\\\  & =\\frac{2\\text{i}+{\\text{i}}^{2}}{{2}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{-1+2\\text{i}}{{2}^{2}-(-1)} \\\\  & =\\frac{-1+2\\text{i}}{4+1} \\\\  & =\\frac{-1+2\\text{i}}{5}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-1+2\\text{i}}{5}=-\\frac{1}{5}+\\frac{2}{5}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-555/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-555"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316848/field-1/2975d51709004513603edea75e6b4a3b80948e01184836d4d575ed4097167ce1" :answer/id #uuid "fc6c30d1-8ecf-50e6-a66a-0909c2b8f0ec" :answer/type :answer.type/math :answer/value "-\\frac{7}{10}" :db/ensure [:answer/validate]} {:db/id "q-316848/field-1" :answer-field/id #uuid "4c6ada72-28bf-5950-a297-c0f517d035b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316848/field-1/2975d51709004513603edea75e6b4a3b80948e01184836d4d575ed4097167ce1" :answer-field/choices ["q-316848/field-1/2975d51709004513603edea75e6b4a3b80948e01184836d4d575ed4097167ce1"] :db/ensure [:answer-field/validate]} {:db/id "q-316848/field-2/32ae7988b74cb607c7c7823a6bb28af944ed23a7fa15e564c039c6ef8cab2d6a" :answer/id #uuid "0f5fc1cf-968d-5714-a780-e00c0a91b6cb" :answer/type :answer.type/math :answer/value "\\frac{21}{10}" :db/ensure [:answer/validate]} {:db/id "q-316848/field-2" :answer-field/id #uuid "86bdf9c3-c1fb-5167-946d-240bbabbd436" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316848/field-2/32ae7988b74cb607c7c7823a6bb28af944ed23a7fa15e564c039c6ef8cab2d6a" :answer-field/choices ["q-316848/field-2/32ae7988b74cb607c7c7823a6bb28af944ed23a7fa15e564c039c6ef8cab2d6a"] :db/ensure [:answer-field/validate]} {:db/id "q-316848" :question/id #uuid "e535981f-647e-56d4-8c1b-fdc761659fc0" :question/math-academy-id "q-316848" :question/problem "Evaluate the expression below, expressing your answer in the form $a+b\\text{i},$ where $a$ and $b$ are real numbers.\n\n$\\frac{7\\text{i}}{3-\\text{i}}=($\n{{field-1}} \n$)\\,+\\,($\n{{field-2}}\n$)\\,\\text{i}$" :question/worked-solution "The denominator is $3-\\text{i}$ and its conjugate is $3+\\text{i}.$ We multiply both the numerator and the denominator by $3+\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\frac{7\\text{i}}{3-\\text{i}} & =\\frac{7\\text{i}}{3-\\text{i}}\\cdot \\frac{3+\\text{i}}{3+\\text{i}} \\\\  & =\\frac{21\\text{i}+7{\\text{i}}^{2}}{{3}^{2}-(\\text{i})^{2}} \\\\  & =\\frac{21\\text{i}+7(-1)}{9-(-1)} \\\\  & =\\frac{-7+21\\text{i}}{10}.\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\frac{-7+21\\text{i}}{10}=(-\\frac{7}{10})+(\\frac{21}{10})\\,\\text{i}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-316848/field-1" "q-316848/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-316848"] :db/ensure [:knowledge-point/validate]} {:db/id "q-16433/selection/9089dc6d3e09dfd6146e617eb14a09900a823b3312715458ef46a194884fa4c7" :answer/id #uuid "d7b1c68c-2457-5713-bdcb-4ed40192cd37" :answer/type :answer.type/math :answer/value "-\\frac{36}{41}-\\frac{45}{41}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-16433/selection/35e5034edaab1a2d7acca90e32c74fce6048cb1fb19a76e8ff1bf5dc39a94e83" :answer/id #uuid "c9d0d6b4-6b8f-5458-902e-67cb5e0eb4c7" :answer/type :answer.type/math :answer/value "\\frac{26}{41}-\\frac{45}{41}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-16433/selection/fc15f0cc943f0f7bb5e675e68759c5337679781ac466f1987ca7626b9b88561c" :answer/id #uuid "04149162-d45f-5ad5-a5c8-096244656e88" :answer/type :answer.type/math :answer/value "\\frac{36}{41}+\\frac{45}{41}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-16433/selection/c2bf3dc755936bac02ce2336d02f0c37c0dd12a2f397b83b43d0f2e0677ec54a" :answer/id #uuid "83179840-dd1b-5e72-954a-533df91cf8e9" :answer/type :answer.type/math :answer/value "\\frac{36}{41}-\\frac{45}{41}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-16433/selection/6bcb539fbe618b55dc6ed1b6c26d9f4109acff89c27db160e5ba080ad01ea1f3" :answer/id #uuid "6fe6ef84-836f-5264-bccb-870431f66b2c" :answer/type :answer.type/math :answer/value "-\\frac{36}{41}+\\frac{45}{41}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-16433/selection" :answer-field/id #uuid "7da19a51-57ce-5e7d-aa31-27661ae89e41" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16433/selection/c2bf3dc755936bac02ce2336d02f0c37c0dd12a2f397b83b43d0f2e0677ec54a" :answer-field/choices ["q-16433/selection/9089dc6d3e09dfd6146e617eb14a09900a823b3312715458ef46a194884fa4c7" "q-16433/selection/35e5034edaab1a2d7acca90e32c74fce6048cb1fb19a76e8ff1bf5dc39a94e83" "q-16433/selection/fc15f0cc943f0f7bb5e675e68759c5337679781ac466f1987ca7626b9b88561c" "q-16433/selection/c2bf3dc755936bac02ce2336d02f0c37c0dd12a2f397b83b43d0f2e0677ec54a" "q-16433/selection/6bcb539fbe618b55dc6ed1b6c26d9f4109acff89c27db160e5ba080ad01ea1f3"] :db/ensure [:answer-field/validate]} {:db/id "q-16433" :question/id #uuid "0e9471e3-3f65-5f76-b938-80f99b825051" :question/math-academy-id "q-16433" :question/problem "$\\frac{9\\text{i}}{-5+4\\text{i}}=$" :question/worked-solution "The denominator is $-5+4\\text{i}$ and its conjugate is $-5-4\\text{i}.$ We multiply both the numerator and the denominator by $-5-4\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{9\\text{i}}{-5+4\\text{i}} & =\\frac{9\\text{i}}{-5+4\\text{i}}\\cdot \\frac{-5-4\\text{i}}{-5-4\\text{i}} \\\\  & =\\frac{-45\\text{i}-36{\\text{i}}^{2}}{{5}^{2}-{4}^{2}{\\text{i}}^{2}} \\\\  & =\\frac{-45\\text{i}-36(-1)}{{5}^{2}+{4}^{2}} \\\\  & =\\frac{36-45\\text{i}}{25+16} \\\\  & =\\frac{36-45\\text{i}}{41}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{36-45\\text{i}}{41}=\\frac{36}{41}-\\frac{45}{41}\\text{i}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-16433/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "27da4eb7-48c8-58f4-9676-c88d659f5fbb"] :knowledge-point/questions ["q-16433"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74644/selection/3d9b8624741d3efd0c46b08046927d06693d36dd056849dd305d386c4f0f1d2f" :answer/id #u