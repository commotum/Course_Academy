ion" 13194139533909 true] [17592186265113 1104 #edb/ref 17592186265117 13194139533909 true] [17592186265113 1110 #uuid "0fad7d82-e734-5818-b622-1f31abb5c496" 13194139533909 true] [17592186265114 1034 "-3+4\\text{i}" 13194139533909 true] [17592186265114 1103 #edb/ref 17592186045453 13194139533909 true] [17592186265114 1111 #uuid "59d3d44f-d9b4-542e-9cac-be461f2010af" 13194139533909 true] [17592186265115 1034 "-\\frac{2}{3}+\\frac{4}{3}\\text{i}" 13194139533909 true] [17592186265115 1103 #edb/ref 17592186045453 13194139533909 true] [17592186265115 1111 #uuid "6842d239-7e28-50a9-829f-abb73b8f2594" 13194139533909 true] [17592186265116 1034 "-\\frac{3}{2}-\\frac{5}{2}\\text{i}" 13194139533909 true] [17592186265116 1103 #edb/ref 17592186045453 13194139533909 true] [17592186265116 1111 #uuid "f7bd2787-be10-5f08-971d-d6352b08b037" 13194139533909 true] [17592186265117 1034 "\\frac{1}{2}-\\frac{7}{2}\\text{i}" 13194139533909 true] [17592186265117 1103 #edb/ref 17592186045453 13194139533909 true] [17592186265117 1111 #uuid "3763f200-ca3d-50c3-8bbc-11aba2f53880" 13194139533909 true] [17592186265118 1034 "\\frac{3}{4}-\\text{i}" 13194139533909 true] [17592186265118 1103 #edb/ref 17592186045453 13194139533909 true] [17592186265118 1111 #uuid "24b85aa9-506b-568d-a828-429d5de70927" 13194139533909 true] [17592186265119 1017 #edb/ref 17592186265120 13194139533909 true] [17592186265119 1089 "q-167677" 13194139533909 true] [17592186265119 1091 #edb/ref 17592186045463 13194139533909 true] [17592186265119 1100 "$\\frac{5+2\\text{i}}{5\\text{i}}=$" 13194139533909 true] [17592186265119 1113 #uuid "ffce566e-b201-5edb-874f-34eee0332074" 13194139533909 true] [17592186265119 1145 "Here, the denominator is the imaginary number $5\\text{i}.$ Note that this can be written as $0+5\\text{i},$ so the conjugate is $0-5\\text{i},$ or simply $-5\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-5\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned