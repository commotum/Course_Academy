#{[{:db/id #edb/ref 17592186245109 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46e1ef65-ba97-59d6-bd65-df960dc16cd1" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=2" :db/id #edb/ref 17592186245111} {:answer/id #uuid "f0bfb099-8a6a-5cc6-a78d-7c5d66e364e1" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-9" :db/id #edb/ref 17592186245112} {:answer/id #uuid "1eb167df-f1f1-59ea-b387-db22eeef21ac" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=13" :db/id #edb/ref 17592186245113} {:answer/id #uuid "3373581e-36f5-5e34-857f-87a5f26e032d" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-11" :db/id #edb/ref 17592186245114} {:answer/id #uuid "2c4d6ad7-0384-5d01-9f8e-d502b04f1242" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=11" :db/id #edb/ref 17592186245115}] :answer-field/correct {:answer/id #uuid "1eb167df-f1f1-59ea-b387-db22eeef21ac" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=13" :db/id #edb/ref 17592186245113} :answer-field/id #uuid "4d83b716-7050-570f-8678-66d3649e473b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245110}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "dd32a6ba-b317-5a25-8e5a-4d00114f75da" :question/is-example false :question/math-academy-id "q-12979" :question/problem "The equation ${x}^{2}+4x-7=0$ can be written in the form $(x+p)^{2}=q.$   Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+4x-7 & =0 \\\\ {x}^{2}+4x & =7 \\\\ {x}^{2}+2\\cdot 2\\cdot x & =7 \\\\ {x}^{2}+2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =7 \\\\ (x+2)^{2}-4 & =7\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+2)^{2}-4 & =7 \\\\ (x+2)^{2} & =11\\end{aligned}\n$$\n\nHence, $p=2,$ $q=11,$ and $p+q=13.$"}] [{:db/id #edb/ref 17592186245116 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf0370ee-3639-52dc-b7da-9eae590712c9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186245118}] :answer-field/correct {:answer/id #uuid "cf0370ee-3639-52dc-b7da-9eae590712c9" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186245118} :answer-field/id #uuid "86d85c0a-706f-59e8-ba46-26149b9bc006" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245117} {:answer-field/choices [{:answer/id #uuid "a554d079-1248-548d-8fcf-2636e43e2a96" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186245120}] :answer-field/correct {:answer/id #uuid "a554d079-1248-548d-8fcf-2636e43e2a96" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186245120} :answer-field/id #uuid "06b6e853-6ec9-547c-bc9e-9778ae5ab8f8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245119} {:answer-field/choices [{:answer/id #uuid "d30514cf-6385-5cb2-8886-dcb991535c79" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186245122}] :answer-field/correct {:answer/id #uuid "d30514cf-6385-5cb2-8886-dcb991535c79" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186245122} :answer-field/id #uuid "bb7e2100-1dc2-5807-9e3d-08ed87f25dd8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245121} {:answer-field/choices [{:answer/id #uuid "dd08c7dd-44bf-56f5-a3c5-a0aa36048865" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186245124}] :answer-field/correct {:answer/id #uuid "dd08c7dd-44bf-56f5-a3c5-a0aa36048865" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186245124} :answer-field/id #uuid "67381c70-2d56-56ef-9397-3ad678f8e61f" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186245123}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0269080e-8326-5e29-a01a-3fc11244e0cf" :question/is-example false :question/math-academy-id "q-218771" :question/problem "The equation ${x}^{2}+8x+9=0$ is equivalent to$\\,(x\\,\\,+$\n{{field-1}}\n$)^{2}=$\n{{field-2}}, and the solutions are \n\n$x=$\n{{field-3}}\n$\\pm $\n{{field-4}}." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x+9 & =0 \\\\ {x}^{2}+8x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =-9 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =-9 \\\\ (x+4)^{2}-16 & =-9\\end{aligned}\n$$\n\nNow, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =-9 \\\\ (x+4)^{2} & =-9+16 \\\\ (x+4)^{2} & =7\\end{aligned}\n$$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =7 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{7} \\\\ x+4 & =\\pm \\sqrt{7} \\\\ x & =-4\\pm \\sqrt{7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186245125 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca5d1636-159d-524b-8482-5ecfcbf0c1f2" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186245127} {:answer/id #uuid "14d6d389-ef13-53e9-a7ff-5c64776e7614" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186245128} {:answer/id #uuid "29212e40-a7c8-54ed-bb43-98df7f78cfbc" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186245129} {:answer/id #uuid "d40252c2-1c71-59f6-8ccb-27131ff48e3f" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186245130} {:answer/id #uuid "0d846a10-684c-51c8-8bf5-00de4be47fe3" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186245131}] :answer-field/correct {:answer/id #uuid "29212e40-a7c8-54ed-bb43-98df7f78cfbc" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186245129} :answer-field/id #uuid "1efa3de8-5bcd-51bc-b34a-eb359a444846" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245126}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/is-example false :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] [{:db/id #edb/ref 17592186245132 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7c2b6e5-0ae4-5f74-8fd8-befc8f193a3a" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186245134} {:answer/id #uuid "fb9d4587-0d8d-55ef-8d70-f695ba0f8e50" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186245135} {:answer/id #uuid "440e8cbb-dbec-5b07-ba82-f763949c9df9" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186245136} {:answer/id #uuid "6c9a019d-3fc7-5498-a6a2-5b957f128fb2" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-2\\,,\\,\\,{x}_{1}+{x}_{2}=3" :db/id #edb/ref 17592186245137} {:answer/id #uuid "39ea6496-0851-54c3-979a-809742832c27" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=2" :db/id #edb/ref 17592186245138}] :answer-field/correct {:answer/id #uuid "440e8cbb-dbec-5b07-ba82-f763949c9df9" :answer/type {:db/ident :answer.type/math} :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186245136} :answer-field/id #uuid "a0d99164-4eaf-56c3-b1f8-f6f37ea4f249" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245133}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "64d65e23-1a54-5168-a2fd-4320224aa644" :question/is-example false :question/math-academy-id "q-30057" :question/problem "The equation ${x}^{2}-4x+4=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p-q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =1 \\\\ {x}^{2}-2\\cdot x\\cdot 2+{2}^{2} & =1 \\\\ (x-2)^{2} & =1\\end{aligned}\n$$\n\nSo, $p=-2,q=1,$ and $p-q=-3.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =1 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{1} \\\\ x-2 & =\\pm 1 \\\\ x & =2\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+1=3 \\\\ {x}_{2} & =2-1=1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=3$ and ${x}_{2}=1.$ Thus, the sum is $4.$"}] [{:db/id #edb/ref 17592186245139 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72c21c00-30ae-5c0d-9bf7-4070541ed549" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186245141} {:answer/id #uuid "08f3c1f5-13de-5545-b486-ec956571e430" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=20" :db/id #edb/ref 17592186245142} {:answer/id #uuid "9e44b2c3-2b11-5d65-835d-396a2fe5d265" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-16" :db/id #edb/ref 17592186245143} {:answer/id #uuid "7fedf554-7fd5-5355-bdc9-54fcadd67089" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=36" :db/id #edb/ref 17592186245144} {:answer/id #uuid "b74fefc0-7252-5ef9-8fd2-5196d019a0c5" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186245145}] :answer-field/correct {:answer/id #uuid "b74fefc0-7252-5ef9-8fd2-5196d019a0c5" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186245145} :answer-field/id #uuid "dd791d4d-530b-547a-87fe-4746dc7f3d10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186245140}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5e5ee0f9-91f3-5ad4-9847-29c1eae6c95f" :question/is-example false :question/math-academy-id "q-86404" :question/problem "The equation ${y}^{2}+16=-12y$ can be written in the form $(y+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-12y$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{y}^{2}+16 & =-12y \\\\ {y}^{2}+12y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y+{6}^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2}-{6}^{2} & =-16\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+6)^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2} & =20\\end{aligned}\n$$\n\nSo, $p=6,q=20,$ and $p+q=26.$"}]}
