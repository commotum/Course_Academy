\\cdot x+{4}^{2}-{4}^{2} & =-9 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =-9 \\\\ (x+4)^{2}-16 & =-9\\end{aligned}\n$$\n\nNow, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =-9 \\\\ (x+4)^{2} & =-9+16 \\\\ (x+4)^{2} & =7\\end{aligned}\n$$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =7 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{7} \\\\ x+4 & =\\pm \\sqrt{7} \\\\ x & =-4\\pm \\sqrt{7}\\end{aligned}\n$$" 13194139533663 true] [17592186245117 1000 #edb/ref 17592186245118 13194139533663 true] [17592186245117 1040 #edb/ref 17592186045449 13194139533663 true] [17592186245117 1041 "field-1" 13194139533663 true] [17592186245117 1104 #edb/ref 17592186245118 13194139533663 true] [17592186245117 1110 #uuid "86d85c0a-706f-59e8-ba46-26149b9bc006" 13194139533663 true] [17592186245118 1034 "4" 13194139533663 true] [17592186245118 1103 #edb/ref 17592186045453 13194139533663 true] [17592186245118 1111 #uuid "cf0370ee-3639-52dc-b7da-9eae590712c9" 13194139533663 true] [17592186245119 1000 #edb/ref 17592186245120 13194139533663 true] [17592186245119 1040 #edb/ref 17592186045449 13194139533663 true] [17592186245119 1041 "field-2" 13194139533663 true] [17592186245119 1104 #edb/ref 17592186245120 13194139533663 true] [17592186245119 1110 #uuid "06b6e853-6ec9-547c-bc9e-9778ae5ab8f8" 13194139533663 true] [17592186245120 1034 "7" 13194139533663 true] [17592186245120 1103 #edb/ref 17592186045453 13194139533663 true] [17592186245120 1111 #uuid "a554d079-1248-548d-8fcf-2636e43e2a96" 13194139533663 true] [17592186245121 1000 #edb/ref 17592186245122 13194139533663 true] [17592186245121 1040 #edb/ref 17592186045449 13194139533663 true] [17592186245121 1041 "field-3" 13194139533663 true] [17592186245121 1104 #edb/ref 17592186245122 13194139533663 true] [17592186245121 1110 #uuid "bb7e2100-1dc2-5807-9e3d-08ed87f25dd8" 13194139533663 true] [17592186245122 1034 "-4" 13194139533663 true] [17592186245122 1103 #edb/ref 17592186045453 13194139533663 true] [17592186245122 1111 #uuid "d30514cf-6385-5cb2-8886-dcb991535c79" 13194139533663 true] [17592186245123 1000 #edb/ref 17592186245124 13194139533663 true] [17592186245123 1040 #edb/ref 17592186045449 13194139533663 true] [17592186245123 1041 "field-4" 13194139533663 true] [17592186245123 1104 #edb/ref 17592186245124 13194139533663 true] [17592186245123 1110 #uuid "67381c70-2d56-56ef-9397-3ad678f8e61f" 13194139533663 true] [17592186245124 1034 "\\sqrt{7}" 13194139533663 true] [17592186245124 1103 #edb/ref 17592186045453 13194139533663 true] [17592186245124 1111 #uuid "dd08c7dd-44bf-56f5-a3c5-a0aa36048865" 13194139533663 true] [17592186245125 1017 #edb/ref 17592186245126 13194139533663 true] [17592186245125 1089 "q-30055" 13194139533663 true] [17592186245125 1091 #edb/ref 17592186045465 13194139533663 true] [17592186245125 1100 "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" 13194139533663 true] [17592186245125 1113 #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" 13194139533663 true] [17592186245125 1138 false 13194139533663 true] [17592186245125 1145 "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$" 13194139533663 true] [17592186245126 1000 #edb/ref 17592186245127 13194139533663 true] [17592186245126 1000 #edb/ref 17592186245128 13194139533663 true] [17592186245126 1000 #edb/ref 17592186245129 13194139533663 true] [17592186245126 1000 #edb/ref 17592186245130 13194139533663 true] [17592186245126 1000 #edb/ref 17592186245131 13194139533663 true] [17592186245126 1040 #edb/ref 17592186045450 13194139533663 true] [17592186245126 1041 "selection" 13194139533663 true] [17592186245126 1104 #edb/ref 17592186245129 13194139533663 true] [17592186245126 1110 #uuid "1efa3de8-5bcd-51bc-b34a-eb359a444846" 13194139533663 true] [17592186245127 1034 "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533663 true] [17592186245127 1103 #edb/ref 17592186045454 13194139533663 true] [17592186245127 1111 #uuid "ca5d1636-159d-524b-8482-5ecfcbf0c1f2" 13194139533663 true] [17592186245128 1034 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" 13194139533663 true] [17592186245128 1103 #edb/ref 17592186045454 13194139533663 true] [17592186245128 1111 #uuid "14d6d389-ef13-53e9-a7ff-5c64776e7614" 13194139533663 true] [17592186245129 1034 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533663 true] [17592186245129 1103 #edb/ref 17592186045454 13194139533663 true] [17592186245129 1111 #uuid "29212e40-a7c8-54ed-bb43-98df7f78cfbc" 13194139533663 true] [17592186245130 1034 "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533663 true] [17592186245130 1103 #edb/ref 17592186045454 13194139533663 true] [17592186245130 1111 #uuid "d40252c2-1c71-59f6-8ccb-27131ff48e3f" 13194139533663 true] [17592186245131 1034 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" 13194139533663 true] [17592186245131 1103 #edb/ref 17592186045454 13194139533663 true] [17592186245131 1111 #uuid "0d846a10-684c-51c8-8bf5-00de4be47fe3" 13194139533663 true] [17592186245132 1017 #edb/ref 17592186245133 13194139533663 true] [17592186245132 1089 "q-30057" 13194139533663 true] [17592186245132 1091 #edb/ref 17592186045465 13194139533663 true] [17592186245132 1100 "The equation ${x}^{2}-4x+4=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p-q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" 13194139533663 true] [17592186245132 1113 #uuid "64d65e23-1a54-5168-a2fd-4320224aa644" 13194139533663 true] [17592186245132 1138 false 13194139533663 true] [17592186245132 1145 "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =1 \\\\ {x}^{2}-2\\cdot x\\cdot 2+{2}^{2} & =1 \\\\ (x-2)^{2} & =1\\end{aligned}\n$$\n\nSo, $p=-2,q=1,$ and $p-q=-3.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =1 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{1} \\\\ x-2 & =\\pm 1 \\\\ x & =2\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+1=3 \\\\ {x}_{2} & =2-1=1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=3$ and ${x}_{2}=1.$ Thus, the sum is $4.$" 13194139533663 true] [17592186245133 1000 #edb/ref 17592186245134 13194139533663 true] [17592186245133 1000 #edb/ref 17592186245135 13194139533663 true] [17592186245133 1000 #edb/ref 17592186245136 13194139533663 true] [17592186245133 1000 #edb/ref 17592186245137 13194139533663 true] [17592186245133 1000 #edb/ref 17592186245138 13194139533663 true] [17592186245133 1040 #edb/ref 17592186045450 13194139533663 true] [17592186245133 1041 "selection" 13194139533663 true] [17592186245133 1104 #edb/ref 17592186245136 13194139533663 true] [17592186245133 1110 #uuid "a0d99164-4eaf-56c3-b1f8-f6f37ea4f249" 13194139533663 true] [17592186245134 1034 "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=-4" 13194139533663 true] [17592186245134 1103 #edb/ref 17592186045453 13194139533663 true] [17592186245134 1111 #uuid "b7c2b6e5-0ae4-5f74-8fd8-befc8f193a3a" 13194139533663 true] [17592186245135 1034 "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=4" 13194139533663 true] [17592186245135 1103 #edb/ref 17592186045453 13194139533663 true] [17592186245135 1111 #uuid "fb9d4587-0d8d-55ef-8d70-f695ba0f8e50" 13194139533663 true] [17592186245136 1034 "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=4" 13194139533663 true] [17592186245136 1103 #edb/ref 17592186045453 13194139533663 true] [1759218624