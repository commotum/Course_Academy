[{:db/id "q-12979/selection/df85ec774fffcb361e2fa55d6a8e2875317d7926b9904956f5d596aa289a4c11" :answer/id #uuid "2c4d6ad7-0384-5d01-9f8e-d502b04f1242" :answer/type :answer.type/math :answer/value "p+q=11" :db/ensure [:answer/validate]} {:db/id "q-12979/selection/b8957e7313fac752a66d5d1bd0b1aff1710bb4587f45157640be0ef6093a84a1" :answer/id #uuid "3373581e-36f5-5e34-857f-87a5f26e032d" :answer/type :answer.type/math :answer/value "p+q=-11" :db/ensure [:answer/validate]} {:db/id "q-12979/selection/950e5b456d4fbb7c839996b850a887a8830f92845ede5d7bbbdaf7a2d8a17204" :answer/id #uuid "1eb167df-f1f1-59ea-b387-db22eeef21ac" :answer/type :answer.type/math :answer/value "p+q=13" :db/ensure [:answer/validate]} {:db/id "q-12979/selection/857b6bf0c60965057bcc820b29151cebc5d744252338be27d9502c084084f921" :answer/id #uuid "f0bfb099-8a6a-5cc6-a78d-7c5d66e364e1" :answer/type :answer.type/math :answer/value "p+q=-9" :db/ensure [:answer/validate]} {:db/id "q-12979/selection/2babc74b9c41780d5f53f8d70a93eeb0c9c058a60fd3de8f5a9e8e0a598e3b26" :answer/id #uuid "46e1ef65-ba97-59d6-bd65-df960dc16cd1" :answer/type :answer.type/math :answer/value "p+q=2" :db/ensure [:answer/validate]} {:db/id "q-12979/selection" :answer-field/id #uuid "4d83b716-7050-570f-8678-66d3649e473b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12979/selection/950e5b456d4fbb7c839996b850a887a8830f92845ede5d7bbbdaf7a2d8a17204" :answer-field/choices ["q-12979/selection/df85ec774fffcb361e2fa55d6a8e2875317d7926b9904956f5d596aa289a4c11" "q-12979/selection/b8957e7313fac752a66d5d1bd0b1aff1710bb4587f45157640be0ef6093a84a1" "q-12979/selection/950e5b456d4fbb7c839996b850a887a8830f92845ede5d7bbbdaf7a2d8a17204" "q-12979/selection/857b6bf0c60965057bcc820b29151cebc5d744252338be27d9502c084084f921" "q-12979/selection/2babc74b9c41780d5f53f8d70a93eeb0c9c058a60fd3de8f5a9e8e0a598e3b26"] :db/ensure [:answer-field/validate]} {:db/id "q-12979" :question/id #uuid "dd32a6ba-b317-5a25-8e5a-4d00114f75da" :question/math-academy-id "q-12979" :question/is-example false :question/problem "The equation ${x}^{2}+4x-7=0$ can be written in the form $(x+p)^{2}=q.$   Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+4x-7 & =0 \\\\ {x}^{2}+4x & =7 \\\\ {x}^{2}+2\\cdot 2\\cdot x & =7 \\\\ {x}^{2}+2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =7 \\\\ (x+2)^{2}-4 & =7\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+2)^{2}-4 & =7 \\\\ (x+2)^{2} & =11\\end{aligned}\n$$\n\nHence, $p=2,$ $q=11,$ and $p+q=13.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12979/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b"] :knowledge-point/questions ["q-12979"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30055/selection/cc6108aa5dbecc367b483b979b818980a69a1656225cf34d0ef2b187901cca6a" :answer/id #uuid "d40252c2-1c71-59f6-8ccb-27131ff48e3f" :answer/type :answer.type/text :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/ensure [:answer/validate]} {:db/id "q-30055/selection/62817a61bd4a231fbca541c58f7184032448a3d442774e305153dca0080832dc" :answer/id #uuid "14d6d389-ef13-53e9-a7ff-5c64776e7614" :answer/type :answer.type/text :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-30055/selection/028a25db56a4cd092b2d1475739321bab23942b9ac74986b4c416295a69e3026" :answer/id #uuid "ca5d1636-159d-524b-8482-5ecfcbf0c1f2" :answer/type :answer.type/text :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/ensure [:answer/validate]} {:db/id "q-30055/selection/f11648098d23a89b740ff8126987afd2c7a4d3df260a497f9141cc0d4f58cc89" :answer/id #uuid "0d846a10-684c-51c8-8bf5-00de4be47fe3" :answer/type :answer.type/text :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/ensure [:answer/validate]} {:db/id "q-30055/selection/b3c23c2d0f194b262dbbce5ad38e2f567dd72d76081d99d95b15cb6746a6e598" :answer/id #uuid "29212e40-a7c8-54ed-bb43-98df7f78cfbc" :answer/type :answer.type/text :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/ensure [:answer/validate]} {:db/id "q-30055/selection" :answer-field/id #uuid "1efa3de8-5bcd-51bc-b34a-eb359a444846" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30055/selection/b3c23c2d0f194b262dbbce5ad38e2f567dd72d76081d99d95b15cb6746a6e598" :answer-field/choices ["q-30055/selection/cc6108aa5dbecc367b483b979b818980a69a1656225cf34d0ef2b187901cca6a" "q-30055/selection/62817a61bd4a231fbca541c58f7184032448a3d442774e305153dca0080832dc" "q-30055/selection/028a25db56a4cd092b2d1475739321bab23942b9ac74986b4c416295a69e3026" "q-30055/selection/f11648098d23a89b740ff8126987afd2c7a4d3df260a497f9141cc0d4f58cc89" "q-30055/selection/b3c23c2d0f194b262dbbce5ad38e2f567dd72d76081d99d95b15cb6746a6e598"] :db/ensure [:answer-field/validate]} {:db/id "q-30055" :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/is-example false :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30055/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7"] :knowledge-point/questions ["q-30055"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30057/selection/e746727769a81b79f72fa6ece3ad4b0c6645e23c9e511c8c4d696d2b6b1e7212" :answer/id #uuid "39ea6496-0851-54c3-979a-809742832c27" :answer/type :answer.type/math :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=2" :db/ensure [:answer/validate]} {:db/id "q-30057/selection/a97526e7347b212922cd9e530afadc9bf211902df46be7ab3df4cf8e02bbc422" :answer/id #uuid "6c9a019d-3fc7-5498-a6a2-5b957f128fb2" :answer/type :answer.type/math :answer/value "p-q=-2\\,,\\,\\,{x}_{1}+{x}_{2}=3" :db/ensure [:answer/validate]} {:db/id "q-30057/selection/742b8274a81dcf25f5805e1659a1e1a8dd788855cf83b53fbc9b17a1320960db" :answer/id #uuid "fb9d4587-0d8d-55ef-8d70-f695ba0f8e50" :answer/type :answer.type/math :answer/value "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/ensure [:answer/validate]} {:db/id "q-30057/selection/9dea7a9ada55a06460a71a5ddb73d670186df1f34701e069c2ee8f924dcbbf3d" :answer/id #uuid "440e8cbb-dbec-5b07-ba82-f763949c9df9" :answer/type :answer.type/math :answer/value "p-q=-3\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/ensure [:answer/validate]} {:db/id "q-30057/selection/40c08f86bf1eccddec758b6b1fed487236815e4c8d2246f139b8ee480c755a3a" :answer/id #uuid "b7c2b6e5-0ae4-5f74-8fd8-befc8f193a3a" :answer/type :answer.type/math :answer/value "p-q=3\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/ensure [:answer/validate]} {:db/id "q-30057/selection" :answer-field/id #uuid "a0d99164-4eaf-56c3-b1f8-f6f37ea4f249" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30057/selection/9dea7a9ada55a06460a71a5ddb73d670186df1f34701e069c2ee8f924dcbbf3d" :answer-field/choices ["q-30057/selection/e746727769a81b79f72fa6ece3ad4b0c6645e23c9e511c8c4d696d2b6b1e7212" "q-30057/selection/a97526e7347b212922cd9e530afadc9bf211902df46be7ab3df4cf8e02bbc422" "q-30057/selection/742b8274a81dcf25f5805e1659a1e1a8dd788855cf83b53fbc9b17a1320960db" "q-30057/selection/9dea7a9ada55a06460a71a5ddb73d670186df1f34701e069c2ee8f924dcbbf3d" "q-30057/selection/40c08f86bf1eccddec758b6b1fed487236815e4c8d2246f139b8ee480c755a3a"] :db/ensure [:answer-field/validate]} {:db/id "q-30057" :question/id #uuid "64d65e23-1a54-5168-a2fd-4320224aa644" :question/math-academy-id "q-30057" :question/is-example false :question/problem "The equation ${x}^{2}-4x+4=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p-q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =1 \\\\ {x}^{2}-2\\cdot x\\cdot 2+{2}^{2} & =1 \\\\ (x-2)^{2} & =1\\end{aligned}\n$$\n\nSo, $p=-2,q=1,$ and $p-q=-3.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =1 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{1} \\\\ x-2 & =\\pm 1 \\\\ x & =2\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+1=3 \\\\ {x}_{2} & =2-1=1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=3$ and ${x}_{2}=1.$ Thus, the sum is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30057/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7"] :knowledge-point/questions ["q-30057"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86404/selection/8ef54c891663a4f939b441971da1724adeb3353c84f6db72c27df28fdaa5d558" :answer/id #uuid "9e44b2c3-2b11-5d65-835d-396a2fe5d265" :answer/type :answer.type/math :answer/value "p+q=-16" :db/ensure [:answer/validate]} {:db/id "q-86404/selection/18782aa9bead12b63fdf0ddcc54e2f562673d49345c02e85292f010db1f3b2e4" :answer/id #uuid "72c21c00-30ae-5c0d-9bf7-4070541ed549" :answer/type :answer.type/math :answer/value "p+q=6" :db/ensure [:answer/validate]} {:db/id "q-86404/selection/f4fc5cc0c7afc0d01fcd8ba381adc9a3269bd6340a6711d9a9f58a9cbc55e96a" :answer/id #uuid "7fedf554-7fd5-5355-bdc9-54fcadd67089" :answer/type :answer.type/math :answer/value "p+q=36" :db/ensure [:answer/validate]} {:db/id "q-86404/selection/40c7090a48afa4de972457cbedf6fd70507f61a13bb32b4ae2a9f9584d887433" :answer/id #uuid "08f3c1f5-13de-5545-b486-ec956571e430" :answer/type :answer.type/math :answer/value "p+q=20" :db/ensure [:answer/validate]} {:db/id "q-86404/selection/fd309053caa512912433af074460a07278cbe16ce2ffa2e3a2d388af17e734c0" :answer/id #uuid "b74fefc0-7252-5ef9-8fd2-5196d019a0c5" :answer/type :answer.type/math :answer/value "p+q=26" :db/ensure [:answer/validate]} {:db/id "q-86404/selection" :answer-field/id #uuid "dd791d4d-530b-547a-87fe-4746dc7f3d10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86404/selection/fd309053caa512912433af074460a07278cbe16ce2ffa2e3a2d388af17e734c0" :answer-field/choices ["q-86404/selection/8ef54c891663a4f939b441971da1724adeb3353c84f6db72c27df28fdaa5d558" "q-86404/selection/18782aa9bead12b63fdf0ddcc54e2f562673d49345c02e85292f010db1f3b2e4" "q-86404/selection/f4fc5cc0c7afc0d01fcd8ba381adc9a3269bd6340a6711d9a9f58a9cbc55e96a" "q-86404/selection/40c7090a48afa4de972457cbedf6fd70507f61a13bb32b4ae2a9f9584d887433" "q-86404/selection/fd309053caa512912433af074460a07278cbe16ce2ffa2e3a2d388af17e734c0"] :db/ensure [:answer-field/validate]} {:db/id "q-86404" :question/id #uuid "5e5ee0f9-91f3-5ad4-9847-29c1eae6c95f" :question/math-academy-id "q-86404" :question/is-example false :question/problem "The equation ${y}^{2}+16=-12y$ can be written in the form $(y+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-12y$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{y}^{2}+16 & =-12y \\\\ {y}^{2}+12y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y+{6}^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2}-{6}^{2} & =-16\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+6)^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2} & =20\\end{aligned}\n$$\n\nSo, $p=6,q=20,$ and $p+q=26.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-86404/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b"] :knowledge-point/questions ["q-86404"] :db/ensure [:knowledge-point/validate]} {:db/id "q-218771/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "cf0370ee-3639-52dc-b7da-9eae590712c9" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-218771/field-1" :answer-field/id #uuid "86d85c0a-706f-59e8-ba46-26149b9bc006" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-218771/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-218771/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-218771/field-2/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "a554d079-1248-548d-8fcf-2636e43e2a96" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-218771/field-2" :answer-field/id #uuid "06b6e853-6ec9-547c-bc9e-9778ae5ab8f8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-218771/field-2/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-218771/field-2/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-218771/field-3/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "d30514cf-6385-5cb2-8886-dcb991535c79" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-218771/field-3" :answer-field/id #uuid "bb7e2100-1dc2-5807-9e3d-08ed87f25dd8" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-218771/field-3/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-218771/field-3/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-218771/field-4/7346ebe1e5d722acf040262ae8e6e53d26ca80a32da08982328df7eef98b7372" :answer/id #uuid "dd08c7dd-44bf-56f5-a3c5-a0aa36048865" :answer/type :answer.type/math :answer/value "\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "q-218771/field-4" :answer-field/id #uuid "67381c70-2d56-56ef-9397-3ad678f8e61f" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-218771/field-4/7346ebe1e5d722acf040262ae8e6e53d26ca80a32da08982328df7eef98b7372" :answer-field/choices ["q-218771/field-4/7346ebe1e5d722acf040262ae8e6e53d26ca80a32da08982328df7eef98b7372"] :db/ensure [:answer-field/validate]} {:db/id "q-218771" :question/id #uuid "0269080e-8326-5e29-a01a-3fc11244e0cf" :question/math-academy-id "q-218771" :question/is-example false :question/problem "The equation ${x}^{2}+8x+9=0$ is equivalent to$\\,(x\\,\\,+$\n{{field-1}}\n$)^{2}=$\n{{field-2}}, and the solutions are \n\n$x=$\n{{field-3}}\n$\\pm $\n{{field-4}}." :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x+9 & =0 \\\\ {x}^{2}+8x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x & =-9 \\\\ {x}^{2}+2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =-9 \\\\ ({x}^{2}+2\\cdot 4\\cdot x+{4}^{2})-16 & =-9 \\\\ (x+4)^{2}-16 & =-9\\end{aligned}\n$$\n\nNow, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x+4)^{2}-16 & =-9 \\\\ (x+4)^{2} & =-9+16 \\\\ (x+4)^{2} & =7\\end{aligned}\n$$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =7 \\\\ \\sqrt{(x+4)^{2}} & =\\sqrt{7} \\\\ x+4 & =\\pm \\sqrt{7} \\\\ x & =-4\\pm \\sqrt{7}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-218771/field-1" "q-218771/field-2" "q-218771/field-3" "q-218771/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b"] :knowledge-point/questions ["q-218771"] :db/ensure [:knowledge-point/validate]}]
