#{[{:db/id #edb/ref 17592186310780 :knowledge-point/_questions [{:knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222fe8d9-adb9-5edd-9390-b3f17d688162" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=4x" :db/id #edb/ref 17592186310782} {:answer/id #uuid "4fb7c43c-4396-5b6d-93e9-c2fec148eaa8" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=2y" :db/id #edb/ref 17592186310783} {:answer/id #uuid "d27b95c3-9e3e-5631-9fc6-c218385ff2ea" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{1}{2}x" :db/id #edb/ref 17592186310784} {:answer/id #uuid "77218e5c-a3c9-5d7e-bd57-a4edc28c8df4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186310785} {:answer/id #uuid "8f6380dc-ec5b-526c-b610-b79baf1aca19" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{2}y" :db/id #edb/ref 17592186310786}] :answer-field/correct {:answer/id #uuid "77218e5c-a3c9-5d7e-bd57-a4edc28c8df4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2x" :db/id #edb/ref 17592186310785} :answer-field/id #uuid "3f30297e-01ec-5ead-8058-5f9754035dfa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310781}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b24732f9-7b75-59b2-a18e-ce5ccd87f7dd" :question/math-academy-id "q-115633" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(0,0)$ and passes through the point $(-2,-2).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(-2,-2),$ we can substitute $x=-2$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ (-2)^{2} & =4p(-2) \\\\ 4 & =-8p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(-\\frac{1}{2})x \\\\ {y}^{2} & =-2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310787 :knowledge-point/_questions [{:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed876c1a-2d16-52a7-9bcb-ff55c40615b5" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}=2y" :db/id #edb/ref 17592186310789} {:answer/id #uuid "c87b1168-cc41-5895-b603-b4a87f8885d8" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-\\frac{1}{2}(x+2)" :db/id #edb/ref 17592186310790} {:answer/id #uuid "e45e73d0-05d9-5c83-b1ed-353c4d84eae4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2(x-2)" :db/id #edb/ref 17592186310791} {:answer/id #uuid "239eff0d-edd9-53c2-a86d-4cada4c104f1" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=2(y-2)" :db/id #edb/ref 17592186310792} {:answer/id #uuid "cb3aab39-ea5d-5099-b078-4e7f0f42f165" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{1}{2}(y-2)" :db/id #edb/ref 17592186310793}] :answer-field/correct {:answer/id #uuid "e45e73d0-05d9-5c83-b1ed-353c4d84eae4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-2(x-2)" :db/id #edb/ref 17592186310791} :answer-field/id #uuid "01c8a462-5a0e-5a07-955f-fdc851f48edf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310788}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3fde3f01-02c5-5ab5-b410-51985388da3a" :question/math-academy-id "q-115649" :question/problem "Find the equation of the left-opening parabola that has its vertex at $(2,0)$ and passes through the point $(0,-2).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(2,0),$ we substitute $h=2$ and $k=0$ into the equation above and get\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x-2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(0,-2),$ so we can substitute $x=0$ and $y=-2$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4p(x-2) \\\\ (-2)^{2} & =4p(0-2) \\\\ 4 & =-8p \\\\ p & =-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4p(x-2) \\\\ {y}^{2} & =4(-\\frac{1}{2})(x-2) \\\\ {y}^{2} & =-2(x-2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310794 :knowledge-point/_questions [{:knowledge-point/id #uuid "17099881-d7b9-54d9-a29a-4f5f28561cd3" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola with Vertex at the Origin Given Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6855166a-eb20-5b8c-9bdd-d4f82b8dd5dd" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=x" :db/id #edb/ref 17592186310796} {:answer/id #uuid "95e1b072-8623-5139-8d91-ea1d2b505af2" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-3x" :db/id #edb/ref 17592186310797} {:answer/id #uuid "b8ec6c49-2dd6-5185-abae-1c9a8747b0bf" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=5x" :db/id #edb/ref 17592186310798} {:answer/id #uuid "b67a1d70-82c8-5d12-9c27-728401762121" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=-5x" :db/id #edb/ref 17592186310799} {:answer/id #uuid "2fabeea7-4341-563e-a15e-7483d365aca4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=3x" :db/id #edb/ref 17592186310800}] :answer-field/correct {:answer/id #uuid "b8ec6c49-2dd6-5185-abae-1c9a8747b0bf" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}=5x" :db/id #edb/ref 17592186310798} :answer-field/id #uuid "7c2e0abb-4a73-5325-9ef2-55d07dc86546" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310795}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "38c851bc-5ac4-58b7-a5ae-592f984c0c62" :question/math-academy-id "q-11770" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(0,0)$ and passes through the point $(5,5).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(0,0)$ and whose arms open right or left is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSince we know the given parabola passes through the point $(5,5),$ we can substitute $x=5$ and $y=5$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {5}^{2} & =4p(5) \\\\ 25 & =20p \\\\ p & =\\frac{5}{4}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}{y}^{2} & =4px \\\\ {y}^{2} & =4(\\frac{5}{4})x \\\\ {y}^{2} & =5x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096923 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc86c375-c2c4-56b7-a207-0abfc9709f6a" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6746585-8dac-5cd6-bd2c-e1cd97690ee8" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 2)^{2} =-4(x + 2)" :db/id #edb/ref 17592186093945} {:answer/id #uuid "e1e16f5b-cff2-555d-b43e-034be5cec50e" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 2)^{2} = 4(x + 2)" :db/id #edb/ref 17592186093946} {:answer/id #uuid "fa6d2d30-a973-5215-815d-4d34b6370d7f" :answer/type {:db/ident :answer.type/math} :answer/value "(y + 2)^{2} = 8(x - 2)" :db/id #edb/ref 17592186093947} {:answer/id #uuid "478c6025-159b-50e6-aa46-33cd2e54c0c0" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 2)^{2} = 8(x + 2)" :db/id #edb/ref 17592186093948} {:answer/id #uuid "56d7f506-6988-5952-ae84-db77229396b0" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 2)^{2} =-8(x + 2)" :db/id #edb/ref 17592186093949}] :answer-field/correct {:answer/id #uuid "478c6025-159b-50e6-aa46-33cd2e54c0c0" :answer/type {:db/ident :answer.type/math} :answer/value "(y - 2)^{2} = 8(x + 2)" :db/id #edb/ref 17592186093948} :answer-field/id #uuid "ade9309f-de26-5504-a863-b725face8730" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093944}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bbd1ed97-ed69-50ed-938c-aebfe4625b89" :question/math-academy-id "q-11793" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041157/assets/9eb2efa6d60dc4bd1d7915900e60be8a891f824799ed6ada8f2753fa71bb01c6.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "From the diagram we see that the arms of the parabola open to the left. The parabola has its vertex at $(-2,2)$ and passes through the point $(6,10).$\n\nThe general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-2,2),$ we substitute $h=-2$ and $k=2$ into the equation above and get\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x+2).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(6,10),$ so we can substitute $x=6$ and $y=10$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x+2) \\\\ (10-2)^{2} & =4p(6+2) \\\\ 64 & =32p \\\\ p & =2\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-2)^{2} & =4p(x+2) \\\\ (y-2)^{2} & =4(2)(x+2) \\\\ (y-2)^{2} & =8(x+2).\\end{aligned}\n$$\n\nNotice that the arms of the parabola open to the right since $p=2$ is positive."}] [{:db/id #edb/ref 17592186310801 :knowledge-point/_questions [{:knowledge-point/id #uuid "783ca59b-0242-584c-ae47-004a0eb03817" :knowledge-point/title "Finding the Equation of a Left or Right-Opening Parabola Given the Vertex and Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed02d763-7250-5e66-bead-0c9eaa59c5e3" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{8}{3}(x+3)" :db/id #edb/ref 17592186310803} {:answer/id #uuid "9fbb2dd5-42f8-5ad5-96a2-a71ec11bbdd1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{16}{3}(x+3)" :db/id #edb/ref 17592186310804} {:answer/id #uuid "49e3ee38-38b4-5000-824e-22c5cf6aa425" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{16}{3}(x+3)" :db/id #edb/ref 17592186310805} {:answer/id #uuid "06768ac9-3dfa-5c95-a4cf-961872fd75af" :answer/type {:db/ident :answer.type/math} :answer/value "(y+3)^{2}=\\frac{16}{3}(x-1)" :db/id #edb/ref 17592186310806} {:answer/id #uuid "31568890-7d4d-5df6-9f9c-72464e56e92e" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=-\\frac{8}{3}(x+3)" :db/id #edb/ref 17592186310807}] :answer-field/correct {:answer/id #uuid "9fbb2dd5-42f8-5ad5-96a2-a71ec11bbdd1" :answer/type {:db/ident :answer.type/math} :answer/value "(y-1)^{2}=\\frac{16}{3}(x+3)" :db/id #edb/ref 17592186310804} :answer-field/id #uuid "df4b742a-44aa-536c-bf83-94964f9a89fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310802}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "abc820a1-a112-5c23-8115-8df1af84896d" :question/math-academy-id "q-11808" :question/problem "Find the equation of the right-opening parabola that has its vertex at $(-3,1)$ and passes through the point $(0,5).$" :question/worked-solution "The general standard equation of a parabola whose vertex is $(h,k)$ and whose arms open right or left is given by\n\n$$\n\\begin{aligned}(y-k)^{2} & =4p(x-h).\\end{aligned}\n$$\n\nSince we know that the given parabola has its vertex at $(h,k)=(-3,1),$ we substitute $h=-3$ and $k=1$ into the equation above and get\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x+3).\\end{aligned}\n$$\n\nWe also know that the given parabola passes through the point $(0,5),$ so we can substitute $x=0$ and $y=5$ into the equation above and solve for $p:$\n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x+3) \\\\ (5-1)^{2} & =4p(0+3) \\\\ 16 & =12p \\\\ p & =\\frac{4}{3}\\end{aligned}\n$$\n\nSo, the equation of the parabola is \n\n$$\n\\begin{aligned}(y-1)^{2} & =4p(x+3) \\\\ (y-1)^{2} & =4(\\frac{4}{3})(x+3) \\\\ (y-1)^{2} & =\\frac{16}{3}(x+3).\\end{aligned}\n$$"}]}
