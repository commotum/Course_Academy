on/49cedaa65939e20b865a36dac676abd7bb408235d1e3b3b81b7b57c253fe4733"] :db/ensure [:answer-field/validate]} {:db/id "q-11467" :question/id #uuid "3f1e74b3-ef71-5938-b8e6-b401a472ba89" :question/math-academy-id "q-11467" :question/problem "Consider the matrix\n    $C=[\\begin{aligned}6 & 3 & 2 \\\\ 4 & 4 & 1 \\\\ 3 & -2 & 0 \\\\ 4 & 1 & 7\\end{aligned}].$\nWhat are the dimensions of ${C}^{T}?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $m\\times n$ to $n\\times m.$\n\nSo, since $C$ is a $4\\times 3$ matrix, the transpose ${C}^{T}$ is a $3\\times 4$ matrix." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321"] :knowledge-point/questions ["q-11467"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4386"] :question/problem "Find $C^T,$ if \n$[\\begin{aligned}-1 & 1 \\\\ 0 & 2 \\\\ -2 & -3\\end{aligned}]$" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n\n$$\n[\\begin{aligned}-1 & 0 & -2 \\\\ 1 & 2 & -3\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4387"] :question/problem "If\n    ${A} = \n    \\left\\lbrack\n    \\matrix {\n        5 & -1 & 0 \\\n    }\n    \\right\\rbrack,$\nthen what is ${A^T} ?$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{A}^T = \n    \t\t\\left\\lbrack\n    \t\t\\matrix {\n    5 \\ \n    -1 \\ \n    0 \\  \n    \t\t}\n    \t\t\\right\\rbrack\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4388"] :question/problem "Consider the matrix\n    ${B} = \n    \\left\\lbrack\n    \\matrix {\n        1 & 2 & 4 & 2\\\n        4 & 4 & 1 & 1\\\n        3 & -3 & 0 & -1\n    }\n    \\right\\rbrack.$\nWhat are the dimensions of ${B}^T?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $N \\times M$ to $M \\times N.$\n\nSo, since $B$ is a $3 \\times 4$ matrix, the transpose ${B}^T$ is a $4\\times3$ matrix." :db/ensure [:question/validate]}]
