el_interpretation" "file" "reference/mathacademy/question-capture/13973224/state.json" "file_sha256" "f81a6da73d3e3f74ef632c0f1363da84c7a71db359dd65971cc6d083639d49a5"} {"question" "q-11467" "field" nil "attribute" "question/problem" "value" "Consider the matrix\n    $C=[\\begin{aligned}6 & 3 & 2 \\\\ 4 & 4 & 1 \\\\ 3 & -2 & 0 \\\\ 4 & 1 & 7\\end{aligned}].$\nWhat are the dimensions of ${C}^{T}?$" "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/state.json" "file_sha256" "f81a6da73d3e3f74ef632c0f1363da84c7a71db359dd65971cc6d083639d49a5"} {"question" "q-11467" "field" nil "attribute" "question/worked-solution" "value" "When a matrix is transposed, its dimensions switch from $m\\times n$ to $n\\times m.$\n\nSo, since $C$ is a $4\\times 3$ matrix, the transpose ${C}^{T}$ is a $3\\times 4$ matrix." "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/state.json" "file_sha256" "f81a6da73d3e3f74ef632c0f1363da84c7a71db359dd65971cc6d083639d49a5"} {"question" "q-11467" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/activity-metadata.json" "file_sha256" "48e7decd4a6598f288c6775e9dcc29a21d7c37d9fcbf251eb9f4f98a97b403a8"} {"question" "q-11467" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "reference/mathacademy/question-capture/13973224/state.json" "file_sha256" "f81a6da73d3e3f74ef632c0f1363da84c7a71db359dd65971cc6d083639d49a5"} {"question" "q-11467" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1\\times 4"] ["math" "2\\times 1"] ["math" "3\\times 4"] ["math" "4\\times 2"] ["math" "4\\times 3"]] "category" "ma_complete_choices" "file" "reference/mathacademy/question-capture/13973224/state.json" "file_sha256" "f81a6da73d3e3f74ef632c0f1363da84c7a71db359dd65971cc6d083639d49a5"} {"question" "q-11467" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\times 4"] "category" "ma_successful_grade" "file" "reference/mathacademy/question-capture/13973224/state.json" "file_sha256" "f81a6da73d3e3f74ef632c0f1363da84c7a71db359dd65971cc6d083639d49a5"} {"question" "e-4386" "field" nil "attribute" "question/problem" "value" "Find $C^T,$ if \n$[\\begin{aligned}-1 & 1 \\\\ 0 & 2 \\\\ -2 & -3\\end{aligned}]$" "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/example-4386.json" "file_sha256" "08995625a93b2d43b33256d2e68fc5b2dbd3731febf8e9bf552ac60837317f9f"} {"question" "e-4386" "field" nil "attribute" "question/worked-solution" "value" "To find the transpose, we interchange the rows and columns:\n\n$$\n[\\begin{aligned}-1 & 0 & -2 \\\\ 1 & 2 & -3\\end{aligned}]\n$$" "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/example-4386.json" "file_sha256" "08995625a93b2d43b33256d2e68fc5b2dbd3731febf8e9bf552ac60837317f9f"} {"question" "e-4387" "field" nil "attribute" "question/problem" "value" "If\n    ${A} = \n    \\left\\lbrack\n    \\matrix {\n        5 & -1 & 0 \\\n    }\n    \\right\\rbrack,$\nthen what is ${A^T} ?$" "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/example-4387.json" "file_sha256" "3466e1b17c648cabcf1fa818baa7a19eaf8871a1b656f7ba8b79510b395f4a5d"} {"question" "e-4387" "field" nil "attribute" "question/worked-solution" "value" "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{A}^T = \n    \t\t\\left\\lbrack\n    \t\t\\matrix {\n    5 \\ \n    -1 \\ \n    0 \\  \n    \t\t}\n    \t\t\\right\\rbrack\n$$" "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/example-4387.json" "file_sha256" "3466e1b17c648cabcf1fa818baa7a19eaf8871a1b656f7ba8b79510b395f4a5d"} {"question" "e-4388" "field" nil "attribute" "question/problem" "value" "Consider the matrix\n    ${B} = \n    \\left\\lbrack\n    \\matrix {\n        1 & 2 & 4 & 2\\\n        4 & 4 & 1 & 1\\\n        3 & -3 & 0 & -1\n    }\n    \\right\\rbrack.$\nWhat are the dimensions of ${B}^T?$" "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/example-4388.json" "file_sha256" "e2d450311d1947d10c3cd5b8242bcd50867a80e17102e546db7ea1c20ef435bf"} {"question" "e-4388" "field" nil "attribute" "question/worked-solution" "value" "When a matrix is transposed, its dimensions switch from $N \\times M$ to $M \\times N.$\n\nSo, since $B$ is a $3 \\times 4$ matrix, the transpose ${B}^T$ is a $4\\times3$ matrix." "category" "ma_capture" "file" "reference/mathacademy/question-capture/13973224/example-4388.json" "file_sha256" "e2d450311d1947d10c3cd5b8242bcd50867a80e17102e546db7ea1c20ef435bf"}] "usage" {"e-4386" [] "e-4388" [] "e-4387" []} "basis" 751 "retractions" [[17592186059476 :question/problem "Find $C^T$, if\n$\\begin{bmatrix}-1 & 1 \\\\ 0 & 2 \\\\ -2 & -3\\end{bmatrix}$"] [17592186059476 :question/worked-solution "To find the transpose, we interchange the rows and columns:\n$\\begin{bmatrix}-1 & 0 & -2 \\\\ 1 & 2 & -3\\end{bmatrix}$"] [17592186059477 :question/problem "If\n${A} = \\left\\lbrack \\matrix {5 & -1 & 0 \\} \\right\\rbrack$,\nthen what is ${A^T}$?"] [17592186059477 :question/worked-solution "To find the transpose, we interchange the rows and columns.\n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{A}^T = \\left\\lbrack \\matrix {5 \\ -1 \\ 0 \\} \\right\\rbrack\n$$"] [17592186059478 :question/problem "Consider the matrix\n${B} = \\left\\lbrack \\matrix {1 & 2 & 4 & 2\\ 4 & 4 & 1 & 1\\ 3 & -3 & 0 & -1} \\right\\rbrack$.\nWhat are the dimensions of ${B}^T$?"] [17592186059478 :question/worked-solution "When a matrix is transposed, its dimensions switch from $N \\times M$ to $M \\times N$.\n\nSo, since $B$ is a $3 \\times 4$ matrix, the transpose ${B}^T$ is a $4\\times3$ matrix."]] "immutable_answers" [] "immutable_fi