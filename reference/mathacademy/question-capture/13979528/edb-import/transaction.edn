/218a672736ffdc268c9ce1553cf4130a51a04f84fc29c8d276062738ebfb69d1" :answer/id #uuid "21dff4da-152c-51f0-8f60-2665be9c5493" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡3}{{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-78035/selection/9d922917c0bbc022bfc694735a807e2fd921763b371da55bfc83cbb6b2313bbe" :answer/id #uuid "98a78a0e-f1bd-59d2-b190-3846e6726382" :answer/type :answer.type/math :answer/value "e\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "q-78035/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "0a01b433-f5cd-54f3-b145-764324fa1f3c" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-78035/selection/f3dac89f2ee5e33877fb0ae412fdefdc0cdcceb7dcdcd6e702e1e3ff0391e011" :answer/id #uuid "efd04212-5f84-562e-9556-b9baa4bbe8d1" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "q-78035/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "b66bac71-460c-5348-8278-8e120599f52c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-78035/selection" :answer-field/id #uuid "2ace30ae-7a0b-5c03-a519-6ffb17f90ac6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78035/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-78035/selection/218a672736ffdc268c9ce1553cf4130a51a04f84fc29c8d276062738ebfb69d1" "q-78035/selection/9d922917c0bbc022bfc694735a807e2fd921763b371da55bfc83cbb6b2313bbe" "q-78035/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-78035/selection/f3dac89f2ee5e33877fb0ae412fdefdc0cdcceb7dcdcd6e702e1e3ff0391e011" "q-78035/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-78035" :question/id #uuid "2593ec58-15ba-5bdf-a694-27d214610ecd" :question/math-academy-id "q-78035" :question/problem "Evaluate ${lim}_{x\\to \\infty }(\\operatorname{ln}⁡(3x){e}^{-2x}).$" :question/worked-solution "Notice that we can rewrite the first term as\n\n$$\n\\operatorname{ln}⁡(3x){e}^{-2x}=\\frac{\\operatorname{ln}⁡(3x)}{{e}^{2x}}.\n$$\n\nBoth the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{2x}≫\\operatorname{ln}⁡(3x)$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡(3x)}{{e}^{2x}}=0.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\operatorname{ln}⁡(3x){e}^{-2x}) & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡(3x)}{{e}^{2x}}=0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78035/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93"] :knowledge-point/questions ["q-78035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106830/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "617e94d7-3420-5268-a870-3c941eb5d2c8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-106830/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "d37335aa-7471-5264-af40-7d613aec7144" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-106830/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "4990051a-bb0d-551c-a7b8-9e34f9335163" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-106830/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "47add63a-8f81-55bf-8120-bd13a27e45e5" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-106830/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b7cb8538-1520-5df2-ad95-a6d576b39880" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-106830/selection" :answer-field/id #uuid "a95398ac-5607-570e-b4c8-81e654018c20" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106830/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-106830/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-106830/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-106830/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-106830/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-106830/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-106830" :question/id #uuid "e5784fc5-be1c-559b-a5ef-47d7ce89d4ae" :question/math-academy-id "q-106830" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}={lim}_{x\\to \\infty }\\frac{-5\\operatorname{cos}⁡x}{2x-3}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-5\\operatorname{cos}⁡x|\\le 5.\n$$\n\nHowever, the denominator $2x-3$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}={lim}_{x\\to \\infty }\\frac{-5\\operatorname{cos}⁡x}{2x-3}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{5\\operatorname{cos}⁡x}{3-2x},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979528/assets/ab3f7928be50c25689a99751cd180e585d749bf0a5c253c8662f9b820bbf4bb7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106830/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074"] :knowledge-point/questions ["q-106830"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338817/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "491f86fd-1b83-5929-9ea3-d1af2b627487" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-338817/field-1" :answer-field/id #uuid "82a4dafa-74b6-5c92-b328-33a58173a9f6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-338817/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-338817/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-338817" :question/id #uuid "19e3e79b-7ea0-51f4-a23f-f7c4a33f8e78" :question/math-academy-id "q-338817" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{\\operatorname{sin}⁡x}{x}=$\n{{field-1}}" :question/worked-solution "The numerator here is a bounded, oscillating function with \n\n$$\n|\\operatorname{sin}⁡x|\\le 1.\n$$\n\nHowever, the denominator $x$ grows without bound as $x\\to \\infty .$ Since the denominator grows much faster than the (bounded) numerator, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{sin}⁡x}{x}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{\\operatorname{sin}⁡x}{x},$ shown below:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979528/assets/e164233abcdf9062fd856a100fb7b792912fa030746a63f01ca7fd6683bf7f09.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338817/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074"] :knowledge-point/questions ["q-338817"] :db/ensure [:knowledge-point/validate]}]
