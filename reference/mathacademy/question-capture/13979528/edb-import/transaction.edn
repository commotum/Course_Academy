[{:db/id "q-68105/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "e5c89e90-7c0c-55bb-a9fe-d0a5bd03160a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-68105/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "e44d4e63-9064-5e3b-a606-e35ac871964f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-68105/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "21e3b8d0-db29-5c36-bb56-9d5eaf68f058" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-68105/selection/8c532369070aebb7d2a26f11bce43bc21cb5be1a74f5b2aa6f50b6f6575d6d10" :answer/id #uuid "e4d5eb73-1d1a-50ae-a433-6d46b4df4a42" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x)" :db/ensure [:answer/validate]} {:db/id "q-68105/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "84880119-8cc6-5cae-949f-5b88ff8298aa" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-68105/selection" :answer-field/id #uuid "31582fc7-6e6c-540d-b682-5e28f452fca2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-68105/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-68105/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-68105/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-68105/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-68105/selection/8c532369070aebb7d2a26f11bce43bc21cb5be1a74f5b2aa6f50b6f6575d6d10" "q-68105/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-68105" :question/id #uuid "28924c15-bb63-5eb8-a04e-6f49ec2c95fe" :question/math-academy-id "q-68105" :question/problem "Evaluate ${lim}_{x\\to \\infty }(\\operatorname{ln}⁡(x){e}^{-2x}+3).$" :question/worked-solution "Notice that we can rewrite the first term as\n\n$$\n\\operatorname{ln}⁡(x){e}^{-2x}=\\frac{\\operatorname{ln}⁡(x)}{{e}^{2x}}.\n$$\n\nBoth the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{2x}≫\\operatorname{ln}⁡(x)$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡(x)}{{e}^{2x}}=0.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\operatorname{ln}⁡(x){e}^{-2x}+3) & ={lim}_{x\\to \\infty }(\\frac{\\operatorname{ln}⁡(x)}{{e}^{2x}}+3) \\\\  & =0+3 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-68105/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93"] :knowledge-point/questions ["q-68105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78026/selection/5fb3a82d014523915e20fea47e42b6287cd778db44399d110403c3f136f18487" :answer/id #uuid "1eb9977a-6a3b-57af-8d4c-1e2320bfec74" :answer/type :answer.type/math :answer/value "\\frac{49}{8}" :db/ensure [:answer/validate]} {:db/id "q-78026/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "e908e853-0aaf-5674-a657-5e745d892ac7" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-78026/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "0a3afe49-1eab-5b89-822b-91455a0d1c92" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-78026/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "b6ac4557-9ae1-5e49-bc78-ed1b9b80de18" :answer/type :answer.type/math :answer/va