 condition $y(0)=-\\operatorname{ln}⁡2$ is\n\n$$\ny=-\\operatorname{ln}⁡(3-{e}^{x}).\n$$" 13194139534476 true] [17592186290348 1000 #edb/ref 17592186290349 13194139534476 true] [17592186290348 1000 #edb/ref 17592186290350 13194139534476 true] [17592186290348 1000 #edb/ref 17592186290351 13194139534476 true] [17592186290348 1000 #edb/ref 17592186290352 13194139534476 true] [17592186290348 1000 #edb/ref 17592186290353 13194139534476 true] [17592186290348 1040 #edb/ref 17592186045450 13194139534476 true] [17592186290348 1041 "selection" 13194139534476 true] [17592186290348 1104 #edb/ref 17592186290352 13194139534476 true] [17592186290348 1110 #uuid "e5a2c8b3-5c91-581b-a5a1-77684e23bbb6" 13194139534476 true] [17592186290349 1034 "y=-\\operatorname{ln}⁡(1+{e}^{x})" 13194139534476 true] [17592186290349 1103 #edb/ref 17592186045453 13194139534476 true] [17592186290349 1111 #uuid "c4f4d250-d63c-5e5d-9611-c2c1acc8c318" 13194139534476 true] [17592186290350 1034 "y=-\\operatorname{ln}⁡(1+x+{e}^{x})" 13194139534476 true] [17592186290350 1103 #edb/ref 17592186045453 13194139534476 true] [17592186290350 1111 #uuid "2e605334-fa8a-5fc8-84ae-745241f7e87b" 13194139534476 true] [17592186290351 1034 "y=-\\operatorname{ln}⁡(3-2x-{e}^{x})" 13194139534476 true] [17592186290351 1103 #edb/ref 17592186045453 13194139534476 true] [17592186290351 1111 #uuid "2c4121d6-bab1-56e1-abd4-3bf6e7a40176" 13194139534476 true] [17592186290352 1034 "y=-\\operatorname{ln}⁡(3-{e}^{x})" 13194139534476 true] [17592186290352 1103 #edb/ref 17592186045453 13194139534476 true] [17592186290352 1111 #uuid "8737c814-c6ba-5785-8955-54b94b08fc8e" 13194139534476 true] [17592186290353 1034 "y=-\\operatorname{ln}⁡(x+{e}^{x})" 13194139534476 true] [17592186290353 1103 #edb/ref 17592186045453 13194139534476 true] [17592186290353 1111 #uuid "b247558b-3f44-596b-8b69-4a7a26fdabe1" 13194139534476 true] [17592186290354 1017 #edb/ref 17592186290355 13194139534476 true] [17592186290354 1089 "q-355528" 13194139534476 true] [175921