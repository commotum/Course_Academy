n⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+ln⁡x) \\\\  & =2+\\frac{1}{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11911/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688"] :knowledge-point/questions ["q-11911"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-1919"] :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({11}^{x}-5ln⁡x) \\\\  & ={11}^{x}\\cdot ln⁡11-5(\\frac{1}{x}) \\\\  & ={11}^{x}ln⁡11-\\frac{5}{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-340104/field-1/776695afc140d4c63a4dc748377b77663c947eadbb40199b2216beb8e487d203" :answer/id #uuid "a2ecb11f-9df4-5980-805e-ecff46f0849a" :answer/type :answer.type/math :answer/value "2-\\frac{4}{3}\\ln(2)" :db/ensure [:answer/validate]} {:db/id "q-340104/field-1" :answer-field/id #uuid "28bf96d3-4622-5427-88e4-78f942b675bd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340104/field-1/776695afc140d4c63a4dc748377b77663c947eadbb40199b2216beb8e487d203" :answer-field/choices ["q-340104/field-1/776695afc140d4c63a4dc748377b77663c947eadbb40199b2216beb8e487d203"] :db/ensure [:answer-field/validate]} {:db/id "q-340104" :question/id #uuid "e2c81546-e71f-5118-8492-272c58b3d5ed" :question/math-academy-id "q-340104" :question/is-example false :question/problem "Given the function  $y=4ln⁡x-\\frac{1}{3}\\cdot {2}^{x}+5$, find the instantaneous rate of change at $x=2.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=2$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4ln⁡x-\\frac{1}{3}\\cdot {2}^{x}+5) \\\\  & =\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}ln⁡(2).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(\\frac{4}{x}-\\frac{1}{3}\\cdot {2}^{x}ln⁡(2))|}_{x=2} \\\\  & =\\frac{4}{2}-\\frac{1}{3}\\cdot {2}^{2}ln⁡(2) \\\\  & =2-\\frac{4}{3}ln⁡(2)\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340104/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688"] :knowledge-point/questions ["q-340104"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340106/field-1/e96a242a67c7ee7b1e6662fba6ca741eb23104e6180dc4ac51ea84d72ab1dec8" :answer/id #uuid "001c73a9-6be2-5573-b9af-d22000144c3e" :answer/type :answer.type/math :answer/value "-e^x+\\frac{3}{x\\ln(5)}" :db/ensure [:answer/validate]} {:db/id "q-340106/field-1" :answer-field/id #uuid "c095fa52-1272-5aee-8f54-e8ebbaf05a6b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340106/field-1/e96a242a67c7ee7b1e6662fba6ca741eb23104e6180dc4ac51ea84d72ab1dec8" :answer-field/choices ["q-340106/field-1/e96a242a67c7ee7b1e6662fba6ca741eb23104e6180dc4ac51ea84d72ab1dec8"] :db/ensure [:answer-field/validate]} {:db/id "q-340106" :question/id #uuid "2848146e-3aa0-5434-8c1e-21d5642b4d56" :question/math-academy-id "q-340106" :question/is-example false :question/problem "Given that $y=-{e}^{x}+3{log}_{5}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-{e}^{x}+3{log}_{5}⁡x) \\\\  & =-\\frac{\\text{d}}{\\text{d}x}({e}^{x})+3\\frac{\\text{d}}{\\text{d}x}({log}_{5}⁡x) \\\\  & =-{e}^{x}+3\\cdot \\frac{1}{xln⁡(5)} \\\\  & =-{e}^{x}+\\frac{3}{xln⁡(5)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340106/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7"] :knowledge-point/questions ["q-340106"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11900/selection/72b211f2a10db8e68df9a01f170ca2d12473dafe839cb18fdf9b358057a4225c" :answer/id #uuid "8e5b6fc0-ad37-5d7f-b9b9-3838ddb541fc" :answer/type :answer.type/math :answer/value "\\frac{5}{xln⁡5}" :db/ensure [:answer/validate]} {:db/id "q-11900/selection/62f54ee8cc225474afd24f3724d6ab29beaec14b29011c882e80a8154aa68d99" :answer/id #uuid "55e5e9b5-791b-58f5-b06e-737d5a6a3df8" :answer/type :answer.type/math :answer/value "\\frac{5}{xln⁡4}" :db/ensure [:answer/validate]} {:db/id "q-11900/selection/f8469d94c44deae04797cb87b603d59b05e565e9b060f0b0e7847181c80bedb9" :answer/id #uuid "1e274a1b-978c-5239-94b6-10ea3ac41edc" :answer/type :answer.type/math :answer/value "\\frac{1}{xln⁡4}" :db/ensure [:answer/validate]} {:db/id "q-11900/selection/239c74a55f91998e02ea57522fce34938a7a6f0b508120c348e94a9311c4968d" :answer/id #uuid "bca459d4-24ee-5244-be09-0b354d2fd41c" :answer/type :answer.type/math :answer/value "\\frac{5}{4x}" :db/ensure [:answer/validate]} {:db/id "q-11900/selection/a54c8402da27982f818427652c74898c2343101a9a082d1786d55cc9f8b0533e" :answer/id #uuid "3a6545d1-acb3-5aa5-bb63-3d8fdf40e9f4" :answer/type :answer.type/math :answer/value "\\frac{5}{x}" :db/ensure [:answer/validate]} {:db/id "q-11900/selection" :answer-field/id #uuid "a4109101-faa5-5fcf-815e-725f3f2df85b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11900/selection/62f54ee8cc225474afd24f3724d6ab29beaec14b29011c882e80a8154aa68d99" :answer-field/choices ["q-11900/selection/72b211f2a10db8e68df9a01f170ca2d12473dafe839cb18fdf9b358057a4225c" "q-11900/selection/62f54ee8cc225474afd24f3724d6ab29beaec14b29011c882e80a8154aa68d99" "q-11900/selection/f8469d94c44deae04797cb87b603d59b05e565e9b060f0b0e7847181c80bedb9" "q-11900/selection/239c74a55f91998e02ea57522fce34938a7a6f0b508120c348e94a9311c4968d" "q-11900/selection/a54c8402da27982f818427652c74898c2343101a9a082d1786d55cc9f8b0533e"] :db/ensure [:answer-field/validate]} {:db/id "q-11900" :question/id #uuid "67b94213-d99a-5858-9eec-4b43c51db6fc" :question/math-academy-id "q-11900" :question/is-example false :question/problem "Given that $y=5{log}_{4}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{4}⁡x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x) \\\\  & =5\\cdot \\frac{1}{xln⁡4} \\\\  & =\\frac{5}{xln⁡4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11900/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7"] :knowledge-point/questions ["q-11900"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340105/field-1/b331e5a71017a8ad3f01775eccec06424ec2bd1e93724497409ec182aa2c5690" :answer/id #uuid "f0478ae9-d95a-52af-be9e-d907429eb223" :answer/type :answer.type/math :answer/value "3^x\\ln(3)+\\frac{1}{x\\ln(10)}" :db/ensure [:answer/validate]} {:db/id "q-340105/field-1" :answer-field/id #uuid "61329a65-511b-5206-bac7-c7f9c1558f79" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340105/field-1/b331e5a71017a8ad3f01775eccec06424ec2bd1e93724497409ec182aa2c5690" :answer-field/choices ["q-340105/field-1/b331e5a71017a8ad3f01775eccec06424ec2bd1e93724497409ec182aa2c5690"] :db/ensure [:answer-field/validate]} {:db/id "q-340105" :question/id #uuid "00bcd86f-d2c5-50f7-a8a4-315cf0884886" :question/math-academy-id "q-340105" :question/is-example false :question/problem "Given that $f(x)={3}^{x}+log⁡x$, find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({3}^{x}+log⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({3}^{x})+\\frac{\\text{d}}{\\text{d}x}(log⁡x) \\\\  & ={3}^{x}ln⁡(3)+\\frac{1}{xln⁡(10)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340105/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7"] :knowledge-point/questions ["q-340105"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339994/field-1/dda71eec0e5397a3cbed5514f7079ac8fe90d71fdae8a4f4539b93e8728f39bd" :answer/id #uuid "f9e2ea69-8c24-540e-922a-84258e3995fd" :answer/type :answer.type/math :answer/value "55-\\frac{1}{\\ln(6)}" :db/ensure [:answer/validate]} {:db/id "q-339994/field-1/ceeccb8f1f5e519172e6c9b605c2190f1dc7249457bcb874f41a7e22ed27d884" :answer/id #uuid "28ba94f1-8641-5046-815b-84bde6bb5f82" :answer/type :answer.type/math :answer/value "55+\\frac{1}{\\ln(6)}" :db/ensure [:answer/validate]} {:db/id "q-339994/field-1" :answer-field/id #uuid "2e517cf4-1992-5a23-8a87-f2a675cf83b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339994/field-1/dda71eec0e5397a3cbed5514f7079ac8fe90d71fdae8a4f4539b93e8728f39bd" :answer-field/choices ["q-339994/field-1/dda71eec0e5397a3cbed5514f7079ac8fe90d71fdae8a4f4539b93e8728f39bd" "q-339994/field-1/ceeccb8f1f5e519172e6c9b605c2190f1dc7249457bcb874f41a7e22ed27d884"] :db/ensure [:answer-field/validate]} {:db/id "q-339994" :question/id #uuid "ce4d4f97-d868-5d04-a9b5-17c6975fb577" :question/math-academy-id "q-339994" :question/is-example false :question/problem "Given the function $y=2{x}^{3}+x-3{log}_{6}⁡x,$ find the instantaneous rate of change at $x=3.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=3$ is\n{{field-1}}." :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTo find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}+x-3{log}_{6}⁡x) \\\\  & =2\\cdot 3{x}^{2}+1-3\\cdot \\frac{1}{xln⁡6} \\\\  & =6{x}^{2}+1-\\frac{3}{xln⁡6}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(6{x}^{2}+1-\\frac{3}{xln⁡6})|}_{x=3} \\\\  & =6(3)^{2}+1-\\frac{3}{3\\cdot ln⁡6} \\\\  & =55-\\frac{1}{ln⁡6}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-339994/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7"] :knowledge-point/questions ["q-339994"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105256/selection/b13357f3c5de4fc3c3523f98c098122a15655050151783c1aa70f6d9084203fb" :answer/id #uuid "5591f0c1-38a4-5729-9d53-05affdff490d" :answer/type :answer.type/math :answer/value "{4}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/ensure [:answer/validate]} {:db/id "q-105256/selection/d9cb367dc294b294566564f0793bf08ce644f1414fa3ab82f71c3b4222bd3b70" :answer/id #uuid "c33ca7f9-c577-55c4-a628-64c57b7a9928" :answer/type :answer.type/math :answer/value "{7}^{x}ln⁡7+\\frac{1}{x}" :db/ensure [:answer/validate]} {:db/id "q-105256/selection/2a800387cc578683f0812fddac0af8e1e146ea89828a64360babcb7239c9c819" :answer/id #uuid "fa3e3522-489e-59f6-8e5f-95c329a1e83b" :answer/type :answer.type/math :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{ln⁡5}" :db/ensure [:answer/validate]} {:db/id "q-105256/selection/ed8c8c712b9df191211b8dc0769fcdce3031fc6765a56997369b095a7eaeaf1e" :answer/id #uuid "0d9cdf29-eaea-5e04-b7ac-f2912934ab3e" :answer/type :answer.type/math :answer/value "{7}^{x}+\\frac{1}{xln⁡5}" :db/ensure [:answer/validate]} {:db/id "q-105256/selection/bfb74f1d22b04f88b6745c4b055cf2be65e9a9b5e395f1ddbcc58494cd6d1426" :answer/id #uuid "edaf6a2d-3375-5cce-a3ac-72e6f7c69528" :answer/type :answer.type/math :answer/value "{7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}" :db/ensure [:answer/validate]} {:db/id "q-105256/selection" :answer-field/id #uuid "434e9897-1fb5-55a8-b1a1-9c83067e3386" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105256/selection/bfb74f1d22b04f88b6745c4b055cf2be65e9a9b5e395f1ddbcc58494cd6d1426" :answer-field/choices ["q-105256/selection/b13357f3c5de4fc3c3523f98c098122a15655050151783c1aa70f6d9084203fb" "q-105256/selection/d9cb367dc294b294566564f0793bf08ce644f1414fa3ab82f71c3b4222bd3b70" "q-105256/selection/2a800387cc578683f0812fddac0af8e1e146ea89828a64360babcb7239c9c819" "q-105256/selection/ed8c8c712b9df191211b8dc0769fcdce3031fc6765a56997369b095a7eaeaf1e" "q-105256/selection/bfb74f1d22b04f88b6745c4b055cf2be65e9a9b5e395f1ddbcc58494cd6d1426"] :db/ensure [:answer-field/validate]} {:db/id "q-105256" :question/id #uuid "a1a79eda-9c98-57d8-82ba-6cc467cf56bf" :question/math-academy-id "q-105256" :question/is-example false :question/problem "Find ${f}^{′}(x)$ for $f(x)={7}^{x}+{log}_{5}⁡x.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({7}^{x}+{log}_{5}⁡x) \\\\  & ={7}^{x}\\cdot ln⁡7+\\frac{1}{xln⁡5} \\\\  & ={7}^{x}\\text{ }ln⁡7+\\frac{1}{xln⁡5}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105256/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7"] :knowledge-point/questions ["q-105256"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340024/field-1/3d9a4b3fbf01fb0a48a0a25402320bd01e86483a3d7b52665424bfc48fd5a614" :answer/id #uuid "15c185dc-f80c-572e-971e-402d1e522644" :answer/type :answer.type/math :answer/value "24-\\frac{5}{2\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-340024/field-1" :answer-field/id #uuid "874e7ee2-08f7-52fa-b075-9d0504a30ed5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340024/field-1/3d9a4b3fbf01fb0a48a0a25402320bd01e86483a3d7b52665424bfc48fd5a614" :answer-field/choices ["q-340024/field-1/3d9a4b3fbf01fb0a48a0a25402320bd01e86483a3d7b52665424bfc48fd5a614"] :db/ensure [:answer-field/validate]} {:db/id "q-340024" :question/id #uuid "13209240-47ee-57bb-950d-c7141b5c2f2d" :question/math-academy-id "q-340024" :question/is-example false :question/problem "Given the function $y=2{x}^{3}-5{log}_{3}⁡x,$ the slope of the tangent line at $x=2$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-5{log}_{3}⁡x) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({x}^{3})-5\\frac{\\text{d}}{\\text{d}x}({log}_{3}⁡x) \\\\  & =2\\cdot 3{x}^{2}-5\\cdot \\frac{1}{xln⁡3} \\\\  & =6{x}^{2}-\\frac{5}{xln⁡3}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=2$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(6{x}^{2}-\\frac{5}{xln⁡3})|}_{x=2} \\\\  & =6(2)^{2}-\\frac{5}{2ln⁡3} \\\\  & =24-\\frac{5}{2ln⁡3}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340024/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784"] :knowledge-point/questions ["q-340024"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340110/field-1/ded5986e60d9ba3590568506bfe4f82a041153d5008a9017f4209e3380c87ca8" :answer/id #uuid "96dd115d-eb77-539d-8e19-9ce168522313" :answer/type :answer.type/math :answer/value "4e^3-\\frac{1}{\\ln(2)}" :db/ensure [:answer/validate]} {:db/id "q-340110/field-1/2b652360ddb925ca8e2af34f7390d926da4525386c6ca52de3a327a3c9043e11" :answer/id #uuid "db2996e5-0f5c-57b9-a673-8be6139f81d4" :answer/type :answer.type/math :answer/value "4e^3+\\frac{1}{\\ln(2)}" :db/ensure [:answer/validate]} {:db/id "q-340110/field-1" :answer-field/id #uuid "3ab0476c-ced0-566f-b65d-c2395fa7b54b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340110/field-1/ded5986e60d9ba3590568506bfe4f82a041153d5008a9017f4209e3380c87ca8" :answer-field/choices ["q-340110/field-1/ded5986e60d9ba3590568506bfe4f82a041153d5008a9017f4209e3380c87ca8" "q-340110/field-1/2b652360ddb925ca8e2af34f7390d926da4525386c6ca52de3a327a3c9043e11"] :db/ensure [:answer-field/validate]} {:db/id "q-340110" :question/id #uuid "aa34e2cc-02df-5659-bdbd-d89b4f453804" :question/math-academy-id "q-340110" :question/is-example false :question/problem "Given the function $y=4{e}^{x}-3{log}_{2}⁡x+7,$ the slope of the tangent line at $x=3$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{x}-3{log}_{2}⁡x+7) \\\\  & =4\\frac{\\text{d}}{\\text{d}x}({e}^{x})-3\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+\\frac{\\text{d}}{\\text{d}x}(7) \\\\  & =4{e}^{x}-3\\cdot \\frac{1}{xln⁡2}+0 \\\\  & =4{e}^{x}-\\frac{3}{xln⁡2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=3$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(4{e}^{x}-\\frac{3}{xln⁡2})|}_{x=3} \\\\  & =4{e}^{3}-\\frac{3}{3\\cdot ln⁡2} \\\\  & =4{e}^{3}-\\frac{1}{ln⁡2}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340110/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784"] :knowledge-point/questions ["q-340110"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101726/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "e123e87a-e4a8-5478-b894-ca12a0c3b993" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-101726/selection/fc4ec230332233cf130018d04f219da2da49c72fe8591fed0b8f22a5d02c38c8" :answer/id #uuid "c0b69e23-1708-5452-93d0-c61120caf67c" :answer/type :answer.type/math :answer/value "3+8ln⁡2" :db/ensure [:answer/validate]} {:db/id "q-101726/selection/2e6343bd6c7aa43b7761100b413846633e76637bbf5193090ee71da4f1ee60c4" :answer/id #uuid "1cce0c84-c685-50fc-9b8a-2aa09beceb36" :answer/type :answer.type/math :answer/value "8ln⁡2-2" :db/ensure [:answer/validate]} {:db/id "q-101726/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "61faf0e6-9753-5efc-8e83-5626a7286113" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-101726/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0087b9e7-d990-5afe-bf25-05b0f5e679b0" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-101726/selection" :answer-field/id #uuid "2775a343-375d-52d8-917d-1077e70e9cd3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101726/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer-field/choices ["q-101726/selection/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" "q-101726/selection/fc4ec230332233cf130018d04f219da2da49c72fe8591fed0b8f22a5d02c38c8" "q-101726/selection/2e6343bd6c7aa43b7761100b413846633e76637bbf5193090ee71da4f1ee60c4" "q-101726/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-101726/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-101726" :question/id #uuid "6722baff-8f94-5523-b159-d7215bb8efed" :question/math-academy-id "q-101726" :question/is-example false :question/problem "Given that $y=3x-5+8{log}_{2}⁡x$, find the slope of the tangent at $x=\\frac{1}{ln⁡2}.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x-5+8{log}_{2}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3x)+\\frac{\\text{d}}{\\text{d}x}(-5)+\\frac{\\text{d}}{\\text{d}x}(8{log}_{2}⁡x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(5)+8\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x) \\\\  & =3-0+8\\cdot \\frac{1}{xln⁡2} \\\\  & =3+\\frac{8}{xln⁡2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=\\frac{1}{ln⁡2}$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/ln⁡2} & ={(3+\\frac{8}{xln⁡2})|}_{x=1/ln⁡2} \\\\  & =3+\\frac{8}{(\\frac{1}{ln⁡2}\\cdot ln⁡2)} \\\\  & =3+8 \\\\  & =11\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101726/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784"] :knowledge-point/questions ["q-101726"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340026/field-1/e4645bc53e6fdcfb64028634e9b68d392941eb90ee9ab8537f19071b2d6cd014" :answer/id #uuid "8c5d6dfc-5e0b-5f82-a0f8-d66383f2bfe5" :answer/type :answer.type/math :answer/value "5+\\frac{6}{\\ln(2)}" :db/ensure [:answer/validate]} {:db/id "q-340026/field-1/987cf61dbbda441d3edeed827e21c36bd461fac72e0eb266e5ba2292128fa2e4" :answer/id #uuid "ca43d93f-962c-5867-9383-d3b927df358c" :answer/type :answer.type/math :answer/value "5-\\frac{6}{\\ln(2)}" :db/ensure [:answer/validate]} {:db/id "q-340026/field-1" :answer-field/id #uuid "29cb8dbd-f48c-52ed-9849-93f8f108d09f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340026/field-1/e4645bc53e6fdcfb64028634e9b68d392941eb90ee9ab8537f19071b2d6cd014" :answer-field/choices ["q-340026/field-1/e4645bc53e6fdcfb64028634e9b68d392941eb90ee9ab8537f19071b2d6cd014" "q-340026/field-1/987cf61dbbda441d3edeed827e21c36bd461fac72e0eb266e5ba2292128fa2e4"] :db/ensure [:answer-field/validate]} {:db/id "q-340026" :question/id #uuid "e2bb23fc-94e4-5068-ad8c-2bac28d89d6c" :question/math-academy-id "q-340026" :question/is-example false :question/problem "Given the function $y=6{log}_{2}⁡x+4{x}^{2}-3x,$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6{log}_{2}⁡x+4{x}^{2}-3x) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}({log}_{2}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})-3\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =6\\cdot \\frac{1}{xln⁡2}+4\\cdot 2x-3 \\\\  & =\\frac{6}{xln⁡2}+8x-3\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{6}{xln⁡2}+8x-3)|}_{x=1} \\\\  & =\\frac{6}{1\\cdot ln⁡2}+8(1)-3 \\\\  & =\\frac{6}{ln⁡2}+5\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340026/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784"] :knowledge-point/questions ["q-340026"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17371/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "ac3917b5-e932-59d2-a842-22250ea88b3d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-17371/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3c6a07e7-7a9c-5129-b97e-d5b4f1ea1eea" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-17371/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "b6f1fc24-e635-5984-9781-b963abcb7872" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-17371/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "e6f15fc5-3ca2-56b4-b1c8-93b3a58550e2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-17371/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "46c1c6b5-499e-54ff-9b95-cc180e94c084" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-17371/selection" :answer-field/id #uuid "728ea165-ea1e-56e8-bbd6-61a719febc59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17371/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-17371/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-17371/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-17371/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-17371/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-17371/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-17371" :question/id #uuid "6f651874-7846-5bc8-b0e8-ba6c0958a8ef" :question/math-academy-id "q-17371" :question/is-example false :question/problem "Given that $y=3ln⁡x+2{x}^{2}-5x$, find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3ln⁡x+2{x}^{2}-5x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3ln⁡x)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(5x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(ln⁡x)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(5x) \\\\  & =3\\cdot \\frac{1}{x}+4x-5 \\\\  & =\\frac{3}{x}+4x-5\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x}+4x-5)|}_{x=1} \\\\  & =\\frac{3}{1}+4\\cdot 1-5 \\\\  & =3+4-5 \\\\  & =2\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-17371/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784"] :knowledge-point/questions ["q-17371"] :db/ensure [:knowledge-point/validate]}]
