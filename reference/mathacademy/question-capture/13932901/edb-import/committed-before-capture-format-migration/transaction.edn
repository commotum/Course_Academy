stion/id #uuid "21ad6958-9427-54e1-9344-a853dd625138" :question/math-academy-id "q-101600" :question/is-example false :question/problem "Given that $y=2eln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2eln⁡x) \\\\  & =2e\\cdot \\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =2e\\cdot \\frac{1}{x} \\\\  & =\\frac{2e}{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101600/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03"] :knowledge-point/questions ["q-101600"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339949/field-1/8efef6e0521463f979d5caf1ab59c3c083cad757414e9ce8593aeae6c6cc4e47" :answer/id #uuid "3e9cded4-f07c-5cbd-a713-216728655018" :answer/type :answer.type/math :answer/value "\\frac{11}{4x}" :db/ensure [:answer/validate]} {:db/id "q-339949/field-1/17f7a92ecac965d3850a7da98658af322c6b691d4b3336f622586133c927298d" :answer/id #uuid "9d84e113-0113-5137-9533-627f1404eb23" :answer/type :answer.type/math :answer/value "\\frac{11}{4}" :db/ensure [:answer/validate]} {:db/id "q-339949/field-1" :answer-field/id #uuid "87f26ece-1d63-520e-80d4-b015ed89ec4f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339949/field-1/8efef6e0521463f979d5caf1ab59c3c083cad757414e9ce8593aeae6c6cc4e47" :answer-field/choices ["q-339949/field-1/8efef6e0521463f979d5caf1ab59c3c083cad757414e9ce8593aeae6c6cc4e47" "q-339949/field-1/17f7a92ecac965d3850a7da98658af322c6b691d4b3336f622586133c927298d"] :db/ensure [:answer-field/validate]} {:db/id "q-339949" :question/id #uuid "a2e26e30-590f-58b8-b40b-aad2e7b0b3b6" :question/math-academy-id "q-339949" :question/is-example false :question/problem "Given that $y=\\frac{11}{4}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{11}{4}ln⁡x) \\\\  & =\\frac{11}{4}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =\\frac{11}{4}\\cdot \\frac{1}{x} \\\\  & =\\frac{11}{4x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-339949/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03"] :knowledge-point/questions ["q-339949"] :db/ensure [:knowledge-point/validate]} {:db/id "q-308849/field-1/7deae7978e85107833c8d9062127ab0636576ae05a8c60b0f7190df07317d0bf" :answer/id #uuid "1e90703a-fe9a-5005-bf53-7738b5423a0f" :answer/type :answer.type/math :answer/value "\\frac{8}{x}" :db/ensure [:answer/validate]} {:db/id "q-308849/field-1" :answer-field/id #uuid "9f9609a1-8b91-52eb-8d91-c281b09f6dcf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-308849/field-1/7deae7978e85107833c8d9062127ab0636576ae05a8c60b0f7190df07317d0bf" :answer-field/choices ["q-308849/field-1/7deae7978e85107833c8d9062127ab0636576ae05a8c60b0f7190df07317d0bf"] :db/ensure [:answer-field/validate]} {:db/id "q-308849" :question/id #uuid "754b7256-bb68-5676-b86f-e67821b5f20a" :question/math-academy-id "q-308849" :question/is-example false :question/problem "Given that $y=8ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(8ln⁡x) \\\\  & =8\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =8\\cdot \\frac{1}{x} \\\\  & =\\frac{8}{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-308849/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03"] :knowledge-point/questions ["q-308849"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101604/selection/192c6030d8816553cdfcf13c7f5f26bd0bc0f29788b453b1e64332880bc35044" :answer/id #uuid "02155d95-9ced-5d74-9ac2-ed709daea0d3" :answer/type :answer.type/math :answer/value "\\frac{1}{x}" :db/ensure [:answer/validate]} {:db/id "q-101604/selection/09156b06f6bd005abf29d815036765db3afa8d380cd65435fc7164299537a743" :answer/id #uuid "829656d8-9eda-533c-a503-e7e692a2e836" :answer/type :answer.type/math :answer/value "-\\frac{9}{x}" :db/ensure [:answer/validate]} {:db/id "q-101604/selection/dae5a2c82280054a2a2209f4d43a3d225318aa6eaa1d12bc2ea078bfc4663148" :answer/id #uuid "a156b127-a1ef-59f9-aabb-bba6463fc4ca" :answer/type :answer.type/math :answer/value "\\frac{9}{x}" :db/ensure [:answer/validate]} {:db/id "q-101604/selection/1ff101761a1e5581bf65e642cb9e28a5c6545803559d69239323704698f00336" :answer/id #uuid "5a2c25e6-fb95-5502-9bd6-0f31a1ca3865" :answer/type :answer.type/math :answer/value "-\\frac{x}{9}" :db/ensure [:answer/validate]} {:db/id "q-101604/selection/87986d5e0ffabb5b3fb3ce6a3fee09b938a4e8114cf3e16077b3736ada9efc24" :answer/id #uuid "7b6a62b2-2601-5caa-920c-d957ca190c14" :answer/type :answer.type/math :answer/value "-\\frac{1}{9x}" :db/ensure [:answer/validate]} {:db/id "q-101604/selection" :answer-field/id #uuid "c4df4eb7-3c15-5c5b-9c08-e489fbd6a2a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-101604/selection/09156b06f6bd005abf29d815036765db3afa8d380cd65435fc7164299537a743" :answer-field/choices ["q-101604/selection/192c6030d8816553cdfcf13c7f5f26bd0bc0f29788b453b1e64332880bc35044" "q-101604/selection/09156b06f6bd005abf29d815036765db3afa8d380cd65435fc7164299537a743" "q-101604/selection/dae5a2c82280054a2a2209f4d43a3d225318aa6eaa1d12bc2ea078bfc4663148" "q-101604/selection/1ff101761a1e5581bf65e642cb9e28a5c6545803559d69239323704698f00336" "q-101604/selection/87986d5e0ffabb5b3fb3ce6a3fee09b938a4e8114cf3e16077b3736ada9efc24"] :db/ensure [:answer-field/validate]} {:db/id "q-101604" :question/id #uuid "41046d62-8496-5dc8-8432-1ac2a083b39f" :question/math-academy-id "q-101604" :question/is-example false :question/problem "Given that $y=-9ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-9ln⁡x) \\\\  & =-9\\cdot \\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =-9\\cdot \\frac{1}{x} \\\\  & =-\\frac{9}{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101604/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03"] :knowledge-point/questions ["q-101604"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339950/field-1/c0e95c3c489c64bbdf49dfbd41440eddfd160816c4355d3f18ef346a0b7f986a" :answer/id #uuid "e2ad5a6f-3194-5f3a-9982-fd2336c2ddec" :answer/type :answer.type/math :answer/value "-\\frac{7}{3x}" :db/ensure [:answer/validate]} {:db/id "q-339950/field-1" :answer-field/id #uuid "6388562b-2b4c-50ea-b269-9fc34ebf91c7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339950/field-1/c0e95c3c489c64bbdf49dfbd41440eddfd160816c4355d3f18ef346a0b7f986a" :answer-field/choices ["q-339950/field-1/c0e95c3c489c64bbdf49dfbd41440eddfd160816c4355d3f18ef346a0b7f986a"] :db/ensure [:answer-field/validate]} {:db/id "q-339950" :question/id #uuid "7d4e29bb-15ef-5e11-8db1-eae3045391ca" :question/math-academy-id "q-339950" :question/is-example false :question/problem "Given that $y=-\\frac{7}{3}ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(ln⁡x)=\\frac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{7}{3}ln⁡x) \\\\  & =-\\frac{7}{3}\\frac{\\text{d}}{\\text{d}x}(ln⁡x) \\\\  & =-\\frac{7}{3}\\cdot \\frac{1}{x} \\\\  & =-\\frac{7}{3x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-339950/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03"] :knowledge-point/questions ["q-339950"] :db/ensure [:knowledge-point/validate]} {:db/id "q-17392/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6090286d-84c6-5880-8d77-3e783b52596e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-17392/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" :answer/id #uuid "431948e7-17ca-5c28-9a19-a45757fde1b7" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "q-17392/selection/e1a79fe21dbd63050cc5b8abf7bbfe646e6735d60cb33653e6f487991ef831d5" :answer/id #uuid "00781f68-ca87-5150-b9ad-f98485704bfe" :answer/type :answer.type/math :answer/value "2e+1" :db/ensure [:answer/validate]} {:db/id "q-17392/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "e6aae0ab-e147-565a-9c7b-d259a7949a5a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-17392/selection/72443840a1994ef4e387277621cd8f464de0132f9c0b12ec6eac8b3cee6eca7d" :answer/id #uuid "068442a1-36ec-5a46-9b5a-9d85cce2c3f0" :answer/type :answer.type/math :answer/value "2e-1" :db/ensure [:answer/validate]} {:db/id "q-17392/selection" :answer-field/id #uuid "bcbb4dbb-ff3f-552a-b17b-0469fb9832ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-17392/selection/72443840a1994ef4e387277621cd8f464de0132f9c0b12ec6eac8b3cee6eca7d" :answer-field/choices ["q-17392/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-17392/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" "q-17392/selection/e1a79fe21dbd63050cc5b8abf7bbfe646e6735d60cb33653e6f487991ef831d5" "q-17392/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-17392/selection/72443840a1994ef4e387277621cd8f464de0132f9c0b12ec6eac8b3cee6eca7d"] :db/ensure [:answer-field/validate]} {:db/id "q-17392" :question/id #uuid "104d7814-9b21-55a2-864d-c61ec56f5c8f" :question/math-academy-id "q-17392" :question/is-example false :question/problem "Given that $y=2{x}^{e}-ln⁡x$, find the instantaneous rate of change at $x=1.$" :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{e}-ln⁡x) \\\\  & =2e{x}^{e-1}-\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(2e{x}^{e-1}-\\frac{1}{x})|}_{x=1} \\\\  & =2e\\cdot {1}^{e-1}-\\frac{1}{1} \\\\  & =2e-1\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-17392/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688"] :knowledge-point/questions ["q-17392"] :db/ensure [:knowledge-point/validate]} {:db/id "q-308854/field-1/45910c41fca5ee0a1d412e247ecbb22a45d465ee4eaa2f01b1b89bb6d7836e2e" :answer/id #uuid "e07748e0-3b33-5acf-bd17-ae66fa3e5a69" :answer/type :answer.type/math :answer/value "3e+1" :db/ensure [:answer/validate]} {:db/id "q-308854/field-1" :answer-field/id #uuid "ec0062d0-fc51-5cc3-996f-d593aace7f83" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-308854/field-1/45910c41fca5ee0a1d412e247ecbb22a45d465ee4eaa2f01b1b89bb6d7836e2e" :answer-field/choices ["q-308854/field-1/45910c41fca5ee0a1d412e247ecbb22a45d465ee4eaa2f01b1b89bb6d7836e2e"] :db/ensure [:answer-field/validate]} {:db/id "q-308854" :question/id #uuid "3d54b3eb-ded4-5c5a-8cec-34fe12561ac5" :question/math-academy-id "q-308854" :question/is-example false :question/problem "Given the function  $y=3{x}^{e}+ln⁡x,$ find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." :question/worked-solution "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{e}+ln⁡x) \\\\  & =3e{x}^{e-1}+\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(3e{x}^{e-1}+\\frac{1}{x})|}_{x=1} \\\\  & =3e\\cdot {1}^{e-1}+\\frac{1}{1} \\\\  & =3e+1\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-308854/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688"] :knowledge-point/questions ["q-308854"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11911/selection/6ef438845df118c55f5948ffca07768412e0afb98441a1f4b2fd36f5beb98e01" :answer/id #uuid "e0cba0cd-8957-5e8d-8e0d-d61138