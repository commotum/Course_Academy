#{[{:db/id #edb/ref 17592186096336 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a71301e9-bc7f-53b9-900e-c3bd37f96b03" :knowledge-point/title "Differentiating the Product of a Constant and the Natural Logarithm Function"}] :question/id #uuid "6624681a-bb00-59db-8df9-4d5a3cd00434" :question/is-example true :question/math-academy-id "e-3627" :question/problem "Given that $y=5\\ln x$, find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$." :question/worked-solution "The derivative of the natural logarithm is the reciprocal function:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d} x}\\left(\\ln x \\right)= \\dfrac{1}{x}\n$$\n\nWe apply our formula and get\n\n$$\n\\begin{aligned} \\dfrac{\\textrm{d}y}{\\textrm{d}x} & = \\left(5\\ln x\\right)' \\\\ & = 5 (\\ln x)' \\\\ &=5\\cdot \\dfrac{1}{x} \\\\ &= \\dfrac{5}{x}. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096337 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/id #uuid "58d47fb0-cf75-58c4-8eea-f3ae97333159" :question/is-example true :question/math-academy-id "e-3628" :question/problem "Given that $f(x)=2\\ln x+x^2-1$, find $f'(x)$." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned} f'(x) &= \\left(2\\ln x+x^2-1\\right)' \\\\ &=2 \\cdot \\dfrac{1}{x}+2x-0 \\\\ &=\\dfrac{2}{x}+2x. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096338 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/id #uuid "f61ac550-d62c-558f-b6d5-0d4c9aba8089" :question/is-example true :question/math-academy-id "e-3629" :question/problem "Given that $y=4\\log_3 x$, find $\\dfrac{\\textrm{d}y}{\\textrm{d}x}$." :question/worked-solution "Here, we apply our formula for the derivative when the base of the logarithm is a number other than $e$. By doing so, we obtain\n\n$$\n\\begin{aligned} \\dfrac{\\textrm{d}y}{\\textrm{d}x}&=\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(4\\log_3 x\\right) \\\\ &=4\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\log_3 x\\right) \\\\ &=4\\cdot\\dfrac{1}{x \\ln 3} \\\\ &=\\dfrac{4}{x \\ln 3}. \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096339 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/id #uuid "5eaa00f8-0fd0-5de6-a7c0-965db6de3a5c" :question/is-example true :question/math-academy-id "e-3630" :question/problem "Given that $y= \\log_4 x + \\ln x$, find the slope of the tangent at $x=1$." :question/worked-solution "To find the slope of the tangent at a given point, we have to find\n\n$$\n\\dfrac {\\textrm{d}y} {\\textrm{d}x}\n$$\n\nat that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned} \\dfrac{\\textrm{d}y}{\\textrm{d}x} &= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\log_4 x + \\ln x \\right) \\\\ &= \\dfrac{\\textrm{d}}{\\textrm{d}x}(\\log_4 x) + \\dfrac{\\textrm{d}}{\\textrm{d}x}(\\ln x) \\\\ &= \\dfrac{1}{x\\ln 4} + \\dfrac{1}{x}. \\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}\n\\left.\\frac{dy}{dx}\\right|_{x = 1} &= \\left.(\\frac{1}{x\\ln 4} + \\frac{1}{x})\\right|_{x = 1} \\\\\n&= \\frac{1}{\\ln 4} + 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097073 :knowledge-point/_questions [{:knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0007031-6988-5651-8ffd-23a0653ca80b" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x}\\ln x - \\frac{1}{x}" :db/id #edb/ref 17592186094845} {:answer/id #uuid "e078d70c-63de-5091-a233-58995f88f619" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 11 + \\frac{5}{x}" :db/id #edb/ref 17592186094846} {:answer/id #uuid "0e65bf25-ab30-5820-986d-a4e0abba72f7" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x}\\ln 11 - \\frac{5}{x}" :db/id #edb/ref 17592186094847} {:answer/id #uuid "3906a9fd-f9f0-55ef-9a8b-8a52ddaac104" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x} - \\frac{1}{x}" :db/id #edb/ref 17592186094848} {:answer/id #uuid "3dd68bb6-f2a7-5e79-82dc-a81ebf4a5b5b" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x} - \\ln 11 - \\frac{5}{x}" :db/id #edb/ref 17592186094849}] :answer-field/correct {:answer/id #uuid "0e65bf25-ab30-5820-986d-a4e0abba72f7" :answer/type {:db/ident :answer.type/math} :answer/value "11^{x}\\ln 11 - \\frac{5}{x}" :db/id #edb/ref 17592186094847} :answer-field/id #uuid "9ae9af3c-c67b-5547-98d7-93de5f6971b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186094844}] :question/id #uuid "1cb4423b-343c-5035-85a6-f38acaa8835d" :question/is-example false :question/math-academy-id "q-1919" :question/problem "Find $f^{′}(x)$ for $f(x) = 11^{x} - 5\\ln x$."}]}
