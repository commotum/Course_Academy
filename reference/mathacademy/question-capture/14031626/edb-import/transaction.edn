[{:db/id "q-49677/selection/9dd68ca6e4e2922985ca682317f80e11476899d60a3e7e9d7a3cdd27393c4179" :answer/id #uuid "0db797b3-53e8-5590-95b7-ffe3b6bb843d" :answer/type :answer.type/math :answer/value "\\frac{e+1}{4}" :db/ensure [:answer/validate]} {:db/id "q-49677/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "a8573d1c-50f4-5be6-b2a1-4e99a031f1ca" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-49677/selection/64abd542708e9408a7f28dd5703f838e05fbf0069e113836b14b52b11c3fcec0" :answer/id #uuid "b2d2c9a4-4036-501f-8037-95967bbc5e1e" :answer/type :answer.type/math :answer/value "\\frac{e}{4}" :db/ensure [:answer/validate]} {:db/id "q-49677/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "b436af99-89b0-57b4-a080-18ea582d5d7b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-49677/selection/2224d633dd91b4bd236235fe1e66720b5ec21c595ba7f8ff61a90b1d203d4024" :answer/id #uuid "2d5b0a9b-55d8-54f1-a6b0-5817b58a7aca" :answer/type :answer.type/math :answer/value "\\frac{e}{2}+1" :db/ensure [:answer/validate]} {:db/id "q-49677/selection" :answer-field/id #uuid "7e471bec-6435-5463-aa18-2c19f8cac7b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49677/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-49677/selection/9dd68ca6e4e2922985ca682317f80e11476899d60a3e7e9d7a3cdd27393c4179" "q-49677/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-49677/selection/64abd542708e9408a7f28dd5703f838e05fbf0069e113836b14b52b11c3fcec0" "q-49677/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-49677/selection/2224d633dd91b4bd236235fe1e66720b5ec21c595ba7f8ff61a90b1d203d4024"] :db/ensure [:answer-field/validate]} {:db/id "q-49677" :question/id #uuid "1884b2b6-9a5b-50db-96f7-0391992e90ca" :question/math-academy-id "q-49677" :question/problem "Evaluate the integral  ${\\int }_{0}^{1/2}x{e}^{2x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x & ⇒ & {u}^{′}=1 \\\\ {v}^{′}={e}^{2x} & ⇒ & v=\\frac{{e}^{2x}}{2}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{2x}\\,\\text{d}x & =x\\cdot \\frac{{e}^{2x}}{2}-\\int \\frac{{e}^{2x}}{2}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}x{e}^{2x}\\,\\text{d}x & =\\frac{1}{2}(x{e}^{2x}){|}_{0}^{1/2}-\\frac{1}{2}{\\int }_{0}^{1/2}{e}^{2x}\\,\\text{d}x \\\\  & =\\frac{1}{2}(x{e}^{2x}){|}_{0}^{1/2}-\\frac{{e}^{2x}}{4}{|}_{0}^{1/2} \\\\  & =\\frac{1}{2}[\\frac{1}{2}{e}^{2(1/2)}-0\\cdot {e}^{2\\cdot 0}]-\\frac{1}{4}[{e}^{2(1/2)}-{e}^{2\\cdot 0}] \\\\  & =\\frac{1}{2}[\\frac{e}{2}-0]-\\frac{1}{4}[e-1] \\\\  & =\\frac{e}{4}-\\frac{e-1}{4} \\\\  & =\\frac{e-e+1}{4} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49677/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8"] :knowledge-point/questions ["q-49677"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49682/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "134c774d-efad-5307-a595-fe47c70bf6da" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-49682/selection/a3f72a33bd97dbcb26e67e320a072cf6fd98f5dc94f2de44db2fa04c176254bd" :answer/id #uuid "438af1d9-cd06-5296-bc6b-aace32f7ce92" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-49682/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" :answer/id #uuid "dd527b83-3fb6-5fd7-b3dd-d9fdd02c0f6c" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "q-49682/selection/6813ab1041b0710ec600e525b5dde1529e9cdde2099f23754ba54ec5d845bb88" :answer/id #uuid "d44d3c77-9dba-598d-954b-911825fd5ca9" :answer/type :answer.type/math :answer/value "-4\\pi " :db/ensure [:answer/validate]} {:db/id "q-49682/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "0070ead1-e2f0-5ce4-852e-e97f98880a2b" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-49682/selection" :answer-field/id #uuid "4f485e2d-8f17-5aeb-b725-490810dd4d8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49682/selection/6813ab1041b0710ec600e525b5dde1529e9cdde2099f23754ba54ec5d845bb88" :answer-field/choices ["q-49682/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-49682/selection/a3f72a33bd97dbcb26e67e320a072cf6fd98f5dc94f2de44db2fa04c176254bd" "q-49682/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" "q-49682/selection/6813ab1041b0710ec600e525b5dde1529e9cdde2099f23754ba54ec5d845bb88" "q-49682/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a"] :db/ensure [:answer-field/validate]} {:db/id "q-49682" :question/id #uuid "7fbccf84-6c3c-5304-8aee-294db81f5c66" :question/math-academy-id "q-49682" :question/problem "Evaluate ${\\int }_{\\pi /2}^{3\\pi /2}2x\\operatorname{cos}⁡(x)\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}=\\operatorname{cos}⁡(x) & ⇒ & v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =2x\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{\\pi /2}^{3\\pi /2}2x\\operatorname{cos}⁡(x)\\,\\text{d}x & =2x\\operatorname{sin}⁡(x){|}_{\\pi /2}^{3\\pi /2}-{\\int }_{\\pi /2}^{3\\pi /2}2\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =2x\\operatorname{sin}⁡(x){|}_{\\pi /2}^{3\\pi /2}+2\\operatorname{cos}⁡(x){|}_{\\pi /2}^{3\\pi /2} \\\\  & =2[\\frac{3\\pi }{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\frac{\\pi }{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})] \\\\  & +2[\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{cos}⁡(\\frac{\\pi }{2})] \\\\  & =2[-\\frac{3\\pi }{2}-\\frac{\\pi }{2}]+2[0-0] \\\\  & =2(-2\\pi )+0 \\\\  & =-4\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49682/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8"] :knowledge-point/questions ["q-49682"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74087/selection/8e3d33c867c4fa31d3cc1437567aed74eb1306719408b4f8e44fcf69335a4cb2" :answer/id #uuid "0d718db8-0139-5599-9c10-89dfdd57e6b5" :answer/type :answer.type/math :answer/value "2x\\operatorname{sin}⁡(2x+8)-\\frac{\\operatorname{cos}⁡(2x+8)}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-74087/selection/fbdfcc5ab15fd553638c3aec40a50ff9ec30b497ee3f06c0a6575481894feaa1" :answer/id #uuid "5657b530-d0ce-523b-a30c-1a85a5fa4832" :answer/type :answer.type/math :answer/value "x\\operatorname{sin}⁡(2x+8)-\\operatorname{cos}⁡(2x+8)+C" :db/ensure [:answer/validate]} {:db/id "q-74087/selection/242a33c5d640e63da8ebb8865a453bb157494787982c5407947136f44b5176b1" :answer/id #uuid "8d7079a6-e943-5fcc-ba13-739868e7d119" :answer/type :answer.type/math :answer/value "2x\\operatorname{sin}⁡(2x+8)+\\frac{\\operatorname{cos}⁡(2x+8)}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-74087/selection/0aa095f9439af510054f5852c15c0a99a95202f1bdbacee595d48cf515921aca" :answer/id #uuid "adc5e511-c025-5764-a041-eb021216f48c" :answer/type :answer.type/math :answer/value "x\\operatorname{sin}⁡(2x+8)+\\frac{\\operatorname{cos}⁡(2x+8)}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-74087/selection/99703e28689480a450536ee6d921d8d8058e4abbf5d406a147e12ac2c376d183" :answer/id #uuid "073b8e54-f466-59f1-a4e4-be122d23be2e" :answer/type :answer.type/math :answer/value "2x\\operatorname{sin}⁡(2x+8)+\\operatorname{cos}⁡(2x+8)+C" :db/ensure [:answer/validate]} {:db/id "q-74087/selection" :answer-field/id #uuid "786c2e20-d1c5-529a-9b42-d805ad34339e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74087/selection/0aa095f9439af510054f5852c15c0a99a95202f1bdbacee595d48cf515921aca" :answer-field/choices ["q-74087/selection/8e3d33c867c4fa31d3cc1437567aed74eb1306719408b4f8e44fcf69335a4cb2" "q-74087/selection/fbdfcc5ab15fd553638c3aec40a50ff9ec30b497ee3f06c0a6575481894feaa1" "q-74087/selection/242a33c5d640e63da8ebb8865a453bb157494787982c5407947136f44b5176b1" "q-74087/selection/0aa095f9439af510054f5852c15c0a99a95202f1bdbacee595d48cf515921aca" "q-74087/selection/99703e28689480a450536ee6d921d8d8058e4abbf5d406a147e12ac2c376d183"] :db/ensure [:answer-field/validate]} {:db/id "q-74087" :question/id #uuid "18832ff3-531c-57c6-94fc-91fb58916351" :question/math-academy-id "q-74087" :question/problem "Calculate  $\\int 2x\\operatorname{cos}⁡(2x+8)\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 2x\\operatorname{cos}⁡(2x+8)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{cos}⁡(2x+8)\\, & ⟹\\,v=\\frac{\\operatorname{sin}⁡(2x+8)}{2}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{cos}⁡(2x+8)\\,\\text{d}x & =2x\\cdot \\frac{\\operatorname{sin}⁡(2x+8)}{2}-\\int \\frac{\\operatorname{sin}⁡(2x+8)}{2}\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{cos}⁡(2x+8)\\text{d}x & =x\\operatorname{sin}⁡(2x+8)-\\int \\operatorname{sin}⁡(2x+8)\\text{d}x \\\\  & =x\\operatorname{sin}⁡(2x+8)+\\frac{\\operatorname{cos}⁡(2x+8)}{2}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74087/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-74087"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74088/selection/5984fbd63a9d53c24bb06bf62d92389f612ab70c73a9fb398ac354309daab262" :answer/id #uuid "e72f1a55-45cf-514d-aa1d-9182a513cc9c" :answer/type :answer.type/math :answer/value "6\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74088/selection/fdb9419cc8b5004750a2523fb5668d3436d7aa833f1f3a785a5c6fa33f9a5715" :answer/id #uuid "ec3ca75b-8c77-5ed9-879e-4d77dfb6699b" :answer/type :answer.type/math :answer/value "(6x+1)\\operatorname{sin}⁡(x)+\\frac{\\operatorname{cos}⁡(x)}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-74088/selection/e56f24d201c41c86bce2f16b141307de1ca91fc5da9917c1feb1d0ecbf4f5129" :answer/id #uuid "cc55f34e-c81e-5802-aa0c-b307d58e313a" :answer/type :answer.type/math :answer/value "\\frac{(6x+1)\\operatorname{sin}⁡(x)}{6}+\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74088/selection/4c5dce79c09f6555fa63c49814ddfe1559f160b5602ccdb6aa89432ac3755092" :answer/id #uuid "b762e911-a67a-574c-a4a8-ff7f8fdaff2e" :answer/type :answer.type/math :answer/value "(6x+1)\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74088/selection/8362684a9830d619c99751164713b88f31e8ce02d754da45fa2b805252a4cae0" :answer/id #uuid "5a01268a-495f-57cb-98f4-0a27a629c636" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(x)+\\operatorname{cos}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "q-74088/selection" :answer-field/id #uuid "e3e1e112-a082-54a8-a0bb-62e948227dbd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74088/selection/4c5dce79c09f6555fa63c49814ddfe1559f160b5602ccdb6aa89432ac3755092" :answer-field/choices ["q-74088/selection/5984fbd63a9d53c24bb06bf62d92389f612ab70c73a9fb398ac354309daab262" "q-74088/selection/fdb9419cc8b5004750a2523fb5668d3436d7aa833f1f3a785a5c6fa33f9a5715" "q-74088/selection/e56f24d201c41c86bce2f16b141307de1ca91fc5da9917c1feb1d0ecbf4f5129" "q-74088/selection/4c5dce79c09f6555fa63c49814ddfe1559f160b5602ccdb6aa89432ac3755092" "q-74088/selection/8362684a9830d619c99751164713b88f31e8ce02d754da45fa2b805252a4cae0"] :db/ensure [:answer-field/validate]} {:db/id "q-74088" :question/id #uuid "53c9558d-d595-5806-b976-b416dcd019a4" :question/math-academy-id "q-74088" :question/problem "$\\int (6x+1)\\operatorname{cos}⁡(x)\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (6x+1)\\operatorname{cos}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x+1\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (6x+1)\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =(6x+1)\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 6\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows\n\n$$\n\\begin{aligned}\\int (6x+1)\\operatorname{cos}⁡(x)\\text{d}x & =(6x+1)\\operatorname{sin}⁡(x)-6\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =(6x+1)\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74088/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4"] :knowledge-point/questions ["q-74088"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349231/field-1/7e3c15f7dad2b525db05d2faa3744bb86265628c4291bcb914c4fe56bd42fbb8" :answer/id #uuid "b176a504-ffd4-5abf-9500-adc45cebbe4e" :answer/type :answer.type/math :answer/value "\\frac{4}{\\pi}" :db/ensure [:answer/validate]} {:db/id "q-349231/field-1" :answer-field/id #uuid "70ea796f-ca89-51c5-bda1-3399890e3624" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349231/field-1/7e3c15f7dad2b525db05d2faa3744bb86265628c4291bcb914c4fe56bd42fbb8" :answer-field/choices ["q-349231/field-1/7e3c15f7dad2b525db05d2faa3744bb86265628c4291bcb914c4fe56bd42fbb8"] :db/ensure [:answer-field/validate]} {:db/id "q-349231" :question/id #uuid "0a8a022e-93cb-5904-a68b-7a101ae4d8a6" :question/math-academy-id "q-349231" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\pi x) & ⇒ & v=-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))-\\int (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{\\pi }{\\int }_{0}^{1}\\operatorname{cos}⁡(\\pi x)\\,\\text{d}x \\\\  & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{{\\pi }^{2}}\\operatorname{sin}⁡(\\pi x)\\,{|}_{0}^{1} \\\\  & =-\\frac{4}{\\pi }(1\\cdot \\operatorname{cos}⁡(\\pi \\cdot 1)-0\\cdot \\operatorname{cos}⁡(\\pi \\cdot 0))+\\frac{4}{{\\pi }^{2}}(\\operatorname{sin}⁡(\\pi \\cdot 1)-\\operatorname{sin}⁡(\\pi \\cdot 0)) \\\\  & =-\\frac{4}{\\pi }(-1-0)+\\frac{4}{{\\pi }^{2}}(0-0) \\\\  & =\\frac{4}{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349231/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8"] :knowledge-point/questions ["q-349231"] :db/ensure [:knowledge-point/validate]}]
