}^{2t})-6u{e}^{2t} & =0 \\\\ {u}^{″}{e}^{2t}+5{u}^{′}{e}^{2t} & =0 \\\\ {e}^{2t}({u}^{″}+5{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{2t}\\ne 0$ for all $t,$ we must have\n\n$$\n{u}^{″}+5{u}^{′}=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64989/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ba3e0748-2a14-547e-b21e-c34251994a94"] :knowledge-point/questions ["q-64989"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77666/selection/47e473500a215b9c3851f92739cb41b3274287c419baaa194dc01d5e5ce5ad20" :answer/id #uuid "606a25e1-f61a-5e59-8daa-3fa1b4f2f40c" :answer/type :answer.type/math :answer/value "{y}_{2}(t)={t}^{3}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-77666/selection/f78898cb9505020e060f8d55256046e2ec022a17d8533446f1079cf32fb7078c" :answer/id #uuid "3fbb8f49-1f38-51dc-8abe-b0efb0c232ad" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=t{ln}^{2}⁡t" :db/ensure [:answer/validate]} {:db/id "q-77666/selection/09b14740bc8a2bc62296ac992dca5ccd1fc8992a5edcb5f8cef9b18a1f1cbb7a" :answer/id #uuid "62f2562e-0e39-5abb-b4fa-6070fcd0df6f" :answer/type :answer.type/math :answer/value "{y}_{2}(t)={t}^{5}" :db/ensure [:answer/validate]} {:db/id "q-77666/selection/65d6f7a357fb114ac033950d4e7bbef72e4fe814f52f3c035055afedc282e048" :answer/id #uuid "a1e85a2e-dbbb-55ab-902e-0152fc514e6f" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=\\frac{1}{{t}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-77666/selection/d918a2d2dd617f8dbe7177ea3568534d18c0dc18101f0845279ef3703ac5a9bc" :answer/id #uuid "e1ce4113-9fe9-5601-9be9-74bace2414f6" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=\\frac{{t}^{3}}{\\operatorname{ln}⁡t}" :db/ensure [:answer/validate]} {:db/id "q-77666/selection" :answer-field/id #uuid "eca59f16-39e7-59f2-9d5c-6a352e80ddd1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77666/selection/47e473500a215b9c3851f92739cb41b3274287c419baaa194dc01d5e5ce5ad20" :answer-field/choices ["q-77666/selection/47e473500a215b9c3851f92739cb41b3274287c419baaa194dc01d5e5ce5ad20" "q-77666/selection/f78898cb9505020e060f8d55256046e2ec022a17d8533446f1079cf32fb7078c" "q-77666/selection/09b14740bc8a2bc62296ac992dca5ccd1fc8992a5edcb5f8cef9b18a1f1cbb7a" "q-77666/selection/65d6f7a357fb114ac033950d4e7bbef72e4fe814f52f3c035055afedc282e048" "q-77666/selection/d918a2d2dd617f8dbe7177ea3568534d18c0dc18101f0845279ef3703ac5a9bc"] :db/ensure [:answer-field/validate]} {:db/id "q-77666" :question/id #uuid "0b96cb92-808f-528e-898e-4dcef68a7f9d" :question/math-academy-id "q-77666" :question/problem "The function ${y}_{1}(t)={t}^{3}$ is a solution to the equation ${t}^{2}{y}^{″}-5t{y}^{′}+9y=0$ for $t>0.$ Use reduction of order to find a second solution ${y}_{2}(t)$ to the equation." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(t)\\cdot {t}^{3}.$ \n\nDifferentiating ${y}_{2}=u(t){t}^{3}$ with respect to $t$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{t}^{3}+3u{t}^{2} \\\\ {y}_{2}^{″} & ={u}^{″}{t}^{3}+6{u}^{′}{t}^{2}+6ut.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}({u}^{″}{t}^{3}+6{u}^{′}{t}^{2}+6ut)-5t({u}^{′}{t}^{3}+3u{t}^{2})+9u{t}^{3} & =0 \\\\ {t}^{3}({u}^{″}{t}^{2}+6{u}^{′}t+6u-5{u}^{′}t-15u+9u) & =0 \\\\ {t}^{3}({u}^{″}{t}^{2}+{u}^{′}t) & =0 \\\\ {t}^{4}({u}^{″}t+{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${t}^{4}\\ne 0$ for $t>0,$ we must have\n\n$$\n{u}^{″}t+{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}t+w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw=\\frac{{c}_{1}}{t}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}=\\frac{{c}_{1}}{t}\\,⟹\\,u={c}_{1}\\operatorname{ln}⁡t+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(t)=u{t}^{3}$ becomes\n\n$$\n{y}_{2}(t)={t}^{3}({c}_{1}\\operatorname{ln}⁡t+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=1$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(t)={t}^{3}\\operatorname{ln}⁡t.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77666/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7ae919f-4a7f-50e3-8c2f-7cea0b5a66ee"] :knowledge-point/questions ["q-77666"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65020/selection/65d6f7a357fb114ac033950d4e7bbef72e4fe814f52f3c035055afedc282e048" :answer/id #uuid "decf45e6-d8a6-5f93-a8a6-912aa1ed45f3" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=\\frac{1}{{t}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-65020/selection/b14b2fd25ec69c89283498f610200969e3b27c8705ced0ffc01475e9e4df5ce6" :answer/id #uuid "43a7e05e-5a83-5440-bb68-86b1720abc6d" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-65020/selection/21703a14ba29130b4d36d8c3cfa2b184ed6577942d1f130ea5ac76f13c3bfc4e" :answer/id #uuid "b1192e38-4b82-53ef-81d5-c457ef9d7e29" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=t\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-65020/selection/4bf7168bc33612b0989d0a9a12d881e4808ea9e4f49c418683e2ea530abfb19a" :answer/id #uuid "87505817-ee76-5620-878d-d7c7ab8c70fc" :answer/type :answer.type/math :answer/value "{y}_{2}(t)={t}^{2}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-65020/selection/eaecf167867dcff5598e2ae7bad9b8ebeaf42f55ebbe726ff436dc63ac364c5b" :answer/id #uuid "0e6145c6-674d-53b1-8eb0-d035c8df6be3" :answer/type :answer.type/math :answer/value "{y}_{2}(t)=t" :db/ensure [:answer/validate]} {:db/id "q-65020/selection" :answer-field/id #uuid "f1c61356-6674-5890-8451-bcb8eeadd725" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65020/selection/4bf7168bc33612b0989d0a9a12d881e4808ea9e4f49c418683e2ea530abfb19a" :answer-field/choices ["q-65020/selection/65d6f7a357fb114ac033950d4e7bbef72e4fe814f52f3c035055afedc282e048" "q-65020/selection/b14b2fd25ec69c89283498f610200969e3b27c8705ced0ffc01475e9e4df5ce6" "q-65020/selection/21703a14ba29130b4d36d8c3cfa2b184ed6577942d1f130ea5ac76f13c3bfc4e" "q-65020/selection/4bf7168bc33612b0989d0a9a12d881e4808ea9e4f49c418683e2ea530abfb19a" "q-65020/selection/eaecf167867dcff5598e2ae7bad9b8ebeaf42f55ebbe726ff436dc63ac364c5b"] :db/ensure [:answer-field/validate]} {:db/id "q-65020" :question/id #uuid "ede04736-3948-519e-a331-a0a63de50619" :question/math-academy-id "q-65020" :question/problem "The function ${y}_{1}(t)={t}^{2}$ is a solution to the equation ${t}^{2}{y}^{″}-3t{y}^{′}+4y=0$ for $t>0.$ Use reduction of order to find a second solution ${y}_{2}(t)$ to the equation." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(t)\\cdot {t}^{2}.$ \n\nDifferentiating ${y}_{2}=u(t){t}^{2}$ with respect to $t$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{t}^{2}+2ut \\\\ {y}_{2}^{″} & ={u}^{″}{t}^{2}+4{u}^{′}t+2u.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}({u}^{″}{t}^{2}+4{u}^{′}t+2u)-3t({u}^{′}{t}^{2}+2ut)+4u{t}^{2} & =0 \\\\ {t}^{2}({u}^{″}{t}^{2}+4{u}^{′}t+2u-3{u}^{′}t-6u+4u) & =0 \\\\ {t}^{2}({u}^{″}{t}^{2}+{u}^{′}t) & =0 \\\\ {t}^{3}({u}^{″}t+{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${t}^{3}\\ne 0$ for $t>0,$ we must have\n\n$$\n{u}^{″}t+{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}t+w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw=\\frac{{c}_{1}}{t}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}=\\frac{{c}_{1}}{t}\\,⟹\\,u={c}_{1}\\operatorname{ln}⁡t+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(t)=u{t}^{2}$ becomes\n\n$$\n{y}_{2}(t)={t}^{2}({c}_{1}\\operatorname{ln}⁡t+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=1$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(t)={t}^{2}\\operatorname{ln}⁡t.\n$$" :question/difficulty :question.difficulty/hard 