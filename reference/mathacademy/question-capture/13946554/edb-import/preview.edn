1}\n$$\n\nTherefore, there are $21$ digits in total. \nSo, the number of odd digits in the number is\n\n$$\n21-7=14.\n$$" 13194139533811 true] [17592186252880 1000 #edb/ref 17592186252881 13194139533811 true] [17592186252880 1000 #edb/ref 17592186252882 13194139533811 true] [17592186252880 1000 #edb/ref 17592186252883 13194139533811 true] [17592186252880 1000 #edb/ref 17592186252884 13194139533811 true] [17592186252880 1000 #edb/ref 17592186252885 13194139533811 true] [17592186252880 1040 #edb/ref 17592186045450 13194139533811 true] [17592186252880 1041 "selection" 13194139533811 true] [17592186252880 1104 #edb/ref 17592186252884 13194139533811 true] [17592186252880 1110 #uuid "2f6cbbf9-10ea-52fb-b510-d9a7e0c6e6e3" 13194139533811 true] [17592186252881 1034 "12" 13194139533811 true] [17592186252881 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252881 1111 #uuid "b0a6cff7-aaf4-5d71-a41c-4820cf60c15d" 13194139533811 true] [17592186252882 1034 "15" 13194139533811 true] [17592186252882 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252882 1111 #uuid "9d5136c1-677f-59a8-be3c-2f7ca7140b9d" 13194139533811 true] [17592186252883 1034 "21" 13194139533811 true] [17592186252883 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252883 1111 #uuid "2d17cb40-4698-5763-8234-245ecdf7d7d2" 13194139533811 true] [17592186252884 1034 "14" 13194139533811 true] [17592186252884 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252884 1111 #uuid "201ce330-bfed-5c99-9af0-fc991066b16f" 13194139533811 true] [17592186252885 1034 "17" 13194139533811 true] [17592186252885 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252885 1111 #uuid "fa43f59a-a54b-5117-9f35-3f6c624157da" 13194139533811 true] [17592186252886 1017 #edb/ref 17592186252887 13194139533811 true] [17592186252886 1089 "q-147076" 13194139533811 true] [17592186252886 1091 #edb/ref 17592186045464 13194139533811 true] [17592186252886 1100 "In a table, each cell was colored either yellow or green. The ratio of yellow cells to the total number of cells is $2:3.$ If there are $24$ yellow cells, how many cells were colored green?" 13194139533811 true] [17592186252886 1113 #uuid "8fcba180-254a-510d-b667-40abfdc30f60" 13194139533811 true] [17592186252886 1145 "We are given that the ratio of yellow cells to the total number of cells is $\\frac{2}{3}.$ \n\nIn this fraction, the numerator represents the number of yellow cells, and the denominator represents the total number of cells.\n\nWe can make a numerator of $24$ by multiplying the numerator and denominator by $12:$\n\n$$\n\\frac{2\\times 12}{3\\times 12}=\\frac{24}{36}\n$$\n\nTherefore, there are a total of $36$ cells in the table. \nSo, the number of green cells is\n\n$$\n36-24=12.\n$$" 13194139533811 true] [17592186252887 1000 #edb/ref 17592186252888 13194139533811 true] [17592186252887 1000 #edb/ref 17592186252889 13194139533811 true] [17592186252887 1000 #edb/ref 17592186252890 13194139533811 true] [17592186252887 1000 #edb/ref 17592186252891 13194139533811 true] [17592186252887 1000 #edb/ref 17592186252892 13194139533811 true] [17592186252887 1040 #edb/ref 17592186045450 13194139533811 true] [17592186252887 1041 "selection" 13194139533811 true] [17592186252887 1104 #edb/ref 17592186252888 13194139533811 true] [17592186252887 1110 #uuid "9c81c5ca-072c-5e32-b475-c9a712b74568" 13194139533811 true] [17592186252888 1034 "12" 13194139533811 true] [17592186252888 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252888 1111 #uuid "3ee90e89-5bb1-521f-a59f-f075f4d1223e" 13194139533811 true] [17592186252889 1034 "20" 13194139533811 true] [17592186252889 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252889 1111 #uuid "6b3550e7-c5d5-5fd7-b756-780746a7d59c" 13194139533811 true] [17592186252890 1034 "16" 13194139533811 true] [17592186252890 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252890 1111 #uuid "02e23d35-0f7c-5634-b655-ed36c91321ff" 13194139533811 true] [17592186252891 1034 "18" 13194139533811 true] [17592186252891 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252891 1111 #uuid "e21344c4-831f-5bac-a3ae-621075c14d7e" 13194139533811 true] [17592186252892 1034 "24" 13194139533811 true] [17592186252892 1103 #edb/ref 17592186045453 13194139533811 true] [17592186252892 1111 #uuid "a462d389-968a-5051-95a0-99adc6016464" 13194139533811 true] [17592186252893 1017 #edb/ref 17592186252894 13194139533811 true] [17592186252893 1089 "q-147213" 13194139533811 true] [17592186252893 1091 #edb/ref 17592186045464 13194139533811 true] [17592186252893 1100 "A bag contains blue and green buttons. The ratio of blue buttons to the total number of buttons is $2:7.$ If there are $14$ blue buttons,  how many green buttons are in the bag?" 13194139533811 true] [17592186252893 1113 #uuid "b9477d3a-e0b3-5de2-b961-481217c4236a" 13194139533811 true] [17592186252893 1145 "We are given that the ratio of blue buttons to the total number of buttons is $\\frac{2}{7}.$ \n\nIn this fraction, the numerator represents the number of blue buttons, and the denominator represents the total number of buttons.\n\nWe can make a numerator of $14$ by multiplying the numerator and denominator by $7:$\n\n$$\n\\frac{2\\times 7}{7\\times 7}=\\frac{14}{49}\n$$\n\nTherefore, there are a total of $49$ buttons in the bag. \nSo, the number of green buttons is\n\n$$\n49-14=35.\n$$" 13194139533811 true] [17592186252894 1000 #edb/ref 17592186252895 13194139533811 true] [17592186252894 1000 #edb/ref 17592186252896 13194139533811 true] [17592186252894 1000 #edb/ref 17592186252897 13194139533811 true] [17592186252894 1000 #edb/ref 17592186252898 13194139533811 true] [17592186252894 1000 #edb/ref 17592186252899 13194139533811 true] [17592186252894 1040 #edb/ref 17592186045450 13194139533811 true] [17592186252894 1041 "selection" 13194139533811 true] [17592186252894 1104 #edb/ref 17592186252896 13194139533811 true] [17592186252894 1110 #uuid "37d2d883-240a-5f1c-91ea-2bc381bfdec8" 