/validate]} {:db/id [:question/math-academy-id "q-59887"] :question/worked-solution "We start with the ratio $2:1$ and write it as a fraction:\n\n$$\n\\frac{2}{1}\n$$\n\nIn this fraction, the numerator represents the number of girls, and the denominator represents the number of boys.\n\nWe can make a numerator of $10$ by multiplying the numerator and denominator by $5:$\n\n$$\n\\frac{2\\times 5}{1\\times 5}=\\frac{10}{5}\n$$\n\nTherefore, there are $10$ girls and $5$ boys in the club. So the total number of members is \n\n$$\n10+5=15.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-147075/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "201ce330-bfed-5c99-9af0-fc991066b16f" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-147075/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "9d5136c1-677f-59a8-be3c-2f7ca7140b9d" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-147075/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "2d17cb40-4698-5763-8234-245ecdf7d7d2" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-147075/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "fa43f59a-a54b-5117-9f35-3f6c624157da" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-147075/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "b0a6cff7-aaf4-5d71-a41c-4820cf60c15d" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-147075/selection" :answer-field/id #uuid "2f6cbbf9-10ea-52fb-b510-d9a7e0c6e6e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-147075/selection/83c228576338