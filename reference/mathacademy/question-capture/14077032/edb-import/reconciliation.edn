9cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128479" "field" nil "attribute" "question/worked-solution" "value" "By the scalar function multiple rule, we have\n\n$$\n(u(t)g(t))^{′}=u(t){g}^{′}(t)+{u}^{′}(t)g(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${g}^{′}(t).$ \n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(1+t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2})⟩ \\\\  & =⟨1,\\,1,\\,2t⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(1-t) \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & =u(t){g}^{′}(t)+{u}^{′}(t)g(t) \\\\  & =(1-t)⟨1,\\,1,\\,2t⟩-⟨t,\\,1+t,\\,{t}^{2}⟩ \\\\  & =⟨1-t,\\,1-t,\\,2t-2{t}^{2}⟩-⟨t,\\,1+t,\\,{t}^{2}⟩ \\\\  & =⟨1-2t,\\,-2t,\\,2t-3{t}^{2}⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128479" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-128479" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128479" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨1+t,\\,2+t,\\,t+3{t}^{2}⟩"] ["math" "⟨1-2t,\\,-1,\\,2t-3{t}^{2}⟩"] ["math" "⟨1-2t,\\,-2t,\\,2t-3{t}^{2}⟩"] ["math" "⟨t,\\,-2{t}^{2},\\,2t-3{t}^{2}⟩"] ["math" "⟨t-2,\\,-t,\\,t-2{t}^{2}⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128479" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨1-2t,\\,-2t,\\,2t-3{t}^{2}⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-71230" "field" nil "attribute" "question/problem" "value" "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}{e}^{t} \\\\ 8 \\\\ {e}^{-t}\\end{aligned}]$ and $u(t)={t}^{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-71230" "field" nil "attribute" "question/worked-solution" "value" "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(8) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{-t})\\end{aligned}]=[\\begin{aligned}{e}^{t} \\\\ 0 \\\\ -{e}^{-t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =2t[\\begin{aligned}{e}^{t} \\\\ 8 \\\\ {e}^{-t}\\end{aligned}]+{t}^{2}[\\begin{aligned}{e}^{t} \\\\ 0 \\\\ -{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}2t{e}^{t} \\\\ 16t \\\\ 2t{e}^{-t}\\end{aligned}]+[\\begin{aligned}{t}^{2}{e}^{t} \\\\ 0 \\\\ -{t}^{2}{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-71230" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-71230" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-71230" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}(1-{t}^{2}){e}^{t} \\\\ 8t \\\\ (t+{t}^{2}){e}^{-t}\\end{aligned}]"] ["math" "[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]"] ["math" "[\\begin{aligned}({t}^{2}+{t}^{3}){e}^{t} \\\\ 4t \\\\ {t}^{3}{e}^{-t}\\end{aligned}]"] ["math" "[\\begin{aligned}3t{e}^{t} \\\\ -8t \\\\ -3t{e}^{-t}\\end{aligned}]"] ["math" "[\\begin{aligned}3{t}^{3}{e}^{t} \\\\ -16t \\\\ -{t}^{3}{e}^{-t}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-71230" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-70695" "field" nil "attribute" "question/problem" "value" "If $f(u)=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ {u}^{3} \\\\ \\operatorname{ln}⁡u\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-70695" "field" nil "attribute" "question/worked-solution" "value" "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-70695" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-70695" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-70695" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]"] ["math" "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]"] ["math" "[\\begin{aligned}\\operatorname{sin}⁡({e}^{2t}) \\\\ {e}^{3t} \\\\ \\frac{1}{{e}^{2t}}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-70695" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32860" "field" nil "attribute" "question/problem" "value" "If $g(u)=[\\begin{aligned}\\operatorname{ln}⁡u \\\\ 5 \\\\ {u}^{2}\\end{aligned}]$ and $u(t)=\\operatorname{ln}⁡t$, then  $(g∘u)^{′}(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32860" "field" nil "attribute" "question/worked-solution" "value" "By the chain rule, we have \n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{g}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}\\operatorname{ln}⁡u \\\\ \\frac{\\text{d}}{\\text{d}u}\\,\\,5\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}u}\\,\\,{u}^{2}\\,\\,\\end{aligned}]=[\\begin{aligned}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)=\\frac{1}{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =[\\begin{aligned}\\frac{1}{u(t)} \\\\ 0 \\\\ 2u(t)\\end{aligned}]{u}^{′}(t) \\\\  & =\\frac{1}{t}[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ 2\\operatorname{ln}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32860" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-32860" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32860" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ 2\\operatorname{ln}⁡t\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]"] ["math" "[\\begin{aligned}\\frac{1}{u} \\\\ 0 \\\\ 2u\\end{aligned}]"] ["math" "[\\begin{aligned}u \\\\ 5 \\\\ 2u\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32860" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}\\frac{1}{t\\operatorname{ln}⁡t} \\\\ 0 \\\\ \\frac{2\\operatorname{ln}⁡t}{t}\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128561" "field" nil "attribute" "question/problem" "value" "If $f(u)=\\operatorname{ln}⁡u\\,i+{u}^{2}\\,j+\\sqrt{u}\\,k$ and $u(t)={e}^{-t},$ then $(f∘u)^{′}(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128561" "field" nil "attribute" "question/worked-solution" "value" "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)i+\\frac{\\text{d}}{\\text{d}u}({u}^{2})j+\\frac{\\text{d}}{\\text{d}u}(\\sqrt{u})k \\\\  & =\\frac{1}{u}\\,i+2u\\,j+\\frac{1}{2\\sqrt{u}}\\,k \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{-t})=-{e}^{-t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t))\\cdot {u}^{′}(t) \\\\  & =(\\frac{1}{u(t)}\\,i+2u(t)\\,j+\\frac{1}{2\\sqrt{u(t)}}\\,k)\\cdot {u}^{′}(t) \\\\  & =(\\frac{1}{{e}^{-t}}\\,i+2{e}^{-t}\\,j+\\frac{1}{2\\sqrt{{e}^{-t}}}\\,k)\\cdot (-{e}^{-t}) \\\\  & =({e}^{t}\\,i+2{e}^{-t}\\,j+\\frac{1}{2}{e}^{t/2}\\,k)\\cdot (-{e}^{-t}) \\\\  & =-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128561" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-128561" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128561" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k"] ["math" "-\\,i-2{e}^{2t}\\,j-\\frac{1}{2}{e}^{t}\\,k"] ["math" "-\\,i-{e}^{-2t}\\,j-2{e}^{-t/2}\\,k"] ["math" "\\,i-2{e}^{-t}\\,j-\\frac{1}{4}{e}^{-t/2}\\,k"] ["math" "\\,i-4{e}^{-2t}\\,j-2{e}^{-3t/2}\\,k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128561" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\,i-2{e}^{-2t}\\,j-\\frac{1}{2}{e}^{-t/2}\\,k"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33260" "field" nil "attribute" "question/problem" "value" "If $f(u)={e}^{u+1}\\,i+{e}^{2u}\\,j+\\frac{1}{e}\\,k$ and $u(t)=2{t}^{2}$ then $(f∘u)^{′}(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33260" "field" nil "attribute" "question/worked-solution" "value" "By the chain rule, we have\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}({e}^{u+1})\\,i+\\frac{\\text{d}}{\\text{d}u}({e}^{2u})\\,j+\\frac{\\text{d}}{\\text{d}u}\\frac{1}{e}\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2u}\\,j+0\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2t}\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})=4t\\end{aligned}\n$$\n\n \nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\ (f∘u)^{′}(t) & =({e}^{2{t}^{2}+1}\\,i+2{e}^{4{t}^{2}}\\,j)4t \\\\  & =4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33260" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-33260" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33260" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j"] ["math" "4t{e}^{t+1}\\,i+6t{e}^{2t}\\,j"] ["math" "4{e}^{2{t}^{2}+1}\\,i-8{e}^{4{t}^{2}}\\,j"] ["math" "t{e}^{2t+1}\\,i+2t{e}^{4t}\\,j"] ["math" "t{e}^{t+1}\\,i+2t{e}^{2t}\\,j"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33260" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128572" "field" nil "attribute" "question/problem" "value" "If $f(u)=[\\begin{aligned}u \\\\ {u}^{2} \\\\ 6\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128572" "field" nil "attribute" "question/worked-solution" "value" "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}u}(6)\\end{aligned}]=[\\begin{aligned}1 \\\\ 2u \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =[\\begin{aligned}1 \\\\ 2u(t) \\\\ 0\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}1 \\\\ 2({e}^{t}) \\\\ 0\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128572" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-128572" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128572" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 \\\\ 3{e}^{t} \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}t \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}]"] ["math" "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-128572" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32347" "field" nil "attribute" "question/problem" "value" "Find $(f\\times g)^{′}(t)$ given that\n\n$$\n\\begin{aligned}f(t) & =⟨6{t}^{2},\\,2t,\\,6⟩ \\\\ g(t) & =⟨3,\\,3{t}^{2},\\,4t-1⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32347" "field" nil "attribute" "question/worked-solution" "value" "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(6)⟩ \\\\  & =⟨12t,\\,2,\\,0⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(4t-1)⟩ \\\\  & =⟨0,\\,6t,\\,4⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 12t & 2 & 0 \\\\ 3 & 3{t}^{2} & (4t-1)\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ 3{t}^{2} & (4t-1)\\end{aligned}|i-|\\begin{aligned}12t & 0 \\\\ 3 & (4t-1)\\end{aligned}|j+|\\begin{aligned}12t & 2 \\\\ 3 & 3{t}^{2}\\end{aligned}|k \\\\  & =⟨8t-2,\\,12t-48{t}^{2},\\,36{t}^{3}-6⟩ \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ 6{t}^{2} & 2t & 6 \\\\ 0 & 6t & 4\\end{aligned}| \\\\  & =|\\begin{aligned}2t & 6 \\\\ 6t & 4\\end{aligned}|i-|\\begin{aligned}6{t}^{2} & 6 \\\\ 0 & 4\\end{aligned}|j+|\\begin{aligned}6{t}^{2} & 2t \\\\ 0 & 6t\\end{aligned}|k \\\\  & =⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =⟨8t-2,\\,12t-48{t}^{2},\\,36{t}^{3}-6⟩+⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩ \\\\  & =⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32347" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-32347" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32347" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩"] ["math" "⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩"] ["math" "⟨20t-2,\\,36{t}^{2}+12t,\\,72{t}^{3}⟩"] ["math" "⟨48t-2,\\,-362{t}^{2}+12t,\\,6⟩"] ["math" "⟨8t-2,\\,-48{t}^{2}+12t,\\,36{t}^{3}-6⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32347" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33336" "field" nil "attribute" "question/problem" "value" "Find $(f\\cdot g)^{′}(t)$, given that\n\n$$\n\\begin{aligned}f(t) & =\\operatorname{ln}⁡t\\,i+\\frac{1}{t}\\,j+t\\,k \\\\ g(t) & =t\\,i+\\frac{1}{t}\\,j+\\operatorname{ln}⁡t\\,k\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33336" "field" nil "attribute" "question/worked-solution" "value" "Using the dot product rule, we can write:\n\n$$\n(f\\cdot g)^{′}(t)={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =\\frac{1}{t}\\,i+(-\\frac{1}{{t}^{2}})\\,j+1\\,k \\\\  & =\\frac{1}{t}\\,i-\\frac{1}{{t}^{2}}\\,j+k \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\,k \\\\  & =1\\,i+(-\\frac{1}{{t}^{2}})\\,j+\\frac{1}{t}\\,k \\\\  & =i-\\frac{1}{{t}^{2}}\\,j+\\frac{1}{t}\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f\\cdot g)^{′}(t) & ={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t) \\\\  & =(\\frac{1}{t}\\,i-\\frac{1}{{t}^{2}}\\,j+k)\\cdot (t\\,i+\\frac{1}{t}\\,j+\\operatorname{ln}⁡t\\,k)+(\\operatorname{ln}⁡t\\,i+\\frac{1}{t}\\,j+t\\,k)\\cdot (i-\\frac{1}{{t}^{2}}\\,j+\\frac{1}{t}\\,k) \\\\  & =(\\frac{1}{t}\\cdot t-\\frac{1}{{t}^{2}}\\cdot \\frac{1}{t}+1\\cdot \\operatorname{ln}⁡t)+(\\operatorname{ln}⁡t\\cdot 1+\\frac{1}{t}(-\\frac{1}{{t}^{2}})+t\\cdot \\frac{1}{t}) \\\\  & =1-\\frac{1}{{t}^{3}}+\\operatorname{ln}⁡t+\\operatorname{ln}⁡t-\\frac{1}{{t}^{3}}+1 \\\\  & =2\\operatorname{ln}⁡t+2-\\frac{2}{{t}^{3}}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33336" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-33336" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33336" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "2\\operatorname{ln}⁡t+2-\\frac{2}{{t}^{3}}"] ["math" "2\\operatorname{ln}⁡t+\\frac{2}{{t}^{3}}"] ["math" "\\operatorname{ln}⁡t+1+\\frac{1}{{t}^{3}}"] ["math" "\\operatorname{ln}⁡t+1-\\frac{1}{{t}^{3}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33336" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{ln}⁡t+2-\\frac{2}{{t}^{3}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32353" "field" nil "attribute" "question/problem" "value" "Find $(f\\times g)^{′}(t)$ where\n\n$$\nf(t)=[\\begin{aligned}3{t}^{2} \\\\ t+4 \\\\ 8\\end{aligned}],\\,g(t)=[\\begin{aligned}t+2 \\\\ -2{t}^{2} \\\\ 5t\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32353" "field" nil "attribute" "question/worked-solution" "value" "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(t+4) \\\\ \\frac{\\text{d}}{\\text{d}t}(8)\\end{aligned}]=[\\begin{aligned}6t \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {g}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(t+2) \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(5t)\\end{aligned}]=[\\begin{aligned}1 \\\\ -4t \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 6t & 1 & 0 \\\\ t+2 & -2{t}^{2} & 5t\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 \\\\ -2{t}^{2} & 5t\\end{aligned}|i-|\\begin{aligned}6t & 0 \\\\ t+2 & 5t\\end{aligned}|j+|\\begin{aligned}6t & 1 \\\\ t+2 & -2{t}^{2}\\end{aligned}|k \\\\  & =[\\begin{aligned}5t \\\\ -30{t}^{2} \\\\ -12{t}^{3}-t-2\\end{aligned}] \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ 3{t}^{2} & t+4 & 8 \\\\ 1 & -4t & 5\\end{aligned}| \\\\  & =|\\begin{aligned}t+4 & 8 \\\\ -4t & 5\\end{aligned}|i-|\\begin{aligned}3{t}^{2} & 8 \\\\ 1 & 5\\end{aligned}|j+|\\begin{aligned}3{t}^{2} & t+4 \\\\ 1 & -4t\\end{aligned}|k \\\\  & =[\\begin{aligned}37t+20 \\\\ 8-15{t}^{2} \\\\ -12{t}^{3}-t-4\\end{aligned}]\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =[\\begin{aligned}5t \\\\ -30{t}^{2} \\\\ -12{t}^{3}-t-2\\end{aligned}]+[\\begin{aligned}37t+20 \\\\ 8-15{t}^{2} \\\\ -12{t}^{3}-t-4\\end{aligned}]=[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32353" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-32353" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32353" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-24{t}^{3}-2t-6 \\\\ 8-45{t}^{2} \\\\ 42t+20\\end{aligned}]"] ["math" "[\\begin{aligned}-42t-20 \\\\ 8-45{t}^{2} \\\\ 24{t}^{3}+2t+6\\end{aligned}]"] ["math" "[\\begin{aligned}21t+10 \\\\ 45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]"] ["math" "[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]"] ["math" "[\\begin{aligned}8-45{t}^{2} \\\\ 42t+20 \\\\ -24{t}^{3}-2t-6\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32353" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32298" "field" nil "attribute" "question/problem" "value" "Find $(f\\cdot g)^{′}(t)$, given that \n\n$$\n\\begin{aligned}f(t) & =20t\\,i-2t\\,j+(2+5t)\\,k \\\\ g(t) & ={t}^{3}\\,i+t\\,j+({t}^{2}+t)\\,k\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32298" "field" nil "attribute" "question/worked-solution" "value" "Using the dot product rule, we can write:\n\n$$\n(f\\cdot g)^{′}(t)={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(20t)\\,i-\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2+5t)\\,k \\\\  & =20\\,i-2\\,j+5\\,k \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\,k \\\\  & =3{t}^{2}\\,i+j+(2t+1)\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f\\cdot g)^{′}(t) & ={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t) \\\\  & =(20\\,i-2\\,j+5\\,k)\\cdot ({t}^{3}\\,i+t\\,j+({t}^{2}+t)\\,k)+(20t\\,i-2t\\,j+(2+5t)\\,k)\\cdot (3{t}^{2}\\,i+j+(2t+1)\\,k) \\\\  & =(20{t}^{3}-2t+5({t}^{2}+t))+(60{t}^{3}-2t+(2+5t)(2t+1)) \\\\  & =80{t}^{3}+15{t}^{2}+10t+2\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32298" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-32298" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32298" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "60{t}^{3}+15{t}^{2}+14t+2"] ["math" "60{t}^{3}+7{t}^{2}+10t+2"] ["math" "80{t}^{3}+11{t}^{2}+12t+2"] ["math" "80{t}^{3}+15{t}^{2}+10t+2"] ["math" "80{t}^{3}+6{t}^{2}+10t+2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-32298" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "80{t}^{3}+15{t}^{2}+10t+2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33446" "field" nil "attribute" "question/problem" "value" "Find $(v(t)f(t))^{′}$ given that  $f(t)=⟨{2}^{t},\\,{2}^{t+1},\\,{2}^{2t}+1⟩$ and $v(t)=\\frac{1}{{2}^{t}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33446" "field" nil "attribute" "question/worked-solution" "value" "By the scalar function multiple rule, we have\n\n$$\n(v(t)f(t))^{′}=v(t){f}^{′}(t)+{v}^{′}(t)f(t)\n$$\n\nLet's find ${v}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({2}^{t+1}),\\,\\frac{\\text{d}}{\\text{d}t}({2}^{2t}+1)⟩ \\\\  & =⟨{2}^{t}\\operatorname{ln}⁡2,\\,{2}^{t+1}\\operatorname{ln}⁡2,\\,2\\cdot {2}^{2t}\\operatorname{ln}⁡2⟩ \\\\ {v}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{2}^{t}})=-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)f(t))^{′} & =v(t){f}^{′}(t)+{v}^{′}(t)f(t) \\\\  & =\\frac{1}{{2}^{t}}⟨{2}^{t}\\operatorname{ln}⁡2,\\,{2}^{t+1}\\operatorname{ln}⁡2,\\,2\\cdot {2}^{2t}\\operatorname{ln}⁡2⟩-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}⟨{2}^{t},\\,{2}^{t+1},\\,{2}^{2t}+1⟩ \\\\  & =⟨\\frac{{2}^{t}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{{2}^{t+1}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{2\\cdot {2}^{2t}\\operatorname{ln}⁡2}{{2}^{t}}⟩-⟨\\frac{{2}^{t}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{{2}^{t+1}2\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{({2}^{2t}+1)\\operatorname{ln}⁡2}{{2}^{t}}⟩ \\\\  & =⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33446" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/activity-metadata.json" "file_sha256" "d8917056359fc7a911c9849366c5e395853b5f615dfe124852814926eef334a1"} {"question" "q-33446" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33446" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨0,\\,-\\frac{\\operatorname{ln}⁡2}{{2}^{t}},\\,0⟩"] ["math" "⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩"] ["math" "⟨0,\\,\\operatorname{ln}⁡2,\\,-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}⟩"] ["math" "⟨\\operatorname{ln}⁡2,\\,\\operatorname{ln}⁡2,\\,({2}^{2t}-1)\\operatorname{ln}⁡2⟩"] ["math" "⟨{2}^{t},\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "q-33446" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/state.json" "file_sha256" "b4f5b322733198c84d46359cde75010b298d8bee79122a21c2d613fc18db5a21"} {"question" "e-2477" "field" nil "attribute" "question/problem" "value" "Find the derivative of $\\mathbf f(t) + 2\\mathbf g(t)$ with respect to $t,$ where $\\mathbf f(t)$ and $\\mathbf g(t)$ are defined as follows:\n\n$$\n\\begin{aligned}f(t) & =(4{t}^{2}+9)\\,i-(\\frac{1}{t-2})\\,j+\\operatorname{cos}⁡2t\\,k \\\\ g(t) & =(4t-1)\\,i+{e}^{3t}\\,j+\\operatorname{cos}⁡2t\\,k\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2477.json" "file_sha256" "e486489bcd5484ab04f53931e3f20b0f707b556a45827a11e9d1c1398e737358"} {"question" "e-2477" "field" nil "attribute" "question/worked-solution" "value" "Using the constant multiple rule and the sum rule, we have\n\n$$\n(\\mathbf f(t) + 2\\mathbf g(t))' = \\mathbf f'(t) + 2\\mathbf g'(t).\n$$\n\nNow, let's find the derivative of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}+9)\\,i+\\frac{\\text{d}}{\\text{d}t}(-\\frac{1}{t-2})\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)\\,k \\\\  & =8t\\,i+\\frac{1}{(t-2)^{2}}\\,j-2\\operatorname{sin}⁡2t\\,k, \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4t-1)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{3t})j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)k \\\\  & =4\\,i+3{e}^{3t}\\,j-2\\operatorname{sin}⁡2t\\,k.\\end{aligned}\n$$\n\n \n\nTherefore, we have\n\n$$\n\\begin{aligned}(f(t)+2g(t))^{′} & ={f}^{′}(t)+2{g}^{′}(t) \\\\  & =(8t\\,i+\\frac{1}{(t-2)^{2}}\\,j-2\\operatorname{sin}⁡2t\\,k)+2(4\\,i+3{e}^{3t}\\,j-2\\operatorname{sin}⁡2t\\,k) \\\\  & =8(t+1)\\,i+(\\frac{1}{(t-2)^{2}}+6{e}^{3t})\\,j-6\\operatorname{sin}⁡2t\\,k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2477.json" "file_sha256" "e486489bcd5484ab04f53931e3f20b0f707b556a45827a11e9d1c1398e737358"} {"question" "e-2478" "field" nil "attribute" "question/problem" "value" "Find $\\big( u(t) \\mathbf g(t) \\big)'$ where ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/assets/9e23d542bfc56d506f5437a35a92c304d618109ef60086e1f5a7a4fee57d8a80.png) and $u(t) = t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2478.json" "file_sha256" "1e3e5c0534ecbe5bf38729e89b4367d1e3fc16deda34252c3fefba9824f1fa07"} {"question" "e-2478" "field" nil "attribute" "question/worked-solution" "value" "Using the scalar function multiple rule, we have\n\n$$\n\\big( u(t) \\mathbf g(t) \\big)' = u'(t) \\mathbf{g}(t) + u(t) \\mathbf{g}'(t).\n$$\n\nLet's find $\\mathbf g'(t)$ and $u'(t),$ as follows:\n\n$$\n\\begin{aligned}{g}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(-t) \\\\ \\frac{\\text{d}}{\\text{d}t}{e}^{2t}\\end{aligned}]=[\\begin{aligned}\\frac{1}{t} \\\\ -1 \\\\ 2{e}^{2t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & ={u}^{′}(t)g(t)+u(t){g}^{′}(t) \\\\  & =1\\cdot [\\begin{aligned}\\operatorname{ln}⁡t \\\\ -t \\\\ {e}^{2t}\\end{aligned}]+t\\cdot [\\begin{aligned}\\frac{1}{t} \\\\ -1 \\\\ 2{e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡t \\\\ -t \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}1 \\\\ -t \\\\ 2t{e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}1+\\operatorname{ln}⁡t \\\\ -2t \\\\ (2t+1){e}^{2t}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2478.json" "file_sha256" "1e3e5c0534ecbe5bf38729e89b4367d1e3fc16deda34252c3fefba9824f1fa07"} {"question" "e-2479" "field" nil "attribute" "question/problem" "value" "Find $(\\mathbf f \\circ u)'(t),$ if $\\mathbf f(u) = \\ln u \\, \\mathbf i + (u^2+5) \\, \\mathbf j + 4u \\, \\mathbf k$ and $u(t) =2t^3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2479.json" "file_sha256" "28113e7a91a4858d2ab3461a832857115faa3dc19fd301b887c67984514497d7"} {"question" "e-2479" "field" nil "attribute" "question/worked-solution" "value" "By the chain rule, we have \n\n$$\n(\\mathbf f \\circ u)'(t) = \\mathbf{f}'(u(t)) u'(t).\n$$\n\nNow, let's find the derivative of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\,i+\\frac{\\text{d}}{\\text{d}u}({u}^{2}+5)\\,j+\\frac{\\text{d}}{\\text{d}u}(4u)k \\\\  & =\\frac{1}{u}\\,i+2u\\,j+4\\,k, \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})=6{t}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =(\\frac{1}{u(t)}\\,i+2u(t)\\,j+4\\,k){u}^{′}(t) \\\\  & =(\\frac{1}{2{t}^{3}}\\,i+2(2{t}^{3})\\,j+4\\,k)\\cdot 6{t}^{2} \\\\  & =\\frac{3}{t}\\,i+24{t}^{5}\\,j+24{t}^{2}\\,k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2479.json" "file_sha256" "28113e7a91a4858d2ab3461a832857115faa3dc19fd301b887c67984514497d7"} {"question" "e-2480" "field" nil "attribute" "question/problem" "value" "Find $\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\cdot \\mathbf g)(t),$ given the following functions $\\mathbf f(t)$ and $\\mathbf g(t)\\mathbin{:}$\n\n$$\n\\begin{aligned}f(t) & =\\sqrt{t}\\,i+{t}^{2}j \\\\ g(t) & =\\frac{1}{t}i+{e}^{t}j\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2480.json" "file_sha256" "d8de8779c3fe7edcf26858e8ab54c8123e41f02ec47535501cb0ba6221b2cc97"} {"question" "e-2480" "field" nil "attribute" "question/worked-solution" "value" "Using the dot product rule, we have\n\n$$\n\\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f} \\cdot \\mathbf{g})(t) = \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f}(t)) \\cdot \\mathbf{g}(t) + \\mathbf{f}(t) \\cdot \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{g}(t))\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}f(t) & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =\\frac{1}{2\\sqrt{t}}\\,i+2t\\,j, \\\\ \\frac{\\text{d}}{\\text{d}t}g(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})j \\\\  & =-\\frac{1}{{t}^{2}}\\,i+{e}^{t}\\,j.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\eqalign{\n\\dfrac{\\textrm d}{\\textrm dt} (\\mathbf f \\cdot \\mathbf g)(t)\n&= \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{f}(t)) \\cdot \\mathbf{g}(t) + \\mathbf{f}(t) \\cdot \\dfrac{\\textrm d}{\\textrm dt}(\\mathbf{g}(t)) \\[3pt]\n&= \\left(\\dfrac{1}{2\\sqrt{t}} \\,\\mathbf i +2t \\, \\mathbf j \\right) \\cdot \\left(\\dfrac{1}{t} \\,  \\mathbf i + e^t \\,  \\mathbf j \\right) +\n\\left(\\sqrt{t} \\,  \\mathbf i + t^2 \\,  \\mathbf j \\right) \\cdot \\left(-\\dfrac{1}{t^2}  \\, \\mathbf i + e^t \\, \\mathbf j  \\right) \\[3pt]\t\t \n&=\\dfrac{1}{2t\\sqrt{t}}  +2te^t    +  \\left(-\\dfrac{\\sqrt{t}}{t^2}\\right)    + t^2e^t \\[3pt]\n&=\\dfrac{\\sqrt{t}}{2t^2}  -  \\dfrac{\\sqrt{t}}{t^2} +2te^t   + t^2e^t  \\[3pt]\n&= -\\dfrac{\\sqrt{t}}{2t^2} +\\left(2t+t^2\\right)e^t.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14077032/example-2480.json" "file_sha256" "d8de8779c3fe7edcf26858e8ab54c8123e41f02ec47535501cb0ba6221b2cc97"}] "usage" {"q-33446" [] "q-33122" [] "q-127998" [] "q-71230" [] "e-2478" [] "q-70681" [] "e-2480" [] "e-2477" [] "q-32860" [] "q-128572" [] "e-2479" [] "q-32298" [] "q-33260" [] "q-70695" [] "q-128481" [] "q-32353" []} "basis" 2795 "retractions" [[17592186115679 :question/problem "Find $(\\mathbf f\\times\\mathbf g)'(t)$, where $$\\mathbf f(t)=\\begin{bmatrix}3t^2\\\\t+4\\\\8\\end{bmatrix},\\qquad\\mathbf g(t)=\\begin{bmatrix}t+2\\\\-2t^2\\\\5t\\end{bmatrix}.$$"] [17592186115679 :question/worked-solution "Keeping the factors in order, $$\\mathbf f\\times\\mathbf g=\\begin{bmatrix}5t(t+4)+16t^2\\\\8(t+2)-15t^3\\\\-6t^4-(t+4)(t+2)\\end{bmatrix}=\\begin{bmatrix}21t^2+20t\\\\8t+16-15t^3\\\\-6t^4-t^2-6t-8\\end{bmatrix}.$$ Differentiate each component to obtain $$(\\mathbf f\\times\\mathbf g)'(t)=\\begin{bmatrix}42t+20\\\\8-45t^2\\\\-24t^3-2t-6\\end{bmatrix}.$$"] [17592186114885 :question/problem "Find $\\big( u(t) \\mathbf g(t) \\big)'$ where ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048749/assets/9e23d542bfc56d506f5437a35a92c304d618109ef60086e1f5a7a4fee57d8a80.png) and $u(t) = t.$"]] "immutable_answers" [17592186113463 17592186113464 17592186113465 17592186113466 17592186113467 17592186113475 17592186113476 17592186113477 17592186113478 17592186113479 17