#{[{:db/id #edb/ref 17592186368402 :knowledge-point/_questions [{:knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282" :knowledge-point/title "Using the Chain Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eaf27fa-d187-56ba-bd53-e57a7edb968d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186368404} {:answer/id #uuid "9caa6041-8821-500b-be2d-2ab527a1f8d9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 3{e}^{t} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186368405} {:answer/id #uuid "39681e33-dd2b-582d-a931-73990782c709" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186368406} {:answer/id #uuid "d27f21ab-0598-5d91-87e4-8efb0e3690a2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}t \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186368407} {:answer/id #uuid "606f4088-3971-5397-a02e-038f42cba5da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186368408}] :answer-field/correct {:answer/id #uuid "8eaf27fa-d187-56ba-bd53-e57a7edb968d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186368404} :answer-field/id #uuid "ab299f45-da79-5086-9c55-f784f600f8a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368403}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4198ce1e-0ba3-5a53-b852-015688085880" :question/math-academy-id "q-128572" :question/problem "If $f(u)=[\\begin{aligned}u \\\\ {u}^{2} \\\\ 6\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}u}(6)\\end{aligned}]=[\\begin{aligned}1 \\\\ 2u \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =[\\begin{aligned}1 \\\\ 2u(t) \\\\ 0\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}1 \\\\ 2({e}^{t}) \\\\ 0\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}{e}^{t} \\\\ 2{e}^{2t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115677 :knowledge-point/_questions [{:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" :knowledge-point/title "Using the Product Rules for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b029f1f-9e4a-597b-ae77-3d81c480f110" :answer/type {:db/ident :answer.type/math} :answer/value "60t^{3} + 15t^{2} + 14t + 2" :db/id #edb/ref 17592186113463} {:answer/id #uuid "cc3d915b-79a3-5034-a5de-c06db5adfc1e" :answer/type {:db/ident :answer.type/math} :answer/value "80t^{3} + 6t^{2} + 10t + 2" :db/id #edb/ref 17592186113464} {:answer/id #uuid "24835394-1f04-511b-a157-cfeb639fa83e" :answer/type {:db/ident :answer.type/math} :answer/value "80t^{3} + 11t^{2} + 12t + 2" :db/id #edb/ref 17592186113465} {:answer/id #uuid "63aa8e90-8b39-5545-99b0-87f760920652" :answer/type {:db/ident :answer.type/math} :answer/value "60t^{3} + 7t^{2} + 10t + 2" :db/id #edb/ref 17592186113466} {:answer/id #uuid "7641f374-6267-5333-85c6-aaff569336a7" :answer/type {:db/ident :answer.type/math} :answer/value "80t^{3} + 15t^{2} + 10t + 2" :db/id #edb/ref 17592186113467}] :answer-field/correct {:answer/id #uuid "7641f374-6267-5333-85c6-aaff569336a7" :answer/type {:db/ident :answer.type/math} :answer/value "80t^{3} + 15t^{2} + 10t + 2" :db/id #edb/ref 17592186113467} :answer-field/id #uuid "4f83259c-d6e0-5a5d-835f-1cdded5c1c51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113462}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a209f44d-4003-53ab-9d12-642d62514eb3" :question/math-academy-id "q-32298" :question/problem "Find $(f\\cdot g)^{′}(t)$, given that \n\n$$\n\\begin{aligned}f(t) & =20t\\,i-2t\\,j+(2+5t)\\,k \\\\ g(t) & ={t}^{3}\\,i+t\\,j+({t}^{2}+t)\\,k\\end{aligned}\n$$" :question/requires-calculator false :question/worked-solution "Using the dot product rule, we can write:\n\n$$\n(f\\cdot g)^{′}(t)={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(20t)\\,i-\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2+5t)\\,k \\\\  & =20\\,i-2\\,j+5\\,k \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}+t)\\,k \\\\  & =3{t}^{2}\\,i+j+(2t+1)\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f\\cdot g)^{′}(t) & ={f}^{′}(t)\\cdot g(t)+f(t)\\cdot {g}^{′}(t) \\\\  & =(20\\,i-2\\,j+5\\,k)\\cdot ({t}^{3}\\,i+t\\,j+({t}^{2}+t)\\,k)+(20t\\,i-2t\\,j+(2+5t)\\,k)\\cdot (3{t}^{2}\\,i+j+(2t+1)\\,k) \\\\  & =(20{t}^{3}-2t+5({t}^{2}+t))+(60{t}^{3}-2t+(2+5t)(2t+1)) \\\\  & =80{t}^{3}+15{t}^{2}+10t+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186305699 :knowledge-point/_questions [{:knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282" :knowledge-point/title "Using the Chain Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6ef7c57-c032-526f-aa67-9b807706273d" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{2{t}^{2}+1}\\,i-8{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186305701} {:answer/id #uuid "cb6f1b81-3a1c-50da-a2e3-89884eb7b89c" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{t+1}\\,i+2t{e}^{2t}\\,j" :db/id #edb/ref 17592186305702} {:answer/id #uuid "4df4329c-21d2-51a8-b053-05bb883f4820" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186305703} {:answer/id #uuid "4b6c3d1f-8052-5990-80a0-a5b0872c3f23" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{t+1}\\,i+6t{e}^{2t}\\,j" :db/id #edb/ref 17592186305704} {:answer/id #uuid "76ca5026-3449-5cf6-9238-64cc4803d070" :answer/type {:db/ident :answer.type/math} :answer/value "t{e}^{2t+1}\\,i+2t{e}^{4t}\\,j" :db/id #edb/ref 17592186305705}] :answer-field/correct {:answer/id #uuid "4df4329c-21d2-51a8-b053-05bb883f4820" :answer/type {:db/ident :answer.type/math} :answer/value "4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j" :db/id #edb/ref 17592186305703} :answer-field/id #uuid "df0dcda6-9c3c-5e46-bfc9-36ecd5a93d63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305700}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9342327c-ff4e-553a-a4f4-0263c91cce83" :question/math-academy-id "q-33260" :question/problem "If $f(u)={e}^{u+1}\\,i+{e}^{2u}\\,j+\\frac{1}{e}\\,k$ and $u(t)=2{t}^{2}$ then $(f∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have\n\n$$\n(f∘u)^{′}(t)=f′(u(t))u′(t)\n$$\n\nLet's now find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}({e}^{u+1})\\,i+\\frac{\\text{d}}{\\text{d}u}({e}^{2u})\\,j+\\frac{\\text{d}}{\\text{d}u}\\frac{1}{e}\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2u}\\,j+0\\,k \\\\  & ={e}^{u+1}\\,i+2{e}^{2t}\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})=4t\\end{aligned}\n$$\n\n \nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\ (f∘u)^{′}(t) & =({e}^{2{t}^{2}+1}\\,i+2{e}^{4{t}^{2}}\\,j)4t \\\\  & =4t{e}^{2{t}^{2}+1}\\,i+8t{e}^{4{t}^{2}}\\,j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186305734 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc" :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6aeeda8b-f3e7-50f2-a525-f9cb1e45a466" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{t}^{3}{e}^{t} \\\\ -16t \\\\ -{t}^{3}{e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186305736} {:answer/id #uuid "c09beb1e-6b5c-56d7-b309-e875013fcead" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186305737} {:answer/id #uuid "832905e6-89d2-51f6-bbcf-7292d3c655a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}({t}^{2}+{t}^{3}){e}^{t} \\\\ 4t \\\\ {t}^{3}{e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186305738} {:answer/id #uuid "f83193ff-79e3-5957-8133-1271d5f93bc7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(1-{t}^{2}){e}^{t} \\\\ 8t \\\\ (t+{t}^{2}){e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186305739} {:answer/id #uuid "b5cf90ca-8fb4-531d-84f4-9a72ecd5ecd0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3t{e}^{t} \\\\ -8t \\\\ -3t{e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186305740}] :answer-field/correct {:answer/id #uuid "c09beb1e-6b5c-56d7-b309-e875013fcead" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186305737} :answer-field/id #uuid "e1767873-42c2-57e8-b756-71d928f53399" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305735}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d3825fa-4a39-5efb-9247-5f4f19ce4d38" :question/math-academy-id "q-71230" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}{e}^{t} \\\\ 8 \\\\ {e}^{-t}\\end{aligned}]$ and $u(t)={t}^{2}.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(8) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{-t})\\end{aligned}]=[\\begin{aligned}{e}^{t} \\\\ 0 \\\\ -{e}^{-t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =2t[\\begin{aligned}{e}^{t} \\\\ 8 \\\\ {e}^{-t}\\end{aligned}]+{t}^{2}[\\begin{aligned}{e}^{t} \\\\ 0 \\\\ -{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}2t{e}^{t} \\\\ 16t \\\\ 2t{e}^{-t}\\end{aligned}]+[\\begin{aligned}{t}^{2}{e}^{t} \\\\ 0 \\\\ -{t}^{2}{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]\\end{aligned}\n$$"}]}
