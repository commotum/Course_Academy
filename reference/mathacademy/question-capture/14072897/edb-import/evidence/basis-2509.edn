-4\\text{i} & 5-5\\text{i}\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}-3\\text{i} \\\\ 4-5\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" :question/worked-solution "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}-3+5\\text{i} & 4-3\\text{i} \\\\ -4\\text{i} & 5-5\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}-3\\text{i} \\\\ 4-5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(-3+5\\text{i})(-3\\text{i})+(4-3\\text{i})(4-5\\text{i}) \\\\ (-4\\text{i})(-3\\text{i})+(5-5\\text{i})(4-5\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(15+9\\text{i})+(1-32\\text{i}) \\\\ (-12)+(-5-45\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}16-23\\text{i} \\\\ -17-45\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186368297 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "973e9ea9-e50c-5c34-a375-c9e1289a6bca" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 \\\\ 0 & 2-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186368299} {:answer/id #uuid "0ffb1167-43a6-5c28-8c27-01c63a09de6b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 3\\text{i}-3\\end{aligned}]" :db/id #edb/ref 17592186368300} {:answer/id #uuid "86357dae-ec5f-50c5-b30d-9ce93f504835" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 2-\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186368301} {:answer/id #uuid "3df4d77c-91d8-5371-b762-454aae97e371" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 \\\\ 0 & 6-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186368302} {:answer/id #uuid "3fa79e1f-c9bb-509b-9856-c244502096f9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 \\\\ 0 & 3\\text{i}-3\\end{aligned}]" :db/id #edb/ref 17592186368303}] :answer-field/correct {:answer/id #uuid "3df4d77c-91d8-5371-b762-454aae97e371" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 \\\\ 0 & 6-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186368302} :answer-field/id #uuid "c8046574-c7f6-52c6-b4a5-5f2588341e50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368298}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d85a9a95-fca5-5b64-9704-b7ff3435b87c" :question/math-academy-id "q-140381" :question/problem "Given the matrix $A=[\\begin{aligned}1+2\\text{i} & -2-4\\text{i} \\\\ 3-2\\text{i} & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following  elementary row operations:\n\n$$\n{R}_{1}=\\frac{1}{1+2\\text{i}}{R}_{1},\\,{R}_{2}={R}_{2}+(2\\text{i}-3){R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & -2-4\\text{i} \\\\ 3-2\\text{i} & \\text{i}\\end{aligned}] & {R}_{1} & :=\\frac{1}{1+2\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 \\\\ 3-2\\text{i} & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+(2\\text{i}-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 \\\\ 0 & 6-3\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result is\n\n$$\n[\\begin{aligned}1 & -2 \\\\ 0 & 6-3\\text{i}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186368311 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249b4a76-6452-50b5-a25c-3a0834cee96c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186368313} {:answer/id #uuid "d524159b-162e-5249-bfbe-4249a0a08b3f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186368314} {:answer/id #uuid "b955bfa1-2c81-52b9-abd4-508413145ded" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186368315} {:answer/id #uuid "b5717d64-1053-5b53-a944-47d37ebaf179" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186368316} {:answer/id #uuid "38026b88-9beb-51ae-9320-f14535f4498c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368317}] :answer-field/correct {:answer/id #uuid "38026b88-9beb-51ae-9320-f14535f4498c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368317} :answer-field/id #uuid "1f1c2b34-44c1-5279-8fb5-9f6989af37e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368312}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7f16b2b-757e-50d7-9ab0-664804d80ea6" :question/math-academy-id "q-76201" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}]\\,$ then what is the value of $cd+gh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 0+5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -1 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $c=1,d=0,g=1$ and $h=5.$ Therefore,\n\n$$\ncd+gh=1\\cdot 0+1\\cdot 5=5.\n$$"}]}
