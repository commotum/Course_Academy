atrix}" :db/id #edb/ref 17592186127681}] :answer-field/correct {:answer/id #uuid "ad2c84f0-ea43-59b5-9f39-f9b287c237b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186127679} :answer-field/id #uuid "04cbad56-afe9-56dd-b327-d0b3664c9323" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127676}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "82b32e6d-28e5-58d1-919e-cc85298dd3c7" :question/math-academy-id "q-39014" :question/problem "Given the matrix $A=[\\begin{aligned}2\\text{i}-1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}]$, find the result of applying to $A$ the following  elementary row operations:\n\n$$\n{R}_{1}=\\frac{1}{2\\text{i}-1}{R}_{1},\\,{R}_{2}={R}_{2}-2\\text{i}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2\\text{i}-1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2\\text{i}-1}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-2\\text{i}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result is\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186324398 :knowledge-point/_questions [{:knowledge-point/id #uuid "c7c1b7ad-e4bf-55b2-8665-2cf35e402946" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5ab1397-1508-5917-9175-f478087ddc1b" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186324400} {:answer/id #uuid "f5633dd5-5eea-5a0a-8958-75fb99f9eb48" :answer/type {:db/ident :answer.type/math} :answer/value "1+8\\text{i}" :db/id #edb/ref 17592186324401} {:answer/id #uuid "bd7bca6c-6e01-53eb-a364-07