stion/answer-fields [{:answer-field/choices [{:answer/id #uuid "249b4a76-6452-50b5-a25c-3a0834cee96c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186368313} {:answer/id #uuid "d524159b-162e-5249-bfbe-4249a0a08b3f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186368314} {:answer/id #uuid "b955bfa1-2c81-52b9-abd4-508413145ded" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186368315} {:answer/id #uuid "b5717d64-1053-5b53-a944-47d37ebaf179" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186368316} {:answer/id #uuid "38026b88-9beb-51ae-9320-f14535f4498c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368317}] :answer-field/correct {:answer/id #uuid "38026b88-9beb-51ae-9320-f14535f4498c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368317} :answer-field/id #uuid "1f1c2b34-44c1-5279-8fb5-9f6989af37e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368312}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7f16b2b-757e-50d7-9ab0-664804d80ea6" :question/math-academy-id "q-76201" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}]\\,$ then what is the value of $cd+gh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 0+5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -1 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $c=1,d=0,g=1$ and $h=5.$ Therefore,\n\n$$\ncd+gh=1\\cdot 0+1\\cdot 5=5.\n$$"}] [{:db/id #edb/ref 17592186324412 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f9c59ca-2a18-5b16-96e9-8efec5745ba1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324414} {:answer/id #uuid "7cb196bb-7dc6-554e-9e65-cc90a276eab2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324415} {:answer/id #uuid "4c291387-b63d-50cd-b8eb-edc5fa774e84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324416} {:answer/id #uuid "b7635561-dac0-5029-a31d-38a4af5a0e6f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324417} {:answer/id #uuid "a09c222d-a05d-5683-b929-deea4abf6c53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324418}] :answer-field/correct {:answer/id #uuid "4c291387-b63d-50cd-b8eb-edc5fa774e84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324416} :answer-field/id #uuid "2cfc46d9-0938-5c5f-b702-2595aa055b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324413}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58793c96-ddf8-519d-986f-39d6955284e1" :question/math-academy-id "q-76204" :question/problem "Find the real part of the matrix $A=[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ 0-\\text{i} & 4+0\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}2 & -6 \\\\ -1 & 0\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186324440 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5445583-7cae-5d34-a67f-70614754b2b9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4+6\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324442} {:answer/id #uuid "29cb5c79-d63b-59bb-b68b-45ad61d4c9e0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+13\\text{i} & 7+5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324443} {:answer/id #uuid "b5d2e190-17b2-51b3-8319-9ba4fed94cd9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4+6\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324444} {:answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324445} {:answer/id #uuid "bdf260e0-032f-5d9c-9b90-01c4a971c948" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324446}] :answer-field/correct {:answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324445} :answer-field/id #uuid "08dc7d36-4aab-51b3-b8c0-45d260b89c34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324441}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e93d1f28-d0c0-5126-b248-ca6895657c64" :question/math-academy-id "q-76223" :question/problem "If $\\,A=[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-3\\text{i})(3-\\text{i})+(-1+2\\text{i})(-1+\\text{i}) & (1-3\\text{i})(3+\\text{i})+(-1+2\\text{i})(1-\\text{i}) \\\\ (2+2\\text{i})(3-\\text{i})+(1-\\text{i})(-1+\\text{i}) & (2+2\\text{i})(3+\\text{i})+(1-\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-10\\text{i}+(-1-3\\text{i}) & (6-8\\text{i})+(1+3\\text{i}) \\\\ (8+4\\text{i})+2\\text{i} & (4+8\\text{i})+(-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324447 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88467948-7c2f-5183-a55b-6a11764ec90c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324449} {:answer/id #uuid "3221ed64-5409-52bc-9591-d74209d70c98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324450} {:answer/id #uuid "c931d64d-6af8-544b-8df9-3b976ea8c2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324451} {:answer/id #uuid "70ac948a-9451-501c-af4c-8e9122449559" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324452} {:answer/id #uuid "a007df91-53d7-5825-be0f-7622672a4954" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324453}] :answer-field/correct {:answer/id #uuid "3221ed64-5409-52bc-9591-d74209d70c98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324450} :answer-field/id #uuid "77ab877a-ecbd-5dc3-828b-75998939f215" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324448}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d863dac0-16be-50b8-a3a9-ff28a7c7d6d0" :question/math-academy-id "q-76252" :question/problem "Given the matrix $A=[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ -3+\\frac{3}{1+\\text{i}}\\cdot (1+\\text{i}) & \\text{i}\\end{aligned}] \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186324454 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31aa0cff-1ddd-5ced-9f90-646f5db2454b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324456} {:answer/id #uuid "8d4331b5-4e68-59f1-9000-d9e0988f964a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 1 & 10-2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324457} {:answer/id #uuid "cbd1088d-529f-5544-a6de-61ad24e0b157" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186324458} {:answer/id #uuid "918629ca-edf5-51ba-bfda-fad453d89be7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324459} {:answer/id #uuid "492edb81-3eaa-5ed6-b7ea-2379504dcb2b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\text{i} & \\text{i} \\\\ 1 & 8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324460}] :answer-field/correct {:answer/id #uuid "918629ca-edf5-51ba-bfda-fad453d89be7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324459} :answer-field/id #uuid "9765b53a-c71b-5934-b951-a33b74246774" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324455}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "92e367a3-8aab-5062-bdae-482777fab633" :question/math-academy-id "q-76254" :question/problem "Given the matrix $A=[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{7}{\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{7}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7+(-\\text{i})\\cdot \\frac{7}{\\text{i}} & \\text{(}3-2\\text{i})+i\\cdot \\frac{7}{\\text{i}}\\end{aligned}] \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}].\n$$"}]}
