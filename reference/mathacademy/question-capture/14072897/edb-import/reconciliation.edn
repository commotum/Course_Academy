xt{i} \\\\ 1+\\text{i} & 0+5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -1 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $c=1,d=0,g=1$ and $h=5.$ Therefore,\n\n$$\ncd+gh=1\\cdot 0+1\\cdot 5=5.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76201" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/activity-metadata.json" "file_sha256" "ee2e4aa80a8e4569657e0274d7fc95c1b443428f57c803da7a2e4b5c70568e11"} {"question" "q-76201" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76201" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "10"] ["math" "15"] ["math" "5"] ["math" "6"] ["math" "7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76201" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76204" "field" nil "attribute" "question/problem" "value" "Find the real part of the matrix $A=[\\begin{a