 \\\\ 0 & \\text{i}\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76252" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76252" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76252" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76252" "field" "selection" "attribute" "