y/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76223" "field" nil "attribute" "question/problem" "value" "If $\\,A=[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76223" "field" nil "attribute" "question/worked-solution" "value" "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-3\\text{i})(3-\\text{i})+(-1+2\\text{i})(-1+\\text{i}) & (1-3\\text{i})(3+\\text{i})+(-1+2\\text{i})(1-\\text{i}) \\\\ (2+2\\text{i})(3-\\text{i})+(1-\\text{i})(-1+\\text{i}) & (2+2\\text{i})(3+\\text{i})+(1-\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-10\\text{i}+(-1-3\\text{i}) & (6-8\\text{i})+(1+3\\text{i}) \\\\ (8+4\\text{i})+2\\text{i} & (4+8\\text{i})+(-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76223" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76223" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76223" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-1+13\\text{i} & 7+5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76223" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-1-13\\text{i} & 7-5\\t