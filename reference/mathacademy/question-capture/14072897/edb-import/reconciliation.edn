{i}\\end{aligned}]"] ["math" "[\\begin{aligned}2 & 0 \\\\ 0 & \\text{i}\\end{aligned}]"] ["math" "[\\begin{aligned}\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76252" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-39014" "field" nil "attribute" "question/problem" "value" "Given the matrix $A=[\\begin{aligned}2\\text{i}-1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}]$, find the result of applying to $A$ the following  elementary row operations:\n\n$$\n{R}_{1}=\\frac{1}{2\\text{i}-1}{R}_{1},\\,{R}_{2}={R}_{2}-2\\text{i}{R}_{1}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-39014" "field" nil "attribute" "question/worked-solution" "value" "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2\\text{i}-1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2\\text{i}-1}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-2\\text{i}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result is\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-39014" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/activity-metadata.json" "file_sha256" "ee2e4aa80a8e4569657e0274d7fc95c1b443428f57c803da7a2e4b5c70568e11"} {"question" "q-39014" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-39014" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]"] ["math" "[\\begin{aligned}0 & 2\\text{i} \\\\ 2\\text{i} & 0\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]"] ["math" "[\\begin{aligned}1 & 0 \\\\ 0 & 2\\text{i}\\end{aligned}]"] ["math" "[\\begin{aligned}2\\text{i} & 0 \\\\ 0 & 2\\text{i}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-39014" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "e-5903" "field" nil "attribute" "question/problem" "value" "Find $B=\\overline{A},$ where ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/25ce0cd375da320d1615cf49f659ec33e4646cf6bc66455198bec5fd591b3dd3.png) What is the value of $b_{11} + b_{23}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5903.json" "file_sha256" "a17e3d0d4031d34b345c6242f60074615e13839ffc5f4c009c928e7101c1d676"} {"question" "e-5903" "field" nil "attribute" "question/worked-solution" "value" "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}4\\text{i} & 3-\\text{i} & 1+\\text{i} \\\\ 2-2\\text{i} & 2-\\text{i} & 1+2\\text{i} \\\\ \\text{i} & 3\\text{i} & 2\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{4\\text{i}} & \\overset{―}{3-\\text{i}} & \\overset{―}{1+\\text{i}} \\\\ \\overset{―}{2-2\\text{i}} & \\overset{―}{2-\\text{i}} & \\overset{―}{1+2\\text{i}} \\\\ \\overset{―}{\\text{i}} & \\overset{―}{3\\text{i}} & \\overset{―}{2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}-4\\text{i} & 3+\\text{i} & 1-\\text{i} \\\\ 2+2\\text{i} & 2+\\text{i} & 1-2\\text{i} \\\\ -\\text{i} & -3\\text{i} & -2\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, $b_{11} + b_{23} = (-4\\textrm{i}) + (1-2\\textrm{i}) = 1-6\\textrm{i}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5903.json" "file_sha256" "a17e3d0d4031d34b345c6242f60074615e13839ffc5f4c009c928e7101c1d676"} {"question" "e-5525" "field" nil "attribute" "question/problem" "value" "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/9e1718bbf8790a9cc89d7cc1c6dd7879f8e222f348e5a9a56fec83a1b033250d.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/e99949f7e98aee85a040f698b15822927d7aabea1e688337d209c8e1d08850d6.png) are the real and imaginary parts of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/642f01152b6a1717300120241f788a24098413648cd70e8d0399629f11be2254.png) then what is the value of $ad+eh?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5525.json" "file_sha256" "0d66df1c0117f7a257ca24aaa9a9b83e233de69541847f508aac2294076af846"} {"question" "e-5525" "field" nil "attribute" "question/worked-solution" "value" "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & -5-7\\text{i} \\\\ 1-6\\text{i} & 5-9\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -5 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -7 \\\\ -6 & -9\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=2,d=5,e=-3$ and $h=-9.$ Therefore,\n\n$$\nad+eh=2 \\cdot 5 + (-3) \\cdot (-9) = 37.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5525.json" "file_sha256" "0d66df1c0117f7a257ca24aaa9a9b83e233de69541847f508aac2294076af846"} {"question" "e-5902" "field" nil "attribute" "question/problem" "value" "If ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/6ca7286f266b56c385ccff4b26d47e2b74b0ba0082d6bfd942b19ae23093eec5.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/07f35c3f6c37af90636567c6f3851ec775c86be6482775d494178418167a31fb.png), then what is $AB?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5902.json" "file_sha256" "9eecb0674c92ee0fe5d0b15c28370a006a95557bc0a34f8081f71fb2f5870b04"} {"question" "e-5902" "field" nil "attribute" "question/worked-solution" "value" "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 1 & 2\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}1+2\\text{i} & 1-\\text{i} \\\\ \\text{i} & 2\\end{aligned}] \\\\  & =[\\begin{aligned}(-\\text{i})\\cdot (1+2\\text{i})+\\text{i}\\cdot \\text{i} & (-\\text{i})\\cdot (1-\\text{i})+\\text{i}\\cdot 2 \\\\ 1\\cdot (1+2\\text{i})+2\\text{i}\\cdot \\text{i} & 1\\cdot (1-\\text{i})+2\\text{i}\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}(2-\\text{i})+(-1) & (-1-\\text{i})+2\\text{i} \\\\ (1+2\\text{i})+(-2) & (1-\\text{i})+4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}1-\\text{i} & -1+\\text{i} \\\\ -1+2\\text{i} & 1+3\\text{i}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5902.json" "file_sha256" "9eecb0674c92ee0fe5d0b15c28370a006a95557bc0a34f8081f71fb2f5870b04"} {"question" "e-5526" "field" nil "attribute" "question/problem" "value" "Given the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/14a711915f94a68eb7db2995698e8f15d8a7554702d9441c826f983bdb81df23.png) find the result of applying to $A$ the following elementary row operations:\n\n$$\nR_1 := \\dfrac{1}{\\textrm{i}}R_1, \\qquad R_2 := R_2 - 2\\textrm{i}R_1\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/example-5526.json" "file_sha256" "718cb4283bc5304a1f9e37cfd92761a13c55e993afae6830daf427a5e697a9f5"} {"question" "e-5526" "field" nil "attribute" "question/worked-solution" "value" "Let's apply the row operations to $A\\mathbin{:}$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}\\text{i} & -\\text{i} \\\\ 2+2\\text{i} & 1\\end{aligned}]\\, &  & {R}_{1}:=\\frac{1}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 \\\\ 2+2\\text{i} & 1\\end{aligned}]\\, &  & {R}_{2}:={R}_{2}-2\\text{i}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 \\\\ 2 & 1+2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/assets/c25d3059b60a979ccbb37519a8626aec0