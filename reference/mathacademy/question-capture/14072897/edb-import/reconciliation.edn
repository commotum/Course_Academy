\ \\overset{―}{-5+7\\text{i}} & \\overset{―}{8-3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}5-4\\text{i} & 6\\text{i} \\\\ -5-7\\text{i} & 8+3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{21}-{b}_{22}=(-5-7\\text{i})-(8+3\\text{i})=-13-10\\text{i}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76061" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/activity-metadata.json" "file_sha256" "ee2e4aa80a8e4569657e0274d7fc95c1b443428f57c803da7a2e4b5c70568e11"} {"question" "q-76061" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76061" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-13-10\\text{i}"] ["math" "-13-4\\text{i}"] ["math" "-3+10\\text{i}"] ["math" "-3+4\\text{i}"] ["math" "-3-4\\text{i}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76061" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-13-10\\text{i}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76057" "field" nil "attribute" "question/problem" "value" "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}9-7\\text{i} & -2\\text{i} & 6-\\text{i} \\\\ -7 & 5-\\text{i} & \\text{i} \\\\ 6 & -\\text{i} & 0\\end{aligned}].$ What is the value of ${b}_{21}+{b}_{32}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76057" "field" nil "attribute" "question/worked-solution" "value" "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}9-7\\text{i} & -2\\text{i} & 6-\\text{i} \\\\ -7 & 5-\\text{i} & \\text{i} \\\\ 6 & -\\text{i} & 0\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{9-7\\text{i}} & \\overset{―}{-2\\text{i}} & \\overset{―}{6-\\text{i}} \\\\ \\overset{―}{-7} & \\overset{―}{5-\\text{i}} & \\overset{―}{\\text{i}} \\\\ \\overset{―}{6} & \\overset{―}{-\\text{i}} & \\overset{―}{0}\\end{aligned}] \\\\  & =[\\begin{aligned}9+7\\text{i} & 2\\text{i} & 6+\\text{i} \\\\ -7 & 5+\\text{i} & -\\text{i} \\\\ 6 & \\text{i} & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{21}+{b}_{32}=-7+\\text{i}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519ffe28b83cae16c0c77629ba70f812e1b52c6458"} {"question" "q-76057" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/activity-metadata.json" "file_sha256" "ee2e4aa80a8e4569657e0274d7fc95c1b443428f57c803da7a2e4b5c70568e11"} {"question" "q-76057" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072897/state.json" "file_sha256" "488a5fcd32697263736065519