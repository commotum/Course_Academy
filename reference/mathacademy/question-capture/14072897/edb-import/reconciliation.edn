e/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76252" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-39014" "field" nil "attribute" "question/problem" "value" "Given the matrix $A=[\\begin{aligned}2\\text{i}-1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}]$, find the result of applying to $A$ the following  elementary row operations:\n\n$$\n{R}_{1}=\\frac{1}{2\\text{i}-1}{R}_{1},\\,{R}_{2}={R}_{2}-2\\text{i}{R}_{1}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-39014" "field" nil "attribute" "question/worked-solution" "value" "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2\\text{i}-1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2\\text{i}-1}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2\\text{i} & 1\\end{aligned}] & {R}_{2} & :={R}_{2}-2\\text{i}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result is\n\n$$\n[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-39014" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-39014" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76254" "field" nil "attribute" "question/problem" "value" "Given the matrix $A=[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{7}{\\text{i}}{R}_{1}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76254" "field" nil "attribute" "question/worked-solution" "value" "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7 & 3-2\\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{7}{\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 7+(-\\text{i})\\cdot \\frac{7}{\\text{i}} & \\text{(}3-2\\text{i})+i\\cdot \\frac{7}{\\text{i}}\\end{aligned}] \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/activity-metadata.json" "file_sha256" "37ba5df55475007f46a653df2e9ada705233f87b3c21410d3cbcfaa3ff4acf79" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/edb-import/verification.json"} {"question" "q-76254" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14045065/state.json" "file_sha256" "f75fa7cdcdcaf8a30bc68e7d98624270f380046bf1008cc40fbe38213070be5d" "basis" 1667 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/1