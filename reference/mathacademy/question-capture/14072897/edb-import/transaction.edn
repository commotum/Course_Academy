i} \\\\ 3-3\\text{i} & 1-5\\text{i}\\end{aligned}].$ What is the value of ${b}_{11}+{b}_{22}?$" :question/worked-solution "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}2+4\\text{i} & 3-2\\text{i} \\\\ 3-3\\text{i} & 1-5\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{2+4\\text{i}} & \\overset{―}{3-2\\text{i}} \\\\ \\overset{―}{3-3\\text{i}} & \\overset{―}{1-5\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}2-4\\text{i} & 3+2\\text{i} \\\\ 3+3\\text{i} & 1+5\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{11}+{b}_{22}=(2-4\\text{i})+(1+5\\text{i})=3+\\text{i}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-140323/selection/825dc24d1682740d33bfb790387cd274bb8b82b60047aa26c8d55bf2ee2e1bd0" :answer/id #uuid "5162eb94-3214-578d-82eb-081ba430b4b4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & -4 \\\\ 6 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140323/selection/4ee25cf2b7f7bac343139352fc557755d5ad9015333b2d4a09313f13f64421b8" :answer/id #uuid "1bcff652-9d1e-5f50-b814-944c5fe7dce0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & -4 \\\\ 6 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140323/selection/fcd708189212172247376c5cf84db18b56888bb42b9f9dac828c265d7329e9bd" :answer/id #uuid "6cf1c6ae-40d6-51d9-9a22-dc70d035a4a8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 4 \\\\ 6 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140323/selection/3d745aba47c84b465512b36046f26279935f79cd8ee91535abda18bc6849f97b" :answer/id #uuid "34920dcb-6bec-5e45-9132-daff6b1b6826" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 & -4 \\\\ 6 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140323/selection/3e457ee4f685ca819ca2d494ec5bbf3de7c04221814ae5ba4005bc1ad1f09f76" :answer/id #uuid "b3825fb6-e9b7