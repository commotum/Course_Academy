c{7}{\\text{i}} & \\text{(}3-2\\text{i})+i\\cdot \\frac{7}{\\text{i}}\\end{aligned}] \\\\  & ∼[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 10-2\\text{i}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186378202 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dcd3f64-b113-5f52-ba78-3078b3b00d5d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186378204} {:answer/id #uuid "f969df6a-8fd3-5b80-b615-77facf5d0df4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186378205} {:answer/id #uuid "fa0839e8-fb29-5362-8338-881be7d1e9a7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} & 3\\text{i} \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186378206} {:answer/id #uuid "10ce392e-fc4f-540b-9ea4-94fe7dac3471" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378207} {:answer/id #uuid "e8d62e37-6cd2-5de4-953e-fbcf8c01ca14" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 1 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378208}] :answer-field/correct {:answer/id #uuid "f969df6a-8fd3-5b80-b615-77facf5d0df4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-\\text{i} & 2\\text{i}+1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186378205} :answer-field/id #uuid "a6fde116-4ff4-5ade-9411-0ff997ec380e" :answer-field/key "selection" :a