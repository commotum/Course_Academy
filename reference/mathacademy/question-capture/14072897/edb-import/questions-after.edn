verset{―}{6} & \\overset{―}{-\\text{i}} & \\overset{―}{0}\\end{aligned}] \\\\  & =[\\begin{aligned}9+7\\text{i} & 2\\text{i} & 6+\\text{i} \\\\ -7 & 5+\\text{i} & -\\text{i} \\\\ 6 & \\text{i} & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{21}+{b}_{32}=-7+\\text{i}.$"}] [{:db/id #edb/ref 17592186324398 :knowledge-point/_questions [{:knowledge-point/id #uuid "c7c1b7ad-e4bf-55b2-8665-2cf35e402946" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5ab1397-1508-5917-9175-f478087ddc1b" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186324400} {:answer/id #uuid "f5633dd5-5eea-5a0a-8958-75fb99f9eb48" :answer/type {:db/ident :answer.type/math} :answer/value "1+8\\text{i}" :db/id #edb/ref 17592186324401} {:answer/id #uuid "bd7bca6c-6e01-53eb-a364-0768e0c88416" :answer/type {:db/ident :answer.type/math} :answer/value "11+5\\text{i}" :db/id #edb/ref 17592186324402} {:answer/id #uuid "a7d9cf17-ec23-509d-afbd-61bc434e69e4" :answer/type {:db/ident :answer.type/math} :answer/value "14-58\\text{i}" :db/id #edb/ref 17592186324403} {:answer/id #uuid "00176072-22c6-5d0a-becf-fa4e144a9abd" :answer/type {:db/ident :answer.type/math} :answer/value "-1-8\\text{i}" :db/id #edb/ref 17592186324404}] :answer-field/correct {:answer/id #uuid "00176072-22c6-5d0a-becf-fa4e144a9abd" :answer/type {:db/ident :answer.type/math} :answer/value "-1-8\\text{i}" :db/id #edb/ref 17592186324404} :answer-field/id #uuid "a2019caf-3516-5dff-8648-f73726520627" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324399}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d5d20da-974d-5024-90da-ba1db4147536" :question/math-academy-id "q-76059" :question/problem "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}7-\\text{i} & 6+4\\text{i} \\\\ 7-4\\text{i} & 4+9\\text{i}\\end{aligned}].$ What is the value of ${b}_{12}-{b}_{21}?$" :question/worked-solution "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}7-\\text{i} & 6+4\\text{i} \\\\ 7-4\\text{i} & 4+9\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{7-\\text{i}} & \\overset{―}{6+4\\text{i}} \\\\ \\overset{―}{7-4\\text{i}} & \\overset{―}{4+9\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}7+\\text{i} & 6-4\\text{i} \\\\ 7+4\\text{i} & 4-9\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{12}-{b}_{21}=(6-4\\text{i})-(7+4\\text{i})=-1-8\\text{i}.$"}] [{:db/id #edb/ref 17592186378167 :knowledge-point/_questions [{:knowledge-point/id #uuid "c7c1b7ad-e4bf-55b2-8665-2cf35e402946" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e92b05f-603d-578f-a6b3-d502406e49cc" :answer/type {:db/ident :answer.type/math} :answer/value "-13-10\\text{i}" :db/id #edb/ref 17592186378169} {:answer/id #uuid "5ed54b99-e8c2-505d-874e-45df36b53d79" :answer/type {:db/ident :answer.type/math} :answer/value "-3+4\\text{i}" :db/id #edb/ref 17592186378170} {:answer/id #uuid "ed73ba4b-aa2c-5af9-b893-7841d3c9070a" :answer/type {:db/ident :answer.type/math} :answer/value "-13-4\\text{i}" :db/id #edb/ref 17592186378171} {:answer/id #uuid "39a1dd76-c995-52e6-8b3d-88d5f78f4f43" :answer/type {:db/ident :answer.type/math} :answer/value "-3+10\\text{i}" :db/id #edb/ref 17592186378172} {:answer/id #uuid "b2d0dd68-d260-546d-8fb0-66b893fc81a5" :answer/type {:db/ident :answer.type/math} :answer/value "-3-4\\text{i}" :db/id #edb/ref 17592186378173}] :answer-field/correct {:answer/id #uuid "7e92b05f-603d-578f-a6b3-d502406e49cc" :answer/type {:db/ident :answer.type/math} :answer/value "-13-10\\text{i}" :db/id #edb/ref 17592186378169} :answer-field/id #uuid "22349cc8-2e5b-58d4-8221-c4b61f29f1fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378168}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2d72baa0-0195-5cf5-b98a-c25680852fae" :question/math-academy-id "q-76061" :question/problem "Find $B=\\overset{―}{A}$, where $A=[\\begin{aligned}5+4\\text{i} & -6\\text{i} \\\\ -5+7\\text{i} & 8-3\\text{i}\\end{aligned}].$ What is the value of ${b}_{21}-{b}_{22}?$" :question/worked-solution "Taking the complex conjugate of each entry, we get\n\n$$\n\\begin{aligned}\\overset{―}{A} & =\\overset{―}{[\\begin{aligned}5+4\\text{i} & -6\\text{i} \\\\ -5+7\\text{i} & 8-3\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{5+4\\text{i}} & \\overset{―}{-6\\text{i}} \\\\ \\overset{―}{-5+7\\text{i}} & \\overset{―}{8-3\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}5-4\\text{i} & 6\\text{i} \\\\ -5-7\\text{i} & 8+3\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, ${b}_{21}-{b}_{22}=(-5-7\\text{i})-(8+3\\text{i})=-13-10\\text{i}.$"}] [{:db/id #edb/ref 17592186368311 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249b4a76-6452-50b5-a25c-3a0834cee96c" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186368313} {:answer/id #uuid "d524159b-162e-5249-bfbe-4249a0a08b3f" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186368314} {:answer/id #uuid "b955bfa1-2c81-52b9-abd4-508413145ded" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186368315} {:answer/id #uuid "b5717d64-1053-5b53-a944-47d37ebaf179" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186368316} {:answer/id #uuid "38026b88-9beb-51ae-9320-f14535f4498c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368317}] :answer-field/correct {:answer/id #uuid "38026b88-9beb-51ae-9320-f14535f4498c" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186368317} :answer-field/id #uuid "1f1c2b34-44c1-5279-8fb5-9f6989af37e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368312}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7f16b2b-757e-50d7-9ab0-664804d80ea6" :question/math-academy-id "q-76201" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}]\\,$ then what is the value of $cd+gh?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2-3\\text{i} & 1-\\text{i} \\\\ 1+\\text{i} & 0+5\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & -1 \\\\ 1 & 5\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $c=1,d=0,g=1$ and $h=5.$ Therefore,\n\n$$\ncd+gh=1\\cdot 0+1\\cdot 5=5.\n$$"}] [{:db/id #edb/ref 17592186378174 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d3a296e-6414-5358-bf26-1eda90c2e293" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186378176} {:answer/id #uuid "0c593994-a0c4-5089-ac74-7f99551bd56f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186378177} {:answer/id #uuid "01de86d9-b44a-5f71-9143-309e2ae5c073" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186378178} {:answer/id #uuid "a9946632-8534-574a-a0de-aba22e1d93ef" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186378179} {:answer/id #uuid "b52f1e52-2ede-5fd5-a4c9-4e55c82c336d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378180}] :answer-field/correct {:answer/id #uuid "0c593994-a0c4-5089-ac74-7f99551bd56f" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186378177} :answer-field/id #uuid "4f693702-9bf3-5e1d-b91a-f56113a940ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378175}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ee4cdcf1-48b1-5516-b93c-54143c6709f9" :question/math-academy-id "q-76203" :question/problem "If $\\,\\text{Re}(x)=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}]\\,$ and $\\,\\text{Im}(x)=[\\begin{aligned}e & f \\\\ g & h\\end{aligned}]\\,$ are the real and imaginary parts of the matrix $A=[\\begin{aligned}-3\\text{i} & 5\\text{i} \\\\ -4 & 5\\end{aligned}]\\,$ then what is the value of $ah-cf?$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-3\\text{i} & 5\\text{i} \\\\ -4 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}0-3\\text{i} & 0+5\\text{i} \\\\ -4+0\\text{i} & 5+0\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}0 & 0 \\\\ -4 & 5\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & 5 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nSo we have $a=0,c=-4,f=5$ and $h=0.$ Therefore,\n\n$$\nah-cf=0\\cdot 0-(-4)\\cdot 5=20.\n$$"}] [{:db/id #edb/ref 17592186324412 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f9c59ca-2a18-5b16-96e9-8efec5745ba1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324414} {:answer/id #uuid "7cb196bb-7dc6-554e-9e65-cc90a276eab2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324415} {:answer/id #uuid "4c291387-b63d-50cd-b8eb-edc5fa774e84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324416} {:answer/id #uuid "b7635561-dac0-5029-a31d-38a4af5a0e6f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324417} {:answer/id #uuid "a09c222d-a05d-5683-b929-deea4abf6c53" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186324418}] :answer-field/correct {:answer/id #uuid "4c291387-b63d-50cd-b8eb-edc5fa774e84" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186324416} :answer-field/id #uuid "2cfc46d9-0938-5c5f-b702-2595aa055b0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324413}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58793c96-ddf8-519d-986f-39d6955284e1" :question/math-academy-id "q-76204" :question/problem "Find the real part of the matrix $A=[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ 0-\\text{i} & 4+0\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}2 & -6 \\\\ -1 & 0\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186378181 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c674a44-21ed-5afd-9879-eec4da6e55f5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18+8\\text{i} \\\\ 6+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378183} {:answer/id #uuid "9fcb75cb-3a54-52b8-890b-d50b9e9feac7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6+8\\text{i} \\\\ 18+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378184} {:answer/id #uuid "6b69185f-67b9-5352-b107-8359ad6c9aad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18+6\\text{i} \\\\ 3+8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378185} {:answer/id #uuid "49e5184c-f0d5-569a-a4ff-7373f0d666af" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6+3\\text{i} \\\\ 18+8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378186} {:answer/id #uuid "450e0076-25d7-5d0b-bbdf-0318ce9df757" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18+3\\text{i} \\\\ 6+8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378187}] :answer-field/correct {:answer/id #uuid "450e0076-25d7-5d0b-bbdf-0318ce9df757" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18+3\\text{i} \\\\ 6+8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378187} :answer-field/id #uuid "7ef1770f-4e3e-583a-90dd-7b6d699dd957" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378182}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4126818a-25d9-570b-ae58-4b53b594488d" :question/math-academy-id "q-76211" :question/problem "If $\\,A=[\\begin{aligned}3+\\text{i} & -\\text{i} & 1-4\\text{i} \\\\ 1-\\text{i} & 1+\\text{i} & 2\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}1+\\text{i} \\\\ 1-\\text{i} \\\\ 1+4\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" :question/worked-solution "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}3+\\text{i} & -\\text{i} & 1-4\\text{i} \\\\ 1-\\text{i} & 1+\\text{i} & 2\\end{aligned}]\\cdot [\\begin{aligned}1+\\text{i} \\\\ 1-\\text{i} \\\\ 1+4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(3+\\text{i})(1+\\text{i})+(-\\text{i})(1-\\text{i})+(1-4\\text{i})(1+4\\text{i}) \\\\ (1-\\text{i})(1+\\text{i})+(1+\\text{i})(1-\\text{i})+2(1+4\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(2+4\\text{i})+(-\\text{i}-1)+17 \\\\ 2+2+(2+8\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}18+3\\text{i} \\\\ 6+8\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378188 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3519f4cc-7f5d-5081-824a-c5d6fe484ce5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5+9\\text{i} & 9-13\\text{i} \\\\ 10+5\\text{i} & 14-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378190} {:answer/id #uuid "90e07b7b-d05f-55ee-b2ec-363aa4234247" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10+5\\text{i} & 14-3\\text{i} \\\\ -5+9\\text{i} & 9-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378191} {:answer/id #uuid "3b381c76-1673-5e7b-aa95-52869b55a3c5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5+9\\text{i} & 14-3\\text{i} \\\\ 10+5\\text{i} & 9-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378192} {:answer/id #uuid "57aac1ee-8a18-5c66-8799-f46fbb5b37bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}14-3\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 10+5\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378193} {:answer/id #uuid "2a3a43c5-32fc-58c7-8c5f-c4c651b3885d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378194}] :answer-field/correct {:answer/id #uuid "2a3a43c5-32fc-58c7-8c5f-c4c651b3885d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378194} :answer-field/id #uuid "ca447862-cf40-598f-851c-412d8e940333" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378189}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "eaa32e2e-c807-5da3-b10a-a7704147713e" :question/math-academy-id "q-76217" :question/problem "If $\\,A=[\\begin{aligned}2-3\\text{i} & \\text{i} \\\\ 3 & -1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}2\\text{i} & 5 \\\\ 1-4\\text{i} & 2+\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}2-3\\text{i} & \\text{i} \\\\ 3 & -1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}2\\text{i} & 5 \\\\ 1-4\\text{i} & 2+\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(2-3\\text{i})\\cdot 2\\text{i}+\\text{i}\\cdot (1-4\\text{i}) & (2-3\\text{i})\\cdot 5+\\text{i}\\cdot (2+\\text{i}) \\\\ 3\\cdot 2\\text{i}+(-1-\\text{i})(1-4\\text{i}) & 3\\cdot 5+(-1-\\text{i})(2+\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(4\\text{i}+6)+(\\text{i}+4) & (10-15\\text{i})+(2\\text{i}-1) \\\\ 6\\text{i}+(-5+3\\text{i}) & 15+(-1-3\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378195 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "151fe5c4-7476-5e4f-94aa-e90e995a5eec" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5\\text{i}+2 & -4+2\\text{i} \\\\ 9-2\\text{i} & -4+2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378197} {:answer/id #uuid "22db4077-0318-5e00-839d-2f3993ac2deb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5\\text{i}+2 & 9-2\\text{i} \\\\ -4+2\\text{i} & -4+2\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378198} {:answer/id #uuid "b2bb92ae-fdf0-5c1d-a431-e1158e1ea90d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 9-2\\text{i} \\\\ -4+2\\text{i} & 7\\end{aligned}]" :db/id #edb/ref 17592186378199} {:answer/id #uuid "6f3baffa-2d9b-5571-8746-4cf2a3e11482" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & -4+2\\text{i} \\\\ 9-2\\text{i} & 2+5\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378200} {:answer/id #uuid "06d68b35-d8e9-58e1-92ba-7b22e799423e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4+2\\text{i} & 9-2\\text{i} \\\\ -4+2\\text{i} & 2+5\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378201}] :answer-field/correct {:answer/id #uuid "06d68b35-d8e9-58e1-92ba-7b22e799423e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4+2\\text{i} & 9-2\\text{i} \\\\ -4+2\\text{i} & 2+5\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186378201} :answer-field/id #uuid "18994d12-1a7c-5861-9a06-6ee6fdf9bbdf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378196}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "cd5e4893-04c2-58e1-988e-046f67812670" :question/math-academy-id "q-76222" :question/problem "If $\\,A=[\\begin{aligned}2-\\text{i} & 3+\\text{i} \\\\ 1+2\\text{i} & 1+\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}1+\\text{i} & 2+\\text{i} \\\\ -2+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}2-\\text{i} & 3+\\text{i} \\\\ 1+2\\text{i} & 1+\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}1+\\text{i} & 2+\\text{i} \\\\ -2+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(2-\\text{i})(1+\\text{i})+(3+\\text{i})(-2+\\text{i}) & (2-\\text{i})(2+\\text{i})+(3+\\text{i})(1-\\text{i}) \\\\ (1+2\\text{i})(1+\\text{i})+(1+\\text{i})(-2+\\text{i}) & (1+2\\text{i})(2+\\text{i})+(1+\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(3+\\text{i})+(-7+\\text{i}) & 5+(4-2\\text{i}) \\\\ (-1+3\\text{i})+(-3-\\text{i}) & 2+5\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-4+2\\text{i} & 9-2\\text{i} \\\\ -4+2\\text{i} & 2+5\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324440 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5445583-7cae-5d34-a67f-70614754b2b9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4+6\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324442} {:answer/id #uuid "29cb5c79-d63b-59bb-b68b-45ad61d4c9e0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1+13\\text{i} & 7+5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324443} {:answer/id #uuid "b5d2e190-17b2-51b3-8319-9ba4fed94cd9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4+6\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & -1-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324444} {:answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324445} {:answer/id #uuid "bdf260e0-032f-5d9c-9b90-01c4a971c948" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 8+6\\text{i} \\\\ 7-5\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324446}] :answer-field/correct {:answer/id #uuid "9ccc9e15-75bb-5c9c-bd71-373a223c949f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324445} :answer-field/id #uuid "08dc7d36-4aab-51b3-b8c0-45d260b89c34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324441}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e93d1f28-d0c0-5126-b248-ca6895657c64" :question/math-academy-id "q-76223" :question/problem "If $\\,A=[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1-3\\text{i} & -1+2\\text{i} \\\\ 2+2\\text{i} & 1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}3-\\text{i} & 3+\\text{i} \\\\ -1+\\text{i} & 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(1-3\\text{i})(3-\\text{i})+(-1+2\\text{i})(-1+\\text{i}) & (1-3\\text{i})(3+\\text{i})+(-1+2\\text{i})(1-\\text{i}) \\\\ (2+2\\text{i})(3-\\text{i})+(1-\\text{i})(-1+\\text{i}) & (2+2\\text{i})(3+\\text{i})+(1-\\text{i})(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-10\\text{i}+(-1-3\\text{i}) & (6-8\\text{i})+(1+3\\text{i}) \\\\ (8+4\\text{i})+2\\text{i} & (4+8\\text{i})+(-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-13\\text{i} & 7-5\\text{i} \\\\ 8+6\\text{i} & 4+6\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186324447 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88467948-7c2f-5183-a55b-6a11764ec90c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324449} {:answer/id #uuid "3221ed64-5409-52bc-9591-d74209d70c98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324450} {:answer/id #uuid "c931d64d-6af8-544b-8df9-3b976ea8c2ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186324451} {:answer/id #uuid "70ac948a-9451-501c-af4c-8e9122449559" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324452} {:answer/id #uuid "a007df91-53d7-5825-be0f-7622672a4954" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324453}] :answer-field/correct {:answer/id #uuid "3221ed64-5409-52bc-9591-d74209d70c98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324450} :answer-field/id #uuid "77ab877a-ecbd-5dc3-828b-75998939f215" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324448}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d863dac0-16be-50b8-a3a9-ff28a7c7d6d0" :question/math-academy-id "q-76252" :question/problem "Given the matrix $A=[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}]$, find the result of applying to $A$ the following elementary row operations: \n\n$$\n{R}_{2}:={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1}\n$$" :question/worked-solution "Let's apply the row operations to $A:$\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+\\text{i} & 0 \\\\ -3 & \\text{i}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{3}{1+\\text{i}}{R}_{1} \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ -3+\\frac{3}{1+\\text{i}}\\cdot (1+\\text{i}) & \\text{i}\\end{aligned}] \\\\  & ∼[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the result  is \n\n$$\n[\\begin{aligned}1+\\text{i} & 0 \\\\ 0 & \\text{i}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186324454 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef2e7753-83f4-5826-a04f-89616d34c578" :knowledge-point/title "Applying Row Operations to a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31aa0cff-1ddd-5ced-9f90-646f5db2454b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\text{i} & \\text{i} \\\\ 0 & 8\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186324456} {:answer/id #uuid "8d4331b5-4e68-59f1-9000-