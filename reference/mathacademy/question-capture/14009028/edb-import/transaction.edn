x}\\cdot  \\\\  & =6\\int u\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{6}{3}\\int u\\,\\text{d}u \\\\  & =2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & ={u}^{2}+C \\\\  & ={ln}^{2}⁡({x}^{3})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-210742/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-210742"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13803/selection/caf0d00c700c981c297af34a9999b42314c004b719ac6d108370d686538b6ba5" :answer/id #uuid "889ad441-d1c4-56a6-b705-7aa5a5f2f558" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13803/selection/b31094a1faa70307f9fdcea9678542b0bfb95aafeebaf45438acf38d4b93aaa7" :answer/id #uuid "a0dedd3f-bd40-52de-9650-d627896afc09" :answer/type :answer.type/math :answer/value "{ln}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13803/selection/df5d11f1011357f4b18f0e7101a65ccdc7fd09243ab72d31668debe4a03b554e" :answer/id #uuid "cc76caca-bc0f-52ed-8254-97e818f1b12a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{ln}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13803/selection/cc924afdddc4037f23ee70184f40cd4bfbb4d5113cb7cbb42d4180acdfcd22f8" :answer/id #uuid "6a605c5d-653a-5ed3-ad3c-426e45c63748" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{ln}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13803/selection/49ce334e1fba20bc6cbaca4684737fdfa379ecc0f789de55e617416628e41552" :answer/id #uuid "a56840dc-5e00-5f49-b590-1f3863c348f0" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{ln}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13803/selection" :answer-field/id #uuid "291f4bbb-6be7-5dcb-b262-66285993d76d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13803/selection/caf0d00c700c981c297af34a9999b42314c004b719ac6d108370d686538b6ba5" :answer-field/choices ["q-13803/selection/caf0d00c700c981c297af34a9999b42314c004b719ac6d108370d686538b6ba5" "q-13803/selection/b31094a1faa70307f9fdcea9678542b0bfb95aafeebaf45438acf38d4b93aaa7" "q-13803/selection/df5d11f1011357f4b18f0e7101a65ccdc7fd09243ab72d31668debe4a03b554e" "q-13803/selection/cc924afdddc4037f23ee70184f40cd4bfbb4d5113cb7cbb42d4180acdfcd22f8" "q-13803/selection/49ce334e1fba20bc6cbaca4684737fdfa379ecc0f789de55e617416628e41552"] :db/ensure [:answer-field/validate]} {:db/id "q-13803" :question/id #uuid "a2a8959c-6b04-5ef7-8052-da57da0ea3d3" :question/math-academy-id "q-13803" :question/problem "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int \\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{4}{u}^{2}+C \\\\  & =\\frac{1}{4}{ln}^{2}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13803/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-13803"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31397/selection/4e13ed7f4e6a6cd0c34946edbf6b86a6efc8f237f7246a7e75e98528c0e4ee93" :answer/id #uuid "c6f3c4e1-90a5-55d9-8b37-bec463cfa521" :answer/type :answer.type/math :answer/value "{e}^{3x}+C" :db/ensure [:answer/validate]} {:db/id "q-31397/selection/5ffb6e4261efef94d989b76efc267acee1d9588ba62a519badc82fe6c3a43e4e" :answer/id #uuid "dc0bfd8a-1337-5353-9115-afd616cf4dee" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31397/selection/ee46a69c60dbea0518144ae78eda1f5e39f3c950e2f09ead31a893157aca1622" :answer/id #uuid "76fd98a9-5f72-5ada-af96-9f5e50a16e30" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31397/selection/354e5e350f5e92dad9e642fbb9add5d7dae66b12662a306457971329761f3ee0" :answer/id #uuid "8fd13c43-9507-5941-86aa-5411c48ed808" :answer/type :answer.type/math :answer/value "{log}_{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-31397/selection/a782ce8103ca88e354c5822b86c6776bc1bd8e34f94f8a66b634e6138f2bb4b8" :answer/id #uuid "9d776e92-57ee-56b1-a88d-9435df509800" :answer/type :answer.type/math :answer/value "{e}^{x}+C" :db/ensure [:answer/validate]} {:db/id "q-31397/selection" :answer-field/id #uuid "65594974-9339-5cbb-aaea-daf806666fb3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31397/selection/5ffb6e4261efef94d989b76efc267acee1d9588ba62a519badc82fe6c3a43e4e" :answer-field/choices ["q-31397/selection/4e13ed7f4e6a6cd0c34946edbf6b86a6efc8f237f7246a7e75e98528c0e4ee93" "q-31397/selection/5ffb6e4261efef94d989b76efc267acee1d9588ba62a519badc82fe6c3a43e4e" "q-31397/selection/ee46a69c60dbea0518144ae78eda1f5e39f3c950e2f09ead31a893157aca1622" "q-31397/selection/354e5e350f5e92dad9e642fbb9add5d7dae66b12662a306457971329761f3ee0" "q-31397/selection/a782ce8103ca88e354c5822b86c6776bc1bd8e34f94f8a66b634e6138f2bb4b8"] :db/ensure [:answer-field/validate]} {:db/id "q-31397" :question/id #uuid "7d778489-5860-55d0-a860-26c713534ade" :question/math-academy-id "q-31397" :question/problem "$\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{3}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{3}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡3\\cdot \\operatorname{ln}⁡|{log}_{3}⁡x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-31397/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-31397"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-31329"] :question/problem "$\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡x}{x}\\,\\text{d}x & =\\int {log}_{2}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\operatorname{ln}⁡2\\cdot \\frac{{log}_{2}^{2}⁡x}{2}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-210781/selection/524e97394d3133ce4ea31d12e81cb603a19ab56ecce4f52cfacbfa53a1b24755" :answer/id #uuid "de0b956b-1133-5f24-8e0a-a5e4499c624f" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/ensure [:answer/validate]} {:db/id "q-210781/selection/77d609117e1790e3c173d887c1cf38ac048f7345a0da30795271f9bb86cfc884" :answer/id #uuid "b64ceb84-429c-5862-af05-a51823f63ebe" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/ensure [:answer/validate]} {:db/id "q-210781/selection/81ea25e577539e0391468c93bd04847bd1289b9634dadd05cf95303f55983524" :answer/id #uuid "0628a5ef-9e65-5719-8bf9-6b4e90596f8c" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡3|{log}_{3}⁡(2x)|+C" :db/ensure [:answer/validate]} {:db/id "q-210781/selection/d80824c5de5bdcdd80f324a2857e83698adeab8e5425e4b54c11d6ba83b67112" :answer/id #uuid "427867e6-0a7c-55e6-bf02-2fd67e867f43" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|\\operatorname{ln}⁡(3x)|+C" :db/ensure [:answer/validate]} {:db/id "q-210781/selection/3a77fc7336dfa89bc56f09df255c22d44bedf78ec0c2e36ee18d30d05968b492" :answer/id #uuid "5b8263f6-0eec-5b6c-8617-0ca7d6c2ac71" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C" :db/ensure [:answer/validate]} {:db/id "q-210781/selection" :answer-field/id #uuid "d43a5979-cea6-574c-8eef-3102737d664e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-210781/selection/524e97394d3133ce4ea31d12e81cb603a19ab56ecce4f52cfacbfa53a1b24755" :answer-field/choices ["q-210781/selection/524e97394d3133ce4ea31d12e81cb603a19ab56ecce4f52cfacbfa53a1b24755" "q-210781/selection/77d609117e1790e3c173d887c1cf38ac048f7345a0da30795271f9bb86cfc884" "q-210781/selection/81ea25e577539e0391468c93bd04847bd1289b9634dadd05cf95303f55983524" "q-210781/selection/d80824c5de5bdcdd80f324a2857e83698adeab8e5425e4b54c11d6ba83b67112" "q-210781/selection/3a77fc7336dfa89bc56f09df255c22d44bedf78ec0c2e36ee18d30d05968b492"] :db/ensure [:answer-field/validate]} {:db/id "q-210781" :question/id #uuid "1ac204a3-c26a-5153-94fe-5a9acfd15332" :question/math-academy-id "q-210781" :question/problem "$\\int \\frac{3}{x{log}_{3}⁡(2x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡(2x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x{log}_{3}⁡(2x)}\\,\\text{d}x & =\\int \\frac{3}{{log}_{3}⁡(2x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{3}{u}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡3\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =3\\operatorname{ln}⁡3\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{3}⁡(2x)|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-210781/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-210781"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-31401"] :question/problem "$\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡({x}^{2}).$Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡3}\\,⟹\\,\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{3}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\int u\\cdot \\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-31400/selection/c22d994e6b312df5e08da179c59884561896aeb8e17752b94fe9c46c84028233" :answer/id #uuid "243a3bd8-64e9-5a14-82ca-22d97fda1b37" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-31400/selection/c5b91983e3a137fa16aead0f307a0f553e9ae91775722d7f9ab641d62017d355" :answer/id #uuid "e2247c3f-e755-57a0-ae66-bfdfc706cc1f" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31400/selection/5a742d0271862e660963c7449fa94521f054bf3d8e58d744d1e0408d2f7d1c64" :answer/id #uuid "ecf8598e-6eea-5703-9c31-ff8196baf45d" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31400/selection/f0a25d49820cb3dd34fbd2ec94d69cb184336c6f5970ce61082ab7ae21dffbff" :answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/ensure [:answer/validate]} {:db/id "q-31400/selection/e2f04d096301b4023e235198d24401b04894cabd60f4a63b3007d1c91c7af861" :answer/id #uuid "fae7eb33-6046-5f29-b1b7-5e65446b8fad" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-31400/selection" :answer-field/id #uuid "ac3879c7-cbb1-5376-b8fc-d1131727dee1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31400/selection/f0a25d49820cb3dd34fbd2ec94d69cb184336c6f5970ce61082ab7ae21dffbff" :answer-field/choices ["q-31400/selection/c22d994e6b312df5e08da179c59884561896aeb8e17752b94fe9c46c84028233" "q-31400/selection/c5b91983e3a137fa16aead0f307a0f553e9ae91775722d7f9ab641d62017d355" "q-31400/selection/5a742d0271862e660963c7449fa94521f054bf3d8e58d744d1e0408d2f7d1c64" "q-31400/selection/f0a25d49820cb3dd34fbd2ec94d69cb184336c6f5970ce61082ab7ae21dffbff" "q-31400/selection/e2f04d096301b4023e235198d24401b04894cabd60f4a63b3007d1c91c7af861"] :db/ensure [:answer-field/validate]} {:db/id "q-31400" :question/id #uuid "3c53474e-e877-5764-b2e1-1623184bc76e" :question/math-academy-id "q-31400" :question/problem "$\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31400/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-31400"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346435/field-1/a1752134eb4c157233cfa7611deb9f87b3c63633480977028f4364ebe150565e" :answer/id #uuid "91355321-4aaa-5827-b25a-f768637dd369" :answer/type :answer.type/math :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-346435/field-1" :answer-field/id #uuid "e5a5ec03-5b0e-5ce0-ae81-bcd6e12d0f3e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346435/field-1/a1752134eb4c157233cfa7611deb9f87b3c63633480977028f4364ebe150565e" :answer-field/choices ["q-346435/field-1/a1752134eb4c157233cfa7611deb9f87b3c63633480977028f4364ebe150565e"] :db/ensure [:answer-field/validate]} {:db/id "q-346435" :question/id #uuid "9fec3228-1358-581c-bfd2-8d4b419af6b7" :question/math-academy-id "q-346435" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $32$ |\n| --- | --- | --- |\n| $u$ | $2$ | $5$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x & ={\\int }_{4}^{32}\\frac{1}{\\sqrt{{log}_{2}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot 2\\sqrt{u}\\,{|}_{2}^{5} \\\\  & =(2\\sqrt{5}-2\\sqrt{2})\\operatorname{ln}⁡2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346435/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-346435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351283/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c565f3d0-1788-59c5-b844-e68b6a120590" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-351283/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "2f7750a3-cd87-50af-ac0e-8c6db22ccbb7" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-351283/field-1" :answer-field/id #uuid "7e408cab-5de5-5cd1-a8b9-2d7cdb3b8d0d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351283/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-351283/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-351283/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-351283" :question/id #uuid "2b0fab75-92d3-57f7-aef2-4351e6b585ae" :question/math-academy-id "q-351283" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{3}^{81}\\frac{2}{x\\sqrt{{log}_{3}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡3$" :question/worked-solution "Let $u={log}_{3}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3}\\,⟹\\,\\operatorname{ln}⁡3\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $81$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{81}\\frac{2}{x\\sqrt{{log}_{3}⁡x}}\\,\\text{d}x & =2{\\int }_{3}^{81}\\frac{1}{\\sqrt{{log}_{3}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{4}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡3{\\int }_{1}^{4}{u}^{-1/2}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡3\\cdot (2\\sqrt{u}){|}_{1}^{4} \\\\  & =4\\operatorname{ln}⁡3(\\sqrt{4}-\\sqrt{1}) \\\\  & =4\\operatorname{ln}⁡3(2-1) \\\\  & =(4)\\operatorname{ln}⁡3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351283/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-351283"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351287/field-1/77cc7497ce827c71ef8f6d0a0697385afd4a676c1b3353f16b913c1526e51a15" :answer/id #uuid "08d4e914-777e-5d39-bff5-e6c1b095c7b7" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\ln(3)" :db/ensure [:answer/validate]} {:db/id "q-351287/field-1" :answer-field/id #uuid "6dc41768-8fe2-54d7-8499-5395b932e732" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351287/field-1/77cc7497ce827c71ef8f6d0a0697385afd4a676c1b3353f16b913c1526e51a15" :answer-field/choices ["q-351287/field-1/77cc7497ce827c71ef8f6d0a0697385afd4a676c1b3353f16b913c1526e51a15"] :db/ensure [:answer-field/validate]} {:db/id "q-351287" :question/id #uuid "f7bb151c-aa2a-5b17-87e8-0a807a1157b5" :question/math-academy-id "q-351287" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x=($\n{{field-1}}\n$)\\,\\operatorname{ln}⁡5$" :question/worked-solution "Let $u={log}_{5}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}\\operatorname{ln}⁡5}\\cdot 2x=\\frac{2}{x\\operatorname{ln}⁡5}\\,⟹\\,\\frac{\\operatorname{ln}⁡5}{2}\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $5$ | $125$ |\n| --- | --- | --- |\n| $u$ | $2$ | $6$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x & =\\frac{8}{3}{\\int }_{5}^{125}\\frac{1}{{log}_{5}⁡({x}^{2})}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{8}{3}{\\int }_{2}^{6}\\frac{1}{u}\\cdot \\frac{\\operatorname{ln}⁡5}{2}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}{\\int }_{2}^{6}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡|u|){|}_{2}^{6} \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2) \\\\  & =\\frac{4\\operatorname{ln}⁡5}{3}\\operatorname{ln}⁡3 \\\\  & =(\\frac{4}{3}\\operatorname{ln}⁡3)\\operatorname{ln}⁡5\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351287/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-351287"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13845/selection/39121d9efdd3828ea2c443e27413606bfef6a110865734874e8dcb77005b1ac6" :answer/id #uuid "3d1829b6-226a-59cc-ac84-7f70965b07ce" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡4" :db/ensure [:answer/validate]} {:db/id "q-13845/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "9113c0d7-8669-5745-b3db-515179197b98" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-13845/selection/a8815ed0e8d91a649a3253525e7272b93c5642e8d25e87824c76eb9628ecdf93" :answer/id #uuid "9566a656-778f-5411-9730-91f0f85885d8" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/ensure [:answer/validate]} {:db/id "q-13845/selection/3efc6b5dce1552e794e7ec40e62286046eec116eae62f62020840548e35c1d75" :answer/id #uuid "034d5368-5634-501b-8b12-5d08897bafb9" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/ensure [:answer/validate]} {:db/id "q-13845/selection/86440d4cb171513446f77904bd31d82f12b5c065659e0fa7ae8f927790e9d8d3" :answer/id #uuid "07324f29-5966-586d-9fb8-528de2658edc" :answer/type :answer.type/math :answer/value "-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)" :db/ensure [:answer/validate]} {:db/id "q-13845/selection" :answer-field/id #uuid "45cdad24-554c-585e-951c-83c395fde969" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13845/selection/a8815ed0e8d91a649a3253525e7272b93c5642e8d25e87824c76eb9628ecdf93" :answer-field/choices ["q-13845/selection/39121d9efdd3828ea2c443e27413606bfef6a110865734874e8dcb77005b1ac6" "q-13845/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-13845/selection/a8815ed0e8d91a649a3253525e7272b93c5642e8d25e87824c76eb9628ecdf93" "q-13845/selection/3efc6b5dce1552e794e7ec40e62286046eec116eae62f62020840548e35c1d75" "q-13845/selection/86440d4cb171513446f77904bd31d82f12b5c065659e0fa7ae8f927790e9d8d3"] :db/ensure [:answer-field/validate]} {:db/id "q-13845" :question/id #uuid "25f19f3c-0b42-5a9e-a3d7-4998abc0a9b4" :question/math-academy-id "q-13845" :question/problem "What is the value of ${\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e/4$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e/4}\\frac{1}{4x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =\\frac{1}{4}{\\int }_{1}^{e/4}\\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}{\\int }_{\\operatorname{ln}⁡4}^{1}\\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡|u|){|}_{\\operatorname{ln}⁡4}^{1} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡1-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =\\frac{1}{4}(0-\\operatorname{ln}⁡(\\operatorname{ln}⁡4)) \\\\  & =-\\frac{1}{4}\\operatorname{ln}⁡(\\operatorname{ln}⁡4)\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-13845/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-13845"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346434/field-1/698284dddcb608f3a624f5bbb40c2e11544cb458add0fa6683f04b00192ffd4a" :answer/id #uuid "e673357c-b410-5f96-9b33-c8b4ccf787e0" :answer/type :answer.type/math :answer/value "\\frac{75}{8}" :db/ensure [:answer/validate]} {:db/id "q-346434/field-1" :answer-field/id #uuid "b522b96f-b6f0-580b-98ff-2190e85faf4b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346434/field-1/698284dddcb608f3a624f5bbb40c2e11544cb458add0fa6683f04b00192ffd4a" :answer-field/choices ["q-346434/field-1/698284dddcb608f3a624f5bbb40c2e11544cb458add0fa6683f04b00192ffd4a"] :db/ensure [:answer-field/validate]} {:db/id "q-346434" :question/id #uuid "6b56979c-6ffd-5144-983e-db25c6dde3f7" :question/math-academy-id "q-346434" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{e}^{{e}^{4}}\\frac{5\\operatorname{ln}⁡x}{4x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | ${e}^{4}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $4$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{e}^{{e}^{4}}\\frac{5\\operatorname{ln}⁡x}{4x}\\,\\text{d}x & =\\frac{5}{4}{\\int }_{e}^{{e}^{4}}\\operatorname{ln}⁡x\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{1}^{4}u\\,\\text{d}u \\\\  & =\\frac{5}{4}\\cdot \\frac{{u}^{2}}{2}\\,{|}_{1}^{4} \\\\  & =\\frac{5}{8}\\cdot {u}^{2}\\,{|}_{1}^{4} \\\\  & =\\frac{5}{8}({4}^{2}-{1}^{2}) \\\\  & =\\frac{5}{8}\\cdot 15 \\\\  & =\\frac{75}{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346434/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-346434"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-14405"] :question/problem "Calculate $\\displaystyle{\\int \\dfrac{3}{x \\sqrt{\\ln x}} \\, \\textrm{d}x }.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot 2{u}^{1/2}+C \\\\  & =6\\sqrt{u}+C \\\\  & =6\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14406"] :question/problem "Calculate the integral $\\displaystyle \\int \\dfrac{\\log^2_3 x }{x} \\,\\textrm d x.$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\dfrac{(\\log_3 x)^2 }{x} \\,\\textrm d x.\n$$\n\nLet $u=\\log_3 x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{x\\ln 3}\\quad\\Longrightarrow\\quad\\ln 3\\,\\textrm d u = \\dfrac 1 x \\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{({log}_{3}⁡x)^{2}}{x}\\,\\text{d}x & =\\int ({log}_{3}⁡x)^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int {u}^{2}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{1}{3}{u}^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3({log}_{3}⁡x)^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3{log}_{3}^{3}⁡x+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-14422"] :question/problem "Evaluate $\\displaystyle{\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x}.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | $e^2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\eqalign{\n\t\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x\n&= \\int_{e}^{e^2} (\\ln x)^2\\cdot \\dfrac{\\textrm{d}x}{x}\\[5pt]\n&=\\int_{1}^{2} u^2\\,\\textrm{d}u\\[5pt]\n&=\\left.\\dfrac13u^{3}\\right|_{1}^{2}\\[5pt] \n&=\\dfrac{1}{3}\\left(2^3-1^3 \\right)\\[5pt]\n&=\\dfrac{1}{3}\\left(8-1 \\right)\\[5pt]\n&=\\dfrac{7}{3}\t\t\n\n\t}\n$$" :db/ensure [:question/validate]}]
