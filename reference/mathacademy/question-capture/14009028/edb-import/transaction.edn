c4719d48daf8c70b0466ca702535ddae6aa039720dd56"] :db/ensure [:answer-field/validate]} {:db/id "q-13807" :question/id #uuid "4234ecef-6101-5408-8e19-a789f906baa2" :question/math-academy-id "q-13807" :question/problem "Calculate the integral $\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{2}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{2}}\\cdot 2x=\\frac{2}{x}\\,⟹\\,\\frac{1}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡({x}^{2})}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\operatorname{ln}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =\\frac{1}{3}\\int u\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{1}{6}\\int u\\,\\text{d}u \\\\  & =\\frac{1}{6}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{1}{12}{u}^{2}+C \\\\  & =\\frac{1}{12}{ln}^{2}⁡({x}^{2})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-13807/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-13807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-210742/selection/080e8dfe42be368677771b5fd88e986b648a7a2586df4f76d6c3752d909e5c2b" :answer/id #uuid "0af3f528-1cd9-5154-9953-7c5f5220b388" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{ln}^{2}⁡({x}^{3})+C" :db/ensure [:answer/validate]} {:db/id "q-210742/selection/cd30f8eac086ee47fcf995ed1104b4326a75843a9ed464256c356c7aa15d90b3" :answer/id #uuid "1b9682a4-d6f2-5bbf-a441-a51971d11256" :answer/type :answer.type/math :answer/value "2{ln}^{3}⁡({x}^{3})+C" :db/ensure [:answer/validate]} {:db/id "q-210742/selection/92df6b724494cbb8ee062c4f4b7e015e320d4599ab974ec47b43f8181147c38a" :answer/id #uuid "cca61265-4745-506b-a432-d69629bfe22d" :answer/type :answer.type/math :answer/valu