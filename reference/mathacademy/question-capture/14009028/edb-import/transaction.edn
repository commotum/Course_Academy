[{:db/id [:question/math-academy-id "q-13802"] :question/problem "Calculate the integral $\\int \\frac{2}{x\\operatorname{ln}⁡(2x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(2x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(2x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-31398/selection/41dea9e4b33dbb7076653ca139398ca6108ba11fdb9b57959215a203dd6466d3" :answer/id #uuid "be226d19-d6c8-5673-8d15-e0a5b50957e6" :answer/type :answer.type/math :answer/value "\\frac{1}{9}{ln}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-31398/selection/bd00d293b7cbcaf94c5bf367a8e131c460020945e60f6a81b291dfdb295b1df0" :answer/id #uuid "feb6fcbd-3a3c-5da8-bc3e-f6194d6eac40" :answer/type :answer.type/math :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/ensure [:answer/validate]} {:db/id "q-31398/selection/cdc1997c4fcde835c131e8d1f01ed9378c2e1a6eb3a22536a29b5dfadc2cefe6" :answer/id #uuid "c8d00600-d79e-5010-8a77-6cd62efd0f2d" :answer/type :answer.type/math :answer/value "\\frac{2}{9}\\sqrt{\\operatorname{ln}⁡x}+C" :db/ensure [:answer/validate]} {:db/id "q-31398/selection/d4def03682363fec7efed2a1ee18e56835f75028fbcd41c7a646ad0ecc178f28" :answer/id #uuid "039b7f02-889f-54bf-b89c-366effd8a329" :answer/type :answer.type/math :answer/value "\\frac{2}{9}{ln}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-31398/selection/ac0799a7b8f5537b38d56ee7cd6b8c20c547fd777f473b0098899e7fb3d60b13" :answer/id #uuid "00ebc433-672a-5713-b1b6-f956bacdc5a2" :answer/type :answer.type/math :answer/value "\\frac{9}{2}\\sqrt{{ln}^{3}⁡x}+C" :db/ensure [:answer/validate]} {:db/id "q-31398/selection" :answer-field/id #uuid "82c9f2b6-bdfc-5d52-832e-d800c88d82fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31398/selection/bd00d293b7cbcaf94c5bf367a8e131c460020945e60f6a81b291dfdb295b1df0" :answer-field/choices ["q-31398/selection/41dea9e4b33dbb7076653ca139398ca6108ba11fdb9b57959215a203dd6466d3" "q-31398/selection/bd00d293b7cbcaf94c5bf367a8e131c460020945e60f6a81b291dfdb295b1df0" "q-31398/selection/cdc1997c4fcde835c131e8d1f01ed9378c2e1a6eb3a22536a29b5dfadc2cefe6" "q-31398/selection/d4def03682363fec7efed2a1ee18e56835f75028fbcd41c7a646ad0ecc178f28" "q-31398/selection/ac0799a7b8f5537b38d56ee7cd6b8c20c547fd777f473b0098899e7fb3d60b13"] :db/ensure [:answer-field/validate]} {:db/id "q-31398" :question/id #uuid "8dd1d32f-b149-5f3f-b3a9-56bf64944e84" :question/math-academy-id "q-31398" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{2}{9}{u}^{3/2}+C \\\\  & =\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31398/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-31398"] :db/ensure [:knowle