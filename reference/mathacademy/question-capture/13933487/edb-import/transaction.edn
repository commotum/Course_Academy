bfd96"] :db/ensure [:answer-field/validate]} {:db/id "q-103279" :question/id #uuid "8d77b4be-faf6-593f-b380-5ebb8440ba40" :question/math-academy-id "q-103279" :question/is-example false :question/problem "If $cos⁡x=\\frac{3}{8},$ then $4cos⁡(x-10\\pi )+5=$" :question/worked-solution "The period of $y=cos⁡x$ is $2\\pi .$ Therefore, for an integer $n$ we have\n\n$$\ncos⁡x=cos⁡(x+2n\\pi ).\n$$\n\nSubstituting $n=-5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}cos⁡x=cos⁡(x+2\\cdot (-5)\\cdot \\pi )=cos⁡(x-10\\pi ).\\end{aligned}\n$$\n\nTherefore, if $cos⁡x=\\frac{3}{8},$ then $cos⁡(x-10\\pi )=\\frac{3}{8}.$\n\nFinally, then\n\n$$\n\\begin{aligned}4cos⁡(x-10\\pi )+5 & =4(\\frac{3}{8})+5 \\\\  & =\\frac{3}{2}+5 \\\\  & =\\frac{13}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103279/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1c25c3a0-083a-55d5-b688-7347bfafaa9e"] :knowledge-point/questions ["q-103279"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70672/selection/2e8264bb4204cf08dc744da42f7ee94e617ef15160c0e447f7b401b8ebf49770" :answer/id #uuid "e9c22e2d-70b4-5fe4-907e-6865ff4bed7f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{3}+16\\pi " :db/ensure [:answer/validate]} {:db/id "q-70672/selection/9867c940637bb2bc2a4577eb157e1511174d03e76f8386279fb75d4b2b29ce15" :answer/id #uuid "125ff7b4-5d0d-56fd-8856-30d9baf615eb" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{3}+2\\pi " :db/ensure [:answer/validate]} {:db/id "q-70672/selection/a05724295bc0340162295da21b8749cd336584b7c76ed9f6810ddb03e7f98d00" :answer/id #uuid "d31939a9-c231-5eb8-a01f-63cce0f928c7" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-70672/selection/b3133268b6d1d4664192bc88fe8fc8d9bf4d8c6a5ec22de2fd086abbe9f848fe" :answer/id #uuid "8f517712-4c9b-5b6d-8a17-3fb539a2749c" :answer/type :answer.type/mat