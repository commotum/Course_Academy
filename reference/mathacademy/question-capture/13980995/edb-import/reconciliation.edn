cdot 6\\cdot 5!}{3!\\cdot 5!} \\\\  & =\\frac{8\\cdot 7\\cdot 6\\cdot 5!}{6\\cdot 5!} \\\\  & =\\frac{8\\cdot 7\\cdot \\cancel{6}\\cdot \\cancel{5!}}{\\cancel{6}\\cdot \\cancel{5!}} \\\\  & =8\\cdot 7 \\\\  & =56.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/state.json" "file_sha256" "b5185697440d3e9b5857af13fed04c485e119c1add725cb8db7e35a883b337de"} {"question" "q-113613" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/activity-metadata.json" "file_sha256" "0e0184ee9fb99cf69b6b5a911cab20cbe1339b88801e66c5a1a5e76334cd8ab5"} {"question" "q-113613" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/state.json" "file_sha256" "b5185697440d3e9b5857af13fed04c485e119c1add725cb8db7e35a883b337de"} {"question" "q-113613" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "112"] ["math" "128"] ["math" "42"] ["math" "56"] ["math" "64"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/state.json" "file_sha256" "b5185697440d3e9b5857af13fed04c485e119c1add725cb8db7e35a883b337de"} {"question" "q-113613" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "56"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/state.json" "file_sha256" "b5185697440d3e9b5857af13fed04c485e119c1add725cb8db7e35a883b337de"} {"question" "e-5108" "field" nil "attribute" "question/problem" "value" "Use Pascal's triangle to determine the value of $\\displaystyle{3 \\choose 2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/example-5108.json" "file_sha256" "2a307ee5b8e1cafa150ca94bf21300f76baa872e9c2323861867b01dcd8a37b4"} {"question" "e-5108" "field" nil "attribute" "question/worked-solution" "value" "To find the value of $\\displaystyle{\\color{red}{3} \\choose {\\color{blue}2}},$ we need to find the number that is located in row $\\color{red}3$ and position $\\color{blue}2$ of Pascal's triangle. \n\n**Important:** Remember that when counting the rows and positions in Pascal's triangle, we always start counting from zero!\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $\\color{red}3$ and position $\\color{blue}2$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  & 1 \\\\  &  &  & 1 &  & 1 \\\\  &  & 1 &  & 2 &  & 1 \\\\  & 1 &  & 3 &  & 3 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $\\displaystyle{3 \\choose 2} = 3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/example-5108.json" "file_sha256" "2a307ee5b8e1cafa150ca94bf21300f76baa872e9c2323861867b01dcd8a37b4"} {"question" "e-5109" "field" nil "attribute" "question/problem" "value" "Which expression is missing in the following equation?\n\n$$\n\\displaystyle{4 \\choose 3} = \\displaystyle{3 \\choose 2} + \\displaystyle{\\left[ \\phantom{3 \\choose 3}\\right]}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/example-5109.json" "file_sha256" "786fa40dcc82601df54d0a89cbd4068c31d97a51154b94c6f1b902d4b0a61c33"} {"question" "e-5109" "field" nil "attribute" "question/worked-solution" "value" "To find $\\displaystyle{\\color{red}{4} \\choose {\\color{blue}3}},$ we need to find the number that is located in row $\\color{red}4$ and position $\\color{blue}3$ of Pascal's triangle. \n\n**Important:** Remember that when counting the rows and positions in Pascal's triangle, we always start counting from zero!\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $\\displaystyle{4 \\choose 3}$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $\\displaystyle{4 \\choose 3}$ is the sum of the two closest numbers located in the previous row. So\n\n$$\n\\displaystyle{4 \\choose 3} = \\displaystyle{3 \\choose 2} + \\displaystyle{3 \\choose 3}.\n$$\n\nTherefore, the missing expression is $\\displaystyle{3 \\choose 3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/example-5109.json" "file_sha256" "786fa40dcc82601df54d0a89cbd4068c31d97a51154b94c6f1b902d4b0a61c33"} {"question" "e-5231" "field" nil "attribute" "question/problem" "value" "Determine the value of $\\displaystyle{5 \\choose 4}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/example-5231.json" "file_sha256" "d725750bed8e4e39333856c983cd68eb24ca1865cbc3a5f0355ecf2275bf5aa4"} {"question" "e-5231" "field" nil "attribute" "question/worked-solution" "value" "The binomial coefficient $\\displaystyle{n \\choose r}$ is given by the formula\n\n$$\n\\displaystyle{n \\choose r} = \\dfrac{n!}{(n-r)!\\,  r!}.\n$$\n\nIn this case, we have $n = 5$ and $r = 4.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{5}{4}) & =\\frac{5!}{(5-4)!\\cdot 4!} \\\\  & =\\frac{5\\cdot 4!}{1!\\cdot 4!} \\\\  & =\\frac{5\\cdot \\cancel{4!}}{1\\cdot \\cancel{4!}} \\\\  & =5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980995/example-5231.json" "file_sha256" "d725750bed8e4e39333856c983cd68eb24ca1865cbc3a5f0355ecf2275bf5aa4"}] "usage" {"e-5108" [] "q-69669" [] "e-5231" [] "e-5109" [] "q-69663" []} "basis" 896 "retractions" [[17592186172520 :question/problem "Use Pascal's triangle to determine the value of $(\\frac{3}{1})$."] [17592186172522 :question/problem "Which expression is missing in the following equation?\n\n$(\\frac{3}{1}) = [(\\frac{2}{0})] + (\\frac{2}{1})$"] [17592186171739 :question/problem "Use Pascal's triangle to determine the value of $\\displaystyle{3 \\choose 2}$."] [17592186171739 :question/worked-solution "To find the value of $\\displaystyle{\\color{red}{3} \\choose {\\color{blue}2}}$, we need to find the number that is located in row $\\color{red}3$ and position $\\color{blue}2$ of Pascal's triangle.\n\n**Important:** Remember that when counting the rows and positions in Pascal's triangle, we always start counting from zero!\n\n- The top row of Pascal's triangle is row $0$.\n- The first position of each row (the one of the left) is position number $0$.\n\nThe value located in row $\\color{red}3$ and position $\\color{blue}2$ is highlighted below.\n\n$$\n1; 1\\begin{vmatrix}1 \\\\ 1\\end{vmatrix}2\\begin{vmatrix}1 \\\\ 1\\end{vmatrix}3\\begin{vmatrix}3 & 1 \\\\ ⋮ & ⋮\\end{vmatrix}⋮ \\mid ⋮ \\mid ⋮\n$$\n\nTherefore,\n\n$$\n\\displaystyle{3 \\choose 2} = 3\n$$"] [17592186171740 :question/problem "Which expression is missing in the following equation?\n$\\displaystyle{4 \\choose 3} = \\displaystyle{3 \\choose 2} + \\displaystyle{\\left[\\phantom{3 \\choose 3}\\right]}$"] [17592186171740 :question/worked-solution "To find $\\displaystyle{\\color{red}{4} \\choose {\\color{blue}3}}$, we need to find the number that is located in row $\\color{red}4$ and position $\\color{blue}3$ of Pascal's triangle.\n\n**Important:** Remember that when counting the rows and positions in Pascal's triangle, we always start counting from zero!\n\n- The top row of Pascal's triangle is row $0$.\n- The first position of each row (the one of the left) is position number $0$.\n\nThe location of $\\displaystyle{4 \\choose 3}$ in Pascal's triangle is highlighted below.\n\n$$\n(\\frac{0}{0}); (\\frac{1}{0})\\begin{vmatrix}(\\frac{1}{1}) \\\\ (\\frac{2}{0})\\end{vmatrix}(\\frac{2}{1})\\begin{vmatrix}(\\frac{2}{2}) \\\\ (\\frac{3}{0})\\end{vmatrix}(\\frac{3}{1})\\begin{vmatrix}(\\frac{3}{2}) & (\\frac{3}{3}) \\\\ (\\frac{4}{0}) & (\\frac{4}{1})\\end{vmatrix}(\\frac{4}{2})\\begin{vmatrix}(4 3) & (\\frac{4}{4}) \\\\ ⋮ & ⋮\\end{vmatrix}⋮\\begin{vmatrix}⋮ & ⋮\\end{vmatrix}⋮\n$$\n\nNow, $\\displaystyle{4 \\choose 3}$ is the sum of the two closest numbers located in the previous row. So\n\n$$\n\\displaystyle{4 \\choose 3} = \\displaystyle{3 \\choose 2} + \\displaystyle{3 \\choose 3}\n$$\n\nTherefore, the missing expression is $\\displaystyle{3 \\choose 3}$."] [17592186171741 :question/problem "Determine the value of $\\displaystyle{5 \\choose 4}$."] [17592186171741 :question/worked-solution "The binomial coefficient $\\displaystyle{n \\choose r}$ is given by the formula\n\n$$\n\\displaystyle{n \\choose r} = \\dfrac{n!}{(n-r)!\\, r!}\n$$\n\nIn this case, we have $n = 5$ and $r = 4$. Therefore,\n\n$$\n\\begin{aligned}\n(\\frac{5}{4}) &= (5!)/((5 - 4)! \\cdot 4!) \\\\\n&= \\frac{5 \\cdot 4!}{1! \\cdot 4!} \\\\\n&= \\frac{5 \\cdot 4!}{1 \\cdot 4!} \\\\\n&= 5\n\\end{aligned}\n$$"]] "immutable_answers" [17592186171086 17592186171087 17592186171088 17592186171089 17592186171090 17592186171098 17592186171099 17592186171100 17592186171101 17592186171102] "immutable_fields" [[17592186171085 :answer-field/correct] [17592186171085 :answer-field/id] [17592186171085 :answer-field/key] [17592186171085 :answer-field/type] [17592186171097 :answer-field/correct] [17592186171097 :answer-field/id] [17592186171097 :answer-field/key] [17592186171097 :answer-field/type]] "no_history" []}
