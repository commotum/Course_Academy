election/f149ee40ceb0119f4abff37e910e97f802f2e08b2a11d3a6aded3c37e40bf7a0"] :db/ensure [:answer-field/validate]} {:db/id "q-113604" :question/id #uuid "239de6c5-ea8b-5080-a1b4-6a809e8010bd" :question/math-academy-id "q-113604" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{2}{1})=(\\frac{1}{0})+[]\n$$" :question/worked-solution "To find $(\\frac{2}{1}),$ we need to find the number that is located in row $2$ and position $1$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{2}{1})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{2}{1})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{2}{1})=(\\frac{1}{0})+(\\frac{1}{1})\n$$\n\nTherefore, the missing expression is $(\\frac{1}{1}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113604/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25"] :knowledge-point/questions ["q-113604"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113617/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "8bf54f00-ebd8-5e93-91c7-02b25552e46c" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-113617/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "aa6ff311-9f77-576f-ad6c-97fceaf47e46" :answer/type :answer.type/math :answer/value 