\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}\\cdot 2} \\\\  & =\\frac{30}{2} \\\\  & =15.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113617/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2"] :knowledge-point/questions ["q-113617"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70311/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "f88a14bc-81dc-5667-826e-aed6f392fe41" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-70311/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "c5c9c550-9810-52e8-9a46-f62c60882e8e" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-70311/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer/id #uuid "f8653979-ef91-59c7-b719-e7527c1bda3b" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "q-70311/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer/id #uuid "19cd5773-100a-536b-9713-59473ff62064" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "q-70311/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "5cbbb4d1-28ab-55a9-ad0e-c4e383a3fa3e" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-70311/selection" :answer-field/id #uuid "996226d1-0b9a-5e4d-8bef-1e14f9923692" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70311/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" :answer-field/choices ["q-70311/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-70311/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-70311/selection/c59421689e9802bbe55dc885ef3b88a565922fc724e5a7225b403918fe48989b" "q-70311/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" "q-70311/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee"] :db/ensure [:answer-field/validate]} {:db/id "q-70311" :question/id #uuid "4c4a2a0b-de22-53d6-8435-6628725d28c7" :question/math-academy-id "q-70311" :question/problem "Determine the value of $(\\frac{7}{3}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{3}) & =\\frac{7!}{(7-3)!\\cdot 3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4!}{4!\\cdot 3!} \\\\  & =\\frac{7\\cdot \\cancel{6}\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}\\cdot \\cancel{6}} \\\\  & =7\\cdot 5 \\\\  & =35.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-70311/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2"] :knowledge-point/questions ["q-70311"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113618/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "125c164d-f7c0-56a7-b844-80167389f9a5" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-113618/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "251e6b5d-404a-5c4e-ae3b-1e1c7a827c4b" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-113618/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "513dc15c-a2a2-5ce6-a476-15044c268163" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-113618/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a0