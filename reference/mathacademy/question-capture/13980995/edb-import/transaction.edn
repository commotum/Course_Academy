4}) &  & (\\frac{6}{5}) &  & (\\frac{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{6}{5})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{6}{5})=(\\frac{5}{4})+(\\frac{5}{5})\n$$\n\nTherefore, the missing expression is $(\\frac{5}{4}).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113608/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25"] :knowledge-point/questions ["q-113608"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69722/selection/c2ef574e2cfa773a000f7a00f2e2094f05dd68a2a9bc4a08d5da22f7e244be93" :answer/id #uuid "8132a097-c7c2-59d4-aca3-8f1f12299e42" :answer/type :answer.type/math :answer/value "(\\frac{2}{0})" :db/ensure [:answer/validate]} {:db/id "q-69722/selection/c6ae8ab8098a9af64cb41e8eeb470edadc618b925afb11889c76803955af3a57" :answer/id #uuid "ddc5b44a-d7c6-5da5-b298-f23658be6cb2" :answer/type :answer.type/math :answer/value "(\\frac{1}{0})" :db/ensure [:answer/validate]} {:db/id "q-69722/selection/fbed0a59c3aa72b3f138ce42d582b9feee4514be4be4d8305eb71bf3c81e623b" :answer/id #uuid "5d802bfa-afdf-5172-a0c6-221e2fd26210" :answer/type :answer.type/math :answer/value "(\\frac{2}{1})" :db/ensure [:answer/validate]} {:db/id "q-69722/selection/f149ee40ceb0119f4abff37e910e97f802f2e08b2a11d3a6aded3c37e40bf7a0" :answer/id #uuid "608004e4-2131-586c-9902-b4635666a953" :answer/type :answer.type/math :answer/value "(\\frac{1}{1})" :db/ensure [:answer/validate]} {:db/id "q-69722/selection/3393d52de45673b50b889fdb548fc66aeb7dd8bae133db7e2497d4cde2a6c881" :answer/id #uuid "3e7baa5c-8062-50fb-a15f-646fb29fff09" :answer/type :answer.type/math :answer/value "(\\frac{2}{2})" :db/ensure [:answer/validate]} {:db/id "q-69722/selection" :answer-field/id #uuid "e88a60d5-ef65-5990-aac6-fb3a24b2c30f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-fiel