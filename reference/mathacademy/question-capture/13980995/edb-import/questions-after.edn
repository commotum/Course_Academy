86171087} {:answer/id #uuid "d31df334-4d48-5e8f-9062-892f2449ef55" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186171088} {:answer/id #uuid "f397885f-c04f-5aad-8ebc-c95d639de0c2" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186171089} {:answer/id #uuid "17a657fa-37a1-5087-b7f3-a48d03580bcb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186171090}] :answer-field/correct {:answer/id #uuid "a80404d2-000a-54bd-b6f1-9b7ea113f361" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186171086} :answer-field/id #uuid "95b91b72-e763-5535-8591-9d52aee0e0ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171085}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cdf7006a-1c37-5b80-8205-e900efc11d73" :question/math-academy-id "q-69663" :question/problem "Use Pascal's triangle to determine the value of $(\\frac{3}{1}).$" :question/worked-solution "To find the value of $(\\frac{3}{1}),$ we need to find the number that is located in row $3$ and position $1$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $3$ and position $1$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  & 1 \\\\  &  &  & 1 &  & 1 \\\\  &  & 1 &  & 2 &  & 1 \\\\  & 1 &  & 3 &  & 3 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $(\\frac{3}{1})=3.$"}] [{:db/id #edb/ref 17592186172522 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db543b4f-62e6-5781-9acc-bf9f32cbdd78" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{0})" :db/id #edb/ref 17592186171098} {:answer/id #uuid "1894c9e0-2db8-538b-96d7-7bdfd293c739" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{1})" :db/id #edb/ref 17592186171099} {:answer/id #uuid "2a338c93-3126-52cf-97d0-ae455691c45e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186171100} {:answer/id #uuid "3b387257-9dfc-5a2a-ba9b-62a18fd58f84" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{0})" :db/id #edb/ref 17592186171101} {:answer/id #uuid "77e9be0a-60cf-5c14-ae82-8504f70c8788" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{1})" :db/id #edb/ref 17592186171102}] :answer-field/correct {:answer/id #uuid "db543b4f-62e6-5781-9acc-bf9f32cbdd78" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{0})" :db/id #edb/ref 17592186171098} :answer-field/id #uuid "b5eb199b-a8af-5152-90d9-cb71ba398906" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171097}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1afc9131-fb54-545a-abcd-cbf497ee2da8" :question/math-academy-id "q-69669" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{3}{1})=[]+(\\frac{2}{1})\n$$" :question/worked-solution "To find $(\\frac{3}{1}),$ we need to find the number that is located in row $3$ and position $1$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{3}{1})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{3}{1})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{3}{1})=(\\frac{2}{0})+(\\frac{2}{1})\n$$\n\nTherefore, the missing expression is $(\\frac{2}{0}).$"}] [{:db/id #edb/ref 17592186282482 :knowledge-point/_questions [{:knowledge-point/id #uuid "be11193b-a241-5812-a1c1-54d233ae9ddd" :knowledge-point/title "Determining the Value of a Binomial Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a94d0074-0376-5a3a-9eec-638359afafc3" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186282484} {:answer/id #uuid "0dd24b6d-59e9-53ee-be23-2a48d271610e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186282485} {:answer/id #uuid "316b8809-c323-59fd-8c7e-3fd4b2387cee" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186282486} {:answer/id #uuid "261f3836-0903-53a0-af89-d3d910d7fbb4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186282487} {:answer/id #uuid "8bdaf5e0-e88b-5efe-9fcb-272898307874" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186282488}] :answer-field/correct {:answer/id #uuid "261f3836-0903-53a0-af89-d3d910d7fbb4" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186282487} :answer-field/id #uuid "c9016d3d-a614-557c-801d-47a58b63b516" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282483}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a9816be1-010a-5501-9369-5d2c7c4f7fcc" :question/math-academy-id "q-69718" :question/problem "Use Pascal's triangle to determine the value of $(\\frac{4}{2}).$" :question/worked-solution "To find the value of $(\\frac{4}{2}),$ we need to find the number that is located in row $4$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $4$ and position $2$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  & 1 \\\\  &  &  &  & 1 &  & 1 \\\\  &  &  & 1 &  & 2 &  & 1 \\\\  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\ ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $(\\frac{4}{2})=6.$"}] [{:db/id #edb/ref 17592186282489 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e7baa5c-8062-50fb-a15f-646fb29fff09" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186282491} {:answer/id #uuid "8132a097-c7c2-59d4-aca3-8f1f12299e42" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{0})" :db/id #edb/ref 17592186282492} {:answer/id #uuid "ddc5b44a-d7c6-5da5-b298-f23658be6cb2" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{0})" :db/id #edb/ref 17592186282493} {:answer/id #uuid "608004e4-2131-586c-9902-b4635666a953" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{1})" :db/id #edb/ref 17592186282494} {:answer/id #uuid "5d802bfa-afdf-5172-a0c6-221e2fd26210" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{1})" :db/id #edb/ref 17592186282495}] :answer-field/correct {:answer/id #uuid "3e7baa5c-8062-50fb-a15f-646fb29fff09" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186282491} :answer-field/id #uuid "e88a60d5-ef65-5990-aac6-fb3a24b2c30f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282490}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cd43aeff-3f77-511a-9eec-442a5ca4b255" :question/math-academy-id "q-69722" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{3}{2})=(\\frac{2}{1})+[]\n$$" :question/worked-solution "To find $(\\frac{3}{2}),$ we need to find the number that is located in row $3$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{3}{2})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{3}{2})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{3}{2})=(\\frac{2}{1})+(\\frac{2}{2})\n$$\n\nTherefore, the missing expression is $(\\frac{2}{2}).$"}] [{:db/id #edb/ref 17592186282496 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db6320aa-0ae7-5cc6-afa8-354d10e30e38" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{0})" :db/id #edb/ref 17592186282498} {:answer/id #uuid "99b7ca11-ad01-5c8f-b1ba-11e63c548674" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{2})" :db/id #edb/ref 17592186282499} {:answer/id #uuid "000925d5-8ff7-5117-95f2-d921ea3b1fe5" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{3})" :db/id #edb/ref 17592186282500} {:answer/id #uuid "4d86c214-4bf5-5a83-a7ae-7118fe90ef50" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{0})" :db/id #edb/ref 17592186282501} {:answer/id #uuid "bcf40022-3d45-5aff-a010-6b955de12c93" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{1})" :db/id #edb/ref 17592186282502}] :answer-field/correct {:answer/id #uuid "99b7ca11-ad01-5c8f-b1ba-11e63c548674" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{4}{2})" :db/id #edb/ref 17592186282499} :answer-field/id #uuid "33a1c9a5-7ee8-53b6-a0df-611cd73bc771" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282497}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2c4d3ff0-74ab-5ca0-8de1-efa4ee014bed" :question/math-academy-id "q-69725" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{5}{2})=(\\frac{4}{1})+[]\n$$" :question/worked-solution "To find $(\\frac{5}{2}),$ we need to find the number that is located in row $5$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{5}{2})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  &  & (\\frac{5}{0}) &  & (\\frac{5}{1}) &  & (\\frac{5}{2}) &  & (\\frac{5}{3}) &  & (\\frac{5}{4}) &  & (\\frac{5}{5}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{5}{2})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{5}{2})=(\\frac{4}{1})+(\\frac{4}{2})\n$$\n\nTherefore, the missing expression is $(\\frac{4}{2}).$"}] [{:db/id #edb/ref 17592186282503 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19cd5773-100a-536b-9713-59473ff62064" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186282505} {:answer/id #uuid "c5c9c550-9810-52e8-9a46-f62c60882e8e" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186282506} {:answer/id #uuid "5cbbb4d1-28ab-55a9-ad0e-c4e383a3fa3e" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186282507} {:answer/id #uuid "f88a14bc-81dc-5667-826e-aed6f392fe41" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186282508} {:answer/id #uuid "f8653979-ef91-59c7-b719-e7527c1bda3b" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186282509}] :answer-field/correct {:answer/id #uuid "f8653979-ef91-59c7-b719-e7527c1bda3b" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186282509} :answer-field/id #uuid "996226d1-0b9a-5e4d-8bef-1e14f9923692" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282504}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4c4a2a0b-de22-53d6-8435-6628725d28c7" :question/math-academy-id "q-70311" :question/problem "Determine the value of $(\\frac{7}{3}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{3}) & =\\frac{7!}{(7-3)!\\cdot 3!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4!}{4!\\cdot 3!} \\\\  & =\\frac{7\\cdot \\cancel{6}\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}\\cdot \\cancel{6}} \\\\  & =7\\cdot 5 \\\\  & =35.\\end{aligned}\n$$"}]}
