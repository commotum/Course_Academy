e/math} :answer/value "21" :db/id #edb/ref 17592186282472} {:answer/id #uuid "251e6b5d-404a-5c4e-ae3b-1e1c7a827c4b" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186282473} {:answer/id #uuid "83741119-9438-5615-ae98-9a833b82de2b" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186282474}] :answer-field/correct {:answer/id #uuid "29aa80e8-7c05-5e81-ad96-71f955f2dfc6" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186282472} :answer-field/id #uuid "b260532e-cbe2-5e6e-942c-90a3662ee379" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186282469}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "434766c3-ec23-5f72-86a2-81bb72868566" :question/math-academy-id "q-113618" :question/problem "Determine the value of $(\\frac{7}{5}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=5.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{5}) & =\\frac{7!}{(7-5)!\\cdot 5!} \\\\  & =\\frac{7\\cdot 6\\cdot 5!}{2!\\cdot 5!} \\\\  & =\\frac{7\\cdot 6\\cdot \\cancel{5!}}{2\\cdot \\cancel{5!}} \\\\  & =\\frac{42}{2} \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186282475 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55ada1ed-8b0b-53cc-900c-db710e5bb7d4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186282477} {:answer/id #uuid "d8e714a6-2c25-5417-88b5-4397a28cd7fe" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186282478} {:answer/id #uuid "ffcf2db9-25de-5a4f-8de