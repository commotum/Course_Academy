}{[(-\\frac{3}{2}{\\theta }^{-2})]}_{1}^{a} \\\\  & =-\\frac{3}{2}\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{\\theta }^{2}}]}_{1}^{a} \\\\  & =-\\frac{3}{2}\\cdot {lim}_{a\\to \\infty }(\\frac{1}{{a}^{2}}-\\frac{1}{{1}^{2}}) \\\\  & =-\\frac{3}{2}(0-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-5962" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/activity-metadata.json" "file_sha256" "4a0113cdf61e3bfbe63d30e1064ed1367e3e933afe27bca9cc7249993406af5b"} {"question" "q-5962" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-5962" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "\\frac{1}{2}"] ["math" "\\frac{3}{2}"] ["math" "\\frac{3}{4}"] ["math" "\\frac{7}{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-5962" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152762" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152762" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z & ={lim}_{a\\to \\infty }{\\int }_{8}^{a}\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{8}^{a}{z}^{-4/3}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{[-3{z}^{-1/3}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{z}}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{a}}-\\frac{1}{\\sqrt[3]{8}}) \\\\  & =-6(0-\\frac{1}{2}) \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152762" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/activity-metadata.json" "file_sha256" "4a0113cdf61e3bfbe63d30e1064ed1367e3e933afe27bca9cc7249993406af5b"} {"question" "q-152762" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152762" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "6"] ["math" "\\frac{1}{3}"] ["math" "\\frac{4}{3}"] ["text" "The integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152762" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152755" "field" nil "attribute" "question/problem" "value" "${\\int }_{1}^{\\infty }\\frac{2}{{\\theta }^{6}}\\,\\text{d}\\theta =$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152755" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{2}{{\\theta }^{6}}\\,\\text{d}\\theta  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{2}{{\\theta }^{6}}\\,\\text{d}\\theta  \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}2{\\theta }^{-6}\\,\\text{d}\\theta  \\\\  & ={lim}_{a\\to \\infty }{[(-\\frac{2}{5}{\\theta }^{-5})]}_{1}^{a} \\\\  & =-\\frac{2}{5}\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{\\theta }^{5}}]}_{1}^{a} \\\\  & =-\\frac{2}{5}\\cdot {lim}_{a\\to \\infty }(\\frac{1}{{a}^{5}}-\\frac{1}{{1}^{5}}) \\\\  & =-\\frac{2}{5}(0-1) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152755" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/activity-metadata.json" "file_sha256" "4a0113cdf61e3bfbe63d30e1064ed1367e3e933afe27bca9cc7249993406af5b"} {"question" "q-152755" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152755" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{3}"] ["math" "\\frac{1}{5}"] ["math" "\\frac{2}{5}"] ["math" "\\frac{4}{5}"] ["text" "The integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-152755" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{5}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-118619" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-118619" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=1+{x}^{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=1+{x}^{2}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{2}{lim}_{a\\to \\infty }[-{u}^{-1}]_{1}^{a} \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }{[\\frac{1}{u}]}_{1}^{a} \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }(\\frac{1}{a}-1) \\\\  & =-\\frac{1}{2}(0-1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d6e26e0f09761645"} {"question" "q-118619" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/activity-metadata.json" "file_sha256" "4a0113cdf61e3bfbe63d30e1064ed1367e3e933afe27bca9cc7249993406af5b"} {"question" "q-118619" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14007645/state.json" "file_sha256" "1a3d73c51146b85d3c689cbb12e17c81e754ed69e12ac978d