 -9 & 3\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "8b05d12f1f1ec0e8a1229bd3f96adcf45dc63d8c33659d6a4f2702024ff17116"} {"question" "q-129961" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/activity-metadata.json" "file_sha256" "7d96e938c0db5aa001000cfa946e741477822f22159b87d2b18f23ef7c43eed6"} {"question" "q-129961" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "8b05d12f1f1ec0e8a1229bd3f96adcf45dc63d8c33659d6a4f2702024ff17116"} {"question" "q-129961" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}-1 \\\\ -9\\end{aligned}]"] ["math" "[\\begin{aligned}-3 & 1 \\\\ -9 & 3\\end{aligned}]"] ["math" "[\\begin{aligned}-3 & 9\\end{aligned}]"] ["math" "[\\begin{aligned}-3 \\\\ -1\\end{aligned}]"] ["math" "[\\begin{aligned}3 & -1 \\\\ -9 & 3\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "8b05d12f1f1ec0e8a1229bd3f96adcf45dc63d8c33659d6a4f2702024ff17116"} {"question" "q-129961" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-3 & 1 \\\\ -9 & 3\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13989257/state.json" "file_sha256" "8b05d12f1f1ec0e8a1229bd3f96adcf45dc63d8c33659d6a4f2702024ff17116"} {"question" "e-4406" "field" nil "attribute" "question/problem" "value" "Find $CD$, if \n$[\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 1\\end{aligned}]$\nand \