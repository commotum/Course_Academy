42d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-130120" :question/id #uuid "673ca041-341f-5f9a-8801-8d43ff2edab1" :question/math-academy-id "q-130120" :question/problem "Let $D=AB.$ What is the value of ${d}_{24}$, if\n\n$$\nA=[\\begin{aligned}-1 & 2 & 4 \\\\ 3 & 4 & -1 \\\\ -1 & 1 & 0 \\\\ 0 & 4 & -7\\end{aligned}],\\,B=[\\begin{aligned}1 & 1 & -2 & -3 \\\\ 0 & 4 & -1 & 1 \\\\ 2 & 0 & 3 & -3\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row in $A$ by the $4$th column in $B$, we get\n\n$$\n\\begin{aligned}{d}_{24} & =[\\begin{aligned}-1 & 2 & 4 \\\\ 3 & 4 & -1 \\\\ -1 & 1 & 0 \\\\ 0 & 4 & -7\\end{aligned}][\\begin{aligned}1 & 1 & -2 & -3 \\\\ 0 & 4 & -1 & 1 \\\\ 2 & 0 & 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 4 & -1\\end{aligned}][\\begin{aligned}-3 \\\\ 1 \\\\ -3\\end{aligned}] \\\\  & =3\\cdot (-3)+4\\cdot 1+(-1)\\cdot (-3) \\\\  & =-9+4+3 \\\\  & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130120/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-130120"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70958/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c49828d0-fafe-5874-834b-d246716e35fd" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-70958/selection/98b3dba682900da184b39a71cd54acfbad77325cb9c895968794bd8e0854ddd0" :answer/id #uuid "a99dd6d0-db50-500b-8888-84eae4de2632" :answer/type :answer.type/math :answer/value "58" :db/ensure [:answer/validate]} {:db/id "q-70958/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "90904376-264a-551a-b4a6-79f7e7767316" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-70958/selection/62a6fd1cf465955cead36d661dcbed2f93206049