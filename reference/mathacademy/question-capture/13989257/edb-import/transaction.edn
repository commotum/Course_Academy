ned}], &  & \\,-15=2\\cdot (-3)+(-1)\\cdot 6+1\\cdot (-3) \\\\  & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ ∗ & ∗\\end{aligned}], &  & \\,3=2\\cdot 2+(-1)\\cdot 5+1\\cdot 4 \\\\  & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ -9 & ∗\\end{aligned}], &  & \\,-9=1\\cdot (-3)+0\\cdot 6+2\\cdot (-3) \\\\  & [\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}], &  & \\,10=1\\cdot 2+0\\cdot 5+2\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129495/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315"] :knowledge-point/questions ["q-129495"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70956/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer/id #uuid "526c7214-bc7a-51ce-a330-b7f14b669197" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "q-70956/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "06cde687-b2f6-510a-be46-9df7ef2bc7ee" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-70956/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "8331e26c-76bd-5ab2-9bc5-ac77fc2e9a87" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-70956/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "f5e2132a-08f4-5a85-9826-e8573ba6ebd0" :answer/type :answer.type/math :answer/value "-5" :db/en