 [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-70956"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318470/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "bacd2228-7433-5726-b5ea-38097a830220" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-318470/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "d53e00d3-9cf9-5d55-bc83-56bb05b63524" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-318470/field-1" :answer-field/id #uuid "b67fe4c9-4147-5040-9499-5c5ea8d68f51" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318470/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-318470/field-1/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-318470/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-318470" :question/id #uuid "d7688075-479d-5b00-99aa-a2868922307b" :question/math-academy-id "q-318470" :question/problem "Let $Z=XY.$ What is the value of ${z}_{24}$, if\n\n$$\nX=[\\begin{aligned}1 & -1 \\\\ 3 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{aligned}]?\n$$\n\n${z}_{24}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $X$ by the $4$th column in $Y,$ we get\n\n$$\n\\begin{aligned}{z}_{24} & =[\\begin{aligned}1 & -1 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2\\end{aligned}][\\begin{aligned}-3 \\\\ 2\\end{aligned}] \\\\  & =3(-3)+2(2) \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318470/field-1"] :db/ensure [:question/validate