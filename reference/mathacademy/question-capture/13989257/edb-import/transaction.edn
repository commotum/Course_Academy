.difficulty/easy :question/answer-fields ["q-70958/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-70958"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318463/field-1/f114c855cb4980abfc1057e37678c04cac7ea9d9ad649da669e46dcd5213df25" :answer/id #uuid "ef7e09e7-bd35-5d0c-950b-b8b1234c0b85" :answer/type :answer.type/math :answer/value "-19" :db/ensure [:answer/validate]} {:db/id "q-318463/field-1" :answer-field/id #uuid "fd2fc7c8-7a4f-5752-93e2-06204b06b873" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318463/field-1/f114c855cb4980abfc1057e37678c04cac7ea9d9ad649da669e46dcd5213df25" :answer-field/choices ["q-318463/field-1/f114c855cb4980abfc1057e37678c04cac7ea9d9ad649da669e46dcd5213df25"] :db/ensure [:answer-field/validate]} {:db/id "q-318463" :question/id #uuid "ba6916f1-99b8-5754-9682-e418e10204b2" :question/math-academy-id "q-318463" :question/problem "Let $X=YZ.$ What is the value of ${x}_{12}$, if\n\n$$\nY=[\\begin{aligned}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{aligned}],\\,Z=[\\begin{aligned}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{aligned}]?\n$$\n\n${x}_{12}=$\n{{field-1}}" :question/worked-solution "Multiplying the $1$st row in $Y$ by the $2$nd column in $Z$, we get\n\n$$\n\\begin{aligned}{x}_{12} & =[\\begin{aligned}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{aligned}][\\begin{aligned}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 & 0\\end{aligned}][\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =(-2)(5)+3(-3)+0(1) \\\\  & =-10-9+0 \\\\  & =-19.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318463/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-318463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130230/selectio