ot (-4) & (-1)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -12 & 6 \\\\ 4 & -2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318588/field-1" "q-318588/field-2" "q-318588/field-3" "q-318588/field-4" "q-318588/field-5" "q-318588/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd"] :knowledge-point/questions ["q-318588"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318484/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "10ec9bd6-c0d3-5018-bf4c-0e31b2365921" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-318484/field-1" :answer-field/id #uuid "ee398905-8bfd-501b-9a47-f0aa2ae090fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318484/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-318484/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-318484/field-2/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer/id #uuid "a316cb83-7abe-58c3-8cbd-4b1ff9fc9b00" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "q-318484/field-2" :answer-field/id #uuid "5f135a9a-ccff-5ce4-bbeb-5b9e75916e84" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318484/field-2/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b" :answer-field/choices ["q-318484/field-2/283bc09f1a097ae8400558511ca45f1013e17c797fdb7407be52694190fd744b"] :db/ensure [:answer-field/validate]} {:db/id "q-318484/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "d3be33a4-15c0-5442-811f-29b5037f65cb" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-318484/field-3" :answer-field/id #uuid "fc6d7b9b-862a-55ac-a6f7-6025a5d13a1e" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318484/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-318484/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-318484/field-4/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "203257e2-fdd8-5741-b440-92469566c318" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-318484/field-4" :answer-field/id #uuid "e8941a2d-a218-519d-9ae9-aadf324034b1" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318484/field-4/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-318484/field-4/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-318484" :question/id #uuid "e4a63de7-bef5-5957-9723-03592f88ae29" :question/math-academy-id "q-318484" :question/problem "If\n$A=[\\begin{aligned}5 \\\\ -2\\end{aligned}]$\nand\n$B=[\\begin{aligned}1 & -3\\end{aligned}],$\nfind $AB.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & ∗ \\\\ ∗ & ∗\\end{aligned}], &  & \\,5=5\\cdot 1 \\\\  & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & -15 \\\\ ∗ & ∗\\end{aligned}], &  & \\,-15=5\\cdot (-3) \\\\  & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & -15 \\\\ -2 & ∗\\end{aligned}], &  & \\,-2=-2\\cdot 1 \\\\  & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & -15 \\\\ -2 & 6\\end{aligned}], &  & \\,6=-2\\cdot (-3)\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}5 & -15 \\\\ -2 & 6\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318484/field-1" "q-318484/field-2" "q-318484/field-3" "q-318484/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd"] :knowledge-point/questions ["q-318484"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13635/selection/6012f3ab9252f09fe8577ae6fc619f0288e2fb83215db3f6567902f07520e82c" :answer/id #uuid "85be6d02-8a04-550c-aaac-073d769a8386" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/selection/e478f94b923f3a55d0e4690849c99ebd5ab5add5e47003eaae98b870873a5bd1" :answer/id #uuid "1a888825-78b2-540d-982a-9c24c232a0a2" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/selection/70c60cbcc383d7b4f4fc55615f7eded54e37a5f2f0977b3acf534d10f39e1628" :answer/id #uuid "61c02b9a-f5e1-56ec-afca-fb80e109623b" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/selection/d6f27b7c7939a102723fed67409856455f84c69bf3e5c2599003ca6bf26244df" :answer/id #uuid "a1d91f57-91a5-5213-9b84-4dafcb90ae3e" :answer/type :answer.type/text :answer/value "Undefined" :db/e