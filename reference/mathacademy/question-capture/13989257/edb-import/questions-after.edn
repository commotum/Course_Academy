db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283301}] :answer-field/correct {:answer/id #uuid "e8d1b563-c442-5f45-b5b2-cced9f2ef7d9" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283297} :answer-field/id #uuid "0bec1557-23b0-5d91-b1d1-736d872c20bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283296}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283302 :knowledge-point/_questions [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e5650c2-542d-5b20-a4f6-4f7bf6c8e53d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283304} {:answer/id #uuid "a669038b-5fec-5def-b14b-6854dc037ca2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283305}] :answer-field/correct {:answer/id #uuid "a669038b-5fec-5def-b14b-6854dc037ca2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283305} :answer-field/id #uuid "ed518687-df51-52d0-ad3b-5d581953d8d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283303} {:answer-field/choices [{:answer/id #uuid "c089cfce-2106-5b13-b52a-1d106cc19ea9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283307}] :answer-field/correct {:answer/id #uuid "c089cfce-2106-5b13-b52a-1d106cc19ea9" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283307} :answer-field/id #uuid "f5db28a6-a5ba-5e31-a756-a34c5e05b5a5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283306} {:answer-field/choices [{:answer/id #uuid "b679bcfe-9752-547c-b4b9-ef61aecc5c0d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283309}] :answer-field/correct {:answer/id #uuid "b679bcfe-9752-547c-b4b9-ef61aecc5c0d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283309} :answer-field/id #uuid "6bcbecde-179b-5901-832d-3413f0d5da8e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283308} {:answer-field/choices [{:answer/id #uuid "cc9feb4d-fd65-5271-80b5-71c4368a8487" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283311}] :answer-field/correct {:answer/id #uuid "cc9feb4d-fd65-5271-80b5-71c4368a8487" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283311} :answer-field/id #uuid "b30e51f9-2b0e-50df-83b6-4a9eb33850ca" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283310} {:answer-field/choices [{:answer/id #uuid "502f3675-bd96-5353-b4b4-079fe3c877b1" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186283313}] :answer-field/correct {:answer/id #uuid "502f3675-bd96-5353-b4b4-079fe3c877b1" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186283313} :answer-field/id #uuid "d7d80651-97ee-5f55-83e0-4da213bf7602" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283312}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2535d3d6-b76e-5122-a794-d24698d56e20" :question/math-academy-id "q-317844" :question/problem "Determine $AB$ given that \n$A=[\\begin{aligned}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{aligned}]$\nand\n$B=[\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}].$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | $9$ |  |  |\n|  | {{field-4}} | $14$ |  |  |\n|  | $5$ | {{field-5}} |  |  |" :question/worked-solution "Here, $A$ is a $4\\times 2$ matrix and $B$ is a $2\\times 2$ matrix. \n\nThere are $2$ columns in $A$ and $2$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{4\\times \\boxed{\\text{2}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{2}}\\times 2}={AB}_{4\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}]=[\\begin{aligned}2 & ∗ \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{aligned}], &  & \\,2=2\\cdot 1+1\\cdot 0 \\\\  & [\\begin{aligned}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{aligned}], &  & \\,-1=2\\cdot (-2)+1\\cdot 3 \\\\  & [\\begin{aligned}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ 0 & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{aligned}], &  & \\,0=0\\cdot 1+3\\cdot 0 \\\\  & [\\begin{aligned}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & ∗\\end{aligned}], &  & \\,-1=(-1)\\cdot 1+4\\cdot 0 \\\\  & [\\begin{aligned}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{aligned}], &  & \\,-4=5\\cdot (-2)+2\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186283314 :knowledge-point/_questions [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c7e99a4-9b8e-5710-be84-766d788f3006" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283316} {:answer/id #uuid "efe0fa16-8c3d-553c-930f-815069fb182e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186283317}] :answer-field/correct {:answer/id #uuid "efe0fa16-8c3d-553c-930f-815069fb182e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186283317} :answer-field/id #uuid "2c194782-2ac1-5534-90de-5f5972556169" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283315} {:answer-field/choices [{:answer/id #uuid "85dc7640-d9b9-574c-948c-670299246875" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186283319}] :answer-field/correct {:answer/id #uuid "85dc7640-d9b9-574c-948c-670299246875" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186283319} :answer-field/id #uuid "aec76f05-8abc-5194-9aff-2f115d18cf95" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283318}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e2a7e075-0019-57f4-9390-bb3bede7b976" :question/math-academy-id "q-317846" :question/problem "Determine $AB$ given that \n$A=[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{aligned}]$\nand\n$B=[\\begin{aligned}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{aligned}].$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $3$ |  |\n| --- | --- | --- | --- | --- |\n|  | $9$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{aligned}][\\begin{aligned}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{aligned}]=[\\begin{aligned}-3 & ∗ \\\\ ∗ & -8\\end{aligned}], &  & \\,-3=1\\cdot 2+2\\cdot (-1)+(-1)\\cdot 3 \\\\  & [\\begin{aligned}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{aligned}][\\begin{aligned}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{aligned}]=[\\begin{aligned}-3 & 3 \\\\ 9 & -8\\end{aligned}], &  & \\,-8=0\\cdot 1+3\\cdot 0+4\\cdot (-2)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=[\\begin{aligned}-3 & 3 \\\\ 9 & -8\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186283320 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef7e09e7-bd35-5d0c-950b-b8b1234c0b85" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186283322}] :answer-field/correct {:answer/id #uuid "ef7e09e7-bd35-5d0c-950b-b8b1234c0b85" :answer/type {:db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186283322} :answer-field/id #uuid "fd2fc7c8-7a4f-5752-93e2-06204b06b873" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283321}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ba6916f1-99b8-5754-9682-e418e10204b2" :question/math-academy-id "q-318463" :question/problem "Let $X=YZ.$ What is the value of ${x}_{12}$, if\n\n$$\nY=[\\begin{aligned}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{aligned}],\\,Z=[\\begin{aligned}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{aligned}]?\n$$\n\n${x}_{12}=$\n{{field-1}}" :question/worked-solution "Multiplying the $1$st row in $Y$ by the $2$nd column in $Z$, we get\n\n$$\n\\begin{aligned}{x}_{12} & =[\\begin{aligned}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{aligned}][\\begin{aligned}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 & 0\\end{aligned}][\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =(-2)(5)+3(-3)+0(1) \\\\  & =-10-9+0 \\\\  & =-19.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283323 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bacd2228-7433-5726-b5ea-38097a830220" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283325} {:answer/id #uuid "d53e00d3-9cf9-5d55-bc83-56bb05b63524" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283326}] :answer-field/correct {:answer/id #uuid "bacd2228-7433-5726-b5ea-38097a830220" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283325} :answer-field/id #uuid "b67fe4c9-4147-5040-9499-5c5ea8d68f51" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283324}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7688075-479d-5b00-99aa-a2868922307b" :question/math-academy-id "q-318470" :question/problem "Let $Z=XY.$ What is the value of ${z}_{24}$, if\n\n$$\nX=[\\begin{aligned}1 & -1 \\\\ 3 & 2\\end{aligned}],\\,Y=[\\begin{aligned}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{aligned}]?\n$$\n\n${z}_{24}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $X$ by the $4$th column in $Y,$ we get\n\n$$\n\\begin{aligned}{z}_{24} & =[\\begin{aligned}1 & -1 \\\\ 3 & 2\\end{aligned}][\\begin{aligned}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2\\end{aligned}][\\begin{aligned}-3 \\\\ 2\\end{aligned}] \\\\  & =3(-3)+2(2) \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283327 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10ec9bd6-c0d3-5018-bf4c-0e31b2365921" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283329}] :answer-field/correct {:answer/id #uuid "10ec9bd6-c0d3-5018-bf4c-0e31b2365921" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283329} :answer-field/id #uuid "ee398905-8bfd-501b-9a47-f0aa2ae090fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283328} {:answer-field/choices [{:answer/id #uuid "a316cb83-7abe-58c3-8cbd-4b1ff9fc9b00" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186283331}] :answer-field/correct {:answer/id #uuid "a316cb83-7abe-58c3-8cbd-4b1ff9fc9b00" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186283331} :answer-field/id #uuid "5f135a9a-ccff-5ce4-bbeb-5b9e75916e84" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283330} {:answer-field/choices [{:answer/id #uuid "d3be33a4-15c0-5442-811f-29b5037f65cb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283333}] :answer-field/correct {:answer/id #uuid "d3be33a4-15c0-5442-811f-29b5037f65cb" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283333} :answer-field/id #uuid "fc6d7b9b-862a-55ac-a6f7-6025a5d13a1e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283332} {:answer-field/choices [{:answer/id #uuid "203257e2-fdd8-5741-b440-92469566c318" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186283335}] :answer-field/correct {:answer/id #uuid "203257e2-fdd8-5741-b440-92469566c318" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186283335} :answer-field/id #uuid "e8941a2d-a218-519d-9ae9-aadf324034b1" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283334}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e4a63de7-bef5-5957-9723-03592f88ae29" :question/math-academy-id "q-318484" :question/problem "If\n$A=[\\begin{aligned}5 \\\\ -2\\end{aligned}]$\nand\n$B=[\\begin{aligned}1 & -3\\end{aligned}],$\nfind $AB.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | {{field-4}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & ∗ \\\\ ∗ & ∗\\end{aligned}], &  & \\,5=5\\cdot 1 \\\\  & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & -15 \\\\ ∗ & ∗\\end{aligned}], &  & \\,-15=5\\cdot (-3) \\\\  & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & -15 \\\\ -2 & ∗\\end{aligned}], &  & \\,-2=-2\\cdot 1 \\\\  & [\\begin{aligned}5 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -3\\end{aligned}]=[\\begin{aligned}5 & -15 \\\\ -2 & 6\\end{aligned}], &  & \\,6=-2\\cdot (-3)\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}5 & -15 \\\\ -2 & 6\\end{aligned}].$"}] [{:db/id #edb/ref 17592186283336 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f71e8438-7b66-5ee9-9960-c52f6fb4a722" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283338} {:answer/id #uuid "5aa7fe23-1c1a-57ee-a069-9b90047237dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283339}] :answer-field/correct {:answer/id #uuid "5aa7fe23-1c1a-57ee-a069-9b90047237dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283339} :answer-field/id #uuid "aac5319b-7437-5a46-af43-dbf1e66e6e6b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283337} {:answer-field/choices [{:answer/id #uuid "645735a2-6aa9-5671-8f9c-a4d15c050a1c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283341}] :answer-field/correct {:answer/id #uuid "645735a2-6aa9-5671-8f9c-a4d15c050a1c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186283341} :answer-field/id #uuid "a6454714-65d1-5eb3-9485-9233a6a78b12" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283340} {:answer-field/choices [{:answer/id #uuid "f625ba90-0b1a-5222-b777-0f611c3e831d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186283343}] :answer-field/correct {:answer/id #uuid "f625ba90-0b1a-5222-b777-0f611c3e831d" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186283343} :answer-field/id #uuid "16ecfeab-f9e7-5e3f-be0d-d22b80b9da07" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283342} {:answer-field/choices [{:answer/id #uuid "d27dbca7-2eee-5c12-a566-a40e39e483dc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186283345}] :answer-field/correct {:answer/id #uuid "d27dbca7-2eee-5c12-a566-a40e39e483dc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186283345} :answer-field/id #uuid "6b0f6d7f-611e-5c41-ad6d-d89dad4c16be" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283344} {:answer-field/choices [{:answer/id #uuid "f48ec67b-9c0d-5a69-bcc0-5ede2f4f41dd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283347}] :answer-field/correct {:answer/id #uuid "f48ec67b-9c0d-5a69-bcc0-5ede2f4f41dd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283347} :answer-field/id #uuid "b0906e31-0d7f-57d3-b92d-29fec1c334c8" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283346} {:answer-field/choices [{:answer/id #uuid "a37e8408-8f36-5071-8935-de1d182fd165" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283349}] :answer-field/correct {:answer/id #uuid "a37e8408-8f36-5071-8935-de1d182fd165" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283349} :answer-field/id #uuid "8cfa06f7-424a-5f02-a4e3-f32bdf6c510c" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283348}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0e4136d9-63e3-539d-801e-572ec0b5e903" :question/math-academy-id "q-318588" :question/problem "Find $PQ,$ if\n$P=[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}]$\nand\n$Q=[\\begin{aligned}-4 & 2\\end{aligned}].$\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $PQ=\\,\\,$ |  | {{field-3}} | {{field-4}} |  |\n|  |  | {{field-5}} | {{field-6}} |  |" :question/worked-solution "Here, $P$ is a $3\\times 1$ matrix and $Q$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $P$ and $1$ row in matrix $Q$, so the product is well defined:\n\n$$\n{P}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{Q}_{\\boxed{\\text{1}}\\times 2}={PQ}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}PQ & =[\\begin{aligned}0 \\\\ 3 \\\\ -1\\end{aligned}][\\begin{aligned}-4 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot (-4) & 0\\cdot 2 \\\\ 3\\cdot (-4) & 3\\cdot 2 \\\\ (-1)\\cdot (-4) & (-1)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -12 & 6 \\\\ 4 & -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283350 :knowledge-point/_questions [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9661527f-2823-57bb-ba7b-5c7c88d3729f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & -1\\end{aligned}]" :db/id #edb/ref 17592186283352} {:answer/id #uuid "2fb1492d-d3c3-5db6-8e9b-42c0669b7aae" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -7\\end{aligned}]" :db/id #edb/ref 17592186283353} {:answer/id #uuid "b9647b5e-485c-5afb-b457-ea6c6efe884b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-10 & -14\\end{aligned}]" :db/id #edb/ref 17592186283354} {:answer/id #uuid "e47e46ab-aad9-508d-85e3-cce336c70a8e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 14\\end{aligned}]" :db/id #edb/ref 17592186283355} {:answer/id #uuid "d82e61cb-2184-5315-8827-26b43780e0a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 14\\end{aligned}]" :db/id #edb/ref 17592186283356}] :answer-field/correct {:answer/id #uuid "b9647b5e-485c-5afb-b457-ea6c6efe884b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-10 & -14\\end{aligned}]" :db/id #edb/ref 17592186283354} :answer-field/id #uuid "56fa426d-2fdc-53f5-ad33-dffef3cf4897" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283351}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "48f24fe6-6f1d-5081-97d6-a72dc93df94e" :question/math-academy-id "q-70928" :question/problem "Find $BC$,  if  $B=[\\begin{aligned}-3 & 1 & -2\\end{aligned}]$ and $C=[\\begin{aligned}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{aligned}].$" :question/worked-solution "Here, $B$ is a $1\\times 3$ matrix and $C$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $B$ and $3$ rows in $C,$ so $B$ and $C$ are conformable for multiplication:\n\n$$\n{B}_{1\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{C}_{\\boxed{\\text{3}}\\times 2}={BC}_{1\\times 2}\n$$\n\nLet's compute $BC,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-3 & 1 & -2\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{aligned}]=[\\begin{aligned}-10 & ∗\\end{aligned}], &  & \\,-10=(-3)\\cdot 1+1\\cdot 3+(-2)\\cdot 5 \\\\  & [\\begin{aligned}-3 & 1 & -2\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{aligned}]=[\\begin{aligned}-10 & -14\\end{aligned}], &  & \\,-14=(-3)\\cdot 2+1\\cdot 4+(-2)\\cdot 6\\end{aligned}\n$$\n\nTherefore, \n$BC=[\\begin{aligned}-10 & -14\\end{aligned}].$"}] [{:db/id #edb/ref 17592186283357 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5e2132a-08f4-5a85-9826-e8573ba6ebd0" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186283359} {:answer/id #uuid "526c7214-bc7a-51ce-a330-b7f14b669197" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186283360} {:answer/id #uuid "d90ddf48-867e-5527-877f-553afd0a140a" :answer/type {:db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186283361} {:answer/id #uuid "8331e26c-76bd-5ab2-9bc5-ac77fc2e9a87" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186283362} {:answer/id #uuid "06cde687-b2f6-510a-be46-9df7ef2bc7ee" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186283363}] :answer-field/correct {:answer/id #uuid "06cde687-b2f6-510a-be46-9df7ef2bc7ee" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186283363} :answer-field/id #uuid "e37e6b5e-f4ad-5fe5-9aa0-abd26265352b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283358}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "de76825b-608b-5194-a756-ae41764179ac" :question/math-academy-id "q-70956" :question/problem "Let $T=UV.$ What is the value of ${t}_{41}$, if\n\n$$\nU=[\\begin{aligned}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{aligned}],\\,V=[\\begin{aligned}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $4$th row of $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{41} & =[\\begin{aligned}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{aligned}][\\begin{aligned}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & 3 & 10\\end{aligned}][\\begin{aligned}-2 \\\\ -1 \\\\ -1\\end{aligned}] \\\\  & =(-5)\\cdot (-2)+3\\cdot (-1)+10\\cdot (-1) \\\\  & =10-3-10 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186283364 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1eee90b-0967-5c59-b898-c5276345fe03" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283366} {:answer/id #uuid "8f19b515-b9ba-556b-8c5a-9ec549c77b0c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283367} {:answer/id #uuid "a99dd6d0-db50-500b-8888-84eae4de2632" :answer/type {:db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186283368} {:answer/id #uuid "90904376-264a-551a-b4a6-79f7e7767316" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186283369} {:answer/id #uuid "c49828d0-fafe-5874-834b-d246716e35fd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186283370}] :answer-field/correct {:answer/id #uuid "8f19b515-b9ba-556b-8c5a-9ec549c77b0c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283367} :answer-field/id #uuid "de4f2e34-3d70-5995-a7b8-53cfec6516c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283365}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "36284545-f8c7-5bb9-b2ed-e28ffa722bed" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n$$\nP=[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}],\\,Q=[\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}][\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -4\\end{aligned}][\\begin{aligned}10 \\\\ 7\\end{aligned}] \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}]}
