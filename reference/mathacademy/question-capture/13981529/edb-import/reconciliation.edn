1c7bd02"} {"question" "q-115310" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/activity-metadata.json" "file_sha256" "62dce0bec929801edebfbbf1fe08dc7eb7131a05544044744aa1ad1420d64268"} {"question" "q-115310" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-115310" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,-4)"] ["math" "(0,2)"] ["math" "(0,4)"] ["math" "(3,5)"] ["math" "(4,0)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-115310" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(0,-4)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278347" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/assets/89914bff0203020e476acedc399cfdcc4a546bac9ee747f01951019e8d85c85d.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278347" "field" nil "attribute" "question/worked-solution" "value" "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(2,-3),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-2)^{2}}{{3}^{2}}+\\frac{(y-(-3))^{2}}{{6}^{2}} & =1 \\\\ \\frac{(x-2)^{2}}{9}+\\frac{(y+3)^{2}}{36} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278347" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/activity-metadata.json" "file_sha256" "62dce0bec929801edebfbbf1fe08dc7eb7131a05544044744aa1ad1420d64268"} {"question" "q-278347" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278347" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{(x-2)^2}{9}+\\frac{(y+3)^2}{36}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278401" "field" nil "attribute" "question/problem" "value" "For the ellipse $\\frac{(x-6)^{2}}{49}+\\frac{(y+5)^{2}}{7}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278401" "field" nil "attribute" "question/worked-solution" "value" "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=6$ and $k=-5,$ so the center is located at $(6,-5).$\n\nIn the given equation, we also have ${a}^{2}=49$ and ${b}^{2}=7.$\n\n- Since ${a}^{2}=49,$ the length of the horizontal radius must be $a=\\sqrt{49}=7.$\n\n- Since ${b}^{2}=7,$ the length of the vertical radius must be $b=\\sqrt{7}.$\n\nSo the semi-major axis has length $a=7,$ and the semi-minor axis has length $b=\\sqrt{7}.$\n\nTherefore, the major axis has length $2a=2\\cdot 7=14,$ and the minor axis has length $2b=2\\cdot \\sqrt{7}=2\\sqrt{7}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278401" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/activity-metadata.json" "file_sha256" "62dce0bec929801edebfbbf1fe08dc7eb7131a05544044744aa1ad1420d64268"} {"question" "q-278401" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278401" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "14"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278401" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278401" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\sqrt{7}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278404" "field" nil "attribute" "question/problem" "value" "For the ellipse $\\frac{(x-3)^{2}}{8}+\\frac{(y+8)^{2}}{81}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278404" "field" nil "attribute" "question/worked-solution" "value" "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=3$ and $k=-8,$ so the center is located at $(3,-8).$\n\nIn the given equation, we also have ${a}^{2}=8$ and ${b}^{2}=81.$\n\n- Since ${a}^{2}=8,$ the length of the horizontal radius must be $a=\\sqrt{8}=2\\sqrt{2}.$\n\n- Since ${b}^{2}=81,$ the length of the vertical radius must be $b=\\sqrt{81}=9.$\n\nSo the semi-major axis has length $b=9,$ and the semi-minor axis has length $a=2\\sqrt{2}.$\n\nTherefore, the major axis has length $2b=2\\cdot 9=18,$ and the minor axis has length $2a=2\\cdot 2\\sqrt{2}=4\\sqrt{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278404" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/activity-metadata.json" "file_sha256" "62dce0bec929801edebfbbf1fe08dc7eb7131a05544044744aa1ad1420d64268"} {"question" "q-278404" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278404" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "18"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278404" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13981529/state.json" "file_sha256" "de57df74a651f102eb34cbe3f7b5e06101e984d60d76a630d1184870a1c7bd02"} {"question" "q-278404" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "4