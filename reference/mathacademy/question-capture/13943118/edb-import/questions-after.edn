#{[{:db/id #edb/ref 17592186250626 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "578b5719-0cac-5261-a927-7d4e10f39141" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186250628} {:answer/id #uuid "4a27c8ce-7896-529a-94ce-b4ecc3a15302" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186250629} {:answer/id #uuid "b52e8744-54f9-5ff3-86c1-455fcd4db1d7" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186250630} {:answer/id #uuid "dd66e824-ede1-5352-a635-86372541d76d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186250631} {:answer/id #uuid "ef119395-e0b3-5ba8-93f6-995c3da1f6cc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186250632}] :answer-field/correct {:answer/id #uuid "578b5719-0cac-5261-a927-7d4e10f39141" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186250628} :answer-field/id #uuid "0f5a2264-cb7f-53b9-9781-3b162d6a86ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250627}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b47ace4f-daa7-598e-bbed-f1675b554697" :question/math-academy-id "q-103546" :question/problem "The equation of the normal line to the curve $y=\\frac{4}{\\sqrt{x}}$ at the point $(1,4)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $q-p.$" :question/worked-solution "Let $f(x)=\\frac{4}{\\sqrt{x}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4{x}^{-1/2}) \\\\  & =-2{x}^{-3/2} \\\\  & =-\\frac{2}{\\sqrt{{x}^{3}}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,4):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=-\\frac{2}{\\sqrt{{1}^{3}}}=-2\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-4 & =\\frac{1}{2}(x-1) \\\\ 2y-8 & =x-1 \\\\ x-2y & =-7.\\end{aligned}\n$$\n\nTherefore, $q-p=-7-(-2)=-5.$"}] [{:db/id #edb/ref 17592186092454 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83e24f9c-c65c-55da-99f4-a4e7ba2009ad" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, 0)" :db/id #edb/ref 17592186089161} {:answer/id #uuid "a7b1dc3e-2662-57cc-833f-abd0301b68df" :answer/type {:db/ident :answer.type/math} :answer/value "(5, 0)" :db/id #edb/ref 17592186089162} {:answer/id #uuid "cb76aa8c-fb2a-59fd-842c-a89237c40b7a" :answer/type {:db/ident :answer.type/math} :answer/value "(1, 0)" :db/id #edb/ref 17592186089163} {:answer/id #uuid "d1ab546f-de04-5b6f-bffc-7ca9ddc3a9fc" :answer/type {:db/ident :answer.type/math} :answer/value "(16, 0)" :db/id #edb/ref 17592186089164} {:answer/id #uuid "4a5aa77b-2291-5860-9b0f-977826961ddc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{16}{5}, 0)" :db/id #edb/ref 17592186089165}] :answer-field/correct {:answer/id #uuid "d1ab546f-de04-5b6f-bffc-7ca9ddc3a9fc" :answer/type {:db/ident :answer.type/math} :answer/value "(16, 0)" :db/id #edb/ref 17592186089164} :answer-field/id #uuid "e1b2fe96-dfed-50aa-ba1e-81833b4f5b7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089160}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a8debb9f-1a0f-5757-8884-2cca273ae3ea" :question/math-academy-id "q-10871" :question/problem "Find where the normal line to the curve $f(x) = 2x^{2} + x$ at the point $(1, 3)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=4(1)+1=5,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-\\frac{1}{5}(x-1) \\\\ y & =-\\frac{1}{5}x+\\frac{1}{5}+3 \\\\ y & =-\\frac{1}{5}x+\\frac{16}{5}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+\\frac{16}{5} & =0 \\\\ x & =16.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(16,0).$"}] [{:db/id #edb/ref 17592186250633 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c62c4e05-1829-5405-9851-68156c959f02" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186250635}] :answer-field/correct {:answer/id #uuid "c62c4e05-1829-5405-9851-68156c959f02" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186250635} :answer-field/id #uuid "dc778d3b-c76e-5b55-9f39-91e81a4665e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186250634} {:answer-field/choices [{:answer/id #uuid "1c768d91-fad4-581e-85b7-08bc025ad0db" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250637}] :answer-field/correct {:answer/id #uuid "1c768d91-fad4-581e-85b7-08bc025ad0db" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186250637} :answer-field/id #uuid "4534d582-f3a2-5fbf-9714-ac9aa89ce12a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186250636}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f216eb4b-9d53-5b6d-b67a-8fb8e17cde01" :question/math-academy-id "q-308823" :question/problem "Find where the normal line to the curve $y=\\frac{2}{x}+1$ at the point $(1,3)$ intersects the $x$-axis.\n\nThe normal line intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1}+1) \\\\  & =-2{x}^{-2} \\\\  & =-\\frac{2}{{x}^{2}}.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=-\\frac{2}{(1)^{2}}=-2,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{2}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =\\frac{1}{2}(x-1) \\\\ y & =\\frac{1}{2}x-\\frac{1}{2}+3 \\\\ y & =\\frac{1}{2}x+\\frac{5}{2}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}\\frac{1}{2}x+\\frac{5}{2} & =0 \\\\ x & =-5.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the  $x$-axis at $(\\,-5,0\\,).$"}] [{:db/id #edb/ref 17592186250638 :knowledge-point/_questions [{:knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "755785d3-b212-5cf0-92cd-6a1e0b14657a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186250640}] :answer-field/correct {:answer/id #uuid "755785d3-b212-5cf0-92cd-6a1e0b14657a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186250640} :answer-field/id #uuid "d748d196-19c3-5676-b153-1d4c82fecd7f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186250639}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ef7987ad-e618-5dff-80f2-97375df03f78" :question/math-academy-id "q-342153" :question/problem "Find the slope ${m}^{′}$ of the normal line to the curve $y=4-\\frac{1}{\\sqrt{x}}$ at the point $(\\frac{1}{4},2).$\n\n${m}^{′}=$\n{{field-1}}" :question/worked-solution "Let $f(x)=4-\\frac{1}{\\sqrt{x}}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4-\\frac{1}{\\sqrt{x}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4-{x}^{-1/2}) \\\\  & =\\frac{1}{2\\sqrt{{x}^{3}}}.\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(\\frac{1}{4},2):$\n\n$$\nm={f}^{′}(\\frac{1}{4})=\\frac{1}{2\\sqrt{{x}^{3}}}=\\frac{1}{2\\sqrt{{(\\frac{1}{4})}^{3}}}=4\n$$\n\nTherefore, the slope ${m}^{′}$ of the normal line is\n\n$$\n\\begin{aligned}{m}^{′} & =-\\frac{1}{m} \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092671 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a097c753-f836-5a6b-a527-317661fc1d5e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186090492} {:answer/id #uuid "aebdad9e-ba98-5286-8810-a1eb4a14a2bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186090493} {:answer/id #uuid "b4e069c7-e356-5901-9a83-c7e933cc75a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186090494} {:answer/id #uuid "1e107438-ef41-5146-8a66-b3e1eacbc557" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186090495} {:answer/id #uuid "6f2e3fbd-e358-55f3-9c0b-816eab9b984d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186090496}] :answer-field/correct {:answer/id #uuid "6f2e3fbd-e358-55f3-9c0b-816eab9b984d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186090496} :answer-field/id #uuid "43bf228f-55b5-59bb-915b-217e7293ecb5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090491}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e1cac491-67f0-58ca-a542-a3096fac9ba0" :question/math-academy-id "q-47408" :question/problem "The equation of the normal line to the curve $y = 2x^{5} - 2x$ at the point $(1, 0)$ is given by $y = ax + b$ where $a$ and $b$ are constants. Find the value of $a + b$." :question/worked-solution "Let $f(x)=2{x}^{5}-2x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{5}-2x)=10{x}^{4}-2\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,0):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=10(1)^{4}-2=8\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{8}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-0 & =-\\frac{1}{8}(x-1) \\\\ y & =-\\frac{x}{8}+\\frac{1}{8}.\\end{aligned}\n$$\n\nTherefore, $a+b=-\\frac{1}{8}+\\frac{1}{8}=0.$"}]}
