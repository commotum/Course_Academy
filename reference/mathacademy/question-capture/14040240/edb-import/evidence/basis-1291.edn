#{[{:db/id #edb/ref 17592186298248 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a5c361-764b-5a8c-b304-f1074da136cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}" :db/id #edb/ref 17592186298250} {:answer/id #uuid "510fda73-d45a-52f1-95b0-533e0f771ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+2" :db/id #edb/ref 17592186298251}] :answer-field/correct {:answer/id #uuid "510fda73-d45a-52f1-95b0-533e0f771ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+2" :db/id #edb/ref 17592186298251} :answer-field/id #uuid "4bae2bb8-441a-5bb0-b5ae-2f2f77731b65" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298249}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6fa56455-2957-58d5-9aaf-f51a06829b5e" :question/math-academy-id "q-336419" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=4\\operatorname{ln}⁡(t+1)+2t.$ Calculate the acceleration $a$ of the particle at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{ln}⁡(t+1)+2t) \\\\  & =\\frac{4}{t+1}+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298260 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9c17885-ee45-59e2-bd38-5545d454b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{(t+2)^3}+2" :db/id #edb/ref 17592186298262}] :answer-field/correct {:answer/id #uuid "d9c17885-ee45-59e2-bd38-5545d454b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{(t+2)^3}+2" :db/id #edb/ref 17592186298262} :answer-field/id #uuid "d5004db6-2a35-593c-b421-2d03983feea5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298261}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f26bf09d-4986-5db0-9fae-1c5b376ec0ef" :question/math-academy-id "q-336455" :question/problem "The displacement $s$ of a particle moving in a straight line is given by $s(t)={t}^{2}+\\frac{6}{t+2}.$ Find the particle's acceleration at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+\\frac{6}{t+2}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+6(t+2)^{-1}) \\\\  & =2t-6(t+2)^{-2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t-6(t+2)^{-2}) \\\\  & =2+12(t+2)^{-3} \\\\  & =2+\\frac{12}{(t+2)^{3}}\\end{aligned}\n$$"}]}
