#{[{:db/id #edb/ref 17592186307787 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b6eb685-f300-563d-b995-80e59924671e" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=-\\frac{3}{t}-3{t}^{2}-4t" :db/id #edb/ref 17592186307789} {:answer/id #uuid "02beb33f-686f-540b-a726-c8823b5be421" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=\\frac{t}{3}+3{t}^{2}-4t" :db/id #edb/ref 17592186307790} {:answer/id #uuid "e8676c5d-2032-5ac2-a8bb-5244473f8a3b" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=\\frac{3}{t}+3{t}^{2}-4{t}^{2}" :db/id #edb/ref 17592186307791} {:answer/id #uuid "4d73be20-ee57-5d49-9378-8ef0238d6e20" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=\\frac{3}{t}+3{t}^{2}-4t" :db/id #edb/ref 17592186307792} {:answer/id #uuid "d0349a1e-6759-5ff4-8e8e-cfa4d132ed45" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=-\\frac{3}{t}+3{t}^{2}-4t" :db/id #edb/ref 17592186307793}] :answer-field/correct {:answer/id #uuid "4d73be20-ee57-5d49-9378-8ef0238d6e20" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=\\frac{3}{t}+3{t}^{2}-4t" :db/id #edb/ref 17592186307792} :answer-field/id #uuid "85abf288-e1ac-5204-aa83-51a745ebe7e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307788}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2451f973-c438-50a3-8e95-d4ca2e6ec6dd" :question/math-academy-id "q-19444" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=3\\operatorname{ln}⁡t+{t}^{3}-2{t}^{2}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{ln}⁡t+{t}^{3}-2{t}^{2}) \\\\  & =\\frac{3}{t}+3{t}^{2}-4t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298248 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a5c361-764b-5a8c-b304-f1074da136cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}" :db/id #edb/ref 17592186298250} {:answer/id #uuid "510fda73-d45a-52f1-95b0-533e0f771ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+2" :db/id #edb/ref 17592186298251} {:answer/id #uuid "0fa957b6-7b68-595d-894b-f3f1d8a05d7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+1" :db/id #edb/ref 17592186307794}] :answer-field/correct {:answer/id #uuid "510fda73-d45a-52f1-95b0-533e0f771ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+2" :db/id #edb/ref 17592186298251} :answer-field/id #uuid "4bae2bb8-441a-5bb0-b5ae-2f2f77731b65" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298249}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6fa56455-2957-58d5-9aaf-f51a06829b5e" :question/math-academy-id "q-336419" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=4\\operatorname{ln}⁡(t+1)+2t.$ Calculate the acceleration $a$ of the particle at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{ln}⁡(t+1)+2t) \\\\  & =\\frac{4}{t+1}+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307795 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c216ec45-7fe9-59da-9ff7-2f9c4043d161" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186307797}] :answer-field/correct {:answer/id #uuid "c216ec45-7fe9-59da-9ff7-2f9c4043d161" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186307797} :answer-field/id #uuid "bc6119cc-e595-5bdf-ade2-9268cc8acf1a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186307796}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b8da6936-d2e9-599f-99a3-2423543a5e86" :question/math-academy-id "q-336429" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)={t}^{3}-3{t}^{2}+2t+1.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $2\\,{\\text{m/s}}^{2}$ and $t>0.$\n\nWhen $a=2\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2}+2t+1) \\\\  & =3{t}^{2}-6t+2\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=2,$ we substitute this into the above:\n\n$$\n\\begin{aligned}2 & =3{t}^{2}-6t+2 \\\\ 0 & =3{t}^{2}-6t \\\\ 3t(t-2) & =0 \\\\ t & =0,2\\end{aligned}\n$$\n\nThus, $t=2$ since $t>0.$\n\nThen, to calculate the velocity at time $t=2,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(2) & =(2)^{3}-3(2)^{2}+2(2)+1 \\\\  & =8-12+4+1 \\\\  & =1\\,\\text{m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=2\\,{\\text{m/s}}^{2}$ is $v=1\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186298260 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9c17885-ee45-59e2-bd38-5545d454b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{(t+2)^3}+2" :db/id #edb/ref 17592186298262}] :answer-field/correct {:answer/id #uuid "d9c17885-ee45-59e2-bd38-5545d454b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{(t+2)^3}+2" :db/id #edb/ref 17592186298262} :answer-field/id #uuid "d5004db6-2a35-593c-b421-2d03983feea5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298261}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f26bf09d-4986-5db0-9fae-1c5b376ec0ef" :question/math-academy-id "q-336455" :question/problem "The displacement $s$ of a particle moving in a straight line is given by $s(t)={t}^{2}+\\frac{6}{t+2}.$ Find the particle's acceleration at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+\\frac{6}{t+2}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+6(t+2)^{-1}) \\\\  & =2t-6(t+2)^{-2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t-6(t+2)^{-2}) \\\\  & =2+12(t+2)^{-3} \\\\  & =2+\\frac{12}{(t+2)^{3}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307798 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c84f1ea-f0ec-524f-8b6d-5009fe054050" :answer/type {:db/ident :answer.type/math} :answer/value "8{\\text{ cm/s}}^{2}" :db/id #edb/ref 17592186307800} {:answer/id #uuid "1fd56605-f978-56b1-a106-d5d880aa7952" :answer/type {:db/ident :answer.type/math} :answer/value "15{\\text{ cm/s}}^{2}" :db/id #edb/ref 17592186307801} {:answer/id #uuid "fac8dbb8-7dd8-5bc3-bce3-6df85078b94c" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\text{ cm/s}}^{2}" :db/id #edb/ref 17592186307802} {:answer/id #uuid "bc8137f2-ff77-5503-ae2a-7d7508feac23" :answer/type {:db/ident :answer.type/math} :answer/value "10{\\text{ cm/s}}^{2}" :db/id #edb/ref 17592186307803} {:answer/id #uuid "aeb66576-58ed-5ac1-b137-bf39d522cf84" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\text{ cm/s}}^{2}" :db/id #edb/ref 17592186307804}] :answer-field/correct {:answer/id #uuid "fac8dbb8-7dd8-5bc3-bce3-6df85078b94c" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\text{ cm/s}}^{2}" :db/id #edb/ref 17592186307802} :answer-field/id #uuid "b288532e-19ad-52c6-83a6-df021d713976" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307799}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3288674d-b4a5-55ff-8fac-98e0dfe5f073" :question/math-academy-id "q-4772" :question/problem "The displacement (in centimeters) of an ant moving in a straight line is given by $s(t)={t}^{2}+3t,$ where $t$ is measured in seconds.\nFind the ant's acceleration at $t=10$ seconds." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+3t) \\\\  & =2t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+3) \\\\  & =2\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=10,$ we substitute this into the above:\n\n$$\na(10)=2\\,{\\text{m/s}}^{2}\n$$\n\nTherefore, the acceleration when $t=10$ seconds is $2\\,{\\text{m/s}}^{2}.$"}]}
