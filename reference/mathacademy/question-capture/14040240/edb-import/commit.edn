2186045453 13194139534754 true] [17592186307789 1111 #uuid "9b6eb685-f300-563d-b995-80e59924671e" 13194139534754 true] [17592186307790 1034 "a(t)=\\frac{t}{3}+3{t}^{2}-4t" 13194139534754 true] [17592186307790 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307790 1111 #uuid "02beb33f-686f-540b-a726-c8823b5be421" 13194139534754 true] [17592186307791 1034 "a(t)=\\frac{3}{t}+3{t}^{2}-4{t}^{2}" 13194139534754 true] [17592186307791 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307791 1111 #uuid "e8676c5d-2032-5ac2-a8bb-5244473f8a3b" 13194139534754 true] [17592186307792 1034 "a(t)=\\frac{3}{t}+3{t}^{2}-4t" 13194139534754 true] [17592186307792 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307792 1111 #uuid "4d73be20-ee57-5d49-9378-8ef0238d6e20" 13194139534754 true] [17592186307793 1034 "a(t)=-\\frac{3}{t}+3{t}^{2}-4t" 13194139534754 true] [17592186307793 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307793 1111 #uuid "d0349a1e-6759-5ff4-8e8e-cfa4d132ed45" 13194139534754 true] [17592186307794 1034 "\\frac{4}{t+1}+1" 13194139534754 true] [17592186307794 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307794 1111 #uuid "0fa957b6-7b68-595d-894b-f3f1d8a05d7b" 13194139534754 true] [17592186307795 1017 #edb/ref 17592186307796 13194139534754 true] [17592186307795 1089 "q-336429" 13194139534754 true] [17592186307795 1091 #edb/ref 17592186045464 13194139534754 true] [17592186307795 1100 "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)={t}^{3}-3{t}^{2}+2t+1.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $2\\,{\\text{m/s}}^{2}$ and $t>0.$\n\nWhen $a=2\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" 13194139534754 true] [17592186307795 1113 #uuid "b8da6936-d2e9-599f-99a3-2423543a5e86" 13194139534754 true] [17592186307795 1145 "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2}+2t+1) \\\\  & =3{t}^{2}-6t+2\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=2,$ we substitute this into the above:\n\n$$\n\\begin{aligned}2 & =3{t}^{2}-6t+2 \\\\ 0 & =3{t}^{2}-6t \\\\ 3t(t-2) & =0 \\\\ t & =0,2\\end{aligned}\n$$\n\nThus, $t=2$ since $t>0.$\n\nThen, to calculate the velocity at time $t=2,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(2) & =(2)^{3}-3(2)^{2}+2(2)+1 \\\\  & =8-12+4+1 \\\\  & =1\\,\\text{m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=2\\,{\\text{m/s}}^{2}$ is $v=1\\,\\text{m/s}.$" 13194139534754 true] [17592186307796 1000 #edb/ref 17592186307797 13194139534754 true] [17592186307796 1040 #edb/ref 17592186045449 13194139534754 true] [17592186307796 1041 "field-1" 13194139534754 true] [17592186307796 1104 #edb/ref 17592186307797 13194139534754 true] [17592186307796 1110 #uuid "bc6119cc-e595-5bdf-ade2-9268cc8acf1a" 13194139534754 true] [17592186307797 1034 "1" 13194139534754 true] [17592186307797 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307797 1111 #uuid "c216ec45-7fe9-59da-9ff7-2f9c4043d161" 13194139534754 true] [17592186307798 1017 #edb/ref 17592186307799 13194139534754 true] [17592186307798 1089 "q-4772" 13194139534754 true] [17592186307798 1091 #edb/ref 17592186045463 13194139534754 true] [17592186307798 1100 "The displacement (in centimeters) of an ant moving in a straight line is given by $s(t)={t}^{2}+3t,$ where $t$ is measured in seconds.\nFind the ant's acceleration at $t=10$ seconds." 13194139534754 true] [17592186307798 1113 #uuid "3288674d-b4a5-55ff-8fac-98e0dfe5f073" 13194139534754 true] [17592186307798 1145 "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+3t) \\\\  & =2t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+3) \\\\  & =2\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=10,$ we substitute this into the above:\n\n$$\na(10)=2\\,{\\text{m/s}}^{2}\n$$\n\nTherefore, the acceleration when $t=10$ seconds is $2\\,{\\text{m/s}}^{2}.$" 13194139534754 true] [17592186307799 1000 #edb/ref 17592186307800 13194139534754 true] [17592186307799 1000 #edb/ref 17592186307801 13194139534754 true] [17592186307799 1000 #edb/ref 17592186307802 13194139534754 true] [17592186307799 1000 #edb/ref 17592186307803 13194139534754 true] [17592186307799 1000 #edb/ref 17592186307804 13194139534754 true] [17592186307799 1040 #edb/ref 17592186045450 13194139534754 true] [17592186307799 1041 "selection" 13194139534754 true] [17592186307799 1104 #edb/ref 17592186307802 13194139534754 true] [17592186307799 1110 #uuid "b288532e-19ad-52c6-83a6-df021d713976" 13194139534754 true] [17592186307800 1034 "8{\\text{ cm/s}}^{2}" 13194139534754 true] [17592186307800 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307800 1111 #uuid "9c84f1ea-f0ec-524f-8b6d-5009fe054050" 13194139534754 true] [17592186307801 1034 "15{\\text{ cm/s}}^{2}" 13194139534754 true] [17592186307801 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307801 1111 #uuid "1fd56605-f978-56b1-a106-d5d880aa7952" 13194139534754 true] [17592186307802 1034 "2{\\text{ cm/s}}^{2}" 13194139534754 true] [17592186307802 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307802 1111 #uuid "fac8dbb8-7dd8-5bc3-bce3-6df85078b94c" 13194139534754 true] [17592186307803 1034 "10{\\text{ cm/s}}^{2}" 13194139534754 true] [17592186307803 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307803 1111 #uuid "bc8137f2-ff77-5503-ae2a-7d7508feac23" 13194139534754 true] [17592186307804 1034 "4{\\text{ cm/s}}^{2}" 13194139534754 true] [17592186307804 1103 #edb/ref 17592186045453 13194139534754 true] [17592186307804 1111 #uuid "aeb66576-58ed-5ac1-b137-bf39d522c