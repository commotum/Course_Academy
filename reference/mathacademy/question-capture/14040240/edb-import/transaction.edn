[{:db/id "q-4772/selection/86119bd892c8c825bf1ee1950d57137fbc1a024c45205cc66467c038d22de835" :answer/id #uuid "bc8137f2-ff77-5503-ae2a-7d7508feac23" :answer/type :answer.type/math :answer/value "10{\\text{ cm/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-4772/selection/359e4e6a182964a24005a692411f8a267ecb582a7e238a4d4a3dc2a476ef167e" :answer/id #uuid "1fd56605-f978-56b1-a106-d5d880aa7952" :answer/type :answer.type/math :answer/value "15{\\text{ cm/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-4772/selection/c3baf5847f09d1d4f61f0738b94269415832be884c1e5ea274c7c18dd2404424" :answer/id #uuid "aeb66576-58ed-5ac1-b137-bf39d522cf84" :answer/type :answer.type/math :answer/value "4{\\text{ cm/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-4772/selection/5df5579d91a4e44ed56cb1ea3b69f77bd221917a489907aa74a366be44dc8eee" :answer/id #uuid "fac8dbb8-7dd8-5bc3-bce3-6df85078b94c" :answer/type :answer.type/math :answer/value "2{\\text{ cm/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-4772/selection/16c96c99eba0ae15581062612cf8fc6a25905042465819ffe2af40bacb59eca3" :answer/id #uuid "9c84f1ea-f0ec-524f-8b6d-5009fe054050" :answer/type :answer.type/math :answer/value "8{\\text{ cm/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-4772/selection" :answer-field/id #uuid "b288532e-19ad-52c6-83a6-df021d713976" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-4772/selection/5df5579d91a4e44ed56cb1ea3b69f77bd221917a489907aa74a366be44dc8eee" :answer-field/choices ["q-4772/selection/86119bd892c8c825bf1ee1950d57137fbc1a024c45205cc66467c038d22de835" "q-4772/selection/359e4e6a182964a24005a692411f8a267ecb582a7e238a4d4a3dc2a476ef167e" "q-4772/selection/c3baf5847f09d1d4f61f0738b94269415832be884c1e5ea274c7c18dd2404424" "q-4772/selection/5df5579d91a4e44ed56cb1ea3b69f77bd221917a489907aa74a366be44dc8eee" "q-4772/selection/16c96c99eba0ae15581062612cf8fc6a25905042465819ffe2af40bacb59eca3"] :db/ensure [:answer-field/validate]} {:db/id "q-4772" :question/id #uuid "3288674d-b4a5-55ff-8fac-98e0dfe5f073" :question/math-academy-id "q-4772" :question/problem "The displacement (in centimeters) of an ant moving in a straight line is given by $s(t)={t}^{2}+3t,$ where $t$ is measured in seconds.\nFind the ant's acceleration at $t=10$ seconds." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+3t) \\\\  & =2t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+3) \\\\  & =2\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=10,$ we substitute this into the above:\n\n$$\na(10)=2\\,{\\text{m/s}}^{2}\n$$\n\nTherefore, the acceleration when $t=10$ seconds is $2\\,{\\text{m/s}}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-4772/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248"] :knowledge-point/questions ["q-4772"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19444/selection/d33f88bdd136db6d1f5e3a7b921e4d372ba4cd2ff9dae2a9932bc4b8c720b0e5" :answer/id #uuid "d0349a1e-6759-5ff4-8e8e-cfa4d132ed45" :answer/type :answer.type/math :answer/value "a(t)=-\\frac{3}{t}+3{t}^{2}-4t" :db/ensure [:answer/validate]} {:db/id "q-19444/selection/4dd8b2e2f9247780fba3ebb79e6022997aae670093aec103a21c5101c98d6054" :answer/id #uuid "e8676c5d-2032-5ac2-a8bb-5244473f8a3b" :answer/type :answer.type/math :answer/value "a(t)=\\frac{3}{t}+3{t}^{2}-4{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-19444/selection/76c48284c120efe7995d51a97d36a25f489bae4acb6325a161c5f2456a146282" :answer/id #uuid "4d73be20-ee57-5d49-9378-8ef0238d6e20" :answer/type :answer.type/math :answer/value "a(t)=\\frac{3}{t}+3{t}^{2}-4t" :db/ensure [:answer/validate]} {:db/id "q-19444/selection/1fe3415f00ce7784dfab7c3ba0c9fe60ff6990a35dd9e2b927be68178467204a" :answer/id #uuid "9b6eb685-f300-563d-b995-80e59924671e" :answer/type :answer.type/math :answer/value "a(t)=-\\frac{3}{t}-3{t}^{2}-4t" :db/ensure [:answer/validate]} {:db/id "q-19444/selection/4770d57298189e5bae329132d2e13b31533ea3b6c82b0498f0de28664e1a66b0" :answer/id #uuid "02beb33f-686f-540b-a726-c8823b5be421" :answer/type :answer.type/math :answer/value "a(t)=\\frac{t}{3}+3{t}^{2}-4t" :db/ensure [:answer/validate]} {:db/id "q-19444/selection" :answer-field/id #uuid "85abf288-e1ac-5204-aa83-51a745ebe7e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19444/selection/76c48284c120efe7995d51a97d36a25f489bae4acb6325a161c5f2456a146282" :answer-field/choices ["q-19444/selection/d33f88bdd136db6d1f5e3a7b921e4d372ba4cd2ff9dae2a9932bc4b8c720b0e5" "q-19444/selection/4dd8b2e2f9247780fba3ebb79e6022997aae670093aec103a21c5101c98d6054" "q-19444/selection/76c48284c120efe7995d51a97d36a25f489bae4acb6325a161c5f2456a146282" "q-19444/selection/1fe3415f00ce7784dfab7c3ba0c9fe60ff6990a35dd9e2b927be68178467204a" "q-19444/selection/4770d57298189e5bae329132d2e13b31533ea3b6c82b0498f0de28664e1a66b0"] :db/ensure [:answer-field/validate]} {:db/id "q-19444" :question/id #uuid "2451f973-c438-50a3-8e95-d4ca2e6ec6dd" :question/math-academy-id "q-19444" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=3\\operatorname{ln}⁡t+{t}^{3}-2{t}^{2}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{ln}⁡t+{t}^{3}-2{t}^{2}) \\\\  & =\\frac{3}{t}+3{t}^{2}-4t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19444/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5"] :knowledge-point/questions ["q-19444"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336419/field-1/013d51cc982e585888963702fa604f5682e8fbda1dee3649ac37dcef21ffd470" :answer/id #uuid "0fa957b6-7b68-595d-894b-f3f1d8a05d7b" :answer/type :answer.type/math :answer/value "\\frac{4}{t+1}+1" :db/ensure [:answer/validate]} {:db/id 17592186298249 :answer-field/choices ["q-336419/field-1/013d51cc982e585888963702fa604f5682e8fbda1dee3649ac37dcef21ffd470"] :db/ensure [:answer-field/validate]} {:db/id "q-336429/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c216ec45-7fe9-59da-9ff7-2f9c4043d161" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-336429/field-1" :answer-field/id #uuid "bc6119cc-e595-5bdf-ade2-9268cc8acf1a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336429/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-336429/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-336429" :question/id #uuid "b8da6936-d2e9-599f-99a3-2423543a5e86" :question/math-academy-id "q-336429" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)={t}^{3}-3{t}^{2}+2t+1.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $2\\,{\\text{m/s}}^{2}$ and $t>0.$\n\nWhen $a=2\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3{t}^{2}+2t+1) \\\\  & =3{t}^{2}-6t+2\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=2,$ we substitute this into the above:\n\n$$\n\\begin{aligned}2 & =3{t}^{2}-6t+2 \\\\ 0 & =3{t}^{2}-6t \\\\ 3t(t-2) & =0 \\\\ t & =0,2\\end{aligned}\n$$\n\nThus, $t=2$ since $t>0.$\n\nThen, to calculate the velocity at time $t=2,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(2) & =(2)^{3}-3(2)^{2}+2(2)+1 \\\\  & =8-12+4+1 \\\\  & =1\\,\\text{m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=2\\,{\\text{m/s}}^{2}$ is $v=1\\,\\text{m/s}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336429/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5"] :knowledge-point/questions ["q-336429"] :db/ensure [:knowledge-point/validate]}]
