#{[{:activity/first-step {:db/id #edb/ref 17592186097492} :activity/id #uuid "c84ecacf-b4b1-59e2-bb1d-796cf178ed22" :activity/scope {:db/id #edb/ref 17592186050101 :topic/id #uuid "2d31fc2e-19fe-50d4-bccf-d60b3f5db5c4" :topic/math-academy-id 1112} :activity/steps [{:db/id #edb/ref 17592186097492 :step/content {:db/id #edb/ref 17592186097917 :tutorial/content "We know how to integrate $e^x,$ but how do we integrate a function like $e^{2x}?$\n\nThe answer is to use a substitution. If we let $u=2x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 2\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 2 \\textrm d u.\n$$\n\nNow, we can write our original integral in terms of the new variable $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {e}^{2x}\\,\\text{d}x & =\\int {e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}{e}^{u}+C \\\\  & =\\frac{1}{2}{e}^{2x}+C.\\end{aligned}\n$$\n\nAfter solving an integral using substitution, we should always double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{2x}+C) & =\\frac{1}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{2x})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{2}\\cdot {e}^{2x}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x)+0 \\\\  & =\\frac{1}{2}{e}^{2x}\\cdot 2 \\\\  & ={e}^{2x}\\,✓\\end{aligned}\n$$" :tutorial/id #uuid "6118f768-6b97-5aab-b111-872192691536" :tutorial/math-academy-id 846 :tutorial/title "Introduction"} :step/id #uuid "56746886-5577-5aac-902f-a788809299bd" :step/math-academy-id 1634 :step/next {:db/id #edb/ref 17592186097493}} {:db/id #edb/ref 17592186097493 :step/content {:db/id #edb/ref 17592186096655 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096454 :question/id #uuid "9a42787b-24fb-50c8-9f3f-9e95d35c403c" :question/math-academy-id "e-459"} :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048332} {:db/id #edb/ref 17592186048754} {:db/id #edb/ref 17592186050628}] :knowledge-point/questions [{:db/id #edb/ref 17592186097099} {:db/id #edb/ref 17592186097217} {:db/id #edb/ref 17592186250122} {:db/id #edb/ref 17592186269142} {:db/id #edb/ref 17592186269147} {:db/id #edb/ref 17592186269150} {:db/id #edb/ref 17592186297312} {:db/id #edb/ref 17592186319344} {:db/id #edb/ref 17592186319345} {:db/id #edb/ref 17592186319346} {:db/id #edb/ref 17592186323783} {:db/id #edb/ref 17592186332860}] :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"} :step/id #uuid "19190b9d-43e3-5565-a329-f4e8b6afc03b" :step/math-academy-id 1635 :step/next {:db/id #edb/ref 17592186097494}} {:db/id #edb/ref 17592186097494 :step/content {:db/id #edb/ref 17592186096656 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096455 :question/id #uuid "cbf09123-3650-5d6a-869a-8edd8f54206b" :question/math-academy-id "e-460"} :knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/questions [{:db/id #edb/ref 17592186097220} {:db/id #edb/ref 17592186097221} {:db/id #edb/ref 17592186297314} {:db/id #edb/ref 17592186297389} {:db/id #edb/ref 17592186297390} {:db/id #edb/ref 17592186297396} {:db/id #edb/ref 17592186319347} {:db/id #edb/ref 17592186319348} {:db/id #edb/ref 17592186319349} {:db/id #edb/ref 17592186319350} {:db/id #edb/ref 17592186319351}] :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"} :step/id #uuid "6f310fe8-60e7-5364-8325-b57f8db47817" :step/math-academy-id 1637 :step/next {:db/id #edb/ref 17592186097495}} {:db/id #edb/ref 17592186097495 :step/content {:db/id #edb/ref 17592186097918 :tutorial/content "If you're comfortable with memorizing formulas, then it's worth noting that \n\n$$\n\\begin{aligned}\\int {e}^{px+q}\\,\\text{d}x & =\\frac{1}{p}{e}^{px+q}+C, \\\\ \\int {a}^{px+q}\\,\\text{d}x & =\\frac{1}{p\\operatorname{ln}a}{a}^{px+q}+C.\\end{aligned}\n$$\n\nIf you don't like to memorize formulas, you can always use substitution to solve these types of integrals." :tutorial/id #uuid "8b28e9eb-6c3c-50ac-a081-2da5742f5f83" :tutorial/math-academy-id 849 :tutorial/title "General Formulas for Integrating Exponential Functions With Linear Exponents"} :step/id #uuid "3ef5a225-23b9-5f5d-adaf-8c53122b3aae" :step/math-academy-id 1639}] :activity/title "Integrating Exponential Functions Using Linear Substitution" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186096891}]}
