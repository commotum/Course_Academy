ecacf-b4b1-59e2-bb1d-796cf178ed22" #edb/ref 17592186045417] [17592186097492 #edb/ref 1058 #edb/ref 17592186097493 #edb/ref 17592186045417] [17592186097492 #edb/ref 1061 1634 #edb/ref 17592186045417] [17592186097492 #edb/ref 1062 #uuid "56746886-5577-5aac-902f-a788809299bd" #edb/ref 17592186045417] [17592186097492 #edb/ref 1063 #edb/ref 17592186097917 #edb/ref 17592186045417] [17592186097493 #edb/ref 1058 #edb/ref 17592186097494 #edb/ref 17592186045417] [17592186097493 #edb/ref 1061 1635 #edb/ref 17592186045417] [17592186097493 #edb/ref 1062 #uuid "19190b9d-43e3-5565-a329-f4e8b6afc03b" #edb/ref 17592186045417] [17592186097493 #edb/ref 1063 #edb/ref 17592186096655 #edb/ref 17592186045417] [17592186097494 #edb/ref 1058 #edb/ref 17592186097495 #edb/ref 17592186045417] [17592186097494 #edb/ref 1061 1637 #edb/ref 17592186045417] [17592186097494 #edb/ref 1062 #uuid "6f310fe8-60e7-5364-8325-b57f8db47817" #edb/ref 17592186045417] [17592186097494 #edb/ref 1063 #edb/ref 17592186096656 #edb/ref 17592186045417] [17592186097495 #edb/ref 1061 1639 #edb/ref 17592186045417] [17592186097495 #edb/ref 1062 #uuid "3ef5a225-23b9-5f5d-adaf-8c53122b3aae" #edb/ref 17592186045417] [17592186097495 #edb/ref 1063 #edb/ref 17592186097918 #edb/ref 17592186045417] [17592186097917 #edb/ref 1064 "We know how to integrate $e^x,$ but how do we integrate a function like $e^{2x}?$\n\nThe answer is to use a substitution. If we let $u=2x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 2\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 2 \\textrm d u.\n$$\n\nNow, we can write our original integral in terms of the new variable $u,$ as follows:\n\n$$\n\\begin{aligned}\\int {e}^{2x}\\,\\text{d}x & =\\int {e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}{e}^{u}+C \\\\  & =\\frac{1}{2}{e}^{2x}+C.\\end{aligned}\n$$\n\nAfter solving an integral using substitution, we should always double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{2x}+C) & =\\frac{1}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{2x})+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{2}\\cdot {e}^{2x}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x)+0 \\\\  & =\\frac{1}{2}{e}^{2x}\\cdot 2 \\\\  & ={e}^{2x}\\,✓\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186097917 #edb/ref 1065 846 #edb/ref 17592186045417] [17592186097917 #edb/ref 1066 #uuid "6118f768-6b97-5aab-b111-872192691536" #edb/ref 17592186045417] [17592186097917 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186097918 #edb/ref 1064 "If you're comfortable with memorizing formulas, then it's worth noting that \n\n$$\n\\begin{aligned}\\int {e}^{px+q}\\,\\text{d}x & =\\frac{1}{p}{e}^{px+q}+C, \\\\ \\int {a}^{px+q}\\,\\text{d}x & =\\frac{1}{p\\operatorname{ln}a}{a}^{px+q}+C.\\end{aligned}\n$$\n\nIf you don't like to memorize formulas, you can always use substitution to solve these types of integrals." #edb/ref 17592186045417] [17592186097918 #edb/ref 1065 849 #edb/ref 17592186045417] [17592186097918 #edb/ref 1066 #uuid "8b28e9eb-6c3c-50ac-a081-2da5742f5f83" #edb/ref 17592186045417] [17592186097918 #edb/ref 1067 "General Formulas for Integrating Exponential Functions With Linear Exponents" #edb/ref 17592186045417] [17592186247477 #edb/ref 1080 "2\\,{e}^{x-1}+C" #edb/ref 17592186045417] [17592186247477 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247477 #edb/ref 1083 #uuid "0609bfa0-feaa-5eb6-8746-b749fc1e9ec2" #edb/ref 17592186045417] [17592186247750 #edb/ref 1080 "-2\\,{e}^{x/2\\,-\\,1}+C" #edb/ref 17592186045417] [17592186247750 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247750 #edb/ref 1083 #uuid "253a16d7-628b-53f9-a7b2-1f6c746a4abb" #edb/ref 17592186045417] [17592186247828 #edb/ref 1080 "2\\,{e}^{x/2\\,-\\,1}+C" #edb/ref 17592186045417] [17592186247828 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247828 #edb/ref 1083 #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" #edb/ref 17592186045417] [17592186247953 #edb/ref 1080 "\\frac{{e}^{x/2\\,-\\,1}}{2}+C" #edb/ref 17592186045417] [17592186247953 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186247953 #edb/ref 1083 #uuid "3bc85c63-a410-59bf-afe3-e5c1937a752b" #edb/ref 17592186045417] [17592186248018 #edb/ref 1080 "{e}^{x/2\\,-\\,1}+C" #edb/ref 17592186045417] [17592186248018 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186248018 #edb/ref 1083 #uuid "42a6cbcd-5218-511c-8178-7959687c4db1" #edb/ref 17592186045417] [17592186249811 #edb/ref 1075 #edb/ref 17592186247477 #edb/ref 17592186045417] [17592186249811 #edb/ref 1075 #edb/ref 17592186247750 #edb/ref 17592186045417] [17592186249811 #edb/ref 1075 #edb/ref 17592186247828 #edb/ref 17592186045417] [17592186249811 #edb/ref 1075 #edb/ref 17592186247953 #edb/ref 17592186045417] [17592186249811 #edb/ref 1075 #edb/ref 17592186248018 #edb/ref 17592186045417] [17592186249811 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186249811 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186249811 #edb/ref 1078 #edb/ref 17592186248018 #edb/ref 17592186045417] [17592186249811 #edb/ref 1079 #uuid "4c624ee9-f981-5550-b705-79dced8e3486" #edb/ref 17592186045417] [17592186250122 #edb/ref 1068 #edb/ref 17592186249811 #edb/ref 17592186045417] [17592186250122 #edb/ref 1069 "q-113833" #edb/ref 17592186045417] [17592186250122 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186250122 #edb/ref 1071 "Calculate $\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x.$" #edb/ref 17592186045417] [17592186250122 #edb/ref 1072 #uuid "0dd276ae-ab9b-5d13-9781-196a361b49ac" #edb/ref 17592186045417] [17592186250122 #edb/ref 1074 "If we let $u=\\frac{x}{2}-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x & =\\int {e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =2\\int {e}^{u}\\,\\text{d}u \\\\  & =2\\,{e}^{u}+C \\\\  & =2\\,{e}^{x/2\\,-\\,1}+C\\end{aligned}\n$$" #edb/ref 17592186045417]}
