[{:db/id "q-13786/selection/5fd01309ee1f63c32b27d8c9403d8417b63143ceb96e996ed693a8ee322c584f" :answer/id #uuid "57c1d95b-289c-5c55-95f6-bfe7f9320f4b" :answer/type :answer.type/math :answer/value "\\frac{10}{27}" :db/ensure [:answer/validate]} {:db/id "q-13786/selection/e3f35e286d9f68d1117b673020927d1d36889ab1a94983b2370b2286fda70ebd" :answer/id #uuid "df1a16b0-84aa-577f-982b-374c8abebebe" :answer/type :answer.type/math :answer/value "\\frac{80}{9}" :db/ensure [:answer/validate]} {:db/id "q-13786/selection/b7efc1fd8f8b35e9700cf88b2cf807e1f2ce5608767806d2425d008032ef231f" :answer/id #uuid "6e1dd5bd-d310-5992-80c1-d90ef98ac1f5" :answer/type :answer.type/math :answer/value "\\frac{40}{81}" :db/ensure [:answer/validate]} {:db/id "q-13786/selection/e4c7cd663a68b6236bac0921ae0e7fe1cf958be4f27ffbebda9f31f66e8afe33" :answer/id #uuid "304f1ef4-c361-5a69-84a8-f2d82f9ab603" :answer/type :answer.type/math :answer/value "\\frac{100}{9}" :db/ensure [:answer/validate]} {:db/id "q-13786/selection/1fa4252af077aff9be918d4c1709f3ac6e8937b8a9cd6c1a4487a068758e01f4" :answer/id #uuid "bbbdd7d1-5d87-5867-8d98-f292f8d9e60f" :answer/type :answer.type/math :answer/value "\\frac{100}{81}" :db/ensure [:answer/validate]} {:db/id "q-13786/selection" :answer-field/id #uuid "f5f7106e-b148-5d1b-a087-8c1de54e0e7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13786/selection/1fa4252af077aff9be918d4c1709f3ac6e8937b8a9cd6c1a4487a068758e01f4" :answer-field/choices ["q-13786/selection/5fd01309ee1f63c32b27d8c9403d8417b63143ceb96e996ed693a8ee322c584f" "q-13786/selection/e3f35e286d9f68d1117b673020927d1d36889ab1a94983b2370b2286fda70ebd" "q-13786/selection/b7efc1fd8f8b35e9700cf88b2cf807e1f2ce5608767806d2425d008032ef231f" "q-13786/selection/e4c7cd663a68b6236bac0921ae0e7fe1cf958be4f27ffbebda9f31f66e8afe33" "q-13786/selection/1fa4252af077aff9be918d4c1709f3ac6e8937b8a9cd6c1a4487a068758e01f4"] :db/ensure [:answer-field/validate]} {:db/id "q-13786" :question/id #uuid "33aff3cb-ac50-5651-b94a-182c678afb8d" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-13786/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-13786"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349601/field-1/fc8e0b86eb88dce8cf98b9b9083e21fa94ad42ceec2c58177982e62e3f5c3db3" :answer/id #uuid "88f67ac5-2593-5c22-8b0d-974f7fcb7da0" :answer/type :answer.type/math :answer/value "e^9-e" :db/ensure [:answer/validate]} {:db/id "q-349601/field-1" :answer-field/id #uuid "9412f292-a375-5b84-905d-6a376a3d3518" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349601/field-1/fc8e0b86eb88dce8cf98b9b9083e21fa94ad42ceec2c58177982e62e3f5c3db3" :answer-field/choices ["q-349601/field-1/fc8e0b86eb88dce8cf98b9b9083e21fa94ad42ceec2c58177982e62e3f5c3db3"] :db/ensure [:answer-field/validate]} {:db/id "q-349601" :question/id #uuid "8426838d-d104-53ab-a4bc-211ecb7c8978" :question/math-academy-id "q-349601" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=4x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $9$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x & =4{\\int }_{0}^{2}{e}^{4x+1}\\,\\text{d}x \\\\  & =4{\\int }_{1}^{9}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & ={\\int }_{1}^{9}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{1}^{9} \\\\  & ={e}^{9}-{e}^{1} \\\\  & ={e}^{9}-e\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349601/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-349601"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113833/selection/e9a09c01dc508c5e45425e1bd9825542df44d581f7325d747a782b97ba63e0ea" :answer/id #uuid "060f7cd2-892c-5933-a83e-3c8e1fcedb56" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x/2\\,-\\,1}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113833/selection/d2b6103767af52d0c2f5e3f01524f204a308bd9fde9f82b50905dd2d154a3485" :answer/id #uuid "4757e480-e436-51b3-9d48-9040d8df5495" :answer/type :answer.type/math :answer/value "-2\\,{e}^{x/2\\,-\\,1}+C" :db/ensure [:answer/validate]} {:db/id "q-113833/selection/e236c703bf7389abe0b1dbf6b3d9991b4924e940a944a9b762259fef06cee119" :answer/id #uuid "0e1d2669-9c5b-51f6-95bd-6c1a6d7dd177" :answer/type :answer.type/math :answer/value "{e}^{x/2\\,-\\,1}+C" :db/ensure [:answer/validate]} {:db/id "q-113833/selection/786f08ef1e4f8b293ac5b8b52830d691504ec5599d9333ebd87108ae16a70404" :answer/id #uuid "c463ac3f-c416-5acc-af95-364877d3f8ab" :answer/type :answer.type/math :answer/value "2\\,{e}^{x-1}+C" :db/ensure [:answer/validate]} {:db/id "q-113833/selection/f72eaa2d3e95c8e8fcdff867578d41817452a22a297df4305b6fdd9f053266e8" :answer/id #uuid "e462c633-4002-5dd4-b278-16b45a1309f6" :answer/type :answer.type/math :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/ensure [:answer/validate]} {:db/id "q-113833/selection" :answer-field/id #uuid "f2bf9b29-fd2e-58a8-84e7-a097a706a3c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113833/selection/f72eaa2d3e95c8e8fcdff867578d41817452a22a297df4305b6fdd9f053266e8" :answer-field/choices ["q-113833/selection/e9a09c01dc508c5e45425e1bd9825542df44d581f7325d747a782b97ba63e0ea" "q-113833/selection/d2b6103767af52d0c2f5e3f01524f204a308bd9fde9f82b50905dd2d154a3485" "q-113833/selection/e236c703bf7389abe0b1dbf6b3d9991b4924e940a944a9b762259fef06cee119" "q-113833/selection/786f08ef1e4f8b293ac5b8b52830d691504ec5599d9333ebd87108ae16a70404" "q-113833/selection/f72eaa2d3e95c8e8fcdff867578d41817452a22a297df4305b6fdd9f053266e8"] :db/ensure [:answer-field/validate]} {:db/id "q-113833" :question/id #uuid "cdee5baf-3a31-5ce2-b848-457bc42ae59b" :question/math-academy-id "q-113833" :question/problem "Calculate $\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x.$" :question/worked-solution "If we let $u=\\frac{x}{2}-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x & =\\int {e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =2\\int {e}^{u}\\,\\text{d}u \\\\  & =2\\,{e}^{u}+C \\\\  & =2\\,{e}^{x/2\\,-\\,1}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113833/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-113833"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13732/selection/bce257886458ff27645be2d130a50a80b00d133ae17edde6f4a71ef2177f193a" :answer/id #uuid "02f19857-716a-5bba-92e0-8f62df1fb67d" :answer/type :answer.type/math :answer/value "\\frac{5}{3}{e}^{5x}+C" :db/ensure [:answer/validate]} {:db/id "q-13732/selection/7584065b80fc215dbb277abc4369a5a504b8dd7d3577110164ee44d1dbd82797" :answer/id #uuid "d9879f79-a9bb-578b-926b-37cf332073f1" :answer/type :answer.type/math :answer/value "\\frac{3}{5}{e}^{3x}+C" :db/ensure [:answer/validate]} {:db/id "q-13732/selection/7620971f92d26eb2c23fa1454af0698802ca414a0fdaf7a9641b80bb464be644" :answer/id #uuid "ed330f6a-c162-55d2-ba0a-fbb3680c4565" :answer/type :answer.type/math :answer/value "5{e}^{3x}+C" :db/ensure [:answer/validate]} {:db/id "q-13732/selection/82080c2322475e79f1e6ad9c3b2a9bacdcfd8e3c08c3ba52fa8e70ae395558ed" :answer/id #uuid "d666520e-00ba-5c62-8792-a9f4bf678082" :answer/type :answer.type/math :answer/value "\\frac{5}{3}{e}^{3x}+C" :db/ensure [:answer/validate]} {:db/id "q-13732/selection/2bdd2dc19b8e9566ce91e570a47409da76b2cbf188df523c161a748a6ae7cc8b" :answer/id #uuid "2a69cb4c-b382-5c4d-9526-e223f99b5302" :answer/type :answer.type/math :answer/value "3{e}^{3x}+C" :db/ensure [:answer/validate]} {:db/id "q-13732/selection" :answer-field/id #uuid "a38621fb-97df-5100-acd6-f3e1862c6a5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13732/selection/82080c2322475e79f1e6ad9c3b2a9bacdcfd8e3c08c3ba52fa8e70ae395558ed" :answer-field/choices ["q-13732/selection/bce257886458ff27645be2d130a50a80b00d133ae17edde6f4a71ef2177f193a" "q-13732/selection/7584065b80fc215dbb277abc4369a5a504b8dd7d3577110164ee44d1dbd82797" "q-13732/selection/7620971f92d26eb2c23fa1454af0698802ca414a0fdaf7a9641b80bb464be644" "q-13732/selection/82080c2322475e79f1e6ad9c3b2a9bacdcfd8e3c08c3ba52fa8e70ae395558ed" "q-13732/selection/2bdd2dc19b8e9566ce91e570a47409da76b2cbf188df523c161a748a6ae7cc8b"] :db/ensure [:answer-field/validate]} {:db/id "q-13732" :question/id #uuid "3f5ab5d8-351e-53f7-97d6-2bca9468f748" :question/math-academy-id "q-13732" :question/problem "$\\int 5{e}^{3x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 5{e}^{3x}\\,\\text{d}x & =\\int 5{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}{e}^{u}+C \\\\  & =\\frac{5}{3}{e}^{3x}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13732/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-13732"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51160/selection/9374afca8c81582f143d59a3447975ecedbb59d705d08ef047f548554415387d" :answer/id #uuid "dbbb1c14-8ef9-5d6a-9a03-aeaa24a829ab" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2z}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-51160/selection/2a9e3e541e5e0fbc2fff72c93dcf91b59ad2a9cba2d3b221b962151736a601e9" :answer/id #uuid "f0478a76-f026-5042-b219-7554640a9b59" :answer/type :answer.type/math :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-51160/selection/452f12bf4ce6bcb9e910837a483702312f1aecdece33f34f099e7f8d03687c86" :answer/id #uuid "11ec652d-141f-5397-894c-8f1886bac7f4" :answer/type :answer.type/math :answer/value "\\frac{{e}^{z}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-51160/selection/3fdb1b063a981592d22a41175518c258506ff76079923bc8af541b82d5b9c7ae" :answer/id #uuid "2eeaeecd-db13-5383-82aa-e7cdb54a6d97" :answer/type :answer.type/math :answer/value "2{e}^{2z}+C" :db/ensure [:answer/validate]} {:db/id "q-51160/selection/b043a7eeddba17af43314ed404033a9ffec562036fa0c8e9f8381171e84afc6b" :answer/id #uuid "11f5bc15-41ab-5be6-bba4-591eea7c6199" :answer/type :answer.type/math :answer/value "{e}^{2z}+C" :db/ensure [:answer/validate]} {:db/id "q-51160/selection" :answer-field/id #uuid "2939e714-31c1-57c9-9eca-bcdc26640e90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-51160/selection/9374afca8c81582f143d59a3447975ecedbb59d705d08ef047f548554415387d" :answer-field/choices ["q-51160/selection/9374afca8c81582f143d59a3447975ecedbb59d705d08ef047f548554415387d" "q-51160/selection/2a9e3e541e5e0fbc2fff72c93dcf91b59ad2a9cba2d3b221b962151736a601e9" "q-51160/selection/452f12bf4ce6bcb9e910837a483702312f1aecdece33f34f099e7f8d03687c86" "q-51160/selection/3fdb1b063a981592d22a41175518c258506ff76079923bc8af541b82d5b9c7ae" "q-51160/selection/b043a7eeddba17af43314ed404033a9ffec562036fa0c8e9f8381171e84afc6b"] :db/ensure [:answer-field/validate]} {:db/id "q-51160" :question/id #uuid "84822455-4b93-5a12-af5e-c06a07dea4e0" :question/math-academy-id "q-51160" :question/problem "$\\int {e}^{z}{e}^{z}\\,\\text{d}z=$" :question/worked-solution "First, we notice that\n\n$$\n\\int {e}^{z}{e}^{z}\\,\\text{d}z=\\int {e}^{2z}\\,\\text{d}z.\n$$\n\nIf we let $u=2z$, then\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2\\,⟹\\,\\text{d}z=\\frac{1}{2}\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int {e}^{2z}\\,\\text{d}z & =\\int {e}^{2z}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{2z}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{2z}}{2}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-51160/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e"] :knowledge-point/questions ["q-51160"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349646/field-1/cb9553d90f93862e3081fa23d722d3e26dd78144d0a7cb782d7def5df7bdae79" :answer/id #uuid "32b79544-65d9-5d51-ab1a-d9576e66e17a" :answer/type :answer.type/math :answer/value "\\frac{24}{5\\ln(5)}" :db/ensure [:answer/validate]} {:db/id "q-349646/field-1" :answer-field/id #uuid "3b9f63bc-d753-56e7-8bac-650ac59c69fa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349646/field-1/cb9553d90f93862e3081fa23d722d3e26dd78144d0a7cb782d7def5df7bdae79" :answer-field/choices ["q-349646/field-1/cb9553d90f93862e3081fa23d722d3e26dd78144d0a7cb782d7def5df7bdae79"] :db/ensure [:answer-field/validate]} {:db/id "q-349646" :question/id #uuid "98b6b759-0da2-5530-96cf-b1f6f258078f" :question/math-academy-id "q-349646" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}{5}^{x-1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=x-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{5}^{x-1}\\,\\text{d}x & ={\\int }_{-1}^{1}{5}^{u}\\text{d}u \\\\  & =\\frac{{5}^{u}}{\\operatorname{ln}⁡5}\\,{|}_{-1}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}({5}^{1}-{5}^{-1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}(5-\\frac{1}{5}) \\\\  & =\\frac{24}{5\\operatorname{ln}⁡5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349646/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-349646"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31417/selection/e489dc7ebdd772812962e20c443e3cf4dd8e6630e85710415dc94a9c6205f6b4" :answer/id #uuid "33badae8-57f6-56ce-9153-cf773b70c2d3" :answer/type :answer.type/math :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/ensure [:answer/validate]} {:db/id "q-31417/selection/a7e00ad0b38a7629deb1b56414b4a7a56b5ac755b4e1a981350c203d38775d01" :answer/id #uuid "3ab3657c-f037-5d80-a5f3-388f21859869" :answer/type :answer.type/math :answer/value "\\frac{{6}^{x/3}}{3\\operatorname{ln}⁡6}+C" :db/ensure [:answer/validate]} {:db/id "q-31417/selection/ed0c116211cdf6511121b580090d9eb4ce9e3f5f0c04fec8dcffa4c58ca6bc67" :answer/id #uuid "d5d719d8-fed9-54c2-9c16-617d364f5c17" :answer/type :answer.type/math :answer/value "\\frac{{6}^{x}}{3\\operatorname{ln}⁡6}+C" :db/ensure [:answer/validate]} {:db/id "q-31417/selection/83df61634f666861c9e50189903c3d09ced289f710ba3e524e7050a55cf1d3f0" :answer/id #uuid "035f43b9-f90d-514b-ac99-1279c905e120" :answer/type :answer.type/math :answer/value "\\frac{3\\cdot {6}^{x}}{\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-31417/selection/e5fed396668c44c6fb9a2d2dbdc938e87ad8f56979d15e2036aacd636c70d2f8" :answer/id #uuid "9249bfe8-5f5d-5cc8-8fbf-8e346c842527" :answer/type :answer.type/math :answer/value "\\frac{{6}^{x/3}}{\\operatorname{ln}⁡3}+C" :db/ensure [:answer/validate]} {:db/id "q-31417/selection" :answer-field/id #uuid "99aa111b-9eda-52b9-b327-654a124dfc0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31417/selection/e489dc7ebdd772812962e20c443e3cf4dd8e6630e85710415dc94a9c6205f6b4" :answer-field/choices ["q-31417/selection/e489dc7ebdd772812962e20c443e3cf4dd8e6630e85710415dc94a9c6205f6b4" "q-31417/selection/a7e00ad0b38a7629deb1b56414b4a7a56b5ac755b4e1a981350c203d38775d01" "q-31417/selection/ed0c116211cdf6511121b580090d9eb4ce9e3f5f0c04fec8dcffa4c58ca6bc67" "q-31417/selection/83df61634f666861c9e50189903c3d09ced289f710ba3e524e7050a55cf1d3f0" "q-31417/selection/e5fed396668c44c6fb9a2d2dbdc938e87ad8f56979d15e2036aacd636c70d2f8"] :db/ensure [:answer-field/validate]} {:db/id "q-31417" :question/id #uuid "a96febf6-78be-532b-9b01-bcde284132c7" :question/math-academy-id "q-31417" :question/problem "$\\int {6}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {6}^{x/3}\\,\\text{d}x & =\\int {6}^{u}\\cdot 3\\,\\text{d}u \\\\  & =3\\int {6}^{u}\\,\\text{d}u \\\\  & =3\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31417/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-31417"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31413/selection/96313a2e531edeed4d1357dc8b3b2fc23c65449bdd249648ab6ced0f092a69d1" :answer/id #uuid "914dc7dd-971d-5a64-98cb-8cf7a27678a6" :answer/type :answer.type/math :answer/value "-\\frac{{4}^{5x-7}}{5\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31413/selection/904d0547c3d5c85b86ad1dd9a0610b15a9995def5294232bd06b64e9d55f3fd5" :answer/id #uuid "9230d064-d0fc-575e-97a5-d78dba883ac6" :answer/type :answer.type/math :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31413/selection/8fb7343df6604933dd8cca01ba8f2391e1a4d634cb8e9940cd134bbdfca2821e" :answer/id #uuid "fda64dfa-2ade-5d96-9062-39e43a90de41" :answer/type :answer.type/math :answer/value "\\frac{{4}^{5x}}{5}+C" :db/ensure [:answer/validate]} {:db/id "q-31413/selection/336c7aa1261b8b14de3fd02e66d4ec7589389b966be26b9c94e1f2f3589726b8" :answer/id #uuid "80964781-880c-5bf4-9f43-b79f5e981e71" :answer/type :answer.type/math :answer/value "\\frac{{4}^{5x}}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31413/selection/89fedb3a97e144c67c40d1a08ec2200d486031ab2959613a24957bcb2876f6cd" :answer/id #uuid "b1ee7ef9-15ae-5d10-ab0c-d1d69ab2c336" :answer/type :answer.type/math :answer/value "\\frac{{4}^{x}}{\\operatorname{ln}⁡4}+C" :db/ensure [:answer/validate]} {:db/id "q-31413/selection" :answer-field/id #uuid "75c89cc7-57dc-5daa-b5a5-adcd79fb9a18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31413/selection/904d0547c3d5c85b86ad1dd9a0610b15a9995def5294232bd06b64e9d55f3fd5" :answer-field/choices ["q-31413/selection/96313a2e531edeed4d1357dc8b3b2fc23c65449bdd249648ab6ced0f092a69d1" "q-31413/selection/904d0547c3d5c85b86ad1dd9a0610b15a9995def5294232bd06b64e9d55f3fd5" "q-31413/selection/8fb7343df6604933dd8cca01ba8f2391e1a4d634cb8e9940cd134bbdfca2821e" "q-31413/selection/336c7aa1261b8b14de3fd02e66d4ec7589389b966be26b9c94e1f2f3589726b8" "q-31413/selection/89fedb3a97e144c67c40d1a08ec2200d486031ab2959613a24957bcb2876f6cd"] :db/ensure [:answer-field/validate]} {:db/id "q-31413" :question/id #uuid "04319ecd-8287-50aa-9f85-65246b518f80" :question/math-academy-id "q-31413" :question/problem "$\\int {4}^{5x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=5x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {4}^{5x}\\,\\text{d}x & =\\int {4}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-31413/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-31413"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30973/selection/6fea6014a3018f899c6aa015cd9068f892293804f9ed0e927523a1aaa37119f8" :answer/id #uuid "1e121eaa-fa8e-58f2-96bf-2fa70acde349" :answer/type :answer.type/math :answer/value "\\frac{364}{\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-30973/selection/2a0489ddce4426e8f86b8ef230bb1047c975b65e8fafa3d952abab0473388dca" :answer/id #uuid "43fdf911-309d-5a3c-9da0-c463b7a4a053" :answer/type :answer.type/math :answer/value "\\frac{364}{3}" :db/ensure [:answer/validate]} {:db/id "q-30973/selection/7642ea6f42da91c7a20de98d03e63f7b399fcc2e90f9ae1de5a5dfedf2644105" :answer/id #uuid "1ca4e043-ca6f-5e21-97ad-977e82fa68d1" :answer/type :answer.type/math :answer/value "\\frac{121}{\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-30973/selection/d8779e5776ada713024342d3a39a28a206f719d93101ab6d5002259d7c593821" :answer/id #uuid "c0004452-51fa-583d-9904-a5f6d2318163" :answer/type :answer.type/math :answer/value "\\frac{728}{\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-30973/selection/d3d421d952efcbf4312379e2bba131e75ee290d7bcaf223707a9052407c4e289" :answer/id #uuid "3e95393e-96a8-5296-ac9c-d09087e54346" :answer/type :answer.type/math :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/ensure [:answer/validate]} {:db/id "q-30973/selection" :answer-field/id #uuid "70a35abd-cad4-5c9f-8c82-833a236f4d98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30973/selection/d3d421d952efcbf4312379e2bba131e75ee290d7bcaf223707a9052407c4e289" :answer-field/choices ["q-30973/selection/6fea6014a3018f899c6aa015cd9068f892293804f9ed0e927523a1aaa37119f8" "q-30973/selection/2a0489ddce4426e8f86b8ef230bb1047c975b65e8fafa3d952abab0473388dca" "q-30973/selection/7642ea6f42da91c7a20de98d03e63f7b399fcc2e90f9ae1de5a5dfedf2644105" "q-30973/selection/d8779e5776ada713024342d3a39a28a206f719d93101ab6d5002259d7c593821" "q-30973/selection/d3d421d952efcbf4312379e2bba131e75ee290d7bcaf223707a9052407c4e289"] :db/ensure [:answer-field/validate]} {:db/id "q-30973" :question/id #uuid "3829c9cb-f2be-5d72-b777-929cf7ce9503" :question/math-academy-id "q-30973" :question/problem "Evaluate the integral ${\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6$ |\n\nThen, we can write the integral in terms of  $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x & ={\\int }_{0}^{6}{3}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{0}^{6}{3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{0}^{6} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡3}(729-1) \\\\  & =\\frac{728}{6\\operatorname{ln}⁡3} \\\\  & =\\frac{364}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30973/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-30973"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349631/field-1/480157a5f8ce4097f43489a7cf113737b9d6f011f1d71dbbccb74d34cd4b6606" :answer/id #uuid "adf2383e-b2ab-5234-8218-fdaca22abdd9" :answer/type :answer.type/math :answer/value "\\frac{6}{\\ln(4)}" :db/ensure [:answer/validate]} {:db/id "q-349631/field-1" :answer-field/id #uuid "1c31891e-272c-560c-b179-5b67904a518e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349631/field-1/480157a5f8ce4097f43489a7cf113737b9d6f011f1d71dbbccb74d34cd4b6606" :answer-field/choices ["q-349631/field-1/480157a5f8ce4097f43489a7cf113737b9d6f011f1d71dbbccb74d34cd4b6606"] :db/ensure [:answer-field/validate]} {:db/id "q-349631" :question/id #uuid "9a036849-2d96-558d-8887-92c21fd6ff91" :question/math-academy-id "q-349631" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2\\cdot {4}^{1-x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=1-x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {4}^{1-x}\\,\\text{d}x & ={\\int }_{1}^{0}2\\cdot {4}^{u}(-1)\\text{d}u \\\\  & =-2{\\int }_{1}^{0}{4}^{u}\\,\\text{d}u \\\\  & =-2(\\frac{{4}^{u}}{\\operatorname{ln}⁡4}){|}_{1}^{0} \\\\  & =-\\frac{2}{\\operatorname{ln}⁡4}({4}^{0}-{4}^{1}) \\\\  & =-\\frac{2}{\\operatorname{ln}⁡4}(1-4) \\\\  & =\\frac{6}{\\operatorname{ln}⁡4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349631/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9"] :knowledge-point/questions ["q-349631"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-459"] :question/problem "Calculate  $\\displaystyle{\\int e^{1-3x}\\, \\textrm{d}x }.$" :question/worked-solution "If we let $u=1-3x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3\\quad\\Longrightarrow\\quad \\textrm d x = -\\dfrac 1 3 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{1-3x}\\,\\text{d}x & =\\int {e}^{u}\\cdot (-\\frac{1}{3})\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}{e}^{u}+C \\\\  & =-\\frac{1}{3}{e}^{1-3x}+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-460"] :question/problem "Calculate  $\\displaystyle{\\int 3^{5+4x}\\, \\textrm{d}x }.$" :question/worked-solution "If we let $u=5+4x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 4\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 4 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {3}^{5+4x}\\,\\text{d}x & =\\int {3}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int {3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{3}^{u}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{3}^{5+4x}}{4\\operatorname{ln}⁡3}+C\\end{aligned}\n$$" :db/ensure [:question/validate]}]
