#{[{:db/id #edb/ref 17592186096377 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/id #uuid "9a42787b-24fb-50c8-9f3f-9e95d35c403c" :question/math-academy-id "e-459" :question/problem "Calculate  $\\displaystyle{\\int e^{1-3x}\\, \\textrm{d}x }.$" :question/worked-solution "If we let $u=1-3x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = -3\\quad\\Longrightarrow\\quad \\textrm d x = -\\dfrac 1 3 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{1-3x}\\,\\text{d}x & =\\int {e}^{u}\\cdot (-\\frac{1}{3})\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}{e}^{u}+C \\\\  & =-\\frac{1}{3}{e}^{1-3x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096378 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/id #uuid "cbf09123-3650-5d6a-869a-8edd8f54206b" :question/math-academy-id "e-460" :question/problem "Calculate  $\\displaystyle{\\int 3^{5+4x}\\, \\textrm{d}x }.$" :question/worked-solution "If we let $u=5+4x,$ then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = 4\\quad\\Longrightarrow\\quad \\textrm d x = \\dfrac 1 4 \\textrm d u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {3}^{5+4x}\\,\\text{d}x & =\\int {3}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int {3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{3}^{u}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{3}^{5+4x}}{4\\operatorname{ln}⁡3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288185 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c463ac3f-c416-5acc-af95-364877d3f8ab" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,{e}^{x-1}+C" :db/id #edb/ref 17592186288187} {:answer/id #uuid "4757e480-e436-51b3-9d48-9040d8df5495" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186288188} {:answer/id #uuid "0e1d2669-9c5b-51f6-95bd-6c1a6d7dd177" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186288189} {:answer/id #uuid "060f7cd2-892c-5933-a83e-3c8e1fcedb56" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x/2\\,-\\,1}}{2}+C" :db/id #edb/ref 17592186288190} {:answer/id #uuid "e462c633-4002-5dd4-b278-16b45a1309f6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186288191}] :answer-field/correct {:answer/id #uuid "e462c633-4002-5dd4-b278-16b45a1309f6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186288191} :answer-field/id #uuid "f2bf9b29-fd2e-58a8-84e7-a097a706a3c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288186}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cdee5baf-3a31-5ce2-b848-457bc42ae59b" :question/math-academy-id "q-113833" :question/problem "Calculate $\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x.$" :question/worked-solution "If we let $u=\\frac{x}{2}-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x & =\\int {e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =2\\int {e}^{u}\\,\\text{d}u \\\\  & =2\\,{e}^{u}+C \\\\  & =2\\,{e}^{x/2\\,-\\,1}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288192 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a69cb4c-b382-5c4d-9526-e223f99b5302" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3x}+C" :db/id #edb/ref 17592186288194} {:answer/id #uuid "d9879f79-a9bb-578b-926b-37cf332073f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}{e}^{3x}+C" :db/id #edb/ref 17592186288195} {:answer/id #uuid "ed330f6a-c162-55d2-ba0a-fbb3680c4565" :answer/type {:db/ident :answer.type/math} :answer/value "5{e}^{3x}+C" :db/id #edb/ref 17592186288196} {:answer/id #uuid "d666520e-00ba-5c62-8792-a9f4bf678082" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}{e}^{3x}+C" :db/id #edb/ref 17592186288197} {:answer/id #uuid "02f19857-716a-5bba-92e0-8f62df1fb67d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}{e}^{5x}+C" :db/id #edb/ref 17592186288198}] :answer-field/correct {:answer/id #uuid "d666520e-00ba-5c62-8792-a9f4bf678082" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}{e}^{3x}+C" :db/id #edb/ref 17592186288197} :answer-field/id #uuid "a38621fb-97df-5100-acd6-f3e1862c6a5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288193}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3f5ab5d8-351e-53f7-97d6-2bca9468f748" :question/math-academy-id "q-13732" :question/problem "$\\int 5{e}^{3x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=3x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\frac{1}{3}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int 5{e}^{3x}\\,\\text{d}x & =\\int 5{e}^{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}{e}^{u}+C \\\\  & =\\frac{5}{3}{e}^{3x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288199 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbbdd7d1-5d87-5867-8d98-f292f8d9e60f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186288201} {:answer/id #uuid "57c1d95b-289c-5c55-95f6-bfe7f9320f4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186288202} {:answer/id #uuid "6e1dd5bd-d310-5992-80c1-d90ef98ac1f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{40}{81}" :db/id #edb/ref 17592186288203} {:answer/id #uuid "df1a16b0-84aa-577f-982b-374c8abebebe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{80}{9}" :db/id #edb/ref 17592186288204} {:answer/id #uuid "304f1ef4-c361-5a69-84a8-f2d82f9ab603" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{9}" :db/id #edb/ref 17592186288205}] :answer-field/correct {:answer/id #uuid "bbbdd7d1-5d87-5867-8d98-f292f8d9e60f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{100}{81}" :db/id #edb/ref 17592186288201} :answer-field/id #uuid "f5f7106e-b148-5d1b-a087-8c1de54e0e7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "33aff3cb-ac50-5651-b94a-182c678afb8d" :question/math-academy-id "q-13786" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=-4x,$ then, \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4\\,⟹\\,-\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $\\operatorname{ln}⁡3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $-4\\operatorname{ln}⁡3$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡3}5{e}^{-4x}\\,\\text{d}x & =5{\\int }_{0}^{\\operatorname{ln}⁡3}{e}^{-4x}\\,\\text{d}x \\\\  & =5{\\int }_{0}^{-4\\operatorname{ln}⁡3}{e}^{u}(-\\frac{1}{4})\\text{d}u \\\\  & =-\\frac{5}{4}{\\int }_{0}^{\\operatorname{ln}⁡({3}^{-4})}{e}^{u}\\text{d}u \\\\  & =-\\frac{5}{4}({e}^{u}){|}_{0}^{\\operatorname{ln}⁡({3}^{-4})} \\\\  & =-\\frac{5}{4}({e}^{\\operatorname{ln}⁡({3}^{-4})}-{e}^{0}) \\\\  & =-\\frac{5}{4}({3}^{-4}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{{3}^{4}}-1) \\\\  & =-\\frac{5}{4}(\\frac{1}{81}-1) \\\\  & =-\\frac{5}{4}(-\\frac{80}{81}) \\\\  & =\\frac{100}{81}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288206 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fdf911-309d-5a3c-9da0-c463b7a4a053" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{3}" :db/id #edb/ref 17592186288208} {:answer/id #uuid "1e121eaa-fa8e-58f2-96bf-2fa70acde349" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186288209} {:answer/id #uuid "1ca4e043-ca6f-5e21-97ad-977e82fa68d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{121}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186288210} {:answer/id #uuid "3e95393e-96a8-5296-ac9c-d09087e54346" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186288211} {:answer/id #uuid "c0004452-51fa-583d-9904-a5f6d2318163" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{728}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186288212}] :answer-field/correct {:answer/id #uuid "3e95393e-96a8-5296-ac9c-d09087e54346" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186288211} :answer-field/id #uuid "70a35abd-cad4-5c9f-8c82-833a236f4d98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288207}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3829c9cb-f2be-5d72-b777-929cf7ce9503" :question/math-academy-id "q-30973" :question/problem "Evaluate the integral ${\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6$ |\n\nThen, we can write the integral in terms of  $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x & ={\\int }_{0}^{6}{3}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{0}^{6}{3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{0}^{6} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡3}(729-1) \\\\  & =\\frac{728}{6\\operatorname{ln}⁡3} \\\\  & =\\frac{364}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288213 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80964781-880c-5bf4-9f43-b79f5e981e71" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288215} {:answer/id #uuid "b1ee7ef9-15ae-5d10-ab0c-d1d69ab2c336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288216} {:answer/id #uuid "fda64dfa-2ade-5d96-9062-39e43a90de41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5}+C" :db/id #edb/ref 17592186288217} {:answer/id #uuid "9230d064-d0fc-575e-97a5-d78dba883ac6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288218} {:answer/id #uuid "914dc7dd-971d-5a64-98cb-8cf7a27678a6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{4}^{5x-7}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288219}] :answer-field/correct {:answer/id #uuid "9230d064-d0fc-575e-97a5-d78dba883ac6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186288218} :answer-field/id #uuid "75c89cc7-57dc-5daa-b5a5-adcd79fb9a18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288214}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "04319ecd-8287-50aa-9f85-65246b518f80" :question/math-academy-id "q-31413" :question/problem "$\\int {4}^{5x}\\,\\text{d}x=$" :question/worked-solution "If we let $u=5x$, then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {4}^{5x}\\,\\text{d}x & =\\int {4}^{u}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {4}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\frac{{4}^{u}}{\\operatorname{ln}⁡4}+C \\\\  & =\\frac{{4}^{5x}}{5\\operatorname{ln}⁡4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288220 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "035f43b9-f90d-514b-ac99-1279c905e120" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186288222} {:answer/id #uuid "3ab3657c-f037-5d80-a5f3-388f21859869" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{3\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186288223} {:answer/id #uuid "33badae8-57f6-56ce-9153-cf773b70c2d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186288224} {:answer/id #uuid "9249bfe8-5f5d-5cc8-8fbf-8e346c842527" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{x/3}}{\\operatorname{ln}⁡3}+C" :db/id #edb/ref 17592186288225} {:answer/id #uuid "d5d719d8-fed9-54c2-9c16-617d364f5c17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{6}^{x}}{3\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186288226}] :answer-field/correct {:answer/id #uuid "33badae8-57f6-56ce-9153-cf773b70c2d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C" :db/id #edb/ref 17592186288224} :answer-field/id #uuid "99aa111b-9eda-52b9-b327-654a124dfc0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288221}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a96febf6-78be-532b-9b01-bcde284132c7" :question/math-academy-id "q-31417" :question/problem "$\\int {6}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then,\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {6}^{x/3}\\,\\text{d}x & =\\int {6}^{u}\\cdot 3\\,\\text{d}u \\\\  & =3\\int {6}^{u}\\,\\text{d}u \\\\  & =3\\frac{{6}^{u}}{\\operatorname{ln}⁡6}+C \\\\  & =\\frac{3\\cdot {6}^{x/3}}{\\operatorname{ln}⁡6}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288227 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f67ac5-2593-5c22-8b0d-974f7fcb7da0" :answer/type {:db/ident :answer.type/math} :answer/value "e^9-e" :db/id #edb/ref 17592186288229}] :answer-field/correct {:answer/id #uuid "88f67ac5-2593-5c22-8b0d-974f7fcb7da0" :answer/type {:db/ident :answer.type/math} :answer/value "e^9-e" :db/id #edb/ref 17592186288229} :answer-field/id #uuid "9412f292-a375-5b84-905d-6a376a3d3518" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288228}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8426838d-d104-53ab-a4bc-211ecb7c8978" :question/math-academy-id "q-349601" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=4x+1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $9$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}4{e}^{4x+1}\\,\\text{d}x & =4{\\int }_{0}^{2}{e}^{4x+1}\\,\\text{d}x \\\\  & =4{\\int }_{1}^{9}{e}^{u}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & ={\\int }_{1}^{9}{e}^{u}\\,\\text{d}u \\\\  & ={e}^{u}\\,{|}_{1}^{9} \\\\  & ={e}^{9}-{e}^{1} \\\\  & ={e}^{9}-e\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288230 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adf2383e-b2ab-5234-8218-fdaca22abdd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\ln(4)}" :db/id #edb/ref 17592186288232}] :answer-field/correct {:answer/id #uuid "adf2383e-b2ab-5234-8218-fdaca22abdd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{\\ln(4)}" :db/id #edb/ref 17592186288232} :answer-field/id #uuid "1c31891e-272c-560c-b179-5b67904a518e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288231}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a036849-2d96-558d-8887-92c21fd6ff91" :question/math-academy-id "q-349631" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2\\cdot {4}^{1-x}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=1-x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,-\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2\\cdot {4}^{1-x}\\,\\text{d}x & ={\\int }_{1}^{0}2\\cdot {4}^{u}(-1)\\text{d}u \\\\  & =-2{\\int }_{1}^{0}{4}^{u}\\,\\text{d}u \\\\  & =-2(\\frac{{4}^{u}}{\\operatorname{ln}⁡4}){|}_{1}^{0} \\\\  & =-\\frac{2}{\\operatorname{ln}⁡4}({4}^{0}-{4}^{1}) \\\\  & =-\\frac{2}{\\operatorname{ln}⁡4}(1-4) \\\\  & =\\frac{6}{\\operatorname{ln}⁡4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288233 :knowledge-point/_questions [{:knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32b79544-65d9-5d51-ab1a-d9576e66e17a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5\\ln(5)}" :db/id #edb/ref 17592186288235}] :answer-field/correct {:answer/id #uuid "32b79544-65d9-5d51-ab1a-d9576e66e17a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{24}{5\\ln(5)}" :db/id #edb/ref 17592186288235} :answer-field/id #uuid "3b9f63bc-d753-56e7-8bac-650ac59c69fa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288234}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "98b6b759-0da2-5530-96cf-b1f6f258078f" :question/math-academy-id "q-349646" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}{5}^{x-1}\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "If we let $u=x-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $-1$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{5}^{x-1}\\,\\text{d}x & ={\\int }_{-1}^{1}{5}^{u}\\text{d}u \\\\  & =\\frac{{5}^{u}}{\\operatorname{ln}⁡5}\\,{|}_{-1}^{1} \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}({5}^{1}-{5}^{-1}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡5}(5-\\frac{1}{5}) \\\\  & =\\frac{24}{5\\operatorname{ln}⁡5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288236 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0478a76-f026-5042-b219-7554640a9b59" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{{z}^{2}}}{2}+C" :db/id #edb/ref 17592186288238} {:answer/id #uuid "2eeaeecd-db13-5383-82aa-e7cdb54a6d97" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{2z}+C" :db/id #edb/ref 17592186288239} {:answer/id #uuid "11ec652d-141f-5397-894c-8f1886bac7f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{z}}{2}+C" :db/id #edb/ref 17592186288240} {:answer/id #uuid "dbbb1c14-8ef9-5d6a-9a03-aeaa24a829ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186288241} {:answer/id #uuid "11f5bc15-41ab-5be6-bba4-591eea7c6199" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2z}+C" :db/id #edb/ref 17592186288242}] :answer-field/correct {:answer/id #uuid "dbbb1c14-8ef9-5d6a-9a03-aeaa24a829ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2z}}{2}+C" :db/id #edb/ref 17592186288241} :answer-field/id #uuid "2939e714-31c1-57c9-9eca-bcdc26640e90" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288237}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "84822455-4b93-5a12-af5e-c06a07dea4e0" :question/math-academy-id "q-51160" :question/problem "$\\int {e}^{z}{e}^{z}\\,\\text{d}z=$" :question/worked-solution "First, we notice that\n\n$$\n\\int {e}^{z}{e}^{z}\\,\\text{d}z=\\int {e}^{2z}\\,\\text{d}z.\n$$\n\nIf we let $u=2z$, then\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=2\\,⟹\\,\\text{d}z=\\frac{1}{2}\\text{d}u.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int {e}^{2z}\\,\\text{d}z & =\\int {e}^{2z}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{2z}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {e}^{u}+C \\\\  & =\\frac{{e}^{2z}}{2}+C\\end{aligned}\\end{aligned}\n$$"}]}
