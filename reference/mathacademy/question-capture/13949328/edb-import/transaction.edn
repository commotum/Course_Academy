[{:db/id "q-6816/selection/28d4ba84f84bb7cb6843ec0df3b311c80740fac95884a96ba60826e244820b75" :answer/id #uuid "5d8106ae-4c2f-5db9-977f-aeb769344f5e" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-6816/selection/a60c74b10dbfeb18f6554b820139a05af96cf3f33173758365535188f3be0c1c" :answer/id #uuid "320945e9-703f-5067-a062-14673ea486c5" :answer/type :answer.type/math :answer/value "{e}^{-3}" :db/ensure [:answer/validate]} {:db/id "q-6816/selection/538c8670cb439d1a98a40b4c40205e43f4702337d59966894e4057eb0e28d3b2" :answer/id #uuid "a65fc94c-0deb-5a29-a6ff-e6e6aad0bed7" :answer/type :answer.type/math :answer/value "{e}^{-2}" :db/ensure [:answer/validate]} {:db/id "q-6816/selection/a6c24763be7bc10534ff181db6f9bbc4ce5918a064f5ae69027c6cc73fedb0f0" :answer/id #uuid "0a9a48f7-eb5f-5641-8a82-77104ffe3305" :answer/type :answer.type/math :answer/value "2{e}^{-2}" :db/ensure [:answer/validate]} {:db/id "q-6816/selection/20d7b8148e910cc0d14e218a61107183bf2602e53cd3416ec43c523997ef1a51" :answer/id #uuid "edefa64c-fcbd-59cb-9d3c-9be1fbec8796" :answer/type :answer.type/math :answer/value "\\frac{{e}^{-3}}{4}" :db/ensure [:answer/validate]} {:db/id "q-6816/selection" :answer-field/id #uuid "7624c062-786d-5f09-942a-66bf33c08d66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-6816/selection/a60c74b10dbfeb18f6554b820139a05af96cf3f33173758365535188f3be0c1c" :answer-field/choices ["q-6816/selection/28d4ba84f84bb7cb6843ec0df3b311c80740fac95884a96ba60826e244820b75" "q-6816/selection/a60c74b10dbfeb18f6554b820139a05af96cf3f33173758365535188f3be0c1c" "q-6816/selection/538c8670cb439d1a98a40b4c40205e43f4702337d59966894e4057eb0e28d3b2" "q-6816/selection/a6c24763be7bc10534ff181db6f9bbc4ce5918a064f5ae69027c6cc73fedb0f0" "q-6816/selection/20d7b8148e910cc0d14e218a61107183bf2602e53cd3416ec43c523997ef1a51"] :db/ensure [:answer-field/validate]} {:db/id "q-6816" :question/id #uuid "1990413b-418b-52e9-8b02-51eb17f5b4b1" :question/math-academy-id "q-6816" :question/problem "For the parametric curve \n\n$$\nx={e}^{2t},\\,y=({t}^{2}-1){e}^{-t},\\,-\\infty <t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2{e}^{2t},\\,{y}^{′}(t)=(1+2t-{t}^{2}){e}^{-t}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{(1+2t-{t}^{2}){e}^{-t}}{2{e}^{2t}}=\\frac{1}{2}(1+2t-{t}^{2}){e}^{-3t}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1}{2}(1+2(1)-(1)^{2}){e}^{-3(1)} \\\\  & =\\frac{1}{2}(1+2-1){e}^{-3} \\\\  & ={e}^{-3}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-6816/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-6816"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20851/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "d8c91dec-b8f6-5ed9-9ab7-8e0dffe93718" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-20851/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "bf8a1dd7-09b0-507a-ba14-0b7c7ed35dbd" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-20851/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "f71a3229-0f8c-5a8d-8583-eb2af6ff898b" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-20851/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "f3f44842-47bf-5477-a1aa-297338f081a2" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-20851/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "739890dd-80a1-5792-b127-7200eb833cff" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-20851/selection" :answer-field/id #uuid "b44383b4-11f8-51bc-bcac-0b4f94af9000" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20851/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-20851/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-20851/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-20851/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-20851/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-20851/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-20851" :question/id #uuid "a11f695c-004e-57f4-b1f5-cd09434f69e2" :question/math-academy-id "q-20851" :question/problem "For the parametric curve \n\n$$\nx=2\\sqrt{t},\\,y=12t+1,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{1}{\\sqrt{t}},\\,{y}^{′}(t)=12.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{12}{\\frac{1}{\\sqrt{t}}}=12\\sqrt{t}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =12\\sqrt{1} \\\\  & =12\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-20851/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-20851"] :db/ensure [:knowledge-point/validate]} {:db/id "q-20988/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "6df64199-19a6-5cdf-9d95-abcb09a30ca5" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-20988/selection/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" :answer/id #uuid "4dba3a05-92fc-5355-8b0c-383f8aa219c9" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "q-20988/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer/id #uuid "0e43e99e-718a-5c86-b678-70658ef39a88" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-20988/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" :answer/id #uuid "a336f0d3-e7dd-5861-96d6-b076eb40ace7" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-20988/selection/fba3f071a3bf374a14af37c3a2bf03fdd1045070379d4ec39535030fd010d58a" :answer/id #uuid "190e3513-48de-5f61-9b0c-10fd1565b1fe" :answer/type :answer.type/math :answer/value "\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "q-20988/selection" :answer-field/id #uuid "d5d59da5-e499-5d62-bd44-d06a4ae2d2b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-20988/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" :answer-field/choices ["q-20988/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-20988/selection/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" "q-20988/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" "q-20988/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" "q-20988/selection/fba3f071a3bf374a14af37c3a2bf03fdd1045070379d4ec39535030fd010d58a"] :db/ensure [:answer-field/validate]} {:db/id "q-20988" :question/id #uuid "086f12ac-4759-5fbb-bb3d-6ee45cc6ce1f" :question/math-academy-id "q-20988" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949328/assets/0b77bdde611689095cdea6a3a08ce9828b9e20040283dc0c251250538a5cfba3.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=3{t}^{2}-2t,\\,y={t}^{2}-1,\\,-\\infty <t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=2.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=6t-2,\\,{y}^{′}(t)=2t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2t}{6t-2}=\\frac{t}{3t-1}.\n$$\n\nAt the point where $t=2$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{2}{3(2)-1} \\\\  & =\\frac{2}{6-1} \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-20988/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-20988"] :db/ensure [:knowledge-point/validate]} {:db/id "q-6836/selection/4fa71d50ed7ef4ca31b6f9c30efacab813ab3f5e05dba0280f4f995a609b8546" :answer/id #uuid "5abc5a1c-93cb-5968-afe5-6138865a6ae2" :answer/type :answer.type/math :answer/value "\\frac{dy}{dx}=-\\frac{4}{5}\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-6836/selection/8064613f1687a69480d38308504489a5508e2be5430829ad18131aaebcac4189" :answer/id #uuid "e4e87762-ab3c-595d-95c8-e17b533ffa21" :answer/type :answer.type/math :answer/value "\\frac{dy}{dx}=\\frac{5}{4}\\operatorname{tan}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-6836/selection/6fefe9cde69971f507bcbd41f066a6ea2474d815f398657924b9ca7279131307" :answer/id #uuid "f8f6723c-d43d-5f93-85ed-a818c30ba834" :answer/type :answer.type/math :answer/value "\\frac{dy}{dx}=-\\frac{5}{4}\\operatorname{cot}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-6836/selection/77e77b30ab18316c8cd1189415bc7001e9d1b6ae3ea6c4d8ff48158be5490222" :answer/id #uuid "a5ebbcf8-2d88-56c2-87ee-410104c80e22" :answer/type :answer.type/math :answer/value "\\frac{dy}{dx}=-\\frac{5}{4}\\operatorname{tan}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-6836/selection/034bb732abdc88db7e87a559ec540526d6e91ba9c248b0f57b03183e9a19504f" :answer/id #uuid "e385bf7e-c972-5a34-9afd-9c71395037b5" :answer/type :answer.type/math :answer/value "\\frac{dy}{dx}=-\\frac{4}{5}\\operatorname{tan}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-6836/selection" :answer-field/id #uuid "a5a22319-9eb8-56ab-b60c-fa724f5d5ee7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-6836/selection/77e77b30ab18316c8cd1189415bc7001e9d1b6ae3ea6c4d8ff48158be5490222" :answer-field/choices ["q-6836/selection/4fa71d50ed7ef4ca31b6f9c30efacab813ab3f5e05dba0280f4f995a609b8546" "q-6836/selection/8064613f1687a69480d38308504489a5508e2be5430829ad18131aaebcac4189" "q-6836/selection/6fefe9cde69971f507bcbd41f066a6ea2474d815f398657924b9ca7279131307" "q-6836/selection/77e77b30ab18316c8cd1189415bc7001e9d1b6ae3ea6c4d8ff48158be5490222" "q-6836/selection/034bb732abdc88db7e87a559ec540526d6e91ba9c248b0f57b03183e9a19504f"] :db/ensure [:answer-field/validate]} {:db/id "q-6836" :question/id #uuid "b50faac3-57b3-5534-a1d3-8f76087cb51c" :question/math-academy-id "q-6836" :question/problem "For the parametric curve \n\n$$\nx=12\\operatorname{sin}⁡\\theta ,\\,y=15\\operatorname{cos}⁡\\theta ,\\,0\\le \\theta <2\\pi ,\n$$\n\n calculate $\\frac{dy}{dx}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(\\theta )=12\\operatorname{cos}⁡\\theta ,\\,{y}^{′}(\\theta )=-15\\operatorname{sin}⁡\\theta .\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{-15\\operatorname{sin}⁡\\theta }{12\\operatorname{cos}⁡\\theta }=-\\frac{5}{4}\\operatorname{tan}⁡\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-6836/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-6836"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353341/field-1/ab22b83e290700d204faf1095cfc25a4b648955dede5993efb51bc6a54cd3128" :answer/id #uuid "fc1b76fb-62f5-5fe4-970b-d337f5125634" :answer/type :answer.type/math :answer/value "-\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "q-353341/field-1" :answer-field/id #uuid "8ce3f65f-2ff0-5ad3-9dd8-0d12e0552286" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353341/field-1/ab22b83e290700d204faf1095cfc25a4b648955dede5993efb51bc6a54cd3128" :answer-field/choices ["q-353341/field-1/ab22b83e290700d204faf1095cfc25a4b648955dede5993efb51bc6a54cd3128"] :db/ensure [:answer-field/validate]} {:db/id "q-353341" :question/id #uuid "6f44a7e1-514a-5573-bc6d-02d50696e90b" :question/math-academy-id "q-353341" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949328/assets/1817c65aea37112d93f2935801a0e7dcd654706a72f729810272f48e95d39665.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=5\\operatorname{sin}⁡2t,\\,y=\\sqrt{3}\\operatorname{cos}⁡2t,\\,0\\le t<2\\pi ,\n$$\n\nfind the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=\\frac{\\pi }{6}.$ Do not round the answer.\n\n$\\frac{dy}{dx}{|}_{t\\,=\\,\\pi /6}=$ \n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=10\\operatorname{cos}⁡2t,\\,{y}^{′}(t)=-2\\sqrt{3}\\operatorname{sin}⁡2t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{(-2\\sqrt{3}\\operatorname{sin}⁡2t)}{10\\operatorname{cos}⁡2t}=-\\frac{\\sqrt{3}}{5}\\operatorname{tan}⁡2t.\n$$\n\nAt the point where $t=\\frac{\\pi }{6}$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\frac{\\sqrt{3}}{5}\\cdot \\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{6}) \\\\  & =-\\frac{\\sqrt{3}}{5}\\cdot \\operatorname{tan}⁡(\\frac{\\pi }{3}) \\\\  & =-\\frac{\\sqrt{3}}{5}\\cdot \\sqrt{3} \\\\  & =-\\frac{3}{5}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-353341/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a"] :knowledge-point/questions ["q-353341"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-20991"] :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-\\frac{1}{4}{t}^{-3/2},\\,{y}^{′}(t)=\\frac{2t{e}^{t}-2{e}^{t}}{4{t}^{2}}=\\frac{{e}^{t}(t-1)}{2{t}^{2}}.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{e}^{t}(t-1)}{2{t}^{2}}\\cdot (-4{t}^{3/2}) \\\\  & =-\\frac{2{e}^{t}(t-1)}{\\sqrt{t}}.\\end{aligned}\n$$\n\nTherefore, when $t=5,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =-\\,\\frac{2{e}^{5}(5-1)}{\\sqrt{5}} \\\\  & =-\\,\\frac{2{e}^{5}\\cdot 4}{\\sqrt{5}} \\\\  & =-\\,\\frac{8{e}^{5}}{\\sqrt{5}}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-348303/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "d7c0bed7-a207-5331-8131-6ff7423443b9" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-348303/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "959affd4-d5f0-5fff-b1d2-e6f856077e47" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-348303/field-1" :answer-field/id #uuid "2ef2b9f2-2901-50b6-91bc-9e88c0f87ff0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348303/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer-field/choices ["q-348303/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" "q-348303/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-348303" :question/id #uuid "9cc31f35-4916-5f32-a8c9-fe9e2d10f162" :question/math-academy-id "q-348303" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949328/assets/59f053b9a122018d78cd9c30f5a53cd67cd2ff645d02ccb6d311e6183e081102.png)\n\nFor the parametric curve \n\n$$\nx={t}^{3}+2{t}^{2},\\,y={t}^{2},\\,-\\infty <t<\\infty ,\n$$\n\nshown above, calculate the slope $m$ of the tangent to the curve at the point where $t=2.$ Do not round the answer.\n\n$m=$\n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=3{t}^{2}+4t,\\,{y}^{′}(t)=2t.\n$$\n\n \n\nSo, we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{2t}{3{t}^{2}+4t} \\\\  & =\\frac{2}{3t+4}.\\end{aligned}\n$$\n\nTherefore, when $t=2,$ the slope $m$ of the tangent to the curve is\n\n$$\n\\begin{aligned}m=\\frac{dy}{dx}\\,{|}_{t\\,=\\,2} & =\\frac{2}{3(2)+4} \\\\  & =\\frac{2}{6+4} \\\\  & =\\frac{2}{10} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-348303/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27"] :knowledge-point/questions ["q-348303"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102922/selection/c7fd528e8df0687ef5afa93711830886cdd6b34ff985c6cd64becd148e3904ef" :answer/id #uuid "ec559a54-c83a-548a-b6cd-9cf419698065" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-102922/selection/80b1eb8127296d0becd444e42278e8c380c60c53404da68d665f294b73886a31" :answer/id #uuid "65e7f290-b617-5197-a61e-57d0ea809855" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "q-102922/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" :answer/id #uuid "788d8d49-dce4-50ed-af51-f63d12773e6b" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-102922/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "945e0974-538c-534c-8e64-b72277388871" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-102922/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "35fd903a-d729-526b-bb61-9607a7ea00fc" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-102922/selection" :answer-field/id #uuid "963457c2-cfbd-557d-bf67-09ed76aa13de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102922/selection/c7fd528e8df0687ef5afa93711830886cdd6b34ff985c6cd64becd148e3904ef" :answer-field/choices ["q-102922/selection/c7fd528e8df0687ef5afa93711830886cdd6b34ff985c6cd64becd148e3904ef" "q-102922/selection/80b1eb8127296d0becd444e42278e8c380c60c53404da68d665f294b73886a31" "q-102922/selection/ac9362c9c743a0d4cd03c825418c9d77629147a5815c12295606faadbe8a8744" "q-102922/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-102922/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-102922" :question/id #uuid "3a94c8b6-af79-5573-a1c6-6e6e990a28cb" :question/math-academy-id "q-102922" :question/problem "For the parametric curve \n\n$$\nx=\\operatorname{sin}⁡2t,\\,y={sin}^{2}⁡t,\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{12}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2\\operatorname{cos}⁡2t,\\,{y}^{′}(t)=2\\operatorname{sin}⁡t\\operatorname{cos}⁡t=\\operatorname{sin}⁡2t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\operatorname{sin}⁡2t}{2\\operatorname{cos}⁡2t} \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡2t.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{12},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1}{2}\\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{3} \\\\  & =\\frac{\\sqrt{3}}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102922/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27"] :knowledge-point/questions ["q-102922"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15465/selection/c24232afb9b5ba9c1cc5619273d09a5676ecc0aa44d228853ae38c1edcbf08e1" :answer/id #uuid "0437357f-68d7-5270-8cfd-e7be653596c1" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "q-15465/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "92aa918d-c8de-5fbe-9553-727cd6f9c9fd" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-15465/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "a9a4279b-0f5c-5b97-9e83-b00052f39697" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-15465/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "323a20cf-27d3-5675-88ae-ee3868536fac" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-15465/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3a692b14-0543-5852-9204-5dce1f445d61" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-15465/selection" :answer-field/id #uuid "9959376b-5bc9-5d3a-9579-da6049626b2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15465/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-15465/selection/c24232afb9b5ba9c1cc5619273d09a5676ecc0aa44d228853ae38c1edcbf08e1" "q-15465/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-15465/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-15465/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-15465/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-15465" :question/id #uuid "16fc9f31-33f6-5972-9529-3afa5f1e1dc8" :question/math-academy-id "q-15465" :question/problem "For the parametric curve \n\n$$\nx=t+\\operatorname{sin}⁡t,\\,y=t+\\operatorname{cos}⁡t,\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{2}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=1+\\operatorname{cos}⁡t,\\,{y}^{′}(t)=1-\\operatorname{sin}⁡t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1-\\operatorname{sin}⁡t}{1+\\operatorname{cos}⁡t}.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{2},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1-\\operatorname{sin}⁡(\\frac{\\pi }{2})}{1+\\operatorname{cos}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{1-1}{1+0} \\\\  & =0\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15465/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27"] :knowledge-point/questions ["q-15465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15475/selection/9fb29a0b5540e3b6b7f39ffe3d5c85cffc24af3aa7d7311d97051bae15101f29" :answer/id #uuid "7c99c21d-890e-534d-84e3-a21b6c050b2f" :answer/type :answer.type/math :answer/value "\\frac{8}{\\sqrt{27e}}" :db/ensure [:answer/validate]} {:db/id "q-15475/selection/a5eeb22d9e5ed2ba861e92c1adb78a4afa9f3ceee637d9e1d61058c21ad23c88" :answer/id #uuid "434a3446-cd9c-57c9-938d-f0b5366df13f" :answer/type :answer.type/math :answer/value "\\frac{4}{\\sqrt{9e}}" :db/ensure [:answer/validate]} {:db/id "q-15475/selection/eecbb837608e686664c90462ebe9aa81dc4824d3d6d6052b27a21a84c0582a6b" :answer/id #uuid "6dc7e053-d1d4-575f-bd42-f44eb987debe" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{9e}}{4}" :db/ensure [:answer/validate]} {:db/id "q-15475/selection/9ada43d33326fc848a84145da1ce33ed5facf69657040fdc1ac395e41caba722" :answer/id #uuid "48c7f3ca-6131-550c-8143-08ab3e1a15c6" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{9}{8e}}" :db/ensure [:answer/validate]} {:db/id "q-15475/selection/80061e3a679d8c7cfd793329c882f11af1a3246372c0865ab19e9cbb95c48938" :answer/id #uuid "2fc57ba9-c166-5c1e-837f-4646755994d3" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{8e}{27}}" :db/ensure [:answer/validate]} {:db/id "q-15475/selection" :answer-field/id #uuid "ca4903a3-8a91-5e14-a591-a110458c9f28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15475/selection/9fb29a0b5540e3b6b7f39ffe3d5c85cffc24af3aa7d7311d97051bae15101f29" :answer-field/choices ["q-15475/selection/9fb29a0b5540e3b6b7f39ffe3d5c85cffc24af3aa7d7311d97051bae15101f29" "q-15475/selection/a5eeb22d9e5ed2ba861e92c1adb78a4afa9f3ceee637d9e1d61058c21ad23c88" "q-15475/selection/eecbb837608e686664c90462ebe9aa81dc4824d3d6d6052b27a21a84c0582a6b" "q-15475/selection/9ada43d33326fc848a84145da1ce33ed5facf69657040fdc1ac395e41caba722" "q-15475/selection/80061e3a679d8c7cfd793329c882f11af1a3246372c0865ab19e9cbb95c48938"] :db/ensure [:answer-field/validate]} {:db/id "q-15475" :question/id #uuid "56044f7d-8044-5dcb-9e59-27af5ccb11e6" :question/math-academy-id "q-15475" :question/problem "For the parametric curve \n\n$$\nx={e}^{1/t},\\,y=\\frac{1}{\\sqrt{{t}^{2}-1}},\\,1<t<\\infty ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=2.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=-\\frac{1}{{t}^{2}}{e}^{1/t},\\,{y}^{′}(t)=-\\frac{t}{({t}^{2}-1)^{3/2}}.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(-\\frac{t}{({t}^{2}-1)^{3/2}})}{(-\\frac{1}{{t}^{2}}{e}^{1/t})} \\\\  & =\\frac{{t}^{3}{e}^{-1/t}}{({t}^{2}-1)^{3/2}}.\\end{aligned}\n$$\n\nTherefore, when $t=2,$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{{2}^{3}{e}^{-1/2}}{({2}^{2}-1)^{3/2}} \\\\  & =\\frac{8}{{3}^{3/2}\\sqrt{e}} \\\\  & =\\frac{8}{\\sqrt{27e}}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15475/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27"] :knowledge-point/questions ["q-15475"] :db/ensure [:knowledge-point/validate]}]
