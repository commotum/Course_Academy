f94-368cfc9a666e" :question/math-academy-id "q-278274" :question/problem "Solve the inequality ${x}^{2}\\cdot {9}^{2x-3}\\le {9}^{2x+1}.$\n\n{{field-1}}\n\n$\\le x$ \n{{field-2}}{{field-3}}" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {9}^{2x-3} & \\le {9}^{2x+1} \\\\ {x}^{2}\\cdot {9}^{2x-3}-{9}^{2x+1} & \\le 0 \\\\ {x}^{2}\\cdot {9}^{2x-3}-{9}^{4}\\cdot {9}^{2x-3} & \\le 0 \\\\ ({x}^{2}-{9}^{4})\\cdot {9}^{2x-3} & \\le 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${9}^{2x-3}$ and get\n\n$$\n\\begin{aligned}\\frac{({x}^{2}-{9}^{4})\\cdot {9}^{2x-3}}{{9}^{2x-3}} & \\le \\frac{0}{{9}^{2x-3}} \\\\ {x}^{2}-{9}^{4} & \\le 0.\\end{aligned}\n$$\n\nFinally, we can solve this inequality using familiar methods:\n\n$$\n\\begin{aligned}{x}^{2}-{9}^{4} & \\le 0 \\\\ {x}^{2} & \\le {9}^{4} \\\\ \\sqrt{{x}^{2}} & \\le \\sqrt{{9}^{4}} \\\\ |x| & \\le {9}^{2} \\\\ |x| & \\le 81\\end{aligned}\n$$\n\nThe solution to the inequality above is $-81\\le x<81.$"}] [{:db/id #edb/ref 17592186295258 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with Different Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22f37762-e5f2-562c-86bf-73a1aedfde40" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186295260} {:answer/id #uuid "a0ef5fb8-3414-51fd-adf6-750f895d4088" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295261}] :answer-field/correct {:answer/id #uuid "a0ef5fb8-3414-51fd-adf6-750f895d4088" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295261} :answer-field/id #uuid "b4a10da5-e2a7-52b8-aeeb-6f404edbc654" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295259} {:answer-field/choices [{:answer/id #uuid "080006ba-bfe7-58c2-b8ab-5bd3eb0c2eaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186295263}] :answer-field/correct {:answer/id #uuid "080006ba-bfe7-58c2-b8ab-5bd3eb0c2eaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186295263} :answer-field/id #uuid "fd495d56-2b46-5e9e-bbbd-f049e25db04c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295262} {:answer-field/choices [{:answer/id #uuid "2d156592-768e-54df-9524-c853ff1f1ba4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295265}] :answer-field/correct {:answer/id #uuid "2d156592-768e-54df-9524-c853ff1f1ba4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295265} :answer-field/id #uuid "c44442ff-4d2b-57bd-8eb0-c6df19324b81" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295264}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "57bdf8c1-be66-5c66-b4df-025f362289b1" :question/math-academy-id "q-278282" :question/problem "Solve the inequality ${x}^{4}\\cdot {4}^{3x-5}\\ge {4}^{3x-1}.$\n\n$x\\le ${{field-1}}\n$\\,\\text{or}\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{4}\\cdot {4}^{3x-5} & \\ge {4}^{3x-1} \\\\ {x}^{4}\\cdot {4}^{3x-5}-{4}^{3x-1} & \\ge 0 \\\\ {x}^{4}\\cdot {4}^{3x-5}-{4}^{4}\\cdot {4}^{3x-5} & \\ge 0 \\\\ ({x}^{4}-{4}^{4}){4}^{3x-5} & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${4}^{3x-5}$ and get\n\n$$\n\\begin{aligned}\\frac{({x}^{4}-{4}^{4}){4}^{3x-5}}{{4}^{3x-5}} & \\ge \\frac{0}{{4}^{3x-5}} \\\\ {x}^{4}-{4}^{4} & \\ge 0.\\end{aligned}\n$$\n\nFinally, we can solve this inequality using familiar methods:\n\n$$\n\\begin{aligned}{x}^{4}-{4}^{4} & \\ge 0 \\\\ {x}^{4} & \\ge {4}^{4} \\\\ \\sqrt[4]{{x}^{4}} & \\ge \\sqrt[4]{{4}^{4}} \\\\ |x| & \\ge 4\\end{aligned}\n$$\n\nTherefore, the solution to the inequality above is  $x\\le -4$ or $x\\ge 4.$"}] [{:db/id #edb/ref 17592186295266 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac76d62e-6bea-515a-af06-e4fae7bc1338" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with Different Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37298271-4e88-56a6-86ea-d728f3b7d46d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295268}] :answer-field/correct {:answer/id #uuid "37298271-4e88-56a6-86ea-d728f3b7d46d" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295268} :answer-field/id #uuid "91866a0d-a6bc-5b4e-bddc-ed9d73a9f383" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295267} {:answer-field/choices [{:answer/id #uuid "492527d6-a45f-5416-afed-791451b20dc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186295270}] :answer-field/correct {:answer/id #uuid "492527d6-a45f-5416-afed-791451b20dc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\ge" :db/id #edb/ref 17592186295270} :answer-field/id #uuid "aa052b9f-ec36-54c5-803f-3be9db1bd743" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295269} {:answer-field/choices [{:answer/id #uuid "5fec2bb3-9f5a-5067-974d-535c08c4ceea" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295272}] :answer-field/correct {:answer/id #uuid "5fec2bb3-9f5a-5067-974d-535c08c4ceea" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295272} :answer-field/id #uuid "4ee8a229-ab96-5ab7-beda-6eddbe41dbbd" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186295271}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b0470861-1a12-5f46-938a-4e442cd378ea" :question/math-academy-id "q-278284" :question/problem "Solve the inequality ${x}^{2}\\cdot {3}^{2x-5}\\ge {3}^{2x-3}.$\n\n$x\\le ${{field-1}}\n$\\,\\text{or}\\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {3}^{2x-5} & \\ge {3}^{2x-3} \\\\ {x}^{2}\\cdot {3}^{2x-5}-{3}^{2x-3} & \\ge 0 \\\\ {x}^{2}\\cdot {3}^{2x-5}-{3}^{2}\\cdot {3}^{2x-5} & \\ge 0 \\\\ ({x}^{2}-{3}^{2}){3}^{2x-5} & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${3}^{2x-5}$ and get\n\n$$\n\\begin{aligned}\\frac{({x}^{2}-{3}^{2}){2}^{2x-5}}{{3}^{2x-5}} & \\ge \\frac{0}{{3}^{2x-5}} \\\\ {x}^{2}-{3}^{2} & \\ge 0.\\end{aligned}\n$$\n\nFinally, we can solve this inequality using familiar methods:\n\n$$\n\\begin{aligned}{x}^{2}-{3}^{2} & \\ge 0 \\\\ {x}^{2} & \\ge {3}^{2} \\\\ \\sqrt{{x}^{2}} & \\ge \\sqrt{{3}^{2}} \\\\ |x| & \\ge 3\\end{aligned}\n$$\n\nTherefore, the solution to the inequality above is  $x\\le -3$ or $x\\ge 3.$"}] [{:db/id #edb/ref 17592186295273 :knowledge-point/_questions [{:knowledge-point/id #uuid "479e5736-efe1-5e94-929f-3dcd6d13a733" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with the Same Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f86e2bc-27e3-5863-9dd6-0298bea13623" :answer/type {:db/ident :answer.type/math} :answer/value "x\\le -1" :db/id #edb/ref 17592186295275} {:answer/id #uuid "1e2ae130-21a6-597f-ae28-5e2f25d5337d" :answer/type {:db/ident :answer.type/math} :answer/value "1\\le x\\le 3" :db/id #edb/ref 17592186295276} {:answer/id #uuid "6e5d9f80-3d24-5bd7-be1e-38559568d10b" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186295277} {:answer/id #uuid "56353a35-da6b-5ac0-8b32-6f2444646c80" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\le x\\le 3" :db/id #edb/ref 17592186295278} {:answer/id #uuid "20dd2814-e055-5d8c-9a60-40fcf194662c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le -1$ or $x\\ge 3$" :db/id #edb/ref 17592186295279}] :answer-field/correct {:answer/id #uuid "20dd2814-e055-5d8c-9a60-40fcf194662c" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\le -1$ or $x\\ge 3$" :db/id #edb/ref 17592186295279} :answer-field/id #uuid "015969ed-d686-5d7d-b6ff-f5e8e4ef6912" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295274}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f48d4b46-71bc-5848-b1c9-c4123817afbb" :question/math-academy-id "q-88239" :question/problem "Solve the inequality $-2x{e}^{5x}-3{e}^{5x}\\ge -{x}^{2}{e}^{5x}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}-2x{e}^{5x}-3{e}^{5x} & \\ge -{x}^{2}{e}^{5x} \\\\ {x}^{2}{e}^{5x}-2x{e}^{5x}-3{e}^{5x} & \\ge 0 \\\\ ({x}^{2}-2x-3){e}^{5x} & \\ge 0 \\\\ (x+1)(x-3){e}^{5x} & \\ge 0\\end{aligned}\n$$\n\nNow, we divide both sides by ${e}^{5x}$ and get\n\n$$\n(x+1)(x-3)\\ge 0.\n$$\n\nThis represents an upwards parabola whose roots are at $x=-1$ and $x=3.$ The parabola is above the $x$-axis when $x\\le -1$ or $x\\ge 3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14036850/assets/6aca0f7c055a5f326c2d0d3bc65b6e68a90c8cb496bc1934dbae6093d0d71f96.png)\n\nTherefore, the solution is $x\\le -1$ or $x\\ge 3.$"}] [{:db/id #edb/ref 17592186295280 :knowledge-point/_questions [{:knowledge-point/id #uuid "479e5736-efe1-5e94-929f-3dcd6d13a733" :knowledge-point/title "Solving an Inequality Involving Exponential Functions with the Same Exponents and a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6bf2577-e0ac-54c6-b1f5-564a25b28161" :answer/type {:db/ident :answer.type/math} :answer/value "x>\\sqrt{3}" :db/id #edb/ref 17592186295282} {:answer/id #uuid "3c2e0781-c7f4-5cd0-ba3c-b79b196f5b29" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sqrt{3}<x<2\\sqrt{3}" :db/id #edb/ref 17592186295283} {:answer/id #uuid "839e1e0b-9680-5415-bc0a-1f7ac2aa610c" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-2\\sqrt{3}$ or $x>2\\sqrt{3}$" :db/id #edb/ref 17592186295284} {:answer/id #uuid "09f018ae-44fc-5a62-a39a-9e3fcc9dc3d2" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-2$ or $x>2$" :db/id #edb/ref 17592186295285} {:answer/id #uuid "14318fb7-a5d4-5926-96af-df57cbadc68b" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-\\sqrt{3}$ or $x>\\sqrt{3}$" :db/id #edb/ref 17592186295286}] :answer-field/correct {:answer/id #uuid "839e1e0b-9680-5415-bc0a-1f7ac2aa610c" :answer/type {:db/ident :answer.type/text} :answer/value "$x<-2\\sqrt{3}$ or $x>2\\sqrt{3}$" :db/id #edb/ref 17592186295284} :answer-field/id #uuid "dcdcd42e-47de-59b7-a9c1-4ac020a0c88d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186295281}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "99779233-4022-57ea-8b13-fcf906c4aeff" :question/math-academy-id "q-88308" :question/problem "Solve the inequality $-{9}^{2x-4}{x}^{2}<-5\\cdot {9}^{2x-4}-7\\cdot {9}^{2x-4}.$" :question/worked-solution "First, we move all the terms to the left side of the inequality and factor:\n\n$$\n\\begin{aligned}-{9}^{2x-4}{x}^{2} & <-5\\cdot {9}^{2x-4}-7\\cdot {9}^{2x-4} \\\\ -{9}^{2x-4}{x}^{2}+5\\cdot {9}^{2x-4}+7\\cdot {9}^{2x-4} & <0 \\\\ (-{x}^{2}+5+7){9}^{2x-4} & <0 \\\\ (12-{x}^{2}){9}^{2x-4} & <0\\end{aligned}\n$$\n\nNow, we divide both sides by ${9}^{2x-4}$ and solve the resulting inequality using familiar techniques:\n\n$$\n\\begin{aligned}12-{x}^{2} & <0 \\\\ -{x}^{2} & <-12 \\\\ {x}^{2} & >12 \\\\ \\sqrt{{x}^{2}} & >\\sqrt{12} \\\\ |x| & >2\\sqrt{3}\\end{aligned}\n$$\n\nThe solution to the inequality above is $x<-2\\sqrt{3}$ or $x>2\\sqrt{3}.$"}]}
