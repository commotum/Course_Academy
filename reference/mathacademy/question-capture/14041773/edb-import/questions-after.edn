#{[{:db/id #edb/ref 17592186314384 :knowledge-point/_questions [{:knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2" :knowledge-point/title "Determining the Equation of a Parabola Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c9da014-44d0-5d0b-9a5a-25c161d8f9b4" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{25}{8}y" :db/id #edb/ref 17592186314386} {:answer/id #uuid "cfc7e3d0-e6e9-5a29-9f97-bc162631e104" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{5}{2}y" :db/id #edb/ref 17592186314387} {:answer/id #uuid "f91e465e-1154-518a-9b61-9fd173eb4474" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{5}y" :db/id #edb/ref 17592186314388} {:answer/id #uuid "df4656fb-ec5e-581a-b0e5-1f0213745e1e" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{25}{2}y" :db/id #edb/ref 17592186314389} {:answer/id #uuid "73c3d29a-150d-504a-9ddc-e357acf09564" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{4}{5}y" :db/id #edb/ref 17592186314390}] :answer-field/correct {:answer/id #uuid "df4656fb-ec5e-581a-b0e5-1f0213745e1e" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{25}{2}y" :db/id #edb/ref 17592186314389} :answer-field/id #uuid "eaede806-c4b7-5bd2-892b-2b3bb1bf2fdc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314385}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "00496325-7ca7-52a8-99fe-1fb2d9042d58" :question/math-academy-id "q-115434" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-5,2).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-5,2),$ so we can substitute $x=-5$ and $y=2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-5)^{2} & =4p(2) \\\\ 25 & =8p \\\\ p & =\\frac{25}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(\\frac{25}{8})y \\\\ {x}^{2} & =\\frac{25}{2}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314391 :knowledge-point/_questions [{:knowledge-point/id #uuid "281514e9-6e16-5b21-ba4e-503991d811c2" :knowledge-point/title "Determining the Equation of a Parabola Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bfb10fe-0792-58b5-b2ed-6bdb39d9db8c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-2y" :db/id #edb/ref 17592186314393} {:answer/id #uuid "3cb453a6-6757-51dd-ab8e-56c6134071d1" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-8y" :db/id #edb/ref 17592186314394} {:answer/id #uuid "187617bf-f931-5748-a295-1d1be9a6a76c" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=2y" :db/id #edb/ref 17592186314395} {:answer/id #uuid "03db0576-8fbc-50f2-bb4b-a003bf8835e9" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-y" :db/id #edb/ref 17592186314396} {:answer/id #uuid "9a290707-c973-573e-80a3-85e32f7c914d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{4}y" :db/id #edb/ref 17592186314397}] :answer-field/correct {:answer/id #uuid "3cb453a6-6757-51dd-ab8e-56c6134071d1" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-8y" :db/id #edb/ref 17592186314394} :answer-field/id #uuid "e19982a5-9c96-5f9b-9905-c39b3df156eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314392}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9f4ec140-fba6-58af-82af-5ed3ab6fa601" :question/math-academy-id "q-115438" :question/problem "Find the equation of the downward-opening parabola that has its vertex at $(0,0)$ and which passes through the point $(-4,-2).$" :question/worked-solution "We know that for any upward or downward-opening parabola whose vertex is $(0,0),$ the general standard equation is given by\n\n$$\n{x}^{2}=4py\n$$\n\nwhere $p$ is a constant.\n\nWe're told that the given parabola passes through the point $(-4,-2),$ so we can substitute $x=-4$ and $y=-2$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ (-4)^{2} & =4p(-2) \\\\ 16 & =-8p \\\\ p & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4py \\\\ {x}^{2} & =4(-2)y \\\\ {x}^{2} & =-8y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314398 :knowledge-point/_questions [{:knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55d30845-144c-5594-bfe7-aab95535b23b" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=4(y+2)" :db/id #edb/ref 17592186314400} {:answer/id #uuid "103c425e-5f84-57f3-9eb9-14632b263cb2" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-4(y+2)" :db/id #edb/ref 17592186314401} {:answer/id #uuid "20ec061f-7047-57c5-b2cf-21a239364e49" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}=8y" :db/id #edb/ref 17592186314402} {:answer/id #uuid "38373143-7bc7-5c2b-b332-67d67f448d6d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=-8(y+2)" :db/id #edb/ref 17592186314403} {:answer/id #uuid "dc0a70fe-46f0-59f1-9b60-190aa198e9f3" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=8(y+2)" :db/id #edb/ref 17592186314404}] :answer-field/correct {:answer/id #uuid "dc0a70fe-46f0-59f1-9b60-190aa198e9f3" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}=8(y+2)" :db/id #edb/ref 17592186314404} :answer-field/id #uuid "4961be11-7381-5026-be3d-1190121f70aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314399}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "da591489-f66f-5878-bb52-ed14403ce368" :question/math-academy-id "q-11819" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041773/assets/7129baa9dcd41738dbdf04a022b8bbe6a864006896cc76cbee3594ff0a744608.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(0,-2).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x+0)^{2} & =4p(y-(-2)) \\\\ {x}^{2} & =4p(y+2)\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(8,6),$ so we can substitute $x=8$ and $y=6$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}{x}^{2} & =4p(y+2) \\\\ {8}^{2} & =4p(6+2) \\\\ 64 & =32p \\\\ p & =2.\\end{aligned}\n$$\n\nTherefore,  the equation of the parabola is \n\n$$\n\\begin{aligned}{x}^{2} & =4p(y+2) \\\\ {x}^{2} & =4(2)(y+2) \\\\ {x}^{2} & =8(y+2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314405 :knowledge-point/_questions [{:knowledge-point/id #uuid "29e2083d-fe76-5a35-9c3a-7e6ad19ff968" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Passing Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "640c300f-3336-5fa7-afe1-1fc5dc4f8cf8" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}=-(y+5)" :db/id #edb/ref 17592186314407} {:answer/id #uuid "43e18334-8438-5d4e-ae5e-f388cd6cb806" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}=2(y+5)" :db/id #edb/ref 17592186314408} {:answer/id #uuid "aa6283cd-41cb-5cca-b86a-25739cb3716f" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}=y+5" :db/id #edb/ref 17592186314409} {:answer/id #uuid "6c247008-9e00-577d-a1cc-992dc9fa7b31" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}=-2(y+5)" :db/id #edb/ref 17592186314410} {:answer/id #uuid "bcb1dc36-a341-5c9b-9771-98bac75ad543" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5)^{2}=y-3" :db/id #edb/ref 17592186314411}] :answer-field/correct {:answer/id #uuid "aa6283cd-41cb-5cca-b86a-25739cb3716f" :answer/type {:db/ident :answer.type/math} :answer/value "(x-3)^{2}=y+5" :db/id #edb/ref 17592186314409} :answer-field/id #uuid "1bee56fe-d51b-5451-81df-3f7def3afac6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314406}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e4b57b2f-0832-56fa-9e66-624ccf1cee0c" :question/math-academy-id "q-11827" :question/problem "Find the equation of the upward-opening parabola that has its vertex at $(3,-5)$ and which passes through the point $(0,4).$" :question/worked-solution "For any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(3,-5).$ Substituting these into the general standard equation, we get\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y-(-5)) \\\\ (x-3)^{2} & =4p(y+5).\\end{aligned}\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(0,4),$ so we can substitute $x=0$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+5) \\\\ (0-3)^{2} & =4p(4+5) \\\\ 9 & =36p \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+5) \\\\ (x-3)^{2} & =4(\\frac{1}{4})(y+5) \\\\ (x-3)^{2} & =y+5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314412 :knowledge-point/_questions [{:knowledge-point/id #uuid "a991a3b1-6de7-5978-9dd6-cb9eb3f183a6" :knowledge-point/title "Determining the Equation of a Parabola With Non-Origin Vertex Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e3d14d3-3025-5e05-aa90-0a3843374199" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}=-\\frac{16}{3}(y+2)" :db/id #edb/ref 17592186314414} {:answer/id #uuid "187800f5-e561-58d6-b9ab-6a8dc19656b7" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}=-\\frac{8}{3}(y+2)" :db/id #edb/ref 17592186314415} {:answer/id #uuid "73acda42-f933-54b7-85d7-b6a2036fab1a" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}=\\frac{16}{3}(y+2)" :db/id #edb/ref 17592186314416} {:answer/id #uuid "59f11293-15cc-527f-a7e6-4f0ea945b6f5" :answer/type {:db/ident :answer.type/math} :answer/value "(x+2)^{2}=\\frac{8}{3}(y-4)" :db/id #edb/ref 17592186314417} {:answer/id #uuid "05585fd7-007c-5fa9-ad87-22157d43db84" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}=\\frac{8}{3}(y+2)" :db/id #edb/ref 17592186314418}] :answer-field/correct {:answer/id #uuid "05585fd7-007c-5fa9-ad87-22157d43db84" :answer/type {:db/ident :answer.type/math} :answer/value "(x-4)^{2}=\\frac{8}{3}(y+2)" :db/id #edb/ref 17592186314418} :answer-field/id #uuid "278ff333-62ac-5f98-9e76-486244547d88" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314413}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b5ea67e5-c93c-50dd-b58d-67bfa3531bd9" :question/math-academy-id "q-11828" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14041773/assets/4b30029c03e020e6deacdf6d0728978c5a6d86d88e6bbbf1f8c1a6ec88c278d6.png)\n\nWhat is the equation of the parabola shown above?" :question/worked-solution "We know that for any upward or downward-opening parabola with its vertex at $(h,k),$ the general standard equation is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nHere, the vertex has coordinates $(h,k)=(4,-2).$ Substituting these into the general standard equation, we get\n\n$$\n(x-4)^{2}=4p(y+2).\n$$\n\nWe are left to find the value of $p.$ We know that the given parabola also passes through the point $(0,4),$ so we can substitute $x=0$ and $y=4$ into the standard equation and solve for $p:$\n\n$$\n\\begin{aligned}(x-4)^{2} & =4p(y+2) \\\\ (0-4)^{2} & =4p(4+2) \\\\ 16 & =24p \\\\ p & =\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is \n\n$$\n\\begin{aligned}(x-4)^{2} & =4p(y+2) \\\\ (x-4)^{2} & =4(\\frac{2}{3})(y+2) \\\\ (x-4)^{2} & =\\frac{8}{3}(y+2).\\end{aligned}\n$$"}]}
