  "canonical_examples": [
    {
      "math_academy_id": "e-6155",
      "knowledge_point_id": "2f08b8fa-6f05-5c10-b2d7-5d35e6c48e74",
      "knowledge_point": "Computing the Derivative of a Product Given the Necessary Data",
      "problem": "The values of functions $f(x)$ and $g(x)$ and their derivatives at $x=0$ are given in the table below.\n\n| $x$ | $f(x)$ | $g(x)$ | $f'(x)$ | $g'(x)$ |\n| --- | --- | --- | --- | --- |\n| $0$ | $1$ | $3$ | $-2$ | $0$ |\n\nCompute $\\dfrac{\\textrm{d}}{\\textrm{d}x}\\big(f(x)g(x)\\big)$ at $x=0.$",
      "worked_solution": "Using the product rule, we get\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\big(f(x)g(x)\\big) = f(x)g'(x)+f'(x)g(x).\n$$\n\nAt the point where $x=0$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=0} & =f(0){g}^{′}(0)+{f}^{′}(0)g(0) \\\\  & =1\\cdot 0+3\\cdot (-2) \\\\  & =-6.\\end{aligned}\n$$",
      "difficulty": null,
      "answer_fields": [],
      "missing_source_fields": [
        "difficulty",
        "answer_fields"
      ]
    },
    {
      "math_academy_id": "e-3640",
      "knowledge_point_id": "d2b7d79a-cd1a-583f-be7a-d568bc8e32a3",
      "knowledge_point": "Computing the Derivative of a Quotient Given the Necessary Data",
      "problem": "The values of functions $h(x)$ and $z(x)$ and their derivatives at $x=-1$ are given in the table below.\n\n| $x$ | $h(x)$ | $z(x)$ | $h'(x)$ | $z'(x)$ |\n| --- | --- | --- | --- | --- |\n| $-1$ | $-4$ | $2$ | $6$ | $3$ |\n\nCompute $\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{h(x)}{z(x)}\\right)$ at $x=-1.$",
      "worked_solution": "Using the quotient rule, we get\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{h(x)}{z(x)}\\right) = \\dfrac{h'(x)z(x)-h(x)z'(x)}{(z(x))^2}.\n$$\n\nAt the point where $x=-1$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{h(x)}{z(x)})|}_{x=-1} & =\\frac{{h}^{′}(-1)z(-1)-h(-1){z}^{′}(-1)}{(z(-1))^{2}} \\\\  & =\\frac{6\\cdot 2-(-4)\\cdot 3}{{2}^{2}} \\\\  & =\\frac{24}{4} \\\\  & =6.\\end{aligned}\n$$",
      "difficulty": null,
      "answer_fields": [],
