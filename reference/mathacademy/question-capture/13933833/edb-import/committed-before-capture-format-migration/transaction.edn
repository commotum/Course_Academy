^{2}} \\\\  & =\\frac{\\pi \\cdot \\pi -2\\pi \\cdot 0}{{\\pi }^{2}} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105324/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d2b7d79a-cd1a-583f-be7a-d568bc8e32a3"] :knowledge-point/questions ["q-105324"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72992/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "e3d69288-45e5-5707-b74f-a036137474df" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-72992/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "27bb7dfa-cb16-5f79-afc6-2b80978f1928" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-72992/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "4e41d8c9-8103-5f6f-a520-067ce87c9214" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-72992/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "3295f48a-b511-5813-858b-ec2bd2d15d49" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-72992/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "735315bb-6f83-5e6c-8bd4-59ec24e1d9d3" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-72992/selection" :answer-field/id #uuid "8d00275a-e166-5efa-8371-b33cad48d7d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72992/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-72992/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-72992/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-72992/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-72992/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-72992/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-72992" :question/id #uuid "230d486d-661d-580f-9003-d08606129412" :question/math-academy-id "q-72992" :question/is-example false :question/problem "For the functions $f(x)$ and $p(x),$ you're given the following data:\n\n$$\nf(-3)=-6,\\,{f}^{′}(-3)=2,\\,p(-3)=-5,\\,{p}^{′}(-3)=-3\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(f(x)+p(x))$ at $x=-3.$" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(f(x)+p(x))={f}^{′}(x)+{p}^{′}(x).\n$$\n\nAt the point where $x=-3$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)+p(x))|}_{x=-3} & ={f}^{′}(-3)+{p}^{′}(-3) \\\\  & =2+(-3) \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72992/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93eb24a9-f358-50cf-b447-c394864843f9"] :knowledge-point/questions ["q-72992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341031/field-1/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer/id #uuid "6b560c0b-b532-59fe-b558-6c70202f7f67" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-341031/field-1/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "842f5648-f3fa-561f-8cbb-e5b79a4a164f" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-341031/field-1" :answer-field/id #uuid "7734e207-60d7-5d5a-95ea-8887ac795f00" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341031/field-1/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer-field/choices ["q-341031/field-1/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" "q-341031/field-1/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d"] :db/ensure [:answer-field/validate]} {:db/id "q-341031" :question/id #uuid "a8399fec-1d8a-543b-b803-9628562e2106" :question/math-academy-id "q-341031" :question/is-example false :question/problem "The values of functions $q(x)$ and $r(x)$ and their derivatives at $x=-1$ are given in the table below.\n\n| $x$ | $q(x)$ | $r(x)$ | ${q}^{′}(x)$ | ${r}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $-1$ | $0$ | $1$ | $\\sqrt{2}$ | $-\\sqrt{2}$ |\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))$ at $x=-1.$ Do not round the answer.\n\n${\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))|}_{x=-1}=$\n{{field-1}}" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))=3{q}^{′}(x)+4{r}^{′}(x).\n$$\n\nAt the point where $x=-1$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))|}_{x=-1} & =3{q}^{′}(-1)+4{r}^{′}(-1) \\\\  & =3(\\sqrt{2})+4(-\\sqrt{2}) \\\\  & =-\\sqrt{2} \\\\  & =-\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341031/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93eb24a9-f358-50cf-b447-c394864843f9"] :knowledge-point/questions ["q-341031"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341029/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "6a204efd-286c-59de-9b0e-333b173f7854" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-341029/field-1" :answer-field/id #uuid "e6b651c8-ee74-5b03-85dd-55a61af4303c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341029/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer-field/choices ["q-341029/field-1/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96"] :db/ensure [:answer-field/validate]} {:db/id "q-341029" :question/id #uuid "326e3797-d113-53c3-9a40-8453a755a071" :question/math-academy-id "q-341029" :question/is-example false :question/problem "The values of functions $q(x)$ and $r(x)$ and their derivatives at $x=1$ are given in the table below.\n\n| $x$ | $q(x)$ | $r(x)$ | ${q}^{′}(x)$ | ${r}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $1$ | $5$ | $0$ | $-4$ | $1$ |\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))$ at $x=1.$\n\n${\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))|}_{x=1}=$\n{{field-1}}" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))=3{q}^{′}(x)+4{r}^{′}(x).\n$$\n\nAt the point where $x=1$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))|}_{x=1} & =3{q}^{′}(1)+4{r}^{′}(1) \\\\  & =3(-4)+4(1) \\\\  & =-12+4 \\\\  & =-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341029/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93eb24a9-f358-50cf-b447-c394864843f9"] :knowledge-point/questions ["q-341029"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104453/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "a3d73555-63cb-53a1-918d-989a72b23478" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-104453/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "d59ea303-3570-5d16-aa86-89e6db3bb976" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-104453/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "9eb6dbb4-8cd0-576c-944f-52b54e560f77" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-104453/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" :answer/id #uuid "76555765-d0a4-5a7d-ba2a-b9a1d9c35409" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "q-104453/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "8a2d7fff-ee22-5bda-b3bc-5479a9d3d607" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-104453/selection" :answer-field/id #uuid "21b11775-97c9-5801-ad87-998b790fe311" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104453/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-104453/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-104453/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-104453/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-104453/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" "q-104453/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-104453" :question/id #uuid "8bf539ba-a0d5-52e6-be48-e448cdf40953" :question/math-academy-id "q-104453" :question/is-example false :question/problem "The values of functions $f(x)$ and $g(x)$ and their derivatives at $x=-6$ are given in the table below.\n\n| $x$ | $f(x)$ | $g(x)$ | ${f}^{′}(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $-6$ | $-2\\pi $ | $3\\pi $ | $5$ | $-2$ |\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(f(x)+2g(x))$ at $x=-6.$" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(f(x)+2g(x))={f}^{′}(x)+2{g}^{′}(x).\n$$\n\nAt the point where $x=-6$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)+2g(x))|}_{x=-6} & ={f}^{′}(-6)+2{g}^{′}(-6) \\\\  & =5+2(-2) \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104453/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93eb24a9-f358-50cf-b447-c394864843f9"] :knowledge-point/questions ["q-104453"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341042/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "e60f98a9-4517-54a5-860a-ef3d7d9d27db" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-341042/field-1" :answer-field/id #uuid "5c1fdac8-14b7-56da-97cf-ff4470bd9d92" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341042/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-341042/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-341042" :question/id #uuid "b03c54b8-f199-52e5-91a2-1b985f0b1197" :question/math-academy-id "q-341042" :question/is-example false :question/problem "For the functions $u(x)$ and $v(x),$ you're given the following data:\n\n$$\nu(4)=1,\\,{u}^{′}(4)=6,\\,v(4)=-2,\\,{v}^{′}(4)=2\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))$ at $x=4.$\n\n${\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))|}_{x=4}=$\n{{field-1}}" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))=\\frac{1}{2}{u}^{′}(x)+3{v}^{′}(x).\n$$\n\nAt the point where $x=4$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}u(x)+3v(x))|}_{x=4} & =\\frac{1}{2}{u}^{′}(4)+3{v}^{′}(4) \\\\  & =\\frac{1}{2}(6)+3(2) \\\\  & =3+6 \\\\  & =9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341042/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93eb24a9