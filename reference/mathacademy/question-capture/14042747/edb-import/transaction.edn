[{:db/id "q-69726/selection/c734e3315c3c2867d6eaaf80433d198ffd3df008a4bc1c57364b5b4162651a70" :answer/id #uuid "3191bdf0-1e28-5130-bc4a-afd31186518c" :answer/type :answer.type/math :answer/value "(\\genfrac{}{}{0pt}{}{4}{2})" :db/ensure [:answer/validate]} {:db/id "q-69726/selection/59eb9f9095420a908db56d25348bbd956cc83e4999215dc43a3f5d854e5a0160" :answer/id #uuid "ef9fa87e-82e5-5776-b8be-e9cefb135eed" :answer/type :answer.type/math :answer/value "(\\genfrac{}{}{0pt}{}{3}{2})" :db/ensure [:answer/validate]} {:db/id "q-69726/selection/9b420c23612a00a0c23513b019a682e65d4e7f7be701b065e4800aaca1285dfa" :answer/id #uuid "8b85e2cf-d91f-5a6d-8f0e-f4da229ede82" :answer/type :answer.type/math :answer/value "(\\genfrac{}{}{0pt}{}{1}{0})" :db/ensure [:answer/validate]} {:db/id "q-69726/selection/e6c30f922363836c5350ad1d1352e29fc2d31f7f5601410e781d91ce6f545a72" :answer/id #uuid "1ed03ce9-97ce-5fbe-be72-4fd735cf805c" :answer/type :answer.type/math :answer/value "(\\genfrac{}{}{0pt}{}{3}{3})" :db/ensure [:answer/validate]} {:db/id "q-69726/selection/3136044ba4cd3cc94094cfa6dc3badcac187bf78c551249854cbb7db1abe285a" :answer/id #uuid "d36fbb04-29f5-5084-b628-7d720327696b" :answer/type :answer.type/math :answer/value "(\\genfrac{}{}{0pt}{}{2}{1})" :db/ensure [:answer/validate]} {:db/id "q-69726/selection" :answer-field/id #uuid "265cbbe6-898d-5330-ab5b-06a03de83229" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-69726/selection/c734e3315c3c2867d6eaaf80433d198ffd3df008a4bc1c57364b5b4162651a70" :answer-field/choices ["q-69726/selection/c734e3315c3c2867d6eaaf80433d198ffd3df008a4bc1c57364b5b4162651a70" "q-69726/selection/59eb9f9095420a908db56d25348bbd956cc83e4999215dc43a3f5d854e5a0160" "q-69726/selection/9b420c23612a00a0c23513b019a682e65d4e7f7be701b065e4800aaca1285dfa" "q-69726/selection/e6c30f922363836c5350ad1d1352e29fc2d31f7f5601410e781d91ce6f545a72" "q-69726/selection/3136044ba4cd3cc94094cfa6dc3badcac187bf78c551249854cbb7db1abe285a"] :db/ensure [:answer-field/validate]} {:db/id "q-69726" :question/id #uuid "efb5ff53-fd96-5b59-9204-3a3f9833789e" :question/math-academy-id "q-69726" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{5}{3})=[]+(\\genfrac{}{}{0pt}{}{4}{3})\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{5}{3}),$ we need to find the number that is located in row $5$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{5}{3})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{4}{0}) &  & (\\genfrac{}{}{0pt}{}{4}{1}) &  & (\\genfrac{}{}{0pt}{}{4}{2}) &  & (\\genfrac{}{}{0pt}{}{4}{3}) &  & (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  &  &  & (\\genfrac{}{}{0pt}{}{5}{0}) &  & (\\genfrac{}{}{0pt}{}{5}{1}) &  & (\\genfrac{}{}{0pt}{}{5}{2}) &  & (\\genfrac{}{}{0pt}{}{5}{3}) &  & (\\genfrac{}{}{0pt}{}{5}{4}) &  & (\\genfrac{}{}{0pt}{}{5}{5}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{5}{3})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{5}{3})=(\\genfrac{}{}{0pt}{}{4}{2})+(\\genfrac{}{}{0pt}{}{4}{3})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{4}{2}).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-69726/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25"] :knowledge-point/questions ["q-69726"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-69994"] :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{4}{2}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=4$ and $r=2.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{4}{2}) & =\\frac{4!}{(4-2)!\\cdot 2!} \\\\  & =\\frac{4\\cdot 3\\cdot 2!}{2!\\cdot 2!} \\\\  & =\\frac{4\\cdot 3\\cdot \\cancel{2!}}{2\\cdot \\cancel{2!}} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-69995"] :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{6}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=6$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{6}{3}) & =\\frac{6!}{(6-3)!\\cdot 3!} \\\\  & =\\frac{6\\cdot 5\\cdot 4\\cdot 3!}{3!\\cdot 3!} \\\\  & =\\frac{\\cancel{6}\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3\\cdot 2}\\cdot \\cancel{3!}} \\\\  & =5\\cdot 4 \\\\  & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-70306/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "208b3786-33be-504c-96f6-fabb822fca9e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-70306/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "887d9db5-1a58-5ee1-9945-42844c8cf46a" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-70306/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "a8c9e783-ef6e-57c2-9567-4cec2ca5f0a1" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-70306/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "762781b0-0622-54e6-8a47-f0900bd5fbfa" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-70306/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "6b846ea8-b973-528a-ac33-0bfd060d7d46" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-70306/selection" :answer-field/id #uuid "3952b22b-8857-5204-9834-f4c8089cec7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70306/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-70306/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-70306/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-70306/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-70306/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" "q-70306/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-70306" :question/id #uuid "f57bd3f1-840b-573d-8a0e-71012efa85a3" :question/math-academy-id "q-70306" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{5}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=5$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{5}{3}) & =\\frac{5!}{(5-3)!\\cdot 3!} \\\\  & =\\frac{5\\cdot 4\\cdot 3!}{2!\\cdot 3!} \\\\  & =\\frac{5\\cdot 4\\cdot \\cancel{3!}}{2\\cdot \\cancel{3!}} \\\\  & =\\frac{20}{2} \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70306/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2"] :knowledge-point/questions ["q-70306"] :db/ensure [:knowledge-point/validate]}]
