#{[{:db/id #edb/ref 17592186320328 :knowledge-point/_questions [{:knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d36fbb04-29f5-5084-b628-7d720327696b" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{1})" :db/id #edb/ref 17592186320330} {:answer/id #uuid "ef9fa87e-82e5-5776-b8be-e9cefb135eed" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{3}{2})" :db/id #edb/ref 17592186320331} {:answer/id #uuid "8b85e2cf-d91f-5a6d-8f0e-f4da229ede82" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{1}{0})" :db/id #edb/ref 17592186320332} {:answer/id #uuid "3191bdf0-1e28-5130-bc4a-afd31186518c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{2})" :db/id #edb/ref 17592186320333} {:answer/id #uuid "1ed03ce9-97ce-5fbe-be72-4fd735cf805c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{3}{3})" :db/id #edb/ref 17592186320334}] :answer-field/correct {:answer/id #uuid "3191bdf0-1e28-5130-bc4a-afd31186518c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{2})" :db/id #edb/ref 17592186320333} :answer-field/id #uuid "265cbbe6-898d-5330-ab5b-06a03de83229" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320329}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "efb5ff53-fd96-5b59-9204-3a3f9833789e" :question/math-academy-id "q-69726" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{5}{3})=[]+(\\genfrac{}{}{0pt}{}{4}{3})\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{5}{3}),$ we need to find the number that is located in row $5$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{5}{3})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{4}{0}) &  & (\\genfrac{}{}{0pt}{}{4}{1}) &  & (\\genfrac{}{}{0pt}{}{4}{2}) &  & (\\genfrac{}{}{0pt}{}{4}{3}) &  & (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  &  &  & (\\genfrac{}{}{0pt}{}{5}{0}) &  & (\\genfrac{}{}{0pt}{}{5}{1}) &  & (\\genfrac{}{}{0pt}{}{5}{2}) &  & (\\genfrac{}{}{0pt}{}{5}{3}) &  & (\\genfrac{}{}{0pt}{}{5}{4}) &  & (\\genfrac{}{}{0pt}{}{5}{5}) \\\\  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{5}{3})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{5}{3})=(\\genfrac{}{}{0pt}{}{4}{2})+(\\genfrac{}{}{0pt}{}{4}{3})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{4}{2}).$"}] [{:db/id #edb/ref 17592186172523 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d70aaad-5f4a-5868-82e4-8bcd7b81b36b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186171104} {:answer/id #uuid "f789954d-74e5-5c18-a508-92cd0cd79d7b" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186171105} {:answer/id #uuid "0a10dba7-6303-5fd7-9d13-bed2b17ac390" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186171106} {:answer/id #uuid "163c41a3-ff1c-5cfe-8511-5cd39d4061ff" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186171107} {:answer/id #uuid "5f9ead90-c79f-5aec-9c06-06c19ae216ed" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186171108}] :answer-field/correct {:answer/id #uuid "8d70aaad-5f4a-5868-82e4-8bcd7b81b36b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186171104} :answer-field/id #uuid "e4c4d8b5-c1c8-57aa-a3b8-11355b85dcc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171103}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d568b68b-4ef8-5cbc-887c-db423254aeb5" :question/math-academy-id "q-69994" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{4}{2}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=4$ and $r=2.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{4}{2}) & =\\frac{4!}{(4-2)!\\cdot 2!} \\\\  & =\\frac{4\\cdot 3\\cdot 2!}{2!\\cdot 2!} \\\\  & =\\frac{4\\cdot 3\\cdot \\cancel{2!}}{2\\cdot \\cancel{2!}} \\\\  & =\\frac{12}{2} \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172524 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ba3817d-fc75-529e-bbc5-7927efcde9b1" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186171110} {:answer/id #uuid "a2b816f6-6667-5863-9ff9-452350e40f72" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186171111} {:answer/id #uuid "05332cf4-bc7c-56a3-b715-9d619f936907" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186171112} {:answer/id #uuid "56f9fded-e01b-5ab6-b7d0-eb1cf74044f4" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186171113} {:answer/id #uuid "798b415c-becb-5abe-b448-09b9f7e56f05" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186171114}] :answer-field/correct {:answer/id #uuid "798b415c-becb-5abe-b448-09b9f7e56f05" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186171114} :answer-field/id #uuid "94605976-c7df-53f3-a56f-3b39a6fb063d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171109}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "48d3b32e-1f47-5b67-b5e3-24d52f8b190d" :question/math-academy-id "q-69995" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{6}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=6$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{6}{3}) & =\\frac{6!}{(6-3)!\\cdot 3!} \\\\  & =\\frac{6\\cdot 5\\cdot 4\\cdot 3!}{3!\\cdot 3!} \\\\  & =\\frac{\\cancel{6}\\cdot 5\\cdot 4\\cdot \\cancel{3!}}{\\cancel{3\\cdot 2}\\cdot \\cancel{3!}} \\\\  & =5\\cdot 4 \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320335 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "762781b0-0622-54e6-8a47-f0900bd5fbfa" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186320337} {:answer/id #uuid "887d9db5-1a58-5ee1-9945-42844c8cf46a" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186320338} {:answer/id #uuid "6b846ea8-b973-528a-ac33-0bfd060d7d46" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186320339} {:answer/id #uuid "208b3786-33be-504c-96f6-fabb822fca9e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186320340} {:answer/id #uuid "a8c9e783-ef6e-57c2-9567-4cec2ca5f0a1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186320341}] :answer-field/correct {:answer/id #uuid "6b846ea8-b973-528a-ac33-0bfd060d7d46" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186320339} :answer-field/id #uuid "3952b22b-8857-5204-9834-f4c8089cec7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320336}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f57bd3f1-840b-573d-8a0e-71012efa85a3" :question/math-academy-id "q-70306" :question/problem "Determine the value of $(\\genfrac{}{}{0pt}{}{5}{3}).$" :question/worked-solution "The binomial coefficient $(\\genfrac{}{}{0pt}{}{n}{r})$ is given by the formula\n\n$$\n(\\genfrac{}{}{0pt}{}{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=5$ and $r=3.$ Therefore,\n\n$$\n\\begin{aligned}(\\genfrac{}{}{0pt}{}{5}{3}) & =\\frac{5!}{(5-3)!\\cdot 3!} \\\\  & =\\frac{5\\cdot 4\\cdot 3!}{2!\\cdot 3!} \\\\  & =\\frac{5\\cdot 4\\cdot \\cancel{3!}}{2\\cdot \\cancel{3!}} \\\\  & =\\frac{20}{2} \\\\  & =10.\\end{aligned}\n$$"}]}
