 [["math" "2{\\int }_{0}^{2\\pi }(\\theta +\\operatorname{cos}⁡(\\theta ))^{2}\\text{d}\\theta "] ["math" "2{\\int }_{0}^{\\pi }(\\theta +\\operatorname{cos}⁡(\\theta ))^{2}\\text{d}\\theta "] ["math" "\\frac{1}{2}{\\int }_{0}^{2\\pi }(\\theta +\\operatorname{cos}⁡(\\theta ))^{2}\\text{d}\\theta "] ["math" "\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\theta +\\operatorname{cos}⁡(\\theta ))^{2}\\text{d}\\theta "] ["math" "\\frac{1}{2}{\\int }_{0}^{\\pi }(2\\theta +\\operatorname{cos}⁡(\\theta ))^{2}\\text{d}\\theta "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-14884" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}{\\int }_{0}^{\\pi }(2\\theta +\\operatorname{cos}⁡(\\theta ))^{2}\\text{d}\\theta "] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352330" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/327f1f7a395616de463c054ec904812dcd422776522a262f956530d3aa9278eb.png)\n\nFind the area $A$ bounded by the polar curve $r=2\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352330" "field" nil "attribute" "question/worked-solution" "value" "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=2\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(2\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }4{\\theta }^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }{\\theta }^{2}\\,\\text{d}\\theta  \\\\  & =2(\\frac{{\\theta }^{3}}{3})\\,{|}_{0}^{\\pi } \\\\  & =2(\\frac{{\\pi }^{3}}{3})-2(\\frac{{0}^{3}}{3}) \\\\  & =\\frac{2{\\pi }^{3}}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352330" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/activity-metadata.json" "file_sha256" "9a6a6f2e0d52cdc97bad9994464a9e36db8c8db3d9955c7739a2d37a3ce7112c"} {"question" "q-352330" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352330" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2\\pi^3}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352337" "field" nil "attribute" "question/problem" "value" "Find the area $A$ bounded by the polar curve $r={e}^{\\theta +1}$ for $0\\le \\theta \\le \\operatorname{ln}⁡(2).$ Do not round the answer.\n\n$A=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352337" "field" nil "attribute" "question/worked-solution" "value" "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )={e}^{\\theta +1}$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\operatorname{ln}⁡(2)$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}{({e}^{\\theta +1})}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}{e}^{2\\theta +2}\\,\\text{d}\\theta  \\\\  & =\\frac{{e}^{2}}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{{e}^{2}}{2}(\\frac{{e}^{2\\theta }}{2}){|}_{0}^{\\operatorname{ln}⁡(2)} \\\\  & =\\frac{{e}^{2}}{4}({e}^{2\\operatorname{ln}⁡(2)}-{e}^{0}) \\\\  & =\\frac{{e}^{2}}{4}(4-1) \\\\  & =\\frac{3{e}^{2}}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352337" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/activity-metadata.json" "file_sha256" "9a6a6f2e0d52cdc97bad9994464a9e36db8c8db3d9955c7739a2d37a3ce7112c"} {"question" "q-352337" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352337" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3e^2}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "e-632" "field" nil "attribute" "question/problem" "value" "Find the area bounded by the polar curve $r = \\cos(3\\theta)$ and the lines $\\theta = -\\dfrac{\\pi}{6}$ and $\\theta = \\dfrac{\\pi}{6}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/350a721c254dab3a8acb2ae54ca5be0bcde6ab036e6936939194c57ae55fe4ff.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/example-632.json" "file_sha256" "e06cfb87ed301f1d1ecf2710ab8bf9d4db9ecd35c14afb1e859c1ef0df1475e3"} {"question" "e-632" "field" nil "attribute" "question/worked-solution" "value" "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = \\cos(3\\theta),$ $\\theta_1=-\\dfrac{\\pi}{6},$ and $\\theta_2=\\dfrac{\\pi}{6},$ this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}{cos}^{2}⁡(3\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{-\\pi /6}^{\\pi /6}(1+\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}(\\theta {|}_{-\\pi /6}^{\\pi /6}+\\frac{1}{6}\\operatorname{sin}⁡(6\\theta ){|}_{-\\pi /6}^{\\pi /6}) \\\\  & =\\frac{1}{4}((\\frac{\\pi }{6}-(-\\frac{\\pi }{6}))+\\frac{1}{6}(\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡(-\\pi ))) \\\\  & =\\frac{1}{4}(\\frac{\\pi }{3}+0) \\\\  & =\\frac{\\pi }{12}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/example-632.json" "file_sha256" "e06cfb87ed301f1d1ecf2710ab8bf9d4db9ecd35c14afb1e859c1ef0df1475e3"} {"question" "e-633" "field" nil "attribute" "question/problem" "value" "Find the area bounded by the polar curve $r = 1+2\\cos\\theta$ for $\\dfrac{2\\pi}{3} \\leq \\theta \\leq \\dfrac{4\\pi}{3},$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/6bfa0990b560bcb09f2a9eb0b9542296f2a8f1c196b6740702e81c59941d66c5.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/example-633.json" "file_sha256" "686c555b47a5742b7111bf75989078fb74ffe2822ba5636f8e0cf9a0427993e7"} {"question" "e-633" "field" nil "attribute" "question/worked-solution" "value" "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = 1+2\\cos(\\theta),$ $\\theta_1=\\dfrac{2\\pi}{3},$ and $\\theta_2=\\dfrac{4\\pi}{3},$ this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+2\\operatorname{cos}⁡(\\theta ))^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+4\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\cdot \\frac{1}{2}{\\int }_{2\\pi /3}^{4\\pi /3}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+2\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+\\operatorname{sin}⁡(2\\theta )\\,{|}_{2\\pi /3}^{4\\pi /3}) \\\\  & =\\frac{1}{2}(3\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+4\\operatorname{sin}⁡\\theta \\,{|}_{2\\pi /3}^{4\\pi /3}+\\operatorname{sin}⁡(2\\theta )\\,{|}_{2\\pi /3}^{4\\pi /3}) \\\\  & =\\frac{1}{2}(2\\pi -4\\sqrt{3}+\\sqrt{3}) \\\\  & =\\frac{1}{2}(2\\pi -3\\sqrt{3}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/example-633.json" "file_sha256" "686c555b47a5742b7111bf75989078fb74ffe2822ba5636f8e0cf9a0427993e7"} {"question" "e-6822" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/d7b39805131dc562e233d49a84f69d30e80ca29cb9443012032d18fdb4512054.png)\n\nFind the area bounded by the polar curve $r = 2\\sin\\theta + 2\\cos\\theta$ for $\\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{3\\pi}{4},$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/example-6822.json" "file_sha256" "fd0d2619392722ca036d7aeeae96a3fccd8b297e1fc1d872b3419029257784a7"} {"question" "e-6822" "field" nil "attribute" "question/worked-solution" "value" "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,.\n$$\n\nWhen $r(\\theta) = 2\\sin\\theta + 2\\cos\\theta,$ $\\theta_1=\\dfrac{\\pi}{2},$ and $\\theta_2=\\dfrac{3\\pi}{4},$ this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(2\\operatorname{sin}⁡\\theta +2\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(4{sin}^{2}⁡\\theta +8\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}(4+8\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{4}{2}{\\int }_{\\pi /2}^{3\\pi /4}(1+\\operatorname{sin}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =2(\\theta \\,{|}_{\\pi /2}^{3\\pi /4}-\\frac{\\operatorname{cos}⁡(2\\theta )}{2}\\,{|}_{\\pi /2}^{3\\pi /4}) \\\\  & =2\\theta \\,{|}_{\\pi /2}^{3\\pi /4}-\\operatorname{cos}⁡(2\\theta )\\,{|}_{\\pi /2}^{3\\pi /4} \\\\  & =2(\\frac{3\\pi }{4}-\\frac{\\pi }{2})-(\\operatorname{cos}⁡(\\frac{3\\pi }{2})-\\operatorname{cos}⁡(\\pi )) \\\\  & =\\frac{\\pi }{2}-1 \\\\  & =\\frac{\\pi -2}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/example-6822.json" "file_sha256" "fd0d2619392722ca036d7aeeae96a3fccd8b297e1fc1d872b3419029257784a7"}] "usage" {"e-6822" [] "q-14866" [] "e-632" [] "e-633" []} "basis" 1940 "retractions" [[17592186092510 :question/problem "> A scientific calculator is required to answer this question.\n\nWhich of the following gives the total area enclosed by graph of the polar curve $r = 1 + (\\cos (θ))/(4)$ for $0 \\le θ \\le 2π$?"] [17592186092510 :question/answer-fields 17592186089496] [17592186092036 :question/problem "Find the area bounded by the polar curve $r = \\cos(3\\theta)$ and the lines $\\theta = -\\dfrac{\\pi}{6}$ and $\\theta = \\dfrac{\\pi}{6}$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1000/Source/Images/bb7cc7dd162b6f0a389d6dc6e05c9319.png)"] [17592186092036 :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,\n$$\n\nWhen\n\n$$\nr(\\theta) = \\cos(3\\theta)\n$$\n\n$$\n\\theta_1=-\\dfrac{\\pi}{6}\n$$\n\nand\n\n$$\n\\theta_2=\\dfrac{\\pi}{6}\n$$\n\nthis gives\n\n$$\n\\begin{aligned}\nA &= \\frac{1}{2}∫_{θ_{1}}^{θ_{2}}r^{2}dθ \\\\\n&= \\frac{1}{2}∫_{- π/6}^{π/6}\\cos^{2} (3θ)dθ \\\\\n&= \\frac{1}{4}∫_{- π/6}^{π/6}(1 + \\cos (6θ))dθ \\\\\n&= \\frac{1}{4}(θ \\mid _{- π/6}^{π/6} + \\frac{1}{6}\\sin (6θ) \\mid _{- π/6}^{π/6}) \\\\\n&= \\frac{1}{4}((\\frac{π}{6} - (-\\frac{π}{6})) + \\frac{1}{6}(\\sin π - \\sin (- π))) \\\\\n&= \\frac{1}{4}(\\frac{π}{3} + 0) \\\\\n&= \\frac{π}{12}\n\\end{aligned}\n$$"] [17592186092037 :question/problem "Find the area bounded by the polar curve $r = 1+2\\cos\\theta$ for $\\dfrac{2\\pi}{3} \\leq \\theta \\leq \\dfrac{4\\pi}{3}$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1000/Source/Images/6471920e9e3f1a0eef69f5be705a6e6c.png)"] [17592186092037 :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,\n$$\n\nWhen\n\n$$\nr(\\theta) = 1+2\\cos(\\theta)\n$$\n\n$$\n\\theta_1=\\dfrac{2\\pi}{3}\n$$\n\nand\n\n$$\n\\theta_2=\\dfrac{4\\pi}{3}\n$$\n\nthis gives\n\n$$\n\\begin{aligned}\nA &= \\frac{1}{2}∫_{θ_{1}}^{θ_{2}}r^{2}dθ \\\\\n&= \\frac{1}{2}∫_{2π/3}^{4π/3}(1 + 2\\cos (θ))^{2}dθ \\\\\n&= \\frac{1}{2}∫_{2π/3}^{4π/3}(1 + 4\\cos θ + 4\\cos^{2} θ)dθ \\\\\n&= \\frac{1}{2}(θ \\mid _{2π/3}^{4π/3} + 4\\sin θ\\begin{vmatrix}_{2π/3}^{4π/3} + 4 \\cdot \\frac{1}{2}∫_{2π/3}^{4π/3}(1 + \\cos (2θ))dθ) \\\\ = \\frac{1}{2}(θ\\begin{vmatrix}_{2π/3}^{4π/3} + 4\\sin θ & _{2π/3}^{4π/3} + 2θ & _{2π/3}^{4π/3} + \\sin (2θ)\\end{vmatrix}_{2π/3}^{4π/3}) \\\\ = \\frac{1}{2}(3θ \\mid _{2π/3}^{4π/3} + 4\\sin θ \\mid _{2π/3}^{4π/3} + \\sin (2θ)\\end{vmatrix}_{2π/3}^{4π/3}) \\\\\n&= \\frac{1}{2}(2π - 4\\sqrt{3} + \\sqrt{3}) \\\\\n&= \\frac{1}{2}(2π - 3\\sqrt{3})\n\\end{aligned}\n$$"] [17592186092052 :question/problem "Find the area bounded by the polar curve $r = 2\\sin\\theta + 2\\cos\\theta$ for $\\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{3\\pi}{4}$, as shown above.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1000/Source/Images/0cf3efb2050d3ceed8f1d4dba42a466e.png)"] [17592186092052 :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,\n$$\n\nWhen\n\n$$\nr(\\theta) = 2\\sin\\theta + 2\\cos\\theta\n$$\n\n$$\n\\theta_1=\\dfrac{\\pi}{2}\n$$\n\nand\n\n$$\n\\theta_2=\\dfrac{3\\pi}{4}\n$$\n\nthis gives\n\n$$\n\\begin{aligned}\nA &= \\frac{1}{2}∫_{θ_{1}}^{θ_{2}}r^{2}dθ \\\\\n&= \\frac{1}{2}∫_{π/2}^{3π/4}(2\\sin θ + 2\\cos θ)^{2}dθ \\\\\n&= \\frac{1}{2}∫_{π/2}^{3π/4}(4\\sin^{2} θ + 8\\sin θ\\cos θ + 4\\cos^{2} θ)dθ \\\\\n&= \\frac{1}{2}∫_{π/2}^{3π/4}(4 + 8\\sin θ\\cos θ)dθ \\\\\n&= \\frac{4}{2}∫_{π/2}^{3π/4}(1 + \\sin (2θ))dθ \\\\\n&= 2(θ\\begin{vmatrix}_{π/2}^{3π/4} - (\\cos (2θ))/(2) & _{π/2}^{3π/4}) \\\\ = 2θ & _{π/2}^{3π/4} - \\cos (2θ)\\end{vmatrix}_{π/2}^{3π/4} \\\\\n&= 2(\\frac{3π}{4} - \\frac{π}{2}) - (\\cos (\\frac{3π}{2}) - \\cos (π)) \\\\\n&= \\frac{π}{2} - 1 \\\\\n&= \\frac{π - 2}{2}\n\\end{aligned}\n$$"]] "immutable_answers" [17592186089497 17592186089498 17592186089499 17592186089500 17592186089501] "immutable_fields" [[17592186089496 :answer-field/correct] [17592186089496 :answer-field/id] [17592186089496 :answer-field/key] [17592186089496 :answer-field/type]] "no_history" []}
