}{2}\\,{|}_{0}^{\\pi })) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }) \\\\  & =\\frac{9}{4}\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{4}(\\pi -0)+2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{9\\pi }{4}+2(-2)-\\frac{1}{8}(0) \\\\  & =\\frac{9\\pi -16}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-79807" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/activity-metadata.json" "file_sha256" "9a6a6f2e0d52cdc97bad9994464a9e36db8c8db3d9955c7739a2d37a3ce7112c"} {"question" "q-79807" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-79807" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{9\\pi +16}{4}"] ["math" "\\frac{9\\pi -16}{4}"] ["math" "\\frac{9\\pi -6}{4}"] ["math" "\\frac{9\\pi -8}{2}"] ["math" "\\frac{9\\pi }{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-79807" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9\\pi -16}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352343" "field" nil "attribute" "question/problem" "value" "Find the area $A$ bounded by the polar curve $r=1-\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\pi .$ Do not round the answer.\n\n$A=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352343" "field" nil "attribute" "question/worked-solution" "value" "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1-\\operatorname{cos}⁡\\theta ,$ ${\\theta }_{1}=0,$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-2\\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-2\\operatorname{cos}⁡\\theta +\\frac{1}{2}(1+\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(\\frac{3}{2}-2\\operatorname{cos}⁡\\theta +\\frac{1}{2}\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta -2\\operatorname{sin}⁡\\theta +\\frac{\\operatorname{sin}⁡(2\\theta )}{4}){|}_{0}^{\\pi } \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta \\,{|}_{0}^{\\pi }-2\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }\\,) \\\\  & =\\frac{3}{4}\\theta \\,{|}_{0}^{\\pi }-\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{3}{4}(\\pi -0)-(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{3\\pi }{4}-0+0 \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352343" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/activity-metadata.json" "file_sha256" "9a6a6f2e0d52cdc97bad9994464a9e36db8c8db3d9955c7739a2d37a3ce7112c"} {"question" "q-352343" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-352343" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3\\pi}{4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bda6d3b0e5f0f9ee7d35bc4f2ed4207a850b29324d2e1"} {"question" "q-14866" "field" nil "attribute" "question/problem" "value" "Which of the following gives the total area enclosed by the graph of the polar curve $r=1+\\frac{\\operatorname{cos}⁡(\\theta )}{4}$ for $0\\le \\theta \\le 2\\pi ?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/state.json" "file_sha256" "519a019823874153172bd