#{[{:db/id #edb/ref 17592186092036 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec" :knowledge-point/title "Finding the Area Bounded by a Petal of a Polar Rose"}] :question/id #uuid "0d1dcc59-e7af-5a86-87ba-aa7ee1b23767" :question/math-academy-id "e-632" :question/problem "Find the area bounded by the polar curve $r = \\cos(3\\theta)$ and the lines $\\theta = -\\dfrac{\\pi}{6}$ and $\\theta = \\dfrac{\\pi}{6}$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1000/Source/Images/bb7cc7dd162b6f0a389d6dc6e05c9319.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,\n$$\n\nWhen\n\n$$\nr(\\theta) = \\cos(3\\theta)\n$$\n\n$$\n\\theta_1=-\\dfrac{\\pi}{6}\n$$\n\nand\n\n$$\n\\theta_2=\\dfrac{\\pi}{6}\n$$\n\nthis gives\n\n$$\n\\begin{aligned}\nA &= \\frac{1}{2}∫_{θ_{1}}^{θ_{2}}r^{2}dθ \\\\\n&= \\frac{1}{2}∫_{- π/6}^{π/6}\\cos^{2} (3θ)dθ \\\\\n&= \\frac{1}{4}∫_{- π/6}^{π/6}(1 + \\cos (6θ))dθ \\\\\n&= \\frac{1}{4}(θ \\mid _{- π/6}^{π/6} + \\frac{1}{6}\\sin (6θ) \\mid _{- π/6}^{π/6}) \\\\\n&= \\frac{1}{4}((\\frac{π}{6} - (-\\frac{π}{6})) + \\frac{1}{6}(\\sin π - \\sin (- π))) \\\\\n&= \\frac{1}{4}(\\frac{π}{3} + 0) \\\\\n&= \\frac{π}{12}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092037 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5" :knowledge-point/title "Finding the Area Bounded by the Loop of a Limaçon"}] :question/id #uuid "6040d180-ed1d-52b8-809c-b5820352d3d8" :question/math-academy-id "e-633" :question/problem "Find the area bounded by the polar curve $r = 1+2\\cos\\theta$ for $\\dfrac{2\\pi}{3} \\leq \\theta \\leq \\dfrac{4\\pi}{3}$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1000/Source/Images/6471920e9e3f1a0eef69f5be705a6e6c.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,\n$$\n\nWhen\n\n$$\nr(\\theta) = 1+2\\cos(\\theta)\n$$\n\n$$\n\\theta_1=\\dfrac{2\\pi}{3}\n$$\n\nand\n\n$$\n\\theta_2=\\dfrac{4\\pi}{3}\n$$\n\nthis gives\n\n$$\n\\begin{aligned}\nA &= \\frac{1}{2}∫_{θ_{1}}^{θ_{2}}r^{2}dθ \\\\\n&= \\frac{1}{2}∫_{2π/3}^{4π/3}(1 + 2\\cos (θ))^{2}dθ \\\\\n&= \\frac{1}{2}∫_{2π/3}^{4π/3}(1 + 4\\cos θ + 4\\cos^{2} θ)dθ \\\\\n&= \\frac{1}{2}(θ \\mid _{2π/3}^{4π/3} + 4\\sin θ\\begin{vmatrix}_{2π/3}^{4π/3} + 4 \\cdot \\frac{1}{2}∫_{2π/3}^{4π/3}(1 + \\cos (2θ))dθ) \\\\ = \\frac{1}{2}(θ\\begin{vmatrix}_{2π/3}^{4π/3} + 4\\sin θ & _{2π/3}^{4π/3} + 2θ & _{2π/3}^{4π/3} + \\sin (2θ)\\end{vmatrix}_{2π/3}^{4π/3}) \\\\ = \\frac{1}{2}(3θ \\mid _{2π/3}^{4π/3} + 4\\sin θ \\mid _{2π/3}^{4π/3} + \\sin (2θ)\\end{vmatrix}_{2π/3}^{4π/3}) \\\\\n&= \\frac{1}{2}(2π - 4\\sqrt{3} + \\sqrt{3}) \\\\\n&= \\frac{1}{2}(2π - 3\\sqrt{3})\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092052 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a62e8412-1733-577c-bd60-25395e6fa908" :knowledge-point/title "Finding Areas Bounded by Other Polar Curves"}] :question/id #uuid "a2d8dca5-a0f3-5b6f-81f5-4eea46ee70d8" :question/math-academy-id "e-6822" :question/problem "Find the area bounded by the polar curve $r = 2\\sin\\theta + 2\\cos\\theta$ for $\\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{3\\pi}{4}$, as shown above.\n\n![](/home/jake/Developer/MA/DATA/Lessons/1000/Source/Images/0cf3efb2050d3ceed8f1d4dba42a466e.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\, \\textrm{d}\\theta \\,\n$$\n\nWhen\n\n$$\nr(\\theta) = 2\\sin\\theta + 2\\cos\\theta\n$$\n\n$$\n\\theta_1=\\dfrac{\\pi}{2}\n$$\n\nand\n\n$$\n\\theta_2=\\dfrac{3\\pi}{4}\n$$\n\nthis gives\n\n$$\n\\begin{aligned}\nA &= \\frac{1}{2}∫_{θ_{1}}^{θ_{2}}r^{2}dθ \\\\\n&= \\frac{1}{2}∫_{π/2}^{3π/4}(2\\sin θ + 2\\cos θ)^{2}dθ \\\\\n&= \\frac{1}{2}∫_{π/2}^{3π/4}(4\\sin^{2} θ + 8\\sin θ\\cos θ + 4\\cos^{2} θ)dθ \\\\\n&= \\frac{1}{2}∫_{π/2}^{3π/4}(4 + 8\\sin θ\\cos θ)dθ \\\\\n&= \\frac{4}{2}∫_{π/2}^{3π/4}(1 + \\sin (2θ))dθ \\\\\n&= 2(θ\\begin{vmatrix}_{π/2}^{3π/4} - (\\cos (2θ))/(2) & _{π/2}^{3π/4}) \\\\ = 2θ & _{π/2}^{3π/4} - \\cos (2θ)\\end{vmatrix}_{π/2}^{3π/4} \\\\\n&= 2(\\frac{3π}{4} - \\frac{π}{2}) - (\\cos (\\frac{3π}{2}) - \\cos (π)) \\\\\n&= \\frac{π}{2} - 1 \\\\\n&= \\frac{π - 2}{2}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092510 :knowledge-point/_questions [{:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5" :knowledge-point/title "Finding the Area Bounded by the Loop of a Limaçon"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c314afb-eff2-59ba-8f4c-bd7234283dd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}∫_{0}^{2π}(1 + (\\cos (θ))/(4))^{2}dθ" :db/id #edb/ref 17592186089497} {:answer/id #uuid "98327936-d8a4-5b81-8462-eac0c5758ed2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}∫_{0}^{π}(1 + (\\cos (θ))/(4))^{2}dθ" :db/id #edb/ref 17592186089498} {:answer/id #uuid "b3a6fa6f-f44b-52cc-8724-701e92d4bb1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}∫_{0}^{2π}(1 + (\\cos (θ))/(4))dθ" :db/id #edb/ref 17592186089499} {:answer/id #uuid "11eb81ac-c7cc-5661-bb86-5e29c7364ddd" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{π}(1 + (\\cos (θ))/(4))dθ" :db/id #edb/ref 17592186089500} {:answer/id #uuid "1470c67a-375e-5999-8415-7f258e4f93bd" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{π}(1 + (\\cos (θ))/(4))^{2}dθ" :db/id #edb/ref 17592186089501}] :answer-field/correct {:answer/id #uuid "8c314afb-eff2-59ba-8f4c-bd7234283dd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}∫_{0}^{2π}(1 + (\\cos (θ))/(4))^{2}dθ" :db/id #edb/ref 17592186089497} :answer-field/id #uuid "b37feafb-02ec-54ac-8ff4-24622063092a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089496}] :question/id #uuid "aeb48f66-6646-5fa1-b59e-10910893bf80" :question/math-academy-id "q-14866" :question/problem "> A scientific calculator is required to answer this question.\n\nWhich of the following gives the total area enclosed by graph of the polar curve $r = 1 + (\\cos (θ))/(4)$ for $0 \\le θ \\le 2π$?" :question/requires-calculator true}]}
