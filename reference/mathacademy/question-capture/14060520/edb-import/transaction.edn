[{:db/id "q-123892/selection/77ccfb61ae1646629792b6b1f1ec2fcdad8c8e0f2c778bcc527255fa6d3ad360" :answer/id #uuid "c0c144c8-257c-5063-85ad-60bdef23ee00" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{2\\pi /3}^{\\pi }{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123892/selection/5d0a6c9f5a768351b29307ab76a58093fea010382c7879cd316da6a8ccdbafb1" :answer/id #uuid "eaa68d79-3958-584f-a639-a00ef154466c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{\\pi /2}^{2\\pi /3}\\operatorname{sin}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123892/selection/7006ee6de9955e264a4366acf90cb66405dacd37fbcff03c2b996832c22b4866" :answer/id #uuid "214cac02-b79c-52c7-85d0-b81b5dee4f4c" :answer/type :answer.type/math :answer/value "\\frac{2}{3}{\\int }_{2\\pi /3}^{\\pi }{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123892/selection/fff8895d909357a4c646901d56925fef18bf08105ec8cf738d047be01431061c" :answer/id #uuid "97cb1893-7c41-55dc-a1d9-03ad7f6be1c0" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{\\pi /3}^{\\pi }{sin}^{2}⁡(\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123892/selection/157b7054f1f13ed3cf92d1ddcf41df8137ffd4c9fa21d608b421952e3b308fff" :answer/id #uuid "2b88d8d3-eeb7-580e-a603-9e69573a1364" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{\\pi /3}^{\\pi }{sin}^{2}⁡(\\theta +3)\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123892/selection" :answer-field/id #uuid "cc386da6-5dbb-5713-8184-3cb035187ec3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123892/selection/77ccfb61ae1646629792b6b1f1ec2fcdad8c8e0f2c778bcc527255fa6d3ad360" :answer-field/choices ["q-123892/selection/77ccfb61ae1646629792b6b1f1ec2fcdad8c8e0f2c778bcc527255fa6d3ad360" "q-123892/selection/5d0a6c9f5a768351b29307ab76a58093fea010382c7879cd316da6a8ccdbafb1" "q-123892/selection/7006ee6de9955e264a4366acf90cb66405dacd37fbcff03c2b996832c22b4866" "q-123892/selection/fff8895d909357a4c646901d56925fef18bf08105ec8cf738d047be01431061c" "q-123892/selection/157b7054f1f13ed3cf92d1ddcf41df8137ffd4c9fa21d608b421952e3b308fff"] :db/ensure [:answer-field/validate]} {:db/id "q-123892" :question/id #uuid "297129bb-a339-52f1-bb28-be479ab08064" :question/math-academy-id "q-123892" :question/problem "Which of the following gives the area bounded by graph of the polar curve $r=3\\operatorname{sin}⁡(3\\theta )$ for $\\frac{2\\pi }{3}\\le \\theta \\le \\pi ?$" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3\\operatorname{sin}⁡(3\\theta )$, ${\\theta }_{1}=\\frac{2\\pi }{3}$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{2\\pi /3}^{\\pi }{(3\\operatorname{sin}⁡(3\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}\\cdot 9{\\int }_{2\\pi /3}^{\\pi }{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{2\\pi /3}^{\\pi }{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123892/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec"] :knowledge-point/questions ["q-123892"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123889/selection/96c89b621dd2502c8a2e53f821421703bbe79cf9349688d490609abdcb45ce1e" :answer/id #uuid "7604cab8-7de1-5507-acde-4a610e3f2045" :answer/type :answer.type/math :answer/value "\\frac{2}{3}{\\int }_{-\\pi /4}^{3\\pi /4}\\operatorname{cos}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123889/selection/a6ed6e9a9db203b439fb4ae0bdf7b837f6c035f9877b8b3bcd2954576bee1efd" :answer/id #uuid "e9d3a11b-9d7d-5e3b-8b07-4f8da55a9665" :answer/type :answer.type/math :answer/value "\\frac{2}{9}{\\int }_{\\pi /4}^{3\\pi /2}{cos}^{2}⁡(4\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123889/selection/6b6a7c94576e39a0df09fc9b5b88e0e2b3752e6bb1303dd3e6ecfd172e5b557a" :answer/id #uuid "6eaa1bce-ed4a-5059-80f5-9db3c266a076" :answer/type :answer.type/math :answer/value "\\frac{3}{4}{\\int }_{\\pi /4}^{3\\pi /4}{cos}^{2}⁡(2+\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123889/selection/a8e58b77a8479bd904e7600b7eaa31e99d060ced3908c1c12cd8444b65298570" :answer/id #uuid "1b641633-da1e-5cf0-97ed-1fe5a2629c95" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{\\pi /4}^{3\\pi /4}{cos}^{2}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123889/selection/a392485f3977d34857bc404b1fb3f4646420241038d8d5dbe05fda6e40ac0c94" :answer/id #uuid "e4455fd3-b174-5cc7-8e84-d28cd5cfaa21" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{\\pi /2}^{3\\pi /4}{cos}^{2}⁡(\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-123889/selection" :answer-field/id #uuid "52abf03f-5f90-5c5b-bc10-e06429cac772" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123889/selection/a8e58b77a8479bd904e7600b7eaa31e99d060ced3908c1c12cd8444b65298570" :answer-field/choices ["q-123889/selection/96c89b621dd2502c8a2e53f821421703bbe79cf9349688d490609abdcb45ce1e" "q-123889/selection/a6ed6e9a9db203b439fb4ae0bdf7b837f6c035f9877b8b3bcd2954576bee1efd" "q-123889/selection/6b6a7c94576e39a0df09fc9b5b88e0e2b3752e6bb1303dd3e6ecfd172e5b557a" "q-123889/selection/a8e58b77a8479bd904e7600b7eaa31e99d060ced3908c1c12cd8444b65298570" "q-123889/selection/a392485f3977d34857bc404b1fb3f4646420241038d8d5dbe05fda6e40ac0c94"] :db/ensure [:answer-field/validate]} {:db/id "q-123889" :question/id #uuid "bda350c7-482c-5619-afeb-e65f12cc1277" :question/math-academy-id "q-123889" :question/problem "Which of the following gives the area bounded by the graph of the polar curve $r=3\\operatorname{cos}⁡(2\\theta )$ for $\\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}?$" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3\\operatorname{cos}⁡(2\\theta )$, ${\\theta }_{1}=\\frac{\\pi }{4}$ and ${\\theta }_{2}=\\frac{3\\pi }{4}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}{(3\\operatorname{cos}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}\\cdot 9{\\int }_{\\pi /4}^{3\\pi /4}{cos}^{2}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{\\pi /4}^{3\\pi /4}{cos}^{2}⁡(2\\theta )\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123889/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec"] :knowledge-point/questions ["q-123889"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123894/selection/4af0ec11713146329d543f7f1af62f9a2562b918fd92a2ae35fbea6ed9e578f4" :answer/id #uuid "8e8d815a-1db8-5984-8c56-a36de66791a0" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{16}" :db/ensure [:answer/validate]} {:db/id "q-123894/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "9f142702-5dff-5216-be6b-82ca122b2853" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-123894/selection/03864569254141960db19b242c7f1e850d6147657a3c76f443bd0fefd8fede2f" :answer/id #uuid "288889f1-b41b-5ed9-bb95-86ad6c731b71" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-123894/selection/ecec63f72c134981fa3cbe87cff40eecf5e1a40c53879f766102d06e3b75a85f" :answer/id #uuid "ea7bf6b3-959f-55c5-8aca-44a219064e25" :answer/type :answer.type/math :answer/value "\\frac{25\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "q-123894/selection/aad0e0f084b2f5ea62888bf2352b9dc239243b05e7b645efadda1ab58db8f389" :answer/id #uuid "7cb7a604-0b9c-512a-b7a5-9a0e1e1d1aee" :answer/type :answer.type/math :answer/value "\\frac{25\\pi }{16}" :db/ensure [:answer/validate]} {:db/id "q-123894/selection" :answer-field/id #uuid "17946a64-87f8-5534-a0c6-3bb8e37bbb44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123894/selection/aad0e0f084b2f5ea62888bf2352b9dc239243b05e7b645efadda1ab58db8f389" :answer-field/choices ["q-123894/selection/4af0ec11713146329d543f7f1af62f9a2562b918fd92a2ae35fbea6ed9e578f4" "q-123894/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-123894/selection/03864569254141960db19b242c7f1e850d6147657a3c76f443bd0fefd8fede2f" "q-123894/selection/ecec63f72c134981fa3cbe87cff40eecf5e1a40c53879f766102d06e3b75a85f" "q-123894/selection/aad0e0f084b2f5ea62888bf2352b9dc239243b05e7b645efadda1ab58db8f389"] :db/ensure [:answer-field/validate]} {:db/id "q-123894" :question/id #uuid "d3c44d6f-636b-5b6d-91fb-4a2eb41efe61" :question/math-academy-id "q-123894" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/7a48288304608aa9d2b68a34794183cf58308ce16487c1675318180936868674.png)\n\nFind the area bounded by the polar curve $r=5\\operatorname{cos}⁡(2\\theta )$ for $\\pi \\le \\theta \\le \\frac{5\\pi }{4},$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=5\\operatorname{cos}⁡(2\\theta )$, ${\\theta }_{1}=\\pi $ and ${\\theta }_{2}=\\frac{5\\pi }{4}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi }^{5\\pi /4}(5\\operatorname{cos}⁡(2\\theta ))^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{25}{2}{\\int }_{\\pi }^{5\\pi /4}{cos}^{2}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{25}{4}{\\int }_{\\pi }^{5\\pi /4}(1+\\operatorname{cos}⁡(4\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{25}{4}(\\theta {|}_{\\pi }^{5\\pi /4}+\\frac{1}{4}\\operatorname{sin}⁡(4\\theta ){|}_{\\pi }^{5\\pi /4}) \\\\  & =\\frac{25}{4}((\\frac{5\\pi }{4}-(\\pi ))+\\frac{1}{4}(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(4\\pi ))) \\\\  & =\\frac{25}{4}(\\frac{\\pi }{4}+0) \\\\  & =\\frac{25\\pi }{16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-123894/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec"] :knowledge-point/questions ["q-123894"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352284/field-1/138caba1686f50a765c301fd0e85704fa29e1cfce953a0c8868b005ad608ecff" :answer/id #uuid "0c16d0e2-f600-56a4-a844-e0c981a38158" :answer/type :answer.type/math :answer/value "\\frac{3\\pi}{8}" :db/ensure [:answer/validate]} {:db/id "q-352284/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c" :answer/id #uuid "09aea622-558d-5eb6-aa78-4852385868b2" :answer/type :answer.type/math :answer/value "\\frac{3\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-352284/field-1" :answer-field/id #uuid "d4bddb98-6829-5cd2-945b-a0864a4a8925" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352284/field-1/138caba1686f50a765c301fd0e85704fa29e1cfce953a0c8868b005ad608ecff" :answer-field/choices ["q-352284/field-1/138caba1686f50a765c301fd0e85704fa29e1cfce953a0c8868b005ad608ecff" "q-352284/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c"] :db/ensure [:answer-field/validate]} {:db/id "q-352284" :question/id #uuid "f45c70c3-95c4-5d62-96ce-c5622e2bdba9" :question/math-academy-id "q-352284" :question/problem "Find the area $A$ bounded by the polar curve $r=3\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{3}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=\\frac{\\pi }{6}$ and ${\\theta }_{2}=\\frac{\\pi }{3}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /6}^{\\pi /3}(3\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{\\pi /6}^{\\pi /3}{sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}\\cdot \\frac{1}{2}{\\int }_{\\pi /6}^{\\pi /3}(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{9}{4}\\theta \\,{|}_{\\pi /6}^{\\pi /3}-\\frac{9}{8}\\operatorname{sin}⁡(2\\theta )\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =\\frac{9}{4}(\\frac{\\pi }{3}-\\frac{\\pi }{6})-\\frac{9}{8}(\\operatorname{sin}⁡(\\frac{2\\pi }{3})-\\operatorname{sin}⁡(\\frac{\\pi }{3})) \\\\  & =\\frac{9}{4}\\cdot \\frac{\\pi }{6}-\\frac{9}{8}(\\frac{\\sqrt{3}}{2}-\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{3\\pi }{8}-0 \\\\  & =\\frac{3\\pi }{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352284/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec"] :knowledge-point/questions ["q-352284"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352303/field-1/56f72f65863a3f8496914408d7d8fe7a0b2223d6d78bcae347f0ee15a29dc0b9" :answer/id #uuid "b412b100-137b-5261-92af-08adb0e78ceb" :answer/type :answer.type/math :answer/value "\\frac{9\\pi}{8}+\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "q-352303/field-1" :answer-field/id #uuid "f28c30ed-7af0-5f7c-8b7e-585d920484af" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352303/field-1/56f72f65863a3f8496914408d7d8fe7a0b2223d6d78bcae347f0ee15a29dc0b9" :answer-field/choices ["q-352303/field-1/56f72f65863a3f8496914408d7d8fe7a0b2223d6d78bcae347f0ee15a29dc0b9"] :db/ensure [:answer-field/validate]} {:db/id "q-352303" :question/id #uuid "1978d58f-4d27-5cb2-a88a-4942c49c5a7d" :question/math-academy-id "q-352303" :question/problem "Find the area $A$ bounded by the polar curve $r=3\\operatorname{cos}⁡\\theta $ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=3\\operatorname{cos}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{4}$ and ${\\theta }_{2}=\\frac{\\pi }{4}$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(3\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}\\cdot \\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(1+\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{9}{4}\\theta \\,{|}_{-\\pi /4}^{\\pi /4}+\\frac{9}{8}\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{9}{4}(\\frac{\\pi }{4}-(-\\frac{\\pi }{4}))+\\frac{9}{8}(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{9}{4}(\\frac{\\pi }{2})+\\frac{9}{8}(1+1) \\\\  & =\\frac{9\\pi }{8}+\\frac{9}{4} \\\\  & =\\frac{9\\pi +18}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352303/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "974a88f6-ff6a-5183-aeaf-6019e09061ec"] :knowledge-point/questions ["q-352303"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352323/field-1/377890a191b7f10e80819d2b8a992557d0b85c1b9e4d6ac64ba4aa26bb58d748" :answer/id #uuid "f7d13fdb-ad7a-5612-bc7d-5f5540ec3dcf" :answer/type :answer.type/math :answer/value "3\\pi-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-352323/field-1" :answer-field/id #uuid "45515d57-411e-5249-b51c-2935ed03ce75" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352323/field-1/377890a191b7f10e80819d2b8a992557d0b85c1b9e4d6ac64ba4aa26bb58d748" :answer-field/choices ["q-352323/field-1/377890a191b7f10e80819d2b8a992557d0b85c1b9e4d6ac64ba4aa26bb58d748"] :db/ensure [:answer-field/validate]} {:db/id "q-352323" :question/id #uuid "47c4e623-f4aa-593d-8c75-d6588f55fae9" :question/math-academy-id "q-352323" :question/problem "Find the area $A$ bounded by the polar curve $r=4+2\\operatorname{sin}⁡\\theta $ for $-\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{6}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=4+2\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{6}$ and ${\\theta }_{2}=\\frac{\\pi }{6}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(4+2\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(16+16\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(16+16\\operatorname{sin}⁡\\theta +2(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(18\\theta -16\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta )){|}_{-\\pi /6}^{\\pi /6} \\\\  & =\\frac{1}{2}(18\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-16\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /6}^{\\pi /6}\\,) \\\\  & =9\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-8\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /6}^{\\pi /6} \\\\  & =9(\\frac{\\pi }{6}+\\frac{\\pi }{6})-8(\\operatorname{cos}⁡(\\frac{\\pi }{6})-\\operatorname{cos}⁡(-\\frac{\\pi }{6}))-\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{\\pi }{3})-\\operatorname{sin}⁡(-\\frac{\\pi }{3})) \\\\  & =3\\pi -8(0)-\\frac{1}{2}(\\sqrt{3}) \\\\  & =3\\pi -\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352323/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5"] :knowledge-point/questions ["q-352323"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352319/field-1/47852bd8c2db0728bf9806d7b5f205b4b1db185de3c8fc42e0694f84f2c53a52" :answer/id #uuid "8c01212c-46cb-5c89-a799-d31c025f2517" :answer/type :answer.type/math :answer/value "\\frac{27\\pi}{2}-20" :db/ensure [:answer/validate]} {:db/id "q-352319/field-1/ab35992f147bb813507913262fbf5312c8c9f6e46cb941b4f17319b0ab437efb" :answer/id #uuid "94cd5c5f-7d96-50cb-ac99-e3cebbfafd5a" :answer/type :answer.type/math :answer/value "\\frac{27\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-352319/field-1" :answer-field/id #uuid "5eed3487-2daa-5674-866a-14261a8a8299" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352319/field-1/47852bd8c2db0728bf9806d7b5f205b4b1db185de3c8fc42e0694f84f2c53a52" :answer-field/choices ["q-352319/field-1/47852bd8c2db0728bf9806d7b5f205b4b1db185de3c8fc42e0694f84f2c53a52" "q-352319/field-1/ab35992f147bb813507913262fbf5312c8c9f6e46cb941b4f17319b0ab437efb"] :db/ensure [:answer-field/validate]} {:db/id "q-352319" :question/id #uuid "1c39bcd1-887c-5842-addf-0cba732da132" :question/math-academy-id "q-352319" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/4f3086c30f3c442e19e0844311b9ee57a75a517496861380a8bf3836c5adb539.png)\n\nFind the area $A$ bounded by the polar curve $r=5+2\\operatorname{sin}⁡\\theta $ for $\\pi \\le \\theta \\le 2\\pi ,$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=5+2\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=\\pi $ and ${\\theta }_{2}=2\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi }^{2\\pi }(5+2\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi }^{2\\pi }(25+20\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi }^{2\\pi }(25+20\\operatorname{sin}⁡\\theta +2(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(27\\theta -20\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta )){|}_{\\pi }^{2\\pi } \\\\  & =\\frac{1}{2}(27\\theta \\,{|}_{\\pi }^{2\\pi }-20\\operatorname{cos}⁡\\theta \\,{|}_{\\pi }^{2\\pi }-\\operatorname{sin}⁡(2\\theta )\\,{|}_{\\pi }^{2\\pi }\\,) \\\\  & =\\frac{27}{2}\\theta \\,{|}_{\\pi }^{2\\pi }-10\\operatorname{cos}⁡\\theta \\,{|}_{\\pi }^{2\\pi }-\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{\\pi }^{2\\pi } \\\\  & =\\frac{27}{2}(2\\pi -\\pi )-10(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(\\pi ))-\\frac{1}{2}(\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(2\\pi )) \\\\  & =\\frac{27\\pi }{2}-10(1-(-1))-\\frac{1}{2}(0) \\\\  & =\\frac{27\\pi }{2}-20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352319/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5"] :knowledge-point/questions ["q-352319"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79807/selection/e16ee3d392a92215ccbd3d50eea15c064c3ff9d8588d707cdabbe64aa8439ccb" :answer/id #uuid "c4940a9a-825f-5245-855e-ceb1f3c3c211" :answer/type :answer.type/math :answer/value "\\frac{9\\pi -8}{2}" :db/ensure [:answer/validate]} {:db/id "q-79807/selection/20326897096b015ddcbf0a5476c5f85d7e80f3461c4106648e20b1fc47a73e14" :answer/id #uuid "acbf3d13-ad2d-554e-9617-2c42abfb3800" :answer/type :answer.type/math :answer/value "\\frac{9\\pi +16}{4}" :db/ensure [:answer/validate]} {:db/id "q-79807/selection/7073ddf865f0c9f97383f3a07b5458c92de9192b8b4e23bd69709c0792828aba" :answer/id #uuid "d6671d9e-eca7-50b9-bb45-cc152dfb4842" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-79807/selection/f9b96bc25d860b97af1a90913b3c5bf6a7dd6816aff507423a26fa7c3c7f56dc" :answer/id #uuid "71c8bd58-fc14-5181-8274-fee54511e6ab" :answer/type :answer.type/math :answer/value "\\frac{9\\pi -16}{4}" :db/ensure [:answer/validate]} {:db/id "q-79807/selection/735bb8324b1679477feb2327a3377316f23be936417fe9c572f4d9dc43be046a" :answer/id #uuid "dde14f6a-b929-5100-937b-da6cbcccf0e6" :answer/type :answer.type/math :answer/value "\\frac{9\\pi -6}{4}" :db/ensure [:answer/validate]} {:db/id "q-79807/selection" :answer-field/id #uuid "16b084c8-a495-5d0e-8bfc-81ebd2fcecc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79807/selection/f9b96bc25d860b97af1a90913b3c5bf6a7dd6816aff507423a26fa7c3c7f56dc" :answer-field/choices ["q-79807/selection/e16ee3d392a92215ccbd3d50eea15c064c3ff9d8588d707cdabbe64aa8439ccb" "q-79807/selection/20326897096b015ddcbf0a5476c5f85d7e80f3461c4106648e20b1fc47a73e14" "q-79807/selection/7073ddf865f0c9f97383f3a07b5458c92de9192b8b4e23bd69709c0792828aba" "q-79807/selection/f9b96bc25d860b97af1a90913b3c5bf6a7dd6816aff507423a26fa7c3c7f56dc" "q-79807/selection/735bb8324b1679477feb2327a3377316f23be936417fe9c572f4d9dc43be046a"] :db/ensure [:answer-field/validate]} {:db/id "q-79807" :question/id #uuid "d0b4c5d8-d21f-5ce8-b0e4-b418ee1b837a" :question/math-academy-id "q-79807" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/f57ddfb02991296cbc0280272aa1a28e36cfed926dfedcd7b1955868cf83fff5.png)\n\nFind the area bounded by the polar curve $r=2-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above." :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2-\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(2-\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(4-4\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{0}^{\\pi })) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }) \\\\  & =\\frac{9}{4}\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{4}(\\pi -0)+2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{9\\pi }{4}+2(-2)-\\frac{1}{8}(0) \\\\  & =\\frac{9\\pi -16}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79807/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5"] :knowledge-point/questions ["q-79807"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352343/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c" :answer/id #uuid "9a9816ab-9ea9-50b3-9c69-124623aa4db4" :answer/type :answer.type/math :answer/value "\\frac{3\\pi}{4}" :db/ensure [:answer/validate]} {:db/id "q-352343/field-1/82a873b6b3ece3b4059b2da1839886387bbd4d4e56d0ad136fc169204f9d3030" :answer/id #uuid "bab9a6ea-ef29-5c02-935a-cfa5077c9311" :answer/type :answer.type/math :answer/value "\\frac{3\\pi}{2}" :db/ensure [:answer/validate]} {:db/id "q-352343/field-1" :answer-field/id #uuid "fde7407a-6958-59d3-8aa6-2f5aee46a927" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352343/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c" :answer-field/choices ["q-352343/field-1/9f3fe0666fe667480d480b2f3c4f24f5e2ac276a7450efc6201b6fbe6a76b60c" "q-352343/field-1/82a873b6b3ece3b4059b2da1839886387bbd4d4e56d0ad136fc169204f9d3030"] :db/ensure [:answer-field/validate]} {:db/id "q-352343" :question/id #uuid "1aca8a53-e45a-51aa-87f5-6f1b927c4b18" :question/math-academy-id "q-352343" :question/problem "Find the area $A$ bounded by the polar curve $r=1-\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\pi .$ Do not round the answer.\n\n$A=$\n{{field-1}}" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1-\\operatorname{cos}⁡\\theta ,$ ${\\theta }_{1}=0,$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-2\\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-2\\operatorname{cos}⁡\\theta +\\frac{1}{2}(1+\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(\\frac{3}{2}-2\\operatorname{cos}⁡\\theta +\\frac{1}{2}\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta -2\\operatorname{sin}⁡\\theta +\\frac{\\operatorname{sin}⁡(2\\theta )}{4}){|}_{0}^{\\pi } \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta \\,{|}_{0}^{\\pi }-2\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }\\,) \\\\  & =\\frac{3}{4}\\theta \\,{|}_{0}^{\\pi }-\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{3}{4}(\\pi -0)-(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{3\\pi }{4}-0+0 \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352343/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98c9f0f1-be39-5893-b757-7a4750b07ab5"] :knowledge-point/questions ["q-352343"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186092510 :question/answer-fields 17592186089496] {:db/id "q-14866/selection/ma-v1/e847906004ceddd8dd3e52142aa337b2f24faf9c651088fc9e8fb38ec39be942/7c52668e734e3503f17598e9a8527ca7a0b61cf837cdbf9fb3f3625d6524370c" :answer/id #