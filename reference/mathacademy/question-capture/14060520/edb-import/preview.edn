\pi }^{2\\pi }-\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{\\pi }^{2\\pi } \\\\  & =\\frac{27}{2}(2\\pi -\\pi )-10(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(\\pi ))-\\frac{1}{2}(\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(2\\pi )) \\\\  & =\\frac{27\\pi }{2}-10(1-(-1))-\\frac{1}{2}(0) \\\\  & =\\frac{27\\pi }{2}-20.\\end{aligned}\n$$" 13194139535253 true] [17592186339937 1000 #edb/ref 17592186339938 13194139535253 true] [17592186339937 1000 #edb/ref 17592186339939 13194139535253 true] [17592186339937 1040 #edb/ref 17592186045449 13194139535253 true] [17592186339937 1041 "field-1" 13194139535253 true] [17592186339937 1104 #edb/ref 17592186339938 13194139535253 true] [17592186339937 1110 #uuid "5eed3487-2daa-5674-866a-14261a8a8299" 13194139535253 true] [17592186339938 1034 "\\frac{27\\pi}{2}-20" 13194139535253 true] [17592186339938 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339938 1111 #uuid "8c01212c-46cb-5c89-a799-d31c025f2517" 13194139535253 true] [17592186339939 1034 "\\frac{27\\pi}{2}" 13194139535253 true] [17592186339939 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339939 1111 #uuid "94cd5c5f-7d96-50cb-ac99-e3cebbfafd5a" 13194139535253 true] [17592186339940 1017 #edb/ref 17592186339941 13194139535253 true] [17592186339940 1089 "q-352323" 13194139535253 true] [17592186339940 1091 #edb/ref 17592186045465 13194139535253 true] [17592186339940 1100 "Find the area $A$ bounded by the polar curve $r=4+2\\operatorname{sin}⁡\\theta $ for $-\\frac{\\pi }{6}\\le \\theta \\le \\frac{\\pi }{6}.$ Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535253 true] [17592186339940 1113 #uuid "47c4e623-f4aa-593d-8c75-d6588f55fae9" 13194139535253 true] [17592186339940 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=4+2\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=-\\frac{\\pi }{6}$ and ${\\theta }_{2}=\\frac{\\pi }{6}$, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(4+2\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(16+16\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}(16+16\\operatorname{sin}⁡\\theta +2(1-\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(18\\theta -16\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡(2\\theta )){|}_{-\\pi /6}^{\\pi /6} \\\\  & =\\frac{1}{2}(18\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-16\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /6}^{\\pi /6}\\,) \\\\  & =9\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-8\\operatorname{cos}⁡\\theta \\,{|}_{-\\pi /6}^{\\pi /6}-\\frac{1}{2}\\operatorname{sin}⁡(2\\theta )\\,{|}_{-\\pi /6}^{\\pi /6} \\\\  & =9(\\frac{\\pi }{6}+\\frac{\\pi }{6})-8(\\operatorname{cos}⁡(\\frac{\\pi }{6})-\\operatorname{cos}⁡(-\\frac{\\pi }{6}))-\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{\\pi }{3})-\\operatorname{sin}⁡(-\\frac{\\pi }{3})) \\\\  & =3\\pi -8(0)-\\frac{1}{2}(\\sqrt{3}) \\\\  & =3\\pi -\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" 13194139535253 true] [17592186339941 1000 #edb/ref 17592186339942 13194139535253 true] [17592186339941 1040 #edb/ref 17592186045449 13194139535253 true] [17592186339941 1041 "field-1" 13194139535253 true] [17592186339941 1104 #edb/ref 17592186339942 13194139535253 true] [17592186339941 1110 #uuid "45515d57-411e-5249-b51c-2935ed03ce75" 13194139535253 true] [17592186339942 1034 "3\\pi-\\frac{\\sqrt{3}}{2}" 13194139535253 true] [17592186339942 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339942 1111 #uuid "f7d13fdb-ad7a-5612-bc7d-5f5540ec3dcf" 13194139535253 true] [17592186339943 1017 #edb/ref 17592186339944 13194139535253 true] [17592186339943 1089 "q-352330" 13194139535253 true] [17592186339943 1091 #edb/ref 17592186045465 13194139535253 true] [17592186339943 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/327f1f7a395616de463c054ec904812dcd422776522a262f956530d3aa9278eb.png)\n\nFind the area $A$ bounded by the polar curve $r=2\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535253 true] [17592186339943 1113 #uuid "0aa3c96c-3a12-54be-a246-58cadfe8bbe4" 13194139535253 true] [17592186339943 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=2\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(2\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }4{\\theta }^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi }{\\theta }^{2}\\,\\text{d}\\theta  \\\\  & =2(\\frac{{\\theta }^{3}}{3})\\,{|}_{0}^{\\pi } \\\\  & =2(\\frac{{\\pi }^{3}}{3})-2(\\frac{{0}^{3}}{3}) \\\\  & =\\frac{2{\\pi }^{3}}{3}.\\end{aligned}\n$$" 13194139535253 true] [17592186339944 1000 #edb/ref 17592186339945 13194139535253 true] [17592186339944 1000 #edb/ref 17592186339946 13194139535253 true] [17592186339944 1040 #edb/ref 17592186045449 13194139535253 true] [17592186339944 1041 "field-1" 13194139535253 true] [17592186339944 1104 #edb/ref 17592186339945 13194139535253 true] [17592186339944 1110 #uuid "acf766d9-60e8-506e-b773-5ec36fa788a1" 13194139535253 true] [17592186339945 1034 "\\frac{2\\pi^3}{3}" 13194139535253 true] [17592186339945 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339945 1111 #uuid "03344200-7948-5019-9dfd-49d98748cd46" 13194139535253 true] [17592186339946 1034 "\\frac{4\\pi^3}{3}" 13194139535253 true] [17592186339946 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339946 1111 #uuid "89d40137-edc5-5668-a944-6e0d03ddfc7c" 13194139535253 true] [17592186339947 1017 #edb/ref 17592186339948 13194139535253 true] [17592186339947 1089 "q-352337" 13194139535253 true] [17592186339947 1091 #edb/ref 17592186045465 13194139535253 true] [17592186339947 1100 "Find the area $A$ bounded by the polar curve $r={e}^{\\theta +1}$ for $0\\le \\theta \\le \\operatorname{ln}⁡(2).$ Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535253 true] [17592186339947 1113 #uuid "8950de2c-8595-511b-8c63-6801ecf35ee7" 13194139535253 true] [17592186339947 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )={e}^{\\theta +1}$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\operatorname{ln}⁡(2)$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}{({e}^{\\theta +1})}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}{e}^{2\\theta +2}\\,\\text{d}\\theta  \\\\  & =\\frac{{e}^{2}}{2}{\\int }_{0}^{\\operatorname{ln}⁡(2)}{e}^{2\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{{e}^{2}}{2}(\\frac{{e}^{2\\theta }}{2}){|}_{0}^{\\operatorname{ln}⁡(2)} \\\\  & =\\frac{{e}^{2}}{4}({e}^{2\\operatorname{ln}⁡(2)}-{e}^{0}) \\\\  & =\\frac{{e}^{2}}{4}(4-1) \\\\  & =\\frac{3{e}^{2}}{4}.\\end{aligned}\n$$" 13194139535253 true] [17592186339948 1000 #edb/ref 17592186339949 13194139535253 true] [17592186339948 1040 #edb/ref 17592186045449 13194139535253 true] [17592186339948 1041 "field-1" 13194139535253 true] [17592186339948 1104 #edb/ref 17592186339949 13194139535253 true] [17592186339948 1110 #uuid "a9674210-a3aa-534e-a1af-a681c694254a" 13194139535253 true] [17592186339949 1034 "\\frac{3e^2}{4}" 13194139535253 true] [17592186339949 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339949 1111 #uuid "2e2f1d39-0c8b-55df-8de9-b97ef0fe5da0" 13194139535253 true] [17592186339950 1017 #edb/ref 17592186339951 13194139535253 true] [17592186339950 1089 "q-352338" 13194139535253 true] [17592186339950 1091 #edb/ref 17592186045465 13194139535253 true] [17592186339950 1100 "Find the area $A$ bounded by the polar curve $r=2{e}^{1-\\theta }$ for $0\\le \\theta \\le \\operatorname{ln}⁡(3).$ Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535253 true] [17592186339950 1113 #uuid "9bc37aca-125c-56a1-af2c-6a1af9e536d8" 13194139535253 true] [17592186339950 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nWhen $r(\\theta )=2{e}^{1-\\theta }$, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\operatorname{ln}⁡(3)$, this gives\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(3)}(2{e}^{1-\\theta })^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡(3)}4{e}^{2-2\\theta }\\,\\text{d}\\theta  \\\\  & =2{e}^{2}{\\int }_{0}^{\\operatorname{ln}⁡(3)}{e}^{-2\\theta }\\,\\text{d}\\theta  \\\\  & =2{e}^{2}(-\\frac{{e}^{-2\\theta }}{2}){|}_{0}^{\\operatorname{ln}⁡(3)} \\\\  & =-{e}^{2}({e}^{-2\\operatorname{ln}⁡(3)}-{e}^{0}) \\\\  & =-{e}^{2}(\\frac{1}{9}-1) \\\\  & =\\frac{8{e}^{2}}{9}.\\end{aligned}\n$$" 13194139535253 true] [17592186339951 1000 #edb/ref 17592186339952 13194139535253 true] [17592186339951 1000 #edb/ref 17592186339953 13194139535253 true] [17592186339951 1040 #edb/ref 17592186045449 13194139535253 true] [17592186339951 1041 "field-1" 13194139535253 true] [17592186339951 1104 #edb/ref 17592186339952 13194139535253 true] [17592186339951 1110 #uuid "78cffae8-2374-54b1-9142-284c31b23b6f" 13194139535253 true] [17592186339952 1034 "\\frac{8e^2}{9}" 13194139535253 true] [17592186339952 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339952 1111 #uuid "bcfd0e40-b327-505a-a3bf-67837f9b1f67" 13194139535253 true] [17592186339953 1034 "\\frac{4e^2}{9}" 13194139535253 true] [17592186339953 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339953 1111 #uuid "bf4e0c89-ed9b-5492-b94e-37cca1f24084" 13194139535253 true] [17592186339954 1017 #edb/ref 17592186339955 13194139535253 true] [17592186339954 1089 "q-352343" 13194139535253 true] [17592186339954 1091 #edb/ref 17592186045465 13194139535253 true] [17592186339954 1100 "Find the area $A$ bounded by the polar curve $r=1-\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\pi .$ Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139535253 true] [17592186339954 1113 #uuid "1aca8a53-e45a-51aa-87f5-6f1b927c4b18" 13194139535253 true] [17592186339954 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=1-\\operatorname{cos}⁡\\theta ,$ ${\\theta }_{1}=0,$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-2\\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(1-2\\operatorname{cos}⁡\\theta +\\frac{1}{2}(1+\\operatorname{cos}⁡(2\\theta )))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(\\frac{3}{2}-2\\operatorname{cos}⁡\\theta +\\frac{1}{2}\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta -2\\operatorname{sin}⁡\\theta +\\frac{\\operatorname{sin}⁡(2\\theta )}{4}){|}_{0}^{\\pi } \\\\  & =\\frac{1}{2}(\\frac{3}{2}\\theta \\,{|}_{0}^{\\pi }-2\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }\\,) \\\\  & =\\frac{3}{4}\\theta \\,{|}_{0}^{\\pi }-\\operatorname{sin}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{3}{4}(\\pi -0)-(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{3\\pi }{4}-0+0 \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$" 13194139535253 true] [17592186339955 1000 #edb/ref 17592186339956 13194139535253 true] [17592186339955 1000 #edb/ref 17592186339957 13194139535253 true] [17592186339955 1040 #edb/ref 17592186045449 13194139535253 true] [17592186339955 1041 "field-1" 13194139535253 true] [17592186339955 1104 #edb/ref 17592186339957 13194139535253 true] [17592186339955 1110 #uuid "fde7407a-6958-59d3-8aa6-2f5aee46a927" 13194139535253 true] [17592186339956 1034 "\\frac{3\\pi}{2}" 13194139535253 true] [17592186339956 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339956 1111 #uuid "bab9a6ea-ef29-5c02-935a-cfa5077c9311" 13194139535253 true] [17592186339957 1034 "\\frac{3\\pi}{4}" 13194139535253 true] [17592186339957 1103 #edb/ref 17592186045453 13194139535253 true] [17592186339957 1111 #uuid "9a9816ab-9ea9-50b3-9c69-124623aa4db4" 13194139535253 true] [17592186339958 1017 #edb/ref 17592186339959 13194139535253 true] [17592186339958 1089 "q-79807" 13194139535253 true] [17592186339958 1091 #edb/ref 17592186045465 13194139535253 true] [17592186339958 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14060520/assets/f57ddfb02991296cbc0280272aa1a28e36cfed926dfedcd7b1955868cf83fff5.png)\n\nFind the area bounded by the polar curve $r=2-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\pi ,$ as shown above." 13194139535253 true] [17592186339958 1113 #uuid "d0b4c5d8-d21f-5ce8-b0e4-b418ee1b837a" 13194139535253 true] [17592186339958 1145 "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\text{d}\\theta \\,.\n$$\n\nWhen $r(\\theta )=2-\\operatorname{sin}⁡\\theta $, ${\\theta }_{1}=0$ and ${\\theta }_{2}=\\pi $, this gives \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(2-\\operatorname{sin}⁡\\theta )^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi }(4-4\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}{\\int }_{0}^{\\pi }(1-\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta ) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}(\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{2}\\,{|}_{0}^{\\pi })) \\\\  & =\\frac{1}{2}(4\\theta \\,{|}_{0}^{\\pi }+4\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }+\\frac{1}{2}\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{4}\\,{|}_{0}^{\\pi }) \\\\  & =\\frac{9}{4}\\theta \\,{|}_{0}^{\\pi }+2\\operatorname{cos}⁡\\theta \\,{|}_{0}^{\\pi }-\\frac{\\operatorname{sin}⁡(2\\theta )}{8}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{9}{4}(\\pi -0)+2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{8}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{9\\pi }{4}+2(-2)-\\frac{1}{8}(0) \\\\  & =\\frac{9\\pi -16}{4}.\\end{aligned}\n$$" 13194139535253 true] [17592186339959 1000 #edb/ref 17592186339960 13194139535253 true] [17592186339959 1000 #edb/ref 17592186339961 13194139535253 true] [17592186339959 1000 #edb/ref 17592186339962 13194139535253 true] [17592186339959 1000 #edb/ref 17592186339963 13194139535253 true] [17592186339959 1000 #edb/ref 17592186339964 13194139535253 true] [17592186339959 1040 #edb/ref 17592186045450 13194139535253 true] [17592186339959 1041 "selection" 13194139535253 true] [17592186339959