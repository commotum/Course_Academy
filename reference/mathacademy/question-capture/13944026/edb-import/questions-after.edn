acafaa4fae7eeb28abca.png)"}] [{:db/id #edb/ref 17592186251113 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3089597a-63f4-5ea4-9a8b-5baab152a472" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/120c8bbf904e4df194f0c4e614d5a1090ba0121ee7718571683c0c9ac9bb6b15.png" :db/id #edb/ref 17592186251115} {:answer/id #uuid "ab1946f5-fc91-5265-ab38-12b00ac503ba" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/5dfd50143b186eea1ec68e6aa78144c2df37f2db512811fcf06dd321c880e946.png" :db/id #edb/ref 17592186251116} {:answer/id #uuid "8c1fdd76-0c06-5350-a300-376109ff17f8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/f7bb8de669af42eba2d0c33c09c480be0142459ef6b989f855a9d164af640d34.png" :db/id #edb/ref 17592186251117} {:answer/id #uuid "f5982ed1-c3ce-51f1-a70a-1dc693242f7d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/317a98215c8740ff69287c4794340f4cbb5c621fec3d4b2b1cadead2665a6081.png" :db/id #edb/ref 17592186251118} {:answer/id #uuid "d97ef803-c263-5de6-b324-3411e8d61624" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/a32061878b482568f54633d368ba0c56e4aa37878d8d4ab82a747e6bcf382d16.png" :db/id #edb/ref 17592186251119}] :answer-field/correct {:answer/id #uuid "ab1946f5-fc91-5265-ab38-12b00ac503ba" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/5dfd50143b186eea1ec68e6aa78144c2df37f2db512811fcf06dd321c880e946.png" :db/id #edb/ref 17592186251116} :answer-field/id #uuid "fe14b55b-1671-5b6c-9141-84557b84485e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251114}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "07cbe704-d451-5e96-86d4-985cea7a5da4" :question/math-academy-id "q-44764" :question/problem "Which of the following number lines gives the solution to $1<6x-5<13?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual.\n\n$$\n\\begin{aligned}1 & <\\,6x-5\\,<13 \\\\ 1+5 & <6x-5+5<13+5 \\\\ 6 & <6x<18 \\\\ \\frac{6}{6} & <\\frac{6x}{6}<\\frac{18}{6} \\\\ 1 & <x<3\\end{aligned}\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/5dfd50143b186eea1ec68e6aa78144c2df37f2db512811fcf06dd321c880e946.png)"}] [{:db/id #edb/ref 17592186251120 :knowledge-point/_questions [{:knowledge-point/id #uuid "5930113e-6971-59c9-810a-97fd25bc4f89" :knowledge-point/title "Compound Inequalities That Require Flipping the Inequality Sign"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e10f41b-2896-5cc8-8d15-96c8aaa022a5" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\le x\\le \\frac{1}{2}" :db/id #edb/ref 17592186251122} {:answer/id #uuid "97773be1-a888-5bb7-af41-3669becd040f" :answer/type {:db/ident :answer.type/math} :answer/value "-7\\le x\\le -\\frac{7}{2}" :db/id #edb/ref 17592186251123} {:answer/id #uuid "325f108d-06df-577b-b6de-a80efe753bba" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}\\le x\\le 1" :db/id #edb/ref 17592186251124} {:answer/id #uuid "22115482-549f-557f-8930-9c569f0cb3ae" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\le x\\le 4" :db/id #edb/ref 17592186251125} {:answer/id #uuid "f0c75c62-de65-51dc-adc6-1048b20e391a" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\le x\\le \\frac{5}{2}" :db/id #edb/ref 17592186251126}] :answer-field/correct {:answer/id #uuid "f0c75c62-de65-51dc-adc6-1048b20e391a" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\le x\\le \\frac{5}{2}" :db/id #edb/ref 17592186251126} :answer-field/id #uuid "d35ede8d-bd9e-5f9f-a792-ff1721abc434" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251121}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "bbb65d31-2f1d-5e6a-a175-9b1afe8cf3b2" :question/math-academy-id "q-6352" :question/problem "What is the solution to $1\\le -2x+6\\le 8?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual. \n\nFirst, we apply the addition principle:\n\n$$\n\\begin{aligned}1 & \\le -2x+6\\le 8 \\\\ 1-6 & \\le -2x+6-6\\le 8-6 \\\\ -5 & \\le -2x\\le 2\\end{aligned}\n$$\n\nThen, we divide by $-2.$ Note that since we are dividing by a negative number, we need to flip the inequality signs.\n\n$$\n\\begin{aligned}-5 & \\le -2x\\le 2 \\\\ \\frac{-5}{-2} & \\ge \\frac{-2x}{-2}\\ge \\frac{2}{-2} \\\\ \\frac{5}{2} & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $\\frac{5}{2}\\ge x\\ge -1$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le \\frac{5}{2}\n$$"}] [{:db/id #edb/ref 17592186251127 :knowledge-point/_questions [{:knowledge-point/id #uuid "7229f1d0-4ba7-50ff-b5be-5697c886a175" :knowledge-point/title "Solving Compound Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27380b56-e8db-5266-aa5b-24ab0c940fce" :answer/type {:db/ident :answer.type/math} :answer/value "1\\le x<3" :db/id #edb/ref 17592186251129} {:answer/id #uuid "71295121-eb60-5c6f-8f77-99494e50dccb" :answer/type {:db/ident :answer.type/math} :answer/value "-3<x\\le -1" :db/id #edb/ref 17592186251130} {:answer/id #uuid "68ab8217-21ea-50e5-8a79-127d1c4323ad" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\le x<1" :db/id #edb/ref 17592186251131} {:answer/id #uuid "1daccbaa-8b35-58e2-ae1b-9afa86f36d47" :answer/type {:db/ident :answer.type/math} :answer/value "0\\le x<3" :db/id #edb/ref 17592186251132} {:answer/id #uuid "cd251f09-6f06-5c7f-9d17-933e887a55cd" :answer/type {:db/ident :answer.type/math} :answer/value "-3<x\\le 1" :db/id #edb/ref 17592186251133}] :answer-field/correct {:answer/id #uuid "27380b56-e8db-5266-aa5b-24ab0c940fce" :answer/type {:db/ident :answer.type/math} :answer/value "1\\le x<3" :db/id #edb/ref 17592186251129} :answer-field/id #uuid "cb6ebf22-4538-55d1-b4e7-b5f646f2a503" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251128}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "907111cd-db45-5a34-a847-c8f7be3e3f6d" :question/math-academy-id "q-73871" :question/problem "Solve the inequality $-2\\le 3x-5<4.$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles:\n\n$$\n\\begin{aligned}-2 & \\le 3x-5<4 \\\\ -2+5 & \\le 3x-5+5<4+5 \\\\ 3 & \\le 3x<9 \\\\ \\frac{3}{3} & \\le \\frac{3x}{3}<\\frac{9}{3} \\\\ 1 & \\le x<3\\end{aligned}\n$$\n\nTherefore, the solution is $1\\le x<3.$"}] [{:db/id #edb/ref 17592186251134 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf45ce9e-e04a-52ff-ad5a-5cf16060da41" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png" :db/id #edb/ref 17592186251136} {:answer/id #uuid "30e189a8-9377-54c8-b457-c8f17cd85721" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/0b10de117fd9aba7304ea2a3fbd2bf37bf1ecf273c3fbfda60e54038a319fb85.png" :db/id #edb/ref 17592186251137} {:answer/id #uuid "4fc7e6c5-cfce-5234-9fbf-bc1fd855b1be" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/d51daba003992a0daa016dd69983c322c07032d0f473f7c7e41aff705e9f82d2.png" :db/id #edb/ref 17592186251138} {:answer/id #uuid "59b596fa-bd55-5d2e-9b7c-8c46f795879f" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/23b5a30ef9dc4406f72cbed68aa8d2c798efc6b3d1199c76f1311a9e5c89a466.png" :db/id #edb/ref 17592186251139} {:answer/id #uuid "3e862896-f716-5cb2-96fa-f994ff427500" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/d62e205d0ecd52caf22489fa18279a6c7aa28e4be7edbd04b2ef9b7993801987.png" :db/id #edb/ref 17592186251140}] :answer-field/correct {:answer/id #uuid "cf45ce9e-e04a-52ff-ad5a-5cf16060da41" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png" :db/id #edb/ref 17592186251136} :answer-field/id #uuid "346dff1f-579b-5557-a4e7-a5ea5769edbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186251135}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "62a0da98-148e-5d17-b359-5c104eb24caa" :question/math-academy-id "q-73876" :question/problem "Which of the following number lines gives the solution to $-3\\le \\frac{-1-4x}{3}\\le 1?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-3 & \\le \\frac{-1-4x}{3}\\le 1 \\\\ -3\\cdot 3 & \\le \\frac{-1-4x}{3}\\cdot 3\\le 1\\cdot 3 \\\\ -9 & \\le -1-4x\\le 3 \\\\ -9+1 & \\le -1-4x+1\\le 3+1 \\\\ -8 & \\le -4x\\le 4\\end{aligned}\n$$\n\nAt this point, we need to divide by $-4.$ However, because we are dividing by a negative, we also need to flip the inequality signs.\n\n$$\n\\begin{aligned}-8 & \\le -4x\\le 4 \\\\ \\frac{-8}{-4} & \\ge \\frac{-4x}{-4}\\ge \\frac{4}{-4} \\\\ 2 & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $2\\ge x\\ge -1$,  but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le 2\n$$\n\nTherefore, the representation of the solution in a number line is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png)"}]}
