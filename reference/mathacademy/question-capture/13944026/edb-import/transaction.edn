$ by applying the addition and multiplication principles, as usual.\n\n$$\n\\begin{aligned}1 & <\\,6x-5\\,<13 \\\\ 1+5 & <6x-5+5<13+5 \\\\ 6 & <6x<18 \\\\ \\frac{6}{6} & <\\frac{6x}{6}<\\frac{18}{6} \\\\ 1 & <x<3\\end{aligned}\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/5dfd50143b186eea1ec68e6aa78144c2df37f2db512811fcf06dd321c880e946.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-44764/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80"] :knowledge-point/questions ["q-44764"] :db/ensure [:knowledge-point/validate]} {:db/id "q-44761/selection/d3660fcbc33a03c4a36d2a06b27c1794aa892987ffcc7d5fdf67988e8c00c320" :answer/id #uuid "9c79d8c5-7efe-5a80-81df-6f8840c07d58" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/d3ff8ace8f19f48631b57968c7aad223613e65f5be6f67a3196bd5fa9158ae51.png" :db/ensure [:answer/validate]} {:db/id "q-44761/selection/81469be149b0bf425c7f39fb7d9aa55e4c8dffe30858c974cabddf1d35de1212" :answer/id #uuid "b93f0424-2b51-5ec7-932b-8875a323de40" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c8c019b0d7a2b34e9791394ce1ac50f8db22b1d7fb9296a8c119a80a583d63ef.png" :db/ensure [:answer/validate]} {:db/id "q-44761/selection/8871f4e3e8402dd1fb06fd8f30b9a7d2914e091cd36efba8e277165f849ca5e4" :answer/id #uuid "f6db15fc-3e23-5809-bfa3-3369b96d5a5b" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png" :db/ensure [:answer/validate]} {:db/id "q-44761/selection/4656229f6757480b0dc5dfec076b3744917f4ebee056080766cb77d3e8043e40" :answer/id #uuid "cc553201-a411-5f67-8861-c683a5f2f038" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/1a3b83780bbd15328077dc45eef965aaf311e704990ee3cb45078d76c96183a2.png" :db/ensure [:answer/validate]} {:db/id "q-44761/selection/f020d26bb85d136f8ab4091580b8450d09ba0f35c8db9b803b6dd8102aff826e" :answer/id #uuid "0c49631d-2f68-52c2-bd45-e873bb1c10d6" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/5a8e25a0a97ec193574fd8099e2dfdce70ed887e9f527b855b1ca0957ae7885b.png" :db/ensure [:answer/validate]} {:db/id "q-44761/selection" :answer-field/id #uuid "748d7566-8b33-5499-a243-59208ab01908" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-44761/selection/8871f4e3e8402dd1fb06fd8f30b9a7d2914e091cd36efba8e277165f849ca5e4" :answer-field/choices ["q-44761/selection/d3660fcbc33a03c4a36d2a06b27c1794aa892987ffcc7d5fdf67988e8c00c320" "q-44761/selection/81469be149b0bf425c7f39fb7d9aa55e4c8dffe30858c974cabddf1d35de1212" "q-44761/selection/8871f4e3e8402dd1fb06fd8f30b9a7d2914e091cd36efba8e277165f849ca5e4" "q-44761/selection/4656229f6757480b0dc5dfec076b3744917f4ebee056080766cb77d3e8043e40" "q-44761/selection/f020d26bb85d136f8ab4091580b8450d09ba0f35c8db9b803b6dd8102aff826e"] :db/ensure [:answer-field/validate]} {:db/id "q-44761" :question/id #uuid "e996239f-cafe-55a4-9e1e-af5edfdca48f" :question/math-academy-id "q-44761" :question/problem "Which of the following number lines gives the solution to $-1<-5x-6<4?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-1 & <-5x-6<4 \\\\ -1+6 & <-5x-6+6<4+6 \\\\ 5 & <-5x<10\\end{aligned}\n$$\n\nAt this point, we need to divide by $-5.$ However, because we are dividing by a negative, we also need to flip the signs of the inequalities.\n\n$$\n\\begin{aligned}5 & <-5x<10 \\\\ \\frac{5}{-5} & >\\frac{-5x}{-5}>\\frac{10}{-5} \\\\ -1 & >x>-2\\end{aligned}\n$$\n\nThe solution can be written as $-1>x>-2$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-2<x<-1\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-44761/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80"] :knowledge-point/questions ["q-44761"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73876/selection/97d90289377dc272c2b821c891136e80be5226128954d9ccd0cf6cf268b2d0a6" :answer/id #uuid "59b596fa-bd55-5d2e-9b7c-8c46f795879f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/23b5a30ef9dc4406f72cbed68aa8d2c798efc6b3d1199c76f1311a9e5c89a466.png" :db/ensure [:answer/validate]} {:db/id "q-73876/selection/233741e8f2a338cb5311324aa1c32eb2d53569beecd506e05ee5b95db989e17b" :answer/id #uuid "cf45ce9e-e04a-52ff-ad5a-5cf16060da41" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png" :db/ensure [:answer/validate]} {:db/id "q-73876/selection/890447b437d1a1e732ddf3f0ca63b41f9c9cd041e3b6d87c0fc2cc67393874b1" :answer/id #uuid "4fc7e6c5-cfce-5234-9fbf-bc1fd855b1be" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/d51daba003992a0daa016dd69983c322c07032d0f473f7c7e41aff705e9f82d2.png" :db/ensure [:answer/validate]} {:db/id "q-73876/selection/8719589f04171becfbf3259c46ac0476c192c008c8712b8e289ad1176e787ebf" :answer/id #uuid "30e189a8-9377-54c8-b457-c8f17cd85721" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/0b10de117fd9aba7304ea2a3fbd2bf37bf1ecf273c3fbfda60e54038a319fb85.png" :db/ensure [:answer/validate]} {:db/id "q-73876/selection/e284a1fcbb6737fc0eee09daf89e6eb941e02448d3a9ec51a967d05b702d0940" :answer/id #uuid "3e862896-f716-5cb2-96fa-f994ff427500" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/d62e205d0ecd52caf22489fa18279a6c7aa28e4be7edbd04b2ef9b7993801987.png" :db/ensure [:answer/validate]} {:db/id "q-73876/selection" :answer-field/id #uuid "346dff1f-579b-5557-a4e7-a5ea5769edbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73876/selection/233741e8f2a338cb5311324aa1c32eb2d53569beecd506e05ee5b95db989e17b" :answer-field/choices ["q-73876/selection/97d90289377dc272c2b821c891136e80be5226128954d9ccd0cf6cf268b2d0a6" "q-73876/selection/233741e8f2a338cb5311324aa1c32eb2d53569beecd506e05ee5b95db989e17b" "q-73876/selection/890447b437d1a1e732ddf3f0ca63b41f9c9cd041e3b6d87c0fc2cc67393874b1" "q-73876/selection/8719589f04171becfbf3259c46ac0476c192c008c8712b8e289ad1176e787ebf" "q-73876/selection/e284a1fcbb6737fc0eee09daf89e6eb941e02448d3a9ec51a967d05b702d0940"] :db/ensure [:answer-field/validate]} {:db/id "q-73876" :question/id #uuid "62a0da98-148e-5d17-b359-5c104eb24caa" :question/math-academy-id "q-73876" :question/problem "Which of the following number lines gives the solution to $-3\\le \\frac{-1-4x}{3}\\le 1?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-3 & \\le \\frac{-1-4x}{3}\\le 1 \\\\ -3\\cdot 3 & \\le \\frac{-1-4x}{3}\\cdot 3\\le 1\\cdot 3 \\\\ -9 & \\le -1-4x\\le 3 \\\\ -9+1 & \\le -1-4x+1\\le 3+1 \\\\ -8 & \\le -4x\\le 4\\end{aligned}\n$$\n\nAt this point, we need to divide by $-4.$ However, because we are dividing by a negative, we also need to flip the inequality signs.\n\n$$\n\\begin{aligned}-8 & \\le -4x\\le 4 \\\\ \\frac{-8}{-4} & \\ge \\frac{-4x}{-4}\\ge \\frac{4}{-4} \\\\ 2 & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $2\\ge x\\ge -1$,  but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le 2\n$$\n\nTherefore, the representation of the solution in a number line is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73876/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80"] :knowledge-point/questions ["q-73876"] :db/ensure [:knowledge-point/validate]}]
