stion.difficulty/hard :question/answer-fields ["q-214698/field-1" "q-214698/field-2" "q-214698/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7229f1d0-4ba7-50ff-b5be-5697c886a175"] :knowledge-point/questions ["q-214698"] :db/ensure [:knowledge-point/validate]} {:db/id "q-214697/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer/id #uuid "16f8f0db-8372-5485-8269-b47a22d99fe7" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "q-214697/field-1" :answer-field/id #uuid "29e1aa8a-fe7f-58ea-80db-e3ab7f12076a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-214697/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e" :answer-field/choices ["q-214697/field-1/e4e9dbe71f63d8d81739fdcbf2df64ccccd4c8f5d299ddc4b1c1f96031adb38e"] :db/ensure [:answer-field/validate]} {:db/id "q-214697/field-2/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer/id #uuid "59fc50bc-a1e2-51ee-931a-ac12b4b28938" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "q-214697/field-2" :answer-field/id #uuid "887c8d95-f786-5f8c-95b7-324009ffa8ec" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-214697/field-2/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0" :answer-field/choices ["q-214697/field-2/f022eff7ecaa4435243255d76a2a932e99db9e71ca2b89b05fafca75800709a0"] :db/ensure [:answer-field/validate]} {:db/id "q-214697/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "42864999-0200-54e2-b31c-ffc692e9f492" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-214697/field-3" :answer-field/id #uuid "3c758129-9679-5a97-b97c-305f35a1a710" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-214697/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-214697/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-214697" :question/id #uuid "a9ab535b-0b78-5e31-996f-0a66ae30c4d8" :question/math-academy-id "q-214697" :question/problem "Find the solution to the inequality $-4\\le -3x-7<2.$\n\n$-3$\n{{field-1}}\n$x$\n{{field-2}}{{field-3}}" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles:\n\n$$\n\\begin{aligned}-4 & \\le -3x-7<2 \\\\ -4+7 & \\le -3x-7+7<2+7 \\\\ 3 & \\le -3x<9\\end{aligned}\n$$\n\nThen, we divide by $-3.$ Note that since we are dividing by a negative number, we need to flip the inequality signs.\n\n$$\n\\begin{aligned}3 & \\le -3x<9 \\\\ \\frac{3}{-3} & \\ge \\frac{-3x}{-3}>\\frac{9}{-3} \\\\ -1 & \\ge x>-3\\end{aligned}\n$$\n\nThe solution can be written as $-1\\ge x>-3$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-3<x\\le -1\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-214697/field-1" "q-214697/field-2" "q-214697/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5930113e-6971-59c9-810a-97fd25bc4f89"] :knowledge-point/questions ["q-214697"] :db/ensure [:knowledge-point/validate]} {:db/id "q-214799/field-1/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "905c3623-8175-51df-a9d8-99d5173355d6" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-214799/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "4c8f6f72-c57f-54b4-9757-4e3b5447b20c" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-214799/field-1" :answer-field/id #uuid "19639fd3-f