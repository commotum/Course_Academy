485e" 13194139533786 true] [17592186251115 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/120c8bbf904e4df194f0c4e614d5a1090ba0121ee7718571683c0c9ac9bb6b15.png" 13194139533786 true] [17592186251115 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251115 1111 #uuid "3089597a-63f4-5ea4-9a8b-5baab152a472" 13194139533786 true] [17592186251116 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/5dfd50143b186eea1ec68e6aa78144c2df37f2db512811fcf06dd321c880e946.png" 13194139533786 true] [17592186251116 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251116 1111 #uuid "ab1946f5-fc91-5265-ab38-12b00ac503ba" 13194139533786 true] [17592186251117 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/f7bb8de669af42eba2d0c33c09c480be0142459ef6b989f855a9d164af640d34.png" 13194139533786 true] [17592186251117 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251117 1111 #uuid "8c1fdd76-0c06-5350-a300-376109ff17f8" 13194139533786 true] [17592186251118 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/317a98215c8740ff69287c4794340f4cbb5c621fec3d4b2b1cadead2665a6081.png" 13194139533786 true] [17592186251118 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251118 1111 #uuid "f5982ed1-c3ce-51f1-a70a-1dc693242f7d" 13194139533786 true] [17592186251119 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/a32061878b482568f54633d368ba0c56e4aa37878d8d4ab82a747e6bcf382d16.png" 13194139533786 true] [17592186251119 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251119 1111 #uuid "d97ef803-c263-5de6-b324-3411e8d61624" 13194139533786 true] [17592186251120 1017 #edb/ref 17592186251121 13194139533786 true] [17592186251120 1089 "q-6352" 13194139533786 true] [17592186251120 1091 #edb/ref 17592186045463 13194139533786 true] [17592186251120 1100 "What is the solution to $1\\le -2x+6\\le 8?$" 13194139533786 true] [17592186251120 1113 #uuid "bbb65d31-2f1d-5e6a-a175-9b1afe8cf3b2" 13194139533786 true] [17592186251120 1145 "We isolate $x$ by applying the addition and multiplication principles, as usual. \n\nFirst, we apply the addition principle:\n\n$$\n\\begin{aligned}1 & \\le -2x+6\\le 8 \\\\ 1-6 & \\le -2x+6-6\\le 8-6 \\\\ -5 & \\le -2x\\le 2\\end{aligned}\n$$\n\nThen, we divide by $-2.$ Note that since we are dividing by a negative number, we need to flip the inequality signs.\n\n$$\n\\begin{aligned}-5 & \\le -2x\\le 2 \\\\ \\frac{-5}{-2} & \\ge \\frac{-2x}{-2}\\ge \\frac{2}{-2} \\\\ \\frac{5}{2} & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $\\frac{5}{2}\\ge x\\ge -1$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le \\frac{5}{2}\n$$" 13194139533786 true] [17592186251121 1000 #edb/ref 17592186251122 13194139533786 true] [17592186251121 1000 #edb/ref 17592186251123 13194139533786 true] [17592186251121 1000 #edb/ref 17592186251124 13194139533786 true] [17592186251121 1000 #edb/ref 17592186251125 13194139533786 true] [17592186251121 1000 #edb/ref 17592186251126 13194139533786 true] [17592186251121 1040 #edb/ref 17592186045450 13194139533786 true] [17592186251121 1041 "selection" 13194139533786 true] [17592186251121 1104 #edb/ref 17592186251126 13194139533786 true] [17592186251121 1110 #uuid "d35ede8d-bd9e-5f9f-a792-ff1721abc434" 13194139533786 true] [17592186251122 1034 "-2\\le x\\le \\frac{1}{2}" 13194139533786 true] [17592186251122 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251122 1111 #uuid "7e10f41b-2896-5cc8-8d15-96c8aaa022a5" 13194139533786 true] [17592186251123 1034 "-7\\le x\\le -\\frac{7}{2}" 13194139533786 true] [17592186251123 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251123 1111 #uuid "97773be1-a888-5bb7-af41-3669becd040f" 13194139533786 true] [17592186251124 1034 "-\\frac{5}{2}\\le x\\le 1" 13194139533786 true] [17592186251124 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251124 1111 #uuid "325f108d-06df-577b-b6de-a80efe753bba" 13194139533786 true] [17592186251125 1034 "-2\\le x\\le 4" 13194139533786 true] [17592186251125 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251125 1111 #uuid "22115482-549f-557f-8930-9c569f0cb3ae" 13194139533786 true] [17592186251126 1034 "-1\\le x\\le \\frac{5}{2}" 13194139533786 true] [17592186251126 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251126 1111 #uuid "f0c75c62-de65-51dc-adc6-1048b20e391a" 13194139533786 true] [17592186251127 1017 #edb/ref 17592186251128 13194139533786 true] [17592186251127 1089 "q-73871" 13194139533786 true] [17592186251127 1091 #edb/ref 17592186045465 13194139533786 true] [17592186251127 1100 "Solve the inequality $-2\\le 3x-5<4.$" 13194139533786 true] [17592186251127 1113 #uuid "907111cd-db45-5a34-a847-c8f7be3e3f6d" 13194139533786 true] [17592186251127 1145 "We isolate $x$ by applying the addition and multiplication principles:\n\n$$\n\\begin{aligned}-2 & \\le 3x-5<4 \\\\ -2+5 & \\le 3x-5+5<4+5 \\\\ 3 & \\le 3x<9 \\\\ \\frac{3}{3} & \\le \\frac{3x}{3}<\\frac{9}{3} \\\\ 1 & \\le x<3\\end{aligned}\n$$\n\nTherefore, the solution is $1\\le x<3.$" 13194139533786 true] [17592186251128 1000 #edb/ref 17592186251129 13194139533786 true] [17592186251128 1000 #edb/ref 17592186251130 13194139533786 true] [17592186251128 1000 #edb/ref 17592186251131 13194139533786 true] [17592186251128 1000 #edb/ref 17592186251132 13194139533786 true] [17592186251128 1000 #edb/ref 17592186251133 13194139533786 true] [17592186251128 1040 #edb/ref 17592186045450 13194139533786 true] [17592186251128 1041 "selection" 13194139533786 true] [17592186251128 1104 #edb/ref 17592186251129 13194139533786 true] [17592186251128 1110 #uuid "cb6ebf22-4538-55d1-b4e7-b5f646f2a503" 13194139533786 true] [17592186251129 1034 "1\\le x<3" 13194139533786 true] [17592186251129 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251129 1111 #uuid "27380b56-e8db-5266-aa5b-24ab0c940fce" 13194139533786 true] [17592186251130 1034 "-3<x\\le -1" 13194139533786 true] [17592186251130 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251130 1111 #uuid "71295121-eb60-5c6f-8f77-99494e50dccb" 13194139533786 true] [17592186251131 1034 "-1\\le x<1" 13194139533786 true] [17592186251131 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251131 1111 #uuid "68ab8217-21ea-50e5-8a79-127d1c4323ad" 13194139533786 true] [17592186251132 1034 "0\\le x<3" 13194139533786 true] [17592186251132 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251132 1111 #uuid "1daccbaa-8b35-58e2-ae1b-9afa86f36d47" 13194139533786 true] [17592186251133 1034 "-3<x\\le 1" 13194139533786 true] [17592186251133 1103 #edb/ref 17592186045453 13194139533786 true] [17592186251133 1111 #uuid "cd251f09-6f06-5c7f-9d17-933e887a55cd" 13194139533786 true] [17592186251134 1017 #edb/ref 17592186251135 13194139533786 true] [17592186251134 1089 "q-73876" 13194139533786 true] [17592186251134 1091 #edb/ref 17592186045464 13194139533786 true] [17592186251134 1100 "Which of the following number lines gives the solution to $-3\\le \\frac{-1-4x}{3}\\le 1?$" 13194139533786 true] [17592186251134 1113 #uuid "62a0da98-148e-5d17-b359-5c104eb24caa" 13194139533786 true] [17592186251134 1145 "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-3 & \\le \\frac{-1-4x}{3}\\le 1 \\\\ -3\\cdot 3 & \\le \\frac{-1-4x}{3}\\cdot 3\\le 1\\cdot 3 \\\\ -9 & \\le -1-4x\\le 3 \\\\ -9+1 & \\le -1-4x+1\\le 3+1 \\\\ -8 & \\le -4x\\le 4\\end{aligned}\n$$\n\nAt this point, we need to divide by $-4.$ However, because we are dividing by a negative, we also need to flip the inequality signs.\n\n$$\n\\begin{aligned}-8 & \\le -4x\\le 4 \\\\ \\frac{-8}{-4} & \\ge \\frac{-4x}{-4}\\ge \\frac{4}{-4} \\\\ 2 & \\ge x\\ge -1\\end{aligned}\n$$\n\nThe solution can be written as $2\\ge x\\ge -1$,  but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-1\\le x\\le 2\n$$\n\nTherefore, the representation of the solution in a number line is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png)" 13194139533786 true] [17592186251135 1000 #edb/ref 17592186251136 13194139533786 true] [17592186251135 1000 #edb/ref 17592186251137 13194139533786 true] [17592186251135 1000 #edb/ref 17592186251138 13194139533786 true] [17592186251135 1000 #edb/ref 17592186251139 13194139533786 true] [17592186251135 1000 #edb/ref 17592186251140 13194139533786 true] [17592186251135 1040 #edb/ref 17592186045450 13194139533786 true] [17592186251135 1041 "selection" 13194139533786 true] [17592186251135 1104 #edb/ref 17592186251136 13194139533786 true] [17592186251135 1110 #uuid "346dff1f-579b-5557-a4e7-a5ea5769edbe" 13194139533786 true] [17592186251136 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/c92ac2c46bf3ae5df0263b4832681865d7bddd3e5831452afb38611d6c892fe2.png" 13194139533786 true] [17592186251136 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251136 1111 #uuid "cf45ce9e-e04a-52ff-ad5a-5cf16060da41" 13194139533786 true] [17592186251137 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13944026/assets/0b10de117fd9aba7304ea2a3fbd2bf37bf1ecf273c3fbfda60e54038a319fb85.png" 13194139533786 true] [17592186251137 1103 #edb/ref 17592186045452 13194139533786 true] [17592186251137 1111 #uuid "30e189a8-9377-54c8-b457-c8f17cd85721" 13194139533786 true] [17592186251138 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture