#{[{:db/id #edb/ref 17592186302395 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccc1744f-9c88-5904-b07b-2820f703c892" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186302397} {:answer/id #uuid "f40b34e7-28c4-5463-9c46-3d1cbe83b31b" :answer/type {:db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186302398} {:answer/id #uuid "2aa944d8-fb13-551d-8014-09374f4476c3" :answer/type {:db/ident :answer.type/math} :answer/value "2-{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186302399} {:answer/id #uuid "51700ef9-973c-50f4-b670-ac61225b1849" :answer/type {:db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186302400} {:answer/id #uuid "5211dc81-c47c-5e7a-aec2-7e7ef01f180b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186302401}] :answer-field/correct {:answer/id #uuid "f40b34e7-28c4-5463-9c46-3d1cbe83b31b" :answer/type {:db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186302398} :answer-field/id #uuid "0a30eec5-02ab-573d-964c-df9797724c13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302396}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "88ef7ccf-542e-5c42-b011-ca1cd5a37425" :question/math-academy-id "q-120637" :question/problem "${tan}^{2}⁡\\theta -1+{sec}^{2}⁡\\theta =$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta -1+{sec}^{2}⁡\\theta  & ={tan}^{2}⁡\\theta -1+1+{tan}^{2}⁡\\theta  \\\\  & =2{tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{tan}^{2}⁡\\theta -1+{sec}^{2}⁡\\theta =2{tan}^{2}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186302402 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0dcfc5e-20f3-5b69-a71a-01b887306b3f" :answer/type {:db/ident :answer.type/math} :answer/value "1-{sec}^{2}⁡x" :db/id #edb/ref 17592186302404} {:answer/id #uuid "09c5177a-02dc-53ca-b632-5ad35b640806" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186302405} {:answer/id #uuid "c12249f7-5cc9-5a01-ad57-f69901aaa404" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186302406} {:answer/id #uuid "dd8241ec-9038-5558-96e5-6810f7b27dc5" :answer/type {:db/ident :answer.type/math} :answer/value "1+2\\operatorname{sec}⁡x" :db/id #edb/ref 17592186302407} {:answer/id #uuid "7cdb692a-1c41-5c58-a41a-d433b0ebb85f" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186302408}] :answer-field/correct {:answer/id #uuid "09c5177a-02dc-53ca-b632-5ad35b640806" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186302405} :answer-field/id #uuid "e4931d0d-9ccd-5f4d-be79-9fd5562d9f04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302403}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "89c09b24-68b3-54af-bb86-2a4e34353860" :question/math-academy-id "q-142820" :question/problem "$\\operatorname{sec}⁡x(\\operatorname{sec}⁡x+1)-{tan}^{2}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡x(\\operatorname{sec}⁡x+1)-{tan}^{2}⁡x & ={sec}^{2}⁡x+\\operatorname{sec}⁡x-{tan}^{2}⁡x \\\\  & =1+{tan}^{2}⁡x+\\operatorname{sec}⁡x-{tan}^{2}⁡x \\\\  & =1+\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sec}⁡x(\\operatorname{sec}⁡x+1)-{tan}^{2}⁡x=1+\\operatorname{sec}⁡x.\n$$"}] [{:db/id #edb/ref 17592186110922 :knowledge-point/_questions [{:knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a528c21d-1cfb-5768-bb71-a276ac0ede02" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin θ" :db/id #edb/ref 17592186107616} {:answer/id #uuid "c647a4d0-7c0a-5390-96cb-82e53a5dff96" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin^{2} θ" :db/id #edb/ref 17592186107617} {:answer/id #uuid "06e01fbd-fa44-571b-94d2-43b091f9d0d7" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\sin θ" :db/id #edb/ref 17592186107618} {:answer/id #uuid "649a4821-04b7-5c74-9c55-81bd9a8e270d" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\sin θ" :db/id #edb/ref 17592186107619} {:answer/id #uuid "778594e8-0991-5977-a1cd-7e75e155be28" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin^{2} θ + 1" :db/id #edb/ref 17592186107620}] :answer-field/correct {:answer/id #uuid "a528c21d-1cfb-5768-bb71-a276ac0ede02" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin θ" :db/id #edb/ref 17592186107616} :answer-field/id #uuid "824dcdcc-2139-5659-88b3-a8161692850e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186107615}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7a901438-c891-5987-9100-1b001a426058" :question/math-academy-id "q-23638" :question/problem "$\\frac{\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta }{1+{tan}^{2}⁡\\theta }=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta }{1+{tan}^{2}⁡\\theta }=\\frac{\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta }{{sec}^{2}⁡\\theta }\n$$\n\nWe now simplify the expression:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta }{{sec}^{2}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta }{\\operatorname{sec}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta } \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\cdot \\cancel{\\operatorname{sec}⁡\\theta }}{\\cancel{\\operatorname{sec}⁡\\theta }\\cdot \\operatorname{sec}⁡\\theta } \\\\  & =\\frac{\\operatorname{tan}⁡\\theta }{\\operatorname{sec}⁡\\theta }\\end{aligned}\n$$\n\nNext, we recall the following identities:\n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta },\\,\\frac{1}{\\operatorname{sec}⁡\\theta }=\\operatorname{cos}⁡\\theta \n$$\n\n \n\nUsing the above identities, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta }{\\operatorname{sec}⁡\\theta } & =\\operatorname{tan}⁡\\theta \\cdot \\frac{1}{\\operatorname{sec}⁡\\theta } \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\cancel{\\operatorname{cos}⁡\\theta }}\\cdot \\cancel{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta }{1+{tan}^{2}⁡\\theta }=\\operatorname{sin}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186302409 :knowledge-point/_questions [{:knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95a465c7-293d-5868-9729-6d9890245f71" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x+1" :db/id #edb/ref 17592186302411} {:answer/id #uuid "51c5b52b-4f84-5bc6-9101-daf5f31ba07b" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186302412} {:answer/id #uuid "f513e813-c83c-5d0e-aada-553dba8bb45b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x" :db/id #edb/ref 17592186302413} {:answer/id #uuid "d1e1c755-e4ff-5792-b133-68632c93126e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186302414} {:answer/id #uuid "305720db-2395-5b37-9efc-08925417afba" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x+1" :db/id #edb/ref 17592186302415}] :answer-field/correct {:answer/id #uuid "d1e1c755-e4ff-5792-b133-68632c93126e" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x" :db/id #edb/ref 17592186302414} :answer-field/id #uuid "485bc948-a7fc-5258-b91b-e1fa821057bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302410}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "25be672b-a303-5e5c-b0b8-1502311a3b23" :question/math-academy-id "q-23847" :question/problem "$({sin}^{2}⁡x+{cos}^{2}⁡x)+{tan}^{2}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nAlso, recall the Pythagorean formula for sines and cosines:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\n$$\n\nUsing the above identities, we can simplify our expression as follows:\n\n$$\n\\begin{aligned}({sin}^{2}⁡x+{cos}^{2}⁡x)+{tan}^{2}⁡x & =1+{tan}^{2}⁡x \\\\  & ={sec}^{2}⁡x\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111279 :knowledge-point/_questions [{:knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82deff2d-3319-596f-8a97-c93b7cade6fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\tan^{2} x - 1" :db/id #edb/ref 17592186109770} {:answer/id #uuid "ac0f0719-9b63-51d2-b865-f072d516609d" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\tan x" :db/id #edb/ref 17592186109771} {:answer/id #uuid "eb7b83f4-071f-5ada-9740-dd7a48ce53d3" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\tan x" :db/id #edb/ref 17592186109772} {:answer/id #uuid "2c614938-ede7-5bad-805a-ffc857c37486" :answer/type {:db/ident :answer.type/math} :answer/value "1 + \\tan^{2} x" :db/id #edb/ref 17592186109773} {:answer/id #uuid "7343b1a8-1a91-51b4-9767-5273a158064a" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\tan^{2} x" :db/id #edb/ref 17592186109774}] :answer-field/correct {:answer/id #uuid "7343b1a8-1a91-51b4-9767-5273a158064a" :answer/type {:db/ident :answer.type/math} :answer/value "1 - \\tan^{2} x" :db/id #edb/ref 17592186109774} :answer-field/id #uuid "6b31709a-bb7a-5742-809a-15cddce764b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186109769}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8785c605-4245-5e40-bcf5-7bf8a735713b" :question/math-academy-id "q-65397" :question/problem "${sec}^{2}⁡x-2{tan}^{2}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{sec}^{2}⁡x-2{tan}^{2}⁡x & =1+{tan}^{2}⁡x-2{tan}^{2}⁡x \\\\  & =1-{tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{sec}^{2}⁡x-2{tan}^{2}⁡x=1-{tan}^{2}⁡x.\n$$"}]}
