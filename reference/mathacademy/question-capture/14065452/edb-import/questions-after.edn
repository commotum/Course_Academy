#{[{:db/id #edb/ref 17592186350475 :knowledge-point/_questions [{:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632" :knowledge-point/title "Determining the Center and Axis Lengths Given a Homogeneous Polynomial Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c58e5c96-7275-580a-bb3d-c8806a02ed05" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186350477} {:answer/id #uuid "02755e33-c03a-5db1-9681-d9fb1ebb7a07" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186350478} {:answer/id #uuid "cd370fec-8100-522d-80bb-18497c97319a" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186350479} {:answer/id #uuid "781c6965-a768-5322-8a0c-f1e8003ed5c0" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186350480} {:answer/id #uuid "04648e11-5201-578a-ad24-8eeb7868af65" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186350481}] :answer-field/correct {:answer/id #uuid "781c6965-a768-5322-8a0c-f1e8003ed5c0" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186350480} :answer-field/id #uuid "10e52128-f621-5185-9d0e-c479981a0539" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350476}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3aa53d6f-da55-5751-bb47-ea22b3f74cc0" :question/math-academy-id "q-16566" :question/problem "Determine the center of the ellipse whose equation is\n$4{x}^{2}+{y}^{2}-16x+2y+13=0.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-16x+2y+13 & =0 \\\\ (4{x}^{2}-16x)+({y}^{2}+2y)+13 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(4{x}^{2}-16x)+({y}^{2}+2y)+13 & =0 \\\\ 4[{x}^{2}-4x]+[{y}^{2}+2y]+13 & =0 \\\\ 4[(x-2)^{2}-{2}^{2}]+[(y+1)^{2}-{(1)}^{2}]+13 & =0 \\\\ 4[(x-2)^{2}-4]+[(y+1)^{2}-1]+13 & =0 \\\\ 4(x-2)^{2}-16+(y+1)^{2}-1+13 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}4(x-2)^{2}-16+(y+1)^{2}-1+13 & =0 \\\\ 4(x-2)^{2}+(y+1)^{2} & =-13+1+16 \\\\ 4(x-2)^{2}+(y+1)^{2} & =4 \\\\ (x-2)^{2}+\\frac{(y+1)^{2}}{4} & =1 \\\\ \\frac{(x-2)^{2}}{{1}^{2}}+\\frac{(y+1)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(2,-1).$"}] [{:db/id #edb/ref 17592186350482 :knowledge-point/_questions [{:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632" :knowledge-point/title "Determining the Center and Axis Lengths Given a Homogeneous Polynomial Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2560cc5-0289-57a2-a079-1e715e6688e5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186350484} {:answer/id #uuid "4ad5d651-651c-5992-8b3e-7c23a42e294e" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186350485}] :answer-field/correct {:answer/id #uuid "d2560cc5-0289-57a2-a079-1e715e6688e5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186350484} :answer-field/id #uuid "5e544ccb-c58d-5660-8a1e-14b988b90682" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186350483} {:answer-field/choices [{:answer/id #uuid "aa3abd93-9a6a-5457-a2bf-a966b618c6f9" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186350487}] :answer-field/correct {:answer/id #uuid "aa3abd93-9a6a-5457-a2bf-a966b618c6f9" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186350487} :answer-field/id #uuid "80ef5694-8eb1-51a4-bee3-f68bc92e984d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186350486}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7b2ac131-3789-57d6-ae7d-fc4ddec732af" :question/math-academy-id "q-279724" :question/problem "The center of the ellipse $6{x}^{2}+5{y}^{2}-36x+50y-1=0$ is located at the point$\\,($\n{{field-1}},\n{{field-2}}$).$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}+5{y}^{2}-36x+50y-1 & =0 \\\\ (6{x}^{2}-36x)+(5{y}^{2}+50y)-1 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(6{x}^{2}-36x)+(5{y}^{2}+50y)-1 & =0 \\\\ 6[{x}^{2}-6x]+5[{y}^{2}+10y]-1 & =0 \\\\ 6[(x-3)^{2}-{3}^{2}]+5[(y+5)^{2}-{5}^{2}]-1 & =0 \\\\ 6[(x-3)^{2}-9]+5[(y+5)^{2}-25]-1 & =0 \\\\ 6(x-3)^{2}-54+5(y+5)^{2}-125-1 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}6(x-3)^{2}-54+5(y+5)^{2}-125-1 & =0 \\\\ 6(x-3)^{2}+5(y+5)^{2} & =1+54+125 \\\\ 6(x-3)^{2}+5(y+5)^{2} & =180 \\\\ \\frac{(x-3)^{2}}{30}+\\frac{(y+5)^{2}}{36} & =1 \\\\ \\frac{(x-3)^{2}}{(\\sqrt{30})^{2}}+\\frac{(y+5)^{2}}{{6}^{2}} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(3,-5).$"}] [{:db/id #edb/ref 17592186350488 :knowledge-point/_questions [{:knowledge-point/id #uuid "d58fba3c-4bbf-5a74-a911-18db101eb632" :knowledge-point/title "Determining the Center and Axis Lengths Given a Homogeneous Polynomial Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77a551c8-5f48-51ca-b623-d6de24981b40" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350490}] :answer-field/correct {:answer/id #uuid "77a551c8-5f48-51ca-b623-d6de24981b40" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350490} :answer-field/id #uuid "7732014f-4bb9-57d6-a280-9ba7b1f4d999" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186350489}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7fbf523c-93a9-5c29-bfba-96b46bc02f7e" :question/math-academy-id "q-279726" :question/problem "For the ellipse $9{x}^{2}+25{y}^{2}+72x-100y+19=0$, the length of the major axis is{{field-1}}." :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}9{x}^{2}+25{y}^{2}+72x-100y+19 & =0 \\\\ (9{x}^{2}+72x)+(25{y}^{2}-100y)+19 & =0\\end{aligned}\n$$\n\nNow, we complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(9{x}^{2}+72x)+(25{y}^{2}-100y)+19 & =0 \\\\ 9[{x}^{2}+8x]+25[{y}^{2}-4y]+19 & =0 \\\\ 9[(x+4)^{2}-{4}^{2}]+25[(y-2)^{2}-{2}^{2}]+19 & =0 \\\\ 9[(x+4)^{2}-16]+25[(y-2)^{2}-4]+19 & =0 \\\\ 9(x+4)^{2}-144+25(y-2)^{2}-100+19 & =0\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}9(x+4)^{2}-144+25(y-2)^{2}-100+19 & =0 \\\\ 9(x+4)^{2}+25(y-2)^{2} & =-19+100+144 \\\\ 9(x+4)^{2}+25(y-2)^{2} & =225 \\\\ \\frac{(x+4)^{2}}{25}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(x+4)^{2}}{{5}^{2}}+\\frac{(y-2)^{2}}{{3}^{2}} & =1\\end{aligned}\n$$\n\nSince $5>3,$ the length of the major axis is $2\\cdot 5=10.$"}] [{:db/id #edb/ref 17592186350491 :knowledge-point/_questions [{:knowledge-point/id #uuid "d21d6066-f7c8-5a47-b150-d0ae25d2d60b" :knowledge-point/title "Determining the Center and Axis Lengths Given an Inhomogeneous Polynomial Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1c2116e-3239-5bb1-953a-a931536e0350" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $1$" :db/id #edb/ref 17592186350493} {:answer/id #uuid "ac50ad38-0f5e-5a82-97ee-f3b1c3342d57" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186350494} {:answer/id #uuid "6ef70125-c783-53b3-a96c-7e7eae106d88" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186350495} {:answer/id #uuid "bf8f60f3-a538-592a-b749-52d09739dad3" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186350496} {:answer/id #uuid "b26123fa-8439-5850-bd8f-d4c4ca6badd2" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186350497}] :answer-field/correct {:answer/id #uuid "bf8f60f3-a538-592a-b749-52d09739dad3" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186350496} :answer-field/id #uuid "f40db8d3-131e-5be8-981d-b12b19078424" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350492}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a0bc6070-452c-59d7-b850-234ba4c8bcd8" :question/math-academy-id "q-72934" :question/problem "Determine  the lengths of the major and minor axes of the ellipse whose equation is ${x}^{2}+4{y}^{2}-4x+16y=-16.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-4x+16y & =-16 \\\\ ({x}^{2}-4x)+(4{y}^{2}+16y) & =-16\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-4x)+(4{y}^{2}+16y) & =-16 \\\\ ({x}^{2}-4x)+4({y}^{2}+4y) & =-16 \\\\ [(x-2)^{2}-4]+4[(y+2)^{2}-4] & =-16 \\\\ (x-2)^{2}-4+4(y+2)^{2}-16 & =-16\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-2)^{2}-4+4(y+2)^{2}-16 & =-16 \\\\ (x-2)^{2}+4(y+2)^{2} & =-16+16+4 \\\\ (x-2)^{2}+4(y+2)^{2} & =4 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y+2)^{2}}{1} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y+2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2>1,$ the length of the major axis is $2\\cdot 2=4,$ and the length of the minor axis is $2\\cdot 1=2.$"}] [{:db/id #edb/ref 17592186350498 :knowledge-point/_questions [{:knowledge-point/id #uuid "d21d6066-f7c8-5a47-b150-d0ae25d2d60b" :knowledge-point/title "Determining the Center and Axis Lengths Given an Inhomogeneous Polynomial Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c177427f-8e9f-539c-9f12-23609c5e21dd" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,5)" :db/id #edb/ref 17592186350500} {:answer/id #uuid "a20afe78-9e3c-52d7-8996-16a4466b37a8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186350501} {:answer/id #uuid "f6d713da-b08e-51e5-be33-be87cc109799" :answer/type {:db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186350502} {:answer/id #uuid "8d51df1b-0356-5b96-8a9c-729783b8296d" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186350503} {:answer/id #uuid "b55d384a-a2ec-50c2-b99e-0b871e41affb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-3)" :db/id #edb/ref 17592186350504}] :answer-field/correct {:answer/id #uuid "a20afe78-9e3c-52d7-8996-16a4466b37a8" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186350501} :answer-field/id #uuid "a1a013b6-101b-53f6-9554-aa28d954adc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350499}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b60a8b91-cc5c-53f4-8707-6575410a9274" :question/math-academy-id "q-72939" :question/problem "Determine the center of the ellipse whose equation is $5{x}^{2}+2{y}^{2}+20x-12y=-28.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}+2{y}^{2}+20x-12y & =-28 \\\\ (5{x}^{2}+20x)+(2{y}^{2}-12y) & =-28\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}(5{x}^{2}+20x)+(2{y}^{2}-12y) & =-28 \\\\ 5({x}^{2}+4x)+2({y}^{2}-6y) & =-28 \\\\ 5[(x+2)^{2}-4]+2[(y-3)^{2}-9] & =-28 \\\\ 5(x+2)^{2}-20+2(y-3)^{2}-18 & =-28\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}5(x+2)^{2}-20+2(y-3)^{2}-18 & =-28 \\\\ 5(x+2)^{2}+2(y-3)^{2} & =-28+20+18 \\\\ 5(x+2)^{2}+2(y-3)^{2} & =10 \\\\ \\frac{(x+2)^{2}}{2}+\\frac{(y-3)^{2}}{5} & =1\\end{aligned}\n$$\n\nTherefore, the ellipse is centered at $(-2,3).$"}]}
