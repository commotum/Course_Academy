[{:db/id "q-48385/selection/0548c7e29a7dd6292ecde336e3182846133a165e59d446fd05bf0315194ce1ce" :answer/id #uuid "02a098b0-add6-53ef-b191-41a788fcec81" :answer/type :answer.type/math :answer/value "-4{sin}^{3}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48385/selection/68e7bc3d9bbc6d62b83d6115d709e07ffe68819c8ee9b8f8023ba1c8470bbeb0" :answer/id #uuid "2a8911c1-1338-5911-95c3-36275ec93d46" :answer/type :answer.type/math :answer/value "4{cos}^{3}⁡x\\,\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48385/selection/14b6e42d0766228204f5e02a9b4f8c13d93480af72a7692cb8fcd3a2715558c9" :answer/id #uuid "66490dc5-77a3-5abc-897d-07c269b0fca7" :answer/type :answer.type/math :answer/value "-4{cos}^{3}⁡x\\,\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48385/selection/2ec28ad578975de1bd211b4cd3699a12a1cfb5262079fadf3b97f42458c1969a" :answer/id #uuid "df47ec37-6c58-5539-9da3-0f2489b5a504" :answer/type :answer.type/math :answer/value "4\\operatorname{cos}⁡x\\,{sin}^{3}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48385/selection/f45fa066b049870904bbddfdbf377e87f17c501f3be3cd229bc90e65b1e4fed9" :answer/id #uuid "bc982084-c119-5622-8124-10645e1a57f9" :answer/type :answer.type/math :answer/value "4{cos}^{3}⁡x" :db/ensure [:answer/validate]} {:db/id "q-48385/selection" :answer-field/id #uuid "35200536-319d-5c6e-9490-a7f29b9da051" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48385/selection/14b6e42d0766228204f5e02a9b4f8c13d93480af72a7692cb8fcd3a2715558c9" :answer-field/choices ["q-48385/selection/0548c7e29a7dd6292ecde336e3182846133a165e59d446fd05bf0315194ce1ce" "q-48385/selection/68e7bc3d9bbc6d62b83d6115d709e07ffe68819c8ee9b8f8023ba1c8470bbeb0" "q-48385/selection/14b6e42d0766228204f5e02a9b4f8c13d93480af72a7692cb8fcd3a2715558c9" "q-48385/selection/2ec28ad578975de1bd211b4cd3699a12a1cfb5262079fadf3b97f42458c1969a" "q-48385/selection/f45fa066b049870904bbddfdbf377e87f17c501f3be3cd229bc90e65b1e4fed9"] :db/ensure [:answer-field/validate]} {:db/id "q-48385" :question/id #uuid "5222a73a-4f7a-5cbf-b157-8e15263f3c18" :question/math-academy-id "q-48385" :question/problem "Find ${f}^{′}(x)$ when $f(x)={cos}^{4}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=(\\operatorname{cos}⁡x)^{4}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3}\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-4{u}^{3}\\operatorname{sin}⁡x \\\\  & =-4(\\operatorname{cos}⁡x)^{3}\\operatorname{sin}⁡x \\\\  & =-4{cos}^{3}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-48385/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc"] :knowledge-point/questions ["q-48385"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72157/selection/76e1fa910b871743becca74c4cd32a4c01f06a1f6c9c106f3b258b62490d51a7" :answer/id #uuid "36ea11a5-c5df-5e1f-b180-0e713ebffa28" :answer/type :answer.type/math :answer/value "-28{cos}^{6}⁡x\\operatorname{sin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72157/selection/87d5b72992f516db181efe49f4b3af1f82441c9a4370077c859f59839246da4c" :answer/id #uuid "fe399420-3f65-591e-8648-823206fdaf37" :answer/type :answer.type/math :answer/value "4\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72157/selection/38dec5c6a7938b07f4cd2d897bb62b90f090995dbe58ac0b58a7d1aeb97820f9" :answer/id #uuid "f063e6d7-2176-5a61-b59e-47cea4bcb270" :answer/type :answer.type/math :answer/value "-28\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72157/selection/8a8a480a743116c142b9acdae22a6fc6a01dd575378be21d8ed2981d28644fe8" :answer/id #uuid "a862f1bf-7912-5ba4-94c4-5b0e737da14d" :answer/type :answer.type/math :answer/value "-28{sin}^{6}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72157/selection/628cb9e2eea64e5188e16c4b32711f432ae3af6dafa78709a41ea931b6f9efba" :answer/id #uuid "6fbea358-04cc-5d5c-8431-63b700549eca" :answer/type :answer.type/math :answer/value "4{cos}^{6}⁡x" :db/ensure [:answer/validate]} {:db/id "q-72157/selection" :answer-field/id #uuid "c3ad8a5b-636e-5bec-b39f-77ce9cb120a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72157/selection/76e1fa910b871743becca74c4cd32a4c01f06a1f6c9c106f3b258b62490d51a7" :answer-field/choices ["q-72157/selection/76e1fa910b871743becca74c4cd32a4c01f06a1f6c9c106f3b258b62490d51a7" "q-72157/selection/87d5b72992f516db181efe49f4b3af1f82441c9a4370077c859f59839246da4c" "q-72157/selection/38dec5c6a7938b07f4cd2d897bb62b90f090995dbe58ac0b58a7d1aeb97820f9" "q-72157/selection/8a8a480a743116c142b9acdae22a6fc6a01dd575378be21d8ed2981d28644fe8" "q-72157/selection/628cb9e2eea64e5188e16c4b32711f432ae3af6dafa78709a41ea931b6f9efba"] :db/ensure [:answer-field/validate]} {:db/id "q-72157" :question/id #uuid "2a422837-4266-545d-976c-cb95832d030f" :question/math-academy-id "q-72157" :question/problem "Find ${f}^{′}(x)$ when $f(x)=4{cos}^{7}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=4(\\operatorname{cos}⁡x)^{7}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=4{u}^{7},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=28{u}^{6},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =28{u}^{6}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =28(\\operatorname{cos}⁡x)^{6}(-\\operatorname{sin}⁡x) \\\\  & =-28{cos}^{6}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72157/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc"] :knowledge-point/questions ["q-72157"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72161/selection/065ecb84e13ef5d5371aecb2418012d436ef68f9d1860aebe15bfc5c387584a4" :answer/id #uuid "886792de-a25a-5c81-b2a3-7c373a51fe19" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x{csc}^{2}⁡(\\operatorname{cos}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72161/selection/3f9ec6dba01a719230ca770b95659ee3fea717e853e082de2de4a68b4a353d9e" :answer/id #uuid "ad4f39a1-8763-557e-8387-0bed95bb46f5" :answer/type :answer.type/math :answer/value "{csc}^{2}⁡(\\operatorname{cos}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72161/selection/c7b6eeb2a3deef8cbc9dd082792f3a41f71fdf2e338dade921bc1fd41aba90e3" :answer/id #uuid "84e65cdb-3aba-52f3-a222-91a4c200a388" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡x{csc}^{2}⁡(\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72161/selection/96980fc5a2d8e2a211a564a4a8aac634cec1e9695aa0d17d770d3aa826258ef7" :answer/id #uuid "9ac498b5-24a3-5b03-ab66-011420f25cb2" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡x{csc}^{2}⁡(\\operatorname{cos}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72161/selection/b732310ef6ab13d3bbfd6e508af63fdced5d7364c03236c755056143523483e2" :answer/id #uuid "d20103ff-55bf-5926-893d-31679b451031" :answer/type :answer.type/math :answer/value "-{csc}^{2}⁡(\\operatorname{sin}⁡x)" :db/ensure [:answer/validate]} {:db/id "q-72161/selection" :answer-field/id #uuid "44299a50-22a1-5710-a048-81aeee1f1dca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72161/selection/c7b6eeb2a3deef8cbc9dd082792f3a41f71fdf2e338dade921bc1fd41aba90e3" :answer-field/choices ["q-72161/selection/065ecb84e13ef5d5371aecb2418012d436ef68f9d1860aebe15bfc5c387584a4" "q-72161/selection/3f9ec6dba01a719230ca770b95659ee3fea717e853e082de2de4a68b4a353d9e" "q-72161/selection/c7b6eeb2a3deef8cbc9dd082792f3a41f71fdf2e338dade921bc1fd41aba90e3" "q-72161/selection/96980fc5a2d8e2a211a564a4a8aac634cec1e9695aa0d17d770d3aa826258ef7" "q-72161/selection/b732310ef6ab13d3bbfd6e508af63fdced5d7364c03236c755056143523483e2"] :db/ensure [:answer-field/validate]} {:db/id "q-72161" :question/id #uuid "f0642f9b-2487-565b-be62-256d052d31f9" :question/math-academy-id "q-72161" :question/problem "Find the derivative of $y=\\operatorname{cot}⁡(\\operatorname{sin}⁡x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=\\operatorname{cot}⁡u,\\,u=\\operatorname{sin}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=-{csc}^{2}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (\\operatorname{cos}⁡x) \\\\  & =-\\operatorname{cos}⁡x{csc}^{2}⁡(\\operatorname{sin}⁡x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37"] :knowledge-point/questions ["q-72161"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342402/field-1/64f5887b1744e97c2ede9dc0d818bf5fe913d5c7c0ec7008b1c4000eb0bbcd9f" :answer/id #uuid "3c7087fd-7c30-5281-a0ee-5234d0a417c3" :answer/type :answer.type/math :answer/value "\\sec(2x)\\tan(2x)-x^3" :db/ensure [:answer/validate]} {:db/id "q-342402/field-1/b9d52255dce8d64fb0f30ee2e2de148469f6276502406daceb4d2fee7eed8156" :answer/id #uuid "238c9da1-0e86-5356-821c-3077ad7a39d6" :answer/type :answer.type/math :answer/value "\\sec(2x)\\tan(2x)+x^3" :db/ensure [:answer/validate]} {:db/id "q-342402/field-1" :answer-field/id #uuid "08870b2c-471f-5033-a2ba-4e7dc4788a0b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342402/field-1/64f5887b1744e97c2ede9dc0d818bf5fe913d5c7c0ec7008b1c4000eb0bbcd9f" :answer-field/choices ["q-342402/field-1/64f5887b1744e97c2ede9dc0d818bf5fe913d5c7c0ec7008b1c4000eb0bbcd9f" "q-342402/field-1/b9d52255dce8d64fb0f30ee2e2de148469f6276502406daceb4d2fee7eed8156"] :db/ensure [:answer-field/validate]} {:db/id "q-342402" :question/id #uuid "00ba2eaf-367b-50b3-9c1d-bad2ab96ec7d" :question/math-academy-id "q-342402" :question/problem "Given that $f(x)=\\frac{1}{2}\\operatorname{sec}⁡(2x)-\\frac{1}{4}{x}^{4},$ we have\n\n${f}^{′}(x)=$\n\n{{field-1}}." :question/worked-solution "Let $g(x)=\\frac{1}{2}\\operatorname{sec}⁡(2x)$ and $h(x)=-\\frac{1}{4}{x}^{4}.$ Then\n\n$$\nf(x)=g(x)+h(x).\n$$\n\nFirst, we differentiate $g(x).$ We express $g(x)=\\frac{1}{2}\\operatorname{sec}⁡(2x)$ as the composite function\n\n$$\ng=\\frac{1}{2}\\operatorname{sec}⁡u,\\,u=2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}g}{\\text{d}u}=\\frac{1}{2}\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}g}{\\text{d}x} & =\\frac{\\text{d}g}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{2}\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot 2 \\\\  & =\\operatorname{sec}⁡(2x)\\operatorname{tan}⁡(2x).\\end{aligned}\n$$\n\nNext, we differentiate $h(x)=-\\frac{1}{4}{x}^{4}.$\n\nDifferentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =-{x}^{3}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={g}^{′}(x)+{h}^{′}(x) \\\\  & =\\operatorname{sec}⁡(2x)\\operatorname{tan}⁡(2x)-{x}^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342402/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6"] :knowledge-point/questions ["q-342402"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342443/field-1/286f252b5fa1a4ba57085c40f32117fc2d0d91f90827ceb8126693f1545fae8e" :answer/id #uuid "7e6e86b6-7481-5d16-b602-b9380c6ea561" :answer/type :answer.type/math :answer/value "4\\cos(x)" :db/ensure [:answer/validate]} {:db/id "q-342443/field-1" :answer-field/id #uuid "0f3740d1-a716-5aa5-a687-57c7ba82cfb3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342443/field-1/286f252b5fa1a4ba57085c40f32117fc2d0d91f90827ceb8126693f1545fae8e" :answer-field/choices ["q-342443/field-1/286f252b5fa1a4ba57085c40f32117fc2d0d91f90827ceb8126693f1545fae8e"] :db/ensure [:answer-field/validate]} {:db/id "q-342443/field-2/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046" :answer/id #uuid "5d785c8f-535c-5cdf-b4ab-b8a9c6b355c2" :answer/type :answer.type/math :answer/value "\\sin(x)" :db/ensure [:answer/validate]} {:db/id "q-342443/field-2" :answer-field/id #uuid "a9701cdb-400f-5b2b-b689-966d815de6b6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342443/field-2/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046" :answer-field/choices ["q-342443/field-2/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046"] :db/ensure [:answer-field/validate]} {:db/id "q-342443/field-3/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046" :answer/id #uuid "26f1860c-cfd5-54b9-9d9e-ec9a0abf0b3a" :answer/type :answer.type/math :answer/value "\\sin(x)" :db/ensure [:answer/validate]} {:db/id "q-342443/field-3" :answer-field/id #uuid "4f16637e-f019-5993-bfe5-4ecbd00aab71" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342443/field-3/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046" :answer-field/choices ["q-342443/field-3/72326d5dd2d5074adb3ba3766bd0e867dfc2530d584f48220aa3b918e99d0046"] :db/ensure [:answer-field/validate]} {:db/id "q-342443" :question/id #uuid "da7a9363-596e-552e-8139-fc1c28e7c1ea" :question/math-academy-id "q-342443" :question/problem "Given that $y=4\\operatorname{sec}⁡(\\operatorname{sin}⁡(x)),$ we have\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}$\\operatorname{sec}⁡($\n{{field-2}} $)\\operatorname{tan}⁡($\n{{field-3}} $).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=4\\operatorname{sec}⁡(u),\\,u=\\operatorname{sin}⁡(x).\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=4\\operatorname{sec}⁡(u)\\operatorname{tan}⁡(u),\\,\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =4\\operatorname{sec}⁡(u)\\operatorname{tan}⁡(u)\\cdot \\operatorname{cos}⁡x \\\\  & =4\\operatorname{cos}⁡x\\operatorname{sec}⁡(\\operatorname{sin}⁡(x))\\operatorname{tan}⁡(\\operatorname{sin}⁡(x)).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342443/field-1" "q-342443/field-2" "q-342443/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37"] :knowledge-point/questions ["q-342443"] :db/ensure [:knowledge-point/validate]}]
