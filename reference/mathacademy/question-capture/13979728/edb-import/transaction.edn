n/c2a5d28a268e65e37fbdaf92c07e5c087d05625c7cf3d11ac0072ffe80315f41" :answer/id #uuid "20c0c215-6da8-556c-a5df-acb2d9d99207" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 1 & -1 & 3 \\\\ -2 & 3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74944/selection/e52bcfb46384bb180a9267777cf06c116a36f6f10451fc1c656f4c0e786f6f4e" :answer/id #uuid "bd48e46b-231b-5fdd-b920-223cf326b2ee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74944/selection" :answer-field/id #uuid "2f1c1220-b501-550d-b027-49a87b60f60e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74944/selection/e52bcfb46384bb180a9267777cf06c116a36f6f10451fc1c656f4c0e786f6f4e" :answer-field/choices ["q-74944/selection/0d0b3593566f9e40df11d039d57ea7d11db8c9210ad6dceba5d13961cfaf5073" "q-74944/selection/a39044e92d815c8758ed589699180b91498a7dc0f7045b8dd4ceb5b931fb993c" "q-74944/selection/2d599b1ea1e8add110813456addb8391ec01a997d007073aa68f261722324296" "q-74944/selection/c2a5d28a268e65e37fbdaf92c07e5c087d05625c7cf3d11ac0072ffe80315f41" "q-74944/selection/e52bcfb46384bb180a9267777cf06c116a36f6f10451fc1c656f4c0e786f6f4e"] :db/ensure [:answer-field/validate]} {:db/id "q-74944" :question/id #uuid "b9c4fe27-fb6e-5544-9585-41aed92d912c" :question/math-academy-id "q-74944" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2y-5z+x \\\\ z-y+3x \\\\ -z-2x+3y\\end{aligned}].\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}]\n$$\n\nWe require a $3\\times 3$ matrix $T$ such that\n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}].\n$$\n\nNotice that\n\n$$\n[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x+2y-5z \\\\ 3x-y+z \\\\ -2x+3y-z\\end{aligned}].\n$$\n\nTherefore, the matrix which represents the linear transformation $T$ is\n\n$$\n[\\begin{aligned}1 & 2 & -5 \\\\ 3 & -1 & 1 \\\\ -2 & 3 & -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74944/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c"] :knowledge-point/questions ["q-74944"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74943/selection/05095fcaa6d4b6744e88ee21161b8a4870e38cad62779b5a3247d4948bce36de" :answer/id #uuid "3cae7346-fba1-503e-b4d6-befa03e39f64" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 & 0 \\\\ 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74943/selection/6a9532d95452d37d269507b40da932d4f16b78bf77b3f30925c0d92ce765cf09" :answer/id #uuid "7922e28f-8df0-51aa-afc7-e2c80e02875d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -5 \\\\ 1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74943/selection/0d7478d9622bb1f981fd7ebd9c733900a0c9a40ae7898fbc17d03bd554db8cbc" :answer/id #uuid "f83acd9e-e5a3-5337-8cea-5820374ddd37" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -5 \\\\ 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74943/selection/c261c17e0df271eaa1613683db7a0e30d4fafb03b1ee7f0ad7f59cc13df86662" :answer/id #uuid "6944e0d2-7f0a-5ae2-ab40-b6a69c2e74f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 & 1 \\\\ 2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74943/selection/0656450feaf7e26809435a0a8e9773c2eb0d912eabf8e85307c0357ce051540d" :answer/id #uuid "db95c697-5c2b-55ee-b859-2b813f559a11"