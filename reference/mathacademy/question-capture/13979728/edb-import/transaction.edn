d}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}4 & 7 \\\\ -5 & 8\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-317067/field-1" "q-317067/field-2" "q-317067/field-3" "q-317067/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c"] :knowledge-point/questions ["q-317067"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8301/selection/a3a4343291771b390481b4fa28aeafad0706649cc177437ee9724478ce125ce7" :answer/id #uuid "17f987f0-83a9-5064-b1f4-2e58832dfc43" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 12 \\\\ 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8301/selection/476eee87616552d5869e62dbfe1eb8f4a647916f91ef1806b3f05e6a79e1dfc9" :answer/id #uuid "ad5590b6-b5ba-564b-a260-08e0f9738eb9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 & -12 \\\\ -1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8301/selection/49cc94007c1288a61922da9a70bb9d7d98d15acf603541f7511bce6a1ea4b53d" :answer/id #uuid "5f6a30b6-75c2-5b6d-bb9b-f588b58fb95b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 12 \\\\ 1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8301/selection/4cb0dffe9c02dc6a2412a3986edd738a10f83cc9246699c4114e7914db6ca29a" :answer/id #uuid "81af885c-1d29-531c-bdf3-0f92b6f09443" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-12 & 5 \\\\ 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8301/selection/e23409420f873e76686b745060faa45446ef18dfbd9f901a2194439f9c0724fa" :answer/id #uuid "731f0292-8b03-527c-8cea-dffb6ef7de88" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 11 \\\\ -1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-8301/selection" :answer-field/id #uuid "26f370d7-c42d-528c-a730-8e2a0bd45d0a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8301/selection/4cb0dffe9c02dc6a2412a3986edd738a10f83cc9246699c4114e7914db6ca29a" :answer-field/choices ["q-8301/selection/a3a4343291771b390481b4fa28aeafad0706649cc177437ee9724478ce125ce7" "q-8301/selection/476eee87616552d5869e62dbfe1eb8f4a647916f91ef1806b3f05e6a79e1dfc9" "q-8301/selection/49cc94007c1288a61922da9a70bb9d7d98d15acf603541f7511bce6a1ea4b53d" "q-8301/selection/4cb0dffe9c02dc6a2412a3986edd738a10f83cc9246699c4114e7914db6ca29a" "q-8301/selection/e23409420f873e76686b745060faa45446ef18dfbd9f901a2194439f9c0724fa"] :db/ensure [:answer-field/validate]} {:db/id "q-8301" :question/id #uuid "275b123a-ba31-5124-8553-0cbb81013af7" :question/math-academy-id "q-8301" :question/problem "Find the standard matrix that represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}5y-12x \\\\ x+3y\\end{aligned}].\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-12x+5y \\\\ x+3y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-12x+5y \\\\ x+3y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-12 & 5 \\\\ 1 & 3\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-12x+5y \\\\ x+3y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}-12 & 5 \\\\ 1 & 3\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8301/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c"] :knowledge-point/questions ["q-8301"] :db/ensure [:knowledge-point/validate]} {:db/id "q-12011/selection/4a58e9e1760800caee4a8ff17dddbc6a1706484fa6b1367c3ec9462de0433598" :answer/id #uuid "cddc2688-3410-5d85-b2da-620a3e01508b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-12011/selection/431ea704d81ecac54305827e9c3f053d74bd38ede29f9c0b3bc8bb03eb46a151" :answer/id #uuid "64a3b3cc-f3a8-5a70-a7b1-0f10e1c4ea13" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-12011/selection/64b891f72eb727e1dad8d11b391985adc369fb79daea4b69994400b05e7a24bc" :answer/id #uuid "f96123ac-7c3c-5fac-b059-747529406b19" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-12011/selection/3923e5398a3af59a9a8724409adcf6d01a1b6b82d8d397894e58d646e9b07d23" :answer/id #uuid "e2423c71-954f-5cce-8aac-46437ddebfac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & 1 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-12011/selection/986a5af27fc8353ebc90b9cb0be9b6aeac066cb08e5468acf93adf41c16e725d" :answer/id #uuid "7438bbdd-fefd-5186-a042-8bfb27951987" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -3 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-12011/selection" :answer-field/id #uuid "5772e640-debb-51f0-9250-b51e9acae784" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12011/selection/3923e5398a3af59a9a8724409adcf6d01a1b6b82d8d397894e58d646e9b07d23" :answer-field/choices ["q-12011/selection/4a58e9e1760800caee4a8ff17dddbc6a1706484fa6b1367c3ec9462de0433598" "q-12011/selection/431ea704d81ecac54305827e9c3f053d74bd38ede29f9c0b3bc8bb03eb46a151" "q-12011/selection/64b891f72eb727e1dad8d11b391985adc369fb79daea4b69994400b05e7a24bc" "q-12011/selection/3923e5398a3af59a9a8724409adcf6d01a1b6b82d8d397894e58d646e9b07d23" "q-12011/selection/986a5af27fc8353ebc90b9cb0be9b6aeac066cb08e5468acf93adf41c16e725d"] :db/ensure [:answer-field/validate]} {:db/id "q-12011" :question/id #uuid "774edb89-af5c-5c1e-9a68-335238aae11f" :question/math-academy-id "q-12011" :question/problem "Find the standard matrix that represents  the  linear  transformation  $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}y-3x \\\\ y\\end{aligned}].\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}-3x+y \\\\ y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3x+y \\\\ y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-3 & 1 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-3x+y \\\\ y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation  $T$ is\n    \n\n$$\n[\\begin{aligned}-3 & 1 \\\\ 0 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12011/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c"] :knowledge-point/questions ["q-12011"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5431"] :question/problem "Find the standard matrix that represents  the  linear  transformation $\\mathbf{T},$ where\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$" :question/worked-solution "We require a $2\\times 2$ matrix ${T}$ such that\n    \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\n    Notice that\n    \n\n$$\n[\\begin{aligned}1 & 3 \\\\ 2 & -1\\end{aligned}]\n$$\n\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n    \n\n$$\n[\\begin{aligned}1 & 3 \\\\ 2 & -1\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5433"] :question/problem "What is the linear transformation $\\mathbf{T}$ whose standard matrix is $[\\begin{aligned}8 & -1 \\\\ -5 & -2\\end{aligned}]$" :question/worked-solution "Consider a general vector $[\\begin{aligned}x \\\\ y\\end{aligned}]$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}8 & -1 \\\\ -5 & -2\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}] \\\\  & =[\\begin{aligned}8x-y \\\\ -5x-2y\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,\\mathbf{T}\\,$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5434"] :question/problem "Consider the matrix $T$ and the vector $\\mathbf{v}$ given below. If $T$ is the standard matrix of the linear transformation $\\mathbf{T},$ find $\\mathbf{T}(\\mathbf{v}).$\n\n$$\n[\\begin{aligned}4 & 7 \\\\ -6 & -2\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,\\mathbf{T}(\\mathbf{v})=T\\cdot \\mathbf{v},$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}4 & 7 \\\\ -6 & -2\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}27 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5432"] :question/problem "Find the standard matrix that represents  the  linear  transformation $\\mathbf{T},$ where\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nWe require a $2\\times 2$ matrix ${T}$ such that\n    \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}-5 & 4 \\\\ 3 & 1\\end{aligned}]\n$$\n\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n    \n\n$$\n[\\begin{aligned}-5 & 4 \\\\ 3 & 1\\end{aligned}]\n$$" :db/ensure [:question/validate]}]
