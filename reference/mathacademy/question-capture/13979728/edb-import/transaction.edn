blem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T,$ find $T(v).$\n\n$$\nT=[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ 3 \\\\ 3\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-317053/field-1/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer/id #uuid "6451f7f6-eebf-5872-a2f2-b4542e62aae9" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "q-317053/field-1" :answer-field/id #uuid "61ddddb1-04f4-5cce-9933-544972f5201d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317053/field-1/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090" :answer-field/choices ["q-317053/field-1/6d8a7c7e73b503e82ee3fdeaeeda8131c0106d9ecb6a16ba218483b62acd0090"] :db/ensure [:answer-field/validate]} {:db/id "q-317053/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "17ea26b1-72b1-58fe-99ce-c27a85424ea0" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-317053/field-2" :answer-field/id #uuid "e49220b8-62eb-54e2-9863-85131df57974" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317053/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-317053/field-2/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-317053"