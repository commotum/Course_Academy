nd{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}5y \\\\ -2x+7y\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-317038/field-1" "q-317038/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c"] :knowledge-point/questions ["q-317038"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317065/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "152ee61b-53c3-53bf-a6fb-a22b30fce9c4" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-317065/field-1" :answer-field/id #uuid "e57030c8-89f1-5ac3-b780-b93fed2a8f05" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317065/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer-field/choices ["q-317065/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666"] :db/ensure [:answer-field/validate]} {:db/id "q-317065/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "17345452-9745-532a-831d-f81fa4944a91" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-317065/field-2" :answer-field/id #uuid "2383c032-b135-58a9-a5f5-0209d2adecfc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-317065/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer-field/choices ["q-317065/field-2/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-317065/field-3/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "e2013aee-d48e-5c7f-a962-76500ecc5308" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/valid