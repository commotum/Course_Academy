#{[{:db/id #edb/ref 17592186124239 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e73b8bcf-79c2-5326-b396-d7d3e06badaa" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation"}] :question/id #uuid "6aed23e0-cd3e-5940-a722-63550bcefc97" :question/math-academy-id "e-5431" :question/problem "Find the standard matrix that represents the linear transformation $\\mathbf{T}$, where\n$\\begin{bmatrix}x \\\\ y\\end{bmatrix}$" :question/worked-solution "We require a $2\\times 2$ matrix ${T}$ such that\n$\\begin{bmatrix}x \\\\ y\\end{bmatrix}$\nNotice that\n$\\begin{bmatrix}1 & 3 \\\\ 2 & -1\\end{bmatrix}$\n\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n$\\begin{bmatrix}1 & 3 \\\\ 2 & -1\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186124240 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "b2776554-94ce-5c25-b838-16fdfceddb1c" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation With Rearranging"}] :question/id #uuid "521cc49e-dddb-5add-b619-18e2785049f8" :question/math-academy-id "e-5432" :question/problem "Find the standard matrix that represents the linear transformation $\\mathbf{T}$, where\n$\\begin{bmatrix}x \\\\ y\\end{bmatrix}$" :question/worked-solution "First, rewrite the order of the variables in the usual way:\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$\n\nWe require a $2\\times 2$ matrix ${T}$ such that\n$\\begin{bmatrix}x \\\\ y\\end{bmatrix}$\n\nNotice that\n$\\begin{bmatrix}-5 & 4 \\\\ 3 & 1\\end{bmatrix}$\n\nTherefore, the matrix which represents the linear transformation $\\mathbf{T}$ is\n$\\begin{bmatrix}-5 & 4 \\\\ 3 & 1\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186124241 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "656da168-af12-53c2-8add-2c82cf71b31c" :knowledge-point/title "Determining a Linear Transformation Given its Standard Matrix"}] :question/id #uuid "77bd52ee-454e-5794-83e5-991e7e4c13b5" :question/math-academy-id "e-5433" :question/problem "What is the linear transformation $\\mathbf{T}$ whose standard matrix is $\\begin{bmatrix}8 & -1 \\\\ -5 & -2\\end{bmatrix}$" :question/worked-solution "Consider a general vector $\\begin{bmatrix}x \\\\ y\\end{bmatrix}$ Multiplying by the matrix $T$, we have\n\n$$\n\\begin{aligned}\nT \\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix} &= \\begin{bmatrix}8 & -1 \\\\ -5 & -2\\end{bmatrix} \\cdot \\begin{bmatrix}x \\\\ y\\end{bmatrix} \\\\\n&= \\begin{bmatrix}8x - y \\\\ -5x - 2y\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,\\mathbf{T}\\,$ is given by\n\n$$\n\\begin{bmatrix}x \\\\ y\\end{bmatrix}\n$$"}] [{:db/id #edb/ref 17592186124242 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/id #uuid "9c8d9615-6a5d-5b6a-8735-b9b2f58331f1" :question/math-academy-id "e-5434" :question/problem "Consider the matrix $T$ and the vector $\\mathbf{v}$ given below. If $T$ is the standard matrix of the linear transformation $\\mathbf{T}$, find $\\mathbf{T}(\\mathbf{v})$.\n\n$\\begin{bmatrix}4 & 7 \\\\ -6 & -2\\end{bmatrix}$" :question/worked-solution "Using the fact that\n\n$$\n\\,\\mathbf{T}(\\mathbf{v})=T\\cdot \\mathbf{v}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\nT(v) &= T \\cdot v \\\\\n&= \\begin{bmatrix}4 & 7 \\\\ -6 & -2\\end{bmatrix} \\cdot \\begin{bmatrix}-2 \\\\ 5\\end{bmatrix} \\\\\n&= \\begin{bmatrix}27 \\\\ 2\\end{bmatrix}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125027 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "863a0b0c-4d85-58df-b416-cd5d6ec9fd70" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 3 \\\\ 12\\end{bmatrix}" :db/id #edb/ref 17592186123185} {:answer/id #uuid "b3cacdbc-5429-57d2-9e5f-b2ec6d40455a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123186} {:answer/id #uuid "fcd1e744-184d-5af9-96c1-2b2e70c46b9c" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 12 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123187} {:answer/id #uuid "5f6c978f-3dc5-54e6-9361-6a4316c216b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 \\\\ 6 \\\\ 6\\end{bmatrix}" :db/id #edb/ref 17592186123188} {:answer/id #uuid "6bba33f4-e59f-5d92-aad2-e34a964b0415" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 \\\\ 4 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123189}] :answer-field/correct {:answer/id #uuid "b3cacdbc-5429-57d2-9e5f-b2ec6d40455a" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}16 \\\\ 3 \\\\ 3\\end{bmatrix}" :db/id #edb/ref 17592186123186} :answer-field/id #uuid "a5bbe309-e330-51ba-9760-7194eff2ef38" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123184}] :question/id #uuid "12f3bb3a-f83c-5bc7-89c6-1af5031ec24d" :question/math-academy-id "q-37881" :question/problem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T$, find $T(v)$.\n\n$T = \\begin{bmatrix}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{bmatrix}, v = \\begin{bmatrix}1 \\\\ 4 \\\\ -2\\end{bmatrix}$"}]}
