\ z\\end{aligned}].$ Multiplying by the matrix $T,$ we have\n\n$$\n\\begin{aligned}T\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}0 & 0 & 5 \\\\ 2 & 0 & 0 \\\\ 0 & 7 & 1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] \\\\  & =[\\begin{aligned}5z \\\\ 2x \\\\ 7y+z\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the linear transformation $\\,T\\,$ is given by\n\n$$\nT:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}5z \\\\ 2x \\\\ 7y+z\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186279979 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6451f7f6-eebf-5872-a2f2-b4542e62aae9" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186279981}] :answer-field/correct {:answer/id #uuid "6451f7f6-eebf-5872-a2f2-b4542e62aae9" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186279981} :answer-field/id #uuid "61ddddb1-04f4-5cce-9933-544972f5201d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279980} {:answer-field/choices [{:answer/id #uuid "17ea26b1-72b1-58fe-99ce-c27a85424ea0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186279983}] :answer-field/correct {:answer/id #uuid "17ea26b1-72b1-58fe-99ce-c27a85424ea0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186279983} :answer-field/id #uuid "e49220b8-62eb-54e2-9863-85131df57974" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279982}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ff53624a-6c98-5457-8bef-f17e2aa27d3d" :question/math-academy-id "q-317053" :question/problem "Consider the matrix $T$ and the vector $v$ given below. \n\n$$\nT=[\\begin{aligned}-4 & 3 \\\\ 2 & 5\\end{aligned}],\\,v=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$\n\nIf $\\,T\\,$ is the standard matrix of the linear transformation $\\,T,$ find $\\,T(v).$\n\n| $T(v)=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v\\,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-4 & 3 \\\\ 2 & 5\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-18 \\\\ -4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279984 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152ee61b-53c3-53bf-a6fb-a22b30fce9c4" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186279986}] :answer-field/correct {:answer/id #uuid "152ee61b-53c3-53bf-a6fb-a22b30fce9c4" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186279986} :answer-field/id #uuid "e57030c8-89f1-5ac3-b780-b93fed2a8f05" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186279985} {:answer-field/choices [{:answer/id #uuid "17345452-9745-532a-831d-f81fa4944a91" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186279988}] :answer-field/correct {:answer/id #uuid "17345452-9745-532a-831d-f81fa4944a91" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186279988} :answer-field/id #uuid "2383c032-b135-58a9-a5f5-0209d2adecfc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :d