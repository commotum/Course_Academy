#{[{:db/id #edb/ref 17592186361834 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3e11121-d75e-58b3-9ea2-ba2fb56b4903" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186361836} {:answer/id #uuid "96a25913-19bf-5520-8ebc-f479e0acec17" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186361837} {:answer/id #uuid "8d62874a-e38d-52cd-b6c1-92ca38cbebd8" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186361838} {:answer/id #uuid "ee41d749-511b-5c6d-8e88-2d96994657f7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186361839} {:answer/id #uuid "556f2eaa-8d04-56cc-ad3e-a0ef176f8198" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186361840}] :answer-field/correct {:answer/id #uuid "556f2eaa-8d04-56cc-ad3e-a0ef176f8198" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186361840} :answer-field/id #uuid "6d8c70c9-1f61-531a-a728-132ab42cd996" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361835}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0a8aedd2-1097-5d66-8eeb-656de3e77ac4" :question/math-academy-id "q-123278" :question/problem "Given that $r(t)=⟨\\sqrt{t+1},\\,t-3⟩,$ $|r(6)|=$" :question/worked-solution "Evaluating the function at $t=6,$ we get\n\n$$\n\\begin{aligned}r(6) & =⟨\\sqrt{6+1},\\,6-3⟩ \\\\  & =⟨\\sqrt{7},\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(6)| & =\\sqrt{{(\\sqrt{7})}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{7+9} \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186361841 :knowledge-point/_questions [{:knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fc4b4cb-9e3d-52a5-b4e0-bf340402c95f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186361843} {:answer/id #uuid "5ce2dd99-f10b-52b0-be9f-6b42aa560d9a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186361844} {:answer/id #uuid "4a2b73ff-75e0-58d5-b280-bca31579eaa6" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186361845} {:answer/id #uuid "fd1970cb-22e3-5928-b7b7-06ef9ca9a93c" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186361846} {:answer/id #uuid "d8547ab0-a3ca-54f8-b924-8ef28c4e00a2" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186361847}] :answer-field/correct {:answer/id #uuid "d8547ab0-a3ca-54f8-b924-8ef28c4e00a2" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186361847} :answer-field/id #uuid "5269d4ef-ca3d-5fc7-8098-eda91769c803" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361842}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ca1b55ce-6618-59da-a758-cf727ab94fd4" :question/math-academy-id "q-129219" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y={e}^{\\operatorname{sin}⁡(\\pi x)}?$ \n\n- $(-2,2]$\n- $[-2,4]$\n- $(-2,4)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval $(-2,2]$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-2,4]$ is closed, and the function is continuous on $[-2,4].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(-2,4)$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186361848 :knowledge-point/_questions [{:knowledge-point/id #uuid "106dce79-251c-52b2-adc7-9fd2b59b9b83" :knowledge-point/title "Solving an Inequality Involving Two Logarithmic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ad18234-c2f1-5de7-8b86-0489a830a837" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361850}] :answer-field/correct {:answer/id #uuid "6ad18234-c2f1-5de7-8b86-0489a830a837" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186361850} :answer-field/id #uuid "0bb8d367-be22-5532-b11b-b266c6ffd1d9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361849} {:answer-field/choices [{:answer/id #uuid "e0717a19-164f-51e4-8032-7b3d3f142c0d" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186361852}] :answer-field/correct {:answer/id #uuid "e0717a19-164f-51e4-8032-7b3d3f142c0d" :answer/type {:db/ident :answer.type/math} :answer/value "<" :db/id #edb/ref 17592186361852} :answer-field/id #uuid "f01ef642-7656-5c8c-af96-d141a5faa304" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361851} {:answer-field/choices [{:answer/id #uuid "07676991-05b9-5258-a67e-8d3deef9d373" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186361854}] :answer-field/correct {:answer/id #uuid "07676991-05b9-5258-a67e-8d3deef9d373" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186361854} :answer-field/id #uuid "ac5f18b9-9ac7-5341-94e3-123cfdb29d0f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361853}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "30a43708-f16f-596d-8fb5-c42ef7a03f99" :question/math-academy-id "q-276950" :question/problem "Solve the inequality $\\operatorname{log}⁡(2-x)+1\\le \\operatorname{log}⁡(x+9).$\n\n{{field-1}}$\\le \\,x$\n{{field-2}}{{field-3}}" :question/worked-solution "We use each side of the inequality as an exponent of $10.$ This gives the following:\n\n$$\n\\begin{aligned}{10}^{\\operatorname{log}⁡(2-x)+1} & \\le {10}^{\\operatorname{log}⁡(x+9)} \\\\ {10}^{\\operatorname{log}⁡(2-x)}\\cdot {10}^{1} & \\le {10}^{\\operatorname{log}⁡(x+9)} \\\\ (2-x)\\cdot 10 & \\le x+9 \\\\ 20-10x & \\le x+9 \\\\ -11x & \\le -11 \\\\ x & \\ge 1\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:\n\n$$\n\\begin{aligned}2-x & >0 & ⇒ &  & x & <2 \\\\ x+9 & >0 & ⇒ &  & x & >-9\\end{aligned}\n$$\n\nOur solution is $x\\ge 1,$ which can be expressed as $[1,\\infty ).$ Additionally, the domains of the logarithms are $x<2$ and $x>-11,$ which can be expressed as $(-\\infty ,2)$ and $(-11,\\infty )$ respectively. To find the solutions that are in the domains of the logarithms, we take the intersection:\n\n$$\n[1,\\infty )\\cap (-\\infty ,2)\\cap (-9,\\infty )=[1,2)\n$$\n\nTherefore, the solution is $x\\in [1,2),$ which can also be written as $1\\le x<2.$"}] [{:db/id #edb/ref 17592186361855 :knowledge-point/_questions [{:knowledge-point/id #uuid "e4bb90c5-2794-5657-8f0b-45eb64873e03" :knowledge-point/title "Finding a Cubic Polynomial Given One Real Root, Two Complex Roots, and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e783eb9-a681-5eba-aacc-969cf4aaad76" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186361857}] :answer-field/correct {:answer/id #uuid "1e783eb9-a681-5eba-aacc-969cf4aaad76" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186361857} :answer-field/id #uuid "caacf1bc-fd87-52e7-a970-e14f936e68d2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361856} {:answer-field/choices [{:answer/id #uuid "61eee858-9a01-5916-a798-6dae9f065b3b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186361859}] :answer-field/correct {:answer/id #uuid "61eee858-9a01-5916-a798-6dae9f065b3b" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186361859} :answer-field/id #uuid "6e87432d-f293-5f0a-97cd-73a0d11f52b5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361858} {:answer-field/choices [{:answer/id #uuid "0db6309b-88a7-5654-a2cc-a9af8a9e88e9" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186361861}] :answer-field/correct {:answer/id #uuid "0db6309b-88a7-5654-a2cc-a9af8a9e88e9" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186361861} :answer-field/id #uuid "28148e31-6f17-509e-82a6-3b63ae1ce93d" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361860} {:answer-field/choices [{:answer/id #uuid "c5cc0e13-1cd7-5e8d-b698-eb812c0cbabe" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186361863}] :answer-field/correct {:answer/id #uuid "c5cc0e13-1cd7-5e8d-b698-eb812c0cbabe" :answer/type {:db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186361863} :answer-field/id #uuid "e1338656-9fbd-550f-a4c6-448c80dd2aec" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186361862}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ffd0c8c4-243f-527a-8c14-0416289f3f43" :question/math-academy-id "q-316656" :question/problem "The cubic polynomial $f(x)$ has roots ${x}_{1}=5,{x}_{2,3}=-1\\pm 2\\text{i},$ and the coefficient of the cubic term is $-4.$ Find $f(x).$\n\n$f(x)=$\n{{field-1}}${x}^{3}\\,+$\n{{field-2}}${x}^{2}\\,+$\n{{field-3}}$x\\,+$\n{{field-4}}" :question/worked-solution "Since $f(x)$ has roots ${x}_{1}=5$ and ${x}_{2,3}=-1\\pm 2\\text{i},$ and the coefficient of the cubic term is $a=-4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}f(x) & =a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) \\\\  & =-4(x-5)(x-(-1+2\\text{i}))(x-(-1-2\\text{i})) \\\\  & =-4(x-5)(x-(-1+2\\text{i}))(x-(-1-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}-4(x-5)(x-(-1+2\\text{i}))(x-(-1-2\\text{i})) & = \\\\ -4(x-5)({x}^{2}-x(-1-2\\text{i})-x(-1+2\\text{i})+(-1+2\\text{i})(-1-2\\text{i})) & = \\\\ -4(x-5)({x}^{2}+2x+5) & = \\\\ -4({x}^{3}+2{x}^{2}+5x-5{x}^{2}-10x-25) & = \\\\ -4({x}^{3}-3{x}^{2}-5x-25) & = \\\\ -4{x}^{3}+12{x}^{2}+20x+100.\\end{aligned}\n$$\n\nTherefore, $f(x)=-4{x}^{3}+12{x}^{2}+20x+100.$"}] [{:db/id #edb/ref 17592186361864 :knowledge-point/_questions [{:knowledge-point/id #uuid "9dcde3b5-5cdf-5266-9392-0835053a7ded" :knowledge-point/title "Calculating a Definite Integral of Function Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36ab5a53-ee6a-55d4-891a-4100dfe7b2f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{484}{25}" :db/id #edb/ref 17592186361866} {:answer/id #uuid "ef99a009-6ed9-516b-9f51-a639fc401277" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{211}{5}" :db/id #edb/ref 17592186361867} {:answer/id #uuid "28f896fe-615c-5693-99e7-b6591110f4c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{96}{5}" :db/id #edb/ref 17592186361868} {:answer/id #uuid "f4b80bb4-7776-5793-95cb-0a1dff265265" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{25}" :db/id #edb/ref 17592186361869} {:answer/id #uuid "2f124855-4137-5692-a3f2-69212423fd83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{422}{25}" :db/id #edb/ref 17592186361870}] :answer-field/correct {:answer/id #uuid "2f124855-4137-5692-a3f2-69212423fd83" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{422}{25}" :db/id #edb/ref 17592186361870} :answer-field/id #uuid "a058c696-13e3-591e-a553-6de7c76888cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361865}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b67dc0a6-51f8-5dfe-a448-7ac0ef9d5e96" :question/math-academy-id "q-49613" :question/problem "Evaluate the definite integral ${\\int }_{2}^{3}\\sqrt{{(5x-6)}^{3}}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =5x-6 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =5 \\\\ \\text{d}u & =5\\,\\text{d}x \\\\ \\frac{1}{5}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=5x-6.$\n\n$$\n\\begin{aligned}x & 2 & 3 \\\\ u & 4 & 9\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{2}^{3}\\sqrt{{(5x-6)}^{3}}\\,\\text{d}x={\\int }_{4}^{9}\\sqrt{{u}^{3}}\\,\\cdot \\frac{1}{5}\\,\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}\\sqrt{{u}^{3}}\\,\\cdot \\frac{1}{5}\\,\\text{d}u & =\\frac{1}{5}{\\int }_{4}^{9}{u}^{3/2}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\cdot {\\frac{2}{5}{u}^{5/2}|}_{4}^{9} \\\\  & =\\frac{1}{5}\\cdot \\frac{2}{5}({9}^{5/2}-{4}^{5/2}) \\\\  & =\\frac{2}{25}(({3}^{2})^{5/2}-({2}^{2})^{5/2}) \\\\  & =\\frac{2}{25}({3}^{5}-{2}^{5}) \\\\  & =\\frac{2}{25}(243-32) \\\\  & =\\frac{422}{25}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186361871 :knowledge-point/_questions [{:knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da77c455-02e5-50bd-810e-e340a636b71c" :answer/type {:db/ident :answer.type/math} :answer/value "z=4\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186361873} {:answer/id #uuid "3da8bb85-6076-5ecf-8269-02ce64b53c97" :answer/type {:db/ident :answer.type/math} :answer/value "z=4\\sqrt{3}\\,{\\text{e}}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186361874} {:answer/id #uuid "c4a7b28b-9e88-5e6b-9c0f-2372746f313b" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186361875} {:answer/id #uuid "aeff69f1-6949-54b0-b1a7-ea39fe4aabfd" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186361876} {:answer/id #uuid "25e3fa19-33cc-54f8-ae33-526b77479b45" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186361877}] :answer-field/correct {:answer/id #uuid "25e3fa19-33cc-54f8-ae33-526b77479b45" :answer/type {:db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186361877} :answer-field/id #uuid "313e1229-1616-5b11-a259-8de3d7c72c67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361872}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ce405741-9ecc-5ff1-a4c2-a25ead99ec54" :question/math-academy-id "q-71979" :question/problem "Write the complex number $z=3-\\text{i}\\sqrt{3}$ in exponential form." :question/requires-calculator true :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{3}^{2}+{(-\\sqrt{3})}^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})| \\\\  & =2\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{11\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{3}$ and $\\theta =\\frac{11\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}.\n$$"}]}
