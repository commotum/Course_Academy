c{5}{6})}^{2}-1.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}6({x}^{2}+\\frac{5}{3}x-\\frac{11}{36}) & =6({(x+\\frac{5}{6})}^{2}-1) \\\\  & =6{(x+\\frac{5}{6})}^{2}-6\\cdot 1 \\\\  & =6{(x+\\frac{5}{6})}^{2}-6\\end{aligned}\n$$" 13194139533858 true] [17592186256023 1000 #edb/ref 17592186256024 13194139533858 true] [17592186256023 1000 #edb/ref 17592186256025 13194139533858 true] [17592186256023 1000 #edb/ref 17592186256026 13194139533858 true] [17592186256023 1000 #edb/ref 17592186256027 13194139533858 true] [17592186256023 1000 #edb/ref 17592186256028 13194139533858 true] [17592186256023 1040 #edb/ref 17592186045450 13194139533858 true] [17592186256023 1041 "selection" 13194139533858 true] [17592186256023 1104 #edb/ref 17592186256024 13194139533858 true] [17592186256023 1110 #uuid "1bfc736e-c31a-5fdc-bc6f-23b0ba457c0d" 13194139533858 true] [17592186256024 1034 "6{(x+\\frac{5}{6})}^{2}-6" 13194139533858 true] [17592186256024 1103 #edb/ref 17592186045453 13194139533858 true] [17592186256024 1111 #uuid "eec27287-96a4-590a-8bdb-a239184f3279" 13194139533858 true] [17592186256025 1034 "6{(x+\\frac{5}{3})}^{2}-3" 13194139533858 true] [17592186256025 1103 #edb/ref 17592186045453 13194139533858 true] [17592186256025 1111 #uuid "33f035f9-63da-5f06-961e-a84b459b7687" 13194139533858 true] [17592186256026 1034 "6{(x+\\frac{5}{3})}^{2}-1" 13194139533858 true] [17592186256026 1103 #edb/ref 17592186045453 13194139533858 true] [17592186256026 1111 #uuid "10f0d321-45e5-571e-9088-9b32d863c82e" 13194139533858 true] [17592186256027 1034 "6{(x+\\frac{10}{3})}^{2}-6" 13194139533858 true] [17592186256027 1103 #edb/ref 17592186045453 13194139533858 true] [17592186256027 1111 #uuid "ecc17d5a-6198-58e3-89f4-6b0518ec8740" 13194139533858 true] [17592186256028 1034 "6{(x+\\frac{5}{6})}^{2}-1" 13194139533858 true] [17592186256028 1103 #edb/ref 17592186045453 13194139533858 true] [17592186256028 1111 #uuid "c3b9008d-9206-597d-a1c5-2ef2ab34c