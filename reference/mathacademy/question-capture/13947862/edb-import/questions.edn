#{[{:db/id #edb/ref 17592186184748 :knowledge-point/_questions [{:knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/feedback "This uses the wrong binomial sign, producing linear term $-6y$. The outside constant also does not restore the original value $1$." :answer/id #uuid "b89a7b80-c790-543c-bffa-af151187068d" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y + 1)^{2} + \\frac{4}{3}" :db/id #edb/ref 17592186183378} {:answer/feedback "Factoring $-3$ gives $-3(y^2-2y-\\frac13)$. The inner expression is $(y-1)^2-\\frac43$, so distributing $-3$ gives $-3(y-1)^2+4$." :answer/id #uuid "f6eff644-d0a1-5f3e-9ccd-44710dccb783" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - 1)^{2} + 4" :db/id #edb/ref 17592186183379} {:answer/feedback "Expanding the square produces linear term $+2y$, not $+6y$. After factoring $-3$, half of the inner linear coefficient $-2$ is $-1$." :answer/id #uuid "f9abfb28-f57e-5dd3-81fd-c70e1110fbc3" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - \\frac{1}{3})^{2} + 4" :db/id #edb/ref 17592186183380} {:answer/feedback "The plus sign inside the square produces linear term $-6y$ after multiplication by $-3$. The original linear term is $+6y$." :answer/id #uuid "40cc068b-ca35-5d3c-8558-8c7f7cb11f35" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y + 1)^{2} - 4" :db/id #edb/ref 17592186183381} {:answer/feedback "The square gives the correct quadratic and linear terms, but this has constant $-3-\\frac43=-\\frac{13}{3}$. The required outside adjustment is $+4$." :answer/id #uuid "477eb269-e876-50c4-a2d0-13316d398f1f" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - 1)^{2} - \\frac{4}{3}" :db/id #edb/ref 17592186183382}] :answer-field/correct {:answer/feedback "Factoring $-3$ gives $-3(y^2-2y-\\frac13)$. The inner expression is $(y-1)^2-\\frac43$, so distributing $-3$ gives $-3(y-1)^2+4$." :answer/id #uuid "f6eff644-d0a1-5f3e-9ccd-44710dccb783" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - 1)^{2} + 4" :db/id #edb/ref 17592186183379} :answer-field/id #uuid "3fd30803-8492-5968-b20c-ebedf376c505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183377}] :question/id #uuid "f4b82526-21d1-5906-b903-379b7a33781d" :question/math-academy-id "q-52544" :question/problem "Rewrite $-3y^{2} + 6y + 1$ by completing the square." :question/worked-solution "Factoring $-3$ gives $-3(y^2-2y-\\frac13)$. The inner expression is $(y-1)^2-\\frac43$, so distributing $-3$ gives $-3(y-1)^2+4$."}]}
