#{[{:db/id #edb/ref 17592186256008 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1a90a10-21d5-55c5-b19b-db7c91f5ebb6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{4}-{(x+\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186256010} {:answer/id #uuid "89e6201a-ffd8-5a86-9c93-6e41bfded996" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186256011} {:answer/id #uuid "63d69f5a-b2cb-549c-9b83-29dfc975d696" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186256012} {:answer/id #uuid "be426baa-55bb-560d-b0aa-d9fae1f28a32" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}-{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186256013} {:answer/id #uuid "b37ccd3f-3d21-50eb-b0b7-7222d68bdbf8" :answer/type {:db/ident :answer.type/math} :answer/value "6-{(x-2)}^{2}" :db/id #edb/ref 17592186256014}] :answer-field/correct {:answer/id #uuid "89e6201a-ffd8-5a86-9c93-6e41bfded996" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x-\\frac{1}{2})}^{2}" :db/id #edb/ref 17592186256011} :answer-field/id #uuid "4cea6423-0808-507a-b960-5b857f67e506" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256009}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "dbe926ee-762a-5e17-9033-da4b3ab1c650" :question/math-academy-id "q-140332" :question/problem "Rewrite $-({x}^{2}-x-2)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-x-2\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{1}{2}x-2\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{2})}^{2},$ writing the constant term $2$ last:\n\n$$\n{{x}^{2}-2\\cdot \\frac{1}{2}x+{(\\frac{1}{2})}^{2}}_{⏟}-{(\\frac{1}{2})}^{2}-2\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{1}{2})}^{2}-{(\\frac{1}{2})}^{2}-2\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x-\\frac{1}{2})}^{2}-\\frac{9}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}-x-2) & =-({(x-\\frac{1}{2})}^{2}-\\frac{9}{4}) \\\\  & =-{(x-\\frac{1}{2})}^{2}+\\frac{9}{4} \\\\  & =\\frac{9}{4}-{(x-\\frac{1}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256015 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf98753-a420-52e4-b4b8-24bc1fc005aa" :answer/type {:db/ident :answer.type/math} :answer/value "61-{(y+18)}^{2}" :db/id #edb/ref 17592186256017} {:answer/id #uuid "550266fd-139d-51f4-a898-c1630f39f3ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{161}{4}-{(y-\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186256018} {:answer/id #uuid "170d0483-4547-501d-add3-92ddac362220" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186256019} {:answer/id #uuid "d30291c7-e575-59e8-85d7-cee0a0dac214" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186256020} {:answer/id #uuid "ab58645a-9bcf-567b-a560-cffe5e08eb98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186256021}] :answer-field/correct {:answer/id #uuid "ab58645a-9bcf-567b-a560-cffe5e08eb98" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186256021} :answer-field/id #uuid "83bbfda0-2a2c-5dd5-8b70-0051a76a29af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256016}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "46c23e9e-2448-5acd-a673-896062dd7b10" :question/math-academy-id "q-140333" :question/problem "Rewrite $-({y}^{2}+9y+20)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}+9y+20\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{9}{2}y+20\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{9}{2})}^{2},$ writing the constant term $20$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{9}{2}y+{(\\frac{9}{2})}^{2}}_{⏟}-{(\\frac{9}{2})}^{2}+20\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{9}{2})}^{2}-{(\\frac{9}{2})}^{2}+20\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y+\\frac{9}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}+9y+20) & =-({(y+\\frac{9}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y+\\frac{9}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256022 :knowledge-point/_questions [{:knowledge-point/id #uuid "564f2cf7-aaaf-5dea-b619-a560c3151fcc" :knowledge-point/title "Completing the Square on an Expression With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eec27287-96a4-590a-8bdb-a239184f3279" :answer/type {:db/ident :answer.type/math} :answer/value "6{(x+\\frac{5}{6})}^{2}-6" :db/id #edb/ref 17592186256024} {:answer/id #uuid "33f035f9-63da-5f06-961e-a84b459b7687" :answer/type {:db/ident :answer.type/math} :answer/value "6{(x+\\frac{5}{3})}^{2}-3" :db/id #edb/ref 17592186256025} {:answer/id #uuid "10f0d321-45e5-571e-9088-9b32d863c82e" :answer/type {:db/ident :answer.type/math} :answer/value "6{(x+\\frac{5}{3})}^{2}-1" :db/id #edb/ref 17592186256026} {:answer/id #uuid "ecc17d5a-6198-58e3-89f4-6b0518ec8740" :answer/type {:db/ident :answer.type/math} :answer/value "6{(x+\\frac{10}{3})}^{2}-6" :db/id #edb/ref 17592186256027} {:answer/id #uuid "c3b9008d-9206-597d-a1c5-2ef2ab34c51e" :answer/type {:db/ident :answer.type/math} :answer/value "6{(x+\\frac{5}{6})}^{2}-1" :db/id #edb/ref 17592186256028}] :answer-field/correct {:answer/id #uuid "eec27287-96a4-590a-8bdb-a239184f3279" :answer/type {:db/ident :answer.type/math} :answer/value "6{(x+\\frac{5}{6})}^{2}-6" :db/id #edb/ref 17592186256024} :answer-field/id #uuid "1bfc736e-c31a-5fdc-bc6f-23b0ba457c0d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256023}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "71b04e78-c149-5982-a00d-24fd0a042784" :question/math-academy-id "q-140375" :question/problem "Rewrite $6{x}^{2}+10x-\\frac{11}{6}$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $6.$ So, we take out a factor of $6$ from the entire expression:\n\n$$\n6({x}^{2}+\\frac{5}{3}x-\\frac{11}{36})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+\\frac{5}{3}x-\\frac{11}{36}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{5}{6}\\cdot x-\\frac{11}{36}\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{5}{6})}^{2},$ writing the constant term $\\frac{11}{36}$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{5}{6}\\cdot x+{(\\frac{5}{6})}^{2}}_{⏟}-{(\\frac{5}{6})}^{2}-\\frac{11}{36}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{5}{6})}^{2}-{(\\frac{5}{6})}^{2}-\\frac{11}{36}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{5}{6})}^{2}-1.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}6({x}^{2}+\\frac{5}{3}x-\\frac{11}{36}) & =6({(x+\\frac{5}{6})}^{2}-1) \\\\  & =6{(x+\\frac{5}{6})}^{2}-6\\cdot 1 \\\\  & =6{(x+\\frac{5}{6})}^{2}-6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256029 :knowledge-point/_questions [{:knowledge-point/id #uuid "564f2cf7-aaaf-5dea-b619-a560c3151fcc" :knowledge-point/title "Completing the Square on an Expression With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2acc9f0-5722-5eb2-82d3-0dd8c1896a33" :answer/type {:db/ident :answer.type/math} :answer/value "(x-2)^{2}+5" :db/id #edb/ref 17592186256031} {:answer/id #uuid "d390abc9-01bc-51af-8632-2e8080576716" :answer/type {:db/ident :answer.type/math} :answer/value "5(x-2)^{2}-2" :db/id #edb/ref 17592186256032} {:answer/id #uuid "c45560aa-2300-5383-8b3d-0af649a859d3" :answer/type {:db/ident :answer.type/math} :answer/value "(x+5)^{2}+1" :db/id #edb/ref 17592186256033} {:answer/id #uuid "95981072-0715-57c0-a38e-ba6003674a8f" :answer/type {:db/ident :answer.type/math} :answer/value "5(x-2)^{2}+1" :db/id #edb/ref 17592186256034} {:answer/id #uuid "727a8079-9680-5f98-8042-d4a670d2b9cf" :answer/type {:db/ident :answer.type/math} :answer/value "5(x-2)^{2}+5" :db/id #edb/ref 17592186256035}] :answer-field/correct {:answer/id #uuid "727a8079-9680-5f98-8042-d4a670d2b9cf" :answer/type {:db/ident :answer.type/math} :answer/value "5(x-2)^{2}+5" :db/id #edb/ref 17592186256035} :answer-field/id #uuid "77af4ed2-3504-598c-91f6-efd54383dad1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256030}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "71c7c147-b250-5795-95ad-bdcd7961182a" :question/math-academy-id "q-52538" :question/problem "Rewrite $5{x}^{2}-20x+25$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $5.$ So, we take out a factor of $5$ from the entire expression:\n\n$$\n5({x}^{2}-4x+5)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-4x+5\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 2x+5\n$$\n\nThen, we *add* and *then subtract* ${2}^{2},$ writing the constant term $5$ last:\n\n$$\n{{x}^{2}-2\\cdot 2x+{2}^{2}}_{⏟}-{2}^{2}+5\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-2)^{2}-{2}^{2}+5\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x-2)^{2}+1\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}5({x}^{2}-4x+5) & =5((x-2)^{2}+1) \\\\  & =5{(x-2)}^{2}+5\\cdot 1 \\\\  & =5{(x-2)}^{2}+5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184748 :knowledge-point/_questions [{:knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/feedback "This uses the wrong binomial sign, producing linear term $-6y$. The outside constant also does not restore the original value $1$." :answer/id #uuid "b89a7b80-c790-543c-bffa-af151187068d" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y + 1)^{2} + \\frac{4}{3}" :db/id #edb/ref 17592186183378} {:answer/feedback "Factoring $-3$ gives $-3(y^2-2y-\\frac13)$. The inner expression is $(y-1)^2-\\frac43$, so distributing $-3$ gives $-3(y-1)^2+4$." :answer/id #uuid "f6eff644-d0a1-5f3e-9ccd-44710dccb783" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - 1)^{2} + 4" :db/id #edb/ref 17592186183379} {:answer/feedback "Expanding the square produces linear term $+2y$, not $+6y$. After factoring $-3$, half of the inner linear coefficient $-2$ is $-1$." :answer/id #uuid "f9abfb28-f57e-5dd3-81fd-c70e1110fbc3" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - \\frac{1}{3})^{2} + 4" :db/id #edb/ref 17592186183380} {:answer/feedback "The plus sign inside the square produces linear term $-6y$ after multiplication by $-3$. The original linear term is $+6y$." :answer/id #uuid "40cc068b-ca35-5d3c-8558-8c7f7cb11f35" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y + 1)^{2} - 4" :db/id #edb/ref 17592186183381} {:answer/feedback "The square gives the correct quadratic and linear terms, but this has constant $-3-\\frac43=-\\frac{13}{3}$. The required outside adjustment is $+4$." :answer/id #uuid "477eb269-e876-50c4-a2d0-13316d398f1f" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - 1)^{2} - \\frac{4}{3}" :db/id #edb/ref 17592186183382}] :answer-field/correct {:answer/feedback "Factoring $-3$ gives $-3(y^2-2y-\\frac13)$. The inner expression is $(y-1)^2-\\frac43$, so distributing $-3$ gives $-3(y-1)^2+4$." :answer/id #uuid "f6eff644-d0a1-5f3e-9ccd-44710dccb783" :answer/type {:db/ident :answer.type/math} :answer/value "-3(y - 1)^{2} + 4" :db/id #edb/ref 17592186183379} :answer-field/id #uuid "3fd30803-8492-5968-b20c-ebedf376c505" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186183377}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f4b82526-21d1-5906-b903-379b7a33781d" :question/math-academy-id "q-52544" :question/problem "Rewrite $-3y^{2} + 6y + 1$ by completing the square." :question/worked-solution "Factoring $-3$ gives $-3(y^2-2y-\\frac13)$. The inner expression is $(y-1)^2-\\frac43$, so distributing $-3$ gives $-3(y-1)^2+4$."}]}
