\sqrt{3}}{2}) \\\\  & =-6\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-6\\sqrt{3},-6).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-120719" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/activity-metadata.json" "file_sha256" "ba79cff155e0b4bec660a0e94848c57d818a7735eb402933d36910253133e00d"} {"question" "q-120719" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-120719" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-12\\sqrt{3},-12)"] ["math" "(-4\\sqrt{3},-4)"] ["math" "(-6\\sqrt{2},-8)"] ["math" "(-6\\sqrt{3},-6)"] ["math" "(-8\\sqrt{3},-8)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-120719" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-6\\sqrt{3},-6)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-321322" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/assets/c922feb998c41aae1ab40e3e6f240b07756699d4756b91458ff8271cec152f7f.png)\n\nFind the polar equation of the ray shown above. Assume that the polar angle is in the range $[0,2\\pi ).$\n\nThe polar equation is $\\theta =$\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-321322" "field" nil "attribute" "question/worked-solution" "value" "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi -\\frac{\\pi }{4}=\\frac{3\\pi }{4}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{3\\pi }{4}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-321322" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/activity-metadata.json" "file_sha256" "ba79cff155e0b4bec660a0e94848c57d818a7735eb402933d36910253133e00d"} {"question" "q-321322" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8de"} {"question" "q-321322" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3\\pi}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040379/state.json" "file_sha256" "6001777ea447cce3ae7f8cc6ab0ea89cda6289dae88ba9083f4a5a10f86ed8