 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbef247c-5ec9-59f7-af79-4277808399f2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1+4{x}^{2}}}" :db/id #edb/ref 17592186279874} {:answer/id #uuid "6994b762-fd11-5bae-8c65-10b6682fb248" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{1+2{x}^{2}}}" :db/id #edb/ref 17592186279875} {:answer/id #uuid "d5b1bbd4-8955-50ad-9ede-bd633ddaef97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186279876} {:answer/id #uuid "4ff70900-dd9c-5220-8d03-f69c0dea67ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{1-2{x}^{2}}}" :db/id #edb/ref 17592186279877} {:answer/id #uuid "8662d8e9-e820-597e-930a-a92a121d5f8e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{1-2{x}^{2}}}" :db/id #edb/ref 17592186279878}] :answer-field/correct {:answer/id #uuid "d5b1bbd4-8955-50ad-9ede-bd633ddaef97" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{1-4{x}^{2}}}" :db/id #edb/ref 17592186279876} :answer-field/id #uuid "971dd749-bb6d-5620-af11-6dab0b848d60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279873}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6dde5727-a652-51c9-b9df-64f8f2feb200" :question/math-academy-id "q-86179" :question/problem "Find ${f}^{′}(x)$  for $f(x)=4\\operatorname{arcsin}⁡(2x).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4\\operatorname{arcsin}⁡(2x)) \\\\  & =4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡(2x)) \\\\  & =4\\cdot \\frac{1}{\\sqrt{1-(2x)^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =4\\cdot \\frac{1}{\\sqrt{1-4{x}^{2}}}\\cdot 2 \\\\  & =\\frac{8}{\\sqrt{1-4{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186279879 :knowledge-point/_questions [{:knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b00a06bf-d5b9-5eb0-b146-fad6cc83f72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{1-{x}^{2}}}+\\frac{1}{4{x}^{2}}" :db/id #edb/ref 17592186279881} {:answer/id #uuid "3cd48479-51ea-5665-87ed-c0f1c81ab72e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{{x}^{2}-1}}-\\frac{1}{4{x}^{2}}" :db/id #edb/ref 17592186279882} {:answer/id #uuid "ff252a35-cf0b-5114-bf53-66cb24d29637" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{{x}^{2}-1}}+\\frac{1}{4{x}^{2}}" :db/id #edb/ref 17592186279883} {:answer/id #uuid "200a9723-cdce-5dfd-80fc-c6883dd06336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{1-{x}^{2}}}+\\frac{1}{2{x}^{2}}" :db/id #edb/ref 17592186279884} {:answer/id #uuid "23ef26c1-fe74-58ed-98d3-e4c7d7bc5933" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{1-{x}^{2}}}-\\frac{1}{2{x}^{2}}" :db/id #edb/ref 17592186279885}] :answer-field/correct {:answer/id #uuid "b00a06bf-d5b9-5eb0-b146-fad6cc83f72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{1-{x}^{2}}}+\\frac{1}{4{x}^{2}}" :db/id #edb/ref 17592186279881} :answer-field/id #uuid "a1301fa2-e7d5-579d-9d56-d82210753faa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186279880}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "27511b1b-a69e-5e84-941f-4abfefc8852d" :question/math-academy-id "q-86181" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arcsin}⁡x}{4}-\\frac{1}{4x}.$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arcsin}⁡x}{4}-\\frac{1}{4x}) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)+\\frac{1}{4{x}^{2}} \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}+\\frac{1}{4{x}^{2}} \\\\  & =\\frac{1}{4\\sqrt{1-{x}^{2}}}+\\frac{1}{4{x}^{2}}.\\end{aligned}\n$$"}]}
