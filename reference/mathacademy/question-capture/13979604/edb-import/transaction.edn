d44a0c0e4fb42f94e1808b533415deaa08f0f44"] :db/ensure [:answer-field/validate]} {:db/id "q-73508" :question/id #uuid "07c43915-1f0c-56ab-8fe5-9b8efdf9d4b8" :question/math-academy-id "q-73508" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=8\\operatorname{arcsin}⁡({e}^{x}).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[8\\operatorname{arcsin}⁡({e}^{x})] \\\\  & =8\\cdot \\frac{1}{\\sqrt{1-{({e}^{x})}^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{8}{\\sqrt{1-{e}^{2x}}}\\cdot {e}^{x} \\\\  & =\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73508/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052"] :knowledge-point/questions ["q-73508"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86181/selection/8a99bce63d1f105312ea33f65da7b70f218c86abb832891258d6f9d40bd81a56" :answer/id #uuid "3cd48479-51ea-5665-87ed-c0f1c81ab72e" :answer/type :answer.type/math :answer/value "\\frac{1}{4\\sqrt{{x}^{2}-1}}-\\frac{1}{4{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-86181/selection/cee66d6179378ad3910428e1f7f28893ee4eaace28b12d0bceedc2626a925f11" :answer/id #uuid "200a9723-cdce-5dfd-80fc-c6883dd06336" :answer/type :answer.type/math :answer/value "\\frac{1}{4\\sqrt{1-{x}^{2}}}+\\frac{1}{2{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-86181/selection/c1d98b5c0e84f1c9999a3bd91fe1669039704850c5f70cfc1c5a756780f8ebcb" :answer/id #uuid "ff252a35-cf0b-5114-bf53-66cb24d29637" :answer/type :answer.type/math :answer/value "\\frac{1}{4\\sqrt{{x}^{2}-1}}+\\frac{1}{4{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-86181/selection/d4280acc23b170c83f4a7b134493d9a485db6a0