atorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5x+4\\operatorname{arccos}⁡x) \\\\  & =5+4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =5+4(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =5-\\frac{4}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110625/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd"] :knowledge-point/questions ["q-110625"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73500/selection/5f76ed7ccd7bb5c6de5699e92fe32f6a8a56bc63c285a0c15dbf7fdc41759c9f" :answer/id #uuid "f41f8327-21d7-5318-ba53-49be5e032381" :answer/type :answer.type/math :answer/value "2-\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73500/selection/219793296039dd09186488af9b95d30e2132432029a448e3cd47434e5d59a3f0" :answer/id #uuid "7bce9502-0419-58cf-b883-e33d03730128" :answer/type :answer.type/math :answer/value "2+\\frac{5}{\\sqrt{1+{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73500/selection/c30db9f8c996df3b6d87362352409ab33c3cac76e8af1b07aff1e06b1a898b1e" :answer/id #uuid "0c4d2832-0e56-5858-869b-10f81a4afbf2" :answer/type :answer.type/math :answer/value "2-\\frac{5}{\\sqrt{1+{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73500/selection/99a8c36fa25f281bd87abe1e182e77797fa0c48c24572e5f043505ffcad8ea11" :answer/id #uuid "e74b74aa-9409-5c07-a9d1-e64144e6d9d3" :answer/type :answer.type/math :answer/value "2+\\frac{1}{5\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73500/selection/cf5885466e947ee558571ea0247d9f64563df486b9935403aa541a9fe5f43d72" :answer/id #uuid "021b6bce-fa11-5f66-acfc-1a6e91101c6b" :answer/type :answer.type/math :answer/value "2+\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73500/selection" :answer-field/id #uuid "e3ca59e4-