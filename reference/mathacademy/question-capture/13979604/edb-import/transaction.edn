} \\\\  & =\\frac{1}{4\\sqrt{1-{x}^{2}}}+\\frac{1}{4{x}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86181/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052"] :knowledge-point/questions ["q-86181"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73507/selection/7ccf98c943918b6946fbb49e388efdac2e88979ecdc06a012f9b56332abbc05c" :answer/id #uuid "ff36e148-7e72-5dc4-9410-625a3ab7d71b" :answer/type :answer.type/math :answer/value "\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73507/selection/a9e9d5a662d4ee2b7ec630fd001bd29bc18c8f945102015429cd7949210d7575" :answer/id #uuid "f1adac43-b31c-5167-9ac5-6435a5aadb2a" :answer/type :answer.type/math :answer/value "\\frac{1}{9\\sqrt{1+{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73507/selection/a5ec64e17137f1f2a2f46927e3f5a426c179742379ab7a3c97051bd8ef269a27" :answer/id #uuid "b9a57ee4-36b1-511f-b3af-4dbda883a583" :answer/type :answer.type/math :answer/value "-\\frac{9}{\\sqrt{1+{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73507/selection/8e78da3d263d3be8631ffb2049017144af33868c696c01100e927067ead65fae" :answer/id #uuid "44cd6e84-2f27-5c50-8df2-bff03d314ae3" :answer/type :answer.type/math :answer/value "\\frac{9}{\\sqrt{1+{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73507/selection/cfd3e5f0dc1878303e213cf60b3e287afa168eea2ab6476ca96b8b358c97579e" :answer/id #uuid "04858987-53fa-587d-833f-b3a470d1c783" :answer/type :answer.type/math :answer/value "-\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-73507/selection" :answer-field/id #uuid "9f94548a-0b16-58c6-a68d-cb0fc920d870" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73507/selection/7ccf98c943918b6946fbb49e388efdac2e88979ecdc06a012f9b56332abbc05c" :answer-field/choices ["q-73507/selection/7ccf98c943918b6946fbb49e388efdac2e88979ecdc