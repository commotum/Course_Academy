40340e91729f08c496f92531" :answer/id #uuid "b327d83d-0bd6-510e-aced-235697c56348" :answer/type :answer.type/math :answer/value "\\frac{1}{1+(5x-4)^2}" :db/ensure [:answer/validate]} {:db/id "q-314735/field-1" :answer-field/id #uuid "184cb8e7-8d9c-5fb7-b85e-925185d38059" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-314735/field-1/357b4aed864489d9c0b6d4bb40bcbebd6c8202d91a8dd595b749d2f8e0255e0d" :answer-field/choices ["q-314735/field-1/357b4aed864489d9c0b6d4bb40bcbebd6c8202d91a8dd595b749d2f8e0255e0d" "q-314735/field-1/3c283a2fbce06da193c2427e90fec4bdb65f72f540340e91729f08c496f92531"] :db/ensure [:answer-field/validate]} {:db/id "q-314735" :question/id #uuid "7394d353-33a6-52d4-886a-276297e613d4" :question/math-academy-id "q-314735" :question/problem "Find ${f}^{′}(x)$ for $f(x)=\\operatorname{arctan}⁡(5x-4)+2.$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(5x-4)+2) \\\\  & =\\frac{1}{1+{(5x-4)}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(5x-4)+0 \\\\  & =\\frac{1}{1+{(5x-4)}^{2}}\\cdot 5 \\\\  & =\\frac{5}{1+{(5x-4)}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-314735/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2"] :knowledge-point/questions ["q-314735"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19080/selection/c9ed8c7e5ed56fb027dff65931b110d90edb52ad7ca6271bda7866620bce458a" :answer/id #uuid "e8139565-b2de-52be-92c7-152bfad978d0" :answer/type :answer.type/math :answer/value "\\frac{3{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-19080/selection/df6556d06457e0721b4729f99e94be3c87652ce264399547488b538982df7099" :answer/id #uuid "c74b2ced-f728-52bd-8bd7-fd5fa4418d97" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(3{e}^{x})}{1+9{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-19080/selection/051fd7343305956d30f7c6d9c74b0ea0378328af6922eb1075bb97dca191d50c" :answer/id #uuid "7dbcb75f-1a64-5fce-a8c0-7edd8c28ca65" :answer/type :answer.type/math :answer/value "\\frac{6{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+9{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-19080/selection/caab784f8d80b202cbe480a63b32f398818fa7167dbfef3ba0176b392466ece6" :answer/id #uuid "cb58dd0a-98fa-59b5-b098-4cba9ee94768" :answer/type :answer.type/math :answer/value "\\frac{6{e}^{x}}{1+9{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-19080/selection/d08dc89c9ecc5e9ac3c2f41343f939e5ce89812cbc36a0dcf3114dd6e75be3ee" :answer/id #uuid "5a9cc951-1340-57a6-91fd-a2e8fd7b131f" :answer/type :answer.type/math :answer/value "\\frac{2{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+3{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-19080/selection" :answer-field/id #uuid "63da8d0c-b989-5dc3-a662-0e116b58a991" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19080/selection/051fd7343305956d30f7c6d9c74b0ea0378328af6922eb1075bb97dca191d50c" :answer-field/choices ["q-19080/selection/c9ed8c7e5ed56fb027dff65931b110d90edb52ad7ca6271bda7866620bce458a" "q-19080/selection/df6556d06457e0721b4729f99e94be3c87652ce264399547488b538982df7099" "q-19080/selection/051fd7343305956d30f7c6d9c74b0ea0378328af6922eb1075bb97dca191d50c" "q-19080/selection/caab784f8d80b202cbe480a63b32f398818fa7167dbfef3ba0176b392466ece6" "q-19080/selection/d08dc89c9ecc5e9ac3c2f41343f939e5ce89812cbc36a0dcf3114dd6e75be3ee"] :db/ensure [:answer-field/validate]} {:db/id "q-19080" :question/id #uuid "824f3163-7ee2-50bf-ba23-40c7883d87a6" :question/math-academy-id "q-19080" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)={arctan}^{2}⁡(3{e}^{x}).$" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({arctan}^{2}⁡(3{e}^{x})) \\\\  & =2\\operatorname{arctan}⁡(3{e}^{x})\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(3{e}^{x})) \\\\  & =2\\operatorname{arctan}⁡(3{e}^{x})\\cdot \\frac{1}{1+{(3{e}^{x})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(3{e}^{x}) \\\\  & =2\\operatorname{arctan}⁡(3{e}^{x})\\cdot \\frac{1}{1+9{e}^{2x}}\\cdot 3{e}^{x} \\\\  & =\\frac{6{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+9{e}^{2x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-19080/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2"] :knowledge-point/questions ["q-19080"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343769/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "6821cf03-60b5-545b-ab70-bddb576ba2c1" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-343769/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "a8710538-75df-5870-bb03-bd7b948c57d1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-343769/field-1" :answer-field/id #uuid "570cec3e-9322-5c68-926d-3833dc9587a5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343769/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-343769/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-343769/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-343769" :question/id #uuid "7f3323c8-7620-5f06-922a-9c432a075649" :question/math-academy-id "q-343769" :question/problem "Find the exact value of the slope $m$ of the tangent line to the curve $f(x)=3\\operatorname{arctan}⁡({x}^{2}-2x)$ at $x=2.$\n\n$m=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[3\\operatorname{arctan}⁡({x}^{2}-2x)] \\\\  & =3\\cdot \\frac{1}{1+({x}^{2}-2x)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}-2x) \\\\  & =\\frac{3}{1+{x}^{4}-4{x}^{3}+4{x}^{2}}\\cdot (2x-2) \\\\  & =\\frac{6x-6}{{x}^{4}-4{x}^{3}+4{x}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve $y=f(x)$ at $x=2$ is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =\\frac{6(2)-6}{(2)^{4}-4(2)^{3}+4(2)^{2}+1} \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-343769/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2"] :knowledge-point/questions ["q-343769"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343687/field-1/85c7f9ddd88bc37c35c67c22ae92241f1383c452347bf76a2279224ee2653506" :answer/id #uuid "417e8c6d-2736-5321-ba7f-aae9f99f5e4c" :answer/type :answer.type/math :answer/value "\\frac{6x^2+1}{1+(2x^3+x)^2}" :db/ensure [:answer/validate]} {:db/id "q-343687/field-1" :answer-field/id #uuid "c76e533b-8311-5bb6-b75d-67ef402afce1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343687/field-1/85c7f9ddd88bc37c35c67c22ae92241f1383c452347bf76a2279224ee2653506" :answer-field/choices ["q-343687/field-1/85c7f9ddd88bc37c35c67c22ae92241f1383c452347bf76a2279224ee2653506"] :db/ensure [:answer-field/validate]} {:db/id "q-343687" :question/id #uuid "146698a5-a545-5ee8-a19e-758c40e24662" :question/math-academy-id "q-343687" :question/problem "Find ${y}^{′}$ for $y=\\operatorname{arctan}⁡(2{x}^{3}+x).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arctan}⁡(2{x}^{3}+x)] \\\\  & =\\frac{1}{1+{(2{x}^{3}+x)}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2{x}^{3}+x) \\\\  & =\\frac{1}{1+(2{x}^{3}+x)^{2}}\\cdot (6{x}^{2}+1) \\\\  & =\\frac{6{x}^{2}+1}{1+(2{x}^{3}+x)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-343687/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2"] :knowledge-point/questions ["q-343687"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343223/field-1/c1acfa9be632bcbd0167e9a0fa222ad45afd2e20abd5724fc7f65546df759cba" :answer/id #uuid "7b461060-4ffc-5fbf-a22e-090954e6a8b2" :answer/type :answer.type/math :answer/value "\\frac{15x^2}{1+25x^6}" :db/ensure [:answer/validate]} {:db/id "q-343223/field-1" :answer-field/id #uuid "d9ed7643-ed4d-5e46-99a7-3df37c82b25b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343223/field-1/c1acfa9be632bcbd0167e9a0fa222ad45afd2e20abd5724fc7f65546df759cba" :answer-field/choices ["q-343223/field-1/c1acfa9be632bcbd0167e9a0fa222ad45afd2e20abd5724fc7f65546df759cba"] :db/ensure [:answer-field/validate]} {:db/id "q-343223" :question/id #uuid "8dc90ced-2cea-5462-882d-c73f55d8195c" :question/math-academy-id "q-343223" :question/problem "Find ${y}^{′}$ for $y=\\operatorname{arctan}⁡(5{x}^{3}).$\n\n${f}^{′}(x)=$\n{{field-1}}" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arctan}⁡(5{x}^{3})] \\\\  & =\\frac{1}{1+{(5{x}^{3})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(5{x}^{3}) \\\\  & =\\frac{1}{1+25{x}^{6}}\\cdot 15{x}^{2} \\\\  & =\\frac{15{x}^{2}}{1+25{x}^{6}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-343223/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9911dc0d-905d-54e1-aadb-f4fbce6f89d2"] :knowledge-point/questions ["q-343223"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110762/selection/c6e101cf7662395d03a23aa10c627cb0dbc85891c153852984f47f3325e82d37" :answer/id #uuid "2edb6c26-a7ac-515a-9898-9f2c977aeff3" :answer/type :answer.type/math :answer/value "\\frac{6{x}^{2}+3{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-110762/selection/a37e377e806c238f3a8d5621e7d835d6238864f563fee463072a26657fadcbcd" :answer/id #uuid "d02537ab-4e5e-5934-9da5-d915f258cb2a" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}-6{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-110762/selection/015366dfbfa61f030fb717396d9234bcf463a34e438bc6598993343dfbd39d3b" :answer/id #uuid "fcb17cb9-1dc9-5547-8206-67fcaf010514" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}+{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-110762/selection/b5fe8cfa76d2c8de709089daf46d19ed68bc5bbcbdd1fba2fd0fba3e0ba522d0" :answer/id #uuid "68993855-9e0f-5374-8c5c-1dfe7b5bbd42" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-110762/selection/639e40554f4aa3439612a0f9388593645efb2bac07968a7a47adf3681a8ffd54" :answer/id #uuid "31a6d127-4c86-520a-91e0-b79e8c631639" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-110762/selection" :answer-field/id #uuid "64421499-c31b-5404-bb67-f06accba6ef8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110762/selection/639e40554f4aa3439612a0f9388593645efb2bac07968a7a47adf3681a8ffd54" :answer-field/choices ["q-110762/selection/c6e101cf7662395d03a23aa10c627cb0dbc85891c153852984f47f3325e82d37" "q-110762/selection/a37e377e806c238f3a8d5621e7d835d6238864f563fee463072a26657fadcbcd" "q-110762/selection/015366dfbfa61f030fb717396d9234bcf463a34e438bc6598993343dfbd39d3b" "q-110762/selection/b5fe8cfa76d2c8de709089daf46d19ed68bc5bbcbdd1fba2fd0fba3e0ba522d0" "q-110762/selection/639e40554f4aa3439612a0f9388593645efb2bac07968a7a47adf3681a8ffd54"] :db/ensure [:answer-field/validate]} {:db/id "q-110762" :question/id #uuid "fcc0e0ea-aee2-503a-88a5-a3c1170aa40f" :question/math-academy-id "q-110762" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}.$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}) \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡({x}^{3}))-\\operatorname{arctan}⁡({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{6}+1)}{({x}^{6}+1)^{2}} \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{1}{{x}^{6}+1}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\operatorname{arctan}⁡({x}^{3})\\cdot 6{x}^{5}}{({x}^{6}+1)^{2}} \\\\  & =\\frac{\\frac{({x}^{6}+1)(3{x}^{2})}{{x}^{6}+1}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}} \\\\  & =\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110762/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6"] :knowledge-point/questions ["q-110762"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19071/selection/96e5216e02aaeec739b51e0d5c74162572bb84e18743a1c01755e79e3fcdf534" :answer/id #uuid "b942c9e5-19b1-5712-b8ce-439a13efc44d" :answer/type :answer.type/math :answer/value "-\\frac{1}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{2})}{x\\operatorname{ln}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-19071/selection/ec90623b96d47e2b29958bed9490976b8d4fc48316d8ce621b626338381d302e" :answer/id #uuid "2330fc7b-bbae-5929-a302-b42ceb72d630" :answer/type :answer.type/math :answer/value "-\\frac{3{x}^{2}}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{3})}{x{ln}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-19071/selection/9c596bbd639cb9ce0772f3d1260d04bd76bb1c75456be3145c7eadcdccb8a727" :answer/id #uuid "750c290e-27e6-5ac3-ad54-93be5f80dff6" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{3}}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡(1)}{x{ln}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-19071/selection/ac7922b13dbaa5907eef42c9705b42708c4e23ca5cc27adb7864a4687e1f9ebb" :answer/id #uuid "11e70d26-0d15-527b-b51a-e07b65305cfe" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{3})}{x{ln}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-19071/selection/c7eb6096a9cc6ffde0d078fd10c16d87af65b23d6268ba20dd022ca8e9682c30" :answer/id #uuid "e7068ff0-aafa-5e39-96e1-a86a7f6b1c1a" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}+\\frac{\\operatorname{arccos}⁡(3{x}^{2})}{x{ln}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-19071/selection" :answer-field/id #uuid "98f8d937-6a12-5052-af88-faf616fac79e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19071/selection/ec90623b96d47e2b29958bed9490976b8d4fc48316d8ce621b626338381d302e" :answer-field/choices ["q-19071/selection/96e5216e02aaeec739b51e0d5c74162572bb84e18743a1c01755e79e3fcdf534" "q-19071/selection/ec90623b96d47e2b29958bed9490976b8d4fc48316d8ce621b626338381d302e" "q-19071/selection/9c596bbd639cb9ce0772f3d1260d04bd76bb1c75456be3145c7eadcdccb8a727" "q-19071/selection/ac7922b13dbaa5907eef42c9705b42708c4e23ca5cc27adb7864a4687e1f9ebb" "q-19071/selection/c7eb6096a9cc6ffde0d078fd10c16d87af65b23d6268ba20dd022ca8e9682c30"] :db/ensure [:answer-field/validate]} {:db/id "q-19071" :question/id #uuid "36f2cd74-3dbe-552e-ad6d-a2938b875938" :question/math-academy-id "q-19071" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arccos}⁡({x}^{3})}{\\operatorname{ln}⁡x}.$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arccos}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arccos}⁡({x}^{3})}{\\operatorname{ln}⁡x}) & =\\frac{\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡({x}^{3}))-\\operatorname{arccos}⁡({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)}{{ln}^{2}⁡x} \\\\  & =\\frac{\\operatorname{ln}⁡x\\cdot (-\\frac{1}{\\sqrt{1-({x}^{3})^{2}}})\\cdot (3{x}^{2})-\\operatorname{arccos}⁡({x}^{3})\\cdot \\frac{1}{x}}{{ln}^{2}⁡x} \\\\  & =\\frac{(-\\frac{3{x}^{2}\\operatorname{ln}⁡x}{\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{3})}{x})}{{ln}^{2}⁡x} \\\\  & =-\\frac{3{x}^{2}}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{3})}{x{ln}^{2}⁡x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19071/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6"] :knowledge-point/questions ["q-19071"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110777/selection/1e50f153ecd8acb3ba40ba15453e4bbb3b912cbad388a8cc790408c69215046e" :answer/id #uuid "06e425c6-6726-5348-9925-742c37d6dd37" :answer/type :answer.type/math :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "q-110777/selection/72b8500361e4691fd41118f3e33070878f2f67a3921628a592f52dfccab3b821" :answer/id #uuid "3a7ac635-cf39-5709-8c14-bfc7038f08ea" :answer/type :answer.type/math :answer/value "-\\frac{{e}^{x}}{\\sqrt{1-{x}^{2}}}+\\frac{\\operatorname{arccos}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "q-110777/selection/f0de3ca97a1622820b9c1fb63b55c24bde3397d09f670f3f876a025b418a21ef" :answer/id #uuid "36c26d81-2213-5343-84b7-9cac1ab8df67" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}+\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "q-110777/selection/db70f500aa75957b782ca20500b7e6c430cadf2834b72a4b5c0bb29f2d01e198" :answer/id #uuid "19707ed5-933e-50e6-8bac-36ffb6d74de0" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}}{\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "q-110777/selection/b02bcf86ed8ef96755ff2edb7a3564950600331cfc6be37b822c9748dcd4a08a" :answer/id #uuid "7646376a-925b-58ba-8c32-4589ec27fdb2" :answer/type :answer.type/math :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arccos}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "q-110777/selection" :answer-field/id #uuid "43dfdbfa-b49a-5dc5-ad51-8d99686be7e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110777/selection/1e50f153ecd8acb3ba40ba15453e4bbb3b912cbad388a8cc790408c69215046e" :answer-field/choices ["q-110777/selection/1e50f153ecd8acb3ba40ba15453e4bbb3b912cbad388a8cc790408c69215046e" "q-110777/selection/72b8500361e4691fd41118f3e33070878f2f67a3921628a592f52dfccab3b821" "q-110777/selection/f0de3ca97a1622820b9c1fb63b55c24bde3397d09f670f3f876a025b418a21ef" "q-110777/selection/db70f500aa75957b782ca20500b7e6c430cadf2834b72a4b5c0bb29f2d01e198" "q-110777/selection/b02bcf86ed8ef96755ff2edb7a3564950600331cfc6be37b822c9748dcd4a08a"] :db/ensure [:answer-field/validate]} {:db/id "q-110777" :question/id #uuid "ab199b38-800b-5e42-b55a-d55b29af3540" :question/math-academy-id "q-110777" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}.$" :question/worked-solution "Applying the quotient rule and using the formula for the derivative of $\\operatorname{arcsin}⁡x,$  we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}) & =\\frac{{e}^{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)-\\operatorname{arcsin}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x})}{{({e}^{x})}^{2}} \\\\  & =\\frac{{e}^{x}\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-\\operatorname{arcsin}⁡x\\cdot {e}^{x}}{{e}^{2x}} \\\\  & =\\frac{(\\frac{1}{\\sqrt{1-{x}^{2}}}-\\operatorname{arcsin}⁡x)}{{e}^{x}} \\\\  & =\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110777/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6"] :knowledge-point/questions ["q-110777"] :db/ensure [:knowledge-point/validate]} {:db/id "q-314738/field-1/a6251a0c44116458a6508a7446fffbeab8f37101c697fccebcb09c8462925ec7" :answer/id #uuid "c99eab68-10a1-54fd-9fa7-abc123d64e8f" :answer/type :answer.type/math :answer/value "\\frac{2x}{(x^2+5)^2}" :db/ensure [:answer/validate]} {:db/id "q-314738/field-1" :answer-field/id #uuid "5bfaffd5-5812-5f57-9643-0251e30476b2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-314738/field-1/a6251a0c44116458a6508a7446fffbeab8f37101c697fccebcb09c8462925ec7" :answer-field/choices ["q-314738/field-1/a6251a0c44116458a6508a7446fffbeab8f37101c697fccebcb09c8462925ec7"] :db/ensure [:answer-field/validate]} {:db/id "q-314738" :question/id #uuid "24f422e2-3f21-5e44-aa45-bacd5f7d9617" :question/math-academy-id "q-314738" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arctan}⁡(2{x}^{3})}{{x}^{2}+5}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=\\frac{6{x}^{2}}{({x}^{2}+5)(1+4{x}^{6})}\\,-$\n{{field-1}}\n$\\operatorname{arctan}⁡(2{x}^{3})$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x,$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arctan}⁡(2{x}^{3})}{{x}^{2}+5}) \\\\  & =\\frac{(({x}^{2}+5)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(2{x}^{3}))-\\operatorname{arctan}⁡(2{x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}+5))}{({x}^{2}+5)^{2}} \\\\  & =\\frac{(({x}^{2}+5)\\cdot \\frac{1}{1+(2{x}^{3})^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2{x}^{3})-\\operatorname{arctan}⁡(2{x}^{3})\\cdot 2x)}{({x}^{2}+5)^{2}} \\\\  & =\\frac{(\\frac{({x}^{2}+5)(6{x}^{2})}{1+4{x}^{6}}-2x\\operatorname{arctan}⁡(2{x}^{3}))}{({x}^{2}+5)^{2}} \\\\  & =\\frac{6{x}^{2}}{({x}^{2}+5)(1+4{x}^{6})}-\\frac{2x}{({x}^{2}+5)^{2}}\\,\\operatorname{arctan}⁡(2{x}^{3}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-314738/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6"] :knowledge-point/questions ["q-314738"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110769/selection/feb60e2c41a53890ef5ee0126fd3aba632d0ce9d907decd47ac528f4b3929370" :answer/id #uuid "01b4c0e8-d8e2-59b4-90bb-e953f119c048" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{10{x}^{2}(25{x}^{2}+1)}+\\frac{1}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/ensure [:answer/validate]} {:db/id "q-110769/selection/d0f76e085de8c31b54d898398e94779da0202e1977d1479cd81c4fa8629f620b" :answer/id #uuid "c271d04b-3818-5365-ae25-0c42db808ed1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{{x}^{2}(25{x}^{2}+1)}+\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/ensure [:answer/validate]} {:db/id "q-110769/selection/10b8171668ab0c481c804cf905eab8cf285901fc9853b26d343b6d4391561b60" :answer/id #uuid "911f2d06-ea85-5a5b-92c5-b652ebd6c7de" :answer/type :answer.type/math :answer/value "\\frac{25\\operatorname{arctan}⁡(5x)}{{x}^{2}(10{x}^{2}+1)}-\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/ensure [:answer/validate]} {:db/id "q-110769/selection/b54725a487bb7c045c0fe466b171ab1814a1d145f3a8130d5f0f927b9fc7d997" :answer/id #uuid "7afb0a50-4eca-51d4-9375-ccc7eaeea582" :answer/type :answer.type/math :answer/value "\\frac{10\\operatorname{arctan}⁡(5x)}{{x}^{2}(25{x}^{2}+1)}-\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/ensure [:answer/validate]} {:db/id "q-110769/selection/6945d3764f837c484c66c17ca2821b49273e2b85c8e900d64ab608336a8ac50d" :answer/id #uuid "dc8813d3-c93e-5f62-ae32-de754bf70c62" :answer/type :answer.type/math :answer/value "\\frac{10\\operatorname{arctan}⁡(x)}{{x}^{2}(5{x}^{2}+1)}-\\frac{1}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x)" :db/ensure [:answer/validate]} {:db/id "q-110769/selection" :answer-field/id #uuid "81fa075e-4586-58a1-b3c2-294cf5bdd68a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-110769/selection/b54725a487bb7c045c0fe466b171ab1814a1d145f3a8130d5f0f927b9fc7d997" :answer-field/choices ["q-110769/selection/feb60e2c41a53890ef5ee0126fd3aba632d0ce9d907decd47ac528f4b3929370" "q-110769/selection/d0f76e085de8c31b54d898398e94779da0202e1977d1479cd81c4fa8629f620b" "q-110769/selection/10b8171668ab0c481c804cf905eab8cf285901fc9853b26d343b6d4391561b60" "q-110769/selection/b54725a487bb7c045c0fe466b171ab1814a1d145f3a8130d5f0f927b9fc7d997" "q-110769/selection/6945d3764f837c484c66c17ca2821b49273e2b85c8e900d64ab608336a8ac50d"] :db/ensure [:answer-field/validate]} {:db/id "q-110769" :question/id #uuid "3ddbced9-36a4-5d45-b580-8e2051270017" :question/math-academy-id "q-110769" :question/problem "Find ${f}^{′}(x)$ if  $f(x)=\\frac{{arctan}^{2}⁡(5x)}{{x}^{2}}.$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[\\frac{{arctan}^{2}⁡(5x)}{{x}^{2}}] \\\\  & =\\frac{{x}^{2}\\cdot 2\\cdot \\operatorname{arctan}⁡(5x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(5x))-(2x){arctan}^{2}⁡(5x)}{{x}^{4}} \\\\  & =\\frac{2{x}^{2}\\cdot \\operatorname{arctan}⁡(5x)\\cdot \\frac{5}{1+(5x)^{2}}-(2x){arctan}^{2}⁡(5x)}{{x}^{4}} \\\\  & =\\frac{10\\operatorname{arctan}⁡(5x)}{{x}^{2}(25{x}^{2}+1)}-\\frac{2}{{x}^{3}}\\cdot {arctan}^{2}⁡(5x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110769/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6"] :knowledge-point/questions ["q-110769"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-206"] :question/problem "Calculate $f'(x)$ for $f(x) = 5\\arcsin(3x^2).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\textrm{d}}{\\textrm{d}x}(\\arcsin x) = \\dfrac{1}{\\sqrt{1-x^2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{arcsin}⁡(3{x}^{2})) \\\\  & =5\\cdot \\frac{1}{\\sqrt{1-(3{x}^{2})^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\  & =\\frac{5}{\\sqrt{1-9{x}^{4}}}\\cdot (6x) \\\\  & =\\frac{30x}{\\sqrt{1-9{x}^{4}}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-203"] :question/problem "Calculate $\\dfrac{\\textrm{d}y}{\\textrm{d}x},$ if $y = \\arccos (5-8x).$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\textrm{d}}{\\textrm{d}x}(\\arccos x) = -\\dfrac{1}{\\sqrt{1-x^2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡(5-8x)) \\\\  & =-\\frac{1}{\\sqrt{1-(5-8x)^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}(5-8x) \\\\  & =-\\frac{1}{\\sqrt{1-(25-80x+64{x}^{2})}}\\cdot (-8) \\\\  & =\\frac{8}{\\sqrt{80x-24-64{x}^{2}}} \\\\  & =\\frac{8}{\\sqrt{4(20x-6-16{x}^{2})}} \\\\  & =\\frac{8}{2\\sqrt{20x-6-16{x}^{2}}} \\\\  & =\\frac{4}{\\sqrt{20x-6-16{x}^{2}}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-202"] :question/problem "Find the derivative of $y = \\arctan (-7x).$" :question/worked-solution "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\textrm{d}}{\\textrm{d}x}(\\arctan x) = \\dfrac{1}{1+x^2}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡(-7x)) \\\\  & =\\frac{1}{1+(-7x)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(-7x) \\\\  & =\\frac{1}{1+49{x}^{2}}\\cdot (-7) \\\\  & =-\\frac{7}{1+49{x}^{2}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-204"] :question/problem "If $y= x \\arccos x,$ calculate $\\dfrac{\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "Applying the product rule and using the formula for the derivative of $\\arccos x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{arccos}⁡x) & =x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)+\\operatorname{arccos}⁡x\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\cdot (-\\frac{1}{\\sqrt{1-{x}^{2}}})+\\operatorname{arccos}⁡x\\cdot 1 \\\\  & =-\\frac{x}{\\sqrt{1-{x}^{2}}}+\\operatorname{arccos}⁡x.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
