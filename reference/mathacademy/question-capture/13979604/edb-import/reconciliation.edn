4/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-19080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/activity-metadata.json" "file_sha256" "52c1770a3c898baa573c29cfe4eeba2ee7763d760c05ae16c66e9617888bc845"} {"question" "q-19080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-19080" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{2{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+3{e}^{2x}}"] ["math" "\\frac{3{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+{e}^{2x}}"] ["math" "\\frac{6{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+9{e}^{2x}}"] ["math" "\\frac{6{e}^{x}}{1+9{e}^{2x}}"] ["math" "\\frac{\\operatorname{arctan}⁡(3{e}^{x})}{1+9{e}^{2x}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-19080" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{6{e}^{x}\\operatorname{arctan}⁡(3{e}^{x})}{1+9{e}^{2x}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343769" "field" nil "attribute" "question/problem" "value" "Find the exact value of the slope $m$ of the tangent line to the curve $f(x)=3\\operatorname{arctan}⁡({x}^{2}-2x)$ at $x=2.$\n\n$m=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343769" "field" nil "attribute" "question/worked-solution" "value" "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[3\\operatorname{arctan}⁡({x}^{2}-2x)] \\\\  & =3\\cdot \\frac{1}{1+({x}^{2}-2x)^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}-2x) \\\\  & =\\frac{3}{1+{x}^{4}-4{x}^{3}+4{x}^{2}}\\cdot (2x-2) \\\\  & =\\frac{6x-6}{{x}^{4}-4{x}^{3}+4{x}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, the slope $m$ of the tangent line to the curve $y=f(x)$ at $x=2$ is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =\\frac{6(2)-6}{(2)^{4}-4(2)^{3}+4(2)^{2}+1} \\\\  & =6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343769" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/activity-metadata.json" "file_sha256" "52c1770a3c898baa573c29cfe4eeba2ee7763d760c05ae16c66e9617888bc845"} {"question" "q-343769" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343769" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343687" "field" nil "attribute" "question/problem" "value" "Find ${y}^{′}$ for $y=\\operatorname{arctan}⁡(2{x}^{3}+x).$\n\n${f}^{′}(x)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343687" "field" nil "attribute" "question/worked-solution" "value" "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arctan}⁡(2{x}^{3}+x)] \\\\  & =\\frac{1}{1+{(2{x}^{3}+x)}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(2{x}^{3}+x) \\\\  & =\\frac{1}{1+(2{x}^{3}+x)^{2}}\\cdot (6{x}^{2}+1) \\\\  & =\\frac{6{x}^{2}+1}{1+(2{x}^{3}+x)^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343687" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/activity-metadata.json" "file_sha256" "52c1770a3c898baa573c29cfe4eeba2ee7763d760c05ae16c66e9617888bc845"} {"question" "q-343687" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343687" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{6x^2+1}{1+(2x^3+x)^2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343223" "field" nil "attribute" "question/problem" "value" "Find ${y}^{′}$ for $y=\\operatorname{arctan}⁡(5{x}^{3}).$\n\n${f}^{′}(x)=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343223" "field" nil "attribute" "question/worked-solution" "value" "The formula for the derivative of arctangent is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡x)=\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}}{\\text{d}x}[\\operatorname{arctan}⁡(5{x}^{3})] \\\\  & =\\frac{1}{1+{(5{x}^{3})}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}x}(5{x}^{3}) \\\\  & =\\frac{1}{1+25{x}^{6}}\\cdot 15{x}^{2} \\\\  & =\\frac{15{x}^{2}}{1+25{x}^{6}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343223" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/activity-metadata.json" "file_sha256" "52c1770a3c898baa573c29cfe4eeba2ee7763d760c05ae16c66e9617888bc845"} {"question" "q-343223" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-343223" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{15x^2}{1+25x^6}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-110762" "field" nil "attribute" "question/problem" "value" "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-110762" "field" nil "attribute" "question/worked-solution" "value" "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}) \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡({x}^{3}))-\\operatorname{arctan}⁡({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{6}+1)}{({x}^{6}+1)^{2}} \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{1}{{x}^{6}+1}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\operatorname{arctan}⁡({x}^{3})\\cdot 6{x}^{5}}{({x}^{6}+1)^{2}} \\\\  & =\\frac{\\frac{({x}^{6}+1)(3{x}^{2})}{{x}^{6}+1}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}} \\\\  & =\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-110762" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/activity-metadata.json" "file_sha256" "52c1770a3c898baa573c29cfe4eeba2ee7763d760c05ae16c66e9617888bc845"} {"question" "q-110762" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-110762" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{3{x}^{2}+{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}"] ["math" "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}"] ["math" "\\frac{6{x}^{2}+3{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}"] ["math" "\\frac{{x}^{2}-6{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}"] ["math" "\\frac{{x}^{3}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-110762" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-19071" "field" nil "attribute" "question/problem" "value" "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arccos}⁡({x}^{3})}{\\operatorname{ln}⁡x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-19071" "field" nil "attribute" "question/worked-solution" "value" "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arccos}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arccos}⁡({x}^{3})}{\\operatorname{ln}⁡x}) & =\\frac{\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡({x}^{3}))-\\operatorname{arccos}⁡({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)}{{ln}^{2}⁡x} \\\\  & =\\frac{\\operatorname{ln}⁡x\\cdot (-\\frac{1}{\\sqrt{1-({x}^{3})^{2}}})\\cdot (3{x}^{2})-\\operatorname{arccos}⁡({x}^{3})\\cdot \\frac{1}{x}}{{ln}^{2}⁡x} \\\\  & =\\frac{(-\\frac{3{x}^{2}\\operatorname{ln}⁡x}{\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{3})}{x})}{{ln}^{2}⁡x} \\\\  & =-\\frac{3{x}^{2}}{\\operatorname{ln}⁡x\\sqrt{1-{x}^{6}}}-\\frac{\\operatorname{arccos}⁡({x}^{3})}{x{ln}^{2}⁡x}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd7244582ea065c395e55ff1af75feeb456"} {"question" "q-19071" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/activity-metadata.json" "file_sha256" "52c1770a3c898baa573c29cfe4eeba2ee7763d760c05ae16c66e9617888bc845"} {"question" "q-19071" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979604/state.json" "file_sha256" "a6bd91f604dd8c45e5915e1268896cd724458