#{[{:db/id #edb/ref 17592186296769 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e5800ff-0e56-5853-9db9-e1263dd895c2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,\\sqrt{2},32⟩" :db/id #edb/ref 17592186296771} {:answer/id #uuid "593b4d99-0341-58bb-8e0a-6f4c9429f60b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\sqrt{2},32⟩" :db/id #edb/ref 17592186296772} {:answer/id #uuid "d47e0755-e12b-5895-9265-2b4355304408" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,2,8⟩" :db/id #edb/ref 17592186296773} {:answer/id #uuid "6f59d26c-1904-51f2-accf-fec61142cf16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,32⟩" :db/id #edb/ref 17592186296774} {:answer/id #uuid "38d022ab-c4d5-5c31-a733-f6c1bbd4731d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,2,16⟩" :db/id #edb/ref 17592186296775}] :answer-field/correct {:answer/id #uuid "6f59d26c-1904-51f2-accf-fec61142cf16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,32⟩" :db/id #edb/ref 17592186296774} :answer-field/id #uuid "1492c643-722f-5547-8cd0-3f1399a2da31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296770}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "093b9e33-3bd8-5d4d-a8c1-8097498b50b9" :question/math-academy-id "q-161511" :question/problem "What is the value of $f(t)=⟨\\operatorname{ln}⁡({t}^{2}-3),\\,\\sqrt{2t},\\,{t}^{5}⟩$ at $t=2?$" :question/worked-solution "To evaluate, we substitute $t=2$ into the function, as follows:\n\n$$\n\\begin{aligned}f(2) & =⟨\\operatorname{ln}⁡({2}^{2}-3),\\sqrt{2(2)},{2}^{5}⟩ \\\\  & =⟨\\operatorname{ln}⁡(1),\\sqrt{4},{2}^{5}⟩ \\\\  & =⟨0,2,32⟩\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=2$ is the vector $⟨0,2,32⟩.$"}]}
