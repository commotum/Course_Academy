#{[{:db/id #edb/ref 17592186305845 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "621a3006-4293-5eb5-8d1d-3b223aa9e3aa" :answer/type {:db/ident :answer.type/math} :answer/value "-i-j-k" :db/id #edb/ref 17592186305847} {:answer/id #uuid "093e290a-4f00-5940-9b79-6f0362d4864e" :answer/type {:db/ident :answer.type/math} :answer/value "i+j+k" :db/id #edb/ref 17592186305848} {:answer/id #uuid "5971a9de-801b-5f69-86ef-f50558211cb1" :answer/type {:db/ident :answer.type/math} :answer/value "i+j-k" :db/id #edb/ref 17592186305849} {:answer/id #uuid "48fdbf15-4991-5246-9b7b-08ee8d066fe2" :answer/type {:db/ident :answer.type/math} :answer/value "i-j+k" :db/id #edb/ref 17592186305850} {:answer/id #uuid "2684fdfc-3fa0-5cfa-947a-36ec35c3a18b" :answer/type {:db/ident :answer.type/math} :answer/value "-i-j+k" :db/id #edb/ref 17592186305851}] :answer-field/correct {:answer/id #uuid "5971a9de-801b-5f69-86ef-f50558211cb1" :answer/type {:db/ident :answer.type/math} :answer/value "i+j-k" :db/id #edb/ref 17592186305849} :answer-field/id #uuid "2f9bd623-c233-52bd-ad8c-954448a4b583" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305846}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f2833ab6-0677-5bf5-af9f-0c2e9b6cd957" :question/math-academy-id "q-160769" :question/problem "What is the value of \n $f(s)=\\operatorname{tan}⁡s\\,i+\\operatorname{cot}⁡s\\,j-\\,k$ at $s=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute at $s=\\frac{\\pi }{4}$  into the function, as follows:\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{4}) & =\\operatorname{tan}⁡(\\frac{\\pi }{4})\\,i+\\operatorname{cot}⁡(\\frac{\\pi }{4})\\,j-k \\\\  & =1\\,i+1\\,j-k \\\\  & =i+j-k\\end{aligned}\n$$\n\nSo, the value of  $f(s)$ at $s=\\frac{\\pi }{4}$  is $i+j-k.$"}] [{:db/id #edb/ref 17592186305852 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ce6e9be-7208-5343-92e6-a95afdd7990e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186305854} {:answer/id #uuid "9cb5d7e7-704f-56bb-8714-cb0821775e91" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 0 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186305855} {:answer/id #uuid "4aeea922-52e6-57a5-8f98-a81aff8cf4fb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186305856} {:answer/id #uuid "acea7e88-d8a4-5bca-855a-605cd77f3b02" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186305857} {:answer/id #uuid "4468df2c-df9b-51a5-bcbf-0e73d470d544" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186305858}] :answer-field/correct {:answer/id #uuid "4468df2c-df9b-51a5-bcbf-0e73d470d544" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186305858} :answer-field/id #uuid "18da20a7-cf72-5407-90ed-092b7c06752b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305853}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3927b17d-f85e-519c-a173-5cde6f6bc902" :question/math-academy-id "q-160788" :question/problem "What is the value of $f(t)=[\\begin{aligned}\\frac{1}{t+1} \\\\ 1-{t}^{2} \\\\ \\operatorname{tan}⁡t\\end{aligned}]$ at $t=0?$" :question/worked-solution "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =[\\begin{aligned}\\frac{1}{(0)+1} \\\\ 1-(0)^{2} \\\\ \\operatorname{tan}⁡(0)\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{1} \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=0$ is $[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$"}] [{:db/id #edb/ref 17592186296769 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e5800ff-0e56-5853-9db9-e1263dd895c2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,\\sqrt{2},32⟩" :db/id #edb/ref 17592186296771} {:answer/id #uuid "593b4d99-0341-58bb-8e0a-6f4c9429f60b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\sqrt{2},32⟩" :db/id #edb/ref 17592186296772} {:answer/id #uuid "d47e0755-e12b-5895-9265-2b4355304408" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,2,8⟩" :db/id #edb/ref 17592186296773} {:answer/id #uuid "6f59d26c-1904-51f2-accf-fec61142cf16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,32⟩" :db/id #edb/ref 17592186296774} {:answer/id #uuid "38d022ab-c4d5-5c31-a733-f6c1bbd4731d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,2,16⟩" :db/id #edb/ref 17592186296775}] :answer-field/correct {:answer/id #uuid "6f59d26c-1904-51f2-accf-fec61142cf16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,32⟩" :db/id #edb/ref 17592186296774} :answer-field/id #uuid "1492c643-722f-5547-8cd0-3f1399a2da31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296770}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "093b9e33-3bd8-5d4d-a8c1-8097498b50b9" :question/math-academy-id "q-161511" :question/problem "What is the value of $f(t)=⟨\\operatorname{ln}⁡({t}^{2}-3),\\,\\sqrt{2t},\\,{t}^{5}⟩$ at $t=2?$" :question/worked-solution "To evaluate, we substitute $t=2$ into the function, as follows:\n\n$$\n\\begin{aligned}f(2) & =⟨\\operatorname{ln}⁡({2}^{2}-3),\\sqrt{2(2)},{2}^{5}⟩ \\\\  & =⟨\\operatorname{ln}⁡(1),\\sqrt{4},{2}^{5}⟩ \\\\  & =⟨0,2,32⟩\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=2$ is the vector $⟨0,2,32⟩.$"}] [{:db/id #edb/ref 17592186305859 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "780f5388-cde1-5511-bcf5-517e1e41b178" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186305861} {:answer/id #uuid "7a8571cc-5b06-5fa1-a829-0e6af1611490" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186305862}] :answer-field/correct {:answer/id #uuid "780f5388-cde1-5511-bcf5-517e1e41b178" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186305861} :answer-field/id #uuid "abec40a6-3173-5277-8fe7-ff68dc446a75" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305860}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3166e6cc-1fec-5041-af39-f8931c1bf155" :question/math-academy-id "q-348674" :question/problem "Given that $r(t)=⟨{2}^{t-1},\\,\\frac{4}{t+1}⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨{2}^{0},\\,\\frac{4}{2}⟩ \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{1}^{2}+{2}^{2}} \\\\  & =\\sqrt{5} \\\\  & =\\sqrt{5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186305863 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72e40fdd-b949-585e-87a6-c42741634638" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186305865}] :answer-field/correct {:answer/id #uuid "72e40fdd-b949-585e-87a6-c42741634638" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186305865} :answer-field/id #uuid "51694d70-03c0-5e3f-a9f4-c89722cc078b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186305864}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b1a255b2-db2c-537a-aa22-3b4e70e3f863" :question/math-academy-id "q-348691" :question/problem "Given that $r(t)=⟨\\sqrt{t+3},\\,3\\,{e}^{t-1}⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨\\sqrt{1+3},\\,3\\,{e}^{1-1}⟩ \\\\  & =⟨\\sqrt{4},\\,3\\,{e}^{0}⟩ \\\\  & =⟨2,\\,3⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{2}^{2}+{3}^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}\\end{aligned}\n$$"}]}
