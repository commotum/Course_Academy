#{[{:topic/id #uuid "3faedd4b-6445-5693-abb6-4c7947c1914f" :topic/knowledge-points [{:knowledge-point/canonical-example {:db/id #edb/ref 17592186184001 :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/is-example true :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1$." :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\n\\intx^{2} + 1dx &= \\intx^{2}dx + \\int1dx \\\\\n&= \\intx^{2}dx + \\intx^{0}dx \\\\\n&= (\\frac{x^{2 + 1}}{2 + 1}) + x + C \\\\\n&= \\frac{1}{3}x^{3} + x + C\n\\end{aligned}\n$$"} :knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049465}] :knowledge-point/questions [{:db/id #edb/ref 17592186184490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "874a75be-05b5-5213-a317-ac84d079a6f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{x^{3}}}{3} - 3x + C" :db/id #edb/ref 17592186181381} {:answer/id #uuid "b4254b4e-b369-5812-943b-4e67411913f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt[3]{x^{2}}}{2} - 3x" :db/id #edb/ref 17592186181382} {:answer/id #uuid "b8145e65-a4e6-55ed-84fd-bcbca085060c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x\\sqrt{x^{3}}}{2} - 3x + C" :db/id #edb/ref 17592186181383} {:answer/id #uuid "1f4f8890-7502-5e8c-90d6-f4aba9048241" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2x\\sqrt[3]{x}}{3} + 3 + C" :db/id #edb/ref 17592186181384} {:answer/id #uuid "461e199a-4bf9-5631-92ee-54bbc39d5458" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{3}}}{3} - 3x + C" :db/id #edb/ref 17592186181385}] :answer-field/correct {:answer/id #uuid "461e199a-4bf9-5631-92ee-54bbc39d5458" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{3}}}{3} - 3x + C" :db/id #edb/ref 17592186181385} :ans