n "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (1+{x}^{2}{)}^{2}\\,\\text{d}x & =\\int (1+2{x}^{2}+{x}^{4})\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x+2\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =(\\frac{{x}^{5}}{5})+2(\\frac{{x}^{3}}{3})+(x)+C \\\\  & =\\frac{{x}^{5}}{5}+\\frac{2{x}^{3}}{3}+x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49062/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de"] :knowledge-point/questions ["q-49062"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113845/selection/a9bc378152ffcd14b66d6bcded91f061426b2bf67c2546eb1c724df6f0098d91" :answer/id #uuid "99563f6b-28fa-55d4-9c16-08470e631509" :answer/type :answer.type/math :answer/value "\\frac{{x}^{5}}{5}-\\frac{{x}^{6}}{2}+\\frac{5\\sqrt[5]{{x}^{11}}}{11}+C" :db/ensure [:answer/validate]} {:db/id "q-113845/selection/9a376b3573f169895755d32e478704e563c5a6f096923c442a24e7bfc935317e" :answer/id #uuid "f91b1ca7-fccd-54dc-a56f-03f0870e26e5" :answer/type :answer.type/math :answer/value "\\frac{{x}^{5}}{5}+\\frac{{x}^{6}}{6}+\\frac{6\\sqrt[5]{{x}^{11}}}{5}+C" :db/ensure [:answer/validate]} {:db/id "q-113845/selection/6aed8901ad8ad1044fc6667ba9899113a55a64e1a5a12aa8eb704866dc765a5e" :answer/id #uuid "1cd6dc11-f347-5da5-b892-d79834aed6b9" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{3}-\\frac{{x}^{4}}{2}+\\frac{5\\sqrt[4]{{x}^{11}}}{11}+C" :db/ensure [:answer/validate]} {:db/id "q-113845/selection/678434f096a3ecb2d5175c315f8006274a79b1f1543f16d4dfc642692ba07550" :answer/id #uuid "ee3036a6-7b52-5f9c-ab2d-6ea382679ee9" :answer/type :answer.type/math :answer/value "3{x}^{3}-4{x}^{4}+\\frac{5\\sqrt[6]{{x}^{5}}}{6}+C" :db/ensure [:answer/validate]} {:db/id "q-113845/selection/2cdc7eabd0d3a9ec564cb32a68d212873e7dbd62461c3878b887a833acdb5f4d" :answer/id #uuid "30019e39-5e82-503c-80d2-27e089c7444f" :answer/type :answer.type/math :answer/value "{x}^{5}-{x}^{6}+\\sqrt[6]{{x}^{5}}+C" :db/ensure [:answer/validate]} {:db/id "q-113845/selection" :answer-field/id #uuid "85bc1f7e-2b2f-5c1c-9a50-8ef4b034c884" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113845/selection/a9bc378152ffcd14b66d6bcded91f061426b2bf67c2546eb1c724df6f0098d91" :answer-field/choices ["q-113845/selection/a9bc378152ffcd14b66d6bcded91f061426b2bf67c2546eb1c724df6f0098d91" "q-113845/selection/9a376b3573f169895755d32e478704e563c5a6f096923c442a24e7bfc935317e" "q-113845/selection/6aed8901ad8ad1044fc6667ba9899113a55a64e1a5a12aa8eb704866dc765a5e" "q-113845/selection/678434f096a3ecb2d5175c315f8006274a79b1f1543f16d4dfc642692ba07550" "q-113845/selection/2cdc7eabd0d3a9ec564cb32a68d212873e7dbd62461c3878b887a833acdb5f4d"] :db/ensure [:answer-field/validate]} {:db/id "q-113845" :question/id #uuid "3a0a422f-d6c6-5151-9890-b1b6ff8dc299" :question/math-academy-id "q-113845" :question/is-example false :question/problem "Find the antiderivative of \n${x}^{4}-3{x}^{5}+\\sqrt[5]{{x}^{6}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int ({x}^{4}-3{x}^{5}+\\sqrt[5]{{x}^{6}})\\,\\text{d}x & =\\int {x}^{4}\\,\\text{d}x-3\\int {x}^{5}\\,\\text{d}x+\\int {x}^{6/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}-3\\cdot (\\frac{{x}^{5+1}}{5+1})+\\frac{{x}^{6/5+1}}{(\\frac{6}{5}+1)}+C \\\\  & =\\frac{{x}^{5}}{5}-3\\cdot (\\frac{{x}^{6}}{6})+\\frac{{x}^{11/5}}{(\\frac{11}{5})}+C \\\\  & =\\frac{{x}^{5}}{5}-\\frac{{x}^{6}}{2}+\\frac{5\\sqrt[5]{{x}^{11}}}{11}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113845/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de"] :knowledge-point/questions ["q-113845"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113851/selection/d135b6b8a5aa5e6602d6396ff6817f3585dbf4c39c4f5ca6020a97d0cf47e142" :answer/id #uuid "281e8174-92ee-538c-923c-1aa74a92215d" :answer/type :answer.type/math :answer/value "\\frac{{x}^{6}}{3}-2\\sqrt{x}+\\frac{3\\sqrt[3]{{x}^{4}}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113851/selection/2da0d7dd79be000f961244e2ece21e573284042def4182494ade9f3b0e01ef6d" :answer/id #uuid "1c7555ee-24a7-5de9-b738-53cb3ec7b544" :answer/type :answer.type/math :answer/value "{x}^{6}-\\sqrt{x}+\\sqrt[4]{{x}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-113851/selection/1ac8fe3e8df790357624980367caa94897130151d071bc839653a8e0718763d2" :answer/id #uuid "f3837c73-5aa6-544e-9fac-2a8a51f39b05" :answer/type :answer.type/math :answer/value "\\frac{{x}^{6}}{6}-2\\sqrt{{x}^{3}}+\\frac{3\\sqrt[3]{{x}^{5}}}{2}+C" :db/ensure [:answer/validate]} {:db/id "q-113851/selection/b348c82b8ca7cff9acc698cefbe3247347d9413c3f301a7cf8f9422612fd8610" :answer/id #uuid "72cb4dfe-322a-5a0a-a3cd-5a8886d4a252" :answer/type :answer.type/math :answer/value "\\frac{{x}^{4}}{6}-4\\sqrt{x}+\\frac{2\\sqrt[4]{{x}^{3}}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-113851/selection/9f4d6d65ab73c91da2b7318f508b58d0cc4787c0a41713eaee4a833476abccd3" :answer/id #uuid "1e80489f-4b49-5055-a7d4-f0d38c48bc40" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{6}}+\\frac{\\sqrt{x}}{2}+\\frac{\\sqrt[3]{{x}^{4}}}{8}+C" :db/ensure [:answer/validate]} {:db/id "q-113851/selection" :answer-field/id #uuid "10bf1393-340e-5baf-a6bc-de3e7a93fef1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113851/selection/d135b6b8a5aa5e6602d6396ff6817f3585dbf4c39c4f5ca6020a97d0cf47e142" :answer-field/choices ["q-113851/selection/d135b6b8a5aa5e6602d6396ff6817f3585dbf4c39c4f5ca6020a97d0cf47e142" "q-113851/selection/2da0d7dd79be000f961244e2ece21e573284042def4182494ade9f3b0e01ef6d" "q-113851/selection/1ac8fe3e8df790357624980367caa94897130151d071bc839653a8e0718763d2" "q-113851/selection/b348c82b8ca7cff9acc698cefbe3247347d9413c3f301a7cf8f9422612fd8610" "q-113851/selection/9f4d6d65ab73c91da2b7318f508b58d0cc4787c0a41713eaee4a833476abccd3"] :db/ensure [:answer-field/validate]} {:db/id "q-113851" :question/id #uuid "4adc85a8-8014-5b87-87d9-40c2bf73d0ef" :question/math-academy-id "q-113851" :question/is-example false :question/problem "Calculate \n$\\int (2{x}^{5}-\\frac{1}{\\sqrt{x}}+2\\sqrt[3]{x})\\,\\text{d}x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (2{x}^{5}-\\frac{1}{\\sqrt{x}}+2\\sqrt[3]{x})\\,\\text{d}x & =2\\int {x}^{5}\\,\\text{d}x-\\int {x}^{-1/2}\\,\\text{d}x+2\\int {x}^{1/3}\\,\\text{d}x \\\\  & =2\\cdot (\\frac{{x}^{5+1}}{5+1})-\\frac{{x}^{-1/2+1}}{(-\\frac{1}{2}+1)}+2\\cdot \\frac{{x}^{1/3+1}}{(\\frac{1}{3}+1)}+C \\\\  & =2\\cdot (\\frac{{x}^{6}}{6})-\\frac{{x}^{1/2}}{(\\frac{1}{2})}+2\\cdot \\frac{{x}^{4/3}}{(\\frac{4}{3})}+C \\\\  & =\\frac{{x}^{6}}{3}-2\\sqrt{x}+\\frac{3\\sqrt[3]{{x}^{4}}}{2}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-113851/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de"] :knowledge-point/questions ["q-113851"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-2250"] :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({x}^{2}-\\sqrt{x}+2)\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x-\\int {x}^{1/2}\\,\\text{d}x+\\int 2\\,\\text{d}x \\\\  & =(\\frac{{x}^{3}}{3})-(\\frac{2{x}^{3/2}}{3})+(2x)+C \\\\  & =\\frac{{x}^{3}-2{x}^{3/2}}{3}+2x+C \\\\  & =\\frac{{x}^{3}-2\\sqrt{{x}^{3}}+6x}{3}+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]}]
