integrals of each function:\n\n$$\n\\begin{aligned}\\int 4-\\frac{1}{{y}^{5/2}}\\,\\text{d}y & =4\\int 1\\,\\text{d}y-\\int {y}^{-5/2}\\,\\text{d}y \\\\  & =4\\int {y}^{0}\\,\\text{d}y-\\int {y}^{-5/2}\\,\\text{d}y \\\\  & =4(\\frac{{y}^{0+1}}{0+1})-(\\frac{{y}^{-5/2+1}}{-\\frac{5}{2}+1})+C \\\\  & =4y-(\\frac{{y}^{-3/2}}{-\\frac{3}{2}})+C \\\\  & =4y+\\frac{2}{3{y}^{3/2}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113779/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398"] :knowledge-point/questions ["q-113779"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71172/selection/2cd080c9aa50fca796f0272fdf58ce50cf82e800fb84d8cff46bb8d450cda1f7" :answer/id #uuid "a59a7f75-5b15-535d-be35-c670526fb218" :answer/type :answer.type/math :answer/value "z+\\frac{5{z}^{5/3}}{8}+C" :db/ensure [:answer/validate]} {:db/id "q-71172/selection/585aa8f9d3f1c00b790a6dfc63639b60cedc27fc87e8d8aad5e868c76199200b" :answer/id #uuid "5b0dbd27-98a1-5006-8f9f-ac9ced4f9e2d" :answer/type :answer.type/math :answer/value "2z-\\frac{{z}^{5/3}}{5}+C" :db/ensure [:answer/validate]} {:db/id "q-71172/selection/cd81df84d34725032bb81914bfd2208f6b39921e40dd2e9d173edecf22d43404" :answer/id #uuid "aecd6d93-087e-5534-b84d-b1519f7ee92a" :answer/type :answer.type/math :answer/value "-z+\\frac{{z}^{5/3}}{3}+C" :db/ensure [:answer/validate]} {:db/id "q-71172/selection/2a844e279a80627db8075e80fa961ba037d03c8a6c4a40d307b9cd3300183307" :answer/id #uuid "93e4620c-aa62-52c8-9fcc-af3ac3e35caf" :answer/type :answer.type/math :answer/value "z-2{z}^{3}+C" :db/ensure [:answer/validate]} {:db/id "q-71172/selection/2567a7cb964156f50f00fda73ceb44d8bdec06e7d7f8ba4accaa649b1e3a115f" :answer/id #uuid "692976ef-8470-5b2d-9e6d-6b9ac0c28ffb" :answer/type :answer.type/math :answer/value "z-\\frac{3{z}^{5/3}}{5}+C" :db/ensure [:answer/validate]} {:db/id "q-71172/selection" :answer-field/id #uuid "c6cccb50-79b9