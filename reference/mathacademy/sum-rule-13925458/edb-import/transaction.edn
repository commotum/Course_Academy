54" "q-71168/selection/d69ddd14e05158dfd3b3a18911d3cebbbf7f8b580344cce39bbc21c9230b6f78"] :db/ensure [:answer-field/validate]} {:db/id "q-71168" :question/id #uuid "03b2c391-d105-537e-ac77-82e5faccec7f" :question/math-academy-id "q-71168" :question/is-example false :question/problem "Find the antiderivative of $\\sqrt[3]{{x}^{5}}+{x}^{2}.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\sqrt[3]{{x}^{5}}+{x}^{2}\\,\\text{d}x & =\\int {x}^{5/3}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{5/3+1}}{(\\frac{5}{3}+1)}+\\frac{{x}^{2+1}}{2+1}+C \\\\  & =\\frac{3}{8}\\cdot {x}^{8/3}+\\frac{{x}^{3}}{3}+C \\\\  & =\\frac{3\\sqrt[3]{{x}^{8}}}{8}+\\frac{{x}^{3}}{3}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398"] :knowledge-point/questions ["q-71168"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-29828"] :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\sqrt{{x}^{5}}+\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & =\\int {x}^{5/2}\\,\\text{d}x+\\int {x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{5/2+1}}{(\\frac{5}{2}+1)}+\\frac{{x}^{-5/2+1}}{(\\frac{-5}{2}+1)}+C \\\\  & =\\frac{2}{7}\\cdot {x}^{7/2}-\\frac{2}{3}{x}^{-3/2}+C \\\\  & =\\frac{2\\sqrt{{x}^{7}}}{7}-\\frac{2}{3\\sqrt{{x}^{3}}}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-113779/selection/9b0c16bbc7601a89574452483aab3497da5db25ea5b7fe3767c5a6b1e9ed5f17" :answer/id #uuid "5c07c000-e013-58f8-8f6f-eceaa99959b5" :answer/type :answer.type/math :answer/value "\\frac{y}{4}+\\frac{1}{6{y}^{3/2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113779/selection/b8883f8221023128695f93a903