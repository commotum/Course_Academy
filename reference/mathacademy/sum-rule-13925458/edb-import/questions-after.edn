#{[{:db/id #edb/ref 17592186184001 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/is-example true :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1$." :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\n\\intx^{2} + 1dx &= \\intx^{2}dx + \\int1dx \\\\\n&= \\intx^{2}dx + \\intx^{0}dx \\\\\n&= (\\frac{x^{2 + 1}}{2 + 1}) + x + C \\\\\n&= \\frac{1}{3}x^{3} + x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184002 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/is-example true :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int2x^{3} - xdx &= 2\\intx^{3}dx - \\intxdx \\\\\n&= 2(\\frac{x^{3 + 1}}{3 + 1}) - (\\frac{x^{1 + 1}}{1 + 1}) + C \\\\\n&= 2(\\frac{x^{4}}{4}) - (\\frac{x^{2}}{2}) + C \\\\\n&= \\frac{x^{4}}{2} - \\frac{x^{2}}{2} + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184003 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/is-example true :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left(5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int(5(\\sqrt{x})^{3} - 4x^{2} + 5)dx &= \\int(5x^{3/2} - 4x^{2} + 5)dx \\\\\n&= 5\\intx^{3/2}dx - 4\\intx^{2}dx + 5\\int1dx \\\\\n&= 5(\\frac{x^{5/2}}{\\frac{5}{2}}) - 4(\\frac{x^{3}}{3}) + 5(x) + C \\\\\n&= 5 \\cdot \\frac{2}{5}x^{5/2} - \\frac{4}{3}x^{3} + 5x + C \\\\\n&= 2\\sqrt{x^{5}} - \\frac{4}{3}x^{3} + 5x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248503 :knowledge-point/_questions [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4418d535-980c-5653-9dee-5dd3d9b2d26c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-2x+C" :db/id #edb/ref 17592186248505} {:answer/id #uuid "baea962a-2335-53fe-9a93-0b0c3fe41179" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{3}-2x+C" :db/id #edb/ref 17592186248506} {:answer/id #uuid "2717ce05-92c7-5f37-9b8a-694e0c8a84d2" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}-{x}^{2}+C" :db/id #edb/ref 17592186248507} {:answer/id #uuid "26e50a4c-df0d-550b-88d1-b5093396f770" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-{x}^{2}+C" :db/id #edb/ref 17592186248508} {:answer/id #uuid "994a8006-002c-5976-a670-bdb41be2230f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}-2x+C" :db/id #edb/ref 17592186248509}] :answer-field/correct {:answer/id #uuid "4418d535-980c-5653-9dee-5dd3d9b2d26c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-2x+C" :db/id #edb/ref 17592186248505} :answer-field/id #uuid "c8f3c884-38aa-5f54-ba1b-15a745789cc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248504}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7d3c3ec1-35b7-5747-a8b2-822605b7eff3" :question/is-example false :question/math-academy-id "q-113778" :question/problem "$\\int {x}^{4}-2\\,\\text{d}x=$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int {x}^{4}-2\\,\\text{d}x & =\\int {x}^{4}\\,\\text{d}x-2\\int 1\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x-2\\int {x}^{0}\\,\\text{d}x \\\\  & =(\\frac{{x}^{4+1}}{4+1})-2(\\frac{{x}^{0+1}}{0+1})+C \\\\  & =\\frac{{x}^{5}}{5}-2x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248510 :knowledge-point/_questions [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4278dbb5-caa5-5579-bc29-cee5de0d7b83" :answer/type {:db/ident :answer.type/math} :answer/value "4y+\\frac{2}{3{y}^{3/2}}+C" :db/id #edb/ref 17592186248512} {:answer/id #uuid "5c07c000-e013-58f8-8f6f-eceaa99959b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{y}{4}+\\frac{1}{6{y}^{3/2}}+C" :db/id #edb/ref 17592186248513} {:answer/id #uuid "2c8d01fd-845e-551e-8393-2124e105238f" :answer/type {:db/ident :answer.type/math} :answer/value "4y-\\frac{6}{{y}^{3/2}}+C" :db/id #edb/ref 17592186248514} {:answer/id #uuid "27f81130-cb81-55c9-a025-7694a8c1e5f8" :answer/type {:db/ident :answer.type/math} :answer/value "4y-\\frac{1}{2{y}^{1/2}}+C" :db/id #edb/ref 17592186248515} {:answer/id #uuid "2189467e-c7f8-5792-b736-3ba36a0fcd69" :answer/type {:db/ident :answer.type/math} :answer/value "4y+2{y}^{1/2}+C" :db/id #edb/ref 17592186248516}] :answer-field/correct {:answer/id #uuid "4278dbb5-caa5-5579-bc29-cee5de0d7b83" :answer/type {:db/ident :answer.type/math} :answer/value "4y+\\frac{2}{3{y}^{3/2}}+C" :db/id #edb/ref 17592186248512} :answer-field/id #uuid "97d6ec3f-d59b-5605-8661-a183aadf8380" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248511}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ebbef4d-a68e-5adb-a854-7f4274fe2f2c" :question/is-example false :question/math-academy-id "q-113779" :question/problem "$\\int 4-\\frac{1}{{y}^{5/2}}\\,\\text{d}y=$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int 4-\\frac{1}{{y}^{5/2}}\\,\\text{d}y & =4\\int 1\\,\\text{d}y-\\int {y}^{-5/2}\\,\\text{d}y \\\\  & =4\\int {y}^{0}\\,\\text{d}y-\\int {y}^{-5/2}\\,\\text{d}y \\\\  & =4(\\frac{{y}^{0+1}}{0+1})-(\\frac{{y}^{-5/2+1}}{-\\frac{5}{2}+1})+C \\\\  & =4y-(\\frac{{y}^{-3/2}}{-\\frac{3}{2}})+C \\\\  & =4y+\\frac{2}{3{y}^{3/2}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248517 :knowledge-point/_questions [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8adb30ae-b5b7-57bf-abe7-02db7f4c86ad" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{5}+\\frac{{x}^{4}}{3}+C" :db/id #edb/ref 17592186248519} {:answer/id #uuid "9cc4b500-d313-57aa-8e35-4e5ad5c86600" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{5{x}^{5}}+\\frac{3}{4{x}^{4}}+C" :db/id #edb/ref 17592186248520} {:answer/id #uuid "2df4b16d-1b52-5e45-8501-4ad3a5927a2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{5}}{5}-\\frac{3{x}^{4}}{4}+C" :db/id #edb/ref 17592186248521} {:answer/id #uuid "ef95029f-368d-5dd8-a1fa-046035f018b2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-3{x}^{4}+C" :db/id #edb/ref 17592186248522} {:answer/id #uuid "f586e167-cbed-55bd-a926-8d793f6f96ed" :answer/type {:db/ident :answer.type/math} :answer/value "6{x}^{5}-3{x}^{4}+C" :db/id #edb/ref 17592186248523}] :answer-field/correct {:answer/id #uuid "2df4b16d-1b52-5e45-8501-4ad3a5927a2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6{x}^{5}}{5}-\\frac{3{x}^{4}}{4}+C" :db/id #edb/ref 17592186248521} :answer-field/id #uuid "9577e82a-9124-53ee-8d17-34ebc27e9e97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248518}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "1f13d463-60a3-5078-9c43-857ca4b47558" :question/is-example false :question/math-academy-id "q-113784" :question/problem "$\\int 6{x}^{4}-3{x}^{3}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 6{x}^{4}-3{x}^{3}\\,\\text{d}x & =\\int 6{x}^{4}\\,\\text{d}x-\\int 3{x}^{3}\\,\\text{d}x \\\\  & =6\\int {x}^{4}\\,\\text{d}x-3\\int {x}^{3}\\,\\text{d}x \\\\  & =6(\\frac{{x}^{5}}{5})-3(\\frac{{x}^{4}}{4})+C \\\\  & =\\frac{6{x}^{5}}{5}-\\frac{3{x}^{4}}{4}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248524 :knowledge-point/_questions [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5c935a-4055-5a9f-af32-531420755a88" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{{x}^{2}}+\\frac{6}{x}+C" :db/id #edb/ref 17592186248526} {:answer/id #uuid "30ef512b-8601-59d4-bf85-ecde35542509" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{{x}^{2}}+\\frac{1}{2x}+C" :db/id #edb/ref 17592186248527} {:answer/id #uuid "1e5fce29-b851-54dc-8fe4-380a3f02b61a" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{3}+6x+C" :db/id #edb/ref 17592186248528} {:answer/id #uuid "e77112ac-5642-565c-9877-2ce2678f20fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2{x}^{2}}-\\frac{2}{x}+C" :db/id #edb/ref 17592186248529} {:answer/id #uuid "2753ed20-3fa5-5602-a0c6-0e68b596e23a" :answer/type {:db/ident :answer.type/math} :answer/value "-3{x}^{2}+6{x}^{3}+C" :db/id #edb/ref 17592186248530}] :answer-field/correct {:answer/id #uuid "e77112ac-5642-565c-9877-2ce2678f20fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2{x}^{2}}-\\frac{2}{x}+C" :db/id #edb/ref 17592186248529} :answer-field/id #uuid "93723455-015f-5229-ab8f-9ac46b86274d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248525}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6e8aec96-9e69-5bf8-bcff-76074e082438" :question/is-example false :question/math-academy-id "q-113788" :question/problem "$\\int \\frac{1}{{x}^{3}}+\\frac{2}{{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{3}}+\\frac{2}{{x}^{2}}\\,\\text{d}x & =\\int {x}^{-3}+2{x}^{-2}\\,\\text{d}x \\\\  & =\\int {x}^{-3}\\,\\text{d}x+2\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-2}}{(-2)}+2(\\frac{{x}^{-1}}{(-1)})+C \\\\  & =-\\frac{1}{2{x}^{2}}-\\frac{2}{x}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248531 :knowledge-point/_questions [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "497fe954-0c1f-57b3-9de0-8bc7229547f2" :answer/type {:db/ident :answer.type/math} :answer/value "4x-{x}^{3}+C" :db/id #edb/ref 17592186248533} {:answer/id #uuid "24fa04d1-ab0d-5410-9694-47e5f38fcaf8" :answer/type {:db/ident :answer.type/math} :answer/value "2x+6{x}^{2}+C" :db/id #edb/ref 17592186248534} {:answer/id #uuid "2be5fc26-bf06-5ac1-a2ba-3bfbe6804bf1" :answer/type {:db/ident :answer.type/math} :answer/value "-2x+\\frac{3}{{x}^{3}}+C" :db/id #edb/ref 17592186248535} {:answer/id #uuid "2dc928b4-cc5a-5713-8b35-a40fc4d207c0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{x}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186248536} {:answer/id #uuid "29f18faa-b7be-5a3d-9ffd-24c7671776f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}-\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186248537}] :answer-field/correct {:answer/id #uuid "2dc928b4-cc5a-5713-8b35-a40fc4d207c0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{x}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186248536} :answer-field/id #uuid "5730525c-a049-589e-aaf3-d1618970c160" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248532}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eaf9d6cc-9e41-5768-a5df-e430c18c712e" :question/is-example false :question/math-academy-id "q-113789" :question/problem "$\\int \\frac{2+{x}^{4}}{{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{2+{x}^{4}}{{x}^{2}}\\,\\text{d}x & =\\int (\\frac{2}{{x}^{2}}+\\frac{{x}^{4}}{{x}^{2}})\\,\\text{d}x \\\\  & =\\int \\frac{2}{{x}^{2}}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2\\int {x}^{-2}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2(\\frac{{x}^{-1}}{(-1)})+\\frac{{x}^{3}}{3}+C \\\\  & =-\\frac{2}{x}+\\frac{{x}^{3}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248538 :knowledge-point/_questions [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30019e39-5e82-503c-80d2-27e089c7444f" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{5}-{x}^{6}+\\sqrt[6]{{x}^{5}}+C" :db/id #edb/ref 17592186248540} {:answer/id #uuid "ee3036a6-7b52-5f9c-ab2d-6ea382679ee9" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{3}-4{x}^{4}+\\frac{5\\sqrt[6]{{x}^{5}}}{6}+C" :db/id #edb/ref 17592186248541} {:answer/id #uuid "1cd6dc11-f347-5da5-b892-d79834aed6b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{3}-\\frac{{x}^{4}}{2}+\\frac{5\\sqrt[4]{{x}^{11}}}{11}+C" :db/id #edb/ref 17592186248542} {:answer/id #uuid "f91b1ca7-fccd-54dc-a56f-03f0870e26e5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+\\frac{{x}^{6}}{6}+\\frac{6\\sqrt[5]{{x}^{11}}}{5}+C" :db/id #edb/ref 17592186248543} {:answer/id #uuid "99563f6b-28fa-55d4-9c16-08470e631509" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-\\frac{{x}^{6}}{2}+\\frac{5\\sqrt[5]{{x}^{11}}}{11}+C" :db/id #edb/ref 17592186248544}] :answer-field/correct {:answer/id #uuid "99563f6b-28fa-55d4-9c16-08470e631509" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-\\frac{{x}^{6}}{2}+\\frac{5\\sqrt[5]{{x}^{11}}}{11}+C" :db/id #edb/ref 17592186248544} :answer-field/id #uuid "85bc1f7e-2b2f-5c1c-9a50-8ef4b034c884" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248539}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a0a422f-d6c6-5151-9890-b1b6ff8dc299" :question/is-example false :question/math-academy-id "q-113845" :question/problem "Find the antiderivative of \n${x}^{4}-3{x}^{5}+\\sqrt[5]{{x}^{6}}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int ({x}^{4}-3{x}^{5}+\\sqrt[5]{{x}^{6}})\\,\\text{d}x & =\\int {x}^{4}\\,\\text{d}x-3\\int {x}^{5}\\,\\text{d}x+\\int {x}^{6/5}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}-3\\cdot (\\frac{{x}^{5+1}}{5+1})+\\frac{{x}^{6/5+1}}{(\\frac{6}{5}+1)}+C \\\\  & =\\frac{{x}^{5}}{5}-3\\cdot (\\frac{{x}^{6}}{6})+\\frac{{x}^{11/5}}{(\\frac{11}{5})}+C \\\\  & =\\frac{{x}^{5}}{5}-\\frac{{x}^{6}}{2}+\\frac{5\\sqrt[5]{{x}^{11}}}{11}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248545 :knowledge-point/_questions [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3837c73-5aa6-544e-9fac-2a8a51f39b05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{6}-2\\sqrt{{x}^{3}}+\\frac{3\\sqrt[3]{{x}^{5}}}{2}+C" :db/id #edb/ref 17592186248547} {:answer/id #uuid "1c7555ee-24a7-5de9-b738-53cb3ec7b544" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{6}-\\sqrt{x}+\\sqrt[4]{{x}^{3}}+C" :db/id #edb/ref 17592186248548} {:answer/id #uuid "1e80489f-4b49-5055-a7d4-f0d38c48bc40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{x}^{6}}+\\frac{\\sqrt{x}}{2}+\\frac{\\sqrt[3]{{x}^{4}}}{8}+C" :db/id #edb/ref 17592186248549} {:answer/id #uuid "72cb4dfe-322a-5a0a-a3cd-5a8886d4a252" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{6}-4\\sqrt{x}+\\frac{2\\sqrt[4]{{x}^{3}}}{3}+C" :db/id #edb/ref 17592186248550} {:answer/id #uuid "281e8174-92ee-538c-923c-1aa74a92215d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{3}-2\\sqrt{x}+\\frac{3\\sqrt[3]{{x}^{4}}}{2}+C" :db/id #edb/ref 17592186248551}] :answer-field/correct {:answer/id #uuid "281e8174-92ee-538c-923c-1aa74a92215d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{3}-2\\sqrt{x}+\\frac{3\\sqrt[3]{{x}^{4}}}{2}+C" :db/id #edb/ref 17592186248551} :answer-field/id #uuid "10bf1393-340e-5baf-a6bc-de3e7a93fef1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248546}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4adc85a8-8014-5b87-87d9-40c2bf73d0ef" :question/is-example false :question/math-academy-id "q-113851" :question/problem "Calculate \n$\\int (2{x}^{5}-\\frac{1}{\\sqrt{x}}+2\\sqrt[3]{x})\\,\\text{d}x.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (2{x}^{5}-\\frac{1}{\\sqrt{x}}+2\\sqrt[3]{x})\\,\\text{d}x & =2\\int {x}^{5}\\,\\text{d}x-\\int {x}^{-1/2}\\,\\text{d}x+2\\int {x}^{1/3}\\,\\text{d}x \\\\  & =2\\cdot (\\frac{{x}^{5+1}}{5+1})-\\frac{{x}^{-1/2+1}}{(-\\frac{1}{2}+1)}+2\\cdot \\frac{{x}^{1/3+1}}{(\\frac{1}{3}+1)}+C \\\\  & =2\\cdot (\\frac{{x}^{6}}{6})-\\frac{{x}^{1/2}}{(\\frac{1}{2})}+2\\cdot \\frac{{x}^{4/3}}{(\\frac{4}{3})}+C \\\\  & =\\frac{{x}^{6}}{3}-2\\sqrt{x}+\\frac{3\\sqrt[3]{{x}^{4}}}{2}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248552 :knowledge-point/_questions [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185fe9e3-b9f2-54ec-b5ae-8fd6f4b6efaf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}+\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186248554} {:answer/id #uuid "a9aa6da3-ce08-5372-885d-fb40cff3ff65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4{x}^{4}+5{x}^{2}}{2}+C" :db/id #edb/ref 17592186248555} {:answer/id #uuid "6b1c1061-5794-521a-bf85-87c2f039edd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{2}+\\frac{5{x}^{2}}{2}+C" :db/id #edb/ref 17592186248556} {:answer/id #uuid "4ecdc5b8-32cd-52a7-8ba9-adb9f1b9bd1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{4}+\\frac{5{x}^{2}}{2}+C" :db/id #edb/ref 17592186248557} {:answer/id #uuid "b2995727-ee29-5809-81e8-e6f26ce57875" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}+2{x}^{2}}{2}+C" :db/id #edb/ref 17592186248558}] :answer-field/correct {:answer/id #uuid "6b1c1061-5794-521a-bf85-87c2f039edd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{4}}{2}+\\frac{5{x}^{2}}{2}+C" :db/id #edb/ref 17592186248556} :answer-field/id #uuid "79b7b68b-6618-5825-92f9-c698ec639413" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248553}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d31633c8-2267-59e9-b635-6f83cdc21c1e" :question/is-example false :question/math-academy-id "q-2160" :question/problem "Find the antiderivative of $5x+2{x}^{3}.$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 5x+2{x}^{3}\\,\\text{d}x & =\\int 5x\\,\\text{d}x+\\int 2{x}^{3}\\,\\text{d}x \\\\  & =5\\int x\\,\\text{d}x+2\\int {x}^{3}\\,\\text{d}x \\\\  & =5(\\frac{{x}^{2}}{2})+2(\\frac{{x}^{4}}{4})+C \\\\  & =\\frac{{x}^{4}}{2}+\\frac{5{x}^{2}}{2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184491 :knowledge-point/_questions [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d775da7-8fc1-5cb3-9d3c-2af0421afc9f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x^{2}}{3} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181387} {:answer/id #uuid "b4ecc404-7066-5348-973e-7377baa05dce" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x}{2} - \\frac{1}{x^{2}} + C" :db/id #edb/ref 17592186181388} {:answer/id #uuid "e051ef6b-9060-5a12-a9ec-f4bbb35ddd1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181389} {:answer/id #uuid "489937da-53bc-51fa-8f37-d45d0186f18e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181390} {:answer/id #uuid "7520d140-b77f-5b0e-8a33-ded183b046ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x}{2} + \\frac{1}{x} + C" :db/id #edb/ref 17592186181391}] :answer-field/correct {:answer/id #uuid "e051ef6b-9060-5a12-a9ec-f4bbb35ddd1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181389} :answer-field/id #uuid "2149efd2-ebb0-5555-985d-1cb04dd0d206" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181386}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "74b8affd-5a59-5349-9045-109c73cdc246" :question/is-example false :question/math-academy-id "q-2166" :question/problem "What is $\\displaystyle \\int\\frac{1}{x^{2}} - 3xdx$?" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}}-3x\\,\\text{d}x & =\\int {x}^{-2}-3x\\,\\text{d}x \\\\  & =\\int {x}^{-2}\\,\\text{d}x-3\\int x\\,\\text{d}x \\\\  & =(-{x}^{-1})-3(\\frac{{x}^{2}}{2})+C \\\\  & =-\\frac{3{x}^{2}}{2}-\\frac{1}{x}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184502 :knowledge-point/_questions [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e5ce597-62ea-54d2-8f1a-415f3eedcc86" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 3\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181417} {:answer/id #uuid "c47182fe-b5f7-5ab7-9468-8e985b6c0a96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 2\\sqrt{x^{3}} + 2x}{3} + C" :db/id #edb/ref 17592186181418} {:answer/id #uuid "c8c0f99f-f43c-5656-ad88-f62d9b27ccb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 2\\sqrt[3]{x^{2}} + 2x}{3} + C" :db/id #edb/ref 17592186181419} {:answer/id #uuid "39ee7c07-44d7-5ef5-97de-7c0090d83f08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 3\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181420} {:answer/id #uuid "5e14c783-f2a2-5eff-9bda-e48e2bc22284" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 2\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181421}] :answer-field/correct {:answer/id #uuid "5e14c783-f2a2-5eff-9bda-e48e2bc22284" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x^{3} - 2\\sqrt{x^{3}} + 6x}{3} + C" :db/id #edb/ref 17592186181421} :answer-field/id #uuid "55fc02a1-3a57-558e-b923-8f00b33126b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181416}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "564c4689-85ae-5d46-8778-645d30c6800f" :question/is-example false :question/math-academy-id "q-2250" :question/problem "What is $\\displaystyle \\int(x^{2} - \\sqrt{x} + 2)dx$?" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int ({x}^{2}-\\sqrt{x}+2)\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x-\\int {x}^{1/2}\\,\\text{d}x+\\int 2\\,\\text{d}x \\\\  & =(\\frac{{x}^{3}}{3})-(\\frac{2{x}^{3/2}}{3})+(2x)+C \\\\  & =\\frac{{x}^{3}-2{x}^{3/2}}{3}+2x+C \\\\  & =\\frac{{x}^{3}-2\\sqrt{{x}^{3}}+6x}{3}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184680 :knowledge-point/_questions [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9836b573-d927-50b1-b2a4-0ccf3e742d92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{7}}}{7} - \\frac{2}{3\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186182975} {:answer/id #uuid "b7835897-2660-52c4-b3cd-da6bc55f2cdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{7}}}{3} + \\frac{5}{3\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186182976} {:answer/id #uuid "c1601f06-29da-5717-a469-8e5ed3b92ed0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{x^{5}}}{7} - \\frac{7}{5\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186182977} {:answer/id #uuid "1aa875c2-66a0-5591-9f88-7cfb965f2a5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{3}}}{7} + \\frac{2}{3\\sqrt{x^{5}}} + C" :db/id #edb/ref 17592186182978} {:answer/id #uuid "74e1a9fb-4eb3-57c9-9555-eaa686b19404" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{x^{3}}}{7} - \\frac{11}{3\\sqrt{x^{7}}} + C" :db/id #edb/ref 17592186182979}] :answer-field/correct {:answer/id #uuid "9836b573-d927-50b1-b2a4-0ccf3e742d92" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{x^{7}}}{7} - \\frac{2}{3\\sqrt{x^{3}}} + C" :db/id #edb/ref 17592186182975} :answer-field/id #uuid "f50e978e-1b94-5800-b880-db8b1e335087" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186182974}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bd6f191d-dd25-52a7-91ee-5275c10c8293" :question/is-example false :question/math-academy-id "q-29828" :question/problem "Find the antiderivative of $\\sqrt{x^{5}} + \\frac{1}{\\sqrt{x^{5}}}$." :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\sqrt{{x}^{5}}+\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & =\\int {x}^{5/2}\\,\\text{d}x+\\int {x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{5/2+1}}{(\\frac{5}{2}+1)}+\\frac{{x}^{-5/2+1}}{(\\frac{-5}{2}+1)}+C \\\\  & =\\frac{2}{7}\\cdot {x}^{7/2}-\\frac{2}{3}{x}^{-3/2}+C \\\\  & =\\frac{2\\sqrt{{x}^{7}}}{7}-\\frac{2}{3\\sqrt{{x}^{3}}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248559 :knowledge-point/_questions [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "958b85eb-cc82-5cc4-8994-1f424da3f034" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{3}+x+C" :db/id #edb/ref 17592186248561} {:answer/id #uuid "44ce64f3-1a48-50fc-8501-0e695460d4e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{3}+\\frac{2{x}^{4}}{3}+{x}^{2}+C" :db/id #edb/ref 17592186248562} {:answer/id #uuid "15f22825-d71c-55dd-9046-78f781447ff1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+\\frac{2{x}^{3}}{3}+x+C" :db/id #edb/ref 17592186248563} {:answer/id #uuid "c8efa3cd-8f7d-59ca-b3ed-ee9e3312f954" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{{x}^{3}}{3}+x)}^{2}+C" :db/id #edb/ref 17592186248564} {:answer/id #uuid "540d5c5c-1274-58b7-a99e-99f7357d2e87" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{(1+{x}^{2})}^{3}}{3}+C" :db/id #edb/ref 17592186248565}] :answer-field/correct {:answer/id #uuid "15f22825-d71c-55dd-9046-78f781447ff1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+\\frac{2{x}^{3}}{3}+x+C" :db/id #edb/ref 17592186248563} :answer-field/id #uuid "9fcb0338-57de-5c87-9e6e-0346031eebc9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248560}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "b83e5dcc-e741-5012-8a22-630a8c8c3731" :question/is-example false :question/math-academy-id "q-49062" :question/problem "$\\int (1+{x}^{2}{)}^{2}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (1+{x}^{2}{)}^{2}\\,\\text{d}x & =\\int (1+2{x}^{2}+{x}^{4})\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x+2\\int {x}^{2}\\,\\text{d}x+\\int 1\\,\\text{d}x \\\\  & =(\\frac{{x}^{5}}{5})+2(\\frac{{x}^{3}}{3})+(x)+C \\\\  & =\\frac{{x}^{5}}{5}+\\frac{2{x}^{3}}{3}+x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248566 :knowledge-point/_questions [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32c29acd-6a39-538f-b706-74bafd362ee9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-2{x}^{3}+C" :db/id #edb/ref 17592186248568} {:answer/id #uuid "10bc5287-28d6-5c0d-b1e4-7ee90841592a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+2{x}^{3}+9x+C" :db/id #edb/ref 17592186248569} {:answer/id #uuid "f707efa4-3255-5a6b-a800-ba6a5aa4c6e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+C" :db/id #edb/ref 17592186248570} {:answer/id #uuid "dc263731-0a3e-53fe-9231-cc25a8b9298f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-2{x}^{3}+9x+C" :db/id #edb/ref 17592186248571} {:answer/id #uuid "807027bd-c67d-53f2-b47a-79583ad7fcd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}+9x+C" :db/id #edb/ref 17592186248572}] :answer-field/correct {:answer/id #uuid "dc263731-0a3e-53fe-9231-cc25a8b9298f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{5}-2{x}^{3}+9x+C" :db/id #edb/ref 17592186248571} :answer-field/id #uuid "e4a79411-379d-5519-8bb5-fe4af302463c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248567}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ed103c60-813d-59b4-b808-02a46fdaf55b" :question/is-example false :question/math-academy-id "q-49174" :question/problem "$\\int {(3-{x}^{2})}^{2}\\,\\text{d}x=$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(3-{x}^{2})}^{2}\\,\\text{d}x & =\\int (9-6{x}^{2}+{x}^{4})\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x-6\\int {x}^{2}\\,\\text{d}x+9\\int \\,\\text{d}x \\\\  & =\\frac{{x}^{5}}{5}-6(\\frac{{x}^{3}}{3})+9x+C \\\\  & =\\frac{{x}^{5}}{5}-2{x}^{3}+9x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248573 :knowledge-point/_questions [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d3d47a1-7b57-53b5-a63a-f7f29d5e0ed8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt[3]{{x}^{8}}}{8}-\\frac{5{x}^{3}}{4}+C" :db/id #edb/ref 17592186248575} {:answer/id #uuid "ab15ec86-f622-59ed-b3c7-3c86a2e323b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{{x}^{8}}}{8}-\\frac{{x}^{3}}{2}+C" :db/id #edb/ref 17592186248576} {:answer/id #uuid "f41b402b-4c7c-5d4e-b952-ef7bff5c24f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt[3]{{x}^{8}}}{3}+\\frac{{x}^{3}}{4}+C" :db/id #edb/ref 17592186248577} {:answer/id #uuid "d8be371e-eb0b-5624-81a6-b257700ade7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt[3]{{x}^{8}}}{8}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186248578} {:answer/id #uuid "6229ada3-c34c-5791-acab-f0cb780d1729" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt[4]{{x}^{5}}+{x}^{3}+C" :db/id #edb/ref 17592186248579}] :answer-field/correct {:answer/id #uuid "d8be371e-eb0b-5624-81a6-b257700ade7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt[3]{{x}^{8}}}{8}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186248578} :answer-field/id #uuid "c0f45987-e001-5ab3-9373-90840ae8a861" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248574}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "03b2c391-d105-537e-ac77-82e5faccec7f" :question/is-example false :question/math-academy-id "q-71168" :question/problem "Find the antiderivative of $\\sqrt[3]{{x}^{5}}+{x}^{2}.$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int \\sqrt[3]{{x}^{5}}+{x}^{2}\\,\\text{d}x & =\\int {x}^{5/3}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{5/3+1}}{(\\frac{5}{3}+1)}+\\frac{{x}^{2+1}}{2+1}+C \\\\  & =\\frac{3}{8}\\cdot {x}^{8/3}+\\frac{{x}^{3}}{3}+C \\\\  & =\\frac{3\\sqrt[3]{{x}^{8}}}{8}+\\frac{{x}^{3}}{3}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186248580 :knowledge-point/_questions [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "692976ef-8470-5b2d-9e6d-6b9ac0c28ffb" :answer/type {:db/ident :answer.type/math} :answer/value "z-\\frac{3{z}^{5/3}}{5}+C" :db/id #edb/ref 17592186248582} {:answer/id #uuid "93e4620c-aa62-52c8-9fcc-af3ac3e35caf" :answer/type {:db/ident :answer.type/math} :answer/value "z-2{z}^{3}+C" :db/id #edb/ref 17592186248583} {:answer/id #uuid "a59a7f75-5b15-535d-be35-c670526fb218" :answer/type {:db/ident :answer.type/math} :answer/value "z+\\frac{5{z}^{5/3}}{8}+C" :db/id #edb/ref 17592186248584} {:answer/id #uuid "5b0dbd27-98a1-5006-8f9f-ac9ced4f9e2d" :answer/type {:db/ident :answer.type/math} :answer/value "2z-\\frac{{z}^{5/3}}{5}+C" :db/id #edb/ref 17592186248585} {:answer/id #uuid "aecd6d93-087e-5534-b84d-b1519f7ee92a" :answer/type {:db/ident :answer.type/math} :answer/value "-z+\\frac{{z}^{5/3}}{3}+C" :db/id #edb/ref 17592186248586}] :answer-field/correct {:answer/id #uuid "692976ef-8470-5b2d-9e6d-6b9ac0c28ffb" :answer/type {:db/ident :answer.type/math} :answer/value "z-\\frac{3{z}^{5/3}}{5}+C" :db/id #edb/ref 17592186248582} :answer-field/id #uuid "c6cccb50-79b9-5aff-87bc-5ad6270264cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186248581}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5273bae4-11cd-58cd-b6ed-bbe95a888652" :question/is-example false :question/math-academy-id "q-71172" :question/problem "$\\int 1-{z}^{2/3}\\,\\text{d}z=$" :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\\int 1-{z}^{2/3}\\,\\text{d}z & =\\int 1\\,\\text{d}z-\\int {z}^{2/3}\\,\\text{d}z \\\\  & =\\int {z}^{0}\\,\\text{d}z-\\int {z}^{2/3}\\,\\text{d}z \\\\  & =\\frac{{z}^{0+1}}{0+1}-\\frac{{z}^{2/3+1}}{(\\frac{2}{3}+1)}+C \\\\  & =z-\\frac{3{z}^{5/3}}{5}+C\\end{aligned}\n$$"}]}
