#{[{:db/id #edb/ref 17592186184001 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0db9b1c3-1e31-53f6-9fc2-1c611e2f9398" :knowledge-point/title "Computing an Integral Using the Sum Rule"}] :question/id #uuid "e4a94ca8-82ee-5776-a46d-b735d4ab60fb" :question/is-example true :question/math-academy-id "e-371" :question/problem "Find the integral of $x^2 + 1$." :question/worked-solution "Applying the sum rule, we compute the sum of the integrals of each function:\n\n$$\n\\begin{aligned}\n\\intx^{2} + 1dx &= \\intx^{2}dx + \\int1dx \\\\\n&= \\intx^{2}dx + \\intx^{0}dx \\\\\n&= (\\frac{x^{2 + 1}}{2 + 1}) + x + C \\\\\n&= \\frac{1}{3}x^{3} + x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184002 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/id #uuid "ea7dadee-2b44-5e62-bef4-26fb0cb185ea" :question/is-example true :question/math-academy-id "e-372" :question/problem "Calculate $\\displaystyle \\int 2 x^3 - x \\,\\textrm d x$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int2x^{3} - xdx &= 2\\intx^{3}dx - \\intxdx \\\\\n&= 2(\\frac{x^{3 + 1}}{3 + 1}) - (\\frac{x^{1 + 1}}{1 + 1}) + C \\\\\n&= 2(\\frac{x^{4}}{4}) - (\\frac{x^{2}}{2}) + C \\\\\n&= \\frac{x^{4}}{2} - \\frac{x^{2}}{2} + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184003 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "007f3355-427a-5da4-8af7-22581f1cb1de" :knowledge-point/title "Integrating Sums of Power Functions"}] :question/id #uuid "8f99b603-2fba-5a58-9966-b91d3a8a773e" :question/is-example true :question/math-academy-id "e-373" :question/problem "Calculate $\\displaystyle \\int \\left(5(\\sqrt{x})^{3} - 4 x^2 + 5\\right) \\,\\textrm d x$." :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\n\\int(5(\\sqrt{x})^{3} - 4x^{2} + 5)dx &= \\int(5x^{3/2} - 4x^{2} + 5)dx \\\\\n&= 5\\intx^{3/2}dx - 4\\intx^{2}dx + 5\\int1dx \\\\\n&= 5(\\frac{x^{5/2}}{\\frac{5}{2}}) - 4(\\frac{x^{3}}{3}) + 5(x) + C \\\\\n&= 5 \\cdot \\frac{2}{5}x^{5/2} - \\frac{4}{3}x^{3} + 5x + C \\\\\n&= 2\\sqrt{x^{5}} - \\frac{4}{3}x^{3} + 5x + C\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184491 :knowledge-point/_questions [{:knowledge-point/id #uuid "a58c0a18-4221-50f1-b31c-ae58d099d79d" :knowledge-point/title "Computing an Integral Using the Sum and Constant Factor Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d775da7-8fc1-5cb3-9d3c-2af0421afc9f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2x^{2}}{3} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181387} {:answer/id #uuid "b4ecc404-7066-5348-973e-7377baa05dce" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x}{2} - \\frac{1}{x^{2}} + C" :db/id #edb/ref 17592186181388} {:answer/id #uuid "e051ef6b-9060-5a12-a9ec-f4bbb35ddd1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181389} {:answer/id #uuid "489937da-53bc-51fa-8f37-d45d0186f18e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181390} {:answer/id #uuid "7520d140-b77f-5b0e-8a33-ded183b046ca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x}{2} + \\frac{1}{x} + C" :db/id #edb/ref 17592186181391}] :answer-field/correct {:answer/id #uuid "e051ef6b-9060-5a12-a9ec-f4bbb35ddd1e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3x^{2}}{2} - \\frac{1}{x} + C" :db/id #edb/ref 17592186181389} :answer-field/id #uuid "2149efd2-ebb0-5555-985d-1cb04dd0d206" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181386}] :question/id #uuid "74b8affd-5a59-5349-9045-109c73cdc246" :question/is-example false :quest