i }f(x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-44d96c8b-cffe-57c2-a3b9-0fcfebeae8e2" :answer/id #uuid "44d96c8b-cffe-57c2-a3b9-0fcfebeae8e2" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(\\frac{7L}{\\pi }x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-174be5e3-b6e9-5d92-bd41-95ff40e224e3" :answer/id #uuid "174be5e3-b6e9-5d92-bd41-95ff40e224e3" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(\\frac{7L}{\\pi }x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-field-1d4c8fc9-3a29-5bfd-917e-d1711fd26d74" :answer-field/id #uuid "1d4c8fc9-3a29-5bfd-917e-d1711fd26d74" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-1a28eb50-b541-56ea-95a2-94fb36b7667a" :answer-field/choices ["answer-87c51d20-54d4-5d38-ad70-48e324bd3f64" "answer-1a28eb50-b541-56ea-95a2-94fb36b7667a" "answer-efb64615-ad15-5206-89a7-d8638df10b16" "answer-15b65751-5861-527d-bc09-9b006f1be127"] :db/ensure [:answer-field/validate]} {:db/id "answer-87c51d20-54d4-5d38-ad70-48e324bd3f64" :answer/id #uuid "87c51d20-54d4-5d38-ad70-48e324bd3f64" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-1a28eb50-b541-56ea-95a2-94fb36b7667a" :answer/id #uuid "1a28eb50-b541-56ea-95a2-94fb36b7667a" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-efb64615-ad15-5206-89a7-d8638df10b16" :answer/id #uuid "efb64615-ad15-5206-89a7-d8638df10b16" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-15b65751-5861-527d-bc09-9b006f1be127" :answer/id #uuid "15b65751-5861-527d-bc09-9b006f1be127" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "answer-field-5d9a9574-0239-56b9-b74c-601d7849c71e" :answer-field/id #uuid "5d9a9574-0239-56b9-b74c-601d7849c71e" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "answer-23c8fc31-c04a-55f3-b418-822b94320b8c" :answer-field/choices ["answer-75e4dbf3-e378-5ec2-b8a5-728fcdded53e" "answer-23c8fc31-c04a-55f3-b418-822b94320b8c" "answer-e5cf8d32-cee9-5c3c-b38e-722ea6242159" "answer-d3fa551c-7c0f-5dfe-b113-eb5fc2945fba" "answer-ee7adb66-75f9-5881-bfab-6bca6145d34a" "answer-8df6ab7c-533c-5677-9af6-8b7e905bd55a"] :db/ensure [:answer-field/validate]} {:db/id "answer-75e4dbf3-e378-5ec2-b8a5-728fcdded53e" :answer/id #uuid "75e4dbf3-e378-5ec2-b8a5-728fcdded53e" :answer/type :answer.type/math :answer/value "{\\int }_{-2\\pi }^{2\\pi }x\\operatorname{cos}⁡(\\frac{7}{2}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-23c8fc31-c04a-55f3-b418-822b94320b8c" :answer/id #uuid "23c8fc31-c04a-55f3-b418-822b94320b8c" :answer/type :answer.type/math :answer/value "{\\int }_{-2\\pi }^{2\\pi }x\\operatorname{sin}⁡(\\frac{7}{2}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-e5cf8d32-cee9-5c3c-b38e-722ea6242159" :answer/id #uuid "e5cf8d32-cee9-5c3c-b38e-722ea6242159" :answer/type :answer.type/math :answer/value "{\\int }_{-7}^{7}x\\operatorname{cos}⁡(7\\pi x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-d3fa551c-7c0f-5dfe-b113-eb5fc2945fba" :answer/id #uuid "d3fa551c-7c0f-5dfe-b113-eb5fc2945fba" :answer/type :answer.type/math :answer/value "{\\int }_{-7}^{7}x\\operatorname{sin}⁡(7\\pi x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ee7adb66-75f9-5881-bfab-6bca6145d34a" :answer/id #uuid "ee7adb66-75f9-5881-bfab-6bca6145d34a" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-8df6ab7c-533c-5677-9af6-8b7e905bd55a" :answer/id #uuid "8df6ab7c-533c-5677-9af6-8b7e905bd55a" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }x\\operatorname{sin}⁡(\\frac{7L}{\\pi }x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-fb364528-cf72-5941-b3b8-fc021ca9ace0" :question/id #uuid "fb364528-cf72-5941-b3b8-fc021ca9ace0" :question/math-academy-id "q-341777" :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x\\in R.$\nSelect the correct options in the reasoning below.\n\nThe Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡({{field-1}})+{b}_{n}\\operatorname{sin}⁡({{field-2}}).\n$$\n\nThe $6$th cosine coefficient of the series is\n\n$$\n{a}_{6}={{field-3}}.\n$$\n\nGiven that $F(x)={e}^{-{x}^{2}}$ and $L=5,$ the $6$th cosine coefficient becomes\n\n$$\n{a}_{6}={{field-4}}\\,\\cdot \\,{{field-5}}.\n$$" :question/worked-solution "Recall that multiplying the argument of a function by $k\\ne 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\frac{1}{k}.$\n\nNow, let $s=\\frac{\\pi }{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s)=f(\\frac{L}{\\pi }s)\n$$\n\nmust have a period of $2L\\cdot \\frac{\\pi }{L}=2\\pi .$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(ns)+{b}_{n}\\operatorname{sin}⁡(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\frac{\\pi }{L}x$ and using the fact that $g(s)=f(\\frac{L}{\\pi }s),$ we get the Fourier series of $f(x):$\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\n$$\n\nTherefore, $6$th cosine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{a}_{6} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(6s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(6s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{cos}⁡(6\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=5$ and $f(x)={e}^{-{x}^{2}},$ we get\n\n$$\n\\begin{aligned}{a}_{6} & =\\frac{1}{5}\\cdot {\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{cos}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-91327f8b-24a5-5a14-b72f-dc506b7dc1e0" "answer-field-27849c49-d7ae-5d00-af0d-9052f43cd943" "answer-field-85d4ff48-5bff-577d-8fcc-6da194224b88" "answer-field-20357d5e-1bc8-5dd7-8db6-94cde34f7b98" "answer-field-f064fef8-a113-5d06-b95a-f4c517e2b24e"] :db/ensure [:question/validate]} {:db/id "answer-field-91327f8b-24a5-5a14-b72f-dc506b7dc1e0" :answer-field/id #uuid "91327f8b-24a5-5a14-b72f-dc506b7dc1e0" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-09a4dbf4-935c-5e5a-bfc2-9a1676fbd5fb" :answer-field/choices ["answer-12dbb8fc-f8ae-55a2-b4d3-f92953f9c8be" "answer-408b0c9c-4d17-5e7b-b2fd-1a3711a49bcf" "answer-09a4dbf4-935c-5e5a-bfc2-9a1676fbd5fb" "answer-6e149a08-fca9-5755-a128-871a5e7f972a"] :db/ensure [:answer-field/validate]} {:db/id "answer-12dbb8fc-f8ae-55a2-b4d3-f92953f9c8be" :answer/id #uuid "12dbb8fc-f8ae-55a2-b4d3-f92953f9c8be" :answer/type :answer.type/math :answer/value "\\frac{L}{n\\pi }x" :db/ensure [:answer/validate]} {:db/id "answer-408b0c9c-4d17-5e7b-b2fd-1a3711a49bcf" :answer/id #uuid "408b0c