\\ 7\\end{aligned}]\\cdot [\\begin{aligned}2 & 2 & -4\\end{aligned}]=[\\begin{aligned}14 & 14 & -28 \\\\ 14 & 14 & -28\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1e3a6cde-fe2e-5328-94cb-e127be547cc6"] :db/ensure [:question/validate]} {:db/id "answer-field-1e3a6cde-fe2e-5328-94cb-e127be547cc6" :answer-field/id #uuid "1e3a6cde-fe2e-5328-94cb-e127be547cc6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b57deb46-f99b-5d8a-aa79-e0e3eafad385" :answer-field/choices ["answer-0f99e9f1-58c4-5851-9600-8204fd87374e" "answer-902a2d7e-4845-5624-8b64-c075f831f4cb" "answer-b57deb46-f99b-5d8a-aa79-e0e3eafad385" "answer-10f26137-5141-548b-ae96-c5e466eb63be" "answer-ea606262-28d8-520e-a132-062645065d2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f99e9f1-58c4-5851-9600-8204fd87374e" :answer/id #uuid "0f99e9f1-58c4-5851-9600-8204fd87374e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 4 \\\\ 1 & -2 \\\\ 1 & -8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-902a2d7e-4845-5624-8b64-c075f831f4cb" :answer/id #uuid "902a2d7e-4845-5624-8b64-c075f831f4cb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & 14 & -28 \\\\ -28 & 14 & 14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b57deb46-f99b-5d8a-aa79-e0e3eafad385" :answer/id #uuid "b57deb46-f99b-5d8a-aa79-e0e3eafad385" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & 14 & -28 \\\\ 14 & 14 & -28\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-10f26137-5141-548b-ae96-c5e466eb63be" :answer/id #uuid "10f26137-5141-548b-ae96-c5e466eb63be" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & 14 & 28 \\\\ 14 & 14 & 28\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ea606262-28d8-520e-a132-062645065d2c" :answer/id #uuid "ea606262-28d8-520e-a132-062645065d2c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}14 & 14 \\\\ -28 & 28 \\\\ 14 & -28\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-b06d01a6-0f9f-5c10-83f5-9d9f497a0fba" :question/id #uuid "b06d01a6-0f9f-5c10-83f5-9d9f497a0fba" :question/math-academy-id "q-269387" :question/problem "Consider the function $L:{R}^{3\\times 2}\\to R$ defined by $L(A)={y}^{T}Ax$ where \n\n$$\nx=[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,y=[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}-1 & 6 \\\\ 2 & 2 \\\\ 3 & -1\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=y\\cdot {x}^{T}.$\n\nEvaluating at the given values $x=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ and $y=[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}]\\cdot [\\begin{aligned}0 & 1\\end{aligned}]=[\\begin{aligned}0 & -2 \\\\ 0 & 4 \\\\ 0 & 9\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6d683c36-c6df-5d48-954b-faab60c2b7e7"] :db/ensure [:question/validate]} {:db/id "answer-field-6d683c36-c6df-5d48-954b-faab60c2b7e7" :answer-field/id #uuid "6d683c36-c6df-5d48-954b-faab60c2b7e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab469b17-e684-57f3-a032-921d53d60e0b" :answer-field/choices ["answer-d75faa5d-b436-5bf2-80c6-7dd3b873f64d" "answer-f3189ab9-689f-5420-a82c-7c912aa81e2d" "answer-5431fd3a-c958-5840-b6fc-bd80d1d983c6" "answer-ab469b17-e684-57f3-a032-921d53d60e0b" "answer-fc7ffc60-8c50-5d64-a8a1-dfe85be3ab2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-d75faa5d-b436-5bf2-80c6-7dd3b873f64d" :answer/id #uuid "d75faa5d-b436-5bf2-80c6-7dd3b873f64d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 6 \\\\ 2 & 2 \\\\ 3 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f3189ab9-689f-5420-a82c-7c912aa81e2d" :answer/id #uuid "f3189ab9-689f-5420-a82c-7c912aa81e2d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 0 \\\\ 4 & 0 \\\\ 9 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5431fd3a-c958-5840-b6fc-bd80d1d983c6" :answer/id #uuid "5431fd3a-c958-5840-b6fc-bd80d1d983c6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 4 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ab469b17-e684-57f3-a032-921d53d60e0b" :answer/id #uuid "ab469b17-e684-57f3-a032-921d53d60e0b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -2 \\\\ 0 & 4 \\\\ 0 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fc7ffc60-8c50-5d64-a8a1-dfe85be3ab2c" :answer/id #uuid "fc7ffc60-8c50-5d64-a8a1-dfe85be3ab2c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 \\\\ 9 & 4 \\\\ -2 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-078844cb-65ac-54f4-bde7-64e4bd44f313" :question/id #uuid "078844cb-65ac-54f4-bde7-64e4bd44f313" :question/math-academy-id "q-269466" :question/problem "Consider the function $L:{R}^{2\\times 2}\\to R$ defined by $L(A)=2(Ax-b)^{T}(Ax-b),$ where\n\n$$\nx=[\\begin{aligned}10 \\\\ 10\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${∇}_{A}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$760$</td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">$-40$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)=2{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(2{y}^{T}y)=4y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=4{y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i}.\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =4{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =4{y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $4$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x,$ so\n\n$$\n{∇}_{A}L=4y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $A=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}],$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =4y\\cdot {x}^{T} \\\\  & =4(Ax-b)\\cdot {x}^{T} \\\\  & =4([\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}10 \\\\ 10\\end{aligned}]-[\\begin{aligned}1 \\\\ 1\\end{aligned}])\\cdot [\\begin{aligned}10 & 10\\end{aligned}] \\\\  & =4([\\begin{aligned}20 \\\\ 0\\end{aligned}]-[\\begin{aligned}1 \\\\ 1\\end{aligned}])\\cdot [\\begin{aligned}10 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}76 \\\\ -4\\end{aligned}]\\cdot [\\begin{aligned}10 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}760 & 760 \\\\ -40 & -40\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-86a09f03-3f8a-5c3f-9183-dbfb9af6dd2a" "answer-field-a107a0f3-3d37-50c0-a77a-33925b86f16a"] :db/ensure [:question/validate]} {:db/id "answer-field-86a09f03-3f8a-5c3f-9183-dbfb9af6dd2a" :answer-field/id #uuid "86a09f03-3f8a-5c3f-9183-dbfb9af6dd2a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b4d4fb6a-d27b-55cc-8727-67a4c04b568b" :answer-field/choices ["answer-b4d4fb6a-d27b-55cc-8727-67a4c04b568b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4d4fb6a-d27b-55cc-8727-67a4c04b568b" :answer/id #uuid "b4d4fb6a-d27b-55cc-8727-67a4c04b568b" :answer/type :answer.type/math :answer/value "760" :db/ensure [:answer/validate]} {:db/id "answer-field-a107a0f3-3d37-50c0-a77a-33925b86f16a" :answer-field/id #uuid "a107a0f3-3d37-50c0-a77a-33925b86f16a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eeb1139b-d9f2-55ff-8169-1877c0fc480b" :answer-field/choices ["answer-eeb1139b-d9f2-55ff-8169-1877c0fc480b"] :db/ensure [:answer-field/validate]} {:db/id "answer-eeb1139b-d9f2-55ff-8169-1877c0fc480b" :answer/id #uuid "eeb1139b-d9f2-55ff-8169-1877c0fc480b" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "activity-f063dc42-6d1b-5e1c-9569-9f74dc807d8e" :activity/id #uuid "f063dc42-6d1b-5e1c-9569-9f74dc807d8e" :activity/title "Matrix Gradients" :activity/type :activity.type/review :activity/scope 17592186048550 :activity/course 17592186046658 :activity/steps ["step-244abaf2-b14e-5d3c-8a36-dbd5fac2c489" "step-5abfd5b5-134f-5a5a-8939-900b7bd8ea02" "step-64cd4bd3-fcea-541b-aa6e-833c6b308386" "step-08378717-3017-5e03-97b0-35ada959e212" "step-1ce65caa-d800-5e9b-998a-08f08f3b10e3"] :activity/first-step "step-244abaf2-b14e-5d3c-8a36-dbd5fac2c489" :db/ensure [:activity/validate]} {:db/id "step-244abaf2-b14e-5d3c-8a36-dbd5fac2c489" :step/id #uuid "244abaf2-b14e-5d3c-8a36-dbd5fac2c489" :step/content 17592186204583 :step/next "step-5abfd5b5-134f-5a5a-8939-900b7bd8ea02" :db/ensure [:step/validate]} {:db/id "step-5abfd5b5-134f-5a5a-8939-900b7bd8ea02" :step/id #uuid "5abfd5b5-134f-5a5a-8939-900b7bd8ea02" :step/content "question-7c674592-16b0-5e5a-b0ac-ce1e62f430e7" :step/next "step-64cd4bd3-fcea-541b-aa6e-833c6b308386" :db/ensure [:step/validate]} {:db/id "step-64cd4bd3-fcea-541b-aa6e-833c6b308386" :step/id #uuid "64cd4bd3-fcea-541b-aa6e-833c6b308386" :step/content "question-34c44cc9-bf3e-5025-8ef7-d8fd637a6eae" :step/next "step-08378717-3017-5e03-97b0-35ada959e212" :db/ensure [:step/validate]} {:db/id "step-08378717-3017-5e03-97b0-35ada959e212" :step/id #uuid "08378717-3017-5e03-97b0-35ada959e212" :step/content "question-b06d01a6-0f9f-5c10-83f5-9d9f497a0fba" :step/next "step-1ce65caa-d800-5e9b-998a-08f08f3b10e3" :db/ensure [:step/validate]} {:db/id "step-1ce65caa-d800-5e9b-998a-08f08f3b10e3" :step/id #uuid "1ce65caa-d800-5e9b-998a-08f08f3b10e3" :step/content "question-078844cb-65ac-54f4-bde7-64e4bd44f313" :db/ensure [:step/validate]} [:db/retract 17592186121850 :answer-field/choices 17592186121851] [:db/retract 17592186121850 :answer-field/choices 17592186121852] [:db/retract 17592186121850 :answer-field/choices 17592186121853] [:db/retract 17592186121850 :answer-field/choices 17592186121854] [:db/retract 17592186121850 :answer-field/choices 17592186121855] {:db/id 17592186124583 :knowledge-point/questions ["question-df827c7e-ce3b-5b89-941a-437f86328b7a" "question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124391 :question/problem "What is the domain of the function $g(x)=\\dfrac{4}{3}x^2+5x -12?$" :question/worked-solution "A quadratic function is defined for all real numbers.\n\nTherefore, the domain of $g(x)$ is $x\\in(-\\infty,\\infty).$" :db/ensure [:question/validate]} {:db/id 17592186124584 :knowledge-point/questions ["question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" "question-9acd8689-6770-5d1b-9670-f2ff78d7e31a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124393 :question/problem "What is the range of the function $f(x) = (x+3)^2-2?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny = a(x-h)^2 + k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-3$ and $k=-2,$ the vertex is $(-3,-2).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, the vertex corresponds to the minimum output, while there is no maximum output. \n\nTherefore, the range is $[-2,\\infty).$\n\nThe corresponding diagram is shown below.\n\n![](images/57/579eef7814c2b51c44cded6fb2dc64e36d1106d359864e1e7ec7354511f80681.png)" :db/ensure [:question/validate]} {:db/id 17592186124659 :knowledge-point/questions ["question-c749b226-6df0-583d-9d39-da82636ab3b6" "question-0eda0ab3-fc3e-57ae-8050-823c01afb804" "question-7dfd6f87-7029-50ed-aece-aeae8cb98e8c" "question-28ef6032-c464-5039-b5ee-d8d9a6314099"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124225 :question/problem "What is the range of the function $f(x)=x^2+4x+6?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny = ax^2+bx+c,\n$$\n\nwith $a=1>0,$ $b=4,$ and $c=6.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx= -\\dfrac{b}{2a} = -\\dfrac{4}{2 \\cdot 1} = -2.\n$$\n\nNow, we substitute $x=-2$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}+4x+6 \\\\  & =(-2)^{2}+4(-2)+6 \\\\  & =4-8+6 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(-2,2),$ and the range of the function is $[2,\\infty).$\n\n![](images/41/41b7219793120c0e37b3d910ef6a8f3754c1d9f27b784f937381743d7b7a85df.png)" :db/ensure [:question/validate]} {:db/id 17592186124660 :knowledge-point/questions ["question-0dff1477-477e-5350-b60a-a888d8f2c5e5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124226 :question/problem "What is the range of the function $f(x) = -\\dfrac{1}{2}(x+3)(x-1)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny = a(x-x_1)(x-x_2),\n$$\n\nwith $a = -\\dfrac{1}{2} <    0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are $x_1=-3$ and $x_2=1,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-3+1}{2}=-1\\end{aligned}\n$$\n\nThen, we substitute $x=-1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}(x+3)(x-1) \\\\  & =-\\frac{1}{2}(-1+3)(-1-1) \\\\  & =-\\frac{1}{2}\\cdot 2\\cdot (-2) \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(-1,2),$ and the range of the function is $(-\\infty,2].$\n\n![](images/2f/2f949680675dd0b0347adc154b8be6ce301ddb2f5b1b9ab0c077a5c00f81568f.png)" :db/ensure [:question/validate]} {:db/id "question-df827c7e-ce3b-5b89-941a-437f86328b7a" :question/id #uuid "df827c7e-ce3b-5b89-941a-437f86328b7a" :question/math-academy-id "q-106274" :question/problem "What is the domain of the function $h(x)=8{x}^{2}-4x-1?$" :question/worked-solution "A quadratic function is defined for all real numbers.\n\nTherefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22"] :db/ensure [:question/validate]} {:db/id "answer-field-829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/id #uuid "829f5ab0-8ba8-548c-bb23-b5d76fbb4d22" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f" :answer-field/choices ["answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f" "answer-902ebbab-7478-5af7-9256-7c8f862f93a6" "answer-44c76b2d-2338-5b08-8808-f24cc8ea5181" "answer-99fd63fa-18e6-55ea-901a-0243576aa56a" "answer-537557a3-a7a3-54ed-be9a-305c2144a33d"] :db/ensure [:answer-field/validate]} {:db/id "answer-db13116f-35b5-5cb0-bb88-3f745d6dbe2f" :answer/id #uuid "db13116f-35b5-5cb0-bb88-3f745d6dbe2f" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-902ebbab-7478-5af7-9256-7c8f862f93a6" :answer/id #uuid "902ebbab-7478-5af7-9256-7c8f862f93a6" :answer/type :answer.type/math :answer/value "x\\in [-1,4]" :db/ensure [:answer/validate]} {:db/id "answer-44c76b2d-2338-5b08-8808-f24cc8ea5181" :answer/id #uuid "44c76b2d-2338-5b08-8808-f24cc8ea5181" :answer/type :answer.type/math :answer/value "x\\in [-4,8]" :db/ensure [:answer/validate]} {:db/id "answer-99fd63fa-18e6-55ea-901a-0243576aa56a" :answer/id #uuid "99fd63fa-18e6-55ea-901a-0243576aa56a" :answer/type :answer.type/math :answer/value "x\\in [-5,7]" :db/ensure [:answer/validate]} {:db/id "answer-537557a3-a7a3-54ed-be9a-305c2144a33d" :answer/id #uuid "537557a3-a7a3-54ed-be9a-305c2144a33d" :answer/type :answer.type/math :answer/value "x\\in [4,8]" :db/ensure [:answer/validate]} {:db/id "question-25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/id #uuid "25370e2a-dfa1-5d6f-b02b-964c5925c1f3" :question/math-academy-id "q-90889" :question/problem "What is the domain of the function $h(x)=\\frac{2}{3}(x+4)^{2}-6?$" :question/worked-solution "A quadratic function is defined for all real numbers.\n\nTherefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0edb58d1-dd55-5c4f-8f57-2b5ac741d819"] :db/ensure [:question/validate]} {:db/id "answer-field-0edb58d1-dd55-5c4f-8f57-2b5ac741d819" :answer-field/id #uuid "0edb58d1-dd55-5c4f-8f57-2b5ac741d819" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6136aeb0-f1bb-5fc6-b66f-a1a71f228427" :answer-field/choices ["answer-e832c5ea-c832-5188-9d8f-021d53729ba6" "answer-8531488d-d9b5-5125-95de-79bdf7e5e0d8" "answer-a08ee424-2ded-5b4f-a236-b6aa77b0cbec" "answer-b53765b8-081b-5c81-b804-c9203ccfbed5" "answer-6136aeb0-f1bb-5fc6-b66f-a1a71f228427"] :db/ensure [:answer-field/validate]} {:db/id "answer-e832c5ea-c832-5188-9d8f-021d53729ba6" :answer/id #uuid "e832c5ea-c832-5188-9d8f-021d53729ba6" :answer/type :answer.type/math :answer/value "x\\in (-4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-8531488d-d9b5-5125-95de-79bdf7e5e0d8" :answer/id #uuid "8531488d-d9b5-5125-95de-79bdf7e5e0d8" :answer/type :answer.type/math :answer/value "x\\in (-6,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a08ee424-2ded-5b4f-a236-b6aa77b0cbec" :answer/id #uuid "a08ee424-2ded-5b4f-a236-b6aa77b0cbec" :answer/type :answer.type/math :answer/value "x\\in (-7,-1)" :db/ensure [:answer/validate]} {:db/id "answer-b53765b8-081b-5c81-b804-c9203ccfbed5" :answer/id #uuid "b53765b8-081b-5c81-b804-c9203ccfbed5" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-4)" :db/ensure [:answer/validate]} {:db/id "answer-6136aeb0-f1bb-5fc6-b66f-a1a71f228427" :answer/id #uuid "6136aeb0-f1bb-5fc6-b66f-a1a71f228427" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/id #uuid "0bc8d353-4f35-531e-9326-d4dcbc01bbdb" :question/math-academy-id "q-35908" :question/problem "What is the range of the function $y=f(x)=(x-1)^{2}-3?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=1$ and $k=-3,$ the vertex is $(1,-3).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output. \n\nTherefore, the range is $[-3,\\infty ).$\n\nThe corresponding diagram is shown below.\n\n![](images/26/265532f4f4726151444ed873b875fc62c3c32a690a0ac859a318e2d4dc8fd285.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d506de6d-4e6d-5568-a53f-79ffc50374e1"] :db/ensure [:question/validate]} {:db/id "answer-field-d506de6d-4e6d-5568-a53f-79ffc50374e1" :answer-field/id #uuid "d506de6d-4e6d-5568-a53f-79ffc50374e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer-field/choices ["answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" "answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" "answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" "answer-17490e92-f04a-51f7-b438-199eeb712801" "answer-f856d9c9-25b2-55b1-83a5-4041c1afdc91"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/id #uuid "c5d59e6e-34b2-5e9c-b08e-8f2105c0bb6e" :answer/type :answer.type/math :answer/value "(-\\infty ,3]" :db/ensure [:answer/validate]} {:db/id "answer-8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/id #uuid "8e98df84-9ac6-56f7-ab33-a824ee4007cd" :answer/type :answer.type/math :answer/value "(-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/id #uuid "ec8b8a2d-5b31-5cfd-aa2c-e0f8c2791516" :answer/type :answer.type/math :answer/value "[-3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-17490e92-f04a-51f7-b438-199eeb712801" :answer/id #uuid "17490e92-f04a-51f7-b438-199eeb712801" :answer/type :answer.type/math :answer/value "[0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-f856d9c9-25b2-55b1-83a5-4041c1afdc91" :answer/id #uuid "f856d9c9-25b2-55b1-83a5-4041c1afdc91" :answer/type :answer.type/math :answer/value "[3,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-9acd8689-6770-5d1b-9670-f2ff78d7e31a" :question/id #uuid "9acd8689-6770-5d1b-9670-f2ff78d7e31a" :question/math-academy-id "q-106278" :question/problem "What is the range of the function $f(x)=(x-4)^{2}+19?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=4$ and $k=19,$ the vertex is $(4,19).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output.\n\nTherefore, the range is $[19,\\infty ).$\n\n![](images/7f/7fbc9dc7839e439967d6f9f50e25d561ff7be8211b899c83ff269b019b4c61c5.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c611b6bd-39c2-5cd3-a50d-868b00e1145e"] :db/ensure [:question/validate]} {:db/id "answer-field-c611b6bd-39c2-5cd3-a50d-868b00e1145e" :answer-field/id #uuid "c611b6bd-39c2-5cd3-a50d-868b00e1145e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2fe99722-e163-5bb2-a90e-59a16c64cfd2" :answer-field/choices ["answer-41940498-39d4-5882-b1c4-e50157d147e4" "answer-a3036565-aed3-5af5-ba9a-54116f9b35c0" "answer-29049f46-2a3c-530f-bf65-510e941c269a" "answer-2fe99722-e163-5bb2-a90e-59a16c64cfd2" "answer-3eab0845-8b32-5998-9064-38cb5fecb9fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-41940498-39d4-5882-b1c4-e50157d147e4" :answer/id #uuid "41940498-39d4-5882-b1c4-e50157d147e4" :answer/type :answer.type/math :answer/value "(\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a3036565-aed3-5af5-ba9a-54116f9b35c0" :answer/id #uuid "a3036565-aed3-5af5-ba9a-54116f9b35c0" :answer/type :answer.type/math :answer/value "[-19,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-29049f46-2a3c-530f-bf65-510e941c269a" :answer/id #uuid "29049f46-2a3c-530f-bf65-510e941c269a" :answer/type :answer.type/math :answer/value "[-4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-2fe99722-e163-5bb2-a90e-59a16c64cfd2" :answer/id #uuid "2fe99722-e163-5bb2-a90e-59a16c64cfd2" :answer/type :answer.type/math :answer/value "[19,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-3eab0845-8b32-5998-9064-38cb5fecb9fb" :answer/id #uuid "3eab0845-8b32-5998-9064-38cb5fecb9fb" :answer/type :answer.type/math :answer/value "[4,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-c749b226-6df0-583d-9d39-da82636ab3b6" :question/id #uuid "c749b226-6df0-583d-9d39-da82636ab3b6" :question/math-academy-id "q-90975" :question/problem "What is the range of the function $f(x)={x}^{2}+1?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=1>0,$ $b=0,$ and $c=1.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{0}{2\\cdot 1}=0.\n$$\n\nNow, we substitute $x=0$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}+1 \\\\  & =(0)^{2}+1 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(0,1),$ and the range of the function is $[1,\\infty ).$\n\n![](images/0a/0a0bb7cbd5494106b36e85f4b9f2604153d28623883c33f507e1ef36389999c4.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8696ee0d-200e-5d5f-b4a1-875cd5516de8"] :db/ensure [:question/validate]} {:db/id "answer-field-8696ee0d-200e-5d5f-b4a1-875cd5516de8" :answer-field/id #uuid "8696ee0d-200e-5d5f-b4a1-875cd5516de8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28ae418f-d853-574e-aad6-2711015f76d1" :answer-field/choices ["answer-f8afb740-92b1-5a27-9a61-bb974a1e4d6f" "answer-720e13e8-4fcd-54db-bf77-f1e56dad5e3c" "answer-d04a0586-14b1-51f8-9ee4-74197f142b62" "answer-3342ac6c-a5ac-505a-9057-009d9aaad1b1" "answer-28ae418f-d853-574e-aad6-2711015f76d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8afb740-92b1-5a27-9a61-bb974a1e4d6f" :answer/id #uuid "f8afb740-92b1-5a27-9a61-bb974a1e4d6f" :answer/type :answer.type/math :answer/value "(-\\infty ,0]" :db/ensure [:answer/validate]} {:db/id "answer-720e13e8-4fcd-54db-bf77-f1e56dad5e3c" :answer/id #uuid "720e13e8-4fcd-54db-bf77-f1e56dad5e3c" :answer/type :answer.type/math :answer/value "(-\\infty ,1]" :db/ensure [:answer/validate]} {:db/id "answer-d04a0586-14b1-51f8-9ee4-74197f142b62" :answer/id #uuid "d04a0586-14b1-51f8-9ee4-74197f142b62" :answer/type :answer.type/math :answer/value "[-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-3342ac6c-a5ac-505a-9057-009d9aaad1b1" :answer/id #uuid "3342ac6c-a5ac-505a-9057-009d9aaad1b1" :answer/type :answer.type/math :answer/value "[0,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-28ae418f-d853-574e-aad6-2711015f76d1" :answer/id #uuid "28ae418f-d853-574e-aad6-2711015f76d1" :answer/type :answer.type/math :answer/value "[1,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0eda0ab3-fc3e-57ae-8050-823c01afb804" :question/id #uuid "0eda0ab3-fc3e-57ae-8050-823c01afb804" :question/math-academy-id "q-250634" :question/problem "Find the range of the function $f(x)={x}^{2}-6x+10.$\n\n{{field-1}}{{field-2}}\n$f(x)<$\n{{field-3}}" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=1>0,$ $b=-6,$ and $c=10.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-6)}{2\\cdot 1}=3.\n$$\n\nNow, we substitute $x=3$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x+10 \\\\  & =(3)^{2}-6(3)+10 \\\\  & =9-18+10 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is $(3,1),$ and the range of the function is $[1,\\infty ),$ i.e. $1\\le f(x)<\\infty .$\n\n![](images/4a/4abd9af6ea0eb83d2c99e4d02e67b09c27ea67576d0d006dbad56dff7f1d3e0e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-075d541c-fade-5cf1-b19a-7100801cc012" "answer-field-803ac4f9-cd71-5a22-b15d-05e1685e5d11" "answer-field-acac96dd-45f5-5370-b462-a995486d4f4b"] :db/ensure [:question/validate]} {:db/id "answer-field-075d541c-fade-5cf1-b19a-7100801cc012" :answer-field/id #uuid "075d541c-fade-5cf1-b19a-7100801cc012" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9ed33f15-c341-5c1d-87a3-f45c1af216cd" :answer-field/choices ["answer-9ed33f15-c341-5c1d-87a3-f45c1af216cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ed33f15-c341-5c1d-87a3-f45c1af216cd" :answer/id #uuid "9ed33f15-c341-5c1d-87a3-f45c1af216cd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-803ac4f9-cd71-5a22-b15d-05e1685e5d11" :answer-field/id #uuid "803ac4f9-cd71-5a22-b15d-05e1685e5d11" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-41b3f64d-78f1-5eab-926d-72594aa2a9d6" :answer-field/choices ["answer-41b3f64d-78f1-5eab-926d-72594aa2a9d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-41b3f64d-78f1-5eab-926d-72594aa2a9d6" :answer/id #uuid "41b3f64d-78f1-5eab-926d-72594aa2a9d6" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-acac96dd-45f5-5370-b462-a995486d4f4b" :answer-field/id #uuid "acac96dd-45f5-5370-b462-a995486d4f4b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-594221c2-ecdd-5e14-b646-47c1685bd2e6" :answer-field/choices ["answer-594221c2-ecdd-5e14-b646-47c1685bd2e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-594221c2-ecdd-5e14-b646-47c1685bd2e6" :answer/id #uuid "594221c2-ecdd-5e14-b646-47c1685bd2e6" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-7dfd6f87-7029-50ed-aece-aeae8cb98e8c" :question/id #uuid "7dfd6f87-7029-50ed-aece-aeae8cb98e8c" :question/math-academy-id "q-90974" :question/problem "What is the range of the function $f(x)=2{x}^{2}-4x+4?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=2>0,$ $b=-4,$ and $c=4.$\n\nBecause the leading coefficient is positive, the parabola opens upward. Consequently, there is no maximum output, and the vertex corresponds to the minimum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-4)}{2\\cdot 2}=1.\n$$\n\nNow, we substitute $x=1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =2{x}^{2}-4x+4 \\\\  & =2(1)^{2}-4(1)+4 \\\\  & =2-4+4 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the vertex is $(1,2),$ and the range of the function is $[2,\\infty ).$\n\n![](images/5f/5f98a1b646aeab2a8a0f0a04014abb0a0a88794d88c880fb771d5f2f65afa4e7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e08c3295-f9df-5c3a-b174-e94cf74e7e80"] :db/ensure [:question/validate]} {:db/id "answer-field-e08c3295-f9df-5c3a-b174-e94cf74e7e80" :answer-field/id #uuid "e08c3295-f9df-5c3a-b174-e94cf74e7e80" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9161c4d2-6ea4-54cf-a2fe-2e259b367b91" :answer-field/choices ["answer-3e2093c6-2b2c-500f-98e9-b4721e5beec3" "answer-fd46e073-fb43-5ced-b1cf-cfe1b42cac05" "answer-d00a9a87-81df-5892-9a04-4acd79ba07cd" "answer-7b0ef493-f727-5a5a-ad20-3c6dd0a77f56" "answer-9161c4d2-6ea4-54cf-a2fe-2e259b367b91"] :db/ensure [:answer-field/validate]} {:db/id "answer-3e2093c6-2b2c-500f-98e9-b4721e5beec3" :answer/id #uuid "3e2093c6-2b2c-500f-98e9-b4721e5beec3" :answer/type :answer.type/math :answer/value "(-\\infty ,1]" :db/ensure [:answer/validate]} {:db/id "answer-fd46e073-fb43-5ced-b1cf-cfe1b42cac05" :answer/id #uuid "fd46e073-fb43-5ced-b1cf-cfe1b42cac05" :answer/type :answer.type/math :answer/value "(-\\infty ,2]" :db/ensure [:answer/validate]} {:db/id "answer-d00a9a87-81df-5892-9a04-4acd79ba07cd" :answer/id #uuid "d00a9a87-81df-5892-9a04-4acd79ba07cd" :answer/type :answer.type/math :answer/value "[-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-7b0ef493-f727-5a5a-ad20-3c6dd0a77f56" :answer/id #uuid "7b0ef493-f727-5a5a-ad20-3c6dd0a77f56" :answer/type :answer.type/math :answer/value "[1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-9161c4d2-6ea4-54cf-a2fe-2e259b367b91" :answer/id #uuid "9161c4d2-6ea4-54cf-a2fe-2e259b367b91" :answer/type :answer.type/math :answer/value "[2,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-28ef6032-c464-5039-b5ee-d8d9a6314099" :question/id #uuid "28ef6032-c464-5039-b5ee-d8d9a6314099" :question/math-academy-id "q-90971" :question/problem "What is the range of the function $f(x)=-3{x}^{2}-12x-17?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=-3<0,$ $b=-12,$ and $c=-17.$\n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-12)}{2\\cdot (-3)}=-2.\n$$\n\nNow, we substitute $x=-2$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-3{x}^{2}-12x-17 \\\\  & =-3(-2)^{2}-12(-2)-17 \\\\  & =-12+24-17 \\\\  & =-5\\end{aligned}\n$$\n\nTherefore, the vertex is $(-2,-5),$ and the range of the function is $(-\\infty ,-5].$\n\n![](images/3c/3c62a8826f68c3c36db191769fc23907ca6c64986bc1f47b5a7b21b2b97a91f2.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8165ca3e-61b4-511c-85ae-206dd344dfff"] :db/ensure [:question/validate]} {:db/id "answer-field-8165ca3e-61b4-511c-85ae-206dd344dfff" :answer-field/id #uuid "8165ca3e-61b4-511c-85ae-206dd344dfff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db1049ca-7810-58af-93e6-7692d67f375f" :answer-field/choices ["answer-92b03c74-a465-57e8-aecb-79f01c72bb95" "answer-db1049ca-7810-58af-93e6-7692d67f375f" "answer-95804488-6e33-5c77-b393-9d6514ac1222" "answer-904523c9-842b-5cc2-95e9-7717ebb39188" "answer-766fca55-c0be-56b2-9f2f-ef654ccd9f83"] :db/ensure [:answer-field/validate]} {:db/id "answer-92b03c74-a465-57e8-aecb-79f01c72bb95" :answer/id #uuid "92b03c74-a465-57e8-aecb-79f01c72bb95" :answer/type :answer.type/math :answer/value "(-\\infty ,-2]" :db/ensure [:answer/validate]} {:db/id "answer-db1049ca-7810-58af-93e6-7692d67f375f" :answer/id #uuid "db1049ca-7810-58af-93e6-7692d67f375f" :answer/type :answer.type/math :answer/value "(-\\infty ,-5]" :db/ensure [:answer/validate]} {:db/id "answer-95804488-6e33-5c77-b393-9d6514ac1222" :answer/id #uuid "95804488-6e33-5c77-b393-9d6514ac1222" :answer/type :answer.type/math :answer/value "(-\\infty ,5]" :db/ensure [:answer/validate]} {:db/id "answer-904523c9-842b-5cc2-95e9-7717ebb39188" :answer/id #uuid "904523c9-842b-5cc2-95e9-7717ebb39188" :answer/type :answer.type/math :answer/value "[-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-766fca55-c0be-56b2-9f2f-ef654ccd9f83" :answer/id #uuid "766fca55-c0be-56b2-9f2f-ef654ccd9f83" :answer/type :answer.type/math :answer/value "[-5,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186124875 :question/problem "What is the range of the function $f(x)=-\\frac{1}{3}(x+2)(x-2)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-\\frac{1}{3}<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-2$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-2+2}{2}=0\\end{aligned}\n$$\n\nThen, we substitute $x=0$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-\\frac{1}{3}(x+2)(x-2) \\\\  & =-\\frac{1}{3}(0+2)(0-2) \\\\  & =-\\frac{1}{3}\\cdot 2\\cdot (-2) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the vertex is $(0,\\frac{4}{3}),$ and the range of the function is $(-\\infty ,\\frac{4}{3}].$\n\n![](images/d9/d9c96e13ab078005333cdf02d8939c96d41fe6802b7f4caf0d4bab041cf8a314.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186121850 :answer-field/correct "answer-9f1dd293-3094-5184-81d3-8f43b189007b" :answer-field/choices ["answer-3d610a34-2b2c-5b7f-a6ee-1208ff230466" "answer-5d61e674-449f-5c1e-8470-6d7a912ecbd3" "answer-9f1dd293-3094-5184-81d3-8f43b189007b" "answer-f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" "answer-0df9a543-b5df-589d-9923-b17fb9588714"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d610a34-2b2c-5b7f-a6ee-1208ff230466" :answer/id #uuid "3d610a34-2b2c-5b7f-a6ee-1208ff230466" :answer/type :answer.type/math :answer/value "(-\\infty ,-\\frac{4}{3}]" :db/ensure [:answer/validate]} {:db/id "answer-5d61e674-449f-5c1e-8470-6d7a912ecbd3" :answer/id #uuid "5d61e674-449f-5c1e-8470-6d7a912ecbd3" :answer/type :answer.type/math :answer/value "(-\\infty ,\\frac{1}{3}]" :db/ensure [:answer/validate]} {:db/id "answer-9f1dd293-3094-5184-81d3-8f43b189007b" :answer/id #uuid "9f1dd293-3094-5184-81d3-8f43b189007b" :answer/type :answer.type/math :answer/value "(-\\infty ,\\frac{4}{3}]" :db/ensure [:answer/validate]} {:db/id "answer-f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" :answer/id #uuid "f1f407d3-59e6-5e5d-8e6f-2e775ce3251f" :answer/type :answer.type/math :answer/value "[-\\frac{4}{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-0df9a543-b5df-589d-9923-b17fb9588714" :answer/id #uuid "0df9a543-b5df-589d-9923-b17fb9588714" :answer/type :answer.type/math :answer/value "[\\frac{4}{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-0dff1477-477e-5350-b60a-a888d8f2c5e5" :question/id #uuid "0dff1477-477e-5350-b60a-a888d8f2c5e5" :question/math-academy-id "q-250654" :question/problem "Find the range of the function $f(x)=-2(x+1)(x-3).$\n\n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-2<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=-1$ and ${x}_{2}=3,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{-1+3}{2}=1\\end{aligned}\n$$\n\nThen, we substitute $x=1$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-2(x+1)(x-3) \\\\  & =-2(1+1)(1-3) \\\\  & =-2\\cdot 2\\cdot (-2) \\\\  & =8\\end{aligned}\n$$\n\nTherefore, the vertex is $(1,8),$ and the range of the function is $(-\\infty ,8],$ i.e. $-\\infty <f(x)\\le 8.$\n\n![](images/a9/a9c15f73f41c2c58fdbc05eceb3031edfb6f04f12db9fa54450f6445b196d1df.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-79b5b98c-0fd7-5995-adf9-a282e1a404ce" "answer-field-b0e9531b-078f-5214-834b-c186b772332a" "answer-field-cf674f86-ce4f-5339-bbdc-9070efb2a858"] :db/ensure [:question/validate]} {:db/id "answer-field-79b5b98c-0fd7-5995-adf9-a282e1a404ce" :answer-field/id #uuid "79b5b98c-0fd7-5995-adf9-a282e1a404ce" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1a29102e-cd54-52b0-9d03-2b418b6486b4" :answer-field/choices ["answer-1a29102e-cd54-52b0-9d03-2b418b6486b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a29102e-cd54-52b0-9d03-2b418b6486b4" :answer/id #uuid "1a29102e-cd54-52b0-9d03-2b418b6486b4" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-field-b0e9531b-078f-5214-834b-c186b772332a" :answer-field/id #uuid "b0e9531b-078f-5214-834b-c186b772332a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5bf95fec-06ee-5b1d-a62b-b525767e3bf4" :answer-field/choices ["answer-5bf95fec-06ee-5b1d-a62b-b525767e3bf4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bf95fec-06ee-5b1d-a62b-b525767e3bf4" :answer/id #uuid "5bf95fec-06ee-5b1d-a62b-b525767e3bf4" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-cf674f86-ce4f-5339-bbdc-9070efb2a858" :answer-field/id #uuid "cf674f86-ce4f-5339-bbdc-9070efb2a858" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c9413317-cd36-56a0-b590-2ecf59608bbc" :answer-field/choices ["answer-c9413317-cd36-56a0-b590-2ecf59608bbc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c9413317-cd36-56a0-b590-2ecf59608bbc" :answer/id #uuid "c9413317-cd36-56a0-b590-2ecf59608bbc" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186125716 :tutorial/content "In this lesson, we will discuss the properties of quadratic functions. Specifically, we learn how to determine the domain and range of a quadratic function.\n\nRemember that a quadratic function takes the form\n\n$$\nf(x) = ax^2 + bx + c,\n$$\n\nwhere $a,b,$ and $c$ are constants.\n\nThe first thing to note is that the domain of *any* quadratic function is $x\\in (-\\infty, \\infty)$ because it is defined for all values of $x.$\n\nDetermining the range of a quadratic function is slightly more involved, as we'll see shortly." :db/ensure [:tutorial/validate]} {:db/id 17592186125846 :tutorial/content "The range of a quadratic function depends on the direction in which its graph opens. Regardless of whether the equation is written in standard form,\n\n$$\ny = ax^2 + bx + c,\n$$\n\nvertex form, \n\n$$\ny = a(x-h)^2 + k,\n$$\n\nor factored form,\n\n$$\ny = a(x-x_1)(x-x_2),\n$$\n\nit opens upwards if the leading coefficient $a$ is positive and downwards if $a$ is negative.\n\nNow, consider a parabola that opens upwards ($a>0$). In this case, the minimum output corresponds to the $y$-coordinate of the vertex, while there is no maximum output. Therefore, if the vertex is $(h,k),$ then the range is $y \\geq k.$\n\nFor example, in the graph below, the $y$-value of the vertex is $y=-2$, so the range of the function is $y \\geq -2.$\n\n![](images/ac/ac254aaa0bdab2999e07c46f82becd37fb4b8ee6e816ad91842d6e750eb90b86.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186125717 :tutorial/content "Now consider a parabola that opens downwards ($a<0$). In this case, there is no minimum output, but the maximum output corresponds to the $y$-coordinate of the vertex. Therefore, if the vertex is $(h,k),$ then the range is $y \\leq k.$\n\nFor example, in the graph below, the $y$-value of the vertex is $y=2$, so the range of the function is $y \\leq 2.$\n\n![](images/e4/e4390b9cec5d5fce67691421479151be3592967f95d22ddde307c6d56c630879.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186124689 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id 17592186221443 :knowledge-point/questions ["question-903d90ff-4e96-59f7-912a-24572f1e9b78" "question-fb364528-cf72-5941-b3b8-fc021ca9ace0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186221444 :knowledge-point/questions ["question-bc08f5e3-6f0e-55df-87af-7552a06bb9df"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186221445 :knowledge-point/questions ["question-14280c74-af6e-5d18-9712-69501b60ddc5" "question-e5dc675f-f1b9-58e9-a567-64d8cd60aaaf" "question-8c3f231c-8d0c-511e-b4f9-0d81c5e6659f" "question-46598e7e-81d3-578b-80cc-94d59f9707e8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-903d90ff-4e96-59f7-912a-24572f1e9b78" :question/id #uuid "903d90ff-4e96-59f7-912a-24572f1e9b78" :question/math-academy-id "q-341780" :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x\\in R.$\nSelect the correct options in the reasoning below.\n\nThe Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡({{field-1}})+{b}_{n}\\operatorname{sin}⁡({{field-2}}).\n$$\n\nThe $7$th sine coefficient of the series is\n\n$$\n{b}_{7}={{field-3}}.\n$$\n\nGiven that $F(x)=x$ and $L=2\\pi ,$ the $7$th sine coefficient becomes\n\n$$\n{b}_{7}={{field-4}}\\,\\cdot \\,{{field-5}}.\n$$" :question/worked-solution "Recall that multiplying the argument of a function by $k\\ne 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\frac{1}{k}.$\n\nNow, let $s=\\frac{\\pi }{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s)=f(\\frac{L}{\\pi }s)\n$$\n\nmust have a period of $2L\\cdot \\frac{\\pi }{L}=2\\pi .$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(ns)+{b}_{n}\\operatorname{sin}⁡(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\frac{\\pi }{L}x$ and using the fact that $g(s)=f(\\frac{L}{\\pi }s),$ we get the Fourier series of $f(x):$\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\n$$\n\nTherefore, $7$th sine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{b}_{7} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(7s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{sin}⁡(7s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{sin}⁡(7\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{7\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{7\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=2\\pi $ and $f(x)=x,$ we get\n\n$$\n\\begin{aligned}{b}_{7} & =\\frac{1}{2\\pi }{\\int }_{-\\pi }^{\\pi }x\\operatorname{sin}⁡(\\frac{7\\pi }{2\\pi }x)\\,\\text{d}x \\\\  & =\\frac{1}{2\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }x\\operatorname{sin}⁡(\\frac{7}{2}x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-805880d3-7d18-5740-8087-2ae8c15c331c" "answer-field-1ef4925b-0108-5329-895d-9d6319c347a7" "answer-field-d643ff56-169f-53e0-bd8e-d426b4ad8ecf" "answer-field-1d4c8fc9-3a29-5bfd-917e-d1711fd26d74" "answer-field-5d9a9574-0239-56b9-b74c-601d7849c71e"] :db/ensure [:question/validate]} {:db/id "answer-field-805880d3-7d18-5740-8087-2ae8c15c331c" :answer-field/id #uuid "805880d3-7d18-5740-8087-2ae8c15c331c" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-81e348bd-fe6e-5550-9ceb-6c