 :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-bd4313e4-396a-522f-ac91-2fe946177c85" :answer-field/choices ["answer-301c2ad4-c129-5368-a4e7-f5b0d56d72e2" "answer-bd4313e4-396a-522f-ac91-2fe946177c85" "answer-3772f1bf-2be9-5fde-a6f3-a10daf474041" "answer-3460cb96-cb5c-51f8-8067-777cfcdc2e0c" "answer-709638e2-6f52-5672-bc08-7272530d466a" "answer-8e5f06f7-2394-5626-a339-dc35edddd589"] :db/ensure [:answer-field/validate]} {:db/id "answer-301c2ad4-c129-5368-a4e7-f5b0d56d72e2" :answer/id #uuid "301c2ad4-c129-5368-a4e7-f5b0d56d72e2" :answer/type :answer.type/math :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-bd4313e4-396a-522f-ac91-2fe946177c85" :answer/id #uuid "bd4313e4-396a-522f-ac91-2fe946177c85" :answer/type :answer.type/math :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-3772f1bf-2be9-5fde-a6f3-a10daf474041" :answer/id #uuid "3772f1bf-2be9-5fde-a6f3-a10daf474041" :answer/type :answer.type/math :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-3460cb96-cb5c-51f8-8067-777cfcdc2e0c" :answer/id #uuid "3460cb96-cb5c-51f8-8067-777cfcdc2e0c" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-709638e2-6f52-5672-bc08-7272530d466a" :answer/id #uuid "709638e2-6f52-5672-bc08-7272530d466a" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(\\frac{6L}{\\pi }x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-8e5f06f7-2394-5626-a339-dc35edddd589" :answer/id #uuid "8e5f06f7-2394-5626-a339-dc35edddd589" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(\\frac{6\\pi }{L}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-field-20357d5e-1bc8-5dd7-8db6-94cde34f7b98" :answer-field/id #uuid "20357d5e-1bc8-5dd7-8db6-94cde34f7b98" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-23e03e47-e4e8-5fca-b00b-82be453f972c" :answer-field/choices ["answer-86c4360f-61c6-544f-837f-69869e0595be" "answer-23e03e47-e4e8-5fca-b00b-82be453f972c" "answer-a678a72c-346e-543b-a426-99936f3a21b6" "answer-cb286bc5-b920-5dea-9cb5-6caae099b3e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-86c4360f-61c6-544f-837f-69869e0595be" :answer/id #uuid "86c4360f-61c6-544f-837f-69869e0595be" :answer/type :answer.type/math :answer/value "\\frac{1}{5\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-23e03e47-e4e8-5fca-b00b-82be453f972c" :answer/id #uuid "23e03e47-e4e8-5fca-b00b-82be453f972c" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-a678a72c-346e-543b-a426-99936f3a21b6" :answer/id #uuid "a678a72c-346e-543b-a426-99936f3a21b6" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-cb286bc5-b920-5dea-9cb5-6caae099b3e3" :answer/id #uuid "cb286bc5-b920-5dea-9cb5-6caae099b3e3" :answer/type :answer.type/math :answer/value "\\frac{5}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-field-f064fef8-a113-5d06-b95a-f4c517e2b24e" :answer-field/id #uuid "f064fef8-a113-5d06-b95a-f4c517e2b24e" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "answer-20a6260d-a64c-5771-b68c-fd4b972f15c7" :answer-field/choices ["answer-873e0942-50fd-5a7c-91e2-3b1957f1bed0" "answer-20a6260d-a64c-5771-b68c-fd4b972f15c7" "answer-23121dd1-c0fc-5a11-a114-b71f188cf2bf" "answer-0b080894-e225-574e-b611-6de778384829" "answer-16362305-1448-5d7f-841f-42942c9f6ad0" "answer-84ff721d-5ea1-5783-b823-a370c88ce292"] :db/ensure [:answer-field/validate]} {:db/id "answer-873e0942-50fd-5a7c-91e2-3b1957f1bed0" :answer/id #uuid "873e0942-50fd-5a7c-91e2-3b1957f1bed0" :answer/type :answer.type/math :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-20a6260d-a64c-5771-b68c-fd4b972f15c7" :answer/id #uuid "20a6260d-a64c-5771-b68c-fd4b972f15c7" :answer/type :answer.type/math :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{cos}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-23121dd1-c0fc-5a11-a114-b71f188cf2bf" :answer/id #uuid "23121dd1-c0fc-5a11-a114-b71f188cf2bf" :answer/type :answer.type/math :answer/value "{\\int }_{-5}^{5}{e}^{-{x}^{2}}\\operatorname{sin}⁡(\\frac{6\\pi }{5}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-0b080894-e225-574e-b611-6de778384829" :answer/id #uuid "0b080894-e225-574e-b611-6de778384829" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{e}^{-{x}^{2}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-16362305-1448-5d7f-841f-42942c9f6ad0" :answer/id #uuid "16362305-1448-5d7f-841f-42942c9f6ad0" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{e}^{-{x}^{2}}\\operatorname{cos}⁡(6x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-84ff721d-5ea1-5783-b823-a370c88ce292" :answer/id #uuid "84ff721d-5ea1-5783-b823-a370c88ce292" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{e}^{-{x}^{2}}\\operatorname{sin}⁡(6x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-bc08f5e3-6f0e-55df-87af-7552a06bb9df" :question/id #uuid "bc08f5e3-6f0e-55df-87af-7552a06bb9df" :question/math-academy-id "q-341802" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nLet $F(x)=-3x+3$ for $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=-3x+3$ for $x\\in [-2,2).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{2}{\\int }_{-2}^{2}(-3x+3)\\,\\text{d}x \\\\  & =\\frac{1}{2}{[-\\frac{3}{2}{x}^{2}+3x]}_{-2}^{2} \\\\  & =\\frac{1}{2}((-\\frac{3}{2}\\cdot {2}^{2}+3\\cdot 2)-(-\\frac{3}{2}\\cdot (-2)^{2}+3\\cdot (-2))) \\\\  & =\\frac{1}{2}(0-(-12)) \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b3e4d068-52a7-54b2-9f52-ab0c0b143b6e"] :db/ensure [:question/validate]} {:db/id "answer-field-b3e4d068-52a7-54b2-9f52-ab0c0b143b6e" :answer-field/id #uuid "b3e4d068-52a7-54b2-9f52-ab0c0b143b6e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1f47cc34-1a40-54f8-8f21-1937b1207c8c" :answer-field/choices ["answer-1f47cc34-1a40-54f8-8f21-1937b1207c8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f47cc34-1a40-54f8-8f21-1937b1207c8c" :answer/id #uuid "1f47cc34-1a40-54f8-8f21-1937b1207c8c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-14280c74-af6e-5d18-9712-69501b60ddc5" :question/id #uuid "14280c74-af6e-5d18-9712-69501b60ddc5" :question/math-academy-id "q-341830" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n}{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n}{2}x)\n$$\n\nThe Fourier series of the $4\\pi $-periodic extension $f(x)$ of the function \n\n$$\nF(x)=\\{\\begin{aligned}5, & x\\in [0,2\\pi ) \\\\ -2, & x\\in [-2\\pi ,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${b}_{3}.$\n\n${b}_{3}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2\\pi .$ Also, $f(x)=5$ for $x\\in [0,2\\pi )$ and $f(x)=-2$ for $x\\in [-2\\pi ,0).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{b}_{3} & =\\frac{1}{2\\pi }{\\int }_{-2\\pi }^{2\\pi }f(x)\\operatorname{sin}⁡(\\frac{3}{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2\\pi }{\\int }_{-2\\pi }^{0}(-2)\\operatorname{sin}⁡(\\frac{3}{2}x)\\,\\text{d}x+\\frac{1}{2\\pi }{\\int }_{0}^{2\\pi }5\\operatorname{sin}⁡(\\frac{3}{2}x)\\,\\text{d}x \\\\  & =-\\frac{2}{2\\pi }\\cdot (-\\frac{2}{3}){[\\operatorname{cos}⁡(\\frac{3}{2}x)]}_{-2\\pi }^{0}+\\frac{5}{2\\pi }\\cdot (-\\frac{2}{3}){[\\operatorname{cos}⁡(\\frac{3}{2}x)]}_{0}^{2\\pi } \\\\  & =\\frac{2}{3\\pi }(\\operatorname{cos}⁡(0)-\\operatorname{cos}⁡(-3\\pi ))-\\frac{5}{3\\pi }(\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{3\\pi }(1-(-1))-\\frac{5}{3\\pi }((-1)-1) \\\\  & =\\frac{4}{3\\pi }+\\frac{10}{3\\pi } \\\\  & =\\frac{14}{3\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-50ebbed4-eb9c-5659-8b8c-f37f72666390"] :db/ensure [:question/validate]} {:db/id "answer-field-50ebbed4-eb9c-5659-8b8c-f37f72666390" :answer-field/id #uuid "50ebbed4-eb9c-5659-8b8c-f37f72666390" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f308dd20-f66e-5ffb-861b-4ab8333e47b2" :answer-field/choices ["answer-f308dd20-f66e-5ffb-861b-4ab8333e47b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-f308dd20-f66e-5ffb-861b-4ab8333e47b2" :answer/id #uuid "f308dd20-f66e-5ffb-861b-4ab8333e47b2" :answer/type :answer.type/math :answer/value "\\frac{14}{3\\pi}" :db/ensure [:answer/validate]} {:db/id "question-e5dc675f-f1b9-58e9-a567-64d8cd60aaaf" :question/id #uuid "e5dc675f-f1b9-58e9-a567-64d8cd60aaaf" :question/math-academy-id "q-341873" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{3}x)\n$$\n\nLet $F(x)=2x+7$ for $x\\in [-3,3).$ The Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{1}.$\n\n${a}_{1}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3$ and $f(x)=2x+7$ for $x\\in [-3,3).$ So, substituting into the formula, we get\n\n$$\n{a}_{1}=\\frac{1}{3}{\\int }_{-3}^{3}(2x+7)\\operatorname{cos}⁡(\\frac{\\pi }{3}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=2x+7\\, & ⇒\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{\\pi }{3}x)\\, & ⇒\\,v=\\frac{3}{\\pi }\\operatorname{sin}⁡(\\frac{\\pi }{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{3}(uv\\,{|}_{-3}^{3}-{\\int }_{-3}^{3}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3}(\\frac{3}{\\pi }{[(2x+7)\\operatorname{sin}⁡(\\frac{\\pi }{3}x)]}_{-3}^{3}-{\\int }_{-3}^{3}\\frac{3}{\\pi }\\operatorname{sin}⁡(\\frac{\\pi }{3}x)\\cdot 2\\,\\text{d}x) \\\\  & =\\frac{1}{3}(\\frac{3}{\\pi }[13\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(-\\pi )]-\\frac{6}{\\pi }{\\int }_{-3}^{3}\\operatorname{sin}⁡(\\frac{\\pi }{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{3}(\\frac{3}{\\pi }\\cdot 0-\\frac{6}{\\pi }\\cdot (-\\frac{3}{\\pi }){[\\operatorname{cos}⁡(\\frac{\\pi }{3}x)]}_{-3}^{3}) \\\\  & =\\frac{1}{3}(\\frac{18}{{\\pi }^{2}}[\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(-\\pi )]) \\\\  & =\\frac{6}{{\\pi }^{2}}(-1-(-1)) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2afc926f-9cf1-5b4f-8748-f140b3012b4a"] :db/ensure [:question/validate]} {:db/id "answer-field-2afc926f-9cf1-5b4f-8748-f140b3012b4a" :answer-field/id #uuid "2afc926f-9cf1-5b4f-8748-f140b3012b4a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-96e025f6-a797-5f53-bd93-ef33e6a27f03" :answer-field/choices ["answer-96e025f6-a797-5f53-bd93-ef33e6a27f03"] :db/ensure [:answer-field/validate]} {:db/id "answer-96e025f6-a797-5f53-bd93-ef33e6a27f03" :answer/id #uuid "96e025f6-a797-5f53-bd93-ef33e6a27f03" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-8c3f231c-8d0c-511e-b4f9-0d81c5e6659f" :question/id #uuid "8c3f231c-8d0c-511e-b4f9-0d81c5e6659f" :question/math-academy-id "q-341863" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nLet $F(x)=x+1$ for $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{2}.$\n\n${a}_{2}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=x+1$ for $x\\in [-2,2).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{2}{\\int }_{-2}^{2}(x+1)\\operatorname{cos}⁡(\\frac{2\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{2}(x+1)\\operatorname{cos}⁡(\\pi x)\\,\\text{d}x\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x+1\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\pi x)\\, & ⇒\\,v=\\frac{1}{\\pi }\\operatorname{sin}⁡(\\pi x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{2}(uv\\,{|}_{-2}^{2}-{\\int }_{-2}^{2}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{1}{\\pi }{[(x+1)\\operatorname{sin}⁡(\\pi x)]}_{-2}^{2}-{\\int }_{-2}^{2}\\frac{1}{\\pi }\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{1}{\\pi }[3\\operatorname{sin}⁡(2\\pi )-(-1)\\operatorname{sin}⁡(-2\\pi )]-\\frac{1}{\\pi }\\cdot (-\\frac{1}{\\pi }){[\\operatorname{cos}⁡(\\pi x)]}_{-2}^{2}) \\\\  & =\\frac{1}{2}(\\frac{1}{\\pi }\\cdot 0+\\frac{1}{{\\pi }^{2}}[\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(-2\\pi )]) \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{{\\pi }^{2}}(1-1) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a7ebfbb0-eafe-5de9-be9a-5eb3748e9483"] :db/ensure [:question/validate]} {:db/id "answer-field-a7ebfbb0-eafe-5de9-be9a-5eb3748e9483" :answer-field/id #uuid "a7ebfbb0-eafe-5de9-be9a-5eb3748e9483" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-88ed5bbc-d47f-5994-8b20-ac726fec6a85" :answer-field/choices ["answer-88ed5bbc-d47f-5994-8b20-ac726fec6a85"] :db/ensure [:answer-field/validate]} {:db/id "answer-88ed5bbc-d47f-5994-8b20-ac726fec6a85" :answer/id #uuid "88ed5bbc-d47f-5994-8b20-ac726fec6a85" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-46598e7e-81d3-578b-80cc-94d59f9707e8" :question/id #uuid "46598e7e-81d3-578b-80cc-94d59f9707e8" :question/math-academy-id "q-341861" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)\n$$\n\nLet $F(x)=-4x$ for $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{2}.$\n\n${b}_{2}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=\\pi $ and $f(x)=-4x$ for $x\\in (-\\pi ,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{b}_{2} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }(-4x)\\operatorname{sin}⁡(\\frac{2\\pi }{\\pi }x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }(-4x)\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-4x\\, & ⇒\\,{u}^{′}=-4 \\\\ {v}^{′}=\\operatorname{sin}⁡(2x)\\, & ⇒\\,v=-\\frac{1}{2}\\operatorname{cos}⁡(2x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{2} & =\\frac{1}{\\pi }(uv\\,{|}_{-\\pi }^{\\pi }-{\\int }_{-\\pi }^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(-\\frac{1}{2}{[(-4x)\\operatorname{cos}⁡(2x)]}_{-\\pi }^{\\pi }-{\\int }_{-\\pi }^{\\pi }(-\\frac{1}{2}\\operatorname{cos}⁡(2x))(-4)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(-\\frac{1}{2}((-4\\pi )\\operatorname{cos}⁡(2\\pi )-(4\\pi )\\operatorname{cos}⁡(-2\\pi ))-2{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(2x)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(-\\frac{1}{2}((-4\\pi )\\cdot 1-(4\\pi )\\cdot 1)-2\\cdot \\frac{1}{2}{[\\operatorname{sin}⁡(2x)]}_{-\\pi }^{\\pi }) \\\\  & =\\frac{1}{\\pi }(4\\pi -(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(-2\\pi ))) \\\\  & =\\frac{1}{\\pi }\\cdot (4\\pi -0) \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6c30a88d-8e13-5d71-9185-007060f3d4e5"] :db/ensure [:question/validate]} {:db/id "answer-field-6c30a88d-8e13-5d71-9185-007060f3d4e5" :answer-field/id #uuid "6c30a88d-8e13-5d71-9185-007060f3d4e5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-824395f4-e1d3-5e0f-879c-0d03e310d7a5" :answer-field/choices ["answer-824395f4-e1d3-5e0f-879c-0d03e310d7a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-824395f4-e1d3-5e0f-879c-0d03e310d7a5" :answer/id #uuid "824395f4-e1d3-5e0f-879c-0d03e310d7a5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186124552 :knowledge-point/questions ["question-a0915342-2d27-50ea-9893-ae57d8dcc177"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a0915342-2d27-50ea-9893-ae57d8dcc177" :question/id #uuid "a0915342-2d27-50ea-9893-ae57d8dcc177" :question/math-academy-id "q-83392" :question/problem "Given that $A=[\\begin{aligned}-23 & -15 \\\\ 9 & 19\\end{aligned}],$ find the sum of the eigenvalues of $A.$" :question/worked-solution "The characteristic polynomial of $A$ is given by\n\n$$\n\\begin{aligned}p(\\lambda ) & ={\\lambda }^{2}-\\text{tr}(A)\\lambda +\\text{det}(A).\\end{aligned}\n$$\n\nNow, using Vieta's formulas, we have that the roots of $p(\\lambda ),$ i.e. the eigenvalues of $A,$ satisfy\n\n$$\n\\begin{aligned}\\{\\begin{aligned}{\\lambda }_{1}+{\\lambda }_{2}=\\text{tr}(A) \\\\ {\\lambda }_{1}\\cdot {\\lambda }_{2}=\\text{det}(A).\\end{aligned}\\end{aligned}\n$$\n\nSo, the sum of the eigenvalues of $A$ is equal to the trace of $A.$ \n\nTherefore, \n\n$$\n{\\lambda }_{1}+{\\lambda }_{2}=\\text{tr}(A)=-23+19=-4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c74d7ddb-fc22-5cce-9d10-5c29a729de7c"] :db/ensure [:question/validate]} {:db/id "answer-field-c74d7ddb-fc22-5cce-9d10-5c29a729de7c" :answer-field/id #uuid "c74d7ddb-fc22-5cce-9d10-5c29a729de7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4c890fb7-5ad0-51ee-b262-8eccfdca2316" :answer-field/choices ["answer-29518f7d-c336-5d57-8db0-9a4b5ee70722" "answer-4c890fb7-5ad0-51ee-b262-8eccfdca2316" "answer-c15f40ae-67d9-59f5-916f-7f95aad7031a" "answer-de4777f6-8208-5517-8ce8-3d1cffc8e9b6" "answer-dde652cb-50a6-5b2b-a8b3-f6fce0861332"] :db/ensure [:answer-field/validate]} {:db/id "answer-29518f7d-c336-5d57-8db0-9a4b5ee70722" :answer/id #uuid "29518f7d-c336-5d57-8db0-9a4b5ee70722" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-4c890fb7-5ad0-51ee-b262-8eccfdca2316" :answer/id #uuid "4c890fb7-5ad0-51ee-b262-8eccfdca2316" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-c15f40ae-67d9-59f5-916f-7f95aad7031a" :answer/id #uuid "c15f40ae-67d9-59f5-916f-7f95aad7031a" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-de4777f6-8208-5517-8ce8-3d1cffc8e9b6" :answer/id #uuid "de4777f6-8208-5517-8ce8-3d1cffc8e9b6" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "answer-dde652cb-50a6-5b2b-a8b3-f6fce0861332" :answer/id #uuid "dde652cb-50a6-5b2b-a8b3-f6fce0861332" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186125824 :tutorial/content "If we want to evaluate a high-degree polynomial for a given matrix input, it can take a lot of time. For example, suppose we wanted to evaluate the polynomial\n\n$$\nf(x) = x^{10} - 5x^9 - 2x^8 + x + 2\n$$\n\nfor the input ![](images/0f/0f9bff826261a956305962b4ca945ed91012cc5042e6ffe92a4b5f1ce13d3237.svg) Computing the $10$th power of this matrix would be a lot of work!\n\nLuckily, there is a way to speed up the process. The trick is to use Cayley-Hamilton theorem, which tells us that every matrix is a solution to its characteristic equation.\n\nFor the given matrix ![](images/65/6514096b22aed47005e5ff59c47e3cec701aed5b120b0022b186f1bec941d953.svg) the characteristic polynomial is\n\n$$\n\\begin{aligned}p(\\lambda ) & =\\text{det}(A-\\lambda I) \\\\  & =|\\begin{aligned}1-\\lambda  & 2 \\\\ 3 & 4-\\lambda \\end{aligned}| \\\\  & =(1-\\lambda )(4-\\lambda )-6 \\\\  & ={\\lambda }^{2}-5\\lambda -2,\\end{aligned}\n$$\n\nso the Cayley-Hamilton theorem tells us that\n\n$$\np(A) = A^2 - 5A - 2I = 0.\n$$\n\nNow, observe that the polynomial $f(x)$ can be written as\n\n$$\n\\begin{aligned}f(x) & ={x}^{10}-5{x}^{9}-2{x}^{8}+x+2 \\\\  & ={x}^{8}({x}^{2}-5x-2)+x+2 \\\\  & ={x}^{8}p(x)+x+2.\\end{aligned}\n$$\n\nThen we have\n\n$$\nf(A) = A^8 p(A) + A + 2I,\n$$\n\nand because $p(A) = 0,$ we conclude that\n\n$$\n\\begin{aligned}f(A) & ={A}^{8}\\cdot 0+A+2I \\\\  & =0+A+2I \\\\  & =A+2I.\\end{aligned}\n$$\n\nNow, the computation is much faster:\n\n$$\n\\begin{aligned}f(A) & =A+2I \\\\  & =[\\begin{aligned}1 & 2 \\\\ 3 & 4\\end{aligned}]+2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 2 \\\\ 3 & 6\\end{aligned}]\\end{aligned}\n$$\n\n**Note:** Other times, it may not be so obvious how to group the terms of $f(x)$ to reveal $p(x).$ In the general case, it's best to divide $f(x)$ by $p(x)$ using long division, and use the result\n\n$$\nf(x) = q(x) p(x) + r(x)\n$$\n\nwhere $q(x)$ is the quotient and $r(x)$ is the remainder. Let's see an example of this." :db/ensure [:tutorial/validate]} {:db/id 17592186078570 :knowledge-point/questions ["question-470997c7-250a-5a72-adc9-b7b406031a9e" "question-2ac819b8-8252-5f38-81b6-27fb48d49f54"] :db/ensure [:knowledge-point/validate]} {:db/id "question-470997c7-250a-5a72-adc9-b7b406031a9e" :question/id #uuid "470997c7-250a-5a72-adc9-b7b406031a9e" :question/math-academy-id "q-5338" :question/problem "Evaluate ${\\sum }_{n=1}^{3}5\\cdot {2}^{n-1}.$" :question/worked-solution "The sum takes integer values of $n$ from $1$ to $3.$ So, computing the terms for $n=1,2,3$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{3}5\\cdot {2}^{n-1} & =(5\\cdot {2}^{1-1})+(5\\cdot {2}^{2-1})+(5\\cdot {2}^{3-1}) \\\\  & =(5\\cdot {2}^{0})+(5\\cdot {2}^{1})+(5\\cdot {2}^{2}) \\\\  & =(5\\cdot 1)+(5\\cdot 2)+(5\\cdot 4) \\\\  & =5+10+20 \\\\  & =35.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fba6865d-0f42-54a0-ae09-88d638e07043"] :db/ensure [:question/validate]} {:db/id "answer-field-fba6865d-0f42-54a0-ae09-88d638e07043" :answer-field/id #uuid "fba6865d-0f42-54a0-ae09-88d638e07043" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ca6b6978-9f05-5362-abfd-39a4f83c9478" :answer-field/choices ["answer-1d1d49e9-52a3-5714-bf0d-4a751bb9d80a" "answer-f5d1d6c4-1fed-5c72-a347-2744da1b1c47" "answer-ca6b6978-9f05-5362-abfd-39a4f83c9478" "answer-f25dcb5d-f98e-51be-bfb1-219423934d86" "answer-e5a83e13-741b-53db-a957-67d0a0178010"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d1d49e9-52a3-5714-bf0d-4a751bb9d80a" :answer/id #uuid "1d1d49e9-52a3-5714-bf0d-4a751bb9d80a" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-f5d1d6c4-1fed-5c72-a347-2744da1b1c47" :answer/id #uuid "f5d1d6c4-1fed-5c72-a347-2744da1b1c47" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-ca6b6978-9f05-5362-abfd-39a4f83c9478" :answer/id #uuid "ca6b6978-9f05-5362-abfd-39a4f83c9478" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-f25dcb5d-f98e-51be-bfb1-219423934d86" :answer/id #uuid "f25dcb5d-f98e-51be-bfb1-219423934d86" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-e5a83e13-741b-53db-a957-67d0a0178010" :answer/id #uuid "e5a83e13-741b-53db-a957-67d0a0178010" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id 17592186078571 :knowledge-point/questions ["question-dd5db24a-0334-5fd9-a195-a6f3785eda3b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dd5db24a-0334-5fd9-a195-a6f3785eda3b" :question/id #uuid "dd5db24a-0334-5fd9-a195-a6f3785eda3b" :question/math-academy-id "q-66995" :question/problem "Express $S=8+16+24+⋯+80+88$ in sigma notation." :question/worked-solution "Notice that the terms of the corresponding sequence\n\n$$\n8,\\,16,\\,24,\\,…,\\,80,\\,88.\n$$\n\n are multiples of $8,$ and since $88÷8=11,$ there are $11$ terms in total. \n\nTherefore, the $n$th term of the sequence has the form\n\n$$\n{a}_{n}=8n,\n$$\n\nwhere $n$ ranges from $n=1$ to $n=11.$ Indeed: \n\n$$\n\\begin{aligned}{a}_{1} & =8(1)=8 \\\\ {a}_{2} & =8(2)=16 \\\\ {a}_{3} & =8(3)=24 \\\\  & \\,\\,⋮ \\\\ {a}_{10} & =8(10)=80 \\\\ {a}_{11} & =8(11)=88\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S=8+16+24+⋯+80+88={\\sum }_{n=1}^{11}8n.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-944f2e05-631f-5917-979a-ad00e83fe8a8"] :db/ensure [:question/validate]} {:db/id "answer-field-944f2e05-631f-5917-979a-ad00e83fe8a8" :answer-field/id #uuid "944f2e05-631f-5917-979a-ad00e83fe8a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-448738d9-f7ba-5faa-973c-18695727c554" :answer-field/choices ["answer-add3a4ae-8c07-5039-ba04-4c97679fbc0f" "answer-323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" "answer-6ee3a55d-76a5-5964-95de-fa24a41c09c8" "answer-4941d029-0c96-5c12-a446-5688c75f9081" "answer-448738d9-f7ba-5faa-973c-18695727c554"] :db/ensure [:answer-field/validate]} {:db/id "answer-add3a4ae-8c07-5039-ba04-4c97679fbc0f" :answer/id #uuid "add3a4ae-8c07-5039-ba04-4c97679fbc0f" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{10}8n" :db/ensure [:answer/validate]} {:db/id "answer-323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" :answer/id #uuid "323b99ba-09f2-5bc7-9d64-8e7dd6ab6344" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}(8n+8)" :db/ensure [:answer/validate]} {:db/id "answer-6ee3a55d-76a5-5964-95de-fa24a41c09c8" :answer/id #uuid "6ee3a55d-76a5-5964-95de-fa24a41c09c8" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}(8n-8)" :db/ensure [:answer/validate]} {:db/id "answer-4941d029-0c96-5c12-a446-5688c75f9081" :answer/id #uuid "4941d029-0c96-5c12-a446-5688c75f9081" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}(n+8)" :db/ensure [:answer/validate]} {:db/id "answer-448738d9-f7ba-5faa-973c-18695727c554" :answer/id #uuid "448738d9-f7ba-5faa-973c-18695727c554" :answer/type :answer.type/math :answer/value "{\\sum }_{n=1}^{11}8n" :db/ensure [:answer/validate]} {:db/id "question-2ac819b8-8252-5f38-81b6-27fb48d49f54" :question/id #uuid "2ac819b8-8252-5f38-81b6-27fb48d49f54" :question/math-academy-id "q-251017" :question/problem "Evaluate ${\\sum }_{m=2}^{5}\\frac{2m+1}{10}=${{field-1}}" :question/worked-solution "The sum takes integer values of $m$ from $2$ to $5.$ So, computing the terms for $m=2,3,4,5$ and then adding them, we get\n\n$$\n\\begin{aligned}{\\sum }_{m=2}^{5}\\frac{2m+1}{10} & =\\frac{2\\cdot 2+1}{10}+\\frac{2\\cdot 3+1}{10}+\\frac{2\\cdot 4+1}{10}+\\frac{2\\cdot 5+1}{10} \\\\  & =\\frac{5}{10}+\\frac{7}{10}+\\frac{9}{10}+\\frac{11}{10} \\\\  & =\\frac{5+7+9+11}{10} \\\\  & =\\frac{32}{10} \\\\  & =\\frac{\\cancel{2}\\cdot 16}{\\cancel{2}\\cdot 5} \\\\  & =\\frac{16}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1"] :db/ensure [:question/validate]} {:db/id "answer-field-55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/id #uuid "55d0838d-ba45-55d3-974e-0b53bb87f9c1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer-field/choices ["answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/id #uuid "e5c61a37-b0ad-558b-a7d1-6120ba4e9368" :answer/type :answer.type/math :answer/value "\\frac{16}{5}" :db/ensure [:answer/validate]} {:db/id "activity-730efb98-1f2f-5dbd-abfa-6eb2ca40c973" :activity/id #uuid "730efb98-1f2f-5dbd-abfa-6eb2ca40c973" :activity/title "Sigma Notation" :activity/type :activity.type/review :activity/scope 17592186048820 :activity/course 17592186046647 :activity/steps ["step-fffeb167-2231-519c-b231-4f453c6d3104" "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4"] :activity/first-step "step-fffeb167-2231-519c-b231-4f453c6d3104" :db/ensure [:activity/validate]} {:db/id "step-fffeb167-2231-519c-b231-4f453c6d3104" :step/id #uuid "fffeb167-2231-519c-b231-4f453c6d3104" :step/content "question-470997c7-250a-5a72-adc9-b7b406031a9e" :step/next "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :db/ensure [:step/validate]} {:db/id "step-ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/id #uuid "ba61d36f-7149-5d34-b5ba-7a9fcfac6d9d" :step/content "question-dd5db24a-0334-5fd9-a195-a6f3785eda3b" :step/next "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :db/ensure [:step/validate]} {:db/id "step-1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :step/id #uuid "1f9dc2e7-7f93-5620-ae72-7c9fa71554d4" :step/content "question-2ac819b8-8252-5f38-81b6-27fb48d49f54" :db/ensure [:step/validate]} {:db/id 17592186119968 :knowledge-point/questions ["question-0f78e83e-c080-5c56-8a40-9938a1632481" "question-11a66deb-d8c3-5e00-97b4-215e597d7249"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0f78e83e-c080-5c56-8a40-9938a1632481" :question/id #uuid "0f78e83e-c080-5c56-8a40-9938a1632481" :question/math-academy-id "q-345102" :question/problem "A series RCL circuit has a source electromotive force (EMF) of $9\\,\\text{V},$ a resistance of $45\\,Ω,$ a capacitance of $0.01\\,\\text{F},$ and an inductance of $L=15\\,\\text{H}.$ Find the differential equation governing the amount of charge $q$ (in coulombs) on the capacitor at time $t$ (in seconds).\n\n*Hint: The voltage drop ${V}_{C}$ across the capacitor is related to its charge by $q=C{V}_{C},$ where $C$ is the capacitance measured in Farads.*" :question/worked-solution "We have the following circuit diagram.\n\n![](images/34/34ed425a41460e1fca35a028c2bd7add953d0b354b28a4d4f2ab02bab67a78a8.png)\n\nThe current $I,$ measured in amperes, is defined as the rate of flow of charge $q,$ measured in coulombs.\n\n$$\nI=\\frac{dq}{dt}\n$$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RCL circuit, there are three voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=45\\,Ω.$ So,\n\n$$\n{V}_{R}=45I=45\\,\\frac{dq}{dt}.\n$$\n\n- The voltage drop across the capacitor is related to its charge by $q=C{V}_{C}.$ Therefore,\n\n$$\n{V}_{C}=\\frac{q}{C}=\\frac{q}{0.01}=100q.\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=15\\,\\text{H}.$ Hence,\n\n$$\n{V}_{L}=15\\,\\frac{dI}{dt}=15\\,\\frac{d}{dt}(\\frac{dq}{dt})=15\\,\\frac{{d}^{2}q}{d{t}^{2}}.\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of charge $q$ on the capacitor is\n\n$$\n9=45\\,\\frac{dq}{dt}+100q+15\\,\\frac{{d}^{2}q}{d{t}^{2}},\n$$\n\nwhich gives\n\n$$\n\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+\\frac{20}{3}q=\\frac{3}{5}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7715413d-38fa-550a-b8f7-7de3c69db2ed"] :db/ensure [:question/validate]} {:db/id "answer-field-7715413d-38fa-550a-b8f7-7de3c69db2ed" :answer-field/id #uuid "7715413d-38fa-550a-b8f7-7de3c69db2ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-099d6715-1415-56a0-8882-278bab083639" :answer-field/choices ["answer-297d30f9-49e1-5a3f-a311-17f301f4f32e" "answer-099d6715-1415-56a0-8882-278bab083639" "answer-1739b26a-b723-512d-ba44-6579185b3864" "answer-617a89cb-425d-5ab9-996b-e93f3978f5e7" "answer-094355c6-339b-5600-bc50-c00a85863511"] :db/ensure [:answer-field/validate]} {:db/id "answer-297d30f9-49e1-5a3f-a311-17f301f4f32e" :answer/id #uuid "297d30f9-49e1-5a3f-a311-17f301f4f32e" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+\\frac{20}{3}q=9" :db/ensure [:answer/validate]} {:db/id "answer-099d6715-1415-56a0-8882-278bab083639" :answer/id #uuid "099d6715-1415-56a0-8882-278bab083639" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+\\frac{20}{3}q=\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-1739b26a-b723-512d-ba44-6579185b3864" :answer/id #uuid "1739b26a-b723-512d-ba44-6579185b3864" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+\\frac{20}{3}q=\\frac{9}{5}" :db/ensure [:answer/validate]} {:db/id "answer-617a89cb-425d-5ab9-996b-e93f3978f5e7" :answer/id #uuid "617a89cb-425d-5ab9-996b-e93f3978f5e7" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+3\\,\\frac{dq}{dt}+\\frac{3}{20}q=\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-094355c6-339b-5600-bc50-c00a85863511" :answer/id #uuid "094355c6-339b-5600-bc50-c00a85863511" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+\\frac{1}{3}\\,\\frac{dq}{dt}+\\frac{20}{3}q=\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "question-11a66deb-d8c3-5e00-97b4-215e597d7249" :question/id #uuid "11a66deb-d8c3-5e00-97b4-215e597d7249" :question/math-academy-id "q-345116" :question/problem "![](images/22/22eff0b687ad9b417114aaf033cfe52186c884df00177c74ec7e85212b746c37.png)\n\nFind the differential equation governing the amount of charge $q$ (in coulombs) on the capacitor at time $t$ (in seconds) in the circuit given in the diagram above.\n\n*Hint: The voltage drop ${V}_{C}$ across the capacitor is related to its charge by $q=C{V}_{C},$ where $C$ is the capacitance measured in Farads.*" :question/worked-solution "The diagram shows a series RCL circuit with a source electromotive force (EMF) of $8\\,\\text{V},$ a resistor of resistance $16\\,Ω,$ a capacitor of capacitance $0.25\\,\\text{F},$ and an inductor of inductance $2\\,\\text{H}.$\n\nThe current $I,$ measured in amperes, is defined as the rate of flow of charge $q,$ measured in coulombs.\n\n$$\nI=\\frac{dq}{dt}\n$$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RCL circuit, there are three voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=16\\,Ω.$ So,\n\n$$\n{V}_{R}=16I=16\\,\\frac{dq}{dt}.\n$$\n\n- The voltage drop across the capacitor is related to its charge by $q=C{V}_{C}.$ Therefore,\n\n$$\n{V}_{C}=\\frac{q}{C}=\\frac{q}{0.25}=4q.\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=2\\,\\text{H}.$ Hence,\n\n$$\n{V}_{L}=2\\,\\frac{dI}{dt}=2\\,\\frac{d}{dt}(\\frac{dq}{dt})=2\\,\\frac{{d}^{2}q}{d{t}^{2}}.\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of charge $q$ on the capacitor is\n\n$$\n8=16\\,\\frac{dq}{dt}+4q+2\\,\\frac{{d}^{2}q}{d{t}^{2}},\n$$\n\nwhich gives\n\n$$\n\\frac{{d}^{2}q}{d{t}^{2}}+8\\,\\frac{dq}{dt}+2q=4.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cc10534a-67ee-5ca6-8585-6c869ec06248"] :db/ensure [:question/validate]} {:db/id "answer-field-cc10534a-67ee-5ca6-8585-6c869ec06248" :answer-field/id #uuid "cc10534a-67ee-5ca6-8585-6c869ec06248" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-55944f99-38ba-5956-a71f-f26ded5dafc6" :answer-field/choices ["answer-39a34a4f-1593-5d63-b334-f02644c56702" "answer-69933427-3584-5ac6-98d7-1ff965b647fd" "answer-55944f99-38ba-5956-a71f-f26ded5dafc6" "answer-6f953edf-c154-5b56-92ae-08928c8b9cd3" "answer-c5d1b184-251e-5e5e-89ab-a08574249834"] :db/ensure [:answer-field/validate]} {:db/id "answer-39a34a4f-1593-5d63-b334-f02644c56702" :answer/id #uuid "39a34a4f-1593-5d63-b334-f02644c56702" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+10\\,\\frac{dq}{dt}+2q=4" :db/ensure [:answer/validate]} {:db/id "answer-69933427-3584-5ac6-98d7-1ff965b647fd" :answer/id #uuid "69933427-3584-5ac6-98d7-1ff965b647fd" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+6\\,\\frac{dq}{dt}+2q=4" :db/ensure [:answer/validate]} {:db/id "answer-55944f99-38ba-5956-a71f-f26ded5dafc6" :answer/id #uuid "55944f99-38ba-5956-a71f-f26ded5dafc6" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+8\\,\\frac{dq}{dt}+2q=4" :db/ensure [:answer/validate]} {:db/id "answer-6f953edf-c154-5b56-92ae-08928c8b9cd3" :answer/id #uuid "6f953edf-c154-5b56-92ae-08928c8b9cd3" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+8\\,\\frac{dq}{dt}+2q=5" :db/ensure [:answer/validate]} {:db/id "answer-c5d1b184-251e-5e5e-89ab-a08574249834" :answer/id #uuid "c5d1b184-251e-5e5e-89ab-a08574249834" :answer/type :answer.type/math :answer/value "\\frac{{d}^{2}q}{d{t}^{2}}+8\\,\\frac{dq}{dt}+3q=4" :db/ensure [:answer/validate]} {:db/id 17592186119970 :knowledge-point/questions ["question-d2226eab-aaf4-5587-9e42-6e7839242b16"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d2226eab-aaf4-5587-9e42-6e7839242b16" :question/id #uuid "d2226eab-aaf4-5587-9e42-6e7839242b16" :question/math-academy-id "q-345131" :question/problem "![](images/34/34df0d1bec2fbee41f1d2b81711e83ed3def50d1a439ad2543e7d55743638741.png)\n\nConsider the RCL circuit shown above. Given that the charge $q(t)$ of the capacitor at time $t$ seconds is given by\n\n$$\nq(t)=A{e}^{-2t}+B{e}^{-t}+\\frac{P}{10}\\operatorname{cos}⁡(2t)+\\frac{Q}{10}\\operatorname{sin}⁡(2t)\n$$\n\nwhere $A,$ $B,$ $P,$ and $Q$ are constants, find the value of $P+Q.$\n\n*Hint: The voltage drop ${V}_{C}$ across the capacitor is related to its charge by $q=C{V}_{C},$ where $C$ is the capacitance measured in Farads.*" :question/worked-solution "The diagram shows a series RCL circuit with a source electromotive force (EMF) of $4\\operatorname{sin}⁡(2t)\\,\\text{V},$ a resistor of resistance $6\\,Ω,$ a capacitor of capacitance $0.25\\,\\text{F},$ and an inductor of inductance $2\\,\\text{H}.$\n\nThe current $I,$ measured in amperes, is defined as the rate of flow of charge $q,$ measured in coulombs.\n\n$$\nI=\\frac{dq}{dt}\n$$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RCL circuit, there are three voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=6\\,Ω.$ So,\n\n$$\n{V}_{R}=6I=6\\,\\frac{dq}{dt}.\n$$\n\n- The voltage drop across the capacitor is related to its charge by $q=C{V}_{C}.$ Therefore,\n\n$$\n{V}_{C}=\\frac{q}{C}=\\frac{q}{0.25}=4q.\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L=2\\,\\text{H}.$ Hence,\n\n$$\n{V}_{L}=2\\,\\frac{dI}{dt}=2\\,\\frac{d}{dt}(\\frac{dq}{dt})=2\\,\\frac{{d}^{2}q}{d{t}^{2}}.\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of charge $q$ on the capacitor is\n\n$$\n4\\operatorname{sin}⁡(2t)=6\\,\\frac{dq}{dt}+4q+2\\,\\frac{{d}^{2}q}{d{t}^{2}},\n$$\n\nwhich gives\n\n$$\n\\frac{{d}^{2}q}{d{t}^{2}}+3\\cdot \\frac{dq}{dt}+2q=2\\operatorname{sin}⁡(2t).\n$$\n\nThe given equation is a second-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution ${q}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\frac{{d}^{2}{q}_{c}}{d{t}^{2}}+3\\cdot \\frac{d{q}_{c}}{dt}+2{q}_{c}=0.\n$$\n\nSolving using an integration technique, such as a trial solution, we obtain the complementary solution\n\n$$\n{q}_{c}(t)=A{e}^{-2t}+B{e}^{-t},\n$$\n\nwhere $A$ and $B$ are constants.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is sinusoidal with argument $2t.$ So, we assume that the particular solution is also a sinusoidal with argument $2t,$ i.e.,\n\n$$\n{q}_{p}(t)=\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t).\n$$\n\nTo find the values of $\\alpha $ and $\\beta ,$ we substitute\n\n$$\n\\begin{aligned}{q}_{p} & =\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t), \\\\ \\frac{d{q}_{p}}{dt} & =-2\\alpha \\operatorname{sin}⁡(2t)+2\\beta \\operatorname{cos}⁡(2t), \\\\ \\frac{{d}^{2}{q}_{p}}{d{t}^{2}} & =-4\\alpha \\operatorname{cos}⁡(2t)-4\\beta \\operatorname{sin}⁡(2t),\\end{aligned}\n$$\n\ninto the inhomogeneous equation and group like terms on the left-hand side:\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,(-4\\alpha \\operatorname{cos}⁡(2t)-4\\beta \\operatorname{sin}⁡(2t))+3(-2\\alpha \\operatorname{sin}⁡(2t)+2\\beta \\operatorname{cos}⁡(2t))\\,\\,\\, &  \\\\ +2(\\alpha \\operatorname{cos}⁡(2t)+\\beta \\operatorname{sin}⁡(2t)) & =2\\operatorname{sin}⁡(2t) \\\\ (-2\\alpha +6\\beta )\\operatorname{cos}⁡(2t)+(-6\\alpha -2\\beta )\\operatorname{sin}⁡(2t) & =2\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\{\\begin{aligned}-2\\alpha +6\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(2t)) \\\\ -6\\alpha -2\\beta =2\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(2t))\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-\\frac{3}{10},$ $\\beta =-\\frac{1}{10}.$ Therefore, the particular solution is\n\n$$\n{q}_{p}(t)=-\\frac{3}{10}\\operatorname{cos}⁡(2t)-\\frac{1}{10}\\operatorname{sin}⁡(2t).\n$$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nq(t)={q}_{c}(t)+{q}_{p}(t)=A{e}^{-2t}+B{e}^{-t}-\\frac{3}{10}\\operatorname{cos}⁡(2t)-\\frac{1}{10}\\operatorname{sin}⁡(2t).\n$$\n\nTherefore, we have $P=-3,$ $Q=-1,$ and\n\n$$\nP+Q=-3+(-1)=-4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9754567d-3b2e-5814-b10e-242c23c361c2"] :db/ensure [:question/validate]} {:db/id "answer-field-9754567d-3b2e-5814-b10e-242c23c361c2" :answer-field/id #uuid "9754567d-3b2e-5814-b10e-242c23c361c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0257ea1-3e37-5482-a000-28ab4a7a6c7f" :answer-field/choices ["answer-be724bb9-4472-5843-8dcd-012063abd5ed" "answer-890c7a0f-eb41-5cd2-9509-2acfa23ba08f" "answer-d0257ea1-3e37-5482-a000-28ab4a7a6c7f" "answer-8d15a229-95d2-597d-97a4-d3166d24f5d1" "answer-e229bcbf-bc4f-5132-9ebe-150dc6395882"] :db/ensure [:answer-field/validate]} {:db/id "answer-be724bb9-4472-5843-8dcd-012063abd5ed" :answer/id #uuid "be724bb9-4472-5843-8dcd-012063abd5ed" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-890c7a0f-eb41-5cd2-9509-2acfa23ba08f" :answer/id #uuid "890c7a0f-eb41-5cd2-9509-2acfa23ba08f" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-d0257ea1-3e37-5482-a000-28ab4a7a6c7f" :answer/id #uuid "d0257ea1-3e37-5482-a000-28ab4a7a6c7f" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-8d15a229-95d2-597d-97a4-d3166d24f5d1" :answer/id #uuid "8d15a229-95d2-597d-97a4-d3166d24f5d1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-e229bcbf-bc4f-5132-9ebe-150dc6395882" :answer/id #uuid "e229bcbf-bc4f-5132-9ebe-150dc6395882" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "activity-5c4d6eb4-7017-503a-8745-027902f85b4a" :activity/id #uuid "5c4d6eb4-7017-503a-8745-027902f85b4a" :activity/title "Modeling Capacitor Charge in RCL Circuits With Second-Order ODEs" :activity/type :activity.type/review :activity/scope 17592186048396 :activity/course 17592186046660 :activity/steps ["step-773b4d4f-44c0-5a20-8834-084981dec492" "step-4b09538c-0eba-54f9-a003-2884f9fef33b" "step-12b95a92-17f6-5cae-a853-eda0fa52f6c6" "step-f7092bd8-cf9e-5db0-846f-127249b99cc8" "step-b5afdce3-a54a-570f-a847-666b5447e1e9"] :activity/first-step "step-773b4d4f-44c0-5a20-8834-084981dec492" :db/ensure [:activity/validate]} {:db/id "step-773b4d4f-44c0-5a20-8834-084981dec492" :step/id #uuid "773b4d4f-44c0-5a20-8834-084981dec492" :step/content 17592186120341 :step/next "step-4b09538c-0eba-54f9-a003-2884f9fef33b" :db/ensure [:step/validate]} {:db/id "step-4b09538c-0eba-54f9-a003-2884f9fef33b" :step/id #uuid "4b09538c-0eba-54f9-a003-2884f9fef33b" :step/content "question-0f78e83e-c080-5c56-8a40-9938a1632481" :step/next "step-12b95a92-17f6-5cae-a853-eda0fa52f6c6" :db/ensure [:step/validate]} {:db/id "step-12b95a92-17f6-5cae-a853-eda0fa52f6c6" :step/id #uuid "12b95a92-17f6-5cae-a853-eda0fa52f6c6" :step/content "question-11a66deb-d8c3-5e00-97b4-215e597d7249" :step/next "step-f7092bd8-cf9e-5db0-846f-127249b99cc8" :db/ensure [:step/validate]} {:db/id "step-f7092bd8-cf9e-5db0-846f-127249b99cc8" :step/id #uuid "f7092bd8-cf9e-5db0-846f-127249b99cc8" :step/content 17592186318976 :step/next "step-b5afdce3-a54a-570f-a847-666b5447e1e9" :db/ensure [:step/validate]} {:db/id "step-b5afdce3-a54a-570f-a847-666b5447e1e9" :step/id #uuid "b5afdce3-a54a-570f-a847-666b5447e1e9" :step/content "question-d2226eab-aaf4-5587-9e42-6e7839242b16" :db/ensure [:step/validate]} {:db/id 17592186073673 :knowledge-point/questions ["question-ebda143e-32ac-588d-bb70-63d0142c284b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ebda143e-32ac-588d-bb70-63d0142c284b" :question/id #uuid "ebda143e-32ac-588d-bb70-63d0142c284b" :question/math-academy-id "q-54165" :question/problem "Find a value of $x$ satisfying the equation $\\operatorname{cot}⁡{61}^{∘}=\\operatorname{tan}⁡x.$" :question/worked-solution "Since the cotangent of an angle equals the tangent of its complement, we have\n\n$$\n\\operatorname{cot}⁡{61}^{∘}=\\operatorname{tan}⁡({90}^{∘}-{61}^{∘})=\\operatorname{tan}⁡{29}^{∘}.\n$$\n\nTherefore, $x={29}^{∘}$ satisfies the given equation." :question/difficulty :question.diff