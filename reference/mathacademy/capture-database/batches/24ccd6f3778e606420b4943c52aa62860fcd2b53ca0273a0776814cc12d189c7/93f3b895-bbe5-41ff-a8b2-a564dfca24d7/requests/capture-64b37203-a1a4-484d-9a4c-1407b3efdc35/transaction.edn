-7498085f19f0"] :db/ensure [:question/validate]} {:db/id "answer-field-41c6cf3d-ea66-5b7a-ae44-7498085f19f0" :answer-field/id #uuid "41c6cf3d-ea66-5b7a-ae44-7498085f19f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5cb5ddbc-1334-5de0-93fe-381a78ceb5d5" :answer-field/choices ["answer-508c7277-188b-541e-bb52-b8d4f5a2eb6e" "answer-0f674c0b-1395-5ea9-befd-6d5d637b1168" "answer-5cb5ddbc-1334-5de0-93fe-381a78ceb5d5" "answer-ff9ce0e6-ce18-5c68-a2d4-ed60321e7cea" "answer-e4de6a79-9670-5cc7-841f-c24ff0103135"] :db/ensure [:answer-field/validate]} {:db/id "answer-508c7277-188b-541e-bb52-b8d4f5a2eb6e" :answer/id #uuid "508c7277-188b-541e-bb52-b8d4f5a2eb6e" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{arcosh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-0f674c0b-1395-5ea9-befd-6d5d637b1168" :answer/id #uuid "0f674c0b-1395-5ea9-befd-6d5d637b1168" :answer/type :answer.type/math :answer/value "-\\operatorname{arsinh}⁡\\frac{x}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-5cb5ddbc-1334-5de0-93fe-381a78ceb5d5" :answer/id #uuid "5cb5ddbc-1334-5de0-93fe-381a78ceb5d5" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcosh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-ff9ce0e6-ce18-5c68-a2d4-ed60321e7cea" :answer/id #uuid "ff9ce0e6-ce18-5c68-a2d4-ed60321e7cea" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arsinh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-e4de6a79-9670-5cc7-841f-c24ff0103135" :answer/id #uuid "e4de6a79-9670-5cc7-841f-c24ff0103135" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{arcosh}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186167396 :question/problem "$$\n\nCalculate $\\int (\\frac{\\operatorname{ln}⁡2}{5(1-{x}^{2})}+3{x}^{2})\\text{d}x$ for $|x|<1.$" :question/worked-solution "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\frac{\\operatorname{ln}⁡2}{5(1-{x}^{2})}+3{x}^{2})\\text{d}x & =\\frac{\\operatorname{ln}⁡2}{5}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x+3\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{\\operatorname{ln}⁡2}{5}\\operatorname{artanh}⁡x+{x}^{3}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165584 :answer-field/correct "answer-af5d74b6-ca0f-5476-88b5-36b653c244a1" :answer-field/choices ["answer-24237499-a9fc-52ba-b93c-5fd205a41dd8" "answer-bb7edc2a-2425-5880-b940-ad2aa6db593d" "answer-1366b0e5-70c5-5787-81b2-5a2d9590aff1" "answer-6894925b-4dd1-57de-9e53-340bdf78eb6f" "answer-af5d74b6-ca0f-5476-88b5-36b653c244a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-24237499-a9fc-52ba-b93c-5fd205a41dd8" :answer/id #uuid "24237499-a9fc-52ba-b93c-5fd205a41dd8" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{arcosh}⁡2x+{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "answer-bb7edc2a-2425-5880-b940-ad2aa6db593d" :answer/id #uuid "bb7edc2a-2425-5880-b940-ad2aa6db593d" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡2x+{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "answer-1366b0e5-70c5-5787-81b2-5a2d9590aff1" :answer/id #uuid "1366b0e5-70c5-5787-81b2-5a2d9590aff1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{5}\\operatorname{arcosh}⁡x+{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "answer-6894925b-4dd1-57de-9e53-340bdf78eb6f" :answer/id #uuid "6894925b-4dd1-57de-9e53-340bdf78eb6f" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{5}\\operatorname{arcoth}⁡x+{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id "answer-af5d74b6-ca0f-5476-88b5-36b653c244a1" :answer/id #uuid "af5d74b6-ca0f-5476-88b5-36b653c244a1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{5}\\operatorname{artanh}⁡x+{x}^{3}+C" :db/ensure [:answer/validate]} {:db/id 17592186168093 :tutorial/content "Recall the following derivatives of the inverse hyperbolic functions:\n$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}+1}}, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x) & =\\frac{1}{\\sqrt{{x}^{2}-1}}, &  & \\,x\\in (1,\\infty ) \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x) & =\\frac{1}{1-{x}^{2}}, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nSince integration is the reverse of differentiation, we arrive at the following basic integrals:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x & =\\operatorname{arsinh}⁡x+C, &  & \\,x\\in (-\\infty ,\\infty ) \\\\ \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =\\operatorname{arcosh}⁡x+C, &  & \\,x\\in (1,\\infty ) \\\\ \\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x & =\\operatorname{artanh}⁡x+C, &  & \\,x\\in (-1,1)\\end{aligned}\n$$\n\nWe can now use these formulas for finding integrals. For example, let's find the integral\n\n$$\n\\int \\left(\\dfrac{5}{2\\sqrt{x^2-1}} + 2x \\right) \\textrm d x\n$$\n\nUsing the properties of integration and the formulas above, we obtain\n\n$$\n\\begin{aligned}\\int (\\frac{5}{2\\sqrt{{x}^{2}-1}}+2x)\\text{d}x & =\\frac{5}{2}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x+\\int 2x\\,\\text{d}x \\\\  & =\\frac{5}{2}\\operatorname{arcosh}⁡x+{x}^{2}+C.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186167020 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-1ab91b77-5a38-545c-aad3-8c7b75ae2ef4" :activity/id #uuid "1ab91b77-5a38-545c-aad3-8c7b75ae2ef4" :activity/title "Diagonalizing a 2x2 Matrix" :activity/type :activity.type/review :activity/scope 17592186049113 :activity/course 17592186046658 :activity/steps ["step-003b1825-afe9-583d-9089-86405c5e6a74" "step-3bdb7801-f8d6-5f41-a4ac-0d153c4f6c8b" "step-1ed0c797-27ac-5a1d-9d59-6db1aaefb34a" "step-1b44f557-01ab-5482-9558-b2e2cf4a9a80" "step-f7118053-34d6-53bc-9f06-3bdde789e2a3"] :activity/first-step "step-003b1825-afe9-583d-9089-86405c5e6a74" :db/ensure [:activity/validate]} {:db/id "step-003b1825-afe9-583d-9089-86405c5e6a74" :step/id #uuid "003b1825-afe9-583d-9089-86405c5e6a74" :step/content 17592186348376 :step/next "step-3bdb7801-f8d6-5f41-a4ac-0d153c4f6c8b" :db/ensure [:step/validate]} {:db/id "step-3bdb7801-f8d6-5f41-a4ac-0d153c4f6c8b" :step/id #uuid "3bdb7801-f8d6-5f41-a4ac-0d153c4f6c8b" :step/content 17592186455503 :step/next "step-1ed0c797-27ac-5a1d-9d59-6db1aaefb34a" :db/ensure [:step/validate]} {:db/id "step-1ed0c797-27ac-5a1d-9d59-6db1aaefb34a" :step/id #uuid "1ed0c797-27ac-5a1d-9d59-6db1aaefb34a" :step/content 17592186348383 :step/next "step-1b44f557-01ab-5482-9558-b2e2cf4a9a80" :db/ensure [:step/validate]} {:db/id "step-1b44f557-01ab-5482-9558-b2e2cf4a9a80" :step/id #uuid "1b44f557-01ab-5482-9558-b2e2cf4a9a80" :step/content 17592186348389 :step/next "step-f7118053-34d6-53bc-9f06-3bdde789e2a3" :db/ensure [:step/validate]} {:db/id "step-f7118053-34d6-53bc-9f06-3bdde789e2a3" :step/id #uuid "f7118053-34d6-53bc-9f06-3bdde789e2a3" :step/content 17592186272015 :db/ensure [:step/validate]} {:db/id 17592186198685 :question/problem "Find the minimum value of $Q(x)=5{x}_{1}^{2}-16{x}_{1}{x}_{2}-4{x}_{2}^{2}$ given that $25{x}_{1}^{2}+4{x}_{2}^{2}=100.$" :question/worked-solution "First, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}5 & -8 \\\\ -8 & -4\\end{aligned}]\n$$\n\nNotice that we can write the constraint equation as follows:\n\n$$\n\\frac{{x}_{1}^{2}}{{2}^{2}}+\\frac{{x}_{2}^{2}}{{5}^{2}}=1\n$$\n\nThis is an ellipse with semiaxes $a=2$ (along the ${x}_{1}$-axis) and $b=5$ (along the ${x}_{2}$-axis). If we introduce new variables\n\n$\\,$ ${y}_{1}=\\frac{{x}_{1}}{2}\\,$ and $\\,{y}_{2}=\\frac{{x}_{2}}{5},$\n\nthe equation of the ellipse will transform into ${y}_{1}^{2}+{y}_{2}^{2}=1$ or $‖y‖=1.$\n\nSo, introducing a change-of-coordinates matrix \n\n$$\nP=[\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}],\n$$\n\n \n\nwe obtain that $x=Py.$ Substituting this into the expression of the quadratic form, we get\n\n$$\nQ(x)={x}^{T}\\,Ax=(Py)^{T}A\\,(Py)={y}^{T}\\,({P}^{T}AP)y={Q}^{′}(y).\n$$\n\nAs a result, since ${P}^{T}=P,$ the matrix of our quadratic form in new coordinates is \n\n$$\n\\begin{aligned}B & ={P}^{T}\\,AP \\\\  & =PAP \\\\  & =[\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}][\\begin{aligned}5 & -8 \\\\ -8 & -4\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}10 & -16 \\\\ -40 & -20\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}20 & -80 \\\\ -80 & -100\\end{aligned}].\\end{aligned}\n$$\n\n \n\nNow, we maximize ${Q}^{′}(y)$ when $‖y‖=1,$ as usual. Calculating the eigenvalues $B,$ we obtain the following:\n\n$$\n\\begin{aligned}|B-\\lambda I| & =0 \\\\ |\\begin{aligned}20-\\lambda  & -80 \\\\ -80 & -100-\\lambda \\end{aligned}| & =0 \\\\ (20-\\lambda )(-100-\\lambda )-6\\,400 & =0 \\\\ {\\lambda }^{2}+80\\lambda -8\\,400 & =0 \\\\ (\\lambda -60)(\\lambda +140) & =0 \\\\ \\lambda  & =60,\\,-140\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmin\\{{Q}^{′}(y)\\,|\\,‖y‖=1\\}={\\lambda }_{\\text{min}}=-140.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186194741 :answer-field/correct 17592186194746 :db/ensure [:answer-field/validate]} {:db/id "activity-108ae62e-7d7b-54c1-8273-d90e72bb4de2" :activity/id #uuid "108ae62e-7d7b-54c1-8273-d90e72bb4de2" :activity/title "Constrained Optimization of Quadratic Forms: Determining Where Extrema are Attained" :activity/type :activity.type/review :activity/scope 17592186048933 :activity/course 17592186046644 :activity/steps ["step-232c0666-36c6-5d1f-979e-1103f486dd6b" "step-45807d9e-70fa-58c2-a3d7-d8cc5cbfdcc9" "step-8d69128b-9c71-5aba-b4db-fd173418e1a2" "step-a61dcaf7-f154-5c88-a2cc-4dd236b50f6e" "step-491341df-0c55-56c0-a053-5047b84d6caf"] :activity/first-step "step-232c0666-36c6-5d1f-979e-1103f486dd6b" :db/ensure [:activity/validate]} {:db/id "step-232c0666-36c6-5d1f-979e-1103f486dd6b" :step/id #uuid "232c0666-36c6-5d1f-979e-1103f486dd6b" :step/content 17592186410196 :step/next "step-45807d9e-70fa-58c2-a3d7-d8cc5cbfdcc9" :db/ensure [:step/validate]} {:db/id "step-45807d9e-70fa-58c2-a3d7-d8cc5cbfdcc9" :step/id #uuid "45807d9e-70fa-58c2-a3d7-d8cc5cbfdcc9" :step/content 17592186514484 :step/next "step-8d69128b-9c71-5aba-b4db-fd173418e1a2" :db/ensure [:step/validate]} {:db/id "step-8d69128b-9c71-5aba-b4db-fd173418e1a2" :step/id #uuid "8d69128b-9c71-5aba-b4db-fd173418e1a2" :step/content 17592186198685 :step/next "step-a61dcaf7-f154-5c88-a2cc-4dd236b50f6e" :db/ensure [:step/validate]} {:db/id "step-a61dcaf7-f154-5c88-a2cc-4dd236b50f6e" :step/id #uuid "a61dcaf7-f154-5c88-a2cc-4dd236b50f6e" :step/content 17592186492836 :step/next "step-491341df-0c55-56c0-a053-5047b84d6caf" :db/ensure [:step/validate]} {:db/id "step-491341df-0c55-56c0-a053-5047b84d6caf" :step/id #uuid "491341df-0c55-56c0-a053-5047b84d6caf" :step/content 17592186492837 :db/ensure [:step/validate]} {:db/id 17592186078561 :knowledge-point/questions ["question-a218b702-260e-5626-9b2a-10fbf0615a24" "question-54170d78-262c-5604-939a-66b79556fcdc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078342 :question/problem "Rationalize $\\dfrac{x}{2\\sqrt{y}}.$" :question/worked-solution "We need to remove the radical $\\sqrt{y}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{y},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{x}{2\\sqrt{y}} & = \\\\ \\frac{x}{2\\sqrt{y}}\\cdot \\frac{\\sqrt{y}}{\\sqrt{y}} & = \\\\ \\frac{x\\cdot \\sqrt{y}}{2\\sqrt{y}\\cdot \\sqrt{y}} & = \\\\ \\frac{x\\sqrt{y}}{2(\\sqrt{y})^{2}} & = \\\\ \\frac{x\\sqrt{y}}{2y}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078562 :knowledge-point/questions ["question-e789ca07-9ab5-56ec-aa69-c4d893a03b51" "question-8dffe1e2-d854-56ac-895d-ab0f043c857c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078171 :question/problem "Rationalize the denominator of  $\\sqrt{\\dfrac{3}{8a}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{3}{8a}} & =\\frac{\\sqrt{3}}{\\sqrt{8a}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{8a}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{8a}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{8a}}\\cdot \\frac{\\sqrt{8a}}{\\sqrt{8a}} & = \\\\ \\frac{\\sqrt{24a}}{(\\sqrt{8a})^{2}} & = \\\\ \\frac{\\sqrt{4\\cdot 6a}}{8a} & = \\\\ \\frac{2\\sqrt{6a}}{8a} & = \\\\ \\frac{\\sqrt{6a}}{4a}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078563 :knowledge-point/questions ["question-07c37b28-ce2e-5984-bd1b-1c0c09dcc7da" "question-cb60bd4d-fd24-5677-a17c-242785ce4b4c" "question-0c5d26cb-9be7-50d4-8738-09ac8a11367a" "question-22cd57f3-188f-5b72-9854-fd7357950a74"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078172 :question/worked-solution "We need to remove the radical $\\sqrt{z+1}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{z+1}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{y}+2}{\\sqrt{z+1}} & = \\\\ \\frac{\\sqrt{y}+2}{\\sqrt{z+1}}\\cdot \\frac{\\sqrt{z+1}}{\\sqrt{z+1}} & = \\\\ \\frac{(\\sqrt{y}+2)\\sqrt{z+1}}{(\\sqrt{z+1})^{2}} & = \\\\ \\frac{\\sqrt{y}\\cdot \\sqrt{z+1}+2\\cdot \\sqrt{z+1}}{z+1} & = \\\\ \\frac{\\sqrt{y\\cdot (z+1)}+2\\sqrt{z+1}}{z+1} & = \\\\ \\frac{\\sqrt{yz+y}+2\\sqrt{z+1}}{z+1}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-a218b702-260e-5626-9b2a-10fbf0615a24" :question/id #uuid "a218b702-260e-5626-9b2a-10fbf0615a24" :question/math-academy-id "q-276847" :question/problem "Rationalize the denominator of the following expression:\n\n| ${p}^{2}\\sqrt{36}$ | __ | {{field-1}} |\n| --- | --- | --- |\n| $2\\sqrt{3s}$ | __ | $s$ |" :question/worked-solution "We must remove the radical $\\sqrt{3s}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{3s},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{{p}^{2}\\sqrt{36}}{2\\sqrt{3s}} & = \\\\ \\frac{{p}^{2}\\sqrt{36}}{2\\sqrt{3s}}\\cdot \\frac{\\sqrt{3s}}{\\sqrt{3s}} & = \\\\ \\frac{6{p}^{2}\\cdot \\sqrt{3s}}{2\\sqrt{3s}\\cdot \\sqrt{3s}} & = \\\\ \\frac{6{p}^{2}\\sqrt{3s}}{2{(\\sqrt{3s})}^{2}} & = \\\\ \\frac{6{p}^{2}\\sqrt{3s}}{2\\cdot 3s} & = \\\\ \\frac{\\cancel{6}{p}^{2}\\sqrt{3s}}{\\cancel{6}s} & = \\\\ \\frac{{p}^{2}\\sqrt{3s}}{s}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-49e36eda-fd63-55f3-a7d4-f505c4715099"] :db/ensure [:question/validate]} {:db/id "answer-field-49e36eda-fd63-55f3-a7d4-f505c4715099" :answer-field/id #uuid "49e36eda-fd63-55f3-a7d4-f505c4715099" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eff31e70-7fa8-5952-b9f9-92a5f5d245e9" :answer-field/choices ["answer-eff31e70-7fa8-5952-b9f9-92a5f5d245e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-eff31e70-7fa8-5952-b9f9-92a5f5d245e9" :answer/id #uuid "eff31e70-7fa8-5952-b9f9-92a5f5d245e9" :answer/type :answer.type/math :answer/value "p^{2}\\sqrt{3s}" :db/ensure [:answer/validate]} {:db/id "question-54170d78-262c-5604-939a-66b79556fcdc" :question/id #uuid "54170d78-262c-5604-939a-66b79556fcdc" :question/math-academy-id "q-111045" :question/problem "Rationalize $\\frac{10p}{\\sqrt{5q}}.$" :question/worked-solution "We need to remove the radical $\\sqrt{5q}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{5q},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{10p}{\\sqrt{5q}} & = \\\\ \\frac{10p}{\\sqrt{5q}}\\cdot \\frac{\\sqrt{5q}}{\\sqrt{5q}} & = \\\\ \\frac{10p\\cdot \\sqrt{5q}}{\\sqrt{5q}\\cdot \\sqrt{5q}} & = \\\\ \\frac{10p\\cdot \\sqrt{5q}}{5q} & = \\\\ \\frac{\\cancel{5}\\cdot 2p\\cdot \\sqrt{5q}}{\\cancel{5}\\cdot q} & = \\\\ \\frac{2p\\sqrt{5q}}{q}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-799ec4d9-c327-5bfe-a23f-9234d6f91082"] :db/ensure [:question/validate]} {:db/id "answer-field-799ec4d9-c327-5bfe-a23f-9234d6f91082" :answer-field/id #uuid "799ec4d9-c327-5bfe-a23f-9234d6f91082" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c047a171-554c-5af4-97cd-4397157ab688" :answer-field/choices ["answer-c047a171-554c-5af4-97cd-4397157ab688" "answer-881bc8e4-23e6-5c8b-abbb-336ad8921d0c" "answer-18ef76f8-8dbc-5ebb-8bc9-f86c15aea042" "answer-db6c92bd-32d1-5af5-8dc2-84c41e3fbc21" "answer-af6a6fd8-98dd-5b95-b6a0-f1f21a75231d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c047a171-554c-5af4-97cd-4397157ab688" :answer/id #uuid "c047a171-554c-5af4-97cd-4397157ab688" :answer/type :answer.type/math :answer/value "\\frac{2p\\sqrt{5q}}{q}" :db/ensure [:answer/validate]} {:db/id "answer-881bc8e4-23e6-5c8b-abbb-336ad8921d0c" :answer/id #uuid "881bc8e4-23e6-5c8b-abbb-336ad8921d0c" :answer/type :answer.type/math :answer/value "\\frac{2p\\sqrt{q}}{5q}" :db/ensure [:answer/validate]} {:db/id "answer-18ef76f8-8dbc-5ebb-8bc9-f86c15aea042" :answer/id #uuid "18ef76f8-8dbc-5ebb-8bc9-f86c15aea042" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{5q}}{pq}" :db/ensure [:answer/validate]} {:db/id "answer-db6c92bd-32d1-5af5-8dc2-84c41e3fbc21" :answer/id #uuid "db6c92bd-32d1-5af5-8dc2-84c41e3fbc21" :answer/type :answer.type/math :answer/value "\\frac{p\\sqrt{5q}}{5q}" :db/ensure [:answer/validate]} {:db/id "answer-af6a6fd8-98dd-5b95-b6a0-f1f21a75231d" :answer/id #uuid "af6a6fd8-98dd-5b95-b6a0-f1f21a75231d" :answer/type :answer.type/math :answer/value "\\frac{p\\sqrt{q}}{q}" :db/ensure [:answer/validate]} {:db/id "question-e789ca07-9ab5-56ec-aa69-c4d893a03b51" :question/id #uuid "e789ca07-9ab5-56ec-aa69-c4d893a03b51" :question/math-academy-id "q-29307" :question/problem "Rationalize the denominator of $\\sqrt{\\frac{2}{ab}}.$" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{2}{ab}} & =\\frac{\\sqrt{2}}{\\sqrt{ab}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{ab}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{ab},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{2}}{\\sqrt{ab}}\\cdot \\frac{\\sqrt{ab}}{\\sqrt{ab}} & = \\\\ \\frac{\\sqrt{2ab}}{(\\sqrt{ab})^{2}} & = \\\\ \\frac{\\sqrt{2ab}}{ab}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a2b52444-4149-539f-af43-cc5257565cbc"] :db/ensure [:question/validate]} {:db/id "answer-field-a2b52444-4149-539f-af43-cc5257565cbc" :answer-field/id #uuid "a2b52444-4149-539f-af43-cc5257565cbc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b37f642-471b-5f6b-85d2-8b40a9577888" :answer-field/choices ["answer-d9578fff-a12b-5db2-99d3-cec08ace2c8a" "answer-f44908d9-838a-50aa-b994-1cdffda99e54" "answer-13f0ba23-754e-51a6-a295-4f96fd6ef5e9" "answer-3b37f642-471b-5f6b-85d2-8b40a9577888" "answer-86c7b175-e87a-5dbf-9cea-22949b3d7cdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9578fff-a12b-5db2-99d3-cec08ace2c8a" :answer/id #uuid "d9578fff-a12b-5db2-99d3-cec08ace2c8a" :answer/type :answer.type/math :answer/value "2\\sqrt{{a}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-f44908d9-838a-50aa-b994-1cdffda99e54" :answer/id #uuid "f44908d9-838a-50aa-b994-1cdffda99e54" :answer/type :answer.type/math :answer/value "2ab\\sqrt{a}" :db/ensure [:answer/validate]} {:db/id "answer-13f0ba23-754e-51a6-a295-4f96fd6ef5e9" :answer/id #uuid "13f0ba23-754e-51a6-a295-4f96fd6ef5e9" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{a}}{b}" :db/ensure [:answer/validate]} {:db/id "answer-3b37f642-471b-5f6b-85d2-8b40a9577888" :answer/id #uuid "3b37f642-471b-5f6b-85d2-8b40a9577888" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2ab}}{ab}" :db/ensure [:answer/validate]} {:db/id "answer-86c7b175-e87a-5dbf-9cea-22949b3d7cdf" :answer/id #uuid "86c7b175-e87a-5dbf-9cea-22949b3d7cdf" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{a}}{2b}" :db/ensure [:answer/validate]} {:db/id "question-8dffe1e2-d854-56ac-895d-ab0f043c857c" :question/id #uuid "8dffe1e2-d854-56ac-895d-ab0f043c857c" :question/math-academy-id "q-276897" :question/problem "Rationalize the denominator of the following expression:\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"40\"></td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$\\sqrt{\\frac{11}{pq}}\\,=\\,$</td>\n<td align=\"center\" height=\"25\" width=\"40\">{{field-1}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"40\"></td>\n<td align=\"center\" height=\"25\" width=\"40\">$pq$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{11}{pq}} & =\\frac{\\sqrt{11}}{\\sqrt{pq}}\\end{aligned}\n$$\n\nNow, we need to remove the radical $\\sqrt{pq}$ from the denominator. To do this, we multiply both the numerator and denominator by $\\sqrt{pq},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{11}}{\\sqrt{pq}}\\cdot \\frac{\\sqrt{pq}}{\\sqrt{pq}} & = \\\\ \\frac{\\sqrt{11pq}}{(\\sqrt{pq})^{2}} & = \\\\ \\frac{\\sqrt{11pq}}{pq}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2be4abe8-b965-5965-996d-2949b1702bae"] :db/ensure [:question/validate]} {:db/id "answer-field-2be4abe8-b965-5965-996d-2949b1702bae" :answer-field/id #uuid "2be4abe8-b965-5965-996d-2949b1702bae" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f865e495-959b-519f-98c3-1d28f572087e" :answer-field/choices ["answer-f865e495-959b-519f-98c3-1d28f572087e"] :db/ensure [:answer-field/validate]} {:db/id "answer-f865e495-959b-519f-98c3-1d28f572087e" :answer/id #uuid "f865e495-959b-519f-98c3-1d28f572087e" :answer/type :answer.type/math :answer/value "\\sqrt{11pq}" :db/ensure [:answer/validate]} {:db/id "question-07c37b28-ce2e-5984-bd1b-1c0c09dcc7da" :question/id #uuid "07c37b28-ce2e-5984-bd1b-1c0c09dcc7da" :question/math-academy-id "q-77890" :question/problem "Express $\\frac{\\sqrt{x+2}}{\\sqrt{2-x}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{2-x}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{2-x}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{x+2}}{\\sqrt{2-x}} & = \\\\ \\frac{\\sqrt{x+2}}{\\sqrt{2-x}}\\cdot \\frac{\\sqrt{2-x}}{\\sqrt{2-x}} & = \\\\ \\frac{\\sqrt{x+2}\\cdot \\sqrt{2-x}}{(\\sqrt{2-x})^{2}} & = \\\\ \\frac{\\sqrt{(x+2)(2-x)}}{2-x} & = \\\\ \\frac{\\sqrt{{2}^{2}-{x}^{2}}}{2-x} & = \\\\ \\frac{\\sqrt{4-{x}^{2}}}{2-x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2d9977c0-0af6-5dbd-8b59-33d467a9c5ba"] :db/ensure [:question/validate]} {:db/id "answer-field-2d9977c0-0af6-5dbd-8b59-33d467a9c5ba" :answer-field/id #uuid "2d9977c0-0af6-5dbd-8b59-33d467a9c5ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d32eb343-b5b4-5113-a794-b6b4d1ab3fea" :answer-field/choices ["answer-f1a440e4-05f7-5a40-af58-370b96d95d00" "answer-df8ec371-a2ca-56b1-ae32-b3976639b2c1" "answer-d32eb343-b5b4-5113-a794-b6b4d1ab3fea" "answer-72f2ff78-ff55-57c4-8824-0fdecfba4af0" "answer-eb8ecf94-7285-5927-ae86-41b74c3c44a3"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1a440e4-05f7-5a40-af58-370b96d95d00" :answer/id #uuid "f1a440e4-05f7-5a40-af58-370b96d95d00" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2+{x}^{2}}}{2+x}" :db/ensure [:answer/validate]} {:db/id "answer-df8ec371-a2ca-56b1-ae32-b3976639b2c1" :answer/id #uuid "df8ec371-a2ca-56b1-ae32-b3976639b2c1" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2-{x}^{2}}}{2+x}" :db/ensure [:answer/validate]} {:db/id "answer-d32eb343-b5b4-5113-a794-b6b4d1ab3fea" :answer/id #uuid "d32eb343-b5b4-5113-a794-b6b4d1ab3fea" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{4-{x}^{2}}}{2-x}" :db/ensure [:answer/validate]} {:db/id "answer-72f2ff78-ff55-57c4-8824-0fdecfba4af0" :answer/id #uuid "72f2ff78-ff55-57c4-8824-0fdecfba4af0" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{2}-4}}{2+x}" :db/ensure [:answer/validate]} {:db/id "answer-eb8ecf94-7285-5927-ae86-41b74c3c44a3" :answer/id #uuid "eb8ecf94-7285-5927-ae86-41b74c3c44a3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{2}-4}}{2-x}" :db/ensure [:answer/validate]} {:db/id "question-cb60bd4d-fd24-5677-a17c-242785ce4b4c" :question/id #uuid "cb60bd4d-fd24-5677-a17c-242785ce4b4c" :question/math-academy-id "q-277015" :question/problem "Rationalize the denominator of the following expression:\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"25\" width=\"80\"></td>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$\\sqrt{\\frac{5}{x+2}}\\,=\\,$</td>\n<td align=\"center\" height=\"25\" width=\"80\">{{field-1}}\n</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"60\"></td>\n<td align=\"center\" height=\"25\" width=\"60\">$x+2$</td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we apply the quotient rule and put the numerator and denominator under separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{5}{x+2}} & =\\frac{\\sqrt{5}}{\\sqrt{x+2}}\\end{aligned}\n$$\n\nTo remove the radical $\\sqrt{x+2}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{x+2}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{5}}{\\sqrt{x+2}} & = \\\\ \\frac{\\sqrt{5}}{\\sqrt{x+2}}\\cdot \\frac{\\sqrt{x+2}}{\\sqrt{x+2}} & = \\\\ \\frac{\\sqrt{5}\\cdot \\sqrt{x+2}}{\\sqrt{x+2}\\cdot \\sqrt{x+2}} & = \\\\ \\frac{\\sqrt{5(x+2)}}{(\\sqrt{x+2})^{2}} & = \\\\ \\frac{\\sqrt{5(x+2)}}{x+2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1090ed63-0b99-5fd6-8d1a-d720a0b737cc"] :db/ensure [:question/validate]} {:db/id "answer-field-1090ed63-0b99-5fd6-8d1a-d720a0b737cc" :answer-field/id #uuid "1090ed63-0b99-5fd6-8d1a-d720a0b737cc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-549110d8-b6e9-5bac-9678-e4bf16752d1a" :answer-field/choices ["answer-549110d8-b6e9-5bac-9678-e4bf16752d1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-549110d8-b6e9-5bac-9678-e4bf16752d1a" :answer/id #uuid "549110d8-b6e9-5bac-9678-e4bf16752d1a" :answer/type :answer.type/math :answer/value "\\sqrt{5(x+2)}" :db/ensure [:answer/validate]} {:db/id "question-0c5d26cb-9be7-50d4-8738-09ac8a11367a" :question/id #uuid "0c5d26cb-9be7-50d4-8738-09ac8a11367a" :question/math-academy-id "q-365109" :question/problem "Express $\\frac{\\sqrt{x+5}}{\\sqrt{x-4}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{x-4}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{x-4}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{x+5}}{\\sqrt{x-4}} & = \\\\ \\frac{\\sqrt{x+5}}{\\sqrt{x-4}}\\cdot \\frac{\\sqrt{x-4}}{\\sqrt{x-4}} & = \\\\ \\frac{\\sqrt{x+5}\\cdot \\sqrt{x-4}}{(\\sqrt{x-4})^{2}} & = \\\\ \\frac{\\sqrt{(x+5)(x-4)}}{x-4} & = \\\\ \\frac{\\sqrt{{x}^{2}+x-20}}{x-4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9ec66753-9269-508b-82f0-625ca12d3dac"] :db/ensure [:question/validate]} {:db/id "answer-field-9ec66753-9269-508b-82f0-625ca12d3dac" :answer-field/id #uuid "9ec66753-9269-508b-82f0-625ca12d3dac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1362ec50-045d-570a-b8d9-f597a02660d6" :answer-field/choices ["answer-c733caca-8b56-5be4-8259-9a8dbc49c5cd" "answer-4d322ece-08bb-5254-ab69-92f021354124" "answer-1362ec50-045d-570a-b8d9-f597a02660d6" "answer-f1d80ea2-6dc7-5f7f-8084-aac98a28814c" "answer-1e90ea7a-8259-5a46-a5a1-561e85f157c7"] :db/ensure [:answer-field/validate]} {:db/id "answer-c733caca-8b56-5be4-8259-9a8dbc49c5cd" :answer/id #uuid "c733caca-8b56-5be4-8259-9a8dbc49c5cd" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{x-4}}{x-4}" :db/ensure [:answer/validate]} {:db/id "answer-4d322ece-08bb-5254-ab69-92f021354124" :answer/id #uuid "4d322ece-08bb-5254-ab69-92f021354124" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{2}+x-20}}{x+4}" :db/ensure [:answer/validate]} {:db/id "answer-1362ec50-045d-570a-b8d9-f597a02660d6" :answer/id #uuid "1362ec50-045d-570a-b8d9-f597a02660d6" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{2}+x-20}}{x-4}" :db/ensure [:answer/validate]} {:db/id "answer-f1d80ea2-6dc7-5f7f-8084-aac98a28814c" :answer/id #uuid "f1d80ea2-6dc7-5f7f-8084-aac98a28814c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{2}-x-20}}{x+4}" :db/ensure [:answer/validate]} {:db/id "answer-1e90ea7a-8259-5a46-a5a1-561e85f157c7" :answer/id #uuid "1e90ea7a-8259-5a46-a5a1-561e85f157c7" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{x}^{2}-x-20}}{x-4}" :db/ensure [:answer/validate]} {:db/id "question-22cd57f3-188f-5b72-9854-fd7357950a74" :question/id #uuid "22cd57f3-188f-5b72-9854-fd7357950a74" :question/math-academy-id "q-365110" :question/problem "Express $\\frac{\\sqrt{m-n}}{\\sqrt{m+n}}\\,$ without radicals in the denominator." :question/worked-solution "To remove the radical $\\sqrt{m+n}$ from the denominator, we multiply both the numerator and denominator by $\\sqrt{m+n}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{m-n}}{\\sqrt{m+n}} & = \\\\ \\frac{\\sqrt{m-n}}{\\sqrt{m+n}}\\cdot \\frac{\\sqrt{m+n}}{\\sqrt{m+n}} & = \\\\ \\frac{\\sqrt{m-n}\\cdot \\sqrt{m+n}}{(\\sqrt{m+n})^{2}} & = \\\\ \\frac{\\sqrt{(m-n)(m+n)}}{m+n} & = \\\\ \\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m+n}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-703f2d0f-3039-5af3-a486-ae462ad38c20"] :db/ensure [:question/validate]} {:db/id "answer-field-703f2d0f-3039-5af3-a486-ae462ad38c20" :answer-field/id #uuid "703f2d0f-3039-5af3-a486-ae462ad38c20" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a6af6e16-740a-54f1-b709-e593a3aa6a29" :answer-field/choices ["answer-3b814f94-8ed6-50a2-bfe4-320dae6d343f" "answer-74891615-da22-5cd5-b950-a3e2d5e19836" "answer-a8aa1796-cc5a-5ac4-bf5f-2a8bbcd39fb7" "answer-a6af6e16-740a-54f1-b709-e593a3aa6a29" "answer-1be8bbf0-94a3-514d-b9e7-cf2447c34027"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b814f94-8ed6-50a2-bfe4-320dae6d343f" :answer/id #uuid "3b814f94-8ed6-50a2-bfe4-320dae6d343f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{m+n}}{m+n}" :db/ensure [:answer/validate]} {:db/id "answer-74891615-da22-5cd5-b950-a3e2d5e19836" :answer/id #uuid "74891615-da22-5cd5-b950-a3e2d5e19836" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{m}^{2}+{n}^{2}}}{m+n}" :db/ensure [:answer/validate]} {:db/id "answer-a8aa1796-cc5a-5ac4-bf5f-2a8bbcd39fb7" :answer/id #uuid "a8aa1796-cc5a-5ac4-bf5f-2a8bbcd39fb7" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{m}^{2}+{n}^{2}}}{m-n}" :db/ensure [:answer/validate]} {:db/id "answer-a6af6e16-740a-54f1-b709-e593a3aa6a29" :answer/id #uuid "a6af6e16-740a-54f1-b709-e593a3aa6a29" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m+n}" :db/ensure [:answer/validate]} {:db/id "answer-1be8bbf0-94a3-514d-b9e7-cf2447c34027" :answer/id #uuid "1be8bbf0-94a3-514d-b9e7-cf2447c34027" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{{m}^{2}-{n}^{2}}}{m-n}" :db/ensure [:answer/validate]} {:db/id 17592186079624 :tutorial/content "When simplifying expressions, we prefer not to leave a radical in the denominator. To eliminate a radical in an expression's denominator, we can use a process known as **rationalizing the denominator**.\n\nTo rationalize the denominator, we need to multiply both the numerator and denominator by the radical that we wish to remove from the denominator.\n\nFor instance, to rationalize the denominator in the expression\n\n$$\n\\dfrac{1}{\\sqrt{x}},\n$$\n\nall we need to do is multiply both the numerator and denominator by $\\sqrt{x}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{x}} & = \\\\ \\frac{1}{\\sqrt{x}}\\,\\cdot \\,\\frac{\\sqrt{x}}{\\sqrt{x}} & = \\\\ \\frac{\\sqrt{x}}{{(\\sqrt{x})}^{2}} & = \\\\ \\frac{\\sqrt{x}}{x} & \\end{aligned}\n$$\n\nWe see that the final expression no longer has a radical in the denominator. Thus, the denominator has been rationalized.\n\n**Note:** Because we multiplied the numerator and denominator by the same amount, the resulting expression $\\dfrac{\\sqrt{x}}{x}$ is equivalent to the original fraction $\\dfrac{1}{\\sqrt{x}}.$ They are equivalent, even though they are written differently." :db/ensure [:tutorial/validate]} {:db/id 17592186078633 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186079505 :step/math-academy-id 653769 :db/ensure [:step/validate]} {:db/id 17592186079506 :step/math-academy-id 653770 :db/ensure [:step/validate]} {:db/id 17592186079507 :step/math-academy-id 653774 :db/ensure [:step/validate]} {:db/id 17592186079508 :step/math-academy-id 653778 :db/ensure [:step/validate]} {:db/id 17592186064314 :knowledge-point/questions ["question-1e9c32a8-c5ef-5dca-8493-0a63cb017fc2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1e9c32a8-c5ef-5dca-8493-0a63cb017fc2" :question/id #uuid "1e9c32a8-c5ef-5dca-8493-0a63cb017fc2" :question/math-academy-id "q-143512" :question/problem "| $x$ | $0$ | $2$ | $4$ | $8$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $0.1$ | $0.7$ | $0.1$ | $0.1$ |\n\nLet ${X}_{1},{X}_{2},…,{X}_{101}$ be a random sample of size $n=101$ from a population with the probability mass function given above. Find an approximation for the probability that the sample mean is between $2.5$ and $3.$\n\n*Note: $Φ(z)$ is the cumulative distribution function for the standard normal distribution.*" :question/worked-solution "Suppose that ${X}_{1},{X}_{2},…,{X}_{n}$ is a random sample of size $n$ from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ The central limit theorem (or CLT) states that for sufficiently large $n,$ the distribution of the sample mean $\\overset{―}{X}$ can be approximated as \n\n$$\n\\overset{―}{X}∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}).\n$$\n\nIn our case:\n\n- the sample size is \n\n$$\nn=101,\n$$\n\n- the population mean is\n\n$$\n\\begin{aligned}\\mu  & =\\text{E}[X] \\\\  & ={\\sum }_{i=1}^{n}{x}_{i}f({x}_{i}) \\\\  & =0\\cdot 0.1+2\\cdot 0.7+4\\cdot 0.1+8\\cdot 0.1 \\\\  & =0+1.4+0.4+0.8 \\\\  & =2.6,\\end{aligned}\n$$\n\n- the population variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\text{Var}[X] \\\\  & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =({0}^{2}\\cdot 0.1+{2}^{2}\\cdot 0.7+{4}^{2}\\cdot 0.1+{8}^{2}\\cdot 0.1)-{2.6}^{2} \\\\  & =(0+2.8+1.6+6.4)-6.76 \\\\  & =4.04.\\end{aligned}\n$$\n\nTherefore, by the CLT, we have that the distribution of the sample mean can be approximated as\n\n$$\n\\begin{aligned}\\overset{―}{X} & ∼N\\,(\\mu ,\\frac{{\\sigma }^{2}}{n}) \\\\  & ∼N\\,(2.6,\\frac{4.04}{101}) \\\\  & ∼N(2.6,0.04).\\end{aligned}\n$$\n\nWe want to find $P(2.5<\\overset{―}{X}<3).$ So, we convert $\\overset{―}{X}$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(2.5<\\overset{―}{X}<3) & ≈P(\\frac{2.5-2.6}{\\sqrt{0.04}}<Z<\\frac{3-2.6}{\\sqrt{0.04}}) \\\\  & =P(-0.5<Z<2) \\\\  & =Φ(2)-Φ(-0.5).\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\nP(2.5<\\overset{―}{X}<3)=Φ(2)-Φ(-0.5).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-64ef3aa0-5b31-5f1c-8e8c-420a16ef0aa2"] :db/ensure [:question/validate]} {:db/id "answer-field-64ef3aa0-5b31-5f1c-8e8c-420a16ef0aa2" :answer-field/id #uuid "64ef3aa0-5b31-5f1c-8e8c-420a16ef0aa2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-798138a1-9c96-5b5d-9bc0-6edae93977b1" :answer-field/choices ["answer-f67a96ba-09f5-59df-948a-4c2d70d715d1" "answer-287f4c69-8bd4-5569-9333-3f219db98ca1" "answer-728b0f84-6442-5c3f-96b2-7e64f3c56829" "answer-798138a1-9c96-5b5d-9bc0-6edae93977b1" "answer-38fb3acb-053d-552f-a825-7ddc2d36cb45"] :db/ensure [:answer-field/validate]} {:db/id "answer-f67a96ba-09f5-59df-948a-4c2d70d715d1" :answer/id #uuid "f67a96ba-09f5-59df-948a-4c2d70d715d1" :answer/type :answer.type/math :answer/value "Φ(1)-Φ(-1)" :db/ensure [:answer/validate]} {:db/id "answer-287f4c69-8bd4-5569-9333-3f219db98ca1" :answer/id #uuid "287f4c69-8bd4-5569-9333-3f219db98ca1" :answer/type :answer.type/math :answer/value "Φ(1)-Φ(-1.5)" :db/ensure [:answer/validate]} {:db/id "answer-728b0f84-6442-5c3f-96b2-7e64f3c56829" :answer/id #uuid "728b0f84-6442-5c3f-96b2-7e64f3c56829" :answer/type :answer.type/math :answer/value "Φ(1.5)-Φ(-1.5)" :db/ensure [:answer/validate]} {:db/id "answer-798138a1-9c96-5b5d-9bc0-6edae93977b1" :answer/id #uuid "798138a1-9c96-5b5d-9bc0-6edae93977b1" :answer/type :answer.type/math :answer/value "Φ(2)-Φ(-0.5)" :db/ensure [:answer/validate]} {:db/id "answer-38fb3acb-053d-552f-a825-7ddc2d36cb45" :answer/id #uuid "38fb3acb-053d-552f-a825-7ddc2d36cb45" :answer/type :answer.type/math :answer/value "Φ(2)-Φ(1)" :db/ensure [:answer/validate]} {:db/id "activity-ab995281-a9c3-5d0b-94ae-7afa02d95c26" :activity/id #uuid "ab995281-a9c3-5d0b-94ae-7afa02d95c26" :activity/title "The Central Limit Theorem" :activity/type :activity.type/review :activity/scope 17592186049014 :activity/course 17592186046658 :activity/steps ["step-9f415f4c-b363-5f1a-bfb2-ee6ede551dd6" "step-b0db31b1-c295-5a9f-ba82-4934d9313b2e" "step-01fa0c05-b1ae-5422-bc1f-94b53ddae4b0" "step-6267897a-1940-5884-b9bb-bc89d40bba6c" "step-46cbf4f5-4013-5b5c-b34e-eb95b78c70c3"] :activity/first-step "step-9f415f4c-b363-5f1a-bfb2-ee6ede551dd6" :db/ensure [:activity/validate]} {:db/id "step-9f415f4c-b363-5f1a-bfb2-ee6ede551dd6" :step/id #uuid "9f415f4c-b363-5f1a-bfb2-ee6ede551dd6" :step/content 17592186484253 :step/next "step-b0db31b1-c295-5a9f-ba82-4934d9313b2e" :db/ensure [:step/validate]} {:db/id "step-b0db31b1-c295-5a9f-ba82-4934d9313b2e" :step/id #uuid "b0db31b1-c295-5a9f-ba82-4934d9313b2e" :step/content 17592186064506 :step/next "step-01fa0c05-b1ae-5422-bc1f-94b53ddae4b0" :db/ensure [:step/validate]} {:db/id "step-01fa0c05-b1ae-5422-bc1f-94b53ddae4b0" :step/id #uuid "01fa0c05-b1ae-5422-bc1f-94b53ddae4b0" :step/content "question-1e9c32a8-c5ef-5dca-8493-0a63cb017fc2" :step/next "step-6267897a-1940-5884-b9bb-bc89d40bba6c" :db/ensure [:step/validate]} {:db/id "step-6267897a-1940-5884-b9bb-bc89d40bba6c" :step/id #uuid "6267897a-1940-5884-b9bb-bc89d40bba6c" :step/content 17592186484262 :step/next "step-46cbf4f5-4013-5b5c-b34e-eb95b78c70c3" :db/ensure [:step/validate]} {:db/id "step-46cbf4f5-4013-5b5c-b34e-eb95b78c70c3" :step/id #uuid "46cbf4f5-4013-5b5c-b34e-eb95b78c70c3" :step/content 17592186427626 :db/ensure [:step/validate]} {:db/id 17592186229161 :knowledge-point/questions ["question-e4d56835-15e1-5dd9-b189-b250c69cae71"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e4d56835-15e1-5dd9-b189-b250c69cae71" :question/id #uuid "e4d56835-15e1-5dd9-b189-b250c69cae71" :question/math-academy-id "q-334717" :question/problem "For which of the following values is the modified Euler method stable, given that $\\lambda $ is the parameter of the test equation?\n\nI. $\\lambda Δx=0.3$\n\nII. $\\lambda Δx=1.1$\n\nIII. $\\lambda Δx=1.7$\n\nIV. $\\lambda Δx=2.9$\n\n*Hint: The stability function $R$ of the modified Euler method is given by*\n\n$$\nR(\\lambda Δx)=1-\\lambda Δx+\\frac{(\\lambda Δx)^{2}}{2}.\n$$" :question/worked-solution "A numerical method\n${y}_{n+1}={y}_{n}+Δ{y}_{n}$\nis stable for a given step size $Δx$ if, when applied to the test equation\n\n$$\n{y}^{′}=-\\lambda y,\\,y(0)=1,\\,x\\ge 0,\\,\\lambda >0,\n$$\n\nthe numerical solution satisfies ${y}_{n}\\to 0$ as $n\\to \\infty ,$ just like the exact solution.\n\nWhen a method is applied to the test equation, the update takes the form\n\n$$\n{y}_{n+1}=R(\\lambda Δx){y}_{n},\n$$\n\nwhere $R(\\lambda Δx)$ is referred to as the stability function of the method. The set of values for which the method is stable, given by $|R(\\lambda Δx)|<1,$ is called the stability region of the method.\n\nThe stability function of the modified Euler method is\n\n$$\nR(\\lambda Δx)=1-\\lambda Δx+\\frac{(\\lambda Δx)^{2}}{2}.\n$$\n\nLet's check the stability of the modified Euler method for each of the given values in turn.\n\n- For $\\lambda Δx=0.3,$ we have\n\n$$\n\\begin{aligned}|R(0.3)| & =|1-0.3+\\frac{(0.3)^{2}}{2}| \\\\  & =|\\frac{149}{200}| \\\\  & =0.745<1.\\,✓\\end{aligned}\n$$\n\nSince this value falls *within* the stability region, the modified Euler method is stable.\n\n- For $\\lambda Δx=1.1,$ we have\n\n$$\n\\begin{aligned}|R(1.1)| & =|1-1.1+\\frac{(1.1)^{2}}{2}| \\\\  & =|\\frac{101}{200}| \\\\  & =0.505<1.\\,✓\\end{aligned}\n$$\n\nSince this value falls *within* the stability region, the modified Euler method is stable.\n\n- For $\\lambda Δx=1.7,$ we have\n\n$$\n\\begin{aligned}|R(1.7)| & =|1-1.7+\\frac{(1.7)^{2}}{2}| \\\\  & =|\\frac{149}{200}| \\\\  & =0.745<1.\\,✓\\end{aligned}\n$$\n\nSince this value falls *within* the stability region, the modified Euler method is stable.\n\n- For $\\lambda Δx=2.9,$ we have\n\n$$\n\\begin{aligned}|R(2.9)| & =|1-2.9+\\frac{(2.9)^{2}}{2}| \\\\  & =|\\frac{461}{200}| \\\\  & =2.305>1.\\,\\times \\end{aligned}\n$$\n\nSince this value falls *outside* the stability region, the modified Euler method is unstable.\n\nTherefore, the correct answer is \"I, II, and III only\".\n\nNote that the stability region of the modified Euler method is $0<\\lambda Δx<2,$ so it is not absolutely stable." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e7ebb238-bf1c-5419-8e2b-8b67c38f85fb"] :db/ensure [:question/validate]} {:db/id "answer-field-e7ebb238-bf1c-5419-8e2b-8b67c38f85fb" :answer-field/id #uuid "e7ebb238-bf1c-5419-8e2b-8b67c38f85fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-675fbddc-fb55-57b4-97c1-275b6152cefd" :answer-field/choices ["answer-d4cea126-5b1a-5675-bae4-21fe72227319" "answer-675fbddc-fb55-57b4-97c1-275b6152cefd" "answer-0a83fe5b-8074-5c2d-93ca-132b209dd66e" "answer-df235f97-7d7c-5f76-8fe1-ed5b46b28e82" "answer-da511c1c-87de-5875-ad76-4fd6abdb409d"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4cea126-5b1a-5675-bae4-21fe72227319" :answer/id #uuid "d4cea126-5b1a-5675-bae4-21fe72227319" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-675fbddc-fb55-57b4-97c1-275b6152cefd" :answer/id #uuid "675fbddc-fb55-57b4-97c1-275b6152cefd" :answer/type :answer.type/text :answer/value "I, II, and III only" :db/ensure [:answer/validate]} {:db/id "answer-0a83fe5b-8074-5c2d-93ca-132b209dd66e" :answer/id #uuid "0a83fe5b-8074-5c2d-93ca-132b209dd66e" :answer/type :answer.type/text :answer/value "I, II, and IV only" :db/ensure [:answer/validate]} {:db/id "answer-df235f97-7d7c-5f76-8fe1-ed5b46b28e82" :answer/id #uuid "df235f97-7d7c-5f76-8fe1-ed5b46b28e82" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-da511c1c-87de-5875-ad76-4fd6abdb409d" :answer/id #uuid "da511c1c-87de-5875-ad76-4fd6abdb409d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-e7eca05f-e99e-590a-bf49-64802c41086f" :activity/id #uuid "e7eca05f-e99e-590a-bf49-64802c41086f" :activity/title "Stability of Numerical Methods" :activity/type :activity.type/review :activity/scope 17592186049575 :activity/course 17592186046644 :activity/steps ["step-fd7e31ca-0961-5f9c-aed7-3bd1d98457f3" "step-18bfeff9-da8e-5adf-b0b0-f3f134960c7b" "step-50ccc479-0bdf-5248-b544-a38b78cc03a5" "step-236a5063-a320-5c79-a165-40f007e87d4e" "step-f438fdd3-89dd-5c2a-9c44-3d2afb1adf2d"] :activity/first-step "step-fd7e31ca-0961-5f9c-aed7-3bd1d98457f3" :db/ensure [:activity/validate]} {:db/id "step-fd7e31ca-0961-5f9c-aed7-3bd1d98457f3" :step/id #uuid "fd7e31ca-0961-5f9c-aed7-3bd1d98457f3" :step/content 17592186308464 :step/next "step-18bfeff9-da8e-5adf-b0b0-f3f134960c7b" :db/ensure [:step/validate]} {:db/id "step-18bfeff9-da8e-5adf-b0b0-f3f134960c7b" :step/id #uuid "18bfeff9-da8e-5adf-b0b0-f3f134960c7b" :step/content 17592186308467 :step/next "step-50ccc479-0bdf-5248-b544-a38b78cc03a5" :db/ensure [:step/validate]} {:db/id "step-50ccc479-0bdf-5248-b544-a38b78cc03a5" :step/id #uuid "50ccc479-0bdf-5248-b544-a38b78cc03a5" :step/content 17592186308543 :step/next "step-236a5063-a320-5c79-a165-40f007e87d4e" :db/ensure [:step/validate]} {:db/id "step-236a5063-a320-5c79-a165-40f007e87d4e" :step/id #uuid "236a5063-a320-5c79-a165-40f007e87d4e" :step/content "question-e4d56835-15e1-5dd9-b189-b250c69cae71" :step/next "step-f438fdd3-89dd-5c2a-9c44-3d2afb1adf2d" :db/ensure [:step/validate]} {:db/id "step-f438fdd3-89dd-5c2a-9c44-3d2afb1adf2d" :step/id #uuid "f438fdd3-89dd-5c2a-9c44-3d2afb1adf2d" :step/content 17592186372684 :db/ensure [:step/validate]} {:db/id 17592186078551 :knowledge-point/questions ["question-09ccf4cc-8d66-55a0-964d-b04cc4bd149d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078257 :question/worked-solution "For an angle $\\theta$ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\sin\\theta = \\dfrac{\\textrm{opposite leg}}{\\textrm{hypotenuse}}$\n\n- $\\cos\\theta = \\dfrac{\\textrm{adjacent leg}}{\\textrm{hypotenuse}}$\n\n- $\\tan\\theta = \\dfrac{\\textrm{opposite leg}}{\\textrm{adjacent leg}}$\n\nFirst, notice that we are given the length of the leg $\\overline{MO}$ opposite the given angle $\\angle{N}$ and wish to find the length of the hypotenuse $\\overline{NO}.$\n\nThe trigonometric ratio that relates the opposite leg to the hypotenuse is *sine*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(m∠N) & =\\frac{\\text{opposite leg}}{\\text{hypotenuse}} \\\\ \\operatorname{sin}⁡({32}^{∘}) & =\\frac{20}{NO} \\\\ NO\\cdot \\operatorname{sin}⁡({32}^{∘}) & =20 \\\\ NO & =\\frac{20}{\\operatorname{sin}⁡({32}^{∘})}.\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}NO & =\\frac{20}{\\operatorname{sin}⁡({32}^{∘})} \\\\  & =\\frac{20}{(0.529\\,91…)} \\\\  & =37.741\\,59… \\\\  & ≈37.7,\\end{aligned}\n$$\n\nrounded to one decimal place." :db/ensure [:question/validate]} {:db/id 17592186078552 :knowledge-point/questions ["question-75f7a455-462c-51e4-9b1a-b0d79be3c2a9" "question-65457b1f-86ca-5676-81db-c0f19c1bbed5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078256 :question/problem "Given the triangle below, find the length of $\\overline{MN}$ rounded to one decimal place. \n\n![](images/db/db0c3be4d3f18a55bfbd763e4017bdabd6c27ba7b498e21909baa4aea3d44337.png)" :question/worked-solution "For an angle $\\theta$ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\sin\\theta = \\dfrac{\\textrm{opposite leg}}{\\textrm{hypotenuse}}$\n\n- $\\cos\\theta = \\dfrac{\\textrm{adjacent leg}}{\\textrm{hypotenuse}}$\n\n- $\\tan\\theta = \\dfrac{\\textrm{opposite leg}}{\\textrm{adjacent leg}}$\n\nFirst, note that we are given the length of the hypotenuse $\\overline{NO}$ and wish to find the length of the leg $\\overline{MN}$ adjacent to the given angle $\\angle{N}.$\n\nThe trigonometric ratio that relates the adjacent leg to the hypotenuse is *cosine*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(m∠N) & =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}} \\\\ \\operatorname{cos}⁡({25}^{∘}) & =\\frac{MN}{14} \\\\ MN & =14\\operatorname{cos}⁡({25}^{∘}).\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}MN & =14\\operatorname{cos}⁡({25}^{∘}) \\\\  & =14(0.906\\,30…) \\\\  & =12.688\\,30… \\\\  & ≈12.7,\\end{aligned}\n$$\n\nrounded to one decimal place." :db/ensure [:question/validate]} {:db/id 17592186078553 :knowledge-point/questions ["question-2ca7cacc-1a5f-515a-8db1-0999afb66a6b" "question-f70a7592-ca8c-59ec-84a8-2fae0d3e16cd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078258 :question/problem "Given the triangle below, find the length of $\\overline{BC}$ in terms of $\\theta.$\n\n![](images/8b/8b1f3d7e1d87c7021970f45279bb404b4e9998a9d351d1e95616dac98f80d45d.png)" :question/worked-solution "For an angle $\\theta$ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\sin\\theta = \\dfrac{\\textrm{opposite leg}}{\\textrm{hypotenuse}}$\n\n- $\\cos\\theta = \\dfrac{\\textrm{adjacent leg}}{\\textrm{hypotenuse}}$\n\n- $\\tan\\theta = \\dfrac{\\textrm{opposite leg}}{\\textrm{adjacent leg}}$\n\nNotice that we are given the length of the leg $\\overline{AB}$ adjacent to the given angle $\\angle A$ and wish to find the length of the leg $\\overline{BC}$ opposite $\\angle A.$\n\nThe trigonometric ratio that relates the opposite leg to the adjacent leg is *tangent*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{\\text{opposite leg}}{\\text{adjacent leg}} \\\\ \\operatorname{tan}⁡\\theta  & =\\frac{BC}{15} \\\\ BC & =15\\operatorname{tan}⁡\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-09ccf4cc-8d66-55a0-964d-b04cc4bd149d" :question/id #uuid "09ccf4cc-8d66-55a0-964d-b04cc4bd149d" :question/math-academy-id "q-122318" :question/problem "![](images/42/42d1bf23b4ce679748fb1c1765d568b0b32128155f3d6e7770a1b894b0888ded.png)\n\nGiven the triangle above, find the length of $\\overset{―}{LM}$ in terms of $\\theta .$" :question/worked-solution "For an angle $\\theta $ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\operatorname{sin}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{cos}⁡\\theta =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{adjacent leg}}$\n\nFirst, note that we are given the length of the leg $\\overset{―}{MN}$ opposite the given angle $m∠L$  and wish to find the length of the hypotenuse $\\overset{―}{LM}.$\n\nThe trigonometric ratio that relates the opposite leg to the hypotenuse is *sine*. Therefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(m∠L) & =\\frac{\\text{opposite leg}}{\\text{hypotenuse}} \\\\ \\operatorname{sin}⁡\\theta  & =\\frac{6}{LM} \\\\ LM\\operatorname{sin}⁡\\theta  & =6 \\\\ LM & =\\frac{6}{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-54e274fe-1093-5ef9-96b5-8767338dcb8e"] :db/ensure [:question/validate]} {:db/id "answer-field-54e274fe-1093-5ef9-96b5-8767338dcb8e" :answer-field/id #uuid "54e274fe-1093-5ef9-96b5-8767338dcb8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5f6afbe9-ac3a-5da9-89bf-afe8b4e58c15" :answer-field/choices ["answer-2329be16-9869-58b3-832e-c57647b69a44" "answer-b1822c7c-3f66-5e3b-9c5b-29a54cb930bc" "answer-5f6afbe9-ac3a-5da9-89bf-afe8b4e58c15" "answer-9957aacc-6748-5d81-bccb-17c654f8f56d" "answer-5a04c960-211f-5108-a49f-0a5ff1afbb3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-2329be16-9869-58b3-832e-c57647b69a44" :answer/id #uuid "2329be16-9869-58b3-832e-c57647b69a44" :answer/type :answer.type/math :answer/value "3\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b1822c7c-3f66-5e3b-9c5b-29a54cb930bc" :answer/id #uuid "b1822c7c-3f66-5e3b-9c5b-29a54cb930bc" :answer/type :answer.type/math :answer/value "6\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-5f6afbe9-ac3a-5da9-89bf-afe8b4e58c15" :answer/id #uuid "5f6afbe9-ac3a-5da9-89bf-afe8b4e58c15" :answer/type :answer.type/math :answer/value "\\frac{6}{\\operatorname{sin}⁡\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-9957aacc-6748-5d81-bccb-17c654f8f56d" :answer/id #uuid "9957aacc-6748-5d81-bccb-17c654f8f56d" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡\\theta }{6}" :db/ensure [:answer/validate]} {:db/id "answer-5a04c960-211f-5108-a49f-0a5ff1afbb3a" :answer/id #uuid "5a04c960-211f-5108-a49f-0a5ff1afbb3a" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta +6" :db/ensure [:answer/validate]} {:db/id 17592186079115 :question/problem "![](images/32/32938bfdcb2ed9130304722b408b304802062b701bb35c68d7d3333c7cfe8ee6.png)\n\nGiven the triangle above, find the length of $\\overset{―}{AB}$ rounded to one decimal place." :question/worked-solution "For an angle $\\theta $ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\operatorname{sin}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{cos}⁡\\theta =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{adjacent leg}}$\n\nFirst, note that we are given the length of the hypotenuse $\\overset{―}{AC}$ and wish to find the length of the leg $\\overset{―}{AB}$ opposite the given angle $∠C.$\n\nThe trigonometric ratio that relates the opposite leg to the hypotenuse is *sine*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(m∠C) & =\\frac{\\text{opposite leg}}{\\text{hypotenuse}} \\\\ \\operatorname{sin}⁡({52}^{∘}) & =\\frac{AB}{15} \\\\ AB & =15\\operatorname{sin}⁡({52}^{∘}).\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}AB & =15\\operatorname{sin}⁡({52}^{∘}) \\\\  & =15(0.788\\,01…) \\\\  & =11.820\\,16… \\\\  & ≈11.8,\\end{aligned}\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186077468 :answer-field/correct 17592186077472 :db/ensure [:answer-field/validate]} {:db/id "question-75f7a455-462c-51e4-9b1a-b0d79be3c2a9" :question/id #uuid "75f7a455-462c-51e4-9b1a-b0d79be3c2a9" :question/math-academy-id "q-54245" :question/problem "A triangle $△ABC$ has $m∠A={37}^{∘},$ $m∠B={90}^{∘},$ and $AC=25.$ Find $AB$ rounded to the nearest integer." :question/worked-solution "For an angle $\\theta $ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\operatorname{sin}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{cos}⁡\\theta =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{adjacent leg}}$\n\nFirst, let's sketch the given triangle.\n\n![](images/70/70ac3cbbc7209f71bd8095bb725d1dbb847c827bdfdc8220c25115fb120532b4.png)\n\nFirst, note that we are given the length of the hypotenuse $\\overset{―}{AC}$ and wish to find the length of the leg $\\overset{―}{AB}$ adjacent to the given angle $∠A.$\n\nThe trigonometric ratio that relates the adjacent leg to the hypotenuse is *cosine*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(m∠A) & =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}} \\\\ \\operatorname{cos}⁡({37}^{∘}) & =\\frac{AB}{25} \\\\ AB & =25\\operatorname{cos}⁡({37}^{∘}).\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}AB & =25\\operatorname{cos}⁡({37}^{∘}) \\\\  & =25(0.798\\,63…) \\\\  & =19.965\\,88… \\\\  & ≈20,\\end{aligned}\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e95f0005-9800-5362-8d1e-5d401889c55d"] :db/ensure [:question/validate]} {:db/id "answer-field-e95f0005-9800-5362-8d1e-5d401889c55d" :answer-field/id #uuid "e95f0005-9800-5362-8d1e-5d401889c55d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c1510748-41d4-53d6-9916-52c67c514acd" :answer-field/choices ["answer-a25f7d74-887f-51bb-bf47-0e657f573c50" "answer-2c72506b-8c94-5289-96d5-369a216625af" "answer-7b799199-b32c-5119-bed5-f2daf8adb220" "answer-c1510748-41d4-53d6-9916-52c67c514acd" "answer-7c04ca98-cf65-54f5-b0a9-cdfa36672625"] :db/ensure [:answer-field/validate]} {:db/id "answer-a25f7d74-887f-51bb-bf47-0e657f573c50" :answer/id #uuid "a25f7d74-887f-51bb-bf47-0e657f573c50" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-2c72506b-8c94-5289-96d5-369a216625af" :answer/id #uuid "2c72506b-8c94-5289-96d5-369a216625af" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "answer-7b799199-b32c-5119-bed5-f2daf8adb220" :answer/id #uuid "7b799199-b32c-5119-bed5-f2daf8adb220" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-c1510748-41d4-53d6-9916-52c67c514acd" :answer/id #uuid "c1510748-41d4-53d6-9916-52c67c514acd" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-7c04ca98-cf65-54f5-b0a9-cdfa36672625" :answer/id #uuid "7c04ca98-cf65-54f5-b0a9-cdfa36672625" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "question-65457b1f-86ca-5676-81db-c0f19c1bbed5" :question/id #uuid "65457b1f-86ca-5676-81db-c0f19c1bbed5" :question/math-academy-id "q-250820" :question/problem "A triangle $△ABC$ has $m∠A={38}^{∘},$ $m∠B={90}^{∘},$ and $AC=18.$ Find $AB$ rounded to the nearest integer.\n\n$AB≈${{field-1}}" :question/worked-solution "For an angle $\\theta $ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\operatorname{sin}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{cos}⁡\\theta =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{adjacent leg}}$\n\nFirst, let's sketch the given triangle.\n\n![](images/d0/d097dca887930886a231b4b3a71e3236edcc25ec50a886f197a8c3111ff064fb.png)\n\nFirst, note that we are given the length of the hypotenuse $\\overset{―}{AC}$ and wish to find the length of the leg $\\overset{―}{AB}$ adjacent to the given angle $∠A.$\n\nThe trigonometric ratio that relates the adjacent leg to the hypotenuse is *cosine*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(m∠A) & =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}} \\\\ \\operatorname{cos}⁡({38}^{∘}) & =\\frac{AB}{18} \\\\ AB & =18\\operatorname{cos}⁡({38}^{∘}).\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}AB & =18\\operatorname{cos}⁡({38}^{∘}) \\\\  & =18(0.788\\,01…) \\\\  & =14.184\\,19… \\\\  & ≈14,\\end{aligned}\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-43fabf49-a3c3-59b9-b08d-71606020d7d9"] :db/ensure [:question/validate]} {:db/id "answer-field-43fabf49-a3c3-59b9-b08d-71606020d7d9" :answer-field/id #uuid "43fabf49-a3c3-59b9-b08d-71606020d7d9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f3255099-9357-5a64-bef8-7531c32dcdb0" :answer-field/choices ["answer-f3255099-9357-5a64-bef8-7531c32dcdb0"] :db/ensure [:answer-field/validate]} {:db/id "answer-f3255099-9357-5a64-bef8-7531c32dcdb0" :answer/id #uuid "f3255099-9357-5a64-bef8-7531c32dcdb0" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "question-2ca7cacc-1a5f-515a-8db1-0999afb66a6b" :question/id #uuid "2ca7cacc-1a5f-515a-8db1-0999afb66a6b" :question/math-academy-id "q-122362" :question/problem "![](images/80/804c19a20b6f47707a07c7bdcee3cbd727eec2c270109e30eb55d949ace8edf0.png)\n\nCalculate the value of $BC$ to the nearest integer." :question/worked-solution "For an angle $\\theta $ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\operatorname{sin}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{cos}⁡\\theta =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{adjacent leg}}$\n\nNotice that we are given the length of the leg $\\overset{―}{AC}$ opposite to the given angle $∠B$ and wish to find the length of the leg $\\overset{―}{BC}$ adjacent $∠B.$\n\nThe trigonometric ratio that relates the opposite leg to the adjacent leg is *tangent*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠B) & =\\frac{\\text{opposite leg}}{\\text{adjacent leg}} \\\\ \\operatorname{tan}⁡({20}^{∘}) & =\\frac{2.91}{BC} \\\\ BC\\cdot \\operatorname{tan}⁡({20}^{∘}) & =2.91 \\\\ BC & =\\frac{2.91}{\\operatorname{tan}⁡({20}^{∘})}.\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}BC & =\\frac{2.91}{\\operatorname{tan}⁡({20}^{∘})} \\\\  & =\\frac{2.91}{(0.363\\,97…)} \\\\  & =7.995\\,15… \\\\  & ≈8,\\end{aligned}\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-da843738-07b4-5faf-bd43-39de4fed6f05"] :db/ensure [:question/validate]} {:db/id "answer-field-da843738-07b4-5faf-bd43-39de4fed6f05" :answer-field/id #uuid "da843738-07b4-5faf-bd43-39de4fed6f05" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-24a468a5-e58e-57bc-b82a-35381d14f313" :answer-field/choices ["answer-31f46001-c019-5e7a-b980-818bd58d8124" "answer-072ae5a3-56fd-5113-989d-660f16471484" "answer-45d6a559-84b7-5a2e-8ca5-baed1b46e2cb" "answer-24a468a5-e58e-57bc-b82a-35381d14f313" "answer-f74b5019-f040-540c-9f33-bd17a0a96652"] :db/ensure [:answer-field/validate]} {:db/id "answer-31f46001-c019-5e7a-b980-818bd58d8124" :answer/id #uuid "31f46001-c019-5e7a-b980-818bd58d8124" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-072ae5a3-56fd-5113-989d-660f16471484" :answer/id #uuid "072ae5a3-56fd-5113-989d-660f16471484" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-45d6a559-84b7-5a2e-8ca5-baed1b46e2cb" :answer/id #uuid "45d6a559-84b7-5a2e-8ca5-baed1b46e2cb" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-24a468a5-e58e-57bc-b82a-35381d14f313" :answer/id #uuid "24a468a5-e58e-57bc-b82a-35381d14f313" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-f74b5019-f040-540c-9f33-bd17a0a96652" :answer/id #uuid "f74b5019-f040-540c-9f33-bd17a0a96652" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-f70a7592-ca8c-59ec-84a8-2fae0d3e16cd" :question/id #uuid "f70a7592-ca8c-59ec-84a8-2fae0d3e16cd" :question/math-academy-id "q-122357" :question/problem "![](images/a9/a9c863e0cdb9788e06c527e17207e87ba2281ab21c9bd0836009ca518a15631a.png)\n\nGiven the triangle above, find the length of $\\overset{―}{AB}$ rounded to one decimal place." :question/worked-solution "For an angle $\\theta $ in a right triangle, the trigonometric ratios are as follows:\n\n- $\\operatorname{sin}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{cos}⁡\\theta =\\frac{\\text{adjacent leg}}{\\text{hypotenuse}}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite leg}}{\\text{adjacent leg}}$\n\nNotice that we are given the length of the leg $\\overset{―}{BC}$ adjacent to the given angle $∠C$ and wish to find the length of the leg $\\overset{―}{AB}$ opposite $∠C.$\n\nThe trigonometric ratio that relates the opposite leg to the adjacent leg is *tangent*. Hence,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠C) & =\\frac{\\text{opposite leg}}{\\text{adjacent leg}} \\\\ \\operatorname{tan}⁡({56}^{∘}) & =\\frac{AB}{9} \\\\ AB & =9\\operatorname{tan}⁡({56}^{∘}).\\end{aligned}\n$$\n\nUsing a calculator to evaluate the trigonometric ratio, we conclude that\n\n$$\n\\begin{aligned}AB & =9\\operatorname{tan}⁡({56}^{∘}) \\\\  & =9(1.482\\,56…) \\\\  & =13.343\\,04… \\\\  & ≈13.3,\\end{aligned}\n$$\n\nrounded to one decimal place." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b60226c5-c082-582a-8e44-74900cca7bba"] :db/ensure [:question/validate]} {:db/id "answer-field-b60226c5-c082-582a-8e44-74900cca7bba" :answer-field/id #uuid "b60226c5-c082-582a-8e44-74900cca7bba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd4f9b02-26de-5ae1-8b55-ca9d1da42382" :answer-field/choices ["answer-c52fb001-1c61-5604-8c36-8c5eca7540da" "answer-7984a7a2-3d6d-5651-a31e-9d9abb8af095" "answer-4495747d-0147-5c33-a7dd-cc1052f4f100" "answer-cd4f9b02-26de-5ae1-8b55-ca9d1da42382" "answer-2bbe2bc1-39d1-58da-9eea-f7dc76f0f445"] :db/ensure [:answer-field/validate]} {:db/id "answer-c52fb001-1c61-5604-8c36-8c5eca7540da" :answer/id #uuid "c52fb001-1c61-5604-8c36-8c5eca7540da" :answer/type :answer.type/math :answer/value "11.8" :db/ensure [:answer/validate]} {:db/id "answer-7984a7a2-3d6d-5651-a31e-9d9abb8af095" :answer/id #uuid "7984a7a2-3d6d-5651-a31e-9d9abb8af095" :answer/type :answer.type/math :answer/value "12.7" :db/ensure [:answer/validate]} {:db/id "answer-4495747d-0147-5c33-a7dd-cc1052f4f100" :answer/id #uuid "4495747d-0147-5c33-a7dd-cc1052f4f100" :answer/type :answer.type/math :answer/value "13.0" :db/ensure [:answer/validate]} {:db/id "answer-cd4f9b02-26de-5ae1-8b55-ca9d1da42382" :answer/id #uuid "cd4f9b02-26de-5ae1-8b55-ca9d1da42382" :answer/type :answer.type/math :answer/value "13.3" :db/ensure [:answer/validate]} {:db/id "answer-2bbe2bc1-39d1-58da-9eea-f7dc76f0f445" :answer/id #uuid "2bbe2bc1-39d1-58da-9eea-f7dc76f0f445" :answer/type :answer.type/math :answer/value "14.5" :db/ensure [:answer/validate]} {:db/id 17592186079639 :tutorial/content "Trigonometric ratios can be used to solve for a missing side of a right triangle if one side is known along with the measure of an acute angle. However, the question of which ratio to use depends on what side is given and what side is unknown. \n\n![](images/8b/8b123fed4a9a42ceb69f3a6ff68ed89f27ae42294137f0cd12a9232d329d77b0.png)\n\nIn the triangle above, we are given an angle $\\theta = 42^\\circ,$ and the length of the hypotenuse is given but the length of the side opposite is unknown.\n\nSo, we need to choose the trigonometric ratio that relates the opposite side to the hypotenuse. This is sine, and now we can just set up the ratio, as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡{42}^{∘} & =\\frac{\\text{opposite}}{\\text{hypotenuse}} \\\\  & =\\frac{x}{8}\\end{aligned}\n$$\n\nNow, we simply solve for the unknown value $x,$ as follows:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡{42}^{∘} & =\\frac{x}{8} \\\\ x & =8\\operatorname{sin}⁡{42}^{∘} \\\\  & =8(0.669\\,13...) \\\\  & =5.353\\,04... \\\\  & ≈5.4,\\end{aligned}\n$$\n\nrounded to the nearest tenth.\n\nNote that we used a calculator to evaluate $\\sin(42^\\circ).$" :db/ensure [:tutorial/validate]} {:db/id 17592186078654 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} {:db/id 17592186133886 :knowledge-point/questions ["question-881df761-fca2-5afa-aea8-d6a6e63a7521"] :db/ensure [:knowledge-point/validate]} {:db/id "question-881df761-fca2-5afa-aea8-d6a6e63a7521" :question/id #uuid "881df761-fca2-5afa-aea8-d6a6e63a7521" :question/math-academy-id "q-126866" :question/problem "![](images/0f/0f1dd3c66e3bf7d25f286720b360d6af1d6361804ab3ff52835d94f78e5084ee.png)\n\nCalculate ${∮}_{∂D}-3y\\,dx+2x\\,dy,$ where $D$ is the region shown above." :question/worked-solution "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $P$ and $Q$ have continuous first partial derivatives on an open region containing $D,$ then Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nGreen's theorem can be extended to include regions containing holes. In such cases, we can apply Green's theorem in the same way as before.\n\nWe have that $P(x,y)=-3y$ and $Q(x,y)=2x.$ So,\n\n$$\n\\frac{∂P}{∂y}=-3,\\,\\frac{∂Q}{∂x}=2.\n$$\n\nTherefore, applying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{∂D}-3y\\,dx+2x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∬}_{D}(2-(-3))\\,\\text{d}A \\\\  & ={∬}_{D}5\\,\\text{d}A \\\\  & =5{∬}_{D}\\,\\text{d}A \\\\  & =5\\cdot \\text{Area}(D) \\\\  & =5\\cdot ({4}^{2}-\\frac{2\\cdot 2}{2}) \\\\  & =5\\cdot (16-2) \\\\  & =5\\cdot 14 \\\\  & =70.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-69041780-f401-5aab-a5e0-f58cc39dca02"] :db/ensure [:question/validate]} {:db/id "answer-field-69041780-f401-5aab-a5e0-f58cc39dca02" :answer-field/id #uuid "69041780-f401-5aab-a5e0-f58cc39dca02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0662a46f-bec7-54ca-b240-f60d5d5f1afc" :answer-field/choices ["answer-12efe453-d9bc-5e34-bdeb-04e1a1d22aee" "answer-d13ea829-20bc-5000-ad9a-b878fad5ad6b" "answer-a0fe6c9c-6868-551d-8a19-e70fb67ab8d4" "answer-0e19b2e0-2b38-57c0-b50d-3e99a4fb345c" "answer-0662a46f-bec7-54ca-b240-f60d5d5f1afc"] :db/ensure [:answer-field/validate]} {:db/id "answer-12efe453-d9bc-5e34-bdeb-04e1a1d22aee" :answer/id #uuid "12efe453-d9bc-5e34-bdeb-04e1a1d22aee" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-d13ea829-20bc-5000-ad9a-b878fad5ad6b" :answer/id #uuid "d13ea829-20bc-5000-ad9a-b878fad5ad6b" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-a0fe6c9c-6868-551d-8a19-e70fb67ab8d4" :answer/id #uuid "a0fe6c9c-6868-551d-8a19-e70fb67ab8d4" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-0e19b2e0-2b38-57c0-b50d-3e99a4fb345c" :answer/id #uuid "0e19b2e0-2b38-57c0-b50d-3e99a4fb345c" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "answer-0662a46f-bec7-54ca-b240-f60d5d5f1afc" :answer/id #uuid "0662a46f-bec7-54ca-b240-f60d5d5f1afc" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "activity-b43c564a-026d-55f8-9ded-681ee43fa117" :activity/id #uuid "b43c564a-026d-55f8-9ded-681ee43fa117" :activity/title "Extending Green's Theorem" :activity/type :activity.type/review :activity/scope 17592186050560 :activity/course 17592186046644 :activity/steps ["step-8b29823e-1d02-5228-87de-cfdd6eddac82" "step-48cb7736-a399-57ef-8551-b03d268a4144" "step-02b0f97c-a1c4-5de3-9e6c-ca0b67ea4390" "step-dcca2676-1c39-51b2-9647-11d87db779a0" "step-7855bb63-c81b-53d8-a3eb-d50bbb715b43"] :activity/first-step "step-8b29823e-1d02-5228-87de-cfdd6eddac82" :db/ensure [:activity/validate]} {:db/id "step-8b29823e-1d02-5228-87de-cfdd6eddac82" :step/id #uuid "8b29823e-1d02-5228-87de-cfdd6eddac82" :step/content 17592186431351 :step/next "step-48cb7736-a399-57ef-8551-b03d268a4144" :db/ensure [:step/validate]} {:db/id "step-48cb7736-a399-57ef-8551-b03d268a4144" :step/id #uuid "48cb7736-a399-57ef-8551-b03d268a4144" :step/content 17592186369455 :step/next "step-02b0f97c-a1c4-5de3-9e6c-ca0b67ea4390" :db/ensure [:step/validate]} {:db/id "step-02b0f97c-a1c4-5de3-9e6c-ca0b67ea4390" :step/id #uuid "02b0f97c-a1c4-5de3-9e6c-ca0b67ea4390" :step/content 17592186369469 :step/next "step-dcca2676-1c39-51b2-9647-11d87db779a0" :db/ensure [:step/validate]} {:db/id "step-dcca2676-1c39-51b2-9647-11d87db779a0" :step/id #uuid "dcca2676-1c39-51b2-9647-11d87db779a0" :step/content "question-881df761-fca2-5afa-aea8-d6a6e63a7521" :step/next "step-7855bb63-c81b-53d8-a3eb-d50bbb715b43" :db/ensure [:step/validate]} {:db/id "step-7855bb63-c81b-53d8-a3eb-d50bbb715b43" :step/id #uuid "7855bb63-c81b-53d8-a3eb-d50bbb715b43" :step/content 17592186441618 :db/ensure [:step/validate]} {:db/id 17592186078420 :knowledge-point/questions ["question-a8cf8516-d7bc-5fa0-86d7-e74e836777c8" "question-201f78ad-e932-54f4-94ee-8dd6f6a1154d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078194 :question/problem "What is the common difference of the following arithmetic sequence?\n\n$$\n7,\\: 2,\\: -3,\\: -8,\\: \\ldots\n$$" :question/worked-solution "The common difference $d$ of an arithmetic sequence is the difference between any two consecutive terms.\n\nTherefore, the common difference for our sequence is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =2-7 \\\\  & =-5.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078421 :knowledge-point/questions ["question-8dd21bc7-cc1c-556a-83c5-25089927d9b3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078179 :question/problem "Which of the three sequences below are arithmetic sequences?\n\nI. $2, \\: 4, \\: 6, \\: 8, \\: \\ldots$\n\nII. $5, \\: 2, \\: -1, \\: -4, \\: \\ldots$\n\nIII. $2, \\: 5, \\: 8, \\: 12, \\: \\ldots$" :question/worked-solution "To determine whether each sequence is an arithmetic sequence, we need to look at the jumps between terms in the sequence. If the jumps are the same, then they indeed represent a common difference of an arithmetic sequence.\n\n- In sequence I, the jumps are all the same. Therefore, sequence I is an arithmetic sequence with common difference $d=2.$\n\n![](images/17/17933a1cabd8d487dd1607f7ae7064d6e186e3454a52497977f866150c491f25.png)\n\n- In sequence II, the jumps are all the same. Therefore, sequence II is an arithmetic sequence with common difference $d=-3.$\n\n![](images/9d/9d9a41035215deb27d0578123a859d9b492b505d79b0a0a71f62c822942298ca.png)\n\n- In sequence III, the jumps are not all the same. Therefore, sequence III is not an arithmetic sequence.\n\n![](images/2b/2b860338be6ff8876c1368ed5f08162096873fa9992a9e88d7ff545752a5bd36.png)\n\nIn conclusion, only sequences I and II are arithmetic sequences." :db/ensure [:question/validate]} {:db/id 17592186078422 :knowledge-point/questions ["question-b7af1a90-ae65-5ea4-82bf-4487562443e4" "question-d4919d08-0fd6-56c9-962f-b38905295542"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078180 :question/problem "What is the $8$th term of the following arithmetic sequence?\n\n$$\n4, \\: 7, \\: 10, \\: 13, \\: 16, \\: \\ldots\n$$" :question/worked-solution "![](images/ac/ac878a3d258fa19641d983863580af953bbea593b49bffff16f2f09eb7b6ab2d.png)\n\nWe notice that the sequence is an arithmetic sequence with a common difference of \n\n$$\nd=7-4=3.\n$$\n\nSo, we can calculate each term in the sequence by adding $3$ to the previous term. \n\nWe will continue listing terms of the sequence until we get to the $8$th term. Listing the terms up to the $8$th term, we have:\n\n![](images/e5/e536739b28db7d0f221967ce8729eee502a29f80caec8e1c39f61a9cfe4a6459.png)\n\nTherefore, the $8$th term is $25.$" :db/ensure [:question/validate]} {:db/id "question-a8cf8516-d7bc-5fa0-86d7-e74e836777c8" :question/id #uuid "a8cf8516-d7bc-5fa0-86d7-e74e836777c8" :question/math-academy-id "q-67189" :question/problem "What is the common difference for the following arithmetic sequence?\n\n$$\n-5,\\,-12,\\,-19,\\,-26,\\,…\n$$" :question/worked-solution "The common difference $d$ of an arithmetic sequence is the difference between any two consecutive terms.\n\nTherefore, the common difference for our sequence is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-12-(-5) \\\\  & =-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-68361dd6-1e8b-506a-8578-5b4e969159f0"] :db/ensure [:question/validate]} {:db/id "answer-field-68361dd6-1e8b-506a-8578-5b4e969159f0" :answer-field/id #uuid "68361dd6-1e8b-506a-8578-5b4e969159f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-92bf199e-afa9-59a0-99c5-39dc96c0e3eb" :answer-field/choices ["answer-92bf199e-afa9-59a0-99c5-39dc96c0e3eb" "answer-f8f2817a-212b-5b87-9b74-644f72a88914" "answer-98ceb62e-64c1-53d3-898f-8c9877f2dbac" "answer-b6c3c789-1301-5acb-8ade-6ed3fe3ea32e" "answer-bf290a1a-2ea6-5f25-a62a-e7695091261d"] :db/ensure [:answer-field/validate]} {:db/id "answer-92bf199e-afa9-59a0-99c5-39dc96c0e3eb" :answer/id #uuid "92bf199e-afa9-59a0-99c5-39dc96c0e3eb" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-f8f2817a-212b-5b87-9b74-644f72a88914" :answer/id #uuid "f8f2817a-212b-5b87-9b74-644f72a88914" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-98ceb62e-64c1-53d3-898f-8c9877f2dbac" :answer/id #uuid "98ceb62e-64c1-53d3-898f-8c9877f2dbac" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-b6c3c789-1301-5acb-8ade-6ed3fe3ea32e" :answer/id #uuid "b6c3c789-1301-5acb-8ade-6ed3fe3ea32e" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-bf290a1a-2ea6-5f25-a62a-e7695091261d" :answer/id #uuid "bf290a1a-2ea6-5f25-a62a-e7695091261d" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-201f78ad-e932-54f4-94ee-8dd6f6a1154d" :question/id #uuid "201f78ad-e932-54f4-94ee-8dd6f6a1154d" :question/math-academy-id "q-215844" :question/problem "Consider the following arithmetic sequence.\n\n$$\n-22,\\,-31,\\,-40,\\,-49,\\,…\n$$\n\nThe common difference of this arithmetic sequence is{{field-1}}." :question/worked-solution "The common difference $d$ of an arithmetic sequence is the difference between any two consecutive terms.\n\nTherefore, the common difference for our sequence is\n\n$$\n\\begin{aligned}d & ={a}_{2}-{a}_{1} \\\\  & =-31-(-22) \\\\  & =-31+22 \\\\  & =-9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d52aac11-c9ed-51ba-b011-6d52463e90a6"] :db/ensure [:question/validate]} {:db/id "answer-field-d52aac11-c9ed-51ba-b011-6d52463e90a6" :answer-field/id #uuid "d52aac11-c9ed-51ba-b011-6d52463e90a6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e72b408f-9678-5df5-8e3c-c25bf6966626" :answer-field/choices ["answer-e72b408f-9678-5df5-8e3c-c25bf6966626"] :db/ensure [:answer-field/validate]} {:db/id "answer-e72b408f-9678-5df5-8e3c-c25bf6966626" :answer/id #uuid "e72b408f-9678-5df5-8e3c-c25bf6966626" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "question-8dd21bc7-cc1c-556a-83c5-25089927d9b3" :question/id #uuid "8dd21bc7-cc1c-556a-83c5-25089927d9b3" :question/math-academy-id "q-100790" :question/problem "Which of the three sequences below are arithmetic sequences?\n\nI. $-2,\\,-4,\\,-6,\\,-8,...$\n\nII. $-2,\\,-9,\\,-16,\\,-23,...$\n\nIII. $-2,\\,4,\\,10,\\,16,...$" :question/worked-solution "To determine whether each sequence is an arithmetic sequence, we need to look at the jumps between terms in the sequence. If the jumps are the same, then they indeed represent a common difference of an arithmetic sequence. \n\n- In sequence I, the jumps are all the same. Therefore, sequence I is an arithmetic sequence with common difference $d=-2.$\n\n![](images/c5/c599604e6630b0dbf74d646f93b6330b5d310f35bfbce7b008f16d1686534c77.png)\n\n- In sequence II, the jumps are all the same. Therefore, sequence II is an arithmetic sequence with common difference $d=-7.$\n\n![](images/b3/b35cc27bfa6f7fe2171529a0c84e9ab8d33c122e932512fae1b06fe21cc9bc94.png)\n\n- In sequence III, the jumps are all the same. Therefore, sequence III is an arithmetic sequence with common difference $d=6.$\n\n![](images/9a/9aa43107c2b5c975450590f4bc126273b45ddc72f1acfd3d35eadff0313ded1b.png)\n\nIn conclusion, sequences I, II, and III are arithmetic sequences." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-002ab7e3-3e7c-58af-a8be-ddecace186b6"] :db/ensure [:question/validate]} {:db/id "answer-field-002ab7e3-3e7c-58af-a8be-ddecace186b6" :answer-field/id #uuid "002ab7e3-3e7c-58af-a8be-ddecace186b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de35765a-9e00-5086-b227-e972d3a9760d" :answer-field/choices ["answer-a28412fa-c9d8-5d99-a377-d20b7d99d741" "answer-9e210bae-211c-59b1-92d0-fc04eb55e1e3" "answer-de35765a-9e00-5086-b227-e972d3a9760d" "answer-9ae2ab66-e8cf-5ba6-85d1-13ea1914a405" "answer-cc568d89-df8b-57de-99ef-c6cc9273d3ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-a28412fa-c9d8-5d99-a377-d20b7d99d741" :answer/id #uuid "a28412fa-c9d8-5d99-a377-d20b7d99d741" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-9e210bae-211c-59b1-92d0-fc04eb55e1e3" :answer/id #uuid "9e210bae-211c-59b1-92d0-fc04eb55e1e3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-de35765a-9e00-5086-b227-e972d3a9760d" :answer/id #uuid "de35765a-9e00-5086-b227-e972d3a9760d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-9ae2ab66-e8cf-5ba6-85d1-13ea1914a405" :answer/id #uuid "9ae2ab66-e8cf-5ba6-85d1-13ea1914a405" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-cc568d89-df8b-57de-99ef-c6cc9273d3ad" :answer/id #uuid "cc568d89-df8b-57de-99ef-c6cc9273d3ad" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186078883 :question/problem "Which of the three sequences below are arithmetic sequences?\n\nI. $6,10,14,18,...$\n\nII. $4,8,16,32,...$\n\nIII. $87,74,61,46,...$" :question/worked-solution "To determine whether each sequence is an arithmetic sequence, we need to look at the jumps between terms in the sequence. If the jumps are the same, then they indeed represent a common difference of an arithmetic sequence.\n\n- In sequence I, the jumps are all the same. Therefore, sequence I is an arithmetic sequence with common difference $d=4.$\n\n![](images/bb/bbb6555443ed4fdf7f29da4571d421b833fb21e2556a440d821bbd4e4b986923.png)\n\n- In sequence II, the jumps are not all the same. Therefore, sequence II is not an arithmetic sequence.\n\n![](images/64/6408dd510dd59615c69c063897a6ff483c20bc485d73164e74c2f57dacc4dce8.png)\n\n- In sequence III, the jumps are not all the same. Therefore, sequence III is not an arithmetic sequence.\n\n![](images/24/246210488611eed52df8d3e777e296bff30889c7dd8122d082c5d4a6bb6d7ad6.png)\n\nIn conclusion, only sequence I is an arithmetic sequence." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186076076 :answer-field/correct 17592186076079 :db/ensure [:answer-field/validate]} {:db/id "question-b7af1a90-ae65-5ea4-82bf-4487562443e4" :question/id #uuid "b7af1a90-ae65-5ea4-82bf-4487562443e4" :question/math-academy-id "q-19977" :question/problem "Find the third term of an arithmetic sequence if the first term is $23$ and the common difference is $-7.$" :question/worked-solution "We will list terms of the sequence until we get to the third term. \n\nWe start with the first term $23,$ and then we calculate each subsequent term by subtracting $7$ from the previous term:\n\n![](images/86/86fe86315966ba57e674e652510c2814ab94f0cf8869656c9fa3b7c934801b9f.png)\n\nTherefore, the third term is $9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ab00a963-1cd0-5605-a266-0b494ab59620"] :db/ensure [:question/validate]} {:db/id "answer-field-ab00a963-1cd0-5605-a266-0b494ab59620" :answer-field/id #uuid "ab00a963-1cd0-5605-a266-0b494ab59620" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-839bdee5-429a-5249-b53f-0d20a4a67a86" :answer-field/choices ["answer-ec9bbfcd-9965-5de5-905a-9f1ee62878ef" "answer-1e16fd4a-6245-515d-bca9-21c581bb11c4" "answer-37e257f1-1b06-5206-b1e4-0f6fd61394c7" "answer-8dc1a3d5-cb5c-5204-a75d-1ad43a7bc92b" "answer-839bdee5-429a-5249-b53f-0d20a4a67a86"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec9bbfcd-9965-5de5-905a-9f1ee62878ef" :answer/id #uuid "ec9bbfcd-9965-5de5-905a-9f1ee62878ef" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-1e16fd4a-6245-515d-bca9-21c581bb11c4" :answer/id #uuid "1e16fd4a-6245-515d-bca9-21c581bb11c4" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-37e257f1-1b06-5206-b1e4-0f6fd61394c7" :answer/id #uuid "37e257f1-1b06-5206-b1e4-0f6fd61394c7" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-8dc1a3d5-cb5c-5204-a75d-1ad43a7bc92b" :answer/id #uuid "8dc1a3d5-cb5c-5204-a75d-1ad43a7bc92b" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-839bdee5-429a-5249-b53f-0d20a4a67a86" :answer/id #uuid "839bdee5-429a-5249-b53f-0d20a4a67a86" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-d4919d08-0fd6-56c9-962f-b38905295542" :question/id #uuid "d4919d08-0fd6-56c9-962f-b38905295542" :question/math-academy-id "q-5260" :question/problem "Find the fourth term of an arithmetic sequence if the first term is $1$ and the common difference is $-2.$" :question/worked-solution "We will list terms of the sequence until we get to the fourth term. \n\nWe start with the first term $1,$ and then we calculate each subsequent term by subtracting $2$ from the previous term:\n\n![](images/2f/2f8e4976e5ea05c0d238959425d4d2d5ece23d4bfae844e533e9eb484f9de18a.png)\n\nTherefore, the fourth term is $-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-81579da1-4713-52e7-82a4-48a156d67a53"] :db/ensure [:question/validate]} {:db/id "answer-field-81579da1-4713-52e7-82a4-48a156d67a53" :answer-field/id #uuid "81579da1-4713-52e7-82a4-48a156d67a53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-48471eaf-485b-57e4-b57e-a735e38e449c" :answer-field/choices ["answer-f213e393-5ca9-51a1-86ce-6d826b129fa7" "answer-48471eaf-485b-57e4-b57e-a735e38e449c" "answer-afe020d8-2c1b-5283-b62d-5b9d95e3a369" "answer-cde37cbf-59b7-560e-bdf2-a97cdc9cc8af" "answer-e026946b-e444-5c11-ad1d-2bed1dc460f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-f213e393-5ca9-51a1-86ce-6d826b129fa7" :answer/id #uuid "f213e393-5ca9-51a1-86ce-6d826b129fa7" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-48471eaf-485b-57e4-b57e-a735e38e449c" :answer/id #uuid "48471eaf-485b-57e4-b57e-a735e38e449c" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-afe020d8-2c1b-5283-b62d-5b9d95e3a369" :answer/id #uuid "afe020d8-2c1b-5283-b62d-5b9d95e3a369" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-cde37cbf-59b7-560e-bdf2-a97cdc9cc8af" :answer/id #uuid "cde37cbf-59b7-560e-bdf2-a97cdc9cc8af" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-e026946b-e444-5c11-ad1d-2bed1dc460f2" :answer/id #uuid "e026946b-e444-5c11-ad1d-2bed1dc460f2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186079726 :tutorial/content "Consider the following sequence:\n\n$$\n1,\\quad 3,\\quad 5,\\quad 7,\\quad 9,\\quad \\ldots\n$$\n\nNotice that the difference (or \"jump\") between two consecutive numbers is always the same. \n\n![](images/5a/5a4433d95492b9895793bc497fce887e3a39986a4f0c686ebe8a5d9b54d4f3dc.png)\n\nA sequence where the jump never changes is called an **arithmetic sequence.** \n\nWe call this jump the **common difference**, and represent it using the letter $d.$ In this particular case, the common difference is $d=2.$" :db/ensure [:tutorial/validate]} {:db/id 17592186078683 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186165279 :answer-field/choices 17592186165280] [:db/retract 17592186165279 :answer-field/choices 17592186165281] [:db/retract 17592186165279 :answer-field/choices 17592186165282] [:db/retract 17592186165279 :answer-field/choices 17592186165283] [:db/retract 17592186165279 :answer-field/choices 17592186165284] [:db/retract 17592186165285 :answer-field/choices 17592186165286] [:db/retract 17592186165285 :answer-field/choices 17592186165287] [:db/retract 17592186165285 :answer-field/choices 17592186165288] [:db/retract 17592186165285 :answer-field/choices 17592186165289] [:db/retract 17592186165285 :answer-field/choices 17592186165290] {:db/id 17592186166765 :knowledge-point/questions ["question-f7c92bc5-8061-56c3-9e0d-1e01c4282d73" "question-a0460884-e620-5591-b0cf-266181de3168" "question-6edfa6ba-1072-5bf1-bdfe-2aaa6d5af318" "question-7e70aada-1f44-5184-b986-16d8ac2cfc36"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166603 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y =7\\arcsch(1-x),$ then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcsch x) = -\\dfrac{1}{|x|\\sqrt{1+x^2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(7\\operatorname{arcsch}⁡(1-x)) \\\\  & =7\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡(1-x)) \\\\  & =7(-\\frac{1}{|1-x|\\sqrt{1+(1-x)^{2}}})\\cdot (1-x)^{′} \\\\  & =7(-\\frac{1}{|x-1|\\sqrt{1+1-2x+{x}^{2}}})\\cdot (-1) \\\\  & =\\frac{7}{|x-1|\\sqrt{{x}^{2}-2x+2}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166766 :knowledge-point/questions ["question-db2fa4fe-6b60-51ee-9a41-fc33e6f273b7" "question-24bbcf4d-e35e-5166-86db-6c3a81f4f4ca"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166604 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y =  5\\arsech{2x},$ then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsech x) = -\\dfrac{1}{x\\sqrt{1-x^2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{arsech}⁡2x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡2x) \\\\  & =5(-\\frac{1}{(2x)\\sqrt{1-(2x)^{2}}})\\cdot (2x)^{′} \\\\  & =-\\frac{5}{2x\\sqrt{1-4{x}^{2}}}\\cdot 2 \\\\  & =-\\frac{5}{x\\sqrt{1-4{x}^{2}}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166605 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = \\arcoth{e^x},$ then $\\dfrac {\\textrm{d}y}{\\textrm{d}x}=$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcoth x) = \\dfrac{1}{1-x^2}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡{e}^{x}) \\\\  & =\\frac{1}{1-({e}^{x})^{2}}\\cdot ({e}^{x})^{′} \\\\  & =\\frac{1}{1-{e}^{2x}}\\cdot {e}^{x} \\\\  & =\\frac{{e}^{x}}{1-{e}^{2x}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166606 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $f(x) = \\sin{x} \\cdot \\arcsch{x},$ then $f'(x) = \\cos{x} \\arcsch{x} + g(x).$ What is $g(x)?$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIn this case, the expression for $f(x)$  is a product $u(x) \\cdot v(x)$ with $u(x) = \\sin{x}$ and $v(x) = \\arcsch{x}.$ \n\nTherefore, we apply the product rule as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(\\operatorname{sin}⁡x)^{′}\\cdot \\operatorname{arcsch}⁡x+\\operatorname{sin}⁡x\\cdot (\\operatorname{arcsch}⁡x)^{′} \\\\  & =\\operatorname{cos}⁡x\\cdot \\operatorname{arcsch}⁡x+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}) \\\\  & =\\operatorname{cos}⁡x\\operatorname{arcsch}⁡x+{{(-\\frac{\\operatorname{sin}⁡x}{|x|\\sqrt{1+{x}^{2}}})}_{⏟}}_{g(x)}\\end{aligned}\n$$\n\nTherefore, $g(x) = -\\dfrac{\\sin{x}}{|x|\\sqrt{1+x^2}}.$" :db/ensure [:question/validate]} {:db/id "question-f7c92bc5-8061-56c3-9e0d-1e01c4282d73" :question/id #uuid "f7c92bc5-8061-56c3-9e0d-1e01c4282d73" :question/math-academy-id "q-95511" :question/problem "$$\n\nIf $y={e}^{4x}-2\\operatorname{arcsch}⁡{e}^{2x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}({e}^{4x}-2\\operatorname{arcsch}⁡{e}^{2x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({e}^{4x})-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡{e}^{2x}) \\\\  & =4{e}^{4x}-2(-\\frac{1}{|{e}^{2x}|\\sqrt{1+({e}^{2x})^{2}}})\\cdot ({e}^{2x})^{′} \\\\  & =4{e}^{4x}+\\frac{2}{{e}^{2x}\\sqrt{1+{e}^{4x}}}\\cdot 2{e}^{2x} \\\\  & =4{e}^{4x}+\\frac{4}{\\sqrt{1+{e}^{4x}}} \\\\  & =4({e}^{4x}+\\frac{1}{\\sqrt{1+{e}^{4x}}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ac258ea5-31b3-5f32-97e0-aac682319621"] :db/ensure [:question/validate]} {:db/id "answer-field-ac258ea5-31b3-5f32-97e0-aac682319621" :answer-field/id #uuid "ac258ea5-31b3-5f32-97e0-aac682319621" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-753c754d-a64b-5a86-bf3d-b11e9cb247e4" :answer-field/choices ["answer-753c754d-a64b-5a86-bf3d-b11e9cb247e4" "answer-762e2957-2bdc-5c9f-8c82-28884cca64d3" "answer-a25c36b2-66bd-5740-89f4-e95b59786f40" "answer-35a0d67f-2001-5b60-b42a-f979cd7b3038" "answer-c60203e4-de60-549e-8d11-366f51f688e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-753c754d-a64b-5a86-bf3d-b11e9cb247e4" :answer/id #uuid "753c754d-a64b-5a86-bf3d-b11e9cb247e4" :answer/type :answer.type/math :answer/value "4({e}^{4x}+\\frac{1}{\\sqrt{1+{e}^{4x}}})" :db/ensure [:answer/validate]} {:db/id "answer-762e2957-2bdc-5c9f-8c82-28884cca64d3" :answer/id #uuid "762e2957-2bdc-5c9f-8c82-28884cca64d3" :answer/type :answer.type/math :answer/value "4({e}^{4x}-\\frac{1}{\\sqrt{1+{e}^{4x}}})" :db/ensure [:answer/validate]} {:db/id "answer-a25c36b2-66bd-5740-89f4-e95b59786f40" :answer/id #uuid "a25c36b2-66bd-5740-89f4-e95b59786f40" :answer/type :answer.type/math :answer/value "4{e}^{2x}({e}^{2x}+\\frac{1}{\\sqrt{1+{e}^{4x}}})" :db/ensure [:answer/validate]} {:db/id "answer-35a0d67f-2001-5b60-b42a-f979cd7b3038" :answer/id #uuid "35a0d67f-2001-5b60-b42a-f979cd7b3038" :answer/type :answer.type/math :answer/value "4{e}^{4x}(1+\\frac{1}{\\sqrt{1+{e}^{4x}}})" :db/ensure [:answer/validate]} {:db/id "answer-c60203e4-de60-549e-8d11-366f51f688e4" :answer/id #uuid "c60203e4-de60-549e-8d11-366f51f688e4" :answer/type :answer.type/math :answer/value "4{e}^{4x}(1-\\frac{1}{\\sqrt{1+{e}^{4x}}})" :db/ensure [:answer/validate]} {:db/id "question-a0460884-e620-5591-b0cf-266181de3168" :question/id #uuid "a0460884-e620-5591-b0cf-266181de3168" :question/math-academy-id "q-341470" :question/problem "$$\n\nIf $y=2\\operatorname{arcsch}⁡({x}^{4}+2),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{{x}^{4}+2}$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,[2\\operatorname{arcsch}⁡({x}^{4}+2)] \\\\  & =2\\cdot [-\\frac{1}{|{x}^{4}+2|\\sqrt{1+{({x}^{4}+2)}^{2}}}]\\cdot {({x}^{4}+2)}^{′} \\\\  & =-\\frac{2}{({x}^{4}+2)\\sqrt{1+({x}^{8}+4{x}^{4}+4)}}\\cdot 4{x}^{3} \\\\  & =-\\frac{1}{{x}^{4}+2}\\frac{8{x}^{3}}{\\sqrt{{x}^{8}+4{x}^{4}+5}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cee78980-cb6b-5efb-8a9d-827bb3ab4617"] :db/ensure [:question/validate]} {:db/id "answer-field-cee78980-cb6b-5efb-8a9d-827bb3ab4617" :answer-field/id #uuid "cee78980-cb6b-5efb-8a9d-827bb3ab4617" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4444a1b2-e52a-551a-af2f-64eee4dc99a5" :answer-field/choices ["answer-4444a1b2-e52a-551a-af2f-64eee4dc99a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-4444a1b2-e52a-551a-af2f-64eee4dc99a5" :answer/id #uuid "4444a1b2-e52a-551a-af2f-64eee4dc99a5" :answer/type :answer.type/math :answer/value "\\frac{8x^3}{\\sqrt{1+(x^4+2)^2}}" :db/ensure [:answer/validate]} {:db/id "question-6edfa6ba-1072-5bf1-bdfe-2aaa6d5af318" :question/id #uuid "6edfa6ba-1072-5bf1-bdfe-2aaa6d5af318" :question/math-academy-id "q-341457" :question/problem "$$\n\nIf $y=3\\,\\operatorname{arcsch}⁡(x-1),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=-\\frac{1}{|x-1|}$\n{{field-1}}" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,[3\\,\\operatorname{arcsch}⁡(x-1)] \\\\  & =3\\cdot \\frac{\\text{d}}{\\text{d}x}\\,[\\operatorname{arcsch}⁡(x-1)] \\\\  & =3\\cdot [-\\frac{1}{|x-1|\\sqrt{1+(x-1)^{2}}}]\\cdot (x-1)^{′} \\\\  & =-\\frac{3}{|x-1|\\sqrt{1+({x}^{2}-2x+1)}}\\cdot 1 \\\\  & =-\\frac{1}{|x-1|}\\,\\frac{3}{\\sqrt{{x}^{2}-2x+2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5de9fb92-f20f-5c9e-9ed0-941e3ef44838"] :db/ensure [:question/validate]} {:db/id "answer-field-5de9fb92-f20f-5c9e-9ed0-941e3ef44838" :answer-field/id #uuid "5de9fb92-f20f-5c9e-9ed0-941e3ef44838" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8f577fac-247a-5f5a-8564-52657ee5b19a" :answer-field/choices ["answer-8f577fac-247a-5f5a-8564-52657ee5b19a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f577fac-247a-5f5a-8564-52657ee5b19a" :answer/id #uuid "8f577fac-247a-5f5a-8564-52657ee5b19a" :answer/type :answer.type/math :answer/value "\\frac{3}{\\sqrt{{x}^{2}-2x+2}}" :db/ensure [:answer/validate]} {:db/id "question-7e70aada-1f44-5184-b986-16d8ac2cfc36" :question/id #uuid "7e70aada-1f44-5184-b986-16d8ac2cfc36" :question/math-academy-id "q-95503" :question/problem "$$\n\nIf $y=-3\\operatorname{arcsch}⁡4x,$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{arcsch}⁡4x) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡4x) \\\\  & =-3\\cdot (-\\frac{1}{|4x|\\sqrt{1+(4x)^{2}}})\\cdot (4x)^{′} \\\\  & =3\\cdot \\frac{1}{4|x|\\sqrt{1+16{x}^{2}}}\\cdot 4 \\\\  & =\\frac{3}{|x|\\sqrt{1+16{x}^{2}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b0359eb2-a7b5-51ab-a406-e6a8025c07cd"] :db/ensure [:question/validate]} {:db/id "answer-field-b0359eb2-a7b5-51ab-a406-e6a8025c07cd" :answer-field/id #uuid "b0359eb2-a7b5-51ab-a406-e6a8025c07cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-85e270b6-45ce-567e-9271-f69abcdff687" :answer-field/choices ["answer-3739f1be-769b-5241-ac9d-166ae50d15a0" "answer-54d6cd33-d4de-58b7-8f64-738c8128b497" "answer-d06920a3-ba34-58db-ba10-ad2913c12c48" "answer-85e270b6-45ce-567e-9271-f69abcdff687" "answer-db27974c-ad6f-568e-a27d-852868230ae3"] :db/ensure [:answer-field/validate]} {:db/id "answer-3739f1be-769b-5241-ac9d-166ae50d15a0" :answer/id #uuid "3739f1be-769b-5241-ac9d-166ae50d15a0" :answer/type :answer.type/math :answer/value "-\\frac{3}{4|x|\\sqrt{1+4{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "answer-54d6cd33-d4de-58b7-8f64-738c8128b497" :answer/id #uuid "54d6cd33-d4de-58b7-8f64-738c8128b497" :answer/type :answer.type/math :answer/value "-\\frac{3}{|x|\\sqrt{1+16{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "answer-d06920a3-ba34-58db-ba10-ad2913c12c48" :answer/id #uuid "d06920a3-ba34-58db-ba10-ad2913c12c48" :answer/type :answer.type/math :answer/value "\\frac{3}{4|x|\\sqrt{1+16{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "answer-85e270b6-45ce-567e-9271-f69abcdff687" :answer/id #uuid "85e270b6-45ce-567e-9271-f69abcdff687" :answer/type :answer.type/math :answer/value "\\frac{3}{|x|\\sqrt{1+16{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "answer-db27974c-ad6f-568e-a27d-852868230ae3" :answer/id #uuid "db27974c-ad6f-568e-a27d-852868230ae3" :answer/type :answer.type/math :answer/value "\\frac{3}{|x|\\sqrt{1+4{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id 17592186167345 :question/problem "$$\n\nIf $y=-2\\operatorname{arcsch}⁡{x}^{2},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosecant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡x)=-\\frac{1}{|x|\\sqrt{1+{x}^{2}}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{arcsch}⁡{x}^{2}) \\\\  & =-2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsch}⁡{x}^{2}) \\\\  & =2\\cdot \\frac{1}{|{x}^{2}|\\sqrt{1+({x}^{2})^{2}}}\\cdot ({x}^{2})^{′} \\\\  & =2\\cdot \\frac{1}{{x}^{2}\\sqrt{1+{x}^{4}}}\\cdot 2x \\\\  & =\\frac{4x}{{x}^{2}\\sqrt{1+{x}^{4}}} \\\\  & =\\frac{4}{x\\sqrt{1+{x}^{4}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165279 :answer-field/correct "answer-71eb7122-dc51-5d2b-9bdd-e41da71e7ed5" :answer-field/choices ["answer-2a7c01f1-d39c-5196-9258-c0eec7c07444" "answer-40c362a9-19d5-5d8c-a4a3-3cf9958ccbe4" "answer-bcf13911-5554-5451-9cf9-4e74b60ef167" "answer-71eb7122-dc51-5d2b-9bdd-e41da71e7ed5" "answer-fd0e91da-cb8a-5d7b-991b-d2333882fbdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a7c01f1-d39c-5196-9258-c0eec7c07444" :answer/id #uuid "2a7c01f1-d39c-5196-9258-c0eec7c07444" :answer/type :answer.type/math :answer/value 