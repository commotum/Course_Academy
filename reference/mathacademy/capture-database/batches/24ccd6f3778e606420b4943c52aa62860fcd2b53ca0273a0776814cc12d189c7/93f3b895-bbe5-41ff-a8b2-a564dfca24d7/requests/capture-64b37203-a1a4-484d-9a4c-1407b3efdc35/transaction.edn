nswer-field/correct "answer-18f3bef3-f4f9-50bd-ad1b-980bacc7743f" :answer-field/choices ["answer-22ad66f0-9dd6-500b-bfa1-89777d6d096e" "answer-1a413cde-51aa-554a-a668-cb72400d7998" "answer-18f3bef3-f4f9-50bd-ad1b-980bacc7743f" "answer-b42a8058-7cc4-5b42-8aee-1b65e58718bd" "answer-93027069-aad5-57c6-9c9d-a24023cbdefe"] :db/ensure [:answer-field/validate]} {:db/id "answer-22ad66f0-9dd6-500b-bfa1-89777d6d096e" :answer/id #uuid "22ad66f0-9dd6-500b-bfa1-89777d6d096e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-1a413cde-51aa-554a-a668-cb72400d7998" :answer/id #uuid "1a413cde-51aa-554a-a668-cb72400d7998" :answer/type :answer.type/math :answer/value "-\\frac{1}{{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-18f3bef3-f4f9-50bd-ad1b-980bacc7743f" :answer/id #uuid "18f3bef3-f4f9-50bd-ad1b-980bacc7743f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b42a8058-7cc4-5b42-8aee-1b65e58718bd" :answer/id #uuid "b42a8058-7cc4-5b42-8aee-1b65e58718bd" :answer/type :answer.type/math :answer/value "\\frac{1}{e}" :db/ensure [:answer/validate]} {:db/id "answer-93027069-aad5-57c6-9c9d-a24023cbdefe" :answer/id #uuid "93027069-aad5-57c6-9c9d-a24023cbdefe" :answer/type :answer.type/math :answer/value "e" :db/ensure [:answer/validate]} {:db/id "activity-8d6616d8-4bd9-5180-836d-7a649de8f37f" :activity/id #uuid "8d6616d8-4bd9-5180-836d-7a649de8f37f" :activity/title "The Power Rule for Differentiation" :activity/type :activity.type/review :activity/scope 17592186048593 :activity/course 17592186046647 :activity/steps ["step-d2cd4ad0-adea-528f-a78f-3a888cbb65e5" "step-64201a69-4087-5fa9-8613-459e7ef99140" "step-bcda3cd1-5fdc-5593-8afc-4d6c3c5925cb"] :activity/first-step "step-d2cd4ad0-adea-528f-a78f-3a888cbb65e5" :db/ensure [:activity/validate]} {:db/id "step-d2cd4ad0-adea-528f-a78f-3a888cbb65e5" :step/id #uuid "d2cd4ad0-adea-528f-a78f-3a888cbb65e5" :step/content "question-0cf33d77-f213-525d-99fb-8b9182428af7" :step/next "step-64201a69-4087-5fa9-8613-459e7ef99140" :db/ensure [:step/validate]} {:db/id "step-64201a69-4087-5fa9-8613-459e7ef99140" :step/id #uuid "64201a69-4087-5fa9-8613-459e7ef99140" :step/content "question-7712c3e1-7e39-5f21-96a2-73fbade1bb33" :step/next "step-bcda3cd1-5fdc-5593-8afc-4d6c3c5925cb" :db/ensure [:step/validate]} {:db/id "step-bcda3cd1-5fdc-5593-8afc-4d6c3c5925cb" :step/id #uuid "bcda3cd1-5fdc-5593-8afc-4d6c3c5925cb" :step/content "question-adc818d6-3be7-557c-93b2-e7ce26f749ac" :db/ensure [:step/validate]} [:db/retract 17592186311171 :answer-field/choices 17592186309213] [:db/retract 17592186310812 :answer-field/choices 17592186309227] [:db/retract 17592186310858 :answer-field/choices 17592186309038] {:db/id 17592186221413 :knowledge-point/questions ["question-63f582f6-9d11-5d33-b64d-69b2836d097f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-63f582f6-9d11-5d33-b64d-69b2836d097f" :question/id #uuid "63f582f6-9d11-5d33-b64d-69b2836d097f" :question/math-academy-id "q-335453" :question/problem "Which statement correctly describes a **stable** equilibrium point?" :question/worked-solution "Let's recall the definitions of stability:\n\n- An equilibrium point ${x}^{∗}$ is called *stable* if for any neighborhood $O$ of ${x}^{∗},$ there exists a neighborhood ${O}_{1}⊆O$ such that every orbit that begins inside ${O}_{1}$ at some point in time $t={t}_{0}$ remains inside $O$ for all $t>{t}_{0}.$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.\n\n- An equilibrium point ${x}^{∗}$ is called *asymptotically stable* if it is stable and there exists a neighborhood $O$ of ${x}^{∗}$ such that every orbit that begins inside $O$ approaches ${x}^{∗}$ as $t\\to \\infty .$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$\n\n- An equilibrium point ${x}^{∗}$ is called *unstable* if it is not stable.\n\nIn plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.\n\nTherefore, the correct answer is the following:\n\nSolutions that start sufficiently close to the equilibrium remain close, but do not necessarily converge to the equilibrium." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c7566841-5810-5062-9cbb-2828c6d469a3"] :db/ensure [:question/validate]} {:db/id "answer-field-c7566841-5810-5062-9cbb-2828c6d469a3" :answer-field/id #uuid "c7566841-5810-5062-9cbb-2828c6d469a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9263fe6-3236-5773-93ed-b447eb0714dc" :answer-field/choices ["answer-7294c019-31b4-5ece-b07f-0fa3b97c7049" "answer-6d26d55a-2db1-5794-93cd-256be9c6f385" "answer-b2c1c5b1-aa60-5c38-89ae-5e3c68d09da5" "answer-6eb76b8e-a8f2-5c68-b70a-8cfa6fdb979b" "answer-f9263fe6-3236-5773-93ed-b447eb0714dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-7294c019-31b4-5ece-b07f-0fa3b97c7049" :answer/id #uuid "7294c019-31b4-5ece-b07f-0fa3b97c7049" :answer/type :answer.type/text :answer/value "No matter how close a solution starts to the equilibrium, it will eventually leave any fixed neighborhood of the equilibrium." :db/ensure [:answer/validate]} {:db/id "answer-6d26d55a-2db1-5794-93cd-256be9c6f385" :answer/id #uuid "6d26d55a-2db1-5794-93cd-256be9c6f385" :answer/type :answer.type/text :answer/value "Solutions can converge to the equilibrium only when the system is linear." :db/ensure [:answer/validate]} {:db/id "answer-b2c1c5b1-aa60-5c38-89ae-5e3c68d09da5" :answer/id #uuid "b2c1c5b1-aa60-5c38-89ae-5e3c68d09da5" :answer/type :answer.type/text :answer/value "Solutions starting close to the equilibrium may leave a small neighborhood of it but still converge to it as $t\\to \\infty .$" :db/ensure [:answer/validate]} {:db/id "answer-6eb76b8e-a8f2-5c68-b70a-8cfa6fdb979b" :answer/id #uuid "6eb76b8e-a8f2-5c68-b70a-8cfa6fdb979b" :answer/type :answer.type/text :answer/value "Solutions starting close to the equilibrium stay close only for a finite time, then may behave arbitrarily." :db/ensure [:answer/validate]} {:db/id "answer-f9263fe6-3236-5773-93ed-b447eb0714dc" :answer/id #uuid "f9263fe6-3236-5773-93ed-b447eb0714dc" :answer/type :answer.type/text :answer/value "Solutions that start sufficiently close to the equilibrium remain close, but do not necessarily converge to the equilibrium." :db/ensure [:answer/validate]} {:db/id 17592186311598 :question/problem "Select the correct options in the statement below that describe an **asymptotically stable** equilibrium point.\n\nThe solutions that start sufficiently \n{{field-1}}\nthe equilibrium remain close to the equilibrium\n{{field-2}} \nthe \n{{field-3}} \nas \n{{field-4}}." :db/ensure [:question/validate]} {:db/id 17592186311171 :answer-field/correct 17592186309981 :db/ensure [:answer-field/validate]} {:db/id 17592186310812 :answer-field/correct 17592186310579 :db/ensure [:answer-field/validate]} {:db/id 17592186310858 :answer-field/correct 17592186310521 :db/ensure [:answer-field/validate]} {:db/id "activity-a533a8f5-d82f-58f4-9e51-bc3fbd4d4252" :activity/id #uuid "a533a8f5-d82f-58f4-9e51-bc3fbd4d4252" :activity/title "Equilibrium Points and Stability for Systems of ODEs" :activity/type :activity.type/review :activity/scope 17592186048990 :activity/course 17592186046644 :activity/steps ["step-ca26e31c-48d1-5c1f-b0d2-6caca076d885" "step-7773724f-136a-56c6-a6ef-91a1e9b18f93" "step-4316790b-9967-50da-b9e8-9e00db267c48" "step-178605e4-baed-5eae-a9e6-a3614ae150cd" "step-ab29950b-5bb8-5ab5-996e-f7d41e4da9e1"] :activity/first-step "step-ca26e31c-48d1-5c1f-b0d2-6caca076d885" :db/ensure [:activity/validate]} {:db/id "step-ca26e31c-48d1-5c1f-b0d2-6caca076d885" :step/id #uuid "ca26e31c-48d1-5c1f-b0d2-6caca076d885" :step/content 17592186308445 :step/next "step-7773724f-136a-56c6-a6ef-91a1e9b18f93" :db/ensure [:step/validate]} {:db/id "step-7773724f-136a-56c6-a6ef-91a1e9b18f93" :step/id #uuid "7773724f-136a-56c6-a6ef-91a1e9b18f93" :step/content "question-63f582f6-9d11-5d33-b64d-69b2836d097f" :step/next "step-4316790b-9967-50da-b9e8-9e00db267c48" :db/ensure [:step/validate]} {:db/id "step-4316790b-9967-50da-b9e8-9e00db267c48" :step/id #uuid "4316790b-9967-50da-b9e8-9e00db267c48" :step/content 17592186311598 :step/next "step-178605e4-baed-5eae-a9e6-a3614ae150cd" :db/ensure [:step/validate]} {:db/id "step-178605e4-baed-5eae-a9e6-a3614ae150cd" :step/id #uuid "178605e4-baed-5eae-a9e6-a3614ae150cd" :step/content 17592186311602 :step/next "step-ab29950b-5bb8-5ab5-996e-f7d41e4da9e1" :db/ensure [:step/validate]} {:db/id "step-ab29950b-5bb8-5ab5-996e-f7d41e4da9e1" :step/id #uuid "ab29950b-5bb8-5ab5-996e-f7d41e4da9e1" :step/content 17592186311617 :db/ensure [:step/validate]} {:db/id 17592186162112 :knowledge-point/questions ["question-b3c1aae3-e457-548d-bfd0-11222eb5ea0e" "question-403a78d0-86af-59ab-a2a0-082e022aaef5" "question-e6d9b032-eda8-55d5-b69c-37b94f5fdf98" "question-fde66fe1-1f42-5587-ae07-4dc1d6de7d02" "question-6a8bad50-df40-5364-9a82-59b2638eab96"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161678 :question/problem "![](images/8f/8f5bbd64a61818dc2dd076246d9324f12d7b1123daee08f15061519a303d12d3.svg)\n\nConsider the continuous random variables $X$ and $Y,$ for which the conditional probability density function $f_{Y \\,|\\, X}(y \\,|\\, x)$ and the marginal density function $f_X(x)$ are shown above. Find the expression of the joint probability density function $f(x,y)$ for $0 \\leq        x \\leq        1, \\: 0 \\leq        y \\leq        1.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\nf_{Y \\,|\\, X}(y \\,|\\, x) =\\dfrac{f(x, y)}{f_X (x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- $f_X (x)$ is the marginal density function for $X.$\n\nFrom the equation above, it follows that\n\n$$\nf(x,y) = f_{Y \\,|\\, X}(y \\,|\\, x) \\cdot f_X (x).\n$$\n\nNow, for $0 \\leq x \\leq  1, \\: 0 \\leq y \\leq  1,$ we have \n\n$$\n\\begin{aligned}f(x,y) & ={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x) \\\\  & =\\frac{3({x}^{2}+{y}^{2})}{3{x}^{2}+1}\\cdot \\frac{3{x}^{2}+1}{2} \\\\  & =\\frac{3({x}^{2}+{y}^{2})}{2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f_{Y \\,|\\, X}(y \\,|\\, x)$ equals $0.$ As a result, the product will be equal to $0$ too.\n\nTherefore, the joint probability density function is the following:\n![](images/e5/e50432a004c16271fe9ffa680412a4729c9d03ce85c28d821d6b03585d2e24ba.svg)" :db/ensure [:question/validate]} {:db/id 17592186162114 :knowledge-point/questions ["question-0309d911-015b-5e4c-9346-30c2d14fb0b7" "question-f873ff79-08e6-53a2-8403-85dc4a081919" "question-1967c2eb-a9e1-5379-9ffd-3708e127b5c8" "question-60bd267c-251c-5e47-b502-67f097fb7ef0" "question-3b02f20a-35d0-57b1-ada9-f1273f1f3904"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161680 :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n![](images/5a/5ae264514c53b97339bfa9969057ed9462f183fc8a77658bd0615f0af148a67c.svg)\n\nFind the expression of the conditional probability density function $f_{X \\,|\\, Y} (x \\,|\\, y)$ for $0 \\leq             x \\leq             1, \\: 0 \\leq             y \\leq  1.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(x+y)\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{2}+xy]}_{x=0}^{x=1} \\\\  & =\\frac{1}{2}+y-0 \\\\  & =\\frac{2y+1}{2}.\\end{aligned}\n$$\n\nSo, the full expression for $f_Y(y)$ is the following:\n![](images/27/27ba59d670061d91b96f80ee5400824993311d35c9edf7a887957936d74ace8c.svg)\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\nf_{X \\,|\\, Y} (x \\,|\\, y) = \\dfrac{f(x, y)}{f_Y (y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- $f_Y(y)$ is the marginal density function for $Y.$\n\nNow, for $0 \\leq             x \\leq             1, \\: 0 \\leq             y \\leq  1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{x+y}{(\\frac{2y+1}{2})} \\\\  & =\\frac{2(x+y)}{2y+1}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, $f_{X \\,|\\, Y}(x \\,|\\, y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n![](images/24/242dc27ab006f389610d8f3bcd0297eed7d1809fb33b1b3b7c8b1f6b8dd532f7.svg)" :db/ensure [:question/validate]} {:db/id 17592186162113 :knowledge-point/questions ["question-05787bc3-261f-5b82-bb66-810cc0eb28ae" "question-d2c3b01f-8b1d-5c9b-95df-4bf4aec9fac1" "question-91a2a3a1-8ae1-5b13-976f-9bc558602e26" "question-a05be7fd-94f3-5604-ad03-bc6e74737579"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161679 :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n![](images/93/933179a6f35cb7362a1c1fea2c6b945796ebb8a436095552ade7b4d769690654.svg) \n\nFind $P \\left(Y <  \\dfrac{1}{2} \\,\\bigg|\\, X=1\\right).$" :question/worked-solution "Recall that \n\n$$\nP(Y \\in A \\,|\\, X = x) = \\int_A f_{Y \\,|\\, X} (y \\,|\\, x) \\, \\textrm{d}y,\n$$\n\nwhere $f_{Y \\,|\\, X} (y \\,|\\,x)$ is the conditional probability density function. \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\sqrt{x}}8{x}^{2}y\\,\\text{d}y \\\\  & =8{x}^{2}{\\int }_{0}^{\\sqrt{x}}y\\,\\text{d}y \\\\  & =8{x}^{2}{[\\frac{1}{2}{y}^{2}]}_{0}^{\\sqrt{x}} \\\\  & =4{x}^{2}(\\sqrt{x})^{2}-0 \\\\  & =4{x}^{3}.\\end{aligned}\n$$\n\nSo, the full expression for $f_X(x)$ is the following:\n\n![](images/f5/f5bc55159d59fda4918d7da4c6dd26cab5600b086e0fe00846907b901b5d467e.svg)\n\nNow recall that the conditional probability density function for two continuous random variables $X$ and $Y$ is given by\n\n$$\nf_{Y \\,|\\, X} (y \\,|\\, x) =\\dfrac{f(x, y)}{f_X (x)}\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- $f_X (x)$ is the marginal density function for $X.$\n\nNow, for $0<       x \\leq       1, \\: 0 \\leq       y \\leq       \\sqrt{x},$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{8{x}^{2}y}{4{x}^{3}} \\\\  & =\\frac{2y}{x}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, $f_{Y \\,|\\, X} (y \\,|\\, x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n![](images/5a/5a3a34e2722798fa8b163ceb984302f300cd1d2fa6bc5fa5259e7451fceb6afc.svg)\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(Y<\\frac{1}{2}\\,|\\,X=1) & ={\\int }_{0}^{1/2}{f}_{Y\\,|\\,X}(y\\,|\\,x=1)\\text{d}y \\\\  & ={\\int }_{0}^{1/2}\\frac{2y}{1}\\text{d}y \\\\  & ={\\int }_{0}^{1/2}2y\\,\\text{d}y \\\\  & ={[{y}^{2}]}_{0}^{1/2} \\\\  & =\\frac{1}{4}-0 \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-b3c1aae3-e457-548d-bfd0-11222eb5ea0e" :question/id #uuid "b3c1aae3-e457-548d-bfd0-11222eb5ea0e" :question/math-academy-id "q-143610" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}5y\\sqrt{x}, & 0<x\\le 1,\\,0\\le y\\le \\sqrt{x} \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{5x\\sqrt{x}}{2}, & 0<x\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{X}(x)$ are shown above. Find the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0<x\\le 1,\\,0\\le y\\le \\sqrt{x}.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0<x\\le 1,\\,0\\le y\\le \\sqrt{x},$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{5y\\sqrt{x}}{(\\frac{5x\\sqrt{x}}{2})} \\\\  & =\\frac{2y}{x}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{x}, & 0<x\\le 1,\\,0\\le y\\le \\sqrt{x} \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-59042651-4b23-5e23-bf65-fd2e8cfe07fd"] :db/ensure [:question/validate]} {:db/id "answer-field-59042651-4b23-5e23-bf65-fd2e8cfe07fd" :answer-field/id #uuid "59042651-4b23-5e23-bf65-fd2e8cfe07fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b5172b40-2e6a-503d-a0e7-85b7d1a5c74d" :answer-field/choices ["answer-2339586b-683d-5a76-b2a4-04bd1b2acd78" "answer-eeed90d5-0dc1-5550-b397-1136f6576d71" "answer-65bb09ec-3b2d-50b3-ad37-144c0a7328e8" "answer-b5172b40-2e6a-503d-a0e7-85b7d1a5c74d" "answer-f14caf42-2818-5734-9146-91625adaf049"] :db/ensure [:answer-field/validate]} {:db/id "answer-2339586b-683d-5a76-b2a4-04bd1b2acd78" :answer/id #uuid "2339586b-683d-5a76-b2a4-04bd1b2acd78" :answer/type :answer.type/math :answer/value "2xy" :db/ensure [:answer/validate]} {:db/id "answer-eeed90d5-0dc1-5550-b397-1136f6576d71" :answer/id #uuid "eeed90d5-0dc1-5550-b397-1136f6576d71" :answer/type :answer.type/math :answer/value "\\frac{25y}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-65bb09ec-3b2d-50b3-ad37-144c0a7328e8" :answer/id #uuid "65bb09ec-3b2d-50b3-ad37-144c0a7328e8" :answer/type :answer.type/math :answer/value "\\frac{25{x}^{2}y}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b5172b40-2e6a-503d-a0e7-85b7d1a5c74d" :answer/id #uuid "b5172b40-2e6a-503d-a0e7-85b7d1a5c74d" :answer/type :answer.type/math :answer/value "\\frac{2y}{x}" :db/ensure [:answer/validate]} {:db/id "answer-f14caf42-2818-5734-9146-91625adaf049" :answer/id #uuid "f14caf42-2818-5734-9146-91625adaf049" :answer/type :answer.type/math :answer/value "\\frac{xy}{10}" :db/ensure [:answer/validate]} {:db/id "question-403a78d0-86af-59ab-a2a0-082e022aaef5" :question/id #uuid "403a78d0-86af-59ab-a2a0-082e022aaef5" :question/math-academy-id "q-143613" :question/problem "$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}3{e}^{-3y}, & 0\\le x\\le 1,\\,y\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}2x, & 0\\le x\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ and the marginal density function ${f}_{X}(x)$ are shown above. Find the expression of the joint probability density function $f(x,y)$ for $0\\le x\\le 1,\\,y\\ge 0.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nFrom the equation above, it follows that\n\n$$\nf(x,y)={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x).\n$$\n\nNow, for $0\\le x\\le 1,\\,y\\ge 0,$ we have \n\n$$\n\\begin{aligned}f(x,y) & ={f}_{Y\\,|\\,X}(y\\,|\\,x)\\cdot {f}_{X}(x) \\\\  & =3{e}^{-3y}\\cdot 2x \\\\  & =6x{e}^{-3y}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ equals $0.$ As a result, the product will be equal to $0$ too.\n\nTherefore, the joint probability density function is the following:\n\n$$\nf(x,y)=\\{\\begin{aligned}6x{e}^{-3y}, & 0\\le x\\le 1,\\,y\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b52d7b68-4c65-587d-aeab-3991d8f7cc23"] :db/ensure [:question/validate]} {:db/id "answer-field-b52d7b68-4c65-587d-aeab-3991d8f7cc23" :answer-field/id #uuid "b52d7b68-4c65-587d-aeab-3991d8f7cc23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72467fb5-ec09-5cab-b876-06ab1cccd79e" :answer-field/choices ["answer-29233a60-9d5a-5110-abb4-845bf432054c" "answer-f83edb0a-0c3b-51c9-afed-ceaa4bf289e4" "answer-e7543db9-a7b9-509a-9d27-09d1c07f0fb2" "answer-72467fb5-ec09-5cab-b876-06ab1cccd79e" "answer-456c6b5e-5cc1-5816-9cfd-cd583482083f"] :db/ensure [:answer-field/validate]} {:db/id "answer-29233a60-9d5a-5110-abb4-845bf432054c" :answer/id #uuid "29233a60-9d5a-5110-abb4-845bf432054c" :answer/type :answer.type/math :answer/value "2x{e}^{-3y}" :db/ensure [:answer/validate]} {:db/id "answer-f83edb0a-0c3b-51c9-afed-ceaa4bf289e4" :answer/id #uuid "f83edb0a-0c3b-51c9-afed-ceaa4bf289e4" :answer/type :answer.type/math :answer/value "3x{e}^{3y}" :db/ensure [:answer/validate]} {:db/id "answer-e7543db9-a7b9-509a-9d27-09d1c07f0fb2" :answer/id #uuid "e7543db9-a7b9-509a-9d27-09d1c07f0fb2" :answer/type :answer.type/math :answer/value "3{x}^{2}{e}^{-3y}" :db/ensure [:answer/validate]} {:db/id "answer-72467fb5-ec09-5cab-b876-06ab1cccd79e" :answer/id #uuid "72467fb5-ec09-5cab-b876-06ab1cccd79e" :answer/type :answer.type/math :answer/value "6x{e}^{-3y}" :db/ensure [:answer/validate]} {:db/id "answer-456c6b5e-5cc1-5816-9cfd-cd583482083f" :answer/id #uuid "456c6b5e-5cc1-5816-9cfd-cd583482083f" :answer/type :answer.type/math :answer/value "6{x}^{2}{e}^{3y}" :db/ensure [:answer/validate]} {:db/id "question-e6d9b032-eda8-55d5-b69c-37b94f5fdf98" :question/id #uuid "e6d9b032-eda8-55d5-b69c-37b94f5fdf98" :question/math-academy-id "q-144941" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{{x}^{2}+{y}^{2}}{10}, & 0\\le x\\le 1,\\,0\\le y\\le 3 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{3{x}^{2}+9}{10}, & 0\\le x\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{X}(x)$ are shown above. Find the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x\\le 1,\\,0\\le y\\le 3.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le 1,\\,0\\le y\\le 3,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{{x}^{2}+{y}^{2}}{10})}{(\\frac{3{x}^{2}+9}{10})} \\\\  & =\\frac{{x}^{2}+{y}^{2}}{3{x}^{2}+9}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{{x}^{2}+{y}^{2}}{3{x}^{2}+9}, & 0\\le x\\le 1,\\,0\\le y\\le 3 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fe76e9c1-efee-513d-8f78-b81b7c1d3e0f"] :db/ensure [:question/validate]} {:db/id "answer-field-fe76e9c1-efee-513d-8f78-b81b7c1d3e0f" :answer-field/id #uuid "fe76e9c1-efee-513d-8f78-b81b7c1d3e0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-523d9b76-cebc-5f99-9fbb-0e7e6db546ce" :answer-field/choices ["answer-653110f4-0f51-5e63-bd19-c507464feb61" "answer-0892c552-097f-5f93-9810-e84e7169c037" "answer-523d9b76-cebc-5f99-9fbb-0e7e6db546ce" "answer-54b15bb6-9e55-5f2e-9988-527ed5cf6ad5" "answer-726600a2-7334-5b46-8aea-ffaea3283afa"] :db/ensure [:answer-field/validate]} {:db/id "answer-653110f4-0f51-5e63-bd19-c507464feb61" :answer/id #uuid "653110f4-0f51-5e63-bd19-c507464feb61" :answer/type :answer.type/math :answer/value "\\frac{x+{y}^{2}}{9x+1}" :db/ensure [:answer/validate]} {:db/id "answer-0892c552-097f-5f93-9810-e84e7169c037" :answer/id #uuid "0892c552-097f-5f93-9810-e84e7169c037" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+1}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-523d9b76-cebc-5f99-9fbb-0e7e6db546ce" :answer/id #uuid "523d9b76-cebc-5f99-9fbb-0e7e6db546ce" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+{y}^{2}}{3{x}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "answer-54b15bb6-9e55-5f2e-9988-527ed5cf6ad5" :answer/id #uuid "54b15bb6-9e55-5f2e-9988-527ed5cf6ad5" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+{y}^{2}}{9}" :db/ensure [:answer/validate]} {:db/id "answer-726600a2-7334-5b46-8aea-ffaea3283afa" :answer/id #uuid "726600a2-7334-5b46-8aea-ffaea3283afa" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "question-fde66fe1-1f42-5587-ae07-4dc1d6de7d02" :question/id #uuid "fde66fe1-1f42-5587-ae07-4dc1d6de7d02" :question/math-academy-id "q-144943" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{3{x}^{2}+3y}{8}, & 0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3y+1}{8}, & 0\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{Y}(y)$ are shown above. Find the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 1,\\,0\\le y\\le 2.$" :question/worked-solution "Recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 1,\\,0\\le y\\le 2,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{3{x}^{2}+3y}{8})}{(\\frac{3y+1}{8})} \\\\  & =\\frac{3{x}^{2}+3y}{3y+1}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{3{x}^{2}+3y}{3y+1}, & 0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-83d69883-60e5-51a8-8587-9ac2f3c97229"] :db/ensure [:question/validate]} {:db/id "answer-field-83d69883-60e5-51a8-8587-9ac2f3c97229" :answer-field/id #uuid "83d69883-60e5-51a8-8587-9ac2f3c97229" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e8af9d3-e625-57a2-9753-9a16f2c5bfd4" :answer-field/choices ["answer-a5c0f0ef-519d-5451-a179-30787df74d35" "answer-6e8af9d3-e625-57a2-9753-9a16f2c5bfd4" "answer-d1fe2e08-4582-5e78-9887-77cb0f66a621" "answer-bed11b29-67d4-5909-9036-4139a697822e" "answer-ff5bfc28-404f-5301-a9fb-f28a54d7b0fd"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5c0f0ef-519d-5451-a179-30787df74d35" :answer/id #uuid "a5c0f0ef-519d-5451-a179-30787df74d35" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}+1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6e8af9d3-e625-57a2-9753-9a16f2c5bfd4" :answer/id #uuid "6e8af9d3-e625-57a2-9753-9a16f2c5bfd4" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}+3y}{3y+1}" :db/ensure [:answer/validate]} {:db/id "answer-d1fe2e08-4582-5e78-9887-77cb0f66a621" :answer/id #uuid "d1fe2e08-4582-5e78-9887-77cb0f66a621" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}+y}{y+1}" :db/ensure [:answer/validate]} {:db/id "answer-bed11b29-67d4-5909-9036-4139a697822e" :answer/id #uuid "bed11b29-67d4-5909-9036-4139a697822e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+y}{3y+1}" :db/ensure [:answer/validate]} {:db/id "answer-ff5bfc28-404f-5301-a9fb-f28a54d7b0fd" :answer/id #uuid "ff5bfc28-404f-5301-a9fb-f28a54d7b0fd" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+y}{y+1}" :db/ensure [:answer/validate]} {:db/id "question-6a8bad50-df40-5364-9a82-59b2638eab96" :question/id #uuid "6a8bad50-df40-5364-9a82-59b2638eab96" :question/math-academy-id "q-143607" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{3{y}^{2}}{2}, & 0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{X}(x)=\\{\\begin{aligned}\\frac{1}{2}, & 0\\le x\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nConsider the continuous random variables $X$ and $Y,$ for which the joint probability density function $f(x,y)$ and the marginal density function ${f}_{X}(x)$ are shown above. Find the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x\\le 2,\\,0\\le y\\le 1.$" :question/worked-solution "Recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le 2,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3{y}^{2}}{2})}{(\\frac{1}{2})} \\\\  & =3{y}^{2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}3{y}^{2}, & 0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-91dddd11-2a4d-5015-8ccb-b2a5b340c5c2"] :db/ensure [:question/validate]} {:db/id "answer-field-91dddd11-2a4d-5015-8ccb-b2a5b340c5c2" :answer-field/id #uuid "91dddd11-2a4d-5015-8ccb-b2a5b340c5c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-71b20e91-2ea6-54a7-a133-a83a08132141" :answer-field/choices ["answer-931f0d20-f406-5676-b3e6-461c30b95ae0" "answer-4a9b3fac-024e-544d-b2ef-d778f12b1db5" "answer-71b20e91-2ea6-54a7-a133-a83a08132141" "answer-745ed225-fd23-55f2-9adb-b6580902b88e" "answer-3915e834-8837-5560-8ead-24299d5e8d5a"] :db/ensure [:answer-field/validate]} {:db/id "answer-931f0d20-f406-5676-b3e6-461c30b95ae0" :answer/id #uuid "931f0d20-f406-5676-b3e6-461c30b95ae0" :answer/type :answer.type/math :answer/value "3(x+{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-4a9b3fac-024e-544d-b2ef-d778f12b1db5" :answer/id #uuid "4a9b3fac-024e-544d-b2ef-d778f12b1db5" :answer/type :answer.type/math :answer/value "3x{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-71b20e91-2ea6-54a7-a133-a83a08132141" :answer/id #uuid "71b20e91-2ea6-54a7-a133-a83a08132141" :answer/type :answer.type/math :answer/value "3{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-745ed225-fd23-55f2-9adb-b6580902b88e" :answer/id #uuid "745ed225-fd23-55f2-9adb-b6580902b88e" :answer/type :answer.type/math :answer/value "\\frac{3{y}^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-3915e834-8837-5560-8ead-24299d5e8d5a" :answer/id #uuid "3915e834-8837-5560-8ead-24299d5e8d5a" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+{y}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "question-0309d911-015b-5e4c-9346-30c2d14fb0b7" :question/id #uuid "0309d911-015b-5e4c-9346-30c2d14fb0b7" :question/math-academy-id "q-145100" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{2x+y}{4}, & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x\\le 1,\\,0\\le y\\le 2.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{2x+y}{4}\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}(2x+y)\\,\\text{d}y \\\\  & =\\frac{1}{4}\\cdot {[2xy+\\frac{{y}^{2}}{2}]}_{y=0}^{y=2} \\\\  & =\\frac{1}{4}\\cdot [4x+2] \\\\  & =\\frac{2x+1}{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{2x+1}{2}, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le 1,\\,0\\le y\\le 2,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{2x+y}{4})}{(\\frac{2x+1}{2})} \\\\  & =\\frac{2x+y}{4x+2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2x+y}{2(2x+1)}, & \\,0\\le x\\le 1,\\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1e16ecfd-ecda-506a-a72f-57bf0aaac1ce"] :db/ensure [:question/validate]} {:db/id "answer-field-1e16ecfd-ecda-506a-a72f-57bf0aaac1ce" :answer-field/id #uuid "1e16ecfd-ecda-506a-a72f-57bf0aaac1ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e0409b5a-bd0f-5146-b9ba-ff2fcb1d149b" :answer-field/choices ["answer-c97c539f-b49d-5a10-804a-fdc7d978fe94" "answer-e0409b5a-bd0f-5146-b9ba-ff2fcb1d149b" "answer-de6ccd7b-feeb-5a8f-8280-45a2401779e2" "answer-b91672bb-93d2-50b7-8eb9-de13911fe838" "answer-ab5ae73e-ff79-5c66-9c67-13be3d4cfbbc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c97c539f-b49d-5a10-804a-fdc7d978fe94" :answer/id #uuid "c97c539f-b49d-5a10-804a-fdc7d978fe94" :answer/type :answer.type/math :answer/value "\\frac{2x+1}{4x+y}" :db/ensure [:answer/validate]} {:db/id "answer-e0409b5a-bd0f-5146-b9ba-ff2fcb1d149b" :answer/id #uuid "e0409b5a-bd0f-5146-b9ba-ff2fcb1d149b" :answer/type :answer.type/math :answer/value "\\frac{2x+y}{2(2x+1)}" :db/ensure [:answer/validate]} {:db/id "answer-de6ccd7b-feeb-5a8f-8280-45a2401779e2" :answer/id #uuid "de6ccd7b-feeb-5a8f-8280-45a2401779e2" :answer/type :answer.type/math :answer/value "\\frac{2x+y}{x+2}" :db/ensure [:answer/validate]} {:db/id "answer-b91672bb-93d2-50b7-8eb9-de13911fe838" :answer/id #uuid "b91672bb-93d2-50b7-8eb9-de13911fe838" :answer/type :answer.type/math :answer/value "\\frac{2y+1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-ab5ae73e-ff79-5c66-9c67-13be3d4cfbbc" :answer/id #uuid "ab5ae73e-ff79-5c66-9c67-13be3d4cfbbc" :answer/type :answer.type/math :answer/value "\\frac{4x+y}{2x}" :db/ensure [:answer/validate]} {:db/id "question-f873ff79-08e6-53a2-8403-85dc4a081919" :question/id #uuid "f873ff79-08e6-53a2-8403-85dc4a081919" :question/math-academy-id "q-143633" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3x{y}^{2}}{14}, & \\,0\\le x\\le 1,\\,-1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x\\le 1,\\,-1\\le y\\le 3.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{-1}^{3}\\frac{3x{y}^{2}}{14}\\,\\text{d}y \\\\  & =\\frac{3x}{14}{\\int }_{-1}^{3}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{3x}{14}\\cdot \\frac{{y}^{3}}{3}\\,{|}_{-1}^{3} \\\\  & =\\frac{x}{14}\\cdot [27-(-1)] \\\\  & =2x.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2x, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le 1,\\,-1\\le y\\le 3,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3x{y}^{2}}{14})}{2x} \\\\  & =\\frac{3{y}^{2}}{28}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{3{y}^{2}}{28}, & \\,0\\le x\\le 1,\\,-1\\le y\\le 3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6ea5fec5-a0af-570b-bb41-e2eb4069b829"] :db/ensure [:question/validate]} {:db/id "answer-field-6ea5fec5-a0af-570b-bb41-e2eb4069b829" :answer-field/id #uuid "6ea5fec5-a0af-570b-bb41-e2eb4069b829" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-849cc2b5-4f4e-50d8-9169-5a909d23bf4a" :answer-field/choices ["answer-20f62924-6dd5-52ac-bd28-479c20aca94e" "answer-ed3bcf1a-3dc4-5e1f-8c31-d1add2e63f21" "answer-849cc2b5-4f4e-50d8-9169-5a909d23bf4a" "answer-75fd5efd-a360-53f9-9006-6a6a1d8e159f" "answer-d03e8f09-0450-5bd4-8ebb-657acd93cbc9"] :db/ensure [:answer-field/validate]} {:db/id "answer-20f62924-6dd5-52ac-bd28-479c20aca94e" :answer/id #uuid "20f62924-6dd5-52ac-bd28-479c20aca94e" :answer/type :answer.type/math :answer/value "15y" :db/ensure [:answer/validate]} {:db/id "answer-ed3bcf1a-3dc4-5e1f-8c31-d1add2e63f21" :answer/id #uuid "ed3bcf1a-3dc4-5e1f-8c31-d1add2e63f21" :answer/type :answer.type/math :answer/value "21{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-849cc2b5-4f4e-50d8-9169-5a909d23bf4a" :answer/id #uuid "849cc2b5-4f4e-50d8-9169-5a909d23bf4a" :answer/type :answer.type/math :answer/value "\\frac{3{y}^{2}}{28}" :db/ensure [:answer/validate]} {:db/id "answer-75fd5efd-a360-53f9-9006-6a6a1d8e159f" :answer/id #uuid "75fd5efd-a360-53f9-9006-6a6a1d8e159f" :answer/type :answer.type/math :answer/value "\\frac{9{y}^{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d03e8f09-0450-5bd4-8ebb-657acd93cbc9" :answer/id #uuid "d03e8f09-0450-5bd4-8ebb-657acd93cbc9" :answer/type :answer.type/math :answer/value "\\frac{y}{14}" :db/ensure [:answer/validate]} {:db/id "question-1967c2eb-a9e1-5379-9ffd-3708e127b5c8" :question/id #uuid "1967c2eb-a9e1-5379-9ffd-3708e127b5c8" :question/math-academy-id "q-143637" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{{e}^{x+y}}{2}, & \\,0\\le x\\le \\operatorname{ln}⁡3,\\,0\\le y\\le \\operatorname{ln}⁡2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x\\le \\operatorname{ln}⁡3,\\,0\\le y\\le \\operatorname{ln}⁡2.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\frac{{e}^{x+y}}{2}\\,\\text{d}y \\\\  & =\\frac{{e}^{x}}{2}{\\int }_{0}^{\\operatorname{ln}⁡2}{e}^{y}\\,\\text{d}y \\\\  & =\\frac{{e}^{x}}{2}\\cdot {e}^{y}\\,{|}_{0}^{\\operatorname{ln}⁡2} \\\\  & =\\frac{{e}^{x}}{2}\\cdot (2-1) \\\\  & =\\frac{{e}^{x}}{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{{e}^{x}}{2}, & \\,0\\le x\\le \\operatorname{ln}⁡3 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x\\le \\operatorname{ln}⁡3,\\,0\\le y\\le \\operatorname{ln}⁡2,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{{e}^{x+y}}{2})}{(\\frac{{e}^{x}}{2})} \\\\  & ={e}^{y}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}{e}^{y}, & \\,0\\le x\\le \\operatorname{ln}⁡3,\\,0\\le y\\le \\operatorname{ln}⁡2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-12430dc2-f5be-5736-9417-2b04f094d03d"] :db/ensure [:question/validate]} {:db/id "answer-field-12430dc2-f5be-5736-9417-2b04f094d03d" :answer-field/id #uuid "12430dc2-f5be-5736-9417-2b04f094d03d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0949f974-6ec9-5ea8-8abf-e774af8d8181" :answer-field/choices ["answer-ea3319c5-cf98-59ef-a3ca-016ee01f17e8" "answer-a324c1a2-ed56-5a2e-94f6-eaae1cefbad1" "answer-492c26d0-4de7-559c-b3c6-23e5c24bcbeb" "answer-d2a0eac0-1e8a-5d29-8b9c-eb8fd34e5908" "answer-0949f974-6ec9-5ea8-8abf-e774af8d8181"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea3319c5-cf98-59ef-a3ca-016ee01f17e8" :answer/id #uuid "ea3319c5-cf98-59ef-a3ca-016ee01f17e8" :answer/type :answer.type/math :answer/value "2{e}^{x+y}" :db/ensure [:answer/validate]} {:db/id "answer-a324c1a2-ed56-5a2e-94f6-eaae1cefbad1" :answer/id #uuid "a324c1a2-ed56-5a2e-94f6-eaae1cefbad1" :answer/type :answer.type/math :answer/value "2{e}^{y}" :db/ensure [:answer/validate]} {:db/id "answer-492c26d0-4de7-559c-b3c6-23e5c24bcbeb" :answer/id #uuid "492c26d0-4de7-559c-b3c6-23e5c24bcbeb" :answer/type :answer.type/math :answer/value "\\frac{{e}^{y}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d2a0eac0-1e8a-5d29-8b9c-eb8fd34e5908" :answer/id #uuid "d2a0eac0-1e8a-5d29-8b9c-eb8fd34e5908" :answer/type :answer.type/math :answer/value "{e}^{x+y}" :db/ensure [:answer/validate]} {:db/id "answer-0949f974-6ec9-5ea8-8abf-e774af8d8181" :answer/id #uuid "0949f974-6ec9-5ea8-8abf-e774af8d8181" :answer/type :answer.type/math :answer/value "{e}^{y}" :db/ensure [:answer/validate]} {:db/id "question-60bd267c-251c-5e47-b502-67f097fb7ef0" :question/id #uuid "60bd267c-251c-5e47-b502-67f097fb7ef0" :question/math-academy-id "q-145101" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{{x}^{2}+2y}{12}, & \\,0\\le x\\le 3,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 3,\\,0\\le y\\le 1.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{{x}^{2}+2y}{12}\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}(\\frac{{x}^{2}}{12}+\\frac{y}{6})\\text{d}x \\\\  & ={[\\frac{{x}^{3}}{36}+\\frac{xy}{6}]}_{x=0}^{x=3} \\\\  & =\\frac{27}{36}+\\frac{3y}{6}-0 \\\\  & =\\frac{3}{4}+\\frac{y}{2} \\\\  & =\\frac{2y+3}{4}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2y+3}{4}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 3,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{{x}^{2}+2y}{12})}{(\\frac{2y+3}{4})} \\\\  & =\\frac{{x}^{2}+2y}{3(2y+3)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{{x}^{2}+2y}{3(2y+3)}, & \\,0\\le x\\le 3,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8cb8d45a-30b0-5de1-a6e8-4ab5704badae"] :db/ensure [:question/validate]} {:db/id "answer-field-8cb8d45a-30b0-5de1-a6e8-4ab5704badae" :answer-field/id #uuid "8cb8d45a-30b0-5de1-a6e8-4ab5704badae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5dfec5ee-76b0-5274-a7c7-3fbca567739b" :answer-field/choices ["answer-476db03a-613d-54d1-8c90-950c1e79d5b7" "answer-41e1bf01-9793-54f8-9d28-af6f78aec84b" "answer-099b70eb-adf5-5c0b-935e-950c1e096556" "answer-5dfec5ee-76b0-5274-a7c7-3fbca567739b" "answer-05b5b39e-b50f-5667-85aa-10f98316c5ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-476db03a-613d-54d1-8c90-950c1e79d5b7" :answer/id #uuid "476db03a-613d-54d1-8c90-950c1e79d5b7" :answer/type :answer.type/math :answer/value "\\frac{2y+1}{2({x}^{2}+y)}" :db/ensure [:answer/validate]} {:db/id "answer-41e1bf01-9793-54f8-9d28-af6f78aec84b" :answer/id #uuid "41e1bf01-9793-54f8-9d28-af6f78aec84b" :answer/type :answer.type/math :answer/value "\\frac{2y+2}{x+2y}" :db/ensure [:answer/validate]} {:db/id "answer-099b70eb-adf5-5c0b-935e-950c1e096556" :answer/id #uuid "099b70eb-adf5-5c0b-935e-950c1e096556" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+2y}{2y+1}" :db/ensure [:answer/validate]} {:db/id "answer-5dfec5ee-76b0-5274-a7c7-3fbca567739b" :answer/id #uuid "5dfec5ee-76b0-5274-a7c7-3fbca567739b" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+2y}{3(2y+3)}" :db/ensure [:answer/validate]} {:db/id "answer-05b5b39e-b50f-5667-85aa-10f98316c5ac" :answer/id #uuid "05b5b39e-b50f-5667-85aa-10f98316c5ac" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+y}{3(y+3)}" :db/ensure [:answer/validate]} {:db/id "question-3b02f20a-35d0-57b1-ada9-f1273f1f3904" :question/id #uuid "3b02f20a-35d0-57b1-ada9-f1273f1f3904" :question/math-academy-id "q-143641" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{5x{y}^{2}}{32} & \\,\\frac{y}{2}\\le x\\le \\sqrt{y},\\,0<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $\\frac{y}{2}\\le x\\le \\sqrt{y},\\,0<y<4.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{y/2}^{\\sqrt{y}}\\frac{5x{y}^{2}}{32}\\,\\text{d}x \\\\  & =\\frac{5{y}^{2}}{32}{\\int }_{y/2}^{\\sqrt{y}}x\\,\\text{d}x \\\\  & =\\frac{5{y}^{2}}{32}\\cdot \\frac{{x}^{2}}{2}\\,{|}_{y/2}^{\\sqrt{y}} \\\\  & =\\frac{5{y}^{2}}{64}\\cdot (y-\\frac{{y}^{2}}{4}) \\\\  & =\\frac{5{y}^{3}(4-y)}{256}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{5{y}^{3}(4-y)}{256}, & \\,0<y<4 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $\\frac{y}{2}\\le x\\le \\sqrt{y},\\,0<y<4,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{5x{y}^{2}}{32})}{(\\frac{5{y}^{3}(4-y)}{256})} \\\\  & =\\frac{8x}{y(4-y)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{8x}{y(4-y)}, & \\,\\frac{y}{2}\\le x\\le \\sqrt{y},\\,0<y<4, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f41b096e-82c3-5dae-bf25-98903c7a8157"] :db/ensure [:question/validate]} {:db/id "answer-field-f41b096e-82c3-5dae-bf25-98903c7a8157" :answer-field/id #uuid "f41b096e-82c3-5dae-bf25-98903c7a8157" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b28cbfc4-beef-5aec-838d-bb8099b27e11" :answer-field/choices ["answer-41d76f20-9c01-572e-9bec-b4534a624512" "answer-9307b7d8-60d8-57f7-a4d6-b9b56f00ed28" "answer-bd07ced2-884b-510d-b5ef-173e5b1d1caf" "answer-697349f9-9995-58d2-a52b-dd64ff7d8349" "answer-b28cbfc4-beef-5aec-838d-bb8099b27e11"] :db/ensure [:answer-field/validate]} {:db/id "answer-41d76f20-9c01-572e-9bec-b4534a624512" :answer/id #uuid "41d76f20-9c01-572e-9bec-b4534a624512" :answer/type :answer.type/math :answer/value "16xy(4-y)" :db/ensure [:answer/validate]} {:db/id "answer-9307b7d8-60d8-57f7-a4d6-b9b56f00ed28" :answer/id #uuid "9307b7d8-60d8-57f7-a4d6-b9b56f00ed28" :answer/type :answer.type/math :answer/value "\\frac{2{x}^{2}}{{y}^{2}(4-y)}" :db/ensure [:answer/validate]} {:db/id "answer-bd07ced2-884b-510d-b5ef-173e5b1d1caf" :answer/id #uuid "bd07ced2-884b-510d-b5ef-173e5b1d1caf" :answer/type :answer.type/math :answer/value "\\frac{4xy}{4-y}" :db/ensure [:answer/validate]} {:db/id "answer-697349f9-9995-58d2-a52b-dd64ff7d8349" :answer/id #uuid "697349f9-9995-58d2-a52b-dd64ff7d8349" :answer/type :answer.type/math :answer/value "\\frac{5}{{y}^{2}(4-y)}" :db/ensure [:answer/validate]} {:db/id "answer-b28cbfc4-beef-5aec-838d-bb8099b27e11" :answer/id #uuid "b28cbfc4-beef-5aec-838d-bb8099b27e11" :answer/type :answer.type/math :answer/value "\\frac{8x}{y(4-y)}" :db/ensure [:answer/validate]} {:db/id "question-05787bc3-261f-5b82-bb66-810cc0eb28ae" :question/id #uuid "05787bc3-261f-5b82-bb66-810cc0eb28ae" :question/math-academy-id "q-145108" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2y+x}{4y+2}, & \\,0<x<2,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(\\frac{1}{4}<X<Y\\,|\\,Y=\\frac{3}{4}).$" :question/worked-solution "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(\\frac{1}{4}<X<Y\\,|\\,Y=\\frac{3}{4}) & ={\\int }_{1/4}^{y}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{3}{4})\\text{d}x \\\\  & ={\\int }_{1/4}^{3/4}\\frac{(2\\cdot \\frac{3}{4}+x)}{(4\\cdot \\frac{3}{4}+2)}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{1/4}^{3/4}(x+\\frac{3}{2})\\,\\text{d}x \\\\  & =\\frac{1}{5}{[\\frac{{x}^{2}}{2}+\\frac{3x}{2}]}_{1/4}^{3/4} \\\\  & =\\frac{1}{10}[{x}^{2}+3x]_{1/4}^{3/4} \\\\  & =\\frac{1}{10}({(\\frac{3}{4})}^{2}+3(\\frac{3}{4})-{(\\frac{1}{4})}^{2}-3(\\frac{1}{4})) \\\\  & =\\frac{1}{10}(\\frac{9}{16}+\\frac{9}{4}-\\frac{1}{16}-\\frac{3}{4}) \\\\  & =\\frac{1}{10}\\cdot 2 \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6064d30a-0a9e-55a1-8d02-c3cb038cef8f"] :db/ensure [:question/validate]} {:db/id "answer-field-6064d30a-0a9e-55a1-8d02-c3cb038cef8f" :answer-field/id #uuid "6064d30a-0a9e-55a1-8d02-c3cb038cef8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2589e333-131b-51b5-ad48-bd1130f65246" :answer-field/choices ["answer-8ccd639c-35b2-5792-9629-fe551a25b276" "answer-2589e333-131b-51b5-ad48-bd1130f65246" "answer-871f5b77-fc09-5ab2-85ec-496ea72f30af" "answer-b4b2770a-9e7a-586b-b171-0fbdfcac8124" "answer-11ea33cc-5f23-589d-8c23-7c092cbc2f29"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ccd639c-35b2-5792-9629-fe551a25b276" :answer/id #uuid "8ccd639c-35b2-5792-9629-fe551a25b276" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-2589e333-131b-51b5-ad48-bd1130f65246" :answer/id #uuid "2589e333-131b-51b5-ad48-bd1130f65246" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-871f5b77-fc09-5ab2-85ec-496ea72f30af" :answer/id #uuid "871f5b77-fc09-5ab2-85ec-496ea72f30af" :answer/type :answer.type/math :answer/value "\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id "answer-b4b2770a-9e7a-586b-b171-0fbdfcac8124" :answer/id #uuid "b4b2770a-9e7a-586b-b171-0fbdfcac8124" :answer/type :answer.type/math :answer/value "\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "answer-11ea33cc-5f23-589d-8c23-7c092cbc2f29" :answer/id #uuid "11ea33cc-5f23-589d-8c23-7c092cbc2f29" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "question-d2c3b01f-8b1d-5c9b-95df-4bf4aec9fac1" :question/id #uuid "d2c3b01f-8b1d-5c9b-95df-4bf4aec9fac1" :question/math-academy-id "q-143622" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{4}y\\sqrt{x}, & \\,0\\le x\\le 1,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(\\frac{1}{4}<Y<X\\,|\\,X=\\frac{3}{4}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}y,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{3}{4}y\\sqrt{x}\\,\\text{d}y \\\\  & =\\frac{3}{4}\\sqrt{x}{\\int }_{0}^{2}y\\,\\text{d}y \\\\  & =\\frac{3}{4}\\sqrt{x}{[\\frac{1}{2}{y}^{2}]}_{0}^{2} \\\\  & =\\frac{3}{2}\\sqrt{x}-0 \\\\  & =\\frac{3}{2}\\sqrt{x}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3}{2}\\sqrt{x}, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0<x<1,0<y<2,$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3}{4}y\\sqrt{x})}{(\\frac{3}{2}\\sqrt{x})} \\\\  & =\\frac{1}{2}y.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{1}{2}y, & \\,0\\le y\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(\\frac{1}{4}<Y<X\\,|\\,X=\\frac{3}{4}) & =P(\\frac{1}{4}<Y<\\frac{3}{4}\\,|\\,X=\\frac{3}{4}) \\\\  & ={\\int }_{1/4}^{3/4}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{3}{4})\\text{d}y \\\\  & ={\\int }_{1/4}^{3/4}\\frac{1}{2}y\\,\\text{d}y \\\\  & ={[\\frac{{y}^{2}}{4}]}_{1/4}^{3/4} \\\\  & =\\frac{1}{4}(\\frac{9}{16}-\\frac{1}{16}) \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e2ec7e2d-e700-5713-ba66-48bf13c5d6e2"] :db/ensure [:question/validate]} {:db/id "answer-field-e2ec7e2d-e700-5713-ba66-48bf13c5d6e2" :answer-field/id #uuid "e2ec7e2d-e700-5713-ba66-48bf13c5d6e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bbc4d93c-b651-5691-9445-a738e7a4241d" :answer-field/choices ["answer-a929b9b7-76e2-511c-af43-a8af03c8efa4" "answer-28a6421c-8bb1-5e74-b5ce-4488dab6060e" "answer-bbc4d93c-b651-5691-9445-a738e7a4241d" "answer-93edd067-6d4d-5723-af3e-e6c5a01044b8" "answer-b9f0f68c-757f-5ea6-b804-da070251f3d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-a929b9b7-76e2-511c-af43-a8af03c8efa4" :answer/id #uuid "a929b9b7-76e2-511c-af43-a8af03c8efa4" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-28a6421c-8bb1-5e74-b5ce-4488dab6060e" :answer/id #uuid "28a6421c-8bb1-5e74-b5ce-4488dab6060e" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-bbc4d93c-b651-5691-9445-a738e7a4241d" :answer/id #uuid "bbc4d93c-b651-5691-9445-a738e7a4241d" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-93edd067-6d4d-5723-af3e-e6c5a01044b8" :answer/id #uuid "93edd067-6d4d-5723-af3e-e6c5a01044b8" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-b9f0f68c-757f-5ea6-b804-da070251f3d9" :answer/id #uuid "b9f0f68c-757f-5ea6-b804-da070251f3d9" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "question-91a2a3a1-8ae1-5b13-976f-9bc558602e26" :question/id #uuid "91a2a3a1-8ae1-5b13-976f-9bc558602e26" :question/math-academy-id "q-143619" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}3x, & \\,y<x<1\\,,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(\\frac{1}{4}<X\\,|\\,Y=\\frac{1}{6}).$" :question/worked-solution "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}y,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$  \n\nUsing the formula for the marginal density function for $Y,$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{y}^{1}3x\\,\\text{d}x \\\\  & ={[\\frac{3}{2}{x}^{2}]}_{y}^{1} \\\\  & =\\frac{3}{2}(1-{y}^{2}).\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{2}(1-{y}^{2}), & \\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $y<x<1\\,,\\,0<y<1,$ we have\n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{3x}{(\\frac{3}{2}(1-{y}^{2}))} \\\\  & =\\frac{2x}{1-{y}^{2}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x}{1-{y}^{2}}, & \\,0<y<x<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(\\frac{1}{4}<X\\,|\\,Y=\\frac{1}{6}) & =P(\\frac{1}{4}<X\\,|\\,Y=\\frac{1}{6}) \\\\  & ={\\int }_{1/4}^{1}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{1}{6})\\text{d}x \\\\  & ={\\int }_{1/4}^{1}\\frac{2x}{(1-{(\\frac{1}{6})}^{2})}\\text{d}x \\\\  & ={\\int }_{1/4}^{1}\\frac{2x}{(\\frac{35}{36})}\\text{d}x \\\\  & =\\frac{36}{35}{\\int }_{1/4}^{1}2x\\,\\text{d}x \\\\  & =\\frac{36}{35}{[{x}^{2}]}_{1/4}^{1} \\\\  & =\\frac{36}{35}(1-\\frac{1}{16}) \\\\  & =\\frac{27}{28}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7c446274-85cc-56ab-805a-72556fc77fd7"] :db/ensure [:question/validate]} {:db/id "answer-field-7c446274-85cc-56ab-805a-72556fc77fd7" :answer-field/id #uuid "7c446274-85cc-56ab-805a-72556fc77fd7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e7d0ba3-02f6-59a7-be65-bf8f3801013a" :answer-field/choices ["answer-70730109-0401-592f-81a2-e4405b7b0f55" "answer-3da4eaa1-6cda-5d99-b813-20a4d9738e25" "answer-1e7d0ba3-02f6-59a7-be65-bf8f3801013a" "answer-e7050eac-3947-55c2-b302-d2bd01b29003" "answer-58bb21c1-450d-505d-b6dc-9db3c242bf5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-70730109-0401-592f-81a2-e4405b7b0f55" :answer/id #uuid "70730109-0401-592f-81a2-e4405b7b0f55" :answer/type :answer.type/math :answer/value "\\frac{15}{16}" :db/ensure [:answer/validate]} {:db/id "answer-3da4eaa1-6cda-5d99-b813-20a4d9738e25" :answer/id #uuid "3da4eaa1-6cda-5d99-b813-20a4d9738e25" :answer/type :answer.type/math :answer/value "\\frac{15}{28}" :db/ensure [:answer/validate]} {:db/id "answer-1e7d0ba3-02f6-59a7-be65-bf8f3801013a" :answer/id #uuid "1e7d0ba3-02f6-59a7-be65-bf8f3801013a" :answer/type :answer.type/math :answer/value "\\frac{27}{28}" :db/ensure [:answer/validate]} {:db/id "answer-e7050eac-3947-55c2-b302-d2bd01b29003" :answer/id #uuid "e7050eac-3947-55c2-b302-d2bd01b29003" :answer/type :answer.type/math :answer/value "\\frac{35}{36}" :db/ensure [:answer/validate]} {:db/id "answer-58bb21c1-450d-505d-b6dc-9db3c242bf5e" :answer/id #uuid "58bb21c1-450d-505d-b6dc-9db3c242bf5e" :answer/type :answer.type/math :answer/value "\\frac{9}{16}" :db/ensure [:answer/validate]} {:db/id "question-a05be7fd-94f3-5604-ad03-bc6e74737579" :question/id #uuid "a05be7fd-94f3-5604-ad03-bc6e74737579" :question/math-academy-id "q-143620" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}2x, & \\,0\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(\\frac{1}{5}<X\\,|\\,Y=\\frac{4}{3}).$" :question/worked-solution "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(\\frac{1}{5}<X\\,|\\,Y=\\frac{4}{3}) & ={\\int }_{1/5}^{1}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{4}{3})\\text{d}x \\\\  & ={\\int }_{1/5}^{1}2x\\,\\text{d}x \\\\  & =[{x}^{2}]_{1/5}^{1} \\\\  & =1-\\frac{1}{25} \\\\  & =\\frac{24}{25}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e7448890-beaa-51f5-b2f0-83828889fb49"] :db/ensure [:question/validate]} {:db/id "answer-field-e7448890-beaa-51f5-b2f0-83828889fb49" :answer-field/id #uuid "e7448890-beaa-51f5-b2f0-83828889fb49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a0f9475b-b7d3-5932-90b4-6269e7ee9da9" :answer-field/choices ["answer-d5b6de00-aaa3-58b8-919b-6ae993100929" "answer-8ccaa219-a0ea-583d-9e0c-efdebeabb3e6" "answer-a0f9475b-b7d3-5932-90b4-6269e7ee9da9" "answer-52c36d35-dfd3-59ca-b51c-6f8f7df4b4c3" "answer-30be591d-18e4-56ca-bd11-2cb0e73aa66b"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5b6de00-aaa3-58b8-919b-6ae993100929" :answer/id #uuid "d5b6de00-aaa3-58b8-919b-6ae993100929" :answer/type :answer.type/math :answer/value "\\frac{14}{15}" :db/ensure [:answer/validate]} {:db/id "answer-8ccaa219-a0ea-583d-9e0c-efdebeabb3e6" :answer/id #uuid "8ccaa219-a0ea-583d-9e0c-efdebeabb3e6" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-a0f9475b-b7d3-5932-90b4-6269e7ee9da9" :answer/id #uuid "a0f9475b-b7d3-5932-90b4-6269e7ee9da9" :answer/type :answer.type/math :answer/value "\\frac{24}{25}" :db/ensure [:answer/validate]} {:db/id "answer-52c36d35-dfd3-59ca-b51c-6f8f7df4b4c3" :answer/id #uuid "52c36d35-dfd3-59ca-b51c-6f8f7df4b4c3" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-30be591d-18e4-56ca-bd11-2cb0e73aa66b" :answer/id #uuid "30be591d-18e4-56ca-bd11-2cb0e73aa66b" :answer/type :answer.type/math :answer/value "\\frac{6}{25}" :db/ensure [:answer/validate]} {:db/id 17592186163291 :tutorial/content "We can easily extend the notion of conditional probability distributions for discrete random variables to continuous random variables.\n\nFor continuous random variables $X$ and $Y,$ the **conditional probability density function of $X$ given $Y = y$** is given by\n\n$$\nf_{X|Y} (x|y) =\\dfrac{f(x, y)}{f_Y (y)}, \\qquad f_Y(y) \\neq 0,\n$$\n\nand the conditional probability density function of $Y$ given $X = x$ is given by\n\n$$\nf_{Y|X} (y|x) =\\dfrac{f(x, y)}{f_X (x)}, \\qquad f_X(x) \\neq 0.\n$$\n\nNotice that these definitions are analogous to those for discrete random variables.\n\nTo compute probabilities, we work directly with these conditional PDFs. For example, to calculate the **conditional probability of $X$ given $Y,$** we use\n\n$$\nP(X \\in A|Y = y) =\\int_A f_{X|Y} (x|y)\\, \\textrm dx.\n$$\n\nIn general, the conditional distribution of $X$ given $Y$ does not equal the conditional distribution of $Y$  given $X$. That is\n\n$$\nf_{X|Y}(x|y)  \\ne f_{Y|X}(y|x).\n$$\n\nFinally, if $X$  and $Y$  are independent, then\n\n$$\nf_{X|Y}(x|y)=f_X(x),\\qquad f_{Y|X}(y|x)=f_Y(y).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186162176 :activity/expected-seconds 900.0 :db/ensure [:activity/validate]} {:db/id 17592186083325 :knowledge-point/questions ["question-e64f0682-cd52-5135-b0b3-08e76e7a1873" "question-d6b501ec-18d5-51e8-9a88-2c1c73e44bb9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e64f0682-cd52-5135-b0b3-08e76e7a1873" :question/id #uuid "e64f0682-cd52-5135-b0b3-08e76e7a1873" :question/math-academy-id "q-95082" :question/problem "A group of students took a test and got an average score of $79.$ Also, $15%$ of the students scored lower than $66.$ Assuming that the scores of the students are normally distributed, find the standard deviation of their scores, rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |" :question/worked-solution "Let $X$ represent the grade obtained by a student. Then we have $X∼N(79,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 66)=0.15.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 66) & =0.15 \\\\ P(Z\\le \\frac{66-79}{\\sigma }) & =0.15 \\\\ Φ(-\\frac{13}{\\sigma }) & =0.15 \\\\ -\\frac{13}{\\sigma } & ={Φ}^{-1}(0.15).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.85)=1.0364,\n$$\n\nand therefore by symmetry, we have\n\n$$\n{Φ}^{-1}(1-0.85)={Φ}^{-1}(0.15)=-1.0364.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{13}{\\sigma } & =-1.0364 \\\\ \\sigma  & =\\frac{-13}{-1.0364} \\\\  & ≈12.54.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c153adbb-ebdd-563f-aa07-ecead9219cce"] :db/ensure [:question/validate]} {:db/id "answer-field-c153adbb-ebdd-563f-aa07-ecead9219cce" :answer-field/id #uuid "c153adbb-ebdd-563f-aa07-ecead9219cce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc0bfe5f-9010-5b76-900e-a0a88d617f3b" :answer-field/choices ["answer-0bf6bb84-99f4-501b-898f-55beecfd0ae8" "answer-a07531b8-8752-5b56-b8df-4b8c0357540d" "answer-dc0bfe5f-9010-5b76-900e-a0a88d617f3b" "answer-6e877167-064e-5961-ba0d-9292251730e2" "answer-f64b54b4-f561-592c-ab77-9cb0208b121a"] :db/ensure [:answer-field/validate]} {:db/id "answer-0bf6bb84-99f4-501b-898f-55beecfd0ae8" :answer/id #uuid "0bf6bb84-99f4-501b-898f-55beecfd0ae8" :answer/type :answer.type/math :answer/value "10.89" :db/ensure [:answer/validate]} {:db/id "answer-a07531b8-8752-5b56-b8df-4b8c0357540d" :answer/id #uuid "a07531b8-8752-5b56-b8df-4b8c0357540d" :answer/type :answer.type/math :answer/value "11.44" :db/ensure [:answer/validate]} {:db/id "answer-dc0bfe5f-9010-5b76-900e-a0a88d617f3b" :answer/id #uuid "dc0bfe5f-9010-5b76-900e-a0a88d617f3b" :answer/type :answer.type/math :answer/value "12.54" :db/ensure [:answer/validate]} {:db/id "answer-6e877167-064e-5961-ba0d-9292251730e2" :answer/id #uuid "6e877167-064e-5961-ba0d-9292251730e2" :answer/type :answer.type/math :answer/value "13.66" :db/ensure [:answer/validate]} {:db/id "answer-f64b54b4-f561-592c-ab77-9cb0208b121a" :answer/id #uuid "f64b54b4-f561-592c-ab77-9cb0208b121a" :answer/type :answer.type/math :answer/value "15.51" :db/ensure [:answer/validate]} {:db/id 17592186083326 :knowledge-point/questions ["question-217980d1-12ff-5532-90b2-461f43899f04" "question-d34b6be0-737c-5c5c-907f-c713ce8e6b32"] :db/ensure [:knowledge-point/validate]} {:db/id "question-217980d1-12ff-5532-90b2-461f43899f04" :question/id #uuid "217980d1-12ff-5532-90b2-461f43899f04" :question/math-academy-id "q-95091" :question/problem "A truck travels an average distance of $21\\,\\text{mi}$ with a gallon of gas. However, $15%$ of the time, a truck travels more than $26\\,\\text{mi}$ on a gallon of gas. Assuming that the distance the truck can travel with a gallon of gas is normally distributed, find, as a percent, the proportion of journeys that the truck travels less than $15\\,\\text{mi}$ on a gallon of gas. Round your answer to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.03\\,$ | $\\,0.04\\,$ | $\\,0.05\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.3\\,$ | $\\,0.0918\\,$ | $\\,0.0901\\,$ | $\\,0.0885\\,$ |\n| $\\,-1.2\\,$ | $\\,0.1093\\,$ | $\\,0.1075\\,$ | $\\,0.1056\\,$ |\n| $\\,-1.1\\,$ | $\\,0.1292\\,$ | $\\,0.1271\\,$ | $\\,0.1251\\,$ |" :question/worked-solution "Let $X$ represent the distance traveled by the truck with a gallon of gas. Then we have $X∼N(21,{\\sigma }^{2}),$ and we want to find $P(X\\le 15).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>26)=0.15.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 26) & =1-P(X>26) \\\\  & =1-0.15 \\\\  & =0.85\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 26) & =0.85 \\\\ P(Z\\le \\frac{26-21}{\\sigma }) & =0.85 \\\\ Φ(\\frac{5}{\\sigma }) & =0.85 \\\\ \\frac{5}{\\sigma } & ={Φ}^{-1}(0.85)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.85)≈1.0364.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{5}{\\sigma } & =1.0364 \\\\ \\frac{1}{\\sigma } & =0.2073 \\\\ \\sigma  & =\\frac{1}{0.2073} \\\\  & ≈4.8239.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X\\le 15)$ as follows:\n\n$$\n\\begin{aligned}P(X\\le 15) & =P(Z\\le \\frac{15-21}{4.8239}) \\\\  & ≈P(Z\\le -1.24) \\\\  & =Φ(-1.24) \\\\  & =0.1075 \\\\  & ≈10.8%\\end{aligned}\n$$\n\nTherefore, approximately $10.8%$ of the time, a gallon of gas travels only $15\\,\\text{mi}$ or less." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d314da54-c3a8-55ac-8066-a2906576f626"] :db/ensure [:question/validate]} {:db/id "answer-field-d314da54-c3a8-55ac-8066-a2906576f626" :answer-field/id #uuid "d314da54-c3a8-55ac-8066-a2906576f626" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-032b45ef-0f8d-5228-ab53-44d951ab7b5a" :answer-field/choices ["answer-032b45ef-0f8d-5228-ab53-44d951ab7b5a" "answer-3f275ff8-361f-502e-8e26-7ac774e7b63d" "answer-0ef38244-8fdf-5af9-a467-8e572c929ba9" "answer-c9a1db81-4260-5c90-a443-a427b1dbd8f0" "answer-c3efee66-91d8-51df-9c99-66043ccf9a2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-032b45ef-0f8d-5228-ab53-44d951ab7b5a" :answer/id #uuid "032b45ef-0f8d-5228-ab53-44d951ab7b5a" :answer/type :answer.type/math :answer/value "10.8%" :db/ensure [:answer/validate]} {:db/id "answer-3f275ff8-361f-502e-8e26-7ac774e7b63d" :answer/id #uuid "3f275ff8-361f-502e-8e26-7ac774e7b63d" :answer/type :answer.type/math :answer/value "12.3%" :db/ensure [:answer/validate]} {:db/id "answer-0ef38244-8fdf-5af9-a467-8e572c929ba9" :answer/id #uuid "0ef38244-8fdf-5af9-a467-8e572c929ba9" :answer/type :answer.type/math :answer/value "15.4%" :db/ensure [:answer/validate]} {:db/id "answer-c9a1db81-4260-5c90-a443-a427b1dbd8f0" :answer/id #uuid "c9a1db81-4260-5c90-a443-a427b1dbd8f0" :answer/type :answer.type/math :answer/value "6.3%" :db/ensure [:answer/validate]} {:db/id "answer-c3efee66-91d8-51df-9c99-66043ccf9a2f" :answer/id #uuid "c3efee66-91d8-51df-9c99-66043ccf9a2f" :answer/type :answer.type/math :answer/value "8.7%" :db/ensure [:answer/validate]} {:db/id "question-d34b6be0-737c-5c5c-907f-c713ce8e6b32" :question/id #uuid "d34b6be0-737c-5c5c-907f-c713ce8e6b32" :question/math-academy-id "q-133236" :question/problem "The average height of a player in a particular professional basketball league is $78$ inches. Additionally, $15%$ of players are over $82$ inches tall. Assuming that a player's height is normally distributed, find the percentage of players over $75$ inches tall, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.9\\,$ | $\\,0.1660\\,$ | $\\,0.1635\\,$ | $\\,0.1611\\,$ |\n| $\\,-0.8\\,$ | $\\,0.1922\\,$ | $\\,0.1894\\,$ | $\\,0.1867\\,$ |\n| $\\,-0.7\\,$ | $\\,0.2206\\,$ | $\\,0.2177\\,$ | $\\,0.2148\\,$ |" :question/worked-solution "Let $X$ represent the height of a randomly selected player. Then we have $X∼N(78,{\\sigma }^{2}),$ and we want to find $P(X>75).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>82)=0.15.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 82) & =1-P(X>82) \\\\  & =1-0.15 \\\\  & =0.85\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 82) & =0.85 \\\\ P(Z\\le \\frac{82-78}{\\sigma }) & =0.85 \\\\ Φ(\\frac{4}{\\sigma }) & =0.85 \\\\ \\frac{4}{\\sigma } & ={Φ}^{-1}(0.85)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.85)≈1.0364.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{4}{\\sigma } & =1.0364 \\\\ \\frac{1}{\\sigma } & =0.2591 \\\\ \\sigma  & =\\frac{1}{0.2591} \\\\  & ≈3.85951.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X>75)$ as follows:\n\n$$\n\\begin{aligned}P(X>75) & =1-P(X\\le 75) \\\\  & =1-P(Z\\le \\frac{75-78}{3.85951}) \\\\  & ≈1-P(Z\\le -0.78) \\\\  & =1-Φ(-0.78) \\\\  & =1-0.2177 \\\\  & =0.7823 \\\\  & ≈78.2%\\end{aligned}\n$$\n\nTherefore, approximately $78.2%$ of players are over $75$ inch tall." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3d8d7f1f-3c0d-5b85-87f8-4a2364ded62c"] :db/ensure [:question/validate]} {:db/id "answer-field-3d8d7f1f-3c0d-5b85-87f8-4a2364ded62c" :answer-field/id #uuid "3d8d7f1f-3c0d-5b85-87f8-4a2364ded62c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-09021ce8-047e-5b0d-92f8-36d32076c19b" :answer-field/choices ["answer-99059b85-08c0-5911-bef5-b258cf55a646" "answer-09021ce8-047e-5b0d-92f8-36d32076c19b" "answer-7bce9ce0-a3ff-570e-86db-d819bc4f24bf" "answer-99eaaeec-7b23-5191-b1ac-c727b2e8bc60" "answer-2d58aa30-649a-5d30-86fd-836c82705dcb"] :db/ensure [:answer-field/validate]} {:db/id "answer-99059b85-08c0-5911-bef5-b258cf55a646" :answer/id #uuid "99059b85-08c0-5911-bef5-b258cf55a646" :answer/type :answer.type/math :answer/value "76.9%" :db/ensure [:answer/validate]} {:db/id "answer-09021ce8-047e-5b0d-92f8-36d32076c19b" :answer/id #uuid "09021ce8-047e-5b0d-92f8-36d32076c19b" :answer/type :answer.type/math :answer/value "78.2%" :db/ensure [:answer/validate]} {:db/id "answer-7bce9ce0-a3ff-570e-86db-d819bc4f24bf" :answer/id #uuid "7bce9ce0-a3ff-570e-86db-d819bc4f24bf" :answer/type :answer.type/math :answer/value "80.8%" :db/ensure [:answer/validate]} {:db/id "answer-99eaaeec-7b23-5191-b1ac-c727b2e8bc60" :answer/id #uuid "99eaaeec-7b23-5191-b1ac-c727b2e8bc60" :answer/type :answer.type/math :answer/value "81.1%" :db/ensure [:answer/validate]} {:db/id "answer-2d58aa30-649a-5d30-86fd-836c82705dcb" :answer/id #uuid "2d58aa30-649a-5d30-86fd-836c82705dcb" :answer/type :answer.type/math :answer/value "83.4%" :db/ensure [:answer/validate]} {:db/id "question-d6b501ec-18d5-51e8-9a88-2c1c73e44bb9" :question/id #uuid "d6b501ec-18d5-51e8-9a88-2c1c73e44bb9" :question/math-academy-id "q-324738" :question/problem "The lifespan of LED light bulbs is normally distributed with a mean of $40,000$ hours and an unknown standard deviation $\\sigma .$ Tests show that $10%$ of bulbs fail before $36,000$ hours. Assuming a normal model, find the standard deviation, **rounded to the nearest integer.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $\\,z\\,$ | $0.75$ | $0.8$ | $0.85$ | $0.9$ | $0.95$ |\n| --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ |\n\n$\\sigma ≈$\n{{field-1}}\n$h$" :question/worked-solution "Let $X$ represent the lifespan of an LED bulb. Then we have $X∼N(40,000,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X<36,000)=0.10.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<36,000) & =0.10 \\\\ P(Z\\le \\frac{36,000-40,000}{\\sigma }) & =0.10 \\\\ Φ(-\\frac{4,000}{\\sigma }) & =0.10 \\\\ -\\frac{4,000}{\\sigma } & ={Φ}^{-1}(0.10).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.9)=1.2816,\n$$\n\nand therefore, by symmetry, we have\n\n$$\n{Φ}^{-1}(0.10)=-1.2816.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{4,000}{\\sigma } & =-1.2816 \\\\ \\frac{4,000}{\\sigma } & =1.2816 \\\\ \\sigma  & =\\frac{4,000}{1.2816} \\\\ \\sigma  & ≈3,121\\,\\text{h.}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9151a6ca-f2c2-5987-ba7e-6def5ae3cbbb"] :db/ensure [:question/validate]} {:db/id "answer-field-9151a6ca-f2c2-5987-ba7e-6def5ae3cbbb" :answer-field/id #uuid "9151a6ca-f2c2-5987-ba7e-6def5ae3cbbb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-83f88efb-26a7-5927-a3a0-854d67c40077" :answer-field/choices ["answer-83f88efb-26a7-5927-a3a0-854d67c40077"] :db/ensure [:answer-field/validate]} {:db/id "answer-83f88efb-26a7-5927-a3a0-854d67c40077" :answer/id #uuid "83f88efb-26a7-5927-a3a0-854d67c40077" :answer/type :answer.type/math :answer/value "3121" :db/ensure [:answer/validate]} {:db/id "activity-bf6ac6fe-4108-5b06-889b-5042a2db6611" :activity/id #uuid "bf6ac6fe-4108-5b06-889b-5042a2db6611" :activity/title "Modeling With the Normal Distribution" :activity/type :activity.type/review :activity/scope 17592186050198 :activity/course 17592186046658 :activity/steps ["step-56641216-408e-5e32-aa9c-fd0d315b82bb" "step-9bbd7fd0-91ef-5408-a5b3-5e27ebef199f" "step-32dc4d78-bb43-5899-aa0c-4eaf5371d15f" "step-7740d24e-5ea6-5c07-adbb-1160b7ed84f3" "step-6ad30f7d-f1bb-527b-8b86-a6ac3a6b2e3a"] :activity/first-step "step-56641216-408e-5e32-aa9c-fd0d315b82bb" :db/ensure [:activity/validate]} {:db/id "step-56641216-408e-5e32-aa9c-fd0d315b82bb" :step/id #uuid "56641216-408e-5e32-aa9c-fd0d315b82bb" :step/content 17592186360541 :step/next "step-9bbd7fd0-91ef-5408-a5b3-5e27ebef199f" :db/ensure [:step/validate]} {:db/id "step-9bbd7fd0-91ef-5408-a5b3-5e27ebef199f" :step/id #uuid "9bbd7fd0-91ef-5408-a5b3-5e27ebef199f" :step/content "question-e64f0682-cd52-5135-b0b3-08e76e7a1873" :step/next "step-32dc4d78-bb43-5899-aa0c-4eaf5371d15f" :db/ensure [:step/validate]} {:db/id "step-32dc4d78-bb43-5899-aa0c-4eaf5371d15f" :step/id #uuid "32dc4d78-bb43-5899-aa0c-4eaf5371d15f" :step/content "question-217980d1-12ff-5532-90b2-461f43899f04" :step/next "step-7740d24e-5ea6-5c07-adbb-1160b7ed84f3" :db/ensure [:step/validate]} {:db/id "step-7740d24e-5ea6-5c07-adbb-1160b7ed84f3" :step/id #uuid "7740d24e-5ea6-5c07-adbb-1160b7ed84f3" :step/content "question-d34b6be0-737c-5c5c-907f-c713ce8e6b32" :step/next "step-6ad30f7d-f1bb-527b-8b86-a6ac3a6b2e3a" :db/ensure [:step/validate]} {:db/id "step-6ad30f7d-f1bb-527b-8b86-a6ac3a6b2e3a" :step/id #uuid "6ad30f7d-f1bb-527b-8b86-a6ac3a6b2e3a" :step/content "question-d6b501ec-18d5-51e8-9a88-2c1c73e44bb9" :db/ensure [:step/validate]} {:db/id 17592186078463 :knowledge-point/questions ["question-9b2690e5-910c-5f9f-9900-ab879a8e0507"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078181 :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $3$ and the common difference is $2.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\na_n= a_{1}+(n-1)d.\n$$\n\nWe are told that the first term is $a_1={\\color{blue}3}$ and the common difference is $d={\\color{red}2}.$ So, we substitute into the formula and simplify:\n\n$$\n\\eqalign{\n\t\ta_n\t&= a_{1}+(n-1)d \\[3pt]\n\t\t\t&= {\\color{blue}3} + (n - 1)({\\color{red}2})  \\[3pt]\n\t\t\t&= 3 + 2n -2 \\[3pt]\n\t\t\t& =2n+1\n}\n$$\n\nTherefore the formula for the $n$th term is $a_n = 2n+1.$" :db/ensure [:question/validate]} {:db/id 17592186078464 :knowledge-point/questions ["question-8eb6a381-be92-55fb-a425-16a442e609ca" "question-f4a1a68f-984f-511a-88be-72b335a1e5eb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078182 :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $0$ and the second term is $-2.$ Express your answer in function notation." :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)= f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)={\\color{blue}0}.$ Also, the common difference of the sequence can be found as\n\n$$\nd=-2 - 0 = {\\color{red}-2}.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\eqalign{\nf(n)&= f(1)+(n-1)d \\[3pt]\n&= {\\color{blue}0} + (n - 1)({\\color{red}-2})  \\[3pt]\n&= 0 - 2n + 2 \\[3pt]\n&= 2 - 2n\n}\n$$\n\nTherefore, the formula for the $n$th term is $f(n) = 2 - 2n.$" :db/ensure [:question/validate]} {:db/id 17592186078465 :knowledge-point/questions ["question-c129ef1c-2ac1-51e8-b05a-e3f368cf0b6f" "question-013f16dc-6316-5e58-8d55-c6702c89f1f0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078184 :question/problem "Find the $50$th term of the following arithmetic sequence.\n\n$$\n-5, \\: -8, \\: -11, \\: \\ldots\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\na_n= a_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n{\\color{blue}-5}, \\: -8, \\: -11, \\ldots,\n$$\n\nwe see that the first term is $a_1={\\color{blue}-5}$ and the common difference is \n\n$$\nd=-8-(-5)={\\color{red}-3}.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\eqalign{\na_n&= a_{1}+(n-1)d \\[3pt]\n&= {\\color{blue}-5} + (n - 1)({\\color{red}-3})  \\[3pt]\n& =-5 -3n + 3 \\[3pt]\n&=-3n-2\n}\n$$\n\nNow, we can use our formula to find the $50$th term. All we have to do is substitute $n=50\\mathbin{:}$\n\n$$\n\\eqalign{\na_n &=-3n-2 \\[7pt]\na_{50} &= -3(50)-2 \\[3pt]\n&= -150-2 \\[3pt]\n&= -152\t\n}\n$$\n\nTherefore, the $50$th term of the sequence is $a_{50}=-152.$" :db/ensure [:question/validate]} {:db/id 17592186078466 :knowledge-point/questions ["question-59d1d85b-3b0d-5f71-98d3-9151bc5e371c" "question-36a772ef-4e2c-580e-97bd-8718ab74d591"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078186 :question/problem "Find the formula for the $n$th term of the arithmetic sequence that has a $7$th term equal to $-34$ and a common difference of $-5.$" :question/worked-solution "First, notice that $a_{7}=-34$ is $6$ jumps after $a_1$.\n\n![](images/ea/ea803977d4861ad654bd29ff15f706fdd1d11f71dbf7c885f175fe8168f21b66.png)\n\nHence, we can write\n\n$$\na_{7} = a_1 + 6d,\n$$\n\nand solve for $a_1$ as follows:\n\n$$\n\\begin{aligned}{a}_{7} & ={a}_{1}+6d \\\\ -34 & ={a}_{1}+6(-5) \\\\ -34 & ={a}_{1}-30 \\\\ -4 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-4+(n-1)(-5) \\\\  & =-4-5n+5 \\\\  & =1-5n.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-9b2690e5-910c-5f9f-9900-ab879a8e0507" :question/id #uuid "9b2690e5-910c-5f9f-9900-ab879a8e0507" :question/math-academy-id "q-5288" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $5$ and the common difference is $1.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nWe are told that the first term is ${a}_{1}=5$ and the common difference is $d=1.$ So, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =5+(n-1)(1) \\\\  & =5+n-1 \\\\  & =4+n\\end{aligned}\n$$\n\nTherefore the formula for the $n$th term is ${a}_{n}=4+n.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-05d3aa33-1231-5643-97cb-aa9155290797"] :db/ensure [:question/validate]} {:db/id "answer-field-05d3aa33-1231-5643-97cb-aa9155290797" :answer-field/id #uuid "05d3aa33-1231-5643-97cb-aa9155290797" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e21d868-17ef-5b93-99b4-bc4569ef160b" :answer-field/choices ["answer-ce2dabb7-fe80-557d-a625-d071ad95e3f1" "answer-7e21d868-17ef-5b93-99b4-bc4569ef160b" "answer-aebb7654-fbed-542c-a4bc-79c62b80278b" "answer-050708e2-6739-52e9-a46f-7cb0ac68aaf0" "answer-5dfa4269-cbb8-59e7-a7f8-f135398c2025"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce2dabb7-fe80-557d-a625-d071ad95e3f1" :answer/id #uuid "ce2dabb7-fe80-557d-a625-d071ad95e3f1" :answer/type :answer.type/math :answer/value "{a}_{n}=-5n-4" :db/ensure [:answer/validate]} {:db/id "answer-7e21d868-17ef-5b93-99b4-bc4569ef160b" :answer/id #uuid "7e21d868-17ef-5b93-99b4-bc4569ef160b" :answer/type :answer.type/math :answer/value "{a}_{n}=4+n" :db/ensure [:answer/validate]} {:db/id "answer-aebb7654-fbed-542c-a4bc-79c62b80278b" :answer/id #uuid "aebb7654-fbed-542c-a4bc-79c62b80278b" :answer/type :answer.type/math :answer/value "{a}_{n}=5n-4" :db/ensure [:answer/validate]} {:db/id "answer-050708e2-6739-52e9-a46f-7cb0ac68aaf0" :answer/id #uuid "050708e2-6739-52e9-a46f-7cb0ac68aaf0" :answer/type :answer.type/math :answer/value "{a}_{n}=5n-5" :db/ensure [:answer/validate]} {:db/id "answer-5dfa4269-cbb8-59e7-a7f8-f135398c2025" :answer/id #uuid "5dfa4269-cbb8-59e7-a7f8-f135398c2025" :answer/type :answer.type/math :answer/value "{a}_{n}=n-1" :db/ensure [:answer/validate]} {:db/id 17592186078778 :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $3$ and the second term is $9.$\n\n${a}_{n}=$\n{{field-1}}\n$,\\,n\\ge 1$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nWe are given the first term ${a}_{1}=3.$ Also, the common difference of the sequence can be found as\n\n$$\nd=9-3=6.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =3+(n-1)(6) \\\\  & =3+6n-6 \\\\  & =6n-3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186075709 :answer-field/correct "answer-3c1d05ff-438c-5f82-b8ed-53c691355ff6" :answer-field/choices ["answer-3c1d05ff-438c-5f82-b8ed-53c691355ff6"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c1d05ff-438c-5f82-b8ed-53c691355ff6" :answer/id #uuid "3c1d05ff-438c-5f82-b8ed-53c691355ff6" :answer/type :answer.type/math :answer/value "6n-3" :db/ensure [:answer/validate]} {:db/id "question-8eb6a381-be92-55fb-a425-16a442e609ca" :question/id #uuid "8eb6a381-be92-55fb-a425-16a442e609ca" :question/math-academy-id "q-5284" :question/problem "Find the general formula  for the $n$th term of an arithmetic sequence that begins with \n\n$$\n8,\\,4,\\,0,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nFrom the first few terms\n\n$$\n8,\\,4,\\,0,\\,…,\n$$\n\nwe see that the first term is $f(1)=8$ and the common difference is \n\n$$\nd=4-8=-4.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =8+(n-1)(-4) \\\\  & =8-4n+4 \\\\  & =12-4n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=12-4n.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-19425ac1-ab9b-59bf-ab5e-e629e3ebf1e6"] :db/ensure [:question/validate]} {:db/id "answer-field-19425ac1-ab9b-59bf-ab5e-e629e3ebf1e6" :answer-field/id #uuid "19425ac1-ab9b-59bf-ab5e-e629e3ebf1e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3d98fcee-0127-556a-9c59-b169c73657ac" :answer-field/choices ["answer-a723d771-0731-523c-87d1-fa2865987176" "answer-3d98fcee-0127-556a-9c59-b169c73657ac" "answer-e28d317f-755b-5cbc-bd91-2aa99f3df59b" "answer-589da9c7-c786-52ba-ac87-f1033636dc73" "answer-30f18ff3-8803-5b11-b715-566a43baad55"] :db/ensure [:answer-field/validate]} {:db/id "answer-a723d771-0731-523c-87d1-fa2865987176" :answer/id #uuid "a723d771-0731-523c-87d1-fa2865987176" :answer/type :answer.type/math :answer/value "f(n)=0" :db/ensure [:answer/validate]} {:db/id "answer-3d98fcee-0127-556a-9c59-b169c73657ac" :answer/id #uuid "3d98fcee-0127-556a-9c59-b169c73657ac" :answer/type :answer.type/math :answer/value "f(n)=12-4n" :db/ensure [:answer/validate]} {:db/id "answer-e28d317f-755b-5cbc-bd91-2aa99f3df59b" :answer/id #uuid "e28d317f-755b-5cbc-bd91-2aa99f3df59b" :answer/type :answer.type/math :answer/value "f(n)=4-4n" :db/ensure [:answer/validate]} {:db/id "answer-589da9c7-c786-52ba-ac87-f1033636dc73" :answer/id #uuid "589da9c7-c786-52ba-ac87-f1033636dc73" :answer/type :answer.type/math :answer/value "f(n)=8+4n" :db/ensure [:answer/validate]} {:db/id "answer-30f18ff3-8803-5b11-b715-566a43baad55" :answer/id #uuid "30f18ff3-8803-5b11-b715-566a43baad55" :answer/type :answer.type/math :answer/value "f(n)=8-8n" :db/ensure [:answer/validate]} {:db/id "question-f4a1a68f-984f-511a-88be-72b335a1e5eb" :question/id #uuid "f4a1a68f-984f-511a-88be-72b335a1e5eb" :question/math-academy-id "q-76514" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $4$ and the second term is $-2.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=4.$ Also, the common difference of the sequence can be found as\n\n$$\nd=-2-4=-6.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =4+(n-1)(-6) \\\\  & =4-6n+6 \\\\  & =10-6n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=10-6n.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-910c3056-976b-5fa4-a81b-5a9f980f88e7"] :db/ensure [:question/validate]} {:db/id "answer-field-910c3056-976b-5fa4-a81b-5a9f980f88e7" :answer-field/id #uuid "910c3056-976b-5fa4-a81b-5a9f980f88e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-788facef-43a8-5a7d-a331-a2690d5bf0e0" :answer-field/choices ["answer-1b4fb817-c6ac-5573-bf1c-5cb3e3b8e337" "answer-2fa48722-fce0-58fe-b017-004d5dd19c15" "answer-788facef-43a8-5a7d-a331-a2690d5bf0e0" "answer-a8bcb7f8-b4e0-5766-86bd-8d08ad9105fa" "answer-b080650d-ed5c-56d2-bdb9-2577c9308fa6"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b4fb817-c6ac-5573-bf1c-5cb3e3b8e337" :answer/id #uuid "1b4fb817-c6ac-5573-bf1c-5cb3e3b8e337" :answer/type :answer.type/math :answer/value "f(n)=-2+6n" :db/ensure [:answer/validate]} {:db/id "answer-2fa48722-fce0-58fe-b017-004d5dd19c15" :answer/id #uuid "2fa48722-fce0-58fe-b017-004d5dd19c15" :answer/type :answer.type/math :answer/value "f(n)=10-2n" :db/ensure [:answer/validate]} {:db/id "answer-788facef-43a8-5a7d-a331-a2690d5bf0e0" :answer/id #uuid "788facef-43a8-5a7d-a331-a2690d5bf0e0" :answer/type :answer.type/math :answer/value "f(n)=10-6n" :db/ensure [:answer/validate]} {:db/id "answer-a8bcb7f8-b4e0-5766-86bd-8d08ad9105fa" :answer/id #uuid "a8bcb7f8-b4e0-5766-86bd-8d08ad9105fa" :answer/type :answer.type/math :answer/value "f(n)=2-6n" :db/ensure [:answer/validate]} {:db/id "answer-b080650d-ed5c-56d2-bdb9-2577c9308fa6" :answer/id #uuid "b080650d-ed5c-56d2-bdb9-2577c9308fa6" :answer/type :answer.type/math :answer/value "f(n)=6-2n" :db/ensure [:answer/validate]} {:db/id "question-c129ef1c-2ac1-51e8-b05a-e3f368cf0b6f" :question/id #uuid "c129ef1c-2ac1-51e8-b05a-e3f368cf0b6f" :question/math-academy-id "q-214183" :question/problem "Consider the following arithmetic sequence.\n\n$$\n7,\\,3,\\,-1,\\,-5,\\,…\n$$\n\nWhat is the $34$th term of this sequence?\n\n${a}_{34}=$\n{{field-1}}" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n7,\\,3,\\,-1,\\,-5,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=7$ and the common difference is \n\n$$\nd=3-7=-4.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =7+(n-1)(-4) \\\\  & =7-4n+4 \\\\  & =11-4n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $34$th term. All we have to do is substitute $n=34:$\n\n$$\n\\begin{aligned}{a}_{n} & =11-4n \\\\ {a}_{34} & =11-4(34) \\\\  & =11-136 \\\\  & =-125\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-10dee7ea-51b0-5e81-8645-f21eaee40664"] :db/ensure [:question/validate]} {:db/id "answer-field-10dee7ea-51b0-5e81-8645-f21eaee40664" :answer-field/id #uuid "10dee7ea-51b0-5e81-8645-f21eaee40664" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b362f619-d001-5550-b24b-0b7f5e3c596c" :answer-field/choices ["answer-b362f619-d001-5550-b24b-0b7f5e3c596c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b362f619-d001-5550-b24b-0b7f5e3c596c" :answer/id #uuid "b362f619-d001-5550-b24b-0b7f5e3c596c" :answer/type :answer.type/math :answer/value "-125" :db/ensure [:answer/validate]} {:db/id "question-013f16dc-6316-5e58-8d55-c6702c89f1f0" :question/id #uuid "013f16dc-6316-5e58-8d55-c6702c89f1f0" :question/math-academy-id "q-236631" :question/problem "Consider the following arithmetic sequence.\n\n$$\n-13,\\,-9,\\,-5,\\,-1,\\,…\n$$\n\nWhat is the $36$th term of this sequence?\n\n${a}_{36}=$\n{{field-1}}" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n-13,\\,-9,\\,-5,\\,-1,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=-13$ and the common difference is \n\n$$\nd=-9-(-13)=4.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-13+(n-1)(4) \\\\  & =-13+4n-4 \\\\  & =4n-17\\end{aligned}\n$$\n\nNow, we can use our formula to find the $36$th term. All we have to do is substitute $n=36:$\n\n$$\n\\begin{aligned}{a}_{n} & =4n-17 \\\\ {a}_{36} & =4(36)-17 \\\\  & =144-17 \\\\  & =127\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e60cf3ae-4bd3-5233-9ad0-0f3680423eff"] :db/ensure [:question/validate]} {:db/id "answer-field-e60cf3ae-4bd3-5233-9ad0-0f3680423eff" :answer-field/id #uuid "e60cf3ae-4bd3-5233-9ad0-0f3680423eff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a218f878-fb16-539b-b22d-b8217b3611ec" :answer-field/choices ["answer-a218f878-fb16-539b-b22d-b8217b3611ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-a218f878-fb16-539b-b22d-b8217b3611ec" :answer/id #uuid "a218f878-fb16-539b-b22d-b8217b3611ec" :answer/type :answer.type/math :answer/value "127" :db/ensure [:answer/validate]} {:db/id "question-59d1d85b-3b0d-5f71-98d3-9151bc5e371c" :question/id #uuid "59d1d85b-3b0d-5f71-98d3-9151bc5e371c" :question/math-academy-id "q-76518" :question/problem "Given an arithmetic sequence that has ${a}_{8}=8$ and the common difference $d=4$, what is the general formula for the $n$th term of the sequence?" :question/worked-solution "Since ${a}_{8}=8$ is $7$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{8} & ={a}_{1}+7d \\\\ 8 & ={a}_{1}+7(4) \\\\ 8 & ={a}_{1}+28 \\\\ -20 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-20+(n-1)(4) \\\\  & =-20+4n-4 \\\\  & =4n-24\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ec14b21-c438-5bac-886f-56773de8e73f"] :db/ensure [:question/validate]} {:db/id "answer-field-0ec14b21-c438-5bac-886f-56773de8e73f" :answer-field/id #uuid "0ec14b21-c438-5bac-886f-56773de8e73f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc3ef00d-b613-5fc9-bf0e-97d50b59965c" :answer-field/choices ["answer-b96bdae9-d9de-5734-a615-2c84228625cd" "answer-806f0976-cc03-5853-8177-97913af01160" "answer-d345e9f4-3bf0-5d26-852b-c84101a6e872" "answer-bc3ef00d-b613-5fc9-bf0e-97d50b59965c" "answer-f65ad03b-76c0-5d45-8fb0-eb2a1ab3bb6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b96bdae9-d9de-5734-a615-2c84228625cd" :answer/id #uuid "b96bdae9-d9de-5734-a615-2c84228625cd" :answer/type :answer.type/math :answer/value "{a}_{n}=-4n+36" :db/ensure [:answer/validate]} {:db/id "answer-806f0976-cc03-5853-8177-97913af01160" :answer/id #uuid "806f0976-cc03-5853-8177-97913af01160" :answer/type :answer.type/math :answer/value "{a}_{n}=-4n+40" :db/ensure [:answer/validate]} {:db/id "answer-d345e9f4-3bf0-5d26-852b-c84101a6e872" :answer/id #uuid "d345e9f4-3bf0-5d26-852b-c84101a6e872" :answer/type :answer.type/math :answer/value "{a}_{n}=4n-20" :db/ensure [:answer/validate]} {:db/id "answer-bc3ef00d-b613-5fc9-bf0e-97d50b59965c" :answer/id #uuid "bc3ef00d-b613-5fc9-bf0e-97d50b59965c" :answer/type :answer.type/math :answer/value "{a}_{n}=4n-24" :db/ensure [:answer/validate]} {:db/id "answer-f65ad03b-76c0-5d45-8fb0-eb2a1ab3bb6c" :answer/id #uuid "f65ad03b-76c0-5d45-8fb0-eb2a1ab3bb6c" :answer/type :answer.type/math :answer/value "{a}_{n}=4n-28" :db/ensure [:answer/validate]} {:db/id "question-36a772ef-4e2c-580e-97bd-8718ab74d591" :question/id #uuid "36a772ef-4e2c-580e-97bd-8718ab74d591" :question/math-academy-id "q-236649" :question/problem "Find the formula for the $n$th term of the arithmetic sequence that has ${a}_{25}=95$ and the common difference $d=4.$\n\n${a}_{n}=$\n{{field-1}}$,\\,n\\ge 1$" :question/worked-solution "Since ${a}_{25}=95$ is $24$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{25} & ={a}_{1}+24d \\\\ 95 & ={a}_{1}+24(4) \\\\ 95 & ={a}_{1}+96 \\\\ -1 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-1+(n-1)(4) \\\\  & =-1+4n-4 \\\\  & =4n-5\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-66a0ebd0-c132-5683-85ec-156c80eb20e0"] :db/ensure [:question/validate]} {:db/id "answer-field-66a0ebd0-c132-5683-85ec-156c80eb20e0" :answer-field/id #uuid "66a0ebd0-c132-5683-85ec-156c80eb20e0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0c7c8818-c782-5316-80da-ffd05ab11d65" :answer-field/choices ["answer-0c7c8818-c782-5316-80da-ffd05ab11d65"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c7c8818-c782-5316-80da-ffd05ab11d65" :answer/id #uuid "0c7c8818-c782-5316-80da-ffd05ab11d65" :answer/type :answer.type/math :answer/value "4n-5" :db/ensure [:answer/validate]} {:db/id 17592186079727 :tutorial/content "The explicit formula for the $n$th term of an arithmetic sequence is given by\n\n$$\na_n = a_1 + (n-1)d,\n$$\n\nwhere $a_1$ is the first term and $d$ is a common difference.\n\nTo illustrate how this works, suppose we want to find the $20$th term of the following arithmetic sequence:\n\n$$\n{\\color{blue}2}, \\: 5, \\: 8, \\: 11, \\: 14, \\: \\ldots\n$$\n\nThe first term is $a_1={\\color{blue}2},$ and the common difference is \n\n$$\nd=5-2={\\color{red}3}.\n$$\n\nSo, we can write the formula for the $n$th term of the sequence as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =2+(n-1)(3) \\\\  & =2+3n-3 \\\\  & =3n-1\\end{aligned}\n$$\n\nTo find the $20$th term, we can use this formula with $n=20\\mathbin{:}$\n\n$$\n\\begin{aligned}{a}_{n} & =3n-1 \\\\ {a}_{20} & =3(20)-1 \\\\  & =60-1 \\\\  & =59\\end{aligned}\n$$\n\nTherefore, the $20$th term is $a_{20}=59.$ Using the formula was much quicker than writing out all $20$ terms of the sequence!" :db/ensure [:tutorial/validate]} {:db/id 17592186078684 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id 17592186404371 :question/problem "Find the global extrema of the function $f(x,y)={x}^{2}-6x+{y}^{2}+1$ on the closed region  $D=\\{(x,y):{x}^{2}+{y}^{2}\\le 4\\}.$ You are given that $f$ has a critical point at  $(3,0)$ and on the boundary of the region the points that could give rise to extreme values are  $(-2,0)$, and $(2,0).$" :db/ensure [:question/validate]} {:db/id "activity-79abe856-9095-50a4-97c9-7cfb29314a6e" :activity/id #uuid "79abe856-9095-50a4-97c9-7cfb29314a6e" :activity/title "Calculating Global Extrema of Multivariable Functions" :activity/type :activity.type/review :activity/scope 17592186048450 :activity/course 17592186046644 :activity/steps ["step-20a41044-e252-5c1f-903d-a7342279ea7c" "step-d08cd63e-5c2f-51e0-8828-4fef355f9f9d" "step-911eba01-d7be-5536-a2d5-ce849d22fea6" "step-17b3d78a-4c11-56d5-8c1a-c9703c363db5" "step-0f8f73fe-f9ae-57fa-a170-226128cdae07"] :activity/first-step "step-20a41044-e252-5c1f-903d-a7342279ea7c" :db/ensure [:activity/validate]} {:db/id "step-20a41044-e252-5c1f-903d-a7342279ea7c" :step/id #uuid "20a41044-e252-5c1f-903d-a7342279ea7c" :step/content 17592186125033 :step/next "step-d08cd63e-5c2f-51e0-8828-4fef355f9f9d" :db/ensure [:step/validate]} {:db/id "step-d08cd63e-5c2f-51e0-8828-4fef355f9f9d" :step/id #uuid "d08cd63e-5c2f-51e0-8828-4fef355f9f9d" :step/content 17592186446490 :step/next "step-911eba01-d7be-5536-a2d5-ce849d22fea6" :db/ensure [:step/validate]} {:db/id "step-911eba01-d7be-5536-a2d5-ce849d22fea6" :step/id #uuid "911eba01-d7be-5536-a2d5-ce849d22fea6" :step/content 17592186446480 :step/next "step-17b3d78a-4c11-56d5-8c1a-c9703c363db5" :db/ensure [:step/validate]} {:db/id "step-17b3d78a-4c11-56d5-8c1a-c9703c363db5" :step/id #uuid "17b3d78a-4c11-56d5-8c1a-c9703c363db5" :step/content 17592186404364 :step/next "step-0f8f73fe-f9ae-57fa-a170-226128cdae07" :db/ensure [:step/validate]} {:db/id "step-0f8f73fe-f9ae-57fa-a170-226128cdae07" :step/id #uuid "0f8f73fe-f9ae-57fa-a170-226128cdae07" :step/content 17592186404371 :db/ensure [:step/validate]} [:db/retract 17592186284273 :answer-field/choices 17592186282595] {:db/id 17592186124828 :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n\\frac{(x+1)^{2}}{4}-\\frac{(y-4)^{2}}{2}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}:\\text{ }\\frac{(x+1)^{2}}{4}-\\frac{(y-4)^{2}}{2}=1\\}.\n$$\n\nThis is a hyperbola centered at $(-1,4).$" :db/ensure [:question/validate]} {:db/id 17592186284273 :answer-field/choices ["answer-26aa670d-074c-57a3-89ad-75bfb2454f8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-26aa670d-074c-57a3-89ad-75bfb2454f8c" :answer/id #uuid "26aa670d-074c-57a3-89ad-75bfb2454f8c" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}:\\text{ }x\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "activity-cb5f3f6a-8053-5cdb-93d0-81ca9bb6b7a5" :activity/id #uuid "cb5f3f6a-8053-5cdb-93d0-81ca9bb6b7a5" :activity/title "Cylinders" :activity/type :activity.type/review :activity/scope 17592186050123 :activity/course 17592186046658 :activity/steps ["step-a3229b46-2596-5231-bb9f-417ac67e20ce" "step-9f43f7c2-e370-5e85-9544-13567a1b950b" "step-3cb1ceb7-df6f-5451-95be-df0ae5559ae1" "step-6c06bd3b-591b-5258-8fe1-c91c1e438dd0" "step-5dcd298b-68b8-5551-8c6b-dba302988147"] :activity/first-step "step-a3229b46-2596-5231-bb9f