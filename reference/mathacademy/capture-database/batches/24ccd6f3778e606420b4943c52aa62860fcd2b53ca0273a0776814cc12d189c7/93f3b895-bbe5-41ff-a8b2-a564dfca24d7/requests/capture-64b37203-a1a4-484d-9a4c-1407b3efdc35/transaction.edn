5534-b3ff-9d32858ff41c" :answer-field/choices ["answer-0323c57c-4737-5776-a48b-663f00324e5c" "answer-476684d3-fe84-5a11-bdab-1051e8d6a949" "answer-65ac4265-e089-5534-b3ff-9d32858ff41c" "answer-d2de1212-6756-5fad-9478-03f4ae2fc81e" "answer-97dadd18-d342-598d-9140-94f782a72306"] :db/ensure [:answer-field/validate]} {:db/id "answer-0323c57c-4737-5776-a48b-663f00324e5c" :answer/id #uuid "0323c57c-4737-5776-a48b-663f00324e5c" :answer/type :answer.type/image :answer/value "images/6b/6bb4d9bc6dac1c33f20a26d775c8fffaa214da65f042c59a6eb3e1326f2debf7.png" :db/ensure [:answer/validate]} {:db/id "answer-476684d3-fe84-5a11-bdab-1051e8d6a949" :answer/id #uuid "476684d3-fe84-5a11-bdab-1051e8d6a949" :answer/type :answer.type/image :answer/value "images/80/80e8f54a1467c5cb03028d5c540ce0be3af1cc25e1f12228322888eddac692d9.png" :db/ensure [:answer/validate]} {:db/id "answer-65ac4265-e089-5534-b3ff-9d32858ff41c" :answer/id #uuid "65ac4265-e089-5534-b3ff-9d32858ff41c" :answer/type :answer.type/image :answer/value "images/85/850b99f4c14f71ed3c1a3407b8f4930c1b8b90b7586d535c2c77902b93d073a1.png" :db/ensure [:answer/validate]} {:db/id "answer-d2de1212-6756-5fad-9478-03f4ae2fc81e" :answer/id #uuid "d2de1212-6756-5fad-9478-03f4ae2fc81e" :answer/type :answer.type/image :answer/value "images/d3/d3422a4edce57be47e66820a8260ae04ac429676c90ecd830d8445c8f44f2c22.png" :db/ensure [:answer/validate]} {:db/id "answer-97dadd18-d342-598d-9140-94f782a72306" :answer/id #uuid "97dadd18-d342-598d-9140-94f782a72306" :answer/type :answer.type/image :answer/value "images/d7/d7354f0d40e7a17672280657b5ed2c79881f6b64f519dd2327ed83b172f5cd57.png" :db/ensure [:answer/validate]} {:db/id 17592186083674 :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graph IV does not have rotational symmetry of order $2$ about the origin. So, it is **not** an odd function.\n\n- On the other hand, graphs I, II, and III do have rotational symmetry about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that graphs I, II, and III show odd functions.\n\n![](images/22/22c2e88d2e50c722c272e1a10902c58387f0ef00146be4838791c3258badaa5b.png)\n\nTherefore, the correct answer is \"I, II and III only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186080975 :answer-field/correct 17592186080980 :db/ensure [:answer-field/validate]} {:db/id "question-6c5eea4e-4b84-5cc7-8353-9e67cf3ab163" :question/id #uuid "6c5eea4e-4b84-5cc7-8353-9e67cf3ab163" :question/math-academy-id "q-72963" :question/problem "![](images/da/da6aa84a7b37d9b776f88a7e3b6eb4cf70c303c3c0c463abd313c51bfa0781a2.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs I, III, and IV do not have rotational symmetry of order $2$ about the origin. So, they are **not** odd functions.\n\n- On the other hand, graph II does have rotational symmetry about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that graph II shows an odd function.\n\n![](images/34/348ca99660cff1d4db774d39b543aa7cb79cf0a1787f11046e9b8a4d72fd83e7.png)\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1a9643a0-c55b-5494-90b4-8d6f6ec0d7dc"] :db/ensure [:question/validate]} {:db/id "answer-field-1a9643a0-c55b-5494-90b4-8d6f6ec0d7dc" :answer-field/id #uuid "1a9643a0-c55b-5494-90b4-8d6f6ec0d7dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-82059948-380b-59bf-a396-766dbcf6d531" :answer-field/choices ["answer-d4bb60ab-ba68-5f4e-a482-4ba63a56d8d4" "answer-bf92eb2f-009e-5bb3-9f3e-21b46e51c97e" "answer-89b6bbd5-a137-55f7-90db-2bca78c087ca" "answer-3d11e356-54df-59ee-a30e-b36afe7a1b88" "answer-82059948-380b-59bf-a396-766dbcf6d531"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4bb60ab-ba68-5f4e-a482-4ba63a56d8d4" :answer/id #uuid "d4bb60ab-ba68-5f4e-a482-4ba63a56d8d4" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-bf92eb2f-009e-5bb3-9f3e-21b46e51c97e" :answer/id #uuid "bf92eb2f-009e-5bb3-9f3e-21b46e51c97e" :answer/type :answer.type/text :answer/value "I and IV only" :db/ensure [:answer/validate]} {:db/id "answer-89b6bbd5-a137-55f7-90db-2bca78c087ca" :answer/id #uuid "89b6bbd5-a137-55f7-90db-2bca78c087ca" :answer/type :answer.type/text :answer/value "I, II, III, and IV" :db/ensure [:answer/validate]} {:db/id "answer-3d11e356-54df-59ee-a30e-b36afe7a1b88" :answer/id #uuid "3d11e356-54df-59ee-a30e-b36afe7a1b88" :answer/type :answer.type/text :answer/value "II and IV only" :db/ensure [:answer/validate]} {:db/id "answer-82059948-380b-59bf-a396-766dbcf6d531" :answer/id #uuid "82059948-380b-59bf-a396-766dbcf6d531" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "question-49d7ac71-7387-5bcd-8351-170b2eb2bef2" :question/id #uuid "49d7ac71-7387-5bcd-8351-170b2eb2bef2" :question/math-academy-id "q-6695" :question/problem "Is the function $f(x)=3{x}^{3}+x-6$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =3(-x)^{3}+(-x)-6 \\\\  & =-3{x}^{3}-x-6\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(3{x}^{3}+x-6) \\\\  & =-3{x}^{3}-x+6\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x)$, the function is not odd. \n\nTherefore, the function is neither even nor odd." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f8e9e694-aced-5daf-bf38-411472cb712e"] :db/ensure [:question/validate]} {:db/id "answer-field-f8e9e694-aced-5daf-bf38-411472cb712e" :answer-field/id #uuid "f8e9e694-aced-5daf-bf38-411472cb712e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2362db08-1cbb-5e66-a81c-afb2a5cd191b" :answer-field/choices ["answer-dafffe06-6133-5a84-a06a-81c865b54413" "answer-0a05357a-79f8-5623-ae5b-fe675d744c37" "answer-c1d9cb46-fbf1-56d0-b3b8-7026d5f7ef3c" "answer-2362db08-1cbb-5e66-a81c-afb2a5cd191b" "answer-7ee771c2-bd33-567e-a5e8-070cb0549c8d"] :db/ensure [:answer-field/validate]} {:db/id "answer-dafffe06-6133-5a84-a06a-81c865b54413" :answer/id #uuid "dafffe06-6133-5a84-a06a-81c865b54413" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-0a05357a-79f8-5623-ae5b-fe675d744c37" :answer/id #uuid "0a05357a-79f8-5623-ae5b-fe675d744c37" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-c1d9cb46-fbf1-56d0-b3b8-7026d5f7ef3c" :answer/id #uuid "c1d9cb46-fbf1-56d0-b3b8-7026d5f7ef3c" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-2362db08-1cbb-5e66-a81c-afb2a5cd191b" :answer/id #uuid "2362db08-1cbb-5e66-a81c-afb2a5cd191b" :answer/type :answer.type/text :answer/value "Neither even nor odd" :db/ensure [:answer/validate]} {:db/id "answer-7ee771c2-bd33-567e-a5e8-070cb0549c8d" :answer/id #uuid "7ee771c2-bd33-567e-a5e8-070cb0549c8d" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id "question-5272ce70-1353-5fba-a94b-5e92203eee02" :question/id #uuid "5272ce70-1353-5fba-a94b-5e92203eee02" :question/math-academy-id "q-6694" :question/problem "Is the function $f(x)=-2x-5$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =-2(-x)-5 \\\\  & =2x-5\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(-2x-5) \\\\  & =2x+5\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x)$, the function is not odd. \n\nTherefore, the function is neither even nor odd." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c2e66a1c-7b15-548e-aa71-1a2d943218a5"] :db/ensure [:question/validate]} {:db/id "answer-field-c2e66a1c-7b15-548e-aa71-1a2d943218a5" :answer-field/id #uuid "c2e66a1c-7b15-548e-aa71-1a2d943218a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec8e7c5f-4fb1-51ee-b472-bb37d19d9123" :answer-field/choices ["answer-4cc3320c-6e94-54cf-9a84-428614bcfb8b" "answer-59a3c750-83c0-5d30-820f-b7efc0e1c7ac" "answer-6c4aedc1-de2e-563b-bc86-c5f3754b635f" "answer-ec8e7c5f-4fb1-51ee-b472-bb37d19d9123" "answer-fa90b234-64ec-5d9a-af2f-f22c3ff06543"] :db/ensure [:answer-field/validate]} {:db/id "answer-4cc3320c-6e94-54cf-9a84-428614bcfb8b" :answer/id #uuid "4cc3320c-6e94-54cf-9a84-428614bcfb8b" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-59a3c750-83c0-5d30-820f-b7efc0e1c7ac" :answer/id #uuid "59a3c750-83c0-5d30-820f-b7efc0e1c7ac" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-6c4aedc1-de2e-563b-bc86-c5f3754b635f" :answer/id #uuid "6c4aedc1-de2e-563b-bc86-c5f3754b635f" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-ec8e7c5f-4fb1-51ee-b472-bb37d19d9123" :answer/id #uuid "ec8e7c5f-4fb1-51ee-b472-bb37d19d9123" :answer/type :answer.type/text :answer/value "Neither even nor odd" :db/ensure [:answer/validate]} {:db/id "answer-fa90b234-64ec-5d9a-af2f-f22c3ff06543" :answer/id #uuid "fa90b234-64ec-5d9a-af2f-f22c3ff06543" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id "question-5e293714-80a3-5b8a-84fe-6e44867ed437" :question/id #uuid "5e293714-80a3-5b8a-84fe-6e44867ed437" :question/math-academy-id "q-36586" :question/problem "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-123$ | $-71$ | $-29$ | $29$ | $71$ | $123$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $8$ | $a+12$ | $-4$ | $-4$ | $20$ | $b-2$ |" :question/worked-solution "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-71)=f(71),$ we obtain\n\n$$\n\\begin{aligned}f(-71) & =f(71) \\\\ a+12 & =20 \\\\ a & =8.\\end{aligned}\n$$\n\nUsing the fact that $f(-123)=f(123),$ we obtain\n\n$$\n\\begin{aligned}f(-123) & =f(123) \\\\ 8 & =b-2 \\\\ 10 & =b.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=8+10=18.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a568d026-0c3b-531f-bd83-e4f2456ac0a3"] :db/ensure [:question/validate]} {:db/id "answer-field-a568d026-0c3b-531f-bd83-e4f2456ac0a3" :answer-field/id #uuid "a568d026-0c3b-531f-bd83-e4f2456ac0a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9ca8d58-45d6-5f71-a92b-85b4c5c22358" :answer-field/choices ["answer-119f1040-3710-5672-b493-ba5c96708717" "answer-3e9ffd7e-17ec-599c-af2f-95e3c60efaf9" "answer-f9ca8d58-45d6-5f71-a92b-85b4c5c22358" "answer-eb4046c3-ab5d-5ffa-87fb-f9c34cb27f83" "answer-6989fa89-797b-5c6f-a8d2-ac0000cbb978"] :db/ensure [:answer-field/validate]} {:db/id "answer-119f1040-3710-5672-b493-ba5c96708717" :answer/id #uuid "119f1040-3710-5672-b493-ba5c96708717" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-3e9ffd7e-17ec-599c-af2f-95e3c60efaf9" :answer/id #uuid "3e9ffd7e-17ec-599c-af2f-95e3c60efaf9" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-f9ca8d58-45d6-5f71-a92b-85b4c5c22358" :answer/id #uuid "f9ca8d58-45d6-5f71-a92b-85b4c5c22358" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-eb4046c3-ab5d-5ffa-87fb-f9c34cb27f83" :answer/id #uuid "eb4046c3-ab5d-5ffa-87fb-f9c34cb27f83" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-6989fa89-797b-5c6f-a8d2-ac0000cbb978" :answer/id #uuid "6989fa89-797b-5c6f-a8d2-ac0000cbb978" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-7d2fbf06-bec2-5ef7-8e27-5ab81fcb62b5" :question/id #uuid "7d2fbf06-bec2-5ef7-8e27-5ab81fcb62b5" :question/math-academy-id "q-5891" :question/problem "The table below defines the function $f(x).$ Is the function even, odd, or neither?\n\n| **$x$** | $-99$ | $-52$ | $-8$ | $8$ | $52$ | $99$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $150$ | $70$ | $0$ | $-11$ | $-92$ | $-180$ |" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$ in the domain of $f$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$ in the domain of $f$\n\nFirst, we have\n\n$$\nf(-99)=150\\ne f(99).\n$$\n\nThis means that $f(-x)\\ne f(x)$ at least for some values of $x$ in the domain of the function. So, the function is not even.\n\nNext, we have\n\n$$\nf(-99)=150\\ne -f(99).\n$$\n\nThis means that $f(-x)\\ne -f(x)$ at least for some values of $x$ in the domain of the function. So, the function is not odd.\n\nHence, the function is neither even nor odd." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3725c026-4151-56dc-ac44-063c90fed33e"] :db/ensure [:question/validate]} {:db/id "answer-field-3725c026-4151-56dc-ac44-063c90fed33e" :answer-field/id #uuid "3725c026-4151-56dc-ac44-063c90fed33e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18d309e6-06f8-5d84-b32a-1c804a507684" :answer-field/choices ["answer-32480297-6081-525d-b10e-f53e130d2a40" "answer-3cac6090-a432-588e-af02-30c09efe0e52" "answer-e3033bcd-b5f6-55c5-8c7c-4ea71cd81aee" "answer-18d309e6-06f8-5d84-b32a-1c804a507684" "answer-d9ea1fbe-8d98-574a-b9c8-5c7b1c5ecf66"] :db/ensure [:answer-field/validate]} {:db/id "answer-32480297-6081-525d-b10e-f53e130d2a40" :answer/id #uuid "32480297-6081-525d-b10e-f53e130d2a40" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-3cac6090-a432-588e-af02-30c09efe0e52" :answer/id #uuid "3cac6090-a432-588e-af02-30c09efe0e52" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-e3033bcd-b5f6-55c5-8c7c-4ea71cd81aee" :answer/id #uuid "e3033bcd-b5f6-55c5-8c7c-4ea71cd81aee" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-18d309e6-06f8-5d84-b32a-1c804a507684" :answer/id #uuid "18d309e6-06f8-5d84-b32a-1c804a507684" :answer/type :answer.type/text :answer/value "Neither even nor odd" :db/ensure [:answer/validate]} {:db/id "answer-d9ea1fbe-8d98-574a-b9c8-5c7b1c5ecf66" :answer/id #uuid "d9ea1fbe-8d98-574a-b9c8-5c7b1c5ecf66" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id 17592186084422 :tutorial/content "A function is said to be an **even function** if it is symmetric about the $y$-axis.\n\nFor example, the function \n\n$$\nf(x) = x^2,\n$$\n\nwhose graph is depicted below, is an example of an even function. It is symmetric about the $y$-axis, meaning that if we reflect the graph over the $y$-axis, we get the same picture.\n\n![](images/cf/cfca345c7ca094cacdbc6d7141a09e34fd116c677629a6a4c1917fb0db1f753f.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186084430 :tutorial/content "A function is said to be an **odd function** if it has **rotational symmetry of order $2$ about the origin**. That is to say, if we rotate the graph of an odd function by $180^\\circ$ about the origin, we end up with the same picture.\n\nFor example, the function\n\n$$\ng(x)=x,\n$$\n\nwhose graph is shown below, is an example of an odd function. It has rotational symmetry of order $2$ about the origin, meaning that if we rotate the graph of an odd function by $180^\\circ$ about the origin, we end up with the same picture.\n\n![](images/ff/ff49c826d9a6a36b35edf73689d30e5d9dadc976b5f1caf47c1dd0383f9893bc.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186084423 :tutorial/content "Recall that the graph of the even function $f(x) = x^2$ is symmetric about the $y$-axis.\n\n![](images/07/07d0699c46b3cbd215c461d5df3629d86cd31a93228d6790fdc65b383e8556fc.png)\n\nNotice the following:\n\n$$\n\\begin{aligned}f(-1) & =1=f(1) \\\\ f(-2) & =4=f(2) \\\\ f(-3) & =9=f(3) \\\\  & \\,\\,\\,⋮\\end{aligned}\n$$\n\nSo, for every $x$ in the domain, both $x$ and $-x$ give the same value of the function. Algebraically, this fact can be written as follows: $f(-x) = f(x).$\n\nIn general, a function $f(x)$ is said to be **even** if\n\n$$\nf(-x) = f(x)\n$$\n\n \nfor each $x$ in the domain of the function." :db/ensure [:tutorial/validate]} {:db/id 17592186084431 :tutorial/content "Now, recall that the graph of the odd function $g(x)=x$ has rotational symmetry of order $2$ about the origin.\n\n![](images/a0/a0dd6a5cbc09182a4a87569879a97da697a21eeda869ae20f512dc86a911b75e.png)\n\nNotice the following:\n\n$$\n\\begin{aligned}f(-1) & =-1=-f(1) \\\\ f(-2) & =-2=-f(2) \\\\ f(-3) & =-3=-f(3) \\\\  & \\,\\,\\,\\,\\,⋮\\end{aligned}\n$$\n\nSo, for every $x$ in the domain, $x$ and $-x$ give opposite values of the function. Algebraically, this fact can be written as $f(-x) = -f(x).$\n\nIn general, a function $f(x)$ is said to be **odd** if\n\n$$\nf(-x) = -f(x)\n$$\n\n \nfor each $x$ in the domain of the function." :db/ensure [:tutorial/validate]} {:db/id 17592186083420 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}]
