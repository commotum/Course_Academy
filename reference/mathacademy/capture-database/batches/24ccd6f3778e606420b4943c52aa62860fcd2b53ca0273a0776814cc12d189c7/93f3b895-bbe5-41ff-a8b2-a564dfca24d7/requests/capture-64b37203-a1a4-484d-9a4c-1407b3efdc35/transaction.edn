b5499f2fcdb0" :answer/id #uuid "71fcfb39-e768-5606-8e04-b5499f2fcdb0" :answer/type :answer.type/math :answer/value "z=0,\\,2,\\,5" :db/ensure [:answer/validate]} {:db/id "question-03998afe-a211-5305-952a-0c2809482e65" :question/id #uuid "03998afe-a211-5305-952a-0c2809482e65" :question/math-academy-id "q-37508" :question/problem "Given that $3{x}^{3}-{x}^{2}+5x-2=-2+5x,$ solve for $x.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(x)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}3{x}^{3}-{x}^{2}+5x-2 & =-2+5x \\\\ 3{x}^{3}-{x}^{2}-2 & =-2 \\\\ 3{x}^{3}-{x}^{2} & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of ${x}^{2}.$ We can factor out the ${x}^{2}$ as follows:\n\n$$\n\\begin{aligned}3{x}^{3}-{x}^{2} & =0 \\\\ {x}^{2}(3x-1) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $x=0,$ and $x=\\frac{1}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b89e364b-ecda-5fd4-ae85-cfd04143e7fb"] :db/ensure [:question/validate]} {:db/id "answer-field-b89e364b-ecda-5fd4-ae85-cfd04143e7fb" :answer-field/id #uuid "b89e364b-ecda-5fd4-ae85-cfd04143e7fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-06de5749-b455-5d51-a834-7a5a60a5c394" :answer-field/choices ["answer-6d849e69-b2cb-5e38-b9e0-5304fb226350" "answer-25b4e5cf-e327-5998-a699-990bf5442f40" "answer-8c6c844d-6639-58d1-aaca-f209d33288c4" "answer-06de5749-b455-5d51-a834-7a5a60a5c394" "answer-c21182e6-9ae1-58c8-909d-8898966210f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d849e69-b2cb-5e38-b9e0-5304fb226350" :answer/id #uuid "6d849e69-b2cb-5e38-b9e0-5304fb226350" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{3},\\,0" :db/ensure [:answer/validate]} {:db/id "answer-25b4e5cf-e327-5998-a699-990bf5442f40" :answer/id #uuid "25b4e5cf-e327-5998-a699-990bf5442f40" :answer/type :answer.type/math :answer/value "x=0,\\,1,\\,3" :db/ensure [:answer/validate]} {:db/id "answer-8c6c844d-6639-58d1-aaca-f209d33288c4" :answer/id #uuid "8c6c844d-6639-58d1-aaca-f209d33288c4" :answer/type :answer.type/math :answer/value "x=0,\\,3" :db/ensure [:answer/validate]} {:db/id "answer-06de5749-b455-5d51-a834-7a5a60a5c394" :answer/id #uuid "06de5749-b455-5d51-a834-7a5a60a5c394" :answer/type :answer.type/math :answer/value "x=0,\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c21182e6-9ae1-58c8-909d-8898966210f1" :answer/id #uuid "c21182e6-9ae1-58c8-909d-8898966210f1" :answer/type :answer.type/math :answer/value "x=0,\\,\\frac{1}{3},\\,1" :db/ensure [:answer/validate]} {:db/id "question-cab62649-3f2e-56ae-bfd6-8c34dbebf0bf" :question/id #uuid "cab62649-3f2e-56ae-bfd6-8c34dbebf0bf" :question/math-academy-id "q-14003" :question/problem "Determine the real roots of the cubic equation $5{x}^{3}-10{x}^{2}-60x=15x.$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(x)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}5{x}^{3}-10{x}^{2}-60x & =15x \\\\ 5{x}^{3}-10{x}^{2}-75x & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $5x.$ We can factor out the $5x$ as follows:\n\n$$\n\\begin{aligned}5{x}^{3}-10{x}^{2}-75x & =0 \\\\ 5x({x}^{2}-2x-15) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${x}^{2}-2x-15$ as follows:\n\n$$\n\\begin{aligned}5x({x}^{2}-2x-15) & =0 \\\\ 5x(x-5)(x+3) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $x=0,$ $x=5,$ and $x=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4322e79d-0dfe-5ff3-9b18-a1b194bc6303"] :db/ensure [:question/validate]} {:db/id "answer-field-4322e79d-0dfe-5ff3-9b18-a1b194bc6303" :answer-field/id #uuid "4322e79d-0dfe-5ff3-9b18-a1b194bc6303" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27f5ca19-9d55-5167-a601-9f2a6086c603" :answer-field/choices ["answer-27f5ca19-9d55-5167-a601-9f2a6086c603" "answer-1f80dfb9-541b-55e8-81da-14104f07229d" "answer-f87fa8e3-453c-5365-aea7-69932c47abbf" "answer-b7c5b4ec-cabd-5b90-ab1f-de3eec2583d5" "answer-e5c56a1e-ba9a-5500-8680-64089151f845"] :db/ensure [:answer-field/validate]} {:db/id "answer-27f5ca19-9d55-5167-a601-9f2a6086c603" :answer/id #uuid "27f5ca19-9d55-5167-a601-9f2a6086c603" :answer/type :answer.type/math :answer/value "-3,\\,0,\\,5" :db/ensure [:answer/validate]} {:db/id "answer-1f80dfb9-541b-55e8-81da-14104f07229d" :answer/id #uuid "1f80dfb9-541b-55e8-81da-14104f07229d" :answer/type :answer.type/math :answer/value "-3,\\,0,\\,\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-f87fa8e3-453c-5365-aea7-69932c47abbf" :answer/id #uuid "f87fa8e3-453c-5365-aea7-69932c47abbf" :answer/type :answer.type/math :answer/value "-5,\\,-3,\\,0" :db/ensure [:answer/validate]} {:db/id "answer-b7c5b4ec-cabd-5b90-ab1f-de3eec2583d5" :answer/id #uuid "b7c5b4ec-cabd-5b90-ab1f-de3eec2583d5" :answer/type :answer.type/math :answer/value "0,\\,2,\\,3" :db/ensure [:answer/validate]} {:db/id "answer-e5c56a1e-ba9a-5500-8680-64089151f845" :answer/id #uuid "e5c56a1e-ba9a-5500-8680-64089151f845" :answer/type :answer.type/math :answer/value "0,\\,\\frac{1}{2},\\,3" :db/ensure [:answer/validate]} {:db/id 17592186233206 :question/answer-fields ["answer-field-6fc218c0-a6e7-579b-9f59-e8cf1468b1dd"] :db/ensure [:question/validate]} {:db/id "answer-field-6fc218c0-a6e7-579b-9f59-e8cf1468b1dd" :answer-field/id #uuid "6fc218c0-a6e7-579b-9f59-e8cf1468b1dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-633d096c-481c-5248-9e01-fc39d2d4712e" :answer-field/choices ["answer-633d096c-481c-5248-9e01-fc39d2d4712e" "answer-cf099b48-e2bc-525b-a7ab-8066fb4fd548" "answer-7e7278ba-dfe5-53ee-afa7-d9c5ccd9f600" "answer-8efa7ab7-11ca-525d-8d96-6e3c532fe9a3" "answer-a4bee12f-94bc-5cee-a6ff-4318e21631ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-633d096c-481c-5248-9e01-fc39d2d4712e" :answer/id #uuid "633d096c-481c-5248-9e01-fc39d2d4712e" :answer/type :answer.type/math :answer/value "h=-\\frac{1}{2},0,\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-cf099b48-e2bc-525b-a7ab-8066fb4fd548" :answer/id #uuid "cf099b48-e2bc-525b-a7ab-8066fb4fd548" :answer/type :answer.type/math :answer/value "h=-\\frac{3}{2},0,\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7e7278ba-dfe5-53ee-afa7-d9c5ccd9f600" :answer/id #uuid "7e7278ba-dfe5-53ee-afa7-d9c5ccd9f600" :answer/type :answer.type/math :answer/value "h=-\\frac{5}{2},-1,0" :db/ensure [:answer/validate]} {:db/id "answer-8efa7ab7-11ca-525d-8d96-6e3c532fe9a3" :answer/id #uuid "8efa7ab7-11ca-525d-8d96-6e3c532fe9a3" :answer/type :answer.type/math :answer/value "h=-\\frac{5}{2},0,\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-a4bee12f-94bc-5cee-a6ff-4318e21631ca" :answer/id #uuid "a4bee12f-94bc-5cee-a6ff-4318e21631ca" :answer/type :answer.type/math :answer/value "h=0,\\frac{1}{2},1" :db/ensure [:answer/validate]} {:db/id 17592186162124 :knowledge-point/questions ["question-9adae9aa-2d5a-51d9-80a6-fbe056bdc031" "question-097fc2ae-2fef-58ac-bba4-f69c8c04dea2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162130 :knowledge-point/questions ["question-741ee6eb-9658-524e-8fcb-9b428519f04d" "question-a2622f87-4a36-506a-86f1-c353a2d6ebaa" "question-eeeede00-ac86-5992-a122-f787740a8bf0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162125 :knowledge-point/questions ["question-45f60a39-7c3b-515c-9608-b1c0fb2b6cd7" "question-560539a1-a567-51bf-978e-83db525442bc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162131 :knowledge-point/questions ["question-f4402cb5-3b8b-556e-9fb0-20470cdb8422"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9adae9aa-2d5a-51d9-80a6-fbe056bdc031" :question/id #uuid "9adae9aa-2d5a-51d9-80a6-fbe056bdc031" :question/math-academy-id "q-146394" :question/problem "Let $X$ and $Y$ be discrete random variables with the joint probability mass function $f(x,y)$ shown below.\n\n| $f$ | $Y=-1$ | $Y=0$ | $Y=1$ | $Y=3$ |\n| --- | --- | --- | --- | --- |\n| $X=-1$ | $0.15$ | $0.25$ | $0.05$ | $0.15$ |\n| $X=1$ | $0.15$ | $0.1$ | $0.05$ | $0.1$ |\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(0,\\frac{3}{2}).$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nBy definition, we have\n\n$$\n\\begin{aligned}F(0,\\frac{3}{2}) & =P(X\\le 0,Y\\le \\frac{3}{2}).\\end{aligned}\n$$\n\nWe start by highlighting all cells in the table that correspond to $X\\le 0,Y\\le \\frac{3}{2}.$\n\n| $f$ | $Y=-1$ | $Y=0$ | $Y=1$ | $Y=3$ |\n| --- | --- | --- | --- | --- |\n| $X=-1$ | $0.15$ | $0.25$ | $0.05$ | $0.15$ |\n| $X=1$ | $0.15$ | $0.1$ | $0.05$ | $0.1$ |\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}F(0,\\frac{3}{2}) & ={\\sum }_{x\\le 0}{\\sum }_{y\\le 3/2}f(x,y) \\\\  & =f(-1,-1)+f(-1,0)+f(-1,1) \\\\  & =0.15+0.25+0.05 \\\\  & =0.45.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5c4d7f13-80f9-5cf8-8777-77cdf1cbaa54"] :db/ensure [:question/validate]} {:db/id "answer-field-5c4d7f13-80f9-5cf8-8777-77cdf1cbaa54" :answer-field/id #uuid "5c4d7f13-80f9-5cf8-8777-77cdf1cbaa54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c11f045a-855b-58ea-9cc2-fe6f72264ce9" :answer-field/choices ["answer-bb134a2b-094e-5864-a589-8e05c37b430c" "answer-3ae4d64b-01dc-56eb-9afe-2fc8eba19d41" "answer-e0e63b2b-06b8-588f-bae2-b8c4173b063c" "answer-c11f045a-855b-58ea-9cc2-fe6f72264ce9" "answer-07cfc785-fa96-5e22-b467-263332177c0f"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb134a2b-094e-5864-a589-8e05c37b430c" :answer/id #uuid "bb134a2b-094e-5864-a589-8e05c37b430c" :answer/type :answer.type/math :answer/value "0.2" :db/ensure [:answer/validate]} {:db/id "answer-3ae4d64b-01dc-56eb-9afe-2fc8eba19d41" :answer/id #uuid "3ae4d64b-01dc-56eb-9afe-2fc8eba19d41" :answer/type :answer.type/math :answer/value "0.3" :db/ensure [:answer/validate]} {:db/id "answer-e0e63b2b-06b8-588f-bae2-b8c4173b063c" :answer/id #uuid "e0e63b2b-06b8-588f-bae2-b8c4173b063c" :answer/type :answer.type/math :answer/value "0.4" :db/ensure [:answer/validate]} {:db/id "answer-c11f045a-855b-58ea-9cc2-fe6f72264ce9" :answer/id #uuid "c11f045a-855b-58ea-9cc2-fe6f72264ce9" :answer/type :answer.type/math :answer/value "0.45" :db/ensure [:answer/validate]} {:db/id "answer-07cfc785-fa96-5e22-b467-263332177c0f" :answer/id #uuid "07cfc785-fa96-5e22-b467-263332177c0f" :answer/type :answer.type/math :answer/value "0.65" :db/ensure [:answer/validate]} {:db/id "question-097fc2ae-2fef-58ac-bba4-f69c8c04dea2" :question/id #uuid "097fc2ae-2fef-58ac-bba4-f69c8c04dea2" :question/math-academy-id "q-146341" :question/problem "Let $X$ and $Y$ be discrete random variables with the joint probability mass function $f(x,y)$ shown below.\n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ | $Y=4$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.2$ | $0.2$ | $0.1$ |\n| $X=2$ | $0.15$ | $0.1$ | $0.1$ | $0.05$ |\n\nIf $F(x,y)$ is the joint CDF of $X$ and $Y,$ find $F(2,3).$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nBy definition, we have\n\n$$\n\\begin{aligned}F(2,3) & =P(X\\le 2,Y\\le 3).\\end{aligned}\n$$\n\nWe start by highlighting all cells in the table that correspond to $X\\le 2,Y\\le 3.$\n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ | $Y=4$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.2$ | $0.2$ | $0.1$ |\n| $X=2$ | $0.15$ | $0.1$ | $0.1$ | $0.05$ |\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}F(2,3) & ={\\sum }_{x\\le 2}{\\sum }_{y\\le 3}f(x,y) \\\\  & =f(1,1)+f(1,2)+f(1,3)+f(2,1)+f(2,2)+f(2,3) \\\\  & =0.1+0.2+0.2+0.15+0.1+0.1 \\\\  & =0.85.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-70912616-2902-589e-b985-cc6b891d3822"] :db/ensure [:question/validate]} {:db/id "answer-field-70912616-2902-589e-b985-cc6b891d3822" :answer-field/id #uuid "70912616-2902-589e-b985-cc6b891d3822" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-68316cdc-7e2e-5c8c-b2c0-9fdb5db4e265" :answer-field/choices ["answer-8beedfa2-a23b-56ef-9e81-c3c00d1c853c" "answer-b1ff47ca-4ea7-5a98-9758-b8c161eaa30e" "answer-1d9c2a22-1745-5f11-90c5-b61178746ef7" "answer-badb182a-b77f-549d-99b6-8f6630a12a38" "answer-68316cdc-7e2e-5c8c-b2c0-9fdb5db4e265"] :db/ensure [:answer-field/validate]} {:db/id "answer-8beedfa2-a23b-56ef-9e81-c3c00d1c853c" :answer/id #uuid "8beedfa2-a23b-56ef-9e81-c3c00d1c853c" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "answer-b1ff47ca-4ea7-5a98-9758-b8c161eaa30e" :answer/id #uuid "b1ff47ca-4ea7-5a98-9758-b8c161eaa30e" :answer/type :answer.type/math :answer/value "0.55" :db/ensure [:answer/validate]} {:db/id "answer-1d9c2a22-1745-5f11-90c5-b61178746ef7" :answer/id #uuid "1d9c2a22-1745-5f11-90c5-b61178746ef7" :answer/type :answer.type/math :answer/value "0.65" :db/ensure [:answer/validate]} {:db/id "answer-badb182a-b77f-549d-99b6-8f6630a12a38" :answer/id #uuid "badb182a-b77f-549d-99b6-8f6630a12a38" :answer/type :answer.type/math :answer/value "0.8" :db/ensure [:answer/validate]} {:db/id "answer-68316cdc-7e2e-5c8c-b2c0-9fdb5db4e265" :answer/id #uuid "68316cdc-7e2e-5c8c-b2c0-9fdb5db4e265" :answer/type :answer.type/math :answer/value "0.85" :db/ensure [:answer/validate]} {:db/id "question-741ee6eb-9658-524e-8fcb-9b428519f04d" :question/id #uuid "741ee6eb-9658-524e-8fcb-9b428519f04d" :question/math-academy-id "q-146408" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{0,2,4,6\\},\\,{S}_{Y}=\\{0,1,3\\}.\n$$\n\nFind an expression for the corresponding joint CDF when $x>6,y>3.$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nNote the following:\n\n- We can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{0,2,4,6\\}\\times \\{0,1,3\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support. Let's also consider a point $(x,y)$ where $x>6$ and $y>3,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/63/6340ca35646830558631c7fe523698a201c5acf26d1360910ab207c30f92e41f.png)\n\nSince every value in the support of $X$ is at most $6$ and $x>6,$ every possible value of $X$ satisfies $X\\le x.$ Similarly, every value in the support of $Y$ is at most $3$ and $y>3,$ so every possible value of $Y$ satisfies $Y\\le y.$\n\nTherefore, the region $Δ$ contains the entire joint support, and\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-be61e717-c5ed-51d0-853e-521eeca3a460"] :db/ensure [:question/validate]} {:db/id "answer-field-be61e717-c5ed-51d0-853e-521eeca3a460" :answer-field/id #uuid "be61e717-c5ed-51d0-853e-521eeca3a460" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8b9fe426-9283-5444-8aef-eed1d7f5ef25" :answer-field/choices ["answer-0ba4c4de-57ee-5011-8a90-f13d0828a75d" "answer-8b9fe426-9283-5444-8aef-eed1d7f5ef25" "answer-1adee21a-d35b-5748-b6a5-c4ca64b76fd0" "answer-d8f67f35-fb6d-5689-a266-7081cbdaa5cf" "answer-7caa5188-b509-5b3c-83ea-c26692b3a05e"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ba4c4de-57ee-5011-8a90-f13d0828a75d" :answer/id #uuid "0ba4c4de-57ee-5011-8a90-f13d0828a75d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-8b9fe426-9283-5444-8aef-eed1d7f5ef25" :answer/id #uuid "8b9fe426-9283-5444-8aef-eed1d7f5ef25" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-1adee21a-d35b-5748-b6a5-c4ca64b76fd0" :answer/id #uuid "1adee21a-d35b-5748-b6a5-c4ca64b76fd0" :answer/type :answer.type/math :answer/value "\\frac{3}{y}" :db/ensure [:answer/validate]} {:db/id "answer-d8f67f35-fb6d-5689-a266-7081cbdaa5cf" :answer/id #uuid "d8f67f35-fb6d-5689-a266-7081cbdaa5cf" :answer/type :answer.type/math :answer/value "\\frac{6}{x}" :db/ensure [:answer/validate]} {:db/id "answer-7caa5188-b509-5b3c-83ea-c26692b3a05e" :answer/id #uuid "7caa5188-b509-5b3c-83ea-c26692b3a05e" :answer/type :answer.type/math :answer/value "\\frac{6}{x}+\\frac{3}{y}" :db/ensure [:answer/validate]} {:db/id "question-a2622f87-4a36-506a-86f1-c353a2d6ebaa" :question/id #uuid "a2622f87-4a36-506a-86f1-c353a2d6ebaa" :question/math-academy-id "q-146411" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{-2,-1,0,1,2\\},\\,{S}_{Y}=\\{1,2,3\\}.\n$$\n\nFind an expression for the corresponding joint CDF when $x<2,y<1.$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nNote the following:\n\n- We can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{-2,-1,0,1,2\\}\\times \\{1,2,3\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support. Let's also consider a point $(x,y)$ where $x<2$ and $y<1,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/39/3911ef3923eabce680eb406a93c02aaacd2b91f829294eb7ac0e26a11753a703.png)\n\nSince every value in the support of $Y$ is at least $1$ and $y<1,$ no possible value of $Y$ satisfies $Y\\le y.$ Therefore, there are no points in the joint support that lie in the region $Δ.$\n\nHence,\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-097d13ff-5df9-5ee0-b1ab-13f5ea785b7f"] :db/ensure [:question/validate]} {:db/id "answer-field-097d13ff-5df9-5ee0-b1ab-13f5ea785b7f" :answer-field/id #uuid "097d13ff-5df9-5ee0-b1ab-13f5ea785b7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e5dace1-05de-551d-aaba-34d7c9148ba5" :answer-field/choices ["answer-2e5dace1-05de-551d-aaba-34d7c9148ba5" "answer-12429b67-5b86-5c17-8419-77c0ae4af158" "answer-938876b8-e60e-5abf-9a3b-15a2bc68a965" "answer-04dfb568-d3f2-577e-a17b-4e8945397f61" "answer-ff7d0599-e6ed-56d0-8e96-9f13414d8a7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e5dace1-05de-551d-aaba-34d7c9148ba5" :answer/id #uuid "2e5dace1-05de-551d-aaba-34d7c9148ba5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-12429b67-5b86-5c17-8419-77c0ae4af158" :answer/id #uuid "12429b67-5b86-5c17-8419-77c0ae4af158" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-938876b8-e60e-5abf-9a3b-15a2bc68a965" :answer/id #uuid "938876b8-e60e-5abf-9a3b-15a2bc68a965" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-04dfb568-d3f2-577e-a17b-4e8945397f61" :answer/id #uuid "04dfb568-d3f2-577e-a17b-4e8945397f61" :answer/type :answer.type/math :answer/value "\\frac{xy}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ff7d0599-e6ed-56d0-8e96-9f13414d8a7d" :answer/id #uuid "ff7d0599-e6ed-56d0-8e96-9f13414d8a7d" :answer/type :answer.type/math :answer/value "\\frac{x}{2}" :db/ensure [:answer/validate]} {:db/id "question-eeeede00-ac86-5992-a122-f787740a8bf0" :question/id #uuid "eeeede00-ac86-5992-a122-f787740a8bf0" :question/math-academy-id "q-146410" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{1,2,3\\},\\,{S}_{Y}=\\{1,2,4\\}.\n$$\n\nFind an expression for the corresponding joint CDF when $x<1,y<0.$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nNote the following:\n\n- We can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{1,2,3\\}\\times \\{1,2,4\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support. Let's also consider a point $(x,y)$ where $x<1$ and $y<0,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/8e/8edc6bb45750996ba8d84bf946eaf4de6c68c0f3074ab7af4bee2b68c48c2095.png)\n\nSince every value in the support of $X$ is at least $1$ and $x<1,$ no possible value of $X$ satisfies $X\\le x.$ Also, every value in the support of $Y$ is at least $1$ and $y<0,$ so no possible value of $Y$ satisfies $Y\\le y.$\n\nTherefore, there are no points in the joint support that lie in the region $Δ,$ and\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4e7579f7-2103-5fa8-ada7-6548a869f04f"] :db/ensure [:question/validate]} {:db/id "answer-field-4e7579f7-2103-5fa8-ada7-6548a869f04f" :answer-field/id #uuid "4e7579f7-2103-5fa8-ada7-6548a869f04f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-63931c2b-dbd9-5238-a4ce-8afa3c114b03" :answer-field/choices ["answer-63931c2b-dbd9-5238-a4ce-8afa3c114b03" "answer-f6e9e824-a58d-54cf-960f-f2456327a5d8" "answer-6348da3e-92c0-531f-880b-2b60144620aa" "answer-9d6c637a-7279-5005-b641-b00576d1fb47" "answer-d59dea64-e112-532f-be9e-3afb325fc308"] :db/ensure [:answer-field/validate]} {:db/id "answer-63931c2b-dbd9-5238-a4ce-8afa3c114b03" :answer/id #uuid "63931c2b-dbd9-5238-a4ce-8afa3c114b03" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f6e9e824-a58d-54cf-960f-f2456327a5d8" :answer/id #uuid "f6e9e824-a58d-54cf-960f-f2456327a5d8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-6348da3e-92c0-531f-880b-2b60144620aa" :answer/id #uuid "6348da3e-92c0-531f-880b-2b60144620aa" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9d6c637a-7279-5005-b641-b00576d1fb47" :answer/id #uuid "9d6c637a-7279-5005-b641-b00576d1fb47" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-d59dea64-e112-532f-be9e-3afb325fc308" :answer/id #uuid "d59dea64-e112-532f-be9e-3afb325fc308" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-45f60a39-7c3b-515c-9608-b1c0fb2b6cd7" :question/id #uuid "45f60a39-7c3b-515c-9608-b1c0fb2b6cd7" :question/math-academy-id "q-146466" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(12,6)=0.81,\\,F(12,4)=0.3,\\,F(6,6)=0.17,\\,F(6,4)=0.1,\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{3,6,9,12,15\\},\\,{S}_{Y}=\\{2,4,6,8,10\\}.\n$$\n\nFind $P(6<X\\le 12,4<Y\\le 6).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{3,6,9,12,15\\}\\times \\{2,4,6,8,10\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support.\n\n![](images/71/715408bbd41d8551b8eadce9df6259f763ec34a702d48f4d116c4164ae5fda50.png)\n\nLet's sketch the region corresponding to the probability we wish to find.\n\n![](images/5c/5c50878b85d26a87d6220a99f6fbe896925a6802801117239a5ba56dcba46906.png)\n\nGeometrically, this region can be obtained as follows:\n\n1\\. Take the infinite rectangle that has its top-right corner at $(12,6).$\n\n2\\. Subtract the infinite rectangles that have their top-right corners at $(12,4)$ and $(6,6).$\n\n3\\. Finally, we need to add back the infinite rectangle that has its top-right corner at $(6,4).$ This is because we subtracted this region twice in step 2.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(6<X\\le 12,4<Y\\le 6) & =\\overset{\\text{top-right corner at }(12,6)}{\\overset{⏞}{P(X\\le 12,Y\\le 6)}} \\\\  & \\,-\\overset{\\text{top-right corner at }(12,4)}{\\overset{⏞}{P(X\\le 12,Y\\le 4)}}-\\overset{\\text{top-right corner at }(6,6)}{\\overset{⏞}{P(X\\le 6,Y\\le 6)}} \\\\  & \\,+\\overset{\\text{top-right corner at }(6,4)}{\\overset{⏞}{P(X\\le 6,Y\\le 4)}} \\\\  & =F(12,6)-F(12,4)-F(6,6)+F(6,4) \\\\  & =0.81-0.3-0.17+0.1 \\\\  & =0.44.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ae6858ed-d55f-5582-9a7a-b52918f5e984"] :db/ensure [:question/validate]} {:db/id "answer-field-ae6858ed-d55f-5582-9a7a-b52918f5e984" :answer-field/id #uuid "ae6858ed-d55f-5582-9a7a-b52918f5e984" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69f4e30b-18e4-5e25-a6a3-ffb549051e5b" :answer-field/choices ["answer-9a174190-9537-5d36-b34c-3e8b4bfbf746" "answer-69f4e30b-18e4-5e25-a6a3-ffb549051e5b" "answer-59bd9871-2a7f-5de2-add3-53cd919ee2ba" "answer-cf275f78-c17a-5602-b369-6cab88bf4a23" "answer-29f55ae2-05c7-5d26-bce8-25fa4117146b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a174190-9537-5d36-b34c-3e8b4bfbf746" :answer/id #uuid "9a174190-9537-5d36-b34c-3e8b4bfbf746" :answer/type :answer.type/math :answer/value "0.33" :db/ensure [:answer/validate]} {:db/id "answer-69f4e30b-18e4-5e25-a6a3-ffb549051e5b" :answer/id #uuid "69f4e30b-18e4-5e25-a6a3-ffb549051e5b" :answer/type :answer.type/math :answer/value "0.44" :db/ensure [:answer/validate]} {:db/id "answer-59bd9871-2a7f-5de2-add3-53cd919ee2ba" :answer/id #uuid "59bd9871-2a7f-5de2-add3-53cd919ee2ba" :answer/type :answer.type/math :answer/value "0.47" :db/ensure [:answer/validate]} {:db/id "answer-cf275f78-c17a-5602-b369-6cab88bf4a23" :answer/id #uuid "cf275f78-c17a-5602-b369-6cab88bf4a23" :answer/type :answer.type/math :answer/value "0.57" :db/ensure [:answer/validate]} {:db/id "answer-29f55ae2-05c7-5d26-bce8-25fa4117146b" :answer/id #uuid "29f55ae2-05c7-5d26-bce8-25fa4117146b" :answer/type :answer.type/math :answer/value "0.65" :db/ensure [:answer/validate]} {:db/id "question-560539a1-a567-51bf-978e-83db525442bc" :question/id #uuid "560539a1-a567-51bf-978e-83db525442bc" :question/math-academy-id "q-146465" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(7,10)=0.82,\\,F(7,4)=0.11,\\,F(7,2)=0.05,\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{1,3,5,7,9\\},\\,{S}_{Y}=\\{2,4,6,8,10\\}.\n$$\n\nFind $P(X\\le 7,4<Y\\le 10).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{1,3,5,7,9\\}\\times \\{2,4,6,8,10\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support.\n\n![](images/9e/9e7509e29912cc54dde9a86786f1d171a49b89e7b5f7305ef025582b3402350a.png)\n\nLet's sketch the region corresponding to the probability we wish to find.\n\n![](images/78/78a130ca07be1acecc4655a557abb8d3d037da28f143d0696272d12898b6b4cd.png)\n\nGeometrically, this region can be obtained by taking all points in the infinite rectangle that has its top-right corner at $(7,10)$ (the blue region below) and *subtracting* all points in the infinite rectangle that has its top-right corner at $(7,4)$ (the red region below).\n\n![](images/e4/e4ff1e7cd8259fa9bcaae75210a7a3f2aeeb547ceba46b2fb411f94133372fa2.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 7,4<Y\\le 10) & =\\overset{\\text{top-right corner at }(7,10)}{\\overset{⏞}{P(X\\le 7,Y\\le 10)}}-\\overset{\\text{top-right corner at }(7,4)}{\\overset{⏞}{P(X\\le 7,Y\\le 4)}} \\\\  & =F(7,10)-F(7,4) \\\\  & =0.82-0.11 \\\\  & =0.71.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c166ee4f-8c2c-5d38-86bd-25689b657099"] :db/ensure [:question/validate]} {:db/id "answer-field-c166ee4f-8c2c-5d38-86bd-25689b657099" :answer-field/id #uuid "c166ee4f-8c2c-5d38-86bd-25689b657099" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6927d54-2b7a-5c52-8184-31a3aca05b2b" :answer-field/choices ["answer-61dee0eb-c24f-5acc-a6e4-f4e98039266c" "answer-c0ac7114-c25b-54aa-aacf-9719ad9abce0" "answer-f6927d54-2b7a-5c52-8184-31a3aca05b2b" "answer-73c08698-8973-5494-8eba-3b3587f55fea" "answer-a879fe9e-77cc-5a8d-9077-2ef67ab9a250"] :db/ensure [:answer-field/validate]} {:db/id "answer-61dee0eb-c24f-5acc-a6e4-f4e98039266c" :answer/id #uuid "61dee0eb-c24f-5acc-a6e4-f4e98039266c" :answer/type :answer.type/math :answer/value "0.06" :db/ensure [:answer/validate]} {:db/id "answer-c0ac7114-c25b-54aa-aacf-9719ad9abce0" :answer/id #uuid "c0ac7114-c25b-54aa-aacf-9719ad9abce0" :answer/type :answer.type/math :answer/value "0.16" :db/ensure [:answer/validate]} {:db/id "answer-f6927d54-2b7a-5c52-8184-31a3aca05b2b" :answer/id #uuid "f6927d54-2b7a-5c52-8184-31a3aca05b2b" :answer/type :answer.type/math :answer/value "0.71" :db/ensure [:answer/validate]} {:db/id "answer-73c08698-8973-5494-8eba-3b3587f55fea" :answer/id #uuid "73c08698-8973-5494-8eba-3b3587f55fea" :answer/type :answer.type/math :answer/value "0.77" :db/ensure [:answer/validate]} {:db/id "answer-a879fe9e-77cc-5a8d-9077-2ef67ab9a250" :answer/id #uuid "a879fe9e-77cc-5a8d-9077-2ef67ab9a250" :answer/type :answer.type/math :answer/value "0.93" :db/ensure [:answer/validate]} {:db/id "question-f4402cb5-3b8b-556e-9fb0-20470cdb8422" :question/id #uuid "f4402cb5-3b8b-556e-9fb0-20470cdb8422" :question/math-academy-id "q-146847" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(12,4)=0.6,\\,F(9,4)=0.3,\\,F(3,4)=0.15,\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{3,6,9,12\\},\\,{S}_{Y}=\\{2,4,6,8\\}.\n$$\n\nFind $P(X\\ge 6,Y\\le 5).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{3,6,9,12\\}\\times \\{2,4,6,8\\}.\n$$\n\nLet's plot the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support, and sketch the region corresponding to the probability we wish to find.\n\n![](images/a7/a782578ef55726c98ed23d89cf3de531ede60fe5db3fa9062c05507c5c2f60af.png)\n\nNotice that this region encompasses the same possible support points as the infinite rectangle with its top-right corner at $(12,4)$ and top-left corner at $(3,4),$ where the top and right boundaries are included, and the left boundary is excluded.\n\n![](images/7b/7ba99957a743b5cf283c2668e81b6c1aeb06730d47fc157aec90fe8bc880ced4.png)\n\nGeometrically, this region can be obtained by taking all points in the infinite rectangle that has its top-right corner at $(12,4)$ (the blue region below) and *subtracting* all points in the infinite rectangle that has its top-right corner at $(3,4)$ (the red region below).\n\n![](images/3b/3bd652b8d918e26cd330ad43555f039845d0b5405b70c96828bb2d652b7f872c.png)\n\n$$\n\\begin{aligned}P(X\\ge 6,Y\\le 5) & =\\overset{\\text{top-right corner at }(12,4)}{\\overset{⏞}{P(X\\le 12,Y\\le 4)}}-\\overset{\\text{top-right corner at }(3,4)}{\\overset{⏞}{P(X\\le 3,Y\\le 4)}} \\\\  & =F(12,4)-F(3,4) \\\\  & =0.6-0.15 \\\\  & =0.45.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-82648e5e-98c3-561c-a273-a2078cd63abe"] :db/ensure [:question/validate]} {:db/id "answer-field-82648e5e-98c3-561c-a273-a2078cd63abe" :answer-field/id #uuid "82648e5e-98c3-561c-a273-a2078cd63abe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-142ce641-a21b-57e9-978c-c207bb9665f1" :answer-field/choices ["answer-d74f9696-6df5-5704-ad5a-17d8e1eaf9fe" "answer-7413f3b1-90cf-5930-8990-52a2b0853b2e" "answer-4b3ddffa-2358-5922-81c3-2d33472e4cec" "answer-142ce641-a21b-57e9-978c-c207bb9665f1" "answer-5a720aef-5c3f-5988-872c-64d4c890d142"] :db/ensure [:answer-field/validate]} {:db/id "answer-d74f9696-6df5-5704-ad5a-17d8e1eaf9fe" :answer/id #uuid "d74f9696-6df5-5704-ad5a-17d8e1eaf9fe" :answer/type :answer.type/math :answer/value "0.15" :db/ensure [:answer/validate]} {:db/id "answer-7413f3b1-90cf-5930-8990-52a2b0853b2e" :answer/id #uuid "7413f3b1-90cf-5930-8990-52a2b0853b2e" :answer/type :answer.type/math :answer/value "0.18" :db/ensure [:answer/validate]} {:db/id "answer-4b3ddffa-2358-5922-81c3-2d33472e4cec" :answer/id #uuid "4b3ddffa-2358-5922-81c3-2d33472e4cec" :answer/type :answer.type/math :answer/value "0.3" :db/ensure [:answer/validate]} {:db/id "answer-142ce641-a21b-57e9-978c-c207bb9665f1" :answer/id #uuid "142ce641-a21b-57e9-978c-c207bb9665f1" :answer/type :answer.type/math :answer/value "0.45" :db/ensure [:answer/validate]} {:db/id "answer-5a720aef-5c3f-5988-872c-64d4c890d142" :answer/id #uuid "5a720aef-5c3f-5988-872c-64d4c890d142" :answer/type :answer.type/math :answer/value "0.9" :db/ensure [:answer/validate]} {:db/id 17592186078403 :knowledge-point/questions ["question-dc22d572-0b94-5462-9d85-2c1d61a16284"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dc22d572-0b94-5462-9d85-2c1d61a16284" :question/id #uuid "dc22d572-0b94-5462-9d85-2c1d61a16284" :question/math-academy-id "q-34999" :question/problem "![](images/39/39c2c86e1fca1dbcf80435237ba31fc4aed9ed8213578b4c5f3971408da59f2d.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above? \n\nI. ${lim}_{x\\to \\,0}f(x)=3$\n\nII. ${lim}_{x\\to \\,1}f(x)=3$\n\nIII. ${lim}_{x\\to \\,-1}f(x)={lim}_{x\\to \\,2}f(x)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. As $x$ approaches $0$ from the left and right we get\n\n$$\n{lim}_{x\\to \\,{0}^{-}}f(x)=3,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}\\,.\n$$\n\nTherefore, ${lim}_{x\\to \\,0}f(x)=\\text{DNE}.$\n\n- Statement II is false. We see from the graph that \n\n$$\n{lim}_{x\\to \\,{1}^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,{1}^{+}}f(x)=3\\,.\n$$\n\nTherefore, ${lim}_{x\\to \\,1}f(x)=\\text{DNE}.$\n\n- Statement III is true.  We see from the graph that \n\n$$\n{lim}_{x\\to \\,-{1}^{-}}f(x)={lim}_{x\\to \\,-{1}^{+}}f(x)=2\n$$\n\nHence, ${lim}_{x\\to \\,-1}f(x)=2.$ Meanwhile, \n\n$$\n{lim}_{x\\to \\,{2}^{-}}f(x)={lim}_{x\\to \\,{2}^{+}}f(x)=2\n$$\n\n \nHence ${lim}_{x\\to \\,2}f(x)=2.$ Therefore, ${lim}_{x\\to \\,0}f(x)={lim}_{x\\to \\,2}f(x).$\n\nIn conclusion, only statement III is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9725b865-33c5-5170-8ad4-3ac184e816c2"] :db/ensure [:question/validate]} {:db/id "answer-field-9725b865-33c5-5170-8ad4-3ac184e816c2" :answer-field/id #uuid "9725b865-33c5-5170-8ad4-3ac184e816c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-89743f02-1d9f-5884-b7b0-ec422e07ca6d" :answer-field/choices ["answer-3cc06de8-5221-52fa-920c-03c18a05eb1f" "answer-31a4015c-7e0e-59a8-af52-660a728632ca" "answer-476e139f-e45f-5859-b5d8-144735e49388" "answer-77c0f144-34b3-52df-ac81-d4928b60dca1" "answer-89743f02-1d9f-5884-b7b0-ec422e07ca6d"] :db/ensure [:answer-field/validate]} {:db/id "answer-3cc06de8-5221-52fa-920c-03c18a05eb1f" :answer/id #uuid "3cc06de8-5221-52fa-920c-03c18a05eb1f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-31a4015c-7e0e-59a8-af52-660a728632ca" :answer/id #uuid "31a4015c-7e0e-59a8-af52-660a728632ca" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-476e139f-e45f-5859-b5d8-144735e49388" :answer/id #uuid "476e139f-e45f-5859-b5d8-144735e49388" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-77c0f144-34b3-52df-ac81-d4928b60dca1" :answer/id #uuid "77c0f144-34b3-52df-ac81-d4928b60dca1" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-89743f02-1d9f-5884-b7b0-ec422e07ca6d" :answer/id #uuid "89743f02-1d9f-5884-b7b0-ec422e07ca6d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186078963 :question/problem "![](images/d9/d9e89a9b811bdc6b766b01eecf817df48968e3ea604b89bc55bc9660331194e0.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above? \n\nI. ${lim}_{x\\to \\,-1}f(x)=4$\n\nII. ${lim}_{x\\to \\,1}f(x)=\\text{DNE}$\n\nIII. ${lim}_{x\\to \\,3}f(x)=1$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. We see from the graph that \n\n$$\n{lim}_{x\\to \\,-{1}^{-}}f(x)={lim}_{x\\to \\,-{1}^{+}}f(x)=3\\,.\n$$\n\nTherefore, ${lim}_{x\\to \\,-1}f(x)=3.$\n\n- Statement II is true. Both limits ${lim}_{x\\to \\,{1}^{-}}f(x)$ and ${lim}_{x\\to \\,{1}^{+}}f(x)$ do not exist because the function $f(x)$ is not given in the interval $(0,2].$ Therefore,\n\n$$\n{lim}_{x\\to \\,1}f(x)=\\text{DNE}\\,.\n$$\n\n- Statement III is true. We see from the graph that \n\n$$\n{lim}_{x\\to \\,{3}^{-}}f(x)={lim}_{x\\to \\,{3}^{+}}f(x)=1\\,.\n$$\n\nTherefore, ${lim}_{x\\to \\,3}f(x)=1.$\n\nIn conclusion, only statements II and III are true." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186076556 :answer-field/correct 17592186076559 :db/ensure [:answer-field/validate]} {:db/id 17592186078509 :knowledge-point/questions ["question-069bdd21-6b0e-5746-9f9a-48c390ea491e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-069bdd21-6b0e-5746-9f9a-48c390ea491e" :question/id #uuid "069bdd21-6b0e-5746-9f9a-48c390ea491e" :question/math-academy-id "q-67539" :question/problem "![](images/1e/1e40e0ffa7880b3b3b63070f063de207dcfafbdbed5fdf02464e180feba715e2.png)\n\nThe function  $y=f(x)$ is defined on $x\\in (-\\frac{5}{2},3).$ Find ${lim}_{x\\to \\,3}f(x).$" :question/worked-solution "From the graph, we see that it is not possible to approach $x=3$ from the right. Therefore,\n\n$$\n{lim}_{x\\to \\,{3}^{+}}f(x)=\\text{DNE}.\n$$\n\nWhen we approach $x=3$ from the left, we have\n\n$$\n{lim}_{x\\to \\,{3}^{-}}f(x)=0\\,.\n$$\n\nSince ${lim}_{x\\to {3}^{-}}f(x)\\ne {lim}_{x\\to {3}^{+}}f(x),$ we  conclude  that\n \n\n$$\n{lim}_{x\\to \\,3}f(x)=\\text{DNE}\\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-482e304e-d433-57bd-9c20-e198c527d454"] :db/ensure [:question/validate]} {:db/id "answer-field-482e304e-d433-57bd-9c20-e198c527d454" :answer-field/id #uuid "482e304e-d433-57bd-9c20-e198c527d454" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2c19089e-e70c-5d3e-89a1-8b1f43d5dfc9" :answer-field/choices ["answer-8d69e6d5-8e64-51d5-9437-2837aa08c01e" "answer-c2b7b55b-e405-57e3-9cfb-bb0f23fba298" "answer-78bc99e5-2323-56ec-9a3c-1a503b64e353" "answer-5373c9c4-344c-5fdd-ab6a-8f94ae077c42" "answer-2c19089e-e70c-5d3e-89a1-8b1f43d5dfc9"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d69e6d5-8e64-51d5-9437-2837aa08c01e" :answer/id #uuid "8d69e6d5-8e64-51d5-9437-2837aa08c01e" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,3}f(x)=-\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c2b7b55b-e405-57e3-9cfb-bb0f23fba298" :answer/id #uuid "c2b7b55b-e405-57e3-9cfb-bb0f23fba298" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,3}f(x)=0" :db/ensure [:answer/validate]} {:db/id "answer-78bc99e5-2323-56ec-9a3c-1a503b64e353" :answer/id #uuid "78bc99e5-2323-56ec-9a3c-1a503b64e353" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,3}f(x)=3" :db/ensure [:answer/validate]} {:db/id "answer-5373c9c4-344c-5fdd-ab6a-8f94ae077c42" :answer/id #uuid "5373c9c4-344c-5fdd-ab6a-8f94ae077c42" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,3}f(x)=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2c19089e-e70c-5d3e-89a1-8b1f43d5dfc9" :answer/id #uuid "2c19089e-e70c-5d3e-89a1-8b1f43d5dfc9" :answer/type :answer.type/math :answer/value "{lim}_{x\\to \\,3}f(x)=\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "activity-ce4873bc-0d3b-5f2c-a4a8-7ecb745b9327" :activity/id #uuid "ce4873bc-0d3b-5f2c-a4a8-7ecb745b9327" :activity/title "Finding the Existence of a Limit Using One-Sided Limits" :activity/type :activity.type/review :activity/scope 17592186048943 :activity/course 17592186046647 :activity/steps ["step-72d4130c-fc01-5da4-a860-034259704a88" "step-d31b4e41-aaa1-5ef0-a230-367e59083067" "step-96bbf527-f90f-58a7-9dde-fd51c996bbe9"] :activity/first-step "step-72d4130c-fc01-5da4-a860-034259704a88" :db/ensure [:activity/validate]} {:db/id "step-72d4130c-fc01-5da4-a860-034259704a88" :step/id #uuid "72d4130c-fc01-5da4-a860-034259704a88" :step/content "question-dc22d572-0b94-5462-9d85-2c1d61a16284" :step/next "step-d31b4e41-aaa1-5ef0-a230-367e59083067" :db/ensure [:step/validate]} {:db/id "step-d31b4e41-aaa1-5ef0-a230-367e59083067" :step/id #uuid "d31b4e41-aaa1-5ef0-a230-367e59083067" :step/content 17592186078963 :step/next "step-96bbf527-f90f-58a7-9dde-fd51c996bbe9" :db/ensure [:step/validate]} {:db/id "step-96bbf527-f90f-58a7-9dde-fd51c996bbe9" :step/id #uuid "96bbf527-f90f-58a7-9dde-fd51c996bbe9" :step/content "question-069bdd21-6b0e-5746-9f9a-48c390ea491e" :db/ensure [:step/validate]} [:db/retract 17592186165584 :answer-field/choices 17592186165585] [:db/retract 17592186165584 :answer-field/choices 17592186165586] [:db/retract 17592186165584 :answer-field/choices 17592186165587] [:db/retract 17592186165584 :answer-field/choices 17592186165588] [:db/retract 17592186165584 :answer-field/choices 17592186165589] {:db/id 17592186166758 :knowledge-point/questions ["question-18c5eb7d-5849-5737-9236-e416ee2ad73f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166596 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh x) = \\dfrac{1}{\\sqrt{x^2+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{-3}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-3\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=-3\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166759 :knowledge-point/questions ["question-f78eb475-8e0d-5dc7-9e33-9b189c20d32b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166597 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcosh x) = \\dfrac{1}{\\sqrt{x^2-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡\\pi }{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\operatorname{ln}⁡\\pi \\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166598 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\artanh x) = \\dfrac{1}{1-x^2}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{1}{2(1-{x}^{2})}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x=\\frac{1}{2}\\,\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-18c5eb7d-5849-5737-9236-e416ee2ad73f" :question/id #uuid "18c5eb7d-5849-5737-9236-e416ee2ad73f" :question/math-academy-id "q-95640" :question/problem "$$\n\n$\\int \\frac{2\\operatorname{ln}⁡3}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=$" :question/worked-solution "The derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2\\operatorname{ln}⁡3}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=2\\operatorname{ln}⁡3\\int \\frac{1}{\\sqrt{{x}^{2}+1}}\\,\\text{d}x=2\\operatorname{ln}⁡3\\operatorname{arsinh}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-562d4906-4cfb-5bff-af51-cfaf3760fb4f"] :db/ensure [:question/validate]} {:db/id "answer-field-562d4906-4cfb-5bff-af51-cfaf3760fb4f" :answer-field/id #uuid "562d4906-4cfb-5bff-af51-cfaf3760fb4f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0815516-38d7-5577-8f28-c428430506fc" :answer-field/choices ["answer-a93aa211-d213-5d09-8437-59eb111b24ed" "answer-bd5da1ee-be9c-5503-8f2f-043718b5faf3" "answer-8934a046-2c2c-5d7d-b9e0-20f670de9ebd" "answer-f0815516-38d7-5577-8f28-c42