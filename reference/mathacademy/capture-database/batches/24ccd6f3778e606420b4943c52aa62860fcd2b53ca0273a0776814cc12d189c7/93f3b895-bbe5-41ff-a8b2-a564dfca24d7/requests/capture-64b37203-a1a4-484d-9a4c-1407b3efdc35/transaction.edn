8d084-32d1-5d13-b2b6-29a387928867"] :db/ensure [:answer-field/validate]} {:db/id "answer-07b8d084-32d1-5d13-b2b6-29a387928867" :answer/id #uuid "07b8d084-32d1-5d13-b2b6-29a387928867" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-13ad1074-2be7-58b6-8b52-de567a736fd0" :question/id #uuid "13ad1074-2be7-58b6-8b52-de567a736fd0" :question/math-academy-id "q-316301" :question/problem "![](images/bc/bcffe721c35a3c729644fb36ee9008095c46298a56109f0dfd75a3c06f3f7cae.png)\n\nThe function $f(x)$ is defined and differentiable on $[-4,2].$ The graph of ${f}^{′}(x)$, the derivative of $f(x),$ is shown above, where the areas of the regions between the graph and the $x$-axis are $4$ and $2,$ respectively (from left to right).\n\nGiven that $f(2)=-3,$ what is the maximum value ${f}_{\\text{max}}$ of $f(x)$ on the interval $[-4,2]?$\n\n${f}_{\\text{max}}=$\n{{field-1}}" :question/worked-solution "According to the candidates test, the maximum value of $f(x)$ on $[-4,2]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points:\n\nWe see that ${f}^{′}(x)$ is defined everywhere on $x\\in (-4,2),$ and ${f}^{′}(x)=0$ at $x=-1.$ Therefore, the candidates are $x=-4,-1,2.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus:\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}f(2) & =-3 \\\\ f(-1) & =f(2)+{\\int }_{2}^{-1}{f}^{′}(t)\\,dt \\\\  & =f(2)-{\\int }_{-1}^{2}{f}^{′}(t)\\,dt \\\\  & =-3-(-2) \\\\  & =-1 \\\\ f(-4) & =f(2)+{\\int }_{2}^{-4}{f}^{′}(t)\\,dt \\\\  & =f(2)-{\\int }_{-4}^{2}{f}^{′}(t)\\,dt \\\\  & =-3-(4+(-2)) \\\\  & =-3-2 \\\\  & =-5\\end{aligned}\n$$\n\n**Step 3**: Select the largest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\n{f}_{\\text{max}}=max\\{-3,-1,-5\\}=-1.\n$$\n\nTherefore, the maximum value of $f$ is ${f}_{\\text{max}}=-1,$ and the value of $x$ that maximizes $f(x)$ is ${x}_{\\text{max}}=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ad41d34f-e05e-58cf-bab8-f5b61c5398a0"] :db/ensure [:question/validate]} {:db/id "answer-field-ad41d34f-e05e-58cf-bab8-f5b61c5398a0" :answer-field/id #uuid "ad41d34f-e05e-58cf-bab8-f5b61c5398a0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0e9984ad-b58e-50e4-9a28-2c6aa4654635" :answer-field/choices ["answer-0e9984ad-b58e-50e4-9a28-2c6aa4654635"] :db/ensure [:answer-field/validate]} {:db/id "answer-0e9984ad-b58e-50e4-9a28-2c6aa4654635" :answer/id #uuid "0e9984ad-b58e-50e4-9a28-2c6aa4654635" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186188524 :question/problem "![](images/f7/f757ffa45b20e043ad461cb0dfa9c486cf73466b1d8d87fa0ffad00bc01af960.png)\n\nThe function $f(x)$ is defined and differentiable on $[-1,5].$ The graph of ${f}^{′}(x),$ the derivative of $f(x),$ is shown above, where the areas of the regions between the graph and the $x$-axis are $4$ and $1,$ respectively (from left to right). Find the maximum value of $f(x)$ on the interval $[-1,5]$ given that $f(5)=-8.$" :question/worked-solution "According to the candidates test, the maximum value of $f(x)$ on $[-1,5]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points:\n\nWe see that ${f}^{′}(x)$ is defined everywhere on $x\\in (-1,5),$ and ${f}^{′}(x)=0$ at $x=3.$ Therefore, the candidates are $x=-1,3,5.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus:\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}f(5) & =-8 \\\\ f(3) & =f(5)+{\\int }_{5}^{3}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(5)-{\\int }_{3}^{5}{f}^{′}(x)\\,\\text{d}x \\\\  & =-8-1 \\\\  & =-9 \\\\ f(-1) & =f(5)+{\\int }_{5}^{-1}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(5)-{\\int }_{-1}^{5}{f}^{′}(x)\\,\\text{d}x \\\\  & =-8-(-4+1) \\\\  & =-8-(-3) \\\\  & =-8+3 \\\\  & =-5\\end{aligned}\n$$\n\n**Step 3**: Select the largest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\n{f}_{\\text{max}}=max\\{-8,-9,-5\\}=-5.\n$$\n\nTherefore, the maximum value of $f$ is ${f}_{\\text{max}}=-5,$ and the value of $x$ that maximizes $f(x)$ is ${x}_{\\text{max}}=-1.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186185424 :answer-field/correct 17592186185428 :db/ensure [:answer-field/validate]} {:db/id "question-e747dd9d-512a-59fa-9944-1137ebe8b2f9" :question/id #uuid "e747dd9d-512a-59fa-9944-1137ebe8b2f9" :question/math-academy-id "q-344167" :question/problem "![](images/6d/6dd61819859d65af85ef462c7fb694ecbfd2640aa62f41ff0e27e5bb8073f48c.png)\n\nThe function $a(x)$ is defined and differentiable on $[-2,5].$ The graph of ${a}^{′}(x),$ the derivative of $a(x),$ is shown above, where the area of the region between the graph and the $x$-axis is $11.$\n\nGiven that $a(5)=-4,$ what is the minimum value ${a}_{\\text{min}}$ of $a(x)$ on the interval $[-2,5]?$\n\n${a}_{\\text{min}}=$\n{{field-1}}" :question/worked-solution "According to the candidates test, the minimum value of $a(x)$ on $[-2,5]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points:\n\nWe see that ${a}^{′}(x)$ is defined everywhere on $x\\in (-2,5),$ and ${a}^{′}(x)\\ne 0$ inside the interval. Therefore, the candidates are $x=-2,5.$\n\n**Step 2**: Compute the value of $a$ for each candidate using the fundamental theorem of calculus:\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}a(5) & =-4 \\\\ a(-2) & =a(5)+{\\int }_{5}^{-2}{a}^{′}(x)\\,\\text{d}x \\\\  & =a(5)-{\\int }_{-2}^{5}{a}^{′}(x)\\,\\text{d}x \\\\  & =-4-(-11) \\\\  & =7\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $a$ from our candidates.\n\nComparing the values of $a$ found in step $2,$ we have\n\n$$\n{a}_{\\text{min}}=min\\{7,-4\\}=-4.\n$$\n\nTherefore, the minimum value of $a$ is ${a}_{\\text{min}}=-4,$ and the value of $x$ that minimizes $a(x)$ is ${x}_{\\text{min}}=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c40dea29-2b27-54dd-9da2-418a3d1e8a16"] :db/ensure [:question/validate]} {:db/id "answer-field-c40dea29-2b27-54dd-9da2-418a3d1e8a16" :answer-field/id #uuid "c40dea29-2b27-54dd-9da2-418a3d1e8a16" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6ff0eb8e-cde3-5239-b043-47a136211ffa" :answer-field/choices ["answer-6ff0eb8e-cde3-5239-b043-47a136211ffa"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ff0eb8e-cde3-5239-b043-47a136211ffa" :answer/id #uuid "6ff0eb8e-cde3-5239-b043-47a136211ffa" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "question-1395e862-a7e8-537a-97de-69c4caaca685" :question/id #uuid "1395e862-a7e8-537a-97de-69c4caaca685" :question/math-academy-id "q-144839" :question/problem "![](images/21/219e476902934a4272fb0c523fe0b623f27ef5ba2647fcf4658d0b262e64200e.png)\n\nThe function $f(x)$ is defined and differentiable on $[0,5].$ The graph of ${f}^{′}(x)$, the derivative of $f(x),$ is shown above, where the area of the region between the graph and the $x$-axis is $8.$ Find the minimum value of $f(x)$ on the interval $[0,5]$ given that $f(5)=3.$" :question/worked-solution "According to the candidates test, the minimum value of $f(x)$ on $[0,5]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points:\n\nWe see that ${f}^{′}(x)$ is defined everywhere on $x\\in (0,5),$ and ${f}^{′}(x)\\ne 0$ inside the interval. Therefore, the candidates are $x=0,5.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus:\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}f(5) & =3 \\\\ f(0) & =f(5)+{\\int }_{5}^{0}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(5)-{\\int }_{0}^{5}{f}^{′}(x)\\,\\text{d}x \\\\  & =3-8 \\\\  & =-5\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\n{f}_{\\text{min}}=min\\{3,-5\\}=-5.\n$$\n\nTherefore, the minimum value of $f$ is ${f}_{\\text{min}}=-5,$ and the value of $x$ that minimizes $f(x)$ is ${x}_{\\text{min}}=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a91548fc-7110-5f63-9d3c-0095f5b5ffe8"] :db/ensure [:question/validate]} {:db/id "answer-field-a91548fc-7110-5f63-9d3c-0095f5b5ffe8" :answer-field/id #uuid "a91548fc-7110-5f63-9d3c-0095f5b5ffe8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f9c6ce2-7d9b-519d-97b9-3134db09d6d6" :answer-field/choices ["answer-c32c0b40-a807-5d90-aa7a-5b8fcac8a181" "answer-6f9c6ce2-7d9b-519d-97b9-3134db09d6d6" "answer-b1f87cad-f947-5cf2-a0e5-dd1577365c74" "answer-141d92b1-19f8-549f-9528-6eca52259abd" "answer-45425c6b-a98b-51fa-8eca-55d7ba992558"] :db/ensure [:answer-field/validate]} {:db/id "answer-c32c0b40-a807-5d90-aa7a-5b8fcac8a181" :answer/id #uuid "c32c0b40-a807-5d90-aa7a-5b8fcac8a181" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-6f9c6ce2-7d9b-519d-97b9-3134db09d6d6" :answer/id #uuid "6f9c6ce2-7d9b-519d-97b9-3134db09d6d6" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-b1f87cad-f947-5cf2-a0e5-dd1577365c74" :answer/id #uuid "b1f87cad-f947-5cf2-a0e5-dd1577365c74" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-141d92b1-19f8-549f-9528-6eca52259abd" :answer/id #uuid "141d92b1-19f8-549f-9528-6eca52259abd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-45425c6b-a98b-51fa-8eca-55d7ba992558" :answer/id #uuid "45425c6b-a98b-51fa-8eca-55d7ba992558" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-a3fba9ae-fcbd-5c75-9ad3-403a4a333328" :question/id #uuid "a3fba9ae-fcbd-5c75-9ad3-403a4a333328" :question/math-academy-id "q-344182" :question/problem "![](images/04/04e4299da4d4c29cce751d04ee6ee29380a3dead3ab3456f6645858b5d9d106b.png)\n\nThe function $f(x)$ is defined and differentiable on $[-4,3].$ The graph of ${f}^{′}(x),$ the derivative of $f(x),$ is shown above. Given that $f(3)=2,$ what is the minimum value ${f}_{\\text{min}}$ of $f(x)$ on the interval $[-4,3]?$\n\n${f}_{\\text{min}}=$\n{{field-1}}" :question/worked-solution "According to the candidates test, the maximum value of $f(x)$ on $[-4,3]$ must occur at a critical point or an endpoint of the interval. \n\n**Step 1**: Find the critical points:\n\nWe see that ${f}^{′}(x)$ is defined everywhere on $x\\in (-4,3),$ and ${f}^{′}(x)=0$ at $x=-2.$ Therefore, the candidates are $x=-4,-2,3.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus:\n\nThe function is made up of $2$ triangles. Let's add the areas bounded by these shapes to our diagram:\n\n![](images/c3/c30d7e1d2c9eb939726d85b0ee5d51a2bdc0cfe73fab92f0ba29839a9f18be4e.png)\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}f(3) & =2 \\\\ f(-2) & =f(3)+{\\int }_{3}^{-2}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(3)-{\\int }_{-2}^{3}{f}^{′}(x)\\,\\text{d}x \\\\  & =2-7.5 \\\\  & =-5.5 \\\\ f(-4) & =f(3)+{\\int }_{3}^{-4}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(3)-{\\int }_{-4}^{3}{f}^{′}(x)\\,\\text{d}x \\\\  & =2-(-3+7.5) \\\\  & =2-4.5 \\\\  & =-2.5\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $f$ from our candidates. \n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\n{f}_{\\text{min}}=min\\{2,-5.5,-2.5\\}=-5.5.\n$$\n\nTherefore, the minimum value of $f$ is ${f}_{\\text{min}}=-5.5,$ and the value of $x$ that minimizes $f(x)$ is ${x}_{\\text{min}}=-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-371f6b9e-7664-5f83-883e-450ac8a167d9"] :db/ensure [:question/validate]} {:db/id "answer-field-371f6b9e-7664-5f83-883e-450ac8a167d9" :answer-field/id #uuid "371f6b9e-7664-5f83-883e-450ac8a167d9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ee602556-4b14-51e0-a262-9ca407ca2dd3" :answer-field/choices ["answer-ee602556-4b14-51e0-a262-9ca407ca2dd3"] :db/ensure [:answer-field/validate]} {:db/id "answer-ee602556-4b14-51e0-a262-9ca407ca2dd3" :answer/id #uuid "ee602556-4b14-51e0-a262-9ca407ca2dd3" :answer/type :answer.type/math :answer/value "-5.5" :db/ensure [:answer/validate]} {:db/id "question-82901cf9-17f2-500f-9676-c95d18dab327" :question/id #uuid "82901cf9-17f2-500f-9676-c95d18dab327" :question/math-academy-id "q-344166" :question/problem "![](images/31/31fd7b63abbf8224421ee53b0703e9cc72fac2f9a8ffc3e460218bb42c4f229a.png)\n\nThe function $q(x)$ is defined and differentiable on $[1,9].$ The graph of ${q}^{′}(x),$ the derivative of $q(x),$ is shown above, where the area of the region between the graph and the $x$-axis is $12.$\n\nGiven that $q(9)=-1,$ what is the minimum value ${q}_{\\text{min}}$ of $q(x)$ on the interval $[1,9]?$\n\n${q}_{\\text{min}}=$\n{{field-1}}" :question/worked-solution "According to the candidates test, the minimum value of $q(x)$ on $[1,9]$ must occur at a critical point or an endpoint of the interval.\n\n**Step 1**: Find the critical points:\n\nWe see that ${q}^{′}(x)$ is defined everywhere on $x\\in (1,9),$ and ${q}^{′}(x)\\ne 0$ inside the interval. Therefore, the candidates are $x=1,9.$\n\n**Step 2**: Compute the value of $q$ for each candidate using the fundamental theorem of calculus:\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n$$\n\\begin{aligned}q(9) & =-1 \\\\ q(1) & =q(9)+{\\int }_{9}^{1}{q}^{′}(x)\\,\\text{d}x \\\\  & =q(9)-{\\int }_{1}^{9}{q}^{′}(x)\\,\\text{d}x \\\\  & =-1-12 \\\\  & =-13\\end{aligned}\n$$\n\n**Step 3**: Select the smallest value of $q$ from our candidates.\n\nComparing the values of $q$ found in step $2,$ we have\n\n$$\n{q}_{\\text{min}}=min\\{-1,-13\\}=-13.\n$$\n\nTherefore, the minimum value of $q$ is ${q}_{\\text{min}}=-13,$ and the value of $x$ that minimizes $q(x)$ is ${x}_{\\text{min}}=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bfb1f5aa-b5e4-53c8-93c1-41b509c0b3ce"] :db/ensure [:question/validate]} {:db/id "answer-field-bfb1f5aa-b5e4-53c8-93c1-41b509c0b3ce" :answer-field/id #uuid "bfb1f5aa-b5e4-53c8-93c1-41b509c0b3ce" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8fe41923-7be4-516e-afbe-7eb6f9a11be9" :answer-field/choices ["answer-8fe41923-7be4-516e-afbe-7eb6f9a11be9"] :db/ensure [:answer-field/validate]} {:db/id "answer-8fe41923-7be4-516e-afbe-7eb6f9a11be9" :answer/id #uuid "8fe41923-7be4-516e-afbe-7eb6f9a11be9" :answer/type :answer.type/math :answer/value "-13" :db/ensure [:answer/validate]} {:db/id 17592186189400 :tutorial/content "Recall that if a function $f'(x),$ the derivative of $f(x),$ is continuous over $[a,b],$ the fundamental theorem of calculus states that\n\n$$\nf(x) = f(a) + \\int_{a}^{x} f'(t) \\: \\textrm{d}t,\n$$\n\nwhere $x \\in [a,b].$ This form of the fundamental theorem of calculus is useful if we know $f'(x)$ and the value of $f(a).$ \n\nNow, suppose we're given $f(b)$ instead of $f(a).$ To rewrite the fundamental theorem in this case, we replace $a$ with $b$ in the above, and we get\n\n$$\nf(x)  = f(b) + \\int_{b}^{x} f'(t) \\: \\textrm{d}t.\n$$\n\nThis form of the fundamental theorem of calculus will be helpful in this lesson, as we'll see." :db/ensure [:tutorial/validate]} {:db/id 17592186189392 :tutorial/content "Sometimes, when finding the global extrema of a function defined on a closed, bounded interval $[a,b]$ from the graph of its derivative, we need to integrate from right to left instead of left to right when applying the fundamental theorem of calculus. This occurs when we're given the value of $f$ at some value other than the left endpoint.\n\nConsider the function $f(x)$ that's defined and differentiable on $[-4,4].$ The graph of $f'(x),$ the derivative of $f(x),$ is shown below.\n\n![](images/eb/eb31641d86fbe970ef843372d950c38b425a29c236f8e7aed6895fd57bf7959a.png)\n\nThe areas of the shaded regions are indicated on the diagram. Additionally, it is known that $f(4) = 8.$ Notice that we're given that value of $f(x)$ at the *right* endpoint.\n\nLet's use the candidates test to find the maximum value of $f(x)$ on $[-4,4].$\n\nAccording to the candidates test, the maximum value of $f(x)$ on $[-4,4]$ must occur at a critical point or an endpoint of the interval. Therefore, we proceed as follows:\n\n**Step 1**: Find the critical points.\n\nWe see that $f'(x)$ is defined everywhere on $x \\in (-4,4),$ and $f'(x) = 0$ at $x=1.$ Therefore, the candidates are $x=-4,1,4.$\n\n**Step 2**: Compute the value of $f$ for each candidate using the fundamental theorem of calculus.\n\nUsing the given information and the fundamental theorem of calculus, we have the following:\n\n- The value of $f(x)$ at the right endpoint is given:\n\n$$\nf(4)\t= 8\n$$\n\n- To compute $f(1),$ we apply the alternate form of the fundamental theorem of calculus that we saw earlier, as follows:\n\n$$\n\\begin{aligned}f(1) & =f(4)+{\\int }_{4}^{1}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(4)-{\\int }_{1}^{4}{f}^{′}(x)\\,\\text{d}x \\\\  & =8-4 \\\\  & =4\\end{aligned}\n$$\n\n- Similarly, to compute $f(-4),$ we apply the alternate form of the fundamental theorem of calculus:\n\n$$\n\\begin{aligned}f(-4) & =f(4)+{\\int }_{4}^{-4}{f}^{′}(x)\\,\\text{d}x \\\\  & =f(4)-{\\int }_{-4}^{4}{f}^{′}(x)\\,\\text{d}x \\\\  & =8-(-6+4) \\\\  & =8-(-2) \\\\  & =8+2 \\\\  & =10\\end{aligned}\n$$\n\n**Step 3**: Select the largest value of $f$ from our candidates.\n\nComparing the values of $f$ found in step $2,$ we have\n\n$$\nf_{\\text{max}} = \\max\\{8, 4, 10\\} = 10.\n$$\n\nTherefore, the maximum value of $f$ is $f_\\text{max} = 10,$ and the value of $x$ that maximizes $f(x)$ is $x_\\text{max} = -4.$" :db/ensure [:tutorial/validate]} {:db/id 17592186188486 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186083184 :knowledge-point/questions ["question-bc5a7bfe-60f8-5841-b9f2-93c7cc229a66" "question-7ddac438-ed03-5ef8-ae58-2b427cb03c98"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082992 :question/worked-solution "Recall that the graph of an even function must be symmetric about the $y$-axis.\n\n- Graphs II, III, and IV are not symmetric about the $y$-axis. So, they are **not** even functions.\n\n- On the other hand, graph I is symmetric about the $y$-axis. That is to say, if we reflect graph I over the $y$-axis, we get the same picture. This means that graph I is an even function.\n\n![](images/b2/b2598584b088e924dc518aa39d4adb1966f5670c827389c90bbf089dc50ee5e8.png)\n\nTherefore, the correct answer is \"I only.\"" :db/ensure [:question/validate]} {:db/id 17592186083166 :knowledge-point/questions ["question-a10e83cb-86c5-591c-aa72-4d43e4109d66" "question-f7f794d6-627b-530b-9219-5208601d87a7" "question-6c5eea4e-4b84-5cc7-8353-9e67cf3ab163"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082983 :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs I, II, and IV do not have rotational symmetry of order $2$ about the origin. So, they are **not** odd functions.\n\n- On the other hand, graph III does have rotational symmetry about the origin. If we rotate the graph $180^\\circ$ around the origin, we get the same picture. This means that graph III shows an odd function.\n\n![](images/9e/9eb4d72e1fbcc0fdefbca6301127be3bb98c6a7a8bc1b4bffb66144fe9c15010.png)\n\nTherefore, the correct answer is \"III only.\"" :db/ensure [:question/validate]} {:db/id 17592186083185 :knowledge-point/questions ["question-49d7ac71-7387-5bcd-8351-170b2eb2bef2" "question-5272ce70-1353-5fba-a94b-5e92203eee02"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082993 :question/problem "Is the function $f(x)=|x| -1$ even, odd, both, or neither?" :question/worked-solution "Remember that\n\n- a function is even if $f(-x) = f(x)$ for all $x,$ while\n\n- a function is odd if $f(-x) = -f(x)$ for all $x.$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =|(-x)|-1 \\\\  & =|x|-1 \\\\  & =f(x).\\end{aligned}\n$$\n\nSince $f(-x) = f(x),$ the function is even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(|x|-1) \\\\  & =-|x|+1.\\end{aligned}\n$$\n\nSince $f(-x) \\neq -f(x),$ the function is not odd.\n\nTherefore, the function is only even." :db/ensure [:question/validate]} {:db/id 17592186083167 :knowledge-point/questions ["question-5e293714-80a3-5b8a-84fe-6e44867ed437" "question-7d2fbf06-bec2-5ef7-8e27-5ab81fcb62b5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082984 :question/problem "The table below defines the function $g(x).$ Given that $g(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-5$ | $-4$ | $-1$ | $1$ | $4$ | $5$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $20$ | $11$ | $-4$ | $a-3$ | $11$ | $b+5$ |" :question/worked-solution "Since $g(x)$ is an even function, we must have that $g(-x)=g(x).$ \n\nUsing the fact that $g(-1) = g(1),$ we obtain\n\n$$\n\\begin{aligned}g(-1) & =g(1) \\\\ -4 & =a-3 \\\\ a & =-1.\\end{aligned}\n$$\n\nUsing the fact that $g(-5) = g(5),$ we obtain\n\n$$\n\\begin{aligned}g(-5) & =g(5) \\\\ 20 & =b+5 \\\\ b & =15.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b = -1 + 15 = 14.\n$$" :db/ensure [:question/validate]} {:db/id "question-bc5a7bfe-60f8-5841-b9f2-93c7cc229a66" :question/id #uuid "bc5a7bfe-60f8-5841-b9f2-93c7cc229a66" :question/math-academy-id "q-110598" :question/problem "![](images/b0/b0189edb7d5582896a6b56623fa5b33c1dc9b65ff3d8ccaf634df452a72d9e0f.png)\n\nThe figure above shows part of the graph of $y=f(x)$ which is defined on the interval $x\\in [-3,3].$ Given that $f(x)$ is even, which of the following gives the complete graph of $y=f(x)?$" :question/worked-solution "Recall that the graph of an even function must be symmetric about the $y$-axis.\n\nSo, we can obtain the missing part of the graph by reflecting the given part over the $y$-axis. \n\nTherefore, the complete graph of the function is shown below.\n\n![](images/22/22914a2693ec654474ca8572587386de4c35ae3feb6663bd1c915c29bbf9e5dd.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-234e0980-b8d4-52ce-bfbd-22840a3538a3"] :db/ensure [:question/validate]} {:db/id "answer-field-234e0980-b8d4-52ce-bfbd-22840a3538a3" :answer-field/id #uuid "234e0980-b8d4-52ce-bfbd-22840a3538a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f179696-1b1a-5a79-9215-1690b67b0ec9" :answer-field/choices ["answer-0676e816-698c-55c5-97c5-426cf8a46841" "answer-83d223bd-390e-5184-89db-83314d052609" "answer-91db3be4-c008-53c8-a655-510128d6f235" "answer-1f179696-1b1a-5a79-9215-1690b67b0ec9" "answer-3aa4a4f9-72dc-528e-b63d-bd04e03e76bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-0676e816-698c-55c5-97c5-426cf8a46841" :answer/id #uuid "0676e816-698c-55c5-97c5-426cf8a46841" :answer/type :answer.type/image :answer/value "images/16/164bdf0340e40fc342842d9476628d8751e473821b22fd3eda5f01d1dac195c0.png" :db/ensure [:answer/validate]} {:db/id "answer-83d223bd-390e-5184-89db-83314d052609" :a