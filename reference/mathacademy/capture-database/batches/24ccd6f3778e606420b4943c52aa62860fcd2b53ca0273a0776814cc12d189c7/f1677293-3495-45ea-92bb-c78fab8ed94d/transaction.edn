b-ab6f-1db1647a3f1b" :answer-field/id #uuid "3e646d08-6d87-5edb-ab6f-1db1647a3f1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ff1c754-7c47-55cc-9eef-ba398b7918df" :answer-field/choices ["answer-1b77c1f2-a40d-5a9a-b61e-367a1474dbd0" "answer-22b18baa-36bd-50de-b22c-a766f02854d5" "answer-19ac7f14-57c5-52ca-a1d7-62b8c6433908" "answer-481b37f4-3b1f-5883-bf62-5e27987c6311" "answer-2ff1c754-7c47-55cc-9eef-ba398b7918df"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b77c1f2-a40d-5a9a-b61e-367a1474dbd0" :answer/id #uuid "1b77c1f2-a40d-5a9a-b61e-367a1474dbd0" :answer/type :answer.type/math :answer/value "192\\,{\\text{m}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-22b18baa-36bd-50de-b22c-a766f02854d5" :answer/id #uuid "22b18baa-36bd-50de-b22c-a766f02854d5" :answer/type :answer.type/math :answer/value "192\\,{\\text{m}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-19ac7f14-57c5-52ca-a1d7-62b8c6433908" :answer/id #uuid "19ac7f14-57c5-52ca-a1d7-62b8c6433908" :answer/type :answer.type/math :answer/value "512\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-481b37f4-3b1f-5883-bf62-5e27987c6311" :answer/id #uuid "481b37f4-3b1f-5883-bf62-5e27987c6311" :answer/type :answer.type/math :answer/value "512\\,{\\text{m}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2ff1c754-7c47-55cc-9eef-ba398b7918df" :answer/id #uuid "2ff1c754-7c47-55cc-9eef-ba398b7918df" :answer/type :answer.type/math :answer/value "512\\,{\\text{m}}^{3}" :db/ensure [:answer/validate]} {:db/id "question-c934b83c-da17-589f-b488-92fa39e40a56" :question/id #uuid "c934b83c-da17-589f-b488-92fa39e40a56" :question/math-academy-id "q-144196" :question/problem "A cube has a side length of $9\\,\\text{mm}.$ What is the volume of the cube?" :question/worked-solution "To find the volume $V$ of a cube, we cube its side length. Therefore,\n\n$$\n\\begin{aligned}V & =(9\\,\\text{mm})^{3} \\\\  & =9\\,\\text{mm}\\times 9\\,\\text{mm}\\times 9\\,\\text{mm} \\\\  & =(9\\times 9\\times 9)\\times (\\text{mm}\\times \\text{mm}\\times \\text{mm}) \\\\  & =729\\,{\\text{mm}}^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1806f5a4-d07f-5af2-b441-1fae7c71408a"] :db/ensure [:question/validate]} {:db/id "answer-field-1806f5a4-d07f-5af2-b441-1fae7c71408a" :answer-field/id #uuid "1806f5a4-d07f-5af2-b441-1fae7c71408a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c813338-03f3-51a9-8915-ae0fa801e201" :answer-field/choices ["answer-43bee05a-b039-5ddd-be09-32dfe9adbf4c" "answer-f8386d62-f3f7-5a63-b608-4c61326331b9" "answer-018027ba-6e6b-5f8a-af25-a18526fbc5c5" "answer-4b680d99-95d4-51eb-8456-02a880bdf081" "answer-5c813338-03f3-51a9-8915-ae0fa801e201"] :db/ensure [:answer-field/validate]} {:db/id "answer-43bee05a-b039-5ddd-be09-32dfe9adbf4c" :answer/id #uuid "43bee05a-b039-5ddd-be09-32dfe9adbf4c" :answer/type :answer.type/math :answer/value "243\\,{\\text{mm}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f8386d62-f3f7-5a63-b608-4c61326331b9" :answer/id #uuid "f8386d62-f3f7-5a63-b608-4c61326331b9" :answer/type :answer.type/math :answer/value "243\\,{\\text{mm}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-018027ba-6e6b-5f8a-af25-a18526fbc5c5" :answer/id #uuid "018027ba-6e6b-5f8a-af25-a18526fbc5c5" :answer/type :answer.type/math :answer/value "729\\,\\text{mm}" :db/ensure [:answer/validate]} {:db/id "answer-4b680d99-95d4-51eb-8456-02a880bdf081" :answer/id #uuid "4b680d99-95d4-51eb-8456-02a880bdf081" :answer/type :answer.type/math :answer/value "729\\,{\\text{mm}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5c813338-03f3-51a9-8915-ae0fa801e201" :answer/id #uuid "5c813338-03f3-51a9-8915-ae0fa801e201" :answer/type :answer.type/math :answer/value "729\\,{\\text{mm}}^{3}" :db/ensure [:answer/validate]} [:db/retract 17592186125043 :question/answer-fields 17592186122858] {:db/id 17592186124532 :knowledge-point/questions ["question-7183ce0d-1871-5ef9-9ae5-46b683d591c8" "question-af5b5ba4-a618-5f57-bc44-d42484f14c82"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124534 :knowledge-point/questions ["question-381f7568-7449-53f3-9fba-a89117d8269e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124578 :knowledge-point/questions ["question-800b324e-1ca8-5722-9959-a0bda670cec5" "question-c742c85e-0648-5cd9-8c31-bb35257f03e2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7183ce0d-1871-5ef9-9ae5-46b683d591c8" :question/id #uuid "7183ce0d-1871-5ef9-9ae5-46b683d591c8" :question/math-academy-id "q-83705" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=3,$ ${\\lambda }_{2}=-1,$ ${\\lambda }_{3}=1$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}-1 \\\\ 0 \\\\ -1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=[\\begin{aligned}1 & -1 & -1 \\\\ -1 & 1 & 0 \\\\ a & 0 & b\\end{aligned}][\\begin{aligned}c & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]{[\\begin{aligned}1 & -1 & -1 \\\\ -1 & 1 & 0 \\\\ a & 0 & b\\end{aligned}]}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=3,$ ${\\lambda }_{2}=-1,$ ${\\lambda }_{3}=1,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal: \n\n$$\nD=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=3,$\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-1,$ and\n\n- the $3$rd column is the eigenvector corresponding to ${\\lambda }_{3}=-1.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}1 & -1 & -1 \\\\ -1 & 1 & 0 \\\\ -1 & 0 & -1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nA=[\\begin{aligned}1 & -1 & -1 \\\\ -1 & 1 & 0 \\\\ -1 & 0 & -1\\end{aligned}][\\begin{aligned}3 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]{[\\begin{aligned}1 & -1 & -1 \\\\ -1 & 1 & 0 \\\\ -1 & 0 & -1\\end{aligned}]}^{-1}.\n$$\n\nIn conclusion, we get $a=-1,$ $b=-1,$ and $c=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6db82ef2-8d0e-58c9-8bc4-7c52dc1e4dcf"] :db/ensure [:question/validate]} {:db/id "answer-field-6db82ef2-8d0e-58c9-8bc4-7c52dc1e4dcf" :answer-field/id #uuid "6db82ef2-8d0e-58c9-8bc4-7c52dc1e4dcf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-018cb1d9-4080-55b4-8ebf-21d4e8fa4d07" :answer-field/choices ["answer-018cb1d9-4080-55b4-8ebf-21d4e8fa4d07" "answer-0d33fde4-e2b1-57a6-8569-020539ed6f41" "answer-f370cf1f-96a5-56f0-a5d3-d4f31b71ac03" "answer-05bb1276-e1a7-5941-90c5-9145274ba4c2" "answer-ba2adafb-9e4e-5d36-8429-0b4d174295dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-018cb1d9-4080-55b4-8ebf-21d4e8fa4d07" :answer/id #uuid "018cb1d9-4080-55b4-8ebf-21d4e8fa4d07" :answer/type :answer.type/text :answer/value "$a=-1,$ $b=-1,$ and $c=3$" :db/ensure [:answer/validate]} {:db/id "answer-0d33fde4-e2b1-57a6-8569-020539ed6f41" :answer/id #uuid "0d33fde4-e2b1-57a6-8569-020539ed6f41" :answer/type :answer.type/text :answer/value "$a=-1,$ $b=-3,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "answer-f370cf1f-96a5-56f0-a5d3-d4f31b71ac03" :answer/id #uuid "f370cf1f-96a5-56f0-a5d3-d4f31b71ac03" :answer/type :answer.type/text :answer/value "$a=1,$ $b=-1,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "answer-05bb1276-e1a7-5941-90c5-9145274ba4c2" :answer/id #uuid "05bb1276-e1a7-5941-90c5-9145274ba4c2" :answer/type :answer.type/text :answer/value "$a=3,$ $b=-1,$ and $c=1$" :db/ensure [:answer/validate]} {:db/id "answer-ba2adafb-9e4e-5d36-8429-0b4d174295dd" :answer/id #uuid "ba2adafb-9e4e-5d36-8429-0b4d174295dd" :answer/type :answer.type/text :answer/value "$a=3,$ $b=1,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "question-af5b5ba4-a618-5f57-bc44-d42484f14c82" :question/id #uuid "af5b5ba4-a618-5f57-bc44-d42484f14c82" :question/math-academy-id "q-84594" :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=-8,$ ${\\lambda }_{2}=6,$ ${\\lambda }_{3}=0$ are eigenvalues, and \n\n$$\n{v}_{1}=[\\begin{aligned}-4 \\\\ 2 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-2 \\\\ -3 \\\\ 2\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}-1 \\\\ -6 \\\\ 3\\end{aligned}]\n$$\n\nare the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=A,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-8,$ ${\\lambda }_{2}=6,$ ${\\lambda }_{3}=0,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-8,$\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=6,$ and\n\n- the $3$rd column is the eigenvector corresponding to ${\\lambda }_{3}=0.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}-4 & -2 & -1 \\\\ 2 & -3 & -6 \\\\ 1 & 2 & 3\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3bafffe9-ad74-503f-8d92-47a0678e49c3"] :db/ensure [:question/validate]} {:db/id "answer-field-3bafffe9-ad74-503f-8d92-47a0678e49c3" :answer-field/id #uuid "3bafffe9-ad74-503f-8d92-47a0678e49c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ecac03ad-87df-5528-9573-767c2d3397a9" :answer-field/choices ["answer-f3087984-1725-52d5-aeac-9cfabdeb1733" "answer-e137d699-f455-56d7-bea8-ae26fac32af1" "answer-5d914700-a622-51bd-b23f-e0c8b5876a8c" "answer-e099e7fa-99c6-5f58-b356-c698463df652" "answer-ecac03ad-87df-5528-9573-767c2d3397a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f3087984-1725-52d5-aeac-9cfabdeb1733" :answer/id #uuid "f3087984-1725-52d5-aeac-9cfabdeb1733" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-4 & -1 & -2 \\\\ 2 & -6 & -3 \\\\ 1 & 3 & 2\\end{aligned}]$\nand\n$P=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-e137d699-f455-56d7-bea8-ae26fac32af1" :answer/id #uuid "e137d699-f455-56d7-bea8-ae26fac32af1" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-4 & -2 & -1 \\\\ 2 & -3 & -6 \\\\ 1 & 2 & 3\\end{aligned}]$\nand \n$P=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-5d914700-a622-51bd-b23f-e0c8b5876a8c" :answer/id #uuid "5d914700-a622-51bd-b23f-e0c8b5876a8c" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]$ \nand \n$P=[\\begin{aligned}-1 & -2 & -4 \\\\ -6 & -3 & 2 \\\\ 3 & 2 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-e099e7fa-99c6-5f58-b356-c698463df652" :answer/id #uuid "e099e7fa-99c6-5f58-b356-c698463df652" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]$ \nand \n$P=[\\begin{aligned}-4 & -1 & -2 \\\\ 2 & -6 & -3 \\\\ 1 & 3 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-ecac03ad-87df-5528-9573-767c2d3397a9" :answer/id #uuid "ecac03ad-87df-5528-9573-767c2d3397a9" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-8 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]$ \nand \n$P=[\\begin{aligned}-4 & -2 & -1 \\\\ 2 & -3 & -6 \\\\ 1 & 2 & 3\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "question-381f7568-7449-53f3-9fba-a89117d8269e" :question/id #uuid "381f7568-7449-53f3-9fba-a89117d8269e" :question/math-academy-id "q-37235" :question/problem "Consider the following matrices:\n\n$$\nA=[\\begin{aligned}23 & -19 & 13 \\\\ 50 & -43 & 32 \\\\ 30 & -27 & 22\\end{aligned}],\\,D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 3\\end{aligned}],\\,P=[\\begin{aligned}2 & a & -1 \\\\ 3 & 2 & 1 \\\\ 1 & b & 3\\end{aligned}]\n$$\n\nGiven that $A=PD{P}^{-1},$ find the value of $a+b.$" :question/worked-solution "From the diagonal matrix $D$, we deduce that the eigenvalues of $A$ are \n\n$\\,$ ${\\lambda }_{1}=1,\\,$ ${\\lambda }_{2}=-2,\\,$ ${\\lambda }_{3}=3.$ \n\nSo, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=-2.$\n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{2}=-2.$ Computing $A-(-2)I,$ we get \n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}23 & -19 & 13 \\\\ 50 & -43 & 32 \\\\ 30 & -27 & 22\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}25 & -19 & 13 \\\\ 50 & -41 & 32 \\\\ 30 & -27 & 24\\end{aligned}].\\end{aligned}\n$$\n\n \n\nSo, we have a system of linear equations with the augmented matrix $M$ that we reduce to row echelon form using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}25 & -19 & 13 & 0 \\\\ 50 & -41 & 32 & 0 \\\\ 30 & -27 & 24 & 0\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1} \\\\ {R}_{3}:={R}_{3}+(-\\frac{6}{5}){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}25 & -19 & 13 & 0 \\\\ 0 & -3 & 6 & 0 \\\\ 0 & -\\frac{21}{5} & \\frac{42}{5} & 0\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-\\frac{7}{5}){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}25 & -19 & 13 & 0 \\\\ 0 & -3 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe reduced matrix above has two pivot columns ($1$st and $2$nd). Thus, ${x}_{3}$ is a free variable. From the second equation, we obtain ${x}_{2}=2{x}_{3}.$  Substituting this into the first equation, we get ${x}_{1}={x}_{3}.$ \nHence, the general solution is \n\n$$\n[\\begin{aligned}{x}_{3} \\\\ 2{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nTherefore, setting ${x}_{3}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}a \\\\ 2 \\\\ b\\end{aligned}]=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nFinally, $a+b=1+1=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d12f6dde-e5b0-5b0d-8795-17186369244e"] :db/ensure [:question/validate]} {:db/id "answer-field-d12f6dde-e5b0-5b0d-8795-17186369244e" :answer-field/id #uuid "d12f6dde-e5b0-5b0d-8795-17186369244e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-279f798e-fca6-5883-b6f2-651083c8d7ec" :answer-field/choices ["answer-72c2755d-f02b-5787-8c1c-3f4bebe47eb6" "answer-1cea786b-6aeb-5ab2-a668-e87a4f9adbc5" "answer-e75890bc-ed87-53a8-8ce4-3a04a435feb9" "answer-279f798e-fca6-5883-b6f2-651083c8d7ec" "answer-03c63519-b99a-535f-a767-aba13aa8c448"] :db/ensure [:answer-field/validate]} {:db/id "answer-72c2755d-f02b-5787-8c1c-3f4bebe47eb6" :answer/id #uuid "72c2755d-f02b-5787-8c1c-3f4bebe47eb6" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-1cea786b-6aeb-5ab2-a668-e87a4f9adbc5" :answer/id #uuid "1cea786b-6aeb-5ab2-a668-e87a4f9adbc5" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-e75890bc-ed87-53a8-8ce4-3a04a435feb9" :answer/id #uuid "e75890bc-ed87-53a8-8ce4-3a04a435feb9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-279f798e-fca6-5883-b6f2-651083c8d7ec" :answer/id #uuid "279f798e-fca6-5883-b6f2-651083c8d7ec" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-03c63519-b99a-535f-a767-aba13aa8c448" :answer/id #uuid "03c63519-b99a-535f-a767-aba13aa8c448" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-800b324e-1ca8-5722-9959-a0bda670cec5" :question/id #uuid "800b324e-1ca8-5722-9959-a0bda670cec5" :question/math-academy-id "q-83847" :question/problem "$$\nA=[\\begin{aligned}5 & 2 & -2 \\\\ -3 & 0 & 2 \\\\ 1 & 1 & 1\\end{aligned}]\n$$\n\n \nThe matrix $A$ has eigenvalues ${\\lambda }_{1}=1,$ ${\\lambda }_{2}=2,$ and ${\\lambda }_{3}=3.$\nFind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  Notice that we are already given the eigenvalues of the matrix: \n\n$\\,$ ${\\lambda }_{1}=1,\\,$ ${\\lambda }_{2}=2,\\,$ ${\\lambda }_{3}=3.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ Applying our usual method, we get the following.\n\n- For ${\\lambda }_{1}=1,$ we get\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}4 & 2 & -2 \\\\ -3 & -1 & 2 \\\\ 1 & 1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives us the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=2,$ we get\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}3 & 2 & -2 \\\\ -3 & -2 & 2 \\\\ 1 & 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives us the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{3}=3,$ we get\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}2 & 2 & -2 \\\\ -3 & -3 & 2 \\\\ 1 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives us the eigenvector ${v}_{3}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{aligned}],\\,P=[\\begin{aligned}1 & 0 & -1 \\\\ -1 & 1 & 1 \\\\ 1 & 1 & 0\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-31a726a9-a1c8-58dd-882f-1cff70681cf5"] :db/ensure [:question/validate]} {:db/id "answer-field-31a726a9-a1c8-58dd-882f-1cff70681cf5" :answer-field/id #uuid "31a726a9-a1c8-58dd-882f-1cff70681cf5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8bd25d24-ca14-582c-9c9a-901bf68be589" :answer-field/choices ["answer-e52bd489-6e03-5706-aa17-622a610be235" "answer-8bd25d24-ca14-582c-9c9a-901bf68be589" "answer-a5c7091e-e210-5867-884f-ccfde76bb619" "answer-aabbbcda-6626-588e-9857-4b315ea6b330" "answer-999a115a-08e8-5499-8e87-7c47414d8221"] :db/ensure [:answer-field/validate]} {:db/id "answer-e52bd489-6e03-5706-aa17-622a610be235" :answer/id #uuid "e52bd489-6e03-5706-aa17-622a610be235" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}1 & -2 & -1 \\\\ -1 & 1 & 2 \\\\ -1 & 1 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-8bd25d24-ca14-582c-9c9a-901bf68be589" :answer/id #uuid "8bd25d24-ca14-582c-9c9a-901bf68be589" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}1 & 0 & -1 \\\\ -1 & 1 & 1 \\\\ 1 & 1 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-a5c7091e-e210-5867-884f-ccfde76bb619" :answer/id #uuid "a5c7091e-e210-5867-884f-ccfde76bb619" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}1 & 1 & -1 \\\\ -1 & 1 & 0 \\\\ 1 & 1 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-aabbbcda-6626-588e-9857-4b315ea6b330" :answer/id #uuid "aabbbcda-6626-588e-9857-4b315ea6b330" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}1 & 2 & -1 \\\\ -1 & 3 & 1 \\\\ 1 & -2 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-999a115a-08e8-5499-8e87-7c47414d8221" :answer/id #uuid "999a115a-08e8-5499-8e87-7c47414d8221" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 3\\end{aligned}]$ and $P=[\\begin{aligned}2 & 0 & -1 \\\\ -1 & 1 & 1 \\\\ 2 & 1 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "question-c742c85e-0648-5cd9-8c31-bb35257f03e2" :question/id #uuid "c742c85e-0648-5cd9-8c31-bb35257f03e2" :question/math-academy-id "q-84609" :question/problem "$$\nA=[\\begin{aligned}-3 & 2 & 1 \\\\ 0 & 4 & 7 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\nThe matrix $A$ has eigenvalues ${\\lambda }_{1}=-3,$ ${\\lambda }_{2}=4,$ and ${\\lambda }_{3}=1.$\nFind a diagonal matrix $D$ and an invertible matrix $P$ such that $D={P}^{-1}AP.$" :question/worked-solution "We apply the diagonalization algorithm.\n\n**Step 1.**  Notice that we are already given the eigenvalues of the matrix: \n\n$\\,$ ${\\lambda }_{1}=-3,\\,$ ${\\lambda }_{2}=4,\\,$ ${\\lambda }_{3}=1.$ \n\n**Step 2.** Now, we need to find an eigenvector basis of $A.$ Applying our usual method, we get the following. \n\n- For ${\\lambda }_{1}=-3,$ we get \n\n$$\n\\begin{aligned}A-(-3)I & =[\\begin{aligned}0 & 2 & 1 \\\\ 0 & 7 & 7 \\\\ 0 & 0 & 4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-3)I)x=0$ gives us the eigenvector  ${v}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=4,$ we get\n\n$$\n\\begin{aligned}A-4I & =[\\begin{aligned}-7 & 2 & 1 \\\\ 0 & 0 & 7 \\\\ 0 & 0 & -3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives us the eigenvector  ${v}_{2}=[\\begin{aligned}2 \\\\ 7 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{3}=1,$ we get\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}-4 & 2 & 1 \\\\ 0 & 3 & 7 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives us the eigenvector ${v}_{3}=[\\begin{aligned}-11 \\\\ -28 \\\\ 12\\end{aligned}].$\n\n**Step 3.** We construct the diagonal matrix $D$ and the invertible matrix $P$ in the usual way, and this gives us the following:\n\n$$\nD=[\\begin{aligned}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,P=[\\begin{aligned}1 & 2 & -11 \\\\ 0 & 7 & -28 \\\\ 0 & 0 & 12\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e015e886-af0c-50c8-80c7-dbd3c9879cf2"] :db/ensure [:question/validate]} {:db/id "answer-field-e015e886-af0c-50c8-80c7-dbd3c9879cf2" :answer-field/id #uuid "e015e886-af0c-50c8-80c7-dbd3c9879cf2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72fd09c1-79de-56af-8b54-d3b0e35dbc32" :answer-field/choices ["answer-87bb53d7-fc61-5729-a383-3a8cc7ab4af0" "answer-5d535dfb-87df-5251-bb7b-1b059f15fcc8" "answer-72fd09c1-79de-56af-8b54-d3b0e35dbc32" "answer-18548cc4-5579-5860-af3c-2ffb7473c802" "answer-900bcbf4-f190-5da3-839e-ba5e69558818"] :db/ensure [:answer-field/validate]} {:db/id "answer-87bb53d7-fc61-5729-a383-3a8cc7ab4af0" :answer/id #uuid "87bb53d7-fc61-5729-a383-3a8cc7ab4af0" :answer/type :answer.type/text :answer/value "$A$ is not diagonalizable" :db/ensure [:answer/validate]} {:db/id "answer-5d535dfb-87df-5251-bb7b-1b059f15fcc8" :answer/id #uuid "5d535dfb-87df-5251-bb7b-1b059f15fcc8" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 0 & -11 \\\\ 0 & 7 & 8 \\\\ 0 & 2 & 12\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-72fd09c1-79de-56af-8b54-d3b0e35dbc32" :answer/id #uuid "72fd09c1-79de-56af-8b54-d3b0e35dbc32" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 2 & -11 \\\\ 0 & 7 & -28 \\\\ 0 & 0 & 12\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-18548cc4-5579-5860-af3c-2ffb7473c802" :answer/id #uuid "18548cc4-5579-5860-af3c-2ffb7473c802" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 2 & -11 \\\\ 1 & 0 & -28 \\\\ 1 & -1 & 12\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-900bcbf4-f190-5da3-839e-ba5e69558818" :answer/id #uuid "900bcbf4-f190-5da3-839e-ba5e69558818" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}1 & 2 & -2 \\\\ 0 & 7 & -11 \\\\ 0 & 0 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id 17592186119980 :knowledge-point/questions ["question-6b5a16e8-c13d-51bd-9dfe-f5d38efff2fe" "question-7358da91-8014-5776-8731-ceb0c31740d0" "question-e1a63430-5da8-52e4-a931-6317cfed822f" "question-502c15a4-2b20-54ef-9a03-875448a388c3" "question-1b76a888-c386-580d-abe0-7db8002d6871"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119879 :knowledge-point/questions ["question-94efa4a2-1092-5b11-ab4d-7217c29637ba" "question-d15da025-4086-5540-bf68-ef7b03d66ed0" "question-7c945750-33b2-55ee-8335-b093fb35e399"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119981 :knowledge-point/questions ["question-626ec44a-73a5-5e9b-9066-3e6a39d1e10e" "question-8f6b1824-8799-5b59-8e80-5a3b112af87a" "question-32ebf6aa-8547-5777-9834-260892a9ca32"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119982 :knowledge-point/questions ["question-3643194d-d38f-5e28-b2ac-1e1d3a327966" "question-fa2f9f9d-09dc-55fa-a8fa-ab5f37e6b68d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6b5a16e8-c13d-51bd-9dfe-f5d38efff2fe" :question/id #uuid "6b5a16e8-c13d-51bd-9dfe-f5d38efff2fe" :question/math-academy-id "q-129153" :question/problem "Calculate ${\\int }_{0}^{1}[f(t)+2g(t)]\\,\\text{d}t$ given that ${\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨-3,\\,\\operatorname{sin}⁡1,\\,-1⟩$ and ${\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨5,\\,1,\\,-2⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{1}[f(t)+2g(t)]\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t+2{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[f(t)+2g(t)]\\,\\text{d}t & ={\\int }_{0}^{1}f(t)\\,\\text{d}t+2{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =⟨-3,\\,\\operatorname{sin}⁡1,\\,-1⟩+2⟨5,\\,1,\\,-2⟩ \\\\  & =⟨-3,\\,\\operatorname{sin}⁡1,\\,-1⟩+⟨10,\\,2,\\,-4⟩ \\\\  & =⟨7,\\,2+\\operatorname{sin}⁡1,\\,-5⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b72707b5-f227-559d-89e2-3f13870c731c"] :db/ensure [:question/validate]} {:db/id "answer-field-b72707b5-f227-559d-89e2-3f13870c731c" :answer-field/id #uuid "b72707b5-f227-559d-89e2-3f13870c731c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-914182cd-3787-5ba7-8176-7b2df3b7cfec" :answer-field/choices ["answer-3c597f72-e2b6-5736-9cd8-4ad441b0c2f8" "answer-828589a5-0183-58fd-a085-df2a11c90c0b" "answer-099c360b-8d79-50ca-9ab9-2be6125f91dd" "answer-914182cd-3787-5ba7-8176-7b2df3b7cfec" "answer-7c063c86-1d05-5b52-a510-8eb27c05d936"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c597f72-e2b6-5736-9cd8-4ad441b0c2f8" :answer/id #uuid "3c597f72-e2b6-5736-9cd8-4ad441b0c2f8" :answer/type :answer.type/math :answer/value "⟨1,\\,2\\operatorname{sin}⁡1,\\,-4⟩" :db/ensure [:answer/validate]} {:db/id "answer-828589a5-0183-58fd-a085-df2a11c90c0b" :answer/id #uuid "828589a5-0183-58fd-a085-df2a11c90c0b" :answer/type :answer.type/math :answer/value "⟨4,\\,\\operatorname{sin}⁡1-1,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-099c360b-8d79-50ca-9ab9-2be6125f91dd" :answer/id #uuid "099c360b-8d79-50ca-9ab9-2be6125f91dd" :answer/type :answer.type/math :answer/value "⟨5,\\,2-\\operatorname{sin}⁡1,\\,-3⟩" :db/ensure [:answer/validate]} {:db/id "answer-914182cd-3787-5ba7-8176-7b2df3b7cfec" :answer/id #uuid "914182cd-3787-5ba7-8176-7b2df3b7cfec" :answer/type :answer.type/math :answer/value "⟨7,\\,2+\\operatorname{sin}⁡1,\\,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-7c063c86-1d05-5b52-a510-8eb27c05d936" :answer/id #uuid "7c063c86-1d05-5b52-a510-8eb27c05d936" :answer/type :answer.type/math :answer/value "⟨7,\\,2-\\operatorname{sin}⁡1,\\,3⟩" :db/ensure [:answer/validate]} {:db/id "question-7358da91-8014-5776-8731-ceb0c31740d0" :question/id #uuid "7358da91-8014-5776-8731-ceb0c31740d0" :question/math-academy-id "q-129138" :question/problem "Calculate \n${\\int }_{-1}^{3}[\\frac{1}{3}f(t)+2g(t)]\\text{d}t$ \ngiven that \n${\\int }_{-1}^{3}f(t)\\,\\text{d}t=⟨-3,\\,6,\\,3⟩$\nand \n${\\int }_{-1}^{3}g(t)\\,\\text{d}t=⟨-\\frac{1}{2},\\,1,\\,-1⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{-1}^{3}[\\frac{1}{3}f(t)+2g(t)]\\text{d}t=\\frac{1}{3}{\\int }_{-1}^{3}f(t)\\,\\text{d}t+2{\\int }_{-1}^{3}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}[\\frac{1}{3}f(t)+2g(t)]\\,\\text{d}t & =\\frac{1}{3}{\\int }_{-1}^{3}f(t)\\,\\text{d}t+2{\\int }_{-1}^{3}g(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}⟨-3,\\,6,\\,3⟩+2⟨-\\frac{1}{2},\\,1,\\,-1⟩ \\\\  & =⟨-1,\\,2,\\,1⟩+⟨-1,\\,2,\\,-2⟩ \\\\  & =⟨-2,\\,4,\\,-1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-000a1a27-f460-5054-86af-d91e26cdbeb2"] :db/ensure [:question/validate]} {:db/id "answer-field-000a1a27-f460-5054-86af-d91e26cdbeb2" :answer-field/id #uuid "000a1a27-f460-5054-86af-d91e26cdbeb2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5e41bba6-7a1e-51af-b804-b4199f30ad81" :answer-field/choices ["answer-b6af2053-91f7-5fc0-ae28-3fd48c8ccfc0" "answer-d6c10b3b-7a99-5634-b41c-28b71c6d4af9" "answer-d572ae69-499e-5678-b918-b83014a1f184" "answer-5e41bba6-7a1e-51af-b804-b4199f30ad81" "answer-ff95084a-aa85-5f90-a078-a4d05c8efe2e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6af2053-91f7-5fc0-ae28-3fd48c8ccfc0" :answer/id #uuid "b6af2053-91f7-5fc0-ae28-3fd48c8ccfc0" :answer/type :answer.type/math :answer/value "⟨-1,\\,2,\\,4⟩" :db/ensure [:answer/validate]} {:db/id "answer-d6c10b3b-7a99-5634-b41c-28b71c6d4af9" :answer/id #uuid "d6c10b3b-7a99-5634-b41c-28b71c6d4af9" :answer/type :answer.type/math :answer/value "⟨-2,\\,0,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-d572ae69-499e-5678-b918-b83014a1f184" :answer/id #uuid "d572ae69-499e-5678-b918-b83014a1f184" :answer/type :answer.type/math :answer/value "⟨-2,\\,2,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-5e41bba6-7a1e-51af-b804-b4199f30ad81" :answer/id #uuid "5e41bba6-7a1e-51af-b804-b4199f30ad81" :answer/type :answer.type/math :answer/value "⟨-2,\\,4,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-ff95084a-aa85-5f90-a078-a4d05c8efe2e" :answer/id #uuid "ff95084a-aa85-5f90-a078-a4d05c8efe2e" :answer/type :answer.type/math :answer/value "⟨-4,\\,2,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "question-e1a63430-5da8-52e4-a931-6317cfed822f" :question/id #uuid "e1a63430-5da8-52e4-a931-6317cfed822f" :question/math-academy-id "q-32519" :question/problem "Calculate ${\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t$ given that ${\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨\\frac{1}{2},\\,2,\\,1⟩$ and ${\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨1,\\,1,\\,1⟩.$" :question/worked-solution "From the vector addition rule, we have\n\n$$\n{\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t & ={\\int }_{0}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =⟨\\frac{1}{2},\\,2,\\,1⟩-⟨1,\\,1,\\,1⟩ \\\\  & =⟨-\\frac{1}{2},\\,1,\\,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c6623d6a-9f94-55b1-b5f7-74a8972e6cf4"] :db/ensure [:question/validate]} {:db/id "answer-field-c6623d6a-9f94-55b1-b5f7-74a8972e6cf4" :answer-field/id #uuid "c6623d6a-9f94-55b1-b5f7-74a8972e6cf4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1146d883-a7d0-500e-85d1-a9739b8a93e3" :answer-field/choices ["answer-1a5cfa15-9edb-5bf2-8ed6-6b4167cccdde" "answer-1146d883-a7d0-500e-85d1-a9739b8a93e3" "answer-02e12455-ce2d-515b-a4e0-f7b221799cd0" "answer-da1a28dc-d313-56b1-867b-e689ed2fee2d" "answer-1ae3ed05-ae40-50dc-b45c-9233daa36cf0"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a5cfa15-9edb-5bf2-8ed6-6b4167cccdde" :answer/id #uuid "1a5cfa15-9edb-5bf2-8ed6-6b4167cccdde" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{2},\\,-\\frac{1}{2},\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-1146d883-a7d0-500e-85d1-a9739b8a93e3" :answer/id #uuid "1146d883-a7d0-500e-85d1-a9739b8a93e3" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{2},\\,1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-02e12455-ce2d-515b-a4e0-f7b221799cd0" :answer/id #uuid "02e12455-ce2d-515b-a4e0-f7b221799cd0" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{2},\\,\\frac{1}{2},\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-da1a28dc-d313-56b1-867b-e689ed2fee2d" :answer/id #uuid "da1a28dc-d313-56b1-867b-e689ed2fee2d" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{2},\\,-1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-1ae3ed05-ae40-50dc-b45c-9233daa36cf0" :answer/id #uuid "1ae3ed05-ae40-50dc-b45c-9233daa36cf0" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{2},\\,1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "question-502c15a4-2b20-54ef-9a03-875448a388c3" :question/id #uuid "502c15a4-2b20-54ef-9a03-875448a388c3" :question/math-academy-id "q-129152" :question/problem "Calculate ${\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t$ given that ${\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨-\\frac{1}{4},\\,-\\frac{3}{2},\\,-2⟩$ and ${\\int }_{1}^{3}g(t)\\,\\text{d}t=⟨\\frac{2}{3},\\,-1,\\,2⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t=4{\\int }_{1}^{3}f(t)\\,\\text{d}t-3{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t & =4{\\int }_{1}^{3}f(t)\\,\\text{d}t-3{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =4⟨-\\frac{1}{4},\\,-\\frac{3}{2},\\,-2⟩-3⟨\\frac{2}{3},\\,-1,\\,2⟩ \\\\  & =⟨-1,\\,-6,\\,-8⟩-⟨2,\\,-3,\\,6⟩ \\\\  & =⟨-3,\\,-3,\\,-14⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0bd20933-4707-5b47-8e83-30dc4abf3031"] :db/ensure [:question/validate]} {:db/id "answer-field-0bd20933-4707-5b47-8e83-30dc4abf3031" :answer-field/id #uuid "0bd20933-4707-5b47-8e83-30dc4abf3031" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c27ac7a2-3ca9-59a9-a856-170e1f39ded5" :answer-field/choices ["answer-69245a2b-24ad-57f6-b7b2-9025bc32aa3a" "answer-c27ac7a2-3ca9-59a9-a856-170e1f39ded5" "answer-90811072-dc3c-55b9-bba4-9fd3bbbf2d7e" "answer-89b404f6-abb3-55f4-987d-b91201cfbab7" "answer-5bd28227-284a-5a33-8f08-23296c53f5df"] :db/ensure [:answer-field/validate]} {:db/id "answer-69245a2b-24ad-57f6-b7b2-9025bc32aa3a" :answer/id #uuid "69245a2b-24ad-57f6-b7b2-9025bc32aa3a" :answer/type :answer.type/math :answer/value "⟨-1,\\,0,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-c27ac7a2-3ca9-59a9-a856-170e1f39ded5" :answer/id #uuid "c27ac7a2-3ca9-59a9-a856-170e1f39ded5" :answer/type :answer.type/math :answer/value "⟨-3,\\,-3,\\,-14⟩" :db/ensure [:answer/validate]} {:db/id "answer-90811072-dc3c-55b9-bba4-9fd3bbbf2d7e" :answer/id #uuid "90811072-dc3c-55b9-bba4-9fd3bbbf2d7e" :answer/type :answer.type/math :answer/value "⟨0,\\,\\frac{3}{2},\\,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-89b404f6-abb3-55f4-987d-b91201cfbab7" :answer/id #uuid "89b404f6-abb3-55f4-987d-b91201cfbab7" :answer/type :answer.type/math :answer/value "⟨4,\\,1,\\,\\frac{1}{3}⟩" :db/ensure [:answer/validate]} {:db/id "answer-5bd28227-284a-5a33-8f08-23296c53f5df" :answer/id #uuid "5bd28227-284a-5a33-8f08-23296c53f5df" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{4},\\,-3,\\,-14⟩" :db/ensure [:answer/validate]} {:db/id "question-1b76a888-c386-580d-abe0-7db8002d6871" :question/id #uuid "1b76a888-c386-580d-abe0-7db8002d6871" :question/math-academy-id "q-98163" :question/problem "Calculate ${\\int }_{0}^{1}[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)]\\,\\text{d}t$ given that ${\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨3,\\,6,\\,-3⟩$ and ${\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨4,\\,2,\\,10⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{1}[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)]\\,\\text{d}t=\\frac{2}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t+\\frac{1}{2}{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)]\\,\\text{d}t & =\\frac{2}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t+\\frac{1}{2}{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =\\frac{2}{3}⟨3,\\,6,\\,-3⟩+\\frac{1}{2}⟨4,\\,2,\\,10⟩ \\\\  & =⟨2,\\,4,\\,-2⟩+⟨2,\\,1,\\,5⟩ \\\\  & =⟨4,\\,5,\\,3⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5d3e9841-7ba0-53f6-959d-76e8dffb6e00"] :db/ensure [:question/validate]} {:db/id "answer-field-5d3e9841-7ba0-53f6-959d-76e8dffb6e00" :answer-field/id #uuid "5d3e9841-7ba0-53f6-959d-76e8dffb6e00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5585ea1a-956a-530b-bd90-d0d4394646d5" :answer-field/choices ["answer-ef5d7403-6a5c-5a33-afde-3d0beaeb0501" "answ