{2}" :db/ensure [:answer/validate]} {:db/id "answer-1e7eaeed-81ae-5102-ae70-6d3c1429de0a" :answer/id #uuid "1e7eaeed-81ae-5102-ae70-6d3c1429de0a" :answer/type :answer.type/math :answer/value "{\\text{m}}^{3}" :db/ensure [:answer/validate]} {:db/id "question-8fb5e9af-e049-58bc-a3a8-cb559a30bfa8" :question/id #uuid "8fb5e9af-e049-58bc-a3a8-cb559a30bfa8" :question/math-academy-id "q-144163" :question/problem "Suppose Louis wants to measure the area of a stadium. What units could he use?" :question/worked-solution "We can measure length in kilometers $(\\text{km}).$ When measuring lengths in kilometers, areas are measured in $\\text{km}\\times \\text{km},$ which is usually written as ${\\text{km}}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f45e58c1-8d47-50d3-baa2-f7865489830b"] :db/ensure [:question/validate]} {:db/id "answer-field-f45e58c1-8d47-50d3-baa2-f7865489830b" :answer-field/id #uuid "f45e58c1-8d47-50d3-baa2-f7865489830b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b259fc78-69ac-5313-acb1-268c3ea8a7aa" :answer-field/choices ["answer-a9cc377f-19c9-5882-88ca-4aff41e2029b" "answer-5dba24ec-dd98-5c6f-8312-4f7afc7ad16e" "answer-a08aac58-a7d0-560b-8da2-0b7b74c2279f" "answer-b259fc78-69ac-5313-acb1-268c3ea8a7aa" "answer-fbe9d1f0-e273-5a08-9d80-4229ce47e5da"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9cc377f-19c9-5882-88ca-4aff41e2029b" :answer/id #uuid "a9cc377f-19c9-5882-88ca-4aff41e2029b" :answer/type :answer.type/math :answer/value "\\text{km}" :db/ensure [:answer/validate]} {:db/id "answer-5dba24ec-dd98-5c6f-8312-4f7afc7ad16e" :answer/id #uuid "5dba24ec-dd98-5c6f-8312-4f7afc7ad16e" :answer/type :answer.type/math :answer/value "{\\text{kg}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a08aac58-a7d0-560b-8da2-0b7b74c2279f" :answer/id #uuid "a08aac58-a7d0-560b-8da2-0b7b74c2279f" :answer/type :answer.type/math :answer/value "{\\text{kg}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-b259fc78-69ac-5313-acb1-268c3ea8a7aa" :answer/id #uuid "b259fc78-69ac-5313-acb1-268c3ea8a7aa" :answer/type :answer.type/math :answer/value "{\\text{km}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-fbe9d1f0-e273-5a08-9d80-4229ce47e5da" :answer/id #uuid "fbe9d1f0-e273-5a08-9d80-4229ce47e5da" :answer/type :answer.type/math :answer/value "{\\text{km}}^{3}" :db/ensure [:answer/validate]} {:db/id "question-f5553ee3-dc39-5b5b-a789-1fa3544d8ee9" :question/id #uuid "f5553ee3-dc39-5b5b-a789-1fa3544d8ee9" :question/math-academy-id "q-144168" :question/problem "![](images/17/171e55cb16b67bba62ca0a1e85c54ca2cb8fc10e8284b9ca7fdcf9ddd3862502.png)\n\nWhat is the area of the square above?" :question/worked-solution "To calculate the area $A$ of a square, we square its side length. Therefore, the area of the square is\n\n$$\n\\begin{aligned}A & =(2\\,\\text{m})^{2} \\\\  & =2\\,\\text{m}\\times 2\\,\\text{m} \\\\  & =(2\\times 2)\\times (\\text{m}\\times \\text{m}) \\\\  & =4\\,{\\text{m}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9124d272-0d22-50a0-8feb-a054073a0bb9"] :db/ensure [:question/validate]} {:db/id "answer-field-9124d272-0d22-50a0-8feb-a054073a0bb9" :answer-field/id #uuid "9124d272-0d22-50a0-8feb-a054073a0bb9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-38f32a28-3ae3-5a25-b3d7-98af7cdc16f6" :answer-field/choices ["answer-c175b835-44d6-504f-a6dc-eb2b9864e0f7" "answer-38f32a28-3ae3-5a25-b3d7-98af7cdc16f6" "answer-c0e47b72-0a77-50c4-b261-f65b1a0e93db" "answer-f7f3b5a1-c57c-5baa-81c4-d2e584075566" "answer-940670f3-7bec-58b8-a7ac-83015199b219"] :db/ensure [:answer-field/validate]} {:db/id "answer-c175b835-44d6-504f-a6dc-eb2b9864e0f7" :answer/id #uuid "c175b835-44d6-504f-a6dc-eb2b9864e0f7" :answer/type :answer.type/math :answer/value "4\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-38f32a28-3ae3-5a25-b3d7-98af7cdc16f6" :answer/id #uuid "38f32a28-3ae3-5a25-b3d7-98af7cdc16f6" :answer/type :answer.type/math :answer/value "4\\,{\\text{m}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c0e47b72-0a77-50c4-b261-f65b1a0e93db" :answer/id #uuid "c0e47b72-0a77-50c4-b261-f65b1a0e93db" :answer/type :answer.type/math :answer/value "4\\,{\\text{m}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-f7f3b5a1-c57c-5baa-81c4-d2e584075566" :answer/id #uuid "f7f3b5a1-c57c-5baa-81c4-d2e584075566" :answer/type :answer.type/math :answer/value "8\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-940670f3-7bec-58b8-a7ac-83015199b219" :answer/id #uuid "940670f3-7bec-58b8-a7ac-83015199b219" :answer/type :answer.type/math :answer/value "8\\,{\\text{m}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-fb39b2eb-47b9-5a51-a1e6-e73d5767fa62" :question/id #uuid "fb39b2eb-47b9-5a51-a1e6-e73d5767fa62" :question/math-academy-id "q-144175" :question/problem "![](images/3a/3aa2dddfc1bf79c13c80295e5d732f7c876ec7dea316920df8b275e983dc137a.png)\n\nWhat is the area of the square above?" :question/worked-solution "To calculate the area $A$ of a square, we square its side length. Therefore, the area of the square is\n\n$$\n\\begin{aligned}A & =(12\\,\\text{in})^{2} \\\\  & =12\\,\\text{in}\\times 12\\,\\text{in} \\\\  & =(12\\times 12)\\times (\\text{in}\\times \\text{in}) \\\\  & =144\\,{\\text{in}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8010bacb-bb38-541e-babd-73190c4068f2"] :db/ensure [:question/validate]} {:db/id "answer-field-8010bacb-bb38-541e-babd-73190c4068f2" :answer-field/id #uuid "8010bacb-bb38-541e-babd-73190c4068f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0bdd127f-8213-56de-8191-b3658a15b6a6" :answer-field/choices ["answer-88a2ed92-1980-5ecf-806f-06a313a9284d" "answer-0bdd127f-8213-56de-8191-b3658a15b6a6" "answer-651ec824-