\,5⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cc3a5736-f96e-55b4-864e-ba44639fb795"] :db/ensure [:question/validate]} {:db/id "answer-field-cc3a5736-f96e-55b4-864e-ba44639fb795" :answer-field/id #uuid "cc3a5736-f96e-55b4-864e-ba44639fb795" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9464c6ad-168e-5179-840b-9053f64899f5" :answer-field/choices ["answer-5714a523-c7e0-5289-94e6-462b12492695" "answer-9464c6ad-168e-5179-840b-9053f64899f5" "answer-ec643ad8-5f51-5a97-8641-8e98e75405ae" "answer-9f718c4a-ab8c-5bba-b7ac-1d92388c4df8" "answer-696ef75d-40fc-571f-84fb-862da878c3f8"] :db/ensure [:answer-field/validate]} {:db/id "answer-5714a523-c7e0-5289-94e6-462b12492695" :answer/id #uuid "5714a523-c7e0-5289-94e6-462b12492695" :answer/type :answer.type/math :answer/value "⟨-5e,\\,{e}^{2},\\,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-9464c6ad-168e-5179-840b-9053f64899f5" :answer/id #uuid "9464c6ad-168e-5179-840b-9053f64899f5" :answer/type :answer.type/math :answer/value "⟨5e,\\,-5{e}^{2},\\,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-ec643ad8-5f51-5a97-8641-8e98e75405ae" :answer/id #uuid "ec643ad8-5f51-5a97-8641-8e98e75405ae" :answer/type :answer.type/math :answer/value "⟨5e,\\,-{e}^{2},\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-9f718c4a-ab8c-5bba-b7ac-1d92388c4df8" :answer/id #uuid "9f718c4a-ab8c-5bba-b7ac-1d92388c4df8" :answer/type :answer.type/math :answer/value "⟨e,\\,-{e}^{2},\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-696ef75d-40fc-571f-84fb-862da878c3f8" :answer/id #uuid "696ef75d-40fc-571f-84fb-862da878c3f8" :answer/type :answer.type/math :answer/value "⟨e,\\,-{e}^{2},\\,5⟩" :db/ensure [:answer/validate]} {:db/id "question-d15da025-4086-5540-bf68-ef7b03d66ed0" :question/id #uuid "d15da025-4086-5540-bf68-ef7b03d66ed0" :question/math-academy-id "q-129267" :question/problem "Calculate \n${\\int }_{0}^{2}\\frac{3}{2}f(t)+⟨2,\\,-1,\\,-2⟩\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨10,\\,4,\\,-2⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨10,\\,4,\\,-2⟩ \\\\  & =⟨-10,\\,-4,\\,2⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{3}{2}f(t)+⟨2,\\,-1,\\,-2⟩\\,\\text{d}t & =\\frac{3}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{0}^{2}⟨2,\\,-1,\\,-2⟩\\,\\text{d}t \\\\  & =\\frac{3}{2}⟨-10,\\,-4,\\,2⟩+⟨2t,\\,-t,\\,-2t⟩{|}_{0}^{2} \\\\  & =⟨-15,\\,-6,\\,3⟩+⟨4,\\,-2,\\,-4⟩\\text{ } \\\\  & =⟨-11,\\,-8,\\,-1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1308c15-7029-5977-ab04-e6696324bf2e"] :db/ensure [:question/validate]} {:db/id "answer-field-b1308c15-7029-5977-ab04-e6696324bf2e" :answer-field/id #uuid "b1308c15-7029-5977-ab04-e6696324bf2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d93cf475-1ae2-5321-9a8e-2e0fe7d7081a" :answer-field/choices ["answer-d93cf475-1ae2-5321-9a8e-2e0fe7d7081a" "answer-135bac11-41ed-59ad-b6c8-1343251771ce" "answer-12c5e775-8496-55d3-8f65-268ac9b8e381" "answer-8aba1948-9fd4-5c28-a5cd-bd2af2e7e0d2" "answer-38cfb223-211f-57cc-a3de-2b0e4a4513d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-d93cf475-1ae2-5321-9a8e-2e0fe7d7081a" :answer/id #uuid "d93cf475-1ae2-5321-9a8e-2e0fe7d7081a" :answer/type :answer.type/math :answer/value "⟨-11,\\,-8,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-135bac11-41ed-59ad-b6c8-1343251771ce" :answer/id #uuid "135bac11-41ed-59ad-b6c8-1343251771ce" :answer/type :answer.type/math :answer/value "⟨-15,\\,-8,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-12c5e775-8496-55d3-8f65-268ac9b8e381" :answer/id #uuid "12c5e775-8496-55d3-8f65-268ac9b8e381" :answer/type :answer.type/math :answer/value "⟨-5,\\,-2,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-8aba1948-9fd4-5c28-a5cd-bd2af2e7e0d2" :answer/id #uuid "8aba1948-9fd4-5c28-a5cd-bd2af2e7e0d2" :answer/type :answer.type/math :answer/value "⟨-5,\\,-5,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-38cfb223-211f-57cc-a3de-2b0e4a4513d2" :answer/id #uuid "38cfb223-211f-57cc-a3de-2b0e4a4513d2" :answer/type :answer.type/math :answer/value "⟨11,\\,-6,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "question-7c945750-33b2-55ee-8335-b093fb35e399" :question/id #uuid "7c945750-33b2-55ee-8335-b093fb35e399" :question/math-academy-id "q-98175" :question/problem "Calculate \n${\\int }_{1}^{0}2f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨e-1,\\,1,\\,\\operatorname{sin}⁡1⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{0}f(t)\\,\\text{d}t & =-{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =-⟨e-1,\\,1,\\,\\operatorname{sin}⁡1⟩ \\\\  & =⟨1-e,\\,-1,\\,-\\operatorname{sin}⁡1⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{0}f(t)\\,\\text{d}t & =2{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =2\\cdot ⟨1-e,\\,-1,\\,-\\operatorname{sin}⁡1⟩ \\\\  & =⟨2-2e,\\,-2,\\,-2\\operatorname{sin}⁡1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e99b453b-e56a-5891-a94b-5ab07ced0185"] :db/ensure [:question/validate]} {:db/id "answer-field-e99b453b-e56a-5891-a94b-5ab07ced0185" :answer-field/id #uuid "e99b453b-e56a-5891-a94b-5ab07ced0185" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04f5cd10-e0d7-57e3-b37b-c7277d7967b7" :answer-field/choices ["answer-64d609a5-b42c-5819-9f23-9a68661c02f5" "answer-c6ce769e-fca1-572e-bc08-de9b48d68f68" "answer-04f5cd10-e0d7-57e3-b37b-c7277d7967b7" "answer-9f3a2734-32e4-58a6-a431-c5f9c9066c7d" "answer-fa1541f3-35cb-5c6a-9b25-9a85e9ec70da"] :db/ensure [:answer-field/validate]} {:db/id "answer-64d609a5-b42c-5819-9f23-9a68661c02f5" :answer/id #uuid "64d609a5-b42c-5819-9f23-9a68661c02f5" :answer/type :answer.type/math :answer/value "⟨1-e,\\,-2,\\,-2\\operatorname{sin}⁡1⟩" :db/ensure [:answer/validate]} {:db/id "answer-c6ce769e-fca1-572e-bc08-de9b48d68f68" :answer/id #uuid "c6ce769e-fca1-572e-bc08-de9b48d68f68" :answer/type :answer.type/math :answer/value "⟨2-2e,\\,-1,\\,-\\operatorname{sin}⁡1⟩" :db/ensure [:answer/validate]} {:db/id "answer-04f5cd10-e0d7-57e3-b37b-c7277d7967b7" :answer/id #uuid "04f5cd10-e0d7-57e3-b37b-c7277d7967b7" :answer/type :answer.type/math :answer/value "⟨2-2e,\\,-2,\\,-2\\operatorname{sin}⁡1⟩" :db/ensure [:answer/validate]} {:db/id "answer-9f3a2734-32e4-58a6-a431-c5f9c9066c7d" :answer/id #uuid "9f3a2734-32e4-58a6-a431-c5f9c9066c7d" :answer/type :answer.type/math :answer/value "⟨2e-2,\\,2,\\,2\\operatorname{sin}⁡1⟩" :db/ensure [:answer/validate]} {:db/id "answer-fa1541f3-35cb-5c6a-9b25-9a85e9ec70da" :answer/id #uuid "fa1541f3-35cb-5c6a-9b25-9a85e9ec70da" :answer/type :answer.type/math :answer/value "⟨4-2e,\\,-4,\\,-4\\operatorname{sin}⁡1⟩" :db/ensure [:answer/validate]} {:db/id "question-626ec44a-73a5-5e9b-9066-3e6a39d1e10e" :question/id #uuid "626ec44a-73a5-5e9b-9066-3e6a39d1e10e" :question/math-academy-id "q-98214" :question/problem "Calculate \n${\\int }_{1}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{5}f(t)\\,\\text{d}t=⟨4,\\,2,\\,-3⟩$\nand\n${\\int }_{5}^{3}f(t)\\,\\text{d}t=⟨-1,\\,2,\\,-7⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{1}^{5}f(t)\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{3}f(t)\\,\\text{d}t={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{3}^{5}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}f(t)\\,\\text{d}t & ={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{3}^{5}f(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{5}f(t)\\,\\text{d}t+{\\int }_{5}^{3}f(t)\\,\\text{d}t \\\\  & =⟨4,\\,2,\\,-3⟩+⟨-1,\\,2,\\,-7⟩ \\\\  & =⟨3,\\,4,\\,-10⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-33fb8190-7136-5506-82eb-66d810eb8bff"] :db/ensure [:question/validate]} {:db/id "answer-field-33fb8190-7136-5506-82eb-66d810eb8bff" :answer-field/id #uuid "33fb8190-7136-5506-82eb-66d810eb8bff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-578eb711-ef7a-54c1-8019-eb596a2fb432" :answer-field/choices ["answer-c29dcc86-ffa8-5da8-9d41-89ae34e0f54c" "answer-49e44c92-7452-54f7-8420-600f512551e2" "answer-8237db08-8e1f-5711-9993-6c4d8cc3d90d" "answer-578eb711-ef7a-54c1-8019-eb596a2fb432" "answer-eb207235-b36d-5126-9eb2-a84c0188faec"] :db/ensure [:answer-field/validate]} {:db/id "answer-c29dcc86-ffa8-5da8-9d41-89ae34e0f54c" :answer/id #uuid "c29dcc86-ffa8-5da8-9d41-89ae34e0f54c" :answer/type :answer.type/math :answer/value "⟨-3,\\,0,\\,-4⟩" :db/ensure [:answer/validate]} {:db/id "answer-49e44c92-7452-54f7-8420-600f512551e2" :answer/id #uuid "49e44c92-7452-54f7-8420-600f512551e2" :answer/type :answer.type/math :answer/value "⟨-5,\\,2,\\,-10⟩" :db/ensure [:answer/validate]} {:db/id "answer-8237db08-8e1f-5711-9993-6c4d8cc3d90d" :answer/id #uuid "8237db08-8e1f-5711-9993-6c4d8cc3d90d" :answer/type :answer.type/math :answer/value "⟨3,\\,0,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-578eb711-ef7a-54c1-8019-eb596a2fb432" :answer/id #uuid "578eb711-ef7a-54c1-8019-eb596a2fb432" :answer/type :answer.type/math :answer/value "⟨3,\\,4,\\,-10⟩" :db/ensure [:answer/validate]} {:db/id "answer-eb207235-b36d-5126-9eb2-a84c0188faec" :answer/id #uuid "eb207235-b36d-5126-9eb2-a84c0188faec" :answer/type :answer.type/math :answer/value "⟨5,\\,4,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "question-8f6b1824-8799-5b59-8e80-5a3b112af87a" :question/id #uuid "8f6b1824-8799-5b59-8e80-5a3b112af87a" :question/math-academy-id "q-98215" :question/problem "Calculate \n${\\int }_{4}^{5}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{4}^{7}f(t)\\,\\text{d}t=⟨3,\\,-5,\\,-6⟩$\nand\n${\\int }_{5}^{7}f(t)\\,\\text{d}t=⟨-2,\\,-9,\\,8⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{4}^{7}f(t)\\,\\text{d}t={\\int }_{4}^{5}f(t)\\,\\text{d}t+{\\int }_{5}^{7}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{4}^{5}f(t)\\,\\text{d}t={\\int }_{4}^{7}f(t)\\,\\text{d}t-{\\int }_{5}^{7}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{4}^{5}f(t)\\,\\text{d}t & ={\\int }_{4}^{7}f(t)\\,\\text{d}t-{\\int }_{5}^{7}f(t)\\,\\text{d}t \\\\  & =⟨3,\\,-5,\\,-6⟩-⟨-2,\\,-9,\\,8⟩ \\\\  & =⟨5,\\,4,\\,-14⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c7b61c43-f1a3-59ec-9526-9e6eb502bd0f"] :db/ensure [:question/validate]} {:db/id "answer-field-c7b61c43-f1a3-59ec-9526-9e6eb502bd0f" :answer-field/id #uuid "c7b61c43-f1a3-59ec-9526-9e6eb502bd0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fa4a0967-87cb-5b21-a446-a276f9858236" :answer-field/choices ["answer-b232e5cf-f1e0-5d58-9885-fe6d5aa08f1a" "answer-6107b03e-74a3-51b4-bff6-9cd58b85ad45" "answer-fa4a0967-87cb-5b21-a446-a276f9858236" "answer-db7716e1-6741-54b8-ba92-22416d6e61cd" "answer-50576fef-9cc1-59c8-9804-d67805355efc"] :db/ensure [:answer-field/validate]} {:db/id "answer-b232e5cf-f1e0-5d58-9885-fe6d5aa08f1a" :answer/id #uuid "b232e5cf-f1e0-5d58-9885-fe6d5aa08f1a" :answer/type :answer.type/math :answer/value "⟨-7,\\,-14,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-6107b03e-74a3-51b4-bff6-9cd58b85ad45" :answer/id #uuid "6107b03e-74a3-51b4-bff6-9cd58b85ad45" :answer/type :answer.type/math :answer/value "⟨5,\\,3,\\,4⟩" :db/ensure [:answer/validate]} {:db/id "answer-fa4a0967-87cb-5b21-a446-a276f9858236" :answer/id #uuid "fa4a0967-87cb-5b21-a446-a276f9858236" :answer/type :answer.type/math :answer/value "⟨5,\\,4,\\,-14⟩" :db/ensure [:answer/validate]} {:db/id "answer-db7716e1-6741-54b8-ba92-22416d6e61cd" :answer/id #uuid "db7716e1-6741-54b8-ba92-22416d6e61cd" :answer/type :answer.type/math :answer/value "⟨6,\\,5,\\,-14⟩" :db/ensure [:answer/validate]} {:db/id "answer-50576fef-9cc1-59c8-9804-d67805355efc" :answer/id #uuid "50576fef-9cc1-59c8-9804-d67805355efc" :answer/type :answer.type/math :answer/value "⟨7,\\,4,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "question-32ebf6aa-8547-5777-9834-260892a9ca32" :question/id #uuid "32ebf6aa-8547-5777-9834-260892a9ca32" :question/math-academy-id "q-129274" :question/problem "Calculate \n${\\int }_{2}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-6,\\,4⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨9,\\,9,\\,-6⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{2}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{2}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}f(t)\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t-(-{\\int }_{2}^{0}f(t)\\,\\text{d}t) \\\\  & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =⟨9,\\,9,\\,-6⟩+⟨-4,\\,-6,\\,4⟩ \\\\  & =⟨5,\\,3,\\,-2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0b926433-52e8-50f6-bf33-fa54c61d9250"] :db/ensure [:question/validate]} {:db/id "answer-field-0b926433-52e8-50f6-bf33-fa54c61d9250" :answer-field/id #uuid "0b926433-52e8-50f6-bf33-fa54c61d9250" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-510a2381-6080-5830-8cfb-ceaa0df9ee22" :answer-field/choices ["answer-1770cd34-f70c-5405-bc7b-b9d4f95e4c22" "answer-efba41c7-5000-5054-9377-b76b30b98b78" "answer-a7c760d4-b497-537f-89c0-c6189aeab7dc" "answer-510a2381-6080-5830-8cfb-ceaa0df9ee22" "answer-e8f911cc-6f46-5833-a95c-f41133ebf040"] :db/ensure [:answer-field/validate]} {:db/id "answer-1770cd34-f70c-5405-bc7b-b9d4f95e4c22" :answer/id #uuid "1770cd34-f70c-5405-bc7b-b9d4f95e4c22" :answer/type :answer.type/math :answer/value "⟨13,\\,-3,\\,10⟩" :db/ensure [:answer/validate]} {:db/id "answer-efba41c7-5000-5054-9377-b76b30b98b78" :answer/id #uuid "efba41c7-5000-5054-9377-b76b30b98b78" :answer/type :answer.type/math :answer/value "⟨13,\\,-3,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-a7c760d4-b497-537f-89c0-c6189aeab7dc" :answer/id #uuid "a7c760d4-b497-537f-89c0-c6189aeab7dc" :answer/type :answer.type/math :answer/value "⟨5,\\,-3,\\,10⟩" :db/ensure [:answer/validate]} {:db/id "answer-510a2381-6080-5830-8cfb-ceaa0df9ee22" :answer/id #uuid "510a2381-6080-5830-8cfb-ceaa0df9ee22" :answer/type :answer.type/math :answer/value "⟨5,\\,3,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-e8f911cc-6f46-5833-a95c-f41133ebf040" :answer/id #uuid "e8f911cc-6f46-5833-a95c-f41133ebf040" :answer/type :answer.type/math :answer/value "⟨5,\\,3,\\,4⟩" :db/ensure [:answer/validate]} {:db/id "question-3643194d-d38f-5e28-b2ac-1e1d3a327966" :question/id #uuid "3643194d-d38f-5e28-b2ac-1e1d3a327966" :question/math-academy-id "q-129290" :question/problem "Find ${\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{1}^{2}f(t)\\,\\text{d}t=\\frac{\\pi }{2}\\,i+\\,j+2\\pi \\,k$ \nand \n$c=2\\,i-\\,k.$" :question/worked-solution "The dot product rule states that\n\n$$\n{\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{1}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{1}^{2}f(t)\\,\\text{d}t \\\\  & =(2\\,i-\\,k)\\cdot (\\frac{\\pi }{2}\\,i+\\,j+2\\pi \\,k) \\\\  & =\\pi -2\\pi  \\\\  & =-\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bc27ed2e-bc72-50af-9261-a3b5d2e0cb7f"] :db/ensure [:question/validate]} {:db/id "answer-field-bc27ed2e-bc72-50af-9261-a3b5d2e0cb7f" :answer-field/id #uuid "bc27ed2e-bc72-50af-9261-a3b5d2e0cb7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a749ad1d-665b-5427-9988-ca625952b300" :answer-field/choices ["answer-a749ad1d-665b-5427-9988-ca625952b300" "answer-23985b75-b87d-5b4e-ad83-43ea19508d98" "answer-2117bd03-1c6f-5cad-b477-24bd9e729cc6" "answer-ed479c26-ff80-5972-bd9a-95bf483b94d8" "answer-70d83f85-c4ae-51b5-a84d-afc0738bd70a"] :db/ensure [:answer-field/validate]} {:db/id "answer-a749ad1d-665b-5427-9988-ca625952b300" :answer/id #uuid "a749ad1d-665b-5427-9988-ca625952b300" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "answer-23985b75-b87d-5b4e-ad83-43ea19508d98" :answer/id #uuid "23985b75-b87d-5b4e-ad83-43ea19508d98" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-2117bd03-1c6f-5cad-b477-24bd9e729cc6" :answer/id #uuid "2117bd03-1c6f-5cad-b477-24bd9e729cc6" :answer/type :answer.type/math :answer/value "2\\pi +1" :db/ensure [:answer/validate]} {:db/id "answer-ed479c26-ff80-5972-bd9a-95bf483b94d8" :answer/id #uuid "ed479c26-ff80-5972-bd9a-95bf483b94d8" :answer/type :answer.type/math :answer/value "3-\\pi " :db/ensure [:answer/validate]} {:db/id "answer-70d83f85-c4ae-51b5-a84d-afc0738bd70a" :answer/id #uuid "70d83f85-c4ae-51b5-a84d-afc0738bd70a" :answer/type :answer.type/math :answer/value "\\pi -1" :db/ensure [:answer/validate]} {:db/id "question-fa2f9f9d-09dc-55fa-a8fa-ab5f37e6b68d" :question/id #uuid "fa2f9f9d-09dc-55fa-a8fa-ab5f37e6b68d" :question/math-academy-id "q-32497" :question/problem "Given that \n${\\int }_{0}^{\\pi }f(t)\\,\\text{d}t=2\\pi \\,i+\\pi \\,j+(2-\\pi )\\,k,$ \n$c=i+u\\,j,$\nand \n${\\int }_{0}^{\\pi }c\\cdot f(t)\\,\\text{d}t=0,$ what is the value of $u?$" :question/worked-solution "The dot product rule states that\n\n$$\n{\\int }_{0}^{\\pi }c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{0}^{\\pi }f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{0}^{\\pi }f(t)\\,\\text{d}t \\\\  & =(i+u\\,j)\\cdot (2\\pi \\,i+\\pi \\,j+(2-\\pi )\\,k) \\\\  & =2\\pi +u\\cdot \\pi +0\\cdot (2-\\pi ) \\\\  & =\\pi (2+u).\\end{aligned}\n$$\n\nFinally, since ${\\int }_{0}^{\\pi }c\\cdot f(t)\\,\\text{d}t=0,$ we must have $\\pi (2+u)=0,$ which means that $u=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d8314db3-fd94-5934-8c57-06ecde0d8fcc"] :db/ensure [:question/validate]} {:db/id "answer-field-d8314db3-fd94-5934-8c57-06ecde0d8fcc" :answer-field/id #uuid "d8314db3-fd94-5934-8c57-06ecde0d8fcc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-99c3ca58-d8a3-5f11-ae82-feb036177f71" :answer-field/choices ["answer-99c3ca58-d8a3-5f11-ae82-feb036177f71" "answer-a89cfd93-f4e9-50c0-8e1b-60853d6b0f48" "answer-eeb93c26-582d-5e72-8c7f-84a1f899691c" "answer-70554e11-c9f9-5782-9be5-acbc21451f02" "answer-13970be9-a298-561f-a13a-5e8d2433bdfc"] :db/ensure [:answer-field/validate]} {:db/id "answer-99c3ca58-d8a3-5f11-ae82-feb036177f71" :answer/id #uuid "99c3ca58-d8a3-5f11-ae82-feb036177f71" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-a89cfd93-f4e9-50c0-8e1b-60853d6b0f48" :answer/id #uuid "a89cfd93-f4e9-50c0-8e1b-60853d6b0f48" :answer/type :answer.type/math :answer/value "-2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-eeb93c26-582d-5e72-8c7f-84a1f899691c" :answer/id #uuid "ee