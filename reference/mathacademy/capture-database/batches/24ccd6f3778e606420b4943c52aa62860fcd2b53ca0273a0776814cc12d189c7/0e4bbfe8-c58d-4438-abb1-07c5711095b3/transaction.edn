da-b33da64af211" :step/content 17592186345247 :step/next "step-6b56d38e-560a-5855-970e-c59d2f999047" :db/ensure [:step/validate]} {:db/id "step-6b56d38e-560a-5855-970e-c59d2f999047" :step/id #uuid "6b56d38e-560a-5855-970e-c59d2f999047" :step/content 17592186455435 :step/next "step-85c711d0-5b3c-52f0-81be-22f51de6f340" :db/ensure [:step/validate]} {:db/id "step-85c711d0-5b3c-52f0-81be-22f51de6f340" :step/id #uuid "85c711d0-5b3c-52f0-81be-22f51de6f340" :step/content 17592186362989 :db/ensure [:step/validate]} {:db/id 17592186175948 :knowledge-point/questions ["question-a84f0335-631a-5413-a947-37ccb6b7bf94" "question-7026529b-9d4a-5618-98a8-c1bbd9c1f097" "question-598873cf-7c1c-5ce4-9b98-2bbec96c77b0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a84f0335-631a-5413-a947-37ccb6b7bf94" :question/id #uuid "a84f0335-631a-5413-a947-37ccb6b7bf94" :question/math-academy-id "q-10951" :question/problem "Find the radius of convergence $R$ for the series\n\n$$\n{\\sum }_{n=0}^{\\infty }\\frac{{3}^{n}}{n+2}\\,{(x+\\frac{1}{4})}^{n}=\\frac{1}{2}+(x+\\frac{1}{4})+\\frac{{3}^{2}}{4}\\,{(x+\\frac{1}{4})}^{2}+\\frac{{3}^{3}}{5}\\,{(x+\\frac{1}{4})}^{3}+⋯\\,.\n$$" :question/worked-solution "To apply the ratio test we define ${a}_{n}=\\frac{{3}^{n}}{n+2}\\,{(x+\\frac{1}{4})}^{n}.$Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{{3}^{n+1}{(x+\\frac{1}{4})}^{n+1}}{n+3}\\cdot \\frac{n+2}{{3}^{n}{(x+\\frac{1}{4})}^{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{3(n+2)}{n+3}(x+\\frac{1}{4})| \\\\  & =|x+\\frac{1}{4}|{lim}_{n\\to \\infty }\\frac{3(n+2)}{n+3} \\\\  & =|x+\\frac{1}{4}|\\cdot 3 \\\\  & =3|x+\\frac{1}{4}|\\end{aligned}\n$$\n\nThe series converges if $L<1.$ In this case, the convergence condition is satisfied if $|x+\\frac{1}{4}|<\\frac{1}{3}.$ Therefore, we conclude that the radius of convergence is $R=\\frac{1}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5c0f0b50-59c3-55f1-9dd4-e437042f4694"] :db/ensure [:question/validate]} {:db/id "answer-field-5c0f0b50-59c3-55f1-9dd4-e437042f4694" :answer-field/id #uuid "5c0f0b50-59c3-55f1-9dd4-e437042f4694" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-996d9678-9618-532e-b9f5-e13ce2363d22" :answer-field/choices ["answer-9aeec267-8402-5442-ae4f-c5243381be54" "answer-5707f823-a702-5205-912d-685b05a414e8" "answer-3a63ba58-5aa1-58f4-babf-82edf1156231" "answer-996d9678-9618-532e-b9f5-e13ce2363d22" "answer-18f47684-815b-5375-a6da-f93067585187"] :db/ensure [:answer-field/validate]} {:db/id "answer-9aeec267-8402-5442-ae4f-c5243381be54" :answer/id #uuid "9aeec267-8402-5442-ae4f-c5243381be54" :answer/type :answer.type/math :answer/value "R=1" :db/ensure [:answer/validate]} {:db/id "answer-5707f823-a702-5205-912d-685b05a414e8" :answer/id #uuid "5707f823-a702-5205-912d-685b05a414e8" :answer/type :answer.type/math :answer/value "R=3" :db/ensure [:answer/validate]} {:db/id "answer-3a63ba58-5aa1-58f4-babf-82edf1156231" :answer/id #uuid "3a63ba58-5aa1-58f4-babf-82edf1156231" :answer/type :answer.type/math :answer/value "R=4" :db/ensure [:answer/validate]} {:db/id "answer-996d9678-9618-532e-b9f5-e13ce2363d22" :answer/id #uuid "996d9678-9618-532e-b9f5-e13ce2363d22" :answer/type :answer.type/math :answer/value "R=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-18f47684-815b-5375-a6da-f93067585187" :answer/id #uuid "18f47684-815b-5375-a6da-f93067585187" :answer/type :answer.type/math :answer/value "R=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id 17592186175956 :knowledge-point/questions ["question-654aa15f-b5e0-5714-95bd-cdd476eb0257"] :db/ensure [:knowledge-point/validate]} {:db/id "question-654aa15f-b5e0-5714-95bd-cdd476eb0257" :question/id #uuid "654aa15f-b5e0-5714-95bd-cdd476eb0257" :question/math-academy-id "q-50872" :question/problem "Given that the power series ${\\sum }_{n=1}^{\\infty }{a}_{n}(x-1)^{n}$ converges at  $x=-3,$ which of the following **must** be true?\n\nI. The series converges at $x=5$\n\nII. The series diverges at $x=-4$\n\nIII. The series converges at $x=-2$" :question/worked-solution "The center of the expansion is $x=1,$ and since the series is convergent for $x=-3,$ this means that the radius of convergence $R$ is *at least* $4,$ i.e., $R\\ge 4.$ So, the series is convergent for every point in the interval $[-3,5).$ However, we know nothing about the convergence of the series at any point outside the interval $[-3,5).$\n\n![](images/1f/1f6d98b7983946bf60df9bb29bc527af17a63a38834457404c5284b19165e7d5.png)\n\n \n\nWith this in mind, let's check each of our statements.\n\n- Statement I is false. Since $5\\notin [-3,5),$ we cannot guarantee that the series is convergent at $x=5.$\n\n- Statement II is false. Since $-4\\notin [-3,5),$ we cannot guarantee that the series is divergent at $x=-4.$\n\n- Statement III is true. Since $-2\\in [-3,5),$ the series is convergent at $x=-2.$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ed2165e7-e994-5fc0-830d-7875786845b0"] :db/ensure [:question/validate]} {:db/id "answer-field-ed2165e7-e994-5fc0-830d-7875786845b0" :answer-field/id #uuid "ed2165e7-e994-5fc0-830d-7875786845b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-879de2ba-363d-5019-bbeb-cb1ed785abbf" :answer-field/choices ["answer-08fb89eb-ead7-518e-9d10-59dc60a26086" "answer-4636f52c-61af-5bc5-b912-63b4c6e59780" "answer-400b64b5-16b4-5ca0-8249-0be7bc1b3334" "answer-4a6824a2-c62e-592d-b740-ce8ac0471c2b" "answer-879de2ba-363d-5019-bbeb-cb1ed785abbf"] :db/ensure [:answer-field/validate]} {:db/id "answer-08fb89eb-ead7-518e-9d10-59dc60a26086" :answer/id #uuid "08fb89eb-ead7-518e-9d10-59dc60a26086" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-4636f52c-61af-5bc5-b912-63b4c6e59780" :answer/id #uuid "4636f52c-61af-5bc5-b912-63b4c6e59780" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-400b64b5-16b4-5ca0-8249-0be7bc1b3334" :answer/id #uuid "400b64b5-16b4-5ca0-8249-0be7bc1b3334" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-4a6824a2-c62e-592d-b740-ce8ac0471c2b" :answer/id #uuid "4a6824a2-c62e-592d-b740-ce8ac0471c2b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-879de2ba-363d-5019-bbeb-cb1ed785abbf" :answer/id #uuid "879de2ba-363d-5019-bbeb-cb1ed785abbf" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-7026529b-9d4a-5618-98a8-c1bbd9c1f097" :question/id #uuid "7026529b-9d4a-5618-98a8-c1bbd9c1f097" :question/math-academy-id "q-351689" :question/problem "Find the radius of convergence $R$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x+3)^{n}}{{2}^{{n}^{2}}}=\\frac{x+3}{2}+\\frac{(x+3)^{2}}{{2}^{4}}+\\frac{(x+3)^{3}}{{2}^{9}}+⋯\\,.\n$$\n\n$R=$\n{{field-1}}" :question/worked-solution "To apply the ratio test, we define ${a}_{n}=\\frac{(x+3)^{n}}{{2}^{{n}^{2}}}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{\\frac{(x+3)^{n+1}}{{2}^{(n+1)^{2}}}}{\\frac{(x+3)^{n}}{{2}^{{n}^{2}}}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x+3)^{n+1}}{{2}^{(n+1)^{2}}}\\cdot \\frac{{2}^{{n}^{2}}}{(x+3)^{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{x+3}{{2}^{(n+1)^{2}-{n}^{2}}}| \\\\  & =|x+3|{lim}_{n\\to \\infty }\\frac{1}{{2}^{2n+1}} \\\\  & =|x+3|\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThe series converges if $L<1.$ In this case, the convergence condition is satisfied for all $-\\infty <x<\\infty .$  Therefore, we conclude that the radius of convergence is $R=\\infty .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6916cdad-f8c8-54c9-9409-23eda9cbde44"] :db/ensure [:question/validate]} {:db/id "answer-field-6916cdad-f8c8-54c9-9409-23eda9cbde44" :answer-field/id #uuid "6916cdad-f8c8-54c9-9409-23eda9cbde44" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0f7e249d-f82c-53b4-babb-736db15aabc9" :answer-field/choices ["answer-0f7e249d-f82c-53b4-babb-736db15aabc9"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f7e249d-f82c-53b4-babb-736db15aabc9" :answer/id #uuid "0f7e249d-f82c-53b4-babb-736db15aabc9" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-598873cf-7c1c-5ce4-9b98-2bbec96c77b0" :question/id #uuid "598873cf-7c1c-5ce4-9b98-2bbec96c77b0" :question/math-academy-id "q-362919" :question/problem "Find the radius of convergence $R$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x-2)^{n}}{n!}=(x-2)+\\frac{(x-2)^{2}}{2!}+\\frac{(x-2)^{3}}{3!}+⋯\\,.\n$$\n\n$R=$\n{{field-1}}" :question/worked-solution "To apply the ratio test, we define ${a}_{n}=\\frac{(x-2)^{n}}{n!}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{\\frac{(x-2)^{n+1}}{(n+1)!}}{\\frac{(x-2)^{n}}{n!}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-2)^{n+1}}{(n+1)!}\\cdot \\frac{n!}{(x-2)^{n}}| \\\\  & =|x-2|{lim}_{n\\to \\infty }\\frac{1}{n+1} \\\\  & =|x-2|\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThe series converges if $L<1.$ In this case, the convergence condition is satisfied for all $-\\infty <x<\\infty .$  Therefore, we conclude that the radius of convergence is $R=\\infty .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7010f27e-2c7b-56b4-bedc-53b6189ca1dd"] :db/ensure [:question/validate]} {:db/id "answer-field-7010f27e-2c7b-56b4-bedc-53b6189ca1dd" :answer-field/id #uuid "7010f27e-2c7b-56b4-bedc-53b6189ca1dd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-87e55e4a-4466-5d80-9cf0-611b2f8ca54b" :answer-field/choices ["answer-87e55e4a-4466-5d80-9cf0-611b2f8ca54b"] :db/ensure [:answer-field/validate]} {:db/id "answer-87e55e4a-4466-5d80-9cf0-611b2f8ca54b" :answer/id #uuid "87e55e4a-4466-5d80-9cf0-611b2f8ca54b" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "activity-108aa01a-3294-597c-9fb3-d2b3890b1223" :activity/id #uuid "108aa01a-3294-597c-9fb3-d2b3890b1223" :activity/title "Radius of Convergence of Power Series" :activity/type :activity.type/review :activity/scope 17592186048837 :activity/course 17592186046645 :activity/steps ["step-c7ccc968-e078-5fa8-9279-25f8596d951c" "step-e50be512-91d0-596f-b158-f62b5f78c06e" "step-69ab9d00-6615-57e8-8873-36e4356ca3d8" "step-4d98d8dd-ecac-5ab1-ab66-5e749ba1a4c2" "step-60eafd7c-63b8-5970-8d56-5704b401f6d8"] :activity/first-step "step-c7ccc968-e078-5fa8-9279-25f8596d951c" :db/ensure [:activity/validate]} {:db/id "step-c7ccc968-e078-5fa8-9279-25f8596d951c" :step/id #uuid "c7ccc968-e078-5fa8-9279-25f8596d951c" :step/content "question-a84f0335-631a-5413-a947-37ccb6b7bf94" :step/next "step-e50be512-91d0-596f-b158-f62b5f78c06e" :db/ensure [:step/validate]} {:db/id "step-e50be512-91d0-596f-b158-f62b5f78c06e" :step/id #uuid "e50be512-91d0-596f-b158-f62b5f78c06e" :step/content "question-654aa15f-b5e0-5714-95bd-cdd476eb0257" :step/next "step-69ab9d00-6615-57e8-8873-36e4356ca3d8" :db/ensure [:step/validate]} {:db/id "step-69ab9d00-6615-57e8-8873-36e4356ca3d8" :step/id #uuid "69ab9d00-6615-57e8-8873-36e4356ca3d8" :step/content 17592186237977 :step/next "step-4d98d8dd-ecac-5ab1-ab66-5e749ba1a4c2" :db/ensure [:step/validate]} {:db/id "step-4d98d8dd-ecac-5ab1-ab66-5e749ba1a4c2" :step/id #uuid "4d98d8dd-ecac-5ab1-ab66-5e749ba1a4c2" :step/content "question-7026529b-9d4a-5618-98a8-c1bbd9c1f097" :step/next "step-60eafd7c-63b8-5970-8d56-5704b401f6d8" :db/ensure [:step/validate]} {:db/id "step-60eafd7c-63b8-5970-8d56-5704b401f6d8" :step/id #uuid "60eafd7c-63b8-5970-8d56-5704b401f6d8" :step/content "question-598873cf-7c1c-5ce4-9b98-2bbec96c77b0" :db/ensure [:step/validate]} {:db/id 17592186129105 :knowledge-point/questions ["question-d362e2bc-26cf-51c4-91b6-e3e5ba9e9850" "question-12aa5ec1-b59f-559a-80d0-644a88af964f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128921 :question/problem "![](images/8a/8a28f89ca66be27ba85ded32668b7077cb2b152f9877fe52f6702a40be047773.png)\n\nThe graph of the function $g(x)$ is shown above. Find the value of $b-a,$ given the following:\n\n- $g(x)\\rightarrow -\\infty$ as $x\\rightarrow a$\n\n- $g(x)\\rightarrow \\infty$ as $x\\rightarrow b$" :question/worked-solution "From the given graph, we see that as $x$ approaches $-1,$ the values of $g(x)$ decrease, approaching $-\\infty.$ \n\n![](images/c5/c5b5723c08edacff5a29e160b225343f565d23bb764a84149ca20ebbe28d4ad3.png)\n\nSo, we can write\n\n$$\ng(x) \\to -\\infty \\quad \\text{as} \\quad x \\to -1.\n$$\n\nTherefore, $a = -1.$\n\nFrom the given graph, we see that as $x$ approaches $1,$ the values of $g(x)$ increase, approaching $\\infty.$ \n\n![](images/3b/3bf9f0d83f05002952d531fe1dcaa6ad14d7d7c4216a59d9a2d3a4e621b57ef5.png)\n\nSo, we can write\n\n$$\ng(x) \\to \\infty \\quad \\text{as} \\quad x \\to 1.\n$$\n\nTherefore, $b =1.$\n\nFinally,\n\n$$\nb - a = 1 - (-1) = 2.\n$$" :db/ensure [:question/validate]} {:db/id 17592186129098 :knowledge-point/questions ["question-0274893d-bdb8-5547-900e-3f5b62ab65d3" "question-ca47eb18-4aa6-5c60-add3-13a91c37460f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128914 :question/problem "The graph of $y=f(x)$ is shown below. Which of the following is true when $x\\rightarrow 2?$   \n\nI. $f(x) \\rightarrow  \\infty$\n\nII. $f(x) \\rightarrow  2$\n\nIII. $f(x) \\rightarrow  -\\infty$\n\n![](images/33/33650d66a0f3a2fae762b1c19da952597740868b00eeec11a14ad822536962e8.png)" :question/worked-solution "From the given graph, we see that as $x$ approaches $2,$ the values of $f(x)$ increase, approaching $\\infty.$ \n\n![](images/45/4585f983dac68f3ac655fbaaed6481cd1479c4cffae2c10d9f08d991c6533f51.png)\n\nTherefore, the correct answer is \"I only\"." :db/ensure [:question/validate]} {:db/id 17592186129103 :knowledge-point/questions ["question-b21470c3-1ee9-52ab-ab28-1768b780f6d2" "question-936ec21a-6fd7-54a1-80fb-a5b7564ca5ca"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128919 :question/problem "![](images/d5/d5750d5909f8a6e7c893109dd2ebe1e6317e7e5505df52d8be8966b8f914f140.png)\n\nThe graph of ![](images/44/44c838deb3fa8e3182fbd9d4a03f964dc2731730559d00328190e9259bf01762.svg) is shown above. Which of the following is true when ![](images/cf/cf6469e6430ca528386d02c3c62c8856abdd9cd592dab391ca0b37cb9eee214d.svg)\n\nI. ![](images/61/61e37acf991ed5b1c42f3c21005513060e0168597a24ca4fc0f3925a75fe77ad.svg)\n\nII. ![](images/6a/6ac2f1940e7398cde2efc3364d99ccbcba9cb95c761f338c1c643daa557cf804.svg)\n\nIII. ![](images/33/333a8ffca9eb9ad90f40e6a0a28a8119936d27bc840b0495c6b98eafec91d875.svg)" :question/worked-solution "The notation ![](images/e1/e15c0b105ea984c36aeb1eae6f4e743fd66d4a152acf6f2fdc5a9f977760e39f.svg) means that ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) approaches ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) *from the right*.\n\n![](images/99/99421620750831182ef45a4cfda34ee4b36f772f88df5572783bffc3ea9580c5.png)\n\nFrom the given graph, we see that as ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg) approaches ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) from the right, the values of ![](images/93/93f888a1ee0b7da5e29f442f803f1c0eaf73ad02f5eaa97e85bb8a35d607015b.svg) increase, approaching ![](images/b7/b7dcbb40b0c8f515a6b1ee8773cbf301ab1f40446114fd0e5436b57fd08e3697.svg)\n\nTherefore, ![](images/33/333a8ffca9eb9ad90f40e6a0a28a8119936d27bc840b0495c6b98eafec91d875.svg) as ![](images/57/57038ceb8b89a8ded3292cf53d2875f5da509c824f4ad1cacd8ce1616f1cfff5.svg) So, the correct answer is \"III only\"." :db/ensure [:question/validate]} {:db/id 17592186129104 :knowledge-point/questions ["question-b6d62580-c7ef-590e-96ab-faddfa2655e8" "question-1705d8ca-0ba8-5feb-91d5-1e7a97ff9132"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186128920 :question/worked-solution "Recall that $x = a$ is called a vertical asymptote of $y = f(x)$ if $f(x) \\to \\pm \\infty$ as $x \\to a^+$ or $x \\to a^-.$\n\n![](images/59/596435060b73c6df3b05bf5f56b4650c2e77ecb70203f3d680ad9d0dddc1f027.png)\n\nFrom the given graph, we see that as $x$ approaches $-1$ from the left, the values of $f(x)$ increase, approaching $\\infty.$ Also, notice that as $x$ approaches $-1$ from the right, the values of $f(x)$ decrease, approaching $-\\infty.$\n\nSo, we can write: \n\n- $f(x) \\to \\infty$ as $x \\to -1^-$\n\n- $f(x) \\to -\\infty$ as $x \\to -1^+$\n\nThese give us the same asymptote $x = -1.$" :db/ensure [:question/validate]} {:db/id "question-d362e2bc-26cf-51c4-91b6-e3e5ba9e9850" :question/id #uuid "d362e2bc-26cf-51c4-91b6-e3e5ba9e9850" :question/math-academy-id "q-39351" :question/problem "![](images/d9/d953b897affdad991b86db265b90610cb6e28f3ac6a94889c5143f2289d93f68.png)\n\nThe graph of $y=f(x)$ is shown above. Find the values ​​of $a$ such that $f(x)\\to \\infty $ as $x\\to a.$" :question/worked-solution "![](images/e9/e9862ea9f1debb162a62a3eb3422f2313f4a8512c30fe2a16e982207639c0ef4.png)\n\nFrom the given graph, we see that as $x$ approaches $-3$ or $2$, the values of $f(x)$ increase, approaching $\\infty .$ \n\nSo, we can write: $f(x)\\to \\infty $ as $x\\to -3$ and $f(x)\\to \\infty $ as $x\\to 2.$ \n\nTherefore, $a=-3$ and $a=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3e681c60-4b82-5c46-8f28-b7ad70bfc38f"] :db/ensure [:question/validate]} {:db/id "answer-field-3e681c60-4b82-5c46-8f28-b7ad70bfc38f" :answer-field/id #uuid "3e681c60-4b82-5c46-8f28-b7ad70bfc38f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4dd51d86-d457-516e-ac62-cca692dc8851" :answer-field/choices ["answer-e6820c9f-6c5b-57d1-9cbd-0fb040cafa8b" "answer-4dd51d86-d457-516e-ac62-cca692dc8851" "answer-a09b73c8-cfe4-5dc1-9180-d67767a41575" "answer-e7ef2269-b1c8-5c97-b7f3-12233daa93a3" "answer-2079e839-615d-50fe-94b0-a165953de47b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6820c9f-6c5b-57d1-9cbd-0fb040cafa8b" :answer/id #uuid "e6820c9f-6c5b-57d1-9cbd-0fb040cafa8b" :answer/type :answer.type/text :answer/value "$a=-2$ and $a=2$" :db/ensure [:answer/validate]} {:db/id "answer-4dd51d86-d457-516e-ac62-cca692dc8851" :answer/id #uuid "4dd51d86-d457-516e-ac62-cca692dc8851" :answer/type :answer.type/text :answer/value "$a=-3$ and $a=2$" :db/ensure [:answer/validate]} {:db/id "answer-a09b73c8-cfe4-5dc1-9180-d67767a41575" :answer/id #uuid "a09b73c8-cfe4-5dc1-9180-d67767a41575" :answer/type :answer.type/text :answer/value "$a=-3$ and $a=3$" :db/ensure [:answer/validate]} {:db/id "answer-e7ef2269-b1c8-5c97-b7f3-12233daa93a3" :answer/id #uuid "e7ef2269-b1c8-5c97-b7f3-12233daa93a3" :answer/type :answer.type/text :answer/value "$a=-3$ only" :db/ensure [:answer/validate]} {:db/id "answer-2079e839-615d-50fe-94b0-a165953de47b" :answer/id #uuid "2079e839-615d-50fe-94b0-a165953de47b" :answer/type :answer.type/text :answer/value "$a=2$ only" :db/ensure [:answer/validate]} {:db/id "question-12aa5ec1-b59f-559a-80d0-644a88af964f" :question/id #uuid "12aa5ec1-b59f-559a-80d0-644a88af964f" :question/math-academy-id "q-73386" :question/problem "![](images/bd/bdce9d030776f147aa7a17881dc5369fc9e7f3a7f4776852d9f5d958ca526baa.png)\n\nThe graph of the function $h(x)$ is shown above. Find the value of $\\frac{b}{a}$ given that:\n\n- $h(x)\\to \\infty $ as $x\\to a$\n\n- $h(x)\\to -\\infty $ as $x\\to b$" :question/worked-solution "From the given graph, we see that as $x$ approaches $-2$ the values of $h(x)$ increase, approaching $\\infty .$ \n\n![](images/02/02bb73c2c981a0fb9e128b89862b854f9fb6af6cca6ff216a69733561ae90dbf.png)\n\nSo, we can write: $h(x)\\to \\infty $ as $x\\to -2.$ \n\nTherefore, $a=-2.$\n\nFrom the given graph, we see that as $x$ approaches $4$ the values of $h(x)$ decrease, approaching $-\\infty .$ \n\n![](images/4c/4ce365f8ce995accf041aca6f1ac6ccc24d0b8e835e0d268c433ff244cfcfb10.png)\n\nSo, we can write: $h(x)\\to -\\infty $ as $x\\to 4.$ \n\nTherefore, $b=4.$\n\nFinally:\n\n$$\n\\frac{b}{a}=\\frac{4}{-2}=-2\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-124c33fc-0540-5fef-b86c-da27bf036906"] :db/ensure [:question/validate]} {:db/id "answer-field-124c33fc-0540-5fef-b86c-da27bf036906" :answer-field/id #uuid "124c33fc-0540-5fef-b86c-da27bf036906" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-56f39e90-8e6b-5f4d-b80e-d0812afb28a2" :answer-field/choices ["answer-56f39e90-8e6b-5f4d-b80e-d0812afb28a2" "answer-dfedff98-e2a1-5c48-9f63-ccb6faf9d50f" "answer-bede3045-9a6e-5cee-b982-d5ecaa7c3cfa" "answer-26f25a9e-e5df-512a-b13b-fe21656edc09" "answer-ccbe4206-79d2-56ec-9bc7-709ec0ce07c5"] :db/ensure [:answer-field/validate]} {:db/id "answer-56f39e90-8e6b-5f4d-b80e-d0812afb28a2" :answer/id #uuid "56f39e90-8e6b-5f4d-b80e-d0812afb28a2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-dfedff98-e2a1-5c48-9f63-ccb6faf9d50f" :answer/id #uuid "dfedff98-e2a1-5c48-9f63-ccb6faf9d50f" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bede3045-9a6e-5cee-b982-d5ecaa7c3cfa" :answer/id #uuid "bede3045-9a6e-5cee-b982-d5ecaa7c3cfa" :answer/type :answer.type/math :answer/value "-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-26f25a9e-e5df-512a-b13b-fe21656edc09" :answer/id #uuid "26f25a9e-e5df-512a-b13b-fe21656edc09" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-ccbe4206-79d2-56ec-9bc7-709ec0ce07c5" :answer/id #uuid "ccbe4206-79d2-56ec-9bc7-709ec0ce07c5" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-0274893d-bdb8-5547-900e-3f5b62ab65d3" :question/id #uuid "0274893d-bdb8-5547-900e-3f5b62ab65d3" :question/math-academy-id "q-66682" :question/problem "![](images/10/10ef921066e2984492588891cb36d52c142d387c94d23aa226e26377f30d96cd.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true?\n\nI. $f(x)\\to -\\infty $ as $x\\to 0$\n\nII. $f(x)\\to \\infty $ as $x\\to 2$\n\nIII. $f(x)\\to -\\infty $ as $x\\to 2$" :question/worked-solution "![](images/68/68343d3b77ebad519983a98cc35531a632c85e453cb38a4583fb21cf4ea620e0.png)\n\nFrom the given graph, we see that:\n\n- as $x$ approaches $0$ the values of $f(x)$ increase, approaching $\\infty $\n\n- as $x$ approaches $2$ the values of $f(x)$ decrease, approaching $-\\infty $\n\nTherefore, the correct answer is \"III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-19fa27cb-d0cb-58be-ba1b-5007ddf4fbd0"] :db/ensure [:question/validate]} {:db/id "answer-field-19fa27cb-d0cb-58be-ba1b-5007ddf4fbd0" :answer-field/id #uuid "19fa27cb-d0cb-58be-ba1b-5007ddf4fbd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9fb07a79-05e8-5993-aa4e-fe8cc781da3d" :answer-field/choices ["answer-e30f8872-21e6-571a-87b6-f7748bb0eed3" "answer-3b12bab4-f22d-570a-963a-367b3ce27b0f" "answer-7691b709-f303-51b3-a0e5-4b140379f5d3" "answer-8c73f008-f517-5058-880f-1e0754701c2f" "answer-9fb07a79-05e8-5993-aa4e-fe8cc781da3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e30f8872-21e6-571a-87b6-f7748bb0eed3" :answer/id #uuid "e30f8872-21e6-571a-87b6-f7748bb0eed3" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-3b12bab4-f22d-570a-963a-367b3ce27b0f" :answer/id #uuid "3b12bab4-f22d-570a-963a-367b3ce27b0f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7691b709-f303-51b3-a0e5-4b140379f5d3" :answer/id #uuid "7691b709-f303-51b3-a0e5-4b140379f5d3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-8c73f008-f517-5058-880f-1e0754701c2f" :answer/id #uuid "8c73f008-f517-5058-880f-1e0754701c2f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-9fb07a79-05e8-5993-aa4e-fe8cc781da3d" :answer/id #uuid "9fb07a79-05e8-5993-aa4e-fe8cc781da3d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-ca47eb18-4aa6-5c60-add3-13a91c37460f" :question/id #uuid "ca47eb18-4aa6-5c60-add3-13a91c37460f" :question/math-academy-id "q-110669" :question/problem "![](images/ed/ed4ddeb8ea4f2bb9d05dc05d3ff73559806186d66a78431e89f50e3bbe390dd5.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is true when $x\\to 1?$" :question/worked-solution "![](images/2a/2a84c7f64371af4728f86d83df8680ab85683cf4cf564ca9622d93b39fdfc267.png)\n\nFrom the given graph, we see that as $x$ approaches $1$ the values of $f(x)$ increase, approaching $\\infty .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cf0e12d6-f84d-59c5-b35c-7d782639eeb5"] :db/ensure [:question/validate]} {:db/id "answer-field-cf0e12d6-f84d-59c5-b35c-7d782639eeb5" :answer-field/id #uuid "cf0e12d6-f84d-59c5-b35c-7d782639eeb5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a2516f9-a12e-50a9-a436-094d782d8505" :answer-field/choices ["answer-8147ec1c-a795-511e-b8fe-56bae4f6295f" "answer-3a30d4c1-4d5d-590f-ade6-b45bea586f07" "answer-d10d022f-aa90-501d-848b-e62d1c08fe62" "answer-fb32aed5-ef18-5b85-a55f-3e72b4a11a5b" "answer-4a2516f9-a12e-50a9-a436-094d782d8505"] :db/ensure [:answer-field/validate]} {:db/id "answer-8147ec1c-a795-511e-b8fe-56bae4f6295f" :answer/id #uuid "8147ec1c-a795-511e-b8fe-56bae4f6295f" :answer/type :answer.type/math :answer/value "f(x)\\to -1" :db/ensure [:answer/validate]} {:db/id "answer-3a30d4c1-4d5d-590f-ade6-b45bea586f07" :answer/id #uuid "3a30d4c1-4d5d-590f-ade6-b45bea586f07" :answer/type :answer.type/math :answer/value "f(x)\\to -\\infty " :db/ensure [:answer/validate]} {:db/id "answer-d10d022f-aa90-501d-848b-e62d1c08fe62" :answer/id #uuid "d10d022f-aa90-501d-848b-e62d1c08fe62" :answer/type :answer.type/math :answer/value "f(x)\\to 0" :db/ensure [:answer/validate]} {:db/id "answer-fb32aed5-ef18-5b85-a55f-3e72b4a11a5b" :answer/id #uuid "fb32aed5-ef18-5b85-a55f-3e72b4a11a5b" :answer/type :answer.type/math :answer/value "f(x)\\to 1" :db/ensure [:answer/validate]} {:db/id "answer-4a2516f9-a12e-50a9-a436-094d782d8505" :answer/id #uuid "4a2516f9-a12e-50a9-a436-094d782d8505" :answer/type :answer.type/math :answer/value "f(x)\\to \\infty " :db/ensure [:answer/validate]} {:db/id "question-b21470c3-1ee9-52ab-ab28-1768b780f6d2" :question/id #uuid "b21470c3-1ee9-52ab-ab28-1768b780f6d2" :question/math-academy-id "q-39451" :question/problem "![](images/cd/cd6662d44cd356ee112fd0bec330d0cb85197935a312069ab766c46e0ef9c61d.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true?\n\nI. As $x\\to -{2}^{-},\\,$ $f(x)\\to \\infty $\n\nII. As $x\\to {3}^{-},\\,$ $f(x)\\to \\infty $\n\nIII. As $x\\to {3}^{+},\\,$ $f(x)\\to -\\infty $" :question/worked-solution "The notation $x\\to -{2}^{-}$ means that $x$ approaches $-2$ *from the left*. In the same way, the notation $x\\to {3}^{-}$ means that $x$ approaches $3$ *from the left* while $x\\to {3}^{+}$ means that $x$ approaches $3$ *from the right*. \n\n![](images/37/37af0eeb28d271efa4bd8f296b8c530b82a7f368f82fa96e025695317b81519d.png)\n\nFrom the given graph, we see that:\n\n- As $x$ approaches $-2$ from the left, the values of $f(x)$ do not approach $\\infty .$ So, statement I is false.\n\n- As $x$ approaches $3$ from the left, the values of $f(x)$ increase, approaching $\\infty .$ So, statement II is true.\n\n- As $x$ approaches $3$ from the right, the values of $f(x)$ do not approach $-\\infty .$ So, statement III is false.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1019eed5-3538-5043-a33a-3c345b809f48"] :db/ensure [:question/validate]} {:db/id "answer-field-1019eed5-3538-5043-a33a-3c345b809f48" :answer-field/id #uuid "1019eed5-3538-5043-a33a-3c345b809f48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2f0899a-c8da-5f22-b797-7b5f926af541" :answer-field/choices ["answer-eae24aca-3888-5c4c-a5dd-905811119997" "answer-bb7cbe24-bd75-5065-be03-26434d9b0af7" "answer-4b68ce78-1e8a-55c2-ba52-9b02c45bbf05" "answer-a2f0899a-c8da-5f22-b797-7b5f926af541" "answer-50463f52-843a-5163-8548-c96cd4408ec0"] :db/ensure [:answer-field/validate]} {:db/id "answer-eae24aca-3888-5c4c-a5dd-905811119997" :answer/id #uuid "eae24aca-3888-5c4c-a5dd-905811119997" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-bb7cbe24-bd75-5065-be03-26434d9b0af7" :answer/id #uuid "bb7cbe24-bd75-5065-be03-26434d9b0af7" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4b68ce78-1e8a-55c2-ba52-9b02c45bbf05" :answer/id #uuid "4b68ce78-1e8a-55c2-ba52-9b02c45bbf05" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-a2f0899a-c8da-5f22-b797-7b5f926af541" :answer/id #uuid "a2f0899a-c8da-5f22-b797-7b5f926af541" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-50463f52-843a-5163-8548-c96cd4408ec0" :answer/id #uuid "50463f52-843a-5163-8548-c96cd4408ec0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-936ec21a-6fd7-54a1-80fb-a5b7564ca5ca" :question/id #uuid "936ec21a-6fd7-54a1-80fb-a5b7564ca5ca" :question/math-academy-id "q-39498" :question/problem "![](images/ed/ed3ed1aeb01e59fae6efa312fbbdfb476fa493df5a1dd5730e4e5c595827a8ea.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is true when $x\\to -{2}^{-}?$" :question/worked-solution "The notation $x\\to -{2}^{-}$ means that $x$ approaches $-2$ *from the left*.\n\n![](images/ef/ef61a0d8a90ec9d0b120b0b9bf47077c7c77887f457182c09ee36b7d78b8cf9f.png)\n\nFrom the given graph, we see that as $x$ approaches $-2$ from the left, the values of $f(x)$ increase, approaching $\\infty .$\n\nTherefore:\n\n$\\,$ $f(x)\\to \\infty $ as $x\\to -{2}^{-}$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ab23431-35c4-5816-9f42-6807c5681847"] :db/ensure [:question/validate]} {:db/id "answer-field-1ab23431-35c4-5816-9f42-6807c5681847" :answer-field/id #uuid "1ab23431-35c4-5816-9f42-6807c5681847" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-01706240-bf16-5cd2-88a0-01b7e1068108" :answer-field/choices ["answer-62adc0cc-c742-59b0-bfaa-449ed5a524ba" "answer-d1d641d7-2268-5da7-a256-4bf4823af319" "answer-f614efbc-c627-550f-aa0b-b888808fd901" "answer-30d1f4ce-cf97-5cfe-825a-1baaf9822d2e" "answer-01706240-bf16-5cd2-88a0-01b7e1068108"] :db/ensure [:answer-field/validate]} {:db/id "answer-62adc0cc-c742-59b0-bfaa-449ed5a524ba" :answer/id #uuid "62adc0cc-c742-59b0-bfaa-449ed5a524ba" :answer/type :answer.type/math :answer/value "f(x)\\to -2" :db/ensure [:answer/validate]} {:db/id "answer-d1d641d7-2268-5da7-a256-4bf4823af319" :answer/id #uuid "d1d641d7-2268-5da7-a256-4bf4823af319" :answer/type :answer.type/math :answer/value "f(x)\\to -\\infty " :db/ensure [:answer/validate]} {:db/id "answer-f614efbc-c627-550f-aa0b-b888808fd901" :answer/id #uuid "f614efbc-c627-550f-aa0b-b888808fd901" :answer/type :answer.type/math :answer/value "f(x)\\to 0" :db/ensure [:answer/validate]} {:db/id "answer-30d1f4ce-cf97-5cfe-825a-1baaf9822d2e" :answer/id #uuid "30d1f4ce-cf97-5cfe-825a-1baaf9822d2e" :answer/type :answer.type/math :answer/value "f(x)\\to 3" :db/ensure [:answer/validate]} {:db/id "answer-01706240-bf16-5cd2-88a0-01b7e1068108" :answer/id #uuid "01706240-bf16-5cd2-88a0-01b7e1068108" :answer/type :answer.type/math :answer/value "f(x)\\to \\infty " :db/ensure [:answer/validate]} {:db/id "question-b6d62580-c7ef-590e-96ab-faddfa2655e8" :question/id #uuid "b6d62580-c7ef-590e-96ab-faddfa2655e8" :question/math-academy-id "q-111108" :question/problem "![](images/23/23015d804d6348d7ab6477fa981a1f2b24f43db4be96cca511ba53cfb53e49bd.png)\n\nConsider the graph of $y=f(x)$ shown above. What are the equations of its vertical asymptotes?" :question/worked-solution "Recall that $x=a$ is called a vertical asymptote of $y=f(x)$ if $f(x)\\to \\infty $ or $f(x)\\to -\\infty $ as $x\\to {a}^{+}$ or $x\\to {a}^{-}.$\n\n![](images/e6/e6d80874f9150371204f12b2e933085f9b2666ac77fce5430f9645e5af073a36.png)\n\nFrom the given graph, we see that as $x$ approaches $-2$ from the left, the values of $f(x)$ decrease, approaching $-\\infty .$ Also, notice that as $x$ approaches $-2$ from the right, the values of $f(x)$ decrease, approaching $-\\infty .$\n\nWe also see that as $x$ approaches $0$ from the left, the values of $f(x)$ decrease, approaching $-\\infty .$ And, as $x$ approaches $0$ from the right, the values of $f(x)$ decrease, approaching $-\\infty .$\n\nSo, we can write: \n\n- $f(x)\\to -\\infty $ as $x\\to -{2}^{-}$\n\n- $f(x)\\to -\\infty $ as $x\\to -{2}^{+}$\n\n- $f(x)\\to -\\infty $ as $x\\to {0}^{-}$\n\n- $f(x)\\to -\\infty $ as $x\\to {0}^{+}$\n\nThese give us the asymptotes $x=-2$ and $x=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b475a21f-3809-5b3b-b4c4-760fa5caf3a4"] :db/ensure [:question/validate]} {:db/id "answer-field-b475a21f-3809-5b3b-b4c4-760fa5caf3a4" :answer-field/id #uuid "b475a21f-3809-5b3b-b4c4-760fa5caf3a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cad7cccd-d43c-5829-961d-b9d7fe417a9d" :answer-field/choices ["answer-e26b87f9-c50c-58e9-8f87-82fc0ac53da1" "answer-cad7cccd-d43c-5829-961d-b9d7fe417a9d" "answer-f97ad6dd-e578-532a-99db-a0a68ce82607" "answer-3d50eb8e-496b-56e2-94e6-1a7eabb3b811" "answer-cd2ec6c3-f1ec-5eb7-861b-cf4f0d59c3e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-e26b87f9-c50c-58e9-8f87-82fc0ac53da1" :answer/id #uuid "e26b87f9-c50c-58e9-8f87-82fc0ac53da1" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-cad7cccd-d43c-5829-961d-b9d7fe417a9d" :answer/id #uuid "cad7cccd-d43c-5829-961d-b9d7fe417a9d" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=0$ only" :db/ensure [:answer/validate]} {:db/id "answer-f97ad6dd-e578-532a-99db-a0a68ce82607" :answer/id #uuid "f97ad6dd-e578-532a-99db-a0a68ce82607" :answer/type :answer.type/text :answer/value "$x=-2$ only" :db/ensure [:answer/validate]} {:db/id "answer-3d50eb8e-496b-56e2-94e6-1a7eabb3b811" :answer/id #uuid "3d50eb8e-496b-56e2-94e6-1a7eabb3b811" :answer/type :answer.type/text :answer/value "$x=-2,$ $x=-1$ and $x=0$" :db/ensure [:answer/validate]} {:db/id "answer-cd2ec6c3-f1ec-5eb7-861b-cf4f0d59c3e2" :answer/id #uuid "cd2ec6c3-f1ec-5eb7-861b-cf4f0d59c3e2" :answer/type :answer.type/text :answer/value "$x=0$ only" :db/ensure [:answer/validate]} {:db/id "question-1705d8ca-0ba8-5feb-91d5-1e7a97ff9132" :question/id #uuid "1705d8ca-0ba8-5feb-91d5-1e7a97ff9132" :question/math-academy-id "q-39502" :question/problem "![](images/e3/e3dc597ee47ba7b86f51b37725a0998cb23b148a23448f8c6db21cbb60a0c350.png)\n\nConsider the graph of $y=f(x)$ shown above. What are the equations of its vertical asymptotes?" :question/worked-solution "![](images/73/73bbd191451c2b7769ccd2903fd0e6c9da81a11853071bbfbed9711267903b9e.png)\n\nFrom the given graph, we see that as $x$ approaches $-1$ from the left, the values of $f(x)$ decrease, approaching $-\\infty .$ Also, notice that as $x$ approaches $-1$ from the right, the values of $f(x)$ increase, approaching $\\infty .$\n\nWe also see that as $x$ approaches $1$ from the left, the values of $f(x)$ increase, approaching $\\infty .$ And, as $x$ approaches $1$ from the right, the values of $f(x)$ decrease, approaching $-\\infty .$\n\nSo, we can write: \n\n- $f(x)\\to -\\infty $ as $x\\to -{1}^{-}$\n\n- $f(x)\\to \\infty $ as $x\\to -{1}^{+}$\n\n- $f(x)\\to \\infty $ as $x\\to {1}^{-}$\n\n- $f(x)\\to -\\infty $ as $x\\to {1}^{+}$\n\nThese give us the asymptotes $x=-1$ and $x=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4deadf1e-29b6-5a0e-9543-37299138f325"] :db/ensure [:question/validate]} {:db/id "answer-field-4deadf1e-29b6-5a0e-9543-37299138f325" :answer-field/id #uuid "4deadf1e-29b6-5a0e-9543-37299138f325" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f51a01e1-db08-5916-a3de-61fd006cfd10" :answer-field/choices ["answer-f51a01e1-db08-5916-a3de-61fd006cfd10" "answer-9836dd59-3429-506a-a5da-4a7f09061727" "answer-63cab16c-b0cd-5127-83bf-305e047b9217" "answer-8ef82baa-b2a6-5818-9426-d05b7a5450fd" "answer-f736d694-210e-5ab2-9a6d-00d1fc1ee568"] :db/ensure [:answer-field/validate]} {:db/id "answer-f51a01e1-db08-5916-a3de-61fd006cfd10" :answer/id #uuid "f51a01e1-db08-5916-a3de-61fd006cfd10" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=1$ only" :db/ensure [:answer/validate]} {:db/id "answer-9836dd59-3429-506a-a5da-4a7f09061727" :answer/id #uuid "9836dd59-3429-506a-a5da-4a7f09061727" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-63cab16c-b0cd-5127-83bf-305e047b9217" :answer/id #uuid "63cab16c-b0cd-5127-83bf-305e047b9217" :answer/type :answer.type/text :answer/value "$x=-1,$ $x=0$, and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-8ef82baa-b2a6-5818-9426-d05b7a5450fd" :answer/id #uuid "8ef82baa-b2a6-5818-9426-d05b7a5450fd" :answer/type :answer.type/text :answer/value "$x=0,$ $x=1$, and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-f736d694-210e-5ab2-9a6d-00d1fc1ee568" :answer/id #uuid "f736d694-210e-5ab2-9a6d-00d1fc1ee568" :answer/type :answer.type/text :answer/value "$x=1$ only" :db/ensure [:answer/validate]} {:db/id 17592186130335 :tutorial/content "Sometimes, a function might increase or decrease without bound when its input gets close to a specific value.\n\nFor example, consider the function whose graph is shown below:\n\n![](images/21/2163d96abc422e376581a693a6270da9d45ccc79d426d89f7ba9d1b046e2a254.png)\n\nAs the input $x$ gets closer to $1,$ the values of the function get larger and larger.\n\n![](images/c3/c367d69e8ef7369e81872f6f78460d8a2052a35e31d8f46e2b072d24a6d83f5a.png)\n\nWhen this happens, we say that the function approaches \"infinity\", or that it has an **infinite limit** at $x=1.$ We can write this mathematically, as follows:\n\n$$\nf(x) \\rightarrow \\infty\\quad \\text{as}\\quad x \\rightarrow 1\n$$\n\nIn words, this reads \"the function $f(x)$ approaches infinity as $x$ approaches $1$\".\n\nNow, consider the function $y = g(x),$ shown below. This is an example of a function that *decreases* without bound.\n\n![](images/a2/a21c625314d96dca5e724064bc35e67bed7c61fd56acc993cd7d281da29a2062.png)\n\nThe function $g(x)$ approaches negative infinity as $x$ approaches $1.$ So, we can write\n\n$$\ng(x) \\rightarrow -\\infty\\quad  \\text{as } \\quad x \\rightarrow 1.\n$$\n\nIn words, this reads \"the function $g(x)$ approaches negative infinity as $x$ approaches $1$\"." :db/ensure [:tutorial/validate]} {:db/id 17592186130336 :tutorial/content "We know that some functions approach infinity as $x$ approaches a certain value, like the function $y=f(x)$ plotted below.\n\n![](images/da/da7878b503b9dff8f04c0f2c42e021353dc8b5fa744476fa0227bb954472c5ed.png)\n\nHere, the function shoots upwards when $x$ approaches $2$ *from the right*, that is, from the positive direction of the $x$-axis.\n\nWe say that the function approaches positive infinity as $x$ approaches $2$ from the right, and we write\n\n$$\nf(x) \\rightarrow \\infty \\quad \\text{as} \\quad x \\rightarrow 2^+,\n$$\n\nwhere the superscript $+$ next to the $2$ indicates that $x$ approaches $2$ from the right.\n\nSimilar to the case above, we can have a function that shoots upwards or downwards when $x$ approaches a finite value *from the left*, that is, from the negative direction of the $x$-axis. Consider the function $y=g(x),$ shown below.\n\n![](images/2c/2c3d79df60e6b0a5627f39e8397a1eb9dc6c5e48fb1e816f6adc5309545ffb29.png)\n\nWe say that the function approaches negative infinity as $x$ approaches $2$ from the left, and we write\n\n$$\ng(x) \\rightarrow -\\infty \\quad \\text{as} \\quad x \\rightarrow 2^-,\n$$\n\nwhere the superscript $-$ indicates that $x$ approaches $2$ from the left." :db/ensure [:tutorial/validate]} {:db/id 17592186130338 :tutorial/content "We know that some functions approach infinity as $x$ approaches a certain value from one side, like the functions $y=f(x)$ and $y=g(x)$ plotted below.\n\n![](images/1b/1b1633611a2ea867e44845a8ba484e253671b9d5c74629f4a153ea79cf9a62e0.png)\n\nWe call the line $x=2$ a **vertical asymptote** of the functions $y = f(x)$ and $y=g(x).$\n\nAn asymptote is a line that a function gets very close to but never touches. In general, if a function $f(x)$ has an infinite limit (positive or negative) at a point $a,$ then we write\n\n$$\nf(x) \\rightarrow \\pm \\infty \\quad \\text{as} \\quad x \\rightarrow a^+\n$$\n\nor\n\n$$\nf(x)\\rightarrow \\pm\\infty  \\quad \\text{as} \\quad x \\rightarrow a^-\n$$\n\nand $x=a$ is a vertical asymptote of the function." :db/ensure [:tutorial/validate]} {:db/id 17592186129379 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186187020 :answer-field/choices 17592186187024] [:db/retract 17592186187020 :answer-field/choices 17592186187025] [:db/retract 17592186187020 :answer-field/choices 17592186187021] [:db/retract 17592186187020 :answer-field/choices 17592186187022] [:db/retract 17592186187020 :answer-field/choices 17592186187023] [:db/retract 17592186187038 :answer-field/choices 17592186187040] [:db/retract 17592186187038 :answer-field/choices 17592186187041] [:db/retract 17592186187038 :answer-field/choices 17592186187042] [:db/retract 17592186187038 :answer-field/choices 17592186187043] [:db/retract 17592186187038 :answer-field/choices 17592186187039] {:db/id 17592186188355 :knowledge-point/questions ["question-dcf740fc-84e9-5215-a4db-974afa421f20" "question-ef075455-3a78-5d07-aadc-6948b6898570" "question-847972c0-6f90-54f3-90b0-10ccc1176f30" "question-89c1f4fa-b7a3-52ff-a3e0-636f4aa1573d" "question-cc3c12f1-dbf7-51f0-875a-0336c3cabe74"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188063 :question/problem "![](images/21/21780b1ef6e634615275f2ae4681ac6722398e7400a02a3cb9daf07b8b407da8.svg)\n\nThe covariance matrix $\\Sigma$ for some random variables $X_1, X_2,$ and $X_3$ is given above. Find $a + b + c.$" :question/worked-solution "For random variables $X_1, \\ldots, X_n,$ the covariance matrix $\\Sigma$ is given by\n\n![](images/4a/4a9170c03d62e3946d5c825c9baa688fcbcb35247ff123764de3970635977a8d.svg)\n\nThat is,\n\n- the $i$th diagonal element is $\\Sigma_{ii} = \\textrm{Var}[X_i],$ and\n\n- the element in the $i$th row and $j$th column for $i \\neq j$ is $\\Sigma_{ij} = \\textrm{Cov}[X_i, X_j].$\n\nNow, note that\n\n$$\n\\textrm{Cov}[X,Y] = \\textrm{Cov}[Y,X].\n$$\n\nAs a result, the covariance matrix is always symmetric (moreover, it is a positive semi-definite matrix). \n\nSo, we can find the missing elements as follows:\n\n- $a = \\Sigma_{21} = \\textrm{Cov}[X_2,X_1] = \\textrm{Cov}[X_1,X_2] = \\Sigma_{12} = 2$\n\n- $b = \\Sigma_{23} = \\textrm{Cov}[X_2,X_3] = \\textrm{Cov}[X_3,X_2] = \\Sigma_{32} = 1$\n\n- $c = \\Sigma_{31} = \\textrm{Cov}[X_3,X_1] = \\textrm{Cov}[X_1,X_3] = \\Sigma_{13} = 0$\n\nTherefore, $a + b + c = 2 + 1 +0 = 3.$" :db/ensure [:question/validate]} {:db/id 17592186188363 :knowledge-point/questions ["question-cae81e4a-bed5-56e8-841e-be25ff76e753" "question-72d6fd40-f077-555f-a2ea-48615443e754" "question-29dbfdc5-a896-5333-926c-2c4e2687cdd6" "question-ea8dc2eb-77b6-5a6b-972c-806dd20059a5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188071 :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\textrm{E}[X] = 4,$ $\\textrm{E}[Y] = 3,$ mixed moment $\\textrm{E}[XY] = 9,$ and second raw moments $\\textrm{E}[X^2] = 18$ and $\\textrm{E}[Y^2] = 14.$ Find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $\\Sigma$ is given by\n\n![](images/4a/4a6aa6958f9b91163fba81f9a29f32d245af5902be44313efc786a2bf4da6099.svg)\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - \\textrm{E}[X]^2,\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\textrm{Cov}[X,Y] = \\textrm{E}[XY] - \\textrm{E}[X] \\cdot \\textrm{E}[Y].\n$$\n\nFirst, let's find $\\textrm{Var}[X]{:}$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =18-{4}^{2} \\\\  & =2\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =14-{3}^{2} \\\\  & =5.\\end{aligned}\n$$\n\nNow lets find $\\textrm{Cov}[X,Y]{:}$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =9-4\\cdot 3 \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n![](images/b9/b9d86366c14e62d805d7e046f27ef40cc572048ec7e9f868b6cf31cea94ee7a4.svg)" :db/ensure [:question/validate]} {:db/id 17592186188362 :knowledge-point/questions ["question-498cfd6b-9969-58ee-9468-55dacd0e9142" "question-b0df8fdd-91c9-54e0-8d8a-27e731147330" "question-f655f9f5-f0a0-522e-aa7b-2faf26b5e6dc" "question-2c722f59-6d05-5224-b152-d5620b69f9be" "question-67d9ef63-b4c5-5251-99ba-45e5490b628a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188070 :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n| $f$ | $Y=1$ | $Y=3$ |\n| --- | --- | --- |\n| $X=2$ | $0.3$ | $0.2$ |\n| $X=4$ | $0.1$ | $0.4$ |\n\nGiven that $\\textrm{E}[X] = 3$ and $\\textrm{E}[Y] = 2.2,$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $\\Sigma$ is given by\n![](images/c4/c457df4f5450340a178e0f8c951ece5643acb78295bd98fe935d0a81933a3112.svg)\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - \\textrm{E}[X]^2,\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\textrm{Cov}[X,Y] = \\textrm{E}[XY] - \\textrm{E}[X] \\cdot \\textrm{E}[Y].\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n| $f$ | $Y=1$ | $Y=3$ | $f_X$ |\n| --- | --- | --- | --- |\n| $X=2$ | $0.3$ | $0.2$ | $0.5$ |\n| $X=4$ | $0.1$ | $0.4$ | $0.5$ |\n| $f_Y$ | $0.4$ | $0.6$ | $1$ |\n\nNow, we can find $\\textrm{Var}[X].$ If $X$ is defined on a support $S_X,$ then\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot {f}_{X}(x) \\\\  & ={2}^{2}\\cdot 0.5+{4}^{2}\\cdot 0.5 \\\\  & =10.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =10-{3}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a support $S_Y,$ then\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{y}}{y}^{2}\\cdot {f}_{Y}(y) \\\\  & ={1}^{2}\\cdot 0.4+{3}^{2}\\cdot 0.6 \\\\  & =5.8.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =5.8-{2.2}^{2} \\\\  & =0.96.\\end{aligned}\n$$\n\nFinally, let's find $\\textrm{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\textrm{E}[XY]{:}$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{(x,y)\\in S}xy\\cdot f(x,y) \\\\  & =(2)(1)f(2,1)+(4)(1)f(4,1)+(2)(3)f(2,3)+(4)(3)f(4,3) \\\\  & =2\\cdot 0.3+4\\cdot 0.1+6\\cdot 0.2+12\\cdot 0.4 \\\\  & =7\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =7-3\\cdot 2.2 \\\\  & =0.4.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n![](images/27/27afb746d2ec171983cfa7b06d5f4f2c00909a92ac44abc5890b67d84f6eb5e9.svg)" :db/ensure [:question/validate]} {:db/id 17592186188364 :knowledge-point/questions ["question-4f28747a-e241-5f89-b726-699a85c63f84" "question-53e9c56c-8467-523e-bd98-6ac7236cb57e" "question-9895539f-08a9-52d3-aba6-0550c7a4d108" "question-7039fb00-3d4a-54d6-a4b0-1bcf58d49ef2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188072 :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n![](images/4a/4a0e63105483b697842963df430c5341abef68b83501e9d63d17653b88309c59.svg)\n\nIf $\\textrm{E}[X] = \\dfrac{7}{12},$ $\\textrm{E}[Y] = \\dfrac{5}{8},$ and $\\textrm{E}[XY]=\\dfrac{17}{48},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $\\Sigma$ is given by\n\n![](images/e7/e7e614e58780e1600532e0cd172674c921feaae0ff35b47a01d0befaa66230ac.svg)\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - \\textrm{E}[X]^2,\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\textrm{Cov}[X,Y] = \\textrm{E}[XY] - \\textrm{E}[X] \\cdot \\textrm{E}[Y].\n$$\n\nFirst, we find $\\textrm{Var}[X].$\nWe compute $\\textrm{E}[X^2]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{1}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{x}^{2}(x+\\frac{3}{2}{y}^{2})\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}({x}^{3}+\\frac{3}{2}{x}^{2}{y}^{2})\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{3}{y}^{2}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{1}{4}+\\frac{1}{2}{y}^{2})\\text{d}y \\\\  & ={[\\frac{1}{4}y+\\frac{1}{6}{y}^{3}]}_{0}^{1} \\\\  & =\\frac{1}{4}+\\frac{1}{6} \\\\  & =\\frac{5}{12}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{12}-{(\\frac{7}{12})}^{2} \\\\  & =\\frac{11}{144}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\textrm{E}[Y^2]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{y}^{2}(x+\\frac{3}{2}{y}^{2})\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(x{y}^{2}+\\frac{3}{2}{y}^{4})\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{2}{x}^{2}{y}^{2}+\\frac{3}{2}x{y}^{4}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{1}{2}{y}^{2}+\\frac{3}{2}{y}^{4})\\text{d}y \\\\  & ={[\\frac{1}{6}{y}^{3}+\\frac{3}{10}{y}^{5}]}_{0}^{1} \\\\  & =\\frac{1}{6}+\\frac{3}{10} \\\\  & =\\frac{7}{15}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{7}{15}-{(\\frac{5}{8})}^{2} \\\\  & =\\frac{73}{960}.\\end{aligned}\n$$\n\nFinally, let's find $\\textrm{Cov}[X,Y].$ Using the given results, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{17}{48}-(\\frac{7}{12})\\cdot (\\frac{5}{8}) \\\\  & =-\\frac{1}{96}.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n![](images/a1/a16a9b39d5ff75935e7394d1ff0f3eb03437bc000038b20925d1f91985386b48.svg)" :db/ensure [:question/validate]} {:db/id "question-dcf740fc-84e9-5215-a4db-974afa421f20" :question/id #uuid "dcf740fc-84e9-5215-a4db-974afa421f20" :question/math-academy-id "q-159302" :question/problem "$$\nΣ=[\\begin{aligned}9 & 0 & 0 \\\\ 0 & 4 & 2 \\\\ a & b & 1\\end{aligned}]\n$$\n\nThe covariance matrix $Σ$ for some random variables ${X}_{1},{X}_{2},$ and ${X}_{3}$ is given above. Find $a+b.$" :question/worked-solution "For random variables ${X}_{1},…,{X}_{n},$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[{X}_{1}] & \\text{Cov}[{X}_{1},{X}_{2}] & ⋯ & \\text{Cov}[{X}_{1},{X}_{n}] \\\\ \\text{Cov}[{X}_{2},{X}_{1}] & \\text{Var}[{X}_{2}] & ⋯ & \\text{Cov}[{X}_{2},{X}_{n}] \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\text{Cov}[{X}_{n},{X}_{1}] & \\text{Cov}[{X}_{n},{X}_{2}] & ⋯ & \\text{Var}[{X}_{n}]\\end{aligned}].\n$$\n\nThat is,\n\n- the $i$th diagonal element is ${Σ}_{ii}=\\text{Var}[{X}_{i}],$ and\n\n- the element in the $i$th row and $j$th column for $i\\ne j$ is ${Σ}_{ij}=\\text{Cov}[{X}_{i},{X}_{j}].$\n\nNow, note that\n\n$$\n\\text{Cov}[X,Y]=\\text{Cov}[Y,X].\n$$\n\nAs a result, the covariance matrix is always symmetric (moreover, it is a positive semi-definite matrix). \n\nSo, we can find the missing elements as follows:\n\n- $a={Σ}_{31}=\\text{Cov}[{X}_{3},{X}_{1}]=\\text{Cov}[{X}_{1},{X}_{3}]={Σ}_{13}=0$\n\n- $b={Σ}_{32}=\\text{Cov}[{X}_{3},{X}_{2}]=\\text{Cov}[{X}_{2},{X}_{3}]={Σ}_{23}=2$\n\nTherefore, $a+b=0+2=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5fadab62-7bc0-5380-9887-85d299772dbb"] :db/ensure [:question/validate]} {:db/id "answer-field-5fadab62-7bc0-5380-9887-85d299772dbb" :answer-field/id #uuid "5fadab62-7bc0-5380-9887-85d299772dbb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc935f2d-69c1-55c8-92f7-b1855d61503e" :answer-field/choices ["answer-7684fde1-d33b-56b3-bcf1-2e573af3f336" "answer-17d439c6-f9f2-509a-aa62-86fe12e95d6c" "answer-cc935f2d-69c1-55c8-92f7-b1855d61503e" "answer-179ae555-0cf8-5046-839f-e2bb315ad66a" "answer-673712b1-3e53-5bb6-b346-1759844e58b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-7684fde1-d33b-56b3-bcf1-2e573af3f336" :answer/id #uuid "7684fde1-d33b-56b3-bcf1-2e573af3f336" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-17d439c6-f9f2-509a-aa62-86fe12e95d6c" :answer/id #uuid "17d439c6-f9f2-509a-aa62-86fe12e95d6c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-cc935f2d-69c1-55c8-92f7-b1855d61503e" :answer/id #uuid "cc935f2d-69c1-55c8-92f7-b1855d61503e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-179ae555-0cf8-5046-839f-e2bb315ad66a" :answer/id #uuid "179ae555-0cf8-5046-839f-e2bb315ad66a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-673712b1-3e53-5bb6-b346-1759844e58b1" :answer/id #uuid "673712b1-3e53-5bb6-b346-1759844e58b1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-ef075455-3a78-5d07-aadc-6948b6898570" :question/id #uuid "ef075455-3a78-5d07-aadc-6948b6898570" :question/math-academy-id "q-159309" :question/problem "$$\nΣ=[\\begin{aligned}5 & a \\\\ 3 & 4\\end{aligned}]\n$$\n\nThe covariance matrix $Σ$ for some random variables ${X}_{1}$ and ${X}_{2}$ is given above. Find $a.$" :question/worked-solution "For random variables ${X}_{1},…,{X}_{n},$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[{X}_{1}] & \\text{Cov}[{X}_{1},{X}_{2}] & ⋯ & \\text{Cov}[{X}_{1},{X}_{n}] \\\\ \\text{Cov}[{X}_{2},{X}_{1}] & \\text{Var}[{X}_{2}] & ⋯ & \\text{Cov}[{X}_{2},{X}_{n}] \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\text{Cov}[{X}_{n},{X}_{1}] & \\text{Cov}[{X}_{n},{X}_{2}] & ⋯ & \\text{Var}[{X}_{n}]\\end{aligned}].\n$$\n\nThat is,\n\n- the $i$th diagonal element is ${Σ}_{ii}=\\text{Var}[{X}_{i}],$ and\n\n- the element in the $i$th row and $j$th column for $i\\ne j$ is ${Σ}_{ij}=\\text{Cov}[{X}_{i},{X}_{j}].$\n\nNow, note that\n\n$$\n\\text{Cov}[X,Y]=\\text{Cov}[Y,X].\n$$\n\nAs a result, the covariance matrix is always symmetric (moreover, it is a positive semi-definite matrix). \n\nSo, we can find the missing elements as follows:\n\n- $a={Σ}_{12}=\\text{Cov}[{X}_{1},{X}_{2}]=\\text{Cov}[{X}_{2},{X}_{1}]={Σ}_{21}=3$\n\nTherefore, $a=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-74a4e5cf-b19c-51b8-aa94-11f87242a385"] :db/ensure [:question/validate]} {:db/id "answer-field-74a4e5cf-b19c-51b8-aa94-11f87242a385" :answer-field/id #uuid "74a4e5cf-b19c-51b8-aa94-11f87242a385" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4bc96003-4d3d-5775-99b8-1aa90fcfc7e3" :answer-field/choices ["answer-acb77e59-b789-5c45-a661-4f088cb01c70" "answer-2921d166-d921-581c-9b9a-37d5f327bf17" "answer-4bc96003-4d3d-5775-99b8-1aa90fcfc7e3" "answer-610030e0-629d-52b1-8c62-4d3373d13fea" "answer-800973ee-5a75-5845-8cc8-fdeeef80ea74"] :db/ensure [:answer-field/validate]} {:db/id "answer-acb77e59-b789-5c45-a661-4f088cb01c70" :answer/id #uuid "acb77e59-b789-5c45-a661-4f088cb01c70" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-2921d166-d921-581c-9b9a-37d5f327bf17" :answer/id #uuid "2921d166-d921-581c-9b9a-37d5f327bf17" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-4bc96003-4d3d-5775-99b8-1aa90fcfc7e3" :answer/id #uuid "4bc96003-4d3d-5775-99b8-1aa90fcfc7e3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-610030e0-629d-52b1-8c62-4d3373d13fea" :answer/id #uuid "610030e0-629d-52b1-8c62-4d3373d13fea" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-800973ee-5a75-5845-8cc8-fdeeef80ea74" :answer/id #uuid "800973ee-5a75-5845-8cc8-fdeeef80ea74" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-847972c0-6f90-54f3-90b0-10ccc1176f30" :question/id #uuid "847972c0-6f90-54f3-90b0-10ccc1176f30" :question/math-academy-id "q-159299" :question/problem "$$\nΣ=[\\begin{aligned}2 & a & 0 \\\\ 1 & 3 & b \\\\ c & 1 & 2\\end{aligned}]\n$$\n\nThe covariance matrix $Σ$ for some random variables ${X}_{1},{X}_{2},$ and ${X}_{3}$ is given above. Find $a+b+c.$" :question/worked-solution "For random variables ${X}_{1},…,{X}_{n},$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[{X}_{1}] & \\text{Cov}[{X}_{1},{X}_{2}] & ⋯ & \\text{Cov}[{X}_{1},{X}_{n}] \\\\ \\text{Cov}[{X}_{2},{X}_{1}] & \\text{Var}[{X}_{2}] & ⋯ & \\text{Cov}[{X}_{2},{X}_{n}] \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\text{Cov}[{X}_{n},{X}_{1}] & \\text{Cov}[{X}_{n},{X}_{2}] & ⋯ & \\text{Var}[{X}_{n}]\\end{aligned}].\n$$\n\nThat is,\n\n- the $i$th diagonal element is ${Σ}_{ii}=\\text{Var}[{X}_{i}],$ and\n\n- the element in the $i$th row and $j$th column for $i\\ne j$ is ${Σ}_{ij}=\\text{Cov}[{X}_{i},{X}_{j}].$\n\nNow, note that\n\n$$\n\\text{Cov}[X,Y]=\\text{Cov}[Y,X].\n$$\n\nAs a result, the covariance matrix is always symmetric (moreover, it is a positive semi-definite matrix). \n\nSo, we can find the missing elements as follows:\n\n- $a={Σ}_{12}=\\text{Cov}[{X}_{1},{X}_{2}]=\\text{Cov}[{X}_{2},{X}_{1}]={Σ}_{21}=1$\n\n- $b={Σ}_{23}=\\text{Cov}[{X}_{2},{X}_{3}]=\\text{Cov}[{X}_{3},{X}_{2}]={Σ}_{32}=1$\n\n- $c={Σ}_{31}=\\text{Cov}[{X}_{3},{X}_{1}]=\\text{Cov}[{X}_{1},{X}_{3}]={Σ}_{13}=0$\n\nTherefore, $a+b+c=1+1+0=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-18ece77b-cabe-5c31-b599-52fb25ac49a2"] :db/ensure [:question/validate]} {:db/id "answer-field-18ece77b-cabe-5c31-b599-52fb25ac49a2" :answer-field/id #uuid "18ece77b-cabe-5c31-b599-52fb25ac49a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5ad50d19-89cd-5b90-93fc-253e38284494" :answer-field/choices ["answer-5ad50d19-89cd-5b90-93fc-253e38284494" "answer-c21d0edf-d85d-510d-8c4b-8c82083f83db" "answer-2a7263a0-4076-5c8a-bf2b-7ef8f639c709" "answer-b5245d4f-7082-5752-b664-dc2f204a93ee" "answer-8bf6a545-5662-5239-8a46-31ba0f543614"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ad50d19-89cd-5b90-93fc-253e38284494" :answer/id #uuid "5ad50d19-89cd-5b90-93fc-253e38284494" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c21d0edf-d85d-510d-8c4b-8c82083f83db" :answer/id #uuid "c21d0edf-d85d-510d-8c4b-8c82083f83db" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-2a7263a0-4076-5c8a-bf2b-7ef8f639c709" :answer/id #uuid "2a7263a0-4076-5c8a-bf2b-7ef8f639c709" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-b5245d4f-7082-5752-b664-dc2f204a93ee" :answer/id #uuid "b5245d4f-7082-5752-b664-dc2f204a93ee" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-8bf6a545-5662-5239-8a46-31ba0f543614" :answer/id #uuid "8bf6a545-5662-5239-8a46-31ba0f543614" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-89c1f4fa-b7a3-52ff-a3e0-636f4aa1573d" :question/id #uuid "89c1f4fa-b7a3-52ff-a3e0-636f4aa1573d" :question/math-academy-id "q-159304" :question/problem "$$\nΣ=[\\begin{aligned}3 & a \\\\ 1 & 2\\end{aligned}]\n$$\n\nThe covariance matrix $Σ$ for some random variables${X}_{1}$ and ${X}_{2}$ is given above. Find $a.$" :question/worked-solution "For random variables ${X}_{1},…,{X}_{n},$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[{X}_{1}] & \\text{Cov}[{X}_{1},{X}_{2}] & ⋯ & \\text{Cov}[{X}_{1},{X}_{n}] \\\\ \\text{Cov}[{X}_{2},{X}_{1}] & \\text{Var}[{X}_{2}] & ⋯ & \\text{Cov}[{X}_{2},{X}_{n}] \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\text{Cov}[{X}_{n},{X}_{1}] & \\text{Cov}[{X}_{n},{X}_{2}] & ⋯ & \\text{Var}[{X}_{n}]\\end{aligned}].\n$$\n\nThat is,\n\n- the $i$th diagonal element is ${Σ}_{ii}=\\text{Var}[{X}_{i}],$ and\n\n- the element in the $i$th row and $j$th column for $i\\ne j$ is ${Σ}_{ij}=\\text{Cov}[{X}_{i},{X}_{j}].$\n\nNow, note that\n\n$$\n\\text{Cov}[X,Y]=\\text{Cov}[Y,X].\n$$\n\nAs a result, the covariance matrix is always symmetric (moreover, it is a positive semi-definite matrix). \n\nSo, we can find the missing elements as follows:\n\n- $a={Σ}_{12}=\\text{Cov}[{X}_{1},{X}_{2}]=\\text{Cov}[{X}_{2},{X}_{1}]={Σ}_{21}=1$\n\nTherefore, $a=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a5e9fda2-d0c9-5617-8daa-b5eb8702fda8"] :db/ensure [:question/validate]} {:db/id "answer-field-a5e9fda2-d0c9-5617-8daa-b5eb8702fda8" :answer-field/id #uuid "a5e9fda2-d0c9-5617-8daa-b5eb8702fda8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e737b3e-2f18-53be-a811-3a02e6d46165" :answer-field/choices ["answer-fa6df6eb-25d5-5f0c-8b5c-7016a410eedf" "answer-66edc399-fbce-5668-b0c8-4afdbacf1e59" "answer-7e737b3e-2f18-53be-a811-3a02e6d46165" "answer-29b8007a-7576-50c7-a941-bfc6800ec82d" "answer-552bfb8d-466d-54ab-9d47-28aa839de529"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa6df6eb-25d5-5f0c-8b5c-7016a410eedf" :answer/id #uuid "fa6df6eb-25d5-5f0c-8b5c-7016a410eedf" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-66edc399-fbce-5668-b0c8-4afdbacf1e59" :answer/id #uuid "66edc399-fbce-5668-b0c8-4afdbacf1e59" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-7e737b3e-2f18-53be-a811-3a02e6d46165" :answer/id #uuid "7e737b3e-2f18-53be-a811-3a02e6d46165" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-29b8007a-7576-50c7-a941-bfc6800ec82d" :answer/id #uuid "29b8007a-7576-50c7-a941-bfc6800ec82d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-552bfb8d-466d-54ab-9d47-28aa839de529" :answer/id #uuid "552bfb8d-466d-54ab-9d47-28aa839de529" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-cc3c12f1-dbf7-51f0-875a-0336c3cabe74" :question/id #uuid "cc3c12f1-dbf7-51f0-875a-0336c3cabe74" :question/math-academy-id "q-159300" :question/problem "$$\nΣ=[\\begin{aligned}3 & 1 & 1 \\\\ a & 2 & b \\\\ 1 & 0 & 2\\end{aligned}]\n$$\n\nThe covariance matrix $Σ$ for some random variables ${X}_{1},{X}_{2},$ and ${X}_{3}$ is given above. Find $a+b.$" :question/worked-solution "For random variables ${X}_{1},…,{X}_{n},$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[{X}_{1}] & \\text{Cov}[{X}_{1},{X}_{2}] & ⋯ & \\text{Cov}[{X}_{1},{X}_{n}] \\\\ \\text{Cov}[{X}_{2},{X}_{1}] & \\text{Var}[{X}_{2}] & ⋯ & \\text{Cov}[{X}_{2},{X}_{n}] \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ \\text{Cov}[{X}_{n},{X}_{1}] & \\text{Cov}[{X}_{n},{X}_{2}] & ⋯ & \\text{Var}[{X}_{n}]\\end{aligned}].\n$$\n\nThat is,\n\n- the $i$th diagonal element is ${Σ}_{ii}=\\text{Var}[{X}_{i}],$ and\n\n- the element in the $i$th row and $j$th column for $i\\ne j$ is ${Σ}_{ij}=\\text{Cov}[{X}_{i},{X}_{j}].$\n\nNow, note that\n\n$$\n\\text{Cov}[X,Y]=\\text{Cov}[Y,X].\n$$\n\nAs a result, the covariance matrix is always symmetric (moreover, it is a positive semi-definite matrix). \n\nSo, we can find the missing elements as follows:\n\n- $a={Σ}_{21}=\\text{Cov}[{X}_{2},{X}_{1}]=\\text{Cov}[{X}_{1},{X}_{2}]={Σ}_{12}=1$\n\n- $b={Σ}_{23}=\\text{Cov}[{X}_{2},{X}_{3}]=\\text{Cov}[{X}_{3},{X}_{2}]={Σ}_{32}=0$\n\nTherefore, $a+b=1+0=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9a904e50-7e60-5751-ab67-cc77c08ff21a"] :db/ensure [:question/validate]} {:db/id "answer-field-9a904e50-7e60-5751-ab67-cc77c08ff21a" :answer-field/id #uuid "9a904e50-7e60-5751-ab67-cc77c08ff21a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45514e1f-281c-598d-9509-50a74cbf7a87" :answer-field/choices ["answer-45514e1f-281c-598d-9509-50a74cbf7a87" "answer-f0618289-dca3-5dc0-bcbd-4eac5be4c5a2" "answer-f8a35b08-5cdb-5fb6-b020-87e2fc8342e2" "answer-8d59eb94-f7fb-5092-8e24-c25a0ebe9daa" "answer-0eb83ca6-c5af-599a-b4a2-ce490e201e54"] :db/ensure [:answer-field/validate]} {:db/id "answer-45514e1f-281c-598d-9509-50a74cbf7a87" :answer/id #uuid "45514e1f-281c-598d-9509-50a74cbf7a87" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-f0618289-dca3-5dc0-bcbd-4eac5be4c5a2" :answer/id #uuid "f0618289-dca3-5dc0-bcbd-4eac5be4c5a2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f8a35b08-5cdb-5fb6-b020-87e2fc8342e2" :answer/id #uuid "f8a35b08-5cdb-5fb6-b020-87e2fc8342e2" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-8d59eb94-f7fb-5092-8e24-c25a0ebe9daa" :answer/id #uuid "8d59eb94-f7fb-5092-8e24-c25a0ebe9daa" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-0eb83ca6-c5af-599a-b4a2-ce490e201e54" :answer/id #uuid "0eb83ca6-c5af-599a-b4a2-ce490e201e54" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186188790 :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=2,$ $\\text{E}[Y]=4,$ mixed moment $\\text{E}[XY]=10,$ and second raw moments $\\text{E}[{X}^{2}]=9$ and $\\text{E}[{Y}^{2}]=20.$ Find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =9-{2}^{2} \\\\  & =5.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =20-{4}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nNow lets find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =10-2\\cdot 4 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}5 & 2 \\\\ 2 & 4\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186187020 :answer-field/correct "answer-42f26747-e73f-585c-ac6e-199a99404cbb" :answer-field/choices ["answer-bf58e07d-f149-57e2-8a07-3c1b1f8703a9" "answer-64529e3f-0c34-5f86-9d4f-48706fda59b5" "answer-fa3e1fb2-59d9-5c07-b6fb-3e6cd3182503" "answer-42f26747-e73f-585c-ac6e-199a99404cbb" "answer-986fdf6a-6bc1-5fff-82d4-52582eabab4c"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf58e07d-f149-57e2-8a07-3c1b1f8703a9" :answer/id #uuid "bf58e07d-f149-57e2-8a07-3c1b1f8703a9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & 9 \\\\ 2 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-64529e3f-0c34-5f86-9d4f-48706fda59b5" :answer/id #uuid "64529e3f-0c34-5f86-9d4f-48706fda59b5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 10 \\\\ 10 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fa3e1fb2-59d9-5c07-b6fb-3e6cd3182503" :answer/id #uuid "fa3e1fb2-59d9-5c07-b6fb-3e6cd3182503" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 1 \\\\ 1 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-42f26747-e73f-585c-ac6e-199a99404cbb" :answer/id #uuid "42f26747-e73f-585c-ac6e-199a99404cbb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 2 \\\\ 2 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-986fdf6a-6bc1-5fff-82d4-52582eabab4c" :answer/id #uuid "986fdf6a-6bc1-5fff-82d4-52582eabab4c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 10 \\\\ 10 & 16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-cae81e4a-bed5-56e8-841e-be25ff76e753" :question/id #uuid "cae81e4a-bed5-56e8-841e-be25ff76e753" :question/math-academy-id "q-159369" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=3,$ $\\text{E}[Y]=1,$ mixed moment $\\text{E}[XY]=4,$ and second raw moments $\\text{E}[{X}^{2}]=10$ and $\\text{E}[{Y}^{2}]=4.$ Find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =10-{3}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =4-{1}^{2} \\\\  & =3.\\end{aligned}\n$$\n\nNow lets find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =4-3\\cdot 1 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}1 & 1 \\\\ 1 & 3\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2b1bad76-5478-5037-a22f-95c8d75dbbe9"] :db/ensure [:question/validate]} {:db/id "answer-field-2b1bad76-5478-5037-a22f-95c8d75dbbe9" :answer-field/id #uuid "2b1bad76-5478-5037-a22f-95c8d75dbbe9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5573dd6f-f3e4-550f-872e-c2f443e9bdd4" :answer-field/choices ["answer-5573dd6f-f3e4-550f-872e-c2f443e9bdd4" "answer-abdceee3-f8fd-5a9a-b7f6-4ee239047601" "answer-5239a141-bf7d-5658-bb2f-df63fbdbb88d" "answer-eb663fe2-f592-5971-9d46-f608f6220c1b" "answer-be5bed0d-e0c3-5858-ad2d-ed53ca98ebad"] :db/ensure [:answer-field/validate]} {:db/id "answer-5573dd6f-f3e4-550f-872e-c2f443e9bdd4" :answer/id #uuid "5573dd6f-f3e4-550f-872e-c2f443e9bdd4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 \\\\ 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-abdceee3-f8fd-5a9a-b7f6-4ee239047601" :answer/id #uuid "abdceee3-f8fd-5a9a-b7f6-4ee239047601" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 4 \\\\ 4 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5239a141-bf7d-5658-bb2f-df63fbdbb88d" :answer/id #uuid "5239a141-bf7d-5658-bb2f-df63fbdbb88d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & 1 \\\\ 1 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-eb663fe2-f592-5971-9d46-f608f6220c1b" :answer/id #uuid "eb663fe2-f592-5971-9d46-f608f6220c1b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}10 & 3 \\\\ 1 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-be5bed0d-e0c3-5858-ad2d-ed53ca98ebad" :answer/id #uuid "be5bed0d-e0c3-5858-ad2d-ed53ca98ebad" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -36 \\\\ -36 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-72d6fd40-f077-555f-a2ea-48615443e754" :question/id #uuid "72d6fd40-f077-555f-a2ea-48615443e754" :question/math-academy-id "q-159366" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=6,$ $\\text{E}[Y]=7,$ mixed moment $\\text{E}[XY]=40,$ and variances $\\text{Var}[X]=2$ and $\\text{Var}[Y]=5.$ Find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nUsing the above formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =40-6\\cdot 7 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}2 & -2 \\\\ -2 & 5\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7c168029-f889-5fc1-8200-9cf79199ce99"] :db/ensure [:question/validate]} {:db/id "answer-field-7c168029-f889-5fc1-8200-9cf79199ce99" :answer-field/id #uuid "7c168029-f889-5fc1-8200-9cf79199ce99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c4706484-e47e-53d7-916e-7f3834b2f527" :answer-field/choices ["answer-c4706484-e47e-53d7-916e-7f3834b2f527" "answer-a451da81-2342-5e07-a6f8-5dec64943041" "answer-a562d998-1234-5593-adcf-b17837715b7e" "answer-cddd1084-3169-5e4a-8361-489a8477cc24" "answer-b3a2bba6-91a4-580c-9f2a-a7c46f1f9ba3"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4706484-e47e-53d7-916e-7f3834b2f527" :answer/id #uuid "c4706484-e47e-53d7-916e-7f3834b2f527" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -2 \\\\ -2 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a451da81-2342-5e07-a6f8-5dec64943041" :answer/id #uuid "a451da81-2342-5e07-a6f8-5dec64943041" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 2 \\\\ 2 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a562d998-1234-5593-adcf-b17837715b7e" :answer/id #uuid "a562d998-1234-5593-adcf-b17837715b7e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 40 \\\\ 40 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cddd1084-3169-5e4a-8361-489a8477cc24" :answer/id #uuid "cddd1084-3169-5e4a-8361-489a8477cc24" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 2 \\\\ 5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b3a2bba6-91a4-580c-9f2a-a7c46f1f9ba3" :answer/id #uuid "b3a2bba6-91a4-580c-9f2a-a7c46f1f9ba3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 30 \\\\ 30 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-29dbfdc5-a896-5333-926c-2c4e2687cdd6" :question/id #uuid "29dbfdc5-a896-5333-926c-2c4e2687cdd6" :question/math-academy-id "q-159373" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=3,$ $\\text{E}[Y]=5,$ mixed moment $\\text{E}[XY]=10,$ and second raw moments $\\text{E}[{X}^{2}]=16$ and $\\text{E}[{Y}^{2}]=31.$ Find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =16-{3}^{2} \\\\  & =7.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =31-{5}^{2} \\\\  & =6.\\end{aligned}\n$$\n\nNow lets find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =10-3\\cdot 5 \\\\  & =-5.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}7 & -5 \\\\ -5 & 6\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-633f0d3c-8b4a-54a7-a87f-04b8012968de"] :db/ensure [:question/validate]} {:db/id "answer-field-633f0d3c-8b4a-54a7-a87f-04b8012968de" :answer-field/id #uuid "633f0d3c-8b4a-54a7-a87f-04b8012968de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2f570de4-595d-57a4-817e-0177624b7327" :answer-field/choices ["answer-25d7cc4e-69e8-52ab-a7db-2e02b18378c0" "answer-858e8b64-89a3-525e-a632-86d0e4430fb0" "answer-a1702269-bbef-5047-bac9-8bafb421d755" "answer-2f570de4-595d-57a4-817e-0177624b7327" "answer-039aa489-bcf6-5182-bbed-08d284bdcb3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-25d7cc4e-69e8-52ab-a7db-2e02b18378c0" :answer/id #uuid "25d7cc4e-69e8-52ab-a7db-2e02b18378c0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -5 \\\\ -5 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-858e8b64-89a3-525e-a632-86d0e4430fb0" :answer/id #uuid "858e8b64-89a3-525e-a632-86d0e4430fb0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 10 \\\\ 10 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a1702269-bbef-5047-bac9-8bafb421d755" :answer/id #uuid "a1702269-bbef-5047-bac9-8bafb421d755" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 5 \\\\ 5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2f570de4-595d-57a4-817e-0177624b7327" :answer/id #uuid "2f570de4-595d-57a4-817e-0177624b7327" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & -5 \\\\ -5 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-039aa489-bcf6-5182-bbed-08d284bdcb3d" :answer/id #uuid "039aa489-bcf6-5182-bbed-08d284bdcb3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}7 & 3 \\\\ 5 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-ea8dc2eb-77b6-5a6b-972c-806dd20059a5" :question/id #uuid "ea8dc2eb-77b6-5a6b-972c-806dd20059a5" :question/math-academy-id "q-159371" :question/problem "Consider two random variables $X$ and $Y$ with expectations $\\text{E}[X]=2,$ $\\text{E}[Y]=3,$ mixed moment $\\text{E}[XY]=6,$ and second raw moments $\\text{E}[{X}^{2}]=9$ and $\\text{E}[{Y}^{2}]=17.$ Find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find $\\text{Var}[X]:$\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =9-{2}^{2} \\\\  & =5.\\end{aligned}\n$$\n\nSimilarly,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =17-{3}^{2} \\\\  & =8.\\end{aligned}\n$$\n\nNow lets find $\\text{Cov}[X,Y]:$\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =6-2\\cdot 3 \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}5 & 0 \\\\ 0 & 8\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6e674815-858b-557f-9bb3-eda2dd10d5bb"] :db/ensure [:question/validate]} {:db/id "answer-field-6e674815-858b-557f-9bb3-eda2dd10d5bb" :answer-field/id #uuid "6e674815-858b-557f-9bb3-eda2dd10d5bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-90739cf3-46a8-5d3a-a97b-8598afc71c7e" :answer-field/choices ["answer-94938d70-fccc-53b2-81dc-000bf63ebcbc" "answer-500cd04e-121c-5ac9-8280-695271e27690" "answer-90739cf3-46a8-5d3a-a97b-8598afc71c7e" "answer-a5a64a65-b8ad-5c0f-87ad-0b1a06c87250" "answer-8ed049c1-daad-5bec-907a-225c42ecb2e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-94938d70-fccc-53b2-81dc-000bf63ebcbc" :answer/id #uuid "94938d70-fccc-53b2-81dc-000bf63ebcbc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-500cd04e-121c-5ac9-8280-695271e27690" :answer/id #uuid "500cd04e-121c-5ac9-8280-695271e27690" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 8 \\\\ 8 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-90739cf3-46a8-5d3a-a97b-8598afc71c7e" :answer/id #uuid "90739cf3-46a8-5d3a-a97b-8598afc71c7e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 0 \\\\ 0 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a5a64a65-b8ad-5c0f-87ad-0b1a06c87250" :answer/id #uuid "a5a64a65-b8ad-5c0f-87ad-0b1a06c87250" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 2 \\\\ 3 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8ed049c1-daad-5bec-907a-225c42ecb2e2" :answer/id #uuid "8ed049c1-daad-5bec-907a-225c42ecb2e2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 6 \\\\ 6 & 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-498cfd6b-9969-58ee-9468-55dacd0e9142" :question/id #uuid "498cfd6b-9969-58ee-9468-55dacd0e9142" :question/math-academy-id "q-159406" :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=2$ | $0.55$ | $0.25$ |\n| $X=3$ | $0.05$ | $0.15$ |\n\nGiven that $\\text{E}[X]=2.2$ and $\\text{E}[Y]=1.4,$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=2$ | $0.55$ | $0.25$ | $0.8$ |\n| $X=3$ | $0.05$ | $0.15$ | $0.2$ |\n| ${f}_{Y}$ | $0.6$ | $0.4$ | $1$ |\n\nNow, we can find $\\text{Var}[X].$ If $X$ is defined on a support ${S}_{X},$ then\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot {f}_{X}(x) \\\\  & ={2}^{2}\\cdot 0.8+{3}^{2}\\cdot 0.2 \\\\  & =5.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =5-{2.2}^{2} \\\\  & =0.16.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a support ${S}_{Y},$ then\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{y}}{y}^{2}\\cdot {f}_{Y}(y) \\\\  & ={1}^{2}\\cdot 0.6+{2}^{2}\\cdot 0.4 \\\\  & =2.2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =2.2-{1.4}^{2} \\\\  & =0.24.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{(x,y)\\in S}xy\\cdot f(x,y) \\\\  & =(2)(1)f(2,1)+(3)(1)f(3,1)+(2)(2)f(2,2)+(3)(2)f(3,2) \\\\  & =2\\cdot 0.55+3\\cdot 0.05+4\\cdot 0.25+6\\cdot 0.15 \\\\  & =3.15.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =3.15-2.2\\cdot 1.4 \\\\  & =0.07.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}0.16 & 0.07 \\\\ 0.07 & 0.24\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c7d1b7f0-9375-5f6f-bc52-a79347709299"] :db/ensure [:question/validate]} {:db/id "answer-field-c7d1b7f0-9375-5f6f-bc52-a79347709299" :answer-field/id #uuid "c7d1b7f0-9375-5f6f-bc52-a79347709299" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1475ee74-c0d3-5ee6-aa81-f0f5cdcab5f8" :answer-field/choices ["answer-793608fa-e9eb-5e5a-8e83-288dd037a5f2" "answer-9f252122-7a78-5806-a3f7-44a4c28dc4f5" "answer-71264c49-74b7-50ea-bc44-c7d200e335a7" "answer-1475ee74-c0d3-5ee6-aa81-f0f5cdcab5f8" "answer-6fc5a00d-83e6-59b0-b208-3d137720bd47"] :db/ensure [:answer-field/validate]} {:db/id "answer-793608fa-e9eb-5e5a-8e83-288dd037a5f2" :answer/id #uuid "793608fa-e9eb-5e5a-8e83-288dd037a5f2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.07 & 0.21 \\\\ 0.21 & 0.14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9f252122-7a78-5806-a3f7-44a4c28dc4f5" :answer/id #uuid "9f252122-7a78-5806-a3f7-44a4c28dc4f5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.12 & 0.07 \\\\ 0.07 & 0.28\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-71264c49-74b7-50ea-bc44-c7d200e335a7" :answer/id #uuid "71264c49-74b7-50ea-bc44-c7d200e335a7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.12 & 0.21 \\\\ 0.21 & 0.28\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1475ee74-c0d3-5ee6-aa81-f0f5cdcab5f8" :answer/id #uuid "1475ee74-c0d3-5ee6-aa81-f0f5cdcab5f8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.16 & 0.07 \\\\ 0.07 & 0.24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6fc5a00d-83e6-59b0-b208-3d137720bd47" :answer/id #uuid "6fc5a00d-83e6-59b0-b208-3d137720bd47" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.16 & 0.14 \\\\ 0.14 & 0.24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-b0df8fdd-91c9-54e0-8d8a-27e731147330" :question/id #uuid "b0df8fdd-91c9-54e0-8d8a-27e731147330" :question/math-academy-id "q-159394" :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.2$ |\n| $X=2$ | $0.3$ | $0.4$ |\n\nGiven that $\\text{E}[X]=1.7$ and $\\text{E}[Y]=0.6,$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n| $f$ | $Y=0$ | $Y=1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.2$ | $0.3$ |\n| $X=2$ | $0.3$ | $0.4$ | $0.7$ |\n| ${f}_{Y}$ | $0.4$ | $0.6$ | $1$ |\n\nNow, we can find $\\text{Var}[X].$ If $X$ is defined on a support ${S}_{X},$ then\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot {f}_{X}(x) \\\\  & ={1}^{2}\\cdot 0.3+{2}^{2}\\cdot 0.7 \\\\  & =3.1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =3.1-{1.7}^{2} \\\\  & =0.21.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a support ${S}_{Y},$ then\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{y}}{y}^{2}\\cdot {f}_{Y}(y) \\\\  & ={0}^{2}\\cdot 0.4+{1}^{2}\\cdot 0.6 \\\\  & =0.6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =0.6-{0.6}^{2} \\\\  & =0.24.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{(x,y)\\in S}xy\\cdot f(x,y) \\\\  & =(1)(0)f(1,0)+(2)(0)f(2,0)+(1)(1)f(1,1)+(2)(1)f(2,1) \\\\  & =0\\cdot 0.1+0\\cdot 0.3+1\\cdot 0.2+2\\cdot 0.4 \\\\  & =1.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =1-1.7\\cdot 0.6 \\\\  & =-0.02.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}0.21 & -0.02 \\\\ -0.02 & 0.24\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8af4fef-3d5d-5433-ae27-4591c3245789"] :db/ensure [:question/validate]} {:db/id "answer-field-b8af4fef-3d5d-5433-ae27-4591c3245789" :answer-field/id #uuid "b8af4fef-3d5d-5433-ae27-4591c3245789" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-44f91ee6-4be9-543a-b041-f7c5cfc18615" :answer-field/choices ["answer-89bee81d-2596-5647-822b-2c6a80c7ab59" "answer-615faddf-3bab-5914-9173-a556bc356111" "answer-2073e760-f9ee-5b53-8058-7e137e9dedaf" "answer-44f91ee6-4be9-543a-b041-f7c5cfc18615" "answer-f2c8c0e5-04d4-547e-ab87-e1edff505050"] :db/ensure [:answer-field/validate]} {:db/id "answer-89bee81d-2596-5647-822b-2c6a80c7ab59" :answer/id #uuid "89bee81d-2596-5647-822b-2c6a80c7ab59" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.15 & -0.02 \\\\ -0.02 & 0.33\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-615faddf-3bab-5914-9173-a556bc356111" :answer/id #uuid "615faddf-3bab-5914-9173-a556bc356111" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.15 & 0.04 \\\\ 0.04 & 0.33\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2073e760-f9ee-5b53-8058-7e137e9dedaf" :answer/id #uuid "2073e760-f9ee-5b53-8058-7e137e9dedaf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.17 & -0.05 \\\\ -0.05 & 0.42\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-44f91ee6-4be9-543a-b041-f7c5cfc18615" :answer/id #uuid "44f91ee6-4be9-543a-b041-f7c5cfc18615" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.21 & -0.02 \\\\ -0.02 & 0.24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f2c8c0e5-04d4-547e-ab87-e1edff505050" :answer/id #uuid "f2c8c0e5-04d4-547e-ab87-e1edff505050" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.21 & 0.04 \\\\ 0.04 & 0.24\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-f655f9f5-f0a0-522e-aa7b-2faf26b5e6dc" :question/id #uuid "f655f9f5-f0a0-522e-aa7b-2faf26b5e6dc" :question/math-academy-id "q-159396" :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n| $f$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- |\n| $X=2$ | $0.15$ | $0.1$ |\n| $X=6$ | $0.5$ | $0.25$ |\n\nGiven that $\\text{E}[X]=5$ and $\\text{E}[Y]=2.7,$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n| $f$ | $Y=2$ | $Y=4$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=2$ | $0.15$ | $0.1$ | $0.25$ |\n| $X=6$ | $0.5$ | $0.25$ | $0.75$ |\n| ${f}_{Y}$ | $0.65$ | $0.35$ | $1$ |\n\nNow, we can find $\\text{Var}[X].$ If $X$ is defined on a support ${S}_{X},$ then\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot {f}_{X}(x) \\\\  & ={2}^{2}\\cdot 0.25+{6}^{2}\\cdot 0.75 \\\\  & =28.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =28-{5}^{2} \\\\  & =3.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a support ${S}_{Y},$ then\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{y}}{y}^{2}\\cdot {f}_{Y}(y) \\\\  & ={2}^{2}\\cdot 0.65+{4}^{2}\\cdot 0.35 \\\\  & =8.2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =8.2-{2.7}^{2} \\\\  & =0.91.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{(x,y)\\in S}xy\\cdot f(x,y) \\\\  & =(2)(2)f(2,2)+(6)(2)f(6,2)+(2)(4)f(2,4)+(6)(4)f(6,4) \\\\  & =4\\cdot 0.15+12\\cdot 0.5+8\\cdot 0.1+24\\cdot 0.25 \\\\  & =13.4.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =13.4-5\\cdot 2.7 \\\\  & =-0.1.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}3 & -0.1 \\\\ -0.1 & 0.91\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2db09cf4-b474-5e57-9f08-283223d0e1e2"] :db/ensure [:question/validate]} {:db/id "answer-field-2db09cf4-b474-5e57-9f08-283223d0e1e2" :answer-field/id #uuid "2db09cf4-b474-5e57-9f08-283223d0e1e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cda86d07-4c70-5b02-bb43-601bb10cfd6a" :answer-field/choices ["answer-28a84dfd-6aa2-5495-a64d-69de32523f87" "answer-3967486f-6093-5d20-8dc9-663e628dffd3" "answer-157318a2-618f-5f21-930e-43f75d5b5084" "answer-cda86d07-4c70-5b02-bb43-601bb10cfd6a" "answer-62b6f626-2881-5d24-a9b7-ba0b307eee05"] :db/ensure [:answer-field/validate]} {:db/id "answer-28a84dfd-6aa2-5495-a64d-69de32523f87" :answer/id #uuid "28a84dfd-6aa2-5495-a64d-69de32523f87" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.32 & -1.4 \\\\ -1.4 & 0.16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3967486f-6093-5d20-8dc9-663e628dffd3" :answer/id #uuid "3967486f-6093-5d20-8dc9-663e628dffd3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -0.1 \\\\ -0.1 & 4.3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-157318a2-618f-5f21-930e-43f75d5b5084" :answer/id #uuid "157318a2-618f-5f21-930e-43f75d5b5084" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -0.4 \\\\ -0.4 & 4.3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cda86d07-4c70-5b02-bb43-601bb10cfd6a" :answer/id #uuid "cda86d07-4c70-5b02-bb43-601bb10cfd6a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -0.1 \\\\ -0.1 & 0.91\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-62b6f626-2881-5d24-a9b7-ba0b307eee05" :answer/id #uuid "62b6f626-2881-5d24-a9b7-ba0b307eee05" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -1.4 \\\\ -1.4 & 0.91\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-2c722f59-6d05-5224-b152-d5620b69f9be" :question/id #uuid "2c722f59-6d05-5224-b152-d5620b69f9be" :question/math-academy-id "q-159392" :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n| $f$ | $Y=0$ | $Y=3$ |\n| --- | --- | --- |\n| $X=1$ | $0.2$ | $0.3$ |\n| $X=3$ | $0.4$ | $0.1$ |\n\nGiven that $\\text{E}[X]=2$ and $\\text{E}[Y]=1.2,$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n| $f$ | $Y=0$ | $Y=3$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.2$ | $0.3$ | $0.5$ |\n| $X=3$ | $0.4$ | $0.1$ | $0.5$ |\n| ${f}_{Y}$ | $0.6$ | $0.4$ | $1$ |\n\nNow, we can find $\\text{Var}[X].$ If $X$ is defined on a support ${S}_{X},$ then\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot {f}_{X}(x) \\\\  & ={1}^{2}\\cdot 0.5+{3}^{2}\\cdot 0.5 \\\\  & =5.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =5-{2}^{2} \\\\  & =1.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a support ${S}_{Y},$ then\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{y}}{y}^{2}\\cdot {f}_{Y}(y) \\\\  & ={0}^{2}\\cdot 0.6+{3}^{2}\\cdot 0.4 \\\\  & =3.6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =3.6-{1.2}^{2} \\\\  & =2.16.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{(x,y)\\in S}xy\\cdot f(x,y) \\\\  & =(1)(0)f(1,0)+(3)(0)f(3,0)+(1)(3)f(1,3)+(3)(3)f(3,3) \\\\  & =0\\cdot 0.2+0\\cdot 0.4+3\\cdot 0.3+9\\cdot 0.1 \\\\  & =1.8.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =1.8-2\\cdot 1.2 \\\\  & =-0.6.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}1 & -0.6 \\\\ -0.6 & 2.16\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-04216e6b-fcd6-5776-bcd4-b6b33f9033e8"] :db/ensure [:question/validate]} {:db/id "answer-field-04216e6b-fcd6-5776-bcd4-b6b33f9033e8" :answer-field/id #uuid "04216e6b-fcd6-5776-bcd4-b6b33f9033e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-59ebd30d-4e1e-5504-b5d3-d789ce481c1b" :answer-field/choices ["answer-59ebd30d-4e1e-5504-b5d3-d789ce481c1b" "answer-2e5010e5-3f4c-5ae6-a631-444f758a8718" "answer-9e9420af-2ceb-5c7e-8f61-b22aa3d7ebde" "answer-6c61b5ff-f207-5b0b-8365-c3c4253c6256" "answer-fd3a169b-897a-5f61-b729-9f40a0af1f11"] :db/ensure [:answer-field/validate]} {:db/id "answer-59ebd30d-4e1e-5504-b5d3-d789ce481c1b" :answer/id #uuid "59ebd30d-4e1e-5504-b5d3-d789ce481c1b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -0.6 \\\\ -0.6 & 2.16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2e5010e5-3f4c-5ae6-a631-444f758a8718" :answer/id #uuid "2e5010e5-3f4c-5ae6-a631-444f758a8718" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0.3 \\\\ 0.3 & 2.16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9e9420af-2ceb-5c7e-8f61-b22aa3d7ebde" :answer/id #uuid "9e9420af-2ceb-5c7e-8f61-b22aa3d7ebde" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1.08 & -0.6 \\\\ -0.6 & 0.27\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6c61b5ff-f207-5b0b-8365-c3c4253c6256" :answer/id #uuid "6c61b5ff-f207-5b0b-8365-c3c4253c6256" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1.08 & 0.3 \\\\ 0.3 & 0.27\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fd3a169b-897a-5f61-b729-9f40a0af1f11" :answer/id #uuid "fd3a169b-897a-5f61-b729-9f40a0af1f11" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -0.4 \\\\ -0.4 & 1.18\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-67d9ef63-b4c5-5251-99ba-45e5490b628a" :question/id #uuid "67d9ef63-b4c5-5251-99ba-45e5490b628a" :question/math-academy-id "q-159401" :question/problem "The joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is given below.\n\n| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ |\n| $X=2$ | $0.1$ | $0.5$ |\n\nGiven that $\\text{E}[X]=1.6$ and $\\text{E}[Y]=0.8,$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, let's find the marginal mass functions for $X$ and $Y.$ These are given by the row and column totals, respectively.\n\n| $f$ | $Y=0$ | $Y=1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.3$ | $0.4$ |\n| $X=2$ | $0.1$ | $0.5$ | $0.6$ |\n| ${f}_{Y}$ | $0.2$ | $0.8$ | $1$ |\n\nNow, we can find $\\text{Var}[X].$ If $X$ is defined on a support ${S}_{X},$ then\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\sum }_{x\\in {S}_{X}}{x}^{2}\\cdot {f}_{X}(x) \\\\  & ={1}^{2}\\cdot 0.4+{2}^{2}\\cdot 0.6 \\\\  & =2.8.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =2.8-{1.6}^{2} \\\\  & =0.24.\\end{aligned}\n$$\n\nSimilarly, if $Y$ is defined on a support ${S}_{Y},$ then\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\sum }_{y\\in {S}_{y}}{y}^{2}\\cdot {f}_{Y}(y) \\\\  & ={0}^{2}\\cdot 0.2+{1}^{2}\\cdot 0.8 \\\\  & =0.8.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =0.8-{0.8}^{2} \\\\  & =0.16.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{(x,y)\\in S}xy\\cdot f(x,y) \\\\  & =(1)(0)f(1,0)+(2)(0)f(2,0)+(1)(1)f(1,1)+(2)(1)f(2,1) \\\\  & =0\\cdot 0.1+0\\cdot 0.1+1\\cdot 0.3+2\\cdot 0.5 \\\\  & =1.3.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =1.3-1.6\\cdot 0.8 \\\\  & =0.02.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}0.24 & 0.02 \\\\ 0.02 & 0.16\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e947e310-d910-5ad9-bf8c-eecd137f0212"] :db/ensure [:question/validate]} {:db/id "answer-field-e947e310-d910-5ad9-bf8c-eecd137f0212" :answer-field/id #uuid "e947e310-d910-5ad9-bf8c-eecd137f0212" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f6c42a0-cab8-5788-bf15-3a5dd81f1e9c" :answer-field/choices ["answer-4f6c42a0-cab8-5788-bf15-3a5dd81f1e9c" "answer-8c572c21-35a0-57e5-bb60-83f696067df8" "answer-0030f44f-ba08-5c74-8bf5-6a609de1c50f" "answer-657cb2f7-bdcc-52c1-a370-bf6419c7cb74" "answer-743641c5-77ba-546d-98c6-ead83cff1a11"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f6c42a0-cab8-5788-bf15-3a5dd81f1e9c" :answer/id #uuid "4f6c42a0-cab8-5788-bf15-3a5dd81f1e9c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.24 & 0.02 \\\\ 0.02 & 0.16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8c572c21-35a0-57e5-bb60-83f696067df8" :answer/id #uuid "8c572c21-35a0-57e5-bb60-83f696067df8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0.24 & 1.4 \\\\ 1.4 & 0.16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0030f44f-ba08-5c74-8bf5-6a609de1c50f" :answer/id #uuid "0030f44f-ba08-5c74-8bf5-6a609de1c50f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1.14 & 0.02 \\\\ 0.02 & 0.72\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-657cb2f7-bdcc-52c1-a370-bf6419c7cb74" :answer/id #uuid "657cb2f7-bdcc-52c1-a370-bf6419c7cb74" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2.6 & 1.14 \\\\ 1.14 & 1.8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-743641c5-77ba-546d-98c6-ead83cff1a11" :answer/id #uuid "743641c5-77ba-546d-98c6-ead83cff1a11" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2.6 & 1.4 \\\\ 1.4 & 1.8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-4f28747a-e241-5f89-b726-699a85c63f84" :question/id #uuid "4f28747a-e241-5f89-b726-699a85c63f84" :question/math-academy-id "q-159419" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}48y(x-y),\\, & 0\\le x\\le 1,\\,\\,0\\le y\\le \\frac{x}{2}, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\frac{4}{5},$ $\\text{E}[Y]=\\frac{1}{4},$ and $\\text{E}[{X}^{2}]=\\frac{2}{3},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, we find $\\text{Var}[X].$ Using the given results, we have\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{2}{3}-{(\\frac{4}{5})}^{2} \\\\  & =\\frac{2}{75}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}{y}^{2}\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}48{y}^{3}(x-y)\\,\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{\\int }_{0}^{x/2}(x{y}^{3}-{y}^{4})\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{[\\frac{1}{4}x{y}^{4}-\\frac{1}{5}{y}^{5}]}_{y=0}^{y=x/2}\\,\\text{d}x \\\\  & =48{\\int }_{0}^{1}(\\frac{1}{64}{x}^{5}-\\frac{1}{160}{x}^{5})\\text{d}x \\\\  & =48\\cdot \\frac{3}{320}{\\int }_{0}^{1}{x}^{5}\\text{d}x \\\\  & =\\frac{9}{20}{[\\frac{1}{6}{x}^{6}]}_{0}^{1} \\\\  & =\\frac{3}{40}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{3}{40}-{(\\frac{1}{4})}^{2} \\\\  & =\\frac{1}{80}.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}xy\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x/2}48x{y}^{2}(x-y)\\,\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{\\int }_{0}^{x/2}({x}^{2}{y}^{2}-x{y}^{3})\\text{d}y\\text{d}x \\\\  & =48{\\int }_{0}^{1}{[\\frac{1}{3}{x}^{2}{y}^{3}-\\frac{1}{4}x{y}^{4}]}_{y=0}^{y=x/2}\\,\\text{d}x \\\\  & =48{\\int }_{0}^{1}(\\frac{1}{24}{x}^{5}-\\frac{1}{64}{x}^{5})\\text{d}x \\\\  & =48\\cdot \\frac{5}{192}{\\int }_{0}^{1}{x}^{5}\\text{d}x \\\\  & =\\frac{5}{4}{[\\frac{1}{6}{x}^{6}]}_{0}^{1} \\\\  & =\\frac{5}{24}.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{24}-(\\frac{4}{5})\\cdot (\\frac{1}{4}) \\\\  & =\\frac{1}{120}.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{2}{75} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{80}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bcc58af9-a17d-54ac-a6d0-c02b4698e66a"] :db/ensure [:question/validate]} {:db/id "answer-field-bcc58af9-a17d-54ac-a6d0-c02b4698e66a" :answer-field/id #uuid "bcc58af9-a17d-54ac-a6d0-c02b4698e66a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ab77c8f-f65f-5385-b65d-d3ff9200abe8" :answer-field/choices ["answer-66021cb4-d4dc-5536-b740-cb112f549955" "answer-8bea8944-aeb8-56ab-bc44-a9115f9d6b4a" "answer-8ab77c8f-f65f-5385-b65d-d3ff9200abe8" "answer-fa4fcec9-3717-5441-ad16-3b9193cd5316" "answer-c0675adb-146f-509c-9662-380def9fc9b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-66021cb4-d4dc-5536-b740-cb112f549955" :answer/id #uuid "66021cb4-d4dc-5536-b740-cb112f549955" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{25} & \\frac{1}{4} \\\\ \\frac{1}{4} & \\frac{1}{80}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8bea8944-aeb8-56ab-bc44-a9115f9d6b4a" :answer/id #uuid "8bea8944-aeb8-56ab-bc44-a9115f9d6b4a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{75} & 0 \\\\ 0 & \\frac{1}{10}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8ab77c8f-f65f-5385-b65d-d3ff9200abe8" :answer/id #uuid "8ab77c8f-f65f-5385-b65d-d3ff9200abe8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{75} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{80}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fa4fcec9-3717-5441-ad16-3b9193cd5316" :answer/id #uuid "fa4fcec9-3717-5441-ad16-3b9193cd5316" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{75} & \\frac{1}{4} \\\\ \\frac{1}{4} & \\frac{3}{20}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c0675adb-146f-509c-9662-380def9fc9b9" :answer/id #uuid "c0675adb-146f-509c-9662-380def9fc9b9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{50} & \\frac{1}{120} \\\\ \\frac{1}{120} & \\frac{1}{20}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-53e9c56c-8467-523e-bd98-6ac7236cb57e" :question/id #uuid "53e9c56c-8467-523e-bd98-6ac7236cb57e" :question/math-academy-id "q-159402" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}{x}^{2}{y}^{2},\\, & -1\\le x\\le 1,\\,\\,-1\\le y\\le 2, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $\\text{E}[X]=0$ and $\\text{E}[Y]=\\frac{5}{4},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{x}^{2}(\\frac{1}{2}{x}^{2}{y}^{2})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{2}{\\int }_{-1}^{1}{x}^{4}\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{2}\\cdot {[\\frac{1}{5}{x}^{5}]}_{-1}^{1}\\text{d}y \\\\  & =\\frac{1}{5}{\\int }_{-1}^{2}{y}^{2}\\,\\text{d}y \\\\  & =\\frac{1}{5}\\cdot {[\\frac{1}{3}{y}^{3}]}_{-1}^{2} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{3}{5}-{(0)}^{2} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{1}{y}^{2}(\\frac{1}{2}{x}^{2}{y}^{2})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{4}{\\int }_{-1}^{1}{x}^{2}\\,\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{-1}^{2}{y}^{4}{[\\frac{1}{3}{x}^{3}]}_{-1}^{1}\\,\\text{d}y \\\\  & =\\frac{1}{3}{\\int }_{-1}^{2}{y}^{4}\\,\\text{d}y \\\\  & =\\frac{1}{3}\\cdot {[\\frac{1}{5}{y}^{5}]}_{-1}^{2} \\\\  & =\\frac{1}{3}\\cdot \\frac{33}{5} \\\\  & =\\frac{11}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{11}{5}-{(\\frac{5}{4})}^{2} \\\\  & =\\frac{51}{80}.\\end{aligned}\n$$\n\nNow, we find the covariance of $X$ and $Y.$ The joint support of $X$ and $Y$ is given by the rectangle\n\n$$\nS=[-1,1]\\times [-1,2].\n$$\n\nMoreover, we can write\n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=\\frac{3{x}^{2}}{2}$ and $h(y)=\\frac{{y}^{2}}{3}.$\n\nHence, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{51}{80}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3653cd9d-fe12-51a1-8be3-fd825c0586b5"] :db/ensure [:question/validate]} {:db/id "answer-field-3653cd9d-fe12-51a1-8be3-fd825c0586b5" :answer-field/id #uuid "3653cd9d-fe12-51a1-8be3-fd825c0586b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04876404-2581-5642-a614-ac8532d94ee0" :answer-field/choices ["answer-f06f1240-944d-5a7e-801d-c1580106d19c" "answer-32e2ee64-527c-5c83-b039-b6ea6f47e219" "answer-28e7f859-7126-5457-a4e0-c1a1e1d2204b" "answer-f530e59e-19da-56aa-a5f6-c0afac7fd1bf" "answer-04876404-2581-5642-a614-ac8532d94ee0"] :db/ensure [:answer-field/validate]} {:db/id "answer-f06f1240-944d-5a7e-801d-c1580106d19c" :answer/id #uuid "f06f1240-944d-5a7e-801d-c1580106d19c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{23}{40}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-32e2ee64-527c-5c83-b039-b6ea6f47e219" :answer/id #uuid "32e2ee64-527c-5c83-b039-b6ea6f47e219" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{5} & 0 \\\\ 0 & \\frac{23}{40}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-28e7f859-7126-5457-a4e0-c1a1e1d2204b" :answer/id #uuid "28e7f859-7126-5457-a4e0-c1a1e1d2204b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{11}{40}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f530e59e-19da-56aa-a5f6-c0afac7fd1bf" :answer/id #uuid "f530e59e-19da-56aa-a5f6-c0afac7fd1bf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{11}{40}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-04876404-2581-5642-a614-ac8532d94ee0" :answer/id #uuid "04876404-2581-5642-a614-ac8532d94ee0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{5} & 0 \\\\ 0 & \\frac{51}{80}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-9895539f-08a9-52d3-aba6-0550c7a4d108" :question/id #uuid "9895539f-08a9-52d3-aba6-0550c7a4d108" :question/math-academy-id "q-159407" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{1}{2}x{y}^{3},\\, & 0\\le x\\le 1,\\,\\,0\\le y\\le 2, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nIf $\\text{E}[X]=\\frac{2}{3}$ and $\\text{E}[Y]=\\frac{8}{5},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}.\n$$\n\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{\\int }_{0}^{1}{x}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{x}^{2}(\\frac{1}{2}x{y}^{3})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{3}{\\int }_{0}^{1}{x}^{3}\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{3}\\cdot {[\\frac{1}{4}{x}^{4}]}_{0}^{1}\\text{d}y \\\\  & =\\frac{1}{8}{\\int }_{0}^{2}{y}^{3}\\,\\text{d}y \\\\  & =\\frac{1}{8}\\cdot {[\\frac{1}{4}{y}^{4}]}_{0}^{2} \\\\  & =\\frac{1}{8}\\cdot 4 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{1}{2}-{(\\frac{2}{3})}^{2} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{2}{\\int }_{0}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}{y}^{2}(\\frac{1}{2}x{y}^{3})\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{5}{\\int }_{0}^{1}x\\,\\text{d}x\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{2}{y}^{5}{[\\frac{1}{2}{x}^{2}]}_{0}^{1}\\,\\text{d}y \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}{y}^{5}\\,\\text{d}y \\\\  & =\\frac{1}{4}\\cdot {[\\frac{1}{6}{y}^{6}]}_{0}^{2} \\\\  & =\\frac{1}{4}\\cdot \\frac{32}{3} \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{8}{3}-{(\\frac{8}{5})}^{2} \\\\  & =\\frac{8}{75}.\\end{aligned}\n$$\n\nNow, we find the covariance of $X$ and $Y.$ The joint support of $X$ and $Y$ is given by the rectangle\n\n$$\nS=[0,1]\\times [0,2].\n$$\n\nMoreover, we can write\n\n$$\nf(x,y)=g(x)\\cdot h(y),\n$$\n\nwhere $g(x)=2x$ and $h(y)=\\frac{{y}^{3}}{4}.$\n\nHence, $X$ and $Y$ are independent, and consequently $\\text{Cov}[X,Y]=0.$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-294a6c0d-e8c4-539b-87eb-6c2be022c57a"] :db/ensure [:question/validate]} {:db/id "answer-field-294a6c0d-e8c4-539b-87eb-6c2be022c57a" :answer-field/id #uuid "294a6c0d-e8c4-539b-87eb-6c2be022c57a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-34950a5f-0e45-502b-a869-e016971bd6d5" :answer-field/choices ["answer-ddc276fa-92de-5c9e-be25-aa6ec3df6cac" "answer-8675456c-15df-5d06-a100-2d7b178a0c1f" "answer-34950a5f-0e45-502b-a869-e016971bd6d5" "answer-4dfa5556-a2dc-5232-9d7f-e3796a0407dd" "answer-4c028ae0-4e46-5185-bea4-b79e305dc544"] :db/ensure [:answer-field/validate]} {:db/id "answer-ddc276fa-92de-5c9e-be25-aa6ec3df6cac" :answer/id #uuid "ddc276fa-92de-5c9e-be25-aa6ec3df6cac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{18} & -1 \\\\ -1 & \\frac{4}{25}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8675456c-15df-5d06-a100-2d7b178a0c1f" :answer/id #uuid "8675456c-15df-5d06-a100-2d7b178a0c1f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{4}{25}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-34950a5f-0e45-502b-a869-e016971bd6d5" :answer/id #uuid "34950a5f-0e45-502b-a869-e016971bd6d5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{18} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4dfa5556-a2dc-5232-9d7f-e3796a0407dd" :answer/id #uuid "4dfa5556-a2dc-5232-9d7f-e3796a0407dd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{9} & -1 \\\\ -1 & \\frac{8}{75}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4c028ae0-4e46-5185-bea4-b79e305dc544" :answer/id #uuid "4c028ae0-4e46-5185-bea4-b79e305dc544" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{9} & 0 \\\\ 0 & \\frac{8}{75}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-7039fb00-3d4a-54d6-a4b0-1bcf58d49ef2" :question/id #uuid "7039fb00-3d4a-54d6-a4b0-1bcf58d49ef2" :question/math-academy-id "q-159422" :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{5}{16}({x}^{2}-y),\\, & 0\\le x\\le 2,\\,\\,0\\le y\\le {x}^{2}, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\frac{5}{3},$ $\\text{E}[Y]=\\frac{20}{21},$ and $\\text{E}[{Y}^{2}]=\\frac{40}{27},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, we find $\\text{Var}[X].$\nWe compute $\\text{E}[{X}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}{x}^{2}\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}\\frac{5}{16}{x}^{2}({x}^{2}-y)\\,\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}({x}^{4}-y{x}^{2})\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{[y{x}^{4}-\\frac{1}{2}{y}^{2}{x}^{2}]}_{y=0}^{y={x}^{2}}\\,\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}(\\frac{1}{2}{x}^{6})\\text{d}x \\\\  & =\\frac{5}{32}{\\int }_{0}^{2}{x}^{6}\\text{d}x \\\\  & =\\frac{5}{32}{[\\frac{1}{7}{x}^{7}]}_{0}^{2} \\\\  & =\\frac{20}{7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{20}{7}-{(\\frac{5}{3})}^{2} \\\\  & =\\frac{5}{63}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{Var}[Y].$ Using the given results, we have\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{40}{27}-{(\\frac{20}{21})}^{2} \\\\  & =\\frac{760}{1\\,323}.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}xy\\cdot f(x,y)\\,\\text{d}y\\text{d}x \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}\\frac{5}{16}xy({x}^{2}-y)\\,\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{\\int }_{0}^{{x}^{2}}({x}^{3}y-x{y}^{2})\\text{d}y\\text{d}x \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}{[\\frac{1}{2}{y}^{2}{x}^{3}-\\frac{1}{3}{y}^{3}x]}_{y=0}^{y={x}^{2}}\\,\\text{d}y \\\\  & =\\frac{5}{16}{\\int }_{0}^{2}(\\frac{1}{6}{x}^{7})\\text{d}x \\\\  & =\\frac{5}{96}{\\int }_{0}^{2}{x}^{7}\\text{d}x \\\\  & =\\frac{5}{96}{[\\frac{1}{8}{x}^{8}]}_{0}^{2} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{3}-(\\frac{5}{3})\\cdot (\\frac{20}{21}) \\\\  & =\\frac{5}{63}.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{5}{63} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{760}{1\\,323}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3850f8d6-6285-5466-abaf-4c01feeefec9"] :db/ensure [:question/validate]} {:db/id "answer-field-3850f8d6-6285-5466-abaf-4c01feeefec9" :answer-field/id #uuid "3850f8d6-6285-5466-abaf-4c01feeefec9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce082f30-4d9c-529e-8724-6a216a95f170" :answer-field/choices ["answer-ff923f25-09d1-59df-bac6-3e88c64bc811" "answer-3c09fbcf-e1dc-5950-9508-6766eb430f44" "answer-cd3456dc-3ee8-5bd4-b669-70e0e8adddde" "answer-8486b2b4-5627-54ae-9bfc-12a68a4ca561" "answer-ce082f30-4d9c-529e-8724-6a216a95f170"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff923f25-09d1-59df-bac6-3e88c64bc811" :answer/id #uuid "ff923f25-09d1-59df-bac6-3e88c64bc811" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{45} & 0 \\\\ 0 & \\frac{56}{843}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3c09fbcf-e1dc-5950-9508-6766eb430f44" :answer/id #uuid "3c09fbcf-e1dc-5950-9508-6766eb430f44" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{45} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{67}{548}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cd3456dc-3ee8-5bd4-b669-70e0e8adddde" :answer/id #uuid "cd3456dc-3ee8-5bd4-b669-70e0e8adddde" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{4}{21} & 0 \\\\ 0 & \\frac{760}{1\\,323}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8486b2b4-5627-54ae-9bfc-12a68a4ca561" :answer/id #uuid "8486b2b4-5627-54ae-9bfc-12a68a4ca561" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{5}{63} & \\frac{1}{21} \\\\ \\frac{1}{21} & \\frac{56}{843}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ce082f30-4d9c-529e-8724-6a216a95f170" :answer/id #uuid "ce082f30-4d9c-529e-8724-6a216a95f170" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{5}{63} & \\frac{5}{63} \\\\ \\frac{5}{63} & \\frac{760}{1\\,323}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186188793 :question/problem "The random variables $X$ and $Y$ have the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}x+y,\\, & 0\\le x\\le 1,\\,\\,0\\le y\\le 1, \\\\ 0,\\, & \\text{otherwise}.\\end{aligned}\n$$\n\nGiven that $\\text{E}[X]=\\text{E}[Y]=\\frac{7}{12},$ and $E[{X}^{2}]=\\frac{5}{12},$ find the covariance matrix for $X$ and $Y.$" :question/worked-solution "For two random variables $X$ and $Y,$ the covariance matrix $Σ$ is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}].\n$$\n\nRecall that the variance of a random variable $X$ is determined by the formula\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2},\n$$\n\nand the covariance of two random variables $X$ and $Y$ is given by the formula\n\n$$\n\\text{Cov}[X,Y]=\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y].\n$$\n\nFirst, we find $\\text{Var}[X].$ Using the given results, we have\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{5}{12}-{(\\frac{7}{12})}^{2} \\\\  & =\\frac{11}{144}.\\end{aligned}\n$$\n\nSimilarly, we compute $\\text{E}[{Y}^{2}]$ using the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}] & ={\\int }_{0}^{1}{\\int }_{0}^{1}{y}^{2}\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{y}^{2}(x+y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(x{y}^{2}+{y}^{3})\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{2}{x}^{2}{y}^{2}+x{y}^{3}]}_{x=0}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{1}{2}{y}^{2}+{y}^{3})\\text{d}y \\\\  & ={[\\frac{1}{6}{y}^{3}+\\frac{1}{4}{y}^{4}]}_{0}^{1} \\\\  & =\\frac{1}{6}+\\frac{1}{4} \\\\  & =\\frac{5}{12}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[Y] & =\\text{E}[{Y}^{2}]-\\text{E}[Y]^{2} \\\\  & =\\frac{5}{12}-{(\\frac{7}{12})}^{2} \\\\  & =\\frac{11}{144}.\\end{aligned}\n$$\n\nFinally, let's find $\\text{Cov}[X,Y].$ By the rule of the lazy statistician, we find $\\text{E}[XY]:$\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\int }_{0}^{1}{\\int }_{0}^{1}xy\\cdot f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}xy(x+y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}({x}^{2}y+x{y}^{2})\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{3}{x}^{3}y+\\frac{1}{2}{x}^{2}{y}^{2}]}_{0}^{1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\frac{1}{3}y+\\frac{1}{2}{y}^{2})\\text{d}y \\\\  & ={[\\frac{1}{6}{y}^{2}+\\frac{1}{6}{y}^{3}]}_{0}^{1} \\\\  & =\\frac{1}{6}+\\frac{1}{6} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$\n\nThen, using the covariance formula, we have\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{1}{3}-(\\frac{7}{12})\\cdot (\\frac{7}{12}) \\\\  & =-\\frac{1}{144}.\\end{aligned}\n$$\n\nTherefore, the covariance matrix is given by\n\n$$\nΣ=[\\begin{aligned}\\text{Var}[X] & \\text{Cov}[X,Y] \\\\ \\text{Cov}[Y,X] & \\text{Var}[Y]\\end{aligned}]=[\\begin{aligned}\\frac{11}{144} & -\\frac{1}{144} \\\\ -\\frac{1}{144} & \\frac{11}{144}\\end{aligned}]=\\frac{1}{144}[\\begin{aligned}11 & -1 \\\\ -1 & 11\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186187038 :answer-field/correct "answer-0a71cefc-8de5-5de6-a1e7-e827ad772d4a" :answer-field/choices ["answer-0a71cefc-8de5-5de6-a1e7-e827ad772d4a" "answer-ef02e2b8-d181-5dc2-952d-5f459a779602" "answer-2529513a-9fa9-5a66-b66c-95b167283ef3" "answer-b1914b83-6794-52fe-91db-700c3ef7d55d" "answer-01df44a6-657a-5670-a985-4a87b7716922"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a71cefc-8de5-5de6-a1e7-e827ad772d4a" :answer/id #uuid "0a71cefc-8de5-5de6-a1e7-e827ad772d4a" :answer/type :answer.type/math :answer/value "\\frac{1}{144}[\\begin{aligned}11 & -1 \\\\ -1 & 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ef02e2b8-d181-5dc2-952d-5f459a779602" :answer/id #uuid "ef02e2b8-d181-5dc2-952d-5f459a779602" :answer/type :answer.type/math :answer/value "\\frac{1}{144}[\\begin{aligned}11 & -1 \\\\ -1 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2529513a-9fa9-5a66-b66c-95b167283ef3" :answer/id #uuid "2529513a-9fa9-5a66-b66c-95b167283ef3" :answer/type :answer.type/math :answer/value "\\frac{1}{144}[\\begin{aligned}11 & 0 \\\\ 0 & 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b1914b83-6794-52fe-91db-700c3ef7d55d" :answer/id #uuid "b1914b83-6794-52fe-91db-700c3ef7d55d" :answer/type :answer.type/math :answer/value "\\frac{1}{144}[\\begin{aligned}11 & 0 \\\\ 0 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-01df44a6-657a-5670-a985-4a87b7716922" :answer/id #uuid "01df44a6-657a-5670-a985-4a87b7716922" :answer/type :answer.type/math :answer/value "\\frac{1}{144}[\\begin{aligned}7 & -1 \\\\ -1 & 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186189409 :tutorial/content "For a set of random variables $X_1, \\ldots, X_n,$ the **covariance matrix** $\\Sigma$ is defined as\n\n![](images/41/416ac73d7b76e9c62efead1278e7a2b47c00dd03a8af17df99f28aea99f3f7a0.svg)\n\nNote the following:\n\n- The $i$th diagonal element is $\\Sigma_{ii} = \\textrm{Var}[X_i].$\n\n- The element in the $i$th row and $j$th column for $i \\neq j$ is $\\Sigma_{ij} = \\textrm{Cov}[X_i, X_j].$\n\nNow, since $\\textrm{Cov}[X_i,X_j] = \\textrm{Cov}[X_j,X_i]$ for any pair of random variables $X_i, X_j$, we have the following theorem:\n\n*The covariance matrix is always symmetric. Moreover, it is a positive semi-definite matrix.*" :db/ensure [:tutorial/validate]} {:db/id 17592186188521 :activity/expected-seconds 900.0 :db/ensure [:activity/validate]} {:db/id 17592186217109 :knowledge-point/questions ["question-8dc89317-431f-536c-84f1-f80a52b02432" "question-0dbc8468-e68d-529c-9edc-f8593cda9fbb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8dc89317-431f-536c-84f1-f80a52b02432" :question/id #uuid "8dc89317-431f-536c-84f1-f80a52b02432" :question/math-academy-id "q-152279" :question/problem "The parabola $y={x}^{2}+2x+2$ and the line $y=2-2x$ intersect at the points $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2}),$ where ${x}_{1}<{x}_{2}.$ What is the value of ${y}_{1}+{y}_{2}?$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+2x+2 \\\\ y=2-2x\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+2x+2 & =2-2x \\\\ {x}^{2}+4x & =0 \\\\ x(x+4) & =0 \\\\ x & =-4,0.\\end{aligned}\n$$\n\nSince ${x}_{1}<{x}_{2},$ the $x$-coordinates of the intersection points are ${x}_{1}=-4$ and ${x}_{2}=0.$ \n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the line since it's simpler.\n\n- Substituting ${x}_{1}=-4,$ we get\n\n$$\n\\begin{aligned}{y}_{1} & =2-2{x}_{1} \\\\  & =2-2(-4) \\\\  & =10,\\end{aligned}\n$$\n\nso one point of intersection is $({x}_{1},{y}_{1})=(-4,10).$\n\n- Substituting ${x}_{2}=0,$ we get\n\n$$\n\\begin{aligned}{y}_{2} & =2-2{x}_{2} \\\\  & =2-2(0) \\\\  & =2,\\end{aligned}\n$$\n\nso the other point of intersection is $({x}_{2},{y}_{2})=(0,2).$\n\nTherefore, ${y}_{1}=10,\\,{y}_{2}=2,$ and\n\n$$\n{y}_{1}+{y}_{2}=10+2=12.\n$$\n\nA sketch of the situation is shown below.\n\n![](images/94/941d698059cfd145f263cbdde048fc4a32245cdad4bc6bb6d7a504d005b6c231.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-87155073-92f3-57b6-9c30-b010bce3c156"] :db/ensure [:question/validate]} {:db/id "answer-field-87155073-92f3-57b6-9c30-b010bce3c156" :answer-field/id #uuid "87155073-92f3-57b6-9c30-b010bce3c156" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bba43083-7060-5fde-819c-d1d64e90ed78" :answer-field/choices ["answer-bba43083-7060-5fde-819c-d1d64e90ed78" "answer-fe61a9af-bb8a-5a5e-a47a-8216aa26ccd3" "answer-cabe3545-1601-5fc2-b776-2d1f2769c466" "answer-4cc47893-4576-56e2-b51b-ce99eaf337e7" "answer-4f2b5802-b097-565d-8a8d-3cbc86eb5664"] :db/ensure [:answer-field/validate]} {:db/id "answer-bba43083-7060-5fde-819c-d1d64e90ed78" :answer/id #uuid "bba43083-7060-5fde-819c-d1d64e90ed78" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-fe61a9af-bb8a-5a5e-a47a-8216aa26ccd3" :answer/id #uuid "fe61a9af-bb8a-5a5e-a47a-8216aa26ccd3" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-cabe3545-1601-5fc2-b776-2d1f2769c466" :answer/id #uuid "cabe3545-1601-5fc2-b776-2d1f2769c466" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-4cc47893-4576-56e2-b51b-ce99eaf337e7" :answer/id #uuid "4cc47893-4576-56e2-b51b-ce99eaf337e7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-4f2b5802-b097-565d-8a8d-3cbc86eb5664" :answer/id #uuid "4f2b5802-b097-565d-8a8d-3cbc86eb5664" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186217111 :knowledge-point/questions ["question-95764a8d-23d1-5507-836a-2817991f65d9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-95764a8d-23d1-5507-836a-2817991f65d9" :question/id #uuid "95764a8d-23d1-5507-836a-2817991f65d9" :question/math-academy-id "q-152314" :question/problem "Given that the line $y=x+k$ does **not** intersect the parabola $y={x}^{2}+1,$ what is the range of possible values of $k?$" :question/worked-solution "To determine whether the line $y=x+k$ intersects the parabola $y={x}^{2}+1,$ we need to solve the following system of equations for the two curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+1 \\\\ y=x+k\\end{aligned}\n$$\n\nSetting the equations equal to one another and writing in standard form, we get\n\n$$\n\\begin{aligned}{x}^{2}+1 & =x+k \\\\ {x}^{2}-x+1-k & =0.\\end{aligned}\n$$\n\nNow, we solve this equation using the quadratic formula with $a=1,\\,b=-1,$ and $c=1-k:$\n\n$$\n\\begin{aligned}x & =\\frac{-(-1)\\pm \\sqrt{(-1)^{2}-4(1)(1-k)}}{2(1)} \\\\  & =\\frac{1\\pm \\sqrt{1-4+4k}}{2} \\\\  & =\\frac{1\\pm \\sqrt{4k-3}}{2}\\end{aligned}\n$$\n\nSince the line and parabola do not intersect, our quadratic equation must have no real solutions; hence, the expression inside the square root must be negative.\nSetting up and solving this inequality, we get\n\n$$\n\\begin{aligned}4k-3 & <0 \\\\ 4k & <3 \\\\ k & <\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the range of possible values of $k$ is $k<\\frac{3}{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-83300691-a442-5ef8-b2cc-b11ca96f7be8"] :db/ensure [:question/validate]} {:db/id "answer-field-83300691-a442-5ef8-b2cc-b11ca96f7be8" :answer-field/id #uuid "83300691-a442-5ef8-b2cc-b11ca96f7be8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9106e55b-9dcf-53a3-80ef-e117f396ee65" :answer-field/choices ["answer-340c4803-d8c0-59d9-a251-82d6850f70ed" "answer-9106e55b-9dcf-53a3-80ef-e117f396ee65" "answer-87f5df3e-d889-51a5-9bbf-55a47147c1c6" "answer-5757b43b-f6e1-569c-b37a-4f6109bc720f" "answer-3a39b58c-130d-5ebb-836a-1129846e881e"] :db/ensure [:answer-field/validate]} {:db/id "answer-340c4803-d8c0-59d9-a251-82d6850f70ed" :answer/id #uuid "340c4803-d8c0-59d9-a251-82d6850f70ed" :answer/type :answer.type/math :answer/value "k<1" :db/ensure [:answer/validate]} {:db/id "answer-9106e55b-9dcf-53a3-80ef-e117f396ee65" :answer/id #uuid "9106e55b-9dcf-53a3-80ef-e117f396ee65" :answer/type :answer.type/math :answer/value "k<\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-87f5df3e-d889-51a5-9bbf-55a47147c1c6" :answer/id #uuid "87f5df3e-d889-51a5-9bbf-55a47147c1c6" :answer/type :answer.type/math :answer/value "k<\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5757b43b-f6e1-569c-b37a-4f6109bc720f" :answer/id #uuid "5757b43b-f6e1-569c-b37a-4f6109bc720f" :answer/type :answer.type/math :answer/value "k>0" :db/ensure [:answer/validate]} {:db/id "answer-3a39b58c-130d-5ebb-836a-1129846e881e" :answer/id #uuid "3a39b58c-130d-5ebb-836a-1129846e881e" :answer/type :answer.type/math :answer/value "k>\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "question-0dbc8468-e68d-529c-9edc-f8593cda9fbb" :question/id #uuid "0dbc8468-e68d-529c-9edc-f8593cda9fbb" :question/math-academy-id "q-250075" :question/problem "The parabola $y={x}^{2}+5x-1$ and the line $y=-2x-13$ intersect at the points $({x}_{1},{y}_{1})$ and $({x}_{2},{y}_{2}),$ where ${x}_{1}<{x}_{2}.$ Find the values of ${y}_{1}$ and ${y}_{2}.$\n\n${y}_{1}=$\n{{field-1}}$,\\,{y}_{2}=$\n{{field-2}}" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+5x-1 \\\\ y=-2x-13\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+5x-1 & =-2x-13 \\\\ {x}^{2}+7x+12 & =0 \\\\ (x+4)(x+3) & =0 \\\\ x & =-4,-3.\\end{aligned}\n$$\n\nSince ${x}_{1}<{x}_{2},$ the $x$-coordinates of the intersection points are ${x}_{1}=-4$ and ${x}_{2}=-3.$\n\nTo find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the line since it's simpler.\n\n- Substituting ${x}_{1}=-4,$ we get\n\n$$\n\\begin{aligned}{y}_{1} & =-2{x}_{1}-13 \\\\  & =-2(-4)-13 \\\\  & =-5,\\end{aligned}\n$$\n\nso one point of intersection is $({x}_{1},{y}_{1})=(-4,-5).$\n\n- Substituting ${x}_{2}=-3,$ we get\n\n$$\n\\begin{aligned}{y}_{2} & =-2{x}_{2}-13 \\\\  & =-2(-3)-13 \\\\  & =-7,\\end{aligned}\n$$\n\nso the other point of intersection is $({x}_{2},{y}_{2})=(-3,-7).$\n\nA sketch of the situation is shown below.\n\n![](images/78/782a5e0fbe4c362ca17e86a11f017f6909873cb1f06f0d801d6d958bd1c8ab44.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a6c1656d-f914-59ef-862b-d658127e5cce" "answer-field-55faa739-ebaa-5c90-a047-3bc90cd8f091"] :db/ensure [:question/validate]} {:db/id "answer-field-a6c1656d-f914-59ef-862b-d658127e5cce" :answer-field/id #uuid "a6c1656d-f914-59ef-862b-d658127e5cce" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f7f8e2a0-ea50-50ee-b075-78ac59d58fe6" :answer-field/choices ["answer-f7f8e2a0-ea50-50ee-b075-78ac59d58fe6"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7f8e2a0-ea50-50ee-b075-78ac59d58fe6" :answer/id #uuid "f7f8e2a0-ea50-50ee-b075-78ac59d58fe6" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-field-55faa739-ebaa-5c90-a047-3bc90cd8f091" :answer-field/id #uuid "55faa739-ebaa-5c90-a047-3bc90cd8f091" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-be915f26-a2fb-5d29-9b1c-a6e737760c74" :answer-field/choices ["answer-be915f26-a2fb-5d29-9b1c-a6e737760c74"] :db/ensure [:answer-field/validate]} {:db/id "answer-be915f26-a2fb-5d29-9b1c-a6e737760c74" :answer/id #uuid "be915f26-a2fb-5d29-9b1c-a6e737760c74" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id 17592186217110 :knowledge-point/questions ["question-fc9c836c-676e-5aa5-b4fe-1701bb866c98" "question-28de8699-3497-5296-9483-734e67042dfa"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fc9c836c-676e-5aa5-b4fe-1701bb866c98" :question/id #uuid "fc9c836c-676e-5aa5-b4fe-1701bb866c98" :question/math-academy-id "q-250103" :question/problem "The parabola $y={x}^{2}+5x+1$ and the line $y=3x$ intersect at the point $P.$ Find the coordinates of $P.$\n\nThe coordinates of $P$ are\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+5x+1 \\\\ y=3x\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+5x+1 & =3x \\\\ {x}^{2}+5x+1-3x & =0 \\\\ {x}^{2}+2x+1 & =0 \\\\ (x+1)(x+1) & =0 \\\\ x & =-1.\\end{aligned}\n$$\n\nSo, the $x$-coordinate of the intersection point is $x=-1.$\n\nTo find the $y$-coordinate of the intersection point, we plug this value into either curve. Let's choose the equation of the line. Substituting $x=-1,$ we get\n\n$$\n\\begin{aligned}y & =3x \\\\  & =3(-1) \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the only point of intersection is $(-1,-3).$\n\nA sketch of the situation is shown below.\n\n![](images/3a/3a5db47f31fc3e7be1afa4c5413e193c0751b68998e573093c69da5f2441b5a7.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1917052b-8eb2-50f9-8460-330446612d70" "answer-field-db3f8322-9a29-5bb3-823b-39d461179c3c"] :db/ensure [:question/validate]} {:db/id "answer-field-1917052b-8eb2-50f9-8460-330446612d70" :answer-field/id #uuid "1917052b-8eb2-50f9-8460-330446612d70" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-15e632f5-c50c-5da4-bb1c-9c0ced37d622" :answer-field/choices ["answer-15e632f5-c50c-5da4-bb1c-9c0ced37d622"] :db/ensure [:answer-field/validate]} {:db/id "answer-15e632f5-c50c-5da4-bb1c-9c0ced37d622" :answer/id #uuid "15e632f5-c50c-5da4-bb1c-9c0ced37d622" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-db3f8322-9a29-5bb3-823b-39d461179c3c" :answer-field/id #uuid "db3f8322-9a29-5bb3-823b-39d461179c3c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-db2c4ef0-9137-54be-b391-5354ceba0e2f" :answer-field/choices ["answer-db2c4ef0-9137-54be-b391-5354ceba0e2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-db2c4ef0-9137-54be-b391-5354ceba0e2f" :answer/id #uuid "db2c4ef0-9137-54be-b391-5354ceba0e2f" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-28de8699-3497-5296-9483-734e67042dfa" :question/id #uuid "28de8699-3497-5296-9483-734e67042dfa" :question/math-academy-id "q-250220" :question/problem "The parabola $y={x}^{2}+x+4$ and the line $y=5x$ intersect at the point $P.$ Find the coordinates of $P.$\n\nThe coordinates of $P$ are\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "We need to solve the following system consisting of the equations of the curves:\n\n$$\n\\{\\begin{aligned}y={x}^{2}+x+4 \\\\ y=5x\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get\n\n$$\n\\begin{aligned}{x}^{2}+x+4 & =5x \\\\ {x}^{2}-4x+4 & =0 \\\\ (x-2)(x-2) & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nSo, the $x$-coordinate of the intersection point is $x=2.$\n\nTo find the $y$-coordinate of the intersection point, we plug this value into either curve. Let's choose the equation of the line. Substituting $x=2,$ we get\n\n$$\n\\begin{aligned}y & =5x \\\\  & =5(2) \\\\  & =10.\\end{aligned}\n$$\n\nTherefore, the only point of intersection is $(2,10).$\n\nA sketch of the situation is shown below.\n\n![](images/26/268de319ae56302e9b633e09a4c74a0ebd62f3d8ed47829f709036082a644bf4.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-88ead4fe-b75d-5d94-a601-d98ef461e331" "answer-field-70af0a0d-0f7f-5758-a36e-34036e71a3d8"] :db/ensure [:question/validate]} {:db/id "answer-field-88ead4fe-b75d-5d94-a601-d98ef461e331" :answer-field/id #uuid "88ead4fe-b75d-5d94-a601-d98ef461e331" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6296c1c8-c2d4-5228-a381-4cbde8c22806" :answer-field/choices ["answer-6296c1c8-c2d4-5228-a381-4cbde8c22806"] :db/ensure [:answer-field/validate]} {:db/id "answer-6296c1c8-c2d4-5228-a381-4cbde8c22806" :answer/id #uuid "6296c1c8-c2d4-5228-a381-4cbde8c22806" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-70af0a0d-0f7f-5758-a36e-34036e71a3d8" :answer-field/id #uuid "70af0a0d-0f7f-5758-a36e-34036e71a3d8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-60ee5989-15d3-5396-8ca7-f4be1dd32b99" :answer-field/choices ["answer-60ee5989-15d3-5396-8ca7-f4be1dd32b99"] :db/ensure [:answer-field/validate]} {:db/id "answer-60ee5989-15d3-5396-8ca7-f4be1dd32b99" :answer/id #uuid "60ee5989-15d3-5396-8ca7-f4be1dd32b99" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "activity-ab768da5-a0bb-5051-adca-1563f211c382" :activity/id #uuid "ab768da5-a0bb-5051-adca-1563f211c382" :activity/title "Finding Intersections of Lines and Quadratic Functions" :activity/type :activity.type/review :activity/scope 17592186049837 :activity/course 17592186046647 :activity/steps ["step-b732af76-fd32-53cd-8bfd-76e56549c550" "step-12bd621a-7000-5626-840e-1e2db112402f" "step-edd9acce-a217-5a8d-b05c-3997b1f324d3" "step-b38605e4-4f03-5b1a-b27c-afee22c2d31c" "step-6226e994-a854-5980-aad5-8e17608603fe"] :activity/first-step "step-b732af76-fd32-53cd-8bfd-76e56549c550" :db/ensure [:activity/validate]} {:db/id "step-b732af76-fd32-53cd-8bfd-76e56549c550" :step/id #uuid "b732af76-fd32-53cd-8bfd-76e56549c550" :step/content "question-8dc89317-431f-536c-84f1-f80a52b02432" :step/next "step-12bd621a-7000-5626-840e-1e2db112402f" :db/ensure [:step/validate]} {:db/id "step-12bd621a-7000-5626-840e-1e2db112402f" :step/id #uuid "12bd621a-7000-5626-840e-1e2db112402f" :step/content "question-95764a8d-23d1-5507-836a-2817991f65d9" :step/next "step-edd9acce-a217-5a8d-b05c-3997b1f324d3" :db/ensure [:step/validate]} {:db/id "step-edd9acce-a217-5a8d-b05c-3997b1f324d3" :step/id #uuid "edd9acce-a217-5a8d-b05c-3997b1f324d3" :step/content "question-0dbc8468-e68d-529c-9edc-f8593cda9fbb" :step/next "step-b38605e4-4f03-5b1a-b27c-afee22c2d31c" :db/ensure [:step/validate]} {:db/id "step-b38605e4-4f03-5b1a-b27c-afee22c2d31c" :step/id #uuid "b38605e4-4f03-5b1a-b27c-afee22c2d31c" :step/content "question-fc9c836c-676e-5aa5-b4fe-1701bb866c98" :step/next "step-6226e994-a854-5980-aad5-8e17608603fe" :db/ensure [:step/validate]} {:db/id "step-6226e994-a854-5980-aad5-8e17608603fe" :step/id #uuid "6226e994-a854-5980-aad5-8e17608603fe" :step/content "question-28de8699-3497-5296-9483-734e67042dfa" :db/ensure [:step/validate]} {:db/id 17592186157367 :knowledge-point/questions ["question-a4bf276d-b40b-5d47-b840-e4ace9d966fe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a4bf276d-b40b-5d47-b840-e4ace9d966fe" :question/id #uuid "a4bf276d-b40b-5d47-b840-e4ace9d966fe" :question/math-academy-id "q-126763" :question/problem "Calculate ${f}^{″}(0).$\n\n${f}^{″}(0)\\,\\,=\\,\\,$\n{{field-1}}" :question/worked-solution "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(2x\\sqrt{1-{y}^{2}}) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =2x\\frac{\\text{d}}{\\text{d}x}\\sqrt{1-{y}^{2}}+\\sqrt{1-{y}^{2}}\\frac{\\text{d}}{\\text{d}x}(2x) \\\\  & =2x\\frac{\\text{d}}{\\text{d}y}\\sqrt{1-{y}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}+\\sqrt{1-{y}^{2}}\\cdot 2 \\\\  & =-\\frac{2xy}{\\sqrt{1-{y}^{2}}}\\frac{\\text{d}y}{\\text{d}x}+2\\sqrt{1-{y}^{2}}.\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\frac{\\text{d}y}{\\text{d}x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =-\\frac{2xy}{\\sqrt{1-{y}^{2}}}\\cdot 2x\\sqrt{1-{y}^{2}}+2\\sqrt{1-{y}^{2}} \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =-4{x}^{2}y+2\\sqrt{1-{y}^{2}}\\end{aligned}\n$$\n\nFinally, since the point $(0,0)$ lies on $f,$ we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,0)} & =-4\\cdot {0}^{2}\\cdot 0+2\\sqrt{1-{0}^{2}}=2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-72a14dfe-4aac-5b96-99e1-2adb2bdf2921"] :db/ensure [:question/validate]} {:db/id "answer-field-72a14dfe-4aac-5b96-99e1-2adb2bdf2921" :answer-field/id #uuid "72a14dfe-4aac-5b96-99e1-2adb2bdf2921" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a94de121-a4bc-5c49-b381-af42e7f0741f" :answer-field/choices ["answer-a94de121-a4bc-5c49-b381-af42e7f0741f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a94de121-a4bc-5c49-b381-af42e7f0741f" :answer/id #uuid "a94de121-a4bc-5c49-b381-af42e7f0741f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186175921 :knowledge-point/questions ["question-9b186f94-2456-5e8b-8019-128c4ccb5b71"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9b186f94-2456-5e8b-8019-128c4ccb5b71" :question/id #uuid "9b186f94-2456-5e8b-8019-128c4ccb5b71" :question/math-academy-id "q-126764" :question/problem "Use Euler's method to find an approximation to $y(0.2)$ using two steps of equal size.\n\n$y\\,\\,=\\,\\,$\n{{field-1}}" :question/worked-solution "First, note that we are given $y(0)$ and asked to find $y(0.2).$ The distance from $x=0$ to $x=0.2$ is $0.2,$ and since we are asked to use two steps of equal size, our step size must be \n\n$$\nΔx=\\frac{0.2-0}{2}=0.1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=0.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $0$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x\\sqrt{1-{y}^{2}}=2\\cdot 0\\cdot \\sqrt{1-{0}^{2}}=0 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 0.1=0 \\\\ {x}_{\\text{new}} & =x+Δx=0+0.1=0.1 \\\\ {y}_{\\text{new}} & =y+Δy=0+0=0\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $0$ |\n| $0.1$ | $0$ | $$ | $$ |\n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x\\sqrt{1-{y}^{2}}=2\\cdot 0.1\\cdot \\sqrt{1-{0}^{2}}=0.2 \\\\ Δy & ={y}^{′}\\cdot Δx=0.2\\cdot 0.1=0.02 \\\\ {x}_{\\text{new}} & =x+Δx=0.1+0.1=0.2 \\\\ {y}_{\\text{new}} & =y+Δy=0+0.02=0.02\\end{aligned}\n$$\n\n \n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $0$ |\n| $0.1$ | $0$ | $0.2$ | $0.02$ |\n| $0.2$ | $0.02$ | $$ | $$ |\n\nTherefore, we conclude that  $f(0.2)≈0.02.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cfb2ed2d-7ad9-5182-a69d-d31e503dd0c3"] :db/ensure [:question/validate]} {:db/id "answer-field-cfb2ed2d-7ad9-5182-a69d-d31e503dd0c3" :answer-field/id #uuid "cfb2ed2d-7ad9-5182-a69d-d31e503dd0c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e8ccf237-4b9b-58f9-b076-7fd0f6ca2fdf" :answer-field/choices ["answer-e8ccf237-4b9b-58f9-b076-7fd0f6ca2fdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8ccf237-4b9b-58f9-b076-7fd0f6ca2fdf" :answer/id #uuid "e8ccf237-4b9b-58f9-b076-7fd0f6ca2fdf" :answer/type :answer.type/math :answer/value "0.02" :db/ensure [:answer/validate]} {:db/id 17592186100894 :knowledge-point/questions ["question-1bc80b6f-e02e-58f0-97b4-8ea651af23ac"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1bc80b6f-e02e-58f0-97b4-8ea651af23ac" :question/id #uuid "1bc80b6f-e02e-58f0-97b4-8ea651af23ac" :question/math-academy-id "q-126765" :question/problem "Find the general solution to the differential equation. Express your answer in the form $y=y(x).$\n\n$y\\,\\,=\\,\\,\\operatorname{sin}⁡(\\,$\n{{field-1}}\n$+\\,C),\\,\\,$where $C$ is an arbitrary constant." :question/worked-solution "First, we separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2x\\sqrt{1-{y}^{2}} \\\\ \\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nNext, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ \\operatorname{arcsin}⁡y & ={x}^{2}+C\\end{aligned}\n$$\n\nThis is a perfectly valid general solution. However, if we want to write $y=y(x)$ explicitly, then we can solve for $y.$ This gives\n\n$$\ny=\\operatorname{sin}⁡({x}^{2}+C)\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4d2156ef-39e9-59d1-b08e-81876504abac"] :db/ensure [:question/validate]} {:db/id "answer-field-4d2156ef-39e9-59d1-b08e-81876504abac" :answer-field/id #uuid "4d2156ef-39e9-59d1-b08e-81876504abac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d692ba23-e86a-5e24-a39c-8c7caf6f455f" :answer-field/choices ["answer-d692ba23-e86a-5e24-a39c-8c7caf6f455f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d692ba23-e86a-5e24-a39c-8c7caf6f455f" :answer/id #uuid "d692ba23-e86a-5e24-a39c-8c7caf6f455f" :answer/type :answer.type/math :answer/value "x^2" :db/ensure [:answer/validate]} {:db/id 17592186100893 :knowledge-point/questions ["question-11ed723f-8fe2-5c56-8bb0-841acdfb0940"] :db/ensure [:knowledge-point/validate]} {:db/id "question-11ed723f-8fe2-5c56-8bb0-841acdfb0940" :question/id #uuid "11ed723f-8fe2-5c56-8bb0-841acdfb0940" :question/math-academy-id "q-126766" :question/problem "Given that $|C|\\le \\frac{\\pi }{2},$ use the general solution to the equation to find the function $f(x).$\n\n$f(x)\\,\\,=\\,\\,$\n{{field-1}}" :question/worked-solution "The general solution is\n\n$$\ny=\\operatorname{sin}⁡({x}^{2}+C).\n$$\n\nWe now apply the condition $y(0)=0$ to find $K:$\n\n$$\n\\begin{aligned}0 & =\\operatorname{sin}⁡({0}^{2}+C) \\\\ 0 & =\\operatorname{sin}⁡(C) \\\\ C & =0\\end{aligned}\n$$\n\nThus, the particular solution of ${y}^{′}=xy$ that satisfies the condition $y(0)=0$ is\n\n$$\ny=\\operatorname{sin}⁡({x}^{2}+0)=\\operatorname{sin}⁡({x}^{2}).\n$$\n\nHence, $f(x)=\\operatorname{sin}⁡({x}^{2}).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cf767100-f800-58a2-a235-bc232ccd9496"] :db/ensure [:question/validate]} {:db/id "answer-field-cf767100-f800-58a2-a235-bc232ccd9496" :answer-field/id #uuid "cf767100-f800-58a2-a235-bc232ccd9496" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9f82827-bfc3-518b-84b7-a88995159d91" :answer-field/choices ["answer-a9f82827-bfc3-518b-84b7-a88995159d91"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9f82827-bfc3-518b-84b7-a88995159d91" :answer/id #uuid "a9f82827-bfc3-518b-84b7-a88995159d91" :answer/type :answer.type/math :answer/value "\\sin(x^2)" :db/ensure [:answer/validate]} {:db/id 17592186087787 :knowledge-point/questions ["question-d1d89a0f-00b0-5608-ac35-e4c5c811a70d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d1d89a0f-00b0-5608-ac35-e4c5c811a70d" :question/id #uuid "d1d89a0f-00b0-5608-ac35-e4c5c811a70d" :question/math-academy-id "q-126767" :question/problem "Find the first three non-zero terms of the Maclaurin expansion of $f(x).$\n\n$f(x)\\,\\,=\\,\\,$\n{{field-1}}\n$\\,\\,+\\,\\,$\n{{field-2}}\n$\\,\\,+\\,\\,$\n{{field-3}}\n$\\,\\,+\\,\\,⋯\\,.$" :question/worked-solution "The standard Maclaurin expansion for $\\operatorname{sin}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}+⋯\\,.\\end{aligned}\n$$\n\nReplacing $x$ with ${x}^{2}$ in the above expansion and simplifying gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡({x}^{2}) & =({x}^{2})-\\frac{1}{6}({x}^{2})^{3}+\\frac{1}{120}({x}^{2})^{5}+⋯ \\\\  & ={x}^{2}-\\frac{1}{6}{x}^{6}+\\frac{1}{120}{x}^{10}+⋯\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5b6d8bb1-dc72-57b4-8ae4-3352e7114253" "answer-field-ef950b23-df29-5428-9d9a-cb0f2b045309" "answer-field-e53bb430-337d-5efc-a511-030700cf693c"] :db/ensure [:question/validate]} {:db/id "answer-field-5b6d8bb1-dc72-57b4-8ae4-3352e7114253" :answer-field/id #uuid "5b6d8bb1-dc72-57b4-8ae4-3352e7114253" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4894c5e3-d189-5188-b2cd-8e0fcb9cb0af" :answer-field/choices ["answer-4894c5e3-d189-5188-b2cd-8e0fcb9cb0af"] :db/ensure [:answer-field/validate]} {:db/id "answer-4894c5e3-d189-5188-b2cd-8e0fcb9cb0af" :answer/id #uuid "4894c5e3-d189-5188-b2cd-8e0fcb9cb0af" :answer/type :answer.type/math :answer/value "x^2" :db/ensure [:answer/validate]} {:db/id "answer-field-ef950b23-df29-5428-9d9a-cb0f2b045309" :answer-field/id #uuid "ef950b23-df29-5428-9d9a-cb0f2b045309" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-310709fe-e9c3-552c-943c-e064e286df88" :answer-field/choices ["answer-310709fe-e9c3-552c-943c-e064e286df88"] :db/ensure [:answer-field/validate]} {:db/id "answer-310709fe-e9c3-552c-943c-e064e286df88" :answer/id #uuid "310709fe-e9c3-552c-943c-e064e286df88" :answer/type :answer.type/math :answer/value "-\\frac{x^6}{6}" :db/ensure [:answer/validate]} {:db/id "answer-field-e53bb430-337d-5efc-a511-030700cf693c" :answer-field/id #uuid "e53bb430-337d-5efc-a511-030700cf693c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-19a023b1-849e-5a22-8537-3b1e243bc4d3" :answer-field/choices ["answer-19a023b1-849e-5a22-8537-3b1e243bc4d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-19a023b1-849e-5a22-8537-3b1e243bc4d3" :answer/id #uuid "19a023b1-849e-5a22-8537-3b1e243bc4d3" :answer/type :answer.type/math :answer/value "\\frac{x^{10}}{120}" :db/ensure [:answer/validate]} {:db/id 17592186087794 :knowledge-point/questions ["question-a3b460f4-8f03-59ea-8d4e-3d88c9d8d99f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a3b460f4-8f03-59ea-8d4e-3d88c9d8d99f" :question/id #uuid "a3b460f4-8f03-59ea-8d4e-3d88c9d8d99f" :question/math-academy-id "q-126768" :question/problem "Using the first two non-zero terms of the Maclaurin expansion of $f(x),$ approximate ${\\int }_{0}^{1}f(x)\\,\\text{d}x.$ Write your answer as a fraction in its lowest terms.\n\n${\\int }_{0}^{1}f(x)\\,\\text{d}x\\,\\,≈\\,\\,$\n{{field-1}}" :question/worked-solution "We have that\n\n$$\nf(x)≈{x}^{2}-\\frac{{x}^{6}}{6}.\n$$\n\nWe can approximate $\\int f(x)\\,\\text{d}x$ by integrating the above series term-by-term, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(x)\\,\\text{d}x & ≈{\\int }_{0}^{1}({x}^{2}-\\frac{{x}^{6}}{6})\\,\\text{d}x \\\\  & ={(\\frac{1}{3}{x}^{3}-\\frac{1}{42}{x}^{6})|}_{0}^{1} \\\\  & =[\\frac{1}{3}-\\frac{1}{42}]-0 \\\\  & =\\frac{13}{42}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-96f0fd95-c9b0-5cbe-abcc-ca8956c4e2ea"] :db/ensure [:question/validate]} {:db/id "answer-field-96f0fd95-c9b0-5cbe-abcc-ca8956c4e2ea" :answer-field/id #uuid "96f0fd95-c9b0-5cbe-abcc-ca8956c4e2ea" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2c6372b2-3f3a-5d2d-9b9b-d69b71a08c40" :answer-field/choices ["answer-2c6372b2-3f3a-5d2d-9b9b-d69b71a08c40"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c6372b2-3f3a-5d2d-9b9b-d69b71a08c40" :answer/id #uuid "2c6372b2-3f3a-5d2d-9b9b-d69b71a08c40" :answer/type :answer.type/math :answer/value "\\frac{13}{42}" :db/ensure [:answer/validate]} {:db/id 17592186092269 :knowledge-point/questions ["question-8679792d-1ee6-50ba-bf59-17896dc979de"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8679792d-1ee6-50ba-bf59-17896dc979de" :question/id #uuid "8679792d-1ee6-50ba-bf59-17896dc979de" :question/math-academy-id "q-126769" :question/problem "Given that the Maclaurin expansion of $f(x)$ can be represented as\n\n$$\nf(x)={\\sum }_{n=0}^{\\infty }\\frac{(-1)^{n}{x}^{4n+2}}{(2n+1)!},\n$$\n\ncalculate the radius of convergence $R$ of this power series.\n\n$R\\,\\,=\\,\\,$\n{{field-1}}" :question/worked-solution "To find the radius of convergence, we apply the ratio test.\n\nSo, let's denote ${a}_{n}=\\frac{(-1)^{n}{x}^{4n+2}}{(2n+1)!}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(-1)^{n+1}{x}^{4n+6}}{(2n+3)!}\\cdot \\frac{(2n+1)!}{(-1)^{n}{x}^{4n+2}}| \\\\  & ={lim}_{n\\to \\infty }|-\\frac{{x}^{4}}{(2n+2)(2n+3)}| \\\\  & ={x}^{4}{lim}_{n\\to \\infty }|\\frac{1}{(2n+2)(2n+3)}| \\\\  & ={x}^{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nThe series converges if $L<1.$ In this case, the convergence condition is satisfied for all $-\\infty <x<\\infty .$ Therefore, we conclude that the radius of convergence is $R=\\infty .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ee13cf7b-506a-556c-9c39-4af06c9d75a9"] :db/ensure [:question/validate]} {:db/id "answer-field-ee13cf7b-506a-556c-9c39-4af06c9d75a9" :answer-field/id #uuid "ee13cf7b-506a-556c-9c39-4af06c9d75a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c0ee0055-9260-50e8-82d0-59ef2f03f218" :answer-field/choices ["answer-c0ee0055-9260-50e8-82d0-59ef2f03f218"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0ee0055-9260-50e8-82d0-59ef2f03f218" :answer/id #uuid "c0ee0055-9260-50e8-82d0-59ef2f03f218" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id 17592186054682 :knowledge-point/questions ["question-1f6c3d65-e721-5449-9ddc-958a81a54048"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1f6c3d65-e721-5449-9ddc-958a81a54048" :question/id #uuid "1f6c3d65-e721-5449-9ddc-958a81a54048" :question/math-academy-id "q-126770" :question/problem "Calculate the first three non-zero terms of the Maclaurin expansion of ${f}^{′}(x).$\n\n${f}^{′}(x)\\,\\,=\\,\\,$\n{{field-1}}\n$\\,\\,+\\,\\,$\n{{field-2}}\n$\\,\\,+\\,\\,$\n{{field-3}}\n$\\,\\,+\\,\\,⋯\\,.$" :question/worked-solution "We have that\n\n$$\nf(x)={\\sum }_{n=0}^{\\infty }\\frac{(-1)^{n}{x}^{4n+2}}{(2n+1)!}.\n$$\n\nWriting the first few terms of the series explicitly, we have\n\n$$\nf(x)={x}^{2}-\\frac{1}{6}{x}^{6}+\\frac{1}{120}{x}^{10}+⋯\\,.\n$$\n\nTo find ${f}^{′}(x),$ we differentiate term-by-term. This gives\n\n$$\n{f}^{′}(x)=2x-{x}^{5}+\\frac{1}{12}{x}^{9}+⋯\\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d246d886-a271-5eac-b996-a935f3cc4523" "answer-field-185d4856-04c2-50f7-84b9-410c7305e5d2" "answer-field-d014467f-0ee5-505a-9570-429795048b5c"] :db/ensure [:question/validate]} {:db/id "answer-field-d246d886-a271-5eac-b996-a935f3cc4523" :answer-field/id #uuid "d246d886-a271-5eac-b996-a935f3cc4523" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4e2b7960-3515-5fdb-851d-2acdacca5d55" :answer-field/choices ["answer-4e2b7960-3515-5fdb-851d-2acdacca5d55"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e2b7960-3515-5fdb-851d-2acdacca5d55" :answer/id #uuid "4e2b7960-3515-5fdb-851d-2acdacca5d55" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "answer-field-185d4856-04c2-50f7-84b9-410c7305e5d2" :answer-field/id #uuid "185d4856-04c2-50f7-84b9-410c7305e5d2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5ebe73f6-f39b-5a49-b3c3-de18743301b9" :answer-field/choices ["answer-5ebe73f6-f39b-5a49-b3c3-de18743301b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ebe73f6-f39b-5a49-b3c3-de18743301b9" :answer/id #uuid "5ebe73f6-f39b-5a49-b3c3-de18743301b9" :answer/type :answer.type/math :answer/value "-x^5" :db/ensure [:answer/validate]} {:db/id "answer-field-d014467f-0ee5-505a-9570-429795048b5c" :answer-field/id #uuid "d014467f-0ee5-505a-9570-429795048b5c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3c973ac4-5ab5-5a93-bb56-ca24aab38187" :answer-field/choices ["answer-3c973ac4-5ab5-5a93-bb56-ca24aab38187"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c973ac4-5ab5-5a93-bb56-ca24aab38187" :answer/id #uuid "3c973ac4-5ab5-5a93-bb56-ca24aab38187" :answer/type :answer.type/math :answer/value "\\frac{x^9}{12}" :db/ensure [:answer/validate]} {:db/id "multistep-606e3887-aa6c-5661-a09f-d03aff0342a6" :multistep/id #uuid "606e3887-aa6c-5661-a09f-d03aff0342a6" :multistep/context "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2x\\sqrt{1-{y}^{2}}.$ Let $y=f(x)$ be the solution that satisfies the initial condition $y(0)=0.$" :multistep/steps ["step-9d567ac4-3591-5e06-9a40-8ada07224f7a" "step-9b3368b3-002f-5049-9caf-1dd41adbd0b3" "step-fef72321-9632-5c83-a15d-ec7ad1fe6832" "step-98e0c967-ffc1-5e8f-b187-c669c0ecac15" "step-019385a6-ffb0-5ec8-b099