-bb5e-523a-8987-eea2adb65102" :answer/id #uuid "bc70d7a5-bb5e-523a-8987-eea2adb65102" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-7660e2b8-4bfb-5c0b-833f-3b8223195211" :answer/id #uuid "7660e2b8-4bfb-5c0b-833f-3b8223195211" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-bdf5d372-c050-5c3d-88c9-dcbaace4b624" :answer-field/id #uuid "bdf5d372-c050-5c3d-88c9-dcbaace4b624" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-000cc7f2-c4e5-5aa6-9724-b55778b9ed16" :answer-field/choices ["answer-df2d461c-bb5c-5c20-a3c7-9f0294a6bba6" "answer-98857014-a914-550a-aa97-044d5b4c7812" "answer-296efdb0-b422-5a02-a76c-ccf2749a601d" "answer-000cc7f2-c4e5-5aa6-9724-b55778b9ed16" "answer-ee48b1a7-50cd-5e63-bcd3-da61e3a89995" "answer-92d3bb01-ed2e-5352-80a8-a6aedbfc134e"] :db/ensure [:answer-field/validate]} {:db/id "answer-df2d461c-bb5c-5c20-a3c7-9f0294a6bba6" :answer/id #uuid "df2d461c-bb5c-5c20-a3c7-9f0294a6bba6" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }2{x}^{3}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-98857014-a914-550a-aa97-044d5b4c7812" :answer/id #uuid "98857014-a914-550a-aa97-044d5b4c7812" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }2{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-296efdb0-b422-5a02-a76c-ccf2749a601d" :answer/id #uuid "296efdb0-b422-5a02-a76c-ccf2749a601d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }2{x}^{3}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-000cc7f2-c4e5-5aa6-9724-b55778b9ed16" :answer/id #uuid "000cc7f2-c4e5-5aa6-9724-b55778b9ed16" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }2{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ee48b1a7-50cd-5e63-bcd3-da61e3a89995" :answer/id #uuid "ee48b1a7-50cd-5e63-bcd3-da61e3a89995" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }2{x}^{3}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-92d3bb01-ed2e-5352-80a8-a6aedbfc134e" :answer/id #uuid "92d3bb01-ed2e-5352-80a8-a6aedbfc134e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }2{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-3db32c22-3de8-5264-9b28-9916a3aeb5f2" :question/id #uuid "3db32c22-3de8-5264-9b28-9916a3aeb5f2" :question/math-academy-id "q-340659" :question/problem "Let $F(x)=2{x}^{4}-4{x}^{3}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{3}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{b}_{3} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(3x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(3x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(3x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(3x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(3x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{3}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩ & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)-\\frac{1}{12}(\\operatorname{sin}⁡(12\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(3x)⟩ & ={b}_{3}⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩ \\\\ {b}_{3} & =\\frac{⟨f(x),\\operatorname{sin}⁡(3x)⟩}{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩} \\\\ {b}_{3} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(2{x}^{4}-4{x}^{3})\\operatorname{sin}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1f978f14-7743-5e8c-b891-41d5a5372431" "answer-field-4ea577f4-edb3-5442-83b4-270041c2560c" "answer-field-b78b