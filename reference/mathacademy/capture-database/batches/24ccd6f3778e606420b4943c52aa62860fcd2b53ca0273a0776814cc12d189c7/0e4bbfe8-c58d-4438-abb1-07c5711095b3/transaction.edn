f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-855ee43d-1d00-510a-9f3e-d0e267711926" :answer/id #uuid "855ee43d-1d00-510a-9f3e-d0e267711926" :answer/type :answer.type/math :answer/value "-{a}_{6}" :db/ensure [:answer/validate]} {:db/id "answer-8d16cef1-f56a-5c7f-81ad-ad3dd97f643a" :answer/id #uuid "8d16cef1-f56a-5c7f-81ad-ad3dd97f643a" :answer/type :answer.type/math :answer/value "-{b}_{6}" :db/ensure [:answer/validate]} {:db/id "answer-06ac0042-e258-55d3-b06c-2dcaddce1106" :answer/id #uuid "06ac0042-e258-55d3-b06c-2dcaddce1106" :answer/type :answer.type/math :answer/value "{a}_{6}" :db/ensure [:answer/validate]} {:db/id "answer-42fda2fe-8869-54c1-9994-a4a16cdfb92d" :answer/id #uuid "42fda2fe-8869-54c1-9994-a4a16cdfb92d" :answer/type :answer.type/math :answer/value "{b}_{6}" :db/ensure [:answer/validate]} {:db/id "answer-78004f4b-bec6-56c5-b3cf-fd82e750fdf4" :answer/id #uuid "78004f4b-bec6-56c5-b3cf-fd82e750fdf4" :answer/type :answer.type/math :answer/value "{b}_{6}-1" :db/ensure [:answer/validate]} {:db/id "question-1c3a98af-770d-5596-b478-235b18fb3ea6" :question/id #uuid "1c3a98af-770d-5596-b478-235b18fb3ea6" :question/math-academy-id "q-340803" :question/problem "Consider the function $f(x)={x}^{3}$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.\n\n$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the \n{{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." :question/worked-solution "To determine whether $f$ is even or odd, we compare $f(-x)$ and $f(x):$\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{3} \\\\  & =-{x}^{3} \\\\  & =-f(x).\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ we have that $f$ is odd.\n\nFor Fourier series on $[-\\pi ,\\pi ],$ the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x,\n$$\n\nand the constant coefficient is\n\n$$\n{a}_{0}=\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nHere, $f(x)$ is odd and $\\operatorname{cos}⁡(nx)$ is even, so $f(x)\\operatorname{cos}⁡(nx)$ is odd. Also, $f(x)$ itself is odd.\n\nNow, the integral of an odd function over $[-\\pi ,\\pi ]$ is $0.$ Thus, ${a}_{n}=0$ for all $n\\ge 1,$ and ${a}_{0}=0.$\n\nTherefore, the function $f(x)$ is $\\text{odd}$ and the $\\text{cosine terms}$ in its Fourier series must be zero." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9e6aa259-14bb-55a0-a32b-6f1dd8102da1" "answer-field-84d979af-bada-5d48-b9b9-abee0d8305c3"] :db/ensure [:question/validate]} {:db/id "answer-field-9e6aa259-14bb-55a0-a32b-6f1dd8102da1" :answer-field/id #uuid "9e6aa259-14bb-55a0-a32b-6f1dd8102da1" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-875debda-8d72-5cf9-95af-a4fc52515b63" :answer-field/choices ["answer-e9c8b1f4-9aa2-5582-8783-b19afb0a69ca" "answer-875debda-8d72-5cf9-95af-a4fc52515b63"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9c8b1f4-9aa2-5582-8783-b19afb0a69ca" :answer/id #uuid "e9c8b1f4-9aa2-5582-8783-b19afb0a69ca" :answer/type :answer.type/text :answer/value "even" :db/ensure [:answer/validate]} {:db/id "answer-875debda-8d72-5cf9-95af-a4fc52515b63" :answer/id #uuid "875debda-8d72-5cf9-95af-a4fc52515b63" :answer/type :answer.type/text :answer/value "odd" :db/ensure [:answer/validate]} {:db/id "answer-field-84d979af-bada-5d48-b9b9-abee0d8305c3" :answer-field/id #uuid "84d979af-bada-5d48-b9b9-abee0d8305c3" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-d039172d-a4c1-57bd-9a38-a0c72987e9c7" :answer-field/choices ["answer-d039172d-a4c1-57bd-9a38-a0c72987e9c7" "answer-403a5171-c76a-585a-8404-59d8cf8da5e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-d039172d-a4c1-57bd-9a38-a0c72987e9c7" :answer/id #uuid "d039172d-a4c1-57bd-9a38-a0c72987e9c7" :answer/type :answer.type/text :answer/value "cosine terms" :db/ensure [:answer/validate]} {:db/id "answer-403a5171-c76a-585a-8404-59d8cf8da5e4" :answer/id #uuid "403a5171-c76a-585a-8404-59d8cf8da5e4" :answer/type :answer.type/text :answer/value "sine terms" :db/ensure [:answer/validate]} {:db/id 17592186229721 :question/problem "Consider the function $f(x)=x\\operatorname{cos}⁡(x)$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.\n\n$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the \n{{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." :db/ensure [:question/validate]} {:db/id 17592186385249 :question/problem "Consider the function $f(x)={x}^{2}\\operatorname{cos}⁡(2x)$ on $x\\in [-\\pi ,\\pi ].$ Select the correct options below.\n\n$\\,$\nThe function $f(x)$ is\n{{field-1}}.\n\n$\\,$\nConsequently, the {{field-2}}\nin the corresponding Fourier series of $f(x)$ must be zero." :db/ensure [:question/validate]}]
