/validate]} {:db/id "step-1416b6a4-d597-51ec-a524-9ef5b7276f7c" :step/id #uuid "1416b6a4-d597-51ec-a524-9ef5b7276f7c" :step/content "question-1f6c3d65-e721-5449-9ddc-958a81a54048" :db/ensure [:step/validate]} {:db/id "assigned-problem-fb209e62-dbab-5627-b8de-306596211c79" :assigned-problem/id #uuid "fb209e62-dbab-5627-b8de-306596211c79" :assigned-problem/content "multistep-606e3887-aa6c-5661-a09f-d03aff0342a6" :assigned-problem/topic-coverage [17592186049383 17592186049441 17592186050905 17592186049182 17592186049763 17592186050624 17592186050041] :db/ensure [:assigned-problem/validate]} {:db/id "activity-cb478c86-c497-527d-9542-67e33d7882e4" :activity/id #uuid "cb478c86-c497-527d-9542-67e33d7882e4" :activity/title "Differential Equations Using Euler's Method, Separation of Variables, and Taylor Series" :activity/type :activity.type/assignment :activity/steps ["step-e4374f50-07e1-5853-b506-24a74cb84c96"] :activity/first-step "step-e4374f50-07e1-5853-b506-24a74cb84c96" :db/ensure [:activity/validate]} {:db/id "step-e4374f50-07e1-5853-b506-24a74cb84c96" :step/id #uuid "e4374f50-07e1-5853-b506-24a74cb84c96" :step/content "assigned-problem-fb209e62-dbab-5627-b8de-306596211c79" :db/ensure [:step/validate]} {:db/id 17592186198354 :knowledge-point/questions ["question-aad779ca-b824-50cb-b4dc-f0dd2ba06356" "question-1c9e9df7-050b-54af-a7dc-34ce03f716ac"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aad779ca-b824-50cb-b4dc-f0dd2ba06356" :question/id #uuid "aad779ca-b824-50cb-b4dc-f0dd2ba06356" :question/math-academy-id "q-35267" :question/problem "Which of the following best describes the projection of the intersection between the elliptic cone ${x}^{2}+(y-1)^{2}={z}^{2}$ and the plane $2x-y=0$ onto the $xz$-plane?" :question/worked-solution "Since we want to find the projection onto the $xz$-plane, we need to eliminate the variable $y.$ First, we solve the equation of the plane for $y,$ as follows:\n\n$$\n2x-y=0\\,⟹\\,y=2x\n$$\n\nSubstituting the expression for $y$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+(2x-1)^{2} & ={z}^{2} \\\\ {x}^{2}+4{x}^{2}-4x+1 & ={z}^{2} \\\\ {z}^{2}-5{x}^{2}+4x & =1 \\\\ {z}^{2}-5({x}^{2}-\\frac{4}{5}x+\\frac{4}{25})+\\frac{4}{5} & =1 \\\\ {z}^{2}-5{({x}^{2}-\\frac{2}{5})}^{2} & =\\frac{1}{5} \\\\ 5{z}^{2}-25{(x-\\frac{2}{5})}^{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperbola centered at $(\\frac{2}{5},0)$ in the $xz$-plane." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7b399ec8-7eac-5c54-a396-185538576377"] :db/ensure [:question/validate]} {:db/id "answer-field-7b399ec8-7eac-5c54-a396-185538576377" :answer-field/id #uuid "7b399ec8-7eac-5c54-a396-185538576377" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d8394f66-6c5c-5f76-a6ef-29a7574673c4" :answer-field/choices ["answer-efefd15d-7892-53ae-9529-407152a306e3" "answer-d8394f66-6c5c-5f76-a6ef-29a7574673c4" "answer-45708bae-dc50-5c9d-9e5d-04417b00fc2e" "answer-97e12641-e027-541c-99c1-6366461603f4" "answer-6b4a85ba-f52f-5884-8c16-83695d5c66ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-efefd15d-7892-53ae-9529-407152a306e3" :answer/id #uuid "efefd15d-7892-53ae-9529-407152a306e3" :answer/type :answer.type/text :answer/value "A hyperbola centered at $(0,-\\frac{2}{5})$" :db/ensure [:answer/validate]} {:db/id "answer-d8394f66-6c5c-5f76-a6ef-29a7574673c4" :answer/id #uuid "d8394f66-6c5c-5f76-a6ef-29a7574673c4" :answer/type :answer.type/text :answer/value "A hyperbola centered at $(\\frac{2}{5},0)$" :db/ensure [:answer/validate]} {:db/id "answer-45708bae-dc50-5c9d-9e5d-04417b00fc2e" :answer/id #uuid "45708bae-dc50-5c9d-9e5d-04417b00fc2e" :answer/type :answer.type/text :answer/value "A parabola centered at $(-\\frac{2}{5},0)$" :db/ensure [:answer/validate]} {:db/id "answer-97e12641-e027-541c-99c1-6366461603f4" :answer/id #uuid "97e12641-e027-541c-99c1-6366461603f4" :answer/type :answer.type/text :answer/value "An ellipse centered at $(-\\frac{1}{5},1)$" :db/ensure [:answer/validate]} {:db/id "answer-6b4a85ba-f52f-5884-8c16-83695d5c66ee" :answer/id #uuid "6b4a85ba-f52f-5884-8c16-83695d5c66ee" :answer/type :answer.type/text :answer/value "An ellipse centered at $(\\frac{2}{5},0)$" :db/ensure [:answer/validate]} {:db/id "question-1c9e9df7-050b-54af-a7dc-34ce03f716ac" :question/id #uuid "1c9e9df7-050b-54af-a7dc-34ce03f716ac" :question/math-academy-id "q-94941" :question/problem "Which of the following best describes the projection of the intersection between the elliptic cone ${x}^{2}+3{y}^{2}=2{z}^{2}$ and the plane $2z-x+1=0$ onto the $xy$-plane?" :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z,$ as follows:\n\n$$\n2z-x+1=0\\,⟹\\,z=\\frac{x}{2}-\\frac{1}{2}\n$$\n\nSubstituting the expression for $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2} & =2{(\\frac{x}{2}-\\frac{1}{2})}^{2} \\\\ {x}^{2}+3{y}^{2} & =2(\\frac{{x}^{2}}{4}-\\frac{x}{2}+\\frac{1}{4}) \\\\ {x}^{2}+3{y}^{2} & =\\frac{{x}^{2}}{2}-x+\\frac{1}{2} \\\\ \\frac{{x}^{2}}{2}+x+3{y}^{2} & =\\frac{1}{2} \\\\ \\frac{1}{2}(x+1)^{2}-\\frac{1}{2}+3{y}^{2} & =\\frac{1}{2} \\\\ \\frac{(x+1)^{2}}{2}+3{y}^{2} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipse centered at $(-1,0)$ in the $xy$-plane." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a3b78ce5-61ca-5b12-8256-45eaecfa1b9e"] :db/ensure [:question/validate]} {:db/id "answer-field-a3b78ce5-61ca-5b12-8256-45eaecfa1b9e" :answer-field/id #uuid "a3b78ce5-61ca-5b12-8256-45eaecfa1b9e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b11f7f45-cfd1-5e21-bf78-fbf84e1b0907" :answer-field/choices ["answer-216b9c4e-e1e1-55e6-9308-db110453b59c" "answer-081e5bee-d384-5542-a478-5de37b