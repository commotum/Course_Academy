ensure [:answer/validate]} {:db/id "answer-field-4ea577f4-edb3-5442-83b4-270041c2560c" :answer-field/id #uuid "4ea577f4-edb3-5442-83b4-270041c2560c" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-3d73b089-4ec1-5abd-9c8a-c1cd4ac044b7" :answer-field/choices ["answer-0482d884-c4b6-592d-9990-0947df1c915c" "answer-c37ed253-17da-5119-86f7-0e186d55308b" "answer-3d73b089-4ec1-5abd-9c8a-c1cd4ac044b7" "answer-2e951f13-bde1-5397-bbe7-f986cf152056" "answer-d14fd27f-86c4-5e50-9a38-a0fb3d5e73f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0482d884-c4b6-592d-9990-0947df1c915c" :answer/id #uuid "0482d884-c4b6-592d-9990-0947df1c915c" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-c37ed253-17da-5119-86f7-0e186d55308b" :answer/id #uuid "c37ed253-17da-5119-86f7-0e186d55308b" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-3d73b089-4ec1-5abd-9c8a-c1cd4ac044b7" :answer/id #uuid "3d73b089-4ec1-5abd-9c8a-c1cd4ac044b7" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-2e951f13-bde1-5397-bbe7-f986cf152056" :answer/id #uuid "2e951f13-bde1-5397-bbe7-f986cf152056" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-d14fd27f-86c4-5e50-9a38-a0fb3d5e73f6" :answer/id #uuid "d14fd27f-86c4-5e50-9a38-a0fb3d5e73f6" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-field-b78b1748-be2b-5325-ae26-b27a57068806" :answer-field/id #uuid "b78b1748-be2b-5325-ae26-b27a57068806" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-216767d5-53a2-5586-91eb-86d1e28fc889" :answer-field/choices ["answer-0b5395db-b568-583c-8baf-fc07a58b23ed" "answer-64498cad-44bc-56c7-b4bd-80ae810d3b80" "answer-39cd9beb-045a-55b9-821e-f6e11f258364" "answer-216767d5-53a2-5586-91eb-86d1e28fc889" "answer-3d00e3a0-859a-5901-9e18-ad6053b930f3" "answer-0ac76d92-c7a8-5564-a20c-1e1847021666"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b5395db-b568-583c-8baf-fc07a58b23ed" :answer/id #uuid "0b5395db-b568-583c-8baf-fc07a58b23ed" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }(2{x}^{4}-4{x}^{3})\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-64498cad-44bc-56c7-b4bd-80ae810d3b80" :answer/id #uuid "64498cad-44bc-56c7-b4bd-80ae810d3b80" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }(2{x}^{4}-4{x}^{3})\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-39cd9beb-045a-55b9-821e-f6e11f258364" :answer/id #uuid "39cd9beb-045a-55b9-821e-f6e11f258364" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }(2{x}^{4}-4{x}^{3})\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-216767d5-53a2-5586-91eb-86d1e28fc889" :answer/id #uuid "216767d5-53a2-5586-91eb-86d1e28fc889" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }(2{x}^{4}-4{x}^{3})\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-3d00e3a0-859a-5901-9e18-ad6053b930f3" :answer/id #uuid "3d00e3a0-859a-5901-9e18-ad6053b930f3" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }(2{x}^{4}-4{x}^{3})\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-0ac76d92-c7a8-5564-a20c-1e1847021666" :answer/id #uuid "0ac76d92-c7a8-5564-a20c-1e1847021666" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }(2{x}^{4}-4{x}^{3})\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186100806 :knowledge-point/questions ["question-510f41a7-5712-55db-b50d-5c80967bb9fb" "question-c9b934c2-8c57-56f1-8a65-42f138da7b11"] :db/ensure [:knowledge-point/validate]} {:db/id "question-510f41a7-5712-55db-b50d-5c80967bb9fb" :question/id #uuid "510f41a7-5712-55db-b50d-5c80967bb9fb" :question/math-academy-id "q-12889" :question/problem "Given that\n\n$$\n{(\\frac{{x}^{2}}{2}+4)}^{4}=A{x}^{8}+B{x}^{6}+C{x}^{4}+128{x}^{2}+256\n$$\n\nwhere $A,B$ and $C$ are constants, find the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=\\frac{{x}^{2}}{2},$ and $b=4.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(\\frac{{x}^{2}}{2}+4)}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1{(\\frac{{x}^{2}}{2})}^{4}(4)^{0}+4{(\\frac{{x}^{2}}{2})}^{3}{(4)}^{1}+6{(\\frac{{x}^{2}}{2})}^{2}{(4)}^{2} \\\\  & \\,+4{(\\frac{{x}^{2}}{2})}^{1}{(4)}^{3}+1{(\\frac{{x}^{2}}{2})}^{0}{(4)}^{4} \\\\  & =1(\\frac{{x}^{8}}{16})(1)+4(\\frac{{x}^{6}}{8})(4)+6(\\frac{{x}^{4}}{4})(16) \\\\  & \\,+4(\\frac{{x}^{2}}{2})(64)+1(1)(256) \\\\  & =\\frac{{x}^{8}}{16}+\\frac{16{x}^{6}}{8}+\\frac{96{x}^{4}}{4}+\\frac{256{x}^{2}}{2}+256 \\\\  & =\\frac{{x}^{8}}{16}+2{x}^{6}+24{x}^{4}+128{x}^{2}+256.\\end{aligned}\n$$\n\nTherefore, we have $A=\\frac{1}{16},B=2$ and $C=24.$ So, finally\n\n$$\nA+B+C=\\frac{1}{16}+2+24=\\frac{417}{16}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-69965209-526e-5658-899a-44e6dd8b07be"] :db/ensure [:question/validate]} {:db/id "answer-field-69965209-526e-5658-899a-44e6dd8b07be" :answer-field/id #uuid "69965209-526e-5658-899a-44e6dd8b07be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer-field/choices ["answer-13ad4530-88a4-53d4-8e25-b235bdfe115f" "answer-0e77a6f5-b85a-52a5-a006-9b7d292f2cc8" "answer-92e2c5b9-18da-53a6-8dd8-6cb2c77bfba7" "answer-16ac0b96-91a3-5dfc-b5ef-29cbc766835a" "answer-80d7caca-10f2-5451-a96d-795017485bf5"] :db/ensure [:answer-field/validate]} {:db/id "answer-13ad4530-88a4-53d4-8e25-b235bdfe115f" :answer/id #uuid "13ad4530-88a4-53d4-8e25-b235bdfe115f" :answer/type :answer.type/math :answer/value "\\frac{209}{8}" :db/ensure [:answer/validate]} {:db/id "answer-0e77a6f5-b85a-52a5-a006-9b7d292f2cc8" :answer/id #uuid "0e77a6f5-b85a-52a5-a006-9b7d292f2cc8" :answer/type :answer.type/math :answer/value "\\frac{401}{16}" :db/ensure [:answer/validate]} {:db/id "answer-92e2c5b9-18da-53a6-8dd8-6cb2c77bfba7" :answer/id #uuid "92e2c5b9-18da-53a6-8dd8-6cb2c77bfba7" :answer/type :answer.type/math :answer/value "\\frac{401}{8}" :db/ensure [:answer/validate]} {:db/id "answer-16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer/id #uuid "16ac0b96-91a3-5dfc-b5ef-29cbc766835a" :answer/type :answer.type/math :answer/value "\\frac{417}{16}" :db/ensure [:answer/validate]} {:db/id "answer-80d7caca-10f2-5451-a96d-795017485bf5" :answer/id #uuid "80d7caca-10f2-5451-a96d-795017485bf5" :answer/type :answer.type/math :answer/value "\\frac{449}{16}" :db/ensure [:answer/validate]} {:db/id "question-c9b934c2-8c57-56f1-8a65-42f138da7b11" :question/id #uuid "c9b934c2-8c57-56f1-8a65-42f138da7b11" :question/math-academy-id "q-12891" :question/problem "Find, in descending powers of $z,$ the first three terms of the binomial expansion of ${(1-{z}^{2})}^{4}.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=1,$ and $b=-{z}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}{(1-{z}^{2})}^{4} & =1{a}^{4}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{b}^{4} \\\\  & =1(1)^{4}(-{z}^{2})^{0}+4(1)^{3}(-{z}^{2})^{1}+6(1)^{2}(-{z}^{2})^{2}+4(1)^{1}(-{z}^{2})^{3}+1(1)^{0}(-{z}^{2})^{4} \\\\  & =1(1)(1)+4(1)(-{z}^{2})+6(1)({z}^{4})+4(1)(-{z}^{6})+1(1)({z}^{8}) \\\\  & =1-4{z}^{2}+6{z}^{4}-4{z}^{6}+{z}^{8}.\\end{aligned}\n$$\n\nWe rewrite the binomial expansion in descending powers of $z$ as follows:\n\n$$\n(1-{z}^{2})^{4}={z}^{8}-4{z}^{6}+6{z}^{4}-4{z}^{2}+1\n$$\n\nFinally, in descending powers of $z,$ the first three terms of the binomial expansion are\n\n$$\n{z}^{8}-4{z}^{6}+6{z}^{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a9807bbb-6450-5bec-9d6e-2cb5e0bc2c61"] :db/ensure [:question/validate]} {:db/id "answer-field-a9807bbb-6450-5bec-9d6e-2cb5e0bc2c61" :answer-field/id #uuid "a9807bbb-6450-5bec-9d6e-2cb5e0bc2c61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7869ea61-e97c-524e-a14d-1788d8383e87" :answer-field/choices ["answer-fd90e06c-4204-5316-a4d6-0173539fd070" "answer-863fbced-ba48-51fa-ac1c-071cd8741980" "answer-bbf1cdb0-233a-556a-92fd-fadf68dcfca7" "answer-a2e736b8-e40c-51d3-9a0e-4ad64eae66bd" "answer-7869ea61-e97c-524e-a14d-1788d8383e87"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd90e06c-4204-5316-a4d6-0173539fd070" :answer/id #uuid "fd90e06c-4204-5316-a4d6-0173539fd070" :answer/type :answer.type/math :answer/value "{z}^{8}+2{z}^{6}-4{z}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-863fbced-ba48-51fa-ac1c-071cd8741980" :answer/id #uuid "863fbced-ba48-51fa-ac1c-071cd8741980" :answer/type :answer.type/math :answer/value "{z}^{8}+2{z}^{6}-6{z}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-bbf1cdb0-233a-556a-92fd-fadf68dcfca7" :answer/id #uuid "bbf1cdb0-233a-556a-92fd-fadf68dcfca7" :answer/type :answer.type/math :answer/value "{z}^{8}-4{z}^{6}+12{z}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-a2e736b8-e40c-51d3-9a0e-4ad64eae66bd" :answer/id #uuid "a2e736b8-e40c-51d3-9a0e-4ad64eae66bd" :answer/type :answer.type/math :answer/value "{z}^{8}-4{z}^{6}+18{z}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-7869ea61-e97c-524e-a14d-1788d8383e87" :answer/id #uuid "7869ea61-e97c-524e-a14d-1788d8383e87" :answer/type :answer.type/math :answer/value "{z}^{8}-4{z}^{6}+6{z}^{4}" :db/ensure [:answer/validate]} {:db/id 17592186100807 :knowledge-point/questions ["question-700411f4-106e-5592-a547-8738d64ef693"] :db/ensure [:knowledge-point/validate]} {:db/id "question-700411f4-106e-5592-a547-8738d64ef693" :question/id #uuid "700411f4-106e-5592-a547-8738d64ef693" :question/math-academy-id "q-110676" :question/problem "Given that \n\n$$\n{(2s-{u}^{2})}^{4}=16{s}^{4}+A{s}^{3}{u}^{2}+B{s}^{2}{u}^{4}+Cs{u}^{6}+{u}^{8}\n$$\n\nwhere $A,B$ and $C$ are constants, determine the value of $A+B+C.$" :question/worked-solution "First, let's compare our expression with the binomial\n\n$$\n(a+b)^{n}.\n$$\n\nHere we have that $n=4,$ $a=2s,$ and $b=-{u}^{2}.$ So, the exponents of the binomial expansion must follow the pattern\n\n$$\n{a}^{4}{b}^{0},\\,{a}^{3}{b}^{1},\\,{a}^{2}{b}^{2},\\,{a}^{1}{b}^{3},\\,{a}^{0}{b}^{4}.\n$$\n\nThe $4$th row in Pascal's Triangle is $(1,4,6,4,1).$ Therefore,\n\n$$\n\\begin{aligned}(2s-{u}^{2})^{4} & =1{a}^{4}{b}^{0}+4{a}^{3}b+6{a}^{2}{b}^{2}+4a{b}^{3}+1{a}^{0}{b}^{4} \\\\  & =1(2s)^{4}{(-{u}^{2})}^{0}+4(2s)^{3}{(-{u}^{2})}^{1}+6(2s)^{2}{(-{u}^{2})}^{2} \\\\  & \\,+4(2s)^{1}{(-{u}^{2})}^{3}+1(2s)^{0}{(-{u}^{2})}^{4} \\\\  & =1(16{s}^{4})(1)+4(8{s}^{3})(-{u}^{2})+6(4{s}^{2})({u}^{4}) \\\\  & \\,+4(2s)(-{u}^{6})+1(1)({u}^{8}) \\\\  & =16{s}^{4}-32{s}^{3}{u}^{2}+24{s}^{2}{u}^{4}-8s{u}^{6}+{u}^{8}.\\end{aligned}\n$$\n\nTherefore, $A=-32,B=24,$ and $C=-8.$ Finally, then\n\n$$\nA+B+C=-32+24-8=-16.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fe5bbd0a-c356-5392-bd90-c3fba4a83d1d"] :db/ensure [:question/validate]} {:db/id "answer-field-fe5bbd0a-c356-5392-bd90-c3fba4a83d1d" :answer-field/id #uuid "fe5bbd0a-c356-5392-bd90-c3fba4a83d1d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47d804d7-6d7b-51dc-82a8-e898d3670e24" :answer-field/choices ["answer-47d804d7-6d7b-51dc-82a8-e898d3670e24" "answer-43b9c880-5fa3-575f-adb6-b7776ccb3b8f" "answer-209aed4f-131b-523e-a4e8-1446b6171323" "answer-ad8e8633-e525-5531-b1dd-16c1c9c6e25e" "answer-3bcbebd1-5d2a-5581-b48c-489d2c32892b"] :db/ensure [:answer-field/validate]} {:db/id "answer-47d804d7-6d7b-51dc-82a8-e898d3670e24" :answer/id #uuid "47d804d7-6d7b-51dc-82a8-e898d3670e24" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-43b9c880-5fa3-575f-adb6-b7776ccb3b8f" :answer/id #uuid "43b9c880-5fa3-575f-adb6-b7776ccb3b8f" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-209aed4f-131b-523e-a4e8-1446b6171323" :answer/id #uuid "209aed4f-131b-523e-a4e8-1446b6171323" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-ad8e8633-e525-5531-b1dd-16c1c9c6e25e" :answer/id #uuid "ad8e8633-e525-5531-b1dd-16c1c9c6e25e" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-3bcbebd1-5d2a-5581-b48c-489d2c32892b" :answer/id #uuid "3bcbebd1-5d2a-5581-b48c-489d2c32892b" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "activity-03b3f378-60b1-52ee-9696-118ad875a350" :activity/id #uuid "03b3f378-60b1-52ee-9696-118ad875a350" :activity/title "Expanding Binomials Using Pascal's Triangle" :activity/type :activity.type/review :activity/scope 17592186048677 :activity/course 17592186046647 :activity/steps ["step-a849bf07-e1b9-58de-b318-85fa4f3d86aa" "step-de2d3f8a-b796-5c4a-80a9-88cbe5bf41a1" "step-e88238c8-1541-5000-9ad9-0ced66e4e120"] :activity/first-step "step-a849bf07-e1b9-58de-b318-85fa4f3d86aa" :db/ensure [:activity/validate]} {:db/id "step-a849bf07-e1b9-58de-b318-85fa4f3d86aa" :step/id #uuid "a849bf07-e1b9-58de-b318-85fa4f3d86aa" :step/content "question-510f41a7-5712-55db-b50d-5c80967bb9fb" :step/next "step-de2d3f8a-b796-5c4a-80a9-88cbe5bf41a1" :db/ensure [:step/validate]} {:db/id "step-de2d3f8a-b796-5c4a-80a9-88cbe5bf41a1" :step/id #uuid "de2d3f8a-b796-5c4a-80a9-88cbe5bf41a1" :step/content "question-c9b934c2-8c57-56f1-8a65-42f138da7b11" :step/next "step-e88238c8-1541-5000-9ad9-0ced66e4e120" :db/ensure [:step/validate]} {:db/id "step-e88238c8-1541-5000-9ad9-0ced66e4e120" :step/id #uuid "e88238c8-1541-5000-9ad9-0ced66e4e120" :step/content "question-700411f4-106e-5592-a547-8738d64ef693" :db/ensure [:step/validate]} [:db/retract 17592186094735 :answer-field/choices 17592186094736] [:db/retract 17592186094735 :answer-field/choices 17592186094737] [:db/retract 17592186094735 :answer-field/choices 17592186094738] [:db/retract 17592186094735 :answer-field/choices 17592186094739] [:db/retract 17592186094735 :answer-field/choices 17592186094740] {:db/id 17592186096680 :knowledge-point/questions ["question-1627a960-4b89-5682-9e7a-8ebccade355e" "question-e3b2de25-1eea-5c88-bd03-1de1fe67ccfb" "question-8eec90d6-f38c-50f0-b171-7f37a87f27a1" "question-9ecd3f37-138d-5c59-a588-9da4d5939fe0" "question-98841fb8-b49b-5f0b-816e-9b78835d046c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096479 :question/problem "Evaluate $\\displaystyle \\int (x^4-3x) \\cos(x) \\textrm{d}x.$" :question/worked-solution "For this integral we choose $u = x^4-3x$ and $\\dfrac{\\textrm{d}v}{\\textrm{d}x} = \\cos(x).$ Filling in the table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $\\color[rgb]{1,0,0} x^4-3x$ | $\\cos(x)$ |  |  |\n| $\\color[rgb]{0.77,0.45,0.06} 4x^3-3$ | $\\color[rgb]{1,0,0} \\sin(x)$ | $\\color[rgb]{1,0,0} +$ | $\\color[rgb]{1,0,0} (x^4-3x)\\sin(x)$ |\n| $\\color[rgb]{0,0,1} 12x^2$ | $\\color[rgb]{0.77,0.45,0.06}   -\\cos(x)$ | $\\color[rgb]{0.77,0.45,0.06} -$ | $\\color[rgb]{0.77,0.45,0.06}  -(4x^3-3)(-\\cos(x))$ |\n| $\\color[rgb]{1,0,1} 24x$ | $\\color[rgb]{0,0,1}  -\\sin(x)$ | $\\color[rgb]{0,0,1} +$ | $\\color[rgb]{0,0,1} 12x^2(-\\sin(x))$ |\n| $\\color[rgb]{0,0.5,1} 24$ | $\\color[rgb]{1,0,1} \\cos(x)$ | $\\color[rgb]{1,0,1} -$ | $\\color[rgb]{1,0,1}- 24x\\cos(x)$ |\n| $0$ | $\\color[rgb]{0,0.5,1}  \\sin(x)$ | $\\color[rgb]{0,0.5,1}+$ | $\\color[rgb]{0,0.5,1}  24\\sin(x)$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int ({x}^{4}-3x)\\operatorname{cos}⁡(x)\\text{d}x & =({x}^{4}-3x)\\operatorname{sin}⁡(x)+(4{x}^{3}-3)\\operatorname{cos}⁡(x) \\\\  & \\,\\,-12{x}^{2}\\operatorname{sin}⁡(x)-24x\\operatorname{cos}⁡(x)+24\\operatorname{sin}⁡(x)+C \\\\  & =({x}^{4}-12{x}^{2}-3x+24)\\operatorname{sin}⁡(x) \\\\  & \\,\\,+(4{x}^{3}-24x-3)\\operatorname{cos}⁡(x)+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186096681 :knowledge-point/questions ["question-1051456d-d936-5dd0-8e18-6d4a40dca9fc" "question-d35b604c-10fb-5e20-9163-ae0fba981c99" "question-09b2a1cb-b590-5e4c-af65-76fb35a22b46" "question-c451ec1c-6a2b-54c4-80d7-187b41f5f298"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096482 :question/problem "Evaluate $\\displaystyle \\int (x^2-1)(x+2)^5 \\textrm{d}x.$" :question/worked-solution "For this integral, we choose $u = x^2-1$ and $\\dfrac{\\textrm{d}v}{\\textrm{d}x} =(x+2)^5.$ Filling in our table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $\\color[rgb]{1,0,0} x^2-1$ | $(x+2)^5$ |  |  |\n| $\\color[rgb]{0.77,0.45,0.06} 2x$ | $\\color[rgb]{1,0,0}\\dfrac{(x+2)^6}{6}$ | $\\color[rgb]{1,0,0} +$ | $\\color[rgb]{1,0,0}\\dfrac{(x^2-1)(x+2)^6}{6}$ |\n| $\\color[rgb]{0,0,1} 2$ | $\\color[rgb]{0.77,0.45,0.06} \\dfrac{(x+2)^7}{42}$ | $\\color[rgb]{0.77,0.45,0.06} -$ | $\\color[rgb]{0.77,0.45,0.06} -\\,\\dfrac{x(x+2)^7}{21}$ |\n| $0$ | $\\color[rgb]{0,0,1}\\dfrac{(x+2)^8}{336}$ | $\\color[rgb]{0,0,1} +$ | $\\color[rgb]{0,0,1}  \\dfrac{(x+2)^8}{168}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int ({x}^{2}-1)(x+2)^{5}\\text{d}x & =\\frac{({x}^{2}-1)(x+2)^{6}}{6}-\\frac{x(x+2)^{7}}{21}+\\frac{(x+2)^{8}}{168}+C \\\\  & =\\frac{(x+2)^{6}}{168}(28({x}^{2}-1)-8x(x+2)+(x+2)^{2})+C \\\\  & =\\frac{(x+2)^{6}}{168}(21{x}^{2}-12x-24)+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-1627a960-4b89-5682-9e7a-8ebccade355e" :question/id #uuid "1627a960-4b89-5682-9e7a-8ebccade355e" :question/math-academy-id "q-51229" :question/problem "Evaluate $\\int ({x}^{3}+x)\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "For this integral we choose $u={x}^{3}+x$ and $\\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x).$ Filling in the table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| ${x}^{3}+x$ | $\\operatorname{cos}⁡(2x)$ |  |  |\n| $3{x}^{2}+1$ | $\\frac{\\operatorname{sin}⁡(2x)}{2}$ | $+$ | $({x}^{3}+x)\\frac{\\operatorname{sin}⁡(2x)}{2}$ |\n| $6x$ | $-\\frac{\\operatorname{cos}⁡(2x)}{4}$ | $-$ | $(3{x}^{2}+1)\\frac{\\operatorname{cos}⁡(2x)}{4}$ |\n| $6$ | $-\\frac{\\operatorname{sin}⁡(2x)}{8}$ | $+$ | $-\\frac{3x\\operatorname{sin}⁡(2x)}{4}$ |\n| $0$ | $\\frac{\\operatorname{cos}⁡(2x)}{16}$ | $-$ | $-\\frac{3\\operatorname{cos}⁡(2x)}{8}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int ({x}^{3}+x)\\operatorname{cos}⁡(2x)\\,\\text{d}x & =({x}^{3}+x)\\frac{\\operatorname{sin}⁡(2x)}{2}+(3{x}^{2}+1)\\frac{\\operatorname{cos}⁡(2x)}{4}-\\frac{3x\\operatorname{sin}⁡(2x)}{4}-\\frac{3\\operatorname{cos}⁡(2x)}{8}+C \\\\  & =(2{x}^{3}-x)\\frac{\\operatorname{sin}⁡(2x)}{4}+(6{x}^{2}-1)\\frac{\\operatorname{cos}⁡(2x)}{8}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5647034f-2aaf-5579-99cc-ba72d358adba"] :db/ensure [:question/validate]} {:db/id "answer-field-5647034f-2aaf-5579-99cc-ba72d358adba" :answer-field/id #uuid "5647034f-2aaf-5579-99cc-ba72d358adba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dfadc85c-1a86-5b47-bbad-10d6a3d54487" :answer-field/choices ["answer-dfadc85c-1a86-5b47-bbad-10d6a3d54487" "answer-83cad23b-d2d2-5f7a-8af5-d4529b74ddaa" "answer-966a42f3-8914-57ac-ad7f-d4838065bee4" "answer-fa42dddb-d508-5d72-99c7-43e829f72eb8" "answer-005d8792-e152-5779-a4e7-ff8164391a13"] :db/ensure [:answer-field/validate]} {:db/id "answer-dfadc85c-1a86-5b47-bbad-10d6a3d54487" :answer/id #uuid "dfadc85c-1a86-5b47-bbad-10d6a3d54487" :answer/type :answer.type/math :answer/value "(2{x}^{3}-x)\\frac{\\operatorname{sin}⁡(2x)}{4}+(6{x}^{2}-1)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-83cad23b-d2d2-5f7a-8af5-d4529b74ddaa" :answer/id #uuid "83cad23b-d2d2-5f7a-8af5-d4529b74ddaa" :answer/type :answer.type/math :answer/value "(2{x}^{3}-x)\\frac{\\operatorname{sin}⁡(2x)}{8}-(6{x}^{2}-1)\\frac{\\operatorname{cos}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-966a42f3-8914-57ac-ad7f-d4838065bee4" :answer/id #uuid "966a42f3-8914-57ac-ad7f-d4838065bee4" :answer/type :answer.type/math :answer/value "(6{x}^{2}-1)\\frac{\\operatorname{sin}⁡(2x)}{4}+(2{x}^{3}-x)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-fa42dddb-d508-5d72-99c7-43e829f72eb8" :answer/id #uuid "fa42dddb-d508-5d72-99c7-43e829f72eb8" :answer/type :answer.type/math :answer/value "-(2{x}^{3}-x)\\frac{\\operatorname{sin}⁡(2x)}{2}-(6{x}^{2}-1)\\frac{\\operatorname{cos}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-005d8792-e152-5779-a4e7-ff8164391a13" :answer/id #uuid "005d8792-e152-5779-a4e7-ff8164391a13" :answer/type :answer.type/math :answer/value "-(6{x}^{2}-1)\\frac{\\operatorname{sin}⁡(2x)}{4}-(2{x}^{3}-x)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "question-e3b2de25-1eea-5c88-bd03-1de1fe67ccfb" :question/id #uuid "e3b2de25-1eea-5c88-bd03-1de1fe67ccfb" :question/math-academy-id "q-14779" :question/problem "Evaluate  $\\int (2{x}^{4}+4)\\operatorname{cos}⁡(3x)\\,\\text{d}x.$" :question/worked-solution "For this integral we choose $u=2{x}^{4}+4$ and $\\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x).$ Filling in the table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $2{x}^{4}+4$ | $\\operatorname{cos}⁡(3x)$ |  |  |\n| $8{x}^{3}$ | $\\frac{\\operatorname{sin}⁡(3x)}{3}$ | $+$ | $\\frac{(2{x}^{4}+4)\\operatorname{sin}⁡(3x)}{3}$ |\n| $24{x}^{2}$ | $-\\frac{\\operatorname{cos}⁡(3x)}{9}$ | $-$ | $\\frac{8{x}^{3}\\operatorname{cos}⁡(3x)}{9}$ |\n| $48x$ | $-\\frac{\\operatorname{sin}⁡(3x)}{27}$ | $+$ | $-\\frac{8{x}^{2}\\operatorname{sin}⁡(3x)}{9}$ |\n| $48$ | $\\frac{\\operatorname{cos}⁡(3x)}{81}$ | $-$ | $-\\frac{16x\\operatorname{cos}⁡(3x)}{27}$ |\n| $0$ | $\\frac{\\operatorname{sin}⁡(3x)}{243}$ | $+$ | $\\frac{16\\operatorname{sin}⁡(3x)}{81}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int (2{x}^{4}+4)\\operatorname{cos}⁡(3x)\\,\\text{d}x & =\\frac{(2{x}^{4}+4)\\operatorname{sin}⁡(3x)}{3}+\\frac{8{x}^{3}\\operatorname{cos}⁡(3x)}{9}-\\frac{8{x}^{2}\\operatorname{sin}⁡(3x)}{9}-\\frac{16x\\operatorname{cos}⁡(3x)}{27}+\\frac{16\\operatorname{sin}⁡(3x)}{81}+C \\\\  & =(54{x}^{4}-72{x}^{2}+124)\\frac{\\operatorname{sin}⁡(3x)}{81}+(24{x}^{3}-16x)\\frac{\\operatorname{cos}⁡(3x)}{27}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94678b2e-f715-53b9-be25-66d1e2519658"] :db/ensure [:question/validate]} {:db/id "answer-field-94678b2e-f715-53b9-be25-66d1e2519658" :answer-field/id #uuid "94678b2e-f715-53b9-be25-66d1e2519658" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-05134a4e-1d46-5e28-bcb2-8f6817ff28b9" :answer-field/choices ["answer-439e49ca-de2e-54e0-8438-a3db1cbd3a97" "answer-05134a4e-1d46-5e28-bcb2-8f6817ff28b9" "answer-e1556d1d-7c0b-58f7-b139-bfdb8d52f9cb" "answer-e68095d8-230d-514b-a348-4ecdb6bd3857" "answer-390e73d9-b00b-5113-9cbc-0e77d9eab6a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-439e49ca-de2e-54e0-8438-a3db1cbd3a97" :answer/id #uuid "439e49ca-de2e-54e0-8438-a3db1cbd3a97" :answer/type :answer.type/math :answer/value "(24{x}^{3}-16x)\\frac{\\operatorname{sin}⁡(3x)}{81}+(54{x}^{4}-72{x}^{2}-108)\\frac{\\operatorname{cos}⁡(3x)}{27}+C" :db/ensure [:answer/validate]} {:db/id "answer-05134a4e-1d46-5e28-bcb2-8f6817ff28b9" :answer/id #uuid "05134a4e-1d46-5e28-bcb2-8f6817ff28b9" :answer/type :answer.type/math :answer/value "(54{x}^{4}-72{x}^{2}+124)\\frac{\\operatorname{sin}⁡(3x)}{81}+(24{x}^{3}-16x)\\frac{\\operatorname{cos}⁡(3x)}{27}+C" :db/ensure [:answer/validate]} {:db/id "answer-e1556d1d-7c0b-58f7-b139-bfdb8d52f9cb" :answer/id #uuid "e1556d1d-7c0b-58f7-b139-bfdb8d52f9cb" :answer/type :answer.type/math :answer/value "(54{x}^{4}-72{x}^{2}-124)\\frac{\\operatorname{sin}⁡(3x)}{81}-(24{x}^{3}+16x)\\frac{\\operatorname{cos}⁡(3x)}{81}+C" :db/ensure [:answer/validate]} {:db/id "answer-e68095d8-230d-514b-a348-4ecdb6bd3857" :answer/id #uuid "e68095d8-230d-514b-a348-4ecdb6bd3857" :answer/type :answer.type/math :answer/value "(54{x}^{4}-72{x}^{2}-4)\\frac{\\operatorname{sin}⁡(3x)}{27}+(24{x}^{3}-16x)\\frac{\\operatorname{cos}⁡(3x)}{27}+C" :db/ensure [:answer/validate]} {:db/id "answer-390e73d9-b00b-5113-9cbc-0e77d9eab6a0" :answer/id #uuid "390e73d9-b00b-5113-9cbc-0e77d9eab6a0" :answer/type :answer.type/math :answer/value "-(54{x}^{4}-72{x}^{2}+124)\\frac{\\operatorname{sin}⁡(3x)}{9}-(24{x}^{3}-16x)\\frac{\\operatorname{cos}⁡(3x)}{27}+C" :db/ensure [:answer/validate]} {:db/id "question-8eec90d6-f38c-50f0-b171-7f37a87f27a1" :question/id #uuid "8eec90d6-f38c-50f0-b171-7f37a87f27a1" :question/math-academy-id "q-14755" :question/problem "Evaluate $\\int (2{x}^{3}+3{x}^{2}+5)\\operatorname{sin}⁡(x)\\,\\text{d}x.$" :question/worked-solution "For this integral, we choose $u=2{x}^{3}+3{x}^{2}+5$ and $\\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(x).$ Filling in the table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same Color Products** |\n| --- | --- | --- | --- |\n| $2{x}^{3}+3{x}^{2}+5$ | $\\operatorname{sin}⁡(x)$ |  |  |\n| $6{x}^{2}+6x$ | $-\\operatorname{cos}⁡(x)$ | $+$ | $-(2{x}^{3}+3{x}^{2}+5)\\operatorname{cos}⁡(x)$ |\n| $12x+6$ | $-\\operatorname{sin}⁡(x)$ | $-$ | $(6{x}^{2}+6x)\\operatorname{sin}⁡(x)$ |\n| $12$ | $\\operatorname{cos}⁡(x)$ | $+$ | $(12x+6)\\operatorname{cos}⁡(x)$ |\n| $0$ | $\\operatorname{sin}⁡(x)$ | $-$ | $-12\\operatorname{sin}⁡(x)$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int (2{x}^{3}+3{x}^{2}+5)\\operatorname{sin}⁡(x)\\,\\text{d}x & =-(2{x}^{3}+3{x}^{2}+5)\\operatorname{cos}⁡(x)+(6{x}^{2}+6x)\\operatorname{sin}⁡(x) \\\\  & \\,\\,\\,+(12x+6)\\operatorname{cos}⁡(x)-12\\operatorname{sin}⁡(x)+C \\\\  & =-(2{x}^{3}+3{x}^{2}-12x-1)\\operatorname{cos}⁡(x) \\\\  & \\,\\,\\,+(6{x}^{2}+6x-12)\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-93ab3dbe-b63d-5c2c-ad07-9ef67d064f5a"] :db/ensure [:question/validate]} {:db/id "answer-field-93ab3dbe-b63d-5c2c-ad07-9ef67d064f5a" :answer-field/id #uuid "93ab3dbe-b63d-5c2c-ad07-9ef67d064f5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f7dc74ed-d99f-5379-bc5f-c05c0291af00" :answer-field/choices ["answer-ae8b2753-6527-5ff7-8bf6-5f58489ba3f4" "answer-361558e0-b03e-5e24-b859-1780cbf73441" "answer-b5d77f24-72e3-5890-b26e-03347b9837a5" "answer-68f021c7-4684-5f75-a7e6-7bf59db64272" "answer-f7dc74ed-d99f-5379-bc5f-c05c0291af00"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae8b2753-6527-5ff7-8bf6-5f58489ba3f4" :answer/id #uuid "ae8b2753-6527-5ff7-8bf6-5f58489ba3f4" :answer/type :answer.type/math :answer/value "(2{x}^{3}+3{x}^{2}+12x+11)\\operatorname{cos}⁡(x)-(6{x}^{2}+6x+12)\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "answer-361558e0-b03e-5e24-b859-1780cbf73441" :answer/id #uuid "361558e0-b03e-5e24-b859-1780cbf73441" :answer/type :answer.type/math :answer/value "(2{x}^{3}+3{x}^{2}+12x+5)\\operatorname{cos}⁡(x)+(6{x}^{2}+6-12)\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "answer-b5d77f24-72e3-5890-b26e-03347b9837a5" :answer/id #uuid "b5d77f24-72e3-5890-b26e-03347b9837a5" :answer/type :answer.type/math :answer/value "-(2{x}^{3}+3{x}^{2}+12x+11)\\operatorname{cos}⁡(x)+(6{x}^{2}+6x-12)\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "answer-68f021c7-4684-5f75-a7e6-7bf59db64272" :answer/id #uuid "68f021c7-4684-5f75-a7e6-7bf59db64272" :answer/type :answer.type/math :answer/value "-(2{x}^{3}+3{x}^{2}+12x+5)\\operatorname{cos}⁡(x)-(6{x}^{2}+6+12)\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "answer-f7dc74ed-d99f-5379-bc5f-c05c0291af00" :answer/id #uuid "f7dc74ed-d99f-5379-bc5f-c05c0291af00" :answer/type :answer.type/math :answer/value "-(2{x}^{3}+3{x}^{2}-12x-1)\\operatorname{cos}⁡(x)+(6{x}^{2}+6x-12)\\operatorname{sin}⁡(x)+C" :db/ensure [:answer/validate]} {:db/id "question-9ecd3f37-138d-5c59-a588-9da4d5939fe0" :question/id #uuid "9ecd3f37-138d-5c59-a588-9da4d5939fe0" :question/math-academy-id "q-13148" :question/problem "$\\int ({x}^{3}+3{x}^{2})\\operatorname{cos}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "For this integral we choose $u={x}^{3}+3{x}^{2}$ and $\\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x).$ Filling in the table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| ${x}^{3}+3{x}^{2}$ | $\\operatorname{cos}⁡(2x)$ |  |  |\n| $3{x}^{2}+6x$ | $\\frac{\\operatorname{sin}⁡(2x)}{2}$ | $+$ | $\\frac{({x}^{3}+3{x}^{2})\\operatorname{sin}⁡(2x)}{2}$ |\n| $6x+6$ | $-\\frac{\\operatorname{cos}⁡(2x)}{4}$ | $-$ | $\\frac{(3{x}^{2}+6x)\\operatorname{cos}⁡(2x)}{4}$ |\n| $6$ | $-\\frac{\\operatorname{sin}⁡(2x)}{8}$ | $+$ | $-\\frac{(3x+3)\\operatorname{sin}⁡(2x)}{4}$ |\n| $0$ | $\\frac{\\operatorname{cos}⁡(2x)}{16}$ | $-$ | $-\\frac{3\\operatorname{cos}⁡(2x)}{8}$ |\n\nWe add up all the terms of the last column to get the answer for our integral.\n\n$$\n\\begin{aligned}\\int ({x}^{3}+3{x}^{2})\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\frac{({x}^{3}+3{x}^{2})\\operatorname{sin}⁡(2x)}{2}+\\frac{(3{x}^{2}+6x)\\operatorname{cos}⁡(2x)}{4}-\\frac{(3x+3)\\operatorname{sin}⁡(2x)}{4}-\\frac{3\\operatorname{cos}⁡(2x)}{8}+C \\\\  & =(2{x}^{3}+6{x}^{2}-3x-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+(6{x}^{2}+12x-3)\\frac{\\operatorname{cos}⁡(2x)}{8}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f9c7956f-34b4-5bbc-822d-999232812733"] :db/ensure [:question/validate]} {:db/id "answer-field-f9c7956f-34b4-5bbc-822d-999232812733" :answer-field/id #uuid "f9c7956f-34b4-5bbc-822d-999232812733" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-884ddcaf-f8cf-537c-baf0-530ad493bfa6" :answer-field/choices ["answer-884ddcaf-f8cf-537c-baf0-530ad493bfa6" "answer-3490e7a3-ef90-5f58-baf3-34df7d8081b4" "answer-9b1532f8-ad6a-57a3-b5ef-b39dbdab9a20" "answer-14773948-f875-5444-af95-b23c3eec6adb" "answer-0fb41b18-d048-58ff-98b7-bb9707adb4b3"] :db/ensure [:answer-field/validate]} {:db/id "answer-884ddcaf-f8cf-537c-baf0-530ad493bfa6" :answer/id #uuid "884ddcaf-f8cf-537c-baf0-530ad493bfa6" :answer/type :answer.type/math :answer/value "(2{x}^{3}+6{x}^{2}-3x-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+(6{x}^{2}+12x-3)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-3490e7a3-ef90-5f58-baf3-34df7d8081b4" :answer/id #uuid "3490e7a3-ef90-5f58-baf3-34df7d8081b4" :answer/type :answer.type/math :answer/value "(3{x}^{3}+2{x}^{2}+3x-3)\\frac{\\operatorname{sin}⁡(2x)}{8}+(3{x}^{2}+12x-3)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-9b1532f8-ad6a-57a3-b5ef-b39dbdab9a20" :answer/id #uuid "9b1532f8-ad6a-57a3-b5ef-b39dbdab9a20" :answer/type :answer.type/math :answer/value "(6{x}^{3}+2{x}^{2}-3x+3)\\frac{\\operatorname{sin}⁡(2x)}{4}-(6{x}^{2}+2x-3)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-14773948-f875-5444-af95-b23c3eec6adb" :answer/id #uuid "14773948-f875-5444-af95-b23c3eec6adb" :answer/type :answer.type/math :answer/value "(6{x}^{3}+{x}^{2}-3x-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+(2{x}^{2}+2x-3)\\frac{\\operatorname{cos}⁡(2x)}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-0fb41b18-d048-58ff-98b7-bb9707adb4b3" :answer/id #uuid "0fb41b18-d048-58ff-98b7-bb9707adb4b3" :answer/type :answer.type/math :answer/value "({x}^{3}+3{x}^{2}-6x-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+(6{x}^{2}+12x-3)\\frac{\\operatorname{cos}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "question-98841fb8-b49b-5f0b-816e-9b78835d046c" :question/id #uuid "98841fb8-b49b-5f0b-816e-9b78835d046c" :question/math-academy-id "q-104069" :question/problem "$\\int 2{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "For this integral we choose $u=2{x}^{3}$ and $\\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x).$ Filling in the table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $2{x}^{3}$ | $\\operatorname{sin}⁡(2x)$ |  |  |\n| $6{x}^{2}$ | $-\\frac{\\operatorname{cos}⁡(2x)}{2}$ | $+$ | $-{x}^{3}\\operatorname{cos}⁡(2x)$ |\n| $12x$ | $-\\frac{\\operatorname{sin}⁡(2x)}{4}$ | $-$ | $\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}$ |\n| $12$ | $\\frac{\\operatorname{cos}⁡(2x)}{8}$ | $+$ | $\\frac{3x\\operatorname{cos}⁡(2x)}{2}$ |\n| $0$ | $\\frac{\\operatorname{sin}⁡(2x)}{16}$ | $-$ | $-\\frac{3\\operatorname{sin}⁡(2x)}{4}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int 2{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =-{x}^{3}\\operatorname{cos}⁡(2x)+\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}+C \\\\  & =(3x-2{x}^{3})\\frac{\\operatorname{cos}⁡(2x)}{2}+(6{x}^{2}-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-76d3aaee-ce69-5796-b3e2-8ab1f761af18"] :db/ensure [:question/validate]} {:db/id "answer-field-76d3aaee-ce69-5796-b3e2-8ab1f761af18" :answer-field/id #uuid "76d3aaee-ce69-5796-b3e2-8ab1f761af18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29b846ea-2b46-5827-9dc6-ab58e3d774a0" :answer-field/choices ["answer-c0e0fbd8-18b1-5bd2-b17a-95a9d13ac705" "answer-7bf18243-7d6d-542d-ad2a-119fd8b14886" "answer-8d1726c2-0aa9-5f31-897a-f88a2c0ffb38" "answer-29b846ea-2b46-5827-9dc6-ab58e3d774a0" "answer-a5d2c5ff-d684-5446-84ee-0690faaf6e16"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0e0fbd8-18b1-5bd2-b17a-95a9d13ac705" :answer/id #uuid "c0e0fbd8-18b1-5bd2-b17a-95a9d13ac705" :answer/type :answer.type/math :answer/value "(2{x}^{3}-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+(6{x}^{2}+3x)\\frac{\\operatorname{cos}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-7bf18243-7d6d-542d-ad2a-119fd8b14886" :answer/id #uuid "7bf18243-7d6d-542d-ad2a-119fd8b14886" :answer/type :answer.type/math :answer/value "(2{x}^{3}-3x)\\frac{\\operatorname{sin}⁡(2x)}{2}+(6{x}^{2}-3)\\frac{\\operatorname{cos}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-8d1726c2-0aa9-5f31-897a-f88a2c0ffb38" :answer/id #uuid "8d1726c2-0aa9-5f31-897a-f88a2c0ffb38" :answer/type :answer.type/math :answer/value "(3-2{x}^{3})\\frac{\\operatorname{cos}⁡(2x)}{4}+(6{x}^{2}+3x)\\frac{\\operatorname{sin}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-29b846ea-2b46-5827-9dc6-ab58e3d774a0" :answer/id #uuid "29b846ea-2b46-5827-9dc6-ab58e3d774a0" :answer/type :answer.type/math :answer/value "(3x-2{x}^{3})\\frac{\\operatorname{cos}⁡(2x)}{2}+(6{x}^{2}-3)\\frac{\\operatorname{sin}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-a5d2c5ff-d684-5446-84ee-0690faaf6e16" :answer/id #uuid "a5d2c5ff-d684-5446-84ee-0690faaf6e16" :answer/type :answer.type/math :answer/value "(6x-2{x}^{3})\\frac{\\operatorname{cos}⁡(2x)}{2}+(3{x}^{2}+3)\\frac{\\operatorname{sin}⁡(2x)}{4}+C" :db/ensure [:answer/validate]} {:db/id "question-1051456d-d936-5dd0-8e18-6d4a40dca9fc" :question/id #uuid "1051456d-d936-5dd0-8e18-6d4a40dca9fc" :question/math-academy-id "q-13146" :question/problem "Evaluate $\\int (2{x}^{3}+3{x}^{2}+5){e}^{2x}\\,\\text{d}x.$" :question/worked-solution "For this integral, we choose $u=2{x}^{3}+3{x}^{2}+5$ and $\\frac{\\text{d}v}{\\text{d}x}={e}^{2x}.$ Filling in our table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $2{x}^{3}+3{x}^{2}+5$ | ${e}^{2x}$ |  |  |\n| $6{x}^{2}+6x$ | $\\frac{{e}^{2x}}{2}$ | $+$ | $\\frac{(2{x}^{3}+3{x}^{2}+5){e}^{2x}}{2}$ |\n| $12x+6$ | $\\frac{{e}^{2x}}{4}$ | $-$ | $-\\frac{(3{x}^{2}+3x){e}^{2x}}{2}$ |\n| $12$ | $\\frac{{e}^{2x}}{8}$ | $+$ | $\\frac{(6x+3){e}^{2x}}{4}$ |\n| $0$ | $\\frac{{e}^{2x}}{16}$ | $-$ | $-\\frac{3{e}^{2x}}{4}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int (2{x}^{3}+3{x}^{2}+5){e}^{2x}\\,\\text{d}x & =\\frac{{e}^{2x}}{4}[2(2{x}^{3}+3{x}^{2}+5)-2(3{x}^{2}+3x)+(6x+3)-3]+C \\\\  & =\\frac{{e}^{2x}}{4}(4{x}^{3}+10)+C \\\\  & =\\frac{{e}^{2x}}{2}(2{x}^{3}+5)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a255b420-3e67-5961-b79f-82039635a315"] :db/ensure [:question/validate]} {:db/id "answer-field-a255b420-3e67-5961-b79f-82039635a315" :answer-field/id #uuid "a255b420-3e67-5961-b79f-82039635a315" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a297628-b2be-5be8-9320-fbed23850259" :answer-field/choices ["answer-4a297628-b2be-5be8-9320-fbed23850259" "answer-37217c9b-33b1-59e4-b8aa-0211d9f120e6" "answer-9f924e65-5270-528b-9b33-05c8467a19f1" "answer-3c9a9114-317c-5b9b-a420-60d067c6ad9a" "answer-a3cb7fc1-c60e-51fb-be11-25aba8dc3e0c"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a297628-b2be-5be8-9320-fbed23850259" :answer/id #uuid "4a297628-b2be-5be8-9320-fbed23850259" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{2}(2{x}^{3}+5)+C" :db/ensure [:answer/validate]} {:db/id "answer-37217c9b-33b1-59e4-b8aa-0211d9f120e6" :answer/id #uuid "37217c9b-33b1-59e4-b8aa-0211d9f120e6" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{2}(2{x}^{3}+6x+5)+C" :db/ensure [:answer/validate]} {:db/id "answer-9f924e65-5270-528b-9b33-05c8467a19f1" :answer/id #uuid "9f924e65-5270-528b-9b33-05c8467a19f1" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{2}(5{x}^{3}+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-3c9a9114-317c-5b9b-a420-60d067c6ad9a" :answer/id #uuid "3c9a9114-317c-5b9b-a420-60d067c6ad9a" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{4}(3{x}^{3}+5x+6)+C" :db/ensure [:answer/validate]} {:db/id "answer-a3cb7fc1-c60e-51fb-be11-25aba8dc3e0c" :answer/id #uuid "a3cb7fc1-c60e-51fb-be11-25aba8dc3e0c" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{4}({x}^{3}+2x+5)+C" :db/ensure [:answer/validate]} {:db/id "question-d35b604c-10fb-5e20-9163-ae0fba981c99" :question/id #uuid "d35b604c-10fb-5e20-9163-ae0fba981c99" :question/math-academy-id "q-14773" :question/problem "$\\int 2{x}^{4}{e}^{4x}\\,\\text{d}x=$" :question/worked-solution "For this integral, we choose $u=2{x}^{4}$ and $\\frac{\\text{d}v}{\\text{d}x}={e}^{4x}.$ Filling in our table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $2{x}^{4}$ | ${e}^{4x}$ |  |  |\n| $8{x}^{3}$ | $\\frac{{e}^{4x}}{4}$ | $+$ | $\\frac{{x}^{4}{e}^{4x}}{2}$ |\n| $24{x}^{2}$ | $\\frac{{e}^{4x}}{16}$ | $-$ | $-\\frac{{x}^{3}{e}^{4x}}{2}$ |\n| $48x$ | $\\frac{{e}^{4x}}{64}$ | $+$ | $\\frac{3{x}^{2}{e}^{4x}}{8}$ |\n| $48$ | $\\frac{{e}^{4x}}{256}$ | $-$ | $-\\frac{3x{e}^{4x}}{16}$ |\n| $0$ | $\\frac{{e}^{4x}}{1024}$ | $+$ | $\\frac{3{e}^{4x}}{64}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\int 2{x}^{4}{e}^{4x}\\,\\text{d}x=\\frac{{e}^{4x}}{64}(32{x}^{4}-32{x}^{3}+24{x}^{2}-12x+3)+C\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-505aa8f0-52fb-5012-93ff-9c404d373469"] :db/ensure [:question/validate]} {:db/id "answer-field-505aa8f0-52fb-5012-93ff-9c404d373469" :answer-field/id #uuid "505aa8f0-52fb-5012-93ff-9c404d373469" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce6586a5-0ad1-53d1-b303-ca7e81cc40e4" :answer-field/choices ["answer-08b769a9-d021-5cbd-b502-3820d8cbbf8a" "answer-076b789d-51b5-5ef9-a0dd-ba86934844f3" "answer-ce6586a5-0ad1-53d1-b303-ca7e81cc40e4" "answer-36069d7a-e480-58f6-be3e-69f4a2e0c58c" "answer-699fea69-ada0-5282-b189-fe6c0c7e43e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-08b769a9-d021-5cbd-b502-3820d8cbbf8a" :answer/id #uuid "08b769a9-d021-5cbd-b502-3820d8cbbf8a" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4x}}{64}(32{x}^{4}+32{x}^{3}+24{x}^{2}+12x+3)+C" :db/ensure [:answer/validate]} {:db/id "answer-076b789d-51b5-5ef9-a0dd-ba86934844f3" :answer/id #uuid "076b789d-51b5-5ef9-a0dd-ba86934844f3" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4x}}{64}(32{x}^{4}+32{x}^{3}+24{x}^{2}-12x+3)+C" :db/ensure [:answer/validate]} {:db/id "answer-ce6586a5-0ad1-53d1-b303-ca7e81cc40e4" :answer/id #uuid "ce6586a5-0ad1-53d1-b303-ca7e81cc40e4" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4x}}{64}(32{x}^{4}-32{x}^{3}+24{x}^{2}-12x+3)+C" :db/ensure [:answer/validate]} {:db/id "answer-36069d7a-e480-58f6-be3e-69f4a2e0c58c" :answer/id #uuid "36069d7a-e480-58f6-be3e-69f4a2e0c58c" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4x}}{64}(32{x}^{4}-32{x}^{3}-24{x}^{2}-12x+3)+C" :db/ensure [:answer/validate]} {:db/id "answer-699fea69-ada0-5282-b189-fe6c0c7e43e6" :answer/id #uuid "699fea69-ada0-5282-b189-fe6c0c7e43e6" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4x}}{8}(32{x}^{4}+32{x}^{3}+24{x}^{2}-12x+3)+C" :db/ensure [:answer/validate]} {:db/id 17592186097127 :question/problem "Evaluate  $\\int (4{x}^{4}+2){e}^{x}\\,\\text{d}x.$" :question/worked-solution "For this integral, we choose $u=4{x}^{4}+2$ and $\\frac{\\text{d}v}{\\text{d}x}={e}^{x}.$ Filling in our table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $4{x}^{4}+2$ | ${e}^{x}$ |  |  |\n| $16{x}^{3}$ | ${e}^{x}$ | $+$ | $(4{x}^{4}+2){e}^{x}$ |\n| $48{x}^{2}$ | ${e}^{x}$ | $-$ | $-16{x}^{3}{e}^{x}$ |\n| $96x$ | ${e}^{x}$ | $+$ | $48{x}^{2}{e}^{x}$ |\n| $96$ | ${e}^{x}$ | $-$ | $-96x{e}^{x}$ |\n| $0$ | ${e}^{x}$ | $+$ | $96{e}^{x}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int (4{x}^{4}+2){e}^{x}\\,\\text{d}x & ={e}^{x}(4{x}^{4}-16{x}^{3}+48{x}^{2}-96x+98)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186094735 :answer-field/correct "answer-e58ebe67-39f1-5846-88c9-622447a7af20" :answer-field/choices ["answer-88ff090e-80df-57fe-8d25-0fb774b1e7c0" "answer-68f9d3d4-6045-5de5-b395-cca423699609" "answer-1373c2fd-f8d9-5a55-b2e7-b4367c914f89" "answer-0b88c051-a025-5f03-81cf-5494a62f33da" "answer-e58ebe67-39f1-5846-88c9-622447a7af20"] :db/ensure [:answer-field/validate]} {:db/id "answer-88ff090e-80df-57fe-8d25-0fb774b1e7c0" :answer/id #uuid "88ff090e-80df-57fe-8d25-0fb774b1e7c0" :answer/type :answer.type/math :answer/value "{e}^{2x}(3{x}^{4}-12{x}^{3}+48{x}^{2}-96x+98)+C" :db/ensure [:answer/validate]} {:db/id "answer-68f9d3d4-6045-5de5-b395-cca423699609" :answer/id #uuid "68f9d3d4-6045-5de5-b395-cca423699609" :answer/type :answer.type/math :answer/value "{e}^{x}(3{x}^{4}-12{x}^{3}+48{x}^{2}-96x-98)+C" :db/ensure [:answer/validate]} {:db/id "answer-1373c2fd-f8d9-5a55-b2e7-b4367c914f89" :answer/id #uuid "1373c2fd-f8d9-5a55-b2e7-b4367c914f89" :answer/type :answer.type/math :answer/value "{e}^{x}(3{x}^{4}-12{x}^{3}-48{x}^{2}-96x+98)+C" :db/ensure [:answer/validate]} {:db/id "answer-0b88c051-a025-5f03-81cf-5494a62f33da" :answer/id #uuid "0b88c051-a025-5f03-81cf-5494a62f33da" :answer/type :answer.type/math :answer/value "{e}^{x}(4{x}^{4}+16{x}^{3}+48{x}^{2}-96x+98)+C" :db/ensure [:answer/validate]} {:db/id "answer-e58ebe67-39f1-5846-88c9-622447a7af20" :answer/id #uuid "e58ebe67-39f1-5846-88c9-622447a7af20" :answer/type :answer.type/math :answer/value "{e}^{x}(4{x}^{4}-16{x}^{3}+48{x}^{2}-96x+98)+C" :db/ensure [:answer/validate]} {:db/id "question-09b2a1cb-b590-5e4c-af65-76fb35a22b46" :question/id #uuid "09b2a1cb-b590-5e4c-af65-76fb35a22b46" :question/math-academy-id "q-14778" :question/problem "$\\int (4{x}^{4}+4){e}^{2x}\\,\\text{d}x=$" :question/worked-solution "For this integral, we choose $u=4{x}^{4}+4$ and $\\frac{\\text{d}v}{\\text{d}x}={e}^{2x}.$ Filling in our table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $4{x}^{4}+4$ | ${e}^{2x}$ |  |  |\n| $16{x}^{3}$ | $\\frac{{e}^{2x}}{2}$ | $+$ | $(2{x}^{4}+2){e}^{2x}$ |\n| $48{x}^{2}$ | $\\frac{{e}^{2x}}{4}$ | $-$ | $-4{x}^{3}{e}^{2x}$ |\n| $96x$ | $\\frac{{e}^{2x}}{8}$ | $+$ | $6{x}^{2}{e}^{2x}$ |\n| $96$ | $\\frac{{e}^{2x}}{16}$ | $-$ | $-6x{e}^{2x}$ |\n| $0$ | $\\frac{{e}^{2x}}{32}$ | $+$ | $3{e}^{2x}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int (4{x}^{4}+4){e}^{2x}\\,\\text{d}x & ={e}^{2x}(2{x}^{4}-4{x}^{3}+6{x}^{2}-6x+5)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cb590fe5-81e6-56d3-a58f-ef57c7889ade"] :db/ensure [:question/validate]} {:db/id "answer-field-cb590fe5-81e6-56d3-a58f-ef57c7889ade" :answer-field/id #uuid "cb590fe5-81e6-56d3-a58f-ef57c7889ade" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f14705c-d59b-5e2c-861c-36f4631d9fef" :answer-field/choices ["answer-42ed1c85-2087-5131-92d7-96af891136fc" "answer-a29d9de4-509e-52f0-ac23-c5a30d5ee00e" "answer-75d02ccf-1668-5386-b753-447c7b62662e" "answer-1f14705c-d59b-5e2c-861c-36f4631d9fef" "answer-3e44753e-7b3a-546a-9430-d898f8a54dff"] :db/ensure [:answer-field/validate]} {:db/id "answer-42ed1c85-2087-5131-92d7-96af891136fc" :answer/id #uuid "42ed1c85-2087-5131-92d7-96af891136fc" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{2}(4{x}^{4}-6{x}^{3}+6{x}^{2}-6x+5)+C" :db/ensure [:answer/validate]} {:db/id "answer-a29d9de4-509e-52f0-ac23-c5a30d5ee00e" :answer/id #uuid "a29d9de4-509e-52f0-ac23-c5a30d5ee00e" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{4}(2{x}^{4}-4{x}^{3}-3{x}^{2}+6x+5)+C" :db/ensure [:answer/validate]} {:db/id "answer-75d02ccf-1668-5386-b753-447c7b62662e" :answer/id #uuid "75d02ccf-1668-5386-b753-447c7b62662e" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{4}({x}^{4}+2{x}^{3}+6{x}^{2}-6x-5)+C" :db/ensure [:answer/validate]} {:db/id "answer-1f14705c-d59b-5e2c-861c-36f4631d9fef" :answer/id #uuid "1f14705c-d59b-5e2c-861c-36f4631d9fef" :answer/type :answer.type/math :answer/value "{e}^{2x}(2{x}^{4}-4{x}^{3}+6{x}^{2}-6x+5)+C" :db/ensure [:answer/validate]} {:db/id "answer-3e44753e-7b3a-546a-9430-d898f8a54dff" :answer/id #uuid "3e44753e-7b3a-546a-9430-d898f8a54dff" :answer/type :answer.type/math :answer/value "{e}^{2x}(4{x}^{4}+2{x}^{3}-6{x}^{2}-6x-5)+C" :db/ensure [:answer/validate]} {:db/id "question-c451ec1c-6a2b-54c4-80d7-187b41f5f298" :question/id #uuid "c451ec1c-6a2b-54c4-80d7-187b41f5f298" :question/math-academy-id "q-13147" :question/problem "Evaluate $\\int (2{x}^{4}+4x){e}^{3x}\\text{d}x.$" :question/worked-solution "For this integral, we choose $u=2{x}^{4}+4x$ and $\\frac{\\text{d}v}{\\text{d}x}={e}^{3x}.$ Filling in our table gives the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same-color Products** |\n| --- | --- | --- | --- |\n| $2{x}^{4}+4x$ | ${e}^{3x}$ |  |  |\n| $8{x}^{3}+4$ | $\\frac{{e}^{3x}}{3}$ | $+$ | $\\frac{(2{x}^{4}+4x){e}^{3x}}{3}$ |\n| $24{x}^{2}$ | $\\frac{{e}^{3x}}{9}$ | $-$ | $-\\frac{(8{x}^{3}+4){e}^{3x}}{9}$ |\n| $48x$ | $\\frac{{e}^{3x}}{27}$ | $+$ | $\\frac{8{x}^{2}{e}^{3x}}{9}$ |\n| $48$ | $\\frac{{e}^{3x}}{81}$ | $-$ | $-\\frac{16x{e}^{3x}}{27}$ |\n| $0$ | $\\frac{{e}^{3x}}{243}$ | $+$ | $\\frac{16{e}^{3x}}{81}$ |\n\nWe add up all the terms of the last column to get the answer for our integral. \n\n$$\n\\begin{aligned}\\int (2{x}^{4}+4x){e}^{3x}\\,\\text{d}x & =\\frac{{e}^{3x}}{81}(27(2{x}^{4}+4x)-9(8{x}^{3}+4)+9(8{x}^{2})-3(16x)+16)+C \\\\  & =\\frac{{e}^{3x}}{81}(54{x}^{4}-72{x}^{3}+72{x}^{2}+60x-20)+C \\\\  & =\\frac{2{e}^{3x}}{81}(27{x}^{4}-36{x}^{3}+36{x}^{2}+30x-10)+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bb054bd7-c812-50e0-88f0-5e700282b833"] :db/ensure [:question/validate]} {:db/id "answer-field-bb054bd7-c812-50e0-88f0-5e700282b833" :answer-field/id #uuid "bb054bd7-c812-50e0-88f0-5e700282b833" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6da2e75c-0701-5b79-a64c-adc247058072" :answer-field/choices ["answer-3b221da8-82dd-5c78-adf8-f6dfced47edc" "answer-6da2e75c-0701-5b79-a64c-adc247058072" "answer-5ef12b2d-3da6-5428-8177-102eeef66d2b" "answer-fd8ab7a4-bb1c-5998-ba3f-50e0b6ba5816" "answer-2c546568-626b-5cd6-b8ac-d2575386f3be"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b221da8-82dd-5c78-adf8-f6dfced47edc" :answer/id #uuid "3b221da8-82dd-5c78-adf8-f6dfced47edc" :answer/type :answer.type/math :answer/value "\\frac{2{e}^{3x}}{27}(27{x}^{4}+36{x}^{3}-36{x}^{2}+10x-20)+C" :db/ensure [:answer/validate]} {:db/id "answer-6da2e75c-0701-5b79-a64c-adc247058072" :answer/id #uuid "6da2e75c-0701-5b79-a64c-adc247058072" :answer/type :answer.type/math :answer/value "\\frac{2{e}^{3x}}{81}(27{x}^{4}-36{x}^{3}+36{x}^{2}+30x-10)+C" :db/ensure [:answer/validate]} {:db/id "answer-5ef12b2d-3da6-5428-8177-102eeef66d2b" :answer/id #uuid "5ef12b2d-3da6-5428-8177-102eeef66d2b" :answer/type :answer.type/math :answer/value "\\frac{{e}^{3x}}{27}(27{x}^{4}+36{x}^{3}-36{x}^{2}+30x-10)+C" :db/ensure [:answer/validate]} {:db/id "answer-fd8ab7a4-bb1c-5998-ba3f-50e0b6ba5816" :answer/id #uuid "fd8ab7a4-bb1c-5998-ba3f-50e0b6ba5816" :answer/type :answer.type/math :answer/value "\\frac{{e}^{3x}}{81}(20{x}^{4}+36{x}^{3}+36{x}^{2}+10x-27)+C" :db/ensure [:answer/validate]} {:db/id "answer-2c546568-626b-5cd6-b8ac-d2575386f3be" :answer/id #uuid "2c546568-626b-5cd6-b8ac-d2575386f3be" :answer/type :answer.type/math :answer/value "\\frac{{e}^{3x}}{81}(27{x}^{4}-27{x}^{3}+36{x}^{2}+20x-20)+C" :db/ensure [:answer/validate]} {:db/id 17592186097928 :tutorial/content "Suppose we want to evaluate $\\displaystyle \\int x^3e^{x/2} \\textrm{d}x.$ We can do it by applying integration by parts three times, but the calculation is pretty long. How can we speed it up?\n\nMultiple applications of integration by parts become quick and easy if we use the **tabular method**.\n\nLet's start by picking our $u$ and $\\dfrac{\\textrm{d}v}{\\textrm{d}x}$ as normal:\n\n$$\nu = x^3\\,,\\quad \\dfrac{\\textrm{d}v}{\\textrm{d}x} = e^{x/2}\\,.\n$$\n\nWe put this in a table, as shown below:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same Color Products** |\n| --- | --- | --- | --- |\n| $\\color[rgb]{1,0,0} x^3$ | $e^{x/2}$ |  |  |\n\nTo fill in the second row of the table, we differentiate the function in the first column and integrate the function in the second column. Doing this, we find\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(x^3\\right) = 3x^2\\,,\\quad \\int e^{x/2} \\textrm{d}x = 2e^{x/2}\\,.\n$$\n\nFilling in our table, we get the following:\n\n| **Derivatives** | **Integrals** | **Sign** | **Same Color Products** |\n| --- | --- | --- | --- |\n| $\\color[rgb]{1,0,0} x^3$ | $e^{x/2}$ |  |  |\n| $\\color[rgb]{0.77,0.45,0.06} 3x^2$ | $\\color[rgb]{1,0,0}2e^{x/2}$ | $\\color[rgb]{1,0,0} +$ |  |\n\nAt this step, we begin filling the third column. It always starts with a \"$+$\" and then the signs alternate at each subsequent step.\n\nWe continue by differentiating the expression in the first column and integrating the expression in the second column until we get zero in the first column.\n\n| **Derivatives** | **Integrals** | **Sign** | **Same Color Products** |\n| --- | --- | --- | --- |\n| $\\color[rgb]{1,0,0}  x^3$ | $e^{x/2}$ |  |  |\n| $\\color[rgb]{0.77,0.45,0.06} 3x^2$ | $\\color[rgb]{1,0,0}2e^{x/2}$ | $\\color[rgb]{1,0,0} +$ | $\\color[rgb]{1,0,0}$ |\n| $\\color[rgb]{0,0,1} 6x$ | $\\color[rgb]{0.77,0.45,0.06}  4e^{x/2}$ | $\\color[rgb]{0.77,0.45,0.06} -$ | $\\color[rgb]{0,0.5,0}$ |\n| $\\color[rgb]{1,0,1} 6$ | $\\color[rgb]{0,0,1} 8e^{x/2}$ | $\\color[rgb]{0,0,1} +$ | $\\color[rgb]{0,0,1}$ |\n| $0$ | $\\color[rgb]{1,0,1}16e^{x/2}$ | $\\color[rgb]{1,0,1} -$ | $\\color[rgb]{1,0,1}$ |\n\nNow we multiply the same-colored terms along with the same-colored sign. Specifically we multiply $\\color[rgb]{1,0,0} x^3$ with ${\\color[rgb]{1,0,0} 2e^{x/2}},$ $\\color[rgb]{0.77,0.45,0.06}3x^2$ with $\\color[rgb]{0.77,0.45,0.06}4e^{x/2},$ and so on. We get\n\n| **Derivatives** | **Integrals** | **Sign** | **Same Color Products** |\n| --- | --- | --- | --- |\n| $\\color[rgb]{1,0,0}  x^3$ | $e^{x/2}$ |  |  |\n| $\\color[rgb]{0.77,0.45,0.06}3x^2$ | $\\color[rgb]{1,0,0}2e^{x/2}$ | $\\color[rgb]{1,0,0} +$ | $\\color[rgb]{1,0,0} 2x^3e^{x/2}$ |\n| $\\color[rgb]{0,0,1} 6x$ | $\\color[rgb]{0.77,0.45,0.06}  4e^{x/2}$ | $\\color[rgb]{0.77,0.45,0.06} -$ | $\\color[rgb]{0.77,0.45,0.06}  -12x^2e^{x/2}$ |\n| $\\color[rgb]{1,0,1} 6$ | $\\color[rgb]{0,0,1} 8e^{x/2}$ | $\\color[rgb]{0,0,1} +$ | $\\color[rgb]{0,0,1} 48xe^{x/2}$ |\n| $0$ | $\\color[rgb]{1,0,1}16e^{x/2}$ | $\\color[rgb]{1,0,1} -$ | $\\color[rgb]{1,0,1} -96e^{x/2}$ |\n\nFinally, we add up all the terms of the last column to get the answer for our integral. We get\n\n$$\n\\begin{aligned}\\int {x}^{3}{e}^{x/2}\\text{d}x & =2{x}^{3}{e}^{x/2}-12{x}^{2}{e}^{x/2}+48x{e}^{x/2}-96{e}^{x/2}+C \\\\  & ={e}^{x/2}(2{x}^{3}-12{x}^{2}+48x-96)+C.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186096911 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186278512 :question/problem "For a surface $S$ given by $x=k(y,z)$ for $(y,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(P+\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\frac{∂k}{∂y}-R\\frac{∂k}{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}})\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :db/ensure [:question/validate]} {:db/id 17592186373979 :question/problem "For a surface $S$ given by $y=h(x,z)$ for $(x,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,\\bbox[3pt,border:1pt solid black]{\\phantom{A}}+Q-R\\,\\bbox[3pt,border:1pt solid black]{\\phantom{A}})\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?\n\n*Hint: The orientation of $S$ should be chosen such that the unit normal vector has a positive  $j$-component.*" :db/ensure [:question/validate]} {:db/id "activity-df435954-1cd9-5dc8-a4bc-e4a11d4ec2cd" :activity/id #uuid "df435954-1cd9-5dc8-a4bc-e4a11d4ec2cd" :activity/title "Calculating Flux Through Cartesian Surfaces" :activity/type :activity.type/review :activity/scope 17592186048253 :activity/course 17592186046660 :activity/steps ["step-8ba9fbc7-035a-538c-b7e1-210788ce26bd" "step-5d16da7c-f48e-50c4-8b96-72fe4c1bcefd" "step-9ece1467-fe57-5b84-83ba-ccb58fc3e044" "step-826f1594-5756-5ee6-b45a-e6412a441a9c" "step-f18556c0-8031-5ea6-99f8-95a239405c28"] :activity/first-step "step-8ba9fbc7-035a-538c-b7e1-210788ce26bd" :db/ensure [:activity/validate]} {:db/id "step-8ba9fbc7-035a-538c-b7e1-210788ce26bd" :step/id #uuid "8ba9fbc7-035a-538c-b7e1-210788ce26bd" :step/content 17592186278506 :step/next "step-5d16da7c-f48e-50c4-8b96-72fe4c1bcefd" :db/ensure [:step/validate]} {:db/id "step-5d16da7c-f48e-50c4-8b96-72fe4c1bcefd" :step/id #uuid "5d16da7c-f48e-50c4-8b96-72fe4c1bcefd" :step/content 17592186278512 :step/next "step-9ece1467-fe57-5b84-83ba-ccb58fc3e044" :db/ensure [:step/validate]} {:db/id "step-9ece1467-fe57-5b84-83ba-ccb58fc3e044" :step/id #uuid "9ece1467-fe57-5b84-83ba-ccb58fc3e044" :step/content 17592186401240 :step/next "step-826f1594-5756-5ee6-b45a-e6412a441a9c" :db/ensure [:step/validate]} {:db/id "step-826f1594-5756-5ee6-b45a-e6412a441a9c" :step/id #uuid "826f1594-5756-5ee6-b45a-e6412a441a9c" :step/content 17592186373979 :step/next "step-f18556c0-8031-5ea6-99f8-95a239405c28" :db/ensure [:step/validate]} {:db/id "step-f18556c0-8031-5ea6-99f8-95a239405c28" :step/id #uuid "f18556c0-8031-5ea6-99f8-95a239405c28" :step/content 17592186278522 :db/ensure [:step/validate]} {:db/id 17592186119871 :knowledge-point/questions ["question-e2d9d433-ba35-5944-b803-b7c1dcd52280" "question-017219c2-ceac-5f2c-bcc8-c754086bffcc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119535 :question/problem "The figure below shows the graph of $f(x).$ Evaluate $\\lim_\\limits{x \\to \\,4} f(x).$\n\n![](images/16/168433761f6629ad555a70acf5764f93246484c253f3c7ecba8fdfdfd87c2adf.png)" :question/worked-solution "We see from the graph that as $x$ approaches $4$ from the left, the function $f(x)$ approaches $-\\infty.$ So, the left-hand limit is\n\n$$\n\\lim_\\limits{x\\rightarrow 4^-} f(x) = -\\infty \\, .\n$$\n\nLikewise, as $x$ approaches $4$ from the right, the function $f(x)$ again approaches $-\\infty.$ So, the right-hand limit is\n\n$$\n\\lim_\\limits{x\\rightarrow 4^+} f(x) = -\\infty \\, .\n$$\n\nConsequently,\n\n$$\n\\lim_\\limits{x\\rightarrow 4} f(x)=-\\infty \\, .\n$$" :db/ensure [:question/validate]} {:db/id 17592186119869 :knowledge-point/questions ["question-50fa8042-1b8b-5648-8556-3cccc6bf538e" "question-e817a4fb-b6c9-5bc7-b2be-45b00395342a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119528 :question/problem "The figure below shows the graph of $f(x).$ What is $\\lim_\\limits{x \\to \\,-\\,4} f(x)?$\n\n![](images/ab/ab2abe13314c2005907dcd5d7077af8e87b7126474bbb0261f757d8ec7c00698.png)" :question/worked-solution "As $x$ approaches $-4$ from the right, the function value $f(x)$ grows to infinity, and therefore\n\n$$\n\\lim_\\limits{x\\to -4^+} f(x)=\\infty.\n$$\n\nHowever, the function $f(x)$ is not defined for $x<-4,$ and consequently we cannot approach $x=-4$ from the left. So we have\n\n$$\n\\lim_\\limits{x\\to -4^-} f(x)=\\text{DNE},\n$$\n\nand therefore\n\n$$\n\\lim_\\limits{x\\to -4} f(x)=\\text{DNE}.\n$$" :db/ensure [:question/validate]} {:db/id "question-e2d9d433-ba35-5944-b803-b7c1dcd52280" :question/id #uuid "e2d9d433-ba35-5944-b803-b7c1dcd52280" :question/math-academy-id "q-338943" :question/problem "![](images/e3/e30b6d047b119e5beb5f0d5cf5e013628e7c9836e0ca264ee2da92d1e589a0fc.png)\n\nThe figure above shows the graph of $f(x).$ Therefore\n\n${lim}_{x\\to \\,1}f(x)=$\n\n{{field-1}}." :question/worked-solution "We see from the graph that as $x$ approaches $1$ from the left, the function $f(x)$ approaches $-\\infty .$ So, the left-hand limit is\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)=-\\infty \\,.\n$$\n\nLikewise, as $x$ approaches $1$ from the right, the function $f(x)$ again approaches $-\\infty .$ So, the right-hand limit is\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)=-\\infty \\,.\n$$\n\nConsequently,\n\n$$\n{lim}_{x\\to 1}f(x)=-\\infty \\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2e7ccd24-e09e-533b-9505-2417c732784e"] :db/ensure [:question/validate]} {:db/id "answer-field-2e7ccd24-e09e-533b-9505-2417c732784e" :answer-field/id #uuid "2e7ccd24-e09e-533b-9505-2417c732784e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d9c0e29c-d52c-5258-ab57-b375f2f270e8" :answer-field/choices ["answer-d9c0e29c-d52c-5258-ab57-b375f2f270e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9c0e29c-d52c-5258-ab57-b375f2f270e8" :answer/id #uuid "d9c0e29c-d52c-5258-ab57-b375f2f270e8" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "question-017219c2-ceac-5f2c-bcc8-c754086bffcc" :question/id #uuid "017219c2-ceac-5f2c-bcc8-c754086bffcc" :question/math-academy-id "q-102535" :question/problem "![](images/f4/f498fdcd8c6be58b8d1c1e6e4c3d835799a8c571cdd9125f7e7555307c94a6d1.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above?\n\nI. ${lim}_{x\\to {3}^{+}}f(x)=\\infty $\n\nII. ${lim}_{x\\to {3}^{-}}f(x)=\\infty $\n\nIII. ${lim}_{x\\to 3}f(x)=1$" :question/worked-solution "First, let's compute the limits in question.\n\nWe see from the graph that as $x$ approaches $3$ from the left, the function $f(x)$ approaches $\\infty .$ So, the left-hand limit is\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=\\infty \\,.\n$$\n\nLikewise, as $x$ approaches $3$ from the right, the function $f(x)$ again approaches $\\infty .$ So, the right-hand limit is\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=\\infty \\,.\n$$\n\nConsequently,\n\n$$\n{lim}_{x\\to 3}f(x)=\\infty \\,.\n$$\n\nNow, let's examine each statement in turn.\n\n- Statement I is true.\n\n- Statement II is true.\n\n- Statement III is false.\n\nIn conclusion, statements I and II are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9eed7281-1934-5bdc-a678-4172938950d2"] :db/ensure [:question/validate]} {:db/id "answer-field-9eed7281-1934-5bdc-a678-4172938950d2" :answer-field/id #uuid "9eed7281-1934-5bdc-a678-4172938950d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1b03f17c-9676-59e3-8db8-8753739f4a0c" :answer-field/choices ["answer-1b03f17c-9676-59e3-8db8-8753739f4a0c" "answer-beff4087-1730-533e-9082-c58aac5886b5" "answer-a157332e-0d90-5a92-aec3-7773828f8e58" "answer-cf9499a2-03af-5a9c-bb6e-bac7ee617297" "answer-1464e2dc-2eb3-5328-acbb-72144d143a3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b03f17c-9676-59e3-8db8-8753739f4a0c" :answer/id #uuid "1b03f17c-9676-59e3-8db8-8753739f4a0c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-beff4087-1730-533e-9082-c58aac5886b5" :answer/id #uuid "beff4087-1730-533e-9082-c58aac5886b5" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-a157332e-0d90-5a92-aec3-7773828f8e58" :answer/id #uuid "a157332e-0d90-5a92-aec3-7773828f8e58" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-cf9499a2-03af-5a9c-bb6e-bac7ee617297" :answer/id #uuid "cf9499a2-03af-5a9c-bb6e-bac7ee617297" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-1464e2dc-2eb3-5328-acbb-72144d143a3a" :answer/id #uuid "1464e2dc-2eb3-5328-acbb-72144d143a3a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-50fa8042-1b8b-5648-8556-3cccc6bf538e" :question/id #uuid "50fa8042-1b8b-5648-8556-3cccc6bf538e" :question/math-academy-id "q-35921" :question/problem "![](images/fc/fc6f40458a9a38615b9d1fe01c7e454611a56915d2dcaadaa8661c4d56defb6f.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above?\n\nI. ${lim}_{x\\to {1}^{+}}f(x)=-\\infty $\n\nII. ${lim}_{x\\to {1}^{-}}f(x)=-\\infty $\n\nIII. ${lim}_{x\\to 1}f(x)=\\text{DNE}$" :question/worked-solution "First, let's compute the limits in question.\n\nAs $x$ approaches $1$ from the right, the function value $f(x)$ goes to $-\\infty ,$ and therefore\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)=-\\infty .\n$$\n\nAs $x$ approaches $1$ from the left, the function is not defined. So we have\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)=\\text{DNE}.\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to 1}f(x)=\\text{DNE}.\n$$\n\nNow, let's examine each statement in turn.\n\n- Statement I is true.\n\n- Statement II is false.\n\n- Statement III is true.\n\nIn conclusion, only statements I and III are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-32f89007-7576-53ed-91a9-d7ed7308be7b"] :db/ensure [:question/validate]} {:db/id "answer-field-32f89007-7576-53ed-91a9-d7ed7308be7b" :answer-field/id #uuid "32f89007-7576-53ed-91a9-d7ed7308be7b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c73ec37-aac0-5246-86d7-04dd50677be1" :answer-field/choices ["answer-8c73ec37-aac0-5246-86d7-04dd50677be1" "answer-4b12d8b2-9c93-5d39-a29d-a17f7189a787" "answer-c6c110f7-40d7-5549-b3f0-eaba6fa2c482" "answer-7b71a46f-d374-5dbd-89db-3d53441858bb" "answer-5633242a-0afe-5bba-83cb-e91ca3e9b54a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c73ec37-aac0-5246-86d7-04dd50677be1" :answer/id #uuid "8c73ec37-aac0-5246-86d7-04dd50677be1" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-4b12d8b2-9c93-5d39-a29d-a17f7189a787" :answer/id #uuid "4b12d8b2-9c93-5d39-a29d-a17f7189a787" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-c6c110f7-40d7-5549-b3f0-eaba6fa2c482" :answer/id #uuid "c6c110f7-40d7-5549-b3f0-eaba6fa2c482" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-7b71a46f-d374-5dbd-89db-3d53441858bb" :answer/id #uuid "7b71a46f-d374-5dbd-89db-3d53441858bb" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-5633242a-0afe-5bba-83cb-e91ca3e9b54a" :answer/id #uuid "5633242a-0afe-5bba-83cb-e91ca3e9b54a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-e817a4fb-b6c9-5bc7-b2be-45b00395342a" :question/id #uuid "e817a4fb-b6c9-5bc7-b2be-45b00395342a" :question/math-academy-id "q-339105" :question/problem "![](images/0c/0cdb3e9c74a36e5ef13436b7b18968064b278f6d8e0dffc27820f618f7f4fee9.png)\n\nThe figure above shows the graph of $f(x).$ Therefore\n\n${lim}_{x\\to {2}^{+}}f(x)=$\n{{field-1}}." :question/worked-solution "As $x$ approaches $2$ from the right, the function value $f(x)$ goes to $-\\infty $, and therefore\n\n$$\n{lim}_{x\\to {2}^{+}}f(x)=-\\infty .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b995a021-5404-518a-a21f-58d172fc8d4c"] :db/ensure [:question/validate]} {:db/id "answer-field-b995a021-5404-518a-a21f-58d172fc8d4c" :answer-field/id #uuid "b995a021-5404-518a-a21f-58d172fc8d4c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b496994b-a74b-5b4a-9928-66b5b1831571" :answer-field/choices ["answer-b496994b-a74b-5b4a-9928-66b5b1831571"] :db/ensure [:answer-field/validate]} {:db/id "answer-b496994b-a74b-5b4a-9928-66b5b1831571" :answer/id #uuid "b496994b-a74b-5b4a-9928-66b5b1831571" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id 17592186120993 :tutorial/content "Until now, all limits of the form $\\lim\\limits_{x \\to a} f(x)$ that we have encountered have evaluated to either a finite number or $\\text{DNE}.$ However, there is another possibility: the limit could be *infinite*!\n\nFor example, consider the function $f(x)$ whose graph is shown below. This function has a vertical asymptote at $x=1,$ and the function value $f(x)$ grows without bound as $x$ approaches the asymptote $x=1.$ What is the limit $\\lim_\\limits{x\\to 1} f(x)$? \n\n![](images/ab/ab9d57d3952fe0221616f9e64e1295fd0511703bdd5ed3a5fe91113cc7c8bf1b.png)\n\nRemember that in order for computing any limit, in this case, $\\lim_\\limits{x\\to 1} f(x),$ we have to compute the left and right-sided limits separately and ensure that they match up.\n\n- **Left-sided limit:** As we approach $x=1$ (the vertical asymptote) from the left side of the graph, the function $f(x)$ increases without bound, approaching $\\infty.$ We conclude that\n\n$$\n\\lim_\\limits{x\\to 1^-} f(x) = \\infty.\n$$\n\n- **Right-sided limit:** Likewise, as we approach the vertical asymptote $x=1$ from the right side of the graph, $f(x)$ still approaches $\\infty.$ Consequently, \n\n$$\n\\lim_\\limits{x\\to 1^+ } f(x) = \\infty.\n$$\n\nWe see that both the left and right limits exist and are equal to $\\infty\\mathbin{:}$ \n\n$$\n\\lim_\\limits{x\\to 1^-} f(x) = \\lim_\\limits{x\\to 1^+} f(x) = \\infty\n$$\n\nAs a result, the overall limit is also equal to $\\infty\\mathbin{:}$ \n\n$$\n\\lim_\\limits{x\\to 1} f(x) = \\infty\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186120022 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186092254 :knowledge-point/questions ["question-84522aa8-0251-51f3-8f96-c1848baee4b0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-84522aa8-0251-51f3-8f96-c1848baee4b0" :question/id #uuid "84522aa8-0251-51f3-8f96-c1848baee4b0" :question/math-academy-id "q-67300" :question/problem "${\\sum }_{n=1}^{\\infty }10{(\\frac{1}{2})}^{n}=$" :question/worked-solution "Notice that the given series is a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nThe sum to infinity ${S}_{\\infty }$ of a geometric series is given by the formula\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1,\n$$\n\nwhere ${a}_{1}$ is the first term and $r$ is the common ratio.\n\nThe first term is\n\n$$\n{a}_{1}=10{(\\frac{1}{2})}^{1}=5.\n$$\n\n \n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{10{(\\frac{1}{2})}^{2}}{10{(\\frac{1}{2})}^{1}}=\\frac{1}{2}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }10{(\\frac{1}{2})}^{n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{5}{(1-\\frac{1}{2})} \\\\  & =\\frac{5}{(\\frac{1}{2})} \\\\  & =5\\cdot \\frac{2}{1} \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-da4c8753-aa62-5b12-846b-3fa944adeb01"] :db/ensure [:question/validate]} {:db/id "answer-field-da4c8753-aa62-5b12-846b-3fa944adeb01" :answer-field/id #uuid "da4c8753-aa62-5b12-846b-3fa944adeb01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69067c60-3e9e-5a7c-8919-986fa0b1106b" :answer-field/choices ["answer-69067c60-3e9e-5a7c-8919-986fa0b1106b" "answer-5e40558d-2c08-52ce-bd22-49714e884a17" "answer-28fce1c0-fdae-52e2-b558-861fa662bf1a" "answer-5abc1e52-5007-58cf-923d-9f9cdea5bf21" "answer-2185bcec-d33c-5b85-a90f-3baf6d8e3134"] :db/ensure [:answer-field/validate]} {:db/id "answer-69067c60-3e9e-5a7c-8919-986fa0b1106b" :answer/id #uuid "69067c60-3e9e-5a7c-8919-986fa0b1106b" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-5e40558d-2c08-52ce-bd22-49714e884a17" :answer/id #uuid "5e40558d-2c08-52ce-bd22-49714e884a17" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-28fce1c0-fdae-52e2-b558-861fa662bf1a" :answer/id #uuid "28fce1c0-fdae-52e2-b558-861fa662bf1a" :answer/type :answer.type/math :answer/value "\\frac{10}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5abc1e52-5007-58cf-923d-9f9cdea5bf21" :answer/id #uuid "5abc1e52-5007-58cf-923d-9f9cdea5bf21" :answer/type :answer.type/math :answer/value "\\frac{20}{3}" :db/ensure [:answer/validate]} {:db/id "answer-2185bcec-d33c-5b85-a90f-3baf6d8e3134" :answer/id #uuid "2185bcec-d33c-5b85-a90f-3baf6d8e3134" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id 17592186092182 :knowledge-point/questions ["question-0515d331-a2ed-5378-ab7b-e5eca8ff6d75" "question-7ac43aed-fdf1-5439-85aa-b688b91d01e4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0515d331-a2ed-5378-ab7b-e5eca8ff6d75" :question/id #uuid "0515d331-a2ed-5378-ab7b-e5eca8ff6d75" :question/math-academy-id "q-78590" :question/problem "${\\sum }_{n=3}^{\\infty }\\frac{4}{9}{(\\frac{3}{4})}^{n}=$" :question/worked-solution "First, note that the index $n$ starts from $3.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{3},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{3}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{4}{9}{(\\frac{3}{4})}^{3}=\\frac{4}{9}(\\frac{27}{64})=\\frac{3}{16} \\\\ {a}_{4} & =\\frac{4}{9}{(\\frac{3}{4})}^{4}=\\frac{4}{9}(\\frac{81}{256})=\\frac{9}{64}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{4}}{{a}_{3}}=\\frac{(\\frac{9}{64})}{(\\frac{3}{16})}=\\frac{9}{64}\\cdot \\frac{16}{3}=\\frac{3}{4}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }\\frac{4}{9}{(\\frac{3}{4})}^{n} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{(\\frac{3}{16})}{(1-\\frac{3}{4})} \\\\  & =\\frac{(\\frac{3}{16})}{(\\frac{1}{4})} \\\\  & =\\frac{3}{16}\\cdot 4 \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-56ebf041-55c8-5fe4-affb-3c90d8aaeea7"] :db/ensure [:question/validate]} {:db/id "answer-field-56ebf041-55c8-5fe4-affb-3c90d8aaeea7" :answer-field/id #uuid "56ebf041-55c8-5fe4-affb-3c90d8aaeea7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1fcd25c1-b9a9-56eb-b404-446e379f595c" :answer-field/choices ["answer-689eccb5-cccc-5071-a58b-3df40833a9ed" "answer-a6af4e95-a3bd-547c-96b0-c9157f6909e5" "answer-c7e40d2d-f0bc-584c-b6d9-b4b71e9295ec" "answer-1fcd25c1-b9a9-56eb-b404-446e379f595c" "answer-8c692d74-d882-579c-a263-2ba81452e19d"] :db/ensure [:answer-field/validate]} {:db/id "answer-689eccb5-cccc-5071-a58b-3df40833a9ed" :answer/id #uuid "689eccb5-cccc-5071-a58b-3df40833a9ed" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-a6af4e95-a3bd-547c-96b0-c9157f6909e5" :answer/id #uuid "a6af4e95-a3bd-547c-96b0-c9157f6909e5" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c7e40d2d-f0bc-584c-b6d9-b4b71e9295ec" :answer/id #uuid "c7e40d2d-f0bc-584c-b6d9-b4b71e9295ec" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-1fcd25c1-b9a9-56eb-b404-446e379f595c" :answer/id #uuid "1fcd25c1-b9a9-56eb-b404-446e379f595c" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-8c692d74-d882-579c-a263-2ba81452e19d" :answer/id #uuid "8c692d74-d882-579c-a263-2ba81452e19d" :answer/type :answer.type/math :answer/value "\\frac{9}{64}" :db/ensure [:answer/validate]} {:db/id "question-7ac43aed-fdf1-5439-85aa-b688b91d01e4" :question/id #uuid "7ac43aed-fdf1-5439-85aa-b688b91d01e4" :question/math-academy-id "q-124590" :question/problem "${\\sum }_{n=3}^{\\infty }\\frac{25}{27}{(\\frac{3}{5})}^{n}=$" :question/worked-solution "First, note that the index $n$ starts from $3.$ However, it is still a geometric series because it is in the form $\\sum a{r}^{n}.$ \n\nIn this case, the first term is ${a}_{3},$ and so the sum to infinity ${S}_{\\infty }$ of this geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{3}}{1-r},\\,|r|<1.\n$$\n\nFor the first few terms, we have:\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{25}{27}{(\\frac{3}{5})}^{3}=\\frac{25}{27}(\\frac{27}{125})=\\frac{1}{5} \\\\ {a}_{4} & =\\frac{25}{27}{(\\frac{3}{5})}^{4}=\\frac{25}{27}(\\frac{81}{625})=\\frac{3}{25}\\end{aligned}\n$$\n\nThe common ratio is\n\n$$\nr=\\frac{{a}_{4}}{{a}_{3}}=\\frac{(\\frac{3}{25})}{(\\frac{1}{5})}=\\frac{3}{5}.\n$$\n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=3}^{\\infty }\\frac{25}{27}{(\\frac{3}{5})}^{n} & =\\frac{{a}_{3}}{1-r} \\\\  & =\\frac{(\\frac{1}{5})}{(1-\\frac{3}{5})} \\\\  & =\\frac{(\\frac{1}{5})}{(\\frac{2}{5})} \\\\  & =(\\frac{1}{5})\\cdot \\frac{5}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-be9f989d-d56a-54a6-a664-496350494e54"] :db/ensure [:question/validate]} {:db/id "answer-field-be9f989d-d56a-54a6-a664-496350494e54" :answer-field/id #uuid "be9f989d-d56a-54a6-a664-496350494e54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a306fe67-74bc-5773-80ce-c1513aa6afc7" :answer-field/choices ["answer-a306fe67-74bc-5773-80ce-c1513aa6afc7" "answer-0d5afcd8-4cf8-5778-a410-d996de8caa7f" "answer-3b943b2d-ea0b-5325-b2aa-3e8653e1e477" "answer-e32c4540-3e5c-5944-a86d-c76ecf3c6add" "answer-6ef15147-7c05-56d2-a62e-10a55dfa362d"] :db/ensure [:answer-field/validate]} {:db/id "answer-a306fe67-74bc-5773-80ce-c1513aa6afc7" :answer/id #uuid "a306fe67-74bc-5773-80ce-c1513aa6afc7" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-0d5afcd8-4cf8-5778-a410-d996de8caa7f" :answer/id #uuid "0d5afcd8-4cf8-5778-a410-d996de8caa7f" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-3b943b2d-ea0b-5325-b2aa-3e8653e1e477" :answer/id #uuid "3b943b2d-ea0b-5325-b2aa-3e8653e1e477" :answer/type :answer.type/math :answer/value "\\frac{3}{25}" :db/ensure [:answer/validate]} {:db/id "answer-e32c4540-3e5c-5944-a86d-c76ecf3c6add" :answer/id #uuid "e32c4540-3e5c-5944-a86d-c76ecf3c6add" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-6ef15147-7c05-56d2-a62e-10a55dfa362d" :answer/id #uuid "6ef15147-7c05-56d2-a62e-10a55dfa362d" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id 17592186092256 :knowledge-point/questions ["question-b85d1cfe-34fb-5d55-ad84-699fc2c94f6d" "question-4c0fb001-b215-5979-89f5-05a01ae52266"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b85d1cfe-34fb-5d55-ad84-699fc2c94f6d" :question/id #uuid "b85d1cfe-34fb-5d55-ad84-699fc2c94f6d" :question/math-academy-id "q-350640" :question/problem "Evaluate the geometric series ${\\sum }_{n=1}^{\\infty }\\frac{5}{2}{(-0.4)}^{2n}.$ Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }\\frac{5}{2}{(-0.4)}^{2n}=$\n{{field-1}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is \n\n$$\n{a}_{1}=\\frac{5}{2}{(-0.4)}^{2(1)}=\\frac{5}{2}{(-0.4)}^{2}\n$$\n\n \n\nand the second term is \n\n$$\n{a}_{2}=\\frac{5}{2}{(-0.4)}^{2(2)}=\\frac{5}{2}{(-0.4)}^{4}.\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\frac{5}{2}{(-0.4)}^{4}}{\\frac{5}{2}{(-0.4)}^{2}}={(-0.4)}^{2}=0.16.\n$$\n\n \n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{5}{2}{(-0.4)}^{2n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{\\frac{5}{2}{(-0.4)}^{2}}{1-0.16} \\\\  & =\\frac{\\frac{5}{2}(0.16)}{0.84} \\\\  & =\\frac{0.4}{0.84} \\\\  & =\\frac{10}{21}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-282a0a0f-efee-52cd-8a05-a07f215cbb39"] :db/ensure [:question/validate]} {:db/id "answer-field-282a0a0f-efee-52cd-8a05-a07f215cbb39" :answer-field/id #uuid "282a0a0f-efee-52cd-8a05-a07f215cbb39" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7d0264cc-d7dc-5c37-b30f-16424540ced2" :answer-field/choices ["answer-7d0264cc-d7dc-5c37-b30f-16424540ced2"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d0264cc-d7dc-5c37-b30f-16424540ced2" :answer/id #uuid "7d0264cc-d7dc-5c37-b30f-16424540ced2" :answer/type :answer.type/math :answer/value "\\frac{10}{21}" :db/ensure [:answer/validate]} {:db/id "question-4c0fb001-b215-5979-89f5-05a01ae52266" :question/id #uuid "4c0fb001-b215-5979-89f5-05a01ae52266" :question/math-academy-id "q-350641" :question/problem "Evaluate the geometric series ${\\sum }_{n=1}^{\\infty }\\frac{9}{4}{(-\\frac{1}{3})}^{2n}.$ Do not round the answer.\n\n${\\sum }_{n=1}^{\\infty }\\frac{9}{4}{(-\\frac{1}{3})}^{2n}=$\n{{field-1}}" :question/worked-solution "The sum to infinity ${S}_{\\infty }$ of a geometric series is given by\n\n$$\n{S}_{\\infty }=\\frac{{a}_{1}}{1-r},\\,|r|<1.\n$$\n\nThe first term is \n\n$$\n{a}_{1}=\\frac{9}{4}{(-\\frac{1}{3})}^{2(1)}=\\frac{9}{4}{(-\\frac{1}{3})}^{2}\n$$\n\n \n\nand the second term is \n\n$$\n{a}_{2}=\\frac{9}{4}{(-\\frac{1}{3})}^{2(2)}=\\frac{9}{4}{(-\\frac{1}{3})}^{4}.\n$$\n\nTherefore, the common ratio is \n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{\\frac{9}{4}{(-\\frac{1}{3})}^{4}}{\\frac{9}{4}{(-\\frac{1}{3})}^{2}}={(-\\frac{1}{3})}^{2}=\\frac{1}{9}.\n$$\n\n \n\nSo, the sum of the series is\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{9}{4}{(-\\frac{1}{3})}^{2n} & =\\frac{{a}_{1}}{1-r} \\\\  & =\\frac{\\frac{9}{4}(\\frac{1}{9})}{(1-\\frac{1}{9})} \\\\  & =\\frac{(\\frac{1}{4})}{(\\frac{8}{9})} \\\\  & =\\frac{1}{4}\\cdot \\frac{9}{8} \\\\  & =\\frac{9}{32}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1a4447f-3bfa-5239-8811-1f6dff980305"] :db/ensure [:question/validate]} {:db/id "answer-field-b1a4447f-3bfa-5239-8811-1f6dff980305" :answer-field/id #uuid "b1a4447f-3bfa-5239-8811-1f6dff980305" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-108be319-2cac-5831-9175-1aabb3c72448" :answer-field/choices ["answer-108be319-2cac-5831-9175-1aabb3c72448"] :db/ensure [:answer-field/validate]} {:db/id "answer-108be319-2cac-5831-9175-1aabb3c72448" :answer/id #uuid "108be319-2cac-5831-9175-1aabb3c72448" :answer/type :answer.type/math :answer/value "\\frac{9}{32}" :db/ensure [:answer/validate]} {:db/id "activity-39c575ad-87f7-577c-b7de-503df313a6fa" :activity/id #uuid "39c575ad-87f7-577c-b7de-503df313a6fa" :activity/title "Sums of Infinite Geometric Series Given in Sigma Notation" :activity/type :activity.type/review :activity/scope 17592186048204 :activity/course 17592186046645 :activity/steps ["step-8661678d-4c4b-54f6-b95b-86b213e25dda" "step-da72f953-d706-5801-a724-042fb2b1439b" "step-e0ee7c2b-1160-544f-ad0f-fa7041d54fb9" "step-c0968cfd-c4e6-58c4-bbe3-c52236c84b10" "step-120cee62-a2ba-56d3-bd5a-73197dd03830"] :activity/first-step "step-8661678d-4c4b-54f6-b95b-86b213e25dda" :db/ensure [:activity/validate]} {:db/id "step-8661678d-4c4b-54f6-b95b-86b213e25dda" :step/id #uuid "8661678d-4c4b-54f6-b95b-86b213e25dda" :step/content "question-84522aa8-0251-51f3-8f96-c1848baee4b0" :step/next "step-da72f953-d706-5801-a724-042fb2b1439b" :db/ensure [:step/validate]} {:db/id "step-da72f953-d706-5801-a724-042fb2b1439b" :step/id #uuid "da72f953-d706-5801-a724-042fb2b1439b" :step/content "question-0515d331-a2ed-5378-ab7b-e5eca8ff6d75" :step/next "step-e0ee7c2b-1160-544f-ad0f-fa7041d54fb9" :db/ensure [:step/validate]} {:db/id "step-e0ee7c2b-1160-544f-ad0f-fa7041d54fb9" :step/id #uuid "e0ee7c2b-1160-544f-ad0f-fa7041d54fb9" :step/content "question-7ac43aed-fdf1-5439-85aa-b688b91d01e4" :step/next "step-c0968cfd-c4e6-58c4-bbe3-c52236c84b10" :db/ensure [:step/validate]} {:db/id "step-c0968cfd-c4e6-58c4-bbe3-c52236c84b10" :step/id #uuid "c0968cfd-c4e6-58c4-bbe3-c52236c84b10" :step/content "question-b85d1cfe-34fb-5d55-ad84-699fc2c94f6d" :step/next "step-120cee62-a2ba-56d3-bd5a-73197dd03830" :db/ensure [:step/validate]} {:db/id "step-120cee62-a2ba-56d3-bd5a-73197dd03830" :step/id #uuid "120cee62-a2ba-56d3-bd5a-73197dd03830" :step/content "question-4c0fb001-b215-5979-89f5-05a01ae52266" :db/ensure [:step/validate]} {:db/id 17592186188296 :knowledge-point/questions ["question-4bc6d1d2-09ee-5cec-a2ab-850e837a407d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4bc6d1d2-09ee-5cec-a2ab-850e837a407d" :question/id #uuid "4bc6d1d2-09ee-5cec-a2ab-850e837a407d" :question/math-academy-id "q-149608" :question/problem "Let $X$ and $Y$ be two continuous random variables with the joint probability density function\n\n$$\nf(x,y)=\\{\\begin{aligned}2y\\operatorname{cos}⁡x, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le 1, \\\\ 0, & \\,\\text{otherwise}.\\end{aligned}\n$$\n\nFind the expected value of $Y.$" :question/worked-solution "The marginal density function for $Y$ when $0\\le y\\le 1$ is \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}2y\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =2y[\\operatorname{sin}⁡x]_{0}^{\\pi /2} \\\\  & =2y(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡0) \\\\  & =2y(1-0) \\\\  & =2y.\\end{aligned}\n$$\n\nTherefore, the full expression for ${f}_{X}(x)$ is given by\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nFinally, the  expected value of $Y$ is \n\n$$\n\\begin{aligned}\\text{E}[Y] & ={\\int }_{-\\infty }^{\\infty }y\\cdot {f}_{Y}(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\cdot 2y\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}2{y}^{2}\\,\\text{d}y \\\\  & ={[\\frac{2}{3}{y}^{3}]}_{0}^{1} \\\\  & =(\\frac{2}{3}-0) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-76f810c9-6c36-550e-ba2c-f211b1f812da"] :db/ensure [:question/validate]} {:db/id "answer-field-76f810c9-6c36-550e-ba2c-f211b1f812da" :answer-field/id #uuid "76f810c9-6c36-550e-ba2c-f211b1f812da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8782a4d4-81e3-5eb0-85bd-15bc8474d851" :answer-field/choices ["answer-8a6fa4fc-9ef6-5b97-80a9-85f5119427ad" "answer-4a066f3a-c9ff-5381-9be1-463aeaf34b51" "answer-8782a4d4-81e3-5eb0-85bd-15bc8474d851" "answer-718f587f-9400-5ff2-8042-b2bbeeac6f6d" "answer-5a2bfd91-8772-51d9-bdc2-da46a676b608"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a6fa4fc-9ef6-5b97-80a9-85f5119427ad" :answer/id #uuid "8a6fa4fc-9ef6-5b97-80a9-85f5119427ad" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4a066f3a-c9ff-5381-9be1-463aeaf34b51" :answer/id #uuid "4a066f3a-c9ff-5381-9be1-463aeaf34b51" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8782a4d4-81e3-5eb0-85bd-15bc8474d851" :answer/id #uuid "8782a4d4-81e3-5eb0-85bd-15bc8474d851" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-718f587f-9400-5ff2-8042-b2bbeeac6f6d" :answer/id #uuid "718f587f-9400-5ff2-8042-b2bbeeac6f6d" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-5a2bfd91-8772-51d9-bdc2-da46a676b608" :answer/id #uuid "5a2bfd91-8772-51d9-bdc2-da46a676b608" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "activity-6ab3dcd9-863a-5101-ba51-de1e64d41b2c" :activity/id #uuid "6ab3dcd9-863a-5101-b