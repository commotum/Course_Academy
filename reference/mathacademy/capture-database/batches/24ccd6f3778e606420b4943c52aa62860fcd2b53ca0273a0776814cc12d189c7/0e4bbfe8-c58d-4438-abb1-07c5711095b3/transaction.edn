a45" :step/content "question-aad779ca-b824-50cb-b4dc-f0dd2ba06356" :step/next "step-1f2dfb02-7449-57f0-8474-7ab8cc23d410" :db/ensure [:step/validate]} {:db/id "step-1f2dfb02-7449-57f0-8474-7ab8cc23d410" :step/id #uuid "1f2dfb02-7449-57f0-8474-7ab8cc23d410" :step/content 17592186510389 :step/next "step-00bf7e71-a2f6-5d03-9ce5-51e605b39bdf" :db/ensure [:step/validate]} {:db/id "step-00bf7e71-a2f6-5d03-9ce5-51e605b39bdf" :step/id #uuid "00bf7e71-a2f6-5d03-9ce5-51e605b39bdf" :step/content 17592186510376 :step/next "step-6213e43a-b8e6-5090-8550-09bf102c1d90" :db/ensure [:step/validate]} {:db/id "step-6213e43a-b8e6-5090-8550-09bf102c1d90" :step/id #uuid "6213e43a-b8e6-5090-8550-09bf102c1d90" :step/content 17592186360496 :step/next "step-d0d18cff-ebd0-51fc-8898-369edfc897b7" :db/ensure [:step/validate]} {:db/id "step-d0d18cff-ebd0-51fc-8898-369edfc897b7" :step/id #uuid "d0d18cff-ebd0-51fc-8898-369edfc897b7" :step/content "question-1c9e9df7-050b-54af-a7dc-34ce03f716ac" :db/ensure [:step/validate]} {:db/id 17592186078466 :knowledge-point/questions ["question-3a1942e4-caa0-5f58-aeeb-9eef16c2b831"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3a1942e4-caa0-5f58-aeeb-9eef16c2b831" :question/id #uuid "3a1942e4-caa0-5f58-aeeb-9eef16c2b831" :question/math-academy-id "q-19982" :question/problem "Given an arithmetic sequence that has ${a}_{10}=23$ and the common difference $d=3$, what is the general formula for the $n$th term of the sequence?" :question/worked-solution "Since ${a}_{10}=23$ is $9$ jumps after ${a}_{1},$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{10} & ={a}_{1}+9d \\\\ 23 & ={a}_{1}+9(3) \\\\ 23 & ={a}_{1}+27 \\\\ -4 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-4+(n-1)(3) \\\\  & =-4+3n-3 \\\\  & =3n-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3600f700-81aa-539b-9b1e-e8b15201fad2"] :db/ensure [:question/validate]} {:db/id "answer-field-3600f700-81aa-539b-9b1e-e8b15201fad2" :answer-field/id #uuid "3600f700-81aa-539b-9b1e-e8b15201fad2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9d698802-d582-5322-94ce-c890e61d06c8" :answer-field/choices ["answer-149d2a25-3355-5476-9483-6ef32c464750" "answer-15b024da-39c0-5595-9f56-e6a113bbb89a" "answer-5c8829a0-1b20-5c89-9024-a64b275b91c2" "answer-9d698802-d582-5322-94ce-c890e61d06c8" "answer-eafe4bd3-18f0-5764-bb6e-1785d198798e"] :db/ensure [:answer-field/validate]} {:db/id "answer-149d2a25-3355-5476-9483-6ef32c464750" :answer/id #uuid "149d2a25-3355-5476-9483-6ef32c464750" :answer/type :answer.type/math :answer/value "{a}_{n}=-7-3n" :db/ensure [:answer/validate]} {:db/id "answer-15b024da-39c0-5595-9f56-e6a113bbb89a" :answer/id #uuid "15b024da-39c0-5595-9f56-e6a113bbb89a" :answer/type :answer.type/math :answer/value "{a}_{n}=3n+7" :db/ensure [:answer/validate]} {:db/id "answer-5c8829a0-1b20-5c89-9024-a64b275b91c2" :answer/id #uuid "5c8829a0-1b20-5c89-9024-a64b275b91c2" :answer/type :answer.type/math :answer/value "{a}_{n}=3n-5" :db/ensure [:answer/validate]} {:db/id "answer-9d698802-d582-5322-94ce-c890e61d06c8" :answer/id #uuid "9d698802-d582-5322-94ce-c890e61d06c8" :answer/type :answer.type/math :answer/value "{a}_{n}=3n-7" :db/ensure [:answer/validate]} {:db/id "answer-eafe4bd3-18f0-5764-bb6e-1785d198798e" :answer/id #uuid "eafe4bd3-18f0-5764-bb6e-1785d198798e" :answer/type :answer.type/math :answer/value "{a}_{n}=7n-7" :db/ensure [:answer/validate]} {:db/id 17592186078464 :knowledge-point/questions ["question-89937c4c-b18e-5039-ba6e-7940ef191d3c" "question-bc128731-698c-584b-a0e3-391ca3d39ded"] :db/ensure [:knowledge-point/validate]} {:db/id "question-89937c4c-b18e-5039-ba6e-7940ef191d3c" :question/id #uuid "89937c4c-b18e-5039-ba6e-7940ef191d3c" :question/math-academy-id "q-100839" :question/problem "Find the general formula for the $n$th term of the arithmetic sequence that begins with \n\n$$\n19,\\,17,\\,15,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nFrom the first few terms\n\n$$\n19,\\,17,\\,15,\\,…\n$$\n\nwe see that the first term is $f(1)=19$ and the common difference is \n\n$$\nd=17-19=-2.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =19+(n-1)(-2) \\\\  & =19-2n+2 \\\\  & =21-2n\\end{aligned}\n$$\n\n    \n\nTherefore, the formula for the $n$th term is $f(n)=21-2n.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d5d52af8-2924-5fe6-b3c8-abd3e2fc08d4"] :db/ensure [:question/validate]} {:db/id "answer-field-d5d52af8-2924-5fe6-b3c8-abd3e2fc08d4" :answer-field/id #uuid "d5d52af8-2924-5fe6-b3c8-abd3e2fc08d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53bb4e1e-5889-56d8-9213-e82f82adab40" :answer-field/choices ["answer-6fbba565-83f4-5c3d-94c9-3458a2250ffb" "answer-9075cc84-4347-58c2-abbb-1932b80b3932" "answer-66ab06c6-74ed-51a0-a275-dfbca43f60bc" "answer-2f6c4e76-71d7-5c88-ad1b-84c8143a9cf3" "answer-53bb4e1e-5889-56d8-9213-e82f82adab40"] :db/ensure [:answer-field/validate]} {:db/id "answer-6fbba565-83f4-5c3d-94c9-3458a2250ffb" :answer/id #uuid "6fbba565-83f4-5c3d-94c9-3458a2250ffb" :answer/type :answer.type/math :answer/value "f(n)=17+2n" :db/ensure [:answer/validate]} {:db/id "answer-9075cc84-4347-58c2-abbb-1932b80b3932" :answer/id #uuid "9075cc84-4347-58c2-abbb-1932b80b3932" :answer/type :answer.type/math :answer/value "f(n)=17-2n" :db/ensure [:answer/validate]} {:db/id "answer-66ab06c6-74ed-51a0-a275-dfbca43f60bc" :answer/id #uuid "66ab06c6-74ed-51a0-a275-dfbca43f60bc" :answer/type :answer.type/math :answer/value "f(n)=19-2n" :db/ensure [:answer/validate]} {:db/id "answer-2f6c4e76-71d7-5c88-ad1b-84c8143a9cf3" :answer/id #uuid "2f6c4e76-71d7-5c88-ad1b-84c8143a9cf3" :answer/type :answer.type/math :answer/value "f(n)=21+2n" :db/ensure [:answer/validate]} {:db/id "answer-53bb4e1e-5889-56d8-9213-e82f82adab40" :answer/id #uuid "53bb4e1e-5889-56d8-9213-e82f82adab40" :answer/type :answer.type/math :answer/value "f(n)=21-2n" :db/ensure [:answer/validate]} {:db/id 17592186078465 :knowledge-point/questions ["question-985912e6-de0a-5f5e-a520-8f2ffaee1968"] :db/ensure [:knowledge-point/validate]} {:db/id "question-985912e6-de0a-5f5e-a520-8f2ffaee1968" :question/id #uuid "985912e6-de0a-5f5e-a520-8f2ffaee1968" :question/math-academy-id "q-108425" :question/problem "Find the $33$rd term of the following arithmetic sequence.\n\n$$\n13,\\,8,\\,3,\\,-2,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n13,\\,8,\\,3,\\,-2,\\,…\n$$\n\nwe see that the first term is ${a}_{1}=13$ and the common difference is \n\n$$\nd=8-13=-5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =13+(n-1)(-5) \\\\  & =13-5n+5 \\\\  & =18-5n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $33$rd term. All we have to do is substitute $n=33:$\n\n$$\n\\begin{aligned}{a}_{n} & =18-5n \\\\ {a}_{33} & =18-5(33) \\\\  & =18-165 \\\\  & =-147\\end{aligned}\n$$\n\nTherefore, the $33$rd term of the sequence is ${a}_{33}=-147.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-abede6a0-89e1-5a83-afd9-f80c57dc4266"] :db/ensure [:question/validate]} {:db/id "answer-field-abede6a0-89e1-5a83-afd9-f80c57dc4266" :answer-field/id #uuid "abede6a0-89e1-5a83-afd9-f80c57dc4266" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ad28e5d-83ac-5491-a717-309c203fa850" :answer-field/choices ["answer-0c6276f4-81a3-56a7-9734-86d03dd61f6f" "answer-07f77056-5d14-5518-9cbd-e4452715e777" "answer-6c7ba412-0a09-5ef6-ad37-9e32e70aba66" "answer-9ad28e5d-83ac-5491-a717-309c203fa850" "answer-fd2de95c-c117-5333-977c-0e532865c0d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c6276f4-81a3-56a7-9734-86d03dd61f6f" :answer/id #uuid "0c6276f4-81a3-56a7-9734-86d03dd61f6f" :answer/type :answer.type/math :answer/value "-117" :db/ensure [:answer/validate]} {:db/id "answer-07f77056-5d14-5518-9cbd-e4452715e777" :answer/id #uuid "07f77056-5d14-5518-9cbd-e4452715e777" :answer/type :answer.type/math :answer/value "-132" :db/ensure [:answer/validate]} {:db/id "answer-6c7ba412-0a09-5ef6-ad37-9e32e70aba66" :answer/id #uuid "6c7ba412-0a09-5ef6-ad37-9e32e70aba66" :answer/type :answer.type/math :answer/value "-142" :db/ensure [:answer/validate]} {:db/id "answer-9ad28e5d-83ac-5491-a717-309c203fa850" :answer/id #uuid "9ad28e5d-83ac-5491-a717-309c203fa850" :answer/type :answer.type/math :answer/value "-147" :db/ensure [:answer/validate]} {:db/id "answer-fd2de95c-c117-5333-977c-0e532865c0d4" :answer/id #uuid "fd2de95c-c117-5333-977c-0e532865c0d4" :answer/type :answer.type/math :answer/value "-152" :db/ensure [:answer/validate]} {:db/id "question-bc128731-698c-584b-a0e3-391ca3d39ded" :question/id #uuid "bc128731-698c-584b-a0e3-391ca3d39ded" :question/math-academy-id "q-214180" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-2$ and the second term is $3.$\n\n$f(n)=$\n{{field-1}}\n$,\\,n\\ge 1$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=-2.$ Also, the common difference of the sequence can be found as\n\n$$\nd=3-(-2)=5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-2+(n-1)(5) \\\\  & =-2+5n-5 \\\\  & =5n-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-26dd1386-b847-5429-b10f-64f524c091e9"] :db/ensure [:question/validate]} {:db/id "answer-field-26dd1386-b847-5429-b10f-64f524c091e9" :answer-field/id #uuid "26dd1386-b847-5429-b10f-64f524c091e9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e72eddf4-f297-542a-8adb-ccb2df0a4268" :answer-field/choices ["answer-e72eddf4-f297-542a-8adb-ccb2df0a4268"] :db/ensure [:answer-field/validate]} {:db/id "answer-e72eddf4-f297-542a-8adb-ccb2df0a4268" :answer/id #uuid "e72eddf4-f297-542a-8adb-ccb2df0a4268" :answer/type :answer.type/math :answer/value "5n-7" :db/ensure [:answer/validate]} {:db/id 17592186078808 :question/problem "Consider the following arithmetic sequence.\n\n$$\n-17,\\,-12,\\,-7,\\,-2,\\,…\n$$\n\nWhat is the $24$th term of this sequence?\n\n${a}_{24}=$\n{{field-1}}" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n-17,\\,-12,\\,-7,\\,-2,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=-17$ and the common difference is \n\n$$\nd=-12-(-17)=5.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-17+(n-1)(5) \\\\  & =-17+5n-5 \\\\  & =5n-22\\end{aligned}\n$$\n\nNow, we can use our formula to find the $24$th term. All we have to do is substitute $n=24:$\n\n$$\n\\begin{aligned}{a}_{n} & =5n-22 \\\\ {a}_{24} & =5(24)-22 \\\\  & =120-22 \\\\  & =98\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186075756 :answer-field/correct "answer-458896f3-f370-52f1-9e3e-51ef001c59b1" :answer-field/choices ["answer-458896f3-f370-52f1-9e3e-51ef001c59b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-458896f3-f370-52f1-9e3e-51ef001c59b1" :answer/id #uuid "458896f3-f370-52f1-9e3e-51ef001c59b1" :answer/type :answer.type/math :answer/value "98" :db/ensure [:answer/validate]} {:db/id "activity-b2e9f259-a49d-50fe-8d81-4ae722fca5d0" :activity/id #uuid "b2e9f259-a49d-50fe-8d81-4ae722fca5d0" :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type :activity.type/review :activity/scope 17592186050157 :activity/course 17592186046647 :activity/steps ["step-b95bdef4-950e-5d9f-9010-46130d47212a" "step-1b7586b2-7187-526e-80b9-c9e05218ba34" "step-033c0cbd-058f-545a-b909-5256409e8977" "step-9ac76756-68b5-5248-924d-2688b5cafc76" "step-3dab1ea8-198d-52e8-b2e7-dce76d84a576"] :activity/first-step "step-b95bdef4-950e-5d9f-9010-46130d47212a" :db/ensure [:activity/validate]} {:db/id "step-b95bdef4-950e-5d9f-9010-46130d47212a" :step/id #uuid "b95bdef4-950e-5d9f-9010-46130d47212a" :step/content "question-3a1942e4-caa0-5f58-aeeb-9eef16c2b831" :step/next "step-1b7586b2-7187-526e-80b9-c9e05218ba34" :db/ensure [:step/validate]} {:db/id "step-1b7586b2-7187-526e-80b9-c9e05218ba34" :step/id #uuid "1b7586b2-7187-526e-80b9-c9e05218ba34" :step/content "question-89937c4c-b18e-5039-ba6e-7940ef191d3c" :step/next "step-033c0cbd-058f-545a-b909-5256409e8977" :db/ensure [:step/validate]} {:db/id "step-033c0cbd-058f-545a-b909-5256409e8977" :step/id #uuid "033c0cbd-058f-545a-b909-5256409e8977" :step/content "question-985912e6-de0a-5f5e-a520-8f2ffaee1968" :step/next "step-9ac76756-68b5-5248-924d-2688b5cafc76" :db/ensure [:step/validate]} {:db/id "step-9ac76756-68b5-5248-924d-2688b5cafc76" :step/id #uuid "9ac76756-68b5-5248-924d-2688b5cafc76" :step/content "question-bc128731-698c-584b-a0e3-391ca3d39ded" :step/next "step-3dab1ea8-198d-52e8-b2e7-dce76d84a576" :db/ensure [:step/validate]} {:db/id "step-3dab1ea8-198d-52e8-b2e7-dce76d84a576" :step/id #uuid "3dab1ea8-198d-52e8-b2e7-dce76d84a576" :step/content 17592186078808 :db/ensure [:step/validate]} [:db/retract 17592186314202 :answer-field/choices 17592186312421] [:db/retract 17592186164865 :answer-field/choices 17592186164866] [:db/retract 17592186314101 :answer-field/choices 17592186312850] {:db/id 17592186166962 :knowledge-point/questions ["question-d11bc330-9efc-55d1-a388-de4f864cc23e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166964 :knowledge-point/questions ["question-dc02bcc8-5f0f-5f17-99b3-d1e75d3135c1" "question-3db32c22-3de8-5264-9b28-9916a3aeb5f2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167264 :question/problem "Let $F(x)=2x$ for $x\\in R.$ Suppose $f(x)$ is the $3$-periodic extension of $F(x)$ from $x\\in [0,3)$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x+6)=f(x)$ for all $x\\in R$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+2)=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $3$-periodic extension of $F,$ we have \n\n- $f(x+3)=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,3).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}f(x+6)=f((x+3)+3)=f(x+3)=f(x)\\end{aligned}\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=4.$ Then,\n\n$$\n\\begin{aligned}f(4)=f(1+3)=f(1)=F(1)=2(1)=2,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(4)=2(4)=8.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=4.$\n\n- Statement III is false. For example, take $x=2.$ Then, \n\n$$\n\\begin{aligned}f(2+2)=f(4)=f(1+3)=f(1)=F(1)=2(1)=2\\end{aligned}\n$$\n\nwhile \n\n$$\n\\begin{aligned}f(2)=F(2)=2(2)=4.\\end{aligned}\n$$\n\nHence, $f(x+2)\\ne f(2)$ for $x=2.$\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164762 :answer-field/correct 17592186164763 :db/ensure [:answer-field/validate]} {:db/id "question-d11bc330-9efc-55d1-a388-de4f864cc23e" :question/id #uuid "d11bc330-9efc-55d1-a388-de4f864cc23e" :question/math-academy-id "q-340511" :question/problem "Let $F(x)=4x-1$ for $x\\in R.$ Suppose $f(x)$ is the $6$-periodic extension of $F(x)$ from $x\\in [0,6)$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x+12)=f(x)$ for all $x\\in R$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+3)=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $6$-periodic extension of $F,$ we have \n\n- $f(x+6)=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,6).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}f(x+12)=f((x+6)+6)=f(x+6)=f(x).\\end{aligned}\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=7.$ Then,\n\n$$\n\\begin{aligned}f(7)=f(1+6)=f(1)=F(1)=3,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(7)=27.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=7.$\n\n- Statement III is false. For example, take $x=2.$ Then,\n\n$$\n\\begin{aligned}f(2+3)=f(5)=F(5)=19\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}f(2)=F(2)=7.\\end{aligned}\n$$\n\nHence, $f(x+3)\\ne f(x)$ for $x=2.$\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-67d9a9a1-d4bf-5f85-97bb-b57a4ffb6644"] :db/ensure [:question/validate]} {:db/id "answer-field-67d9a9a1-d4bf-5f85-97bb-b57a4ffb6644" :answer-field/id #uuid "67d9a9a1-d4bf-5f85-97bb-b57a4ffb6644" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f962769d-467c-5c55-b93f-dae3d07918c0" :answer-field/choices ["answer-513baa56-f91e-5c3b-99a2-c83dbfe5f274" "answer-f962769d-467c-5c55-b93f-dae3d07918c0" "answer-316390e2-a9a1-557a-b993-1eb5daa5337e" "answer-1091f7e8-6330-5e59-9a2c-9f9973d68732" "answer-95757a8f-1751-58fa-98e7-c089f0afadab"] :db/ensure [:answer-field/validate]} {:db/id "answer-513baa56-f91e-5c3b-99a2-c83dbfe5f274" :answer/id #uuid "513baa56-f91e-5c3b-99a2-c83dbfe5f274" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f962769d-467c-5c55-b93f-dae3d07918c0" :answer/id #uuid "f962769d-467c-5c55-b93f-dae3d07918c0" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-316390e2-a9a1-557a-b993-1eb5daa5337e" :answer/id #uuid "316390e2-a9a1-557a-b993-1eb5daa5337e" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-1091f7e8-6330-5e59-9a2c-9f9973d68732" :answer/id #uuid "1091f7e8-6330-5e59-9a2c-9f9973d68732" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-95757a8f-1751-58fa-98e7-c089f0afadab" :answer/id #uuid "95757a8f-1751-58fa-98e7-c089f0afadab" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186315084 :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(3x),\\operatorname{cos}⁡(4x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(3x)$ and $g(x)=\\operatorname{cos}⁡(4x)$ \n{{field-2}}." :db/ensure [:question/validate]} {:db/id 17592186314202 :answer-field/correct 17592186313268 :db/ensure [:answer-field/validate]} {:db/id 17592186167274 :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi ]$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(4x),1⟩=$ \n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=1$ \n{{field-2}}." :question/worked-solution "Evaluating the inner product, we obtain\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(4x),1⟩ & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡(4x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{4}\\operatorname{cos}⁡(4x)]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{4}(\\operatorname{cos}⁡(8\\pi )-(\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{4}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=1$ $\\text{are orthogonal}$ with respect to the inner product." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164865 :answer-field/correct 17592186164868 :answer-field/choices ["answer-f5f44a38-9c4d-555c-8e31-fc73981a0d16"] :db/ensure [:answer-field/validate]} {:db/id "answer-f5f44a38-9c4d-555c-8e31-fc73981a0d16" :answer/id #uuid "f5f44a38-9c4d-555c-8e31-fc73981a0d16" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id 17592186164862 :answer-field/correct 17592186164864 :db/ensure [:answer-field/validate]} {:db/id 17592186314996 :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [-\\pi ,\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(4x),\\operatorname{cos}⁡(3x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=\\operatorname{cos}⁡(3x)$ \n{{field-2}}." :db/ensure [:question/validate]} {:db/id 17592186314101 :answer-field/correct 17592186312207 :db/ensure [:answer-field/validate]} {:db/id "question-dc02bcc8-5f0f-5f17-99b3-d1e75d3135c1" :question/id #uuid "dc02bcc8-5f0f-5f17-99b3-d1e75d3135c1" :question/math-academy-id "q-340658" :question/problem "Let $F(x)=2{x}^{3}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{2}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{b}_{2} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(2x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(2x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(2x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(2x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(2x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{2}⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩ & ={\\int }_{0}^{2\\pi }{sin}^{2}⁡(2x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{8}\\operatorname{sin}⁡(4x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)-\\frac{1}{8}(\\operatorname{sin}⁡(8\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(2x)⟩ & ={b}_{2}⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩ \\\\ {b}_{2} & =\\frac{⟨f(x),\\operatorname{sin}⁡(2x)⟩}{⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩} \\\\ {b}_{2} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }2{x}^{3}\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-74ef7a6c-fb00-53a3-972e-01dd7c23eeb4" "answer-field-ab111ab9-2939-595a-a735-21f1af4492c6" "answer-field-bdf5d372-c050-5c3d-88c9-dcbaace4b624"] :db/ensure [:question/validate]} {:db/id "answer-field-74ef7a6c-fb00-53a3-972e-01dd7c23eeb4" :answer-field/id #uuid "74ef7a6c-fb00-53a3-972e-01dd7c23eeb4" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-7e3076ef-cd8e-575d-b5cb-6b50bb6c223e" :answer-field/choices ["answer-c78baa52-bf94-5e51-b595-b930bd5c8015" "answer-c5c81524-f03c-5663-8642-d4fa1374adc2" "answer-a8d0730b-a30e-5494-b259-9c910c59ce86" "answer-a797b333-69ea-5195-9052-53a822c090ca" "answer-7e3076ef-cd8e-575d-b5cb-6b50bb6c223e"] :db/ensure [:answer-field/validate]} {:db/id "answer-c78baa52-bf94-5e51-b595-b930bd5c8015" :answer/id #uuid "c78baa52-bf94-5e51-b595-b930bd5c8015" :answer/type :answer.type/math :answer/value "\\frac{⟨\\operatorname{cos}⁡(2x),\\operatorname{cos}⁡(2x)⟩}{⟨f(x),\\operatorname{sin}⁡(2x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-c5c81524-f03c-5663-8642-d4fa1374adc2" :answer/id #uuid "c5c81524-f03c-5663-8642-d4fa1374adc2" :answer/type :answer.type/math :answer/value "\\frac{⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩}{⟨f(x),\\operatorname{sin}⁡(2x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-a8d0730b-a30e-549