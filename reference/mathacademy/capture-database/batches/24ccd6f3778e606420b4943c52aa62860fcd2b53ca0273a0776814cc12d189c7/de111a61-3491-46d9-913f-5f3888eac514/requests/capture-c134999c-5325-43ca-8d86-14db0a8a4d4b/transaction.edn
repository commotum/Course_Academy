de-27c4-5ab6-921a-69c922b3ddd0" :answer/id #uuid "1eededde-27c4-5ab6-921a-69c922b3ddd0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-ec722ee2-a7c4-5b69-bb9e-dbec3b88f301" :answer/id #uuid "ec722ee2-a7c4-5b69-bb9e-dbec3b88f301" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186234483 :question/answer-fields ["answer-field-0a6695ee-b357-51dc-b26f-ab87cc005be3"] :db/ensure [:question/validate]} {:db/id "answer-field-0a6695ee-b357-51dc-b26f-ab87cc005be3" :answer-field/id #uuid "0a6695ee-b357-51dc-b26f-ab87cc005be3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a6248731-39c4-573a-bae9-7c33dde12c34" :answer-field/choices ["answer-70637956-2895-5e59-9c04-34a4660e4308" "answer-2126c568-9edc-5343-a977-03add492c720" "answer-a6248731-39c4-573a-bae9-7c33dde12c34" "answer-87d28730-c006-5e79-9d89-80cc3de93d6a" "answer-dfca70aa-c78a-5ad6-9130-294f9083ee33"] :db/ensure [:answer-field/validate]} {:db/id "answer-70637956-2895-5e59-9c04-34a4660e4308" :answer/id #uuid "70637956-2895-5e59-9c04-34a4660e4308" :answer/type :answer.type/math :answer/value "x=-7" :db/ensure [:answer/validate]} {:db/id "answer-2126c568-9edc-5343-a977-03add492c720" :answer/id #uuid "2126c568-9edc-5343-a977-03add492c720" :answer/type :answer.type/math :answer/value "x=13" :db/ensure [:answer/validate]} {:db/id "answer-a6248731-39c4-573a-bae9-7c33dde12c34" :answer/id #uuid "a6248731-39c4-573a-bae9-7c33dde12c34" :answer/type :answer.type/math :answer/value "x=17" :db/ensure [:answer/validate]} {:db/id "answer-87d28730-c006-5e79-9d89-80cc3de93d6a" :answer/id #uuid "87d28730-c006-5e79-9d89-80cc3de93d6a" :answer/type :answer.type/math :answer/value "x=\\pm 15" :db/ensure [:answer/validate]} {:db/id "answer-dfca70aa-c78a-5ad6-9130-294f9083ee33" :answer/id #uuid "dfca70aa-c78a-5ad6-9130-294f9083ee33" :answer/type :answer.type/text :answer/value "The function has no root" :db/ensure [:answer/validate]} {:db/id 17592186087856 :knowledge-point/questions ["question-5db961df-fac4-59ee-a59e-6595583c0931"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5db961df-fac4-59ee-a59e-6595583c0931" :question/id #uuid "5db961df-fac4-59ee-a59e-6595583c0931" :question/math-academy-id "q-112756" :question/problem "Suppose $f(x)=a{x}^{3}-2{x}^{2}+bx+1$ has a factor of $(x-1)$ and has a remainder of $4$ when divided by $(x+2).$ Find the value of $a-b.$" :question/worked-solution "Since $(x-1)$ is a factor of $f(x)$, it must divide into $f(x)$ with no remainder. In other words, when $f(x)$ is divided by $(x-1),$ the remainder is $0.$ It follows from the remainder theorem that\n\n$$\n\\begin{aligned}0 & =f(1) \\\\  & =a(1)^{3}-2(1)^{2}+b(1)+1 \\\\  & =a-2+b+1 \\\\  & =a+b-1.\\end{aligned}\n$$\n\nLikewise, since we're told that the remainder is $4$ when $f(x)$ is divided by $(x+2),$ it follows from the remainder theorem that\n\n$$\n\\begin{aligned}4 & =f(-2) \\\\  & =a(-2)^{3}-2(-2)^{2}+b(-2)+1 \\\\  & =-8a-8-2b+1 \\\\  & =-8a-2b-7.\\end{aligned}\n$$\n\nWe now have the system of equations\n\n$$\n\\{\\begin{aligned}0=a+b-1 \\\\ 4=-8a-2b-7.\\end{aligned}\n$$\n\nSimplifying each equation, we get\n\n$$\n\\{\\begin{aligned}a+b=1 \\\\ 8a+2b=-11.\\end{aligned}\n$$\n\nTo eliminate $b,$ we multiply the first equation by $-2,$ and we add the resulting equation to the second equation. So we get\n\n$$\n\\begin{aligned} & -2a-2b=-2 \\\\ +\\,\\,\\, & \\,8a+2b=-11 \\\\  & \\,6a=-13.\\end{aligned}\n$$\n\nSo, we get $a=-\\frac{13}{6}.$ Finally, we substitute it into $a+b=1$ to find $b=\\frac{19}{6}.$ \n\nTherefore, our final solution is $a-b=-\\frac{16}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-770121c3-2cf2-5300-81b4-eb965c9cabaa"] :db/ensure [:question/validate]} {:db/id "answer-field-770121c3-2cf2-5300-81b4-eb965c9cabaa" :answer-field/id #uuid "770121c3-2cf2-5300-81b4-eb965c9cabaa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8bab351c-3d65-5fe3-9013-2a0e5d4247ea" :answer-field/choices ["answer-8bab351c-3d65-5fe3-9013-2a0e5d4247ea" "answer-9a53dd5a-69f1-5a67-8fc6-fee88e884332" "answer-8c0e57d9-947f-577b-9e25-695901eeae8d" "answer-52ccfcd0-dfef-547c-9767-ca8b5f2e8bad" "answer-3f4c8461-b983-5195-b309-a1fd4f447236"] :db/ensure [:answer-field/validate]} {:db/id "answer-8bab351c-3d65-5fe3-9013-2a0e5d4247ea" :answer/id #uuid "8bab351c-3d65-5fe3-9013-2a0e5d4247ea" :answer/type :answer.type/math :answer/value "-\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9a53dd5a-69f1-5a67-8fc6-fee88e884332" :answer/id #uuid "9a53dd5a-69f1-5a67-8fc6-fee88e884332" :answer/type :answer.type/math :answer/value "-\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-8c0e57d9-947f-577b-9e25-695901eeae8d" :answer/id #uuid "8c0e57d9-947f-577b-9e25-695901eeae8d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-52ccfcd0-dfef-547c-9767-ca8b5f2e8bad" :answer/id #uuid "52ccfcd0-dfef-547c-9767-ca8b5f2e8bad" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-3f4c8461-b983-5195-b309-a1fd4f447236" :answer/id #uuid "3f4c8461-b983-5195-b309-a1fd4f447236" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id 17592186233067 :question/worked-solution "*Method 1:*\n\nBy the definition, we have\n\n$$\n{f}^{′}(3)={lim}_{h\\to 0}\\frac{f(3+h)-f(3)}{h}.\n$$\n\nApplying this to $f(x)=10{x}^{2}$, we get\n\n$$\n\\begin{aligned}{f}^{′}(3) & ={lim}_{h\\to 0}(\\frac{10(3+h)^{2}-10(3)^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{90+60h+10{h}^{2}-90}{h}) \\\\  & ={lim}_{h\\to 0}(\\frac{60h+10{h}^{2}}{h}) \\\\  & ={lim}_{h\\to 0}(60+10h) \\\\  & =60+(0) \\\\  & =60.\\end{aligned}\n$$\n\n \n\n*Method 2:*\n\nBy the definition, we have\n\n$$\n{f}^{′}(3)={lim}_{x\\to 3}\\frac{f(x)-f(3)}{x-3}.\n$$\n\nApplying this to $f(x)=10{x}^{2}$, we get\n\n$$\n\\begin{aligned}{f}^{′}(3) & ={lim}_{x\\to 3}(\\frac{10{x}^{2}-10(3)^{2}}{x-3}) \\\\  & ={lim}_{x\\to 3}(\\frac{10({x}^{2}-{3}^{2})}{x-3}) \\\\  & ={lim}_{x\\to 3}(\\frac{10(x-3)(x+3)}{x-3}) \\\\  & ={lim}_{x\\to 3}10(x+3) \\\\  & =10(3+3) \\\\  & =60.\\end{aligned}\n$$" :question/answer-fields ["answer-field-1bf2afe7-a005-5071-84b9-bd40024ce506"] :db/ensure [:question/validate]} {:db/id "answer-field-1bf2afe7-a005-5071-84b9-bd40024ce506" :answer-field/id #uuid "1bf2afe7-a005-5071-84b9-bd40024ce506" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6db8fd27-a6bb-5d05-8c7a-556b2db63a39" :answer-field/choices ["answer-71a944ae-ff58-5447-8134-5585f04d64b8" "answer-b98cc99c-1897-5580-9a45-71a60760d8c5" "answer-10447d27-bbad-5243-827a-0ec88f52db0b" "answer-6db8fd27-a6bb-5d05-8c7a-556b2db63a39" "answer-d6da7332-d0ae-5c57-a840-c9de6058e7d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-71a944ae-ff58-5447-8134-5585f04d64b8" :answer/id #uuid "71a944ae-ff58-5447-8134-5585f04d64b8" :answer/type :answer.type/math :answer/value "{f}^{′}(3)=30" :db/ensure [:answer/validate]} {:db/id "answer-b98cc99c-1897-5580-9a45-71a60760d8c5" :answer/id #uuid "b98cc99c-1897-5580-9a45-71a60760d8c5" :answer/type :answer.type/math :answer/value "{f}^{′}(3)=40" :db/ensure [:answer/validate]} {:db/id "answer-10447d27-bbad-5243-827a-0ec88f52db0b" :answer/id #uuid "10447d27-bbad-5243-827a-0ec88f52db0b" :answer/type :answer.type/math :answer/value "{f}^{′}(3)=48" :db/ensure [:answer/validate]} {:db/id "answer-6db8fd27-a6bb-5d05-8c7a-556b2db63a39" :answer/id #uuid "6db8fd27-a6bb-5d05-8c7a-556b2db63a39" :answer/type :answer.type/math :answer/value "{f}^{′}(3)=60" :db/ensure [:answer/validate]} {:db/id "answer-d6da7332-d0ae-5c57-a840-c9de6058e7d8" :answer/id #uuid "d6da7332-d0ae-5c57-a840-c9de6058e7d8" :answer/type :answer.type/math :answer/value "{f}^{′}(3)=72" :db/ensure [:answer/validate]} {:db/id 17592186234168 :question/problem "Express $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$ in terms of a reference angle." :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n(\\frac{7\\pi }{10})\\cdot (\\frac{{180}^{∘}}{\\pi })={126}^{∘}.\n$$\n\nTherefore $\\frac{7\\pi }{10}$ is equivalent to ${126}^{∘},$ which lies in the $2\\text{nd}$ quadrant.\n\n![](images/89/89b5e2656378adb5d91c9f58c261e4beaae252b67819b904bf209f6ed8a5a25e.png)\n\nTo express $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$ in terms of $\\operatorname{cot}⁡{\\theta }_{R},$ we follow three steps:\n\n1\\. Find its reference angle ${\\theta }_{R}.$\n\n2\\. Calculate the value of the function for ${\\theta }_{R}.$\n\n3\\. Determine whether the resulting value is positive or negative.\n\n**Step 1**: Since $\\theta =\\frac{7\\pi }{10}$ is in the $2$nd quadrant, the reference angle ${\\theta }_{R}$ is\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\pi -\\theta  \\\\  & =\\pi -\\frac{7\\pi }{10} \\\\  & =\\frac{3\\pi }{10}.\\end{aligned}\n$$\n\n**Step 2**: The given ratio is $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$, and therefore we're interested in $\\operatorname{cot}⁡{\\theta }_{R}=\\operatorname{cot}⁡(\\frac{3\\pi }{10}).$\n\n**Step 3:** The ratio $\\operatorname{cot}⁡(\\frac{7\\pi }{10})$ must be negative because tangent (and therefore cotangent) is always negative in the $2$nd quadrant. Therefore,\n\n$$\n\\operatorname{cot}⁡(\\frac{7\\pi }{10})=-\\operatorname{cot}⁡(\\frac{3\\pi }{10}).\n$$" :question/answer-fields ["answer-field-427c3f91-22fc-5c34-bf37-633a78d7c0ba"] :db/ensure [:question/validate]} {:db/id "answer-field-427c3f91-22fc-5c34-bf37-633a78d7c0ba" :answer-field/id #uuid "427c3f91-22fc-5c34-bf37-633a78d7c0ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ecf7300d-5c9b-5c16-914a-b75e51c21227" :answer-field/choices ["answer-ecf7300d-5c9b-5c16-914a-b75e51c21227" "answer-706750fb-a8db-5883-9866-c48f23ec7c80" "answer-82a50b38-647a-51f0-83dd-2e735fd413fb" "answer-767844f9-50f9-5d37-92c5-befa41f424fb" "answer-04b1019a-d92e-5d04-be9a-1a4844c6f0a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-ecf7300d-5c9b-5c16-914a-b75e51c21227" :answer/id #uuid "ecf7300d-5c9b-5c16-914a-b75e51c21227" :answer/type :answer.type/math :answer/value "-\\operatorname{cot}⁡(\\frac{3\\pi }{10})" :db/ensure [:answer/validate]} {:db/id "answer-706750fb-a8db-5883-9866-c48f23ec7c80" :answer/id #uuid "706750fb-a8db-5883-9866-c48f23ec7c80" :answer/type :answer.type/math :answer/value "-\\operatorname{cot}⁡(\\frac{7\\pi }{10})" :db/ensure [:answer/validate]} {:db/id "answer-82a50b38-647a-51f0-83dd-2e735fd413fb" :answer/id #uuid "82a50b38-647a-51f0-83dd-2e735fd413fb" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{3\\pi }{10})" :db/ensure [:answer/validate]} {:db/id "answer-767844f9-50f9-5d37-92c5-befa41f424fb" :answer/id #uuid "767844f9-50f9-5d37-92c5-befa41f424fb" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡(\\frac{3\\pi }{10})" :db/ensure [:answer/validate]} {:db/id "answer-04b1019a-d92e-5d04-be9a-1a4844c6f0a2" :answer/id #uuid "04b1019a-d92e-5d04-be9a-1a4844c6f0a2" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡(\\frac{7\\pi }{10})" :db/ensure [:answer/validate]} {:db/id 17592186233306 :question/problem "Find the value of $\\operatorname{sec}⁡0+\\operatorname{csc}⁡(\\frac{\\pi }{2}).$" :question/worked-solution "The angles $0$ and $\\frac{\\pi }{2}$ are quadrantal angles. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\n- Let's first consider the angle $0.$ From the unit circle, we see that the angle $0$ corresponds to the point $(1,0).$  Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡0=1.$ Therefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡0=\\frac{1}{\\operatorname{cos}⁡0}=\\frac{1}{1}=1.\n$$\n\n- Now, let's consider the angle $\\frac{\\pi }{2}.$ From the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$  Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1.$ Therefore, using the fact that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡(\\frac{\\pi }{2})=\\frac{1}{\\operatorname{sin}⁡(\\frac{\\pi }{2})}=\\frac{1}{1}=1.\n$$\n\nFinally, we get\n\n$$\n\\operatorname{sec}⁡0+\\operatorname{csc}⁡(\\frac{\\pi }{2})=1+1=2.\n$$" :question/answer-fields ["answer-field-5809f205-7813-519f-9ba7-8f909067fdec"] :db/ensure [:question/validate]} {:db/id "answer-field-5809f205-7813-519f-9ba7-8f909067fdec" :answer-field/id #uuid "5809f205-7813-519f-9ba7-8f909067fdec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7580ba1f-3abd-5900-907d-0ec7cc95376e" :answer-field/choices ["answer-346c7c5f-30ec-593f-bea5-24e469b9441b" "answer-a6855aa1-9c74-5c2d-8f0f-04a41e81ebd5" "answer-193f007a-0943-5ee4-b21d-1c12d8a9aa4c" "answer-7580ba1f-3abd-5900-907d-0ec7cc95376e" "answer-654bd16e-0fb9-537f-a166-1c6dfab5eb1d"] :db/ensure [:answer-field/validate]} {:db/id "answer-346c7c5f-30ec-593f-bea5-24e469b9441b" :answer/id #uuid "346c7c5f-30ec-593f-bea5-24e469b9441b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-a6855aa1-9c74-5c2d-8f0f-04a41e81ebd5" :answer/id #uuid "a6855aa1-9c74-5c2d-8f0f-04a41e81ebd5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-193f007a-0943-5ee4-b21d-1c12d8a9aa4c" :answer/id #uuid "1