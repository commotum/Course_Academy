nswer/id #uuid "8886309f-692e-500f-998c-a9b714ef0d0d" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id 17592186233966 :question/answer-fields ["answer-field-767f1526-f555-548a-8c1f-53ab5b15fedc"] :db/ensure [:question/validate]} {:db/id "answer-field-767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/id #uuid "767f1526-f555-548a-8c1f-53ab5b15fedc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer-field/choices ["answer-6c32fdae-9578-5230-9c6a-0030dc42ee0a" "answer-c408e350-5f98-5e07-beed-90e315ab7e7d" "answer-97224d93-ee75-5b28-87bf-a215b4d67a60" "answer-eb76173e-aa86-561d-80e6-1b55db1b9cdb" "answer-69df2f53-5c50-59ae-8338-33f06671b49c"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/id #uuid "6c32fdae-9578-5230-9c6a-0030dc42ee0a" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{y+3}+10}{y-1}" :db/ensure [:answer/validate]} {:db/id "answer-c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/id #uuid "c408e350-5f98-5e07-beed-90e315ab7e7d" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{y+3}+2}{y+1}" :db/ensure [:answer/validate]} {:db/id "answer-97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/id #uuid "97224d93-ee75-5b28-87bf-a215b4d67a60" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{y+3}-10}{y+7}" :db/ensure [:answer/validate]} {:db/id "answer-eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/id #uuid "eb76173e-aa86-561d-80e6-1b55db1b9cdb" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{y-3}+2}{y-1}" :db/ensure [:answer/validate]} {:db/id "answer-69df2f53-5c50-59ae-8338-33f06671b49c" :answer/id #uuid "69df2f53-5c50-59ae-8338-33f06671b49c" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{y-3}-10}{y-7}" :db/ensure [:answer/validate]} {:db/id 17592186234141 :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. Stretching with a stretch factor of $2$ in the $x$-direction and a stretch factor of $4$ in the $y$-direction\n\nII. Translation by $3$ units to the left and $4$ units upward\n\nIII. Dilation of scale factor $2$ with center $O,$ then reflection across the $y$-axis" :question/answer-fields ["answer-field-49c9f005-3956-54dc-a98f-72829d84a02e"] :db/ensure [:question/validate]} {:db/id "answer-field-49c9f005-3956-54dc-a98f-72829d84a02e" :answer-field/id #uuid "49c9f005-3956-54dc-a98f-72829d84a02e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2aa03d95-5c1e-5462-baea-44a0db21983a" :answer-field/choices ["answer-09685bcf-87c8-5820-be62-2079ad8b2fa9" "answer-b8e819db-c3b6-5287-aeeb-bc588fb737a5" "answer-487920ed-c0d8-5fef-8da2-dbe125c0490e" "answer-2aa03d95-5c1e-5462-baea-44a0db21983a" "answer-a1f3412f-dd4f-5295-8d3f-906cebe4d2ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-09685bcf-87c8-5820-be62-2079ad8b2fa9" :answer/id #uuid "09685bcf-87c8-5820-be62-2079ad8b2fa9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-b8e819db-c3b6-5287-aeeb-bc588fb737a5" :answer/id #uuid "b8e819db-c3b6-5287-aeeb-bc588fb737a5" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-487920ed-c0d8-5fef-8da2-dbe125c0490e" :answer/id #uuid "487920ed-c0d8-5fef-8da2-dbe125c0490e" :answer/type :answer.type/text :answer/value "I, II and III" :db/ensure [:answer/validate]} {:db/id "answer-2aa03d95-5c1e-5462-baea-44a0db21983a" :answer/id #uuid "2aa03d95-5c1e-5462-baea-44a0db21983a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-a1f3412f-dd4f-5295-8d3f-906cebe4d2ec" :answer/id #uuid "a1f3412f-dd4f-5295-8d3f-906cebe4d2ec" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186233293 :question/problem "$\\operatorname{sin}⁡(\\theta +{62}^{∘})=$" :question/worked-solution "We know that the cofunction of $\\operatorname{sin}⁡\\theta $ is $\\operatorname{cos}⁡\\theta ,$ and the angle complementary to $\\theta +{62}^{∘}$ is\n\n$$\n{90}^{∘}-(\\theta +{62}^{∘})={90}^{∘}-\\theta -{62}^{∘}={28}^{∘}-\\theta .\n$$\n\n So we have\n\n$$\n\\operatorname{sin}⁡(\\theta +{62}^{∘})=\\operatorname{cos}⁡({90}^{∘}-(\\theta +{62}^{∘}))=\\operatorname{cos}⁡({28}^{∘}-\\theta ).\n$$" :question/answer-fields ["answer-field-6df2773c-0b27-5748-b7a3-895628516a65"] :db/ensure [:question/validate]} {:db/id "answer-field-6df2773c-0b27-5748-b7a3-895628516a65" :answer-field/id #uuid "6df2773c-0b27-5748-b7a3-895628516a65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bcef4960-4cea-5205-b924-fe432441044d" :answer-field/choices ["answer-f8e51dd2-4683-56b2-b1fe-dba2254dfac5" "answer-bcef4960-4cea-5205-b924-fe432441044d" "answer-73514f22-423e-5c6d-b7a6-f17968101937" "answer-c8b86ad8-0c94-5ca9-9616-ccb1959bddfb" "answer-c3fd120c-71e9-5eb5-a646-d616f0a05430"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8e51dd2-4683-56b2-b1fe-dba2254dfac5" :answer/id #uuid "f8e51dd2-4683-56b2-b1fe-dba2254dfac5" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\theta +{28}^{∘})" :db/ensure [:answer/validate]} {:db/id "answer-bcef4960-4cea-5205-b924-fe432441044d" :answer/id #uuid "bcef4960-4cea-5205-b924-fe432441044d" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡({28}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-73514f22-423e-5c6d-b7a6-f17968101937" :answer/id #uuid "73514f22-423e-5c6d-b7a6-f17968101937" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡(\\theta +{28}^{∘})" :db/ensure [:answer/validate]} {:db/id "answer-c8b86ad8-0c94-5ca9-9616-ccb1959bddfb" :answer/id #uuid "c8b86ad8-0c94-5ca9-9616-ccb1959bddfb" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡(\\theta +{28}^{∘})" :db/ensure [:answer/validate]} {:db/id "answer-c3fd120c-71e9-5eb5-a646-d616f0a05430" :answer/id #uuid "c3fd120c-71e9-5eb5-a646-d616f0a05430" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡({28}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id 17592186078403 :knowledge-point/questions ["question-0821d791-2798-561e-8237-7b4aabdd155c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0821d791-2798-561e-8237-7b4aabdd155c" :question/id #uuid "0821d791-2798-561e-8237-7b4aabdd155c" :question/math-academy-id "q-35003" :question/problem "![](images/06/06e792c5b74eda036b55ac3728122737da22c9824f89f982b50657ab07391269.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above? \n\nI. ${lim}_{x\\to \\,0}f(x)=\\text{DNE}$\n\nII. ${lim}_{x\\to \\,1}f(x)=2$\n\nIII. ${lim}_{x\\to \\,1}f(x)={lim}_{x\\to \\,2}f(x)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. As $x$ approaches $0$ from the left and right we get\n\n$$\n{lim}_{x\\to \\,{0}^{-}}f(x)=0,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=1\\,.\n$$\n\n \nTherefore, ${lim}_{x\\to \\,{0}^{-}}f(x)\\ne {lim}_{x\\to \\,{0}^{+}}f(x),$ and hence ${lim}_{x\\to \\,0}f(x)=\\text{DNE}.$\n\n- Statement II is false. As $x$ approaches $1$ from the left and right we get\n\n$$\n{lim}_{x\\to \\,{1}^{-}}f(x)=2,\\,{lim}_{x\\to \\,{1}^{+}}f(x)=\\text{DNE}\\,.\n$$\n\n \nTherefore, ${lim}_{x\\to \\,{1}^{-}}f(x)\\ne {lim}_{x\\to \\,{1}^{+}}f(x),$ and hence ${lim}_{x\\to \\,1}f(x)=\\text{DNE}.$\n\n- Statement III is false. We see from the graph that \n\n$$\n{lim}_{x\\to \\,1}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,2}f(x)=\\text{DNE}\n$$\n\n We can't say that the limits are equal because we can't compare undefined values.\n\nIn conclusion, only statement I is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b5da9fec-9cf5-5ef3-8a64-44b81b106bd9"] :db/ensure [:question/validate]} {:db/id "answer-field-b5da9fec-9cf5-5ef3-8a64-44b81b106bd9" :answer-field/id #uuid "b5da9fec-9cf5-5ef3-8a64-44b81b106bd9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a92d27e-54b0-5d4c-9818-cfe70961fad6" :answer-field/choices ["answer-389fc1a2-a5ba-57bb-b0b8-1e8ad5cb1eb5" "answer-e9bb5d36-6be0-565e-a094-366239849940" "answer-7a92d27e-54b0-5d4c-9818-cfe70961fad6" "answer-15d8ad0d-a6a9-5c9d-8b4e-ece065c13c17" "answer-3c92e62b-f9d1-5567-ac76-513d8a2c9e83"] :db/ensure [:answer-field/validate]} {:db/id "answer-389fc1a2-a5ba-57bb-b0b8-1e8ad5cb1eb5" :answer/id #uuid "389fc1a2-a5ba-57bb-b0b8-1e8ad5cb1eb5" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-e9bb5d36-6be0-565e-a094-366239849940" :answer/id #uuid "e9bb5d36-6be0-565e-a094-366239849940" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7a92d27e-54b0-5d4c-9818-cfe70961fad6" :answer/id #uuid "7a92d27e-54b0-5d4c-9818-cfe70961fad6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-15d8ad0d-a6a9-5c9d-8b4e-ece065c13c17" :answer/id #uuid "15d8ad0d-a6a9-5c9d-8b4e-ece065c13c17" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-3c92e62b-f9d1-5567-ac76-513d8a2c9e83" :answer/id #uuid "3c92e62b-f9d1-5567-ac76-513d8a2c9e83" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186234200 :question/answer-fields ["answer-field-ce61e97b-bb14-57d6-aa01-271d52a76ac5"] :db/ensure [:question/validate]} {:db/id "answer-field-ce61e97b-bb14-57d6-aa01-271d52a76ac5" :answer-field/id #uuid "ce61e97b-bb14-57d6-aa01-271d52a76ac5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-daf2acf4-7be1-5ff4-8dae-a4d6fffc11f9" :answer-field/choices ["answer-db