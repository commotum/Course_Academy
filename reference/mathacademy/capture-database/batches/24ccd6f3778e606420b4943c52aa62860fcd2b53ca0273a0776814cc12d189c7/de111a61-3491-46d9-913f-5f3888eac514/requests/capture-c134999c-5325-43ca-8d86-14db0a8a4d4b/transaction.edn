58ac" :answer/id #uuid "e8ad6404-266a-54af-a78f-543ff14358ac" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-bf07614f-d15a-5062-80cc-4b44fbdc05d0" :answer/id #uuid "bf07614f-d15a-5062-80cc-4b44fbdc05d0" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-b68ba403-6a1c-5a91-9565-64d68e9cdbb7" :answer/id #uuid "b68ba403-6a1c-5a91-9565-64d68e9cdbb7" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "answer-1e2e40d7-3854-5e96-a861-a1a07ecb3a0a" :answer/id #uuid "1e2e40d7-3854-5e96-a861-a1a07ecb3a0a" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "answer-8951bc5c-f431-5ff4-a335-7c7928becd8e" :answer/id #uuid "8951bc5c-f431-5ff4-a335-7c7928becd8e" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id 17592186068810 :knowledge-point/questions ["question-671acf01-53e4-5ebe-ba29-cc75ccac1d67"] :db/ensure [:knowledge-point/validate]} {:db/id "question-671acf01-53e4-5ebe-ba29-cc75ccac1d67" :question/id #uuid "671acf01-53e4-5ebe-ba29-cc75ccac1d67" :question/math-academy-id "q-3414" :question/problem "Caden sold half of his comic books and then bought sixteen more. If he now has $36$, how many comic books did he have at the start?" :question/worked-solution "Let $x=$ the number of comic books Caden had at the start.\n\nWe note that:\n\n- Half the number of comic books corresponds to $\\frac{1}{2}x.$\n\n- The number of comic books remaining after selling half of them corresponds to $x-\\frac{1}{2}x.$\n\n- The number of comic books remaining after selling half and buying sixteen more corresponds to $x-\\frac{1}{2}x+16.$\n\nThe final number of comic books is $36,$ so we have the equation\n\n$$\nx-\\frac{1}{2}x+16=36.\n$$\n\nWe can solve this equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}x-\\frac{1}{2}x+16 & =36 \\\\ (1-\\frac{1}{2})x+16 & =36 \\\\ \\frac{1}{2}x+16 & =36 \\\\ \\frac{1}{2}x+16-16 & =36-16 \\\\ \\frac{1}{2}x & =20 \\\\ 2\\cdot \\frac{1}{2}x & =2\\cdot 20 \\\\ x & =40\\end{aligned}\n$$\n\nThus, Caden had $40$ comic books at the start." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fe515d97-b46e-5b25-875a-5d4729fa788a"] :db/ensure [:question/validate]} {:db/id "answer-field-fe515d97-b46e-5b25-875a-5d4729fa788a" :answer-field/id #uuid "fe515d97-b46e-5b25-875a-5d4729fa788a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a388a803-84bd-53e8-aa65-d13f7f96e425" :answer-field/choices ["answer-f32cdaeb-1435-578d-beb3-bd4b850bf04a" "answer-a2ea0f46-6409-5ea6-87af-ac98474c7f6d" "answer-8d542712-a993-5adf-89b6-a680649fc5ba" "answer-a388a803-84bd-53e8-aa65-d13f7f96e425" "answer-26b1ddc1-9435-5f7f-b5dd-42b065875b78"] :db/ensure [:answer-field/validate]} {:db/id "answer-f32cdaeb-1435-578d-beb3-bd4b850bf04a" :answer/id #uuid "f32cdaeb-1435-578d-beb3-bd4b850bf04a" :answer/type :answer.type/math :answer/value "104" :db/ensure [:answer/validate]} {:db/id "answer-a2ea0f46-6409-5ea6-87af-ac98474c7f6d" :answer/id #uuid "a2ea0f46-6409-5ea6-87af-ac98474c7f6d" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-8d542712-a993-5adf-89b6-a680649fc5ba" :answer/id #uuid "8d542712-a993-5adf-89b6-a680649fc5ba" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "answer-a388a803-84bd-53e8-aa65-d13f7f96e425" :answer/id #uuid "a388a803-84bd-53e8-aa65-d13f7f96e425" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-26b1ddc1-9435-5f7f-b5dd-42b065875b78" :answer/id #uuid "26b1ddc1-9435-5f7f-b5dd-42b065875b78" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id 17592186233504 :question/answer-fields ["answer-field-ec781e0d-5672-5d8a-a7d3-0b30ab64cffc"] :db/ensure [