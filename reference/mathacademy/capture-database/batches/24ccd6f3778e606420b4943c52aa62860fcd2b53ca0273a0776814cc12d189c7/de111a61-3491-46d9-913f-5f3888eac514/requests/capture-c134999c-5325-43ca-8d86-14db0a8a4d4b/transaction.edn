a2a9149c" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-d459b53f-1cde-5cb4-a70d-3e698301abf9" :answer/id #uuid "d459b53f-1cde-5cb4-a70d-3e698301abf9" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-73f077c3-f7dc-5e4b-b69b-312d30bce105" :answer/id #uuid "73f077c3-f7dc-5e4b-b69b-312d30bce105" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-56223238-871c-5059-a611-b22adabd18b8" :answer/id #uuid "56223238-871c-5059-a611-b22adabd18b8" :answer/type :answer.type/text :answer/value "Neither even nor odd" :db/ensure [:answer/validate]} {:db/id "answer-888c316d-cb0b-54ba-954c-a843ead762fd" :answer/id #uuid "888c316d-cb0b-54ba-954c-a843ead762fd" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id 17592186233682 :question/problem "Consider the frequency table below for a continuous variable $x.$ The total number of observations is $n=20,$ and the estimated sample mean is $\\overset{―}{x}≈13.5.$\n\n| Range | Frequency $({f}_{i})$ |\n| --- | --- |\n| $0\\le x<10$ | $8$ |\n| $10\\le x<20$ | $7$ |\n| $20\\le x<30$ | $5$ |\n\n$$\n\n$$\n\nUsing the midpoint of each class interval to approximate all observations within that class, estimate the standard deviation ${\\sigma }_{n},$ using $n$ as the denominator in the variance formula.\n\nRounded to one decimal place, ${\\sigma }_{n}≈$\n{{field-1}}" :question/worked-solution "Given a frequency table containing continuous data split into $K$ classes, we can estimate the variance by treating all observations within each class as though they were equal to the midpoint of that class. This gives\n\n$$\n{\\sigma }_{n}^{2}≈\\frac{1}{n}{\\sum }_{i=1}^{K}{f}_{i}\\cdot ({m}_{i}-\\overset{―}{x})^{2},\n$$\n\nwhere\n\n- ${f}_{i}$ is the frequency of the $i$th class,\n\n- ${m}_{i}$ is the midpoint of the $i$th class,\n\n- $n$ is the total number of observations, and\n\n- $\\overset{―}{x}$ is the estimated mean, calculated using the class midpoints.\n\nTo find the variance, we add columns to our table for the midpoints of each interval, the squared deviations of the midpoints from the mean, and the products of the squared deviations and frequencies.\n\n| Range | ${f}_{i}$ | ${m}_{i}$ | ${({m}_{i}-\\overset{―}{x})}^{2}$ | ${f}_{i}{({m}_{i}-\\overset{―}{x})}^{2}$ |\n| --- | --- | --- | --- | --- |\n| $0\\le x<10$ | $8$ | $5$ | $72.25$ | $578$ |\n| $10\\le x<20$ | $7$ | $15$ | $2.25$ | $15.75$ |\n| $20\\le x<30$ | $5$ | $25$ | $132.25$ | $661.25$ |\n\n$$\n\n$$\n\nThen, we divide the sum of all the values in the last column by $20$ (the total number of observations):\n\n$$\n\\begin{aligned}{\\sigma }_{n}^{2} & ≈\\frac{578+15.75+661.25}{20} \\\\  & =\\frac{1255}{20} \\\\  & =62.75\\end{aligned}\n$$\n\nFinally, the estimated standard deviation is the square root of the estimated variance:\n\n$$\n\\begin{aligned}{\\sigma }_{n} & ≈\\sqrt{62.75}≈7.9\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186232372 :answer-field/correct "answer-50cba50f-0215-54ad-96b6-a3d381b47f01" :answer-field/choices ["answer-50cba50f-0215-54ad-96b6-a3d381b47f01"] :db/ensure [:answer-field/validate]} {:db/id "answer-50cba50f-0215-54ad-96b6-a3d381b47f01" :answer/id #uuid "50cba50f-0215-54ad-96b6-a3d381b47f01" :answer/type :answer.type/math :answer/value "7.9" :db/ensure [:answer/validate]} {:db/id 17592186234163 :question/answer-fields ["answer-field-981ea52b-9e45-5858-a199-002953f70e37"] :db/ensure [:question/validate]} {:db/id "answer-field-981ea52b-9e45-5858-a199-002953f70e37" :answer-field/id #uuid "981ea52b-9e45-5858-a199-002953f70e37" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7e88750-2d2a-5ed0-bb69-82c918766691" :answer-field/choices ["answer-571aa39e-400a-5863-b676-0015f3b249cf" "answer-6e1bcd9e-18d9-5b81-bf60-b688fcd821e3" "answer-6fa661ae-e5a1-55f6-8a14-031daabbb4f0" "answer-a7e88750-2d2a-5ed0-bb69-82c918766691" "answer-106793da-24f7-59ed-8b62-e13cfc57d52f"] :db/ensure [:answer-field/validate]} {:db/id "answer-571aa39e-400a-5863-b676-0015f3b249cf" :answer/id #uuid "571aa39e-400a-5863-b676-0015f3b249cf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6e1bcd9e-18d9-5b81-bf60-b688fcd821e3" :answer/id #uuid "6e1bcd9e-18d9-5b81-bf60-b688fcd821e3" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-6fa661ae-e5a1-55f6-8a14-031daabbb4f0" :answer/id #uuid "6fa661ae-e5a1-55f6-8a14-031daabbb4f0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-a7e88750-2d2a-5ed0-bb69-82c918766691" :answer/id #uuid "a7e88750-2d2a-5ed0-bb69-82c918766691" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-106793da-24f7-59ed-8b62-e13cfc57d52f" :answer/id #uuid "106793da-24f7-59ed-8b62-e13cfc57d52f" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id 17592186234325 :question/problem "![](images/4c/4ce20d9d732816efda0a2fd3aebabc467f9f2c73d0b6037f4ad8f95d8e8ef1e7.png)\n\nRounded to the nearest integer, what is the area of the quadrilateral $ABCD?$" :question/worked-solution "The area of the quadrilateral $ABCD$ is the sum of the areas of the triangles $△ABD$ and $△BDC$ (see the illustration below).\n\n![](images/6e/6e070d26915bcb11118f5a23f36b80038d5dd865e32a8517a12c10939ca02f0b.png)\n\nFirst, we find the area of $△ABD:$\n\n$$\n\\begin{aligned}{A}_{ABD} & =\\frac{1}{2}\\cdot 6\\cdot 8\\cdot \\operatorname{sin}⁡{85}^{∘} \\\\  & =24\\cdot \\operatorname{sin}⁡{85}^{∘} \\\\  & ≈23.908\\,7,\\end{aligned}\n$$\n\nrounded to four decimal places.\n\nNow we find the area of $△BCD:$\n\n$$\n\\begin{aligned}{A}_{BCD} & =\\frac{1}{2}\\cdot 14\\cdot 16\\cdot \\operatorname{sin}⁡{36.4}^{∘} \\\\  & =112\\cdot \\operatorname{sin}⁡{36.4}^{∘} \\\\  & ≈66.462\\,9,\\end{aligned}\n$$\n\nrounded to four decimal places.\n\nFinally, we add together the areas of our two triangles to determine the area of $ABCD:$\n\n$$\n\\begin{aligned}{A}_{ABCD} & ={A}_{ABD}+{A}_{BCD} \\\\  & ≈23.908\\,7+66.462\\,9 \\\\  & ≈90.371\\,6.\\end{aligned}\n$$\n\nConsequently, to the nearest integer, the area of the quadrilateral $ABCD$ is $90.$" :question/answer-fields ["answer-field-a5f55799-fa35-55be-b5e7-23ed06c306d5"] :db/ensure [:question/validate]} {:db/id "answer-field-a5f55799-fa35-55be-b5e7-23ed06c306d5" :answer-field/id #uuid "a5f55799-fa35-55be-b5e7-23ed06c306d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-992ff176-6fda-5a2c-8659-55baf90a83fa" :answer-field/choices ["answer-ea211255-4798-55dc-866b-aae486ca03e7" "answer-af6bec52-f2b1-55fa-890f-584e44e51b59" "answer-c3294de8-305e-5066-b9e4-7eebd339a6e5" "answer-02e1a207-f9d0-53f3-b9be-3206f74c6704" "answer-992ff176-6fda-5a2c-8659-55baf90a83fa"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea211255-4798-55dc-866b-aae486ca03e7" :answer/id #uuid "ea211255-4798-55dc-866b-aae486ca03e7" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-af6bec52-f2b1-55fa-890f-584e44e51b59" :answer/id #uuid "af6bec52-f2b1-55fa-890f-584e44e51b59" :answer/type :answer.type/math :answer/value "61" :db/ensure [:answer/validate]} {:db/id "answer-c3294de8-305e-5066-b9e4-7eebd339a6e5" :answer/id #uuid "c3294de8-305e-5066-b9e4-7eebd339a6e5" :answer/type :answer.type/math :answer/value "78" :db/ensure [:answer/validate]} {:db/id "answer-02e1a207-f9d0-53f3-b9be-3206f74c6704" :answer/id #uuid "02e1a207-f9d0-53f3-b9be-3206f74c6704" :answer/type :answer.type/math :answer/value "85" :db/ensure [:answer/validate]} {:db/id "answer-992ff176-6fda-5a2c-8659-55baf90a83fa" :answer/id #uuid "992ff176-6fda-5a2c-8659-55baf90a83fa" :answer/type :answer.