00)^{2} \\\\  & =8\\,590-8\\,000 \\\\  & =590.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-101037bb-1cdc-5f57-adda-e1f24aa1b97f"] :db/ensure [:question/validate]} {:db/id "answer-field-101037bb-1cdc-5f57-adda-e1f24aa1b97f" :answer-field/id #uuid "101037bb-1cdc-5f57-adda-e1f24aa1b97f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a2dd6fd3-36d2-5d1e-bf27-1912d3b0ed19" :answer-field/choices ["answer-a2dd6fd3-36d2-5d1e-bf27-1912d3b0ed19"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2dd6fd3-36d2-5d1e-bf27-1912d3b0ed19" :answer/id #uuid "a2dd6fd3-36d2-5d1e-bf27-1912d3b0ed19" :answer/type :answer.type/math :answer/value "590" :db/ensure [:answer/validate]} {:db/id "question-42fccfda-10de-5970-a9ed-3564137d6e6d" :question/id #uuid "42fccfda-10de-5970-a9ed-3564137d6e6d" :question/math-academy-id "q-251893" :question/problem "Consider two sets of $28$ paired observations ${x}_{1},{x}_{2},…,{x}_{28},$ and ${y}_{1},{y}_{2},…,{y}_{28}.$ You are given that\n\n$$\n\\begin{aligned} & {\\sum }_{i=1}^{28}{x}_{i}=560,\\,{\\sum }_{i=1}^{28}{y}_{i}=588, \\\\  & {\\sum }_{i=1}^{28}{x}_{i}^{2}=10\\,920,\\,{\\sum }_{i=1}^{28}{y}_{i}^{2}=13\\,220.\\end{aligned}\n$$\n\nCalculate the sum of the squared deviations from the mean for the points ${y}_{i}.$\n\n${S}_{yy}=$\n{{field-1}}" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of squared deviations from the mean for the data ${y}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{yy} & ={\\sum }_{i=1}^{n}({y}_{i}-\\overset{―}{y})^{2} \\\\  & ={\\sum }_{i}{y}_{i}^{2}-\\frac{1}{n}{({\\sum }_{i=1}^{n}{y}_{i})}^{2}\\end{aligned}\n$$\n\nSubstituting the given statistics in the above formula, we get\n\n$$\n\\begin{aligned}{S}_{yy} & =13\\,220-\\frac{1}{28}(588)^{2} \\\\  & =13\\,220-12\\,348 \\\\  & =872.\\end{aligned}\n$$" :