4e35f3" :answer/id #uuid "04fbd209-c2ac-5a44-9ef5-0a4c864e35f3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186234105 :question/worked-solution "The function $N(t)$ gives the number of people inside the park $t$ minutes after opening. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of people inside the park changes $t$ minutes after opening.\n\nIn addition, we can compute the rate of change of the number of people inside the park at time $t$ by finding the difference between the entry and exit rates at time $t.$ That is,\n\n$$\n{N}^{′}(t)=E(t)-L(t).\n$$" :question/answer-fields ["answer-field-1ee88502-7069-5e01-a8d0-c684a215ef26"] :db/ensure [:question/validate]} {:db/id "answer-field-1ee88502-7069-5e01-a8d0-c684a215ef26" :answer-field/id #uuid "1ee88502-7069-5e01-a8d0-c684a215ef26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1d31616-58ba-5787-a9be-a1cfe9d0322c" :answer-field/choices ["answer-a912d151-5821-56b2-bfc3-6a30d519da07" "answer-0ef1b856-e606-5faf-bc81-d441b2fbfdf2" "answer-cafddae2-e99e-570b-af04-9b580b7a3489" "answer-f1d31616-58ba-5787-a9be-a1cfe9d0322c" "answer-59459bbc-bff1-5a8f-9a50-e6ffa451c3d0"] :db/ensure [:answer-field/validate]} {:db/id "answer-a912d151-5821-56b2-bfc3-6a30d519da07" :answer/id #uuid "a912d151-5821-56b2-bfc3-6a30d519da07" :answer/type :answer.type/math :answer/value "N(t)=E(t)+L(t)" :db/ensure [:answer/validate]} {:db/id "answer-0ef1b856-e606-5faf-bc81-d441b2fbfdf2" :answer/id #uuid "0ef1b856-e606-5faf-bc81-d441b2fbfdf2" :answer/type :answer.type/math :answer/value "N(t)=E(t)-L(t)" :db/ensure [:answer/validate]} {:db/id "answer-cafddae2-e99e-570b-af04-9b580b7a3489" :answer/id #uuid "cafddae2-e99e-570b-af04-9b580b7a3489" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=E(t)+L(t)" :db/ensure [:answer/validate]} {:db/id "answer-f1d31616-58ba-5787-a9be-a1cfe9d0322c" :answer/id #uuid "f1d31616-58ba-5787-a9be-a1cfe9d0322c" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=E(t)-L(t)" :db/ensure [:answer/validate]} {:db/id "answer-59459bbc-bff1-5a8f-9a50-e6ffa451c3d0" :answer/id #uuid "59459bbc-bff1-5a8f-9a50-e6ffa451c3d0" :answer/type :answer.type/math :answer/value "{N}^{′}(t)=E(t)\\cdot L(t)" :db/ensure [:answer/validate]} {:db/id 17592186234083 :question/answer-fields ["answer-field-2311da2e-4f69-5b66-a303-9fcae05b36b3"] :db/ensure [:question/validate]} {:db/id "answer-field-2311da2e-4f69-5b66-a303-9fcae05b36b3" :answer-field/id #uuid "2311da2e-4f69-5b66-a303-9fcae05b36b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dbafea93-c3c1-5c81-95ea-a42523faec59" :answer-field/choices ["answer-dbafea93-c3c1-5c81-95ea-a42523faec59" "answer-004fb43a-8a3c-5d57-8932-47e0fe4aee15" "answer-c403ef6b-b382-5306-92d4-4c26b3f05c2b" "answer-4d853c4b-ff54-546b-bb02-2311564ce7a2" "answer-e6d3b420-0896-5d50-a950-480cffd7a14e"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbafea93-c3c1-5c81-95ea-a42523faec59" :answer/id #uuid "dbafea93-c3c1-5c81-95ea-a42523faec59" :answer/type :answer.type/math :answer/value "-\\frac{2}{5\\sqrt[5]{{x}^{7}}}" :db/ensure [:answer/validate]} {:db/id "answer-004fb43a-8a3c-5d57-8932-47e0fe4aee15" :answer/id #uuid "004fb43a-8a3c-5d57-8932-47e0fe4aee15" :answer/type :answer.type/math :answer/value "-\\frac{2}{5\\sqrt[7]{{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "answer-c403ef6b-b382-5306-92d4-4c26b3f05c2b" :answer/id #uuid "c403ef6b-b382-5306-92d4-4c26b3f05c2b" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}\\sqrt[7]{{x}^{5}}" :db/ensure [:answer/validate]} {:db/id "answer-4d853c4b-ff54-546b-bb02-2311564ce7a2" :answer/id #uuid "4d853c4b-ff54-546b-bb02-2311564ce7a2" :answer/type :answer.type/math :answer/value "\\frac{5}{2}\\sqrt[5]{{x}^{7}}" :db/ensure [:answer/validate]} {:db/id "answer-e6d3b420-0896-5d50-a950-480cffd7a14e" :answer/id #uuid "e6d3b420-0896-5d50-a950-480cffd7a14e" :answer/type :answer.type/math :answer/value "\\frac{7}{5\\sqrt[5]{{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id 17592186233276 :question/answer-fields ["answer-field-5749cf60-a3f1-5876-9c2b-03d5d66464f0"] :db/ensure [:question/validate]} {:db/id "answer-field-5749cf60-a3f1-5876-9c2b-03d5d66464f0" :answer-field/id #uuid "5749cf60-a3f1-5876-9c2b-03d5d66464f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9b35183a-e748-54ed-8dd3-0bcbe740b891" :answer-field/choices ["answer-4bf6d318-67a3-589f-aa06-712a4c979552" "answer-8a9a8734-2fa1-5cd5-97d6-c6ffcae6ba4c" "answer-ed844729-fa98-5650-835d-6732a8a4b167" "answer-9b35183a-e748-54ed-8dd3-0bcbe740b891" "answer-5466b133-5ea5-525f-8cd7-1a549d321d24"] :db/ensure [:answer-field/validate]} {:db/id "answer-4bf6d318-67a3-589f-aa06-712a4c979552" :answer/id #uuid "4bf6d318-67a3-589f-aa06-712a4c979552" :answer/type :answer.type/math :answer/value "2(m+n)" :db/ensure [:answer/validate]} {:db/id "answer-8a9a8734-2fa1-5cd5-97d6-c6ffcae6ba4c" :answer/id #uuid "8a9a8734-2fa1-5cd5-97d6-c6ffcae6ba4c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(m+n)" :db/ensure [:answer/validate]} {:db/id "answer-ed844729-fa98-5650-835d-6732a8a4b167" :answer/id #uuid "ed844729-fa98-5650-835d-6732a8a4b167" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{17}}(m+n)" :db/ensure [:answer/validate]} {:db/id "answer-9b35183a-e748-54ed-8dd3-0bcbe740b891" :answer/id #uuid "9b35183a-e748-54ed-8dd3-0bcbe740b891" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt{17}}(m+n)" :db/ensure [:answer/validate]} {:db/id "answer-5466b133-5ea5-525f-8cd7-1a549d321d24" :answer/id #uuid "5466b133-5ea5-525f-8cd7-1a549d321d24" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt{2}}(m+n)" :db/ensure [:answer/validate]} {:db/id 17592186234280 :question/worked-solution "Let $f(x)=6\\sqrt{x}+5x-13.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(6\\sqrt{x}+5x-13) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(6{x}^{1/2}+5x) \\\\  & =3{x}^{-1/2}+5\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(1)=3(1)^{-1/2}+5=8.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =8(x-1) \\\\ y & =8x-8-2 \\\\ y & =8x-10.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =8x-10 \\\\ x & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(\\frac{5}{4},0).$" :question/answer-fields ["answer-field-2f3486a1-cfa1-570d-be9b-887c8a18ac0b"] :db/ensure [:question/validate]} {:db/id "answer-field-2f3486a1-cfa1-570d-be9b-887c8a18ac0b" :answer-field/id #uuid "2f3486a1-cfa1-570d-be9b-887c8a18ac0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-63c9374b-d37c-56a0-a295-21e6bccf14d3" :answer-field/choices ["answer-b96971bd-8297-5518-aab6-d9a19486e8f6" "answer-4ed8aa18-f23e-5179-83b5-62f4300a01d4" "answer-50ff8cf1-00c5-5be3-8b99-91abe28049cc" "answer-76efb7a8-362e-53ed-a7a6-f85bdf02a95f" "answer-63c9374b-d37c-56a0-a295-21e6bccf14d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b96971bd-8297-5518-aab6-d9a19486e8f6" :answer/id #uuid "b96971bd-8297-5518-aab6-d9a19486e8f6" :answer/type :answer.type/math :answer/value "(-\\frac{5}{4},0)" :db/ensure [:answer/validate]} {:db/id "answer-4ed8aa18-f23e-5179-83b5-62f4300a01d4" :answer/id #uuid "4ed8aa18-f23e-5179-83b5-62f4300a01d4" :answer/type :answer.type/math :answer/value "(0,-\\frac{5}{4})" :db/ensure [:answer/validate]} {:db/id "answer-50ff8cf1-00c5-5be3-8b99-91abe28049cc" :answer/id #uuid "50ff8cf1-00c5-5be3-8b99-91abe28049cc" :answer/type :answer.type/math :answer/value "(4,0)" :db/ensure [:answer/validate]} {:db/id "answer-76efb7a8-362e-53ed-a7a6-f85bdf02a95f" :answer/id #uuid "76efb7a8-362e-53ed-a7a6-f85bdf02a95f" :answer/type :answer.type/math :answer/value "(5,0)" :db/ensure [:answer/validate]} {:db/id "answer-63c9374b-d37c-56a0-a295-21e6bccf14d3" :answer/id #uuid "63c9374b-d37c-56a0-a295-21e6bccf14d3" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},0)" :db/ensure [:answer/validate]} {:db/id "question-5f3a9a12-37bd-5534-bce9-24153ef1f5e3" :question/id #uuid "5f3a9a12-37bd-5534-bce9-24153ef1f5e3" :question/math-academy-id "q-66857" :question/problem "$\\frac{1}{2}\\operatorname{ln}⁡(\\sqrt[4]{e})=$" :question/worked-solution "First, we rewrite $\\sqrt[4]{e}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\sqrt[4]{e}={e}^{1/4}\n$$\n\nTherefore, we have:\n\n$$\n\\frac{1}{2}\\operatorname{ln}⁡(\\sqrt[4]{e})=\\frac{1}{2}\\operatorname{ln}⁡({e}^{1/4})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=\\frac{1}{4}.$ Therefore:\n\n$$\n\\frac{1}{2}\\operatorname{ln}⁡({e}^{1/4})=\\frac{1}{2}\\cdot \\frac{1}{4}=\\frac{1}{8}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f1f049c7-00fd-5d21-8330-9fbecd737783"] :db/ensure [:question/validate]} {:db/id "answer-field-f1f049c7-00fd-5d21-8330-9fbecd737783" :answer-field/id #uuid "f1f049c7-00fd-5d21-8330-9fbecd737783" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8511cc21-378c-5a60-9221-6fb771890a90" :answer-field/choices ["answer-b219a9cf-83fc-5cad-a42c-df24894c4cbe" "answer-4dc31748-131c-5761-b87b-12c70e2700fd" "answer-ffe0d590-58c4-5faf-8679-f3cf76a7cea1" "answer-f6bf7bc9-83ae-5185-89c3-ff3999355ed7" "answer-8511cc21-378c-5a60-9221-6fb771890a90"] :db/ensure [:answer-field/validate]} {:db/id "answer-b219a9cf-83fc-5cad-a42c-df24894c4cbe" :answer/id #uuid "b219a9cf-83fc-5cad-a42c-df24894c4cbe" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-4dc31748-131c-5761-b87b-12c70e2700fd" :answer/id #uuid "4dc31748-131c-5761-b87b-12c70e2700fd" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ffe0d590-58c4-5faf-8679-f3cf76a7cea1" :answer/id #uuid "ffe0d590-58c4-5faf-8679-f3cf76a7cea1" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-f6bf7bc9-83ae-5185-89c3-ff3999355ed7" :answer/id #uuid "f6bf7bc9-83ae-5185-89c3-ff3999355ed7" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-8511cc21-378c-5a60-9221-6fb771890a90" :answer/id #uuid "8511cc21-378c-5a60-9221-6fb771890a90" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "question-7e50efe9-568f-54f5-835e-03a6e09d3518" :question/id #uuid "7e50efe9-568f-54f5-835e-03a6e09d3518" :question/math-academy-id "q-34313" :question/problem "![](images/23/23f0dba237502bc7261fd8f28327beefd5872bb4b0f503930c488b2857fcef24.png)\n\nGiven that the point $A$ has coordinates $(-\\sqrt{3},-1),$ calculate the angle $\\theta .$" :question/worked-solution "We can form a triangle by creating a vertical line from $A$ to the $x$-axis. Let us call ${\\theta }^{′}$ the acute angle that is formed with the $x$-axis such that ${\\theta }^{′}+{180}^{∘}=\\theta $\n\n![](images/d1/d14f62179f831ebdc177eac7bd2899679864305d4104d4b61f304eb4fa9e133d.png)\n\nUsing the tangent ratio, we have\n\n$$\n\\operatorname{tan}⁡{\\theta }^{′}=\\frac{1}{\\sqrt{3}}=\\frac{\\sqrt{3}}{3}.\n$$\n\nFinally, using the inverse tangent, we get\n\n$$\n{\\theta }^{′}=\\operatorname{arctan}⁡\\frac{\\sqrt{3}}{3}={30}^{∘}.\n$$\n\nFinally, using $\\theta ={\\theta }^{′}+{180}^{∘},$ we get $\\theta ={30}^{∘}+{180}^{∘}={210}^{∘}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8eecf4b6-4798-5f08-9a2c-b96119d1c2e2"] :db/ensure [:question/validate]} {:db/id "answer-field-8eecf4b6-4798-5f08-9a2c-b96119d1c2e2" :answer-field/id #uuid "8eecf4b6-4798-5f08-9a2c-b96119d1c2e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1453fd1b-3ee6-55e4-87aa-1fe26fc47d07" :answer-field/choices ["answer-33f89d2b-d7fe-5ded-8d87-7f20aa7f2159" "answer-07fc1d0e-4b4b-5938-884e-27a158d44eee" "answer-1453fd1b-3ee6-55e4-87aa-1fe26fc47d07" "answer-048aac5a-0f26-5bb2-8fc3-e1525f3c52a2" "answer-659ef10a-f223-514c-a277-cdc5f9c36beb"] :db/ensure [:answer-field/validate]} {:db/id "answer-33f89d2b-d7fe-5ded-8d87-7f20aa7f2159" :answer/id #uuid "33f89d2b-d7fe-5ded-8d87-7f20aa7f2159" :answer/type :answer.type/math :answer/value "{190}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-07fc1d0e-4b4b-5938-884e-27a158d44eee" :answer/id #uuid "07fc1d0e-4b4b-5938-884e-27a158d44eee" :answer/type :answer.type/math :answer/value "{200}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-1453fd1b-3ee6-55e4-87aa-1fe26fc47d07" :answer/id #uuid "1453fd1b-3ee6-55e4-87aa-1fe26fc47d07" :answer/type :answer.type/math :answer/value "{210}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-048aac5a-0f26-5bb2-8fc3-e1525f3c52a2" :answer/id #uuid "048aac5a-0f26-5bb2-8fc3-e1525f3c52a2" :answer/type :answer.type/math :answer/value "{220}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-659ef10a-f223-514c-a277-cdc5f9c36beb" :answer/id #uuid "659ef10a-f223-514c-a277-cdc5f9c36beb" :answer/type :answer.type/math :answer/value "{230}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186133780 :knowledge-point/questions ["question-1b5b5791-1037-533d-a2f0-5ffb4bac0dd8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1b5b5791-1037-533d-a2f0-5ffb4bac0dd8" :question/id #uuid "1b5b5791-1037-533d-a2f0-5ffb4bac0dd8" :question/math-academy-id "q-140469" :question/problem "Find ${H}^{⊥}$ if $H=\\text{Span}\\{[\\begin{aligned}-4 \\\\ 7\\end{aligned}],[\\begin{aligned}8 \\\\ -14\\end{aligned}]\\}.$" :question/worked-solution "Let's denote the vectors that span the subspace $H$ as ${h}_{1}$ and ${h}_{2}.$ \n\nA vector $x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ belongs to ${H}^{⊥}$ if $x\\cdot {h}_{1}=0$ and $x\\cdot {h}_{2}=0.$ So, we need to solve the following system:\n\n$$\n\\{\\begin{aligned}x\\cdot {h}_{1}=0 \\\\ x\\cdot {h}_{2}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-4{x}_{1}+7{x}_{2}=0 \\\\ 8{x}_{1}-14{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-4 & 7 & 0 \\\\ 8 & -14 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-4 & 7 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $1$ pivot column (the $1$st one), so ${x}_{2}$ is a free variable. From the first equation, we get ${x}_{1}=\\frac{7}{4}{x}_{2}.$ So, the general solution is\n\n$$\n[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, our orthogonal complement is\n\n$$\n{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-356e4ab9-2091-593a-99dd-55afcb98c941"] :db/ensure [:question/validate]} {:db/id "answer-field-356e4ab9-2091-593a-99dd-55afcb98c941" :answer-field/id #uuid "356e4ab9-2091-593a-99dd-55afcb98c941" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce3b37a3-f596-55cd-9709-b88fbdabcc2f" :answer-field/choices ["answer-bd28a383-d220-5ede-95f6-48a1f6e0c3eb" "answer-23439808-c020-5fe6-9947-75475ae07c6c" "answer-ce3b37a3-f596-55cd-9709-b88fbdabcc2f" "answer-0fc41dc0-e625-54ec-935c-e2218ad7619b" "answer-a7a43a48-c5a3-5fe0-b7e7-03cf00683fb7"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd28a383-d220-5ede-95f6-48a1f6e0c3eb" :answer/id #uuid "bd28a383-d220-5ede-95f6-48a1f6e0c3eb" :answer/type :answer.type/math :answer/value "{H}^{⊥}=\\{[\\begin{aligned}-7{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-23439808-c020-5fe6-9947-75475ae07c6c" :answer/id #uuid "23439808-c020-5fe6-9947-75475ae07c6c" :answer/type :answer.type/math :answer/value "{H}^{⊥}=\\{[\\begin{aligned}-\\frac{7}{8}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-ce3b37a3-f596-55cd-9709-b88fbdabcc2f" :answer/id #uuid "ce3b37a3-f596-55cd-9709-b88fbdabcc2f" :answer/type :answer.type/math :answer/value "{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{4}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-0fc41dc0-e625-54ec-935c-e2218ad7619b" :answer/id #uuid "0fc41dc0-e625-54ec-935c-e2218ad7619b" :answer/type :answer.type/math :answer/value "{H}^{⊥}=\\{[\\begin{aligned}\\frac{7}{8}{x}_{2} \\\\ {x}_{2}\\end{aligned}]\\,:\\,{x}_{2}\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-a7a43a48-c5a3-5fe0-b7e7-03cf00683fb7" :answer/id #uuid "a7a43a48-c5a3-5fe0-b7e7-03cf00683fb7" :answer/type :answer.type/math :answer/value "{H}^{⊥}=\\{\\text{0}\\}" :db/ensure [:answer/validate]} {:db/id "activity-fadfdee6-b9d7-5ac9-b37e-51103fa03a0c" :activity/id #uuid "fadfdee6-b9d7-5ac9-b37e-51103fa03a0c" :activity/title "Orthogonal Complements" :activity/type :activity.type/review :activity/scope 17592186048613 :activity/course 17592186046658 :activity/steps ["step-26a546ba-54ab-5cc8-83e6-b006c83a2260" "step-5ab17b99-dd7c-5473-a02e-1887d75473a6" "step-b50cddb9-32fe-5feb-88b9-dbdd94647008" "step-b668892f-4bf5-5939-a70a-e3c5d414340b" "step-6102b09c-519b-52a5-908c-ac2692fae51a"] :activity/first-step "step-26a546ba-54ab-5cc8-83e6-b006c83a2260" :db/ensure [:activity/validate]} {:db/id "step-26a546ba-54ab-5cc8-83e6-b006c83a2260" :step/id #uuid "26a546ba-54ab-5cc8-83e6-b006c83a2260" :step/content 17592186134247 :step/next "step-5ab17b99-dd7c-5473-a02e-1887d75473a6" :db/ensure [:step/validate]} {:db/id "step-5ab17b99-dd7c-5473-a02e-1887d75473a6" :step/id #uuid "5ab17b99-dd7c-5473-a02e-1887d75473a6" :step/content 17592186134499 :step/next "step-b50cddb9-32fe-5feb-88b9-dbdd94647008" :db/ensure [:step/validate]} {:db/id "step-b50cddb9-32fe-5feb-88b9-dbdd94647008" :step/id #uuid "b50cddb9-32fe-5feb-88b9-dbdd94647008" :step/content 17592186348409 :step/next "step-b668892f-4bf5-5939-a70a-e3c5d414340b" :db/ensure [:step/validate]} {:db/id "step-b668892f-4bf5-5939-a70a-e3c5d414340b" :step/id #uuid "b668892f-4bf5-5939-a70a-e3c5d414340b" :step/content 17592186348415 :step/next "step-6102b09c-519b-52a5-908c-ac2692fae51a" :db/ensure [:step/validate]} {:db/id "step-6102b09c-519b-52a5-908c-ac2692fae51a" :step/id #uuid "6102b09c-519b-52a5-908c-ac2692fae51a" :step/content "question-1b5b5791-1037-533d-a2f0-5ffb4bac0dd8" :db/ensure [:step/validate]} [:db/retract 17592186169167 :answer-field/choices 17592186169168] [:db/retract 17592186169167 :answer-field/choices 17592186169169] [:db/retract 17592186169167 :answer-field/choices 17592186169170] [:db/retract 17592186169167 :answer-field/choices 17592186169171] [:db/retract 17592186169167 :answer-field/choices 17592186169172] {:db/id 17592186172135 :knowledge-point/questions ["question-b9abfcd2-1f16-5a00-8346-efd5d81231cb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186172384 :question/problem "Suppose we would like to find the minimum value of the function $f(x,y,z)=x+{y}^{2}+z$ on the intersection of the surfaces $3{y}^{2}+{z}^{2}=2$ and $x+{z}^{2}=1$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system:\n\n$$\n\\{\\begin{aligned}⟨1,\\,2y,\\,1⟩=\\lambda ⟨0,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,2z⟩+\\mu ⟨1,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,2z⟩ \\\\ 3{y}^{2}+{z}^{2}=2 \\\\ x+{z}^{2}=1\\end{aligned}\n$$\n\nFrom left to right, what are the missing expressions?" :question/worked-solution "We need to find the minimum value of \n\n$$\nf(x,y,z)=x+{y}^{2}+z\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)=3{y}^{2}+{z}^{2}=2,\\,h(x,y,z)=x+{z}^{2}=1.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=2 \\\\ h(x,y,z)=1\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨1,\\,2y,\\,1⟩ & =\\lambda ⟨0,\\,6y,\\,2z⟩+\\mu ⟨1,\\,0,\\,2z⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186169167 :answer-field/correct "answer-14de2753-c73d-55f7-8bc7-5fae82ecc1e9" :answer-field/choices ["answer-4dbe397f-fccb-5393-89f9-49deddcc70fd" "answer-91d37c9a-fa0d-55c8-8aed-0c8bcbdb8e4b" "answer-e65e780e-ffad-5628-b3c2-57fcf167b02c" "answer-14de2753-c73d-55f7-8bc7-5fae82ecc1e9" "answer-be7ff705-7435-5e6b-8ed0-6f09f99cd7f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-4dbe397f-fccb-5393-89f9-49deddcc70fd" :answer/id #uuid "4dbe397f-fccb-5393-89f9-49deddcc70fd" :answer/type :answer.type/text :answer/value "$3y\\,$ and $1$" :db/ensure [:answer/validate]} {:db/id "answer-91d37c9a-fa0d-55c8-8aed-0c8bcbdb8e4b" :answer/id #uuid "91d37c9a-fa0d-55c8-8aed-0c8bcbdb8e4b" :answer/type :answer.type/text :answer/value "$3{y}^{2}\\,$ and $y$" :db/ensure [:answer/validate]} {:db/id "answer-e65e780e-ffad-5628-b3c2-57fcf167b02c" :answer/id #uuid "e65e780e-ffad-5628-b3c2-57fcf167b02c" :answer/type :answer.type/text :answer/value "$3{y}^{2}\\,$ and $z$" :db/ensure [:answer/validate]} {:db/id "answer-14de2753-c73d-55f7-8bc7-5fae82ecc1e9" :answer/id #uuid "14de2753-c73d-55f7-8bc7-5fae82ecc1e9" :answer/type :answer.type/text :answer/value "$6y\\,$ and $0$" :db/ensure [:answer/validate]} {:db/id "answer-be7ff705-7435-5e6b-8ed0-6f09f99cd7f9" :answer/id #uuid "be7ff705-7435-5e6b-8ed0-6f09f99cd7f9" :answer/type :answer.type/text :answer/value "$6y\\,$ and $y$" :db/ensure [:answer/validate]} {:db/id 17592186401391 :question/problem "Suppose we would like to find the maximum value of the function $f(x,y,z)={x}^{2}+{y}^{2}z$ on the intersection of the surfaces ${x}^{2}+{z}^{2}=1$ and ${y}^{2}+z=9$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system:\n\n$$\n\\{\\begin{aligned}⟨2x,\\,2yz,\\,{y}^{2}⟩=\\lambda ⟨\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,0,\\,2z⟩+\\mu ⟨0,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,1⟩ \\\\ {x}^{2}+{z}^{2}=1 \\\\ {y}^{2}+z=9\\end{aligned}\n$$\n\nFrom left to right, what are the missing expressions?" :question/worked-solution "We need to find the maximum value of \n\n$$\nf(x,y,z)={x}^{2}+{y}^{2}z\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)={x}^{2}+{z}^{2}=1,\\,h(x,y,z)={y}^{2}+z=9.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=1 \\\\ h(x,y,z)=9\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨2x,\\,2yz,\\,{y}^{2}⟩ & =\\lambda ⟨2x,\\,0,\\,2z⟩+\\mu ⟨0,\\,2y,\\,1⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186401398 :question/problem "Suppose we would like to find the minimum value of the function $f(x,y,z)=xy+{z}^{2}$ on the intersection of the surfaces $y-x=0$ and ${x}^{2}+{y}^{2}+{z}^{2}=4$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system: \n\n$$\n\\{\\begin{aligned}⟨y,\\,x,\\,2z⟩=\\lambda ⟨-1,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,0⟩+\\mu ⟨2x,\\,2y,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}}\\,⟩ \\\\ y-x=0 \\\\ {x}^{2}+{y}^{2}+{z}^{2}=4\\end{aligned}\n$$\n\nFrom left to right, what are the missing expressions?" :question/worked-solution "We need to find the minimum value of \n\n$$\nf(x,y,z)=xy+{z}^{2}\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)=y-x=0,\\,h(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}=4.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=0 \\\\ h(x,y,z)=4\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨y,\\,x,\\,2z⟩ & =\\lambda ⟨-1,\\,1,\\,0⟩+\\mu ⟨2x,\\,2y,\\,2z⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-b9abfcd2-1f16-5a00-8346-efd5d81231cb" :question/id #uuid "b9abfcd2-1f16-5a00-8346-efd5d81231cb" :question/math-academy-id "q-162817" :question/problem "Suppose we would like to find the minimum of the function $f(x,y,z)=3xz+{y}^{2}$ on the intersection of the surfaces $x-y=1$ and $2{x}^{2}+{y}^{2}+2{z}^{2}=4$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system:  \n\n$$\n\\{\\begin{aligned}⟨\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,2y,\\,3x⟩=\\lambda ⟨1,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}},\\,0\\,⟩+\\mu ⟨4x,\\,2y,\\,\\bbox[2pt,border:1pt solid black]{\\phantom{AA}}\\,⟩ \\\\ x-y=1 \\\\ 2{x}^{2}+{y}^{2}+2{z}^{2}=4\\end{aligned}\n$$\n\nFrom left to right, what are the missing parts of the expressions?" :question/worked-solution "We need to find the minimum value of \n\n$$\nf(x,y,z)=3xz+{y}^{2}\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)=x-y=1,\\,h(x,y,z)=2{x}^{2}+{y}^{2}+2{z}^{2}=4.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=1 \\\\ h(x,y,z)=4\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨3z,\\,2y,\\,3x⟩ & =\\lambda ⟨1,\\,-1,\\,0⟩+\\mu ⟨4x,\\,2y,\\,4z⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0df0304e-ec0c-5d9e-8ca3-8b7c953f670a"] :db/ensure [:question/validate]} {:db/id "answer-field-0df0304e-ec0c-5d9e-8ca3-8b7c953f670a" :answer-field/id #uuid "0df0304e-ec0c-5d9e-8ca3-8b7c953f670a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-774b441c-9612-5738-9b25-33d37aa3bb97" :answer-field/choices ["answer-0bf5cbc8-973c-579a-9b90-abbe4012f724" "answer-774b441c-9612-5738-9b25-33d37aa3bb97" "answer-ec27c4f6-6609-57e9-84da-6d70e103712d" "answer-15eb0be1-2146-557a-bf30-037c1787fc52" "answer-7973a813-a61d-52de-b2c1-a38a665ca2d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0bf5cbc8-973c-579a-9b90-abbe4012f724" :answer/id #uuid "0bf5cbc8-973c-579a-9b90-abbe4012f724" :answer/type :answer.type/text :answer/value "$3x,\\,$ $-1,\\,$ and $2z$" :db/ensure [:answer/validate]} {:db/id "answer-774b441c-9612-5738-9b25-33d37aa3bb97" :answer/id #uuid "774b441c-9612-5738-9b25-33d37aa3bb97" :answer/type :answer.type/text :answer/value "$3z,\\,$ $-1,\\,$ and $4z$" :db/ensure [:answer/validate]} {:db/id "answer-ec27c4f6-6609-57e9-84da-6d70e103712d" :answer/id #uuid "ec27c4f6-6609-57e9-84da-6d70e103712d" :answer/type :answer.type/text :answer/value "$3z,\\,$ $0,\\,$ and $2z$" :db/ensure [:answer/validate]} {:db/id "answer-15eb0be1-2146-557a-bf30-037c1787fc52" :answer/id #uuid "15eb0be1-2146-557a-bf30-037c1787fc52" :answer/type :answer.type/text :answer/value "$3z-{y}^{2},\\,$ $1,\\,$ and $4z$" :db/ensure [:answer/validate]} {:db/id "answer-7973a813-a61d-52de-b2c1-a38a665ca2d6" :answer/id #uuid "7973a813-a61d-52de-b2c1-a38a665ca2d6" :answer/type :answer.type/text :answer/value "$z,\\,$ $1,\\,$ and $2z$" :db/ensure [:answer/validate]} {:db/id 17592186172134 :knowledge-point/questions ["question-3250257a-998e-56c2-b2b7-fdd8d8e6863b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3250257a-998e-56c2-b2b7-fdd8d8e6863b" :question/id #uuid "3250257a-998e-56c2-b2b7-fdd8d8e6863b" :question/math-academy-id "q-162896" :question/problem "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y,z)=x+y-2z$ on the intersection of the plane $x+y+4z=4$ and the cylinder $4{x}^{2}+{z}^{2}=1.$" :question/worked-solution "We need to find the maximum value of \n\n$$\nf(x,y,z)=x+y-2z\n$$\n\nsubject to the constraints \n\n$$\ng(x,y,z)=x+y+4z=4,\\,h(x,y,z)=4{x}^{2}+{z}^{2}=1.\n$$\n\nSince $f(x,y,z)$ is continuous and the constraint is closed and bounded, $f(x,y,z)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=4 \\\\ h(x,y,z)=1\\end{aligned}\n$$\n\nWe start by expanding the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨1,1,-2⟩ & =\\lambda ⟨1,1,4⟩+\\mu ⟨8x,0,2z⟩\\end{aligned}\n$$\n\n \n\nTherefore, we have the following system:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}1=\\lambda +8\\mu x \\\\ 1=\\lambda  \\\\ -2=4\\lambda +2\\mu z\\end{aligned}\\,⇒\\,\\{\\begin{aligned}\\mu x=0 \\\\ \\lambda =1 \\\\ z=-\\frac{3}{\\mu }\\end{aligned}\\end{aligned}\n$$\n\nNotice that $\\mu $ can't be zero since this leads to a contradiction. So, from the first equation above, we must have $x=0.$\n\nNext, we substitute $x=0$  into the second constraint:\n\n$$\n\\begin{aligned}4{x}^{2}+{z}^{2} & =1 \\\\ {z}^{2} & =1 \\\\ z & =\\pm 1\\end{aligned}\n$$\n\n \n\nFinally, we substitute $x$ and $z$ into the first constraint:\n\n- If $x=0$ and $z=1,$ we have\n\n$$\n\\begin{aligned}x+y+4z & =4 \\\\ 0+y+4(1) & =4 \\\\ y+4 & =4 \\\\ y & =0.\\end{aligned}\n$$\n\n- If $x=0$ and $z=-1,$ we have\n\n$$\n\\begin{aligned}x+y+4z & =4 \\\\ 0+y+4(-1) & =4 \\\\ y-4 & =4 \\\\ y & =8.\\end{aligned}\n$$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(0,0,1),\\,(0,8,-1).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y,z)$ | $(0,0,1)$ | $(0,8,-1)$ |\n| --- | --- | --- |\n| $f(x,y,z)$ | $-2$ | $10$ |\n\nTherefore, the function reaches a maximum value at $(0,8,-1),$ and its  maximum value is $10.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f02d209a-9adb-5732-8214-dc18cb0b1819"] :db/ensure [:question/validate]} {:db/id "answer-field-f02d209a-9adb-5732-8214-dc18cb0b1819" :answer-field/id #uuid "f02d209a-9adb-5732-8214-dc18cb0b1819" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f4740cdc-4247-561b-a719-1d4642b2932f" :answer-field/choices ["answer-f07b1405-5db5-53fd-92b4-e9d3aa736944" "answer-f4740cdc-4247-561b-a719-1d4642b2932f" "answer-35746dd5-60c7-5b7c-9936-da62f086bab4" "answer-da111704-a982-535c-b453-0caf2ce1247c" "answer-88b5f66c-f0e6-5312-b69e-25574fe5c5f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-f07b1405-5db5-53fd-92b4-e9d3aa736944" :answer/id #uuid "f07b1405-5db5-53fd-92b4-e9d3aa736944" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f4740cdc-4247-561b-a719-1d4642b2932f" :answer/id #uuid "f4740cdc-4247-561b-a719-1d4642b2932f" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-35746dd5-60c7-5b7c-9936-da62f086bab4" :answer/id #uuid "35746dd5-60c7-5b7c-9936-da62f086bab4" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-da111704-a982-535c-b453-0caf2ce1247c" :answer/id #uuid "da111704-a982-535c-b453-0caf2ce1247c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-88b5f66c-f0e6-5312-b69e-25574fe5c5f3" :answer/id #uuid "88b5f66c-f0e6-5312-b69e-25574fe5c5f3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "activity-8dc94535-12c0-5f35-80ba-9bfd3aa320a0" :activity/id #uuid "8dc94535-12c0-5f35-80ba-9bfd3aa320a0" :activity/title "Lagrange Multipliers With Multiple Constraints" :activity/type :activity.type/review :activity/scope 17592186048972 :activity/course 17592186046644 :activity/steps ["step-f604edfe-8dc8-5873-922c-04c614698a35" "step-657450a0-d1cc-5cbf-b267-5bba4ceaf67a" "step-5255935c-1292-5a9d-9614-94e19bc8466b" "step-272e8559-390b-50dd-a1a1-013d8cdb1fa7" "step-6f6d8416-dce7-5060-aa05-6320dc8c6d46"] :activity/first-step "step-f604edfe-8dc8-5873-922c-04c614698a35" :db/ensure [:activity/validate]} {:db/id "step-f604edfe-8dc8-5873-922c-04c614698a35" :step/id #uuid "f604edfe-8dc8-5873-922c-04c614698a35" :step/content 17592186172384 :step/next "step-657450a0-d1cc-5cbf-b267-5bba4ceaf67a" :db/ensure [:step/validate]} {:db/id "step-657450a0-d1cc-5cbf-b267-5bba4ceaf67a" :step/id #uuid "657450a0-d1cc-5cbf-b267-5bba4ceaf67a" :step/content 17592186401391 :step/next "step-5255935c-1292-5a9d-9614-94e19bc8466b" :db/ensure [:step/validate]} {:db/id "step-5255935c-1292-5a9d-9614-94e19bc8466b" :step/id #uuid "5255935c-1292-5a9d-9614-94e19bc8466b" :step/content 17592186401398 :step/next "step-272e8559-390b-50dd-a1a1-013d8cdb1fa7" :db/ensure