e]} {:db/id "step-bd23dc98-fd69-51c9-9a58-e91f7d687301" :step/id #uuid "bd23dc98-fd69-51c9-9a58-e91f7d687301" :step/content "question-54e659be-f31e-5f00-888e-77687d0dffe4" :step/next "step-f926380d-bcec-5620-97b8-60ae87728a01" :db/ensure [:step/validate]} {:db/id "step-f926380d-bcec-5620-97b8-60ae87728a01" :step/id #uuid "f926380d-bcec-5620-97b8-60ae87728a01" :step/content "question-7823b972-423e-5466-806b-703ca14c80f8" :db/ensure [:step/validate]} {:db/id "activity-2f95b7e7-f8c1-5010-88c6-e7ce105c0c19" :activity/id #uuid "2f95b7e7-f8c1-5010-88c6-e7ce105c0c19" :activity/title "Multiplicities of the Roots of Polynomials" :activity/type :activity.type/review :activity/scope 17592186048669 :activity/course 17592186046647 :activity/steps ["step-bf66e951-96d1-5512-9440-40170f41996f" "step-69080387-cffb-58a6-b3b8-90102b3ecb58" "step-8bbb3b92-8084-556f-a200-4796f0cc9138"] :activity/first-step "step-bf66e951-96d1-5512-9440-40170f41996f" :db/ensure [:activity/validate]} {:db/id "step-bf66e951-96d1-5512-9440-40170f41996f" :step/id #uuid "bf66e951-96d1-5512-9440-40170f41996f" :step/content 17592186398088 :step/next "step-69080387-cffb-58a6-b3b8-90102b3ecb58" :db/ensure [:step/validate]} {:db/id "step-69080387-cffb-58a6-b3b8-90102b3ecb58" :step/id #uuid "69080387-cffb-58a6-b3b8-90102b3ecb58" :step/content 17592186233704 :step/next "step-8bbb3b92-8084-556f-a200-4796f0cc9138" :db/ensure [:step/validate]} {:db/id "step-8bbb3b92-8084-556f-a200-4796f0cc9138" :step/id #uuid "8bbb3b92-8084-556f-a200-4796f0cc9138" :step/content 17592186294854 :db/ensure [:step/validate]} {:db/id 17592186119792 :knowledge-point/questions ["question-903883c2-c07e-50f2-a202-1c38e08cadfc" "question-66c0358e-dcf2-5965-acb4-eb43f1da9799" "question-14def4d3-3d45-5610-862f-8d4c651f0955"] :db/ensure [:knowledge-point/validate]} {:db/id "question-903883c2-c07e-50f2-a202-1c38e08cadfc" :question/id #uuid "903883c2-c07e-50f2-a202-1c38e08cadfc" :question/math-academy-id "q-32550" :question/problem "Given that \n$A=\\begin{bmatrix}1 & -2 \\\\ -5 & 6\\end{bmatrix}$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 \\\\ -5 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & -4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -2 \\\\ 0 & -4\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-808d2fc9-2e7f-5ef1-86ff-cfcf9e8e2abc"] :db/ensure [:question/validate]} {:db/id "answer-field-808d2fc9-2e7f-5ef1-86ff-cfcf9e8e2abc" :answer-field/id #uuid "808d2fc9-2e7f-5ef1-86ff-cfcf9e8e2abc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d58d8e8-ebbf-5227-901f-b377591464ca" :answer-field/choices ["answer-3cbd73d2-cd1b-5b1f-b775-9c124c82a91b" "answer-17429e2c-6a7d-5799-9f99-11411731d372" "answer-4d58d8e8-ebbf-5227-901f-b377591464ca" "answer-dcdfcc6c-043a-5b9e-8a4c-0bfab8faa665" "answer-9a8638fd-45d4-525e-afd5-446d9bab6953"] :db/ensure [:answer-field/validate]} {:db/id "answer-3cbd73d2-cd1b-5b1f-b775-9c124c82a91b" :answer/id #uuid "3cbd73d2-cd1b-5b1f-b775-9c124c82a91b" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-5 & 0 \\\\ 1 & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-17429e2c-6a7d-5799-9f99-11411731d372" :answer/id #uuid "17429e2c-6a7d-5799-9f99-11411731d372" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ -2 & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-4d58d8e8-ebbf-5227-901f-b377591464ca" :answer/id #uuid "4d58d8e8-ebbf-5227-901f-b377591464ca" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-dcdfcc6c-043a-5b9e-8a4c-0bfab8faa665" :answer/id #uuid "dcdfcc6c-043a-5b9e-8a4c-0bfab8faa665" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ 2 & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-9a8638fd-45d4-525e-afd5-446d9bab6953" :answer/id #uuid "9a8638fd-45d4-525e-afd5-446d9bab6953" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "question-66c0358e-dcf2-5965-acb4-eb43f1da9799" :question/id #uuid "66c0358e-dcf2-5965-acb4-eb43f1da9799" :question/math-academy-id "q-74951" :question/problem "Given that\n$A=\\begin{bmatrix}3 & 2 \\\\ -4 & -3\\end{bmatrix}.$ \nhas the LU decomposition $A=LU$, then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 2 \\\\ -4 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{4}{3}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & 2 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{3} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & 2 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8e1d1148-bcd2-52a8-8f81-b71b67b2ffca"] :db/ensure [:question/validate]} {:db/id "answer-field-8e1d1148-bcd2-52a8-8f81-b71b67b2ffca" :answer-field/id #uuid "8e1d1148-bcd2-52a8-8f81-b71b67b2ffca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fb15c2de-88fd-5d61-a019-1eb95f578d9b" :answer-field/choices ["answer-7ca3072c-d6ac-5918-a623-20411f8b7700" "answer-fb15c2de-88fd-5d61-a019-1eb95f578d9b" "answer-fba3dcfb-a5b2-547c-8691-6e722e502046" "answer-acfff4be-1f46-5b1f-a60f-b1bb756a3b25" "answer-60d81581-c221-5494-a432-08d979f7a43d"] :db/ensure [:answer-field/validate]} {:db/id "answer-7ca3072c-d6ac-5918-a623-20411f8b7700" :answer/id #uuid "7ca3072c-d6ac-5918-a623-20411f8b7700" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{4}{3} & 0 \\\\ 1 & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-fb15c2de-88fd-5d61-a019-1eb95f578d9b" :answer/id #uuid "fb15c2de-88fd-5d61-a019-1eb95f578d9b" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{3} & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-fba3dcfb-a5b2-547c-8691-6e722e502046" :answer/id #uuid "fba3dcfb-a5b2-547c-8691-6e722e502046" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{5} & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-acfff4be-1f46-5b1f-a60f-b1bb756a3b25" :answer/id #uuid "acfff4be-1f46-5b1f-a60f-b1bb756a3b25" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ 4 & -3\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-60d81581-c221-5494-a432-08d979f7a43d" :answer/id #uuid "60d81581-c221-5494-a432-08d979f7a43d" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "question-14def4d3-3d45-5610-862f-8d4c651f0955" :question/id #uuid "14def4d3-3d45-5610-862f-8d4c651f0955" :question/math-academy-id "q-106760" :question/problem "Given that \n$A=\\begin{bmatrix}-2 & 1 \\\\ -16 & 10\\end{bmatrix}$ \nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-2 & 1 \\\\ -16 & 10\\end{bmatrix} & \\,{R}_{2} & :={R}_{2}+(-8){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-2 & 1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 8 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-2 & 1 \\\\ 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c9382a07-3a03-5be2-b528-235df29742b5"] :db/ensure [:question/validate]} {:db/id "answer-field-c9382a07-3a03-5be2-b528-235df29742b5" :answer-field/id #uuid "c9382a07-3a03-5be2-b528-235df29742b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-97984476-2d2e-53cd-84f2-a709077ec7d2" :answer-field/choices ["answer-dd2156fb-e1ff-51c3-b81e-f5cafa615c40" "answer-7cb0dc58-f354-538c-8