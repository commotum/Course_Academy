(\\sqrt{2})^{2}} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0f562f05-e64d-5189-84cb-9fa3a27158ee"] :db/ensure [:question/validate]} {:db/id "answer-field-0f562f05-e64d-5189-84cb-9fa3a27158ee" :answer-field/id #uuid "0f562f05-e64d-5189-84cb-9fa3a27158ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer-field/choices ["answer-2cc75ee0-7521-5750-8f0f-3f1a36938006" "answer-20d26f86-2dc9-5463-bba9-a9c64837cfba" "answer-4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" "answer-f1dc7873-f819-53f3-a6f8-115519757005" "answer-4188c38e-2d83-5519-96c9-a6eb79f16eb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cc75ee0-7521-5750-8f0f-3f1a36938006" :answer/id #uuid "2cc75ee0-7521-5750-8f0f-3f1a36938006" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{w+2}" :db/ensure [:answer/validate]} {:db/id "answer-20d26f86-2dc9-5463-bba9-a9c64837cfba" :answer/id #uuid "20d26f86-2dc9-5463-bba9-a9c64837cfba" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3w}+\\sqrt{2}}{w-2}" :db/ensure [:answer/validate]} {:db/id "answer-4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer/id #uuid "4f30b0d7-48f8-5ace-8f0f-4568d9df43f4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}" :db/ensure [:answer/validate]} {:db/id "answer-f1dc7873-f819-53f3-a6f8-115519757005" :answer/id #uuid "f1dc7873-f819-53f3-a6f8-115519757005" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3w}-\\sqrt{2}}{3w-4}" :db/ensure [:answer/validate]} {:db/id "answer-4188c38e-2d83-5519-96c9-a6eb79f16eb6" :answer/id #uuid "4188c38e-2d83-5519-96c9-a6eb79f16eb6" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3w}}{3w-2}" :db/ensure [:answer/validate]} {:db/id "question-a1da1538-2a0a-558a-a1d3-261eb037e2ac" :question/id #uuid "a1da1538-2a0a-558a-a1d3-261eb037e2ac" :question/math-academy-id "q-111098" :question/problem "Rationalize the denominator of $\\frac{4}{\\sqrt{t}-\\sqrt{t-2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{t}+\\sqrt{t-2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{t}+\\sqrt{t-2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{t}-\\sqrt{t-2}} & = \\\\ \\frac{4}{\\sqrt{t}-\\sqrt{t-2}}\\cdot \\frac{\\sqrt{t}+\\sqrt{t-2}}{\\sqrt{t}+\\sqrt{t-2}} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{(\\sqrt{t}-\\sqrt{t-2})(\\sqrt{t}+\\sqrt{t-2})} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{(\\sqrt{t})^{2}-(\\sqrt{t-2})^{2}} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{t-(t-2)} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{2} & = \\\\ 2(\\sqrt{t}+\\sqrt{t-2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ea6fd233-64c8-5051-aede-bd7eab00774b"] :db/ensure [:question/validate]} {:db/id "answer-field-ea6fd233-64c8-5051-aede-bd7eab00774b" :answer-field/id #uuid "ea6fd233-64c8-5051-aede-bd7eab00774b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-71984da1-839e-57e7-a49b-49df86003698" :answer-field/choices ["answer-71984da1-839e-57e7-a49b-49df86003698" "answer-6129f7be-7cf7-5ba4-b20f-0e5ef3758570" "answer-4a192ac0-05c0-5288-be68-d3263570531f" "answer-511af3b2-ea1f-55c1-89be-5b613e2e87d9" "answer-2f1bbe86-ce5f-55c6-8bed-f62f18b202e0"] :db/ensure [:answer-field/validate]} {:db/id "answer-71984da1-839e-57e7-a49b-49df86003698" :answer/id #uuid "71984da1-839e-57e7-a49b-49df86003698" :answer/type :answer.type/math :answer/value "2(\\sqrt{t}+\\sqrt{t-2})" :db/ensure [:answer/validate]} {:db/id "answer-6129f7be-7cf7-5ba4-b20f-0e5ef3758570" :answer/id #uuid "6129f7be-7cf7-5ba4-b20f-0e5ef3758570" :answer/type :answer.type/math :answer/value "4(\\sqrt{t}+\\sqrt{t-2})" :db/ensure [:answer/validate]} {:db/id "answer-4a192ac0-05c0-5288-be68-d3263570531f" :answer/id #uuid "4a192ac0-05c0-5288-be68-d3263570531f" :answer/type :answer.type/math :answer/value "\\frac{2(\\sqrt{t}+\\sqrt{t-2})}{t}" :db/ensure [:answer/validate]} {:db/id "answer-511af3b2-ea1f-55c1-89be-5b613e2e87d9" :answer/id #uuid "511af3b2-ea1f-55c1-89be-5b613e2e87d9" :answer/type :answer.type/math :answer/value "\\frac{4(\\sqrt{t}+\\sqrt{t-2})}{t}" :db/ensure [:answer/validate]} {:db/id "answer-2f1bbe86-ce5f-55c6-8bed-f62f18b202e0" :answer/id #uuid "2f1bbe86-ce5f-55c6-8bed-f62f18b202e0" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{t}+\\sqrt{t-2}}{t}" :db/ensure [:answer/validate]} {:db/id "question-1e5c00c2-c308-529c-a13c-5c3155546628" :question/id #uuid "1e5c00c2-c308-529c-a13c-5c3155546628" :question/math-academy-id "q-296023" :question/problem "Rationalize the denominator of $\\frac{1}{\\sqrt{y}+\\sqrt{y-4}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{y}-\\sqrt{y-4}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y}-\\sqrt{y-4},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{y}+\\sqrt{y-4}} & = \\\\ \\frac{1}{\\sqrt{y}+\\sqrt{y-4}}\\cdot \\frac{\\sqrt{y}-\\sqrt{y-4}}{\\sqrt{y}-\\sqrt{y-4}} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{(\\sqrt{y}+\\sqrt{y-4})(\\sqrt{y}-\\sqrt{y-4})} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{(\\sqrt{y})^{2}-(\\sqrt{y-4})^{2}} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{y-(y-4)} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{4} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-856fcbb2-090f-5a4c-8cd8-b5566b8435da"] :db/ensure [:question/validate]} {:db/id "answer-field-856fcbb2-090f-5a4c-8cd8-b5566b8435da" :answer-field/id #uuid "856fcbb2-090f-5a4c-8cd8-b5566b8435da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3bdcd31-eefc-5f61-a086-822a45ffbb47" :answer-field/choices ["answer-5ae369e7-03ef-559a-aa47-3760043102e4" "answer-81517240-0e51-5a86-8d5e-c2647c66bdbc" "answer-adb08300-f14d-5b4c-8cbe-a1895fc9e657" "answer-e4c11fb7-0ecf-5125-a1d2-9a9e38c42379" "answer-a3bdcd31-eefc-5f61-a086-822a45ffbb47"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ae369e7-03ef-559a-aa47-3760043102e4" :answer/id #uuid "5ae369e7-03ef-559a-aa47-3760043102e4" :answer/type :answer.type/math :answer/value "4(\\sqrt{y}-\\sqrt{y-4})" :db/ensure [:answer/validate]} {:db/id "answer-81517240-0e51-5a86-8d5e-c2647c66bdbc" :answer/id #uuid "81517240-0e51-5a86-8d5e-c2647c66bdbc" :answer/type :answer.type/math :answer/value "\\frac{2(\\sqrt{y}-\\sqrt{y-4})}{4}" :db/ensure [:answer/validate]} {:db/id "answer-adb08300-f14d-5b4c-8cbe-a1895fc9e657" :answer/id #uuid "adb08300-f14d-5b4c-8cbe-a1895fc9e657" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{y-4}-\\sqrt{y}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-e4c11fb7-0ecf-5125-a1d2-9a9e38c42379" :answer/id #uuid "e4c11fb7-0ecf-5125-a1d2-9a9e38c42379" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{y}+\\sqrt{y-4}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-a3bdcd31-eefc-5f61-a086-822a45ffbb47" :answer/id #uuid "a3bdcd31-eefc-5f61-a086-822a45ffbb47" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{y}-\\sqrt{y-4}}{4}" :db/ensure [:answer/validate]} {:db/id 17592186214235 :tutorial/content "Rationalizing the denominator works similarly for algebraic expressions as it does for numerical ones. When the denominator contains two terms and includes radicals, we multiply both the numerator and the denominator by the *conjugate* of the denominator to eliminate the radical.\n\nFor example, consider the following expression:\n\n$$\n\\dfrac{1}{1+\\sqrt{x}}\n$$\n\n \n\nTo find the conjugate of the denominator $1+\\sqrt{x},$ all we have to do is flip the sign between the two terms. So, the conjugate of the denominator is \n\n$$\n1\\,{\\color{blue}{-}}\\,\\sqrt{x}.\n$$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by $1-\\sqrt{x}$ and simplify:\n\n \n\n$$\n\\begin{aligned}\\frac{1}{1+\\sqrt{x}} & = \\\\ \\frac{1}{1+\\sqrt{x}}\\cdot \\frac{1-\\sqrt{x}}{1-\\sqrt{x}} & = \\\\ \\frac{1-\\sqrt{x}}{(1+\\sqrt{x})(1-\\sqrt{x})} & = \\\\ \\frac{1-\\sqrt{x}}{{1}^{2}-(\\sqrt{x})^{2}} & = \\\\ \\frac{1-\\sqrt{x}}{1-x}\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186213279 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]}]
