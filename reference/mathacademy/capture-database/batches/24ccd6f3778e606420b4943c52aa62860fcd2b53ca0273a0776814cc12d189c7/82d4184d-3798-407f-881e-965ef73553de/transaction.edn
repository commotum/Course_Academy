5-5b8c-89b1-b11dd1bda638"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9cdf7c4f-4409-57f0-b1eb-dca5de834f65" :question/id #uuid "9cdf7c4f-4409-57f0-b1eb-dca5de834f65" :question/math-academy-id "q-276297" :question/problem "A fair spinner has six sides labeled with the numbers $-2,$ $-1,$ $0,$ $1,$ $2,$ and $3.$ If the spinner is spun, what is the expected value of the outcome?\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the outcome of the spinner. Then the support is $S=\\{-2,-1,0,1,2,3\\},$ and the corresponding probabilities are all $\\frac{1}{6}:$\n\n$$\nf(-2)=f(-1)=f(0)=f(1)=f(2)=f(3)=\\frac{1}{6}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =-2\\cdot f(-2)+(-1)\\cdot f(-1)+0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =-2(\\frac{1}{6})+(-1)(\\frac{1}{6})+0(\\frac{1}{6})+1(\\frac{1}{6})+2(\\frac{1}{6})+3(\\frac{1}{6}) \\\\  & =-\\frac{2}{6}-\\frac{1}{6}+0+\\frac{1}{6}+\\frac{2}{6}+\\frac{3}{6} \\\\  & =\\frac{-2-1+0+1+2+3}{6} \\\\  & =\\frac{3}{6} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-36c5b657-8ae8-52f1-9b50-9850b824e02a"] :db/ensure [:question/validate]} {:db/id "answer-field-36c5b657-8ae8-52f1-9b50-9850b824e02a" :answer-field/id #uuid "36c5b657-8ae8-52f1-9b50-9850b824e02a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e15daab7-6b24-5c89-8928-f0f9fcd1b856" :answer-field/choices ["answer-e15daab7-6b24-5c89-8928-f0f9fcd1b856"] :db/ensure [:answer-field/validate]} {:db/id "answer-e15daab7-6b24-5c89-8928-f0f9fcd1b856" :answer/id #uuid "e15daab7-6b24-5c89-8928-f0f9fcd1b856" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-522d89ff-41d6-50ec-8d1b-a4ada325fbc8" :question/id #uuid "522d89ff-41d6-50ec-8d1b-a4ada325fbc8" :question/math-academy-id "q-83981" :question/problem "A stack contains four cards, where each card is labeled $1$, $4$, $6$, or $9.$ If one card is randomly drawn, what is its expected value?" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the label on a randomly drawn card. Then the support is $S=\\{1,4,6,9\\},$ and the corresponding probabilities are all $\\frac{1}{4}:$\n\n$$\nf(1)=f(4)=f(6)=f(9)=\\frac{1}{4}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+4\\cdot f(4)+6\\cdot f(6)+9\\cdot f(9) \\\\  & =1(\\frac{1}{4})+4(\\frac{1}{4})+6(\\frac{1}{4})+9(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{4}{4}+\\frac{6}{4}+\\frac{9}{4} \\\\  & =\\frac{1+4+6+9}{4} \\\\  & =\\frac{20}{4} \\\\  & =5\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-850858f3-9f08-5b6d-b191-4d25dc883811"] :db/ensure [:question/validate]} {:db/id "answer-field-850858f3-9f08-5b6d-b191-4d25dc883811" :answer-field/id #uuid "850858f3-9f08-5b6d-b191-4d25dc883811" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5b73964e-ee01-5caf-b596-26a1127dfc1a" :answer-field/choices ["answer-f7a0885c-49d2-5c12-bd6c-2ba68d197915" "answer-290464f7-629a-599f-9619-f15eb5786d1b" "answer-5b73964e-ee01-5caf-b596-26a1127dfc1a" "answer-51e0957a-5bf2-56a2-93c7-c85dbc288c19" "answer-9d79ce2e-0688-5dfd-92d7-ae8f08fcc6bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7a0885c-49d2-5c12-bd6c-2ba68d197915" :answer/id #uuid "f7a0885c-49d2-5c12-bd6c-2ba68d197915" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-290464f7-629a-599f-9619-f15eb5786d1b" :answer/id #uuid "290464f7-629a-599f-9619-f15eb5786d1b" :answer/type :answer.type/math :answer/value "4.5" :db/ensure [:answer/validate]} {:db/id "answer-5b73964e-ee01-5caf-b596-26a1127dfc1a" :answer/id #uuid "5b73964e-ee01-5caf-b596-26a1127dfc1a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-51e0957a-5bf2-56a2-93c7-c85dbc288c19" :answer/id #uuid "51e0957a-5bf2-56a2-93c7-c85dbc288c19" :answer/type :answer.type/math :answer/value "5.5" :db/ensure [:answer/validate]} {:db/id "answer-9d79ce2e-0688-5dfd-92d7-ae8f08fcc6bc" :answer/id #uuid "9d79ce2e-0688-5dfd-92d7-ae8f08fcc6bc" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-d66ccea1-6118-5ac8-bad9-91d326fbbfdc" :question/id #uuid "d66ccea1-6118-5ac8-bad9-91d326fbbfdc" :question/math-academy-id "q-5775" :question/problem "What is the expected value of one roll of a seven-sided die?" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the roll of a standard six-sided die. Then the support is $S=\\{1,2,3,4,5,6,7\\},$ and the corresponding probabilities are all $\\frac{1}{7}:$\n\n$$\nf(1)=f(2)=…=f(7)=\\frac{1}{7}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+…+7\\cdot f(7) \\\\  & =1(\\frac{1}{7})+2(\\frac{1}{7})+…+7(\\frac{1}{7}) \\\\  & =\\frac{1}{7}+\\frac{2}{7}+…+\\frac{7}{7} \\\\  & =\\frac{1+2+3+4+5+6+7}{7} \\\\  & =\\frac{28}{7} \\\\  & =4\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2ec163e0-26a6-57f4-be06-48ae685c5412"] :db/ensure [:question/validate]} {:db/id "answer-field-2ec163e0-26a6-57f4-be06-48ae685c5412" :answer-field/id #uuid "2ec163e0-26a6-57f4-be06-48ae685c5412" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5762b6c1-c01c-597b-9835-929afcb6f899" :answer-field/choices ["answer-ae1705d9-17cc-5143-b4de-f594d074c4ba" "answer-5762b6c1-c01c-597b-9835-929afcb6f899" "answer-78fc98f4-275f-5076-bbb7-8cc595a03416" "answer-6f459d6c-f88c-58f8-8c67-ce4a713307e8" "answer-e9e43695-a50c-5db3-a1b5-0d7b31b148a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae1705d9-17cc-5143-b4de-f594d074c4ba" :answer/id #uuid "ae1705d9-17cc-5143-b4de-f594d074c4ba" :answer/type :answer.type/math :answer/value "3.5" :db/ensure [:answer/validate]} {:db/id "answer-5762b6c1-c01c-597b-9835-929afcb6f899" :answer/id #uuid "5762b6c1-c01c-597b-9835-929afcb6f899" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-78fc98f4-275f-5076-bbb7-8cc595a03416" :answer/id #uuid "78fc98f4-275f-5076-bbb7-8cc595a03416" :answer/type :answer.type/math :answer/value "4.5" :db/ensure [:answer/validate]} {:db/id "answer-6f459d6c-f88c-58f8-8c67-ce4a713307e8" :answer/id #uuid "6f459d6c-f88c-58f8-8c67-ce4a713307e8" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-e9e43695-a50c-5db3-a1b5-0d7b31b148a2" :answer/id #uuid "e9e43695-a50c-5db3-a1b5-0d7b31b148a2" :answer/type :answer.type/math :answer/value "5.5" :db/ensure [:answer/validate]} {:db/id "question-0298a94b-23a5-5b8c-89b1-b11dd1bda638" :question/id #uuid "0298a94b-23a5-5b8c-89b1-b11dd1bda638" :question/math-academy-id "q-89150" :question/problem "What is the expected value of one roll of a four-sided die?" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the roll of a four-sided die. Then the support is $S=\\{1,2,3,4\\},$ and the corresponding probabilities are all $\\frac{1}{4}:$\n\n$$\nf(1)=f(2)=f(3)=f(4)=\\frac{1}{4}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)++3\\cdot f(3)+4\\cdot f(4) \\\\  & =1(\\frac{1}{4})+2(\\frac{1}{4})+3(\\frac{1}{4})+4(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{2}{4}+\\frac{3}{4}+\\frac{4}{4} \\\\  & =\\frac{1+2+3+4}{4} \\\\  & =\\frac{10}{4} \\\\  & =2.5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-040b322c-582e-5726-82e2-05dc9e18e0aa"] :db/ensure [:question/validate]} {:db/id "answer-field-040b322c-582e-5726-82e2-05dc9e18e0aa" :answer-field/id #uuid "040b322c-582e-5726-82e2-05dc9e18e0aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df928123-92fc-5c8f-ae4f-3bf6ff6d7789" :answer-field/choices ["answer-45c85e36-fafb-5cd0-bf93-acbfc1d73fee" "answer-68868532-f794-5090-9203-a2b2d0d74f1c" "answer-4188061c-4dfe-5f94-b792-4dca2da6c67e" "answer-df928123-92fc-5c8f-ae4f-3bf6ff6d7789" "answer-b59463e4-063b-5b43-ba22-7b25a136607c"] :db/ensure [:answer-field/validate]} {:db/id "answer-45c85e36-fafb-5cd0-bf93-acbfc1d73fee" :answer/id #uuid "45c85e36-fafb-5cd0-bf93-acbfc1d73fee" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-68868532-f794-5090-9203-a2b2d0d74f1c" :answer/id #uuid "68868532-f794-5090-9203-a2b2d0d74f1c" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "answer-4188061c-4dfe-5f94-b792-4dca2da6c67e" :answer/id #uuid "4188061c-4dfe-5f94-b792-4dca2da6c67e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-df928123-92fc-5c8f-ae4f-3bf6ff6d7789" :answer/id #uuid "df928123-92fc-5c8f-ae4f-3bf6ff6d7789" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "answer-b59463e4-063b-5b43-ba22-7b25a136607c" :answer/id #uuid "b59463e4-063b-5b43-ba22-7b25a136607c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186083308 :knowledge-point/questions ["question-53e1317a-3ae2-58ac-bb4d-59a740997145" "question-6f220269-fce2-5308-a544-a882143be2b5" "question-dc6b2040-54a4-56f7-9767-230b7779b10f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-53e1317a-3ae2-58ac-bb4d-59a740997145" :question/id #uuid "53e1317a-3ae2-58ac-bb4d-59a740997145" :question/math-academy-id "q-127259" :question/problem "The rolls of an unfair octahedral die follow the probability mass function $f(x)$ as shown in the table below. What is the expected value of one roll of the die?\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{16}$ | $\\frac{1}{16}$ | $\\frac{3}{32}$ | $\\frac{1}{8}$ | $\\frac{1}{32}$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5)+6\\cdot f(6) \\\\  & =1(\\frac{1}{8})+2(\\frac{1}{16})+3(\\frac{1}{16})+4(\\frac{3}{32})+5(\\frac{1}{8})+6(\\frac{1}{32})+7(\\frac{1}{4})+8(\\frac{1}{4}) \\\\  & =\\frac{1}{8}+\\frac{2}{16}+\\frac{3}{16}+\\frac{12}{32}+\\frac{5}{8}+\\frac{6}{32}+\\frac{7}{4}+\\frac{8}{4} \\\\  & =\\frac{4}{32}+\\frac{4}{32}+\\frac{6}{32}+\\frac{12}{32}+\\frac{20}{32}+\\frac{6}{32}+\\frac{56}{32}+\\frac{64}{32} \\\\  & =\\frac{4+4+6+12+20+6+56+64}{32} \\\\  & =\\frac{172}{32} \\\\  & =\\frac{43}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-57adae38-47d4-5119-8e1b-753ad3c2f4c1"] :db/ensure [:question/validate]} {:db/id "answer-field-57adae38-47d4-5119-8e1b-753ad3c2f4c1" :answer-field/id #uuid "57adae38-47d4-5119-8e1b-753ad3c2f4c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba66511f-5970-5a6f-9b8a-e517905c7f12" :answer-field/choices ["answer-69532553-7c14-5c9e-8f67-52df69fbcb70" "answer-ba42e326-790d-5ce1-a2d5-97a6580a41b3" "answer-4a55a640-5056-53aa-a01c-37549144e131" "answer-ba66511f-5970-5a6f-9b8a-e517905c7f12" "answer-a4821310-860e-5fda-9174-3a8a5f122a83"] :db/ensure [:answer-field/validate]} {:db/id "answer-69532553-7c14-5c9e-8f67-52df69fbcb70" :answer/id #uuid "69532553-7c14-5c9e-8f67-52df69fbcb70" :answer/type :answer.type/math :answer/value "\\frac{19}{8}" :db/ensure [:answer/validate]} {:db/id "answer-ba42e326-790d-5ce1-a2d5-97a6580a41b3" :answer/id #uuid "ba42e326-790d-5ce1-a2d5-97a6580a41b3" :answer/type :answer.type/math :answer/value "\\frac{43}{16}" :db/ensure [:answer/validate]} {:db/id "answer-4a55a640-5056-53aa-a01c-37549144e131" :answer/id #uuid "4a55a640-5056-53aa-a01c-37549144e131" :answer/type :answer.type/math :answer/value "\\frac{43}{32}" :db/ensure [:answer/validate]} {:db/id "answer-ba66511f-5970-5a6f-9b8a-e517905c7f12" :answer/id #uuid "ba66511f-5970-5a6f-9b8a-e517905c7f12" :answer/type :answer.type/math :answer/value "\\frac{43}{8}" :db/ensure [:answer/validate]} {:db/id "answer-a4821310-860e-5fda-9174-3a8a5f122a83" :answer/id #uuid "a4821310-860e-5fda-9174-3a8a5f122a83" :answer/type :answer.type/math :answer/value "\\frac{53}{8}" :db/ensure [:answer/validate]} {:db/id "question-6f220269-fce2-5308-a544-a882143be2b5" :question/id #uuid "6f220269-fce2-5308-a544-a882143be2b5" :question/math-academy-id "q-337038" :question/problem "The number of heads facing upward after tossing $3$ unfair coins follows the probability mass function $f(x)$ shown in the table below. What is the expected value of the number of heads facing upward after tossing the $3$ coins? Do not round the answer.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{2}{9}$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ | $\\frac{1}{3}$ |\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{2}{9})+1(\\frac{1}{3})+2(\\frac{1}{9})+3(\\frac{1}{3}) \\\\  & =0+\\frac{1}{3}+\\frac{2}{9}+1 \\\\  & =0+\\frac{3}{9}+\\frac{2}{9}+\\frac{9}{9} \\\\  & =\\frac{0+3+2+9}{9} \\\\  & =\\frac{14}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eff3eb79-2efb-59dd-8b16-b566385dd9e7"] :db/ensure [:question/validate]} {:db/id "answer-field-eff3eb79-2efb-59dd-8b16-b566385dd9e7" :answer-field/id #uuid "eff3eb79-2efb-59dd-8b16-b566385dd9e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ee3a7f8d-4e6d-583c-9448-f641c8a25567" :answer-field/choices ["answer-ee3a7f8d-4e6d-583c-9448-f641c8a25567"] :db/ensure [:answer-field/validate]} {:db/id "answer-ee3a7f8d-4e6d-583c-9448-f641c8a25567" :answer/id #uuid "ee3a7f8d-4e6d-583c-9448-f641c8a25567" :answer/type :answer.type/math :answer/value "\\frac{14}{9}" :db/ensure [:answer/validate]} {:db/id "question-dc6b2040-54a4-56f7-9767-230b7779b10f" :question/id #uuid "dc6b2040-54a4-56f7-9767-230b7779b10f" :question/math-academy-id "q-337188" :question/problem "The sum of the outcomes of one roll of two unfair four-sided dice follows the probability mass function $f(x)$ shown in the table below. What is the expected value of the sum of the outcomes for one roll of the two dice?\n\n| $f(x)$ | $\\frac{3}{40}$ | $\\frac{7}{40}$ | $\\frac{1}{5}$ | $\\frac{1}{4}$ | $\\frac{3}{20}$ | $\\frac{1}{10}$ | $\\frac{1}{20}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5) \\\\  & \\,\\,+6\\cdot f(6)+7\\cdot f(7)+8\\cdot f(8) \\\\  & =2(\\frac{3}{40})+3(\\frac{7}{40})+4(\\frac{1}{5})+5(\\frac{1}{4}) \\\\  & \\,\\,+6(\\frac{3}{20})+7(\\frac{1}{10})+8(\\frac{1}{20}) \\\\  & =\\frac{6}{40}+\\frac{21}{40}+\\frac{4}{5}+\\frac{5}{4}+\\frac{18}{20}+\\frac{7}{10}+\\frac{8}{20} \\\\  & =\\frac{6}{40}+\\frac{21}{40}+\\frac{32}{40}+\\frac{50}{40}+\\frac{36}{40}+\\frac{28}{40}+\\frac{16}{40} \\\\  & =\\frac{6+21+32+50+36+28+16}{40} \\\\  & =\\frac{189}{40} \\\\  & =4.725.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-05e35378-f763-5683-b2ea-96d534b870bf"] :db/ensure [:question/validate]} {:db/id "answer-field-05e35378-f763-5683-b2ea-96d534b870bf" :answer-field/id #uuid "05e35378-f763-5683-b2ea-96d534b870bf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b2b4ec13-aabf-55f7-9a84-533146afb111" :answer-field/choices ["answer-b2b4ec13-aabf-55f7-9a84-533146afb111"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2b4ec13-aabf-55f7-9a84-533146afb111" :answer/id #uuid "b2b4ec13-aabf-55f7-9a84-533146afb111" :answer/type :answer.type/math :answer/value "\\frac{189}{40}" :db/ensure [:answer/validate]} {:db/id 17592186083309 :knowledge-point/questions ["question-ceddea1b-a5cb-5c22-91ab-6571fb7ef388" "question-700fffbb-cd63-5378-9077-32b4c2add6e6" "question-41c4d9f2-fb24-5742-893b-e72bc5478b30" "question-d599b4ec-9437-5cdd-aa0b-91b4481a6586"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ceddea1b-a5cb-5c22-91ab-6571fb7ef388" :question/id #uuid "ceddea1b-a5cb-5c22-91ab-6571fb7ef388" :question/math-academy-id "q-337204" :question/problem "A stack of cards has $2$ cards labeled with four and $6$ cards labeled with ten. If one card is randomly drawn from the stack, what is its expected value?\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the value labeled on a randomly drawn card. Then the support is $S=\\{4,10\\}.$\n\nIn the stack there are $2$ cards labeled with four and $6$ cards labeled with ten (eight cards in total), so the probabilities are as follows:\n\n$$\n\\begin{aligned}P(4) & =\\frac{2}{8}=\\frac{1}{4} \\\\ P(10) & =\\frac{6}{8}=\\frac{3}{4}\\end{aligned}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =4\\cdot f(4)+10\\cdot f(10) \\\\  & =4(\\frac{1}{4})+10(\\frac{3}{4}) \\\\  & =1+\\frac{15}{2} \\\\  & =\\frac{17}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e295c467-cba5-5269-8303-2482a80e3bd4"] :db/ensure [:question/validate]} {:db/id "answer-field-e295c467-cba5-5269-8303-2482a80e3bd4" :answer-field/id #uuid "e295c467-cba5-5269-8303-2482a80e3bd4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f48698d2-8399-5591-8858-d21e6e33a4a6" :answer-field/choices ["answer-f48698d2-8399-5591-8858-d21e6e33a4a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-f48698d2-8399-5591-8858-d21e6e33a4a6" :answer/id #uuid "f48698d2-8399-5591-8858-d21e6e33a4a6" :answer/type :answer.type/math :answer/value "\\frac{17}{2}" :db/ensure [:answer/validate]} {:db/id "question-700fffbb-cd63-5378-9077-32b4c2add6e6" :question/id #uuid "700fffbb-cd63-5378-9077-32b4c2add6e6" :question/math-academy-id "q-84067" :question/problem "Several children were asked how many siblings they have. The number of siblings of each child was recorded below. If $X$ is the number of siblings of a randomly selected child, what is the expected value of $X?$\n\n| Number of siblings | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| Number of Children | $1$ | $5$ | $3$ | $1$ |" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the number of siblings, so we can start by computing the corresponding probabilities. The total number of children is $1+5+3+1=10,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=0)=f(0) & =\\frac{1}{10} \\\\ P(X=1)=f(1) & =\\frac{5}{10}=\\frac{1}{2} \\\\ P(X=2)=f(2) & =\\frac{3}{10} \\\\ P(X=3)=f(3) & =\\frac{1}{10}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{10}$ | $\\frac{1}{2}$ | $\\frac{3}{10}$ | $\\frac{1}{10}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{1}{10})+1(\\frac{1}{2})+2(\\frac{3}{10})+3(\\frac{1}{10}) \\\\  & =0+\\frac{5}{10}+\\frac{6}{10}+\\frac{3}{10} \\\\  & =\\frac{0+5+6+3}{10} \\\\  & =\\frac{14}{10} \\\\  & =1.4\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dd980177-3d4f-5c6d-a6cb-2c5b9aaa3857"] :db/ensure [:question/validate]} {:db/id "answer-field-dd980177-3d4f-5c6d-a6cb-2c5b9aaa3857" :answer-field/id #uuid "dd980177-3d4f-5c6d-a6cb-2c5b9aaa3857" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c751fdf-2bec-56e1-938d-e60711842729" :answer-field/choices ["answer-a90215ce-141d-5583-8efd-be89ae2f0bed" "answer-ede15bcc-7345-509e-8ca3-6f297ed035d7" "answer-5c751fdf-2bec-56e1-938d-e60711842729" "answer-6e02a023-2534-54ea-a95d-0e9b379d35c3" "answer-0ce3784e-cee7-5852-894c-71ed7ce007ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-a90215ce-141d-5583-8efd-be89ae2f0bed" :answer/id #uuid "a90215ce-141d-5583-8efd-be89ae2f0bed" :answer/type :answer.type/math :answer/value "0.8" :db/ensure [:answer/validate]} {:db/id "answer-ede15bcc-7345-509e-8ca3-6f297ed035d7" :answer/id #uuid "ede15bcc-7345-509e-8ca3-6f297ed035d7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5c751fdf-2bec-56e1-938d-e60711842729" :answer/id #uuid "5c751fdf-2bec-56e1-938d-e60711842729" :answer/type :answer.type/math :answer/value "1.4" :db/ensure [:answer/validate]} {:db/id "answer-6e02a023-2534-54ea-a95d-0e9b379d35c3" :answer/id #uuid "6e02a023-2534-54ea-a95d-0e9b379d35c3" :answer/type :answer.type/math :answer/value "1.6" :db/ensure [:answer/validate]} {:db/id "answer-0ce3784e-cee7-5852-894c-71ed7ce007ce" :answer/id #uuid "0ce3784e-cee7-5852-894c-71ed7ce007ce" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-41c4d9f2-fb24-5742-893b-e72bc5478b30" :question/id #uuid "41c4d9f2-fb24-5742-893b-e72bc5478b30" :question/math-academy-id "q-276300" :question/problem "A quality control manager at a warehouse inspects electronic boxes for defective items. The number of faulty items in each box was recorded and summarized below. If $X$ is the number of faulty items in a box, what is the expected value of $X?$\n\n| Number of Boxes | $13$ | $6$ | $4$ | $2$ |\n| --- | --- | --- | --- | --- |\n| Faulty Items | $0$ | $1$ | $2$ | $3$ |\n\n$\\text{E}[X]=$\n{{field-1}}" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the faulty items, so we can start by computing the corresponding probabilities. The total number of boxes is $13+6+4+2=25,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=0)=f(0) & =\\frac{13}{25} \\\\ P(X=1)=f(1) & =\\frac{6}{25} \\\\ P(X=2)=f(2) & =\\frac{4}{25} \\\\ P(X=3)=f(3) & =\\frac{2}{25}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{13}{25}$ | $\\frac{6}{25}$ | $\\frac{4}{25}$ | $\\frac{2}{25}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{13}{25})+1(\\frac{6}{25})+2(\\frac{4}{25})+3(\\frac{2}{25}) \\\\  & =\\frac{6}{25}+\\frac{8}{25}+\\frac{6}{25} \\\\  & =\\frac{6+8+6}{25} \\\\  & =\\frac{20}{25} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-55e2ebfb-2990-504c-a3b7-16d650b15125"] :db/ensure [:question/validate]} {:db/id "answer-field-55e2ebfb-2990-504c-a3b7-16d650b15125" :answer-field/id #uuid "55e2ebfb-2990-504c-a3b7-16d650b15125" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a3a5e633-756d-5e3a-8fa9-0ed6225a69ee" :answer-field/choices ["answer-a3a5e633-756d-5e3a-8fa9-0ed6225a69ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3a5e633-756d-5e3a-8fa9-0ed6225a69ee" :answer/id #uuid "a3a5e633-756d-5e3a-8fa9-0ed6225a69ee" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "question-d599b4ec-9437-5cdd-aa0b-91b4481a6586" :question/id #uuid "d599b4ec-9437-5cdd-aa0b-91b4481a6586" :question/math-academy-id "q-89157" :question/problem "Several households were asked the number of children that lived there. The number of children in each was recorded below. If $X$ is the number of children that live at a randomly selected household, what is the expected value of $X?$\n\n| Number of Children | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| Number of Households | $6$ | $9$ | $6$ | $3$ |" :question/worked-solution "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the number of childen, so we can start by computing the corresponding probabilities. The total number of households is $3+9+6+6=24,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=1)=f(1) & =\\frac{6}{24}=\\frac{1}{4} \\\\ P(X=2)=f(2) & =\\frac{9}{24}=\\frac{3}{8} \\\\ P(X=3)=f(3) & =\\frac{6}{24}=\\frac{1}{4} \\\\ P(X=4)=f(4) & =\\frac{3}{24}=\\frac{1}{8}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{4}$ | $\\frac{3}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4) \\\\  & =1(\\frac{1}{4})+2(\\frac{3}{8})+3(\\frac{1}{4})+4(\\frac{1}{8}) \\\\  & =\\frac{1}{4}+\\frac{3}{4}+\\frac{3}{4}+\\frac{2}{4} \\\\  & =\\frac{1+3+3+2}{4} \\\\  & =\\frac{9}{4} \\\\  & =2.25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-618772c4-492e-57e3-9e76-dc9f3ada338c"] :db/ensure [:question/validate]} {:db/id "answer-field-618772c4-492e-57e3-9e76-dc9f3ada338c" :answer-field/id #uuid "618772c4-492e-57e3-9e76-dc9f3ada338c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2a02737d-84cc-5b65-a38a-d8f95f1427b0" :answer-field/choices ["answer-c5540b63-e212-55cb-b7a9-7c7a2846f551" "answer-7566e7ed-5b8d-55f6-bcd8-3e0711ba276d" "answer-c95ceba2-efcb-54f1-bc4a-d6b2a95fef1a" "answer-2a02737d-84cc-5b65-a38a-d8f95f1427b0" "answer-93cd1bc1-ffd4-50f6-955c-6bee087d74b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5540b63-e212-55cb-b7a9-7c7a2846f551" :answer/id #uuid "c5540b63-e212-55cb-b7a9-7c7a2846f551" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "answer-7566e7ed-5b8d-55f6-bcd8-3e0711ba276d" :answer/id #uuid "7566e7ed-5b8d-55f6-bcd8-3e0711ba276d" :answer/type :answer.type/math :answer/value "1.75" :db/ensure [:answer/validate]} {:db/id "answer-c95ceba2-efcb-54f1-bc4a-d6b2a95fef1a" :answer/id #uuid "c95ceba2-efcb-54f1-bc4a-d6b2a95fef1a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-2a02737d-84cc-5b65-a38a-d8f95f1427b0" :answer/id #uuid "2a02737d-84cc-5b65-a38a-d8f95f1427b0" :answer/type :answer.type/math :answer/value "2.25" :db/ensure [:answer/validate]} {:db/id "answer-93cd1bc1-ffd4-50f6-955c-6bee087d74b2" :answer/id #uuid "93cd1bc1-ffd4-50f6-955c-6bee087d74b2" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id 17592186083273 :knowledge-point/questions ["question-068e9bc7-6f46-5ac9-a057-d5f4aa9a8aeb" "question-267e0e90-b604-5e86-ad43-795951237ad2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-068e9bc7-6f46-5ac9-a057-d5f4aa9a8aeb" :question/id #uuid "068e9bc7-6f46-5ac9-a057-d5f4aa9a8aeb" :question/math-academy-id "q-127818" :question/problem "One way to bet in roulette is to place $\\$1$ on a single number. If the ball lands on that number, the player wins $\\$35.$ If the ball lands on any of the other $37$ slots, the player doesn't win. What is the expected profit, rounded to the nearest dollar, for a player who plays one hundred games on number $12$ in a row?" :question/worked-solution "First of all, profit is revenue minus cost, or in our case, winnings minus cost. So, once we have found the expected winnings after one hundred games, we need to subtract $100\\cdot 1=100$ dollars to account for the price of playing.\n\nNow, let's find the expected winnings and summarize them in a table. If $W$ is the winnings (in dollars) on a single game, and $f(w)$ is the probability mass function for $W,$ then we have the following:\n\n| $f(w)$ | $\\frac{1}{38}$ | $\\frac{37}{38}$ |\n| --- | --- | --- |\n| $w$ | $35$ | $0$ |\n\nThe expected value of $W$ is given by\n\n$$\n\\begin{aligned}\\text{E}[W] & =35\\cdot f(35)+0\\cdot f(0) \\\\  & =35(\\frac{1}{38})+0(\\frac{37}{38}) \\\\  & =\\frac{35}{38} \\\\  & ≈0.92.\\end{aligned}\n$$\n\nThis represents the expected winnings for a single game. So, the expected winnings for $100$ games  on number $12$ is\n\n$$\n100\\cdot \\text{E}[W]=100\\cdot (0.92)=92.\n$$\n\nNow, subtracting the $100$ dollars paid to play, we get that the expected profit (in dollars) is\n\n$$\nE[p]=92-100=-8.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-53865da6-8e44-5bb9-8d40-4d2805caf8a7"] :db/ensure [:question/validate]} {:db/id "answer-field-53865da6-8e44-5bb9-8d40-4d2805caf8a7" :answer-field/id #uuid "53865da6-8e44-5bb9-8d40-4d2805caf8a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b1e0eb6a-bd70-5f35-a14d-f4f095208cc4" :answer-field/choices ["answer-1bec36d6-dfb7-5749-9664-f7f73dc25b79" "answer-2e9bbeaf-98e6-558c-81d6-d0813fc9f4ac" "answer-b1e0eb6a-bd70-5f35-a14d-f4f095208cc4" "answer-59a5f4bc-a0cc-5d8a-b1c9-87ca178ebcf7" "answer-8e4ee2a5-d371-5586-98ed-838864441766"] :db/ensure [:answer-field/validate]} {:db/id "answer-1bec36d6-dfb7-5749-9664-f7f73dc25b79" :answer/id #uuid "1bec36d6-dfb7-5749-9664-f7f73dc25b79" :answer/type :answer.type/text :answer/value "$-\\$10$" :db/ensure [:answer/validate]} {:db/id "answer-2e9bbeaf-98e6-558c-81d6-d0813fc9f4ac" :answer/id #uuid "2e9bbeaf-98e6-558c-81d6-d0813fc9f4ac" :answer/type :answer.type/text :answer/value "$-\\$19$" :db/ensure [:answer/validate]} {:db/id "answer-b1e0eb6a-bd70-5f35-a14d-f4f095208cc4" :answer/id #uuid "b1e0eb6a-bd70-5f35-a14d-f4f095208cc4" :answer/type :answer.type/text :answer/value "$-\\$8$" :db/ensure [:answer/validate]} {:db/id "answer-59a5f4bc-a0cc-5d8a-b1c9-87ca178ebcf7" :answer/id #uuid "59a5f4bc-a0cc-5d8a-b1c9-87ca178ebcf7" :answer/type :answer.type/text :answer/value "$\\$7$" :db/ensure [:answer/validate]} {:db/id "answer-8e4ee2a5-d371-5586-98ed-838864441766" :answer/id #uuid "8e4ee2a5-d371-5586-98ed-838864441766" :answer/type :answer.type/text :answer/value "$\\$9$" :db/ensure [:answer/validate]} {:db/id "question-267e0e90-b604-5e86-ad43-795951237ad2" :question/id #uuid "267e0e90-b604-5e86-ad43-795951237ad2" :question/math-academy-id "q-337346" :question/problem "One way to bet in roulette is to place $\\$2$ on a single number. If the ball lands on that number, the player wins $\\$70.$ If the ball lands on any of the other $37$ slots, the player doesn't win. What is the expected profit, rounded to the nearest dollar, for a player who plays one hundred games on number $8$ in a row?\n\nThe expected profit in dollars is $E(p)=$\n{{field-1}}" :question/worked-solution "First of all, profit is revenue minus cost, or in our case, winnings minus cost. So, once we have found the expected winnings after one hundred games, we need to subtract $100\\cdot 2=200$ dollars to account for the price of playing.\n\nNow, let's find the expected winnings and summarize them in a table. If $W$ is the winnings (in dollars) on a single game, and $f(w)$ is the probability mass function for $W,$ then we have the following:\n\n| $f(w)$ | $\\frac{1}{38}$ | $\\frac{37}{38}$ |\n| --- | --- | --- |\n| $w$ | $70$ | $0$ |\n\nThe expected value of $W$ is given by\n\n$$\n\\begin{aligned}\\text{E}[W] & =70\\cdot f(70)+0\\cdot f(0) \\\\  & =70(\\frac{1}{38})+0(\\frac{37}{38}) \\\\  & =\\frac{70}{38} \\\\  & ≈1.84.\\end{aligned}\n$$\n\nThis represents the expected winnings for a single game. So, the expected winnings for $100$ games on number $8$ is\n\n$$\n100\\cdot \\text{E}[W]=100\\cdot (1.84)=184.\n$$\n\nNow, subtracting the $200$ dollars paid to play, we get that the expected profit (in dollars) is\n\n$$\nE[p]=184-200=-16.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4197adf1-104f-52af-a2fe-ce58ae6658aa"] :db/ensure [:question/validate]} {:db/id "answer-field-4197adf1-104f-52af-a2fe-ce58ae6658aa" :answer-field/id #uuid "4197adf1-104f-52af-a2fe-ce58ae6658aa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f39199e8-353c-5632-85b5-146e5d346bc2" :answer-field/choices ["answer-f39199e8-353c-5632-85b5-146e5d346bc2"] :db/ensure [:answer-field/validate]} {:db/id "answer-f39199e8-353c-5632-85b5-146e5d346bc2" :answer/id #uuid "f39199e8-353c-5632-85b5-146e5d346bc2" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id 17592186083425 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]} {:db/id 17592186059843 :knowledge-point/questions ["question-a462c56c-120f-5159-b0b8-404f14801fe3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a462c56c-120f-5159-b0b8-404f14801fe3" :question/id #uuid "a462c56c-120f-5159-b0b8-404f14801fe3" :question/math-academy-id "q-123595" :question/problem "$\\operatorname{sin}⁡{45}^{∘}=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${45}^{∘}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8fd4e1c0-3680-5d3a-9d0f-c3d351751bcd"] :db/ensure [:question/validate]} {:db/id "answer-field-8fd4e1c0-3680-5d3a-9d0f-c3d351751bcd" :answer-field/id #uuid "8fd4e1c0-3680-5d3a-9d0f-c3d351751bcd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d22384f1-7ee3-57c8-b472-368fa995344e" :answer-field/choices ["answer-bb36dd47-9d34-5a02-9fba-9e0b0e7b2af1" "answer-1dc11e74-5683-5e8d-80d8-76b11e1ef5b6" "answer-95626cd5-58bf-5b05-9d17-272dc4d286b4" "answer-d22384f1-7ee3-57c8-b472-368fa995344e" "answer-243136ce-4a0a-57c9-a550-54229f41104f"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb36dd47-9d34-5a02-9fba-9e0b0e7b2af1" :answer/id #uuid "bb36dd47-9d34-5a02-9fba-9e0b0e7b2af1" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1dc11e74-5683-5e8d-80d8-76b11e1ef5b6" :answer/id #uuid "1dc11e74-5683-5e8d-80d8-76b11e1ef5b6" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-95626cd5-58bf-5b05-9d17-272dc4d286b4" :answer/id #uuid "95626cd5-58bf-5b05-9d17-272dc4d286b4" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d22384f1-7ee3-57c8-b472-368fa995344e" :answer/id #uuid "d22384f1-7ee3-57c8-b472-368fa995344e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-243136ce-4a0a-57c9-a550-54229f41104f" :answer/id #uuid "243136ce-4a0a-57c9-a550-54229f41104f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id 17592186060429 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186059845 :knowledge-point/questions ["question-d25800d2-aaa9-5069-8bc6-84b04968eef5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d25800d2-aaa9-5069-8bc6-84b04968eef5" :question/id #uuid "d25800d2-aaa9-5069-8bc6-84b04968eef5" :question/math-academy-id "q-1696" :question/problem "$\\operatorname{sec}⁡(\\frac{7\\pi }{6})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{7\\pi }{6})=\\frac{1}{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}=-\\frac{2}{\\sqrt{3}}=-\\frac{2\\sqrt{3}}{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa"] :db/ensure [:question/validate]} {:db/id "answer-field-9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa" :answer-field/id #uuid "9ad166a8-68f6-52e5-aeab-c9f3b40cf4fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer-field/choices ["answer-da706140-bf28-56bb-9b3d-9c80fbbb5352" "answer-dbf553dd-432a-5db7-9330-1fe86b00d67e" "answer-f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" "answer-b2225633-3982-500e-aceb-598ad2c9dd69" "answer-d59e1f90-02b8-5b16-90e7-10a8e98457fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-da706140-bf28-56bb-9b3d-9c80fbbb5352" :answer/id #uuid "da706140-bf28-56bb-9b3d-9c80fbbb5352" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/id #uuid "dbf553dd-432a-5db7-9330-1fe86b00d67e" :answer/type :answer.type/math :answer/value "-\\frac{2\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" :answer/id #uuid "f93b95d6-53f4-5c55-b1c0-20f5b8ed7c69" :answer/type :answer.type/math :answer/value "-\\frac{2}{\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "answer-b2225633-3982-500e-aceb-598ad2c9dd69" :answer/id #uuid "b2225633-3982-500e-aceb-598ad2c9dd69" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d59e1f90-02b8-5b16-90e7-10a8e98457fb" :answer/id #uuid "d59e1f90-02b8-5b16-90e7-10a8e98457fb" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id 17592186060340 :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186060977 :tutorial/content "The unit circle provides a convenient way to represent the sine and cosine of special angles in each quadrant. \n\nWe first recall the following:\n\n- The ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-coordinate of any point on the unit circle equals the *cosine* of the corresponding central angle, and\n\n- the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate equals the *sine* of the corresponding central angle.\n\nLet's use the unit circle to list the special values of sine and cosine, starting with the first quadrant. First, we mark off the special angles in this quadrant.\n\n![](images/3a/3a0c6eb5bc286272ef67aee5ef0fa625a6f4e44635413ca43060efc9082b1848.png)\n\nNow, let's write down each point's ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)- and ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinates, corresponding to the cosine and sine of each point's central angle. In addition, we'll highlight the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate at each point.\n\n![](images/6b/6bb6bb7cc95a17c605056e1e1e1ae27bc8cf2f124e419c5e6b9810a72b950508.png)\n\nBefore we move on, observe that if we rotate counterclockwise from the positive ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-axis, we see that the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinates at the special angles are given by the following sequence:\n![](images/ef/ef3998f9651e37dba31e1597a503577243def17e903dbeb5322ab434a4815b3c.svg) \n\nas shown below.\n\n![](images/ae/ae75322c270db13d7ee5ba6079b236b9a18d463f74cc3e5ee70b6fe113d224e3.png)\n\nThere is a similar pattern for the ![](images/fc/fcc5df999e3b49fae1685ee0ab5bd03709804e1dd49f2ee722c4269eb0f5506d.svg)-coordinates (corresponding to the cosine of the central angle). The only difference is that now we go in reverse, from ![](images/26/2614c435bff188ded3027f2a8f1ea011b37b41a1d62d2ff4bae181ce9107b5c2.svg) to ![](images/f1/f12b2ec86446e22fc9d1c982c156c7d089a97fecca1670f416ecfd63cf5899d3.svg) as shown below \n\n![](images/2a/2af7f2c7cf14c017a545a4144ed88dffe7b7f7bfb6e13a2b6144552ef3cfaa6c.png)\n\nTake a moment to ensure you can reproduce this diagram on your own without looking. We'll add to it shortly." :db/ensure [:tutorial/validate]} {:db/id 17592186060978 :tutorial/content "So, we know how the unit circle can be used to list the cosine and sine of the special angles in the *first* quadrant. But what about the other quadrants? \n\nThe values in the remaining quadrants can be obtained from the coordinates in the first quadrant. Let's see how:\n\n- To obtain the points in the *second* quadrant, let's first mark off the special angles in this quadrant. These angles have the same reference angles as the angles in the first quadrant:\n\n- $180^\\circ - 30^\\circ = 150^\\circ$\n\n- $180^\\circ - 45^\\circ = 135^\\circ$\n\n- $180^\\circ - 60^\\circ = 120^\\circ$\n\nWe mark these angles below and include the quadrantal angle $180^\\circ.$\n\n![](images/49/49105a62c4eecffeb32f6777ddf98022c5ca46079a33294e7eeafc9164444cba.png)\n\nNow, we reflect the coordinates in the first quadrant in the $y$-axis. This changes the sign of the $x$-coordinate at each point and leaves the $y$-coordinate unchanged.\n\n![](images/e4/e44980d06903b6570182b99787ca7dec8cceacab2f72dce04fc48b3d7c660059.png)\n\n- To obtain the points in the third quadrant, we first find the special angles in this quadrant. Again, these angles have the same reference angles as the special angles in the first quadrant:\n\n- $180^\\circ + 30^\\circ = 210^\\circ$\n\n- $180^\\circ + 45^\\circ = 225^\\circ$\n\n- $180^\\circ + 60^\\circ = 240^\\circ$\n\nThen, we take the points in the second quadrant and reflect them in the $x$-axis. This changes the sign of the $y$-coordinate at each point and leaves the $x$-coordinate unchanged.\n\n![](images/bb/bbfcf14e39ee122cf1bd7048903ac7f205325c77d4b2899c53619495ffeb8d8c.png)\n\n- Finally, to obtain the points in the fourth quadrant, we first compute the special angles in this quadrant:\n\n- $360^\\circ - 30^\\circ = 330^\\circ$\n\n- $360^\\circ - 45^\\circ = 315^\\circ$\n\n- $360^\\circ - 60^\\circ = 300^\\circ$\n\nThen, we take the points in the first quadrant and reflect them in the $x$-axis. This changes the sign of the $y$-coordinate at each point and leaves the $x$-coordinate unchanged.\n\n![](images/f5/f507964e8fe06cc54ceab447d570bb004b4e9a2b0b8fa3074762e28a41009a2a.png)\n\nTherefore, our complete unit circle is as follows.\n\n![](images/f5/f5006a5a3c363f83e6d4624fc72fefa140e29ef6ef23db16fbab5538b421a058.png)\n\nTake a moment to ensure you can create this diagram yourself without looking. We'll be referring to it often!" :db/ensure [:tutorial/validate]} {:db/id 17592186059943 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186152101 :knowledge-point/questions ["question-37c3bc23-bd02-5d58-b8ef-2de055e363b9" "question-0803d7dd-fe65-5059-8e1e-9052cd416dca" "question-4e68e4d1-4fbe-504a-90e3-9d792c948b3d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-37c3bc23-bd02-5d58-b8ef-2de055e363b9" :question/id #uuid "37c3bc23-bd02-5d58-b8ef-2de055e363b9" :question/math-academy-id "q-174364" :question/problem "Consider the following sets:\n\n$$\nA=\\{{n}^{2}∣n\\in N\\},\\,B=\\{\\frac{2}{n}∣n\\in N\\}\n$$\n\nWhich of the following statements are true?\n\nI. $A=\\{1,4,9,16,…\\}$\n\nII. $A\\cap B=∅$\n\nIII. $A$ and $B$ are disjoint" :question/worked-solution "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nWith that in mind, let's examine our sets.\n\n- Statement I is true.\n\n$$\n\\begin{aligned}A & =\\{{n}^{2}∣n\\in N\\} \\\\  & =\\{1,4,9,16,…\\}\\end{aligned}\n$$\n\n- Statement II is false. Notice that\n\n$$\n\\begin{aligned}B & =\\{\\frac{2}{n}∣n\\in N\\} \\\\  & =\\{2,1,\\frac{2}{3},\\frac{1}{2},…\\}.\\end{aligned}\n$$\n\nThen, the intersection is \n\n$$\n\\begin{aligned}A\\cap B & =\\{1,4,9,16,…\\}\\text{ }\\cap \\{2,1,\\frac{2}{3},\\frac{1}{2},…\\} \\\\  & =\\{1\\}. \\\\  & \\ne ∅.\\end{aligned}\n$$\n\n- Statement III is false. Since the intersection is not empty, the two sets are not disjoint.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-13a24e13-db62-5670-988f-338080298b03"] :db/ensure [:question/validate]} {:db/id "answer-field-13a24e13-db62-5670-988f-338080298b03" :answer-field/id #uuid "13a24e13-db62-5670-988f-338080298b03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-08ce1095-869e-5241-bc0f-d31e7ad9f8b3" :answer-field/choices ["answer-5015133f-8d21-5500-88e1-9e6d7debce1d" "answer-08ce1095-869e-5241-bc0f-d31e7ad9f8b3" "answer-e27bcdd0-120e-5e1a-99dc-043eeeed575e" "answer-760c2ad4-3e54-558d-aea6-b33b0fda4022" "answer-383dc25d-8fd5-552d-8f79-44d5fd794297"] :db/ensure [:answer-field/validate]} {:db/id "answer-5015133f-8d21-5500-88e1-9e6d7debce1d" :answer/id #uuid "5015133f-8d21-5500-88e1-9e6d7debce1d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-08ce1095-869e-5241-bc0f-d31e7ad9f8b3" :answer/id #uuid "08ce1095-869e-5241-bc0f-d31e7ad9f8b3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e27bcdd0-120e-5e1a-99dc-043eeeed575e" :answer/id #uuid "e27bcdd0-120e-5e1a-99dc-043eeeed575e" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-760c2ad4-3e54-558d-aea6-b33b0fda4022" :answer/id #uuid "760c2ad4-3e54-558d-aea6-b33b0fda4022" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-383dc25d-8fd5-552d-8f79-44d5fd794297" :answer/id #uuid "383dc25d-8fd5-552d-8f79-44d5fd794297" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "question-0803d7dd-fe65-5059-8e1e-9052cd416dca" :question/id #uuid "0803d7dd-fe65-5059-8e1e-9052cd416dca" :question/math-academy-id "q-174354" :question/problem "Which of the following pairs of sets are disjoint?\n\nI. $\\{x,y,z\\}$ and $\\{3,6,9\\}$\n\nII. $\\{a,b,c,d,e\\}$ and $\\{a,e,i,o,u\\}$\n\nIII. $\\{1,3,6\\}$ and $\\{3,5,7\\}$" :question/worked-solution "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nWith that in mind, let's examine our sets.\n\n- Pair I is disjoint. Indeed, the intersection of the sets is empty:\n\n$$\n\\{x,y,z\\}\\cap \\{3,6,9\\}=∅\\,\\,✓\n$$\n\n- Pair II is *not* disjoint since the intersection of the sets is not empty:\n\n$$\n\\{a,b,c,d,e\\}\\cap \\{a,e,i,o,u\\}=\\{a,e\\}\\ne ∅\\,\\,\\times\n$$\n\n- Pair III is *not* disjoint since the intersection of the sets is not empty:\n\n$$\n\\{1,3,6\\}\\cap \\{3,5,7\\}=\\{3\\}\\ne ∅\\,\\,\\times\n$$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d7d4f7d2-ef86-5eb2-85dd-e2f3c8149faa"] :db/ensure [:question/validate]} {:db/id "answer-field-d7d4f7d2-ef86-5eb2-85dd-e2f3c8149faa" :answer-field/id #uuid "d7d4f7d2-ef86-5eb2-85dd-e2f3c8149faa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0d3c9d3-d1c2-58fc-b177-2a30b12c641b" :answer-field/choices ["answer-e43a919e-dbae-5753-9e78-0bec425aa4d1" "answer-d0d3c9d3-d1c2-58fc-b177-2a30b12c641b" "answer-6c313729-f3be-5c18-ad10-2bc0c801ac14" "answer-ae87680f-698b-51a4-b00c-fd013d8a5ce6" "answer-05692866-4229-5d75-9f9d-452e956df231"] :db/ensure [:answer-field/validate]} {:db/id "answer-e43a919e-dbae-5753-9e78-0bec425aa4d1" :answer/id #uuid "e43a919e-dbae-5753-9e78-0bec425aa4d1" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d0d3c9d3-d1c2-58fc-b177-2a30b12c641b" :answer/id #uuid "d0d3c9d3-d1c2-58fc-b177-2a30b12c641b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-6c313729-f3be-5c18-ad10-2bc0c801ac14" :answer/id #uuid "6c313729-f3be-5c18-ad10-2bc0c801ac14" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-ae87680f-698b-51a4-b00c-fd013d8a5ce6" :answer/id #uuid "ae87680f-698b-51a4-b00c-fd013d8a5ce6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-05692866-4229-5d75-9f9d-452e956df231" :answer/id #uuid "05692866-4229-5d75-9f9d-452e956df231" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-4e68e4d1-4fbe-504a-90e3-9d792c948b3d" :question/id #uuid "4e68e4d1-4fbe-504a-90e3-9d792c948b3d" :question/math-academy-id "q-174361" :question/problem "Consider the following sets:\n\n$$\nA=\\{n\\in N∣n\\le 5\\},\\,B=\\{n\\in N∣4n+6\\ge 30\\}\n$$\n\nWhich of the following statements are true?\n\nI. $B=\\{6,7,8,…\\}$\n\nII. $A\\cap B=∅$\n\nIII. $A$ and $B$ are disjoint" :question/worked-solution "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nFirst, notice that the elements of $B$ are positive integers that satisfy the inequality \n\n$$\n\\begin{aligned}4n+6 & \\ge 30 \\\\ 4n & \\ge 24 \\\\ n & \\ge 6.\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets.\n\n- Statement I is true.\n\n$$\n\\begin{aligned}B & =\\{n\\in N∣4n+6\\ge 30\\} \\\\  & =\\{n\\in N∣n\\ge 6\\} \\\\  & =\\{6,7,8,…\\}\\end{aligned}\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}A & =\\{n\\in N∣n\\le 5\\} \\\\  & =\\{1,2,3,4,5\\}.\\end{aligned}\n$$\n\nThen, the intersection is \n\n$$\nA\\cap B=\\{1,2,3,4,5\\}\\cap \\{6,7,8,…\\}=∅.\n$$\n\n- Statement III is true. Since the intersection is empty, the two sets are disjoint.\n\nTherefore, the correct answer is \"I, II and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1f9535db-621f-5f39-bbcf-0c1777901654"] :db/ensure [:question/validate]} {:db/id "answer-field-1f9535db-621f-5f39-bbcf-0c1777901654" :answer-field/id #uuid "1f9535db-621f-5f39-bbcf-0c1777901654" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d048225e-a4a7-5052-80ef-c713570ae228" :answer-field/choices ["answer-a2c2d552-3b5b-5938-8934-9322d32ac0ee" "answer-9541011c-3e6d-5e13-9492-3dee782dffb5" "answer-d048225e-a4a7-5052-80ef-c713570ae228" "answer-68379704-f511-5249-a3e0-489aa419a97e" "answer-5d1740e1-d2dd-5592-8b9e-011aed14c64f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2c2d552-3b5b-5938-8934-9322d32ac0ee" :answer/id #uuid "a2c2d552-3b5b-5938-8934-9322d32ac0ee" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-9541011c-3e6d-5e13-9492-3dee782dffb5" :answer/id #uuid "9541011c-3e6d-5e13-9492-3dee782dffb5" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d048225e-a4a7-5052-80ef-c713570ae228" :answer/id #uuid "d048225e-a4a7-5052-80ef-c713570ae228" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-68379704-f511-5249-a3e0-489aa419a97e" :answer/id #uuid "68379704-f511-5249-a3e0-489aa419a97e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5d1740e1-d2dd-5592-8b9e-011aed14c64f" :answer/id #uuid "5d1740e1-d2dd-5592-8b9e-011aed14c64f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186152102 :knowledge-point/questions ["question-568ef841-bdd5-5e7a-98b5-6d308da6308f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-568ef841-bdd5-5e7a-98b5-6d308da6308f" :question/id #uuid "568ef841-bdd5-5e7a-98b5-6d308da6308f" :question/math-academy-id "q-174400" :question/problem "$\\{-6,6\\}⊔\\{-3,3\\}=$" :question/worked-solution "Notice that the sets are disjoint since\n\n$$\n\\{-6,6\\}\\cap \\{-3,3\\}=∅.\n$$\n\nTherefore, the disjoint union is simply the union:\n\n$$\n\\begin{aligned}\\{-6,6\\}⊔\\{-3,3\\} & =\\{-6,6\\}\\cup \\{-3,3\\} \\\\  & =\\{-6,-3,3,6\\}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-26510351-c311-5f98-a5fa-6cce85188af7"] :db/ensure [:question/validate]} {:db/id "answer-field-26510351-c311-5f98-a5fa-6cce85188af7" :answer-field/id #uuid "26510351-c311-5f98-a5fa-6cce85188af7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a4e772e3-2e47-59fd-9fb4-bf6d2e782fbf" :answer-field/choices ["answer-a8d21e03-dacf-5cff-99f4-4336758aa3c2" "answer-a4e772e3-2e47-59fd-9fb4-bf6d2e782fbf" "answer-6a02b5b3-9a49-5756-8128-cdb0eb1a3f7f" "answer-573334bf-035d-5802-ab2b-7e0b3190882a" "answer-24098274-b412-5b55-8dfd-f843d94eef65"] :db/ensure [:answer-field/validate]} {:db/id "answer-a8d21e03-dacf-5cff-99f4-4336758aa3c2" :answer/id #uuid "a8d21e03-dacf-5cff-99f4-4336758aa3c2" :answer/type :answer.type/math :answer/value "\\{(-6,-3),(-6,3),(6,-3),(6,3)\\}" :db/ensure [:answer/validate]} {:db/id "answer-a4e772e3-2e47-59fd-9fb4-bf6d2e782fbf" :answer/id #uuid "a4e772e3-2e47-59fd-9fb4-bf6d2e782fbf" :answer/type :answer.type/math :answer/value "\\{-6,-3,3,6\\}" :db/ensure [:answer/validate]} {:db/id "answer-6a02b5b3-9a49-5756-8128-cdb0eb1a3f7f" :answer/id #uuid "6a02b5b3-9a49-5756-8128-cdb0eb1a3f7f" :answer/type :answer.type/math :answer/value "\\{-6,-3\\}" :db/ensure [:answer/validate]} {:db/id "answer-573334bf-035d-5802-ab2b-7e0b3190882a" :answer/id #uuid "573334bf-035d-5802-ab2b-7e0b3190882a" :answer/type :answer.type/math :answer/value "\\{3,6\\}" :db/ensure [:answer/validate]} {:db/id "answer-24098274-b412-5b55-8dfd-f843d94eef65" :answer/id #uuid "24098274-b412-5b55-8dfd-f843d94eef65" :answer/type :answer.type/math :answer/value "∅" :db/ensure [:answer/validate]} {:db/id 17592186152461 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186152463 :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186152103 :knowledge-point/questions ["question-02e046ed-8ad2-55e9-9c98-624e899595b2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-02e046ed-8ad2-55e9-9c98-624e899595b2" :question/id #uuid "02e046ed-8ad2-55e9-9c98-624e899595b2" :question/math-academy-id "q-174425" :question/problem "Find the disjoint union of the sets ${A}_{1}=\\{3,6\\}$ and ${A}_{2}=\\{4,6\\}.$" :question/worked-solution "Notice that the sets are overlapping since\n\n$$\n\\{3,6\\}\\cap \\{4,6\\}=\\{6\\}\\ne ∅.\n$$\n\nSo, for each of our sets, we form the associated set, where each element is tagged with the corresponding index, as follows:\n\n$$\n\\begin{aligned} & {A}_{1} &  & \\,\\to \\, &  & {A}_{1}^{∗}=\\{(3,1),(6,1)\\} \\\\  & {A}_{2} &  & \\,\\to \\, &  & {A}_{2}^{∗}=\\{(4,2),(6,2)\\}\\end{aligned}\n$$\n\nNow, the disjoint union of our sets is simply the union of the associated tagged sets:\n\n$$\n\\begin{aligned}{A}_{1}⊔{A}_{2} & =\\{3,6\\}⊔\\{4,6\\} \\\\  & ={A}_{1}^{∗}\\cup {A}_{2}^{∗} \\\\  & =\\{(3,1),(6,1)\\}\\cup \\{(4,2),(6,2)\\} \\\\  & =\\{(3,1),(6,1),(4,2),(6,2)\\}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0e822fcc-d6b3-5b6a-8dad-fa775112394a"] :db/ensure [:question/validate]} {:db/id "answer-field-0e822fcc-d6b3-5b6a-8dad-fa775112394a" :answer-field/id #uuid "0e822fcc-d6b3-5b6a-8dad-fa775112394a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f72b726d-b295-5286-ac90-1464705bdcf7" :answer-field/choices ["answer-f72b726d-b295-5286-ac90-1464705bdcf7" "answer-7fbe70f7-7073-5111-a46c-f94a740429ea" "answer-10a20e43-eba9-5e03-bd08-bc9b688a30ad" "answer-153edd96-78fe-5010-932c-a16b3b4cb94b" "answer-ba50df5a-cd39-5b08-b11c-b4df0f1ad715"] :db/ensure [:answer-field/validate]} {:db/id "answer-f72b726d-b295-5286-ac90-1464705bdcf7" :answer/id #uuid "f72b726d-b295-5286-ac90-1464705bdcf7" :answer/type :answer.type/math :answer/value "\\{(3,1),(6,1),(4,2),(6,2)\\}" :db/ensure [:answer/validate]} {:db/id "answer-7fbe70f7-7073-5111-a46c-f94a740429ea" :answer/id #uuid "7fbe70f7-7073-5111-a46c-f94a740429ea" :answer/type :answer.type/math :answer/value "\\{(3,4),(3,6),(6,4),(6,6)\\}" :db/ensure [:answer/validate]} {:db/id "answer-10a20e43-eba9-5e03-bd08-bc9b688a30ad" :answer/id #uuid "10a20e43-eba9-5e03-bd08-bc9b688a30ad" :answer/type :answer.type/math :answer/value "\\{(3,4),(6,6)\\}" :db/ensure [:answer/validate]} {:db/id "answer-153edd96-78fe-5010-932c-a16b3b4cb94b" :answer/id #uuid "153edd96-78fe-5010-932c-a16b3b4cb94b" :answer/type :answer.type/math :answer/value "\\{3,4,6\\}" :db/ensure [:answer/validate]} {:db/id "answer-ba50df5a-cd39-5b08-b11c-b4df0f1ad715" :answer/id #uuid "ba50df5a-cd39-5b08-b11c-b4df0f1ad715" :answer/type :answer.type/math :answer/value "\\{3,4\\}" :db/ensure [:answer/validate]} {:db/id 17592186162643 :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186162044 :knowledge-point/questions ["question-d4dcf09b-7fd5-51e9-80d9-32152841ce22"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d4dcf09b-7fd5-51e9-80d9-32152841ce22" :question/id #uuid "d4dcf09b-7fd5-51e9-80d9-32152841ce22" :question/math-academy-id "q-97989" :question/problem "Consider the matrix $A=\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}$ and the quadratic curve ${x}^{T}\\,Ax=3.$ Given that $A$ has  eigenvalues ${\\lambda }_{1}=10$ and ${\\lambda }_{2}=5,$ find the principal axes of the curve." :question/worked-solution "Notice that $A$ is symmetric. \nThe principal axes of the curve \n\n$$\n{x}^{T}\\,Ax=3\n$$\n\nare the vectors that give an orthonormal eigenvector basis for $A.$ Let's now find these eigenvectors.\n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}-10\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{2}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a323c846-4657-566e-a5fd-187d291c9d9f"] :db/ensure [:question/validate]} {:db/id "answer-field-a323c846-4657-566e-a5fd-187d291c9d9f" :answer-field/id #uuid "a323c846-4657-566e-a5fd-187d291c9d9f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1a0dc931-f995-5347-aa14-643adee1237e" :answer-field/choices ["answer-bf3682ac-7215-584a-b7a8-cde01af0ad65" "answer-41a1b312-a4c9-5ed8-a753-89475be0fb25" "answer-23d8244b-8a6a-5c2f-8ca7-f1e17fd9fd2d" "answer-50a60166-a4d0-5973-950e-e9d7415fe849" "answer-1a0dc931-f995-5347-aa14-643adee1237e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf3682ac-7215-584a-b7a8-cde01af0ad65" :answer/id #uuid "bf3682ac-7215-584a-b7a8-cde01af0ad65" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{2}}\\begin{bmatrix}1 \\\\ 5\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-5 \\\\ 2\\end{bmatrix}$" :db/ensure [:answer/validate]} {:db/id "answer-41a1b312-a4c9-5ed8-a753-89475be0fb25" :answer/id #uuid "41a1b312-a4c9-5ed8-a753-89475be0fb25" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{2}}\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{2}}\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}$" :db/ensure [:answer/validate]} {:db/id "answer-23d8244b-8a6a-5c2f-8ca7-f1e17fd9fd2d" :answer/id #uuid "23d8244b-8a6a-5c2f-8ca7-f1e17fd9fd2d" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{3}}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{3}}\\begin{bmatrix}-1 \\\\ 5\\end{bmatrix}$" :db/ensure [:answer/validate]} {:db/id "answer-50a60166-a4d0-5973-950e-e9d7415fe849" :answer/id #uuid "50a60166-a4d0-5973-950e-e9d7415fe849" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{3}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{3}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}$" :db/ensure [:answer/validate]} {:db/id "answer-1a0dc931-f995-5347-aa14-643adee1237e" :answer/id #uuid "1a0dc931-f995-5347-aa14-643adee1237e" :answer/type :answer.type/text :answer/value "$\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}$" :db/ensure [:answer/validate]} {:db/id "activity-00ff8ea0-edff-583f-890b-dee276875fac" :activity/id #uuid "00ff8ea0-edff-583f-890b-dee276875fac" :activity/title "Reducing a Quadratic Curve to Its Principal Axes" :activity/type :activity.type/review :activity/scope 17592186049750 :activity/course 17592186046673 :activity/steps ["step-7148b6dc-5462-53d7-b362-ba92302a97f2" "step-c1373035-5cf1-5943-b35e-0caec7a87e03" "step-bf221691-b747-5306-b82b-6ad8ac169966" "step-c5bef920-5869-56ae-ae31-b6c165811695" "step-ef0fa292-195b-5d7e-9069-13a2db1d342f"] :activity/first-step "step-7148b6dc-5462-53d7-b362-ba92302a97f2" :db/ensure [:activity/validate]} {:db/id "step-7148b6dc-5462-53d7-b362-ba92302a97f2" :step/id #uuid "7148b6dc-5462-53d7-b362-ba92302a97f2" :step/content 17592186162643 :step/next "step-c1373035-5cf1-5943-b35e-0caec7a87e03" :db/ensure [:step/validate]} {:db/id "step-c1373035-5cf1-5943-b35e-0caec7a87e03" :step/id #uuid "c1373035-5cf1-5943-b35e-0caec7a87e03" :step/content 17592186404822 :step/next "step-bf221691-b747-5306-b82b-6ad8ac169966" :db/ensure [:step/validate]} {:db/id "step-bf221691-b747-5306-b82b-6ad8ac169966" :step/id #uuid "bf221691-b747-5306-b82b-6ad8ac169966" :step/content "question-d4dcf09b-7fd5-51e9-80d9-32152841ce22" :step/next "step-c5