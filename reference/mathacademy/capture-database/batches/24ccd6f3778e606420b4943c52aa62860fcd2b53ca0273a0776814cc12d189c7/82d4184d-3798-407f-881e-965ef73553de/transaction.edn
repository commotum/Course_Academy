78558b7-752b-50a1-8021-c4183d8058d1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-578558b7-752b-50a1-8021-c4183d8058d1" :question/id #uuid "578558b7-752b-50a1-8021-c4183d8058d1" :question/math-academy-id "q-82379" :question/problem "![](images/51/51ed86e455d0716953ad3d083646483d023ff7db6d8f45a9f27e4324d00b21db.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(-46)?$" :question/worked-solution "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep adding $4$ to the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(-46) & =f(-46+4) \\\\  & =f(-46+2\\cdot 4) \\\\  & =⋯ \\\\  & =f(-46+11\\cdot 4) \\\\  & =f(-2) \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90"] :db/ensure [:question/validate]} {:db/id "answer-field-d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90" :answer-field/id #uuid "d5b4eab5-1a97-503e-8f9c-d8f2be8e4c90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d58a163b-940a-53f9-9d9d-417b99759dae" :answer-field/choices ["answer-2a865695-6d64-5c60-94d7-9598fdb6c8f9" "answer-b2b705bd-6870-5d3b-84f9-133f603afda9" "answer-4d445e86-f6dc-50fb-a899-152c417f9ddf" "answer-d58a163b-940a-53f9-9d9d-417b99759dae" "answer-c5136637-fcfa-5dcd-b242-2b5729bb2d68"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/id #uuid "2a865695-6d64-5c60-94d7-9598fdb6c8f9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/id #uuid "b2b705bd-6870-5d3b-84f9-133f603afda9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-4d445e86-f6dc-50fb-a899-152c417f9ddf" :answer/id #uuid "4d445e86-f6dc-50fb-a899-152c417f9ddf" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-d58a163b-940a-53f9-9d9d-417b99759dae" :answer/id #uuid "d58a163b-940a-53f9-9d9d-417b99759dae" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-c5136637-fcfa-5dcd-b242-2b5729bb2d68" :answer/id #uuid "c5136637-fcfa-5dcd-b242-2b5729bb2d68" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-ac0004d1-e33b-579f-a242-badcc09a2477" :question/id #uuid "ac0004d1-e33b-579f-a242-badcc09a2477" :question/math-academy-id "q-165275" :question/problem "![](images/79/79fbfbbc0ba9421d770699e663d572da21fa40b87d7d361e56797cd666e05df6.png)\n\nPart of the graph of a function $y=f(x)$ with period $3$ is shown above. What is the graph of $y=f(x)$ on the interval $-4\\le x\\le 5?$" :question/worked-solution "The graph above shows the function in the interval $-1\\le x\\le 2.$\n\nSince this interval has length $3,$ and the period of the function is also $3,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $3.$\n\n![](images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b380c2e7-189c-577f-a4bc-c298b9d70668"] :db/ensure [:question/validate]} {:db/id "answer-field-b380c2e7-189c-577f-a4bc-c298b9d70668" :answer-field/id #uuid "b380c2e7-189c-577f-a4bc-c298b9d70668" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4344818a-a04e-54e5-b442-c2ab900ea89f" :answer-field/choices ["answer-fb931fc8-bdbe-59ce-a0da-f3e4109eaca2" "answer-4ab6011d-ba6e-542d-bd33-45bcd6fc3cda" "answer-7e0fa81d-741a-58b6-bcd2-d458fb5d3c04" "answer-4344818a-a04e-54e5-b442-c2ab900ea89f" "answer-0c3f23c6-2efe-5208