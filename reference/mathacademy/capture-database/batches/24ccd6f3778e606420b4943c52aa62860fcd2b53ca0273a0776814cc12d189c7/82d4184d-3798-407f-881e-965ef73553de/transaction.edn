3139617-fd72-5761-bd08-a02d6f83f92f" :step/id #uuid "33139617-fd72-5761-bd08-a02d6f83f92f" :step/content "question-81171e25-e5ad-5118-af05-1058347bd84c" :step/next "step-2ef5b5f9-fd4f-527a-8672-0d1fd4f4c389" :db/ensure [:step/validate]} {:db/id "step-2ef5b5f9-fd4f-527a-8672-0d1fd4f4c389" :step/id #uuid "2ef5b5f9-fd4f-527a-8672-0d1fd4f4c389" :step/content 17592186234038 :step/next "step-b7d1b9d2-8d6a-585c-ae7c-8123b1be4a0c" :db/ensure [:step/validate]} {:db/id "step-b7d1b9d2-8d6a-585c-ae7c-8123b1be4a0c" :step/id #uuid "b7d1b9d2-8d6a-585c-ae7c-8123b1be4a0c" :step/content 17592186234131 :step/next "step-40a96396-80a6-5aed-88d6-32996f4ae12b" :db/ensure [:step/validate]} {:db/id "step-40a96396-80a6-5aed-88d6-32996f4ae12b" :step/id #uuid "40a96396-80a6-5aed-88d6-32996f4ae12b" :step/content "question-578558b7-752b-50a1-8021-c4183d8058d1" :step/next "step-f54f9dd9-6af8-5e82-a8c9-c98b06f1de85" :db/ensure [:step/validate]} {:db/id "step-f54f9dd9-6af8-5e82-a8c9-c98b06f1de85" :step/id #uuid "f54f9dd9-6af8-5e82-a8c9-c98b06f1de85" :step/content "question-ac0004d1-e33b-579f-a242-badcc09a2477" :db/ensure [:step/validate]} {:db/id "activity-bf0626c4-30df-57a6-977b-ab7a7032a894" :activity/id #uuid "bf0626c4-30df-57a6-977b-ab7a7032a894" :activity/title "Calculating Flux in Two-Dimensional Vector Fields" :activity/type :activity.type/review :activity/scope 17592186050793 :activity/course 17592186046668 :activity/steps ["step-065f4f4c-48e3-590c-b5e4-ef6c92a8335e" "step-e6c63510-5bd6-5eb2-af63-b34178b9e8e5" "step-0639941a-dbef-51ef-941b-1ba2f1461b7a" "step-a7dae7eb-2366-50b6-908c-5cdea559afe7" "step-a099945a-938f-5e92-8ad0-e1f19c59133c"] :activity/first-step "step-065f4f4c-48e3-590c-b5e4-ef6c92a8335e" :db/ensure [:activity/validate]} {:db/id "step-065f4f4c-48e3-590c-b5e4-ef6c92a8335e" :step/id #uuid "065f4f4c-48e3-590c-b5e4-ef6c92a8335e" :step/content 17592186180040 :step/next "step-e6c63510-5bd6-5eb2-af63-b34178b9e8e5" :db/ensure [:step/validate]} {:db/id "step-e6c63510-5bd6-5eb2-af63-b34178b9e8e5" :step/id #uuid "e6c63510-5bd6-5eb2-af63-b34178b9e8e5" :step/content 17592186262702 :step/next "step-0639941a-dbef-51ef-941b-1ba2f1461b7a" :db/ensure [:step/validate]} {:db/id "step-0639941a-dbef-51ef-941b-1ba2f1461b7a" :step/id #uuid "0639941a-dbef-51ef-941b-1ba2f1461b7a" :step/content 17592186421762 :step/next "step-a7dae7eb-2366-50b6-908c-5cdea559afe7" :db/ensure [:step/validate]} {:db/id "step-a7dae7eb-2366-50b6-908c-5cdea559afe7" :step/id #uuid "a7dae7eb-2366-50b6-908c-5cdea559afe7" :step/content 17592186262711 :step/next "step-a099945a-938f-5e92-8ad0-e1f19c59133c" :db/ensure [:step/validate]} {:db/id "step-a099945a-938f-5e92-8ad0-e1f19c59133c" :step/id #uuid "a099945a-938f-5e92-8ad0-e1f19c59133c" :step/content 17592186262714 :db/ensure [:step/validate]} {:db/id 17592186059653 :knowledge-point/questions ["question-903d6591-71d0-55aa-98cb-3913a9cd46ac" "question-b48e833b-67d8-59d3-81e1-297aecf64a45"] :db/ensure [:knowledge-point/validate]} {:db/id "question-903d6591-71d0-55aa-98cb-3913a9cd46ac" :question/id #uuid "903d6591-71d0-55aa-98cb-3913a9cd46ac" :question/math-academy-id "q-6409" :question/problem "![](images/43/43a50373c9cfa5925a01054ab5eb465ac8a6220fced41ab46d8e026908884537.png)\n\nCalculate the length of the side $x$, giving your answer to two decimal places." :question/worked-solution "The Law of Cosines states that\n\n$$\n{x}^{2}={y}^{2}+{z}^{2}-2yz\\operatorname{cos}⁡X.\n$$\n\nHere, we have\n\n$$\nm∠X={66}^{∘},\\,y=16,\\,z=19.\n$$\n\nSubstituting the numbers into the formula gives\n\n$$\n\\begin{aligned}{x}^{2} & ={16}^{2}+{19}^{2}-2(16)(19)\\operatorname{cos}⁡{66}^{∘} \\\\  & =256+361-608\\operatorname{cos}⁡{66}^{∘} \\\\  & =617-608(0.406\\,73…) \\\\  & =617-247.295\\,88 \\\\  & =369.704\\,12\\end{aligned}\n$$\n\nrounded to $5$ decimal places\n\nTaking the square root gives\n\n$$\nx=\\sqrt{369.708\\,16}=19.23\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3bbe43c0-91be-5bd2-8a68-52cc63b578a5"] :db/ensure [:question/validate]} {:db/id "answer-field-3bbe43c0-91be-5bd2-8a68-52cc63b578a5" :answer-field/id #uuid "3bbe43c0-91be-5bd2-8a68-52cc63b578a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9c9dd926-9dc5-5342-8887-1c800d75fce0" :answer-field/choices ["answer-b6227353-fd1f-588c-87c0-4d2fbcb0ec82" "answer-efac4f0d-dc62-5b54-bc2c-d45e89767fce" "answer-9c9dd926-9dc5-5342-8887-1c800d75fce0" "answer-b89436fa-8ee2-59d5-8e46-dec0a28c1f74" "answer-60afb59e-20de-5529-866a-21d64ca9864f"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6227353-fd1f-588c-87c0-4d2fbcb0ec82" :answer/id #uuid "b6227353-fd1f-588c-87c0-4d2fbcb0ec82" :answer/type :answer.type/math :answer/value "18.33" :db/ensure [:answer/validate]} {:db/id "answer-efac4f0d-dc62-5b54-bc2c-d45e89767fce" :answer/id #uuid "efac4f0d-dc62-5b54-bc2c-d45e89767fce" :answer/type :answer.type/math :answer/value "18.65" :db/ensure [:answer/validate]} {:db/id "answer-9c9dd926-9dc5-5342-8887-1c800d75fce0" :answer/id #uuid "9c9dd926-9dc5-5342-8887-1c800d75fce0" :answer/type :answer.type/math :answer/value "19.23" :db/ensure [:answer/validate]} {:db/id "answer-b89436fa-8ee2-59d5-8e46-dec0a28c1f74" :answer/id #uuid "b89436fa-8ee2-59d5-8e46-dec0a28c1f74" :answer/type :answer.type/math :answer/value "19.80" :db/ensure [:answer/validate]} {:db/id "answer-60afb59e-20de-5529-866a-21d64ca9864f" :answer/id #uuid "60afb59e-20de-5529-866a-21d64ca9864f" :answer/type :answer.type/math :answer/value "20.19" :db/ensure [:answer/validate]} {:db/id "question-b48e833b-67d8-59d3-81e1-297aecf64a45" :question/id #uuid "b48e833b-67d8-59d3-81e1-297aecf64a45" :question/math-academy-id "q-14692" :question/problem "![](images/66/66d24d8cc70ffaed2421d0a5a0086fd7848b4d3e98bc8a6e87588c6c2b04e19d.png)\n\nCalculate the length of the side $c$, giving your answer to two decimal places." :question/worked-solution "The Law of Cosines states that\n\n$$\n{c}^{2}={a}^{2}+{b}^{2}-2ab\\operatorname{cos}⁡C.\n$$\n\nHere, we have\n\n$$\nm∠C={43}^{∘},\\,a=10,\\,b=13.\n$$\n\nSubstituting the numbers into the formula gives\n\n$$\n\\begin{aligned}{c}^{2} & ={10}^{2}+{13}^{2}-2(10)(13)\\operatorname{cos}⁡{43}^{∘} \\\\  & =100+169-260\\operatorname{cos}⁡{43}^{∘} \\\\  & =269-260(0.731\\,35…) \\\\  & =269-190.151\\,96 \\\\  & =78.848\\,04.\\end{aligned}\n$$\n\nrounded to $5$ decimal places\n\nTaking the square root gives\n\n$$\nc=\\sqrt{78.848\\,04}=8.88\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c88c1875-f160-569e-9282-5ba3baa13df9"] :db/ensure [:question/validate]} {:db/id "answer-field-c88c1875-f160-569e-9282-5ba3baa13df9" :answer-field/id #uuid "c88c1875-f160-569e-9282-5ba3baa13df9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-743ab8f6-0462-5ecf-ade3-7484e3a5260d" :answer-field/choices ["answer-309e10fe-5899-53fa-abb8-cefdf02e6c05" "answer-f076441a-3c72-578b-a6a9-77ba9855c9fb" "answer-743ab8f6-0462-5ecf-ade3-7484e3a5260d" "answer-780e6ca6-bcc8-586b-a1a2-2c6f926a90aa" "answer-2363919f-7752-5ca9-81ef-e4fd3d83132e"] :db/ensure [:answer-field/validate]} {:db/id "answer-309e10fe-5899-53fa-abb8-cefdf02e6c05" :answer/id #uuid "309e10fe-5899-53fa-abb8-cefdf02e6c05" :answer/type :answer.type/math :answer/value "7.23" :db/ensure [:answer/validate]} {:db/id "answer-f076441a-3c72-578b-a6a9-77ba9855c9fb" :answer/id #uuid "f076441a-3c72-578b-a6a9-77ba9855c9fb" :answer/type :answer.type/math :answer/value "7.85" :db/ensure [:answer/validate]} {:db/id "answer-743ab8f6-0462-5ecf-ade3-7484e3a5260d" :answer/id #uuid "743ab8f6-0462-5ecf-ade3-7484e3a5260d" :answer/type :answer.type/math :answer/value "8.88" :db/ensure [:answer/validate]} {:db/id "answer-780e6ca6-bcc8-586b-a1a2-2c6f926a90aa" :answer/id #uuid "780e6ca6-bcc8-586b-a1a2-2c6f926a90aa" :answer/type :answer.type/math :answer/value "9.15" :db/ensure [:answer/validate]} {:db/id "answer-2363919f-7752-5ca9-81ef-e4fd3d83132e" :answer/id #uuid "2363919f-7752-5ca9-81ef-e4fd3d83132e" :answer/type :answer.type/math :answer/value "9.57" :db/ensure [:answer/validate]} {:db/id 17592186059654 :knowledge-point/questions ["question-39fc3bcb-e781-5ee0-b172-9c69c7f5c440" "question-9ede5978-9720-5b14-aefb-d172677e353f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-39fc3bcb-e781-5ee0-b172-9c69c7f5c440" :question/id #uuid "39fc3bcb-e781-5ee0-b172-9c69c7f5c440" :question/math-academy-id "q-201" :question/problem "A triangle has sides $a$, $b$, and $c.$ The sides $a$, $b$, and $c$ are of lengths  $9$, $12$, and $18$, respectively. What is the measure of the angle between the sides $b$ and $c?$ Round your answer to two decimal places." :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/de/dede0326d992509dedf1c3a2854b47076ccc48ebf0e07705c8c12762d8ecdead.png)\n\nWe use the Law of Cosines to solve for angle $A:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\n \n\nHere, we have\n\n$$\na=9,\\,b=12,\\,c=18.\n$$\n\nThis gives \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{12}^{2}+{18}^{2}-{9}^{2}}{2(12)(18)} \\\\  & =\\frac{144+324-81}{432} \\\\  & =\\frac{387}{432}\\end{aligned}\n$$\n\n \nTherefore,\n\n$$\n\\begin{aligned}m∠F & =\\operatorname{arccos}⁡(\\frac{387}{432}) \\\\  & ={26.38}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-264c3506-720d-5be8-870e-eb9352af9f27"] :db/ensure [:question/validate]} {:db/id "answer-field-264c3506-720d-5be8-870e-eb9352af9f27" :answer-field/id #uuid "264c3506-720d-5be8-870e-eb9352af9f27" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6fa4e6b5-7b61-5d05-8391-af677ab50fe6" :answer-field/choices ["answer-9914af0e-f526-50f6-98f8-1152e4ec30ff" "answer-88480d0d-769a-530a-9275-5454a6d74513" "answer-6fa4e6b5-7b61-5d05-8391-af677ab50fe6" "answer-05ee243d-a0f6-58ea-a3e3-0cc51073be09" "answer-dcd7adc3-cc26-59cb-97d3-e0576be8c6d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-9914af0e-f526-50f6-98f8-1152e4ec30ff" :answer/id #uuid "9914af0e-f526-50f6-98f8-1152e4ec30ff" :answer/type :answer.type/math :answer/value "{20.73}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-88480d0d-769a-530a-9275-5454a6d74513" :answer/id #uuid "88480d0d-769a-530a-9275-5454a6d74513" :answer/type :answer.type/math :answer/value "{23.62}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-6fa4e6b5-7b61-5d05-8391-af677ab50fe6" :answer/id #uuid "6fa4e6b5-7b61-5d05-8391-af677ab50fe6" :answer/type :answer.type/math :answer/value "{26.38}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-05ee243d-a0f6-58ea-a3e3-0cc51073be09" :answer/id #uuid "05ee243d-a0f6-58ea-a3e3-0cc51073be09" :answer/type :answer.type/math :answer/value "{27.42}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-dcd7adc3-cc26-59cb-97d3-e0576be8c6d5" :answer/id #uuid "dcd7adc3-cc26-59cb-97d3-e0576be8c6d5" :answer/type :answer.type/math :answer/value "{29.38}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-9ede5978-9720-5b14-aefb-d172677e353f" :question/id #uuid "9ede5978-9720-5b14-aefb-d172677e353f" :question/math-academy-id "q-14701" :question/problem "![](images/40/40ee0a065e8733bd1ab22c04af39b358da5106791af6b99017cef1d07c13abcd.png)\n\nFor the triangle above, find $m∠A$ in degrees to two decimal places." :question/worked-solution "We use the Law of Cosines to solve for angle $A:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A &=\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\nHere, we have\n\n$$\na=5,\\,b=8,\\,c=9.\n$$\n\nThis gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{9}^{2}+{8}^{2}-{5}^{2}}{2(9)(8)} \\\\  & =\\frac{81+64-25}{144} \\\\  & =\\frac{120}{144} \\\\  & =\\frac{5}{6}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}m∠A & =\\operatorname{arccos}⁡(\\frac{5}{6}) \\\\  & ={33.56}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5f77438e-6a65-5147-9492-745b947b2082"] :db/ensure [:question/validate]} {:db/id "answer-field-5f77438e-6a65-5147-9492-745b947b2082" :answer-field/id #uuid "5f77438e-6a65-5147-9492-745b947b2082" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5a328bb2-83f5-57f5-b38d-f472331c7c17" :answer-field/choices ["answer-fa7753a4-af15-5a0d-94f5-f6eecf8f7ddb" "answer-5a328bb2-83f5-57f5-b38d-f472331c7c17" "answer-6c4ac95c-8556-5fbf-965a-0eb4c8e0345a" "answer-183e7e96-ee7e-5850-a1bf-75f30a215f0e" "answer-84465da0-5d9b-563a-a817-64751d321a8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa7753a4-af15-5a0d-94f5-f6eecf8f7ddb" :answer/id #uuid "fa7753a4-af15-5a0d-94f5-f6eecf8f7ddb" :answer/type :answer.type/math :answer/value "{28.18}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-5a328bb2-83f5-57f5-b38d-f472331c7c17" :answer/id #uuid "5a328bb2-83f5-57f5-b38d-f472331c7c17" :answer/type :answer.type/math :answer/value "{33.56}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-6c4ac95c-8556-5fbf-965a-0eb4c8e0345a" :answer/id #uuid "6c4ac95c-8556-5fbf-965a-0eb4c8e0345a" :answer/type :answer.type/math :answer/value "{36.44}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-183e7e96-ee7e-5850-a1bf-75f30a215f0e" :answer/id #uuid "183e7e96-ee7e-5850-a1bf-75f30a215f0e" :answer/type :answer.type/math :answer/value "{39.81}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-84465da0-5d9b-563a-a817-64751d321a8c" :answer/id #uuid "84465da0-5d9b-563a-a817-64751d321a8c" :answer/type :answer.type/math :answer/value "{44.26}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186060882 :tutorial/content "Suppose we have a general triangle where\n\n- side $a$ is *opposite* angle $\\angle A,$\n\n- side $b$ is *opposite* angle $\\angle B,$ and\n\n- side $c$ is *opposite* angle $\\angle C,$\n\nas follows:\n\n![](images/8f/8f3d3bf4824508ef152e8d8d567672d7d61fb36e0ffb533d97be7294e9198956.png)\n\nThe **law of cosines** states that\n\n$$\n\\begin{aligned}{a}^{2} & ={b}^{2}+{c}^{2}-2bc\\operatorname{cos}⁡A \\\\ {b}^{2} & ={a}^{2}+{c}^{2}-2ac\\operatorname{cos}⁡B \\\\ {c}^{2} & ={a}^{2}+{b}^{2}-2ab\\operatorname{cos}⁡C.\\end{aligned}\n$$\n\nWe can use this to calculate the length of one side when we know two sides and one angle.\n\nIf we look at the law of cosines we see that it's quite similar to the Pythagorean theorem:\n\n$$\na^2+b^2=c^2\n$$\n\nBut remember that the Pythagorean theorem can *only* be used for a *right-angled triangle*!\n\n![](images/db/db9ed4aac9ca46ffc95d393d863cb09e9ba874caf0008410937f961fdf6c7ab6.png)\n\nThe law of cosines is more general and can be used on *any* triangle.\n\n**Note:** To remember the law of cosines, it's helpful to notice that the equations always follow the same pattern:\n\n$$\n\\begin{aligned}{\\begin{pmatrix}\\,\\text{side opposite}\\, \\\\ \\,\\text{the angle}\\,\\end{pmatrix}}^{2}\\,=\\,{\\begin{pmatrix}\\,\\text{adjacent}\\, \\\\ \\,\\text{side}\\,\\end{pmatrix}}^{2}\\,+\\,{\\begin{pmatrix}\\,\\text{adjacent}\\, \\\\ \\,\\text{other side}\\,\\end{pmatrix}}^{2}\\,-\\,2\\begin{pmatrix}\\,\\text{adjacent}\\, \\\\ \\,\\text{side}\\,\\end{pmatrix}\\begin{pmatrix}\\,\\text{adjacent}\\, \\\\ \\,\\text{other side}\\,\\end{pmatrix}\\operatorname{cos}⁡(\\text{angle}).\\end{aligned}\n$$\n\nWe'll show how this formula can be derived at the end of the lesson." :db/ensure [:tutorial/validate]} {:db/id 17592186060884 :tutorial/content "Let's look at our general triangle again.\n\n![](images/8f/8f3d3bf4824508ef152e8d8d567672d7d61fb36e0ffb533d97be7294e9198956.png)\n\nWhen we know the lengths of three sides of a triangle, we rearrange the law of cosines to find an angle:\n\n$$\n\\begin{aligned}{a}^{2} & ={b}^{2}+{c}^{2}-2bc\\operatorname{cos}⁡A \\\\ 2bc\\operatorname{cos}⁡A & ={b}^{2}+{c}^{2}-{a}^{2} \\\\ \\operatorname{cos}⁡A & =\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\nSo, for all the angles, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}, \\\\ \\operatorname{cos}⁡B & =\\frac{{a}^{2}+{c}^{2}-{b}^{2}}{2ac}, \\\\ \\operatorname{cos}⁡C & =\\frac{{a}^{2}+{b}^{2}-{c}^{2}}{2ab}.\\end{aligned}\n$$\n\nIt's helpful to notice that the equations always follow the same pattern:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\text{angle})=\\frac{{\\begin{pmatrix}\\text{adjacent} \\\\ \\text{side}\\end{pmatrix}}^{2}+{\\begin{pmatrix}\\text{adjacent} \\\\ \\text{other side}\\end{pmatrix}}^{2}-{\\begin{pmatrix}\\text{side opposite} \\\\ \\text{the angle}\\end{pmatrix}}^{2}}{2\\begin{pmatrix}\\text{adjacent} \\\\ \\text{side}\\end{pmatrix}\\begin{pmatrix}\\text{adjacent} \\\\ \\text{other side}\\end{pmatrix}}\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186060863 :tutorial/content "Let's now derive the law of cosines in the following form:\n\n$$\na^2 = b^2 + c^2 - 2bc\\cos A\n$$\n\nConsider $\\triangle ABC$ with sides of lengths $a,b,$ and $c,$ as shown below. \n\n![](images/7c/7cc2a0cbb6a02af829e070fc54cfdbe616683f86527b119a530053a34048e699.png)\n\nLet's now add the height $\\overline{CH}$ and assume it has length $h,$ as shown.\n\n![](images/d4/d4e80b2b54283ea353b687d959e9d8fc6c9303e85081c0a46b48703ee3dae7d5.png)\n\nThe remainder of this proof consists of two steps:\n\n- **Step 1**: Write down expressions for $\\cos A$ and $\\sin A.$\n\n- **Step 2**: Apply the Pythagorean theorem to $\\triangle BHC,$ and simplify.\n\nUsing elementary trigonometry, we have\n\n$$\n\\cos A = \\dfrac{AH}{b}, \\qquad \\sin A = \\dfrac{h}{b},\n$$\n\nwhich can be written as\n\n$$\nAH =  b\\cos A, \\qquad h = b\\sin A.\n$$\n\nApplying the Pythagorean theorem to $\\triangle BHC$ and using our expression for $h,$ we have\n\n$$\n\\begin{aligned}{a}^{2} & =(BH)^{2}+{h}^{2} \\\\ {a}^{2} & =(BH)^{2}+{b}^{2}{sin}^{2}⁡A.\\end{aligned}\n$$\n\nNow, consider the length of the side $\\overline{AB}.$ Since $\\overline{AB}$ consists of two segments, $\\overline{AH}$ and $\\overline{BH},$ we have\n\n$$\nc = AH + BH\\quad \\Longrightarrow\\quad BH = c - AH,\n$$\n\nand using our expression for $AH,$ we have\n\n$$\nBH = c - b\\cos A.\n$$\n\nSubstituting this into our expression for $a^2,$ we have\n\n$$\n\\begin{aligned}{a}^{2} & =(BH)^{2}+{b}^{2}{sin}^{2}⁡A \\\\  & =(c-b\\operatorname{cos}⁡A)^{2}+{b}^{2}{sin}^{2}⁡A \\\\  & ={c}^{2}-2bc\\operatorname{cos}⁡A+{b}^{2}{cos}^{2}⁡A+{b}^{2}{sin}^{2}⁡A \\\\  & ={b}^{2}{cos}^{2}⁡A+{b}^{2}{sin}^{2}⁡A+{c}^{2}-2bc\\operatorname{cos}⁡A \\\\  & ={b}^{2}({cos}^{2}⁡A+{sin}^{2}⁡A)+{c}^{2}-2bc\\operatorname{cos}⁡A.\\end{aligned}\n$$\n\nIt can be shown that $\\cos^2A + \\sin^2 A = 1$ for any angle $A$ (this is the Pythagorean theorem in trigonometric form). Therefore, we have\n\n$$\na^2 = b^2 + c^2 - 2bc\\cos A\n$$\n\nas required.\n\nWe can use a similar argument to prove the following results:\n\n$$\n\\begin{aligned}{b}^{2} &={a}^{2}+{c}^{2}-2ac\\operatorname{cos}⁡B \\\\ {c}^{2} &={a}^{2}+{b}^{2}-2ab\\operatorname{cos}⁡C\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186059897 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186110595 :knowledge-point/questions ["question-19a2dc0a-21a4-5b89-85c8-47422a295e17" "question-e0b9a214-575e-56bc-9016-1d953bb568c0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-19a2dc0a-21a4-5b89-85c8-47422a295e17" :question/id #uuid "19a2dc0a-21a4-5b89-85c8-47422a295e17" :question/math-academy-id "q-974" :question/problem "Given that $\\frac{5}{2}\\cdot {3}^{x}=5,$ find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{2}\\cdot {3}^{x} & =5 \\\\ {3}^{x} & =2\\end{aligned}\n$$\n\nNow, we take ${log}_{3}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{3}^{x} & =2 \\\\ {log}_{3}⁡({3}^{x}) & ={log}_{3}⁡(2) \\\\ x & ={log}_{3}⁡(2)\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using the change of base formula:\n\n$$\nx=\\frac{\\operatorname{log}⁡(2)}{\\operatorname{log}⁡(3)}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.631\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f58ba2f4-b668-5a8c-92f5-c9264d481c97"] :db/ensure [:question/validate]} {:db/id "answer-field-f58ba2f4-b668-5a8c-92f5-c9264d481c97" :answer-field/id #uuid "f58ba2f4-b668-5a8c-92f5-c9264d481c97" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" :answer-field/choices ["answer-6d3ecb1e-79b9-5c0c-8d13-23fcec2c2084" "answer-de3f796d-328d-51b3-a6f9-559142e7a197" "answer-014ac208-df51-5c62-a006-7a4b9940094f" "answer-6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" "answer-a121dafc-2f1c-5f9d-9334-83be1e4a3593"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d3ecb1e-79b9-5c0c-8d13-23fcec2c2084" :answer/id #uuid "6d3ecb1e-79b9-5c0c-8d13-23fcec2c2084" :answer/type :answer.type/math :answer/value "-0.176" :db/ensure [:answer/validate]} {:db/id "answer-de3f796d-328d-51b3-a6f9-559142e7a197" :answer/id #uuid "de3f796d-328d-51b3-a6f9-559142e7a197" :answer/type :answer.type/math :answer/value "-1.585" :db/ensure [:answer/validate]} {:db/id "answer-014ac208-df51-5c62-a006-7a4b9940094f" :answer/id #uuid "014ac208-df51-5c62-a006-7a4b9940094f" :answer/type :answer.type/math :answer/value "0.527" :db/ensure [:answer/validate]} {:db/id "answer-6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" :answer/id #uuid "6e72282c-66ef-50e5-a1aa-f7ce5f8bbebe" :answer/type :answer.type/math :answer/value "0.631" :db/ensure [:answer/validate]} {:db/id "answer-a121dafc-2f1c-5f9d-9334-83be1e4a3593" :answer/id #uuid "a121dafc-2f1c-5f9d-9334-83be1e4a3593" :answer/type :answer.type/math :answer/value "1.585" :db/ensure [:answer/validate]} {:db/id 17592186110594 :knowledge-point/questions ["question-fa39cf5e-b1cf-510a-a444-4f30da1c63f4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fa39cf5e-b1cf-510a-a444-4f30da1c63f4" :question/id #uuid "fa39cf5e-b1cf-510a-a444-4f30da1c63f4" :question/math-academy-id "q-66814" :question/problem "Given that ${11}^{2x-3}=\\sqrt[3]{{7}^{2}},$  find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "Taking ${log}_{11}$ of both sides of the equation gives:\n\n$$\n\\begin{aligned}{11}^{2x-3} & =\\sqrt[3]{{7}^{2}} \\\\ {log}_{11}⁡({11}^{2x-3}) & ={log}_{11}⁡(\\sqrt[3]{{7}^{2}}) \\\\ 2x-3 & ={log}_{11}⁡({7}^{2/3})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side:\n\n$$\n2x-3=\\frac{2}{3}{log}_{11}⁡(7)\n$$\n\nNext, we rewrite the right-hand side using the change of base formula and then solve for $x:$\n\n$$\n\\begin{aligned}2x-3 & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)} \\\\ 2x & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+3 \\\\ x & =\\frac{\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+\\frac{3}{2}\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈1.771\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-335d885a-d13c-55bb-8478-3d052924914c"] :db/ensure [:question/validate]} {:db/id "answer-field-335d885a-d13c-55bb-8478-3d052924914c" :answer-field/id #uuid "335d885a-d13c-55bb-8478-3d052924914c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b59296e7-69ea-5b0f-8c88-fdca508c6ae7" :answer-field/choices ["answer-9762dcaa-9d7a-5565-8692-82ad8a90275e" "answer-0f642b7e-3aa4-589d-b5d0-69cd84cc61e8" "answer-b59296e7-69ea-5b0f-8c88-fdca508c6ae7" "answer-4e71bb66-f31b-56f1-8b96-dceb6bb51802" "answer-6a7282e0-ffd3-5bad-a6f6-578fd6e4195e"] :db/ensure [:answer-field/validate]} {:db/id "answer-9762dcaa-9d7a-5565-8692-82ad8a90275e" :answer/id #uuid "9762dcaa-9d7a-5565-8692-82ad8a90275e" :answer/type :answer.type/math :answer/value "-1.771" :db/ensure [:answer/validate]} {:db/id "answer-0f642b7e-3aa4-589d-b5d0-69cd84cc61e8" :answer/id #uuid "0f642b7e-3aa4-589d-b5d0-69cd84cc61e8" :answer/type :answer.type/math :answer/value "-2.041" :db/ensure [:answer/validate]} {:db/id "answer-b59296e7-69ea-5b0f-8c88-fdca508c6ae7" :answer/id #uuid "b59296e7-69ea-5b0f-8c88-fdca508c6ae7" :answer/type :answer.type/math :answer/value "1.771" :db/ensure [:answer/validate]} {:db/id "answer-4e71bb66-f31b-56f1-8b96-dceb6bb51802" :answer/id #uuid "4e71bb66-f31b-56f1-8b96-dceb6bb51802" :answer/type :answer.type/math :answer/value "1.911" :db/ensure [:answer/validate]} {:db/id "answer-6a7282e0-ffd3-5bad-a6f6-578fd6e4195e" :answer/id #uuid "6a7282e0-ffd3-5bad-a6f6-578fd6e4195e" :answer/type :answer.type/math :answer/value "2.041" :db/ensure [:answer/validate]} {:db/id "question-e0b9a214-575e-56bc-9016-1d953bb568c0" :question/id #uuid "e0b9a214-575e-56bc-9016-1d953bb568c0" :question/math-academy-id "q-100254" :question/problem "Given that ${7}^{5x}+8=34,$ find the value of $x$ rounded to $3$ decimal places." :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{7}^{5x}+8 & =34 \\\\ {7}^{5x} & =26\\end{aligned}\n$$\n\nNow, we take ${log}_{7}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{7}^{5x} & =26 \\\\ {log}_{7}⁡({7}^{5x}) & ={log}_{7}⁡(26) \\\\ 5x & ={log}_{7}⁡(26) \\\\ x & =\\frac{1}{5}{log}_{7}⁡(26)\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.335\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e8491df2-d5c3-5271-8329-efe669739dd5"] :db/ensure [:question/validate]} {