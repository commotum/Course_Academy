2w}} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{(1+\\sqrt{1-2w})(1-\\sqrt{1-2w})} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{{1}^{2}-(\\sqrt{1-2w})^{2}} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{1-(1-2w)} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{2w} & = \\\\ \\frac{1-\\sqrt{1-2w}}{w}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6438280a-ee3f-52a1-9aff-83da651ba794"] :db/ensure [:question/validate]} {:db/id "answer-field-6438280a-ee3f-52a1-9aff-83da651ba794" :answer-field/id #uuid "6438280a-ee3f-52a1-9aff-83da651ba794" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f8c1f90-43e4-5654-845d-4116ec994488" :answer-field/choices ["answer-5e5aa24a-40ad-54c1-ac48-1556e82c4564" "answer-c70653d1-4c66-5b9a-aaf5-222808226c0f" "answer-7f8c1f90-43e4-5654-845d-4116ec994488" "answer-d7ceee2c-5737-50d2-8e0b-837aedd0d714" "answer-83afa538-5275-50c6-985d-07cbd1e01393"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e5aa24a-40ad-54c1-ac48-1556e82c4564" :answer/id #uuid "5e5aa24a-40ad-54c1-ac48-1556e82c4564" :answer/type :answer.type/math :answer/value "\\frac{1+2\\sqrt{1-2w}}{w}" :db/ensure [:answer/validate]} {:db/id "answer-c70653d1-4c66-5b9a-aaf5-222808226c0f" :answer/id #uuid "c70653d1-4c66-5b9a-aaf5-222808226c0f" :answer/type :answer.type/math :answer/value "\\frac{1-\\sqrt{1-2w}}{1+w}" :db/ensure [:answer/validate]} {:db/id "answer-7f8c1f90-43e4-5654-845d-4116ec994488" :answer/id #uuid "7f8c1f90-43e4-5654-845d-4116ec994488" :answer/type :answer.type/math :answer/value "\\frac{1-\\sqrt{1-2w}}{w}" :db/ensure [:answer/validate]} {:db/id "answer-d7ceee2c-5737-50d2-8e0b-837aedd0d714" :answer/id #uuid "d7ceee2c-5737-50d2-8e0b-837aedd0d714" :answer/type :answer.type/math :answer/value "\\frac{2+2\\sqrt{1-2w}}{1+w}" :db/ensure [:answer/validate]} {:db/id "answer-83afa538-5275-50c6-985d-07cbd1e01393" :answer/id #uuid "83afa538-5275-50c6-985d-07cbd1e01393" :answer/type :answer.type/math :answer/value "\\frac{2-2\\sqrt{1-2w}}{w}" :db/ensure [:answer/validate]} {:db/id 17592186213327 :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186213019 :knowledge-point/questions ["question-d0a87847-eb14-5299-88a2-d7b26adced93" "question-87b6f4b7-9188-5e3b-b5e9-cf42f85068fb" "question-a1da1538-2a0a-558a-a1d3-261eb037e2ac" "question-1e5c00c2-c308-529c-a13c-5c3155546628"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d0a87847-eb14-5299-88a2-d7b26adced93" :question/id #uuid "d0a87847-eb14-5299-88a2-d7b26adced93" :question/math-academy-id "q-296038" :question/problem "Rationalize the denominator of $\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{x-3}-\\sqrt{x-2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x-3}-\\sqrt{x-2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}} & = \\\\ \\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}\\cdot \\frac{\\sqrt{x-3}-\\sqrt{x-2}}{\\sqrt{x-3}-\\sqrt{x-2}} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3}+\\sqrt{x-2})(\\sqrt{x-3}-\\sqrt{x-2})} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3})^{2}-(\\sqrt{x-2})^{2}} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{x-3-(x-2)} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{-1} & = \\\\ 3\\sqrt{x-2}-3\\sqrt{x-3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f4bcca3d-b352-5572-98c7-6dddf7325a1d"] :db/ensure [:question/validate]} {:db/id "answer-field-f4bcca3d-b352-5572-98c7-6dddf7325a1d" :answer-field/id #uuid "f4bcca3d-b352-5572-98c7-6dddf7325a1d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a18fb80d-85d6-5638-abcc-79aac05f2512" :answer-field/choices ["answer-5b8e10bd-69c0-5e63-b024-1ff745bea904" "answer-ecc80fb0-df28-5c6d-b00a-f863b6c4153f" "answer-f61a4d96-