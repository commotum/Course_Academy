6045417 true] [17592186569954 1071 "What is the expected value of one roll of a four-sided die?" 13194139536394 17592186045417 true] [17592186569954 1072 #uuid "0298a94b-23a5-5b8c-89b1-b11dd1bda638" 13194139536394 17592186045417 true] [17592186569954 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the roll of a four-sided die. Then the support is $S=\\{1,2,3,4\\},$ and the corresponding probabilities are all $\\frac{1}{4}:$\n\n$$\nf(1)=f(2)=f(3)=f(4)=\\frac{1}{4}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)++3\\cdot f(3)+4\\cdot f(4) \\\\  & =1(\\frac{1}{4})+2(\\frac{1}{4})+3(\\frac{1}{4})+4(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{2}{4}+\\frac{3}{4}+\\frac{4}{4} \\\\  & =\\frac{1+2+3+4}{4} \\\\  & =\\frac{10}{4} \\\\  & =2.5.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569955 1068 #edb/ref 17592186569851 13194139536394 17592186045417 true] [17592186569955 1069 "q-174425" 13194139536394 17592186045417 true] [17592186569955 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569955 1071 "Find the disjoint union of the sets ${A}_{1}=\\{3,6\\}$ and ${A}_{2}=\\{4,6\\}.$" 13194139536394 17592186045417 true] [17592186569955 1072 #uuid "02e046ed-8ad2-55e9-9c98-624e899595b2" 13194139536394 17592186045417 true] [17592186569955 1074 "Notice that the sets are overlapping since\n\n$$\n\\{3,6\\}\\cap \\{4,6\\}=\\{6\\}\\ne ∅.\n$$\n\nSo, for each of our sets, we form the associated set, where each element is tagged with the corresponding index, as follows:\n\n$$\n\\begin{aligned} & {A}_{1} &  & \\,\\to \\, &  & {A}_{1}^{∗}=\\{(3,1),(6,1)\\} \\\\  & {A}_{2} &  & \\,\\to \\, &  & {A}_{2}^{∗}=\\{(4,2),(6,2)\\}\\end{aligned}\n$$\n\nNow, the disjoint union of our sets is simply the union of the associated tagged sets:\n\n$$\n\\begin{aligned}{A}_{1}⊔{A}_{2} & =\\{3,6\\}⊔\\{4,6\\} \\\\  & ={A}_{1}^{∗}\\cup {A}_{2}^{∗} \\\\  & =\\{(3,1),(6,1)\\}\\cup \\{(4,2),(6,2)\\} \\\\  & =\\{(3,1),(6,1),(4,2),(6,2)\\}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569956 1068 #edb/ref 17592186569878 13194139536394 17592186045417 true] [17592186569956 1068 #edb/ref 17592186569896 13194139536394 17592186045417 true] [17592186569956 1069 "q-257222" 13194139536394 17592186045417 true] [17592186569956 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569956 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[1,2]\\times [1,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)={x}^{4}+{y}^{4}-4{x}^{2}-4{y}^{2}+10.\n$$\n\nCalculate the second iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[1,\\,1]^{T}$ if the first iteration of the algorithm gives ${x}_{1}=[2,\\,2]^{T}.$ Round your final answer to **three decimal places.**\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{2}=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569956 1072 #uuid "040d983b-9569-5e20-9386-5dd2354e86bd" 13194139536394 17592186045417 true] [17592186569956 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{4}+{y}^{4}-4{x}^{2}-4{y}^{2}+10) \\\\ \\frac{∂}{∂y}({x}^{4}+{y}^{4}-4{x}^{2}-4{y}^{2}+10)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4{x}^{3}-8x \\\\ 4{y}^{3}-8y\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4{x}^{3}-8x) & \\frac{∂}{∂x}(4{y}^{3}-8y) \\\\ \\frac{∂}{∂y}(4{x}^{3}-8x) & \\frac{∂}{∂y}(4{y}^{3}-8y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}12{x}^{2}-8 & 0 \\\\ 0 & 12{y}^{2}-8\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}12{x}^{2}-8 & 0 \\\\ 0 & 12{y}^{2}-8\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}4{x}^{3}-8x \\\\ 4{y}^{3}-8y\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{\\begin{bmatrix}12{x}^{2}-8 & 0 \\\\ 0 & 12{y}^{2}-8\\end{bmatrix}}_{{x}_{1}}^{-1}{\\begin{bmatrix}4{x}^{3}-8x \\\\ 4{y}^{3}-8y\\end{bmatrix}}_{{x}_{1}} \\\\  & =\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}12(2)^{2}-8 & 0 \\\\ 0 & 12(2)^{2}-8\\end{bmatrix}}^{-1}\\begin{bmatrix}4(2)^{3}-8(2) \\\\ 4(2)^{3}-8(2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}-{\\begin{bmatrix}40 & 0 \\\\ 0 & 40\\end{bmatrix}}^{-1}\\begin{bmatrix}16 \\\\ 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}-\\frac{1}{40\\cdot 40-0\\cdot 0}\\begin{bmatrix}40 & 0 \\\\ 0 & 40\\end{bmatrix}\\begin{bmatrix}16 \\\\ 16\\end{bmatrix} \\\\  & =\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}-\\frac{1}{1\\,600}\\begin{bmatrix}640 \\\\ 640\\end{bmatrix} \\\\  & =\\begin{bmatrix}1.6 \\\\ 1.6\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569957 1068 #edb/ref 17592186569907 13194139536394 17592186045417 true] [17592186569957 1069 "q-334280" 13194139536394 17592186045417 true] [17592186569957 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569957 1071 "$$\n{x}^{′}=\\begin{bmatrix}4 & 2 \\\\ -1 & 1\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}{e}^{3t},\\,{x}_{2}(t)=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" 13194139536394 17592186045417 true] [17592186569957 1072 #uuid "047ba9d9-f028-5122-88f6-0f2794537abb" 13194139536394 17592186045417 true] [17592186569957 1074 "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}1 \\\\ -2\\end{bmatrix}{e}^{3t}=\\begin{bmatrix}{e}^{3t} \\\\ -2{e}^{3t}\\end{bmatrix} \\\\ {x}_{2}(t) & =\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}{e}^{t}=\\begin{bmatrix}2{e}^{t} \\\\ {e}^{t}\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental matrix could be written as\n\n$$\nΦ(t)=\\begin{bmatrix}{e}^{3t} & 2{e}^{t} \\\\ -2{e}^{3t} & {e}^{t}\\end{bmatrix}.\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." 13194139536394 17592186045417 true] [17592186569958 1068 #edb/ref 17592186569876 13194139536394 17592186045417 true] [17592186569958 1069 "q-127818" 13194139536394 17592186045417 true] [17592186569958 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186569958 1071 "One way to bet in roulette is to place $\\$1$ on a single number. If the ball lands on that number, the player wins $\\$35.$ If the ball lands on any of the other $37$ slots, the player doesn't win. What is the expected profit, rounded to the nearest dollar, for a player who plays one hundred games on number $12$ in a row?" 13194139536394 17592186045417 true] [17592186569958 1072 #uuid "068e9bc7-6f46-5ac9-a057-d5f4aa9a8aeb" 13194139536394 17592186045417 true] [17592186569958 1074 "First of all, profit is revenue minus cost, or in our case, winnings minus cost. So, once we have found the expected winnings after one hundred games, we need to subtract $100\\cdot 1=100$ dollars to account for the price of playing.\n\nNow, let's find the expected winnings and summarize them in a table. If $W$ is the winnings (in dollars) on a single game, and $f(w)$ is the probability mass function for $W,$ then we have the following:\n\n| $f(w)$ | $\\frac{1}{38}$ | $\\frac{37}{38}$ |\n| --- | --- | --- |\n| $w$ | $35$ | $0$ |\n\nThe expected value of $W$ is given by\n\n$$\n\\begin{aligned}\\text{E}[W] & =35\\cdot f(35)+0\\cdot f(0) \\\\  & =35(\\frac{1}{38})+0(\\frac{37}{38}) \\\\  & =\\frac{35}{38} \\\\  & ≈0.92.\\end{aligned}\n$$\n\nThis represents the expected winnings for a single game. So, the expected winnings for $100$ games  on number $12$ is\n\n$$\n100\\cdot \\text{E}[W]=100\\cdot (0.92)=92.\n$$\n\nNow, subtracting the $100$ dollars paid to play, we get that the expected profit (in dollars) is\n\n$$\nE[p]=92-100=-8.\n$$" 13194139536394 17592186045417 true] [17592186569959 1068 #edb/ref 17592186569933 13194139536394 17592186045417 true] [17592186569959 1069 "q-174354" 13194139536394 17592186045417 true] [17592186569959 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569959 1071 "Which of the following pairs of sets are disjoint?\n\nI. $\\{x,y,z\\}$ and $\\{3,6,9\\}$\n\nII. $\\{a,b,c,d,e\\}$ and $\\{a,e,i,o,u\\}$\n\nIII. $\\{1,3,6\\}$ and $\\{3,5,7\\}$" 13194139536394 17592186045417 true] [17592186569959 1072 #uuid "0803d7dd-fe65-5059-8e1e-9052cd416dca" 13194139536394 17592186045417 true] [17592186569959 1074 "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nWith that in mind, let's examine our sets.\n\n- Pair I is disjoint. Indeed, the intersection of the sets is empty:\n\n$$\n\\{x,y,z\\}\\cap \\{3,6,9\\}=∅\\,\\,✓\n$$\n\n- Pair II is *not* disjoint since the intersection of the sets is not empty:\n\n$$\n\\{a,b,c,d,e\\}\\cap \\{a,e,i,o,u\\}=\\{a,e\\}\\ne ∅\\,\\,\\times\n$$\n\n- Pair III is *not* disjoint since the intersection of the sets is not empty:\n\n$$\n\\{1,3,6\\}\\cap \\{3,5,7\\}=\\{3\\}\\ne ∅\\,\\,\\times\n$$\n\nTherefore, the correct answer is \"I only.\"" 13194139536394 17592186045417 true] [17592186569960 1068 #edb/ref 17592186569921 13194139536394 17592186045417 true] [17592186569960 1068 #edb/ref 17592186569942 13194139536394 17592186045417 true] [17592186569960 1069 "q-257195" 13194139536394 17592186045417 true] [17592186569960 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569960 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[-1,1]\\times [-1,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)=2{x}^{2}y+3{x}^{2}-3xy+2x-{y}^{2}-5.\n$$\n\nCalculate one iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[-1,\\,-1]^{T}.$ Round your final answer to **three decimal places.**\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569960 1072 #uuid "08790f4f-fd5e-5556-9203-49eaf6e8edd8" 13194139536394 17592186045417 true] [17592186569960 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(2{x}^{2}y+3{x}^{2}-3xy+2x-{y}^{2}-5) \\\\ \\frac{∂}{∂y}(2{x}^{2}y+3{x}^{2}-3xy+2x-{y}^{2}-5)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4xy+6x-3y+2 \\\\ 2{x}^{2}-3x-2y\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4xy+6x-3y+2) & \\frac{∂}{∂x}(2{x}^{2}-3x-2y) \\\\ \\frac{∂}{∂y}(4xy+6x-3y+2) & \\frac{∂}{∂y}(2{x}^{2}-3x-2y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4y+6 & 4x-3 \\\\ 4x-3 & -2\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}4y+6 & 4x-3 \\\\ 4x-3 & -2\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}4xy+6x-3y+2 \\\\ 2{x}^{2}-3x-2y\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}4y+6 & 4x-3 \\\\ 4x-3 & -2\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}4xy+6x-3y+2 \\\\ 2{x}^{2}-3x-2y\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}-{\\begin{bmatrix}4(-1)+6 & 4(-1)-3 \\\\ 4(-1)-3 & -2\\end{bmatrix}}^{-1}\\begin{bmatrix}4(-1)(-1)+6(-1)-3(-1)+2 \\\\ 2(-1)^{2}-3(-1)-2(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}-{\\begin{bmatrix}2 & -7 \\\\ -7 & -2\\end{bmatrix}}^{-1}\\begin{bmatrix}3 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}-\\frac{1}{2\\cdot (-2)-(-7)\\cdot (-7)}\\begin{bmatrix}-2 & 7 \\\\ 7 & 2\\end{bmatrix}\\begin{bmatrix}3 \\\\ 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}+\\frac{1}{53}\\begin{bmatrix}43 \\\\ 35\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}-0.189 \\\\ -0.340\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569961 1068 #edb/ref 17592186569867 13194139536394 17592186045417 true] [17592186569961 1069 "q-131714" 13194139536394 17592186045417 true] [17592186569961 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569961 1071 "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-2y+z &=4 \\\\ y-3z &=-1.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." 13194139536394 17592186045417 true] [17592186569961 1072 #uuid "0d9a8a04-d6f4-5dae-8ede-86bd3b61ce86" 13194139536394 17592186045417 true] [17592186569961 1074 "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}1 & -2 & 1 & 4 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 1 & 4 \\\\ 0 & 1 & -3 & -1\\end{bmatrix} & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -5 & 2 \\\\ 0 & 1 & -3 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-5z &=2 \\\\ y-3z &=-1.\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=5z+2 \\\\ y &=3z-1 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}5z+2 \\\\ 3z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569962 1068 #edb/ref 17592186569930 13194139536394 17592186045417 true] [17592186569962 1069 "q-257248" 13194139536394 17592186045417 true] [17592186569962 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569962 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[2,3]\\times [1,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)={x}^{3}+{y}^{3}-3{x}^{2}-6y+13.\n$$\n\nCalculate the second iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[3,\\,2]^{T}$ if the first iteration of the algorithm gives ${x}_{1}=[2.25,\\,1.5]^{T}.$ Round your final answer to three decimal places (if needed).\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{2}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n$1.417$\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569962 1072 #uuid "11575fd3-3b68-5f5f-9c8d-ffa66ae7367b" 13194139536394 17592186045417 true] [17592186569962 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{3}+{y}^{3}-3{x}^{2}-6y+13) \\\\ \\frac{∂}{∂y}({x}^{3}+{y}^{3}-3{x}^{2}-6y+13)\\end{bmatrix} \\\\  & =\\begin{bmatrix}3{x}^{2}-6x \\\\ 3{y}^{2}-6\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(3{x}^{2}-6x) & \\frac{∂}{∂x}(3{y}^{2}-6) \\\\ \\frac{∂}{∂y}(3{x}^{2}-6x) & \\frac{∂}{∂y}(3{y}^{2}-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6x-6 & 0 \\\\ 0 & 6y\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}6x-6 & 0 \\\\ 0 & 6y\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}3{x}^{2}-6x \\\\ 3{y}^{2}-6\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{\\begin{bmatrix}6x-6 & 0 \\\\ 0 & 6y\\end{bmatrix}}_{{x}_{1}}^{-1}{\\begin{bmatrix}3{x}^{2}-6x \\\\ 3{y}^{2}-6\\end{bmatrix}}_{{x}_{1}} \\\\  & =\\begin{bmatrix}2.25 \\\\ 1.5\\end{bmatrix}-{\\begin{bmatrix}6(2.25)-6 & 0 \\\\ 0 & 6(1.5)\\end{bmatrix}}^{-1}\\begin{bmatrix}3(2.25)^{2}-6(2.25) \\\\ 3(1.5)^{2}-6\\end{bmatrix} \\\\  & =\\begin{bmatrix}2.25 \\\\ 1.5\\end{bmatrix}-{\\begin{bmatrix}7.5 & 0 \\\\ 0 & 9\\end{bmatrix}}^{-1}\\begin{bmatrix}1.6875 \\\\ 0.75\\end{bmatrix} \\\\  & =\\begin{bmatrix}2.25 \\\\ 1.5\\end{bmatrix}-\\frac{1}{7.5\\cdot 9-0\\cdot 0}\\begin{bmatrix}9 & 0 \\\\ 0 & 7.5\\end{bmatrix}\\begin{bmatrix}1.6875 \\\\ 0.75\\end{bmatrix} \\\\  & =\\begin{bmatrix}2.25 \\\\ 1.5\\end{bmatrix}-\\frac{1}{67.5}\\begin{bmatrix}15.1875 \\\\ 5.625\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}2.025 \\\\ 1.417\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569963 1068 #edb/ref 17592186569890 13194139536394 17592186045417 true] [17592186569963 1069 "q-88457" 13194139536394 17592186045417 true] [17592186569963 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569963 1071 "What is the product of solutions of the equation ${x}^{2}{e}^{3x}-4x{e}^{3x}-12{e}^{3x}=0?$" 13194139536394 17592186045417 true] [17592186569963 1072 #uuid "12b67edd-e409-5ea0-9859-9fa94b363ebb" 13194139536394 17592186045417 true] [17592186569963 1074 "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}{e}^{3x}-4x{e}^{3x}-12{e}^{3x} & =0 \\\\ ({x}^{2}-4x-12){e}^{3x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-4x-12=0\\,\\text{and}\\,{e}^{3x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-4x-12=0$ can be factored as\n\n$$\n(x+2)(x-6)=0,\n$$\n\nwhich leads to the solutions $x=-2,6.$\n\n- The equation ${e}^{3x}=0$ has no solutions because ${e}^{3x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-2,6,$ and their product is $(-2)\\cdot 6=-12.$" 13194139536394 17592186045417 true] [17592186569964 1068 #edb/ref 17592186569953 13194139536394 17592186045417 true] [17592186569964 1069 "q-145039" 13194139536394 17592186045417 true] [17592186569964 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569964 1071 "Consider the polar curve $r={cos}^{2}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-3\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta ,\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta ),\n$$\n\nand ${y}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${x}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x}=-\\infty$\n\nIII. The curve has a vertical tangent at $\\theta =\\frac{\\pi }{2}$" 13194139536394 17592186045417 true] [17592186569964 1072 #uuid "1355c292-a399-578d-8bac-2939b3befda0" 13194139536394 17592186045417 true] [17592186569964 1074 "For a given polar curve, there is a vertical tangent at $\\theta ={\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}\n$$\n\nis infinite. This means that\n\n$$\n{y}^{′}({\\theta }_{0})\\ne 0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})=0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a vertical tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}^{-}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty \\,\\text{and}\\,{lim}_{\\theta \\to {\\theta }_{0}^{+}}\\frac{\\text{d}y}{\\text{d}x}=\\pm \\infty .\n$$\n\nIn this case, we're told that ${y}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${x}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{2}) & =-3\\operatorname{sin}⁡(\\frac{\\pi }{2}){cos}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =-3\\cdot 1\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Computing the limit as $\\theta \\to {(\\frac{\\pi }{2})}^{+},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{+}}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{\\cancel{cos}\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡\\theta {cos}^{\\cancel{2}}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{{cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta }{-3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to (\\pi /2)^{+}}(\\frac{{cos}^{2}⁡(\\frac{\\pi }{2})-2{sin}^{2}⁡(\\frac{\\pi }{2})}{-3\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})}) \\\\  & =\\frac{0-2\\cdot 1}{-3\\cdot 1\\cdot {0}^{-}} \\\\  & =\\frac{-2}{{0}^{+}} \\\\  & =-\\infty .\\end{aligned}\n$$\n\n- Statement III is true. Using the calculations from part II, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to (\\pi /2)^{-}}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to (\\pi /2)^{-}}(\\frac{{cos}^{2}⁡(\\frac{\\pi }{2})-2{sin}^{2}⁡(\\frac{\\pi }{2})}{-3\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{\\pi }{2})}) \\\\  & =\\frac{0-2\\cdot 1}{-3\\cdot 1\\cdot {0}^{+}} \\\\  & =\\frac{-2}{{0}^{-}} \\\\  & =\\infty .\\end{aligned}\n$$\n\nSince the limits of our derivative are both infinite, there is a vertical tangent to the curve at $\\theta =\\frac{\\pi }{2}.$\n\n![](images/50/50637a502a56fc242ba5d8e2fda59ddc899295d4b14f7ae692869536b95ef661.png)\n\nTherefore, the correct answer is \"I, II, and III.\"" 13194139536394 17592186045417 true] [17592186569965 1068 #edb/ref 17592186569925 13194139536394 17592186045417 true] [17592186569965 1069 "q-106760" 13194139536394 17592186045417 true] [17592186569965 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569965 1071 "Given that \n$A=\\begin{bmatrix}-2 & 1 \\\\ -16 & 10\\end{bmatrix}$ \nhas the LU decomposition $A=LU,$ then $L=$" 13194139536394 17592186045417 true] [17592186569965 1072 #uuid "14def4d3-3d45-5610-862f-8d4c651f0955" 13194139536394 17592186045417 true] [17592186569965 1074 "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}-2 & 1 \\\\ -16 & 10\\end{bmatrix} & \\,{R}_{2} & :={R}_{2}+(-8){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}-2 & 1 \\\\ 0 & 2\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ -8 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ 8 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}-2 & 1 \\\\ 0 & 2\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569966 1068 #edb/ref 17592186569950 13194139536394 17592186045417 true] [17592186569966 1069 "q-974" 13194139536394 17592186045417 true] [17592186569966 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569966 1071 "Given that $\\frac{5}{2}\\cdot {3}^{x}=5,$ find the value of $x$ rounded to $3$ decimal places." 13194139536394 17592186045417 true] [17592186569966 1072 #uuid "19a2dc0a-21a4-5b89-85c8-47422a295e17" 13194139536394 17592186045417 true] [17592186569966 1074 "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{5}{2}\\cdot {3}^{x} & =5 \\\\ {3}^{x} & =2\\end{aligned}\n$$\n\nNow, we take ${log}_{3}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{3}^{x} & =2 \\\\ {log}_{3}⁡({3}^{x}) & ={log}_{3}⁡(2) \\\\ x & ={log}_{3}⁡(2)\\end{aligned}\n$$\n\nNext, we rewrite the right-hand side using the change of base formula:\n\n$$\nx=\\frac{\\operatorname{log}⁡(2)}{\\operatorname{log}⁡(3)}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.631\n$$\n\nrounded to $3$ decimal places." 13194139536394 17592186045417 true] [17592186569967 1068 #edb/ref 17592186569894 13194139536394 17592186045417 true] [17592186569967 1069 "q-296023" 13194139536394 17592186045417 true] [17592186569967 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569967 1071 "Rationalize the denominator of $\\frac{1}{\\sqrt{y}+\\sqrt{y-4}}.$" 13194139536394 17592186045417 true] [17592186569967 1072 #uuid "1e5c00c2-c308-529c-a13c-5c3155546628" 13194139536394 17592186045417 true] [17592186569967 1074 "First, note that the denominator's conjugate is $\\sqrt{y}-\\sqrt{y-4}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{y}-\\sqrt{y-4},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{y}+\\sqrt{y-4}} & = \\\\ \\frac{1}{\\sqrt{y}+\\sqrt{y-4}}\\cdot \\frac{\\sqrt{y}-\\sqrt{y-4}}{\\sqrt{y}-\\sqrt{y-4}} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{(\\sqrt{y}+\\sqrt{y-4})(\\sqrt{y}-\\sqrt{y-4})} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{(\\sqrt{y})^{2}-(\\sqrt{y-4})^{2}} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{y-(y-4)} & = \\\\ \\frac{\\sqrt{y}-\\sqrt{y-4}}{4} & \\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569968 1068 #edb/ref 17592186569889 13194139536394 17592186045417 true] [17592186569968 1069 "q-132751" 13194139536394 17592186045417 true] [17592186569968 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186569968 1071 "Which of the following statements are true about the function $f(x,y,z)=\\sqrt{z+y-{x}^{2}}?$\n\nI. The partial derivative with respect to $x$ is defined at $(0,0,1)$\n\nII. ${f}_{y}(1,2,0)$ is defined\n\nIII. ${f}_{z}(1,1,0)$ is defined" 13194139536394 17592186045417 true] [17592186569968 1072 #uuid "244be0b4-aca1-5c1c-abe2-94099e0fbbe5" 13194139536394 17592186045417 true] [17592186569968 1074 "First, we compute the partial derivatives of $f(x,y,z):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{x}{\\sqrt{z+y-{x}^{2}}} \\\\ \\frac{∂f}{∂y} & =\\frac{1}{2\\sqrt{z+y-{x}^{2}}} \\\\ \\frac{∂f}{∂z} & =\\frac{1}{2\\sqrt{z+y-{x}^{2}}}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one.\n\n- Statement I is true. Indeed, the function $f$ is defined at $(0,0,1)$, where we have \n\n$$\nf(0,0,1)=\\sqrt{1+0-{0}^{2}}=1,\n$$\n\nand ${f}_{x}$ is also defined at $(0,0,1):$\n\n$$\n\\begin{aligned}{f}_{x}(0,0,1) & =-\\frac{0}{\\sqrt{1+0-{0}^{2}}}=0.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, the function $f$ is defined at $(1,2,0)$, where we have \n\n$$\nf(1,2,0)=\\sqrt{0+2-{1}^{2}}=1,\n$$\n\nand ${f}_{y}$ is also defined at $(1,2,0):$\n\n$$\n\\begin{aligned}{f}_{y}(1,2,0) & =\\frac{1}{2\\sqrt{0+2-{1}^{2}}}=\\frac{1}{2}.\\end{aligned}\n$$\n\n- Statement III is false. If we substitute $(1,1,0)$ into ${f}_{z}$, we get\n\n$$\n{f}_{z}(1,1,0)=\\frac{1}{2\\sqrt{0+1-{1}^{2}}}=\\frac{1}{0},\n$$\n\nwhich is undefined since we have division by zero.\n\nTherefore, the correct answer is 'I and II only'." 13194139536394 17592186045417 true] [17592186569969 1068 #edb/ref 17592186569903 13194139536394 17592186045417 true] [17592186569969 1069 "q-85321" 13194139536394 17592186045417 true] [17592186569969 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569969 1071 "Rationalize the denominator of $\\frac{1}{\\sqrt{w}+1}.$" 13194139536394 17592186045417 true] [17592186569969 1072 #uuid "25064e53-93b3-52b6-af27-2a0003a93f3f" 13194139536394 17592186045417 true] [17592186569969 1074 "First, note that the denominator's conjugate is $\\sqrt{w}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{w}-1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{w}+1} & = \\\\ \\frac{1}{\\sqrt{w}+1}\\cdot \\frac{\\sqrt{w}-1}{\\sqrt{w}-1} & = \\\\ \\frac{\\sqrt{w}-1}{(\\sqrt{w}+1)(\\sqrt{w}-1)} & = \\\\ \\frac{\\sqrt{w}-1}{(\\sqrt{w})^{2}-{1}^{2}} & = \\\\ \\frac{\\sqrt{w}-1}{w-1}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569970 1068 #edb/ref 17592186569869 13194139536394 17592186045417 true] [17592186569970 1069 "q-337346" 13194139536394 17592186045417 true] [17592186569970 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186569970 1071 "One way to bet in roulette is to place $\\$2$ on a single number. If the ball lands on that number, the player wins $\\$70.$ If the ball lands on any of the other $37$ slots, the player doesn't win. What is the expected profit, rounded to the nearest dollar, for a player who plays one hundred games on number $8$ in a row?\n\nThe expected profit in dollars is $E(p)=$\n{{field-1}}" 13194139536394 17592186045417 true] [17592186569970 1072 #uuid "267e0e90-b604-5e86-ad43-795951237ad2" 13194139536394 17592186045417 true] [17592186569970 1074 "First of all, profit is revenue minus cost, or in our case, winnings minus cost. So, once we have found the expected winnings after one hundred games, we need to subtract $100\\cdot 2=200$ dollars to account for the price of playing.\n\nNow, let's find the expected winnings and summarize them in a table. If $W$ is the winnings (in dollars) on a single game, and $f(w)$ is the probability mass function for $W,$ then we have the following:\n\n| $f(w)$ | $\\frac{1}{38}$ | $\\frac{37}{38}$ |\n| --- | --- | --- |\n| $w$ | $70$ | $0$ |\n\nThe expected value of $W$ is given by\n\n$$\n\\begin{aligned}\\text{E}[W] & =70\\cdot f(70)+0\\cdot f(0) \\\\  & =70(\\frac{1}{38})+0(\\frac{37}{38}) \\\\  & =\\frac{70}{38} \\\\  & ≈1.84.\\end{aligned}\n$$\n\nThis represents the expected winnings for a single game. So, the expected winnings for $100$ games on number $8$ is\n\n$$\n100\\cdot \\text{E}[W]=100\\cdot (1.84)=184.\n$$\n\nNow, subtracting the $200$ dollars paid to play, we get that the expected profit (in dollars) is\n\n$$\nE[p]=184-200=-16.\n$$" 13194139536394 17592186045417 true] [17592186569971 1068 #edb/ref 17592186569906 13194139536394 17592186045417 true] [17592186569971 1069 "q-257192" 13194139536394 17592186045417 true] [17592186569971 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569971 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[-2,2]\\times [0,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)=2{x}^{2}{y}^{2}+3{x}^{2}-xy-2x.\n$$\n\nCalculate one iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[-1,\\,0]^{T}.$ Round your final answer to three decimal places (if needed).\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$0.348$\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569971 1072 #uuid "272bf8c6-2369-5e98-9adb-ebe6db7bece2" 13194139536394 17592186045417 true] [17592186569971 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(2{x}^{2}{y}^{2}+3{x}^{2}-xy-2x) \\\\ \\frac{∂}{∂y}(2{x}^{2}{y}^{2}+3{x}^{2}-xy-2x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4x{y}^{2}+6x-y-2 \\\\ 4{x}^{2}y-x\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4x{y}^{2}+6x-y-2) & \\frac{∂}{∂x}(4{x}^{2}y-x) \\\\ \\frac{∂}{∂y}(4x{y}^{2}+6x-y-2) & \\frac{∂}{∂y}(4{x}^{2}y-x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4{y}^{2}+6 & 8xy-1 \\\\ 8xy-1 & 4{x}^{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}4{y}^{2}+6 & 8xy-1 \\\\ 8xy-1 & 4{x}^{2}\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}4x{y}^{2}+6x-y-2 \\\\ 4{x}^{2}y-x\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}4{y}^{2}+6 & 8xy-1 \\\\ 8xy-1 & 4{x}^{2}\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}4x{y}^{2}+6x-y-2 \\\\ 4{x}^{2}y-x\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}-{\\begin{bmatrix}4(0)^{2}+6 & 8(-1)(0)-1 \\\\ 8(-1)(0)-1 & 4(-1)^{2}\\end{bmatrix}}^{-1}\\begin{bmatrix}4(-1)(0)^{2}+6(-1)-0-2 \\\\ 4(-1)^{2}(0)-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}-{\\begin{bmatrix}6 & -1 \\\\ -1 & 4\\end{bmatrix}}^{-1}\\begin{bmatrix}-8 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}-\\frac{1}{6\\cdot 4-(-1)\\cdot (-1)}\\begin{bmatrix}4 & 1 \\\\ 1 & 6\\end{bmatrix}\\begin{bmatrix}-8 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix}-\\frac{1}{23}\\begin{bmatrix}-31 \\\\ -2\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}0.348 \\\\ 0.087\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569972 1068 #edb/ref 17592186569891 13194139536394 17592186045417 true] [17592186569972 1069 "q-334287" 13194139536394 17592186045417 true] [17592186569972 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569972 1071 "$$\n{x}^{′}=\\begin{bmatrix}3 & 1 \\\\ -2 & 4\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{t},\\,{x}_{2}(t)=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{5t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" 13194139536394 17592186045417 true] [17592186569972 1072 #uuid "2812ec6f-62e9-58a6-b999-e2e9bb1ef20a" 13194139536394 17592186045417 true] [17592186569972 1074 "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}{e}^{t}=\\begin{bmatrix}2{e}^{t} \\\\ -{e}^{t}\\end{bmatrix} \\\\ {x}_{2}(t) & =\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}{e}^{5t}=\\begin{bmatrix}{e}^{5t} \\\\ 3{e}^{5t}\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=\\begin{bmatrix}2{e}^{t} & {e}^{5t} \\\\ -{e}^{t} & 3{e}^{5t}\\end{bmatrix}.\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." 13194139536394 17592186045417 true] [17592186569973 1068 #edb/ref 17592186569946 13194139536394 17592186045417 true] [17592186569973 1069 "q-115901" 13194139536394 17592186045417 true] [17592186569973 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569973 1071 "What are the coordinates of the vertex of the parabola ${x}^{2}=-32y?$" 13194139536394 17592186045417 true] [17592186569973 1072 #uuid "288339ac-4de2-5c41-bc2e-90c16e62e9fb" 13194139536394 17592186045417 true] [17592186569973 1074 "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(-8)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-8.$ Therefore, our parabola has its vertex at $(0,0).$" 13194139536394 17592186045417 true] [17592186569974 1068 #edb/ref 17592186569932 13194139536394 17592186045417 true] [17592186569974 1069 "q-64861" 13194139536394 17592186045417 true] [17592186569974 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569974 1071 "Find the value of $\\operatorname{sin}⁡(\\frac{\\pi }{2}).$" 13194139536394 17592186045417 true] [17592186569974 1072 #uuid "29efc143-8ef6-514b-b08b-b09cf3c6dccf" 13194139536394 17592186045417 true] [17592186569974 1074 "The angle $\\frac{\\pi }{2}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡(\\frac{\\pi }{2})=1.$" 13194139536394 17592186045417 true] [17592186569975 1068 #edb/ref 17592186569952 13194139536394 17592186045417 true] [17592186569975 1069 "q-111940" 13194139536394 17592186045417 true] [17592186569975 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569975 1071 "Factor the expression ${h}^{7}+8{h}^{6}+16{h}^{5}.$" 13194139536394 17592186045417 true] [17592186569975 1072 #uuid "2c4e4328-a65d-5ebb-a442-4282ed74de70" 13194139536394 17592186045417 true] [17592186569975 1074 "First, notice that all of the terms have a common factor of ${h}^{5}.$ To simplify the computation, we can factor out the ${h}^{5},$ as follows:\n\n$$\n\\begin{aligned}{h}^{7}+8{h}^{6}+16{h}^{5} & ={h}^{5}({h}^{2}+8h+16)\\end{aligned}\n$$\n\nThe expression ${h}^{2}+8h+16$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{h}^{5}({h}^{2}+8h+16) & = \\\\ {h}^{5}({h}^{2}+8h+{4}^{2}) & = \\\\ {h}^{5}({h}^{2}+2\\cdot 4h+{4}^{2}) & = \\\\ {h}^{5}(h+4)^{2}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569976 1068 #edb/ref 17592186569945 13194139536394 17592186045417 true] [17592186569976 1069 "q-74636" 13194139536394 17592186045417 true] [17592186569976 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569976 1071 "Consider the following system of equations.\n\n$$\n\\left\\{\\begin{aligned}-x+y &=-1 \\\\ 2x+3y &=3 \\\\ -x-4y &=-3.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nI. The system is inconsistent\n\nII. The system has a unique solution\n\nIII. The system is consistent dependent" 13194139536394 17592186045417 true] [17592186569976 1072 #uuid "2f4a72f8-3bd3-5788-9d12-62ca6f611891" 13194139536394 17592186045417 true] [17592186569976 1074 "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 3 & 3 \\\\ -1 & -4 & -3\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:  \n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 1 & -1 \\\\ 2 & 3 & 3 \\\\ -1 & -4 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 1 & -1 \\\\ 0 & 5 & 1 \\\\ -1 & -4 & -3\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼\\begin{bmatrix}-1 & 1 & -1 \\\\ 0 & 5 & 1 \\\\ 0 & -5 & -2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}-1 & 1 & -1 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-1,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement I is true." 13194139536394 17592186045417 true] [17592186569977 1068 #edb/ref 17592186569870 13194139536394 17592186045417 true] [17592186569977 1069 "q-100799" 13194139536394 17592186045417 true] [17592186569977 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569977 1071 "What is the product of solutions of the equation $9{x}^{2}{e}^{x}=36{e}^{x}?$" 13194139536394 17592186045417 true] [17592186569977 1072 #uuid "3499241b-bbd1-5943-8b7b-1fe387959bfa" 13194139536394 17592186045417 true] [17592186569977 1074 "First, we factor the equation:\n\n$$\n\\begin{aligned}9{x}^{2}{e}^{x} & =36{e}^{x} \\\\ 9{x}^{2}{e}^{x}-36{e}^{x} & =0 \\\\ (9{x}^{2}-36){e}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n9{x}^{2}-36=0\\,\\text{and}\\,{e}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $9{x}^{2}-36=0$ can be factored as\n\n$$\n(3x+6)(3x-6)=0,\n$$\n\nwhich leads to the solutions $x=-2,2.$\n\n- The equation ${e}^{x}=0$ has no solutions because ${e}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-2,2,$ and their product is $(-2)\\cdot 2=-4.$" 13194139536394 17592186045417 true] [17592186569978 1068 #edb/ref 17592186569881 13194139536394 17592186045417 true] [17592186569978 1069 "q-131713" 13194139536394 17592186045417 true] [17592186569978 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569978 1071 "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-x+2y &=-1 \\\\ 4x-8y &=4 \\\\ -4x+8y &=-4.\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." 13194139536394 17592186045417 true] [17592186569978 1072 #uuid "35e39332-390d-57d5-8a71-b2e823ef2c1d" 13194139536394 17592186045417 true] [17592186569978 1074 "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-1 & 2 & -1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{bmatrix}.\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}-1 & 2 & -1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{bmatrix} & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 4 & -8 & 4 \\\\ -4 & 8 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 0 & 0 \\\\ -4 & 8 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding system is now  \n\n$$\n\\left\\{\\begin{aligned}x-2y &=1\\end{aligned}\\right.\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and we have one free variable, $y.$ That means we need to find $x$  in terms of $y.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=2y+1 \\\\ y &=y,\\end{aligned}\\right.\n$$\n\nwhere $y$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}2y+1 \\\\ y\\end{bmatrix},\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569979 1068 #edb/ref 17592186569853 13194139536394 17592186045417 true] [17592186569979 1069 "q-174364" 13194139536394 17592186045417 true] [17592186569979 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569979 1071 "Consider the following sets:\n\n$$\nA=\\{{n}^{2}∣n\\in N\\},\\,B=\\{\\frac{2}{n}∣n\\in N\\}\n$$\n\nWhich of the following statements are true?\n\nI. $A=\\{1,4,9,16,…\\}$\n\nII. $A\\cap B=∅$\n\nIII. $A$ and $B$ are disjoint" 13194139536394 17592186045417 true] [17592186569979 1072 #uuid "37c3bc23-bd02-5d58-b8ef-2de055e363b9" 13194139536394 17592186045417 true] [17592186569979 1074 "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nWith that in mind, let's examine our sets.\n\n- Statement I is true.\n\n$$\n\\begin{aligned}A & =\\{{n}^{2}∣n\\in N\\} \\\\  & =\\{1,4,9,16,…\\}\\end{aligned}\n$$\n\n- Statement II is false. Notice that\n\n$$\n\\begin{aligned}B & =\\{\\frac{2}{n}∣n\\in N\\} \\\\  & =\\{2,1,\\frac{2}{3},\\frac{1}{2},…\\}.\\end{aligned}\n$$\n\nThen, the intersection is \n\n$$\n\\begin{aligned}A\\cap B & =\\{1,4,9,16,…\\}\\text{ }\\cap \\{2,1,\\frac{2}{3},\\frac{1}{2},…\\} \\\\  & =\\{1\\}. \\\\  & \\ne ∅.\\end{aligned}\n$$\n\n- Statement III is false. Since the intersection is not empty, the two sets are not disjoint.\n\nTherefore, the correct answer is \"I only.\"" 13194139536394 17592186045417 true] [17592186569980 1068 #edb/ref 17592186569859 13194139536394 17592186045417 true] [17592186569980 1069 "q-201" 13194139536394 17592186045417 true] [17592186569980 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569980 1071 "A triangle has sides $a$, $b$, and $c.$ The sides $a$, $b$, and $c$ are of lengths  $9$, $12$, and $18$, respectively. What is the measure of the angle between the sides $b$ and $c?$ Round your answer to two decimal places." 13194139536394 17592186045417 true] [17592186569980 1072 #uuid "39fc3bcb-e781-5ee0-b172-9c69c7f5c440" 13194139536394 17592186045417 true] [17592186569980 1074 "The following triangle illustrates the information given.\n\n![](images/de/dede0326d992509dedf1c3a2854b47076ccc48ebf0e07705c8c12762d8ecdead.png)\n\nWe use the Law of Cosines to solve for angle $A:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\n \n\nHere, we have\n\n$$\na=9,\\,b=12,\\,c=18.\n$$\n\nThis gives \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{12}^{2}+{18}^{2}-{9}^{2}}{2(12)(18)} \\\\  & =\\frac{144+324-81}{432} \\\\  & =\\frac{387}{432}\\end{aligned}\n$$\n\n \nTherefore,\n\n$$\n\\begin{aligned}m∠F & =\\operatorname{arccos}⁡(\\frac{387}{432}) \\\\  & ={26.38}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places." 13194139536394 17592186045417 true] [17592186569981 1068 #edb/ref 17592186569926 13194139536394 17592186045417 true] [17592186569981 1069 "q-144911" 13194139536394 17592186045417 true] [17592186569981 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569981 1071 "Consider the polar curve $r=\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )={cos}^{3}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4),\\,{y}^{′}(\\theta )=\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta (5{cos}^{2}⁡\\theta -3),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" 13194139536394 17592186045417 true] [17592186569981 1072 #uuid "3f8bf9ef-a3d1-5fa9-97cc-d10fddcf1cd1" 13194139536394 17592186045417 true] [17592186569981 1074 "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2}){cos}^{2}⁡(\\frac{\\pi }{2})(5{cos}^{2}⁡(\\frac{\\pi }{2})-3) \\\\  & =1\\cdot 0\\cdot (5\\cdot 0-3) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,(5{cos}^{2}⁡\\theta -3)}{{cos}^{3}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{sin}⁡\\theta {\\cancel{cos}}^{2}\\theta \\,(5{cos}^{2}⁡\\theta -3)}{{cos}^{\\cancel{3}}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{sin}⁡\\theta \\,(5{cos}^{2}⁡\\theta -3)}{\\operatorname{cos}⁡\\theta \\,(5{cos}^{2}⁡\\theta -4)}) \\\\  & =\\frac{1\\cdot (5\\cdot 0-3)}{0\\cdot (5\\cdot 0-4)} \\\\  & =\\frac{-3}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/d7/d7881ba860bcc32301a162eb200ea9075b06b63c780be74c14aedbcb1654eaaa.png)\n\nTherefore, the correct answer is \"I only.\"" 13194139536394 17592186045417 true] [17592186569982 1068 #edb/ref 17592186569855 13194139536394 17592186045417 true] [17592186569982 1068 #edb/ref 17592186569874 13194139536394 17592186045417 true] [17592186569982 1068 #edb/ref 17592186569904 13194139536394 17592186045417 true] [17592186569982 1068 #edb/ref 17592186569911 13194139536394 17592186045417 true] [17592186569982 1069 "q-257215" 13194139536394 17592186045417 true] [17592186569982 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569982 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[-1,0]\\times [0,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)={x}^{3}-2x{y}^{2}-xy+x-y.\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[-1,\\,1]^{T},$ and compute the components of the first iteration. Round the answer for ${x}_{1}$ to **three decimal places**.\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">$[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-5$\n</td>\n<td align=\"center\" rowspan=\"2\">$]({x}_{1}-{x}_{0})\\,=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-1$\n</td>\n<td align=\"left\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-5$\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-3}}</td>\n</tr>\n</tbody></table>\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$-0.510$</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-4}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569982 1072 #uuid "4033d90f-6820-5b6e-97e2-e268a68a992f" 13194139536394 17592186045417 true] [17592186569982 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be rewritten as\n\n$$\n{H}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-∇f({x}_{n}).\n$$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({x}^{3}-2x{y}^{2}-xy+x-y) \\\\ \\frac{∂}{∂y}({x}^{3}-2x{y}^{2}-xy+x-y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}3{x}^{2}-2{y}^{2}-y+1 \\\\ -4xy-x-1\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(3{x}^{2}-2{y}^{2}-y+1) & \\frac{∂}{∂x}(-4xy-x-1) \\\\ \\frac{∂}{∂y}(3{x}^{2}-2{y}^{2}-y+1) & \\frac{∂}{∂y}(-4xy-x-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6x & -4y-1 \\\\ -4y-1 & -4x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{\\begin{bmatrix}6x & -4y-1 \\\\ -4y-1 & -4x\\end{bmatrix}}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{\\begin{bmatrix}3{x}^{2}-2{y}^{2}-y+1 \\\\ -4xy-x-1\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}6x & -4y-1 \\\\ -4y-1 & -4x\\end{bmatrix}}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{\\begin{bmatrix}3{x}^{2}-2{y}^{2}-y+1 \\\\ -4xy-x-1\\end{bmatrix}}_{{x}_{0}} \\\\ \\begin{bmatrix}6(-1) & -4(1)-1 \\\\ -4(1)-1 & -4(-1)\\end{bmatrix}({x}_{1}-{x}_{0}) & =-\\begin{bmatrix}3(-1)^{2}-2(1)^{2}-1+1 \\\\ -4(-1)(1)-(-1)-1\\end{bmatrix} \\\\ \\begin{bmatrix}-6 & -5 \\\\ -5 & 4\\end{bmatrix}({x}_{1}-{x}_{0}) & =\\begin{bmatrix}-1 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSolving this system of equations, we get $({x}_{1}-{x}_{0})=\\begin{bmatrix}24/49 \\\\ -19/49\\end{bmatrix}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}+\\begin{bmatrix}\\frac{24}{49} \\\\ -\\frac{19}{49}\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}\\frac{24}{49} \\\\ -\\frac{19}{49}\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}-0.510 \\\\ 0.612\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569983 1068 #edb/ref 17592186569877 13194139536394 17592186045417 true] [17592186569983 1069 "q-276300" 13194139536394 17592186045417 true] [17592186569983 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569983 1071 "A quality control manager at a warehouse inspects electronic boxes for defective items. The number of faulty items in each box was recorded and summarized below. If $X$ is the number of faulty items in a box, what is the expected value of $X?$\n\n| Number of Boxes | $13$ | $6$ | $4$ | $2$ |\n| --- | --- | --- | --- | --- |\n| Faulty Items | $0$ | $1$ | $2$ | $3$ |\n\n$\\text{E}[X]=$\n{{field-1}}" 13194139536394 17592186045417 true] [17592186569983 1072 #uuid "41c4d9f2-fb24-5742-893b-e72bc5478b30" 13194139536394 17592186045417 true] [17592186569983 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the faulty items, so we can start by computing the corresponding probabilities. The total number of boxes is $13+6+4+2=25,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=0)=f(0) & =\\frac{13}{25} \\\\ P(X=1)=f(1) & =\\frac{6}{25} \\\\ P(X=2)=f(2) & =\\frac{4}{25} \\\\ P(X=3)=f(3) & =\\frac{2}{25}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{13}{25}$ | $\\frac{6}{25}$ | $\\frac{4}{25}$ | $\\frac{2}{25}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{13}{25})+1(\\frac{6}{25})+2(\\frac{4}{25})+3(\\frac{2}{25}) \\\\  & =\\frac{6}{25}+\\frac{8}{25}+\\frac{6}{25} \\\\  & =\\frac{6+8+6}{25} \\\\  & =\\frac{20}{25} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569984 1068 #edb/ref 17592186569850 13194139536394 17592186045417 true] [17592186569984 1069 "q-67501" 13194139536394 17592186045417 true] [17592186569984 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569984 1071 "Which of the three sequences below are geometric sequences?\n\nI. $\\frac{1}{4},\\,\\frac{1}{2},\\,2,\\,…$\n\nII. ${a}_{n+1}=\\frac{3}{2}{a}_{n},\\,{a}_{1}=-1,\\,n\\ge 1$\n\nIII. $1,\\,0.2,\\,0.03,\\,…$" 13194139536394 17592186045417 true] [17592186569984 1072 #uuid "42a89ddb-b42b-5afd-9218-01f794cbc72e" 13194139536394 17592186045417 true] [17592186569984 1074 "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{(\\frac{1}{2})}{(\\frac{1}{4})} & =2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{2}{(\\frac{1}{2})} & =4\\end{aligned}\n$$\n\n- Sequence II is a geometric sequence. The recursive rule ${a}_{n+1}=\\frac{3}{2}{a}_{n}$ tells us that each term is $\\frac{3}{2}$ times the previous term, so the common ratio is $r=\\frac{3}{2}.$\n\n- Sequence III is not a geometric sequence because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}}=\\frac{0.2}{1} & =0.2 \\\\ \\frac{{a}_{3}}{{a}_{2}}=\\frac{0.03}{0.2} & =0.15\\end{aligned}\n$$\n\nIn conclusion, only sequence II is a geometric sequence." 13194139536394 17592186045417 true] [17592186569985 1068 #edb/ref 17592186569918 13194139536394 17592186045417 true] [17592186569985 1069 "q-34859" 13194139536394 17592186045417 true] [17592186569985 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569985 1071 "Rationalize the denominator of $\\frac{x}{7+\\sqrt{x-5}}.$" 13194139536394 17592186045417 true] [17592186569985 1072 #uuid "4de4e407-29f5-567d-8ce6-c2253af336bc" 13194139536394 17592186045417 true] [17592186569985 1074 "First, note that the denominator's conjugate is $7-\\sqrt{x-5}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $7-\\sqrt{x-5},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{x}{7+\\sqrt{x-5}} & = \\\\ \\frac{x}{7+\\sqrt{x-5}}\\cdot \\frac{7-\\sqrt{x-5}}{7-\\sqrt{x-5}} & = \\\\ \\frac{x(7-\\sqrt{x-5})}{(7+\\sqrt{x-5})(7-\\sqrt{x-5})} & = \\\\ \\frac{7x-x\\sqrt{x-5}}{{7}^{2}-(\\sqrt{x-5})^{2}} & = \\\\ \\frac{7x-x\\sqrt{x-5}}{49-(x-5)} & = \\\\ \\frac{7x-x\\sqrt{x-5}}{54-x}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569986 1068 #edb/ref 17592186569856 13194139536394 17592186045417 true] [17592186569986 1069 "q-174361" 13194139536394 17592186045417 true] [17592186569986 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569986 1071 "Consider the following sets:\n\n$$\nA=\\{n\\in N∣n\\le 5\\},\\,B=\\{n\\in N∣4n+6\\ge 30\\}\n$$\n\nWhich of the following statements are true?\n\nI. $B=\\{6,7,8,…\\}$\n\nII. $A\\cap B=∅$\n\nIII. $A$ and $B$ are disjoint" 13194139536394 17592186045417 true] [17592186569986 1072 #uuid "4e68e4d1-4fbe-504a-90e3-9d792c948b3d" 13194139536394 17592186045417 true] [17592186569986 1074 "Two sets $A$ and $B$ are *disjoint* if they have no element in common, i.e., their intersection is empty:\n\n$$\nA\\cap B=∅\n$$\n\nFirst, notice that the elements of $B$ are positive integers that satisfy the inequality \n\n$$\n\\begin{aligned}4n+6 & \\ge 30 \\\\ 4n & \\ge 24 \\\\ n & \\ge 6.\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets.\n\n- Statement I is true.\n\n$$\n\\begin{aligned}B & =\\{n\\in N∣4n+6\\ge 30\\} \\\\  & =\\{n\\in N∣n\\ge 6\\} \\\\  & =\\{6,7,8,…\\}\\end{aligned}\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}A & =\\{n\\in N∣n\\le 5\\} \\\\  & =\\{1,2,3,4,5\\}.\\end{aligned}\n$$\n\nThen, the intersection is \n\n$$\nA\\cap B=\\{1,2,3,4,5\\}\\cap \\{6,7,8,…\\}=∅.\n$$\n\n- Statement III is true. Since the intersection is empty, the two sets are disjoint.\n\nTherefore, the correct answer is \"I, II and III.\"" 13194139536394 17592186045417 true] [17592186569987 1068 #edb/ref 17592186569893 13194139536394 17592186045417 true] [17592186569987 1069 "q-83981" 13194139536394 17592186045417 true] [17592186569987 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569987 1071 "A stack contains four cards, where each card is labeled $1$, $4$, $6$, or $9.$ If one card is randomly drawn, what is its expected value?" 13194139536394 17592186045417 true] [17592186569987 1072 #uuid "522d89ff-41d6-50ec-8d1b-a4ada325fbc8" 13194139536394 17592186045417 true] [17592186569987 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the label on a randomly drawn card. Then the support is $S=\\{1,4,6,9\\},$ and the corresponding probabilities are all $\\frac{1}{4}:$\n\n$$\nf(1)=f(4)=f(6)=f(9)=\\frac{1}{4}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+4\\cdot f(4)+6\\cdot f(6)+9\\cdot f(9) \\\\  & =1(\\frac{1}{4})+4(\\frac{1}{4})+6(\\frac{1}{4})+9(\\frac{1}{4}) \\\\  & =\\frac{1}{4}+\\frac{4}{4}+\\frac{6}{4}+\\frac{9}{4} \\\\  & =\\frac{1+4+6+9}{4} \\\\  & =\\frac{20}{4} \\\\  & =5\\,.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569988 1068 #edb/ref 17592186569879 13194139536394 17592186045417 true] [17592186569988 1069 "q-127259" 13194139536394 17592186045417 true] [17592186569988 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569988 1071 "The rolls of an unfair octahedral die follow the probability mass function $f(x)$ as shown in the table below. What is the expected value of one roll of the die?\n\n| $x$ | $1$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{8}$ | $\\frac{1}{16}$ | $\\frac{1}{16}$ | $\\frac{3}{32}$ | $\\frac{1}{8}$ | $\\frac{1}{32}$ | $\\frac{1}{4}$ | $\\frac{1}{4}$ |" 13194139536394 17592186045417 true] [17592186569988 1072 #uuid "53e1317a-3ae2-58ac-bb4d-59a740997145" 13194139536394 17592186045417 true] [17592186569988 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5)+6\\cdot f(6) \\\\  & =1(\\frac{1}{8})+2(\\frac{1}{16})+3(\\frac{1}{16})+4(\\frac{3}{32})+5(\\frac{1}{8})+6(\\frac{1}{32})+7(\\frac{1}{4})+8(\\frac{1}{4}) \\\\  & =\\frac{1}{8}+\\frac{2}{16}+\\frac{3}{16}+\\frac{12}{32}+\\frac{5}{8}+\\frac{6}{32}+\\frac{7}{4}+\\frac{8}{4} \\\\  & =\\frac{4}{32}+\\frac{4}{32}+\\frac{6}{32}+\\frac{12}{32}+\\frac{20}{32}+\\frac{6}{32}+\\frac{56}{32}+\\frac{64}{32} \\\\  & =\\frac{4+4+6+12+20+6+56+64}{32} \\\\  & =\\frac{172}{32} \\\\  & =\\frac{43}{8}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569989 1068 #edb/ref 17592186569857 13194139536394 17592186045417 true] [17592186569989 1069 "q-93048" 13194139536394 17592186045417 true] [17592186569989 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569989 1071 "Find the domain of $q(x)=2\\sqrt[4]{x+3}-2.$" 13194139536394 17592186045417 true] [17592186569989 1072 #uuid "54e659be-f31e-5f00-888e-77687d0dffe4" 13194139536394 17592186045417 true] [17592186569989 1074 "The domain of $y=\\sqrt[4]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $q(x)=2\\sqrt[4]{x+3}-2,$ we replace $x$ with $x+3$ in the above inequality. This gives\n\n$$\nx+3\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}x+3 & \\ge 0 \\\\ x & \\ge -3\\end{aligned}\n$$\n\nTherefore, the domain of $y=q(x)$ is $x\\in [-3,\\infty ).$\n\nWe can also see that this is true from the graph of the function. The graph of $y=q(x)$ is shown below.\n\n![](images/97/977b12dd8bd88d2b79285ef07d89f9958194fc84f340d7930c5b40122f8896d2.png)" 13194139536394 17592186045417 true] [17592186569990 1068 #edb/ref 17592186569860 13194139536394 17592186045417 true] [17592186569990 1069 "q-174400" 13194139536394 17592186045417 true] [17592186569990 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569990 1071 "$\\{-6,6\\}⊔\\{-3,3\\}=$" 13194139536394 17592186045417 true] [17592186569990 1072 #uuid "568ef841-bdd5-5e7a-98b5-6d308da6308f" 13194139536394 17592186045417 true] [17592186569990 1074 "Notice that the sets are disjoint since\n\n$$\n\\{-6,6\\}\\cap \\{-3,3\\}=∅.\n$$\n\nTherefore, the disjoint union is simply the union:\n\n$$\n\\begin{aligned}\\{-6,6\\}⊔\\{-3,3\\} & =\\{-6,6\\}\\cup \\{-3,3\\} \\\\  & =\\{-6,-3,3,6\\}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569991 1068 #edb/ref 17592186569931 13194139536394 17592186045417 true] [17592186569991 1069 "q-82379" 13194139536394 17592186045417 true] [17592186569991 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186569991 1071 "![](images/51/51ed86e455d0716953ad3d083646483d023ff7db6d8f45a9f27e4324d00b21db.png)\n\nThe graph of $y=f(x)$ is shown above. Given that $y=f(x)$ is periodic with period $4,$ what is the value of $f(-46)?$" 13194139536394 17592186045417 true] [17592186569991 1072 #uuid "578558b7-752b-50a1-8021-c4183d8058d1" 13194139536394 17592186045417 true] [17592186569991 1074 "Since the period is $4,$ if we add (or subtract) any multiple of $4$ from the input, the output stays the same.\n\nSo, we can keep adding $4$ to the input until we get to an input that we see in the graph:\n\n$$\n\\begin{aligned}f(-46) & =f(-46+4) \\\\  & =f(-46+2\\cdot 4) \\\\  & =⋯ \\\\  & =f(-46+11\\cdot 4) \\\\  & =f(-2) \\\\  & =1\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569992 1068 #edb/ref 17592186569886 13194139536394 17592186045417 true] [17592186569992 1069 "q-111087" 13194139536394 17592186045417 true] [17592186569992 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569992 1071 "Rationalize the denominator of $\\frac{4{r}^{2}}{\\sqrt{2r-1}-1}.$" 13194139536394 17592186045417 true] [17592186569992 1072 #uuid "57f8edcf-bb4c-5c62-90a9-46d6df888cba" 13194139536394 17592186045417 true] [17592186569992 1074 "First, note that the denominator's conjugate is $\\sqrt{2r-1}+1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{2r-1}+1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4{r}^{2}}{\\sqrt{2r-1}-1} & = \\\\ \\frac{4{r}^{2}}{\\sqrt{2r-1}-1}\\cdot \\frac{\\sqrt{2r-1}+1}{\\sqrt{2r-1}+1} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{(\\sqrt{2r-1}-1)(\\sqrt{2r-1}+1)} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{(\\sqrt{2r-1})^{2}-{1}^{2}} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{2r-1-1} & = \\\\ \\frac{4{r}^{2}(\\sqrt{2r-1}+1)}{2r-2} & = \\\\ \\frac{2{r}^{2}(\\sqrt{2r-1}+1)}{r-1} & \\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569993 1068 #edb/ref 17592186569865 13194139536394 17592186045417 true] [17592186569993 1068 #edb/ref 17592186569938 13194139536394 17592186045417 true] [17592186569993 1069 "q-257198" 13194139536394 17592186045417 true] [17592186569993 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569993 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,1]\\times [0,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)=5{x}^{2}y-2{x}^{2}+2x{y}^{2}+3xy-2.\n$$\n\nCalculate one iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[0,\\,1]^{T}.$ Round your final answer to **three decimal places.**\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569993 1072 #uuid "5830491e-19ce-53b6-8fb0-b5e123e740a5" 13194139536394 17592186045417 true] [17592186569993 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(5{x}^{2}y-2{x}^{2}+2x{y}^{2}+3xy-2) \\\\ \\frac{∂}{∂y}(5{x}^{2}y-2{x}^{2}+2x{y}^{2}+3xy-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}10xy-4x+2{y}^{2}+3y \\\\ 5{x}^{2}+4xy+3x\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(10xy-4x+2{y}^{2}+3y) & \\frac{∂}{∂x}(5{x}^{2}+4xy+3x) \\\\ \\frac{∂}{∂y}(10xy-4x+2{y}^{2}+3y) & \\frac{∂}{∂y}(5{x}^{2}+4xy+3x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}10y-4 & 10x+4y+3 \\\\ 10x+4y+3 & 4x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}10y-4 & 10x+4y+3 \\\\ 10x+4y+3 & 4x\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}10xy-4x+2{y}^{2}+3y \\\\ 5{x}^{2}+4xy+3x\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}10y-4 & 10x+4y+3 \\\\ 10x+4y+3 & 4x\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}10xy-4x+2{y}^{2}+3y \\\\ 5{x}^{2}+4xy+3x\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}-{\\begin{bmatrix}10(1)-4 & 10(0)+4(1)+3 \\\\ 10(0)+4(1)+3 & 4(0)\\end{bmatrix}}^{-1}\\begin{bmatrix}10(0)(1)-4(0)+2(1)^{2}+3(1) \\\\ 5(0)^{2}+4(0)(1)+3(0)\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}-{\\begin{bmatrix}6 & 7 \\\\ 7 & 0\\end{bmatrix}}^{-1}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}-\\frac{1}{6\\cdot 0-7\\cdot 7}\\begin{bmatrix}0 & -7 \\\\ -7 & 6\\end{bmatrix}\\begin{bmatrix}5 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}+\\frac{1}{49}\\begin{bmatrix}0 \\\\ -35\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}0 \\\\ 0.286\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569994 1068 #edb/ref 17592186569917 13194139536394 17592186045417 true] [17592186569994 1069 "q-93034" 13194139536394 17592186045417 true] [17592186569994 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569994 1071 "Find the domain of $h(x)=\\sqrt[3]{-x-5}+7.$" 13194139536394 17592186045417 true] [17592186569994 1072 #uuid "586758ad-b0a5-531e-b46a-bdc8f3f5617e" 13194139536394 17592186045417 true] [17592186569994 1074 "The domain of $y=\\sqrt[3]{x}$ is\n$x\\in (-\\infty ,\\infty ).$\n\nTransformations do not change this interval. Therefore, the domain of $h(x)$ is $x\\in (-\\infty ,\\infty ).$" 13194139536394 17592186045417 true] [17592186569995 1068 #edb/ref 17592186569883 13194139536394 17592186045417 true] [17592186569995 1068 #edb/ref 17592186569908 13194139536394 17592186045417 true] [17592186569995 1068 #edb/ref 17592186569951 13194139536394 17592186045417 true] [17592186569995 1069 "q-257199" 13194139536394 17592186045417 true] [17592186569995 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569995 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[1,2]\\times [0,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)=2{x}^{2}y-4x-2y-2{y}^{2}.\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[2,\\,1]^{T}.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">$[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$4$\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]({x}_{1}-{x}_{0})\\,=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n<td align=\"left\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-3}}\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-4$\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-2$\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186569995 1072 #uuid "5acc736b-d0d8-5439-9126-2975fad286b2" 13194139536394 17592186045417 true] [17592186569995 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be rewritten as\n\n$$\n{H}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-∇f({x}_{n}).\n$$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(2{x}^{2}y-4x-2y-2{y}^{2}) \\\\ \\frac{∂}{∂y}(2{x}^{2}y-4x-2y-2{y}^{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}4xy-4 \\\\ 2{x}^{2}-2-4y\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4xy-4) & \\frac{∂}{∂x}(2{x}^{2}-2-4y) \\\\ \\frac{∂}{∂y}(4xy-4) & \\frac{∂}{∂y}(2{x}^{2}-2-4y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4y & 4x \\\\ 4x & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{\\begin{bmatrix}4y & 4x \\\\ 4x & -4\\end{bmatrix}}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{\\begin{bmatrix}4xy-4 \\\\ 2{x}^{2}-2-4y\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}4y & 4x \\\\ 4x & -4\\end{bmatrix}}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{\\begin{bmatrix}4xy-4 \\\\ 2{x}^{2}-2-4y\\end{bmatrix}}_{{x}_{0}} \\\\ \\begin{bmatrix}4(1) & 4(2) \\\\ 4(2) & -4\\end{bmatrix}({x}_{1}-{x}_{0}) & =-\\begin{bmatrix}4(2)(1)-4 \\\\ 2(2)^{2}-2-4(1)\\end{bmatrix} \\\\ \\begin{bmatrix}4 & 8 \\\\ 8 & -4\\end{bmatrix}({x}_{1}-{x}_{0}) & =\\begin{bmatrix}-4 \\\\ -2\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569996 1068 #edb/ref 17592186569861 13194139536394 17592186045417 true] [17592186569996 1069 "q-23418" 13194139536394 17592186045417 true] [17592186569996 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569996 1071 "Find the value of $\\operatorname{sec}⁡(\\frac{\\pi }{2}).$" 13194139536394 17592186045417 true] [17592186569996 1072 #uuid "5dc0c374-75b0-5038-a236-6349d3712634" 13194139536394 17592186045417 true] [17592186569996 1074 "The angle $\\frac{\\pi }{2}$ is a quadrantal angle. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{2}$ corresponds to the point $(0,1).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{\\pi }{2})=\\frac{1}{\\operatorname{cos}⁡(\\frac{\\pi }{2})}=\\frac{1}{0}.\n$$\n\nHowever, division by zero is undefined. Therefore, $\\operatorname{sec}⁡(\\frac{\\pi }{2})$ is undefined." 13194139536394 17592186045417 true] [17592186569997 1068 #edb/ref 17592186569902 13194139536394 17592186045417 true] [17592186569997 1069 "q-123585" 13194139536394 17592186045417 true] [17592186569997 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186569997 1071 "Find the value of $\\operatorname{sec}⁡({180}^{∘})+\\operatorname{csc}⁡({90}^{∘}).$" 13194139536394 17592186045417 true] [17592186569997 1072 #uuid "621a7d94-aa15-5da2-a86e-6e37bead83f1" 13194139536394 17592186045417 true] [17592186569997 1074 "The angles ${180}^{∘}$ and ${90}^{∘}$ are quadrantal angles. Let's draw out the quadrantal angles on the unit circle.\n\n![](images/79/792a778286533d589a3410223aaf197b07e64ea77566042d7bb8ac13fbad9768.png)\n\n- Let's first consider the angle ${180}^{∘}.$ From the unit circle, we see that the angle ${180}^{∘}$ corresponds to the point $(-1,0).$  Since the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡({180}^{∘})=-1.$ Therefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡({180}^{∘})=\\frac{1}{\\operatorname{cos}⁡({180}^{∘})}=\\frac{1}{-1}=-1.\n$$\n\n- Now, let's consider the angle ${90}^{∘}.$ From the unit circle, we see that the angle ${90}^{∘}$ corresponds to the point $(0,1).$  Since the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡({90}^{∘})=1.$ Therefore, using the fact that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we have\n\n$$\n\\operatorname{csc}⁡({90}^{∘})=\\frac{1}{\\operatorname{sin}⁡({90}^{∘})}=\\frac{1}{1}=1.\n$$\n\nFinally, we get\n\n$$\n\\operatorname{sec}⁡({180}^{∘})+\\operatorname{csc}⁡({90}^{∘})=-1+1=0.\n$$" 13194139536394 17592186045417 true] [17592186569998 1068 #edb/ref 17592186569897 13194139536394 17592186045417 true] [17592186569998 1069 "q-74951" 13194139536394 17592186045417 true] [17592186569998 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569998 1071 "Given that\n$A=\\begin{bmatrix}3 & 2 \\\\ -4 & -3\\end{bmatrix}.$ \nhas the LU decomposition $A=LU$, then $L=$" 13194139536394 17592186045417 true] [17592186569998 1072 #uuid "66c0358e-dcf2-5965-acb4-eb43f1da9799" 13194139536394 17592186045417 true] [17592186569998 1074 "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 2 \\\\ -4 & -3\\end{bmatrix} & {R}_{2} & :={R}_{2}+\\frac{4}{3}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}3 & 2 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ \\frac{4}{3} & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -\\frac{4}{3} & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}3 & 2 \\\\ 0 & -\\frac{1}{3}\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186569999 1068 #edb/ref 17592186569947 13194139536394 17592186045417 true] [17592186569999 1069 "q-337038" 13194139536394 17592186045417 true] [17592186569999 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186569999 1071 "The number of heads facing upward after tossing $3$ unfair coins follows the probability mass function $f(x)$ shown in the table below. What is the expected value of the number of heads facing upward after tossing the $3$ coins? Do not round the answer.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{2}{9}$ | $\\frac{1}{3}$ | $\\frac{1}{9}$ | $\\frac{1}{3}$ |\n\n$\\text{E}[X]=$\n{{field-1}}" 13194139536394 17592186045417 true] [17592186569999 1072 #uuid "6f220269-fce2-5308-a544-a882143be2b5" 13194139536394 17592186045417 true] [17592186569999 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{2}{9})+1(\\frac{1}{3})+2(\\frac{1}{9})+3(\\frac{1}{3}) \\\\  & =0+\\frac{1}{3}+\\frac{2}{9}+1 \\\\  & =0+\\frac{3}{9}+\\frac{2}{9}+\\frac{9}{9} \\\\  & =\\frac{0+3+2+9}{9} \\\\  & =\\frac{14}{9}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570000 1068 #edb/ref 17592186569935 13194139536394 17592186045417 true] [17592186570000 1069 "q-84067" 13194139536394 17592186045417 true] [17592186570000 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570000 1071 "Several children were asked how many siblings they have. The number of siblings of each child was recorded below. If $X$ is the number of siblings of a randomly selected child, what is the expected value of $X?$\n\n| Number of siblings | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| Number of Children | $1$ | $5$ | $3$ | $1$ |" 13194139536394 17592186045417 true] [17592186570000 1072 #uuid "700fffbb-cd63-5378-9077-32b4c2add6e6" 13194139536394 17592186045417 true] [17592186570000 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the number of siblings, so we can start by computing the corresponding probabilities. The total number of children is $1+5+3+1=10,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=0)=f(0) & =\\frac{1}{10} \\\\ P(X=1)=f(1) & =\\frac{5}{10}=\\frac{1}{2} \\\\ P(X=2)=f(2) & =\\frac{3}{10} \\\\ P(X=3)=f(3) & =\\frac{1}{10}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{10}$ | $\\frac{1}{2}$ | $\\frac{3}{10}$ | $\\frac{1}{10}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =0(\\frac{1}{10})+1(\\frac{1}{2})+2(\\frac{3}{10})+3(\\frac{1}{10}) \\\\  & =0+\\frac{5}{10}+\\frac{6}{10}+\\frac{3}{10} \\\\  & =\\frac{0+5+6+3}{10} \\\\  & =\\frac{14}{10} \\\\  & =1.4\\,.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570001 1068 #edb/ref 17592186569920 13194139536394 17592186045417 true] [17592186570001 1069 "q-98631" 13194139536394 17592186045417 true] [17592186570001 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570001 1071 "Find the domain of $s(x)=\\sqrt[6]{2x-4}+1.$" 13194139536394 17592186045417 true] [17592186570001 1072 #uuid "7823b972-423e-5466-806b-703ca14c80f8" 13194139536394 17592186045417 true] [17592186570001 1074 "The domain of $y=\\sqrt[6]{x}$ is\n\n$$\nx\\ge 0.\n$$\n\nTo find the domain of $s(x)=\\sqrt[6]{2x-4}+1,$ we replace $x$ with $2x-4$ in the above inequality. This gives\n\n$$\n2x-4\\ge 0.\n$$\n\nSolving this inequality, we get\n\n$$\n\\begin{aligned}2x-4 & \\ge 0 \\\\ 2x & \\ge 4 \\\\ x & \\ge 2\\end{aligned}\n$$\n\nTherefore, the domain of $y=s(x)$ is $x\\in [2,\\infty ).$ \n\nWe can also see that this is true from the graph of the function. The graph of $y=s(x)$ is shown below.\n\n![](images/c3/c340fbe03170ab0dcd2ba0a7c7c32ed6712f96b0eaa944cde2dc40a232e3e32e.png)" 13194139536394 17592186045417 true] [17592186570002 1068 #edb/ref 17592186569847 13194139536394 17592186045417 true] [17592186570002 1068 #edb/ref 17592186569900 13194139536394 17592186045417 true] [17592186570002 1069 "q-257208" 13194139536394 17592186045417 true] [17592186570002 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570002 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[-1,0]\\times [0,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)={y}^{3}-{x}^{2}y-2{x}^{2}-3y.\n$$\n\nCalculate the second iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[-1,\\,2]^{T}$ if the first iteration of the algorithm gives ${x}_{1}=[-0.2,\\,1.2]^{T}.$ Round your final answer to **three decimal places.**\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{2}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186570002 1072 #uuid "7904745e-3c48-5473-a84d-2ea698eb26ae" 13194139536394 17592186045417 true] [17592186570002 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}({y}^{3}-{x}^{2}y-2{x}^{2}-3y) \\\\ \\frac{∂}{∂y}({y}^{3}-{x}^{2}y-2{x}^{2}-3y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2xy-4x \\\\ 3{y}^{2}-{x}^{2}-3\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(-2xy-4x) & \\frac{∂}{∂x}(3{y}^{2}-{x}^{2}-3) \\\\ \\frac{∂}{∂y}(-2xy-4x) & \\frac{∂}{∂y}(3{y}^{2}-{x}^{2}-3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2y-4 & -2x \\\\ -2x & 6y\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}-2y-4 & -2x \\\\ -2x & 6y\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}-2xy-4x \\\\ 3{y}^{2}-{x}^{2}-3\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{\\begin{bmatrix}-2y-4 & -2x \\\\ -2x & 6y\\end{bmatrix}}_{{x}_{1}}^{-1}{\\begin{bmatrix}-2xy-4x \\\\ 3{y}^{2}-{x}^{2}-3\\end{bmatrix}}_{{x}_{1}} \\\\  & =\\begin{bmatrix}-0.2 \\\\ 1.2\\end{bmatrix}-{\\begin{bmatrix}-2(1.2)-4 & -2(-0.2) \\\\ -2(-0.2) & 6(1.2)\\end{bmatrix}}^{-1}\\begin{bmatrix}-2(-0.2)(1.2)-4(-0.2) \\\\ 3(1.2)^{2}-(-0.2)^{2}-3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-0.2 \\\\ 1.2\\end{bmatrix}-{\\begin{bmatrix}-6.4 & 0.4 \\\\ 0.4 & 7.2\\end{bmatrix}}^{-1}\\begin{bmatrix}1.28 \\\\ 1.28\\end{bmatrix} \\\\  & =\\begin{bmatrix}-0.2 \\\\ 1.2\\end{bmatrix}-\\frac{1}{(-6.4)\\cdot 7.2-0.4\\cdot 0.4}\\begin{bmatrix}7.2 & -0.4 \\\\ -0.4 & -6.4\\end{bmatrix}\\begin{bmatrix}1.28 \\\\ 1.28\\end{bmatrix} \\\\  & =\\begin{bmatrix}-0.2 \\\\ 1.2\\end{bmatrix}+\\frac{1}{46.24}\\begin{bmatrix}8.704 \\\\ -8.704\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}-0.012 \\\\ 1.012\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570003 1068 #edb/ref 17592186569901 13194139536394 17592186045417 true] [17592186570003 1069 "q-69844" 13194139536394 17592186045417 true] [17592186570003 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570003 1071 "Factor the expression ${s}^{6}-4{s}^{5}+4{s}^{4}.$" 13194139536394 17592186045417 true] [17592186570003 1072 #uuid "7cf33662-4ad6-5aa7-8431-3b990d895f49" 13194139536394 17592186045417 true] [17592186570003 1074 "First, notice that all of the terms have a common factor of ${s}^{4}.$ To simplify the computation, we can factor out the ${s}^{4},$ as follows:\n\n$$\n\\begin{aligned}{s}^{6}-4{s}^{5}+4{s}^{4} & ={s}^{4}({s}^{2}-4s+4)\\end{aligned}\n$$\n\nThe expression ${s}^{2}-4s+4$ is a perfect square trinomial that can be factored as follows:\n\n$$\n\\begin{aligned}{s}^{4}({s}^{2}-4s+4) & = \\\\ {s}^{4}({s}^{2}-4s+{2}^{2}) & = \\\\ {s}^{4}({s}^{2}-2\\cdot 2\\cdot s+{2}^{2}) & = \\\\ {s}^{4}(s-2)^{2}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570004 1068 #edb/ref 17592186569912 13194139536394 17592186045417 true] [17592186570004 1069 "q-334308" 13194139536394 17592186045417 true] [17592186570004 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570004 1071 "$$\n{x}^{′}=\\begin{bmatrix}-1 & 1 \\\\ 0 & -1\\end{bmatrix}x,\\,{x}_{1}(t)=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{-t},\\,{x}_{2}(t)=\\begin{bmatrix}t+2 \\\\ 1\\end{bmatrix}{e}^{-t}\n$$\n\nConsider the system of linear ODEs and two of its linearly independent solutions ${x}_{1}$ and ${x}_{2},$ shown above. Which of the following is a fundamental matrix for the system?" 13194139536394 17592186045417 true] [17592186570004 1072 #uuid "808ef5db-aeee-5e2b-ba0b-cf24a0046d0e" 13194139536394 17592186045417 true] [17592186570004 1074 "Given a linear system ${x}^{′}=Ax,$ where $A$ is an $n\\times n$ matrix, a *fundamental matrix* $Φ(t)$ of the system is an $n\\times n$ matrix whose columns are linearly independent solutions of the system.\n\nIn our case, we have a $2\\times 2$ system. We are also given that the two linearly independent solutions of the system are the following:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =\\begin{bmatrix}1 \\\\ 0\\end{bmatrix}{e}^{-t}=\\begin{bmatrix}{e}^{-t} \\\\ 0\\end{bmatrix} \\\\ {x}_{2}(t) & =\\begin{bmatrix}t+2 \\\\ 1\\end{bmatrix}{e}^{-t}=\\begin{bmatrix}(t+2){e}^{-t} \\\\ {e}^{-t}\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=\\begin{bmatrix}{e}^{-t} & (t+2){e}^{-t} \\\\ 0 & {e}^{-t}\\end{bmatrix}.\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." 13194139536394 17592186045417 true] [17592186570005 1068 #edb/ref 17592186569916 13194139536394 17592186045417 true] [17592186570005 1069 "q-41477" 13194139536394 17592186045417 true] [17592186570005 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570005 1071 "![](images/29/296883eddf8dc4521e4fa1313e1f3176c965a376d55ecb9189fa913adc8d2625.png)\n\nPart of the graph of a function $y=f(x)$ with period $4$ is shown above. What is the graph of $y=f(x)$ on the interval $-6\\le x\\le 6?$" 13194139536394 17592186045417 true] [17592186570005 1072 #uuid "81171e25-e5ad-5118-af05-1058347bd84c" 13194139536394 17592186045417 true] [17592186570005 1074 "The graph above shows the function in the interval $-2\\le x\\le 2.$\n\nSince this interval has length $4,$ and the period of the function is also $4,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $4.$\n\n![](images/13/13eb143d92cd215f9283a44ad67ca91e679610d4b6625ae53ced56295430e843.png)" 13194139536394 17592186045417 true] [17592186570006 1068 #edb/ref 17592186569943 13194139536394 17592186045417 true] [17592186570006 1069 "q-79511" 13194139536394 17592186045417 true] [17592186570006 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570006 1071 "What is the $4$th term of the geometric sequence given below?\n\n$$\n{a}_{n+1}=-6{a}_{n},\\,{a}_{1}=\\frac{1}{36},\\,n\\ge 1\n$$" 13194139536394 17592186045417 true] [17592186570006 1072 #uuid "857b63a1-09cd-5ba9-9404-4c37877c9864" 13194139536394 17592186045417 true] [17592186570006 1074 "We use the recursive formula to compute the terms of the sequence up to the $4$th term:\n\n$$\n\\begin{aligned}{a}_{1} & =\\frac{1}{36} \\\\ {a}_{2} & =-6{a}_{1}=-6(\\frac{1}{36})=-\\frac{1}{6} \\\\ {a}_{3} & =-6{a}_{2}=-6(-\\frac{1}{6})=1 \\\\ {a}_{4} & =-6{a}_{3}=-6(1)=-6\\end{aligned}\n$$\n\nTherefore, ${a}_{4}=-6.$" 13194139536394 17592186045417 true] [17592186570007 1068 #edb/ref 17592186569852 13194139536394 17592186045417 true] [17592186570007 1069 "q-85406" 13194139536394 17592186045417 true] [17592186570007 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570007 1071 "Rationalize the denominator of $\\frac{1}{\\sqrt{3w}+\\sqrt{2}}.$" 13194139536394 17592186045417 true] [17592186570007 1072 #uuid "87b6f4b7-9188-5e3b-b5e9-cf42f85068fb" 13194139536394 17592186045417 true] [17592186570007 1074 "First, note that the denominator's conjugate is $\\sqrt{3w}-\\sqrt{2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{3w}-\\sqrt{2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{3w}+\\sqrt{2}} & = \\\\ \\frac{1}{\\sqrt{3w}+\\sqrt{2}}\\cdot \\frac{\\sqrt{3w}-\\sqrt{2}}{\\sqrt{3w}-\\sqrt{2}} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2})}{(\\sqrt{3w}+\\sqrt{2})(\\sqrt{3w}-\\sqrt{2})} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2}}{(\\sqrt{3w})^{2}-(\\sqrt{2})^{2}} & = \\\\ \\frac{\\sqrt{3w}-\\sqrt{2}}{3w-2}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570008 1068 #edb/ref 17592186569939 13194139536394 17592186045417 true] [17592186570008 1069 "q-85320" 13194139536394 17592186045417 true] [17592186570008 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570008 1071 "Rationalize the denominator of $\\frac{1}{\\sqrt{a}-2}.$" 13194139536394 17592186045417 true] [17592186570008 1072 #uuid "899489ed-bce7-5e1a-a61e-2e188dc20acb" 13194139536394 17592186045417 true] [17592186570008 1074 "First, note that the denominator's conjugate is $\\sqrt{a}+2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{a}+2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{\\sqrt{a}-2} & = \\\\ \\frac{1}{\\sqrt{a}-2}\\cdot \\frac{\\sqrt{a}+2}{\\sqrt{a}+2} & = \\\\ \\frac{\\sqrt{a}+2}{(\\sqrt{a}-2)(\\sqrt{a}+2)} & = \\\\ \\frac{\\sqrt{a}+2}{(\\sqrt{a})^{2}-{2}^{2}} & = \\\\ \\frac{\\sqrt{a}+2}{a-4}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570009 1068 #edb/ref 17592186569892 13194139536394 17592186045417 true] [17592186570009 1069 "q-32550" 13194139536394 17592186045417 true] [17592186570009 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570009 1071 "Given that \n$A=\\begin{bmatrix}1 & -2 \\\\ -5 & 6\\end{bmatrix}$ has the LU decomposition $A=LU,$ then $L=$" 13194139536394 17592186045417 true] [17592186570009 1072 #uuid "903883c2-c07e-50f2-a202-1c38e08cadfc" 13194139536394 17592186045417 true] [17592186570009 1074 "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & -2 \\\\ -5 & 6\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}}\\cdot A \\\\  & ∼\\begin{bmatrix}1 & -2 \\\\ 0 & -4\\end{bmatrix} \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={\\begin{bmatrix}1 & 0 \\\\ 5 & 1\\end{bmatrix}}^{-1}U \\\\ A & ={{\\begin{bmatrix}1 & 0 \\\\ -5 & 1\\end{bmatrix}}_{⏟}}_{L}{{\\begin{bmatrix}1 & -2 \\\\ 0 & -4\\end{bmatrix}}_{⏟}}_{U}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570010 1068 #edb/ref 17592186569868 13194139536394 17592186045417 true] [17592186570010 1069 "q-6409" 13194139536394 17592186045417 true] [17592186570010 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570010 1071 "![](images/43/43a50373c9cfa5925a01054ab5eb465ac8a6220fced41ab46d8e026908884537.png)\n\nCalculate the length of the side $x$, giving your answer to two decimal places." 13194139536394 17592186045417 true] [17592186570010 1072 #uuid "903d6591-71d0-55aa-98cb-3913a9cd46ac" 13194139536394 17592186045417 true] [17592186570010 1074 "The Law of Cosines states that\n\n$$\n{x}^{2}={y}^{2}+{z}^{2}-2yz\\operatorname{cos}⁡X.\n$$\n\nHere, we have\n\n$$\nm∠X={66}^{∘},\\,y=16,\\,z=19.\n$$\n\nSubstituting the numbers into the formula gives\n\n$$\n\\begin{aligned}{x}^{2} & ={16}^{2}+{19}^{2}-2(16)(19)\\operatorname{cos}⁡{66}^{∘} \\\\  & =256+361-608\\operatorname{cos}⁡{66}^{∘} \\\\  & =617-608(0.406\\,73…) \\\\  & =617-247.295\\,88 \\\\  & =369.704\\,12\\end{aligned}\n$$\n\nrounded to $5$ decimal places\n\nTaking the square root gives\n\n$$\nx=\\sqrt{369.708\\,16}=19.23\n$$\n\nrounded to two decimal places." 13194139536394 17592186045417 true] [17592186570011 1068 #edb/ref 17592186569858 13194139536394 17592186045417 true] [17592186570011 1069 "q-84938" 13194139536394 17592186045417 true] [17592186570011 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570011 1071 "![](images/2a/2a69b06fdf2997514ed4ba507461010725d0b453aaa56f0e0c87f901ee7fa466.png)\n\nWhat is the vertex of the parabola shown above?" 13194139536394 17592186045417 true] [17592186570011 1072 #uuid "92645059-4fec-5363-9452-fc24032daa5d" 13194139536394 17592186045417 true] [17592186570011 1074 "The vertex of an upward-opening parabola is the lowest point of the parabola.\n\n![](images/7b/7b402346a77c6c52467fda2d7f488d123f9551c18cb06cac96765bda3c4b99d7.png)\n\n  \n\nTherefore, the coordinates of the vertex are $(0,0).$" 13194139536394 17592186045417 true] [17592186570012 1068 #edb/ref 17592186569866 13194139536394 17592186045417 true] [17592186570012 1069 "q-276297" 13194139536394 17592186045417 true] [17592186570012 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570012 1071 "A fair spinner has six sides labeled with the numbers $-2,$ $-1,$ $0,$ $1,$ $2,$ and $3.$ If the spinner is spun, what is the expected value of the outcome?\n\n$\\text{E}[X]=$\n{{field-1}}" 13194139536394 17592186045417 true] [17592186570012 1072 #uuid "9cdf7c4f-4409-57f0-b1eb-dca5de834f65" 13194139536394 17592186045417 true] [17592186570012 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the outcome of the spinner. Then the support is $S=\\{-2,-1,0,1,2,3\\},$ and the corresponding probabilities are all $\\frac{1}{6}:$\n\n$$\nf(-2)=f(-1)=f(0)=f(1)=f(2)=f(3)=\\frac{1}{6}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =-2\\cdot f(-2)+(-1)\\cdot f(-1)+0\\cdot f(0)+1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3) \\\\  & =-2(\\frac{1}{6})+(-1)(\\frac{1}{6})+0(\\frac{1}{6})+1(\\frac{1}{6})+2(\\frac{1}{6})+3(\\frac{1}{6}) \\\\  & =-\\frac{2}{6}-\\frac{1}{6}+0+\\frac{1}{6}+\\frac{2}{6}+\\frac{3}{6} \\\\  & =\\frac{-2-1+0+1+2+3}{6} \\\\  & =\\frac{3}{6} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570013 1068 #edb/ref 17592186569882 13194139536394 17592186045417 true] [17592186570013 1069 "q-14701" 13194139536394 17592186045417 true] [17592186570013 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570013 1071 "![](images/40/40ee0a065e8733bd1ab22c04af39b358da5106791af6b99017cef1d07c13abcd.png)\n\nFor the triangle above, find $m∠A$ in degrees to two decimal places." 13194139536394 17592186045417 true] [17592186570013 1072 #uuid "9ede5978-9720-5b14-aefb-d172677e353f" 13194139536394 17592186045417 true] [17592186570013 1074 "We use the Law of Cosines to solve for angle $A:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A &=\\frac{{b}^{2}+{c}^{2}-{a}^{2}}{2bc}.\\end{aligned}\n$$\n\nHere, we have\n\n$$\na=5,\\,b=8,\\,c=9.\n$$\n\nThis gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡A & =\\frac{{9}^{2}+{8}^{2}-{5}^{2}}{2(9)(8)} \\\\  & =\\frac{81+64-25}{144} \\\\  & =\\frac{120}{144} \\\\  & =\\frac{5}{6}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}m∠A & =\\operatorname{arccos}⁡(\\frac{5}{6}) \\\\  & ={33.56}^{∘}\\end{aligned}\n$$\n\nrounded to two decimal places." 13194139536394 17592186045417 true] [17592186570014 1068 #edb/ref 17592186569944 13194139536394 17592186045417 true] [17592186570014 1069 "q-111098" 13194139536394 17592186045417 true] [17592186570014 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570014 1071 "Rationalize the denominator of $\\frac{4}{\\sqrt{t}-\\sqrt{t-2}}.$" 13194139536394 17592186045417 true] [17592186570014 1072 #uuid "a1da1538-2a0a-558a-a1d3-261eb037e2ac" 13194139536394 17592186045417 true] [17592186570014 1074 "First, note that the denominator's conjugate is $\\sqrt{t}+\\sqrt{t-2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{t}+\\sqrt{t-2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{4}{\\sqrt{t}-\\sqrt{t-2}} & = \\\\ \\frac{4}{\\sqrt{t}-\\sqrt{t-2}}\\cdot \\frac{\\sqrt{t}+\\sqrt{t-2}}{\\sqrt{t}+\\sqrt{t-2}} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{(\\sqrt{t}-\\sqrt{t-2})(\\sqrt{t}+\\sqrt{t-2})} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{(\\sqrt{t})^{2}-(\\sqrt{t-2})^{2}} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{t-(t-2)} & = \\\\ \\frac{4(\\sqrt{t}+\\sqrt{t-2})}{2} & = \\\\ 2(\\sqrt{t}+\\sqrt{t-2})\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570015 1068 #edb/ref 17592186569899 13194139536394 17592186045417 true] [17592186570015 1069 "q-123595" 13194139536394 17592186045417 true] [17592186570015 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570015 1071 "$\\operatorname{sin}⁡{45}^{∘}=$" 13194139536394 17592186045417 true] [17592186570015 1072 #uuid "a462c56c-120f-5159-b0b8-404f14801fe3" 13194139536394 17592186045417 true] [17592186570015 1074 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/d9/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the unit circle, we see that the angle ${45}^{∘}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the sine of the angle corresponds to the $y$-coordinate, we have $\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2}.$" 13194139536394 17592186045417 true] [17592186570016 1068 #edb/ref 17592186569873 13194139536394 17592186045417 true] [17592186570016 1069 "q-144906" 13194139536394 17592186045417 true] [17592186570016 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570016 1071 "Consider the polar curve $r=4{sin}^{2}⁡\\theta {cos}^{3}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=8\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2),\\,{y}^{′}(\\theta )=3{sin}^{2}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})$ is undefined\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" 13194139536394 17592186045417 true] [17592186570016 1072 #uuid "a72cce3a-417b-593f-a3ca-475feb70703d" 13194139536394 17592186045417 true] [17592186570016 1074 "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =3{sin}^{2}⁡(2\\cdot \\frac{\\pi }{2})\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2}) \\\\  & =3\\operatorname{sin}⁡(\\pi )\\operatorname{cos}⁡(\\pi ) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{3{sin}^{2}⁡(2\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{12{sin}^{2}⁡(\\theta ){cos}^{2}⁡(\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\operatorname{sin}⁡\\theta {cos}^{3}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{12{sin}^{\\cancel{2}}⁡(\\theta ){\\cancel{cos}}^{2}(\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\cancel{sin}\\theta {cos}^{\\cancel{3}}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)}) \\\\  & =\\frac{12\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(2\\theta )}{8\\operatorname{cos}⁡\\theta \\,(3{cos}^{2}⁡\\theta -2)} \\\\  & =\\frac{12\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})}{8\\operatorname{cos}⁡(\\frac{\\pi }{2})(3{cos}^{2}⁡(\\frac{\\pi }{2})-2)} \\\\  & =\\frac{12\\cdot 1\\cdot (-1)}{0\\cdot (3\\cdot 0-2)} \\\\  & =\\frac{-12}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/32/32a586a1fe160a6c3a2cfee3cfb78af3d596679cf40abedeb0b8d622a3cf736c.png)\n\nTherefore, the correct answer is \"None of the statements are true.\"" 13194139536394 17592186045417 true] [17592186570017 1068 #edb/ref 17592186569915 13194139536394 17592186045417 true] [17592186570017 1069 "q-165275" 13194139536394 17592186045417 true] [17592186570017 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570017 1071 "![](images/79/79fbfbbc0ba9421d770699e663d572da21fa40b87d7d361e56797cd666e05df6.png)\n\nPart of the graph of a function $y=f(x)$ with period $3$ is shown above. What is the graph of $y=f(x)$ on the interval $-4\\le x\\le 5?$" 13194139536394 17592186045417 true] [17592186570017 1072 #uuid "ac0004d1-e33b-579f-a242-badcc09a2477" 13194139536394 17592186045417 true] [17592186570017 1074 "The graph above shows the function in the interval $-1\\le x\\le 2.$\n\nSince this interval has length $3,$ and the period of the function is also $3,$ this interval represents a single period of the function.\n\nTherefore, the function will consist of many copies of the shape shown above, shifted horizontally by multiples of $3.$\n\n![](images/71/71356315a5669dbd5d3a794a046e0c647f674905f89099f8c74d521f10b7498c.png)" 13194139536394 17592186045417 true] [17592186570018 1068 #edb/ref 17592186569927 13194139536394 17592186045417 true] [17592186570018 1069 "q-111086" 13194139536394 17592186045417 true] [17592186570018 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570018 1071 "Rationalize the denominator of $\\frac{3t}{1-\\sqrt{1-t}}.$" 13194139536394 17592186045417 true] [17592186570018 1072 #uuid "ad79abb9-c428-5a43-aa85-5dde8ceb1da4" 13194139536394 17592186045417 true] [17592186570018 1074 "First, note that the denominator's conjugate is $1+\\sqrt{1-t}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1+\\sqrt{1-t},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3t}{1-\\sqrt{1-t}} & = \\\\ \\frac{3t}{1-\\sqrt{1-t}}\\cdot \\frac{1+\\sqrt{1-t}}{1+\\sqrt{1-t}} & = \\\\ \\frac{3t(1+\\sqrt{1-t})}{(1-\\sqrt{1-t})(1+\\sqrt{1-t})} & = \\\\ \\frac{3t(1+\\sqrt{1-t})}{{1}^{2}-(\\sqrt{1-t})^{2}} & = \\\\ \\frac{3t(1+\\sqrt{1-t})}{1-(1-t)} & = \\\\ \\frac{3\\cancel{t}(1+\\sqrt{1-t})}{\\cancel{t}} & = \\\\ 3(1+\\sqrt{1-t}) & \\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570019 1068 #edb/ref 17592186569924 13194139536394 17592186045417 true] [17592186570019 1069 "q-14692" 13194139536394 17592186045417 true] [17592186570019 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570019 1071 "![](images/66/66d24d8cc70ffaed2421d0a5a0086fd7848b4d3e98bc8a6e87588c6c2b04e19d.png)\n\nCalculate the length of the side $c$, giving your answer to two decimal places." 13194139536394 17592186045417 true] [17592186570019 1072 #uuid "b48e833b-67d8-59d3-81e1-297aecf64a45" 13194139536394 17592186045417 true] [17592186570019 1074 "The Law of Cosines states that\n\n$$\n{c}^{2}={a}^{2}+{b}^{2}-2ab\\operatorname{cos}⁡C.\n$$\n\nHere, we have\n\n$$\nm∠C={43}^{∘},\\,a=10,\\,b=13.\n$$\n\nSubstituting the numbers into the formula gives\n\n$$\n\\begin{aligned}{c}^{2} & ={10}^{2}+{13}^{2}-2(10)(13)\\operatorname{cos}⁡{43}^{∘} \\\\  & =100+169-260\\operatorname{cos}⁡{43}^{∘} \\\\  & =269-260(0.731\\,35…) \\\\  & =269-190.151\\,96 \\\\  & =78.848\\,04.\\end{aligned}\n$$\n\nrounded to $5$ decimal places\n\nTaking the square root gives\n\n$$\nc=\\sqrt{78.848\\,04}=8.88\n$$\n\nrounded to two decimal places." 13194139536394 17592186045417 true] [17592186570020 1068 #edb/ref 17592186569940 13194139536394 17592186045417 true] [17592186570020 1069 "q-84973" 13194139536394 17592186045417 true] [17592186570020 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570020 1071 "What are the coordinates of the vertex of the parabola $(y-2)^{2}=24x?$" 13194139536394 17592186045417 true] [17592186570020 1072 #uuid "b967fd96-33d4-527f-b0fa-13d15459432d" 13194139536394 17592186045417 true] [17592186570020 1074 "The standard equation of a left- or right-opening parabola that has its vertex at $(h,k)$ is\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nwhere $p$ is constant.\n\nWe can rewrite the given equation as \n\n$$\n(y-2)^{2}=4(6)(x-0).\n$$\n\nIt is now clear that our equation is of the standard type with $p=6.$ \n\nComparing our equation with the standard equation, we can see that we have $h=0$ and $k=2.$ Therefore, the coordinates of the vertex of the parabola are $(0,2).$" 13194139536394 17592186045417 true] [17592186570021 1068 #edb/ref 17592186569914 13194139536394 17592186045417 true] [17592186570021 1069 "q-257191" 13194139536394 17592186045417 true] [17592186570021 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570021 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[-2,0]\\times [-2,0]⊆{R}^{2},$ where\n\n$$\nf(x,y)=4{x}^{2}y+3{x}^{2}-xy-2x.\n$$\n\nCalculate one iteration of the Newton-Raphson process for optimization that starts at ${x}_{0}=[-1,\\,-1]^{T}.$ Round your final answer to three decimal places (if needed).\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-0.444$\n</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186570021 1072 #uuid "cd16fbf2-f5ff-5242-b610-fb61c79ec2b3" 13194139536394 17592186045417 true] [17592186570021 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4{x}^{2}y+3{x}^{2}-xy-2x) \\\\ \\frac{∂}{∂y}(4{x}^{2}y+3{x}^{2}-xy-2x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}8xy+6x-y-2 \\\\ 4{x}^{2}-x\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(8xy+6x-y-2) & \\frac{∂}{∂x}(4{x}^{2}-x) \\\\ \\frac{∂}{∂y}(8xy+6x-y-2) & \\frac{∂}{∂y}(4{x}^{2}-x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}8y+6 & 8x-1 \\\\ 8x-1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{\\begin{bmatrix}8y+6 & 8x-1 \\\\ 8x-1 & 0\\end{bmatrix}}_{{x}_{n}}^{-1}{\\begin{bmatrix}8xy+6x-y-2 \\\\ 4{x}^{2}-x\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with\n${x}_{0}=\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}-{\\begin{bmatrix}8y+6 & 8x-1 \\\\ 8x-1 & 0\\end{bmatrix}}_{{x}_{0}}^{-1}{\\begin{bmatrix}8xy+6x-y-2 \\\\ 4{x}^{2}-x\\end{bmatrix}}_{{x}_{0}} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}-{\\begin{bmatrix}8(-1)+6 & 8(-1)-1 \\\\ 8(-1)-1 & 0\\end{bmatrix}}^{-1}\\begin{bmatrix}8(-1)(-1)+6(-1)-(-1)-2 \\\\ 4(-1)^{2}-(-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}-{\\begin{bmatrix}-2 & -9 \\\\ -9 & 0\\end{bmatrix}}^{-1}\\begin{bmatrix}1 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}-\\frac{1}{(-2)\\cdot 0-(-9)\\cdot (-9)}\\begin{bmatrix}0 & 9 \\\\ 9 & -2\\end{bmatrix}\\begin{bmatrix}1 \\\\ 5\\end{bmatrix} \\\\  & =\\begin{bmatrix}-1 \\\\ -1\\end{bmatrix}+\\frac{1}{81}\\begin{bmatrix}45 \\\\ -1\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}-0.444 \\\\ -1.012\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570022 1068 #edb/ref 17592186569871 13194139536394 17592186045417 true] [17592186570022 1068 #edb/ref 17592186569919 13194139536394 17592186045417 true] [17592186570022 1068 #edb/ref 17592186569929 13194139536394 17592186045417 true] [17592186570022 1068 #edb/ref 17592186569948 13194139536394 17592186045417 true] [17592186570022 1069 "q-257214" 13194139536394 17592186045417 true] [17592186570022 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570022 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,1]\\times [0,1]⊆{R}^{2},$ where\n\n$$\nf(x,y)=6x{y}^{2}-3{x}^{2}-6xy+2x.\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[0,\\,1]^{T},$ and compute the components of the first iteration. Round the answer for ${x}_{1}$ to **three decimal places**.\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">$[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$6$\n</td>\n<td align=\"center\" rowspan=\"2\">$]({x}_{1}-{x}_{0})\\,=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-2$\n</td>\n<td align=\"left\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n$6$\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-3}}</td>\n</tr>\n</tbody></table>\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$0$</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-4}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186570022 1072 #uuid "ce47ce1b-5e64-5fb8-88b0-27f2349480f8" 13194139536394 17592186045417 true] [17592186570022 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be rewritten as\n\n$$\n{H}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-∇f({x}_{n}).\n$$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(6x{y}^{2}-3{x}^{2}-6xy+2x) \\\\ \\frac{∂}{∂y}(6x{y}^{2}-3{x}^{2}-6xy+2x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6{y}^{2}-6x-6y+2 \\\\ 12xy-6x\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(6{y}^{2}-6x-6y+2) & \\frac{∂}{∂x}(12xy-6x) \\\\ \\frac{∂}{∂y}(6{y}^{2}-6x-6y+2) & \\frac{∂}{∂y}(12xy-6x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 12y-6 \\\\ 12y-6 & 12x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{\\begin{bmatrix}-6 & 12y-6 \\\\ 12y-6 & 12x\\end{bmatrix}}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{\\begin{bmatrix}6{y}^{2}-6x-6y+2 \\\\ 12xy-6x\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}-6 & 12y-6 \\\\ 12y-6 & 12x\\end{bmatrix}}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{\\begin{bmatrix}6{y}^{2}-6x-6y+2 \\\\ 12xy-6x\\end{bmatrix}}_{{x}_{0}} \\\\ \\begin{bmatrix}-6 & 12(1)-6 \\\\ 12(1)-6 & 12(0)\\end{bmatrix}({x}_{1}-{x}_{0}) & =-\\begin{bmatrix}6(1)^{2}-6(0)-6(1)+2 \\\\ 12(0)(1)-6(0)\\end{bmatrix} \\\\ \\begin{bmatrix}-6 & 6 \\\\ 6 & 0\\end{bmatrix}({x}_{1}-{x}_{0}) & =\\begin{bmatrix}-2 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nSolving this system of equations, we get $({x}_{1}-{x}_{0})=\\begin{bmatrix}0 \\\\ -1/3\\end{bmatrix}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}+\\begin{bmatrix}0 \\\\ -\\frac{1}{3}\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -\\frac{1}{3}\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}0 \\\\ 0.667\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570023 1068 #edb/ref 17592186569937 13194139536394 17592186045417 true] [17592186570023 1069 "q-337204" 13194139536394 17592186045417 true] [17592186570023 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570023 1071 "A stack of cards has $2$ cards labeled with four and $6$ cards labeled with ten. If one card is randomly drawn from the stack, what is its expected value?\n\n$\\text{E}[X]=$\n{{field-1}}" 13194139536394 17592186045417 true] [17592186570023 1072 #uuid "ceddea1b-a5cb-5c22-91ab-6571fb7ef388" 13194139536394 17592186045417 true] [17592186570023 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the value labeled on a randomly drawn card. Then the support is $S=\\{4,10\\}.$\n\nIn the stack there are $2$ cards labeled with four and $6$ cards labeled with ten (eight cards in total), so the probabilities are as follows:\n\n$$\n\\begin{aligned}P(4) & =\\frac{2}{8}=\\frac{1}{4} \\\\ P(10) & =\\frac{6}{8}=\\frac{3}{4}\\end{aligned}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =4\\cdot f(4)+10\\cdot f(10) \\\\  & =4(\\frac{1}{4})+10(\\frac{3}{4}) \\\\  & =1+\\frac{15}{2} \\\\  & =\\frac{17}{2}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570024 1068 #edb/ref 17592186569884 13194139536394 17592186045417 true] [17592186570024 1069 "q-44531" 13194139536394 17592186045417 true] [17592186570024 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186570024 1071 "Factor $3{n}^{5}+17{n}^{4}-28{n}^{3}.$" 13194139536394 17592186045417 true] [17592186570024 1072 #uuid "cfe388a1-fc00-503a-b10d-218d6be786a1" 13194139536394 17592186045417 true] [17592186570024 1074 "Note that all of the terms have a common factor of ${n}^{3}.$ To simplify the computation, we can factor out the ${n}^{3},$ as follows:\n\n$$\n\\begin{aligned}3{n}^{5}+17{n}^{4}-28{n}^{3} & ={n}^{3}(3{n}^{2}+17n-28)\\end{aligned}\n$$\n\nNow, we factor the polynomial $3{n}^{2}+17n-28,$ as follows:\n\n$$\n\\begin{aligned}{n}^{3}(3{n}^{2}+17n-28) & = \\\\ {n}^{3}((3{n}^{2}-4n)+(21n-28)) & = \\\\ {n}^{3}((3n-4)n+(3n-4)7) & = \\\\ {n}^{3}(3n-4)(n+7)\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570025 1068 #edb/ref 17592186569949 13194139536394 17592186045417 true] [17592186570025 1069 "q-296038" 13194139536394 17592186045417 true] [17592186570025 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186570025 1071 "Rationalize the denominator of $\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}.$" 13194139536394 17592186045417 true] [17592186570025 1072 #uuid "d0a87847-eb14-5299-88a2-d7b26adced93" 13194139536394 17592186045417 true] [17592186570025 1074 "First, note that the denominator's conjugate is $\\sqrt{x-3}-\\sqrt{x-2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{x-3}-\\sqrt{x-2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}} & = \\\\ \\frac{3}{\\sqrt{x-3}+\\sqrt{x-2}}\\cdot \\frac{\\sqrt{x-3}-\\sqrt{x-2}}{\\sqrt{x-3}-\\sqrt{x-2}} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3}+\\sqrt{x-2})(\\sqrt{x-3}-\\sqrt{x-2})} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{(\\sqrt{x-3})^{2}-(\\sqrt{x-2})^{2}} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{x-3-(x-2)} & = \\\\ \\frac{3(\\sqrt{x-3}-\\sqrt{x-2})}{-1} & = \\\\ 3\\sqrt{x-2}-3\\sqrt{x-3}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570026 1068 #edb/ref 17592186569846 13194139536394 17592186045417 true] [17592186570026 1068 #edb/ref 17592186569888 13194139536394 17592186045417 true] [17592186570026 1068 #edb/ref 17592186569928 13194139536394 17592186045417 true] [17592186570026 1069 "q-257201" 13194139536394 17592186045417 true] [17592186570026 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570026 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,1]\\times [1,2]⊆{R}^{2},$ where\n\n$$\nf(x,y)=4x{y}^{2}+3{x}^{2}-6xy-x.\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[1,\\,2]^{T}.$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">$[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">$10$</td>\n<td align=\"center\" rowspan=\"2\">$]({x}_{1}-{x}_{0})\\,=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$-9$</td>\n<td align=\"left\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">$10$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-3}}\n</td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186570026 1072 #uuid "d0e5e71c-da68-5727-a150-890764f120a1" 13194139536394 17592186045417 true] [17592186570026 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be rewritten as\n\n$$\n{H}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-∇f({x}_{n}).\n$$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4x{y}^{2}+3{x}^{2}-6xy-x) \\\\ \\frac{∂}{∂y}(4x{y}^{2}+3{x}^{2}-6xy-x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}4{y}^{2}+6x-6y-1 \\\\ 8xy-6x\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(4{y}^{2}+6x-6y-1) & \\frac{∂}{∂x}(8xy-6x) \\\\ \\frac{∂}{∂y}(4{y}^{2}+6x-6y-1) & \\frac{∂}{∂y}(8xy-6x)\\end{bmatrix} \\\\  & =\\begin{bmatrix}6 & 8y-6 \\\\ 8y-6 & 8x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{\\begin{bmatrix}6 & 8y-6 \\\\ 8y-6 & 8x\\end{bmatrix}}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{\\begin{bmatrix}4{y}^{2}+6x-6y-1 \\\\ 8xy-6x\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=\\begin{bmatrix}1 \\\\ 2\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}6 & 8y-6 \\\\ 8y-6 & 8x\\end{bmatrix}}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{\\begin{bmatrix}4{y}^{2}+6x-6y-1 \\\\ 8xy-6x\\end{bmatrix}}_{{x}_{0}} \\\\ \\begin{bmatrix}6 & 8(2)-6 \\\\ 8(2)-6 & 8(1)\\end{bmatrix}({x}_{1}-{x}_{0}) & =-\\begin{bmatrix}4(2)^{2}+6(1)-6(2)-1 \\\\ 8(1)(2)-6(1)\\end{bmatrix} \\\\ \\begin{bmatrix}6 & 10 \\\\ 10 & 8\\end{bmatrix}({x}_{1}-{x}_{0}) & =\\begin{bmatrix}-9 \\\\ -10\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570027 1068 #edb/ref 17592186569905 13194139536394 17592186045417 true] [17592186570027 1069 "q-1696" 13194139536394 17592186045417 true] [17592186570027 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570027 1071 "$\\operatorname{sec}⁡(\\frac{7\\pi }{6})=$" 13194139536394 17592186045417 true] [17592186570027 1072 #uuid "d25800d2-aaa9-5069-8bc6-84b04968eef5" 13194139536394 17592186045417 true] [17592186570027 1074 "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{7\\pi }{6}$ corresponds to the point $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $\\operatorname{cos}⁡(\\frac{7\\pi }{6})=-\\frac{\\sqrt{3}}{2}.$\n\nTherefore, using the fact that $\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta },$ we have\n\n$$\n\\operatorname{sec}⁡(\\frac{7\\pi }{6})=\\frac{1}{\\operatorname{cos}⁡(\\frac{7\\pi }{6})}=-\\frac{2}{\\sqrt{3}}=-\\frac{2\\sqrt{3}}{3}.\n$$" 13194139536394 17592186045417 true] [17592186570028 1068 #edb/ref 17592186569910 13194139536394 17592186045417 true] [17592186570028 1069 "q-97989" 13194139536394 17592186045417 true] [17592186570028 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570028 1071 "Consider the matrix $A=\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}$ and the quadratic curve ${x}^{T}\\,Ax=3.$ Given that $A$ has  eigenvalues ${\\lambda }_{1}=10$ and ${\\lambda }_{2}=5,$ find the principal axes of the curve." 13194139536394 17592186045417 true] [17592186570028 1072 #uuid "d4dcf09b-7fd5-51e9-80d9-32152841ce22" 13194139536394 17592186045417 true] [17592186570028 1074 "Notice that $A$ is symmetric. \nThe principal axes of the curve \n\n$$\n{x}^{T}\\,Ax=3\n$$\n\nare the vectors that give an orthonormal eigenvector basis for $A.$ Let's now find these eigenvectors.\n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}-10\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}-1 & 2 \\\\ 2 & -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}.\n$$\n\n- For ${\\lambda }_{2}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =\\begin{bmatrix}9 & 2 \\\\ 2 & 6\\end{bmatrix}-5\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix}=\\begin{bmatrix}4 & 2 \\\\ 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{2}=\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.\n$$\n\nTherefore, the principal axes of our curve are\n\n$\\,$ $\\frac{1}{\\sqrt{5}}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}\\,$ and $\\,\\frac{1}{\\sqrt{5}}\\begin{bmatrix}-1 \\\\ 2\\end{bmatrix}.$" 13194139536394 17592186045417 true] [17592186570029 1068 #edb/ref 17592186569885 13194139536394 17592186045417 true] [17592186570029 1069 "q-89157" 13194139536394 17592186045417 true] [17592186570029 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570029 1071 "Several households were asked the number of children that lived there. The number of children in each was recorded below. If $X$ is the number of children that live at a randomly selected household, what is the expected value of $X?$\n\n| Number of Children | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| Number of Households | $6$ | $9$ | $6$ | $3$ |" 13194139536394 17592186045417 true] [17592186570029 1072 #uuid "d599b4ec-9437-5cdd-aa0b-91b4481a6586" 13194139536394 17592186045417 true] [17592186570029 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nWe're given the frequencies of the number of childen, so we can start by computing the corresponding probabilities. The total number of households is $3+9+6+6=24,$ so the corresponding probabilities are as follows:\n\n$$\n\\begin{aligned}P(X=1)=f(1) & =\\frac{6}{24}=\\frac{1}{4} \\\\ P(X=2)=f(2) & =\\frac{9}{24}=\\frac{3}{8} \\\\ P(X=3)=f(3) & =\\frac{6}{24}=\\frac{1}{4} \\\\ P(X=4)=f(4) & =\\frac{3}{24}=\\frac{1}{8}\\end{aligned}\n$$\n\nWe organize these results in the table below.\n\n| $x$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $\\frac{1}{4}$ | $\\frac{3}{8}$ | $\\frac{1}{4}$ | $\\frac{1}{8}$ |\n\nNow, summing up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4) \\\\  & =1(\\frac{1}{4})+2(\\frac{3}{8})+3(\\frac{1}{4})+4(\\frac{1}{8}) \\\\  & =\\frac{1}{4}+\\frac{3}{4}+\\frac{3}{4}+\\frac{2}{4} \\\\  & =\\frac{1+3+3+2}{4} \\\\  & =\\frac{9}{4} \\\\  & =2.25.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570030 1068 #edb/ref 17592186569862 13194139536394 17592186045417 true] [17592186570030 1069 "q-5775" 13194139536394 17592186045417 true] [17592186570030 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570030 1071 "What is the expected value of one roll of a seven-sided die?" 13194139536394 17592186045417 true] [17592186570030 1072 #uuid "d66ccea1-6118-5ac8-bad9-91d326fbbfdc" 13194139536394 17592186045417 true] [17592186570030 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nLet $X$ be the roll of a standard six-sided die. Then the support is $S=\\{1,2,3,4,5,6,7\\},$ and the corresponding probabilities are all $\\frac{1}{7}:$\n\n$$\nf(1)=f(2)=…=f(7)=\\frac{1}{7}\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =1\\cdot f(1)+2\\cdot f(2)+…+7\\cdot f(7) \\\\  & =1(\\frac{1}{7})+2(\\frac{1}{7})+…+7(\\frac{1}{7}) \\\\  & =\\frac{1}{7}+\\frac{2}{7}+…+\\frac{7}{7} \\\\  & =\\frac{1+2+3+4+5+6+7}{7} \\\\  & =\\frac{28}{7} \\\\  & =4\\,.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570031 1068 #edb/ref 17592186569880 13194139536394 17592186045417 true] [17592186570031 1069 "q-111070" 13194139536394 17592186045417 true] [17592186570031 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570031 1071 "Rationalize the denominator of $\\frac{t}{\\sqrt{t}+2}.$" 13194139536394 17592186045417 true] [17592186570031 1072 #uuid "dad03d87-b391-52d0-a812-6cdef4bf6aad" 13194139536394 17592186045417 true] [17592186570031 1074 "First, note that the denominator's conjugate is $\\sqrt{t}-2.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{t}-2,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{t}{\\sqrt{t}+2} & = \\\\ \\frac{t}{\\sqrt{t}+2}\\cdot \\frac{\\sqrt{t}-2}{\\sqrt{t}-2} & = \\\\ \\frac{t(\\sqrt{t}-2)}{(\\sqrt{t}+2)(\\sqrt{t}-2)} & = \\\\ \\frac{t(\\sqrt{t}-2)}{(\\sqrt{t})^{2}-{2}^{2}} & = \\\\ \\frac{t(\\sqrt{t}-2)}{t-4} & \\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570032 1068 #edb/ref 17592186569849 13194139536394 17592186045417 true] [17592186570032 1069 "q-337188" 13194139536394 17592186045417 true] [17592186570032 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570032 1071 "The sum of the outcomes of one roll of two unfair four-sided dice follows the probability mass function $f(x)$ shown in the table below. What is the expected value of the sum of the outcomes for one roll of the two dice?\n\n| $f(x)$ | $\\frac{3}{40}$ | $\\frac{7}{40}$ | $\\frac{1}{5}$ | $\\frac{1}{4}$ | $\\frac{3}{20}$ | $\\frac{1}{10}$ | $\\frac{1}{20}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ | $8$ |\n\n$\\text{E}[X]=$\n{{field-1}}" 13194139536394 17592186045417 true] [17592186570032 1072 #uuid "dc6b2040-54a4-56f7-9767-230b7779b10f" 13194139536394 17592186045417 true] [17592186570032 1074 "The expected value of a discrete random variable $X$ with probability mass function $f(x)$ defined over a set $S$ is given by\n\n$$\n\\text{E}[X]={\\sum }_{x\\in S}x\\cdot f(x).\n$$\n\nSumming up the products of each value of $X$ and its associated probability, we get\n\n$$\n\\begin{aligned}\\text{E}[X] & =2\\cdot f(2)+3\\cdot f(3)+4\\cdot f(4)+5\\cdot f(5) \\\\  & \\,\\,+6\\cdot f(6)+7\\cdot f(7)+8\\cdot f(8) \\\\  & =2(\\frac{3}{40})+3(\\frac{7}{40})+4(\\frac{1}{5})+5(\\frac{1}{4}) \\\\  & \\,\\,+6(\\frac{3}{20})+7(\\frac{1}{10})+8(\\frac{1}{20}) \\\\  & =\\frac{6}{40}+\\frac{21}{40}+\\frac{4}{5}+\\frac{5}{4}+\\frac{18}{20}+\\frac{7}{10}+\\frac{8}{20} \\\\  & =\\frac{6}{40}+\\frac{21}{40}+\\frac{32}{40}+\\frac{50}{40}+\\frac{36}{40}+\\frac{28}{40}+\\frac{16}{40} \\\\  & =\\frac{6+21+32+50+36+28+16}{40} \\\\  & =\\frac{189}{40} \\\\  & =4.725.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570033 1068 #edb/ref 17592186569941 13194139536394 17592186045417 true] [17592186570033 1069 "q-100254" 13194139536394 17592186045417 true] [17592186570033 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570033 1071 "Given that ${7}^{5x}+8=34,$ find the value of $x$ rounded to $3$ decimal places." 13194139536394 17592186045417 true] [17592186570033 1072 #uuid "e0b9a214-575e-56bc-9016-1d953bb568c0" 13194139536394 17592186045417 true] [17592186570033 1074 "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{7}^{5x}+8 & =34 \\\\ {7}^{5x} & =26\\end{aligned}\n$$\n\nNow, we take ${log}_{7}$ of both sides of the equation and solve for $x$:\n\n$$\n\\begin{aligned}{7}^{5x} & =26 \\\\ {log}_{7}⁡({7}^{5x}) & ={log}_{7}⁡(26) \\\\ 5x & ={log}_{7}⁡(26) \\\\ x & =\\frac{1}{5}{log}_{7}⁡(26)\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈0.335\n$$\n\nrounded to $3$ decimal places." 13194139536394 17592186045417 true] [17592186570034 1068 #edb/ref 17592186569934 13194139536394 17592186045417 true] [17592186570034 1069 "q-100794" 13194139536394 17592186045417 true] [17592186570034 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570034 1071 "What is the product of solutions of the equation $3{x}^{2}\\cdot {5}^{x}=11x\\cdot {5}^{x}+4\\cdot {5}^{x}?$" 13194139536394 17592186045417 true] [17592186570034 1072 #uuid "e2c0ab81-ce73-5f44-b936-e8bb7ee9594f" 13194139536394 17592186045417 true] [17592186570034 1074 "First, we factor the equation:\n\n  \n\n$$\n\\begin{aligned}3{x}^{2}\\cdot {5}^{x} & =11x\\cdot {5}^{x}+4\\cdot {5}^{x} \\\\ 3{x}^{2}\\cdot {5}^{x}-11x\\cdot {5}^{x}-4\\cdot {5}^{x} & =0 \\\\ (3{x}^{2}-11x-4)\\cdot {5}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n3{x}^{2}-11x-4=0\\,\\text{and}\\,{5}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $3{x}^{2}-11x-4=0$ can be factored as\n\n$$\n(3x+1)(x-4)=0,\n$$\n\nwhich leads to the solutions $x=-\\frac{1}{3},4.$\n\n- The equation ${5}^{x}=0$ has no solutions because ${5}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-\\frac{1}{3},4,$ and their product is $(-\\frac{1}{3})\\cdot 4=-\\frac{4}{3}.$" 13194139536394 17592186045417 true] [17592186570035 1068 #edb/ref 17592186569895 13194139536394 17592186045417 true] [17592186570035 1068 #edb/ref 17592186569909 13194139536394 17592186045417 true] [17592186570035 1068 #edb/ref 17592186569922 13194139536394 17592186045417 true] [17592186570035 1068 #edb/ref 17592186569923 13194139536394 17592186045417 true] [17592186570035 1069 "q-257213" 13194139536394 17592186045417 true] [17592186570035 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570035 1071 "Suppose we wish to find a critical point of the function $f(x,y)$ in the region $[0,1]\\times [-1,0]⊆{R}^{2},$ where\n\n$$\nf(x,y)=5x{y}^{2}-2xy-{x}^{2}+3y.\n$$\n\nFill in the blanks in the matrix equation below that defines the first iteration of the Newton-Raphson process starting at the point $[1,\\,-1]^{T},$ and compute the components of the first iteration. Round the answer for ${x}_{1}$ to **three decimal places**.\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">$[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">$-2$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-1}}\n</td>\n<td align=\"center\" rowspan=\"2\">$]({x}_{1}-{x}_{0})\\,=[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-5$\n</td>\n<td align=\"left\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"25\">$10$</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-3}}</td>\n</tr>\n</tbody></table>\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\">${x}_{1}≈[$</td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-4}}</td>\n<td align=\"center\" rowspan=\"2\">$]$</td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"25\">\n$-0.524$\n </td>\n</tr>\n</tbody></table>" 13194139536394 17592186045417 true] [17592186570035 1072 #uuid "e391a05d-f936-58b5-934a-ad5b4d40ee91" 13194139536394 17592186045417 true] [17592186570035 1074 "The Newton-Raphson method of optimizing a multivariable function $f:{R}^{n}\\to R$ is\n\n$$\n{x}_{n+1}={x}_{n}-[{H}_{f}({x}_{n})]^{-1}∇f({x}_{n}),\n$$\n\nwhere $H({x}_{n})$ and $∇f({x}_{n})$ are the Hessian and gradient of $f$, respectively, evaluated at ${x}_{n}.$\n\nEquivalently, at each iteration, the above equation can be rewritten as\n\n$$\n{H}_{f}({x}_{n})({x}_{n+1}-{x}_{n})=-∇f({x}_{n}).\n$$\n\nIn our case, the gradient is\n\n$$\n\\begin{aligned}∇f(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(5x{y}^{2}-2xy-{x}^{2}+3y) \\\\ \\frac{∂}{∂y}(5x{y}^{2}-2xy-{x}^{2}+3y)\\end{bmatrix} \\\\  & =\\begin{bmatrix}5{y}^{2}-2y-2x \\\\ 10xy-2x+3\\end{bmatrix},\\end{aligned}\n$$\n\nand the Hessian is\n\n$$\n\\begin{aligned}{H}_{f}(x) & =\\begin{bmatrix}\\frac{∂}{∂x}(5{y}^{2}-2y-2x) & \\frac{∂}{∂x}(10xy-2x+3) \\\\ \\frac{∂}{∂y}(5{y}^{2}-2y-2x) & \\frac{∂}{∂y}(10xy-2x+3)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & 10y-2 \\\\ 10y-2 & 10x\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson system of equations is\n\n$$\n{\\begin{bmatrix}-2 & 10y-2 \\\\ 10y-2 & 10x\\end{bmatrix}}_{{x}_{n}}({x}_{n+1}-{x}_{n})=-{\\begin{bmatrix}5{y}^{2}-2y-2x \\\\ 10xy-2x+3\\end{bmatrix}}_{{x}_{n}}.\n$$\n\nStarting with ${x}_{0}=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix},$ we have\n\n$$\n\\begin{aligned}{\\begin{bmatrix}-2 & 10y-2 \\\\ 10y-2 & 10x\\end{bmatrix}}_{{x}_{0}}({x}_{1}-{x}_{0}) & =-{\\begin{bmatrix}5{y}^{2}-2y-2x \\\\ 10xy-2x+3\\end{bmatrix}}_{{x}_{0}} \\\\ \\begin{bmatrix}-2 & 10(-1)-2 \\\\ 10(-1)-2 & 10(1)\\end{bmatrix}({x}_{1}-{x}_{0}) & =-\\begin{bmatrix}5(-1)^{2}-2(-1)-2(1) \\\\ 10(1)(-1)-2(1)+3\\end{bmatrix} \\\\ \\begin{bmatrix}-2 & -12 \\\\ -12 & 10\\end{bmatrix}({x}_{1}-{x}_{0}) & =\\begin{bmatrix}-5 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nSolving this system of equations, we get $({x}_{1}-{x}_{0})=\\begin{bmatrix}-29/82 \\\\ 39/82\\end{bmatrix}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & ={x}_{0}+\\begin{bmatrix}-\\frac{29}{82} \\\\ \\frac{39}{82}\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}+\\begin{bmatrix}-\\frac{29}{82} \\\\ \\frac{39}{82}\\end{bmatrix} \\\\  & ≈\\begin{bmatrix}0.646 \\\\ -0.524\\end{bmatrix}.\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570036 1068 #edb/ref 17592186569898 13194139536394 17592186045417 true] [17592186570036 1069 "q-67498" 13194139536394 17592186045417 true] [17592186570036 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186570036 1071 "What is the $5$th term of the geometric sequence given below?\n\n$$\nf(n+1)=-\\frac{1}{2}f(n),\\,f(1)=80,\\,n\\ge 1\n$$" 13194139536394 17592186045417 true] [17592186570036 1072 #uuid "e5baa90b-efb9-5b0e-bee8-5a62fcaafd24" 13194139536394 17592186045417 true] [17592186570036 1074 "We use the recursive formula to compute the terms of the sequence up to the $5$th term:\n\n$$\n\\begin{aligned}f(1) & =80 \\\\ f(2) & =-\\frac{1}{2}f(1)=-\\frac{1}{2}(80)=-40 \\\\ f(3) & =-\\frac{1}{2}f(2)=-\\frac{1}{2}(-40)=20 \\\\ f(4) & =-\\frac{1}{2}f(3)=-\\frac{1}{2}(20)=-10 \\\\ f(5) & =-\\frac{1}{2}f(4)=-\\frac{1}{2}(-10)=5\\end{aligned}\n$$\n\nTherefore, $f(5)=5.$" 13194139536394 17592186045417 true] [17592186570037 1068 #edb/ref 17592186569875 13194139536394 17592186045417 true] [17592186570037 1069 "q-115899" 13194139536394 17592186045417 true] [17592186570037 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570037 1071 "What are the coordinates of the vertex of the parabola ${x}^{2}=8y?$" 13194139536394 17592186045417 true] [17592186570037 1072 #uuid "e7d54a09-b694-5b89-8845-bc7803f20047" 13194139536394 17592186045417 true] [17592186570037 1074 "The standard equation of an upward- or downward-opening parabola that has its vertex at the origin is\n\n$$\n{x}^{2}=4py,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{x}^{2}=4(2)y.\n$$\n\nIt is now clear that our equation is of the standard type with $p=2.$ Therefore, our parabola has its vertex at $(0,0).$" 13194139536394 17592186045417 true] [17592186570038 1068 #edb/ref 17592186569887 13194139536394 17592186045417 true] [17592186570038 1069 "q-85376" 13194139536394 17592186045417 true] [17592186570038 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570038 1071 "Rationalize the denominator of $\\frac{2}{1+\\sqrt{1-2w}}.$" 13194139536394 17592186045417 true] [17592186570038 1072 #uuid "e9419475-d219-538e-ac38-b80302aae79f" 13194139536394 17592186045417 true] [17592186570038 1074 "First, note that the denominator's conjugate is $1-\\sqrt{1-2w}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $1-\\sqrt{1-2w},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{1+\\sqrt{1-2w}} & = \\\\ \\frac{2}{1+\\sqrt{1-2w}}\\cdot \\frac{1-\\sqrt{1-2w}}{1-\\sqrt{1-2w}} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{(1+\\sqrt{1-2w})(1-\\sqrt{1-2w})} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{{1}^{2}-(\\sqrt{1-2w})^{2}} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{1-(1-2w)} & = \\\\ \\frac{2(1-\\sqrt{1-2w})}{2w} & = \\\\ \\frac{1-\\sqrt{1-2w}}{w}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570039 1068 #edb/ref 17592186569872 13194139536394 17592186045417 true] [17592186570039 1069 "q-34864" 13194139536394 17592186045417 true] [17592186570039 1070 #edb/ref 17592186045485 13194139536394 17592186045417 true] [17592186570039 1071 "Rationalize the denominator of $\\frac{m}{\\sqrt{m}+m}.$" 13194139536394 17592186045417 true] [17592186570039 1072 #uuid "e9d96fa3-8e95-5519-8ecc-c21bd99ca106" 13194139536394 17592186045417 true] [17592186570039 1074 "First, note that the denominator's conjugate is $\\sqrt{m}-m.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{m}-m,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{m}{\\sqrt{m}+m} & = \\\\ \\frac{m}{\\sqrt{m}+m}\\cdot \\frac{\\sqrt{m}-m}{\\sqrt{m}-m} & = \\\\ \\frac{m(\\sqrt{m}-m)}{(\\sqrt{m}+m)(\\sqrt{m}-m)} & = \\\\ \\frac{m(\\sqrt{m}-m)}{(\\sqrt{m})^{2}-{m}^{2}} & = \\\\ \\frac{m(\\sqrt{m}-m)}{m-{m}^{2}} & = \\\\ \\frac{\\cancel{m}(\\sqrt{m}-m)}{\\cancel{m}(1-m)} & = \\\\ \\frac{\\sqrt{m}-m}{1-m}\\end{aligned}\n$$" 13194139536394 17592186045417 true] [17592186570040 1068 #edb/ref 17592186569854 13194139536394 17592186045417 true] [17592186570040 1069 "q-115887" 13194139536394 17592186045417 true] [17592186570040 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570040 1071 "![](images/20/20b0a99d75653873c8175ff1a65092d23674d9931a1d44848fe939cdb63896af.png)\n\nWhat is the vertex of the parabola shown above?" 13194139536394 17592186045417 true] [17592186570040 1072 #uuid "f3bdf4a3-1557-5260-88ea-6727a0119093" 13194139536394 17592186045417 true] [17592186570040 1074 "The vertex of a downward-opening parabola is the highest point of the parabola.\n\n![](images/e6/e65f778d5ac36e8dd2cadf3f34effb50f13c7c74f05f491edb7f659f205883f1.png)\n\n  \n\nTherefore, the coordinates of the vertex are $(-1,3).$" 13194139536394 17592186045417 true] [17592186570041 1068 #edb/ref 17592186569864 13194139536394 17592186045417 true] [17592186570041 1069 "q-66814" 13194139536394 17592186045417 true] [17592186570041 1070 #edb/ref 17592186045486 13194139536394 17592186045417 true] [17592186570041 1071 "Given that ${11}^{2x-3}=\\sqrt[3]{{7}^{2}},$  find the value of $x$ rounded to $3$ decimal places." 13194139536394 17592186045417 true] [17592186570041 1072 #uuid "fa39cf5e-b1cf-510a-a444-4f30da1c63f4" 13194139536394 17592186045417 true] [17592186570041 1074 "Taking ${log}_{11}$ of both sides of the equation gives:\n\n$$\n\\begin{aligned}{11}^{2x-3} & =\\sqrt[3]{{7}^{2}} \\\\ {log}_{11}⁡({11}^{2x-3}) & ={log}_{11}⁡(\\sqrt[3]{{7}^{2}}) \\\\ 2x-3 & ={log}_{11}⁡({7}^{2/3})\\end{aligned}\n$$\n\nThen, we apply the power rule to the right-hand side:\n\n$$\n2x-3=\\frac{2}{3}{log}_{11}⁡(7)\n$$\n\nNext, we rewrite the right-hand side using the change of base formula and then solve for $x:$\n\n$$\n\\begin{aligned}2x-3 & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)} \\\\ 2x & =\\frac{2\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+3 \\\\ x & =\\frac{\\operatorname{log}⁡(7)}{3\\operatorname{log}⁡(11)}+\\frac{3}{2}\\end{aligned}\n$$\n\nEvaluating the above on a calculator gives\n\n$$\nx≈1.771\n$$\n\nrounded to $3$ decimal places." 13194139536394 17592186045417 true] [17592186570042 1068 #edb/ref 17592186569936 13194139536394 17592186045417 true] [17592186570042 1069 "q-143715" 13194139536394 17592186045417 true] [17592186570042 1070 #edb/ref 17592186045487 13194139536394 17592186045417 true] [17592186570042 1071 "Consider the polar curve $r={cos}^{2}⁡\\theta$ for $\\theta \\in [0,\\pi ).$ Given that \n\n$$\n{x}^{′}(\\theta )=-3\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta ,\\,{y}^{′}(\\theta )=\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta ),\n$$\n\nand ${x}^{′}(\\frac{\\pi }{2})=0,$ which of the following statements are true?\n\nI. ${y}^{′}(\\frac{\\pi }{2})=0$\n\nII. ${lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x}=0$\n\nIII. The curve has a horizontal tangent at $\\theta =\\frac{\\pi }{2}$\n\n*Hint: It is not necessary to use L'Hopital's rule to evaluate the limit in part II.*" 13194139536394 17592186045417 true] [17592186570042 1072 #uuid "fcf32a74-971a-505b-b459-ef18eedf0a90" 13194139536394 17592186045417 true] [17592186570042 1074 "When a polar curve is differentiable at a point ${\\theta }_{0}$, there is a horizontal tangent at ${\\theta }_{0}$ if\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}({\\theta }_{0})}{{x}^{′}({\\theta }_{0})}=0\n$$\n\nwhich is equivalent to\n\n$$\n{y}^{′}({\\theta }_{0})=0\\,\\text{and}\\,{x}^{′}({\\theta }_{0})\\ne 0.\n$$\n\nHowever, if the curve is continuous at ${\\theta }_{0}$ yet the derivative ${y}^{′}(x)$ takes the indeterminate form $\\frac{0}{0}$ at this point, we say that the curve has a horizontal tangent at this point if\n\n$$\n{lim}_{\\theta \\to {\\theta }_{0}}\\frac{\\text{d}y}{\\text{d}x}=0.\n$$\n\nIn this case, we're told that ${x}^{′}(\\frac{\\pi }{2})=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Substituting $\\theta =\\frac{\\pi }{2}$ into the expression for ${y}^{′}(\\theta ),$ we get\n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =\\operatorname{cos}⁡(\\frac{\\pi }{2})({cos}^{2}⁡(\\frac{\\pi }{2})-2{sin}^{2}⁡(\\frac{\\pi }{2})) \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Computing the limit as $\\theta \\to \\frac{\\pi }{2},$ we obtain\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to \\pi /2}\\frac{\\text{d}y}{\\text{d}x} & ={lim}_{\\theta \\to \\pi /2}\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )} \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\operatorname{cos}⁡\\theta ({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡(\\theta ){cos}^{2}⁡(\\theta )}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{\\cancel{\\operatorname{cos}⁡\\theta }({cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta )}{-3\\operatorname{sin}⁡(\\theta ){cos}^{\\cancel{2}}⁡(\\theta )}) \\\\  & ={lim}_{\\theta \\to \\pi /2}(\\frac{{cos}^{2}⁡\\theta -2{sin}^{2}⁡\\theta }{-3\\operatorname{sin}⁡(\\theta )\\operatorname{cos}⁡(\\theta )}) \\\\  & =\\frac{0-2\\cdot 1}{-3\\cdot 1\\cdot 0} \\\\  & =\\frac{-2}{0} \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement III is false. Since the limit in part II does *not* equal to $0,$ there curve does *not* have a horizontal tangent at $\\theta =\\frac{\\pi }{2}.$ In fact, it is a vertical tangent.\n\n![](images/f4/f4609e6433a861ef255cbeeac60c8a316e5c14a89df45030e26e526e3a1253a4.png)\n\nTherefore, the correct answer is \"I only.\"" 13194139536394 17592186045417 true] [17592186570043 1058 #edb/ref 17592186570078 13194139536394 17592186045417 true] [17592186570043 1062 #uuid "0639941a-dbef-51ef-941b-1ba2f1461b7a" 13194139536394 17592186045417 true] [17592186570043 1063 #edb/ref 17592186421762 13194139536394 17592186045417 true] [17592186570044 1058 #edb/ref 17592186570094 13194139536394 17592186045417 true] [17592186570044 1062 #uuid "065f4f4c-48e3-590c-b5e4-ef6c92a8335e" 13194139536394 17592186045417 true] [17592186570044 1063 #edb/ref 17592186180040 13194139536394 17592186045417 true] [17592186570045 1058 #edb/ref 17592186570058 13194139536394 17592186045417 true] [17592186570045 1062 #uuid "114fb63f-63fb-5356-b093-291fb3d3fff9" 13194139536394 17592186045417 true] [17592186570045 1063 #edb/ref 17592186292661 13194139536394 17592186045417 true] [17592186570046 1058 #edb/ref 17592186570068 13194139536394 17592186045417 true] [17592186570046 1062 #uuid "13f445da-252e-570a-ac3a-c01de665b256" 13194139536394 17592186045417 true] [17592186570046 1063 #edb/ref 17592186272160 13194139536394 17592186045417 true] [17592186570047 1058 #edb/ref 17592186570071 13194139536394 17592186045417 true] [17592186570047 1062 #uuid "1549a390-4058-56c9-8564-bd198072e521" 13194139536394 17592186045417 true] [17592186570047 1063 #edb/ref 17592186362252 13194139536394 17592186045417 true] [17592186570048 1058 #edb/ref 17592186570067 13194139536394 17592186045417 true] [17592186570048 1062 #uuid "2842369f-1f4f-58be-953d-3f713b247f9b" 13194139536394 17592186045417 true] [17592186570048 1063 #edb/ref 17592186323840 13194139536394 17592186045417 true] [17592186570049 1062 #uuid "2d5dc701-7f02-5cf5-aa72-c784e2a85c45" 13194139536394 17592186045417 true] [17592186570049 1063 #edb/ref 17592186243953 13194139536394 17592186045417 true] [17592186570050 1058 #edb/ref 17592186570082 13194139536394 17592186045417 true] [17592186570050 1062 #uuid "2ef5b5f9-fd4f-527a-8672-0d1fd4f4c389" 13194139536394 17592186045417 true] [17592186570050 1063 #edb/ref 17592186234038 13194139536394 17592186045417 tru