answer-e1b430b7-55aa-5295-bee6-f4c3c788ec83" "answer-13be8914-3939-5f35-94de-964f577dbb90" "answer-7f851c91-dd31-529b-8d7c-0e3c93a3423b"] :db/ensure [:answer-field/validate]} {:db/id "answer-99ce6949-6298-5efa-9a63-94c02eabace3" :answer/id #uuid "99ce6949-6298-5efa-9a63-94c02eabace3" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{\\pi }}{2}" :db/ensure [:answer/validate]} {:db/id "answer-409a924e-c3d5-573d-a816-4ab2ade05c96" :answer/id #uuid "409a924e-c3d5-573d-a816-4ab2ade05c96" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{\\pi }}{4}" :db/ensure [:answer/validate]} {:db/id "answer-e1b430b7-55aa-5295-bee6-f4c3c788ec83" :answer/id #uuid "e1b430b7-55aa-5295-bee6-f4c3c788ec83" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{\\pi }}{2}" :db/ensure [:answer/validate]} {:db/id "answer-13be8914-3939-5f35-94de-964f577dbb90" :answer/id #uuid "13be8914-3939-5f35-94de-964f577dbb90" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{\\pi }}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7f851c91-dd31-529b-8d7c-0e3c93a3423b" :answer/id #uuid "7f851c91-dd31-529b-8d7c-0e3c93a3423b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{\\pi }}{4}" :db/ensure [:answer/validate]} {:db/id "question-b48192d6-2f48-593d-8172-2cd990c8dfc7" :question/id #uuid "b48192d6-2f48-593d-8172-2cd990c8dfc7" :question/math-academy-id "q-107863" :question/problem "$\\frac{8}{3}\\sqrt{\\pi }\\,Γ(\\frac{7}{2})+\\frac{4}{3}\\sqrt{\\pi }\\,Γ(\\frac{5}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\nΓ(\\frac{5}{2})=\\frac{3}{2}Γ(\\frac{3}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}Γ(\\frac{1}{2})=\\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi }=\\frac{3}{4}\\sqrt{\\pi },\n$$\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2})=\\frac{5}{2}Γ(\\frac{5}{2})=\\frac{5}{2}\\cdot \\frac{3}{4}\\sqrt{\\pi }=\\frac{15}{8}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{8}{3}\\sqrt{\\pi }\\,Γ(\\frac{7}{2})+\\frac{4}{3}\\sqrt{\\pi }\\,Γ(\\frac{5}{2})=\\frac{8}{3}\\sqrt{\\pi }\\cdot \\frac{15}{8}\\sqrt{\\pi }+\\frac{4}{3}\\sqrt{\\pi }\\cdot \\frac{3}{4}\\sqrt{\\pi }=6\\pi .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7b56249b-a83f-5c37-9b6c-4f290fe42129"] :db/ensure [:question/validate]} {:db/id "answer-field-7b56249b-a83f-5c37-9b6c-4f290fe42129" :answer-field/id #uuid "7b56249b-a83f-5c37-9b6c-4f290fe42129" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e4fa379f-90cd-5d9e-a43b-59665a54aa60" :answer-field/choices ["answer-536ec464-0d2e-5e55-96c8-16aa8608d42f" "answer-cf955368-f43e-5c39-80d9-5e7d42b2bb5e" "answer-e4fa379f-90cd-5d9e-a43b-59665a54aa60" "answer-4abc7cc7-9bf0-5283-ac11-c319f0ec887d" "answer-a41c6868-e157-5d04-aa9d-c014ea5af847"] :db/ensure [:answer-field/validate]} {:db/id "answer-536ec464-0d2e-5e55-96c8-16aa8608d42f" :answer/id #uuid "536ec464-0d2e-5e55-96c8-16aa8608d42f" :answer/type :answer.type/math :answer/value "40\\pi " :db/ensure [:answer/validate]} {:db/id "answer-cf955368-f43e-5c39-80d9-5e7d42b2bb5e" :answer/id #uuid "cf955368-f43e-5c39-80d9-5e7d42b2bb5e" :answer/type :answer.type/math :answer/value "45\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e4fa379f-90cd-5d9e-a43b-59665a54aa60" :answer/id #uuid "e4fa379f-90cd-5d9e-a43b-59665a54aa60" :answer/type :answer.type/math :answer/value "6\\pi " :db/ensure [:answer/validate]} {:db/id "answer-4abc7cc7-9bf0-5283-ac11-c319f0ec887d" :answer/id #uuid "4abc7cc7-9bf0-5283-ac11-c319f0ec887d" :answer/type :answer.type/math :answer/value "8\\pi " :db/ensure [:answer/validate]} {:db/id "answer-a41c6868-e157-5d04-aa9d-c014ea5af847" :answer/id #uuid "a41c6868-e157-5d04-aa9d-c014ea5af847" :answer/type :answer.type/math :answer/value "9\\pi " :db/ensure [:answer/validate]} {:db/id "question-b031bd51-cdd6-576b-8767-0d0f9a3a9494" :question/id #uuid "b031bd51-cdd6-576b-8767-0d0f9a3a9494" :question/math-academy-id "q-107883" :question/problem "$\\frac{4}{\\sqrt{\\pi }}\\,Γ(\\frac{7}{2})+\\frac{1}{\\sqrt{\\pi }}\\,Γ(\\frac{3}{2})=$" :question/worked-solution "To evaluate the gamma function at multiples of one-half, we use the following recursive formula:\n\n$$\nΓ(z+1)=zΓ(z),\\,Γ(\\frac{1}{2})=\\sqrt{\\pi }\n$$\n\nSo, we have the following:\n\n$$\nΓ(\\frac{3}{2})=\\frac{1}{2}Γ(\\frac{1}{2})=\\frac{1}{2}\\sqrt{\\pi },\n$$\n\n$$\n\\begin{aligned}Γ(\\frac{7}{2}) & =\\frac{5}{2}\\,Γ(\\frac{5}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\,Γ(\\frac{3}{2}) \\\\  & =\\frac{5}{2}\\cdot \\frac{3}{2}\\cdot \\frac{1}{2}\\sqrt{\\pi } \\\\  & =\\frac{15}{8}\\sqrt{\\pi }\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{4}{\\sqrt{\\pi }}\\,Γ(\\frac{7}{2})+\\frac{1}{\\sqrt{\\pi }}\\,Γ(\\frac{3}{2})=\\frac{4}{\\sqrt{\\pi }}\\cdot \\frac{15}{8}\\sqrt{\\pi }+\\frac{1}{\\sqrt{\\pi }}\\cdot \\frac{1}{2}\\sqrt{\\pi }=8.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-26b21c09-8fe6-5a0f-b6ac-aa6ac324ee5e"] :db/ensure [:question/validate]} {:db/id "answer-field-26b21c09-8fe6-5a0f-b6ac-aa6ac324ee5e" :answer-field/id #uuid "26b21c09-8fe6-5a0f-b6ac-aa6ac324ee5e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f7779c3f-37b2-5f1d-848b-d22bcbee42f5" :answer-field/choices ["answer-64f70bec-dfba-5908-ae62-b36e526bc693" "answer-bd9d8a80-77df-59fa-9951-2e78efff78f5" "answer-f7779c3f-37b2-5f1d-848b-d22bcbee42f5" "answer-050d72d8-9732-5d66-9749-bb6219b382a4" "answer-a4da2019-88c0-57c4-bb97-d5aa6d31b1a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-64f70bec-dfba-5908-ae62-b36e526bc693" :answer/id #uuid "64f70bec-dfba-5908-ae62-b36e526bc693" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-bd9d8a80-77df-59fa-9951-2e78efff78f5" :answer/id #uuid