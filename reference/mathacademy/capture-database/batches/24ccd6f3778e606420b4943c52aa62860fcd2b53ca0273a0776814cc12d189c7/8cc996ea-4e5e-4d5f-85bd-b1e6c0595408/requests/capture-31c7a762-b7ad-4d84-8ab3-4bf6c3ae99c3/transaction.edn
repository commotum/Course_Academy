c{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-10a5afe0-91c7-5712-a1fb-be7570c7856c" :answer/id #uuid "10a5afe0-91c7-5712-a1fb-be7570c7856c" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "question-0886f3b4-52e4-5836-9f98-a91d21c13a2a" :question/id #uuid "0886f3b4-52e4-5836-9f98-a91d21c13a2a" :question/math-academy-id "q-130711" :question/problem "Given that $X$ is a random variable such that $X∼U[-7,-4],$ find $\\text{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-7$ and $b=-4.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(-4-(-7))^{2}}{12}=\\frac{9}{12}=\\frac{3}{4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c2e2eb3-0de3-5f9e-811b-8042ec62bff4"] :db/ensure [:question/validate]} {:db/id "answer-field-6c2e2eb3-0de3-5f9e-811b-8042ec62bff4" :answer-field/id #uuid "6c2e2eb3-0de3-5f9e-811b-8042ec62bff4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a0d64e87-652c-5265-8c5b-bb601e7c5e9f" :answer-field/choices ["answer-40fa14de-0f8a-5172-9988-43d81ccc98ff" "answer-fa4b8f36-b623-55b4-afd6-a65430a01e4f" "answer-dc65757e-1623-586d-b7bf-62f6a26b3f8c" "answer-c9addca8-7a59-573c-a089-51324e839a3a" "answer-a0d64e87-652c-5265-8c5b-bb601e7c5e9f"] :db/ensure [:answer-field/validate]} {:db/id "answer-40fa14de-0f8a-5172-9988-43d81ccc98ff" :answer/id #uuid "40fa14de-0f8a-5172-9988-43d81ccc98ff" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-fa4b8f36-b623-55b4-afd6-a65430a01e4f" :answer/id #uuid "fa4b8f36-b623-55b4-afd6-a65430a01e4f" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-dc65757e-1623-586d-b7bf-62f6a26b3f8c" :answer/id #uuid "dc65757e-1623-586d-b7bf-62f6a26b3f8c" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c9addca8-7a59-573c-a089-51324e839a3a" :answer/id #uuid "c9addca8-7a59-573c-a089-51324e839a3a" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-a0d64e87-652c-5265-8c5b-bb601e7c5e9f" :answer/id #uuid "a0d64e87-652c-5265-8c5b-bb601e7c5e9f" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "question-902c64d6-e7e5-5954-9fec-c7166d10d6e1" :question/id #uuid "902c64d6-e7e5-5954-9fec-c7166d10d6e1" :question/math-academy-id "q-130716" :question/problem "Given that $X$ is a random variable such that $X∼U[0,2],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=0$ and $b=2.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(2-0)^{2}}{12}=\\frac{1}{3}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{1}{3}}=\\frac{\\sqrt{3}}{3}≈0.577.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e4723e60-a2e2-55fc-a614-a323337fef65"] :db/ensure [:question/validate]} {:db/id "answer-field-e4723e60-a2e2-55fc-a614-a323337fef65" :answer-field/id #uuid "e4723e60-a2e2-55fc-a614-a323337fef65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5f4d3d63-9972-5a51-bf8b-a07e5b70728a" :answer-field/choices ["answer-d0626c63-9da0-55ae-87f6-53fc1c8029fc" "answer-5f4d3d63-9972-5a51-bf8b-a07e5b70728a" "answer-454c3648-da63-5ea7-8b1d-c10472cfae1b" "answer-3c1dc3d6-01a0-5e7e-8cdc-95f131783c9d" "answer-db89f985-b612-57bf-9517-1497d1afcfb4"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0626c63-9da0-55ae-87f6-53fc1c8029fc" :answer/id #uuid "d0626c63-9da0-55ae-87f6-53fc1c8029fc" :answer/type :answer.type/math :answer/value "0.289" :db/ensure [:answer/validate]} {:db/id "answer-5f4d3d63-9972-5a51-bf8b-a07e5b70728a" :answer/id #uuid "5f4d3d63-9972-5a51-bf8b-a07e5b70728a" :answer/type :answer.type/math :answer/value "0.577" :db/ensure [:answer/validate]} {:db/id "answer-454c3648-da63-5ea7-8b1d-c10472cfae1b" :answer/id #uuid "454c3648-da63-5ea7-8b1d-c10472cfae1b" :answer/type :answer.type/math :answer/value "0.714" :db/ensure [:answer/validate]} {:db/id "answer-3c1dc3d6-01a0-5e7e-8cdc-95f131783c9d" :answer/id #uuid "3c1dc3d6-01a0-5e7e-8cdc-95f131783c9d" :answer/type :answer.type/math :answer/value "1.128" :db/ensure [:answer/validate]} {:db/id "answer-db89f985-b612-57bf-9517-1497d1afcfb4" :answer/id #uuid "db89f985-b612-57bf-9517-1497d1afcfb4" :answer/type :answer.type/math :answer/value "1.443" :db/ensure [:answer/validate]} {:db/id "question-54e63900-c156-508b-82d2-231404053657" :question/id #uuid "54e63900-c156-508b-82d2-231404053657" :question/math-academy-id "q-130726" :question/problem "Given that $X$ is a random variable such that $X∼U[-10,5],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-10$ and $b=5.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(5-(-10))^{2}}{12}=\\frac{225}{12}=\\frac{75}{4}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{75}{4}}=\\frac{5\\sqrt{3}}{2}≈4.330.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ad120d86-b9b1-586a-a131-2aff030ba3c4"] :db/ensure [:question/validate]} {:db/id "answer-field-ad120d86-b9b1-586a-a131-2aff030ba3c4" :answer-field/id #uuid "ad120d86-b9b1-586a-a131-2aff030ba3c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1075691a-f199-58c0-92cc-267e0384d912" :answer-field/choices ["answer-a38d747f-8549-5520-968d-5b1ecc48e36b" "answer-099eec1e-8ed2-5113-a1c7-b3171fd7cc20" "answer-0c53a141-0b65-5522-b2db-8e41ad1971d2" "answer-1075691a-f199-58c0-92cc-267e0384d912" "answer-b8bff4e0-34bf-583b-859b-3da016dddf10"] :db/ensure [:answer-field/validate]} {:db/id "answer-a38d747f-8549-5520-968d-5b1ecc48e36b" :answer/id #uuid "a38d747f-8549-5520-968d-5b1ecc48e36b" :answer/type :answer.type/math :answer/value "2.887" :db/ensure [:answer/validate]} {:db/id "answer-099eec1e-8ed2-5113-a1c7-b3171fd7cc20" :answer/id #uuid "099eec1e-8ed2-5113-a1c7-b3171fd7cc20" :answer/type :answer.type/math :answer/value "3.753" :db/ensure [:answer/validate]} {:db/id "answer-0c53a141-0b65-5522-b2db-8e41ad1971d2" :answer/id #uuid "0c53a141-0b65-5522-b2db-8e41ad1971d2" :answer/type :answer.type/math :answer/value "4.041" :db/ensure [:answer/validate]} {:db/id "answer-1075691a-f199-58c0-92cc-267e0384d912" :answer/id #uuid "1075691a-f199-58c0-92cc-267e0384d912" :answer/type :answer.type/math :answer/value "4.330" :db/ensure [:answer/validate]} {:db/id "answer-b8bff4e0-34bf-583b-859b-3da016dddf10" :answer/id #uuid "b8bff4e0-34bf-583b-859b-3da016dddf10" :answer/type :answer.type/math :answer/value "4.907" :db/ensure [:answer/validate]} {:db/id 17592186167324 :question/problem "Given that $X$ is a random variable such that $X∼U[-5,4],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-5$ and $b=4.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(4-(-5))^{2}}{12}=\\frac{81}{12}=\\frac{27}{4}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{27}{4}}=\\frac{3\\sqrt{3}}{2}≈2.598.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165153 :answer-field/correct 17592186165156 :db/ensure [:answer-field/validate]} {:db/id "question-d1619c3f-d3f5-5de9-b2f1-3d2eb5956079" :question/id #uuid "d1619c3f-d3f5-5de9-b2f1-3d2eb5956079" :question/math-academy-id "q-96559" :question/problem "Given that $X$ is a random variable such that $X∼U[-7,3],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-7$ and $b=3.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(3-(-7))^{2}}{12}=\\frac{100}{12}=\\frac{25}{3}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{25}{3}}=\\frac{5\\sqrt{3}}{3}≈2.887.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3e5b1be4-b223-5353-b1fb-c40e1ba25b64"] :db/ensure [:question/validate]} {:db/id "answer-field-3e5b1be4-b223-5353-b1fb-c40e1ba25b64" :answer-field/id #uuid "3e5b1be4-b223-5353-b1fb-c40e1ba25b64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29463e7b-c8c0-51d7-93d6-7774a9c54d55" :answer-field/choices ["answer-aa5f63f6-ba7b-5514-aaf1-1936a49abd0d" "answer-2ea0ee42-9ae3-51d3-a1f6-a75e3d8f47f4" "answer-90492895-f69d-5f5c-a7e5-e943a4b6a388" "answer-29463e7b-c8c0-51d7-93d6-7774a9c54d55" "answer-2990c4d8-929c-564c-b712-68cdba4a013c"] :db/ensure [:answer-field/validate]} {:db/id "answer-aa5f63f6-ba7b-5514-aaf1-1936a49abd0d" :answer/id #uuid "aa5f63f6-ba7b-5514-aaf1-1936a49abd0d" :answer/type :answer.type/math :answer/value "1.087" :db/ensure [:answer/validate]} {:db/id "answer-2ea0ee42-9ae3-51d3-a1f6-a75e3d8f47f4" :answer/id #uuid "2ea0ee42-9ae3-51d3-a1f6-a75e3d8f47f4" :answer/type :answer.type/math :answer/value "1.787" :db/ensure [:answer/validate]} {:db/id "answer-90492895-f69d-5f5c-a7e5-e943a4b6a388" :answer/id #uuid "90492895-f69d-5f5c-a7e5-e943a4b6a388" :answer/type :answer.type/math :answer/value "2.807" :db/ensure [:answer/validate]} {:db/id "answer-29463e7b-c8c0-51d7-93d6-7774a9c54d55" :answer/id #uuid "29463e7b-c8c0-51d7-93d6-7774a9c54d55" :answer/type :answer.type/math :answer/value "2.887" :db/ensure [:answer/validate]} {:db/id "answer-2990c4d8-929c-564c-b712-68cdba4a013c" :answer/id #uuid "2990c4d8-929c-564c-b712-68cdba4a013c" :answer/type :answer.type/math :answer/value "2.888" :db/ensure [:answer/validate]} {:db/id "question-6e72c01b-4831-5832-84ce-7e36b797f77a" :question/id #uuid "6e72c01b-4831-5832-84ce-7e36b797f77a" :question/math-academy-id "q-130725" :question/problem "Given that $X$ is a random variable such that $X∼U[-2,10],$ find $\\text{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-2$ and $b=10.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(10-(-2))^{2}}{12}=\\frac{144}{12}=12.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{12}=2\\sqrt{3}≈3.464.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8c2866f6-4249-5037-8e66-4f0903c1de0f"] :db/ensure [:question/validate]} {:db/id "answer-field-8c2866f6-4249-5037-8e66-4f0903c1de0f" :answer-field/id #uuid "8c2866f6-4249-5037-8e66-4f0903c1de0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e1da86a-acf0-5bb3-a54c-f4594c8ca9a0" :answer-field/choices ["answer-7e01737b-1f7f-5999-938f-4812fade8196" "answer-2e1da86a-acf0-5bb3-a54c-f4594c8ca9a0" "answer-b7d5bc7c-8b5f-5c52-80eb-7ebea3034ba9" "answer-cf52b9fa-0250-5b04-8492-5a8dc9699ff4" "answer-d0eb2794-a1da-5a80-8aa1-359a3dd791bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e01737b-1f7f-5999-938f-4812fade8196" :answer/id #uuid "7e01737b-1f7f-5999-938f-4812fade8196" :answer/type :answer.type/math :answer/value "2.887" :db/ensure [:answer/validate]} {:db/id "answer-2e1da86a-acf0-5bb3-a54c-f4594c8ca9a0" :answer/id #uuid "2e1da86a-acf0-5bb3-a54c-f4594c8ca9a0" :answer/type :answer.type/math :answer/value "3.464" :db/ensure [:answer/validate]} {:db/id "answer-b7d5bc7c-8b5f-5c52-80eb-7ebea3034ba9" :answer/id #uuid "b7d5bc7c-8b5f-5c52-80eb-7ebea3034ba9" :answer/type :answer.type/math :answer/value "3.753" :db/ensure [:answer/validate]} {:db/id "answer-cf52b9fa-0250-5b04-8492-5a8dc9699ff4" :answer/id #uuid "cf52b9fa-0250-5b04-8492-5a8dc9699ff4" :answer/type :answer.type/math :answer/value "4.041" :db/ensure [:answer/validate]} {:db/id "answer-d0eb2794-a1da-5a80-8aa1-359a3dd791bb" :answer/id #uuid "d0eb2794-a1da-5a80-8aa1-359a3dd791bb" :answer/type :answer.type/math :answer/value "4.907" :db/ensure [:answer/validate]} {:db/id 17592186168086 :tutorial/content "Recall that if the random variable $X$ is uniformly distributed over the interval $[a,b],$ then $X$ has the following probability density function:\n![](images/af/af2afd72c74a9d7ca810886490baf28610cb743cbe8c8595158cfc2af702b7fa.svg)\n\nIt can be shown that the expected value and variance of $X$ are as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{a+b}{2} \\\\ \\text{Var}[X] & =\\frac{(b-a)^{2}}{12}\\end{aligned}\n$$\n\nThe result for $\\textrm{E}[X]$ is intuitive as it's simply the midpoint of the interval $[a,b].$ \n\nWe will derive both of these results at the end of the lesson." :db/ensure [:tutorial/validate]} {:db/id 17592186168111 :tutorial/content "If $X\\sim U[a,b],$ then $X$ has the following probability density function:\n![](images/be/be9457e598579e35be37d8fcc86663f4229e6193f02b11c49242d63858406a3b.svg)\n\nWe can compute the formula for $\\textrm E[X]$ using the usual definition:\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{a}^{b}xf(x)\\,\\text{d}x \\\\  & ={\\int }_{a}^{b}\\frac{x}{b-a}\\,\\text{d}x \\\\  & =\\frac{1}{b-a}{\\int }_{a}^{b}x\\,\\text{d}x \\\\  & =\\frac{1}{b-a}\\cdot {\\frac{1}{2}{x}^{2}|}_{a}^{b} \\\\  & =\\frac{1}{2(b-a)}\\cdot ({b}^{2}-{a}^{2}) \\\\  & =\\frac{1}{2(b-a)}\\cdot (b-a)(b+a) \\\\  & =\\frac{1}{2\\cancel{(b-a)}}\\cdot \\cancel{(b-a)}(b+a) \\\\  & =\\frac{a+b}{2}\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186168112 :tutorial/content "If $X\\sim U[a,b],$ then $X$ has the following probability density function:\n![](images/57/579372cf7b7880117ff6e7b4e1f063b29e42f886b06e2277e2dcb1f1240ff11d.svg)\n\nTo compute $\\textrm{Var}[X],$ we use the relation\n\n$$\n\\textrm{Var}[X] = \\textrm{E}[X^2] - (\\textrm{E}[X])^2.\n$$\n\nFirst, we compute $\\textrm E[X^2]$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{a}^{b}{x}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{a}^{b}\\frac{{x}^{2}}{b-a}\\,\\text{d}x \\\\  & =\\frac{1}{b-a}{\\int }_{a}^{b}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{1}{b-a}\\cdot {\\frac{1}{3}{x}^{3}|}_{a}^{b} \\\\  & =\\frac{1}{3(b-a)}\\cdot ({b}^{3}-{a}^{3}) \\\\  & =\\frac{1}{3(b-a)}\\cdot (b-a)({b}^{2}+ab+{a}^{2}) \\\\  & =\\frac{1}{3\\cancel{(b-a)}}\\cdot \\cancel{(b-a)}({b}^{2}+ab+{a}^{2}) \\\\  & =\\frac{1}{3}({b}^{2}+ab+{a}^{2})\\end{aligned}\n$$\n\nNow, since $\\textrm E[X] = \\dfrac12(b+a),$ we have\n\n$$\n(\\textrm E[X])^2 = \\dfrac14(b^2+2ab+a^2).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-(\\text{E}[X])^{2} \\\\  & =\\frac{1}{3}({b}^{2}+ab+{a}^{2})-\\frac{1}{4}({b}^{2}+2ab+{a}^{2}) \\\\  & =\\frac{4}{12}({b}^{2}+ab+{a}^{2})-\\frac{3}{12}({b}^{2}+2ab+{a}^{2}) \\\\  & =\\frac{1}{12}(4{b}^{2}+4ab+4{a}^{2})-\\frac{1}{12}(3{b}^{2}+6ab+3{a}^{2}) \\\\  & =\\frac{1}{12}({b}^{2}-2ab+{a}^{2}) \\\\  & =\\frac{1}{12}(b-a)^{2}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186167040 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
