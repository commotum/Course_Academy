f-0e8e-59a7-8217-baaa83d63cda" :step/id #uuid "e12ea09f-0e8e-59a7-8217-baaa83d63cda" :step/content 17592186402284 :step/next "step-b254bd23-4ba4-5a8e-8cca-2c56ed85728f" :db/ensure [:step/validate]} {:db/id "step-b254bd23-4ba4-5a8e-8cca-2c56ed85728f" :step/id #uuid "b254bd23-4ba4-5a8e-8cca-2c56ed85728f" :step/content "question-b0fd3313-c314-58d3-a500-207bbe04cd58" :db/ensure [:step/validate]} {:db/id 17592186184219 :knowledge-point/questions ["question-e3fc6c03-9e92-5752-b628-3af41a4a428b" "question-b1b6e064-faca-5061-955a-61c19c8be97d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184171 :knowledge-point/questions ["question-900f650b-6d73-5995-901b-d7a17074a6aa" "question-64b1d8f8-0962-5304-966e-2b0899590d0f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184172 :knowledge-point/questions ["question-c579df31-38e7-5faa-a719-e9a3badf209e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e3fc6c03-9e92-5752-b628-3af41a4a428b" :question/id #uuid "e3fc6c03-9e92-5752-b628-3af41a4a428b" :question/math-academy-id "q-139981" :question/problem "Consider a $9\\times 6$ matrix $A.$ If $\\text{rank}(A)=4$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-4 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b0ade6f1-cb8a-5617-b68c-23062a0a94c1"] :db/ensure [:question/validate]} {:db/id "answer-field-b0ade6f1-cb8a-5617-b68c-23062a0a94c1" :answer-field/id #uuid "b0ade6f1-cb8a-5617-b68c-23062a0a94c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3fe8edc-cf8c-59b3-845a-0f711614663c" :answer-field/choices ["answer-b3fe8edc-cf8c-59b3-845a-0f711614663c" "answer-e0746fb2-e7e9-54d9-93d0-235af2e3310d" "answer-e37b3463-8c25-56aa-885e-ca8b85bf4b8a" "answer-87510f02-5814-56e6-9a0a-3bbbf7e6baba" "answer-515cb0ad-3bf4-5d0b-b7db-ba6abbf4f45e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3fe8edc-cf8c-59b3-845a-0f711614663c" :answer/id #uuid "b3fe8edc-cf8c-59b3-845a-0f711614663c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-e0746fb2-e7e9-54d9-93d0-235af2e3310d" :answer/id #uuid "e0746fb2-e7e9-54d9-93d0-235af2e3310d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-e37b3463-8c25-56aa-885e-ca8b85bf4b8a" :answer/id #uuid "e37b3463-8c25-56aa-885e-ca8b85bf4b8a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-87510f02-5814-56e6-9a0a-3bbbf7e6baba" :answer/id #uuid "87510f02-5814-56e6-9a0a-3bbbf7e6baba" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-515cb0ad-3bf4-5d0b-b7db-ba6abbf4f45e" :answer/id #uuid "515cb0ad-3bf4-5d0b-b7db-ba6abbf4f45e" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-b1b6e064-faca-5061-955a-61c19c8be97d" :question/id #uuid "b1b6e064-faca-5061-955a-61c19c8be97d" :question/math-academy-id "q-142481" :question/problem "Consider a $4\\times 4$ matrix $A.$ If $\\text{rank}(A)=3$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-70719b4e-2718-5ba2-8435-476dae5ff60e"] :db/ensure [:question/validate]} {:db/id "answer-field-70719b4e-2718-5ba2-8435-476dae5ff60e" :answer-field/id #uuid "70719b4e-2718-5ba2-8435-476dae5ff60e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-19d7b093-ccfa-5074-9a83-a27b17ba1454" :answer-field/choices ["answer-9b640a26-d27a-5063-8ab1-f9eddbf076e8" "answer-19d7b093-ccfa-5074-9a83-a27b17ba1454" "answer-0489d7c0-9892-5b4f-a265-35a855cae665" "answer-f26141c5-5ae9-5b4b-80af-055e70b6a825" "answer-40c69629-2803-5ad7-aa97-c2b10a5bb2b3"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b640a26-d27a-5063-8ab1-f9eddbf076e8" :answer/id #uuid "9b640a26-d27a-5063-8ab1-f9eddbf076e8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-19d7b093-ccfa-5074-9a83-a27b17ba1454" :answer/id #uuid "19d7b093-ccfa-5074-9a83-a27b17ba1454" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-0489d7c0-9892-5b4f-a265-35a855cae665" :answer/id #uuid "0489d7c0-9892-5b4f-a265-35a855cae665" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f26141c5-5ae9-5b4b-80af-055e70b6a825" :answer/id #uuid "f26141c5-5ae9-5b4b-80af-055e70b6a825" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-40c69629-2803-5ad7-aa97-c2b10a5bb2b3" :answer/id #uuid "40c69629-2803-5ad7-aa97-c2b10a5bb2b3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-900f650b-6d73-5995-901b-d7a17074a6aa" :question/id #uuid "900f650b-6d73-5995-901b-d7a17074a6aa" :question/math-academy-id "q-141232" :question/problem "Let $A$ be a $6\\times 10$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3},{b}_{4}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=10,$ and since $B$ is formed by $4$ vectors, $\\text{rank}(A)=4.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =10 \\\\ \\text{nullity}(A) & =10-4 \\\\ \\text{dim(Null}(A)) & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30e4bc43-9fa2-56e5-9887-5f6820f6d33f"] :db/ensure [:question/validate]} {:db/id "answer-field-30e4bc43-9fa2-56e5-9887-5f6820f6d33f" :answer-field/id #uuid "30e4bc43-9fa2-56e5-9887-5f6820f6d33f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8b68a9a3-d2ff-5fe6-a44b-0661eda03baf" :answer-field/choices ["answer-5e0e3711-6463-5725-af73-097d1ae29a9b" "answer-d3e1f722-dade-587d-89a7-857b88b1ecf7" "answer-8522d96b-7f5f-51ec-a409-3570be436a9e" "answer-61446332-0629-5ef8-8fdd-ddaab16f7297" "answer-8b68a9a3-d2ff-5fe6-a44b-0661eda03baf"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e0e3711-6463-5725-af73-097d1ae29a9b" :answer/id #uuid "5e0e3711-6463-5725-af73-097d1ae29a9b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-d3e1f722-dade-587d-89a7-857b88b1ecf7" :answer/id #uuid "d3e1f722-dade-587d-89a7-857b88b1ecf7" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-8522d96b-7f5f-51ec-a409-3570be436a9e" :answer/id #uuid "8522d96b-7f5f-51ec-a409-3570be436a9e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-61446332-0629-5ef8-8fdd-ddaab16f7297" :answer/id #uuid "61446332-0629-5ef8-8fdd-ddaab16f7297" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-8b68a9a3-d2ff-5fe6-a44b-0661eda03baf" :answer/id #uuid "8b68a9a3-d2ff-5fe6-a44b-0661eda03baf" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186388862 :question/problem "Let $A$ be a $4\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :db/ensure [:question/validate]} {:db/id "question-64b1d8f8-0962-5304-966e-2b0899590d0f" :question/id #uuid "64b1d8f8-0962-5304-966e-2b0899590d0f" :question/math-academy-id "q-139982" :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ -{x}_{2} \\\\ {x}_{2}+{x}_{3} \\\\ {x}_{2}\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ -1 \\\\ 1 \\\\ 1\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=3.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =4 \\\\ \\text{rank}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ab7f2cb8-335b-5f4a-9cc8-0908a43a3d7c"] :db/ensure [:question/validate]} {:db/id "answer-field-ab7f2cb8-335b-5f4a-9cc8-0908a43a3d7c" :answer-field/id #uuid "ab7f2cb8-335b-5f4a-9cc8-0908a43a3d7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4ebf46d3-5341-5dd3-aceb-6ddffa810768" :answer-field/choices ["answer-c4b46094-adbe-5613-99fb-1d44ee476d04" "answer-4ebf46d3-5341-5dd3-aceb-6ddffa810768" "answer-ea933042-3f02-5de2-bb89-d29c596a91bf" "answer-6aad5572-7448-5e77-a728-919195780102" "answer-9171c738-0ec4-5a88-b47b-0045bdab10e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4b46094-adbe-5613-99fb-1d44ee476d04" :answer/id #uuid "c4b46094-adbe-5613-99fb-1d44ee476d04" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4ebf46d3-5341-5dd3-aceb-6ddffa810768" :answer/id #uuid "4ebf46d3-5341-5dd3-aceb-6ddffa810768" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ea933042-3f02-5de2-bb89-d29c596a91bf" :answer/id #uuid "ea933042-3f02-5de2-bb89-d29c596a91bf" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-6aad5572-7448-5e77-a728-919195780102" :answer/id #uuid "6aad5572-7448-5e77-a728-919195780102" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-9171c738-0ec4-5a88-b47b-0045bdab10e3" :answer/id #uuid "9171c738-0ec4-5a88-b47b-0045bdab10e3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186184757 :question/problem "Which of the following statements are true given that $A$ is a $4\\times 4$ matrix with $3$ pivot columns?\n\nI. $\\text{rank}(A)=3$\n\nII. $A$ is invertible\n\nIII. $\\text{nullity}(A)=1$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since $A$ has $3$ pivot columns, we have $\\text{rank}(A)=3.$\n\n- Statement II is false. For the matrix $A,$ the number of the columns is $n=4.$ Now, since $\\text{rank}(A)\\ne 4,$ then by the invertible matrix theorem, we have that $A$ is not invertible.\n\n- Statement III is true. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =4 \\\\ \\text{nullity}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186183151 :answer-field/correct 17592186183153 :db/ensure [:answer-field/validate]} {:db/id "question-c579df31-38e7-5faa-a719-e9a3badf209e" :question/id #uuid "c579df31-38e7-5faa-a719-e9a3badf209e" :question/math-academy-id "q-35435" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and $\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 2{x}_{1} \\\\ -3{x}_{1} \\\\ -4{x}_{1}\\end{aligned}]\\,|\\,{x}_{1}\\in R\\}?$ \n\nI. $\\text{rank}(A)=3$\n\nII. $\\text{Col}(A)={R}^{4}$\n\nIII. $A$ is not invertible" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 2{x}_{1} \\\\ -3{x}_{1} \\\\ -4{x}_{1}\\end{aligned}]\\,|\\,{x}_{1}\\in R\\}=\\text{Span}\\{\\,[\\begin{aligned}1 \\\\ 2 \\\\ -3 \\\\ -4\\end{aligned}]\\}\n$$\n\n \nwe have that $\\text{nullity}(A)=1.$\n\nNow,  for the matrix $A,$ the number of columns is $n=4,$ so according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is false. Since $\\text{rank}(A)=3\\ne 4,$ then, by the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{4}.$\n\n- Statement III is true. Indeed, since $\\text{rank}(A)=3\\ne 4$, according to the  invertible matrix theorem $A$ can't be an invertible matrix.\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cf7368f2-5a45-59f1-9769-661d58ae07d3"] :db/ensure [:question/validate]} {:db/id "answer-field-cf7368f2-5a45-59f1-9769-661d58ae07d3" :answer-field/id #uuid "cf7368f2-5a45-59f1-9769-661d58ae07d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-09f279b3-ea5e-5d31-9dcd-0a3e8e1b3a8b" :answer-field/choices ["answer-daf23a31-b6e9-551f-8960-6733a9da0c3b" "answer-09f279b3-ea5e-5d31-9dcd-0a3e8e1b3a8b" "answer-2c39de95-065d-5909-a31e-8aec18fcaa30" "answer-5c15ec5b-b014-5f4f-aedd-7a3ee80c6e43" "answer-c65ee4e2-e412-5286-95cc-2961eb9dd28d"] :db/ensure [:answer-field/validate]} {:db/id "answer-daf23a31-b6e9-551f-8960-6733a9da0c3b" :answer/id #uuid "daf23a31-b6e9-551f-8960-6733a9da0c3b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-09f279b3-ea5e-5d31-9dcd-0a3e8e1b3a8b" :answer/id #uuid "09f279b3-ea5e-5d31-9dcd-0a3e8e1b3a8b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-2c39de95-065d-5909-a31e-8aec18fcaa30" :answer/id #uuid "2c39de95-065d-5909-a31e-8aec18fcaa30" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-5c15ec5b-b014-5f4f-aedd-7a3ee80c6e43" :answer/id #uuid "5c15ec5b-b014-5f4f-aedd-7a3ee80c6e43" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-c65ee4e2-e412-5286-95cc-2961eb9dd28d" :answer/id #uuid "c65ee4e2-e412-5286-95cc-2961eb9dd28d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186087828 :knowledge-point/questions ["question-5bb5e35b-a0ec-5519-8ca8-cd918f5d6df4" "question-f34b8912-4b56-5d41-974a-bbda413ccbb1" "question-fc9d445a-7899-5437-a552-e9338bc6c692"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087498 :question/problem "Solve the equation $\\, x^2-4x+5=0.$" :question/worked-solution "We can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx = \\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=1, b=-4,$ and $c=5.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-4)\\pm \\sqrt{(-4)^{2}-4(1)(5)}}{2(1)} \\\\  & =\\frac{4\\pm \\sqrt{16-20}}{2} \\\\  & =\\frac{4\\pm \\sqrt{-4}}{2} \\\\  & =\\frac{4\\pm 2\\,\\text{i}}{2} \\\\  & =2\\pm \\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=2+\\textrm{i}$ and $x=2-\\textrm{i}.$" :db/ensure [:question/validate]} {:db/id 17592186087632 :question/problem "Find the solutions of the equation $4x^2= 4x-13 .$" :question/worked-solution "First, we write the equation in standard form by bringing all of the terms to the left-hand side. This gives the equation\n\n$$\n4x^2 - 4x + 13=0.\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx = \\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}\n$$\n\nIn this case, the coefficients are  $a=4, b=-4,$ and $c=13.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-4)\\pm \\sqrt{(-4)^{2}-4(4)(13)}}{2(4)} \\\\  & =\\frac{4\\pm \\sqrt{16-208}}{8} \\\\  & =\\frac{4\\pm \\sqrt{-192}}{8} \\\\  & =\\frac{4\\pm 8\\sqrt{-3}}{8} \\\\  & =\\frac{4\\pm 8\\sqrt{3}\\,\\text{i}}{8} \\\\  & =\\frac{1}{2}\\pm \\sqrt{3}\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=\\dfrac{1}{2}+ \\sqrt{3} \\, \\textrm{i}$ and $x=\\dfrac{1}{2}- \\sqrt{3} \\, \\textrm{i}.$" :db/ensure [:question/validate]} {:db/id 17592186087830 :knowledge-point/questions ["question-fe69821d-b46b-58da-90bc-7fc6e8ec74de" "question-36266739-216f-533b-a7c0-f932ac7e366b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087499 :question/problem "The equation $x^2+8x+80=0$ can be written in the form $(x+p)^2=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x+80 & =0 \\\\ {x}^{2}+8x & =-80\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+8x & =-80 \\\\ {x}^{2}+2\\cdot 4x+{4}^{2}-{4}^{2} & =-80 \\\\ (x+4)^{2}-16 & =-80 \\\\ (x+4)^{2} & =-64\\end{aligned}\n$$\n\nTherefore, $p=4,$ $q=-64,$ and $p+q = -60.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+4)^{2} & =-64 \\\\ x+4 & =\\pm \\sqrt{-64} \\\\ x+4 & =\\pm 8\\,\\text{i} \\\\ x & =-4\\pm 8\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-4+8\\,\\textrm{i}$ and $x=-4-8\\,\\textrm{i}.$" :db/ensure [:question/validate]} {:db/id "question-5bb5e35b-a0ec-5519-8ca8-cd918f5d6df4" :question/id #uuid "5bb5e35b-a0ec-5519-8ca8-cd918f5d6df4" :question/math-academy-id "q-54641" :question/problem "Solve the equation $-{x}^{2}+2x=5.$" :question/worked-solution "First, we rearrange the equation to make the right-hand side equal to zero:\n\n$$\n-{x}^{2}+2x-5=0\n$$\n\nWe can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=-1,b=2,$ and $c=-5.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-2\\pm \\sqrt{{2}^{2}-4(-1)(-5)}}{2(-1)} \\\\  & =\\frac{-2\\pm \\sqrt{4-20}}{-2} \\\\  & =\\frac{-2\\pm \\sqrt{-16}}{-2} \\\\  & =\\frac{-2\\pm 4\\,\\text{i}}{-2} \\\\  & =1\\pm 2\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+2\\,\\text{i}$ and $x=1-2\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7aee3ac9-76aa-5429-a6bd-558c79881bd5"] :db/ensure [:question/validate]} {:db/id "answer-field-7aee3ac9-76aa-5429-a6bd-558c79881bd5" :answer-field/id #uuid "7aee3ac9-76aa-5429-a6bd-558c79881bd5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a7e83d3-fd36-54f6-8c7e-359e5342900d" :answer-field/choices ["answer-e8544b0b-372f-5c72-87c3-02d17f08022a" "answer-8a7e83d3-fd36-54f6-8c7e-359e5342900d" "answer-d913210a-0e0c-54c6-9454-1a19c74216c6" "answer-b13fd961-7770-597d-9894-1aaa35b12ccf" "answer-bb86bfcb-bc62-5616-a522-004bcf66c2a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8544b0b-372f-5c72-87c3-02d17f08022a" :answer/id #uuid "e8544b0b-372f-5c72-87c3-02d17f08022a" :answer/type :answer.type/math :answer/value "x=-1\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-8a7e83d3-fd36-54f6-8c7e-359e5342900d" :answer/id #uuid "8a7e83d3-fd36-54f6-8c7e-359e5342900d" :answer/type :answer.type/math :answer/value "x=1\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-d913210a-0e0c-54c6-9454-1a19c74216c6" :answer/id #uuid "d913210a-0e0c-54c6-9454-1a19c74216c6" :answer/type :answer.type/math :answer/value "x=1\\pm 4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-b13fd961-7770-597d-9894-1aaa35b12ccf" :answer/id #uuid "b13fd961-7770-597d-9894-1aaa35b12ccf" :answer/type :answer.type/math :answer/value "x=\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-bb86bfcb-bc62-5616-a522-004bcf66c2a4" :answer/id #uuid "bb86bfcb-bc62-5616-a522-004bcf66c2a4" :answer/type :answer.type/math :answer/value "x=\\pm 4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "question-f34b8912-4b56-5d41-974a-bbda413ccbb1" :question/id #uuid "f34b8912-4b56-5d41-974a-bbda413ccbb1" :question/math-academy-id "q-54642" :question/problem "Solve the equation $-2{x}^{2}+4x-8=0.$" :question/worked-solution "We can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=-2,b=4,$ and $c=-8.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-4\\pm \\sqrt{(4)^{2}-4(-2)(-8)}}{2(-2)} \\\\  & =\\frac{-4\\pm \\sqrt{16-64}}{-4} \\\\  & =\\frac{-4\\pm \\sqrt{-48}}{-4} \\\\  & =\\frac{-4\\pm 4\\sqrt{-3}}{-4} \\\\  & =\\frac{-4\\pm 4\\sqrt{3}\\,\\text{i}}{-4} \\\\  & =1\\pm \\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+\\sqrt{3}\\,\\text{i}$ and $x=1-\\sqrt{3}\\,\\text{i}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1f985998-b06f-5ab1-b71e-02977fd6c7e1"] :db/ensure [:question/validate]} {:db/id "answer-field-1f985998-b06f-5ab1-b71e-02977fd6c7e1" :answer-field/id #uuid "1f985998-b06f-5ab1-b71e-02977fd6c7e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-496972a5-0381-57a0-944b-a695d886f0bb" :answer-field/choices ["answer-0f7a1cb3-fb66-5b84-aa5f-f8b993b9ee24" "answer-8fb70bb5-fdce-54d6-b98c-a532459a6a11" "answer-cf8ff6a6-1bd6-5c26-a137-c745cab890a9" "answer-496972a5-0381-57a0-944b-a695d886f0bb" "answer-59f8db65-0a6c-55f8-924a-17143dd00241"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f7a1cb3-fb66-5b84-aa5f-f8b993b9ee24" :answer/id #uuid "0f7a1cb3-fb66-5b84-aa5f-f8b993b9ee24" :answer/type :answer.type/math :answer/value "x=-1\\pm \\sqrt{2}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-8fb70bb5-fdce-54d6-b98c-a532459a6a11" :answer/id #uuid "8fb70bb5-fdce-54d6-b98c-a532459a6a11" :answer/type :answer.type/math :answer/value "x=-1\\pm \\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-cf8ff6a6-1bd6-5c26-a137-c745cab890a9" :answer/id #uuid "cf8ff6a6-1bd6-5c26-a137-c745cab890a9" :answer/type :answer.type/math :answer/value "x=1\\pm \\sqrt{2}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-496972a5-0381-57a0-944b-a695d886f0bb" :answer/id #uuid "496972a5-0381-57a0-944b-a695d886f0bb" :answer/type :answer.type/math :answer/value "x=1\\pm \\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-59f8db65-0a6c-55f8-924a-17143dd00241" :answer/id #uuid "59f8db65-0a6c-55f8-924a-17143dd00241" :answer/type :answer.type/math :answer/value "x=\\pm \\sqrt{3}\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "question-fc9d445a-7899-5437-a552-e9338bc6c692" :question/id #uuid "fc9d445a-7899-5437-a552-e9338bc6c692" :question/math-academy-id "q-66426" :question/problem "Solve  the equation $\\,-{x}^{2}-8x-41=0.$" :question/worked-solution "We can find the roots of a quadratic equation using the quadratic formula:\n\n$$\nx=\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a}\n$$\n\nIn this case, the coefficients are $a=-1,b=-8,$ and $c=-41.$ Substituting these values into the quadratic formula, we get\n\n$$\n\\begin{aligned}x & =\\frac{-(-8)\\pm \\sqrt{(-8)^{2}-4(-1)(-41)}}{2(-1)} \\\\  & =\\frac{8\\pm \\sqrt{64-164}}{-2} \\\\  & =\\frac{8\\pm \\sqrt{-100}}{-2} \\\\  & =\\frac{8\\pm 10\\,\\text{i}}{-2} \\\\  & =-4\\pm 5\\,\\text{i}.\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-4+5\\,\\text{i}$ and $x=-4-5\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1c483242-14ab-518f-a252-0e040b788c54"] :db/ensure [:question/validate]} {:db/id "answer-field-1c483242-14ab-518f-a252-0e040b788c54" :answer-field/id #uuid "1c483242-14ab-518f-a252-0e040b788c54" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e79f5b9-a947-5b53-a7b6-fd87e3a8c7b6" :answer-field/choices ["answer-f3ac98b0-f615-5f5c-91a6-dc79abe795a8" "answer-7e79f5b9-a947-5b53-a7b6-fd87e3a8c7b6" "answer-1b189539-dd25-545f-a331-7dbf880d4d1a" "answer-32b8521f-bc62-5cd2-a472-16a8d177d2fe" "answer-e5ce87d9-15e2-556f