f156-5581-bb3f-5909c3e3a681" "answer-74efa23a-d4f4-5131-99b2-7c1b585da360" "answer-f9994e31-f0b7-5d6f-8912-7380e35bb9c5" "answer-5b55e4a9-5374-5c37-bb1e-cee774d9b81e"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f612688-2f3d-57bb-9415-7a91d68a847c" :answer/id #uuid "2f612688-2f3d-57bb-9415-7a91d68a847c" :answer/type :answer.type/math :answer/value "p=-2" :db/ensure [:answer/validate]} {:db/id "answer-127d7eca-f156-5581-bb3f-5909c3e3a681" :answer/id #uuid "127d7eca-f156-5581-bb3f-5909c3e3a681" :answer/type :answer.type/math :answer/value "p=-9" :db/ensure [:answer/validate]} {:db/id "answer-74efa23a-d4f4-5131-99b2-7c1b585da360" :answer/id #uuid "74efa23a-d4f4-5131-99b2-7c1b585da360" :answer/type :answer.type/math :answer/value "p=1" :db/ensure [:answer/validate]} {:db/id "answer-f9994e31-f0b7-5d6f-8912-7380e35bb9c5" :answer/id #uuid "f9994e31-f0b7-5d6f-8912-7380e35bb9c5" :answer/type :answer.type/math :answer/value "p=3" :db/ensure [:answer/validate]} {:db/id "answer-5b55e4a9-5374-5c37-bb1e-cee774d9b81e" :answer/id #uuid "5b55e4a9-5374-5c37-bb1e-cee774d9b81e" :answer/type :answer.type/math :answer/value "p=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-d718b4fe-ac83-5ded-9cff-9bf61a11c436" :question/id #uuid "d718b4fe-ac83-5ded-9cff-9bf61a11c436" :question/math-academy-id "q-14238" :question/problem "Find $k$ if $2$ is a root of $f(x)={x}^{4}+k{x}^{3}-7{x}^{2}-57x+6k.$" :question/worked-solution "Since  $x=2$ is a root, we have $f(2)=0.$ Therefore, we can evaluate the polynomial at $x=2,$ set it equal to $0,$ and solve the equation for the parameter $k:$\n\n$$\n\\begin{aligned}(2)^{4}+k(2)^{3}-7(2)^{2}-57(2)+6k & =0 \\\\ 16+8k-28-114+6k & =0 \\\\ 14k-126 & =0 \\\\ 14k & =126 \\\\ k & =9\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-59e0a079-1230-556b-88e6-09520bd04216"] :db/ensure [:question/validate]} {:db/id "answer-field-59e0a079-1230-556b-88e6-09520bd04216" :answer-field/id #uuid "59e0a079-1230-556b-88e6-09520bd04216" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c30cf463-743f-5343-9b3b-e2b54d327e16" :answer-field/choices ["answer-8141248f-ae02-59d5-9985-216116e2a8e6" "answer-de6f2964-ee7a-5958-a213-8d1216e4287b" "answer-d4dbce40-8e28-5d99-a914-1fc7bae9ef3b" "answer-a5e33f54-5f9e-5175-b0c7-6035f1211b8f" "answer-c30cf463-743f-5343-9b3b-e2b54d327e16"] :db/ensure [:answer-field/validate]} {:db/id "answer-8141248f-ae02-59d5-9985-216116e2a8e6" :answer/id #uuid "8141248f-ae02-59d5-9985-216116e2a8e6" :answer/type :answer.type/math :answer/value "k=-3" :db/ensure [:answer/validate]} {:db/id "answer-de6f2964-ee7a-5958-a213-8d1216e4287b" :answer/id #uuid "de6f2964-ee7a-5958-a213-8d1216e4287b" :answer/type :answer.type/math :answer/value "k=-6" :db/ensure [:answer/validate]} {:db/id "answer-d4dbce40-8e28-5d99-a914-1fc7bae9ef3b" :answer/id #uuid "d4dbce40-8e28-5d99-a914-1fc7bae9ef3b" :answer/type :answer.type/math :answer/value "k=1" :db/ensure [:answer/validate]} {:db/id "answer-a5e33f54-5f9e-5175-b0c7-6035f1211b8f" :answer/id #uuid "a5e33f54-5f9e-5175-b0c7-6035f1211b8f" :answer/type :answer.type/math :answer/value "k=3" :db/ensure [:answer/validate]} {:db/id "answer-c30cf463-743f-5343-9b3b-e2b54d327e16" :answer/id #uuid "c30cf463-743f-5343-9b3b-e2b54d327e16" :answer/type :answer.type/math :answer/value "k=9" :db/ensure [:answer/validate]} {:db/id "activity-e7cdfaae-9f34-5e4f-854e-c1d607458903" :activity/id #uuid "e7cdfaae-9f34-5e4f-854e-c1d607458903" :activity/title "Determining the Roots of Polynomials" :activity/type :activity.type/review :activity/scope 17592186048369 :activity/course 17592186046647 :activity/steps ["step-23d9f834-3911-510e-bae1-ec6c30e48281" "step-df6a6199-b720-581e-9425-82f1d00b1651" "step-149763fa-fcc2-55ff-bbcd-e8ae22afe33e"] :activity/first-step "step-23d9f834-3911-510e-bae1-ec6c30e48281" :db/ensure [:activity/validate]} {:db/id "step-23d9f834-3911-510e-bae1-ec6c30e48281" :step/id #uuid "23d9f834-3911-510e-bae1-ec6c30e48281" :step/content "question-940f3759-8774-576e-891c-0f76989295c4" :step/next "step-df6a6199-b720-581e-9425-82f1d00b1651" :db/ensure [:step/validate]} {:db/id "step-df6a6199-b720-581e-9425-82f1d00b1651" :step/id #uuid "df6a6199-b720-581e-9425-82f1d00b1651" :step/content "question-d2b7c3bc-8988-5881-96d5-877a27dfd407" :step/next "step-149763fa-fcc2-55ff-bbcd-e8ae22afe33e" :db/ensure [:step/validate]} {:db/id "step-149763fa-fcc2-55ff-bbcd-e8ae22afe33e" :step/id #uuid "149763fa-fcc2-55ff-bbcd-e8ae22afe33e" :step/content "question-d718b4fe-ac83-5ded-9cff-9bf61a11c436" :db/ensure [:step/validate]} {:db/id 17592186198397 :knowledge-point/questions ["question-f849acac-b165-56ce-af0c-ee1d4893cc84" "question-8a7a1582-d778-5af4-af63-1b6090d14c6e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f849acac-b165-56ce-af0c-ee1d4893cc84" :question/id #uuid "f849acac-b165-56ce-af0c-ee1d4893cc84" :question/math-academy-id "q-39056" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le {x}^{2}-{y}^{2}\\le 2,\\,2\\le x+y\\le 4,\\,0\\le z\\le 1\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu={x}^{2}-{y}^{2},\\,v=x+y,\\,w=z,\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}(x+y)\\operatorname{sinh}⁡({x}^{2}-{y}^{2})\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$ \n\nNote that the change of variables\n\n$$\nu={x}^{2}-{y}^{2},\\,v=x+y,\\,w=z,\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps: \n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,2\\le v\\le 4,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & -2y & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}2x & -2y \\\\ 1 & 1\\end{aligned}| \\\\  & =2x+2y \\\\  & =2(x+y) \\\\  & =2v\\end{aligned}\n$$\n\n \n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2v}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$ \n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+y)\\operatorname{sinh}⁡({x}^{2}-{y}^{2})\\,dV & ={∭}_{Δ}v\\operatorname{sinh}⁡u\\cdot |\\frac{1}{2v}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{\\operatorname{sinh}⁡u}{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4072ebe9-e356-5a8b-bdd6-bdedd4bc5d7f"] :db/ensure [:question/validate]} {:db/id "answer-field-4072ebe9-e356-5a8b-bdd6-bdedd4bc5d7f" :answer-field/id #uuid "4072ebe9-e356-5a8b-bdd6-bdedd4bc5d7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-41084583-9221-587e-a746-0339cfa254c3" :answer-field/choices ["answer-41084583-9221-587e-a746-0339cfa254c3" "answer-208798f3-1213-54c2-9110-17dc3e4b81b8" "answer-8c6d471a-064f-5e70-bfd7-077a3c169ff3" "answer-167c9635-d107-553c-80f2-728998f64f44" "answer-f6cc9b29-5be4-54fe-8424-7c6e39a3e9a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-41084583-9221-587e-a746-0339cfa254c3" :answer/id #uuid "41084583-9221-587e-a746-0339cfa254c3" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{1}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-208798f3-1213-54c2-9110-17dc3e4b81b8" :answer/id #uuid "208798f3-1213-54c2-9110-17dc3e4b81b8" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{uv}2v\\operatorname{sinh}⁡u\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-8c6d471a-064f-5e70-bfd7-077a3c169ff3" :answer/id #uuid "8c6d471a-064f-5e70-bfd7-077a3c169ff3" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{uv}2v\\operatorname{sinh}⁡uv\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-167c9635-d107-553c-80f2-728998f64f44" :answer/id #uuid "167c9635-d107-553c-80f2-728998f64f44" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{v}\\frac{\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-f6cc9b29-5be4-54fe-8424-7c6e39a3e9a1" :answer/id #uuid "f6cc9b29-5be4-54fe-8424-7c6e39a3e9a1" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{2}^{4}{\\int }_{0}^{v}\\frac{u\\operatorname{sinh}⁡u}{2}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "question-8a7a1582-d778-5af4-af63-1b6090d14c6e" :question/id #uuid "8a7a1582-d778-5af4-af63-1b6090d14c6e" :question/math-academy-id "q-39062" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le x\\le 2,\\,\\frac{1}{x}\\le y\\le \\frac{2}{x},\\,\\frac{1}{xy}\\le z\\le \\frac{2}{xy}\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu=x,\\,v=xy,\\,w=xyz,\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}\\,{e}^{xyz}\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$ \n\nNote that the change of variables\n\n$$\nu=x,\\,v=xy,\\,w=xyz\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is \n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 2,\\,1\\le w\\le 2\\}.\\end{aligned}\n$$\n\n \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 & 0 \\\\ y & x & 0 \\\\ yz & xz & xy\\end{aligned}| \\\\  & =xy|\\begin{aligned}1 & 0 \\\\ y & x\\end{aligned}| \\\\  & =xy(x-0) \\\\  & ={x}^{2}y \\\\  & =uv\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{uv}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}{e}^{xyz}\\,dV & ={∭}_{Δ}{e}^{w}\\cdot |\\frac{1}{uv}|\\,\\,dw\\,dv\\,du \\\\  & ={∭}_{Δ}\\frac{{e}^{w}}{uv}\\,\\,dw\\,dv\\,du \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}\\frac{{e}^{w}}{uv}\\,dw\\,dv\\,du\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fd889248-045c-5336-9e14-01871b41eb76"] :db/ensure [:question/validate]} {:db/id "answer-field-fd889248-045c-5336-9e14-01871b41eb76" :answer-field/id #uuid "fd889248-045c-5336-9e14-01871b41eb76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-942264b3-d374-50be-87f0-6ee36149aa06" :answer-field/choices ["answer-942264b3-d374-50be-87f0-6ee36149aa06" "answer-b31ba118-b4ec-54ec-bb50-628c0cc67dda" "answer-1f1a2079-1fc1-5955-bbfb-db810024db1a" "answer-7e097b3d-1787-51eb-8d0e-f6ddc058f730" "answer-9096297c-682f-58dc-8315-adc51907dab4"] :db/ensure [:answer-field/validate]} {:db/id "answer-942264b3-d374-50be-87f0-6ee36149aa06" :answer/id #uuid "942264b3-d374-50be-87f0-6ee36149aa06" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}\\frac{{e}^{w}}{uv}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-b31ba118-b4ec-54ec-bb50-628c0cc67dda" :answer/id #uuid "b31ba118-b4ec-54ec-bb50-628c0cc67dda" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}uv{e}^{w}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-1f1a2079-1fc1-5955-bbfb-db810024db1a" :answer/id #uuid "1f1a2079-1fc1-5955-bbfb-db810024db1a" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{u}\\frac{{e}^{w}}{uv}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-7e097b3d-1787-51eb-8d0e-f6ddc058f730" :answer/id #uuid "7e097b3d-1787-51eb-8d0e-f6ddc058f730" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{u}{\\int }_{1}^{2}\\frac{{e}^{w}}{v}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-9096297c-682f-58dc-8315-adc51907dab4" :answer/id #uuid "9096297c-682f-58dc-8315-adc51907dab4" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{v}{\\int }_{1}^{2}\\frac{{e}^{w}}{v}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id 17592186198398 :knowledge-point/questions ["question-c40cfd48-e992-514e-93b1-f5d1aa09838d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c40cfd48-e992-514e-93b1-f5d1aa09838d" :question/id #uuid "c40cfd48-e992-514e-93b1-f5d1aa09838d" :question/math-academy-id "q-162128" :question/problem "Use the change of variables \n\n$$\nu=2x+y,\\,v=3x+2z,\\,w=z\n$$\n\nto evaluate the triple integral\n\n$$\n{∭}_{R}\\frac{12}{1+(3x+2z)^{2}}\\,dV,\n$$\n\nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,\\frac{1}{\\pi }\\le 2x+y\\le \\frac{2}{\\pi },\\,\\,0\\le 3x+2z\\le 1,\\,\\,0\\le z\\le 2\\}.\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=2x+y,\\,v=3x+2z,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,\\frac{1}{\\pi }\\le u\\le \\frac{2}{\\pi },\\,0\\le v\\le 1,\\,0\\le w\\le 2\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 1 & 0 \\\\ 3 & 0 & 2 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}2 & 1 \\\\ 3 & 0\\end{aligned}| \\\\  & =0-3 \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}\\frac{12}{1+(3x+2z)^{2}}\\,dV & ={∭}_{Δ}\\frac{12}{1+{v}^{2}}\\cdot |-\\frac{1}{3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{4}{(1+{v}^{2})}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1/\\pi }^{2/\\pi }{\\int }_{0}^{1}{\\int }_{0}^{2}\\frac{4}{(1+{v}^{2})}\\,dw\\,dv\\,du \\\\  & ={\\int }_{1/\\pi }^{2/\\pi }\\,du\\cdot {\\int }_{0}^{1}\\frac{4}{(1+{v}^{2})}\\,dv\\cdot {\\int }_{0}^{2}dw \\\\  & =[u]_{1/\\pi }^{2/\\pi }\\cdot {[4\\operatorname{arctan}⁡v]}_{v=0}^{v=1}\\cdot [w]_{w=0}^{w=2} \\\\  & =(\\frac{2}{\\pi }-\\frac{1}{\\pi })\\cdot (4\\cdot \\frac{\\pi }{4}-0)\\cdot (2-0) \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e00110c2-7288-57e8-9508-75b52e302e96"] :db/ensure [:question/validate]} {:db/id "answer-field-e00110c2-7288-57e8-9508-75b52e302e96" :answer-field/id #uuid "e00110c2-7288-57e8-9508-75b52e302e96" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" :answer-field/choices ["answer-4cfefb36-0c70-50b6-aa6a-4945530149e3" "answer-97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" "answer-c921974f-fc45-5558-acc3-f2310130ec21" "answer-3dbc4c08-f008-5e72-b85a-8f2b4179ee34" "answer-ec8b09ec-156b-5830-8ce7-eac0fbd892c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-4cfefb36-0c70-50b6-aa6a-4945530149e3" :answer/id #uuid "4cfefb36-0c70-50b6-aa6a-4945530149e3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" :answer/id #uuid "97e3dd6a-5cc0-5fa9-95f1-4e769dfdd8a2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c921974f-fc45-5558-acc3-f2310130ec21" :answer/id #uuid "c921974f-fc45-5558-acc3-f2310130ec21" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-3dbc4c08-f008-5e72-b85a-8f2b4179ee34" :answer/id #uuid "3dbc4c08-f008-5e72-b85a-8f2b4179ee34" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-ec8b09ec-156b-5830-8ce7-eac0fbd892c6" :answer/id #uuid "ec8b09ec-156b-5830-8ce7-eac0fbd892c6" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "activity-79fca1d8-1475-5d69-8c31-46253855b8a4" :activity/id #uuid "79fca1d8-1475-5d69-8c31-46253855b8a4" :activity/title "Computing Triple Integrals Using a Change of Variables" :activity/type :activity.type/review :activity/scope 17592186049639 :activity/course 17592186046644 :activity/steps ["step-5e5891c8-8277-54c3-9c11-9481ab910bf8" "step-a536b006-715c-59a4-84d0-400b886bdd56" "step-9415b5d7-f308-5c17-9e90-f8ba5c185823" "step-1da0db94-3628-5190-a1fe-f76eb1f4550b" "step-efac3413-9dbb-5cde-aece-e1eded4d33e5"] :activity/first-step "step-5e5891c8-8277-54c3-9c11-9481ab910bf8" :db/ensure [:activity/validate]} {:db/id "step-5e5891c8-8277-54c3-9c11-9481ab910bf8" :step/id #uuid "5e5891c8-8277-54c3-9c11-9481ab910bf8" :step/content "question-f849acac-b165-56ce-af0c-ee1d4893cc84" :step/next "step-a536b006-715c-59a4-84d0-400b886bdd56" :db/ensure [:step/validate]} {:db/id "step-a536b006-715c-59a4-84d0-400b886bdd56" :step/id #uuid "a536b006-715c-59a4-84d0-400b886bdd56" :step/content "question-8a7a1582-d778-5af4-af63-1b6090d14c6e" :step/next "step-9415b5d7-f308-5c17-9e90-f8ba5c185823" :db/ensure [:step/validate]} {:db/id "step-9415b5d7-f308-5c17-9e90-f8ba5c185823" :step/id #uuid "9415b5d7-f308-5c17-9e90-f8ba5c185823" :step/content 17592186401302 :step/next "step-1da0db94-3628-5190-a1fe-f76eb1f4550b" :db/ensure [:step/validate]} {:db/id "step-1da0db94-3628-5190-a1fe-f76eb1f4550b" :step/id #uuid "1da0db94-3628-5190-a1fe-f76eb1f4550b" :step/content 17592186374083 :step/next "step-efac3413-9dbb-5cde-aece-e1eded4d33e5" :db/ensure [:step/validate]} {:db/id "step-efac3413-9dbb-5cde-aece-e1eded4d33e5" :step/id #uuid "efac3413-9dbb-5cde-aece-e1eded4d33e5" :step/content "question-c40cfd48-e992-514e-93b1-f5d1aa09838d" :db/ensure [:step/validate]} [:db/retract 17592186378809 :answer-field/choices 17592186378810] [:db/retract 17592186378809 :answer-field/choices 17592186378811] [:db/retract 17592186378809 :answer-field/choices 17592186378812] [:db/retract 17592186378809 :answer-field/choices 17592186378814] {:db/id 17592186378808 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The argument of the arcsine has values between $-1$ and $1.$\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n-1\\le {x}^{2}+y\\le 1\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le {x}^{2}+y\\le 1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186378809 :answer-field/correct "answer-13e63be7-9355-5eee-9e74-140ed6390af3" :answer-field/choices ["answer-13e63be7-9355-5eee-9e74-140ed6390af3" "answer-8e00f2bc-edde-5501-b5c2-40b782c1b70d" "answer-3193a2f2-7514-5cab-9591-123a6a9c3f7f" "answer-14f0584a-9240-56c8-aa2d-c06627e2221a"] :db/ensure [:answer-field/validate]} {:db/id "answer-13e63be7-9355-5eee-9e74-140ed6390af3" :answer/id #uuid "13e63be7-9355-5eee-9e74-140ed6390af3" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le {x}^{2}+y\\le 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-8e00f2bc-edde-5501-b5c2-40b782c1b70d" :answer/id #uuid "8e00f2bc-edde-5501-b5c2-40b782c1b70d" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-\\frac{\\pi }{2}\\le {x}^{2}+y\\le \\frac{\\pi }{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-3193a2f2-7514-5cab-9591-123a6a9c3f7f" :answer/id #uuid "3193a2f2-7514-5cab-9591-123a6a9c3f7f" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,-\\pi \\le {x}^{2}+y\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id "answer-14f0584a-9240-56c8-aa2d-c06627e2221a" :answer/id #uuid "14f0584a-9240-56c8-aa2d-c06627e2221a" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,0\\le {x}^{2}+y\\le \\pi \\}" :db/ensure [:answer/validate]} {:db/id 17592186172064 :knowledge-point/questions ["question-bb7be639-e4f8-5a73-903b-c5d7e3e570a1" "question-a471c8a2-3054-5106-9731-9d5bdebed1cf" "question-ed844e83-8648-5ae6-bf7d-9f1f63004687"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bb7be639-e4f8-5a73-903b-c5d7e3e570a1" :question/id #uuid "bb7be639-e4f8-5a73-903b-c5d7e3e570a1" :question/math-academy-id "q-107847" :question/problem "Evaluate $Γ(4).$" :question/worked-solution "For any natural number $n\\ge 1,$ we have\n\n$$\nΓ(n)=(n-1)!.\n$$\n\nTherefore, \n\n$$\nΓ(4)=3!=6.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8ea08a8-5cc9-5269-9ef3-7f0f35e299e2"] :db/ensure [:question/validate]} {:db/id "answer-field-b8ea08a8-5cc9-5269-9ef3-7f0f35e299e2" :answer-field/id #uuid "b8ea08a8-5cc9-5269-9ef3-7f0f35e299e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-83d4f54f-5c61-5a9f-9835-20e838e22f36" :answer-field/choices ["answer-520ca065-870d-59a7-8783-348ca06299c2" "answer-0f7becfe-c77c-5473-a232-b3c3bddf775b" "answer-c1555d56-be4a-56a8-8306-6e2f3a8f54c3" "answer-83d4f54f-5c61-5a9f-9835-20e838e22f36" "answer-bb5d6295-ffd0-5d13-aba8-b47dc0731864"] :db/ensure [:answer-field/validate]} {:db/id "answer-520ca065-870d-59a7-8783-348ca06299c2" :answer/id #uuid "520ca065-870d-59a7-8783-348ca06299c2" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "answer-0f7becfe-c77c-5473-a232-b3c3bddf775b" :answer/id #uuid "0f7becfe-c77c-5473-a232-b3c3bddf775b" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-c1555d56-be4a-56a8-8306-6e2f3a8f54c3" :answer/id #uuid "c1555d56-be4a-56a8-8306-6e2f3a8f54c3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-83d4f54f-5c61-5a9f-9835-20e838e22f36" :answer/id #uuid "83d4f54f-5c61-5a9f-9835-20e838e22f36" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-bb5d6295-ffd0-5d13-aba8-b47dc0731864" :answer/id #uuid "bb5d6295-ffd0-5d13-aba8-b47dc0731864" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186162027 :knowledge-point/questions ["question-7e38227f-eac1-53c7-9471-76f90491bdeb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7e38227f-eac1-53c7-9471-76f90491bdeb" :question/id #uuid "7e38227f-eac1-53c7-9471-76f90491bdeb" :question/math-academy-id "q-132238" :question/problem "The discrete random variable $X\\in Z$ can be approximated by the continuous random variable $Y.$ By applying an appropriate continuity correction, $P(X>-15)$ can be approximated as" :question/worked-solution "To apply the appropriate continuity correction, we first rewrite the strict inequality as follows:\n\n$$\nP(X>-15)=P(X\\ge -14)\n$$\n\nThen, we extend the endpoint of the interval $X\\ge -14$ by $0.5:$\n\n$$\n\\begin{aligned}P(X\\ge -14) & ≈P(Y\\ge -14-0.5) \\\\  & =P(Y\\ge -14.5)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9929ea60-f2ba-517d-b3c7-b4dfdfd82083"] :db/ensure [:question/validate]} {:db/id "answer-field-9929ea60-f2ba-517d-b3c7-b4dfdfd82083" :answer-field/id #uuid "9929ea60-f2ba-517d-b3c7-b4dfdfd82083" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3ed83c1f-5a9f-560a-a762-8184a97c9761" :answer-field/choices ["answer-c3694caa-c68e-5886-8c0d-a19316f7a7de" "answer-3ed83c1f-5a9f-560a-a762-8184a97c9761" "answer-c6552524-5207-54e7-8a47-0c0b03470697" "answer-7aec1610-f32b-556c-b482-f635fe19aa56" "answer-3d40fb48-4dea-5d06-a910-9006779ab03a"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3694caa-c68e-5886-8c0d-a19316f7a7de" :answer/id #uuid "c3694caa-c68e-5886-8c0d-a19316f7a7de" :answer/type :answer.type/math :answer/value "P(Y\\ge -14)" :db/ensure [:answer/validate]} {:db/id "answer-3ed83c1f-5a9f-560a-a762-8184a97c9761" :answer/id #uuid "3ed83c1f-5a9f-560a-a762-8184a97c9761" :answer/type :answer.type/math :answer/value "P(Y\\ge -14.5)" :db/ensure [:answer/validate]} {:db/id "answer-c6552524-5207-54e7-8a47-0c0b03470697" :answer/id #uuid "c6552524-5207-54e7-8a47-0c0b03470697" :answer/type :answer.type/math :answer/value "P(Y\\ge -15)" :db/ensure [:answer/validate]} {:db/id "answer-7aec1610-f32b-556c-b482-f635fe19aa56" :answer/id #uuid "7aec1610-f32b-556c-b482-f635fe19aa56" :answer/type :answer.type/math :answer/value "P(Y\\ge -15.5)" :db/ensure [:answer/validate]} {:db/id "answer-3d40fb48-4dea-5d06-a910-9006779ab03a" :answer/id #uuid "3d40fb48-4dea-5d06-a910-9006779ab03a" :answer/type :answer.type/math :answer/value "P(Y\\ge -16)" :db/ensure [:answer/validate]} {:db/id 17592186176062 :knowledge-point/questions ["question-2ab1da93-7453-5e0d-90e1-e09775711415"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2ab1da93-7453-5e0d-90e1-e09775711415" :question/id #uuid "2ab1da93-7453-5e0d-90e1-e09775711415" :question/math-academy-id "q-159820" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{9}$ is an I.I.D random sample with ${X}_{i}∼B(7,\\theta )$ and unknown probability of success $\\theta .$ For a particular sample ${x}_{1},{x}_{2},…,{x}_{9},$ you're given that \n\n$$\n{\\sum }_{i=1}^{9}{x}_{i}=13.\n$$\n\nFind the likelihood function of the sample up to a constant $C.$\n\n*Hint: The probability mass function for a binomial random variable is given by*\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){\\theta }^{x}(1-\\theta )^{n-x},\\,x=0,1,2,…,n.\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=9$ independent binomial random variables with unknown probability of success $\\theta $ and $N=7$ trials, for which the probability mass function is\n\n$$\n\\begin{aligned}f(x;\\theta )=(\\genfrac{}{}{0pt}{}{7}{x}){\\theta }^{x}(1-\\theta )^{7-x}, & \\,x=0,1,2,…,7.\\end{aligned}\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}f({x}_{i};\\theta ) \\\\  & ={\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{7-{x}_{i}} \\\\  & =((\\genfrac{}{}{0pt}{}{7}{{x}_{1}}){\\theta }^{{x}_{1}}(1-\\theta )^{7-{x}_{1}})\\cdot ((\\genfrac{}{}{0pt}{}{7}{{x}_{2}}){\\theta }^{{x}_{2}}(1-\\theta )^{7-{x}_{2}})⋯((\\genfrac{}{}{0pt}{}{7}{{x}_{n}}){\\theta }^{{x}_{n}}(1-\\theta )^{7-{x}_{n}}) \\\\  & =C\\,{\\theta }^{\\,\\sum {x}_{i}}(1-\\theta )^{\\,\\sum (7-{x}_{i})} \\\\  & =C\\,{\\theta }^{\\,\\sum {x}_{i}}(1-\\theta )^{\\,7n-\\sum {x}_{i}} \\\\  & =C\\,{\\theta }^{S}(1-\\theta )^{7n-S}\\end{aligned}\n$$\n\nwhere $C={\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{7}{{x}_{i}})$ is a constant and $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nWe are told that $S={\\sum }_{i=1}^{n}{x}_{i}=13$ and $n=9.$ Therefore,\n\n$$\n\\begin{aligned}L(\\theta ) & =C\\,{\\theta }^{13}(1-\\theta )^{7(9)-13} \\\\  & =C\\,{\\theta }^{13}(1-\\theta )^{50}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1d9998e2-ef7e-5722-9f5e-802dd357bfa9"] :db/ensure [:question/validate]} {:db/id "answer-field-1d9998e2-ef7e-5722-9f5e-802dd357bfa9" :answer-field/id #uuid "1d9998e2-ef7e-5722-9f5e-802dd357bfa9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fa759598-3ac0-5792-98c5-3cd26ff647da" :answer-field/choices ["answer-fa759598-3ac0-5792-98c5-3cd26ff647da" "answer-d8a0f4bd-6540-5548-8698-5b59c0979895" "answer-757bc2d3-ea55-5779-a853-74ca7cc5ecfd" "answer-47c9e21b-e0a4-58d7-b5f7-88d77b0829d0" "answer-1b3494d6-0de7-5038-b54c-792db85a0c85"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa759598-3ac0-5792-98c5-3cd26ff647da" :answer/id #uuid "fa759598-3ac0-5792-98c5-3cd26ff647da" :answer/type :answer.type/math :answer/value "C\\,{\\theta }^{13}(1-\\theta )^{50}" :db/ensure [:answer/validate]} {:db/id "answer-d8a0f4bd-6540-5548-8698-5b59c0979895" :answer/id #uuid "d8a0f4bd-6540-5548-8698-5b59c0979895" :answer/type :answer.type/math :answer/value "C\\,{\\theta }^{13}(1-\\theta )^{63}" :db/ensure [:answer/validate]} {:db/id "answer-757bc2d3-ea55-5779-a853-74ca7cc5ecfd" :answer/id #uuid "757bc2d3-ea55-5779-a853-74ca7cc5ecfd" :answer/type :answer.type/math :answer/value "C\\,{\\theta }^{50}(1-\\theta )^{13}" :db/ensure [:answer/validate]} {:db/id "answer-47c9e21b-e0a4-58d7-b5f7-88d77b0829d0" :answer/id #uuid "47c9e21b-e0a4-58d7-b5f7-88d77b0829d0" :answer/type :answer.type/math :answer/value "C\\,{\\theta }^{50}(1-\\theta )^{50}" :db/ensure [:answer/validate]} {:db/id "answer-1b3494d6-0de7-5038-b54c-792db85a0c85" :answer/id #uuid "1b3494d6-0de7-5038-b54c-792db85a0c85" :answer/type :answer.type/math :answer/value "C\\,{\\theta }^{63}(1-\\theta )^{13}" :db/ensure [:answer/validate]} {:db/id 17592186166838 :knowledge-point/questions ["question-4b4a8271-3af9-5314-8310-6943f2c7643d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4b4a8271-3af9-5314-8310-6943f2c7643d" :question/id #uuid "4b4a8271-3af9-5314-8310-6943f2c7643d" :question/math-academy-id "q-97679" :question/problem "In winter, the maximum daily temperature of a certain mountain location (rounded to the nearest degree) varies between $-{15}^{∘}C$ and ${2}^{∘}C,$ inclusive. Assuming that for a given winter day, each maximum temperature value between $-{15}^{∘}C$ and ${2}^{∘}C$ has an equal probability of occurring, what is the probability that the maximum daily temperature will reach at least ${0}^{∘}C$ on a randomly selected day?" :question/worked-solution "Let $X$ represent the maximum daily temperature (rounded to the nearest degree Celsius). From the problem statement, we know that $X∼U\\{-15,-14,…,2\\},$ and we wish to compute $P(X\\ge 0).$\n\nIn general, if $X$ follows a discrete uniform distribution over a set $S,$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{|S|}, & x\\in S \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, we have $X∼U\\{-15,-14,…,2\\},$ and the set $S=\\{-15,-14,…,2\\}$ has $|S|=2-(-15)+1=18$ items. So, we have\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{18}, & x=-15,-14,…,2 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nIn $S,$ the items that satisfy $X\\ge 0$ are $0,1,2.$ There are $3$ of these elements. Therefore,\n\n$$\nP(X\\ge 0)=3\\cdot \\frac{1}{18}=\\frac{1}{6}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8ebfc676-fdb1-53ab-b889-b6b98a229798"] :db/ensure [:question/validate]} {:db/id "answer-field-8ebfc676-fdb1-53ab-b889-b6b98a229798" :answer-field/id #uuid "8ebfc676-fdb1-53ab-b889-b6b98a229798" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-137d4e44-9828-5ee0-89ba-c9b7c0edfcda" :answer-field/choices ["answer-e1fffc80-b079-59ff-bdcc-87333dd7015a" "answer-db12f085-011d-52fa-9f1f-43b64008b1a2" "answer-137d4e44-9828-5ee0-89ba-c9b7c0edfcda" "answer-64c12a31-677b-51ab-9671-a72788d101d3" "answer-1ae489c7-a3c1-592f-874f-9ab522ff716b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1fffc80-b079-59ff-bdcc-87333dd7015a" :answer/id #uuid "e1fffc80-b079-59ff-bdcc-87333dd7015a" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-db12f085-011d-52fa-9f1f-43b64008b1a2" :answer/id #uuid "db12f085-011d-52fa-9f1f-43b64008b1a2" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-137d4e44-9828-5ee0-89ba-c9b7c0edfcda" :answer/id #uuid "137d4e44-9828-5ee0-89ba-c9b7c0edfcda" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-64c12a31-677b-51ab-9671-a72788d101d3" :answer/id #uuid "64c12a31-677b-51ab-9671-a72788d101d3" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-1ae489c7-a3c1-592f-874f-9ab522ff716b" :answer/id #uuid "1ae489c7-a3c1-592f-874f-9ab522ff716b" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id 17592186059688 :knowledge-point/questions ["question-22695eb6-0581-5f84-9a76-e047ac8b10b4" "question-e24afd3b-3cd1-54ee-83ee-26ca9c096040"] :db/ensure [:knowledge-point/validate]} {:db/id "question-22695eb6-0581-5f84-9a76-e047ac8b10b4" :question/id #uuid "22695eb6-0581-5f84-9a76-e047ac8b10b4" :question/math-academy-id "q-182594" :question/problem "$\\,$ Either go to the movies, or you can watch a film at home.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ Go to the movies.\n\n- $B:$ You can watch a film at home.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You don't go to the movies.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you don't go to the movies, then you can watch a film at home.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dc293ee1-edd2-5c82-9086-24fd0f998be3"] :db/ensure [:question/validate]} {:db/id "answer-field-dc293ee1-edd2-5c82-9086-24fd0f998be3" :answer-field/id #uuid "dc293ee1-edd2-5c82-9086-24fd0f998be3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c041953-eb86-5d4b-9d51-b723fdae2307" :answer-field/choices ["answer-6bc99ccb-8cfd-5769-b5b3-a63cda6beaba" "answer-0c041953-eb86-5d4b-9d51-b723fdae2307" "answer-19a60f87-60ae-5b22-a9c7-4b5028011c8b" "answer-ab1b5de4-4369-5666-a699-73e8c327e027" "answer-5be1fb9b-993a-5931-a734-0cfebdf60e5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-6bc99ccb-8cfd-5769-b5b3-a63cda6beaba" :answer/id #uuid "6bc99ccb-8cfd-5769-b5b3-a63cda6beaba" :answer/type :answer.type/text :answer/value "Go to the movies, and you cannot watch a film at home." :db/ensure [:answer/validate]} {:db/id "answer-0c041953-eb86-5d4b-9d51-b723fdae2307" :answer/id #uuid "0c041953-eb86-5d4b-9d51-b723fdae2307" :answer/type :answer.type/text :answer/value "If you don't go to the movies, then you can watch a film at home." :db/ensure [:answer/validate]} {:db/id "answer-19a60f87-60ae-5b22-a9c7-4b5028011c8b" :answer/id #uuid "19a60f87-60ae-5b22-a9c7-4b5028011c8b" :answer/type :answer.type/text :answer/value "If you don't go to the movies, then you cannot watch a film at home." :db/ensure [:answer/validate]} {:db/id "answer-ab1b5de4-4369-5666-a699-73e8c327e027" :answer/id #uuid "ab1b5de4-4369-5666-a699-73e8c327e027" :answer/type :answer.type/text :answer/value "If you go to the movies, then you can watch a film at home." :db/ensure [:answer/validate]} {:db/id "answer-5be1fb9b-993a-5931-a734-0cfebdf60e5d" :answer/id #uuid "5be1fb9b-993a-5931-a734-0cfebdf60e5d" :answer/type :answer.type/text :answer/value "If you go to the movies, then you cannot watch a film at home." :db/ensure [:answer/validate]} {:db/id "activity-a254ca4b-2f3c-550b-b464-0958547f215e" :activity/id #uuid "a254ca4b-2f3c-550b-b464-0958547f215e" :activity/