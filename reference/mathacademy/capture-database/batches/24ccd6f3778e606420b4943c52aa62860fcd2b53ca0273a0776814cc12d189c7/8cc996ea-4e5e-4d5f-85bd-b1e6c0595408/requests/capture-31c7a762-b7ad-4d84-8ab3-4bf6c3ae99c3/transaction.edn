r/validate]} {:db/id "answer-85e82733-72e9-5fe3-a525-fcd438f48a87" :answer/id #uuid "85e82733-72e9-5fe3-a525-fcd438f48a87" :answer/type :answer.type/math :answer/value "x=2\\pm \\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-33b525d2-ae01-5ef2-9eed-e166e957cf3e" :answer/id #uuid "33b525d2-ae01-5ef2-9eed-e166e957cf3e" :answer/type :answer.type/math :answer/value "x=3\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-14d76f83-3406-5a16-9d41-9302c71facc8" :answer/id #uuid "14d76f83-3406-5a16-9d41-9302c71facc8" :answer/type :answer.type/math :answer/value "x=3\\pm 6\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-d1db860b-027a-52ce-b830-0bd7940d1d70" :answer/id #uuid "d1db860b-027a-52ce-b830-0bd7940d1d70" :answer/type :answer.type/math :answer/value "x=3\\pm \\text{i}" :db/ensure [:answer/validate]} {:db/id "question-fe69821d-b46b-58da-90bc-7fc6e8ec74de" :question/id #uuid "fe69821d-b46b-58da-90bc-7fc6e8ec74de" :question/math-academy-id "q-66433" :question/problem "The equation ${x}^{2}-2x+50=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+50 & =0 \\\\ {x}^{2}-2x & =-50\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x & =-50 \\\\ {x}^{2}-2\\cdot x+{1}^{2}-{1}^{2} & =-50 \\\\ (x-1)^{2}-1 & =-50 \\\\ (x-1)^{2} & =-49\\end{aligned}\n$$\n\nTherefore, $p=-1,\\,q=-49,$ and $p+q=-50.$\n\nWe now solve the equation using the square root method.\n\n$$\n\\begin{aligned}(x-1)^{2} & =-49 \\\\ x-1 & =\\pm \\sqrt{-49} \\\\ x-1 & =\\pm 7\\,\\text{i} \\\\ x & =1\\pm 7\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=1+7\\,\\text{i}$ and $x=1-7\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7c344069-8f49-5427-9186-66d3592936f1"] :db/ensure [:question/validate]} {:db/id "answer-field-7c344069-8f49-5427-9186-66d3592936f1" :answer-field/id #uuid "7c344069-8f49-5427-9186-66d3592936f1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3157fdc1-ded2-5a92-9105-4346fef8e904" :answer-field/choices ["answer-197bab39-aefb-5013-8acb-1aa1f1a8cb64" "answer-add29e6d-84a5-5adf-8899-1715f944a39f" "answer-e6426f70-ad93-5d31-97ad-d5c4192bec98" "answer-3157fdc1-ded2-5a92-9105-4346fef8e904" "answer-01e561ad-263f-5e12-967a-1f08037c6fdb"] :db/ensure [:answer-field/validate]} {:db/id "answer-197bab39-aefb-5013-8acb-1aa1f1a8cb64" :answer/id #uuid "197bab39-aefb-5013-8acb-1aa1f1a8cb64" :answer/type :answer.type/math :answer/value "p+q=-48,\\,x=1\\pm 5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-add29e6d-84a5-5adf-8899-1715f944a39f" :answer/id #uuid "add29e6d-84a5-5adf-8899-1715f944a39f" :answer/type :answer.type/math :answer/value "p+q=-48,\\,x=2\\pm 5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-e6426f70-ad93-5d31-97ad-d5c4192bec98" :answer/id #uuid "e6426f70-ad93-5d31-97ad-d5c4192bec98" :answer/type :answer.type/math :answer/value "p+q=-50,\\,x=1\\pm 5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-3157fdc1-ded2-5a92-9105-4346fef8e904" :answer/id #uuid "3157fdc1-ded2-5a92-9105-4346fef8e904" :answer/type :answer.type/math :answer/value "p+q=-50,\\,x=1\\pm 7\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-01e561ad-263f-5e12-967a-1f08037c6fdb" :answer/id #uuid "01e561ad-263f-5e12-967a-1f08037c6fdb" :answer/type :answer.type/math :answer/value "p+q=-50,\\,x=2\\pm 5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "question-36266739-216f-533b-a7c0-f932ac7e366b" :question/id #uuid "36266739-216f-533b-a7c0-f932ac7e366b" :question/math-academy-id "q-66233" :question/problem "The equation ${x}^{2}+4x+8=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+4x+8 & =0 \\\\ {x}^{2}+4x & =-8\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}+4x & =-8 \\\\ {x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2} & =-8 \\\\ (x+2)^{2}-4 & =-8 \\\\ (x+2)^{2} & =-4\\end{aligned}\n$$\n\nTherefore, $p=2,\\,q=-4,$ and $p+q=-2.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+2)^{2} & =-4 \\\\ x+2 & =\\pm \\sqrt{-4} \\\\ x+2 & =\\pm 2\\,\\text{i} \\\\ x & =-2\\pm 2\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=-2+2\\,\\text{i}$ and $x=-2-2\\,\\text{i}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-463f4433-cc91-5575-9df5-d220fc7f2416"] :db/ensure [:question/validate]} {:db/id "answer-field-463f4433-cc91-5575-9df5-d220fc7f2416" :answer-field/id #uuid "463f4433-cc91-5575-9df5-d220fc7f2416" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c208198d-363c-5ae6-b1e5-01493c975478" :answer-field/choices ["answer-61dc17df-7f2c-5e9a-8fae-4b878df5b615" "answer-c208198d-363c-5ae6-b1e5-01493c975478" "answer-7393a346-1d74-5db6-8784-b142b1da6218" "answer-3133f8fb-535f-5f80-a6b0-05a8e94cab76" "answer-a84c129c-dae5-55d4-9722-06177a4516ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-61dc17df-7f2c-5e9a-8fae-4b878df5b615" :answer/id #uuid "61dc17df-7f2c-5e9a-8fae-4b878df5b615" :answer/type :answer.type/math :answer/value "p+q=-2,\\,x=-1\\pm 3\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-c208198d-363c-5ae6-b1e5-01493c975478" :answer/id #uuid "c208198d-363c-5ae6-b1e5-01493c975478" :answer/type :answer.type/math :answer/value "p+q=-2,\\,x=-2\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-7393a346-1d74-5db6-8784-b142b1da6218" :answer/id #uuid "7393a346-1d74-5db6-8784-b142b1da6218" :answer/type :answer.type/math :answer/value "p+q=-2,\\,x=-2\\pm 3\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-3133f8fb-535f-5f80-a6b0-05a8e94cab76" :answer/id #uuid "3133f8fb-535f-5f80-a6b0-05a8e94cab76" :answer/type :answer.type/math :answer/value "p+q=-4,\\,x=-1\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-a84c129c-dae5-55d4-9722-06177a4516ed" :answer/id #uuid "a84c129c-dae5-55d4-9722-06177a4516ed" :answer/type :answer.type/math :answer/value "p+q=-6,\\,x=-2\\pm 2\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186088886 :tutorial/content "Suppose that we want to solve the quadratic equation\n\n$$\nx^2 -2x +2=0.\n$$\n\nThis quadratic is written in standard form with $a=1,$ $b=-2,$ and $c=2.$ However, its discriminant is negative:\n\n$$\n\\begin{aligned}{b}^{2}-4ac & =(-2)^{2}-4(1)(2) \\\\  & =4-8 \\\\  & =-4 \\\\  & <0\\end{aligned}\n$$\n\nThis means that the quadratic equation has no real solutions. However, if we allow complex solutions, we may solve the equation as follows:\n\n$$\n\\begin{aligned}x & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(2)}}{2\\cdot 1} \\\\  & =\\frac{2\\pm \\sqrt{-4}}{2} \\\\  & =\\frac{2\\pm 2\\text{i}}{2} \\\\  & =1\\pm \\text{i}\\end{aligned}\n$$\n\nTherefore, the equation $x^2 -2x +2=0$ has two solutions, $x=1+\\textrm{i}$ and $x=1-\\textrm{i}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186088887 :tutorial/content "We can also solve a quadratic equation with complex solutions using the square root method.\n\nTo demonstrate, let's find the solutions of the equation $(x-2)^2=-16.$\n\nThe left-hand side is a perfect square. Therefore, we can solve the equation as follows:\n\n$$\n\\begin{aligned}(x-2)^{2} & =-16 \\\\ x-2 & =\\pm \\sqrt{-16} \\\\ x-2 & =\\pm 4\\text{i} \\\\ x & =2\\pm 4\\text{i}\\end{aligned}\n$$\n\nSometimes, we need to complete the square first before applying the square root method. Let's see how." :db/ensure [:tutorial/validate]} {:db/id 17592186087957 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} {:db/id 17592186166745 :knowledge-point/questions ["question-3b833ee1-1847-58cb-97d6-c3991e739299" "question-f94d1068-670c-5c11-bfa5-671be972298f" "question-8d32f05e-a3c3-5b23-84fe-d49446839154" "question-658b6264-48ba-595e-8094-31fd78df29f0" "question-913e0d96-0bea-55c4-bb2c-9c7bdf80d678"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166583 :question/problem "Given that $X$ is a random variable such that $X\\sim U[2,8],$ find $\\textrm{E}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\textrm{E}[X] = \\dfrac{a+b}{2}.\n$$\n\nIn our case, we have $a=2$ and $b=8.$ Therefore,\n\n$$\n\\textrm{E}[X] = \\dfrac{2+8}{2} =5.\n$$" :db/ensure [:question/validate]} {:db/id 17592186166746 :knowledge-point/questions ["question-ce5a9223-e79c-5d1c-994a-c41247274cfd" "question-c3347265-887a-5de9-9351-68357744a4ce" "question-4dba6d14-c48e-57a9-a000-8735dd68da37" "question-a329bcb9-8fe5-5112-b921-bf4d5fc58af8" "question-0886f3b4-52e4-5836-9f98-a91d21c13a2a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166584 :question/problem "Given that $X$ is a random variable such that $X\\sim U[2,10],$ find $\\textrm{Var}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}.\n$$\n\nIn our case, we have $a=2$ and $b=10.$ Therefore,\n\n$$\n\\textrm{Var}[X] = \\dfrac{(10-2)^2}{12} = \\dfrac{64}{12} = \\dfrac{16}{3}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186166794 :knowledge-point/questions ["question-902c64d6-e7e5-5954-9fec-c7166d10d6e1" "question-54e63900-c156-508b-82d2-231404053657" "question-d1619c3f-d3f5-5de9-b2f1-3d2eb5956079" "question-6e72c01b-4831-5832-84ce-7e36b797f77a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166632 :question/problem "Given that $X$ is a random variable such that $X\\sim U[-9,-3],$ find $\\textrm{SD}[X].$ Round your answer to three decimal places." :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\textrm{Var}[X] = \\dfrac{(b-a)^2}{12}.\n$$\n\nIn our case, we have $a=-9$ and $b=-3.$ Therefore,\n\n$$\n\\textrm{Var}[X] = \\dfrac{(-3-(-9))^2}{12} = \\dfrac{36}{12} = 3.\n$$\n\nFinally,\n\n$$\n\\textrm{SD}[X] = \\sqrt{3} \\approx 1.732.\n$$" :db/ensure [:question/validate]} {:db/id "question-3b833ee1-1847-58cb-97d6-c3991e739299" :question/id #uuid "3b833ee1-1847-58cb-97d6-c3991e739299" :question/math-academy-id "q-130703" :question/problem "Given that $X$ is a random variable such that $X∼U[-6,4],$ find $\\text{E}[X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{E}[X]=\\frac{a+b}{2}.\n$$\n\nIn our case, we have $a=-6$ and $b=4.$ Therefore,\n\n$$\n\\text{E}[X]=\\frac{-6+4}{2}=-1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4625d57b-e832-53e0-9451-317190b1a66e"] :db/ensure [:question/validate]} {:db/id "answer-field-4625d57b-e832-53e0-9451-317190b1a66e" :answer-field/id #uuid "4625d57b-e832-53e0-9451-317190b1a66e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4424fe52-ec95-59aa-8693-e3a5916e40d6" :answer-field/choices ["answer-4424fe52-ec95-59aa-8693-e3a5916e40d6" "answer-7fe7342a-2616-5462-9705-63b7d2a36b4c" "answer-000c3fe5-5d1e-5162-ba58-1b1f62f1065b" "answer-bd3c5c22-a858-5923-bb87-1a7a15975c43" "answer-cff22e4c-885c-53f9-9ef5-db1818df7721"] :db/ensure [:answer-field/validate]} {:db/id "answer-4424fe52-ec95-59aa-8693-e3a5916e40d6" :answer/id #uuid "4424fe52-ec95-59aa-8693-e3a5916e40d6" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-7fe7342a-2616-5462-9705-63b7d2a36b4c" :answer/id #uuid "7fe7342a-2616-5462-9705-63b7d2a36b4c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [: