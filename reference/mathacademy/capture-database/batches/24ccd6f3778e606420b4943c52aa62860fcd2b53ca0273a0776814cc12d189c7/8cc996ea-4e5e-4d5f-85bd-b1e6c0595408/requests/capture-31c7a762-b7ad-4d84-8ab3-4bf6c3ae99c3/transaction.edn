X].$" :question/worked-solution "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-11$ and $b=7.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(7-(-11))^{2}}{12}=\\frac{324}{12}=27.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f75f0064-cfb0-5e12-bd8f-0b8295695e44"] :db/ensure [:question/validate]} {:db/id "answer-field-f75f0064-cfb0-5e12-bd8f-0b8295695e44" :answer-field/id #uuid "f75f0064-cfb0-5e12-bd8f-0b8295695e44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b719235e-f4dc-53e5-9a21-8b2b368f8b5c" :answer-field/choices ["answer-b719235e-f4dc-53e5-9a21-8b2b368f8b5c" "answer-4b50acb8-8e9f-54a4-8fce-0388b7be6d9d" "answer-8e0dda67-bb36-5f6d-8489-7a7090fc4d3c" "answer-d2fad82b-76d3-5a57-84fe-8de90cc137ec" "answer-7638a3ca-938f-5a9c-83d1-b500e285748a"] :db/ensure [:answer-field/validate]} {:db/id "answer-b719235e-f4dc-53e5-9a21-8b2b368f8b5c" :answer/id #uuid "b719235e-f4dc-53e5-9a21-8b2b368f8b5c" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-4b50acb8-8e9f-54a4-8fce-0388b7be6d9d" :answer/id #uuid "4b50acb8-8e9f-54a4-8fce-0388b7be6d9d" :answer/type :answer.type/math :answer/value "29" :db/ensure [:answer/validate]} {:db/id "answer-8e0dda67-bb36-5f6d-8489-7a7090fc4d3c" :answer/id #uuid "8e0dda67-bb36-5f6d-8489-7a7090fc4d3c" :answer/type :answer.type/math :answer/value "\\frac{27}{12}" :db/ensure [:answer/validate]} {:db/id "answer-d2fad82b-76d3-5a57-84fe-8de90cc137ec" :answer/id #uuid "d2fad82b-76d3-5a57-84fe-8de90cc137ec" :answer/type :answer.type/math :answer/value "\\frac{27}{3}" :db/ensure [:answer/validate]} {:db/id "answer-7638a3ca-938f-5a9c-83d1-b500e285748a" :answer/id #uuid "7638a3ca-938f-5a9c-83d1-b500e285748a" :answer/type :answer.type/math :answer/value "\\frac{29}{12}" :db/ensure [:answer/validate]} {:d