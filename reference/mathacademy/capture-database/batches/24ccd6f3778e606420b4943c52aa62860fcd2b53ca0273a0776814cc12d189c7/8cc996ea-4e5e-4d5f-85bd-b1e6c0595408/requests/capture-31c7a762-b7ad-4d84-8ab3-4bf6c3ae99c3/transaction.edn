-c8f5-57aa-a85f-1f4c592833ea" :db/ensure [:step/validate]} {:db/id "step-b1d9251f-c8f5-57aa-a85f-1f4c592833ea" :step/id #uuid "b1d9251f-c8f5-57aa-a85f-1f4c592833ea" :step/content "question-b48192d6-2f48-593d-8172-2cd990c8dfc7" :step/next "step-4a33ff7b-791f-5886-878a-835a7a32b5c1" :db/ensure [:step/validate]} {:db/id "step-4a33ff7b-791f-5886-878a-835a7a32b5c1" :step/id #uuid "4a33ff7b-791f-5886-878a-835a7a32b5c1" :step/content "question-b031bd51-cdd6-576b-8767-0d0f9a3a9494" :db/ensure [:step/validate]} {:db/id 17592186083231 :knowledge-point/questions ["question-f01c0026-fa08-5097-91bc-94d42a5e0028"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083312 :knowledge-point/questions ["question-ff51d5b2-0c1d-5e47-9288-9faca391fd04"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083112 :question/problem "Evaluate ![](images/77/777f12c125eef00b30f90e43ba94af90ac4b02b71c805da5b18e3306d03fba7d.svg)" :db/ensure [:question/validate]} {:db/id "question-f01c0026-fa08-5097-91bc-94d42a5e0028" :question/id #uuid "f01c0026-fa08-5097-91bc-94d42a5e0028" :question/math-academy-id "q-122488" :question/problem "Evaluate ${}_{8}{C}_{3}.$" :question/worked-solution "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=8$ and $r=3,$ we get\n\n$$\n\\begin{aligned}{}_{8}{C}_{3} & =\\frac{8!}{(8-3)!\\,3!} \\\\  & =\\frac{8!}{5!\\,3!} \\\\  & =\\frac{8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}3!} \\\\  & =\\frac{8\\cdot 7\\cdot 6}{6} \\\\  & =56.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a12a7f5c-4e0b-5883-bd78-10617f79adc4"] :db/ensure [:question/validate]} {:db/id "answer-field-a12a7f5c-4e0b-5883-bd78-10617f79adc4" :answer-field/id #uuid "a12a7f5c-4e0b-5883-bd78-10617f79adc4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1687893a-0b97-5313-aba2-cd575b696248" :answer-field/choices ["answer-b85d87e1-b3eb-58e2-ab2c-1b5d86722f33" "answer-d26c3aa3-9c46-5c7a-8439-3cf26fee0a80" "answer-1687893a-0b97-5313-aba2-cd575b696248" "answer-959c4952-dcc9-514f-9c05-83479f55c7ba" "answer-1ec3a5b9-c8b2-594b-8a3f-a752d215e5cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-b85d87e1-b3eb-58e2-ab2c-1b5d86722f33" :answer/id #uuid "b85d87e1-b3eb-58e2-ab2c-1b5d86722f33" :answer/type :answer.type/math :answer/value "336" :db/ensure [:answer/validate]} {:db/id "answer-d26c3aa3-9c46-5c7a-8439-3cf26fee0a80" :answer/id #uuid "d26c3aa3-9c46-5c7a-8439-3cf26fee0a80" :answer/type :answer.type/math :answer/value "40\\,320" :db/ensure [:answer/validate]} {:db/id "answer-1687893a-0b97-5313-aba2-cd575b696248" :answer/id #uuid "1687893a-0b97-5313-aba2-cd575b696248" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "answer-959c4952-dcc9-514f-9c05-83479f55c7ba" :answer/id #uuid "959c4952-dcc9-514f-9c05-83479f55c7ba" :answer/type :answer.type/math :answer/value "6\\,720" :db/ensure [:answer/validate]} {:db/id "answer-1ec3a5b9-c8b2-594b-8a3f-a752d215e5cc" :answer/id #uuid "1ec3a5b9-c8b2-594b-8a3f-a752d215e5cc" :answer/type :answer.type/math :answer/value "720" :db/ensure [:answer/validate]} {:db/id 17592186354385 :question/worked-solution "First, note that $(\\genfrac{}{}{0pt}{}{36}{33})$ means the same thing as ${}_{36}{C}_{33}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=36$ and $r=33,$ we get\n\n$$\n\\begin{aligned}{}_{36}{C}_{33} & =\\frac{36!}{(36-33)!33!} \\\\  & =\\frac{36!}{3!33!} \\\\  & =\\frac{36\\cdot 35\\cdot 34\\cdot \\cancel{33!}}{3!\\cdot \\cancel{33!}} \\\\  & =\\frac{36\\cdot 35\\cdot 34}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{42\\,840}{6} \\\\  & =7\\,140.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-ff51d5b2-0c1d-5e47-9288-9faca391fd04" :question/id #uuid "ff51d5b2-0c1d-5e47-9288-9faca391fd04" :question/math-academy-id "q-122497" :question/problem "Evaluate $(\\genfrac{}{}{0pt}{}{100}{98}).$" :question/worked-solution "First, note that $(\\genfrac{}{}{0pt}{}{100}{98})$ means the same thing as ${}_{100}{C}_{98}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=100$ and $r=98,$ we get\n\n$$\n\\begin{aligned}{}_{100}{C}_{98} & =\\frac{100!}{(100-98)!\\,98!} \\\\  & =\\frac{100!}{2!\\,98!} \\\\  & =\\frac{100\\cdot 99\\cdot \\cancel{98!}}{2\\,\\cancel{98!}} \\\\  & =4\\,950.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4b77453e-bad9-5c0b-bfb9-af3d4193ef9e"] :db/ensure [:question/validate]} {:db/id "answer-field-4b77453e-bad9-5c0b-bfb9-af3d4193ef9e" :answer-field/id #uuid "4b77453e-bad9-5c0b-bfb9-af3d4193ef9e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4d3ea9d-b546-5356-9c60-fc72554d1f5b" :answer-field/choices ["answer-98b9307e-5234-5713-a3d7-11d67fb254be" "answer-b4d3ea9d-b546-5356-9c60-fc72554d1f5b" "answer-4a6d2b5d-90a2-5717-9014-5cc81900679e" "answer-acfe2f27-5345-5351-9e15-5b0d29a2c09c" "answer-f1b07343-d9a0-5273-ad0a-97d7b69f5dce"] :db/ensure [:answer-field/validate]} {:db/id "answer-98b9307e-5234-5713-a3d7-11d67fb254be" :answer/id #uuid "98b9307e-5234-5713-a3d7-11d67fb254be" :answer/type :answer.type/math :answer/value "495" :db/ensure [:answer/validate]} {:db/id "answer-b4d3ea9d-b546-5356-9c60-fc72554d1f5b" :answer/id #uuid "b4d3ea9d-b546-5356-9c60-fc72554d1f5b" :answer/type :answer.type/math :answer/value "4\\,950" :db/ensure [:answer/validate]} {:db/id "answer-4a6d2b5d-90a2-5717-9014-5cc81900679e" :answer/id #uuid "4a6d2b5d-90a2-5717-9014-5cc81900679e" :answer/type :answer.type/math :answer/value "50!" :db/ensure [:answer/validate]} {:db/id "answer-acfe2f27-5345-5351-9e15-5b0d29a2c09c" :answer/id #uuid "acfe2f27-5345-5351-9e15-5b0d29a2c09c" :answer/type :answer.type/math :answer/value "98!" :db/ensure [:answer/validate]} {:db/id "answer-f1b07343-d9a0-5273-ad0a-97d7b69f5dce" :answer/id #uuid "f1b07343-d9a0-5273-ad0a-97d7b69f5dce" :answer/type :answer.type/math :answer/value "9\\,900" :db/ensure [:answer/validate]} {:db/id 17592186084450 :tutorial/content "In general, the number of unique combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_nC_r = \\frac{{}_nP_r}{r!} = \\dfrac{n!}{(n-r)!r!}.\n$$\n\nThis is pronounced \"en-see-arr.\" The \"C\" stands for \"combination.\" \n\nIn the previous example, we had $n=5$ books, taking $r=3$ books with us on the trip. Using the formula, the total number of combinations is computed as\n![](images/e7/e73f73afd887785d06875907181fa38097aac62a65a81f5da464b674763ff863.svg)\n\nWe got the same result as before!\n\n**Note:** An alternative notation for ${}_nC_r$ is $\\displaystyle {{n}\\choose{r}}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186083411 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186105857 :knowledge-point/questions ["question-e3a057d6-ea56-5dc0-9a37-b812d961c933"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e3a057d6-ea56-5dc0-9a37-b812d961c933" :question/id #uuid "e3a057d6-ea56-5dc0-9a37-b812d961c933" :question/math-academy-id "q-133014" :question/problem "Evaluate ${lim}_{x\\to -\\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to -\\infty }f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "First, as $x\\to -\\infty ,$ we can assume that $x<-4.$ So, we use the following expression for $f(x):$\n\n$$\nf(x)={x}^{2}+3x\n$$\n\nNow, we identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }({x}^{2}+3x) & ={lim}_{x\\to -\\infty }({x}^{2}) \\\\  & =\\infty \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2efa265e-7df1-5e6e-8acc-a153499df2a5"] :db/ensure [:question/validate]} {:db/id "answer-field-2efa265e-7df1-5e6e-8acc-a153499df2a5" :answer-field/id #uuid "2efa265e-7df1-5e6e-8acc-a153499df2a5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6be8746c-50a8-5427-ac7a-c3e664b70b98" :answer-field/choices ["answer-6be8746c-50a8-5427-ac7a-c3e664b70b98"] :db/ensure [:answer-field/validate]} {:db/id "answer-6be8746c-50a8-5427-ac7a-c3e664b70b98" :answer/id #uuid "6be8746c-50a8-5427-ac7a-c3e664b70b98" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id 17592186078383 :knowledge-point/questions ["question-9a484d05-16dc-5a62-96c8-679e46043371"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9a484d05-16dc-5a62-96c8-679e46043371" :question/id #uuid "9a484d05-16dc-5a62-96c8-679e46043371" :question/math-academy-id "q-133015" :question/problem "Given that the function $f(x)$ is continuous at $x=-4,$ what is the value of $a?$\n\n$a\\,=\\,$\n{{field-1}}" :question/worked-solution "At $x=-4,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{4}^{-}}f(x) & ={lim}_{x\\to \\,-{4}^{-}}({x}^{2}+3x) \\\\  & =(-4)^{2}+3(-4) \\\\  & =4\\end{aligned}\n$$\n\nand the right-sided limit is\n\n$$\n{lim}_{x\\to \\,-{4}^{+}}f(x)=-5a.\n$$\n\nIn order for $f(x)$ to be continuous at $x=-4,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{4}^{-}}f(x) & ={lim}_{x\\to \\,-{4}^{+}}f(x) \\\\ 4 & =-5a \\\\ a & =-\\frac{4}{5}.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is continuous at $x=-4$ for $a=-\\frac{4}{5}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f3274d1e-2207-5135-9f1c-8aaf27706f61"] :db/ensure [:question/validate]} {:db/id "answer-field-f3274d1e-2207-5135-9f1c-8aaf27706f61" :answer-field/id #uuid "f3274d1e-2207-5135-9f1c-8aaf27706f61" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b1c3fd01-f3db-57d1-9bef-ae4866fbe270" :answer-field/choices ["answer-b1c3fd01-f3db-57d1-9bef-ae4866fbe270"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1c3fd01-f3db-57d1-9bef-ae4866fbe270" :answer/id #uuid "b1c3fd01-f3db-57d1-9bef-ae4866fbe270" :answer/type :answer.type/math :answer/value "-\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id 17592186100978 :knowledge-point/questions ["question-03ebca0d-b111-51a4-8281-85b0168f9966"] :db/ensure [:knowledge-point/validate]} {:db/id "question-03ebca0d-b111-51a4-8281-85b0168f9966" :question/id #uuid "03ebca0d-b111-51a4-8281-85b0168f9966" :question/math-academy-id "q-133016" :question/problem "Find the right-sided limit of $f(x)$ at $x=-2.$\n\n${lim}_{x\\to \\,-{2}^{+}}f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "Approaching from the right, we have $-2<x<-1,$ so we use the expression \n\n$$\nf(x)=\\frac{{x}^{2}-1}{x+1}.\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-{2}^{+}}f(x) & ={lim}_{x\\to \\,-{2}^{+}}\\frac{{x}^{2}-1}{x+1} \\\\  & =\\frac{(-2)^{2}-1}{-2+1} \\\\  & =\\frac{3}{-1} \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-52ef212c-d780-5d6b-9568-24925b4fb51e"] :db/ensure [:question/validate]} {:db/id "answer-field-52ef212c-d780-5d6b-9568-24925b4fb51e" :answer-field/id #uuid "52ef212c-d780-5d6b-9568-24925b4fb51e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f171767d-97fc-5130-814c-eb1b5c08256c" :answer-field/choices ["answer-f171767d-97fc-5130-814c-eb1b5c08256c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f171767d-97fc-5130-814c-eb1b5c08256c" :answer/id #uuid "f171767d-97fc-5130-814c-eb1b5c08256c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id 17592186119937 :knowledge-point/questions ["question-0922b64e-eb7a-5dde-9dd1-94e76b652889"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0922b64e-eb7a-5dde-9dd1-94e76b652889" :question/id #uuid "0922b64e-eb7a-5dde-9dd1-94e76b652889" :question/math-academy-id "q-133017" :question/problem "Evaluate ${lim}_{x\\to -1}f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to -1}f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n{lim}_{x\\to \\,-1}\\frac{{x}^{2}-1}{x+1}=\\frac{(-1)^{2}-1}{-1+1}=\\frac{0}{0}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-1}{x+1} & =\\frac{(x+1)(x-1)}{x+1} \\\\  & =\\frac{\\cancel{(x+1)}(x-1)}{\\cancel{x+1}} \\\\  & =x-1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,-1}f(x) & ={lim}_{x\\to \\,-1}\\frac{{x}^{2}-1}{x+1} \\\\  & ={lim}_{x\\to \\,-1}(x-1) \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f3a6d1ef-faa6-53ff-8a34-359343416058"] :db/ensure [:question/validate]} {:db/id "answer-field-f3a6d1ef-faa6-53ff-8a34-359343416058" :answer-field/id #uuid "f3a6d1ef-faa6-53ff-8a34-359343416058" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-27999e64-0536-50d5-af50-89cd6f7eb347" :answer-field/choices ["answer-27999e64-0536-50d5-af50-89cd6f7eb347"] :db/ensure [:answer-field/validate]} {:db/id "answer-27999e64-0536-50d5-af50-89cd6f7eb347" :answer/id #uuid "27999e64-0536-50d5-af50-89cd6f7eb347" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186100803 :knowledge-point/questions ["question-af82e941-ed72-5bda-8079-22f3d0e5359a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-af82e941-ed72-5bda-8079-22f3d0e5359a" :question/id #uuid "af82e941-ed72-5bda-8079-22f3d0e5359a" :question/math-academy-id "q-133018" :question/problem "Given that the function $f(x)$ is continuous at $x=-1,$ what is the value of $b?$\n\n$b\\,=\\,$\n{{field-1}}" :question/worked-solution "Previously, we found that\n\n$$\n{lim}_{x\\to \\,-1}f(x)=-2.\n$$\n\nFor $f(x)$ to be continuous at $x=-1,$ we must have\n\n$$\n\\begin{aligned}f(-1) & ={lim}_{x\\to \\,-1}f(x) \\\\ 2b & =-2 \\\\ b & =-1\\end{aligned}\n$$\n\nTherefore, for the function to be continuous at $x=-1,$ we need $b=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b39b90ad-7d77-5333-a15e-740deb119d51"] :db/ensure [:question/validate]} {:db/id "answer-field-b39b90ad-7d77-5333-a15e-740deb119d51" :answer-field/id #uuid "b39b90ad-7d77-5333-a15e-740deb119d51" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-96da5d65-9510-57fc-97ad-17fccf48bdcc" :answer-field/choices ["answer-96da5d65-9510-57fc-97ad-17fccf48bdcc"] :db/ensure [:answer-field/validate]} {:db/id "answer-96da5d65-9510-57fc-97ad-17fccf48bdcc" :answer/id #uuid "96da5d65-9510-57fc-97ad-17fccf48bdcc" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186124662 :knowledge-point/questions ["question-68787380-f6be-5299-8d7e-90d33587bc3b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-68787380-f6be-5299-8d7e-90d33587bc3b" :question/id #uuid "68787380-f6be-5299-8d7e-90d33587bc3b" :question/math-academy-id "q-133019" :question/problem "Evaluate ${lim}_{x\\to \\infty }f(x).$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\infty }f(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "First, as $x\\to \\infty ,$ we can assume that $x>-1.$ So, we use the following expression for $f(x):$\n\n$$\nf(x)=\\frac{{x}^{2}-1}{x+1}\n$$\n\nNow, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is $x.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can evaluate the resulting expression:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}-1}{x+1} & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{2}}{x}-\\frac{1}{x})}{(\\frac{x}{x}+\\frac{1}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(x-\\frac{1}{x})}{(1+\\frac{1}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{x-0}{1+0} \\\\  & ={lim}_{x\\to \\infty }x \\\\  & =\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d0041f63-d78b-5da5-99c4-ad55d0e109f1"] :db/ensure [:question/validate]} {:db/id "answer-field-d0041f63-d78b-5da5-99c4-ad55d0e109f1" :answer-field/id #uuid "d0041f63-d78b-5da5-99c4-ad55d0e109f1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a0fc3bc0-4495-5062-ae38-1bffc23ec0e7" :answer-field/choices ["answer-a0fc3bc0-4495-5062-ae38-1bffc23ec0e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-a0fc3bc0-4495-5062-ae38-1bffc23ec0e7" :answer/id #uuid "a0fc3bc0-4495-5062-ae38-1bffc23ec0e7" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id 17592186133955 :knowledge-point/questions ["question-f39faa87-98f1-5160-9f77-61fba20bbf35"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f39faa87-98f1-5160-9f77-61fba20bbf35" :question/id #uuid "f39faa87-98f1-5160-9f77-61fba20bbf35" :question/math-academy-id "q-133020" :question/problem "Let $a=-\\frac{4}{5}.$ For what values of $k$ does the intermediate value theorem guarantee that $f(x)=k$ has a solution on the interval $x\\in [-5,-4]?$\n\n$k\\,\\in \\,[$\n{{field-1}}\n$,\\,$\n{{field-2}}\n$]$" :question/worked-solution "In part 2, we found that the function $f(x)$ is continuous on $[-5,-4]$ when $a=-\\frac{4}{5}.$ \n\nTherefore, the intermediate value theorem guarantees that $f(x)=k$ has a solution for each value of $k$ between $f(-5)$ and $f(-4).$\n\nSince \n\n$$\n\\begin{aligned}f(-5) & =(-5)^{2}+3(-5) \\\\  & =25-15 \\\\  & =10\\end{aligned}\n$$\n\nand \n\n$$\nf(-4)=-5\\cdot (-\\frac{4}{5})=4,\n$$\n\nwe must have \n\n$$\nk\\in [4,10].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5081ce70-78db-5736-8383-df428ff21f68" "answer-field-309df97e-fe05-56dc-8a9c-33f5a7cc5b96"] :db/ensure [:question/validate]} {:db/id "answer-field-5081ce70-78db-5736-8383-df428ff21f68" :answer-field/id #uuid "5081ce70-78db-5736-8383-df428ff21f68" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer-field/choices ["answer-1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer/id #uuid "1f5b811f-6d2c-50c9-a9f1-7afe2b2f75a6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-309df97e-fe05-56dc-8a9c-33f5a7cc5b96" :answer-field/id #uuid "309df97e-fe05-56dc-8a9c-33f5a7cc5b96" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-08b0f249-4156-5456-83fc-ea5f028e4459" :answer-field/choices ["answer-08b0f249-4156-5456-83fc-ea5f028e4459"] :db/ensure [:answer-field/validate]} {:db/id "answer-08b0f249-4156-5456-83fc-ea5f028e4459" :answer/id #uuid "08b0f249-4156-5456-83fc-ea5f028e4459" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id 17592186115382 :knowledge-point/questions ["question-f2a0bc3d-d9da-5c57-bc24-c5c37731d915"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f2a0bc3d-d9da-5c57-bc24-c5c37731d915" :question/id #uuid "f2a0bc3d-d9da-5c57-bc24-c5c37731d915" :question/math-academy-id "q-133021" :question/problem "![](images/8f/8fdadf35d95d884dc3b8445e24525094f830e43190eb3d1a960bbb72eb489b9e.png)\n\nThe graph of $y=f(x)$ for $a=-\\frac{4}{5}$ and $b=-1$ is depicted above.\n\nFrom the graph, the function is continuous but not differentiable at $x\\,=$\n{{field-1}}" :question/worked-solution "A function is not differentiable wherever it has a discontinuity, corner, cusp, or vertical tangent.\n\n* At $x=-4$ the function has a corner point, so it's not differentiable there.\n\n* At $x=-2$ the function has a jump discontinuity, so it's not differentiable there.\n\nOf these two points, $f(x)$ is continuous only at $x=-4.$\n\nTherefore, the function $f(x)$ is continuous but not differentiable at $x=-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-08000212-c184-5a8a-8664-9c25bb3f78b8"] :db/ensure [:question/validate]} {:db/id "answer-field-08000212-c184-5a8a-8664-9c25bb3f78b8" :answer-field/id #uuid "08000212-c184-5a8a-8664-9c25bb3f78b8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-503f0033-51ba-519e-adbf-5435e315039b" :answer-field/choices ["answer-503f0033-51ba-519e-adbf-5435e315039b"] :db/ensure [:answer-field/validate]} {:db/id "answer-503f0033-51ba-519e-adbf-5435e315039b" :answer/id #uuid "503f0033-51ba-519e-adbf-5435e315039b" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id 17592186175902 :knowledge-point/questions ["question-1d096d37-4b97-520b-934c-34762c2b679b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1d096d37-4b97-520b-934c-34762c2b679b" :question/id #uuid "1d096d37-4b97-520b-934c-34762c2b679b" :question/math-academy-id "q-133022" :question/problem "Assume once again that $a=-\\frac{4}{5}$ and $b=-1,$ as in the previous part. Find the smallest **integer** value of $h$ such that the extreme value theorem is applicable to $f(x)$ on the interval $[h,3].$\n\n$h\\,=$\n{{field-1}}" :question/worked-solution "The extreme value theorem states the following:\n\n> *If $f(x)$ is a continuous function defined on the closed interval $[a,b],$ then $f(x)$ always has at least one global maximum and one global minimum on $[a,b]$*.\n\nSo, the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nThe smallest possible integer $h$ such that $f(x)$ is continuous on $[h,3]$ is $h=-1,$ as shown below.\n\n![](images/ab/ab92ed0c59facac4fccb050734aba133474c8a0585c6bd981abe7ea05ed0e6be.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-61182370-7c34-5d40-a704-11538eab0a52"] :db/ensure [:question/validate]} {:db/id "answer-field-61182370-7c34-5d40-a704-11538eab0a52" :answer-field/id #uuid "61182370-7c34-5d40-a704-11538eab0a52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e075fff3-995b-5bc1-990f-ddaeac4db283" :answer-field/choices ["answer-e075fff3-995b-5bc1-990f-ddaeac4db283"] :db/ensure [:answer-field/validate]} {:db/id "answer-e075fff3-995b-5bc1-990f-ddaeac4db283" :answer/id #uuid "e075fff3-995b-5bc1-990f-ddaeac4db283" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186078408 :knowledge-point/questions ["question-33443770-e725-52a7-8dbb-99ea791df2cb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-33443770-e725-52a7-8dbb-99ea791df2cb" :question/id #uuid "33443770-e725-52a7-8dbb-99ea791df2cb" :question/math-academy-id "q-133023" :question/problem "Given that $f(x)={x}^{2}+3x$ for $x<-4,$ compute the value of ${lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}.$ If the limit does not exist, write \"DNE\" (without the quotation marks).\n\n${lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}\\,=$\n{{field-1}}" :question/worked-solution "First, comparing\n\n$$\n{lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}\n$$\n\nwith the formula for the instantaneous rate of change,\n\n$$\n{f}^{′}(a)={lim}_{x\\to \\,a}\\frac{f(x)-f(a)}{x-a},\n$$\n\nwe see that\n\n$$\n{lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}={f}^{′}(-5).\n$$\n\nNow, computing the derivative of $f$ for $x<-1,$ we have \n\n$$\n{f}^{′}(x)=2x+3,\n$$\n\nand therefore,\n\n$$\n{f}^{′}(-5)=2(-5)+3=-7.\n$$\n\nTherefore, we conclude that \n\n$$\n{lim}_{x\\to \\,-5}\\frac{f(x)-f(-5)}{x-(-5)}=-7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f655fa57-5080-53ed-ba58-e3495bc76cad"] :db/ensure [:question/validate]} {:db/id "answer-field-f655fa57-5080-53ed-ba58-e3495bc76cad" :answer-field/id #uuid "f655fa57-5080-53ed-ba58-e3495bc76cad" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-23d994be-8e53-5a61-8d62-8efbab138e45" :answer-field/choices ["answer-23d994be-8e53-5a61-8d62-8efbab138e45"] :db/ensure [:answer-field/validate]} {:db/id "answer-23d994be-8e53-5a61-8d62-8efbab138e45" :answer/id #uuid "23d994be-8e53-5a61-8d62-8efbab138e45" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "multistep-2fbdaa1b-228d-5d0a-abc0-029400c0909b" :multistep/id #uuid "2fbdaa1b-228d-5d0a-abc0-029400c0909b" :multistep/context "Let $f(x)$ be the piecewise function defined below, where $a$ and $b$ are constants. \n\n$$\nf(x)=\\{\\begin{aligned}{x}^{2}+3x, & \\,x\\in (-\\infty ,-4) \\\\ -5a, & \\,x\\in [-4,-2] \\\\ \\frac{{x}^{2}-1}{x+1} & \\,x\\in (-2,-1)\\cup (-1,\\infty ) \\\\ 2b, & \\,x=-1\\end{aligned}\n$$" :multistep/steps ["step-b3a4187b-8722-5579-ab54-d378e87a96e8" "step-e2cf5b30-bc2b-5b24-8635-d5b5d78d497c" "step-afd9c16d-e69b-5748-b12d-5ab58bfb6e79" "step-49b44d85-918f-562c-b6da-f7c6722a4acc" "step-6b6f6769-fd0a-563d-b7ee-ff6c541740f0" "step-76bea9a4-8b56-505b-b7d4-a9711e1eacf6" "step-26c63ef3-59a9-517f-a9a3-f135c76d28a6" "step-ce3e298f-7e34-5b4b-80b9-d7363682990d" "step-3914e941-d414-53f7-bd53-d98c12fd4802" "step-5f50cf59-40f9-5116-a336-b10e4608e318"] :multistep/first-step "step-b3a4187b-8722-5579-ab54-d378e87a96e8" :db/ensure [:multistep/validate]} {:db/id "step-b3a4187b-8722-5579-ab54-d378e87a96e8" :step/id #uuid "b3a4187b-8722-5579-ab54-d378e87a96e8" :step/content "question-e3a057d6-ea56-5dc0-9a37-b812d961c933" :step/next "step-e2cf5b30-bc2b-5b24-8635-d5b5d78d497c" :db/ensure [:step/validate]} {:db/id "step-e2cf5b30-bc2b-5b24-8635-d5b5d78d497c" :step/id #uuid "e2cf5b30-bc2b-5b24-8635-d5b5d78d497c" :step/content "question-9a484d05-16dc-5a62-96c8-679e46043371" :step/next "step-afd9c16d-e69b-5748-b12d-5ab58bfb6e79" :db/ensure [:step/validate]} {:db/id "step-afd9c16d-e69b-5748-b12d-5ab58bfb6e79" :step/id #uuid "afd9c16d-e69b-5748-b12d-5ab58bfb6e79" :step/content "question-03ebca0d-b111-51a4-8281-85b0168f9966" :step/next "step-49b44d85-918f-562c-b6da-f7c6722a4acc" :db/ensure [:step/validate]} {:db/id "step-49b44d85-918f-562c-b6da-f7c6722a4acc" :step/id #uuid "49b44d85-918f-562c-b6da-f7c6722a4acc" :step/content "question-0922b64e-eb7a-5dde-9dd1-94e76b652889" :step/next "step-6b6f6769-fd0a-563d-b7ee-ff6c541740f0" :db/ensure [:step/validate]} {:db/id "step-6b6f6769-fd0a-563d-b7ee-ff6c541740f0" :step/id #uuid "6b6f6769-fd0a-563d-b7ee-ff6c541740f0" :step/content "question-af82e941-ed72-5bda-8079-22f3d0e5359a" :step/next "step-76bea9a4-8b56-505b-b7d4-a9711e1eacf6" :db/ensure [:step/validate]} {:db/id "step-76bea9a4-8b56-505b-b7d4-a9711e1eacf6" :step/id #uuid "76bea9a4-8b56-505b-b7d4-a9711e1eacf6" :step/content "question-68787380-f6be-5299-8d7e-90d33587bc3b" :step/next "step-26c63ef3-59a9-517f-a9a3-f135c76d28a6" :db/ensure [:step/validate]} {:db/id "step-26c63ef3-59a9-517f-a9a3-f135c76d28a6" :step/id #uuid "26c63ef3-59a9-517f-a9a3-f135c76d28a6" :step/content "question-f39faa87-98f1-5160-9f77-61fba20bbf35" :step/next "step-ce3e298f-7e34-5b4b-80b9-d7363682990d" :db/ensure [:step/validate]} {:db/id "step-ce3e298f-7e34-5b4b-80b9-d7363682990d" :step/id #uuid "ce3e298f-7e34-5b4b-80b9-d7363682990d" :step/content "question-f2a0bc3d-d9da-5c57-bc24-c5c37731d915" :step/next "step-3914e941-d414-53f7-bd53-d98c12fd4802" :db/ensure [:step/validate]} {:db/id "step-3914e941-d414-53f7-bd53-d98c12fd4802" :step/id #uuid "3914e941-d414-53f7-bd53-d98c12fd4802" :step/content "question-1d096d37-4b97-520b-934c-34762c2b679b" :step/next "step-5f50cf59-40f9-5116-a336-b10e4608e318" :db/ensure [:step/validate]} {:db/id "step-5f50cf59-40f9-5116-a336-b10e4608e318" :step/id #uuid "5f50cf59-40f9-5116-a336-b10e4608e318" :step/content "question-33443770-e725-52a7-8dbb-99ea791df2cb" :db/ensure [:step/validate]} {:db/id "assigned-problem-18dbf1ce-a447-5af5-bed8-35e9baf14494" :assigned-problem/id #uuid "18dbf1ce-a447-5af5-bed8-35e9baf14494" :assigned-problem/content "multistep-2fbdaa1b-228d-5d0a-abc0-029400c0909b" :assigned-problem/topic-coverage [17592186049637 17592186049806 17592186049040 17592186049927 17592186049825 17592186050004 17592186050810 17592186048420 17592186048748 17592186050643] :db/ensure [:assigned-problem/validate]} {:db/id "activity-2a1583bd-6e8e-5387-9643-7ea2f7fe72df" :activity/id #uuid "2a1583bd-6e8e-5387-9643-7ea2f7fe72df" :activity/title "Continuity, Discontinuities, and Differentiability" :activity/type :activity.type/assignment :activity/steps ["step-25ac6782-945e-50dc-8d94-bde045860457"] :activity/first-step "step-25ac6782-945e-50dc-8d94-bde045860457" :db/ensure [:activity/validate]} {:db/id "step-25ac6782-945e-50dc-8d94-bde045860457" :step/id #uuid "25ac6782-945e-50dc-8d94-bde045860457" :step/content "assigned-problem-18dbf1ce-a447-5af5-bed8-35e9baf14494" :db/ensure [:step/validate]} {:db/id 17592186059690 :knowledge-point/questions ["question-ec2edb0f-56e4-5a19-b81c-24c586e6f17f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ec2edb0f-56e4-5a19-b81c-24c586e6f17f" :question/id #uuid "ec2edb0f-56e4-5a19-b81c-24c586e6f17f" :question/math-academy-id "q-1484" :question/problem "Simplify the statement $(Q⇒P)⇒R.$" :question/worked-solution "First, note that\n\n$$\n\\begin{aligned}(Q⇒P)⇒R & ≡(¬Q∨P)⇒R \\\\  & ≡¬(¬Q∨P)∨R.\\end{aligned}\n$$\n\nWe can distribute the negation over the disjunction using De Morgan's law:\n\n$$\n¬(¬Q∨P)∨R≡(¬(¬Q)∧¬P)∨R\n$$\n\nCanceling out double negations, we reach\n\n$$\n(¬(¬Q)∧¬P)∨R≡(Q∧¬P)∨R.\n$$\n\nSo the given statement is equivalent to $(Q∧¬P)∨R.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7f521fe5-d3b7-5494-8542-5d8326f7c090"] :db/ensure [:question/validate]} {:db/id "answer-field-7f521fe5-d3b7-5494-8542-5d8326f7c090" :answer-field/id #uuid "7f521fe5-d3b7-5494-8542-5d8326f7c090" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-175de8f6-fada-58f2-9f0c-a6d1bb8cf449" :answer-field/choices ["answer-07d69888-432c-5bfb-a712-e29b248abe25" "answer-175de8f6-fada-58f2-9f0c-a6d1bb8cf449" "answer-882439eb-c2d0-5721-8c0c-b7d1eae8b316" "answer-a11193ee-f395-54ff-ad79-15e460abac8e" "answer-08c688ff-ba7c-5331-8a9b-c9a3767ff80b"] :db/ensure [:answer-field/validate]} {:db/id "answer-07d69888-432c-5bfb-a712-e29b248abe25" :answer/id #uuid "07d69888-432c-5bfb-a712-e29b248abe25" :answer/type :answer.type/math :answer/value "(Q∧¬P)∧R" :db/ensure [:answer/validate]} {:db/id "answer-175de8f6-fada-58f2-9f0c-a6d1bb8cf449" :answer/id #uuid "175de8f6-fada-58f2-9f0c-a6d1bb8cf449" :answer/type :answer.type/math :answer/value "(Q∧¬P)∨R" :db/ensure [:answer/validate]} {:db/id "answer-882439eb-c2d0-5721-8c0c-b7d1eae8b316" :answer/id #uuid "882439eb-c2d0-5721-8c0c-b7d1eae8b316" :answer/type :answer.type/math :answer/value "(Q∨¬P)∧R" :db/ensure [:answer/validate]} {:db/id "answer-a11193ee-f395-54ff-ad79-15e460abac8e" :answer/id #uuid "a11193ee-f395-54ff-ad79-15e460abac8e" :answer/type :answer.type/math :answer/value "(¬Q∧¬P)∨R" :db/ensure [:answer/validate]} {:db/id "answer-08c688ff-ba7c-5331-8a9b-c9a3767ff80b" :answer/id #uuid "08c688ff-ba7c-5331-8a9b-c9a3767ff80b" :answer/type :answer.type/math :answer/value "(¬Q∨¬P)∨R" :db/ensure [:answer/validate]} {:db/id 17592186059689 :knowledge-point/questions ["question-d4080d1e-e850-5931-bd84-ee951a1d7967"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d4080d1e-e850-5931-bd84-ee951a1d7967" :question/id #uuid "d4080d1e-e850-5931-bd84-ee951a1d7967" :question/math-academy-id "q-182495" :question/problem "Simplify the statement $¬(¬R⇒S).$" :question/worked-solution "The conditional statement $P⇒Q$ is logically equivalent to the disjunction $¬P∨Q:$\n\nSo, in this case, we have the following equivalence:\n\n$$\n¬(¬R⇒S)≡¬(¬(¬R)∨S)\n$$\n\nCanceling out double negation, we have\n\n$$\n¬(¬(¬R)∨S)≡¬(R∨S).\n$$\n\nDistributing the negation over the disjunction using De Morgan's law, we reach\n\n$$\n¬(R∨S)≡¬R∧¬S.\n$$\n\nSo the given statement is equivalent to $¬R∧¬S.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6162e53b-5fec-54de-8f66-17e9b0f8dd66"] :db/ensure [:question/validate]} {:db/id "answer-field-6162e53b-5fec-54de-8f66-17e9b0f8dd66" :answer-field/id #uuid "6162e53b-5fec-54de-8f66-17e9b0f8dd66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b875f28-45da-5639-838c-d299811bcdbc" :answer-field/choices ["answer-a28b28ee-6b1f-5192-ac45-00c37ca98320" "answer-4bc45034-94e0-5586-a3db-a015bd16db0a" "answer-395982bc-f79b-55a2-bcf7-e5b8d3825ce5" "answer-4b875f28-45da-5639-838c-d299811bcdbc" "answer-813127e8-cce0-5647-ba98-5e64b80842da"] :db/ensure [:answer-field/validate]} {:db/id "answer-a28b28ee-6b1f-5192-ac45-00c37ca98320" :answer/id #uuid "a28b28ee-6b1f-5192-ac45-00c37ca98320" :answer/type :answer.type/math :answer/value "R∨S" :db/ensure [:answer/validate]} {:db/id "answer-4bc45034-94e0-5586-a3db-a015bd16db0a" :answer/id #uuid "4bc45034-94e0-5586-a3db-a015bd16db0a" :answer/type :answer.type/math :answer/value "R∨¬S" :db/ensure [:answer/validate]} {:db/id "answer-395982bc-f79b-55a2-bcf7-e5b8d3825ce5" :answer/id #uuid "395982bc-f79b-55a2-bcf7-e5b8d3825ce5" :answer/type :answer.type/math :answer/value "¬R∧S" :db/ensure [:answer/validate]} {:db/id "answer-4b875f28-45da-5639-838c-d299811bcdbc" :answer/id #uuid "4b875f28-45da-5639-838c-d299811bcdbc" :answer/type :answer.type/math :answer/value "¬R∧¬S" :db/ensure [:answer/validate]} {:db/id "answer-813127e8-cce0-5647-ba98-5e64b80842da" :answer/id #uuid "813127e8-cce0-5647-ba98-5e64b80842da" :answer/type :answer.type/math :answer/value "¬R∨¬S" :db/ensure [:answer/validate]} {:db/id "question-e24afd3b-3cd1-54ee-83ee-26ca9c096040" :question/id #uuid "e24afd3b-3cd1-54ee-83ee-26ca9c096040" :question/math-academy-id "q-182598" :question/problem "$\\,$ Either you do not get enough sleep, or you will be alert the next day.\n\nWhich conditional statement is logically equivalent to the disjunctive statement above?" :question/worked-solution "Let's denote by $A$ and $B$ the following statements:\n\n- $A:$ You do not get enough sleep.\n\n- $B:$ You will be alert the next day.\n\nThen, our initial statement can be written as $A∨B,$ which is logically equivalent to \n\n$$\n¬A⇒B.\n$$\n\nThe negation of $A$ can be written as\n\n- $¬A:$ You get enough sleep.\n\nTherefore, the given statement is logically equivalent to the following:\n\n$\\,$ If you get enough sleep, then you will be alert the next day.\n\nWe can write this in more everyday language as follows:\n\n$\\,$ If you get enough sleep, you will be alert the next day.\n\n**Note**: \n\nUsing the word \"Either\" helps clarify that the sentence structure presents two alternatives and is particularly useful when employing the disjunctive form $(¬P∨Q)$ in conversational or formal English. So, the phrase effectively conveys that one of the two stated conditions will hold true." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-af5a451e-f08e-5116-8e83-974cfab1e7ad"] :db/ensure [:question/validate]} {:db/id "answer-field-af5a451e-f08e-5116-8e83-974cfab1e7ad" :answer-field/id #uuid "af5a451e-f08e-5116-8e83-974cfab1e7ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37c0d750-a504-554d-9af7-5d196dcd1f7b" :answer-field/choices ["answer-74deb0e6-4a6b-537f-84cb-6eb03f3d97bd" "answer-07787d1c-e983-5e3a-9efd-7d51b93c7d0f" "answer-25b3adf9-102f-5dec-87e1-3682d7ef7ad1" "answer-37c0d750-a504-554d-9af7-5d196dcd1f7b" "answer-20c41708-7e4a-50b6-b570-ad244db5adbb"] :db/ensure [:answer-field/validate]} {:db/id "answer-74deb0e6-4a6b-537f-84cb-6eb03f3d97bd" :answer/id #uuid "74deb0e6-4a6b-537f-84cb-6eb03f3d97bd" :answer/type :answer.type/text :answer/value "Get enough sleep, and you will be alert the next day." :db/ensure [:answer/validate]} {:db/id "answer-07787d1c-e983-5e3a-9efd-7d51b93c7d0f" :answer/id #uuid "07787d1c-e983-5e3a-9efd-7d51b93c7d0f" :answer/type :answer.type/text :answer/value "If you don't get enough sleep, you will be alert the next day." :db/ensure [:answer/validate]} {:db/id "answer-25b3adf9-102f-5dec-87e1-3682d7ef7ad1" :answer/id #uuid "25b3adf9-102f-5dec-87e1-3682d7ef7ad1" :answer/type :answer.type/text :answer/value "If you don't get enough sleep, you won't be alert the next day." :db/ensure [:answer/validate]} {:db/id "answer-37c0d750-a504-554d-9af7-5d196dcd1f7b" :answer/id #uuid "37c0d750-a504-554d-9af7-5d196dcd1f7b" :answer/type :answer.type/text :answer/value "If you get enough sleep, you will be alert the next day." :db/ensure [:answer/validate]} {:db/id "answer-20c41708-7e4a-50b6-b570-ad244db5adbb" :answer/id #uuid "20c41708-7e4a-50b6-b570-ad244db5adbb" :answer/type :answer.type/text :answer/value "If you get enough sleep, you won't be alert the next day." :db/ensure [:answer/validate]} {:db/id "activity-85ade399-3172-5f11-94ba-4d0b307203fb" :activity/id #uuid "85ade399-3172-5f11-94ba-4d0b307203fb" :activity/title "Logical Equivalence with Conditional Statements" :activity/type :activity.type/review :activity/scope 17592186049805 :activity/course 17592186046658 :activity/steps ["step-0450a032-0f52-5ba5-abe8-82e9866f5d76" "step-d6460e76-4f3f-5bce-8f44-b84778fad95a" "step-d0d1190b-b886-5957-a70e-937f4c9f20bb" "step-d2245027-bde6-5a7e-a4aa-e79ea31750ed" "step-623df059-54b2-5e71-bdb3-85aed237cbf8"] :activity/first-step "step-0450a032-0f52-5ba5-abe8-82e9866f5d76" :db/ensure [:activity/validate]} {:db/id "step-0450a032-0f52-5ba5-abe8-82e9866f5d76" :step/id #uuid "0450a032-0f52-5ba5-abe8-82e9866f5d76" :step/content "question-ec2edb0f-56e4-5a19-b81c-24c586e6f17f" :step/next "step-d6460e76-4f3f-5bce-8f44-b84778fad95a" :db/ensure [:step/validate]} {:db/id "step-d6460e76-4f3f-5bce-8f44-b84778fad95a" :step/id #uuid "d6460e76-4f3f-5bce-8f44-b84778fad95a" :step/content 17592186379154 :step/next "step-d0d1190b-b886-5957-a70e-937f4c9f20bb" :db/ensure [:step/validate]} {:db/id "step-d0d1190b-b886-5957-a70e-937f4c9f20bb" :step/id #uuid "d0d1190b-b886-5957-a70e-937f4c9f20bb" :step/content "question-d4080d1e-e850-5931-bd84-ee951a1d7967" :step/next "step-d2245027-bde6-5a7e-a4aa-e79ea31750ed" :db/ensure [:step/validate]} {:db/id "step-d2245027-bde6-5a7e-a4aa-e79ea31750ed" :step/id #uuid "d2245027-bde6-5a7e-a4aa-e79ea31750ed" :step/content 17592186379174 :step/next "step-623df059-54b2-5e71-bdb3-85aed237cbf8" :db/ensure [:step/validate]} {:db/id "step-623df059-54b2-5e71-bdb3-85aed237cbf8" :step/id #uuid "623df059-54b2-5e71-bdb3-85aed237cbf8" :step/content "question-e24afd3b-3cd1-54ee-83ee-26ca9c096040" :db/ensure [:step/validate]} [:db/retract 17592186086214 :answer-field/choices 17592186086215] [:db/retract 17592186086214 :answer-field/choices 17592186086216] [:db/retract 17592186086214 :answer-field/choices 17592186086217] [:db/retract 17592186086214 :answer-field/choices 17592186086218] [:db/retract 17592186086214 :answer-field/choices 17592186086219] {:db/id 17592186087684 :knowledge-point/questions ["question-a4f69e59-b897-52a3-98ba-7aff5af1aea8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087492 :question/worked-solution "The natural logarithm of $a$ is defined as follows:\n\n$\\ln{a} = x$ is equivalent to $a = e^x$\n\nIf we compare $\\ln{3} \\approx 1.1$ with $\\ln{a} = x,$ we get $a = 3$ and $x = 1.1.$\n\nTherefore, the approximation $\\ln{3} \\approx 1.1$ is equivalent to \n\n$$\ne^{1.1} \\approx 3 .\n$$" :db/ensure [:question/validate]} {:db/id 17592186087685 :knowledge-point/questions ["question-28b3be5c-4b6d-5163-b2d6-7be50f206805" "question-22c1a58e-7bf8-52c0-be52-879e9dd8226f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087493 :question/problem "Evaluate $\\ln\\left( e^{6}\\right).$" :question/worked-solution "The natural logarithm of a power of $e$ is the power itself:\n\n$$\n\\ln(e^x) = x\n$$\n\nIn our case, we have $x = 6.$ Therefore,\n\n$$\n\\ln\\left( e^{6}\\right) = 6.\n$$" :db/ensure [:question/validate]} {:db/id 17592186087692 :knowledge-point/questions ["question-2f25e707-eeb9-5b06-994f-863f6b76503d" "question-bc51ccb0-0438-5418-a3d9-157e172ac1ec" "question-3ea37247-24cf-5fab-829f-0e5fcfa54afc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087497 :question/problem "Evaluate $\\ln\\left(\\dfrac{1}{e^{3}}\\right).$" :question/worked-solution "First, we rewrite $\\dfrac{1}{e^3}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\dfrac{1}{e^3} = e^{-3}\n$$\n\nTherefore, we have\n\n$$\n\\ln\\left( \\dfrac{1}{e^3} \\right) = \\ln \\left( e^{-3} \\right).\n$$\n\nThe natural logarithm of a power of $e$ is the power itself:\n\n$$\n\\ln(e^x) = x\n$$\n\nIn our case, we have $x = -3.$ Therefore,\n\n$$\n\\ln\\left( e^{-3}\\right) = - 3.\n$$" :db/ensure [:question/validate]} {:db/id 17592186087683 :knowledge-point/questions ["question-14cade25-332f-551b-a745-e0cec33e151b" "question-00510ebe-a387-562e-98da-516fa9a673e0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087491 :question/problem "Rounded to $2$ decimal places, what is the value of $\\dfrac{4}{\\ln(2)}?$" :question/worked-solution "We compute the required expression to $2$ decimal places using a calculator, rounding the intermediate steps to $5$ decimal places to avoid rounding error. This gives\n\n$$\n\\begin{aligned}\\frac{4}{\\operatorname{ln}⁡(2)} & ≈\\frac{4}{0.693\\,15} \\\\  & ≈5.770\\,76 \\\\  & ≈5.77.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-a4f69e59-b897-52a3-98ba-7aff5af1aea8" :question/id #uuid "a4f69e59-b897-52a3-98ba-7aff5af1aea8" :question/math-academy-id "q-66795" :question/problem "$\\sqrt[3]{e\\,}≈1.396$ can be expressed as" :question/worked-solution "Notice that the given approximation can be written using exponents as:\n\n$$\n{e}^{1/3}≈1.396\n$$\n\nThe natural logarithm of $a$ is defined as follows:\n\n$a={e}^{x}$ is equivalent to $\\operatorname{ln}⁡a=x$ \n\nIf we compare ${e}^{1/3}≈1.396$ with $a={e}^{x},$ we get $a=1.396$ and $x=\\frac{1}{3}.$ \n\nTherefore, the approximation $\\sqrt[3]{e}≈1.396$ can be expressed as $\\operatorname{ln}⁡(1.396)≈\\frac{1}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-708eb122-281a-5b43-a058-af1d0d941515"] :db/ensure [:question/validate]} {:db/id "answer-field-708eb122-281a-5b43-a058-af1d0d941515" :answer-field/id #uuid "708eb122-281a-5b43-a058-af1d0d941515" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b8e73407-0a7d-5e1d-8940-4d6ee32ff32f" :answer-field/choices ["answer-26c039d9-87aa-526c-a55c-208378039a5c" "answer-df934311-2eb7-572b-8a5a-b3a81c09582c" "answer-b8e73407-0a7d-5e1d-8940-4d6ee32ff32f" "answer-346a8fc2-d3b0-571b-a007-db66c0150840" "answer-91e7cc32-5524-5aa5-b94e-b02b1193a809"] :db/ensure [:answer-field/validate]} {:db/id "answer-26c039d9-87aa-526c-a55c-208378039a5c" :answer/id #uuid "26c039d9-87aa-526c-a55c-208378039a5c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1.396)≈-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-df934311-2eb7-572b-8a5a-b3a81c09582c" :answer/id #uuid "df934311-2eb7-572b-8a5a-b3a81c09582c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1.396)≈3" :db/ensure [:answer/validate]} {:db/id "answer-b8e73407-0a7d-5e1d-8940-4d6ee32ff32f" :answer/id #uuid "b8e73407-0a7d-5e1d-8940-4d6ee32ff32f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1.396)≈\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-346a8fc2-d3b0-571b-a007-db66c0150840" :answer/id #uuid "346a8fc2-d3b0-571b-a007-db66c0150840" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1.396)≈{e}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-91e7cc32-5524-5aa5-b94e-b02b1193a809" :answer/id #uuid "91e7cc32-5524-5aa5-b94e-b02b1193a809" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3)≈1.396" :db/ensure [:answer/validate]} {:db/id 17592186088260 :question/problem "$\\operatorname{ln}⁡10≈2.303$ is equivalent to" :question/worked-solution "The natural logarithm of $a$ is defined as follows:\n\n$\\operatorname{ln}⁡a=x$ is equivalent to $a={e}^{x}$\n\nIf we compare $\\operatorname{ln}⁡10≈2.303$ with $\\operatorname{ln}⁡a=x,$ we get $a=10$ and $x=2.303.$\n\nTherefore, the approximation $\\operatorname{ln}⁡10≈2.303$ is equivalent to ${e}^{2.303}≈10.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186086214 :answer-field/correct "answer-e0fe25ed-98f8-5308-ad53-c2d8d1096a80" :answer-field/choices ["answer-c1a6e87d-b8a7-5425-b11c-3766e9cf23f9" "answer-ce5e2f46-1a69-5daa-9116-2e91ab14e61e" "answer-a4fd5701-f4cc-555a-bef1-0629f5c2d9ca" "answer-e0fe25ed-98f8-5308-ad53-c2d8d1096a80" "answer-b9a6409e-4dc7-5e73-a13e-93de08e37b5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1a6e87d-b8a7-5425-b11c-3766e9cf23f9" :answer/id #uuid "c1a6e87d-b8a7-5425-b11c-3766e9cf23f9" :answer/type :answer.type/math :answer/value "{10}^{2.303}≈e" :db/ensure [:answer/validate]} {:db/id "answer-ce5e2f46-1a69-5daa-9116-2e91ab14e61e" :answer/id #uuid "ce5e2f46-1a69-5daa-9116-2e91ab14e61e" :answer/type :answer.type/math :answer/value "{10}^{e}≈2.303" :db/ensure [:answer/validate]} {:db/id "answer-a4fd5701-f4cc-555a-bef1-0629f5c2d9ca" :answer/id #uuid "a4fd5701-f4cc-555a-bef1-0629f5c2d9ca" :answer/type :answer.type/math :answer/value "{e}^{-2.303}≈10" :db/ensure [:answer/validate]} {:db/id "answer-e0fe25ed-98f8-5308-ad53-c2d8d1096a80" :answer/id #uuid "e0fe25ed-98f8-5308-ad53-c2d8d1096a80" :answer/type :answer.type/math :answer/value "{e}^{2.303}≈10" :db/ensure [:answer/validate]} {:db/id "answer-b9a6409e-4dc7-5e73-a13e-93de08e37b5d" :answer/id #uuid "b9a6409e-4dc7-5e73-a13e-93de08e37b5d" :answer/type :answer.type/math :answer/value "{e}^{2.303}≈\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "question-28b3be5c-4b6d-5163-b2d6-7be50f206805" :question/id #uuid "28b3be5c-4b6d-5163-b2d6-7be50f206805" :question/math-academy-id "q-47240" :question/problem "Evaluate $\\operatorname{ln}⁡({e}^{2})+2\\operatorname{ln}⁡(e).$" :question/worked-solution "The natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn the first and second term, we have $x=2$ and $x=1,$ respectively. Therefore:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2})=2 \\\\ \\operatorname{ln}⁡(e)=1\\end{aligned}\n$$\n\nHence:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2})+2\\operatorname{ln}⁡(e)=2+2\\cdot 1=4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4c36275b-baef-5618-a583-b3b010acb944"] :db/ensure [:question/validate]} {:db/id "answer-field-4c36275b-baef-5618-a583-b3b010acb944" :answer-field/id #uuid "4c36275b-baef-5618-a583-b3b010acb944" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b1246c4c-16cc-51e2-a2c5-dbd123655551" :answer-field/choices ["answer-57695a31-2cfb-521d-95f1-18be8ce8e8f8" "answer-cc4d5038-b9db-5ce3-8d03-5b1a25e7e438" "answer-f5611f4e-0ff3-5233-94f4-1de6fcd819fb" "answer-1eff558a-3c38-5664-bb91-fb5a4851baf8" "answer-b1246c4c-16cc-51e2-a2c5-dbd123655551"] :db/ensure [:answer-field/validate]} {:db/id "answer-57695a31-2cfb-521d-95f1-18be8ce8e8f8" :answer/id #uuid "57695a31-2cfb-521d-95f1-18be8ce8e8f8" :answer/type :answer.type/math :answer/value "1+2e" :db/ensure [:answer/validate]} {:db/id "answer-cc4d5038-b9db-5ce3-8d03-5b1a25e7e438" :answer/id #u