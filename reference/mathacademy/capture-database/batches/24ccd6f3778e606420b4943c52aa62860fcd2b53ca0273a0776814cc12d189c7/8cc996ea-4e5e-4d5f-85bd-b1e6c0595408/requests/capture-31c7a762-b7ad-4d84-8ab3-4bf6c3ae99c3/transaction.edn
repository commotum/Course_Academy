nswer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-b9cec303-187f-59e6-ac54-f0569eb969eb" :answer/id #uuid "b9cec303-187f-59e6-ac54-f0569eb969eb" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-1d57c4f5-731f-52c0-bd31-88b2c6de7f43" :answer/id #uuid "1d57c4f5-731f-52c0-bd31-88b2c6de7f43" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5d4311e3-27f0-565f-a4f5-e008c3b19791" :answer/id #uuid "5d4311e3-27f0-565f-a4f5-e008c3b19791" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-8a29b1eb-d044-5ede-b5e7-20055b100181" :answer/id #uuid "8a29b1eb-d044-5ede-b5e7-20055b100181" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-2f25e707-eeb9-5b06-994f-863f6b76503d" :question/id #uuid "2f25e707-eeb9-5b06-994f-863f6b76503d" :question/math-academy-id "q-66856" :question/problem "$\\operatorname{ln}⁡(\\sqrt[3]{e})=$" :question/worked-solution "First, we rewrite $\\sqrt[3]{e}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\sqrt[3]{e}={e}^{1/3}\n$$\n\nTherefore, we have:\n\n$$\n\\operatorname{ln}⁡(\\sqrt[3]{e})=\\operatorname{ln}⁡({e}^{1/3})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=\\frac{1}{3}.$ Therefore:\n\n$$\n\\operatorname{ln}⁡({e}^{1/3})=\\frac{1}{3}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2f157eba-77b5-548d-a8fd-18ca5d8b5a99"] :db/ensure [:question/validate]} {:db/id "answer-field-2f157eba-77b5-548d-a8fd-18ca5d8b5a99" :answer-field/id #uuid "2f157eba-77b5-548d-a8fd-18ca5d8b5a99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec68ce0a-0a97-5e15-9517-25ed30b46d75" :answer-field/choices ["answer-de1dacf5-452c-5f6c-91e7-9cda5f87f798" "answer-9412c668-edd2-55fd-9399-7d6e1a2f8a6c" "answer-9d7cf7d9-c32d-5d59-8e1b-aecff778bbd8" "answer-ec68ce0a-0a97-5e15-9517-25ed30b46d75" "answer-9f84b452-29ef-5fed-8688-2d2cbe3460cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-de1dacf5-452c-5f6c-91e7-9cda5f87f798" :answer/id #uuid "de1dacf5-452c-5f6c-91e7-9cda5f87f798" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-9412c668-edd2-55fd-9399-7d6e1a2f8a6c" :answer/id #uuid "9412c668-edd2-55fd-9399-7d6e1a2f8a6c" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9d7cf7d9-c32d-5d59-8e1b-aecff778bbd8" :answer/id #uuid "9d7cf7d9-c32d-5d59-8e1b-aecff778bbd8" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-ec68ce0a-0a97-5e15-9517-25ed30b46d75" :answer/id #uuid "ec68ce0a-0a97-5e15-9517-25ed30b46d75" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9f84b452-29ef-5fed-8688-2d2cbe3460cd" :answer/id #uuid "9f84b452-29ef-5fed-8688-2d2cbe3460cd" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-bc51ccb0-0438-5418-a3d9-157e172ac1ec" :question/id #uuid "bc51ccb0-0438-5418-a3d9-157e172ac1ec" :question/math-academy-id "q-99685" :question/problem "$-\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{{e}^{5}})=$" :question/worked-solution "First, we rewrite $\\frac{1}{{e}^{5}}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\frac{1}{{e}^{5}}={e}^{-5}\n$$\n\nTherefore, we have:\n\n$$\n-\\frac{1}{2}\\operatorname{ln}⁡(\\frac{1}{{e}^{5}})=-\\frac{1}{2}\\operatorname{ln}⁡({e}^{-5})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=-5.$ Therefore:\n\n$$\n-\\frac{1}{2}\\operatorname{ln}⁡({e}^{-5})=-\\frac{1}{2}\\cdot (-5)=\\frac{5}{2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-23aae750-eafd-52bf-8e1a-92d37cd03934"] :db/ensure [:question/validate]} {:db/id "answer-field-23aae750-eafd-52bf-8e1a-92d37cd03934" :answer-field/id #uuid "23aae750-eafd-52bf-8e1a-92d37cd03934" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer-field/choices ["answer-2302b82a-2c66-54dd-be0b-bf5ba7bc64a2" "answer-319eef43-8c9a-5fd5-add1-64fefb55b710" "answer-e1a07ac1-07d6-51e7-8687-9b55e361c2b2" "answer-dd9fba62-ac84-588c-b69a-9b024d5ca676" "answer-c0a12033-1a6e-5a88-af17-bb4f55993e4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2302b82a-2c66-54dd-be0b-bf5ba7bc64a2" :answer/id #uuid "2302b82a-2c66-54dd-be0b-bf5ba7bc64a2" :answer/type :answer.type/math :answer/value "-\\frac{1}{32}" :db/ensure [:answer/validate]} {:db/id "answer-319eef43-8c9a-5fd5-add1-64fefb55b710" :answer/id #uuid "319eef43-8c9a-5fd5-add1-64fefb55b710" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e1a07ac1-07d6-51e7-8687-9b55e361c2b2" :answer/id #uuid "e1a07ac1-07d6-51e7-8687-9b55e361c2b2" :answer/type :answer.type/math :answer/value "-\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-dd9fba62-ac84-588c-b69a-9b024d5ca676" :answer/id #uuid "dd9fba62-ac84-588c-b69a-9b024d5ca676" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer/id #uuid "c0a12033-1a6e-5a88-af17-bb4f55993e4f" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-3ea37247-24cf-5fab-829f-0e5fcfa54afc" :question/id #uuid "3ea37247-24cf-5fab-829f-0e5fcfa54afc" :question/math-academy-id "q-66855" :question/problem "$2\\operatorname{ln}⁡(\\frac{1}{{e}^{4}})=$" :question/worked-solution "First, we rewrite $\\frac{1}{{e}^{4}}$ as a power of $e$ (the base of the natural logarithm) as follows:\n\n$$\n\\frac{1}{{e}^{4}}={e}^{-4}\n$$\n\nTherefore, we have:\n\n$$\n2\\operatorname{ln}⁡(\\frac{1}{{e}^{4}})=2\\operatorname{ln}⁡({e}^{-4})\n$$\n\nThe natural logarithm reverses the action of the exponent. The principle is:\n\n$$\n\\operatorname{ln}⁡({e}^{x})=x\n$$\n\nIn our case, we have $x=-4.$ Therefore:\n\n$$\n2\\operatorname{ln}⁡({e}^{-4})=2\\cdot (-4)=-8\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9a3c0e7e-447d-50a1-976e-443b533f1367"] :db/ensure [:question/validate]} {:db/id "answer-field-9a3c0e7e-447d-50a1-976e-443b533f1367" :answer-field/id #uuid "9a3c0e7e-447d-50a1-976e-443b533f1367" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d2352f86-cbc5-5a20-9312-01f56f5d1500" :answer-field/choices ["answer-dcf9c1bf-6252-5332-8106-48f580492575" "answer-d2352f86-cbc5-5a20-9312-01f56f5d1500" "answer-b7f950d3-5f98-5aa6-9a5c-854d5d739f5d" "answer-7c38600e-9095-5d68-9679-992de9782bd5" "answer-040a210b-491b-5e87-810f-cce446965078"] :db/ensure [:answer-field/validate]} {:db/id "answer-dcf9c1bf-6252-5332-8106-48f580492575" :answer/id #uuid "dcf9c1bf-6252-5332-8106-48f580492575" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-d2352f86-cbc5-5a20-9312-01f56f5d1500" :answer/id #uuid "d2352f86-cbc5-5a20-9312-01f56f5d1500" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-b7f950d3-5f98-5aa6-9a5c-854d5d739f5d" :answer/id #uuid "b7f950d3-5f98-5aa6-9a5c-854d5d739f5d" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7c38600e-9095-5d68-9679-992de9782bd5" :answer/id #uuid "7c38600e-9095-5d68-9679-992de9782bd5" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-040a210b-491b-5e87-810f-cce446965078" :answer/id #uuid "040a210b-491b-5e87-810f-cce446965078" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186088088 :question/problem "Rounded to $3$ decimal places,  $\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(3)=$" :question/worked-solution "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(3) & ≈0.693\\,147+1.098\\,612 \\\\  & ≈1.791\\,759 \\\\  & ≈1.792\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186085195 :answer-field/correct 17592186085196 :db/ensure [:answer-field/validate]} {:db/id "question-14cade25-332f-551b-a745-e0cec33e151b" :question/id #uuid "14cade25-332f-551b-a745-e0cec33e151b" :question/math-academy-id "q-99692" :question/problem "Rounded to $3$ decimal places,  $\\operatorname{ln}⁡(\\sqrt{10})=$" :question/worked-solution "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate step to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\sqrt{10}) & ≈\\operatorname{ln}⁡(3.162\\,278) \\\\  & ≈1.151\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f03464b5-9819-5ae9-b792-064fb40a818e"] :db/ensure [:question/validate]} {:db/id "answer-field-f03464b5-9819-5ae9-b792-064fb40a818e" :answer-field/id #uuid "f03464b5-9819-5ae9-b792-064fb40a818e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3cb67fef-af0d-57b4-871e-a50c54527d69" :answer-field/choices ["answer-5157736c-f89a-5d7f-9cca-33af1226d60f" "answer-3cb67fef-af0d-57b4-871e-a50c54527d69" "answer-bdf7d195-45bd-58dc-986e-d4c8ccb5a1ea" "answer-e7ed2e5e-1e5f-5298-b4f5-74a9f64c397a" "answer-cf3458cd-35f9-58d7-af0f-e0e3bf4df224"] :db/ensure [:answer-field/validate]} {:db/id "answer-5157736c-f89a-5d7f-9cca-33af1226d60f" :answer/id #uuid "5157736c-f89a-5d7f-9cca-33af1226d60f" :answer/type :answer.type/math :answer/value "1.122" :db/ensure [:answer/validate]} {:db/id "answer-3cb67fef-af0d-57b4-871e-a50c54527d69" :answer/id #uuid "3cb67fef-af0d-57b4-871e-a50c54527d69" :answer/type :answer.type/math :answer/value "1.151" :db/ensure [:answer/validate]} {:db/id "answer-bdf7d195-45bd-58dc-986e-d4c8ccb5a1ea" :answer/id #uuid "bdf7d195-45bd-58dc-986e-d4c8ccb5a1ea" :answer/type :answer.type/math :answer/value "1.158" :db/ensure [:answer/validate]} {:db/id "answer-e7ed2e5e-1e5f-5298-b4f5-74a9f64c397a" :answer/id #uuid "e7ed2e5e-1e5f-5298-b4f5-74a9f64c397a" :answer/type :answer.type/math :answer/value "1.196" :db/ensure [:answer/validate]} {:db/id "answer-cf3458cd-35f9-58d7-af0f-e0e3bf4df224" :answer/id #uuid "cf3458cd-35f9-58d7-af0f-e0e3bf4df224" :answer/type :answer.type/math :answer/value "1.207" :db/ensure [:answer/validate]} {:db/id "question-00510ebe-a387-562e-98da-516fa9a673e0" :question/id #uuid "00510ebe-a387-562e-98da-516fa9a673e0" :question/math-academy-id "q-99695" :question/problem "Using suitable approximations, calculate $\\sqrt{\\operatorname{ln}⁡(4)}\\cdot \\operatorname{ln}⁡(2)$ to $3$ decimal places." :question/worked-solution "We compute the required expression to $3$ decimal places using a calculator, rounding the intermediate steps to $6$ decimal places to avoid rounding error. This gives:\n\n$$\n\\begin{aligned}\\sqrt{\\operatorname{ln}⁡(4)}\\cdot \\operatorname{ln}⁡(2) & ≈\\sqrt{1.386\\,294}\\cdot 0.693\\,147 \\\\  & ≈1.177\\,410\\cdot 0.693\\,147 \\\\  & ≈0.816\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2f063cea-5b17-54cf-988c-eca299598b1f"] :db/ensure [:question/validate]} {:db/id "answer-field-2f063cea-5b17-54cf-988c-eca299598b1f" :answer-field/id #uuid "2f063cea-5b17-54cf-988c-eca299598b1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df418158-2acd-5aa2-8cab-77fcb44d6ded" :answer-field/choices ["answer-32371844-26f7-59d5-a03a-49495028005e" "answer-de1a7a07-4e4a-5e7b-b5e1-fb4988240ff8" "answer-df418158-2acd-5aa2-8cab-77fcb44d6ded" "answer-1094c280-8d50-5ac3-af86-01d3f0f6eb50" "answer-edb23120-fe41-58c2-9bdf-75c119e10310"] :db/ensure [:answer-field/validate]} {:db/id "answer-32371844-26f7-59d5-a03a-49495028005e" :answer/id #uuid "32371844-26f7-59d5-a03a-49495028005e" :answer/type :answer.type/math :answer/value "0.793" :db/ensure [:answer/validate]} {:db/id "answer-de1a7a07-4e4a-5e7b-b5e1-fb4988240ff8" :answer/id #uuid "de1a7a07-4e4a-5e7b-b5e1-fb4988240ff8" :answer/type :answer.type/math :answer/value "0.802" :db/ensure [:answer/validate]} {:db/id "answer-df418158-2acd-5aa2-8cab-77fcb44d6ded" :answer/id #uuid "df418158-2acd-5aa2-8cab-77fcb44d6ded" :answer/type :answer.type/math :answer/value "0.816" :db/ensure [:answer/validate]} {:db/id "answer-1094c280-8d50-5ac3-af86-01d3f0f6eb50" :answer/id #uuid "1094c280-8d50-5ac3-af86-01d3f0f6eb50" :answer/type :answer.type/math :answer/value "0.852" :db/ensure [:answer/validate]} {:db/id "answer-edb23120-fe41-58c2-9bdf-75c119e10310" :answer/id #uuid "edb23120-fe41-58c2-9bdf-75c119e10310" :answer/type :answer.type/math :answer/value "0.863" :db/ensure [:answer/validate]} {:db/id 17592186088888 :tutorial/content "**Euler’s number**, denoted $e,$ is one of the most important constants in mathematics. It's an irrational number, and its numerical value is approximately\n\n$$\ne\\approx2.718\\,281\\,828.\n$$\n\nThe **natural logarithm**, denoted $\\ln,$ is a special logarithm whose base is equal to Euler's number:\n\n$$\n\\ln a = \\log_e a\n$$\n\nIn other words, the natural logarithm of $a$ is defined as follows:\n\n$\\ln{a} = x$ is equivalent to $a = e^x$\n\nEverything we've done with logarithms can be applied to the natural logarithm.\n\nFor instance, we can express $e^3 \\approx 20.086$ in logarithmic form. If we compare $e^{3} \\approx 20.086$ with $a = e^x,$ we get $a = 20.086$ and $x = 3.$ Therefore,\n\n$$\ne^3\\approx 20.086\\quad  \\textrm{is equivalent to}\\quad \\ln(20.086) \\approx 3.\n$$\n\nNote:\n\n- Scientific calculators usually have a special key that allows $\\ln a$ to be computed for specific values of $a.$\n\n- Euler's number shows up in many different areas, including compound interest, population growth, and calculus. For now, it’s enough to know that $e$ is a natural base for logarithms and exponentials. We’ll meet this number often in future lessons, where its deeper significance will become clear." :db/ensure [:tutorial/validate]} {:db/id 17592186087902 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186068701 :knowledge-point/questions ["question-473f318b-f2f7-5bdb-8ff8-b046ab67dc91"] :db/ensure [:knowledge-point/validate]} {:db/id "question-473f318b-f2f7-5bdb-8ff8-b046ab67dc91" :question/id #uuid "473f318b-f2f7-5bdb-8ff8-b046ab67dc91" :question/math-academy-id "q-132985" :question/problem "Find the value of $f(x)$ at $x=4.$\n\n$f(4)\\,=\\,$\n{{field-1}}" :question/worked-solution "We substitute $4$ for $x$ in the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & =3\\sqrt{x}+2 \\\\ f(4) & =3\\sqrt{4}+2 \\\\  & =3\\cdot 2+2 \\\\  & =6+2 \\\\  & =8\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d3a17bfa-7fbe-51f4-8e56-171039043e1e"] :db/ensure [:question/validate]} {:db/id "answer-field-d3a17bfa-7fbe-51f4-8e56-171039043e1e" :answer-field/id #uuid "d3a17bfa-7fbe-51f4-8e56-171039043e1e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a11fc5e2-b2d0-5079-ab86-b342ef825f79" :answer-field/choices ["answer-a11fc5e2-b2d0-5079-ab86-b342ef825f79"] :db/ensure [:answer-field/validate]} {:db/id "answer-a11fc5e2-b2d0-5079-ab86-b342ef825f79" :answer/id #uuid "a11fc5e2-b2d0-5079-ab86-b342ef825f79" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186059632 :knowledge-point/questions ["question-0286ada6-f474-5c67-9cad-74d4d70fc3df"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0286ada6-f474-5c67-9cad-74d4d70fc3df" :question/id #uuid "0286ada6-f474-5c67-9cad-74d4d70fc3df" :question/math-academy-id "q-132986" :question/problem "$h(4)\\,=\\,${{field-1}}" :question/worked-solution "Since $x=4$ is in the interval $x\\ge 0,$ we use the second branch of the piecewise function, namely $h(x)=2x+1:$\n\n$$\n\\begin{aligned}h(4) & =2(4)+1 \\\\  & =8+1 \\\\  & =9\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0af79da6-d74c-55ae-af40-2ee047d59dfe"] :db/ensure [:question/validate]} {:db/id "answer-field-0af79da6-d74c-55ae-af40-2ee047d59dfe" :answer-field/id #uuid "0af79da6-d74c-55ae-af40-2ee047d59dfe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7286d536-8e39-5508-813e-ce3228d5abaf" :answer-field/choices ["answer-7286d536-8e39-5508-813e-ce3228d5abaf"] :db/ensure [:answer-field/validate]} {:db/id "answer-7286d536-8e39-5508-813e-ce3228d5abaf" :answer/id #uuid "7286d536-8e39-5508-813e-ce3228d5abaf" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186129109 :knowledge-point/questions ["question-9fac61ef-0417-5de3-9911-e04b4f578edc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9fac61ef-0417-5de3-9911-e04b4f578edc" :question/id #uuid "9fac61ef-0417-5de3-9911-e04b4f578edc" :question/math-academy-id "q-132987" :question/problem "What is the root of the function $g(x)?$\n\nThe root is at $x\\,=$\n{{field-1}}" :question/worked-solution "The roots are the solutions to the equation $g(x)=0,$ which we solve as follows:\n\n$$\n\\begin{aligned}g(x) & =0 \\\\ 2x-6 & =0 \\\\ 2x & =6 \\\\ \\frac{2x}{2} & =\\frac{6}{2} \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the function has the single root $x=3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3e94f094-57f9-5f39-b10c-5dbe75ec001e"] :db/ensure [:question/validate]} {:db/id "answer-field-3e94f094-57f9-5f39-b10c-5dbe75ec001e" :answer-field/id #uuid "3e94f094-57f9-5f39-b10c-5dbe75ec001e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-76d3d9b6-d262-599b-a5f0-9337f5d37053" :answer-field/choices ["answer-76d3d9b6-d262-599b-a5f0-9337f5d37053"] :db/ensure [:answer-field/validate]} {:db/id "answer-76d3d9b6-d262-599b-a5f0-9337f5d37053" :answer/id #uuid "76d3d9b6-d262-599b-a5f0-9337f5d37053" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186124564 :knowledge-point/questions ["question-8db22404-98b1-5e60-b0e3-c4c2f250e097"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8db22404-98b1-5e60-b0e3-c4c2f250e097" :question/id #uuid "8db22404-98b1-5e60-b0e3-c4c2f250e097" :question/math-academy-id "q-132988" :question/problem "Using the graph of $y=h(x)$ on the interval $[-3,2],$ find the global maximum value of $h(x)$ on this interval.\n\n${h}_{max}\\,=\\,$\n{{field-1}}" :question/worked-solution "First, we recall the following definitions:\n\n* The global maximum of a function is the highest value that the function attains on its domain. There can only be (at most) one global maximum.\n\n* A global maximum point of a function is a point $(x,y)$ where a function reaches a global maximum. There can be zero, one, or many global maximum points.\n\nFor our function, the maximum value reached by the function is $h(x)=5.$ \n\n![](images/70/70c48ae2f451dfb8194a0f93aaaec406c36d381a8d85d2565320c5a7860351e7.png)\n\n  \n\nTherefore, the global maximum is ${h}_{max}=5.$ The function reaches this value when $x=2,$ so the global maximum point is $(2,5).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d57aee12-66ab-51f7-a521-b364c55461d8"] :db/ensure [:question/validate]} {:db/id "answer-field-d57aee12-66ab-51f7-a521-b364c55461d8" :answer-field/id #uuid "d57aee12-66ab-51f7-a521-b364c55461d8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f732096a-28a1-5dd2-9a4a-687e42083476" :answer-field/choices ["answer-f732096a-28a1-5dd2-9a4a-687e42083476"] :db/ensure [:answer-field/validate]} {:db/id "answer-f732096a-28a1-5dd2-9a4a-687e42083476" :answer/id #uuid "f732096a-28a1-5dd2-9a4a-687e42083476" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186054613 :knowledge-point/questions ["question-3d43c3ac-d004-5e03-b676-57e7a9141cc6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3d43c3ac-d004-5e03-b676-57e7a9141cc6" :question/id #uuid "3d43c3ac-d004-5e03-b676-57e7a9141cc6" :question/math-academy-id "q-132989" :question/problem "Write the expression for the function $(f+g)(x)$ in terms of $x.$\n\n$(f+g)(x)\\,=\\,$\n{{field-1}}" :question/worked-solution "We find $(f+g)(x)$ by adding the two functions:\n\n$$\n\\begin{aligned}(f+g)(x) & =(3\\sqrt{x}+2)+(2x-6) \\\\  & =2x+3\\sqrt{x}-4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3d18190d-0dbe-55c8-b80a-4828baa4e2de"] :db/ensure [:question/validate]} {:db/id "answer-field-3d18190d-0dbe-55c8-b80a-4828baa4e2de" :answer-field/id #uuid "3d18190d-0dbe-55c8-b80a-4828baa4e2de" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eaddaa63-63d1-5782-92be-b40ba9560fc1" :answer-field/choices ["answer-eaddaa63-63d1-5782-92be-b40ba9560fc1"] :db/ensure [:answer-field/validate]} {:db/id "answer-eaddaa63-63d1-5782-92be-b40ba9560fc1" :answer/id #uuid "eaddaa63-63d1-5782-92be-b40ba9560fc1" :answer/type :answer.type/math :answer/value "3\\sqrt{x}+2x-4" :db/ensure [:answer/validate]} {:db/id 17592186054612 :knowledge-point/questions ["question-fe533203-bd0f-5d2e-8bef-eff5c39a0f20"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fe533203-bd0f-5d2e-8bef-eff5c39a0f20" :question/id #uuid "fe533203-bd0f-5d2e-8bef-eff5c39a0f20" :question/math-academy-id "q-132990" :question/problem "Find the value of $(f/h)(4).$\n\n$(f/h)(4)\\,=\\,$\n{{field-1}}" :question/worked-solution "The notation $(f/h)(x)$ means the quotient of the functions $f(x)$ and $h(x).$ \n\nTo evaluate $(f/h)(4),$ we need to divide $f(4)$ by $h(4).$\n\nEarlier, we found the following values:\n\n$$\n\\begin{aligned}f(4) & =8 \\\\ h(4) & =9\\end{aligned}\n$$\n\n \n\nTherefore, we obtain\n\n$$\n(f/h)(4)=\\frac{f(4)}{h(4)}=\\frac{8}{9}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-34781f40-a9b8-5b38-ad7d-e77c41c4ba31"] :db/ensure [:question/validate]} {:db/id "answer-field-34781f40-a9b8-5b38-ad7d-e77c41c4ba31" :answer-field/id #uuid "34781f40-a9b8-5b38-ad7d-e77c41c4ba31" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f249961e-45e9-5421-a45e-02ccbe1f7252" :answer-field/choices ["answer-f249961e-45e9-5421-a45e-02ccbe1f7252"] :db/ensure [:answer-field/validate]} {:db/id "answer-f249961e-45e9-5421-a45e-02ccbe1f7252" :answer/id #uuid "f249961e-45e9-5421-a45e-02ccbe1f7252" :answer/type :answer.type/math :answer/value "\\frac{8}{9}" :db/ensure [:answer/validate]} {:db/id 17592186129298 :knowledge-point/questions ["question-6c436406-49e2-5628-8484-ed489c154cfd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6c436406-49e2-5628-8484-ed489c154cfd" :question/id #uuid "6c436406-49e2-5628-8484-ed489c154cfd" :question/math-academy-id "q-132991" :question/problem "$(f∘h)(4)\\,=\\,${{field-1}}" :question/worked-solution "The expression $(f∘h)(4)$ is equivalent to $f(h(4)).$\n\nPreviously, we found that \n\n$$\nh(4)=9.\n$$\n\nThen, we substitute $x=9$ into $f(x).$ This gives\n\n$$\n\\begin{aligned}f(h(4)) & =f(9) \\\\  & =3\\sqrt{9}+2 \\\\  & =3\\cdot 3+2 \\\\  & =11.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1e2e9d21-1d9d-5db5-8e76-6f60eb76390f"] :db/ensure [:question/validate]} {:db/id "answer-field-1e2e9d21-1d9d-5db5-8e76-6f60eb76390f" :answer-field/id #uuid "1e2e9d21-1d9d-5db5-8e76-6f60eb76390f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c2f02b4d-fe99-5efc-bd3d-db782d48acae" :answer-field/choices ["answer-c2f02b4d-fe99-5efc-bd3d-db782d48acae"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2f02b4d-fe99-5efc-bd3d-db782d48acae" :answer/id #uuid "c2f02b4d-fe99-5efc-bd3d-db782d48acae" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id 17592186179650 :knowledge-point/questions ["question-0715be61-dd61-5ecb-88f5-3c63416166d7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0715be61-dd61-5ecb-88f5-3c63416166d7" :question/id #uuid "0715be61-dd61-5ecb-88f5-3c63416166d7" :question/math-academy-id "q-132992" :question/problem "Consider the function $g(x)$ for $x\\in [2,4].$ What is its range over the given domain?\n\n{{field-1}}\n$\\le \\,g(x)\\,\\le $\n{{field-2}}" :question/worked-solution "First, we graph the function $g(x)=2x-6.$\n\n![](images/de/de124058817fded27ad4ca9f9537f4a7d09ccd8836c96b0e64580e28dc9ab1ec.png)\n\nThen, we find the lowest and highest $y$-values in the graph over the domain $x\\in [2,4].$\n\n* The lowest $y$ value is $-2.$ This occurs at the point $(2,-2).$\n\n* The highest $y$ value is $2.$ This occurs at the point $(4,2).$\n\nThe function covers all the $y$-values between $-2$ and $2,$ including the endpoints.\n\nTherefore, the range is $-2\\le y\\le 2,$ which can also be written as \n\n$$\n-2\\le g(x)\\le 2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-41b0f793-25d5-544d-9bd8-34056c7e9a16" "answer-field-a1c16e24-0c28-5784-a074-fb5d02807445"] :db/ensure [:question/validate]} {:db/id "answer-field-41b0f793-25d5-544d-9bd8-34056c7e9a16" :answer-field/id #uuid "41b0f793-25d5-544d-9bd8-34056c7e9a16" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-96993b19-490b-55e2-9b12-6fd2024180dd" :answer-field/choices ["answer-96993b19-490b-55e2-9b12-6fd2024180dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-96993b19-490b-55e2-9b12-6fd2024180dd" :answer/id #uuid "96993b19-490b-55e2-9b12-6fd2024180dd" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-a1c16e24-0c28-5784-a074-fb5d02807445" :answer-field/id #uuid "a1c16e24-0c28-5784-a074-fb5d02807445" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cd0c47e2-c7b2-5eaa-8bf3-3fee7f41fd2d" :answer-field/choices ["answer-cd0c47e2-c7b2-5eaa-8bf3-3fee7f41fd2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd0c47e2-c7b2-5eaa-8bf3-3fee7f41fd2d" :answer/id #uuid "cd0c47e2-c7b2-5eaa-8bf3-3fee7f41fd2d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186083359 :knowledge-point/questions ["question-84ed963d-febb-5737-ad58-631a391c71a9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-84ed963d-febb-5737-ad58-631a391c71a9" :question/id #uuid "84ed963d-febb-5737-ad58-631a391c71a9" :question/math-academy-id "q-132993" :question/problem "Suppose that $r(x)=\\frac{1}{2}x+k$ is the inverse of $g(x).$ What is the value of $k?$\n\n$k\\,=\\,$\n{{field-1}}" :question/worked-solution "If $r$ is the inverse of $g,$ then \n\n$$\nr(g(x))=x.\n$$\n\nTo find $r(g(x)),$ we write down the function $r$ and replace every occurrence of $x$ with $g(x):$\n\n$$\n\\begin{aligned}r(x) & =\\frac{1}{2}x+k \\\\ r(g(x)) & =\\frac{1}{2}g(x)+k\\end{aligned}\n$$\n\nThen, we substitute $g(x)=2x-6$ into the right-hand side of our expression and simplify, as follows:\n\n$$\n\\begin{aligned}r(g(x)) & =\\frac{1}{2}g(x)+k \\\\  & =\\frac{1}{2}(2x-6)+k \\\\  & =x-3+k\\end{aligned}\n$$\n\nHowever, we know that $r(g(x))=x.$ Equating the expression above with $x$ and solving for $k$ gives\n\n$$\n\\begin{aligned}r(g(x)) & =x \\\\ x-3+k & =x \\\\ \\cancel{x}-3+k & =\\cancel{x} \\\\ -3+k & =0 \\\\ k & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3a439040-17f5-58b3-90c2-a81073227783"] :db/ensure [:question/validate]} {:db/id "answer-field-3a439040-17f5-58b3-90c2-a81073227783" :answer-field/id #uuid "3a439040-17f5-58b3-90c2-a81073227783" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e01d97ce-e4d8-5d2a-97b7-3ba004fbc57e" :answer-field/choices ["answer-e01d97ce-e4d8-5d2a-97b7-3ba004fbc57e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e01d97ce-e4d8-5d2a-97b7-3ba004fbc57e" :answer/id #uuid "e01d97ce-e4d8-5d2a-97b7-3ba004fbc57e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "multistep-562a2fd6-4180-545b-8acd-97ff3b8ce9e0" :multistep/id #uuid "562a2fd6-4180-545b-8acd-97ff3b8ce9e0" :multistep/context "![](images/52/5270ae4ee5e310d1a28569a26ca5c9adef4c1e3c8af0db159385b0104d160f43.png)\n\nConsider the functions $f(x),$ $g(x),$ and $h(x)$ defined below. A part of the graph of $y=h(x)$ on the interval $x\\in [-3,2]$ is depicted above.\n\n$$\nf(x)=3\\sqrt{x}+2,\\,g(x)=2x-6,\\,h(x)=\\{\\begin{aligned}3-(x+1)^{2}, & \\,x<0 \\\\ 2x+1, & \\,x\\ge 0\\end{aligned}\n$$" :multistep/steps ["step-f834d06f-11a3-58c8-916e-41aaf6f69787" "step-8de80ca7-db73-5719-b24a-6b612895db49" "step-d5b3742f-4311-5078-9311-8d344fbdf850" "step-dbf1ce6e-c4f4-50db-8aa1-53ed1530b8ca" "step-bc122760-a2dd-5dbc-a5df-976e61603fb9" "step-263db314-8d23-5342-abb3-bfb253583d4c" "step-49323779-638b-5176-b757-9c95a48376ff" "step-cfb5281e-abf3-5802-9b9b-0ef51c8fc4f8" "step-c991c6a7-6441-5522-b1e0-1cf796f7d9ce"] :multistep/first-step "step-f834d06f-11a3-58c8-916e-41aaf6f69787" :db/ensure [:multistep/validate]} {:db/id "step-f834d06f-11a3-58c8-916e-41aaf6f69787" :step/id #uuid "f834d06f-11a3-58c8-916e-41aaf6f69787" :step/content "question-473f318b-f2f7-5bdb-8ff8-b046ab67dc91" :step/next "step-8de80ca7-db73-5719-b24a-6b612895db49" :db/ensure [:step/validate]} {:db/id "step-8de80ca7-db73-5719-b24a-6b612895db49" :step/id #uuid "8de80ca7-db73-5719-b24a-6b612895db49" :step/content "question-0286ada6-f474-5c67-9cad-74d4d70fc3df" :step/next "step-d5b3742f-4311-5078-9311-8d344fbdf850" :db/ensure [:step/validate]} {:db/id "step-d5b3742f-4311-5078-9311-8d344fbdf850" :step/id #uuid "d5b3742f-4311-5078-9311-8d344fbdf850" :step/content "question-9fac61ef-0417-5de3-9911-e04b4f578edc" :step/next "step-dbf1ce6e-c4f4-50db-8aa1-53ed1530b8ca" :db/ensure [:step/validate]} {:db/id "step-dbf1ce6e-c4f4-50db-8aa1-53ed1530b8ca" :step/id #uuid "dbf1ce6e-c4f4-50db-8aa1-53ed1530b8ca" :step/content "question-8db22404-98b1-5e60-b0e3-c4c2f250e097" :step/next "step-bc122760-a2dd-5dbc-a5df-976e61603fb9" :db/ensure [:step/validate]} {:db/id "step-bc122760-a2dd-5dbc-a5df-976e61603fb9" :step/id #uuid "bc122760-a2dd-5dbc-a5df-976e61603fb9" :step/content "question-3d43c3ac-d004-5e03-b676-57e7a9141cc6" :step/next "step-263db314-8d23-5342-abb3-bfb253583d4c" :db/ensure [:step/validate]} {:db/id "step-263db314-8d23-5342-abb3-bfb253583d4c" :step/id #uuid "263db314-8d23-5342-abb3-bfb253583d4c" :step/content "question-fe533203-bd0f-5d2e-8bef-eff5c39a0f20" :step/next "step-49323779-638b-5176-b757-9c95a48376ff" :db/ensure [:step/validate]} {:db/id "step-49323779-638b-5176-b757-9c95a48376ff" :step/id #uuid "49323779-638b-5176-b757-9c95a48376ff" :step/content "question-6c436406-49e2-5628-8484-ed489c154cfd" :step/next "step-cfb5281e-abf3-5802-9b9b-0ef51c8fc4f8" :db/ensure [:step/validate]} {:db/id "step-cfb5281e-abf3-5802-9b9b-0ef51c8fc4f8" :step/id #uuid "cfb5281e-abf3-5802-9b9b-0ef51c8fc4f8" :step/content "question-0715