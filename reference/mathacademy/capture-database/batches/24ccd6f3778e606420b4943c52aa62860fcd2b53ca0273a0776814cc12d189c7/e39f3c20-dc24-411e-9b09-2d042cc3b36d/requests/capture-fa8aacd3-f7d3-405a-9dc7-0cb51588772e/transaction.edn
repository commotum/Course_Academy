." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-40a9649d-c150-553c-95e3-691521407741"] :db/ensure [:question/validate]} {:db/id "answer-field-40a9649d-c150-553c-95e3-691521407741" :answer-field/id #uuid "40a9649d-c150-553c-95e3-691521407741" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a97aade-7741-5b60-bcc2-a3ecaceb3f55" :answer-field/choices ["answer-6fb2daa7-5a15-5bc1-9fad-8efe11262852" "answer-b70aeab0-a4e9-51d7-aa0a-588121c2fe9d" "answer-21b57cb3-fc0d-564e-95de-da986f4e2407" "answer-06bd77d7-6973-53e6-a4fe-f2c82d993ecf" "answer-7a97aade-7741-5b60-bcc2-a3ecaceb3f55"] :db/ensure [:answer-field/validate]} {:db/id "answer-6fb2daa7-5a15-5bc1-9fad-8efe11262852" :answer/id #uuid "6fb2daa7-5a15-5bc1-9fad-8efe11262852" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-b70aeab0-a4e9-51d7-aa0a-588121c2fe9d" :answer/id #uuid "b70aeab0-a4e9-51d7-aa0a-588121c2fe9d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-21b57cb3-fc0d-564e-95de-da986f4e2407" :answer/id #uuid "21b57cb3-fc0d-564e-95de-da986f4e2407" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-06bd77d7-6973-53e6-a4fe-f2c82d993ecf" :answer/id #uuid "06bd77d7-6973-53e6-a4fe-f2c82d993ecf" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-7a97aade-7741-5b60-bcc2-a3ecaceb3f55" :answer/id #uuid "7a97aade-7741-5b60-bcc2-a3ecaceb3f55" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186152126 :knowledge-point/questions ["question-8c89a512-5fc0-599a-9173-8df36d4b9b39"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8c89a512-5fc0-599a-9173-8df36d4b9b39" :question/id #uuid "8c89a512-5fc0-599a-9173-8df36d4b9b39" :question/math-academy-id "q-98376" :question/problem "Which of the following statements are true?\n\nI. $\\frac{7}{10}$ is a rational number\n\nII. $-\\frac{5}{3}$ is a rational number\n\nIII. $3$ is a rational number" :question/worked-solution "A rational number is any number that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $\\frac{7}{10}$ is a rational number.\n\n- $-\\frac{5}{3}$ is a rational number. It can be written as $\\frac{(-5)}{3}.$\n\n- $3$ is a rational number. It can be written as $\\frac{3}{1}.$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-33758373-5bbe-5e79-862d-c6b0cf8fdadf"] :db/ensure [:question/validate]} {:db/id "answer-field-33758373-5bbe-5e79-862d-c6b0cf8fdadf" :answer-field/id #uuid "33758373-5bbe-5e79-862d-c6b0cf8fdadf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9c33d0b1-3305-503c-99ec-baac4e90a33b" :answer-field/choices ["answer-40774ba8-a6a5-56dc-b62b-b32a5fe719fa" "answer-5f2cb3de-1316-52f2-be07-043399d5f93d" "answer-edaef11f-f6fd-5e0c-ad4d-5d1395a1797e" "answer-9c33d0b1-3305-503c-99ec-baac4e90a33b" "answer-6a04fccc-5a20-5e09-8879-a31a6e27b132"] :db/ensure [:answer-field/validate]} {:db/id "answer-40774ba8-a6a5-56dc-b62b-b32a5fe719fa" :answer/id #uuid "40774ba8-a6a5-56dc-b62b-b32a5fe719fa" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-5f2cb3de-1316-52f2-be07-043399d5f93d" :answer/id #uuid "5f2cb3de-1316-52f2-be07-043399d5f93d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-edaef11f-f6fd-5e0c-ad4d-5d1395a1797e" :answer/id #uuid "edaef11f-f6fd-5e0c-ad4d-5d1395a1797e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-9c33d0b1-3305-503c-99ec-baac4e90a33b" :answer/id #uuid "9c33d0b1-3305-503c-99ec-baac4e90a33b" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-6a04fccc-5a20-5e09-8879-a31a6e27b132" :answer/id #uuid "6a04fccc-5a20-5e09-8879-a31a6e27b132" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id 17592186073738 :knowledge-point/questions ["question-3851cb9c-32ab-50a5-b26d-1f3dac949677"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3851cb9c-32ab-50a5-b26d-1f3dac949677" :question/id #uuid "3851cb9c-32ab-50a5-b26d-1f3dac949677" :question/math-academy-id "q-236322" :question/problem "The ratio $3:2$ is equivalent to the ratio{{field-1}}$:10.$" :question/worked-solution "To find the ratio equivalent to $3:2$, we multiply both numbers by the same value:\n\n$$\n\\begin{aligned}\\,3 &  & : & \\,\\,\\, & \\,\\,2 &  \\\\ \\,\\,↓\\times \\,\\,5 &  &  &  & \\,\\,\\,↓\\times \\,\\,5 &  \\\\ \\,\\,\\boxed{} &  & : &  & \\,\\,\\,10 & \\end{aligned}\n$$\n\nTo get $10$ from $2,$ we multiply $2$ by $5.$ So, to get $\\,\\boxed{}\\,$ from $3,$ we multiply $3$ by $5$ as well:\n\n$$\n3\\times 5=15\n$$\n\nThe ratio $3:2$ is equivalent to $15:10.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e68bf2f3-762f-5da1-9e8f-676a80dfc16c"] :db/ensure [:question/validate]} {:db/id "answer-field-e68bf2f3-762f-5da1-9e8f-676a80dfc16c" :answer-field/id #uuid "e68bf2f3-762f-5da1-9e8f-676a80dfc16c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-29c93de5-8d1f-562e-89c7-389d504aabef" :answer-field/choices ["answer-29c93de5-8d1f-562e-89c7-389d504aabef"] :db/ensure [:answer-field/validate]} {:db/id "answer-29c93de5-8d1f-562e-89c7-389d504aabef" :answer/id #uuid "29c93de5-8d1f-562e-89c7-389d504aabef" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id 17592186064230 :knowledge-point/questions ["question-a98d2b92-1f79-5299-a15c-071e314b9a2c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a98d2b92-1f79-5299-a15c-071e314b9a2c" :question/id #uuid "a98d2b92-1f79-5299-a15c-071e314b9a2c" :question/math-academy-id "q-171153" :question/problem "$0÷(\\frac{2}{3})=${{field-1}}" :question/worked-solution "Zero divided by any number (other than zero) equals zero. Therefore, $0÷(\\frac{2}{3})=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ee82855a-a9a9-5945-b471-65f010904c24"] :db/ensure [:question/validate]} {:db/id "answer-field-ee82855a-a9a9-5945-b471-65f010904c24" :answer-field/id #uuid "ee82855a-a9a9-5945-b471-65f010904c24" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-40e4fb97-951d-5b68-859b-21f442ae9424" :answer-field/choices ["answer-40e4fb97-951d-5b68-859b-21f442ae9424"] :db/ensure [:answer-field/validate]} {:db/id "answer-40e4fb97-951d-5b68-859b-21f442ae9424" :answer/id #uuid "40e4fb97-951d-5b68-859b-21f442ae9424" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "activity-778b6c61-0a3f-550a-a089-d845f1d501a3" :activity/id #uuid "778b6c61-0a3f-550a-a089-d845f1d501a3" :activity/title "Quiz 2" :activity/type :activity.type/assessment :activity/course 17592186046647 :activity/steps ["step-5f74c32c-ae96-56d4-ae69-17e12286369e" "step-edb517ce-1a8e-5bc2-8f59-f6abc82050e2" "step-e6399d6d-b625-57cf-b71c-979b3a44630a" "step-0e4a3401-c189-5f87-82f9-223689f4ee7b" "step-a91deb52-df8e-58f3-a80c-61f97b3b3d3c" "step-06956ae6-a0ed-51f5-858f-eee00b1ca616" "step-3934ded0-6a6c-5dd0-956e-fecc34500caa" "step-967c9564-f50f-5c61-9408-07a338c12e4a" "step-30e06609-47fd-5091-95a4-9a463054dd15" "step-66e17220-fc20-5871-9abf-d593d06ab365"] :activity/first-step "step-5f74c32c-ae96-56d4-ae69-17e12286369e" :db/ensure [:activity/validate]} {:db/id "step-5f74c32c-ae96-56d4-ae69-17e12286369e" :step/id #uuid "5f74c32c-ae96-56d4-ae69-17e12286369e" :step/content "question-2b95da98-1f5f-