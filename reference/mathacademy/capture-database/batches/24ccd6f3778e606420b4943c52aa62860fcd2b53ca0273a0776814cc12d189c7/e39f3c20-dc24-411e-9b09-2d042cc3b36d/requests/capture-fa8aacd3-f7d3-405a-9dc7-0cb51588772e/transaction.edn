uestion/math-academy-id "q-1866" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=3{x}^{4}+\\frac{7}{{x}^{4}}-12x.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4}+\\frac{7}{{x}^{4}}-12x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{4})+\\frac{\\text{d}}{\\text{d}x}(7{x}^{-4})-\\frac{\\text{d}}{\\text{d}x}(12x) \\\\  & =3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{4})+7\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-4})-12\\cdot \\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =3\\cdot 4{x}^{(4-1)}+7\\cdot (-4){x}^{(-4-1)}-12\\cdot 1 \\\\  & =12{x}^{3}-28{x}^{-5}-12 \\\\  & =12{x}^{3}-\\frac{28}{{x}^{5}}-12\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-059dbd28-656a-59be-8ed5-e0971d025a8a"] :db/ensure [:question/validate]} {:db/id "answer-field-059dbd28-656a-59be-8ed5-e0971d025a8a" :answer-field/id #uuid "059dbd28-656a-59be-8ed5-e0971d025a8a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-43bd9732-3c9a-5769-9c00-bbcb2a48446f" :answer-field/choices ["answer-cf947bc2-e090-5053-8204-9ff869376488" "answer-40f7c195-a751-5b71-9a87-0de1ab89d81e" "answer-43bd9732-3c9a-5769-9c00-bbcb2a48446f" "answer-e3d435a4-9bec-54a8-9486-d0e6717fcf24" "answer-f2405522-cc9c-5a15-9cc7-6150b213efad"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf947bc2-e090-5053-8204-9ff869376488" :answer/id #uuid "cf947bc2-e090-5053-8204-9ff869376488" :answer/type :answer.type/math :answer/value "12{x}^{3}+\\frac{28}{{x}^{5}}-12" :db/ensure [:answer/validate]} {:db/id "answer-40f7c195-a751-5b71-9a87-0de1ab89d81e" :answer/id #uuid "40f7c195-a751-5b71-9a87-0de1ab89d81e" :answer/type :answer.type/math :answer/value "12{x}^{3}-\\frac{21}{{x}^{5}}-12" :db/ensure [:answer/validate]} {:db/id "answer-43bd9732-3c9a-5769-9c00-bbcb2a48446f" :answer/id #uuid "43bd9732-3c9a-5769-9c00-bbcb2a48446f" :answer/type :answer.type/math :answer/value "12{x}^{3}-\\frac{28}{{x}^{5}}-12" :db/ensure [:answer/validate]} {:db/id "answer-e3d435a4-9bec-54a8-9486-d0e6717fcf24" :answer/id #uuid "e3d435a4-9bec-54a8-9486-d0e6717fcf24" :answer/type :answer.type/math :answer/value "24{x}^{3}-\\frac{28}{{x}^{3}}-12" :db/ensure [:answer/validate]} {:db/id "answer-f2405522-cc9c-5a15-9cc7-6150b213efad" :answer/id #uuid "f2405522-cc9c-5a15-9cc7-6150b213efad" :answer/type :answer.type/math :answer/value "4{x}^{3}+\\frac{21}{{x}^{3}}-12" :db/ensure [:answer/validate]} {:db/id 17592186059863 :knowledge-point/questions ["question-8ce73f5e-c8df-5814-9aaf-e78dee12c64a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8ce73f5e-c8df-5814-9aaf-e78dee12c64a" :question/id #uuid "8ce73f5e-c8df-5814-9aaf-e78dee12c64a" :question/math-academy-id "q-10741" :question/problem "If $y=\\frac{11}{{x}^{9}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{11}{{x}^{9}}=11{x}^{-9}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\text{d}}{\\text{d}x}(11{x}^{-9}) \\\\  & =11\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-9}) \\\\  & =11\\cdot (-9){x}^{-9-1} \\\\  & =-99{x}^{-10} \\\\  & =-\\frac{99}{{x}^{10}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d47a598d-d2c7-5bab-9e38-017b0c639aa7"] :db/ensure [:question/validate]} {:db/id "answer-field-d47a598d-d2c7-5bab-9e38-017b0c639aa7" :answer-field/id #uuid "d47a598d-d2c7-5bab-9e38-017b0c639aa7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7ba16ff-9f57-54e5-b32e-9e736a76872d" :answer-field/choices ["answer-d7ba16ff-9f57-54e5-b32e-9e736a76872d" "answer-e52d4e72-b1f6-5c83-8f92-b5cb335afcc1" "answer-ad22bea0-0514-5968-a849-0f45c5a43d08" "answer-4d7cab94-65b2-5228-8549-f3ba7717c36b" "answer-608c8c54-3777-5d49-8def-13401921a806"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7ba16ff-9f57-54e5-b32e-9e736a76872d" :answer/id #uuid "d7ba16ff-9f57-54e5-b32e-9e736a76872d" :answer/type :answer.type/math :answer/value "-\\frac{99}{{x}^{10}}" :db/ensure [:answer/validate]} {:db/id "answer-e52d4e72-b1f6-5c83-8f92-b5cb335afcc1" :answer/id #uuid "e52d4e72-b1f6-5c83-8f92-b5cb335afcc1" :answer/type :answer.type/math :answer/value "-\\frac{99}{{x}^{11}}" :db/ensure [:answer/validate]} {:db/id "answer-ad22bea0-0514-5968-a849-0f45c5a43d08" :answer/id #uuid "ad22bea0-0514-5968-a849-0f45c5a43d08" :answer/type :answer.type/math :answer/value "9{x}^{9}" :db/ensure [:answer/validate]} {:db/id "answer-4d7cab94-65b2-5228-8549-f3ba7717c36b" :answer/id #uuid "4d7cab94-65b2-5228-8549-f3ba7717c36b" :answer/type :answer.type/math :answer/value "\\frac{1}{11}x" :db/ensure [:answer/validate]} {:db/id "answer-608c8c54-3777-5d49-8def-13401921a806" :answer/id #uuid "608c8c54-3777-5d49-8def-13401921a806" :answer/type :answer.type/math :answer/value "\\frac{1}{8}{x}^{8}" :db/ensure [:answer/validate]} {:db/id "activity-9c473583-05b6-5bc0-af16-b14fdc8c8a09" :activity/id #uuid "9c473583-05b6-5bc0-af16-b14fdc8c8a09" :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type :activity.type/review :activity/scope 17592186048932 :activity/course 17592186046647 :activity/steps ["step-d808f43f-f58c-5105-bd8a-c0ad332d774e" "step-be80f772-d8ad-5602-ac15-4417e513dab9" "step-32d6371f-33f3-5561-8be1-2fca80b1c7d8"] :activity/first-step "step-d808f43f-f58c-5105-bd8a-c0ad332d774e" :db/ensure [:activity/validate]} {:db/id "step-d808f43f-f58c-5105-bd8a-c0ad332d774e" :step/id #uuid "d808f43f-f58c-5105-bd8a-c0ad332d774e" :step/content 17592186060174 :step/next "step-be80f772-d8ad-5602-ac15-4417e513dab9" :db/ensure [:step/validate]} {:db/id "step-be80f772-d8ad-5602-ac15-4417e513dab9" :step/id #uuid "be80f772-d8ad-5602-ac15-4417e513dab9" :step/content "question-ec8a3447-04a1-55a0-a68b-6b9044cae34d" :step/next "step-32d6371f-33f3-5561-8be1-2fca80b1c7d8" :db/ensure [:step/validate]} {:db/id "step-32d6371f-33f3-5561-8be1-2fca80b1c7d8" :step/id #uuid "32d6371f-33f3-5561-8be1-2fca80b1c7d8" :step/content "question-8ce73f5e-c8df-5814-9aaf-e78dee12c64a" :db/ensure [:step/validate]} {:db/id 17592186105751 :knowledge-point/questions ["question-b40960a4-3462-5880-9ff6-2c1313bf33f8" "question-e54967a4-313f-5425-b80c-928ee57bb212"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b40960a4-3462-5880-9ff6-2c1313bf33f8" :question/id #uuid "b40960a4-3462-5880-9ff6-2c1313bf33f8" :question/math-academy-id "q-171905" :question/problem "![](images/bd/bd6b42e1d48ca0e45ffc9b8910345bea52f1f44f9754f00ac4a4ba034e273bb5.png)\n\nGiven the quadrilateral above, we have $x=${{field-1}}\n${}^{∘}.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}4x+3x+(2x+{20}^{∘})+(5x-{24}^{∘}) & ={360}^{∘} \\\\ 14x-{4}^{∘} & ={360}^{∘} \\\\ 14x & ={364}^{∘} \\\\ x & ={26}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d7ff32db-e290-547d-9167-5bfd000c5b9f"] :db/ensure [:question/validate]} {:db/id "answer-field-d7ff32db-e290-547d-9167-5bfd000c5b9f" :answer-field/id #uuid "d7ff32db-e290-547d-9167-5bfd000c5b9f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-95de501c-c29d-5cbf-9a79-048a79089948" :answer-field/choices ["answer-95de501c-c29d-5cbf-9a79-048a79089948"] :db/ensure [:answer-field/validate]} {:db/id "answer-95de501c-c29d-5cbf-9a79-048a79089948" :answer/id #uuid "95de501c-c29d-5cbf-9a79-048a79089948" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "question-e54967a4-313f-5425-b80c-928ee57bb212" :question/id #uuid "e54967a4-313f-5425-b80c-928ee57bb212" :question/math-academy-id "q-223198" :question/problem "![](images/a9/a92c3df4f9d410b1a7620cf43b04fda1ce7312cebd8c6077a0b0411ecc78ad73.png)\n\nGiven the quadrilateral above, we have $x=${{field-1}}\n${}^{∘}.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}x+2x+(x+{10}^{∘})+(2x-{10}^{∘}) & ={360}^{∘} \\\\ 6x & ={360}^{∘} \\\\ x & ={60}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-525a4469-4e3e-58b4-bc94-04e70a60046c"] :db/ensure [:question/validate]} {:db/id "answer-field-525a4469-4e3e-58b4-bc94-04e70a60046c" :answer-field/id #uuid "525a4469-4e3e-58b4-bc94-04e70a60046c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e08b8587-2673-5d67-85be-e9c69a264b9d" :answer-field/choices ["answer-e08b8587-2673-5d67-85be-e9c69a264b9d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e08b8587-2673-5d67-85be-e9c69a264b9d" :answer/id #uuid "e08b8587-2673-5d67-85be-e9c69a264b9d" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id 17592186105752 :knowledge-point/questions ["question-143c348d-4bc6-5a45-bf95-01d78dce959f" "question-da26be71-f6d6-5898-b94d-3e43f1a50c61"] :db/ensure [:knowledge-point/validate]} {:db/id "question-143c348d-4bc6-5a45-bf95-01d78dce959f" :question/id #uuid "143c348d-4bc6-5a45-bf95-01d78dce959f" :question/math-academy-id "q-223201" :question/problem "![](images/33/33c1016cb2353e5332a5e04e8f377d4fa7d76e1b569a3532a45c5a068cc6d255.png)\n\nFor the quadrilateral above, determine the measure of the exterior angle of $∠C.$" :question/worked-solution "Since the sum of the exterior angles of a polygon is ${360}^{∘},$ we have\n\n$$\n\\begin{aligned}(6x+{23}^{∘})+(17x-{4}^{∘})+(21x+{8}^{∘})+(4x-{3}^{∘}) & ={360}^{∘} \\\\ 48x+{24}^{∘} & ={360}^{∘} \\\\ 48x & ={336}^{∘} \\\\ x & ={7}^{∘}.\\end{aligned}\n$$\n\nTherefore, the measure of the exterior angle of $∠C$ equals\n\n$$\n\\begin{aligned}21x+{8}^{∘} & =21({7}^{∘})+{8}^{∘} \\\\  & ={147}^{∘}+8 \\\\  & ={155}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b89379c4-d191-53ca-8ac5-ec0071d31fd7"] :db/ensure [:question/validate]} {:db/id "answer-field-b89379c4-d191-53ca-8ac5-ec0071d31fd7" :answer-field/id #uuid "b89379c4-d191-53ca-8ac5-ec0071d31fd7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-22a27d61-a734-57ce-a1b9-e6a9d52463e0" :answer-field/choices ["answer-aefd51f3-7fe9-58df-9f1a-21094a7ee66a" "answer-22a27d61-a734-57ce-a1b9-e6a9d52463e0" "answer-eb7972ee-be19-5bae-a8dd-d693c56fe478" "answer-9ccb46db-67ff-50b8-8b68-b38569111f19" "answer-df4121c9-1388-5799-80fd-0cbb19b668e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-aefd51f3-7fe9-58df-9f1a-21094a7ee66a" :answer/id #uuid "aefd51f3-7fe9-58df-9f1a-21094a7ee66a" :answer/type :answer.type/math :answer/value "{152}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-22a27d61-a734-57ce-a1b9-e6a9d52463e0" :answer/id #uuid "22a27d61-a734-57ce-a1b9-e6a9d52463e0" :answer/type :answer.type/math :answer/value "{155}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-eb7972ee-be19-5bae-a8dd-d693c56fe478" :answer/id #uuid "eb7972ee-be19-5bae-a8dd-d693c56fe478" :answer/type :answer.type/math :answer/value "{163}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-9ccb46db-67ff-50b8-8b68-b38569111f19" :answer/id #uuid "9ccb46db-67ff-50b8-8b68-b38569111f19" :answer/type :answer.type/math :answer/value "{168}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-df4121c9-1388-5799-80fd-0cbb19b668e6" :answer/id #uuid "df4121c9-1388-5799-80fd-0cbb19b668e6" :answer/type :answer.type/math :answer/value "{173}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-da26be71-f6d6-5898-b94d-3e43f1a50c61" :question/id #uuid "da26be71-f6d6-5898-b94d-3e43f1a50c61" :question/math-academy-id "q-223237" :question/problem "![](images/4c/4c8bc8341b9619e9fddb151b02d2d859fab801fe35114de6b2ce6d09045fff11.png)\n\nFor the quadrilateral above, the measure of the exterior angle of $∠C$ is{{field-1}}\n${}^{∘}.$" :question/worked-solution "Note that the measure of the exterior angle at $B$ is ${180}^{∘}-(4x+{18}^{∘})={162}^{∘}-4x.$\n\nSince the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}(5x+{15}^{∘})+({162}^{∘}-4x)+(4x-{2}^{∘})+(3x+{1}^{∘}) & ={360}^{∘} \\\\ 8x+{176}^{∘} & ={360}^{∘} \\\\ 8x & ={184}^{∘} \\\\ x & ={23}^{∘}.\\end{aligned}\n$$\n\nTherefore, the measure of the exterior angle of $∠C$ equals\n\n$$\n\\begin{aligned}4x-{2}^{∘} & =4({23}^{∘})-{2}^{∘} \\\\  & ={92}^{∘}-{2}^{∘} \\\\  & ={90}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b7c212c7-8e24-558b-a30f-86787ad1fb45"] :db/ensure [:question/validate]} {:db/id "answer-field-b7c212c7-8e24-558b-a30f-86787ad1fb45" :answer-field/id #uuid "b7c212c7-8e24-558b-a30f-86787ad1fb45" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0b680264-dfb5-59a3-bcc8-c4eaa88b0281" :answer-field/choices ["answer-0b680264-dfb5-59a3-bcc8-c4eaa88b0281"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b680264-dfb5-59a3-bcc8-c4eaa88b0281" :answer/id #uuid "0b680264-dfb5-59a3-bcc8-c4eaa88b0281" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id 17592186105750 :knowledge-point/questions ["question-2ac19296-c890-536b-9e9a-47b0cd74c840"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2ac19296-c890-536b-9e9a-47b0cd74c840" :question/id #uuid "2ac19296-c890-536b-9e9a-47b0cd74c840" :question/math-academy-id "q-223356" :question/problem "![](images/9e/9e40dfd3842ec7a7b5de16d7938988e86209960ae9cba510bbac004b0bb73d94.png)\n\nFor the pentagon above, the measure of the exterior angle of $∠B$ is{{field-1}}\n${}^{∘}.$" :question/worked-solution "Let us call $x$ the exterior angle of $∠B.$ Since the sum of the exterior angles of a polygon is ${360}^{∘}$, we have\n\n$$\n\\begin{aligned}{58}^{∘}+x+{65}^{∘}+{63}^{∘}+{97}^{∘} & ={360}^{∘} \\\\ x+{283}^{∘} & ={360}^{∘} \\\\ x & ={77}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5cb61399-54db-53c5-9e53-bf360481e48d"] :db/ensure [:question/validate]} {:db/id "answer-field-5cb61399-54db-53c5-9e53-bf360481e48d" :answer-field/id #uuid "5cb61399-54db-53c5-9e53-bf360481e48d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6318460b-5678-5646-a910-82e6cf183480" :answer-field/choices ["answer-6318460b-5678-5646-a910-82e6cf183480"] :db/ensure [:answer-field/validate]} {:db/id "answer-6318460b-5678-5646-a910-82e6cf183480" :answer/id #uuid "6318460b-5678-5646-a910-82e6cf183480" :answer/type :answer.type/math :answer/value "77" :db/ensure [:answer/validate]} {:db/id "activity-4642b563-78a1-574f-85b9-bdf648e97e49" :activity/id #uuid "4642b563-78a1-574f-85b9-bdf648e97e49" :activity/title "Exterior Angles of Polygons" :activity/type :activity.type/review :activity/scope 17592186050650 :activity/course 17592186046647 :activity/steps ["step-22c064e1-9b1b-5de4-87cd-f9e10b1b6ac9" "step-a5175f00-0d37-5905-a6f9-12c953f10f27" "step-91a10bad-5a62-55ff-aa9b-d76baf287c2f" "step-98d8757a-5405-536c-b667-673b49141522" "step-0e3febc6-ffc1-5247-a54a-b79a2b1756e7"] :activity/first-step "step-22c064e1-9b1b-5de4-87cd-f9e10b1b6ac9" :db/ensure [:activity/validate]} {:db/id "step-22c064e1-9b1b-5de4-87cd-f9e10b1b6ac9" :step/id #uuid "22c064e1-9b1b-5de4-87cd-f9e10b1b6ac9" :step/content "question-b40960a4-3462-5880-9ff6-2c1313bf33f8" :step/next "step-a5175f00-0d37-5905-a6f9-12c953f10f27" :db/ensure [:step/validate]} {:db/id "step-a5175f00-0d37-5905-a6f9-12c953f10f27" :step/id #uuid "a5175f00-0d37-5905-a6f9-12c953f10f27" :step/content "question-e54967a4-313f-5425-b80c-928ee57bb212" :step/next "step-91a10bad-5a62-55ff-aa9b-d76baf287c2f" :db/ensure [:step/validate]} {:db/id "step-91a10bad-5a62-55ff-aa9b-d76baf287c2f" :step/id #uuid "91a10bad-5a62-55ff-aa9b-d76baf287c2f" :step/content "question-143c348d-4bc6-5a45-bf95-01d78dce959f" :step/next "step-98d8757a-5405-536c-b667-673b49141522" :db/ensure [:step/validate]} {:db/id "step-98d8757a-5405-536c-b667-673b49141522" :step/id #uuid "98d8757a-5405-536c-b667-673b49141522" :step/content "question-da26be71-f6d6-5898-b94d-3e43f1a50c61" :step/next "step-0e3febc6-ffc1-5247-a54a-b79a2b1756e7" :db/ensure [:step/validate]} {:db/id "step-0e3febc6-ffc1-5247-a54a-b79a2b1756e7" :step/id #uuid "0e3febc6-ffc1-5247-a54a-b79a2b1756e7" :step/content "question-2ac19296-c890-536b-9e9a-47b0cd74c840" :db/ensure [:step/validate]} {:db/id 17592186134569 :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)={t}^{2},\\,{f}_{2}(t)={t}^{3},\\,{f}_{3}(t)=t\n$$\n\nGiven that the inner product in the vector space $C[-1,1]$ of continuous functions over $[-1,1]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-1}^{1}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nI. ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product\n\nII. ${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product\n\n*Hint: $⟨{f}_{1},{f}_{3}⟩=0.$*" :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩ & =⟨{t}^{2},{t}^{3}⟩ \\\\  & ={\\int }_{-1}^{1}{t}^{2}\\cdot {t}^{3}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{5}\\,\\text{d}t \\\\  & =\\frac{{t}^{6}}{6}{|}_{-1}^{1} \\\\  & =\\frac{{1}^{6}}{6}-\\frac{(-1)^{6}}{6} \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{3}(t)⟩ & =⟨{t}^{3},t⟩ \\\\  & ={\\int }_{-1}^{1}{t}^{3}\\cdot t\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{4}\\,\\text{d}t \\\\  & =\\frac{{t}^{5}}{5}{|}_{-1}^{1} \\\\  & =\\frac{{1}^{5}}{5}-\\frac{(-1)^{5}}{5} \\\\  & =\\frac{2}{5}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{2}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Since ${f}_{2}(t)⊥̸{f}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186133452 :answer-field/correct 17592186133456 :db/ensure [:answer-field/validate]} {:db/id "activity-27c4f973-8cd9-5bf9-b1b9-5d95669edfef" :activity/id #uuid "27c4f973-8cd9-5bf9-b1b9-5d95669edfef" :activity/title "Orthogonal Sets in Inner Product Spaces" :activity/type :activity.type/review :activity/scope 17592186048572 :activity/course 17592186046644 :activity/steps ["step-068d6b66-d519-5161-9eb3-7efaee833625" "step-f43963c8-38c4-5336-a8cf-309c2c95dbe1" "step-b9cfa362-8135-55c9-a260-2d92a37de08c" "step-288cbc9e-dc23-58e1-8dd2-9368f609a42d" "step-d30ded70-89ee-555a-8552-22899b8ddbfa"] :activity/first-step "step-068d6b66-d519-5161-9eb3-7efaee833625" :db/ensure [:activity/validate]} {:db/id "step-068d6b66-d519-5161-9eb3-7efaee833625" :step/id #uuid "068d6b66-d519-5161-9eb3-7efaee833625" :step/content 17592186362382 :step/next "step-f43963c8-38c4-5336-a8cf-309c2c95dbe1" :db/ensure [:step/validate]} {:db/id "step-f43963c8-38c4-5336-a8cf-309c2c95dbe1" :step/id #uuid "f43963c8-38c4-5336-a8cf-309c2c95dbe1" :step/content 17592186134569 :step/next "step-b9cfa362-8135-55c9-a260-2d92a37de08c" :db/ensure [:step/validate]} {:db/id "step-b9cfa362-8135-55c9-a260-2d92a37de08c" :step/id #uuid "b9cfa362-8135-55c9-a260-2d92a37de08c" :step/content 17592186382675 :step/next "step-288cbc9e-dc23-58e1-8dd2-9368f609a42d" :db/ensure [:step/validate]} {:db/id "step-288cbc9e-dc23-58e1-8dd2-9368f609a42d" :step/id #uuid "288cbc9e-dc23-58e1-8dd2-9368f609a42d" :step/content 17592186362397 :step/next "step-d30ded70-89ee-555a-8552-22899b8ddbfa" :db/ensure [:step/validate]} {:db/id "step-d30ded70-89ee-555a-8552-22899b8ddbfa" :step/id #uuid "d30ded70-89ee-555a-8552-22899b8ddbfa" :step/content 17592186237781 :db/ensure [:step/validate]} {:db/id 17592186119942 :knowledge-point/questions ["question-17d3a51b-87c6-5439-b5d7-1ae7b5260460" "question-c9bfaabb-1ddb-5591-87c5-e59f3a52dfbc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-17d3a51b-87c6-5439-b5d7-1ae7b5260460" :question/id #uuid "17d3a51b-87c6-5439-b5d7-1ae7b5260460" :question/math-academy-id "q-101158" :question/problem "Evaluate ${lim}_{t\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & =\\frac{{2}^{2}+2-6}{{2}^{2}-9(2)+14}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & =\\frac{(t+3)(t-2)}{(t-2)(t-7)} \\\\  & =\\frac{t+3}{t-7}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\frac{{t}^{2}+t-6}{{t}^{2}-9t+14} & ={lim}_{t\\to 2}\\frac{t+3}{t-7} \\\\  & =\\frac{2+3}{2-7} \\\\  & =\\frac{5}{(-5)} \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d257b360-4e88-51e4-add3-d80d3561fcec"] :db/ensure [:question/validate]} {:db/id "answer-field-d257b360-4e88-51e4-add3-d80d3561fcec" :answer-field/id #uuid "d257b360-4e88-51e4-add3-d80d3561fcec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21831e57-25de-5c6c-9c6c-ab43447a6e8c" :answer-field/choices ["answer-21831e57-25de-5c6c-9c6c-ab43447a6e8c" "answer-903accd6-cb1b-59f6-92d9-52cbca2aade9" "answer-65388b8f-1379-5e74-8e66-a7ae1be68001" "answer-508c3ec8-73a1-50fd-9725-b8b2d47f39c7" "answer-8e6f65b9-3a3d-5210-af3f-833869259271"] :db/ensure [:answer-field/validate]} {:db/id "answer-21831e57-25de-5c6c-9c6c-ab43447a6e8c" :answer/id #uuid "21831e57-25de-5c6c-9c6c-ab43447a6e8c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-903accd6-cb1b-59f6-92d9-52cbca2aade9" :answer/id #uuid "903accd6-cb1b-59f6-92d9-52cbca2aade9" :answer/type :answer.type/math :answer/value "-\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "answer-65388b8f-1379-5e74-8e66-a7ae1be68001" :answer/id #uuid "65388b8f-1379-5e74-8e66-a7ae1be68001" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-508c3ec8-73a1-50fd-9725-b8b2d47f39c7" :answer/id #uuid "508c3ec8-73a1-50fd-9725-b8b2d47f39c7" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-8e6f65b9-3a3d-5210-af3f-833869259271" :answer/id #uuid "8e6f65b9-3a3d-5210-af3f-833869259271" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id 17592186119938 :knowledge-point/questions ["question-63acba77-7b2e-522a-aba2-29e686142675" "question-7eccf962-783f-535d-b46e-1c5922c7413f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-63acba77-7b2e-522a-aba2-29e686142675" :question/id #uuid "63acba77-7b2e-522a-aba2-29e686142675" :question/math-academy-id "q-140415" :question/problem "Evaluate ${lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64} & =\\frac{3(-4)+12}{(-4)^{3}+64}=\\frac{-12+12}{-64+64}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. \n\nNotice that the denominator is a sum of cubes. Therefore, factoring our expression, we get\n\n$$\n\\begin{aligned}\\frac{3x+12}{{x}^{3}+64} & =\\frac{3(x+4)}{{x}^{3}+{4}^{3}} \\\\  & =\\frac{3(x+4)}{(x+4)({x}^{2}-4x+{4}^{2})} \\\\  & =\\frac{3}{{x}^{2}-4x+16}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3x+12}{{x}^{3}+64} & ={lim}_{x\\to -4}\\frac{3}{{x}^{2}-4x+16} \\\\  & =\\frac{3}{(-4)^{2}-4(-4)+16} \\\\  & =\\frac{3}{16+16+16} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-97ef3454-a8d7-5dce-ad87-6a661e06cf5e"] :db/ensure [:question/validate]} {:db/id "answer-field-97ef3454-a8d7-5dce-ad87-6a661e06cf5e" :answer-field/id #uuid "97ef3454-a8d7-5dce-ad87-6a661e06cf5e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2974ec32-c354-5379-8e1b-6a9acfaaddc2" :answer-field/choices ["answer-70d0b790-1084-5fd6-8c21-af30bf9f25cd" "answer-8ae9eecc-f45a-5e19-a6c0-5c2967aa26fb" "answer-58abb328-ad36-5cec-a8bc-f5da4562671f" "answer-2974ec32-c354-5379-8e1b-6a9acfaaddc2" "answer-1f3291a2-9375-59ea-b11b-d3d51ab51141"] :db/ensure [:answer-field/validate]} {:db/id "answer-70d0b790-1084-5fd6-8c21-af30bf9f25cd" :answer/id #uuid "70d0b790-1084-5fd6-8c21-af30bf9f25cd" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-8ae9eecc-f45a-5e19-a6c0-5c2967aa26fb" :answer/id #uuid "8ae9eecc-f45a-5e19-a6c0-5c2967aa26fb" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-58abb328-ad36-5cec-a8bc-f5da4562671f" :answer/id #uuid "58abb328-ad36-5cec-a8bc-f5da4562671f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-2974ec32-c354-5379-8e1b-6a9acfaaddc2" :answer/id #uuid "2974ec32-c354-5379-8e1b-6a9acfaaddc2" :answer/type :answer.type/math :answer/value "\\frac{1}{16}" :db/ensure [:answer/validate]} {:db/id "answer-1f3291a2-9375-59ea-b11b-d3d51ab51141" :answer/id #uuid "1f3291a2-9375-59ea-b11b-d3d51ab51141" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-c9bfaabb-1ddb-5591-87c5-e59f3a52dfbc" :question/id #uuid "c9bfaabb-1ddb-5591-87c5-e59f3a52dfbc" :question/math-academy-id "q-338200" :question/problem "Evaluate the following limit:\n\n${lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y} & =\\frac{(4)^{2}-16}{(4)^{2}-4(4)} \\\\  & =\\frac{16-16}{16-16} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{{y}^{2}-16}{{y}^{2}-4y} & =\\frac{(y-4)(y+4)}{y(y-4)} \\\\  & =\\frac{y+4}{y}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 4}\\frac{{y}^{2}-16}{{y}^{2}-4y} & ={lim}_{y\\to 4}\\frac{y+4}{y} \\\\  & =\\frac{4+4}{4} \\\\  & =\\frac{8}{4} \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ceec04e3-5f86-53fd-a80b-d4bd7eba9ecc"] :db/ensure [:question/validate]} {:db/id "answer-field-ceec04e3-5f86-53fd-a80b-d4bd7eba9ecc" :answer-field/id #uuid "ceec04e3-5f86-53fd-a80b-d4bd7eba9ecc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d8a68754-36ce-52d6-9127-21d7b91302be" :answer-field/choices ["answer-d8a68754-36ce-52d6-9127-21d7b91302be"] :db/ensure [:answer-field/validate]} {:db/id "answer-d8a68754-36ce-52d6-9127-21d7b91302be" :answer/id #uuid "d8a68754-36ce-52d6-9127-21d7b91302be" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-7eccf962-783f-535d-b46e-1c5922c7413f" :question/id #uuid "7eccf962-783f-535d-b46e-1c5922c7413f" :question/math-academy-id "q-338206" :question/problem "Evaluate the following limit:\n\n${lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}}=$\n{{field-1}}" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & =\\frac{7(0)^{6}-3(0)^{4}}{5(0)^{5}+10(0)^{4}}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, to find the limit, we have to factor the numerator and the denominator. We get\n\n$$\n\\begin{aligned}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & =\\frac{{y}^{4}(7{y}^{2}-3)}{{y}^{4}(5y+10)} \\\\  & =\\frac{7{y}^{2}-3}{5y+10}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{y\\to 0}\\frac{7{y}^{6}-3{y}^{4}}{5{y}^{5}+10{y}^{4}} & ={lim}_{y\\to 0}\\frac{7{y}^{2}-3}{5y+10} \\\\  & =\\frac{7(0)-3}{5(0)+10} \\\\  & =-\\frac{3}{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-288b4964-15f8-5bdf-aea5-937b1035cccb"] :db/ensure [:question/validate]} {:db/id "answer-field-288b4964-15f8-5bdf-aea5-937b1035cccb" :answer-field/id #uuid "288b4964-15f8-5bdf-aea5-937b1035cccb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-79457547-f0fb-58fa-a2c2-317026062441" :answer-field/choices ["answer-79457547-f0fb-58fa-a2c2-317026062441"] :db/ensure [:answer-field/validate]} {:db/id "answer-79457547-f0fb-58fa-a2c2-317026062441" :answer/id #uuid "79457547-f0fb-58fa-a2c2-317026062441" :answer/type :answer.type/math :answer/value "-\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "activity-1e5bf916-4dc8-5981-8525-b54be92da138" :activity/id #uuid "1e5bf916-4dc8-5981-8525-b54be92da138" :activity/title "Calculating Limits of Rational Functions by Factoring" :activity/type :activity.type/review :activity/scope 17592186049927 :activity/course 17592186046647 :activity/steps ["step-481c4610-a5dc-53ed-ae6e-370e534c6b45" "step-c854a8d0-adb7-5877-8a8d-92ee782e3584" "step-955c3886-484b-5898-8b9e-865782ff28a4" "step-b56c33d1-61b7-5263-b02b-f1a42ae44b24"] :activity/first-step "step-481c4610-a5dc-53ed-ae6e-370e534c6b45" :db/ensure [:activity/validate]} {:db/id "step-481c4610-a5dc-53ed-ae6e-370e534c6b45" :step/id #uuid "481c4610-a5dc-53ed-ae6e-370e534c6b45" :step/content "question-17d3a51b-87c6-5439-b5d7-1ae7b5260460" :step/next "step-c854a8d0-adb7-5877-8a8d-92ee782e3584" :db/ensure [:step/validate]} {:db/id "step-c854a8d0-adb7-5877-8a8d-92ee782e3584" :step/id #uuid "c854a8d0-adb7-5877-8a8d-92ee782e3584" :step/content "question-63acba77-7b2e-522a-aba2-29e686142675" :step/next "step-955c3886-484b-5898-8b9e-865782ff28a4" :db/ensure [:step/validate]} {:db/id "step-955c3886-484b-5898-8b9e-865782ff28a4" :step/id #uuid "955c3886-484b-5898-8b9e-865782ff28a4" :step/content "question-c9bfaabb-1ddb-5591-87c5-e59f3a52dfbc" :step/next "step-b56c33d1-61b7-5263-b02b-f1a42ae44b24" :db/ensure [:step/validate]} {:db/id "step-b56c33d1-61b7-5263-b02b-f1a42ae44b24" :step/id #uuid "b56c33d1-61b7-5263-b02b-f1a42ae44b24" :step/content "question-7eccf962-783f-535d-b46e-1c5922c7413f" :db/ensure [:step/validate]} {:db/id 17592186231433 :knowledge-point/questions ["question-d2f59173-bdb2-59d3-8bec-268e720e4bf5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186377459 :question/problem "Find the Laplace transform $Y(s)=L\\{y(t)\\}$ if\n\n$$\n{y}^{″}+9y=5{u}_{3}(t)\\cdot (t-3)^{2}\\,,\\,y(0)=0,\\,{y}^{′}(0)=0,\n$$\n\nwhere ${u}_{3}(t)=u(t-3)$ is the unit step function." :question/worked-solution "First, we take the Laplace transform of both sides and use the addition and scalar multiplication properties of the Laplace transform:\n\n$$\n\\begin{aligned}L\\{{y}^{″}+9y\\} & =L\\{5{u}_{3}(t)\\cdot (t-3)^{2}\\} \\\\ L\\{{y}^{″}\\}+9L\\{y\\} & =L\\{5{u}_{3}(t)\\cdot (t-3)^{2}\\}\\end{aligned}\n$$\n\nTo calculate $L\\{{y}^{″}\\},$ we use the formula for the Laplace transform of the second derivative and the initial conditions $y(0)=0$ and ${y}^{′}(0)=0:$\n\n$$\nL\\{{y}^{″}\\}={s}^{2}Y(s)-sy(0)-{y}^{′}(0)={s}^{2}Y(s)\n$$\n\nTo find the transform of the right-hand side, we note that the term \n\n$$\n5{u}_{3}(t)\\cdot (t-3)^{2}\n$$\n\nis in the form $u(t-a)\\cdot f(t)$ where $a=3$ and $f(t)=5(t-3)^{2}.$\n\nNow, recall that the second shifting theorem (time-shifting property) states\n\n$$\nL\\{u(t-a)\\cdot f(t)\\}={e}^{-as}\\cdot L\\{f(t+a)\\}.\n$$\n\n  \n\nSo, by the second shifting theorem, we have\n\n$$\n\\begin{aligned}L\\{5u(t-3)\\cdot (t-3)^{2}\\} & ={e}^{-3s}\\cdot L\\{5((t+3)-3)^{2}\\} \\\\  & ={e}^{-3s}\\cdot L\\{5{t}^{2}\\} \\\\  & ={e}^{-3s}\\cdot 5\\cdot \\frac{2!}{{s}^{2+1}} \\\\  & =\\frac{10{e}^{-3s}}{{s}^{3}}.\\end{aligned}\n$$\n\nFinally, we substitute these back into our transformed differential equation:\n\n$$\n\\begin{aligned}L\\{{y}^{″}\\}+9L\\{y\\} & =L\\{5{u}_{3}(t)(t-3)^{2}\\} \\\\ {s}^{2}Y(s)+9Y(s) & =\\frac{10{e}^{-3s}}{{s}^{3}} \\\\ ({s}^{2}+9)Y(s) & =\\frac{10{e}^{-3s}}{{s}^{3}} \\\\ Y(s) & =\\frac{10{e}^{-3s}}{{s}^{3}({s}^{2}+9)}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-d2f59173-bdb2-59d3-8bec-268e720e4bf5" :question/id #uuid "d2f59173-bdb2-59d3-8bec-268e720e4bf5" :question/math-academy-id "q-345246" :question/problem "Find the Laplace transform $Y(s)=L\\{y(t)\\}$ if\n\n$$\n{y}^{″}+16y=7{u}_{4}(t)\\cdot (t-4)\\,,\\,y(0)=0,\\,{y}^{′}(0)=3,\n$$\n\nwhere ${u}_{4}(t)=u(t-4)$ is the unit step function." :question/worked-solution "First, we take the Laplace transform of both sides and use the addition and scalar multiplication properties of the Laplace transform:\n\n$$\n\\begin{aligned}L\\{{y}^{″}+16y\\} & =L\\{7{u}_{4}(t)\\cdot (t-4)\\} \\\\ L\\{{y}^{″}\\}+16L\\{y\\} & =L\\{7{u}_{4}(t)\\cdot (t-4)\\}\\end{aligned}\n$$\n\nTo calculate $L\\{{y}^{″}\\},$ we use the formula for the Laplace transform of the second derivative and the initial conditions $y(0)=0$ and ${y}^{′}(0)=3:$\n\n$$\nL\\{{y}^{″}\\}={s}^{2}Y(s)-sy(0)-{y}^{′}(0)={s}^{2}Y(s)-3\n$$\n\nTo find the transform of the right-hand side, we note that the term \n\n$$\n7{u}_{4}(t)\\cdot (t-4)\n$$\n\nis in the form $u(t-a)\\cdot f(t)$ where $a=4$ and $f(t)=7(t-4).$\n\nNow, recall that the second shifting theorem (time-shifting property) states\n\n$$\nL\\{u(t-a)\\cdot f(t)\\}={e}^{-as}\\cdot L\\{f(t+a)\\}.\n$$\n\n  \n\nSo, by the second shifting theorem, we have\n\n$$\n\\begin{aligned}L\\{7u(t-4)\\cdot (t-4)\\} & ={e}^{-4s}\\cdot L\\{7((t+4)-4)\\} \\\\  & ={e}^{-4s}\\cdot L\\{7t\\} \\\\  & ={e}^{-4s}\\cdot 7\\cdot \\frac{1!}{{s}^{1+1}} \\\\  & =\\frac{7{e}^{-4s}}{{s}^{2}}.\\end{aligned}\n$$\n\nFinally, we substitute these back into our transformed differential equation:\n\n$$\n\\begin{aligned}L\\{{y}^{″}\\}+16L\\{y\\} & =L\\{7{u}_{4}(t)(t-4)\\} \\\\ {s}^{2}Y(s)-3+16Y(s) & =\\frac{7{e}^{-4s}}{{s}^{2}} \\\\ ({s}^{2}+16)Y(s) & =3+\\frac{7{e}^{-4s}}{{s}^{2}} \\\\ Y(s) & =\\frac{3{s}^{2}+7{e}^{-4s}}{{s}^{2}({s}^{2}+16)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-96d0813c-5c54-5890-9610-b5222646eaaa"] :db/ensure [:question/validate]} {:db/id "answer-field-96d0813c-5c54-5890-9610-b5222646eaaa" :answer-field/id #uuid "96d0813c-5c54-5890-9610-b5222646eaaa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-03a207cf-6ec4-5e6d-997d-39d88a243b9a" :answer-field/choices ["answer-8ddf6de9-76a1-580c-a0a5-04e50833b026" "answer-a5df1187-9902-5a00-900d-f4f5ec5cd0fa" "answer-03a207cf-6ec4-5e6d-997d-39d88a243b9a" "answer-8f14cb64-f15c-5e63-97dc-cb8d52fe503e" "answer-2a4db7a8-b2f3-5998-9cda-8fbb2aabb05f"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ddf6de9-76a1-580c-a0a5-04e50833b026" :answer/id #uuid "8ddf6de9-76a1-580c-a0a5-04e50833b026" :answer/type :answer.type/math :answer/value "Y(s)=\\frac{3s+7{e}^{-4s}}{{s}^{2}({s}^{2}+16)}" :db/ensure [:answer/validate]} {:db/id "answer-a5df1187-9902-5a00-900d-f4f5ec5cd0fa" :answer/id #uuid "a5df1187-9902-5a00-900d-f4f5ec5cd0fa" :answer/type :answer.type/math :answer/value "Y(s)=\\frac{3{s}^{2}+7{e}^{-4s}}{s({s}^{2}+16)}" :db/ensure [:answer/validate]} {:db/id "answer-03a207cf-6ec4-5e6d-997d-39d88a243b9a" :answer/id #uuid "03a207cf-6ec4-5e6d-997d-39d88a243b9a" :answer/type :answer.type/math :answer/value "Y(s)=\\frac{3{s}^{2}+7{e}^{-4s}}{{s}^{2}({s}^{2}+16)}" :db/ensure [:answer/validate]} {:db/id "answer-8f14cb64-f15c-5e63-97dc-cb8d52fe503e" :answer/id #uuid "8f14cb64-f15c-5e63-97dc-cb8d52fe503e" :answer/type :answer.type/math :answer/value "Y(s)=\\frac{3{s}^{2}+7{e}^{-4s}}{{s}^{2}+16}" :db/ensure [:answer/validate]} {:db/id "answer-2a4db7a8-b2f3-5998-9cda-8fbb2aabb05f" :answer/id #uuid "2a4db7a8-b2f3-5998-9cda-8fbb2aabb05f" :answer/type :answer.type/math :answer/value "Y(s)=\\frac{3{s}^{2}+7{e}^{-s}}{{s}^{2}({s}^{2}+16)}" :db/ensure [:answer/validate]} {:db/id 17592186377473 :question/problem "Find the Laplace transform $Y(s)=L\\{y(t)\\}$ if\n\n$$\n{y}^{″}+4{y}^{′}+13y=6{u}_{1}(t)\\operatorname{sin}⁡(3(t-1)),\\,y(0)=0,\\,{y}^{′}(0)=0,\n$$\n\nwhere ${u}_{1}(t)=u(t-1)$ is the unit step function." :question/worked-solution "First, we take the Laplace transform of both sides and use the addition and scalar multiplication properties of the Laplace transform:\n\n$$\n\\begin{aligned}L\\{{y}^{″}+4{y}^{′}+13y\\} & =L\\{6{u}_{1}(t)\\operatorname{sin}⁡(3(t-1))\\} \\\\ L\\{{y}^{″}\\}+4L\\{{y}^{′}\\}+13L\\{y\\} & =L\\{6{u}_{1}(t)\\operatorname{sin}⁡(3(t-1))\\}\\end{aligned}\n$$\n\nTo calculate $L\\{{y}^{′}\\},$ we use the formula for the Laplace transform of the first derivative and the initial condition $y(0)=0$:\n\n$$\nL\\{{y}^{′}\\}=sY(s)-y(0)=sY(s)\n$$\n\nTo calculate $L\\{{y}^{″}\\},$ we use the formula for the Laplace transform of the second derivative and the initial conditions $y(0)=0$ and ${y}^{′}(0)=0$:\n\n$$\nL\\{{y}^{″}\\}={s}^{2}Y(s)-sy(0)-{y}^{′}(0)={s}^{2}Y(s)\n$$\n\nFor the right-hand side, we use the second shifting theorem:\n\n$$\nL\\{u(t-a)f(t-a)\\}={e}^{-as}F(s)\n$$\n\nHere, $a=1$ and $f(t-1)=6\\operatorname{sin}⁡(3(t-1))$, so $f(t)=6\\operatorname{sin}⁡(3t).$ The transform of $f(t)$ is\n\n$$\nF(s)=L\\{6\\operatorname{sin}⁡(3t)\\}=6\\cdot \\frac{3}{{s}^{2}+{3}^{2}}=\\frac{18}{{s}^{2}+9}.\n$$\n\nApplying the shift, we get\n\n$$\nL\\{6{u}_{1}(t)\\operatorname{sin}⁡(3(t-1))\\}={e}^{-s}\\cdot \\frac{18}{{s}^{2}+9}=\\frac{18{e}^{-s}}{{s}^{2}+9}.\n$$\n\nSubstituting these into the differential equation:\n\n$$\n\\begin{aligned}{s}^{2}Y(s)+4sY(s)+13Y(s) & =\\frac{18{e}^{-s}}{{s}^{2}+9} \\\\ ({s}^{2}+4s+13)Y(s) & =\\frac{18{e}^{-s}}{{s}^{2}+9} \\\\ Y(s) & =\\frac{18{e}^{-s}}{({s}^{2}+9)({s}^{2}+4s+13)}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186231434 :knowledge-point/questions ["question-e0f1706f-269a-5658-8fd3-75993082b4c8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186377480 :question/worked-solution "Using the transformed equation, we solve for $Y(s)$:\n\n$$\n\\begin{aligned}({s}^{2}+1)Y(s) & =\\frac{{e}^{-s}}{s} \\\\ Y(s) & ={e}^{-s}\\cdot \\frac{1}{s({s}^{2}+1)}\\end{aligned}\n$$\n\nTo find the inverse transform, we first use partial fraction decomposition on the algebraic part:\n\n$$\n\\frac{1}{s({s}^{2}+1)}=\\frac{A}{s}+\\frac{Bs+C}{{s}^{2}+1}\n$$\n\nSolving for the constants, we find $A=1$, $B=-1$, and $C=0$, giving:\n\n$$\n\\frac{1}{s({s}^{2}+1)}=\\frac{1}{s}-\\frac{s}{{s}^{2}+1}\n$$\n\nNow, we apply the inverse Laplace transform. Let \n\n$$\nF(s)=\\frac{1}{s}-\\frac{s}{{s}^{2}+1},\n$$\n\nthen, we have \n\n$$\nf(t)=1-\\operatorname{cos}⁡(t).\n$$\n\nAccording to the second shifting theorem, \n\n$$\n{L}^{-1}\\{{e}^{-as}F(s)\\}={u}_{a}(t)f(t-a).\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}y(t) & ={L}^{-1}\\{{e}^{-s}(\\frac{1}{s}-\\frac{s}{{s}^{2}+1})\\} \\\\ y(t) & ={u}_{1}(t)(1-\\operatorname{cos}⁡(t-1))\\end{aligned}\n$$\n\n$$\ny(t)=u(t-1)(1-\\operatorname{cos}⁡(t-1)).\n$$" :db/ensure [:question/validate]} {:db/id 17592186377481 :answer-field/correct "answer-143176f2-5f66-5c47-bc95-252c5655a68f" :answer-field/choices ["answer-143176f2-5f66-5c47-bc95-252c5655a68f"] :db/ensure [:answer-field/validate]} {:db/id "answer-143176f2-5f66-5c47-bc95-252c5655a68f" :answer/id #uuid "143176f2-5f66-5c47-bc95-252c5655a68f" :answer/type :answer.type/math :answer/value "1-\\cos(t-1)" :db/ensure [:answer/validate]} {:db/id "question-e0f1706f-269a-5658-8fd3-75993082b4c8" :question/id #uuid "e0f1706f-269a-5658-8fd3-75993082b4c8" :question/math-academy-id "q-345300" :question/problem "Find the solution $y(t)$ given that the Laplace transform of the initial value problem\n\n$$\n{y}^{″}(t)+6{y}^{′}(t)+5y(t)=20{u}_{4}(t),\\,y(0)=0,\\,{y}^{′}(0)=0,\n$$\n\nis given by\n\n$$\n{s}^{2}Y(s)+6sY(s)+5Y(s)=\\frac{20{e}^{-4s}}{s}.\n$$\n\nThe solution is $y(t)=u(t-4)\\cdot (4-5{e}^{-(t-4)}\\,+\\,$\n{{field-1}}\n$).$" :question/worked-solution "Using the transformed equation, we solve for $Y(s)$:\n\n$$\n\\begin{aligned}{s}^{2}Y(s)+6sY(s)+5Y(s) & =\\frac{20{e}^{-4s}}{s} \\\\ ({s}^{2}+6s+5)Y(s) & =\\frac{20{e}^{-4s}}{s} \\\\ (s+1)(s+5)Y(s) & =\\frac{20{e}^{-4s}}{s} \\\\ Y(s) & ={e}^{-4s}\\cdot \\frac{20}{s(s+1)(s+5)}\\end{aligned}\n$$\n\nTo find the inverse transform, we first use partial fraction decomposition on the algebraic part:\n\n$$\n\\frac{20}{s(s+1)(s+5)}=\\frac{A}{s}+\\frac{B}{s+1}+\\frac{C}{s+5}\n$$\n\nSolving for the constants, we find $A=4,$ $B=-5,$ and $C=1,$ giving:\n\n$$\n\\frac{20}{s(s+1)(s+5)}=\\frac{4}{s}-\\frac{5}{s+1}+\\frac{1}{s+5}\n$$\n\nNow, we apply the inverse Laplace transform. Let \n\n$$\nF(s)=\\frac{4}{s}-\\frac{5}{s+1}+\\frac{1}{s+5},\n$$\n\nthen, we have\n\n$$\nf(t)=4-5{e}^{-t}+{e}^{-5t}.\n$$\n\nAccording to the second shifting theorem, \n\n$$\n{L}^{-1}\\{{e}^{-as}F(s)\\}={u}_{a}(t)f(t-a).\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}y(t) & ={L}^{-1}\\{{e}^{-4s}F(s)\\} \\\\ y(t) & ={u}_{4}(t)\\,f(t-4) \\\\ y(t) & =u(t-4)\\cdot (4-5{e}^{-(t-4)}+{e}^{-5(t-4)}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5479ca0e-e235-5daf-9f78-3a7ac798d247"] :db/ensure [:question/validate]} {:db/id "answer-field-5479ca0e-e235-5daf-9f78-3a7ac798d247" :answer-field/id #uuid "5479ca0e-e235-5daf-9f78-3a7ac798d247" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9575d503-b33a-5aaf-a793-2497c79dc90a" :answer-field/choices ["answer-9575d503-b33a-5aaf-a793-2497c79dc90a"] :db/ensure [:answer-field/validate]} {:db/id "answer-9575d503-b33a-5aaf-a793-2497c79dc90a" :answer/id #uuid "9575d503-b33a-5aaf-a793-2497c79dc90a" :answer/type :answer.type/math :answer/value "e^{-5(t-4)}" :db/ensure [:answer/validate]} {:db/id "activity-8b4c0c6e-e1ad-53be-980f-1125809beccc" :activity/id #uuid "8b4c0c6e-e1ad-53be-980f-1125809beccc" :activity/title "Solving Second-Order ODEs With Time-Delayed Forcing Using Laplace Transforms" :activity/type :activity.type/review :activity/scope 17592186049590 :activity/course 17592186046644 :activity/steps ["step-e9df5258-7677-5050-9ab9-8650f43b3255" "step-b8b7f1db-a884-5b7a-8f66-cefcb30e2b44" "step-8ed0242a-2db9-5144-8e11-5ba6887b8361" "step-eb271466-d784-5171-b57b-f15347d64110" "step-99b6edeb-bbfc-5c8b-b1c4-dd5efc3764aa"] :activity/first-step "step-e9df5258-7677-5050-9ab9-8650f43b3255" :db/ensure [:activity/validate]} {:db/id "step-e9df5258-7677-5050-9ab9-8650f43b3255" :step/id #uuid "e9df5258-7677-5050-9ab9-8650f43b3255" :step/content 17592186377459 :step/next "step-b8b7f1db-a884-5b7a-8f66-cefcb30e2b44" :db/ensure [:step/validate]} {:db/id "step-b8b7f1db-a884-5b7a-8f66-cefcb30e2b44" :step/id #uuid "b8b7f1db-a884-5b7a-8f66-cefcb30e2b44" :step/content "question-d2f59173-bdb2-59d3-8bec-268e720e4bf5" :step/next "step-8ed0242a-2db9-5144-8e11-5ba6887b8361" :db/ensure [:step/validate]} {:db/id "step-8ed0242a-2db9-5144-8e11-5ba6887b8361" :step/id #uuid "8ed0242a-2db9-5144-8e11-5ba6887b8361" :step/content 17592186377473 :step/next "step-eb271466-d784-5171-b57b-f15347d64110" :db/ensure [:step/validate]} {:db/id "step-eb271466-d784-5171-b57b-f15347d64110" :step/id #uuid "eb271466-d784-5171-b57b-f15347d64110" :step/content 17592186377480 :step/next "step-99b6edeb-bbfc-5c8b-b1c4-dd5efc3764aa" :db/ensure [:step/validate]} {:db/id "step-99b6edeb-bbfc-5c8b-b1c4-dd5efc3764aa" :step/id #uuid "99b6edeb-bbfc-5c8b-b1c4-dd5efc3764aa" :step/content "question-e0f1706f-269a-5658-8fd3-75993082b4c8" :db/ensure [:step/validate]} {:db/id 17592186124458 :knowledge-point/questions ["question-36bc1d86-9d95-5fad-8592-9df3687ca62a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124459 :knowledge-point/questions ["question-6d63b608-6564-54eb-94c2-8afc07416275" "question-f39e417c-6152-5bd7-a05f-5fd83a9d6cdc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-36bc1d86-9d95-5fad-8592-9df3687ca62a" :question/id #uuid "36bc1d86-9d95-5fad-8592-9df3687ca62a" :question/math-academy-id "q-86533" :question/problem "Find the directional derivative of the function $f(x,y)=(2{x}^{2}-3{y}^{2})^{2}$ at the point $A(-1,-1)$ in the direction towards the point $B(2,0).$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,0⟩-⟨-1,-1⟩ \\\\  & =⟨3,1⟩ \\\\ u & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{{3}^{2}+{1}^{2}}}⟨3,1⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨3,1⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $∇f(x,y)$ and evaluate it at the point $A(-1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2})^{2},\\,\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2})^{2}⟩ \\\\  & =⟨8x(2{x}^{2}-3{y}^{2}),\\,36{y}^{3}-24{x}^{2}y⟩ \\\\ ∇f(-1,-1) & =⟨8(-1)\\cdot (2(-1)^{2}-3(-1)^{2}),36(-1)^{3}-24(-1)^{2}(-1)⟩ \\\\  & =⟨8,-12⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(-1,-1) & =∇f(-1,-1)\\cdot u \\\\  & =⟨8,-12⟩\\cdot ⟨\\frac{3}{\\sqrt{10}},\\frac{1}{\\sqrt{10}}⟩ \\\\  & =8\\cdot \\frac{3}{\\sqrt{10}}-12\\cdot \\frac{1}{\\sqrt{10}} \\\\  & =\\frac{12}{\\sqrt{10}} \\\\  & =\\frac{6\\sqrt{10}}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fa6bc3a1-b754-5de6-a15a-17b5690dd1bc"] :db/ensure [:question/validate]} {:db/id "answer-field-fa6bc3a1-b754-5de6-a15a-17b5690dd1bc" :answer-field/id #uuid "fa6bc3a1-b754-5de6-a15a-17b5690dd1bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a89bbd5-05e0-5b9e-875f-8fbff4dcb441" :answer-field/choices ["answer-636cdbc8-2c6a-553b-a040-1b1eb24c4aed" "answer-3a8dff85-9179-52c1-a1eb-e2b80b8d392e" "answer-070f81d7-bbdd-59f5-971a-c1e85fd656fd" "answer-9a89bbd5-05e0-5b9e-875f-8fbff4dcb441" "answer-05e252ff-bff2-5a0c-8722-678c22a7c16c"] :db/ensure [:answer-field/validate]} {:db/id "answer-636cdbc8-2c6a-553b-a040-1b1eb24c4aed" :answer/id #uuid "636cdbc8-2c6a-553b-a040-1b1eb24c4aed" :answer/type :answer.type/math :answer/value "-\\frac{3\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-3a8dff85-9179-52c1-a1eb-e2b80b8d392e" :answer/id #uuid "3a8dff85-9179-52c1-a1eb-e2b80b8d392e" :answer/type :answer.type/math :answer/value "-\\frac{5\\sqrt{10}}{6}" :db/ensure [:answer/validate]} {:db/id "answer-070f81d7-bbdd-59f5-971a-c1e85fd656fd" :answer/id #uuid "070f81d7-bbdd-59f5-971a-c1e85fd656fd" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{10}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9a89bbd5-05e0-5b9e-875f-8fbff4dcb441" :answer/id #uuid "9a89bbd5-05e0-5b9e-875f-8fbff4dcb441" :answer/type :answer.type/math :answer/value "\\frac{6\\sqrt{10}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-05e252ff-bff2-5a0c-8722-678c22a7c16c" :answer/id #uuid "05e252ff-bff2-5a0c-8722-678c22a7c16c" :answer/type :answer.type/math :answer/value "\\frac{6\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "question-6d63b608-6564-54eb-94c2-8afc07416275" :question/id #uuid "6d63b608-6564-54eb-94c2-8afc07416275" :question/math-academy-id "q-86540" :question/problem "In what direction does the function $g(x,y,z)=4{z}^{2}+2\\operatorname{ln}⁡(x-y)$ increase most rapidly at the point $(2,-1,0)?$" :question/worked-solution "At a given point, a function $g(x,y,z)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇g(x,y,z)$ and evaluate it at the point $(2,-1,0):$\n\n$$\n\\begin{aligned}∇g(x,y,z) & =⟨\\frac{∂}{∂x}(4{z}^{2}+2\\operatorname{ln}⁡(x-y)),\\,\\frac{∂}{∂y}(4{z}^{2}+2\\operatorname{ln}⁡(x-y)),\\,\\frac{∂}{∂z}(4{z}^{2}+2\\operatorname{ln}⁡(x-y))⟩ \\\\  & =⟨\\frac{2}{x-y},\\,-\\frac{2}{x-y},\\,8z⟩ \\\\ ∇g(2,-1,0) & =⟨\\frac{2}{2-(-1)},\\,-\\frac{2}{2-(-1)},\\,8\\cdot 0⟩ \\\\  & =⟨\\frac{2}{3},\\,-\\frac{2}{3},\\,0⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $⟨\\frac{2}{3},\\,-\\frac{2}{3},\\,0⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-082380e4-f20f-513e-9d31-b936b5054d9b"] :db/ensure [:question/validate]} {:db/id "answer-field-082380e4-f20f-513e-9d31-b936b5054d9b" :answer-field/id #uuid "082380e4-f20f-513e-9d31-b936b5054d9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac6eb5e3-7ae1-506a-bc7d-d480b4fe04c6" :answer-field/choices ["answer-5e8ca8f9-1d26-55d7-9b86-8c52d09b0ce5" "answer-ac6eb5e3-7ae1-506a-bc7d-d480b4fe04c6" "answer-c9a6152f-0b20-5bb6-96d5-09c1f86baab1" "answer-eac115c2-4ed8-51a6-aa73-4f0569e0d56e" "answer-a9ea4930-c661-5fcb-a591-ae748e162fef"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e8ca8f9-1d26-55d7-9b86-8c52d09b0ce5" :answer/id #uuid "5e8ca8f9-1d26-55d7-9b86-8c52d09b0ce5" :answer/type :answer.type/math :answer/value "-⟨\\frac{2}{3},\\,\\frac{2}{3},\\,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-ac6eb5e3-7ae1-506a-bc7d-d480b4fe04c6" :answer/id #uuid "ac6eb5e3-7ae1-506a-bc7d-d480b4fe04c6" :answer/type :answer.type/math :answer/value "⟨\\frac{2}{3},\\,-\\frac{2}{3},\\,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-c9a6152f-0b20-5bb6-96d5-09c1f86baab1" :answer/id #uuid "c9a6152f-0b20-5bb6-96d5-09c1f86baab1" :answer/type :answer.type/math :answer/value "⟨\\frac{2}{3},\\,-\\frac{2}{3},\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-eac115c2-4ed8-51a6-aa73-4f0569e0d56e" :answer/id #uuid "eac115c2-4ed8-51a6-aa73-4f0569e0d56e" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{2},\\,-\\frac{2}{3},\\,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-a9ea4930-c661-5fcb-a591-ae748e162fef" :answer/id #uuid "a9ea4930-c661-5fcb-a591-ae748e162fef" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{2},\\,\\frac{3}{2},\\,0⟩" :db/ensure [:answer/validate]} {:db/id "question-f39e417c-6152-5bd7-a05f-5fd83a9d6cdc" :question/id #uuid "f39e417c-6152-5bd7-a05f-5fd83a9d6cdc" :question/math-academy-id "q-130272" :question/problem "In what direction does the function $g(x,y,z)=x{z}^{2}-{y}^{3}$ increase most rapidly at the point $(0,1,2)?$" :question/worked-solution "At a given point, a function $g(x,y,z)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇g(x,y,z)$ and evaluate it at the point $(0,1,2):$\n\n$$\n\\begin{aligned}∇g(x,y,z) & =⟨\\frac{∂}{∂x}(x{z}^{2}-{y}^{3}),\\,\\frac{∂}{∂y}(x{z}^{2}-{y}^{3}),\\,\\frac{∂}{∂z}(x{z}^{2}-{y}^{3})⟩ \\\\  & =⟨{z}^{2},\\,-3{y}^{2},\\,2xz⟩ \\\\ ∇g(0,1,2) & =⟨{2}^{2},-3(1)^{2},2(0)(2)⟩ \\\\  & =⟨4,-3,0⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $⟨4,-3,0⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9a0c283d-e80d-5a92-84dc-65204c4fbaa7"] :db/ensure [:question/validate]} {:db/id "answer-field-9a0c283d-e80d-5a92-84dc-65204c4fbaa7" :answer-field/id #uuid "9a0c283d-e80d-5a92-84dc-65204c4fbaa7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-215d83fe-4933-5de8-986e-15f0aee87618" :answer-field/choices ["answer-2d55e643-74fe-5152-bfd8-c76baf2debc2" "answer-f5758c55-ad74-5dfd-b215-f4a7c6749383" "answer-6b204e6b-3938-557e-9c36-e6465fac0526" "answer-9c5a1144-2bb6-52a6-ae6a-f5e1b580463b" "answer-215d83fe-4933-5de8-986e-15f0aee87618"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d55e643-74fe-5152-bfd8-c76baf2debc2" :answer/id #uuid "2d55e643-74fe-5152-bfd8-c76baf2debc2" :answer/type :answer.type/math :answer/value "⟨-3,-1,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-f5758c55-ad74-5dfd-b215-f4a7c6749383" :answer/id #uuid "f5758c55-ad74-5dfd-b215-f4a7c6749383" :answer/type :answer.type/math :answer/value "⟨0,3,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-6b204e6b-3938-557e-9c36-e6465fac0526" :answer/id #uuid "6b204e6b-3938-557e-9c36-e6465fac0526" :answer/type :answer.type/math :answer/value "⟨1,2,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-9c5a1144-2bb6-52a6-ae6a-f5e1b580463b" :answer/id #uuid "9c5a1144-2bb6-52a6-ae6a-f5e1b580463b" :answer/type :answer.type/math :answer/value "⟨2,0,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-215d83fe-4933-5de8-986e-15f0aee87618" :answer/id #uuid "215d83fe-4933-5de8-986e-15f0aee87618" :answer/type :answer.type/math :answer/value "⟨4,-3,0⟩" :db/ensure [:answer/validate]} {:db/id 17592186138415 :knowledge-point/questions ["question-11ab4bcc-ff94-5b73-9790-5edd61c08193"] :db/ensure [:knowledge-point/validate]} {:db/id "question-11ab4bcc-ff94-5b73-9790-5edd61c08193" :question/id #uuid "11ab4bcc-ff94-5b73-9790-5edd61c08193" :question/math-academy-id "q-115488" :question/problem "Consider the table below. Which of the following is a true statement about the relationship between $x$ and $y?$\n\n| $\\,x\\,$ | $\\,y\\,$ |\n| --- | --- |\n| $0.5$ | $20$ |\n| $2$ | $5$ |\n| $4$ | $2.5$ |" :question/worked-solution "If $y$ varies inversely with $x,$ then we must have\n\n$$\ny=\\frac{k}{x}.\n$$\n\nfor some constant $k.$ Note that we can rewrite the above equation as follows.\n\n$$\nx\\cdot y=k\n$$\n\nSo, we will compute $x\\cdot y=k$ for each row in the table. If we get the same value of $k$ for each row, then we can conclude that $y$ is inversely proportional to $x.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $x\\cdot y=k$ |\n| --- | --- | --- |\n| $0.5$ | $20$ | $0.5\\cdot 20=10$ |\n| $2$ | $5$ | $2\\cdot 5=10$ |\n| $4$ | $2.5$ | $4\\cdot 2.5=10$ |\n\nThe results are all the same: in each row, we have $k=10.$ Therefore, $y$ varies inversely with $x,$ and the constant of variation is $k=10.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f89a1044-5822-5030-9b03-184a93ebec0d"] :db/ensure [:question/validate]} {:db/id "answer-field-f89a1044-5822-5030-9b03-184a93ebec0d" :answer-field/id #uuid "f89a1044-5822-5030-9b03-184a93ebec0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aef8d086-e3c3-5c2f-b73f-df730fbb213a" :answer-field/choices ["answer-763b9117-6856-5174-865d-697d35865dd8" "answer-aef8d086-e3c3-5c2f-b73f-df730fbb213a" "answer-b9b86d47-b504-5381-aaca-f8c9b8bcb39f" "answer-f07b6d5a-a5a6-55bc-bf86-f6c9b061a44a" "answer-1039e812-9a88-5b9b-b551-269c2393b23c"] :db/ensure [:answer-field/validate]} {:db/id "answer-763b9117-6856-5174-865d-697d35865dd8" :answer/id #uuid "763b9117-6856-5174-865d-697d35865dd8" :answer/type :answer.type/text :answer/value "$y$ does not vary inversely with $x$" :db/ensure [:answer/validate]} {:db/id "answer-aef8d086-e3c3-5c2f-b73f-df730fbb213a" :answer/id #uuid "aef8d086-e3c3-5c2f-b73f-df730fbb213a" :answer/type :answer.type/text :answer/value "$y$ is inversely proportional to $x$ with a constant of variation $k=10$" :db/ensure [:answer/validate]} {:db/id "answer-b9b86d47-b504-5381-aaca-f8c9b8bcb39f" :answer/id #uuid "b9b86d47-b504-5381-aaca-f8c9b8bcb39f" :answer/type :answer.type/text :answer/value "$y$ is inversely proportional to $x$ with a constant of variation $k=2$" :db/ensure [:answer/validate]} {:db/id "answer-f07b6d5a-a5a6-55bc-bf86-f6c9b061a44a" :answer/id #uuid "f07b6d5a-a5a6-55bc-bf86-f6c9b061a44a" :answer/type :answer.type/text :answer/value "$y$ is inversely proportional to $x$ with a constant of variation $k=4$" :db/ensure [:answer/validate]} {:db/id "answer-1039e812-9a88-5b9b-b551-269c2393b23c" :answer/id #uuid "1039e812-9a88-5b9b-b551-269c2393b23c" :answer/type :answer.type/text :answer/value "$y$ is inversely proportional to $x$ with a constant of variation $k=5$" :db/ensure [:answer/validate]} {:db/id 17592186138416 :knowledge-point/questions ["question-cf708341-904e-56d2-b929-e74c203d19a7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cf708341-904e-56d2-b929-e74c203d19a7" :question/id #uuid "cf708341-904e-56d2-b929-e74c203d19a7" :question/math-academy-id "q-115589" :question/problem "![](images/96/9674072fe2d9f831635dfd2994b97ea6e9603dd576586f80e4b1b2e6a2373564.png)\n\nThe graph above shows the relationship between $x$ and $y.$ Given that $y$ is inversely proportional to $x,$ find the value of $a.$" :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nIn the graph, we notice a point with $y=\\frac{1}{2}$ and $x=5.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{k}{5} \\\\ \\frac{1}{2}\\cdot 5 & =k \\\\ \\frac{5}{2} & =k\\end{aligned}\n$$\n\nTherefore, the inverse variation equation that relates $y$ and $x$ is\n\n$$\ny=\\frac{(\\frac{5}{2})}{x}=\\frac{5}{2x}.\n$$\n\nFrom the graph, we also have that $y=\\frac{5}{2}$ when $x=a.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{5}{2} & =\\frac{5}{2a} \\\\ 10a & =10 \\\\ a & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d155659c-c17e-5eca-b3d0-23cecfde70bc"] :db/ensure [:question/validate]} {:db/id "answer-field-d155659c-c17e-5eca-b3d0-23cecfde70bc" :answer-field/id #uuid "d155659c-c17e-5eca-b3d0-23cecfde70bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72cc3a7f-05b3-50d0-8c4f-4aedc32143ca" :answer-field/choices ["answer-72cc3a7f-05b3-50d0-8c4f-4aedc32143ca" "answer-2c3f1cdb-62a7-5446-bfc0-9c5b8ecff4dd" "answer-37c06ed4-4dac-5a25-bb1d-90e1da0780f8" "answer-08ff8e18-e1e0-569c-b239-ea2d323c2f96" "answer-3d5ad2d6-7a2b-58fa-9b9e-b5cfbe4b0f29"] :db/ensure [:answer-field/validate]} {:db/id "answer-72cc3a7f-05b3-50d0-8c4f-4aedc32143ca" :answer/id #uuid "72cc3a7f-05b3-50d0-8c4f-4aedc32143ca" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-2c3f1cdb-62a7-5446-bfc0-9c5b8ecff4dd" :answer/id #uuid "2c3f1cdb-62a7-5446-bfc0-9c5b8ecff4dd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-37c06ed4-4dac-5a25-bb1d-90e1da0780f8" :answer/id #uuid "37c06ed4-4dac-5a25-bb1d-90e1da0780f8" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-08ff8e18-e1e0-569c-b239-ea2d323c2f96" :answer/id #uuid "08ff8e18-e1e0-569c-b239-ea2d323c2f96" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3d5ad2d6-7a2b-58fa-9b9e-b5cfbe4b0f29" :answer/id #uuid "3d5ad2d6-7a2b-58fa-9b9e-b5cfbe4b0f29" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id 17592186138414 :knowledge-point/questions ["question-1c37fb77-7c99-58f3-b32e-45223dbee74b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1c37fb77-7c99-58f3-b32e-45223dbee74b" :question/id #uuid "1c37fb77-7c99-58f3-b32e-45223dbee74b" :question/math-academy-id "q-217248" :question/problem "Suppose that $y$ varies inversely with $x$ and that $y=\\frac{3}{4}$ when $x=12.$ Then, if $x=\\frac{1}{3},$ $y=${{field-1}}." :question/worked-solution "Since $y$ varies inversely with $x,$ we use the equation\n\n$$\ny=\\frac{k}{x}.\n$$\n\nWe are told that $y=\\frac{3}{4}$ when $x=12.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}\\frac{3}{4} & =\\frac{k}{12} \\\\ \\frac{3}{4}\\cdot 12 & =k \\\\ 9 & =k\\end{aligned}\n$$\n\nSo, the inverse variation is given by \n\n$$\ny=\\frac{9}{x}.\n$$\n\nFinally, substituting the value of $x=\\frac{1}{3}$ into this equation gives\n\n$$\n\\begin{aligned}y & =\\frac{9}{(\\frac{1}{3})} \\\\  & =9÷(\\frac{1}{3}) \\\\  & =9\\cdot (\\frac{3}{1}) \\\\  & =27.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d7f79e97-d630-5908-a05a-ee3b6a7eb854"] :db/ensure [:question/validate]} {:db/id "answer-field-d7f79e97-d630-5908-a05a-ee3b6a7eb854" :answer-field/id #uuid "d7f79e97-d630-5908-a05a-ee3b6a7eb854" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c1e2c107-9d5e-504f-af80-17ffca1d2a08" :answer-field/choices ["answer-c1e2c107-9d5e-504f-af80-17ffca1d2a08"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1e2c107-9d5e-504f-af80-17ffca1d2a08" :answer/id #uuid "c1e2c107-9d5e-504f-af80-17ffca1d2a08" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "activity-2fbef69a-88c5-5d96-acb5-ba687d9fd119" :activity/id #uuid "2fbef69a-88c5-5d96-acb5-ba687d9fd119" :activity/title "Inverse Variation" :activity/type :activity.type/review :activity/scope 17592186049369 :activity/course 17592186046647 :activity/steps ["step-e3cb0b4d-15dc-5baa-9658-0e5055d4371c" "step-47c6ba42-9469-510d-8375-d74fdf459167" "step-946d1bf9-981b-5a6b-afb7-e0f580f11f36"] :activity/first-step "step-e3cb0b4d-15dc-5baa-9658-0e5055d4371c" :db/ensure [:activity/validate]} {:db/id "step-e3cb0b4d-15dc-5baa-9658-0e5055d4371c" :step/id #uuid "e3cb0b4d-15dc-5baa-9658-0e5055d4371c" :step/content "question-11ab4bcc-ff94-5b73-9790-5edd61c08193" :step/next "step-47c6ba42-9469-510d-8375-d74f