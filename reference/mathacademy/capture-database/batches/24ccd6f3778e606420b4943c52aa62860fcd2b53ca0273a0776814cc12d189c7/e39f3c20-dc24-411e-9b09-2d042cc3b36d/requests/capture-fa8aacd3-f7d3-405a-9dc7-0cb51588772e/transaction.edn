" "question-b6d906ea-b787-55f0-a205-6b6f9a337939" "question-533e8f29-fadf-5200-8bf2-91c4cb3d254a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-694684ae-3bf6-514c-9bb8-aef47c5c19c7" :question/id #uuid "694684ae-3bf6-514c-9bb8-aef47c5c19c7" :question/math-academy-id "q-68552" :question/problem "At a convenience store, a $5$-pound canister of licorice candy costs $$11.20.$ What's the unit price per ounce?\n\nAssume that there are $16$ ounces in one pound." :question/worked-solution "First, we convert from pounds to ounces. There are $16$ ounces in each pound, so we multiply the number of pounds  by $16:$  \n\n$$\n5\\times 16=80\n$$\n\nSo, $5$ pounds is the same as $80$ ounces. Now, to find the unit price per ounce, we divide the total price by $80:$  \n\n$$\n11.20÷80=0.14\n$$\n\nTherefore, the licorice candy costs $$0.14$ per ounce." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-311b09e1-10eb-57ba-a434-9673ef28e54e"] :db/ensure [:question/validate]} {:db/id "answer-field-311b09e1-10eb-57ba-a434-9673ef28e54e" :answer-field/id #uuid "311b09e1-10eb-57ba-a434-9673ef28e54e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ed1a0d7c-ec15-522b-ac53-db82ebbd0e01" :answer-field/choices ["answer-ff5451f8-2cb8-55fb-8a4c-45725471904d" "answer-ed1a0d7c-ec15-522b-ac53-db82ebbd0e01" "answer-907d0e63-aa0e-53bd-ad9a-b19ed25389a5" "answer-6d715d96-7916-5406-9aba-de7f90a6a3bf" "answer-c0451957-dac5-5dee-8df2-a6987aa7df86"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff5451f8-2cb8-55fb-8a4c-45725471904d" :answer/id #uuid "ff5451f8-2cb8-55fb-8a4c-45725471904d" :answer/type :answer.type/text :answer/value "$$0.12$ per ounce" :db/ensure [:answer/validate]} {:db/id "answer-ed1a0d7c-ec15-522b-ac53-db82ebbd0e01" :answer/id #uuid "ed1a0d7c-ec15-522b-ac53-db82ebbd0e01" :answer/type :answer.type/text :answer/value "$$0.14$ per ounce" :db/ensure [:answer/validate]} {:db/id "answe