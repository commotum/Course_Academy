5-5231-9823-9b70074e18f6" :answer-field/choices ["answer-b07f2caf-1bf7-5a26-ba31-7455fbda5e3c" "answer-ea01e92b-e8f5-5231-9823-9b70074e18f6" "answer-3c29c508-ed39-5d19-8512-7d756ca4995b" "answer-17baf155-e96d-5274-8ea7-340ef7f9bd6f" "answer-acd1e707-0b6f-5e39-905c-184792e0cf81"] :db/ensure [:answer-field/validate]} {:db/id "answer-b07f2caf-1bf7-5a26-ba31-7455fbda5e3c" :answer/id #uuid "b07f2caf-1bf7-5a26-ba31-7455fbda5e3c" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "answer-ea01e92b-e8f5-5231-9823-9b70074e18f6" :answer/id #uuid "ea01e92b-e8f5-5231-9823-9b70074e18f6" :answer/type :answer.type/math :answer/value "x=16" :db/ensure [:answer/validate]} {:db/id "answer-3c29c508-ed39-5d19-8512-7d756ca4995b" :answer/id #uuid "3c29c508-ed39-5d19-8512-7d756ca4995b" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-17baf155-e96d-5274-8ea7-340ef7f9bd6f" :answer/id #uuid "17baf155-e96d-5274-8ea7-340ef7f9bd6f" :answer/type :answer.type/math :answer/value "x=8" :db/ensure [:answer/validate]} {:db/id "answer-acd1e707-0b6f-5e39-905c-184792e0cf81" :answer/id #uuid "acd1e707-0b6f-5e39-905c-184792e0cf81" :answer/type :answer.type/text :answer/value "The function has no roots" :db/ensure [:answer/validate]} {:db/id "question-01c856f3-ee69-579a-9f89-fe0fbee2a037" :question/id #uuid "01c856f3-ee69-579a-9f89-fe0fbee2a037" :question/math-academy-id "q-277239" :question/problem "Find the root of $f(x)=\\sqrt[9]{-8-3x}+2.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the root of $f(x),$ we must solve $f(x)=0:$\n\n$$\n\\sqrt[9]{-8-3x}+2=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[9]{-8-3x}+2 & =0 \\\\ \\sqrt[9]{-8-3x} & =-2 \\\\ (\\sqrt[9]{-8-3x})^{9} & =(-2)^{9} \\\\ -8-3x & =-512 \\\\ -3x & =-504 \\\\ x & =168\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=168.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cab81f3e-8bfa-5ab8-83cb-9612dc5b0919"] :db/ensure [:question/validate]} {:db/id "answer-field-cab81f3e-8bfa-5ab8-83cb-9612dc5b0919" :answer-field/id #uuid "cab81f3e-8bfa-5ab8-83cb-9612dc5b0919" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7adc2636-e70e-5248-aa1c-0bb461a58b6c" :answer-field/choices ["answer-7adc2636-e70e-5248-aa1c-0bb461a58b6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-7adc2636-e70e-5248-aa1c-0bb461a58b6c" :answer/id #uuid "7adc2636-e70e-5248-aa1c-0bb461a58b6c" :answer/type :answer.type/math :answer/value "168" :db/ensure [:answer/validate]} {:db/id "question-f9219fe2-5911-57bb-89ea-30d2a8256e49" :question/id #uuid "f9219fe2-5911-57bb-89ea-30d2a8256e49" :question/math-academy-id "q-277249" :question/problem "Find the root of $f(x)=\\sqrt[4]{3x+15}-3.$\n\n$x=$\n{{field-1}}" :question/worked-solution "To find the roots of $f(x),$ we must solve $f(x)=0:$\n\n$$\n\\sqrt[4]{3x+15}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[4]{3x+15}-3 & =0 \\\\ \\sqrt[4]{3x+15} & =3 \\\\ (\\sqrt[4]{3x+15})^{4} & ={3}^{4} \\\\ 3x+15 & =81 \\\\ 3x & =66 \\\\ x & =22\\end{aligned}\n$$\n\nFinally, we must check the answer by substituting it back into the initial equation:\n\n$$\n\\begin{aligned}\\sqrt[4]{3\\cdot 22+15}-3 & =0 \\\\ \\sqrt[4]{81}-3 & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=22.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7e943489-95ee-51af-889d-7b6b40dcc312"] :db/ensure [:question/validate]} {:db/id "answer-field-7e943489-95ee-51af-889d-7b6b40dcc312" :answer-field/id #uuid "7e943489-95ee-51af-889d-7b6b40dcc312" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a81b0420-9f65-531f-8353-eb44098ecd4f" :answer-field/choices ["answer-a81b0420-9f65-531f-8353-eb44098ecd4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a81b0420-9f65-531f-8353-eb44098ecd4f" :answer/id #uuid "a81b0420-9f65-531f-8353-eb44098ecd4f" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "activity-c0330bc3-207b-51d0-a316-d2214c7dcda9" :activity/id #uuid "c0330bc3-207b-51d0-a316-d2214c7dcda9" :activity/title "Roots of Transformed Radical Functions" :activity/type :activity.type/review :activity/scope 17592186049387 :activity/course 17592186046647 :activity/steps ["step-48c4878d-1971-57c2-a2fe-4c7e737d2430" "step-83619bcc-b587-5fd0-a67b-67d9fe91b956" "step-7d5b77cf-1d20-558c-85b8-c6f2f795dd91" "step-39c4e283-d4d3-5d87-9aad-815227ed7633" "step-37545647-d742-511f-9014-7665d83e5c8e"] :activity/first-step "step-48c4878d-1971-57c2-a2fe-4c7e737d2430" :db/ensure [:activity/validate]} {:db/id "step-48c4878d-1971-57c2-a2fe-4c7e737d2430" :step/id #uuid "48c4878d-1971-57c2-a2fe-4c7e737d2430" :step/content "question-442d41d4-64b6-5c13-9965-e1b753377abb" :step/next "step-83619bcc-b587-5fd0-a67b-67d9fe91b956" :db/ensure [:step/validate]} {:db/id "step-83619bcc-b587-5fd0-a67b-67d9fe91b956" :step/id #uuid "83619bcc-b587-5fd0-a67b-67d9fe91b956" :step/content "question-a9239051-66d6-5587-8b77-ad2324021796" :step/next "step-7d5b77cf-1d20-558c-85b8-c6f2f795dd91" :db/ensure [:step/validate]} {:db/id "step-7d5b77cf-1d20-558c-85b8-c6f2f795dd91" :step/id #uuid "7d5b77cf-1d20-558c-85b8-c6f2f795dd91" :step/content "question-4df596f3-7605-5476-aed1-e33a4f9ad66d" :step/next "step-39c4e283-d4d3-5d87-9aad-815227ed7633" :db/ensure [:step/validate]} {:db/id "step-39c4e283-d4d3-5d87-9aad-815227ed7633" :step/id #uuid "39c4e283-d4d3-5d87-9aad-815227ed7633" :step/content "question-01c856f3-ee69-579a-9f89-fe0fbee2a037" :step/next "step-37545647-d742-511f-9014-7665d83e5c8e" :db/ensure [:step/validate]} {:db/id "step-37545647-d742-511f-9014-7665d83e5c8e" :step/id #uuid "37545647-d742-511f-9014-7665d83e5c8e" :step/content "question-f9219fe2-5911-57bb-89ea-30d2a8256e49" :db/ensure [:step/validate]} {:db/id "activity-bbfb7477-4df3-54f9-816d-7079bb7ccdb5" :activity/id #uuid "bbfb7477-4df3-54f9-816d-7079bb7ccdb5" :activity/title "Projecting Vectors Onto Subspaces in Euclidean Spaces (Orthogonal Bases)" :activity/type :activity.type/review :activity/scope 17592186050009 :activity/course 17592186046658 :activity/steps ["step-8cbfaad6-111b-5df3-a75e-eaea87d46a27" "step-9a954e68-cdd4-5512-849a-e55e14c3f96e" "step-09b16e88-2f98-5aaf-bffe-a62e02c9e116" "step-da850a2d-b4a4-514e-8e22-54970af07ef4" "step-34f06a09-2bb5-52ef-b3bd-ef481b42fe50"] :activity/first-step "step-8cbfaad6-111b-5df3-a75e-eaea87d46a27" :db/ensure [:activity/validate]} {:db/id "step-8cbfaad6-111b-5df3-a75e-eaea87d46a27" :step/id #uuid "8cbfaad6-111b-5df3-a75e-eaea87d46a27" :step/content 17592186326862 :step/next "step-9a954e68-cdd4-5512-849a-e55e14c3f96e" :db/ensure [:step/validate]} {:db/id "step-9a954e68-cdd4-5512-849a-e55e14c3f96e" :step/id #uuid "9a954e68-cdd4-5512-849a-e55e14c3f96e" :step/content 17592186351337 :step/next "step-09b16e88-2f98-5aaf-bffe-a62e02c9e116" :db/ensure [:step/validate]} {:db/id "step-09b16e88-2f98-5aaf-bffe-a62e02c9e116" :step/id #uuid "09b16e88-2f98-5aaf-bffe-a62e02c9e116" :step/content 17592186373285 :step/next "step-da850a2d-b4a4-514e-8e22-54970af07ef4" :db/ensure [:step/validate]} {:db/id "step-da850a2d-b4a4-514e-8e22-54970af07ef4" :step/id #uuid "da850a2d-b4a4-514e-8e22-54970af07ef4" :step/content 17592186351463 :step/next "step-34f06a09-2bb5-52ef-b3bd-ef481b42fe50" :db/ensure [:step/validate]} {:db/id "step-34f06a09-2bb5-52ef-b3bd-ef481b42fe50" :step/id #uuid "34f06a09-2bb5-52ef-b3bd-ef481b42fe50" :step/content 17592186351464 :db/ensure [:step/validate]} {:db/id 17592186100935 :knowledge-point/questions ["question-1fbb657d-32e1-57fb-9710-afc011b6ab8e" "question-5e28fed1-97b3-526c-8da9-ef22fe1e5ddd" "question-5b66ab71-e5ba-5e8c-8d29-3a56ef93e008" "question-7bca001f-f1ef-5c7b-838d-dca97d1b4371" "question-451559e6-da00-5040-a946-bd30072c74e4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100766 :question/problem "The graph of $y=f'(x),$ the derivative of $f(x),$ is shown below. Given that $f(0)=0,$ sketch a possible graph of $y=f(x).$\n\n![](images/ef/ef91945c0b2261785677c4c8ba7e6d202f62bc6c2da20a213bcba03cbcad8556.png)" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when $f'(x)=0$ or $f'(x)$ does not exist. In our case, there is one critical point:\n\n$$\nx=-2\n$$\n\nAlso, we have the following: \n\n- If $f'(x) > 0$ then $f(x)$ is increasing.\n\n- If $f'(x) <          0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty,-2)$ | $-2$ | $(-2,\\infty)$ |\n| --- | --- | --- | --- |\n| $f'$ | $-$ | $0$ | $+$ |\n| $f$ | $\\searrow$ | $\\textrm{min}$ | $\\nearrow$ |\n\nLet's now sketch the graph of $y=f(x)\\mathbin{:}$\n\n- First, we draw the critical point. Consider the vertical line $x=-2.$\n\n- Since we are told that $f(0)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is increasing $\\nearrow$ on $(-2,\\infty),$ the point at $x=-2$ must be lower than the point at $x=0.$\n\n![](images/4b/4b599481e7a73ec38b6f0f627b1b9a551c65e6cd3875b3789f0e7ebfa03eb786.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical point:\n\n- Since $f(x)$ is decreasing $\\searrow$ on $(-\\infty,-2)$ and increasing $\\nearrow$ on $(-2,\\infty)$, the graph of $y=f(x)$ goes up to the left and to the right of $x=-2.$\n\n![](images/1a/1ae0017fd07d6e9fa04f233ca31ab89a07260a5dbc5557e4c8ae35ff91d61f43.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x)\\mathbin{:}$\n\n![](images/c2/c215907aa0cc156e92ab3b6710d844e774df3149656fc2f71f27ee01db87382e.png)" :db/ensure [:question/validate]} {:db/id 17592186100829 :knowledge-point/questions ["question-01274ce5-42e5-5d91-b593-1351d7ffb44f" "question-e89c21de-ead1-56e3-b348-ff522b66f5d8" "question-5f23ce06-592e-5661-a235-01cdcf7c430f" "question-06d5e4de-57e7-5985-961d-b5e59bdab913"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100640 :question/problem "The graph of $y=f'(x),$ the derivative of $f(x),$ is shown below. Sketch a possible graph of $y=f(x).$\n\n![](images/e3/e3feb58766bbbb4dc2ed0cd738c7a5d74d31a6d3bbc2e210010b9e5ecbc21da8.png)" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when $f'(x)=0$ or $f'(x)$ does not exist. In our case, there are two critical points: \n\n$$\nx=-1\\quad \\text{and} \\quad x=1\n$$\n\nAlso, we have the following: \n\n- If $f'(x) > 0$ then $f(x)$ is increasing.\n\n- If $f'(x) <         0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty,-1)$ | $-1$ | $(-1,1)$ | $1$ | $(1,\\infty)$ |\n| --- | --- | --- | --- | --- | --- |\n| $f'$ | $+$ | $0$ | $-$ | $0$ | $-$ |\n| $f$ | $\\nearrow$ | $\\textrm{max}$ | $\\searrow$ | $\\textrm{not extr.}$ | $\\searrow$ |\n\nLet's now sketch the graph of $y=f(x)\\mathbin{:}$\n\n- First, we draw the critical points. We choose an arbitrary point on the vertical lines $x=-1$ and $x=1.$ Since $f(x)$ is decreasing $\\searrow$ on $(-1,1),$ the point at $x=1$ must be lower than the point at $x=-1,$ as shown below.\n\n![](images/27/27cfed2793c78d0abaa91c4d5480724303ebf729fa22befbd6142e8e54039e64.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $\\nearrow$ on $(-\\infty,-1)$ and decreasing $\\searrow$ on $(-1,1)$, the graph of $y=f(x)$ goes down to the left and the right of $x=-1.$\n\n- Since $f(x)$ is decreasing $\\searrow$ on $(-1,1)$ and decreasing $\\searrow$ on $(1,\\infty)$, the graph of $y=f(x)$ goes up to the left and goes down to the right of $x=1.$\n\n- Furthermore, since $f'(x)$ is increasing to the left of $x = 1$, we must have $f''(x) >       0$, and, since it is decreasing to the right of $x = 1$, we must have $f''(x) <    0.$ So, $x =1$ is an inflection point at which the curve $y=f(x)$ changes from concave up to concave down.\n\n![](images/15/15842026cf3d019dcfd31c0f4f9aad54a4c8465dc1464feaa2d07b45e109ef74.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x)\\mathbin{:}$\n\n![](images/0f/0f7e45db7621e8ecd7d915d49d14a8656070365023f12d7239c435f7da8f72fc.png)" :db/ensure [:question/validate]} {:db/id 17592186100830 :knowledge-point/questions ["question-d823907c-c12e-50eb-a396-a258624fbd1c" "question-140bcd57-110f-51e2-8837-ad085a0b4faa" "question-02de7b14-03bb-5d7e-b753-b48cb91786a1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100641 :question/problem "The graph of $y=f'(x)$, the derivative of a continuous function $y=f(x)$, is given below. Sketch a possible graph of $y=f(x).$\n\n![](images/23/23c5620bdd59a6359eaa9bad6580b4b844237bead64b7138f7472b65c7e17c1b.png)" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when $f'(x)=0$ or $f'(x)$ does not exist. In our case, there are two critical points: \n\n$$\nx=1\\quad \\text{and} \\quad x=2\n$$\n\nAlso, we have the following: \n\n- If $f'(x) > 0$ then $f(x)$ is increasing.\n\n- If $f'(x) <               0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty,1)$ | $1$ | $(1,2)$ | $2$ | $(2, \\infty)$ |\n| --- | --- | --- | --- | --- | --- |\n| $f'$ | $+$ | $0$ | $-$ | $0$ | $+$ |\n| $f$ | $\\nearrow$ | $\\textrm{max}$ | $\\searrow$ | $\\textrm{min}$ | $\\nearrow$ |\n\n \n\nLet's now sketch the graph of $y=f(x)\\mathbin{:}$\n\n- First, we draw the critical points. Consider the vertical lines $x=1$ and $x=2.$ \n\n- We choose an arbitrary point on the vertical line $x=1.$\n\n- Since $f(x)$ is decreasing $\\searrow$ on $(1,2),$ the point at $x=2$ must be lower than the point at $x=1.$\n\nSo, we draw it as follows:\n\n![](images/e3/e3a15ad7af8061bb800c5536fe054594402c7898ef7485a8a4165aff9cdc272d.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $\\nearrow$ on $(-\\infty,1)$ and decreasing $\\searrow$ on $(1,2)$, the graph of $f(x)$ goes down to the left and to the right of $x=1.$\n\n- Since $f(x)$ is decreasing $\\searrow$ on $(1,2)$ and increasing $\\nearrow$ on $(2,\\infty)$, the graph of $f(x)$ goes up to the left and to the right of $x=2.$\n\n- Furthermore, since $f'(x)$ is increasing to the left of $x = 3$, we must have $f''(x) >   0.$ So, the curve $y=f(x)$ is concave up on $(2,3).$ Also, since $f'(x)$ is constant and positive to the right of $x = 3$, the graph of $y=f(x)$ represents a section of an increasing  straight line on $(3,\\infty).$\n\n![](images/20/200f45be73f0c38d5cab4099ac83ab5d80022539e17cd0996f1ab0228a90a89e.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x)\\mathbin{:}$\n\n![](images/16/16aff3b702623f3b6339cacfcdac4c9b43900e58f1228481d168b8b0535e1412.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :db/ensure [:question/validate]} {:db/id 17592186100936 :knowledge-point/questions ["question-585b182e-7b17-5dc5-940a-b3dd1c063524" "question-0bf75373-8a0d-58e6-9585-31096e6c716e" "question-9fc26721-45c6-5872-bde4-819ab63691ac" "question-67f4106c-b68b-5844-893c-27d541fb64bf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100767 :question/problem "If $f'(x)=|x+1|,$ sketch a possible graph of a continuous function $y=f(x).$" :question/worked-solution "The graph of $y=f'(x)$ is the following:\n\n![](images/57/57937f50c8adac57cd0a8b131ae2605466fe5e87e85ba324977a95b2f2c7a006.png)\n\nRecall that critical points of $y=f(x)$ occur when $f'(x)=0$ or $f'(x)$ does not exist. In our case, there is one critical point: \n\n$\\qquad$ $x=-1$ \n\nAlso, we have the following: \n\n- If $f'(x) > 0$ then $f(x)$ is increasing.\n\n- If $f'(x) <      0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty,-1)$ | $-1$ | $(-1,\\infty)$ |\n| --- | --- | --- | --- |\n| $f'$ | $+$ | $0$ | $+$ |\n| $f$ | $\\nearrow$ | $\\textrm{no extr.}$ | $\\nearrow$ |\n\nLet's now sketch the graph of $y=f(x)\\mathbin{:}$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=-1,$ as shown below.\n\n![](images/29/296d0c0e63bedc37841aa914e0fb07320fff634ea1f6ac019a84cc47b87966b4.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $\\nearrow$ on $(-\\infty,-1)$ and on $(-1,\\infty)$, the graph of $y=f(x)$ goes down the left of $x=-1$ and goes up to the right of $x=-1.$\n\n- Furthermore, since $f'(x)$ is decreasing to the left of $x = -1$, we must have $f''(x) <      0$, and, since it is increasing to the right of $x = -1$, we must have $f''(x) >    0.$ So, $x =-1$ is an inflection point at which the curve $y=f(x)$ changes from concave down to concave up.\n\nSo, we can draw as follows:\n\n![](images/1c/1c4fb55a07e1b55448ec2a2ada4fea07f363542cdf04a8676c90938b5c4f7fbe.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x)\\mathbin{:}$\n\n![](images/df/dfeb793809943dc496cc1f47b26f9b20aa3403b6d999787a7444ede605547226.png)" :db/ensure [:question/validate]} {:db/id "question-1fbb657d-32e1-57fb-9710-afc011b6ab8e" :question/id #uuid "1fbb657d-32e1-57fb-9710-afc011b6ab8e" :question/math-academy-id "q-20537" :question/problem "![](images/56/562596b4267c6a13ef13c4f20e7861b00675e85febc43653efd141d720900804.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Given that $f(0)=0,$ which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are two critical points: \n\n$\\,$ $x=-1\\,$ and $\\,x=0.$\n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,0)$ | $0$ | $(0,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | $\\text{not extr.}$ | $↘$ | $\\text{min}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical lines $x=-1,$ and $x=0.$\n\n- Since we are told that $f(0)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is decreasing $↘$ on $(-1,0)$, the point at $x=0$ must be lower than the point at $x=-1.$\n\nSo, we draw it as follows:\n\n![](images/50/504a1af2c6d97200a3b211e8a7c67298082cd3cffbf866851afa63f7162dcce3.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-1)$ and on $(-1,0)$, the graph of $y=f(x)$ goes up to the left and down to the right of $x=-1.$\n\n- Since $f(x)$ is decreasing $↘$ on $(-1,0)$ and increasing $↗$ on $(0,\\infty )$, the graph of $y=f(x)$ goes up to the left and to the right of $x=0.$\n\n![](images/6e/6e6c1b9806b3dbf340255884722429a67dc3a7cd55d8cc0a0bbeeb48dcae1c87.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/10/10185719d14812cd4f58a592f106fe4fd81540ab6f6177f61d77bd6ec4e5d6c4.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9c5edabf-00e6-5fe8-8d29-4f1176381b61"] :db/ensure [:question/validate]} {:db/id "answer-field-9c5edabf-00e6-5fe8-8d29-4f1176381b61" :answer-field/id #uuid "9c5edabf-00e6-5fe8-8d29-4f1176381b61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fac7db90-a675-5558-8d1a-77b845711d34" :answer-field/choices ["answer-2c119c65-b1d1-5c58-9553-3ad2dae34000" "answer-181657a5-8e49-5d1d-999a-0fb0c3f63c9d" "answer-0ae1d63b-23bd-5309-8ee8-17b745973c17" "answer-fac7db90-a675-5558-8d1a-77b845711d34" "answer-df1de746-594f-5aab-bc64-d7589cef3144"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c119c65-b1d1-5c58-9553-3ad2dae34000" :answer/id #uuid "2c119c65-b1d1-5c58-9553-3ad2dae34000" :answer/type :answer.type/image :answer/value "images/59/59f73f5b191f642dbcd20cacfa960d2a013ac30a1bc2497135a68732eccbde16.png" :db/ensure [:answer/validate]} {:db/id "answer-181657a5-8e49-5d1d-999a-0fb0c3f63c9d" :answer/id #uuid "181657a5-8e49-5d1d-999a-0fb0c3f63c9d" :answer/type :answer.type/image :answer/value "images/63/63127d91f491c9bdad7da5a392cfb0393b031e569b034053c20ddb5da27d6b72.png" :db/ensure [:answer/validate]} {:db/id "answer-0ae1d63b-23bd-5309-8ee8-17b745973c17" :answer/id #uuid "0ae1d63b-23bd-5309-8ee8-17b745973c17" :answer/type :answer.type/image :answer/value "images/7d/7d5111c260bea478b9b357669ebfc2fe04ba159e2cebbf5f8cea0439ed8adc74.png" :db/ensure [:answer/validate]} {:db/id "answer-fac7db90-a675-5558-8d1a-77b845711d34" :answer/id #uuid "fac7db90-a675-5558-8d1a-77b845711d34" :answer/type :answer.type/image :answer/value "images/94/9415a29205a3c6048a0bdfcf7c6472a03cbaca9342612a0c854c965ccdd0d9ee.png" :db/ensure [:answer/validate]} {:db/id "answer-df1de746-594f-5aab-bc64-d7589cef3144" :answer/id #uuid "df1de746-594f-5aab-bc64-d7589cef3144" :answer/type :answer.type/image :answer/value "images/ce/ce45a5f05e6d9095c27b5a51cafa9cb0bafd80687d32653c2fa75c9e0b21ef2f.png" :db/ensure [:answer/validate]} {:db/id "question-5e28fed1-97b3-526c-8da9-ef22fe1e5ddd" :question/id #uuid "5e28fed1-97b3-526c-8da9-ef22fe1e5ddd" :question/math-academy-id "q-20520" :question/problem "![](images/3c/3c304ff10a466abe8a7a98342f58d357fec5a46c6971c5dc0b30203bbbb1ec62.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Given that $f(0)=0,$ which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=-0.5$\n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-0.5)$ | $-0.5$ | $(-0.5,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. Consider the vertical lines $x=-0.5.$ \n\n- Since we are told that $f(0)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is decreasing $↘$ on $(-0.5,\\infty ),$ the point at $x=-0.5$ must be higher than the point at $x=0.$\n\nSo, we draw it as follows:\n\n![](images/9a/9a90c6cc7702720da4fb2619935ce1f663fe09a1f0827c520371d4dc39881cf5.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical point:\n\n- Since $f(x)$ is increasing $↗$ on $(-\\infty ,-0.5)$ and decreasing $↘$ on $(-0.5,\\infty )$, the graph of $y=f(x)$ goes down to the left and to the right of $x=-0.5.$\n\n![](images/02/02833ae5c4579ec492812be7bc8e90958108a60cc2f5b7348d4eb6119f667062.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/8f/8ffc84aff1ce37e77b8c0c169a6cb01b9bff7f5f2d27a834ccea251a7d1acbde.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9574a838-800d-5813-a9de-cbd6d28e1a98"] :db/ensure [:question/validate]} {:db/id "answer-field-9574a838-800d-5813-a9de-cbd6d28e1a98" :answer-field/id #uuid "9574a838-800d-5813-a9de-cbd6d28e1a98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21cab66b-5fb3-57ce-b282-ad7beb64df5b" :answer-field/choices ["answer-cdd55c45-aef4-5eef-86a3-efc38346e0f1" "answer-21cab66b-5fb3-57ce-b282-ad7beb64df5b" "answer-31788703-390d-516a-b9de-d18025f61121" "answer-19e34821-b31b-56fb-abfd-64b1ae126d7f" "answer-0b480465-5f89-5451-9e32-2c7626bd187f"] :db/ensure [:answer-field/validate]} {:db/id "answer-cdd55c45-aef4-5eef-86a3-efc38346e0f1" :answer/id #uuid "cdd55c45-aef4-5eef-86a3-efc38346e0f1" :answer/type :answer.type/image :answer/value "images/53/530947fa1d6069fcdd8f8c9659d1150f78c124981dc3229317d5725108ecb07e.png" :db/ensure [:answer/validate]} {:db/id "answer-21cab66b-5fb3-57ce-b282-ad7beb64df5b" :answer/id #uuid "21cab66b-5fb3-57ce-b282-ad7beb64df5b" :answer/type :answer.type/image :answer/value "images/7d/7dd91e0d84d8f5074442ad15b81c7edd9d42542fd44bda2e92c7de51191ffd0b.png" :db/ensure [:answer/validate]} {:db/id "answer-31788703-390d-516a-b9de-d18025f61121" :answer/id #uuid "31788703-390d-516a-b9de-d18025f61121" :answer/type :answer.type/image :answer/value "images/a4/a4dd5fe6f307cfb3f710aecf0d1ec7c15d1d40f877859a4924fe763427ddee75.png" :db/ensure [:answer/validate]} {:db/id "answer-19e34821-b31b-56fb-abfd-64b1ae126d7f" :answer/id #uuid "19e34821-b31b-56fb-abfd-64b1ae126d7f" :answer/type :answer.type/image :answer/value "images/aa/aa84e4e1164f08ed09630ab29d3ea58ac64bae2fb477ca52bd877fcc68446749.png" :db/ensure [:answer/validate]} {:db/id "answer-0b480465-5f89-5451-9e32-2c7626bd187f" :answer/id #uuid "0b480465-5f89-5451-9e32-2c7626bd187f" :answer/type :answer.type/image :answer/value "images/df/dfe39efab675842e00c2cfe764ea91579fc6cc908150bfc92b0e6059861151fd.png" :db/ensure [:answer/validate]} {:db/id "question-5b66ab71-e5ba-5e8c-8d29-3a56ef93e008" :question/id #uuid "5b66ab71-e5ba-5e8c-8d29-3a56ef93e008" :question/math-academy-id "q-20536" :question/problem "![](images/3d/3d1a01139fdd6f0f9f996cfce43a1e5ad86c2eabe526e9501f72451bd137f9dd.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Given that $f(0)=0,$ which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are two critical points: \n\n$\\,$ $x=0\\,$ and $\\,x=1$\n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical lines $x=0$ and $x=1.$ \n\n- Since we are told that $f(0)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is increasing $↗$ on $(0,1),$ the point at $x=1$ must be higher than the point at $x=0.$\n\nSo, we draw it as follows:\n\n![](images/cf/cfd74974fecdaf62309e089f34f99e0f015584ed3fbb275b9b997c9811c74979.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,0)$ and increasing $↗$ on $(0,1)$, the graph of $y=f(x)$ goes up to the left and to the right of $x=0.$\n\n- Since $f(x)$ is increasing $↗$ on $(0,1)$ and decreasing $↘$ on $(1,\\infty )$, the graph of $y=f(x)$ goes down to the left and to the right of $x=1.$\n\n![](images/8f/8faca7d91b813d8ce7a964614a19f29d7e3b20d34cf918463151f37bc8f9614b.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/41/4127d1311f92f1e03def285cf922bd5235fd4b2a5ca9614f34e7243c9bf79276.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2b860c17-9b4c-57c9-b76d-64ac14b97c60"] :db/ensure [:question/validate]} {:db/id "answer-field-2b860c17-9b4c-57c9-b76d-64ac14b97c60" :answer-field/id #uuid "2b860c17-9b4c-57c9-b76d-64ac14b97c60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-acd52841-b68b-50a7-9877-3a6316ab884d" :answer-field/choices ["answer-acd52841-b68b-50a7-9877-3a6316ab884d" "answer-4845549a-32c4-5e66-b53c-55d09aa341e1" "answer-172bf440-f574-5070-8f2d-33edad832211" "answer-d971d8a5-7e38-51ca-9066-16ed46c0fd13" "answer-edc7ce5c-ea51-542b-bd83-b0c6b0e2ffe5"] :db/ensure [:answer-field/validate]} {:db/id "answer-acd52841-b68b-50a7-9877-3a6316ab884d" :answer/id #uuid "acd52841-b68b-50a7-9877-3a6316ab884d" :answer/type :answer.type/image :answer/value "images/88/888fdd7918b5c3da97448ca243f3d57a7091ea0370331a919457ecfdb2b3bb5a.png" :db/ensure [:answer/validate]} {:db/id "answer-4845549a-32c4-5e66-b53c-55d09aa341e1" :answer/id #uuid "4845549a-32c4-5e66-b53c-55d09aa341e1" :answer/type :answer.type/image :answer/value "images/a0/a061eb4bccd90e77ed8f5ed546575f1d8693b5e5d9664dd25e38db736af7f9f5.png" :db/ensure [:answer/validate]} {:db/id "answer-172bf440-f574-5070-8f2d-33edad832211" :answer/id #uuid "172bf440-f574-5070-8f2d-33edad832211" :answer/type :answer.type/image :answer/value "images/b4/b48f710984436c4a30f39a9206179c8b1291ab68b20c0ad46eaa3f453bcea469.png" :db/ensure [:answer/validate]} {:db/id "answer-d971d8a5-7e38-51ca-9066-16ed46c0fd13" :answer/id #uuid "d971d8a5-7e38-51ca-9066-16ed46c0fd13" :answer/type :answer.type/image :answer/value "images/db/dbc432d3951384c6cd50c842fb9d8da09b77724fb932cac0310696496c0e05da.png" :db/ensure [:answer/validate]} {:db/id "answer-edc7ce5c-ea51-542b-bd83-b0c6b0e2ffe5" :answer/id #uuid "edc7ce5c-ea51-542b-bd83-b0c6b0e2ffe5" :answer/type :answer.type/image :answer/value "images/f9/f9735d4f15740958dba71e285cb59aefed45e6964e82f040c7560880760f09ea.png" :db/ensure [:answer/validate]} {:db/id "question-7bca001f-f1ef-5c7b-838d-dca97d1b4371" :question/id #uuid "7bca001f-f1ef-5c7b-838d-dca97d1b4371" :question/math-academy-id "q-20538" :question/problem "![](images/ef/ef23af714377518200c574ba436a30001ed5f60262e11f8157f62d49cbec317e.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Given that $f(0)=0,$ which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are three critical points: \n\n$\\,$ $x=-3,$ $x=-2,\\,$ and $\\,x=-1.$\n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-3)$ | $-3$ | $(-3,-2)$ | $-2$ | $(-2,-1)$ | $-1$ | $(-1,\\infty )$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ | $\\text{max}$ | $↘$ | $\\text{min}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical lines $x=-3,$ $x=-2,$ and $x=-1.$\n\n- Since we are told that $f(0)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is increasing $↗$ on $(-1,0)$, the point at $x=-1$ must be below the $x$-axis.\n\n- Since $f(x)$ is decreasing $↘$ on $(-2,-1)$, the point at $x=-2$ must be higher than the point at $x=-1.$\n\n- Since $f(x)$ is increasing $↗$ on $(-3,-2)$, the point at $x=-3$ must be lower than the point at $x=-2.$\n\nSo, we draw it as follows:\n\n![](images/66/66296cbca22d3059fba111935808d1bb0a78e9de31c45948fce207d998c9cfd2.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-3)$ and increasing $↗$ on $(-3,-2)$, the graph of $y=f(x)$ goes up to the left and to the right of $x=-3.$\n\n- Since $f(x)$ is increasing $↗$ on $(-3,-2)$ and decreasing $↘$ on $(-2,-1)$, the graph of $y=f(x)$ goes down to the left and to the right of $x=-2.$\n\n- Since $f(x)$ is decreasing $↘$ on $(-2,-1)$ and increasing $↗$ on $(-1,\\infty )$, the graph of $y=f(x)$ goes up to the left and to the right of $x=-1.$\n\n![](images/b2/b26af4cdc5af02f2cf0a9a0092f0fe908d70acd428e6a1e24bc848bcc99125e4.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/93/938c86a415620a2e80873f7cee72b2ebaf5579ae2e67eb966bb1f8836e62c087.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-91678777-7e28-5ef5-a238-81845caf3318"] :db/ensure [:question/validate]} {:db/id "answer-field-91678777-7e28-5ef5-a238-81845caf3318" :answer-field/id #uuid "91678777-7e28-5ef5-a238-81845caf3318" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91f31f58-f5b7-5fe0-bf72-8fc0e8e1523d" :answer-field/choices ["answer-91f31f58-f5b7-5fe0-bf72-8fc0e8e1523d" "answer-e9425c54-4f77-5814-a554-2239b7b79e9f" "answer-6d1d4203-e4eb-5d8c-b257-0e8af5b10bab" "answer-6d69587a-0fa0-5c37-b3be-9a8ba46198a1" "answer-2cd26d16-0db1-5668-8fc3-46d952aa6916"] :db/ensure [:answer-field/validate]} {:db/id "answer-91f31f58-f5b7-5fe0-bf72-8fc0e8e1523d" :answer/id #uuid "91f31f58-f5b7-5fe0-bf72-8fc0e8e1523d" :answer/type :answer.type/image :answer/value "images/0e/0e309172615a213d2b8cc54b8efd73f9681e90c7949577939e382fbf1c6e9cbb.png" :db/ensure [:answer/validate]} {:db/id "answer-e9425c54-4f77-5814-a554-2239b7b79e9f" :answer/id #uuid "e9425c54-4f77-5814-a554-2239b7b79e9f" :answer/type :answer.type/image :answer/value "images/3d/3d1b8a4f32a73ac96528ebb09dd68b312b3f50ec5b7b46a0d4c2cfb3052c1d72.png" :db/ensure [:answer/validate]} {:db/id "answer-6d1d4203-e4eb-5d8c-b257-0e8af5b10bab" :answer/id #uuid "6d1d4203-e4eb-5d8c-b257-0e8af5b10bab" :answer/type :answer.type/image :answer/value "images/40/403d9fea4b302c5f198c64c1be9f6105c3d095a929c4a4f5763b6d35bd350cea.png" :db/ensure [:answer/validate]} {:db/id "answer-6d69587a-0fa0-5c37-b3be-9a8ba46198a1" :answer/id #uuid "6d69587a-0fa0-5c37-b3be-9a8ba46198a1" :answer/type :answer.type/image :answer/value "images/42/42b75cc427f3a1b1298d1058828ab2808b1df43c3140acfc50dc56380cf0d50d.png" :db/ensure [:answer/validate]} {:db/id "answer-2cd26d16-0db1-5668-8fc3-46d952aa6916" :answer/id #uuid "2cd26d16-0db1-5668-8fc3-46d952aa6916" :answer/type :answer.type/image :answer/value "images/5d/5daf580ac012c426dcd74c0ced697a8d8a3a109b3e9762e3315cde514777af40.png" :db/ensure [:answer/validate]} {:db/id "question-451559e6-da00-5040-a946-bd30072c74e4" :question/id #uuid "451559e6-da00-5040-a946-bd30072c74e4" :question/math-academy-id "q-115622" :question/problem "![](images/94/944d7dfa7895e5eecc2d11065e268fceba725c8181ffa8283d1fcac39d2d5a98.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Given that $f(0)=0,$ which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are two critical points: \n\n$\\,$ $x=1\\,$ and $\\,x=3.5$\n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,1)$ | $1$ | $(1,3.5)$ | $3.5$ | $(3.5,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical lines $x=1$ and $x=3.5.$ \n\n- Since we are told that $f(0)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,1),$ the point at $x=1$ must be lower than the point at $x=0.$\n\n- Since $f(x)$ is increasing $↗$ on $(1,3.5),$ the point at $x=3.5$ must be higher than the point at $x=1.$\n\nSo, we draw it as follows:\n\n![](images/4e/4e6fcbb39c9750bb41a2b505325a1b11a633ca749d740aea7c6737bee7db7f7a.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,1)$ and increasing $↗$ on $(1,3.5)$, the graph of $y=f(x)$ goes up to the left and to the right of $x=1.$\n\n- Since $f(x)$ is increasing $↗$ on $(1,3.5)$ and decreasing $↘$ on $(3.5,\\infty )$, the graph of $y=f(x)$ goes down to the left and to the right of $x=3.5.$\n\n![](images/c0/c010f5bb4dcee1241211beefa90e9496045f2b5e5ddc861bd703e8d0cf0f3276.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/49/493dd437fa00fe3d3056dcb6c2a0b291db27d8bdf96e96ee5366d696bf9433e2.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f8000223-fc08-5e87-86f4-e925b30d30c6"] :db/ensure [:question/validate]} {:db/id "answer-field-f8000223-fc08-5e87-86f4-e925b30d30c6" :answer-field/id #uuid "f8000223-fc08-5e87-86f4-e925b30d30c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1ada6148-fd53-5252-bdd5-2e58d5b36350" :answer-field/choices ["answer-1ada6148-fd53-5252-bdd5-2e58d5b36350" "answer-71bdb9dc-4aa1-502b-aa8c-40453b138c8e" "answer-608acc0f-3137-57b6-84d3-462f080a438f" "answer-c4f4363f-5b8b-52cf-a83a-2bbc43742fb3" "answer-0fcb5e11-8265-5d3d-abe8-a79338f84817"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ada6148-fd53-5252-bdd5-2e58d5b36350" :answer/id #uuid "1ada6148-fd53-5252-bdd5-2e58d5b36350" :answer/type :answer.type/image :answer/value "images/0f/0f40ecd297d20c736f8c78f7a2cfda99089e8b23ed2ea8b48282a7ee3a095df5.png" :db/ensure [:answer/validate]} {:db/id "answer-71bdb9dc-4aa1-502b-aa8c-40453b138c8e" :answer/id #uuid "71bdb9dc-4aa1-502b-aa8c-40453b138c8e" :answer/type :answer.type/image :answer/value "images/58/58a3a702c5a7e25691c05451e0f3e7e33ea6209fb7a74840ae1fd2f1698bd98b.png" :db/ensure [:answer/validate]} {:db/id "answer-608acc0f-3137-57b6-84d3-462f080a438f" :answer/id #uuid "608acc0f-3137-57b6-84d3-462f080a438f" :answer/type :answer.type/image :answer/value "images/99/99844134ca18d5a71bdb32c4a36c8b40e284d03b58dd33e9cf7dc01f994a270b.png" :db/ensure [:answer/validate]} {:db/id "answer-c4f4363f-5b8b-52cf-a83a-2bbc43742fb3" :answer/id #uuid "c4f4363f-5b8b-52cf-a83a-2bbc43742fb3" :answer/type :answer.type/image :answer/value "images/9f/9f4d9c8e8c29c735a98e7849e367f8f2b92283a9ed0ac28f22835ae8e1ebb527.png" :db/ensure [:answer/validate]} {:db/id "answer-0fcb5e11-8265-5d3d-abe8-a79338f84817" :answer/id #uuid "0fcb5e11-8265-5d3d-abe8-a79338f84817" :answer/type :answer.type/image :answer/value "images/b4/b495e7d55739c157dba9e37ba5c994bcbb28cb403a196e300dc58a12a30332f6.png" :db/ensure [:answer/validate]} {:db/id "question-01274ce5-42e5-5d91-b593-1351d7ffb44f" :question/id #uuid "01274ce5-42e5-5d91-b593-1351d7ffb44f" :question/math-academy-id "q-20507" :question/problem "![](images/2d/2dd50d4970f5c738c7cc350b8aee4668a6ec9ce4b1444698c5ecd737d01f82ea.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=-2$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-2)$ | $-2$ | $(-2,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=-2,$ as shown below.\n\n![](images/9e/9eae519cd7ca99aa85fe62c9fa8276a7455cbc869587296405c6a6b3caf2ee30.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-2)$ and increasing $↗$ on $(-2,\\infty )$, the graph of $y=f(x)$ goes up to the left and the right of $x=-2.$\n\nSo, we can draw as follows:\n\n![](images/1a/1a2fd6311c5845885bfd7ed9118091a5c81c4fea8c81587db79b203a51b9e1de.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/f6/f6e473044a84d215de98e3739bea83ccaf107231ccb273c8e45db91221f05edb.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ba5c71aa-5435-51b8-bfad-c3e21dfbafbf"] :db/ensure [:question/validate]} {:db/id "answer-field-ba5c71aa-5435-51b8-bfad-c3e21dfbafbf" :answer-field/id #uuid "ba5c71aa-5435-51b8-bfad-c3e21dfbafbf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c91278e-e513-584a-b5f1-2e83547243af" :answer-field/choices ["answer-2ca7260b-4bd3-578c-99fc-28ba65fbc818" "answer-0c91278e-e513-584a-b5f1-2e83547243af" "answer-f7ad64e9-bb9a-5050-bf3c-1c8d2b65fefe" "answer-bb73b6eb-a369-59a9-938a-33e3e19e8180" "answer-cd05fdf8-a19d-5595-9827-470daf59e904"] :db/ensure [:answer-field/validate]} {:db/id "answer-2ca7260b-4bd3-578c-99fc-28ba65fbc818" :answer/id #uuid "2ca7260b-4bd3-578c-99fc-28ba65fbc818" :answer/type :answer.type/image :answer/value "images/86/86693cdfeb10911b4c6aa6aa9a2b514a80110a18d63c15af955a61fc42011b15.png" :db/ensure [:answer/validate]} {:db/id "answer-0c91278e-e513-584a-b5f1-2e83547243af" :answer/id #uuid "0c91278e-e513-584a-b5f1-2e83547243af" :answer/type :answer.type/image :answer/value "images/ad/adb436d22258853f072ad913c72f7aced89ed9bac2e90c64284f5e9fd207d677.png" :db/ensure [:answer/validate]} {:db/id "answer-f7ad64e9-bb9a-5050-bf3c-1c8d2b65fefe" :answer/id #uuid "f7ad64e9-bb9a-5050-bf3c-1c8d2b65fefe" :answer/type :answer.type/image :answer/value "images/b0/b0a49b1b88d6bdf4a45598ef6fe1550b6c8abfdc8d7000d4f34ce174ed9a3544.png" :db/ensure [:answer/validate]} {:db/id "answer-bb73b6eb-a369-59a9-938a-33e3e19e8180" :answer/id #uuid "bb73b6eb-a369-59a9-938a-33e3e19e8180" :answer/type :answer.type/image :answer/value "images/c4/c4685eebacdd1401c818e9d0f1af403d3f2bcc8187c5a7044c5e8ed2970320bc.png" :db/ensure [:answer/validate]} {:db/id "answer-cd05fdf8-a19d-5595-9827-470daf59e904" :answer/id #uuid "cd05fdf8-a19d-5595-9827-470daf59e904" :answer/type :answer.type/image :answer/value "images/ff/ff4a407ff40e277e8730996778531bd6b8541332340b1c7bcc1abfdb3c55faf2.png" :db/ensure [:answer/validate]} {:db/id "question-e89c21de-ead1-56e3-b348-ff522b66f5d8" :question/id #uuid "e89c21de-ead1-56e3-b348-ff522b66f5d8" :question/math-academy-id "q-20519" :question/problem "![](images/a5/a53074660204fdd4fd62575ef8db80a3b04144ef7b9e18d98c60fbbe9a480ee3.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are two critical points: \n\n$\\,$ $x=-1\\,$ and $\\,x=1$\n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. We choose an arbitrary point on the vertical lines $x=-1$ and $x=1.$ Since $f(x)$ is increasing $↗$ on $(-1,1),$ the point at $x=1$ must be higher than the point at $x=-1,$ as shown below.\n\n![](images/12/12e6a8036759b8bbcc2f4fbe4ae7f4f7e18278de65fbdc0faa99c919f7234284.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-1)$ and is increasing $↗$ on $(-1,1)$, the graph of $y=f(x)$ goes up to the left and the right of $x=-1.$\n\n- Since $f(x)$ is increasing $↗$ on $(-1,1)$ and is decreasing $↘$ on $(1,\\infty )$, the graph of $y=f(x)$ goes down to the left and the right of $x=1.$\n\n![](images/38/38f1c92810a3311ed939a54ac2856cb7ada111dbf24528785f80bd5f9ca49c84.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/79/7921a107b33a9b9bdc3df8dec418828f4cd5de2d89a9e7ab41845b0c64bbb653.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-097df743-cf70-55f0-86fa-ee810d941deb"] :db/ensure [:question/validate]} {:db/id "answer-field-097df743-cf70-55f0-86fa-ee810d941deb" :answer-field/id #uuid "097df743-cf70-55f0-86fa-ee810d941deb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c63bf268-63be-5348-a926-f6543d453618" :answer-field/choices ["answer-f19c0551-6cba-54d6-939e-c1754d401a58" "answer-cb162731-bef9-5c76-993a-ea53fb58aec8" "answer-6d03b9e5-c929-51d2-935e-306438fa83a5" "answer-c63bf268-63be-5348-a926-f6543d453618" "answer-d72461d3-54b5-5e48-b328-5f7605c2e405"] :db/ensure [:answer-field/validate]} {:db/id "answer-f19c0551-6cba-54d6-939e-c1754d401a58" :answer/id #uuid "f19c0551-6cba-54d6-939e-c1754d401a58" :answer/type :answer.type/image :answer/value "images/08/08023ee8e2c3794d6c387e8484ce30477af40883e13c244eaeb53dd410f1d7d2.png" :db/ensure [:answer/validate]} {:db/id "answer-cb162731-bef9-5c76-993a-ea53fb58aec8" :answer/id #uuid "cb162731-bef9-5c76-993a-ea53fb58aec8" :answer/type :answer.type/image :answer/value "images/1c/1cedc81848d9a334a782ab8912849b883e0f7c346aa5c22dc9fffb549e6da2e9.png" :db/ensure [:answer/validate]} {:db/id "answer-6d03b9e5-c929-51d2-935e-306438fa83a5" :answer/id #uuid "6d03b9e5-c929-51d2-935e-306438fa83a5" :answer/type :answer.type/image :answer/value "images/85/85966acfdc882b9f4d5a74ca6c058234e8522e164adf90392a9a2fd6407d1e2d.png" :db/ensure [:answer/validate]} {:db/id "answer-c63bf268-63be-5348-a926-f6543d453618" :answer/id #uuid "c63bf268-63be-5348-a926-f6543d453618" :answer/type :answer.type/image :answer/value "images/94/94aa7db16724e58ee9154a647939dad7c31270c6a7c933b0b5616f20b20dd358.png" :db/ensure [:answer/validate]} {:db/id "answer-d72461d3-54b5-5e48-b328-5f7605c2e405" :answer/id #uuid "d72461d3-54b5-5e48-b328-5f7605c2e405" :answer/type :answer.type/image :answer/value "images/b9/b92b3f9451964d3c17cca0fffa9d378a3d40d8e8a1cbf3a2da1373c75558de94.png" :db/ensure [:answer/validate]} {:db/id 17592186101308 :question/problem "![](images/5e/5e1d4dbd07dbf4e7f06b5ef2dd01ae2ef5fa82f3a5a78fb470388fad8b18af1e.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=-1.5$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-1.5)$ | $-1.5$ | $(-1.5,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $+$ | $0$ | $+$ |\n| $f$ | $↗$ | $\\text{no extr.}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=-1.5,$ as shown below.\n\n![](images/8b/8bee8a231cdfe8d41cf35fa50d97806d511a9477a8c92db98b1be11b70676928.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $↗$ on $(-\\infty ,-1.5)$ and is increasing $↗$ on $(-1.5,+\\infty )$, the graph of $y=f(x)$ goes down to the left and up to the right of $x=-1.5.$\n\n- Furthermore, since ${f}^{′}(x)$ is decreasing to the left of $x=-1.5$, we must have ${f}^{″}(x)<0$, and, since it is increasing to the right of $x=-1.5$, we must have ${f}^{″}(x)>0.$ So, $x=-1.5$ is an inflection point at which the curve $y=f(x)$ changes from concave down to concave up.\n\nSo, we can draw as follows:\n\n![](images/89/89127ba4db33c1c2ca12ddac05eac1c7e5ebe6540519fda1b55600620c1369d7.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/20/20784e268300c461c4567092230df10423b96d26287fde67074bab6690c1342f.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186099169 :answer-field/correct 17592186099171 :db/ensure [:answer-field/validate]} {:db/id "question-5f23ce06-592e-5661-a235-01cdcf7c430f" :question/id #uuid "5f23ce06-592e-5661-a235-01cdcf7c430f" :question/math-academy-id "q-86308" :question/problem "![](images/ab/ab5fb36385ed57a83a8bef13b0e58745fef3454d4e3fae0c54491d80b61637ce.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=3$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,3)$ | $3$ | $(3,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=3,$ as shown below.\n\n![](images/7e/7eb820e9dedb816318045df9f8dbef2d4b3007446599e56414a803f277acd622.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,3)$ and increasing $↗$ on $(3,\\infty )$, the graph of $y=f(x)$ goes up to the left and the right of $x=3.$\n\nSo, we can draw as follows:\n\n![](images/7d/7dd5014441f5cbe3ba3ee0127feb9cea1f8d264255e1c907ce6d5fdc458aa77f.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/fb/fb709866c18a2ecd61160330bd54c44b481a311e3a1bec589ef26ab8a4c6243f.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bf339733-37be-5896-bcb1-f51dffe96660"] :db/ensure [:question/validate]} {:db/id "answer-field-bf339733-37be-5896-bcb1-f51dffe96660" :answer-field/id #uuid "bf339733-37be-5896-bcb1-f51dffe96660" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eae733fe-f37a-5c46-8b3b-e9f3c17aa8e9" :answer-field/choices ["answer-bb0dd751-de56-55e1-9244-4239a0b555ae" "answer-eae733fe-f37a-5c46-8b3b-e9f3c17aa8e9" "answer-fb85d946-cf7e-5790-986b-7eb63faffc01" "answer-34a3e543-5ad8-57bf-9b65-7b2fe2a6b72b" "answer-9c2835ab-9301-5c8b-8281-9c2e76030cc4"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb0dd751-de56-55e1-9244-4239a0b555ae" :answer/id #uuid "bb0dd751-de56-55e1-9244-4239a0b555ae" :answer/type :answer.type/image :answer/value "images/09/093ef67145200dd417bd3405673720bacd4be904c7c9daf7aa6ba953570bfbec.png" :db/ensure [:answer/validate]} {:db/id "answer-eae733fe-f37a-5c46-8b3b-e9f3c17aa8e9" :answer/id #uuid "eae733fe-f37a-5c46-8b3b-e9f3c17aa8e9" :answer/type :answer.type/image :answer/value "images/09/09af4beb07576d820f6c4e88ffdde857deb7929c7389e1e2c7cf9a3f722e81d0.png" :db/ensure [:answer/validate]} {:db/id "answer-fb85d946-cf7e-5790-986b-7eb63faffc01" :answer/id #uuid "fb85d946-cf7e-5790-986b-7eb63faffc01" :answer/type :answer.type/image :answer/value "images/0e/0e1d8e8f6ca871700f677fb51195bdc80a0fdeee0d90a265f8249fa4240223b3.png" :db/ensure [:answer/validate]} {:db/id "answer-34a3e543-5ad8-57bf-9b65-7b2fe2a6b72b" :answer/id #uuid "34a3e543-5ad8-57bf-9b65-7b2fe2a6b72b" :answer/type :answer.type/image :answer/value "images/3a/3a136fb82417c4c5425a3f674b0a359b3c5634c20cff3450256b6230a8c23c31.png" :db/ensure [:answer/validate]} {:db/id "answer-9c2835ab-9301-5c8b-8281-9c2e76030cc4" :answer/id #uuid "9c2835ab-9301-5c8b-8281-9c2e76030cc4" :answer/type :answer.type/image :answer/value "images/74/743b0c2339d184cccb45f8dec6d615b68ad4c0d985f79971407136c8bb3df175.png" :db/ensure [:answer/validate]} {:db/id "question-06d5e4de-57e7-5985-961d-b5e59bdab913" :question/id #uuid "06d5e4de-57e7-5985-961d-b5e59bdab913" :question/math-academy-id "q-115653" :question/problem "![](images/28/28a16cda2f97557c23908fcd45928da5d4e11102343c33eaf07d1990fb0b6baf.png)\n\nThe graph of $y={f}^{′}(x),$ the derivative of $f(x),$ is shown above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=0$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=0,$ as shown below.\n\n![](images/ea/ea6ac357860556acba25d5510ff0e65a4b66acc65e035cd218715b0e96807519.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $↗$ on $(-\\infty ,0)$ and decreasing $↘$ on $(0,\\infty )$, the graph of $y=f(x)$ goes down to the left and to the right of $x=0.$\n\nSo, we can draw as follows:\n\n![](images/2a/2aafc298a8a7b0856d339582bb1236e9ae97c728eba103c703998e14455fdde5.png)\n\n \n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/04/04ec8de5abfecc23f3b4fb844b4e725e2a4f94aeb12bef61cda6356a6522826c.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8611c52c-2be7-5b1d-974d-d74d462d8be5"] :db/ensure [:question/validate]} {:db/id "answer-field-8611c52c-2be7-5b1d-974d-d74d462d8be5" :answer-field/id #uuid "8611c52c-2be7-5b1d-974d-d74d462d8be5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c7ec600-722a-5561-b042-87d0c5ff7aef" :answer-field/choices ["answer-29513485-282f-5496-828f-ff89eed1167f" "answer-9b410d03-6da5-58e1-8c43-d0843c59cf86" "answer-0c7ec600-722a-5561-b042-87d0c5ff7aef" "answer-b5e39dd5-cfb6-58b5-9f45-a03ccb0e3371" "answer-e55e0b29-9cc3-5de5-8242-1ee9c35b3e2b"] :db/ensure [:answer-field/validate]} {:db/id "answer-29513485-282f-5496-828f-ff89eed1167f" :answer/id #uuid "29513485-282f-5496-828f-ff89eed1167f" :answer/type :answer.type/image :answer/value "images/5d/5db7f225e29d4a40e315315a2ee4ac4a966cb405a48f7dc721386b996e7ac8e5.png" :db/ensure [:answer/validate]} {:db/id "answer-9b410d03-6da5-58e1-8c43-d0843c59cf86" :answer/id #uuid "9b410d03-6da5-58e1-8c43-d0843c59cf86" :answer/type :answer.type/image :answer/value "images/9d/9d2fc0c667694e4ecf6b9dbaa35ac8a43dd6aee411b3a6e4aa3e9f732daf6bd4.png" :db/ensure [:answer/validate]} {:db/id "answer-0c7ec600-722a-5561-b042-87d0c5ff7aef" :answer/id #uuid "0c7ec600-722a-5561-b042-87d0c5ff7aef" :answer/type :answer.type/image :answer/value "images/b1/b1dbe2acbf5cea11d7f7ab108d6e1d7207a3377013fb8f58cd8a94094d8b50f4.png" :db/ensure [:answer/validate]} {:db/id "answer-b5e39dd5-cfb6-58b5-9f45-a03ccb0e3371" :answer/id #uuid "b5e39dd5-cfb6-58b5-9f45-a03ccb0e3371" :answer/type :answer.type/image :answer/value "images/b8/b8aaadbeeba478729c99ef44f408489dd82de55e4d75709d25d4c1e7a2da1213.png" :db/ensure [:answer/validate]} {:db/id "answer-e55e0b29-9cc3-5de5-8242-1ee9c35b3e2b" :answer/id #uuid "e55e0b29-9cc3-5de5-8242-1ee9c35b3e2b" :answer/type :answer.type/image :answer/value "images/f6/f69aa9b32b1a986aa274f34ff5f60c83fb1c230edd8c2be40739a1a798e71a84.png" :db/ensure [:answer/validate]} {:db/id "question-d823907c-c12e-50eb-a396-a258624fbd1c" :question/id #uuid "d823907c-c12e-50eb-a396-a258624fbd1c" :question/math-academy-id "q-51330" :question/problem "![](images/9e/9e7c8d7f80211aebbd8a8fb5456e2bfe0a5dd0dc46addfe65777eb09f0b4c66a.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of a continuous function $y=f(x)$, is given above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point:  \n\n$\\,$ $x=3$  \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,3)$ | $3$ | $(3,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. Consider the vertical lines $x=3$ and choose an arbitrary point on it.\n\nSo, we draw it as follows:\n\n![](images/4a/4aa4592a6edae5207c7e934aa148e87dd8a8762f6bbdba260cc137bd64b407b9.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $↗$ on $(2,3)$ and decreasing $↘$ on $(3,\\infty )$, the graph of $f(x)$ goes down to the left and to the right of $x=3.$\n\n- Furthermore, since ${f}^{′}(x)$ is a positive constant to the left of $x=2$, the graph of $y=f(x)$ represents a section of an increasing  straight line on $(-\\infty ,2).$ Also, since ${f}^{′}(x)$ is decreasing to the right of $x=2$, we must have ${f}^{″}(x)<0.$ So, the curve $y=f(x)$ is concave down on $(2,\\infty ).$\n\n![](images/34/347dda820c8307984b88ffb5f2b528c20984ec8a7e9acbe9b7f3d8f457a917b2.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/99/99de5224b614ea11b454020d7a165b58ff0fcf47708faba9973255276133eebc.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-487f5468-055d-55b0-8c96-d71409d37900"] :db/ensure [:question/validate]} {:db/id "answer-field-487f5468-055d-55b0-8c96-d71409d37900" :answer-field/id #uuid "487f5468-055d-55b0-8c96-d71409d37900" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-36ccebf8-2372-5729-987f-d8c7e4cd9f4d" :answer-field/choices ["answer-acf0dc42-96ed-5eea-a990-8942bdf1b517" "answer-36ccebf8-2372-5729-987f-d8c7e4cd9f4d" "answer-ce906917-bf5a-5839-b638-64b88832140a" "answer-e9b89159-d512-5d5f-9dd1-51c2c1223dc8" "answer-f6fc7a06-065f-5843-9a83-b37d930e76fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-acf0dc42-96ed-5eea-a990-8942bdf1b517" :answer/id #uuid "acf0dc42-96ed-5eea-a990-8942bdf1b517" :answer/type :answer.type/image :answer/value "images/26/264947554c6cf3b2bbd0a4ab2497d19eb054a4bb7ef0abd8621d5e3372940b5c.png" :db/ensure [:answer/validate]} {:db/id "answer-36ccebf8-2372-5729-987f-d8c7e4cd9f4d" :answer/id #uuid "36ccebf8-2372-5729-987f-d8c7e4cd9f4d" :answer/type :answer.type/image :answer/value "images/61/6172cc5efc4c98b46e65b28034b608c11f9a8134c6629d61d4f5ae83564cce92.png" :db/ensure [:answer/validate]} {:db/id "answer-ce906917-bf5a-5839-b638-64b88832140a" :answer/id #uuid "ce906917-bf5a-5839-b638-64b88832140a" :answer/type :answer.type/image :answer/value "images/70/70ced59275e3c88d236ff5b8306f81b008aa64f27d50c5ce2d11598f391034e9.png" :db/ensure [:answer/validate]} {:db/id "answer-e9b89159-d512-5d5f-9dd1-51c2c1223dc8" :answer/id #uuid "e9b89159-d512-5d5f-9dd1-51c2c1223dc8" :answer/type :answer.type/image :answer/value "images/b1/b1718dd87304c78cf4ac3899dff470b06d16b894f03921eaf5d34cf8b9e1f092.png" :db/ensure [:answer/validate]} {:db/id "answer-f6fc7a06-065f-5843-9a83-b37d930e76fb" :answer/id #uuid "f6fc7a06-065f-5843-9a83-b37d930e76fb" :answer/type :answer.type/image :answer/value "images/e1/e1b70069bc39b663886252e4e56e82bc330898ef13dfb0112e558f47d6673c4c.png" :db/ensure [:answer/validate]} {:db/id 17592186101309 :question/problem "![](images/c1/c1b92084149ea54a3d309abf1a441c0f6855b15dc999f18c0108b02130d97ce8.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of a continuous function $y=f(x)$, is given above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are two critical points: \n\n$\\,$ $x=0\\,$ and $\\,x=1$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $+$ | $\\text{not def.}$ | $-$ | $0$ | $+$ |\n| $f$ | $↗$ | $\\text{max}$ | $↘$ | $\\text{min}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical lines $x=0$ and $x=1.$\n\n- We choose an arbitrary point on the vertical line $x=0.$\n\n- Since $f(x)$ is decreasing $↘$ on $(0,1),$ the point at $x=1$ must be lower than the point at $x=0.$\n\nSo, we draw it as follows:\n\n![](images/db/db3e0263e727e75197468f970ac85bdde2a2a9cdfb9257db0809665112772095.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $↗$ on $(-\\infty ,0)$ and increasing $↗$ on $(0,1)$, the graph of $f(x)$ goes down to the left and to the right of $x=0.$\n\n- Since $f(x)$ is decreasing $↗$ on $(0,1)$ and increasing $↗$ on $(1,\\infty )$, the graph of $f(x)$ goes up to the left and to the right of $x=1.$\n\n- Furthermore, since ${f}^{′}(x)$ is constant to the left of $x=0$, the graph of $y=f(x)$ represents a section of a straight line on $(-\\infty ,0).$ Also, since ${f}^{′}(x)$ is increasing to the right of $x=0$, we must have ${f}^{″}(x)>0.$ So, the curve $y=f(x)$ is concave up on $(0,\\infty ).$\n\n![](images/d8/d8cf7b97d4e9356b275b669d59b0498286bc673d55fbc533891daac369d5cd35.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/5f/5fc6864d1b7530ecd4fa1b151390b85d32a5d0628d0f51160cfaab7fc61e33b9.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186099175 :answer-field/correct 17592186099178 :db/ensure [:answer-field/validate]} {:db/id "question-140bcd57-110f-51e2-8837-ad085a0b4faa" :question/id #uuid "140bcd57-110f-51e2-8837-ad085a0b4faa" :question/math-academy-id "q-115938" :question/problem "![](images/02/02bec11dec3fc03b97b918c392969b246e6b2751d78c0b32b796bdeb4e6eaaca.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of a continuous function $y=f(x)$, is given above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point:  \n\n$\\,$ $x=-1$  \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical line $x=-1$ and choose an arbitrary point on it.\n\n$\\,$ So, we draw it as follows:\n\n![](images/90/9062dcd04f6ca0dcb21453596ebd007ccf91a33f5092a601d24e401e888a20f1.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-1)$ and increasing $↗$ on $(-1,\\infty )$, the graph of $f(x)$ goes up to the left and to the right of $x=-1.$\n\n- Moreover, since ${f}^{′}(x)$ is increasing to the left of $x=2$ and to the right of $x=2$, although with different slopes, we must have ${f}^{″}(x)>0.$ So, the curve $y=f(x)$ is concave up on $(-\\infty ,2)$  and on $(2,\\infty ).$\n\n![](images/fb/fbd0da8fbd98e0b83cd1efb82d5e1f1aca1bf40108e11c6a401da46e514a133a.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/95/95cc3ce5bab09a3e3ea32571e2156d13605b85bf8f026c7c35b5dd51d045c7fd.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-773c66ea-cbaa-54fe-9a70-61f6661e90d1"] :db/ensure [:question/validate]} {:db/id "answer-field-773c66ea-cbaa-54fe-9a70-61f6661e90d1" :answer-field/id #uuid "773c66ea-cbaa-54fe-9a70-61f6661e90d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b86c4088-ed6c-55c5-918a-4070ede987df" :answer-field/choices ["answer-b86c4088-ed6c-55c5-918a-4070ede987df" "answer-202a670c-3269-5f08-a7c3-3b9487b0946a" "answer-e60cb952-35e8-5356-be72-1d1afc0ff8f2" "answer-63d63f05-32fb-537b-8ebf-d31b75ad82aa" "answer-97f473a3-9332-5e36-8e77-f568b64c5771"] :db/ensure [:answer-field/validate]} {:db/id "answer-b86c4088-ed6c-55c5-918a-4070ede987df" :answer/id #uuid "b86c4088-ed6c-55c5-918a-4070ede987df" :answer/type :answer.type/image :answer/value "images/20/20fb26562589d8a59082444ca5b641fe5f30aee6397cbd3aed0fdd4473ac9834.png" :db/ensure [:answer/validate]} {:db/id "answer-202a670c-3269-5f08-a7c3-3b9487b0946a" :answer/id #uuid "202a670c-3269-5f08-a7c3-3b9487b0946a" :answer/type :answer.type/image :answer/value "images/41/41d7b307e397e681741e0e8dcec970910a321f5463faac0b416d342b8816dbc7.png" :db/ensure [:answer/validate]} {:db/id "answer-e60cb952-35e8-5356-be72-1d1afc0ff8f2" :answer/id #uuid "e60cb952-35e8-5356-be72-1d1afc0ff8f2" :answer/type :answer.type/image :answer/value "images/62/626cb1436a1c9088246e70624823e87c7314c02fa67c3d7a361cd13abb451c3a.png" :db/ensure [:answer/validate]} {:db/id "answer-63d63f05-32fb-537b-8ebf-d31b75ad82aa" :answer/id #uuid "63d63f05-32fb-537b-8ebf-d31b75ad82aa" :answer/type :answer.type/image :answer/value "images/b1/b19d252539cae91ae4d50be46f90a53eea32de60c0a1f2ab5e044a48484b7f37.png" :db/ensure [:answer/validate]} {:db/id "answer-97f473a3-9332-5e36-8e77-f568b64c5771" :answer/id #uuid "97f473a3-9332-5e36-8e77-f568b64c5771" :answer/type :answer.type/image :answer/value "images/dc/dc67c64ea8255e0c10b85d89015ad7be68260af9bb7eb1a8e5738da230899ea9.png" :db/ensure [:answer/validate]} {:db/id "question-02de7b14-03bb-5d7e-b753-b48cb91786a1" :question/id #uuid "02de7b14-03bb-5d7e-b753-b48cb91786a1" :question/math-academy-id "q-81019" :question/problem "![](images/2a/2ab398982e30d4b0ce633b77541596f3f5848e1b0a25539037ec3ee0fc557d4d.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of a continuous function $y=f(x)$, is given above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point:  \n\n$\\,$ $x=-1.$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,0)$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ |\n\n \n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical line $x=-1$ and choose an arbitrary point on it.\n\nSo, we draw it as follows:\n\n![](images/77/7719107149a10c6e5a22e6c343b532f3580582ebd78d3667aad5f2684d2f219d.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-1)$ and increasing $↗$ on $(-1,0)$, the graph of $f(x)$ goes up to the left and to the right of $x=-1.$\n\n- Furthermore, since ${f}^{′}(x)$ is increasing to the left of $x=0$, we must have ${f}^{″}(x)>0.$ So, the curve $y=f(x)$ is concave up on $(-\\infty ,0).$ Also, since ${f}^{′}(x)$ is constant and positive  to the right of $x=0$, the graph of $y=f(x)$ represents a section of an increasing straight line on $(0,\\infty ).$\n\n![](images/d8/d81008f3d06f41f53a389fa2f36a7b12845fa3dae5a2707a739bbb500c8b4e56.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/76/763163652b41a7b3cc0b7a6b3faca4799cc073238a50afd9bd3d9c7767c32793.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-38894a8b-e33a-540b-9475-aa15c26c72f9"] :db/ensure [:question/validate]} {:db/id "answer-field-38894a8b-e33a-540b-9475-aa15c26c72f9" :answer-field/id #uuid "38894a8b-e33a-540b-9475-aa15c26c72f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b407a60-9ac1-527a-af7c-51a98f704415" :answer-field/choices ["answer-38488cb0-1ec7-5a4b-a616-33b0ca9ac40a" "answer-7e8c7665-fc3c-5a68-8a99-fa28eed4ff40" "answer-b2aa3e73-5cb8-5796-b77f-f356b3ff0ee2" "answer-4b407a60-9ac1-527a-af7c-51a98f704415" "answer-cf830141-9ff6-5e11-a170-2bf7c88ce651"] :db/ensure [:answer-field/validate]} {:db/id "answer-38488cb0-1ec7-5a4b-a616-33b0ca9ac40a" :answer/id #uuid "38488cb0-1ec7-5a4b-a616-33b0ca9ac40a" :answer/type :answer.type/image :answer/value "images/5c/5cab7678c86c76fffbbc4c9bb851b5fedda6d0e9e49d81bb7fb073fc7fdfe05c.png" :db/ensure [:answer/validate]} {:db/id "answer-7e8c7665-fc3c-5a68-8a99-fa28eed4ff40" :answer/id #uuid "7e8c7665-fc3c-5a68-8a99-fa28eed4ff40" :answer/type :answer.type/image :answer/value "images/72/727d15daa2f28bcc0f22e2e1d3d2ef787b6eb62b32b381a62d89f1103f296ce9.png" :db/ensure [:answer/validate]} {:db/id "answer-b2aa3e73-5cb8-5796-b77f-f356b3ff0ee2" :answer/id #uuid "b2aa3e73-5cb8-5796-b77f-f356b3ff0ee2" :answer/type :answer.type/image :answer/value "images/7c/7c64b0683d9795ca8c3f76163e2d442d50f11f4735e32a43ab99dbec5707d79c.png" :db/ensure [:answer/validate]} {:db/id "answer-4b407a60-9ac1-527a-af7c-51a98f704415" :answer/id #uuid "4b407a60-9ac1-527a-af7c-51a98f704415" :answer/type :answer.type/image :answer/value "images/b2/b21b46ac542bbe3dad5074116ecb35eb269606723e714e22a8657b2f61c99252.png" :db/ensure [:answer/validate]} {:db/id "answer-cf830141-9ff6-5e11-a170-2bf7c88ce651" :answer/id #uuid "cf830141-9ff6-5e11-a170-2bf7c88ce651" :answer/type :answer.type/image :answer/value "images/c9/c98e84cf8d461815dc7579d9ee154b4536b41895d67a96c2014b03e9eaff901c.png" :db/ensure [:answer/validate]} {:db/id 17592186101479 :question/problem "![](images/58/58ebecdd8284dff6e807465f29c890bd87ec763896242cbff2bd1d18a4728f49.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of a continuous function $y=f(x)$, is given above. Which of the following could be the graph of $y=f(x)?$" :question/worked-solution "Recall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there are two critical points: \n\n$\\,$ $x=-2\\,$ and $\\,x=3$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-2)$ | $-2$ | $(-2,3)$ | $3$ | $(3,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{min}$ | $↗$ | $\\text{max}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical points. Consider the vertical lines $x=-2$ and $x=3.$\n\n- We choose an arbitrary point on the vertical line $x=-2.$\n\n- Since $f(x)$ is increasing $↗$ on $(-2,3),$ the point at $x=3$ must be higher than the point at $x=-2.$\n\nSo, we draw it as follows:\n\n![](images/ac/ac3ad854bdef4e5c7011a81a14da722cef44657e8024a39533179513589d0867.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-2)$ and increasing $↗$ on $(-2,3)$, the graph of $f(x)$ goes up to the left and to the right of $x=-2.$\n\n- Since $f(x)$ is increasing $↗$ on $(-2,3)$ and decreasing $↘$ on $(3,\\infty )$, the graph of $f(x)$ goes down to the left and to the right of $x=3.$\n\n- Furthermore, since ${f}^{′}(x)$ is increasing to the left of $x=1$, we must have ${f}^{″}(x)>0$, and, since it is decreasing to the right of $x=1$, we must have ${f}^{″}(x)<0.$ So, $x=1$ is an inflection point at which the curve $y=f(x)$ changes from concave up to concave down.\n\n![](images/81/81870d6d4fbba512d353788dd06062e380baeb672002f150b2c54eeac73a1bd7.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/b2/b243c1cfb9da30100aee5f215e02c5eb11769cef1ba4b2b5b74f2879e8a34e10.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186100035 :answer-field/correct 17592186100038 :db/ensure [:answer-field/validate]} {:db/id "question-585b182e-7b17-5dc5-940a-b3dd1c063524" :question/id #uuid "585b182e-7b17-5dc5-940a-b3dd1c063524" :question/math-academy-id "q-116853" :question/problem "If ${f}^{′}(x)=-|2x-5|$ and $f(1)=0,$ which of the following could be the graph of a continuous function  $y=f(x)?$" :question/worked-solution "The graph of $y={f}^{′}(x)$ is the following:\n\n![](images/5f/5f48f6278983a74be84b95984808b23745ab4960dbd427f942efe18df86768e8.png)\n\nRecall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=\\frac{5}{2}$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,\\frac{5}{2})$ | $2$ | $(\\frac{5}{2},\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{no extr.}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. Consider the vertical line  $x=\\frac{5}{2}.$ \n\n- Since we are told that $f(1)=0,$ we can draw that point on the graph.\n\n- Since $f(x)$ is decreasing $↘$ on $(1,\\frac{5}{2}),$ the point at $x=1$ must be higher than the point at $x=\\frac{5}{2}.$\n\n![](images/1f/1ff02109b863615e5274b9ac41306644d8d42ce62671e0e76ecbda6655d249e0.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,\\frac{5}{2})$ and on $(\\frac{5}{2},\\infty )$, the graph of $y=f(x)$ goes up to the left of $x=\\frac{5}{2}$ and goes down to the right of $x=\\frac{5}{2}.$\n\n- Furthermore, since ${f}^{′}(x)$ is increasing to the left of $x=\\frac{5}{2}$, we must have ${f}^{″}(x)>0$, and, since it is decreasing to the right of $x=\\frac{5}{2}$, we must have ${f}^{″}(x)<0.$ So, $x=\\frac{5}{2}$ is an inflection point at which the curve $y=f(x)$ changes from concave up to concave down.\n\nSo, we can draw as follows:\n\n![](images/93/931e7763569df18dd0aea8cd1363f6d8414f1a0cc8deddc964ba11a9c74fe127.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/ad/ad5016295fb3d33baac6af6e74dd3b2cbf563c74aef78bf27e5aed28222db3e7.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d3499959-bd1a-5110-afef-51a07c10785e"] :db/ensure [:question/validate]} {:db/id "answer-field-d3499959-bd1a-5110-afef-51a07c10785e" :answer-field/id #uuid "d3499959-bd1a-5110-afef-51a07c10785e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77d8afa2-9300-57e8-9603-62547c09412e" :answer-field/choices ["answer-662d296e-2fb6-522b-9d87-8b74a1007e0e" "answer-9b279c76-6d9a-53b2-819c-9b6329f30287" "answer-2501361d-dea7-52d8-95f4-909628b1ca49" "answer-70937625-c7a6-5e1c-afbe-168a45b60842" "answer-77d8afa2-9300-57e8-9603-62547c09412e"] :db/ensure [:answer-field/validate]} {:db/id "answer-662d296e-2fb6-522b-9d87-8b74a1007e0e" :answer/id #uuid "662d296e-2fb6-522b-9d87-8b74a1007e0e" :answer/type :answer.type/image :answer/value "images/01/01ee0bf05b0e8e3e3c42ef77d38a9613b33ef16106fd661646cedf1aead67652.png" :db/ensure [:answer/validate]} {:db/id "answer-9b279c76-6d9a-53b2-819c-9b6329f30287" :answer/id #uuid "9b279c76-6d9a-53b2-819c-9b6329f30287" :answer/type :answer.type/image :answer/value "images/1c/1ca104b65355875e55dcabee9e2e553c265812eb6b43fdf1b42df17d9590799f.png" :db/ensure [:answer/validate]} {:db/id "answer-2501361d-dea7-52d8-95f4-909628b1ca49" :answer/id #uuid "2501361d-dea7-52d8-95f4-909628b1ca49" :answer/type :answer.type/image :answer/value "images/1e/1e356ae7a05aed6c957e3f4bc4d0bb9cd3306fde032cdc4fce13b3f2670590f1.png" :db/ensure [:answer/validate]} {:db/id "answer-70937625-c7a6-5e1c-afbe-168a45b60842" :answer/id #uuid "70937625-c7a6-5e1c-afbe-168a45b60842" :answer/type :answer.type/image :answer/value "images/25/257a44d0001820f6df4c3039d7fd24b267bca0031140ccfb5fadd791848eb2d1.png" :db/ensure [:answer/validate]} {:db/id "answer-77d8afa2-9300-57e8-9603-62547c09412e" :answer/id #uuid "77d8afa2-9300-57e8-9603-62547c09412e" :answer/type :answer.type/image :answer/value "images/58/58ca054838929e04cbc16afaf793f46eef9bcbc9e29dc816419467b478ebdc60.png" :db/ensure [:answer/validate]} {:db/id "question-0bf75373-8a0d-58e6-9585-31096e6c716e" :question/id #uuid "0bf75373-8a0d-58e6-9585-31096e6c716e" :question/math-academy-id "q-49040" :question/problem "If ${f}^{′}(x)=|x+5|,$ which of the following could be the graph of a continuous function $y=f(x)?$" :question/worked-solution "The graph of $y={f}^{′}(x)$ is the following:\n\n![](images/ae/ae96c488c78fb207567c6ae0ea7497782af1e840a7852bd79b57902d45972a01.png)\n\nRecall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=-5$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-5)$ | $-5$ | $(-5,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $+$ | $0$ | $+$ |\n| $f$ | $↗$ | $\\text{no extr.}$ | $↗$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=-5,$ as shown below.\n\n![](images/2c/2c67c136914eba7687d96a66e737e2f1f7d96144d4535b25f0ac48e16aed8396.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $↗$ on $(-\\infty ,-5)$ and on $(-5,\\infty )$, the graph of $y=f(x)$ goes down to the left of $x=-5$ and goes up to the right of $x=-5.$\n\n- Furthermore, since ${f}^{′}(x)$ is decreasing to the left of $x=-5$, we must have ${f}^{″}(x)<0$, and, since it is increasing to the right of $x=-5$, we must have ${f}^{″}(x)>0.$ So, $x=-5$ is an inflection point at which the curve $y=f(x)$ changes from concave down to concave up.\n\nSo, we can draw as follows:\n\n![](images/97/971e495bbe1d7c502a1e65ec2b0764f0057158e3fe989261245382223020e872.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/00/00320e4c614d3ba3051ffca74a005113b057668488c12d50c5c497d613ce7492.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-12fe7014-9a7c-5cd6-8814-4c6fc23c44c1"] :db/ensure [:question/validate]} {:db/id "answer-field-12fe7014-9a7c-5cd6-8814-4c6fc23c44c1" :answer-field/id #uuid "12fe7014-9a7c-5cd6-8814-4c6fc23c44c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-07719b01-252d-561b-87e2-85e6097f49cc" :answer-field/choices ["answer-07719b01-252d-561b-87e2-85e6097f49cc" "answer-806f2f90-f4e8-5f10-b45c-0d7aaaa1c145" "answer-5f90d7a0-fc50-5df6-bd19-a6dbc4b8c478" "answer-bcdbe134-8973-5cf5-b776-513ac4d24b0c" "answer-610df0ff-02a5-5fd9-b2d8-32a935126b21"] :db/ensure [:answer-field/validate]} {:db/id "answer-07719b01-252d-561b-87e2-85e6097f49cc" :answer/id #uuid "07719b01-252d-561b-87e2-85e6097f49cc" :answer/type :answer.type/image :answer/value "images/52/526256c33ec7cc7dd4d2e66ac743ee4ec5f77cd6611be0058b803c29259824fd.png" :db/ensure [:answer/validate]} {:db/id "answer-806f2f90-f4e8-5f10-b45c-0d7aaaa1c145" :answer/id #uuid "806f2f90-f4e8-5f10-b45c-0d7aaaa1c145" :answer/type :answer.type/image :answer/value "images/68/684a49f4159946cf99aabca94aabeb8ff51f5913364e4f463e0922ec13f1ffa2.png" :db/ensure [:answer/validate]} {:db/id "answer-5f90d7a0-fc50-5df6-bd19-a6dbc4b8c478" :answer/id #uuid "5f90d7a0-fc50-5df6-bd19-a6dbc4b8c478" :answer/type :answer.type/image :answer/value "images/b7/b740045fb77d5e41f92f008ebfd17a29758ca79a0c6711cc9085d58928ec11d1.png" :db/ensure [:answer/validate]} {:db/id "answer-bcdbe134-8973-5cf5-b776-513ac4d24b0c" :answer/id #uuid "bcdbe134-8973-5cf5-b776-513ac4d24b0c" :answer/type :answer.type/image :answer/value "images/e9/e9cd32a7123e1b31ed920f5df4455fc66a69cb6ea38ae0d2a19d2ed1acf6daa3.png" :db/ensure [:answer/validate]} {:db/id "answer-610df0ff-02a5-5fd9-b2d8-32a935126b21" :answer/id #uuid "610df0ff-02a5-5fd9-b2d8-32a935126b21" :answer/type :answer.type/image :answer/value "images/fb/fb8dd043b5f55a1626e5a9856b6e59ef064d0ea73e28bab78ab04f38811b6ba1.png" :db/ensure [:answer/validate]} {:db/id "question-9fc26721-45c6-5872-bde4-819ab63691ac" :question/id #uuid "9fc26721-45c6-5872-bde4-819ab63691ac" :question/math-academy-id "q-86431" :question/problem "If ${f}^{′}(x)=-|x+1|,$ which of the following could be the graph of a continuous function $y=f(x)?$" :question/worked-solution "The graph of $y={f}^{′}(x)$ is the following:\n\n![](images/c4/c4e03ef210691e4eee922d0c35e90abb9cde1a78064ad491d4ac084d875c4a57.png)\n\nRecall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=-1$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{no extr.}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=-1,$ as shown below.\n\n![](images/40/40b5e9b8928be63a415877c0633f0302c874db51b1c74a1f82b7b1526a6f4d14.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-1)$ and is decreasing $↘$ on $(-1,\\infty )$, the graph of $y=f(x)$ goes up to the left of $x=-1$ and goes down to the right of $x=-1.$\n\n- Furthermore, since ${f}^{′}(x)$ is increasing to the left of $x=-1$, we must have ${f}^{″}(x)>0$, and, since it is decreasing to the right of $x=-1$, we must have ${f}^{″}(x)<0.$ So, $x=-1$ is an inflection point at which the curve $y=f(x)$ changes from concave up to concave down.\n\nSo, we can draw as follows:\n\n![](images/c6/c68544957f33afdeab436a3fbf75b9e27990a2e7f3ea75f39c6e58dce24f6185.png)\n\n \n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/4c/4c91ba8f06642fe14035400efa61dbd2d8bbadd07274fedc9a90678970bbb9a8.png)\n\n \n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-df53f24c-911c-54cb-8674-87e3cac5cc46"] :db/ensure [:question/validate]} {:db/id "answer-field-df53f24c-911c-54cb-8674-87e3cac5cc46" :answer-field/id #uuid "df53f24c-911c-54cb-8674-87e3cac5cc46" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29b1ea0c-801b-5be1-a08e-fdb6f8285ec8" :answer-field/choices ["answer-29b1ea0c-801b-5be1-a08e-fdb6f8285ec8" "answer-e2e0f135-edca-5fd3-bd5e-c030bd5dcea9" "answer-3de6f621-4b21-5871-a21a-bfd5edc277b7" "answer-685fcd83-1689-59db-af7a-bdad5315d17f" "answer-50c8ca44-7181-5697-b043-5a4ebdd0c813"] :db/ensure [:answer-field/validate]} {:db/id "answer-29b1ea0c-801b-5be1-a08e-fdb6f8285ec8" :answer/id #uuid "29b1ea0c-801b-5be1-a08e-fdb6f8285ec8" :answer/type :answer.type/image :answer/value "images/32/322c3c53bd12d39622f10afd832e474dafe5727d7efdfa02ca27a8180fdb1e21.png" :db/ensure [:answer/validate]} {:db/id "answer-e2e0f135-edca-5fd3-bd5e-c030bd5dcea9" :answer/id #uuid "e2e0f135-edca-5fd3-bd5e-c030bd5dcea9" :answer/type :answer.type/image :answer/value "images/42/420902d226813d062cf466223eca8b8f6eb5f38d664784c91d02e5b0c588013a.png" :db/ensure [:answer/validate]} {:db/id "answer-3de6f621-4b21-5871-a21a-bfd5edc277b7" :answer/id #uuid "3de6f621-4b21-5871-a21a-bfd5edc277b7" :answer/type :answer.type/image :answer/value "images/4f/4ff204021926fb8140deac869598a0b2d07af7aa713be3b86c038eee20762787.png" :db/ensure [:answer/validate]} {:db/id "answer-685fcd83-1689-59db-af7a-bdad5315d17f" :answer/id #uuid "685fcd83-1689-59db-af7a-bdad5315d17f" :answer/type :answer.type/image :answer/value "images/79/79898d06aa308ba19ea4877cc43660ef4dbce8f23fa6b22c70973338016591de.png" :db/ensure [:answer/validate]} {:db/id "answer-50c8ca44-7181-5697-b043-5a4ebdd0c813" :answer/id #uuid "50c8ca44-7181-5697-b043-5a4ebdd0c813" :answer/type :answer.type/image :answer/value "images/cc/cca7ac0dff44446267f01c7097816aa16bc9e649c01b04697903a39d3954fbfa.png" :db/ensure [:answer/validate]} {:db/id "question-67f4106c-b68b-5844-893c-27d541fb64bf" :question/id #uuid "67f4106c-b68b-5844-893c-27d541fb64bf" :question/math-academy-id "q-81038" :question/problem "If ${f}^{′}(x)=-|x-5|,$ which of the following could be the graph of a continuous function $y=f(x)?$" :question/worked-solution "The graph of $y={f}^{′}(x)$ is the following:\n\n![](images/54/54c03ba5ea869394d9b3d35c64bb012a8c5f9917a5ebb96fd67994ace6a84d4f.png)\n\nRecall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=5$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,5)$ | $5$ | $(5,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{no extr.}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=5,$ as shown below.\n\n![](images/25/25d067dcff3b0cc4b88859a318023288a7c9786b5c73910f2addf3952680596b.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,5)$ and on $(5,\\infty )$, the graph of $y=f(x)$ goes up to the left of $x=5$ and goes down to the right of $x=5.$\n\n- Furthermore, since ${f}^{′}(x)$ is increasing to the left of $x=5$, we must have ${f}^{″}(x)>0$, and, since it is decreasing to the right of $x=5$, we must have ${f}^{″}(x)<0.$ So, $x=5$ is an inflection point at which the curve $y=f(x)$ changes from concave up to concave down.\n\nSo, we can draw as follows:\n\n![](images/b7/b7b1e5915931501d881ba5efc1aaccb8af3a604ac397ac662d8bb7811659c17a.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/cb/cb451ce921bb8bc56576545b4503bf3dd44bb1ee070466576437c2ce980dd017.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-435e0da2-147f-55f1-880b-a1dae804184c"] :db/ensure [:question/validate]} {:db/id "answer-field-435e0da2-147f-55f1-880b-a1dae804184c" :answer-field/id #uuid "435e0da2-147f-55f1-880b-a1dae804184c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-67c380bc-a173-5d17-8537-696cff633db9" :answer-field/choices ["answer-67c380bc-a173-5d17-8537-696cff633db9" "answer-c70d4e54-a97f-5592-aa11-ebf05d4c3575" "answer-8b7211ad-1827-5211-9917-bc77faeb57bf" "answer-56465daf-a408-5f82-8ea8-358730019601" "answer-9a1d6226-8e44-5fa3-8504-f9d5ed1894cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-67c380bc-a173-5d17-8537-696cff633db9" :answer/id #uuid "67c380bc-a173-5d17-8537-696cff633db9" :answer/type :answer.type/image :answer/value "images/10/10e27a1d89f89773c96bf650876c2af9bdfc0bae9227f447d9b9e442c4721341.png" :db/ensure [:answer/validate]} {:db/id "answer-c70d4e54-a97f-5592-aa11-ebf05d4c3575" :answer/id #uuid "c70d4e54-a97f-5592-aa11-ebf05d4c3575" :answer/type :answer.type/image :answer/value "images/1e/1eca2e86f84ac8fd092d8a45fbf64d0967ec90510716c1cd956f4ae1908206fb.png" :db/ensure [:answer/validate]} {:db/id "answer-8b7211ad-1827-5211-9917-bc77faeb57bf" :answer/id #uuid "8b7211ad-1827-5211-9917-bc77faeb57bf" :answer/type :answer.type/image :answer/value "images/71/71e5c149ba535cd953324c90c6167182b3a16ac71fba585ae281280e7448f63f.png" :db/ensure [:answer/validate]} {:db/id "answer-56465daf-a408-5f82-8ea8-358730019601" :answer/id #uuid "56465daf-a408-5f82-8ea8-358730019601" :answer/type :answer.type/image :answer/value "images/9f/9f546deb760f9e18da71971d3fa3c01b9dd6897c4c60061823c85bb0783d2552.png" :db/ensure [:answer/validate]} {:db/id "answer-9a1d6226-8e44-5fa3-8504-f9d5ed1894cd" :answer/id #uuid "9a1d6226-8e44-5fa3-8504-f9d5ed1894cd" :answer/type :answer.type/image :answer/value "images/e2/e2c2ae047b8f684f61247d6e6ffdf9ae7207383af5e5dd97c485a1e69b0daa89.png" :db/ensure [:answer/validate]} {:db/id 17592186101445 :question/problem "If ${f}^{′}(x)=-|x+2|,$ which of the following could be the graph of a continuous function $y=f(x)?$" :question/worked-solution "The graph of $y={f}^{′}(x)$ is the following:\n\n![](images/0b/0bfc917724b8339ef52888f287f2bc1c69fca41e9207f42ff3d83a633fe3cc0a.png)\n\nRecall that critical points of $y=f(x)$ occur when ${f}^{′}(x)=0$ or ${f}^{′}(x)$ does not exist. In our case, there is one critical point: \n\n$\\,$ $x=-2$ \n\nAlso, we have the following: \n\n- If ${f}^{′}(x)>0$ then $f(x)$ is increasing.\n\n- If ${f}^{′}(x)<0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty ,-2)$ | $-2$ | $(-2,\\infty )$ |\n| --- | --- | --- | --- |\n| ${f}^{′}$ | $-$ | $0$ | $-$ |\n| $f$ | $↘$ | $\\text{no extr.}$ | $↘$ |\n\nLet's now sketch the graph of $y=f(x):$\n\n- First, we draw the critical point. We choose an arbitrary point on the vertical line $x=-2,$ as shown below.\n\n![](images/d0/d032eca4d1a29d5a7809dfd5c43cce52b8a0b66f1c8bdc9b9747cf704da524f5.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is decreasing $↘$ on $(-\\infty ,-2)$ and is decreasing $↘$ on $(-2,\\infty )$, the graph of $y=f(x)$ goes up to the left of $x=-2$ and goes down to the right of $x=-2.$\n\n- Furthermore, since ${f}^{′}(x)$ is increasing to the left of $x=-2$, we must have ${f}^{″}(x)>0$, and, since it is decreasing to the right of $x=-2$, we must have ${f}^{″}(x)<0.$ So, $x=-2$ is an inflection point at which the curve $y=f(x)$ changes from concave up to concave down.\n\nSo, we can draw as follows:\n\n![](images/ba/ba965ae91587d92beee6b5acb9af809167bb1de01fe1c2cdb8b0637244356e7f.png)\n\n- Finally, since we are told that our graph must be continuous, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x):$\n\n![](images/fb/fbe2e07c3c82e1140e2e9d687020ece8dad208251dfeec2bddbd27bc5c44841d.png)\n\n**Note:** The graph we obtained is not the only possible one. Any similar graph that's shifted vertically up or down could also be considered a possible $y=f(x).$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186099831 :answer-field/correct 17592186099833 :db/ensure [:answer-field/validate]} {:db/id 17592186102005 :tutorial/content "The graph of $y=f'(x),$ the derivative of $y=f(x)$ is shown below. Let's use this to sketch a possible graph of the original function, $y=f(x).$\n\n![](images/6c/6cd6c0fa999d571b54b7408856ecc8d091c2f4bb16b9f7bf85eb7f91b05629e4.png)\n\nRecall that the critical points of $y=f(x)$ occur when $f'(x)=0$ or $f'(x)$ does not exist. In our case, there are two critical points: \n\n$$\nx=-3\\quad \\textrm{and} \\quad x=1\n$$\n\nAlso, we have the following: \n\n- If $f'(x) > 0$ then $f(x)$ is increasing.\n\n- If $f'(x) <         0$ then $f(x)$ is decreasing.\n\nWe can now summarize the information from the graph in the table below.\n\n| $x$ | $(-\\infty,-3)$ | $-3$ | $(-3,1)$ | $1$ | $(1,\\infty)$ |\n| --- | --- | --- | --- | --- | --- |\n| $f'$ | $+$ | $0$ | $-$ | $0$ | $+$ |\n| $f$ | $\\nearrow$ | $\\textrm{max}$ | $\\searrow$ | $\\textrm{min}$ | $\\nearrow$ |\n\nLet's now sketch the graph of $y=f(x)\\mathbin{:}$\n\n- First, we draw the critical points. We choose an arbitrary point on the vertical lines $x=-3$ and $x=1.$ Since $f(x)$ is decreasing $\\searrow$ on $(-3,1),$ the point at $x=1$ must be lower than the point at $x=-3,$ as shown below.\n\n![](images/cb/cb0de4712344b43d32343f4d9fbc11d3dbc5c96df858f27bee599a3ffdd448ce.png)\n\n- Next, we consider the behavior of $y=f(x)$ in the neighborhood of the critical points:\n\n- Since $f(x)$ is increasing $\\nearrow$ on $(-\\infty,-3)$ and decreasing $\\searrow$ on $(-3,1)$, the graph of $f(x)$ goes down to the left and to the right of $x=-3.$\n\n- Since $f(x)$ is decreasing $\\searrow$ on $(-3,1)$ and increasing $\\nearrow$ on $(1,\\infty)$, the graph of $f(x)$ goes up to the left and to the right of $x=1.$\n\n![](images/34/3498651b6a642f59068f23e8ed9ddd211bfb76ab4d0bf8e28cefd84d1a4b2aed.png)\n\n- Finally, by connecting and extending the existing parts with a smooth curve, we obtain a possible graph of $y=f(x)\\mathbin{:}$\n\n![](images/25/257203aa25e423bf82ce745a6a8a3563aa80e414e9dfadf0be64629624cbce0e.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186102006 :tutorial/content "Let's draw our possible function $y=f(x)$ once more. The graph of its derivative $y=f'(x)$ is also shown.\n\n![](images/18/189c181d3767960f39fc0cfcb06dac5bf6fca07e303b11999307551d081ffc1e.png)\n\nIn reality, there are infinitely many possible graphs of $f(x)$ that can be drawn if we are given only the graph of $f'(x).$ We can always shift the graph up and down as we please, because the slopes of the tangent lines do not change. For the problem above, any of the following graphs would be valid:\n\n![](images/e4/e49f65d7306192d73001552084f06cf39731f38f3ccc14dd6b2f5f7641ec43aa.png)\n\nIn this topic, we will focus on sketching a *possible* graph of $y=f(x)$ given the graph of $y=f'(x).$ But bear in mind that whatever $y=f(x)$ we sketch, we can get an equally valid answer by shifting or $y=f(x)$ curve up or down by an arbitrary amount. \n\nThe only exception is if we're given a point on the curve $y=f(x).$ If we're given a point, this has the effect of *fixing* our answer to a particular curve. We'll see an example of this next." :db/ensure [:tutorial/validate]} {:db/id 17592186101062 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} {:db/id 17592186064189 :knowledge-point/questions ["question-a77a6bbf-206b-5fc8-b45f-b94bd7cd1684" "question-c63b77a8-effd-51a8-a515-1fb5e14ee3e6" "question-e61eca8e-14ab-54c4-ad94-08eb1910feb8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064064 :question/problem "Evaluate $\\log_{2} \\left( 2^{5} \\right).$" :question/worked-solution "The logarithm reverses the action of the exponent. The idea is that the log of a power of the base equals the power itself:\n\n$$\n\\log_b(b^x) = x\n$$\n\nIn our case, we have $b=2$ and $x=5.$ Therefore,\n\n$$\n\\log_{2}\\left( 2^{5}\\right) = 5.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064192 :knowledge-point/questions ["question-c67b84ce-63b0-5172-a4ca-d019c33deb20" "question-8fd2dd92-c19f-59ac-abcb-f54b4019b8cc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064067 :question/problem "Find the value of $\\log_{3}{9}.$" :question/worked-solution "First, we rewrite $9$ as a power of $3$ (the base of the logarithm) as follows:\n\n$$\n9 = 3^2\n$$\n\nTherefore, we have\n\n$$\n\\log_{3}{9} = \\log_{3}(3^2).\n$$\n\nNow we can proceed as usual. The log of a power of the base equals the power itself:\n\n$$\n\\log_b(b^x) = x\n$$\n\nIn our case, we have $b = 3$ and $x = 2.$ Therefore,\n\n$$\n\\log_{3}(3^2) = 2.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064191 :knowledge-point/questions ["question-6c887066-3c08-5cb4-b40e-433eb14c4b31" "question-64f9b7ab-1e87-57f9-b089-cc6f9c501397"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064066 :question/problem "Evaluate $\\log_{2} \\left(\\dfrac 1 {8} \\right).$" :question/worked-solution "First, we rewrite $\\dfrac{1}{8}$ as a power of $2$ (the base of the logarithm) as follows:\n\n$$\n\\dfrac{1}{8} = \\dfrac{1}{2^3} = 2^{-3}\n$$\n\nTherefore, we have\n\n$$\n\\log_{2} \\left(\\dfrac 1 {8} \\right)= \\log_{2} (2^{-3}).\n$$\n\nNow we can proceed as usual. The log of a power of the base equals the power itself:\n\n$$\n\\log_b(b^x) = x\n$$\n\nIn our case, we have $b=2$ and $x=-3.$ Therefore,\n\n$$\n\\log_{2}( 2^{-3} )= -3.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064190 :knowledge-point/questions ["question-25969868-abb0-5d93-a9b3-c99a6eb6f487" "question-d8d5b32c-2799-58e2-987c-6d259f700464" "question-f14ba22e-b6ea-5533-a5ad-bd5ce2cfcd84" "question-c8c27c46-9870-56fc-a5a5-2b4126a5a87a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064065 :question/problem "Find the value of $\\log_{8}{8}.$" :question/worked-solution "We have the general rule that\n\n$$\n\\log_n n = 1.\n$$\n\nIn our case, $n=8.$ Therefore,\n\n$$\n\\log_{8}{8} =1.\n$$" :db/ensure [:question/validate]} {:db/id "question-a77a6bbf-206b-5fc8-b45f-b94bd7cd1684" :question/id #uuid "a77a6bbf-206b-5fc8-b45f-b94bd7cd1684" :question/math-academy-id "q-26049" :question/problem "Calculate ${log}_{7}⁡({7}^{2/5})$ without using a calculator." :question/worked-solution "The logarithm reverses the action of the exponent. The principle is:\n\n$$\n{log}_{b}⁡({b}^{x})=x\n$$\n\nIn our case, we have $b=7$ and $x=\\frac{2}{5}.$ Therefore:\n\n$$\n{log}_{7}⁡({7}^{2/5})=\\frac{2}{5}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-32e989a8-5da1-5f6b-b249-2262d0daf987"] :db/ensure [:question/validate]} {:db/id "answer-field-32e989a8-5da1-5f6b-b249-2262d0daf987" :answer-field/id #uuid "32e989a8-5da1-5f6b-b249-2262d0daf987" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84382bd8-f36d-5f7a-b072-b04d4b8a1fe3" :answer-field/choices ["answer-98844e2a-0c97-5c72-9178-65b6ee544a3c" "answer-591daee5-cf2c-5577-abe9-91f93be8ee26" "answer-34756977-f98a-5aff-8ba4-53b8297e5431" "answer-84382bd8-f36d-5f7a-b072-b04d4b8a1fe3" "answer-6a7226ed-8422-5019-a7fe-28466b58126a"] :db/ensure [:answer-field/validate]} {:db/id "answer-98844e2a-0c97-5c72-9178-65b6ee544a3c" :answer/id #uuid "98844e2a-0c97-5c72-9178-65b6ee544a3c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-591daee5-cf2c-5577-abe9-91f93be8ee26" :answer/id #uuid "591daee5-cf2c-5577-abe9-91f93be8ee26" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-34756977-f98a-5aff-8ba4-53b8297e5431" :answer/id #uuid "34756977-f98a-5aff-8ba4-53b8297e5431" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-84382bd8-f36d-5f7a-b072-b04d4b8a1fe3" :answer/id #uuid "84382bd8-f36d-5f7a-b072-b04d4b8a1fe3" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-6a7226ed-8422-5019-a7fe-28466b58126a" :answer/id #uuid "6a7226ed-8422-50