ast two terms, we get\n\n$$\n{(x+\\frac{7}{2})}^{2}-\\frac{5}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{x}^{2}-7x-11 & =-({(x+\\frac{7}{2})}^{2}-\\frac{5}{4}) \\\\  & =\\frac{5}{4}-{(x+\\frac{7}{2})}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d040eed3-515d-5c40-bf7b-ad0d3ff29d67"] :db/ensure [:question/validate]} {:db/id "answer-field-d040eed3-515d-5c40-bf7b-ad0d3ff29d67" :answer-field/id #uuid "d040eed3-515d-5c40-bf7b-ad0d3ff29d67" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e7716d6f-5fc6-5f2a-ab7a-5ec082b205e1" :answer-field/choices ["answer-00561303-4d8b-5648-aef1-ded86fb68a13" "answer-15ab2670-044a-519f-a892-d7c304eec4e9" "answer-e7716d6f-5fc6-5f2a-ab7a-5ec082b205e1" "answer-c588653b-6c79-5422-bfe3-23e763ffffb1" "answer-f65885a6-a87b-5af6-b23f-932e21b5918e"] :db/ensure [:answer-field/validate]} {:db/id "answer-00561303-4d8b-5648-aef1-ded86fb68a13" :answer/id #uuid "00561303-4d8b-5648-aef1-ded86fb68a13" :answer/type :answer.type/math :answer/value "38-{(x+14)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-15ab2670-044a-519f-a892-d7c304eec4e9" :answer/id #uuid "15ab2670-044a-519f-a892-d7c304eec4e9" :answer/type :answer.type/math :answer/value "\\frac{5}{2}+{(x+\\frac{7}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e7716d6f-5fc6-5f2a-ab7a-5ec082b205e1" :answer/id #uuid "e7716d6f-5fc6-5f2a-ab7a-5ec082b205e1" :answer/type :answer.type/math :answer/value "\\frac{5}{4}-{(x+\\frac{7}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c588653b-6c79-5422-bfe3-23e763ffffb1" :answer/id #uuid "c588653b-6c79-5422-bfe3-23e763ffffb1" :answer/type :answer.type/math :answer/value "\\frac{7}{4}+{(x+\\frac{7}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f65885a6-a87b-5af6-b23f-932e21b5918e" :answer/id #uuid "f65885a6-a87b-5af6-b23f-932e21b5918e" :answer/type :answer.type/math :answer/value "\\frac{93}{4}-{(x-\\frac{7}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "question-464780e0-2b69-5233-beb8-cdc5f928ae62" :question/id #uuid "464780e0-2b69-5233-beb8-cdc5f928ae62" :question/math-academy-id "q-142072" :question/problem "Rewrite $-{y}^{2}+9y+\\frac{1}{4}$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({y}^{2}-9y-\\frac{1}{4})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-9y-\\frac{1}{4}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{9}{2}y-\\frac{1}{4}\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{9}{2})}^{2},$ writing the constant term $-\\frac{1}{4}$ last:\n\n$$\n{{y}^{2}-2\\cdot \\frac{9}{2}y+{(\\frac{9}{2})}^{2}}_{⏟}-{(\\frac{9}{2})}^{2}-\\frac{1}{4}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{9}{2})}^{2}-{(\\frac{9}{2})}^{2}-\\frac{1}{4}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{9}{2})}^{2}-\\frac{41}{2}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}+9y+\\frac{1}{4} & =-({(y-\\frac{9}{2})}^{2}-\\frac{41}{2}) \\\\  & =\\frac{41}{2}-{(y-\\frac{9}{2})}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-59a58e43-e215-570e-85ca-38eb345f6b39"] :db/ensure [:question/validate]} {:db/id "answer-field-59a58e43-e215-570e-85ca-38eb345f6b39" :answer-field/id #uuid "59a58e43-e215-570e-85ca-38eb345f6b39" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ff5f00d8-7485-5f2b-815c-34d67d987271" :answer-field/choices ["answer-a7969ead-7a86-53c0-8879-105a6fba4435" "answer-4346ba55-161e-55f0-af3a-5ede323b90c9" "answer-20969546-8cf5-58bf-9f69-aa85c2b994ea" "answer-ff5f00d8-7485-5f2b-815c-34d67d987271" "answer-e1ca5c4a-5384-5160-a988-e4dc1ad1f8bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7969ead-7a86-53c0-8879-105a6fba4435" :answer/id #uuid "a7969ead-7a86-53c0-8879-105a6fba4435" :answer/type :answer.type/math :answer/value "-20-{(y+\\frac{9}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-4346ba55-161e-55f0-af3a-5ede323b90c9" :answer/id #uuid "4346ba55-161e-55f0-af3a-5ede323b90c9" :answer/type :answer.type/math :answer/value "-\\frac{83}{4}+{(y+\\frac{9}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-20969546-8cf5-58bf-9f69-aa85c2b994ea" :answer/id #uuid "20969546-8cf5-58bf-9f69-aa85c2b994ea" :answer/type :answer.type/math :answer/value "20-{(y-\\frac{9}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ff5f00d8-7485-5f2b-815c-34d67d987271" :answer/id #uuid "ff5f00d8-7485-5f2b-815c-34d67d987271" :answer/type :answer.type/math :answer/value "\\frac{41}{2}-{(y-\\frac{9}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e1ca5c4a-5384-5160-a988-e4dc1ad1f8bb" :answer/id #uuid "e1ca5c4a-5384-5160-a988-e4dc1ad1f8bb" :answer/type :answer.type/math :answer/value "\\frac{53}{4}-{(y+\\frac{9}{2})}^{2}" :db/ensure [:answer/validate]} {:db/id "question-8898e4ea-fd1e-55a2-a1c5-4594ef5b35cf" :question/id #uuid "8898e4ea-fd1e-55a2-a1c5-4594ef5b35cf" :question/math-academy-id "q-140372" :question/problem "Rewrite $4{x}^{2}+24x$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $4.$ So, we take out a factor of $4$ from the entire expression:\n\n$$\n4({x}^{2}+6x)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+6x\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x\n$$\n\nThen, we *add* and *then subtract* ${3}^{2}:$\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-{3}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+3)}^{2}-{3}^{2}\n$$\n\nEvaluating the last term, we get\n\n$$\n{(x+3)}^{2}-9.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}4({x}^{2}+6x) & =4({(x+3)}^{2}-9) \\\\  & =4{(x+3)}^{2}-4\\cdot 9 \\\\  & =4{(x+3)}^{2}-36\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7ba3c8f5-6904-5eb8-80c0-90dc9cc21c69"] :db/ensure [:question/validate]} {:db/id "answer-field-7ba3c8f5-6904-5eb8-80c0-90dc9cc21c69" :answer-field/id #uuid "7ba3c8f5-6904-5eb8-80c0-90dc9cc21c69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2a4d1d7e-a98a-55e8-bd06-08ce93773259" :answer-field/choices ["answer-980a2775-c11b-5cae-b3d8-18d6a1cfca30" "answer-2a4d1d7e-a98a-55e8-bd06-08ce93773259" "answer-43ec7ab1-5c7b-5fcc-ab24-6478badcd194" "answer-d4cb9f0b-5610-5d8c-b091-422fff9bdf3b" "answer-2c63e279-30b2-51d5-b8e5-956913e9730a"] :db/ensure [:answer-field/validate]} {:db/id "answer-980a2775-c11b-5cae-b3d8-18d6a1cfca30" :answer/id #uuid "980a2775-c11b-5cae-b3d8-18d6a1cfca30" :answer/type :answer.type/math :answer/value "4{(x+3)}^{2}-18" :db/ensure [:answer/validate]} {:db/id "answer-2a4d1d7e-a98a-55e8-bd06-08ce93773259" :answer/id #uuid "2a4d1d7e-a98a-55e8-bd06-08ce93773259" :answer/type :answer.type/math :answer/value "4{(x+3)}^{2}-36" :db/ensure [:answer/validate]} {:db/id "answer-43ec7ab1-5c7b-5fcc-ab24-6478badcd194" :answer/id #uuid "43ec7ab1-5c7b-5fcc-ab24-6478badcd194" :answer/type :answer.type/math :answer/value "4{(x+3)}^{2}-9" :db/ensure [:answer/validate]} {:db/id "answer-d4cb9f0b-5610-5d8c-b091-422fff9bdf3b" :answer/id #uuid "d4cb9f0b-5610-5d8c-b091-422fff9bdf3b" :answer/type :answer.type/math :answer/value "4{(x+\\frac{3}{2})}^{2}-9" :db/ensure [:answer/validate]} {:db/id "answer-2c63e279-30b2-51d5-b8e5-956913e9730a" :answer/id #uuid "2c63e279-30b2-51d5-b8e5-956913e9730a" :answer/type :answer.type/math :answer/value "4{(x+\\frac{3}{2})}^{2}-\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id 17592186184804 :question/problem "Rewrite $8{x}^{2}-4x$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $8.$ So, we take out a factor of $8$ from the entire expression:\n\n$$\n8({x}^{2}-\\frac{1}{2}x)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-\\frac{1}{2}x\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{1}{4}x\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{4})}^{2}:$ \n\n$$\n{{x}^{2}-2\\cdot \\frac{1}{4}x+{(\\frac{1}{4})}^{2}}_{⏟}-{(\\frac{1}{4})}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{1}{4})}^{2}-{(\\frac{1}{4})}^{2}\n$$\n\nEvaluating the last term, we get\n\n$$\n{(x-\\frac{1}{4})}^{2}-\\frac{1}{16}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}8({x}^{2}-\\frac{1}{2}x) & =8({(x-\\frac{1}{4})}^{2}-\\frac{1}{16}) \\\\  & =8{(x-\\frac{1}{4})}^{2}-8\\cdot \\frac{1}{16} \\\\  & =8{(x-\\frac{1}{4})}^{2}-\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186183433 :answer-field/correct "answer-49d841e1-6a02-5efb-8678-6fe6afc6b67c" :answer-field/choices ["answer-49d841e1-6a02-5efb-8678-6fe6afc6b67c" "answer-ac757b0b-83df-5393-8914-188485d81214" "answer-0d0f7330-a210-5dab-b07f-e27d8a72ece9" "answer-8ae41a75-4ff5-594a-978f-7c64fa1799af" "answer-8bc81ce1-b560-5ed7-949e-b540fa0823c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-49d841e1-6a02-5efb-8678-6fe6afc6b67c" :answer/id #uuid "49d841e1-6a02-5efb-8678-6fe6afc6b67c" :answer/type :answer.type/math :answer/value "8{(x-\\frac{1}{4})}^{2}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ac757b0b-83df-5393-8914-188485d81214" :answer/