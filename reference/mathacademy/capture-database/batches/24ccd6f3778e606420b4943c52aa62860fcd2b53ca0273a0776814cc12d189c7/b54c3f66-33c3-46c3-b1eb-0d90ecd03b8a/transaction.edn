{q}-4\\sqrt{q}+2\\sqrt{q} & = \\\\ (3+2)\\sqrt[3]{q}+(-4+2)\\sqrt{q} & = \\\\ 5\\sqrt[3]{q}-2\\sqrt{q} & \\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{q}$ and $\\sqrt{q}$ terms." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c53cc0e1-da9e-551f-a889-af2f14ce3458"] :db/ensure [:question/validate]} {:db/id "answer-field-c53cc0e1-da9e-551f-a889-af2f14ce3458" :answer-field/id #uuid "c53cc0e1-da9e-551f-a889-af2f14ce3458" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a63a6e70-5841-5920-be18-141632aa45e8" :answer-field/choices ["answer-e0a4d7e2-717f-59ea-b8b6-591fcebb1d42" "answer-528ae977-d06b-5c6e-9c5a-f9b69e895a8d" "answer-e4335664-d920-5a4b-a640-c4944143fa22" "answer-2b2b8404-6210-5633-8b09-63f13a00d71b" "answer-a63a6e70-5841-5920-be18-141632aa45e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0a4d7e2-717f-59ea-b8b6-591fcebb1d42" :answer/id #uuid "e0a4d7e2-717f-59ea-b8b6-591fcebb1d42" :answer/type :answer.type/math :answer/value "-\\sqrt[3]{q}+4\\sqrt{q}" :db/ensure [:answer/validate]} {:db/id "answer-528ae977-d06b-5c6e-9c5a-f9b69e895a8d" :answer/id #uuid "528ae977-d06b-5c6e-9c5a-f9b69e895a8d" :answer/type :answer.type/math :answer/value "3\\sqrt[3]{q}" :db/ensure [:answer/validate]} {:db/id "answer-e4335664-d920-5a4b-a640-c4944143fa22" :answer/id #uuid "e4335664-d920-5a4b-a640-c4944143fa22" :answer/type :answer.type/math :answer/value "3\\sqrt[3]{q}+2\\sqrt{q}" :db/ensure [:answer/validate]} {:db/id "answer-2b2b8404-6210-5633-8b09-63f13a00d71b" :answer/id #uuid "2b2b8404-6210-5633-8b09-63f13a00d71b" :answer/type :answer.type/math :answer/value "3\\sqrt{q}" :db/ensure [:answer/validate]} {:db/id "answer-a63a6e70-5841-5920-be18-141632aa45e8" :answer/id #uuid "a63a6e70-5841-5920-be18-141632aa45e8" :answer/type :answer.type/math :answer/value "5\\sqrt[3]{q}-2\\sqrt{q}" :db/ensure [:answer/validate]} {:db/id "question-09941e60-aba3-5a69-ab9a-c50e221cd8d0" :question/id #uuid "09941e60-aba3-5a69-ab9a-c50e221cd8d0" :question/math-academy-id "q-134504" :question/problem "Simplify $\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{p}$ terms together, but we cannot combine $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms:\n\n$$\n\\begin{aligned}\\sqrt[3]{p}+4\\sqrt{p}-6\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}+\\sqrt[3]{p}-6\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}+(1-6)\\sqrt[3]{p} & = \\\\ 4\\sqrt{p}-5\\sqrt[3]{p} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f877f913-f3d5-5963-b845-f4d71f87b43c"] :db/ensure [:question/validate]} {:db/id "answer-field-f877f913-f3d5-5963-b845-f4d71f87b43c" :answer-field/id #uuid "f877f913-f3d5-5963-b845-f4d71f87b43c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer-field/choices ["answer-2c27b2f1-36dd-5430-a493-ff6a014ae9b2" "answer-5bc8c704-d1c4-59fd-a6c2-bf73a1a9ea59" "answer-3a1a81c7-f1e5-5830-91a9-9aede4bd40aa" "answer-0fee27c5-65e3-596c-92c8-4162ad079fb5" "answer-61e5f9d5-ceea-58e8-8b94-2e31f14539f0"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c27b2f1-36dd-5430-a493-ff6a014ae9b2" :answer/id #uuid "2c27b2f1-36dd-5430-a493-ff6a014ae9b2" :answer/type :answer.type/math :answer/value "-\\sqrt[3]{p}" :db/ensure [:answer/validate]} {:db/id "answer-5bc8c704-d1c4-59fd-a6c2-bf73a1a9ea59" :answer/id #uuid "5bc8c704-d1c4-59fd-a6c2-bf73a1a9ea59" :answer/type :answer.type/math :answer/value "-\\sqrt{p}" :db/ensure [:answer/validate]} {:db/id "answer-3a1a81c7-f1e5-5830-91a9-9aede4bd40aa" :answer/id #uuid "3a1a81c7-f1e5-5830-91a9-9aede4bd40aa" :answer/type :answer.type/math :answer/value "4\\sqrt{p}+6\\sqrt[3]{p}" :db/ensure [:answer/validate]} {:db/id "answer-0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer/id #uuid "0fee27c5-65e3-596c-92c8-4162ad079fb5" :answer/type :answer.type/math :answer/value "4\\sqrt{p}-5\\sqrt[3]{p}" :db/ensure [:answer/validate]} {:db/id "answer-61e5f9d5-ceea-58e8-8b94-2e31f14539f0" :answer/id #uuid "61e5f9d5-ceea-58e8-8b94-2e31f14539f0" :answer/type :answer.type/math :answer/value "5\\sqrt{p}-6\\sqrt[3]{p}" :db/ensure [:answer/validate]} {:db/id "question-2b536617-f99c-5ac2-ab20-131751027d16" :question/id #uuid "2b536617-f99c-5ac2-ab20-131751027d16" :question/math-academy-id "q-34203" :question/problem "Simplify $8\\sqrt{a}+9\\sqrt[3]{a}+3\\sqrt[3]{a}.$" :question/worked-solution "We can combine the two $\\sqrt[3]{a}$ terms together, but we cannot combine $\\sqrt[3]{a}$ and $\\sqrt{a}$ term:\n\n$$\n\\begin{aligned}8\\sqrt{a}+9\\sqrt[3]{a}+3\\sqrt[3]{a} & = \\\\ 8\\sqrt{a}+(9+3)\\sqrt[3]{a} & = \\\\ 8\\sqrt{a}+12\\sqrt[3]{a} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b5a34002-68da-5cb0-ae07-e3053d069076"] :db/ensure [:question/validate]} {:db/id "answer-field-b5a34002-68da-5cb0-ae07-e3053d069076" :answer-field/id #uuid "b5a34002-68da-5cb0-ae07-e3053d069076" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e1f7442-f98f-5cfa-8619-f2ec4315173a" :answer-field/choices ["answer-100abe81-d1c0-5161-a04e-33a7b5191e1b" "answer-ccf9de9b-45e4-5332-8a6c-a8aecf8d85d5" "answer-8e1f7442-f98f-5cfa-8619-f2ec4315173a" "answer-ff435ffa-2ffe-5bba-8398-60ba2c315789" "answer-e518a7ea-b1f3-5d92-97dc-7835eada6dcd"] :db/ensure [:answer-field/validate]} {:db/id "answer-100abe81-d1c0-5161-a04e-33a7b5191e1b" :answer/id #uuid "100abe81-d1c0-5161-a04e-33a7b5191e1b" :answer/type :answer.type/math :answer/value "20\\sqrt[3]{a}" :db/ensure [:answer/validate]} {:db/id "answer-ccf9de9b-45e4-5332-8a6c-a8aecf8d85d5" :answer/id #uuid "ccf9de9b-45e4-5332-8a6c-a8aecf8d85d5" :answer/type :answer.type/math :answer/value "20\\sqrt{a}" :db/ensure [:answer/validate]} {:db/id "answer-8e1f7442-f98f-5cfa-8619-f2ec4315173a" :answer/id #uuid "8e1f7442-f98f-5cfa-8619-f2ec4315173a" :answer/type :answer.type/math :answer/value "8\\sqrt{a}+12\\sqrt[3]{a}" :db/ensure [:answer/validate]} {:db/id "answer-ff435ffa-2ffe-5bba-8398-60ba2c315789" :answer/id #uuid "ff435ffa-2ffe-5bba-8398-60ba2c315789" :answer/type :answer.type/math :answer/value "8\\sqrt{a}+27\\sqrt[3]{a}" :db/ensure [:answer/validate]} {:db/id "answer-e518a7ea-b1f3-5d92-97dc-7835eada6dcd" :answer/id #uuid "e518a7ea-b1f3-5d92-97dc-7835eada6dcd" :answer/type :answer.type/math :answer/value "8\\sqrt{a}+6\\sqrt[3]{a}" :db/ensure [:answer/validate]} {:db/id 17592186180739 :tutorial/content "When dealing with sums or differences of square roots, we can combine any terms with the same algebraic expression under the square root symbol $\\sqrt{\\phantom 0}.$ This is similar to collecting like terms in a linear expression.\n\nFor example, consider the following expression:\n\n$$\n5\\sqrt{x} - 3\\sqrt{x}\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}5\\sqrt{x}-3\\sqrt{x} & = \\\\ (5-3)\\sqrt{x} & = \\\\ 2\\sqrt{x} & \\end{aligned}\n$$\n\nWe *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n5\\sqrt{x} - 3\\sqrt{y}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt y.$" :db/ensure [:tutorial/validate]} {:db/id 17592186180750 :tutorial/content "We can simplify cube root expressions in the same way as with square roots.\n\nFor example, consider the following expression:\n\n$$\n4\\sqrt[3]x - 2\\sqrt[3] x\n$$\n\nWe can simplify our expression by combining the two radicals, as follows:\n\n$$\n\\begin{aligned}4\\sqrt[3]{x}-2\\sqrt[3]{x} & = \\\\ (4-2)\\sqrt[3]{x} & = \\\\ 2\\sqrt[3]{x} & \\end{aligned}\n$$\n\n \n\nAs with square roots, we *cannot* combine terms when the expressions under the radical are different. For example, the expression\n\n$$\n\\sqrt[3]{x-1} + \\sqrt[3]{x+1}\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt[3]{x-1}$ and $\\sqrt[3]{x+1}.$\n\nFinally, it is not possible to combine square root and cube root terms, even if the numbers under the radical symbol are the same! For example, the expression\n\n$$\n2\\sqrt x + \\sqrt[3] x\n$$\n\ncannot be simplified because there is no way of combining $\\sqrt x$ and $\\sqrt[3] x.$" :db/ensure [:tutorial/validate]} {:db/id 17592186179899 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} [:db/retract 17592186183433 :answer-field/choices 17592186183434] [:db/retract 17592186183433 :answer-field/choices 17592186183435] [:db/retract 17592186183433 :answer-field/choices 17592186183436] [:db/retract 17592186183433 :answer-field/choices 17592186183437] [:db/retract 17592186183433 :answer-field/choices 17592186183438] {:db/id 17592186184211 :knowledge-point/questions ["question-e1ed5444-a38b-5b2e-8f5a-4a0e97b37ff2" "question-82dc9974-9e37-5f33-ad85-854a2a504fcc" "question-5bc52b75-4c42-58c5-bcab-077cbe6faec2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184322 :knowledge-point/questions ["question-aef8db66-e528-55a5-877b-5de5c3121fc3" "question-eaa23e3b-bd80-5fbc-b343-c6e4d7d3776d" "question-464780e0-2b69-5233-beb8-cdc5f928ae62"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184323 :knowledge-point/questions ["question-8898e4ea-fd1e-55a2-a1c5-4594ef5b35cf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184212 :knowledge-point/questions ["question-badd637f-464d-556b-9b5c-ae357a07836a" "question-fc2b2629-e323-5ab5-9be3-1b12132dec56" "question-517afe53-217c-5ede-9811-b9bf164398f6" "question-07e09125-f910-5338-a71f-7baf6d758234"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e1ed5444-a38b-5b2e-8f5a-4a0e97b37ff2" :question/id #uuid "e1ed5444-a38b-5b2e-8f5a-4a0e97b37ff2" :question/math-academy-id "q-25254" :question/problem "Rewrite $-19-14z-{z}^{2}$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({z}^{2}+14z+19)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+14z+19\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot 7z+19\n$$\n\nThen, we add and then subtract ${7}^{2},$ writing the constant term $19$ last:\n\n$$\n{{z}^{2}+2\\cdot 7z+{7}^{2}}_{⏟}-{7}^{2}+19\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(z+7)^{2}-{7}^{2}+19\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(z+7)^{2}-30\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-19-14z-{z}^{2} & =-((z+7)^{2}-30) \\\\  & =-(z+7)^{2}+30 \\\\  & =30-(z+7)^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8320e095-8ba2-55cc-97f8-a79ff22fad04"] :db/ensure [:question/validate]} {:db/id "answer-field-8320e095-8ba2-55cc-97f8-a79ff22fad04" :answer-field/id #uuid "8320e095-8ba2-55cc-97f8-a79ff22fad04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce1bc6cb-574c-563d-b544-da9018d44b27" :answer-field/choices ["answer-702b8582-b9b0-567b-af2b-a8dfa70c095a" "answer-9269d8f3-f3eb-5f87-9901-6dc53e2775ad" "answer-ce1bc6cb-574c-563d-b544-da9018d44b27" "answer-87a9058b-6617-5b7b-a686-12d2470baa79" "answer-0d1542e3-e27b-5f3b-a9cf-d176370aebd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-702b8582-b9b0-567b-af2b-a8dfa70c095a" :answer/id #uuid "702b8582-b9b0-567b-af2b-a8dfa70c095a" :answer/type :answer.type/math :answer/value "16-(z+7)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-9269d8f3-f3eb-5f87-9901-6dc53e2775ad" :answer/id #uuid "9269d8f3-f3eb-5f87-9901-6dc53e2775ad" :answer/type :answer.type/math :answer/value "19+(z+7)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ce1bc6cb-574c-563d-b544-da9018d44b27" :answer/id #uuid "ce1bc6cb-574c-563d-b544-da9018d44b27" :answer/type :answer.type/math :answer/value "30-(z+7)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-87a9058b-6617-5b7b-a686-12d2470baa79" :answer/id #uuid "87a9058b-6617-5b7b-a686-12d2470baa79" :answer/type :answer.type/math :answer/value "49-(z-7)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0d1542e3-e27b-5f3b-a9cf-d176370aebd9" :answer/id #uuid "0d1542e3-e27b-5f3b-a9cf-d176370aebd9" :answer/type :answer.type/math :answer/value "68-(z-7)^{2}" :db/ensure [:answer/validate]} {:db/id "question-82dc9974-9e37-5f33-ad85-854a2a504fcc" :question/id #uuid "82dc9974-9e37-5f33-ad85-854a2a504fcc" :question/math-academy-id "q-112299" :question/problem "Rewrite $-{t}^{2}-12t-7$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({t}^{2}+12t+7)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{t}^{2}+12t+7\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{t}^{2}+2\\cdot 6t+7\n$$\n\nThen, we add and then subtract ${6}^{2},$ writing the constant term $7$ last:\n\n$$\n{{t}^{2}+2\\cdot 6t+{6}^{2}}_{⏟}-{6}^{2}+7\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(t+6)^{2}-{6}^{2}+7\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(t+6)^{2}-29\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-7-12t-{t}^{2} & =-((t+6)^{2}-29) \\\\  & =-(t+6)^{2}+29 \\\\  & =29-(t+6)^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7a6730d9-206d-5f68-9d5b-5aff820cffca"] :db/ensure [:question/validate]} {:db/id "answer-field-7a6730d9-206d-5f68-9d5b-5aff820cffca" :answer-field/id #uuid "7a6730d9-206d-5f68-9d5b-5aff820cffca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a4e38ba2-0edf-581d-af7c-10e7df27bc6f" :answer-field/choices ["answer-fa9ac659-5538-517c-8887-28133c7a46d1" "answer-a4e38ba2-0edf-581d-af7c-10e7df27bc6f" "answer-13498b09-a219-5dfa-9293-f4041b9703a6" "answer-78c75f6c-f643-59ba-801f-b5a91dc0bb7b" "answer-2c4aa913-b332-54d8-be5c-49036736de34"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa9ac659-5538-517c-8887-28133c7a46d1" :answer/id #uuid "fa9ac659-5538-517c-8887-28133c7a46d1" :answer/type :answer.type/math :answer/value "-6-(t+6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a4e38ba2-0edf-581d-af7c-10e7df27bc6f" :answer/id #uuid "a4e38ba2-0edf-581d-af7c-10e7df27bc6f" :answer/type :answer.type/math :answer/value "29-(t+6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-13498b09-a219-5dfa-9293-f4041b9703a6" :answer/id #uuid "13498b09-a219-5dfa-9293-f4041b9703a6" :answer/type :answer.type/math :answer/value "36-(t-6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-78c75f6c-f643-59ba-801f-b5a91dc0bb7b" :answer/id #uuid "78c75f6c-f643-59ba-801f-b5a91dc0bb7b" :answer/type :answer.type/math :answer/value "43-(t-6)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2c4aa913-b332-54d8-be5c-49036736de34" :answer/id #uuid "2c4aa913-b332-54d8-be5c-49036736de34" :answer/type :answer.type/math :answer/value "7-(t+6)^{2}" :db/ensure [:answer/validate]} {:db/id "question-5bc52b75-4c42-58c5-bcab-077cbe6faec2" :question/id #uuid "5bc52b75-4c42-58c5-bcab-077cbe6faec2" :question/math-academy-id "q-80579" :question/problem "Rewrite $-({x}^{2}-6x+10)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-6x+10\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 3x+10\n$$\n\nThen, we *add* and *then subtract* ${3}^{2},$ writing the constant term $10$ last:\n\n$$\n{{x}^{2}-2\\cdot 3x+{3}^{2}}_{⏟}-{3}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-3)^{2}-{3}^{2}+10\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x-3)^{2}+1.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}-6x+10) & =-({(x-3)}^{2}+1) \\\\  & =-(x-3)^{2}-1 \\\\  & =-1-(x-3)^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-753b685b-ee64-5d8e-94ea-d970946416c7"] :db/ensure [:question/validate]} {:db/id "answer-field-753b685b-ee64-5d8e-94ea-d970946416c7" :answer-field/id #uuid "753b685b-ee64-5d8e-94ea-d970946416c7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0bf694ca-14ea-5e03-ae5b-c2c3fdf7de10" :answer-field/choices ["answer-0bf694ca-14ea-5e03-ae5b-c2c3fdf7de10" "answer-76d55117-ac24-5597-977e-26f389735915" "answer-2367ac0c-5a4d-592e-a6c4-bb3ab96af7c3" "answer-5aa52ca5-7f84-5524-9e35-b67f97468bc0" "answer-a7cd2e45-2799-51f7-8b68-c7756837046d"] :db/ensure [:answer-field/validate]} {:db/id "answer-0bf694ca-14ea-5e03-ae5b-c2c3fdf7de10" :answer/id #uuid "0bf694ca-14ea-5e03-ae5b-c2c3fdf7de10" :answer/type :answer.type/math :answer/value "-1-(x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-76d55117-ac24-5597-977e-26f389735915" :answer/id #uuid "76d55117-ac24-5597-977e-26f389735915" :answer/type :answer.type/math :answer/value "-3-(x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2367ac0c-5a4d-592e-a6c4-bb3ab96af7c3" :answer/id #uuid "2367ac0c-5a4d-592e-a6c4-bb3ab96af7c3" :answer/type :answer.type/math :answer/value "1-(x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5aa52ca5-7f84-5524-9e35-b67f97468bc0" :answer/id #uuid "5aa52ca5-7f84-5524-9e35-b67f97468bc0" :answer/type :answer.type/math :answer/value "2-(x+3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a7cd2e45-2799-51f7-8b68-c7756837046d" :answer/id #uuid "a7cd2e45-2799-51f7-8b68-c7756837046d" :answer/type :answer.type/math :answer/value "3-(x+3)^{2}" :db/ensure [:answer/validate]} {:db/id "question-aef8db66-e528-55a5-877b-5de5c3121fc3" :question/id #uuid "aef8db66-e528-55a5-877b-5de5c3121fc3" :question/math-academy-id "q-140270" :question/problem "Rewrite $-({x}^{2}-3x+1)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-3x+1\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{3}{2}x+1\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{3}{2})}^{2},$ writing the constant term $1$ last:\n\n$$\n{{x}^{2}-2\\cdot \\frac{3}{2}x+{(\\frac{3}{2})}^{2}}_{⏟}-{(\\frac{3}{2})}^{2}+1\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{3}{2})}^{2}-{(\\frac{3}{2})}^{2}+1\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x-\\frac{3}{2})}^{2}-\\frac{5}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}-3x+1) & =-({(x-\\frac{3}{2})}^{2}-\\frac{5}{4}) \\\\  & =-{(x-\\frac{3}{2})}^{2}+\\frac{5}{4} \\\\  & =\\frac{5}{4}-{(x-\\frac{3}{2})}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-23e91312-58c2-59dc-9a23-0a2685890965"] :db/ensure [:question/validate]} {:db/id "answer-field-23e91312-58c2-59dc-9a23-0a2685890965" :answer-field/id #uuid "23e91312-58c2-59dc-9a23-0a2685890965" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2bc4dbf-a3c1-5c4a-bb30-637dbdcc4445" :answer-field/choices ["answer-ff089ad5-5112-577e-a4ad-ebbdd0861706" "answer-85efc12e-6686-5c83-a584-51d24265e514" "answer-ce7d23ab-bc7a-5e58-9183-a23a3316f17d" "answer-a2bc4dbf-a3c1-5c4a-bb30-637dbdcc4445" "answer-87c47d54-c33c-5791-b51c-9f273e7288ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff089ad5-5112-577e-a4ad-ebbdd0861706" :answer/i