 =-3 \\\\ 3x & =-3 \\\\ \\frac{3x}{3} & =\\frac{-3}{3} \\\\ x & =-1\\end{aligned}\n$$\n\nHence, the $x$-intercept is $x=-1.$ Thus, the line intersects the $x$-axis at $(-1,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0b754c20-8244-5f7e-85fa-5fa2f702047f" "answer-field-fdb9476a-3489-50b6-afd6-e25393d80f1c"] :db/ensure [:question/validate]} {:db/id "answer-field-0b754c20-8244-5f7e-85fa-5fa2f702047f" :answer-field/id #uuid "0b754c20-8244-5f7e-85fa-5fa2f702047f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1410a63b-361e-5496-8200-ae1b63d78725" :answer-field/choices ["answer-1410a63b-361e-5496-8200-ae1b63d78725"] :db/ensure [:answer-field/validate]} {:db/id "answer-1410a63b-361e-5496-8200-ae1b63d78725" :answer/id #uuid "1410a63b-361e-5496-8200-ae1b63d78725" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-fdb9476a-3489-50b6-afd6-e25393d80f1c" :answer-field/id #uuid "fdb9476a-3489-50b6-afd6-e25393d80f1c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2b2e9113-16cb-54f9-a0f9-6f2c2ff2e685" :answer-field/choices ["answer-2b2e9113-16cb-54f9-a0f9-6f2c2ff2e685"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b2e9113-16cb-54f9-a0f9-6f2c2ff2e685" :answer/id #uuid "2b2e9113-16cb-54f9-a0f9-6f2c2ff2e685" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-6b2df9ca-452f-5057-9208-dd46b2f5dde7" :question/id #uuid "6b2df9ca-452f-5057-9208-dd46b2f5dde7" :question/math-academy-id "q-214680" :question/problem "The line $3x+8y=18$ intersects the $x$-axis at the point$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x.$\n\n$$\n\\begin{aligned}3x+8y & =18 \\\\ 3x+8(0) & =18 \\\\ 3x & =18 \\\\ \\frac{3x}{3} & =\\frac{18}{3} \\\\ x & =6\\end{aligned}\n$$\n\nHence, the $x$-intercept is $x=6.$ Thus, the line intersects the $x$-axis at $(6,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e8d10e0c-d421-5338-ba21-3ed7cc3cab2e" "answer-field-98bcbd00-1360-593b-a8b5-f75353517d5a"] :db/ensure [:question/validate]} {:db/id "answer-field-e8d10e0c-d421-5338-ba21-3ed7cc3cab2e" :answer-field/id #uuid "e8d10e0c-d421-5338-ba21-3ed7cc3cab2e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-05bd01db-fd0a-5b1a-b2b5-961f20d3d27b" :answer-field/choices ["answer-05bd01db-fd0a-5b1a-b2b5-961f20d3d27b"] :db/ensure [:answer-field/validate]} {:db/id "answer-05bd01db-fd0a-5b1a-b2b5-961f20d3d27b" :answer/id #uuid "05bd01db-fd0a-5b1a-b2b5-961f20d3d27b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-field-98bcbd00-1360-593b-a8b5-f75353517d5a" :answer-field/id #uuid "98bcbd00-1360-593b-a8b5-f75353517d5a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-75634763-e2c8-5ac5-b195-ac5c70809502" :answer-field/choices ["answer-75634763-e2c8-5ac5-b195-ac5c70809502"] :db/ensure [:answer-field/validate]} {:db/id "answer-75634763-e2c8-5ac5-b195-ac5c70809502" :answer/id #uuid "75634763-e2c8-5ac5-b195-ac5c70809502" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-00f5442f-d34a-5776-aee4-863c683c730e" :question/id #uuid "00f5442f-d34a-5776-aee4-863c683c730e" :question/math-academy-id "q-128989" :question/problem "Find the point where the line $9x-3y=7$ intersects the $y$-axis." :question/worked-solution "To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y.$\n\n$$\n\\begin{aligned}9x-3y & =7 \\\\ 9(0)-3y & =7 \\\\ -3y & =7 \\\\ y & =-\\frac{7}{3}\\end{aligned}\n$$\n\nHence, the $y$-intercept is $-\\frac{7}{3}.$ Thus, the line intersects the $y$-axis at $(0,-\\frac{7}{3}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c5e80aea-a97f-5693-b2a9-02c0460549ec"] :db/ensure [:question/validate]} {:db/id "answer-field-c5e80aea-a97f-5693-b2a9-02c0460549ec" :answer-field/id #uuid "c5e80aea-a97f-5693-b2a9-02c0460549ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9f130d8-83da-5f6d-9f15-b95316a902c0" :answer-field/choices ["answer-b7b2eeb0-d692-5c4c-acff-c1fcbffa65ae" "answer-f9f130d8-83da-5f6d-9f15-b95316a902c0" "answer-461e9d47-6016-588f-95e0-59a62b3e303e" "answer-5cbe7e37-8cc3-50a4-8860-b2c42a251536" "answer-2d8f3d82-0498-5a55-931d-cbac55bac592"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7b2eeb0-d692-5c4c-acff-c1fcbffa65ae" :answer/id #uuid "b7b2eeb0-d692-5c4c-acff-c1fcbffa65ae" :answer/type :answer.type/math :answer/value "(0,-3)" :db/ensure [:answer/validate]} {:db/id "answer-f9f130d8-83da-5f6d-9f15-b95316a902c0" :answer/id #uuid "f9f130d8-83da-5f6d-9f15-b95316a902c0" :answer/type :answer.type/math :answer/value "(0,-\\frac{7}{3})" :db/ensure [:answer/validate]} {:db/id "answer-461e9d47-6016-588f-95e0-59a62b3e303e" :answer/id #uuid "461e9d47-6016-588f-95e0-59a62b3e303e" :answer/type :answer.type/math :answer/value "(0,-\\frac{7}{9})" :db/ensure [:answer/validate]} {:db/id "answer-5cbe7e37-8cc3-50a4-8860-b2c42a251536" :answer/id #uuid "5cbe7e37-8cc3-50a4-8860-b2c42a251536" :answer/type :answer.type/math :answer/value "(0,\\frac{3}{7})" :db/ensure [:answer/validate]} {:db/id "answer-2d8f3d82-0498-5a55-931d-cbac55bac592" :answer/id #uuid "2d8f3d82-0498-5a55-931d-cbac55bac592" :answer/type :answer.type/math :answer/value "(0,\\frac{9}{7})" :db/ensure [:answer/validate]} {:db/id "question-eaf53385-8d80-57b1-9850-e91d1aa3e647" :question/id #uuid "eaf53385-8d80-57b1-9850-e91d1aa3e647" :question/math-academy-id "q-128991" :question/problem "Calculate the $y$-intercept of the line $4x-6y=-15.$" :question/worked-solution "To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y.$\n\n$$\n\\begin{aligned}4x-6y & =-15 \\\\ 4(0)-6y & =-15 \\\\ -6y & =-15 \\\\ y & =\\frac{15}{6} \\\\ y & =\\frac{5}{2}\\end{aligned}\n$$\n\nHence, the $y$-intercept is $\\frac{5}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-015c4ca6-3b35-52ec-bce8-fd61cb0339e6"] :db/ensure [:question/validate]} {:db/id "answer-field-015c4ca6-3b35-52ec-bce8-fd61cb0339e6" :answer-field/id #uuid "015c4ca6-3b35-52ec-bce8-fd61cb0339e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba165341-da74-5561-af9d-7787d99f82fd" :answer-field/choices ["answer-a4d30050-abdc-538c-9e28-52b6bd93941b" "answer-4d63675b-7f0b-5818-b0a6-4be7efaaa096" "answer-db723571-bfa7-590d-a574-2a596079413b" "answer-022a16c4-7592-5524-b0e3-a730902b9758" "answer-ba165341-da74-5561-af9d-7787d99f82fd"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4d30050-abdc-538c-9e28-52b6bd93941b" :answer/id #uuid "a4d30050-abdc-538c-9e28-52b6bd93941b" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-4d63675b-7f0b-5818-b0a6-4be7efaaa096" :answer/id #uuid "4d63675b-7f0b-5818-b0a6-4be7efaaa096" :answer/type :answer.type/math :answer/value "-\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-db723571-bfa7-590d-a574-2a596079413b" :answer/id #uuid "db723571-bfa7-590d-a574-2a596079413b" :answer/type :answer.type/math :answer/value "\\frac{15}{4}" :db/ensure [:answer/validate]} {:db/id "answer-022a16c4-7592-5524-b0e3-a730902b9758" :answer/id #uuid "022a16c4-7592-5524-b0e3-a730902b9758" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-ba165341-da74-5561-af9d-7787d99f82fd" :answer/id #uuid "ba165341-da74-5561-af9d-7787d99f82fd" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id 17592186180783 :tutorial/content "To determine the slope of a line that is given in standard form, we need to convert the equation to slope-intercept form.\n\nTo demonstrate, let's calculate the slope of the following line:\n\n$$\n2x + y = 8\n$$\n\nTo write this equation in slope-intercept form, we solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}2x+y & =8 \\\\ 2x+y-2x & =8-2x \\\\ y & =8-2x \\\\ y & =-2x+8\\end{aligned}\n$$\n\nFrom the slope-intercept equation, we can tell that the slope of the line is $m=-2.$" :db/ensure [:tutorial/validate]} {:db/id 17592186180784 :tutorial/content "Suppose we want to find the $x$- and $y$-intercepts of the following line:\n\n$$\n2x + y = 8\n$$\n\nLet's find each of them in turn.\n\n- To find the $x$-intercept, we substitute $y=0$ into the equation and solve for $x{:}$\n\n$$\n\\begin{aligned}2x+(0) & =8 \\\\ 2x & =8 \\\\ \\frac{2x}{2} & =\\frac{8}{2} \\\\ x & =4\\end{aligned}\n$$\n\nTherefore, the line intersects the $x$-axis at the point $(4,0).$\n\n- To find the $y$-intercept, we substitute $x=0$ into the equation and solve for $y{:}$\n\n$$\n\\begin{aligned}2(0)+y & =8 \\\\ y & =8\\end{aligned}\n$$\n\nTherefore, the line intersects the $y$-axis at the point $(0,8).$" :db/ensure [:tutorial/validate]} {:db/id 17592186179876 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124460 :knowledge-point/questions ["question-a3fef551-e9bd-56f6-a5fb-6131de39b9cb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124459 :knowledge-point/questions ["question-d2926681-2f02-501e-9c4c-db877ffeff07" "question-1c3c8fd2-c84f-5ffa-82e1-4f53ac4509f6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d2926681-2f02-501e-9c4c-db877ffeff07" :question/id #uuid "d2926681-2f02-501e-9c4c-db877ffeff07" :question/math-academy-id "q-83562" :question/problem "In what direction does the function $f(x,y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y+{x}^{2}y$ decrease most rapidly at the point $(\\pi ,0)?$" :question/worked-solution "At a given point, a function $f(x,y)$ decreases most rapidly in the direction opposite to that of its gradient.\n\nSo, we compute $-∇f(x,y)$ and evaluate it at the point $(\\pi ,0):$\n\n$$\n\\begin{aligned}-∇f(x,y) & =-\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y+{x}^{2}y)\\text{ }i-\\frac{∂}{∂y}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y+{x}^{2}y)\\text{ }j \\\\  & =-(\\operatorname{cos}⁡x\\operatorname{cos}⁡y+2xy)\\text{ }i-(-\\operatorname{sin}⁡x\\operatorname{sin}⁡y+{x}^{2})\\text{ }j \\\\ -∇f(\\pi ,0) & =-(\\operatorname{cos}⁡\\pi \\operatorname{cos}⁡0+2\\cdot \\pi \\cdot 0)\\text{ }i+(-\\operatorname{sin}⁡\\pi \\operatorname{sin}⁡0+{\\pi }^{2})\\text{ }j \\\\  & =i-{\\pi }^{2}\\,j\\end{aligned}\n$$\n\nTherefore, the function decreases most rapidly in the direction of $i-{\\pi }^{2}\\,j.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-941d1058-20a9-5c97-a5b7-7c5da913add0"] :db/ensure [:question/validate]} {:db/id "answer-field-941d1058-20a9-5c97-a5b7-7c5da913add0" :answer-field/id #uuid "941d1058-20a9-5c97-a5b7-7c5da913add0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b20c5f55-306b-5cef-9a67-804b11be245c" :answer-field/choices ["answer-f8c25011-b246-57b2-afb4-9949bd083e31" "answer-a91d4692-51f1-5ef6-96a3-68a85bcad337" "answer-b20c5f55-306b-5cef-9a67-804b11be245c" "answer-08fb6012-956b-5c39-8935-74645f89ee82" "answer-9f0516fc-fa33-5a32-bc85-021583caaccd"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8c25011-b246-57b2-afb4-9949bd083e31" :answer/id #uuid "f8c25011-b246-57b2-afb4-9949bd083e31" :answer/type :answer.type/math :answer/value "\\pi \\,i+\\pi \\,j" :db/ensure [:answer/validate]} {:db/id "answer-a91d4692-51f1-5ef6-96a3-68a85bcad337" :answer/id #uuid "a91d4692-51f1-5ef6-96a3-68a85bcad337" :answer/type :answer.type/math :answer/value "i-\\pi \\,j" :db/ensure [:answer/validate]} {:db/id "answer-b20c5f55-306b-5cef-9a67-804b11be245c" :answer/id #uuid "b20c5f55-306b-5cef-9a67-804b11be245c" :answer/type :answer.type/math :answer/value "i-{\\pi }^{2}\\,j" :db/ensure [:answer/validate]} {:db/id "answer-08fb6012-956b-5c39-8935-74645f89ee82" :answer/id #uuid "08fb6012-956b-5c39-8935-74645f89ee82" :answer/type :answer.type/math :answer/value "{\\pi }^{2}\\,i+2\\pi \\,j" :db/ensure [:answer/validate]} {:db/id "answer-9f0516fc-fa33-5a32-bc85-021583caaccd" :answer/id #uuid "9f0516fc-fa33-5a32-bc85-021583caaccd" :answer/type :answer.type/math :answer/value "{\\pi }^{2}\\,i-j" :db/ensure [:answer/validate]} {:db/id "question-a3fef551-e9bd-56f6-a5fb-6131de39b9cb" :question/id #uuid "a3fef551-e9bd-56f6-a5fb-6131de39b9cb" :question/math-academy-id "q-86542" :question/problem "Consider the function $g(x,y)=\\frac{{e}^{y}}{yx}.$ What is the rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of the vector $v=⟨2,4⟩?$" :question/worked-solution "The rate of change of $g(x,y)$ at the point $(1,1)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(1,1).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{2}^{2}+{4}^{2}}=\\sqrt{20}=2\\sqrt{5} \\\\ u & =\\frac{1}{2\\sqrt{5}}⟨2,4⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨1,2⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇g(x,y)$ and evaluate it at the point $(1,1):$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}(\\frac{{e}^{y}}{yx}),\\,\\frac{∂}{∂y}(\\frac{{e}^{y}}{yx})⟩ \\\\  & =⟨-\\frac{{e}^{y}}{{x}^{2}y},\\,\\frac{{e}^{y}(y-1)}{x{y}^{2}}⟩ \\\\ ∇g(1,1) & =⟨-\\frac{{e}^{1}}{{1}^{2}\\cdot 1},\\,\\frac{{e}^{1}\\cdot (1-1)}{1\\cdot {1}^{2}}⟩ \\\\  & =⟨-e,0⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(1,1)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(1,1) & =∇g(1,1)\\cdot u \\\\  & =⟨-e,0⟩\\cdot \\frac{1}{\\sqrt{5}}⟨1,2⟩ \\\\  & =\\frac{1}{\\sqrt{5}}(-e\\cdot 1+0\\cdot 2) \\\\  & =-\\frac{e}{\\sqrt{5}} \\\\  & =-\\frac{e\\sqrt{5}}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fcae1503-ee5b-5bcc-859b-64edce5a1f65"] :db/ensure [:question/validate]} {:db/id "answer-field-fcae1503-ee5b-5bcc-859b-64edce5a1f65" :answer-field/id #uuid "fcae1503-ee5b-5bcc-859b-64edce5a1f65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5490207d-8efb-5f97-80cd-1bd0f27685fd" :answer-field/choices ["answer-407711da-42ac-56dc-a3f6-af974631b602" "answer-8d4c7ab4-1278-5730-804a-3c97ca86d365" "answer-5490207d-8efb-5f97-80cd-1bd0f27685fd" "answer-86e21ca8-366b-5985-a073-18a5cd00683d" "answer-13f0ad0a-171c-5322-8cf2-cfca08972fdb"] :db/ensure [:answer-field/validate]} {:db/id "answer-407711da-42ac-56dc-a3f6-af974631b602" :answer/id #uuid "407711da-42ac-56dc-a3f6-af974631b602" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8d4c7ab4-1278-5730-804a-3c97ca86d365" :answer/id #uuid "8d4c7ab4-1278-5730-804a-3c97ca86d365" :answer/type :answer.type/math :answer/value "-\\frac{e\\sqrt{5}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5490207d-8efb-5f97-80cd-1bd0f27685fd" :answer/id #uuid "5490207d-8efb-5f97-80cd-1bd0f27685fd" :answer/type :answer.type/math :answer/value "-\\frac{e\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-86e21ca8-366b-5985-a073-18a5cd00683d" :answer/id #uuid "86e21ca8-366b-5985-a073-18a5cd00683d" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-13f0ad0a-171c-5322-8cf2-cfca08972fdb" :answer/id #uuid "13f0ad0a-171c-5322-8cf2-cfca08972fdb" :answer/type :answer.type/math :answer/value "\\frac{e\\sqrt{5}}{3}" :db/ensure [:answer/validate]} {:db/id "question-1c3c8fd2-c84f-5ffa-82e1-4f53ac4509f6" :question/id #uuid "1c3c8fd2-c84f-5ffa-82e1-4f53ac4509f6" :question/math-academy-id "q-130277" :question/problem "In what direction does the function $f(x,y)=2(xy+1)^{3/2}$ increase most rapidly at the point $(3,1)?$" :question/worked-solution "At a given point, a function $f(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇f(x,y)$ and evaluate it at the point $(3,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(2(xy+1)^{3/2})\\,i+\\frac{∂}{∂y}(2(xy+1)^{3/2})\\,j \\\\  & =3y\\sqrt{xy+1}\\,i+3x\\sqrt{xy+1}\\,j \\\\ ∇f(3,1) & =3(1)\\sqrt{(3)(1)+1}\\,i+3(3)\\sqrt{(3)(1)+1}\\,j \\\\  & =6\\,i+18\\,j\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $6\\,i+18\\,j.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-35227601-10b3-594c-aac4-a002a6f61ca3"] :db/ensure [:question/validate]} {:db/id "answer-field-35227601-10b3-594c-aac4-a002a6f61ca3" :answer-field/id #uuid "35227601-10b3-594c-aac4-a002a6f61ca3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e5dcfde-da03-5e9b-8257-b3a15610fd0f" :answer-field/choices ["answer-9305e79c-d3f6-5049-b273-0bc89befd2f4" "answer-9b2acabe-a8aa-5bd5-a28c-992a7b2ef314" "answer-6e5dcfde-da03-5e9b-8257-b3a15610fd0f" "answer-172f3f98-43e9-586f-8bdf-a9ddf4ae061e" "answer-e95111ed-e4a8-5a81-b040-27eaaa405bc3"] :db/ensure [:answer-field/validate]} {:db/id "answer-9305e79c-d3f6-5049-b273-0bc89befd2f4" :answer/id #uuid "9305e79c-d3f6-5049-b273-0bc89befd2f4" :answer/type :answer.type/math :answer/value "-3\\,i+4\\,j" :db/ensure [:answer/validate]} {:db/id "answer-9b2acabe-a8aa-5bd5-a28c-992a7b2ef314" :answer/id #uuid "9b2acabe-a8aa-5bd5-a28c-992a7b2ef314" :answer/type :answer.type/math :answer/value "-5\\,i+3\\,j" :db/ensure [:answer/validate]} {:db/id "answer-6e5dcfde-da03-5e9b-8257-b3a15610fd0f" :answer/id #uuid "6e5dcfde-da03-5e9b-8257-b3a15610fd0f" :answer/type :answer.type/math :answer/value "6\\,i+18\\,j" :db/ensure [:answer/validate]} {:db/id "answer-172f3f98-43e9-586f-8bdf-a9ddf4ae061e" :answer/id #uuid "172f3f98-43e9-586f-8bdf-a9ddf4ae061e" :answer/type :answer.type/math :answer/value "8\\,i-12\\,j" :db/ensure [:answer/validate]} {:db/id "answer-e95111ed-e4a8-5a81-b040-27eaaa405bc3" :answer/id #uuid "e95111ed-e4a8-5a81-b040-27eaaa405bc3" :answer/type :answer.type/math :answer/value "i+9\\,j" :db/ensure [:answer/validate]} {:db/id "activity-0a41176c-b39d-554a-935e-72997f04c98e" :activity/id #uuid "0a41176c-b39d-554a-935e-72997f04c98e" :activity/title "Directional Derivatives" :activity/type :activity.type/review :activity/scope 17592186050555 :activity/course 17592186046659 :activity/steps ["step-7cf532da-0f94-51c8-af70-3482c03bc391" "step-d394d923-4ab3-59e3-94fd-7981e3aa060d" "step-0a60e94a-7f5d-54b3-9400-bd9ba416bdb2" "step-892b58dc-320d-53ce-b8f0-06a4365c54d1"] :activity/first-step "step-7cf532da-0f94-51c8-af70-3482c03bc391" :db/ensure [:activity/validate]} {:db/id "step-7cf532da-0f94-51c8-af70-3482c03bc391" :step/id #uuid "7cf532da-0f94-51c8-af70-3482c03bc391" :step/content 17592186323875 :step/next "step-d394d923-4ab3-59e3-94fd-7981e3aa060d" :db/ensure [:step/validate]} {:db/id "step-d394d923-4ab3-59e3-94fd-7981e3aa060d" :step/id #uuid "d394d923-4ab3-59e3-94fd-7981e3aa060d" :step/content "question-d2926681-2f02-501e-9c4c-db877ffeff07" :step/next "step-0a60e94a-7f5d-54b3-9400-bd9ba416bdb2" :db/ensure [:step/validate]} {:db/id "step-0a60e94a-7f5d-54b3-9400-bd9ba416bdb2" :step/id #uuid "0a60e94a-7f5d-54b3-9400-bd9ba416bdb2" :step/content "question-a3fef551-e9bd-56f6-a5fb-6131de39b9cb" :step/next "step-892b58dc-320d-53ce-b8f0-06a4365c54d1" :db/ensure [:step/validate]} {:db/id "step-892b58dc-320d-53ce-b8f0-06a4365c54d1" :step/id #uuid "892b58dc-320d-53ce-b8f0-06a4365c54d1" :step/content "question-1c3c8fd2-c84f-5ffa-82e1-4f53ac4509f6" :db/ensure [:step/validate]} {:db/id 17592186342239 :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}],\\,b=[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}5 \\\\ 1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ -1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}-3 \\\\ -3 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}5{x}_{1}+{x}_{2}=-3 \\\\ {x}_{1}-{x}_{2}=-3 \\\\ 2{x}_{1}-{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}5 & 1 & -3 \\\\ 1 & -1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 5 & 1 & -3 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{2} & :={R}_{2}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 2 & -1 & k\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 6 & 12 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{2} & :=\\frac{1}{6}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 1 & k+6\\end{aligned}] & {R}_{3} & :={R}_{3}-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & k+4\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+4.$ Therefore, the system has a solution only if\n\n$$\n0=k+4\\,⇒\\,k=-4.\n$$" :db/ensure [:question/validate]} {:db/id 17592186157310 :knowledge-point/questions ["question-7f6be4fe-78ba-5d67-91ec-fd3e20928e4b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7f6be4fe-78ba-5d67-91ec-fd3e20928e4b" :question/id #uuid "7f6be4fe-78ba-5d67-91ec-fd3e20928e4b" :question/math-academy-id "q-131278" :question/problem "A supplier of clothing materials looks for flaws before selling the material to customers. On average, there have been $1.7$ flaws per meter. What is the probability of finding fewer than $4$  flaws in the next meter length of the material? Round your answer to $3$ decimal places. You may assume that flaws appear independently and at a constant average rate." :question/worked-solution "A Poisson random variable $X$ with rate $\\lambda $ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nLet $X$ be the number of flaws in a meter length of the material. Since the average rate is $1.7$ flaws per meter, and events occur independently and at a constant average rate, the number of flaws can be modeled as a Poisson random variable with rate $\\lambda =1.7,$ and we can write $X∼\\text{Po}(1.7).$\n\nSo, $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{1.7}^{x}{e}^{-1.7}}{x!}\n$$\n\nTherefore, the probability of finding fewer than $4$  flaws in the next meter length of the material is\n\n$$\n\\begin{aligned}P(X<4) & =P(X\\in \\{0,1,2,3\\}) \\\\  & =f(0)+f(1)+f(2)+f(3) \\\\  & =\\frac{{1.7}^{0}{e}^{-1.7}}{0!}+\\frac{{1.7}^{1}{e}^{-1.7}}{1!}+\\frac{{1.7}^{2}{e}^{-1.7}}{2!}+\\frac{{1.7}^{3}{e}^{-1.7}}{3!} \\\\  & ≈0.907\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7c8ed450-14d6-56b8-9f85-42f0c5090225"] :db/ensure [:question/validate]} {:db/id "answer-field-7c8ed450-14d6-56b8-9f85-42f0c5090225" :answer-field/id #uuid "7c8ed450-14d6-56b8-9f85-42f0c5090225" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c5d2f48f-f0a8-5a20-bf7d-5b6b11786401" :answer-field/choices ["answer-d6451578-ea42-5bae-aefd-02f4a378e3ca" "answer-9223e8c1-ab98-539b-8995-df357364984e" "answer-c5d2f48f-f0a8-5a20-bf7d-5b6b11786401" "answer-5eacfc39-44f1-50b6-9661-06b34f1cc555" "answer-e91a7731-a4f2-5c1c-ab3c-3264404a0e02"] :db/ensure [:answer-field/validate]} {:db/id "answer-d6451578-ea42-5bae-aefd-02f4a378e3ca" :answer/id #uuid "d6451578-ea42-5bae-aefd-02f4a378e3ca" :answer/type :answer.type/math :answer/value "0.677" :db/ensure [:answer/validate]} {:db/id "answer-9223e8c1-ab98-539b-8995-df357364984e" :answer/id #uuid "9223e8c1-ab98-539b-8995-df357364984e" :answer/type :answer.type/math :answer/value "0.887" :db/ensure [:answer/validate]} {:db/id "answer-c5d2f48f-f0a8-5a20-bf7d-5b6b11786401" :answer/id #uuid "c5d2f48f-f0a8-5a20-bf7d-5b6b11786401" :answer/type :answer.type/math :answer/value "0.907" :db/ensure [:answer/validate]} {:db/id "answer-5eacfc39-44f1-50b6-9661-06b34f1cc555" :answer/id #uuid "5eacfc39-44f1-50b6-9661-06b34f1cc555" :answer/type :answer.type/math :answer/value "0.922" :db/ensure [:answer/validate]} {:db/id "answer-e91a7731-a4f2-5c1c-ab3c-3264404a0e02" :answer/id #uuid "e91a7731-a4f2-5c1c-ab3c-3264404a0e02" :answer/type :answer.type/math :answer/value "0.932" :db/ensure [:answer/validate]} [:db/retract 17592186178515 :answer-field/choices 17592186178517] [:db/retract 17592186178515 :answer-field/choices 17592186178519] {:db/id 17592186179762 :knowledge-point/questions ["question-6ef216dc-f6cf-5481-bcc8-f1b9abb1bf84"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179462 :question/problem "Simplify $\\sqrt{\\dfrac{r^2}{s^2}}$ given that $s>0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value:\n\n$$\n\\sqrt{x^2} = |x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\eqalign{\n\\sqrt{\\dfrac{r^2}{s^2}} &= \\[5pt]\n\n\\sqrt{\\dfrac{r}{s} \\cdot \\dfrac{r}{s}} &= \\[5pt]\n\n\\sqrt{\\left(\\dfrac{r}{s}\\right)^2} &= \\[5pt]\n\n\\left|\\dfrac{r}{s}\\right| &= \\[5pt]\n\n\\dfrac{|r|}{|s|} & \n\t}\n$$\n\n \n\nWe are told that $s \\gt 0,$ and we know that the absolute value of any positive number is just itself, so we have $|s| = s.$ Therefore, our final answer is\n\n$$\n\\dfrac{|r|}{|s|} = \\dfrac{|r|}{s} .\n$$" :db/ensure [:question/validate]} {:db/id 17592186179761 :knowledge-point/questions ["question-d271c02f-63d9-52da-abf5-d399868f3744" "question-e44f5e7f-50c8-5f61-b0b8-699aaec6f842"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179461 :question/problem "Simplify $\\sqrt{y^4 z^{6}}$ given that $z \\lt 0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{x^2} = |x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\eqalign{\n\t\t\\sqrt{y^4 z^{6}} & = \\[5pt]\n\t\t\\sqrt{y^2 z^3 \\cdot y^2 z^3} &= \\[5pt]\n\t\t\\sqrt{\\left(y^2 z^3\\right)^2}&=\\[5pt]\n\t\t|y^2 z^3| & = \\[5pt]\n|y^2| \\cdot |z^3| & = \\[5pt]\n|y^2| \\cdot |z|^3\n\t}\n$$\n\nA squared number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have $|y^2| = y^2.$\n\nOn the other hand, we are told that $z \\lt 0,$ and to take the absolute value of any negative number we need to flip the sign, so we have $|z| = -z.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}|{y}^{2}|\\cdot |z{|}^{3}={y}^{2}\\cdot (-z)^{3}=-{y}^{2}{z}^{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186180161 :question/problem "Find $\\sqrt{{a}^{2}}$ given that $a>0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & = \\\\ \\sqrt{(a)^{2}} & = \\\\ |a| & \\end{aligned}\n$$\n\nWe are told that $a>0,$ and we know that the absolute value of any positive number is just itself, so we have $|a|=a.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}|a|=a.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186178515 :answer-field/correct 17592186178516 :answer-field/choices ["answer-b31894e7-afeb-578b-a355-395a21451c71" "answer-fadb7efd-f41c-5bbf-86ff-9b2b6e0d2516"] :db/ensure [:answer-field/validate]} {:db/id "answer-b31894e7-afeb-578b-a355-395a21451c71" :answer/id #uuid "b31894e7-afeb-578b-a355-395a21451c71" :answer/type :answer.type/math :answer/value "{a}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-fadb7efd-f41c-5bbf-86ff-9b2b6e0d2516" :answer/id #uuid "fadb7efd-f41c-5bbf-86ff-9b2b6e0d2516" :answer/type :answer.type/math :answer/value "{a}^{3}" :db/ensure [:answer/validate]} {:db/id "question-6ef216dc-f6cf-5481-bcc8-f1b9abb1bf84" :question/id #uuid "6ef216dc-f6cf-5481-bcc8-f1b9abb1bf84" :question/math-academy-id "q-2913" :question/problem "Simplify $\\sqrt{{t}^{8}{y}^{6}}$ given that $y>0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{{t}^{8}{y}^{6}} & = \\\\ \\sqrt{{t}^{4}{y}^{3}\\cdot {t}^{4}{y}^{3}} & = \\\\ \\sqrt{{({t}^{4}{y}^{3})}^{2}} & = \\\\ |{t}^{4}{y}^{3}| & = \\\\ |{t}^{4}|\\cdot |{y}^{3}| & = \\\\ |{t}^{4}|\\cdot |y{|}^{3} & \\end{aligned}\n$$\n\nAn even power of a number is always positive or zero, and the absolute value of any positive (or zero) number is itself, so we have $|{t}^{4}|={t}^{4}.$ \n\nOn the other hand, we are told that $y>0,$ and we know that the absolute value of any positive number is just itself, so we have $|y|=y.$ Therefore, our final answer is\n\n$$\n\\begin{aligned}|{t}^{4}|\\cdot |y{|}^{3}={t}^{4}\\cdot {y}^{3}={t}^{4}{y}^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a4993c43-1633-58f3-990c-54e890b3dad0"] :db/ensure [:question/validate]} {:db/id "answer-field-a4993c43-1633-58f3-990c-54e890b3dad0" :answer-field/id #uuid "a4993c43-1633-58f3-990c-54e890b3dad0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b341937b-e966-5703-8327-863c0e18b4d6" :answer-field/choices ["answer-1591c3c8-6452-5e01-9abd-248681176903" "answer-50955ec0-816e-58a7-a9d7-c62e54da9246" "answer-14751749-11a7-54dd-a588-054ae0830a81" "answer-b341937b-e966-5703-8327-863c0e18b4d6" "answer-927ababd-3fe9-5c8c-9f72-29c5ebc246de"] :db/ensure [:answer-field/validate]} {:db/id "answer-1591c3c8-6452-5e01-9abd-248681176903" :answer/id #uuid "1591c3c8-6452-5e01-9abd-248681176903" :answer/type :answer.type/math :answer/value "t{y}^{7}" :db/ensure [:answer/validate]} {:db/id "answer-50955ec0-816e-58a7-a9d7-c62e54da9246" :answer/id #uuid "50955ec0-816e-58a7-a9d7-c62e54da9246" :answer/type :answer.type/math :answer/value "{t}^{2}{y}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-14751749-11a7-54dd-a588-054ae0830a81" :answer/id #uuid "14751749-11a7-54dd-a588-054ae0830a81" :answer/type :answer.type/math :answer/value "{t}^{3}{y}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-b341937b-e966-5703-8327-863c0e18b4d6" :answer/id #uuid "b341937b-e966-5703-8327-863c0e18b4d6" :answer/type :answer.type/math :answer/value "{t}^{4}{y}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-927ababd-3fe9-5c8c-9f72-29c5ebc246de" :answer/id #uuid "927ababd-3fe9-5c8c-9f72-29c5ebc246de" :answer/type :answer.type/math :answer/value "{t}^{6}{y}^{4}" :db/ensure [:answer/validate]} {:db/id "question-d271c02f-63d9-52da-abf5-d399868f3744" :question/id #uuid "d271c02f-63d9-52da-abf5-d399868f3744" :question/math-academy-id "q-110919" :question/problem "Simplify $\\sqrt{4{f}^{2}{g}^{2}{h}^{2}}$ given that $f<0,$ $g<0$ and $h>0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{4{f}^{2}{g}^{2}{h}^{2}} & = \\\\ \\sqrt{{(2fgh)}^{2}} & = \\\\ |2fgh| & = \\\\ |2|\\cdot |fgh| & = \\\\ 2\\cdot |fgh| & \\end{aligned}\n$$\n\nWe are told that $f<0,$ $g<0$ and $h>0.$ We know that the absolute value of any positive number is just itself, and to take the absolute value of any negative number we need to flip the sign. Therefore, our final answer is\n\n$$\n\\begin{aligned}2\\cdot |fgh| & = \\\\ 2\\cdot |f|\\cdot |g|\\cdot |h| & = \\\\ 2\\cdot (-f)\\cdot (-g)\\cdot (h) & = \\\\ 2fgh.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d0c3eb9e-8664-5cd5-8345-3716f6532fd0"] :db/ensure [:question/validate]} {:db/id "answer-field-d0c3eb9e-8664-5cd5-8345-3716f6532fd0" :answer-field/id #uuid "d0c3eb9e-8664-5cd5-8345-3716f6532fd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-32d2d786-51d7-5f07-ab4d-ba30edce218c" :answer-field/choices ["answer-43664aa3-e124-5faa-aa77-ae09767124ae" "answer-30583952-b0c6-55ee-864d-2722626ca01e" "answer-2e876c5a-9037-5baf-acbf-9ba00705fd57" "answer-32d2d786-51d7-5f07-ab4d-ba30edce218c" "answer-4c8ae3d4-7dac-56f0-afcc-4269286bdf5a"] :db/ensure [:answer-field/validate]} {:db/id "answer-43664aa3-e124-5faa-aa77-ae09767124ae" :answer/id #uuid "43664aa3-e124-5faa-aa77-ae09767124ae" :answer/type :answer.type/math :answer/value "-2fgh" :db/ensure [:answer/validate]} {:db/id "answer-30583952-b0c6-55ee-864d-2722626ca01e" :answer/id #uuid "30583952-b0c6-55ee-864d-2722626ca01e" :answer/type :answer.type/math :answer/value "-2fg{h}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2e876c5a-9037-5baf-acbf-9ba00705fd57" :answer/id #uuid "2e876c5a-9037-5baf-acbf-9ba00705fd57" :answer/type :answer.type/math :answer/value "-4fgh" :db/ensure [:answer/validate]} {:db/id "answer-32d2d786-51d7-5f07-ab4d-ba30edce218c" :answer/id #uuid "32d2d786-51d7-5f07-ab4d-ba30edce218c" :answer/type :answer.type/math :answer/value "2fgh" :db/ensure [:answer/validate]} {:db/id "answer-4c8ae3d4-7dac-56f0-afcc-4269286bdf5a" :answer/id #uuid "4c8ae3d4-7dac-56f0-afcc-4269286bdf5a" :answer/type :answer.type/math :answer/value "4fgh" :db/ensure [:answer/validate]} {:db/id "question-e44f5e7f-50c8-5f61-b0b8-699aaec6f842" :question/id #uuid "e44f5e7f-50c8-5f61-b0b8-699aaec6f842" :question/math-academy-id "q-52504" :question/problem "Simplify $\\sqrt{\\frac{9}{{y}^{2}}}\\,$ given that $y<0.$" :question/worked-solution "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{{x}^{2}}=|x|\n$$\n\nIn our case, we can simplify the given expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{\\frac{9}{{y}^{2}}} & = \\\\ \\sqrt{\\frac{3}{y}\\cdot \\frac{3}{y}} & = \\\\ \\sqrt{{(\\frac{3}{y})}^{2}} & = \\\\ |\\frac{3}{y}| & = \\\\ \\frac{|3|}{|y|} & = \\\\ \\frac{3}{|y|}\\end{aligned}\n$$\n\nWe are told that $y<0.$ To take the absolute value of any negative number we need to flip the sign, so we have $|y|=-y.$ Therefore, our final answer is\n\n$$\n\\frac{3}{|y|}=-\\frac{3}{y}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-72fd739d-61ce-572d-ba84-147f6daa016b"] :db/ensure [:question/validate]} {:db/id "answer-field-72fd739d-61ce-572d-ba84-147f6daa016b" :answer-field/id #uuid "72fd739d-61ce-572d-ba84-147f6daa016b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-19bc5229-73fa-5621-ae34-90fcabb4ab10" :answer-field/choices ["answer-19bc5229-73fa-5621-ae34-90fcabb4ab10" "answer-2f44c7a4-9e6e-5b6f-85e7-5e7350d7fb51" "answer-c0622a2f-34d6-58c4-b16a-d4b9c8c6f07c" "answer-0863c307-3fc4-50bb-8193-2637b4d1fbf2" "answer-efca88fd-4fef-5d52-a234-b3f67f03da6e"] :db/ensure [:answer-field/validate]} {:db/id "answer-19bc5229-73fa-5621-ae34-90fcabb4ab10" :answer/id #uuid "19bc5229-73fa-5621-ae34-90fcabb4ab10" :answer/type :answer.type/math :answer/value "-\\frac{3}{y}" :db/ensure [:answer/validate]} {:db/id "answer-2f44c7a4-9e6e-5b6f-85e7-5e7350d7fb51" :answer/id #uuid "2f44c7a4-9e6e-5b6f-85e7-5e7350d7fb51" :answer/type :answer.type/math :answer/value "-\\frac{3}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-c0622a2f-34d6-58c4-b16a-d4b9c8c6f07c" :answer/id #uuid "c0622a2f-34d6-58c4-b16a-d4b9c8c6f07c" :answer/type :answer.type/math :answer/value "-\\frac{9}{y}" :db/ensure [:answer/validate]} {:db/id "answer-0863c307-3fc4-50bb-8193-2637b4d1fbf2" :answer/id #uuid "0863c307-3fc4-50bb-8193-2637b4d1fbf2" :answer/type :answer.type/math :answer/value "\\frac{3}{y}" :db/ensure [:answer/validate]} {:db/id "answer-efca88fd-4fef-5d52-a234-b3f67f03da6e" :answer/id #uuid "efca88fd-4fef-5d52-a234-b3f67f03da6e" :answer/type :answer.type/math :answer/value "\\frac{9}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186180733 :tutorial/content "The square root of a squared quantity can be simplified using absolute value.\n\n$$\n\\sqrt{x^2} = |x|\n$$\n\nHowever, if the domain of the variable is restricted, some expressions might allow further simplification. \n\nFor example, suppose we know that $a>0.$ Let's use this information to fully simplify $\\sqrt{36a^2}.$\n\nWe can start by simplifying the expression as follows:\n\n$$\n\\begin{aligned}\\sqrt{36{a}^{2}} & = \\\\ \\sqrt{(6a)^{2}} & = \\\\ |6a| & = \\\\ |6|\\cdot |a| \\\\ 6|a| & \\end{aligned}\n$$\n\nWe are told that $a>0,$ and we know that the absolute value of any positive number is just itself, so we have $|a|=a.$ Therefore, our final answer is\n\n$$\n6|a| = 6a .\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186180736 :tutorial/content "Let's see what changes if we consider square roots of perfect squares when some variables are negative.\n\nFor example, suppose that $t \\lt 0.$ Let's use this to simplify the expression $\\sqrt{t^2}.$\n\nSimplifying this expression in the usual way, we obtain\n\n$$\n\\eqalign{\n\t\\sqrt{t^2}&=\\[5pt]\n\t\\sqrt{(t)^2}&=\\[5pt]\n\t|t|.&\n\t}\n$$\n\nWe're given that $t \\lt 0.$ To take the absolute value of a negative number, we need to flip the sign. This gives $|t| = -t.$ Therefore, our final answer is\n\n$$\n{\\color{blue}\\sqrt{t^2}} = {\\color{red}-t}.\n$$\n\nYou can convince yourself that this is correct by plugging a few values of $t$ into the above equation. Provided that $t$ is negative, this expression will always give a true statement.\n\nFor example, suppose that $t = -2.$ Substituting into the left-hand side of the equation, we get\n\n$$\n\\begin{aligned}\\sqrt{{t}^{2}} & = \\\\ \\sqrt{(-2)^{2}} & = \\\\ \\sqrt{4} & = \\\\ 2 & .\\end{aligned}\n$$\n\nSubstituting $t=-2$ into the right-hand side of the equation, we get\n\n$$\n\\begin{aligned}-t & = \\\\ -(-2) & = \\\\ 2 & .\\end{aligned}\n$$\n\nSince both sides give the same result, the statement is true." :db/ensure [:tutorial/validate]} {:db/id 17592186179879 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124603 :knowledge-point/questions ["question-3a497a8c-181f-5ddb-8e0c-d7f0dcc66829"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3a497a8c-181f-5ddb-8e0c-d7f0dcc66829" :question/id #uuid "3a497a8c-181f-5ddb-8e0c-d7f0dcc66829" :question/math-academy-id "q-38861" :question/problem "Suppose $T:V\\to W$ is a linear map and $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ and $C=\\{{c}_{1},{c}_{2}\\}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$\\,$ $T({b}_{1})=-3{c}_{1}-5{c}_{2},\\,$ $T({b}_{2})={c}_{1}-4{c}_{2}\\,$ and $\\,T({b}_{3})=5{c}_{1}.$" :question/worked-solution "First, we write the images of vectors in $B$ relative to the basis $C:$ \n\n$$\n\\begin{aligned}T({b}_{1})=-3{c}_{1}-5{c}_{2} & \\,⟹\\,[T({b}_{1})]_{C}=[\\begin{aligned}-3 \\\\ -5\\end{aligned}] \\\\ T({b}_{2})={c}_{1}-4{c}_{2} & \\,⟹\\,[T({b}_{2})]_{C}=[\\begin{aligned}1 \\\\ -4\\end{aligned}] \\\\ T({b}_{3})=5{c}_{1} & \\,⟹\\,[T({b}_{3})]_{C}=[\\begin{aligned}5 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix  whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2})$ and $T({b}_{3})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-3 & 1 & 5 \\\\ -5 & -4 & 0\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7b795f03-1c4c-51ce-9ec3-51380c3631d6"] :db/ensure [:question/validate]} {:db/id "answer-field-7b795f03-1c4c-51ce-9ec3-51380c3631d6" :answer-field/id #uuid "7b795f03-1c4c-51ce-9ec3-51380c3631d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-825811a4-08b5-5ffb-990f-7e501d2498b2" :answer-field/choices ["answer-825811a4-08b5-5ffb-990f-7e501d2498b2" "answer-aad3aeef-b512-5754-9b36-a0105a67e7d6" "answer-b9f6fe27-6dff-5e8f-81fc-28e28ad0e3ab" "answer-394529b7-5240-5ff7-90db-e1add45b32a5" "answer-9efa7096-ec71-5ba8-a546-d69b56f674bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-825811a4-08b5-5ffb-990f-7e501d2498b2" :answer/id #uuid "825811a4-08b5-5ffb-990f-7e501d2498b2" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-3 & 1 & 5 \\\\ -5 & -4 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-aad3aeef-b512-5754-9b36-a0105a67e7d6" :answer/id #uuid "aad3aeef-b512-5754-9b36-a0105a67e7d6" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-3 & 1 \\\\ 5 & -5 \\\\ -4 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b9f6fe27-6dff-5e8f-81fc-28e28ad0e3ab" :answer/id #uuid "b9f6fe27-6dff-5e8f-81fc-28e28ad0e3ab" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-3 & 4 \\\\ 0 & -5 \\\\ -1 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-394529b7-5240-5ff7-90db-e1add45b32a5" :answer/id #uuid "394529b7-5240-5ff7-90db-e1add45b32a5" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}3 & -1 & 0 \\\\ 5 & 4 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9efa7096-ec71-5ba8-a546-d69b56f674bd" :answer/id #uuid "9efa7096-ec71-5ba8-a546-d69b56f674bd" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}5 & 1 & -3 \\\\ 0 & -4 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186124604 :knowledge-point/questions ["question-00e54e6a-cd0f-51b4-97b3-2489c07dd2c2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-00e54e6a-cd0f-51b4-97b3-2489c07dd2c2" :question/id #uuid "00e54e6a-cd0f-51b4-97b3-2489c07dd2c2" :question/math-academy-id "q-97574" :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{[\\begin{aligned}1 \\\\ -4\\end{aligned}],[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 2 & -1 \\\\ -4 & 1 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & -3 & 9 & -3\\end{aligned}] & {R}_{2} & :=(-\\frac{1}{3}){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & -1 \\\\ 0 & 1 & -3 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 0 \\\\ 0 & 1 & -3 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-1 & 0 \\\\ -3 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f4374709-dd94-564d-a093-c34e0f6d470b"] :db/ensure [:question/validate]} {:db/id "answer-field-f4374709-dd94-564d-a093-c34e0f6d470b" :answer-field/id #uuid "f4374709-dd94-564d-a093-c34e0f6d470b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be36abcb-60b4-5b59-8d60-819c63d7b780" :answer-field/choices ["answer-6a9c8e6c-8875-5f05-83c5-ba640b983ce5" "answer-be36abcb-60b4-5b59-8d60-819c63d7b780" "answer-5e277c6c-dcd2-5491-b1f3-c7fa6def4dfa" "answer-575b1543-5913-5111-9e9c-4cf207869497" "answer-3811dc15-f044-5933-86e0-b81332887411"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a9c8e6c-8875-5f05-83c5-ba640b983ce5" :answer/id #uuid "6a9c8e6c-8875-5f05-83c5-ba640b983ce5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & -3 \\\\ 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-be36abcb-60b4-5b59-8d60-819c63d7b780" :answer/id #uuid "be36abcb-60b4-5b59-8d60-819c63d7b780" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 \\\\ -3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5e277c6c-dcd2-5491-b1f3-c7fa6def4dfa" :answer/id #uuid "5e277c6c-dcd2-5491-b1f3-c7fa6def4dfa" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 & -1 \\\\ 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-575b1543-5913-5111-9e9c-4cf207869497" :answer/id #uuid "575b1543-5913-5111-9e9c-4cf207869497" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ -1 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3811dc15-f044-5933-86e0-b81332887411" :answer/id #uuid "3811dc15-f044-5933-86e0-b81332887411" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -3 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186124542 :knowledge-point/questions ["question-ba29e43e-8fe2-5bbe-a64e-366d83a4fca9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ba29e43e-8fe2-5bbe-a64e-366d83a4fca9" :question/id #uuid "ba29e43e-8fe2-5bbe-a64e-366d83a4fca9" :question/math-academy-id "q-97578" :question/problem "$$\n[T]_{B|C}=[\\begin{aligned}0 & 2 \\\\ 3 & 7 \\\\ 6 & 5\\end{aligned}],\\,[x]_{B}=[\\begin{aligned}4 \\\\ -2\\end{aligned}]\n$$\n\nSuppose $B$ and $C$ are bases of the vector spaces $V$ and $W,$ respectively. The matrix $[T]_{B|C}$ of the linear map $T:V\\to W$ relative to these bases, and the coordinates of the vector $x\\in V$ relative to $B$ are shown above. Find $[T(x)]_{C}.$" :question/worked-solution "The coordinates of the image of $x$ under $T$ relative to the basis $C$ can be found as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}0 & 2 \\\\ 3 & 7 \\\\ 6 & 5\\end{aligned}][\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ -2 \\\\ 14\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4b8b066b-e90d-5c38-b2a6-4d8b3185f0d1"] :db/ensure [:question/validate]} {:db/id "answer-field-4b8b066b-e90d-5c38-b2a6-4d8b3185f0d1" :answer-field/id #uuid "4b8b066b-e90d-5c38-b2a6-4d8b3185f0d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0b4984b8-1073-51f4-bbe6-0c45bb082a34" :answer-field/choices ["answer-9d7cb8ed-bc84-5b04-a0d8-47c0b7dd5e6a" "answer-0b4984b8-1073-51f4-bbe6-0c45bb082a34" "answer-97e4106e-ea27-5370-8a2c-fa0b2b2c526d" "answer-1601e7df-ddae-5494-a41c-da35e76fa3c1" "answer-83748e6b-9023-5628-b878-282bfb4de93b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d7cb8ed-bc84-5b04-a0d8-47c0b7dd5e6a" :answer/id #uuid "9d7cb8ed-bc84-5b04-a0d8-47c0b7dd5e6a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0b4984b8-1073-51f4-bbe6-0c45bb082a34" :answer/id #uuid "0b4984b8-1073-51f4-bbe6-0c45bb082a34" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 \\\\ -2 \\\\ 14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-97e4106e-ea27-5370-8a2c-fa0b2b2c526d" :answer/id #uuid "97e4106e-ea27-5370-8a2c-fa0b2b2c526d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1601e7df-ddae-5494-a41c-da35e76fa3c1" :answer/id #uuid "1601e7df-ddae-5494-a41c-da35e76fa3c1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 2 \\\\ 16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-83748e6b-9023-5628-b878-282bfb4de93b" :answer/id #uuid "83748e6b-9023-5628-b878-282bfb4de93b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 1 \\\\ 15\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186362217 :question/problem "$$\nB=\\{[\\begin{aligned}-1 \\\\ -2\\end{aligned}],[\\begin{aligned}0 \\\\ 5\\end{aligned}]\\},\\,[T]_{B|C}=[\\begin{aligned}2 & -2 \\\\ 1 & 1 \\\\ 3 & -2\\end{aligned}],\\,x=[\\begin{aligned}-4 \\\\ -3\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=[\\begin{aligned}-4 \\\\ -3\\end{aligned}]={x}_{1}[\\begin{aligned}-1 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 5\\end{aligned}].\n$$\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}-{x}_{1}=-4 \\\\ -2{x}_{1}+5{x}_{2}=-3.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 0 & -4 \\\\ -2 & 5 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 \\\\ -2 & 5 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 5 & 5\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{5}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}4 \\\\ 1\\end{aligned}].$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}2 & -2 \\\\ 1 & 1 \\\\ 3 & -2\\end{aligned}][\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}6 \\\\ 5 \\\\ 10\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-151e5f91-3cb4-5ced-a9bd-b1b2446d0e25" :activity/id #uuid "151e5f91-3cb4-5ced-a9bd-b1b2446d0e25" :activity/title "The Matrix of a Linear Map Relative to Two Bases" :activity/type :activity.type/review :activity/scope 17592186048582 :activity/course 17592186046659 :activity/steps ["step-0408ea5d-a169-5ec2-b15a-fbb75152c5cb" "step-0b3a2889-b1be-57f0-91ef-41940e81fc0b" "step-467923da-fcad-50c7-8110-cff41e775129" "step-236b321d-1506-5f60-8283-c253a6c03092" "step-7e3e85bd-ebee-5a59-b335-848da96d3843"] :activity/first-step "step-0408ea5d-a169-5ec2-b15a-fbb75152c5cb" :db/ensure [:activity/validate]} {:db/id "step-0408ea5d-a169-5ec2-b15a-fbb75152c5cb" :step/id #uuid "0408ea5d-a169-5ec2-b15a-fbb75152c5cb" :step/content "question-3a497a8c-181f-5ddb-8e0c-d7f0dcc66829" :step/next "step-0b3a2889-b1be-57f0-91ef-41940e81fc0b" :db/ensure [:step/validate]} {:db/id "step-0b3a2889-b1be-57f0-91ef-41940e81fc0b" :step/id #uuid "0b3a2889-b1be-57f0-91ef-41940e81fc0b" :step/content "question-00e54e6a-cd0f-51b4-97b3-2489c07dd2c2" :step/next "step-467923da-fcad-50c7-8110-cff41e775129" :db/ensure [:step/validate]} {:db/id "step-467923da-fcad-50c7-8110-cff41e775129" :step/id #uuid "467923da-fcad-50c7-8110-cff41e775129" :step/content "question-ba29e43e-8fe2-5bbe-a64e-366d83a4fca9" :step/next "step-236b321d-1506-5f60-8283-c253a6c03092" :db/ensure [:step/validate]} {:db/id "step-236b321d-1506-5f60-8283-c253a6c03092" :step/id #uuid "236b321d-1506-5f60-8283-c253a6c03092" :step/content 17592186362216 :step/next "step-7e3e85bd-ebee-5a59-b335-848da96d3843" :db/ensure [:step/validate]} {:db/id "step-7e3e85bd-ebee-5a59-b335-848da96d3843" :step/id #uuid "7e3e85bd-ebee-5a59-b335-848da96d3843" :step/content 17592186362217 :db/ensure [:step/validate]} {:db/id 17592186317208 :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ 7 \\\\ -3\\end{aligned}]+t[\\begin{aligned}-8 \\\\ 10 \\\\ -4\\end{aligned}] & =[\\begin{aligned}6 \\\\ 9 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}s-8t=6 \\\\ 7s+10t=9 \\\\ -3s-4t=-4\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -8 & 6 \\\\ 7 & 10 & 9 \\\\ -3 & -4 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ -3 & -4 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ 0 & -28 & 14\\end{aligned}] & {R}_{2} & :=\\frac{1}{66}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & -28 & 14\\end{aligned}] & {R}_{3} & :={R}_{3}+28{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}s-8t=6 \\\\ t=-\\frac{1}{2} \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-\\frac{1}{2}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-8t & =6 \\\\ s-8(-\\frac{1}{2}) & =6 \\\\ s+4 & =6 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=-\\frac{1}{2},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b-\\frac{1}{2}c.\n$$\n\nFinally, $s\\cdot t=2\\cdot (-\\frac{1}{2})=-1.$" :db/ensure [:question/validate]} {:db/id 17592186342231 :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -4 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-2 \\\\ 9 \\\\ 10\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ -8 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -4 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 9 \\\\ 10\\end{aligned}] & =[\\begin{aligned}3 \\\\ -8 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{2}=3 \\\\ -4{x}_{1}+9{x}_{2}=-8 \\\\ -2{x}_{1}+10{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 3 \\\\ -4 & 9 & -8 \\\\ -2 & 10 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ -2 & 10 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ 0 & 6 & k+6\\end{aligned}] & {R}_{3} & :={R}_{3}-6{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & k-18\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k-18.$ Therefore, the system has a solution only if\n\n$$\n0=k-18\\,⇒\\,k=18.\n$$" :db/ensure [:question/validate]} {:db/id 17592186342240 :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}-1 \\\\ 2 \\\\ 3\\end{aligned}]+t[\\begin{aligned}3 \\\\ -7 \\\\ -9\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3 \\\\ -6\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}-s+3t=2 \\\\ 2s-7t=-3 \\\\ 3s-9t=-6\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-1 & 3 & 2 \\\\ 2 & -7 & -3 \\\\ 3 & -9 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & -1 & 1 \\\\ 3 & -9 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}-s+3t=2 \\\\ -t=1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\n-t=1\\,⟹\\,t=-1.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}-s+3t & =2 \\\\ -s+3(-1) & =2 \\\\ -s & =5 \\\\ s & =-5.\\end{aligned}\n$$\n\nSince we found a solution $s=-5,\\,t=-1,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-5b-c.\n$$\n\nFinally, $s\\cdot t=(-5)\\cdot (-1)=5.$" :db/ensure [:question/validate]} {:db/id 17592186241017 :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-4 \\\\ 7 \\\\ 4\\end{aligned}],\\,b=[\\begin{aligned}8 \\\\ -7 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}2 \\\\ -3 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}-4 \\\\ 7 \\\\ 4\\end{aligned}] & =[\\begin{aligned}8 \\\\ -7 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}2{x}_{1}-4{x}_{2}=8 \\\\ -3{x}_{1}+7{x}_{2}=-7 \\\\ -2{x}_{1}+4{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -4 & 8 \\\\ -3 & 7 & -7 \\\\ -2 & 4 & k\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ -3 & 7 & -7 \\\\ -2 & 4 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ 0 & 1 & 5 \\\\ -2 & 4 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & k+8\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+8.$ Therefore, the system has a solution only if\n\n$$\n0=k+8\\,⇒\\,k=-8.\n$$" :db/ensure [:question/validate]} {:db/id 17592186241019 :question/problem "Find the values of $k$ such that the vector $b$ lies in $\\text{Span}\\{{a}_{1},{a}_{2}\\},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ -3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-4 \\\\ 3 \\\\ 12\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ -6 \\\\ k\\end{aligned}].\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ -3\\end{aligned}]+{x}_{2}[\\begin{aligned}-4 \\\\ 3 \\\\ 12\\end{aligned}] & =[\\begin{aligned}3 \\\\ -6 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-4{x}_{2}=3 \\\\ 3{x}_{2}=-6 \\\\ -3{x}_{1}+12{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -4 & 3 \\\\ 0 & 3 & -6 \\\\ -3 & 12 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 3 & -6 \\\\ 0 & 0 & k+9\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -4 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & k+9\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+9.$ Therefore, the system has a solution only if\n\n$$\n0=k+9\\,⇒\\,k=-9.\n$$" :db/ensure [:question/validate]} {:db/id "activity-9b83a1b4-0764-5c5a-941f-c490395d7bf4" :activity/id #uuid "9b83a1b4-0764-5c5a-941f-c490395d7bf4" :activity/title "Linear Span of Vectors in N-Dimensional Euclidean Space" :activity/type :activity.type/review :activity/scope 17592186048315 :activity/course 17592186046658 :activity/steps ["step-e82061b7-e579-5804-86dd-b377e54a1147" "step-b72404ac-26bb-566e-86ed-eac8022d2e24" "step-b3f379e0-d96a-59b3-a5f3-cd3157bae58d" "step-fc03f4e8-430f-5ef2-ba85-5ff08877b297" "step-e2d3f1ac-8edc-511e-a9dc-9a185ba14e65"] :activity/first-step "step-e82061b7-e579-5804-86dd-b377e54a1147" :db/ensure [:activity/validate]} {:db/id "step-e82061b7-e579-5804-86dd-b377e54a1147" :step/id #uuid "e82061b7-e579-5804-86dd-b377e54a1147" :step/content 17592186317208 :step/next "step-b72404ac-26bb-566e-86ed-eac8022d2e24" :db/ensure [:step/validate]} {:db/id "step-b72404ac-26bb-566e-86ed-eac8022d2e24" :step/id #uuid "b72404ac-26bb-566e-86ed-eac8022d2e24" :step/content 17592186342231 :step/next "step-b3f379e0-d96a-59b3-a5f3-cd3157bae58d" :db/ensure [:step/validate]} {:db/id "step-b3f379e0-d96a-59b3-a5f3-cd3157bae58d" :step/id #uuid "b3f379e0-d96a-59b3-a5f3-cd3157bae58d" :step/content 17592186342240 :step/next "step-fc03f4e8-430f-5ef2-ba85-5ff08877b297" :db/ensure [:step/validate]} {:db/id "step-fc03f4e8-430f-5ef2-ba85-5ff08877b297" :step/id #uuid "fc03f4e8-430f-5ef2-ba85-5ff08877b297" :step/content 17592186241017 :step/next "step-e2d3f1ac-8edc-511e-a9dc-9a185ba14e65" :db/ensure [:step/validate]} {:db/id "step-e2d3f1ac-8edc-511e-a9dc-9a185ba14e65" :step/id #uuid "e2d3f1ac-8edc-511e-a9dc-9a185ba14e65" :step/content 17592186241019 :db/ensure [:step/validate]} [:db/retract 17592186095886 :answer-field/choices 17592186095888] [:db/retract 17592186095886 :answer-field/choices 17592186095889] [:db/retract 17592186095886 :answer-field/choices 17592186095890] [:db/retract 17592186095886 :answer-field/choices 17592186095891] [:db/retract 17592186095886 :answer-field/choices 17592186095887] [:db/retract 17592186095916 :answer-field/choices 17592186095920] [:db/retract 17592186095916 :answer-field/choices 17592186095921] [:db/retract 17592186095916 :answer-field/choices 17592186095917] [:db/retract 17592186095916 :answer-field/choices 17592186095918] [:db/retract 17592186095916 :answer-field/choices 17592186095919] [:db/retract 17592186095928 :answer-field/choices 17592186095929] [:db/retract 17592186095928 :answer-field/choices 17592186095930] [:db/retract 17592186095928 :answer-field/choices 17592186095931] [:db/retract 17592186095928 :answer-field/choices 17592186095932] [:db/retract 17592186095928 :answer-field/choices 17592186095933] {:db/id 17592186097327 :question/worked-solution "To determine the distance between Margaret and Juan, we calculate the difference between Margaret's location and Juan's location. This gives\n\n$$\n2-(-13)=2+13=15\\,\\text{m}.\n$$\n\nTherefore, Margaret and Juan are $15\\,\\text{m}$ apart." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186095886 :answer-field/correct "answer-a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" :answer-field/choices ["answer-43d5adc5-a2eb-531a-b7ea-b5939b327f6a" "answer-bb2d2cd5-3aa6-5d90-8deb-5b7155be97f6" "answer-86933486-a8ce-5022-91e0-69867dfc556a" "answer-a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" "answer-e5cee887-50b6-56ef-81f1-ae790574664e"] :db/ensure [:answer-field/validate]} {:db/id "answer-43d5adc5-a2eb-531a-b7ea-b5939b327f6a" :answer/id #uuid "43d5adc5-a2eb-531a-b7ea-b5939b327f6a" :answer/type :answer.type/math :answer/value "11\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-bb2d2cd5-3aa6-5d90-8deb-5b7155be97f6" :answer/id #uuid "bb2d2cd5-3aa6-5d90-8deb-5b7155be97f6" :answer/type :answer.type/math :answer/value "12\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-86933486-a8ce-5022-91e0-69867dfc556a" :answer/id #uuid "86933486-a8ce-5022-91e0-69867dfc556a" :answer/type :answer.type/math :answer/value "14\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" :answer/id #uuid "a0f2cce9-f1d9-5104-a5a1-b0915a465a5b" :answer/type :answer.type/math :answer/value "15\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-e5cee887-50b6-56ef-81f1-ae790574664e" :answer/id #uuid "e5cee887-50b6-56ef-81f1-ae790574664e" :answer/type :answer.type/math :answer/value "16\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186097332 :question/problem "On a certain day in January, the temperature in New York in the morning was $-{2.4}^{∘}\\,\\text{C}.$ At noon, the temperature registered a slight increase of ${0.7}^{∘}\\,\\text{C}.$ What was the temperature in New York at noon?" :question/worked-solution "To determine the temperature at noon, we add the variation in temperature to the temperature in the morning of that day This gives\n\n$$\n-{2.4}^{∘}\\,\\text{C}+{0.7}^{∘}\\,\\text{C}=-{1.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature in New York at noon that day was $-{1.7}^{∘}\\,\\text{C}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186095916 :answer-field/correct "answer-775a09e2-42f5-548f-8dd4-b32b4dc2ffac" :answer-field/choices ["answer-2b50f720-834e-538d-a417-e00fac3153c1" "answer-51dca9e2-de80-5c9d-8a95-e67f670877be" "answer-775a09e2-42f5-548f-8dd4-b32b4dc2ffac" "answer-e2d3652a-d1a5-5019-9d30-94746544d406" "answer-a5596099-ee8b-5cf9-8adb-ce7fa5b6cd6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b50f720-834e-538d-a417-e00fac3153c1" :answer/id #uuid "2b50f720-834e-538d-a417-e00fac3153c1" :answer/type :answer.type/math :answer/value "-{1.2}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-51dca9e2-de80-5c9d-8a95-e67f670877be" :answer/id #uuid "51dca9e2-de80-5c9d-8a95-e67f670877be" :answer/type :answer.type/math :answer/value "-{1.3}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-775a09e2-42f5-548f-8dd4-b32b4dc2ffac" :answer/id #uuid "775a09e2-42f5-548f-8dd4-b32b4dc2ffac" :answer/type :answer.type/math :answer/value "-{1.7}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-e2d3652a-d1a5-5019-9d30-94746544d406" :answer/id #uuid "e2d3652a-d1a5-5019-9d30-94746544d406" :answer/type :answer.type/math :answer/value "-{2.1}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-a5596099-ee8b-5cf9-8adb-ce7fa5b6cd6c" :answer/id #uuid "a5596099-ee8b-5cf9-8adb-ce7fa5b6cd6c" :answer/type :answer.type/math :answer/value "-{2.3}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id 17592186097334 :question/problem "Jennifer is doing a science experiment in her Chemistry class. She takes a liquid with a temperature of ${10.1}^{∘}\\text{C}$ and places it in a refrigerator. After half an hour, she removes the liquid from the refrigerator and places it on a table. She concludes that the temperature decreased by ${12.7}^{∘}\\text{C}.$\n\nAfter half an hour, Jennifer takes the temperature of the liquid again and finds that the temperature increased by ${8}^{∘}\\text{C}.$ What is the final temperature of the liquid?" :question/worked-solution "First of all, we must determine the temperature of the liquid when it was removed from the refrigerator. Since its temperature decreased by ${12.7}^{∘}\\text{C}$ compared to the initial temperature, we must subtract the variation in temperature from the initial temperature. This gives\n\n$$\n{10.1}^{∘}\\text{C}-{12.7}^{∘}\\text{C}=-{2.6}^{∘}\\text{C}.\n$$\n\nNow, we must determine the temperature of the liquid after half an hour had elapsed. Since the temperature of the liquid increased by ${8}^{∘}\\text{C}$ compared to the temperature when it was removed from the refrigerator, we add the variation in temperature to the temperature of the liquid when it was removed from the refrigerator. This gives\n\n$$\n-{2.6}^{∘}\\text{C}+{8}^{∘}\\text{C}={5.4}^{∘}\\text{C}.\n$$\n\nTherefore, the final temperature of the liquid is ${5.4}^{∘}\\text{C}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186095928 :answer-field/correct "answer-5af32836-d1a7-5d0a-943b-b796a712c9a8" :answer-field/choices ["answer-aee93dc4-7161-5dc3-8fb5-fae906b155a6" "answer-43af25d8-92f4-5878-a3dc-1e644c8ce222" "answer-89cd1393-5088-5478-9c9a-365dbf9b98ae" "answer-a8e8a032-002e-52f4-b130-3642ea6a8d2f" "answer-5af32836-d1a7-5d0a-943b-b796a712c9a8"] :db/ensure [:answer-field/validate]} {:db/id "answer-aee93dc4-7161-5dc3-8fb5-fae906b155a6" :answer/id #uuid "aee93dc4-7161-5dc3-8fb5-fae906b155a6" :answer/type :answer.type/math :answer/value "{3.8}^{∘}\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-43af25d8-92f4-5878-a3dc-1e644c8ce222" :answer/id #uuid "43af25d8-92f4-5878-a3dc-1e644c8ce222" :answer/type :answer.type/math :answer/value "{4.1}^{∘}\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-89cd1393-5088-5478-9c9a-365dbf9b98ae" :answer/id #uuid "89cd1393-5088-5478-9c9a-365dbf9b98ae" :answer/type :answer.type/math :answer/value "{4.5}^{∘}\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-a8e8a032-002e-52f4-b130-3642ea6a8d2f" :answer/id #uuid "a8e8a032-002e-52f4-b130-3642ea6a8d2f" :answer/type :answer.type/math :answer/value "{4.9}^{∘}\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-5af32836-d1a7-5d0a-943b-b796a712c9a8" :answer/id #uuid "5af32836-d1a7-5d0a-943b-b796a712c9a8" :answer/type :answer.type/math :answer/value "{5.4}^{∘}\\text{C}" :db/ensure [:answer/validate]} {:db/id "activity-6717b18e-0ae6-5129-8fd0-6d170c347d50" :activity/id #uuid "6717b18e-0ae6-5129-8fd0-6d170c347d50" :activity/title "Solving Problems Using Addition and Subtraction of Rational Numbers" :activity/type :activity.type/review :activity/scope 17592186049355 :activity/course 17592186046648 :activity/steps ["step-f6f16938-eb50-51e6-8e2a-41104a49a9ed" "step-b66eda3a-f894-548a-a50a-1339b390ccd6" "step-b210e935-1e45-56a0-b060-d68f4c88d265"] :activity/first-step "step-f6f16938-eb50-51e6-8e2a-41104a49a9ed" :db/ensure [:activity/validate]} {:db/id "step-f6f16938-eb50-51e6-8e2a-41104a49a9ed" :step/id #uuid "f6f16938-eb50-51e6-8e2a-41104a49a9ed" :step/content 17592186097327 :step/next "step-b66eda3a-f894-548a-a50a-1339b390ccd6" :db/ensure [:step/validate]} {:db/id "step-b66eda3a-f894-548a-a50a-1339b390ccd6" :step/id #uuid "b66eda3a-f894-548a-a50a-1339b390ccd6" :step/content 17592186097332 :step/next "step-b210e935-1e45-56a0-b060-d68f4c88d265" :db/ensure [:step/validate]} {:db/id "step-b210e935-1e45-56a0-b060-d68f4c88d265" :step/id #uuid "b210e935-1e45-56a0-b060-d68f4c88d265" :step/content 17592186097334 :db/ensure [:step/validate]} {:db/id 17592186133743 :knowledge-point/questions ["question-3bf6c999-4f9a-599b-886e-437d5517ddbb" "question-62e49a58-91d5-5a4c-a1e9-c098f0c19c7c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3bf6c999-4f9a-599b-886e-437d5517ddbb" :question/id #uuid "3bf6c999-4f9a-599b-886e-437d5517ddbb" :question/math-academy-id "q-75111" :question/problem "Suppose that the elementary row operation ${R}_{2}↔{R}_{3}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{2}↔{R}_{3}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-07dcfd9e-686a-5980-8030-4e14ec2230eb"] :db/ensure [:question/validate]} {:db/id "answer-field-07dcfd9e-686a-5980-8030-4e14ec2230eb" :answer-field/id #uuid "07dcfd9e-686a-5980-8030-4e14ec2230eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d11dd33f-db9a-51ba-8754-048bb7b19980" :answer-field/choices ["answer-9afac160-9dbe-590b-ab9a-9db17e13cb3f" "answer-ae9e4fdb-1a23-5b1f-8e61-e96e8df1fb9b" "answer-79c5607a-43a0-5745-b537-6b5b527d056b" "answer-4dbdb01d-4a57-549a-9067-c8cb88b27de8" "answer-d11dd33f-db9a-51ba-8754-048bb7b19980"] :db/ensure [:answer-field/validate]} {:db/id "answer-9afac160-9dbe-590b-ab9a-9db17e13cb3f" :answer/id #uuid "9afac160-9dbe-590b-ab9a-9db17e13cb3f" :answer/type :answer.type/math :answer/value "A\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ae9e4fdb-1a23-5b1f-8e61-e96e8df1fb9b" :answer/id #uuid "ae9e4fdb-1a23-5b1f-8e61-e96e8df1fb9b" :answer/type :answer.type/math :answer/value "A\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-79c5607a-43a0-5745-b537-6b5b527d056b" :answer/id #uuid "79c5607a-43a0-5745-b537-6b5b527d056b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-4dbdb01d-4a57-549a-9067-c8cb88b27de8" :answer/id #uuid "4dbdb01d-4a57-549a-9067-c8cb88b27de8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-d11dd33f-db9a-51ba-8754-048bb7b19980" :answer/id #uuid "d11dd33f-db9a-51ba-8754-048bb7b19980" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id 17592186133744 :knowledge-point/questions ["question-f10c9aaf-98e6-52a7-9de1-c8d29489c892" "question-294d3a87-ec82-5ba0-946d-47e92c2e2260" "question-b525e6cc-0aa9-5691-bec6-c50f5a129f63"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f10c9aaf-98e6-52a7-9de1-c8d29489c892" :question/id #uuid "f10c9aaf-98e6-52a7-9de1-c8d29489c892" :question/math-academy-id "q-75161" :question/problem "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{2}:=\\frac{3}{2}{R}_{2},\\,{R}_{1}↔{R}_{2}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "First, let's find the elementary matrices corresponding to the two given elementary row operations.\n\n- The first operation is ${R}_{2}:=\\frac{3}{2}{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{3}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{1}↔{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-77e9d5df-e744-5f1a-a0b6-526894e2a1eb"] :db/ensure [:question/validate]} {:db/id "answer-field-77e9d5df-e744-5f1a-a0b6-526894e2a1eb" :answer-field/id #uuid "77e9d5df-e744-5f1a-a0b6-526894e2a1eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f62fa805-14d4-5eca-a0fc-bac68f968347" :answer-field/choices ["answer-13bc40a4-7ba5-59a5-b74f-2c70c1d57fe3" "answer-7b5cda25-da79-5687-8995-ce9b1f970246" "answer-f62fa805-14d4-5eca-a0fc-bac68f968347" "answer-e82c35de-863c-511b-a81e-9e222e86b84a" "answer-30e849f9-e43f-555b-a478-500db4d039c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-13bc40a4-7ba5-59a5-b74f-2c70c1d57fe3" :answer/id #uuid "13bc40a4-7ba5-59a5-b74f-2c70c1d57fe3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-7b5cda25-da79-5687-8995-ce9b1f970246" :answer/id #uuid "7b5cda25-da79-5687-8995-ce9b1f970246" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}0 & \\frac{3}{2} & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-f62fa805-14d4-5eca-a0fc-bac68f968347" :answer/id #uuid "f62fa805-14d4-5eca-a0fc-bac68f968347" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-e82c35de-863c-511b-a81e-9e222e86b84a" :answer/id #uuid "e82c35de-863c-511b-a81e-9e222e86b84a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ \\frac{3}{2} & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-30e849f9-e43f-555b-a478-500db4d039c0" :answer/id #uuid "30e849f9-e43f-555b-a478-500db4d039c0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & \\frac{3}{2} & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "question-62e49a58-91d5-5a4c-a1e9-c098f0c19c7c" :question/id #uuid "62e49a58-91d5-5a4c-a1e9-c098f0c19c7c" :question/math-academy-id "q-110472" :question/problem "Suppose that the elementary row operation ${R}_{1}↔{R}_{2}$ is applied to a $3\\times 3$ matrix $A.$ What is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "We need to find a matrix $E$ such that $EA$ is equivalent to applying the elementary row operation ${R}_{1}↔{R}_{2}$ to $A.$\n\nTo find $E,$ we apply the given row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\nTherefore, the equivalent notation in terms of matrix multiplication is $EA:$\n\n$$\n[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a16204f8-f3d9-5011-8c48-c6b5f2db3a5b"] :db/ensure [:question/validate]} {:db/id "answer-field-a16204f8-f3d9-5011-8c48-c6b5f2db3a5b" :answer-field/id #uuid "a16204f8-f3d9-5011-8c48-c6b5f2db3a5b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-63b5ca94-7c8e-5598-ba13-28752852bfd9" :answer-field/choices ["answer-bc57dbd1-cb18-5136-86e5-420e461ef7af" "answer-73e152b8-77cd-51bf-ac4c-ac4a654611e5" "answer-63b5ca94-7c8e-5598-ba13-28752852bfd9" "answer-b6a14f61-2fc3-556c-8f5f-f4e80923c57d" "answer-aa17b4c3-3333-5dcb-aee8-13cca8125a67"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc57dbd1-cb18-5136-86e5-420e461ef7af" :answer/id #uuid "bc57dbd1-cb18-5136-86e5-420e461ef7af" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-73e152b8-77cd-51bf-ac4c-ac4a654611e5" :answer/id #uuid "73e152b8-77cd-51bf-ac4c-ac4a654611e5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-63b5ca94-7c8e-5598-ba13-28752852bfd9" :answer/id #uuid "63b5ca94-7c8e-5598-ba13-28752852bfd9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-b6a14f61-2fc3-556c-8f5f-f4e80923c57d" :answer/id #uuid "b6a14f61-2fc3-556c-8f5f-f4e80923c57d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-aa17b4c3-3333-5dcb-aee8-13cca8125a67" :answer/id #uuid "aa17b4c3-3333-5dcb-aee8-13cca8125a67" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "question-294d3a87-ec82-5ba0-946d-47e92c2e2260" :question/id #uuid "294d3a87-ec82-5ba0-946d-47e92c2e2260" :question/math-academy-id "q-110484" :question/problem "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{1}↔{R}_{3},\\,{R}_{2}:={R}_{2}+5{R}_{3}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{1}↔{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1}↔{R}_{3} \\\\  & ∼[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{2}:={R}_{2}+5{R}_{3}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a301872e-f9c1-5a36-8e8e-3c31baa4c791"] :db/ensure [:question/validate]} {:db/id "answer-field-a301872e-f9c1-5a36-8e8e-3c31baa4c791" :answer-field/id #uuid "a301872e-f9c1-5a36-8e8e-3c31baa4c791" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2098f34e-7ee7-5d3d-bd3c-1f8735d768a3" :answer-field/choices ["answer-daefc58c-d127-56af-8c6e-929a2dd275ef" "answer-a50d1571-c3e3-55f4-b6ed-ba6a11704549" "answer-7ccc0a60-4b27-5edb-8671-320f41c1b168" "answer-2098f34e-7ee7-5d3d-bd3c-1f8735d768a3" "answer-e220b937-6a5e-59d2-a5d5-41a83c7a2d33"] :db/ensure [:answer-field/validate]} {:db/id "answer-daefc58c-d127-56af-8c6e-929a2dd275ef" :answer/id #uuid "daefc58c-d127-56af-8c6e-929a2dd275ef" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-a50d1571-c3e3-55f4-b6ed-ba6a11704549" :answer/id #uuid "a50d1571-c3e3-55f4-b6ed-ba6a11704549" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 5\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-7ccc0a60-4b27-5edb-8671-320f41c1b168" :answer/id #uuid "7ccc0a60-4b27-5edb-8671-320f41c1b168" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 5 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-2098f34e-7ee7-5d3d-bd3c-1f8735d768a3" :answer/id #uuid "2098f34e-7ee7-5d3d-bd3c-1f8735d768a3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-e220b937-6a5e-59d2-a5d5-41a83c7a2d33" :answer/id #uuid "e220b937-6a5e-59d2-a5d5-41a83c7a2d33" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 5 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "question-b525e6cc-0aa9-5691-bec6-c50f5a129f63" :question/id #uuid "b525e6cc-0aa9-5691-bec6-c50f5a129f63" :question/math-academy-id "q-110493" :question/problem "Suppose that the following elementary row operations are applied to a $3\\times 3$ matrix $A$ in the given order:\n\n$$\n{R}_{2}:=3{R}_{2},\\,{R}_{3}:={R}_{3}+(-3){R}_{1},\\,{R}_{1}:={R}_{1}+{R}_{2}\n$$\n\nWhat is the equivalent notation in terms of matrix multiplication?" :question/worked-solution "First, let's find the elementary matrices corresponding to the given elementary row operations.\n\n- The first operation is ${R}_{2}:=3{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{1}\\end{aligned}\n$$\n\n- The second operation is ${R}_{3}:={R}_{3}+(-3){R}_{1}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}] \\\\  & ={E}_{2}\\end{aligned}\n$$\n\n- The third operation is ${R}_{1}:={R}_{1}+{R}_{2}.$ The corresponding elementary matrix can be found by applying this same elementary row operation to the identity matrix as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={E}_{3}\\end{aligned}\n$$\n\nTo apply the first elementary row operation to the matrix $A,$ we multiply by ${E}_{1}$ on the left and get ${E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nThen, to apply the second elementary row operation to ${E}_{1}A,$ we multiply by ${E}_{2}$ on the left and get ${E}_{2}{E}_{1}A:$\n\n$$\n[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$\n\nFinally, to apply the third elementary row operation to ${E}_{2}{E}_{1}A,$ we multiply by ${E}_{3}$ on the left and get ${E}_{3}{E}_{2}{E}_{1}A:$ \n\n$$\n[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-899ae17d-d211-5d95-aea6-b05439a6e74e"] :db/ensure [:question/validate]} {:db/id "answer-field-899ae17d-d211-5d95-aea6-b05439a6e74e" :answer-field/id #uuid "899ae17d-d211-5d95-aea6-b05439a6e74e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c0ef1d32-7b15-5903-9f86-c77ba3d1ed42" :answer-field/choices ["answer-a6d2b8dd-5f5f-52c7-96a0-69db153bcf1d" "answer-723e3a62-46ce-5ee6-be5e-b0279857a9ca" "answer-c463bc91-5bc4-5fe6-8a76-c801e96b0282" "answer-b955f10c-6517-5613-89c0-cd74c1bd80e9" "answer-c0ef1d32-7b15-5903-9f86-c77ba3d1ed42"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6d2b8dd-5f5f-52c7-96a0-69db153bcf1d" :answer/id #uuid "a6d2b8dd-5f5f-52c7-96a0-69db153bcf1d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-723e3a62-46ce-5ee6-be5e-b0279857a9ca" :answer/id #uuid "723e3a62-46ce-5ee6-be5e-b0279857a9ca" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-c463bc91-5bc4-5fe6-8a76-c801e96b0282" :answer/id #uuid "c463bc91-5bc4-5fe6-8a76-c801e96b0282" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-b955f10c-6517-5613-89c0-cd74c1bd80e9" :answer/id #uuid "b955f10c-6517-5613-89c0-cd74c1bd80e9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 3 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "answer-c0ef1d32-7b15-5903-9f86-c77ba3d1ed42" :answer/id #uuid "c0ef1d32-7b15-5903-9f86-c77ba3d1ed42" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\\cdot A" :db/ensure [:answer/validate]} {:db/id "activity-1bb1f997-9fe0-5e94-89c4-95bbb97a3f25" :activity/id #uuid "1bb1f997-9fe0-5e94-89c4-95bbb97a3f25" :activity/title "Row Operations on 3x3 Matrices as Products of Elementary Matrices" :activity/type :activity.type/review :activity/scope 17592186048947 :activity/course 17592186046659 :activity/steps ["step-6480aa5b-ee2d-59de-9bc0-5718af92cb12" "step-178fbde8-4f97-53f7-bac7-f88af87a8d55" "step-727f72d3-00f6-53d2-92f4-c727184c4dcb" "step-35bfeba7-bc18-5102-bfef-b4f07abd1425" "step-12f00de3-338f-56d2-8859-359b23733d90"] :activity/first-step "step-6480aa5b-ee2d-59de-9bc0-5718af92cb12" :db/ensure [:activity/validate]} {:db/id "step-6480aa5b-ee2d-59de-9bc0-5718af92cb12" :step/id #uuid "6480aa5b-ee2d-59de-9bc0-5718af92cb12" :step/content "question-3bf6c999-4f9a-599b-886e-437d5517ddbb" :step/next "step-178fbde8-4f97-53f7-bac7-f88af87a8d55" :db/ensure [:step/validate]} {:db/id "step-178fbde8-4f97-53f7-bac7-f88af87a8d55" :step/id #uuid "178fbde8-4f97-53f7-bac7-f88af87a8d55" :step/content "question-f10c9aaf-98e6-52a7-9de1-c8d29489c892" :step/next "step-727f72d3-00f6-53d2-92f4-c727184c4dcb" :db/ensure [:step/validate]} {:db/id "step-727f72d3-00f6-53d2-92f4-c727184c4dcb" :step/id #uuid "727f72d3-00f6-53d2-92f4-c727184c4dcb" :step/content "question-62e49a58-91d5-5a4c-a1e9-c098f0c19c7c" :step/next "step-35bfeba7-bc18-5102-bfef-b4f07abd1425" :db/ensure [:step/validate]} {:db/id "step-35bfeba7-bc18-5102-bfef-b4f07abd1425" :step/id #uuid "35bfeba7-bc18-5102-bfef-b4f07abd1425" :step/content "question-294d3a87-ec82-5ba0-946d-47e92c2e2260" :step/next "step-12f00de3-338f-56d2-8859-359b23733d90" :db/ensure [:step/validate]} {:db/id "step-12f00de3-338f-56d2-8859-359b23733d90" :step/id #uuid "12f00de3-338f-56d2-8859-359b23733d90" :step/content "question-b525e6cc-0aa9-5691-bec6-c50f5a129f63" :db/ensure [:step/validate]} [:db/retract 17592186066522 :answer-field/choices 17592186066524] {:db/id 17592186068828 :knowledge-point/questions ["question-0902afad-f2ba-5dbf-8fa2-d595df73885c" "question-b89f2670-8d2c-52b5-b612-dd1804214943"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068432 :question/problem "Simplify $\\sqrt{8z^3}.$" :question/worked-solution "We first write $8z^3$ as the product $4z^2 \\cdot 2z$ which contains a perfect square $(4z^2){:}$ \n\n$$\n\\eqalign{\n\t\\sqrt{8z^3}&=\\[3pt]\n\t\\sqrt{4z^2 \\cdot 2z}&\n\t}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\eqalign{\n\t\\sqrt{4z^2 \\cdot 2z}&=\\[3pt]\n        \\sqrt{(2z)^2\\cdot 2z}&=\\[3pt]\n        \\sqrt{(2z)^2}\\cdot \\sqrt{2z}&\n\t}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\eqalign{\n        \\sqrt{(2z)^2}\\cdot \\sqrt{2z}&=\\[3pt]\n        |2z|\\cdot \\sqrt{2z}&=\\[3pt]\n        |2|\\cdot|z|\\cdot \\sqrt{2z}&=\\[3pt]\n\t2|z|\\sqrt{2z}&\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068826 :knowledge-point/questions ["question-b653142d-595d-5dac-942f-8b41a4d42831" "question-c2d5742a-0261-5618-8222-f4f0f769fb79"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068676 :question/problem "Simplify $\\sqrt{50u^7}.$" :question/worked-solution "We first write $50u^7$ as the product $25u^6\\cdot 2u$ which contains a perfect square $(25u^6){:}$ \n\n$$\n\\eqalign{\n\t\\sqrt{50u^7}&=\\[3pt]\n\t\\sqrt{25u^6\\cdot 2u}&\n\t}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\eqalign{\n\t\\sqrt{25u^6\\cdot 2u}&=\\[3pt]\n\t\\sqrt{\\left(5u^3\\right)^2\\cdot 2u}&=\\[3pt]\n\t\\sqrt{\\left(5u^3\\right)^2}\\cdot\\sqrt{2u}&\n\t}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\eqalign{\n\t\\sqrt{\\left(5u^3\\right)^2}\\cdot\\sqrt{2u}&=\\[3pt]\n\t|5u^3|\\cdot\\sqrt{2u}&=\\[3pt]\n\t|5|\\cdot |u^3|\\cdot\\sqrt{2u}&=\\[3pt]\n\t5|u|^3 \\sqrt{2u}\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068852 :knowledge-point/questions ["question-1704928a-5b6a-5e32-992c-5da9fe38c678"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068469 :question/problem "Simplify $\\sqrt{18y^3}$ given that $y \\geq 0.$" :question/worked-solution "We first write $18y^3$ as the product $9y^2\\cdot 2y$ which contains a perfect square $(9y^2).$ Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\eqalign{\n\t\t\\sqrt{18y^3} &= \\\n\t\t\\sqrt{9y^2 \\cdot 2y} &= \\\t\t\t\t\n\t\t\\sqrt{9y^2} \\cdot \\sqrt{2y} &= \\\t\t\n\t\t\\sqrt{(3y)^2} \\cdot \\sqrt{2y} &= \\\t\t\n\t\t|3y| \\cdot \\sqrt{2y} &= \\\t\t\n\t\t|3| \\cdot |y| \\cdot \\sqrt{2y} &= \\\n\t\t3 \\cdot |y| \\cdot \\sqrt{2y}\n\t}\n$$\n\nSince $y \\geq 0,$ we have $|y|=y,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\eqalign{\n\t\t3 \\cdot |y| \\cdot \\sqrt{2y} &= \\\n\t\t3 \\cdot y \\cdot \\sqrt{2y} &= \\\n\t\t3y\\sqrt{2y}. &\n\t}\n$$" :db/ensure [:question/validate]} {:db/id "question-0902afad-f2ba-5dbf-8fa2-d595df73885c" :question/id #uuid "0902afad-f2ba-5dbf-8fa2-d595df73885c" :question/math-academy-id "q-141778" :question/problem "Simplify $\\sqrt{25{r}^{3}}.$" :question/worked-solution "We first write $25{r}^{3}$ as the product $25{r}^{2}\\cdot r$ which contains a perfect square $(25{r}^{2}):$ \n\n$$\n\\begin{aligned}\\sqrt{25{r}^{3}} & = \\\\ \\sqrt{25{r}^{2}\\cdot r} & \\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{25{r}^{2}\\cdot r} & = \\\\ \\sqrt{(5r)^{2}\\cdot r} & = \\\\ \\sqrt{(5r)^{2}}\\cdot \\sqrt{r} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{(5r)^{2}}\\cdot \\sqrt{r} & = \\\\ |5r|\\cdot \\sqrt{r} & = \\\\ |5|\\cdot |r|\\cdot \\sqrt{r} & = \\\\ 5|r|\\sqrt{r} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-77cf1334-15c4-5697-9c8a-01320f361d7e"] :db/ensure [:question/validate]} {:db/id "answer-field-77cf1334-15c4-5697-9c8a-01320f361d7e" :answer-field/id #uuid "77cf1334-15c4-5697-9c8a-01320f361d7e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ca20a89-e601-5fc3-8b5a-f7ecb7cc0938" :answer-field/choices ["answer-644eff91-0f4b-5176-bf9d-5c3031d27583" "answer-2151c7cd-e6ab-52e8-9366-584c9ea7f941" "answer-321221f6-baac-50eb-978c-4a7948aff069" "answer-9ca20a89-e601-5fc3-8b5a-f7ecb7cc0938" "answer-7813cfa6-4b6c-57be-975c-44d185242f6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-644eff91-0f4b-5176-bf9d-5c3031d27583" :answer/id #uuid "644eff91-0f4b-5176-bf9d-5c3031d27583" :answer/type :answer.type/math :answer/value "5{r}^{2}\\sqrt{5r}" :db/ensure [:answer/validate]} {:db/id "answer-2151c7cd-e6ab-52e8-9366-584c9ea7f941" :answer/id #uuid "2151c7cd-e6ab-52e8-9366-584c9ea7f941" :answer/type :answer.type/math :answer/value "5{r}^{2}\\sqrt{r}" :db/ensure [:answer/validate]} {:db/id "answer-321221f6-baac-50eb-978c-4a7948aff069" :answer/id #uuid "321221f6-baac-50eb-978c-4a7948aff069" :answer/type :answer.type/math :answer/value "5|r|\\sqrt{5r}" :db/ensure [:answer/validate]} {:db/id "answer-9ca20a89-e601-5fc3-8b5a-f7ecb7cc0938" :answer/id #uuid "9ca20a89-e601-5fc3-8b5a-f7ecb7cc0938" :answer/type :answer.type/math :answer/value "5|r|\\sqrt{r}" :db/ensure [:answer/validate]} {:db/id "answer-7813cfa6-4b6c-57be-975c-44d185242f6a" :answer/id #uuid "7813cfa6-4b6c-57be-975c-44d185242f6a" :answer/type :answer.type/math :answer/value "|r|\\sqrt{5r}" :db/ensure [:answer/validate]} {:db/id "question-b89f2670-8d2c-52b5-b612-dd1804214943" :question/id #uuid "b89f2670-8d2c-52b5-b612-dd1804214943" :question/math-academy-id "q-141464" :question/problem "Simplify $\\sqrt{54{y}^{2}}.$" :question/worked-solution "We first write $54{y}^{2}$ as the product $9{y}^{2}\\cdot 6$ which contains a perfect square $(9{y}^{2}):$ \n\n$$\n\\begin{aligned}\\sqrt{54{y}^{2}} & = \\\\ \\sqrt{9{y}^{2}\\cdot 6} & \\end{aligned}\n$$\n\nThen, we can separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{9{y}^{2}\\cdot 6} & = \\\\ \\sqrt{(3y)^{2}\\cdot 6} & = \\\\ \\sqrt{(3y)^{2}}\\cdot \\sqrt{6} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{(3y)^{2}}\\cdot \\sqrt{6} & = \\\\ |3y|\\cdot \\sqrt{6} & = \\\\ |3|\\cdot |y|\\cdot \\sqrt{6} & = \\\\ 3|y|\\sqrt{6} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e7cd740e-2e2f-5d86-98a0-50d1b58bfb81"] :db/ensure [:question/validate]} {:db/id "answer-field-e7cd740e-2e2f-5d86-98a0-50d1b58bfb81" :answer-field/id #uuid "e7cd740e-2e2f-5d86-98a0-50d1b58bfb81" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f81c3cae-04ac-5c1d-9a0e-992240cc9e4a" :answer-field/choices ["answer-ae31e598-f5ee-5a89-8202-3e24a0c7c88b" "answer-3a85dfae-b58e-5110-b0b2-b9912f1cccfa" "answer-f81c3cae-04ac-5c1d-9a0e-992240cc9e4a" "answer-5b029b06-3fe8-5023-a99f-576ac04f043d" "answer-e6a4c910-97b2-5aac-ba3f-9b72d7d1e641"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae31e598-f5ee-5a89-8202-3e24a0c7c88b" :answer/id #uuid "ae31e598-f5ee-5a89-8202-3e24a0c7c88b" :answer/type :answer.type/math :answer/value "3y\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-3a85dfae-b58e-5110-b0b2-b9912f1cccfa" :answer/id #uuid "3a85dfae-b58e-5110-b0b2-b9912f1cccfa" :answer/type :answer.type/math :answer/value "3y\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-f81c3cae-04ac-5c1d-9a0e-992240cc9e4a" :answer/id #uuid "f81c3cae-04ac-5c1d-9a0e-992240cc9e4a" :answer/type :answer.type/math :answer/value "3|y|\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-5b029b06-3fe8-5023-a99f-576ac04f043d" :answer/id #uuid "5b029b06-3fe8-5023-a99f-576ac04f043d" :answer/type :answer.type/math :answer/value "9y\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-e6a4c910-97b2-5aac-ba3f-9b72d7d1e641" :answer/id #uuid "e6a4c910-97b2-5aac-ba3f-9b72d7d1e641" :answer/type :answer.type/math :answer/value "9|y|\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "question-b653142d-595d-5dac-942f-8b41a4d42831" :question/id #uuid "b653142d-595d-5dac-942f-8b41a4d42831" :question/math-academy-id "q-142029" :question/problem "Simplify $\\sqrt{144{b}^{7}}.$" :question/worked-solution "We first write $144{b}^{7}$ as the product $144{b}^{6}\\cdot b$ which contains a perfect square $(144{b}^{6}):$ \n\n$$\n\\begin{aligned}\\sqrt{144{b}^{7}} & = \\\\ \\sqrt{144{b}^{6}\\cdot b} & \\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{144{b}^{6}\\cdot b} & = \\\\ \\sqrt{{(12{b}^{3})}^{2}\\cdot b} & = \\\\ \\sqrt{{(12{b}^{3})}^{2}}\\cdot \\sqrt{b} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{(12{b}^{3})}^{2}}\\cdot \\sqrt{b} & = \\\\ |12{b}^{3}|\\cdot \\sqrt{b} & = \\\\ |12|\\cdot |{b}^{3}|\\cdot \\sqrt{b} & = \\\\ 12|b{|}^{3}\\sqrt{b}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2f8690b5-abce-5211-840d-583b0ebd6297"] :db/ensure [:question/validate]} {:db/id "answer-field-2f8690b5-abce-5211-840d-583b0ebd6297" :answer-field/id #uuid "2f8690b5-abce-5211-840d-583b0ebd6297" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ff681692-b426-50e5-8ba6-d90289d0fc30" :answer-field/choices ["answer-ff681692-b426-50e5-8ba6-d90289d0fc30" "answer-bec70d89-6d7c-564f-96dc-93fb00ba3869" "answer-01aaa84b-e40c-5a39-8ece-1db6d385fa2b" "answer-e5717314-0ed1-5c37-83f5-1c1ed3391119" "answer-f1a1df60-7926-5d4b-9b6d-516f32634379"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff681692-b426-50e5-8ba6-d90289d0fc30" :answer/id #uuid "ff681692-b426-50e5-8ba6-d90289d0fc30" :answer/type :answer.type/math :answer/value "12|b{|}^{3}\\sqrt{b}" :db/ensure [:answer/validate]} {:db/id "answer-bec70d89-6d7c-564f-96dc-93fb00ba3869" :answer/id #uuid "bec70d89-6d7c-564f-96dc-93fb00ba3869" :answer/type :answer.type/math :answer/value "6|b{|}^{2}\\sqrt{b}" :db/ensure [:answer/validate]} {:db/id "answer-01aaa84b-e40c-5a39-8ece-1db6d385fa2b" :answer/id #uuid "01aaa84b-e40c-5a39-8ece-1db6d385fa2b" :answer/type :answer.type/math :answer/value "6|b{|}^{3}\\sqrt{2b}" :db/ensure [:answer/validate]} {:db/id "answer-e5717314-0ed1-5c37-83f5-1c1ed3391119" :answer/id #uuid "e5717314-0ed1-5c37-83f5-1c1ed3391119" :answer/type :answer.type/math :answer/value "|b{|}^{3}\\sqrt{3b}" :db/ensure [:answer/validate]} {:db/id "answer-f1a1df60-7926-5d4b-9b6d-516f32634379" :answer/id #uuid "f1a1df60-7926-5d4b-9b6d-516f32634379" :answer/type :answer.type/math :answer/value "|b{|}^{3}\\sqrt{4b}" :db/ensure [:answer/validate]} {:db/id "question-c2d5742a-0261-5618-8222-f4f0f769fb79" :question/id #uuid "c2d5742a-0261-5618-8222-f4f0f769fb79" :question/math-academy-id "q-141477" :question/problem "Simplify $\\sqrt{44{u}^{8}}.$" :question/worked-solution "We first write $44{u}^{8}$ as the product $4{u}^{8}\\cdot 11$ which contains a perfect square $(4{u}^{8}):$ \n\n$$\n\\begin{aligned}\\sqrt{44{u}^{8}} & = \\\\ \\sqrt{4{u}^{8}\\cdot 11} & \\end{aligned}\n$$\n\nThen, we separate the product into two separate radicals:\n\n$$\n\\begin{aligned}\\sqrt{4{u}^{8}\\cdot 11} & = \\\\ \\sqrt{{(2{u}^{4})}^{2}\\cdot 11} & = \\\\ \\sqrt{{(2{u}^{4})}^{2}}\\cdot \\sqrt{11} & \\end{aligned}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\begin{aligned}\\sqrt{{(2{u}^{4})}^{2}}\\cdot \\sqrt{11} & = \\\\ |2{u}^{4}|\\cdot \\sqrt{11} & = \\\\ |2|\\cdot |{u}^{4}|\\cdot \\sqrt{11} & = \\\\ 2|u{|}^{4}\\sqrt{11}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-532d42ad-6983-5ac0-b812-0adeaa85ae60"] :db/ensure [:question/validate]} {:db/id "answer-field-532d42ad-6983-5ac0-b812-0adeaa85ae60" :answer-field/id #uuid "532d42ad-6983-5ac0-b812-0adeaa85ae60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ccb9a3f1-55c2-57c9-b329-b187936a94f6" :answer-field/choices ["answer-5741f9cd-2501-5b30-b7e0-a278215b6fc7" "answer-e1b43e48-be98-5967-b286-728ee8cbc556" "answer-ccb9a3f1-55c2-57c9-b329-b187936a94f6" "answer-f25b5c8a-e6b1-58c5-abb0-68b7842aaaf2" "answer-b4a8333c-e258-5e91-8543-659cd1e80ccc"] :db/ensure [:answer-field/validate]} {:db/id "answer-5741f9cd-2501-5b30-b7e0-a278215b6fc7" :answer/id #uuid "5741f9cd-2501-5b30-b7e0-a278215b6fc7" :answer/type :answer.type/math :answer/value "11|u{|}^{4}\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-e1b43e48-be98-5967-b286-728ee8cbc556" :answer/id #uuid "e1b43e48-be98-5967-b286-728ee8cbc556" :answer/type :answer.type/math :answer/value "11|u{|}^{8}\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-ccb9a3f1-55c2-57c9-b329-b187936a94f6" :answer/id #uuid "ccb9a3f1-55c2-57c9-b329-b187936a94f6" :answer/type :answer.type/math :answer/value "2|u{|}^{4}\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "answer-f25b5c8a-e6b1-58c5-abb0-68b7842aaaf2" :answer/id #uuid "f25b5c8a-e6b1-58c5-abb0-68b7842aaaf2" :answer/type :answer.type/math :answer/value "2|u{|}^{8}\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "answer-b4a8333c-e258-5e91-8543-659cd1e80ccc" :answer/id #uuid "b4a8333c-e258-5e91-8543-659cd1e80ccc" :answer/type :answer.type/math :answer/value "4|u{|}^{4}\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "question-1704928a-5b6a-5e32-992c-5da9fe38c678" :question/id #uuid "1704928a-5b6a-5e32-992c-5da9fe38c678" :question/math-academy-id "q-2934" :question/problem "Simplify $\\sqrt{8{a}^{2}}$ given that $a\\ge 0.$" :question/worked-solution "We first write $8{a}^{2}$ as the product $4{a}^{2}\\cdot 2$ which contains a perfect square $(4{a}^{2}).$ Then, we can separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{8{a}^{2}} & = \\\\ \\sqrt{4{a}^{2}\\cdot 2} & = \\\\ \\sqrt{(2a)^{2}\\cdot 2} & = \\\\ \\sqrt{(2a)^{2}}\\cdot \\sqrt{2} & = \\\\ |2a|\\sqrt{2} & = \\\\ |2|\\cdot |a|\\cdot \\sqrt{2} & = \\\\ 2\\cdot |a|\\cdot \\sqrt{2}\\end{aligned}\n$$\n\nSince $a\\ge 0,$ we have $|a|=a,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}2\\cdot |a|\\cdot \\sqrt{2} & = \\\\ 2\\cdot a\\cdot \\sqrt{2} & = \\\\ 2a\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2d6498f4-a70b-50c1-9ce5-2cc3f0cc3064"] :db/ensure [:question/validate]} {:db/id "answer-field-2d6498f4-a70b-50c1-9ce5-2cc3f0cc3064" :answer-field/id #uuid "2d6498f4-a70b-50c1-9ce5-2cc3f0cc3064" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer-field/choices ["answer-cb925792-6008-5f93-bb6b-6fe323c888e8" "answer-55c0d6da-ec19-5da3-b2dc-7f663e03694e" "answer-9f55a8e6-e0d9-5e67-80ef-09398f8eab35" "answer-82bc2d85-b1c1-5c55-a2c7-2b61a9daf911" "answer-6bff48a8-8066-543e-beda-b761e7cc572b"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb925792-6008-5f93-bb6b-6fe323c888e8" :answer/id #uuid "cb925792-6008-5f93-bb6b-6fe323c888e8" :answer/type :answer.type/math :answer/value "2a" :db/ensure [:answer/validate]} {:db/id "answer-55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer/id #uuid "55c0d6da-ec19-5da3-b2dc-7f663e03694e" :answer/type :answer.type/math :answer/value "2a\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-9f55a8e6-e0d9-5e67-80ef-09398f8eab35" :answer/id #uuid "9f55a8e6-e0d9-5e67-80ef-09398f8eab35" :answer/type :answer.type/math :answer/value "2{a}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-82bc2d85-b1c1-5c55-a2c7-2b61a9daf911" :answer/id #uuid "82bc2d85-b1c1-5c55-a2c7-2b61a9daf911" :answer/type :answer.type/math :answer/value "4a" :db/ensure [:answer/validate]} {:db/id "answer-6bff48a8-8066-543e-beda-b761e7cc572b" :answer/id #uuid "6bff48a8-8066-543e-beda-b761e7cc572b" :answer/type :answer.type/math :answer/value "4{a}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186069224 :question/problem "Simplify $\\sqrt{32{y}^{3}}$ given that $y\\ge 0.$" :question/worked-solution "We first write $32{y}^{3}$ as the product $16{y}^{2}\\cdot 2y$ which contains a perfect square $(16{y}^{2}).$ Then, we separate the product into two separate radicals, one of which can be simplified:\n\n$$\n\\begin{aligned}\\sqrt{32{y}^{3}} & = \\\\ \\sqrt{16{y}^{2}\\cdot 2y} & = \\\\ \\sqrt{(4y)^{2}\\cdot 2y} & = \\\\ \\sqrt{(4y)^{2}}\\cdot \\sqrt{2y} & = \\\\ |4y|\\cdot \\sqrt{2y} & = \\\\ |4|\\cdot |y|\\cdot \\sqrt{2y} & = \\\\ 4\\cdot |y|\\cdot \\sqrt{2y}\\end{aligned}\n$$\n\nSince $y\\ge 0,$ we have $|y|=y,$ and we can simplify further. Therefore, our final answer is\n\n$$\n\\begin{aligned}4\\cdot |y|\\cdot \\sqrt{2y} & = \\\\ 4\\cdot y\\cdot \\sqrt{2y} & = \\\\ 4y\\sqrt{2y}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186066522 :answer-field/correct 17592186066526 :answer-field/choices ["answer-effe64da-d5ba-51cb-959c-be6a879f598d"] :db/ensure [:answer-field/validate]} {:db/id "answer-effe64da-d5ba-51cb-959c-be6a879f598d" :answer/id #uuid "effe64da-d5ba-51cb-959c-be6a879f598d" :answer/type :answer.type/math :answer/value "2{y}^{2}\\sqrt{8y}" :db/ensure [:answer/validate]} {:db/id 17592186069943 :tutorial/content "The **product rule for radicals** states that the square root of a product equals the product of the square roots:\n\n$$\n\\eqalign{\n\t\t\\sqrt{ab} &=\\sqrt{a} \\cdot \\sqrt{b}\n\t}\n$$\n\nWe can use the product rule to rewrite the square roots of algebraic expressions.\n\nAs an example, let's suppose we want to simplify the following expression:\n\n$$\n\\sqrt{32y}\n$$\n\nFirst, we rewrite $32y$ as the product $16 \\cdot 2y,$ which contains a perfect square $(16){:}$ \n\n$$\n\\eqalign{\n\t\\sqrt{32y}&=\\[5pt]\n\t\\sqrt{16 \\cdot 2y}&=\\[5pt]\n\t\\sqrt{4^2 \\cdot 2y}&\n\n\t}\n$$\n\nThen, we separate the product into two separate radicals using the product rule:\n\n$$\n\\eqalign{\n        \\sqrt{4^2\\cdot 2y}&=\\[3pt]\n        \\sqrt{4^2}\\cdot \\sqrt{2y}&\n\t}\n$$\n\nFinally, we simplify the radical containing the perfect square:\n\n$$\n\\eqalign{\n        \\sqrt{4^2}\\cdot \\sqrt{2y}&=\\[3pt]\n        |4|\\cdot \\sqrt{2y}&=\\[3pt]\n\n\t4\\sqrt{2y}&\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186068936 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186133278 :answer-field/choices 17592186133283] [:db/retract 17592186133278 :answer-field/choices 17592186133279] {:db/id 17592186133728 :knowledge-point/questions ["question-770dc96c-77d3-556b-b303-18d387043365"] :db/ensure [:knowledge-point/validate]} {:db/id "question-770dc96c-77d3-556b-b303-18d387043365" :question/id #uuid "770dc96c-77d3-556b-b303-18d387043365" :question/math-academy-id "q-89606" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{75}x,\\, & 5\\le x\\le 10 \\\\ 0,\\, & \\text{otherwise}\\end{aligned}\n$$\n\nits cumulative distribution function is \n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<5 \\\\ h(x),\\, & 5\\le x\\le 10 \\\\ 1,\\, & x>10.\\end{aligned}\n$$\n\nFind the function $h(x).$" :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that is strictly positive only for $5\\le x\\le 10,$ the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}0, & x<5 \\\\ {\\int }_{5}^{x}f(t)\\,\\text{d}t, & 5\\le x\\le 10 \\\\ 1, & x>10\\end{aligned}\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}{\\int }_{5}^{x}f(t)\\,\\text{d}t & ={\\int }_{5}^{x}\\frac{2}{75}t\\,\\text{d}t \\\\ \\text{ } & ={\\frac{1}{75}{t}^{2}|}_{5}^{x} \\\\  & =\\frac{1}{75}{x}^{2}-\\frac{1}{3} \\\\  & =\\frac{{x}^{2}-25}{75}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<5, \\\\ \\frac{{x}^{2}-25}{75},\\, & 5\\le x\\le 10, \\\\ 1,\\, & x>10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94adf626-a400-5181-b287-7ccffcedb8aa"] :db/ensure [:question/validate]} {:db/id "answer-field-94adf626-a400-5181-b287-7ccffcedb8aa" :answer-field/id #uuid "94adf626-a400-5181-b287-7ccffcedb8aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-49f3c406-0b5e-5522-a240-414ac7e0f856" :answer-field/choices ["answer-b55dc857-62d1-5ed0-85ee-8b7c291b0260" "answer-f364853a-396b-5d86-bdbe-5ffe621626d8" "answer-1c522a9a-a340-5730-935a-e853421c44ca" "answer-887364d0-5dcf-5d1a-9cb5-af1322ef590e" "answer-49f3c406-0b5e-5522-a240-414ac7e0f856"] :db/ensure [:answer-field/validate]} {:db/id "answer-b55dc857-62d1-5ed0-85ee-8b7c291b0260" :answer/id #uuid "b55dc857-62d1-5ed0-85ee-8b7c291b0260" :answer/type :answer.type/math :answer/value "\\frac{1}{75}x" :db/ensure [:answer/validate]} {:db/id "answer-f364853a-396b-5d86-bdbe-5ffe621626d8" :answer/id #uuid "f364853a-396b-5d86-bdbe-5ffe621626d8" :answer/type :answer.type/math :answer/value "\\frac{1}{75}{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1c522a9a-a340-5730-935a-e853421c44ca" :answer/id #uuid "1c522a9a-a340-5730-935a-e853421c44ca" :answer/type :answer.type/math :answer/value "\\frac{75-2x}{75}" :db/ensure [:answer/validate]} {:db/id "answer-887364d0-5dcf-5d1a-9cb5-af1322ef590e" :answer/id #uuid "887364d0-5dcf-5d1a-9cb5-af1322ef590e" :answer/type :answer.type/math :answer/value "\\frac{75-{x}^{2}}{75}" :db/ensure [:answer/validate]} {:db/id "answer-49f3c406-0b5e-5522-a240-414ac7e0f856" :answer/id #uuid "49f3c406-0b5e-5522-a240-414ac7e0f856" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}-25}{75}" :db/ensure [:answer/validate]} {:db/id 17592186134540 :question/problem "Given that the random variable $X$ has the cumulative distribution function\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<0 \\\\ \\frac{{x}^{2}}{25}, & 0\\le x\\le 5 \\\\ 1, & x>5,\\end{aligned}\n$$\n\nfind $P(1\\le X\\le 3).$" :question/worked-solution "Remember that for continuous random variables, it doesn't matter whether or not we include the endpoints of the interval. So we can perform the computation as follows:\n\n$$\n\\begin{aligned}P(1\\le X\\le 3) & =P(1<X\\le 3) \\\\  & =P(X\\le 3)-P(X\\le 1) \\\\  & =F(3)-F(1) \\\\  & =\\frac{{3}^{2}}{25}-\\frac{{1}^{2}}{25} \\\\  & =\\frac{8}{25}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186133278 :answer-field/correct 17592186133281 :answer-field/choices ["answer-c3226fc1-cbce-5f81-a7bd-59cad1dcc127" "answer-4a3624d2-d1b2-5d89-8864-4bd4b45113e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3226fc1-cbce-5f81-a7bd-59cad1dcc127" :answer/id #uuid "c3226fc1-cbce-5f81-a7bd-59cad1dcc127" :answer/type :answer.type/math :answer/value "1+\\frac{8}{25}" :db/ensure [:answer/validate]} {:db/id "answer-4a3624d2-d1b2-5d89-8864-4bd4b45113e1" :answer/id #uuid "4a3624d2-d1b2-5d89-8864-4bd4b45113e1" :answer/type :answer.type/math :answer/value "1-\\frac{8}{25}" :db/ensure [:answer/validate]} {:db/id 17592186133727 :knowledge-point/questions ["question-b31007d2-c9e1-51d3-8e66-44402735c224" "question-d0e0e171-2942-5666-9f4c-984a9e7d868a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b31007d2-c9e1-51d3-8e66-44402735c224" :question/id #uuid "b31007d2-c9e1-51d3-8e66-44402735c224" :question/math-academy-id "q-89634" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{3{x}^{2}}{\\pi (1+{x}^{6})},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nfind the cumulative distribution function $F(x).$" :question/worked-solution "The cumulative distribution function of a continuous random variable $X$ is the function $F(x)$ defined by\n\n$$\nF(x)=P(X\\le x)={\\int }_{-\\infty }^{x}f(t)\\,\\text{d}t.\n$$\n\nFor the given probability density function, we have\n\n$$\n\\begin{aligned}F(x) & ={\\int }_{-\\infty }^{x}f(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\infty }^{x}\\frac{3{t}^{2}}{\\pi (1+{t}^{6})}\\,\\text{d}t \\\\  & ={\\frac{\\operatorname{arctan}⁡({t}^{3})}{\\pi }|}_{-\\infty }^{x} \\\\  & =\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b07d72d2-93c7-594a-8963-dcc12be62f0b"] :db/ensure [:question/validate]} {:db/id "answer-field-b07d72d2-93c7-594a-8963-dcc12be62f0b" :answer-field/id #uuid "b07d72d2-93c7-594a-8963-dcc12be62f0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f2d1618-08b3-504b-b2c5-01edf31c29f4" :answer-field/choices ["answer-32e28268-65ac-57f8-af23-8c479907164b" "answer-3f2d1618-08b3-504b-b2c5-01edf31c29f4" "answer-697f3908-8152-5679-962d-8baf5ef9a307" "answer-57509640-0482-58cb-88f2-e1a8054d767c" "answer-acccdbc8-03e2-5723-966d-27a022e016ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-32e28268-65ac-57f8-af23-8c479907164b" :answer/id #uuid "32e28268-65ac-57f8-af23-8c479907164b" :answer/type :answer.type/math :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+1" :db/ensure [:answer/validate]} {:db/id "answer-3f2d1618-08b3-504b-b2c5-01edf31c29f4" :answer/id #uuid "3f2d1618-08b3-504b-b2c5-01edf31c29f4" :answer/type :answer.type/math :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-697f3908-8152-5679-962d-8baf5ef9a307" :answer/id #uuid "697f3908-8152-5679-962d-8baf5ef9a307" :answer/type :answer.type/math :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }+\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-57509640-0482-58cb-88f2-e1a8054d767c" :answer/id #uuid "57509640-0482-58cb-88f2-e1a8054d767c" :answer/type :answer.type/math :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-acccdbc8-03e2-5723-966d-27a022e016ef" :answer/id #uuid "acccdbc8-03e2-5723-966d-27a022e016ef" :answer/type :answer.type/math :answer/value "F(x)=\\frac{\\operatorname{arctan}⁡({x}^{3})}{\\pi }-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "question-d0e0e171-2942-5666-9f4c-984a9e7d868a" :question/id #uuid "d0e0e171-2942-5666-9f4c-984a9e7d868a" :question/math-academy-id "q-185531" :question/problem "Given that the random variable $X$ has the probability density function\n\n$$\nf(x)=\\frac{{e}^{-|x|}}{2},\\,x\\in (-\\infty ,\\infty ),\n$$\n\nits cumulative distribution function is\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x}}{2},\\, & x\\le 0 \\\\ h(x),\\, & x>0\\end{aligned}\n$$\n\nwhere $h(x)=${{field-1}}." :question/worked-solution "Since our random variable $X$ has a probability distribution function $f(x)$ that involves an absolute value, the cumulative distribution function takes the following form:\n\n$$\nF(x)=P(X\\le x)=\\{\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t}}{2}\\,\\text{d}t, & x<0 \\\\ {\\int }_{-\\infty }^{0}\\frac{{e}^{t}}{2}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t}}{2}\\,\\text{d}t, & x\\ge 0\\end{aligned}\n$$\n\nLet's compute the integrals.\n\n- If $x\\le 0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{x}\\frac{{e}^{t}}{2}\\,\\text{d}t & ={\\frac{{e}^{t}}{2}|}_{-\\infty }^{x} \\\\  & =\\frac{{e}^{x}}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{t}}{2}\\,\\text{d}t & ={\\frac{{e}^{x}}{2}|}_{x=0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- If $x>0,$ we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{x}\\frac{{e}^{-t}}{2}\\,\\text{d}t & =-{\\frac{{e}^{-t}}{2}|}_{0}^{x} \\\\  & =-\\frac{{e}^{-x}}{2}+\\frac{1}{2}.\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{{e}^{t}}{2}\\,\\text{d}t+{\\int }_{0}^{x}\\frac{{e}^{-t}}{2}\\,\\text{d}t & =\\frac{1}{2}+(-\\frac{{e}^{-x}}{2}+\\frac{1}{2}) \\\\  & =1-\\frac{{e}^{-x}}{2}.\\end{aligned}\n$$\n\nSo, the cumulative distribution function is given by\n\n$$\nF(x)=\\{\\begin{aligned}\\frac{{e}^{x}}{2},\\, & x\\le 0 \\\\ 1-\\frac{{e}^{-x}}{2},\\, & x>0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bb588555-9fd1-5660-8555-bc1960f97262"] :db/ensure [:question/validate]} {:db/id "answer-field-bb588555-9fd1-5660-8555-bc1960f97262" :answer-field/id #uuid "bb588555-9fd1-5660-8555-bc1960f97262" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1b593b2a-af8d-5c4e-9746-8d5e8f4120fb" :answer-field/choices ["answer-1b593b2a-af8d-5c4e-9746-8d5e8f4120fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b593b2a-af8d-5c4e-9746-8d5e8f4120fb" :answer/id #uuid "1b593b2a-af8d-5c4e-9746-8d5e8f4120fb" :answer/type :answer.type/math :answer/value "1-\\frac{e^{-x}}{2}" :db/ensure [:answer/validate]} {:db/id "activity-080db2d3-dbc7-5528-9498-6b1144f7a367" :activity/id #uuid "080db2d3-dbc7-5528-9498-6b1144f7a367" :activity/title "Cumulative Distribution Functions for Continuous Random Variables" :activity/type :activity.type/review :activity/scope 17592186050750 :activity/course 17592186046659 :activity/steps ["step-242c6578-3fc8-593e-975a-c9f65e32ad15" "step-39d0ba9a-b08d-5b45-b5bf-8a3943de2319" "step-30e12182-d109-5cee-b62b-e22ed003514c" "step-1943e8ec-2299-593e-84f2-5af6e5f545e6" "step-b33ab878-bbe3-5d53-9e65-806860542c47"] :activity/first-step "step-242c6578-3fc8-593e-975a-c9f65e32ad15" :db/ensure [:activity/validate]} {:db/id "step-242c6578-3fc8-593e-975a-c9f65e32ad15" :step/id #uuid "242c6578-3fc8-593e-975a-c9f65e32ad15" :step/content "question-770dc96c-77d3-556b-b303-18d387043365" :step/next "step-39d0ba9a-b08d-5b45-b5bf-8a3943de2319" :db/ensure [:step/validate]} {:db/id "step-39d0ba9a-b08d-5b45-b5bf-8a3943de2319" :step/id #uuid "39d0ba9a-b08d-5b45-b5bf-8a3943de2319" :step/content 17592186134540 :step/next "step-30e12182-d109-5cee-b62b-e22ed003514c" :db/ensure [:step/validate]} {:db/id "step-30e12182-d109-5cee-b62b-e22ed003514c" :step/id #uuid "30e12182-d109-5cee-b62b-e22ed003514c" :step/content "question-b31007d2-c9e1-51d3-8e66-44402735c224" :step/next "step-1943e8ec-2299-593e-84f2-5af6e5f545e6" :db/ensure [:step/validate]} {:db/id "step-1943e8ec-2299-593e-84f2-5af6e5f545e6" :step/id #uuid "1943e8ec-2299-593e-84f2-5af6e5f545e6" :step/content 17592186500293 :step/next "step-b33ab878-bbe3-5d53-9e65-806860542c47" :db/ensure [:step/validate]} {:db/id "step-b33ab878-bbe3-5d53-9e65-806860542c47" :step/id #uuid "b33ab878-bbe3-5d53-9e65-806860542c47" :step/content "question-d0e0e171-2942-5666-9f4c-984a9e7d868a" :db/ensure [:step/validate]} [:db/retract 17592186159542 :answer-field/choices 17592186159543] [:db/retract 17592186159542 :answer-field/choices 17592186159544] [:db/retract 17592186159542 :answer-field/choices 17592186159545] [:db/retract 17592186159542 :answer-field/choices 17592186159547] [:db/retract 17592186171525 :answer-field/choices 17592186171526] [:db/retract 17592186171525 :answer-field/choices 17592186171527] [:db/retract 17592186171525 :answer-field/choices 17592186171528] [:db/retract 17592186171525 :answer-field/choices 17592186171529] [:db/retract 17592186171525 :answer-field/choices 17592186171530] {:db/id 17592186179740 :knowledge-point/questions ["question-5f7aceb3-5a6a-584b-8488-47f8fb82e9a0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5f7aceb3-5a6a-584b-8488-47f8fb82e9a0" :question/id #uuid "5f7aceb3-5a6a-584b-8488-47f8fb82e9a0" :question/math-academy-id "q-125649" :question/problem "![](images/0f/0f178c33254644c5e2e7bf6f3c596df87b1ea2f0b5bfd417c3f279f6c62b1b0d.png)\n\nConsider the circle $S$ and the vector field $F,$ shown above. Let $C$ be any path where $S$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\nI. ${∮}_{C}F\\cdot \\text{d}r>0$\n\nII. ${∮}_{C}F\\cdot \\text{d}r<0$\n\nIII. ${∮}_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves clockwise along $C.$ \n\n![](images/f8/f87d2e735ad58e0b33a813fb91ab202ac0eeaf90575979ea45f954fb7e1d0493.png)\n\nSo, $Γ={∮}_{C}F\\cdot \\text{d}r<0.$\n\n- Statement III is true. It's clear from the picture below that $F$ assists the motion of the particle as it moves counterclockwise along $C.$\n\n![](images/10/102c11f9002e29a3759679c6ff0bd10188908d33eb9cc94a84d900956adc33a5.png)\n\nSo, $Γ={∮}_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0bb54f63-1362-5d2e-8c6a-5e8e2485a25f"] :db/ensure [:question/validate]} {:db/id "answer-field-0bb54f63-1362-5d2e-8c6a-5e8e2485a25f" :answer-field/id #uuid "0bb54f63-1362-5d2e-8c6a-5e8e2485a25f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-96e02c89-8c88-58ca-a757-3724f4c8eaae" :answer-field/choices ["answer-d6603e3d-1da4-5eb2-b8fd-71573abd6fc0" "answer-083c5ede-cedd-556a-8b65-fe48a6829892" "answer-96e02c89-8c88-58ca-a757-3724f4c8eaae" "answer-119acc6e-65cb-58c0-bc0c-21f9dc698553" "answer-bfcca706-e138-501f-b9cf-da409da5c70b"] :db/ensure [:answer-field/validate]} {:db/id "answer-d6603e3d-1da4-5eb2-b8fd-71573abd6fc0" :answer/id #uuid "d6603e3d-1da4-5eb2-b8fd-71573abd6fc0" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-083c5ede-cedd-556a-8b65-fe48a6829892" :answer/id #uuid "083c5ede-cedd-556a-8b65-fe48a6829892" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-96e02c89-8c88-58ca-a757-3724f4c8eaae" :answer/id #uuid "96e02c89-8c88-58ca-a757-3724f4c8eaae" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-119acc6e-65cb-58c0-bc0c-21f9dc698553" :answer/id #uuid "119acc6e-65cb-58c0-bc0c-21f9dc698553" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-bfcca706-e138-501f-b9cf-da409da5c70b" :answer/id #uuid "bfcca706-e138-501f-b9cf-da409da5c70b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186198378 :knowledge-point/questions ["question-2343ccc6-302e-57d1-903e-91d537e6ff5c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2343ccc6-302e-57d1-903e-91d537e6ff5c" :question/id #uuid "2343ccc6-302e-57d1-903e-91d537e6ff5c" :question/math-academy-id "q-161385" :question/problem "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨-2x,\\,-2y,\\,-z⟩,\\,r(u,v)=⟨{u}^{3},\\,{v}^{3},\\,uv⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-3{v}^{3},\\,-3{u}^{3},\\,9{u}^{2}{v}^{2}⟩.$*" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-3{v}^{3},\\,-3{u}^{3},\\,9{u}^{2}{v}^{2}⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨-2x,\\,-2y,\\,-z⟩{|}_{x={u}^{3}\\,y={v}^{3}\\,z=uv} \\\\  & =⟨-2{u}^{3},\\,-2{v}^{3},\\,-uv⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨-2{u}^{3},\\,-2{v}^{3},\\,-uv⟩\\cdot ⟨-3{v}^{3},\\,-3{u}^{3},\\,9{u}^{2}{v}^{2}⟩ \\\\  & =(-2{u}^{3})\\cdot (-3{v}^{3})+(-2{v}^{3})\\cdot (-3{u}^{3})+(-uv)\\cdot 9{u}^{2}{v}^{2} \\\\  & =6{u}^{3}{v}^{3}+6{u}^{3}{v}^{3}-9{u}^{3}{v}^{3} \\\\  & =3{u}^{3}{v}^{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,3{u}^{3}{v}^{3}\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3fefe9c8-5fc6-5bbb-bfe2-94890c45b24c"] :db/ensure [:question/validate]} {:db/id "answer-field-3fefe9c8-5fc6-5bbb-bfe2-94890c45b24c" :answer-field/id #uuid "3fefe9c8-5fc6-5bbb-bfe2-94890c45b24c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-620afa66-2c6c-57b7-a3ae-d62a79f7f8f3" :answer-field/choices ["answer-c2689dcd-d1d7-54f8-a7ca-f907d83e79ba" "answer-f99ddd32-d363-5197-81ba-b8f06c983f5c" "answer-620afa66-2c6c-57b7-a3ae-d62a79f7f8f3" "answer-6ebe624d-df33-5b1a-ac75-393b05dce501" "answer-9cd3bc80-2dcb-5963-9f05-c0a968725eba"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2689dcd-d1d7-54f8-a7ca-f907d83e79ba" :answer/id #uuid "c2689dcd-d1d7-54f8-a7ca-f907d83e79ba" :answer/type :answer.type/math :answer/value "2{u}^{2}{v}^{2}(uv+1)" :db/ensure [:answer/validate]} {:db/id "answer-f99ddd32-d363-5197-81ba-b8f06c983f5c" :answer/id #uuid "f99ddd32-d363-5197-81ba-b8f06c983f5c" :answer/type :answer.type/math :answer/value "3{u}^{2}{v}^{2}(u+v)" :db/ensure [:answer/validate]} {:db/id "answer-620afa66-2c6c-57b7-a3ae-d62a79f7f8f3" :answer/id #uuid "620afa66-2c6c-57b7-a3ae-d62a79f7f8f3" :answer/type :answer.type/math :answer/value "3{u}^{3}{v}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-6ebe624d-df33-5b1a-ac75-393b05dce501" :answer/id #uuid "6ebe624d-df33-5b1a-ac75-393b05dce501" :answer/type :answer.type/math :answer/value "6{u}^{3}{v}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-9cd3bc80-2dcb-5963-9f05-c0a968725eba" :answer/id #uuid "9cd3bc80-2dcb-5963-9f05-c0a968725eba" :answer/type :answer.type/math :answer/value "{u}^{2}{v}^{2}(3u+2v)" :db/ensure [:answer/validate]} {:db/id 17592186198408 :knowledge-point/questions ["question-41337cdf-5450-5e5f-ba7a-c0f13d6a2b84"] :db/ensure [:knowledge-point/validate]} {:db/id "question-41337cdf-5450-5e5f-ba7a-c0f13d6a2b84" :question/id #uuid "41337cdf-5450-5e5f-ba7a-c0f13d6a2b84" :question/math-academy-id "q-163038" :question/problem "A thin rod with mass density function $\\lambda (x)=5\\sqrt{x},$ measured in $\\text{kg/m},$ is placed along the $x$-axis over the interval $0\\le x\\le 1,$ where $x$ is measured in meters. Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=5\\sqrt{x},\\,a=0,\\,b=1.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{1}x\\cdot 5\\sqrt{x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}5{x}^{3/2}\\,\\text{d}x \\\\  & ={[2{x}^{5/2}]}_{0}^{1} \\\\  & =2\\cdot {1}^{5/2}-0 \\\\  & =2\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $2\\,\\text{kg}\\cdot \\text{m}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dfbf2f05-cb8e-50e3-add0-d21c0e98ca91"] :db/ensure [:question/validate]} {:db/id "answer-field-dfbf2f05-cb8e-50e3-add0-d21c0e98ca91" :answer-field/id #uuid "dfbf2f05-cb8e-50e3-add0-d21c0e98ca91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c41b729-6e05-5636-8a3b-1a37ee53810d" :answer-field/choices ["answer-8b9d062d-1816-571e-bbf1-1777667627d6" "answer-3c41b729-6e05-5636-8a3b-1a37ee53810d" "answer-77f963e0-0ec4-566b-93f6-f6ae435001d1" "answer-7fed4cfe-7a06-52f7-99ff-25232d7ce97b" "answer-1f03b339-985e-5e23-a739-bca6ba574cf3"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b9d062d-1816-571e-bbf1-1777667627d6" :answer/id #uuid "8b9d062d-1816-571e-bbf1-1777667627d6" :answer/type :answer.type/math :answer/value "10\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-3c41b729-6e05-5636-8a3b-1a37ee53810d" :answer/id #uuid "3c41b729-6e05-5636-8a3b-1a37ee53810d" :answer/type :answer.type/math :answer/value "2\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-77f963e0-0ec4-566b-93f6-f6ae435001d1" :answer/id #uuid "77f963e0-0ec4-566b-93f6-f6ae435001d1" :answer/type :answer.type/math :answer/value "4\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-7fed4cfe-7a06-52f7-99ff-25232d7ce97b" :answer/id #uuid "7fed4cfe-7a06-52f7-99ff-25232d7ce97b" :answer/type :answer.type/math :answer/value "5\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-1f03b339-985e-5e23-a739-bca6ba574cf3" :answer/id #uuid "1f03b339-985e-5e23-a739-bca6ba574cf3" :answer/type :answer.type/math :answer/value "6\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186162390 :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}1, & \\,0<x<1,\\,x-1<y<1-x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0<x<1,\\,x-1<y<1-x.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{x-1}^{1-x}1\\,\\text{d}y \\\\  & =y\\,{|}_{x-1}^{1-x} \\\\  & =(1-x)-(x-1) \\\\  & =2-2x.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}2-2x, & \\,0<x<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0<x<1,\\,x-1<y<1-x,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{1}{2-2x}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{1}{2-2x}, & \\,0<x<1,\\,x-1<y<1-x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186159542 :answer-field/correct "answer-f4fc661d-e145-5e66-b9b9-6631ae091f43" :answer-field/choices ["answer-c42b7b33-0490-5c36-8f01-54cc20ab39d5" "answer-70d54670-c738-50bc-afb0-0d6374b4b4d7" "answer-61b79666-a6d5-539f-81d1-2e3b56449d2b" "answer-f4fc661d-e145-5e66-b9b9-6631ae091f43"] :db/ensure [:answer-field/validate]} {:db/id "answer-c42b7b33-0490-5c36-8f01-54cc20ab39d5" :answer/id #uuid "c42b7b33-0490-5c36-8f01-54cc20ab39d5" :answer/type :answer.type/math :answer/value "2{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-70d54670-c738-50bc-afb0-0d6374b4b4d7" :answer/id #uuid "70d54670-c738-50bc-afb0-0d6374b4b4d7" :answer/type :answer.type/math :answer/value "\\frac{1}{1+x}" :db/ensure [:answer/validate]} {:db/id "answer-61b79666-a6d5-539f-81d1-2e3b56449d2b" :answer/id #uuid "61b79666-a6d5-539f-81d1-2e3b56449d2b" :answer/type :answer.type/math :answer/value "\\frac{1}{1-x}" :db/ensure [:answer/validate]} {:db/id "answer-f4fc661d-e145-5e66-b9b9-6631ae091f43" :answer/id #uuid "f4fc661d-e145-5e66-b9b9-6631ae091f43" :answer/type :answer.type/math :answer/value "\\frac{1}{2-2x}" :db/ensure [:answer/validate]} {:db/id 17592186172650 :question/problem "A particle moves along a circular path centered at $O$ in the $xy$-plane in the counterclockwise direction with a constant angular velocity of $2\\text{ rad/s}.$ Given that the object is at the position $(5,0)$ when $t=0,$ find the position function of the particle." :question/worked-solution "The position function of a particle moving in a circular path of radius $R$ in the $xy$-plane with a constant angular velocity $\\omega $ is given by\n\n$$\nr(t)=R(\\operatorname{cos}⁡\\omega t\\,i+\\operatorname{sin}⁡\\omega t\\,j),\n$$\n\nwhere it is assumed that the circle is centered at $O,$ and the particle is at the position $(R,0)$ when $t=0.$\n\nSince the object's initial position is $(5,0),$ we have that $r(0)=5i,$ and we can conclude that the circle's radius is $R=5.$\n\nTherefore, since we have $R=5$ and $\\omega =2\\text{ rad/s},$ we get that the position function is given by\n\n$$\n\\begin{aligned}r(t) & =5(\\operatorname{cos}⁡2t\\,i+\\operatorname{sin}⁡2t\\,j).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186171525 :answer-field/correct "answer-f94777e9-96eb-57dd-a363-17a5520ac6c4" :answer-field/choices ["answer-3aaf6df3-4c0c-5ce2-91b9-1f3eba10496a" "answer-e99681fa-8480-528a-936e-a22041e85c4c" "answer-f94777e9-96eb-57dd-a363-17a5520ac6c4" "answer-559434b9-9a2d-5235-9416-53044593424a" "answer-2ac6ffda-9fff-5f00-9079-1971793890a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-3aaf6df3-4c0c-5ce2-91b9-1f3eba10496a" :answer/id #uuid "3aaf6df3-4c0c-5ce2-91b9-1f3eba10496a" :answer/type :answer.type/math :answer/value "r(t)=2(\\operatorname{cos}⁡5t\\,i+\\operatorname{sin}⁡5t\\,j)" :db/ensure [:answer/validate]} {:db/id "answer-e99681fa-8480-528a-936e-a22041e85c4c" :answer/id #uuid "e99681fa-8480-528a-936e-a22041e85c4c" :answer/type :answer.type/math :answer/value "r(t)=2(\\operatorname{cos}⁡5t\\,i-\\operatorname{sin}⁡5t\\,j)" :db/ensure [:answer/validate]} {:db/id "answer-f94777e9-96eb-57dd-a363-17a5520ac6c4" :answer/id #uuid "f94777e9-96eb-57dd-a363-17a5520ac6c4" :answer/type :answer.type/math :answer/value "r(t)=5(\\operatorname{cos}⁡2t\\,i+\\operatorname{sin}⁡2t\\,j)" :db/ensure [:answer/validate]} {:db/id "answer-559434b9-9a2d-5235-9416-53044593424a" :answer/id #uuid "559434b9-9a2d-5235-9416-53044593424a" :answer/type :answer.type/math :answer/value "r(t)=5(\\operatorname{cos}⁡2t\\,i-\\operatorname{sin}⁡2t\\,j)" :db/ensure [:answer/validate]} {:db/id "answer-2ac6ffda-9fff-5f00-9079-1971793890a7" :answer/id #uuid "2ac6ffda-9fff-5f00-9079-1971793890a7" :answer/type :answer.type/math :answer/value "r(t)=5(\\operatorname{sin}⁡2t\\,i+\\operatorname{cos}⁡2t\\,j)" :db/ensure [:answer/validate]} {:db/id "activity-4f2c692a-cae4-5e31-b4bc-8532b7eab8ff" :activity/id #uuid "4f2c692a-cae4-5e31-b4bc-8532b7eab8ff" :activity/title "Quiz 2" :activity/type :activity.type/assessment :activity/course 17592186046660 :activity/steps ["step-19714afd-c950-5f0f-82b1-f04