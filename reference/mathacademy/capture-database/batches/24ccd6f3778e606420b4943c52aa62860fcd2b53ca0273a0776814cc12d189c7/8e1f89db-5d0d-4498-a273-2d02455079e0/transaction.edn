-25 \\\\  & =-21\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-76bd600f-4df3-5837-8db3-4c610cb01b2d"] :db/ensure [:question/validate]} {:db/id "answer-field-76bd600f-4df3-5837-8db3-4c610cb01b2d" :answer-field/id #uuid "76bd600f-4df3-5837-8db3-4c610cb01b2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d6261f9-d215-5ae3-bfdb-9431ed756997" :answer-field/choices ["answer-8d6261f9-d215-5ae3-bfdb-9431ed756997" "answer-019dfabe-776e-5411-a52a-468bd8010e2b" "answer-1d371280-0e81-5a2f-8015-37b237435f45" "answer-28841ece-193a-5984-aca8-980d7d142fd5" "answer-8bf18704-fb98-57f4-be11-81048d8cd298"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d6261f9-d215-5ae3-bfdb-9431ed756997" :answer/id #uuid "8d6261f9-d215-5ae3-bfdb-9431ed756997" :answer/type :answer.type/math :answer/value "g(-3)=-21" :db/ensure [:answer/validate]} {:db/id "answer-019dfabe-776e-5411-a52a-468bd8010e2b" :answer/id #uuid "019dfabe-776e-5411-a52a-468bd8010e2b" :answer/type :answer.type/math :answer/value "g(-3)=-29" :db/ensure [:answer/validate]} {:db/id "answer-1d371280-0e81-5a2f-8015-37b237435f45" :answer/id #uuid "1d371280-0e81-5a2f-8015-37b237435f45" :answer/type :answer.type/math :answer/value "g(-3)=21" :db/ensure [:answer/validate]} {:db/id "answer-28841ece-193a-5984-aca8-980d7d142fd5" :answer/id #uuid "28841ece-193a-5984-aca8-980d7d142fd5" :answer/type :answer.type/math :answer/value "g(-3)=29" :db/ensure [:answer/validate]} {:db/id "answer-8bf18704-fb98-57f4-be11-81048d8cd298" :answer/id #uuid "8bf18704-fb98-57f4-be11-81048d8cd298" :answer/type :answer.type/math :answer/value "g(-3)=49" :db/ensure [:answer/validate]} {:db/id "question-b9348d7e-52bc-5a07-98ca-88ef4ff5b0f5" :question/id #uuid "b9348d7e-52bc-5a07-98ca-88ef4ff5b0f5" :question/math-academy-id "q-31727" :question/problem "Evaluate $g(-1),$ if $g(x)=(x+3)^{2}-(x-5)^{2}.$" :question/worked-solution "We substitute $x=-1$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}g(x) & =(x+3)^{2}-(x-5)^{2} \\\\ g(-1) & =((-1)+3)^{2}-((-1)-5)^{2} \\\\  & =(2)^{2}-(-6)^{2} \\\\  & =4-36 \\\\  & =-32\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7da22270-2bc9-5e75-a1ee-38a321ba33ba"] :db/ensure [:question/validate]} {:db/id "answer-field-7da22270-2bc9-5e75-a1ee-38a321ba33ba" :answer-field/id #uuid "7da22270-2bc9-5e75-a1ee-38a321ba33ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04609b43-5111-5208-b18d-1c6e7b99af15" :answer-field/choices ["answer-8319ede1-808f-592a-a403-f22857a5c9d8" "answer-04609b43-5111-5208-b18d-1c6e7b99af15" "answer-b5da9e45-5970-5fa3-92b6-9e353c5519c3" "answer-16f29b86-ae62-561b-a969-655e99943a2e" "answer-28262c89-1983-5b3b-9aa2-400cb80daebc"] :db/ensure [:answer-field/validate]} {:db/id "answer-8319ede1-808f-592a-a403-f22857a5c9d8" :answer/id #uuid "8319ede1-808f-592a-a403-f22857a5c9d8" :answer/type :answer.type/math :answer/value "g(-1)=-27" :db/ensure [:answer/validate]} {:db/id "answer-04609b43-5111-5208-b18d-1c6e7b99af15" :answer/id #uuid "04609b43-5111-5208-b18d-1c6e7b99af15" :answer/type :answer.type/math :answer/value "g(-1)=-32" :db/ensure [:answer/validate]} {:db/id "answer-b5da9e45-5970-5fa3-92b6-9e353c5519c3" :answer/id #uuid "b5da9e45-5970-5fa3-92b6-9e353c5519c3" :answer/type :answer.type/math :answer/value "g(-1)=-39" :db/ensure [:answer/validate]} {:db/id "answer-16f29b86-ae62-561b-a969-655e99943a2e" :answer/id #uuid "16f29b86-ae62-561b-a969-655e99943a2e" :answer/type :answer.type/math :answer/value "g(-1)=27" :db/ensure [:answer/validate]} {:db/id "answer-28262c89-1983-5b3b-9aa2-400cb80daebc" :answer/id #uuid "28262c89-1983-5b3b-9aa2-400cb80daebc" :answer/type :answer.type/math :answer/value "g(-1)=31" :db/ensure [:answer/validate]} {:db/id 17592186068702 :knowledge-point/questions ["question-3e8b84ea-82b6-5138-bf4d-e73af61fdac3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3e8b84ea-82b6-5138-bf4d-e73af61fdac3" :question/id #uuid "3e8b84ea-82b6-5138-bf4d-e73af61fdac3" :question/math-academy-id "q-130576" :question/problem "Evaluate $f(-1,2)$ if $f(x,y)=(2x-y)(x+2y).$" :question/worked-solution "We substitute $x=-1$ and $y=2$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x,y) & =(2x-y)(x+2y) \\\\ f(-1,2) & =(2(-1)-2)((-1)+2(2)) \\\\  & =(-4)(3) \\\\  & =-12\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-021d4422-18e9-573a-aea3-c035cc557e6f"] :db/ensure [:question/validate]} {:db/id "answer-field-021d4422-18e9-573a-aea3-c035cc557e6f" :answer-field/id #uuid "021d4422-18e9-573a-aea3-c035cc557e6f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer-field/choices ["answer-c81618e6-76ad-5708-8e7c-de8c549d1cea" "answer-92ff2ec6-c1ed-57da-a105-85732944baad" "answer-2ea9fe05-136c-54fa-8287-468235cbdb0d" "answer-cfb62b1a-34c6-56d6-983c-37f403386609" "answer-c4dd854f-76b8-57b7-925b-6bec0085d762"] :db/ensure [:answer-field/validate]} {:db/id "answer-c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/id #uuid "c81618e6-76ad-5708-8e7c-de8c549d1cea" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-92ff2ec6-c1ed-57da-a105-85732944baad" :answer/id #uuid "92ff2ec6-c1ed-57da-a105-85732944baad" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-2ea9fe05-136c-54fa-8287-468235cbdb0d" :answer/id #uuid "2ea9fe05-136c-54fa-8287-468235cbdb0d" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-cfb62b1a-34c6-56d6-983c-37f403386609" :answer/id #uuid "cfb62b1a-34c6-56d6-983c-37f403386609" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-c4dd854f-76b8-57b7-925b-6bec0085d762" :answer/id #uuid "c4dd854f-76b8-57b7-925b-6bec0085d762" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-135b40fb-5cf8-57bf-b723-676d052a026d" :question/id #uuid "135b40fb-5cf8-57bf-b723-676d052a026d" :question/math-academy-id "q-214832" :question/problem "If $f(x)={x}^{2}-{4}^{x-2},$ then $f(4)=${{field-1}}." :question/worked-solution "We substitute $x=4$ into the function definition and then simplify:\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-{4}^{x-2} \\\\ f(4) & ={4}^{2}-{4}^{4-2} \\\\  & =16-{4}^{2} \\\\  & =16-16 \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-40e76a0e-856c-5852-affb-986c061df288"] :db/ensure [:question/validate]} {:db/id "answer-field-40e76a0e-856c-5852-affb-986c061df288" :answer-field/id #uuid "40e76a0e-856c-5852-affb-986c061df288" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4e1864d1-334e-5ed1-a854-e574404fd88a" :answer-field/choices ["answer-4e1864d1-334e-5ed1-a854-e574404fd88a"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e1864d1-334e-5ed1-a854-e574404fd88a" :answer/id #uuid "4e1864d1-334e-5ed1-a854-e574404fd88a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "activity-32d73cc0-19b4-59d2-9583-c970a787e5ed" :activity/id #uuid "32d73cc0-19b4-59d2-9583-c970a787e5ed" :activity/title "Introduction to Functions" :activity/type :activity.type/review :activity/scope 17592186048652 :activity/course 17592186046648 :activity/steps ["step-45066582-f649-5b97-b9fa-5d0d0116ad1b" "step-75570071-e9a9-567a-93e7-3ab7178838f5" "step-719d3968-3672-57cb-89f5-452d75b3654a" "step-235c73d5-ae23-5b39-841a-4951560a5eff"] :activity/first-step "step-45066582-f649-5b97-b9fa-5d0d0116ad1b" :db/ensure [:activity/validate]} {:db/id "step-45066582-f649-5b97-b9fa-5d0d0116ad1b" :step/id #uuid "45066582-f649-5b97-b9fa-5d0d0116ad1b" :step/content "question-3e0ff0f4-e55f-55b3-97b5-30132033682d" :step/next "step-75570071-e9a9-567a-93e7-3ab7178838f5" :db/ensure [:step/validate]} {:db/id "step-75570071-e9a9-567a-93e7-3ab7178838f5" :step/id #uuid "75570071-e9a9-567a-93e7-3ab7178838f5" :step/content "question-b9348d7e-52bc-5a07-98ca-88ef4ff5b0f5" :step/next "step-719d3968-3672-57cb-89f5-452d75b3654a" :db/ensure [:step/validate]} {:db/id "step-719d3968-3672-57cb-89f5-452d75b3654a" :step/id #uuid "719d3968-3672-57cb-89f5-452d75b3654a" :step/content "question-3e8b84ea-82b6-5138-bf4d-e73af61fdac3" :step/next "step-235c73d5-ae23-5b39-841a-4951560a5eff" :db/ensure [:step/validate]} {:db/id "step-235c73d5-ae23-5b39-841a-4951560a5eff" :step/id #uuid "235c73d5-ae23-5b39-841a-4951560a5eff" :step/content "question-135b40fb-5cf8-57bf-b723-676d052a026d" :db/ensure [:step/validate]} [:db/retract 17592186146810 :answer-field/choices 17592186146811] [:db/retract 17592186146810 :answer-field/choices 17592186146812] [:db/retract 17592186146810 :answer-field/choices 17592186146813] [:db/retract 17592186146810 :answer-field/choices 17592186146814] [:db/retract 17592186146810 :answer-field/choices 17592186146815] {:db/id 17592186147446 :knowledge-point/questions ["question-53714f34-122d-5a8f-aba0-bbac28e356b1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186148176 :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+5{y}^{′}+4y=0.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186146810 :answer-field/correct "answer-edb22a88-3dee-5ab3-9eab-16b36a52cc88" :answer-field/choices ["answer-e1ec7c0c-764a-586c-b9c0-5e640d3e5d0e" "answer-cf48a76b-b34b-52d6-9b6c-82a901119ce7" "answer-edb22a88-3dee-5ab3-9eab-16b36a52cc88" "answer-98baa58c-cc87-572a-a2cc-76a2b22b2949" "answer-5898a6ac-6276-53c2-8174-421d58a64302"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1ec7c0c-764a-586c-b9c0-5e640d3e5d0e" :answer/id #uuid "e1ec7c0c-764a-586c-b9c0-5e640d3e5d0e" :answer/type :answer.type/math :answer/value "{y}^{″}+14y=0" :db/ensure [:answer/validate]} {:db/id "answer-cf48a76b-b34b-52d6-9b6c-82a901119ce7" :answer/id #uuid "cf48a76b-b34b-52d6-9b6c-82a901119ce7" :answer/type :answer.type/math :answer/value "{y}^{″}+4y=\\operatorname{sin}⁡2t" :db/ensure [:answer/validate]} {:db/id "answer-edb22a88-3dee-5ab3-9eab-16b36a52cc88" :answer/id #uuid "edb22a88-3dee-5ab3-9eab-16b36a52cc88" :answer/type :answer.type/math :answer/value "{y}^{″}+5{y}^{′}+4y=0" :db/ensure [:answer/validate]} {:db/id "answer-98baa58c-cc87-572a-a2cc-76a2b22b2949" :answer/id #uuid "98baa58c-cc87-572a-a2cc-76a2b22b2949" :answer/type :answer.type/math :answer/value "{y}^{″}+6y=t{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "answer-5898a6ac-6276-53c2-8174-421d58a64302" :answer/id #uuid "5898a6ac-6276-53c2-8174-421d58a64302" :answer/type :answer.type/math :answer/value "{y}^{″}+6{y}^{′}-36y=0" :db/ensure [:answer/validate]} {:db/id "question-53714f34-122d-5a8f-aba0-bbac28e356b1" :question/id #uuid "53714f34-122d-5a8f-aba0-bbac28e356b1" :question/math-academy-id "q-94323" :question/problem "A particle of mass $6\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=12\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's velocity, and has a damping coefficient $c=12\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n6{y}^{″}=-12{y}^{′}-12y.\n$$\n\nRearranging the above equation, we get\n\n$$\n{y}^{″}+2{y}^{′}+2y=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-75bd61b2-2c49-5cb8-900c-1fc581123b01"] :db/ensure [:question/validate]} {:db/id "answer-field-75bd61b2-2c49-5cb8-900c-1fc581123b01" :answer-field/id #uuid "75bd61b2-2c49-5cb8-900c-1fc581123b01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1855cab-b3bd-5fe3-b443-b54786bc6c68" :answer-field/choices ["answer-f1855cab-b3bd-5fe3-b443-b54786bc6c68" "answer-98f9ec65-c855-5e81-b0cc-f12a6f566426" "answer-9cf8994c-214a-592c-b261-82613704efbd" "answer-57c78e60-9652-56b2-b93f-2476d1e583aa" "answer-616b6e13-f025-52ac-b464-e1464f7dc509"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1855cab-b3bd-5fe3-b443-b54786bc6c68" :answer/id #uuid "f1855cab-b3bd-5fe3-b443-b54786bc6c68" :answer/type :answer.type/math :answer/value "{y}^{″}+2{y}^{′}+2y=0" :db/ensure [:answer/validate]} {:db/id "answer-98f9ec65-c855-5e81-b0cc-f12a6f566426" :answer/id #uuid "98f9ec65-c855-5e81-b0cc-f12a6f566426" :answer/type :answer.type/math :answer/value "{y}^{″}+2{y}^{′}+6y=0" :db/ensure [:answer/validate]} {:db/id "answer-9cf8994c-214a-592c-b261-82613704efbd" :answer/id #uuid "9cf8994c-214a-592c-b261-82613704efbd" :answer/type :answer.type/math :answer/value "{y}^{″}+6{y}^{′}+6y=0" :db/ensure [:answer/validate]} {:db/id "answer-57c78e60-9652-56b2-b93f-2476d1e583aa" :answer/id #uuid "57c78e60-9652-56b2-b93f-2476d1e583aa" :answer/type :answer.type/math :answer/value "{y}^{″}+{y}^{′}+2y=0" :db/ensure [:answer/validate]} {:db/id "answer-616b6e13-f025-52ac-b464-e1464f7dc509" :answer/id #uuid "616b6e13-f025-52ac-b464-e1464f7dc509" :answer/type :answer.type/math :answer/value "{y}^{″}+{y}^{′}+