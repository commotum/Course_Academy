ensure [:answer/validate]} {:db/id "answer-ee5870dc-dd5b-50a4-90e8-1718c1670f75" :answer/id #uuid "ee5870dc-dd5b-50a4-90e8-1718c1670f75" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-d96f4929-b558-5dc7-a6d9-bc9fa1be46fa" :question/id #uuid "d96f4929-b558-5dc7-a6d9-bc9fa1be46fa" :question/math-academy-id "q-76792" :question/problem "![](images/b3/b365c6a6ae3ff9320465fe9a69e55b1737a7ffedf6cf6da6e91a5ed4ace3ba38.png)\n\nSolve for $x$ in the figure above given that $PR=QR$ and $\\overset{⟷}{RS}⊥\\overset{―}{PQ}.$" :question/worked-solution "By the converse of the perpendicular bisector theorem, a point equidistant from the endpoints of a segment lies on the perpendicular bisector of the segment. \n\nHere, the point $R$ is equidistant from the endpoints of $\\overset{―}{PQ}.$ Therefore, $\\overset{⟷}{SR}$ is the perpendicular bisector of $\\overset{―}{PQ}.$ \n\nIn particular, we have that $SP=SQ.$ We can use this equation so solve for $x:$\n\n$$\n\\begin{aligned}SP & =SQ \\\\ 8x-5 & =6x+1 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9b5cf645-b47f-5c52-831e-f24d44e305e8"] :db/ensure [:question/validate]} {:db/id "answer-field-9b5cf645-b47f-5c52-831e-f24d44e305e8" :answer-field/id #uuid "9b5cf645-b47f-5c52-831e-f24d44e305e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c02a76e-a4af-5ea7-bfdf-852f8d10031c" :answer-field/choices ["answer-c0013178-2b99-5fb1-a785-2e6b327f44db" "answer-5c02a76e-a4af-5ea7-bfdf-852f8d10031c" "answer-967781f9-bc3f-5802-8e20-58d296887213" "answer-f0745d7f-57d4-58e7-98ec-19f3f65df92a" "answer-4c6dc27d-fa04-5c94-993d-f56fe179225e"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0013178-2b99-5fb1-a785-2e6b327f44db" :answer/id #uuid "c0013178-2b99-5fb1-a785-2e6b327f44db" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {: