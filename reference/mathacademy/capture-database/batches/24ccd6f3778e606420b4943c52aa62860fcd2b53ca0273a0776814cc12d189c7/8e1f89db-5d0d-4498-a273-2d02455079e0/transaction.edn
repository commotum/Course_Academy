e49-5a06-9195-b5d03e27fcda" :db/ensure [:step/validate]} {:db/id "step-6e3dfff7-7e49-5a06-9195-b5d03e27fcda" :step/id #uuid "6e3dfff7-7e49-5a06-9195-b5d03e27fcda" :step/content "question-0a4aeef2-6579-5805-af59-33b7dcd85283" :step/next "step-839d743d-84ad-5c4d-83cf-80fd7c3e23c5" :db/ensure [:step/validate]} {:db/id "step-839d743d-84ad-5c4d-83cf-80fd7c3e23c5" :step/id #uuid "839d743d-84ad-5c4d-83cf-80fd7c3e23c5" :step/content 17592186272090 :db/ensure [:step/validate]} [:db/retract 17592186068074 :answer-field/choices 17592186068075] [:db/retract 17592186068074 :answer-field/choices 17592186068076] [:db/retract 17592186068074 :answer-field/choices 17592186068077] [:db/retract 17592186068074 :answer-field/choices 17592186068078] [:db/retract 17592186068074 :answer-field/choices 17592186068079] {:db/id 17592186068692 :knowledge-point/questions ["question-22f6fedf-943a-57f1-98a3-a82b2489035f" "question-af8f01ea-2536-5ff7-99ba-8a19dc049226"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068478 :question/problem "Find, in point-slope form, the equation of the line that passes through the point $(6,2)$ and has a slope of $4.$" :question/worked-solution "Using $m=4$ and $(x_1,y_1) = (6,2)$, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =4(x-6)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068693 :knowledge-point/questions ["question-c1c536e5-efa9-5d3b-97fb-617b507bd5a1" "question-807e0d45-6dda-516b-87e0-9ddf87246055"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068479 :question/problem "Find, in point-slope form, the equation of the straight line that passes through the points $(5,7)$ and $(1,-1).$" :question/worked-solution "We know that the line passes through the point $(5,7),$ so we can use $(x_1,y_1) = (5,7)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-7}{1-5}=\\frac{-8}{-4}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $(x_1,y_1) = (5,7)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-7 & =2(x-5)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068694 :knowledge-point/questions ["question-99417d8d-1f43-5c3e-b523-0e838b0c9470" "question-72696385-5600-5d16-af0f-e8ec844daceb" "question-1abe194d-a2aa-502b-8bc6-8f34c848d468" "question-2e072874-ed7d-544d-b970-83b9972e3853"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068480 :question/problem "Calculate the equation of the straight line that passes through the points $(1,10)$ and $(3,-2),$ giving your final answer in slope-intercept form." :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-2-10}{3-1}=\\frac{-12}{2}=-6\\end{aligned}\n$$\n\nThen, we substitute $m=-6$ and the point $(x_1,y_1) = (1,10)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-10 & =-6(x-1)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-10 & =-6(x-1) \\\\ y-10 & =-6x+6 \\\\ y & =-6x+16\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-22f6fedf-943a-57f1-98a3-a82b2489035f" :question/id #uuid "22f6fedf-943a-57f1-98a3-a82b2489035f" :question/math-academy-id "q-214702" :question/problem "Express the equation of the line that passes through the point $(1,3)$ and has a slope of $\\frac{1}{2}$ in point-slope form.\n\n{{field-1}}\n$=$\n{{field-2}}\n$($\n{{field-3}}\n$)$" :question/worked-solution "Using $m=\\frac{1}{2}$ and $({x}_{1},{y}_{1})=(1,3)$, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30f97c15-7c68-532d-aeb9-524efc0ab12f" "answer-field-d6845079-35a3-54db-a5c8-1c838df2412d" "answer-field-68e3aa4d-9327-58f5-a649-20e99f40125b"] :db/ensure [:question/validate]} {:db/id "answer-field-30f97c15-7c68-532d-aeb9-524efc0ab12f" :answer-field/id #uuid "30f97c15-7c68-532d-aeb9-524efc0ab12f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8116f4e8-14e9-5f1c-a37c-21d6f929f8f0" :answer-field/choices ["answer-8116f4e8-14e9-5f1c-a37c-21d6f929f8f0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8116f4e8-14e9-5f1c-a37c-21d6f929f8f0" :answer/id #uuid "8116f4e8-14e9-5f1c-a37c-21d6f929f8f0" :answer/type :answer.type/math :answer/value "y-3" :db/ensure [:answer/validate]} {:db/id "answer-field-d6845079-35a3-54db-a5c8-1c838df2412d" :answer-field/id #uuid "d6845079-35a3-54db-a5c8-1c838df2412d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ef6c5902-abd0-5239-9d09-72a16038bf04" :answer-field/choices ["answer-ef6c5902-abd0-5239-9d09-72a16038bf04"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef6c5902-abd0-5239-9d09-72a16038bf04" :answer/id #uuid "ef6c5902-abd0-5239-9d09-72a16038bf04" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-68e3aa4d-9327-58f5-a649-20e99f40125b" :answer-field/id #uuid "68e3aa4d-9327-58f5-a649-20e99f40125b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6eb023c9-16ed-5e01-b4fe-378dfdd4fb8f" :answer-field/choices ["answer-6eb023c9-16ed-5e01-b4fe-378dfdd4fb8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-6eb023c9-16ed-5e01-b4fe-378dfdd4fb8f" :answer/id #uuid "6eb023c9-16ed-5e01-b4fe-378dfdd4fb8f" :answer/type :answer.type/math :answer/value "x-1" :db/ensure [:answer/validate]} {:db/id "question-af8f01ea-2536-5ff7-99ba-8a19dc049226" :question/id #uuid "af8f01ea-2536-5ff7-99ba-8a19dc049226" :question/math-academy-id "q-51970" :question/problem "Find, in point-slope form, the equation of the line that passes through the point $(4,1)$ and has a slope of $-\\frac{1}{4}.$" :question/worked-solution "Using $m=-\\frac{1}{4}$ and $({x}_{1},{y}_{1})=(4,1)$, we substitute into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{1}{4}(x-4)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e4f85ec-f4fb-5149-aa50-068f9762a5c4"] :db/ensure [:question/validate]} {:db/id "answer-field-5e4f85ec-f4fb-5149-aa50-068f9762a5c4" :answer-field/id #uuid "5e4f85ec-f4fb-5149-aa50-068f9762a5c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-05bbc6f9-a71c-5303-9ba1-9c860d133578" :answer-field/choices ["answer-6567783f-5eab-5328-8904-c78c51b589db" "answer-0458a806-d323-507f-807a-cce564610d05" "answer-c4c9f024-7fde-5e78-b5ca-f49613465c11" "answer-05bbc6f9-a71c-5303-9ba1-9c860d133578" "answer-08a0ca07-73cb-561b-8f5e-683dd37e9382"] :db/ensure [:answer-field/validate]} {:db/id "answer-6567783f-5eab-5328-8904-c78c51b589db" :answer/id #uuid "6567783f-5eab-5328-8904-c78c51b589db" :answer/type :answer.type/math :answer/value "y+1=-\\frac{1}{4}(x-4)" :db/ensure [:answer/validate]} {:db/id "answer-0458a806-d323-507f-807a-cce564610d05" :answer/id #uuid "0458a806-d323-507f-807a-cce564610d05" :answer/type :answer.type/math :answer/value "y+4=-\\frac{1}{4}(x+1)" :db/ensure [:answer/validate]} {:db/id "answer-c4c9f024-7fde-5e78-b5ca-f49613465c11" :answer/id #uuid "c4c9f024-7fde-5e78-b5ca-f49613465c11" :answer/type :answer.type/math :answer/value "y-1=-\\frac{1}{4}(x+4)" :db/ensure [:answer/validate]} {:db/id "answer-05bbc6f9-a71c-5303-9ba1-9c860d133578" :answer/id #uuid "05bbc6f9-a71c-5303-9ba1-9c860d133578" :answer/type :answer.type/math :answer/value "y-1=-\\frac{1}{4}(x-4)" :db/ensure [:answer/validate]} {:db/id "answer-08a0ca07-73cb-561b-8f5e-683dd37e9382" :answer/id #uuid "08a0ca07-73cb-561b-8f5e-683dd37e9382" :answer/type :answer.type/math :answer/value "y-4=-\\frac{1}{4}(x-1)" :db/ensure [:answer/validate]} {:db/id "question-c1c536e5-efa9-5d3b-97fb-617b507bd5a1" :question/id #uuid "c1c536e5-efa9-5d3b-97fb-617b507bd5a1" :question/math-academy-id "q-51960" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(2,4)$  and $(-4,-8).$" :question/worked-solution "We know that the line passes through the point $(2,4),$ so we can use $({x}_{1},{y}_{1})=(2,4)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{(-8)-4}{(-4)-2}=\\frac{-12}{-6}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $({x}_{1},{y}_{1})=(2,4)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =2(x-2)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f6ab974-76c4-5ee1-ae20-e92ccae5d914"] :db/ensure [:question/validate]} {:db/id "answer-field-6f6ab974-76c4-5ee1-ae20-e92ccae5d914" :answer-field/id #uuid "6f6ab974-76c4-5ee1-ae20-e92ccae5d914" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4ceb533f-d98f-5ba8-901e-52501b69f81e" :answer-field/choices ["answer-78ceb82d-738e-51f3-8560-fbab85c41b03" "answer-2af5e56e-dd60-5295-bbdc-ea33774de19d" "answer-89349cd9-2d01-5801-881b-4b8665f79568" "answer-4ceb533f-d98f-5ba8-901e-52501b69f81e" "answer-a8370bac-b18e-58bb-bdc0-a9192adef58b"] :db/ensure [:answer-field/validate]} {:db/id "answer-78ceb82d-738e-51f3-8560-fbab85c41b03" :answer/id #uuid "78ceb82d-738e-51f3-8560-fbab85c41b03" :answer/type :answer.type/math :answer/value "y+4=2(x-2)" :db/ensure [:answer/validate]} {:db/id "answer-2af5e56e-dd60-5295-bbdc-ea33774de19d" :answer/id #uuid "2af5e56e-dd60-5295-bbdc-ea33774de19d" :answer/type :answer.type/math :answer/value "y+4=\\frac{1}{2}(x+2)" :db/ensure [:answer/validate]} {:db/id "answer-89349cd9-2d01-5801-881b-4b8665f79568" :answer/id #uuid "89349cd9-2d01-5801-881b-4b8665f79568" :answer/type :answer.type/math :answer/value "y-4=2(x+2)" :db/ensure [:answer/validate]} {:db/id "answer-4ceb533f-d98f-5ba8-901e-52501b69f81e" :answer/id #uuid "4ceb533f-d98f-5ba8-901e-52501b69f81e" :answer/type :answer.type/math :answer/value "y-4=2(x-2)" :db/ensure [:answer/validate]} {:db/id "answer-a8370bac-b18e-58bb-bdc0-a9192adef58b" :answer/id #uuid "a8370bac-b18e-58bb-bdc0-a9192adef58b" :answer/type :answer.type/math :answer/value "y-4=\\frac{1}{2}(x-2)" :db/ensure [:answer/validate]} {:db/id "question-807e0d45-6dda-516b-87e0-9ddf87246055" :question/id #uuid "807e0d45-6dda-516b-87e0-9ddf87246055" :question/math-academy-id "q-44463" :question/problem "Find, in point-slope form, the equation of the line that passes through the points $(2,-5)$ and $(6,-3).$" :question/worked-solution "We know that the line passes through the point $(2,-5),$ so we can use $({x}_{1},{y}_{1})=(2,-5)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-3-(-5)}{6-2}=\\frac{2}{4}=\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{1}{2}$ and the point $({x}_{1},{y}_{1})=(2,-5)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-5) & =\\frac{1}{2}(x-2) \\\\ y+5 & =\\frac{1}{2}(x-2)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fb692d57-2d39-5d74-a61f-7f4cc771ea13"] :db/ensure [:question/validate]} {:db/id "answer-field-fb692d57-2d39-5d74-a61f-7f4cc771ea13" :answer-field/id #uuid "fb692d57-2d39-5d74-a61f-7f4cc771ea13" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d66fd6b4-e28d-5784-baa5-fca15655be5d" :answer-field/choices ["answer-7b75104e-005a-541c-b769-3dda605403b6" "answer-f2207d9b-0a70-5ef2-a0b8-1cd6b58fd059" "answer-d66fd6b4-e28d-5784-baa5-fca15655be5d" "answer-0e6ea26b-1620-506e-bb8e-3fda206f1449" "answer-ec9e1392-f368-5bc7-8108-b97f862345cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b75104e-005a-541c-b769-3dda605403b6" :answer/id #uuid "7b75104e-005a-541c-b769-3dda605403b6" :answer/type :answer.type/math :answer/value "y+5=2(x-2)" :db/ensure [:answer/validate]} {:db/id "answer-f2207d9b-0a70-5ef2-a0b8-1cd6b58fd059" :answer/id #uuid "f2207d9b-0a70-5ef2-a0b8-1cd6b58fd059" :answer/type :answer.type/math :answer/value "y+5=\\frac{1}{2}(x+2)" :db/ensure [:answer/validate]} {:db/id "answer-d66fd6b4-e28d-5784-baa5-fca15655be5d" :answer/id #uuid "d66fd6b4-e28d-5784-baa5-fca15655be5d" :answer/type :answer.type/math :answer/value "y+5=\\frac{1}{2}(x-2)" :db/ensure [:answer/validate]} {:db/id "answer-0e6ea26b-1620-506e-bb8e-3fda206f1449" :answer/id #uuid "0e6ea26b-1620-506e-bb8e-3fda206f1449" :answer/type :answer.type/math :answer/value "y-5=-2(x-2)" :db/ensure [:answer/validate]} {:db/id "answer-ec9e1392-f368-5bc7-8108-b97f862345cb" :answer/id #uuid "ec9e1392-f368-5bc7-8108-b97f862345cb" :answer/type :answer.type/math :answer/value "y-5=\\frac{1}{2}(x-2)" :db/ensure [:answer/validate]} {:db/id "question-99417d8d-1f43-5c3e-b523-0e838b0c9470" :question/id #uuid "99417d8d-1f43-5c3e-b523-0e838b0c9470" :question/math-academy-id "q-214816" :question/problem "Find the equation of the line that passes through the points $(-1,3)$ and $(1,-1)$ in slope-intercept form.\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-1-3}{1-(-1)}=\\frac{-4}{2}=-2\\end{aligned}\n$$\n\nThen, we substitute $m=-2$ and the point $({x}_{1},{y}_{1})=(-1,3)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =-2(x-(-1)) \\\\ y-3 & =-2(x+1)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-3 & =-2(x+1) \\\\ y-3 & =-2x-2 \\\\ y & =-2x+1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-68338326-c1a2-58f1-99c1-2c91100253f4"] :db/ensure [:question/validate]} {:db/id "answer-field-68338326-c1a2-58f1-99c1-2c91100253f4" :answer-field/id #uuid "68338326-c1a2-58f1-99c1-2c91100253f4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-207dcff7-2a4a-5821-bc2b-8c5f4d988663" :answer-field/choices ["answer-207dcff7-2a4a-5821-bc2b-8c5f4d988663"] :db/ensure [:answer-field/validate]} {:db/id "answer-207dcff7-2a4a-5821-bc2b-8c5f4d988663" :answer/id #uuid "207dcff7-2a4a-5821-bc2b-8c5f4d988663" :answer/type :answer.type/math :answer/value "-2x+1" :db/ensure [:answer/validate]} {:db/id "question-72696385-5600-5d16-af0f-e8ec844daceb" :question/id #uuid "72696385-5600-5d16-af0f-e8ec844daceb" :question/math-academy-id "q-208825" :question/problem "Find the equation of the line that passes through the points $(3,9)$ and $(-1,1)$ in slope-intercept form.\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{1-9}{-1-3}=\\frac{(-8)}{(-4)}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $({x}_{1},{y}_{1})=(3,9)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-9 & =2(x-3)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-9 & =2(x-3) \\\\ y-9 & =2x-6 \\\\ y & =2x+3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-79f5ca2c-25ad-5180-8b08-53622da5ba2f"] :db/ensure [:question/validate]} {:db/id "answer-field-79f5ca2c-25ad-5180-8b08-53622da5ba2f" :answer-field/id #uuid "79f5ca2c-25ad-5180-8b08-53622da5ba2f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4822ab40-7aab-5223-856b-eb74b6098f13" :answer-field/choices ["answer-4822ab40-7aab-5223-856b-eb74b6098f13"] :db/ensure [:answer-field/validate]} {:db/id "answer-4822ab40-7aab-5223-856b-eb74b6098f13" :answer/id #uuid "4822ab40-7aab-5223-856b-eb74b6098f13" :answer/type :answer.type/math :answer/value "2x+3" :db/ensure [:answer/validate]} {:db/id "question-1abe194d-a2aa-502b-8bc6-8f34c848d468" :question/id #uuid "1abe194d-a2aa-502b-8bc6-8f34c848d468" :question/math-academy-id "q-214728" :question/problem "Find the equation of the line that passes through the points $(-1,-2)$ and $(1,6)$ in slope-intercept form.\n\n$y=$\n{{field-1}}" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{6-(-2)}{1-(-1)}=\\frac{8}{2}=4\\end{aligned}\n$$\n\nThen, we substitute $m=4$ and the point $({x}_{1},{y}_{1})=(-1,-2)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-2) & =4(x-(-1)) \\\\ y+2 & =4(x+1)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y+2 & =4(x+1) \\\\ y+2 & =4x+4 \\\\ y & =4x+2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-465d1bc4-47b8-5cbb-b52f-bea13086b22b"] :db/ensure [:question/validate]} {:db/id "answer-field-465d1bc4-47b8-5cbb-b52f-bea13086b22b" :answer-field/id #uuid "465d1bc4-47b8-5cbb-b52f-bea13086b22b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6d1ce7d2-544c-50a9-85bf-fd974a0a3b42" :answer-field/choices ["answer-6d1ce7d2-544c-50a9-85bf-fd974a0a3b42"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d1ce7d2-544c-50a9-85bf-fd974a0a3b42" :answer/id #uuid "6d1ce7d2-544c-50a9-85bf-fd974a0a3b42" :answer/type :answer.type/math :answer/value "4x+2" :db/ensure [:answer/validate]} {:db/id "question-2e072874-ed7d-544d-b970-83b9972e3853" :question/id #uuid "2e072874-ed7d-544d-b970-83b9972e3853" :question/math-academy-id "q-6961" :question/problem "Calculate the equation of the line that passes through the points $(4,-8)$ and $(8,-6).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{-6-(-8)}{8-4}=\\frac{2}{4}=\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we substitute $m=\\frac{1}{2}$ and the point $({x}_{1},{y}_{1})=(4,-8)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(-8) & =\\frac{1}{2}(x-4) \\\\ y+8 & =\\frac{1}{2}(x-4)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y+8 & =\\frac{1}{2}(x-4) \\\\ y & =\\frac{1}{2}x-2-8 \\\\ y & =\\frac{1}{2}x-10\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5de665dd-f29e-539e-8a46-95e8ce6236b6"] :db/ensure [:question/validate]} {:db/id "answer-field-5de665dd-f29e-539e-8a46-95e8ce6236b6" :answer-field/id #uuid "5de665dd-f29e-539e-8a46-95e8ce6236b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6069335e-9e96-5a4b-bd51-aa204023de51" :answer-field/choices ["answer-cfd4de3e-f16e-587b-8fff-834db60b6152" "answer-231007f9-fa46-5595-92f6-2753afa91277" "answer-6069335e-9e96-5a4b-bd51-aa204023de51" "answer-1efc3ce2-0a63-5cfb-8835-3f5803d08c8b" "answer-77b71fe4-fa6b-54a9-9d1e-27398fe4f01d"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfd4de3e-f16e-587b-8fff-834db60b6152" :answer/id #uuid "cfd4de3e-f16e-587b-8fff-834db60b6152" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}x+8" :db/ensure [:answer/validate]} {:db/id "answer-231007f9-fa46-5595-92f6-2753afa91277" :answer/id #uuid "231007f9-fa46-5595-92f6-2753afa91277" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{2}x-6" :db/ensure [:answer/validate]} {:db/id "answer-6069335e-9e96-5a4b-bd51-aa204023de51" :answer/id #uuid "6069335e-9e96-5a4b-bd51-aa204023de51" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}x-10" :db/ensure [:answer/validate]} {:db/id "answer-1efc3ce2-0a63-5cfb-8835-3f5803d08c8b" :answer/id #uuid "1efc3ce2-0a63-5cfb-8835-3f5803d08c8b" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}x-6" :db/ensure [:answer/validate]} {:db/id "answer-77b71fe4-fa6b-54a9-9d1e-27398fe4f01d" :answer/id #uuid "77b71fe4-fa6b-54a9-9d1e-27398fe4f01d" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}x-8" :db/ensure [:answer/validate]} {:db/id 17592186069484 :question/problem "Calculate the equation of the line that passes through the points $(2,8)$ and $(3,12).$" :question/worked-solution "First, we will construct the point-slope formula for the line. Then, we will simplify the point-slope formula into slope-intercept form.\n\nWe start by computing the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{12-8}{3-2}=\\frac{4}{1}=4\\end{aligned}\n$$\n\nThen, we substitute $m=4$ and the point $({x}_{1},{y}_{1})=(2,8)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-8 & =4(x-2)\\end{aligned}\n$$\n\nFinally, we simplify the equation into slope-intercept form:\n\n$$\n\\begin{aligned}y-8 & =4(x-2) \\\\ y-8 & =4x-8 \\\\ y & =4x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186068074 :answer-field/correct "answer-1be9dfca-ad6d-55f8-a27a-c47fc7dba344" :answer-field/choices ["answer-22e3c124-d858-516c-bd1f-73e8c8a29884" "answer-1be9dfca-ad6d-55f8-a27a-c47fc7dba344" "answer-a7622c0b-7c82-500c-b2dc-311ab63b4b53" "answer-2ba31689-999b-5f9d-83d9-0bdce6160dc9" "answer-47a03e36-983a-5144-8158-42c2893f5e42"] :db/ensure [:answer-field/validate]} {:db/id "answer-22e3c124-d858-516c-bd1f-73e8c8a29884" :answer/id #uuid "22e3c124-d858-516c-bd1f-73e8c8a29884" :answer/type :answer.type/math :answer/value "y=-4x+2" :db/ensure [:answer/validate]} {:db/id "answer-1be9dfca-ad6d-55f8-a27a-c47fc7dba344" :answer/id #uuid "1be9dfca-ad6d-55f8-a27a-c47fc7dba344" :answer/type :answer.type/math :answer/value "y=4x" :db/ensure [:answer/validate]} {:db/id "answer-a7622c0b-7c82-500c-b2dc-311ab63b4b53" :answer/id #uuid "a7622c0b-7c82-500c-b2dc-311ab63b4b53" :answer/type :answer.type/math :answer/value "y=4x+16" :db/ensure [:answer/validate]} {:db/id "answer-2ba31689-999b-5f9d-83d9-0bdce6160dc9" :answer/id #uuid "2ba31689-999b-5f9d-83d9-0bdce6160dc9" :answer/type :answer.type/math :answer/value "y=4x+8" :db/ensure [:answer/validate]} {:db/id "answer-47a03e36-983a-5144-8158-42c2893f5e42" :answer/id #uuid "47a03e36-983a-5144-8158-42c2893f5e42" :answer/type :answer.type/math :answer/value "y=4x-8" :db/ensure [:answer/validate]} {:db/id 17592186070020 :tutorial/content "The **point-slope form** of a line that passes through any point $(x_1,y_1)$ with slope $m$ is given by \n\n$$\ny - y_1 = m(x-x_1).\n$$\n\n \n\nFor example, consider the straight line graph which passes through the points $(3,1)$ and $(5,5)$, as shown below.\n\n![](images/e7/e7838ffcb8f56ebffd384763ff761990e15031bdc5cdf3f0cc1f964ed69a4806.png)\n\nWe know that the line passes through the point $(3,1),$ so we can use $(x_1,y_1) = (3,1)$ in our point-slope formula. All that remains is to compute $m,$ and we can do this using the given points.\n\nFirst, calculate the slope $m$ using the given points:\n\n$$\n\\begin{aligned}m=\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}=\\frac{5-1}{5-3}=\\frac{4}{2}=2\\end{aligned}\n$$\n\nThen, we substitute $m=2$ and the point $(x_1,y_1) = (3,1)$ into the point-slope formula:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =2(x-3)\\end{aligned}\n$$\n\n**Note:** If we simplify this point-slope formula, we obtain the slope-intercept form of the line:\n\n$$\n\\begin{aligned}y-1 & =2(x-3) \\\\ y-1 & =2x-6 \\\\ y & =2x-5\\end{aligned}\n$$\n\n**Watch out!** We could put $(x_1,y_1)=(5,5).$ In this case, the point-slope form will be different:\n\n$$\ny-5=2(x-5)\n$$\n\n \nBut the resulting simplified slope-intercept form will be the same:\n\n$$\ny = 2x-5\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186068952 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186059872 :knowledge-point/questions ["question-a9ff2349-1642-5382-b4f9-c933719264f8" "question-5e868859-21b4-5f20-9f22-0cddcbf3cad1" "question-76938b4e-105e-5154-bb98-2d69e1b55721"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a9ff2349-1642-5382-b4f9-c933719264f8" :question/id #uuid "a9ff2349-1642-5382-b4f9-c933719264f8" :question/math-academy-id "q-68085" :question/problem "${0.5}^{4}\\times {0.5}^{3}=$" :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n{0.5}^{4}\\times {0.5}^{3}={0.5}^{4+3}={0.5}^{7}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-80d1a1c1-0916-5f56-adee-bf52aac52da7"] :db/ensure [:question/validate]} {:db/id "answer-field-80d1a1c1-0916-5f56-adee-bf52aac52da7" :answer-field/id #uui