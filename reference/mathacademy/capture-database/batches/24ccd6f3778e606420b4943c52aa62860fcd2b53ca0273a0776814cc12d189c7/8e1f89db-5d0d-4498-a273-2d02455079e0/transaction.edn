icular bisector theorem, a point on the perpendicular bisector of a segment is equidistant from the endpoints of the segment. Hence, we have:\n\n$$\n\\begin{aligned}IK & =HK \\\\ 6x & =x+15 \\\\ 5x & =15 \\\\ x & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fcc80986-63c9-5ed4-a914-56e583cbd0b7"] :db/ensure [:question/validate]} {:db/id "answer-field-fcc80986-63c9-5ed4-a914-56e583cbd0b7" :answer-field/id #uuid "fcc80986-63c9-5ed4-a914-56e583cbd0b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea6e1a7b-5c3a-577c-8c3e-5fedad81f298" :answer-field/choices ["answer-ea6e1a7b-5c3a-577c-8c3e-5fedad81f298" "answer-9043eb09-5c98-5a0d-a89a-90e1157451d5" "answer-a19659cb-9c4f-544c-a689-421353fd8547" "answer-587a11f5-91b9-543b-83df-104503724d1a" "answer-7149e5d7-63fb-5090-8255-995e4851d1f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea6e1a7b-5c3a-577c-8c3e-5fedad81f298" :answer/id #uuid "ea6e1a7b-5c3a-577c-8c3e-5fedad81f298" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-9043eb09-5c98-5a0d-a89a-90e1157451d5" :answer/id #uuid "9043eb09-5c98-5a0d-a89a-90e1157451d5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-a19659cb-9c4f-544c-a689-421353fd8547" :answer/id #uuid "a19659cb-9c4f-544c-a689-421353fd8547" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-587a11f5-91b9-543b-83df-104503724d1a" :answer/id #uuid "587a11f5-91b9-543b-83df-104503724d1a" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-7149e5d7-63fb-5090-8255-995e4851d1f4" :answer/id #uuid "7149e5d7-63fb-5090-8255-995e4851d1f4" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-73bc99c1-88cb-54fb-b573-fbe1a7f6c64f" :question/id #uuid "73bc99c1-88cb-54fb-b573-fb