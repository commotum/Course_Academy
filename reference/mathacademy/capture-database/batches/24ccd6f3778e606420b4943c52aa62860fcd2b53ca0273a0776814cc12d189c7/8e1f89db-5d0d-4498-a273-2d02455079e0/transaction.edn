2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-46062d93-4bff-52f8-b4f2-0ec7ec1064b3"] :db/ensure [:question/validate]} {:db/id "answer-field-46062d93-4bff-52f8-b4f2-0ec7ec1064b3" :answer-field/id #uuid "46062d93-4bff-52f8-b4f2-0ec7ec1064b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f0e5641-fd54-5105-9e73-ce978c7d8145" :answer-field/choices ["answer-222ce290-1666-5dd8-a4b3-ca36689d640a" "answer-9f0e5641-fd54-5105-9e73-ce978c7d8145" "answer-3b0cb231-f9ff-5a2e-b777-ccb3dfb52924" "answer-c320ad97-800d-5156-b9cb-5328ee1dc3a9" "answer-1ba39861-7e89-5dd9-ac62-fccad7c9a412"] :db/ensure [:answer-field/validate]} {:db/id "answer-222ce290-1666-5dd8-a4b3-ca36689d640a" :answer/id #uuid "222ce290-1666-5dd8-a4b3-ca36689d640a" :answer/type :answer.type/math :answer/value "(-0.1)^{-4}" :db/ensure [:answer/validate]} {:db/id "answer-9f0e5641-fd54-5105-9e73-ce978c7d8145" :answer/id #uuid "9f0e5641-fd54-5105-9e73-ce978c7d8145" :answer/type :answer.type/math :answer/value "(-0.1)^{12}" :db/ensure [:answer/validate]} {:db/id "answer-3b0cb231-f9ff-5a2e-b777-ccb3dfb52924" :answer/id #uuid "3b0cb231-f9ff-5a2e-b777-ccb3dfb52924" :answer/type :answer.type/math :answer/value "(-0.2)^{12}" :db/ensure [:answer/validate]} {:db/id "answer-c320ad97-800d-5156-b9cb-5328ee1dc3a9" :answer/id #uuid "c320ad97-800d-5156-b9cb-5328ee1dc3a9" :answer/type :answer.type/math :answer/value "(-0.2)^{32}" :db/ensure [:answer/validate]} {:db/id "answer-1ba39861-7e89-5dd9-ac62-fccad7c9a412" :answer/id #uuid "1ba39861-7e89-5dd9-ac62-fccad7c9a412" :answer/type :answer.type/math :answer/value "(0.01)^{32}" :db/ensure [:answer/validate]} {:db/id "activity-8b3faeae-6c35-5860-95f9-90130bbf5d13" :activity/id #uuid "8b3faeae-6c35-5860-95f9-90130bbf5d13" :activity/title "The Product Rule for Exponents" :activity/type :activity.type/review :activity/scope 17592186050668 :activity/course 17592186046648 :activity/steps ["step-e11488a6-d8f0-50d2-ad70-11a4ce4e70f1" "step-a6234d24-a70a-501b-9808-f7a204e32f4a" "step-5cf1d280-8831-501f-a854-578009ed3dbd"] :activity/first-step "step-e11488a6-d8f0-50d2-ad70-11a4ce4e70f1" :db/ensure [:activity/validate]} {:db/id "step-e11488a6-d8f0-50d2-ad70-11a4ce4e70f1" :step/id #uuid "e11488a6-d8f0-50d2-ad70-11a4ce4e70f1" :step/content "question-a9ff2349-1642-5382-b4f9-c933719264f8" :step/next "step-a6234d24-a70a-501b-9808-f7a204e32f4a" :db/ensure [:step/validate]} {:db/id "step-a6234d24-a70a-501b-9808-f7a204e32f4a" :step/id #uuid "a6234d24-a70a-501b-9808-f7a204e32f4a" :step/content "question-5e868859-21b4-5f20-9f22-0cddcbf3cad1" :step/next "step-5cf1d280-8831-501f-a854-578009ed3dbd" :db/ensure [:step/validate]} {:db/id "step-5cf1d280-8831-501f-a854-578009ed3dbd" :step/id #uuid "5cf1d280-8831-501f-a854-578009ed3dbd" :step/content "question-76938b4e-105e-5154-bb98-2d69e1b55721" :db/ensure [:step/validate]} [:db/retract 17592186188924 :question/answer-fields 17592186187620] {:db/id 17592186188261 :knowledge-point/questions ["question-f0e7b715-b8f5-546c-8370-11eb96261ecd" "question-0f1a69d2-da4d-539f-85b3-5e00cfab3ac7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188281 :knowledge-point/questions ["question-c619e065-6d72-5648-a786-860dc455f368" "question-a90e4a0d-4779-5458-9918-a30c4fa7517b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188273 :knowledge-point/questions ["question-52e3deff-a33f-5133-be77-3539d124a1dd" "question-e76412ff-223a-5baa-b8c0-73f134709b3d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188207 :question/problem "Let $\\mathbf{T}: \\mathbb{R}^4 \\rightarrow \\mathbb{R}^4$ be a linear transformation whose standard matrix is $T,$ and let $\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3 \\}$ be a set of linearly independent vectors in $\\mathbb{R}^4.$ Consider the following statement:\n\n*If  $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3\\}$, then $\\textrm{__________}.$ *\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $\\textrm{rank}(T)=3$\n\nII. $\\textrm{nullity}(\\mathbf{T})=3$\n\nIII. $\\mathbf{T}$ is a bijection" :question/worked-solution "Since $\\mathbf{T}$ is a linear transformation from $\\mathbb{R}^4$ into $\\mathbb{R}^4,$ the invertible matrix theorem states the following:\n\n $\\mathbf{T}$ is a bijection (an invertible transformation) ![](images/5d/5d330995eaf0f71f9006f897a75e9e892caecb94eb8c8b48d7ba7f116633b6e3.svg) \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = 4.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3\\}$ and the set $\\{ \\mathbf{v}_1, \\mathbf{v}_2, \\mathbf{v}_3 \\}$ is linearly independent, we get that $\\textrm{rank}(T)=\\textrm{rank}(\\mathbf{T})=3.$\n\n- Statement II is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =4-\\text{rank}(T) \\\\  & =4-3 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement III is false. Since $\\textrm{rank}(\\mathbf{T}) \\neq 4$ (or since $\\textrm{nullity}(\\mathbf{T}) \\neq 0$), the linear transformation $\\mathbf{T}$ cannot be a bijection according to the invertible matrix theorem.\n\nTherefore, the correct option is \"I only.\"" :db/ensure [:question/validate]} {:db/id "question-f0e7b715-b8f5-546c-8370-11eb96261ecd" :question/id #uuid "f0e7b715-b8f5-546c-8370-11eb96261ecd" :question/math-academy-id "q-84054" :question/problem "Consider a linear transformation $T:{R}^{6}\\to {R}^{6}.$ If $\\text{nullity}(T)=0$ then $\\text{rank}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=6.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ \\text{rank}(T)+0 & =6 \\\\ \\text{rank}(T) & =6-0 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e6a1b3a9-cf8a-56c9-b44f-3a84bdac3d50"] :db/ensure [:question/validate]} {:db/id "answer-field-e6a1b3a9-cf8a-56c9-b44f-3a84bdac3d50" :answer-field/id #uuid "e6a1b3a9-cf8a-56c9-b44f-3a84bdac3d50" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-31a74265-ac02-58e5-96a3-8af498759acb" :answer-field/choices ["answer-991369ce-452a-5ef2-95ba-e3a495f00ee7" "answer-0ece1630-5fc9-5fa3-bff5-c3877dbe20e0" "answer-f5f5c64c-d239-5fc6-a10c-ef12ea321845" "answer-a5b11d96-fc0e-5fe3-ba6f-917cc5262380" "answer-31a74265-ac02-58e5-96a3-8af498759acb"] :db/ensure [:answer-field/validate]} {:db/id "answer-991369ce-452a-5ef2-95ba-e3a495f00ee7" :answer/id #uuid "991369ce-452a-5ef2-95ba-e3a495f00ee7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-0ece1630-5fc9-5fa3-bff5-c3877dbe20e0" :answer/id #uuid "0ece1630-5fc9-5fa3-bff5-c3877dbe20e0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-f5f5c64c-d239-5fc6-a10c-ef12ea321845" :answer/id #uuid "f5f5c64c-d239-5fc6-a10c-ef12ea321845" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-a5b11d96-fc0e-5fe3-ba6f-917cc5262380" :answer/id #uuid "a5b11d96-fc0e-5fe3-ba6f-917cc5262380" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-31a74265-ac02-58e5-96a3-8af498759acb" :answer/id #uuid "31a74265-ac02-58e5-96a3-8af498759acb" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-0f1a69d2-da4d-539f-85b3-5e00cfab3ac7" :question/id #uuid "0f1a69d2-da4d-539f-85b3-5e00cfab3ac7" :question/math-academy-id "q-141430" :question/problem "Consider a linear transformation $T:{R}^{5}\\to {R}^{5}.$ If $\\text{rank}(T)=1$ then $\\text{nullity}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=5.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ 1+\\text{nullity}(T) & =5 \\\\ \\text{nullity}(T) & =5-1 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a7254d97-c107-5cd3-ac3d-c4b19a9b8902"] :db/ensure [:question/validate]} {:db/id "answer-field-a7254d97-c107-5cd3-ac3d-c4b19a9b8902" :answer-field/id #uuid "a7254d97-c107-5cd3-ac3d-c4b19a9b8902" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d2566bb9-7c8f-5410-8d5b-d5a4770b8c9d" :answer-field/choices ["answer-03f43a18-d791-5a02-801f-df3387b654f5" "answer-d2566bb9-7c8f-5410-8d5b-d5a4770b8c9d" "answer-b3e0c222-dde9-50f4-9203-5e6c0c0f12c7" "answer-f9bcdef5-3329-5d37-abe0-e83d65624660" "answer-6a246604-aaa7-55b5-bab5-a4f06f9cea5a"] :db/ensure [:answer-field/validate]} {:db/id "answer-03f43a18-d791-5a02-801f-df3387b654f5" :answer/id #uuid "03f43a18-d791-5a02-801f-df3387b654f5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-d2566bb9-7c8f-5410-8d5b-d5a4770b8c9d" :answer/id #uuid "d2566bb9-7c8f-5410-8d5b-d5a4770b8c9d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-b3e0c222-dde9-50f4-9203-5e6c0c0f12c7" :answer/id #uuid "b3e0c222-dde9-50f4-9203-5e6c0c0f12c7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-f9bcdef5-3329-5d37-abe0-e83d65624660" :answer/id #uuid "f9bcdef5-3329-5d37-abe0-e83d65624660" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-6a246604-aaa7-55b5-bab5-a4f06f9cea5a" :answer/id #uuid "6a246604-aaa7-55b5-bab5-a4f06f9cea5a" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186188981 :question/problem "Consider a linear transformation $T:{R}^{7}\\to {R}^{7}.$ If $\\text{rank}(T)=3$ then $\\text{nullity}(T)=$" :question/worked-solution "According to the rank-nullity theorem, if $T:{R}^{n}\\to {R}^{n},$ then\n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=n.\n$$\n\nFor the given transformation, we have $n=7.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(T)+\\text{nullity}(T) & =n \\\\ 3+\\text{nullity}(T) & =7 \\\\ \\text{nullity}(T) & =7-3 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186187962 :answer-field/correct 17592186187964 :db/ensure [:answer-field/validate]} {:db/id "question-c619e065-6d72-5648-a786-860dc455f368" :question/id #uuid "c619e065-6d72-5648-a786-860dc455f368" :question/math-academy-id "q-141434" :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{5}\\to {R}^{5}$ and $\\text{Im}(T)=\\{[x,y,z,u,v]^{T}\\,:\\,x-2y=0,\\,3u+v=0\\}.$" :question/worked-solution "Solving $x-2y=0$ for $x,$ we get $x=2y.$ Solving $3u+v=0$ for $v,$ we get $v=-3u.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}2y \\\\ y \\\\ z \\\\ u \\\\ -3u\\end{aligned}]=y{{[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{2}}+u{{[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 1 \\\\ -3\\end{aligned}]}_{⏟}}_{{v}_{3}}\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\}.$ Therefore, $\\text{rank}(T)=3.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =5-\\text{rank}(T) \\\\  & =5-3 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-df557d07-88b6-5980-91f5-1e6a3fe0da71"] :db/ensure [:question/validate]} {:db/id "answer-field-df557d07-88b6-5980-91f5-1e6a3fe0da71" :answer-field/id #uuid "df557d07-88b6-5980-91f5-1e6a3fe0da71" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f354c6d-accd-573b-b23d-3f21af38a5ba" :answer-field/choices ["answer-a71d7da3-cf8a-575a-8186-3190e30287fe" "answer-9f354c6d-accd-573b-b23d-3f21af38a5ba" "answer-ee0ce244-827d-597e-bf10-65d70b6ac24b" "answer-1ecb0cc3-afd8-5a46-bd9d-b371a0254225" "answer-39053542-c293-5a9e-ac44-450935d27710"] :db/ensure [:answer-field/validate]} {:db/id "answer-a71d7da3-cf8a-575a-8186-3190e30287fe" :answer/id #uuid "a71d7da3-cf8a-575a-8186-3190e30287fe" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-9f354c6d-accd-573b-b23d-3f21af38a5ba" :answer/id #uuid "9f354c6d-accd-573b-b23d-3f21af38a5ba" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-ee0ce244-827d-597e-bf10-65d70b6ac24b" :answer/id #uuid "ee0ce244-827d-597e-bf10-65d70b6ac24b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-1ecb0cc3-afd8-5a46-bd9d-b371a0254225" :answer/id #uuid "1ecb0cc3-afd8-5a46-bd9d-b371a0254225" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-39053542-c293-5a9e-ac44-450935d27710" :answer/id #uuid "39053542-c293-5a9e-ac44-450935d27710" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-a90e4a0d-4779-5458-9918-a30c4fa7517b" :question/id #uuid "a90e4a0d-4779-5458-9918-a30c4fa7517b" :question/math-academy-id "q-141437" :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{5}\\to {R}^{5}$ and $\\text{Ker}(T)=\\{[x,y,z,u,v]^{T}\\,:\\,x-2v=0,\\,u=0\\}.$" :question/worked-solution "Solving $x-2v=0$ for $x,$ we get $x=2v.$ Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}2v \\\\ y \\\\ z \\\\ 0 \\\\ v\\end{aligned}]=y{{[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{2}}+v{{[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{3}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\}.$ Therefore, $\\text{nullity}(T)=3.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =5-\\text{nullity}(T) \\\\  & =5-3 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-873870cb-4f04-54ab-9bd6-a01e9f25ce5f"] :db/ensure [:question/validate]} {:db/id "answer-field-873870cb-4f04-54ab-9bd6-a01e9f25ce5f" :answer-field/id #uuid "873870cb-4f04-54ab-9bd6-a01e9f25ce5f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77afe151-5f72-5b97-89d9-53d0a85f7dcd" :answer-field/choices ["answer-2f4a310e-9fad-5e19-bae2-5bbe90f27a14" "answer-77afe151-5f72-5b97-89d9-53d0a85f7dcd" "answer-18bfa1fb-ec39-5e06-aa2f-27a24093c541" "answer-0eb9bce1-0297-53c0-a167-65429a68ca75" "answer-d70a1b7e-3b63-5d89-abf8-bbeae48c9ac4"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f4a310e-9fad-5e19-bae2-5bbe90f27a14" :answer/id #uuid "2f4a310e-9fad-5e19-bae2-5bbe90f27a14" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-77afe151-5f72-5b97-89d9-53d0a85f7dcd" :answer/id #uuid "77afe151-5f72-5b97-89d9-53d0a85f7dcd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-18bfa1fb-ec39-5e06-aa2f-27a24093c541" :answer/id #uuid "18bfa1fb-ec39-5e06-aa2f-27a24093c541" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-0eb9bce1-0297-53c0-a167-65429a68ca75" :answer/id #uuid "0eb9bce1-0297-53c0-a167-65429a68ca75" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-d70a1b7e-3b63-5d89-abf8-bbeae48c9ac4" :answer/id #uuid "d70a1b7e-3b63-5d89-abf8-bbeae48c9ac4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186188982 :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{4}\\to {R}^{4}$ and \n\n$$\n\\text{Ker}(T)=\\{[x,y,z,w]^{T}\\,:\\,x+y+z=0,\\,2x-y-w=0\\}.\n$$" :question/worked-solution "Solving $x+y+z=0$ for $z,$ we get $z=-x-y.$ Solving $2x-y-w=0$ for $w,$ we get $w=2x-y.$  Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ 2x-y \\\\ -x-y\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 2 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ -1 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =4-\\text{nullity}(T) \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186187968 :answer-field/correct 17592186187971 :db/ensure [:answer-field/validate]} {:db/id 17592186188924 :question/problem "Find $\\text{nullity}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and \n\n$$\n\\text{Im}(T)=\\{[x,y,z]^{T}\\,:\\,-x+z=0\\}.\n$$" :question/worked-solution "Solving $-x+z=0$ for $z,$ we get $z=x.$ Therefore, any vector from $\\text{Im}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ x\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Im}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{rank}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186406842 :question/problem "Find $\\text{rank}(T)$ given that $T:{R}^{3}\\to {R}^{3}$ and $\\text{Ker}(T)=\\{[x,y,z]^{T}\\,:\\,x+y+z=0\\}.$" :question/worked-solution "Solving $x+y+z=0$ for $z,$ we get $z=-x-y.$ Therefore, any vector from $\\text{Ker}(T)$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ -x-y\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{1}}+y{{[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\text{Ker}(T)=\\text{Span}\\{{v}_{1},{v}_{2}\\}.$ Therefore, $\\text{nullity}(T)=2.$ \n\nFinally, according the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(T) & =3-\\text{nullity}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-52e3deff-a33f-5133-be77-3539d124a1dd" :question/id #uuid "52e3deff-a33f-5133-be77-3539d124a1dd" :question/math-academy-id "q-38146" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation with standard matrix $T$ whose columns are ${v}_{1},$\n ${v}_{2},$ and  ${v}_{3}.$\n\n*If  $\\text{dim}(\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\})=1$, then $\\text{__________}.$ *\n\nWhich of the following, if inserted into the blank space, would lead to a true statement?\n\nI. $\\text{nullity}(T)=2$\n\nII. ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0$ has only the trivial solution\n\nIII. $\\text{rank}(T)=2$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $\\text{dim}(\\text{span}\\{{v}_{1},{v}_{2},{v}_{3}\\})=1$ this means that $\\text{rank}(T)=1.$ According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\nAlso, according to the invertible matrix theorem the linear transformation $T$ cannot be a bijection.\n\n- Statement II is false. Notice that ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0$ is equivalent to $Tx=0.$ Since $T$ is not invertible, the equation has non-trivial solutions.\n\n- Statement III is false. From statement I, $\\text{rank}(T)=1.$\n\nTherefore, the correct option is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9ef148dd-6753-5ef9-9d57-5a47223ec593"] :db/ensure [:question/validate]} {:db/id "answer-field-9ef148dd-6753-5ef9-9d57-5a47223ec593" :answer-field/id #uuid "9ef148dd-6753-5ef9-9d57-5a47223ec593" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b54b975-97e0-5630-a090-aee094b6f975" :answer-field/choices ["answer-8198ad48-3fde-56ad-875f-2629a469e0c0" "answer-3b54b975-97e0-5630-a090-aee094b6f975" "answer-9dc05555-6a06-512b-99ec-1c0211b082fd" "answer-da447d07-58e2-5574-841d-f2cf464005db" "answer-a5c9c60f-e173-5835-8474-cd48d43dde3c"] :db/ensure [:answer-field/validate]} {:db/id "answer-8198ad48-3fde-56ad-875f-2629a469e0c0" :answer/id #uuid "8198ad48-3fde-56ad-875f-2629a469e0c0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-3b54b975-97e0-5630-a090-aee094b6f975" :answer/id #uuid "3b54b975-97e0-5630-a090-aee094b6f975" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-9dc05555-6a06-512b-99ec-1c0211b082fd" :answer/id #uuid "9dc05555-6a06-512b-99ec-1c0211b082fd" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-da447d07-58e2-5574-841d-f2cf464005db" :answer/id #uuid "da447d07-58e2-5574-841d-f2cf464005db" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-a5c9c60f-e173-5835-8474-cd48d43dde3c" :answer/id #uuid "a5c9c60f-e173-5835-8474-cd48d43dde3c" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "question-e76412ff-223a-5baa-b8c0-73f134709b3d" :question/id #uuid "e76412ff-223a-5baa-b8c0-73f134709b3d" :question/math-academy-id "q-84061" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T.$ Which of the following statements are true?\n\nI. $\\text{rank}(T)=\\text{nullity}(T)=3$\n\nII. If $v=[1,0,0]^{T}$ is a solution of $T(x)=0$ then $T$ is invertible.\n\nIII. If there is not $u\\in {R}^{3}$ such that $T(u)=[1,0,0]^{T},$ then $\\text{rank}(T)=3.$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nAlso, according to the rank-nullity theorem, \n\n$$\n\\text{rank}(T)+\\text{nullity}(T)=3.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. According to the rank-nullity theorem, we obtain \n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-3 \\\\  & =0 \\\\  & \\ne 3.\\end{aligned}\n$$\n\n- Statement II is false. Since $v$ is a solution of $T(x)=0$, we have that $T(v)=0.$ Therefore $v\\in \\text{Ker}(T),$ thus according to the invertible matrix theorem $T$ is not invertible.\n\n- Statement III is false. Since there is not $u\\in {R}^{3}$ such that $T(u)=[1,0,0]^{T},$ we have that $T$ is not  a bijection (an invertible transformation). According to the invertible matrix theorem, $\\text{rank}(T)\\ne 3.$\n\nTherefore, the correct option is \"None of the statements are true.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e5c9d97c-c13f-5d1d-806f-0620d8934268"] :db/ensure [:question/validate]} {:db/id "answer-field-e5c9d97c-c13f-5d1d-806f-0620d8934268" :answer-field/id #uuid "e5c9d97c-c13f-5d1d-806f-0620d8934268" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-96f2b9de-077d-5cf3-a270-01b08efe97fe" :answer-field/choices ["answer-e046b8e1-07f1-59f1-8371-d26dc2d3848e" "answer-75c34ea7-fced-573f-ac33-5467b58565b2" "answer-6f245e34-a77e-597f-a14d-caed4ce72982" "answer-af2b2ba4-b180-5b0a-b84d-e9a4e5bcda0b" "answer-96f2b9de-077d-5cf3-a270-01b08efe97fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-e046b8e1-07f1-59f1-8371-d26dc2d3848e" :answer/id #uuid "e046b8e1-07f1-59f1-8371-d26dc2d3848e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-75c34ea7-fced-573f-ac33-5467b58565b2" :answer/id #uuid "75c34ea7-fced-573f-ac33-5467b58565b2" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-6f245e34-a77e-597f-a14d-caed4ce72982" :answer/id #uuid "6f245e34-a77e-597f-a14d-caed4ce72982" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-af2b2ba4-b180-5b0a-b84d-e9a4e5bcda0b" :answer/id #uuid "af2b2ba4-b180-5b0a-b84d-e9a4e5bcda0b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-96f2b9de-077d-5cf3-a270-01b08efe97fe" :answer/id #uuid "96f2b9de-077d-5cf3-a270-01b08efe97fe" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id 17592186189365 :tutorial/content "The **rank-nullity theorem in terms of linear transformations** states the following:\n\n*If $\\mathbf{T}:\\mathbb{R}^n \\to \\mathbb{R}^n$ is a linear transformation, then*\n\n$$\n\\textrm{dim(Im}(\\mathbf{T})) + \\textrm{dim(Ker}(\\mathbf{T})) = \\textrm{dim}(\\mathbb{R}^n),\n$$\n\n*or equivalently,*\n\n$$\n\\textrm{rank}(\\mathbf{T}) + \\textrm{nullity}(\\mathbf{T}) = n.\n$$\n\nFor example, suppose that $\\mathbf{T}:\\mathbb{R}^3\\to\\mathbb{R}^3$ is a linear transformation such that\n\n$$\n\\textrm{Im}(\\mathbf{T})=\\{ [ x, y, z ]^T \\, : \\, y+2z=0\\}.\n$$\n\nLet's use the rank-nullity theorem to compute $\\textrm{rank}(\\mathbf{T})$ and $\\text{nullity}(\\mathbf{T}).$ \n\nFirst, solving $y+2z=0$ for $y,$ we get $y = -2z.$ Therefore, any vector from $\\textrm{Im}(\\mathbf{T})$ can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ -2z \\\\ z\\end{aligned}]=x{{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{{v}_{1}}+z{{[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]}_{⏟}}_{{v}_{2}}.\\end{aligned}\n$$\n\nThis means that $\\textrm{Im}(\\mathbf{T})=\\textrm{Span}\\{\\mathbf{v}_1,\\mathbf{v}_2\\}.$ And since $\\mathbf v_1$ and $\\mathbf v_2$ are linearly independent, we have $\\textrm{rank}(\\mathbf{T})=2.$ \n\nFinally, using the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{nullity}(T) & =3-\\text{rank}(T) \\\\  & =3-2 \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186188448 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186178780 :answer-field/choices 17592186178781] [:db/retract 17592186178780 :answer-field/choices 17592186178783] {:db/id 17592186179628 :knowledge-point/questions ["question-e830f76b-5a84-5b55-8ce0-c003dd77dcc2" "question-baac7ae1-a07b-5049-b210-41cf170484ad"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e830f76b-5a84-5b55-8ce0-c003dd77dcc2" :question/id #uuid "e830f76b-5a84-5b55-8ce0-c003dd77dcc2" :question/math-academy-id "q-45293" :question/problem "If $\\frac{4kb}{3}=\\frac{3}{4},$ then $b=$" :question/worked-solution "We need to isolate $b.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{4kb}{3} & =\\frac{3}{4} \\\\ 4\\cdot 4kb & =3\\cdot 3 \\\\ 16kb & =9\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $16k:$\n\n$$\n\\begin{aligned}16kb & =9 \\\\ \\frac{16kb}{16k} & =\\frac{9}{16k} \\\\ \\frac{\\cancel{16k}b}{\\cancel{16k}} & =\\frac{9}{16k} \\\\ b & =\\frac{9}{16k}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dfc268ac-13af-5ab2-8208-3b471658735c"] :db/ensure [:question/validate]} {:db/id "answer-field-dfc268ac-13af-5ab2-8208-3b471658735c" :answer-field/id #uuid "dfc268ac-13af-5ab2-8208-3b471658735c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-832bdf00-a4ad-5f8c-bf5d-f4b3fb00505e" :answer-field/choices ["answer-7585635c-e1d7-5b96-94d0-5d364aaa613f" "answer-c5b49b76-ea76-5b4a-9b6a-b89c34045986" "answer-68462d68-12db-54b8-a746-2531c1eca657" "answer-832bdf00-a4ad-5f8c-bf5d-f4b3fb00505e" "answer-c0bc745d-c282-5d96-94ce-175a536badd8"] :db/ensure [:answer-field/validate]} {:db/id "answer-7585635c-e1d7-5b96-94d0-5d364aaa613f" :answer/id #uuid "7585635c-e1d7-5b96-94d0-5d364aaa613f" :answer/type :answer.type/math :answer/value "\\frac{1}{6k}" :db/ensure [:answer/validate]} {:db/id "answer-c5b49b76-ea76-5b4a-9b6a-b89c34045986" :answer/id #uuid "c5b49b76-ea76-5b4a-9b6a-b89c34045986" :answer/type :answer.type/math :answer/value "\\frac{7}{12k}" :db/ensure [:answer/validate]} {:db/id "answer-68462d68-12db-54b8-a746-2531c1eca657" :answer/id #uuid "68462d68-12db-54b8-a746-2531c1eca657" :answer/type :answer.type/math :answer/value "\\frac{9k}{16}" :db/ensure [:answer/validate]} {:db/id "answer-832bdf00-a4ad-5f8c-bf5d-f4b3fb00505e" :answer/id #uuid "832bdf00-a4ad-5f8c-bf5d-f4b3fb00505e" :answer/type :answer.type/math :answer/value "\\frac{9}{16k}" :db/ensure [:answer/validate]} {:db/id "answer-c0bc745d-c282-5d96-94ce-175a536badd8" :answer/id #uuid "c0bc745d-c282-5d96-94ce-175a536badd8" :answer/type :answer.type/math :answer/value "\\frac{9}{k}" :db/ensure [:answer/validate]} {:db/id 17592186180206 :question/problem "If $2lx=\\frac{6}{5},$ then $x=$" :question/worked-solution "First, we multiply both sides of the equation by $5$ to get rid of the fraction:\n\n$$\n\\begin{aligned}2lx & =\\frac{6}{5} \\\\ 5\\cdot 2lx & =5\\cdot \\frac{6}{5} \\\\ 10lx & =6\\end{aligned}\n$$\n\nNow, we need to isolate $x.$ To do this, we divide both sides of the equation by $10l:$\n\n$$\n\\begin{aligned}10lx & =6 \\\\ \\frac{10lx}{10l} & =\\frac{6}{10l} \\\\ \\frac{\\cancel{10l}x}{\\cancel{10l}} & =\\frac{6}{10l} \\\\ x & =\\frac{6}{10l}\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}x & =\\frac{2\\cdot 3}{2\\cdot 5l} \\\\ x & =\\frac{\\cancel{2}\\cdot 3}{\\cancel{2}\\cdot 5l} \\\\ x & =\\frac{3}{5l}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186178780 :answer-field/correct 17592186178785 :answer-field/choices ["answer-28347eb9-3aaa-5526-b6b3-b14025785b42" "answer-55468543-5feb-5a4e-9af4-c5b682e3a497"] :db/ensure [:answer-field/validate]} {:db/id "answer-28347eb9-3aaa-5526-b6b3-b14025785b42" :answer/id #uuid "28347eb9-3aaa-5526-b6b3-b14025785b42" :answer/type :answer.type/math :answer/value "3+5l" :db/ensure [:answer/validate]} {:db/id "answer-55468543-5feb-5a4e-9af4-c5b682e3a497" :answer/id #uuid "55468543-5feb-5a4e-9af4-c5b682e3a497" :answer/type :answer.type/math :answer/value "3-5l" :db/ensure [:answer/validate]} {:db/id "question-baac7ae1-a07b-5049-b210-41cf170484ad" :question/id #uuid "baac7ae1-a07b-5049-b210-41cf170484ad" :question/math-academy-id "q-45326" :question/problem "If $\\frac{5mg}{8}=\\frac{5}{2},$ then $g=$" :question/worked-solution "We need to isolate $g.$ To do this, we first cross-multiply:\n\n$$\n\\begin{aligned}\\frac{5mg}{8} & =\\frac{5}{2} \\\\ 2\\cdot 5mg & =8\\cdot 5 \\\\ 10mg & =40\\end{aligned}\n$$\n\nThen, we divide both sides of the equation by $10m:$\n\n$$\n\\begin{aligned}10mg & =40 \\\\ \\frac{10mg}{10m} & =\\frac{40}{10m} \\\\ \\frac{\\cancel{10m}g}{\\cancel{10m}} & =\\frac{40}{10m} \\\\ g & =\\frac{40}{10m}\\end{aligned}\n$$\n\nWe can further simplify the right-hand side as follows:\n\n$$\n\\begin{aligned}g & =\\frac{10\\cdot 4}{10m} \\\\ g & =\\frac{\\cancel{10}\\cdot 4}{\\cancel{10}m} \\\\ g & =\\frac{4}{m}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a40c5b5f-c277-58f8-b74e-f824cd64414a"] :db/ensure [:question/validate]} {:db/id "answer-field-a40c5b5f-c277-58f8-b74e-f824cd64414a" :answer-field/id #uuid "a40c5b5f-c277-58f8-b74e-f824cd64414a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-80e08489-6db6-5fff-889e-336e8aa7cbf9" :answer-field/choices ["answer-d4cce29f-595a-5529-a3ee-ff3b48c4d743" "answer-591dd984-6568-5ccd-bf61-c54b92e1498c" "answer-80e08489-6db6-5fff-889e-336e8aa7cbf9" "answer-5cb5b0ed-5f47-54e9-a659-1c3087a32a54" "answer-c8e1d746-f7b8-568f-a44a-cb0999d610f0"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4cce29f-595a-5529-a3ee-ff3b48c4d743" :answer/id #uuid "d4cce29f-595a-5529-a3ee-ff3b48c4d743" :answer/type :answer.type/math :answer/value "\\frac{10}{m}" :db/ensure [:answer/validate]} {:db/id "answer-591dd984-6568-5ccd-bf61-c54b92e1498c" :answer/id #uuid "591dd984-6568-5ccd-bf61-c54b92e1498c" :answer/type :answer.type/math :answer/value "\\frac{2}{5m}" :db/ensure [:answer/validate]} {:db/id "answer-80e08489-6db6-5fff-889e-336e8aa7cbf9" :answer/id #uuid "80e08489-6db6-5fff-889e-336e8aa7cbf9" :answer/type :answer.type/math :answer/value "\\frac{4}{m}" :db/ensure [:answer/validate]} {:db/id "answer-5cb5b0ed-5f47-54e9-a659-1c3087a32a54" :answer/id #uuid "5cb5b0ed-5f47-54e9-a659-1c3087a32a54" :answer/type :answer.type/math :answer/value "\\frac{5m}{4}" :db/ensure [:answer/validate]} {:db/id "answer-c8e1d746-f7b8-568f-a44a-cb0999d610f0" :answer/id #uuid "c8e1d746-f7b8-568f-a44a-cb0999d610f0" :answer/type :answer.type/math :answer/value "\\frac{m}{4}" :db/ensure [:answer/validate]} {:db/id "activity-c90c0967-3265-5ff8-87a3-64307bf9fcc3" :activity/id #uuid "c90c0967-3265-5ff8-87a3-64307bf9fcc3" :activity/title "Solving Linear Equations With Unknown Coefficients" :activity/type :activity.type/review :activity/scope 17592186048649 :activity/course 17592186046648 :activity/steps ["step-a23b9573-7415-545a-9e8b-b6740ea06d30" "step-3884d043-75db-5212-8395-1e2c764892ba" "step-410ffcfc-0175-5671-8ae5-c5418ec86558"] :activity/first-step "step-a23b9573-7415-545a-9e8b-b6740ea06d30" :db/ensure [:activity/validate]} {:db/id "step-a23b9573-7415-545a-9e8b-b6740ea06d30" :step/id #uuid "a23b9573-7415-545a-9e8b-b6740ea06d30" :step/content "question-e830f76b-5a84-5b55-8ce0-c003dd77dcc2" :step/next "step-3884d043-75db-5212-8395-1e2c764892ba" :db/ensure [:step/validate]} {:db/id "step-3884d043-75db-5212-8395-1e2c764892ba" :step/id #uuid "3884d043-75db-5212-8395-1e2c764892ba" :step/content 17592186180206 :step/next "step-410ffcfc-0175-5671-8ae5-c5418ec86558" :db/ensure [:step/validate]} {:db/id "step-410ffcfc-0175-5671-8ae5-c5418ec86558" :step/id #uuid "410ffcfc-0175-5671-8ae5-c5418ec86558" :step/content "question-baac7ae1-a07b-5049-b210-41cf170484ad" :db/ensure [:step/validate]}]
