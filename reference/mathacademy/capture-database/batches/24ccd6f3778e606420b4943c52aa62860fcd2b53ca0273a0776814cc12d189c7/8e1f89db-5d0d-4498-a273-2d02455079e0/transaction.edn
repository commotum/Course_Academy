nowledge-point/questions ["question-bf001cda-9f10-546a-97c2-0d9313d65e00" "question-b25ca648-9cf3-58f7-bad1-6cf2e59324cf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bf001cda-9f10-546a-97c2-0d9313d65e00" :question/id #uuid "bf001cda-9f10-546a-97c2-0d9313d65e00" :question/math-academy-id "q-15254" :question/problem "If $|11-4x|=3,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|11-4x|=11-4x,$ we obtain:\n\n$$\n\\begin{aligned}|11-4x| & =3 \\\\ 11-4x & =3 \\\\ -4x & =-8 \\\\ \\frac{-4x}{-4} & =\\frac{-8}{-4} \\\\ x & =2\\end{aligned}\n$$\n\n- If $|11-4x|=-(11-4x),$ we obtain:\n\n$$\n\\begin{aligned}|11-4x| & =3 \\\\ -(11-4x) & =3 \\\\ -11+4x & =3 \\\\ 4x & =14 \\\\ \\frac{4x}{4} & =\\frac{14}{4} \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=2$ and $x=\\frac{7}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dac4219c-b92c-5d85-9814-6729d48e7233"] :db/ensure [:question/validate]} {:db/id "answer-field-dac4219c-b92c-5d85-9814-6729d48e7233" :answer-field/id #uuid "dac4219c-b92c-5d85-9814-6729d48e7233" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b716a5c1-2bda-5fe2-a26b-d8a2524741b3" :answer-field/choices ["answer-591e63f9-b0da-50e5-9f5f-c6dc29186793" "answer-a4bff5c8-756d-5c90-a938-61faf60d9476" "answer-0701c6fb-b8b0-5030-bb54-6715655e1d6e" "answer-b716a5c1-2bda-5fe2-a26b-d8a2524741b3" "answer-8f3a1f6d-cc83-5713-9c86-11f797705b67"] :db/ensure [:answer-field/validate]} {:db/id "answer-591e63f9-b0da-50e5-9f5f-c6dc29186793" :answer/id #uuid "591e63f9-b0da-50e5-9f5f-c6dc29186793" :answer/type :answer.type/text :answer/value "$-2$ or $-\\frac{2}{7}$" :db/ensure [:answer/validate]} {:db/id "answer-a4bff5c8-756d-5c90-a938-61faf60d9476" :answer/id #uuid "a4bff5c8-756d-5c90-a938-61faf60d9476" :answer/type :answer.type/text :answer/value "$-2$ or $\\frac{7}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-0701c6fb-b8b0-5030-bb54-6715655e1d6e" :answer/id #uuid "0701c6fb-b8b0-5030-bb54-6715655e1d6e" :answer/type :answer.type/text :answer/value "$-\\frac{2}{7}$ or $2$" :db/ensure [:answer/validate]} {:db/id "answer-b716a5c1-2bda-5fe2-a26b-d8a2524741b3" :answer/id #uuid "b716a5c1-2bda-5fe2-a26b-d8a2524741b3" :answer/type :answer.type/text :answer/value "$2$ or $\\frac{7}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-8f3a1f6d-cc83-5713-9c86-11f797705b67" :answer/id #uuid "8f3a1f6d-cc83-5713-9c86-11f797705b67" :answer/type :answer.type/text :answer/value "$\\frac{2}{7}$ or $2$" :db/ensure [:answer/validate]} {:db/id 17592186068710 :knowledge-point/questions ["question-dc058aee-cd4e-56a4-b735-dc759e998e0e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dc058aee-cd4e-56a4-b735-dc759e998e0e" :question/id #uuid "dc058aee-cd4e-56a4-b735-dc759e998e0e" :question/math-academy-id "q-15257" :question/problem "If $|5x-12|=3,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|5x-12|=5x-12,$ we obtain:\n\n$$\n\\begin{aligned}|5x-12| & =3 \\\\ 5x-12 & =3 \\\\ 5x & =15 \\\\ \\frac{5x}{5} & =\\frac{15}{5} \\\\ x & =3\\end{aligned}\n$$\n\n- If $|5x-12|=-(5x-12),$ we obtain:\n\n$$\n\\begin{aligned}|5x-12| & =3 \\\\ -(5x-12) & =3 \\\\ -5x+12 & =3 \\\\ -5x & =-9 \\\\ \\frac{-5x}{-5} & =\\frac{-9}{-5} \\\\ x & =\\frac{9}{5}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{9}{5}$ and $x=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ffecce80-4a83-596b-bd4c-c3a2d3d4cfc9"] :db/ensure [:question/validate]} {:db/id "answer-field-ffecce80-4a83-596b-bd4c-c3a2d3d4cfc9" :answer-field/id #uuid "ffecce80-4a83-596b-bd4c-c3a2d3d4cfc9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-589f4d35-5413-5d87-83c1-4a59ecc9ebd0" :answer-field/choices ["answer-9d463002-439b-562b-9798-0df675319b5b" "answer-e68b697d-110c-5bd9-88a6-6ccd86dd44e7" "answer-b557add2-f5fc-5a0c-ad04-8a1c5f8ba3b7" "answer-cc661ccb-9cb1-5767-b7fa-3f7b29153ffc" "answer-589f4d35-5413-5d87-83c1-4a59ecc9ebd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d463002-439b-562b-9798-0df675319b5b" :answer/id #uuid "9d463002-439b-562b-9798-0df675319b5b" :answer/type :answer.type/text :answer/value "$-1$ or $3$" :db/ensure [:answer/validate]} {:db/id "answer-e68b697d-110c-5bd9-88a6-6ccd86dd44e7" :answer/id #uuid "e68b697d-110c-5bd9-88a6-6ccd86dd44e7" :answer/type :answer.type/text :answer/value "$-3$ or $-\\frac{9}{5}$" :db/ensure [:answer/validate]} {:db/id "answer-b557add2-f5fc-5a0c-ad04-8a1c5f8ba3b7" :answer/id #uuid "b557add2-f5fc-5a0c-ad04-8a1c5f8ba3b7" :answer/type :answer.type/text :answer/value "$-3$ or $\\frac{9}{5}$" :db/ensure [:answer/validate]} {:db/id "answer-cc661ccb-9cb1-5767-b7fa-3f7b29153ffc" :answer/id #uuid "cc661ccb-9cb1-5767-b7fa-3f7b29153ffc" :answer/type :answer.type/text :answer/value "$1$ or $3$" :db/ensure [:answer/validate]} {:db/id "answer-589f4d35-5413-5d87-83c1-4a59ecc9ebd0" :answer/id #uuid "589f4d35-5413-5d87-83c1-4a59ecc9ebd0" :answer/type :answer.type/text :answer/value "$\\frac{9}{5}$ or $3$" :db/ensure [:answer/validate]} {:db/id "question-b25ca648-9cf3-58f7-bad1-6cf2e59324cf" :question/id #uuid "b25ca648-9cf3-58f7-bad1-6cf2e59324cf" :question/math-academy-id "q-154645" :question/problem "If $|5-x|=6,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|5-x|=5-x,$ we obtain:\n\n$$\n\\begin{aligned}|5-x| & =6 \\\\ 5-x & =6 \\\\ -x & =1 \\\\ x & =-1\\end{aligned}\n$$\n\n- If $|5-x|=-(5-x),$ we obtain:\n\n$$\n\\begin{aligned}|5-x| & =6 \\\\ -(5-x) & =6 \\\\ -5+x & =6 \\\\ x & =11\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-1$ and $x=11.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-51aef6b7-5dcd-5253-a886-fdee125552e5"] :db/ensure [:question/validate]} {:db/id "answer-field-51aef6b7-5dcd-5253-a886-fdee125552e5" :answer-field/id #uuid "51aef6b7-5dcd-5253-a886-fdee125552e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76d2fb58-4ccb-56f8-910a-14c6ece3d1fc" :answer-field/choices ["answer-614a5039-7de1-5dbf-bca4-d8ffc425678e" "answer-76d2fb58-4ccb-56f8-910a-14c6ece3d1fc" "answer-1745440e-88bf-5d51-8897-e4414167e24b" "answer-f02f7135-1784-56eb-88e1-1c8c91546081" "answer-c0ed8913-7141-5fed-a6ed-846233cc1d57"] :db/ensure [:answer-field/validate]} {:db/id "answer-614a5039-7de1-5dbf-bca4-d8ffc425678e" :answer/id #uuid "614a5039-7de1-5dbf-bca4-d8ffc425678e" :answer/type :answer.type/text :answer/value "$-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-76d2fb58-4ccb-56f8-910a-14c6ece3d1fc" :answer/id #uuid "76d2fb58-4ccb-56f8-910a-14c6ece3d1fc" :answer/type :answer.type/text :answer/value "$-1$ or $11$" :db/ensure [:answer/validate]} {:db/id "answer-1745440e-88bf-5d51-8897-e4414167e24b" :answer/id #uuid "1745440e-88bf-5d51-8897-e4414167e24b" :answer/type :answer.type/text :answer/value "$-11$ or $-6$" :db/ensure [:answer/validate]} {:db/id "answer-f02f7135-1784-56eb-88e1-1c8c91546081" :answer/id #uuid "f02f7135-1784-56eb-88e1-1c8c91546081" :answer/type :answer.type/text :answer/value "$1$ or $5$" :db/ensure [:answer/validate]} {:db/id "answer-c0ed8913-7141-5fed-a6ed-846233cc1d57" :answer/id #uuid "c0ed8913-7141-5fed-a6ed-846233cc1d57" :answer/type :answer.type/text :answer/value "$11$ only" :db/ensure [:answer/vali