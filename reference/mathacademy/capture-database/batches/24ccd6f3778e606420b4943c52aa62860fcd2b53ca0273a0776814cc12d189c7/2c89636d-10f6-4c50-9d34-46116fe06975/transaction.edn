/5}}={z}^{k},$ then $k=$" :question/worked-solution "First, we express the radical as a fractional power and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[3]{{z}^{-6/5}} & = \\\\ {({z}^{-6/5})}^{1/3} & = \\\\ {z}^{(-6/5)(1/3)} & = \\\\ {z}^{-2/5}\\end{aligned}\n$$\n\nHence, $k=-\\frac{2}{5}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8f0bb462-c95e-50f5-9f00-b9bf46397566"] :db/ensure [:question/validate]} {:db/id "answer-field-8f0bb462-c95e-50f5-9f00-b9bf46397566" :answer-field/id #uuid "8f0bb462-c95e-50f5-9f00-b9bf46397566" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-795691ba-bdae-5475-be56-27a71a0be7cd" :answer-field/choices ["answer-eba20943-6e93-5443-b335-cbfdcee078e4" "answer-795691ba-bdae-5475-be56-27a71a0be7cd" "answer-faf8fbf1-75c8-5c7e-9dff-ca66a5c03643" "answer-1e055b9f-627a-5ebf-9e18-8a5c87b9089b" "answer-172ae84a-d9ad-5b2c-a66c-13b732c1d880"] :db/ensure [:answer-field/validate]} {:db/id "answer-eba20943-6e93-5443-b335-cbfdcee078e4" :answer/id #uuid "eba20943-6e93-5443-b335-cbfdcee078e4" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-795691ba-bdae-5475-be56-27a71a0be7cd" :answer/id #uuid "795691ba-bdae-5475-be56-27a71a0be7cd" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-faf8fbf1-75c8-5c7e-9dff-ca66a5c03643" :answer/id #uuid "faf8fbf1-75c8-5c7e-9dff-ca66a5c03643" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1e055b9f-627a-5ebf-9e18-8a5c87b9089b" :answer/id #uuid "1e055b9f-627a-5ebf-9e18-8a5c87b9089b" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-172ae84a-d9ad-5b2c-a66c-13b732c1d880" :answer/id #uuid "172ae84a-d9ad-5b2c-a66c-13b732c1d880" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "activity-d4e8d8ea-37ee-5a5f-b346-bb11740b6853" :activity/id #uuid "d4e8d8ea-37ee-5a5f-b346-bb11740b6853" :activity/title "The Power Rule for Exponents With Algebraic Expressions" :activity/type :activity.type/review :activity/scope 17592186050208 :activity/course 17592186046647 :activity/steps ["step-d2528ecc-26c4-5f1d-b559-b7a427afb73d" "step-ba723f55-31ec-5dd6-9dc6-ad73e8e639a6" "step-d14d94aa-acdf-59ab-9018-6c208c90e229"] :activity/first-step "step-d2528ecc-26c4-5f1d-b559-b7a427afb73d" :db/ensure [:activity/validate]} {:db/id "step-d2528ecc-26c4-5f1d-b559-b7a427afb73d" :step/id #uuid "d2528ecc-26c4-5f1d-b559-b7a427afb73d" :step/content "question-b2001685-083c-5b23-92d4-dc534c9b8927" :step/next "step-ba723f55-31ec-5dd6-9dc6-ad73e8e639a6" :db/ensure [:step/validate]} {:db/id "step-ba723f55-31ec-5dd6-9dc6-ad73e8e639a6" :step/id #uuid "ba723f55-31ec-5dd6-9dc6-ad73e8e639a6" :step/content "question-b9bd1889-37e7-5c18-aff9-d79a4155a663" :step/next "step-d14d94aa-acdf-59ab-9018-6c208c90e229" :db/ensure [:step/validate]} {:db/id "step-d14d94aa-acdf-59ab-9018-6c208c90e229" :step/id #uuid "d14d94aa-acdf-59ab-9018-6c208c90e229" :step/content "question-3b874545-de9e-5368-9969-5a0f4efc79db" :db/ensure [:step/validate]} {:db/id 17592186074384 :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $?$ |\n| $?$ | $35$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $4:7$ and write it as a fraction:\n\n$$\n\\frac{4}{7}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($7$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $12,$ we multiply the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{4\\times 3}{7\\times 3}=\\frac{12}{21}\n$$\n\n- To create a denominator of $35,$ we multiply the numerator and denominator of our fraction by $5:$\n\n$$\n\\frac{4\\times 5}{7\\times 5}=\\frac{20}{35}\n$$\n\nFinally, we fill in the ratio table:\n\n| $4$ | $7$ |\n| --- | --- |\n| $12$ | $21$ |\n| $20$ | $35$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $21$ and $20.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186072542 :answer-field/correct 17592186072543 :db/ensure [:answer-field/validate]} {:db/id 17592186073897 :knowledge-point/questions ["question-07105131-b758-5e72-bdb4-02c98035c4fe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-07105131-b758-5e72-bdb4-02c98035c4fe" :question/id #uuid "07105131-b758-5e72-bdb4-02c98035c4fe" :question/math-academy-id "q-59864" :question/problem "Gerry, a gardener, is planting roses. He knows he needs $1$ cup of water for every $4$ seeds he plants. So, Gerry creates a ratio table to determine the ratio of water to seeds for different quantities.\n\n| Water (cups) | Seeds |\n| --- | --- |\n| $1$ | $4$ |\n| $7$ | $?$ |\n| $12$ | $48$ |\n\n$$\n\n$$\n\nHow many seeds can Gerry plant with $7$ cups of water?" :question/worked-solution "We start with the ratio $1:4$ and write it as a fraction:\n\n$$\n\\frac{1}{4}\n$$\n\nSo the numerator represents the number of cups of water ($1$), and the denominator represents the number of seeds ($4$).\n\nWe can make a numerator of $7$ by multiplying the numerator and denominator by $7$:\n\n$$\n\\begin{aligned}\\frac{1\\times 7}{4\\times 7} & =\\frac{7}{28}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| Water (cups) | Seeds |\n| --- | --- |\n| $1$ | $4$ |\n| $7$ | $28$ |\n| $12$ | $48$ |\n\n$$\n\n$$\n\nSo, Gerry can plant $28$ seeds with $7$ cups of water." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-143347e7-6d5a-5881-950d-01ac371e0e93"] :db/ensure [:question/validate]} {:db/id "answer-field-143347e7-6d5a-5881-950d-01ac371e0e93" :answer-field/id #uuid "143347e7-6d5a-5881-950d-01ac371e0e93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91cc30be-ed6a-5c8b-b0fc-539e49732127" :answer-field/choices ["answer-67aa2a37-93dc-537d-8c25-bd3d37cb5f4b" "answer-257f2818-68c3-56e8-8274-f829f0a2508c" "answer-91cc30be-ed6a-5c8b-b0fc-539e49732127" "answer-4f9324be-63c9-5f43-89d5-f643aba91802" "answer-3b6ac35d-9f43-5857-b1f2-871ed91f248e"] :db/ensure [:answer-field/validate]} {:db/id "answer-67aa2a37-93dc-537d-8c25-bd3d37cb5f4b" :answer/id #uuid "67aa2a37-93dc-537d-8c25-bd3d37cb5f4b" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-257f2818-68c3-56e8-8274-f829f0a2508c" :answer/id #uuid "257f2818-68c3-56e8-8274-f829f0a2508c" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "answer-91cc30be-ed6a-5c8b-b0fc-539e49732127" :answer/id #uuid "91cc30be-ed6a-5c8b-b0fc-539e49732127" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "answer-4f9324be-63c9-5f43-89d5-f643aba91802" :answer/id #uuid "4f9324be-63c9-5f43-89d5-f643aba91802" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-3b6ac35d-9f43-5857-b1f2-871ed91f248e" :answer/id #uuid "3b6ac35d-9f43-5857-b1f2-871ed91f248e" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id 17592186073896 :knowledge-point/questions ["question-d91b69e3-fd77-5457-a2ba-3ce70f9e9f93"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d91b69e3-fd77-5457-a2ba-3ce70f9e9f93" :question/id #uuid "d91b69e3-fd77-5457-a2ba-3ce70f9e9f93" :question/math-academy-id "q-101518" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $?$ | $10$ |\n| --- | --- |\n| $3$ | $15$ |\n| $6$ | $?$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $3:15$ and write it as a fraction:\n\n$$\n\\frac{3}{15}\n$$\n\nSo the numerator represents the left-hand entry ($3$), and the denominator represents the right-hand entry ($15$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $6,$ we multiply the numerator and denominator of our fraction by $2:$\n\n$$\n\\frac{3\\times 2}{15\\times 2}=\\frac{6}{30}\n$$\n\n- To create a denominator of $10,$ we divide the numerator and denominator of the previous fraction by $3:$\n\n$$\n\\frac{6÷3}{30÷3}=\\frac{2}{10}\n$$\n\nFinally, we fill in the ratio table:\n\n| $2$ | $10$ |\n| --- | --- |\n| $3$ | $15$ |\n| $6$ | $30$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $2$ and $30.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-00fa6310-f945-5eef-a33e-d1403f30df5d"] :db/ensure [:question/validate]} {:db/id "answer-field-00fa6310-f945-5eef-a33e-d1403f30df5d" :answer-field/id #uuid "00fa6310-f945-5eef-a33e-d1403f30df5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-38f59563-e260-5f22-a248-5d3fefc64cdc" :answer-field/choices ["answer-a67179fa-5ca5-5e82-94ea-ac2e1fb430df" "answer-38f59563-e260-5f22-a248-5d3fefc64cdc" "answer-a545f8d6-c144-53ff-ae29-f028d06395f6" "answer-e37e6ce5-4981-521e-804c-81bef08aaaba" "answer-1e1d0b9d-3357-54ab-82cf-abf91011ffa6"] :db/ensure [:answer-field/validate]} {:db/id "answer-a67179fa-5ca5-5e82-94ea-ac2e1fb430df" :answer/id #uuid "a67179fa-5ca5-5e82-94ea-ac2e1fb430df" :answer/type :answer.type/text :answer/value "$2$ and $18$" :db/ensure [:answer/validate]} {:db/id "answer-38f59563-e260-5f22-a248-5d3fefc64cdc" :answer/id #uuid "38f59563-e260-5f22-a248-5d3fefc64cdc" :answer/type :answer.type/text :answer/value "$2$ and $30$" :db/ensure [:answer/validate]} {:db/id "answer-a545f8d6-c144-53ff-ae29-f028d06395f6" :answer/id #uuid "a545f8d6-c144-53ff-ae29-f028d06395f6" :answer/type :answer.type/text :answer/value "$4$ and $20$" :db/ensure [:answer/validate]} {:db/id "answer-e37e6ce5-4981-521e-804c-81