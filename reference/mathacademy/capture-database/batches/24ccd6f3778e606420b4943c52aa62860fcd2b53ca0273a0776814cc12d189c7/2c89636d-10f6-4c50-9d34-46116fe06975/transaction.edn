bd-9dc9-55d5-9fbf-297924a75a08" :step/id #uuid "878bfcbd-9dc9-55d5-9fbf-297924a75a08" :step/content "question-bdb96e93-5d4a-5d24-ab91-43e3876a1cf8" :step/next "step-6ab7484f-b23e-5417-a394-47ef0c9b1127" :db/ensure [:step/validate]} {:db/id "step-6ab7484f-b23e-5417-a394-47ef0c9b1127" :step/id #uuid "6ab7484f-b23e-5417-a394-47ef0c9b1127" :step/content "question-6705c0b1-618f-5fe7-bac1-95db3808efcf" :step/next "step-4875decf-cc08-5206-80c4-5137e6d3e54b" :db/ensure [:step/validate]} {:db/id "step-4875decf-cc08-5206-80c4-5137e6d3e54b" :step/id #uuid "4875decf-cc08-5206-80c4-5137e6d3e54b" :step/content "question-ae08ca9c-939c-5021-b3a5-7c6bc6fdc648" :step/next "step-041d72b6-5556-5043-94cb-bee43a50b2ba" :db/ensure [:step/validate]} {:db/id "step-041d72b6-5556-5043-94cb-bee43a50b2ba" :step/id #uuid "041d72b6-5556-5043-94cb-bee43a50b2ba" :step/content "question-7841e502-bd87-5f16-9f68-b66396ece51e" :step/next "step-f3256ffc-9733-5cbe-9329-38c1600cd3ba" :db/ensure [:step/validate]} {:db/id "step-f3256ffc-9733-5cbe-9329-38c1600cd3ba" :step/id #uuid "f3256ffc-9733-5cbe-9329-38c1600cd3ba" :step/content 17592186064748 :db/ensure [:step/validate]} {:db/id 17592186162113 :knowledge-point/questions ["question-427792fe-a52b-5a35-ba4b-43ed95fe05d5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162391 :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x}{{y}^{2}}, & \\,0<x<y,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(\\frac{1}{4}<X<\\frac{1}{2}\\,|\\,Y=\\frac{5}{8}).$" :question/worked-solution "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(\\frac{1}{4}<X<\\frac{1}{2}\\,|\\,Y=\\frac{5}{8}) & ={\\int }_{1/4}^{1/2}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{5}{8})\\text{d}x \\\\  & ={\\int }_{1/4}^{1/2}\\frac{2x}{{(\\frac{5}{8})}^{2}}\\,\\text{d}x \\\\  & =\\frac{64}{25}{\\int }_{1/4}^{1/2}2x\\,\\text{d}x \\\\  & =\\frac{64}{25}[{x}^{2}]_{1/4}^{1/2} \\\\  & =\\frac{64}{25}(\\frac{1}{4}-\\frac{1}{16}) \\\\  & =\\frac{64}{25}(\\frac{3}{16}) \\\\  & =\\frac{12}{25}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186159548 :answer-field/correct 17592186159550 :db/ensure [:answer-field/validate]} {:db/id 17592186162392 :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}24xy, & \\,0<x<1,0<y<1-x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(Y<X\\,|\\,X=\\frac{1}{3}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}y,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nUsing the formula for the marginal density function for $X,$ we have\n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1-x}24xy\\,\\text{d}y \\\\  & =24x{\\int }_{0}^{1-x}y\\,\\text{d}y \\\\  & =24x{[\\frac{1}{2}{y}^{2}]}_{0}^{1-x} \\\\  & =12x(1-x)^{2}-0 \\\\  & =12x(x-1)^{2}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}12x(x-1)^{2}, & \\,0<x<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0<x<1,0<y<1-x,$ we have\n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{24xy}{12x(x-1)^{2}} \\\\  & =\\frac{2y}{(x-1)^{2}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{(x-1)^{2}}, & \\,0<x<1,0<y<1-x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(Y<X\\,|\\,X=\\frac{1}{3}) & =P(Y<\\frac{1}{3}\\,|\\,X=\\frac{1}{3}) \\\\  & ={\\int }_{0}^{1/3}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{1}{3})\\text{d}y \\\\  & ={\\int }_{0}^{1/3}\\frac{2y}{{(\\frac{1}{3}-1)}^{2}}\\text{d}y \\\\  & =\\frac{9}{2}{\\int }_{0}^{1/3}y\\,\\text{d}y \\\\  & =\\frac{9}{2}{[\\frac{{y}^{2}}{2}]}_{0}^{1/3} \\\\  & =\\frac{9}{2}(\\frac{1}{18}-0) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-427792fe-a52b-5a35-ba4b-43ed95fe05d5" :question/id #uuid "427792fe-a52b-5a35-ba4b-43ed95fe05d5" :question/math-academy-id "q-143573" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{2y}{2x+3} & \\,0\\le x\\le 1,\\,x+1\\le y\\le x+2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(Y<2\\,|\\,X=\\frac{3}{4}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}x,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(Y<2\\,|\\,X=\\frac{3}{4}) & ={\\int }_{1+x}^{2}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{3}{4})\\text{d}y \\\\  & ={\\int }_{1+3/4}^{2}\\frac{2y}{(2\\cdot \\frac{3}{4}+3)}\\,\\text{d}y \\\\  & =\\frac{2}{9}{\\int }_{7/4}^{2}2y\\,\\text{d}y \\\\  & =\\frac{2}{9}[{y}^{2}]_{7/4}^{2} \\\\  & =\\frac{2}{9}(4-\\frac{49}{16}) \\\\  & =\\frac{5}{24}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4824d498-2640-5207-a210-a8d05507618a"] :db/ensure [:question/validate]} {:db/id "answer-field-4824d498-2640-5207-a210-a8d05507618a" :answer-field/id #uuid "4824d498-2640-5207-a210-a8d05507618a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76d4658d-76b6-5b33-aa64-aa0bb388f498" :answer-field/choices ["answer-ab42cc66-3ec7-5fba-ba3f-33b3a69e4979" "answer-eb3e916a-1d77-5240-920d-86d1b61a5940" "answer-71a909e6-6f08-5712-bc83-1b6bad8b11a0" "answer-76d4658d-76b6-5b33-aa64-aa0bb388f498" "answer-3a7dd673-0f1c-53a4-bf23-823dac58c3bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab42cc66-3ec7-5fba-ba3f-33b3a69e4979" :answer/id #uuid "ab42cc66-3ec7-5fba-ba3f-33b3a69e4979" :answer/type :answer.type/math :answer/value "\\frac{11}{18}" :db/ensure [:answer/validate]} {:db/id "answer-eb3e916a-1d77-5240-920d-86d1b61a5940" :answer/id #uuid "eb3e916a-1d77-5240-920d-86d1b61a5940" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "answer-71a909e6-6f08-5712-bc83-1b6bad8b11a0" :answer/id #uuid "71a909e6-6f08-5712-bc83-1b6bad8b11a0" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "answer-76d4658d-76b6-5b33-aa64-aa0bb388f498" :answer/id #uuid "76d4658d-76b6-5b33-aa64-aa0bb388f498" :answer/type :answer.type/math :answer/value "\\frac{5}{24}" :db/ensure [:answer/validate]} {:db/id "answer-3a7dd673-0f1c-53a4-bf23-823dac58c3bf" :answer/id #uuid "3a7dd673-0f1c-53a4-bf23-823dac58c3bf" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id 17592186162114 :knowledge-point/questions ["question-e1e5b64b-413b-5b25-a4f6-89eb28f41500" "question-5ffa5cf0-3e04-5a20-bfc9-964d09fea30a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e1e5b64b-413b-5b25-a4f6-89eb28f41500" :question/id #uuid "e1e5b64b-413b-5b25-a4f6-89eb28f41500" :question/math-academy-id "q-143644" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}6, & \\,y\\le x\\le \\sqrt{y},\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $y\\le x\\le \\sqrt{y},\\,0<y<1.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{y}^{\\sqrt{y}}6\\,\\text{d}x \\\\  & =6\\cdot x\\,{|}_{y}^{\\sqrt{y}} \\\\  & =6(\\sqrt{y}-y).\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}6(\\sqrt{y}-y), & \\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $y\\le x\\le \\sqrt{y},\\,0<y<1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{6}{6(\\sqrt{y}-y)} \\\\  & =\\frac{1}{\\sqrt{y}-y}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{1}{\\sqrt{y}-y}, & \\,y\\le x\\le \\sqrt{y},\\,0<y<1, \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b608e08c-09ce-5c00-b348-3354afe78844"] :db/ensure [:question/validate]} {:db/id "answer-field-b608e08c-09ce-5c00-b348-3354afe78844" :answer-field/id #uuid "b608e08c-09ce-5c00-b348-3354afe78844" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d9e076f-f8bc-5761-b656-c6602ea176a4" :answer-field/choices ["answer-ce0a0f68-ff1b-5054-bdc9-b7e07c3e9fbe" "answer-4d9e076f-f8bc-5761-b656-c6602ea176a4" "answer-18eb1c41-b6a4-592b-856a-3cab685afd5d" "answer-c9c771ea-0ad2-5a82-b2a7-6dd9f49a0d79" "answer-fefcf60e-8515-57a8-ab6a-297915943a05"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce0a0f68-ff1b-5054-bdc9-b7e07c3e9fbe" :answer/id #uuid "ce0a0f68-ff1b-5054-bdc9-b7e07c3e9fbe" :answer/type :answer.type/math :answer/value "3(y-{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-4d9e076f-f8bc-5761-b656-c6602ea176a4" :answer/id #uuid "4d9e076f-f8bc-5761-b656-c6602ea176a4" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{y}-y}" :db/ensure [:answer/validate]} {:db/id "answer-18eb1c41-b6a4-592b-856a-3cab685afd5d" :answer/id #uuid "18eb1c41-b6a4-592b-856a-3cab685afd5d" :answer/type :answer.type/math :answer/value "\\frac{3}{y-{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-c9c771ea-0ad2-5a82-b2a7-6dd9f49a0d79" :answer/id #uuid "c9c771ea-0ad2-5a82-b2a7-6dd9f49a0d79" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{y}-y}{3}" :db/ensure [:answer/validate]} {:db/id "answer-fefcf60e-8515-57a8-ab6a-297915943a05" :answer/id #uuid "fefcf60e-8515-57a8-ab6a-297915943a05" :answer/type :answer.type/math :answer/value "\\sqrt{y}-y" :db/ensure [:answer/validate]} {:db/id "question-5ffa5cf0-3e04-5a20-bfc9-964d09fea30a" :question/id #uuid "5ffa5cf0-3e04-5a20-bfc9-964d09fea30a" :question/math-academy-id "q-145091" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3}{8}({y}^{2}+x), & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 2,\\,0\\le y\\le 1.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{3}{8}({y}^{2}+x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(\\frac{3{y}^{2}}{8}+\\frac{3x}{8})\\text{d}x \\\\  & ={[\\frac{3x{y}^{2}}{8}+\\frac{3{x}^{2}}{16}]}_{x=0}^{x=2} \\\\  & =\\frac{6{y}^{2}}{8}+\\frac{12}{16}-0 \\\\  & =\\frac{3{y}^{2}}{4}+\\frac{3}{4} \\\\  & =\\frac{3}{4}({y}^{2}+1).\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3}{4}({y}^{2}+1), & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $1\\le x\\le 2,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{3}{8}({y}^{2}+x))}{(\\frac{3}{4}({y}^{2}+1))} \\\\  & =\\frac{{y}^{2}+x}{2({y}^{2}+1)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{{y}^{2}+x}{2({y}^{2}+1)}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2568d719-6258-502f-b42f-c59bbe997028"] :db/ensure [:question/validate]} {:db/id "answer-field-2568d719-6258-502f-b42f-c59bbe997028" :answer-field/id #uuid "2568d719-6258-502f-b42f-c59bbe997028" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75565937-5318-5439-b48d-e16cca219a95" :answer-field/choices ["answer-63ff8546-8d92-58c2-a62b-b0c34bccc272" "answer-af8c864f-3d09-5723-889c-3b0bde2faabe" "answer-75565937-5318-5439-b48d-e16cca219a95" "answer-1f7f5d76-1e7f-57ed-8313-e71643d50b2d" "answer-f451b045-2660-545d-8769-46b5280b5182"] :db/ensure [:answer-field/validate]} {:db/id "answer-63ff8546-8d92-58c2-a62b-b0c34bccc272" :answer/id #uuid "63ff8546-8d92-58c2-a62b-b0c34bccc272" :answer/type :answer.type/math :answer/value "\\frac{y+x}{2(y+1)}" :db/ensure [:answer/validate]} {:db/id "answer-af8c864f-3d09-5723-889c-3b0bde2faabe" :answer/id #uuid "af8c864f-3d09-5723-889c-3b0bde2faabe" :answer/type :answer.type/math :answer/value "\\frac{y+x}{{y}^{2}+2}" :db/ensure [:answer/validate]} {:db/id "answer-75565937-5318-5439-b48d-e16cca219a95" :answer/id #uuid "75565937-5318-5439-b48d-e16cca219a95" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}+x}{2({y}^{2}+1)}" :db/ensure [:answer/validate]} {:db/id "answer-1f7f5d76-1e7f-57ed-8313-e71643d50b2d" :answer/id #uuid "1f7f5d76-1e7f-57ed-8313-e71643d50b2d" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}+x}{2y+1}" :db/ensure [:answer/validate]} {:db/id "answer-f451b045-2660-545d-8769-46b5280b5182" :answer/id #uuid "f451b045-2660-545d-8769-46b5280b5182" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}+x}{y+2}" :db/ensure [:answer/validate]} {:db/id "activity-e4ec82c9-8364-58b9-907b-4ba241720e9f" :activity/id #uuid "e4ec82c9-8364-58b9-907b-4ba241720e9f" :activity/title "Conditio