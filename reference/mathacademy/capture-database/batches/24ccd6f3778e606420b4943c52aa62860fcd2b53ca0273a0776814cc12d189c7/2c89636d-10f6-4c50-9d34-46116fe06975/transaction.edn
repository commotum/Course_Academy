74f17d8" :db/ensure [:step/validate]} {:db/id "step-aca56c02-4eed-569f-8354-82b4674f17d8" :step/id #uuid "aca56c02-4eed-569f-8354-82b4674f17d8" :step/content "question-1e025671-c988-5444-b52c-2cc6ba70eb20" :step/next "step-6746f8a6-ec2c-552a-9227-04e6ffc3fef5" :db/ensure [:step/validate]} {:db/id "step-6746f8a6-ec2c-552a-9227-04e6ffc3fef5" :step/id #uuid "6746f8a6-ec2c-552a-9227-04e6ffc3fef5" :step/content "question-4e15364c-186a-5328-8307-13438fe58309" :step/next "step-7884f355-3021-5d3e-8e4b-bfc424f5de1d" :db/ensure [:step/validate]} {:db/id "step-7884f355-3021-5d3e-8e4b-bfc424f5de1d" :step/id #uuid "7884f355-3021-5d3e-8e4b-bfc424f5de1d" :step/content 17592186243975 :step/next "step-2900fd92-b1ba-5748-8fdb-cafa51cae4b8" :db/ensure [:step/validate]} {:db/id "step-2900fd92-b1ba-5748-8fdb-cafa51cae4b8" :step/id #uuid "2900fd92-b1ba-5748-8fdb-cafa51cae4b8" :step/content "question-e3898571-1060-5a54-af07-b5592b492d4f" :db/ensure [:step/validate]} {:db/id "question-1455aec3-db48-5efe-b5bf-59b8688bf438" :question/id #uuid "1455aec3-db48-5efe-b5bf-59b8688bf438" :question/math-academy-id "q-132483" :question/problem "On a webpage, visitors arrive continuously in time, independently, and at a constant average rate of one every $15$ seconds.  Determine the probability of waiting for the next visitor for less than $0.5$ minutes.  Round your answer to $4$ decimal places." :question/worked-solution "Since visitors arrive continuously in time, independently, and at a constant average rate, we can model the time until the next visitor appears using an exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the time between two consecutive visitor arrivals. Since visitors arrive on average every $15$ seconds, the rate is $\\lambda =60÷15=4$ visitors per minute.\n\nThe time between two consecutive visitor arrivals can be modeled as an exponential random variable with rate $\\lambda =4,$ and we can write \n\n$$\nX∼\\text{Exp}(4).\n$$\n\nSo, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}4{e}^{-4x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability of waiting for the next visitor for less than \n$0.5$ minutes is\n\n$$\n\\begin{aligned}P(X<0.5) & ={\\int }_{0}^{0.5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{0.5}4{e}^{-4x}\\,\\text{d}x \\\\  & =-{e}^{-4x}{|}_{0}^{0.5} \\\\  & =-{e}^{-2}+{e}^{0} \\\\  & ≈0.8647\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cf80934d-3233-573f-8300-6e5e2ddf5899"] :db/ensure [:question/validate]} {:db/id "answer-field-cf80934d-3233-573f-8300-6e5e2ddf5899" :answer-field/id #uuid "cf80934d-3233-573f-8300-6e5e2ddf5899" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45bde8d9-4c6e-5ee0-940a-5de511005e14" :answer-field/choices ["answer-ffc1e1f6-fe38-5508-ad8f-639f19a1b5e2" "answer-896a0afd-8d66-500b-9100-28316a76192d" "answer-75826e41-5f0a-5951-9d1b-962bf48353ed" "answer-45bde8d9-4c6e-5ee0-940a-5de511005e14" "answer-70f23a81-9ddb-5bb1-b52a-a90210c0f213"] :db/ensure [:answer-field/validate]} {:db/id "answer-ffc1e1f6-fe38-5508-ad8f-639f19a1b5e2" :answer/id #uuid "ffc1e1f6-fe38-5508-ad8f-639f19a1b5e2" :answer/type :answer.type/math :answer/value "0.8417" :db/ensure [:answer/validate]} {:db/id "answer-896a0afd-8d66-500b-9100-28316a76192d" :answer/id #uuid "896a0afd-8d66-500b-9100-28316a76192d" :answer/type :answer.type/math :answer/value "0.8467" :db/ensure [:answer/validate]} {:db/id "answer-75826e41-5f0a-5951-9d1b-962bf48353ed" :answer/id #uuid "75826e41-5f0a-5951-9d1b-962bf48353ed" :answer/type :answer.type/math :answer/value "0.8596" :db/ensure [:answer/validate]} {:db/id "answer-45bde8d9-4c6e-5ee0-940a-5de511005e14" :answer/id #uuid "45bde8d9-4c6e-5ee0-940a-5de511005e14" :answer/type :answer.type/math :answer/value "0.8647" :db/ensure [:answer/validate]} {:db/id "answer-70f23a81-9ddb-5bb1-b52a-a90210c0f213" :answer/id #uuid "70f23a81-9ddb-5bb1-b52a-a90210c0f213" :answer/type :answer.type/math :answer/value "0.8677" :db/ensure [:answer/validate]} {:db/id "question-eddfe563-295a-5298-9f24-7cdb158be9e9" :question/id #uuid "eddfe563-295a-5298-9f24-7cdb158be9e9" :question/math-academy-id "q-132486" :question/problem "A monitor issues a warning signal when an action is needed as part of a production process. Signals occur continuously in time, independently, and at a constant average rate of one every $0.2$ minutes.  Determine the probability of the next signal occurring within the next $0.4$ minutes. Round your answer to $4$ decimal places." :question/worked-solution "Since the monitor issues a warning signal continuously in time, independently, and at a constant average rate, we can model the time until the next signal appears using an exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the time between successive signals. Since the monitor issues a warning signal every $0.2=\\frac{1}{5}$ minutes, the rate is $\\lambda =5$ signals per minute.\n\nThe times between two successive signals can be modeled as an exponential random variable with rate $\\lambda =5,$ and we can write \n\n$$\nX∼\\text{Exp}(5).\n$$\n\nSo, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}5{e}^{-5x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability of the next signal occurring within the next $0.4$ minutes is\n\n$$\n\\begin{aligned}P(X<0.4) & ={\\int }_{0}^{0.4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{0.4}5{e}^{-5x}\\,\\text{d}x \\\\  & ={-{e}^{-5x}|}_{0}^{0.4} \\\\  & =-{e}^{-2}+{e}^{0} \\\\  & =1-{e}^{-2} \\\\  & ≈0.8647\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4dfd42d-e350-5855-be90-2f0889abb592"] :db/ensure [:question/validate]} {:db/id "answer-field-f4dfd42d-e350-5855-be90-2f0889abb592" :answer-field/id #uuid "f4dfd42d-e350-5855-be90-2f0889abb592" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-596675b4-21d2-5ac4-b0a2-4839e83555d7" :answer-field/choices ["answer-e7be2a9b-7b4a-533e-9a2f-8958ec2a1213" "answer-596675b4-21d2-5ac4-b0a2-4839e83555d7" "answer-5ccd3213-2b5a-598b-9a24-9bb6f2190670" "answer-daa90ef2-43bc-5481-8ed8-ea54977434e3" "answer-d687dca3-0bd3-526a-a4ab-509c47139640"] :db/ensure [:answer-field/validate]} {:db/id "answer-e7be2a9b-7b4a-533e-9a2f-8958ec2a1213" :answer/id #uuid "e7be2a9b-7b4a-533e-9a2f-8958ec2a1213" :answer/type :answer.type/math :answer/value "0.7923" :db/ensure [:answer/validate]} {:db/id "answer-596675b4-21d2-5ac4-b0a2-4839e83555d7" :answer/id #uuid "596675b4-21d2-5ac4-b0a2-4839e83555d7" :answer/type :answer.type/math :answer/value "0.8647" :db/ensure [:answer/validate]} {:db/id "answer-5ccd3213-2b5a-598b-9a24-9bb6f2190670" :answer/id #uuid "5ccd3213-2b5a-598b-9a24-9bb6f2190670" :answer/type :answer.type/math :answer/value "0.8785" :db/ensure [:answer/validate]} {:db/id "answer-daa90ef2-43bc-5481-8ed8-ea54977434e3" :answer/id #uuid "daa90ef2-43bc-5481-8ed8-ea54977434e3" :answer/type :answer.type/math :answer/value "0.8892" :db/ensure [:answer/validate]} {:db/id "answer-d687dca3-0bd3-526a-a4ab-509c47139640" :answer/id #uuid "d687dca3-0bd3-526a-a4ab-509c47139640" :answer/type :answer.type/math :answer/value "0.8980" :db/ensure [:answer/validate]} {:db/id 17592186172007 :knowledge-point/questions ["question-bc8f4760-f931-5737-8a9c-5aab0b30c4bf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bc8f4760-f931-5737-8a9c-5aab0b30c4bf" :question/id #uuid "bc8f4760-f931-5737-8a9c-5aab0b30c4bf" :question/math-academy-id "q-132558" :question/problem "The waiting time for one customer to be served at a cafeteria varies continuously, independently, and at a constant average rate of one person served every $4$  minutes. Determine the probability that the next person is served at least $2$ minutes after the previous one. Round your answer to $4$ decimal places." :question/worked-solution "Since the waiting time for one customer to be served at the cafeteria varies continuously, independently, and at a constant average rate, we can model the time until serving the next person as an exponential distribution.\n\nAn exponential random variable $X$ with rate $\\lambda $ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\lambda {e}^{-\\lambda x}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ be the time needed to serve the next person. The time needed to serve the next person can be modeled as an exponential random variable. Since one person is served every $4$ minutes on average, the rate is $\\lambda =\\frac{1}{4},$ and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{4}).\n$$\n\n In this case, $X$ has the following probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{4}{e}^{-x/4}, & x\\ge 0 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nTherefore, the probability that the next person will be served at least $2$ minutes after the previous one is\n\n$$\n\\begin{aligned}P(X\\ge 2) & ={\\int }_{2}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{\\infty }\\frac{1}{4}{e}^{-x/4}\\,\\text{d}x \\\\  & =-{e}^{-x/4}{|}_{2}^{\\infty } \\\\  & =-{e}^{-\\infty }+{e}^{-2/4} \\\\  & =0+{e}^{-1/2} \\\\  & ={e}^{-1/2} \\\\  & ≈0.6065.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d6c361c4-eefd-5311-9a84-4a9a4e2f34ba"] :db/ensure [:question/validate]} {:db/id "answer-field-d6c361c4-eefd-5311-9a84-4a9a4e2f34ba" :answer-field/id #uuid "d6c361c4-eefd-5311-9a84-4a9a4e2f34ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac5709fe-0354-5d44-b05a-02a21b0da97c" :answer-field/choices ["answer-ac5709fe-0354-5d44-b05a-02a21b0da97c" "answer-e8872e6f-ba5a-570a-bbd3-ab8d4b6496ff" "answer-fba8fc04-0fa8-577c-bd40-5fbcbbc648c7" "answer-d25214fe-4395-53a2-b548-fff04525e163" "answer-dbff2e28-f33a-5f18-8f52-e274e4c55978"] :db/ensure [:answer-field/validate]} {:db/id "answer-ac5709fe-0354-5d44-b05a-02a21b0da97c" :answer/id #uuid "ac5709fe-0354-5d44-b05a-02a21b0da97c" :answer/type :answer.type/math :answer/value "0.6065" :db/ensure [:answer/validate]} {:db/id "answer-e8872e6f-ba5a-570a-bbd3-ab8d4b6496ff" :answer/id #uuid "e8872e6f-ba5a-570a-bbd3-ab8d4b6496ff" :answer/type :answer.type/math :answer/value "0.6153" :db/ensure [:answer/validate]} {:db/id "answer-fba8fc04-0fa8-577c-bd40-5fbcbbc648c7" :answer/id #uuid "fba8fc04-0fa8-577c-bd40-5fbcbbc648c7" :answer/type :answer.type/math :answer/value "0.6565" :db/ensure [:answer/validate]} {:db/id "answer-d25214fe-4395-53a2-b548-fff04525e163" :answer/id #uuid "d25214fe-4395-53a2-b548-fff04525e163" :answer/type :answer.type/math :answer/value "0.6605" :db/ensure [:answer/validate]} {:db/id "answer-dbff2e28-f33a-5f18-8f52-e274e4c55978" :answer/id #uuid "dbff2e28-f33a-5f18-8f52-e274e4c55978" :answer/type :answer.type/math :answer/value "0.6665" :db/ensure [:answer/validate]} {:db/id 17592186172008 :knowledge-point/questions ["question-d44e0172-2699-5b95-8b6b-c9e2c6a8cdf3" "question-f1e2b523-bf44-5c32-9b95-836b1e8d2e60"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d44e0172-2699-5b95-8b6b-c9e2c6a8cdf3" :question/id #uuid "d44e0172-2699-5b95-8b6b-c9e2c6a8cdf3" :question/math-academy-id "q-254581" :question/problem "A customer support team resolves tickets continuously in time, independently, and at a constant average rate of $1$ ticket every $5$ minutes. If a ticket has been open for $20$ minutes already, what is the probability that it will remain unresolved for at least another $10$ minutes? Round your final answer to **three decimal places.**\n\nThe required probability is\n{{field-1}}." :question/worked-solution "Since the customer support team resolves tickets continuously in time, independently, and at a constant average rate, we can model the time until the next ticket is resolved using an exponential distribution.\n\nLet $X$ be the ticket resolving time, in minutes. Since the team resolves $1$ ticket every $5$ minutes on average, the rate is $\\lambda =\\frac{1}{5}$ tickets per minute, and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{5}).\n$$\n\nRecall that exponential random variables have the memoryless property. So, given two positive real numbers $s,t,$ we have that\n\n$$\nP(X>s+t\\,|\\,X>s)=P(X>t)={e}^{-\\lambda t}.\n$$\n\nIn our case, we have $\\lambda =\\frac{1}{5},$ $s=20,$ and $t=10.$ \n\nSubstituting these values into the above formula, we get\n\n$$\n\\begin{aligned}P(X>20+10\\,|\\,X>20) & =P(X>10) \\\\  & ={e}^{-\\lambda t} \\\\  & ={e}^{-(1/5)\\cdot (10)} \\\\  & ={e}^{-2} \\\\  & ≈0.135.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-63853831-cd8f-5815-844b-593361f11ad4"] :db/ensure [:question/validate]} {:db/id "answer-field-63853831-cd8f-5815-844b-593361f11ad4" :answer-field/id #uuid "63853831-cd8f-5815-844b-593361f11ad4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-caa8381d-0308-5944-b790-50b787cd73b8" :answer-field/choices ["answer-caa8381d-0308-5944-b790-50b787cd73b8"] :db/ensure [:answer-field/validate]} {:db/id "answer-caa8381d-0308-5944-b790-50b787cd73b8" :answer/id #uuid "caa8381d-0308-5944-b790-50b787cd73b8" :answer/type :answer.type/math :answer/value "0.135" :db/ensure [:answer/validate]} {:db/id "question-f1e2b523-bf44-5c32-9b95-836b1e8d2e60" :question/id #uuid "f1e2b523-bf44-5c32-9b95-836b1e8d2e60" :question/math-academy-id "q-254609" :question/problem "While riding on a road, a cyclist encounters potholes continuously in time, independently, and at a constant average rate of $4$ potholes per hour. If the cyclist has not encountered any potholes in the past $30$ minutes, what is the probability that he will encounter a pothole in the next $10$ minutes? Round your final answer to **three decimal places.**\n\nThe required probability is\n{{field-1}}." :question/worked-solution "Since the cyclist encounters potholes continuously in time, independently, and at a constant average rate, we can model the time until the next pothole as an exponential distribution.\n\nLet $X$ be the time, in minutes, until the cyclist encounters the next pothole. Since the cyclist encounters, on average, $4$ potholes per hour (or $1$ pothole every $15$ minutes), the rate is $\\lambda =\\frac{1}{15}$ potholes per minute, and we can write \n\n$$\nX∼\\text{Exp}(\\frac{1}{15}).\n$$\n\nRecall that exponential random variables have the memoryless property. Therefore, given two positive real numbers $s,t,$ we have that\n\n$$\nP(X>s+t\\,|\\,X>s)=P(X>t)={e}^{-\\lambda t}.\n$$\n\nWe can compute the complementary conditional probability as follows:\n\n$$\nP(X\\le s+t\\,|\\,X>s)=1-P(X>s+t\\,|\\,X>s)=1-{e}^{-\\lambda t}\n$$\n\nIn our case, we have $\\lambda =\\frac{1}{15},$ $s=30,$ and $t=10.$ \n\nSubstituting these values into the above formula, we get\n\n$$\n\\begin{aligned}P(X\\le 30+10\\,|\\,X>30) & =P(X\\le 10) \\\\  & =1-{e}^{-\\lambda t} \\\\  & =1-{e}^{-(1/15)\\cdot (10)} \\\\  & =1-{e}^{-2/3} \\\\  & ≈0.487.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d936cedc-6149-5dd3-984d-e6f7a43f2a04"] :db/ensure [:question/validate]} {:db/id "answer-field-d936cedc-6149-5dd3-984d-e6f7a43f2a04" :answer-field/id #uuid "d936cedc-6149-5dd3-984d-e6f7a43f2a04" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-99f15c2a-e5fc-5ca0-bb85-07dbfb14f2ce" :answer-field/choices ["answer-99f15c2a-e5fc-5ca0-bb85-07dbfb14f2ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-99f15c2a-e5fc-5ca0-bb85-07dbfb14f2ce" :answer/id #uuid "99f15c2a-e5fc-5ca0-bb85-07dbfb14f2ce" :answer/type :answer.type/math :answer/value "0.487" :db/ensure [:answer/validate]} {:db/id "activity-281bfa6d-174e-50b3-ac57-05c41fca1504" :activity/id #uuid "281bfa6d-174e-50b3-ac57-05c41fca1504" :activity/title "Modeling With the Exponential Distribution" :activity/type :activity.type/review :activity/scope 17592186048224 :activity/course 17592186046660 :activity/steps ["step-e2ceb160-b573-55f7-b63a-adf4cc1b5784" "step-979ed7bb-94cd-5512-96ff-35ef9c614946" "step-cbb06f0a-ea01-532e-b482-4baad0e7d648" "step-33983c3f-9e33-5e47-b127-51f52627feeb" "step-0cfd11fc-dd9a-5b3c-8a96-28e4560b2041"] :activity/first-step "step-e2ceb160-b573-55f7-b63a-adf4cc1b5784" :db/ensure [:activity/validate]} {:db/id "step-e2ceb160-b573-55f7-b63a-adf4cc1b5784" :step/id #uuid "e2ceb160-b573-55f7-b63a-adf4cc1b5784" :step/content "question-1455aec3-db48-5efe-b5bf-59b8688bf438" :step/next "step-979ed7bb-94cd-5512-96ff-35ef9c614946" :db/ensure [:step/validate]} {:db/id "step-979ed7bb-94cd-5512-96ff-35ef9c614946" :step/id #uuid "979ed7bb-94cd-5512-96ff-35ef9c614946" :step/content "question-eddfe563-295a-5298-9f24-7cdb158be9e9" :step/next "step-cbb06f0a-ea01-532e-b482-4baad0e7d648" :db/ensure [:step/validate]} {:db/id "step-cbb06f0a-ea01-532e-b482-4baad0e7d648" :step/id #uuid "cbb06f0a-ea01-532e-b482-4baad0e7d648" :step/content "question-bc8f4760-f931-5737-8a9c-5aab0b30c4bf" :step/next "step-33983c3f-9e33-5e47-b127-51f52627feeb" :db/ensure [:step/validate]} {:db/id "step-33983c3f-9e33-5e47-b127-51f52627feeb" :step/id #uuid "33983c3f-9e33-5e47-b127-51f52627feeb" :step/content "question-d44e0172-2699-5b95-8b6b-c9e2c6a8cdf3" :step/next "step-0cfd11fc-dd9a-5b3c-8a96-28e4560b2041" :db/ensure [:step/validate]} {:db/id "step-0cfd11fc-dd9a-5b3c-8a96-28e4560b2041" :step/id #uuid "0cfd11fc-dd9a-5b3c-8a96-28e4560b2041" :step/content "question-f1e2b523-bf44-5c32-9b95-836b1e8d2e60" :db/ensure [:step/validate]} [:db/retract 17592186127393 :answer-field/choices 17592186127394] [:db/retract 17592186127393 :answer-field/choices 17592186127395] [:db/retract 17592186127393 :answer-field/choices 17592186127396] [:db/retract 17592186127393 :answer-field/choices 17592186127397] [:db/retract 17592186127393 :answer-field/choices 17592186127398] {:db/id 17592186129652 :question/problem "Change the order of integration and evaluate the double integral \n${\\int }_{0}^{2}{\\int }_{y}^{2}{e}^{-{x}^{2}}\\,\\text{d}x\\,\\text{d}y.$" :question/worked-solution "![](images/79/79326f0f463d3b26db4ab497045fa35aa5aa7fb68be6fd79b5ebd633a4d6646f.png)\n\nThe diagram above shows the region of integration. This is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,y\\le x\\le 2\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=y\\,⟹\\,y=x,\n$$\n\nand the bottom boundary is\n\n$$\ny=0.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. Its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le x\\},\n$$\n\nas shown in the diagram below.\n\n![](images/44/4452d48cac6bd387e8f7f27a9aedfbe51f9c5e478a5288f889aa3378c4805d34.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{y}^{2}{e}^{-{x}^{2}}\\,\\text{d}x\\,\\text{d}y & ={\\int }_{0}^{2}{\\int }_{0}^{x}{e}^{-{x}^{2}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{e}^{-{x}^{2}}[{\\int }_{0}^{x}\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{2}{e}^{-{x}^{2}}[y]_{0}^{x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}x{e}^{-{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{2}{e}^{-{x}^{2}}]}_{0}^{2} \\\\  & =\\frac{1}{2}(1-{e}^{-4}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186127393 :answer-field/correct "answer-3290e5fa-709a-5cf8-9205-a80c7e9bb0ed" :answer-field/choices ["answer-8d52f326-a07f-5846-9198-2281c9cb0ce9" "answer-fc472a25-8431-51bb-a98c-291448f6d760" "answer-1158bf19-5d87-5d3c-ae18-4b6a90a7b40f" "answer-3290e5fa-709a-5cf8-9205-a80c7e9bb0ed" "answer-fd3e3379-5ac5-5f47-9142-c0dd3eb25756"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d52f326-a07f-5846-9198-2281c9cb0ce9" :answer/id #uuid "8d52f326-a07f-5846-9198-2281c9cb0ce9" :answer/type :answer.type/math :answer/value "1-e" :db/ensure [:answer/validate]} {:db/id "answer-fc472a25-8431-51bb-a98c-291448f6d760" :answer/id #uuid "fc472a25-8431-51bb-a98c-291448f6d760" :answer/type :answer.type/math :answer/value "1-{e}^{-2}" :db/ensure [:answer/validate]} {:db/id "answer-1158bf19-5d87-5d3c-ae18-4b6a90a7b40f" :answer/id #uuid "1158bf19-5d87-5d3c-ae18-4b6a90a7b40f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(1+{e}^{-4})" :db/ensure [:answer/validate]} {:db/id "answer-3290e5fa-709a-5cf8-9205-a80c7e9bb0ed" :answer/id #uuid "3290e5fa-709a-5cf8-9205-a80c7e9bb0ed" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(1-{e}^{-4})" :db/ensure [:answer/validate]} {:db/id "answer-fd3e3379-5ac5-5f47-9142-c0dd3eb25756" :answer/id #uuid "fd3e3379-5ac5-5f47-9142-c0dd3eb25756" :answer/type :answer.type/math :answer/value "\\frac{1}{4}(1+e)" :db/ensure [:answer/validate]} {:db/id "question-437b2f48-85ba-532a-9ac5-52a828cb51ba" :question/id #uuid "437b2f48-85ba-532a-9ac5-52a828cb51ba" :question/math-academy-id "q-82254" :question/problem "By changing the order of integration in the following double integrals, express the following sum as a single double integral.\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{{x}^{3}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{1}^{2}{\\int }_{0}^{2-x}f(x,y)\\,\\text{d}y\\,\\text{d}x\n$$" :question/worked-solution "![](images/47/472aa6b0afe20f7c1902446102265f758637c9ec00eb985bf38a658dc92f3fe5.png)\n\nThe diagram above shows the region of integration. It consists of two type I regions, given by\n\n$$\n\\begin{aligned}D & =\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le {x}^{3}\\}\\,\\cup \\,\\{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le 2-x\\}.\\end{aligned}\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny={x}^{3}\\,⟹\\,x=\\sqrt[3]{y}\n$$\n\nand the right boundary of the region is\n\n$$\ny=2-x\\,⟹\\,x=2-y.\n$$\n\nTo change the order of integration we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,\\sqrt[3]{y}\\le x\\le 2-y\\},\n$$\n\nas shown in the diagram below.\n\n![](images/77/77b59ce5c40514338b0d23a31e7028c7fa0f7343aad018576301fcc4ec441ac1.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{{x}^{3}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{1}^{2}{\\int }_{0}^{2-x}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{1}{\\int }_{\\sqrt[3]{y}}^{2-y}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d330fe8c-c0b4-581d-86c1-4285baf2910e"] :db/ensure [:question/validate]} {:db/id "answer-field-d330fe8c-c0b4-581d-86c1-4285baf2910e" :answer-field/id #uuid "d330fe8c-c0b4-581d-86c1-4285baf2910e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a97f4e4-20e0-58ad-87bc-d933151f4bf6" :answer-field/choices ["answer-6a97f4e4-20e0-58ad-87bc-d933151f4bf6" "answer-55f54e57-e18b-5d0c-9c19-13b3bfe26010" "answer-bcca3de2-d84e-525d-b4d1-8d4e8c0a5627" "answer-c31f4f8b-4dd6-5e15-bb60-2549b490b990" "answer-1ad97339-5570-5d24-b1fb-77ec680fac1d"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a97f4e4-20e0-58ad-87bc-d933151f4bf6" :answer/id #uuid "6a97f4e4-20e0-58ad-87bc-d933151f4bf6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt[3]{y}}^{2-y}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-55f54e57-e18b-5d0c-9c19-13b3bfe26010" :answer/id #uuid "55f54e57-e18b-5d0c-9c19-13b3bfe26010" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2-y}{\\int }_{\\sqrt[3]{y}}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-bcca3de2-d84e-525d-b4d1-8d4e8c0a5627" :answer/id #uuid "bcca3de2-d84e-525d-b4d1-8d4e8c0a5627" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt[3]{y}}{\\int }_{2-y}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-c31f4f8b-4dd6-5e15-bb60-2549b490b990" :answer/id #uuid "c31f4f8b-4dd6-5e15-bb60-2549b490b990" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt[3]{y}}^{1}{\\int }_{0}^{2-y}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-1ad97339-5570-5d24-b1fb-77ec680fac1d" :answer/id #uuid "1ad97339-5570-5d24-b1fb-77ec680fac1d" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt[3]{y}}^{2-y}{\\int }_{0}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186351412 :question/worked-solution "![](images/d5/d5d777577f85cd577ce35bfd3a99c1e2218622d1856f4fe7ee4afe1cfd2c9f86.png)\n\nThe diagram above shows the region of integration. This is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 8,\\,\\sqrt[3]{y}\\le x\\le 2\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=\\sqrt[3]{y}\\,⟹\\,y={x}^{3},\n$$\n\nand the bottom boundary is\n\n$$\ny=0.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. Its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le {x}^{3}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/05/05ec37a8f4fd33c05a2438df5c5fbc697f8b560fde0b9fe73922a0db56a09c2c.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{8}{\\int }_{\\sqrt[3]{y}}^{2}{e}^{{x}^{4}}\\,\\text{d}x\\,\\text{d}y & ={\\int }_{0}^{2}{\\int }_{0}^{{x}^{3}}{e}^{{x}^{4}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{e}^{{x}^{4}}[{\\int }_{0}^{{x}^{3}}\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{2}{e}^{{x}^{4}}[y]_{0}^{{x}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{x}^{3}\\,{e}^{{x}^{4}}\\,\\text{d}x \\\\  & ={[\\frac{1}{4}{e}^{{x}^{4}}]}_{0}^{2} \\\\  & =\\frac{1}{4}({e}^{16}-1).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-c3ba9c34-ab2d-5d40-bb57-ca2ed5ef7608" :question/id #uuid "c3ba9c34-ab2d-5d40-bb57-ca2ed5ef7608" :question/math-academy-id "q-82347" :question/problem "Change the order of integration in the double integral \n${\\int }_{0}^{1}{\\int }_{{x}^{3}-1}^{1-{x}^{2}}f(x,y)\\,\\text{d}y\\,\\text{d}x.$" :question/worked-solution "![](images/ab/abf9e5dda9e98caac491aa5d94b3e2ae3f08f90d6bd490762adabc1437ac49d9.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}-1\\le y\\le 1-{x}^{2}\\}.\n$$\n\nTo change the order of integration, we need to split $D$ into two type II regions. \n\n![](images/a4/a45e4b63b1eff23617abcbe33ce522652b20de6c817dfde2d9cdda52d12bb778.png)\n\nNotice that the right boundary of the lower region, written in the form $x=x(y),$  is \n\n$\\,$ $x=\\sqrt[3]{y+1}.$\n\nAlso, the right boundary of the upper region, written in the form $x=x(y),$ is\n\n$\\,$ $x=\\sqrt{1-y}.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-1\\le y\\le 0,\\,0\\le x\\le \\sqrt[3]{y+1}\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt{1-y}\\}.\n$$\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{x}^{3}-1}^{1-{x}^{2}}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt[3]{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ad3fdbb4-05c4-5223-8593-ecad3e3ec912"] :db/ensure [:question/validate]} {:db/id "answer-field-ad3fdbb4-05c4-5223-8593-ecad3e3ec912" :answer-field/id #uuid "ad3fdbb4-05c4-5223-8593-ecad3e3ec912" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d96c9ebe-385a-5aa9-8cce-0af1acc3fe17" :answer-field/choices ["answer-d96c9ebe-385a-5aa9-8cce-0af1acc3fe17" "answer-3160ccd4-b4fb-549a-a695-6ba7523ae759" "answer-bce3792a-58d1-5db4-971f-0dd4799c18a1" "answer-e027944a-9ba9-531c-961b-bd1358b11e5b" "answer-1d78785e-c462-55f8-9982-52dc361d2a93"] :db/ensure [:answer-field/validate]} {:db/id "answer-d96c9ebe-385a-5aa9-8cce-0af1acc3fe17" :answer/id #uuid "d96c9ebe-385a-5aa9-8cce-0af1acc3fe17" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt[3]{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-3160ccd4-b4fb-549a-a695-6ba7523ae759" :answer/id #uuid "3160ccd4-b4fb-549a-a695-6ba7523ae759" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{-1}^{1}{\\int }_{0}^{\\sqrt[3]{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-bce3792a-58d1-5db4-971f-0dd4799c18a1" :answer/id #uuid "bce3792a-58d1-5db4-971f-0dd4799c18a1" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{1}{\\int }_{\\sqrt{1-y}}^{\\sqrt[3]{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-e027944a-9ba9-531c-961b-bd1358b11e5b" :answer/id #uuid "e027944a-9ba9-531c-961b-bd1358b11e5b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[3]{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-1d78785e-c462-55f8-9982-52dc361d2a93" :answer/id #uuid "1d78785e-c462-55f8-9982-52dc361d2a93" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{\\sqrt{1-y}}{\\int }_{-1}^{\\sqrt[3]{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186268879 :question/worked-solution "![](images/92/926e4c717707d13fdb9562e149d2f41c3ab657b42fbae35c0953019ab93a06b6.png)\n\nThe diagram above shows the region of integration. This is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,-{y}^{2}-1\\le x\\le -y\\}.\n$$\n\nTo change the order of integration, we need to split $D$ into two type I regions.\n\n![](images/89/8933233e8aca4a36ee90ffec69ca6e93d0523d3fa50c400d2cdea78f9ec80812.png)\n\nNotice that the bottom and top boundaries of the left region, written in the form $y=y(x),$  are \n\n$\\,$ $y=\\sqrt{-x-1}\\,$ and $\\,y=1.$\n\nAlso, the bottom and top boundaries of the right region, written in the form $y=y(x),$ are\n\n$\\,$ $y=0\\,$ and $\\,y=-x.$ \n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-2\\le x\\le -1,\\,\\sqrt{-x-1}\\le y\\le 1\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,-1\\le x\\le 0,\\,0\\le y\\le -x\\}.\n$$\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{-{y}^{2}-1}^{-y}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{-2}^{-1}{\\int }_{\\sqrt{-x-1}}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{-1}^{0}{\\int }_{0}^{-x}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-4fe3e7fe-66b2-56e4-b07b-e2a8d0dd2aac" :activity/id #uuid "4fe3e7fe-66b2-56e4-b07b-e2a8d0dd2aac" :activity/title "Changing the Order of Integration in Double Integrals" :activity/type :activity.type/review :activity/scope 17592186048986 :activity/course 17592186046660 :activity/steps ["step-2ea8c9b7-08dd-5aab-ac0c-8a662422b3d5" "step-b59367e0-e2c1-5b73-8886-7978e62c8aa2" "step-2ef3a076-a0cb-5e87-9202-566dbdfa7430" "step-b6285502-e482-59e6-94a7-bdde0989b515" "step-19c28e52-fdaf-5ad1-b61f-5be844edc12c"] :activity/first-step "step-2ea8c9b7-08dd-5aab-ac0c-8a662422b3d5" :db/ensure [:activity/validate]} {:db/id "step-2ea8c9b7-08dd-5aab-ac0c-8a662422b3d5" :step/id #uuid "2ea8c9b7-08dd-5aab-ac0c-8a662422b3d5" :step/content 17592186129652 :step/next "step-b59367e0-e2c1-5b73-8886-7978e62c8aa2" :db/ensure [:step/validate]} {:db/id "step-b59367e0-e2c1-5b73-8886-7978e62c8aa2" :step/id #uuid "b59367e0-e2c1-5b73-8886-7978e62c8aa2" :step/content "question-437b2f48-85ba-532a-9ac5-52a828cb51ba" :step/next "step-2ef3a076-a0cb-5e87-9202-566dbdfa7430" :db/ensure [:step/validate]} {:db/id "step-2ef3a076-a0cb-5e87-9202-566dbdfa7430" :step/id #uuid "2ef3a076-a0cb-5e87-9202-566dbdfa7430" :step/content 17592186351412 :step/next "step-b6285502-e482-59e6-94a7-bdde0989b515" :db/ensure [:step/validate]} {:db/id "step-b6285502-e482-59e6-94a7-bdde0989b515" :step/id #uuid "b6285502-e482-59e6-94a7-bdde0989b515" :step/content "question-c3ba9c34-ab2d-5d40-bb57-ca2ed5ef7608" :step/next "step-19c28e52-fdaf-5ad1-b61f-5be844edc12c" :db/ensure [:step/validate]} {:db/id "step-19c28e52-fdaf-5ad1-b61f-5be844edc12c" :step/id #uuid "19c28e52-fdaf-5ad1-b61f-5be844edc12c" :step/content 17592186268879 :db/ensure [:step/validate]} [:db/retract 17592186180276 :question/answer-fields 17592186179200] {:db/id 17592186179667 :knowledge-point/questions ["question-c4b9636f-8ac3-587f-891f-98d959ec0c7f" "question-673e501d-d4fb-5f61-85b5-c2fe793fdded" "question-04a3375f-8916-5fd6-a307-59704d7589ef"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179522 :question/problem "Let $R = [0,2]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y) = x+2y.$ Further, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nWrite down the upper Riemann sum $U(f, P).$" :db/ensure [:question/validate]} {:db/id 17592186179668 :knowledge-point/questions ["question-99966b73-9392-5920-a350-678f41228cda"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179523 :question/problem "Let $R = [0,1] \\times [0,2]$ be a region in the $xy$-plane, and let $f(x,y) = 90-x^2-y^2.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nWrite down the upper Riemann sum $U(f, P).$" :db/ensure [:question/validate]} {:db/id 17592186179727 :knowledge-point/questions ["question-9c397521-c62f-5e70-81fc-4938ad811121" "question-5cf5fafd-606c-53b3-9dcd-de496f0b8804"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179589 :question/problem "Let $R = [2,4] \\times [0,1]$ be a region in the $xy$-plane, and let $f(x,y) = 2x - y.$ Further, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nWrite down the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id 17592186345077 :question/problem "Let $R=[1,7]\\times [3,5]$ be a region in the $xy$-plane, and let $f(x,y)=11{x}^{2}+13{y}^{2}-9.$ Further, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id 17592186345075 :question/problem "Let $R=[1,5]\\times [3,7]$ be a region in the $xy$-plane, and let $f(x,y)=4x+5y+23.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id "question-c4b9636f-8ac3-587f-891f-98d959ec0c7f" :question/id #uuid "c4b9636f-8ac3-587f-891f-98d959ec0c7f" :question/math-academy-id "q-75330" :question/problem "Let $R=[-2,4]\\times [-2,2]$ be a region in the $xy$-plane, and let $f(x,y)=3x+4y+15.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=3x+4y+15$ increases as $x$ increases, and\n\n- $f(x,y)=3x+4y+15$ increases as $y$ increases.\n\n![](images/67/67daa328cc6ae4cb37be386c327fb4548844fad2adc10476bdf1147c5a5d4218.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion. \n\n![](images/6e/6e58954fccd74eaf67c95df818c4c9050c35b324c5fffe4902a366cb295b8845.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i},{y}_{j})=3{x}_{i}+4{y}_{j}+15\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is \n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(3{x}_{i}+4{y}_{j}+15)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $3{x}_{i}+4{y}_{j}+15.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-35349d98-38cf-51b3-a918-6967ce0df8e3"] :db/ensure [:question/validate]} {:db/id "answer-field-35349d98-38cf-51b3-a918-6967ce0df8e3" :answer-field/id #uuid "35349d98-38cf-51b3-a918-6967ce0df8e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bcbfcef9-9540-5f6a-8359-e4e8e23a7772" :answer-field/choices ["answer-4d72316c-66bc-5aea-a9e7-6ae3924fdf1c" "answer-9cd98c1d-703c-597a-8457-56abacc2ec64" "answer-8a6b0192-6189-5193-8e9a-847ececf5748" "answer-75554437-49f0-5320-a65f-0aedc0fd5993" "answer-bcbfcef9-9540-5f6a-8359-e4e8e23a7772"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d72316c-66bc-5aea-a9e7-6ae3924fdf1c" :answer/id #uuid "4d72316c-66bc-5aea-a9e7-6ae3924fdf1c" :answer/type :answer.type/math :answer/value "-2{x}_{i-1}+4{y}_{j-1}" :db/ensure [:answer/validate]} {:db/id "answer-9cd98c1d-703c-597a-8457-56abacc2ec64" :answer/id #uuid "9cd98c1d-703c-597a-8457-56abacc2ec64" :answer/type :answer.type/math :answer/value "-2{x}_{i}+4{y}_{j}" :db/ensure [:answer/validate]} {:db/id "answer-8a6b0192-6189-5193-8e9a-847ececf5748" :answer/id #uuid "8a6b0192-6189-5193-8e9a-847ececf5748" :answer/type :answer.type/math :answer/value "3{x}_{i-1}+4{y}_{j-1}+15" :db/ensure [:answer/validate]} {:db/id "answer-75554437-49f0-5320-a65f-0aedc0fd5993" :answer/id #uuid "75554437-49f0-5320-a65f-0aedc0fd5993" :answer/type :answer.type/math :answer/value "3{x}_{i}+4{y}_{j-1}+15" :db/ensure [:answer/validate]} {:db/id "answer-bcbfcef9-9540-5f6a-8359-e4e8e23a7772" :answer/id #uuid "bcbfcef9-9540-5f6a-8359-e4e8e23a7772" :answer/type :answer.type/math :answer/value "3{x}_{i}+4{y}_{j}+15" :db/ensure [:answer/validate]} {:db/id "question-673e501d-d4fb-5f61-85b5-c2fe793fdded" :question/id #uuid "673e501d-d4fb-5f61-85b5-c2fe793fdded" :question/math-academy-id "q-75335" :question/problem "Let $R=[3,4]\\times [1,9]$ be a region in the $xy$-plane, and let $f(x,y)=3{x}^{2}+8{y}^{2}-21.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=3{x}^{2}+8{y}^{2}-21$ increases as $x$ increases on $[3,4],$ and\n\n- $f(x,y)=3{x}^{2}+8{y}^{2}-21$ increases as $y$ increases on $[1,9].$\n\n![](images/67/67daa328cc6ae4cb37be386c327fb4548844fad2adc10476bdf1147c5a5d4218.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion. \n\n![](images/6e/6e58954fccd74eaf67c95df818c4c9050c35b324c5fffe4902a366cb295b8845.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i},{y}_{j})=3{x}_{i}^{2}+8{y}_{j}^{2}-21\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is \n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(3{x}_{i}^{2}+8{y}_{j}^{2}-21)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $3{x}_{i}^{2}+8{y}_{j}^{2}-21.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1d583cc-f66e-5813-a082-71566d0d3d32"] :db/ensure [:question/validate]} {:db/id "answer-field-b1d583cc-f66e-5813-a082-71566d0d3d32" :answer-field/id #uuid "b1d583cc-f66e-5813-a082-71566d0d3d32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-33a66bf5-9641-5334-ad5f-e7355706f660" :answer-field/choices ["answer-811936de-ade0-5a26-bab4-f71405c258e8" "answer-1c785b91-7dde-5c69-9861-fa00efbba2e4" "answer-bfa43db7-19ee-5a17-8c9b-140beab4ca12" "answer-be670f96-af2f-5104-ba75-1e1058afe3cc" "answer-33a66bf5-9641-5334-ad5f-e7355706f660"] :db/ensure [:answer-field/validate]} {:db/id "answer-811936de-ade0-5a26-bab4-f71405c258e8" :answer/id #uuid "811936de-ade0-5a26-bab4-f71405c258e8" :answer/type :answer.type/math :answer/value "3{x}_{i-1}^{2}+4{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1c785b91-7dde-5c69-9861-fa00efbba2e4" :answer/id #uuid "1c785b91-7dde-5c69-9861-fa00efbba2e4" :answer/type :answer.type/math :answer/value "3{x}_{i-1}^{2}+8{y}_{j-1}^{2}-21" :db/ensure [:answer/validate]} {:db/id "answer-bfa43db7-19ee-5a17-8c9b-140beab4ca12" :answer/id #uuid "bfa43db7-19ee-5a17-8c9b-140beab4ca12" :answer/type :answer.type/math :answer/value "3{x}_{i}^{2}+4{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-be670f96-af2f-5104-ba75-1e1058afe3cc" :answer/id #uuid "be670f96-af2f-5104-ba75-1e1058afe3cc" :answer/type :answer.type/math :answer/value "3{x}_{i}^{2}+8{y}_{j-1}^{2}-21" :db/ensure [:answer/validate]} {:db/id "answer-33a66bf5-9641-5334-ad5f-e7355706f660" :answer/id #uuid "33a66bf5-9641-5334-ad5f-e7355706f660" :answer/type :answer.type/math :answer/value "3{x}_{i}^{2}+8{y}_{j}^{2}-21" :db/ensure [:answer/validate]} {:db/id "question-04a3375f-8916-5fd6-a307-59704d7589ef" :question/id #uuid "04a3375f-8916-5fd6-a307-59704d7589ef" :question/math-academy-id "q-75336" :question/problem "Let $R=[3,13]\\times [3,7]$ be a region in the $xy$-plane, and let $f(x,y)=12{x}^{2}+19{y}^{2}+3.$ Further, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=12{x}^{2}+19{y}^{2}+3$ increases as $x$ increases on $[3,13],$ and\n\n- $f(x,y)=12{x}^{2}+19{y}^{2}+3$ increases as $y$ increases on $[3,7].$\n\n![](images/67/67daa328cc6ae4cb37be386c327fb4548844fad2adc10476bdf1147c5a5d4218.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion. \n\n![](images/6e/6e58954fccd74eaf67c95df818c4c9050c35b324c5fffe4902a366cb295b8845.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i},{y}_{j})=12{x}_{i}^{2}+19{y}_{j}^{2}+3\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is \n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(12{x}_{i}^{2}+19{y}_{j}^{2}+3)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $12{x}_{i}^{2}+19{y}_{j}^{2}+3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cdcd0ddb-26c1-5d8a-bd2b-b23dc08e9c29"] :db/ensure [:question/validate]} {:db/id "answer-field-cdcd0ddb-26c1-5d8a-bd2b-b23dc08e9c29" :answer-field/id #uuid "cdcd0ddb-26c1-5d8a-bd2b-b23dc08e9c29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0774869c-17ab-557f-8857-4480eb91d94a" :answer-field/choices ["answer-ee09c78c-70a8-5500-89c2-986568d17805" "answer-a8d9e825-7bbf-5141-a98a-29f6476001ab" "answer-0774869c-17ab-557f-8857-4480eb91d94a" "answer-c9f36db2-863f-50b3-ab2c-fa08a9a54660" "answer-a75c733b-66fd-5d2d-9751-05d2cd9783b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-ee09c78c-70a8-5500-89c2-986568d17805" :answer/id #uuid "ee09c78c-70a8-5500-89c2-986568d17805" :answer/type :answer.type/math :answer/value "12{x}_{i-1}^{2}+19{y}_{j-1}^{2}+3" :db/ensure [:answer/validate]} {:db/id "answer-a8d9e825-7bbf-5141-a98a-29f6476001ab" :answer/id #uuid "a8d9e825-7bbf-5141-a98a-29f6476001ab" :answer/type :answer.type/math :answer/value "12{x}_{i}^{2}+19{y}_{j-1}^{2}+3" :db/ensure [:answer/validate]} {:db/id "answer-0774869c-17ab-557f-8857-4480eb91d94a" :answer/id #uuid "0774869c-17ab-557f-8857-4480eb91d94a" :answer/type :answer.type/math :answer/value "12{x}_{i}^{2}+19{y}_{j}^{2}+3" :db/ensure [:answer/validate]} {:db/id "answer-c9f36db2-863f-50b3-ab2c-fa08a9a54660" :answer/id #uuid "c9f36db2-863f-50b3-ab2c-fa08a9a54660" :answer/type :answer.type/math :answer/value "3{x}_{i-1}^{2}+13{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a75c733b-66fd-5d2d-9751-05d2cd9783b5" :answer/id #uuid "a75c733b-66fd-5d2d-9751-05d2cd9783b5" :answer/type :answer.type/math :answer/value "3{x}_{i}^{2}+13{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186345078 :question/problem "Let $R=[-8,-3]\\times [-6,-1]$ be a region in the $xy$-plane, and let $f(x,y)=17-x-4y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id 17592186180276 :question/problem "Let $R=[2,5]\\times [0,2]$ be a region in the $xy$-plane, and let $f(x,y)=30-{x}^{2}-{y}^{2}.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id 17592186345080 :question/problem "Let $R=[1,2]\\times [2,3]$ be a region in the $xy$-plane, and let $f(x,y)=135-4{x}^{2}-13{y}^{2}.$ Further, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id "question-99966b73-9392-5920-a350-678f41228cda" :question/id #uuid "99966b73-9392-5920-a350-678f41228cda" :question/math-academy-id "q-75343" :question/problem "Let $R=[1,2]\\times [0,1]$ be a region in the $xy$-plane, and let $f(x,y)=30-7{x}^{2}-{y}^{2}.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=30-7{x}^{2}-{y}^{2}$ decreases as $x$ increases on $[1,2],$ and\n\n- $f(x,y)=30-7{x}^{2}-{y}^{2}$ decreases as $y$ increases on $[0,1].$\n\n![](images/ce/ce0d90127e1f14654f4b32a933f1eb6e76e054c03f19ca40c3f04116aa3c2c93.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion. \n\n![](images/5b/5b9967c814e46914e0409854de0960e85339adc9b9fd9693677c8e048c342702.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i-1},{y}_{j-1})=30-7{x}_{i-1}^{2}-{y}_{j-1}^{2}\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is \n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(30-7{x}_{i-1}^{2}-{y}_{j-1}^{2})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $30-7{x}_{i-1}^{2}-{y}_{j-1}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cb481e7c-5d8d-53d5-9e18-52a463a65ce9"] :db/ensure [:question/validate]} {:db/id "answer-field-cb481e7c-5d8d-53d5-9e18-52a463a65ce9" :answer-field/id #uuid "cb481e7c-5d8d-53d5-9e18-52a463a65ce9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1cfc5863-10cb-5335-a148-db1b1bd8a278" :answer-field/choices ["answer-1cfc5863-10cb-5335-a148-db1b1bd8a278" "answer-f6989548-b253-5d58-9496-78aaaa7ae19f" "answer-a65ac1d2-a5e8-5ab2-8ba3-b59029d1c01a" "answer-a17fd14c-4cbd-5250-9e97-2fa1d30d04c9" "answer-9505f95f-c4ca-5a9e-9b47-c966b0831bbd"] :db/ensure [:answer-field/validate]} {:db/id "answer-1cfc5863-10cb-5335-a148-db1b1bd8a278" :answer/id #uuid "1cfc5863-10cb-5335-a148-db1b1bd8a278" :answer/type :answer.type/math :answer/value "30-7{x}_{i-1}^{2}-{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f6989548-b253-5d58-9496-78aaaa7ae19f" :answer/id #uuid "f6989548-b253-5d58-9496-78aaaa7ae19f" :answer/type :answer.type/math :answer/value "30-7{x}_{i-1}^{2}-{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a65ac1d2-a5e8-5ab2-8ba3-b59029d1c01a" :answer/id #uuid "a65ac1d2-a5e8-5ab2-8ba3-b59029d1c01a" :answer/type :answer.type/math :answer/value "30-7{x}_{i}^{2}-{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-a17fd14c-4cbd-5250-9e97-2fa1d30d04c9" :answer/id #uuid "a17fd14c-4cbd-5250-9e97-2fa1d30d04c9" :answer/type :answer.type/math :answer/value "{x}_{i-1}^{2}+2{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-9505f95f-c4ca-5a9e-9b47-c966b0831bbd" :answer/id #uuid "9505f95f-c4ca-5a9e-9b47-c966b0831bbd" :answer/type :answer.type/math :answer/value "{x}_{i-1}^{2}+2{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186393528 :question/problem "Let $R=[0,7]\\times [-6,-5]$ be a region in the $xy$-plane, and let $f(x,y)=-5x-11y-8.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id 17592186256729 :question/problem "Let $R=[-2,2]\\times [-5,-1]$ be a region in the $xy$-plane, and let $f(x,y)=7x-11y+5.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$\nwhat is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id 17592186180271 :question/problem "Let $R=[15,20]\\times [3,5]$ be a region in the $xy$-plane, and let $f(x,y)=x-3y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$\nwhat is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id "question-9c397521-c62f-5e70-81fc-4938ad811121" :question/id #uuid "9c397521-c62f-5e70-81fc-4938ad811121" :question/math-academy-id "q-75346" :question/problem "Let $R=[2,7]\\times [-13,-5]$ be a region in the $xy$-plane, and let $f(x,y)=4x-7y+8.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$\nwhat is the missing expression in the double summation above?" :question/worked-solution "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below.\n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=4x-7y+8$ increases as $x$ increases, and\n\n- $f(x,y)=4x-7y+8$ decreases as $y$ increases.\n\n![](images/01/01b291ca7cd81b88cf6ed06fdcdb2ffcbb1f78255d0f57d496823d347c2fb0b3.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom right corner* of each subregion.\n\n![](images/de/de36b521dea1f925754a9c630c3d4a2c405c087a191138f1eaaa5771becb8c21.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i},{y}_{j-1})=4{x}_{i}-7{y}_{j-1}+8\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is \n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(4{x}_{i}-7{y}_{j-1}+8)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $4{x}_{i}-7{y}_{j-1}+8.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aba656f0-e898-54a7-a1c1-6750e9415410"] :db/ensure [:question/validate]} {:db/id "answer-field-aba656f0-e898-54a7-a1c1-6750e9415410" :answer-field/id #uuid "aba656f0-e898-54a7-a1c1-6750e9415410" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba18a7f8-97b5-59e7-a2f1-073cd338f901" :answer-field/choices ["answer-af042d8b-3aec-5864-a14e-8d95c4e5559b" "answer-8dd39250-f64f-534c-a6a8-0df2efc4e38e" "answer-ce01a2a2-1a32-54dd-b84a-7836fba67bbc" "answer-ba18a7f8-97b5-59e7-a2f1-073cd338f901" "answer-1844e6f9-d3f7-592f-a4e7-94876f5aa91c"] :db/ensure [:answer-field/validate]} {:db/id "answer-af042d8b-3aec-5864-a14e-8d95c4e5559b" :answer/id #uuid "af042d8b-3aec-5864-a14e-8d95c4e5559b" :answer/type :answer.type/math :answer/value "2{x}_{i-1}+7{y}_{j}" :db/ensure [:answer/validate]} {:db/id "answer-8dd39250-f64f-534c-a6a8-0df2efc4e38e" :answer/id #uuid "8dd39250-f64f-534c-a6a8-0df2efc4e38e" :answer/type :answer.type/math :answer/value "2{x}_{i}+7{y}_{j-1}" :db/ensure [:answer/validate]} {:db/id "answer-ce01a2a2-1a32-54dd-b84a-7836fba67bbc" :answer/id #uuid "ce01a2a2-1a32-54dd-b84a-7836fba67bbc" :answer/type :answer.type/math :answer/value "4{x}_{i-1}-7{y}_{j}+8" :db/ensure [:answer/validate]} {:db/id "answer-ba18a7f8-97b5-59e7-a2f1-073cd338f901" :answer/id #uuid "ba18a7f8-97b5-59e7-a2f1-073cd338f901" :answer/type :answer.type/math :answer/value "4{x}_{i}-7{y}_{j-1}+8" :db/ensure [:answer/validate]} {:db/id "answer-1844e6f9-d3f7-592f-a4e7-94876f5aa91c" :answer/id #uuid "1844e6f9-d3f7-592f-a4e7-94876f5aa91c" :answer/type :answer.type/math :answer/value "4{x}_{i}-7{y}_{j}+8" :db/ensure [:answer/validate]} {:db/id "question-5cf5fafd-606c-53b3-9dcd-de496f0b8804" :question/id #uuid "5cf5fafd-606c-53b3-9dcd-de496f0b8804" :question/math-academy-id "q-170684" :question/problem "Let $R=[-1,3]\\times [-4,-2]$ be a region in the $xy$-plane, and let $f(x,y)=8y-2x-5.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :question/worked-solution "The upper Riemann sum is given by\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{M}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below.\n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=8y-2x-5$ decreases as $x$ increases, and\n\n- $f(x,y)=8y-2x-5$ increases as $y$ increases.\n\n![](images/ff/ffa57d3e7fed08212f12d4b9d7c2e0a4d33a3aac71c8b8a03d1a9a7364484deb.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *largest* possible $y.$ This is the value at the *top left corner* of each subregion.\n\n![](images/74/74d546d91e145efea49b70af56cb472e8bbbd1417725cd7fa92a3a278cad75ea.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i-1},{y}_{j})=8{y}_{j}-2{x}_{i-1}-5\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is\n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(8{y}_{j}-2{x}_{i-1}-5)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $8{y}_{j}-2{x}_{i-1}-5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-edd2fc28-bb7b-522b-8b22-9cd25ae03847"] :db/ensure [:question/validate]} {:db/id "answer-field-edd2fc28-bb7b-522b-8b22-9cd25ae03847" :answer-field/id #uuid "edd2fc28-bb7b-522b-8b22-9cd25ae03847" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebaa5111-af23-5adf-b4a4-fb1b96aafaa6" :answer-field/choices ["answer-9efd5c77-2cb1-5be1-800e-6b69df9db58e" "answer-a320cf0c-d21a-5986-b52e-7e793989a2a9" "answer-170bd9f4-1de2-54a2-9348-e26f2a20b717" "answer-ebaa5111-af23-5adf-b4a4-fb1b96aafaa6" "answer-8ec7b257-6e52-550f-bdbe-6ce6252546d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-9efd5c77-2cb1-5be1-800e-6b69df9db58e" :answer/id #uuid "9efd5c77-2cb1-5be1-800e-6b69df9db58e" :answer/type :answer.type/math :answer/value "-2{y}_{j-1}-{x}_{i-1}-5" :db/ensure [:answer/validate]} {:db/id "answer-a320cf0c-d21a-5986-b52e-7e793989a2a9" :answer/id #uuid "a320cf0c-d21a-5986-b52e-7e793989a2a9" :answer/type :answer.type/math :answer/value "-2{y}_{j}+3{x}_{i}-5" :db/ensure [:answer/validate]} {:db/id "answer-170bd9f4-1de2-54a2-9348-e26f2a20b717" :answer/id #uuid "170bd9f4-1de2-54a2-9348-e26f2a20b717" :answer/type :answer.type/math :answer/value "8{y}_{j-1}-2{x}_{i-1}-5" :db/ensure [:answer/validate]} {:db/id "answer-ebaa5111-af23-5adf-b4a4-fb1b96aafaa6" :answer/id #uuid "ebaa5111-af23-5adf-b4a4-fb1b96aafaa6" :answer/type :answer.type/math :answer/value "8{y}_{j}-2{x}_{i-1}-5" :db/ensure [:answer/validate]} {:db/id "answer-8ec7b257-6e52-550f-bdbe-6ce6252546d5" :answer/id #uuid "8ec7b257-6e52-550f-bdbe-6ce6252546d5" :answer/type :answer.type/math :answer/value "8{y}_{j}-2{x}_{i}-5" :db/ensure [:answer/validate]} {:db/id 17592186364385 :question/problem "Let $R=[2,3]\\times [11,13]$ be a region in the $xy$-plane, and let $f(x,y)=3y-8x-6.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the upper Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nU(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" :db/ensure [:question/validate]} {:db/id 17592186180711 :tutorial/content "We know how to write the upper Riemann sum for a function $f(x,y)$ over a *fixed* rectangular partition. In this lesson, we will learn how to write down an expression for the upper Riemann sum for an *arbitrary* rectangular partition. \n\nAs a concrete example, let $R = [0,1] \\times [0,1]$ be a region in the $xy$-plane, and define the function $f(x,y)$ as \n\n$$\nf(x,y) = x^2+y^2.\n$$\n\nFurther, let $P$ be an arbitrary partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{{x}_{0},{x}_{1},…,{x}_{m}\\},\\,{P}_{2}=\\{{y}_{0},{y}_{1},…,{y}_{n}\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nOur goal is to find an expression for $U(f, P),$ the upper Riemann sum of $f$ with respect to this partition. We proceed identically to the case where $P$ was fixed.\n\nFirst, we consider an arbitrary subregion $R_{ij}$ of the partition. This subregion lies between $x_{i-1}$ and $x_i$ over the $x$-axis and $y_{j-1}$ and $y_j$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nSince we're computing the *upper* sum, we're interested in the *maximum* value of $f$ in this subregion.\n\nNotice that\n\n- $f(x,y) = x^2+y^2$ increases as $x$ increases on $[0,1],$ and\n\n- $f(x,y) = x^2+y^2$ increases as $y$ increases on $[0,1].$\n\n![](images/67/67daa328cc6ae4cb37be386c327fb4548844fad2adc10476bdf1147c5a5d4218.png)\n\nTherefore, the *maximum* value of $f$ in the subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value of $f$ at the *top right corner* of the subregion.\n\n![](images/6e/6e58954fccd74eaf67c95df818c4c9050c35b324c5fffe4902a366cb295b8845.png)\n\nSo, if $M_{ij}$ denotes the maximum value of $f$ in each subregion, we have\n\n$$\nM_{ij} = f(x_{i}, y_{j}) = x_{i}^2 + y_{j}^2\n$$\n\nfor all $1\\leq i\\leq m$ and $1\\leq j\\leq n.$ \n\nSince the area of $R_{ij}$ is $\\Delta x_i\\Delta y_j,$ the volume of the rectangular solid with base $R_{ij}$ and height $M_{ij}$ is\n\n$$\nM_{ij}\\Delta x_i\\Delta y_j = (x_{i}^2 + y_{j}^2)\\Delta x_i \\Delta y_j\n$$\n\nFinally, summing up all of our rectangular solids over the entire partition $P$, we find that the upper Riemann sum is given by\n\n$$\nU(f,P) = \\sum_{i=1}^m\\sum_{j=1}^n (x_{i}^2 + y_{j}^2)\\Delta x_i \\Delta y_j \\, .\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186179850 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186179674 :knowledge-point/questions ["question-b91bd5f9-20da-5be7-a581-8dc4f819e202"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b91bd5f9-20da-5be7-a581-8dc4f819e202" :question/id #uuid "b91bd5f9-20da-5be7-a581-8dc4f819e202" :question/math-academy-id "q-90869" :question/problem "If the path $C$ is a part of the curve $y={x}^{3}+1$ traversed from the point $A(0,1)$ to point $B(1,2),$ then ${\\int }_{C}x\\,dx+(y-1)\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y={x}^{3}+1.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j=t\\,i+({t}^{3}+1)\\,j,\\,t\\in [0,1]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=i+3{t}^{2}\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx+(y-1)\\,dy & ={\\int }_{0}^{1}x\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+(y-1)\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(x\\,\\frac{\\text{d}x}{\\text{d}t}+(y-1)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\cdot 1+({t}^{3}+1-1)\\cdot 3{t}^{2}\\,dt \\\\  & ={\\int }_{0}^{1}t+3{t}^{5}\\,dt \\\\  & ={[\\frac{{t}^{2}}{2}+\\frac{{t}^{6}}{2}]}_{0}^{1} \\\\  & =[\\frac{1}{2}+\\frac{1}{2}]-[0] \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1c8cb632-7694-5ff5-badc-7d0d79044a59"] :db/ensure [:question/validate]} {:db/id "answer-field-1c8cb632-7694-5ff5-badc-7d0d79044a59" :answer-field/id #uuid "1c8cb632-7694-5ff5-badc-7d0d79044a59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b92f50e1-a193-531b-b6de-1ecbee0c7393" :answer-field/choices ["answer-b92f50e1-a193-531b-b6de-1ecbee0c7393" "answer-1262143b-7987-5866-b438-9f2860a6f4b1" "answer-7acbde24-d396-507e-bab6-65ef61f8c0e8" "answer-1e590f80-d8cd-59b5-80b8-713187c9aae9" "answer-ba6eaf80-e94b-55c5-8508-94c9b3e1a5d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-b92f50e1-a193-531b-b6de-1ecbee0c7393" :answer/id #uuid "b92f50e1-a193-53