[{:db/id 17592186204103 :knowledge-point/questions ["question-17d82828-3c8a-5034-bf42-fab4e2f3cbb6" "question-d8c2cd33-feb8-5850-af19-6e3631c29b25" "question-1203c4f3-0f74-5bfe-84b7-69d8fde66e20"] :db/ensure [:knowledge-point/validate]} {:db/id "question-17d82828-3c8a-5034-bf42-fab4e2f3cbb6" :question/id #uuid "17d82828-3c8a-5034-bf42-fab4e2f3cbb6" :question/math-academy-id "q-265744" :question/problem "Given the function \n\n$$\nf(w)=-3‖w{‖}^{2}-2\n$$\n\nthat maps a vector to a scalar, find ${∇}_{w}f.$" :question/worked-solution "Using the result \n\n$$\n{∇}_{w}({w}^{T}w)=2w,\n$$\n\nwe have\n\n$$\n\\begin{aligned}{∇}_{w}f & ={∇}_{w}(-3‖w{‖}^{2}-2) \\\\  & =-3\\cdot {∇}_{w}(‖w{‖}^{2})-{∇}_{w}(2) \\\\  & =-3\\cdot {∇}_{w}({w}^{T}w)-{∇}_{w}(2) \\\\  & =-3\\cdot 2w+0 \\\\  & =-6w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c2d8ec61-54a3-524d-ac1c-f8499eaaacb1"] :db/ensure [:question/validate]} {:db/id "answer-field-c2d8ec61-54a3-524d-ac1c-f8499eaaacb1" :answer-field/id #uuid "c2d8ec61-54a3-524d-ac1c-f8499eaaacb1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d839084-ebf5-50a1-84e8-aaab3647d2f2" :answer-field/choices ["answer-8cdc6452-7362-5379-a198-0f6e095833c0" "answer-6a10b282-678e-5e67-8c59-8dfb7a853cc4" "answer-2d839084-ebf5-50a1-84e8-aaab3647d2f2" "answer-c4904ffb-8abe-5c81-add0-ac73a2f9a0df" "answer-3cdd1bc7-4812-57f7-81c8-e65554be4222"] :db/ensure [:answer-field/validate]} {:db/id "answer-8cdc6452-7362-5379-a198-0f6e095833c0" :answer/id #uuid "8cdc6452-7362-5379-a198-0f6e095833c0" :answer/type :answer.type/math :answer/value "-3w" :db/ensure [:answer/validate]} {:db/id "answer-6a10b282-678e-5e67-8c59-8dfb7a853cc4" :answer/id #uuid "6a10b282-678e-5e67-8c59-8dfb7a853cc4" :answer/type :answer.type/math :answer/value "-3‖w‖" :db/ensure [:answer/validate]} {:db/id "answer-2d839084-ebf5-50a1-84e8-aaab3647d2f2" :answer/id #uuid "2d839084-ebf5-50a1-84