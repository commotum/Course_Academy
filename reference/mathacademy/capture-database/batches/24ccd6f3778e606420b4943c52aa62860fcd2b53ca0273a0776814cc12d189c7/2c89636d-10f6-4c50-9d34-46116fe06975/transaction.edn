 :step/id #uuid "6a27ed93-d9fc-5a3b-aed8-ac5ef31f0899" :step/content 17592186387540 :step/next "step-2239de45-f796-5aa0-9650-16fd55b31717" :db/ensure [:step/validate]} {:db/id "step-2239de45-f796-5aa0-9650-16fd55b31717" :step/id #uuid "2239de45-f796-5aa0-9650-16fd55b31717" :step/content 17592186259703 :step/next "step-3b7fac8d-ca12-55ac-97d4-a24cb9a1ad25" :db/ensure [:step/validate]} {:db/id "step-3b7fac8d-ca12-55ac-97d4-a24cb9a1ad25" :step/id #uuid "3b7fac8d-ca12-55ac-97d4-a24cb9a1ad25" :step/content 17592186259705 :db/ensure [:step/validate]} {:db/id 17592186092217 :knowledge-point/questions ["question-04c21b11-d6eb-5e2f-9a68-02bdca097cfd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-04c21b11-d6eb-5e2f-9a68-02bdca097cfd" :question/id #uuid "04c21b11-d6eb-5e2f-9a68-02bdca097cfd" :question/math-academy-id "q-133225" :question/problem "Let $x(\\theta )$ and $y(\\theta )$ represent the $x$- and $y$-coordinates of a point on the given curve. Write expressions for $x(\\theta )$ and $y(\\theta )$ in terms of $\\theta .$\n\n$x(\\theta )\\,=$\n{{field-1}}\n\n$y(\\theta )\\,=$\n{{field-2}}" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use \n\n> $x=r\\operatorname{cos}⁡\\theta \\,$ and $\\,y=r\\operatorname{sin}⁡\\theta ,$\n\nwhere $x,$ $y,$ and $r$ are functions of $\\theta .$\n\nUsing the fact that $r=6\\operatorname{sin}⁡\\theta ,$ we get \n\n$$\nx=6\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta =3\\operatorname{sin}⁡(2\\theta )\n$$\n\nand \n\n$$\ny=6\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta =6{sin}^{2}⁡\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-01f795ef-1bd6-53d0-93e4-2f6075fc9d94" "answer-field-e4daa789-6251-5dc2-bff5-c7b29f5e7178"] :db/ensure [:question/validate]} {:db/id "answer-field-01f795ef-1bd6-53d0-93e4-2f6075fc9d94" :answer-field/id #uuid "01f795ef-1bd6-53d0-93e4-2f6075fc9d94" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4c14f59e-67b0-5401-9f45-fbeeee924851" :answer-field/choices ["answer-4c14f59e-67b0-5401-9f45-fbeeee924851"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c14f59e-67b0-5401-9f45-fbeeee924851" :answer/id #uuid "4c14f59e-67b0-5401-9f45-fbeeee924851" :answer/type :answer.type/math :answer/value "6\\sin\\theta\\cos\\theta" :db/ensure [:answer/validate]} {:db/id "answer-field-e4daa789-6251-5dc2-bff5-c7b29f5e7178" :answer-field/id #uuid "e4daa789-6251-5dc2-bff5-c7b29f5e7178" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-12f16dc6-ec6f-552f-87c4-2a50bc7836ff" :answer-field/choices ["answer-12f16dc6-ec6f-552f-87c4-2a50bc7836ff"] :db/ensure [:answer-field/validate]} {:db/id "answer-12f16dc6-ec6f-552f-87c4-2a50bc7836ff" :answer/id #uuid "12f16dc6-ec6f-552f-87c4-2a50bc7836ff" :answer/type :answer.type/math :answer/value "6\\sin^2\\theta" :db/ensure [:answer/validate]} {:db/id 17592186064283 :knowledge-point/questions ["question-2749929e-e01c-5706-82d9-161e96c84d4c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2749929e-e01c-5706-82d9-161e96c84d4c" :question/id #uuid "2749929e-e01c-5706-82d9-161e96c84d4c" :question/math-academy-id "q-133226" :question/problem "Find the derivative of $y(\\theta )=6{sin}^{2}⁡\\theta $ with respect to $\\theta .$\n\n${y}^{′}(\\theta )\\,=$\n{{field-1}}" :question/worked-solution "First, we write\n\n$$\ny(\\theta )=6(\\operatorname{sin}⁡\\theta )^{2}.\n$$\n\nNow, we see that $y(\\theta )$ can be expressed as the composite function\n\n$$\ny=6{u}^{2},\\,u=\\operatorname{sin}⁡\\theta .\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=12u,\\,\\frac{\\text{d}u}{\\text{d}\\theta }=\\operatorname{cos}⁡\\theta .\n$$\n\nFinally, we apply the chain rule:\n\n$$\n\\begin{aligned}{y}^{′}(\\theta ) & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}\\theta } \\\\  & =12u\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(2\\theta )\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a6c39e3b-1f65-52da-8eaa-e6691231acd4"] :db/ensure [:question/validate]} {:db/id "answer-field-a6c39e3b-1f65-52da-8eaa-e6691231acd4" :answer-field/id #uuid "a6c39e3b-1f65-52da-8eaa-e6691231acd4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-057a3821-57db-58af-a32b-c16f7c0710fb" :answer-field/choices ["answer-057a3821-57db-58af-a32b-c16f7c0710fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-057a3821-57db-58af-a32b-c16f7c0710fb" :answer/id #uuid "057a3821-57db-58af-a32b-c16f7c0710fb" :answer/type :answer.type/math :answer/value "12\\sin\\theta\\cos\\theta" :db/ensure [:answer/validate]} {:db/id 17592186064281 :knowledge-point/questions ["question-39c6a843-fd29-52a1-8f7b-ab703e4af195"] :db/ensure [:knowledge-point/validate]} {:db/id "question-39c6a843-fd29-52a1-8f7b-ab703e4af195" :question/id #uuid "39c6a843-fd29-52a1-8f7b-ab703e4af195" :question/math-academy-id "q-133227" :question/problem "Find the derivative of $x(\\theta )=3\\operatorname{sin}⁡2\\theta \\,$  with respect to $\\theta .$\n\n${x}^{′}(\\theta )\\,=$\n{{field-1}}" :question/worked-solution "First, we write our function as the composite function\n\n$$\nx=3\\operatorname{sin}⁡u,\\,u=2\\theta .\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}x}{\\text{d}u}=3\\operatorname{cos}⁡u,\\,\\frac{\\text{d}u}{\\text{d}\\theta }=2.\n$$\n\nFinally, we apply the chain rule:\n\n$$\n\\begin{aligned}{x}^{′}(\\theta ) & =\\frac{\\text{d}x}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}\\theta } \\\\  & =3\\operatorname{cos}⁡u\\cdot 2 \\\\  & =6\\operatorname{cos}⁡(2\\theta )\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6801a841-fd4f-5ab4-9b8b-02b1c63e34e1"] :db/ensure [:question/validate]} {:db/id "answer-field-6801a841-fd4f-5ab4-9b8b-02b1c63e34e1" :answer-field/id #uuid "6801a841-fd4f-5ab4-9b8b-02b1c63e34e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-72ccc92d-1a43-5830-a890-7c4034c25b9e" :answer-field/choices ["answer-72ccc92d-1a43-5830-a890-7c4034c25b9e"] :db/ensure [:answer-field/validate]} {:db/id "answer-72ccc92d-1a43-5830-a890-7c4034c25b9e" :answer/id #uuid "72ccc92d-1a43-5830-a890-7c4034c25b9e" :answer/type :answer.type/math :answer/value "6\\cos(2\\theta)" :db/ensure [:answer/validate]} {:db/id 17592186092236 :knowledge-point/questions ["question-00bb583b-38c4-5b10-945e-a15928b12671" "question-9ab9373f-f442-5c71-ba1a-50adb5530bb2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-00bb583b-38c4-5b10-945e-a15928b12671" :question/id #uuid "00bb583b-38c4-5b10-945e-a15928b12671" :question/math-academy-id "q-133228" :question/problem "Find the slope of the tangent line to the given polar curve at $\\theta =\\frac{\\pi }{3}.$\n\nSlope $=$\n{{field-1}}" :question/worked-solution "In parts 2 and 3, we found that\n\n$$\n{x}^{′}(\\theta )=6\\operatorname{cos}⁡(2\\theta ),\\,{y}^{′}(\\theta )=6\\operatorname{sin}⁡(2\\theta ).\n$$\n\nNow, to find $\\frac{\\text{d}y}{\\text{d}x},$ we use the rule\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nWe have\n\n$$\n\\begin{aligned}{x}^{′}(\\frac{\\pi }{3}) & =6\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3.\\end{aligned}\n$$\n\n \n\nand \n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{3}) & =6\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{\\theta =\\pi /3} & =\\frac{{y}^{′}(\\frac{\\pi }{3})}{{x}^{′}(\\frac{\\pi }{3})} \\\\  & =\\frac{3\\sqrt{3}}{(-3)} \\\\  & =-\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-978ca5a5-cf10-5fbd-84fe-abe606da7ae7"] :db/ensure [:question/validate]} {:db/id "answer-field-978ca5a5-cf10-5fbd-84fe-abe606da7ae7" :answer-field/id #uuid "978ca5a5-cf10-5fbd-84fe-abe606da7ae7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-406dddda-d7bc-5487-ac5d-0ec92eae17bf" :answer-field/choices ["answer-406dddda-d7bc-5487-ac5d-0ec92eae17bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-406dddda-d7bc-5487-ac5d-0ec92eae17bf" :answer/id #uuid "406dddda-d7bc-5487-ac5d-0ec92eae17bf" :answer/type :answer.type/math :answer/value "-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-9ab9373f-f442-5c71-ba1a-50adb5530bb2" :question/id #uuid "9ab9373f-f442-5c71-ba1a-50adb5530bb2" :question/math-academy-id "q-133229" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ for our polar curve.\n\n$\\frac{\\text{d}y}{\\text{d}x}\\,=$\n{{field-1}}" :question/worked-solution "In parts 2 and 3, we found that\n\n$$\n{x}^{′}(\\theta )=6\\operatorname{cos}⁡(2\\theta ),\\,{y}^{′}(\\theta )=6\\operatorname{sin}⁡(2\\theta ).\n$$\n\nNow, to find $\\frac{\\text{d}y}{\\text{d}x},$ we use the rule\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(\\theta )}{{x}^{′}(\\theta )}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{6\\operatorname{sin}⁡(2\\theta )}{6\\operatorname{cos}⁡(2\\theta )} \\\\  & =\\operatorname{tan}⁡(2\\theta ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-11a19155-2e88-5b5a-862a-2fa9b9a1fcef"] :db/ensure [:question/validate]} {:db/id "answer-field-11a19155-2e88-5b5a-862a-2fa9b9a1fcef" :answer-field/id #uuid "11a19155-2e88-5b5a-862a-2fa9b9a1fcef" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-468ff7ca-997b-5f76-b758-48e278bc21a9" :answer-field/choices ["answer-468ff7ca-997b-5f76-b758-48e278bc21a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-468ff7ca-997b-5f76-b758-48e278bc21a9" :answer/id #uuid "468ff7ca-997b-5f76-b758-48e278bc21a9" :answer/type :answer.type/math :answer/value "\\tan(2\\theta)" :db/ensure [:answer/validate]} {:db/id 17592186188262 :knowledge-point/questions ["question-9dac1de0-3399-5e2c-82ff-248d3a51fed2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9dac1de0-3399-5e2c-82ff-248d3a51fed2" :question/id #uuid "9dac1de0-3399-5e2c-82ff-248d3a51fed2" :question/math-academy-id "q-133230" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for our polar curve.\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,=$\n{{field-1}}" :question/worked-solution "We will use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\frac{\\frac{d}{d\\theta }(\\frac{dy}{dx})}{(\\frac{dx}{d\\theta })}.\\end{aligned}\n$$\n\nPreviously, we've found that\n\n$\\,$ $\\frac{dx}{d\\theta }=6\\operatorname{cos}⁡(2\\theta )\\,$ and $\\,\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{tan}⁡(2\\theta ).$ \n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{d}{d\\theta }(\\frac{dy}{dx}) & =\\frac{d}{d\\theta }(\\operatorname{tan}⁡(2\\theta )) \\\\  & ={sec}^{2}⁡(2\\theta )\\cdot 2 \\\\  & =2{sec}^{2}⁡(2\\theta ).\\end{aligned}\n$$\n\nFinally, substituting into our formula for the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{2{sec}^{2}⁡(2\\theta )}{6\\operatorname{cos}⁡(2\\theta )} \\\\  & =\\frac{1}{3}{sec}^{3}⁡(2\\theta ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b75a3698-1ee7-50e3-b39c-ded471e1e2de"] :db/ensure [:question/validate]} {:db/id "answer-field-b75a3698-1ee7-50e3-b39c-ded471e1e2de" :answer-field/id #uuid "b75a3698-1ee7-50e3-b39c-ded471e1e2de" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3965b942-4bfa-58af-87a2-5bee1c709bae" :answer-field/choices ["answer-3965b942-4bfa-58af-87a2-5bee1c709bae"] :db/ensure [:answer-field/validate]} {:db/id "answer-3965b942-4bfa-58af-87a2-5bee1c709bae" :answer/id #uuid "3965b942-4bfa-58af-87a2-5bee1c709bae" :answer/type :answer.type/math :answer/value "\\frac{1}{3\\cos^3(2\\theta)}" :db/ensure [:answer/validate]} {:db/id 17592186184177 :knowledge-point/questions ["question-5bcca525-fc41-52cc-be8b-f245ac9162a9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5bcca525-fc41-52cc-be8b-f245ac9162a9" :question/id #uuid "5bcca525-fc41-52cc-be8b-f245ac9162a9" :question/math-academy-id "q-133231" :question/problem "Find the equation of the tangent line to our polar curve at $\\theta =\\frac{\\pi }{3}.$\n\nThe tangent line is $y\\,=$\n{{field-1}}" :question/worked-solution "Previously, we found that the slope of the tangent line at $\\theta =\\frac{\\pi }{3}$ is\n\n$$\nm=-\\sqrt{3}.\n$$\n\nThe equation of the tangent is\n\n$$\ny-{y}_{0}=m(x-{x}_{0}),\n$$\n\nwhere $({x}_{0},{y}_{0})$ are the coordinates of the point on the curve that correspond to $\\theta =\\frac{\\pi }{3}.$ Let's work these out. \n\nIn part 1, we found that\n\n$\\,$ $x(\\theta )=3\\operatorname{sin}⁡(2\\theta )\\,$ and $\\,y(\\theta )=6{sin}^{2}⁡\\theta .$\n\nAs a result, we have\n\n$$\n\\begin{aligned}{x}_{0} & =3\\operatorname{sin}⁡(2\\theta ) \\\\  & =3\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{3}) \\\\  & =3\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =3\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{3\\sqrt{3}}{2}, \\\\ {y}_{0} & =6{sin}^{2}⁡\\theta  \\\\  & =6{sin}^{2}⁡(\\frac{\\pi }{3}) \\\\  & =6{(\\frac{\\sqrt{3}}{2})}^{2} \\\\  & =\\frac{9}{2}.\\end{aligned}\n$$\n\nTherefore, $({x}_{0},{y}_{0})=(\\frac{3\\sqrt{3}}{2},\\frac{9}{2}).$ \n\nFinally, the equation of the tangent line is given by\n\n$$\n\\begin{aligned}y-{y}_{0} & =m(x-{x}_{0}) \\\\ y-\\frac{9}{2} & =-\\sqrt{3}(x-\\frac{3\\sqrt{3}}{2}) \\\\ y-\\frac{9}{2} & =-\\sqrt{3}x+\\frac{9}{2} \\\\ y & =-\\sqrt{3}x+9.\\end{aligned}\n$$\n\n![](images/b8/b8546c0b6c51577acf25587fc1ebfc88e15e5f3b9456a64c499d640851bb44d0.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-248fba5d-72db-5572-a2be-4b009978848e"] :db/ensure [:question/validate]} {:db/id "answer-field-248fba5d-72db-5572-a2be-4b009978848e" :answer-field/id #uuid "248fba5d-72db-5572-a2be-4b009978848e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6fd65f66-345e-5e02-a44f-83cf02b3d0b3" :answer-field/choices ["answer-6fd65f66-345e-5e02-a44f-83cf02b3d0b3"] :db/ensure [:answer-field/validate]} {:db/id "answer-6fd65f66-345e-5e02-a44f-83cf02b3d0b3" :answer/id #uuid "6fd65f66-345e-5e02-a44f-83cf02b3d0b3" :answer/type :answer.type/math :answer/value "-\\sqrt{3}x+9" :db/ensure [:answer/validate]} {:db/id 17592186096756 :knowledge-point/questions ["question-68d6c745-8c8f-5b38-826d-b15655a70429"] :db/ensure [:knowledge-point/validate]} {:db/id "question-68d6c745-8c8f-5b38-826d-b15655a70429" :question/id #uuid "68d6c745-8c8f-5b38-826d-b15655a70429" :question/math-academy-id "q-133232" :question/problem "![](images/f6/f6cac98f2c8c7cf182ef5cd88019c12a8b8c6ad8e52d0a01f8174332b366eb7e.png)\n\nThe upper half of our polar curve can be expressed in Cartesian coordinates as $y=\\sqrt{9-{x}^{2}}+3.$ Write an integral expression that gives the exact area $A$ of the region enclosed between the curve and the  $x$-axis, as shown above.\n\n$A={\\int }_{a}^{b}$\n{{field-1}}\n$\\text{d}x,\\,\\,$ where  \n$a\\,=\\,$\n{{field-2}}\n$\\,$ and $\\,b\\,=\\,$\n{{field-3}}" :question/worked-solution "We have the curve\n\n$$\ny=\\sqrt{9-{x}^{2}}+3\n$$\n\nand the limits of integration $x=-3$ and $x=3.$\n\nTherefore, the required area is given by \n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{3}\\sqrt{9-{x}^{2}}+3\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eab6e4bb-25b9-571b-8ab2-8f34af45034c" "answer-field-fde13b93-3b50-582c-bfcb-ee3d822a8060" "answer-field-6dc471fd-50ce-556f-a83f-61c97b7c36f3"] :db/ensure [:question/validate]} {:db/id "answer-field-eab6e4bb-25b9-571b-8ab2-8f34af45034c" :answer-field/id #uuid "eab6e4bb-25b9-571b-8ab2-8f34af45034c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2f6318d0-39a8-5e58-bc4e-c7014e8b6bab" :answer-field/choices ["answer-2f6318d0-39a8-5e58-bc4e-c7014e8b6bab"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f6318d0-39a8-5e58-bc4e-c7014e8b6bab" :answer/id #uuid "2f6318d0-39a8-5e58-bc4e-c7014e8b6bab" :answer/type :answer.type/math :answer/value "\\sqrt{9-x^2}+3" :db/ensure [:answer/validate]} {:db/id "answer-field-fde13b93-3b50-582c-bfcb-ee3d822a8060" :answer-field/id #uuid "fde13b93-3b50-582c-bfcb-ee3d822a8060" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-06bdab16-70c2-5191-a699-a115f9891925" :answer-field/choices ["answer-06bdab16-70c2-5191-a699-a115f9891925"] :db/ensure [:answer-field/validate]} {:db/id "answer-06bdab16-70c2-5191-a699-a115f9891925" :answer/id #uuid "06bdab16-70c2-5191-a699-a115f9891925" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-field-6dc471fd-50ce-556f-a83f-61c97b7c36f3" :answer-field/id #uuid "6dc471fd-50ce-556f-a83f-61c97b7c36f3" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2c11ae74-6b7d-58db-94a8-6de53bb5c272" :answer-field/choices ["answer-2c11ae74-6b7d-58db-94a8-6de53bb5c272"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c11ae74-6b7d-58db-94a8-6de53bb5c272" :answer/id #uuid "2c11ae74-6b7d-58db-94a8-6de53bb5c272" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186059679 :knowledge-point/questions ["question-88c04c0e-97a3-5196-b229-a35ba120f617"] :db/ensure [:knowledge-point/validate]} {:db/id "question-88c04c0e-97a3-5196-b229-a35ba120f617" :question/id #uuid "88c04c0e-97a3-5196-b229-a35ba120f617" :question/math-academy-id "q-133233" :question/problem "Given $r(\\theta )=6\\operatorname{sin}⁡\\theta ,$ find the third derivative of $r(\\theta )$ with respect to $\\theta .$\n\n${r}^{(3)}(\\theta )\\,=$\n{{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{r}^{′}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(6\\operatorname{sin}⁡\\theta ) \\\\  & =6\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}{r}^{″}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(6\\operatorname{cos}⁡\\theta ) \\\\  & =-6\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nFinally, computing the third derivative, we get\n\n$$\n\\begin{aligned}{r}^{(3)}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(-6\\operatorname{sin}⁡\\theta ) \\\\  & =-6\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b9850859-72ca-55ed-8316-143b57415273"] :db/ensure [:question/validate]} {:db/id "answer-field-b9850859-72ca-55ed-8316-143b57415273" :answer-field/id #uuid "b9850859-72ca-55ed-8316-143b57415273" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-233d10cc-83f2-565d-9142-1ee65276cf75" :answer-field/choices ["answer-233d10cc-83f2-565d-9142-1ee65276cf75"] :db/ensure [:answer-field/validate]} {:db/id "answer-233d10cc-83f2-565d-9142-1ee65276cf75" :answer/id #uuid "233d10cc-83f2-565d-9142-1ee65276cf75" :answer/type :answer.type/math :answer/value "-6\\cos\\theta" :db/ensure [:answer/validate]} {:db/id 17592186096820 :knowledge-point/questions ["question-acc186f8-9dad-51c7-bad3-42fb2258f011"] :db/ensure [:knowledge-point/validate]} {:db/id "question-acc186f8-9dad-51c7-bad3-42fb2258f011" :question/id #uuid "acc186f8-9dad-51c7-bad3-42fb2258f011" :question/math-academy-id "q-133234" :question/problem "Let $r(\\theta )=6\\operatorname{sin}⁡\\theta $ for $\\theta \\in (-\\infty ,\\infty ),$ and let ${P}_{2}(\\theta )$ be the second-degree Taylor polynomial of $r(\\theta )$ about $\\theta =0.$ Use the Lagrange error bound to find an upper bound for the error ${R}_{2}$ obtained when ${P}_{2}(\\theta )$ is used to approximate $6\\operatorname{sin}⁡(0.2).$ Give your answer to three decimal places.\n\n$|{R}_{2}|\\,=$\n{{field-1}}" :question/worked-solution "The Lagrange error bound states that an upper bound for the error ${R}_{2}$ obtained when using the second-degree Taylor polynomial ${P}_{2}$ about $\\theta =a$ to approximate $r(\\theta )$ is given by\n\n$$\n|{R}_{2}|\\le \\frac{M}{3!}|\\theta -a{|}^{3},\n$$\n\nwhere $M$ is the maximum value of $|{r}^{(3)}(\\theta )|$ on the interval between $a=0$ and $\\theta =0.2.$\n\nPlugging $\\theta =0.2$ and $a=0$ into the above formula gives\n\n$$\n\\begin{aligned}|{R}_{2}| & \\le \\frac{M}{6}|0.2{|}^{3}.\\end{aligned}\n$$\n\nTo find $M,$ we need to maximize $|{r}^{(3)}(\\theta )|$ on the interval $[0,0.2].$ Previously, we found that\n\n$$\n{r}^{(3)}(\\theta )=-6\\operatorname{cos}⁡\\theta .\n$$\n\nNotice that for $\\theta \\in [0,0.2],$ we have\n\n$$\n|{r}^{(3)}(\\theta )|=|-6\\operatorname{cos}⁡\\theta |=6\\operatorname{cos}⁡\\theta .\n$$\n\nSince $|{r}^{(3)}(\\theta )|=6\\operatorname{cos}⁡\\theta $ is a decreasing function on the interval $[0,0.2],$ its value is greatest at $\\theta =0.$ So,\n\n$$\nM=|{r}^{(3)}(0)|=6\\operatorname{cos}⁡(0)=6.\n$$\n\nTherefore, the upper bound is\n\n$$\n\\begin{aligned}|{R}_{2}| & \\le \\frac{6}{6}|0.2{|}^{3} \\\\  & =(0.2)^{3} \\\\  & =0.008.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-aa62d607-f3df-5e7b-9c46-1b1047790552"] :db/ensure [:question/validate]} {:db/id "answer-field-aa62d607-f3df-5e7b-9c46-1b1047790552" :answer-field/id #uuid "aa62d607-f3df-5e7b-9c46-1b1047790552" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d9e143f3-3fe9-5e42-a1ed-771190e0b00f" :answer-field/choices ["answer-d9e143f3-3fe9-5e42-a1ed-771190e0b00f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9e143f3-3fe9-5e42-a1ed-771190e0b00f" :answer/id #uuid "d9e143f3-3fe9-5e42-a1ed-771190e0b00f" :answer/type :answer.type/math :answer/value "0.008" :db/ensure [:answer/validate]} {:db/id "multistep-f2d248c5-c3a9-5d9c-bcfc-f830bcac9594" :multistep/id #uuid "f2d248c5-c3a9-5d9c-bcfc-f830bcac9594" :multistep/context "![](images/49/49ead9d9cf872e2e5086ec6a7b2c612b70443e0275d65e969215271478d24d36.png)\n\nConsider the polar curve $r=6\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\pi ,$ shown above." :multistep/steps ["step-9b23ac8e-4657-52ad-ab92-2f6c1ebcf754" "step-b391ccd9-bd49-5e7d-9c49-f72db32c89e9" "step-92c23f02-c867-5293-85b3-97e296860214" "step-01f21eb4-b1a0-59f4-8a66-c8d33fde667e" "step-d470bfcb-50fa-5e3e-b805-41172d5abf49" "step-62c92e04-2b19-5e33-acac-324e656f0308" "step-652fe64c-4218-5234-bbba-8607c50ad3db" "step-02dd2953-b049-5f76-b85b-d1d16110fb37" "step-b0edb7de-76d4-537c-aafa-fd61f7d8d24d" "step-7839cf03-a167-5954-9d88-64cb7b07f6e5"] :multistep/first-step "step-9b23ac8e-4657-52ad-ab92-2f6c1ebcf754" :db/ensure [:multistep/validate]} {:db/id "step-9b23ac8e-4657-52ad-ab92-2f6c1ebcf754" :step/id #uuid "9b23ac8e-4657-52ad-ab92-2f6c1ebcf754" :step/content "question-04c21b11-d6eb-5e2f-9a68-02bdca097cfd" :step/next "step-b391ccd9-bd49-5e7d-9c49-f72db32c89e9" :db/ensure [:step/validate]} {:db/id "step-b391ccd9-bd49-5e7d-9c49-f72db32c89e9" :step/id #uuid "b391ccd9-bd49-5e7d-9c49-f72db32c89e9" :step/content "question-2749929e-e01c-5706-82d9-161e96c84d4c" :step/next "step-92c23f02-c867-5293-85b3-97e296860214" :db/ensu