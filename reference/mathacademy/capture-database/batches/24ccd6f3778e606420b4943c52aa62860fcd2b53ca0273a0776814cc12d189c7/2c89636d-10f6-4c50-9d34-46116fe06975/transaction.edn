0c3984c" :db/ensure [:step/validate]} {:db/id "step-c0ed2fb4-d964-5c56-afa4-a060d0c3984c" :step/id #uuid "c0ed2fb4-d964-5c56-afa4-a060d0c3984c" :step/content "question-7dc41e95-539c-50b9-8fb0-b63764e8684c" :db/ensure [:step/validate]} [:db/retract 17592186054315 :answer-field/choices 17592186054320] [:db/retract 17592186054315 :answer-field/choices 17592186054316] [:db/retract 17592186054315 :answer-field/choices 17592186054317] [:db/retract 17592186054315 :answer-field/choices 17592186054318] [:db/retract 17592186054315 :answer-field/choices 17592186054319] {:db/id 17592186055513 :question/problem "Find $|z|$ if $z=-c-d\\text{i},$ where $c$ and $d$ are real numbers." :question/worked-solution "For a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nFor the complex number $z=-c-d\\text{i},$ we have $a=-c$ and $b=-d.$ So, the magnitude is given by\n\n$$\n\\begin{aligned}\\begin{aligned}|-c-d\\text{i}| & =\\sqrt{(-c)^{2}+(-d)^{2}} \\\\  & =\\sqrt{{c}^{2}+{d}^{2}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186054315 :answer-field/correct "answer-15acad6a-1588-50dc-884b-0bc494d8457f" :answer-field/choices ["answer-b58e593b-db73-5134-8433-9704c2af763a" "answer-98affaef-6797-5eee-a74c-fa5d61288f53" "answer-15acad6a-1588-50dc-884b-0bc494d8457f" "answer-854035a8-ed0e-5bd3-9e72-e2d04380d94d" "answer-dd2ae299-d491-5962-8c63-b8d3103f30bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-b58e593b-db73-5134-8433-9704c2af763a" :answer/id #uuid "b58e593b-db73-5134-8433-9704c2af763a" :answer/type :answer.type/math :answer/value "\\sqrt{c+d}" :db/ensure [:answer/validate]} {:db/id "answer-98affaef-6797-5eee-a74c-fa5d61288f53" :answer/id #uuid "98affaef-6797-5eee-a74c-fa5d61288f53" :answer/type :answer.type/math :answer/value "\\sqrt{c-d}" :db/ensure [:answer/validate]} {:db/id "answer-15acad6a-1588-50dc-884b-0bc494d8457f" :answer/id #uuid "15acad6a-1588-50dc-884b-0bc494d8457f" :answer/type :answer.type/math :answer/value "\\sqrt{{c}^{2}+{d}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/id #uuid "854035a8-ed0e-5bd3-9e72-e2d04380d94d" :answer/type :answer.type/math :answer/value "\\sqrt{{c}^{2}-{d}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/id #uuid "dd2ae299-d491-5962-8c63-b8d3103f30bd" :answer/type :answer.type/math :answer/value "\\sqrt{{c}^{2}}\\sqrt{{d}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186054736 :knowledge-point/questions ["question-407ccba6-df92-5ced-bae5-a0584a2e9a9b" "question-e440f356-fb13-5144-832e-aba59bbee006"] :db/ensure [:knowledge-point/validate]} {:db/id "question-407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/id #uuid "407ccba6-df92-5ced-bae5-a0584a2e9a9b" :question/math-academy-id "q-70259" :question/problem "What is the magnitude of the number $z=3\\sqrt{2}\\,\\text{i}?$" :question/worked-solution "The imaginary number $3\\sqrt{2}\\,\\text{i}$ is equivalent to the complex number $z=0+3\\sqrt{2}\\,\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0+3\\sqrt{2}\\,\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(3\\sqrt{2})^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-700c44b0-518b-5383-9cc4-49a4e33ab23a"] :db/ensure [:question/validate]} {:db/id "answer-field-700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/id #uuid "700c44b0-518b-5383-9cc4-49a4e33ab23a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-57c8a3b4-8173-5938-b698-2abfcad48518" :answer-field/choices ["answer-baa275e2-b6b5-5efe-92e8-68e43ce68a9f" "answer-20fcdb42-91ca-575f-b2d7-0e66f5434d4c" "answer-803a45f2-870d-54d9-83cb-ae54be25ca4f" "answer-57c8a3b4-8173-5938-b698-2abfcad48518" "answer-901f0f8f-ae86-5446-bb09-058c84094a71"] :db/ensure [:answer-field/validate]} {:db/id "answer-baa275e2-b6b5-5efe-92e8-68e43ce68a9f" :answer/id #uuid "baa275e2-b6b5-5efe-92e8-68e43ce68a9f" :answer/type :answer.type/math :answer/value "-3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-20fcdb42-91ca-575f-b2d7-0e66f5434d4c" :answer/id #uuid "20fcdb42-91ca-575f-b2d7-0e66f5434d4c" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-803a45f2-870d-54d9-83cb-ae54be25ca4f" :answer/id #uuid "803a45f2-870d-54d9-83cb-ae54be25ca4f" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-57c8a3b4-8173-5938-b698-2abfcad48518" :answer/id #uuid "57c8a3b4-8173-5938-b698-2abfcad48518" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-901f0f8f-ae86-5446-bb09-058c84094a71" :answer/id #uuid "901f0f8f-ae86-5446-bb09-058c84094a71" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-e440f356-fb13-5144-832e-aba59bbee006" :question/id #uuid "e440f356-fb13-5144-832e-aba59bbee006" :question/math-academy-id "q-160280" :question/problem "What is the magnitude of the number $z=-9\\text{i}?$" :question/worked-solution "The imaginary number $-9\\text{i}$ is equivalent to the complex number $z=0-9\\text{i}.$\n\nWe know that for a complex number $z=a+b\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{a}^{2}+{b}^{2}}.\n$$\n\nSo, the magnitude of $z=0-9\\text{i}$ is given by\n\n$$\n\\begin{aligned}|z| & =\\sqrt{{a}^{2}+{b}^{2}} \\\\  & =\\sqrt{(0)^{2}+(-9)^{2}} \\\\  & =\\sqrt{81} \\\\  & =9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-82433c6e-f90d-5505-9496-d2c147d30d79"] :db/ensure [:question/validate]} {:db/id "answer-field-82433c6e-f90d-5505-9496-d2c147d30d79" :answer-field/id #uuid "82433c6e-f90d-5505-9496-d2c147d30d79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-297edda3-9036-5d3f-841d-95794066b68e" :answer-field/choices ["answer-6fdb107c-f069-5a3f-b408-4442f17dca80" "answer-d488e77f-965b-5239-a2f4-9c5c6fd27700" "answer-fa74a01a-75f7-5f19-9147-121c4a1a9617" "answer-f69636d0-b0c4-52be-8443-48117c693451" "answer-297edda3-9036-5d3f-841d-95794066b68e"] :db/ensure [:answer-field/validate]} {:db/id "answer-6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/id #uuid "6fdb107c-f069-5a3f-b408-4442f17dca80" :answer/type :answer.type/math :answer/value "-3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/id #uuid "d488e77f-965b-5239-a2f4-9c5c6fd27700" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-fa74a01a-75f7-5f19-9147-121c4a1a9617" :answer/id #uuid "fa74a01a-75f7-5f19-9147-121c4a1a9617" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f69636d0-b0c4-52be-8443-48117c693451" :answer/id #uuid "f69636d0-b0c4-52be-8443-48117c693451" :answer/type :answer.type/math :answer/value "3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-297edda3-9036-5d3f-841d-95794066b68e" :answer/id #uuid "297edda3-9036-5d3f-841d-95794066b68e" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "activity-582cf0be-b649-5c80-ab83-11d8d6de800e" :activity/id #uuid "582cf0be-b649-5c80-ab83-11d8d6de800e" :activity/title "The Magnitude of a Complex Number" :activity/type :activity.type/review :activity/scope 17592186049831 :activity/course 17592186046647 :activity/steps ["step-4e4d1882-3af3-542b-a0de-5d934be9d250" "step-bf91d901-c429-5294-8b90-ff69ad18fb15" "step-c5102343-0d92-5737-bfce-0a300f842184"] :activity/first-step "step-4e4d1882-3af3-542b-a0de-5d934be9d250" :db/ensure [:activity/validate]} {:db/id "step-4e4d1882-3af3-542b-a0de-5d934be9d250" :step/id #uuid "4e4d1882-3af3-542b-a0de-5d934be9d250" :step/content 17592186055513 :step/next "step-bf91d901-c429-5294-8b90-ff69ad18fb15" :db/ensure [:step/validate]} {:db/id "step-bf91d901-c429-5294-8b90-ff69ad18fb15" :step/id #uuid "bf91d901-c429-5294-8b90-ff69ad18fb15" :step/content "question-407ccba6-df92-5ced-bae5-a0584a2e9a9b" :step/next "step-c5102343-0d92-5737-bfce-0a300f842184" :db/ensure [:step/validate]} {:db/id "step-c5102343-0d92-5737-bfce-0a300f842184" :step/id #uuid "c5102343-0d92-5737-bfce-0a300f842184" :step/content "question-e440f356-fb13-5144-832e-aba59bbee006" :db/ensure [:step/validate]} [:db/retract 17592186165986 :answer-field/choices 17592186165987] [:db/retract 17592186165986 :answer-field/choices 17592186165988] [:db/retract 17592186165986 :answer-field/choices 17592186165989] [:db/retract 17592186165986 :answer-field/choices 17592186165990] [:db/retract 17592186165986 :answer-field/choices 17592186165991] [:db/retract 17592186165764 :answer-field/choices 17592186165765] [:db/retract 17592186165764 :answer-field/choices 17592186165766] [:db/retract 17592186165764 :answer-field/choices 17592186165767] [:db/retract 17592186165764 :answer-field/choices 17592186165768] [:db/retract 17592186165764 :answer-field/choices 17592186165769] {:db/id 17592186166800 :knowledge-point/questions ["question-3d35be6f-b8bf-5aae-b526-fffd6ac155d1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3d35be6f-b8bf-5aae-b526-fffd6ac155d1" :question/id #uuid "3d35be6f-b8bf-5aae-b526-fffd6ac155d1" :question/math-academy-id "q-140954" :question/problem "$$\nA=[\\begin{aligned}2 & 6 \\\\ -1 & -3\\end{aligned}],\\,Σ=[\\begin{aligned}5\\sqrt{2} & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$" :question/worked-solution "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${u}_{i}$ and ${v}_{i}$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=5\\sqrt{2}$ and ${\\sigma }_{2}=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{5\\sqrt{2}}[\\begin{aligned}2 & 6 \\\\ -1 & -3\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}] \\\\  & =\\frac{1}{5\\sqrt{2}}[\\begin{aligned}-2\\sqrt{10} \\\\ \\sqrt{10}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}].\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{2}{\\sqrt{5}}{x}_{1}+\\frac{1}{\\sqrt{5}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$\n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]=[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-878eab3b-0013-5886-bc3a-c5e6e24549e2"] :db/ensure [:question/validate]} {:db/id "answer-field-878eab3b-0013-5886-bc3a-c5e6e24549e2" :answer-field/id #uuid "878eab3b-0013-5886-bc3a-c5e6e24549e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e0d2fc2-cdda-536f-a283-b40551cfbdf5" :answer-field/choices ["answer-8d184024-85de-5e83-a811-fc89c4b9ed9e" "answer-4e6f76f8-fabe-575d-a1e4-d164645833f2" "answer-d0badeff-5d8d-5143-a5d3-dd68e8e21b1b" "answer-8e0d2fc2-cdda-536f-a283-b40551cfbdf5" "answer-6a305fcd-093d-5bb9-9359-0c117427293f"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d184024-85de-5e83-a811-fc89c4b9ed9e" :answer/id #uuid "8d184024-85de-5e83-a811-fc89c4b9ed9e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4e6f76f8-fabe-575d-a1e4-d164645833f2" :answer/id #uuid "4e6f76f8-fabe-575d-a1e4-d164645833f2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d0badeff-5d8d-5143-a5d3-dd68e8e21b1b" :answer/id #uuid "d0badeff-5d8d-5143-a5d3-dd68e8e21b1b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8e0d2fc2-cdda-536f-a283-b40551cfbdf5" :answer/id #uuid "8e0d2fc2-cdda-536f-a283-b40551cfbdf5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6a305fcd-093d-5bb9-9359-0c117427293f" :answer/id #uuid "6a305fcd-093d-5bb9-9359-0c117427293f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186167463 :question/problem "$$\nA=[\\begin{aligned}4 & 2 \\\\ 4 & 2\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{10} & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the second column of $U?$" :question/worked-solution "Recall that if $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ and ${\\sigma }_{i}\\ne 0,$ then the $i$th column of $U$ can be found as\n\n$$\n{u}_{i}=\\frac{1}{{\\sigma }_{i}}A{v}_{i},\n$$\n\n \n\nwhere ${u}_{i}$ and ${v}_{i}$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=2\\sqrt{10}$ and ${\\sigma }_{2}=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{10}}[\\begin{aligned}4 & 2 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{10}}[\\begin{aligned}2\\sqrt{5} \\\\ 2\\sqrt{5}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\\end{aligned}\n$$\n\n \n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n\\frac{1}{\\sqrt{2}}{x}_{1}+\\frac{1}{\\sqrt{2}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$ \n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165986 :answer-field/correct "answer-0756d6a2-5c9b-5da0-b6ac-e393748608b5" :answer-field/choices ["answer-05c69ade-9060-5f76-aa13-6e6ef270e498" "answer-0756d6a2-5c9b-5da0-b6ac-e393748608b5" "answer-f50dc0d2-5565-5274-afe9-0e9e574999f6" "answer-c60d3077-aa03-5376-a140-a9fbb050ed72" "answer-6eb3d951-ab3d-57bc-9aa2-7a7185488004"] :db/ensure [:answer-field/validate]} {:db/id "answer-05c69ade-9060-5f76-aa13-6e6ef270e498" :answer/id #uuid "05c69ade-9060-5f76-aa13-6e6ef270e498" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0756d6a2-5c9b-5da0-b6ac-e393748608b5" :answer/id #uuid "0756d6a2-5c9b-5da0-b6ac-e393748608b5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f50dc0d2-5565-5274-afe9-0e9e574999f6" :answer/id #uuid "f50dc0d2-5565-5274-afe9-0e9e574999f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c60d3077-aa03-5376-a140-a9fbb050ed72" :answer/id #uuid "c60d3077-aa03-5376-a140-a9fbb050ed72" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{3}} \\\\ \\frac{\\sqrt{2}}{\\sqrt{3}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6eb3d951-ab3d-57bc-9aa2-7a7185488004" :answer/id #uuid "6eb3d951-ab3d-57bc-9aa2-7a7185488004" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186167426 :question/problem "$$\nA=[\\begin{aligned}1 & -1 \\\\ 3 & -3\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{5} & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrices $U$ and $V?$" :question/worked-solution "Let's find the singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}1 & -1 \\\\ 3 & -3\\end{aligned}]}^{T}[\\begin{aligned}1 & -1 \\\\ 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 3 \\\\ -1 & -3\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}10 & -10 \\\\ -10 & 10\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that from the matrix $Σ,$ we can deduce that ${\\sigma }_{1}=2\\sqrt{5}$ and ${\\sigma }_{2}=0$ without solving the characteristic equation.\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of ${A}^{T}\\,A$):\n\n- For ${\\lambda }_{1}={\\sigma }_{1}^{2}=20,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-20I & =[\\begin{aligned}10 & -10 \\\\ -10 & 10\\end{aligned}]-20[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-10 & -10 \\\\ -10 & -10\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-20I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{1}=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}={\\sigma }_{2}^{2}=0,$ we have\n\n$$\n\\begin{aligned}{A}^{T}\\,A-0I & =[\\begin{aligned}10 & -10 \\\\ -10 & 10\\end{aligned}]-0[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}10 & -10 \\\\ -10 & 10\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $({A}^{T}\\,A-0I)v=0$ gives a unit eigenvector\n\n$$\n{v}_{2}=[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}].\n$$\n\n- **Step 4.** Find the left singular vectors of $A$ (i.e., the unit eigenvectors of $A{A}^{T}$): Since the first singular value is not zero, and we know the corresponding singular right vector, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{5}}[\\begin{aligned}1 & -1 \\\\ 3 & -3\\end{aligned}][\\begin{aligned}-\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{5}}[\\begin{aligned}-\\sqrt{2} \\\\ -3\\sqrt{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}}\\end{aligned}]\\end{aligned}\n$$\n\nSince the second singular value is ${\\sigma }_{2}=0$, we can't use the same formula to find the second column of $U.$ But we know that $U$ must be orthogonal. Hence, we must find a vector\n\n$$\n{u}_{2}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]\n$$\n\nsuch that \n\n$$\n{u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,‖{u}_{2}‖=1.\n$$\n\n \n\nSolving ${u}_{1}\\cdot {u}_{2}=0,$ which is equivalent to\n\n$$\n-\\frac{1}{\\sqrt{10}}{x}_{1}-\\frac{3}{\\sqrt{10}}{x}_{2}=0,\n$$\n\nwe get a nonzero solution $[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ Normalizing this vector, we finally obtain the  second column of $U:$\n\n$$\n{u}_{2}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\n$$\n\nFinally, we construct the matrices $U$ and $V:$\n\n$$\nU=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}],\\,V=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186165764 :answer-field/correct "answer-d662914b-b98e-5bb3-8d4d-7d0ed96cb841" :answer-field/choices ["answer-d662914b-b98e-5bb3-8d4d-7d0ed96cb841" "answer-f6d9ca68-4ca0-505d-ba43-841000fa1d32" "answer-f115935a-361e-5a7a-a92c-8717bff55eaf" "answer-26ef721e-74d4-5a10-9cf1-42944cf88c5f" "answer-1f3ba74c-8cac-500b-af49-6238e7a60068"] :db/ensure [:answer-field/validate]} {:db/id "answer-d662914b-b98e-5bb3-8d4d-7d0ed96cb841" :answer/id #uuid "d662914b-b98e-5bb3-8d4d-7d0ed96cb841" :answer/type :answer.type/text :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-f6d9ca68-4ca0-505d-ba43-841000fa1d32" :answer/id #uuid "f6d9ca68-4ca0-505d-ba43-841000fa1d32" :answer/type :answer.type/text :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ -\\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-f115935a-361e-5a7a-a92c-8717bff55eaf" :answer/id #uuid "f115935a-361e-5a7a-a92c-8717bff55eaf" :answer/type :answer.type/text :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-26ef721e-74d4-5a10-9cf1-42944cf88c5f" :answer/id #uuid "26ef721e-74d4-5a10-9cf1-42944cf88c5f" :answer/type :answer.type/text :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-1f3ba74c-8cac-500b-af49-6238e7a60068" :answer/id #uuid "1f3ba74c-8cac-500b-af49-6238e7a60068" :answer/type :answer.type/text :answer/value "$U=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{aligned}]$\nand\n$V=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id 17592186168070 :tutorial/content "Suppose that $A$ is a $m\\times n$ matrix, and \n\n$$\nA=U \\Sigma V^T\n$$\n\nis a singular value decomposition of $A.$ If the $i$th singular value of $A$ is nonzero, then the $i$th column of the orthogonal matrix $U$ can be found using the formula\n\n$$\n\\mathbf{u}_i = \\dfrac{1}{\\sigma_i} A\\mathbf{v}_i,\n$$\n\n \n\nwhere $\\mathbf u_i$ and $\\mathbf v_i$ are the $i$th columns of the orthogonal matrices $U$ and $V,$ respectively.  \n\nThe formula above works whenever $\\sigma_i\\neq 0.$ But how do we find the $i$th column of $U$ in cases where $\\sigma_i = 0?$ It turns out that we can find the corresponding left singular vector using the geometric properties of singular values.\n\nFor example, suppose that\n\n![](images/fa/fab8a223fc22100592865eeb8b147313f4a635ffa3791863826ca6330730cc58.svg)\n\nand $A=U \\Sigma V^T$ is a singular value decomposition of $A,$ where\n![](images/58/58af793e95fd96171530b2b63e74d12e965fb02eb81af42c8fdb3c9289a04b11.svg)\nThe matrices $\\Sigma$ and $V$ can be found using the methods we've seen before. So, our task now is to find the matrix $U.$ \n\nFrom $\\Sigma,$ we deduce that the singular values of $A$ are $\\sigma_1=4$ and $\\sigma_2=0.$ Therefore, the first column of $U$ is\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{4}[\\begin{aligned}\\sqrt{3} & 1 \\\\ 3 & \\sqrt{3}\\end{aligned}][\\begin{aligned}\\frac{\\sqrt{3}}{2} \\\\ \\frac{1}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{\\sqrt{3}}{2}\\end{aligned}]\\end{aligned}\n$$\n\n \n\nSince the second singular value is $\\sigma_2=0$, we can't use the same formula to find the second column of $U.$ However, we know that $U$ is an orthogonal matrix. Hence, we must find a vector\n\n![](images/78/781532700996b7a60101f204b934483da264ecab6acd6bfeda97141669308b6c.svg)\n\nsuch that \n\n$$\n\\mathbf{u}_1 \\cdot \\mathbf{u}_2 = 0 \\qquad \\textrm{and} \\qquad \\|\\mathbf{u}_2\\|=1.\n$$\n\n \n\nLet's consider each condition in turn:\n\n- The equation $\\mathbf{u}_1 \\cdot \\mathbf{u}_2 = 0$  is equivalent to\n\n$$\n\\dfrac{1}{{2}} x_1 +  \\dfrac{\\sqrt{3}}{2} x_2 = 0.\n$$\n\nSeeking a nonzero solution to this equation, we get the vector \n![](images/75/7521799052487c5668d209c97ad6779f4258ecc5710ac81f2135966bf39974d3.svg)\n\n- Normalizing the vector we just found, we get\n![](images/30/30cc0b825690ed4dcd0bd672563f37bc6e621be092db70c4b46dafbf22db10c4.svg)\n\nTherefore, our orthogonal matrix $U$ is given by\n\n![](images/92/92ca53d48aed0c8435f89db4e11c022bc27ecb7a13d741e03270e0c981f639ef.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186168073 :tutorial/content "It follows from the definitions that a $2\\times 2$ matrix $A$ has two repeated singular values $\\sigma_1= \\sigma_2= \\sigma$ if and only if the matrix  $A^TA$ has two repeated eigenvalues $\\lambda_1=\\lambda_2 = \\sigma^2.$  Thus, since $A^TA$ is diagonalizable (because it is symmetric), the eigenspace corresponding to $\\sigma^2$ must be two-dimensional. Therefore, \n\n![](images/df/df266614e2576526353248439b7a17431d5e9e43153e1ba225adab3a89321373.svg)\n\nConsequently, we can use any pair of unit orthogonal vectors as a basis for the eigenspace corresponding to $\\sigma^2.$ \n\nLet's illustrate this with an example. Consider the following matrix:\n\n![](images/ee/ee74c3d4ed7e32388d06b47ed79789d768b54dee61e64d6db57c3eeb582089ae.svg)\n\nLet's find a singular value decomposition of $A$ using the usual algorithm.\n\n- **Step 1.** Compute $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}]}^{T}[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}13 & 0 \\\\ 0 & 13\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: Notice that since $A^T \\! A$ is diagonal, the singular values of $A$ are \n\n$$\n\\sigma_1 = \\sigma_2 = \\sqrt{13}.\n$$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of $A^T \\! A$): Since the singular values are equal, we can always take as solutions of $(A^T\\!A-13I)\\mathbf{v}=\\mathbf{0}$ the unit eigenvectors \n![](images/d1/d1770843817b2557b032743e186dd27106374fef90a2a8e8bb3cfe77b2eb0398.svg)\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n- First, we compute $\\mathbf u_1\\mathbin{:}$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{2}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute $\\mathbf u_2\\mathbin{:}$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{13}}[\\begin{aligned}3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we construct the matrices $U,$ $\\Sigma,$ and $V\\mathbin{:}$\n\n![](images/c9/c950cf3aff8f9ab47ede762fa9c4451c5e7fc1e78e12fca064ee87d89fcb571e.svg)\n\n**Note:** By swapping the order of eigenvectors in step 3, we swap the vectors $\\mathbf{u}_1$ and $\\mathbf{u}_2$ in step 4. However, the resulting matrices (with swapped columns) will give us a valid singular decomposition too." :db/ensure [:tutorial/validate]} [:db/retract 17592186102764 :answer-field/choices 17592186102768] [:db/retract 17592186102764 :answer-field/choices 17592186102769] [:db/retract 17592186102764 :answer-field/choices 17592186102765] [:db/retract 17592186102764 :answer-field/choices 17592186102766] [:db/retract 17592186102764 :answer-field/choices 17592186102767] [:db/retract 17592186102108 :answer-field/choices 17592186102112] [:db/retract 17592186102108 :answer-field/choices 17592186102113] [:db/retract 17592186102108 :answer-field/choices 17592186102109] [:db/retract 17592186102108 :answer-field/choices 17592186102110] [:db/retract 17592186102108 :answer-field/choices 17592186102111] {:db/id 17592186105791 :knowledge-point/questions ["question-68c240a3-d1c2-54cd-a001-e4698ed241e7" "question-a9a8bb7e-ad2c-5185-87eb-ce30902a04e7" "question-77bce5e4-123e-5ff9-af9f-15d1cb34dfd9" "question-96dc50ad-7c40-5c2b-a752-a6f1cca71c8d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105646 :question/problem "Find the integral expression corresponding to the area of the first petal of the polar curve $r = \\sin(5\\theta),$ represented by the shaded region shown below.\n\n![](images/66/66062568cedc1b46822dd7e0e53779482f1923d621b47d29f38141ff770b4498.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\: \\textrm{d}\\theta .\n$$\n\nSince $r(\\theta) = \\sin(5\\theta)$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\operatorname{sin}⁡(5\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{sin}^{2}⁡(5\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits.  \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta$ for which $r=0$, or \n\n$$\n\\sin(5\\theta) = 0.\n$$\n\nThis gives us two solutions for $5\\theta\\in[0,2\\pi)\\mathbin{:}$\n\n$$\n5\\theta = 0, \\pi \\qquad \\Longrightarrow \\qquad \\theta=0,\\dfrac{\\pi}{5}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in \\left[0,\\dfrac{\\pi}{5}\\right].$  Notice that this interval lies in the first quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{0}^{\\pi/5} \\sin^2(5\\theta) \\: \\textrm{d}\\theta.\n$$" :db/ensure [:question/validate]} {:db/id 17592186105853 :knowledge-point/questions ["question-3aec8613-8bc5-55d8-bb63-25dfe3e5bcce" "question-809efbd7-39b4-57dd-a5fb-9c26fa380f5b" "question-7f3edede-f2b8-5413-b0b9-835c57755de4" "question-790dcc10-7f22-59d7-b4bc-0f6943a2af9d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105690 :question/problem "Find the interval for $\\theta$ corresponding to the first petal of the polar curve $r = \\sqrt{2}\\cos(6\\theta),$ represented by the shaded region shown below.\n\n![](images/9e/9e401186103f1cb3b060b99037bf5af07e873c191324759627275d77d235688c.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\: \\textrm{d}\\theta .\n$$\n\nSince $r(\\theta) = \\sqrt{2}\\cos(6\\theta)$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\sqrt{2}\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{cos}^{2}⁡(6\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta$ for which $r=0$, or \n\n$$\n\\sqrt{2}\\cos(6\\theta) = 0.\n$$\n\nNotice that the first petal lies between the first and fourth quadrants. So it's convenient to assume that $\\theta$ can be negative.\n\nWe now solve the above equation for $6\\theta\\in[-\\pi,\\pi)\\mathbin{:}$\n\n$$\n6\\theta = -\\dfrac{\\pi}{2}, \\dfrac{\\pi}{2} \\qquad \\Longrightarrow \\qquad \\theta=-\\dfrac{\\pi}{12},\\dfrac{\\pi}{12}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in \\left[-\\dfrac{\\pi}{12},\\dfrac{\\pi}{12}\\right].$ Notice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\int_{-\\pi/12}^{\\pi/12} \\cos^2(6\\theta) \\: \\textrm{d}\\theta.\n$$" :db/ensure [:question/validate]} {:db/id 17592186105792 :knowledge-point/questions ["question-2be045cc-480f-57a5-b39f-c617f83c588d" "question-841c4177-3882-5def-83ad-75d73368e31f" "question-a11f42c6-9c97-5af9-adee-a7210e67b825" "question-5a2aaba8-489e-5805-b9f6-0c2a5c67d926" "question-3922fac2-663d-5efa-bc44-c819bbafb745"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105647 :question/problem "Which of the following represents the area enclosed by the first petal of the polar curve  $r = 1+\\sqrt{2}\\cos\\left(2\\theta+\\dfrac{\\pi}{2}\\right),$ represented by the shaded region shown below.\n\n![](images/95/95138031d082cfc739c2c2569af9a9ea5c63d4b6990237b8267c4b2fe2481b09.png)" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA = \\dfrac{1}{2} \\int_{\\theta_1}^{\\theta_2} r^2(\\theta) \\: \\textrm{d}\\theta .\n$$\n\nSince $r(\\theta) = 1+\\sqrt{2}\\cos\\left(2\\theta+\\dfrac{\\pi}{2}\\right)$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(1+\\sqrt{2}\\operatorname{cos}⁡(2\\theta +\\frac{\\pi }{2}))}^{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta$ for which $r=0$, or \n\n$$\n\\begin{aligned}1+\\sqrt{2}\\operatorname{cos}⁡(2\\theta +\\frac{\\pi }{2}) & =0 \\\\ \\operatorname{cos}⁡(2\\theta +\\frac{\\pi }{2}) & =-\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nFrom the diagram, the first petal extends from the third quadrant to the first quadrant. Since the petal begins in the third quadrant, it is convenient to allow negative values of $\\theta$ when determining the interval.\n\nThe solutions for $2\\theta+\\dfrac{\\pi}{2}$ closest to $0$ on either side are\n\n$$\n2\\theta+\\dfrac{\\pi}{2} = -\\dfrac{3\\pi}{4}, \\dfrac{3\\pi}{4} \n\\qquad \\Longrightarrow \\qquad \n2\\theta = -\\dfrac{5\\pi}{4}, \\dfrac{\\pi}{4}\n\\qquad \\Longrightarrow \\qquad \n\\theta = -\\dfrac{5\\pi}{8}, \\dfrac{\\pi}{8}\n$$\n\nTherefore, the first petal is traversed for \n\n$$\n\\theta  \\in \\left[-\\dfrac{5\\pi}{8}, \\dfrac{\\pi}{8}\\right].\n$$\n\n \n\nNotice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\displaystyle \\dfrac{1}{2}\\int_{-5\\pi/8}^{\\pi/8}  \\left( 1+\\sqrt{2}\\cos\\left(2\\theta+\\dfrac{\\pi}{2}\\right)\\right)^2 \\: \\textrm{d}\\theta.\n$$" :db/ensure [:question/validate]} {:db/id "question-68c240a3-d1c2-54cd-a001-e4698ed241e7" :question/id #uuid "68c240a3-d1c2-54cd-a001-e4698ed241e7" :question/math-academy-id "q-125494" :question/problem "![](images/a0/a010feba178f2db834e1939a91c81fd95131d65b10c7616bd92140fa46eaa305.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=6\\operatorname{sin}⁡(7\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=6\\operatorname{sin}⁡(7\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(6\\operatorname{sin}⁡(7\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =18{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits.  \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n6\\operatorname{sin}⁡(7\\theta )=0.\n$$\n\nThis gives us two solutions for $7\\theta \\in [0,2\\pi ):$\n\n$$\n7\\theta =0,\\pi \\,⟹\\,\\theta =0,\\frac{\\pi }{7}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [0,\\frac{\\pi }{7}].$ Notice that this interval lies in the first quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\nA=18{\\int }_{0}^{\\pi /7}{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ca50bb8-65fb-5887-be84-d31d773a1ff8"] :db/ensure [:question/validate]} {:db/id "answer-field-9ca50bb8-65fb-5887-be84-d31d773a1ff8" :answer-field/id #uuid "9ca50bb8-65fb-5887-be84-d31d773a1ff8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-682eb163-f2ab-5256-9c37-ff22d6e12633" :answer-field/choices ["answer-682eb163-f2ab-5256-9c37-ff22d6e12633" "answer-85fa656d-5dd4-543f-afaa-83f9f26d96bf" "answer-12d3ae86-fe5b-5459-9248-c229a4cb9d95" "answer-82bafe14-c2b9-5557-b37c-58363f34c732" "answer-1844ef73-602c-5b30-88ea-ffffbf088136"] :db/ensure [:answer-field/validate]} {:db/id "answer-682eb163-f2ab-5256-9c37-ff22d6e12633" :answer/id #uuid "682eb163-f2ab-5256-9c37-ff22d6e12633" :answer/type :answer.type/math :answer/value "18{\\int }_{0}^{\\pi /7}{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-85fa656d-5dd4-543f-afaa-83f9f26d96bf" :answer/id #uuid "85fa656d-5dd4-543f-afaa-83f9f26d96bf" :answer/type :answer.type/math :answer/value "9{\\int }_{0}^{\\pi }{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-12d3ae86-fe5b-5459-9248-c229a4cb9d95" :answer/id #uuid "12d3ae86-fe5b-5459-9248-c229a4cb9d95" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /2}{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-82bafe14-c2b9-5557-b37c-58363f34c732" :answer/id #uuid "82bafe14-c2b9-5557-b37c-58363f34c732" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /2}{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-1844ef73-602c-5b30-88ea-ffffbf088136" :answer/id #uuid "1844ef73-602c-5b30-88ea-ffffbf088136" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{0}^{\\pi /7}{sin}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-a9a8bb7e-ad2c-5185-87eb-ce30902a04e7" :question/id #uuid "a9a8bb7e-ad2c-5185-87eb-ce30902a04e7" :question/math-academy-id "q-124424" :question/problem "![](images/97/97b30cfa241a6e1b9db4d5332749ae503a926711c0e7c78ab188c2327463c89b.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=3\\operatorname{sin}⁡(5\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=3\\operatorname{sin}⁡(5\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(3\\operatorname{sin}⁡(5\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{sin}^{2}⁡(5\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits.  \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n3\\operatorname{sin}⁡(5\\theta )=0.\n$$\n\nThis gives us two solutions for $5\\theta \\in [0,2\\pi ):$\n\n$$\n5\\theta =0,\\pi \\,⟹\\,\\theta =0,\\frac{\\pi }{5}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [0,\\frac{\\pi }{5}].$ Notice that this interval lies in the first quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\nA=\\frac{9}{2}{\\int }_{0}^{\\pi /5}{sin}^{2}⁡(5\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-79734443-de36-5288-80ea-687e1187b2c9"] :db/ensure [:question/validate]} {:db/id "answer-field-79734443-de36-5288-80ea-687e1187b2c9" :answer-field/id #uuid "79734443-de36-5288-80ea-687e1187b2c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7ec012b5-f731-5c5e-96d4-923c5b550d86" :answer-field/choices ["answer-7f594d21-de94-5f4b-a0d8-17674ad8f887" "answer-ccaf2d7c-3557-543d-af50-fae40376027f" "answer-ffc1fc67-a5a0-5126-89ee-1dd84d13b93e" "answer-c0162a02-455a-5f09-a239-5b7fe41f7d10" "answer-7ec012b5-f731-5c5e-96d4-923c5b550d86"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f594d21-de94-5f4b-a0d8-17674ad8f887" :answer/id #uuid "7f594d21-de94-5f4b-a0d8-17674ad8f887" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{0}^{2\\pi /5}{sin}^{2}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ccaf2d7c-3557-543d-af50-fae40376027f" :answer/id #uuid "ccaf2d7c-3557-543d-af50-fae40376027f" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /5}\\operatorname{sin}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ffc1fc67-a5a0-5126-89ee-1dd84d13b93e" :answer/id #uuid "ffc1fc67-a5a0-5126-89ee-1dd84d13b93e" :answer/type :answer.type/math :answer/value "\\frac{3}{4}{\\int }_{0}^{\\pi /10}{sin}^{2}⁡(5+\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-c0162a02-455a-5f09-a239-5b7fe41f7d10" :answer/id #uuid "c0162a02-455a-5f09-a239-5b7fe41f7d10" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{0}^{2\\pi /5}{sin}^{2}⁡(\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-7ec012b5-f731-5c5e-96d4-923c5b550d86" :answer/id #uuid "7ec012b5-f731-5c5e-96d4-923c5b550d86" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{0}^{\\pi /5}{sin}^{2}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-77bce5e4-123e-5ff9-af9f-15d1cb34dfd9" :question/id #uuid "77bce5e4-123e-5ff9-af9f-15d1cb34dfd9" :question/math-academy-id "q-127796" :question/problem "![](images/19/192007bbd5aee67607897bc1e4e3e29d106c8f6041fe8b06025f48999e68fcfb.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=\\operatorname{sin}⁡(9\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\operatorname{sin}⁡(9\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\operatorname{sin}⁡(9\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits.  \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\operatorname{sin}⁡(9\\theta )=0.\n$$\n\nThis gives us two solutions for $9\\theta \\in [0,2\\pi ):$\n\n$$\n9\\theta =0,\\pi \\,⟹\\,\\theta =0,\\frac{\\pi }{9}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [0,\\frac{\\pi }{9}].$  Notice that this interval lies in the first quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{0}^{\\pi /9}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2af88dd3-9486-5aea-a0ba-f768f6515698"] :db/ensure [:question/validate]} {:db/id "answer-field-2af88dd3-9486-5aea-a0ba-f768f6515698" :answer-field/id #uuid "2af88dd3-9486-5aea-a0ba-f768f6515698" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1ca5b55e-64e9-57fc-988e-cb6395776e42" :answer-field/choices ["answer-d8708299-6b74-5928-9a08-9d2da799883a" "answer-706f5975-5ca9-5baa-a6cc-d37212c61ecb" "answer-1ca5b55e-64e9-57fc-988e-cb6395776e42" "answer-1ecded90-01b7-5d43-b3ff-b3f9fe7aed89" "answer-7b31c624-e893-58d9-9540-be3f1b71efc6"] :db/ensure [:answer-field/validate]} {:db/id "answer-d8708299-6b74-5928-9a08-9d2da799883a" :answer/id #uuid "d8708299-6b74-5928-9a08-9d2da799883a" :answer/type :answer.type/math :answer/value "3{\\int }_{0}^{\\pi /9}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-706f5975-5ca9-5baa-a6cc-d37212c61ecb" :answer/id #uuid "706f5975-5ca9-5baa-a6cc-d37212c61ecb" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /6}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-1ca5b55e-64e9-57fc-988e-cb6395776e42" :answer/id #uuid "1ca5b55e-64e9-57fc-988e-cb6395776e42" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /9}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-1ecded90-01b7-5d43-b3ff-b3f9fe7aed89" :answer/id #uuid "1ecded90-01b7-5d43-b3ff-b3f9fe7aed89" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /3}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-7b31c624-e893-58d9-9540-be3f1b71efc6" :answer/id #uuid "7b31c624-e893-58d9-9540-be3f1b71efc6" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /9}{sin}^{2}⁡(9\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186106148 :question/problem "![](images/01/01a371be4c5a555b0d3790431111468acfed1471d16c4c4c305bcfe311ce3576.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=\\operatorname{sin}⁡(3\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\operatorname{sin}⁡(3\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\operatorname{sin}⁡(3\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits.  \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\operatorname{sin}⁡(3\\theta )=0.\n$$\n\nThis gives us two solutions for $3\\theta \\in [0,2\\pi ):$\n\n$$\n3\\theta =0,\\pi \\,⟹\\,\\theta =0,\\frac{\\pi }{3}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [0,\\frac{\\pi }{3}].$ Notice that this interval lies in the first quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{0}^{\\pi /3}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186102764 :answer-field/correct "answer-f213dbd7-8a94-5e4a-8f52-24a730f798a4" :answer-field/choices ["answer-40c51311-8856-5758-9682-9586a5a3a274" "answer-990dde5b-5c60-56f9-aa59-5fb12862070a" "answer-cb36aeac-bf37-5bf6-bcca-5eac16ae3089" "answer-f213dbd7-8a94-5e4a-8f52-24a730f798a4" "answer-ce96ff87-2f38-5ce1-a84d-662458a4201e"] :db/ensure [:answer-field/validate]} {:db/id "answer-40c51311-8856-5758-9682-9586a5a3a274" :answer/id #uuid "40c51311-8856-5758-9682-9586a5a3a274" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /3}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-990dde5b-5c60-56f9-aa59-5fb12862070a" :answer/id #uuid "990dde5b-5c60-56f9-aa59-5fb12862070a" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /4}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-cb36aeac-bf37-5bf6-bcca-5eac16ae3089" :answer/id #uuid "cb36aeac-bf37-5bf6-bcca-5eac16ae3089" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /3}^{\\pi /3}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-f213dbd7-8a94-5e4a-8f52-24a730f798a4" :answer/id #uuid "f213dbd7-8a94-5e4a-8f52-24a730f798a4" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /3}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ce96ff87-2f38-5ce1-a84d-662458a4201e" :answer/id #uuid "ce96ff87-2f38-5ce1-a84d-662458a4201e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /4}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-96dc50ad-7c40-5c2b-a752-a6f1cca71c8d" :question/id #uuid "96dc50ad-7c40-5c2b-a752-a6f1cca71c8d" :question/math-academy-id "q-127794" :question/problem "![](images/b7/b7475f0a169e62121711d52daaf51e8954053fc35738266d94240b6e70de6258.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=4\\operatorname{sin}⁡(2\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=4\\operatorname{sin}⁡(2\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(4\\operatorname{sin}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =8{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{sin}^{2}⁡(2\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits.  \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n4\\operatorname{sin}⁡(2\\theta )=0.\n$$\n\nThis gives us two solutions for $2\\theta \\in [0,2\\pi ):$\n\n$$\n2\\theta =0,\\pi \\,⟹\\,\\theta =0,\\frac{\\pi }{2}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [0,\\frac{\\pi }{2}].$ Notice that this interval lies in the first quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\nA=8{\\int }_{0}^{\\pi /2}{sin}^{2}⁡(2\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-86333074-728b-5345-a40e-5dbc3ddeb7aa"] :db/ensure [:question/validate]} {:db/id "answer-field-86333074-728b-5345-a40e-5dbc3ddeb7aa" :answer-field/id #uuid "86333074-728b-5345-a40e-5dbc3ddeb7aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-48a4b65d-2629-5920-82b0-6f811ae028d8" :answer-field/choices ["answer-988ee9dd-88bf-5f48-a619-635ec25c4e12" "answer-b937f4f6-23c9-5053-860a-c16580c2fbb5" "answer-0be217e1-8af5-5001-b379-27a9f68b7e99" "answer-48a4b65d-2629-5920-82b0-6f811ae028d8" "answer-e771cf3c-1b99-5030-acbb-373402951169"] :db/ensure [:answer-field/validate]} {:db/id "answer-988ee9dd-88bf-5f48-a619-635ec25c4e12" :answer/id #uuid "988ee9dd-88bf-5f48-a619-635ec25c4e12" :answer/type :answer.type/math :answer/value "16{\\int }_{0}^{\\pi /2}{sin}^{2}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b937f4f6-23c9-5053-860a-c16580c2fbb5" :answer/id #uuid "b937f4f6-23c9-5053-860a-c16580c2fbb5" :answer/type :answer.type/math :answer/value "16{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-0be217e1-8af5-5001-b379-27a9f68b7e99" :answer/id #uuid "0be217e1-8af5-5001-b379-27a9f68b7e99" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-48a4b65d-2629-5920-82b0-6f811ae028d8" :answer/id #uuid "48a4b65d-2629-5920-82b0-6f811ae028d8" :answer/type :answer.type/math :answer/value "8{\\int }_{0}^{\\pi /2}{sin}^{2}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-e771cf3c-1b99-5030-acbb-373402951169" :answer/id #uuid "e771cf3c-1b99-5030-acbb-373402951169" :answer/type :answer.type/math :answer/value "8{\\int }_{0}^{\\pi }{sin}^{2}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-3aec8613-8bc5-55d8-bb63-25dfe3e5bcce" :question/id #uuid "3aec8613-8bc5-55d8-bb63-25dfe3e5bcce" :question/math-academy-id "q-127800" :question/problem "![](images/44/446278a820ba21da7f5a1f15639e8cc4f96e38f38f3b5905b926bb9d2a106948.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡(6\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡(6\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{cos}^{2}⁡(6\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡(6\\theta )=0.\n$$\n\nNotice that the first petal lies between the first and fourth quadrants. So it's convenient to assume that $\\theta $ can be negative.\n\nWe now solve the above equation for $6\\theta \\in [-\\pi ,\\pi ):$\n\n$$\n6\\theta =-\\frac{\\pi }{2},\\frac{\\pi }{2}\\,⟹\\,\\theta =-\\frac{\\pi }{12},\\frac{\\pi }{12}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [-\\frac{\\pi }{12},\\frac{\\pi }{12}].$ Notice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{1}{4}{\\int }_{-\\pi /12}^{\\pi /12}{cos}^{2}⁡(6\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5db885ae-a359-50aa-b94a-866c4319d576"] :db/ensure [:question/validate]} {:db/id "answer-field-5db885ae-a359-50aa-b94a-866c4319d576" :answer-field/id #uuid "5db885ae-a359-50aa-b94a-866c4319d576" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e724f53d-777b-5184-bede-b852c936bd20" :answer-field/choices ["answer-27ef4703-6639-5623-8c0b-2ffb2cd82831" "answer-6c6a7060-6e4d-5e7b-9e87-0feb10e6a475" "answer-a98b5b54-648a-5f5c-abff-c03076a297d6" "answer-42047be1-5cd9-5f0f-9112-70b8e78c7e75" "answer-e724f53d-777b-5184-bede-b852c936bd20"] :db/ensure [:answer-field/validate]} {:db/id "answer-27ef4703-6639-5623-8c0b-2ffb2cd82831" :answer/id #uuid "27ef4703-6639-5623-8c0b-2ffb2cd82831" :answer/type :answer.type/math :answer/value "2{\\int }_{-\\pi /12}^{\\pi /12}{cos}^{2}⁡(6\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6c6a7060-6e4d-5e7b-9e87-0feb10e6a475" :answer/id #uuid "6c6a7060-6e4d-5e7b-9e87-0feb10e6a475" :answer/type :answer.type/math :answer/value "4{\\int }_{-\\pi /12}^{\\pi /12}\\operatorname{cos}⁡(6\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-a98b5b54-648a-5f5c-abff-c03076a297d6" :answer/id #uuid "a98b5b54-648a-5f5c-abff-c03076a297d6" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /12}^{\\pi /12}\\operatorname{cos}⁡(6\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-42047be1-5cd9-5f0f-9112-70b8e78c7e75" :answer/id #uuid "42047be1-5cd9-5f0f-9112-70b8e78c7e75" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /12}^{\\pi /12}{cos}^{2}⁡(6\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-e724f53d-777b-5184-bede-b852c936bd20" :answer/id #uuid "e724f53d-777b-5184-bede-b852c936bd20" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{-\\pi /12}^{\\pi /12}{cos}^{2}⁡(6\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-809efbd7-39b4-57dd-a5fb-9c26fa380f5b" :question/id #uuid "809efbd7-39b4-57dd-a5fb-9c26fa380f5b" :question/math-academy-id "q-83792" :question/problem "![](images/f3/f3196a19057d5a5f658faad1ef028b12a12b87de56f93dc3f2df1aa03f21fcf2.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=\\sqrt{2}\\operatorname{cos}⁡(7\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\sqrt{2}\\operatorname{cos}⁡(7\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\sqrt{2}\\operatorname{cos}⁡(7\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\sqrt{2}\\operatorname{cos}⁡(7\\theta )=0.\n$$\n\nNotice that the first petal lies between the first and fourth quadrants. So it's convenient to assume that $\\theta $ can be negative.\n\nWe now solve the above equation for $7\\theta \\in [-\\pi ,\\pi ):$\n\n$$\n7\\theta =-\\frac{\\pi }{2},\\frac{\\pi }{2}\\,⟹\\,\\theta =-\\frac{\\pi }{14},\\frac{\\pi }{14}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [-\\frac{\\pi }{14},\\frac{\\pi }{14}].$ Notice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n{\\int }_{-\\pi /14}^{\\pi /14}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d5052787-b20b-5d33-ba51-bf4f48076c76"] :db/ensure [:question/validate]} {:db/id "answer-field-d5052787-b20b-5d33-ba51-bf4f48076c76" :answer-field/id #uuid "d5052787-b20b-5d33-ba51-bf4f48076c76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-30b68c56-30ad-5a97-b72c-21abfa85a7c5" :answer-field/choices ["answer-bf25fda7-ec73-59b4-b184-e2d87135abad" "answer-3d6c810c-df15-56ca-b73a-c69a46243cb1" "answer-ee5b4cd2-2eef-5d45-be9d-b231d277d3dd" "answer-30b68c56-30ad-5a97-b72c-21abfa85a7c5" "answer-9c5423ac-fe72-5892-8908-80ac3a1cfa10"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf25fda7-ec73-59b4-b184-e2d87135abad" :answer/id #uuid "bf25fda7-ec73-59b4-b184-e2d87135abad" :answer/type :answer.type/math :answer/value "2{\\int }_{-\\pi /7}^{\\pi /7}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-3d6c810c-df15-56ca-b73a-c69a46243cb1" :answer/id #uuid "3d6c810c-df15-56ca-b73a-c69a46243cb1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /14}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ee5b4cd2-2eef-5d45-be9d-b231d277d3dd" :answer/id #uuid "ee5b4cd2-2eef-5d45-be9d-b231d277d3dd" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{-\\pi /14}^{\\pi /14}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-30b68c56-30ad-5a97-b72c-21abfa85a7c5" :answer/id #uuid "30b68c56-30ad-5a97-b72c-21abfa85a7c5" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /14}^{\\pi /14}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-9c5423ac-fe72-5892-8908-80ac3a1cfa10" :answer/id #uuid "9c5423ac-fe72-5892-8908-80ac3a1cfa10" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /14}{cos}^{2}⁡(7\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186106037 :question/problem "![](images/1c/1c296052cfe60b35b326029afa1efb610ce32e4e2fb3ae0d63f24e437c3bbfb2.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=\\sqrt{2}\\operatorname{cos}⁡(3\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\sqrt{2}\\operatorname{cos}⁡(3\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\sqrt{2}\\operatorname{cos}⁡(3\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{cos}^{2}⁡(3\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\sqrt{2}\\operatorname{cos}⁡(3\\theta )=0.\n$$\n\nNotice that the first petal lies between the first and fourth quadrants. So it's convenient to assume that $\\theta $ can be negative.\n\nWe now solve the above equation for $3\\theta \\in [-\\pi ,\\pi ):$\n\n$$\n3\\theta =-\\frac{\\pi }{2},\\frac{\\pi }{2}\\,⟹\\,\\theta =-\\frac{\\pi }{6},\\frac{\\pi }{6}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [-\\frac{\\pi }{6},\\frac{\\pi }{6}].$ Notice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n{\\int }_{-\\pi /6}^{\\pi /6}{cos}^{2}⁡(3\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186102108 :answer-field/correct "answer-04aaf6f0-1ada-5467-bb53-d81bc7503a1e" :answer-field/choices ["answer-66fe0a64-caf0-5d4e-a637-a3c583daff6f" "answer-55c8f95e-9be1-5a02-b4e5-0870aeadb069" "answer-6a25df31-0140-584d-8f5b-d560aebe68ec" "answer-04aaf6f0-1ada-5467-bb53-d81bc7503a1e" "answer-4e6a6ef5-246a-53a2-81a7-26459da54ef2"] :db/ensure [:answer-field/validate]} {:db/id "answer-66fe0a64-caf0-5d4e-a637-a3c583daff6f" :answer/id #uuid "66fe0a64-caf0-5d4e-a637-a3c583daff6f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /6}{cos}^{2}⁡(\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-55c8f95e-9be1-5a02-b4e5-0870aeadb069" :answer/id #uuid "55c8f95e-9be1-5a02-b4e5-0870aeadb069" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{-\\pi /6}^{\\pi /2}{cos}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6a25df31-0140-584d-8f5b-d560aebe68ec" :answer/id #uuid "6a25df31-0140-584d-8f5b-d560aebe68ec" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{\\pi /6}\\operatorname{cos}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-04aaf6f0-1ada-5467-bb53-d81bc7503a1e" :answer/id #uuid "04aaf6f0-1ada-5467-bb53-d81bc7503a1e" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{\\pi /6}{cos}^{2}⁡(3\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-4e6a6ef5-246a-53a2-81a7-26459da54ef2" :answer/id #uuid "4e6a6ef5-246a-53a2-81a7-26459da54ef2" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{\\pi }{cos}^{2}⁡(3+\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-7f3edede-f2b8-5413-b0b9-835c57755de4" :question/id #uuid "7f3edede-f2b8-5413-b0b9-835c57755de4" :question/math-academy-id "q-124414" :question/problem "![](images/51/51ab11405aeb635dafaeadef1b174db163f395a62126225f99de07884b3d8cb9.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=2\\operatorname{cos}⁡(4\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=2\\operatorname{cos}⁡(4\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(2\\operatorname{cos}⁡(4\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{cos}^{2}⁡(4\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n2\\operatorname{cos}⁡(4\\theta )=0.\n$$\n\nNotice that the first petal lies between the first and fourth quadrants. So it's convenient to assume that $\\theta $ can be negative.\n\nWe now solve the above equation for $4\\theta \\in [-\\pi ,\\pi ):$\n\n$$\n4\\theta =-\\frac{\\pi }{2},\\frac{\\pi }{2}\\,⟹\\,\\theta =-\\frac{\\pi }{8},\\frac{\\pi }{8}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [-\\frac{\\pi }{8},\\frac{\\pi }{8}].$ Notice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n2{\\int }_{-\\pi /8}^{\\pi /8}{cos}^{2}⁡(4\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d6c931c3-cfba-5275-ba59-84cd3742ca6e"] :db/ensure [:question/validate]} {:db/id "answer-field-d6c931c3-cfba-5275-ba59-84cd3742ca6e" :answer-field/id #uuid "d6c931c3-cfba-5275-ba59-84cd3742ca6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-83b74220-3ac7-54d2-b4de-ea3f0fdab608" :answer-field/choices ["answer-6b0cbc70-aa26-5af9-a6bb-3e3f85dc4845" "answer-83b74220-3ac7-54d2-b4de-ea3f0fdab608" "answer-b13fd3a4-0f4b-5c2c-b0f7-8169cad6dd54" "answer-63855fed-118f-5138-a879-f0b81c16d4f0" "answer-726eeee2-98d9-5930-919c-11fd667234f8"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b0cbc70-aa26-5af9-a6bb-3e3f85dc4845" :answer/id #uuid "6b0cbc70-aa26-5af9-a6bb-3e3f85dc4845" :answer/type :answer.type/math :answer/value "2{\\int }_{-\\pi /8}^{\\pi /8}\\operatorname{cos}⁡(4\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-83b74220-3ac7-54d2-b4de-ea3f0fdab608" :answer/id #uuid "83b74220-3ac7-54d2-b4de-ea3f0fdab608" :answer/type :answer.type/math :answer/value "2{\\int }_{-\\pi /8}^{\\pi /8}{cos}^{2}⁡(4\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b13fd3a4-0f4b-5c2c-b0f7-8169cad6dd54" :answer/id #uuid "b13fd3a4-0f4b-5c2c-b0f7-8169cad6dd54" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /8}{cos}^{2}⁡(\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-63855fed-118f-5138-a879-f0b81c16d4f0" :answer/id #uuid "63855fed-118f-5138-a879-f0b81c16d4f0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{\\int }_{0}^{\\pi /4}{cos}^{2}⁡(4+\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-726eeee2-98d9-5930-919c-11fd667234f8" :answer/id #uuid "726eeee2-98d9-5930-919c-11fd667234f8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡(2\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-790dcc10-7f22-59d7-b4bc-0f6943a2af9d" :question/id #uuid "790dcc10-7f22-59d7-b4bc-0f6943a2af9d" :question/math-academy-id "q-14916" :question/problem "![](images/f6/f62e6a4cec5b2a877f2491a101f3929edd6664424b86daab4bbfe8096c5c9282.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve $r=3\\operatorname{cos}⁡(5\\theta ),$ represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=3\\operatorname{cos}⁡(5\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(3\\operatorname{cos}⁡(5\\theta ))}^{2}\\,\\text{d}\\theta  \\\\  & =\\frac{9}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n3\\operatorname{cos}⁡(5\\theta )=0.\n$$\n\nNotice that the first petal lies between the first and fourth quadrants. So it's convenient to assume that $\\theta $ can be negative.\n\nWe now solve the above equation for $5\\theta \\in [-\\pi ,\\pi ):$\n\n$$\n5\\theta =-\\frac{\\pi }{2},\\frac{\\pi }{2}\\,⟹\\,\\theta =-\\frac{\\pi }{10},\\frac{\\pi }{10}\n$$\n\nTherefore, the first petal is traversed for $\\theta \\in [-\\frac{\\pi }{10},\\frac{\\pi }{10}].$ Notice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{9}{2}{\\int }_{-\\pi /10}^{\\pi /10}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b53aa41e-e9c5-50c8-ab7e-c6508a46ac1a"] :db/ensure [:question/validate]} {:db/id "answer-field-b53aa41e-e9c5-50c8-ab7e-c6508a46ac1a" :answer-field/id #uuid "b53aa41e-e9c5-50c8-ab7e-c6508a46ac1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28cb0b75-f16a-56d1-a298-8e7854f23b0d" :answer-field/choices ["answer-24532688-eec4-5621-92fa-532033042c6e" "answer-d84ce1a1-cfbc-5d9c-a9e0-a3de51b4f70e" "answer-ce0fc7b3-5743-5f2c-83ef-929c57f0d1a7" "answer-28cb0b75-f16a-56d1-a298-8e7854f23b0d" "answer-3301cca7-812b-5032-929a-442a1ea385d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-24532688-eec4-5621-92fa-532033042c6e" :answer/id #uuid "24532688-eec4-5621-92fa-532033042c6e" :answer/type :answer.type/math :answer/value "\\frac{2}{3}{\\int }_{0}^{\\pi /2}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d84ce1a1-cfbc-5d9c-a9e0-a3de51b4f70e" :answer/id #uuid "d84ce1a1-cfbc-5d9c-a9e0-a3de51b4f70e" :answer/type :answer.type/math :answer/value "\\frac{2}{9}{\\int }_{-\\pi /2}^{\\pi /2}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ce0fc7b3-5743-5f2c-83ef-929c57f0d1a7" :answer/id #uuid "ce0fc7b3-5743-5f2c-83ef-929c57f0d1a7" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{\\int }_{0}^{\\pi /10}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-28cb0b75-f16a-56d1-a298-8e7854f23b0d" :answer/id #uuid "28cb0b75-f16a-56d1-a298-8e7854f23b0d" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{-\\pi /10}^{\\pi /10}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-3301cca7-812b-5032-929a-442a1ea385d8" :answer/id #uuid "3301cca7-812b-5032-929a-442a1ea385d8" :answer/type :answer.type/math :answer/value "\\frac{9}{2}{\\int }_{-\\pi /5}^{\\pi /5}{cos}^{2}⁡(5\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-2be045cc-480f-57a5-b39f-c617f83c588d" :question/id #uuid "2be045cc-480f-57a5-b39f-c617f83c588d" :question/math-academy-id "q-125349" :question/problem "![](images/94/9405ee6a4b24ef36c2a59a9f4a984728716e9c281456d1459d591393d3c73720.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve\n$r=\\sqrt{\\operatorname{cos}⁡(4\\theta +\\pi )},$\n  represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\sqrt{\\operatorname{cos}⁡(4\\theta +\\pi )}$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\operatorname{cos}⁡(4\\theta +\\pi )\\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\begin{aligned}\\sqrt{\\operatorname{cos}⁡(4\\theta +\\pi )} & =0 \\\\ \\operatorname{cos}⁡(4\\theta +\\pi ) & =0.\\end{aligned}\n$$\n\nFrom the diagram, the first petal lies in the fourth quadrant. Since the petal lies in the fourth quadrant, it is convenient to allow negative values of $\\theta $ when determining the interval.\n\nThe solutions for $4\\theta +\\pi $ closest to $0$ on either side are\n\n$$\n4\\theta +\\pi =-\\frac{\\pi }{2},\\frac{\\pi }{2}\\,⟹\\,4\\theta =-\\frac{3\\pi }{2},-\\frac{\\pi }{2}\\,⟹\\,\\theta =-\\frac{3\\pi }{8},-\\frac{\\pi }{8}.\n$$\n\nTherefore, the first petal is traversed for \n\n$$\n\\theta \\in [-\\frac{3\\pi }{8},-\\frac{\\pi }{8}].\n$$\n\n \n\nNotice that this interval lies in the fourth quadrant, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{1}{2}{\\int }_{-3\\pi /8}^{-\\pi /8}\\operatorname{cos}⁡(4\\theta +\\pi )\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94f7246e-f57b-594c-be96-bb72d5c5cb6b"] :db/ensure [:question/validate]} {:db/id "answer-field-94f7246e-f57b-594c-be96-bb72d5c5cb6b" :answer-field/id #uuid "94f7246e-f57b-594c-be96-bb72d5c5cb6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c50a1248-20d5-5e72-88fe-eb63c706b7e1" :answer-field/choices ["answer-c50a1248-20d5-5e72-88fe-eb63c706b7e1" "answer-d65fab8c-cab0-5add-bbca-2b554091e44d" "answer-4fab53b6-6248-5945-8620-04b4fd64fbe0" "answer-cb989c47-35ee-5257-b346-93de6ab5fb9e" "answer-3c54c735-3838-59f7-9d18-f9c4833f0ed2"] :db/ensure [:answer-field/validate]} {:db/id "answer-c50a1248-20d5-5e72-88fe-eb63c706b7e1" :answer/id #uuid "c50a1248-20d5-5e72-88fe-eb63c706b7e1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-3\\pi /8}^{-\\pi /8}\\operatorname{cos}⁡(4\\theta +\\pi )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d65fab8c-cab0-5add-bbca-2b554091e44d" :answer/id #uuid "d65fab8c-cab0-5add-bbca-2b554091e44d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-3\\pi /8}^{-\\pi /8}{cos}^{2}⁡(4\\theta +\\pi )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-4fab53b6-6248-5945-8620-04b4fd64fbe0" :answer/id #uuid "4fab53b6-6248-5945-8620-04b4fd64fbe0" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-3\\pi /8}^{3\\pi /8}\\operatorname{cos}⁡(4\\theta +\\pi )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-cb989c47-35ee-5257-b346-93de6ab5fb9e" :answer/id #uuid "cb989c47-35ee-5257-b346-93de6ab5fb9e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /4}^{-\\pi /8}\\operatorname{cos}⁡(4\\theta +\\pi )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-3c54c735-3838-59f7-9d18-f9c4833f0ed2" :answer/id #uuid "3c54c735-3838-59f7-9d18-f9c4833f0ed2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /4}^{-\\pi /8}{cos}^{2}⁡(4\\theta +\\pi )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-841c4177-3882-5def-83ad-75d73368e31f" :question/id #uuid "841c4177-3882-5def-83ad-75d73368e31f" :question/math-academy-id "q-127997" :question/problem "![](images/0b/0befc6c40eb7b53a45f1e27d0445d5abc614937c37b36d5cbf5420e1d2b51ff9.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve \n$r=\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ),$\n represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))}^{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\begin{aligned}\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ) & =0 \\\\ 2\\operatorname{cos}⁡(4\\theta ) & =-\\sqrt{3} \\\\ \\operatorname{cos}⁡(4\\theta ) & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nFrom the diagram, the first petal extends from the fourth quadrant to the first quadrant. Since the petal begins in the fourth quadrant, it is convenient to allow negative values of $\\theta $ when determining the interval.\n\nThe solutions for $4\\theta $ closest to $0$ on either side are\n\n$$\n4\\theta =-\\frac{5\\pi }{6},\\frac{5\\pi }{6}\\,⟹\\,\\theta =-\\frac{5\\pi }{24},\\frac{5\\pi }{24}.\n$$\n\nTherefore, the first petal is traversed for \n\n$$\n\\theta \\in [-\\frac{5\\pi }{24},\\frac{5\\pi }{24}].\n$$\n\n \n\nNotice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{1}{2}{\\int }_{-5\\pi /24}^{5\\pi /24}{(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))}^{2}\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4d0dc722-35ee-5af2-833d-cec03bbc5f7b"] :db/ensure [:question/validate]} {:db/id "answer-field-4d0dc722-35ee-5af2-833d-cec03bbc5f7b" :answer-field/id #uuid "4d0dc722-35ee-5af2-833d-cec03bbc5f7b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-92f84b7b-a5c3-5077-a2b7-a15ef5aaed82" :answer-field/choices ["answer-b7726ad9-a1d0-5c91-a3b7-f047de128038" "answer-6460b2fb-7268-53e2-8310-f6e3e9f4da9f" "answer-92f84b7b-a5c3-5077-a2b7-a15ef5aaed82" "answer-d7293488-db7d-5465-8e92-167469afa235" "answer-7455fe81-1ff5-5cd4-b856-44ac7b5375d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7726ad9-a1d0-5c91-a3b7-f047de128038" :answer/id #uuid "b7726ad9-a1d0-5c91-a3b7-f047de128038" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /12}^{5\\pi /12}{(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6460b2fb-7268-53e2-8310-f6e3e9f4da9f" :answer/id #uuid "6460b2fb-7268-53e2-8310-f6e3e9f4da9f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /24}^{5\\pi /24}(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-92f84b7b-a5c3-5077-a2b7-a15ef5aaed82" :answer/id #uuid "92f84b7b-a5c3-5077-a2b7-a15ef5aaed82" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /24}^{5\\pi /24}{(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d7293488-db7d-5465-8e92-167469afa235" :answer/id #uuid "d7293488-db7d-5465-8e92-167469afa235" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /6}^{5\\pi /6}(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-7455fe81-1ff5-5cd4-b856-44ac7b5375d9" :answer/id #uuid "7455fe81-1ff5-5cd4-b856-44ac7b5375d9" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /6}^{5\\pi /6}{(\\sqrt{3}+2\\operatorname{cos}⁡(4\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-a11f42c6-9c97-5af9-adee-a7210e67b825" :question/id #uuid "a11f42c6-9c97-5af9-adee-a7210e67b825" :question/math-academy-id "q-128009" :question/problem "![](images/cc/cc41b37639eb7715fbecd55510222f77957c05b705bc83b93c755ad2e7cf3dcd.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve\n$r=1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}),$\n  represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6})$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))}^{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\begin{aligned}1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}) & =0 \\\\ \\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}) & =-1.\\end{aligned}\n$$\n\nFrom the diagram, the first petal extends from the fourth quadrant to the first quadrant. Since the petal begins in the fourth quadrant, it is convenient to allow negative values of $\\theta $ when determining the interval.\n\nThe solutions for $4\\theta +\\frac{5\\pi }{6}$ closest to $0$ on either side are\n\n$$\n4\\theta +\\frac{5\\pi }{6}=-\\pi ,\\pi \\,⟹\\,4\\theta =-\\frac{11\\pi }{6},\\frac{\\pi }{6}\\,⟹\\,\\theta =-\\frac{11\\pi }{24},\\frac{\\pi }{24}.\n$$\n\nTherefore, the first petal is traversed for \n\n$$\n\\theta \\in [-\\frac{11\\pi }{24},\\frac{\\pi }{24}].\n$$\n\n \n\nNotice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{1}{2}{\\int }_{-11\\pi /24}^{\\pi /24}{(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))}^{2}\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b7a05f9d-bc78-562f-97c9-53bdd878f4a7"] :db/ensure [:question/validate]} {:db/id "answer-field-b7a05f9d-bc78-562f-97c9-53bdd878f4a7" :answer-field/id #uuid "b7a05f9d-bc78-562f-97c9-53bdd878f4a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7a839304-0eaa-5bd1-991e-aef2bfde6fa3" :answer-field/choices ["answer-3706d8af-6d1d-5cf1-8135-8e4636d730bf" "answer-f00673f9-7b84-5686-a930-58c169a4d2f1" "answer-7a839304-0eaa-5bd1-991e-aef2bfde6fa3" "answer-c66fd37c-733e-5b4d-a121-7cc00eec7641" "answer-8a565251-4df8-54ec-82e4-90426624b915"] :db/ensure [:answer-field/validate]} {:db/id "answer-3706d8af-6d1d-5cf1-8135-8e4636d730bf" :answer/id #uuid "3706d8af-6d1d-5cf1-8135-8e4636d730bf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-11\\pi /12}^{\\pi /24}{(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-f00673f9-7b84-5686-a930-58c169a4d2f1" :answer/id #uuid "f00673f9-7b84-5686-a930-58c169a4d2f1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-11\\pi /24}^{\\pi /24}(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-7a839304-0eaa-5bd1-991e-aef2bfde6fa3" :answer/id #uuid "7a839304-0eaa-5bd1-991e-aef2bfde6fa3" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-11\\pi /24}^{\\pi /24}{(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-c66fd37c-733e-5b4d-a121-7cc00eec7641" :answer/id #uuid "c66fd37c-733e-5b4d-a121-7cc00eec7641" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-13\\pi /24}^{\\pi /24}(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8a565251-4df8-54ec-82e4-90426624b915" :answer/id #uuid "8a565251-4df8-54ec-82e4-90426624b915" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-15\\pi /24}^{\\pi /24}{(1+\\operatorname{cos}⁡(4\\theta +\\frac{5\\pi }{6}))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-5a2aaba8-489e-5805-b9f6-0c2a5c67d926" :question/id #uuid "5a2aaba8-489e-5805-b9f6-0c2a5c67d926" :question/math-academy-id "q-360575" :question/problem "![](images/6f/6feb80156311c92f948b35742b39df3e6582c62a0d578481026b3141b01de3f1.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve \n$r=2+2\\operatorname{cos}⁡(6\\theta ),$\n represented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=2+2\\operatorname{cos}⁡(6\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(2+2\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\begin{aligned}2+2\\operatorname{cos}⁡(6\\theta ) & =0 \\\\ \\operatorname{cos}⁡(6\\theta ) & =-1.\\end{aligned}\n$$\n\nFrom the diagram, the first petal extends from the fourth quadrant to the first quadrant. Since the petal begins in the fourth quadrant, it is convenient to allow negative values of $\\theta $ when determining the interval.\n\nThe solutions for $6\\theta $ closest to $0$ on either side are\n\n$$\n6\\theta =-\\pi ,\\pi \\,⟹\\,\\theta =-\\frac{\\pi }{6},\\frac{\\pi }{6}.\n$$\n\nTherefore, the first petal is traversed for \n\n$$\n\\theta \\in [-\\frac{\\pi }{6},\\frac{\\pi }{6}].\n$$\n\nNotice that this interval matches the angular region traced by the shaded petal in the diagram.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}{(2+2\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a7ef8298-8d9d-5983-baab-fbc6991d3cdb"] :db/ensure [:question/validate]} {:db/id "answer-field-a7ef8298-8d9d-5983-baab-fbc6991d3cdb" :answer-field/id #uuid "a7ef8298-8d9d-5983-baab-fbc6991d3cdb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-decc0c03-0ede-5b99-bbde-50a8ef28dfcb" :answer-field/choices ["answer-07480ff0-ae02-581d-86f9-7d724c53aaa3" "answer-decc0c03-0ede-5b99-bbde-50a8ef28dfcb" "answer-9eef7171-be32-50a0-8e70-e1831b5e568b" "answer-8cbbf9ef-e697-551c-a40d-ef84f5139aed" "answer-d52a5d39-739c-5ddf-bfd4-0166361d02cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-07480ff0-ae02-581d-86f9-7d724c53aaa3" :answer/id #uuid "07480ff0-ae02-581d-86f9-7d724c53aaa3" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /12}^{\\pi /12}{(2+2\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-decc0c03-0ede-5b99-bbde-50a8ef28dfcb" :answer/id #uuid "decc0c03-0ede-5b99-bbde-50a8ef28dfcb" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /6}^{\\pi /6}{(2+2\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-9eef7171-be32-50a0-8e70-e1831b5e568b" :answer/id #uuid "9eef7171-be32-50a0-8e70-e1831b5e568b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /8}^{\\pi /8}{(2+2\\operatorname{cos}⁡(6\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8cbbf9ef-e697-551c-a40d-ef84f5139aed" :answer/id #uuid "8cbbf9ef-e697-551c-a40d-ef84f5139aed" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{\\pi /6}(2+2\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d52a5d39-739c-5ddf-bfd4-0166361d02cd" :answer/id #uuid "d52a5d39-739c-5ddf-bfd4-0166361d02cd" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /8}^{\\pi /8}(2+2\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-3922fac2-663d-5efa-bc44-c819bbafb745" :question/id #uuid "3922fac2-663d-5efa-bc44-c819bbafb745" :question/math-academy-id "q-125357" :question/problem "![](images/d9/d9985c6afd3e5440dbe1e51e4046e7744c9a2e01472354054796247d40ed7ed6.png)\n\nWhich of the following represents the area enclosed by the first petal of the polar curve \n$r=\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ),$\nrepresented by the shaded region shown above?" :question/worked-solution "The area bounded by a polar curve is given by\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{r}^{2}(\\theta )\\,\\text{d}\\theta .\n$$\n\nSince $r(\\theta )=\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta )$, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}{(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nWe now proceed to find the integration limits. \n\nThe curve bounding the region crosses itself at the origin. Therefore, we want to find the values of $\\theta $ for which $r=0$, or \n\n$$\n\\begin{aligned}\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ) & =0 \\\\ 2\\operatorname{cos}⁡(2\\theta ) & =-\\sqrt{3} \\\\ \\operatorname{cos}⁡(2\\theta ) & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nFrom the diagram, the first petal extends from the fourth quadrant to the first quadrant. Since the petal begins in the fourth quadrant, it is convenient to allow negative values of $\\theta $ when determining the interval.\n\nThe solutions for $2\\theta $ closest to $0$ on either side are\n\n$$\n2\\theta =-\\frac{5\\pi }{6},\\frac{5\\pi }{6}\\,⟹\\,\\theta =-\\frac{5\\pi }{12},\\frac{5\\pi }{12}.\n$$\n\nTherefore, the first petal is traversed for \n\n$$\n\\theta \\in [-\\frac{5\\pi }{12},\\frac{5\\pi }{12}].\n$$\n\n \n\nNotice that this interval lies between the first and fourth quadrants, the same as our petal.\n\nTherefore, our expression for the area is given by\n\n$$\n\\frac{1}{2}{\\int }_{-5\\pi /12}^{5\\pi /12}{(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-18e19576-c2ce-57ce-a908-4860ee2c8b3f"] :db/ensure [:question/validate]} {:db/id "answer-field-18e19576-c2ce-57ce-a908-4860ee2c8b3f" :answer-field/id #uuid "18e19576-c2ce-57ce-a908-4860ee2c8b3f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e41bf703-af8a-5e9d-9f4f-8722fbf336bb" :answer-field/choices ["answer-69c80d92-4c28-5a07-8592-a922020c016a" "answer-e41bf703-af8a-5e9d-9f4f-8722fbf336bb" "answer-32e39f4a-397e-573f-8267-d6dff3c45d27" "answer-6028d4af-94c2-52de-a2e3-29fdb44dd06c" "answer-8f7607b6-fff2-5114-adf4-8abe60405481"] :db/ensure [:answer-field/validate]} {:db/id "answer-69c80d92-4c28-5a07-8592-a922020c016a" :answer/id #uuid "69c80d92-4c28-5a07-8592-a922020c016a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /12}^{5\\pi /12}(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-e41bf703-af8a-5e9d-9f4f-8722fbf336bb" :answer/id #uuid "e41bf703-af8a-5e9d-9f4f-8722fbf336bb" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /12}^{5\\pi /12}{(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-32e39f4a-397e-573f-8267-d6dff3c45d27" :answer/id #uuid "32e39f4a-397e-573f-8267-d6dff3c45d27" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /6}^{5\\pi /6}(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6028d4af-94c2-52de-a2e3-29fdb44dd06c" :answer/id #uuid "6028d4af-94c2-52de-a2e3-29fdb44dd06c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-5\\pi /6}^{5\\pi /6}{(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8f7607b6-fff2-5114-adf4-8abe60405481" :answer/id #uuid "8f7607b6-fff2-5114-adf4-8abe60405481" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{\\int }_{-\\pi /12}^{\\pi /12}{(\\sqrt{3}+2\\operatorname{cos}⁡(2\\theta ))}^{2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186107022 :tutorial/content "The area bounded by a polar curve $r = r(\\theta)$ and the rays $\\theta = \\theta_1$ and $\\theta = \\theta_2$ is given by\n\n$$\n\\dfrac 1 2\\int_{\\theta_1}^{\\theta_2} r^2\\,\\textrm d \\theta \\, .\n$$\n\nCalculating the integral is often straightforward if we know the integration limits $\\theta_1$ and $\\theta_2$. But what if we don't know these values?\n\nFor example, suppose we want to calculate the total area of the first petal of the curve $r=\\sin(3\\theta),$ shown below.\n\n![](images/e0/e0c9059613162af33791e7edb7413dfbac9739cf24eeabd01b0033acba2b772a.png)\n\nThe curve bounding the blue petal crosses itself at the origin. When it passes through the origin, we must have $r=0,$ and since $r=\\sin(3\\theta),$ we have\n\n$$\n\\sin(3\\theta)=0 \\, .\n$$\n\nThis gives us two solutions for $3\\theta \\in [0,2\\pi)\\mathbin{:}$\n\n$$\n3\\theta = 0,\\pi \\qquad\\Longrightarrow\\qquad \\theta=0,\\dfrac{\\pi}{3}\n$$\n\nTherefore, $\\theta_1 = 0, \\theta_2 = \\dfrac\\pi 3,$ and the area of the first petal is given by\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{0}^{\\pi /3}{sin}^{2}⁡(3\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{0}^{\\pi /3}(1-\\operatorname{cos}⁡(6\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}(\\theta {|}_{0}^{\\pi /3}-\\frac{1}{6}\\operatorname{sin}⁡(6\\theta ){|}_{0}^{\\pi /3}) \\\\  & =\\frac{1}{4}(\\frac{\\pi }{3}+0) \\\\  & =\\frac{\\pi }{12}\\,.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186107126 :tutorial/content "When working with polar coordinates, we primarily use the following domain for the polar angle $\\theta\\mathbin{:}$\n\n$$\n0\\leq \\theta \\lt 2\\pi\n$$\n\nHowever, it's sometimes a good idea to use the domain \n\n$$\n-\\pi \\leq \\theta \\lt \\pi.\n$$\n\nChanging the domain for $\\theta$ turns out to be especially useful when a polar petal spans the first and fourth quadrants. \n\nLet's see an example." :db/ensure [:tutorial/validate]} {:db/id 17592186105983 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186068767 :knowledge-point/questions ["question-e6e37409-094d-5a1f-ac21-68506e2e806b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e6e37409-094d-5a1f-ac21-68506e2e806b" :question/id #uuid "e6e37409-094d-5a1f-ac21-68506e2e806b" :question/math-academy-id "q-80060" :question/problem "Solve the equation $2s+5{s}^{2}=s+4{s}^{2}.$" :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}2s+5{s}^{2} & =s+4{s}^{2} \\\\ 2s+5{s}^{2}-(s+4{s}^{2}) & =0 \\\\ 2s+5{s}^{2}-s-4{s}^{2} & =0 \\\\ (5{s}^{2}-4{s}^{2})+(2s-s) & =0 \\\\ {s}^{2}+s & =0 \\\\ s(s+1) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\ns=0\\,\\text{or}\\,s+1=0,\n$$\n\nwhich in turn gives\n\n$$\ns=0\\,\\text{or}\\,s=-1.\n$$\n\nTherefore, the solutions are $s=-1,0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-079ba6f6-a15e-5361-bff8-b7ea93504fce"] :db/ensure [:question/validate]} {:db/id "answer-field-079ba6f6-a15e-5361-bff8-b7ea93504fce" :answer-field/id #uuid "079ba6f6-a15e-5361-bff8-b7ea93504fce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3ea3018-3bc2-5df5-97d2-d21d26114e9c" :answer-field/choices ["answer-ba7ded0d-2929-5550-8969-007749e21782" "answer-b3ea3018-3bc2-5df5-97d2-d21d26114e9c" "answer-bce0fbd8-e3a8-586a-8e62-a96b5ac0ffe6" "answer-5fed37bd-ffc2-55cd-8012-e2fb109c4833" "answer-e88b13bd-df5f-51b3-a5bb-08db871b5b91"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba7ded0d-2929-5550-8969-007749e21782" :answer/id #uuid "ba7ded0d-2929-5550-8969-007749e21782" :answer/type :answer.type/math :answer/value "s=-1" :db/ensure [:answer/validate]} {:db/id "answer-b3ea3018-3bc2-5df5-97d2-d21d26114e9c" :answer/id #uuid "b3ea3018-3bc2-5df5-97d2-d21d26114e9c" :answer/type :answer.type/math :answer/value "s=-1,0" :db/ensure [:answer/validate]} {:db/id "answer-bce0fbd8-e3a8-586a-8e62-a96b5ac0ffe6" :answer/id #uuid "bce0fbd8-e3a8-586a-8e62-a96b5ac0ffe6" :answer/type :answer.type/math :answer/value "s=0" :db/ensure [:answer/validate]} {:db/id "answer-5fed37bd-ffc2-55cd-8012-e2fb109c4833" :answer/id #uuid "5fed37bd-ffc2-55cd-8012-e2fb109c4833" :answer/type :answer.type/math :answer/value "s=0,1" :db/ensure [:answer/validate]} {:db/id "answer-e88b13bd-df5f-51b3-a5bb-08db871b5b91" :answer/id #uuid "e88b13bd-df5f-51b3-a5bb-08db871b5b91" :answer/type :answer.type/math :answer/value "s=1" :db/ensure [:answer/validate]} {:db/id 17592186068766 :knowledge-point/questions ["question-eda5f44d-20e8-5e57-ad4a-984bec77ae99" "question-7228245a-4caf-5105-bd90-6c52f7ce3f5f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eda5f44d-20e8-5e57-ad4a-984bec77ae99" :question/id #uuid "eda5f44d-20e8-5e57-ad4a-984bec77ae99" :question/math-academy-id "q-223729" :question/problem "In **ascending order**, the solutions to $5{p}^{2}=3p$ are $p=${{field-1}} and $p=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}5{p}^{2} & =3p \\\\ 5{p}^{2}-3p & =0 \\\\ p(5p-3) & =0\\end{aligned}\n$$\n\nSo, by the zero product rule, we have\n\n$$\np=0\\,\\text{or}\\,5p-3=0,\n$$\n\nwhich in turn gives\n\n$$\np=0\\,\\text{or}\\,p=\\frac{3}{5}.\n$$\n\nTherefore, the solutions are $p=0$ and $p=\\frac{3}{5}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6a4a1367-8323-5342-9d93-3dcdfa929460" "answer-field-66d8e3c9-6afe-5ab2-96bf-1bf5d0f43e5d"] :db/ensure [:question/validate]} {:db/id "answer-field-6a4a1367-8323-5342-9d93-3dcdfa929460" :answer-field/id #uuid "6a4a1367-8323-5342-9d93-3dcdfa929460" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f0f1bd98-1288-5f98-87df-88a402ce918b" :answer-field/choices ["answer-f0f1bd98-1288-5f98-87df-88a402ce918b"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0f1bd98-1288-5f98-87df-88a402ce918b" :answer/id #uuid "f0f1bd98-1288-5f98-87df-88a402ce918b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-66d8e3c9-6afe-5ab2-96bf-1bf5d0f43e5d" :answer-field/id #uuid "66d8e3c9-6afe-5ab2-96bf-1bf5d0f43e5d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-608d4cf7-57b3-5aae-9566-064dbc4e835d" :answer-field/choices ["answer-608d4cf7-57b3-5aae-9566-064dbc4e835d"] :db/ensure [:answer-field/validate]} {:db/id "answer-608d4cf7-57b3-5aae-9566-064dbc4e835d" :answer/id #uuid "608d4cf7-57b3-5aae-9566-064dbc4e835d" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "question-7228245a-4caf-5105-bd90-6c52f7ce3f5f" :question/id #uuid "7228245a-4caf-5105-bd90-6c52f7ce3f5f" :question/math-academy-id "q-223793" :question/problem "In **ascending order**, the solutions to $-7{d}^{2}=-49d$ are $d=${{field-1}} and $d=$\n{{field-2}}." :question/worked-solution "First, we move all of the terms to the left-hand side and then factor:\n\n$$\n\\begin{aligned}-7{d}^{2} & =-49d \\\\ -7{d}^{2}+49d & =0 \\\\ -7d(d-7) & =0\\end{aligned}\n$$\n\nThen, we apply the zero product rule to get\n\n$$\n-7d=0\\,\\text{or}\\,d-7=0,\n$$\n\nwhich in turn gives\n\n$$\nd=0\\,\\text{or}\\,d=7.\n$$\n\nTherefore, the solutions are $d=0$ and $d=7.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0a16048c-c4fb-5782-927d-c81f3f23f337" "answer-field-618b8d76-2d69-54e2-a3fc-f3bca2c2fe87"] :db/ensure [:question/validate]} {:db/id "answer-field-0a16048c-c4fb-5782-927d-c81f3f23f337" :answer-field/id #uuid "0a16048c-c4fb-5782-927d-c81f3f23f337" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5468f005-5491-5c41-9fe4-0409f68e2c19" :answer-field/choices ["answer-5468f005-5491-5c41-9fe4-0409f68e2c19"] :db/ensure [:answer-field/validate]} {:db/id "answer-5468f005-5491-5c41-9fe4-0409f68e2c19" :answer/id #uuid "5468f005-5491-5c41-9fe4-0409f68e2c19" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-618b8d76-2d69-54e2-a3fc-f3bca2c2fe87" :answer-field/id #uuid "618b8d76-2d69-54e2-a3fc-f3bca2c2fe87" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b985d1dc-f347-5ddb-b4a1-89beddfab1e2" :answer-field/choices ["answer-b985d1dc-f347-5ddb-b4a1-89beddfab1e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-b985d1dc-f347-5ddb-b4a1-89beddfab1e2" :answer/id #uuid "b985d1dc-f347-5ddb-b4a1-89beddfab1e2" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "activity-e36e2817-44dd-5f9f-b222-4aa63a5581d2" :activity/id #uuid "e36e2817-44dd-5f9f-b222-4aa63a5581d2" :activity/title "Solving Quadratic Equations with No Constant Term"