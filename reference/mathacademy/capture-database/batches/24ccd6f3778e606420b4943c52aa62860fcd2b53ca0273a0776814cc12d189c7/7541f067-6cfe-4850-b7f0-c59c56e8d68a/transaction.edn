answer-field/validate]} {:db/id "answer-c26020cd-5995-5bd2-a2b4-8eaebe5474f8" :answer/id #uuid "c26020cd-5995-5bd2-a2b4-8eaebe5474f8" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "question-aa0a4c98-4d7d-54fc-bc9e-2776a355d7bb" :question/id #uuid "aa0a4c98-4d7d-54fc-bc9e-2776a355d7bb" :question/math-academy-id "q-181157" :question/problem "$80÷(-20)=${{field-1}}" :question/worked-solution "We have to divide a positive number $(80)$ by a negative one $(-20).$ So the result will be negative:\n\n$$\n80÷(-20)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $80$ by $20$ without any signs: $80÷20=4.$ Therefore, we get\n\n$$\n80÷(-20)=-4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9e0f052d-ac29-50ab-ad2e-f3daa96494b5"] :db/ensure [:question/validate]} {:db/id "answer-field-9e0f052d-ac29-50ab-ad2e-f3daa96494b5" :answer-field/id #uuid "9e0f052d-ac29-50ab-ad2e-f3daa96494b5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cc44ad1b-e88c-5ee0-aca5-f83f22e48da8" :answer-field/choices ["answer-cc44ad1b-e88c-5ee0-aca5-f83f22e48da8"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc44ad1b-e88c-5ee0-aca5-f83f22e48da8" :answer/id #uuid "cc44ad1b-e88c-5ee0-aca5-f83f22e48da8" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "activity-78a3cb78-a6ee-5582-a3c2-9b85792f4b0f" :activity/id #uuid "78a3cb78-a6ee-5582-a3c2-9b85792f4b0f" :activity/title "Dividing With Negative Numbers" :activity/type :activity.type/review :activity/scope 17592186050719 :activity/course 17592186046647 :activity/steps ["step-1dbe9819-43f5-518d-a9b8-11c1b1c0c27e" "step-47ddd019-6afb-5fb1-8a27-b237d9c7ae8d" "step-f1444dc5-2562-5f9b-acd0-c4a2a094ca2e"] :activity/first-step "step-1dbe9819-43f5-518d-a9b8-11c1b1c0c27e" :db/ensure [:activity/validate]} {:db/id "step-1dbe9819-43f5-518d-a9b8-11c1b1c0c27e" :step/id #uuid "1dbe9819-43f5-518d-a9b8-11c1b1c0c27e" :step/content "question-8839a979-8588-586f-ba7f-29f7bd102689" :step/next "step-47ddd019-6afb-5fb1-8a27-b237d9c7ae8d" :db/ensure [:step/validate]} {:db/id "step-47ddd019-6afb-5fb1-8a27-b237d9c7ae8d" :step/id #uuid "47ddd019-6afb-5fb1-8a27-b237d9c7ae8d" :step/content "question-89a1fe1c-2eda-5608-9d61-d01a69e48b0c" :step/next "step-f1444dc5-2562-5f9b-acd0-c4a2a094ca2e" :db/ensure [:step/validate]} {:db/id "step-f1444dc5-2562-5f9b-acd0-c4a2a094ca2e" :step/id #uuid "f1444dc5-2562-5f9b-acd0-c4a2a094ca2e" :step/content "question-aa0a4c98-4d7d-54fc-bc9e-2776a355d7bb" :db/ensure [:step/validate]} {:db/id 17592186096677 :knowledge-point/questions ["question-de213b3e-d398-5228-8036-33cbe3a6bb3b" "question-02fcb6dd-d8d1-548e-be72-9006c65abdf0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-de213b3e-d398-5228-8036-33cbe3a6bb3b" :question/id #uuid "de213b3e-d398-5228-8036-33cbe3a6bb3b" :question/math-academy-id "q-68888" :question/problem "Jordan did an experiment in his Chemistry class. He heated a liquid whose initial temperature was $-{1.2}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${7.3}^{∘}\\,\\text{C}$, at which point he decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{1.2}^{∘}\\,\\text{C}+{7.3}^{∘}\\,\\text{C}={6.1}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${6.1}^{∘}\\,\\text{C}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-36172dc8-5c18-5ef5-9115-2e2f3e7fffef"] :db/ensure [:question/validate]} {:db/id "answer-field-36172dc8-5c18-5ef5-9115-2e2f3e7fffef" :answer-field/id #uuid "36172dc8-5c18-5ef5-9115-2e2f3e7fffef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ffb4664a-819a-5fb1-8000-71d73f25fc83" :answer-field/choices ["answer-bd2b2c82-d14e-5b84-a678-29528d106c3f" "answer-9f446274-2a06-55e0-8045-82df46c8c668" "answer-cecbd7c4-4b6e-5c63-af83-fbf23e812e6a" "answer-ffb4664a-819a-5fb1-8000-71d73f25fc83" "answer-522a5cb8-0595-52ba-9fc4-f068d4c71551"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd2b2c82-d14e-5b84-a678-29528d106c3f" :answer/id #uuid "bd2b2c82-d14e-5b84-a678-29528d106c3f" :answer/type :answer.type/math :answer/value "{5.1}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-9f446274-2a06-55e0-8045-82df46c8c668" :answer/id #uuid "9f446274-2a06-55e0-8045-82df46c8c668" :answer/type :answer.type/math :answer/value "{5.5}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-cecbd7c4-4b6e-5c63-af83-fbf23e812e6a" :answer/id #uuid "cecbd7c4-4b6e-5c63-af83-fbf23e812e6a" :answer/type :answer.type/math :answer/value "{5.7}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-ffb4664a-819a-5fb1-8000-71d73f25fc83" :answer/id #uuid "ffb4664a-819a-5fb1-8000-71d73f25fc83" :answer/type :answer.type/math :answer/value "{6.1}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-522a5cb8-0595-52ba-9fc4-f068d4c71551" :answer/id #uuid "522a5cb8-0595-52ba-9fc4-f068d4c71551" :answer/type :answer.type/math :answer/value "{6.5}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id 17592186096679 :knowledge-point/questions ["question-aab3a1fe-f42d-5861-9d8c-8da472abefec"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aab3a1fe-f42d-5861-9d8c-8da472abefec" :question/id #uuid "aab3a1fe-f42d-5861-9d8c-8da472abefec" :question/math-academy-id "q-68925" :question/problem "In Toronto, Canada, the average temperature in November is ${4.9}^{∘}\\,\\text{C}.$ In December, the average temperature decreases by ${5.4}^{∘}\\,\\text{C}$ compared to November. Finally, in January, the average temperature decreases by ${3.2}^{∘}\\,\\text{C}$ compared to the previous month. Determine the average temperature in Toronto in January." :question/worked-solution "First, we must determine the average temperature in Toronto during the month of December. Since we know that the temperature decreases on average by ${5.4}^{∘}\\,\\text{C}$ compared to November, we subtract the variation in temperature from the average temperature in November. This gives\n\n$$\n{4.9}^{∘}\\,\\text{C}-{5.4}^{∘}\\,\\text{C}=-{0.5}^{∘}\\,\\text{C}.\n$$\n\nNow, we must determine the temperature during the month of January. Since we know that the temperature decreases on average by ${3.2}^{∘}\\,\\text{C}$ compared to December, we subtract the variation in temperature from the average temperature in December. This gives\n\n$$\n-{0.5}^{∘}\\,\\text{C}-{3.2}^{∘}\\,\\text{C}=-{3.7}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the average temperature in Toronto in January is $-{3.7}^{∘}\\,\\text{C}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-89a90e23-11a2-5c55-80c6-c90a2ec355b5"] :db/ensure [:question/validate]} {:db/id "answer-field-89a90e23-11a2-5c55-80c6-c90a2ec355b5" :answer-field/id #uuid "89a90e23-11a2-5c55-80c6-c90a2ec355b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-11599972-180e-564a-8500-e2e61a9c6541" :answer-field/choices ["answer-0233853c-7d57-5992-a3de-9375ae31e3e1" "answer-64fa1bca-1096-5716-a7aa-e09d16681a32" "answer-11599972-180e-564a-8500-e2e61a9c6541" "answer-11d8cfac-231b-5b5e-a776-de1a254087fa" "answer-565ce699-4384-5be5-a535-10eb3fabc2a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-0233853c-7d57-5992-a3de-9375ae31e3e1" :answer/id #uuid "0233853c-7d57-5992-a3de-9375ae31e3e1" :answer/type :answer.type/math :answer/value "-{2.9}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-64fa1bca-1096-5716-a7aa-e09d16681a32" :answer/id #uuid "64fa1bca-1096-5716-a7aa-e09d16681a32" :answer/type :answer.type/math :answer/value "-{3.4}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-11599972-180e-564a-8500-e2e61a9c6541" :answer/id #uuid "11599972-180e-564a-8500-e2e61a9c6541" :answer/type :answer.type/math :answer/value "-{3.7}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-11d8cfac-231b-5b5e-a776-de1a254087fa" :answer/id #uuid "11d8cfac-231b-5b5e-a776-de1a254087fa" :answer/type :answer.type/math :answer/value "-{5.3}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "answer-565ce699-4384-5be5-a535-10eb3fabc2a9" :answer/id #uuid "565ce699-4384-5be5-a535-10eb3fabc2a9" :answer/type :answer.type/math :answer/value "-{5.5}^{∘}\\,\\text{C}" :db/ensure [:answer/validate]} {:db/id "question-02fcb6dd-d8d1-548e-be72-9006c65abdf0" :question/id #uuid "02fcb6dd-d8d1-548e-be72-9006c65abdf0" :question/math-academy-id "q-72691" :question/problem "Chantelle did an experiment in her Chemistry class. She heated a liquid whose initial temperature was $-{5.3}^{∘}\\,\\text{C}.$ After several minutes, the temperature of the liquid increased by ${24.7}^{∘}\\,\\text{C}$, at which point she decided to end the experiment. What was the final temperature of the liquid?" :question/worked-solution "To determine the final temperature of the liquid, we add the variation in temperature to the initial temperature of the liquid. This gives\n\n$$\n-{5.3}^{∘}\\,\\text{C}+{24.7}^{∘}\\,\\text{C}={19.4}^{∘}\\,\\text{C}.\n$$\n\nTherefore, the temperature of the liquid at the end of the experiment was ${19.4}^{∘}\\,\\text{C}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e8439ccf-f19f-54b5-951f-b6eba6db8136"] :db/ensure [:question/validate]} {:db/id "answer-field-e8439ccf-f19f-54b5-951f-b6eba6db8136" :answer-field/id #uuid "e8439ccf-f19f-54b5-951f-b6eba6db8136" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27359f95-680c-5018-a7ac-5a2779c5560b" :answer-field/choices ["answer-74447b91-7282-51