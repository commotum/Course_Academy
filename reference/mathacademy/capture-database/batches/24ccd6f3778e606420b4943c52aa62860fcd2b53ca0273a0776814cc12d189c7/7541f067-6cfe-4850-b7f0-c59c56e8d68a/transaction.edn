er-bc060e7c-ade5-5987-bfcc-22a3b89b7c7c" "answer-91ab3da8-8b65-5c7c-b413-f64ac221623d" "answer-a0dd0ba3-3b82-5d28-920c-a872d1b66617"] :db/ensure [:answer-field/validate]} {:db/id "answer-a66e5a36-33aa-57dd-9127-3bf14e2a3526" :answer/id #uuid "a66e5a36-33aa-57dd-9127-3bf14e2a3526" :answer/type :answer.type/text :answer/value "adding $Φ$ to" :db/ensure [:answer/validate]} {:db/id "answer-bc060e7c-ade5-5987-bfcc-22a3b89b7c7c" :answer/id #uuid "bc060e7c-ade5-5987-bfcc-22a3b89b7c7c" :answer/type :answer.type/text :answer/value "differentiating" :db/ensure [:answer/validate]} {:db/id "answer-91ab3da8-8b65-5c7c-b413-f64ac221623d" :answer/id #uuid "91ab3da8-8b65-5c7c-b413-f64ac221623d" :answer/type :answer.type/text :answer/value "integrating" :db/ensure [:answer/validate]} {:db/id "answer-a0dd0ba3-3b82-5d28-920c-a872d1b66617" :answer/id #uuid "a0dd0ba3-3b82-5d28-920c-a872d1b66617" :answer/type :answer.type/text :answer/value "pre-multiplying by ${Φ}^{-1}$" :db/ensure [:answer/validate]} {:db/id "activity-ad2891ee-0030-5652-a668-6f7d9a8b1217" :activity/id #uuid "ad2891ee-0030-5652-a668-6f7d9a8b1217" :activity/title "Solving Systems of ODEs Using Variation of Parameters" :activity/type :activity.type/review :activity/scope 17592186050355 :activity/course 17592186046645 :activity/steps ["step-cef5da74-9e1b-5ac0-acde-a39773d01fea" "step-2cb68189-e6bd-50df-bf7a-85be4d333c8d" "step-25f637fb-d499-5964-98b0-d92aa3739826" "step-3431c228-5dc1-5a6b-90ef-eb4019f30372" "step-c5d20bf1-c67d-533b-b7e7-2dfd3e6fc008"] :activity/first-step "step-cef5da74-9e1b-5ac0-acde-a39773d01fea" :db/ensure [:activity/validate]} {:db/id "step-cef5da74-9e1b-5ac0-acde-a39773d01fea" :step/id #uuid "cef5da74-9e1b-5ac0-acde-a39773d01fea" :step/content "question-29e3e5d7-28ea-5e8a-b874-caa92a5ebba1" :step/next "step-2cb68189-e6bd-50df-bf7a-85be4d333c8d" :db/ensure [:step/validate]} {:db/id "step-2cb68189-e6bd-50df-bf7a-85be4d333c8d" :step/id #uuid "2cb68189-e6bd-50df-bf7a-85be4d333c8d" :step/content "question-59d9272b-7eb2-549a-868b-86d14c7fdef5" :step/next "step-25f637fb-d499-5964-98b0-d92aa3739826" :db/ensure [:step/validate]} {:db/id "step-25f637fb-d499-5964-98b0-d92aa3739826" :step/id #uuid "25f637fb-d499-5964-98b0-d92aa3739826" :step/content 17592186365800 :step/next "step-3431c228-5dc1-5a6b-90ef-eb4019f30372" :db/ensure [:step/validate]} {:db/id "step-3431c228-5dc1-5a6b-90ef-eb4019f30372" :step/id #uuid "3431c228-5dc1-5a6b-90ef-eb4019f30372" :step/content 17592186311821 :step/next "step-c5d20bf1-c67d-533b-b7e7-2dfd3e6fc008" :db/ensure [:step/validate]} {:db/id "step-c5d20bf1-c67d-533b-b7e7-2dfd3e6fc008" :step/id #uuid "c5d20bf1-c67d-533b-b7e7-2dfd3e6fc008" :step/content 17592186365808 :db/ensure [:step/validate]} {:db/id 17592186068755 :knowledge-point/questions ["question-98c5a09c-66f3-5ba5-a68c-81bc86cd79e6" "question-6455b841-9f87-516b-8fea-0d225062fdb2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068593 :question/problem "Simplify $\\dfrac 2 x \\cdot \\dfrac 3 {y^2} .$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\eqalign{\n\t\t\\dfrac 2 x \\cdot \\dfrac 3 {y^2} \n\t\t&=\\dfrac {2 \\cdot 3} {x \\cdot y^2}\n\t\t&=\\dfrac {6} {xy^2}\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068756 :knowledge-point/questions ["question-f3ac8b1a-7d85-55e8-a403-9ecc671851c3" "question-c11871ea-d169-5487-96ff-63c7ffae0586"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068594 :question/problem "Given that $\\dfrac {6a} {b^2} = x$ and $\\dfrac {3b} {2a}= y,$ what is $x\\cdot y?$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}x\\cdot y & =\\frac{6a}{{b}^{2}}\\cdot \\frac{3b}{2a} \\\\  & =\\frac{6a\\cdot 3b}{{b}^{2}\\cdot 2a} \\\\  & =\\frac{18ab}{2a{b}^{2}} \\\\  & =\\frac{9}{b}.\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying." :db/ensure [:question/validate]} {:db/id 17592186068757 :knowledge-point/questions ["question-2867a50e-2edc-52ac-9829-fb91f9cd04d7" "question-375b774b-1afa-5119-93c1-a64d09ffe7d5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068595 :question/problem "Simplify $\\dfrac {(n + 1)(n + 3)} {4n^2} \\cdot \\dfrac {8n}{(n + 3)(n - 2)}.$" :question/worked-solution "First, we cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{(n+1)(n+3)}{4{n}^{2}}\\cdot \\frac{8n}{(n+3)(n-2)} & =\\frac{(n+1)\\cancel{(n+3)}}{\\cancel{4n}\\cdot n}\\cdot \\frac{2\\cdot \\cancel{4n}}{\\cancel{(n+3)}(n-2)} \\\\  & =\\frac{n+1}{n}\\cdot \\frac{2}{n-2} \\\\  & =\\frac{2n+2}{{n}^{2}-2n}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068758 :knowledge-point/questions ["question-77bb223c-233d-57ea-b08b-423b072f4e97" "question-e1404dec-45bb-593f-8444-817e3a0c6414"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068596 :question/problem "Simplify $\\dfrac {3p - 12}{p^2 - 9} \\cdot \\dfrac {p + 3} {p - 4}.$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\eqalign{\n\t\t\\dfrac {3p - 12}{p^2 - 9} \\cdot \\dfrac {p + 3} {p - 4} \n\t\t&=\\dfrac {3(p - 4)} {(p + 3)(p - 3)} \\cdot \\dfrac {p + 3} {p - 4} \\[5pt]\n\t\t&=\\dfrac {3\\cancel{(p - 4)}} {\\cancel{(p + 3)}(p - 3)} \\cdot \\dfrac {\\cancel{p + 3}} {\\cancel{p - 4}} \\[5pt]\n\t\t&=\\dfrac {3}{p - 3}\n\n\t}\n$$" :db/ensure [:question/validate]} {:db/id "question-98c5a09c-66f3-5ba5-a68c-81bc86cd79e6" :question/id #uuid "98c5a09c-66f3-5ba5-a68c-81bc86cd79e6" :question/math-academy-id "q-70318" :question/problem "$\\frac{7}{a-5}\\cdot \\frac{b{c}^{3}}{3}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\frac{7}{a-5}\\cdot \\frac{b{c}^{3}}{3}=\\frac{7\\cdot b{c}^{3}}{(a-5)\\cdot 3}=\\frac{7b{c}^{3}}{3(a-5)}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eeb194b9-a54d-58d0-8b4c-728fcaac5750"] :db/ensure [:question/validate]} {:db/id "answer-field-eeb194b9-a54d-58d0-8b4c-728fcaac5750" :answer-field/id #uuid "eeb194b9-a54d-58d0-8b4c-728fcaac5750" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6dd481cc-758f-59ca-bdea-2301d0162683" :answer-field/choices ["answer-a1d085c9-ae71-5898-a42e-adb06da0a886" "answer-9edca370-d986-55df-923e-d5c4725ac77d" "answer-7ca274d0-b348-544f-8ce6-4453819e2116" "answer-6dd481cc-758f-59ca-bdea-2301d0162683" "answer-6a350eb6-e83b-5a99-b963-705099d2df61"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1d085c9-ae71-5898-a42e-adb06da0a886" :answer/id #uuid "a1d085c9-ae71-5898-a42e-adb06da0a886" :answer/type :answer.type/math :answer/value "\\frac{21}{b{c}^{3}(a-5)}" :db/ensure [:answer/validate]} {:db/id "answer-9edca370-d986-55df-923e-d5c4725ac77d" :answer/id #uuid "9edca370-d986-55df-923e-d5c4725ac77d" :answer/type :answer.type/math :answer/value "\\frac{7(a-5)}{3b{c}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-7ca274d0-b348-544f-8ce6-4453819e2116" :answer/id #uuid "7ca274d0-b348-544f-8ce6-4453819e2116" :answer/type :answer.type/math :answer/value "\\frac{7b{c}^{3}(a-5)}{3}" :db/ensure [:answer/validate]} {:db/id "answer-6dd481cc-758f-59ca-bdea-2301d0162683" :answer/id #uuid "6dd481cc-758f-59ca-bdea-2301d0162683" :answer/type :answer.type/math :answer/value "\\frac{7b{c}^{3}}{3(a-5)}" :db/ensure [:answer/validate]} {:db/id "answer-6a350eb6-e83b-5a99-b963-705099d2df61" :answer/id #uuid "6a350eb6-e83b-5a99-b963-705099d2df61" :answer/type :answer.type/math :answer/value "\\frac{b{c}^{3}(a-5)}{21}" :db/ensure [:answer/validate]} {:db/id "question-6455b841-9f87-516b-8fea-0d225062fdb2" :question/id #uuid "6455b841-9f87-516b-8fea-0d225062fdb2" :question/math-academy-id "q-113355" :question/problem "$\\frac{{w}^{3}}{2}\\cdot \\frac{5}{3z}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\frac{{w}^{3}}{2}\\cdot \\frac{5}{3z}=\\frac{{w}^{3}\\cdot 5}{2\\cdot 3z}=\\frac{5{w}^{3}}{6z}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-67f3f964-1b7f-53db-9cb0-2e1db93fceff"] :db/ensure [:question/validate]} {:db/id "answer-field-67f3f964-1b7f-53db-9cb0-2e1db93fceff" :answer-field/id #uuid "67f3f964-1b7f-53db-9cb0-2e1db93fceff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-651525e9-05ac-534a-9b83-9a2ce1154529" :answer-field/choices ["answer-7e77e7a6-9827-5e34-b7cb-73b6f216446a" "answer-651525e9-05ac-534a-9b83-9a2ce1154529" "answer-56e67d10-eedb-5942-9ff3-264c25cf8c03" "answer-51953942-3d47-57c4-84c0-afc890691776" "answer-c0b05000-0f87-5eec-8f77-3ac5b01af44a"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e77e7a6-9827-5e34-b7cb-73b6f216446a" :answer/id #uuid "7e77e7a6-9827-5e34-b7cb-73b6f216446a" :answer/type :answer.type/math :answer/value "\\frac{5{w}^{3}z}{6}" :db/ensure [:answer/validate]} {:db/id "answer-651525e9-05ac-534a-9b83-9a2ce1154529" :answer/id #uuid "651525e9-05ac-534a-9b83-9a2ce1154529" :answer/type :answer.type/math :answer/value "\\frac{5{w}^{3}}{6z}" :db/ensure [:answer/validate]} {:db/id "answer-56e67d10-eedb-5942-9ff3-264c25cf8c03" :answer/id #uuid "56e67d10-eedb-5942-9ff3-264c25cf8c03" :answer/type :answer.type/math :answer/value "\\frac{5}{6{w}^{3}z}" :db/ensure [:answer/validate]} {:db/id "answer-51953942-3d47-57c4-84c0-afc890691776" :answer/id #uuid "51953942-3d47-57c4-84c0-afc890691776" :answer/type :answer.type/math :answer/value "\\frac{6{w}^{3}}{5z}" :db/ensure [:answer/validate]} {:db/id "answer-c0b05000-0f87-5eec-8f77-3ac5b01af44a" :answer/id #uuid "c0b05000-0f87-5eec-8f77-3ac5b01af44a" :answer/type :answer.type/math :answer/value "\\frac{{w}^{3}}{z}" :db/ensure [:answer/validate]} {:db/id "question-f3ac8b1a-7d85-55e8-a403-9ecc671851c3" :question/id #uuid "f3ac8b1a-7d85-55e8-a403-9ecc671851c3" :question/math-academy-id "q-70319" :question/problem "$\\frac{{x}^{2}}{2y}\\cdot \\frac{6{y}^{2}}{{x}^{2}}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2y}\\cdot \\frac{6{y}^{2}}{{x}^{2}} & =\\frac{{x}^{2}\\cdot 6{y}^{2}}{2y\\cdot {x}^{2}} \\\\  & =\\frac{6{x}^{2}{y}^{2}}{2{x}^{2}y} \\\\  & =3y\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1f904be5-775e-56d5-aae6-eb8af51836e6"] :db/ensure [:question/validate]} {:db/id "answer-field-1f904be5-775e-56d5-aae6-eb8af51836e6" :answer-field/id #uuid "1f904be5-775e-56d5-aae6-eb8af51836e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5b01537a-238a-50a4-a32f-018853dacd6a" :answer-field/choices ["answer-46ea2257-9905-5a18-8e6b-4dbd806bcae7" "answer-5b01537a-238a-50a4-a32f-018853dacd6a" "answer-0a52a41f-7227-580c-b754-7137ec9d1f09" "answer-46014d02-a9d0-58f2-9e55-ffdc3821139d" "answer-5e455b43-3370-566d-a1e5-b7f9cd18e0d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-46ea2257-9905-5a18-8e6b-4dbd806bcae7" :answer/id #uuid "46ea2257-9905-5a18-8e6b-4dbd806bcae7" :answer/type :answer.type/math :answer/value "3x" :db/ensure [:answer/validate]} {:db/id "answer-5b01537a-238a-50a4-a32f-018853dacd6a" :answer/id #uuid "5b01537a-238a-50a4-a32f-018853dacd6a" :answer/type :answer.type/math :answer/value "3y" :db/ensure [:answer/validate]} {:db/id "answer-0a52a41f-7227-580c-b754-7137ec9d1f09" :answer/id #uuid "0a52a41f-7227-580c-b754-7137ec9d1f09" :answer/type :answer.type/math :answer/value "\\frac{3x}{y}" :db/ensure [:answer/validate]} {:db/id "answer-46014d02-a9d0-58f2-9e55-ffdc3821139d" :answer/id #uuid "46014d02-a9d0-58f2-9e55-ffdc3821139d" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}}{y}" :db/ensure [:answer/validate]} {:db/id "answer-5e455b43-3370-566d-a1e5-b7f9cd18e0d5" :answer/id #uuid "5e455b43-3370-566d-a1e5-b7f9cd18e0d5" :answer/type :answer.type/math :answer/value "\\frac{3{y}^{2}}{x}" :db/ensure [:answer/validate]} {:db/id "question-c11871ea-d169-5487-96ff-63c7ffae0586" :question/id #uuid "c11871ea-d169-5487-96ff-63c7ffae0586" :question/math-academy-id "q-70320" :question/problem "$\\frac{4{s}^{2}}{t}\\cdot \\frac{{t}^{2}}{2}=$" :question/worked-solution "We multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{4{s}^{2}}{t}\\cdot \\frac{{t}^{2}}{2} & =\\frac{4{s}^{2}\\cdot {t}^{2}}{t\\cdot 2} \\\\  & =\\frac{4{s}^{2}{t}^{2}}{2t} \\\\  & =2{s}^{2}t\\end{aligned}\n$$\n\n**Note:** In the above example, we performed some cancellations after multiplying. However, with more complex expressions, it's often easier to cancel *before* multiplying." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ab002fa-1296-5bf0-b94c-53d23d1a7c1a"] :db/ensure [:question/validate]} {:db/id "answer-field-9ab002fa-1296-5bf0-b94c-53d23d1a7c1a" :answer-field/id #uuid "9ab002fa-1296-5bf0-b94c-53d23d1a7c1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29e29e5e-9116-598c-80bb-1c8e6648ca82" :answer-field/choices ["answer-29e29e5e-9116-598c-80bb-1c8e6648ca82" "answer-4395f6aa-bc44-53fc-aa3e-2cd85e399160" "answer-2c716f25-fd40-5238-8508-1984409c4959" "answer-09bd9650-94ca-5181-9ee0-893b163ebb81" "answer-33445949-61c0-5af2-9d05-116bb19b21b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-29e29e5e-9116-598c-80bb-1c8e6648ca82" :answer/id #uuid "29e29e5e-9116-598c-80bb-1c8e6648ca82" :answer/type :answer.type/math :answer/value "2{s}^{2}t" :db/ensure [:answer/validate]} {:db/id "answer-4395f6aa-bc44-53fc-aa3e-2cd85e399160" :answer/id #uuid "4395f6aa-bc44-53fc-aa3e-2cd85e399160" :answer/type :answer.type/math :answer/value "\\frac{2{s}^{3}}{{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-2c716f25-fd40-5238-8508-1984409c4959" :answer/id #uuid "2c716f25-fd40-5238-8508-1984409c4959" :answer/type :answer.type/math :answer/value "\\frac{2}{st}" :db/ensure [:answer/validate]} {:db/id "answer-09bd9650-94ca-5181-9ee0-893b163ebb81" :answer/id #uuid "09bd9650-94ca-5181-9ee0-893b163ebb81" :answer/type :answer.type/math :answer/value "\\frac{st}{2}" :db/ensure [:answer/validate]} {:db/id "answer-33445949-61c0-5af2-9d05-116bb19b21b1" :answer/id #uuid "33445949-61c0-5af2-9d05-116bb19b21b1" :answer/type :answer.type/math :answer/value "\\frac{{s}^{3}}{2{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "question-2867a50e-2edc-52ac-9829-fb91f9cd04d7" :question/id #uuid "2867a50e-2edc-52ac-9829-fb91f9cd04d7" :question/math-academy-id "q-3517" :question/problem "$\\frac{11p{q}^{2}}{{r}^{3}}\\cdot \\frac{5{r}^{2}}{121{p}^{4}q}=$" :question/worked-solution "First, we cancel any terms that appear in both a numerator of one fraction and a denominator of the other one. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{11p{q}^{2}}{{r}^{3}}\\cdot \\frac{5{r}^{2}}{121{p}^{4}q} & =\\frac{11pq\\cdot q}{r\\cdot {r}^{2}}\\cdot \\frac{5\\cdot {r}^{2}}{11pq\\cdot 11{p}^{3}} \\\\  & =\\frac{\\cancel{11pq}\\cdot q}{r\\cdot \\cancel{{r}^{2}}}\\cdot \\frac{5\\cdot \\cancel{{r}^{2}}}{\\cancel{11pq}\\cdot 11{p}^{3}} \\\\  & =\\frac{q}{r}\\cdot \\frac{5}{11{p}^{3}} \\\\  & =\\frac{5q}{11{p}^{3}r}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3513e198-c7c0-5e29-849a-4ed2ffa42413"] :db/ensure [:question/validate]} {:db/id "answer-field-3513e198-c7c0-5e29-849a-4ed2ffa42413" :answer-field/id #uuid "3513e198-c7c0-5e29-849a-4ed2ffa42413" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-35f47d4f-cb38-52db-a4b5-d7d8e34b95be" :answer-field/choices ["answer-bd92409f-07bc-59f3-a706-ba815db31cee" "answer-118add16-3226-55a3-a5bc-8972164c57a3" "answer-35f47d4f-cb38-52db-a4b5-d7d8e34b95be" "answer-d6030517-ea9c-52e5-bf13-7b136eb8ce0b" "answer-34f1ffcd-f1a6-5efb-8f17-d4c2da7795b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd92409f-07bc-59f3-a706-ba815db31cee" :answer/id #uuid "bd92409f-07bc-59f3-a706-ba815db31cee" :answer/type :answer.type/math :answer/value "\\frac{55q}{121{p}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-118add16-3226-55a3-a5bc-8972164c57a3" :answer/id #uuid "118add16-3226-55a3-a5bc-8972164c57a3" :answer/type :answer.type/math :answer/value "\\frac{5q}{11{p}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-35f47d4f-cb38-52db-a4b5-d7d8e34b95be" :answer/id #uuid "35f47d4f-cb38-52db-a4b5-d7d8e34b95be" :answer/type :answer.type/math :answer/value "\\frac{5q}{11{p}^{3}r}" :db/ensure [:answer/validate]} {:db/id "answer-d6030517-ea9c-52e5-bf13-7b136eb8ce0b" :answer/id #uuid "d6030517-ea9c-52e5-bf13-7b136eb8ce0b" :answer/type :answer.type/math :answer/value "\\frac{5q}{11{r}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-34f1ffcd-f1a6-5efb-8f17-d4c2da7795b9" :answer/id #uuid "34f1ffcd-f1a6-5efb-8f17-d4c2da7795b9" :answer/type :answer.type/math :answer/value "\\frac{q}{121pr}" :db/ensure [:answer/validate]} {:db/id "question-375b774b-1afa-5119-93c1-a64d09ffe7d5" :question/id #uuid "375b774b-1afa-5119-93c1-a64d09ffe7d5" :question/math-academy-id "q-14411" :question/problem "Which of the following is equivalent to $\\frac{5{y}^{2}}{4{z}^{2}}\\cdot \\frac{8xz}{y}?$" :question/worked-solution "First, we cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{5{y}^{2}}{4{z}^{2}}\\cdot \\frac{8xz}{y} & =\\frac{5y\\cdot y}{4z\\cdot z}\\cdot \\frac{4z\\cdot 2x}{y} \\\\  & =\\frac{5y\\cdot \\cancel{y}}{\\cancel{4z}\\cdot z}\\cdot \\frac{\\cancel{4z}\\cdot 2x}{\\cancel{y}} \\\\  & =\\frac{5y}{z}\\cdot \\frac{2x}{1} \\\\  & =\\frac{10xy}{z}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-85c27fcd-3331-5240-8e4b-a92ab75ac3c0"] :db/ensure [:question/validate]} {:db/id "answer-field-85c27fcd-3331-5240-8e4b-a92ab75ac3c0" :answer-field/id #uuid "85c27fcd-3331-5240-8e4b-a92ab75ac3c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f19b24ba-53c6-5d80-aeb7-7ad70ffd21af" :answer-field/choices ["answer-f19b24ba-53c6-5d80-aeb7-7ad70ffd21af" "answer-709816ae-3d7b-5836-98c7-115f160436d7" "answer-2135b485-86da-56e1-99e5-5980e0fdf574" "answer-589dfa25-339d-59c6-9961-222f07bcde3e" "answer-c9990a1d-b112-561c-8ea2-8f77e51a3977"] :db/ensure [:answer-field/validate]} {:db/id "answer-f19b24ba-53c6-5d80-aeb7-7ad70ffd21af" :answer/id #uuid "f19b24ba-53c6-5d80-aeb7-7ad70ffd21af" :answer/type :answer.type/math :answer/value "\\frac{10xy}{z}" :db/ensure [:answer/validate]} {:db/id "answer-709816ae-3d7b-5836-98c7-115f160436d7" :answer/id #uuid "709816ae-3d7b-5836-98c7-115f160436d7" :answer/type :answer.type/math :answer/value "\\frac{10y}{{z}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-2135b485-86da-56e1-99e5-5980e0fdf574" :answer/id #uuid "2135b485-86da-56e1-99e5-5980e0fdf574" :answer/type :answer.type/math :answer/value "\\frac{2x}{{z}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-589dfa25-339d-59c6-9961-222f07bcde3e" :answer/id #uuid "589dfa25-339d-59c6-9961-222f07bcde3e" :answer/type :answer.type/math :answer/value "\\frac{5xz}{y}" :db/ensure [:answer/validate]} {:db/id "answer-c9990a1d-b112-561c-8ea2-8f77e51a3977" :answer/id #uuid "c9990a1d-b112-561c-8ea2-8f77e51a3977" :answer/type :answer.type/math :answer/value "\\frac{5x{y}^{2}}{z}" :db/ensure [:answer/validate]} {:db/id "question-77bb223c-233d-57ea-b08b-423b072f4e97" :question/id #uuid "77bb223c-233d-57ea-b08b-423b072f4e97" :question/math-academy-id "q-14412" :question/problem "Given that $\\frac{mn-4n}{2m}=a$ and $\\frac{2}{m-4}=b$, what is $a\\cdot b?$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =\\frac{mn-4n}{2m}\\cdot \\frac{2}{m-4} \\\\  & =\\frac{n(m-4)}{2\\cdot m}\\cdot \\frac{2}{m-4} \\\\  & =\\frac{n\\cancel{(m-4)}}{\\cancel{2}\\cdot m}\\cdot \\frac{\\cancel{2}}{\\cancel{m-4}} \\\\  & =\\frac{n}{m}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6b52c0d2-22e4-591e-be62-bf893c2cb281"] :db/ensure [:question/validate]} {:db/id "answer-field-6b52c0d2-22e4-591e-be62-bf893c2cb281" :answer-field/id #uuid "6b52c0d2-22e4-591e-be62-bf893c2cb281" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2586580c-5e06-53d6-b4ba-93241858e150" :answer-field/choices ["answer-f3d23487-0517-59a2-ad90-00b344f62e58" "answer-34b08626-2d00-5b7e-9efa-74a3354cae2c" "answer-2586580c-5e06-53d6-b4ba-93241858e150" "answer-3fb38320-3554-5dad-b771-ca9d7405cb42" "answer-733172b4-d725-5010-882c-86b19527c3c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f3d23487-0517-59a2-ad90-00b344f62e58" :answer/id #uuid "f3d23487-0517-59a2-ad90-00b344f62e58" :answer/type :answer.type/math :answer/value "\\frac{2n}{{m}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-34b08626-2d00-5b7e-9efa-74a3354cae2c" :answer/id #uuid "34b08626-2d00-5b7e-9efa-74a3354cae2c" :answer/type :answer.type/math :answer/value "\\frac{2}{m}" :db/ensure [:answer/validate]} {:db/id "answer-2586580c-5e06-53d6-b4ba-93241858e150" :answer/id #uuid "2586580c-5e06-53d6-b4ba-93241858e150" :answer/type :answer.type/math :answer/value "\\frac{n}{m}" :db/ensure [:answer/validate]} {:db/id "answer-3fb38320-3554-5dad-b771-ca9d7405cb42" :answer/id #uuid "3fb38320-3554-5dad-b771-ca9d7405cb42" :answer/type :answer.type/math :answer/value "\\frac{n}{{m}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-733172b4-d725-5010-882c-86b19527c3c9" :answer/id #uuid "733172b4-d725-5010-882c-86b19527c3c9" :answer/type :answer.type/math :answer/value "n" :db/ensure [:answer/validate]} {:db/id "question-e1404dec-45bb-593f-8444-817e3a0c6414" :question/id #uuid "e1404dec-45bb-593f-8444-817e3a0c6414" :question/math-academy-id "q-14403" :question/problem "Which of the following is equivalent to $\\frac{{x}^{2}-16}{{x}^{2}-5x+6}\\cdot \\frac{x-3}{x-4}?$" :question/worked-solution "First, we factor all of the expressions and cancel any terms that appear in both a numerator and a denominator. Then, we multiply the numerators and the denominators as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-16}{{x}^{2}-5x+6}\\cdot \\frac{x-3}{x-4} & =\\frac{(x+4)(x-4)}{(x-2)(x-3)}\\cdot \\frac{x-3}{x-4} \\\\  & =\\frac{(x+4)\\cancel{(x-4)}}{(x-2)\\cancel{(x-3)}}\\cdot \\frac{\\cancel{(x-3)}}{\\cancel{x-4}} \\\\  & =\\frac{x+4}{x-2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-41c2ce33-393f-50a3-9843-3fcc93fedacc"] :db/ensure [:question/validate]} {:db/id "answer-field-41c2ce33-393f-50a3-9843-3fcc93fedacc" :answer-field/id #uuid "41c2ce33-393f-50a3-9843-3fcc93fedacc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-666a6341-9514-55c9-8b88-d14cc270aa4e" :answer-field/choices ["answer-07ac96b0-64cb-518d-8210-e3d3fdcb5473" "answer-a89e0287-44ad-514b-acc6-1fa5b569129b" "answer-666a6341-9514-55c9-8b88-d14cc270aa4e" "answer-661fe2c0-29f3-5094-a30d-b7df43b97a39" "answer-a810caef-0770-5295-bd89-ff677b2b0d1c"] :db/ensure [:answer-field/validate]} {:db/id "answer-07ac96b0-64cb-518d-8210-e3d3fdcb5473" :answer/id #uuid "07ac96b0-64cb-518d-8210-e3d3fdcb5473" :answer/type :answer.type/math :answer/value "\\frac{2x+1}{x-2}" :db/ensure [:answer/validate]} {:db/id "answer-a89e0287-44ad-514b-acc6-1fa5b569129b" :answer/id #uuid "a89e0287-44ad-514b-acc6-1fa5b569129b" :answer/type :answer.type/math :answer/value "\\frac{x+4}{2x-1}" :db/ensure [:answer/validate]} {:db/id "answer-666a6341-9514-55c9-8b88-d14cc270aa4e" :answer/id #uuid "666a6341-9514-55c9-8b88-d14cc270aa4e" :answer/type :answer.type/math :answer/value "\\frac{x+4}{x-2}" :db/ensure [:answer/validate]} {:db/id "answer-661fe2c0-29f3-5094-a30d-b7df43b97a39" :answer/id #uuid "661fe2c0-29f3-5094-a30d-b7df43b97a39" :answer/type :answer.type/math :answer/value "\\frac{x-4}{x-3}" :db/ensure [:answer/validate]} {:db/id "answer-a810caef-0770-5295-bd89-ff677b2b0d1c" :answer/id #uuid "a810caef-0770-5295-bd89-ff677b2b0d1c" :answer/type :answer.type/math :answer/value "\\frac{x-8}{x-2}" :db/ensure [:answer/validate]} {:db/id 17592186069972 :tutorial/content "Multiplying rational expressions is just like multiplying fractions. After all, fractions are just rational expressions with constants!\n\nFor example, to multiply the rational expressions $\\dfrac{3}{x}$ and $\\dfrac{y}{2},$ we multiply the numerators and the denominators as follows:\n\n$$\n\\dfrac{3}{x} \\cdot \\dfrac{y}{2} = \\dfrac{3 \\cdot y}{x \\cdot 2} = \\dfrac{3y}{2x}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186068966 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186208560 :knowledge-point/questions ["question-fb48c25d-7d3e-5c68-83ac-d6034fcc4a05" "question-6d436b5a-22ca-50fe-bbca-e3c952622b7f" "question-d3d68253-5058-5406-8e0e-23e4aaba826a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186208276 :question/problem "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $u,$ $v,$ and $w$ with probabilities $0.2,$ $0.5,$ and $0.3,$ respectively. You are given the following conditional expectations:\n\n$$\n\\textrm{E}[X \\mid Y=u] = 6, \\quad \\textrm{E}[X \\mid Y=v] = 9, \\quad \\textrm{E}[X \\mid Y=w] = 3.\n$$\n\nWhat is $\\textrm{E}[X]?$" :question/worked-solution "We are given the conditional expectations of $X$ given different values of another random variable $Y,$ along with the probabilities of those values. This is a direct application of the law of total expectation, which states:\n\n$$\n\\textrm{E}[X] = \\sum_y \\textrm{E}[X \\mid Y = y] \\cdot P(Y = y).\n$$\n\nIn this problem, $Y$ takes three values:\n\n- $Y = u$ with probability $0.2,$ and $\\textrm{E}[X \\mid Y = u] = 6$\n\n- $Y = v$ with probability $0.5,$ and $\\textrm{E}[X \\mid Y = v] = 9$\n\n- $Y = w$ with probability $0.3,$ and $\\textrm{E}[X \\mid Y = w] = 3$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=u]\\cdot P(Y=u)+\\text{E}[X∣Y=v]\\cdot P(Y=v) \\\\  & \\,+\\text{E}[X∣Y=w]\\cdot P(Y=w) \\\\  & =6\\cdot 0.2+9\\cdot 0.5+3\\cdot 0.3 \\\\  & =1.2+4.5+0.9 \\\\  & =6.6\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186208561 :knowledge-point/questions ["question-87aec959-895e-5be8-8c69-b3c4045c5829" "question-e734511f-0834-5433-966a-4ae3851cf360" "question-cdbfe9c8-c3f2-5a6b-9ce7-99052b0abd68" "question-e0fafa34-8718-5c91-847f-90668c3f437e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186208277 :question/problem "A wildlife researcher is sent to either Forest $1$ or Forest $2$ to record animal sightings. With probability $0.7,$ he is sent to Forest $1,$ where the expected number of sightings in a day is $6.2.$ With probability $0.3,$ he is sent to Forest $2,$ where the expected number is $3.8.$\n\nWhat is the expected number of animal sightings in a day?" :question/worked-solution "We are asked to compute the expected number of animal sightings the researcher records daily. This is a classic application of the law of total expectation, which allows us to calculate an overall expected value by conditioning on a related variable — in this case, the forest where the researcher is stationed.\n\nLet $X$ be the number of animal sightings in a day, and let $Y$ be the forest to which the researcher is assigned.\n\n- $Y = 1$ with probability $0.7,$ and $\\textrm{E}[X \\mid Y = 1] = 6.2.$\n\n- $Y = 2$ with probability $0.3,$ and $\\textrm{E}[X \\mid Y = 2] = 3.8.$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=1]\\cdot P(Y=1)+\\text{E}[X∣Y=2]\\cdot P(Y=2) \\\\  & =6.2\\cdot 0.7+3.8\\cdot 0.3 \\\\  & =4.34+1.14 \\\\  & =5.48\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186208562 :knowledge-point/questions ["question-9a2b9353-2f5e-55ce-b33e-819639da3c0b" "question-eff3dc19-9675-582f-bb2d-ae75355788e9" "question-fde0d020-b26d-5edb-a043-de5b1f35d4a2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186208278 :question/problem "Let $Y$ be a discrete random variable, and suppose $\\textrm{E}[X \\mid Y] = 3Y + 2.$ If $\\textrm{E}[X] = 20,$ what is $\\textrm{E}[Y]?$" :question/worked-solution "We are given an expression for $\\textrm{E}[X \\mid Y]$ in terms of $Y,$ and the value of $\\textrm{E}[X].$ This is a direct application of the tower property, which states that\n\n$$\n\\textrm{E}[X] = \\textrm{E}[\\textrm{E}[X \\mid Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation, which gives\n\n$$\n\\textrm{E}[X] = \\textrm{E}[3Y + 2].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[3Y+2] \\\\  & =3\\cdot \\text{E}[Y]+2\\end{aligned}\n$$\n\nWe are told that $\\textrm{E}[X] = 20,$ so we solve this equation as follows:\n\n$$\n\\begin{aligned}20 & =3\\cdot \\text{E}[Y]+2 \\\\ 18 & =3\\cdot \\text{E}[Y] \\\\ \\text{E}[Y] & =6\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186208563 :knowledge-point/questions ["question-d15a80b9-3b38-5de0-953c-45a827aaaf2b" "question-12dc9838-1006-5e99-98b8-8a2304014d14" "question-5923cf06-a8dd-57e8-81ff-5f4a640b9a2b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186208279 :question/problem "In a fantasy card game, a random mana level $m$ is drawn uniformly from $1$ to $201.$ A player selects a random spell costing an integer amount of mana between $1$ and $m,$ chosen uniformly at random. What is the expected cost of the spell selected?" :question/worked-solution "This is a two-step random process: first, a mana level $m$ is chosen uniformly from $1$ to $201,$ and then a spell is chosen uniformly from $1$ to $m.$ We are asked to find the expected value of the mana cost selected in the second step.\n\n- Let $Y$ be the first random number, the mana level drawn uniformly from $1$ to $201.$\n\n- Let $X$ be the cost of the spell selected, uniformly from $1$ to $Y.$\n\nWe are asked to compute $\\textrm{E}[X].$ Since the distribution of $X$ depends on $Y,$ we apply the tower property:\n\n$$\n\\textrm{E}[X] = \\textrm{E}[\\textrm{E}[X \\mid Y]]\n$$\n\nGiven $Y = m,$ the value of $X$ is uniformly distributed on $\\{1, 2, \\dots, m\\},$ so\n\n$$\n\\textrm{E}[X \\mid Y = m] = \\frac{m + 1}{2}.\n$$\n\nTherefore,\n\n$$\n\\textrm{E}[X] = \\textrm{E}\\left[\\frac{1 + Y}{2}\\right].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot \\text{E}[1+Y] \\\\  & =\\frac{1}{2}\\cdot (1+\\text{E}[Y])\\end{aligned}\n$$\n\nSince $Y$ is uniformly distributed on $\\{1, 2, \\dots, 201\\},$ we compute\n\n$$\n\\textrm{E}[Y] = \\frac{1 + 201}{2} = 101.\n$$\n\nSubstituting, we find\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot (1+101) \\\\  & =\\frac{1}{2}\\cdot 102 \\\\  & =51.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-fb48c25d-7d3e-5c68-83ac-d6034fcc4a05" :question/id #uuid "fb48c25d-7d3e-5c68-83ac-d6034fcc4a05" :question/math-academy-id "q-275424" :question/problem "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $a$ and $b$ with probabilities $0.55$ and $0.45,$ respectively. You are given the following conditional expectations:\n\n$$\n\\text{E}[X∣Y=a]=6,\\,\\text{E}[X∣Y=b]=4\n$$\n\nWhat is $\\text{E}[X]?$" :question/worked-solution "We are asked to compute the expected value of $X,$ given conditional expectations of $X$ based on the value of another random variable $Y.$ This is a direct application of the law of total expectation, which states\n\n$$\n\\text{E}[X]={\\sum }_{y}\\text{E}[X∣Y=y]\\cdot P(Y=y).\n$$\n\nIn this problem, $Y$ takes two values:\n\n- $Y=a$ with probability $0.55,$ and $\\text{E}[X∣Y=a]=6$\n\n- $Y=b$ with probability $0.45,$ and $\\text{E}[X∣Y=b]=4$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=a]\\cdot P(Y=a)+\\text{E}[X∣Y=b]\\cdot P(Y=b) \\\\  & =6\\cdot 0.55+4\\cdot 0.45 \\\\  & =3.3+1.8 \\\\  & =5.1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c8474380-6762-5e2b-a828-de08bc8f4b07"] :db/ensure [:question/validate]} {:db/id "answer-field-c8474380-6762-5e2b-a828-de08bc8f4b07" :answer-field/id #uuid "c8474380-6762-5e2b-a828-de08bc8f4b07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b7e73c9-fbbc-51f1-8e60-c8d5c4145021" :answer-field/choices ["answer-e1ce6be2-246b-5b58-97cc-84990fd5de70" "answer-5705a760-886d-5f55-af83-b5258fc3c589" "answer-35aec184-a511-5be8-a507-0771ade9da57" "answer-6b7e73c9-fbbc-51f1-8e60-c8d5c4145021" "answer-c867db21-96a9-5ec9-ad70-6ff7ad8bac73"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1ce6be2-246b-5b58-97cc-84990fd5de70" :answer/id #uuid "e1ce6be2-246b-5b58-97cc-84990fd5de70" :answer/type :answer.type/math :answer/value "3.1" :db/ensure [:answer/validate]} {:db/id "answer-5705a760-886d-5f55-af83-b5258fc3c589" :answer/id #uuid "5705a760-886d-5f55-af83-b5258fc3c589" :answer/type :answer.type/math :answer/value "3.9" :db/ensure [:answer/validate]} {:db/id "answer-35aec184-a511-5be8-a507-0771ade9da57" :answer/id #uuid "35aec184-a511-5be8-a507-0771ade9da57" :answer/type :answer.type/math :answer/value "4.9" :db/ensure [:answer/validate]} {:db/id "answer-6b7e73c9-fbbc-51f1-8e60-c8d5c4145021" :answer/id #uuid "6b7e73c9-fbbc-51f1-8e60-c8d5c4145021" :answer/type :answer.type/math :answer/value "5.1" :db/ensure [:answer/validate]} {:db/id "answer-c867db21-96a9-5ec9-ad70-6ff7ad8bac73" :answer/id #uuid "c867db21-96a9-5ec9-ad70-6ff7ad8bac73" :answer/type :answer.type/math :answer/value "5.4" :db/ensure [:answer/validate]} {:db/id "question-6d436b5a-22ca-50fe-bbca-e3c952622b7f" :question/id #uuid "6d436b5a-22ca-50fe-bbca-e3c952622b7f" :question/math-academy-id "q-275428" :question/problem "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $p,$ $q,$ and $r$ with probabilities $0.5,$ $0.3,$ and $0.2,$ respectively. You are given the following conditional expectations:\n\n$$\n\\text{E}[X∣Y=p]=8,\\,\\text{E}[X∣Y=q]=14,\\,\\text{E}[X∣Y=r]=10.\n$$\n\nWhat is $\\text{E}[X]?$" :question/worked-solution "We are given the conditional expectations of $X$ given different values of another random variable $Y,$ along with the probabilities of those values. This is a direct application of the law of total expectation, which states:\n\n$$\n\\text{E}[X]={\\sum }_{y}\\text{E}[X∣Y=y]\\cdot P(Y=y).\n$$\n\nIn this problem, $Y$ takes three values:\n\n- $Y=p$ with probability $0.5,$ and $\\text{E}[X∣Y=p]=8$\n\n- $Y=q$ with probability $0.3,$ and $\\text{E}[X∣Y=q]=14$\n\n- $Y=r$ with probability $0.2,$ and $\\text{E}[X∣Y=r]=10$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=p]\\cdot P(Y=p)+\\text{E}[X∣Y=q]\\cdot P(Y=q) \\\\  & \\,+\\,\\text{E}[X∣Y=r]\\cdot P(Y=r) \\\\  & =8\\cdot 0.5+14\\cdot 0.3+10\\cdot 0.2 \\\\  & =4+4.2+2 \\\\  & =10.2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-96bbda27-3868-52f3-95a1-2c04686d229f"] :db/ensure [:question/validate]} {:db/id "answer-field-96bbda27-3868-52f3-95a1-2c04686d229f" :answer-field/id #uuid "96bbda27-3868-52f3-95a1-2c04686d229f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-01f4c462-5661-5976-aa00-f293611bd8ad" :answer-field/choices ["answer-01f4c462-5661-5976-aa00-f293611bd8ad" "answer-9521cc63-f41b-5956-a47b-e64eb1aeaba5" "answer-360c385c-7cb0-5d64-98b2-ff81a8374aee" "answer-f3b854fb-2d2f-5896-abed-cca0f157da5f" "answer-63f05175-1e59-535e-9b01-7f59bc3c90e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-01f4c462-5661-5976-aa00-f293611bd8ad" :answer/id #uuid "01f4c462-5661-5976-aa00-f293611bd8ad" :answer/type :answer.type/math :answer/value "10.2" :db/ensure [:answer/validate]} {:db/id "answer-9521cc63-f41b-5956-a47b-e64eb1aeaba5" :answer/id #uuid "9521cc63-f41b-5956-a47b-e64eb1aeaba5" :answer/type :answer.type/math :answer/value "10.8" :db/ensure [:answer/validate]} {:db/id "answer-360c385c-7cb0-5d64-98b2-ff81a8374aee" :answer/id #uuid "360c385c-7cb0-5d64-98b2-ff81a8374aee" :answer/type :answer.type/math :answer/value "11.4" :db/ensure [:answer/validate]} {:db/id "answer-f3b854fb-2d2f-5896-abed-cca0f157da5f" :answer/id #uuid "f3b854fb-2d2f-5896-abed-cca0f157da5f" :answer/type :answer.type/math :answer/value "8.8" :db/ensure [:answer/validate]} {:db/id "answer-63f05175-1e59-535e-9b01-7f59bc3c90e6" :answer/id #uuid "63f05175-1e59-535e-9b01-7f59bc3c90e6" :answer/type :answer.type/math :answer/value "9.2" :db/ensure [:answer/validate]} {:db/id 17592186208940 :question/problem "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $1$ and $2$ with probabilities $0.3$ and $0.7,$ respectively. You are given the following conditional expectations:\n\n$$\n\\text{E}[X∣Y=1]=5,\\,\\text{E}[X∣Y=2]=8\n$$\n\nWhat is $\\text{E}[X]?$" :question/worked-solution "We are asked to compute the expected value of $X,$ given conditional expectations of $X$ based on the value of another random variable $Y.$ This is a direct application of the law of total expectation, which states\n\n$$\n\\text{E}[X]={\\sum }_{y}\\text{E}[X∣Y=y]\\cdot P(Y=y).\n$$\n\nIn this problem, $Y$ takes two values:\n\n- $Y=1$ with probability $0.3,$ and $\\text{E}[X∣Y=1]=5$\n\n- $Y=2$ with probability $0.7,$ and $\\text{E}[X∣Y=2]=8$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=1]\\cdot P(Y=1)+\\text{E}[X∣Y=2]\\cdot P(Y=2) \\\\  & =5\\cdot 0.3+8\\cdot 0.7 \\\\  & =1.5+5.6 \\\\  & =7.1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186205396 :answer-field/correct 17592186205400 :db/ensure [:answer-field/validate]} {:db/id "question-d3d68253-5058-5406-8e0e-23e4aaba826a" :question/id #uuid "d3d68253-5058-5406-8e0e-23e4aaba826a" :question/math-academy-id "q-275432" :question/problem "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $-1,$ $0,$ and $1$ with probabilities $0.15,$ $0.55,$ and $0.3,$ respectively. You are given the following conditional expectations:\n\n$$\n\\text{E}[X∣Y=-1]=4,\\,\\text{E}[X∣Y=0]=9,\\,\\text{E}[X∣Y=1]=8.\n$$\n\nWhat is $\\text{E}[X]?$" :question/worked-solution "We are given the conditional expectations of $X$ given different values of another random variable $Y,$ along with the probabilities of those values. This is a direct application of the law of total expectation, which states:\n\n$$\n\\text{E}[X]={\\sum }_{y}\\text{E}[X∣Y=y]\\cdot P(Y=y).\n$$\n\nIn this problem, $Y$ takes three values:\n\n- $Y=-1$ with probability $0.15,$ and $\\text{E}[X∣Y=-1]=4$\n\n- $Y=0$ with probability $0.55,$ and $\\text{E}[X∣Y=0]=9$\n\n- $Y=1$ with probability $0.3,$ and $\\text{E}[X∣Y=1]=8$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=-1]\\cdot P(Y=-1)+\\text{E}[X∣Y=0]\\cdot P(Y=0) \\\\  & \\,+\\,\\text{E}[X∣Y=1]\\cdot P(Y=1) \\\\  & =4\\cdot 0.15+9\\cdot 0.55+8\\cdot 0.3 \\\\  & =0.6+4.95+2.4 \\\\  & =7.95\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7d65bc33-87c9-5ab8-9039-3010d73546b5"] :db/ensure [:question/validate]} {:db/id "answer-field-7d65bc33-87c9-5ab8-9039-3010d73546b5" :answer-field/id #uuid "7d65bc33-87c9-5ab8-9039-3010d73546b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6d5a3570-3cf0-55e5-b174-12b466051ec3" :answer-field/choices ["answer-c93028d8-49e0-50fa-b211-b09c7b666a00" "answer-6d5a3570-3cf0-55e5-b174-12b466051ec3" "answer-75dd2ec8-ff16-5656-926a-2f44a28bf8a9" "answer-2fc16bed-211b-571b-9c24-c04e7bd06319" "answer-4b3312c2-ce2d-59c7-b9f4-a171218a11b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-c93028d8-49e0-50fa-b211-b09c7b666a00" :answer/id #uuid "c93028d8-49e0-50fa-b211-b09c7b666a00" :answer/type :answer.type/math :answer/value "7.35" :db/ensure [:answer/validate]} {:db/id "answer-6d5a3570-3cf0-55e5-b174-12b466051ec3" :answer/id #uuid "6d5a3570-3cf0-55e5-b174-12b466051ec3" :answer/type :answer.type/math :answer/value "7.95" :db/ensure [:answer/validate]} {:db/id "answer-75dd2ec8-ff16-5656-926a-2f44a28bf8a9" :answer/id #uuid "75dd2ec8-ff16-5656-926a-2f44a28bf8a9" :answer/type :answer.type/math :answer/value "8.70" :db/ensure [:answer/validate]} {:db/id "answer-2fc16bed-211b-571b-9c24-c04e7bd06319" :answer/id #uuid "2fc16bed-211b-571b-9c24-c04e7bd06319" :answer/type :answer.type/math :answer/value "9.10" :db/ensure [:answer/validate]} {:db/id "answer-4b3312c2-ce2d-59c7-b9f4-a171218a11b9" :answer/id #uuid "4b3312c2-ce2d-59c7-b9f4-a171218a11b9" :answer/type :answer.type/math :answer/value "9.95" :db/ensure [:answer/validate]} {:db/id 17592186208941 :question/problem "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $a,$ $b,$ and $c$ with probabilities $0.25,$ $0.5,$ and $0.25,$ respectively. You are given the following conditional expectations:\n\n$$\n\\text{E}[X∣Y=a]=10,\\,\\text{E}[X∣Y=b]=4,\\,\\text{E}[X∣Y=c]=6.\n$$\n\nWhat is $\\text{E}[X]?$" :question/worked-solution "We are given the conditional expectations of $X$ given different values of another random variable $Y,$ along with the probabilities of those values. This is a direct application of the law of total expectation, which states:\n\n$$\n\\text{E}[X]={\\sum }_{y}\\text{E}[X∣Y=y]\\cdot P(Y=y).\n$$\n\nIn this problem, $Y$ takes three values:\n\n- $Y=a$ with probability $0.25,$ and $\\text{E}[X∣Y=a]=10$\n\n- $Y=b$ with probability $0.5,$ and $\\text{E}[X∣Y=b]=4$\n\n- $Y=c$ with probability $0.25,$ and $\\text{E}[X∣Y=c]=6$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=a]\\cdot P(Y=a)+\\text{E}[X∣Y=b]\\cdot P(Y=b) \\\\  & \\,+\\text{E}[X∣Y=c]\\cdot P(Y=c) \\\\  & =10\\cdot 0.25+4\\cdot 0.5+6\\cdot 0.25 \\\\  & =2.5+2+1.5 \\\\  & =6.0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186205402 :answer-field/correct 17592186205407 :db/ensure [:answer-field/validate]} {:db/id "question-87aec959-895e-5be8-8c69-b3c4045c5829" :question/id #uuid "87aec959-895e-5be8-8c69-b3c4045c5829" :question/math-academy-id "q-275442" :question/problem "An order picker in a warehouse is assigned to either Section $1$ or Section $2$ on any given day. With probability $0.65,$ the order picker works in Section $1,$ where the expected number of orders picked per day is $120.$ With probability $0.35,$ the order picker works in Section $2,$ where the expected number of orders picked per day is $95.$\n\nWhat is the expected number of orders picked per day?" :question/worked-solution "We are asked to compute the expected number of orders picked per day. This is a classic application of the law of total expectation, which allows us to calculate an overall expected value by conditioning on a related variable — in this case, the section to which the picker is assigned.\n\nLet $X$ be the number of orders picked, and let $Y$ be the warehouse section to which the picker is assigned.\n\n- $Y=1$ with probability $0.65,$ and $\\text{E}[X∣Y=1]=120.$\n\n- $Y=2$ with probability $0.35,$ and $\\text{E}[X∣Y=2]=95.$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=1]\\cdot P(Y=1)+\\text{E}[X∣Y=2]\\cdot P(Y=2) \\\\  & =120\\cdot 0.65+95\\cdot 0.35 \\\\  & =78+33.25 \\\\  & =111.25\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-07a6fd0d-84d2-5683-803a-b9493ca6e2c8"] :db/ensure [:question/validate]} {:db/id "answer-field-07a6fd0d-84d2-5683-803a-b9493ca6e2c8" :answer-field/id #uuid "07a6fd0d-84d2-5683-803a-b9493ca6e2c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3bcf6b66-bdce-5940-b915-81dcdd0dd19c" :answer-field/choices ["answer-e064cd7c-03b0-527c-8e07-df8848c5ab25" "answer-9833c4d9-c22a-5a16-a11a-7bcabe4a936e" "answer-8928a195-7188-5e31-9b90-cb91da301cc0" "answer-3bcf6b66-bdce-5940-b915-81dcdd0dd19c" "answer-2339995c-293a-5e38-b75f-583b94bb3fcd"] :db/ensure [:answer-field/validate]} {:db/id "answer-e064cd7c-03b0-527c-8e07-df8848c5ab25" :answer/id #uuid "e064cd7c-03b0-527c-8e07-df8848c5ab25" :answer/type :answer.type/math :answer/value "103.75" :db/ensure [:answer/validate]} {:db/id "answer-9833c4d9-c22a-5a16-a11a-7bcabe4a936e" :answer/id #uuid "9833c4d9-c22a-5a16-a11a-7bcabe4a936e" :answer/type :answer.type/math :answer/value "105.50" :db/ensure [:answer/validate]} {:db/id "answer-8928a195-7188-5e31-9b90-cb91da301cc0" :answer/id #uuid "8928a195-7188-5e31-9b90-cb91da301cc0" :answer/type :answer.type/math :answer/value "109.25" :db/ensure [:answer/validate]} {:db/id "answer-3bcf6b66-bdce-5940-b915-81dcdd0dd19c" :answer/id #uuid "3bcf6b66-bdce-5940-b915-81dcdd0dd19c" :answer/type :answer.type/math :answer/value "111.25" :db/ensure [:answer/validate]} {:db/id "answer-2339995c-293a-5e38-b75f-583b94bb3fcd" :answer/id #uuid "2339995c-293a-5e38-b75f-583b94bb3fcd" :answer/type :answer.type/math :answer/value "114.25" :db/ensure [:answer/validate]} {:db/id 17592186208943 :question/problem "A surveyor is sent to one of three cities: $A,$ $B,$ or $C.$ She is sent to City $A$ with a probability of $0.4,$ City $B$ with a probability of $0.35,$ and City $C$ with a probability of $0.25.$  \n\nIf the expected number of households visited is $12$ in City $A,$ $18$ in City $B,$ and $10$ in City $C,$ what is the expected number of households visited on a given day?\n\nThe expected number of households visited is\n{{field-1}}." :question/worked-solution "We are given the probabilities of being assigned to one of three cities and the expected number of households visited in each. This is a direct application of the law of total expectation, which tells us how to compute the overall expected value by conditioning on which city the surveyor is sent to.\n\nLet $X$ be the number of households visited in a day, and let $Y$ be the city to which the surveyor is sent.\n\n- $Y=A$ with probability $0.4,$ and $\\text{E}[X∣Y=A]=12.$\n\n- $Y=B$ with probability $0.35,$ and $\\text{E}[X∣Y=B]=18.$\n\n- $Y=C$ with probability $0.25,$ and $\\text{E}[X∣Y=C]=10.$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=A]\\cdot P(Y=A)+\\text{E}[X∣Y=B]\\cdot P(Y=B) \\\\  & \\,+\\text{E}[X∣Y=C]\\cdot P(Y=C) \\\\  & =12\\cdot 0.4+18\\cdot 0.35+10\\cdot 0.25 \\\\  & =4.8+6.3+2.5 \\\\  & =13.6\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186205414 :answer-field/correct "answer-0ad36734-d9b3-5129-9113-dc04e511be28" :answer-field/choices ["answer-0ad36734-d9b3-5129-9113-dc04e511be28"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ad36734-d9b3-5129-9113-dc04e511be28" :answer/id #uuid "0ad36734-d9b3-5129-9113-dc04e511be28" :answer/type :answer.type/math :answer/value "13.6" :db/ensure [:answer/validate]} {:db/id "question-e734511f-0834-5433-966a-4ae3851cf360" :question/id #uuid "e734511f-0834-5433-966a-4ae3851cf360" :question/math-academy-id "q-275443" :question/problem "A ride-share driver starts every day in either the City Center or the Suburban Area. The driver starts the day in the City Center with probability $0.55,$ where the expected number of rides given per day is $14.3.$ The driver starts the day in the Suburban Area with probability $0.45,$ where the expected number of rides is $11.7.$\n\nWhat is the expected number of rides given in a day?" :question/worked-solution "We are asked to compute the expected number of rides given in a day. This is a classic application of the law of total expectation, which allows us to calculate an overall expected value by conditioning on a related variable — in this case, the driver's starting location.\n\nLet $X$ be the number of rides completed in a day, and $Y$ be the location from which the driver started.\n\n- $Y=\\text{City}$ with probability $0.55,$ and $\\text{E}[X∣Y=\\text{City}]=14.3.$\n\n- $Y=\\text{Suburban}$ with probability $0.45,$ and $\\text{E}[X∣Y=\\text{Suburban}]=11.7.$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=\\text{City}]\\cdot P(Y=\\text{City}) \\\\  & \\,+\\,\\text{E}[X∣Y=\\text{Suburban}]\\cdot P(Y=\\text{Suburban}) \\\\  & =14.3\\cdot 0.55+11.7\\cdot 0.45 \\\\  & =7.865+5.265 \\\\  & =13.13\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7fa1202d-fa18-55bd-a2d1-4f1dd6925f9a"] :db/ensure [:question/validate]} {:db/id "answer-field-7fa1202d-fa18-55bd-a2d1-4f1dd6925f9a" :answer-field/id #uuid "7fa1202d-fa18-55bd-a2d1-4f1dd6925f9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4e540e23-280f-5784-b5b7-b1fed19afe8e" :answer-field/choices ["answer-1ebfc5d8-7755-54b9-912e-c479df8e0d82" "answer-efd06613-add9-5cb6-9c13-d6a82ba9bff8" "answer-ec127202-7f79-5f14-be98-442abd6566f3" "answer-4e540e23-280f-5784-b5b7-b1fed19afe8e" "answer-a45626ac-9eeb-5cb2-94e4-c2afebfdf1a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ebfc5d8-7755-54b9-912e-c479df8e0d82" :answer/id #uuid "1ebfc5d8-7755-54b9-912e-c479df8e0d82" :answer/type :answer.type/math :answer/value "11.13" :db/ensure [:answer/validate]} {:db/id "answer-efd06613-add9-5cb6-9c13-d6a82ba9bff8" :answer/id #uuid "efd06613-add9-5cb6-9c13-d6a82ba9bff8" :answer/type :answer.type/math :answer/value "11.34" :db/ensure [:answer/validate]} {:db/id "answer-ec127202-7f79-5f14-be98-442abd6566f3" :answer/id #uuid "ec127202-7f79-5f14-be98-442abd6566f3" :answer/type :answer.type/math :answer/value "12.87" :db/ensure [:answer/validate]} {:db/id "answer-4e540e23-280f-5784-b5b7-b1fed19afe8e" :answer/id #uuid "4e540e23-280f-5784-b5b7-b1fed19afe8e" :answer/type :answer.type/math :answer/value "13.13" :db/ensure [:answer/validate]} {:db/id "answer-a45626ac-9eeb-5cb2-94e4-c2afebfdf1a2" :answer/id #uuid "a45626ac-9eeb-5cb2-94e4-c2afebfdf1a2" :answer/type :answer.type/math :answer/value "13.87" :db/ensure [:answer/validate]} {:db/id "question-cdbfe9c8-c3f2-5a6b-9ce7-99052b0abd68" :question/id #uuid "cdbfe9c8-c3f2-5a6b-9ce7-99052b0abd68" :question/math-academy-id "q-275520" :question/problem "A salesperson visits one of three regions: North, South, or East. The probabilities that they are sent North, South, and East are $0.25,$ $0.5,$ and $0.25$ respectively.\n\nIf the expected number of sales made daily is $9$ in the North, $14$ in the South, and $11$ in the East, what is the expected number of sales made in a day?\n\nThe expected number of sales made is\n{{field-1}}." :question/worked-solution "We are given the probability of being sent to one of three regions and the expected number of sales made. This is a direct application of the law of total expectation, which tells us how to compute the overall expected value by conditioning on which region the salesperson visits.\n\nLet $X$ be the number of sales made in a day, and let $Y$ be the region the salesperson visited.\n\n- $Y=\\text{North}$ with probability $0.25,$ and $\\text{E}[X∣Y=\\text{North}]=9.$\n\n- $Y=\\text{South}$ with probability $0.5,$ and $\\text{E}[X∣Y=\\text{South}]=14.$\n\n- $Y=\\text{East}$ with probability $0.25,$ and $\\text{E}[X∣Y=\\text{East}]=11.$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=\\text{North}]\\cdot P(Y=\\text{North})+\\text{E}[X∣Y=\\text{South}]\\cdot P(Y=\\text{South}) \\\\  & \\,+\\,\\text{E}[X∣Y=\\text{East}]\\cdot P(Y=\\text{East}) \\\\  & =9\\cdot 0.25+14\\cdot 0.5+11\\cdot 0.25 \\\\  & =2.25+7+2.75 \\\\  & =12\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-024c3696-4bfc-53f3-92aa-3d9e2a4aac8f"] :db/ensure [:question/validate]} {:db/id "answer-field-024c3696-4bfc-53f3-92aa-3d9e2a4aac8f" :answer-field/id #uuid "024c3696-4bfc-53f3-92aa-3d9e2a4aac8f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a7bd3040-6ef9-5072-98f9-d1080e7ac6c3" :answer-field/choices ["answer-a7bd3040-6ef9-5072-98f9-d1080e7ac6c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7bd3040-6ef9-5072-98f9-d1080e7ac6c3" :answer/id #uuid "a7bd3040-6ef9-5072-98f9-d1080e7ac6c3" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-e0fafa34-8718-5c91-847f-90668c3f437e" :question/id #uuid "e0fafa34-8718-5c91-847f-90668c3f437e" :question/math-academy-id "q-275440" :question/problem "A tutoring agency assigns a tutor to either High School $A$ or High School $B.$ With probability $0.45,$ the tutor is sent to High School $A,$ where the expected number of students tutored in a day is $4.8.$ With probability $0.55,$ the tutor is sent to High School $B,$ where the expected number of students tutored is $6.2.$\n\nWhat is the expected number of students tutored in a day?" :question/worked-solution "We are asked to compute the expected number of students tutored per day. This is a classic application of the law of total expectation, which allows us to calculate an overall expected value by conditioning on a related variable — in this case, the high school the tutor is assigned to.\n\nLet $X$ be the number of students tutored in a day, and let $Y$ be the school to which the tutor is assigned.\n\n- $Y=A$ with probability $0.45,$ and $\\text{E}[X∣Y=A]=4.8.$\n\n- $Y=B$ with probability $0.55,$ and $\\text{E}[X∣Y=B]=6.2.$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=A]\\cdot P(Y=A)+\\text{E}[X∣Y=B]\\cdot P(Y=B) \\\\  & =4.8\\cdot 0.45+6.2\\cdot 0.55 \\\\  & =2.16+3.41 \\\\  & =5.57\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7107c288-407f-5c22-be30-7bf088a0a757"] :db/ensure [:question/validate]} {:db/id "answer-field-7107c288-407f-5c22-be30-7bf088a0a757" :answer-field/id #uuid "7107c288-407f-5c22-be30-7bf088a0a757" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5168d2e7-290a-5266-ac21-33841c67db65" :answer-field/choices ["answer-3985986c-c90d-5143-8b6a-1649e262e690" "answer-44301662-2ef4-5c3f-8e9b-ab1b90a50a4d" "answer-da687fdf-6465-5cd3-844f-d6a2b6e8f010" "answer-5168d2e7-290a-5266-ac21-33841c67db65" "answer-ec1c5b93-cc04-5959-8a00-8c6d5ed8a3cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-3985986c-c90d-5143-8b6a-1649e262e690" :answer/id #uuid "3985986c-c90d-5143-8b6a-1649e262e690" :answer/type :answer.type/math :answer/value "4.57" :db/ensure [:answer/validate]} {:db/id "answer-44301662-2ef4-5c3f-8e9b-ab1b90a50a4d" :answer/id #uuid "44301662-2ef4-5c3f-8e9b-ab1b90a50a4d" :answer/type :answer.type/math :answer/value "4.92" :db/ensure [:answer/validate]} {:db/id "answer-da687fdf-6465-5cd3-844f-d6a2b6e8f010" :answer/id #uuid "da687fdf-6465-5cd3-844f-d6a2b6e8f010" :answer/type :answer.type/math :answer/value "5.43" :db/ensure [:answer/validate]} {:db/id "answer-5168d2e7-290a-5266-ac21-33841c67db65" :answer/id #uuid "5168d2e7-290a-5266-ac21-33841c67db65" :answer/type :answer.type/math :answer/value "5.57" :db/ensure [:answer/validate]} {:db/id "answer-ec1c5b93-cc04-5959-8a00-8c6d5ed8a3cf" :answer/id #uuid "ec1c5b93-cc04-5959-8a00-8c6d5ed8a3cf" :answer/type :answer.type/math :answer/value "6.13" :db/ensure [:answer/validate]} {:db/id 17592186208947 :question/problem "Let $X$ and $Y$ be discrete random variables, and suppose $\\text{E}[X∣Y]=5Y-4.$ If $\\text{E}[X]=11,$ what is $\\text{E}[Y]?$" :question/worked-solution "We are given an expression for $\\text{E}[X∣Y]$ in terms of $Y,$ and the value of $\\text{E}[X].$ This is a direct application of the tower property, which states that\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation, which gives\n\n$$\n\\text{E}[X]=\\text{E}[5Y-4].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[5Y-4] \\\\  & =5\\cdot \\text{E}[Y]-4\\end{aligned}\n$$\n\nWe are told that $\\text{E}[X]=11,$ so we solve this equation as follows:\n\n$$\n\\begin{aligned}11 & =5\\cdot \\text{E}[Y]-4 \\\\ 15 & =5\\cdot \\text{E}[Y] \\\\ \\text{E}[Y] & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186205428 :answer-field/correct 17592186205429 :db/ensure [:answer-field/validate]} {:db/id 17592186208944 :question/problem "Let $X$ and $Y$ be discrete random variables, and suppose $\\text{E}[X∣Y]=2Y+1.$ If $\\text{E}[Y]=3,$ what is $\\text{E}[X]?$" :question/worked-solution "We are given an expression for $\\text{E}[X∣Y]$ in terms of $Y,$ and we are asked to compute $\\text{E}[X].$ This is a direct application of the tower property, which states that\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation:\n\n$$\n\\text{E}[X]=\\text{E}[2Y+1]\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[2Y+1] \\\\  & =2\\cdot \\text{E}[Y]+\\text{E}[1] \\\\  & =2\\cdot 3+1 \\\\  & =7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186205415 :answer-field/correct 17592186205418 :db/ensure [:answer-field/validate]} {:db/id "question-9a2b9353-2f5e-55ce-b33e-819639da3c0b" :question/id #uuid "9a2b9353-2f5e-55ce-b33e-819639da3c0b" :question/math-academy-id "q-275544" :question/problem "Let $X$ and $Y$ be discrete random variables, and suppose $\\text{E}[X∣Y]=2Y-2.$ If $\\text{E}[X]=8,$ what is $\\text{E}[Y]?$" :question/worked-solution "We are given an expression for $\\text{E}[X∣Y]$ in terms of $Y,$ and the value of $\\text{E}[X].$ This is a direct application of the tower property, which states that\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation, which gives\n\n$$\n\\text{E}[X]=\\text{E}[2Y-2].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[2Y-2] \\\\  & =2\\cdot \\text{E}[Y]-2\\end{aligned}\n$$\n\nWe are told that $\\text{E}[X]=8,$ so we solve this equation as follows:\n\n$$\n\\begin{aligned}8 & =2\\cdot \\text{E}[Y]-2 \\\\ 10 & =2\\cdot \\text{E}[Y] \\\\ \\text{E}[Y] & =5\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-54959153-de5a-5466-a4b1-49e8eaebfe70"] :db/ensure [:question/validate]} {:db/id "answer-field-54959153-de5a-5466-a4b1-49e8eaebfe70" :answer-field/id #uuid "54959153-de5a-5466-a4b1-49e8eaebfe70" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-42094129-8f02-5060-8d21-acf753bc6258" :answer-field/choices ["answer-52a4c2bf-387d-5b7e-bf21-ae9983d935b4" "answer-3abc4c6c-e992-5e50-8cbc-4cecc9be41da" "answer-42094129-8f02-5060-8d21-acf753bc6258" "answer-e8375514-a11d-5124-8eae-6634cb095e47" "answer-491ce60c-f9f3-5ec1-877e-b9b0f2a1a805"] :db/ensure [:answer-field/validate]} {:db/id "answer-52a4c2bf-387d-5b7e-bf21-ae9983d935b4" :answer/id #uuid "52a4c2bf-387d-5b7e-bf21-ae9983d935b4" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-3abc4c6c-e992-5e50-8cbc-4cecc9be41da" :answer/id #uuid "3abc4c6c-e992-5e50-8cbc-4cecc9be41da" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-42094129-8f02-5060-8d21-acf753bc6258" :answer/id #uuid "42094129-8f02-5060-8d21-acf753bc6258" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-e8375514-a11d-5124-8eae-6634cb095e47" :answer/id #uuid "e8375514-a11d-5124-8eae-6634cb095e47" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-491ce60c-f9f3-5ec1-877e-b9b0f2a1a805" :answer/id #uuid "491ce60c-f9f3-5ec1-877e-b9b0f2a1a805" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-eff3dc19-9675-582f-bb2d-ae75355788e9" :question/id #uuid "eff3dc19-9675-582f-bb2d-ae75355788e9" :question/math-academy-id "q-275531" :question/problem "Let $X$ and $Y$ be discrete random variables, and suppose $\\text{E}[X∣Y]=4Y-3.$ If $\\text{E}[Y]=10,$ what is $\\text{E}[X]?$" :question/worked-solution "We are given an expression for $\\text{E}[X∣Y]$ in terms of $Y,$ and we are asked to compute $\\text{E}[X].$ This is a direct application of the tower property, which states that\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation:\n\n$$\n\\text{E}[X]=\\text{E}[4Y-3]\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[4Y-3] \\\\  & =4\\cdot \\text{E}[Y]-\\text{E}[3] \\\\  & =4\\cdot 10-3 \\\\  & =37\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eddd8d9a-b8c8-5b64-931c-553d29bea668"] :db/ensure [:question/validate]} {:db/id "answer-field-eddd8d9a-b8c8-5b64-931c-553d29bea668" :answer-field/id #uuid "eddd8d9a-b8c8-5b64-931c-553d29bea668" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4e61cd89-a242-5216-a20c-e05a7e080c25" :answer-field/choices ["answer-03860298-0f63-5504-87bf-85c028b3a592" "answer-4e61cd89-a242-5216-a20c-e05a7e080c25" "answer-deb8feb4-d70c-584b-b26a-23713cd34220" "answer-fcc111df-6c57-5ca0-ae26-ce4da622b5d7" "answer-9d5ece32-b4ba-5674-8e4e-857a5d3de455"] :db/ensure [:answer-field/validate]} {:db/id "answer-03860298-0f63-5504-87bf-85c028b3a592" :answer/id #uuid "03860298-0f63-5504-87bf-85c028b3a592" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-4e61cd89-a242-5216-a20c-e05a7e080c25" :answer/id #uuid "4e61cd89-a242-5216-a20c-e05a7e080c25" :answer/type :answer.type/math :answer/value "37" :db/ensure [:answer/validate]} {:db/id "answer-deb8feb4-d70c-584b-b26a-23713cd34220" :answer/id #uuid "deb8feb4-d70c-584b-b26a-23713cd34220" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "answer-fcc111df-6c57-5ca0-ae26-ce4da622b5d7" :answer/id #uuid "fcc111df-6c57-5ca0-ae26-ce4da622b5d7" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-9d5ece32-b4ba-5674-8e4e-857a5d3de455" :answer/id #uuid "9d5ece32-b4ba-5674-8e4e-857a5d3de455" :answer/type :answer.type/math :answer/value "43" :db/ensure [:answer/validate]} {:db/id "question-fde0d020-b26d-5edb-a043-de5b1f35d4a2" :question/id #uuid "fde0d020-b26d-5edb-a043-de5b1f35d4a2" :question/math-academy-id "q-275538" :question/problem "Let $X$ and $Y$ be discrete random variables, and suppose $\\text{E}[X∣Y]=\\sqrt{3}\\,Y+1.$ If $\\text{E}[Y]=\\sqrt{3},$ what is $\\text{E}[X]?$" :question/worked-solution "We are given an expression for $\\text{E}[X∣Y]$ in terms of $Y,$ and we are asked to compute $\\text{E}[X].$ This is a direct application of the tower property, which states that\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation:\n\n$$\n\\text{E}[X]=\\text{E}[\\sqrt{3}\\,Y+1]\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[\\sqrt{3}\\,Y+1] \\\\  & =\\sqrt{3}\\cdot \\text{E}[Y]+\\text{E}[1] \\\\  & =\\sqrt{3}\\cdot \\sqrt{3}+1 \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-105ca86f-b24b-5982-836e-67345b1718da"] :db/ensure [:question/validate]} {:db/id "answer-field-105ca86f-b24b-5982-836e-67345b1718da" :answer-field/id #uuid "105ca86f-b24b-5982-836e-67345b1718da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a83bbdf8-1ade-579f-bb74-f6b17ea4146a" :answer-field/choices ["answer-ea76e181-16a3-5d50-9003-e112be2d1b38" "answer-1fce9e9b-9b99-550d-b6b3-9f794430e98b" "answer-a83bbdf8-1ade-579f-bb74-f6b17ea4146a" "answer-8bd9549c-5e7d-5f20-acda-21283ef2b8a2" "answer-081b8e1b-1cb3-543b-9409-ebd64f7828d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea76e181-16a3-5d50-9003-e112be2d1b38" :answer/id #uuid "ea76e181-16a3-5d50-9003-e112be2d1b38" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-1fce9e9b-9b99-550d-b6b3-9f794430e98b" :answer/id #uuid "1fce9e9b-9b99-550d-b6b3-9f794430e98b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a83bbdf8-1ade-579f-bb74-f6b17ea4146a" :answer/id #uuid "a83bbdf8-1ade-579f-bb74-f6b17ea4146a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-8bd9549c-5e7d-5f20-acda-21283ef2b8a2" :answer/id #uuid "8bd9549c-5e7d-5f20-acda-21283ef2b8a2" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-081b8e1b-1cb3-543b-9409-ebd64f7828d6" :answer/id #uuid "081b8e1b-1cb3-543b-9409-ebd64f7828d6" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-d15a80b9-3b38-5de0-953c-45a827aaaf2b" :question/id #uuid "d15a80b9-3b38-5de0-953c-45a827aaaf2b" :question/math-academy-id "q-275580" :question/problem "A robotic arm randomly selects a box in a warehouse containing $n$ items from $1$ to $150,$ with each value equally likely. The arm then randomly picks one of these $n$ items and scans its position number (from $1$ to $n,$ each value equally likely).\n\nWhat is the expected position number scanned?\n\nThe expected position number scanned is\n{{field-1}}." :question/worked-solution "This is a two-step random process: first, a box is selected containing $n$ items uniformly from $1$ through $150,$ and then an item is chosen uniformly in one of the positions numbered $1$ through $n.$\n\n- Let $Y$ be the number of items in the box. Since this is an integer selected uniformly from $1$ to $150,$ we have $Y∼U\\{1,2,…,150\\}.$\n\n- Let $X$ be the position number scanned, an integer selected uniformly from $1$ to $Y.$\n\nWe are asked to compute $\\text{E}[X].$ Since the distribution of $X$ depends on $Y,$ we apply the tower property:\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]]\n$$\n\nGiven $Y=n,$ the number $X$ is chosen uniformly from $1$ to $n.$ So, we have that\n\n$$\n\\text{E}[X∣Y=n]=\\frac{n+1}{2}.\n$$\n\nTherefore, we have that\n\n$$\n\\text{E}[X]=\\text{E}[\\frac{Y+1}{2}].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot \\text{E}[Y+1] \\\\  & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1)\\end{aligned}\n$$\n\nSince $Y$ is uniformly distributed on $\\{1,2,…,150\\},$ we use the formula for the mean of the first $n$ integers:\n\n$$\n\\text{E}[Y]=\\frac{150+1}{2}=75.5\n$$\n\nSubstituting, we finally get\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1) \\\\  & =\\frac{1}{2}\\cdot (75.5+1) \\\\  & =\\frac{1}{2}\\cdot 76.5 \\\\  & =38.25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f05f3dbe-00ff-5d9e-ab0d-54ff37d66045"] :db/ensure [:question/validate]} {:db/id "answer-field-f05f3dbe-00ff-5d9e-ab0d-54ff37d66045" :answer-field/id #uuid "f05f3dbe-00ff-5d9e-ab0d-54ff37d66045" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9cc71da5-b68e-5e22-b93f-45f1f89b8b2b" :answer-field/choices ["answer-9cc71da5-b68e-5e22-b93f-45f1f89b8b2b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9cc71da5-b68e-5e22-b93f-45f1f89b8b2b" :answer/id #uuid "9cc71da5-b68e-5e22-b93f-45f1f89b8b2b" :answer/type :answer.type/math :answer/value "38.25" :db/ensure [:answer/validate]} {:db/id "question-12dc9838-1006-5e99-98b8-8a2304014d14" :question/id #uuid "12dc9838-1006-5e99-98b8-8a2304014d14" :question/math-academy-id "q-275576" :question/problem "In a puzzle game, a room's difficulty level $n$ is selected randomly from $1$ to $120,$ with each value equally likely. Inside each room are $n$ puzzle pieces numbered from $1$ to $n,$ and one of them is selected uniformly at random. What is the expected value of the number on the selected puzzle piece?" :question/worked-solution "This is a two-step random process: first, a room of difficulty level $n$ is chosen randomly and uniformly from $1$ to $120,$ and then a puzzle piece with a number is chosen uniformly from $1$ to $n.$ We are asked to find the expected value of the puzzle piece selected in the second step.\n\n- Let $Y$ be the room difficulty level, an integer selected uniformly from $1$ to $120.$\n\n- Let $X$ be the puzzle piece number, an integer selected uniformly from $1$ to $Y.$\n\nWe are asked to compute $\\text{E}[X].$ Since the distribution of $X$ depends on $Y,$ we apply the tower property:\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]]\n$$\n\nGiven $Y=n,$ the number $X$ is chosen uniformly from $1$ to $n.$ So, we have that\n\n$$\n\\text{E}[X∣Y=n]=\\frac{n+1}{2}.\n$$\n\nTherefore, we have that\n\n$$\n\\text{E}[X]=\\text{E}[\\frac{Y+1}{2}].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot \\text{E}[Y+1] \\\\  & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1)\\end{aligned}\n$$\n\nSince $Y$ is uniformly distributed on $\\{1,2,…,120\\},$ we use the formula for the mean of the first $n$ integers:\n\n$$\n\\text{E}[Y]=\\frac{120+1}{2}=60.5\n$$\n\nSubstituting, we finally get\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1) \\\\  & =\\frac{1}{2}\\cdot (60.5+1) \\\\  & =\\frac{1}{2}\\cdot 61.5 \\\\  & =30.75.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e03c0e02-f315-5d2a-8a1e-94db11dbd1fa"] :db/ensure [:question/validate]} {:db/id "answer-field-e03c0e02-f315-5d2a-8a1e-94db11dbd1fa" :answer-field/id #uuid "e03c0e02-f315-5d2a-8a1e-94db11dbd1fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f2f3be2-1044-5aba-ace8-2bb9c009ba74" :answer-field/choices ["answer-ef3f8d2a-831e-5d39-947f-044c27f1b143" "answer-9b1fadd1-916b-5457-88b4-0b493db17e0e" "answer-4f2f3be2-1044-5aba-ace8-2bb9c009ba74" "answer-1f40d701-fe11-5693-bf29-41be6a09d080" "answer-87dcfc6f-0edf-5f39-92e6-578b03e8ce51"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef3f8d2a-831e-5d39-947f-044c27f1b143" :answer/id #uuid "ef3f8d2a-831e-5d39-947f-044c27f1b143" :answer/type :answer.type/math :answer/value "29.00" :db/ensure [:answer/validate]} {:db/id "answer-9b1fadd1-916b-5457-88b4-0b493db17e0e" :answer/id #uuid "9b1fadd1-916b-5457-88b4-0b493db17e0e" :answer/type :answer.type/math :answer/value "30.50" :db/ensure [:answer/validate]} {:db/id "answer-4f2f3be2-1044-5aba-ace8-2bb9c009ba74" :answer/id #uuid "4f2f3be2-1044-5aba-ace8-2bb9c009ba74" :answer/type :answer.type/math :answer/value "30.75" :db/ensure [:answer/validate]} {:db/id "answer-1f40d701-fe11-5693-bf29-41be6a09d080" :answer/id #uuid "1f40d701-fe11-5693-bf29-41be6a09d080" :answer/type :answer.type/math :answer/value "31.25" :db/ensure [:answer/validate]} {:db/id "answer-87dcfc6f-0edf-5f39-92e6-578b03e8ce51" :answer/id #uuid "87dcfc6f-0edf-5f39-92e6-578b03e8ce51" :answer/type :answer.type/math :answer/value "31.50" :db/ensure [:answer/validate]} {:db/id "question-5923cf06-a8dd-57e8-81ff-5f4a640b9a2b" :question/id #uuid "5923cf06-a8dd-57e8-81ff-5f4a640b9a2b" :question/math-academy-id "q-275578" :question/problem "A robot starts at the bottom of a staircase with $n$ steps, where $n$ is an integer chosen uniformly at random from $1$ to $10.$ The robot then climbs a uniformly random number of steps between $1$ and $n.$\n\nWhat is the expected number of steps the robot climbs?\n\nThe expected number of steps the robot climbs is\n{{field-1}}." :question/worked-solution "This is a two-step random process: first, an integer $n$ is chosen uniformly from $1$ through $10,$ and then a number is chosen uniformly from $1$ through $n.$\n\n- Let $Y$ be the first random number: the number of steps in the staircase. Since an integer selected uniformly from $1$ to $10,$ we have $Y∼U\\{1,2,…,10\\}.$\n\n- Let $X$ be the number of steps the robot climbs, an integer selected uniformly from $1$ to $Y.$\n\nWe are asked to compute $\\text{E}[X].$ Since the distribution of $X$ depends on $Y,$ we apply the tower property:\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]]\n$$\n\nGiven $Y=n,$ the number $X$ is chosen uniformly from $1$ to $n.$ So, we have that\n\n$$\n\\text{E}[X∣Y=n]=\\frac{n+1}{2}.\n$$\n\nTherefore, we have that\n\n$$\n\\text{E}[X]=\\text{E}[\\frac{Y+1}{2}].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot \\text{E}[Y+1] \\\\  & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1)\\end{aligned}\n$$\n\nSince $Y$ is uniformly distributed on $\\{1,2,…,10\\},$ we use the formula for the mean of the first $n$ integers:\n\n$$\n\\text{E}[Y]=\\frac{10+1}{2}=5.5\n$$\n\nSubstituting, we finally get\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1) \\\\  & =\\frac{1}{2}\\cdot (5.5+1) \\\\  & =\\frac{1}{2}\\cdot 6.5 \\\\  & =3.25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2b3cc385-06d8-50b5-ae5b-ce22d4c1e608"] :db/ensure [:question/validate]} {:db/id "answer-field-2b3cc385-06d8-50b5-ae5b-ce22d4c1e608" :answer-field/id #uuid "2b3cc385-06d8-50b5-ae5b-ce22d4c1e608" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-64094c0c-e4c0-599f-b265-b424a2b28840" :answer-field/choices ["answer-64094c0c-e4c0-599f-b265-b424a2b28840"] :db/ensure [:answer-field/validate]} {:db/id "answer-64094c0c-e4c0-599f-b265-b424a2b28840" :answer/id #uuid "64094c0c-e4c0-599f-b265-b424a2b28840" :answer/type :answer.type/math :answer/value "3.25" :db/ensure [:answer/validate]} {:db/id 17592186208945 :question/problem "A game randomly selects an integer $n$ from $1$ to $301,$ with each value equally likely. Then, a player is asked to guess an integer uniformly and randomly from $1$ to $n.$ What is the expected value of the player’s guess?" :question/worked-solution "This is a two-step random process: first, an integer $n$ is chosen uniformly from $1$ to $301,$ and then a number is chosen uniformly from $1$ to $n.$ We are asked to find the expected value of the number selected in the second step.\n\n- Let $Y$ be the first random number, an integer selected uniformly from $1$ to $301.$\n\n- Let $X$ be the player’s guess, an integer selected uniformly from $1$ to $Y.$\n\nWe are asked to compute $\\text{E}[X].$ Since the distribution of $X$ depends on $Y,$ we apply the tower property:\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]]\n$$\n\nGiven $Y=n,$ the number $X$ is chosen uniformly from $1$ to $n.$ So, we have that\n\n$$\n\\text{E}[X∣Y=n]=\\frac{n+1}{2}.\n$$\n\nTherefore, we have that\n\n$$\n\\text{E}[X]=\\text{E}[\\frac{1+Y}{2}].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot \\text{E}[1+Y] \\\\  & =\\frac{1}{2}\\cdot (1+\\text{E}[Y])\\end{aligned}\n$$\n\nSince $Y$ is uniformly distributed on $\\{1,2,…,301\\},$ we use the formula for the mean of the first $n$ integers:\n\n$$\n\\text{E}[Y]=\\frac{1+301}{2}=151.\n$$\n\nSubstituting, we finally get\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot (1+\\text{E}[Y]) \\\\  & =\\frac{1}{2}\\cdot (1+151) \\\\  & =\\frac{1}{2}\\cdot 152 \\\\  & =76.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186205421 :answer-field/correct 17592186205425 :db/ensure [:answer-field/validate]} {:db/id 17592186208946 :question/problem "A video game randomly selects a level difficulty $d$ from $1$ to $500,$ with each value equally likely. Once the difficulty is chosen, a treasure chest is placed in one of $d$ zones within the level, numbered from $1$ to $d,$ with each zone equally likely to receive the chest.\n\nWhat is the expected number of the zone where the chest appears?\n\nThe expected number of the zone where the chest appears is\n{{field-1}}." :question/worked-solution "This is a two-step random process: first, a level difficulty is selected uniformly from the integers $1$ through $500,$ and then a treasure chest is placed uniformly in one of the zones numbered $1$ through $d,$ where $d$ is the selected difficulty.\n\n- Let $Y$ be the difficulty level of the chosen level. Since the difficulty is chosen uniformly from $1$ to $500,$ we have $Y∼U\\{1,2,…,500\\}.$\n\n- Let $X$ be the number of the zone where the chest is placed, which is chosen uniformly from $1$ to $Y.$\n\nWe are asked to compute $\\text{E}[X].$ Since $X$ depends on $Y,$ we apply the tower property:\n\n$$\n\\text{E}[X]=\\text{E}[\\text{E}[X∣Y]]\n$$\n\nGiven $Y=d,$ the zone is selected uniformly from $1$ to $d.$ So, we have that\n\n$$\n\\text{E}[X∣Y=d]=\\frac{d+1}{2}.\n$$\n\nTherefore, we have that\n\n$$\n\\text{E}[X]=\\text{E}[\\frac{Y+1}{2}].\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot \\text{E}[Y+1] \\\\  & =\\frac{1}{2}\\cdot (\\text{E}[Y]+1)\\end{aligned}\n$$\n\nSince $Y$ is uniformly distributed on $\\{1,2,…,500\\},$ we compute\n\n$$\n\\text{E}[Y]=\\frac{1+500}{2}=250.5.\n$$\n\nSubstituting, we find\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\frac{1}{2}\\cdot (250.5+1) \\\\  & =\\frac{1}{2}\\cdot 251.5 \\\\  & =125.75.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186205427 :answer-field/correct "answer-630c2241-afa1-5bd5-9578-2f06d9c7212c" :answer-field/choices ["answer-630c2241-afa1-5bd5-9578-2f06d9c7212c"] :db/ensure [:answer-field/validate]} {:db/id "answer-630c2241-afa1-5bd5-9578-2f06d9c7212c" :answer/id #uuid "630c2241-afa1-5bd5-9578-2f06d9c7212c" :answer/type :answer.type/math :answer/value "125.75" :db/ensure [:answer/validate]} {:db/id 17592186209887 :tutorial/content "Recall that if $X$ is a discrete random variable, the expected value of $X$ is given by\n\n$$\n\\textrm{E}[X] = \\sum_{x} x\\cdot P(X = x).\n$$\n\nThere is an alternative method for computing $\\textrm{E}[X],$ which allows us to compute the expected value of a random variable by conditioning on another variable.  \n\nSuppose another discrete random variable $Y$ takes on a set of possible values. If we know $\\textrm{E}[X \\mid Y = y]$ for each value $y,$ then the **law of total expectation** states\n\n$$\n\\textrm{E}[X] = \\sum_{y} \\textrm{E}[X \\mid Y = y] \\cdot P(Y = y).\n$$\n\n \n\nConceptually, this tells us that $\\textrm{E}[X]$ is just a weighted average of the conditional expectations $\\textrm{E}[X \\mid Y = y],$ where each weight is the probability $P(Y = y).$  \n\nIn many problems, directly computing $\\textrm{E}[X]$ from the definition can be difficult. It turns out that breaking $\\textrm{E}[X]$ up into conditional pieces often simplifies things. The law of total expectation is especially useful when $X$ depends on an underlying condition $Y,$ and each conditional case is easier to analyze than the full distribution of $X.$\n\nLet’s see how this works in practice with a few examples." :db/ensure [:tutorial/validate]} {:db/id 17592186209888 :tutorial/content "Let $X$ and $Y$ be discrete random variables, where $Y$ takes values $\\alpha$ and $\\beta$ with probabilities $0.4$ and $0.6,$ respectively. Suppose we are given the following conditional expectations:\n\n- $\\textrm{E}[X \\mid Y = \\alpha] = 7$\n\n- $\\textrm{E}[X \\mid Y = \\beta] = 3$\n\nLet's compute $\\textrm{E}[X]$ using the law of total expectation.\n\nThe law of total expectation states\n\n$$\n\\textrm{E}[X]= \\sum_y \\textrm{E} [X \\mid Y = y] \\cdot P(Y=y).\n$$\n\nIn this problem, $Y$ takes two values:\n\n- $Y = \\alpha$ with probability $0.4,$ and $\\textrm{E}[X \\mid Y = \\alpha] = 7$\n\n- $Y = \\beta$ with probability $0.6,$ and $\\textrm{E}[X \\mid Y = \\beta] = 3$\n\nSo, we calculate our expected value as follows:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[X∣Y=\\alpha ]\\cdot P(Y=\\alpha )+\\text{E}[X∣Y=\\beta ]\\cdot P(Y=\\beta ) \\\\  & =7\\cdot 0.4+3\\cdot 0.6 \\\\  & =2.8+1.8 \\\\  & =4.6\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186209885 :tutorial/content "We’ve seen that the law of total expectation allows us to compute the expected value of a random variable $X$ by conditioning on another variable $Y.$ This idea extends naturally to a more general and elegant identity called the **tower property**:\n\n$$\n\\textrm{E}[X] = \\textrm{E}[\\textrm{E}[X \\mid Y]]\n$$\n\nAt first glance, this may look abstract, so let’s unpack what it means.\n\nThe inner term $\\textrm{E}[X \\mid Y]$ is itself a *random variable*—its value depends on the outcome of $Y.$ The outer expectation then takes the average of that conditional expectation over all possible values of $Y.$\n\nIn other words, we are averaging $X$ in two stages:\n\n- Within each scenario (for each possible value of $Y$), we find the expected value of $X.$\n\n- Across all scenarios, we take the weighted average of those conditional expectations, where the weights are the probabilities of each $Y.$\n\nLet’s explore a few examples to build some intuition." :db/ensure [:tutorial/validate]} {:db/id 17592186209955 :tutorial/content "Let $X$ and $Y$ be discrete random variables, and suppose \n\n$$\n\\textrm{E}[X \\mid Y] = \\sqrt{3}\\,Y + 1.\n$$\n\nIf $\\textrm{E}[Y] = \\sqrt3,$ let's compute $\\textrm{E}[X]$. \n\nThis is a direct application of the tower property, which states that\n\n$$\n\\textrm{E}[X] = \\textrm{E}[\\textrm{E}[X \\mid Y]].\n$$\n\nSo, we substitute the given expression for the inner expectation:\n\n$$\n\\textrm{E}[X] = \\textrm{E}\\left[\\sqrt{3}\\,Y + 1\\right]\n$$\n\nNow, we apply the linearity of expectation:\n\n$$\n\\begin{aligned}\\text{E}[X] & =\\text{E}[\\sqrt{3}\\,Y+1] \\\\  & =\\sqrt{3}\\cdot \\text{E}[Y]+\\text{E}[1] \\\\  & =\\sqrt{3}\\cdot \\sqrt{3}+1 \\\\  & =4\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186209886 :tutorial/content "Let $X$ and $Y$ be discrete random variables, and suppose $Y$ takes only two values $y_1$ and $y_2.$  We want to show that the *law of total expectation* holds in this simple case:\n\n$$\n\\mathbb{E}[X] = \\mathbb{E}[X \\mid Y = y_1] \\cdot P(Y = y_1) + \\mathbb{E}[X \\mid Y = y_2] \\cdot P(Y = y_2)\n$$\n\nWe start with the definition of expectation, given by\n\n$$\n\\textrm{E}[X] = \\sum_x x \\cdot P(X = x).\n$$\n\nNext, we express $P(X = x)$ using the law of total probability:\n\n$$\nP(X = x) = P(X = x \\mid Y = y_1) \\cdot P(Y = y_1) + P(X = x \\mid Y = y_2) \\cdot P(Y = y_2)\n$$\n\nSubstituting this expression into the expectation formula, we get\n\n$$\n\\textrm{E}[X] = \\sum_x x \\left( P(X = x \\mid Y = y_1) \\cdot P(Y = y_1) + P(X = x \\mid Y = y_2) \\cdot P(Y = y_2) \\right).\n$$\n\nWe can now distribute the sum across the two terms\n\n$$\n\\textrm{E}[X] = P(Y = y_1) \\cdot \\sum_x x \\cdot P(X = x \\mid Y = y_1) + P(Y = y_2) \\cdot \\sum_x x \\cdot P(X = x \\mid Y = y_2).\n$$\n\nBut each of the sums above is just a conditional expectation according to the definition:\n\n$$\n\\begin{aligned}{\\sum }_{x}x\\cdot P(X=x∣Y={y}_{1}) & =\\text{E}[X∣Y={y}_{1}] \\\\ {\\sum }_{x}x\\cdot P(X=x∣Y={y}_{2}) & =\\text{E}[X∣Y={y}_{2}]\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\bbox[4pt,border: 1px solid lightgray]{\\textrm{E}[X] = \\textrm{E}[X \\mid Y = y_1] \\cdot P(Y = y_1) + \\textrm{E}[X \\mid Y = y_2] \\cdot P(Y = y_2)},\n$$\n\nas required.\n\nWe can use a similar argument to prove the more general case, where $Y$ takes more than two values." :db/ensure [:tutorial/validate]} {:db/id 17592186209889 :tutorial/content "Let $X$ and $Y$ be discrete random variables. Now, we want to prove that the tower property holds:\n\n$$\n\\textrm{E}[X] = \\textrm{E}[\\textrm{E}[X \\mid Y]]\n$$\n\nWe start with the definition of expectation\n\n$$\n\\textrm{E}[X] = \\sum_x x \\cdot P(X = x).\n$$\n\nNext, we apply the law of total probability to express $P(X = x)$ in terms of $Y.$  Let $S_Y$ denote the support of $Y.$ Then, we have\n\n$$\nP(X = x) = \\sum_{y \\in S_Y} P(X = x \\mid Y = y) \\cdot P(Y = y).\n$$\n\nSubstituting this into the expectation formula, we get\n\n$$\n\\textrm{E}[X] = \\sum_x x \\left( \\sum_{y \\in S_Y} P(X = x \\mid Y = y) \\cdot P(Y = y) \\right).\n$$\n\nWe can now switch the order of summation:\n\n$$\n\\textrm{E}[X] = \\sum_{y \\in S_Y} P(Y = y) \\cdot \\sum_x x \\cdot P(X = x \\mid Y = y)\n$$\n\nEach inner sum is just the conditional expectation $\\textrm{E}[X \\mid Y = y]{:}$\n\n$$\n\\sum_x x \\cdot P(X = x \\mid Y = y) = \\textrm{E}[X \\mid Y = y]\n$$\n\nSo, we conclude that\n\n$$\n\\textrm{E}[X] = \\sum_{y \\in S_Y} \\textrm{E}[X \\mid Y = y] \\cdot P(Y = y).\n$$\n\nBut this expression is just the definition of $\\textrm{E}[\\textrm{E}[X \\mid Y]]$ for discrete $Y{:}$\n\n$$\n\\textrm{E}[\\textrm{E}[X \\mid Y]] = \\sum_{y \\in S_Y} \\textrm{E}[X \\mid Y = y] \\cdot P(Y = y)\n$$\n\nTherefore, we have shown that\n\n$$\n\\bbox[4pt,border: 1px solid lightgray]{\\textrm{E}[X] = \\textrm{E}[\\textrm{E}[X \\mid Y]]},\n$$\n\nas required." :db/ensure [:tutorial/validate]} {:db/id 17592186208871 :activity/expected-seconds 1140.0 :db/ensure [:activity/validate]} [:db/retract 17592186173356 :answer-field/choices 17592186173360] [:db/retract 17592186173356 :answer-field/choices 17592186173361] [:db/retract 17592186173356 :answer-field/choices 17592186173357] [:db/retract 17592186173356 :answer-field/choices 17592186173358] [:db/retract 17592186173356 :answer-field/choices 17592186173359] [:db/retract 17592186173344 :answer-field/choices 17592186173345] [:db/retract 17592186173344 :answer-field/choices 17592186173346] [:db/retract 17592186173344 :answer-field/choices 17592186173347] [:db/retract 17592186173344 :answer-field/choices 17592186173348] [:db/retract 17592186173344 :answer-field/choices 17592186173349] {:db/id 17592186175965 :knowledge-point/questions ["question-c3cbf898-5adf-5f1a-9995-178ecdb7db19"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175964 :knowledge-point/questions ["question-551dfc8f-f76b-5f91-a118-1f244aa7dd9d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186176183 :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nThe picture shows a half-plane that passes through the $z$-axis.\n\nWe note the following:\n\n- If we project the vector $\\overset{\\to }{OP}$ onto the $xy$-plane for every point $P$ on our surface, the resulting vector makes an angle of $\\frac{3\\pi }{4}$ radians with the positive $x$-axis. Therefore, we must have $\\theta =\\frac{3\\pi }{4}$ for every point on the surface.\n\n- On the other hand, $r$ and $z$ can vary arbitrarily in their respective domains.\n\nTherefore, the equation of the surface in cylindrical polar coordinates is $\\theta =\\frac{3\\pi }{4}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186173356 :answer-field/correct "answer-512b2ea2-fe9f-5ade-94ba-871fe79bc1dd" :answer-field/choices ["answer-512b2ea2-fe9f-5ade-94ba-871fe79bc1dd" "answer-5f2b5748-e93c-53e6-b8d6-7858d08f9e65" "answer-c6920658-ee40-5a48-9dcd-8b4279bf49cd" "answer-cd369482-28aa-59a2-9a88-ad4bba8c178b" "answer-f4a77681-2f5f-5479-9783-fbd5472acd0d"] :db/ensure [:answer-field/validate]} {:db/id "answer-512b2ea2-fe9f-5ade-94ba-871fe79bc1dd" :answer/id #uuid "512b2ea2-fe9f-5ade-94ba-871fe79bc1dd" :answer/type :answer.type/math :answer/value "\\theta =\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-5f2b5748-e93c-53e6-b8d6-7858d08f9e65" :answer/id #uuid "5f2b5748-e93c-53e6-b8d6-7858d08f9e65" :answer/type :answer.type/math :answer/value "r=\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-c6920658-ee40-5a48-9dcd-8b4279bf49cd" :answer/id #uuid "c6920658-ee40-5a48-9dcd-8b4279bf49cd" :answer/type :answer.type/math :answer/value "r=\\frac{3\\pi }{4}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-cd369482-28aa-59a2-9a88-ad4bba8c178b" :answer/id #uuid "cd369482-28aa-59a2-9a88-ad4bba8c178b" :answer/type :answer.type/math :answer/value "z=\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-f4a77681-2f5f-5479-9783-fbd5472acd0d" :answer/id #uuid "f4a77681-2f5f-5479-9783-fbd5472acd0d" :answer/type :answer.type/math :answer/value "z=\\frac{3\\pi }{4}r" :db/ensure [:answer/validate]} {:db/id "question-c3cbf898-5adf-5f1a-9995-178ecdb7db19" :question/id #uuid "c3cbf898-5adf-5f1a-9995-178ecdb7db19" :question/math-academy-id "q-104215" :question/problem "![](images/aa/aa9c640445da2c47bfabe3afe2cacb2acd2e67e42e052260c1cdf87d5c81dd16.png)\n\nWhat is the equation of the surface shown above in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nThe picture shows a plane parallel to the $xy$-plane.\n\nWe note the following:\n\n- Since the $z$-coordinate of any point on our surface equals $2,$ we must have $z=2$ for every point on the surface.\n\n- On the other hand, $r$ and $\\theta $ can vary arbitrarily in their respective domains.\n\nTherefore, the equation of the surface in cylindrical polar coordinates is $z=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eec87c06-1424-53ca-8b89-733ac02a4134"] :db/ensure [:question/validate]} {:db/id "answer-field-eec87c06-1424-53ca-8b89-733ac02a4134" :answer-field/id #uuid "eec87c06-1424-53ca-8b89-733ac02a4134" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a94290f-98e5-538b-88a7-84b262939c36" :answer-field/choices ["answer-29e07412-d0e9-5ae8-8ad1-748ceef740cc" "answer-9da22ad6-f488-541a-ac66-1696c379c229" "answer-595ab2be-e9eb-5ded-b620-4edd28bb1e03" "answer-6a94290f-98e5-538b-88a7-84b262939c36" "answer-5f044123-a8a0-5602-b399-1d79a30d86e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-29e07412-d0e9-5ae8-8ad1-748ceef740cc" :answer/id #uuid "29e07412-d0e9-5ae8-8ad1-748ceef740cc" :answer/type :answer.type/math :answer/value "\\theta =2" :db/ensure [:answer/validate]} {:db/id "answer-9da22ad6-f488-541a-ac66-1696c379c229" :answer/id #uuid "9da22ad6-f488-541a-ac66-1696c379c229" :answer/type :answer.type/math :answer/value "r=2" :db/ensure [:answer/validate]} {:db/id "answer-595ab2be-e9eb-5ded-b620-4edd28bb1e03" :answer/id #uuid "595ab2be-e9eb-5ded-b620-4edd28bb1e03" :answer/type :answer.type/math :answer/value "r=2\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6a94290f-98e5-538b-88a7-84b262939c36" :answer/id #uuid "6a94290f-98e5-538b-88a7-84b262939c36" :answer/type :answer.type/math :answer/value "z=2" :db/ensure [:answer/validate]} {:db/id "answer-5f044123-a8a0-5602-b399-1d79a30d86e9" :answer/id #uuid "5f044123-a8a0-5602-b399-1d79a30d86e9" :answer/type :answer.type/math :answer/value "z=2r" :db/ensure [:answer/validate]} {:db/id 17592186176181 :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nThe picture shows a circular cylinder of radius $2$ whose axis of symmetry is the $z$-axis. \n\nWe note the following:\n\n- Since the distance from any point on our surface to the $z$-axis equals $2,$ we must have $r=2$ for every point on the surface.\n\n- On the other hand, $\\theta $ and $z$ can vary arbitrarily in their respective domains.\n\nTherefore, the equation of the surface in cylindrical polar coordinates is $r=2.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186173344 :answer-field/correct "answer-b812992c-f07e-5745-9a41-fea0b28b40cc" :answer-field/choices ["answer-6d164487-038d-5218-a8fa-7cb3e5107422" "answer-b812992c-f07e-5745-9a41-fea0b28b40cc" "answer-d6e1ba05-7141-5ea0-a14e-963f9c6cd051" "answer-8542ccd9-23dd-5765-a94e-840c7ad39c64" "answer-fac9d7d8-a84e-580e-ae35-eeca7e829078"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d164487-038d-5218-a8fa-7cb3e5107422" :answer/id #uuid "6d164487-038d-5218-a8fa-7cb3e5107422" :answer/type :answer.type/math :answer/value "\\theta =2" :db/ensure [:answer/validate]} {:db/id "answer-b812992c-f07e-5745-9a41-fea0b28b40cc" :answer/id #uuid "b812992c-f07e-5745-9a41-fea0b28b40cc" :answer/type :answer.type/math :answer/value "r=2" :db/ensure [:answer/validate]} {:db/id "answer-d6e1ba05-7141-5ea0-a14e-963f9c6cd051" :answer/id #uuid "d6e1ba05-7141-5ea0-a14e-963f9c6cd051" :answer/type :answer.type/math :answer/value "r=\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8542ccd9-23dd-5765-a94e-840c7ad39c64" :answer/id #uuid "8542ccd9-23dd-5765-a94e-840c7ad39c64" :answer/type :answer.type/math :answer/value "z=2" :db/ensure [:answer/validate]} {:db/id "answer-fac9d7d8-a84e-580e-ae35-eeca7e829078" :answer/id #uuid "fac9d7d8-a84e-580e-ae35-eeca7e829078" :answer/type :answer.type/math :answer/value "z=r" :db/ensure [:answer/validate]} {:db/id "question-551dfc8f-f76b-5f91-a118-1f244aa7dd9d" :question/id #uuid "551dfc8f-f76b-5f91-a118-1f244aa7dd9d" :question/math-academy-id "q-104220" :question/problem "What surface is defined by the equation $z=5$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\nz=5\n$$\n\nThis equation requires that $z$-coordinate of any point on our surface equals $5,$ while $r$ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, our surface is the plane that is parallel to the $xy$-plane shown below.\n\n![](images/c3/c35b6843ace65d2261f0910fbeae0e64383e7e325e3b851652b3aa421e311094.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9c518635-0c5f-53f1-859a-07dce84e6973"] :db/ensure [:question/validate]} {:db/id "answer-field-9c518635-0c5f-53f1-859a-07dce84e6973" :answer-field/id #uuid "9c518635-0c5f-53f1-859a-07dce84e6973" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-20fe3ec3-bc53-5c80-9e89-9706d893e03d" :answer-field/choices ["answer-108b5145-cf65-5f4e-bd52-963d550d5e85" "answer-54459e1a-bb0e-53b0-8a77-fadde33848ca" "answer-1747e7eb-cf9b-5ba9-9a08-cbcaf9935d6c" "answer-20fe3ec3-bc53-5c80-9e89-9706d893e03d" "answer-50999f61-cf78-5456-95b9-cf36c034e670"] :db/ensure [:answer-field/validate]} {:db/id "answer-108b5145-cf65-5f4e-bd52-963d550d5e85" :answer/id #uuid "108b5145-cf65-5f4e-bd52-963d550d5e85" :answer/type :answer.type/text :answer/value "A circular cylinder" :db/ensure [:answer/validate]} {:db/id "answer-54459e1a-bb0e-53b0-8a77-fadde33848ca" :answer/id #uuid "54459e1a-bb0e-53b0-8a77-fadde33848ca" :answer/type :answer.type/text :answer/value "A half-cone" :db/ensure [:answer/validate]} {:db/id "answer-1747e7eb-cf9b-5ba9-9a08-cbcaf9935d6c" :answer/id #uuid "1747e7eb-cf9b-5ba9-9a08-cbcaf9935d6c" :answer/type :answer.type/text :answer/value "A half-plane that passes through the $z$-axis" :db/ensure [:answer/validate]} {:db/id "answer-20fe3ec3-bc53-5c80-9e89-9706d893e03d" :answer/id #uuid "20fe3ec3-bc53-5c80-9e89-9706d893e03d" :answer/type :answer.type/text :answer/value "A plane that is parallel to the $xy$-plane" :db/ensure [:answer/validate]} {:db/id "answer-50999f61-cf78-5456-95b9-cf36c034e670" :answer/id #uuid "50999f61-cf78-5456-95b9-cf36c034e670" :answer/type :answer.type/text :answer/value "A sphere" :db/ensure [:answer/validate]} {:db/id 17592186176973 :tutorial/content "In a rectangular (or Cartesian) system of coordinates, we can think of a point as the vertex of a rectangular solid. For instance, the point $P(1,\\sqrt3,3)$ can be represented as follows:\n\n![](images/47/47873274f1cc630a8275b3ef2f83210b3d16a4f3d0acabeae9dbda32844a9adf.png)\n\n \n\nWhen we consider the corresponding cylindrical coordinates of $P,$ given by $\\left(2, \\dfrac{\\pi}3, 3\\right)$ in this case, we can think of $P$ as a point that lies on the edge of a cylinder, as shown below.\n\n![](images/9f/9fefa7c5fac5cac803fdebeaa9eab4233d723b452d2ee8dc17151d992064223f.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186176986 :tutorial/content "What surface is defined by the equation $z^2=r^2$ in cylindrical polar coordinates?\n\nAgain, recall that for a point $(r,\\theta,z)$ in cylindrical polar coordinates,\n\n- $r\\geq 0$ and $\\theta\\in [0,2\\pi)$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty, \\infty)$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\nz^2=r^2\n$$\n\nThis equation requires that the square of the distance from any point on the surface to the $xy$-plane equals the square of the distance from that point to the $z$-axis.\nIn other words, the tangent of the angle between any position vector on the surface and the $z$-axis, which is given by $\\dfrac{r}{z}$, must be equal to\n\n$$\n\\dfrac{r}{z} =\\pm \\sqrt{\\dfrac{r^2}{z^2}} = \\pm\\sqrt{\\dfrac{r^2}{r^2}} = \\pm1.\n$$\n\nOn the other hand, $\\theta$ can vary arbitrarily in its domain. \n\n- For $\\dfrac{r}{z} = 1,$ the angle between the position vector of any point on the surface and the $z$-axis must be equal $\\dfrac{\\pi}{4}.$ This corresponds to a *half-cone* for positive $z{:}$\n\n![](images/18/1841d50bb07c0e6787f4824af0e13516912fb9ad77fac0515f00c243899eb18e.png)\n\n \n\n- On the other hand, for $\\dfrac{r}{z} = -1,$ the angle between the position vector of any point on the surface and the $z$-axis must be equal $\\dfrac{3\\pi}{4}.$ This corresponds to a *half-cone* for negative $z{:}$\n\n![](images/e3/e32b1b4ba84faea7a4dc536e0f49bcda9295a4a42790162b3b9bad06db39a908.png)\n\nTherefore, combining the two half cones, the equation $z^2 = r^2$ defines the *cone* shown below.\n\n![](images/84/842f8cf967d10144e568804bdfb1aadf75f029cf87dd7b6785168a44a95d0615.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186176987 :tutorial/content "So far, we have kept the domains of the plane polar coordinates restricted to $r\\geq 0$ and $\\theta\\in [0,2\\pi).$ What happens if we lift these restrictions?\n\nConsider the equation $r=\\theta$ with the domain restrictions $r\\geq 0$ and $\\theta\\in [0,2\\pi)$ which defines the surface shown below.\n\n![](images/84/84737b12a1689fe2ac03ab09572e4c396d35493f55df5d65af80eeb8c5ae5676.png)\n\nSuppose we remove the restriction $\\theta\\in[0,2\\pi)$ so that it can be any number. What would the surface look like then?\n\nIf we remove the restriction on $\\theta,$ we obtain more spirals. For example, the diagram below shows $r=\\theta$ for $\\theta \\in [0, 4\\pi).$\n\n![](images/56/568291daf47340265d97a121f0b7b927233f2698e87e0d5adebbba640ff20afe.png)\n\nWe can also lift the restriction $r \\geq 0$ so $r$ can take negative values. Typically, allowing negative values of $r$ adds $\\pi$ to the parameter $\\theta.$ So, we have\n![](images/c0/c0094460f4c74bc17c4bf3b02497b636f01cfaf9e9a48b7f6f746d0069353e82.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186176119 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-bb3101b4-4787-5bac-a3dd-30e1339ef299" :activity/id #uuid "bb3101b4-4787-5bac-a3dd-30e1339ef299" :activity/title "Lagrange Multipliers With One Constraint" :activity/type :activity.type/review :activity/scope 17592186049390 :activity/course 17592186046658 :activity/steps ["step-369bfa0b-6a9e-5002-b279-fe1b70b8fbbc" "step-e5502470-ff5a-5e08-b59d-88209eac09b9" "step-bdda49a4-b175-5f91-b4c7-25153ee6cd44" "step-504a3430-1fcb-5302-9b1d-01fccb6cfb91" "step-1cec84f6-1985-5992-8045-b17621c4fe6b"] :activity/first-step "step-369bfa0b-6a9e-5002-b279-fe1b70b8fbbc" :db/ensure [:activity/validate]} {:db/id "step-369bfa0b-6a9e-5002-b279-fe1b70b8fbbc" :step/id #uuid "369bfa0b-6a9e-5002-b279-fe1b70b8fbbc" :step/content 17592186125264 :step/next "step-e5502470-ff5a-5e08-b59d-88209eac09b9" :db/ensure [:step/validate]} {:db/id "step-e5502470-ff5a-5e08-b59d-88209eac09b9" :step/id #uuid "e5502470-ff5a-5e08-b59d-88209eac09b9" :step/content 17592186124816 :step/next "step-bdda49a4-b175-5f91-b4c7-25153ee6cd44" :db/ensure [:step/validate]} {:db/id "step-bdda49a4-b175-5f91-b4c7-25153ee6cd44" :step/id #uuid "bdda49a4-b175-5f91-b4c7-25153ee6cd44" :step/content 17592186124817 :step/next "step-504a3430-1fcb-5302-9b1d-01fccb6cfb91" :db/ensure [:step/validate]} {:db/id "step-504a3430-1fcb-5302-9b1d-01fccb6cfb91" :step/id #uuid "504a3430-1fcb-5302-9b1d-01fccb6cfb91" :step/content 17592186365213 :step/next "step-1cec84f6-1985-5992-8045-b17621c4fe6b" :db/ensure [:step/validate]} {:db/id "step-1cec84f6-1985-5992-8045-b17621c4fe6b" :step/id #uuid "1cec84f6-1985-5992-8045-b17621c4fe6b" :step/content 17592186365226 :db/ensure [:step/validate]} {:db/id 17592186087823 :knowledge-point/questions ["question-6bfc4a3c-5e7b-532b-95bd-4e49a1efa533" "question-be426e06-620a-5f1c-9841-393e8911826d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087824 :knowledge-point/questions ["question-33e5e3ff-cf8e-5556-9914-9fd8f6506ea2" "question-8412e9ee-2ea9-5393-944f-a1233b5c49f8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186088107 :question/problem "Which of the following is the graph of $y={8}^{x}+0.5?$" :question/worked-solution "First, we plot the graph of $y={8}^{x}:$\n\n![](images/d1/d1d90ab26cf9c3939b355a781b2192f962204b077b990b6a142db642a1316f4f.png)\n\nTo sketch the graph of $y={8}^{x}+0.5,$ we take the graph of $y={8}^{x}$ and shift it $0.5$ units up. The $y$-intercept moves from $(0,1)$ to $(0,1.5),$ and the horizontal asymptote moves from $y=0$ to $y=0.5.$\n\n![](images/45/452f0482708656146b2e5cd7f58832250fc95e25707cacb66800255aee977b21.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186085290 :answer-field/correct 17592186085294 :db/ensure [:answer-field/validate]} {:db/id "question-6bfc4a3c-5e7b-532b-95bd-4e49a1efa533" :question/id #uuid "6bfc4a3c-5e7b-532b-95bd-4e49a1efa533" :question/math-academy-id "q-26914" :question/problem "Which of the following is the graph of $y=4({2}^{x})+4?$" :question/worked-solution "First, we plot the graph of $y={2}^{x}:$\n\n![](images/6d/6d5b359544227b89d1dc5ca9967c9dfcda84bf5345184063a1d0deef994c3692.png)\n\nNext, we plot the graph of $y=4({2}^{x}).$ To do this, we scale the graph above by a factor of $4.$ The $y$-intercept moves from $(0,1)$ to $(0,4),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/86/86b10c71101ae46d4c99335874eb3cd75abc416c0d9a3b4552f6f6a52644aa2f.png)\n\nFinally, we plot the graph of $y=4({2}^{x})+4.$ To do this, we shift the above graph $4$ units up. The $y$-intercept moves from $(0,4)$ to $(0,8),$ and the horizontal asymptote moves from $y=0$ to $y=4.$\n\n![](images/05/052daab57bdb99d53853e8d7d2cc7a059f9f24f715b1340857407d5a44c68acd.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eaab585b-caae-5298-a3ee-f10042b952cf"] :db/ensure [:question/validate]} {:db/id "answer-field-eaab585b-caae-5298-a3ee-f10042b952cf" :answer-field/id #uuid "eaab585b-caae-5298-a3ee-f10042b952cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0586aaf8-5b17-5e90-a5da-6384fff65d77" :answer-field/choices ["answer-0586aaf8-5b17-5e90-a5da-6384fff65d77" "answer-ecdb1675-ded2-5d85-bf36-c30f6bad3b9d" "answer-200914d3-6a9d-52ed-b42e-4c7f306d6701" "answer-62bc53be-cfce-539e-8c16-62df3a417995" "answer-793b9e2c-b5e0-5f42-a1eb-e1c2d16e9f0a"] :db/ensure [:answer-field/validate]} {:db/id "answer-0586aaf8-5b17-5e90-a5da-6384fff65d77" :answer/id #uuid "0586aaf8-5b17-5e90-a5da-6384fff65d77" :answer/type :answer.type/image :answer/value "images/05/052daab57bdb99d53853e8d7d2cc7a059f9f24f715b1340857407d5a44c68acd.png" :db/ensure [:answer/validate]} {:db/id "answer-ecdb1675-ded2-5d85-bf36-c30f6bad3b9d" :answer/id #uuid "ecdb1675-ded2-5d85-bf36-c30f6bad3b9d" :answer/type :answer.type/image :answer/value "images/07/07d639972162c1601c0fa094f874a82b85fdeb22f58cdb15d92c9268ac0d2aca.png" :db/ensure [:answer/validate]} {:db/id "answer-200914d3-6a9d-52ed-b42e-4c7f306d6701" :answer/id #uuid "200914d3-6a9d-52ed-b42e-4c7f306d6701" :answer/type :answer.type/image :answer/value "images/32/32a5e6e0c5c6efc2eb44f67d208c1abbe43dfeb86a30b1fbcd77388268766351.png" :db/ensure [:answer/validate]} {:db/id "answer-62bc53be-cfce-539e-8c16-62df3a417995" :answer/id #uuid "62bc53be-cfce-539e-8c16-62df3a417995" :answer/type :answer.type/image :answer/value "images/ea/ea936fd09ea4fca3ccd90d07bc3d1b5710629f3907fdc3d3185e708ff0919a6d.png" :db/ensure [:answer/validate]} {:db/id "answer-793b9e2c-b5e0-5f42-a1eb-e1c2d16e9f0a" :answer/id #uuid "793b9e2c-b5e0-5f42-a1eb-e1c2d16e9f0a" :answer/type :answer.type/image :answer/value "images/f1/f1b7d59439cf1a272795815cb8f8e0b6dd0f5ea45038d4cb34bbdf368db9539c.png" :db/ensure [:answer/validate]} {:db/id "question-be426e06-620a-5f1c-9841-393e8911826d" :question/id #uuid "be426e06-620a-5f1c-9841-393e8911826d" :question/math-academy-id "q-26915" :question/problem "Which of the following is the graph of $y=6({5}^{x})+4?$" :question/worked-solution "First, we plot the graph of $y={5}^{x}:$\n\n![](images/84/8490920052778795ca03072fd0a6933b4abc5756f2e75ae9f61863d3726dd5c8.png)\n\nNext, we plot the graph of $y=6({5}^{x}).$ To do this, we scale the graph above by a factor of $6.$ The $y$-intercept moves from $(0,1)$ to $(0,6),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/b5/b5deca2c07bc8c8a5e58c28a6ca2449268999a54b21407380ae168aafabd7a5d.png)\n\nFinally, we plot the graph of $y=6({5}^{x})+4.$ To do this, we shift the above graph $4$ units up. The $y$-intercept moves from $(0,6)$ to $(0,10),$ and the horizontal asymptote moves from $y=0$ to $y=4.$\n\n![](images/57/57ac1f2daa7ee44b5cf9fbd2d4c9ce8a25edc3a3053af4d9164b7f8e83b9e00f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a15d6ff2-97c9-5cc7-84c4-220104b8fcdc"] :db/ensure [:question/validate]} {:db/id "answer-field-a15d6ff2-97c9-5cc7-84c4-220104b8fcdc" :answer-field/id #uuid "a15d6ff2-97c9-5cc7-84c4-220104b8fcdc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-70ff0af0-9e57-50f8-8391-0720265b0dcc" :answer-field/choices ["answer-93c0a0ea-146f-5cdb-a4df-6753aab6927f" "answer-70ff0af0-9e57-50f8-8391-0720265b0dcc" "answer-3cd4c895-f750-5a06-9cea-e6f503cc0670" "answer-165e4770-3b92-5d99-9106-610397e6128e" "answer-48db64b8-d987-5b2a-8b10-92b11a967cb4"] :db/ensure [:answer-field/validate]} {:db/id "answer-93c0a0ea-146f-5cdb-a4df-6753aab6927f" :answer/id #uuid "93c0a0ea-146f-5cdb-a4df-6753aab6927f" :answer/type :answer.type/image :answer/value "images/08/08572884c3dc95c13b37b2044fac25d9da663e79f9b71fc92fbc7e227e1a3360.png" :db/ensure [:answer/validate]} {:db/id "answer-70ff0af0-9e57-50f8-8391-0720265b0dcc" :answer/id #uuid "70ff0af0-9e57-50f8-8391-0720265b0dcc" :answer/type :answer.type/image :answer/value "images/57/57ac1f2daa7ee44b5cf9fbd2d4c9ce8a25edc3a3053af4d9164b7f8e83b9e00f.png" :db/ensure [:answer/validate]} {:db/id "answer-3cd4c895-f750-5a06-9cea-e6f503cc0670" :answer/id #uuid "3cd4c895-f750-5a06-9cea-e6f503cc0670" :answer/type :answer.type/image :answer/value "images/77/7763b1d82df8d07d26911327ea4f900764c83ea632a654d84a0adab7f47f3ad1.png" :db/ensure [:answer/validate]} {:db/id "answer-165e4770-3b92-5d99-9106-610397e6128e" :answer/id #uuid "165e4770-3b92-5d99-9106-610397e6128e" :answer/type :answer.type/image :answer/value "images/a3/a3daf867442355a2c0d77796f4c0c663c885a63012a758b9f99cfa2ef1ed2aca.png" :db/ensure [:answer/validate]} {:db/id "answer-48db64b8-d987-5b2a-8b10-92b11a967cb4" :answer/id #uuid "48db64b8-d987-5b2a-8b10-92b11a967cb4" :answer/type :answer.type/image :answer/value "images/dd/dd405f0b3fde6b4fa4128afec90dba1508935e1544a57f642c70809843d9b220.png" :db/ensure [:answer/validate]} {:db/id "question-33e5e3ff-cf8e-5556-9914-9fd8f6506ea2" :question/id #uuid "33e5e3ff-cf8e-5556-9914-9fd8f6506ea2" :question/math-academy-id "q-30282" :question/problem "![](images/9a/9a448574651a74ef7180549827e05ee2d790cd9fa89c6c85adf08d8444ceaadf.png)\n\nThe graph above shows $y=k({10}^{x})+c.$ Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({10}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-3,$ so $c=-3.$\n\nTherefore, our function takes the form\n\n$$\ny=k({10}^{x})-3.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,1),$ so we substitute $x=0$ and $y=1$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({10}^{x})-3 \\\\ 1 & =k({10}^{0})-3 \\\\ 1 & =k(1)-3 \\\\ 1 & =k-3 \\\\ 4 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=4({10}^{x})-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c65486dd-75a5-525a-b8ec-541d0f93ec2e"] :db/ensure [:question/validate]} {:db/id "answer-field-c65486dd-75a5-525a-b8ec-541d0f93ec2e" :answer-field/id #uuid "c65486dd-75a5-525a-b8ec-541d0f93ec2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-38db0a76-5e16-5aba-bb93-35df5dab3d97" :answer-field/choices ["answer-b47e9017-f47b-5637-b27e-af639f76e073" "answer-38db0a76-5e16-5aba-bb93-35df5dab3d97" "answer-0b8870de-643a-5fb2-8463-3f97e48224cb" "answer-807ef638-7e9d-572d-846b-e9a5c5315681" "answer-620577fa-0f5e-5e33-9265-a1ff721c4a72"] :db/ensure [:answer-field/validate]} {:db/id "answer-b47e9017-f47b-5637-b27e-af639f76e073" :answer/id #uuid "b47e9017-f47b-5637-b27e-af639f76e073" :answer/type :answer.type/math :answer/value "y=4({10}^{x})+3" :db/ensure [:answer/validate]} {:db/id "answer-38db0a76-5e16-5aba-bb93-35df5dab3d97" :answer/id #uuid "38db0a76-5e16-5aba-bb93-35df5dab3d97" :answer/type :answer.type/math :answer/value "y=4({10}^{x})-3" :db/ensure [:answer/validate]} {:db/id "answer-0b8870de-643a-5fb2-8463-3f97e48224cb" :answer/id #uuid "0b8870de-643a-5fb2-8463-3f97e48224cb" :answer/type :answer.type/math :answer/value "y=\\frac{1}{4}({10}^{x})-3" :db/ensure [:answer/validate]} {:db/id "answer-807ef638-7e9d-572d-846b-e9a5c5315681" :answer/id #uuid "807ef638-7e9d-572d-846b-e9a5c5315681" :answer/type :answer.type/math :answer/value "y={10}^{x}+3" :db/ensure [:answer/validate]} {:db/id "answer-620577fa-0f5e-5e33-9265-a1ff721c4a72" :answer/id #uuid "620577fa-0f5e-5e33-9265-a1ff721c4a72" :answer/type :answer.type/math :answer/value "y={10}^{x}-3" :db/ensure [:answer/validate]} {:db/id "question-8412e9ee-2ea9-5393-944f-a1233b5c49f8" :question/id #uuid "8412e9ee-2ea9-5393-944f-a1233b5c49f8" :question/math-academy-id "q-18519" :question/problem "![](images/95/9507e060ddd7de93489b236b48856870e2c884eba69f63ac67662dfd1c061c17.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=1,$ so $c=1.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})+1.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,3.5),$ so we substitute $x=0$ and $y=3.5$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})+1 \\\\ 3.5 & =k({2}^{0})+1 \\\\ 3.5 & =k(1)+1 \\\\ 3.5 & =k+1 \\\\ 2.5 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=2.5({2}^{x})+1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d29ba8d5-82d0-52b6-939b-119fe78d8db4"] :db/ensure [:question/validate]} {:db/id "answer-field-d29ba8d5-82d0-52b6-939b-119fe78d8db4" :answer-field/id #uuid "d29ba8d5-82d0-52b6-939b-119fe78d8db4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-71407824-a8ad-5e1e-b6fe-b9ba8075671b" :answer-field/choices ["answer-e50c8d48-2425-5e73-bd1c-d2a842248e31" "answer-b1e9d21b-a213-54e5-93ab-0172b47154ba" "answer-4b2740d1-15f5-5c10-9d5d-f42781190300" "answer-71407824-a8ad-5e1e-b6fe-b9ba8075671b" "answer-40cd7eb5-26eb-5f47-9864-d179eee20251"] :db/ensure [:answer-field/validate]} {:db/id "answer-e50c8d48-2425-5e73-bd1c-d2a842248e31" :answer/id #uuid "e50c8d48-2425-5e73-bd1c-d2a842248e31" :answer/type :answer.type/math :answer/value "y=0.5({2}^{x})+1" :db/ensure [:answer/validate]} {:db/id "answer-b1e9d21b-a213-54e5-93ab-0172b47154ba" :answer/id #uuid "b1e9d21b-a213-54e5-93ab-0172b47154ba" :answer/type :answer.type/math :answer/value "y=1.5({2}^{x})+1" :db/ensure [:answer/validate]} {:db/id "answer-4b2740d1-15f5-5c10-9d5d-f42781190300" :answer/id #uuid "4b2740d1-15f5-5c10-9d5d-f42781190300" :answer/type :answer.type/math :answer/value "y=1.5({2}^{x})+2" :db/ensure [:answer/validate]} {:db/id "answer-71407824-a8ad-5e1e-b6fe-b9ba8075671b" :answer/id #uuid "71407824-a8ad-5e1e-b6fe-b9ba8075671b" :answer/type :answer.type/math :answer/value "y=2.5({2}^{x})+1" :db/ensure [:answer/validate]} {:db/id "answer-40cd7eb5-26eb-5f47-9864-d179eee20251" :answer/id #uuid "40cd7eb5-26eb-5f47-9864-d179eee20251" :answer/type :answer.type/math :answer/value "y=2.5({2}^{x})-2" :db/ensure [:answer/validate]} {:db/id 17592186088868 :tutorial/content "Adding a value to $y=2^x$ will **translate** (shift) the exponential function up or down the $y$-axis. \n\nFor instance, adding $3$ to $y=2^x$ will move each point on the exponential function $3$ units up.\n\n![](images/c8/c89fd5fdcdc3773143a5f14ecb20f5bd2917bce20ece18a7dc70631bf358a0e8.png)\n\nNote the following points:\n\n1\\. The $y$-intercept $(0,1)$ has moved up $3$ units to the point $(0,4).$\n\n2\\. The horizontal asymptote $y=0$ has moved up $3$ units to $y=3.$\n\nAs a second example, let's consider the function $y=2^x-3.$ In this case, the graph of $y=2^x$ is shifted *down* by $3$ units.\n\n![](images/84/84987b3e9138a2e7e8afe70a7aa28a1cd81e081033aa2a766773e63cb8f41da5.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186087901 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186166890 :knowledge-point/questions ["question-957651b3-45e4-5a93-853b-1785322d0942"] :db/ensure [:knowledge-point/validate]} {:db/id "question-957651b3-45e4-5a93-853b-1785322d0942" :question/id #uuid "957651b3-45e4-5a93-853b-1785322d0942" :question/math-academy-id "q-138022" :question/problem "Find the maximum value of $Q(x)={x}_{1}^{2}-{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "First, notice that ${x}_{2}^{2}\\ge 0.$ So, we have that\n\n$$\n-{x}_{2}^{2}\\le {x}_{2}^{2}.\n$$\n\nAs a result,  \n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-{x}_{2}^{2} \\\\  & \\le {x}_{1}^{2}+{x}_{2}^{2} \\\\  & ={x}_{1}^{2}+{x}_{2}^{2}.\\end{aligned}\n$$\n\nNow, recall that $‖x‖=1$ is equivalent to ${x}_{1}^{2}+{x}_{2}^{2}=1.$ So,  in turn, $Q(x)\\le 1.$\n\nSo, the value of $Q(x)$ can be no greater than $1.$ But before we conclude that $1$ is the maximum, we need to find a vector such that $Q(x)=1.$\n\nNotice that when $x={[\\begin{aligned}1 & 0\\end{aligned}]}^{T},$ we get\n\n$$\n\\begin{aligned}Q(x) & ={x}_{1}^{2}-{x}_{2}^{2} \\\\  & =(1)^{2}-(0)^{2} \\\\  & =1.\\end{aligned}\n$$\n\n \n\nTherefore, given that $‖x‖=1,$ the maximum value of $Q(x)$ is equal to $1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-90167cb7-250b-5746-b04f-a31c7f3561cb"] :db/ensure [:question/validate]} {:db/id "answer-field-90167cb7-250b-5746-b04f-a31c7f3561cb" :answer-field/id #uuid "90167cb7-250b-5746-b04f-a31c7f3561cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7cc3c5b6-4c5a-5c36-a2ed-e4ddbb6fc109" :answer-field/choices ["answer-216c258d-237e-56bc-84d0-723783afd364" "answer-c5f228cb-9e36-5dd9-b182-62125ce92bee" "answer-5f0626f9-e9e4-50c5-b013-a1beded68ff5" "answer-7cc3c5b6-4c5a-5c36-a2ed-e4ddbb6fc109" "answer-c8ebcb55-7a36-5694-83c4-9fdbd78afeec"] :db/ensure [:answer-field/validate]} {:db/id "answer-216c258d-237e-56bc-84d0-723783afd364" :answer/id #uuid "216c258d-237e-56bc-84d0-723783afd364" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-c5f228cb-9e36-5dd9-b182-62125ce92bee" :answer/id #uuid "c5f228cb-9e36-5dd9-b182-62125ce92bee" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-5f0626f9-e9e4-50c5-b013-a1beded68ff5" :answer/id #uuid "5f0626f9-e9e4-50c5-b013-a1beded68ff5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-7cc3c5b6-4c5a-5c36-a2ed-e4ddbb6fc109" :answer/id #uuid "7cc3c5b6-4c5a-5c36-a2ed-e4ddbb6fc109" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-c8ebcb55-7a36-5694-83c4-9fdbd78afeec" :answer/id #uuid "c8ebcb55-7a36-5694-83c4-9fdbd78afeec" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186166892 :knowledge-point/questions ["question-3e4f6268-3e58-5684-9bea-f874fd53aaf3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3e4f6268-3e58-5684-9bea-f874fd53aaf3" :question/id #uuid "3e4f6268-3e58-5684-9bea-f874fd53aaf3" :question/math-academy-id "q-138069" :question/problem "Find the minimum value of $Q(x)=-{x}_{1}^{2}+4{x}_{1}{x}_{2}+2{x}_{2}^{2}$ given that $‖x‖=1.$" :question/worked-solution "Let $A$ be the matrix corresponding to our quadratic form. Recall that: \n\n- The maximum value of $Q(x),$ when $‖x‖=1,$ is equal to the largest eigenvalue of $A:$\n\n$$\nmax\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{max}}\n$$\n\n- The minimum value of $Q(x),$ when $‖x‖=1,$ is equal to the smallest eigenvalue of $A:$\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}={\\lambda }_{\\text{min}}\n$$\n\nFirst, we write down the matrix of our quadratic form:\n\n$$\nA=[\\begin{aligned}-1 & 2 \\\\ 2 & 2\\end{aligned}]\n$$\n\nNow, we need to calculate the eigenvalues of the matrix $A:$\n\n$$\n\\begin{aligned}|A-\\lambda I| & =0 \\\\ |\\begin{aligned}-1-\\lambda  & 2 \\\\ 2 & 2-\\lambda \\end{aligned}| & =0 \\\\ (-1-\\lambda )(2-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-\\lambda -6 & =0 \\\\ (\\lambda +2)(\\lambda -3) & =0 \\\\ \\lambda  & =-2,\\,3\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nmin\\{Q(x)\\,|\\,‖x‖=1\\}=-2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-55b2d835-40d6-572d-8824-c8db3cfc4a3b"] :db/ensure [:question/validate]} {:db/id "answer-field-55b2d835-40d6-572d-8824-c8db3cfc4a3b" :answer-field/id #uuid "55b2d835-40d6-572d-8824-c8db3cfc4a3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-30d37de0-fa9a-528c-821a-0e1cbd836c93" :answer-field/choices ["answer-95163aca-07b5-596d-b2dd-ec7271cff2ed" "answer-30d37de0-fa9a-528c-821a-0e1cbd836c93" "answer-b1129f7d-4d42-5274-bad5-368dc2993492" "answer-9b7e80c1-d411-5f78-8fa9-5b2e23fb8afb" "answer-9e6fc084-138a-52e5-98fc-f3ff4df2d844"] :db/ensure [:answer-field/validate]} {:db/id "answer-95163aca-07b5-596d-b2dd-ec7271cff2ed" :answer/id #uuid "95163aca-07b5-596d-b2dd-ec7271cff2ed" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-30d37de0-fa9a-528c-821a-0e1cbd836c93" :answer/id #uuid "30d37de0-fa9a-528c-821a-0e1cbd836c93" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-b1129f7d-4d42-5274-bad5-368dc2993492" :answer/id #uuid "b1129f7d-4d42-5274-bad5-368dc2993492" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-9b7e80c1-d411-5f78-8fa9-5b2e23fb8afb" :answer/id #uuid "9b7e80c1-d411-5f78-8fa9-5b2e23fb8afb" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-9e6fc084-138a-52e5-98fc-f3ff4df2d844" :answer/id #uuid "9e6fc084-138a-52e5-98fc-f3ff4df2d844" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "activity-a41be437-b248-5421-824d-ce132e4011d1" :activity/id #uuid "a41be437-b248-5421-824d-ce132e4011d1" :activity/title "Constrained Optimization of Quadratic Forms" :activity/type :activity.type/review :activity/scope 17592186050447 :activity/course 17592186046658 :activity/steps ["step-d6103cc5-4c4e-5c0f-af10-d73cba662696" "step-46e11e28-122a-5f86-8bf2-7977b37760ca" "step-b523e58a-cade-5384-8700-ade4a5ce4089" "step-66cbd984-34bf-5c4b-b040-16117bac09ca" "step-085cdc0b-e1a7-5229-892c-0ef2ac49749e"] :activity/first-step "step-d6103cc5-4c4e-5c0f-af10-d73cba662696" :db/ensure [:activity/validate]} {:db/id "step-d6103cc5-4c4e-5c0f-af10-d73cba662696" :step/id #uuid "d6103cc5-4c4e-5c0f-af10-d73cba662696" :step/content "question-957651b3-45e4-5a93-853b-1785322d0942" :step/next "step-46e11e28-122a-5f86-8bf2-7977b37760ca" :db/ensure [:step/validate]} {:db/id "step-46e11e28-122a-5f86-8bf2-7977b37760ca" :step/id #uuid "46e11e28-122a-5f86-8bf2-7977b37760ca" :step/content 17592186269162 :step/next "step-b523e58a-cade-5384-8700-ade4a5ce4089" :db/ensure [:step/validate]} {:db/id "step-b523e58a-cade-5384-8700-ade4a5ce4089" :step/id #uuid "b523e58a-cade-5384-8700-ade4a5ce4089" :step/content "question-3e4f6268-3e58-5684-9bea-f874fd53aaf3" :step/next "step-66cbd984-34bf-5c4b-b040-16117bac09ca" :db/ensure [:step/validate]} {:db/id "step-66cbd984-34bf-5c4b-b040-16117bac09ca" :step/id #uuid "66cbd984-34bf-5c4b-b040-16117bac09ca" :step/content 17592186269171 :step/next "step-085cdc0b-e1a7-5229-892c-0ef2ac49749e" :db/ensure [:step/validate]} {:db/id "step-085cdc0b-e1a7-5229-892c-0ef2ac49749e" :step/id #uuid "085cdc0b-e1a7-5229-892c-0ef2ac49749e" :step/content 17592186278199 :db/ensure [:step/validate]} [:db/retract 17592186091738 :answer-field/choices 17592186091739] [:db/retract 17592186091738 :answer-field/choices 17592186091740] [:db/retract 17592186091738 :answer-field/choices 17592186091741] [:db/retract 17592186091738 :answer-field/choices 17592186091743] {:db/id 17592186092923 :question/problem "![](images/fa/fa58c9d1c0680dd94bb25c04e0a268df836e14bfb217f0a20d3bd75224cec4e8.png)\n\nFind the arc length of the polar curve $r={e}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={e}^{\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{\\theta })}^{2}+{({e}^{\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{2\\theta }+{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{2{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}{e}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{2}{e}^{\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{2}({e}^{\\pi /2}-{e}^{0}) \\\\  & =\\sqrt{2}({e}^{\\pi /2}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186091738 :answer-field/correct "answer-ad493751-d3c8-5246-8a30-3a2a4aefa677" :answer-field/choices ["answer-635d1f78-1ff1-548c-b1d2-727e82d8d662" "answer-b6a466dc-34ab-5292-b042-6078d2d70c1f" "answer-ad493751-d3c8-5246-8a30-3a2a4aefa677" "answer-d7923dd0-6a1a-51d5-bb60-8f501bdb44b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-635d1f78-1ff1-548c-b1d2-727e82d8d662" :answer/id #uuid "635d1f78-1ff1-548c-b1d2-727e82d8d662" :answer/type :answer.type/math :answer/value "2\\sqrt{2}({e}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-b6a466dc-34ab-5292-b042-6078d2d70c1f" :answer/id #uuid "b6a466dc-34ab-5292-b042-6078d2d70c1f" :answer/type :answer.type/math :answer/value "2\\sqrt{2}({e}^{\\pi /2}-{e}^{-\\pi /2})" :db/ensure [:answer/validate]} {:db/id "answer-ad493751-d3c8-5246-8a30-3a2a4aefa677" :answer/id #uuid "ad493751-d3c8-5246-8a30-3a2a4aefa677" :answer/type :answer.type/math :answer/value "\\sqrt{2}({e}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-d7923dd0-6a1a-51d5-bb60-8f501bdb44b0" :answer/id #uuid "d7923dd0-6a1a-51d5-bb60-8f501bdb44b0" :answer/type :answer.type/math :answer/value "\\sqrt{2}{e}^{\\pi /2}" :db/ensure [:answer/validate]} {:db/id 17592186100942 :knowledge-point/questions ["question-2014fae0-a89c-5d1e-8735-16f0159dd06c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2014fae0-a89c-5d1e-8735-16f0159dd06c" :question/id #uuid "2014fae0-a89c-5d1e-8735-16f0159dd06c" :question/math-academy-id "q-119283" :question/problem "The growth rate of a watermelon production $P(t)$ in a certain land is jointly proportional to the watermelon production at time $t,$ measured in months, and the difference between the land's carrying capacity and the watermelon production. If the constant of proportionality is $0.2$ and the maximum possible watermelon production is $1\\,800,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the watermelon production growth rate is *jointly* proportional to the watermelon production at time $t$ and the difference between the carrying capacity and the watermelon production, the watermelon production follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.2,$ and the carrying capacity is $a=1\\,800.$ Therefore, the watermelon production is given by the equation\n\n$$\n\\frac{dP}{dt}=0.2P(1\\,800-P).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bb8637b4-c23b-5591-8ea3-4b43b99fdc95"] :db/ensure [:question/validate]} {:db/id "answer-field-bb8637b4-c23b-5591-8ea3-4b43b99fdc95" :answer-field/id #uuid "bb8637b4-c23b-5591-8ea3-4b43b99fdc95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0b62c6a-1496-5d36-a0b2-51a726ef8705" :answer-field/choices ["answer-d85d5e68-caf7-5fe3-b3d9-26adeac92153" "answer-75cc83f0-cddd-51ed-9a88-cb259f07d3eb" "answer-d0b62c6a-1496-5d36-a0b2-51a726ef8705" "answer-5c088d0f-ace9-54be-ac56-eec3807e7304" "answer-5e283cf8-0d6b-5c7b-924b-0c460fd57833"] :db/ensure [:answer-field/validate]} {:db/id "answer-d85d5e68-caf7-5fe3-b3d9-26adeac92153" :answer/id #uuid "d85d5e68-caf7-5fe3-b3d9-26adeac92153" :answer/type :answer.type/math :answer/value "\\frac{dP}{dt}=-0.2P(1\\,800-P)" :db/ensure [:answer/validate]} {:db/id "answer-75cc83f0-cddd-51ed-9a88-cb259f07d3eb" :answer/id #uuid "75cc83f0-cddd-51ed-9a88-cb259f07d3eb" :answer/type :answer.type/math :answer/value "\\frac{dP}{dt}=0.2P(1\\,800+P)" :db/ensure [:answer/validate]} {:db/id "answer-d0b62c6a-1496-5d36-a0b2-51a726ef8705" :answer/id #uuid "d0b62c6a-1496-5d36-a0b2-51a726ef8705" :answer/type :answer.type/math :answer/value "\\frac{dP}{dt}=0.2P(1\\,800-P)" :db/ensure [:answer/validate]} {:db/id "answer-5c088d0f-ace9-54be-ac56-eec3807e7304" :answer/id #uuid "5c088d0f-ace9-54be-ac56-eec3807e7304" :answer/type :answer.type/math :answer/value "\\frac{dP}{dt}=1\\,800P(0.2+P)" :db/ensure [:answer/validate]} {:db/id "answer-5e283cf8-0d6b-5c7b-924b-0c460fd57833" :answer/id #uuid "5e283cf8-0d6b-5c7b-924b-0c460fd57833" :answer/type :answer.type/math :answer/value "\\frac{dP}{dt}=1\\,800P(0.2-P)" :db/ensure [:answer/validate]} {:db/id 17592186129318 :knowledge-point/questions ["question-42788b85-30ff-5f36-a9fd-86e424b97617"] :db/ensure [:knowledge-point/validate]} {:db/id "question-42788b85-30ff-5f36-a9fd-86e424b97617" :question/id #uuid "42788b85-30ff-5f36-a9fd-86e424b97617" :question/math-academy-id "q-138980" :question/problem "Consider the curve defined parametrically as \n\n$$\nx={cos}^{3}⁡t,\\,y={sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nWhat integral gives the surface area generated when this curve is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\frac{\\pi }{2}.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({cos}^{3}⁡t)=-3\\operatorname{sin}⁡t{cos}^{2}⁡t \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({sin}^{3}⁡t)=3{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{{(-3\\operatorname{sin}⁡t{cos}^{2}⁡t)}^{2}+{(3{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{9{sin}^{2}⁡t{cos}^{4}⁡t+9{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{9{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, using the identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{9{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\sqrt{(3\\operatorname{sin}⁡t\\operatorname{cos}⁡t)^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\cdot |3\\operatorname{sin}⁡t\\operatorname{cos}⁡t|\\,\\text{d}t \\\\  & =6\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\cdot \\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =6\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t\\operatorname{cos}⁡t\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-632462c4-14ed-5c49-b96d-6314fe36a641"] :db/ensure [:question/validate]} {:db/id "answer-field-632462c4-14ed-5c49-b96d-6314fe36a641" :answer-field/id #uuid "632462c4-14ed-5c49-b96d-6314fe36a641" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4fab1f17-f040-5e8d-ba53-5a0cfda68a34" :answer-field/choices ["answer-bb77564e-76df-5e96-b697-013fee021596" "answer-a8cf6697-f373-540e-8e34-c5fc49f71fef" "answer-37b64633-9200-5ac4-9020-49356273a990" "answer-693cf72a-54a9-5ffe-b86a-e3d60d8e9126" "answer-4fab1f17-f040-5e8d-ba53-5a0cfda68a34"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb77564e-76df-5e96-b697-013fee021596" :answer/id #uuid "bb77564e-76df-5e96-b697-013fee021596" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{\\pi /2}{cos}^{4}⁡t\\operatorname{sin}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-a8cf6697-f373-540e-8e34-c5fc49f71fef" :answer/id #uuid "a8cf6697-f373-540e-8e34-c5fc49f71fef" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t{cos}^{4}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-37b64633-9200-5ac4-9020-49356273a990" :answer/id #uuid "37b64633-9200-5ac4-9020-49356273a990" :answer/type :answer.type/math :answer/value "3\\pi {\\int }_{0}^{\\pi /2}{cos}^{3}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-693cf72a-54a9-5ffe-b86a-e3d60d8e9126" :answer/id #uuid "693cf72a-54a9-5ffe-b86a-e3d60d8e9126" :answer/type :answer.type/math :answer/value "6\\pi {\\int }_{0}^{\\pi /2}{sin}^{3}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "answer-4fab1f17-f040-5e8d-ba53-5a0cfda68a34" :answer/id #uuid "4fab1f17-f040-5e8d-ba53-5a0cfda68a34" :answer/type :answer.type/math :answer/value "6\\pi {\\int }_{0}^{\\pi /2}{sin}^{4}⁡t\\operatorname{cos}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id 17592186064163 :knowledge-point/questions ["question-6a23334e-1f04-5511-928e-2caa0a2313aa"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6a23334e-1f04-5511-928e-2caa0a2313aa" :question/id #uuid "6a23334e-1f04-5511-928e-2caa0a2313aa" :question/math-academy-id "q-344426" :question/problem "The exact global minimum value of the function $f(x)={x}^{2}-4x+5$ on the closed interval $0\\le x\\le 5$ is{{field-1}}." :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)={x}^{2}-4x+5,$ we get\n\n$$\n{f}^{′}(x)=2x-4.\n$$\n\nSolving ${f}^{′}(x)=0,$ we get \n\n$$\n\\begin{aligned}2x-4 & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nSo, the critical points are $x=2$ and the endpoints $x=0,5$ (since the derivative is not defined at the endpoints)\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(0) & ={0}^{2}-4(0)+5=5 \\\\ f(2) & ={2}^{2}-4(2)+5=1 \\\\ f(5) & ={5}^{2}-4(5)+5=10\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The smallest value is $f(2)=1,$ so the global minimum is $1.$\n\n- The greatest value is $f(5)=10,$ so the global maximum is $10.$\n\n![](images/9a/9a52ee757248f6b742af36af1e6af9e801cb8e5276b119e399b6fff36d75d0dd.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b5c4df65-6015-5ec9-a590-2b33b6d37d1f"] :db/ensure [:question/validate]} {:db/id "answer-field-b5c4df65-6015-5ec9-a590-2b33b6d37d1f" :answer-field/id #uuid "b5c4df65-6015-5ec9-a590-2b33b6d37d1f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b6dfc676-da5c-574c-a05b-9ad750d0d173" :answer-field/choices ["answer-b6dfc676-da5c-574c-a05b-9ad750d0d173"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6dfc676-da5c-574c-a05b-9ad750d0d173" :answer/id #uuid "b6dfc676-da5c-574c-a05b-9ad750d0d173" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "activity-9212bfd3-0830-5e35-a82a-a827c5e76176" :activity/id #uuid "9212bfd3-0830-5e35-a82a-a827c5e76176" :activity/title "Quiz 1" :activity/type :activity.type/assessment :activity/course 17592186046645 :activity/steps ["step-34a6170e-0575-571a-ae56-b0c6b66f198b" "step-ba33e601-868b-5386-9000-5cc1fbdaddc2" "step-9cb89aa4-e9c5-5f00-b04f-4e9bc062f9b4" "step-dc9f379f-4b46-590e-aa26-910ad4ef4790" "step-57b8dfd6-9bac-59cf-ac44-c16486eda1c3" "step-b55407ec-a2ee-5f9b-90f8-39bfad1179ca"] :activity/first-step "step-34a6170e-0575-571a-ae56-b0c6b66f198b" :db/ensure [:activity/validate]} {:db/id "step-34a6170e-0575-571a-ae56-b0c6b66f198b" :step/id #uuid "34a6170e-0575-571a-ae56-b0c6b66f198b" :step/content 17592186092923 :step/next "step-ba33e601-868b-5386-9000-5cc1fbdaddc2" :db/ensure [:step/validate]} {:db/id "step-ba33e601-868b-5386-9000-5cc1fbdaddc2" :step/id #uuid "ba33e601-868b-5386-9000-5cc1fbdaddc2" :step/content "question-2014fae0-a89c-5d1e-8735-16f0159dd06c" :step/next "step-9cb89aa4-e9c5-5f00-b04f-4e9bc062f9b4" :db/ensure [:step/validate]} {:db/id "step-9cb89aa4-e9c5-5f00-b04f-4e9bc062f9b4" :step/id #uuid "9cb89aa4-e9c5-5f00-b04f-4e9bc062f9b4" :step/content 17592186250282 :step/next "step-dc9f379f-4b46-590e-aa26-910ad4ef4790" :db/ensure [:step/validate]} {:db/id "step-dc9f379f-4b46-590e-aa26-910ad4ef4790" :step/id #uuid "dc9f379f-4b46-590e-aa26-910ad4ef4790" :step/content "question-42788b85-30ff-5f36-a9fd-86e424b97617" :step/next "step-57b8dfd6-9bac-59cf-ac44-c16486eda1c3" :db/ensure [:step/validate]} {:db/id "step-57b8dfd6-9bac-59cf-ac44-c16486eda1c3" :step/id #uuid "57b8dfd6-9bac-59cf-ac44-c16486eda1c3" :step/content "question-6a23334e-1f04-5511-928e-2caa0a2313aa" :step/next "step-b55407ec-a2ee-5f9b-90f8-39bfad1179ca" :db/ensure [:step/validate]} {:db/id "step-b55407ec-a2ee-5f9b-90f8-39bfad1179ca" :step/id #uuid "b55407ec-a2ee-5f9b-90f8-39bfad1179ca" :step/content 17592186354291 :db/ensure [:step/validate]}]
