te]} {:db/id "step-dee73bba-131d-58ab-aa00-268e67c23bb6" :step/id #uuid "dee73bba-131d-58ab-aa00-268e67c23bb6" :step/content "question-4b671a86-bc70-5855-bc03-8c1fbe9580d0" :step/next "step-223c7009-a395-59ef-a320-3fe78d6b6feb" :db/ensure [:step/validate]} {:db/id "step-223c7009-a395-59ef-a320-3fe78d6b6feb" :step/id #uuid "223c7009-a395-59ef-a320-3fe78d6b6feb" :step/content "question-43993959-de6b-5c51-8ec3-a8748bbd2836" :step/next "step-78e5fce8-bb06-577e-bd5a-183dacb1971e" :db/ensure [:step/validate]} {:db/id "step-78e5fce8-bb06-577e-bd5a-183dacb1971e" :step/id #uuid "78e5fce8-bb06-577e-bd5a-183dacb1971e" :step/content "question-76ebc4d7-7b51-5dea-a66f-038cad1e5104" :step/next "step-149d1a19-2ffd-5641-9b81-20469dfa7fad" :db/ensure [:step/validate]} {:db/id "step-149d1a19-2ffd-5641-9b81-20469dfa7fad" :step/id #uuid "149d1a19-2ffd-5641-9b81-20469dfa7fad" :step/content "question-cca0b3f3-f64a-53b6-8329-0c693549bc28" :step/next "step-99569427-0c54-58f7-8381-e0a479744aae" :db/ensure [:step/validate]} {:db/id "step-99569427-0c54-58f7-8381-e0a479744aae" :step/id #uuid "99569427-0c54-58f7-8381-e0a479744aae" :step/content 17592186434587 :step/next "step-ff46c6ac-c551-5bb2-bff8-2b656eb8f001" :db/ensure [:step/validate]} {:db/id "step-ff46c6ac-c551-5bb2-bff8-2b656eb8f001" :step/id #uuid "ff46c6ac-c551-5bb2-bff8-2b656eb8f001" :step/content "question-17babc52-289e-5d9d-bc9c-baaf511d4b6f" :db/ensure [:step/validate]} {:db/id 17592186092374 :knowledge-point/questions ["question-da080066-6980-5e46-a310-b96dc7f7120c" "question-1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" "question-a9290c4e-ece3-5a58-aecc-bb62b4894116" "question-6ddfe515-d085-541a-8dab-b3a5ab40f555"] :db/ensure [:knowledge-point/validate]} {:db/id "question-da080066-6980-5e46-a310-b96dc7f7120c" :question/id #uuid "da080066-6980-5e46-a310-b96dc7f7120c" :question/math-academy-id "q-9540" :question/problem "![](images/c1/c1bf9d989f1fbaeda90325b924f2c9285cd4e37e1948ba63256258b0a84c7e44.png)\n\nFind the arc length of the polar curve $r={2}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={2}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={2}^{\\theta }\\operatorname{ln}⁡2.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{({2}^{\\theta })}^{2}+{({2}^{\\theta }\\operatorname{ln}⁡2)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{2}^{2\\theta }+{2}^{2\\theta }{ln}^{2}⁡2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(1+{ln}^{2}⁡2){2}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}{\\int }_{0}^{\\pi /2}{2}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot {2}^{\\theta }{|}_{0}^{\\pi /2} \\\\  & =\\sqrt{1+{ln}^{2}⁡2}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\cdot ({2}^{\\pi /2}-{2}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2a4caf7b-52fc-5e88-b891-82cc9a3a2cf7"] :db/ensure [:question/validate]} {:db/id "answer-field-2a4caf7b-52fc-5e88-b891-82cc9a3a2cf7" :answer-field/id #uuid "2a4caf7b-52fc-5e88-b891-82cc9a3a2cf7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-25efba17-6780-5d23-af19-6462827fe365" :answer-field/choices ["answer-1ce61a52-02f8-52e3-833d-f0a747be827a" "answer-44549959-713e-5a87-987f-4262b4d5d3c5" "answer-25efba17-6780-5d23-af19-6462827fe365" "answer-ca7da443-446d-582f-b934-dcaf57f4a7d1" "answer-d25fbccb-dafe-5557-83e3-f260cee1b53a"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ce61a52-02f8-52e3-833d-f0a747be827a" :answer/id #uuid "1ce61a52-02f8-52e3-833d-f0a747be827a" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{1+\\operatorname{ln}⁡2}}({2}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-44549959-713e-5a87-987f-4262b4d5d3c5" :answer/id #uuid "44549959-713e-5a87-987f-4262b4d5d3c5" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{\\sqrt{2}}({2}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-25efba17-6780-5d23-af19-6462827fe365" :answer/id #uuid "25efba17-6780-5d23-af19-6462827fe365" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-ca7da443-446d-582f-b934-dcaf57f4a7d1" :answer/id #uuid "ca7da443-446d-582f-b934-dcaf57f4a7d1" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{\\operatorname{ln}⁡2}({2}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-d25fbccb-dafe-5557-83e3-f260cee1b53a" :answer/id #uuid "d25fbccb-dafe-5557-83e3-f260cee1b53a" :answer/type :answer.type/math :answer/value "\\sqrt{2}({2}^{\\pi /2}-1)" :db/ensure [:answer/validate]} {:db/id "question-1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" :question/id #uuid "1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" :question/math-academy-id "q-9541" :question/problem "Find the arc length of the polar curve $r={3}^{\\theta }$ for $0\\le \\theta \\le \\pi .$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={3}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={3}^{\\theta }\\operatorname{ln}⁡3.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{({3}^{\\theta })}^{2}+{({3}^{\\theta }\\operatorname{ln}⁡3)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{3}^{2\\theta }+{3}^{2\\theta }{ln}^{2}⁡3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(1+{ln}^{2}⁡3){3}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}{\\int }_{0}^{\\pi }{3}^{\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot {3}^{\\theta }{|}_{0}^{\\pi } \\\\  & =\\sqrt{1+{ln}^{2}⁡3}\\cdot \\frac{1}{\\operatorname{ln}⁡3}\\cdot ({3}^{\\pi }-{3}^{0}) \\\\  & =\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-770387f5-8ab3-56b6-9ab8-582f315d1f1c"] :db/ensure [:question/validate]} {:db/id "answer-field-770387f5-8ab3-56b6-9ab8-582f315d1f1c" :answer-field/id #uuid "770387f5-8ab3-56b6-9ab8-582f315d1f1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ee47508c-c5ac-50f6-8486-05ab49b69007" :answer-field/choices ["answer-6b6ad79e-00af-5e1d-b171-f99e8a87b59c" "answer-ee47508c-c5ac-50f6-8486-05ab49b69007" "answer-138e119b-9f29-5728-b024-f296e1407436" "answer-4c63f797-f964-543b-8948-8fa3ef071043" "answer-a24f9d67-8d4f-5f04-a33c-d625d9ff53b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b6ad79e-00af-5e1d-b171-f99e8a87b59c" :answer/id #uuid "6b6ad79e-00af-5e1d-b171-f99e8a87b59c" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡3}{\\sqrt{1+\\operatorname{ln}⁡3}}({3}^{\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "answer-ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/id #uuid "ee47508c-c5ac-50f6-8486-05ab49b69007" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{1+{ln}^{2}⁡3}}{\\operatorname{ln}⁡3}({3}^{\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "answer-138e119b-9f29-5728-b024-f296e1407436" :answer/id #uuid "138e119b-9f29-5728-b024-f296e1407436" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3+{ln}^{2}⁡2}}{\\operatorname{ln}⁡2}({3}^{\\pi }-1)" :db/ensure [:answer/validate]} {:db/id "answer-4c63f797-f964-543b-8948-8fa3ef071043" :answer/id #uuid "4c63f797-f964-543b-8948-8fa3ef071043" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{\\operatorname{ln}⁡3}({3}^{\\pi }+1)" :db/ensure [:answer/validate]} {:db/id "answer-a24f9d67-8d4f-5f04-a33c-d625d9ff53b6" :answer/id #uuid "a24f9d67-8d4f-5f04-a33c-d625d9ff53b6" :answer/type :answer.type/math :answer/value "\\sqrt{3}({3}^{\\pi }-1)" :db/ensure [:answer/validate]} {:db/id 17592186092373 :knowledge-point/questions ["question-a1c1460f-c5a2-5e99-b7f7-17db73e707c6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a1c1460f-c5a2-5e99-b7f7-17db73e707c6" :question/id #uuid "a1c1460f-c5a2-5e99-b7f7-17db73e707c6" :question/math-academy-id "q-103828" :question/problem "Which of the following gives the arc length of the polar curve $r=1-\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-\\operatorname{sin}⁡\\theta )^{2}+(-\\operatorname{cos}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )+{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-452ad711-f8a6-5c7b-b980-01feac5bbbde"] :db/ensure [:question/validate]} {:db/id "answer-field-452ad711-f8a6-5c7b-b980-01feac5bbbde" :answer-field/id #uuid "452ad711-f8a6-5c7b-b980-01feac5bbbde" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer-field/choices ["answer-15a09810-6e1e-5a7f-a496-a308672d8fe3" "answer-931cc387-4c8e-5435-8982-a4705188d119" "answer-75c79860-2158-5faa-be6a-5b9aa2eb7054" "answer-ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" "answer-70d61664-e8b3-5d91-831f-2ef5a133d2af"] :db/ensure [:answer-field/validate]} {:db/id "answer-15a09810-6e1e-5a7f-a496-a308672d8fe3" :answer/id #uuid "15a09810-6e1e-5a7f-a496-a308672d8fe3" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-931cc387-4c8e-5435-8982-a4705188d119" :answer/id #uuid "931cc387-4c8e-5435-8982-a4705188d119" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-75c79860-2158-5faa-be6a-5b9aa2eb7054" :answer/id #uuid "75c79860-2158-5faa-be6a-5b9aa2eb7054" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{1-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/id #uuid "ad39fb78-7dc8-5c7f-b6cd-c9732f59d8ab" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-70d61664-e8b3-5d91-831f-2ef5a133d2af" :answer/id #uuid "70d61664-e8b3-5d91-831f-2ef5a133d2af" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /4}\\sqrt{2-\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-a9290c4e-ece3-5a58-aecc-bb62b4894116" :question/id #uuid "a9290c4e-ece3-5a58-aecc-bb62b4894116" :question/math-academy-id "q-353582" :question/problem "![](images/83/83813bff1ff86036e2773d9476150de619688daec9cae2623a555a43290cace3.png)\n\nFind the arc length $L$ of the polar curve $r=3\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=3\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=3\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{(3\\operatorname{sin}⁡\\theta )}^{2}+{(3\\operatorname{cos}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9{sin}^{2}⁡\\theta +9{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{9}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}3\\,\\text{d}\\theta  \\\\  & =3\\theta \\,{|}_{\\pi /2}^{5\\pi /6} \\\\  & =3(\\frac{5\\pi }{6}-\\frac{\\pi }{2}) \\\\  & =\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3487b8fc-2024-52a0-8191-9d6c368ac790"] :db/ensure [:question/validate]} {:db/id "answer-field-3487b8fc-2024-52a0-8191-9d6c368ac790" :answer-field/id #uuid "3487b8fc-2024-52a0-8191-9d6c368ac790" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer-field/choices ["answer-901a723b-e6e5-572f-9b48-3f4f2a4dea43"] :db/ensure [:answer-field/validate]} {:db/id "answer-901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/id #uuid "901a723b-e6e5-572f-9b48-3f4f2a4dea43" :answer/type :answer.type/math :answer/value "\\pi" :db/ensure [:answer/validate]} {:db/id "question-6ddfe515-d085-541a-8dab-b3a5ab40f555" :question/id #uuid "6ddfe515-d085-541a-8dab-b3a5ab40f555" :question/math-academy-id "q-353601" :question/problem "![](images/ec/ec0b88ec00ef7e7061af0b08761eb73f05a5f669208babacbd4eb86736019230.png)\n\nFind the arc length $L$ of the polar curve $r=6{e}^{3\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{3}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=6{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=18{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{(6{e}^{3\\theta })}^{2}+{(18{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{36{e}^{6\\theta }+324{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{360{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{\\int }_{0}^{\\pi /3}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =6\\sqrt{10}{[\\frac{1}{3}{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}{[{e}^{3\\theta }]}_{0}^{\\pi /3} \\\\  & =2\\sqrt{10}({e}^{\\pi }-{e}^{0}) \\\\  & =2\\sqrt{10}({e}^{\\pi }-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0d00646e-dd97-589c-8e21-634590dfdfc6"] :db/ensure [:question/validate]} {:db/id "answer-field-0d00646e-dd97-589c-8e21-634590dfdfc6" :answer-field/id #uuid "0d00646e-dd97-589c-8e21-634590dfdfc6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer-field/choices ["answer-ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/id #uuid "ebc83588-25b8-5ff4-bfc0-bce39c4a0f4f" :answer/type :answer.type/math :answer/value "2\\sqrt{10}(e^{\\pi}-1)" :db/ensure [:answer/validate]} {:db/id "activity-06060959-70db-516d-a667-e9e1c5818a37" :activity/id #uuid "06060959-70db-516d-a667-e9e1c5818a37" :activity/title "The Arc Length of a Polar Curve" :activity/type :activity.type/review :activity/scope 17592186050779 :activity/course 17592186046645 :activity/steps ["step-d656c95b-f90d-539c-9dbd-3c2a66651730" "step-8478a7a6-7989-5221-ae40-cc42a13728b8" "step-e4403343-b5c6-5fde-abd9-266da3d46e06" "step-1fbc467c-fa74-583d-ac77-d9d3baef5bc1" "step-ad84a19f-114d-5fb3-b813-cbaf4567a4df"] :activity/first-step "step-d656c95b-f90d-539c-9dbd-3c2a66651730" :db/ensure [:activity/validate]} {:db/id "step-d656c95b-f90d-539c-9dbd-3c2a66651730" :step/id #uuid "d656c95b-f90d-539c-9dbd-3c2a66651730" :step/content "question-da080066-6980-5e46-a310-b96dc7f7120c" :step/next "step-8478a7a6-7989-5221-ae40-cc42a13728b8" :db/ensure [:step/validate]} {:db/id "step-8478a7a6-7989-5221-ae40-cc42a13728b8" :step/id #uuid "8478a7a6-7989-5221-ae40-cc42a13728b8" :step/content "question-1bd5daf3-8ee2-5ee2-ae53-b882ce969a04" :step/next "step-e4403343-b5c6-5fde-abd9-266da3d46e06" :db/ensure [:step/validate]} {:db/id "step-e4403343-b5c6-5fde-abd9-266da3d46e06" :step/id #uuid "e4403343-b5c6-5fde-abd9-266da3d46e06" :step/content "question-a1c1460f-c5a2-5e99-b7f7-17db73e707c6" :step/next "step-1fbc467c-fa74-583d-ac77-d9d3baef5bc1" :db/ensure [:step/validate]} {:db/id "step-1fbc467c-fa74-583d-ac77-d9d3baef5bc1" :step/id #uuid "1fbc467c-fa74-583d-ac77-d9d3baef5bc1" :step/content "question-a9290c4e-ece3-5a58-aecc-bb62b4894116" :step/next "step-ad84a19f-114d-5fb3-b813-cbaf4567a4df" :db/ensure [:step/validate]} {:db/id "step-ad84a19f-114d-5fb3-b813-cbaf4567a4df" :step/id #uuid "ad84a19f-114d-5fb3-b813-cbaf4567a4df" :step/content "question-6ddfe515-d085-541a-8dab-b3a5ab40f555" :db/ensure [:step/validate]} {:db/id 17592186064359 :knowledge-point/questions ["question-8839a979-8588-586f-ba7f-29f7bd102689"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8839a979-8588-586f-ba7f-29f7bd102689" :question/id #uuid "8839a979-8588-586f-ba7f-29f7bd102689" :question/math-academy-id "q-128432" :question/problem "Expressed as a fraction, $(-13)÷(-5)=$" :question/worked-solution "We have to divide a negative number $(-13)$ by another negative number $(-5).$ So the result will be positive:\n\n$$\n(-13)÷(-5)=\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we divide $13$ by $5$ without any signs: $13÷5=\\frac{13}{5}.$ Therefore,  we get\n\n$$\n(-13)÷(-5)=\\frac{13}{5}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5a83004e-d80a-5972-9a67-a6699235fa01"] :db/ensure [:question/validate]} {:db/id "answer-field-5a83004e-d80a-5972-9a67-a6699235fa01" :answer-field/id #uuid "5a83004e-d80a-5972-9a67-a6699235fa01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69e7cd8b-06c5-5b3e-9fab-1f57c8afe5c4" :answer-field/choices ["answer-1050a5ac-95a1-54a5-9d93-1b1c08568b81" "answer-e6cbbe55-3262-5c68-a7d4-c759942baddc" "answer-69e7cd8b-06c5-5b3e-9fab-1f57c8afe5c4" "answer-81f31262-9f91-5f8f-99e6-91bfeb259615" "answer-2229e88a-03e9-54d5-8d4b-8d8b7f3a06d5"] :db/ensure [:answer-field/validate]} {:db/id "a