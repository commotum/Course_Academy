a8-bdb0-5979-96ad-3d44946c7eee"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3086aa8-bdb0-5979-96ad-3d44946c7eee" :answer/id #uuid "d3086aa8-bdb0-5979-96ad-3d44946c7eee" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-d86cd08e-2e74-5dfa-8aed-573414a8abcf" :answer-field/id #uuid "d86cd08e-2e74-5dfa-8aed-573414a8abcf" :answer-field/key "field-8" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4c0fe51c-df57-5055-a519-b8b8b55b9733" :answer-field/choices ["answer-4c0fe51c-df57-5055-a519-b8b8b55b9733"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c0fe51c-df57-5055-a519-b8b8b55b9733" :answer/id #uuid "4c0fe51c-df57-5055-a519-b8b8b55b9733" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-86e2d08a-1bef-5ead-ab02-f3370f825b7b" :question/id #uuid "86e2d08a-1bef-5ead-ab02-f3370f825b7b" :question/math-academy-id "q-332746" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}\\frac{5}{2} & -\\frac{1}{2} \\\\ \\frac{1}{2} & \\frac{3}{2}\\end{aligned}]x(t)+[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nA complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}(t[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]){e}^{2t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as \n$x(t)={x}_{c}(t)+{x}_{p}(t),$\nwhere ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is constant. Therefore, we assume that the particular solution is also constant, i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2}$ are constants that are to be determined." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9383c075-7b49-5325-9b5c-cd8dcad979f2"] :db/ensure [:question/validate]} {:db/id "answer-field-9383c075-7b49-5325-9b5c-cd8dcad979f2" :answer-field/id #uuid "9383c075-7b49-5325-9b5c-cd8dcad979f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d84b77cd-445d-5e7b-9943-f6360adafe74" :answer-field/choices ["answer-d84b77cd-445d-5e7b-9943-f6360adafe74" "answer-30691a01-55c3-533b-a424-d0de797b3387" "answer-ed85ca35-f4b8-573e-9682-f6097ad63ec4" "answer-ad567f45-3261-519b-a4aa-9cc323a653cf" "answer-c3ea5e39-e5d4-50ce-9738-582058e97aaa"] :db/ensure [:answer-field/validate]} {:db/id "answer-d84b77cd-445d-5e7b-9943-f6360adafe74" :answer/id #uuid "d84b77cd-445d-5e7b-9943-f6360adafe74" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-30691a01-55c3-533b-a424-d0de797b3387" :answer/id #uuid "30691a01-55c3-533b-a424-d0de797b3387" :answer/type :answer.type/math :answer/value "t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ed85ca35-f4b8-573e-9682-f6097ad63ec4" :answer/id #uuid "ed85ca35-f4b8-573e-9682-f6097ad63ec4" :answer/type :answer.type/math :answer/value "{e}^{-2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ad567f45-3261-519b-a4aa-9cc323a653cf" :answer/id #uuid "ad567f45-3261-519b-a4aa-9cc323a653cf" :answer/type :answer.type/math :answer/value "{e}^{2t}(t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}])" :db/ensure [:answer/validate]} {:db/id "answer-c3ea5e39-e5d4-50ce-9738-582058e97aaa" :answer/id #uuid "c3ea5e39-e5d4-50ce-9738-582058e97aaa" :answer/type :answer.type/math :answer/value "{e}^{2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-38450a0f-4d09-5bde-a910-db2e5f9dab01" :question/id #uuid "38450a0f-4d09-5bde-a910-db2e5f9dab01" :question/math-academy-id "q-332750" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2/5 & -6/5 \\\\ -6/5 & -7/5\\end{aligned}]x(t)+[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system can be written as \n$x(t)={x}_{c}(t)+{x}_{p}(t),$\nwhere ${x}_{p}(t)$ is a particular solution. Determine the form of the particular solution ${x}_{p}(t).$" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is constant. Therefore, we assume that the particular solution is also constant, i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2}$ are constants that are to be determined." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d744d908-cf4d-5235-b951-02b4eba533c9"] :db/ensure [:question/validate]} {:db/id "answer-field-d744d908-cf4d-5235-b951-02b4eba533c9" :answer-field/id #uuid "d744d908-cf4d-5235-b951-02b4eba533c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7132385-7803-53ed-9e7a-bd0a73aaedda" :answer-field/choices ["answer-a7132385-7803-53ed-9e7a-bd0a73aaedda" "answer-2d2844d1-123e-55fc-a158-f0c5eb9a88be" "answer-15b6db1c-6da1-5535-8303-f77afc11a0fa" "answer-16e3c069-4d0f-571b-998d-795c4aedc752" "answer-b1172b23-ff5e-5a59-9d03-1f3f1510fae5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7132385-7803-53ed-9e7a-bd0a73aaedda" :answer/id #uuid "a7132385-7803-53ed-9e7a-bd0a73aaedda" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2d2844d1-123e-55fc-a158-f0c5eb9a88be" :answer/id #uuid "2d2844d1-123e-55fc-a158-f0c5eb9a88be" :answer/type :answer.type/math :answer/value "t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-15b6db1c-6da1-5535-8303-f77afc11a0fa" :answer/id #uuid "15b6db1c-6da1-5535-8303-f77afc11a0fa" :answer/type :answer.type/math :answer/value "{e}^{-2t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-16e3c069-4d0f-571b-998d-795c4aedc752" :answer/id #uuid "16e3c069-4d0f-571b-998d-795c4aedc752" :answer/type :answer.type/math :answer/value "{e}^{t}(t[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}])" :db/ensure [:answer/validate]} {:db/id "answer-b1172b23-ff5e-5a59-9d03-1f3f1510fae5" :answer/id #uuid "b1172b23-ff5e-5a59-9d03-1f3f1510fae5" :answer/type :answer.type/math :answer/value "{e}^{t}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186166904 :knowledge-point/questions ["question-3234de52-8801-51a2-806f-23f965c5de2f" "question-2e73d348-8d9b-5a9f-8dbf-5305290f7f53"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3234de52-8801-51a2-806f-23f965c5de2f" :question/id #uuid "3234de52-8801-51a2-806f-23f965c5de2f" :question/math-academy-id "q-333012" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]x(t)+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $x(t)={x}_{c}(t)+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$1$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,{t}^{2}+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $2$\n  </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,t+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    .\n  </td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $1$\n  </td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $2.$ Therefore, we assume that the particular solution is also polynomial of degree $2,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]{t}^{2}+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]t+[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2},{c}_{1},{c}_{2}$ are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}] \\\\ [\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}-({a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}) \\\\ {a}_{1}{t}^{2}+{b}_{1}t+{c}_{1}\\end{aligned}]+[\\begin{aligned}2{t}^{2}+t+3 \\\\ -{t}^{2}+2t\\end{aligned}] \\\\ [\\begin{aligned}0{t}^{2}+2{a}_{1}t+{b}_{1} \\\\ 0{t}^{2}+2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(-{a}_{2}+2){t}^{2}+(-{b}_{2}+1)t+(-{c}_{2}+3) \\\\ ({a}_{1}-1){t}^{2}+({b}_{1}+2)t+{c}_{1}\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding coefficients of like powers of $t,$ we get the following system:\n\n$$\n\\{\\begin{aligned}-{a}_{2}+2=0 \\\\ -\\,{b}_{2}+1=2{a}_{1} \\\\ -\\,{c}_{2}+3={b}_{1} \\\\ {a}_{1}-1=0 \\\\ {b}_{1}+2=2{a}_{2} \\\\ {c}_{1}={b}_{2}\\end{aligned}\n$$\n\nSolving the first and fourth equations, we get\n\n$$\n{a}_{2}=2,\\,{a}_{1}=1.\n$$\n\nSubstituting these into the second and fifth equations, and solving for ${b}_{1}$ and ${b}_{2},$ we get\n\n$$\n{b}_{2}=-1,\\,{b}_{1}=2.\n$$\n\nFinally, substituting these last values into the third and sixth equations, and solving for ${c}_{1}$ and ${c}_{2},$ we have\n\n$$\n{c}_{2}=1,\\,{c}_{1}=-1.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{t}^{2}+2t-1 \\\\ 2{t}^{2}-t+1\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}]{t}^{2}+[\\begin{aligned}2 \\\\ -1\\end{aligned}]t+[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2933141c-2169-5b87-8fb5-b8ed2e025c9c" "answer-field-f3dc74ec-4f14-5ce0-aef2-9920a7e3da3c" "answer-field-9f12c9a5-b2a0-5f55-8200-bc2b6ab50775"] :db/ensure [:question/validate]} {:db/id "answer-field-2933141c-2169-5b87-8fb5-b8ed2e025c9c" :answer-field/id #uuid "2933141c-2169-5b87-8fb5-b8ed2e025c9c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-76419d8d-c305-5619-a8a2-c0287e5dda0d" :answer-field/choices ["answer-76419d8d-c305-5619-a8a2-c0287e5dda0d"] :db/ensure [:answer-field/validate]} {:db/id "answer-76419d8d-c305-5619-a8a2-c0287e5dda0d" :answer/id #uuid "76419d8d-c305-5619-a8a2-c0287e5dda0d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-f3dc74ec-4f14-5ce0-aef2-9920a7e3da3c" :answer-field/id #uuid "f3dc74ec-4f14-5ce0-aef2-9920a7e3da3c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9d157cb9-9968-5484-a3c7-ab43310ab864" :answer-field/choices ["answer-9d157cb9-9968-5484-a3c7-ab43310ab864"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d157cb9-9968-5484-a3c7-ab43310ab864" :answer/id #uuid "9d157cb9-9968-5484-a3c7-ab43310ab864" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-9f12c9a5-b2a0-5f55-8200-bc2b6ab50775" :answer-field/id #uuid "9f12c9a5-b2a0-5f55-8200-bc2b6ab50775" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cafae102-8ddc-57ce-b89b-eb060527e40e" :answer-field/choices ["answer-cafae102-8ddc-57ce-b89b-eb060527e40e"] :db/ensure [:answer-field/validate]} {:db/id "answer-cafae102-8ddc-57ce-b89b-eb060527e40e" :answer/id #uuid "cafae102-8ddc-57ce-b89b-eb060527e40e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "question-2e73d348-8d9b-5a9f-8dbf-5305290f7f53" :question/id #uuid "2e73d348-8d9b-5a9f-8dbf-5305290f7f53" :question/math-academy-id "q-332913" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]x(t)+{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}].\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={x}_{c}(t)+$ {{field-1}} $\\cdot \\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution is also exponential, i.e.\n\n$$\n{x}_{p}(t)={e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}],\n$$\n\nwhere $a,b$  are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=-3{e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}-3{e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]\\cdot {e}^{-3t}[\\begin{aligned}a \\\\ b\\end{aligned}]+{e}^{-3t}[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ -3[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}0 & -2 \\\\ 2 & 0\\end{aligned}]\\cdot [\\begin{aligned}a \\\\ b\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-3a \\\\ -3b\\end{aligned}] & =[\\begin{aligned}-2b \\\\ 2a\\end{aligned}]+[\\begin{aligned}1 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}-3a \\\\ -3b\\end{aligned}] & =[\\begin{aligned}-2b+1 \\\\ 2a+5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}-2b+1=-3a \\\\ 2a+5=-3b\\end{aligned}\n$$\n\nFrom the first equation, we get \n\n$$\n-2b+1=-3a\\,⇒\\,a=\\frac{2b-1}{3}.\n$$\n\n \nSubstituting this into the second equation and solving for $b,$ we have\n\n$$\n2(\\frac{2b-1}{3})+5=-3b\\,⇒\\,4b-2+15=-9b\\,⇒\\,b=-1.\n$$\n\nSo,\n\n$$\na=\\frac{2(-1)-1}{3}=\\frac{-2-1}{3}=-1.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)={e}^{-3t}[\\begin{aligned}-1 \\\\ -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c17466c-b8ca-50c3-9f75-a6a53610a6c3" "answer-field-79975f54-a6ab-5d67-8f15-fd4af267d146"] :db/ensure [:question/validate]} {:db/id "answer-field-6c17466c-b8ca-50c3-9f75-a6a53610a6c3" :answer-field/id #uuid "6c17466c-b8ca-50c3-9f75-a6a53610a6c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer-field/choices ["answer-731aa6f4-9b42-511b-99eb-f375784ef6ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer/id #uuid "731aa6f4-9b42-511b-99eb-f375784ef6ae" :answer/type :answer.type/math :answer/value "e^{-3t}" :db/ensure [:answer/validate]} {:db/id "answer-field-79975f54-a6ab-5d67-8f15-fd4af267d146" :answer-field/id #uuid "79975f54-a6ab-5d67-8f15-fd4af267d146" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-26d00d5e-9f6b-5691-9183-ca640417b15f" :answer-field/choices ["answer-26d00d5e-9f6b-5691-9183-ca640417b15f"] :db/ensure [:answer-field/validate]} {:db/id "answer-26d00d5e-9f6b-5691-9183-ca640417b15f" :answer/id #uuid "26d00d5e-9f6b-5691-9183-ca640417b15f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186167169 :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 3 \\\\ 1 & -1\\end{aligned}]x(t)+[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$x(t)={x}_{c}(t)+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$3/2$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,\\,t+\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$1/2$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $1.$ Therefore, we assume that the particular solution is also polynomial of degree $1,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}t+{b}_{1} \\\\ {a}_{2}t+{b}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2}$  are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 3 \\\\ 1 & -1\\end{aligned}]([\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}])+[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}] \\\\ [\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}] & =[\\begin{aligned}{a}_{1}+3{a}_{2} \\\\ {a}_{1}-{a}_{2}\\end{aligned}]t+[\\begin{aligned}{b}_{1}+3{b}_{2} \\\\ {b}_{1}-{b}_{2}\\end{aligned}]+[\\begin{aligned}1 \\\\ -2t+1\\end{aligned}] \\\\ [\\begin{aligned}0t+{a}_{1} \\\\ 0t+{a}_{2}\\end{aligned}] & =[\\begin{aligned}({a}_{1}+3{a}_{2})t+({b}_{1}+3{b}_{2}+1) \\\\ ({a}_{1}-{a}_{2}-2)t+({b}_{1}-{b}_{2}+1)\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n\\{\\begin{aligned}{a}_{1}+3{a}_{2}=0 \\\\ {a}_{1}-{a}_{2}-2=0 \\\\ {b}_{1}+3{b}_{2}+1={a}_{1} \\\\ {b}_{1}-{b}_{2}+1={a}_{2}\\end{aligned}\n$$\n\nSolving the first two equations, we get \n\n$$\n{a}_{1}=\\frac{3}{2},\\,{a}_{2}=-\\frac{1}{2}.\n$$\n\n \nSubstituting these into the third and fourth equations, and solving for ${b}_{1}$ and ${b}_{2},$ we have\n\n$$\n{b}_{1}=-1,\\,{b}_{2}=\\frac{1}{2}.\n$$\n\n \n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}3/2 \\\\ -1/2\\end{aligned}]t+[\\begin{aligned}-1 \\\\ 1/2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186164048 :answer-field/correct "answer-68397710-f20c-5389-86e2-ff7174f9153b" :answer-field/choices ["answer-68397710-f20c-5389-86e2-ff7174f9153b"] :db/ensure [:answer-field/validate]} {:db/id "answer-68397710-f20c-5389-86e2-ff7174f9153b" :answer/id #uuid "68397710-f20c-5389-86e2-ff7174f9153b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186164047 :answer-field/correct "answer-168093fa-9a63-55ce-a515-83e652a3a0ce" :answer-field/choices ["answer-168093fa-9a63-55ce-a515-83e652a3a0ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-168093fa-9a63-55ce-a515-83e652a3a0ce" :answer/id #uuid "168093fa-9a63-55ce-a515-83e652a3a0ce" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186167990 :tutorial/content "Consider an **inhomogeneous** linear system of ordinary differential equations in component form:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)={a}_{11}{x}_{1}(t)+{a}_{12}{x}_{2}(t)+{f}_{1}(t) \\\\ {x}_{2}^{′}(t)={a}_{21}{x}_{1}(t)+{a}_{22}{x}_{2}(t)+{f}_{2}(t)\\end{aligned}\n$$\n\nHere, we can package the unknown functions into vectors\n![](images/03/037289f6f3a779d750cef23dc18d149786604bd477565e3708d6470f2e3c2f7a.svg)\n\nThen, the system can be written as\n![](images/77/77fc846681e1f0a98675b06f962e42f4491fd07d9bb2eab291e69cd49e4dd5f9.svg)\n\nOften, the **forcing functions** $f_1(t), f_2(t)$ are linear combinations of a few basic functions (such as $e^{3t},$ $t^2,$ or $\\sin t$).\nIn that case, it is useful to write $\\mathbf{g}(t)$ as a sum of those basic functions times constant vectors.\n\nFor example, let's write down the system of linear ODEs below in matrix form.\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t)+2{x}_{2}(t)+8{e}^{3t} \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+5{x}_{2}(t)+10{e}^{4t}\\end{aligned}\n$$\n\nFirst, let's rewrite our system, highlighting the coefficients:\n\n$$\n\\{\\begin{aligned}{x}_{1}^{′}(t)=4\\cdot {x}_{1}(t)+2\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 8+{e}^{4t}\\cdot 0 \\\\ {x}_{2}^{′}(t)=(-3)\\cdot {x}_{1}(t)+5\\cdot {x}_{2}(t)+{e}^{3t}\\cdot 0+{e}^{4t}\\cdot 10\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n![](images/47/47fb751641455ab4cf85756166fa8811bd8fe3ddc6bcb6005c8e6be8c31b6fe1.svg)\nwhere ![](images/f4/f47e1272123fb8f4a5f54931929b9492f54e9d78d590b2ee28394bf29976ce44.svg)" :db/ensure [:tutorial/validate]} [:db/retract 17592186065571 :answer-field/choices 17592186065572] [:db/retract 17592186065571 :answer-field/choices 17592186065573] [:db/retract 17592186065571 :answer-field/choices 17592186065574] [:db/retract 17592186065571 :answer-field/choices 17592186065575] [:db/retract 17592186065571 :answer-field/choices 17592186065576] {:db/id 17592186068816 :knowledge-point/questions ["question-dfd26745-ef58-57dc-ac34-552acd1f12bb" "question-95c12fb3-5acd-5573-a477-4562c842d9b2" "question-5e9d38c5-007b-59fb-ae42-189521635fd6" "question-ba5c4320-47ed-5bb0-ac9c-df1a49799343"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068658 :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}4y-{y}^{2} & =0 \\\\ y(4-y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0, \\, 4.$ So, we need to integrate from $y=0$ to $y=4.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{4}y(4y-{y}^{2})\\text{d}y\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068815 :knowledge-point/questions ["question-a00b0b94-53a1-5e23-84f6-859ac793fc56" "question-2d1d4e63-93d8-5dc2-a21f-3d16bb6f6063" "question-7e282fab-f673-50f6-9e1f-aaa485da50b0" "question-2fefe340-5c6b-584d-b7e8-9e9204c610ea" "question-69689ccc-dfd4-5812-991b-d48dbc7eafee"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068657 :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}2y-2{y}^{2} & =0 \\\\ 2y(1-y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0,$ and $y=1.$ So, we need to integrate from $y=0$ to $y=1.$\n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}y(2y-2{y}^{2})\\text{d}y \\\\  & =4\\pi {\\int }_{0}^{1}({y}^{2}-{y}^{3})\\text{d}y \\\\  & =4\\pi ({\\int }_{0}^{1}{y}^{2}\\,\\text{d}y-{\\int }_{0}^{1}{y}^{3}\\text{d}y) \\\\  & =4\\pi ({\\frac{{y}^{3}}{3}|}_{0}^{1}-{\\frac{{y}^{4}}{4}|}_{0}^{1}) \\\\  & =4\\pi ((\\frac{1}{3}-0)-(\\frac{1}{4}-0)) \\\\  & =4\\pi (\\frac{1}{3}-\\frac{1}{4}) \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-dfd26745-ef58-57dc-ac34-552acd1f12bb" :question/id #uuid "dfd26745-ef58-57dc-ac34-552acd1f12bb" :question/math-academy-id "q-126096" :question/problem "![](images/93/9312e042b08ce1aae28eab8bb64aff176fc734c38184d781e348dc5ec6058bfa.png)\n\nConsider the finite region bounded by the curve $x=2y-{y}^{2}$ and the $y$-axis, as shown above. What integral gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}2y-{y}^{2} & =0 \\\\ y(2-y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0,\\,2.$ So, we need to integrate from $y=0$ to $y=2.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{2}y(2y-{y}^{2})\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2b95eaef-e2fd-5998-918b-1e34d13f0c04"] :db/ensure [:question/validate]} {:db/id "answer-field-2b95eaef-e2fd-5998-918b-1e34d13f0c04" :answer-field/id #uuid "2b95eaef-e2fd-5998-918b-1e34d13f0c04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f247f7a-bbf1-566b-9d05-2c29d25edb50" :answer-field/choices ["answer-85a5aadc-9953-5566-ac62-5935c913aa33" "answer-9f247f7a-bbf1-566b-9d05-2c29d25edb50" "answer-b5097f17-7b98-5fbe-a1ef-5964286ea6b4" "answer-44f4f718-3229-5c1c-a6c6-14499190e1b2" "answer-46d7a4cf-042b-53e7-8783-3972f6587646"] :db/ensure [:answer-field/validate]} {:db/id "answer-85a5aadc-9953-5566-ac62-5935c913aa33" :answer/id #uuid "85a5aadc-9953-5566-ac62-5935c913aa33" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1}y(2y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-9f247f7a-bbf1-566b-9d05-2c29d25edb50" :answer/id #uuid "9f247f7a-bbf1-566b-9d05-2c29d25edb50" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}y(2y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-b5097f17-7b98-5fbe-a1ef-5964286ea6b4" :answer/id #uuid "b5097f17-7b98-5fbe-a1ef-5964286ea6b4" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}y{(2y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-44f4f718-3229-5c1c-a6c6-14499190e1b2" :answer/id #uuid "44f4f718-3229-5c1c-a6c6-14499190e1b2" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}{(2y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-46d7a4cf-042b-53e7-8783-3972f6587646" :answer/id #uuid "46d7a4cf-042b-53e7-8783-3972f6587646" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}{(2y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-95c12fb3-5acd-5573-a477-4562c842d9b2" :question/id #uuid "95c12fb3-5acd-5573-a477-4562c842d9b2" :question/math-academy-id "q-105681" :question/problem "![](images/5a/5a9564ba5a69f4bafa8ff85275ee009b133101aa36c682dd3e50efc949c76d92.png)\n\nConsider the finite region bounded by the curve $x=-4+5y-{y}^{2}$ and the $y$-axis, as shown above. What integral gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}-4+5y-{y}^{2} & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0\\end{aligned}\n$$\n\nThe solutions are $y=1,\\,4.$ So, we need to integrate from $y=1$ to $y=4.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{4}y(-4+5y-{y}^{2})\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d315d1c5-713f-573c-8e7e-e10cf3b7508b"] :db/ensure [:question/validate]} {:db/id "answer-field-d315d1c5-713f-573c-8e7e-e10cf3b7508b" :answer-field/id #uuid "d315d1c5-713f-573c-8e7e-e10cf3b7508b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1a197b4-bd42-5a30-a39c-ab3ec0c5de82" :answer-field/choices ["answer-db0b3956-a9bc-5908-adb2-c6941993f772" "answer-9ed39119-aac9-5284-a6df-cb94eea8b8c0" "answer-f1a197b4-bd42-5a30-a39c-ab3ec0c5de82" "answer-97b0c3d5-9428-5059-9aac-4e5b185105dd" "answer-6c6a9ef1-58fa-5280-a803-6c73dd0c4040"] :db/ensure [:answer-field/validate]} {:db/id "answer-db0b3956-a9bc-5908-adb2-c6941993f772" :answer/id #uuid "db0b3956-a9bc-5908-adb2-c6941993f772" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{1}^{3}y(-4+5y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-9ed39119-aac9-5284-a6df-cb94eea8b8c0" :answer/id #uuid "9ed39119-aac9-5284-a6df-cb94eea8b8c0" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{1}^{4}(-4+5y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-f1a197b4-bd42-5a30-a39c-ab3ec0c5de82" :answer/id #uuid "f1a197b4-bd42-5a30-a39c-ab3ec0c5de82" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{1}^{4}y(-4+5y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-97b0c3d5-9428-5059-9aac-4e5b185105dd" :answer/id #uuid "97b0c3d5-9428-5059-9aac-4e5b185105dd" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{3}{(-4+5y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-6c6a9ef1-58fa-5280-a803-6c73dd0c4040" :answer/id #uuid "6c6a9ef1-58fa-5280-a803-6c73dd0c4040" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{4}{(-4+5y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-5e9d38c5-007b-59fb-ae42-189521635fd6" :question/id #uuid "5e9d38c5-007b-59fb-ae42-189521635fd6" :question/math-academy-id "q-126100" :question/problem "![](images/cc/cc7b2e67a5137b32917d8b96e3a53f66266e3ecabc2738b2a42417e87664457b.png)\n\nConsider the finite region bounded by the curve $x=-3+4y-{y}^{2}$ and the $y$-axis, as shown above. What integral gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}-3+4y-{y}^{2} & =0 \\\\ {y}^{2}-4y+3 & =0 \\\\ (y-1)(y-3) & =0\\end{aligned}\n$$\n\nThe solutions are $y=1,\\,3.$ So, we need to integrate from $y=1$ to $y=3.$ \n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{3}y(-3+4y-{y}^{2})\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3b615012-8d63-5680-878a-26a4ccb9be61"] :db/ensure [:question/validate]} {:db/id "answer-field-3b615012-8d63-5680-878a-26a4ccb9be61" :answer-field/id #uuid "3b615012-8d63-5680-878a-26a4ccb9be61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-23e64d86-05a9-5382-8c0a-8a18e65807bd" :answer-field/choices ["answer-23e64d86-05a9-5382-8c0a-8a18e65807bd" "answer-ca20c5e1-7e01-5336-993d-49aa824f3191" "answer-d2f7f47c-8665-51b7-83f7-b83cd4d703f4" "answer-2746730c-99ed-5dd7-b005-677ed8644940" "answer-bcdc6463-6f32-5d66-8da7-95ff3a36dfb6"] :db/ensure [:answer-field/validate]} {:db/id "answer-23e64d86-05a9-5382-8c0a-8a18e65807bd" :answer/id #uuid "23e64d86-05a9-5382-8c0a-8a18e65807bd" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{1}^{3}y(-3+4y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-ca20c5e1-7e01-5336-993d-49aa824f3191" :answer/id #uuid "ca20c5e1-7e01-5336-993d-49aa824f3191" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{1}^{3}{y}^{2}(-3+4y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-d2f7f47c-8665-51b7-83f7-b83cd4d703f4" :answer/id #uuid "d2f7f47c-8665-51b7-83f7-b83cd4d703f4" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{2}^{6}y(-3+4y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-2746730c-99ed-5dd7-b005-677ed8644940" :answer/id #uuid "2746730c-99ed-5dd7-b005-677ed8644940" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{3}{(-3+4y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-bcdc6463-6f32-5d66-8da7-95ff3a36dfb6" :answer/id #uuid "bcdc6463-6f32-5d66-8da7-95ff3a36dfb6" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{6}{(-3+4y-{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186069023 :question/problem "Consider the finite region bounded by the curve $x=y-2{y}^{2}$ and the $y$-axis. What integral gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}y-2{y}^{2} & =0 \\\\ y(1-2y) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=\\frac{1}{2}.$ So, we need to integrate from $y=0$ to $y=\\frac{1}{2}.$\n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/2}y(y-2{y}^{2})\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186065571 :answer-field/correct "answer-57b88155-699b-5d53-b1ab-30536f6a3ca5" :answer-field/choices ["answer-b69e2f70-b6fa-5b42-b438-05a6ef6f2697" "answer-57b88155-699b-5d53-b1ab-30536f6a3ca5" "answer-6ae364df-1e16-5dda-81a1-fd58f62da5fb" "answer-ac998975-6c85-534b-b1a2-c8c89b1565da" "answer-7d9b062f-5840-5d1b-986d-1b39cbeafdbf"] :db/ensure [:answer-field/validate]} {:db/id "answer-b69e2f70-b6fa-5b42-b438-05a6ef6f2697" :answer/id #uuid "b69e2f70-b6fa-5b42-b438-05a6ef6f2697" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1/2}(y-2{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-57b88155-699b-5d53-b1ab-30536f6a3ca5" :answer/id #uuid "57b88155-699b-5d53-b1ab-30536f6a3ca5" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{1/2}y(y-2{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-6ae364df-1e16-5dda-81a1-fd58f62da5fb" :answer/id #uuid "6ae364df-1e16-5dda-81a1-fd58f62da5fb" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{0}^{2}y(y-2{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-ac998975-6c85-534b-b1a2-c8c89b1565da" :answer/id #uuid "ac998975-6c85-534b-b1a2-c8c89b1565da" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1/2}{(y-2{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-7d9b062f-5840-5d1b-986d-1b39cbeafdbf" :answer/id #uuid "7d9b062f-5840-5d1b-986d-1b39cbeafdbf" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}{(y-2{y}^{2})}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-ba5c4320-47ed-5bb0-ac9c-df1a49799343" :question/id #uuid "ba5c4320-47ed-5bb0-ac9c-df1a49799343" :question/math-academy-id "q-105733" :question/problem "Consider the finite region bounded by the curve $x=\\sqrt{-6+5y-{y}^{2}}$ and the $y$-axis. What integral gives the volume of the solid generated when that region is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}\\sqrt{-6+5y-{y}^{2}} & =0 \\\\ -6+5y-{y}^{2} & =0 \\\\ -({y}^{2}-5y+6) & =0 \\\\ -(y-2)(y-3) & =0\\end{aligned}\n$$\n\nThe solutions are $y=2$ and $y=3.$ So, we need to integrate from $y=2$ to $y=3.$\n\nUsing the shell method, the volume of the solid can be expressed as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{2}^{3}y\\sqrt{-6+5y-{y}^{2}}\\,\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6a153ace-3e22-541c-9fa2-ba67f8c82867"] :db/ensure [:question/validate]} {:db/id "answer-field-6a153ace-3e22-541c-9fa2-ba67f8c82867" :answer-field/id #uuid "6a153ace-3e22-541c-9fa2-ba67f8c82867" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-36142af1-4277-5631-afe9-37489dbc8dbe" :answer-field/choices ["answer-1b6a583d-c7ca-5341-8533-78d10b205d96" "answer-61d31fb5-3fa5-56c4-b3eb-78b0cadb7b76" "answer-36142af1-4277-5631-afe9-37489dbc8dbe" "answer-758b93bf-e6ed-5af8-9b01-44c043df134d" "answer-eff7a488-ad07-5710-adc9-b07871f78778"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b6a583d-c7ca-5341-8533-78d10b205d96" :answer/id #uuid "1b6a583d-c7ca-5341-8533-78d10b205d96" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{1}^{5}y\\sqrt{-6+5y-{y}^{2}}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-61d31fb5-3fa5-56c4-b3eb-78b0cadb7b76" :answer/id #uuid "61d31fb5-3fa5-56c4-b3eb-78b0cadb7b76" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{2}^{3}\\sqrt{-6+5y-{y}^{2}}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-36142af1-4277-5631-afe9-37489dbc8dbe" :answer/id #uuid "36142af1-4277-5631-afe9-37489dbc8dbe" :answer/type :answer.type/math :answer/value "2\\pi {\\int }_{2}^{3}y\\sqrt{-6+5y-{y}^{2}}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-758b93bf-e6ed-5af8-9b01-44c043df134d" :answer/id #uuid "758b93bf-e6ed-5af8-9b01-44c043df134d" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{5}(-6+5y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-eff7a488-ad07-5710-adc9-b07871f78778" :answer/id #uuid "eff7a488-ad07-5710-adc9-b07871f78778" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{3}(-6+5y-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-a00b0b94-53a1-5e23-84f6-859ac793fc56" :question/id #uuid "a00b0b94-53a1-5e23-84f6-859ac793fc56" :question/math-academy-id "q-362710" :question/problem "![](images/3d/3dbd6e325acdddddfb0bdcca5eef77fc3e75df2ccf946592780a0e1043ee1b01.png)\n\nConsider the region bounded by the curve $x=-\\sqrt{y}+y$ and the $y$-axis from $y=0$ to $y=1$ (shown in the picture). Using the shell method, calculate the volume of the solid generated when that region is rotated about the $x$-axis.\n\n$V=$\n{{field-1}}" :question/worked-solution "The region is enclosed between the $y$-axis, the curve $x=-\\sqrt{y}+y$, and the lines $y=0$ and $y=1.$ So, we need to integrate from $y=0$ to $y=1.$ \n\nSince the region lies to the left of the $y$-axis, the width of the cylindrical shells is given by $f(y)=0-(-\\sqrt{y}+y)=\\sqrt{y}-y.$ Using the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}y(\\sqrt{y}-y)\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}({y}^{3/2}-{y}^{2})\\text{d}y \\\\  & =2\\pi ({\\int }_{0}^{1}{y}^{3/2}\\,\\text{d}y-{\\int }_{0}^{1}{y}^{2}\\,\\text{d}y) \\\\  & =2\\pi ({\\frac{2{y}^{5/2}}{5}|}_{0}^{1}-{\\frac{{y}^{3}}{3}|}_{0}^{1}) \\\\  & =2\\pi ((\\frac{2}{5}-0)-(\\frac{1}{3}-0)) \\\\  & =2\\pi (\\frac{2}{5}-\\frac{1}{3}) \\\\  & =\\frac{2\\pi }{15}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0682446c-0c6a-5d39-8e65-0e1157e67525"] :db/ensure [:question/validate]} {:db/id "answer-field-0682446c-0c6a-5d39-8e65-0e1157e67525" :answer-field/id #uuid "0682446c-0c6a-5d39-8e65-0e1157e67525" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-85964491-e360-5d94-bffc-8e0d1ef8230f" :answer-field/choices ["answer-85964491-e360-5d94-bffc-8e0d1ef8230f"] :db/ensure [:answer-field/validate]} {:db/id "answer-85964491-e360-5d94-bffc-8e0d1ef8230f" :answer/id #uuid "85964491-e360-5d94-bffc-8e0d1ef8230f" :answer/type :answer.type/math :answer/value "\\frac{2\\pi}{15}" :db/ensure [:answer/validate]} {:db/id "question-2d1d4e63-93d8-5dc2-a21f-3d16bb6f6063" :question/id #uuid "2d1d4e63-93d8-5dc2-a21f-3d16bb6f6063" :question/math-academy-id "q-352098" :question/problem "![](images/7d/7d6ef1d9a58af96b51152ce354ec85c616921187ed467273e8c41c4fe93fc19c.png)\n\nConsider the region bounded by the curve $x={y}^{2}-5{y}^{4}$ and the $y$-axis (shown in the picture). Using the shell method, calculate the volume of the solid generated when that region is rotated about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-5{y}^{4} & =0 \\\\ {y}^{2}(1-5{y}^{2}) & =0 \\\\ y & =0\\,\\text{or}\\,{y}^{2}=\\frac{1}{5} \\\\ y & =0\\,\\text{or}\\,y=\\frac{1}{\\sqrt{5}}\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=\\frac{1}{\\sqrt{5}}.$ So, we need to integrate from $y=0$ to $y=\\frac{1}{\\sqrt{5}}.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/\\sqrt{5}}y({y}^{2}-5{y}^{4})\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/\\sqrt{5}}({y}^{3}-5{y}^{5})\\,\\text{d}y \\\\  & =2\\pi ({\\int }_{0}^{1/\\sqrt{5}}{y}^{3}\\,\\text{d}y-5{\\int }_{0}^{1/\\sqrt{5}}{y}^{5}\\,\\text{d}y) \\\\  & =2\\pi (\\frac{1}{4}{y}^{4}\\,{|}_{0}^{1/\\sqrt{5}}-\\frac{5}{6}{y}^{6}\\,{|}_{0}^{1/\\sqrt{5}}\\,) \\\\  & =2\\pi (\\frac{1}{4}(\\frac{1}{25}-0)-\\frac{5}{6}(\\frac{1}{125}-0)) \\\\  & =2\\pi (\\frac{1}{100}-\\frac{1}{150}) \\\\  & =2\\pi (\\frac{1}{300}) \\\\  & =\\frac{\\pi }{150}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d7d44499-1aa4-52d0-a15f-ec7d8581275c"] :db/ensure [:question/validate]} {:db/id "answer-field-d7d44499-1aa4-52d0-a15f-ec7d8581275c" :answer-field/id #uuid "d7d44499-1aa4-52d0-a15f-ec7d8581275c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0db6ee6f-edbb-5e5c-b2d1-764a2ea9a097" :answer-field/choices ["answer-0db6ee6f-edbb-5e5c-b2d1-764a2ea9a097"] :db/ensure [:answer-field/validate]} {:db/id "answer-0db6ee6f-edbb-5e5c-b2d1-764a2ea9a097" :answer/id #uuid "0db6ee6f-edbb-5e5c-b2d1-764a2ea9a097" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{150}" :db/ensure [:answer/validate]} {:db/id "question-7e282fab-f673-50f6-9e1f-aaa485da50b0" :question/id #uuid "7e282fab-f673-50f6-9e1f-aaa485da50b0" :question/math-academy-id "q-352100" :question/problem "![](images/69/69dbf7a007980f1f1a9c2531ad398237e22d28f329afc619e05b8372afe970d4.png)\n\nConsider the region bounded by the curve $x={y}^{2}-2{y}^{3}$ and the $y$-axis (shown in the picture). Using the shell method, calculate the volume of the solid generated when that region is rotated about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2}-2{y}^{3} & =0 \\\\ {y}^{2}(1-2y) & =0 \\\\ y & =0\\,\\text{or}\\,1-2y=0 \\\\ y & =0\\,\\text{or}\\,y=\\frac{1}{2}\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=\\frac{1}{2}.$ So, we need to integrate from $y=0$ to $y=\\frac{1}{2}.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/2}y({y}^{2}-2{y}^{3})\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1/2}({y}^{3}-2{y}^{4})\\,\\text{d}y \\\\  & =2\\pi ({\\int }_{0}^{1/2}{y}^{3}\\,\\text{d}y-2{\\int }_{0}^{1/2}{y}^{4}\\,\\text{d}y) \\\\  & =2\\pi (\\frac{1}{4}{y}^{4}\\,{|}_{0}^{1/2}-\\frac{2}{5}{y}^{5}\\,{|}_{0}^{1/2}\\,) \\\\  & =2\\pi (\\frac{1}{4}(\\frac{1}{16}-0)-\\frac{2}{5}(\\frac{1}{32}-0)) \\\\  & =2\\pi (\\frac{1}{64}-\\frac{1}{80}) \\\\  & =2\\pi (\\frac{1}{320}) \\\\  & =\\frac{\\pi }{160}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2c795d78-7949-57ee-a8d5-8e5d26c90629"] :db/ensure [:question/validate]} {:db/id "answer-field-2c795d78-7949-57ee-a8d5-8e5d26c90629" :answer-field/id #uuid "2c795d78-7949-57ee-a8d5-8e5d26c90629" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2e920f28-4383-54cc-9cc9-d78d86338f95" :answer-field/choices ["answer-2e920f28-4383-54cc-9cc9-d78d86338f95"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e920f28-4383-54cc-9cc9-d78d86338f95" :answer/id #uuid "2e920f28-4383-54cc-9cc9-d78d86338f95" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{160}" :db/ensure [:answer/validate]} {:db/id "question-2fefe340-5c6b-584d-b7e8-9e9204c610ea" :question/id #uuid "2fefe340-5c6b-584d-b7e8-9e9204c610ea" :question/math-academy-id "q-126111" :question/problem "![](images/28/287bde55681f44bd4132fdd5b4777a66d3dba7b16708533d755379c41f35b797.png)\n\nConsider the finite region bounded by the curve $x=-3+4y-{y}^{2}$ and the $y$-axis, as shown above. Calculate the volume of the solid generated when this region is rotated $2\\pi $ radians about the $x$-axis." :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}-3+4y-{y}^{2} & =0 \\\\ {y}^{2}-4y+3 & =0 \\\\ (y-1)(y-3) & =0\\end{aligned}\n$$\n\nThe solutions are $y=1,$ and $y=3.$ So, we need to integrate from $y=1$ to $y=3.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{3}y(-3+4y-{y}^{2})\\text{d}y \\\\  & =2\\pi {\\int }_{1}^{3}(-3y+4{y}^{2}-{y}^{3})\\text{d}y \\\\  & =2\\pi (-3{\\int }_{1}^{3}y\\,\\text{d}y+4{\\int }_{1}^{3}{y}^{2}\\text{d}y-{\\int }_{1}^{3}{y}^{3}\\text{d}y) \\\\  & =2\\pi (-3\\cdot {\\frac{{y}^{2}}{2}|}_{1}^{3}+4\\cdot {\\frac{{y}^{3}}{3}|}_{1}^{3}-{\\frac{{y}^{4}}{4}|}_{1}^{3}) \\\\  & =2\\pi (-3(\\frac{9}{2}-\\frac{1}{2})+4(\\frac{27}{3}-\\frac{1}{3})-(\\frac{81}{4}-\\frac{1}{4})) \\\\  & =2\\pi (-12+\\frac{104}{3}-20) \\\\  & =\\frac{16\\pi }{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1289d38d-0117-531f-a4f5-10acc347ae1c"] :db/ensure [:question/validate]} {:db/id "answer-field-1289d38d-0117-531f-a4f5-10acc347ae1c" :answer-field/id #uuid "1289d38d-0117-531f-a4f5-10acc347ae1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b94c6a5-9527-5477-a1a3-7f03234197e5" :answer-field/choices ["answer-03592d71-01c8-5c8e-8dc1-555c9e33cf9a" "answer-3b94c6a5-9527-5477-a1a3-7f03234197e5" "answer-7732a064-ce3b-5465-88a9-cfdd49f7a517" "answer-432c08ab-5b41-5def-a73b-e813b7482639" "answer-0c15f7c1-4bcc-5b00-9a47-f77a64d0f457"] :db/ensure [:answer-field/validate]} {:db/id "answer-03592d71-01c8-5c8e-8dc1-555c9e33cf9a" :answer/id #uuid "03592d71-01c8-5c8e-8dc1-555c9e33cf9a" :answer/type :answer.type/math :answer/value "\\frac{14\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-3b94c6a5-9527-5477-a1a3-7f03234197e5" :answer/id #uuid "3b94c6a5-9527-5477-a1a3-7f03234197e5" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-7732a064-ce3b-5465-88a9-cfdd49f7a517" :answer/id #uuid "7732a064-ce3b-5465-88a9-cfdd49f7a517" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-432c08ab-5b41-5def-a73b-e813b7482639" :answer/id #uuid "432c08ab-5b41-5def-a73b-e813b7482639" :answer/type :answer.type/math :answer/value "\\frac{18\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-0c15f7c1-4bcc-5b00-9a47-f77a64d0f457" :answer/id #uuid "0c15f7c1-4bcc-5b00-9a47-f77a64d0f457" :answer/type :answer.type/math :answer/value "\\frac{8\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "question-69689ccc-dfd4-5812-991b-d48dbc7eafee" :question/id #uuid "69689ccc-dfd4-5812-991b-d48dbc7eafee" :question/math-academy-id "q-363229" :question/problem "Consider the finite region bounded by the curve $x=5y-5{y}^{4}$ and the $y$-axis. Calculate the volume $V$ of the solid generated when this region is rotated $2\\pi $ radians about the $x$-axis. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we determine the points where the curve intersects the $y$-axis by solving the following equation for $y:$\n\n$$\n\\begin{aligned}5y-5{y}^{4} & =0 \\\\ 5y(1-{y}^{3}) & =0\\end{aligned}\n$$\n\nThe solutions are $y=0$ and $y=1.$ So, we need to integrate from $y=0$ to $y=1.$ \n\nUsing the shell method, the volume of the solid can be found as follows:\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}y(5y-5{y}^{4})\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}(5{y}^{2}-5{y}^{5})\\,\\text{d}y \\\\  & =2\\pi (5{\\int }_{0}^{1}{y}^{2}\\,\\text{d}y-5{\\int }_{0}^{1}{y}^{5}\\,\\text{d}y) \\\\  & =2\\pi (\\frac{5}{3}{y}^{3}\\,{|}_{0}^{1}-\\frac{5}{6}{y}^{6}\\,{|}_{0}^{1}\\,) \\\\  & =2\\pi (\\frac{5}{3}(1-0)-\\frac{5}{6}(1-0)) \\\\  & =2\\pi (\\frac{5}{3}-\\frac{5}{6}) \\\\  & =2\\pi \\cdot \\frac{5}{6} \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a692812a-555a-5732-b8c5-43f45d5cfb92"] :db/ensure [:question/validate]} {:db/id "answer-field-a692812a-555a-5732-b8c5-43f45d5cfb92" :answer-field/id #uuid "a692812a-555a-5732-b8c5-43f45d5cfb92" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1b2bc8ac-9cce-5432-82e4-a0d93044820f" :answer-field/choices ["answer-1b2bc8ac-9cce-5432-82e4-a0d93044820f"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b2bc8ac-9cce-5432-82e4-a0d93044820f" :answer/id #uuid "1b2bc8ac-9cce-5432-82e4-a0d93044820f" :answer/type :answer.type/math :answer/value "\\frac{5\\pi}{3}" :db/ensure [:answer/validate]} {:db/id 17592186069988 :tutorial/content "Consider the plane region enclosed by the curve $x=f(y),$ the $y$-axis, and the horizontal lines $y=c$ and $y=d,$ as shown below. If we rotate this region $2\\pi$ radians about the $x$-axis, we get a solid of revolution.\n\n![](images/19/1927064dcef318f2c0490ff071532b024da30a328b2752c28e197171eeec6b5f.png)\n\nOne way of computing the volume of the solid is to divide the interval from $y=c$ to $y=d$ on the $y$-axis to get horizontal slices. This approach is called the **shell method**.\n\nConsider one such slice of height $\\Delta{y},$ as shown in the picture below (on the left). When this rectangle is rotated about the $x$-axis, it forms a solid **shell** (i.e., the skin of a cylinder).\n\n![](images/25/2561448ab909594dda427b76860fcdda5147f8966fec9e20958d1c5fca11b536.png)\n\nSince we assume that $\\Delta{y}$ is very small, the outer radius of the shell approximately equals the inner radius $y.$ The thickness of the shell is $\\Delta{y}$ and its height is $x=f(y)$.\n\nImagine we cut this shell and unfold it to obtain a rectangular solid, as shown below. Its width is $x=f(y)$, its thickness is $\\Delta{y},$ and its height is $2\\pi y$ (the circumference of the shell).\n\n![](images/03/03030fb80f0aa51c637e6d39b4f763e8d7fc89abd111a012d3e560a952cfba99.png)\n\nThe volume of the shell approximately equals the volume of the rectangular solid:\n\n$$\n\\begin{aligned}{V}_{\\text{shell}} & ≈{V}_{\\text{rec}} \\\\  & =2\\pi y\\cdot x\\cdot Δy \\\\  & =2\\pi yf(y)Δy\\end{aligned}\n$$\n\nThe sum over all the shells will approximate the total volume that we want. This approximation becomes more accurate as $\\Delta{y} \\to 0$. Therefore, the volume $V$ of the solid is given by\n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{c}^{d}yx\\,\\text{d}y \\\\  & =2\\pi {\\int }_{c}^{d}y\\,f(y)\\,\\text{d}y.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186069989 :tutorial/content "One of the advantages of using the shell method versus other methods is that the resulting integral can be much simpler to evaluate. This is often true when we want to rotate a curve of the form $x = f(y)$ about the $x$-axis.\n\nFor example, suppose we want to compute the volume generated when the region below is rotated about the $x$-axis:\n\n![](images/1d/1d23dde2cdd557feb50f82f72f4ff09174d5fb9a0c94e7810a6c06acb95a13d0.png)\n\nAccording to the shell method, the volume $V$ is given by the following straightforward integral: \n\n$$\n\\begin{aligned}V & =2\\pi {\\int }_{0}^{1}yf(y)\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}y(2y-2{y}^{2})\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{1}2{y}^{2}-2{y}^{3}\\,\\text{d}y\\end{aligned}\n$$\n\nLet's now compare this to the disc method.\n\nTo determine this volume using the disc method, we'd first need to express our curve as two separate functions of $x,$ one for the lower part and one for the upper part, as follows:\n\n![](images/d9/d957a8e263db8ddd8ad3e5fa37f63b0cdbb47e706c367350c3ff6b8ff90294ff.svg)\n\n![](images/f4/f416ab43297265aec4836eca2020d8f08976852cc025ad4d3a0766023187adef.png)\n\nThe required volume is equal to the difference between the volumes generated when the upper and lower curves are rotated about the $x$-axis. Thus, according to the disc method, the required volume is given by\n\n$$\nV = \\pi \\int_{0}^{1/2} \\left( \\left[ \\dfrac{1}{2}+\\dfrac{1}{2}\\sqrt{1-2x} \\right]^2 - \\left[ \\dfrac{1}{2}-\\dfrac{1}{2}\\sqrt{1-2x} \\right]^2 \\right) \\textrm{d}x.\n$$\n\nAs we can see, this integral is a lot more complicated than the one we obtained using the shell method!" :db/ensure [:tutorial/validate]} {:db/id 17592186068950 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186069746 :step/math-academy-id 643617 :db/ensure [:step/validate]} {:db/id 17592186069749 :step/math-academy-id 643618 :db/ensure [:step/validate]} {:db/id 17592186069748 :step/math-academy-id 643621 :db/ensure [:step/validate]} {:db/id 17592186069747 :step/math-academy-id 643622 :db/ensure [:step/validate]} {:db/id 17592186068713 :knowledge-point/questions ["question-fbb8ab84-c16d-554a-bf88-2b57aaa4afbf" "question-2377eeaf-5209-5b0e-a180-97a6667f01fb" "question-8fea67f7-ec4c-5ab9-8c67-4d43507c8b87"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068481 :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=5x+3$ and $y=x-1.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}y=5x+3 \\\\ y=x-1\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Substituting the first equation $y=5x+3$ into the second equation $y=x-1$ gives an equation that we can solve for $x\\mathbin{:}$ \n\n$$\n\\begin{aligned}5x+3 & =x-1 \\\\ 5x & =x-4 \\\\ 4x & =-4 \\\\ x & =-1\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x = -1$ back into one of the equations, say $y=x-1,$ as follows:\n\n$$\n\\begin{aligned}y & =x-1 \\\\  & =-1-1 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-1, \\, y=-2.$ So, the coordinates of the intersection point are $(-1,-2).$" :db/ensure [:question/validate]} {:db/id 17592186068714 :knowledge-point/questions ["question-0e71161b-a139-5715-8ffb-5d9680416a1c" "question-3f0c0760-2f71-5da7-a09a-417c59aab4e2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068482 :question/problem "Find the point of intersection of the lines $x + 2 y = 1$ and $2 x - y = 7.$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}x+2y=1 \\\\ 2x-y=7\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $2,$ then we will get a $-2y$ term that can cancel with the $2y$ term in the first equation:\n\n![](images/d2/d2cac87bca62cf4fa8cc6ad3c0bd289de7cb0f8c39e742dd6e7731cb90b0e354.svg)\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x+\\cancel{2y} & =1 \\\\ 4x-\\cancel{2y} & =14 \\\\ (x+4x) & =(1+14) \\\\ 5x & =15 \\\\ x & =3\\end{aligned}\n$$\n\nFinally, we can substitute $x=3$ into the equation $x+2y=1$ to solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}x+2y & =1 \\\\ 3+2y & =1 \\\\ 2y & =-2 \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=3, \\, y=-1.$ So the coordinates of the point of intersection are $(3,-1).$" :db/ensure [:question/validate]} {:db/id 17592186068715 :knowledge-point/questions ["question-1afc104b-55b0-5a4c-8495-1467f6f4a4e0" "question-6f0810d4-95d5-5ec1-a80a-fff5b7ccd8fa"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068483 :question/problem "The lines $y = -3 x + a$ and $y = x - 1$ intersect at the point $C$ with coordinates $(b, -4).$ Find the parameters $a$ and $b.$" :question/worked-solution "Since $(b,-4)$ is the point of intersection of the two lines, the values $x=b, \\, y=-4$ must solve the following system:\n\n$$\n\\{\\begin{aligned}y=-3x+a \\\\ y=x-1\\end{aligned}\n$$\n\nWe substitute $x=b, \\, y=-4$ to obtain a new system:\n\n$$\n\\{\\begin{aligned}-4=-3b+a \\\\ -4=b-1\\end{aligned}\n$$\n\nIn the second equation, we can solve for $b\\mathbin{:}$\n\n$$\n\\begin{aligned}-4 & =b-1 \\\\ -3 & =b\\end{aligned}\n$$\n\nThen, we can substitute $b=-3$ into the first equation and solve for $a\\mathbin{:}$\n\n$$\n\\begin{aligned}-4 & =-3b+a \\\\ -4 & =-3(-3)+a \\\\ -4 & =9+a \\\\ -13 & =a\\end{aligned}\n$$\n\nTherefore, $a = -13$ and $b = -3.$" :db/ensure [:question/validate]} {:db/id "question-fbb8ab84-c16d-554a-bf88-2b57aaa4afbf" :question/id #uuid "fbb8ab84-c16d-554a-bf88-2b57aaa4afbf" :question/math-academy-id "q-12341" :question/problem "Find the point of intersection of the lines $y=-3x+4$ and $y=3x-2.$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=-3x+4$ and $y=3x-2.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}y=-3x+4 \\\\ y=3x-2\\end{aligned}\n$$\n\n \n\nWe can solve this system by substitution. Substituting the first equation $y=-3x+4$ into the second equation $y=3x-2$ yields an equation that we can solve for $x:$   \n\n$$\n\\begin{aligned}-3x+4 & =3x-2 \\\\ -6x & =-6 \\\\ x & =1\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=1$ back into one of the equations, say $y=3x-2,$ as follows:\n\n$$\n\\begin{aligned}y & =3(1)-2 \\\\  & =3-2 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=1,\\,y=1.$ So, the coordinates of the intersection point are  $(1,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5385bd89-2e2b-59d2-96ee-f5df31ac0e1a"] :db/ensure [:question/validate]} {:db/id "answer-field-5385bd89-2e2b-59d2-96ee-f5df31ac0e1a" :answer-field/id #uuid "5385bd89-2e2b-59d2-96ee-f5df31ac0e1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd3d317d-90d0-54fa-9845-224abe2a41f8" :answer-field/choices ["answer-9d020f15-d8db-5bcf-93ec-0ae93232bb73" "answer-672d8afe-7201-53e1-92cc-5c202dfef3fa" "answer-dd3d317d-90d0-54fa-9845-224abe2a41f8" "answer-1b42dbf5-902f-50e2-aab3-1a9d25bf1aa8" "answer-ad71990b-5a2b-5323-8b8c-0ebd37de1f39"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d020f15-d8db-5bcf-93ec-0ae93232bb73" :answer/id #uuid "9d020f15-d8db-5bcf-93ec-0ae93232bb73" :answer/type :answer.type/math :answer/value "(-1,1)" :db/ensure [:answer/validate]} {:db/id "answer-672d8afe-7201-53e1-92cc-5c202dfef3fa" :answer/id #uuid "672d8afe-7201-53e1-92cc-5c202dfef3fa" :answer/type :answer.type/math :answer/value "(0,-1)" :db/ensure [:answer/validate]} {:db/id "answer-dd3d317d-90d0-54fa-9845-224abe2a41f8" :answer/id #uuid "dd3d317d-90d0-54fa-9845-224abe2a41f8" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "answer-1b42dbf5-902f-50e2-aab3-1a9d25bf1aa8" :answer/id #uuid "1b42dbf5-902f-50e2-aab3-1a9d25bf1aa8" :answer/type :answer.type/math :answer/value "(2,0)" :db/ensure [:answer/validate]} {:db/id "answer-ad71990b-5a2b-5323-8b8c-0ebd37de1f39" :answer/id #uuid "ad71990b-5a2b-5323-8b8c-0ebd37de1f39" :answer/type :answer.type/text :answer/value "No intersection" :db/ensure [:answer/validate]} {:db/id "question-2377eeaf-5209-5b0e-a180-97a6667f01fb" :question/id #uuid "2377eeaf-5209-5b0e-a180-97a6667f01fb" :question/math-academy-id "q-12345" :question/problem "Find the point of intersection of the lines $y=4x+3$ and $y=-x-2.$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=4x+3$ and $y=-x-2.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}y=4x+3 \\\\ y=-x-2\\end{aligned}\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=4x+3$ into the second equation $y=-x-2$ yields an equation that we can solve for $x:$ \n\n$$\n\\begin{aligned}4x+3 & =-x-2 \\\\ 5x & =-5 \\\\ x & =-1\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=-1$ back into one of the equations, say $y=-x-2,$ as follows:\n\n$$\n\\begin{aligned}y & =-x-2 \\\\  & =-(-1)-2 \\\\  & =1-2 \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-1$ and $y=-1.$ So, the coordinates of the intersection point are $(-1,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3570d971-4147-56ab-ae02-49d2d0cf3575"] :db/ensure [:question/validate]} {:db/id "answer-field-3570d971-4147-56ab-ae02-49d2d0cf3575" :answer-field/id #uuid "3570d971-4147-56ab-ae02-49d2d0cf3575" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-979be2e5-b995-5f79-92bc-1452bf76979d" :answer-field/choices ["answer-979be2e5-b995-5f79-92bc-1452bf76979d" "answer-e605f897-7836-56eb-9e13-386de276895a" "answer-04a54877-c197-56e8-954f-97fa34f640d6" "answer-a8935a5c-80c0-5239-b637-2aac33da488b" "answer-d03bf538-f673-50d4-bccb-b6bd89abd7f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-979be2e5-b995-5f79-92bc-1452bf76979d" :answer/id #uuid "979be2e5-b995-5f79-92bc-1452bf76979d" :answer/type :answer.type/math :answer/value "(-1,-1)" :db/ensure [:answer/validate]} {:db/id "answer-e605f897-7836-56eb-9e13-386de276895a" :answer/id #uuid "e605f897-7836-56eb-9e13-386de276895a" :answer/type :answer.type/math :answer/value "(-1,1)" :db/ensure [:answer/validate]} {:db/id "answer-04a54877-c197-56e8-954f-97fa34f640d6" :answer/id #uuid "04a54877-c197-56e8-954f-97fa34f640d6" :answer/type :answer.type/math :answer/value "(1,-1)" :db/ensure [:answer/validate]} {:db/id "answer-a8935a5c-80c0-5239-b637-2aac33da488b" :answer/id #uuid "a8935a5c-80c0-5239-b637-2aac33da488b" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "answer-d03bf538-f673-50d4-bccb-b6bd89abd7f6" :answer/id #uuid "d03bf538-f673-50d4-bccb-b6bd89abd7f6" :answer/type :answer.type/text :answer/value "No intersection" :db/ensure [:answer/validate]} {:db/id 17592186069112 :question/problem "The point of intersection of the lines $y=3x-1$ and $y=-4x+6$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=3x-1$ and $y=-4x+6.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}y=3x-1 \\\\ y=-4x+6\\end{aligned}\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=3x-1$ into the second equation $y=-4x+6$ yields an equation that we can solve for $x:$ \n\n$$\n\\begin{aligned}3x-1 & =-4x+6 \\\\ 3x & =-4x+7 \\\\ 7x & =7 \\\\ x & =1\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=1$ back into one of the equations, say $y=3x-1,$ as follows:\n\n$$\n\\begin{aligned}y & =3x-1 \\\\  & =3(1)-1 \\\\  & =3-1 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=1,\\,y=2.$ So, the coordinates of the intersection point are $(\\,1,2\\,).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186066106 :answer-field/correct "answer-43d86f66-2db2-5d8f-b88c-c725aa3c7f93" :answer-field/choices ["answer-43d86f66-2db2-5d8f-b88c-c725aa3c7f93"] :db/ensure [:answer-field/validate]} {:db/id "answer-43d86f66-2db2-5d8f-b88c-c725aa3c7f93" :answer/id #uuid "43d86f66-2db2-5d8f-b88c-c725aa3c7f93" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186066105 :answer-field/correct "answer-116be24f-5fd6-5889-ac0f-f72b509821b0" :answer-field/choices ["answer-116be24f-5fd6-5889-ac0f-f72b509821b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-116be24f-5fd6-5889-ac0f-f72b509821b0" :answer/id #uuid "116be24f-5fd6-5889-ac0f-f72b509821b0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-8fea67f7-ec4c-5ab9-8c67-4d43507c8b87" :question/id #uuid "8fea67f7-ec4c-5ab9-8c67-4d43507c8b87" :question/math-academy-id "q-215406" :question/problem "The point of intersection of the lines $y=5x+2$ and $y=-2x-5$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=5x+2$ and $y=-2x-5.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}y=5x+2 \\\\ y=-2x-5\\end{aligned}\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=5x+2$ into the second equation $y=-2x-5$ yields an equation that we can solve for $x:$ \n\n$$\n\\begin{aligned}5x+2 & =-2x-5 \\\\ 5x & =-2x-7 \\\\ 7x & =-7 \\\\ x & =-1\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=-1$ back into one of the equations, say $y=5x+2,$ as follows:\n\n$$\n\\begin{aligned}y & =5x+2 \\\\  & =5(-1)+2 \\\\  & =-5+2 \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-1,\\,y=-3.$ So, the coordinates of the intersection point are $(\\,-1,-3\\,).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-53808067-0f30-5784-bdf6-5a452e079a99" "answer-field-a1d8dd92-150d-5fba-846f-54ae59acb479"] :db/ensure [:question/validate]} {:db/id "answer-field-53808067-0f30-5784-bdf6-5a452e079a99" :answer-field/id #uuid "53808067-0f30-5784-bdf6-5a452e079a99" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4e14a637-7109-5806-bcf2-23eddc204a8e" :answer-field/choices ["answer-4e14a637-7109-5806-bcf2-23eddc204a8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e14a637-7109-5806-bcf2-23eddc204a8e" :answer/id #uuid "4e14a637-7109-5806-bcf2-23eddc204a8e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-a1d8dd92-150d-5fba-846f-54ae59acb479" :answer-field/id #uuid "a1d8dd92-150d-5fba-846f-54ae59acb479" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f6bceb41-aa44-5fba-9341-e4b1ec60a6dd" :answer-field/choices ["answer-f6bceb41-aa44-5fba-9341-e4b1ec60a6dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-f6bceb41-aa44-5fba-9341-e4b1ec60a6dd" :answer/id #uuid "f6bceb41-aa44-5fba-9341-e4b1ec60a6dd" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-0e71161b-a139-5715-8ffb-5d9680416a1c" :question/id #uuid "0e71161b-a139-5715-8ffb-5d9680416a1c" :question/math-academy-id "q-215907" :question/problem "The point of intersection of the lines $x-y=6$  and $2x+3y=2$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of two lines:\n\n$$\n\\{\\begin{aligned}x-y=6 \\\\ 2x+3y=2\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $3,$ then we will get a $-3y$ term that can cancel with the $3y$ in the second equation:\n\n$$\n\\{\\begin{aligned}x-y=6 & |\\,\\times 3 \\\\ 2x+3y=2\\end{aligned}\\,⟹\\,\\{\\begin{aligned}3x-3y=18 \\\\ 2x+3y=2\\end{aligned}\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x:$\n\n$$\n\\begin{aligned}3x-\\cancel{3y} & =18 \\\\ 2x+\\cancel{3y} & =2 \\\\ (3x+2x) & =(18+2) \\\\ 5x & =20 \\\\ x & =4\\end{aligned}\n$$\n\nFinally, we can substitute $x=4$ back into the equation $x-y=6$ to solve for $y:$\n\n$$\n\\begin{aligned}x-y & =6 \\\\ 4-y & =6 \\\\ -y & =2 \\\\ y & =-2\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=4,\\,y=-2.$ So the coordinates of the point of intersection are $(4,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5f2a9c14-2818-5a2f-9495-2a1d80fce7a5" "answer-field-b8710304-e047-5b95-b337-f167d5c09c50"] :db/ensure [:question/validate]} {:db/id "answer-field-5f2a9c14-2818-5a2f-9495-2a1d80fce7a5" :answer-field/id #uuid "5f2a9c14-2818-5a2f-9495-2a1d80fce7a5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-708c8c65-9e57-55cf-8e02-bdccfea78cbd" :answer-field/choices ["answer-708c8c65-9e57-55cf-8e02-bdccfea78cbd"] :db/ensure [:answer-field/validate]} {:db/id "answer-708c8c65-9e57-55cf-8e02-bdccfea78cbd" :answer/id #uuid "708c8c65-9e57-55cf-8e02-bdccfea78cbd" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-b8710304-e047-5b95-b337-f167d5c09c50" :answer-field/id #uuid "b8710304-e047-5b95-b337-f167d5c09c50" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-50e231bc-f852-59af-9063-83603b5b0af1" :answer-field/choices ["answer-50e231bc-f852-59af-9063-83603b5b0af1"] :db/ensure [:answer-field/validate]} {:db/id "answer-50e231bc-f852-59af-9063-83603b5b0af1" :answer/id #uuid "50e231bc-f852-59af-9063-83603b5b0af1" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "question-3f0c0760-2f71-5da7-a09a-417c59aab4e2" :question/id #uuid "3f0c0760-2f71-5da7-a09a-417c59aab4e2" :question/math-academy-id "q-215425" :question/problem "The point of intersection of the lines $4x+3y=5$ and $-x-6y=4$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}4x+3y=5 \\\\ -x-6y=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $2,$ then we will get a $6y$ term that can cancel with the $-6y$ in the second equation:\n\n$$\n\\{\\begin{aligned}4x+3y=5 & |\\,\\times 2 \\\\ -x-6y=4 & \\end{aligned}\\,⟹\\,\\{\\begin{aligned}8x+6y=10 \\\\ -x-6y=4\\end{aligned}\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x:$\n\n$$\n\\begin{aligned}8x+\\cancel{6y} & =10 \\\\ -x-\\cancel{6y} & =4 \\\\ (8x-x) & =(10+4) \\\\ 7x & =14 \\\\ x & =2\\end{aligned}\n$$\n\nFinally, we can substitute $x=2$ into the equation $4x+3y=5$ to solve for $y:$\n\n$$\n\\begin{aligned}4x+3y & =5 \\\\ 4(2)+3y & =5 \\\\ 8+3y & =5 \\\\ 3y & =-3 \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=2,\\,y=-1.$ So the coordinates of the point of intersection are $(2,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-169d52f1-75a4-5be7-9c20-85e9f9e1bbb6" "answer-field-029c7e4a-50de-5170-a29d-9c2812bbfd4f"] :db/ensure [:question/validate]} {:db/id "answer-field-169d52f1-75a4-5be7-9c20-85e9f9e1bbb6" :answer-field/id #uuid "169d52f1-75a4-5be7-9c20-85e9f9e1bbb6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0b8feaa1-6c6b-5ce2-95a0-abd65447e29e" :answer-field/choices ["answer-0b8feaa1-6c6b-5ce2-95a0-abd65447e29e"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b8feaa1-6c6b-5ce2-95a0-abd65447e29e" :answer/id #uuid "0b8feaa1-6c6b-5ce2-95a0-abd65447e29e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-029c7e4a-50de-5170-a29d-9c2812bbfd4f" :answer-field/id #uuid "029c7e4a-50de-5170-a29d-9c2812bbfd4f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5dfdbf3d-1baf-52a6-9f2e-50f60fe73200" :answer-field/choices ["answer-5dfdbf3d-1baf-52a6-9f2e-50f60fe73200"] :db/ensure [:answer-field/validate]} {:db/id "answer-5dfdbf3d-1baf-52a6-9f2e-50f60fe73200" :answer/id #uuid "5dfdbf3d-1baf-52a6-9f2e-50f60fe73200" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186069128 :question/problem "The point of intersection of the lines $x-y=7$ and $3x+2y=11$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}x-y=7 \\\\ 3x+2y=11\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $2,$ then we will get a $-2y$ term that can cancel with the $2y$ in the second equation:\n\n$$\n\\{\\begin{aligned}x-y=7 & |\\,\\times 2 \\\\ 3x+2y=11 & \\end{aligned}\\,⟹\\,\\{\\begin{aligned}2x-2y=14 \\\\ 3x+2y=11\\end{aligned}\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x:$\n\n$$\n\\begin{aligned}2x-\\cancel{2y} & =14 \\\\ 3x+\\cancel{2y} & =11 \\\\ (2x+3x) & =(14+11) \\\\ 5x & =25 \\\\ x & =5\\end{aligned}\n$$\n\nFinally, we can substitute $x=5$ into the equation $x-y=7$ to solve for $y:$\n\n$$\n\\begin{aligned}x-y & =7 \\\\ 5-y & =7 \\\\ -y & =2 \\\\ y & =-2\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=5,\\,y=-2.$ So the coordinates of the point of intersection are $(5,-2).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186066131 :answer-field/correct "answer-a2500fd2-0b2a-5394-bf17-dcf3ac8c7ce7" :answer-field/choices ["answer-a2500fd2-0b2a-5394-bf17-dcf3ac8c7ce7"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2500fd2-0b2a-5394-bf17-dcf3ac8c7ce7" :answer/id #uuid "a2500fd2-0b2a-5394-bf17-dcf3ac8c7ce7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186066130 :answer-field/correct "answer-475d2832-c0a5-5c75-967d-16e511aa4933" :answer-field/choices ["answer-475d2832-c0a5-5c75-967d-16e511aa4933"] :db/ensure [:answer-field/validate]} {:db/id "answer-475d2832-c0a5-5c75-967d-16e511aa4933" :answer/id #uuid "475d2832-c0a5-5c75-967d-16e511aa4933" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "question-1afc104b-55b0-5a4c-8495-1467f6f4a4e0" :question/id #uuid "1afc104b-55b0-5a4c-8495-1467f6f4a4e0" :question/math-academy-id "q-215456" :question/problem "Find the parameters $a$ and $b$ given that the lines $4x+y=a$ and $7x+2y=-2$ intersect at the point $C$ with coordinates $(-2,b).$\n\n$a=$\n{{field-1}}\n$,\\,b=$\n{{field-2}}" :question/worked-solution "Since $(-2,b)$ is the point of intersection of the two lines, the values $x=-2,\\,y=b$ must solve the following system:\n\n$$\n\\{\\begin{aligned}4x+y=a \\\\ 7x+2y=-2\\end{aligned}\n$$\n\nWe substitute $x=-2,\\,y=b$ to obtain a new system:\n\n$$\n\\{\\begin{aligned}4(-2)+b=a \\\\ 7(-2)+2b=-2\\end{aligned}\n$$\n\nThe system simplifies as follows:\n\n$$\n\\{\\begin{aligned}-8+b=a \\\\ b=6\\end{aligned}\n$$\n\nFrom the second equation, we know that $b=6.$ Then, we can substitute $b=6$ into the first equation and solve for $a:$\n\n$$\n\\begin{aligned}-8+b & =a \\\\ -8+6 & =a \\\\ -2 & =a\\end{aligned}\n$$\n\nTherefore, $a=-2$ and $b=6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5ceb5866-3821-5721-8ddd-69dfc4a85ef3" "answer-field-7ad9b32b-e694-53a4-b684-a9c3d5526acf"] :db/ensure [:question/validate]} {:db/id "answer-field-5ceb5866-3821-5721-8ddd-69dfc4a85ef3" :answer-field/id #uuid "5ceb5866-3821-5721-8ddd-69dfc4a85ef3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8d79f727-28b1-5c7a-a40d-c1d970975032" :answer-field/choices ["answer-8d79f727-28b1-5c7a-a40d-c1d970975032"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d79f727-28b1-5c7a-a40d-c1d970975032" :answer/id #uuid "8d79f727-28b1-5c7a-a40d-c1d970975032" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-7ad9b32b-e694-53a4-b684-a9c3d5526acf" :answer-field/id #uuid "7ad9b32b-e694-53a4-b684-a9c3d5526acf" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1f9a098d-ebc1-504f-8f6e-6368dd1908a1" :answer-field/choices ["answer-1f9a098d-ebc1-504f-8f6e-6368dd1908a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f9a098d-ebc1-504f-8f6e-6368dd1908a1" :answer/id #uuid "1f9a098d-ebc1-504f-8f6e-6368dd1908a1" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-6f0810d4-95d5-5ec1-a80a-fff5b7ccd8fa" :question/id #uuid "6f0810d4-95d5-5ec1-a80a-fff5b7ccd8fa" :question/math-academy-id "q-215449" :question/problem "Find the parameters $a$ and $b$ given that the lines $y=-2x+2$ and $y=-5x-a$ intersect at the point $C$ with coordinates $(b,8).$\n\n$a=$\n{{field-1}}\n$,\\,b=$\n{{field-2}}" :question/worked-solution "Since $(b,8)$ is the point of intersection of the two lines, the values $x=b,\\,y=8$ must solve the following system:\n\n$$\n\\{\\begin{aligned}y=-2x+2 \\\\ y=-5x-a\\end{aligned}\n$$\n\nWe substitute $x=b,\\,y=8$ to obtain a new system:\n\n$$\n\\{\\begin{aligned}8=-2(b)+2 \\\\ 8=-5(b)-a\\end{aligned}\n$$\n\nThe system simplifies as follows:\n\n$$\n\\{\\begin{aligned}8=-2b+2 \\\\ 8=-5b-a\\end{aligned}\n$$\n\nFrom the first equation, we know that $b=-3.$ Then, we can substitute $b=-3$ into the second equation and solve for $a:$\n\n$$\n\\begin{aligned}8 & =-5b-a \\\\ 8 & =-5(-3)-a \\\\ 8 & =15-a \\\\ -7 & =-a \\\\ 7 & =a\\end{aligned}\n$$\n\nTherefore, $a=7$ and $b=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ac8a4f46-631a-5834-bccb-19f61173479f" "answer-field-916ed4c7-e602-5f6e-96c2-1df4406aef2a"] :db/ensure [:question/validate]} {:db/id "answer-field-ac8a4f46-631a-5834-bccb-19f61173479f" :answer-field/id #uuid "ac8a4f46-631a-5834-bccb-19f61173479f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c1758d0a-5deb-56ae-9015-8ac086050fad" :answer-field/choices ["answer-c1758d0a-5deb-56ae-9015-8ac086050fad"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1758d0a-5deb-56ae-9015-8ac086050fad" :answer/id #uuid "c1758d0a-5deb-56ae-9015-8ac086050fad" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-916ed4c7-e602-5f6e-96c2-1df4406aef2a" :answer-field/id #uuid "916ed4c7-e602-5f6e-96c2-1df4406aef2a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-83c84ced-06a7-5128-a357-8450c25a2e2f" :answer-field/choices ["answer-83c84ced-06a7-5128-a357-8450c25a2e2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-83c84ced-06a7-5128-a357-8450c25a2e2f" :answer/id #uuid "83c84ced-06a7-5128-a357-8450c25a2e2f" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id 17592186070021 :tutorial/content "Suppose we want to find the point of intersection between the two lines $y = x + 2$ and $y = 2x + 1.$ A sketch of both lines and the point of intersection $P$ is shown below.\n\n![](images/2b/2bf429fdfbe706521b81617f56a0f561171aa7fd48e0af89318225f1d328e667.png)\n\nThe point $P$ consists of the coordinates $(x,y)$ that satisfy both equations $y=x+2$ and $y=2x+1.$ So, to find the coordinates of $P$ we need to solve the system of equations consisting of the two lines:\n\n$$\n\\{\\begin{aligned}y=x+2 \\\\ y=2x+1\\end{aligned}\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=x+2$ into the second equation $y=2x+1$ gives an equation that we can solve for $x\\mathbin{:}$ \n\n$$\n\\begin{aligned}x+2 & =2x+1 \\\\ x+1 & =2x \\\\ 1 & =x\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x = 1$ back into one of the equations, say $y=x+2,$ as follows:\n\n$$\n\\begin{aligned}y & =x+2 \\\\  & =1+2 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=1, \\, y=3.$ So, the point of intersection has the coordinates $(1,3).$" :db/ensure [:tutorial/validate]} {:db/id 17592186068945 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id "activity-dd92c948-0eff-59d9-8a07-30fdc5ab0737" :activity/id #uuid "dd92c948-0eff-59d9-8a07-30fdc5ab0737" :activity/title "The Inner Product in Vector Spaces Over the Complex Numbers" :activity/type :activity.type/review :activity/scope 17592186050993 :activity/course 17592186046660 :activity/steps ["step-7a2f8e3c-95b7-5e85-817c-a0d82602286a" "step-2b42f750-9a7e-5f8b-a758-4b09386e27b9" "step-ba88a8d8-f925-5c60-9a9e-df08b26bbbfb" "step-b9c2039c-a815-5440-94dd-50c9bbba18a0" "step-b58576dc-b950-5cb9-94db-ca8f23e36cbe"] :activity/first-step "step-7a2f8e3c-95b7-5e85-817c-a0d82602286a" :db/ensure [:activity/validate]} {:db/id "step-7a2f8e3c-95b7-5e85-817c-a0d82602286a" :step/id #uuid "7a2f8e3c-95b7-5e85-817c-a0d82602286a" :step/content 17592186360770 :step/next "step-2b42f750-9a7e-5f8b-a758-4b09386e27b9" :db/ensure [:step/validate]} {:db/id "step-2b42f750-9a7e-5f8b-a758-4b09386e27b9" :step/id #uuid "2b42f750-9a7e-5f8b-a758-4b09386e27b9" :step/content 17592186360775 :step/next "step-ba88a8d8-f925-5c60-9a9e-df08b26bbbfb" :db/ensure [:step/validate]} {:db/id "step-ba88a8d8-f925-5c60-9a9e-df08b26bbbfb" :step/id #uuid "ba88a8d8-f925-5c60-9a9e-df08b26bbbfb" :step/content 17592186360783 :step/next "step-b9c2039c-a815-5440-94dd-50c9bbba18a0" :db/ensure [:step/validate]} {:db/id "step-b9c2039c-a815-5440-94dd-50c9bbba18a0" :step/id #uuid "b9c2039c-a815-5440-94dd-50c9bbba18a0" :step/content 17592186360784 :step/next "step-b58576dc-b950-5cb9-94db-ca8f23e36cbe" :db/ensure [:step/validate]} {:db/id "step-b58576dc-b950-5cb9-94db-ca8f23e36cbe" :step/id #uuid "b58576dc-b950-5cb9-94db-ca8f23e36cbe" :step/content 17592186272228 :db/ensure [:step/validate]} {:db/id 17592186166937 :knowledge-point/questions ["question-29e3e5d7-28ea-5e8a-b874-caa92a5ebba1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-29e3e5d7-28ea-5e8a-b874-caa92a5ebba1" :question/id #uuid "29e3e5d7-28ea-5e8a-b874-caa92a5ebba1" :question/math-academy-id "q-336597" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}4 & 1 \\\\ 0 & 2\\end{aligned}]x(t)+\\overset{f(t)}{\\overset{⏞}{[\\begin{aligned}-3 \\\\ 4\\end{aligned}]}},\\,Φ=[\\begin{aligned}{e}^{4t} & {e}^{2t} \\\\ 0 & -2{e}^{2t}\\end{aligned}]\n$$\n\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute ${Φ}^{-1}\\,f(t)$ and the particular solution ${x}_{p}(t)$ of the system.\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${Φ}^{-1}\\,f(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-{e}^{-4t}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">$\\,,\\,$</td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">${x}_{p}(t)=\\,\\,$</td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$\\frac{5}{4}$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"></td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=[\\begin{aligned}{e}^{4t} & {e}^{2t} \\\\ 0 & -2{e}^{2t}\\end{aligned}],\\,f(t)=[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{4t}\\cdot (-2{e}^{2t})-0\\cdot {e}^{2t}}[\\begin{aligned}-2{e}^{2t} & -{e}^{2t} \\\\ 0 & {e}^{4t}\\end{aligned}] \\\\  & =\\frac{-{e}^{-6t}}{2}[\\begin{aligned}-2{e}^{2t} & -{e}^{2t} \\\\ 0 & {e}^{4t}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2{e}^{-4t} & {e}^{-4t} \\\\ 0 & -{e}^{-2t}\\end{aligned}]. \\\\ {Φ}^{-1}\\,f(t) & =\\frac{1}{2}[\\begin{aligned}2{e}^{-4t} & {e}^{-4t} \\\\ 0 & -{e}^{-2t}\\end{aligned}][\\begin{aligned}-3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-{e}^{-4t} \\\\ -2{e}^{-2t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}-{e}^{-4t} \\\\ -2{e}^{-2t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int -{e}^{-4t}\\,\\text{d}t \\\\ \\int -2{e}^{-2t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{4}{e}^{-4t} \\\\ {e}^{-2t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{4t} & {e}^{2t} \\\\ 0 & -2{e}^{2t}\\end{aligned}][\\begin{aligned}\\frac{1}{4}{e}^{-4t} \\\\ {e}^{-2t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} \\\\ -2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-57ab610c-28ab-5d09-83f7-d68b274b353d" "answer-field-9aa355cf-d45f-5b54-bcec-6c9a1e489b0d"] :db/ensure [:question/validate]} {:db/id "answer-field-57ab610c-28ab-5d09-83f7-d68b274b353d" :answer-field/id #uuid "57ab610c-28ab-5d09-83f7-d68b274b353d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8535759b-fe73-52af-853f-f3486f41d48a" :answer-field/choices ["answer-8535759b-fe73-52af-853f-f3486f41d48a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8535759b-fe73-52af-853f-f3486f41d48a" :answer/id #uuid "8535759b-fe73-52af-853f-f3486f41d48a" :answer/type :answer.type/math :answer/value "-2e^{-2t}" :db/ensure [:answer/validate]} {:db/id "answer-field-9aa355cf-d45f-5b54-bcec-6c9a1e489b0d" :answer-field/id #uuid "9aa355cf-d45f-5b54-bcec-6c9a1e489b0d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f89927db-d31d-51e0-b063-5d1318a6634f" :answer-field/choices ["answer-f89927db-d31d-51e0-b063-5d1318a6634f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f89927db-d31d-51e0-b063-5d1318a6634f" :answer/id #uuid "f89927db-d31d-51e0-b063-5d1318a6634f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186166936 :knowledge-point/questions ["question-59d9272b-7eb2-549a-868b-86d14c7fdef5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-59d9272b-7eb2-549a-868b-86d14c7fdef5" :question/id #uuid "59d9272b-7eb2-549a-868b-86d14c7fdef5" :question/math-academy-id "q-336703" :question/problem "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into the {{field-1}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L5}$ by {{field-2}} both sides of the equation.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by {{field-3}} both sides of the equation." :question/worked-solution "Let's examine each statement in turn.\n\n- We first consider lines $\\text{L1},$ $\\text{L2},$ and $\\text{L3}.$ Let's substitute ${x}_{p}(t)=Φu(t)$ from $\\text{L1}$ and ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$ from $\\text{L2}$ into the initial system of ODEs:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =Ax(t)+f(t) \\\\ Φ{u}^{′}(t)+{Φ}^{′}u(t) & =AΦu(t)+f(t)\\end{aligned}\n$$\n\nTherefore, $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into $\\text{initial system of ODEs}.$\n\n- Next, we consider lines $\\text{L5}$ and $\\text{L6}.$ Since $Φ$ is a fundamental matrix, its columns are linearly independent. So, $Φ$ is invertible. Therefore, $\\text{L6}$ follows from $\\text{L5}$ by $\\text{pre-multiplying by }{Φ}^{-1}$ both sides of the equation:\n\n$$\n\\begin{aligned}{Φ}^{-1}\\cdot Φ{u}^{′}(t) & ={Φ}^{-1}\\cdot f(t) \\\\ ({Φ}^{-1}Φ)\\cdot {u}^{′}(t) & ={Φ}^{-1}\\cdot f(t) \\\\ {u}^{′}(t) & ={Φ}^{-1}\\cdot f(t)\\end{aligned}\n$$\n\n- Finally, we consider lines $\\text{L6}$ and $\\text{L7}.$ To get $\\text{L7},$ we are $\\text{integrating}$ both sides of the equation in $\\text{L6}:$\n\n$$\n\\begin{aligned}\\int {u}^{′}(t)\\,\\text{d}t & =\\int {Φ}^{-1}(t)f(t)\\,\\text{d}t \\\\ u(t) & =\\int {Φ}^{-1}f(t)\\,\\text{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dfeef9c0-222d-580e-9176-2a58212a74b2" "answer-field-e749236f-06ab-5ec0-b55c-1658240128bd" "answer-field-c7d19aee-5b0e-5d1e-a94c-b57fbd271c20"] :db/ensure [:question/validate]} {:db/id "answer-field-dfeef9c0-222d-580e-9176-2a58212a74b2" :answer-field/id #uuid "dfeef9c0-222d-580e-9176-2a58212a74b2" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-06460bbd-b07c-5c78-a2a2-80d558e6fce9" :answer-field/choices ["answer-fe1e7de1-308b-5df0-8d07-32baa3c11686" "answer-06460bbd-b07c-5c78-a2a2-80d558e6fce9" "answer-0880df10-3963-5d13-be2c-f4f7b1243830" "answer-1e95d564-42f5-5e8c-87b1-05cb232304bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-fe1e7de1-308b-5df0-8d07-32baa3c11686" :answer/id #uuid "fe1e7de1-308b-5df0-8d07-32baa3c11686" :answer/type :answer.type/text :answer/value "first shifting theorem" :db/ensure [:answer/validate]} {:db/id "answer-06460bbd-b07c-5c78-a2a2-80d558e6fce9" :answer/id #uuid "06460bbd-b07c-5c78-a2a2-80d558e6fce9" :answer/type :answer.type/text :answer/value "initial system of ODEs" :db/ensure [:answer/validate]} {:db/id "answer-0880df10-3963-5d13-be2c-f4f7b1243830" :answer/id #uuid "0880df10-3963-5d13-be2