gn=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}4a-(3b-2c) & =4\\,\\begin{bmatrix}-5 \\\\ 3\\end{bmatrix}-(3\\,\\begin{bmatrix}2 \\\\ -4\\end{bmatrix}-2\\,\\begin{bmatrix}-1 \\\\ 6\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-(\\begin{bmatrix}6 \\\\ -12\\end{bmatrix}-\\begin{bmatrix}-2 \\\\ 12\\end{bmatrix}) \\\\  & =\\begin{bmatrix}-20 \\\\ 12\\end{bmatrix}-\\begin{bmatrix}8 \\\\ -24\\end{bmatrix} \\\\  & =\\begin{bmatrix}-28 \\\\ 36\\end{bmatrix}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-beab0d67-6115-58a0-9692-4c292e4251e6" "answer-field-b37d9201-7dcf-5a89-a52b-32dccf01ca00"] :db/ensure [:question/validate]} {:db/id "answer-field-beab0d67-6115-58a0-9692-4c292e4251e6" :answer-field/id #uuid "beab0d67-6115-58a0-9692-4c292e4251e6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-83567ae1-8427-57f7-8486-981e82916dd0" :answer-field/choices ["answer-83567ae1-8427-57f7-8486-981e82916dd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-83567ae1-8427-57f7-8486-981e82916dd0" :answer/id #uuid "83567ae1-8427-57f7-8486-981e82916dd0" :answer/type :answer.type/math :answer/value "-28" :db/ensure [:answer/validate]} {:db/id "answer-field-b37d9201-7dcf-5a89-a52b-32dccf01ca00" :answer-field/id #uuid "b37d9201-7dcf-5a89-a52b-32dccf01ca00" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer-field/choices ["answer-56b0dd0c-9d63-5a70-95a6-dd376b0a0954"] :db/ensure [:answer-field/validate]} {:db/id "answer-56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer/id #uuid "56b0dd0c-9d63-5a70-95a6-dd376b0a0954" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-5042d60d-1d74-5a97-ae4c-6f45b8b23e98" :question/id #uuid "5042d60d-1d74-5a97-ae4c-6f45b8b23e98" :question/math-academy-id "q-318151" :question/problem "Let $a=\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}$, $b=\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}$ and $c=\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}.$ Find $2b+(-3a+c).$\n\n<table align=\"center\" cellpadding=\"1\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" rowspan=\"2\" width=\"25\">$2b+(-3a+c)=\\,\\,$</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-1}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n<td align=\"center\" height=\"25\" width=\"25\">{{field-2}}\n</td>\n<td align=\"center\" height=\"25\" width=\"2\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}2b+(-3a+c) & =2\\,\\begin{bmatrix}3 \\\\ -2\\end{bmatrix}+(-3\\,\\begin{bmatrix}-4 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+(\\begin{bmatrix}12 \\\\ -3\\end{bmatrix}+\\begin{bmatrix}-2 \\\\ 7\\end{bmatrix}) \\\\  & =\\begin{bmatrix}6 \\\\ -4\\end{bmatrix}+\\begin{bmatrix}10 \\\\ 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}16 \\\\ 0\\end{bmatrix}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-68889a3d-e5ee-5d54-9a14-6cd62d10349e" "answer-field-91d3976d-329b-5f5a-af1a-743745fa1745"] :db/ensure [:question/validate]} {:db/id "answer-field-68889a3d-e5ee-5d54-9a14-6cd62d10349e" :answer-field/id #uuid "68889a3d-e5ee-5d54-9a14-6cd62d10349e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5a2628d9-2ef7-52ba-ae71-6150e6f2287d" :answer-field/choices ["answer-5a2628d9-2ef7-52ba-ae71-6150e6f2287d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a2628d9-2ef7-52ba-ae71-6150e6f2287d" :answer/id #uuid "5a2628d9-2ef7-52ba-ae71-6150e6f2287d" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-field-91d3976d-329b-5f5a-af1a-743745fa1745" :answer-field/id #uuid "91d3976d-329b-5f5a-af1a-743745fa1745" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fd34578d-2535-5f34-83c6-c3e44442de3d" :answer-field/choices ["answer-fd34578d-2535-5f34-83c6-c3e44442de3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd34578d-2535-5f34-83c6-c3e44442de3d" :answer/id #uuid "fd34578d-2535-5f34-83c6-c3e44442de3d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id 17592186059713 :knowledge-point/questions ["question-e78eae91-aaf3-5f8b-9296-2cbaa295070f" "question-91b53c66-dd75-5cd1-95a9-a7a78fb6e36b" "question-d424dcb1-177c-5053-898f-bbc5de5cd766"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e78eae91-aaf3-5f8b-9296-2cbaa295070f" :question/id #uuid "e78eae91-aaf3-5f8b-9296-2cbaa295070f" :question/math-academy-id "q-318160" :question/problem "If $\\overset{\\to }{m}=⟨-6,2⟩$ and $\\overset{\\to }{n}=⟨5,-8⟩$, then $\\overset{\\to }{m}-\\overset{\\to }{n}=$$\\,⟨$\n{{field-1}}$\\,,$\n{{field-2}}$⟩.$" :question/worked-solution "To compute the result, we just need to perform the required operations with each component separately:\n\n$$\n\\begin{aligned}\\overset{\\to }{m}-\\overset{\\to }{n} & =⟨-6,2⟩-⟨5,-8⟩ \\\\  & =⟨-6-5,\\,2-(-8)⟩ \\\\  & =⟨-11,10⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b1fda064-c5be-50c8-a2f2-f2d149b07722" "answer-field-dbc685a7-f84f-5c19-84d2-5848ae5fa567"] :db/ensure [:question/validate]} {:db/id "answer-field-b1fda064-c5be-5