lidate]} {:db/id "answer-field-f469b983-4520-5eeb-a4dd-2be04a9bfbf3" :answer-field/id #uuid "f469b983-4520-5eeb-a4dd-2be04a9bfbf3" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-90b258c5-fe81-572f-aab9-7f1aed17a7dd" :answer-field/choices ["answer-a443a5a5-d7e9-5665-9400-1d8b91bde944" "answer-90b258c5-fe81-572f-aab9-7f1aed17a7dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-a443a5a5-d7e9-5665-9400-1d8b91bde944" :answer/id #uuid "a443a5a5-d7e9-5665-9400-1d8b91bde944" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-90b258c5-fe81-572f-aab9-7f1aed17a7dd" :answer/id #uuid "90b258c5-fe81-572f-aab9-7f1aed17a7dd" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id 17592186059780 :knowledge-point/questions ["question-babcf679-477c-52f6-b009-8d35e055441b" "question-f686088d-e105-5e19-956f-e84bb86ba487"] :db/ensure [:knowledge-point/validate]} {:db/id "question-babcf679-477c-52f6-b009-8d35e055441b" :question/id #uuid "babcf679-477c-52f6-b009-8d35e055441b" :question/math-academy-id "q-182524" :question/problem "$¬(R⇔¬S)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(R⇔¬S)≡¬[(R⇒¬S)∧(¬S⇒R)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(R⇒¬S)∧(¬S⇒R)]≡¬[(¬R∨¬S)∧(¬¬S∨R)]\n$$\n\nNext, we simplify the double negations:\n\n$$\n¬[(¬R∨¬S)∧(¬¬S∨R)]≡¬[(¬R∨¬S)∧(S∨R)]\n$$\n\nNow, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬R∨¬S)∧(S∨R)] & ≡¬(¬R∨¬S)∨¬(S∨R) \\\\  & ≡(¬¬R∧¬¬S)∨¬(S∨R)\\end{aligned}\n$$\n\nFinally, we again simplify the double negations and write down symbols in alphabetic order inside the parentheses using commutative laws:\n\n$$\n\\begin{aligned}(¬¬R∧¬¬S)∨¬(S∨R) & ≡(R∧S)∨¬(S∨R) \\\\  & ≡(R∧S)∨¬(R∨S)\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a7422327-ad06-592f-a13d-35e60fbb5a20"] :db/ensure [:question/validate]} {:db/id "answer-field-a7422327-ad06-592f-a13d-35e60fbb5a20" :answer-field/id #uuid "a7422327-ad06-592f-a13d-35e60fbb5a20" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b77c5221-ae94-51e9-b8ce-b5340fd8bf22" :answer-field/choices ["answer-076d8325-3509-54e0-a053-b1ec5569d452" "answer-690f9668-60b9-5816-9a5e-fa2a8f0eade8" "answer-b77c5221-ae94-51e9-b8ce-b5340fd8bf22" "answer-d24955ed-685d-5b34-8787-96d77fb1de82" "answer-f0ee5d7a-4c7f-5f1d-b042-6f7a75f80cd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-076d8325-3509-54e0-a053-b1ec5569d452" :answer/id #uuid "076d8325-3509-54e0-a053-b1ec5569d452" :answer/type :answer.type/math :answer/value "(R∧S)∧¬(R∨S)" :db/ensure [:answer/validate]} {:db/id "answer-690f9668-60b9-5816-9a5e-fa2a8f0eade8" :answer/id #uuid "690f9668-60b9-5816-9a5e-fa2a8f0eade8" :answer/type :answer.type/math :answer/value "(R∧S)∨¬(R∧S)" :db/ensure [:answer/validate]} {:db/id "answer-b77c5221-ae94-51e9-b8ce-b5340fd8bf22" :answer/id #uuid "b77c5221-ae94-51e9-b8ce-b5340fd8bf22" :answer/type :answer.type/math :answer/value "(R∧S)∨¬(R∨S)" :db/ensure [:answer/validate]} {:db/id "answer-d24955ed-685d-5b34-8787-96d77fb1de82" :answer/id #uuid "d24955ed-685d-5b34-8787-96d77fb1de82" :answer/type :answer.type/math :answer/value "(R∨S)∧¬(R∧S)" :db/ensure [:answer/validate]} {:db/id "answer-f0ee5d7a-4c7f-5f1d-b042-6f7a75f80cd0" :answer/id #uuid "f0ee5d7a-4c7f-5f1d-b042-6f7a75f80cd0" :answer/type :answer.type/math :answer/value "¬R⇔S" :db/ensure [:answer/validate]} {:db/id "question-f686088d-e105-5e19-956f-e84bb86ba487" :question/id #uuid "f686088d-e105-5e19-956f-e84bb86ba487" :question/math-academy-id "q-182522" :question/problem "$¬(B⇔A)≡$" :question/worked-solution "First, we use the definition of the biconditional statement to write the equivalence as a conjunction of implications: \n\n$$\n¬(B⇔A)≡¬[(B⇒A)∧(A⇒B)]\n$$\n\nNow, we represent all the implications using disjunctions and negations:\n\n$$\n¬[(B⇒A)∧(A⇒B)]≡¬[(¬B∨A)∧(¬A∨B)]\n$$\n\nNext, we use De Morgan's laws:\n\n$$\n\\begin{aligned}¬[(¬B∨A)∧(¬A∨B)] & ≡¬(¬B∨A)∨¬(¬A∨B) \\\\  & ≡(¬¬B∧¬A)∨(¬¬A∧¬B)\\end{aligned}\n$$\n\nFinally, we simplify the double negations and write down symbols in alphabetic order inside the parentheses using commutative laws:\n\n$$\n\\begin{aligned}(¬¬B∧¬A)∨(¬¬A∧¬B) & ≡(B∧¬A)∨(A∧¬B) \\\\  & ≡(¬A∧B)∨(A∧¬B)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4965da56-6033-5b41-a06c-91a9fdf4486b"] :db/ensure [:question/validate]} {:db/id "answer-field-4965da56-6033-5b41-a06c-91a9fdf4486b" :answer-field/id #uuid "4965da56-6033-5b41-a06c-91a9fdf4486b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-af4e153b-eba0-5317-8b16-e0bc3532fae5" :answer-field/choices ["answer-39daa7e5-cb5c-5741-9a21-580afc034598" "answer-74facaaf-1f98-50c8-acb9-65561bcc86c7" "answer-af4e153b-eba0-5317-8b16-e0bc3532fae5" "answer-8ec18d04-5193-5b30-b1d2-9879366eceac" "answer-73f3ee55-620c-5e19-9c18-cc60974bcb4e"] :db/ensure [:answer-field/validate]} {:db/id "answer-39daa7e5-cb5c-5741-9a21-580afc034598" :answer/id #uuid "39daa7e5-cb5c-5741-9a21-580afc034598" :answer/type :answer.type/math :answer/value "(A∧B)∨(¬A∧¬B)" :db/ensure [:answer/validate]} {:db/id "answer-74facaaf-1f98-50c8-acb9-65561bcc86c7" :answer/id #uuid "74facaaf-1f98-50c8-acb9-65561bcc86c7" :answer/type :answer.type/math :answer/value "(¬A∧B)∧(A∧¬B)" :db/ensure [:answer/validate]} {:db/id "answer-af4e153b-eba0-5317-8b16-e0bc3532fae5" :answer/id #uuid "af4e153b-eba0-5317-8b16-e0bc3532fae5" :answer/type :answer.type/math :answer/value "(¬A∧B)∨(A∧¬B)" :db/ensure [:answer/validate]} {:db/id "answer-8ec18d04-5193-5b30-b1d2-9879366eceac" :answer/id #uuid "8ec18d04-5193-5b30-b1d2-9879366eceac" :answer/type :answer.type/math :answer/value "A∧¬B" :db/ensure [:answer/validate]} {:db/id "answer-73f3ee55-620c-5e19-9c18-cc60974bcb4e" :answer/id #uuid "73f3ee55-620c-5e19-9c18-cc60974bcb4e" :answer/type :answer.type/math :answer/value "¬A∧B" :db/ensure [:answer/validate]} {:db/id 17592186115251 :knowledge-point/questions ["question-e4359e6b-bf35-575a-ae91-b45c922f6599" "question-402decfa-8c35-5ba9-99e4-cbb1a7d10a25"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e4359e6b-bf35-575a-ae91-b45c922f6599" :question/id #uuid "e4359e6b-bf35-575a-ae91-b45c922f6599" :question/math-academy-id "q-130869" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}-3{R}_{1}?$  \n\n$$\nA=\\begin{bmatrix}3 & 1 \\\\ 1 & 0\\end{bmatrix},\\,B=\\begin{bmatrix}3 & 3 \\\\ 3 & 0\\end{bmatrix},\\,C=\\begin{bmatrix}3 & 3 \\\\ 1 & 3\\end{bmatrix}\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}3 & 1 \\\\ 1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ B & =\\begin{bmatrix}3 & 3 \\\\ 3 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ 3 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}3 & 0 \\\\ -6 & 3\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ C & =\\begin{bmatrix}3 & 3 \\\\ 1 & 3\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 3 \\\\ 3 & 3\\end{bmatrix} & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 \\\\ 0 & -6\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-183ebb8b-b94f-5368-a4cb-f0c252b56d9d"] :db/ensure [:question/validate]} {:db/id "answer-field-183ebb8b-b94f-5368-a4cb-f0c252b56d9d" :answer-field/id #uuid "183ebb8b-b94f-5368-a4cb-f0c252b56d9d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ef03338e-8c6f-589b-b20e-617684559f57" :answer-field/choices ["answer-0d977c53-3a34-58b6-8cdd-a248235b2fd8" "answer-ef03338e-8c6f-589b-b20e-617684559f57" "answer-7d61afc3-ba04-5d1e-bfb6-9dd3198312be" "answer-7c7cabe6-dba7-56c5-b445-4c5492131ed3" "answer-3ec18f23-b763-58fb-8b8c-46ee2412a5b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d977c53-3a34-58b6-8cdd-a248235b2fd8" :answer/id #uuid "0d977c53-3a34-58b6-8cdd-a248235b2fd8" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "answer-ef03338e-8c6f-589b-b20e-617684559f57" :answer/id #uuid "ef03338e-8c6f-589b-b20e-617684559f57" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "answer-7d61afc3-ba04-5d1e-bfb6-9dd3198312be" :answer/id #uuid "7d61afc3-ba04-5d1e-bfb6-9dd3198312be" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "answer-7c7cabe6-dba7-56c5-b445-4c5492131ed3" :answer/id #uuid "7c7cabe6-dba7-56c5-b445-4c5492131ed3" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "answer-3ec18f23-b763-58fb-8b8c-46ee2412a5b2" :answer/id #uuid "3ec18f23-b763-58fb-8b8c-46ee2412a5b2" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id "question-402decfa-8c35-5ba9-99e4-cbb1a7d10a25" :question/id #uuid "402decfa-8c35-5ba9-99e4-cbb1a7d10a25" :question/math-academy-id "q-131369" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{2}:={R}_{2}+(-5){R}_{1}\\,$ and $\\,{R}_{1}↔{R}_{2}?$\n\n$$\nA=\\begin{bmatrix}1 & 5 \\\\ 0 & 1\\end{bmatrix},\\,B=\\begin{bmatrix}0 & 1 \\\\ 1 & 5\\end{bmatrix},\\,C=\\begin{bmatrix}0 & 5 \\\\ 1 & 1\\end{bmatrix}\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =\\begin{bmatrix}1 & 5 \\\\ 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 5 \\\\ -5 & -24\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}-5 & -24 \\\\ 1 & 5\\end{bmatrix} \\\\  & \\ne I\\,\\times  \\\\ B & =\\begin{bmatrix}0 & 1 \\\\ 1 & 5\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 \\\\ 0 & 1\\end{bmatrix} \\\\  & =I\\,✓ \\\\ C & =\\begin{bmatrix}0 & 5 \\\\ 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}0 & 5 \\\\ 1 & -24\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -24 \\\\ 0 & 5\\end{bmatrix} \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-47995c39-2fbf-50c1-88eb-fc7945979660"] :db/ensure [:question/validate]} {:db/id "answer-field-47995c39-2fbf-50c1-88eb-fc7945979660" :answer-field/id #uuid "47995c39-2fbf-50c1-88eb-fc7945979660" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3be844dc-ab67-5ab5-a857-416dc1914385" :answer-field/choices ["answer-5e461a93-9edd-50b1-955e-0e0d2205e63a" "answer-6ffdf879-7f85-5d3c-a9be-f037117bb911" "answer-8ed99590-62b5-5952-b583-5223d1e59ec1" "answer-3be844dc-ab67-5ab5-a857-416dc1914385" "answer-e9d841cd-9cad-5ab8-852a-7051e0ca018b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e461a93-9edd-50b1-955e-0e0d2205e63a" :answer/id #uuid "5e461a93-9edd-50b1-955e-0e0d2205e63a" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "answer-6ffdf879-7f85-5d3c-a9be-f037117bb911" :answer/id #uuid "6ffdf879-7f85-5d3c-a9be-f037117bb911" :answer/type :answer.type/text :answer/value "$A$ only" :db/ensure [:answer/validate]} {:db/id "answer-8ed99590-62b5-5952-b583-5223d1e59ec1" :answer/id #uuid "8ed99590-62b5-5952-b583-5223d1e59ec1" :answer/type :answer.type/text :answer/value "$B$ and $C$ only" :db/ensure [:answer/validate]} {:db/id "answer-3be844dc-ab67-5ab5-a857-416dc1914385" :answer/id #uuid "3be844dc-ab67-5ab5-a857-416dc1914385" :answer/type :answer.type/text :answer/value "$B$ only" :db/ensure [:answer/validate]} {:db/id "answer-e9d841cd-9cad-5ab8-852a-7051e0ca018b" :answer/id #uuid "e9d841cd-9cad-5ab8-852a-7051e0ca018b" :answer/type :answer.type/text :answer/value "$C$ only" :db/ensure [:answer/validate]} {:db/id 17592186115250 :knowledge-point/questions ["question-0c4fe725-e7cf-5733-870d-da1a638a1a59" "question-fc1b75b6-fb85-5b50-9394-b22e6f324813"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0c4fe725-e7cf-5733-870d-da1a638a1a59" :question/id #uuid "0c4fe725-e7cf-5733-870d-da1a638a1a59" :question/math-academy-id "q-31944" :question/problem "The inverse of the $2\\times 2$ matrix $P$ is found using row operations, as shown below. Complete the process, and determine ${P}^{-1}.$\n\n$$\n\\begin{aligned}[P\\,|\\,I] & =\\begin{bmatrix}-3 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{bmatrix} & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -\\frac{1}{3} & -\\frac{1}{3} & 0 \\\\ 2 & 1 & 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -\\frac{1}{3} & -\\frac{1}{3} & 0 \\\\ 0 & \\frac{5}{3} & \\frac{2}{3} & 1\\end{bmatrix} & {R}_{2} & :=\\frac{3}{5}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -\\frac{1}{3} & -\\frac{1}{3} & 0 \\\\ 0 & 1 & \\frac{2}{5} & \\frac{3}{5}\\end{bmatrix} & {R}_{1} & :=\\text{___________} \\\\  & ∼\\begin{bmatrix}1 & 0 & \\bbox[2pt,lightgray]{\\phantom{a}} & \\bbox[2pt,lightgray]{\\phantom{a}} \\\\ 0 & 1 & \\bbox[2pt,lightgray]{\\phantom{a}} & \\bbox[2pt,lightgray]{\\phantom{a}}\\end{bmatrix}\\end{aligned}\n$$" :question/worked-solution "We write down $P$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $P$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[P\\,|\\,I] & =\\begin{bmatrix}-3 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{bmatrix} & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -\\frac{1}{3} & -\\frac{1}{3} & 0 \\\\ 2 & 1 & 0 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -\\frac{1}{3} & -\\frac{1}{3} & 0 \\\\ 0 & \\frac{5}{3} & \\frac{2}{3} & 1\\end{bmatrix} & {R}_{2} & :=\\frac{3}{5}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -\\frac{1}{3} & -\\frac{1}{3} & 0 \\\\ 0 & 1 & \\frac{2}{5} & \\frac{3}{5}\\end{bmatrix} & {R}_{1} & :={R}_{1}+\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -\\frac{1}{5} & \\frac{1}{5} \\\\ 0 & 1 & \\frac{2}{5} & \\frac{3}{5}\\end{bmatrix}\\end{aligned}\n$$\n\nThe matrix ${P}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{P}^{-1}=\\begin{bmatrix}-\\frac{1}{5} & \\frac{1}{5} \\\\ \\frac{2}{5} & \\frac{3}{5}\\end{bmatrix}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8cea2ad4-e0cc-5ef8-b8e2-86f20e8d1d7a"] :db/ensure [:question/validate]} {:db/id "answer-field-8cea2ad4-e0cc-5ef8-b8e2-86f20e8d1d7a" :answer-field/id #uuid "8cea2ad4-e0cc-5ef8-b8e2-86f20e8d1d7a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-040c7c52-d601-5b4a-8cce-2c82b4467752" :answer-field/choices ["answer-040c7c52-d601-5b4a-8cce-2c82b4467752" "answer-f813e534-3f08-5560-83fa-5f4a86758164" "answer-393c2f1c-adff-5c9b-a21d-31c26af6719a" "answer-f993fcf6-4b2e-5a24-bb1a-5f11dc0d69bd" "answer-fbf8994a-863c-5ec0-9bbb-aba0e4a5edbd"] :db/ensure [:answer-field/validate]} {:db/id "answer-040c7c52-d601-5b4a-8cce-2c82b4467752" :answer/id #uuid "040c7c52-d601-5b4a-8cce-2c82b4467752" :answer/type :answer.type/math :answer/value "{P}^{-1}=\\begin{bmatrix}-\\frac{1}{5} & \\frac{1}{5} \\\\ \\frac{2}{5} & \\frac{3}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-f813e534-3f08-5560-83fa-5f4a86758164" :answer/id #uuid "f813e534-3f08-5560-83fa-5f4a86758164" :answer/type :answer.type/math :answer/value "{P}^{-1}=\\begin{bmatrix}-\\frac{1}{5} & \\frac{1}{5} \\\\ \\frac{3}{5} & \\frac{2}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-393c2f1c-adff-5c9b-a21d-31c26af6719a" :answer/id #uuid "393c2f1c-adff-5c9b-a21d-31c26af6719a" :answer/type :answer.type/math :answer/value "{P}^{-1}=\\begin{bmatrix}-\\frac{2}{5} & \\frac{3}{5} \\\\ \\frac{1}{5} & \\frac{1}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-f993fcf6-4b2e-5a24-bb1a-5f11dc0d69bd" :answer/id #uuid "f993fcf6-4b2e-5a24-bb1a-5f11dc0d69bd" :answer/type :answer.type/math :answer/value "{P}^{-1}=\\begin{bmatrix}\\frac{1}{5} & -\\frac{1}{5} \\\\ \\frac{2}{5} & \\frac{3}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-fbf8994a-863c-5ec0-9bbb-aba0e4a5edbd" :answer/id #uuid "fbf8994a-863c-5ec0-9bbb-aba0e4a5edbd" :answer/type :answer.type/math :answer/value "{P}^{-1}=\\begin{bmatrix}\\frac{2}{5} & \\frac{1}{5} \\\\ -\\frac{1}{5} & \\frac{3}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "question-fc1b75b6-fb85-5b50-9394-b22e6f324813" :question/id #uuid "fc1b75b6-fb85-5b50-9394-b22e6f324813" :question/math-academy-id "q-31950" :question/problem "The inverse of the $2\\times 2$ matrix $H$ is found using row operations, as shown below. Complete the process, and determine ${H}^{-1}.$\n\n$$\n\\begin{aligned}[H\\,|\\,I] & =\\begin{bmatrix}1 & -5 & 1 & 0 \\\\ 0 & 5 & 0 & 1\\end{bmatrix} & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -5 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{5}\\end{bmatrix} & {R}_{1} & :=\\text{___________} \\\\  & ∼\\begin{bmatrix}1 & 0 & \\bbox[2pt,lightgray]{\\phantom{a}} & \\bbox[2pt,lightgray]{\\phantom{a}} \\\\ 0 & 1 & \\bbox[2pt,lightgray]{\\phantom{a}} & \\bbox[2pt,lightgray]{\\phantom{a}}\\end{bmatrix}\\end{aligned}\n$$" :question/worked-solution "We write down $H$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $H$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[H\\,|\\,I] & =\\begin{bmatrix}1 & -5 & 1 & 0 \\\\ 0 & 5 & 0 & 1\\end{bmatrix} & {R}_{2} & :=\\frac{1}{5}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -5 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{5}\\end{bmatrix} & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & \\frac{1}{5}\\end{bmatrix}\\end{aligned}\n$$\n\nThe matrix ${H}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{H}^{-1}=\\begin{bmatrix}1 & 1 \\\\ 0 & \\frac{1}{5}\\end{bmatrix}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c6403903-5168-5e04-a6e9-85eb37526148"] :db/ensure [:question/validate]} {:db/id "answer-field-c6403903-5168-5e04-a6e9-85eb37526148" :answer-field/id #uuid "c6403903-5168-5e04-a6e9-85eb37526148" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6e593ff-e2f9-560a-a77c-25b4d6de8cfc" :answer-field/choices ["answer-3c22ad66-b26d-5a27-9233-7a7ceefaf835" "answer-44376824-7a97-5e23-b2da-7f754656762c" "answer-f6e593ff-e2f9-560a-a77c-25b4d6de8cfc" "answer-39a89169-3778-5954-ae01-1cab1433e55a" "answer-1f0bf2c6-2e03-5703-b4b0-34e2eee19d94"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c22ad66-b26d-5a27-9233-7a7ceefaf835" :answer/id #uuid "3c22ad66-b26d-5a27-9233-7a7ceefaf835" :answer/type :answer.type/math :answer/value "{H}^{-1}=\\begin{bmatrix}-3 & 1 \\\\ \\frac{1}{5} & 1\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-44376824-7a97-5e23-b2da-7f754656762c" :answer/id #uuid "44376824-7a97-5e23-b2da-7f754656762c" :answer/type :answer.type/math :answer/value "{H}^{-1}=\\begin{bmatrix}1 & -3 \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-f6e593ff-e2f9-560a-a77c-25b4d6de8cfc" :answer/id #uuid "f6e593ff-e2f9-560a-a77c-25b4d6de8cfc" :answer/type :answer.type/math :answer/value "{H}^{-1}=\\begin{bmatrix}1 & 1 \\\\ 0 & \\frac{1}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-39a89169-3778-5954-ae01-1cab1433e55a" :answer/id #uuid "39a89169-3778-5954-ae01-1cab1433e55a" :answer/type :answer.type/math :answer/value "{H}^{-1}=\\begin{bmatrix}3 & 1 \\\\ \\frac{2}{5} & \\frac{1}{5}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-1f0bf2c6-2e03-5703-b4b0-34e2eee19d94" :answer/id #uuid "1f0bf2c6-2e03-5703-b4b0-34e2eee19d94" :answer/type :answer.type/math :answer/value "{H}^{-1}=\\begin{bmatrix}\\frac{1}{5} & 1 \\\\ 1 & -3\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id 17592186115249 :knowledge-point/questions ["question-2b6dc055-10e0-54e5-be96-be9101fa62fe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2b6dc055-10e0-54e5-be96-be9101fa62fe" :question/id #uuid "2b6dc055-10e0-54e5-be96-be9101fa62fe" :question/math-academy-id "q-31873" :question/problem "The inverse of the matrix $B$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[B\\,|\\,I] & =\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & -3 & 0 & 1\\end{bmatrix} &  & \\text{___________} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & 1 & 0 & -\\frac{1}{3}\\end{bmatrix} &  & \\text{___________} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & -\\frac{2}{3} \\\\ 0 & 1 & 0 & -\\frac{1}{3}\\end{bmatrix}\\end{aligned}\n$$" :question/worked-solution "We write down $B$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $B$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[B\\,|\\,I] & =\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & -3 & 0 & 1\\end{bmatrix} & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & 1 & 0 & -\\frac{1}{3}\\end{bmatrix} & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 1 & -\\frac{2}{3} \\\\ 0 & 1 & 0 & -\\frac{1}{3}\\end{bmatrix}\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}.\n$$\n\nThe matrix ${B}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{B}^{-1}=\\begin{bmatrix}1 & -\\frac{2}{3} \\\\ 0 & -\\frac{1}{3}\\end{bmatrix}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2c47d228-518f-5f23-905f-048259f6ebd8"] :db/ensure [:question/validate]} {:db/id "answer-field-2c47d228-518f-5f23-905f-048259f6ebd8" :answer-field/id #uuid "2c47d228-518f-5f23-905f-048259f6ebd8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3e011d9a-e2a1-5c97-831c-112941f7ff7c" :answer-field/choices ["answer-195a63cb-f5a8-5711-a471-ac8f4d189dc7" "answer-b3277787-8365-5a07-999a-0eece68ddb73" "answer-6ac9ecad-192d-5487-83f8-e430bc970888" "answer-3e011d9a-e2a1-5c97-831c-112941f7ff7c" "answer-0570880b-aeb7-5022-8029-b76444e6d57d"] :db/ensure [:answer-field/validate]} {:db/id "answer-195a63cb-f5a8-5711-a471-ac8f4d189dc7" :answer/id #uuid "195a63cb-f5a8-5711-a471-ac8f4d189dc7" :answer/type :answer.type/math :answer/value "{R}_{2}:=-\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+(-3){R}_{2}" :db/ensure [:answer/validate]} {:db/id "answer-b3277787-8365-5a07-999a-0eece68ddb73" :answer/id #uuid "b3277787-8365-5a07-999a-0eece68ddb73" :answer/type :answer.type/math :answer/value "{R}_{2}:=-\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+3{R}_{2}" :db/ensure [:answer/validate]} {:db/id "answer-6ac9ecad-192d-5