d "ff18c22f-89d1-5b1f-98b9-9afbcdcdcf72" :step/content "question-8f2aebee-176b-5447-94e6-cdb44a5559c2" :step/next "step-1f7491a9-cbc7-503f-a32b-7dc183ace05c" :db/ensure [:step/validate]} {:db/id "step-1f7491a9-cbc7-503f-a32b-7dc183ace05c" :step/id #uuid "1f7491a9-cbc7-503f-a32b-7dc183ace05c" :step/content "question-0c781737-7cc2-58de-b406-ca857cb292ed" :step/next "step-ee9d77fa-39bd-50a2-8011-efa60eaea1f8" :db/ensure [:step/validate]} {:db/id "step-ee9d77fa-39bd-50a2-8011-efa60eaea1f8" :step/id #uuid "ee9d77fa-39bd-50a2-8011-efa60eaea1f8" :step/content 17592186262987 :db/ensure [:step/validate]} {:db/id 17592186184239 :knowledge-point/questions ["question-d1c19cde-3b7d-5f98-929b-d663820d03f1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d1c19cde-3b7d-5f98-929b-d663820d03f1" :question/id #uuid "d1c19cde-3b7d-5f98-929b-d663820d03f1" :question/math-academy-id "q-152866" :question/problem "What is the value of ${lim}_{x\\to \\,\\infty }2\\operatorname{arccos}⁡(\\frac{x-4}{2})?$" :question/worked-solution "First, let's sketch the graph of $y=\\operatorname{arccos}⁡(\\frac{x-4}{2}):$ \n\n![](images/ff/fffe2ba1124b8edd04902db5ad2b0945e5e04372ae0a0ed338c893f0ae417c58.png)\n\nThe domain of $\\operatorname{arccos}⁡(\\frac{x-4}{2})$ is $x\\in [2,6].$ This means that $\\operatorname{arccos}⁡(\\frac{x-4}{2})$ is undefined outside this interval.\n\nTherefore, ${lim}_{x\\to \\,\\infty }2\\operatorname{arccos}⁡(\\frac{x-4}{2})$ is undefined." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a9c57c23-5852-5310-9404-decf58de586e"] :db/ensure [:question/validate]} {:db/id "answer-field-a9c57c23-5852-5310-9404-decf58de586e" :answer-field/id #uuid "a9c57c23-5852-5310-9404-decf58de586e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-764e658d-447d-5f2a-93a6-3aa41f77521f" :answer-field/choices ["answer-21db6ee1-4f00-52f4-bdef-e6f8f76bdece" "answer-d0b25d82-2de9-525d-98e6-baf42b5cc386" "answer-d2d93958-0196-5461-ae0e-a6c55afcd4bc" "answer-393180ce-477f-5b4c-ade3-c57dfc5fc14e" "answer-764e658d-447d-5f2a-93a6-3aa41f77521f"] :db/ensure [:answer-field/validate]} {:db/id "answer-21db6ee1-4f00-52f4-bdef-e6f8f76bdece" :answer/id #uuid "21db6ee1-4f00-52f4-bdef-e6f8f76bdece" :answer/type :answer.type/math :answer/value "2\\pi" :db/ensure [:answer/validate]} {:db/id "answer-d0b25d82-2de9-525d-98e6-baf42b5cc386" :answer/id #uuid "d0b25d82-2de9-525d-98e6-baf42b5cc386" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-d2d93958-0196-5461-ae0e-a6c55afcd4bc" :answer/id #uuid "d2d93958-0196-5461-ae0e-a6c55afcd4bc" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-393180ce-477f-5b4c-ade3-c57dfc5fc14e" :answer/id #uuid "393180ce-477f-5b4c-ade3-c57dfc5fc14e" :answer/type :answer.type/math :answer/value "\\pi" :db/ensure [:answer/validate]} {:db/id "answer-764e658d-447d-5f2a-93a6-3aa41f77521f" :answer/id #uuid "764e658d-447d-5f2a-93a6-3aa41f77521f" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id 17592186184240 :knowledge-point/questions ["question-002cab17-2b93-5a94-bc24-04ae7b92f4f9" "question-2f397079-49a9-58d1-bc93-fa23602eefa7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-002cab17-2b93-5a94-bc24-04ae7b92f4f9" :question/id #uuid "002cab17-2b93-5a94-bc24-04ae7b92f4f9" :question/math-academy-id "q-152871" :question/problem "${lim}_{x\\to \\,4}\\operatorname{sin}⁡(\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi )=$" :question/worked-solution "First, let's sketch the graph of  $y=\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi :$   \n\n![](images/42/42eb38a11d9d63e05c0078bae4c052566b3162571e8563f22cd52ae31bc6dbd7.png)\n\nThe domain of   $\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi$ is $(-\\infty ,\\infty ).$  \n\nNow, substituting $x=4$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,4}\\operatorname{sin}⁡(\\operatorname{arctan}⁡(\\frac{x}{4})+\\pi ) & =\\operatorname{sin}⁡(\\operatorname{arctan}⁡(1)+\\pi ) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{4}+\\pi ) \\\\  & =\\operatorname{sin}⁡(\\frac{5\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6c3ab6b7-6e70-535c-9a1b-8fc6113a3975"] :db/ensure [:question/validate]} {:db/id "answer-field-6c3ab6b7-6e70-535c-9a1b-8fc6113a3975" :answer-field/id #uuid "6c3ab6b7-6e70-535c-9a1b-8fc6113a3975" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-23691b4e-ef96-59e7-b343-43a0604ca109" :answer-field/choices ["answer-7059fd79-bfc5-56de-bb09-06241fc81d5b" "answer-23691b4e-ef96-59e7-b343-43a0604ca109" "answer-11ddabc6-6948-5d05-984f-8724d78f9060" "answer-8bcb3571-4895-5ea8-a376-01f2897be6f5" "answer-1ac77e93-6655-5cb9-83e2-8d0071ffa65a"] :db/ensure [:answer-field/validate]} {:db/id "answer-7059fd79-bfc5-56de-bb09-06241fc81d5b" :answer/id #uuid "7059fd79-bfc5-56de-bb09-06241fc81d5b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-23691b4e-ef96-59e7-b343-43a0604ca109" :answer/id #uuid "23691b4e-ef96-59e7-b343-43a0604ca109" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-11ddabc6-6948-5d05-984f-8724d78f9060" :answer/id #uuid "11ddabc6-6948-5d05-984f-8724d78f9060" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-8bcb3571-4895-5ea8-a376-01f2897be6f5" :answer/id #uuid "8bcb3571-4895-5ea8-a376-01f2897be6f5" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1ac77e93-6655-5cb9-83e2-8d0071ffa65a" :answer/id #uuid "1ac77e93-6655-5cb9-83e2-8d0071ffa65a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "question-2f397079-49a9-58d1-bc93-fa23602eefa7" :question/id #uuid "2f397079-49a9-58d1-bc93-fa23602eefa7" :question/math-academy-id "q-344566" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\,\\frac{1}{\\sqrt{3}}}cos\\,(\\operatorname{arctan}⁡(3x))=$\n{{field-1}}" :question/worked-solution "![](images/86/86c0cf22de78e3b773543680c2ace077f97b66ae822436d637c5444903e2330f.png)\n\nThe domain of $\\operatorname{arctan}⁡(3x)$ is $(-\\infty ,\\infty ).$\n\nNow, substituting $x=\\frac{1}{\\sqrt{3}}$ directly into the limit, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,\\frac{1}{\\sqrt{3}}}cos\\,(\\operatorname{arctan}⁡(3x)) & =cos\\,(arctan\\,(3\\cdot \\frac{1}{\\sqrt{3}})) \\\\  & =cos\\,(arctan\\,(\\sqrt{3})) \\\\  & =cos\\,(\\frac{\\pi }{3}) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-52153792-c358-5ad7-a1f9-bbbc25297261"] :db/ensure [:question/validate]} {:db/id "answer-field-52153792-c358-5ad7-a1f9-bbbc25297261" :answer-field/id #uuid "52153792-c358-5ad7-a1f9-bbbc25297261" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cab12af0-b59f-5bad-b4db-8eea41c70809" :answer-field/choices ["answer-cab12af0-b59f-5bad-b4db-8eea41c70809"] :db/ensure [:answer-field/validate]} {:db/id "answer-cab12af0-b59f-5bad-b4db-8eea41c70809" :answer/id #uuid "cab12af0-b59f-5bad-b4db-8eea41c70809" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "activity-a37052fa-fb0a-5851-826e-d84fd50e18cf" :activity/id #uuid "a37052fa-fb0a-5851-826e-d84fd50e18cf" :activity/title "Limits of Inverse Trigonometric Functions" :activity/type :activity.type/review :activity/scope 17592186050756 :activity/course 17592186046673 :activity/steps ["step-a0212770-e29d-50bd-b4a4-f099eaf2835b" "step-2ec792e1-dee9-5e77-b785-5597e0c43364" "step-4ba79a17-62dc-5f7c-94c1-fc0884ba6fdc" "step-ff0c0