eld-20e48ca9-80f3-5bdd-beed-e52606176cac" :answer-field/id #uuid "20e48ca9-80f3-5bdd-beed-e52606176cac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f5f3505-15b1-548f-bc68-5dc8b5cd1856" :answer-field/choices ["answer-06f4878d-2b22-5080-b71d-e44372f2d016" "answer-87f5f51b-4856-5dc0-b0e5-2f3c355ea3be" "answer-3f5f3505-15b1-548f-bc68-5dc8b5cd1856" "answer-c114d74b-8feb-5637-9c93-f0e010981f98" "answer-94a4df81-f598-5b1a-8c7c-7dfe90337b8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-06f4878d-2b22-5080-b71d-e44372f2d016" :answer/id #uuid "06f4878d-2b22-5080-b71d-e44372f2d016" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-87f5f51b-4856-5dc0-b0e5-2f3c355ea3be" :answer/id #uuid "87f5f51b-4856-5dc0-b0e5-2f3c355ea3be" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-3f5f3505-15b1-548f-bc68-5dc8b5cd1856" :answer/id #uuid "3f5f3505-15b1-548f-bc68-5dc8b5cd1856" :answer/type :answer.type/math :answer/value "\\sqrt{13}" :db/ensure [:answer/validate]} {:db/id "answer-c114d74b-8feb-5637-9c93-f0e010981f98" :answer/id #uuid "c114d74b-8feb-5637-9c93-f0e010981f98" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-94a4df81-f598-5b1a-8c7c-7dfe90337b8c" :answer/id #uuid "94a4df81-f598-5b1a-8c7c-7dfe90337b8c" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "question-aee063d1-50f9-564e-a7e9-bfddcd038224" :question/id #uuid "aee063d1-50f9-564e-a7e9-bfddcd038224" :question/math-academy-id "q-17616" :question/problem "Let $a=⟨-2,7⟩.$ Find $|\\,a\\,|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+(7)^{2}} \\\\  & =\\sqrt{4+49} \\\\  & =\\sqrt{53}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-837da19e-bdf7-595c-b9f5-dac18fb60790"] :db/ensure [:question/validate]} {:db/id "answer-field-837da19e-bdf7-595c-b9f5-dac18fb60790" :answer-field/id #uuid "837da19e-bdf7-595c-b9f5-dac18fb60790" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-60bf083e-3a33-524b-9653-f2ca3d265df2" :answer-field/choices ["answer-951751dc-25fa-54f0-bb3e-3f6f69037922" "answer-f9e1c41a-04cb-544b-8889-aaf571180749" "answer-60bf083e-3a33-524b-9653-f2ca3d265df2" "answer-111fbb05-f522-5735-8207-38753554e5cc" "answer-f2a9e490-80bb-5877-8dc0-511713e73021"] :db/ensure [:answer-field/validate]} {:db/id "answer-951751dc-25fa-54f0-bb3e-3f6f69037922" :answer/id #uuid "951751dc-25fa-54f0-bb3e-3f6f69037922" :answer/type :answer.type/math :answer/value "\\sqrt{50}" :db/ensure [:answer/validate]} {:db/id "answer-f9e1c41a-04cb-544b-8889-aaf571180749" :answer/id #uuid "f9e1c41a-04cb-544b-8889-aaf571180749" :answer/type :answer.type/math :answer/value "\\sqrt{52}" :db/ensure [:answer/validate]} {:db/id "answer-60bf083e-3a33-524b-9653-f2ca3d265df2" :answer/id #uuid "60bf083e-3a33-524b-9653-f2ca3d265df2" :answer/type :answer.type/math :answer/value "\\sqrt{53}" :db/ensure [:answer/validate]} {:db/id "answer-111fbb05-f522-5735-8207-38753554e5cc" :answer/id #uuid "111fbb05-f522-5735-8207-38753554e5cc" :answer/type :answer.type/math :answer/value "\\sqrt{55}" :db/ensure [:answer/validate]} {:db/id "answer-f2a9e490-80bb-5877-8dc0-511713e73021" :answer/id #uuid "f2a9e490-80bb-5877-8dc0-511713e73021" :answer/type :answer.type/math :answer/value "\\sqrt{56}" :db/ensure [:answer/validate]} {:db/id "question-de84f93a-9a95-5709-8b3a-1c7aaa638199" :question/id #uuid "de84f93a-9a95-5709-8b3a-1c7aaa638199" :question/math-academy-id "q-1330" :question/problem "Let $\\overset{\\to }{U}=⟨7,-1⟩.$ Find $|\\,\\overset{\\to }{U}|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,\\overset{\\to }{U}| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(7)^{2}+(-1)^{2}} \\\\  & =\\sqrt{49+1} \\\\  & =\\sqrt{50} \\\\  & =\\sqrt{25\\cdot 2} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-75e5c39a-4f29-5171-b743-cd598384ab3c"] :db/ensure [:question/validate]} {:db/id "answer-field-75e5c39a-4f29-5171-b743-cd598384ab3c" :answer-field/id #uuid "75e5c39a-4f29-5171-b743-cd598384ab3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b6bb977-d9f3-5ac7-aa36-12e676435303" :answer-field/choices ["answer-d4da40ff-148d-5e81-bb1e-7550030dcf49" "answer-a8dc62f1-9b87-5c5f-bcbc-3dc1a7455c59" "answer-3b6bb977-d9f3-5ac7-aa36-12e676435303" "answer-f99c4b85-6ca6-540b-bc9f-de4142e72920" "answer-29691489-fe06-51db-9613-0837b0228553"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4da40ff-148d-5e81-bb1e-7550030dcf49" :answer/id #uuid "d4da40ff-148d-5e81-bb1e-7550030dcf49" :answer/type :answer.type/math :answer/value "2\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-a8dc62f1-9b87-5c5f-bcbc-3dc1a7455c59" :answer/id #uuid "a8dc62f1-9b87-5c5f-bcbc-3dc1a7455c59" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-3b6bb977-d9f3-5ac7-aa36-12e676435303" :answer/id #uuid "3b6bb977-d9f3-5ac7-aa36-12e676435303" :answer/type :answer.type/math :answer/value "5\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-f99c4b85-6ca6-540b-bc9f-de4142e72920" :answer/id #uuid "f99c4b85-6ca6-540b-bc9f-de4142e72920" :answer/type :answer.type/math :answer/value "\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "answer-29691489-fe06-51db-9613-0837b0228553" :answer/id #uuid "29691489-fe06-51db-9613-0837b0228553" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-9c74dff8-a34c-5a12-a8c0-881272406626" :question/id #uuid "9c74dff8-a34c-5a12-a8c0-881272406626" :question/math-academy-id "q-1326" :question/problem "If $u=⟨-3,-5⟩$, then what is the magnitude of $u?$" :question/worked-solution "Using the formula, we have \n\n$$\n\\begin{aligned}|\\,u\\,| & =\\sqrt{{u}_{x}^{2}+{u}_{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(-5)^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4f5a668f-140d-5ea6-b6c3-21a8cbb8bfc7"] :db/ensure [:question/validate]} {:db/id "answer-field-4f5a668f-140d-5ea6-b6c3-21a8cbb8bfc7" :answer-field/id #uuid "4f5a668f-140d-5ea6-b6c3-21a8cbb8bfc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3449bba-2a92-58bc-975c-d54b2afa32da" :answer-field/choices ["answer-5f6db638-2f62-5677-827d-ee425c9aafcb" "answer-ec43eb77-641f-58c3-9a18-ba04193242f6" "answer-18d115c9-84d2-581b-ae54-3c5a392028f1" "answer-416bf8df-8b35-5b3b-8251-fed7dfc9545a" "answer-a3449bba-2a92-58bc-975c-d54b2afa32da"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f6db638-2f62-5677-827d-ee425c9aafcb" :answer/id #uuid "5f6db638-2f62-5677-827d-ee425c9aafcb" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-ec43eb77-641f-58c3-9a18-ba04193242f6" :answer/id #uuid "ec43eb77-641f-58c3-9a18-ba04193242f6" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-18d115c9-84d2-581b-ae54-3c5a392028f1" :answer/id #uuid "18d115c9-84d2-581b-ae54-3c5a392028f1" :answer/type :answer.type/math :answer/value "\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "answer-416bf8df-8b35-5b3b-8251-fed7dfc9545a" :answer/id #uuid "416bf8df-8b35-5b3b-8251-fed7dfc9545a" :answer/type :answer.type/math :answer/value "\\sqrt{31}" :db/ensure [:answer/validate]} {:db/id "answer-a3449bba-2a92-58bc-975c-d54b2afa32da" :answer/id #uuid "a3449bba-2a92-58bc-975c-d54b2afa32da" :answer/type :answer.type/math :answer/value "\\sqrt{34}" :db/ensure [:answer/validate]} {:db/id 17592186059715 :knowledge-point/questions ["question-a88ebacd-81cc-571b-8835-0aed7b200fdc" "question-8c1db841-92ab-5a9b-b59a-bd03ce09afe3" "question-65c77d8f-4e68-5667-bebf-382cd66bf3e2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a88ebacd-81cc-571b-8835-0aed7b200fdc" :question/id #uuid "a88ebacd-81cc-571b-8835-0aed7b200fdc" :question/math-academy-id "q-320964" :question/problem "![](images/cf/cf7890789d1b80002ac2055fd61e8c8f58525f9bb1714bd77ff6e8542567e962.png)\n\nLet $A(-2,0)$ and $B(3,3).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=-2i+0j, \\\\  & \\overset{\\to }{OB}=b=3i+3j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(3i+3j)-(-2i+0j) \\\\  & =5i+3j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{5}^{2}+{3}^{2}} \\\\  & =\\sqrt{25+9} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f71eec51-55f5-5ed3-a5a6-c93f3bce746d"] :db/ensure [:question/validate]} {:db/id "answer-field-f71eec51-55f5-5ed3-a5a6-c93f3bce746d" :answer-field/id #uuid "f71eec51-55f5-5ed3-a5a6-c93f3bce746d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer-field/choices ["answer-200a4d21-812f-5dd9-a1e8-34e8c33d93df"] :db/ensure [:answer-field/validate]} {:db/id "answer-200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer/id #uuid "200a4d21-812f-5dd9-a1e8-34e8c33d93df" :answer/type :answer.type/math :answer/value "\\sqrt{34}" :db/ensure [:answer/validate]} {:db/id "question-8c1db841-92ab-5a9b-b59a-bd03ce09afe3" :question/id #uuid "8c1db841-92ab-5a9b-b59a-bd03ce09afe3" :question/math-academy-id "q-18057" :question/problem "![](images/b9/b911126b4468e016afbab7faaf20223d0811827bb7f57cdefc2f1923cb7faf1b.png)\n\nPoints $A$ and $C$ are shown in the picture above. Find $|\\overset{\\to }{AC}|.$" :question/worked-solution "From the picture, we obtain $A(0,3)$ and $C(4,0).$ So, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OC}=c=4i+0j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AC}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AC} & =\\overset{\\to }{OC}-\\overset{\\to }{OA} \\\\  & =c-a \\\\  & =(4i)-(3j) \\\\  & =4i-3j\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AC}| & =\\sqrt{(4)^{2}+(-3)^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-23f50047-f3e3-54c2-a0eb-ca4d6b6bb3ac"] :db/ensure [:question/validate]} {:db/id "answer-field-23f50047-f3e3-54c2-a0eb-ca4d6b6bb3ac" :answer-field/id #uuid "23f50047-f3e3-54c2-a0eb-ca4d6b6bb3ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aec58b42-8779-526c-bd77-df664c625168" :answer-field/choices ["answer-a1d6c940-f208-59e6-abc2-918bb6b4ed48" "answer-61691c6b-be2a-578a-a95a-691cf407bc55" "answer-911f0451-83e2-59cb-94bc-9e71ecca138f" "answer-aec58b42-8779-526c-bd77-df664c625168" "answer-1b71bc5a-ea49-5c5c-8189-d231b7b94741"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1d6c940-f208-59e6-abc2-918bb6b4ed48" :answer/id #uuid "a1d6c940-f208-59e6-abc2-918bb6b4ed48" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-61691c6b-be2a-578a-a95a-691cf407bc55" :answer/id #uuid "61691c6b-be2a-578a-a95a-691cf407bc55" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-911f0451-83e2-59cb-94bc-9e71ecca138f" :answer/id #uuid "911f0451-83e2-59cb-94bc-9e71ecca138f" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-aec58b42-8779-526c-bd77-df664c625168" :answer/id #uuid "aec58b42-8779-526c-bd77-df664c625168" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-1b71bc5a-ea49-5c5c-8189-d231b7b94741" :answer/id #uuid "1b71bc5a-ea49-5c5c-8189-d231b7b94741" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-65c77d8f-4e68-5667-bebf-382cd66bf3e2" :question/id #uuid "65c77d8f-4e68-5667-bebf-382cd66bf3e2" :question/math-academy-id "q-320965" :question/problem "![](images/45/453e8fc1c4d8a5262fd0a8aa7341dd71b909a4a72cec94cd2698f800f7dc06c9.png)\n\nLet $A(0,3)$ and $B(4,-1).$ Find $|\\overset{\\to }{AB}|.$ Do not round the answer.\n\n$|\\overset{\\to }{AB}|=$\n{{field-1}}" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=0i+3j, \\\\  & \\overset{\\to }{OB}=b=4i-j.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =(4i-j)-(0i+3j) \\\\  & =4i-4j.\\end{aligned}\n$$\n\nNow, using the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\overset{\\to }{AB}| & =\\sqrt{{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-19605a89-6fbc-50e5-80b4-4cc3c9941a36"] :db/ensure [:question/validate]} {:db/id "answer-field-19605a89-6fbc-50e5-80b4-4cc3c9941a36" :answer-field/id #uuid "19605a89-6fbc-50e5-80b4-4cc3c9941a36" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer-field/choices ["answer-7001357a-d27f-5f38-bb51-c1671b2f85e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer/id #uuid "7001357a-d27f-5f38-bb51-c1671b2f85e3" :answer/type :answer.type/math :answer/value "4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id 17592186059716 :knowledge-point/questions ["question-54931a2c-0179-55ba-b42e-021e69939399" "question-efcda90e-97e9-5de4-ab6e-f342fb013418"] :db/ensure [:knowledge-point/validate]} {:db/id "question-54931a2c-0179-55ba-b42e-021e69939399" :question/id #uuid "54931a2c-0179-55ba-b42e-021e69939399" :question/math-academy-id "q-70415" :question/problem "Let $r=\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}$ and $s=\\begin{bmatrix}0 \\\\ -3\\end{bmatrix}.$ Find a unit vector that is parallel to $3r+2s$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction., we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|}\\end{aligned}\n$$\n\nFirst, let's compute the sum:\n\n$$\n\\begin{aligned}3r+2s & =3\\cdot \\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}+2\\cdot \\begin{bmatrix}0 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ 3\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}(-6)+0 \\\\ 3+(-6)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 \\\\ -3\\end{bmatrix}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|3r+2s| & =\\sqrt{(-6)^{2}+(-3)^{2}} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $3r+2s$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{3r+2s}{|3r+2s|} \\\\  & =\\frac{1}{3\\sqrt{5}}(3r+2s) \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot \\begin{bmatrix}-6 \\\\ -3\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-486b8f01-6945-5809-91a8-88d9d6a85f09"] :db/ensure [:question/validate]} {:db/id "answer-field-486b8f01-6945-5809-91a8-88d9d6a85f09" :answer-field/id #uuid "486b8f01-6945-5809-91a8-88d9d6a85f09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer-field/choices ["answer-c8e40bc8-06c3-562a-83ac-e13c465cde6d" "answer-72f71719-0fa2-5d74-951f-4a5a6316e2e2" "answer-ebc2b5a5-a24d-5729-84ca-0b3b24f51964" "answer-cf3a28aa-2fb3-5f9e-a119-7bce309125f5" "answer-76cef696-33d5-53c7-a20a-186993b395fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8e40bc8-06c3-562a-83ac-e13c465cde6d" :answer/id #uuid "c8e40bc8-06c3-562a-83ac-e13c465cde6d" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{15}} \\\\ -\\frac{1}{\\sqrt{15}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-72f71719-0fa2-5d74-951f-4a5a6316e2e2" :answer/id #uuid "72f71719-0fa2-5d74-951f-4a5a6316e2e2" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{3}} \\\\ -\\frac{1}{\\sqrt{3}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer/id #uuid "ebc2b5a5-a24d-5729-84ca-0b3b24f51964" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-cf3a28aa-2fb3-5f9e-a119-7bce309125f5" :answer/id #uuid "cf3a28aa-2fb3-5f9e-a119-7bce309125f5" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{6}{\\sqrt{13}} \\\\ -\\frac{3}{\\sqrt{13}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-76cef696-33d5-53c7-a20a-186993b395fb" :answer/id #uuid "76cef696-33d5-53c7-a20a-186993b395fb" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{6}{\\sqrt{5}} \\\\ -\\frac{3}{\\sqrt{5}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "question-efcda90e-97e9-5de4-ab6e-f342fb013418" :question/id #uuid "efcda90e-97e9-5de4-ab6e-f342fb013418" :question/math-academy-id "q-125137" :question/problem "Let $r=\\begin{bmatrix}-3 \\\\ -6\\end{bmatrix}.$ Find a unit vector that is parallel to $r$ and points the same direction." :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector and points the same direction, we need to divide the given vector by its length:\n\n$$\n\\begin{aligned}u & =\\frac{r}{|\\,r\\,|}\\end{aligned}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,r\\,| & =\\sqrt{(-3)^{2}+(-6)^{2}} \\\\  & =\\sqrt{9+36} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $r$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{r}{|r|} \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot r \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot \\begin{bmatrix}-3 \\\\ -6\\end{bmatrix} \\\\  & =\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ad9dfc42-a7b2-570f-831f-bdb8b850c4c5"] :db/ensure [:question/validate]} {:db/id "answer-field-ad9dfc42-a7b2-570f-831f-bdb8b850c4c5" :answer-field/id #uuid "ad9dfc42-a7b2-570f-831f-bdb8b850c4c5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-79a93776-a59c-5551-bd4b-8aac720a2d40" :answer-field/choices ["answer-20e6eaac-82d9-5705-8448-025257524e8c" "answer-79a93776-a59c-5551-bd4b-8aac720a2d40" "answer-1069ee09-17b5-57ab-aab5-38e6b996e90c" "answer-acc576d0-0654-519c-b96b-6398ec344ad9" "answer-a81428f3-9e59-5a07-9500-76476f5034a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-20e6eaac-82d9-5705-8448-025257524e8c" :answer/id #uuid "20e6eaac-82d9-5705-8448-025257524e8c" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{1}{5\\sqrt{3}} \\\\ -\\frac{2}{5\\sqrt{3}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-79a93776-a59c-5551-bd4b-8aac720a2d40" :answer/id #uuid "79a93776-a59c-5551-bd4b-8aac720a2d40" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-1069ee09-17b5-57ab-aab5-38e6b996e90c" :answer/id #uuid "1069ee09-17b5-57ab-aab5-38e6b996e90c" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{3}{2\\sqrt{5}} \\\\ -\\frac{3}{\\sqrt{5}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-acc576d0-0654-519c-b96b-6398ec344ad9" :answer/id #uuid "acc576d0-0654-519c-b96b-6398ec344ad9" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{3}{5\\sqrt{3}} \\\\ -\\frac{6}{5\\sqrt{3}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-a81428f3-9e59-5a07-9500-76476f5034a4" :answer/id #uuid "a81428f3-9e59-5a07-9500-76476f5034a4" :answer/type :answer.type/math :answer/value "\\begin{bmatrix}-\\frac{3}{\\sqrt{5}} \\\\ -\\frac{6}{\\sqrt{5}}\\end{bmatrix}" :db/ensure [:answer/validate]} {:db/id 17592186060910 :tutorial/content "Consider the vector $\\mathbf{a}=\\langle -2,4 \\rangle$ shown below.\n\n![](images/cd/cd458eeb41ee09d6a4f58bc343575d46e3d362dc3edca40a47e1a7381fcc9bd2.png)\n\nExpressed in component form, our vector is $\\mathbf{a}=-2\\mathbf{i} + 4 \\mathbf{j}.$\n\nTo find the magnitude (length) of $\\mathbf{a},$ we can use the Pythagorean theorem on $\\triangle OXA.$\n\nThe legs of the triangle have lengths\n\n$$\n\\begin{aligned}|\\overset{\\to }{OX}| & =|-2|=2\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}|\\overset{\\to }{XA}| & =|\\,4\\,|=4.\\end{aligned}\n$$\n\nNow, using the Pythagorean theorem, we have\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{|\\overset{\\to }{OX}{|}^{2}+|\\overset{\\to }{XA}{|}^{2}} \\\\  & =\\sqrt{{2}^{2}+{4}^{2}} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186060911 :tutorial/content "We just saw that the magnitude of the vector $\\mathbf{a}=\\langle -2,4 \\rangle$ was given by\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{(-2)^{2}+{4}^{2}} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$\n\nIn general, given a vector\n![](images/10/10fbddb6dc3528629e5583ad25976d049ca2ec5943ce3e689953f79299b8afcd.svg)\nthe magnitude of the vector can always be computed as\n\n$$\n|\\,\\mathbf{a}\\,| = \\sqrt{a_x^2+a_y^2}.\n$$\n\n**Note**\n\nWe sometimes use the notation $|| \\mathbf a ||$ to denote the magnitude of a vector." :db/ensure [:tutorial/validate]} {:db/id 17592186059899 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186059777 :knowledge-point/questions ["question-ec004b06-3312-5bf4-be49-682afc34bcbf" "question-c2988660-d9f8-5b55-910c-35b17be03f50"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ec004b06-3312-5bf4-be49-682afc34bcbf" :question/id #uuid "ec004b06-3312-5bf4-be49-682afc34bcbf" :question/math-academy-id "q-182531" :question/problem "If $A$ is false and $B$ is true, then $A⇔B$ is\n\n{{field-1}}." :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo, when $A=\\text{F}$ and $B=\\text{T},$ we have\n\n$$\n\\begin{aligned}(A⇔B) & =(\\text{F}⇔\\text{T}) \\\\  & =\\text{F}.\\end{aligned}\n$$\n\nThe complete truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A⇔B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n|  |  |  |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2e701f88-7e5e-53b4-8ecd-de2a796d1c4f"] :db/ensure [:question/validate]} {:db/id "answer-field-2e701f88-7e5e-53b4-8ecd-de2a796d1c4f" :answer-field/id #uuid "2e701f88-7e5e-53b4-8ecd-de2a796d1c4f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-dd386d27-29fb-5876-82ae-816c9964363a" :answer-field/choices ["answer-dd386d27-29fb-5876-82ae-816c9964363a" "answer-c40155d8-dfe0-521d-ada0-32ee2755b311" "answer-82f681a1-0b3c-5803-8e07-63d9408a9f9d" "answer-95fda5b2-41b7-5f84-a8c6-0bac46270c86"] :db/ensure [:answer-field/validate]} {:db/id "answer-dd386d27-29fb-5876-82ae-816c9964363a" :answer/id #uuid "dd386d27-29fb-5876-82ae-816c9964363a" :answer/type :answer.type/text :answer/value "always false" :db/ensure [:answer/validate]} {:db/id "answer-c40155d8-dfe0-521d-ada0-32ee2755b311" :answer/id #uuid "c40155d8-dfe0-521d-ada0-32ee2755b311" :answer/type :answer.type/text :answer/value "always true" :db/ensure [:answer/validate]} {:db/id "answer-82f681a1-0b3c-5803-8e07-63d9408a9f9d" :answer/id #uuid "82f681a1-0b3c-5803-8e07-63d9408a9f9d" :answer/type :answer.type/text :answer/value "sometimes false" :db/ensure [:answer/validate]} {:db/id "answer-95fda5b2-41b7-5f84-a8c6-0bac46270c86" :answer/id #uuid "95fda5b2-41b7-5f84-a8c6-0bac46270c86" :answer/type :answer.type/text :answer/value "sometimes true" :db/ensure [:answer/validate]} {:db/id 17592186060144 :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "question-c2988660-d9f8-5b55-910c-35b17be03f50" :question/id #uuid "c2988660-d9f8-5b55-910c-35b17be03f50" :question/math-academy-id "q-182534" :question/problem "Find the missing values in the following truth table:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A⇔B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | {{field-1}} |\n| $\\text{T}$ | $\\text{F}$ | {{field-2}} |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | {{field-3}} |" :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nThe complete truth table is shown below:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A⇔B\\,$ |\n| --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-271ab454-6f2b-5afb-b9cf-18b8679379c8" "answer-field-83d2b9a1-bd1e-56ee-bbda-10c6ab74f182" "answer-field-1a364f31-5361-538d-8ff0-9aff626f051b"] :db/ensure [:question/validate]} {:db/id "answer-field-271ab454-6f2b-5afb-b9cf-18b8679379c8" :answer-field/id #uuid "271ab454-6f2b-5afb-b9cf-18b8679379c8" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0ed4e36c-d236-5be9-a3f3-a7f4ec88fb84" :answer-field/choices ["answer-7e62928e-765a-52ef-928f-0fd488454c77" "answer-0ed4e36c-d236-5be9-a3f3-a7f4ec88fb84"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e62928e-765a-52ef-928f-0fd488454c77" :answer/id #uuid "7e62928e-765a-52ef-928f-0fd488454c77" :answer/type :answer.type/math :answer/value "\\text{F}" :db/ensure [:answer/validate]} {:db/id "answer-0ed4e36c-d236-5be9-a3f3-a7f4ec88fb84" :answer/id #uuid "0ed4e36c-d236-5be9-a3f3-a7f4ec88fb84" :answer/type :answer.type/math :answer/value "\\text{T}" :db/ensure [:answer/validate]} {:db/id "answer-field-83d2b9a1-bd1e-56ee-bbda-10c6ab74f182" :answer-field/id #uuid "83d2b9a1-bd1e-56ee-bbda-10c6ab74f182" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-b16fc976-f779-569a-bb2c-8449f0e870e0" :answer-field/choices ["answer-b16fc976-f779-569a-bb2c-8449f0e870e0" "answer-fb466665-5b86-5cf9-b4ce-c155aa150cc0"] :db/ensure [:answer-field/validate]} {:db/id "answer-b16fc976-f779-569a-bb2c-8449f0e870e0" :answer/id #uu