nt "question-5021d5eb-c519-52ae-b30c-1049345fdc26" :step/next "step-27597e6e-46a5-5c0e-98fc-2488a4f8741d" :db/ensure [:step/validate]} {:db/id "step-27597e6e-46a5-5c0e-98fc-2488a4f8741d" :step/id #uuid "27597e6e-46a5-5c0e-98fc-2488a4f8741d" :step/content "question-edd7453d-0827-54b9-87f7-014fa66cf7ec" :db/ensure [:step/validate]} {:db/id 17592186119778 :knowledge-point/questions ["question-5dad7293-4ccc-5f12-9124-fcdf29a624d2" "question-9ebd673b-ab24-50e2-a8c2-fa7ddd43f728" "question-40a39262-0d1b-5421-8009-5952de54d116"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5dad7293-4ccc-5f12-9124-fcdf29a624d2" :question/id #uuid "5dad7293-4ccc-5f12-9124-fcdf29a624d2" :question/math-academy-id "q-42576" :question/problem "Given that $A=\\begin{bmatrix}4 & -6 & 5 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & -2 & 0 \\\\ 6 & 2 & 1\\end{bmatrix},$ find $det(A).$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nIn our case, this gives\n\n$$\n\\begin{aligned}det(A) & =det\\begin{bmatrix}4 & -6 & 5 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}\\cdot det\\begin{bmatrix}1 & 0 & 0 \\\\ -5 & -2 & 0 \\\\ 6 & 2 & 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that both matrices are triangular. Therefore, we obtain\n\n$$\n\\begin{aligned}det(A) & =(4\\cdot (-2)\\cdot 5)\\cdot (1\\cdot (-2)\\cdot 1) \\\\  & =(-40)\\cdot (-2) \\\\  & =80.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c090ec9d-391d-5fc2-a3e8-fc77e254c9bb"] :db/ensure [:question/validate]} {:db/id "answer-field-c090ec9d-391d-5fc2-a3e8-fc77e254c9bb" :answer-field/id #uuid "c090ec9d-391d-5fc2-a3e8-fc77e254c9bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d3bb88c-6bbf-566b-9af8-cdfbef08a6e6" :answer-field/choices ["answer-c0e6ddf2-83fa-5605-bf51-12c940470cba" "answer-6070775f-39d6-5679-aa83-fc2bb298d71e" "answer-43320e29-d3b8-528a-8fe9-99c0207ced61" "answer-4d3bb88c-6bbf-566b-9af8-cdfbef08a6e6" "answer-7616d5ee-76de-57d2-9373-45d8ff05d835"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0e6ddf2-83fa-5605-bf51-12c940470cba" :answer/id #uuid "c0e6ddf2-83fa-5605-bf51-12c940470cba" :answer/type :answer.type/math :answer/value "-114" :db/ensure [:answer/validate]} {:db/id "answer-6070775f-39d6-5679-aa83-fc2bb298d71e" :answer/id #uuid "6070775f-39d6-5679-aa83-fc2bb298d71e" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "answer-43320e29-d3b8-528a-8fe9-99c0207ced61" :answer/id #uuid "43320e29-d3b8-528a-8fe9-99c0207ced61" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "answer-4d3bb88c-6bbf-566b-9af8-cdfbef08a6e6" :answer/id #uuid "4d3bb88c-6bbf-566b-9af8-cdfbef08a6e6" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id "answer-7616d5ee-76de-57d2-9373-45d8ff05d835" :answer/id #uuid "7616d5ee-76de-57d2-9373-45d8ff05d835" :answer/type :answer.type/math :answer/value "98" :db/ensure [:answer/validate]} {:db/id "question-9ebd673b-ab24-50e2-a8c2-fa7ddd43f728" :question/id #uuid "9ebd673b-ab24-50e2-a8c2-fa7ddd43f728" :question/math-academy-id "q-130491" :question/problem "Given that $D=\\begin{bmatrix}-2 & 7 & 3 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & 6\\end{bmatrix}\\begin{bmatrix}3 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 8 & -7 & -1\\end{bmatrix},$ find $det(D).$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nIn our case, this gives\n\n$$\n\\begin{aligned}det(D) & =det\\begin{bmatrix}-2 & 7 & 3 \\\\ 0 & 1 & -4 \\\\ 0 & 0 & 6\\end{bmatrix}\\cdot det\\begin{bmatrix}3 & 0 & 0 \\\\ 5 & 1 & 0 \\\\ 8 & -7 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNotice that both matrices are triangular. Therefore, we obtain\n\n$$\n\\begin{aligned}det(D) & =((-2)\\cdot 1\\cdot 6)\\cdot (3\\cdot 1\\cdot -1) \\\\  & =(-12)\\cdot (-3) \\\\  & =36.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7192d7f2-ef6b-5f63-9173-1d9eab04f2ba"] :db/ensure [:question/validate]} {:db/id "answer-field-7192d7f2-ef6b-5f63-9173-1d9eab04f2ba" :answer-field/id #uuid "7192d7f2-ef6b-5f63-9173-1d9eab04f2ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3c15b8d-c591-5a9f-abf6-377fe85a7254" :answer-field/choices ["answer-64aeb222-7918-5204-aca3-b5f7c67d0aeb" "answer-fe0a93da-9016-5e38-9f8e-6fcc94e3a5b9" "answer-ba3522c1-f421-5648-aa43-188c5577d31c" "answer-a7af22e2-842e-5201-82af-fd7103681cd3" "answer-b3c15b8d-c591-5a9f-abf6-377fe85a7254"] :db/ensure [:answer-field/validate]} {:db/id "answer-64aeb222-7918-5204-aca3-b5f7c67d0aeb" :answer/id #uuid "64aeb222-7918-5204-aca3-b5f7c67d0aeb" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "answer-fe0a93da-9016-5e38-9f8e-6fcc94e3a5b9" :answer/id #uuid "fe0a93da-9016-5e38-9f8e-6fcc94e3a5b9" :answer/type :answer.type/math :answer/value "-34" :db/ensure [:answer/validate]} {:db/id "answer-ba3522c1-f421-5648-aa43-188c5577d31c" :answer/id #uuid "ba3522c1-f421-5648-aa43-188c5577d31c" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-a7af22e2-842e-5201-82af-fd7103681cd3" :answer/id #uuid "a7af22e2-842e-5201-82af-fd7103681cd3" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "answer-b3c15b8d-c591-5a9f-abf6-377fe85a7254" :answer/id #uuid "b3c15b8d-c591-5a9f-abf6-377fe85a7254" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-40a39262-0d1b-5421-8009-5952de54d116" :question/id #uuid "40a39262-0d1b-5421-8009-5952de54d116" :question/math-academy-id "q-88286" :question/problem "Given that $A=\\begin{bmatrix}1 & 0 & 2 \\\\ 1 & -1 & 2 \\\\ 1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}1 & 1 & 1 \\\\ -2 & 1 & 3 \\\\ 0 & 0 & 2\\end{bmatrix},$ find $det(A).$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nIn our case, this gives\n\n$$\ndet(A)=det\\begin{bmatrix}1 & 0 & 2 \\\\ 1 & -1 & 2 \\\\ 1 & 0 & 1\\end{bmatrix}\\cdot det\\begin{bmatrix}1 & 1 & 1 \\\\ -2 & 1 & 3 \\\\ 0 & 0 & 2\\end{bmatrix}.\n$$\n\nWe can compute the required determinants as follows:\n\n- For the first determinant, we can compute it using a Laplace expansion down the $2$nd column.\n\n- For the second determinant, we can compute it using a Laplace expansion across the $3$rd row.\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}1 & 0 & 2 \\\\ 1 & -1 & 2 \\\\ 1 & 0 & 1\\end{vmatrix}\\cdot \\begin{vmatrix}1 & 1 & 1 \\\\ -2 & 1 & 3 \\\\ 0 & 0 & 2\\end{vmatrix} \\\\  & =(-1)(-1)^{2+2}\\begin{vmatrix}1 & 2 \\\\ 1 & 1\\end{vmatrix}\\cdot 2(-1)^{3+3}\\begin{vmatrix}1 & 1 \\\\ -2 & 1\\end{vmatrix} \\\\  & =-(1-2)\\cdot 2(1+2) \\\\  & =1\\cdot 6 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-24bab1b2-9f01-5a84-84a1-c134dbb4356a"] :db/ensure [:question/validate]} {:db/id "answer-field-24bab1b2-9f01-5a84-84a1-c134dbb4356a" :answer-field/id #uuid "24bab1b2-9f01-5a84-84a1-c134dbb4356a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd5dd8ca-3bb1-5003-b8a7-af27e1771acf" :answer-field/choices ["answer-42489deb-4876-5c52-acde-7a5003dbd000" "answer-e71150f4-7a00-5e7a-a36e-a900ab926a19" "answer-d95a194b-3c11-588f-8353-b20c0750ef15" "answer-dd5dd8ca-3bb1-5003-b8a7-af27e1771acf" "answer-547ea20b-cbd8-5f06-a053-9482d610beaf"] :db/ensure [:answer-field/validate]} {:db/id "answer-42489deb-4876-5c52-acde-7a5003dbd000" :answer/id #uuid "42489deb-4876-5c52-acde-7a5003dbd000" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-e71150f4-7a00-5e7a-a36e-a900ab926a19" :answer/id #uuid "e71150f4-7a00-5e7a-a36e-a900ab926a19" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-d95a194b-3c11-588f-8353-b20c0750ef15" :answer/id #uuid "d95a194b-3c11-588f-8353-b20c0750ef15" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-dd5dd8ca-3bb1-5003-b8a7-af27e1771acf" :answer/id #uuid "dd5dd8ca-3bb1-5003-b8a7-af27e1771acf" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-547ea20b-cbd8-5f06-a053-9482d610beaf" :answer/id #uuid "547ea20b-cbd8-5f06-a053-9482d610beaf" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186119779 :knowledge-point/questions ["question-59d8b4d6-365d-545b-a80d-dc97dcfbcac8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-59d8b4d6-365d-545b-a80d-dc97dcfbcac8" :question/id #uuid "59d8b4d6-365d-545b-a80d-dc97dcfbcac8" :question/math-academy-id "q-42997" :question/problem "Let $A,$ $B,$ and $C$ be square matrices. If $A=B\\cdot C,$  $|B|=9$ and $|{C}^{-1}|=-3$, find $|A|.$" :question/worked-solution "Given two $n\\times n$ matrices $M$ and $N,$ we have\n\n$$\ndet(MN)=det(M)\\cdot det(N).\n$$\n\nAlso, given an invertible $n\\times n$ matrix $M,$ we have\n\n$$\ndet({M}^{-1})=\\frac{1}{det(M)}.\n$$\n\nSince $|C|=\\frac{1}{|{C}^{-1}|}$, we get $|C|=-\\frac{1}{3}.$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}|A| & =|B|\\cdot |C| \\\\  & =9\\cdot (-\\frac{1}{3}) \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7f31fc24-9a16-583f-8c7d-7e52bda34673"] :db/ensure [:question/validate]} {:db/id "answer-field-7f31fc24-9a16-583f-8c7d-7e52bda34673" :answer-field/id #uuid "7f31fc24-9a16-583f-8c7d-7e52bda34673" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2bd6575-c2b6-5ac7-a9ee-1355aa285156" :answer-field/choices ["answer-b2bd6575-c2b6-5ac7-a9ee-1355aa285156" "answer-59f38619-20b2-5322-be74-7ade54b5a4ae" "answer-921c084b-39dd-579f-a483-01d5fac78c2c" "answer-b98f6385-ee75-53c7-8fb6-adbddd6958be" "answer-69646748-f284-5f48-8b8c-5eab9d02207a"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2bd6575-c2b6-5ac7-a9ee-1355aa285156" :answer/id #uuid "b2bd6575-c2b6-5ac7-a9ee-1355aa285156" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-59f38619-20b2-5322-be74-7ade54b5a4ae" :answer/id #uuid "59f38619-20b2-5322-be74-7ade54b5a4ae" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-921c084b-39dd-579f-a483-01d5fac78c2c" :answer/id #uuid "921c084b-39dd-579f-a483-01d5fac78c2c" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-b98f6385-ee75-53c7-8fb6-adbddd6958be" :answer/id #uuid "b98f6385-ee75-53c7-8fb6-adbddd6958be" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-69646748-f284-5f48-8b8c-5eab9d02207a" :answer/id #uuid "69646748-f284-5f48-8b8c-5eab9d02207a" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id 17592186100854 :knowledge-point/questions ["question-f1d56472-7ebb-55ed-bd03-c4b2a70fb522" "question-8f6ad506-8ae9-5d30-a511-9a3173b92b8c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f1d56472-7ebb-55ed-bd03-c4b2a70fb522" :question/id #uuid "f1d56472-7ebb-55ed-bd03-c4b2a70fb522" :question/math-academy-id "q-316790" :question/problem "Find the position vector of $R(2,4)$ in terms of $i$ and $j.$\n\nThe position vector of $R$ is\n{{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j.$" :question/worked-solution "Our vector is shown in the diagram below.\n\n![](images/ec/ecc6f3682d17eb4878e43a24ada2d6989d73f34d44ce2e3adcf9e6dc201761d2.png)\n\nRemember that in general, if a point $R$ has coordinates $({r}_{x},{r}_{y}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OR}={r}_{x}i+{r}_{y}\\,j.\n$$\n\nHere, the point $R$ has coordinates $(2,4),$ so its position vector is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{OR} & =2\\,i+4\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f238910f-e8b0-53f4-b405-ed0629614fa4" "answer-field-f51c13dd-8656-5d5a-bd3b-d888aad6056e"] :db/ensure [:question/validate]} {:db/id "answer-field-f238910f-e8b0-53f4-b405-ed0629614fa4" :answer-field/id #uuid "f238910f-e8b0-53f4-b405-ed0629614fa4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2eb75c7d-58aa-5163-a4e4-40ddb2a2085f" :answer-field/choices ["answer-2eb75c7d-58aa-5163-a4e4-40ddb2a2085f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2eb75c7d-58aa-5163-a4e4-40ddb2a2085f" :answer/id #uuid "2eb75c7d-58aa-5163-a4e4-40ddb2a2085f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-f51c13dd-8656-5d5a-bd3b-d888aad6056e" :answer-field/id #uuid "f51c13dd-8656-5d5a-bd3b-d888aad6056e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-552b7b0f-082f-543f-9e21-d944b2bef379" :answer-field/choices ["answer-552b7b0f-082f-543f-9e21-d944b2bef379"] :db/ensure [:answer-field/validate]} {:db/id "answer-552b7b0f-082f-543f-9e21-d944b2bef379" :answer/id #uuid "552b7b0f-082f-543f-9e21-d944b2bef379" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-8f6ad506-8ae9-5d30-a511-9a3173b92b8c" :question/id #uuid "8f6ad506-8ae9-5d30-a511-9a3173b92b8c" :question/math-academy-id "q-275102" :question/problem "Find the position vector of $R(-4,5)$ in terms of $i$ and $j.$\n\nThe position vector of $R$ is\n{{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j.$" :question/worked-solution "Our vector is shown in the diagram below.\n\n![](images/e1/e132f8e20ffb38c70ef435a560a584b25a6509486cc148636d873a9e0e94ea52.png)\n\nRemember that in general, if a point $R$ has coordinates $({r}_{x},{r}_{y}),$ then its position vector is given by\n\n$$\n\\overset{\\to }{OR}={r}_{x}i+{r}_{y}\\,j.\n$$\n\nHere, the point $R$ has coordinates $(-4,5),$ so its position vector is given by\n\n$$\n\\begin{aligned}\\overset{\\to }{OR} & =(-4)\\cdot i+5\\cdot j \\\\  & =-4\\,i+5\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-17341d17-b542-5bd7-8870-0b8622258187" "answer-field-980f9f0e-eb5c-5ec7-abf3-93c02c0e570a"] :db/ensure [:question/validate]} {:db/id "answer-field-17341d17-b542-5bd7-8870-0b8622258187" :answer-field/id #uuid "17341d17-b542-5bd7-8870-0b8622258187" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3f838cae-7963-53d4-adb3-055a400661b0" :answer-field/choices ["answer-3f838cae-7963-53d4-adb3-055a400661b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-3f838cae-7963-53d4-adb3-055a400661b0" :answer/id #uuid "3f838cae-7963-53d4-adb3-055a400661b0" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-field-980f9f0e-eb5c-5ec7-abf3-93c02c0e570a" :answer-field/id #uuid "980f9f0e-eb5c-5ec7-abf3-93c02c0e570a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ef63d38a-802f-5985-9655-3a158ab709d5" :answer-field/choices ["answer-ef63d38a-802f-5985-9655-3a158ab709d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef63d38a-802f-5985-9655-3a158ab709d5" :answer/id #uuid "ef63d38a-802f-5985-9655-3a158ab709d5" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186100855 :knowledge-point/questions ["question-33670b3f-b9d2-5fe2-ab57-0eab9223a358" "question-adab0e55-06f3-58c6-9e94-4deec9447e84"] :db/ensure [:knowledge-point/validate]} {:db/id "question-33670b3f-b9d2-5fe2-ab57-0eab9223a358" :question/id #uuid "33670b3f-b9d2-5fe2-ab57-0eab9223a358" :question/math-academy-id "q-17993" :question/problem "![](images/a8/a86e5e973e15230943beaa3f8afdeed139690ba4e5cf3fed4c35895e5f4bd2d4.png)\n\nThe point $W$ is shown in the picture above. Find the coordinates of the corresponding position vector." :question/worked-solution "For a point with coordinates $({a}_{x},{a}_{y}),$ the position vector is $⟨{a}_{x},{a}_{y}⟩.$\n\nThe point $W$ has coordinates $(1.5,-2.5),$ so the position vector is\n\n$$\n\\overset{\\to }{OW}=⟨1.5,-2.5⟩.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e09e382f-322a-5a58-807a-349de626a047"] :db/ensure [:question/validate]} {:db/id "answer-field-e09e382f-322a-5a58-807a-349de626a047" :answer-field/id #uuid "e09e382f-322a-5a58-807a-349de626a047" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ccf55a3-a4eb-5a92-bc90-105041733e42" :answer-field/choices ["answer-a1e3cede-7915-55a0-9ff3-f726b6d6c5ca" "answer-1f8e4fb1-e97d-5d7e-9e20-606f4bacf723" "answer-a33fbd40-fc91-5b05-9f63-429460e594bf" "answer-6ccf55a3-a4eb-5a92-bc90-105041733e42" "answer-cece7db9-017d-561e-86f1-e814f9065dd4"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1e3cede-7915-55a0-9ff3-f726b6d6c5ca" :answer/id #uuid "a1e3cede-7915-55a0-9ff3-f726b6d6c5ca" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OW}=⟨-1,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-1f8e4fb1-e97d-5d7e-9e20-606f4bacf723" :answer/id #uuid "1f8e4fb1-e97d-5d7e-9e20-606f4bacf723" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OW}=⟨-2.5,1.5⟩" :db/ensure [:answer/validate]} {:db/id "answer-a33fbd40-fc91-5b05-9f63-429460e594bf" :answer/id #uuid "a33fbd40-fc91-5b05-9f63-429460e594bf" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OW}=⟨1,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-6ccf55a3-a4eb-5a92-bc90-105041733e42" :answer/id #uuid "6ccf55a3-a4eb-5a92-bc90-105041733e42" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OW}=⟨1.5,-2.5⟩" :db/ensure [:answer/validate]} {:db/id "answer-cece7db9-017d-561e-86f1-e814f9065dd4" :answer/id #uuid "cece7db9-017d-561e-86f1-e814f9065dd4" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OW}=⟨2.5,-1.5⟩" :db/ensure [:answer/validate]} {:db/id "question-adab0e55-06f3-58c6-9e94-4deec9447e84" :question/id #uuid "adab0e55-06f3-58c6-9e94-4deec9447e84" :question/math-academy-id "q-70514" :question/problem "![](images/64/64d06368521604c208208a9d72452282f1ee8e683257ed9cd0161e957e39173c.png)\n\nThe point $U$ is shown in the picture above. Find the coordinates of the corresponding position vector." :question/worked-solution "For a point with coordinates $({a}_{x},{a}_{y}),$ the position vector is $⟨{a}_{x},{a}_{y}⟩.$\n\nThe point $U$ has coordinates $(3,2.5),$ so the position vector is\n\n$$\n\\overset{\\to }{OU}=⟨3,2.5⟩.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d9d12eb5-b989-5e71-915d-c112ac4d08f0"] :db/ensure [:question/validate]} {:db/id "answer-field-d9d12eb5-b989-5e71-915d-c112ac4d08f0" :answer-field/id #uuid "d9d12eb5-b989-5e71-915d-c112ac4d08f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3a972473-034b-5cb5-b1d8-f2259eeea6c8" :answer-field/choices ["answer-26f374cf-1d35-55d4-8591-b25423346911" "answer-46660aed-b32f-53d3-bbab-ea705491f7b6" "answer-698a014e-add4-5f36-8c6a-bc365e637fcd" "answer-3a972473-034b-5cb5-b1d8-f2259eeea6c8" "answer-b9cca592-116e-5655-9b6f-742a081eb34b"] :db/ensure [:answer-field/validate]} {:db/id "answer-26f374cf-1d35-55d4-8591-b25423346911" :answer/id #uuid "26f374cf-1d35-55d4-8591-b25423346911" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OU}=⟨-3,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-46660aed-b32f-53d3-bbab-ea705491f7b6" :answer/id #uuid "46660aed-b32f-53d3-bbab-ea705491f7b6" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OU}=⟨2.5,3⟩" :db/ensure [:answer/validate]} {:db/id "answer-698a014e-add4-5f36-8c6a-bc365e637fcd" :answer/id #uuid "698a014e-add4-5f36-8c6a-bc365e637fcd" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OU}=⟨3,-2.5⟩" :db/ensure [:answer/validate]} {:db/id "answer-3a972473-034b-5cb5-b1d8-f2259eeea6c8" :answer/id #uuid "3a972473-034b-5cb5-b1d8-f2259eeea6c8" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OU}=⟨3,2.5⟩" :db/ensure [:answer/validate]} {:db/id "answer-b9cca592-116e-5655-9b6f-742a081eb34b" :answer/id #uuid "b9cca592-116e-5655-9b6f-742a081eb34b" :answer/type :answer.type/math :answer/value "\\overset{\\to }{OU}=⟨3,2⟩" :db/ensure [:answer/validate]} {:db/id 17592186100856 :knowledge-point/questions ["question-092e8310-501d-5972-983c-e6366efca630" "question-72c863fb-10f9-5099-ad8d-1290ffd2a6a9" "question-f0302994-59bc-5fe6-beeb-f786801b16b0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-092e8310-501d-5972-983c-e6366efca630" :question/id #uuid "092e8310-501d-5972-983c-e6366efca630" :question/math-academy-id "q-124990" :question/problem "![](images/cc/ccb8643e7dfde7aa26d290c5f6e49a2037f37594bc05c558c46dea6bd673d9ff.png)\n\nLet $A(1,1)$ and $B(3,2).$ Find $\\overset{\\to }{AB}$ in terms of $i$ and $j.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=i+j, \\\\  & \\overset{\\to }{OB}=b=3i+2j.\\end{aligned}\n$$\n\nNow, from $△OAB$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =b-a \\\\  & =(3i+2j)-(i+j) \\\\  & =2i+j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ed18c90b-b986-5dce-aa2a-f3fbde5655b2"] :db/ensure [:question/validate]} {:db/id "answer-field-ed18c90b-b986-5dce-aa2a-f3fbde5655b2" :answer-field/id #uuid "ed18c90b-b986-5dce-aa2a-f3fbde5655b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-119b7c67-105f-57b9-84ad-4013cc89578f" :answer-field/choices ["answer-aff6f09b-1196-5e20-a457-23bfa327b5e5" "answer-119b7c67-105f-57b9-84ad-4013cc89578f" "answer-63fba524-5aa2-55e9-886f-823f761a35cf" "answer-0918aa6f-d79a-59b7-b036-f09c09d416f6" "answer-3d93145f-15ca-53ac-a097-c6809b88a220"] :db/ensure [:answer-field/validate]} {:db/id "answer-aff6f09b-1196-5e20-a457-23bfa327b5e5" :answer/id #uuid "aff6f09b-1196-5e20-a457-23bfa327b5e5" :answer/type :answer.type/math :answer/value "-2i-j" :db/ensure [:answer/validate]} {:db/id "answer-119b7c67-105f-57b9-84ad-4013cc89578f" :answer/id #uuid "119b7c67-105f-57b9-84ad-4013cc89578f" :answer/type :answer.type/math :answer/value "2i+j" :db/ensure [:answer/validate]} {:db/id "answer-63fba524-5aa2-55e9-886f-823f761a35cf" :answer/id #uuid "63fba524-5aa2-55e9-886f-823f761a35cf" :answer/type :answer.type/math :answer/value "3i+4j" :db/ensure [:answer/validate]} {:db/id "answer-0918aa6f-d79a-59b7-b036-f09c09d416f6" :answer/id #uuid "0918aa6f-d79a-59b7-b036-f09c09d416f6" :answer/type :answer.type/math :answer/value "4i+3j" :db/ensure [:answer/validate]} {:db/id "answer-3d93145f-15ca-53ac-a097-c6809b88a220" :answer/id #uuid "3d93145f-15ca-53ac-a097-c6809b88a220" :answer/type :answer.type/math :answer/value "i+2j" :db/ensure [:answer/validate]} {:db/id "question-72c863fb-10f9-5099-ad8d-1290ffd2a6a9" :question/id #uuid "72c863fb-10f9-5099-ad8d-1290ffd2a6a9" :question/math-academy-id "q-18000" :question/problem "![](images/84/84d2c65b53d4095bc3501f9658f2ff597dd9b72fff6e5e2b5b7347834632dfac.png)\n\nLet $A(2,0)$ and $B(-3,-2).$ Find $\\overset{\\to }{AB}$ in terms of $i$ and $j.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=2i+0j, \\\\  & \\overset{\\to }{OB}=b=-3i-2j.\\end{aligned}\n$$\n\nNow, from $△OAB$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =b-a \\\\  & =(-3i-2j)-(2i+0j) \\\\  & =-5i-2j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8cc93057-1e5d-5bac-8670-57949bf9620b"] :db/ensure [:question/validate]} {:db/id "answer-field-8cc93057-1e5d-5bac-8670-57949bf9620b" :answer-field/id #uuid "8cc93057-1e5d-5bac-8670-57949bf9620b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6158f2a-fa36-56c6-9c28-fd2a7c586f5b" :answer-field/choices ["answer-7d07658d-e91e-5270-bab5-3abea0cac458" "answer-f6158f2a-fa36-56c6-9c28-fd2a7c586f5b" "answer-f05d338a-26b3-50a3-a01d-778bfd91e38b" "answer-5637e942-8fdc-5683-97b7-4c85a13c3f1b" "answer-cf15061c-1d9b-591f-9ac9-80c350b0c96e"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d07658d-e91e-5270-bab5-3abea0cac458" :answer/id #uuid "7d07658d-e91e-5270-bab5-3abea0cac458" :answer/type :answer.type/math :answer/value "-5i+2j" :db/ensure [:answer/validate]} {:db/id "answer-f6158f2a-fa36-56c6-9c28-fd2a7c586f5b" :answer/id #uuid "f6158f2a-fa36-56c6-9c28-fd2a7c586f5b" :answer/type :answer.type/math :answer/value "-5i-2j" :db/ensure [:answer/validate]} {:db/id "answer-f05d338a-26b3-50a3-a01d-778bfd91e38b" :answer/id #uuid "f05d338a-26b3-50a3-a01d-778bfd91e38b" :answer/type :answer.type/math :answer/value "-5i-3j" :db/ensure [:answer/validate]} {:db/id "answer-5637e942-8fdc-5683-97b7-4c85a13c3f1b" :answer/id #uuid "5637e942-8fdc-5683-97b7-4c85a13c3f1b" :answer/type :answer.type/math :answer/value "5i+2j" :db/ensure [:answer/validate]} {:db/id "answer-cf15061c-1d9b-591f-9ac9-80c350b0c96e" :answer/id #uuid "cf15061c-1d9b-591f-9ac9-80c350b0c96e" :answer/type :answer.type/math :answer/value "5i-2j" :db/ensure [:answer/validate]} {:db/id "question-f0302994-59bc-5fe6-beeb-f786801b16b0" :question/id #uuid "f0302994-59bc-5fe6-beeb-f786801b16b0" :question/math-academy-id "q-18003" :question/problem "![](images/94/944c91a9d428f3b84cd748d40da9178b494522a5b39777fe0b8e875f9733f537.png)\n\nLet $A(-1,2)$ and $B(-1,3).$ Find $\\overset{\\to }{AB}$ in terms of $i$ and $j.$" :question/worked-solution "We have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=-i+2j, \\\\  & \\overset{\\to }{OB}=b=-i+3j.\\end{aligned}\n$$\n\nNow, from $△OAB$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =b-a \\\\  & =(-i+3j)-(-i+2j) \\\\  & =0i+j \\\\  & =j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ed7ddc08-5f8d-5c40-bda9-117726299567"] :db/ensure [:question/validate]} {:db/id "answer-field-ed7ddc08-5f8d-5c40-bda9-117726299567" :answer-field/id #uuid "ed7ddc08-5f8d-5c40-bda9-117726299567" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-940aeb78-c446-5984-88ec-716288861a2c" :answer-field/choices ["answer-f2e6b0be-7712-5a3d-8735-6c39db9d2f2a" "answer-3e0ba453-1215-5b3d-a7f0-05c27ba16c19" "answer-d383c3fb-fbe1-569b-ac8c-3692a5c7d2e5" "answer-6409fd64-52ae-588b-83ba-95d3807aaa0a" "answer-940aeb78-c446-5984-88ec-716288861a2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f2e6b0be-7712-5a3d-8735-6c39db9d2f2a" :answer/id #uuid "f2e6b0be-7712-5a3d-8735-6c39db9d2f2a" :answer/type :answer.type/math :answer/value "2i+j" :db/ensure [:answer/validate]} {:db/id "answer-3e0ba453-1215-5b3d-a7f0-05c27ba16c19" :answer/id #uuid "3e0ba453-1215-5b3d-a7f0-05c27ba16c19" :answer/type :answer.type/math :answer/value "i" :db/ensure [:answer/validate]} {:db/id "answer-d383c3fb-fbe1-569b-ac8c-3692a5c7d2e5" :answer/id #uuid "d383c3fb-fbe1-569b-ac8c-3692a5c7d2e5" :answer/type :answer.type/math :answer/value "i+3j" :db/ensure [:answer/validate]} {:db/id "answer-6409fd64-52ae-588b-83ba-95d3807aaa0a" :answer/id #uuid "6409fd64-52ae-588b-83ba-95d3807aaa0a" :answer/type :answer.type/math :answer/value "i+j" :db/ensure [:answer/validate]} {:db/id "answer-940aeb78-c446-5984-88ec-716288861a2c" :answer/id #uuid "940aeb78-c446-5984-88ec-716288861a2c" :answer/type :answer.type/math :answer/value "j" :db/ensure [:answer/validate]} {:db/id 17592186101946 :tutorial/content "We can use Cartesian coordinates to define vectors in the plane. For example, consider the diagram shown below.\n\n![](images/b7/b7fad622207f396145e930cf74f7905104bf12fa394a9f2f4f5d7ce761cc8e36.png)\n\nThe point $A$ has coordinates $(2,3).$ We also have the point $O(0,0)$ that is called the **origin**. \n\nThe vector $\\overrightarrow{OA}=\\mathbf{a}$ is called the **position vector** of $A.$ A position vector always has its tail at the origin. \n\nNow let's define two special unit vectors $\\mathbf{i}$ and $\\mathbf{j},$ where $|\\, \\mathbf{i} \\,| = |\\, \\mathbf{j} \\,| = 1,$ as follows:\n\n- $\\mathbf{i}$ is a horizontal unit vector that points to the right along the positive direction of the $x$-axis, while\n\n- $\\mathbf{j}$ is a vertical unit vector that points upwards along the positive direction of the $y$-axis.\n\nThese vectors are shown in the picture below. \n\n![](images/cb/cb5694945b6f76f14a4e66b854f5daa56f3e607bd5b24c4f361ed844dbf8ff7e.png)\n\nWe have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OX}=2i, \\\\  & \\overset{\\to }{XA}=\\overset{\\to }{OY}=3j.\\end{aligned}\n$$\n\nNow, from $\\triangle OXA,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =\\overset{\\to }{OX}+\\overset{\\to }{XA} \\\\  & =2i+3j.\\end{aligned}\n$$\n\nSo, the point $A$ with coordinates $(2,3)$ has a position vector\n\n$$\n\\begin{aligned}\\overset{\\to }{OA} & =2i+3j.\\end{aligned}\n$$\n\nIn general, if a point $A$ has coordinates $(a_x,a_y),$ then its position vector is given by\n\n$$\n\\overrightarrow{OA} = \\mathbf{a} = a_x\\mathbf{i}+a_y\\mathbf{j}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186101947 :tutorial/content "The $\\mathbf{i,j}$ notation can sometimes be cumbersome. An alternative is to use **angle bracket** notation. For example, using angle bracket notation, the vector $2\\mathbf{i}+3\\mathbf{j}$ can be expressed as\n\n$$\n2\\mathbf{i}+3\\mathbf{j}=\\langle 2,3 \\rangle.\n$$\n\nNote that, using angle bracket notation, the special unit vectors can be expressed as\n\n$$\n\\begin{aligned}i &=1i+0j=⟨1,0⟩, \\\\ j &=0i+1j=⟨0,1⟩.\\end{aligned}\n$$\n\nWe can also use **column vector** notation, which is similar to angle bracket notation but expresses the vector as a column rather than a row. For example, using column vector notation, the vector $2\\mathbf{i}+3\\mathbf{j}$ can be expressed as\n\n![](images/24/2419e5c69bef2cc15f00106e4bf83a17ab2277ed5ea43e8b17f904ca6318873f.svg)\n\nUsing column vector notation, the special unit vectors can be expressed as ![](images/f5/f51854ec5bb92b38e5078cfe96046535f8e8efecf1304ea5cc4605dddec09573.svg) and ![](images/ff/ff6013f4f80815a7ca97b5ba8929c2d39b2a4e0165cbb5a8534d8ffafc4377e8.svg)\n\n**Note:** Sometimes, the round bracket notation $(\\ldots)$ is used to denote vectors. However, we will avoid using that notation here, because it also looks like the coordinates of a point. A point and its position vector are two separate objects!" :db/ensure [:tutorial/validate]} {:db/id 17592186101948 :tutorial/content "If $A$ and $B$ are points in the Cartesian plane with position vectors $\\mathbf{a}$ and $\\mathbf{b}$ respectively, then\n\n$$\n\\overrightarrow{AB} = \\mathbf{b}-\\mathbf{a}.\n$$\n\nTo understand why the equation above is true, remember that $\\overrightarrow{OA} = \\mathbf{a}$ and $\\overrightarrow{OB} = \\mathbf{b}.$ Then, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{AO}+\\overset{\\to }{OB} \\\\  & =-\\overset{\\to }{OA}+\\overset{\\to }{OB} \\\\  & =-a+b \\\\  & =b-a.\\end{aligned}\n$$\n\nFor example, given $A(5,13)$ and $B(-2,-35)$, we have\n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=5i+13j, \\\\  & \\overset{\\to }{OB}=b=-2i-35j.\\end{aligned}\n$$\n\nNow, using the formula, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(-2i-35j)-(5i+13j) \\\\  & =-7i-48j.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186101032 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186100920 :knowledge-point/questions ["question-e56f348b-304a-594f-855c-44aa9e7abb11" "question-0f8b5f6f-ca62-5fd3-b5bd-ae649230f08c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e56f348b-304a-594f-855c-44aa9e7abb11" :question/id #uuid "e56f348b-304a-594f-855c-44aa9e7abb11" :question/math-academy-id "q-16096" :question/problem "The values of functions $f(x)$ and $g(x)$ and their derivatives at $x=-4$ are given in the table below.\n\n| $x$ | $f(x)$ | $g(x)$ | ${f}^{′}(x)$ | ${g}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $-4$ | $-2$ | $-7$ | $1$ | $10$ |\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))$ at $x=-4.$" :question/worked-solution "Using the product rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))=f(x){g}^{′}(x)+g(x){f}^{′}(x).\n$$\n\nAt the point where $x=-4$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=-4} & =f(-4){g}^{′}(-4)+g(-4){f}^{′}(-4) \\\\  & =(-2)\\cdot 10+(-7)\\cdot 1 \\\\  & =-27.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-46a62989-ea6e-5fa9-8951-dcdfb50d24ae"] :db/ensure [:question/validate]} {:db/id "answer-field-46a62989-ea6e-5fa9-8951-dcdfb50d24ae" :answer-field/id #uuid "46a62989-ea6e-5fa9-8951-dcdfb50d24ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-82a4e697-d4bd-5169-a570-30a241986662" :answer-field/choices ["answer-8f52e008-4f26-5045-a87f-360235315a34" "answer-82a4e697-d4bd-5169-a570-30a241986662" "answer-de0cafdb-0154-5d5d-893a-c1482d672b16" "answer-e543b8bb-072a-5db3-8955-6993036a65f5" "answer-0b976180-84b8-58a3-a43a-9172cb5e18cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f52e008-4f26-5045-a87f-360235315a34" :answer/id #uuid "8f52e008-4f26-5045-a87f-360235315a34" :answer/type :answer.type/math :answer/value "-13" :db/ensure [:answer/validate]} {:db/id "answer-82a4e697-d4bd-5169-a570-30a241986662" :answer/id #uuid "82a4e697-d4bd-5169-a570-30a241986662" :answer/type :answer.type/math :answer/value "-27" :db/ensure [:answer/validate]} {:db/id "answer-de0cafdb-0154-5d5d-893a-c1482d672b16" :answer/id #uuid "de0cafdb-0154-5d5d-893a-c1482d672b16" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-e543b8bb-072a-5db3-8955-6993036a65f5" :answer/id #uuid "e543b8bb-072a-5db3-8955-6993036a65f5" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-0b976180-84b8-58a3-a43a-9172cb5e18cf" :answer/id #uuid "0b976180-84b8-58a3-a43a-9172cb5e18cf" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "question-0f8b5f6f-ca62-5fd3-b5bd-ae649230f08c" :question/id #uuid "0f8b5f6f-ca62-5fd3-b5bd-ae649230f08c" :question/math-academy-id "q-104443" :question/problem "For the functions $f(x)$ and $g(x),$ you're given the following data:\n\n$$\nf(0)=5,\\,{f}^{′}(0)=-2,\\,g(0)=10,\\,{g}^{′}(0)=4\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))$ at $x=0.$" :question/worked-solution "Using the product rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))=f(x){g}^{′}(x)+g(x){f}^{′}(x).\n$$\n\nAt the point where $x=0,$ this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(f(x)g(x))|}_{x=0} & =f(0){g}^{′}(0)+g(0){f}^{′}(0) \\\\  & =5\\cdot 4+10\\cdot (-2) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-51e1d4e6-54b3-55d6-bdbd-d6b17b3f1c60"] :db/ensure [:question/validate]} {:db/id "answer-field-51e1d4e6-54b3-55d6-bdbd-d6b17b3f1c60" :answer-field/id #uuid "51e1d4e6-54b3-55d6-bdbd-d6b17b3f1c60" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e778a5a5-8646-5547-a246-55b51b7bda90" :answer-field/choices ["answer-ced4a5a5-5518-548c-8149-4b9efe5bb842" "answer-156c59f0-8805-5320-96bd-a85c8169635d" "answer-e778a5a5-8646-5547-a246-55b51b7bda90" "answer-b5d0941b-925c-5642-a0ab-3f758fe54938" "answer-de589cad-fcd0-5952-b5df-b25f56c879b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-ced4a5a5-5518-548c-8149-4b9efe5bb842" :answer/id #uuid "ced4a5a5-5518-548c-8149-4b9efe5bb842" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-156c59f0-8805-5320-96bd-a85c8169635d" :answer/id #uuid "156c59f0-8805-5320-96bd-a85c8169635d" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "answer-e778a5a5-8646-5547-a246-55b51b7bda90" :answer/id #uuid "e778a5a5-8646-5547-a246-55b51b7bda90" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b5d0941b-925c-5642-a0ab-3f758fe54938" :answer/id #uuid "b5d0941b-925c-5642-a0ab-3f758fe54938" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-de589cad-fcd0-5952-b5df-b25f56c879b5" :answer/id #uuid "de589cad-fcd0-5952-b5df-b25f56c879b5" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id 17592186100827 :knowledge-point/questions ["question-65401c01-5232-5bed-88ce-91552174b310" "question-0b93f5e4-441e-52cb-bcd1-657f8b3f7ca5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-65401c01-5232-5bed-88ce-91552174b310" :question/id #uuid "65401c01-5232-5bed-88ce-91552174b310" :question/math-academy-id "q-104450" :question/problem "For the functions $f(x)$ and $g(x),$ you are given the following data:\n\n$$\nf(-4)=2e,\\,{f}^{′}(-4)=-e,\\,g(-4)=-3e,\\,{g}^{′}(-4)=e\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=-4.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=-4,$ this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=-4} & =\\frac{{f}^{′}(-4)g(-4)-f(-4){g}^{′}(-4)}{{g}^{2}(-4)} \\\\  & =\\frac{-e\\cdot (-3e)-2e\\cdot e}{9{e}^{2}} \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b80dda05-df9e-5706-9ab3-92f41f323fc8"] :db/ensure [:question/validate]} {:db/id "answer-field-b80dda05-df9e-5706-9ab3-92f41f323fc8" :answer-field/id #uuid "b80dda05-df9e-5706-9ab3-92f41f323fc8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8801afb1-04ef-5a19-83e4-2ad30cea2606" :answer-field/choices ["answer-3ff58db8-d3aa-5a86-9a2e-d31f49b75188" "answer-e2372e0b-2f40-5aea-92e5-d19c0b4ba47c" "answer-68492c09-b3b0-534b-b4ac-c01f2c0700c2" "answer-8801afb1-04ef-5a19-83e4-2ad30cea2606" "answer-81d458d2-90b1-5a94-9db8-718b9d6a3cb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ff58db8-d3aa-5a86-9a2e-d31f49b75188" :answer/id #uuid "3ff58db8-d3aa-5a86-9a2e-d31f49b75188" :answer/type :answer.type/math :answer/value "-5e" :db/ensure [:answer/validate]} {:db/id "answer-e2372e0b-2f40-5aea-92e5-d19c0b4ba47c" :answer/id #uuid "e2372e0b-2f40-5aea-92e5-d19c0b4ba47c" :answer/type :answer.type/math :answer/value "-\\frac{5e}{9}" :db/ensure [:answer/validate]} {:db/id "answer-68492c09-b3b0-534b-b4ac-c01f2c0700c2" :answer/id #uuid "68492c09-b3b0-534b-b4ac-c01f2c0700c2" :answer/type :answer.type/math :answer/value "5{e}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8801afb1-04ef-5a19-83e4-2ad30cea2606" :answer/id #uuid "8801afb1-04ef-5a19-83e4-2ad30cea2606" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "answer-81d458d2-90b1-5a94-9db8-718b9d6a3cb1" :answer/id #uuid "81d458d2-90b1-5a94-9db8-718b9d6a3cb1" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "question-0b93f5e4-441e-52cb-bcd1-657f8b3f7ca5" :question/id #uuid "0b93f5e4-441e-52cb-bcd1-657f8b3f7ca5" :question/math-academy-id "q-48724" :question/problem "For the functions $f(x)$ and $g(x),$ you are given the following data:\n\n$$\nf(-2)=1,\\,{f}^{′}(-2)=-3,\\,g(-2)=2,\\,{g}^{′}(-2)=6\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})$ at $x=-2.$" :question/worked-solution "Using the quotient rule, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})=\\frac{{f}^{′}(x)g(x)-f(x){g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAt the point where $x=-2$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(\\frac{f(x)}{g(x)})|}_{x=-2} & =\\frac{{f}^{′}(-2)g(-2)-f(-2){g}^{′}(-2)}{{g}^{2}(-2)} \\\\  & =\\frac{(-3)\\cdot 2-1\\cdot 6}{{2}^{2}} \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-11c76a28-9fde-5aa9-9195-610b2d3249af"] :db/ensure [:question/validate]} {:db/id "answer-field-11c76a28-9fde-5aa9-9195-610b2d3249af" :answer-field/id #uuid "11c76a28-9fde-5aa9-9195-610b2d3249af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-824adea5-acf8-5e06-8bab-443fe02ee9b6" :answer-field/choices ["answer-824adea5-acf8-5e06-8bab-443fe02ee9b6" "answer-c469cea9-c5ed-510d-9d4e-23fad7086af9" "answer-8c3f00e8-0aa4-5703-a339-a7d82486ce71" "answer-66bba579-8ea0-5e5c-bd2d-e8e863cdd735" "answer-bd51a5c9-fd39-575f-ac7e-0441c9c8a065"] :db/ensure [:answer-field/validate]} {:db/id "answer-824adea5-acf8-5e06-8bab-443fe02ee9b6" :answer/id #uuid "824adea5-acf8-5e06-8bab-443fe02ee9b6" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-c469cea9-c5ed-510d-9d4e-23fad7086af9" :answer/id #uuid "c469cea9-c5ed-510d-9d4e-23fad7086af9" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8c3f00e8-0aa4-5703-a339-a7d82486ce71" :answer/id #uuid "8c3f00e8-0aa4-5703-a339-a7d82486ce71" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-66bba579-8ea0-5e5c-bd2d-e8e863cdd735" :answer/id #uuid "66bba579-8ea0-5e5c-bd2d-e8e863cdd735" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-bd51a5c9-fd39-575f-ac7e-0441c9c8a065" :answer/id #uuid "bd51a5c9-fd39-575f-ac7e-0441c9c8a065" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id 17592186100919 :knowledge-point/questions ["question-26a28da3-48f6-5069-8f6b-b7cd82087ac3" "question-61cd2eda-8e2b-568d-83db-33ce3428cd1f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-26a28da3-48f6-5069-8f6b-b7cd82087ac3" :question/id #uuid "26a28da3-48f6-5069-8f6b-b7cd82087ac3" :question/math-academy-id "q-72999" :question/problem "For the functions $g(x)$ and $u(x),$ you're given the following data:\n\n$$\ng(-2)=-6,\\,{g}^{′}(-2)=3,\\,u(-2)=4,\\,{u}^{′}(-2)=-8\n$$\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(2g(x)+u(x))$ at $x=-2.$" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(2g(x)+u(x))=2{g}^{′}(x)+{u}^{′}(x).\n$$\n\nAt the point where $x=-2$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(2g(x)+u(x))|}_{x=-2} & =2{g}^{′}(-2)+{u}^{′}(-2) \\\\  & =2\\cdot 3+(-8) \\\\  & =6-8 \\\\  & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-79ae0370-2dd2-570e-83d6-5d0437db891c"] :db/ensure [:question/validate]} {:db/id "answer-field-79ae0370-2dd2-570e-83d6-5d0437db891c" :answer-field/id #uuid "79ae0370-2dd2-570e-83d6-5d0437db891c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d35a0e4c-6b8e-55dd-80ae-ee8bb4fd321a" :answer-field/choices ["answer-d35a0e4c-6b8e-55dd-80ae-ee8bb4fd321a" "answer-6d99022f-a106-59b1-ab19-2a49af098a8e" "answer-80d2e7ff-b678-5e91-8bb8-bd913d289e28" "answer-ddb7f59e-6f91-5b88-b360-42fd9db4647c" "answer-dd954a77-5150-5c82-acfe-3e055cf99c4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d35a0e4c-6b8e-55dd-80ae-ee8bb4fd321a" :answer/id #uuid "d35a0e4c-6b8e-55dd-80ae-ee8bb4fd321a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-6d99022f-a106-59b1-ab19-2a49af098a8e" :answer/id #uuid "6d99022f-a106-59b1-ab19-2a49af098a8e" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-80d2e7ff-b678-5e91-8bb8-bd913d289e28" :answer/id #uuid "80d2e7ff-b678-5e91-8bb8-bd913d289e28" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-ddb7f59e-6f91-5b88-b360-42fd9db4647c" :answer/id #uuid "ddb7f59e-6f91-5b88-b360-42fd9db4647c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-dd954a77-5150-5c82-acfe-3e055cf99c4a" :answer/id #uuid "dd954a77-5150-5c82-acfe-3e055cf99c4a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-61cd2eda-8e2b-568d-83db-33ce3428cd1f" :question/id #uuid "61cd2eda-8e2b-568d-83db-33ce3428cd1f" :question/math-academy-id "q-311278" :question/problem "The values of functions $q(x)$ and $r(x)$ and their derivatives at $x=2$ are given in the table below.\n\n| $x$ | $q(x)$ | $r(x)$ | ${q}^{′}(x)$ | ${r}^{′}(x)$ |\n| --- | --- | --- | --- | --- |\n| $2$ | $4$ | $-1$ | $-3$ | $2$ |\n\nCompute $\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))$ at $x=2.$\n\n${\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))|}_{x=2}=$\n{{field-1}}" :question/worked-solution "Using the sum and constant multiple rules, we get\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))=3{q}^{′}(x)+4{r}^{′}(x).\n$$\n\nAt the point where $x=2$, this gives\n\n$$\n\\begin{aligned}{\\frac{\\text{d}}{\\text{d}x}(3q(x)+4r(x))|}_{x=2} & =3{q}^{′}(2)+4{r}^{′}(2) \\\\  & =3(-3)+4(2) \\\\  & =-9+8 \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-41834297-4e3f-5346-8eb0-62cb1520f127"] :db/ensure [:question/validate]} {:db/id "answer-field-41834297-4e3f-5346-8eb0-62cb1520f127" :answer-field/id #uuid "41834297-4e3f-5346-8eb0-62cb1520f127" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5026daa1-5493-55d5-b06a-ec147d4e5720" :answer-field/choices ["answer-5026daa1-5493-55d5-b06a-ec147d4e5720"] :db/ensure [:answer-field/validate]} {:db/id "answer-5026daa1-5493-55d5-b06a-ec147d4e5720" :answer/id #uuid "5026daa1-5493-55d5-b06a-ec147d4e5720" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186124448 :knowledge-point/questions ["question-71adc372-d2f3-5857-a2ad-a0dc4396f12a" "question-fcbd8ac8-2f1b-5dcb-9ac1-2425c8503e58"] :db/ensure [:knowledge-point/validate]} {:db/id "question-71adc372-d2f3-5857-a2ad-a0dc4396f12a" :question/id #uuid "71adc372-d2f3-5857-a2ad-a0dc4396f12a" :question/math-academy-id "q-80650" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Find the values of $a$ and $b$, if \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =a{y}^{3}{e}^{x-1}+3{x}^{2}{e}^{y-1}, \\\\ {f}_{y}(x,y) & ={x}^{3}{e}^{y-1}+3b{y}^{2}{e}^{x-1}, \\\\ {f}_{x}(1,1) & =4.\\end{aligned}\n$$" :question/worked-solution "First, we find the mixed partial derivatives:\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(a{y}^{3}{e}^{x-1}+3{x}^{2}{e}^{y-1}) \\\\  & =3a{y}^{2}{e}^{x-1}+3{x}^{2}{e}^{y-1} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}({x}^{3}{e}^{y-1}+3b{y}^{2}{e}^{x-1}) \\\\  & =3{x}^{2}{e}^{y-1}+3b{y}^{2}{e}^{x-1}\\end{aligned}\n$$\n\nSince the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have the identity\n\n$$\n\\begin{aligned}3a{y}^{2}{e}^{x-1}+3{x}^{2}{e}^{y-1} &=3{x}^{2}{e}^{y-1}+3b{y}^{2}{e}^{x-1}.\\end{aligned}\n$$\n\nEquating the coefficients of ${y}^{2}{e}^{x-1},$ respectively, we see that $a=b.$ \n\nSince ${f}_{x}(1,1)=4$, we get\n\n$$\n\\begin{aligned}{f}_{x}(1,1) & =4 \\\\ a(1)^{3}{e}^{0}+3(1)^{2}{e}^{0} & =4 \\\\ a+3 & =4 \\\\ a & =1.\\end{aligned}\n$$\n\nFinally, \n\n$$\nb=a=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cb13aea9-bc77-5453-9aea-bf5b7e71380f"] :db/ensure [:question/validate]} {:db/id "answer-field-cb13aea9-bc77-5453-9aea-bf5b7e71380f" :answer-field/id #uuid "cb13aea9-bc77-5453-9aea-bf5b7e71380f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8182fdd-de15-5e8d-8c00-cb4f705d6762" :answer-field/choices ["answer-80550b66-58d5-55f0-ae8e-2834650b066f" "answer-20e20c39-cc2a-520d-bb87-4df46f753fcd" "answer-a8182fdd-de15-5e8d-8c00-cb4f705d6762" "answer-9c394b9f-6048-5783-92f0-54029edfc805" "answer-0501a6fa-7682-5329-8284-abddf6ca52ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-80550b66-58d5-55f0-ae8e-2834650b066f" :answer/id #uuid "80550b66-58d5-55f0-ae8e-2834650b066f" :answer/type :answer.type/text :answer/value "$a=-1$, $b=2$" :db/ensure [:answer/validate]} {:db/id "answer-20e20c39-cc2a-520d-bb87-4df46f753fcd" :answer/id #uuid "20e20c39-cc2a-520d-bb87-4df46f753fcd" :answer/type :answer.type/text :answer/value "$a=1$, $b=-1$" :db/ensure [:answer/validate]} {:db/id "answer-a8182fdd-de15-5e8d-8c00-cb4f705d6762" :answer/id #uuid "a8182fdd-de15-5e8d-8c00-cb4f705d6762" :answer/type :answer.type/text :answer/value "$a=1$, $b=1$" :db/ensure [:answer/validate]} {:db/id "answer-9c394b9f-6048-5783-92f0-54029edfc805" :answer/id #uuid "9c394b9f-6048-5783-92f0-54029edfc805" :answer/type :answer.type/text :answer/value "$a=1$, $b=3$" :db/ensure [:answer/validate]} {:db/id "answer-0501a6fa-7682-5329-8284-abddf6ca52ee" :answer/id #uuid "0501a6fa-7682-5329-8284-abddf6ca52ee" :answer/type :answer.type/text :answer/value "$a=3$, $b=1$" :db/ensure [:answer/validate]} {:db/id "question-fcbd8ac8-2f1b-5dcb-9ac1-2425c8503e58" :question/id #uuid "fcbd8ac8-2f1b-5dcb-9ac1-2425c8503e58" :question/math-academy-id "q-133220" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Find the values of $a$ and $b$, if \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =2ax{y}^{2}-4xy+15x, \\\\ {f}_{y}(x,y) & =b{x}^{2}y-2{x}^{2}-4y, \\\\ {f}_{y}(-1,-1) & =-5.\\end{aligned}\n$$" :question/worked-solution "First, we find the mixed partial derivatives:\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(2ax{y}^{2}-4xy+15x) \\\\  & =4axy-4x-0 \\\\  & =4axy-4x \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(b{x}^{2}y-2{x}^{2}-4y) \\\\  & =2bxy-4x-0 \\\\  & =2bxy-4x\\end{aligned}\n$$\n\nSince the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have the identity\n\n$$\n\\begin{aligned}4axy-4x &=2bxy-4x.\\end{aligned}\n$$\n\nEquating the coefficients of $xy$, we see that $a=\\frac{b}{2}.$ \n\nNow, since ${f}_{y}(-1,-1)=-5$, we get\n\n$$\n\\begin{aligned}{f}_{x}(-1,-1) & =-5 \\\\ b(-1)^{2}(-1)-2(-1)^{2}-4(-1) & =-5 \\\\ -b-2+4 & =-5 \\\\ b & =7.\\end{aligned}\n$$\n\nFinally, \n\n$$\na=\\frac{b}{2}=\\frac{7}{2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ff468151-5610-57e8-a342-0015e9de243b"] :db/ensure [:question/validate]} {:db/id "answer-field-ff468151-5610-57e8-a342-0015e9de243b" :answer-field/id #uuid "ff468151-5610-57e8-a342-0015e9de243b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5e777a8f-6c7e-5901-a8af-115b70fab553" :answer-field/choices ["answer-f72d59a7-8c21-5f28-9b5d-e6e72fd46085" "answer-dac71056-0aeb-532e-9751-c9f0ed2d8b24" "answer-8cf45e36-4acc-5483-a4e1-130ce1c20f6f" "answer-3896c76e-8662-59b2-9a9a-281680def5dc" "answer-5e777a8f-6c7e-5901-a8af-115b70fab553"] :db/ensure [:answer-field/validate]} {:db/id "answer-f72d59a7-8c21-5f28-9b5d-e6e72fd46085" :answer/id #uuid "f72d59a7-8c21-5f28-9b5d-e6e72fd46085" :answer/type :answer.type/math :answer/value "a=10,\\,b=3" :db/ensure [:answer/validate]} {:db/id "answer-dac71056-0aeb-532e-9751-c9f0ed2d8b24" :answer/id #uuid "dac71056-0aeb-532e-9751-c9f0ed2d8b24" :answer/type :answer.type/math :answer/value "a=10,\\,b=6" :db/ensure [:answer/validate]} {:db/id "answer-8cf45e36-4acc-5483-a4e1-130ce1c20f6f" :answer/id #uuid "8cf45e36-4acc-5483-a4e1-130ce1c20f6f" :answer/type :answer.type/math :answer/value "a=14,\\,b=\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3896c76e-8662-59b2-9a9a-281680def5dc" :answer/id #uuid "3896c76e-8662-59b2-9a9a-281680def5dc" :answer/type :answer.type/math :answer/value "a=\\frac{5}{2},\\,b=3" :db/ensure [:answer/validate]} {:db/id "answer-5e777a8f-6c7e-5901-a8af-115b70fab553" :answer/id #uuid "5e777a8f-6c7e-5901-a8af-115b70fab553" :answer/type :answer.type/math :answer/value "a=\\frac{7}{2},\\,b=7" :db/ensure [:answer/validate]} {:db/id 17592186124449 :knowledge-point/questions ["question-0032ce9b-c24d-5a4a-8814-0479ffd35234"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0032ce9b-c24d-5a4a-8814-0479ffd35234" :question/id #uuid "0032ce9b-c24d-5a4a-8814-0479ffd35234" :question/math-academy-id "q-80840" :question/problem "Suppose that a function $f(x,y,z)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ and that\n\n$$\n{f}_{zx}(x,y,z)=-\\frac{2yz}{{x}^{2}+{y}^{2}},\\,{f}_{yz}(x,y,z)=\\frac{2xz}{{x}^{2}+{y}^{2}}.\n$$\n\n \n\nEvaluate the following expression at the point $(1,2,1):$\n\n$$\n{f}_{zyy}(x,y,z)+{f}_{xxz}(x,y,z)\n$$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. \n\nHence, we have\n\n$$\n\\begin{aligned}{f}_{zyy}(x,y,z) & ={f}_{yzy}(x,y,z) \\\\  & =\\frac{∂}{∂y}({f}_{yz}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(\\frac{2xz}{{x}^{2}+{y}^{2}}) \\\\  & =-\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}.\\end{aligned}\n$$\n\nIn addition, we have\n\n$$\n\\begin{aligned}{f}_{xxz}(x,y,z) & ={f}_{zxx}(x,y,z) \\\\  & =\\frac{∂}{∂x}({f}_{zx}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(-\\frac{2yz}{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}.\\end{aligned}\n$$\n\nFrom the above, we get\n\n$$\n{f}_{zyy}(x,y,z)+{f}_{xxz}(x,y,z)=-\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}+\\frac{4xyz}{({x}^{2}+{y}^{2})^{2}}=0.\n$$\n\nFinally, \n\n$$\n{f}_{zyy}(1,2,1)+{f}_{xxz}(1,2,1)=0.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94c40397-9482-5a52-b940-12d808c2acb6"] :db/ensure [:question/validate]} {:db/id "answer-field-94c40397-9482-5a52-b940-12d808c2acb6" :answer-field/id #uuid "94c40397-9482-5a52-b940-12d808c2acb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d1327b1-2cbe-5b08-811b-7be6d5b707b3" :answer-field/choices ["answer-edcc4ee6-05fd-5ebf-b244-ad7bff1272ea" "answer-c1265443-5be8-5777-968a-4182b947a1fa" "answer-1d1327b1-2cbe-5b08-811b-7be6d5b707b3" "answer-94e41152-84ae-580a-bd00-9b191abad725" "answer-5222b098-a197-50ea-8318-c0f68f812c9a"] :db/ensure [:answer-field/validate]} {:db/id "answer-edcc4ee6-05fd-5ebf-b244-ad7bff1272ea" :answer/id #uuid "edcc4ee6-05fd-5ebf-b244-ad7bff1272ea" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-c1265443-5be8-5777-968a-4182b947a1fa" :answer/id #uuid "c1265443-5be8-5777-968a-4182b947a1fa" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-1d1327b1-2cbe-5b08-811b-7be6d5b707b3" :answer/id #uuid "1d1327b1-2cbe-5b08-811b-7be6d5b707b3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-94e41152-84ae-580a-bd00-9b191abad725" :answer/id #uuid "94e41152-84ae-580a-bd00-9b191abad725" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5222b098-a197-50ea-8318-c0f68f812c9a" :answer/id #uuid "5222b098-a197-50ea-8318-c0f68f812c9a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186064310 :knowledge-point/questions ["question-8db2f83d-f6c6-583a-9190-f65543a5bd2c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8db2f83d-f6c6-583a-9190-f65543a5bd2c" :question/id #uuid "8db2f83d-f6c6-583a-9190-f65543a5bd2c" :question/math-academy-id "q-138836" :question/problem "Consider the function $y=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{2}}g(x)}{({x}^{2}-2x-8)^{3}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{2}})-\\operatorname{ln}⁡{({x}^{2}-2x-8)}^{2} \\\\ \\operatorname{ln}⁡y & ={x}^{2}-2\\operatorname{ln}⁡({x}^{2}-2x-8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-2\\operatorname{ln}⁡({x}^{2}-2x-8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =2x-2\\cdot \\frac{1}{{x}^{2}-2x-8}\\cdot (2x-2) \\\\ \\frac{{y}^{′}}{y} & =2x-\\frac{4x-4}{{x}^{2}-2x-8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(2x-\\frac{4x-4}{{x}^{2}-2x-8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}(2x-\\frac{4x-4}{{x}^{2}-2x-8}) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{2}}(\\frac{2x({x}^{2}-2x-8)-(4x-4)}{{x}^{2}-2x-8}) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{3}}(2x({x}^{2}-2x-8)-(4x-4)) \\\\  & =\\frac{{e}^{{x}^{2}}}{({x}^{2}-2x-8)^{3}}(2{x}^{3}-4{x}^{2}-16x-4x+4) \\\\  & =\\frac{2{e}^{{x}^{2}}({x}^{3}-2{x}^{2}-10x+2)}{({x}^{2}-2x-8)^{3}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)={x}^{3}-2{x}^{2}-10x+2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0e4c95de-4b57-5003-8261-a6e1c6a6bcc0"] :db/ensure [:question/validate]} {:db/id "answer-field-0e4c95de-4b57-5003-8261-a6e1c6a6bcc0" :answer-field/id #uuid "0e4c95de-4b57-5003-8261-a6e1c6a6bcc0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer-field/choices ["answer-7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" "answer-152b66f7-c7ce-598f-93d8-1e22b704f747" "answer-c9ae8832-8946-513b-bceb-30925dd4f2ef" "answer-7cee9ed5-127b-5419-a740-825cde47b428" "answer-61dcae46-646f-5be7-9da2-a6de1d9ed25e"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer/id #uuid "7c7e4c5a-868b-5f38-b6a3-f41a6a7c3f5e" :answer/type :answer.type/math :answer/value "{x}^{3}-2{x}^{2}-10x+2" :db/ensure [:answer/validate]} {:db/id "answer-152b66f7-c7ce-598f-93d8-1e22b704f747" :answer/id #uuid "152b66f7-c7ce-598f-93d8-1e22b704f747" :answer/type :answer.type/math :answer/value "{x}^{3}-3{x}^{2}-20x+4" :db/ensure [:answer/validate]} {:db/id "answer-c9ae8832-8946-513b-bceb-30925dd4f2ef" :answer/id #uuid "c9ae8832-8946-513b-bceb-30925dd4f2ef" :answer/type :answer.type/math :answer/value "{x}^{3}-3{x}^{2}-20x-4" :db/ensure [:answer/validate]} {:db/id "answer-7cee9ed5-127b-5419-a740-825cde47b428" :answer/id #uuid "7cee9ed5-127b-5419-a740-825cde47b428" :answer/type :answer.type/math :answer/value "{x}^{3}-4{x}^{2}-10x+4" :db/ensure [:answer/validate]} {:db/id "answer-61dcae46-646f-5be7-9da2-a6de1d9ed25e" :answer/id #uuid "61dcae46-646f-5be7-9da2-a6de1d9ed25e" :answer/type :answer.type/math :answer/value "{x}^{3}-4{x}^{2}-10x-2" :db/ensure [:answer/validate]} {:db/id 17592186176018 :knowledge-point/questions ["question-0ac40a4c-aba2-5c77-8ace-67895a16cfed"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0ac40a4c-aba2-5c77-8ace-67895a16cfed" :question/id #uuid "0ac40a4c-aba2-5c77-8ace-67895a16cfed" :question/math-academy-id "q-338264" :question/problem "Evaluate the following limit:\n\n${lim}_{n\\to 0}{(1+n)}^{4/7n}=$\n{{field-1}}" :question/worked-solution "Notice that as $n\\to 0,$ \n\n- the expression inside the parentheses approaches $1,$ while\n\n- the exponent approaches $\\infty .$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{n\\to 0}{(1+n)}^{4/7n}={1}^{\\infty },\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{n\\to 0}{(1+n)}^{1/n}=e\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{n\\to 0}{(1+n)}^{4/7n} & ={lim}_{n\\to 0}{[{(1+n)}^{1/n}]}^{4/7} \\\\  & ={[{lim}_{n\\to 0}{(1+n)}^{1/n}]}^{4/7} \\\\  & ={e}^{4/7} \\\\  & =\\sqrt[7]{{e}^{4}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7e129902-6deb-5f56-af1c-12c6f695aaf0"] :db/ensure [:question/validate]} {:db/id "answer-field-7e129902-6deb-5f56-af1c-12c6f695aaf0" :answer-field/id #uuid "7e129902-6deb-5f56-af1c-12c6f695aaf0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cb4fd080-504f-597c-84bf-48ecf4885982" :answer-field/choices ["answer-cb4fd080-504f-597c-84bf-48ecf4885982"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb4fd080-504f-597c-84bf-48ecf4885982" :answer/id #uuid "cb4fd080-504f-597c-84bf-48ecf4885982" :answer/type :answer.type/math :answer/value "e^{\\frac{4}{7}}" :db/ensure [:answer/validate]} {:db/id 17592186096836 :knowledge-point/questions ["question-8f2aebee-176b-5447-94e6-cdb44a5559c2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8f2aebee-176b-5447-94e6-cdb44a5559c2" :question/id #uuid "8f2aebee-176b-5447-94e6-cdb44a5559c2" :question/math-academy-id "q-351023" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x={\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{3})\\, & ⟹\\,{u}^{′}=\\frac{3}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡({x}^{3})\\,\\text{d}x & ={\\int }_{1}^{{e}^{2}}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{3})\\,(x){|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}x(\\frac{3}{x})\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡(({e}^{2})^{3})\\,({e}^{2})-\\operatorname{ln}⁡({1}^{3})\\,(1)]-3{\\int }_{1}^{{e}^{2}}\\text{d}x \\\\  & ={e}^{2}\\operatorname{ln}⁡({e}^{6})-3x{|}_{1}^{{e}^{2}} \\\\  & =6{e}^{2}-3({e}^{2}-1) \\\\  & =3({e}^{2}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8946e118-e7e3-5ee7-9e3c-9199dfb40a0e"] :db/ensure [:question/validate]} {:db/id "answer-field-8946e118-e7e3-5ee7-9e3c-9199dfb40a0e" :answer-field/id #uuid "8946e118-e7e3-5ee7-9e3c-9199dfb40a0e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer-field/choices ["answer-4245b790-1a22-59f1-b2b1-ec25d43743c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer/id #uuid "4245b790-1a22-59f1-b2b1-ec25d43743c0" :answer/type :answer.type/math :answer/value "3({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id 17592186078407 :knowledge-point/questions ["question-0c781737-7cc2-58de-b406-ca857cb292ed"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0c781737-7cc2-58de-b406-ca857cb292ed" :question/id #uuid "0c781737-7cc2-58de-b406-ca857cb292ed" :question/math-academy-id "q-339011" :question/problem "Find the value of $a$ given that\n\n$$\n{lim}_{h\\to 0}\\frac{(\\frac{1}{a+h}-\\frac{1}{a})}{h}=-\\frac{1}{4}\\,.\n$$\n\n$a=$\n{{field-1}}" :question/worked-solution "First, we let \n\n$$\nL=\\frac{(\\frac{1}{a+h}-\\frac{1}{a})}{h}=-\\frac{1}{4}.\n$$\n\nComparing this with the formula for the instantaneous rate of change,\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{f(a+h)-f(a)}{h},\n$$\n\nwe see that if we let $f(x)=\\frac{1}{x}$, we get\n\n$$\n{f}^{′}(a)={lim}_{h\\to 0}\\frac{(\\frac{1}{a+h}-\\frac{1}{a})}{h}=L.\n$$\n\nThis confirms that $L={f}^{′}(a).$\n\nComputing the derivative, we have\n\n$$\n{f}^{′}(x)=-\\frac{1}{{x}^{2}},\\,{f}^{′}(a)=-\\frac{1}{{a}^{2}},\n$$\n\nand so,  $L=-\\frac{1}{{a}^{2}}.$\n\nFinally, since $L=-\\frac{1}{4},$ we must have\n\n$$\n\\begin{aligned}-\\frac{1}{{a}^{2}} & =-\\frac{1}{4} \\\\ {a}^{2} & =4 \\\\ a & =\\pm 2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-566ccb36-6055-535a-bafd-ee2a268c69a1"] :db/ensure [:question/validate]} {:db/id "answer-field-566ccb36-6055-535a-bafd-ee2a268c69a1" :answer-field/id #uuid "566ccb36-6055-535a-bafd-ee2a268c69a1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field