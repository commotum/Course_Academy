ep/validate]} {:db/id "step-964e993d-11f9-583e-a087-b27639c1cb55" :step/id #uuid "964e993d-11f9-583e-a087-b27639c1cb55" :step/content "question-0ad91671-88c2-5e5d-8e1f-e5e0e6fbe489" :step/next "step-e7d30afe-5727-5f33-9bdf-09c7bc31d07b" :db/ensure [:step/validate]} {:db/id "step-e7d30afe-5727-5f33-9bdf-09c7bc31d07b" :step/id #uuid "e7d30afe-5727-5f33-9bdf-09c7bc31d07b" :step/content "question-990e6c9c-e46f-5a33-8086-74712d90c327" :step/next "step-ee45541b-f89f-5b43-9e6c-25e482e11d0b" :db/ensure [:step/validate]} {:db/id "step-ee45541b-f89f-5b43-9e6c-25e482e11d0b" :step/id #uuid "ee45541b-f89f-5b43-9e6c-25e482e11d0b" :step/content "question-e49b201b-78f0-5668-9145-a0f21b5a41c8" :db/ensure [:step/validate]} {:db/id 17592186221436 :knowledge-point/questions ["question-f860a2b3-6e2b-5a0c-99c8-165c277a9c9f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f860a2b3-6e2b-5a0c-99c8-165c277a9c9f" :question/id #uuid "f860a2b3-6e2b-5a0c-99c8-165c277a9c9f" :question/math-academy-id "q-331796" :question/problem "Consider a function $z(t)$ such that its Laplace transform is $L\\{z(t)\\}=Z(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L\\{{e}^{6t}z(t)\\}.$ Select the correct options in the reasoning below.\n\nBy definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L\\{{e}^{6t}z(t)\\} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,z(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L\\{{e}^{6t}z(t)\\} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{6t}\\,z(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-6)t}\\,z(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $Z(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,z(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-6)t}\\,z(t)\\,\\text{d}t=Z(s-6),\n$$\n\nwhere \n\n$$\ns-6>{s}_{0}\\,⇒\\,s>{s}_{0}+6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bc804dd5-b0b8-5b58-8021-28c39a3f98b4" "answer-field-f3d9a905-bd06-5c37-a014-3005c06bd023" "answer-field-770c50eb-5a8e-5dd6-b4d0-c44915b24177" "answer-field-7cabfa43-7e7e-5ad6-b175-6e755f0483d0"] :db/ensure [:question/validate]} {:db/id "answer-field-bc804dd5-b0b8-5b58-8021-28c39a3f98b4" :answer-field/id #uuid "bc804dd5-b0b8-5b58-8021-28c39a3f98b4" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-78b68503-620a-59d5-8b4a-e270fa19bb63" :answer-field/choices ["answer-79d89239-871c-53d9-b167-7f8a2a718bfa" "answer-78b68503-620a-59d5-8b4a-e270fa19bb63" "answer-e90a0e75-dfb5-5544-b3e4-020a8d970863" "answer-e58f7b88-ed0f-553e-b3e6-1b4fe0690a6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-79d89239-871c-53d9-b167-7f8a2a718bfa" :answer/id #uuid "79d89239-871c-53d9-b167-7f8a2a718bfa" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{-6t}z(t)" :db/ensure [:answer/validate]} {:db/id "answer-78b68503-620a-59d5-8b4a-e270fa19bb63" :answer/id #uuid "78b68503-620a-59d5-8b4a-e270fa19bb63" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{6t}z(t)" :db/ensure [:answer/validate]} {:db/id "answer-e90a0e75-dfb5-5544-b3e4-020a8d970863" :answer/id #uuid "e90a0e75-dfb5-5544-b3e4-020a8d970863" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{-6t}z(t)" :db/ensure [:answer/validate]} {:db/id "answer-e58f7b88-ed0f-553e-b3e6-1b4fe0690a6c" :answer/id #uuid "e58f7b88-ed0f-553e-b3e6-1b4fe0690a6c" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{6t}z(t)" :db/ensure [:answer/validate]} {:db/id "answer-field-f3d9a905-bd06-5c37-a014-3005c06bd023" :answer-field/id #uuid "f3d9a905-bd06-5c37-a014-3005c06bd023" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ba6ed572-5aee-5083-98bb-35283f750e3f" :answer-field