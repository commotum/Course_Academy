98-8ba0-131255435cee" :answer/id #uuid "ed3ddf6d-188a-5498-8ba0-131255435cee" :answer/type :answer.type/math :answer/value "4\\sin\\theta" :db/ensure [:answer/validate]} {:db/id "question-a981750b-2a73-53da-b2bb-9bf98660a4c5" :question/id #uuid "a981750b-2a73-53da-b2bb-9bf98660a4c5" :question/math-academy-id "q-105916" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $\\frac{1}{3}$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=\\frac{1}{3}.$ Therefore, the parametric equations of the circle are \n\n$$\nx=\\frac{1}{3}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{3}\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-924189b9-9f44-5d21-8b15-c9796978fa53"] :db/ensure [:question/validate]} {:db/id "answer-field-924189b9-9f44-5d21-8b15-c9796978fa53" :answer-field/id #uuid "924189b9-9f44-5d21-8b15-c9796978fa53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8eaafbe0-875e-51ef-a1b4-485b9238f00b" :answer-field/choices ["answer-c7398156-6414-5e0c-8178-901e251296eb" "answer-402b8663-1325-5fdc-ad76-153b5322133a" "answer-8eaafbe0-875e-51ef-a1b4-485b9238f00b" "answer-74e1ee09-5455-5273-8afb-c701e10655e1" "answer-70792def-4e31-5e75-8f22-cd899704d1dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7398156-6414-5e0c-8178-901e251296eb" :answer/id #uuid "c7398156-6414-5e0c-8178-901e251296eb" :answer/type :answer.type/math :answer/value "x=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-402b8663-1325-5fdc-ad76-153b5322133a" :answer/id #uuid "402b8663-1325-5fdc-ad76-1