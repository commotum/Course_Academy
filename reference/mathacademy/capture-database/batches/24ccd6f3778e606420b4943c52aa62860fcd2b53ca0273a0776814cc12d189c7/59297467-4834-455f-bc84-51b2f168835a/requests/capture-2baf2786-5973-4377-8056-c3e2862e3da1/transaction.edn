[{:db/id 17592186221403 :knowledge-point/questions ["question-c354aefb-fffc-5ecc-8cac-e2625bd63b47"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c354aefb-fffc-5ecc-8cac-e2625bd63b47" :question/id #uuid "c354aefb-fffc-5ecc-8cac-e2625bd63b47" :question/math-academy-id "q-334744" :question/problem "Which of the following global truncation error expressions represent a fourth-order numerical method?\n\nI. $e(Δx)=4(Δx)^{4}+2(Δx)^{7}$\n\nII. $e(Δx)=11(Δx)^{4}+0.5(Δx)^{5}$\n\nIII. $e(Δx)=0.2Δx+6(Δx)^{4}$" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nWith that in mind, let's check each option in turn:\n\n- For $e(Δx)=4(Δx)^{4}+2(Δx)^{7},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{4}.$\nSo, statement I corresponds to an order $4$ method.\n\n- For $e(Δx)=11(Δx)^{4}+0.5(Δx)^{5},$ the dominant term as $Δx\\to 0$ is $11(Δx)^{4}.$\nSo, statement II corresponds to an order $4$ method.\n\n- For $e(Δx)=0.2Δx+6(Δx)^{4},$ the dominant term as $Δx\\to 0$ is $0.2Δx.$\nSo, statement III corresponds to an order $1$ method.\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-986ff1d6-a817-5ff7-8aed-97a0eafbf95e"] :db/ensure [:question/validate]} {:db/id "answer-field-986ff1d6-a817-5ff7-8aed-97a0eafbf95e" :answer-field/id #uuid "986ff1d6-a817-5ff7-8aed-97a0eafbf95e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-41acf3ec-3f1c-53ba-b201-c8a37ecb1876" :answer-field/choices ["answer-41acf3ec-3f1c-53ba-b201-c8a37ecb1876" "answer-a9dc44c0-ba2d-5163-911a-1574cea8f06f" "answer-b7a3190f-7df3-50ea-a76a-7f1032b8c225" "answer-6f38908e-4bd6-5384-9925-30477dcb4253" "answer-44ca1322-93dc-59cc-b6ff-a1b25b2d993e"] :db/ensure [:answer-field/validate]} {:db/id "answer-41acf3ec-3f1c-53ba-b201-c8a37ecb1876" :answer/id #uuid "41acf3ec-3f1c-53ba-b201-c8a37ecb1876" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-a9dc44c0-ba2d-5163-911a-1574cea8f06f" :answer/id #uuid "a9dc44c0-ba2d-5163-911a-1574cea8f06f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-b7a3190f-7df3-50ea-a76a-7f1032b8c225" :answer/id #uuid "b7a3190f-7df3-50ea-a76a-7f1032b8c225" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-6f38908e-4bd6-5384-9925-30477dcb4253" :answer/id #uuid "6f38908e-4bd6-5384-9925-30477dcb4253" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-44ca1322-93dc-59cc-b6ff-a1b25b2d993e" :answer/id #uuid "44ca1322-93dc-59cc-b6ff-a1b25b2d993e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "activity-9cb47b16-2af6-58f1-8c90-123557ce104c" :activity/id #uuid "9cb47b16-2af6-58f1-8c90-123557ce104c" :activity/title "Order of Numerical Methods" :activity/type :activity.type/review :activity/scope 17592186051034 :activity/course 17592186046660 :activity/steps ["step-c4ecef28-9728-5f9f-986f-392086d6b9d1" "step-27637d35-ea70-516e-ae4d-2f2b9a81ce00" "step-77786643-b29c-5c9c-ac94-7ecbfe592858" "step-77da484d-f99e-564b-b4c3-19d24cde8a96" "step-003358a9-f2af-59ba-b62d-17d3096b53b8"] :activity/first-step "step-c4ecef28-9728-5f9f-986f-392086d6b9d1" :db/ensure [:activity/validate]} {:db/id "step-c4ecef28-9728-5f9f-986f-392086d6b9d1" :step/id #uuid "c4ecef28-9728-5f9f-986f-392086d6b9d1" :step/content 17592186221986 :step/next "step-27637d35-ea70-516e-ae4d-2f2b9a81ce00" :db/ensure [:step/validate]} {:db/id "step-27637d35-ea70-516e-ae4d-2f2b9a81ce00" :step/id #uuid "27637d35-ea70-516e-ae4d-2f2b9a81ce00" :step/content 17592186308665 :step/next "step-77786643-b29c-5c9c-ac94-7ecbfe592858" :db/ensure [:step/validate]} {:db/id "step-77786643-b29c-5c9c-ac94-7ecbfe592858" :step/id #uuid "77786643-b29c-5c9c-ac94-7ecbfe592858" :step/content "question-c354aefb-fffc-5ecc-8cac-e2625bd63b47" :step/next "step-77da484d-f99e-564b-b4c3-19d24cde8a96" :db/ensure [:step/validate]} {:db/id "step-77da484d-f99e-564b-b4c3-19d24cde8a96" :step/id #uuid "77da484d-f99e-564b-b4c3-19d24cde8a96" :step/content 17592186308687 :step/next "step-003358a9-f2af-59ba-b62d-17d3096b53b8" :db/ensure [:step/validate]} {:db/id "step-003358a9-f2af-59ba-b62d-17d3096b53b8" :step/id #uuid "003358a9-f2af-59ba-b62d-17d3096b53b8" :step/content 17592186482539 :db/ensure [:step/validate]} [:db/retract 17592186095838 :answer-field/choices 17592186095840] [:db/retract 17592186095838 :answer-field/choices 17592186095841] [:db/retract 17592186095838 :answer-field/choices 17592186095842] [:db/retract 17592186095838 :answer-field/choices 17592186095843] [:db/retract 17592186095838 :answer-field/choices 17592186095839] {:db/id 17592186096634 :knowledge-point/questions ["question-87b4272d-ed6b-52ae-b49c-9dfe670380e7" "question-98e817d9-610e-538f-a711-341d85a62ad2" "question-2f8f1100-44e9-5de0-ac27-77c13ead7f67"] :db/ensure [:knowledge-point/validate]} {:db/id "question-87b4272d-ed6b-52ae-b49c-9dfe670380e7" :question/id #uuid "87b4272d-ed6b-52ae-b49c-9dfe670380e7" :question/math-academy-id "q-216038" :question/problem "$$\n\\{\\begin{aligned}\\frac{1}{3}p-\\frac{1}{4}q=3 \\\\ -4p-7q=4\\end{aligned}\n$$\n\nFind the solution to the system of equations given above.\n\n$p=$\n{{field-1}}$,\\,q=$\n{{field-2}}" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $12.$\n\n$$\n\\{\\begin{aligned}\\frac{1}{3}p-\\frac{1}{4}q=3 & |\\,\\times 12 \\\\ -4p-7q=4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}4p-3q=36 \\\\ -4p-7q=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $4p$ term in the first equation can cancel with the $-4p$ term in the second equation.\n\nAdding the two equations eliminates the $p$-variable, and allows us to solve for $q:$\n\n$$\n\\begin{aligned}\\cancel{4p}-3q & =36 \\\\ -\\cancel{4p}-7q & =4 \\\\ -10q & =40 \\\\ q & =-4\\end{aligned}\n$$\n\nFinally, we can substitute $q=-4$ into the equation $-4p-7q=4$ to solve for $p:$\n\n$$\n\\begin{aligned}-4p-7q & =4 \\\\ -4p-7\\cdot (-4) & =4 \\\\ -4p+28 & =4 \\\\ -4p & =-24 \\\\ p & =6\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $p=6$ and $q=-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2cb22693-eb88-5d68-998f-9fb46b5af777" "answer-field-b535eccc-73da-535c-a127-32c7c5dd2549"] :db/ensure [:question/validate]} {:db/id "answer-field-2cb22693-eb88-5d68-998f-9fb46b5af777" :answer-field/id #uuid "2cb22693-eb88-5d68-998f-9fb46b5af777" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-81b3f5e6-7b2e-56b7-9389-d1e188527eb5" :answer-field/choices ["answer-81b3f5e6-7b2e-56b7-9389-d1e188527eb5"] :db/ensure [:answer-field/validate]} {:db/id "answer-81b3f5e6-7b2e-56b7-9389-d1e188527eb5" :answer/id #uuid "81b3f5e6-7b2e-56b7-9389-d1e188527eb5" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-field-b535eccc-73da-535c-a127-32c7c5dd2549" :answer-field/id #uuid "b535eccc-73da-535c-a127-32c7c5dd2549" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-615d06a8-9c96-51de-bff8-a126ddbcc263" :answer-field/choices ["answer-615d06a8-9c96-51de-bff8-a126ddbcc263"] :db/ensure [:answer-field/validate]} {:db/id "answer-615d06a8-9c96-51de-bff8-a126ddbcc263" :answer/id #uuid "615d06a8-9c96-51de-bff8-a126ddbcc263" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "question-98e817d9-610e-538f-a711-341d85a62ad2" :question/id #uuid "98e817d9-610e-538f-a711-341d85a62ad2" :question/math-academy-id "q-216035" :question/problem "$$\n\\{\\begin{aligned}\\frac{1}{3}x+\\frac{3}{2}y=-5 \\\\ -2x-y=-2\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $6.$\n\n$$\n\\{\\begin{aligned}\\frac{1}{3}x+\\frac{3}{2}y=-5 & |\\,\\times 6 \\\\ -2x-y=-2\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2x+9y=-30 \\\\ -2x-y=-2\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $2x$ term in the first equation can cancel with the $-2x$ term in the second equation.\n\nAdding the two equations eliminates the $x$-variable, and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\cancel{2x}+9y & =-30 \\\\ -\\cancel{2x}-y & =-2 \\\\ 8y & =-32 \\\\ y & =-4\\end{aligned}\n$$\n\nFinally, we can substitute $y=-4$ into the equation $-2x-y=-2$ to solve for $x:$\n\n$$\n\\begin{aligned}-2x-y & =-2 \\\\ -2x-(-4) & =-2 \\\\ -2x+4 & =-2 \\\\ -2x & =-6 \\\\ x & =3\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=3$ and $y=-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4d9a375-abbc-5813-a298-e638283c175f"] :db/ensure [:question/validate]} {:db/id "answer-field-f4d9a375-abbc-5813-a298-e638283c175f" :answer-field/id #uuid "f4d9a375-abbc-5813-a298-e638283c175f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd385079-e588-5673-a07b-71dcd96eba0b" :answer-field/choices ["answer-d2977dc8-5522-59a8-9ba9-e7485deb3f09" "answer-b1db4db7-8a40-5e37-8cf9-10fa79be6e22" "answer-0293fcaf-7265-58db-982d-824c6a56e9e6" "answer-cd385079-e588-5673-a07b-71dcd96eba0b" "answer-5fcca77f-33b4-51d9-b59e-2f22876bcd95"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2977dc8-5522-59a8-9ba9-e7485deb3f09" :answer/id #uuid "d2977dc8-5522-59a8-9ba9-e7485deb3f09" :answer/type :answer.type/math :answer/value "x=-2,\\,y=6" :db/ensure [:answer/validate]} {:db/id "answer-b1db4db7-8a40-5e37-8cf9-10fa79be6e22" :answer/id #uuid "b1db4db7-8a40-5e37-8cf9-10fa79be6e22" :answer/type :answer.type/math :answer/value "x=-3,\\,y=-\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "answer-0293fcaf-7265-58db-982d-824c6a56e9e6" :answer/id #uuid "0293fcaf-7265-58db-982d-824c6a56e9e6" :answer/type :answer.type/math :answer/value "x=0,\\,y=-\\frac{10}{3}" :db/ensure [:answer/validate]} {:db/id "answer-cd385079-e588-5673-a07b-71dcd96eba0b" :answer/id #uuid "cd385079-e588-5673-a07b-71dcd96eba0b" :answer/type :answer.type/math :answer/value "x=3,\\,y=-4" :db/ensure [:answer/validate]} {:db/id "answer-5fcca77f-33b4-51d9-b59e-2f22876bcd95" :answer/id #uuid "5fcca77f-33b4-51d9-b59e-2f22876bcd95" :answer/type :answer.type/math :answer/value "x=4,\\,y=-5" :db/ensure [:answer/validate]} {:db/id 17592186097319 :question/problem "$$\n\\{\\begin{aligned}\\frac{2}{5}p+q=1 \\\\ -2p-3q=1\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $5.$\n\n$$\n\\{\\begin{aligned}\\frac{2}{5}p+q=1 & |\\,\\times 5 \\\\ -2p-3q=1\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2p+5q=5 \\\\ -2p-3q=1\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $2p$ term in the first equation can cancel with the $-2p$ term in the second equation.\n\nAdding the two equations eliminates the $p$-variable, and allows us to solve for $q:$\n\n$$\n\\begin{aligned}\\cancel{2p}+5q & =5 \\\\ -\\cancel{2p}-3q & =1 \\\\ 2q & =6 \\\\ q & =3\\end{aligned}\n$$\n\nFinally, we can substitute $q=3$ into the equation $2p+5q=5$ to solve for $p:$\n\n$$\n\\begin{aligned}2p+5q & =5 \\\\ 2p+5\\cdot 3 & =5 \\\\ 2p+15 & =5 \\\\ 2p & =-10 \\\\ p & =-5\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $p=-5$ and $q=3.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186095838 :answer-field/correct "answer-15dcd2e7-aa75-5856-821e-3902315292cd" :answer-field/choices ["answer-53c886c8-25e2-5dd5-886f-89fc9f4a4c4e" "answer-15dcd2e7-aa75-5856-821e-3902315292cd" "answer-b5179a50-ba34-5521-9234-e0c0ccc5947f" "answer-393fa023-30ea-53d4-bbe5-359af3c3e54f" "answer-0a013722-8f9f-5321-aba5-d0f35846b7a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-53c886c8-25e2-5dd5-886f-89fc9f4a4c4e" :answer/id #uuid "53c886c8-25e2-5dd5-886f-89fc9f4a4c4e" :answer/type :answer.type/math :answer/value "p=-1,\\,q=7" :db/ensure [:answer/validate]} {:db/id "answer-15dcd2e7-aa75-5856-821e-3902315292cd" :answer/id #uuid "15dcd2e7-aa75-5856-821e-3902315292cd" :answer/type :answer.type/math :answer/value "p=-5,\\,q=3" :db/ensure [:answer/validate]} {:db/id "answer-b5179a50-ba34-5521-9234-e0c0ccc5947f" :answer/id #uuid "b5179a50-ba34-5521-9234-e0c0ccc5947f" :answer/type :answer.type/math :answer/value "p=3,\\,q=5" :db/ensure [:answer/validate]} {:db/id "answer-393fa023-30ea-53d4-bbe5-359af3c3e54f" :answer/id #uuid "393fa023-30ea-53d4-bbe5-359af3c3e54f" :answer/type :answer.type/math :answer/value "p=4,\\,q=3" :db/ensure [:answer/validate]} {:db/id "answer-0a013722-8f9f-5321-aba5-d0f35846b7a5" :answer/id #uuid "0a013722-8f9f-5321-aba5-d0f35846b7a5" :answer/type :answer.type/math :answer/value "p=5,\\,q=5" :db/ensure [:answer/validate]} {:db/id "question-2f8f1100-44e9-5de0-ac27-77c13ead7f67" :question/id #uuid "2f8f1100-44e9-5de0-ac27-77c13ead7f67" :question/math-academy-id "q-215740" :question/problem "$$\n\\{\\begin{aligned}2x+\\frac{1}{3}y=6 \\\\ 5x-y=4\\end{aligned}\n$$\n\nFind the solution to the system of equations given above.\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $3.$\n\n$$\n\\{\\begin{aligned}2x+\\frac{1}{3}y=6 & |\\,\\times 3 \\\\ 5x-y=4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}6x+y=18 \\\\ 5x-y=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $y$ term in the first equation can cancel with the $-y$ term in the second equation.\n\nAdding the two equations eliminates the $y$-variable, and allows us to solve for $x:$\n\n$$\n\\begin{aligned}6x+\\cancel{y} & =18 \\\\ 5x-\\cancel{y} & =4 \\\\ 11x & =22 \\\\ x & =2\\end{aligned}\n$$\n\nFinally, we can substitute $x=2$ into the equation $6x+y=18$ to solve for $y:$\n\n$$\n\\begin{aligned}6x+y & =18 \\\\ 6\\cdot 2+y & =18 \\\\ 12+y & =18 \\\\ y & =6\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=2,\\,y=6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-22db2219-dd1d-5c73-8420-03acf31177fc" "answer-field-8cc1d4df-8587-5128-8fdf-3b45c0f0a1dc"] :db/ensure [:question/validate]} {:db/id "answer-field-22db2219-dd1d-5c73-8420-03acf31177fc" :answer-field/id #uuid "22db2219-dd1d-5c73-8420-03acf31177fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9e6143a6-0fdd-5669-84d8-0e113cd51643" :answer-field/choices ["answer-9e6143a6-0fdd-5669-84d8-0e113cd51643"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e6143a6-0fdd-5669-84d8-0e113cd51643" :answer/id #uuid "9e6143a6-0fdd-5669-84d8-0e113cd51643" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-8cc1d4df-8587-5128-8fdf-3b45c0f0a1dc" :answer-field/id #uuid "8cc1d4df-8587-5128-8fdf-3b45c0f0a1dc" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7b7dfa22-473e-57b5-a937-ceec1b5ff546" :answer-field/choices ["answer-7b7dfa22-473e-57b5-a937-ceec1b5ff546"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b7dfa22-473e-57b5-a937-ceec1b5ff546" :answer/id #uuid "7b7dfa22-473e-57b5-a937-ceec1b5ff546" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186096635 :knowledge-point/questions ["question-ecc873f4-57df-56ae-b5fa-d73b11c36cc7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ecc873f4-57df-56ae-b5fa-d73b11c36cc7" :question/id #uuid "ecc873f4-57df-56ae-b5fa-d73b11c36cc7" :question/math-academy-id "q-216177" :question/problem "Solve the following system of equations:\n\n$$\n\\{\\begin{aligned}\\frac{3}{4}x+2y=-6 \\\\ -x+\\frac{1}{3}y=-10\\end{aligned}\n$$" :question/worked-solution "To get rid of fractions, we multiply the first equation by $4$ and the second equation by $3,$ as follows:\n\n$$\n\\{\\begin{aligned}\\frac{3}{4}x+2y=-6 & |\\times 4 \\\\ -x+\\frac{1}{3}y=-10 & |\\times 3\\end{aligned}\\,⟹\\,\\{\\begin{aligned}3x+8y=-24 \\\\ -3x+y=-30\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. We can eliminate $x$ by adding the two equations:\n\n$$\n\\begin{aligned}\\cancel{3x}+8y & =-24 \\\\ -\\cancel{3x}+y & =-30 \\\\ (8y+y) & =(-24-30) \\\\ 9y & =-54 \\\\ y & =-6\\end{aligned}\n$$\n\nFinally, we substitute $y=-6$ into the first equation to solve for $x:$\n\n$$\n\\begin{aligned}3x+8y & =-24 \\\\ 3x+8(-6) & =-24 \\\\ 3x-48 & =-24 \\\\ 3x & =24 \\\\ x & =8\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=8,\\,y=-6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-49233c73-c921-5e3f-b3db-c183bb683e95"] :db/ensure [:question/validate]} {:db/id "answer-field-49233c73-c921-5e3f-b3db-c183bb683e95" :answer-field/id #uuid "49233c73-c921-5e3f-b3db-c183bb683e95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-53744223-8cd7-552e-a59b-eb16d6ea99ee" :answer-field/choices ["answer-d6375d72-3485-5e65-848c-9b62e50dff15" "answer-d224f1c2-daea-5840-bde5-ea7d182fed3a" "answer-fa92e62f-e86c-521d-82dc-8c0da4ab37e0" "answer-b8ccee43-d730-5189-89d6-32f56294f8d2" "answer-53744223-8cd7-552e-a59b-eb16d6ea99ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-d6375d72-3485-5e65-848c-9b62e50dff15" :answer/id #uuid "d6375d72-3485-5e65-848c-9b62e50dff15" :answer/type :answer.type/math :answer/value "x=12,\\,y=-6" :db/ensure [:answer/validate]} {:db/id "answer-d224f1c2-daea-5840-bde5-ea7d182fed3a" :answer/id #uuid "d224f1c2-daea-5840-bde5-ea7d182fed3a" :answer/type :answer.type/math :answer/value "x=3,\\,y=-6" :db/ensure [:answer/validate]} {:db/id "answer-fa92e62f-e86c-521d-82dc-8c0da4ab37e0" :answer/id #uuid "fa92e62f-e86c-521d-82dc-8c0da4ab37e0" :answer/type :answer.type/math :answer/value "x=4,\\,y=-3" :db/ensure [:answer/validate]} {:db/id "answer-b8ccee43-d730-5189-89d6-32f56294f8d2" :answer/id #uuid "b8ccee43-d730-5189-89d6-32f56294f8d2" :answer/type :answer.type/math :answer/value "x=8,\\,y=-4" :db/ensure [:answer/validate]} {:db/id "answer-53744223-8cd7-552e-a59b-eb16d6ea99ee" :answer/id #uuid "53744223-8cd7-552e-a59b-eb16d6ea99ee" :answer/type :answer.type/math :answer/value "x=8,\\,y=-6" :db/ensure [:answer/validate]} {:db/id 17592186096636 :knowledge-point/questions ["question-634cc981-026f-5720-a0d6-757e4b38cffe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-634cc981-026f-5720-a0d6-757e4b38cffe" :question/id #uuid "634cc981-026f-5720-a0d6-757e4b38cffe" :question/math-academy-id "q-215834" :question/problem "$$\n\\{\\begin{aligned}5x+2y=1 \\\\ \\frac{2x}{3}-\\frac{y}{9}=-1\\end{aligned}\n$$\n\nFind the solution to the system of equations given above.\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}" :question/worked-solution "To get rid of the fractions in the second equation, we must multiply the second equation by the lowest common denominator of the fractions, which is $9.$\n\n$$\n\\{\\begin{aligned}5x+2y=1 \\\\ \\frac{2x}{3}-\\frac{y}{9}=-1 & |\\,\\times 9\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5x+2y=1 \\\\ 6x-y=-9\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Let's solve for $y$ in the second equation:\n\n$$\n\\begin{aligned}6x-y & =-9 \\\\ 6x+9 & =y \\\\ y & =6x+9\\end{aligned}\n$$\n\nThen, we can substitute $y=6x+9$ into the first equation and solve for $x:$\n\n$$\n\\begin{aligned}5x+2y & =1 \\\\ 5x+2(6x+9) & =1 \\\\ 5x+12x+18 & =1 \\\\ 17x+18 & =1 \\\\ 17x & =-17 \\\\ x & =-1\\end{aligned}\n$$\n\nFinally, to find the value of $y,$ we substitute $x=-1$ into the equation $y=6x+9,$ as follows:\n\n$$\n\\begin{aligned}y & =6x+9 \\\\  & =6(-1)+9 \\\\  & =3\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-1,\\,y=3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-32fbac1b-2c0d-5963-85ad-5444d6fe7fc9" "answer-field-3d296c9e-3e4f-5251-b99c-1087847747be"] :db/ensure [:question/validate]} {:db/id "answer-field-32fbac1b-2c0d-5963-85ad-5444d6fe7fc9" :answer-field/id #uuid "32fbac1b-2c0d-5963-85ad-5444d6fe7fc9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ccf4bfc3-88a6-5d09-ae6d-e269ffac1931" :answer-field/choices ["answer-ccf4bfc3-88a6-5d09-ae6d-e269ffac1931"] :db/ensure [:answer-field/validate]} {:db/id "answer-ccf4bfc3-88a6-5d09-ae6d-e269ffac1931" :answer/id #uuid "ccf4bfc3-88a6-5d09-ae6d-e269ffac1931" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-3d296c9e-3e4f-5251-b99c-1087847747be" :answer-field/id #uuid "3d296c9e-3e4f-5251-b99c-1087847747be" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ad656808-65b5-5adb-8dd4-7e9667a6904d" :answer-field/choices ["answer-ad656808-65b5-5adb-8dd4-7e9667a6904d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad656808-65b5-5adb-8dd4-7e9667a6904d" :answer/id #uuid "ad656808-65b5-5adb-8dd4-7e9667a6904d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186096637 :knowledge-point/questions ["question-cb34e92b-11ce-5586-a6db-ed20acf39bd8" "question-0f1e5457-cea5-5c5a-997b-b02818578f46"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cb34e92b-11ce-5586-a6db-ed20acf39bd8" :question/id #uuid "cb34e92b-11ce-5586-a6db-ed20acf39bd8" :question/math-academy-id "q-216062" :question/problem "$$\n\\{\\begin{aligned}\\frac{5}{3}s-\\frac{2}{3}t=-1 \\\\ s+\\frac{1}{4}t=2\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of fractions, we multiply the first equation by $3$ and the second equation by $4,$ as follows:\n\n$$\n\\{\\begin{aligned}\\frac{5}{3}s-\\frac{2}{3}t=-1 & |\\times 3 \\\\ s+\\frac{1}{4}t=2 & |\\times 4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5s-2t=-3 \\\\ 4s+t=8\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Notice that the second equation can easily be solved for $t:$\n\n$$\n\\begin{aligned}4s+t & =8 \\\\ t & =8-4s\\end{aligned}\n$$\n\nWe substitute $t=8-4s$ into the first equation and then solve for $s:$\n\n$$\n\\begin{aligned}5s-2t & =-3 \\\\ 5s-2(8-4s) & =-3 \\\\ 5s-16+8s & =-3 \\\\ 13s & =13 \\\\ s & =1\\end{aligned}\n$$\n\nFinally, to find the value of $t,$ we substitute $s=1$ into the equation $t=8-4s$ as follows:\n\n$$\n\\begin{aligned}t & =8-4s \\\\  & =8-4(1) \\\\  & =4\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $s=1$ and $t=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-86ae1002-c318-5989-8c0c-03e862059522"] :db/ensure [:question/validate]} {:db/id "answer-field-86ae1002-c318-5989-8c0c-03e862059522" :answer-field/id #uuid "86ae1002-c318-5989-8c0c-03e862059522" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-06af144f-4c5a-5f7d-bcae-becd399595a7" :answer-field/choices ["answer-c6f2c462-fa61-5493-90fc-306d1d3339be" "answer-90a54c3b-d57a-5b56-b610-4e5ba4b8c320" "answer-06af144f-4c5a-5f7d-bcae-becd399595a7" "answer-80d413a7-4a8a-5e3d-8f60-ce6ec9e391fb" "answer-35184dd6-b1fe-5c13-bdb5-273a2cadca99"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6f2c462-fa61-5493-90fc-306d1d3339be" :answer/id #uuid "c6f2c462-fa61-5493-90fc-306d1d3339be" :answer/type :answer.type/math :answer/value "s=-1,\\,t=12" :db/ensure [:answer/validate]} {:db/id "answer-90a54c3b-d57a-5b56-b610-4e5ba4b8c320" :answer/id #uuid "90a54c3b-d57a-5b56-b610-4e5ba4b8c320" :answer/type :answer.type/math :answer/value "s=0,\\,t=8" :db/ensure [:answer/validate]} {:db/id "answer-06af144f-4c5a-5f7d-bcae-becd399595a7" :answer/id #uuid "06af144f-4c5a-5f7d-bcae-becd399595a7" :answer/type :answer.type/math :answer/value "s=1,\\,t=4" :db/ensure [:answer/validate]} {:db/id "answer-80d413a7-4a8a-5e3d-8f60-ce6ec9e391fb" :answer/id #uuid "80d413a7-4a8a-5e3d-8f60-ce6ec9e391fb" :answer/type :answer.type/math :answer/value "s=2,\\,t=0" :db/ensure [:answer/validate]} {:db/id "answer-35184dd6-b1fe-5c13-bdb5-273a2cadca99" :answer/id #uuid "35184dd6-b1fe-5c13-bdb5-273a2cadca99" :answer/type :answer.type/math :answer/value "s=3,\\,t=-4" :db/ensure [:answer/validate]} {:db/id "question-0f1e5457-cea5-5c5a-997b-b02818578f46" :question/id #uuid "0f1e5457-cea5-5c5a-997b-b02818578f46" :question/math-academy-id "q-216060" :question/problem "$$\n\\{\\begin{aligned}a+\\frac{3}{5}b=\\frac{9}{5} \\\\ \\frac{3}{7}a+\\frac{1}{7}b=1\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of fractions, we multiply the first equation by $5$ and the second equation by $7,$ as follows:\n\n$$\n\\{\\begin{aligned}a+\\frac{3}{5}b=\\frac{9}{5} & |\\times 5 \\\\ \\frac{3}{7}a+\\frac{1}{7}b=1 & |\\times 7\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5a+3b=9 \\\\ 3a+b=7\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Notice that the second equation can easily be solved for $b:$\n\n$$\n\\begin{aligned}3a+b & =7 \\\\ b & =7-3a\\end{aligned}\n$$\n\nWe substitute $b=7-3a$ into the first equation and then solve for $a:$\n\n$$\n\\begin{aligned}5a+3b & =9 \\\\ 5a+3(7-3a) & =9 \\\\ 5a+21-9a & =9 \\\\ -4a & =-12 \\\\ a & =3\\end{aligned}\n$$\n\nFinally, to find the value of $b,$ we substitute $a=3$ into the equation $b=7-3a$ as follows:\n\n$$\n\\begin{aligned}b & =7-3a \\\\  & =7-3(3) \\\\  & =7-9 \\\\  & =-2\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $a=3$ and $b=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-172d876b-a2ec-53c9-b98d-a6ec2ea0fdc4"] :db/ensure [:question/validate]} {:db/id "answer-field-172d876b-a2ec-53c9-b98d-a6ec2ea0fdc4" :answer-field/id #uuid "172d876b-a2ec-53c9-b98d-a6ec2ea0fdc4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9c9268e1-dbb3-5170-96ed-895c49adebf4" :answer-field/choices ["answer-efbe8073-8987-54ae-9846-bf0535624288" "answer-590d032f-044c-52af-affe-ade519cfab6e" "answer-c40a62c3-bbe0-5d17-9e8f-240d7fe1b737" "answer-9c9268e1-dbb3-5170-96ed-895c49adebf4" "answer-16636eaa-e2cc-5e82-a93c-29ae2c9a4b79"] :db/ensure [:answer-field/validate]} {:db/id "answer-efbe8073-8987-54ae-9846-bf0535624288" :answer/id #uuid "efbe8073-8987-54ae-9846-bf0535624288" :answer/type :answer.type/math :answer/value "a=0,\\,b=3" :db/ensure [:answer/validate]} {:db/id "answer-590d032f-044c-52af-affe-ade519cfab6e" :answer/id #uuid "590d032f-044c-52af-affe-ade519cfab6e" :answer/type :answer.type/math :answer/value "a=1,\\,b=4" :db/ensure [:answer/validate]} {:db/id "answer-c40a62c3-bbe0-5d17-9e8f-240d7fe1b737" :answer/id #uuid "c40a62c3-bbe0-5d17-9e8f-240d7fe1b737" :answer/type :answer.type/math :answer/value "a=2,\\,b=1" :db/ensure [:answer/validate]} {:db/id "answer-9c9268e1-dbb3-5170-96ed-895c49adebf4" :answer/id #uuid "9c9268e1-dbb3-5170-96ed-895c49adebf4" :answer/type :answer.type/math :answer/value "a=3,\\,b=-2" :db/ensure [:answer/validate]} {:db/id "answer-16636eaa-e2cc-5e82-a93c-29ae2c9a4b79" :answer/id #uuid "16636eaa-e2cc-5e82-a93c-29ae2c9a4b79" :answer/type :answer.type/math :answer/value "a=4,\\,b=-5" :db/ensure [:answer/validate]} {:db/id 17592186097919 :tutorial/content "Sometimes, we might have a system of equations with fractional coefficients, such as the following:\n\n$$\n\\{\\begin{aligned}\\frac{1}{2}x+\\frac{5}{4}y=-4 \\\\ 7x-5y=-2\\end{aligned}\n$$\n\nWe can turn the system into an equivalent system involving only integer coefficients. This will make it easier to solve.\n\nIn general, we multiply each equation by its lowest common denominator. In this instance, multiplying the first equation by the lowest common denominator of the fractions $(4)$ will do the job:\n\n![](images/7f/7ff92bdf3b9c8bf5ffb571d598788f37bcd698f7b3971c337531bf9fe7f55e4e.svg)\n\nNow, we can solve the system using, for example, the elimination method. Notice that the $5y$ term in the first equation can cancel with the $-5y$ term in the second equation.\n\nAdding the two equations eliminates the $y$-variable, and allows us to solve for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}2x+\\cancel{5y} & =-16 \\\\ 7x-\\cancel{5y} & =-2 \\\\ 9x & =-18 \\\\ x & =-2\\end{aligned}\n$$\n\nFinally, we can substitute $x=-2$ into the equation $7x - 5y= -2$ to solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}7x-5y & =-2 \\\\ 7(-2)-5y & =-2 \\\\ -14-5y & =-2 \\\\ -5y & =12 \\\\ y & =-\\frac{12}{5}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-2, \\,y=-\\dfrac{12}{5}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186096853 :activity/expected-seconds 960.0 :db/ensure [:activity/validate]} {:db/id 17592186124655 :knowledge-point/questions ["question-ac06f66c-0484-5c24-8d99-9d11ac2dbda8" "question-9f714ecf-c225-5f6f-850c-327baa1dc6f6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ac06f66c-0484-5c24-8d99-9d11ac2dbda8" :question/id #uuid "ac06f66c-0484-5c24-8d99-9d11ac2dbda8" :question/math-academy-id "q-81048" :question/problem "Find and categorize all local the extrema of the function $f(x,y)=-2{x}^{2}+ey-{e}^{y},$ and determine which of the following statements is true." :question/worked-solution "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f′(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}(-2{x}^{2}+ey-{e}^{y}) & \\frac{∂}{∂y}(-2{x}^{2}+ey-{e}^{y})\\end{aligned}] \\\\  & =[\\begin{aligned}-4x & e-{e}^{y}\\end{aligned}]\\end{aligned}\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $f′(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n\\{\\begin{aligned}-4x=0 \\\\ e-{e}^{y}=0\\end{aligned}\n$$\n\nSolving the first equation for $x,$ we get\n\n$$\n-4x=0\\,⟹\\,x=0.\n$$\n\nSolving the second  equation for $y,$ we get\n\n$$\ne-{e}^{y}=0\\,⟹\\,y=1.\n$$\n\nHence, $(0,1)$ is a stationary point of $f(x,y).$   \n\nTo classify this stationary point, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-4x)=-4\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(e-{e}^{y})=0 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(-4x)=0\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(e-{e}^{y})=-{e}^{y}\\end{aligned}\n$$\n\nSo, the second derivative  is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}-4 & 0 \\\\ 0 & -{e}^{y}\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=[\\begin{aligned}-4 & 0 \\\\ 0 & -e\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(0,1),$ we get\n\n$$\nH(0,1)=det({f}^{″}(0,1))=(-4)\\cdot (-e)-{0}^{2}=4e>0.\n$$\n\nFinally, notice that \n\n$$\n\\frac{{∂}^{2}f}{∂{x}^{2}}(0,0)=({f}^{″}(0,1))_{11}=-4<0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a local maximum at $(0,1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8f7fa629-9baf-529b-99af-39063b4618f6"] :db/ensure [:question/validate]} {:db/id "answer-field-8f7fa629-9baf-529b-99af-39063b4618f6" :answer-field/id #uuid "8f7fa629-9baf-529b-99af-39063b4618f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-87ca91c3-a26a-5635-add5-c073ea764a5a" :answer-field/choices ["answer-35563bcf-877b-5a37-b29d-40f490c08f36" "answer-c14d984f-72ff-59f8-bdd6-8c050d73fad8" "answer-87ca91c3-a26a-5635-add5-c073ea764a5a" "answer-58b65e9f-4d99-5093-aa0f-4d2897f123b8" "answer-f0ae0c36-9a90-5251-835e-e8a464a23a1b"] :db/ensure [:answer-field/validate]} {:db/id "answer-35563bcf-877b-5a37-b29d-40f490c08f36" :answer/id #uuid "35563bcf-877b-5a37-b29d-40f490c08f36" :answer/type :answer.type/text :answer/value "$f(x,y)$  has a saddle point at  at $(1,-1)$" :db/ensure [:answer/validate]} {:db/id "answer-c14d984f-72ff-59f8-bdd6-8c050d73fad8" :answer/id #uuid "c14d984f-72ff-59f8-bdd6-8c050d73fad8" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a local maximum  at $(0,-1)$" :db/ensure [:answer/validate]} {:db/id "answer-87ca91c3-a26a-5635-add5-c073ea764a5a" :answer/id #uuid "87ca91c3-a26a-5635-add5-c073ea764a5a" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a local maximum  at $(0,1)$" :db/ensure [:answer/validate]} {:db/id "answer-58b65e9f-4d99-5093-aa0f-4d2897f123b8" :answer/id #uuid "58b65e9f-4d99-5093-aa0f-4d2897f123b8" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a local minimum  at $(-1,1)$" :db/ensure [:answer/validate]} {:db/id "answer-f0ae0c36-9a90-5251-835e-e8a464a23a1b" :answer/id #uuid "f0ae0c36-9a90-5251-835e-e8a464a23a1b" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a local minimum  at $(1,0)$" :db/ensure [:answer/validate]} {:db/id "question-9f714ecf-c225-5f6f-850c-327baa1dc6f6" :question/id #uuid "9f714ecf-c225-5f6f-850c-327baa1dc6f6" :question/math-academy-id "q-81172" :question/problem "Find and categorize all local the extrema of the function $f(x,y)=x{y}^{2}-4y-4x,$ and determine which of the following statements is true." :question/worked-solution "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f′(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}(x{y}^{2}-4y-4x) & \\frac{∂}{∂y}(x{y}^{2}-4y-4x)\\end{aligned}] \\\\  & =[\\begin{aligned}{y}^{2}-4 & 2(xy-2)\\end{aligned}]\\end{aligned}\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $f′(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n\\{\\begin{aligned}{y}^{2}-4=0 \\\\ xy-2=0\\end{aligned}\n$$\n\nSolving the first equation for $y,$ we get\n\n$$\n{y}^{2}-4=0\\,⟹\\,y=\\pm 2.\n$$\n\nThen, substituting these values into the second equation, we get\n\n$$\ny=-2\\,⟹\\,x=\\frac{2}{-2}=-1,\\,\\,y=2\\,\\,\\,\\,\\,⟹\\,x=\\frac{2}{2}=1.\n$$\n\nHence, $(-1,-2)$ and $(1,2)$ are stationary points of $f(x,y).$\n\nTo classify these stationary points, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}({y}^{2}-4)=0\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2xy-4)=2y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}({y}^{2}-4)=2y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2xy-4)=2x\\end{aligned}\n$$\n\nSo, the second derivative is \n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}0 & 2y \\\\ 2y & 2x\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate the second derivative at each of the stationary points and use it to categorize them:\n\n- Evaluating the second derivative at $(-1,-2),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(-1,-2)=[\\begin{aligned}0 & -4 \\\\ -4 & -2\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(-1,-2),$ we get\n\n$$\nH(-1,-2)=det({f}^{″}(-1,-2))=0\\cdot (-2)-(-4)^{2}=-16<0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a saddle point at $(-1,-2).$\n\n- Evaluating the second derivative at $(1,2),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,2)=[\\begin{aligned}0 & 4 \\\\ 4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(1,2),$ we get\n\n$$\nH(1,2)=det({f}^{″}(1,2))=0\\cdot 2-{4}^{2}=-16<0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a saddle point at $(1,2).$\n\nIn conclusion, $f(x,y)$ has saddle points at $(-1,-2)$ and $(1,2).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b199132b-7b0e-5674-af57-8442f38abdba"] :db/ensure [:question/validate]} {:db/id "answer-field-b199132b-7b0e-5674-af57-8442f38abdba" :answer-field/id #uuid "b199132b-7b0e-5674-af57-8442f38abdba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-13574205-8e5b-557d-b506-8f6098c78c23" :answer-field/choices ["answer-7d90fa6d-adf2-5db3-b9b7-4dc01fdc1df1" "answer-bdc001e1-be83-5588-9961-a4a046536923" "answer-13e49d2a-fab6-5159-b1c0-5a9b594d165b" "answer-5de0e24f-6b20-5c6e-ace0-a245f8aa51ae" "answer-13574205-8e5b-557d-b506-8f6098c78c23"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d90fa6d-adf2-5db3-b9b7-4dc01fdc1df1" :answer/id #uuid "7d90fa6d-adf2-5db3-b9b7-4dc01fdc1df1" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a local maximum at $(1,-2)$ and a saddle point at $(-1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-bdc001e1-be83-5588-9961-a4a046536923" :answer/id #uuid "bdc001e1-be83-5588-9961-a4a046536923" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a local minimum at $(-1,-2)$ a local maximum at $(1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-13e49d2a-fab6-5159-b1c0-5a9b594d165b" :answer/id #uuid "13e49d2a-fab6-5159-b1c0-5a9b594d165b" :answer/type :answer.type/text :answer/value "$f(x,y)$ has a saddle point at $(1,-2)$ and a local maximum at $(-1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-5de0e24f-6b20-5c6e-ace0-a245f8aa51ae" :answer/id #uuid "5de0e24f-6b20-5c6e-ace0-a245f8aa51ae" :answer/type :answer.type/text :answer/value "$f(x,y)$ has local minima at $(-1,-2)$ and $(1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-13574205-8e5b-557d-b506-8f6098c78c23" :answer/id #uuid "13574205-8e5b-557d-b506-8f6098c78c23" :answer/type :answer.type/text :answer/value "$f(x,y)$ has saddle points at $(-1,-2)$ and $(1,2)$" :db/ensure [:answer/validate]} {:db/id 17592186124654 :knowledge-point/questions ["question-22b41189-2cbf-5d3c-9c30-272b9cf4d5e7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-22b41189-2cbf-5d3c-9c30-272b9cf4d5e7" :question/id #uuid "22b41189-2cbf-5d3c-9c30-272b9cf4d5e7" :question/math-academy-id "q-104972" :question/problem "The function \n$f(x,y)$ \nhas the second derivative\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}-2y & 4y-2x \\\\ 4y-2x & 4x\\end{aligned}]\n$$\n\nand has a stationary point at $(1,1).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nI. $H(1,1)>0$\n\nII. $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)<0$\n\nIII. The point $(1,1)$ is a saddle point of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=[\\begin{aligned}-2 & 2 \\\\ 2 & 4\\end{aligned}].\\end{aligned}\n$$\n\nNow, let's examine our statements in turn.\n\n- Statement I is false. Computing the determinant of ${f}^{″}(1,1),$ we get\n\n$$\nH(1,1)=det({f}^{″}(1,1))=(-2)\\cdot 4-{2}^{2}=-12<0.\n$$\n\n- Statement II is true. Indeed, we have $\\frac{{∂}^{2}f}{∂{x}^{2}}(1,1)=({f}^{″}(1,1))_{11}=-2<0.$\n\n- Statement III is true. Indeed, since $H(1,1)<0,$ the point $(1,1)$ is a saddle point by the second partial derivative test.\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ca90436-78d3-5958-bb30-5ff0939b26c6"] :db/ensure [:question/validate]} {:db/id "answer-field-9ca90436-78d3-5958-bb30-5ff0939b26c6" :answer-field/id #uuid "9ca90436-78d3-5958-bb30-5ff0939b26c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e958518-516a-5fe5-b01c-caeda1f4b877" :answer-field/choices ["answer-6da12e8f-9a72-519d-aa8c-c280dab33816" "answer-13af5318-875b-5713-b76b-c620f034eee7" "answer-9e958518-516a-5fe5-b01c-caeda1f4b877" "answer-73c89adb-6ad9-5a52-805c-8e998406f119" "answer-6c1d85e8-0bc7-546d-befe-bf2f6875ee46"] :db/ensure [:answer-field/validate]} {:db/id "answer-6da12e8f-9a72-519d-aa8c-c280dab33816" :answer/id #uuid "6da12e8f-9a72-519d-aa8c-c280dab33816" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-13af5318-875b-5713-b76b-c620f034eee7" :answer/id #uuid "13af5318-875b-5713-b76b-c620f034eee7" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-9e958518-516a-5fe5-b01c-caeda1f4b877" :answer/id #uuid "9e958518-516a-5fe5-b01c-caeda1f4b877" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-73c89adb-6ad9-5a52-805c-8e998406f119" :answer/id #uuid "73c89adb-6ad9-5a52-805c-8e998406f119" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-6c1d85e8-0bc7-546d-befe-bf2f6875ee46" :answer/id #uuid "6c1d85e8-0bc7-546d-befe-bf2f6875ee46" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-9736e825-0def-59a5-91ca-930e623a504c" :activity/id #uuid "9736e825-0def-59a5-91ca-930e623a504c" :activity/title "The Second Partial Derivatives Test" :activity/type :activity.type/review :activity/scope 17592186051048 :activity/course 17592186046645 :activity/steps ["step-968d2559-6e9f-56e6-9b9e-123351a336d0" "step-7680f643-a75d-57d6-8c87-a026935d52e1" "step-ce1efa80-0c1d-5262-b0b5-0d1381771d5b" "step-f91e8e6a-a7db-5d9a-8fbc-5c958203d35d" "step-d671a181-8f1a-54af-9310-de7ad818f73c"] :activity/first-step "step-968d2559-6e9f-56e6-9b9e-123351a336d0" :db/ensure [:activity/validate]} {:db/id "step-968d2559-6e9f-56e6-9b9e-123351a336d0" :step/id #uuid "968d2559-6e9f-56e6-9b9e-123351a336d0" :step/content 17592186125083 :step/next "step-7680f643-a75d-57d6-8c87-a026935d52e1" :db/ensure [:step/validate]} {:db/id "step-7680f643-a75d-57d6-8c87-a026935d52e1" :step/id #uuid "7680f643-a75d-57d6-8c87-a026935d52e1" :step/content "question-ac06f66c-0484-5c24-8d99-9d11ac2dbda8" :step/next "step-ce1efa80-0c1d-5262-b0b5-0d1381771d5b" :db/ensure [:step/validate]} {:db/id "step-ce1efa80-0c1d-5262-b0b5-0d1381771d5b" :step/id #uuid "ce1efa80-0c1d-5262-b0b5-0d1381771d5b" :step/content "question-9f714ecf-c225-5f6f-850c-327baa1dc6f6" :step/next "step-f91e8e6a-a7db-5d9a-8fbc-5c958203d35d" :db/ensure [:step/validate]} {:db/id "step-f91e8e6a-a7db-5d9a-8fbc-5c958203d35d" :step/id #uuid "f91e8e6a-a7db-5d9a-8fbc-5c958203d35d" :step/content "question-22b41189-2cbf-5d3c-9c30-272b9cf4d5e7" :step/next "step-d671a181-8f1a-54af-9310-de7ad818f73c" :db/ensure [:step/validate]} {:db/id "step-d671a181-8f1a-54af-9310-de7ad818f73c" :step/id #uuid "d671a181-8f1a-54af-9310-de7ad818f73c" :step/content 17592186520472 :db/ensure [:step/validate]} {:db/id 17592186179739 :knowledge-point/questions ["question-e8988e8d-780c-5cf1-8b3a-d358392fe42f" "question-3f935fec-3b1f-581f-b980-6cf035478e31"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179601 :question/problem "![](images/d5/d51d0cea4b75dffe5eef6ccf46e5156716eb1381d20b4193d811acfe83278094.png)\n\n \n\nConsider the curve and constant vector field $\\mathbf F$ shown above. Let $C$ be the path where the curve is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. $\\displaystyle\\int_C\\mathbf F\\cdot \\textrm d \\mathbf r > 0$\n\nII. $\\displaystyle\\int_C\\mathbf F\\cdot \\textrm d \\mathbf r =                 0$\n\nIII. $\\displaystyle\\int_{-C}\\mathbf F\\cdot \\textrm d \\mathbf r =  0$" :db/ensure [:question/validate]} {:db/id 17592186179742 :knowledge-point/questions ["question-5c3b3b24-43f3-512c-b4aa-af0e4524c252" "question-e8382e90-f8cf-5c02-a1ba-6dd0a94124ee"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179604 :question/problem "![](images/29/298b7b4293ff104a62107670fa2aba603b8a23e9ad042f7e270a4acf6267a2fa.png)\n\n \n\nConsider the vector field $\\mathbf F(x,y)$ shown above, and let $C$ be the path where the curve is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. $\\displaystyle\\int_C\\mathbf F\\cdot \\textrm d \\mathbf r <  0$\n\nII. $\\displaystyle\\int_C\\mathbf F\\cdot \\textrm d \\mathbf r =         0$\n\nIII. $\\displaystyle\\int_{-C}\\mathbf F\\cdot \\textrm d \\mathbf r >  0$" :db/ensure [:question/validate]} {:db/id "question-e8988e8d-780c-5cf1-8b3a-d358392fe42f" :question/id #uuid "e8988e8d-780c-5cf1-8b3a-d358392fe42f" :question/math-academy-id "q-125694" :question/problem "![](images/3c/3c2035d50b823b9bcbeb3ae8cf698df9a25c95a289c5a6f35054269dc920088d.png)\n\nConsider the vector field $F$ shown above, and let $C$ be the path where the curve is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. ${\\int }_{C}F\\cdot \\text{d}r>0$\n\nII. ${\\int }_{C}F\\cdot \\text{d}r<0$\n\nIII. ${\\int }_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement II is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/df/dfec76b47e8508a57e18440a72986bcae8e2bd19559bd0915ea4530e0b08b4f6.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- Statement III is false. It's clear from the picture below that if we reverse the orientation of $C,$ then $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/58/58e3efc39d0aee02d14e7c80c7355c37a1f28b6f0f54ff7102553e3a6ffc17cf.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4ea4a547-6ad1-5f93-999f-8abb84e0f98d"] :db/ensure [:question/validate]} {:db/id "answer-field-4ea4a547-6ad1-5f93-999f-8abb84e0f98d" :answer-field/id #uuid "4ea4a547-6ad1-5f93-999f-8abb84e0f98d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d3245f3-1418-5cbc-8bdf-0fbf963d7590" :answer-field/choices ["answer-3d89cccc-306c-53d5-aef6-3a09d66762b0" "answer-8d3245f3-1418-5cbc-8bdf-0fbf963d7590" "answer-d6f17f74-b9d6-5ff0-add2-62309e9b7aff" "answer-4f3ee884-db04-5c75-9481-3c7b9fdbaebb" "answer-a183fdc7-3ce9-52cd-9fb3-ce809fabf547"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d89cccc-306c-53d5-aef6-3a09d66762b0" :answer/id #uuid "3d89cccc-306c-53d5-aef6-3a09d66762b0" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-8d3245f3-1418-5cbc-8bdf-0fbf963d7590" :answer/id #uuid "8d3245f3-1418-5cbc-8bdf-0fbf963d7590" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d6f17f74-b9d6-5ff0-add2-62309e9b7aff" :answer/id #uuid "d6f17f74-b9d6-5ff0-add2-62309e9b7aff" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-4f3ee884-db04-5c75-9481-3c7b9fdbaebb" :answer/id #uuid "4f3ee884-db04-5c75-9481-3c7b9fdbaebb" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-a183fdc7-3ce9-52cd-9fb3-ce809fabf547" :answer/id #uuid "a183fdc7-3ce9-52cd-9fb3-ce809fabf547" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-3f935fec-3b1f-581f-b980-6cf035478e31" :question/id #uuid "3f935fec-3b1f-581f-b980-6cf035478e31" :question/math-academy-id "q-125496" :question/problem "![](images/a5/a5f23af5dd514a65937eee29bb0992ff94d68897d8c6422fcf215aad45379c4a.png)\n\nConsider the part of parabola and constant vector field $F$ shown above. Let $C$ be the path where the part of parabola is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. ${\\int }_{C}F\\cdot \\text{d}r>0$\n\nII. ${\\int }_{C}F\\cdot \\text{d}r=0$\n\nIII. ${\\int }_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I is false, while statement II is true. As the particle moves from $A$ to $B,$ the force $F$ works with the particle for $y<0,$ while $F$  works against the particle for $y>0.$ \n\n![](images/53/537aca6190fc2f3e06e85c0781a8bb461559ef0a7515ee29aca505f9d615f820.png)\n\n \n\nBy symmetry, the contribution to ${\\int }_{C}F\\cdot \\text{d}r$ for $y<0$ is canceled out by the contribution for $y>0.$ So,\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/49/4939f9a22400a7a56eaeacb77d520e522f50aa8378ca1014a19810122e12da51.png)\n\n \n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ab27c17a-102b-5532-a4af-ffd4b651eaf8"] :db/ensure [:question/validate]} {:db/id "answer-field-ab27c17a-102b-5532-a4af-ffd4b651eaf8" :answer-field/id #uuid "ab27c17a-102b-5532-a4af-ffd4b651eaf8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-207f985c-5c7f-5533-a8b6-987df6052d66" :answer-field/choices ["answer-6945da02-c950-5064-a170-fc578a3069fa" "answer-9219bfba-4d32-5e6f-9243-454fb1322162" "answer-a5ae85ad-3923-5d0b-9389-406219ac54b6" "answer-207f985c-5c7f-5533-a8b6-987df6052d66" "answer-42f905b7-6402-5058-b569-ac945598dc5f"] :db/ensure [:answer-field/validate]} {:db/id "answer-6945da02-c950-5064-a170-fc578a3069fa" :answer/id #uuid "6945da02-c950-5064-a170-fc578a3069fa" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-9219bfba-4d32-5e6f-9243-454fb1322162" :answer/id #uuid "9219bfba-4d32-5e6f-9243-454fb1322162" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-a5ae85ad-3923-5d0b-9389-406219ac54b6" :answer/id #uuid "a5ae85ad-3923-5d0b-9389-406219ac54b6" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-207f985c-5c7f-5533-a8b6-987df6052d66" :answer/id #uuid "207f985c-5c7f-5533-a8b6-987df6052d66" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-42f905b7-6402-5058-b569-ac945598dc5f" :answer/id #uuid "42f905b7-6402-5058-b569-ac945598dc5f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-5c3b3b24-43f3-512c-b4aa-af0e4524c252" :question/id #uuid "5c3b3b24-43f3-512c-b4aa-af0e4524c252" :question/math-academy-id "q-150013" :question/problem "![](images/dc/dcf7a2ea5b44f3f5ba7b1663f7979cdc3fc8c1036b6cc797904ffda77f1003bd.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the сurve is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. ${\\int }_{C}F\\cdot \\text{d}r>0$\n\nII. ${\\int }_{C}F\\cdot \\text{d}r<0$\n\nIII. ${\\int }_{-C}F\\cdot \\text{d}r<0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true while statement II is false. It's clear from the picture below that $F$  assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/81/818ad935fd7aa592f00c23c9c77799d127449b4bb6ffacee4354e7acf39887d8.png)\n\nSo, ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- Statement III is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/70/70e268a08195a92573f41927ae7de653837fca273f0c75cb951243a31ec660a2.png)\n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bd4d08a8-464b-5031-bdac-129c93989f3b"] :db/ensure [:question/validate]} {:db/id "answer-field-bd4d08a8-464b-5031-bdac-129c93989f3b" :answer-field/id #uuid "bd4d08a8-464b-5031-bdac-129c93989f3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8fd73072-7917-5f86-99a8-41ee2a588608" :answer-field/choices ["answer-8fd73072-7917-5f86-99a8-41ee2a588608" "answer-c0b28b0e-b9f8-552a-97a2-7b024eb7c68b" "answer-d214a18a-5783-55d2-8cad-8aa1d708bdea" "answer-944d538b-b3a1-5009-9ca2-782affab4ee6" "answer-2569d358-b974-5ab3-bc46-887feb8dc1c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8fd73072-7917-5f86-99a8-41ee2a588608" :answer/id #uuid "8fd73072-7917-5f86-99a8-41ee2a588608" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-c0b28b0e-b9f8-552a-97a2-7b024eb7c68b" :answer/id #uuid "c0b28b0e-b9f8-552a-97a2-7b024eb7c68b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d214a18a-5783-55d2-8cad-8aa1d708bdea" :answer/id #uuid "d214a18a-5783-55d2-8cad-8aa1d708bdea" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-944d538b-b3a1-5009-9ca2-782affab4ee6" :answer/id #uuid "944d538b-b3a1-5009-9ca2-782affab4ee6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-2569d358-b974-5ab3-bc46-887feb8dc1c0" :answer/id #uuid "2569d358-b974-5ab3-bc46-887feb8dc1c0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-e8382e90-f8cf-5c02-a1ba-6dd0a94124ee" :question/id #uuid "e8382e90-f8cf-5c02-a1ba-6dd0a94124ee" :question/math-academy-id "q-125502" :question/problem "![](images/8a/8aed400e7768b70f4532642418d83b36d9e32aa84db87c71ea6d902504930bc4.png)\n\nConsider the vector field $F(x,y)$ shown above, and let $C$ be the path where the semiellipse is traversed from $A$ to $B.$ Which of the following statements are true?\n\nI. ${\\int }_{C}F\\cdot \\text{d}r>0$\n\nII. ${\\int }_{C}F\\cdot \\text{d}r=0$\n\nIII. ${\\int }_{-C}F\\cdot \\text{d}r=0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion  of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. Since the force $F$ acts perpendicular to the motion of the particle as it moves from $A$ to $B,$ it neither helps nor hinders its motion. \n\n![](images/d8/d8e05de34bf9ddfdbf9580b1df32eb9e091f56f76ac3616cbb1cd81d5d212a86.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r=0.$\n\n- Statement III is true. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/17/17423916013677c1476df5a4368ab9eec81671b04b4ca29a0e702b20ddc818f2.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-abe81e71-7378-51b7-8cd0-c1c7afdebd22"] :db/ensure [:question/validate]} {:db/id "answer-field-abe81e71-7378-51b7-8cd0-c1c7afdebd22" :answer-field/id #uuid "abe81e71-7378-51b7-8cd0-c1c7afdebd22" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ffd8d63f-35ce-5d33-8f42-afecc9c28f08" :answer-field/choices ["answer-37c513f0-8e53-5681-addf-29a9147b60ee" "answer-7e0dedae-2946-5360-b334-0d9616cd33c1" "answer-ffd8d63f-35ce-5d33-8f42-afecc9c28f08" "answer-9c162211-9ea9-54bb-9f45-d836755b653f" "answer-727c6d10-f05b-51c9-89d4-2264deae7ee0"] :db/ensure [:answer-field/validate]} {:db/id "answer-37c513f0-8e53-5681-addf-29a9147b60ee" :answer/id #uuid "37c513f0-8e53-5681-addf-29a9147b60ee" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7e0dedae-2946-5360-b334-0d9616cd33c1" :answer/id #uuid "7e0dedae-2946-5360-b334-0d9616cd33c1" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-ffd8d63f-35ce-5d33-8f42-afecc9c28f08" :answer/id #uuid "ffd8d63f-35ce-5d33-8f42-afecc9c28f08" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9c162211-9ea9-54bb-9f45-d836755b653f" :answer/id #uuid "9c162211-9ea9-54bb-9f45-d836755b653f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-727c6d10-f05b-51c9-89d4-2264deae7ee0" :answer/id #uuid "727c6d10-f05b-51c9-89d4-2264deae7ee0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} [:db/retract 17592186105352 :answer-field/choices 17592186105354] [:db/retract 17592186105352 :answer-field/choices 17592186105356] [:db/retract 17592186105352 :answer-field/choices 17592186105357] {:db/id 17592186105843 :knowledge-point/questions ["question-dd1b71b5-3284-5639-806c-2226f712ef21" "question-501956c6-823d-5f9c-8694-d92497158079"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105680 :question/worked-solution "- A stretch in the $x$-direction of factor $4$ can be represented by the function\n\n$$\n(x,y)\\mapsto (4x,y).\n$$\n\n- A stretch in the $y$-direction of factor $\\dfrac 1 4$ can be represented by the function \n\n$$\n(x,y)\\mapsto \\left(x,\\dfrac 1 4y\\right).\n$$\n\nTherefore, the combination of the stretches is given by\n\n$$\n(x,y)\\mapsto \\left(4x,\\dfrac 1 4y\\right).\n$$" :db/ensure [:question/validate]} {:db/id 17592186105844 :knowledge-point/questions ["question-758a989a-3043-5362-867a-7a0673f17cc3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105681 :question/problem "The point $(2,5)$ is stretched with invariant $y$-axis and stretch factor $2,$ and then stretched with invariant $x$-axis and stretch factor $-2.$ What is the resulting point?" :question/worked-solution "Let's apply the given transformation.\n\n- A stretch of factor $2$ and invariant $y$-axis can be represented by the function\n\n$$\n(x,y) \\mapsto \\left(2x,y\\right).\n$$\n\n- A stretch of factor $-2$ and invariant $x$-axis can be represented by the function\n\n$$\n(x,y) \\mapsto \\left(x,-2y\\right).\n$$\n\nTherefore, the combination of the stretches is given by\n\n$$\n(x,y) \\mapsto \\left({\\color{blue}2}x,{\\color{red}-2}y\\right).\n$$\n\nApplying the combined stretch to our point, we obtain\n\n$$\n(2,5) \\mapsto \\left(2\\cdot 2, \\, -2\\cdot5 \\right) = (4,-10).\n$$\n\n![](images/0d/0d050ec1579f2ea2b37c01f2d7b60fd6580b6bc4766fcdd66005e1c2c103b8c7.png)" :db/ensure [:question/validate]} {:db/id 17592186105842 :knowledge-point/questions ["question-1c9a7b3c-46d7-5715-a15a-49321cace888" "question-63c2d1f3-bff7-58f3-9c73-044cb81121d6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105679 :question/worked-solution "To stretch a polygon, we \n\n- find the images of the vertices, and then\n\n- draw segments connecting the image vertices.\n\nSo, our three vertices $(2,1)$, $(4,1)$, $(2,2)$ are mapped to the following points by the stretch:\n\n$$\n\\begin{aligned}(2,1) & ↦(\\frac{3}{2}\\cdot 2,\\,2\\cdot 1)=(3,2) \\\\ (4,1) & ↦(\\frac{3}{2}\\cdot 4,\\,2\\cdot 1)=(6,2) \\\\ (2,2) & ↦(\\frac{3}{2}\\cdot 2,\\,2\\cdot 2)=(3,4)\\end{aligned}\n$$\n\nTherefore, we obtain the following result:\n\n![](images/b9/b961a446536bddbe6ff529e7ca2973c8e957c185ef4d6f00b9255d09baa9d3cc.png)" :db/ensure [:question/validate]} {:db/id "question-dd1b71b5-3284-5639-806c-2226f712ef21" :question/id #uuid "dd1b71b5-3284-5639-806c-2226f712ef21" :question/math-academy-id "q-88759" :question/problem "What function represents a stretch of factor $5$ and invariant $x$-axis, followed by a stretch of factor $2$ and invariant $y$-axis?" :question/worked-solution "- A stretch of factor $5$ and invariant $x$-axis can be represented by the function\n\n$$\n(x,y)↦(x,5y).\n$$\n\n- A stretch of factor $2$ and invariant $y$-axis can be represented by the function\n\n$$\n(x,y)↦(2x,y).\n$$\n\nTherefore, the combination of the stretches is given by\n\n$$\n(x,y)↦(2x,5y).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1736b26d-c788-5e6f-a118-e706913fe93b"] :db/ensure [:question/validate]} {:db/id "answer-field-1736b26d-c788-5e6f-a118-e706913fe93b" :answer-field/id #uuid "1736b26d-c788-5e6f-a118-e706913fe93b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84e5e9a1-8e72-51e7-beea-35ed9007c1c3" :answer-field/choices ["answer-84e5e9a1-8e72-51e7-beea-35ed9007c1c3" "answer-3497c86f-9024-5137-b2c8-e6adf9725485" "answer-4982073b-5efe-5343-96ae-651ab5588fb4" "answer-8c35c4d1-88a9-5e67-8726-07d37cd1ee31" "answer-2e2598ef-553f-5520-951f-18966c644f5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-84e5e9a1-8e72-51e7-beea-35ed9007c1c3" :answer/id #uuid "84e5e9a1-8e72-51e7-beea-35ed9007c1c3" :answer/type :answer.type/math :answer/value "(x,y)↦(2x,5y)" :db/ensure [:answer/validate]} {:db/id "answer-3497c86f-9024-5137-b2c8-e6adf9725485" :answer/id #uuid "3497c86f-9024-5137-b2c8-e6adf9725485" :answer/type :answer.type/math :answer/value "(x,y)↦(5x,2y)" :db/ensure [:answer/validate]} {:db/id "answer-4982073b-5efe-5343-96ae-651ab5588fb4" :answer/id #uuid "4982073b-5efe-5343-96ae-651ab5588fb4" :answer/type :answer.type/math :answer/value "(x,y)↦(x+2,y+5)" :db/ensure [:answer/validate]} {:db/id "answer-8c35c4d1-88a9-5e67-8726-07d37cd1ee31" :answer/id #uuid "8c35c4d1-88a9-5e67-8726-07d37cd1ee31" :answer/type :answer.type/math :answer/value "(x,y)↦(x+5,y+2)" :db/ensure [:answer/validate]} {:db/id "answer-2e2598ef-553f-5520-951f-18966c644f5e" :answer/id #uuid "2e2598ef-553f-5520-951f-18966c644f5e" :answer/type :answer.type/math :answer/value "(x,y)↦(x,5y)" :db/ensure [:answer/validate]} {:db/id "question-501956c6-823d-5f9c-8694-d92497158079" :question/id #uuid "501956c6-823d-5f9c-8694-d92497158079" :question/math-academy-id "q-88610" :question/problem "What function represents a stretch of factor $4$ and invariant $x$-axis, followed by a stretch of factor $3$ and invariant $y$-axis?" :question/worked-solution "- A stretch of factor $4$ and invariant $x$-axis can be represented by the function\n\n$$\n(x,y)↦(x,4y).\n$$\n\n- A stretch of factor $3$ and invariant $y$-axis can be represented by the function\n\n$$\n(x,y)↦(3x,y).\n$$\n\nTherefore, the combination of the stretches is given by\n\n$$\n(x,y)↦(3x,4y).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ff7570d2-23c8-593e-ae05-f7eefecf996a"] :db/ensure [:question/validate]} {:db/id "answer-field-ff7570d2-23c8-593e-ae05-f7eefecf996a" :answer-field/id #uuid "ff7570d2-23c8-593e-ae05-f7eefecf996a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-29faaffe-98fa-5db1-917a-0be3d37da2a8" :answer-field/choices ["answer-29faaffe-98fa-5db1-917a-0be3d37da2a8" "answer-c2f2a443-9d68-52a6-97a1-f6b7ae598ff4" "answer-c4841df8-55cd-574b-95b3-f90d508b11f3" "answer-1f295345-6a68-5dab-b6a6-eb286ab41b2c" "answer-127c4155-1f19-5cc4-9c19-a0d3041bb683"] :db/ensure [:answer-field/validate]} {:db/id "answer-29faaffe-98fa-5db1-917a-0be3d37da2a8" :answer/id #uuid "29faaffe-98fa-5db1-917a-0be3d37da2a8" :answer/type :answer.type/math :answer/value "(x,y)↦(3x,4y)" :db/ensure [:answer/validate]} {:db/id "answer-c2f2a443-9d68-52a6-97a1-f6b7ae598ff4" :answer/id #uuid "c2f2a443-9d68-52a6-97a1-f6b7ae598ff4" :answer/type :answer.type/math :answer/value "(x,y)↦(3x,y)" :db/ensure [:answer/validate]} {:db/id "answer-c4841df8-55cd-574b-95b3-f90d508b11f3" :answer/id #uuid "c4841df8-55cd-574b-95b3-f90d508b11f3" :answer/type :answer.type/math :answer/value "(x,y)↦(4x,3y)" :db/ensure [:answer/validate]} {:db/id "answer-1f295345-6a68-5dab-b6a6-eb286ab41b2c" :answer/id #uuid "1f295345-6a68-5dab-b6a6-eb286ab41b2c" :answer/type :answer.type/math :answer/value "(x,y)↦(4x,y)" :db/ensure [:answer/validate]} {:db/id "answer-127c4155-1f19-5cc4-9c19-a0d3041bb683" :answer/id #uuid "127c4155-1f19-5cc4-9c19-a0d3041bb683" :answer/type :answer.type/math :answer/value "(x,y)↦(x,4y)" :db/ensure [:answer/validate]} {:db/id 17592186106534 :question/problem "The point $(4,2)$ is stretched with invariant $y$-axis and stretch factor $2,$ and then stretched with invariant $x$-axis and stretch factor $-3.$ What is the resulting point?" :question/worked-solution "Let's apply the given transformation.\n\n- A stretch of factor $2$ and invariant $y$-axis can be represented by the function\n\n$$\n(x,y)↦(2x,y).\n$$\n\n- A stretch of factor $-3$ and invariant $x$-axis can be represented by the function\n\n$$\n(x,y)↦(x,-3y).\n$$\n\nTherefore, the combination of the stretches is given by\n\n$$\n(x,y)↦(2x,-3y).\n$$\n\nApplying the combined stretch to our point, we obtain\n\n$$\n(4,2)↦(2\\cdot 4,\\,-3\\cdot 2)=(8,-6).\n$$\n\n![](images/ab/ab3fda7652a99346f6d33e11b43d3401e2a427ab6d2f54c0f8717733fb3f892c.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186105352 :answer-field/correct 17592186105353 :answer-field/choices ["answer-4f90ff09-0b90-5a43-aeef-b149ae5cc47f" "answer-23bd6a64-92c7-5a5d-a870-0e7c3474eddb" "answer-aac6e0c5-e450-5a3c-b210-84f3ab8b09c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f90ff09-0b90-5a43-aeef-b149ae5cc47f" :answer/id #uuid "4f90ff09-0b90-5a43-aeef-b149ae5cc47f" :answer/type :answer.type/math :answer/value "(-8,6)" :db/ensure [:answer/validate]} {:db/id "answer-23bd6a64-92c7-5a5d-a870-0e7c3474eddb" :answer/id #uuid "23bd6a64-92c7-5a5d-a870-0e7c3474eddb" :answer/type :answer.type/math :answer/value "(4,12)" :db/ensure [:answer/validate]} {:db/id "answer-aac6e0c5-e450-5a3c-b210-84f3ab8b09c4" :answer/id #uuid "aac6e0c5-e450-5a3c-b210-84f3ab8b09c4" :answer/type :answer.type/math :answer/value "(8,6)" :db/ensure [:answer/validate]} {:db/id "question-758a989a-3043-5362-867a-7a0673f17cc3" :question/id #uuid "758a989a-3043-5362-867a-7a0673f17cc3" :question/math-academy-id "q-88767" :question/problem "The point $(5,-5)$ is stretched with invariant $y$-axis and stretch factor $2,$ and then stretched with invariant $x$-axis and stretch factor $2.$ What is the resulting point?" :question/worked-solution "Let's apply the given transformation.\n\n- A stretch of factor $2$ and invariant $y$-axis can be represented by the function\n\n$$\n(x,y)↦(2x,y).\n$$\n\n- A stretch of factor $2$ and invariant $x$-axis can be represented by the function\n\n$$\n(x,y)↦(x,2y).\n$$\n\nTherefore, the combination of the stretches is given by\n\n$$\n(x,y)↦(2x,2y).\n$$\n\nApplying the combined stretch to our point, we obtain\n\n$$\n(5,-5)↦(2\\cdot 5,\\,2\\cdot (-5))=(10,-10).\n$$\n\n![](images/8e/8e3eccf9b9190db3c19e2d49d633763d420947daa12929a8516fcf066465165d.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9119a8a3-997b-5c35-bcb5-0ad9de0ba66d"] :db/ensure [:question/validate]} {:db/id "answer-field-9119a8a3-997b-5c35-bcb5-0ad9de0ba66d" :answer-field/id #uuid "9119a8a3-997b-5c35-bcb5-0ad9de0ba66d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8928c1b-b157-5390-b635-b1b7ade3cde5" :answer-field/choices ["answer-557eab86-52f5-5159-b8ac-f4a8b98acf3f" "answer-c8928c1b-b157-5390-b635-b1b7ade3cde5" "answer-acda96ba-19db-5933-a31e-fe52d93e2788" "answer-658c09db-7834-5584-8ce0-05b1a462f6df" "answer-3659512c-606b-5c80-b2da-172375a8b128"] :db/ensure [:answer-field/validate]} {:db/id "answer-557eab86-52f5-5159-b8ac-f4a8b98acf3f" :answer/id #uuid "557eab86-52f5-5159-b8ac-f4a8b98acf3f" :answer/type :answer.type/math :answer/value "(-10,10)" :db/ensure [:answer/validate]} {:db/id "answer-c8928c1b-b157-5390-b635-b1b7ade3cde5" :answer/id #uuid "c8928c1b-b157-5390-b635-b1b7ade3cde5" :answer/type :answer.type/math :answer/value "(10,-10)" :db/ensure [:answer/validate]} {:db/id "answer-acda96ba-19db-5933-a31e-fe52d93e2788" :answer/id #uuid "acda96ba-19db-5933-a31e-fe52d93e2788" :answer/type :answer.type/math :answer/value "(12,-3)" :db/ensure [:answer/validate]} {:db/id "answer-658c09db-7834-5584-8ce0-05b1a462f6df" :answer/id #uuid "658c09db-7834-5584-8ce0-05b1a462f6df" :answer/type :answer.type/math :answer/value "(20,-5)" :db/ensure [:answer/validate]} {:db/id "answer-3659512c-606b-5c80-b2da-172375a8b128" :answer/id #uuid "3659512c-606b-5c80-b2da-172375a8b128" :answer/type :answer.type/math :answer/value "(5,20)" :db/ensure [:answer/validate]} {:db/id "question-1c9a7b3c-46d7-5715-a15a-49321cace888" :question/id #uuid "1c9a7b3c-46d7-5715-a15a-49321cace888" :question/math-academy-id "q-45448" :question/problem "![](images/9f/9fd4e55e5de09555b5a1fe05f8fb5f47b03d3b0cd9d96cbdca526f0d357d0afb.png)\n\nA stretch of factor $3$ in the $x$-direction and $2$ in the $y$-direction is applied to the polygon shown above. Which of the following is the resulting polygon?" :question/worked-solution "A stretch of factor $3$ in the $x$-direction and $2$ in the $y$-direction can be represented by the following function:\n\n$$\n(x,y)↦(3x,2y)\n$$\n\nTo stretch a polygon, we \n\n- find the images of the vertices, and then\n\n- draw segments connecting the image vertices.\n\nSo, our three vertices $(1,3)$, $(1,-2)$, $(-2,2)$ are mapped to the following points by the stretch:\n\n$$\n\\begin{aligned}(1,3) & ↦(3\\cdot 1,2\\cdot 3)=(3,6) \\\\ (1,-2) & ↦(3\\cdot 1,2\\cdot (-2))=(3,-4) \\\\ (-2,2) & ↦(3\\cdot (-2),2\\cdot 2)=(-6,4)\\end{aligned}\n$$\n\nTherefore, we obtain the following result:\n\n![](images/6c/6c77ca7fa6efa27125c131c629b5afeba784b8ca4fd1039530879c2ec177b8dc.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e8174907-9a6c-5434-be88-361402b60a64"] :db/ensure [:question/validate]} {:db/id "answer-field-e8174907-9a6c-5434-be88-361402b60a64" :answer-field/id #uuid "e8174907-9a6c-5434-be88-361402b60a64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ffdb2a34-d0f3-5827-8225-39b57eb2abab" :answer-field/choices ["answer-db730826-ef16-5c39-810b-7a3e33ae4b3e" "answer-36a238a9-2b8f-567b-ad80-f0ef6c09bdac" "answer-aec615b7-c75a-5947-b8d9-82deedc574e1" "answer-d6050368-ce12-5a9c-8193-7fed60bb845a" "answer-ffdb2a34-d0f3-5827-8225-39b57eb2abab"] :db/ensure [:answer-field/validate]} {:db/id "answer-db730826-ef16-5c39-810b-7a3e33ae4b3e" :answer/id #uuid "db730826-ef16-5c39-810b-7a3e33ae4b3e" :answer/type :answer.type/image :answer/value "images/34/340fd3449d3c0ca638fd0ed214e88fce3dfb70f5625e7944b64136a6c240bc65.png" :db/ensure [:answer/validate]} {:db/id "answer-36a238a9-2b8f-567b-ad80-f0ef6c09bdac" :answer/id #uuid "36a238a9-2b8f-567b-ad80-f0ef6c09bdac" :answer/type :answer.type/image :answer/value "images/3c/3c0fa57f821f0970652cc9c7cfd29c0bf84c86d9cf312092a4ae620cf23f9c0c.png" :db/ensure [:answer/validate]} {:db/id "answer-aec615b7-c75a-5947-b8d9-82deedc574e1" :answer/id #uuid "aec615b7-c75a-5947-b8d9-82deedc574e1" :answer/type :answer.type/image :answer/value "images/41/41d19c613c87d03a27d223b273de252d204ef4bdae9bbef9ccdb7a6b9a052799.png" :db/ensure [:answer/validate]} {:db/id "answer-d6050368-ce12-5a9c-8193-7fed60bb845a" :answer/id #uuid "d6050368-ce12-5a9c-8193-7fed60bb845a" :answer/type :answer.type/image :answer/value "images/90/9026ba33e157b287501339fb6978b2ccb6704af2e973211f9212c6f800fc6f23.png" :db/ensure [:answer/validate]} {:db/id "answer-ffdb2a34-d0f3-5827-8225-39b57eb2abab" :answer/id #uuid "ffdb2a34-d0f3-5827-8225-39b57eb2abab" :answer/type :answer.type/image :answer/value "images/f1/f101601f17806447c06e1c876f3beb92d5fa97bf9019cbea86f0496f56b1fb37.png" :db/ensure [:answer/validate]} {:db/id "question-63c2d1f3-bff7-58f3-9c73-044cb81121d6" :question/id #uuid "63c2d1f3-bff7-58f3-9c73-044cb81121d6" :question/math-academy-id "q-45450" :question/problem "![](images/76/7625ed8002bbd684ba004185f357e8b8e9b3384857684ef836ccd4a019a317cd.png)\n\nThe stretch $S(x,y)=(\\frac{1}{2}x,\\frac{1}{3}y)$ is applied to the polygon shown above. Which of the following is the resulting polygon?" :question/worked-solution "To stretch a polygon, we \n\n- find the images of the vertices, and then\n\n- draw segments connecting the image vertices.\n\nSo, our three vertices $(4,6)$, $(5,-3)$, $(-6,-6)$ are mapped to the following points by the stretch:\n\n$$\n\\begin{aligned}(4,6) & ↦(\\frac{1}{2}\\cdot 4,\\,\\frac{1}{3}\\cdot 6)=(2,2) \\\\ (6,-3) & ↦(\\frac{1}{2}\\cdot 6,\\,\\frac{1}{3}\\cdot (-3))=(3,-1) \\\\ (-6,-6) & ↦(\\frac{1}{2}\\cdot (-6),\\,\\frac{1}{3}\\cdot (-6))=(-3,-2)\\end{aligned}\n$$\n\nTherefore, we obtain the following result:\n\n![](images/aa/aa9f0b7c785c5c830c0e902f500fe0998df4c4ee8ace07af6989cf9aad2a88ea.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-20836d9f-5b2c-5007-984d-6198830d570b"] :db/ensure [:question/validate]} {:db/id "answer-field-20836d9f-5b2c-5007-984d-6198830d570b" :answer-field/id #uuid "20836d9f-5b2c-5007-984d-6198830d570b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0b01cf01-6055-5206-8628-9df03691af89" :answer-field/choices ["answer-0b01cf01-6055-5206-8628-9df03691af89" "answer-6b5b02cb-0bdf-5f7c-b77e-43fafe31913a" "answer-c118275d-2f2f-56fb-b192-cf9482e8d88e" "answer-cf0bc394-3fcc-570c-803b-19a1df9fee48" "answer-be4c840b-bbd5-502e-bbc6-846b75b62a3c"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b01cf01-6055-5206-8628-9df03691af89" :answer/id #uuid "0b01cf01-6055-5206-8628-9df03691af89" :answer/type :answer.type/image :answer/value "images/36/36e66a86bca25711839b36dd2597d8b8b96c5a9c531c6fa77ee8a13dec831d41.png" :db/ensure [:answer/validate]} {:db/id "answer-6b5b02cb-0bdf-5f7c-b77e-43fafe31913a" :answer/id #uuid "6b5b02cb-0bdf-5f7c-b77e-43fafe31913a" :answer/type :answer.type/image :answer/value "images/5b/5b4e9383b4264089dc6880e28c16e29b358134e67b6265fc0dfeb76559e6abb9.png" :db/ensure [:answer/validate]} {:db/id "answer-c118275d-2f2f-56fb-b192-cf9482e8d88e" :answer/id #uuid "c118275d-2f2f-56fb-b192-cf9482e8d88e" :answer/type :answer.type/image :answer/value "images/88/88d18cd1bdbcf7cbe3eb50864607632380a3a1bb8f3271e17f857303742e9615.png" :db/ensure [:answer/validate]} {:db/id "answer-cf0bc394-3fcc-570c-803b-19a1df9fee48" :answer/id #uuid "cf0bc394-3fcc-570c-803b-19a1df9fee48" :answer/type :answer.type/image :answer/value "images/bd/bdc4d5b733df0f7293224cf26f9eacc675c248004ceeb74717bdcb3cc88f8010.png" :db/ensure [:answer/validate]} {:db/id "answer-be4c840b-bbd5-502e-bbc6-846b75b62a3c" :answer/id #uuid "be4c840b-bbd5-502e-bbc6-846b75b62a3c" :answer/type :answer.type/image :answer/value "images/e7/e70b2a1569a5b46118ce4ae169a163c02ed4e34fdba27f4c2f16f0e7e1c0896e.png" :db/ensure [:answer/validate]} {:db/id 17592186107117 :tutorial/content "We can combine stretches in the $x$-direction (with invariant $y$-axis) and stretches in the $y$-direction (with invariant $x$-axis).\n\nFor example, let's consider a combined stretch transformation that performs stretches in the following sequence:\n\n- a stretch in the $x$-direction with stretch factor $\\dfrac{1}{2},$ followed by\n\n- a stretch in the $y$-direction with stretch factor $-\\dfrac{1}{2}.$\n\nThe functional representation of the combined stretch is given by\n\n$$\n(x,y) \\mapsto \\left(\\dfrac{1}{2}x, -\\dfrac{1}{2}y\\right).\n$$\n\nAs it turns out, it does not matter which stretch we perform first. But it's often helpful to think of the stretches being applied one at a time.\n\nLet's apply our combined stretch transformation to the polygon below.\n\n![](images/9b/9b0338a600efa76b14397a4d60b6de500daf4e136b2233b6fa4f021f0861fc24.png)\n\nTo stretch a polygon, we \n\n- find the images of the vertices, and then\n\n- draw segments connecting the image vertices.\n\nSo, our three vertices $(4,8)$, $(8,-4)$, $(-8,-8)$ are mapped to the following points by the stretch:\n\n$$\n\\begin{aligned}(4,8) & ↦(\\frac{1}{2}\\cdot 4,\\,-\\frac{1}{2}\\cdot 8)=(2,-4) \\\\ (8,-4) & ↦(\\frac{1}{2}\\cdot 8,\\,-\\frac{1}{2}\\cdot (-4))=(4,2) \\\\ (-8,-8) & ↦(\\frac{1}{2}\\cdot (-8),\\,-\\frac{1}{2}\\cdot (-8))=(-4,4)\\end{aligned}\n$$\n\nTherefore, we obtain the following result:\n\n![](images/ec/ecc35921e58a7a307fe941825209e0009ff7a1bdb42fc252c2b7ef6db7876e75.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186105996 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186228132 :answer-field/choices 17592186228133] [:db/retract 17592186228132 :answer-field/choices 17592186228134] [:db/retract 17592186228132 :answer-field/choices 17592186228135] [:db/retract 17592186228132 :answer-field/choices 17592186228136] [:db/retract 17592186228132 :answer-field/choices 17592186228137] [:db/retract 17592186311215 :answer-field/choices 17592186310496] [:db/retract 17592186311108 :answer-field/choices 17592186309223] [:db/retract 17592186311175 :answer-field/choices 17592186309321] [:db/retract 17592186311499 :answer-field/choices 17592186310572] [:db/retract 17592186311264 :answer-field/choices 17592186310311] [:db/retract 17592186311010 :answer-field/choices 17592186309810] {:db/id 17592186229657 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2y(t) \\\\ {y}^{′}(t)=2x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ -3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}].\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}][\\begin{aligned}0 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186228132 :answer-field/correct "answer-70233942-007a-5043-b53a-395ec3709d87" :answer-field/choices ["answer-70233942-007a-5043-b53a-395ec3709d87" "answer-2826f3b3-aa19-5166-9709-c29a10e19d9b" "answer-5075de84-7cd8-5fc4-90bb-1cd990dbc9ed" "answer-c1df0fbb-0a33-5bd3-9288-292dffd71dcd" "answer-4c00ea3b-3ce4-5e0c-8832-b95dc6c0a81b"] :db/ensure [:answer-field/validate]} {:db/id "answer-70233942-007a-5043-b53a-395ec3709d87" :answer/id #uuid "70233942-007a-5043-b53a-395ec3709d87" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2826f3b3-aa19-5166-9709-c29a10e19d9b" :answer/id #uuid "2826f3b3-aa19-5166-9709-c29a10e19d9b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3\\operatorname{sinh}⁡(2t) \\\\ 3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-5075de84-7cd8-5fc4-90bb-1cd990dbc9ed" :answer/id #uuid "5075de84-7cd8-5fc4-90bb-1cd990dbc9ed" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c1df0fbb-0a33-5bd3-9288-292dffd71dcd" :answer/id #uuid "c1df0fbb-0a33-5bd3-9288-292dffd71dcd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4c00ea3b-3ce4-5e0c-8832-b95dc6c0a81b" :answer/id #uuid "4c00ea3b-3ce4-5e0c-8832-b95dc6c0a81b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\operatorname{sinh}⁡(2t) \\\\ -3\\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186229144 :knowledge-point/questions ["question-530f8a57-b248-5ddf-8ae9-a8b808f3a729"] :db/ensure [:knowledge-point/validate]} {:db/id "question-530f8a57-b248-5ddf-8ae9-a8b808f3a729" :question/id #uuid "530f8a57-b248-5ddf-8ae9-a8b808f3a729" :question/math-academy-id "q-335435" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-5y(t) \\\\ {y}^{′}(t)=5x(t),\\end{aligned}\\,[\\begin{aligned}x(-2) \\\\ y(-2)\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(5t) & -\\operatorname{sin}⁡(5t) \\\\ \\operatorname{sin}⁡(5t) & \\operatorname{cos}⁡(5t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"130px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & -5 \\\\ 5 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t+2)}\\,x(-2) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(5(t+2)) & -\\operatorname{sin}⁡(5(t+2)) \\\\ \\operatorname{sin}⁡(5(t+2)) & \\operatorname{cos}⁡(5(t+2))\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\,\\operatorname{cos}⁡(5(t+2))\\, \\\\ \\,\\operatorname{sin}⁡(5(t+2))\\,\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4e339ad0-7370-56ee-a106-ae32b1e3a838" "answer-field-b890faf2-939e-5590-92f1-af9dc867356d"] :db/ensure [:question/validate]} {:db/id "answer-field-4e339ad0-7370-56ee-a106-ae32b1e3a838" :answer-field/id #uuid "4e339ad0-7370-56ee-a106-ae32b1e3a838" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-68733ae1-b610-5dd9-b95d-12135f00648e" :answer-field/choices ["answer-68733ae1-b610-5dd9-b95d-12135f00648e"] :db/ensure [:answer-field/validate]} {:db/id "answer-68733ae1-b610-5dd9-b95d-12135f00648e" :answer/id #uuid "68733ae1-b610-5dd9-b95d-12135f00648e" :answer/type :answer.type/math :answer/value "\\cos(5(t+2))" :db/ensure [:answer/validate]} {:db/id "answer-field-b890faf2-939e-5590-92f1-af9dc867356d" :answer-field/id #uuid "b890faf2-939e-5590-92f1-af9dc867356d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4db09dc0-d4c5-5e09-a70f-eae2e3269be4" :answer-field/choices ["answer-4db09dc0-d4c5-5e09-a70f-eae2e3269be4"] :db/ensure [:answer-field/validate]} {:db/id "answer-4db09dc0-d4c5-5e09-a70f-eae2e3269be4" :answer/id #uuid "4db09dc0-d4c5-5e09-a70f-eae2e3269be4" :answer/type :answer.type/math :answer/value "\\sin(5(t+2))" :db/ensure [:answer/validate]} {:db/id 17592186311215 :answer-field/correct 17592186309355 :db/ensure [:answer-field/validate]} {:db/id 17592186311108 :answer-field/correct 17592186308966 :db/ensure [:answer-field/validate]} {:db/id 17592186311175 :answer-field/correct 17592186309685 :db/ensure [:answer-field/validate]} {:db/id 17592186311499 :answer-field/correct 17592186310038 :db/ensure [:answer-field/validate]} {:db/id 17592186311264 :answer-field/correct 17592186309536 :db/ensure [:answer-field/validate]} {:db/id 17592186311010 :answer-field/correct 17592186309700 :db/ensure [:answer-field/validate]} {:db/id "activity-cbc6fbed-6e86-5dc3-b2c1-9930dc5f3f8a" :activity/id #uuid "cbc6fbed-6e86-5dc3-b2c1-9930dc5f3f8a" 