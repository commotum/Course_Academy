tion/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{4}{3}{y}^{7}\\,\\text{d}y & =\\frac{4}{3}\\int {y}^{7}\\,\\text{d}y \\\\  & =\\frac{4}{3}(\\frac{{y}^{7+1}}{7+1})+C \\\\  & =\\frac{4}{3}\\cdot \\frac{{y}^{8}}{8}+C \\\\  & =\\frac{{y}^{8}}{6}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3c95a3e3-069c-5ec3-b88e-edd9bad2a80d"] :db/ensure [:question/validate]} {:db/id "answer-field-3c95a3e3-069c-5ec3-b88e-edd9bad2a80d" :answer-field/id #uuid "3c95a3e3-069c-5ec3-b88e-edd9bad2a80d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer-field/choices ["answer-8cd65e72-3b80-534f-8810-88f5e53d25aa" "answer-fabcfbb7-87ed-59c3-875b-7c9ddc058fe8" "answer-bbaf516e-8b25-5de2-a3f1-8ece4f6fd9ae" "answer-ce3c6810-8d96-5dbe-8d24-a6ff93cac7f1" "answer-0aa7dce6-df1a-5088-806d-df25a6f8ac37"] :db/ensure [:answer-field/validate]} {:db/id "answer-8cd65e72-3b80-534f-8810-88f5e53d25aa" :answer/id #uuid "8cd65e72-3b80-534f-8810-88f5e53d25aa" :answer/type :answer.type/math :answer/value "\\frac{3{y}^{8}}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-fabcfbb7-87ed-59c3-875b-7c9ddc058fe8" :answer/id #uuid "fabcfbb7-87ed-59c3-875b-7c9ddc058fe8" :answer/type :answer.type/math :answer/value "\\frac{{y}^{6}}{3}+C" :db/ensure [:answer/validate]} {:db/id "answer-bbaf516e-8b25-5de2-a3f1-8ece4f6fd9ae" :answer/id #uuid "bbaf516e-8b25-5de2-a3f1-8ece4f6fd9ae" :answer/type :answer.type/math :answer/value "\\frac{{y}^{6}}{8}+C" :db/ensure [:answer/validate]} {:db/id "answer-ce3c6810-8d96-5dbe-8d24-a6ff93cac7f1" :answer/id #uuid "ce3c6810-8d96-5dbe-8d24-a6ff93cac7f1" :answer/type :answer.type/math :answer/value "\\frac{{y}^{8}}{2}+C" :db/ensure [:answer/validate]} {:db/id "answer-0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer/id #uuid "0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer/type :answer.type/math :answer/value "\\frac{{y}^{8}}{6}+C" :db/ensure [:answer/validate]} {:db/id "question-8a064553-8bcb-586c-b022-5e4a307bf7cb" :question/id #uuid "8a064553-8bcb-586c-b022-5e4a307bf7cb" :question/math-academy-id "q-113732" :question/problem "Calculate $\\int \\frac{4}{{z}^{4}}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{{z}^{4}}\\,\\text{d}z & =4\\int {z}^{-4}\\,\\text{d}z \\\\  & =4\\cdot (\\frac{{z}^{-4+1}}{-4+1})+C \\\\  & =4\\cdot (\\frac{{z}^{-3}}{-3})+C \\\\  & =-\\frac{4}{3}\\cdot {z}^{-3}+C \\\\  & =-\\frac{4}{3{z}^{3}}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-986e5def-75c9-5fb2-b0cd-ce6e4f5db7e6"] :db/ensure [:question/validate]} {:db/id "answer-field-986e5def-75c9-5fb2-b0cd-ce6e4f5db7e6" :answer-field/id #uuid "986e5def-75c9-5fb2-b0cd-ce6e4f5db7e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer-field/choices ["answer-524c97c6-03f8-598a-8c7c-ea2d3d324912" "answer-763e5a13-a335-5cdf-a259-7426bf657fec" "answer-ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" "answer-3a676b7a-83f4-580e-bc68-198c1d310014" "answer-c1384251-11ce-53fe-90e4-87749a27be70"] :db/ensure [:answer-field/validate]} {:db/id "answer-524c97c6-03f8-598a-8c7c-ea2d3d324912" :answer/id #uuid "524c97c6-03f8-598a-8c7c-ea2d3d324912" :answer/type :answer.type/math :answer/value "-\\frac{1}{12{z}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "answer-763e5a13-a335-5cdf-a259-7426bf657fec" :answer/id #uuid "763e5a13-a335-5cdf-a259-7426bf657fec" :answer/type :answer.type/math :answer/value "-\\frac{3}{{z}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "answer-ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer/id #uuid "ddebe549-4054-5e6e-aaa8-0ecca