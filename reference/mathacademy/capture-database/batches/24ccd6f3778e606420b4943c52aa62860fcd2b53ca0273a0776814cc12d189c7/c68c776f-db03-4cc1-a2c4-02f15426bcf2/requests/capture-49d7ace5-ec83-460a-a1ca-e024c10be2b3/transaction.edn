er-field/type :answer-field.type/radio :answer-field/correct "answer-42ef3ad1-b4c6-531e-b84c-48a55056695b" :answer-field/choices ["answer-8e1267a6-c309-57ed-a173-cc4e435b75a9" "answer-42ef3ad1-b4c6-531e-b84c-48a55056695b" "answer-67861f1d-57dc-59c5-b797-379414b570f0" "answer-565f0406-7dec-56e6-8cea-ffdc6a0be4df" "answer-f1af3e8b-ee4a-5778-b989-55dfc4905656"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e1267a6-c309-57ed-a173-cc4e435b75a9" :answer/id #uuid "8e1267a6-c309-57ed-a173-cc4e435b75a9" :answer/type :answer.type/image :answer/value "images/55/5524f1c7273ce34497eef45c424321e7c6909bd253a8e4ab841e3bf69c5f1062.png" :db/ensure [:answer/validate]} {:db/id "answer-42ef3ad1-b4c6-531e-b84c-48a55056695b" :answer/id #uuid "42ef3ad1-b4c6-531e-b84c-48a55056695b" :answer/type :answer.type/image :answer/value "images/74/74d8f90fd8cdfe0e92c5cdf2adc2565fb52bf23ba38a0e6ce492f0c85d5ed796.png" :db/ensure [:answer/validate]} {:db/id "answer-67861f1d-57dc-59c5-b797-379414b570f0" :answer/id #uuid "67861f1d-57dc-59c5-b797-379414b570f0" :answer/type :answer.type/image :answer/value "images/7d/7d5670ffe9e70a476015016874d6dc8fe8e1d4190ec30c79633ec07ed93f2499.png" :db/ensure [:answer/validate]} {:db/id "answer-565f0406-7dec-56e6-8cea-ffdc6a0be4df" :answer/id #uuid "565f0406-7dec-56e6-8cea-ffdc6a0be4df" :answer/type :answer.type/image :answer/value "images/b4/b4b73f9f99589ff335b71fccf607b05a14c5323d5733951f8df565f57f4aaea2.png" :db/ensure [:answer/validate]} {:db/id "answer-f1af3e8b-ee4a-5778-b989-55dfc4905656" :answer/id #uuid "f1af3e8b-ee4a-5778-b989-55dfc4905656" :answer/type :answer.type/image :answer/value "images/fa/fae78827c0cb157201285727b2d8ae1097ad8dd8fa64de098e889eba3d72f12d.png" :db/ensure [:answer/validate]} {:db/id "activity-7bdc3b75-905b-5e53-ac66-c0af1a68ed99" :activity/id #uuid "7bdc3b75-905b-5e53-ac66-c0af1a68ed99" :activity/title "Conditional Statements With Predicates" :activity/type :activity.type/review :activity/scope 17592186048574 :activity/course 17592186046658 :activity/steps ["step-0e2b6725-ceb7-511a-9ea0-fbf130e6b8ce" "step-ceeed64c-373d-5d9e-a393-4194a6869a6f" "step-1f22cfa3-1706-5ed4-b34a-d29a0dcfdc50" "step-ef08bcf6-0e5a-5046-9f01-123adfa7f106" "step-96444738-ac4a-5f68-b324-679d6b04ba39"] :activity/first-step "step-0e2b6725-ceb7-511a-9ea0-fbf130e6b8ce" :db/ensure [:activity/validate]} {:db/id "step-0e2b6725-ceb7-511a-9ea0-fbf130e6b8ce" :step/id #uuid "0e2b6725-ceb7-511a-9ea0-fbf130e6b8ce" :step/content "question-76e33b5f-2848-5625-aa9f-8231d4a78a3e" :step/next "step-ceeed64c-373d-5d9e-a393-4194a6869a6f" :db/ensure [:step/validate]} {:db/id "step-ceeed64c-373d-5d9e-a393-4194a6869a6f" :step/id #uuid "ceeed64c-373d-5d9e-a393-4194a6869a6f" :step/content 17592186401749 :step/next "step-1f22cfa3-1706-5ed4-b34a-d29a0dcfdc50" :db/ensure [:step/validate]} {:db/id "step-1f22cfa3-1706-5ed4-b34a-d29a0dcfdc50" :step/id #uuid "1f22cfa3-1706-5ed4-b34a-d29a0dcfdc50" :step/content 17592186415187 :step/next "step-ef08bcf6-0e5a-5046-9f01-123adfa7f106" :db/ensure [:step/validate]} {:db/id "step-ef08bcf6-0e5a-5046-9f01-123adfa7f106" :step/id #uuid "ef08bcf6-0e5a-5046-9f01-123adfa7f106" :step/content 17592186407603 :step/next "step-96444738-ac4a-5f68-b324-679d6b04ba39" :db/ensure [:step/validate]} {:db/id "step-96444738-ac4a-5f68-b324-679d6b04ba39" :step/id #uuid "96444738-ac4a-5f68-b324-679d6b04ba39" :step/content "question-f764222e-7e7e-5e1f-8907-653f8f221162" :db/ensure [:step/validate]} {:db/id 17592186198363 :knowledge-point/questions ["question-d78c4c29-1d34-52bf-9160-d17820674c44" "question-eabf1331-ca5b-594d-af21-53db9e3ebf21"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d78c4c29-1d34-52bf-9160-d17820674c44" :question/id #uuid "d78c4c29-1d34-52bf-9160-d17820674c44" :question/math-academy-id "q-83640" :question/problem "Let $D$ be the finite region bounded by the curve \n${(x+3y)}^{2}+y=5$ and the line $y=4.$ Consider the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere $u=x+3y$ and $v=y.$ Find the representation of ${T}^{-1}(D)$ in the $uv$-plane." :question/worked-solution "First, notice that we are given that \n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+3y \\\\ y\\end{aligned}].\n$$\n\nSubstituting $x+3y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}{(x+3y)}^{2}+y=5\\,⟹\\,{u}^{2}+v=5\\,⟹\\,v=5-{u}^{2},\\end{aligned}\n$$\n\nwhile substituting $y=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}y=4\\,⟹\\,v=4.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}v=5-{u}^{2} \\\\ v=4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}u=\\pm 1 \\\\ v=4.\\end{aligned}\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 1,4).$\n\n![](images/94/9427985b45271bec39577b35334311c11b71983d1cc5f8b9ac35c6fe88f29d98.png)\n\nAs a result, our domain in the $uv$-plane has the type I representation \n\n$$\n{T}^{-1}(D)=\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,4\\le v\\le 5-{u}^{2}\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0ec5b769-0f6c-59ac-907b-1613a4af2250"] :db/ensure [:question/validate]} {:db/id "answer-field-0ec5b769-0f6c-59ac-907b-1613a4af2250" :answer-field/id #uuid "0ec5b769-0f6c-59ac-907b-1613a4af2250" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c14e9d1-1ebc-5911-83b4-6684991c4a5b" :answer-field/choices ["answer-8c14e9d1-1ebc-5911-83b4-6684991c4a5b" "answer-4209f830-c9a8-5754-bc99-a5cd64e9d1e6" "answer-a1308d93-95f0-5ab2-a9e7-6b7e0551f91d" "answer-f4095012-39a4-5bc8-a2ee-c30c5669c7bf" "answer-b29aa89a-331b-5b26-81e9-f1db6a760e94"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c14e9d1-1ebc-5911-83b4-6684991c4a5b" :answer/id #uuid "8c14e9d1-1ebc-5911-83b4-6684991c4a5b" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,4\\le v\\le 5-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-4209f830-c9a8-5754-bc99-a5cd64e9d1e6" :answer/id #uuid "4209f830-c9a8-5754-bc99-a5cd64e9d1e6" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,5-{u}^{2}\\le v\\le 4\\}" :db/ensure [:answer/validate]} {:db/id "answer-a1308d93-95f0-5ab2-a9e7-6b7e0551f91d" :answer/id #uuid "a1308d93-95f0-5ab2-a9e7-6b7e0551f91d" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-1\\le u\\le 1,\\,5\\le v\\le 5-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-f4095012-39a4-5bc8-a2ee-c30c5669c7bf" :answer/id #uuid "f4095012-39a4-5bc8-a2ee-c30c5669c7bf" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,4\\le v\\le 5-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-b29aa89a-331b-5b26-81e9-f1db6a760e94" :answer/id #uuid "b29aa89a-331b-5b26-81e9-f1db6a760e94" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,5-{u}^{2}\\le v\\le 4\\}" :db/ensure [:answer/validate]} {:db/id 17592186198362 :knowledge-point/questions ["question-e3b9d256-a56c-59c5-89ce-db8a163e82f8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e3b9d256-a56c-59c5-89ce-db8a163e82f8" :question/id #uuid "e3b9d256-a56c-59c5-89ce-db8a163e82f8" :question/math-academy-id "q-85304" :question/problem "Consider the region $D,$ given by\n\n$$\nD=\\{(x,y)\\,:\\,2y-5\\le x\\le 3+2y,\\,0\\le y\\le 4\\}\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere $u=x-2y$ and $v=y-3$ Find the representation of ${T}^{-1}(D)$ in the $uv$-plane." :question/worked-solution "Notice that ${T}^{-1}(D)$ is the image of $D$ under the action of the transformation ${T}^{-1}.$  \n\nLet's find the image of ${T}^{-1}(D)$ in the $uv$-plane. To do that, we write the region $D$ in terms of $u$ and $v,$ as follows:\n\n$$\n\\begin{aligned}{T}^{-1}(D) & =\\{(u,v)\\,:\\,2y-5\\le x\\le 3+2y,\\,0\\le y\\le 4\\} \\\\  & =\\{(u,v)\\,:\\,(2y-5)-2y\\le x-2y\\le (3+2y)-2y,\\,0-3\\le y-3\\le 4-3\\} \\\\  & =\\{(u,v)\\,:\\,-5\\le u\\le 3,\\,-3\\le v\\le 1\\}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4b105983-4e5e-54ad-b400-c47eac3c85af"] :db/ensure [:question/validate]} {:db/id "answer-field-4b105983-4e5e-54ad-b400-c47eac3c85af" :answer-field/id #uuid "4b105983-4e5e-54ad-b400-c47eac3c85af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-08c4e03b-acc3-5d4c-aeca-ac6dd9e5dad3" :answer-field/choices ["answer-05ce61c2-01b8-5043-9f9a-753fdddeddad" "answer-08c4e03b-acc3-5d4c-aeca-ac6dd9e5dad3" "answer-07e38fd3-f652-5a5c-a58c-99eca697a72e" "answer-f65c68cb-d554-5294-95f5-3459a5bd5fd6" "answer-d71c5929-deb6-587c-ad08-7219b0ced4ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-05ce61c2-01b8-5043-9f9a-753fdddeddad" :answer/id #uuid "05ce61c2-01b8-5043-9f9a-753fdddeddad" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-4\\le u\\le 2,\\,-2\\le v\\le 5\\}" :db/ensure [:answer/validate]} {:db/id "answer-08c4e03b-acc3-5d4c-aeca-ac6dd9e5dad3" :answer/id #uuid "08c4e03b-acc3-5d4c-aeca-ac6dd9e5dad3" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-5\\le u\\le 3,\\,-3\\le v\\le 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-07e38fd3-f652-5a5c-a58c-99eca697a72e" :answer/id #uuid "07e38fd3-f652-5a5c-a58c-99eca697a72e" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,0\\le u\\le 3,\\,-3\\le v\\le 7\\}" :db/ensure [:answer/validate]} {:db/id "answer-f65c68cb-d554-5294-95f5-3459a5bd5fd6" :answer/id #uuid "f65c68cb-d554-5294-95f5-3459a5bd5fd6" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,3\\le u\\le 7,\\,-5\\le v\\le 3\\}" :db/ensure [:answer/validate]} {:db/id "answer-d71c5929-deb6-587c-ad08-7219b0ced4ac" :answer/id #uuid "d71c5929-deb6-587c-ad08-7219b0ced4ac" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,5\\le u\\le 8,\\,1\\le v\\le 9\\}" :db/ensure [:answer/validate]} {:db/id "question-eabf1331-ca5b-594d-af21-53db9e3ebf21" :question/id #uuid "eabf1331-ca5b-594d-af21-53db9e3ebf21" :question/math-academy-id "q-85307" :question/problem "Let $D$ be the finite region bounded by the curve \n$(2x-3y)^{2}+y=3$ and the line $y=0.$ Consider the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere $u=2x-3y$ and $v=y.$ Find the representation of ${T}^{-1}(D)$ in the $uv$-plane." :question/worked-solution "First, notice that we are given that \n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}2x-3y \\\\ y\\end{aligned}].\n$$\n\nSubstituting $2x-3y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(2x-3y)^{2}+y=3\\,⟹\\,{u}^{2}+v=3\\,⟹\\,v=3-{u}^{2},\\end{aligned}\n$$\n\nwhile substituting $y=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}y=0\\,⟹\\,v=0.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}v=3-{u}^{2} \\\\ v=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}u=\\pm \\sqrt{3} \\\\ v=0.\\end{aligned}\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm \\sqrt{3},0).$\n\n![](images/17/172daaae3de5212c5e182965b66bf2afcade59e2d5eb156c7dbff214e3bfb040.png)\n\nAs a result, our domain in the $uv$-plane has the type I representation \n\n$$\n{T}^{-1}(D)=\\{(u,v)\\,:\\,-\\sqrt{3}\\le u\\le \\sqrt{3},\\,0\\le v\\le 3-{u}^{2}\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-13d9fa7c-95dc-5280-829e-a7b5d17f12e4"] :db/ensure [:question/validate]} {:db/id "answer-field-13d9fa7c-95dc-5280-829e-a7b5d17f12e4" :answer-field/id #uuid "13d9fa7c-95dc-5280-829e-a7b5d17f12e4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37662fea-e009-5c9a-9490-fc42a75cf611" :answer-field/choices ["answer-6e9a4290-f95e-517a-87d3-3d343a75caa2" "answer-c745a9ed-7b4d-5886-950b-04aa803596d2" "answer-4f24bf7e-5972-5a21-8362-2837be9b7902" "answer-37662fea-e009-5c9a-9490-fc42a75cf611" "answer-f83be70d-f8ea-59a1-9672-0ba130685944"] :db/ensure [:answer-field/validate]} {:db/id "answer-6e9a4290-f95e-517a-87d3-3d343a75caa2" :answer/id #uuid "6e9a4290-f95e-517a-87d3-3d343a75caa2" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-3\\le u\\le 3,\\,0\\le v\\le 2-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-c745a9ed-7b4d-5886-950b-04aa803596d2" :answer/id #uuid "c745a9ed-7b4d-5886-950b-04aa803596d2" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-\\sqrt{2}\\le u\\le \\sqrt{2},\\,0\\le v\\le 2-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-4f24bf7e-5972-5a21-8362-2837be9b7902" :answer/id #uuid "4f24bf7e-5972-5a21-8362-2837be9b7902" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-\\sqrt{3}\\le u\\le \\sqrt{3},\\,-1\\le v\\le 3-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-37662fea-e009-5c9a-9490-fc42a75cf611" :answer/id #uuid "37662fea-e009-5c9a-9490-fc42a75cf611" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,-\\sqrt{3}\\le u\\le \\sqrt{3},\\,0\\le v\\le 3-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-f83be70d-f8ea-59a1-9672-0ba130685944" :answer/id #uuid "f83be70d-f8ea-59a1-9672-0ba130685944" :answer/type :answer.type/math :answer/value "\\{(u,v)\\,:\\,0\\le u\\le \\sqrt{3},\\,-\\sqrt{3}\\le v\\le 3-{u}^{2}\\}" :db/ensure [:answer/validate]} {:db/id 17592186198376 :knowledge-point/questions ["question-d284dc90-b074-5607-a72d-8d0fe39284a5" "question-4c4c2566-13c3-50ff-974c-e99594494c43"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d284dc90-b074-5607-a72d-8d0fe39284a5" :question/id #uuid "d284dc90-b074-5607-a72d-8d0fe39284a5" :question/math-academy-id "q-161081" :question/problem "Consider the finite region $D$ enclosed in the first quadrant of the $xy$-plane between the curves\n\n$$\ny=\\frac{2}{{x}^{2}},\\,y=\\frac{4}{{x}^{2}},\\,y=3x,\\,y=5x.\n$$\n\nA transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nmaps a rectangular region $Δ$ with sides parallel to the $u$- and $v$-axes from the $uv$-plane onto $D$ in the $xy$-plane. Given that\n\n$$\n{T}^{-1}:(x,y)\\to ({x}^{2}y\\,,\\,\\bbox[5pt,white,border:1pt solid black]{\\phantom{AA}}\\,),\n$$\n\nwhat could be the missing expression?" :question/worked-solution "We would like to find a rectangular region of the form\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,a\\le u\\le b,\\,\\,c\\le v\\le d\\} \\\\  & =\\{(u,v)\\,:\\,a\\le u(x,y)\\le b,\\,\\,c\\le v(x,y)\\le d\\},\\end{aligned}\n$$\n\nwhere the equations of the left, right, bottom, and top sides are\n\n$$\nu(x,y)=a,\\,u(x,y)=b,\\,v(x,y)=c,\\,v(x,y)=d.\n$$\n\nWith that in mind, let's analyze the boundary of our region $D.$ \n\nRe-writing the equations \n\n$$\ny=\\frac{2}{{x}^{2}},\\,y=\\frac{4}{{x}^{2}},\\,y=3x,\\,y=5x\n$$\n\nby moving both variables $x$ and $y$ to the left-hand side, we obtain\n\n$$\n\\begin{aligned}{x}^{2}y=2,\\,{x}^{2}y=4,\\,\\frac{y}{x}=3,\\,\\frac{y}{x}=5.\\end{aligned}\n$$\n\nTherefore, if we put $u(x,y)={x}^{2}y$ and $v(x,y)=\\frac{y}{x},$ we can define the transformation ${T}^{-1}$ as\n\n$$\n{T}^{-1}:(x,y)\\to (\\,{x}^{2}y\\,,\\,\\frac{y}{x}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b86da554-3d18-5e0e-b7f0-853ee5710407"] :db/ensure [:question/validate]} {:db/id "answer-field-b86da554-3d18-5e0e-b7f0-853ee5710407" :answer-field/id #uuid "b86da554-3d18-5e0e-b7f0-853ee5710407" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b0927577-5c45-58ef-8b51-30b332e1da81" :answer-field/choices ["answer-b0927577-5c45-58ef-8b51-30b332e1da81" "answer-f4170e9d-5757-5fcd-9424-ce06df4b08fe" "answer-80190feb-7e03-5fd4-a6e1-0f0193ad096c" "answer-cd72cf12-ab3a-53fc-97d2-6cd9ca4f5545" "answer-5e80adab-46fc-5b59-80ee-fdeba6442a4d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b0927577-5c45-58ef-8b51-30b332e1da81" :answer/id #uuid "b0927577-5c45-58ef-8b51-30b332e1da81" :answer/type :answer.type/math :answer/value "\\frac{y}{x}" :db/ensure [:answer/validate]} {:db/id "answer-f4170e9d-5757-5fcd-9424-ce06df4b08fe" :answer/id #uuid "f4170e9d-5757-5fcd-9424-ce06df4b08fe" :answer/type :answer.type/math :answer/value "\\frac{y}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-80190feb-7e03-5fd4-a6e1-0f0193ad096c" :answer/id #uuid "80190feb-7e03-5fd4-a6e1-0f0193ad096c" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{y}" :db/ensure [:answer/validate]} {:db/id "answer-cd72cf12-ab3a-53fc-97d2-6cd9ca4f5545" :answer/id #uuid "cd72cf12-ab3a-53fc-97d2-6cd9ca4f5545" :answer/type :answer.type/math :answer/value "x{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5e80adab-46fc-5b59-80ee-fdeba6442a4d" :answer/id #uuid "5e80adab-46fc-5b59-80ee-fdeba6442a4d" :answer/type :answer.type/math :answer/value "{x}^{2}y" :db/ensure [:answer/validate]} {:db/id "question-4c4c2566-13c3-50ff-974c-e99594494c43" :question/id #uuid "4c4c2566-13c3-50ff-974c-e99594494c43" :question/math-academy-id "q-161087" :question/problem "Consider the finite region $D$ enclosed in the first quadrant of the $xy$-plane between the lines and curves \n\n$$\nx=3y,\\,x=7y,\\,{e}^{x}=\\frac{2}{{e}^{y}},\\,{e}^{x}=\\frac{6}{{e}^{y}}.\n$$\n\nA transformation $T,$ where\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nmaps a rectangular region $Δ$ with sides parallel to the $u$- and $v$-axes from the $uv$-plane onto $D$ in the $xy$-plane. Given that\n\n$$\nT:(u,v)\\to (\\,\\bbox[5pt,white,border:1pt solid black]{\\phantom{AA}}\\,,\\,\\frac{\\operatorname{ln}⁡v}{u+1}\\,),\n$$\n\nwhat could be the missing expression?" :question/worked-solution "We would like to find a rectangular region of the form\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,a\\le u\\le b,\\,\\,c\\le v\\le d\\} \\\\  & =\\{(u,v)\\,:\\,a\\le u(x,y)\\le b,\\,\\,c\\le v(x,y)\\le d\\},\\end{aligned}\n$$\n\nwhere the equations of the left, right, bottom, and top sides are\n\n$$\nu(x,y)=a,\\,u(x,y)=b,\\,v(x,y)=c,\\,v(x,y)=d.\n$$\n\nWith that in mind, let's analyze the boundary of our region $D.$ \n\nRewriting the equations \n\n$$\nx=3y,\\,x=7y,\\,{e}^{x}=\\frac{2}{{e}^{y}},\\,{e}^{x}=\\frac{6}{{e}^{y}}\n$$\n\nby moving both variables $x$ and $y$ to the left-hand side, we obtain\n\n$$\n\\begin{aligned}\\frac{x}{y}=3,\\,\\frac{x}{y}=7,\\,{e}^{x+y}=2,\\,{e}^{x+y}=6.\\end{aligned}\n$$\n\nTherefore, if we put $u(x,y)=\\frac{x}{y}$ and $v(x,y)={e}^{x+y},$ we can define the transformation ${T}^{-1}$ as\n\n$$\n{T}^{-1}:(x,y)\\to (\\,\\frac{x}{y}\\,,\\,{e}^{x+y}).\n$$\n\nTo find $T,$ we should express $x$ and $y$ in terms of $u$ and $v.$ Recall that we have\n\n$$\n\\{\\begin{aligned}u=\\frac{x}{y} \\\\ v={e}^{x+y}.\\end{aligned}\n$$\n\nFrom the first equation, $x=uy.$ Substituting this into the second equation, we get \n\n$$\nv={e}^{uy+y}\\,⟹\\,\\operatorname{ln}⁡v=uy+y\\,⟹\\,y=\\frac{\\operatorname{ln}⁡v}{u+1}.\n$$\n\nFinally, substituting $y=\\frac{\\operatorname{ln}⁡v}{u+1}$ back into $x=uy,$ we obtain\n\n$$\nx=\\frac{u\\operatorname{ln}⁡v}{u+1}.\n$$\n\nTherefore, the transformation $T$ can be given by\n\n$$\nT:(u,v)\\to (\\,\\frac{u\\operatorname{ln}⁡v}{u+1}\\,,\\,\\frac{\\operatorname{ln}⁡v}{u+1}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c414baf9-635b-5e55-85c0-f6df87c6300c"] :db/ensure [:question/validate]} {:db/id "answer-field-c414baf9-635b-5e55-85c0-f6df87c6300c" :answer-field/id #uuid "c414baf9-635b-5e55-85c0-f6df87c6300c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-92967e3c-5864-5abd-aa87-5d7fcf6ac098" :answer-field/choices ["answer-d04f42a5-067b-5fa1-9332-07ed3d5b6ff9" "answer-38837c3f-3a25-53aa-af88-6095dbd44aa2" "answer-dff1ee65-ce03-521b-908a-5cef080fba1c" "answer-92967e3c-5864-5abd-aa87-5d7fcf6ac098" "answer-de6f5dca-392e-5e63-929b-f3df98856bee"] :db/ensure [:answer-field/validate]} {:db/id "answer-d04f42a5-067b-5fa1-9332-07ed3d5b6ff9" :answer/id #uuid "d04f42a5-067b-5fa1-9332-07ed3d5b6ff9" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡u}{v+1}" :db/ensure [:answer/validate]} {:db/id "answer-38837c3f-3a25-53aa-af88-6095dbd44aa2" :answer/id #uuid "38837c3f-3a25-53aa-af88-6095dbd44aa2" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡v}{u+1}" :db/ensure [:answer/validate]} {:db/id "answer-dff1ee65-ce03-521b-908a-5cef080fba1c" :answer/id #uuid "dff1ee65-ce03-521b-908a-5cef080fba1c" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡v}{uv+1}" :db/ensure [:answer/validate]} {:db/id "answer-92967e3c-5864-5abd-aa87-5d7fcf6ac098" :answer/id #uuid "92967e3c-5864-5abd-aa87-5d7fcf6ac098" :answer/type :answer.type/math :answer/value "\\frac{u\\operatorname{ln}⁡v}{u+1}" :db/ensure [:answer/validate]} {:db/id "answer-de6f5dca-392e-5e63-929b-f3df98856bee" :answer/id #uuid "de6f5dca-392e-5e63-929b-f3df98856bee" :answer/type :answer.type/math :answer/value "\\frac{u\\operatorname{ln}⁡v}{v+1}" :db/ensure [:answer/validate]} {:db/id "activity-5236f00e-3e0c-590b-ab92-46b5776952a8" :activity/id #uuid "5236f00e-3e0c-590b-ab92-46b5776952a8" :activity/title "Transformations of Regions Between Curves" :activity/type :activity.type/review :activity/scope 17592186049032 :activity/course 17592186046659 :activity/steps ["step-5c991136-4174-5b8c-a072-9dbe197bf649" "step-148c81a9-4b53-5838-b141-ec4a2153b3c7" "step-8c534e8b-12d5-5861-8fad-aaddc6760864" "step-6df31d5a-d97b-5683-b5dd-1ec918e08ea4" "step-0c70884a-daa4-52bf-a53a-39f975c92f7e"] :activity/first-step "step-5c991136-4174-5b8c-a072-9dbe197bf649" :db/ensure [:activity/validate]} {:db/id "step-5c991136-4174-5b8c-a072-9dbe197bf649" :step/id #uuid "5c991136-4174-5b8c-a072-9dbe197bf649" :step/content "question-d78c4c29-1d34-52bf-9160-d17820674c44" :step/next "step-148c81a9-4b53-5838-b141-ec4a2153b3c7" :db/ensure [:step/validate]} {:db/id "step-148c81a9-4b53-5838-b141-ec4a2153b3c7" :step/id #uuid "148c81a9-4b53-5838-b141-ec4a2153b3c7" :step/content "question-e3b9d256-a56c-59c5-89ce-db8a163e82f8" :step/next "step-8c534e8b-12d5-5861-8fad-aaddc6760864" :db/ensure [:step/validate]} {:db/id "step-8c534e8b-12d5-5861-8fad-aaddc6760864" :step/id #uuid "8c534e8b-12d5-5861-8fad-aaddc6760864" :step/content "question-eabf1331-ca5b-594d-af21-53db9e3ebf21" :step/next "step-6df31d5a-d97b-5683-b5dd-1ec918e08ea4" :db/ensure [:step/validate]} {:db/id "step-6df31d5a-d97b-5683-b5dd-1ec918e08ea4" :step/id #uuid "6df31d5a-d97b-5683-b5dd-1ec918e08ea4" :step/content "question-d284dc90-b074-5607-a72d-8d0fe39284a5" :step/next "step-0c70884a-daa4-52bf-a53a-39f975c92f7e" :db/ensure [:step/validate]} {:db/id "step-0c70884a-daa4-52bf-a53a-39f975c92f7e" :step/id #uuid "0c70884a-daa4-52bf-a53a-39f975c92f7e" :step/content "question-4c4c2566-13c3-50ff-974c-e99594494c43" :db/ensure [:step/validate]} {:db/id 17592186105717 :knowledge-point/questions ["question-d999c138-4be3-55d4-a8c5-6e1a2cbd965f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105440 :question/problem "Which of the following could be the interior angles of a quadrilateral?\n\nI. $40^{\\circ}$, $50^{\\circ}$, $100^{\\circ}$, $170^{\\circ}$\n\nII. $20^{\\circ}$, $50^{\\circ}$, $150^{\\circ}$, $140^{\\circ}$\n\nIII. $30^{\\circ}$, $35^{\\circ}$, $140^{\\circ}$, $175^{\\circ}$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nLet's check this for the above three options:\n\n$$\n\\begin{aligned}{40}^{∘}+{50}^{∘}+{100}^{∘}+{170}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {20}^{∘}+{50}^{∘}+{150}^{∘}+{140}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {30}^{∘}+{35}^{∘}+{140}^{∘}+{175}^{∘}={380}^{∘}\\,X\\end{aligned}\n$$\n\nTherefore, only options I and II could be the angles of a quadrilateral." :db/ensure [:question/validate]} {:db/id 17592186105718 :knowledge-point/questions ["question-f2ab3104-7e40-5b36-8b8a-4688c13efdc5" "question-b1deaad5-98bb-5e5a-b9a0-860c7a294ceb" "question-d92c74e1-c89d-5cec-a7a1-0d82e6525e3d" "question-97be54c9-28e3-5dbb-97cf-64bffd902d5f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105438 :question/problem "Given the pentagon $ABCDE$ shown below, find the value of $x.$\n\n![](images/dc/dc4407245e0639d9055d9518088a46b310f67e897337bd8963e5b1c42a86421f.png)" :question/worked-solution "A pentagon has $n=5$ sides. Therefore, the sum of the interior angles of a pentagon must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (5-2) \\\\  & ={180}^{∘}\\cdot 3 \\\\  & ={540}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C+m∠D+m∠E & ={540}^{∘} \\\\ {120}^{∘}+{110}^{∘}+2x+{90}^{∘}+x+{40}^{∘} & ={540}^{∘} \\\\ 2x+x+{40}^{∘}+{120}^{∘}+{110}^{∘}+{90}^{∘} & ={540}^{∘} \\\\ 3x+{360}^{∘} & ={540}^{∘} \\\\ 3x & ={180}^{∘} \\\\ x & ={60}^{∘}\\,.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105719 :knowledge-point/questions ["question-be9eb345-ad38-54e4-ae93-ee7a03d3fd33" "question-4852498b-dc1b-525e-82e2-305f7ebaf1ab" "question-3c97d79e-a33f-5989-8625-5100ed2853d5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105439 :question/problem "The sum of the interior angles of a polygon is $720^\\circ.$ How many sides does it have?" :question/worked-solution "Remember that the sum of the interior angles of a polygon with $n$ sides is $180^\\circ \\cdot (n-2).$\n\nTo find the number of sides in our polygon, we start by setting up the following equation:\n\n$$\n180^\\circ \\cdot (n-2) = 720^\\circ\n$$\n\nNow, we solve for $n,$ as follows:\n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={720}^{∘} \\\\ n-2 & =\\frac{{720}^{∘}}{{180}^{∘}} \\\\ n-2 & =4 \\\\ n & =6\\end{aligned}\n$$\n\nTherefore, the polygon has $n=6$ sides (it is a hexagon)." :db/ensure [:question/validate]} {:db/id "question-d999c138-4be3-55d4-a8c5-6e1a2cbd965f" :question/id #uuid "d999c138-4be3-55d4-a8c5-6e1a2cbd965f" :question/math-academy-id "q-74239" :question/problem "Which of the following could be the interior angles of a quadrilateral?\n\nI. ${41}^{∘}$, ${89}^{∘}$, ${100}^{∘}$, ${130}^{∘}$\n\nII. ${15}^{∘}$, ${119}^{∘}$, ${82}^{∘}$, ${131}^{∘}$\n\nIII. ${21}^{∘}$, ${74}^{∘}$, ${110}^{∘}$, ${155}^{∘}$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nLet's check this for the above three options:\n\n$$\n\\begin{aligned}{41}^{∘}+{89}^{∘}+{100}^{∘}+{130}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {15}^{∘}+{119}^{∘}+{82}^{∘}+{131}^{∘}={347}^{∘}\\,X \\\\  &  \\\\ {21}^{∘}+{74}^{∘}+{110}^{∘}+{155}^{∘}={360}^{∘}\\,✓\\end{aligned}\n$$\n\nTherefore, only options I and III could be the angles of a quadrilateral." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cac177c2-9ea5-5187-a8ce-ea6749eb3c1b"] :db/ensure [:question/validate]} {:db/id "answer-field-cac177c2-9ea5-5187-a8ce-ea6749eb3c1b" :answer-field/id #uuid "cac177c2-9ea5-5187-a8ce-ea6749eb3c1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-952bcbd0-687e-56a9-8231-132174a60417" :answer-field/choices ["answer-357395bb-c75f-5d23-bf4d-03e608a41ff9" "answer-952bcbd0-687e-56a9-8231-132174a60417" "answer-eaede687-ba2c-5de9-9d44-59da03c3a825" "answer-b493e1f9-92d6-5393-b240-31cb7a04b42e" "answer-1a7898a6-14af-555e-8c57-5a5e410541d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-357395bb-c75f-5d23-bf4d-03e608a41ff9" :answer/id #uuid "357395bb-c75f-5d23-bf4d-03e608a41ff9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-952bcbd0-687e-56a9-8231-132174a60417" :answer/id #uuid "952bcbd0-687e-56a9-8231-132174a60417" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-eaede687-ba2c-5de9-9d44-59da03c3a825" :answer/id #uuid "eaede687-ba2c-5de9-9d44-59da03c3a825" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-b493e1f9-92d6-5393-b240-31cb7a04b42e" :answer/id #uuid "b493e1f9-92d6-5393-b240-31cb7a04b42e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-1a7898a6-14af-555e-8c57-5a5e410541d1" :answer/id #uuid "1a7898a6-14af-555e-8c57-5a5e410541d1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186106468 :question/problem "Which of the following could be the interior angles of a quadrilateral?\n\nI. ${64}^{∘}$, ${73}^{∘}$, ${98}^{∘}$, ${124}^{∘}$\n\nII. ${73}^{∘}$, ${112}^{∘}$, ${93}^{∘}$, ${82}^{∘}$\n\nIII. ${80}^{∘}$, ${140}^{∘}$, ${49}^{∘}$, ${84}^{∘}$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nLet's check this for the above three options:\n\n$$\n\\begin{aligned}{64}^{∘}+{73}^{∘}+{98}^{∘}+{124}^{∘}={359}^{∘}\\,X \\\\  &  \\\\ {73}^{∘}+{112}^{∘}+{93}^{∘}+{82}^{∘}={360}^{∘}\\,✓ \\\\  &  \\\\ {80}^{∘}+{140}^{∘}+{49}^{∘}+{84}^{∘}={353}^{∘}\\,X\\end{aligned}\n$$\n\nTherefore, only option II could be the angles of a quadrilateral." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186104956 :answer-field/correct 17592186104961 :db/ensure [:answer-field/validate]} {:db/id "question-f2ab3104-7e40-5b36-8b8a-4688c13efdc5" :question/id #uuid "f2ab3104-7e40-5b36-8b8a-4688c13efdc5" :question/math-academy-id "q-118174" :question/problem "![](images/f9/f93eab26860fffd262ce4db8927c56d77ad7710b4b7da61e190126596e968d71.png)\n\nIn the quadrilateral $ABCD$ above, determine the value of $x.$" :question/worked-solution "A quadrilateral has $n=4$ sides. Therefore, the sum of the interior angles of a quadrilateral must be \n\n$$\n\\begin{aligned}{180}^{∘}\\cdot (n-2) & ={180}^{∘}\\cdot (4-2) \\\\  & ={180}^{∘}\\cdot 2 \\\\  & ={360}^{∘}.\\end{aligned}\n$$\n\nAdding up the internal angles and solving for $x,$ we get\n\n$$\n\\begin{aligned}m∠A+m∠B+m∠C+m∠D & ={360}^{∘} \\\\ (x+{90}^{∘})+(4x-{17}^{∘})+(3x+{3}^{∘})+{60}^{∘} & ={360}^{∘} \\\\ 8x+{136}^{∘} & ={360}^{∘} \\\\ 8x & ={224}^{∘} \\\\ x & ={28}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-02f50211-86ba-5ee3-a3c2-92892b11a405"] :db/ensure [:question/validate]} {:db/id "answer-field-02f50211-86ba-5ee3-a3c2-92892b11a405" :answer-field/id #uuid "02f50211-86ba-5ee3-a3c2-92892b11a405" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d73ce0ad-8ac1-5f51-9cbb-08828b4ce4db" :answer-field/choices ["answer-b4e63f71-eabc-54df-ad89-80735da08455" "answer-310b1c9a-6870-53ae-8b31-9583e1371d7b" "answer-350351e2-abb6-5117-b5b8-9407e096a0cf" "answer-5d2e63e7-d867-50bc-946d-e7f1d67e1d96" "answer-d73ce0ad-8ac1-5f51-9cbb-08828b4ce4db"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4e63f71-eabc-54df-ad89-80735da08455" :answer/id #uuid "b4e63f71-eabc-54df-ad89-80735da08455" :answer/type :answer.type/math :answer/value "{16}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-310b1c9a-6870-53ae-8b31-9583e1371d7b" :answer/id #uuid "310b1c9a-6870-53ae-8b31-9583e1371d7b" :answer/type :answer.type/math :answer/value "{18}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-350351e2-abb6-5117-b5b8-9407e096a0cf" :answer/id #uuid "350351e2-abb6-5117-b