inh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\newcommand{\\cosh}{\\mathop{\\rm cosh}\\nolimits}\n\\newcommand{\\sinh}{\\mathop{\\rm sinh}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n$$\n\nFirst, we find the hyperbolic identity that corresponds to the trigonometric identity \n\n$$\n\\cot{x}=\\dfrac{\\cos{x}}{\\sin{x}}.\n$$\n\nUsing Osborn's rule, the corresponding hyperbolic identity is\n\n$$\n\\coth{x}=\\dfrac{\\cosh{x}}{\\sinh{x}}.\n$$\n\nNow, we rewrite the integral using the above identity, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}\\operatorname{coth}⁡x\\operatorname{sinh}⁡x\\,\\text{d}x & ={\\int }_{-1}^{1}\\frac{\\operatorname{cosh}⁡x}{\\operatorname{sinh}⁡x}\\cdot \\operatorname{sinh}⁡x\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}\\operatorname{cosh}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sinh}⁡x\\,{|}_{-1}^{1} \\\\  & =\\operatorname{sinh}⁡(1)-\\operatorname{sinh}⁡(-1) \\\\  & =\\frac{{e}^{1}-{e}^{-1}}{2}-\\frac{{e}^{-1}-{e}^{-(-1)}}{2} \\\\  & =\\frac{{e}^{1}-{e}^{-1}-{e}^{-1}+{e}^{1}}{2} \\\\  & =\\frac{2e-2{e}^{-1}}{2} \\\\  & =e-{e}^{-1}.\\end{aligned}\n$$" 13194139535886 17592186045417 true] [17592186166629 1074 "$$\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits} \\newcommand{\\cosh}{\\