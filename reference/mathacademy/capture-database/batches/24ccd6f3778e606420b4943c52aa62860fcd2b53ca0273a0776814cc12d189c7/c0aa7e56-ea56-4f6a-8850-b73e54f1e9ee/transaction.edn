eld-4c49559e-e9c1-5193-b92b-63cd7b8e9ab9"] :db/ensure [:question/validate]} {:db/id "answer-field-4c49559e-e9c1-5193-b92b-63cd7b8e9ab9" :answer-field/id #uuid "4c49559e-e9c1-5193-b92b-63cd7b8e9ab9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d97b8e24-3a52-5890-8f94-f5afee62f73f" :answer-field/choices ["answer-d97b8e24-3a52-5890-8f94-f5afee62f73f" "answer-041cf703-252a-5a82-af4d-e39fe9281f89" "answer-0f05675a-7366-5451-836b-a7a34485b9da" "answer-1ea52371-3342-5c52-8943-370aaad27a07" "answer-334cd414-155f-577b-83d1-656c2d080e14"] :db/ensure [:answer-field/validate]} {:db/id "answer-d97b8e24-3a52-5890-8f94-f5afee62f73f" :answer/id #uuid "d97b8e24-3a52-5890-8f94-f5afee62f73f" :answer/type :answer.type/math :answer/value "A" :db/ensure [:answer/validate]} {:db/id "answer-041cf703-252a-5a82-af4d-e39fe9281f89" :answer/id #uuid "041cf703-252a-5a82-af4d-e39fe9281f89" :answer/type :answer.type/math :answer/value "B" :db/ensure [:answer/validate]} {:db/id "answer-0f05675a-7366-5451-836b-a7a34485b9da" :answer/id #uuid "0f05675a-7366-5451-836b-a7a34485b9da" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "answer-1ea52371-3342-5c52-8943-370aaad27a07" :answer/id #uuid "1ea52371-3342-5c52-8943-370aaad27a07" :answer/type :answer.type/math :answer/value "D" :db/ensure [:answer/validate]} {:db/id "answer-334cd414-155f-577b-83d1-656c2d080e14" :answer/id #uuid "334cd414-155f-577b-83d1-656c2d080e14" :answer/type :answer.type/math :answer/value "E" :db/ensure [:answer/validate]} {:db/id "question-abee8b7a-4a45-595d-8f90-0e0bbc3678c1" :question/id #uuid "abee8b7a-4a45-595d-8f90-0e0bbc3678c1" :question/math-academy-id "q-4056" :question/problem "The point $Q(-3,1)$ is shifted $2$ units up, reflected across the $y$-axis, and then shifted $1$ unit to the left. What is the resulting point?" :question/worked-solution "Let's recall the functional representations of our three transformations:\n\n- A shift of $2$ units up can be represented by the function \n\n$$\n(x,y)↦(x,y+2).\n$$\n\n- A reflection in the $y$-axis can be represented by the function \n\n$$\n(x,y)↦(-x,y).\n$$\n\n- A shift of $1$ unit to the left can be represented by the function \n\n$$\n(x,y)↦(x-1,y).\n$$\n\nLet's apply the given transformations to the point $Q$ using our functions:\n\nFirst, we apply the shift. The image of the point $(-3,1)$ under the shift is\n\n$$\n(-3,1)↦(-3,1+2)=(-3,3).\n$$\n\n \n\nThen, we apply the reflection. The image of the point $(-3,3)$ under the reflection is\n\n$$\n(-3,3)↦(3,3).\n$$\n\nFinally, we apply the second shift by $1$ unit to the left. The image of the point $(3,3)$ under the shift is\n\n$$\n(3,3)↦(3-1,3)=(2,3).\n$$\n\n \n\nTherefore, the resulting point is $(2,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4699a690-a8bd-5581-b11e-7163244e6dcf"] :db/ensure [:question/validate]} {:db/id "answer-field-4699a690-a8bd-5581-b11e-7163244e6dcf" :answer-field/id #uuid "4699a690-a8bd-5581-b11e-7163244e6dcf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e044b7d5-8486-58d6-b3fe-085072e21840" :answer-field/choices ["answer-d1814799-e689-53a9-80c0-138645ff6068" "answer-a4e5ce62-ea3a-5f89-be1a-a44d806e3912" "answer-3d6aa5e1-96ad-5af2-b67a-d52b21a1d422" "answer-ea7eef76-ed62-5f78-aa7d-5f5fcde472d4" "answer-e044b7d5-8486-58d6-b3fe-085072e21840"] :db/ensure [:answer-field/validate]} {:db/id "answer-d1814799-e689-53a9-80c0-138645ff6068" :answer/id #uuid "d1814799-e689-53a9-80c0-138645ff6068" :answer/type :answer.type/math :answer/value "(-2,-3)" :db/ensure [:answer/validate]} {:db/id "answer-a4e5ce62-ea3a-5f89-be1a-a44d806e3912" :answer/id #uuid "a4e5ce62-ea3a-5f89-be1a-a44d806e3912" :answer/type :answer.type/math :answer/value "(-3,-4)" :db/ensure [:answer/validate]} {:db/id "answer-3d6aa5e1-96ad-5af2-b67a-d52b21a1d422" :answer/id #uuid "3d6aa5e1-96ad-5af2-b67a-d52b21a1d422" :answer/type :answer.type/math :answer/value "(-4,-3)" :db/ensure [:answer/validate]} {:db/id "answer-ea7eef76-ed62-5f78-aa7d-5f5fcde472d4" :answer/id #uuid "ea7eef76-ed62-5f78-aa7d-5f5fcde472d4" :answer/type :answer.type/math :answer/value "(1,0)" :db/ensure [:answer/validate]} {:db/id "answer-e044b7d5-8486-58d6-b3fe-085072e21840" :answer/id #uuid "e044b7d5-8486-58d6-b3fe-085072e21840" :answer/type :answer.type/math :answer/value "(2,3)" :db/ensure [:answer/validate]} {:db/id "question-5d698685-38f5-5e4a-b709-e155fb9c6b96" :question/id #uuid "5d698685-38f5-5e4a-b709-e155fb9c6b96" :question/math-academy-id "q-14379" :question/problem "The point $P(-21,17)$ is acted on by a shift of $7$ units down followed by reflection across the line $y=x.$ What is the image of $P$ under this transformation?" :question/worked-solution "Let's recall the functional representations of our two transformations:\n\n- A shift of $7$ units down can be represented by the function \n\n$$\n(x,y)↦(x,y-7).\n$$\n\n- A reflection across the line $y=x$ can be represented by the function\n\n$$\n(x,y)↦(y,x).\n$$\n\nLet's apply the given transformations to the point $P$ using our functions:\n\nFirst, we apply the shift. The image of the point $(-21,17)$ under the shift is\n\n$$\n(-21,17)↦(-21,17-7)=(-21,10).\n$$\n\n \n\nThen, we apply the reflection. The image of the point $(-21,10)$ under the reflection is\n\n$$\n(-21,10)↦(10,-21).\n$$\n\nTherefore, the resulting point is $(10,-21).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a4faa69a-a341-53a6-a6fc-1d912a96ca49"] :db/ensure [:question/validate]} {:db/id "answer-field-a4faa69a-a341-53a6-a6fc-1d912a96ca49" :answer-field/id #uuid "a4faa69a-a341-53a6-a6fc-1d912a96ca49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76be68a4-09fd-5e88-831d-5a29033970e7" :answer-field/choices ["answer-e4fd129a-3897-566f-b017-d5935d9fe3c3" "answer-0a8dfe3f-0