png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8281b0e2-57f7-5cba-af09-5e8369c12a2d"] :db/ensure [:question/validate]} {:db/id "answer-field-8281b0e2-57f7-5cba-af09-5e8369c12a2d" :answer-field/id #uuid "8281b0e2-57f7-5cba-af09-5e8369c12a2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8e07797-9d73-5c48-b6ea-b26cfa64c25a" :answer-field/choices ["answer-f42f892e-b71b-500f-873c-319029234d5e" "answer-abd23b07-665a-59bb-8627-3240c8ed9f90" "answer-312fd943-62ef-53c2-b313-da36d45d89e5" "answer-c8e07797-9d73-5c48-b6ea-b26cfa64c25a" "answer-ae72b90a-d62a-530c-aaac-ad9a74686997"] :db/ensure [:answer-field/validate]} {:db/id "answer-f42f892e-b71b-500f-873c-319029234d5e" :answer/id #uuid "f42f892e-b71b-500f-873c-319029234d5e" :answer/type :answer.type/image :answer/value "images/31/31e41a2dcde8e8bcb161e19f7cd48c7d64dcac847d7b4ab8ac413689e6a2fca2.png" :db/ensure [:answer/validate]} {:db/id "answer-abd23b07-665a-59bb-8627-3240c8ed9f90" :answer/id #uuid "abd23b07-665a-59bb-8627-3240c8ed9f90" :answer/type :answer.type/image :answer/value "images/3b/3bd25c202d906dae5f53dfbd30be1d6f9d8b5bbc6c61b9a8a26e571e27a6ddd2.png" :db/ensure [:answer/validate]} {:db/id "answer-312fd943-62ef-53c2-b313-da36d45d89e5" :answer/id #uuid "312fd943-62ef-53c2-b313-da36d45d89e5" :answer/type :answer.type/image :answer/value "images/c7/c7eaf1716770856a4b7d2a3d0807549a3b9f817bbe21964d9422828ed3c2547e.png" :db/ensure [:answer/validate]} {:db/id "answer-c8e07797-9d73-5c48-b6ea-b26cfa64c25a" :answer/id #uuid "c8e07797-9d73-5c48-b6ea-b26cfa64c25a" :answer/type :answer.type/image :answer/value "images/db/db878d3e03049d5d91e2e6dc264bbe1ba7fb09e40c3473d07c3be92f0804a105.png" :db/ensure [:answer/validate]} {:db/id "answer-ae72b90a-d62a-530c-aaac-ad9a74686997" :answer/id #uuid "ae72b90a-d62a-530c-aaac-ad9a74686997" :answer/type :answer.type/image :answer/value "images/e3/e308232592029843b1f6fabb90bb4b88e5a855