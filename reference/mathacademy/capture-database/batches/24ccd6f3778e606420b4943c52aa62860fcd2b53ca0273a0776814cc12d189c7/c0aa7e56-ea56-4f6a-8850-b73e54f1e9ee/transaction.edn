ensure [:question/validate]} {:db/id 17592186072620 :answer-field/correct "answer-d74c804c-a8d1-59e6-9899-b3b34ec27cb2" :answer-field/choices ["answer-9e2d1ca2-29a3-590d-8b3a-8e4797c313f5" "answer-d74c804c-a8d1-59e6-9899-b3b34ec27cb2" "answer-3309d42c-e7de-5e1b-be51-6b077a257c48" "answer-c96f6581-7aac-56c8-9f71-0a776b002031" "answer-68e267a2-c19e-5d1c-8c01-8f92fa4013d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e2d1ca2-29a3-590d-8b3a-8e4797c313f5" :answer/id #uuid "9e2d1ca2-29a3-590d-8b3a-8e4797c313f5" :answer/type :answer.type/math :answer/value "1:5" :db/ensure [:answer/validate]} {:db/id "answer-d74c804c-a8d1-59e6-9899-b3b34ec27cb2" :answer/id #uuid "d74c804c-a8d1-59e6-9899-b3b34ec27cb2" :answer/type :answer.type/math :answer/value "2:3" :db/ensure [:answer/validate]} {:db/id "answer-3309d42c-e7de-5e1b-be51-6b077a257c48" :answer/id #uuid "3309d42c-e7de-5e1b-be51-6b077a257c48" :answer/type :answer.type/math :answer/value "2:5" :db/ensure [:answer/validate]} {:db/id "answer-c96f6581-7aac-56c8-9f71-0a776b002031" :answer/id #uuid "c96f6581-7aac-56c8-9f71-0a776b002031" :answer/type :answer.type/math :answer/value "3:4" :db/ensure [:answer/validate]} {:db/id "answer-68e267a2-c19e-5d1c-8c01-8f92fa4013d1" :answer/id #uuid "68e267a2-c19e-5d1c-8c01-8f92fa4013d1" :answer/type :answer.type/math :answer/value "5:8" :db/ensure [:answer/validate]} {:db/id 17592186096677 :knowledge-point/questions ["question-ac3e396f-e9ff-515e-95c3-ddf87162b016"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ac3e396f-e9ff-515e-95c3-ddf87162b016" :question/id #uuid "ac3e396f-e9ff-515e-95c3-ddf87162b016" :question/math-academy-id "q-68844" :question/problem "Maria has a bank account at LJB Bank. She has an overdraft facility authorized by this bank. Her bank balance on Monday was $-$40.00.$ To reduce her debt, Maria decides to make a deposit of $$18.60$ into her bank account on the following Tuesday. What is Maria's balance at the end of the day on Tuesday?" :question/worked-solution "To determine the balance at the end of the day on Tuesday, we must add the amount of money Maria deposited to the starting balance. This gives\n\n$$\n-$40.00+$18.60=-$21.40.\n$$\n\nThus, Maria's balance at the end of the day on Tuesday is $-$21.40.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bc9bd1b9-0131-55b4-a33d-f2d8e3052b46"] :db/ensure [:question/validate]} {:db/id "answer-field-bc9bd1b9-0131-55b4-a33d-f2d8e3052b46" :answer-field/id #uuid "bc9bd1b9-0131-55b4-a33d-f2d8e3052b46" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db7af467-35db-5c13-913d-0211eaf4b4c3" :answer-field/choices ["answer-4ab57578-c0f4-564e-9dcc-b30c65737168" "answer-4b45565c-a329-5dbb-9963-42bd3aefa10e" "answer-c55f0115-e6bf-5e7b-88ff-bcccaff67b54" "answer-db7af467-35db-5c13-913d-0211eaf4b4c3" "answer-489e5d74-a352-5e41-872e-d97d1152340f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ab57578-c0f4-564e-9dcc-b30c65737168" :answer/id #uuid "4ab57578-c0f4-564e-9dcc-b30c65737168" :answer/type :answer.type/text :answer/value "$-$17.50$" :db/ensure [:answer/validate]} {:db/id "answer-4b45565c-a329-5dbb-9963-42bd3aefa10e" :answer/id #uuid "4b45565c-a329-5dbb-9963-42bd3aefa10e" :answer/type :answer.type/text :answer/value "$-$18.60$" :db/ensure [:answer/validate]} {:db/id "answer-c55f0115-e6bf-5e7b-88ff-bcccaff67b54" :answer/id #uuid "c55f0115-e6bf-5e7b-88ff-bcccaff67b54" :answer/type :answer.type/text :answer/value "$-$20.90$" :db/ensure [:answer/validate]} {:db/id "answer-db7af467-35db-5c13-913d-0211eaf4b4c3" :answer/id #uuid "db7af467-35db-5c13-913d-0211eaf4b4c3" :answer/type :answer.type/text :answer/value "$-$21.40$" :db/ensure [:answer/validate]} {:db/id "answer-489e5d74-a352-5e41-872e-d97d1152340f" :answer/id #uuid "489e5d74-a352-5e41-872e-d97d1152340f" :answer/type :answer.type/text :answer/value "$-$23.10$" :db/ensure [:answer/validate]} {:db/id 17592186179799 :knowledge-point/questions ["question-2b21718f-1527-5624-995c-489290485c6f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2b21718f-1527-5624-995c-489290485c6f" :question/id #uuid "2b21718f-1527-5624-995c-489290485c6f" :question/math-academy-id "q-128027" :question/problem "Find the value of $(-\\frac{12}{5})÷(-3).$" :question/worked-solution "Dividing a negative number by a negative number gives a positive number. Hence, the result will be positive.\n\nTherefore, since \n\n$$\n\\frac{12}{5}÷3=\\frac{12}{5\\times 3}=\\frac{12}{15}=\\frac{4}{5},\n$$\n\nwe obtain\n\n$$\n(-\\frac{12}{5})÷(-3)=\\frac{4}{5}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4b9b6de2-c942-5b7d-bee5-f32a9154bfcb"] :db/ensure [:question/validate]} {:db/id "answer-field-4b9b6de2-c942-5b7d-bee5-f32a9154bfcb" :answer-field/id #uuid "4b9b6de2-c942-5b7d-bee5-f32a9154bfcb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-31fe9d50-00ed-566e-af8a-d1bb3e363580" :answer-field/choices ["answer-92639e1b-9c28-54c1-b941-f73ffe10bfb2" "answer-ae9d109d-0856-50b3-91be-dcbd5c513945" "answer-cb0bbf4b-84c5-5b4b-bf9f-be7a1d428368" "answer-31fe9d50-00ed-566e-af8a-d1bb3e363580" "answer-055df541-ba49-5b08-8eb5-364df6d7f59e"] :db/ensure [:answer-field/validate]} {:db/id "answer-92639e1b-9c28-54c1-b941-f73ffe10bfb2" :answer/id #uuid "92639e1b-9c28-54c1-b941-f73ffe10bfb2" :answer/type :answer.type/math :answer/value "-\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-ae9d109d-0856-50b3-91be-dcbd5c513945" :answer/id #uuid "ae9d109d-0856-50b3-91be-dcbd5c513945" :answer/type :answer.type/math :answer/value "-\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-cb0bbf4b-84c5-5b4b-bf9f-be7a1d428368" :answer/id #uuid "cb0bbf4b-84c5-5b4b-bf9f-be7a1d428368" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-31fe9d50-00ed-566e-af8a-d1bb3e363580" :answer/id #uuid "31fe9d50-00ed-566e-af8a-d1bb3e363580" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-055df541-ba49-5b08-8eb5-364df6d7f59e" :answer/id #uuid "055df541-ba49-5b08-8eb5-364df6d7f59e" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id 17592186110776 :knowledge-point/questions ["question-d513115b-ad74-5e72-8ee2-71bd9f120a6f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d513115b-ad74-5e72-8ee2-71bd9f120a6f" :question/id #uuid "d513115b-ad74-5e72-8ee2-71bd9f120a6f" :question/math-academy-id "q-128174" :question/problem "![](images/0f/0f18036ac5790bda530116c6847243108f9617f9ae12fcbc5c1b2c3fff018985.png)\n\nWhich of the following terms describe the shape above?\n\nI. Parallelogram\n\nII. Rectangle\n\nIII. Rhombus" :question/worked-solution "First, recall the hierarchy diagram of quadrilaterals, where each shape below another is a specific type of the one above it.\n\n![](images/1d/1dbe4c3e8ea97c0ac077c37143802366c5817d86965ab1dbc5abf54cd01d27c3.png)\n\nLet's now look at the terms one by one.\n\n- The given figure is a quadrilateral with two pairs of opposite congruent sides, so it is a parallelogram.\n\n- Since the four angles of the quadrilateral are right angles, it is a rectangle.\n\n- The given figure is a quadrilateral where the sides are not all congruent. So it is **not** a rhombus.\n\nConsequently, the given shape is described by terms I (parallelogram), and II (rectangle)." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-27071654-a089-55fa-816c-6ef4bea74f2e"] :db/ensure [:question/validate]} {:db/id "answer-field-27071654-a089-55fa-816c-6ef4bea74f2e" :answer-field/id #uuid "27071654-a089-55fa-816c-6ef4bea74f2e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-756c1651-49c5-59b4-9237-64c638bfd4f1" :answer-field/choices ["answer-756c1651-49c5-59b4-9237-64c638bfd4f1" "answer-0099a153-14ac-5228-adff-948144c7c511" "answer-164cdbc6-b14e-5459-8e4d-4f24d14ceda3" "answer-eb7b757c-1895-5c25-80ab-64cfd132b5b7" "answer-19ac550c-b465-5b11-ae37-62b736f5ff29"] :db/ensure [:answer-field/validate]} {:db/id "answer-756c1651-49c5-59b4-9237-64c638bfd4f1" :answer/id #uuid "756c1651-49c5-59b4-9237-64c638bfd4f1" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-0099a153-14ac-5228-adff-948144c7c511" :answer/id #uuid "0099a153-14ac-5228-adff-948144c7c511" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-164cdbc6-b14e-5459-8e4d-4f24d14ceda3" :answer/id #uuid "164cdbc6-b14e-5459-8e4d-4f24d14ceda3" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-eb7b757c-1895-5c25-80ab-64cfd132b5b7" :answer/id #uuid "eb7b757c-1895-5c25-80ab-64cfd132b5b7" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-19ac550c-b465-5b11-ae37-62b736f5ff29" :answer/id #uuid "19ac550c-b465-5b11-ae37-62b736f5ff29" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186138511 :knowledge-point/questions ["question-8e8a0eda-6609-511f-9732-1a6312007048"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8e8a0eda-6609-511f-9732-1a6312007048" :question/id #uuid "8e8a0eda-6609-511f-9732-1a6312007048" :question/math-academy-id "q-175581" :question/problem "$\\frac{2}{5}x+4y+\\frac{5}{2}x+3y=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{2}{5}x+4y+\\frac{5}{2}x+3y & = \\\\ (\\frac{2}{5}x+\\frac{5}{2}x)+(4y+3y) & = \\\\ (\\frac{2}{5}+\\frac{5}{2})x+(4+3)y & = \\\\ (\\frac{4}{10}+\\frac{25}{10})x+7y & = \\\\ (\\frac{4+25}{10})x+7y & = \\\\ \\frac{29}{10}\\,x+7\\,y\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cebc456f-ee3c-58cf-96e7-c237efa764f7" "answer-field-aa265d47-40f3-5a3f-9bf0-25685f2be3fa"] :db/ensure [:question/validate]} {:db/id "answer-field-cebc456f-ee3c-58cf-96e7-c237efa764f7" :answer-field/id #uuid "cebc456f-ee3c-58cf-96e7-c237efa764f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6ee09fa0-6224-5178-b8f9-36c108594771" :answer-field/choices ["answer-6ee09fa0-6224-5178-b8f9-36c108594771"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ee09fa0-6224-5178-b8f9-36c108594771" :answer/id #uuid "6ee09fa0-6224-5178-b8f9-36c108594771" :answer/type :answer.type/math :answer/value "\\frac{29}{10}" :db/ensure [:answer/validate]} {:db/id "answer-field-aa265d47-40f3-5a3f-9bf0-25685f2be3fa" :answer-field/id #uuid "aa265d47-40f3-5a3f-9bf0-25685f2be3fa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7dda24c2-846e-5ae5-9e55-258b14393706" :answer-field/choices ["answer-7dda24c2-846e-5ae5-9e55-258b14393706"] :db/ensure [:answer-field/validate]} {:db/id "answer-7dda24c2-846e-5ae5-9e55-258b14393706" :answer/id #uuid "7dda24c2-846e-5ae5-9e55-258b14393706" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186064258 :knowledge-point/questions ["question-f3e4db00-9ed0-5e91-8213-2ca14aefffbb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f3e4db00-9ed0-5e91-8213-2ca14aefffbb" :question/id #uuid "f3e4db00-9ed0-5e91-8213-2ca14aefffbb" :question/math-academy-id "q-103625" :question/problem "If $\\frac{5x-10y-2z}{5}$ is written in the form $ax+by+cz,$ what are the values of  $a,$ $b$ and $c?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{5x-10y-2z}{5} & = \\\\ \\frac{5x}{5}-\\frac{10y}{5}-\\frac{2z}{5} & = \\\\ \\frac{5}{5}\\cdot x-\\frac{10}{5}\\cdot y-\\frac{2}{5}\\cdot z & = \\\\ 1\\cdot x-2\\cdot y-\\frac{2}{5}\\cdot z & = \\\\ x-2y-\\frac{2z}{5} & .\\end{aligned}\n$$\n\nWriting the above in the form $ax+by+cz,$ we get\n\n$$\n\\begin{aligned}{{(1)}_{⏟}}_{a}x+{{(-2)}_{⏟}}_{b}y+{{(-\\frac{2}{5})}_{⏟}}_{c}z.\\end{aligned}\n$$\n\nTherefore,  $a=1,$ $b=-2$ and $c=-\\frac{2}{5}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ac144df-2131-57c9-bfbb-43bd44e355e9"] :db/ensure [:question/validate]} {:db/id "answer-field-9ac144df-2131-57c9-bfbb-43bd44e355e9" :answer-field/id #uuid "9ac144df-2131-57c9-bfbb-43bd44e355e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fc3e3b6b-5c5d-5998-9365-602913fed818" :answer-field/choices ["answer-fc3e3b6b-5c5d-5998-9365-602913fed818" "answer-86d1e6a6-32cc-5370-9d0c-04db2526ab57" "answer-bd7d356d-5fef-5042-be30-4689b4b9777a" "answer-2385595f-7f7d-5bcb-b6db-b0de1f32a65b" "answer-5bd91c40-af18-5c9d-b794-20c583df8cb8"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc3e3b6b-5c5d-5998-9365-602913fed818" :answer/id #uuid "fc3e3b6b-5c5d-5998-9365-602913fed818" :answer/type :answer.type/text :answer/value "$a=1,$ $b=-2$ and $c=-\\frac{2}{5}$" :db/ensure [:answer/validate]} {:db/id "answer-86d1e6a6-32cc-5370-9d0c-04db2526ab57" :answer/id #uuid "86d1e6a6-32cc-5370-9d0c-04db2526ab57" :answer/type :answer.type/text :answer/value "$a=1,$ $b=-2$ and $c=2$" :db/ensure [:answer/validate]} {:db/id "answer-bd7d356d-5fef-5042-be30-4689b4b9777a" :answer/id #uuid "bd7d356d-5fef-5042-be30-4689b4b9777a" :answer/type :answer.type/text :answer/value "$a=1,$ $b=\\frac{1}{5}$ and $c=-\\frac{2}{5}$" :db/ensure [:answer/validate]} {:db/id "answer-2385595f-7f7d-5bcb-b6db-b0de1f32a65b" :answer/id #uuid "2385595f-7f7d-5bcb-b6db-b0de1f32a65b" :answer/type :answer.type/text :answer/value "$a=2,$ $b=-2$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "answer-5bd91c40-af18-5c9d-b794-20c583df8cb8" :answer/id #uuid "5bd91c40-af18-5c9d-b794-20c583df8cb8" :answer/type :answer.type/text :answer/value "$a=\\frac{1}{5},$ $b=2$ and $c=\\frac{2}{5}$" :db/ensure [:answer/validate]} {:db/id 17592186138537 :knowledge-point/questions ["question-8a9682b8-c5c3-5a53-a91f-bba592503325"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8a9682b8-c5c3-5a53-a91f-bba592503325" :question/id #uuid "8a9682b8-c5c3-5a53-a91f-bba592503325" :question/math-academy-id "q-181308" :question/problem "![](images/87/878fd1c82e5d634e9090d9e7b49faf3a92135c8679d309e72505af6d201d5e80.png)\n\nThe inequality corresponding to the highlighted region shown above is $x${{field-1}}\n$-2\\text{ or }x$\n{{field-2}}$1.$" :question/worked-solution "The red rays contain all values less than $-2$ or greater than $1.$ In addition, \n\n- the open circle at $-2$ implies that $x$ cannot be equal to $-2,$ and\n\n- the open circle at $1$ implies that $x$ cannot be equal to $2.$\n\nTherefore, the highlighted region represents $x<-2$ or $x>1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9731d226-3a56-501c-99bb-44ed05bb4dd9" "answer-field-420e3038-9379-5f1b-bacb-cd8a79d07923"] :db/ensure [:question/validate]} {:db/id "answer-field-9731d226-3a56-501c-99bb-44ed05bb4dd9" :answer-field/id #uuid "9731d226-3a56-501c-99bb-44ed05bb4dd9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e4bd58a2-759b-5017-9df7-097ec85ef0de" :answer-field/choices ["answer-e4bd58a2-759b-5017-9df7-097ec85ef0de"] :db/ensure [:answer-field/validate]} {:db/id "answer-e4bd58a2-759b-5017-9df7-097ec85ef0de" :answer/id #uuid "e4bd58a2-759b-5017-9df7-097ec85ef0de" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-420e3038-9379-5f1b-bacb-cd8a79d07923" :answer-field/id #uuid "420e3038-9379-5f1b-bacb-cd8a79d07923" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8298bf8e-c7b2-5ff5-a08a-84e187a9e365" :answer-field/choices ["answer-8298bf8e-c7b2-5ff5-a08a-84e187a9e365"] :db/ensure [:answer-field/validate]} {:db/id "answer-8298bf8e-c7b2-5ff5-a08a-84e187a9e365" :answer/id #uuid "8298bf8e-c7b2-5ff5-a08a-84e187a9e365" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id 17592186105743 :knowledge-point/questions ["question-4305d4d8-cadf-560e-80db-63776f30d2a1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4305d4d8-cadf-560e-80db-63776f30d2a1" :question/id #uuid "4305d4d8-cadf-560e-80db-63776f30d2a1" :question/math-academy-id "q-100739" :question/problem "${(\\frac{1}{5})}^{3}=$" :question/worked-solution "To raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3:$\n\n$$\n{(\\frac{1}{5})}^{3}=\\frac{{1}^{3}}{{5}^{3}}\n$$\n\nNow, using ${1}^{3}=1$ and ${5}^{3}=125,$ we get\n\n$$\n\\frac{{1}^{3}}{{5}^{3}}=\\frac{1}{125}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ba8ba35a-49bb-57fe-8e35-5eb9d11c64aa"] :db/ensure [:question/validate]} {:db/id "answer-field-ba8ba35a-49bb-57fe-8e35-5eb9d11c64aa" :answer-field/id #uuid "ba8ba35a-49bb-57fe-8e35-5eb9d11c64aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0a5c6d33-1d35-5904-b068-cc3598e10f87" :answer-field/choices ["answer-0a5c6d33-1d35-5904-b068-cc3598e10f87" "answer-6869578e-010a-5d61-92d2-4038d52299fc" "answer-eb31a0c1-bfa5-5c81-aff5-37d4792278fa" "answer-6420deb4-465e-555a-a374-d785308e82a9" "answer-8cf77517-9738-5543-8399-498bb9e2609f"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a5c6d33-1d35-5904-b068-cc3598e10f87" :answer/id #uuid "0a5c6d33-1d35-5904-b068-cc3598e10f87" :answer/type :answer.type/math :answer/value "\\frac{1}{125}" :db/ensure [:answer/validate]} {:db/id "answer-6869578e-010a-5d61-92d2-4038d52299fc" :answ