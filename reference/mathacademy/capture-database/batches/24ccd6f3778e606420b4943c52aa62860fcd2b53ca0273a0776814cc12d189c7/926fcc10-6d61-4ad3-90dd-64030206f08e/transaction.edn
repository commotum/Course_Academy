:answer-field/correct "answer-d662cd56-f43e-5893-a18d-fa83a1f38571" :answer-field/choices ["answer-d662cd56-f43e-5893-a18d-fa83a1f38571" "answer-99a357c6-c0c5-5d3b-b661-3b8b54f72857" "answer-678d6038-e825-59c6-9971-c48d2d865e2c" "answer-7f802149-1074-5318-89ed-42dc0eb547dd" "answer-6a32989d-8835-56eb-bcbc-90b2a1086778"] :db/ensure [:answer-field/validate]} {:db/id "answer-d662cd56-f43e-5893-a18d-fa83a1f38571" :answer/id #uuid "d662cd56-f43e-5893-a18d-fa83a1f38571" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-99a357c6-c0c5-5d3b-b661-3b8b54f72857" :answer/id #uuid "99a357c6-c0c5-5d3b-b661-3b8b54f72857" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-678d6038-e825-59c6-9971-c48d2d865e2c" :answer/id #uuid "678d6038-e825-59c6-9971-c48d2d865e2c" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-7f802149-1074-5318-89ed-42dc0eb547dd" :answer/id #uuid "7f802149-1074-5318-89ed-42dc0eb547dd" :answer/type :answer.type/math :answer/value "\\frac{12}{17}" :db/ensure [:answer/validate]} {:db/id "answer-6a32989d-8835-56eb-bcbc-90b2a1086778" :answer/id #uuid "6a32989d-8835-56eb-bcbc-90b2a1086778" :answer/type :answer.type/text :answer/value "The slope is undefined" :db/ensure [:answer/validate]} {:db/id "question-9ded7e32-d6f0-5c00-a36c-5bd0cb7be591" :question/id #uuid "9ded7e32-d6f0-5c00-a36c-5bd0cb7be591" :question/math-academy-id "q-7364" :question/problem "![](images/6c/6cc013b8a23067a1da77ec7a33a0be0d00d5d18ee1f4654e73acd5f388b76962.png)\n\nWhich of the following best describes the slope of the graph above?" :question/worked-solution "Remember that slope is the amount the line rises vertically per unit that it runs horizontally.\n\nSince the graph decreases ($↘$) as we go from left to right, the line rises by a negative amount.\n\nTherefore, the slope of the line is negative." :question/difficulty :question.difficulty/easy :question/a