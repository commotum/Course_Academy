d "answer-40a85261-cfab-5279-bc88-4ad582c5e156" :answer/id #uuid "40a85261-cfab-5279-bc88-4ad582c5e156" :answer/type :answer.type/math :answer/value "{x}^{5}" :db/ensure [:answer/validate]} {:db/id "answer-3d07857e-d64a-5376-a325-458a741d04e9" :answer/id #uuid "3d07857e-d64a-5376-a325-458a741d04e9" :answer/type :answer.type/math :answer/value "{x}^{6}" :db/ensure [:answer/validate]} {:db/id "question-7907920d-205f-5377-afe5-d6463114236a" :question/id #uuid "7907920d-205f-5377-afe5-d6463114236a" :question/math-academy-id "q-22371" :question/problem "Find $n$ such that  ${a}^{2}\\cdot {a}^{3}\\cdot {a}^{4}={a}^{n}$  is correct." :question/worked-solution "We add the exponents, as follows:\n\n$$\n\\begin{aligned}{a}^{2}\\cdot {a}^{3}\\cdot {a}^{4} & = \\\\ {a}^{(2+3+4)} & = \\\\ {a}^{9}\\end{aligned}\n$$\n\nTherefore ${a}^{n}={a}^{9}$, so $n=9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-96ae24e2-5006-5a83-a03f-bea224f75aee"] :db/ensure [:question/validate]} {:db/id "answer-field-96ae24e2-5006-5a83-a03f-bea224f75aee" :answer-field/id #uuid "96ae24e2-5006-5a83-a03f-bea224f75aee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1fb4f86a-5824-53e7-b06b-eae5d318b941" :answer-field/choices ["answer-e9fc6f9a-d398-50b4-9cff-c334ca944fe1" "answer-8a4a55fc-8448-5c08-9c7a-c0eccb5983f0" "answer-dd6d9510-cb9d-5190-ad74-b673c7f23c44" "answer-847e9538-1bc6-5da0-86d9-ab816861e8cb" "answer-1fb4f86a-5824-53e7-b06b-eae5d318b941"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9fc6f9a-d398-50b4-9cff-c334ca944fe1" :answer/id #uuid "e9fc6f9a-d398-50b4-9cff-c334ca944fe1" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-8a4a55fc-8448-5c08-9c7a-c0eccb5983f0" :answer/id #uuid "8a4a55fc-8448-5c08-9c7a-c0eccb5983f0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-dd6d9510-cb9d-5190-ad74-b673c7f23c4