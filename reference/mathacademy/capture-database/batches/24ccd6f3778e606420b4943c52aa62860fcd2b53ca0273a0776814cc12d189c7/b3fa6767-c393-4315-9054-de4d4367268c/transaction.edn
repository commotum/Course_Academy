-83d9-e345ab9699a0" "answer-abc56047-6d02-57a1-b8af-f987bcd050f0"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd2ea4a9-efac-5d78-b430-32dd93514470" :answer/id #uuid "bd2ea4a9-efac-5d78-b430-32dd93514470" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ed82bd75-d018-52b9-b634-b016094ffb38" :answer/id #uuid "ed82bd75-d018-52b9-b634-b016094ffb38" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 \\\\ -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-56617e11-a212-55bd-9576-f212ce9c00a0" :answer/id #uuid "56617e11-a212-55bd-9576-f212ce9c00a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}15 \\\\ -12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-71e620f2-2d1b-540f-83d9-e345ab9699a0" :answer/id #uuid "71e620f2-2d1b-540f-83d9-e345ab9699a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}15 \\\\ 3 \\\\ -12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-abc56047-6d02-57a1-b8af-f987bcd050f0" :answer/id #uuid "abc56047-6d02-57a1-b8af-f987bcd050f0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-fc550b7f-6e92-5df1-a72d-54e40643e133" :question/id #uuid "fc550b7f-6e92-5df1-a72d-54e40643e133" :question/math-academy-id "q-97589" :question/problem "$$\nB=\\{[\\begin{aligned}1 \\\\ -3\\end{aligned}],[\\begin{aligned}0 \\\\ 3\\end{aligned}]\\},\\,[T]_{B|C}=[\\begin{aligned}2 & 4 \\\\ 8 & 1 \\\\ 7 & 9\\end{aligned}],\\,x=[\\begin{aligned}1 \\\\ -6\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=[\\begin{aligned}1 \\\\ -6\\end{aligned}]={x}_{1}[\\begin{aligned}1 \\\\ -3\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 3\\end{aligned}].\n$$\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}{x}_{1}=1 \\\\ -3{x}_{1}+3{x}_{2}=-6.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 0 & 1 \\\\ -3 & 3 & -6\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 3 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}1 \\\\ -1\\end{aligned}].$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}2 & 4 \\\\ 8 & 1 \\\\ 7 & 9\\end{aligned}][\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 7 \\\\ -2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ce679d09-ac04-52d4-b77b-07e1721ea8d2"] :db/ensure [:question/validate]} {:db/id "answer-field-ce679d09-ac04-52d4-b77b-07e1721ea8d2" :answer-field/id #uuid "ce679d09-ac04-52d4-b77b-07e1721ea8d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a28d6132-1d8e-5724-a07d-6971ca3567ac" :answer-field/choices ["answer-e332b530-85d0-5d7e-a5be-150ed9ff7435" "answer-bf252bd4-6469-59c0-8687-e65f303aa93b" "answer-cd84be47-ba2b-5391-a8b6-48c42bfc3182" "answer-a28d6132-1d8e-5724-a07d-6971ca3567ac" "answer-c65e8608-9b76-56f3-ab38-505b05e017bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-e332b530-85d0-5d7e-a5be-150ed9ff7435" :answer/id #uuid "e332b530-85d0-5d7e-a5be-150ed9ff7435" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bf252bd4-6469-59c0-8687-e65f303aa93b" :answer/id #uuid "bf252bd4-6469-59c0-8687-e65f303aa93b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 7 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cd84be47-ba2b-5391-a8b6-48c42bfc3182" :answer/id #uuid "cd84be47-ba2b-5391-a8b6-48c42bfc3182" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 5 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a28d6132-1d8e-5724-a07d-6971ca3567ac" :answer/id #uuid "a28d6132-1d8e-5724-a07d-6971ca3567ac" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 7 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c65e8608-9b76-56f3-ab38-505b05e017bf" :answer/id #uuid "c65e8608-9b76-56f3-ab38-505b05e017bf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-fcef5190-a033-5c84-9651-3cf919b057c9" :question/id #uuid "fcef5190-a033-5c84-9651-3cf919b057c9" :question/math-academy-id "q-97582" :question/problem "$$\nB=\\{[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}3 \\\\ 9\\end{aligned}]\\},\\,[T]_{B|C}=[\\begin{aligned}1 & 5 \\\\ 3 & 2 \\\\ 2 & 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ -2\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=[\\begin{aligned}2 \\\\ -2\\end{aligned}]={x}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}3 \\\\ 9\\end{aligned}].\n$$\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+3{x}_{2}=2 \\\\ 2{x}_{1}+9{x}_{2}=-2.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 2 \\\\ 2 & 9 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 3 & -6\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 1 & -2\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+(-3){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 8 \\\\ 0 & 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}8 \\\\ -2\\end{aligned}].$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}1 & 5 \\\\ 3 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}8 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 20 \\\\ 14\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-851e1d62-f928-5cf2-bd67-94c62fcd5262"] :db/ensure [:question/validate]} {:db/id "answer-field-851e1d62-f928-5cf2-bd67-94c62fcd5262" :answer-field/id #uuid "851e1d62-f928-5cf2-bd67-94c62fcd5262" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fbf6ec06-6876-5b3d-a8d5-9db339d794c2" :answer-field/choices ["answer-fbf6ec06-6876-5b3d-a8d5-9db339d794c2" "answer-8aaf2c0c-dd2e-5921-873c-4712cba0c50f" "answer-9e29c21b-0cb0-546e-800f-baae9705e68c" "answer-bec8cfba-4845-5925-99ab-2a603a385da9" "answer-7031b44d-1e9b-52c9-93b5-f0f954e92248"] :db/ensure [:answer-field/validate]} {:db/id "answer-fbf6ec06-6876-5b3d-a8d5-9db339d794c2" :answer/id #uuid "fbf6ec06-6876-5b3d-a8d5-9db339d794c2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 20 \\\\ 14\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8aaf2c0c-dd2e-5921-873c-4712cba0c50f" :answer/id #uuid "8aaf2c0c-dd2e-5921-873c-4712cba0c50f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 15 \\\\ 13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9e29c21b-0cb0-546e-800f-baae9705e68c" :answer/id #uuid "9e29c21b-0cb0-546e-800f-baae9705e68c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 20 \\\\ 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bec8cfba-4845-5925-99ab-2a603a385da9" :answer/id #uuid "bec8cfba-4845-5925-99ab-2a603a385da9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7031b44d-1e9b-52c9-93b5-f0f954e92248" :answer/id #uuid "7031b44d-1e9b-52c9-93b5-f0f954e92248" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186125253 :question/problem "$$\nB=\\{[\\begin{aligned}1 \\\\ -4\\end{aligned}],[\\begin{aligned}2 \\\\ -7\\end{aligned}]\\},\\,[T]_{B|C}=[\\begin{aligned}3 & 2 \\\\ 1 & 1 \\\\ 4 & 6\\end{aligned}],\\,x=[\\begin{aligned}-1 \\\\ 6\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=[\\begin{aligned}-1 \\\\ 6\\end{aligned}]={x}_{1}[\\begin{aligned}1 \\\\ -4\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ -7\\end{aligned}].\n$$\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=-1 \\\\ -4{x}_{1}-7{x}_{2}=6.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -1 \\\\ -4 & -7 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+4{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+(-2){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & -5 \\\\ 0 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-5 \\\\ 2\\end{aligned}].$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}3 & 2 \\\\ 1 & 1 \\\\ 4 & 6\\end{aligned}][\\begin{aligned}-5 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}-11 \\\\ -3 \\\\ -8\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186395295 :question/problem "$$\nB=\\{[\\begin{aligned}-1 \\\\ 3\\end{aligned}],[\\begin{aligned}-2 \\\\ 7\\end{aligned}]\\},\\,[T]_{B|C}=[\\begin{aligned}3 & 7 \\\\ 3 & 8 \\\\ 2 & 6\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ -5\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=[\\begin{aligned}3 \\\\ -5\\end{aligned}]={x}_{1}[\\begin{aligned}-1 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-2 \\\\ 7\\end{aligned}].\n$$\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}-{x}_{1}-2{x}_{2}=3 \\\\ 3{x}_{1}+7{x}_{2}=-5.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & -2 & 3 \\\\ 3 & 7 & -5\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & -3 \\\\ 3 & 7 & -5\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-3){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 2 & -3 \\\\ 0 & 1 & 4\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+(-2){R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & -11 \\\\ 0 & 1 & 4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-11 \\\\ 4\\end{aligned}].$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}3 & 7 \\\\ 3 & 8 \\\\ 2 & 6\\end{aligned}][\\begin{aligned}-11 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ -1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186395302 :question/problem "$$\nB=\\{[\\begin{aligned}-1 \\\\ 2\\end{aligned}],[\\begin{aligned}3 \\\\ -5\\end{aligned}]\\},\\,[T]_{B|C}=[\\begin{aligned}1 & 3 \\\\ 1 & -2 \\\\ -4 & 9\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ -1\\end{aligned}]\n$$\n\nConsider the basis $B$ of ${R}^{2}$ (shown above) and a basis $C$ of ${R}^{3}.$\nThe matrix $[T]_{B|C}$ of the linear map $T:{R}^{2}\\to {R}^{3}$ relative to these bases, and the vector $x\\in {R}^{2},$ are also given. Find $[T(x)]_{C}.$" :question/worked-solution "We can find the coordinates of the image of $x$ under $T$ relative to the basis $C$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[x]_{B},$ the coordinates of $x$ relative to $B.$ So, let\n\n$$\nx=[\\begin{aligned}2 \\\\ -1\\end{aligned}]={x}_{1}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}3 \\\\ -5\\end{aligned}].\n$$\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}-{x}_{1}+3{x}_{2}=2 \\\\ 2{x}_{1}-5{x}_{2}=-1.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 3 & 2 \\\\ 2 & -5 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & -2 \\\\ 2 & -5 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & -2 \\\\ 0 & 1 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 \\\\ 0 & 1 & 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}7 \\\\ 3\\end{aligned}].$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}1 & 3 \\\\ 1 & -2 \\\\ -4 & 9\\end{aligned}][\\begin{aligned}7 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ 1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186125799 :tutorial/content "Let's suppose we have the linear map\n\n$$\n\\mathbf T: {\\color{blue}V} \\to {\\color{red}W}\n$$\n\nwhere the bases of the vector spaces $\\color{blue}V$ and ${\\color{red}W}$ respectively are given by\n\n$$\n{\\color{blue}\\mathcal{B}}=\\{ {\\color{blue}\\mathbf{b}_1},{\\color{blue}\\mathbf{b}_2}, {\\color{blue}\\mathbf{b}_3} \\}, \\qquad \\qquad {\\color{red}\\mathcal{C}} = \\{ {\\color{red}\\mathbf{c}_1},{\\color{red}\\mathbf{c}_2} \\}.\n$$\n\nThe **matrix of $\\mathbf{T}$ with respect to the bases $\\color{blue}\\mathcal{B}$ and $\\color{red}\\mathcal{C}$** is the matrix whose columns are the coordinates of the vectors $\\mathbf{T}({\\color{blue}\\mathbf{b}_1}),$ $\\mathbf{T}(\\color{blue}{\\mathbf{b}_2}),$ and $\\mathbf{T}({\\color{blue}\\mathbf{b}_3})$ relative to the basis ${\\color{red}\\mathcal{C}}\\mathbin{:}$\n\n$$\n\\begin{aligned}[T]_{B|C} & =[\\begin{aligned}| & | & | \\\\ [T({b}_{1})]_{C} & [T({b}_{2})]_{C} & [T({b}_{3})]_{C} \\\\ | & | & |\\end{aligned}]\\end{aligned}\n$$\n\nFor example, if \n\n![](images/be/be8cff88ef83ebc67d0df7a50a243c55c8f11aa92e7a07f64b73bb30ed701392.svg)\n\nthen\n\n$$\n\\begin{aligned}[T]_{B|C} & =[\\begin{aligned}3 & 10 & -12 \\\\ 1 & -1 & 0\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186125843 :tutorial/content "Given the matrix $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ of a linear map $\\mathbf{T}:V \\to W$ relative to the bases $\\mathcal{B}$ and $\\mathcal{C},$ and the coordinates $[\\mathbf{x}]_{\\mathcal{B}}$ of a vector $\\mathbf{x}$ relative to $\\mathcal{B},$ the image of $\\mathbf{x}$ under $\\mathbf{T}$ with respect to the basis $\\mathcal{C}$ can be found as \n\n$$\n[\\mathbf{T}(\\mathbf{x})]_{\\mathcal{C}} = \n[\\mathbf{T}]_{{\\mathcal{B}}|{\\mathcal{C}}}\\cdot [\\mathbf{x}]_{\\mathcal{B}}\n$$\n\nFor example, if\n\n![](images/e3/e3623ffb88602004ad3ab01f55976d3a55759563a6088f4e2a10b7b8849a6f70.svg)\n\nthen the image of $\\mathbf x$ under $\\mathbf T$ relative to $\\mathcal C$ is given by\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[\\begin{aligned}1 & 3 & -2 \\\\ 1 & 2 & 0\\end{aligned}][\\begin{aligned}3 \\\\ 0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186124752 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186119749 :knowledge-point/questions ["question-1fed5aa4-7f90-50cb-8379-da324cfd5754"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1fed5aa4-7f90-50cb-8379-da324cfd5754" :question/id #uuid "1fed5aa4-7f90-50cb-8379-da324cfd5754" :question/math-academy-id "q-80612" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows:\n\n$$\n\\begin{aligned}{r}^{′}(t)={e}^{t}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t+\\operatorname{sin}⁡t⟩,\\,{T}^{′}(t)=-\\frac{\\sqrt{2}}{2}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t),$ we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${T}^{′}(t)$ and ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =|-\\frac{\\sqrt{2}}{2}|\\sqrt{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{({sin}^{2}⁡t+{cos}^{2}⁡t)+({sin}^{2}⁡t+{cos}^{2}⁡t)+(2\\operatorname{cos}⁡t\\operatorname{sin}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t)} \\\\  & =\\frac{\\sqrt{2}}{2}\\sqrt{1+1+0} \\\\  & =\\frac{\\sqrt{2}}{2}\\cdot \\sqrt{2} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & ={e}^{t}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)^{2}} \\\\  & ={e}^{t}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{cos}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t} \\\\  & ={e}^{t}\\sqrt{({cos}^{2}⁡t+{sin}^{2}⁡t)+({cos}^{2}⁡t+{sin}^{2}⁡t)+(-2\\operatorname{cos}⁡t\\operatorname{sin}⁡t+2\\operatorname{cos}⁡t\\operatorname{sin}⁡t)} \\\\  & ={e}^{t}\\sqrt{1+1+0} \\\\  & =\\sqrt{2}\\,{e}^{t}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{\\sqrt{2}\\,{e}^{t}}=\\frac{\\sqrt{2}\\,{e}^{-t}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fiel