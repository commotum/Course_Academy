on-f547ee15-afb9-5d4d-aac5-f9873224d21b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068518 :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2x+4}{2} & =\\frac{2(x+2)}{2} \\\\  & =\\frac{\\cancel{2}(x+2)}{\\cancel{2}\\cdot 1} \\\\  & =\\frac{x+2}{1} \\\\  & =x+2\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186068805 :knowledge-point/questions ["question-f0246a82-44c1-5a59-b982-f15157d4b614" "question-231799e9-4704-5d9f-b2f6-cf48b4d5352f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068653 :question/problem "Simplify the expression $\\dfrac {6y + 2} {3xy + x}.$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\require{cancel}\n    \\eqalign{\n        \\dfrac {6y + 2} {3xy + x} &= \\dfrac {6y + 2} {x(3y + 1)} \\[5pt] \n        &=\\dfrac {2(3y + 1)} {x(3y + 1)} \\[5pt] \n        &=\\dfrac {2\\cancel{(3y + 1)} } {x \\cancel{(3y + 1)} } \\[5pt] \n        &=\\dfrac {2 } {x}\n    }\n$$" :db/ensure [:question/validate]} {:db/id 17592186068889 :knowledge-point/questions ["question-b05961ea-7cec-59e4-8ae8-a6a605cc8a04" "question-e0e6ef2d-42da-5ca5-a10f-a17af46a57dd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068517 :question/worked-solution "The numerator and denominator have no common factors, so the expression can not be reduced. The expression \n\n$$\n\\dfrac{x+2}{2x}\n$$\n\n is already in lowest terms." :db/ensure [:question/validate]} {:db/id 17592186068806 :knowledge-point/questions ["question-f2d8edfd-38f5-52ec-936f-d21ba5dc8f34"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068654 :question/problem "Simplify $\\dfrac{5c + 10p - 20}{5p+15}.$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n![](images/82/82b6ffda3164ec24147f28968a08f6d96bf64a2ec9aaf261f673c171dd1b1f40.svg)" :db/ensure [:question/validate]} {:db/id "question-a20b2350-f097-5c4b-94a3-d4c34935aa0d" :question/id #uuid "a20b2350-f097-5c4b-94a3-d4c34935aa0d" :question/math-academy-id "q-3481" :question/problem "$\\frac{5r+35}{5}=$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{5r+35}{5} & =\\frac{5(r+7)}{5\\cdot 1} \\\\  & =\\frac{\\cancel{5}(r+7)}{\\cancel{5}\\cdot 1} \\\\  & =\\frac{r+7}{1} \\\\  & =r+7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3c5d3a25-10cb-5947-bfea-1d6f901fd5dd"] :db/ensure [:question/validate]} {:db/id "answer-field-3c5d3a25-10cb-5947-bfea-1d6f901fd5dd" :answer-field/id #uuid "3c5d3a25-10cb-5947-bfea-1d6f901fd5dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a04beebc-4ac5-54ed-bf80-b3891484dbb1" :answer-field/choices ["answer-49e8f124-37d7-5435-b3d7-213957a05640" "answer-6b658387-1984-5d43-bf33-29295983170d" "answer-659c9ef5-35ab-5cb5-8d84-f57e878c8428" "answer-9c2eb4bb-e69e-5faf-bf81-f54ed3fcb598" "answer-a04beebc-4ac5-54ed-bf80-b3891484dbb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-49e8f124-37d7-5435-b3d7-213957a05640" :answer/id #uuid "49e8f124-37d7-5435-b3d7-213957a05640" :answer/type :answer.type/math :answer/value "5(r+1)" :db/ensure [:answer/validate]} {:db/id "answer-6b658387-1984-5d43-bf33-29295983170d" :answer/id #uuid "6b658387-1984-5d43-bf33-29295983170d" :answer/type :answer.type/math :answer/value "5(r+7)" :db/ensure [:answer/validate]} {:db/id "answer-659c9ef5-35ab-5cb5-8d84-f57e878c8428" :answer/id #uuid "659c9ef5-35ab-5cb5-8d84-f57e878c8428" :answer/type :answer.type/math :answer/value "5r+7" :db/ensure [:answer/validate]} {:db/id "answer-9c2eb4bb-e69e-5faf-bf81-f54ed3fcb598" :answer/id #uuid "9c2eb4bb-e69e-5faf-bf81-f54ed3fcb598" :answer/type :answer.type/math :answer/value "r+5" :db/ensure [:answer/validate]} {:db/id "answer-a04beebc-4ac5-54ed-bf80-b3891484dbb1" :answer/id #uuid "a04beebc-4ac5-54ed-bf80-b3891484dbb1" :answer/type :answer.type/math :answer/value "r+7" :db/ensure [:answer/validate]} {:db/id "question-f547ee15-afb9-5d4d-aac5-f9873224d21b" :question/id #uuid "f547ee15-afb9-5d4d-aac5-f9873224d21b" :question/math-academy-id "q-75356" :question/problem "What is $\\frac{3x+9z}{6x-15z}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{3x+9z}{6x-15z} & =\\frac{3(x+3z)}{3(2x-5z)} \\\\  & =\\frac{\\cancel{3}\\cdot (x+3z)}{\\cancel{3}\\cdot (2x-5z)} \\\\  & =\\frac{x+3z}{2x-5z}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ef3cc7d5-745e-5237-ae37-a71278b0a918"] :db/ensure [:question/validate]} {:db/id "answer-field-ef3cc7d5-745e-5237-ae37-a71278b0a918" :answer-field/id #uuid "ef3cc7d5-745e-5237-ae37-a71278b0a918" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c6348dd8-c736-5d3a-a836-87968c06994b" :answer-field/choices ["answer-b1ab9072-682f-5a10-af55-512c22ddbc0f" "answer-777af3fd-32dc-59e7-b4bf-4bc7221fcd10" "answer-5720b5f6-2ce4-552c-a9cd-ca60386adebd" "answer-c6348dd8-c736-5d3a-a836-87968c06994b" "answer-2e9acd40-95b3-5aff-9205-34fd236fb525"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1ab9072-682f-5a10-af55-512c22ddbc0f" :answer/id #uuid "b1ab9072-682f-5a10-af55-512c22ddbc0f" :answer/type :answer.type/math :answer/value "\\frac{2x-5z}{3x+z}" :db/ensure [:answer/validate]} {:db/id "answer-777af3fd-32dc-59e7-b4bf-4bc7221fcd10" :answer/id #uuid "777af3fd-32dc-59e7-b4bf-4bc7221fcd10" :answer/type :answer.type/math :answer/value "\\frac{3x+z}{5x-2z}" :db/ensure [:answer/validate]} {:db/id "answer-5720b5f6-2ce4-552c-a9cd-ca60386adebd" :answer/id #uuid "5720b5f6-2ce4-552c-a9c