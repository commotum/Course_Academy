content "question-ea9b6670-1349-5317-9261-60b0dc45876e" :step/next "step-226ccdcc-3b60-57f1-a3c3-8f062d46aa86" :db/ensure [:step/validate]} {:db/id "step-226ccdcc-3b60-57f1-a3c3-8f062d46aa86" :step/id #uuid "226ccdcc-3b60-57f1-a3c3-8f062d46aa86" :step/content "question-378ec187-f25a-5aab-8757-77a5a8639517" :step/next "step-4609de71-75bd-5c7c-bcbb-76be563e0fa0" :db/ensure [:step/validate]} {:db/id "step-4609de71-75bd-5c7c-bcbb-76be563e0fa0" :step/id #uuid "4609de71-75bd-5c7c-bcbb-76be563e0fa0" :step/content "question-f2953556-ba6d-59b1-a416-ed49b0dde4d7" :db/ensure [:step/validate]} {:db/id "assigned-problem-7058dc22-3388-5ba7-9205-fbc202710b47" :assigned-problem/id #uuid "7058dc22-3388-5ba7-9205-fbc202710b47" :assigned-problem/content "multistep-aebdb39b-39ee-5d00-9cb7-4aa2d3d454f5" :assigned-problem/topic-coverage [17592186051017 17592186048928 17592186048524 17592186049074 17592186048406 17592186050396 17592186049224 17592186050886 17592186048650] :db/ensure [:assigned-problem/validate]} {:db/id "activity-42495ce1-d225-5c77-b288-ecf54c1d9aa3" :activity/id #uuid "42495ce1-d225-5c77-b288-ecf54c1d9aa3" :activity/title "Factoring Polynomials Using Various Techniques" :activity/type :activity.type/assignment :activity/steps ["step-9fb35eae-9893-5e59-bd3f-76d3e2c4bfec"] :activity/first-step "step-9fb35eae-9893-5e59-bd3f-76d3e2c4bfec" :db/ensure [:activity/validate]} {:db/id "step-9fb35eae-9893-5e59-bd3f-76d3e2c4bfec" :step/id #uuid "9fb35eae-9893-5e59-bd3f-76d3e2c4bfec" :step/content "assigned-problem-7058dc22-3388-5ba7-9205-fbc202710b47" :db/ensure [:step/validate]} {:db/id 17592186124603 :knowledge-point/questions ["question-a7b00f3c-cf97-5a00-9aea-1a5f4575fc82" "question-6d02bc4b-8130-57f6-83ee-f4c23a8ee855" "question-d65cfc4f-129a-584c-86e4-865a0ea5e2d3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124415 :question/worked-solution "First, we write the images of vectors in $\\mathcal{B}$ relative to the basis $\\mathcal{C} \\mathbin{:}$ \n\n$$\n\\begin{aligned}T({b}_{1})=-3{c}_{1}+5{c}_{2} & \\,⟹\\,[T({b}_{1})]_{C}=[\\begin{aligned}-3 \\\\ 5\\end{aligned}] \\\\ T({b}_{2})={c}_{2}-2{c}_{1} & \\,⟹\\,[T({b}_{2})]_{C}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\ T({b}_{3})={c}_{1}+5{c}_{2} & \\,⟹\\,[T({b}_{3})]_{C}=[\\begin{aligned}1 \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nNow, $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ is the matrix whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2)$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{C}\\mathbin{:}$\n\n![](images/9c/9c62d029595cc269463dcd6fc6ee0d510cb98379823b25c181906a9d3c31085c.svg)" :db/ensure [:question/validate]} {:db/id 17592186124604 :knowledge-point/questions ["question-537bf679-c812-55fa-b501-947966556962" "question-53cc1ac5-9894-5a1e-9795-bc748bbd204d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124416 :question/problem "Consider the basis $\\mathcal{B}=\\{\\mathbf{b}_1, \\mathbf{b}_2, \\mathbf{b}_3\\}$ of the vector space $V$ and the basis $\\mathcal{C}$ of $\\mathbb{R}^2$ given by\n![](images/32/324c42ad6277fdf7b59b1ec9ceed977debe4d659187624a261a0e7175911c1dd.svg)\n\nFind the matrix $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ of the map $\\mathbf{T}:V \\to \\mathbb{R}^2$ relative to these bases if \n![](images/90/903982d37fc42c27b8ded5d6de1189c2407a1ee2183019d25fe86b47813e38b5.svg)" :question/worked-solution "Recall that $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ is the matrix whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{C}.$\n\nFirst, we need to find the coordinates of $\\mathbf{T}(\\mathbf{b}_i)$ relative to the basis $\\mathcal{C}$ for each $i=1,2,3.$ We can do this simultaneously by considering the following matrix:\n\n![](images/79/79119f75c40495aebb7b37013c8a390dbf52eaeec501e62a965d3e5925d51f35.svg)\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 4 & 1 & -3 & 7 \\\\ 1 & -3 & 2 & -5 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -4 & -1 & 3 & -7 \\\\ 1 & -3 & 2 & -5 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -4 & -1 & 3 & -7 \\\\ 0 & 1 & 3 & -8 & 8\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+4{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 11 & -29 & 25 \\\\ 0 & 1 & 3 & -8 & 8\\end{aligned}]\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $\\mathcal{B}$ and $\\mathcal{C} \\mathbin{:}$\n\n![](images/2a/2aa5592cc6346c444c0a49b8e3a6266c509adc13b2b8be10fdf0b43af6fbd220.svg)" :db/ensure [:question/validate]} {:db/id 17592186124542 :knowledge-point/questions ["question-ee0c45a3-ebaf-5f7e-ac01-ecc7dd1f5cb9" "question-a05da4cd-65c8-508f-a2ce-a7cea728523b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124351 :question/problem "![](images/9f/9f39d604d602f4813ded4f4604e70ee5ca21e8b4f8a53c059dfb61db9d1623ba.svg)\n\nSuppose $\\mathcal{B}$ and $\\mathcal{C}$ are bases of the vector spaces $V$ and $W,$ respectively. The matrix $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ of the linear map $\\mathbf{T}:V \\rightarrow W$ relative to these bases, and the coordinates of the vector $\\mathbf{x} \\in V$ relative to $\\mathcal{B}$ are shown above. Find $[\\mathbf{T}(\\mathbf{x})]_{\\mathcal{C}}.$" :db/ensure [:question/validate]} {:db/id 17592186124543 :knowledge-point/questions ["question-fc550b7f-6e92-5df1-a72d-54e40643e133" "question-fcef5190-a033-5c84-9651-3cf919b057c9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124352 :question/problem "![](images/06/0609d1fd076c5913c8e26bf1dca823c60fb029ec5832ce34734dd4f80b82527d.svg)\n\nConsider the basis $\\mathcal{B}$ of $\\mathbb{R}^2$ (shown above) and a basis $\\mathcal{C}$ of $\\mathbb{R}^3.$\nThe matrix $[\\mathbf{T}]_{\\mathcal{B}|\\mathcal{C}}$ of the linear map $\\mathbf{T}:\\mathbb{R}^2 \\rightarrow \\mathbb{R}^3$ relative to these bases, and the vector $\\mathbf{x} \\in \\mathbb{R}^2,$ are also given. Find $[\\mathbf{T}(\\mathbf{x})]_{\\mathcal{C}}.$" :question/worked-solution "We can find the coordinates of the image of $\\mathbf{x}$ under $\\mathbf{T}$ relative to the basis $\\mathcal{C}$ as follows:\n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B}\\end{aligned}\n$$\n\nFirst, we need to find $[\\mathbf{x}]_{\\mathcal{B}},$ the coordinates of $\\mathbf{x}$ relative to $\\mathcal{B}.$ So, let\n\n![](images/a2/a244da85e128687b438d43ee49c8ee5b0bf864c0b36add61c382a7dff70dad66.svg)\n\nThis gives us the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{2}=5 \\\\ 4{x}_{1}-5{x}_{2}=2.\\end{aligned}\n$$\n\nWe now row-reduce the corresponding augmented matrix using Gaussian elimination, as follows: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 5 \\\\ 4 & -5 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-4){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -2 & 5 \\\\ 0 & 3 & -18\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{3}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -2 & 5 \\\\ 0 & 1 & -6\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+2{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & -7 \\\\ 0 & 1 & -6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, ![](images/ef/ef57f78641f939448e504b4ada6d538fef7a2800f130badb5c4970e3d2b1d4d1.svg)\n\nFinally, we obtain \n\n$$\n\\begin{aligned}[T(x)]_{C} & =[T]_{B|C}\\cdot [x]_{B} \\\\  & =[\\begin{aligned}1 & -4 \\\\ 3 & -2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-7 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}17 \\\\ -9 \\\\ -6\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-a7b00f3c-cf97-5a00-9aea-1a5f4575fc82" :question/id #uuid "a7b00f3c-cf97-5a00-9aea-1a5f4575fc82" :question/math-academy-id "q-38864" :question/problem "Suppose $T:V\\to W$ is a linear map and $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ and $C=\\{{c}_{1},{c}_{2}\\}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$\\,$ $T({b}_{1})=2{c}_{2}-3{c}_{1},\\,$ $T({b}_{2})=4{c}_{1}-2{c}_{2}\\,$ and $\\,T({b}_{3})=7{c}_{2}-5{c}_{1}.$" :question/worked-solution "First, we write the images of vectors in $B$ relative to the basis $C:$ \n\n$$\n\\begin{aligned}T({b}_{1})=2{c}_{2}-3{c}_{1} & \\,⟹\\,[T({b}_{1})]_{C}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}] \\\\ T({b}_{2})=4{c}_{1}-2{c}_{2} & \\,⟹\\,[T({b}_{2})]_{C}=[\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\ T({b}_{3})=7{c}_{2}-5{c}_{1} & \\,⟹\\,[T({b}_{3})]_{C}=[\\begin{aligned}-5 \\\\ 7\\end{aligned}]\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix  whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2})$ and $T({b}_{3})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-3 & 4 & -5 \\\\ 2 & -2 & 7\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fa4e63ab-bc23-5b80-b413-b0b8c109b3e9"] :db/ensure [:question/validate]} {:db/id "answer-field-fa4e63ab-bc23-5b80-b413-b0b8c109b3e9" :answer-field/id #uuid "fa4e63ab-bc23-5b80-b413-b0b8c109b3e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0673faba-86e8-5a64-bfe1-0d525d80b6b5" :answer-field/choices ["answer-fddb317b-bc18-5964-bf6a-d4564de232a1" "answer-0673faba-86e8-5a64-bfe1-0d525d80b6b5" "answer-273d5980-25a9-5fc1-9c81-6904a3922563" "answer-598dc994-ad61-5fb4-b2d0-3ca9c1a22995" "answer-7e117b80-c1ef-555c-8c26-17c0cb6b419d"] :db/ensure [:answer-field/validate]} {:db/id "answer-fddb317b-bc18-5964-bf6a-d4564de232a1" :answer/id #uuid "fddb317b-bc18-5964-bf6a-d4564de232a1" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-3 & 2 \\\\ 4 & -2 \\\\ -5 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0673faba-86e8-5a64-bfe1-0d525d80b6b5" :answer/id #uuid "0673faba-86e8-5a64-bfe1-0d525d80b6b5" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-3 & 4 & -5 \\\\ 2 & -2 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-273d5980-25a9-5fc1-9c81-6904a3922563" :answer/id #uuid "273d5980-25a9-5fc1-9c81-6904a3922563" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}2 & -2 & -5 \\\\ -3 & 4 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-598dc994-ad61-5fb4-b2d0-3ca9c1a22995" :answer/id #uuid "598dc994-ad61-5fb4-b2d0-3ca9c1a22995" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}2 & 2 \\\\ -2 & 4 \\\\ 7 & 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7e117b80-c1ef-555c-8c26-17c0cb6b419d" :answer/id #uuid "7e117b80-c1ef-555c-8c26-17c0cb6b419d" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}3 & -4 & 7 \\\\ -2 & 2 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186326724 :question/problem "Suppose $T:V\\to W$ is a linear map and $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ and $C=\\{{c}_{1},{c}_{2}\\}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$$\n[T({b}_{1})]_{C}=[\\begin{aligned}-4 \\\\ 8\\end{aligned}],\\,[T({b}_{2})]_{C}=[\\begin{aligned}6 \\\\ -1\\end{aligned}],\\,[T({b}_{3})]_{C}=[\\begin{aligned}8 \\\\ -3\\end{aligned}].\n$$" :db/ensure [:question/validate]} {:db/id "question-6d02bc4b-8130-57f6-83ee-f4c23a8ee855" :question/id #uuid "6d02bc4b-8130-57f6-83ee-f4c23a8ee855" :question/math-academy-id "q-38862" :question/problem "Suppose $T:V\\to W$ is a linear map and $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ and $C=\\{{c}_{1},{c}_{2}\\}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$$\n[T({b}_{1})]_{C}=[\\begin{aligned}-2 \\\\ 8\\end{aligned}],\\,[T({b}_{2})]_{C}=[\\begin{aligned}5 \\\\ -1\\end{aligned}],\\,[T({b}_{3})]_{C}=[\\begin{aligned}-9 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $C.$ Therefore,\n\n$$\n[\\begin{aligned}-2 & 5 & -9 \\\\ 8 & -1 & 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d9321f3e-5997-5a60-99c3-3bb5a1593710"] :db/ensure [:question/validate]} {:db/id "answer-field-d9321f3e-5997-5a60-99c3-3bb5a1593710" :answer-field/id #uuid "d9321f3e-5997-5a60-99c3-3bb5a1593710" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-441e0b9b-d045-5da2-99ca-b32af935cbbe" :answer-field/choices ["answer-441e0b9b-d045-5da2-99ca-b32af935cbbe" "answer-2f241042-3de7-54f3-bbb0-2e029e8e2e5a" "answer-c5a1b501-e730-57f1-8804-304ed8dac3e2" "answer-48ab91ae-4f1d-55f6-b577-167fec5e2b96" "answer-cca3b0b1-980c-5a44-88d6-f2f2dd1c2f5c"] :db/ensure [:answer-field/validate]} {:db/id "answer-441e0b9b-d045-5da2-99ca-b32af935cbbe" :answer/id #uuid "441e0b9b-d045-5da2-99ca-b32af935cbbe" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-2 & 5 & -9 \\\\ 8 & -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2f241042-3de7-54f3-bbb0-2e029e8e2e5a" :answer/id #uuid "2f241042-3de7-54f3-bbb0-2e029e8e2e5a" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-2 & 8 \\\\ 5 & -1 \\\\ -9 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c5a1b501-e730-57f1-8804-304ed8dac3e2" :answer/id #uuid "c5a1b501-e730-57f1-8804-304ed8dac3e2" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}2 & -9 & 5 \\\\ -8 & 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-48ab91ae-4f1d-55f6-b577-167fec5e2b96" :answer/id #uuid "48ab91ae-4f1d-55f6-b577-167fec5e2b96" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}8 & -2 \\\\ -1 & 5 \\\\ 0 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cca3b0b1-980c-5a44-88d6-f2f2dd1c2f5c" :answer/id #uuid "cca3b0b1-980c-5a44-88d6-f2f2dd1c2f5c" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}8 & 5 & 0 \\\\ -2 & -1 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186272084 :question/problem "Suppose $T:V\\to W$ is a linear map and $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ and $C=\\{{c}_{1},{c}_{2}\\}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$$\n[T({b}_{1})]_{C}=[\\begin{aligned}-2 \\\\ 7\\end{aligned}],\\,[T({b}_{2})]_{C}=[\\begin{aligned}0 \\\\ -5\\end{aligned}],\\,[T({b}_{3})]_{C}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].\n$$" :db/ensure [:question/validate]} {:db/id "question-d65cfc4f-129a-584c-86e4-865a0ea5e2d3" :question/id #uuid "d65cfc4f-129a-584c-86e4-865a0ea5e2d3" :question/math-academy-id "q-140426" :question/problem "Suppose $T:V\\to W$ is a linear map and $B=\\{{b}_{1},{b}_{2}\\}$ and $C=\\{{c}_{1},{c}_{2},{c}_{3}\\}$ are the bases of the vector spaces $V$ and $W$, respectively. Find the matrix $[T]_{B|C}$ of the map $T$ relative to these bases, if \n\n$\\,$ $T({b}_{1})=6{c}_{1}-{c}_{2}-7{c}_{3}\\,$ and $\\,T({b}_{2})=-5{c}_{2}+9{c}_{3}-4{c}_{1}.$" :question/worked-solution "First, we write the images of vectors in $B$ relative to the basis $C:$ \n\n$$\n\\begin{aligned}T({b}_{1})=6{c}_{1}-{c}_{2}-7{c}_{3} & \\,⟹\\,[T({b}_{1})]_{C}=[\\begin{aligned}6 \\\\ -1 \\\\ -7\\end{aligned}] \\\\ T({b}_{2})=-5{c}_{2}+9{c}_{3}-4{c}_{1} & \\,⟹\\,[T({b}_{2})]_{C}=[\\begin{aligned}-4 \\\\ -5 \\\\ 9\\end{aligned}]\\end{aligned}\n$$\n\nNow, $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and  $T({b}_{2})$ relative to the basis $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}6 & -4 \\\\ -1 & -5 \\\\ -7 & 9\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-10e1ecc1-0f34-5e80-bdc2-1d29879f9be1"] :db/ensure [:question/validate]} {:db/id "answer-field-10e1ecc1-0f34-5e80-bdc2-1d29879f9be1" :answer-field/id #uuid "10e1ecc1-0f34-5e80-bdc2-1d29879f9be1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-572f320f-1169-58ad-b077-40d64f2de40a" :answer-field/choices ["answer-80c66b22-25ce-5572-a11f-1d4c843a628e" "answer-0df95b1c-878e-5f9b-aa95-23cc414b629a" "answer-466a2951-5ba8-50b4-a8bf-ec1d529c9752" "answer-572f320f-1169-58ad-b077-40d64f2de40a" "answer-4282e852-2000-59cb-b403-01e0c9f8090a"] :db/ensure [:answer-field/validate]} {:db/id "answer-80c66b22-25ce-5572-a11f-1d4c843a628e" :answer/id #uuid "80c66b22-25ce-5572-a11f-1d4c843a628e" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}-4 & 5 & -9 \\\\ 6 & -1 & -7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0df95b1c-878e-5f9b-aa95-23cc414b629a" :answer/id #uuid "0df95b1c-878e-5f9b-aa95-23cc414b629a" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}3 & -4 \\\\ -1 & -2 \\\\ 1 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-466a2951-5ba8-50b4-a8bf-ec1d529c9752" :answer/id #uuid "466a2951-5ba8-50b4-a8bf-ec1d529c9752" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}6 & -3 \\\\ 1 & -5 \\\\ -7 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-572f320f-1169-58ad-b077-40d64f2de40a" :answer/id #uuid "572f320f-1169-58ad-b077-40d64f2de40a" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}6 & -4 \\\\ -1 & -5 \\\\ -7 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4282e852-2000-59cb-b403-01e0c9f8090a" :answer/id #uuid "4282e852-2000-59cb-b403-01e0c9f8090a" :answer/type :answer.type/math :answer/value "[T]_{B|C}=[\\begin{aligned}6 & 1 & -7 \\\\ -4 & 5 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186388688 :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{[\\begin{aligned}2 \\\\ 4\\end{aligned}],[\\begin{aligned}2 \\\\ 6\\end{aligned}]\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}-2 \\\\ 2\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}-4 \\\\ 4\\end{aligned}].\n$$" :db/ensure [:question/validate]} {:db/id 17592186364989 :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{[\\begin{aligned}3 \\\\ 3\\end{aligned}],[\\begin{aligned}-6 \\\\ -3\\end{aligned}]\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}3 \\\\ -9\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}6 \\\\ -3\\end{aligned}],\\,T({b}_{3})=[\\begin{aligned}18 \\\\ 27\\end{aligned}].\n$$" :db/ensure [:question/validate]} {:db/id "question-537bf679-c812-55fa-b501-947966556962" :question/id #uuid "537bf679-c812-55fa-b501-947966556962" :question/math-academy-id "q-97544" :question/problem "Consider the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ of the vector space $V$ and the basis $C$ of ${R}^{2}$ given by\n\n$$\nC=\\{[\\begin{aligned}-1 \\\\ 2\\end{aligned}],[\\begin{aligned}1 \\\\ -1\\end{aligned}]\\}.\n$$\n\nFind the matrix $[T]_{B|C}$ of the map $T:V\\to {R}^{2}$ relative to these bases if \n\n$$\nT({b}_{1})=[\\begin{aligned}3 \\\\ -4\\end{aligned}],\\,T({b}_{2})=[\\begin{aligned}-2 \\\\ 4\\end{aligned}],\\,T({b}_{3})=[\\begin{aligned}1 \\\\ -1\\end{aligned}].\n$$" :question/worked-solution "Recall that $[T]_{B|C}$ is the matrix whose columns are the coordinates of the vectors $T({b}_{1}),$ $T({b}_{2}),$ and $T({b}_{3})$ relative to the basis $C.$\n\nFirst, we need to find the coordinates of $T({b}_{i})$ relative to the basis $C$ for each $i=1,2,3.$ We can do this simultaneously by considering the following matrix:\n\n$$\nM=[\\begin{aligned}| & | & | & | & | \\\\ {c}_{1} & {c}_{2} & T({b}_{1}) & T({b}_{2}) & T({b}_{3}) \\\\ | & | & | & | & |\\end{aligned}].\n$$\n\nWe reduce the left-hand side to reduced row echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 1 & 3 & -2 & 1 \\\\ 2 & -1 & -4 & 4 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{1}:=(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 & -1 \\\\ 2 & -1 & -4 & 4 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-2){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -1 & -3 & 2 & -1 \\\\ 0 & 1 & 2 & 0 & 1\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nFinally, the right-hand side gives the matrix of the linear transformation relative to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-1 & 2 & 0 \\\\ 2 & 0 & 1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e3cea2c7-492b-5863-ae01-4ec758213e20"] :db/ensure [:question/validate]} {:db/id "answer-field-e3cea2c7-492b-5863-ae01-4ec758213e20" :answer-field/id #uuid "e3cea2c7-492b-5863-ae01-4ec758213e20" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d3f0d8d3-dcb7-5a4e-a72f-5cde1424c4b0" :answer-field/choices ["answer-d66cee92-5593-5458-8315-9a280b3f17f2" "answer-d3f0d8d3-dcb7-5a4e-a72f-5cde1424c4b0" "answer-d10ce345-4811-5492-ab7d-0be280aefd58" "answer-c162ebde-a03d-59c9-b01e-5d46df6d7d47" "answer-4643689c-111c-506e-83db-71c5cf05b657"] :db/ensure [:answer-field/validate]} {:db/id "answer-d66cee92-5593-5458-8315-9a280b3f17f2" :answer/id #uuid "d66cee92-5593-5458-8315-9a280b3f