-b25c7e356ff2" "answer-7f499868-62a6-5e2f-89a0-0e07bb868c5a"] :db/ensure [:answer-field/validate]} {:db/id "answer-34035bcc-ec0a-5a23-b0ee-87681ba4b93c" :answer/id #uuid "34035bcc-ec0a-5a23-b0ee-87681ba4b93c" :answer/type :answer.type/math :answer/value "\\frac{2ab-4+5x}{5x+4-ab}" :db/ensure [:answer/validate]} {:db/id "answer-cdfcff50-b6ec-570d-b23a-b25c7e356ff2" :answer/id #uuid "cdfcff50-b6ec-570d-b23a-b25c7e356ff2" :answer/type :answer.type/math :answer/value "\\frac{ab-2+5x}{5x+2-ab}" :db/ensure [:answer/validate]} {:db/id "answer-7f499868-62a6-5e2f-89a0-0e07bb868c5a" :answer/id #uuid "7f499868-62a6-5e2f-89a0-0e07bb868c5a" :answer/type :answer.type/math :answer/value "\\frac{ab-4+5x}{5x+4-ab}" :db/ensure [:answer/validate]} {:db/id 17592186069448 :question/problem "What is $\\frac{8a-4b+12}{20b+8a}$ reduced to its lowest terms?" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{8a-4b+12}{20b+8a} & =\\frac{4(2a-b+3)}{4(5b+2a)} \\\\  & =\\frac{\\cancel{4}(2a-b+3)}{\\cancel{4}(5b+2a)} \\\\  & =\\frac{2a-b+3}{5b+2a}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186067858 :answer-field/correct "answer-cef04d51-1635-5c15-8379-a61f7fa6b3e2" :answer-field/choices ["answer-48a0a8ce-775f-557b-81a4-0e554ec7f541" "answer-08f063aa-dc47-5edd-b3a5-1bf53dc6bc74" "answer-9850e71e-ae25-5498-92cb-45193bf4d0c2" "answer-cef04d51-1635-5c15-8379-a61f7fa6b3e2" "answer-48bc3c23-85b9-50d1-956f-75f7bad23407"] :db/ensure [:answer-field/validate]} {:db/id "answer-48a0a8ce-775f-557b-81a4-0e554ec7f541" :answer/id #uuid "48a0a8ce-775f-557b-81a4-0e554ec7f541" :answer/type :answer.type/math :answer/value "\\frac{-4b+12}{20b}" :db/ensure [:answer/validate]} {:db/id "answer-08f063aa-dc47-5edd-b3a5-1bf53dc6bc74" :answer/id #uuid "08f063aa-dc47-5edd-b3a5-1bf53dc6bc74" :answer/type :answer.type/math :answer/value "\\frac{-b+5}{4b}" :db/ensure [:answer/validate]} {:db/id "answer-9850e71e-ae25-5498-92cb-45193bf4d0c2" :answer/id #uuid "9850e71e-ae25-5498-92cb-45193bf4d0c2" :answer/type :answer.type/math :answer/value "\\frac{2a+b-3}{5b-2a}" :db/ensure [:answer/validate]} {:db/id "answer-cef04d51-1635-5c15-8379-a61f7fa6b3e2" :answer/id #uuid "cef04d51-1635-5c15-8379-a61f7fa6b3e2" :answer/type :answer.type/math :answer/value "\\frac{2a-b+3}{5b+2a}" :db/ensure [:answer/validate]} {:db/id "answer-48bc3c23-85b9-50d1-956f-75f7bad23407" :answer/id #uuid "48bc3c23-85b9-50d1-956f-75f7bad23407" :answer/type :answer.type/math :answer/value "\\frac{2a-b}{5b+2a}" :db/ensure [:answer/validate]} {:db/id "question-f2d8edfd-38f5-52ec-936f-d21ba5dc8f34" :question/id #uuid "f2d8edfd-38f5-52ec-936f-d21ba5dc8f34" :question/math-academy-id "q-100097" :question/problem "Simplify $\\frac{4x-16y+4z}{20x-40z}.$" :question/worked-solution "We factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\begin{aligned}\\frac{4x-16y+4z}{20x-40z} & =\\frac{4(x-4y+z)}{20(x-2z)} \\\\  & =\\frac{\\cancel{4}(x-4y+z)}{\\cancel{4}\\cdot 5(x-2z)} \\\\  & =\\frac{x-4y+z}{5x-10z}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fffa7759-3b19-50e9-990f-c0b88914d0bb"] :db/ensure [:question/validate]} {:db/id "answer-field-fffa7759-3b19-50e9-990f-c0b88914d0bb" :answer-field/id #uuid "fffa7759-3b19-50e9-990f-c0b88914d0bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-94ac5a7e-57b4-59ca-a495-cb030e027654" :answer-field/choices ["answer-7b216b75-fc7c-518c-ad4c-36aba7cfb903" "answer-94ac5a7e-57b4-59ca-a495-cb030e027654" "answer-fd917c7a-ca93-523a-8d76-378ca14e5dfa" "answer-434793c2-4c94-53a2-b3ee-72e68985a91b" "answer-aefa408c-720b-5bcc-a11e-8eec1419eb4b"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b216b75-fc7c-518c-ad4c-36aba7cfb903" :answer/id #uuid "7b216b75-fc7c-518c-ad4c-36aba7cfb903" :answer/type :answer.type/math :answer/value "\\frac{5x-4y+z}{x-10z}" :db/ensure [:answer/validate]} {:db/id "answer-94ac5a7e-57b4-59ca-a495-cb030e027654" :answer/id #uuid "94ac5a7e-57b4-59ca-a495-cb030e027654" :answer/type :answer.type/math :answer/value "\\frac{x-4y+z}{5x-10z}" :db/ensure [:answer/validate]} {:db/id "answer-fd917c7a-ca93-523a-8d76-378ca14e5dfa" :answer/id #uuid "fd917c7a-ca93-523a-8d76-378ca14e5dfa" :answer/type :answer.type/math :answer/value "\\frac{x-y+4z}{10x-z}" :db/ensure [:answer/validate]} {:db/id "answer-434793c2-4c94-53a2-b3ee-72e68985a91b" :answer/id #uuid "434793c2-4c94-53a2-b3ee-72e68985a91b" :answer/type :answer.type/math :answer/value "\\frac{x-y+z}{5x-2z}" :db/ensure [:answer/validate]} {:db/id "answer-aefa408c-720b-5bcc-a11e-8eec1419eb4b" :answer/id #uuid "aefa408c-720b-5bcc-a11e-8eec1419eb4b" :answer/type :answer.type/math :answer/value "\\frac{x-y+z}{x-10z}" :db/ensure [:answer/validate]} {:db/id 17592186069927 :tutorial/content "To simplify a rational expression, we cancel out the largest common factor from the numerator and denominator. To do this, we sometimes need to factor the numerator and denominator before canceling.\n\nFor example, suppose that we wish to simplify $\\dfrac {4x - 12} {10x + 4}.$ To do this, we factor the numerator and denominator and cancel any factors that they have in common.\n\n$$\n\\eqalign{\n\t\t\\dfrac {4x - 12} {10x + 4}\n\t\t&=\\dfrac {4(x - 3)} {2(5x + 2)}\\[5pt]\n&=\\dfrac {2 \\cdot 2 \\cdot (x - 3)} {2(5x + 2)}\\[5pt]\t\t\n\t\t&=\\dfrac {\\cancel{2} \\cdot 2(x - 3)} {\\cancel{2}(5x + 2)}\\[5pt]\t\n\t\t&=\\dfrac {2(x - 3)} {5x + 2}\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186068956 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186174094 :answer-field/choices 17592186174096] [:db/retract 17592186174094 :answer-field/choices 17592186174097] [:db/retract 17592186174094 :answer-field/choices 17592186174098] [:db/retract 17592186174094 :answer-field/choices 17592186174095] [:db/retract 17592186174592 :answer-field/choices 17592186174593] [:db/retract 17592186174592 :answer-field/choices 17592186174594] [:db/retract 17592186174592 :answer-field/choices 17592186174595] [:db/retract 17592186174592 :answer-field/choices 17592186174596] [:db/retract 17592186174592 :answer-field/choices 17592186174597] {:db/id 17592186176021 :knowledge-point/questions ["question-2304365e-e658-571a-a752-03df743e6d8e" "question-548860d7-a3cd-5a87-9ba4-81882cafa76b" "question-99513b0e-90cb-593a-b1cd-0a535510b802" "question-da1f1140-0b6f-5e8e-98c1-c5bc7c260a47"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186176020 :knowledge-point/questions ["question-990eaa9e-cd8b-5349-b27e-24596fc286e8" "question-21fb3dfd-c1e0-5974-85b5-71a08b2e3884" "question-5c2c81b1-ac73-5714-9490-1d6081f1f637"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175957 :knowledge-point/questions ["question-780f42b2-e05c-5d59-ba5e-7cf6b84ac19f" "question-a97fa6ce-6558-5992-afd2-fa81f89839cb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2304365e-e658-571a-a752-03df743e6d8e" :question/id #uuid "2304365e-e658-571a-a752-03df743e6d8e" :question/math-academy-id "q-118578" :question/problem "Given that $y=y(t),$ what is the carrying capacity of the following logistic growth model?\n\n$$\n{y}^{′}=1\\,500y-12{y}^{2},\\,y(0)=15\n$$" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nA diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's factor the right-hand side of the given equation. This gives\n\n$$\n{y}^{′}=12y(125-y),\\,y(0)=15.\n$$\n\nFrom here, we see that $a=125.$ Therefore, the carrying capacity is $125.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c51adab7-d9bc-58f1-9bfb-406f118e6c90"] :db/ensure [:question/validate]} {:db/id "answer-field-c51adab7-d9bc-58f1-9bfb-406f118e6c90" :answer-field/id #uuid "c51adab7-d9bc-58f1-9bfb-406f118e6c90" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-495c9db5-3511-570d-a54b-70f28b1735b2" :answer-field/choices ["answer-2bcd10b0-e620-5625-b4e2-6780c884442e" "answer-495c9db5-3511-570d-a54b-70f28b1735b2" "answer-7fddda94-c503-5b3c-830c-5ac4964c1dae" "answer-6b797d09-5401-5a5c-b2b6-fed4fc476b31" "answer-5e12866c-8fd9-5d70-9397-0511278a760d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bcd10b0-e620-5625-b4e2-6780c884442e" :answer/id #uuid "2bcd10b0-e620-5625-b4e2-6780c884442e" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-495c9db5-3511-570d-a54b-70f28b1735b2" :answer/id #uuid "495c9db5-3511-570d-a54b-70f28b1735b2" :answer/type :answer.type/math :answer/value "125" :db/ensure [:answer/validate]} {:db/id "answer-7fddda94-c503-5b3c-830c-5ac4964c1dae" :answer/id #uuid "7fddda94-c503-5b3c-830c-5ac4964c1dae" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-6b797d09-5401-5a5c-b2b6-fed4fc476b31" :answer/id #uuid "6b797d09-5401-5a5c-b2b6-fed4fc476b31" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-5e12866c-8fd9-5d70-9397-0511278a760d" :answer/id #uuid "5e12866c-8fd9-5d70-9397-0511278a760d" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "question-548860d7-a3cd-5a87-9ba4-81882cafa76b" :question/id #uuid "548860d7-a3cd-5a87-9ba4-81882cafa76b" :question/math-academy-id "q-119840" :question/problem "Given that $y=y(t),$ what is the carrying capacity of the following logistic growth model?\n\n$$\n{y}^{′}=1\\,800y-2{y}^{2},\\,y(0)=30\n$$" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nA diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's factor the right-hand side of the given equation. This gives\n\n$$\n{y}^{′}=2y(900-y),\\,y(0)=30.\n$$\n\nFrom here, we see that $a=900.$ Therefore, the carrying capacity is $900.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a97f6f8c-e126-5e61-838a-7e75c12192eb"] :db/ensure [:question/validate]} {:db/id "answer-field-a97f6f8c-e126-5e61-838a-7e75c12192eb" :answer-field/id #uuid "a97f6f8c-e126-5e61-838a-7e75c12192eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0dd0eb52-cc0f-562f-be51-1c6de89f1f14" :answer-field/choices ["answer-a2cccbb1-9a1e-5817-a3e7-962d276dd0cc" "answer-763eb809-8ab8-5de0-b78d-c70965684ae8" "answer-d181188d-9045-57fe-a84f-1e62b139b7fd" "answer-a83e929b-9573-595a-83ff-0453f1512e20" "answer-0dd0eb52-cc0f-562f-be51-1c6de89f1f14"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2cccbb1-9a1e-5817-a3e7-962d276dd0cc" :answer/id #uuid "a2cccbb1-9a1e-5817-a3e7-962d276dd0cc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-763eb809-8ab8-5de0-b78d-c70965684ae8" :answer/id #uuid "763eb809-8ab8-5de0-b78d-c70965684ae8" :answer/type :answer.type/math :answer/value "1\\,800" :db/ensure [:answer/validate]} {:db/id "answer-d181188d-9045-57fe-a84f-1e62b139b7fd" :answer/id #uuid "d181188d-9045-57fe-a84f-1e62b139b7fd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-a83e929b-9573-595a-83ff-0453f1512e20" :answer/id #uuid "a83e929b-9573-595a-83ff-0453f1512e20" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-0dd0eb52-cc0f-562f-be51-1c6de89f1f14" :answer/id #uuid "0dd0eb52-cc0f-562f-be51-1c6de89f1f14" :answer/type :answer.type/math :answer/value "900" :db/ensure [:answer/validate]} {:db/id "question-99513b0e-90cb-593a-b1cd-0a535510b802" :question/id #uuid "99513b0e-90cb-593a-b1cd-0a535510b802" :question/math-academy-id "q-118575" :question/problem "Given that $y=y(t),$ what is the carrying capacity of the following logistic growth model?\n\n$$\n{y}^{′}=900y-6{y}^{2},\\,y(0)=35\n$$" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nA diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's factor the right-hand side of the given equation. This gives\n\n$$\n{y}^{′}=6y(150-y),\\,y(0)=35.\n$$\n\nFrom here, we see that $a=150.$ Therefore, the carrying capacity is $150.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0117cb33-8b7c-57f9-952f-780b347d7a96"] :db/ensure [:question/validate]} {:db/id "answer-field-0117cb33-8b7c-57f9-952f-780b347d7a96" :answer-field/id #uuid "0117cb33-8b7c-57f9-952f-780b347d7a96" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-82224bdd-18cd-5e5b-a183-bd1ca7b2348b" :answer-field/choices ["answer-8197e250-af8d-5840-a654-e65f3c5a61d0" "answer-82224bdd-18cd-5e5b-a183-bd1ca7b2348b" "answer-d6c430d7-093b-52e9-83ca-91b039a4280d" "answer-50c0b70e-50e7-5f65-8762-82b8b0a4a949" "answer-c9d5cd07-0714-5ffe-ad5d-03e1ea2cdec4"] :db/ensure [:answer-field/validate]} {:db/id "answer-8197e250-af8d-5840-a654-e65f3c5a61d0" :answer/id #uuid "8197e250-af8d-5840-a654-e65f3c5a61d0" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-82224bdd-18cd-5e5b-a183-bd1ca7b2348b" :answer/id #uuid "82224bdd-18cd-5e5b-a183-bd1ca7b2348b" :answer/type :answer.type/math :answer/value "150" :db/ensure [:answer/validate]} {:db/id "answer-d6c430d7-093b-52e9-83ca-91b039a4280d" :answer/id #uuid "d6c430d7-093b-52e9-83ca-91b039a4280d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-50c0b70e-50e7-5f65-8762-82b8b0a4a949" :answer/id #uuid "50c0b70e-50e7-5f65-8762-82b8b0a4a949" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "answer-c9d5cd07-0714-5ffe-ad5d-03e1ea2cdec4" :answer/id #uuid "c9d5cd07-0714-5ffe-ad5d-03e1ea2cdec4" :answer/type :answer.type/math :answer/value "900" :db/ensure [:answer/validate]} {:db/id "question-da1f1140-0b6f-5e8e-98c1-c5bc7c260a47" :question/id #uuid "da1f1140-0b6f-5e8e-98c1-c5bc7c260a47" :question/math-academy-id "q-118587" :question/problem "Consider the following differential equation for the function $y=y(t):$\n\n$$\n{y}^{′}=9y(1-\\frac{y}{1\\,200}),\\,y(0)=200\n$$\n\nWhat is ${lim}_{t\\to \\infty }y(t)?$" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nA diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =9y(1-\\frac{y}{1\\,200}) \\\\  & =9y(\\frac{1\\,200-y}{1\\,200}) \\\\  & =\\frac{9y}{1\\,200}(1\\,200-y) \\\\  & =\\frac{3y}{400}(1\\,200-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=1\\,200.$ Hence, the carrying capacity is $1\\,200.$\n\nFor a given logistic growth model, $y\\to a$ as $t\\to \\infty .$ Therefore,\n\n$$\n{lim}_{t\\to \\infty }y(t)=1\\,200.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c9c885db-a51b-565f-802d-b5e3e3429fb9"] :db/ensure [:question/validate]} {:db/id "answer-field-c9c885db-a51b-565f-802d-b5e3e3429fb9" :answer-field/id #uuid "c9c885db-a51b-565f-802d-b5e3e3429fb9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-081d2611-c9d5-5ff8-acf0-23903af25f7a" :answer-field/choices ["answer-2cb6f314-795c-5293-badb-a09dd380b034" "answer-081d2611-c9d5-5ff8-acf0-23903af25f7a" "answer-a7813003-46c8-549a-951a-80403b679f4e" "answer-7ac27f65-90ba-5e1a-903c-2209418975d4" "answer-4004a3d0-2cbf-51cf-a3c3-743093b7b616"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cb6f314-795c-5293-badb-a09dd380b034" :answer/id #uuid "2cb6f314-795c-5293-badb-a09dd380b034" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-081d2611-c9d5-5ff8-acf0-23903af25f7a" :answer/id #uuid "081d2611-c9d5-5ff8-acf0-23903af25f7a" :answer/type :answer.type/math :answer/value "1\\,200" :db/ensure [:answer/validate]} {:db/id "answer-a7813003-46c8-549a-951a-80403b679f4e" :answer/id #uuid "a7813003-46c8-549a-951a-80403b679f4e" :answer/type :answer.type/math :answer/value "600" :db/ensure [:answer/validate]} {:db/id "answer-7ac27f65-90ba-5e1a-903c-2209418975d4" :answer/id #uuid "7ac27f65-90ba-5e1a-903c-2209418975d4" :answer/type :answer.type/math :answer/value "900" :db/ensure [:answer/validate]} {:db/id "answer-4004a3d0-2cbf-51cf-a3c3-743093b7b616" :answer/id #uuid "4004a3d0-2cbf-51cf-a3c3-743093b7b616" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id 17592186176306 :question/problem "The population $y(t)$ of turtles on a certain island follows the logistic growth model\n\n$$\n{y}^{′}=1.5y-0.001{y}^{2},\\,y(0)=500,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible population of turtles?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =1.5y-0.001{y}^{2} \\\\  & =0.001y(1\\,500-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=1\\,500.$ Hence, the carrying capacity is $1\\,500,$ and we conclude that the number of turtles cannot exceed $1\\,500.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186174094 :answer-field/correct "answer-89df3b37-9b87-5ad8-94c0-1562f3045626" :answer-field/choices ["answer-f3a0621d-a491-583d-9c70-88361bf8cc17" "answer-89df3b37-9b87-5ad8-94c0-1562f3045626" "answer-e2cc4215-cc25-5cee-9728-a8b87958cd6a" "answer-f70fd909-f6a9-551d-a0f6-60ff3aaa4ac7"] :db/ensure [:answer-field/validate]} {:db/id "answer-f3a0621d-a491-583d-9c70-88361bf8cc17" :answer/id #uuid "f3a0621d-a491-583d-9c70-88361bf8cc17" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "answer-89df3b37-9b87-5ad8-94c0-1562f3045626" :answer/id #uuid "89df3b37-9b87-5ad8-94c0-1562f3045626" :answer/type :answer.type/math :answer/value "1\\,500" :db/ensure [:answer/validate]} {:db/id "answer-e2cc4215-cc25-5cee-9728-a8b87958cd6a" :answer/id #uuid "e2cc4215-cc25-5cee-9728-a8b87958cd6a" :answer/type :answer.type/math :answer/value "2\\,500" :db/ensure [:answer/validate]} {:db/id "answer-f70fd909-f6a9-551d-a0f6-60ff3aaa4ac7" :answer/id #uuid "f70fd909-f6a9-551d-a0f6-60ff3aaa4ac7" :answer/type :answer.type/math :answer/value "3\\,000" :db/ensure [:answer/validate]} {:db/id "question-990eaa9e-cd8b-5349-b27e-24596fc286e8" :question/id #uuid "990eaa9e-cd8b-5349-b27e-24596fc286e8" :question/math-academy-id "q-353469" :question/problem "The number $y(t)$ of homes in a city that have adopted clean energy follows the logistic growth model\n\n$$\n{y}^{′}=3y(20-\\frac{y}{125}),\\,y(0)=100,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible number of homes that will adopt clean energy?\n\nThe maximum possible number of homes that will adopt clean energy is\n{{field-1}}." :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible number of clean-energy-adopting homes in the city. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/d8/d8133f1c4203903bac606bbae61c73717e2ba2dc15a97a77f48eaaeaf4736d06.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =3y(20-\\frac{y}{125}) \\\\  & =3y(\\frac{2\\,500-y}{125}) \\\\  & =\\frac{3y}{125}(2\\,500-y) \\\\  & =0.024y(2\\,500-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=2500.$ Hence, the carrying capacity is $2500,$ and we conclude that the maximum possible number of homes that will adopt clean energy is $2500.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c112df9-705c-527b-8556-06919619c93f"] :db/ensure [:question/validate]} {:db/id "answer-field-6c112df9-705c-527b-8556-06919619c93f" :answer-field/id #uuid "6c112df9-705c-527b-8556-06919619c93f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4b823059-32a5-5517-a7b7-fb48a969e9a1" :answer-field/choices ["answer-4b823059-32a5-5517-a7b7-fb48a969e9a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b823059-32a5-5517-a7b7-fb48a969e9a1" :answer/id #uuid "4b823059-32a5-5517-a7b7-fb48a969e9a1" :answer/type :answer.type/math :answer/value "2500" :db/ensure [:answer/validate]} {:db/id "question-21fb3dfd-c1e0-5974-85b5-71a08b2e3884" :question/id #uuid "21fb3dfd-c1e0-5974-85b5-71a08b2e3884" :question/math-academy-id "q-353476" :question/problem "The number $y(t)$ of people in a closed community who have been infected with a virus follows the logistic growth model\n\n$$\n{y}^{′}=2400y-3{y}^{2},\\,y(0)=12,\n$$\n\nwhere $t$ is the time, in days, since the observations began. According to this model, what is the maximum possible number of infected people?\n\nThe maximum possible number of infected people is\n{{field-1}}." :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible number of people who will be infected. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/d8/d8133f1c4203903bac606bbae61c73717e2ba2dc15a97a77f48eaaeaf4736d06.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =2400y-3{y}^{2} \\\\  & =3y(800-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=800.$ Hence, the carrying capacity is $800,$ and we conclude that the maximum possible number of infected people is $800.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1d4c9911-0775-5294-9352-eb815ab61b7e"] :db/ensure [:question/validate]} {:db/id "answer-field-1d4c9911-0775-5294-9352-eb815ab61b7e" :answer-field/id #uuid "1d4c9911-0775-5294-9352-eb815ab61b7e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-733dd2ee-a0f5-5037-97ab-545d842b762d" :answer-field/choices ["answer-733dd2ee-a0f5-5037-97ab-545d842b762d"] :db/ensure [:answer-field/validate]} {:db/id "answer-733dd2ee-a0f5-5037-97ab-545d842b762d" :answer/id #uuid "733dd2ee-a0f5-5037-97ab-545d842b762d" :answer/type :answer.type/math :answer/value "800" :db/ensure [:answer/validate]} {:db/id "question-5c2c81b1-ac73-5714-9490-1d6081f1f637" :question/id #uuid "5c2c81b1-ac73-5714-9490-1d6081f1f637" :question/math-academy-id "q-118554" :question/problem "The population $y(t)$ of deer in a certain forest follows the logistic growth model\n\n$$\n{y}^{′}=0.6y-0.0012{y}^{2},\\,y(0)=120,\n$$\n\nwhere $t$ is the time, in years. According to this model, what is the maximum possible population of deer?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =0.6y-0.001\\,2{y}^{2} \\\\  & =0.0012y(500-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=500.$ Hence, the carrying capacity is $500,$ and we conclude that the number of deer cannot exceed $500.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0c5e5ed9-14e9-5160-bdc0-df76ba3efee1"] :db/ensure [:question/validate]} {:db/id "answer-field-0c5e5ed9-14e9-5160-bdc0-df76ba3efee1" :answer-field/id #uuid "0c5e5ed9-14e9-5160-bdc0-df76ba3efee1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fcdf8785-d333-580f-b2a8-20410c69ffa3" :answer-field/choices ["answer-65462c67-cb94-5a4f-aef1-c3b35dc9c272" "answer-342e6f1b-ac3e-50b2-98d7-df8f0229b2e7" "answer-9c43af4b-b5aa-5fb8-9285-24a4affe03dc" "answer-fcdf8785-d333-580f-b2a8-20410c69ffa3" "answer-50f68122-9efd-5a7b-939d-e58e9cf110e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-65462c67-cb94-5a4f-aef1-c3b35dc9c272" :answer/id #uuid "65462c67-cb94-5a4f-aef1-c3b35dc9c272" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "answer-342e6f1b-ac3e-50b2-98d7-df8f0229b2e7" :answer/id #uuid "342e6f1b-ac3e-50b2-98d7-df8f0229b2e7" :answer/type :answer.type/math :answer/value "200" :db/ensure [:answer/validate]} {:db/id "answer-9c43af4b-b5aa-5fb8-9285-24a4affe03dc" :answer/id #uuid "9c43af4b-b5aa-5fb8-9285-24a4affe03dc" :answer/type :answer.type/math :answer/value "320" :db/ensure [:answer/validate]} {:db/id "answer-fcdf8785-d333-580f-b2a8-20410c69ffa3" :answer/id #uuid "fcdf8785-d333-580f-b2a8-20410c69ffa3" :answer/type :answer.type/math :answer/value "500" :db/ensure [:answer/validate]} {:db/id "answer-50f68122-9efd-5a7b-939d-e58e9cf110e3" :answer/id #uuid "50f68122-9efd-5a7b-939d-e58e9cf110e3" :answer/type :answer.type/math :answer/value "650" :db/ensure [:answer/validate]} {:db/id "question-780f42b2-e05c-5d59-ba5e-7cf6b84ac19f" :question/id #uuid "780f42b2-e05c-5d59-ba5e-7cf6b84ac19f" :question/math-academy-id "q-353491" :question/problem "The number $P(t)$ of employees at a growing company follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=9600P-8{P}^{2},\\,P(0)=150,\n$$\n\nwhere $t$ is the time, measured in years. For which value of $P$ is the number of employees growing at the fastest possible rate?\n\n$P=$\n{{field-1}}" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/90/9019b26b417c757bbfab79afb39379c1fc7a892bc44e934c6f23c339deacfd68.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}\\frac{dP}{dt} & =9600P-8{P}^{2} \\\\  & =8P(1200-P)\\end{aligned}\n$$\n\nFrom here, we see that $a=1200.$ Hence, the carrying capacity is $1200,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 1200=600.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-429ec1f3-edbf-511d-9966-3b57d80b0385"] :db/ensure [:question/validate]} {:db/id "answer-field-429ec1f3-edbf-511d-9966-3b57d80b0385" :answer-field/id #uuid "429ec1f3-edbf-511d-9966-3b57d80b0385" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2dc6f863-6eeb-5db4-ad8c-e70735286a1e" :answer-field/choices ["answer-2dc6f863-6eeb-5db4-ad8c-e70735286a1e"] :db/ensure [:answer-field/validate]} {:db/id "answer-2dc6f863-6eeb-5db4-ad8c-e70735286a1e" :answer/id #uuid "2dc6f863-6eeb-5db4-ad8c-e70735286a1e" :answer/type :answer.type/math :answer/value "600" :db/ensure [:answer/validate]} {:db/id "question-a97fa6ce-6558-5992-afd2-fa81f89839cb" :question/id #uuid "a97fa6ce-6558-5992-afd2-fa81f89839cb" :question/math-academy-id "q-85982" :question/problem "The population $P(t)$ of turtles  on a certain island follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=4.8P-0.001\\,2{P}^{2},\\,P(0)=200,\n$$\n\nwhere $t$ is the time, measured in years. For which value of $P$ is the turtle population growing at the fastest possible rate?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/9d/9d8f5340bba4d3c407e43f2bc64a4aa2ea986be89b8024baaa4e8ae65e96e5d5.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}\\frac{dP}{dt} & =4.8P-0.001\\,2{P}^{2} \\\\  & =0.001\\,2P(4\\,000-P)\\end{aligned}\n$$\n\nFrom here, we see that $a=4\\,000.$ Hence, the carrying capacity is $4\\,000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 4\\,000=2\\,000.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-963b2bae-6d0b-579e-ad6a-b3bc97461b9d"] :db/ensure [:question/validate]} {:db/id "answer-field-963b2bae-6d0b-579e-ad6a-b3bc97461b9d" :answer-field/id #uuid "963b2bae-6d0b-579e-ad6a-b3bc97461b9d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-191a8fdb-4cf1-52b9-b39d-877ed2bfcf4d" :answer-field/choices ["answer-786cef4c-88dd-5537-bc9a-2d9fbba7feed" "answer-7075748d-27ae-566a-8e0a-bfe33ec489f3" "answer-191a8fdb-4cf1-52b9-b39d-877ed2bfcf4d" "answer-226ece79-c20c-52a6-9ef4-69ce428c1b6d" "answer-1fe55633-1a01-5334-8af1-1c9155c4685b"] :db/ensure [:answer-field/validate]} {:db/id "answer-786cef4c-88dd-5537-bc9a-2d9fbba7feed" :answer/id #uuid "786cef4c-88dd-5537-bc9a-2d9fbba7feed" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "answer-7075748d-27ae-566a-8e0a-bfe33ec489f3" :answer/id #uuid "7075748d-27ae-566a-8e0a-bfe33ec489f3" :answer/type :answer.type/math :answer/value "1\\,500" :db/ensure [:answer/validate]} {:db/id "answer-191a8fdb-4cf1-52b9-b39d-877ed2bfcf4d" :answer/id #uuid "191a8fdb-4cf1-52b9-b39d-877ed2bfcf4d" :answer/type :answer.type/math :answer/value "2\\,000" :db/ensure [:answer/validate]} {:db/id "answer-226ece79-c20c-52a6-9ef4-69ce428c1b6d" :answer/id #uuid "226ece79-c20c-52a6-9ef4-69ce428c1b6d" :answer/type :answer.type/math :answer/value "500" :db/ensure [:answer/validate]} {:db/id "answer-1fe55633-1a01-5334-8af1-1c9155c4685b" :answer/id #uuid "1fe55633-1a01-5334-8af1-1c9155c4685b" :answer/type :answer.type/math :answer/value "900" :db/ensure [:answer/validate]} {:db/id 17592186176389 :question/problem "The population $P(t)$ of squirrels in a certain forest follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=0.000\\,5P(6\\,000-P),\\,P(0)=1\\,000\n$$\n\nwhere $t$ is the time, measured in years. For which value of $P$ is the squirrel population growing at the fastest possible rate?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/9d/9d8f5340bba4d3c407e43f2bc64a4aa2ea986be89b8024baaa4e8ae65e96e5d5.png)\n\nFrom our equation, we see that $a=6\\,000.$ Hence, the carrying capacity is $6\\,000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 6\\,000=3\\,000.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186174592 :answer-field/correct "answer-0594f223-200c-542c-be81-07e72759ac03" :answer-field/choices ["answer-0b70aa2b-729a-5da7-a35a-50ae0199754c" "answer-4341d8a3-0f2b-5ec4-84db-379db13471bb" "answer-cbb22c01-113f-5dc7-bea5-a610d7aec30d" "answer-0594f223-200c-542c-be81-07e72759ac03" "answer-f3c01786-caa1-5695-9de3-f30704bb60b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b70aa2b-729a-5da7-a35a-50ae0199754c" :answer/id #uuid "0b70aa2b-729a-5da7-a35a-50ae0199754c" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "answer-4341d8a3-0f2b-5ec4-84db-379db13471bb" :answer/id #uuid "4341d8a3-0f2b-5ec4-84db-379db13471bb" :answer/type :answer.type/math :answer/value "1\\,500" :db/ensure [:answer/validate]} {:db/id "answer-cbb22c01-113f-5dc7-bea5-a610d7aec30d" :answer/id #uuid "cbb22c01-113f-5dc7-bea5-a610d7aec30d" :answer/type :answer.type/math :answer/value "2\\,000" :db/ensure [:answer/validate]} {:db/id "answer-0594f223-200c-542c-be81-07e72759ac03" :answer/id #uuid "0594f223-200c-542c-be81-07e72759ac03" :answer/type :answer.type/math :answer/value "3\\,000" :db/ensure [:answer/validate]} {:db/id "answer-f3c01786-caa1-5695-9de3-f30704bb60b6" :answer/id #uuid "f3c01786-caa1-5695-9de3-f30704bb60b6" :answer/type :answer.type/math :answer/value "4\\,800" :db/ensure [:answer/validate]} {:db/id 17592186177034 :tutorial/content "Let's go back to the following logistic growth equation:\n\n$$\ny' = 5y(10-y), \\qquad y(0) = y_0.\n$$\n\nThe logistic growth curve for this problem is sketched below.\n\n![](images/0a/0a225fd04f81bd65e1bad3ff14097563d112a16e3847aac26cc86591533ea5d0.png)\n\nThe curve contains an inflection point, that is, a point where $y(t)$ is growing at its fastest possible rate. What information can we deduce about this point? \n\nTo find the inflection point, we solve $y''(t) = 0.$ First, we differentiate the differential equation using implicit differentiation:\n\n$$\n\\begin{aligned}{y}^{″} & =(5y)^{′}\\cdot (10-y)+(5y)\\cdot (10-y)^{′} \\\\  & =5\\cdot (10-y)\\cdot {y}^{′}+(5y)\\cdot (-1)\\cdot {y}^{′} \\\\  & ={y}^{′}\\cdot (5\\cdot (10-y)+(5y)\\cdot (-1)) \\\\  & ={y}^{′}\\cdot (50-5y-5y) \\\\  & ={y}^{′}\\cdot (50-10y)\\end{aligned}\n$$\n\nWe now need to solve $y''(t) = 0,$ i.e.,\n\n$$\ny'\\cdot\\left(50-10y\\right) = 0.\n$$\n\nWe know that $y'$ is increasing for all $t,$ so $y'\\neq 0.$ Therefore, we must have\n\n$$\n50-10y = 0\\quad \\Rightarrow\\quad y = 5.\n$$\n\nLet's mark this on our diagram.\n\n![](images/75/75d0363483e1bda70decb171466fe9e506eb0da80d0e78ed893bb61551ae9d44.png)\n\nThe fact that the inflection point occurs when $y$ is precisely half the carrying capacity is *not* a coincidence. In fact, this is always the case. The general situation is shown below.\n\n![](images/77/7754f42adbb938c1d07ab2636a4c24f1cd0bc8536c974af2497e997589efa115.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186176102 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186105701 :knowledge-point/questions ["question-b6749b1c-5bbb-5e2e-a55f-6596daa98287"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105702 :knowledge-point/questions ["question-c61c8891-41ce-5169-9fd8-85b0f9123364"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105703 :knowledge-point/questions ["question-1d98c763-a05e-5de6-913c-903735959780"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186106111 :question/problem "Suppose that $|\\,a\\,|=8$, $|\\,b\\,|=2$ and that the angle between the vectors is $\\theta ={120}^{∘}.$ Find the vector projection of $a$ onto $b$ in terms of the vector $b.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡({120}^{∘}) \\\\  & =8\\cdot (-\\frac{1}{2}) \\\\  & =-4\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $b:$\n\n$$\nu=\\frac{b}{|\\,b\\,|}=\\frac{b}{2}=\\frac{1}{2}b\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =(-4)\\cdot \\frac{1}{2}b \\\\  & =-2b\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186102542 :answer-field/correct 17592186102547 :db/ensure [:answer-field/validate]} {:db/id "question-b6749b1c-5bbb-5e2e-a55f-6596daa98287" :question/id #uuid "b6749b1c-5bbb-5e2e-a55f-6596daa98287" :question/math-academy-id "q-126505" :question/problem "Suppose that $|\\,p\\,|=3$, $|\\,q\\,|=6\\sqrt{2}$ and that the angle between the vectors is $\\theta =\\frac{3\\pi }{4}.$ Find the vector projection of $q$ onto $p$ in terms of the vector $p.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =|\\,q\\,|\\operatorname{cos}⁡\\theta  \\\\  & =6\\sqrt{2}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =6\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $p:$\n\n$$\nu=\\frac{p}{|\\,p\\,|}=\\frac{p}{3}=\\frac{1}{3}p\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & ={\\text{comp}}_{p}\\,q\\cdot u \\\\  & =-6\\cdot \\frac{1}{3}p \\\\  & =-2p\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c9c3dd9f-ab18-5360-9b3b-eadcd53e98f0"] :db/ensure [:question/validate]} {:db/id "answer-field-c9c3dd9f-ab18-5360-9b3b-eadcd53e98f0" :answer-field/id #uuid "c9c3dd9f-ab18-5360-9b3b-eadcd53e98f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b0ca58b2-3b12-5d53-ad1b-c58a6e468632" :answer-field/choices ["answer-b0ca58b2-3b12-5d53-ad1b-c58a6e468632" "answer-4768dc17-128a-5264-bb20-23540bc93f6e" "answer-66271f18-bf53-53fa-83e6-4aaa92faf9f1" "answer-a7828ce3-5e74-5c71-b0fe-85a96d7ec54d" "answer-b6b21f9d-12ea-536b-b50b-3098e10aa880"] :db/ensure [:answer-field/validate]} {:db/id "answer-b0ca58b2-3b12-5d53-ad1b-c58a6e468632" :answer/id #uuid "b0ca58b2-3b12-5d53-ad1b-c58a6e468632" :answer/type :answer.type/math :answer/value "-2p" :db/ensure [:answer/validate]} {:db/id "answer-4768dc17-128a-5264-bb20-23540bc93f6e" :answer/id #uuid "4768dc17-128a-5264-bb20-23540bc93f6e" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}p" :db/ensure [:answer/validate]} {:db/id "answer-66271f18-bf53-53fa-83e6-4aaa92faf9f1" :answer/id #uuid "66271f18-bf53-53fa-83e6-4aaa92faf9f1" :answer/type :answer.type/math :answer/value "-p" :db/ensure [:answer/validate]} {:db/id "answer-a7828ce3-5e74-5c71-b0fe-85a96d7ec54d" :answer/id #uuid "a7828ce3-5e74-5c71-b0fe-85a96d7ec54d" :answer/type :answer.type/math :answer/value "2p" :db/ensure [:answer/validate]} {:db/id "answer-b6b21f9d-12ea-536b-b50b-3098e10aa880" :answer/id #uuid "b6b21f9d-12ea-536b-b50b-3098e10aa880" :answer/type :answer.type/math :answer/value "p" :db/ensure [:answer/validate]} {:db/id "question-c61c8891-41ce-5169-9fd8-85b0f9123364" :question/id #uuid "c61c8891-41ce-5169-9fd8-85b0f9123364" :question/math-academy-id "q-101544" :question/problem "Let $p=⟨3,2,-1⟩$ and $q=⟨6,-1,8⟩.$ Find the vector projection of $q$ onto $p.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{p}\\,q & =\\frac{p\\cdot q}{p\\cdot p}p \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}p \\\\  & =\\frac{3\\cdot 6+2\\cdot (-1)+(-1)\\cdot 8}{{3}^{2}+{2}^{2}+(-1)^{2}}p \\\\  & =\\frac{8}{14}⟨3,2,-1⟩ \\\\  & =\\frac{4}{7}⟨3,2,-1⟩ \\\\  & =⟨\\frac{12}{7},\\frac{8}{7},-\\frac{4}{7}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-361b2040-da8d-55e4-b6be-8f12e8371de1"] :db/ensure [:question/validate]} {:db/id "answer-field-361b2040-da8d-55e4-b6be-8f12e8371de1" :answer-field/id #uuid "361b2040-da8d-55e4-b6be-8f12e8371de1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d75151f-151e-5d5a-98f8-8c6a7fa9b1bc" :answer-field/choices ["answer-3f15ca76-ef1c-5a43-baa6-4911dcb2975b" "answer-1d75151f-151e-5d5a-98f8-8c6a7fa9b1bc" "answer-85cd2f8a-a896-53bc-adb4-0c5ec4ab1dbe" "answer-abeb3f08-06a4-5b71-91a5-e6b80269504f" "answer-b1ba500f-0ba0-5adb-bd95-5f83ed1eb09a"] :db/ensure [:answer-field/validate]} {:db/id "answer-3f15ca76-ef1c-5a43-baa6-4911dcb2975b" :answer/id #uuid "3f15ca76-ef1c-5a43-baa6-4911dcb2975b" :answer/type :answer.type/math :answer/value "⟨0,0,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-1d75151f-151e-5d5a-98f8-8c6a7fa9b1bc" :answer/id #uuid "1d75151f-151e-5d5a-98f8-8c6a7fa9b1bc" :answer/type :answer.type/math :answer/value "⟨\\frac{12}{7},\\frac{8}{7},-\\frac{4}{7}⟩" :db/ensure [:answer/validate]} {:db/id "answer-85cd2f8a-a896-53bc-adb4-0c5ec4ab1dbe" :answer/id #uuid "85cd2f8a-a896-53bc-adb4-0c5ec4ab1dbe" :answer/type :answer.type/math :answer/value "⟨\\frac{24}{101},\\frac{16}{101},-\\frac{32}{101}⟩" :db/ensure [:answer/validate]} {:db/id "answer-abeb3f08-06a4-5b71-91a5-e6b80269504f" :answer/id #uuid "abeb3f08-06a4-5b71-91a5-e6b80269504f" :answer/type :answer.type/math :answer/value "⟨\\frac{3}{7},\\frac{2}{7},-\\frac{1}{7}⟩" :db/ensure [:answer/validate]} {:db/id "answer-b1ba500f-0ba0-5adb-bd95-5f83ed1eb09a" :answer/id #uuid "b1ba500f-0ba0-5adb-bd95-5f83ed1eb09a" :answer/type :answer.type/math :answer/value "⟨\\frac{6}{7},\\frac{4}{7},-\\frac{2}{7}⟩" :db/ensure [:answer/validate]} {:db/id "question-1d98c763-a05e-5de6-913c-903735959780" :question/id #uuid "1d98c763-a05e-5de6-913c-903735959780" :question/math-academy-id "q-212460" :question/problem "Let $a=⟨1,2,-1⟩$ and $b=⟨1,x,2⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =1\\cdot 1+2\\cdot x+(-1)\\cdot 2 \\\\  & =2x-1.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x-1 & =0 \\\\ 2x & =1 \\\\ x & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0dfe0b7a-7e87-551d-9c63-3d3fbe0f0ee6"] :db/ensure [:question/validate]} {:db/id "answer-field-0dfe0b7a-7e87-551d-9c63-3d3fbe0f0ee6" :answer-field/id #uuid "0dfe0b7a-7e87-551d-9c63-3d3fbe0f0ee6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6da670c-ad73-58eb-88ec-c72e37de6415" :answer-field/choices ["answer-b1c88e84-5bca-52a5-9ff2-25a12a68f03e" "answer-007ca704-665c-5469-bb92-8fe895a8eacd" "answer-f6da670c-ad73-58eb-88ec-c72e37de6415" "answer-09f61461-dd48-5041-ae4c-43a710a4eb72" "answer-9228ca5d-afce-5b10-b57e-7850fc591002"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1c88e84-5bca-52a5-9ff2-25a12a68f03e" :answer/id #uuid "b1c88e84-5bca-52a5-9ff2-25a12a68f03e" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-007ca704-665c-5469-bb92-8fe895a8eacd" :answer/id #uuid "007ca704-665c-5469-bb92-8fe895a8eacd" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-f6da670c-ad73-58eb-88ec-c72e37de6415" :answer/id #uuid "f6da670c-ad73-58eb-88ec-c72e37de6415" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-09f61461-dd48-5041-ae4c-43a710a4eb72" :answer/id #uuid "09f61461-dd48-5041-ae4c-43a710a4eb72" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-9228ca5d-afce-5b10-b57e-7850fc591002" :answer/id #uuid "9228ca5d-afce-5b10-b57e-7850fc591002" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id 17592186059871 :knowledge-point/questions ["question-2ab44a05-012f-5af3-a42d-e6d922b9a66c" "question-353b78e0-100e-5425-97b3-923c0bd8ad1a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059422 :question/worked-solution "First, we write\n\n$$\n5(5^2) = 5^1 \\times 5^2.\n$$\n\nSo our expression can be written as\n\n$$\n5^1 \\times 5^2 \\times 5^4\n$$\n\nTo multiply powers of the same base, we simply add the exponents:\n\n$$\n5^1 \\times 5^2 \\times 5^4 = 5^{1+2+4} = 5^7\n$$" :db/ensure [:question/validate]} {:db/id 17592186059872 :knowledge-point/questions ["question-fa0bbd4b-06ea-5732-8998-73cc5cb59649" "question-a0176d28-d1e2-593d-8b48-e87cdf5d129a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059423 :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n\\left(\\dfrac{1}{3}\\right)^2\\times \\left(\\dfrac{1}{3}\\right)^2 =  \\left(\\dfrac{1}{3}\\right)^{2+2} =  \\left(\\dfrac{1}{3}\\right)^4\n$$" :db/ensure [:question/validate]} {:db/id 17592186059873 :knowledge-point/questions ["question-0c468631-3494-5a5c-8263-59a9e6ef38aa" "question-9f94c748-cc3f-548a-899d-563289a823a1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059424 :question/problem "Evaluate $2^2\\times 2^{-5}.$" :question/worked-solution "To multiply powers of the same base, we add the exponents:\n\n$$\n2^2\\times 2^{-5} =2^{2+(-5)} = 2^{-3}\n$$\n\nTo evaluate $2^{-3},$ we find the reciprocal of the base $(2)$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n2^{-3}  = \\left(\\dfrac{1}{2}\\right)^3 =\\dfrac{1}{2} \\times \\dfrac{1}{2} \\times \\dfrac{1}{2} = \\dfrac{1}{8}\n$$" :db/ensure [:question/validate]} {:db/id "question-2ab44a05-012f-5af3-a42d-e6d922b9a66c" :question/id #uuid "2ab44a05-012f-5af3-a42d-e6d922b9a66c" :question/math-academy-id "q-68262" :question/problem "${3}^{4}\\times {3}^{5}=$" :question/worked-solution "To multiply powers of the same base, we simply add the exponents:\n\n$$\n{3}^{4}\\times {3}^{5}={3}^{4+5}={3}^{9}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0bb2ecd3-9803-56a2-93a2-4aff13989160"] :db/ensure [:question/validate]} {:db/id "answer-field-0bb2ecd3-9803-56a2-93a2-4aff13989160" :answer-field/id #uuid "0bb2ecd3-9803-56a2-93a2-4aff13989160" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0e96ace4-0fe6-5351-92ac-3f7507ef6f08" :answer-field/choices ["answer-6dc8ee66-cded-543e-8fb4-753cc1fb2bb6" "answer-d022d46d-2aa9-5779-96dd-bfbc18006aa7" "answer-0e96ace4-0fe6-5351-92ac-3f7507ef6f08" "answer-e2acb41f-dd69-5033-8357-70f6f4072be1" "answer-ad96e847-fdcf-5be6-96e6-b0f020b4103a"] :db/ensure [:answer-field/validate]} {:db/id "answer-6dc8ee66-cded-543e-8fb4-753cc1fb2bb6" :answer/id #uuid "6dc8ee66-cded-543e-8fb4-753cc1fb2bb6" :answer/type :answer.type/math :answer/value "{3}^{-1}" :db/ensure [:answer/validate]} {:db/id "answer-d022d46d-2aa9-5779-96dd-bfbc18006aa7" :answer/id #uuid "d022d46d-2aa9-5779-96dd-bfbc18006aa7" :answer/type :answer.type/math :answer/value "{3}^{20}" :db/ensure [:answer/validate]} {:db/id "answer-0e96ace4-0fe6-5351-92ac-3f7507ef6f08" :answer/id #uuid "0e96ace4-0fe6-5351-92ac-3f7507ef6f08" :answer/type :answer.type/math :answer/value "{3}^{9}" :db/ensure [:answer/validate]} {:db/id "answer-e2acb41f-dd69-5033-8357-70f6f4072be1" :answer/id #uuid "e2acb41f-dd69-5033-8357-70f6f4072be1" :answer/type :answer.type/math :answer/value "{6}^{9}" :db/ensure [:answer/validate]} {:db/id "answer-ad96e847-fdcf-5be6-96e6-b0f020b4103a" :answer/id #uuid "ad96e847-fdcf-5be6-96e6-b0f020b4103a" :answer/type :answer.type/math :answer/value "{9}^{20}" :db/ensure [:answer/validate]} {:db/id "question-353b78e0-100e-5425-97b3-923c0bd8ad1a" :question/id #uuid "353b78e0-100e-5425-97b3-923c0bd8ad1a" :question/math-academy-id "q-100312" :question/problem "${3}^{4}\\times 3({3}^{5})=$" :question/worked-solution "First, we write\n\n$$\n3({3}^{5})={3}^{1}\\times {3}^{5}.\n$$\n\nSo our expression can be written as\n\n$$\n{3}^{4}\\times {3}^{1}\\times {3}^{5}.\n$$\n\nTo multiply powers of the same base, we simply add the exponents:\n\n$$\n{3}^{4}\\times {3}^{1}\\times {3}^{5}={3}^{4+1+5}={3}^{10}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2bfe1a7a-be63-5382-86e8-a78b28725895"] :db/ensure [:question/validate]} {:db/id "answer-field-2bfe1a7a-be63-5382-86e8-a78b28725895" :answer-field/id #uuid "2bfe1a7a-be63-5382-86e8-a78b28725895" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f3c8637e-65d7-5e97-aebf-69559da7d6f3" :answer-field/choices ["answer-7a300419-b828-5baa-9150-b4d2f6df3840" "answer-7166dd22-1374-5ecf-804d-95aab19b1a62" "answer-f3c8637e-65d7-5e97-aebf-69559da7d6f3" "answer-99db8c98-3844-5678-92df-54922c697c78" "answer-1e6532bc-4b83-5e34-b0a1-4dd68107a4b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a300419-b828-5baa-9150-b4d2f6df3840" :answer/id #uuid "7a300419-b828-5baa-9150-b4d2f6df3840" :answer/type :answer.type/ma