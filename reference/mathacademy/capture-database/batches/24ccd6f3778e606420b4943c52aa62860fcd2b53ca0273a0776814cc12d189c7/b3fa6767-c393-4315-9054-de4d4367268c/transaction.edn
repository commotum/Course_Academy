114-8607-a95952bbf527" :answer/type :answer.type/text :answer/value "center" :db/ensure [:answer/validate]} {:db/id "answer-974c5048-0f71-5a1d-b246-43c1df76ab47" :answer/id #uuid "974c5048-0f71-5a1d-b246-43c1df76ab47" :answer/type :answer.type/text :answer/value "saddle" :db/ensure [:answer/validate]} {:db/id "answer-e215f0b9-b468-5d43-8633-23a098913610" :answer/id #uuid "e215f0b9-b468-5d43-8633-23a098913610" :answer/type :answer.type/text :answer/value "sink" :db/ensure [:answer/validate]} {:db/id "answer-6efff0d4-af07-5c8b-93cb-213a64de5e8d" :answer/id #uuid "6efff0d4-af07-5c8b-93cb-213a64de5e8d" :answer/type :answer.type/text :answer/value "source" :db/ensure [:answer/validate]} {:db/id "question-2da83aef-8248-5784-87a2-78e988b82e95" :question/id #uuid "2da83aef-8248-5784-87a2-78e988b82e95" :question/math-academy-id "q-335677" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}=3x(1-2x)-xy \\\\ {y}^{′}=-3y+4xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model with carrying capacity above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Select the correct options in the reasoning below.\n\n$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0.5,\\,0]^{T},$ we get\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$J({x}^{∗})=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"40px\">{{field-1}}</td>\n<td align=\"center\" width=\"40px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,.$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=3x(1-2x)-xy$ and ${f}_{2}(x,y)=-3y+4xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(3x(1-2x)-xy)=3-12x-y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(3x(1-2x)-xy)=-x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-3y+4xy)=4y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-3y+4xy)=-3+4x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}3-12x-y & -x \\\\ 4y & -3+4x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0.5 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}3-12(0.5)-0 & -0.5 \\\\ 4(0) & -3+4(0.5)\\end{aligned}]=[\\begin{aligned}-3 & -0.5 \\\\ 0 & -1\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=-3\\text{ and }{\\lambda }_{2}=-1.$ Since the eigenvalues are real and both negative, our equilibrium is $\\text{an asymptotically stable}$ $\\text{sink}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eac738bc-07c5-5435-a197-408e8f964303" "answer-field-f076bb5b-b7fe-5032-9d52-edd95ede9bcc" "answer-field-ed70222f-88da-5015-8da3-a26f90400935" "answer-field-e2f29ab0-e785-5a79-b8a3-d0b5aa470e35" "answer-field-d1b48645-6069-5db0-bf9c-363ed4ed9774" "answer-field-faf226ee-4861-5e14-8b25-2eece69e5941" "answer-field-a17e2f31-6d79-5819-8e94-5313984134e0"] :db/ensure [:question/validate]} {:db/id "answer-field-eac738bc-07c5-5435-a197-408e8f964303" :answer-field/id #uuid "eac738bc-07c5-5435-a197-408e8f964303" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0311748b-bb7c-5007-8d98-80a390f95770" :answer-field/choices ["answer-87049376-def3-5afc-bb9c-e734e5311407" "answer-b062864a-41a6-5c54-bff0-d5468f384389" "answer-0311748b-bb7c-5007-8d98-80a390f95770" "answer-717f508f-12cd-56dc-82f2-be055b44d146" "answer-90a8533c-19b8-5039-976b-5f7c636e4985"] :db/ensure [:answer-fiel