d8-3fc2c0ac9d9e" :answer/id #uuid "8f34a3ba-0ec0-5087-8ad8-3fc2c0ac9d9e" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-field-9720450f-321d-5bbd-8340-39cc7efd2be9" :answer-field/id #uuid "9720450f-321d-5bbd-8340-39cc7efd2be9" :answer-field/key "field-9" :answer-field/type :answer-field.type/select :answer-field/correct "answer-b7fdb3f7-442e-5568-ba87-007ae4162bc2" :answer-field/choices ["answer-6bbd546a-ac91-57be-8257-ca874e2effc6" "answer-b78b7d03-69a1-5546-ab22-9bb17524be88" "answer-b7fdb3f7-442e-5568-ba87-007ae4162bc2" "answer-ca7c8edd-16e1-565d-ad23-6ffd6816f3f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-6bbd546a-ac91-57be-8257-ca874e2effc6" :answer/id #uuid "6bbd546a-ac91-57be-8257-ca874e2effc6" :answer/type :answer.type/math :answer/value "-\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-b78b7d03-69a1-5546-ab22-9bb17524be88" :answer/id #uuid "b78b7d03-69a1-5546-ab22-9bb17524be88" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b7fdb3f7-442e-5568-ba87-007ae4162bc2" :answer/id #uuid "b7fdb3f7-442e-5568-ba87-007ae4162bc2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ca7c8edd-16e1-565d-ad23-6ffd6816f3f4" :answer/id #uuid "ca7c8edd-16e1-565d-ad23-6ffd6816f3f4" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id 17592186162045 :knowledge-point/questions ["question-6ad1efca-7cc0-5d3a-adf8-070336e066c3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6ad1efca-7cc0-5d3a-adf8-070336e066c3" :question/id #uuid "6ad1efca-7cc0-5d3a-adf8-070336e066c3" :question/math-academy-id "q-363849" :question/problem "$$\nA=[\\begin{aligned}\\sqrt{3} & 0 \\\\ 2 & 0 \\\\ 1 & 0\\end{aligned}],\\,Σ=[\\begin{aligned}2\\sqrt{2} & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,V=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$  select the correct options in the computations of the matrix $U$ below.\n\nFrom the matrix $Σ,$ we deduce the singular values ${\\sigma }_{1}=2\\sqrt{2}$ and ${\\sigma }_{2}=0.$\n\nNow, we compute the $1$st column of $U.$ It is given by:\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${u}_{1}=\\,\\,$ |  | $\\frac{2}{2\\sqrt{2}}$ |  |  |\n|  |  | {{field-2}} |  |  |\n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal.\n\nHence, we must find vectors $u=[{x}_{1},{x}_{2},{x}_{3}]^{T}$ such that ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n{{field-3}}.\n$$\n\nChoosing ${x}_{1}$ and ${x}_{2}$ as free variables, the general solution is given by:\n\n|  |  | ${x}_{1}$ |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | {{field-4}} |  |  |\n|  |  | {{field-5}} |  |  |\n\nthat we can rewrite as:\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ -\\sqrt{3}{x}_{1}-2{x}_{2}\\end{aligned}]={x}_{1}{{[\\begin{aligned}1 \\\\ 0 \\\\ -\\sqrt{3}\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{2}{{[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]}_{⏟}}_{{b}_{2}}.\n$$\n\nNext, we orthogonalize ${b}_{1}$ and ${b}_{2}$ using the Gram-Schmidt process to get the corresponding orthogonal vectors ${c}_{1}$ and ${c}_{2}.$\n\nLet ${c}_{1}={b}_{1},$ then:\n\n|  |  | {{field-6}} |  |  |\n| --- | --- | --- | --- | --- |\n| ${c}_{2}=\\frac{1}{2}\\,\\,$ |  | $2$ |  |  |\n|  |  | {{field-7}} |  |  |\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{2}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-8}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-9}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n<td>\n<table cellpadding=\"0\">\n<tbody>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"3\" width=\"40px\">\n                ${u}_{3}=\\,\\,$\n              </td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"90px\">\n                {{field-10}}\n              </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">\n                {{field-11}}\n              </td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$-\\frac{1}{2\\sqrt{2}}$</td>\n<td align=\"center\"></td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n</tbody>\n</table>\n</td>\n</tr>\n</tbody>\n</table>" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of a $3\\times 2$ matrix $A,$ then\n\n- $Σ$ is a $3\\times 2$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $3\\times 3$ matrix,\n\n- $V$ is an orthogonal $2\\times 2$ matrix.\n\nFrom the matrix $Σ,$ we deduce that ${\\sigma }_{1}=2\\sqrt{2}$ and ${\\sigma }_{2}=0.$\nAlso, the columns ${v}_{1}$ and ${v}_{2}$ of $V$ give us the right singular vectors of $A.$\n\nTherefore, we can compute the first column of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{2\\sqrt{2}}[\\begin{aligned}\\sqrt{3} & 0 \\\\ 2 & 0 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2\\sqrt{2}}[\\begin{aligned}\\sqrt{3} \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{\\sqrt{3}}{2\\sqrt{2}} \\\\ \\frac{2}{2\\sqrt{2}} \\\\ \\frac{1}{2\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nSince the second singular value is ${\\sigma }_{2}=0$, and we do not have the third singular value, we can't use the same formula to find the second and third columns of $U.$ But we know that $U$ must be orthogonal. Hence, we must find vectors \n\n$$\nu=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]\n$$\n\nsuch that ${u}_{1}\\cdot u=0$ and $‖u‖=1.$\n\nSolving ${u}_{1}\\cdot u=0,$ which is equivalent to\n\n$$\n\\frac{\\sqrt{3}}{2\\sqrt{2}}{x}_{1}+\\frac{2}{2\\sqrt{2}}{x}_{2}+\\frac{1}{2\\sqrt{2}}{x}_{3}=0\\,⟹\\,\\sqrt{3}{x}_{1}+2{x}_{2}+{x}_{3}=0,\n$$\n\nwe get the general solution \n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ -\\sqrt{3}{x}_{1}-2{x}_{2}\\end{aligned}]={x}_{1}{{[\\begin{aligned}1 \\\\ 0 \\\\ -\\sqrt{3}\\end{aligned}]}_{⏟}}_{{b}_{1}}+{x}_{2}{{[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]}_{⏟}}_{{b}_{2}},\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are free variables. \n\nNotice that the two linearly independent solutions ${b}_{1}$ and ${b}_{2}$ are *not* mutually orthogonal. Therefore, we have to orthogonalize them using the Gram-Schmidt process. So, let \n\n$$\n{c}_{1}={b}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ -\\sqrt{3}\\end{aligned}].\n$$\n\nThen,\n\n$$\n\\begin{aligned}{c}_{2} & ={b}_{2}-\\frac{{b}_{2}\\cdot {c}_{1}}{{c}_{1}\\cdot {c}_{1}}{c}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ -2\\end{aligned}]-\\frac{2\\sqrt{3}}{4}[\\begin{aligned}1 \\\\ 0 \\\\ -\\sqrt{3}\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}-\\sqrt{3} \\\\ 2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, normalizing orthogonal vectors ${c}_{1}$ and ${c}_{2},$ we obtain the second and third columns of $U:$   \n\n$$\n{u}_{2}=[\\begin{aligned}\\frac{1}{2} \\\\ 0 \\\\ -\\frac{\\sqrt{3}}{2}\\end{aligned}],\\,{u}_{3}=[\\begin{aligned}-\\frac{\\sqrt{3}}{2\\sqrt{2}} \\\\ \\frac{2}{2\\sqrt{2}} \\\\ -\\frac{1}{2\\sqrt{2}}\\end{aligned}]\n$$\n\nSo, the matrix $U$ could be the following:\n\n$$\nU=[\\begin{aligned}\\frac{\\sqrt{3}}{2\\sqrt{2}} & \\frac{1}{2} & -\\frac{\\sqrt{3}}{2\\sqrt{2}} \\\\ \\frac{2}{2\\sqrt{2}} & 0 & \\frac{2}{2\\sqrt{2}} \\\\ \\frac{1}{2\\sqrt{2}} & -\\frac{\\sqrt{3}}{2} & -\\frac{1}{2\\sqrt{2}}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c9d6f9f6-bd5e-5ac7-b00c-1d0584fb7294" "answer-field-ad967851-a20b-571b-bd9c-ca9d1b9b7726" "answer-field-84726cd8-dc37-5951-87d2-ba5e9998bdea" "answer-field-15df1cd3-e39e-5404-bf3f-832cf64e6231" "answer-field-b57406a4-cc7a-5000-8417-921040f8d6a5" "answer-field-6c0922d5-48fe-5cca-bb19-20ebc8119bf9" "answer-field-8a68a5d4-b861-5326-b16f-6a4ee92cce88" "answer-field-e0205c01-66ac-59a7-9db9-2172e1479282" "answer-field-da70fe6d-dc72-54a9-8615-8f7a08d86484" "answer-field-558c9eb5-ede5-54a6-bb1f-e7b9797a4197" "answer-field-9e7c733b-7748-5235-abc7-8dadb500e729"] :db/ensure [:question/validate]} {:db/id "answer-field-c9d6f9f6-bd5e-5ac7-b00c-1d0584fb7294" :answer-field/id #uuid "c9d6f9f6-bd5e-5ac7-b00c-1d0584fb7294" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-e7f052dd-ea71-5e55-9753-e1c03253c68d" :answer-field/choices ["answer-a62ea904-3444-56b9-be64-78fe00a0895c" "answer-57a20775-cfca-5120-aea4-992268ced990" "answer-e7f052dd-ea71-5e55-9753-e1c03253c68d" "answer-d5694631-0546-53e1-b468-c9552c28dc49"] :db/ensure [:answer-field/validate]} {:db/id "answer-a62ea904-3444-56b9-be64-78fe00a0895c" :answer/id #uuid "a62ea904-3444-56b9-be64-78fe00a0895c" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2\\sqrt{2}}" :db/ensure [:answer/validate]} {:db/id "answer-57a20775-c