[{:db/id 17592186253334 :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({6}^{x}-5{x}^{2}+6x-19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-\\frac{\\text{d}}{\\text{d}x}(5{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(6x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({6}^{x})-5\\frac{\\text{d}}{\\text{d}x}({x}^{2})+6\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(19) \\\\  & =\\operatorname{ln}⁡6\\cdot {6}^{x}-5(2x)+6(1)-0 \\\\  & ={6}^{x}\\operatorname{ln}⁡6-10x+6.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186251060 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10x+6" :db/ensure [:answer/validate]} {:db/id 17592186250976 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x" :db/ensure [:answer/validate]} {:db/id 17592186252214 :answer/value "{6}^{x}\\operatorname{ln}⁡6-10{x}^{2}+6x-19" :db/ensure [:answer/validate]} {:db/id "activity-e2e82c62-691b-5d9a-b3f3-9a0b165c5086" :activity/id #uuid "e2e82c62-691b-5d9a-b3f3-9a0b165c5086" :activity/title "Mathematical Methods for the Physical Sciences II: Placement Exam" :activity/type :activity.type/diagnostic :activity/course 17592186046660 :activity/scope 17592186046660 :activity/steps ["step-9e8bb3ad-258a-5aaf-b7ad-50ab83ace195" "step-76ce75e3-6569-5d3a-8f78-21cac24d5cf9" "step-99c04277-921c-5eb2-b2f2-03d51c693e2f" "step-b616e55e-2c24-5bf8-bd7b-1fc8d226bd6c" "step-c8585b05-0cab-5b9d-a7a9-848eeba66f0f" "step-f8f96fee-4fb4-5c60-b9c9-b1e92b98c40f" "step-afe55772-da9e-5105-90d0-cc28ed4446ed" "step-50161c7c-8a22-5355-990f-d18f41eefd28" "step-fd5a3074-aedb-51a2-b380-49c6e4acd963" "step-abcb8860-cb04-5a37-9a14-fd1d1bd1d0f5" "step-bdbefddf-1210-53e6-a7d4-924088aade49" "step-cf2f5d85-555e-5f6c-8e4d-92dc5cb8e33e" "step-5995e35a-7fec-5ae1-a679-012fd2860c02" "step-3760e278-20c9-5f5a-9c86-94097fc8fb42" "step-5e3e02b3-b2af-5445-969d-45bc357d7191" "step-16a99586-0b77-559d-9780-d2906512584c" "step-b94b5f