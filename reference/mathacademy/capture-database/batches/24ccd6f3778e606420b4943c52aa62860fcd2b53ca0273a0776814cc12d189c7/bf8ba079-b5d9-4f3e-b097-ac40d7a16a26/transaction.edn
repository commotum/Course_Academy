red along a curve whose $y$-values increase or decrease rapidly.\n\nAmong the given options, the only scatter plot that fits the description is the following:\n\n![](images/b4/b40de1f74b96a981e9588e63689a766fabef65f4c3f661ebf6f4d2c59e4cd3cc.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f18a88f6-c880-5a4b-af7a-6a47ac397abd"] :db/ensure [:question/validate]} {:db/id "answer-field-f18a88f6-c880-5a4b-af7a-6a47ac397abd" :answer-field/id #uuid "f18a88f6-c880-5a4b-af7a-6a47ac397abd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8de15f1-70a3-5752-9be4-187d7b3268e3" :answer-field/choices ["answer-c9258336-0641-58c8-80ae-bf3a58d70560" "answer-3797fd56-4d6b-5b84-a7c4-46cd74889489" "answer-a8de15f1-70a3-5752-9be4-187d7b3268e3" "answer-b8713086-caf2-5a63-8ee2-f1d919575529" "answer-809eeabf-fff5-5f5a-9ad6-45a41f82ce42"] :db/ensure [:answer-field/validate]} {:db/id "answer-c9258336-0641-58c8-80ae-bf3a58d70560" :answer/id #uuid "c9258336-0641-58c8-80ae-bf3a58d70560" :answer/type :answer.type/image :answer/value "images/58/582d71ad7d583eee536dd917702e6b081987ae6fb65944a156a5617f824132a8.png" :db/ensure [:answer/validate]} {:db/id "answer-3797fd56-4d6b-5b84-a7c4-46cd74889489" :answer/id #uuid "3797fd56-4d6b-5b84-a7c4-46cd74889489" :answer/type :answer.type/image :answer/value "images/7b/7b61b658343f5d94206626acba52d6de3a99e8ba1d760c10afc990f3b85b604a.png" :db/ensure [:answer/validate]} {:db/id "answer-a8de15f1-70a3-5752-9be4-187d7b3268e3" :answer/id #uuid "a8de15f1-70a3-5752-9be4-187d7b3268e3" :answer/type :answer.type/image :answer/value "images/ab/abda1c1dccba746370ac31d71f5a8b531a1bcd10fda6784576fe675943ee56b0.png" :db/ensure [:answer/validate]} {:db/id "answer-b8713086-caf2-5a63-8ee2-f1d919575529" :answer/id #uuid "b8713086-caf2-5a63-8ee2-f1d919575529" :answer/type :answer.type/image :answer/value "images/b4/b4c0c38e55a82e396c08aaf5bd53b2e6a085d5fbc2d75a182deb42bd0c5b791b.png"