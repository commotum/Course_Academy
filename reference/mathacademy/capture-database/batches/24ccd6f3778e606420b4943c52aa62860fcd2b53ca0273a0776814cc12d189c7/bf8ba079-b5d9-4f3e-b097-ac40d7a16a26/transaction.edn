7-ba90-106a58a4e7cf" :answer/type :answer.type/math :answer/value "6x-2" :db/ensure [:answer/validate]} {:db/id "answer-262707e8-a17c-59ce-971e-969d38b738cd" :answer/id #uuid "262707e8-a17c-59ce-971e-969d38b738cd" :answer/type :answer.type/math :answer/value "6x-3" :db/ensure [:answer/validate]} {:db/id "answer-80d1efc3-9f36-58cd-8661-fa04801b6e5a" :answer/id #uuid "80d1efc3-9f36-58cd-8661-fa04801b6e5a" :answer/type :answer.type/math :answer/value "9x-3" :db/ensure [:answer/validate]} {:db/id 17592186073899 :knowledge-point/questions ["question-5eb05574-37e3-55ae-bfb9-7d07106c577c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/id #uuid "5eb05574-37e3-55ae-bfb9-7d07106c577c" :question/math-academy-id "q-160571" :question/problem "What is the distance between the points $(-3,-2)$  and $(-3,-7)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/fa/fa516432771fd242ed51ba8548dd04ca88991fc14992be811a53f8e124b9ff7d.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/99/999cdc70474e5b928b28d611d4c66fb3eeea5716f516af41574712337cb6f9e9.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/91/91bd9f4cd88e966b796f97184eee8aa791e2f20301ff700906ded4d4731eaaf7.png)\n\nThe point $(-3,-7)$ is at a distance of $7$ from the $x$-axis, and the point $(-3,-2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab"] :db/ensure [:question/validate]} {:db/id "answer-field-add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/id #uuid "add93cc1-1ee0-532a-8ce2-54ed8f5fbdab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04640621-f02a-52d2-815f-5bc639b2de01" :answer-field/choices ["answer-c7ea6629-a518-5ad2-a4e0-fa65bbb22766" "answer-6ec6fdb1-0f32-56ac-9952-f5cc890af556" "answer-04640621-f02a-52d2-815f-5bc639b2de01" "answer-5682a8f0-9627-5c70-87ea-7d47bc48f253" "answer-20b16185-d12a-5e60-bcb5-5871047f9569"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7ea6629-a518-5ad2-a4e0-fa65bbb22766" :answer/id #uuid "c7ea6629-a518-5ad2-a4e0-fa65bbb22766" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-6ec6fdb1-0f32-56ac-9952-f5cc890af556" :answer/id #uuid "6ec6fdb1-0f32-56ac-9952-f5cc890af556" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-04640621-f02a-52d2-815f-5bc639b2de01" :answer/id #uuid "04640621-f02a-52d2-815f-5bc639b2de01" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-5682a8f0-9627-5c70-87ea-7d47bc48f253" :answer/id #uuid "5682a8f0-9627-5c70-87ea-7d47bc48f253" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-20b16185-d12a-5e60-bcb5-5871047f9569" :answer/id #uuid "20b16185-d12a-5e60-bcb5-5871047f9569" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186198383 :knowledge-point/questions ["question-d99374cc-b8d8-56af-8d1d-9419fba84ed0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/id #uuid "d99374cc-b8d8-56af-8d1d-9419fba84ed0" :question/math-academy-id "q-162123" :question/problem "What is the missing part of the expression below?\n\n$$\n-\\frac{9}{2}=\\frac{\\bbox[1pt,border:1pt solid black]{\\phantom{A}}}{2}\n$$" :question/worked-solution "A negative number can be obtained if we divide two numbers, one of which is positive and the other negative.\n\nSo, given a negative fraction, we have the following equivalent notations:\n\n$$\n-\\frac{9}{2}=\\frac{-9}{2}=\\frac{9}{-2}\n$$\n\nIn our case, we see that the denominator on the right-hand side is positive $(2).$ Therefore, the missing numerator must be $(-9):$\n\n$$\n-\\frac{9}{2}=\\frac{-9}{2}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0459262a-2257-5a6c-8f05-5a7eb2664614"] :db/ensure [:question/validate]} {:db/id "answer-field-0459262a-2257-5a6c-8f05-5a7eb2664614" :answer-field/id #uuid "0459262a-2257-5a6c-8f05-5a7eb2664614" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df698356-11c2-5c0e-8f6e-0864adcd0f5e" :answer-field/choices ["answer-63aa871a-93a5-5c36-9c9a-76ba1c274a73" "answer-bb8ca89a-2ce8-591a-84d7-697b0563c5b1" "answer-df698356-11c2-5c0e-8f6e-0864adcd0f5e" "answer-749083c7-26de-5ae7-bf3e-e7630c8e5ed6" "answer-84f2df2e-c8e4-5015-bf0d-98a941c09f94"] :db/ensure [:answer-field/validate]} {:db/id "answer-63aa871a-93a5-5c36-9c9a-76ba1c274a73" :answer/id #uuid "63aa871a-93a5-5c36-9c9a-76ba1c274a73" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "answer-bb8ca89a-2ce8-591a-84d7-697b0563c5b1" :answer/id #uuid "bb8ca89a-2ce8-591a-84d7-697b0563c5b1" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-df698356-11c2-5c0e-8f6e-0864adcd0f5e" :answer/id #uuid "df698356-11c2-5c0e-8f6e-0864adcd0f5e" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-749083c7-26de-5ae7-bf3e-e7630c8e5ed6" :answer/id #uuid "749083c7-26de-5ae7-bf3e-e7630c8e5ed6" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-84f2df2e-c8e4-5015-bf0d-98a941c09f94" :answer/id #uuid "84f2df2e-c8e4-5015-bf0d-98a941c09f94" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186110674 :knowledge-point/questions ["question-bc7ca1bb-54ce-5dca-bfc4-11a992a5eb47"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bc7ca1bb-54ce-5dca-bfc4-11a992a5eb47" :question/id #uuid "bc7ca1bb-54ce-5dca-bfc4-11a992a5eb47" :question/math-academy-id "q-113970" :question/problem "![](images/76/76d3a2d884ab6df8d6b6b97be5d5bac91ab30976ba0a6ef8aacc5f3a30eead6c.png)\n\nConsider the figure shown above. Which of the following triplets of points are collinear?\n\nI. $M,T,N$\n\nII. $S,T,O$\n\nIII. $P,Q,N$" :question/worked-solution "- $M,T,N$ are collinear since there is a straight line that passes through all of them.\n\n![](images/a3/a3574ff790eadbc561d842f7c2b485d055a76f5781da76afbd7fb39e45e7ccf0.png)\n\n- $S,T,O$ are collinear since there is a straight line that passes through all of them.\n\n![](images/4c/4ca9c5bbfc7c0f95a5bc03e6e84102eb362cba63d937a184089584a7c2ad58bf.png)\n\n- $P,Q,N$ are **not** collinear since we can't draw a straight line that passes through all of them.\n\n![](images/6b/6b5e9a5c1e1fa271c93667c35c117b197cec3d5a25e5ac311e77f0021663163d.png)\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7e001f08-93a9-56c4-8f18-23859cf513f4"] :db/ensure [:question/validate]} {:db/id "answer-field-7e001f08-93a9-56c4-8f18-23859cf513f4" :answer-field/id #uuid "7e001f08-93a9-56c4-8f18-23859cf513f4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-80a9f806-ee3b-59bc-a294-0cbd78970b1b" :answer-field/choices ["answer-80a9f806-ee3b-59bc-a294-0cbd78970b1b" "answer-49f5ad18-2cdd-5025-9251-13908c923f88" "answer-f96a3832-d587-5a04-ae3d-7c25d92f958f" "answer-98e55936-6fd1-5e13-ac02-4fb7e44e75f1" "answer-40233085-95c2-5cd9-83db-c4b484942aa7"] :db/ensure [:answer-field/validate]} {:db/id "answer-80a9f806-ee3b-59bc-a294-0cbd78970b1b" :answer/id #uuid "80a9f806-ee3b-59bc-a294-0cbd78970b1b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-49f5ad18-2cdd-5025-9251-13908c923f88" :answer/id #uuid "49f5ad18-2cdd-5025-9251-13908c923f88" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-f96a3832-d587-5a04-ae3d-7c25d92f958f" :answer/id #uuid "f96a3832-d587-5a04-ae3d-7c25d92f958f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-98e55936-6fd1-5e13-ac02-4fb7e44e75f1" :answer/id #uuid "98e55936-6fd1-5e13-ac02-4fb7e44e75f1" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-40233085-95c2-5cd9-83db-c4b484942aa7" :answer/id #uuid "40233085-95c2-5cd9-83db-c4b484942aa7" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id 17592186179819 :knowledge-point/questions ["question-65844bd9-30e0-51e9-84e5-199c9f665392"] :db/ensure [:knowledge-point/validate]} {:db/id "question-65844bd9-30e0-51e9-84e5-199c9f665392" :question/id #uuid "65844bd9-30e0-51e9-84e5-199c9f665392" :question/math-academy-id "q-93124" :question/problem "A tank with a capacity of $2\\,000$ liters is filled with $1\\,400$ liters of water. What percentage of the tank is filled with water?" :question/worked-solution "We're given a part and a whole, and we must find a percentage. So, we can use the following formula:\n\n$$\n\\text{percentage}=\\text{part}÷\\text{whole}\n$$\n\nIn this case, \n\n- the part is the amount of water, which is $1\\,400$ liters, and\n\n- the whole is the capacity of the tank, which is $2\\,000$ liters.\n\nSubstituting our numbers into the above formula, we get\n\n$$\n\\text{percentage}=1\\,400÷2\\,000=\\frac{14}{20}.\n$$\n\nTo write this as a percentage, we create an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{14}{20}=\\frac{14\\times 5}{20\\times 5}=\\frac{70}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{70}{100}=70%\n$$\n\nTherefore, $70%$ of the tank is filled with water." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-50ca2ce7-e417-59bb-aca3-04e72dab4b49"] :db/ensure [:question/validate]} {:db/id "answer-field-50ca2ce7-e417-59bb-aca3-04e72dab4b49" :answer-field/id #uuid "50ca2ce7-e417-59bb-aca3-04e72dab4b49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be3b0c24-e0bc-506c-9198-80272d7ce629" :answer-field/choices ["answer-d0e81f18-8cc4-5e74-904b-b57c090b0e0b" "answer-be3b0c24-e0bc-506c-9198-80272d7ce629" "answer-5e15333f-ca67-51f6-8a8d-94a10e15cd8f" "answer-aa5270cf-8c99-5258-865a-b4060d413346" "answer-357ea24f-fa4c-5790-b1a5-9e394835b87e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0e81f18-8cc4-5e74-904b-b57c090b0e0b" :answer/id #uuid "d0e81f18-8cc4-5e74-904b-b57c090b0e0b" :answer/type :answer.type/math :answer/value "60%" :db/ensure [:answer/validate]} {:db/id "answer-be3b0c24-e0bc-506c-9198-80272d7ce629" :answer/id #uuid "be3b0c24-e0bc-506c-9198-80272d7ce629" :answer/type :answer.type/math :answer/value "70%" :db/ensure [:answer/validate]} {:db/id "answer-5e15333f-ca67-51f6-8a8d-94a10e15cd8f" :answer/id #uuid "5e15333f-ca67-51f6-8a8d-94a10e15cd8f" :answer/type :answer.type/math :answer/value "75%" :db/ensure [:answer/validate]} {:db/id "answer-aa5270cf-8c99-5258-865a-b4060d413346" :answer/id #uuid "aa5270cf-8c99-5258-865a-b4060d413346" :answer/type :answer.type/math :answer/value "80%" :db/ensure [:answer/validate]} {:db/id "answer-357ea24f-fa4c-5790-b1a5-9e394835b87e" :answer/id #uuid "357ea24f-fa4c-5790-b1a5-9e394835b87e" :answer/type :answer.type/math :answer/value "85%" :db/ensure [:answer/validate]} {:db/id 17592186188374 :knowledge-point/questions ["question-0943c573-bd9d-551a-bfee-908fd709f4d5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0943c573-bd9d-551a-bfee-908fd709f4d5" :question/id #uuid "0943c573-bd9d-551a-bfee-908fd709f4d5" :question/math-academy-id "q-144238" :question/problem "Simplify the expression $3w-(w-2).$" :question/worked-solution "First, we remove the parentheses by distributing the negative sign. This gives\n\n$$\n3w-w+2\n$$\n\nFinally, we collect like terms:\n\n$$\n\\begin{aligned}3w-w+2 & = \\\\ (3w-w)+2 & = \\\\ 2w+2 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-85b82977-148c-568c-9d3c-62ddc142d73e"] :db/ensure [:question/validate]} {:db/id "answer-field-85b82977-148c-568c-9d3c-62ddc142d73e" :answer-field/id #uuid "85b82977-148c-568c-9d3c-62ddc142d73e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d825af07-747a-5ab9-93a0-29fe92242bb3" :answer-field/choices ["answer-d825af07-747a-5ab9-93a0-29fe92242bb3" "answer-5a360901-ef6f-58c6-a8a1-0c7767bb6cd6" "answer-18a2d47a-16f9-5f20-965d-a5f641df63a6" "answer-598d8397-1bcc-55e6-83d4-fd23a9fcb0a5" "answer-aabbc28d-6e91-53a6-a84c-7c716a82a12e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d825af07-747a-5ab9-93a0-29fe92242bb3" :answer/id #uuid "d825af07-747a-5ab9-93a0-29fe92242bb3" :answer/type :answer.type/math :answer/value "2w+2" :db/ensure [:answer/validate]} {:db/id "answer-5a360901-ef6f-58c6-a8a1-0c7767bb6cd6" :answer/id #uuid "5a360901-ef6f-58c6-a8a1-0c7767bb6cd6" :answer/type :answer.type/math :answer/value "2w-2" :db/ensure [:answer/validate]} {:db/id "answer-18a2d47a-16f9-5f20-965d-a5f641df63a6" :answer/id #uuid "18a2d47a-16f9-5f20-965d-a5f641df63a6" :answer/type :answer.type/math :answer/value "4w+2" :db/ensure [:answer/validate]} {:db/id "answer-598d8397-1bcc-55e6-83d4-fd23a9fcb0a5" :answer/id #uuid "598d8397-1bcc-55e6-83d4-fd23a9fcb0a5" :answer/type :answer.type/math :answer/value "4w-2" :db/ensure [:answer/validate]} {:db/id "answer-aabbc28d-6e91-53a6-a84c-7c716a82a12e" :answer/id #uuid "aabbc28d-6e91-53a6-a84c-7c716a82a12e" :answer/type :answer.type/math :answer/value "w-2" :db/ensure [:answer