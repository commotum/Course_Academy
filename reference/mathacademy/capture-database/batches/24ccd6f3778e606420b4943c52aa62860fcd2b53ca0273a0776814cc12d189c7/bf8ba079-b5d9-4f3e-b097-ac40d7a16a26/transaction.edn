86066709] [:db/retract 17592186066706 :answer-field/choices 17592186066710] [:db/retract 17592186066706 :answer-field/choices 17592186066711] [:db/retract 17592186067756 :answer-field/choices 17592186067760] [:db/retract 17592186067756 :answer-field/choices 17592186067761] [:db/retract 17592186067756 :answer-field/choices 17592186067757] [:db/retract 17592186067756 :answer-field/choices 17592186067758] [:db/retract 17592186067756 :answer-field/choices 17592186067759] {:db/id 17592186069256 :question/problem "![](images/af/afcd7f6646b84debcea24ad6bf3a9cd71d14aae778cdb31b77a36665865a1996.png)\n\nWhat is the circumference of a circle with a radius of $8\\,\\text{cm}?$" :question/worked-solution "We use the formula $C=2\\pi r$ to get\n\n$$\n\\begin{aligned}C & =2\\pi r \\\\  & =2\\pi \\cdot 8 \\\\  & =16\\pi \\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186066706 :answer-field/correct "answer-2495183c-6dbb-598a-808f-628586b9fe57" :answer-field/choices ["answer-1cd3d410-3c97-5b5e-bcf8-a98a446e144b" "answer-2495183c-6dbb-598a-808f-628586b9fe57" "answer-4c52566a-ed5d-53b3-88c6-c1e145863df0" "answer-da44332b-8fd7-5949-8407-aa22d1e3488a" "answer-35ef7018-e4a3-5cbc-8d70-cdf053cda6d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-1cd3d410-3c97-5b5e-bcf8-a98a446e144b" :answer/id #uuid "1cd3d410-3c97-5b5e-bcf8-a98a446e144b" :answer/type :answer.type/math :answer/value "16\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-2495183c-6dbb-598a-808f-628586b9fe57" :answer/id #uuid "2495183c-6dbb-598a-808f-628586b9fe57" :answer/type :answer.type/math :answer/value "16\\pi \\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-4c52566a-ed5d-53b3-88c6-c1e145863df0" :answer/id #uuid "4c52566a-ed5d-53b3-88c6-c1e145863df0" :answer/type :answer.type/math :answer/value "32\\pi \\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-da44332b-8fd7-5949-8407-aa22d1e3488a" :answer/id #uuid "da44332b-8fd7-5949-8407-aa22d1e3488a" :answer/type :answer.type/math :answer/value "4\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-35ef7018-e4a3-5cbc-8d70-cdf053cda6d4" :answer/id #uuid "35ef7018-e4a3-5cbc-8d70-cdf053cda6d4" :answer/type :answer.type/math :answer/value "6\\pi \\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id 17592186068684 :knowledge-point/questions ["question-b99550b6-8022-5cbb-baaa-e73791a1b173"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b99550b6-8022-5cbb-baaa-e73791a1b173" :question/id #uuid "b99550b6-8022-5cbb-baaa-e73791a1b173" :question/math-academy-id "q-53555" :question/problem "![](images/a4/a4ff0f0f932cf6f2c98f474e2d0d6d6450e5c6072608a4f2fab4cd50aa650d94.png)\n\nA circular plot of land has a diameter of $20\\,\\text{m}.$ What length of fence is needed to border this plot of land?" :question/worked-solution "The length of the fence needed to border the circular land is its circumference.\n\nThe formula for the circumference of a circle is $C=\\pi d,$ where $d=20\\,\\text{m}$ is the diameter.\n\nTherefore, we have\n\n$$\nC=\\pi \\cdot 20=20\\pi \\,\\text{m}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6780567c-cefa-51bd-8a53-02a09d77b6b0"] :db/ensure [:question/validate]} {:db/id "answer-field-6780567c-cefa-51bd-8a53-02a09d77b6b0" :answer-field/id #uuid "6780567c-cefa-51bd-8a53-02a09d77b6b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1cc74002-0c78-5dae-9707-9fc6b2c0acc9" :answer-field/choices ["answer-ade05a1d-8e7a-5fc3-97af-ab7e34759ac1" "answer-1cc74002-0c78-5dae-9707-9fc6b2c0acc9" "answer-fb50c58d-a49d-5612-bfc9-30c593717a24" "answer-3e5fb3ec-04f9-557a-a27d-938fe5b48a02" "answer-590ac348-294a-5f50-a8c7-b17dbddb6c87"] :db/ensure [:answer-field/validate]} {:db/id "answer-ade05a1d-8e7a-5fc3-97af-ab7e34759ac1" :answer/id #uuid "ade05a1d-8e7a-5fc3-97af-ab7e34759ac1" :answer/type :answer.type/math :answer/value "10\\pi \\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-1cc74002-0c78-5dae-9707-9fc6b2c0acc9" :answer/id #uuid "1cc74002-0c78-5dae-9707-9fc6b2c0acc9" :answer/type :answer.type/math :answer/value "20\\pi \\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-fb50c58d-a49d-5612-bfc9-30c593717a24" :answer/id #uuid "fb50c58d-a49d-5612-bfc9-30c593717a24" :answer/type :answer.type/math :answer/value "40\\pi \\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-3e5fb3ec-04f9-557a-a27d-938fe5b48a02" :answer/id #uuid "3e5fb3ec-04f9-557a-a27d-938fe5b48a02" :answer/type :answer.type/math :answer/value "50\\pi \\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-590ac348-294a-5f50-a8c7-b17dbddb6c87" :answer/id #uuid "590ac348-294a-5f50-a8c7-b17dbddb6c87" :answer/type :answer.type/math :answer/value "5\\pi \\,\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186069431 :question/problem "Ken's tree has a diameter of $4\\,\\text{ft}.$ What length of chain does Ken need for it to wrap around the tree perfectly?" :question/worked-solution "The length of the chain needed to wrap around the tree is its circumference.\n\nThe formula for the circumference of a circle is $C=\\pi d,$ where $d=4\\,\\text{ft}$ is the diameter.\n\nTherefore, we have\n\n$$\nC=\\pi \\cdot 4=4\\pi \\,\\text{ft}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186067756 :answer-field/correct "answer-e24d60bc-e43a-5171-acd0-fdd50211baf0" :answer-field/choices ["answer-b40ea921-33a0-56f3-b29a-40075c246ad4" "answer-e24d60bc-e43a-5171-acd0-fdd50211baf0" "answer-4a14f43c-a600-563f-9d5a-fb05244e3a85" "answer-03e3b387-d21e-5429-bea6-116f81ba1ff5" "answer-8c6bc2bf-f6de-5c8f-9eae-af5bddf27872"] :db/ensure [:answer-field/validate]} {:db/id "answer-b40ea921-33a0-56f3-b29a-40075c246ad4" :answer/id #uuid "b40ea921-33a0-56f3-b29a-40075c246ad4" :answer/type :answer.type/math :answer/value "2\\pi \\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-e24d60bc-e43a-5171-acd0-fdd50211baf0" :answer/id #uuid "e24d60bc-e43a-5171-acd0-fdd50211baf0" :answer/type :answer.type/math :answer/value "4\\pi \\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-4a14f43c-a600-563f-9d5a-fb05244e3a85" :answer/id #uuid "4a14f43c-a600-563f-9d5a-fb05244e3a85" :answer/type :answer.type/math :answer/value "8\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-03e3b387-d21e-5429-bea6-116f81ba1ff5" :answer/id #uuid "03e3b387-d21e-5429-bea6-116f81ba1ff5" :answer/type :answer.type/math :answer/value "8\\pi \\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-8c6bc2bf-f6de-5c8f-9eae-af5bddf27872" :answer/id #uuid "8c6bc2bf-f6de-5c8f-9eae-af5bddf27872" :answer/type :answer.type/math :answer/value "\\pi \\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "activity-ddf2c666-86f8-502f-9585-efc495d0f82c" :activity/id #uuid "ddf2c666-86f8-502f-9585-efc495d0f82c" :activity/title "The Circumference of a Circle" :activity/type :activity.type/review :activity/scope 17592186050089 :activity/course 17592186046647 :activity/steps ["step-b9c93b9a-4e23-53cc-bb82-5cef9ff44438" "step-ff6ec4ce-a876-55f0-a547-0177e1ff36c5" "step-040c1124-5997-531e-bc13-442121034938"] :activity/first-step "step-b9c93b9a-4e23-53cc-bb82-5cef9ff44438" :db/ensure [:activity/validate]} {:db/id "step-b9c93b9a-4e23-53cc-bb82-5cef9ff44438" :step/id #uuid "b9c93b9a-4e23-53cc-bb82-5cef9ff44438" :step/content 17592186069256 :step/next "step-ff6ec4ce-a876-55f0-a547-0177e1ff36c5" :db/ensure [:step/validate]} {:db/id "step-ff6ec4ce-a876-55f0-a547-0177e1ff36c5" :step/id #uuid "ff6ec4ce-a876-55f0-a547-0177e1ff36c5" :step/content "question-b99550b6-8022-5cbb-baaa-e73791a1b173" :step/next "step-040c1124-5997-531e-bc13-442121034938" :db/ensure [:step/validate]} {:db/id "step-040c1124-5997-531e-bc13-442121034938" :step/id #uuid "040c1124-5997-531e-bc13-442121034938" :step/content 17592186069431 :db/ensure [:step/validate]} {:db/id 17592186184172 :knowledge-point/questions ["question-c10d4c77-93c5-52a9-900d-275fa9299d3e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184755 :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}\\{[\\begin{aligned}5 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}3 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]\\}?\n$$\n\nI. The number of non-pivot columns in $A$ is equal to $3$\n\nII. $\\text{Col}(A)={R}^{4}$\n\nIII. $\\text{rank}(A)=2$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the generating vectors in \n\n$$\n\\text{Null}(A)=\\text{Span}\\{[\\begin{aligned}5 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}3 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]\\}\n$$\n\nare linearly independent, we conclude that the number of non-pivot columns in $A$ is equal to $2.$\n\n- Statement II is false. Since $\\text{nullity}(A)=2\\ne 0,$ then by the invertible matrix theorem, we have $\\text{Col}(A)\\ne {R}^{4}.$\n\n- Statement III is true. Indeed, for the matrix $A,$ the number of columns is $n=4.$ Now, according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =4 \\\\ \\text{rank}(A) & =4-2 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186183139 :answer-field/correct 17592186183141 :db/ensure [:answer-field/validate]} {:db/id "question-c10d4c77-93c5-52a9-900d-275fa9299d3e" :question/id #uuid "c10d4c77-93c5-52a9-900d-275fa9299d3e" :question/math-academy-id "q-79410" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\text{Span}\\{[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]\\}?\n$$\n\nI. $\\text{rank}(A)=2$\n\nII. $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}$\n\nIII. $A$ has $2$ pivot colums" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since the non-zero vector\n\n$$\n[\\begin{aligned}1 \\\\ 0 \\\\ -1 \\\\ 0\\end{aligned}]\n$$\n\nspans $\\text{Null}(A),$ we conclude that $\\text{nullity}(A)=1.$ So, by the rank-nullity theorem, with $n=4$,  we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+1 & =4 \\\\ \\text{rank}(A) & =4-1 \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, since $\\text{dim(Col}(A))=\\text{rank}(A)=3,$ we must have  that $\\text{Col}(A)$ is a $3$-dimensional subspace of ${R}^{4}.$\n\n- Statement III is false. The fact that $\\text{dim(Col}(A))=3$ implies that the number of pivot columns in $A$ is also equal to $3.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c143e0e6-92b8-5ab3-a31a-0f6f3f8892c7"] :db/ensure [:question/validate]} {:db/id "answer-field-c143e0e6-92b8-5ab3-a31a-0f6f3f8892c7" :answer-field/id #uuid "c143e0e6-92b8-5ab3-a31a-0f6f3f8892c7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0f1b4ae3-0a40-5756-bb35-332f91366150" :answer-field/choices ["answer-3dc8c0b7-7f8f-5ba1-a69b-9e3d9da97a75" "answer-73232096-0842-59cd-811b-a3783597953d" "answer-855804bf-27d3-5391-ba94-a4c1ff073b30" "answer-0f1b4ae3-0a40-5756-bb35-332f91366150" "answer-341ea572-fea0-5ab5-8e97-94b9de3afc39"] :db/ensure [:answer-field/validate]} {:db/id "answer-3dc8c0b7-7f8f-5ba1-a69b-9e3d9da97a75" :answer/id #uuid "3dc8c0b7-7f8f-5ba1-a69b-9e3d9da97a75" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-73232096-0842-59cd-811b-a3783597953d" :answer/id #uuid "73232096-0842-59cd-811b-a3783597953d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-855804bf-27d3-5391-ba94-a4c1ff073b30" :answer/id #uuid "855804bf-27d3-5391-ba94-a4c1ff073b30" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-0f1b4ae3-0a40-5756-bb35-332f91366150" :answer/id #uuid "0f1b4ae3-0a40-5756-bb35-332f91366150" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-341ea572-fea0-5ab5-8e97-94b9de3afc39" :answer/id #uuid "341ea572-fea0-5ab5-8e97-94b9de3afc39" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186184171 :knowledge-point/questions ["question-94febb74-e81c-5137-a80c-9d7fa83538e0" "question-5e7c8be1-d271-506d-bfc9-fbf1881a88d8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-94febb74-e81c-5137-a80c-9d7fa83538e0" :question/id #uuid "94febb74-e81c-5137-a80c-9d7fa83538e0" :question/math-academy-id "q-141229" :question/problem "Let $A$ be a $4\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-3 \\\\ \\text{dim(Null}(A)) & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4635540b-1236-5d34-8d5b-e01f27623485"] :db/ensure [:question/validate]} {:db/id "answer-field-4635540b-1236-5d34-8d5b-e01f27623485" :answer-field/id #uuid "4635540b-1236-5d34-8d5b-e01f27623485" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dec293c4-9e4a-569e-b668-6abc7a7c73a6" :answer-field/choices ["answer-269226e3-2066-5e11-9e53-68cf25388793" "answer-dec293c4-9e4a-569e-b668-6abc7a7c73a6" "answer-9ab4711a-55c0-5e5e-90df-e23264046ee4" "answer-daf3c561-12b4-504e-a0d4-870b426bed38" "answer-1666c48c-616a-5584-b4b9-47f389d5edd6"] :db/ensure [:answer-field/validate]} {:db/id "answer-269226e3-2066-5e11-9e53-68cf25388793" :answer/id #uuid "269226e3-2066-5e11-9e53-68cf25388793" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-dec293c4-9e4a-569e-b668-6abc7a7c73a6" :answer/id #uuid "dec293c4-9e4a-569e-b668-6abc7a7c73a6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-9ab4711a-55c0-5e5e-90df-e23264046ee4" :answer/id #uuid "9ab4711a-55c0-5e5e-90df-e23264046ee4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-daf3c561-12b4-504e-a0d4-870b426bed38" :answer/id #uuid "daf3c561-12b4-504e-a0d4-870b426bed38" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-1666c48c-616a-5584-b4b9-47f389d5edd6" :answer/id #uuid "1666c48c-616a-5584-b4b9-47f389d5edd6" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-5e7c8be1-d271-506d-bfc9-fbf1881a88d8" :question/id #uuid "5e7c8be1-d271-506d-bfc9-fbf1881a88d8" :question/math-academy-id "q-142489" :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 0 \\\\ {x}_{1}+{x}_{2} \\\\ 0 \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=5,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =5 \\\\ \\text{rank}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a810a855-c6d2-5045-a468-45c2987823ad"] :db/ensure [:question/validate]} {:db/id "answer-field-a810a855-c6d2-5045-a468-45c2987823ad" :answer-field/id #uuid "a810a855-c6d2-5045-a468-45c2987823ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d71b0cc6-29c4-5b34-b310-64ab60f5b724" :answer-field/choices ["answer-d90fb75f-16a5-5779-817f-22c451b4191b" "answer-b366e033-8b4f-533d-86e0-d5b107bc8270" "answer-d71b0cc6-29c4-5b34-b310-64ab60f5b724" "answer-2237675a-cbb8-55f4-ac1e-48c201dc4645" "answer-fe29b5e6-ad57-590e-8812-0f23650c5a45"] :db/ensure [:answer-field/validate]} {:db/id "answer-d90fb75f-16a5-5779-817f-22c451b4191b" :answer/id #uuid "d90fb75f-16a5-5779-817f-22c451b4191b" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b366e033-8b4f-533d-86e0-d5b107bc8270" :answer/id #uuid "b366e033-8b4f-533d-86e0-d5b107bc8270" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-d71b0cc6-29c4-5b34-b310-64ab60f5b724" :answer/id #uuid "d71b0cc6-29c4-5b34-b310-64ab60f5b724" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-2237675a-cbb8-55f4-ac1e-48c201dc4645" :answer/id #uuid "2237675a-cbb8-55f4-ac1e-48c201dc4645" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-fe29b5e6-ad57-590e-8812-0f23650c5a45" :answer/id #uuid "fe29b5e6-ad57-590e-8812-0f23650c5a45" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "activity-4c0943ba-1699-5e8c-8670-aee7d34650f4" :activity/id #uuid "4c0943ba-1699-5e8c-8670-aee7d34650f4" :activity/title "The Rank-Nullity Theorem" :activity/type :activity.type/review :activity/scope 17592186048978 :activity/course 17592186046658 :activity/steps ["step-1eba418a-0a45-5af7-91fd-642512667c9b" "step-d4a34369-680e-54a1-9729-80a4a7934062" "step-e48dd2d3-2546-5691-ad94-982797f6f0e4" "step-648619fe-b878-526f-9493-71c3a98c37c8" "step-a4b43338-82e4-5410-9f98-512abc7e92cc"] :activity/first-step "step-1eba418a-0a45-5af7-91fd-642512667c9b" :db/ensure [:activity/validate]} {:db/id "step-1eba418a-0a45-5af7-91fd-642512667c9b" :step/id #uuid "1eba418a-0a45-5af7-91fd-642512667c9b" :step/content 17592186184755 :step/next "step-d4a34369-680e-54a1-9729-80a4a7934062" :db/ensure [:step/validate]} {:db/id "step-d4a34369-680e-54a1-9729-80a4a7934062" :step/id #uuid "d4a34369-680e-54a1-9729-80a4a7934062" :step/content 17592186377763 :step/next "step-e48dd2d3-2546-5691-ad94-982797f6f0e4" :db/ensure [:step/validate]} {:db/id "step-e48dd2d3-2546-5691-ad94-982797f6f0e4" :step/id #uuid "e48dd2d3-2546-5691-ad94-982797f6f0e4" :step/content "question-c10d4c77-93c5-52a9-900d-275fa9299d3e" :step/next "step-648619fe-b878-526f-9493-71c3a98c37c8" :db/ensure [:step/validate]} {:db/id "step-648619fe-b878-526f-9493-71c3a98c37c8" :step/id #uuid "648619fe-b878-526f-9493-71c3a98c37c8" :step/content "question-94febb74-e81c-5137-a80c-9d7fa83538e0" :step/next "step-a4b43338-82e4-5410-9f98-512abc7e92cc" :db/ensure [:step/validate]} {:db/id "step-a4b43338-82e4-5410-9f98-512abc7e92cc" :step/id #uuid "a4b43338-82e4-5410-9f98-512abc7e92cc" :step/content "question-5e7c8be1-d271-506d-bfc9-fbf1881a88d8" :db/ensure [:step/validate]} {:db/id 17592186188338 :knowledge-point/questions ["question-cb67f6a8-9365-5c2f-8040-e07ca796601e" "question-fa5bb889-1d66-5ec8-b499-bab2b60bc9f8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188661 :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}x+y, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1}{2}+y, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=\\frac{1}{2}]$ given that the corresponding expected value is ${\\mu }_{X|\\frac{1}{2}}=\\frac{7}{12}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{x+y}{\\frac{1}{2}+y} \\\\  & =\\frac{2(x+y)}{1+2y},\\end{aligned}\n$$\n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$\n\nNow, substituting $y=\\frac{1}{2}$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,\\frac{1}{2})=\\frac{2(x+\\frac{1}{2})}{1+2\\cdot \\frac{1}{2}}=\\frac{2x+1}{2}=x+\\frac{1}{2}.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=\\frac{1}{2}] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,\\frac{1}{2})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}(x+\\frac{1}{2})\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{3}+\\frac{{x}^{2}}{2})\\text{d}x \\\\  & ={[\\frac{{x}^{4}}{4}+\\frac{{x}^{3}}{6}]}_{0}^{1} \\\\  & =(\\frac{1}{4}+\\frac{1}{6})-0 \\\\  & =\\frac{5}{12}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=\\frac{1}{2}] & =\\text{E}[{X}^{2}\\,|\\,Y=\\frac{1}{2}]-{\\mu }_{X|\\frac{1}{2}}^{2} \\\\  & =\\frac{5}{12}-{(\\frac{7}{12})}^{2} \\\\  & =\\frac{5}{12}-\\frac{49}{144} \\\\  & =\\frac{11}{144}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186186246 :answer-field/correct 17592186186250 :db/ensure [:answer-field/validate]} {:db/id "question-cb67f6a8-9365-5c2f-8040-e07ca796601e" :question/id #uuid "cb67f6a8-9365-5c2f-8040-e07ca796601e" :question/math-academy-id "q-146390" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{8}{7}xy, & 0\\le y\\le 1,\\,y\\le x\\le 2 \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{4}{7}y(4-{y}^{2}), & 0\\le y\\le 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=\\frac{1}{2}]$ given that the corresponding expected value is ${\\mu }_{X|\\frac{1}{2}}=\\frac{7}{5}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{\\frac{8}{7}xy}{\\frac{4}{7}y(4-{y}^{2})} \\\\  & =\\frac{2x}{4-{y}^{2}},\\end{aligned}\n$$\n\nwhere $0\\le y\\le 1,\\,y\\le x\\le 2.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$\n\nNow, substituting $y=\\frac{1}{2}$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,\\frac{1}{2})=\\frac{2x}{(4-{(\\frac{1}{2})}^{2})}=\\frac{2x}{(\\frac{15}{4})}=\\frac{8}{15}x.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=\\frac{1}{2}] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,\\frac{1}{2})\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{2}{x}^{2}\\cdot \\frac{8}{15}x\\text{d}x \\\\  & =\\frac{8}{15}{\\int }_{1/2}^{2}{x}^{3}\\text{d}x \\\\  & =\\frac{8}{15}{[\\frac{{x}^{4}}{4}]}_{1/2}^{2} \\\\  & =\\frac{8}{15}\\cdot \\frac{1}{4}[{x}^{4}]_{1/2}^{2} \\\\  & =\\frac{2}{15}(16-\\frac{1}{16}) \\\\  & =\\frac{2}{15}\\cdot \\frac{255}{16} \\\\  & =\\frac{17}{8}\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=\\frac{1}{2}] & =\\text{E}[{X}^{2}\\,|\\,Y=\\frac{1}{2}]-{\\mu }_{X|\\frac{1}{2}}^{2} \\\\  & =\\frac{17}{8}-{(\\frac{7}{5})}^{2} \\\\  & =\\frac{17}{8}-\\frac{49}{25} \\\\  & =\\frac{33}{200}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-12a1b473-68e4-5c3b-8125-45d0cb822b91"] :db/ensure [:question/validate]} {:db/id "answer-field-12a1b473-68e4-5c3b-8125-45d0cb822b91" :answer-field/id #uuid "12a1b473-68e4-5c3b-8125-45d0cb822b91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-840b7aa1-f717-5655-85ec-596b4ab1d025" :answer-field/choices ["answer-f1e99de4-ede4-589b-af99-ad16705b718a" "answer-73f2b6d9-290a-5c57-9e0d-31e098d34378" "answer-840b7aa1-f717-5655-85ec-596b4ab1d025" "answer-3da82ce9-78a2-543b-b42d-6a1dff04ede5" "answer-cf7dd604-9a13-5ed1-a0b7-6e46c2373cbb"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1e99de4-ede4-589b-af99-ad16705b718a" :answer/id #uuid "f1e99de4-ede4-589b-af99-ad16705b718a" :answer/type :answer.type/math :answer/value "\\frac{11}{100}" :db/ensure [:answer/validate]} {:db/id "answer-73f2b6d9-290a-5c57-9e0d-31e098d34378" :answer/id #uuid "73f2b6d9-290a-5c57-9e0d-31e098d34378" :answer/type :answer.type/math :answer/value "\\frac{17}{100}" :db/ensure [:answer/validate]} {:db/id "answer-840b7aa1-f717-5655-85ec-596b4ab1d025" :answer/id #uuid "840b7aa1-f717-5655-85ec-596b4ab1d025" :answer/type :answer.type/math :answer/value "\\frac{33}{200}" :db/ensure [:answer/validate]} {:db/id "answer-3da82ce9-78a2-543b-b42d-6a1dff04ede5" :answer/id #uuid "3da82ce9-78a2-543b-b42d-6a1dff04ede5" :answer/type :answer.type/math :answer/value "\\frac{37}{200}" :db/ensure [:answer/validate]} {:db/id "answer-cf7dd604-9a13-5ed1-a0b7-6e46c2373cbb" :answer/id #uuid "cf7dd604-9a13-5ed1-a0b7-6e46c2373cbb" :answer/type :answer.type/math :answer/value "\\frac{3}{100}" :db/ensure [:answer/validate]} {:db/id 17592186188337 :knowledge-point/questions ["question-da13a004-2a50-58d1-9227-22e3b27eef81"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188722 :question/problem "$$\n{f}_{Y|X}(y\\,|\\,3)=\\{\\begin{aligned}\\frac{5}{2{y}^{7/2}}, & \\,1\\le y \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=3]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,3)$ is shown above and the corresponding expected value is ${\\mu }_{Y|3}=\\frac{5}{3}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=3] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,3)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{5}{2{y}^{7/2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{5}{2{y}^{3/2}}\\,\\text{d}y \\\\  & ={[-5\\frac{1}{\\sqrt{y}}]}_{1}^{\\infty } \\\\  & =5.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=3] & =\\text{E}[{Y}^{2}\\,|\\,X=3]-{\\mu }_{Y|3}^{2} \\\\  & =5-{(\\frac{5}{3})}^{2} \\\\  & =5-\\frac{25}{9} \\\\  & =\\frac{20}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186186612 :answer-field/correct 17592186186615 :db/ensure [:answer-field/validate]} {:db/id "question-fa5bb889-1d66-5ec8-b499-bab2b60bc9f8" :question/id #uuid "fa5bb889-1d66-5ec8-b499-bab2b60bc9f8" :question/math-academy-id "q-146830" :question/problem "$$\n\\begin{aligned}f(x,y)=\\{\\begin{aligned}\\frac{2(x+2y)}{3}, & 0\\le x\\le 1,\\,0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\,{f}_{Y}(y)=\\{\\begin{aligned}\\frac{1+4y}{3}, & 0\\le y\\le 1, \\\\ 0, & \\text{otherwise}\\end{aligned}\\end{aligned}\n$$\n\n \n\nLet $X$ and $Y$  be continuous random variables. Their joint probability density function and the marginal probability density function of $Y$ are shown above. Find the conditional variance $\\text{Var}[X\\,|\\,Y=1]$ given that the corresponding expected value is ${\\mu }_{X|1}=\\frac{8}{15}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{X}^{2}\\,|\\,Y=y]={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)\\,\\text{d}x.\n$$\n\nNote that $\\text{E}[X\\,|\\,Y=y]$ is a function of $y.$ \n\nThe conditional density function of $X$ given $Y=y$ can be computed as \n\n$$\n\\begin{aligned}{f}_{X|Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{2(x+2y)}{3})}{(\\frac{1+4y}{3})} \\\\  & =\\frac{2(x+2y)}{1+4y},\\end{aligned}\n$$\n\n \n\nwhere $0\\le x\\le 1,\\,0\\le y\\le 1.$ Outside this domain, we have ${f}_{X|Y}(x\\,|\\,y)=0.$ \n\nNow, substituting $y=1$ into the expression for ${f}_{X|Y}(x\\,|\\,y),$ we get\n\n$$\n{f}_{X|Y}(x\\,|\\,1)=\\frac{2(x+2\\cdot 1)}{1+4\\cdot 1}=\\frac{2x+4}{5}.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}\\,|\\,Y=1] & ={\\int }_{-\\infty }^{\\infty }{x}^{2}\\,{f}_{X|Y}(x\\,|\\,1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}(\\frac{2x+4}{5})\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{0}^{1}(2{x}^{3}+4{x}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{5}{[\\frac{{x}^{4}}{2}+\\frac{4{x}^{3}}{3}]}_{0}^{1} \\\\  & =\\frac{1}{5}[(\\frac{1}{2}+\\frac{4}{3})-0] \\\\  & =\\frac{1}{5}[\\frac{11}{6}] \\\\  & =\\frac{11}{30}.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=1] & =\\text{E}[{X}^{2}\\,|\\,Y=1]-{\\mu }_{X|1}^{2} \\\\  & =\\frac{11}{30}-{(\\frac{8}{15})}^{2} \\\\  & =\\frac{37}{450}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-08777c93-71f1-55d9-8b74-18999d083645"] :db/ensure [:question/validate]} {:db/id "answer-field-08777c93-71f1-55d9-8b74-18999d083645" :answer-field/id #uuid "08777c93-71f1-55d9-8b74-18999d083645" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-155ff5aa-4252-5ac2-80e1-ab36e6819d83" :answer-field/choices ["answer-bd742401-7fbe-51ac-b99e-fa8961304350" "answer-155ff5aa-4252-5ac2-80e1-ab36e6819d83" "answer-63386fd4-c351-5fcf-a204-868e364ac71f" "answer-9519ed18-f682-5e18-95a3-d2bb7a09c5cd" "answer-efcb4a86-108b-540b-8958-93dcf800b027"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd742401-7fbe-51ac-b99e-fa8961304350" :answer/id #uuid "bd742401-7fbe-51ac-b99e-fa8961304350" :answer/type :answer.type/math :answer/value "\\frac{19}{225}" :db/ensure [:answer/validate]} {:db/id "answer-155ff5aa-4252-5ac2-80e1-ab36e6819d83" :answer/id #uuid "155ff5aa-4252-5ac2-80e1-ab36e6819d83" :answer/type :answer.type/math :answer/value "\\frac{37}{450}" :db/ensure [:answer/validate]} {:db/id "answer-63386fd4-c351-5fcf-a204-868e364ac71f" :answer/id #uuid "63386fd4-c351-5fcf-a204-868e364ac71f" :answer/type :answer.type/math :answer/value "\\frac{41}{350}" :db/ensure [:answer/validate]} {:db/id "answer-9519ed18-f682-5e18-95a3-d2bb7a09c5cd" :answer/id #uuid "9519ed18-f682-5e18-95a3-d2bb7a09c5cd" :answer/type :answer.type/math :answer/value "\\frac{4}{45}" :db/ensure [:answer/validate]} {:db/id "answer-efcb4a86-108b-540b-8958-93dcf800b027" :answer/id #uuid "efcb4a86-108b-540b-8958-93dcf800b027" :answer/type :answer.type/math :answer/value "\\frac{61}{450}" :db/ensure [:answer/validate]} {:db/id "question-da13a004-2a50-58d1-9227-22e3b27eef81" :question/id #uuid "da13a004-2a50-58d1-9227-22e3b27eef81" :question/math-academy-id "q-149429" :question/problem "$$\n{f}_{Y|X}(y\\,|\\,4)=\\{\\begin{aligned}\\frac{8}{3{y}^{11/3}}, & \\,1\\le y \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nLet $X$ and $Y$ be continuous random variables. \nFind the conditional variance $\\text{Var}[Y\\,|\\,X=4]$ given that the conditional probability density function ${f}_{Y|X}(y\\,|\\,4)$ is shown above and the corresponding expected value is ${\\mu }_{Y|4}=\\frac{8}{5}.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2},\\end{aligned}\n$$\n\nwhere \n\n$$\n\\text{E}[{Y}^{2}\\,|\\,X=x]={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)\\,\\text{d}y.\n$$\n\nTherefore, we obtain \n\n$$\n\\begin{aligned}\\text{E}[{Y}^{2}\\,|\\,X=4] & ={\\int }_{-\\infty }^{\\infty }{y}^{2}\\,{f}_{Y|X}(y\\,|\\,4)\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }{y}^{2}\\cdot \\frac{8}{3{y}^{11/3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{8}{3{y}^{5/3}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{\\infty }\\frac{8}{3}{y}^{-5/3}\\,\\text{d}y \\\\  & ={[\\frac{8}{3}\\cdot (-\\frac{3}{2})\\cdot {y}^{-2/3}]}_{1}^{\\infty } \\\\  & ={[-\\frac{4}{{y}^{2/3}}]}_{1}^{\\infty } \\\\  & =0-(-4) \\\\  & =4.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=4] & =\\text{E}[{Y}^{2}\\,|\\,X=4]-{\\mu }_{Y|4}^{2} \\\\  & =4-{(\\frac{8}{5})}^{2} \\\\  & =4-\\frac{64}{25} \\\\  & =\\frac{36}{25}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8d2588d2-34f5-552a-8d6d-c5e7c03f7737"] :db/ensure [:question/validate]} {:db/id "answer-field-8d2588d2-34f5-552a-8d6d-c5e7c03f7737" :answer-field/id #uuid "8d2588d2-34f5-552a-8d6d-c5e7c03f7737" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1d98834-f4f5-587e-83de-a18d83a26a86" :answer-field/choices ["answer-eed61002-51ff-5a1c-9ad4-f4d067a9f8d6" "answer-3704891e-617a-5863-9a03-baf25c99600b" "answer-77363dd6-1e0e-5193-8140-a9949d0605e3" "answer-3a4c20c4-9a93-56b4-8882-ad1c931d6d09" "answer-e1d98834-f4f5-587e-83de-a18d83a26a86"] :db/ensure [:answer-field/validate]} {:db/id "answer-eed61002-51ff-5a1c-9ad4-f4d067a9f8d6" :answer/id #uuid "eed61002-51ff-5a1c-9ad4-f4d067a9f8d6" :answer/type :answer.type/math :answer/value "\\frac{12}{25}" :db/ensure [:answer/validate]} {:db/id "answer-3704891e-617a-5863-9a03-baf25c99600b" :answer/id #uuid "3704891e-617a-5863-9a03-baf25c99600b" :answer/type :answer.type/math :answer/value "\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "answer-77363dd6-1e0e-5193-8140-a9949d0605e3" :answer/id #uuid "77363dd6-1e0e-5193-8140-a9949d0605e3" :answer/type :answer.type/math :answer/value "\\frac{28}{25}" :db/ensure [:answer/validate]} {:db/id "answer-3a4c20c4-9a93-56b4-8882-ad1c931d6d09" :answer/id #uuid "3a4c20c4-9a93-56b4-8882-ad1c931d6d09" :answer/type :answer.type/math :answer/value "\\frac{28}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e1d98834-f4f5-587e-83de-a18d83a26a86" :answer/id #uuid "e1d98834-f4f5-587e-83de-a18d83a26a86" :answer/type :answer.type/math :answer/value "\\frac{36}{25}" :db/ensure [:answer/validate]} {:db/id "activity-df6d61a7-cd86-5ac5-97fc-01ff756a34b2" :activity/id #uuid "df6d61a7-cd86-5ac5-97fc-01ff756a34b2" :activity/title "Conditional Variance for Continuous Random Variables" :activity/type :activity.type/review :activity/scope 17592186049908 :activity/course 17592186046658 :activity/steps ["step-aad3c882-96ee-5b93-a8e5-1fd98a1acdf4" "step-0d528e79-53bc-5be0-992d-62a18f4c262f" "step-3b11e1b9-606d-568a-aff8-39bd701af3dd" "step-4a39c991-2450-5455-97eb-6d1a8a8ba947" "step-30b66353-4193-5326-899b-b7131edd7f72"] :activity/first-step "step-aad3c882-96ee-5b93-a8e5-1fd98a1acdf4" :db/ensure [:activity/validate]} {:db/id "step-aad3c882-96ee-5b93-a8e5-1fd98a1acdf4" :step/id #uuid "aad3c882-96ee-5b93-a8e5-1fd98a1acdf4" :step/content 17592186188661 :step/next "step-0d528e79-53bc-5be0-992d-62a18f4c262f" :db/ensure [:step/validate]} {:db/id "step-0d528e79-53bc-5be0-992d-62a18f4c262f" :step/id #uuid "0d528e79-53bc-5be0-992d-62a18f4c262f" :step/content "question-cb67f6a8-9365-5c2f-8040-e07ca796601e" :step/next "step-3b11e1b9-606d-568a-aff8-39bd701af3dd" :db/ensure [:step/validate]} {:db/id "step-3b11e1b9-606d-568a-aff8-39bd701af3dd" :step/id #uuid "3b11e1b9-606d-568a-aff8-39bd701af3dd" :step/content 17592186188722 :step/next "step-4a39c991-2450-5455-97eb-6d1a8a8ba947" :db/ensure [:step/validate]} {:db/id "step-4a39c991-2450-5455-97eb-6d1a8a8ba947" :step/id #uuid "4a39c991-2450-5455-97eb-6d1a8a8ba947" :step/content "question-fa5bb889-1d66-5ec8-b499-bab2b60bc9f8" :step/next "step-30b66353-4193-5326-899b-b7131edd7f72" :db/ensure [:step/validate]} {:db/id "step-30b66353-4193-5326-899b-b7131edd7f72" :step/id #uuid "30b66353-4193-5326-899b-b7131edd7f72" :step/content "question-da13a004-2a50-58d1-9227-22e3b27eef81" :db/ensure [:step/validate]} {:db/id 17592186096765 :knowledge-point/questions ["question-08b6d6f3-0fab-52e6-98e5-6de56edc9807" "question-423623d2-e3d9-5c6f-a470-2f2a329c961b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-08b6d6f3-0fab-52e6-98e5-6de56edc9807" :question/id #uuid "08b6d6f3-0fab-52e6-98e5-6de56edc9807" :question/math-academy-id "q-50331" :question/problem "![](images/d9/d930c097ed0ddfa454d7f443112c2d9e233e29521e8950fcc4738e742dd3d8dc.png)\n\nThe region enclosed by the curves $x=\\frac{6}{y}$ and $x=7-y$ for $y\\in [1,6]$ is rotated ${360}^{∘}$ about the line $x=-3.$  Which of the following gives the volume of the resulting solid?" :question/worked-solution "Let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/ed/edea788893771f13f3afc7d9f49e8f1dead4e9b589ca78ef160b9bddccf867c5.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{6}{y},$ and\n\n- *leaves* through the outer curve $x=7-y.$\n\nNext, we can find the volume of our solid as a difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=7-y.$\n\n![](images/48/48df22796616a48f9e9ed56474ced12392905e976fdec064b401894f30cbf49b.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{1}^{6}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{6}[\\,(7-y)-(-3)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{6}{[10-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{6}{y}.$\n\n![](images/f3/f3240bb3d94231ae5b786b01b2fe11f9e0ea7971978e54f26a4e36b84af71a28.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{1}^{6}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{6}{[\\,(\\frac{6}{y})-(-3)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{6}{[\\frac{6}{y}+3]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{1}^{6}{[10-y]}^{2}\\,\\text{d}y-\\pi {\\int }_{1}^{6}{[\\frac{6}{y}+3]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{6}({[10-y]}^{2}-{[\\frac{6}{y}+3]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c103ad26-447b-5ac7-aeb2-5c94016982cc"] :db/ensure [:question/validate]} {:db/id "answer-field-c103ad26-447b-5ac7-aeb2-5c94016982cc" :answer-field/id #uuid "c103ad26-447b-5ac7-aeb2-5c94016982cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d032dc32-0433-5a8b-bab4-f8aeb0c6d4dc" :answer-field/choices ["answer-2aa037eb-acb4-59c7-9bc8-b5a91aeab6ac" "answer-73772f39-b6a2-53e5-a227-0d97808f09d2" "answer-d032dc32-0433-5a8b-bab4-f8aeb0c6d4dc" "answer-9c9e7748-eb16-59b5-abdd-e671cdbf6651" "answer-ebffd986-5bc8-51e2-b270-81cdea5769e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-2aa037eb-acb4-59c7-9bc8-b5a91aeab6ac" :answer/id #uuid "2aa037eb-acb4-59c7-9bc8-b5a91aeab6ac" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-6}^{-1}({[10-y]}^{2}-{[\\frac{6}{y}+3]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-73772f39-b6a2-53e5-a227-0d97808f09d2" :answer/id #uuid "73772f39-b6a2-53e5-a227-0d97808f09d2" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{6}({[10-y]}^{2}-{[\\frac{6}{y}+3]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-d032dc32-0433-5a8b-bab4-f8aeb0c6d4dc" :answer/id #uuid "d032dc32-0433-5a8b-bab4-f8aeb0c6d4dc" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{6}({[10-y]}^{2}-{[\\frac{6}{y}+3]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-9c9e7748-eb16-59b5-abdd-e671cdbf6651" :answer/id #uuid "9c9e7748-eb16-59b5-abdd-e671cdbf6651" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{6}({[7-y]}^{2}-{[\\frac{6}{y}]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-ebffd986-5bc8-51e2-b270-81cdea5769e4" :answer/id #uuid "ebffd986-5bc8-51e2-b270-81cdea5769e4" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{6}({[\\frac{6}{y}+3]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-423623d2-e3d9-5c6f-a470-2f2a329c961b" :question/id #uuid "423623d2-e3d9-5c6f-a470-2f2a329c961b" :question/math-academy-id "q-50428" :question/problem "![](images/b5/b5ea4fcb15db81b35a8a6e399cc3df734fc1dd41afe42799b8ca2a39734996cb.png)\n\nThe region enclosed by the curves $x=-\\frac{10}{y}$ and $x=y-7$ for $y\\in [2,5]$ is rotated ${360}^{∘}$ about the line $x=-1.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "Let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/98/987999e84c2b22c8b90ecb0381518e7504d0b792ecebb067a7221653422b3e89.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=-\\frac{10}{y},$ and\n\n- *leaves* through the outer curve $x=y-7.$\n\nNext, we can find the volume of our solid as a difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=y-7.$\n\n![](images/f8/f8c250c5fbf20980050a1e86f4ac5c91bff7b24bfc7ce5394f33c87703139026.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{2}^{5}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{5}[\\,(-1)-(y-7)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{5}{[6-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=-\\frac{10}{y}.$\n\n![](images/64/64b440be918c616eb07f05f7f09cb8e14ed649f677afc5f40f66f47ec34ed87e.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{2}^{5}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{5}{[\\,(-1)-(-\\frac{10}{y})\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{5}{[\\frac{10}{y}-1]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{2}^{5}{[6-y]}^{2}\\,\\text{d}y-\\pi {\\int }_{2}^{5}{[\\frac{10}{y}-1]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{2}^{5}({[6-y]}^{2}-{[\\frac{10}{y}-1]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-44a1a3e4-d370-5a47-b2e6-255c12ad4fca"] :db/ensure [:question/validate]} {:db/id "answer-field-44a1a3e4-d370-5a47-b2e6-255c12ad4fca" :answer-field/id #uuid "44a1a3e4-d370-5a47-b2e6-255c12ad4fca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-637dca43-26dc-54b2-8acd-b44b28e36455" :answer-field/choices ["answer-e5c46529-231a-5bc3-89ad-ebb9317619d2" "answer-2d0c35fb-e6e8-5a53-a69f-4b99e754b3b9" "answer-637dca43-26dc-54b2-8acd-b44b28e36455" "answer-f97511ec-a987-529f-a0fa-f202424d84c5" "answer-66837ddd-4434-54af-8776-16b6edb795ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-e5c46529-231a-5bc3-89ad-ebb9317619d2" :answer/id #uuid "e5c46529-231a-5bc3-89ad-ebb9317619d2" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{5}({[6-y]}^{2}-{[\\frac{10}{y}-1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-2d0c35fb-e6e8-5a53-a69f-4b99e754b3b9" :answer/id #uuid "2d0c35fb-e6e8-5a53-a69f-4b99e754b3b9" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{6}({[6-y]}^{2}-{[\\frac{10}{y}-1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-637dca43-26dc-54b2-8acd-b44b28e36455" :answer/id #uuid "637dca43-26dc-54b2-8acd-b44b28e36455" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{5}({[6-y]}^{2}-{[\\frac{10}{y}-1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-f97511ec-a987-529f-a0fa-f202424d84c5" :answer/id #uuid "f97511ec-a987-529f-a0fa-f202424d84c5" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{5}({[\\frac{10}{y}-1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-66837ddd-4434-54af-8776-16b6edb795ec" :answer/id #uuid "66837ddd-4434-54af-8776-16b6edb795ec" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{5}({[y-7]}^{2}-{[\\frac{10}{y}]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186096729 :knowledge-point/questions ["question-1313560c-b0d0-5277-bf49-6e697b836fd6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1313560c-b0d0-5277-bf49-6e697b836fd6" :question/id #uuid "1313560c-b0d0-5277-bf49-6e697b836fd6" :question/math-academy-id "q-350910" :question/problem "![](images/87/87481d3de1bd3fb02a2fbaa344f120421052335624e8d42b6dd853382b9f764e.png)\n\nThe region above enclosed by the curves $y=\\sqrt{x}$ and $y={x}^{2}$ for $x\\in [0,1]$ is rotated $2\\pi $ radians about the line $y=-1.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/bd/bd558d08aa48a17d04b9c3929a5b49a21e5fd7bde8ebfe4a07f8cabfd824b981.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y={x}^{2},$ and\n\n- *leaves* through the outer curve $y=\\sqrt{x}.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=\\sqrt{x}.$\n\n![](images/b8/b8c8e0216a8ee045a9d7a570bc26d1765fc54e2110b1c1d2fbbc8f59d1ec22ef.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(\\sqrt{x})-(-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[\\sqrt{x}+1]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y={x}^{2}.$\n\n![](images/4c/4cd4e1fb0ad340da9a2e146fa261c6a50e4578f1b77564c8d6a5c6a2f27c81f9.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,({x}^{2})-(-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[{x}^{2}+1]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[\\sqrt{x}+1]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[{x}^{2}+1]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({(\\sqrt{x}+1)}^{2}-{({x}^{2}+1)}^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}(2\\sqrt{x}-{x}^{4}-2{x}^{2}+x)\\,\\,\\text{d}x \\\\  & =\\pi {(\\frac{4}{3}{x}^{3/2}-\\frac{1}{5}{x}^{5}-\\frac{2}{3}{x}^{3}+\\frac{1}{2}{x}^{2})|}_{0}^{1} \\\\  & =\\pi [(\\frac{4}{3}(1)^{3/2}-\\frac{1}{5}(1)^{5}-\\frac{2}{3}(1)^{3}+\\frac{1}{2}(1)^{2})-0] \\\\  & =\\frac{29\\pi }{30}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e6753ef3-ae19-5502-968e-b02e543e893c"] :db/ensure [:question/validate]} {:db/id "answer-field-e6753ef3-ae19-5502-968e-b02e543e893c" :answer-field/id #uuid "e6753ef3-ae19-5502-968e-b02e543e893c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d266feb7-a04f-5c98-9303-8d8350d33397" :answer-field/choices ["answer-d266feb7-a04f-5c98-9303-8d8350d33397"] :db/ensure [:answer-field/validate]} {:db/id "answer-d266feb7-a04f-5c98-9303-8d8350d33397" :answer/id #uuid "d266feb7-a04f-5c98-9303-8d8350d33397" :answer/type :answer.type/math :answer/value "\\frac{29\\pi}{30}" :db/ensure [:answer/validate]} {:db/id 17592186096730 :knowledge-point/questions ["question-f01f287c-3406-5e67-8ee1-f944f0c8187c" "question-6932dce0-68da-5dc2-a092-7a3088f2337d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f01f287c-3406-5e67-8ee1-f944f0c8187c" :question/id #uuid "f01f287c-3406-5e67-8ee1-f944f0c8187c" :question/math-academy-id "q-361835" :question/problem "![](images/35/353b6ad37a77d200719a155e8c14a974f01de00a2e4b4ca3312ce50401a715b7.png)\n\nThe region enclosed by the curves $x={y}^{2}+2$ and $y=x-4$ for $y\\in [-1,2]$ is rotated $2\\pi $ radians about the line $x=-2.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, since we are rotating about a vertical axis, we need to solve the equation of our second curve for $x:$\n\n$$\n\\begin{aligned}y & =x-4\\,⟹\\,x=y+4\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/7e/7e08a30f9ef1f8ce748ba0fcac73f1e93d994e4fd3a3d3d1367568c89c29f4d0.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x={y}^{2}+2,$ and\n\n- *leaves* through the outer curve $x=y+4.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=y+4.$\n\n![](images/26/262546bf3f1d1c9025d23b9fb134c9de7b5299c7b6383563531dffa62244163d.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[\\,(y+4)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[y+6]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x={y}^{2}+2.$\n\n![](images/ce/cefab13ca3d09fcf596e7906384c2efd1718c289783792f1b0ff950632c823ad.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[\\,({y}^{2}+2)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[{y}^{2}+4]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of our solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{2}({[y+6]}^{2}-{[{y}^{2}+4]}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}({y}^{2}+12y+36-({y}^{4}+8{y}^{2}+16))\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}(12y+20-{y}^{4}-7{y}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {(6{y}^{2}+20y-\\frac{{y}^{5}}{5}-\\frac{7{y}^{3}}{3})|}_{-1}^{2} \\\\  & =\\pi [\\,(6\\cdot {2}^{2}+20\\cdot 2-\\frac{{2}^{5}}{5}-\\frac{7\\cdot {2}^{3}}{3})\\,-\\,(6-20+\\frac{1}{5}+\\frac{7}{3})\\,] \\\\  & =\\pi (\\frac{584}{15}-(-\\frac{172}{15})) \\\\  & =\\frac{252\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0ca58cc0-f38a-5004-9064-b0da06a85013"] :db/ensure [:question/validate]} {:db/id "answer-field-0ca58cc0-f38a-5004-9064-b0da06a85013" :answer-field/id #uuid "0ca58cc0-f38a-5004-9064-b0da06a85013" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-193ea9e3-bd8d-542f-b149-f78e0b396574" :answer-field/choices ["answer-193ea9e3-bd8d-542f-b149-f78e0b396574"] :db/ensure [:answer-field/validate]} {:db/id "answer-193ea9e3-bd8d-542f-b149-f78e0b396574" :answer/id #uuid "193ea9e3-bd8d-542f-b149-f78e0b396574" :answer/type :answer.type/math :answer/value "\\frac{252\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "question-6932dce0-68da-5dc2-a092-7a3088f2337d" :question/id #uuid "6932dce0-68da-5dc2-a092-7a3088f2337d" :question/math-academy-id "q-361838" :question/problem "![](images/ce/ce9f6280200d6f71fc13b4dba705c26341ddf11d369b547e05c8647c0e1c3e8e.png)\n\nThe region enclosed by the curves $x={y}^{2}-2$ and $x=y$ is rotated $2\\pi $ radians about the line $x=3.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, to determine the limits of integration, we find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{y}^{2}-2 & =y \\\\ {y}^{2}-y-2 & =0 \\\\ (y-2)(y+1) & =0 \\\\ y & =-1,2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=-1$ to $y=2.$\n\nNext, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/74/74e298b85aa9e300d303fa34c761d5ffad214110e315ccf18c33edd2283210ad.png)\n\nThe horizontal arrow\n\n- *enters* the region through the inner curve $x=y,$ and\n\n- *leaves* through the outer curve $x={y}^{2}-2.$\n\nNext, we can find the volume of our solid as a difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x={y}^{2}-2.$\n\n![](images/94/945dfc9ade4dc95a336f6c0111ea50496242ca60dfddff61f85961547c0c7d3e.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[\\,(3)-({y}^{2}-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[5-{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=y.$\n\n![](images/9e/9e25b8fd45f666927edbfec7d9ccd714d14037784f86fb9a8493bf861d521ff9.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[\\,(3)-(y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}{[3-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{2}({[5-{y}^{2}]}^{2}-{[3-y]}^{2})\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}((25-10{y}^{2}+{y}^{4})-(9-6y+{y}^{2}))\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{2}({y}^{4}-11{y}^{2}+6y+16)\\,\\text{d}y \\\\  & =\\pi {(\\frac{{y}^{5}}{5}-\\frac{11{y}^{3}}{3}+3{y}^{2}+16y)|}_{-1}^{2} \\\\  & =\\pi [(\\frac{{2}^{5}}{5}-\\frac{11({2}^{3})}{3}+3({2}^{2})+16(2))-(-\\frac{1}{5}+\\frac{11}{3}+3-16)] \\\\  & =\\pi [\\frac{316}{15}-(-\\frac{143}{15})] \\\\  & =\\frac{153\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c6b62faf-4750-56ae-8c93-f35beee1fd2d"] :db/ensure [:question/validate]} {:db/id "answer-field-c6b62faf-4750-56ae-8c93-f35beee1fd2d" :answer-field/id #uuid "c6b62faf-4750-56ae-8c93-f35beee1fd2d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-107da7cc-1b85-5247-b8b7-0e025ec0a5af" :answer-field/choices ["answer-107da7cc-1b85-5247-b8b7-0e025ec0a5af"] :db/ensure [:answer-field/validate]} {:db/id "answer-107da7cc-1b85-5247-b8b7-0e025ec0a5af" :answer/id #uuid "107da7cc-1b85-5247-b8b7-0e025ec0a5af" :answer/type :answer.type/math :answer/value "\\frac{153\\pi}{5}" :db/ensure [:answer/validate]} {:db/id "activity-43c709a2-005f-55fb-9b67-4db81bb9fadf" :activity/id #uuid "43c709a2-005f-55fb-9b67-4db81bb9fadf" :activity/title "Volumes of Revolution Using the Washer Method: Rotation About Other Axes" :activity/type :activity.type/review :activity/scope 17592186049885 :activity/course 17592186046645 :activity/steps ["step-4571ed8d-5215-550d-9af8-82bcd85576c7" "step-51e6f5a0-33a0-5933-a201-79b857fc27c2" "step-09990606-8461-5b73-b77b-371381bbc6e3" "step-44438865-e406-5603-858e-c1b84ef5f87e" "step-e492624e-2375-5b7b-b58f-3032d0f7b274"] :activity/first-step "step-4571ed8d-5215-550d-9af8-82bcd85576c7" :db/ensure [:activity/validate]} {:db/id "step-4571ed8d-5215-550d-9af8-82bcd85576c7" :step/id #uuid "4571ed8d-5215-550d-9af8-82bcd85576c7" :step/content "question-08b6d6f3-0fab-52e6-98e5-6de56edc9807" :step/next "step-51e6f5a0-33a0-5933-a201-79b857fc27c2" :db/ensure [:step/validate]} {:db/id "step-51e6f5a0-33a0-5933-a201-79b857fc27c2" :step/id #uuid "51e6f5a0-33a0-5933-a201-79b857fc27c2" :step/content "question-423623d2-e3d9-5c6f-a470-2f2a329c961b" :step/next "step-09990606-8461-5b73-b77b-371381bbc6e3" :db/ensure [:step/validate]} {:db/id "step-09990606-8461-5b73-b77b-371381bbc6e3" :step/id #uuid "09990606-8461-5b73-b77b-371381bbc6e3" :step/content "question-1313560c-b0d0-5277-bf49-6e697b836fd6" :step/next "step-44438865-e406-5603-858e-c1b84ef5f87e" :db/ensure [:step/validate]} {:db/id "step-44438865-e406-5603-858e-c1b84ef5f87e" :step/id #uuid "44438865-e406-5603-858e-c1b84ef5f87e" :step/content "question-f01f287c-3406-5e67-8ee1-f944f0c8187c" :step/next "step-e492624e-2375-5b7b-b58f-3032d0f7b274" :db/ensure [:step/validate]} {:db/id "step-e492624e-2375-5b7b-b58f-3032d0f7b274" :step/id #uuid "e492624e-2375-5b7b-b58f-3032d0f7b274" :step/content "question-6932dce0-68da-5dc2-a092-7a3088f2337d" :db/ensure [:step/validate]}]
