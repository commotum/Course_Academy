\\frac{1}{|x|\\sqrt{1+{x}^{2}}}\\,\\text{d}x=-\\frac{5}{2}\\operatorname{arcsch}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165309 :answer-field/correct "answer-afb20b57-0fa3-5940-b9b0-92d1a6133e1e" :answer-field/choices ["answer-b5d3a9d3-ddd9-577f-9c86-cd738f45c520" "answer-afb20b57-0fa3-5940-b9b0-92d1a6133e1e" "answer-627738ce-ed4c-5741-ba8a-69febe68ce1a" "answer-356280f1-a662-5ade-92a2-1f3d0ab94b36" "answer-d2e23e70-4232-5a2c-a0a4-f7fc04086c68"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5d3a9d3-ddd9-577f-9c86-cd738f45c520" :answer/id #uuid "b5d3a9d3-ddd9-577f-9c86-cd738f45c520" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-afb20b57-0fa3-5940-b9b0-92d1a6133e1e" :answer/id #uuid "afb20b57-0fa3-5940-b9b0-92d1a6133e1e" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}\\operatorname{arcsch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-627738ce-ed4c-5741-ba8a-69febe68ce1a" :answer/id #uuid "627738ce-ed4c-5741-ba8a-69febe68ce1a" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}\\operatorname{arsech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-356280f1-a662-5ade-92a2-1f3d0ab94b36" :answer/id #uuid "356280f1-a662-5ade-92a2-1f3d0ab94b36" :answer/type :answer.type/math :answer/value "5\\operatorname{arcsch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-d2e23e70-4232-5a2c-a0a4-f7fc04086c68" :answer/id #uuid "d2e23e70-4232-5a2c-a0a4-f7fc04086c68" :answer/type :answer.type/math :answer/value "\\frac{5}{2}\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186166770 :knowledge-point/questions ["question-9e72ef97-134f-5189-9831-10898a377ff9" "question-e33d9b0e-9690-51ed-af7a-d4f6f37918b5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9e72ef97-134f-5189-9831-10898a377ff9" :question/id #uuid "9e72ef97-134f-5189-9831-10898a377ff9" :question/math-academy-id "q-95825" :question/problem "$\\int \\frac{x+1}{x\\sqrt{1-{x}^{2}}}\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{x+1}{x\\sqrt{1-{x}^{2}}}\\text{d}x & =\\int (1+\\frac{1}{x})\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x-\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\operatorname{arcsin}⁡x-\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bfc97997-ca98-512f-9c81-7c22edd719fa"] :db/ensure [:question/validate]} {:db/id "answer-field-bfc97997-ca98-512f-9c81-7c22edd719fa" :answer-field/id #uuid "bfc97997-ca98-512f-9c81-7c22edd719fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1fd1ab49-aa4c-5774-9026-e6c1cff76e48" :answer-field/choices ["answer-b263c8ee-1799-53f4-ad45-e74016e53ace" "answer-b63a8c32-ba1f-50c5-b426-aedd68118f76" "answer-c785053c-82a9-5d86-a046-ee1e615e2597" "answer-78571539-c66a-5e8c-a578-1abbd8f92686" "answer-1fd1ab49-aa4c-5774-9026-e6c1cff76e48"] :db/ensure [:answer-field/validate]} {:db/id "answer-b263c8ee-1799-53f4-ad45-e74016e53ace" :answer/id #uuid "b263c8ee-1799-53f4-ad45-e74016e53ace" :answer/type :answer.type/math :answer/value "\\operatorname{arccos}⁡x+\\operatorname{arcsch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-b63a8c32-ba1f-50c5-b426-aedd68118f76" :answer/id #uuid "b63a8c32-ba1f-50c5-b426-aedd68118f76" :answer/type :answer.type/math :answer/value "\\operatorname{arccos}⁡x-\\operatorname{arsech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-c785053c-82a9-5d86-a046-ee1e615e2597" :answer/id #uuid "c785053c-82a9-5d86-a046-ee1e615e2597" :answer/type :answer.type/math :answer/value "\\operatorname{arcsin}⁡x+\\operatorname{arsech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-78571539-c66a-5e8c-a578-1abbd8f92686" :answer/id #uuid "78571539-c66a-5e8c-a578-1abbd8f92686" :answer/type :answer.type/math :answer/value "\\operatorname{arcsin}⁡x-\\operatorname{arcsch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-1fd1ab49-aa4c-5774-9026-e6c1cff76e48" :answer/id #uuid "1fd1ab49-aa4c-5774-9026-e6c1cff76e48" :answer/type :answer.type/math :answer/value "\\operatorname{arcsin}⁡x-\\operatorname{arsech}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186166771 :knowledge-point/questions ["question-f9b5554f-bf8f-5e35-84b6-08592dbf3242" "question-225dd078-68de-5937-93c7-1f0e29e25a34"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f9b5554f-bf8f-5e35-84b6-08592dbf3242" :question/id #uuid "f9b5554f-bf8f-5e35-84b6-08592dbf3242" :question/math-academy-id "q-95835" :question/problem "$$\n\nCalculate $\\int \\frac{2{x}^{3}-2x-1}{{x}^{2}-1}\\,\\text{d}x$ for $|x|>1.$" :question/worked-solution "$$\nThe formula for the derivative of the inverse hyperbolic cotangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcoth}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{2{x}^{3}-2x-1}{{x}^{2}-1}\\,\\text{d}x & =\\int (\\frac{2{x}^{3}-2x}{{x}^{2}-1}-\\frac{1}{{x}^{2}-1})\\text{d}x \\\\  & =\\int \\frac{2{x}^{3}-2x}{{x}^{2}-1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}-1}\\,\\text{d}x \\\\  & =\\int \\frac{2x({x}^{2}-1)}{{x}^{2}-1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}-1}\\,\\text{d}x \\\\  & =\\int 2x\\,\\text{d}x+\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x \\\\  & ={x}^{2}+\\operatorname{arcoth}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b96b62fd-4b23-57ed-92a3-5d0b1b40fd84"] :db/ensure [:question/validate]} {:db/id "answer-field-b96b62fd-4b23-57ed-92a3-5d0b1b40fd84" :answer-field/id #uuid "b96b62fd-4b23-57ed-92a3-5d0b1b40fd84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-945fffd1-e229-5466-ad6d-89a0625a4263" :answer-field/choices ["answer-f7c49693-2849-57c9-907f-41a95bff16a3" "answer-d86d1b04-c15b-51a1-be07-0f1a45f08e45" "answer-e5812492-742c-5d48-bb3f-3dfba19457aa" "answer-945fffd1-e229-5466-ad6d-89a0625a4263" "answer-0e48fa1f-d8dd-53b3-9f18-8e67d042f50b"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7c49693-2849-57c9-907f-41a95bff16a3" :answer/id #uuid "f7c49693-2849-57c9-907f-41a95bff16a3" :answer/type :answer.type/math :answer/value "2x-\\operatorname{artanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-d86d1b04-c15b-51a1-be07-0f1a45f08e45" :answer/id #uuid "d86d1b04-c15b-51a1-be07-0f1a45f08e45" :answer/type :answer.type/math :answer/value "2{x}^{2}+\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-e5812492-742c-5d48-bb3f-3dfba19457aa" :answer/id #uuid "e5812492-742c-5d48-bb3f-3dfba19457aa" :answer/type :answer.type/math :answer/value "x-\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-945fffd1-e229-5466-ad6d-89a0625a4263" :answer/id #uuid "945fffd1-e229-5466-ad6d-89a0625a4263" :answer/type :answer.type/math :answer/value "{x}^{2}+\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-0e48fa1f-d8dd-53b3-9f18-8e67d042f50b" :answer/id #uuid "0e48fa1f-d8dd-53b3-9f18-8e67d042f50b" :answer/type :answer.type/math :answer/value "{x}^{2}-\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "question-e33d9b0e-9690-51ed-af7a-d4f6f37918b5" :question/id #uuid "e33d9b0e-9690-51ed-af7a-d4f6f37918b5" :question/math-academy-id "q-162688" :question/problem "$\\int -\\frac{1}{\\sqrt{2}x\\sqrt{2-2{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic secant function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsech}⁡x)=-\\frac{1}{x\\sqrt{1-{x}^{2}}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{2}x\\sqrt{2-2{x}^{2}}}\\,\\text{d}x & =\\int -\\frac{1}{\\sqrt{2}x\\sqrt{2(1-{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}\\cdot \\sqrt{2}}\\int -\\frac{1}{x\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{arsech}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1cb24d5d-ea5b-5830-8dbf-c2d38ff023f3"] :db/ensure [:question/validate]} {:db/id "answer-field-1cb24d5d-ea5b-5830-8dbf-c2d38ff023f3" :answer-field/id #uuid "1cb24d5d-ea5b-5830-8dbf-c2d38ff023f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-255ef39c-08f3-5d31-9a16-3e46f0627a86" :answer-field/choices ["answer-9edda277-9ea0-5686-b09b-8b22517fc32f" "answer-d3afc86a-72f4-5a60-904a-4ef6e5aba49e" "answer-64fc9627-8651-50b3-8129-352614e060b9" "answer-255ef39c-08f3-5d31-9a16-3e46f0627a86" "answer-2740976a-b1b4-511e-b9de-d3280d132dd3"] :db/ensure [:answer-field/validate]} {:db/id "answer-9edda277-9ea0-5686-b09b-8b22517fc32f" :answer/id #uuid "9edda277-9ea0-5686-b09b-8b22517fc32f" :answer/type :answer.type/math :answer/value "-2\\operatorname{arsech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-d3afc86a-72f4-5a60-904a-4ef6e5aba49e" :answer/id #uuid "d3afc86a-72f4-5a60-904a-4ef6e5aba49e" :answer/type :answer.type/math :answer/value "-\\frac{1}{\\sqrt{2}}\\operatorname{arcsch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-64fc9627-8651-50b3-8129-352614e060b9" :answer/id #uuid "64fc9627-8651-50b3-8129-352614e060b9" :answer/type :answer.type/math :answer/value "2\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-255ef39c-08f3-5d31-9a16-3e46f0627a86" :answer/id #uuid "255ef39c-08f3-5d31-9a16-3e46f0627a86" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arsech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-2740976a-b1b4-511e-b9de-d3280d132dd3" :answer/id #uuid "2