=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sinh}⁡(3t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186308736 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=y(t)+1 \\\\ {y}^{′}(t)=x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(t) & \\operatorname{sinh}⁡(t) \\\\ \\operatorname{sinh}⁡(t) & \\operatorname{cosh}⁡(t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{cosh}⁡(t)-1$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186308005 :answer-field/correct 17592186306066 :db/ensure [:answer-field/validate]} {:db/id 17592186229661 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2y(t) \\\\ {y}^{′}(t)=-2x(t)+1,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$3\\operatorname{sin}⁡(2t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186307686 :answer-field/correct "answer-ba6921c8-3a4c-5512-a27f-32ceedf7733d" :answer-field/choices ["answer-ba6921c8-3a4c-5512-a27f-32ceedf7733d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba6921c8-3a4c-5512-a27f-32ceedf7733d" :answer/id #uuid "ba6921c8-3a4c-5512-a27f-32ceedf7733d" :answer/type :answer.type/math :answer/value "1-3\\cos(2t)" :db/ensure [:answer/validate]} {:db/id 17592186396729 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=7y(t) \\\\ {y}^{′}(t)=7x(t)+7,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(7t) & \\operatorname{sinh}⁡(7t) \\\\ \\operatorname{sinh}⁡(7t) & \\operatorname{cosh}⁡(7t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 7 \\\\ 7 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sinh}⁡(7t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186308724 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=5x(t)+y(t)+1 \\\\ {y}^{′}(t)=5y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{5t} & t{e}^{5t} \\\\ 0 & {e}^{5t}\\end{aligned}],$ where $A=[\\begin{aligned}5 & 1 \\\\ 0 & 5\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\frac{1}{5}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186307659 :answer-field/correct "answer-06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer-field/choices ["answer-06fe7ba9-e60a-5a45-b758-fa0196ee521e"] :db/ensure [:answer-field/validate]} {:db/id "answer-06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer/id #uuid "06fe7ba9-e60a-5a45-b758-fa0196ee521e" :answer/type :answer.type/math :answer/value "e^{5t}-1" :db/ensure [:answer/validate]} {:db/id 17592186310976 :answer-field/correct 17592186310630 :db/ensure [:answer-field/validate]} {:db/id 17592186311181 :answer-field/correct 17592186308781 :db/ensure [:answer-field/validate]} {:db/id 17592186310930 :answer-field/correct 17592186309299 :db/ensure [:answer-field/validate]} {:db/id 17592186311107 :answer-field/correct 17592186310135 :db/ensure [:answer-field/validate]} {:db/id 17592186310906 :answer-field/correct 17592186310259 :db/ensure [:answer-field/validate]} {:db/id "question-87681964-b1bd-5510-b05d-db92c8b0be06" :question/id #uuid "87681964-b1bd-5510-b05d-db92c8b0be06" :question/math-academy-id "q-335431" :question/problem "Consider the inhomogeneous system  ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below.\n\n$\\text{L1}:\\,$ Let $y(t)={e}^{-A(t-{t}_{0})}x(t)$  \n\n$\\text{L2}:\\,$ ${y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)$  \n\n$\\text{L3}:\\,$ ${y}^{′}(t)={e}^{-A(t-{t}_{0})}g(t)$  \n\n$\\text{L4}:\\,$ $y(t)-y({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$\n\n$\\text{L5}:\\,$ $y({t}_{0})=x({t}_{0})$ \n\n$\\text{L6}:\\,$ $y(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$  \n\n$\\text{L7}:\\,$ ${e}^{A(t-{t}_{0})}y(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\n$\\text{L8}:\\,$ ${e}^{A(t-{t}_{0})}y(t)=x(t)$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by  \n{{field-2}}.\n\n$\\,$ Line $\\text{L9}$ follows from line $\\text{L7}$ by  \n{{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Differentiating $y(t)={e}^{-A(t-{t}_{0})}x(t)$ and applying the product rule gives\n\n$$\n\\begin{aligned}{y}^{′}(t) & =({e}^{-A(t-{t}_{0})})^{′}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t) \\\\  & =(-A){e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t) \\\\  & =-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t).\\end{aligned}\n$$\n\nThus, $\\text{L2}$ follows from $\\text{L1}$ by $\\text{differentiating and using the product rule}.$\n\n- Next, we consider lines $\\text{L6}$ and $\\text{L7}.$ Multiplying both sides of\n\n$$\ny(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s\n$$\n\nfrom $\\text{L6}$ by ${e}^{A(t-{t}_{0})}$ gives\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}y(t) & ={e}^{A(t-{t}_{0})}x({t}_{0})+{e}^{A(t-{t}_{0})}{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s \\\\  & ={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s.\\end{aligned}\n$$\n\nTherefore, $\\text{L7}$ follows from $\\text{L6}$ by $\\text{multiplying both sides by }{e}^{A(t-{t}_{0})}.$\n\n- Finally, we consider lines $\\text{L7}$, $\\text{L8}$, and $\\text{L9}.$ From $\\text{L8}$ we know that\n\n$$\n{e}^{A(t-{t}_{0})}y(t)=x(t).\n$$\n\nSubstituting ${e}^{A(t-{t}_{0})}y(t)=x(t)$ into\n\n$$\n{e}^{A(t-{t}_{0})}y(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s\n$$\n\nfrom $\\text{L7}$ gives\n\n$$\nx(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s.\n$$\n\nTherefore, $\\text{L9}$ follows from $\\text{L7}$ by $\\text{substituting }{e}^{A(t-{t}_{0})}y(t)=x(t).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e0d35370-7864-50f8-9df1-556774fcf4eb" "answer-field-99e629b7-39a5-51b6-b459-757a403eb36a" "answer-field-c2386d4b-3d22-5cfa-bad2-0a9fcf385ddb"] :db/ensure [:question/validate]} {:db/id "answer-field-e0d35370-7864-50f8-9df1-556774fcf4eb" :answer-field/id #uuid "e0d35370-7864-50f8-9df1-556774fcf4eb" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-bacf772b-cf09-517d-b411-c2134e7ca39e" :answer-field/choices ["answer-c97c6311-7ff9-5fbf-a138-a9f950165a53" "answer-bacf772b-cf09-517d-b411-c2134e7ca39e" "answer-84da5009-d69f-591d-a768-f1d70476d3d1" "answer-a3398ce2-e079-5944-96c7-f41a322d62e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-c97c6311-7ff9-5fbf-a138-a9f950165a53" :answer/id #uuid "c97c6311-7ff9-5fbf-a138-a9f950165a53" :answer/type :answer.type/text :answer/value "applying a change of variables" :db/ensure [:answer/validate]} {:db/id "answer-bacf772b-cf09-517d-b411-c2134e7ca39e" :answer/id #uuid "bacf772b-cf09-517d-b411-c2134e7ca39e" :answer/type :answer.type/text :answer/value "differentiating and using the product rule" :db/ensure [:answer/validate]} {:db/id "answer-84da5009-d69f-591d-a768-f1d70476d3d1" :answer/id #uuid "84da5009-d69f-591d-a768-f1d70476d3d1" :answer/type :answer.type/text :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)$" :db/ensure [:answer/validate]} {:db/id "answer-a3398ce2-e079-5944-96c7-f41a322d62e2" :answer/id #uuid "a3398ce2-e079-5944-96c7-f41a322d62e2" :answer/type :answer.type/text :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)+{t}_{0}$" :db/ensure [:answer/validate]} {:db/id "answer-field-99e629b7-39a5-51b6-b459-757a403eb36a" :answer-field/id #uuid "99e629b7-39a5-51b6-b459-757a403eb36a" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-a54c25f2-ec7a-5f45-8333-64894e9c36b8" :answer-field/choices ["answer-fdcdd330-e92b-53ae-8aeb-507434e360ba" "answer-e6ee81f1-cc2e-5a93-bc97-94e6da94d3da" "answer-fe0eff0a-240e-5a8f-b8f7-fcab48d77834" "answer-a54c25f2-ec7a-5f45-8333-64894e9c36b8"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdcdd330-e92b-53ae-8aeb-507434e360ba" :answer/id #uuid "fdcdd330-e92b-53ae-8aeb-507434e360ba" :answer/type :answer.type/text :answer/value "evaluating at $t={t}_{0}$" :db/ensure [:answer/validate]} {:db/id "answer-e6ee81f1-cc2e-5a93-bc97-94e6da94d3da" :answer/id #uuid "e6ee81f1-cc2e-5a93-bc97-94e6da94d3da" :answer/type :answer.type/text :answer/value "integrating both sides" :db/ensure [:answer/validate]} {:db/id "answer-fe0eff0a-240e-5a8f-b8f7-fcab48d77834" :answer/id #uuid "fe0eff0a-240e-5a8f-b8f7-fcab48d77834" :answer/type :answer.type/text :answer/value "multiplying both sides by ${e}^{A(t+{t}_{0})}$" :db/ensure [:answer/validate]} {:db/id "answer-a54c25f2-ec7a-5f45-8333-64894e9c36b8" :answer/id #uuid "a54c25f2-ec7a-5f45-8333-64894e9c36b8" :answer/type :answer.type/text :answer/value "multiplying both sides by ${e}^{A(t-{t}_{0})}$" :db/ensure [:answer/validate]} {:db/id "answer-field-c2386d4b-3d22-5cfa-bad2-0a9fcf385ddb" :answer-field/id #uuid "c2386d4b-3d22-5cfa-bad2-0a9fcf385ddb" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-00fc88d9-c967-5bb7-b451-454260604f2c" :answer-field/choices ["answer-be6bd4f1-120c-5ac9-a950-ea25545bcc99" "answer-2039df82-473f-56ad-9c29-29e56eabeb40" "answer-a97267af-ad5a-5f52-b176-36b08839336a" "answer-00fc88d9-c967-5bb7-b451-454260604f2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-be6bd4f1-120c-5ac9-a950-ea25545bcc99" :answer/id #uuid "be6bd4f1-120c-5ac9-a950-ea25545bcc99" :answer/type :answer.type/text :answer/value "evaluating at $t={t}_{0}$" :db/ensure [:answer/validate]} {:db/id "answer-2039df82-473f-56ad-9c29-29e56eabeb40" :answer/id #uuid "2039df82-473f-56ad-9c29-29e56eabeb40" :answer/type :answer.type/text :answer/value "multiplying both sides by ${e}^{A(t-{t}_{0})}$" :db/ensure [:answer/validate]} {:db/id "answer-a97267af-ad5a-5f52-b176-36b08839336a" :answer/id #uuid "a97267af-ad5a-5f52-b176-36b08839336a" :answer/type :answer.type/text :answer/value "substituting ${e}^{A(t+{t}_{0})}y(t)=x(t)$" :db/ensure [:answer/validate]} {:db/id "answer-00fc88d9-c967-5bb7-b451-454260604f2c" :answer/id #uuid "00fc88d9-c967-5bb7-b451-454260604f2c" :answer/type :answer.type/text :answer/value "substituting ${e}^{A(t-{t}_{0})}y(t)=x(t)$" :db/ensure [:answer/validate]} {:db/id 17592186307690 :answer-field/correct 17592186306844 :db/ensure [:answer-field/validate]} {:db/id 17592186307541 :answer-field/correct 17592186307235 :db/ensure [:answer-field/validate]} [:db/retract 17592186102530 :answer-field/choices 17592186102531] [:db/retract 17592186102530 :answer-field/choices 17592186102532] [:db/retract 17592186102530 :answer-field/choices 17592186102533] [:db/retract 17592186102530 :answer-field/choices 17592186102534] [:db/retract 17592186102530 :answer-field/choices 17592186102535] {:db/id 17592186105730 :knowledge-point/questions ["question-4a507c40-e9a1-5cff-8a8b-72e01c23590f" "question-0ffc2b95-6d99-59f1-9d71-68fe0c7010aa"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4a507c40-e9a1-5cff-8a8b-72e01c23590f" :question/id #uuid "4a507c40-e9a1-5cff-8a8b-72e01c23590f" :question/math-academy-id "q-69909" :question/problem "Find the angle between $a=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}].$" :question/worked-solution "Rearranging the dot product formula, we have: \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 0+1\\cdot (-1)+0\\cdot 1}{\\sqrt{{1}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{0}^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{2}\\cdot \\sqrt{2}} \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{1}{2})={120}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e2059258-9233-559a-842c-f610002a589b"] :db/ensure [:question/validate]} {:db/id "answer-field-e2059258-9233-559a-842c-f610002a589b" :answer-field/id #uuid "e2059258-9233-559a-842c-f610002a589b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-02cb6fee-ce7d-560e-8ed7-f39aa200d67d" :answer-field/choices ["answer-02cb6fee-ce7d-560e-8ed7-f39aa200d67d" "answer-1c69ef4d-faaf-5822-b026-b326887faa8f" "answer-52500d10-896d-510b-8140-363810b9ef46" "answer-ebf08a51-4f87-56eb-a1bf-608bbb2ea4f6" "answer-e01fccff-bbff-54ab-98f2-ea5e909b0798"] :db/ensure [:answer-field/validate]} {:db/id "answer-02cb6fee-ce7d-560e-8ed7-f39aa200d67d" :answer/id #uuid "02cb6fee-ce7d-560e-8ed7-f39aa200d67d" :answer/type :answer.type/math :answer/value "{120}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-1c69ef4d-faaf-5822-b026-b326887faa8f" :answer/id #uuid "1c69ef4d-faaf-5822-b026-b326887faa8f" :answer/type :answer.type/math :answer/value "{135}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-52500d10-896d-510b-8140-363810b9ef46" :answer/id #uuid "52500d10-896d-510b-8140-363810b9ef46" :answer/type :answer.type/math :answer/value "{150}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-ebf08a51-4f87-56eb-a1bf-608bbb2ea4f6" :answer/id #uuid "ebf08a51-4f87-56eb-a1bf-608bbb2ea4f6" :answer/type :answer.type/math :answer/value "{180}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-e01fccff-bbff-54ab-98f2-ea5e909b0798" :answer/id #uuid "e01fccff-bbff-54ab-98f2-ea5e909b0798" :answer/type :answer.type/math :answer/value "{90}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-0ffc2b95-6d99-59f1-9d71-68fe0c7010aa" :question/id #uuid "0ffc2b95-6d99-59f1-9d71-68fe0c7010aa" :question/math-academy-id "q-18321" :question/problem "Find the angle between $a=⟨1,-1,0⟩$ and $b=⟨0,1,-2⟩.$ Round your answer to $1$ decimal place." :question/worked-solution "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 0+(-1)\\cdot 1+0\\cdot (-2)}{\\sqrt{{1}^{2}+(-1)^{2}+{0}^{2}}\\sqrt{{0}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{-1}{\\sqrt{2}\\cdot \\sqrt{5}} \\\\  & =-\\frac{1}{\\sqrt{10}}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{1}{\\sqrt{10}})≈{108.4}^{∘}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30fc2b81-3bdf-59c5-9db1-77618c2dc14a"] :db/ensure [:question/validate]} {:db/id "answer-field-30fc2b81-3bdf-59c5-9db1-77618c2dc14a" :answer-field/id #uuid "30fc2b81-3bdf-59c5-9db1-77618c2dc14a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-40b810eb-accf-5a4e-97d9-c8605d6d85e4" :answer-field/choices ["answer-cd55f423-f72d-545f-ae08-9223b18ea389" "answer-40b810eb-accf-5a4e-97d9-c8605d6d85e4" "answer-159fd380-dce4-518a-a6d3-698ca5bb3eba" "answer-e31d771e-69db-5724-9462-443d78f7ca71" "answer-a6d164bc-18d8-5190-a58a-7a02287b7760"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd55f423-f72d-545f-ae08-9223b18ea389" :answer/id #uuid "cd55f423-f72d-545f-ae08-9223b18ea389" :answer/type :answer.type/math :answer/value "-{114.4}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-40b810eb-accf-5a4e-97d9-c8605d6d85e4" :answer/id #uuid "40b810eb-accf-5a4e-97d9-c8605d6d85e4" :answer/type :answer.type/math :answer/value "{108.4}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-159fd380-dce4-518a-a6d3-698ca5bb3eba" :answer/id #uuid "159fd380-dce4-518a-a6d3-698ca5bb3eba" :answer/type :answer.type/math :answer/value "{12.5}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-e31d771e-69db-5724-9462-443d78f7ca71" :answer/id #uuid "e31d771e-69db-5724-9462-443d78f7ca71" :answer/type :answer.type/math :answer/value "{46.9}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a6d164bc-18d8-5190-a58a-7a02287b7760" :answer/id #uuid "a6d164bc-18d8-5190-a58a-7a02287b7760" :answer/type :answer.type/math :answer/value "{61.3}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186106109 :question/problem "Consider the points $A(t,2,1)$, $B(2t,3,1)$ and $C(2,{t}^{2},-1).$ Find $∠BAC$ given that $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2.$ Round your answer to $2$ decimal places." :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨t,\\,2,\\,1⟩,\\,b=⟨2t,\\,3,\\,1⟩,\\,c=⟨2,\\,{t}^{2},\\,-1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](images/28/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨2t,\\,3,\\,1⟩-⟨t,\\,2,\\,1⟩ \\\\  & =⟨t,\\,1,\\,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨2,\\,{t}^{2},\\,-1⟩-⟨t,\\,2,\\,1⟩ \\\\  & =⟨2-t,\\,{t}^{2}-2,\\,-2⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =2 \\\\ t\\cdot (2-t)+1\\cdot ({t}^{2}-2)+0\\cdot (-2) & =2 \\\\ 2t-{t}^{2}+{t}^{2}-2+0 & =2 \\\\ 2t-2 & =2 \\\\ 2t & =4 \\\\ t & =2\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,1,0⟩, \\\\ \\overset{\\to }{AC} & =⟨2-2,\\,{2}^{2}-2,\\,-2⟩ \\\\  & =⟨0,2,-2⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2}{\\sqrt{{2}^{2}+{1}^{2}+{0}^{2}}\\sqrt{{0}^{2}+{2}^{2}+(-2)^{2}}} \\\\  & =\\frac{2}{\\sqrt{5}\\cdot \\sqrt{8}} \\\\  & =\\frac{2}{2\\sqrt{10}} \\\\  & =\\frac{1}{\\sqrt{10}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{10}})≈{71.57}^{∘}.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186102530 :answer-field/correct "answer-658fb7cc-1f50-5aa6-b7c7-ebf465725a6e" :answer-field/choices ["answer-f94a9a14-2446-5ad2-a0a9-1e0bdc5cf916" "answer-0062f752-bd13-50a8-bb70-b3e95306d293" "answer-c74b2731-625c-5686-9738-6b4cb96f3c7f" "answer-658fb7cc-1f50-5aa6-b7c7-ebf465725a6e" "answer-73751b94-0fcf-518d-b94d-26000db59887"] :db/ensure [:answer-field/validate]} {:db/id "answer-f94a9a14-2446-5ad2-a0a9-1e0bdc5cf916" :answer/id #uuid "f94a9a14-2446-5ad2-a0a9-1e0bdc5cf916" :answer/type :answer.type/math :answer/value "{105.61}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-0062f752-bd13-50a8-bb70-b3e95306d293" :answer/id #uuid "0062f752-bd13-50a8-bb70-b3e95306d293" :answer/type :answer.type/math :answer/value "{48.72}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c74b2731-625c-5686-9738-6b4cb96f3c7f" :answer/id #uuid "c74b2731-625c-5686-9738-6b4cb96f3c7f" :answer/type :answer.type/math :answer/value "{63.28}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-658fb7cc-1f50-5aa6-b7c7-ebf465725a6e" :answer/id #uuid "658fb7cc-1f50-5aa6-b7c7-ebf465725a6e" :answer/type :answer.type/math :answer/value "{71.57}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-73751b94-0fcf-518d-b94d-26000db59887" :answer/id #uuid "73751b94-0fcf-518d-b94d-26000db59887" :answer/type :answer.type/math :answer/value "{78.37}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186107072 :tutorial/content "Consider the two vectors $\\mathbf{a}=\\langle 1,-2, 2 \\rangle$ and $\\mathbf{b}=\\langle 3,0,-1 \\rangle$ shown in the picture below.\n\n![](images/87/87395f5fe6657cec5dd98eed9c3c535a5f6dc9f259d4558c86a4d618c904e5c1.png)\n\nTo find the angle $\\theta$ between the vectors, we can rearrange the dot product formula:\n\n$$\n\\begin{aligned}a\\cdot b & =|\\,a\\,|\\cdot |\\,b\\,|\\cdot \\operatorname{cos}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\ \\theta  & =\\operatorname{arccos}⁡(\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|})\\end{aligned}\n$$\n\nThe dot product is given by\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z} \\\\  & =1\\cdot 3+(-2)\\cdot 0+2\\cdot (-1) \\\\  & =1,\\end{aligned}\n$$\n\nand the magnitudes of $\\mathbf{a}$ and $\\mathbf{b}$ are\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-2)^{2}+{2}^{2}} \\\\  & =3, \\\\ |\\,b\\,| & =\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}} \\\\  & =\\sqrt{{3}^{2}+{0}^{2}+(-1)^{2}} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\Bigg( \\dfrac{1}{3\\sqrt{10}} \\Bigg) \\approx 83.9^\\circ.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186105957 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]} {:db/id 17592186054834 :knowledge-point/questions ["question-559e6eeb-8cf0-577b-a9ee-88ad70f4ec15" "question-d37f3cd3-5a50-54b2-83fb-c1289723c204"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054381 :question/problem "Find the value of $q$ that satisfies the equation $\\dfrac{q}{4}=-9.$" :question/worked-solution "In the equation, $q$ is being divided by $4.$ To isolate $q$, we can perform the opposite operation, which is *multiplying* by $4$. So, we multiply both sides of the equation by $4.$\n\n$$\n\\require{cancel}\n\t\\eqalign{\n    \t\t\\dfrac{q}{4} &=-9\\[5pt]\n\t\t4\\cdot \\dfrac{q}{4} &=4\\cdot \\left(-9\\right) \\[5pt]\n\t\t\\dfrac{4q}{4} &= -36\n\t}\n$$\n\nNow, we can cancel a common factor of $4$ from both the numerator and denominator.\n\n$$\n\\require{cancel}\n\t\\eqalign{\n\t\t\\dfrac{4q}{4} &= -36 \\[5pt]\n                \\dfrac{\\cancel{4}q}{\\cancel{4}} &= -36 \\\n\t\tq &=-36\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054835 :knowledge-point/questions ["question-7ce50429-066c-52cc-b521-7f9c1d989259" "question-063f6e3f-2db2-5183-9271-70afe486d5c2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054388 :question/problem "If $\\dfrac{1}{7}=\\dfrac{x}{2},$ then $x=$" :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n\\dfrac{x}{2}=\\dfrac{1}{7}\n$$\n\nIn this equation, $x$ is being divided by $2.$ To isolate $x$, we can perform the opposite operation, which is *multiplying* by $2.$ So, we multiply both sides of the equation by $2$ and simplify.\n\n$$\n\\begin{aligned}\\frac{x}{2} & =\\frac{1}{7} \\\\ 2\\cdot \\frac{x}{2} & =2\\cdot (\\frac{1}{7}) \\\\ \\frac{2x}{2} & =\\frac{2}{7} \\\\ \\frac{\\cancel{2}x}{\\cancel{2}} & =\\frac{2}{7} \\\\ x & =\\frac{2}{7}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054836 :knowledge-point/questions ["question-0b5cb4d7-77e4-5ac4-8439-cb36ef6f1c98" "question-b4c0e9de-946c-5a43-9beb-5626829b00ed"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054382 :question/problem "Find the value of $k$ that satisfies the equation $-\\dfrac{k}{2}=\\dfrac{1}{3}.$" :question/worked-solution "First, let's remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{k}{2} & =\\frac{1}{3} \\\\ (-1)\\cdot (-\\frac{k}{2}) & =(-1)\\cdot (\\frac{1}{3}) \\\\ \\frac{k}{2} & =-\\frac{1}{3}\\end{aligned}\n$$\n\nIn the equation above, $k$ is being divided by $2.$ To isolate $k$, we can perform the opposite operation, which is *multiplying* by $2$. So, we multiply both sides of the equation by $2$ and simplify.\n\n$$\n\\require{cancel}\n\t\\eqalign{\n    \t\t\\dfrac{k}{2} &=-\\dfrac{1}{3} \\[5pt]\n\t\t2 \\cdot \\dfrac{k}{2} &=2 \\cdot \\left( -\\dfrac{1}{3} \\right) \\[5pt]\n\t\t\\dfrac{2k}{2} &= -\\dfrac{2}{3} \\[5pt]\n\t\t\\dfrac{\\cancel{2}k}{\\cancel{2}} &= -\\dfrac{2}{3} \\[5pt]\n\t\tk &= -\\dfrac{2}{3}\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054837 :knowledge-point/questions ["question-3418ccb3-fdc3-5d51-a5fe-8860e2e0eae1" "question-d1c0c05b-9184-5c94-9e0b-29a6b0d0aa2b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054383 :question/problem "Solve the equation $24=-3z.$" :question/worked-solution "First, let's write the equation in a way that's a little more familiar to us. We can do this by swapping the left and right-hand sides of the equation.\n\n$$\n\\begin{aligned}24 & =-3z \\\\ -3z & =24\\end{aligned}\n$$\n\nIn this case, the variable $z$ is being *multiplied* by $-3.$ To isolate $z$, we can perform the *opposite* operation, which is *dividing* by $-3$. So, we divide both sides of the equation by $-3$ and simplify.\n\n$$\n\\require{cancel}\n\t\\eqalign{\n    \t\t-3z &=24 \\[5pt]\n\t\t\\dfrac {-3z} {-3} &= \\dfrac {24} {-3} \\[5pt]\n\t\t\\dfrac {\\cancel{-3}z} {\\cancel{-3}} &= -8 \\[5pt]\n\t\tz &=-8\n\t}\n$$" :db/ensure [:question/validate]} {:db/id "question-559e6eeb-8cf0-577b-a9ee-88ad70f4ec15" :question/id #uuid "559e6eeb-8cf0-577b-a9ee-88ad70f4ec15" :question/math-academy-id "q-2529" :question/problem "If $\\frac{y}{3}=-7,$ then $y=$" :question/worked-solution "In the equation, $y$ is being *divided* by $3.$ To isolate $y$, we can perform the opposite operation, which is *multiplying* by $3.$ So, we multiply both sides of the equation by $3.$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{y}{3} & =-7 \\\\ 3\\cdot \\frac{y}{3} & =3\\cdot (-7) \\\\ \\frac{3y}{3} & =-21\\end{aligned}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $3$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{3y}{3} & =-21 \\\\ \\frac{\\cancel{3}y}{\\cancel{3}} & =-21 \\\\ y & =-21\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f59d6512-b95a-5889-be9a-ac13bd918ef5"] :db/ensure [:question/validate]} {:db/id "answer-field-f59d6512-b95a-5889-be9a-ac13bd918ef5" :answer-field/id #uuid "f59d6512-b95a-5889-be9a-ac13bd918ef5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f77c9df-4ac8-595b-8f02-822b5fbff059" :answer-field/choices ["answer-8f77c9df-4ac8-595b-8f02-822b5fbff059" "answer-9a1f099e-c9e5-5616-be0b-79e83962f791" "answer-89661690-95ae-56d1-8974-7e150a0d7ba9" "answer-cc244fbe-3e9f-5073-a784-ed1931a0a3de" "answer-325d0450-9b16-5aac-a3a7-377751f4e94b"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f77c9df-4ac8-595b-8f02-822b5fbff059" :answer/id #uuid "8f77c9df-4ac8-595b-8f02-822b5fbff059" :answer/type :answer.type/math :answer/value "y=-21" :db/ensure [:answer/validate]} {:db/id "answer-9a1f099e-c9e5-5616-be0b-79e83962f791" :answer/id #uuid "9a1f099e-c9e5-5616-be0b-79e83962f791" :answer/type :answer.type/math :answer/value "y=-37" :db/ensure [:answer/validate]} {:db/id "answer-89661690-95ae-56d1-8974-7e150a0d7ba9" :answer/id #uuid "89661690-95ae-56d1-8974-7e150a0d7ba9" :answer/type :answer.type/math :answer/value "y=-\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "answer-cc244fbe-3e9f-5073-a784-ed1931a0a3de" :answer/id #uuid "cc244fbe-3e9f-5073-a784-ed1931a0a3de" :answer/type :answer.type/math :answer/value "y=21" :db/ensure [:answer/validate]} {:db/id "answer-325d0450-9b16-5aac-a3a7-377751f4e94b" :answer/id #uuid "325d0450-9b16-5aac-a3a7-377751f4e94b" :answer/type :answer.type/math :answer/value "y=\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "question-d37f3cd3-5a50-54b2-83fb-c1289723c204" :question/id #uuid "d37f3cd3-5a50-54b2-83fb-c1289723c204" :question/math-academy-id "q-101703" :question/problem "If $\\frac{c}{7}=-15,$ then $c=$" :question/worked-solution "In the equation, $c$ is being divided by $7.$ To isolate $c$, we can perform the opposite operation, which is *multiplying* by $7.$ So, we multiply both sides of the equation by $7.$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{c}{7} & =-15 \\\\ 7\\cdot \\frac{c}{7} & =7\\cdot (-15) \\\\ \\frac{7c}{7} & =-105\\end{aligned}\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $7$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{7c}{7} & =-105 \\\\ \\frac{\\cancel{7}c}{\\cancel{7}} & =-105 \\\\ c & =-105\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ccb0d861-b055-54be-9807-8167d461f080"] :db/ensure [:question/validate]} {:db/id "answer-field-ccb0d861-b055-54be-9807-8167d461f080" :answer-field/id #uuid "ccb0d861-b055-54be-9807-8167d461f080" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b8bfe55b-3f3f-5437-9c1c-534c75c79276" :answer-field/choices ["answer-b8bfe55b-3f3f-5437-9c1c-534c75c79276" "answer-b3d61de8-e89c-5958-aeba-2ee8b2dc43db" "answer-e2f64205-9c2f-5594-9863-ad6b055ee69f" "answer-974a8c26-2e0e-5e3c-b504-5c1eb40a74c2" "answer-084da45d-5363-5cef-bc65-730f06261b96"] :db/ensure [:answer-field/validate]} {:db/id "answer-b8bfe55b-3f3f-5437-9c1c-534c75c79276" :answer/id #uuid "b8bfe55b-3f3f-5437-9c1c-534c75c79276" :answer/type :answer.type/math :answer/value "c=-105" :db/ensure [:answer/validate]} {:db/id "answer-b3d61de8-e89c-5958-aeba-2ee8b2dc43db" :answer/id #uuid "b3d61de8-e89c-5958-aeba-2ee8b2dc43db" :answer/type :answer.type/math :answer/value "c=-35" :db/ensure [:answer/validate]} {:db/id "answer-e2f64205-9c2f-5594-9863-ad6b055ee69f" :answer/id #uuid "e2f64205-9c2f-5594-9863-ad6b055ee69f" :answer/type :answer.type/math :answer/value "c=-75" :db/ensure [:answer/validate]} {:db/id "answer-974a8c26-2e0e-5e3c-b504-5c1eb40a74c2" :answer/id #uuid "974a8c26-2e0e-5e3c-b504-5c1eb40a74c2" :answer/type :answer.type/math :answer/value "c=105" :db/ensure [:answer/validate]} {:db/id "answer-084da45d-5363-5cef-bc65-730f06261b96" :answer/id #uuid "084da45d-5363-5cef-bc65-730f06261b96" :answer/type :answer.type/math :answer/value "c=35" :db/ensure [:answer/validate]} {:db/id "question-7ce50429-066c-52cc-b521-7f9c1d989259" :question/id #uuid "7ce50429-066c-52cc-b521-7f9c1d989259" :question/math-academy-id "q-185208" :question/problem "If $4=\\frac{x}{6},$ then $x=$" :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n\\frac{x}{6}=4\n$$\n\nIn this equation, $x$ is being divided by $6.$ To isolate $x$, we can perform the opposite operation, which is *multiplying* by $6.$ So, we multiply both sides of the equation by $6$ and simplify.\n\n$$\n\\begin{aligned}\\frac{x}{6} & =4 \\\\ 6\\cdot \\frac{x}{6} & =6\\cdot 4 \\\\ \\frac{6x}{6} & =24 \\\\ \\frac{\\cancel{6}x}{\\cancel{6}} & =24 \\\\ x & =24\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eb6e90f1-e4fb-5bd7-934a-abea3bb1a854"] :db/ensure [:question/validate]} {:db/id "answer-field-eb6e90f1-e4fb-5bd7-934a-abea3bb1a854" :answer-field/id #uuid "eb6e90f1-e4fb-5bd7-934a-abea3bb1a854" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4799234a-295a-5198-942b-53a5d2def29a" :answer-field/choices ["answer-bc91284d-02f4-5fa0-a83d-e7d598cec96a" "answer-4799234a-295a-5198-942b-53a5d2def29a" "answer-f7b72569-c5f7-531a-a000-407c5565a4ec" "answer-01b5e5a5-95aa-50c9-9d76-ccae8d506b80" "answer-d6c53334-5e62-56b4-b272-6771b213342e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc91284d-02f4-5fa0-a83d-e7d598cec96a" :answer/id #uuid "bc91284d-02f4-5fa0-a83d-e7d598cec96a" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-4799234a-295a-5198-942b-53a5d2def29a" :answer/id #uuid "4799234a-295a-5198-942b-53a5d2def29a" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-f7b72569-c5f7-531a-a000-407c5565a4ec" :answer/id #uuid "f7b72569-c5f7-531a-a000-407c5565a4ec" :answer/type :answer.type/math :answer/value "\\frac{1}{24}" :db/ensure [:answer/validate]} {:db/id "answer-01b5e5a5-95aa-50c9-9d76-ccae8d506b80" :answer/id #uuid "01b5e5a5-95aa-50c9-9d76-ccae8d506b80" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d6c53334-5e62-56b4-b272-6771b213342e" :answer/id #uuid "d6c53334-5e62-56b4-b272-6771b213342e" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-063f6e3f-2db2-5183-9271-70afe486d5c2" :question/id #uuid "063f6e3f-2db2-5183-9271-70afe486d5c2" :question/math-academy-id "q-185213" :question/problem "If $-5=\\frac{t}{4},$ then $t=$" :question/worked-solution "First, let's swap the left and right-hand sides so that the variable is on the left-hand side.\n\n$$\n\\frac{t}{4}=-5\n$$\n\nIn this equation, $t$ is being divided by $4.$ To isolate $t$, we can perform the opposite operation, which is *multiplying* by $4.$ So, we multiply both sides of the equation by $4$ and simplify.\n\n$$\n\\begin{aligned}\\frac{t}{4} & =-5 \\\\ 4\\cdot \\frac{t}{4} & =4\\cdot (-5) \\\\ \\frac{4t}{4} & =-20 \\\\ \\frac{\\cancel{4}t}{\\cancel{4}} & =-20 \\\\ t & =-20\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8dfedb67-9d0d-5a04-828e-a8b8e90aee86"] :db/ensure [:question/validate]} {:db/id "answer-field-8dfedb67-9d0d-5a04-828e-a8b8e90aee86" :answer-field/id #uuid "8dfedb67-9d0d-5a04-828e-a8b8e90aee86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16d6e6db-a830-5baa-9915-b9601554ab12" :answer-field/choices ["answer-16d6e6db-a830-5baa-9915-b9601554ab12" "answer-9dc5900f-7d6d-5fab-bd02-49a64c159f82" "answer-202536e5-08f9-5281-b8f2-6dfd148bd8a1" "answer-2dc9aebe-c25e-5476-b79f-e7304f0323b5" "answer-2ea01f77-9bfa-55a9-acf1-b7a14f6df61a"] :db/ensure [:answer-field/validate]} {:db/id "answer-16d6e6db-a830-5baa-9915-b9601554ab12" :answer/id #uuid "16d6e6db-a830-5baa-9915-b9601554ab12" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-9dc5900f-7d6d-5fab-bd02-49a64c159f82" :answer/id #uuid "9dc5900f-7d6d-5fab-bd02-49a64c159f82" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-202536e5-08f9-5281-b8f2-6dfd148bd8a1" :answer/id #uuid "202536e5-08f9-5281-b8f2-6dfd148bd8a1" :answer/type :answer.type/math :answer/value "-\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-2dc9aebe-c25e-5476-b79f-e7304f0323b5" :answer/id #uuid "2dc9aebe-c25e-5476-b79f-e7304f0323b5" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-2ea01f77-9bfa-55a9-acf1-b7a14f6df61a" :answer/id #uuid "2ea01f77-9bfa-55a9-acf1-b7a14f6df61a" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "question-0b5cb4d7-77e4-5ac4-8439-cb36ef6f1c98" :question/id #uuid "0b5cb4d7-77e4-5ac4-8439-cb36ef6f1c98" :question/math-academy-id "q-6233" :question/problem "If $-\\frac{x}{7}=-3,$ then $x=$" :question/worked-solution "First, let's remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{x}{7} & =-3 \\\\ (-1)\\cdot (-\\frac{x}{7}) & =(-1)\\cdot (-3) \\\\ \\frac{x}{7} & =3\\end{aligned}\n$$\n\nIn the equation above, $x$ is being *divided* by $7.$ To isolate $x$, we can perform the opposite operation, which is *multiplying* by $7.$ So, we multiply both sides of the equation by $7$ and simplify.\n\n$$\n\\begin{aligned}\\frac{x}{7} & =3 \\\\ 7\\cdot \\frac{x}{7} & =7\\cdot 3 \\\\ \\frac{7x}{7} & =21 \\\\ \\frac{\\cancel{7}x}{\\cancel{7}} & =21 \\\\ x & =21\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bde93567-ec99-5785-851e-83145a289d18"] :db/ensure [:question/validate]} {:db/id "answer-field-bde93567-ec99-5785-851e-83145a289d18" :answer-field/id #uuid "bde93567-ec99-5785-851e-83145a289d18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2fbc6af7-9db2-57c1-834c-568900349313" :answer-field/choices ["answer-df4336c2-5480-5d1a-a84d-7019f790df07" "answer-ac3c64de-c016-5a5b-8e71-f84fd4be4d25" "answer-1909a1c9-6691-531d-93d0-870e5d5ef65a" "answer-13ab2acd-ac6c-5c2a-995c-c1dee89cbd43" "answer-2fbc6af7-9db2-57c1-834c-568900349313"] :db/ensure [:answer-field/validate]} {:db/id "answer-df4336c2-5480-5d1a-a84d-7019f790df07" :answer/id #uuid "df4336c2-5480-5d1a-a84d-7019f790df07" :answer/type :answer.type/math :answer/value "x=-10" :db/ensure [:answer/validate]} {:db/id "answer-ac3c64de-c016-5a5b-8e71-f84fd4be4d25" :answer/id #uuid "ac3c64de-c016-5a5b-8e71-f84fd4be4d25" :answer/type :answer.type/math :answer/value "x=-21" :db/ensure [:answer/validate]} {:db/id "answer-1909a1c9-6691-531d-93d0-870e5d5ef65a" :answer/id #uuid "1909a1c9-6691-531d-93d0-870e5d5ef65a" :answer/type :answer.type/math :answer/value "x=10" :db/ensure [:answer/validate]} {:db/id "answer-13ab2acd-ac6c-5c2a-995c-c1dee89cbd43" :answer/id #uuid "13ab2acd-ac6c-5c2a-995c-c1dee89cbd43" :answer/type :answer.type/math :answer/value "x=14" :db/ensure [:answer/validate]} {:db/id "answer-2fbc6af7-9db2-57c1-834c-568900349313" :answer/id #uuid "2fbc6af7-9db2-57c1-834c-568900349313" :answer/type :answer.type/math :answer/value "x=21" :db/ensure [:answer/validate]} {:db/id "question-b4c0e9de-946c-5a43-9beb-5626829b00ed" :question/id #uuid "b4c0e9de-946c-5a43-9beb-5626829b00ed" :question/math-academy-id "q-75388" :question/problem "If $-\\frac{c}{12}=4,$ then $c=$" :question/worked-solution "First, let's remove the negative sign from the variable. To do this, we multiply both sides of the equation by $-1.$\n\n$$\n\\begin{aligned}-\\frac{c}{12} & =4 \\\\ (-1)\\cdot (-\\frac{c}{12}) & =(-1)\\cdot 4 \\\\ \\frac{c}{12} & =-4\\end{aligned}\n$$\n\nIn the equation above, $c$ is being divided by $12.$ To isolate $c$, we can perform the opposite operation, which is *multiplying* by $12.$ So, we multiply both sides of the equation by $12$ and simplify.\n\n$$\n\\begin{aligned}\\frac{c}{12} & =-4 \\\\ 12\\cdot \\frac{c}{12} & =12\\cdot (-4) \\\\ \\frac{12c}{12} & =-48 \\\\ \\frac{\\cancel{12}c}{\\cancel{12}} & =-48 \\\\ c & =-48\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d8961cfc-c61f-5d7e-9ac8-9ae2e5f043be"] :db/ensure [:question/validate]} {:db/id "answer-field-d8961cfc-c61f-5d7e-9ac8-9ae2e5f043be" :answer-field/id #uuid "d8961cfc-c61f-5d7e-9ac8-9ae2e5f043be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-60abafac-8bc5-5541-a465-e3ddc61858bd" :answer-field/choices ["answer-0b5bfd06-95e1-5941-b827-ceeac852f83e" "answer-60abafac-8bc5-5541-a465-e3ddc61858bd" "answer-55dcc1fb-ebd9-55f7-95ad-86544ff060eb" "answer-4c88a484-7f77-57a9-b38b-ae25dd456160" "answer-3256080f-70d0-5fb8-a894-8e796e21fcea"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b5bfd06-95e1-5941-b827-ceeac852f83e" :answer/id #uuid "0b5bfd06-95e1-5941-b827-ceeac852f83e" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-60abafac-8bc5-5541-a465-e3ddc61858bd" :answer/id #uuid "60abafac-8bc5-5541-a465-e3ddc61858bd" :answer/type :answer.type/math :answer/value "-48" :db/ensure [:answer/validate]} {:db/id "answer-55dcc1fb-ebd9-55f7-95ad-86544ff060eb" :answer/id #uuid "55dcc1fb-ebd9-55f7-95ad-86544ff060eb" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-4c88a484-7f77-57a9-b38b-ae25dd456160" :answer/id #uuid "4c88a484-7f77-57a9-b38b-ae25dd456160" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "answer-3256080f-70d0-5fb8-a894-8e796e21fcea" :answer/id #uuid "3256080f-70d0-5fb8-a894-8e796e21fcea" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "question-3418ccb3-fdc3-5d51-a5fe-8860e2e0eae1" :question/id #uuid "3418ccb3-fdc3-5d51-a5fe-8860e2e0eae1" :question/math-academy-id "q-104729" :question/problem "If $-8x=-56$, then $x=$" :question/worked-solution "The variable $x$ is being *multiplied* by $-8.$ To isolate $x$, we can perform the *opposite* operation, which is *dividing* by $-8.$ So, we divide both sides of the equation by $-8.$\n\n$$\n\\begin{aligned}-8x & =-56 \\\\ \\frac{-8x}{-8} & =\\frac{-56}{-8} \\\\ \\frac{-8x}{-8} & =7\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-8$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-8x}{-8} & =7 \\\\ \\frac{\\cancel{-8}x}{\\cancel{-8}} & =7 \\\\ x & =7\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f974a2a4-9c4f-5a1b-821e-f099326de82a"] :db/ensure [:question/validate]} {:db/id "answer-field-f974a2a4-9c4f-5a1b-821e-f099326de82a" :answer-field/id #uuid "f974a2a4-9c4f-5a1b-821e-f099326de82a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-496138ed-80d7-5019-be5a-71780dc2805f" :answer-field/choices ["answer-f0044bd4-9712-58b9-98a7-e554f9df6582" "answer-6005c5b4-9cc1-503a-b9b4-c160b3cd0c82" "answer-5d5c1bdb-c6b7-54e7-8566-5bc991faef09" "answer-496138ed-80d7-5019-be5a-71780dc2805f" "answer-b866fa1c-8177-59ba-9e67-1bfd52204486"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0044bd4-9712-58b9-98a7-e554f9df6582" :answer/id #uuid "f0044bd4-9712-58b9-98a7-e554f9df6582" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-6005c5b4-9cc1-503a-b9b4-c160b3cd0c82" :answer/id #uuid "6005c5b4-9cc1-503a-b9b4-c160b3cd0c82" :answer/type :answer.type/math :answer/value "-\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-5d5c1bdb-c6b7-54e7-8566-5bc991faef09" :answer/id #uuid "5d5c1bdb-c6b7-54e7-8566-5bc991faef09" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-496138ed-80d7-5019-be5a-71780dc2805f" :answer/id #uuid "496138ed-80d7-5019-be5a-71780dc2805f" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-b866fa1c-8177-59ba-9e67-1bfd52204486" :answer/id #uuid "b866fa1c-8177-59ba-9e67-1bfd52204486" :answer/type :answer.type/math :answer/value "\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "question-d1c0c05b-9184-5c94-9e0b-29a6b0d0aa2b" :question/id #uuid "d1c0c05b-9184-5c94-9e0b-29a6b0d0aa2b" :question/math-academy-id "q-101709" :question/problem "If $-5t=-60$, then $t=$" :question/worked-solution "The variable $t$ is being *multiplied* by $-5.$ To isolate $t$, we can perform the *opposite* operation, which is *dividing* by $-5.$ So, we divide both sides of the equation by $-5.$\n\n$$\n\\begin{aligned}-5t & =-60 \\\\ \\frac{-5t}{-5} & =\\frac{-60}{-5} \\\\ \\frac{-5t}{-5} & =12\\end{aligned}\n$$\n\nNow, we can cancel a common factor of $-5$ from both the numerator and denominator.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-5t}{-5} & =12 \\\\ \\frac{\\cancel{-5}t}{\\cancel{-5}} & =12 \\\\ t & =12\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3d13bba6-2073-5396-8480-40096b0cd49a"] :db/ensure [:question/validate]} {:db/id "answer-field-3d13bba6-2073-5396-8480-40096b0cd49a" :answer-field/id #uuid "3d13bba6-2073-5396-8480-40096b0cd49a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-936c1241-d294-5cd8-ac4e-a80dd3d0c1ef" :answer-field/choices ["answer-1ddcb64c-c357-54cf-89aa-030f369b98da" "answer-8c4c33f7-864c-57ab-a135-6d02a1174278" "answer-311a4202-38ac-552b-88a0-fc11ccd2885b" "answer-936c1241-d294-5cd8-ac4e-a80dd3d0c1ef" "answer-0297944e-94e0-59aa-b8df-3fc18b5681ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ddcb64c-c357-54cf-89aa-030f369b98da" :answer/id #uuid "1ddcb64c-c357-54cf-89aa-030f369b98da" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-8c4c33f7-864c-57ab-a135-6d02a1174278" :answer/id #uuid "8c4c33f7-864c-57ab-a135-6d02a1174278" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-311a4202-38ac-552b-88a0-fc11ccd2885b" :answer/id #uuid "311a4202-38ac-552b-88a0-fc11ccd2885b" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-936c1241-d294-5cd8-ac4e-a80dd3d0c1ef" :answer/id #uuid "936c1241-d294-5cd8-ac4e-a80dd3d0c1ef" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-0297944e-94e0-59aa-b8df-3fc18b5681ab" :answer/id #uuid "0297944e-94e0-59aa-b8df-3fc18b5681ab" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id 17592186056009 :tutorial/content "Let's suppose that we want to solve an equation like \n\n$$\n\\dfrac x 6 = 4.\n$$\n\nFor this, we can use the **multiplication principle.** The multiplication principle tells us that multiplying (or dividing) both sides of an equation by the same number does not change its solution.\n\nIn this case, the variable $x$ is being *divided* by $6.$ To isolate $x$, we can perform the *opposite* operation, which is *multiplying* by $6$. So, we multiply both sides of the equation by $6.$\n\n$$\n\\eqalign{\n\t\t\\dfrac x 6 \t\t\t\t\t&= 4 \\[5pt]\n\t\t{\\color{blue}{6}} \\cdot \\dfrac x 6  \t&= {\\color{blue}{6}}\\cdot 4\\[5pt]\n\t\t\\dfrac{6x}{6}\t\t\t&=24\\[5pt]\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $6$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{6x}{6}\t\t\t&=24 \\\n\t\t\\dfrac{ \\cancel{6} x}{\\cancel{6} }\t\t\t&=24 \\\n\t\tx\t\t\t\t&=24\n\t}\n$$\n\n \n\nThus, our solution is $x=24.$ Let's check that this solution is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t\\dfrac x 6 &=4 \\[5pt]\n    \t\t\\dfrac{24}{6} &=4 \\[5pt]\n\t\t4 &= 4 \\; {\\color{green}{\\checkmark}}\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186056010 :tutorial/content "In order to remove a negative sign from our variable, we can multiply both sides by $-1$. This way, the two negatives will cancel out to form a positive. \n\nFor example, suppose that we have the equation\n\n$$\n-x = 3\n$$\n\nWe can isolate $x$ by multiplying both sides of the equation by $-1,$ as follows:\n\n$$\n\\begin{aligned}-x & =3 \\\\ (-1)\\cdot (-x) & =(-1)\\cdot 3 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the equation is $x=-3.$ Let's check to see that this works by substituting our solution back into the original equation.\n\n$$\n\\begin{aligned}-x & =3 \\\\ -(-3) & =3 \\\\ 3 & =3\\,✓\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186056011 :tutorial/content "To solve an equation like $7x = 21$, we again need to look at what's happening to the variable and ask ourselves what the opposite operation is.\n\nIn this case, the variable $x$ is being *multiplied* by $7.$ To isolate $x$, we can perform the *opposite* operation, which is *dividing* by $7$. So, we divide both sides of the equation by $7.$\n\n$$\n\\eqalign{\n\t\t7x &= 21 \\[5pt]\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\n\t}\n$$\n\n \n\nNow, we can cancel a common factor of $7$ from both the numerator and denominator.\n\n$$\n\\eqalign{\n\t\t\\dfrac{7x}{{\\color{blue}7}} &=\\dfrac{21}{{\\color{blue}7}}\\[5pt]\n\t\t\\dfrac{\\cancel{7}x}{\\cancel{\\color{blue}7}} &=3 \\[5pt]\n\t\tx &=3\n\t}\n$$\n\n \n\nLet's check that our answer is correct by plugging it back into the original equation:\n\n$$\n\\eqalign{\n    \t\t7x &=21 \\[5pt]\n    \t\t7(3) &=21 \\[5pt]\n\t\t21 &= 21 \\; {\\color{green}{\\checkmark}}\n\t}\n$$\n\n**Note:** If there is a negative coefficient on a variable, we can get rid of it by dividing, like we do with positive coefficients. For example:\n\n$$\n\\begin{aligned}-2y & =10 \\\\ \\frac{-2y}{-2} & =\\frac{10}{-2} \\\\ \\frac{\\cancel{-2}y}{\\cancel{-2}} & =-5 \\\\ y & =-5\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054901 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186123980 :answer-field/choices 17592186123984] [:db/retract 17592186123980 :answer-field/choices 17592186123985] [:db/retract 17592186123980 :answer-field/choices 17592186123981] [:db/retract 17592186123980 :answer-field/choices 17592186123982] [:db/retract 17592186123980 :answer-field/choices 17592186123983] [:db/retract 17592186125121 :question/answer-fields 17592186123326] [:db/retract 17592186125143 :question/answer-fields 17592186123458] {:db/id 17592186124540 :knowledge-point/questions ["question-c2f444bc-6844-54b3-8db1-284a3e7b2b75" "question-0f740568-e21f-5fbd-943a-06810f0bb27d" "question-3570dc7e-1a01-5006-842e-6d17aa9f3a4b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124349 :question/problem "Let $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2 \\}$ be a basis of $\\mathbb{R}^2$ and let $\\mathbf{T}:\\mathbb{R}^2 \\rightarrow \\mathbb{R}^2$ be a linear transformation. Find $[\\mathbf{T}(\\mathbf{x})]_{\\mathcal{B}}$, given that\n![](images/9b/9b4fc022c68b01f2eba12012960301aff9fd05f5db1ac2950aef4775c2678298.svg)" :db/ensure [:question/validate]} {:db/id 17592186124383 :question/problem "Let $\\mathcal{B}=\\{ \\mathbf{b}_1,\\mathbf{b}_2,\\mathbf{b}_3 \\}$ be a basis of $\\mathbb{R}^3.$ The matrix $[\\,\\mathbf{T}\\,]_{\\mathcal{B}}$ of the linear transformation $\\mathbf{T}:\\mathbb{R}^3 \\rightarrow \\mathbb{R}^3$ is given by\n\n![](images/7a/7a3f24ba8c0b519455a745e7ed5c7042bd5c21d516efc4db9629d8084e8b8484.svg)\n\nFind the value of $\\,a+b+c,\\,$ given that \n\n$$\n\\begin{aligned}T({b}_{1}) & ={b}_{1}+{b}_{3}, \\\\ T({b}_{2}) & ={b}_{1}+{b}_{2}, \\\\ T({b}_{3}) & ={b}_{2}+{b}_{3}.\\end{aligned}\n$$" :question/worked-solution "First, we write down the coordinates of the images relative to the basis $\\mathcal{B}\\mathbin{:}$\n\n![](images/d0/d0f702b71b9352d3fa2fff2f446730f5515002811d65f6f3c562b01c7b14d76f.svg)\n\nNow, the $\\mathcal{B}$-matrix for $\\mathbf{T}$ is a matrix  whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{B}.$ Therefore, we obtain\n\n![](images/b0/b01bef7c1eb325b912ec0ce3e85c2d6fc30711e56a6285b9fa5e3b033913339a.svg)\n\nFinally, $a=1,$ $b=1,$ $c=0$ and \n\n$$\na+b+c = 1+1+0 = 2.\n$$" :db/ensure [:question/validate]} {:db/id 17592186124539 :knowledge-point/questions ["question-071d0b70-e887-5685-aa09-942aa6ae2d26"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124348 :question/problem "Let $\\mathcal{B}$ be a basis of $\\mathbb{R}^2$ and let $\\mathbf{T}: \\mathbb{R}^2 \\rightarrow \\mathbb{R}^2$ be a linear transformation. Find $[\\,\\mathbf{T}\\,]_{\\mathcal{B}}$, given that\n\n![](images/46/46986c2f4264679305a0a3e39389db21556e4df6c9cf3c0e5e946a60f51fc095.svg)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\{ \\mathbf{b}_1,\\mathbf{b}_2 \\}.$ The $\\mathcal{B}$-matrix for $\\mathbf{T}$ is a matrix whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1)$ and $\\mathbf{T}(\\mathbf{b}_2)$ relative to the basis $\\mathcal{B}.$\n\nTo find the coordinates of $\\mathbf{T}(\\mathbf{b}_1)$ and $\\mathbf{T}(\\mathbf{b}_2)$ relative to the basis $\\mathcal{B}$, we consider the matrix\n![](images/52/5233d90ca1c40bc432e86822aeee6ec76297add067c848cb95b4436285a52e03.svg)\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $\\mathcal{B}$-matrix for $\\mathbf{T}\\mathbin{:}$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 5 & 3 \\\\ -1 & 1 & -4 & -7\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 5 & 3 \\\\ 0 & 2 & 1 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{2}:=\\frac{1}{2}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 5 & 3 \\\\ 0 & 1 & \\frac{1}{2} & -2\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{9}{2} & 5 \\\\ 0 & 1 & \\frac{1}{2} & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n![](images/a9/a999549a2f023ff620de33d88ad5a2c7edb8c8d803f0d40911f682efe4c6d261.svg)" :db/ensure [:question/validate]} {:db/id 17592186124350 :question/problem "The basis $\\mathcal{B}$ of $\\mathbb{R}^3$ and the matrix $[\\,\\mathbf{T}\\,]_{\\mathcal{B}}$ of the linear transformation $\\mathbf{T}: \\mathbb{R}^3 \\rightarrow \\mathbb{R}^3$ relative to $\\mathcal{B}$ are given by\n\n![](images/be/beb5fb8757faf2c9e25c46013b90565611943b2796b0f23c6f0dece1e44e9055.svg)\n\nWhat is the value of $\\,a+b+c,\\,$ given that  \n\n![](images/2f/2f5d701e5ded2a62bdc85878a6d7b8e575bec05aabd7d4b132fac7e3bdbc5f3a.svg)" :question/worked-solution "Let's denote the vectors of $\\mathcal{B}$ as $\\{ \\mathbf{b}_1,\\mathbf{b}_2,\\mathbf{b}_3 \\}.$ The $\\mathcal{B}$-matrix for $\\mathbf{T}$ is a matrix whose columns are the coordinates of the vectors $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{B}.$\n\nTo find the coordinates of $\\mathbf{T}(\\mathbf{b}_1),$ $\\mathbf{T}(\\mathbf{b}_2),$ and $\\mathbf{T}(\\mathbf{b}_3)$ relative to the basis $\\mathcal{B}$, we consider the matrix\n![](images/71/7136e2bb6e6f18a4bdb43a10ea3f14833077197b55bdd5bdc4c31c2aca7be2ab.svg)\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $\\mathcal{B}$-matrix for $\\mathbf{T}\\mathbin{:}$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 0 & -9 & 7 & 10 \\\\ 0 & 1 & -3 & 0 & -2 & -10 \\\\ 0 & 0 & 4 & 4 & 0 & 8\\end{aligned}] &  & \\begin{aligned}{R}_{3}:=\\frac{1}{4}{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 & -9 & 7 & 10 \\\\ 0 & 1 & -3 & 0 & -2 & -10 \\\\ 0 & 0 & 1 & 1 & 0 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & -3 & 0 & -9 & 7 & 10 \\\\ 0 & 1 & 0 & 3 & -2 & -4 \\\\ 0 & 0 & 1 & 1 & 0 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}+3{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 1 & -2 \\\\ 0 & 1 & 0 & 3 & -2 & -4 \\\\ 0 & 0 & 1 & 1 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n![](images/2e/2eba20e60b23942d9074b2e88003bee36267b40381f3fa157b1f74e38bef5198.svg)\n\nFinally, $a=1,$ $b=-2,$ $c=-2$ and \n\n$$\na+b+c = 1+(-2)+(-2) = -3.\n$$" :db/ensure [:question/validate]} {:db/id "question-c2f444bc-6844-54b3-8db1-284a3e7b2b75" :question/id #uuid "c2f444bc-6844-54b3-8db1-284a3e7b2b75" :question/math-academy-id "q-38089" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=[\\begin{aligned}1 & -3 \\\\ 2 & -4\\end{aligned}]\\,$ and $\\,[x]_{B}=[\\begin{aligned}-4 \\\\ 3\\end{aligned}].$" :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =[\\begin{aligned}1 & -3 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}-4 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-13 \\\\ -20\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-581265b5-b2a1-58d1-87f3-645c26ba1133"] :db/ensure [:question/validate]} {:db/id "answer-field-581265b5-b2a1-58d1-87f3-645c26ba1133" :answer-field/id #uuid "581265b5-b2a1-58d1-87f3-645c26ba1133" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f436d6b3-4f37-5c98-a4bd-3908a0900a83" :answer-field/choices ["answer-e52f59aa-11a2-5664-be8a-489ca2166c43" "answer-f436d6b3-4f37-5c98-a4bd-3908a0900a83" "answer-c69262f2-f952-5f6f-8070-1d1df7dbdf8a" "answer-44a2df56-59f5-5870-bf5d-d6caef11c361" "answer-fd4d3af1-2f0c-51d6-a1d4-b33f91a4e49c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e52f59aa-11a2-5664-be8a-489ca2166c43" :answer/id #uuid "e52f59aa-11a2-5664-be8a-489ca2166c43" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f436d6b3-4f37-5c98-a4bd-3908a0900a83" :answer/id #uuid "f436d6b3-4f37-5c98-a4bd-3908a0900a83" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-13 \\\\ -20\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c69262f2-f952-5f6f-8070-1d1df7dbdf8a" :answer/id #uuid "c69262f2-f952-5f6f-8070-1d1df7dbdf8a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-44a2df56-59f5-5870-bf5d-d6caef11c361" :answer/id #uuid "44a2df56-59f5-5870-bf5d-d6caef11c361" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-31 \\\\ -20\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fd4d3af1-2f0c-51d6-a1d4-b33f91a4e49c" :answer/id #uuid "fd4d3af1-2f0c-51d6-a1d4-b33f91a4e49c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}20 \\\\ 13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186326725 :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=[\\begin{aligned}8 & 1 \\\\ 11 & -4\\end{aligned}]\\,$ and $\\,[x]_{B}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$" :db/ensure [:question/validate]} {:db/id "question-0f740568-e21f-5fbd-943a-06810f0bb27d" :question/id #uuid "0f740568-e21f-5fbd-943a-06810f0bb27d" :question/math-academy-id "q-38880" :question/problem "Let $B=\\{{b}_{1},{b}_{2}\\}$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[T(x)]_{B}$, given that\n$\\,$ $[T]_{B}=[\\begin{aligned}-3 & 5 \\\\ 1 & -1\\end{aligned}]\\,$ and $\\,[x]_{B}=[\\begin{aligned}7 \\\\ 1\\end{aligned}].$" :question/worked-solution "The image of $[x]_{B}$ relative to the basis $B$ under the action of the linear transformation $T$ is given by \n\n$$\n\\begin{aligned}[T(x)]_{B} & =[T]_{B}[x]_{B} \\\\  & =[\\begin{aligned}-3 & 5 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}-16 \\\\ 6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-edae35f1-1005-53e8-b986-b66d714ed188"] :db/ensure [:question/validate]} {:db/id "answer-field-edae35f1-1005-53e8-b986-b66d714ed188" :answer-field/id #uuid "edae35f1-1005-53e8-b986-b66d714ed188" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ed1fbeeb-e829-57bf-b71c-36019b6ef95c" :answer-fi