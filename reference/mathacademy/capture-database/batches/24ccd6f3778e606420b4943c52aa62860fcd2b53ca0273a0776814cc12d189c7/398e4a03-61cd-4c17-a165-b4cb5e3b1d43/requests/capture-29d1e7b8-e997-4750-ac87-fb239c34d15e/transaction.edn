931ce7d2fd7b" "answer-77606623-9e12-5922-8bc5-274712f9ce66" "answer-fe3b7392-9245-5b25-b8dd-39ac5d0958a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d27b27a-980b-5ba5-86b9-9aff77b35144" :answer/id #uuid "1d27b27a-980b-5ba5-86b9-9aff77b35144" :answer/type :answer.type/math :answer/value "\\frac{3y}{x}" :db/ensure [:answer/validate]} {:db/id "answer-5991eaf9-379d-5279-909a-66c42b65d53b" :answer/id #uuid "5991eaf9-379d-5279-909a-66c42b65d53b" :answer/type :answer.type/math :answer/value "\\frac{y}{3x}" :db/ensure [:answer/validate]} {:db/id "answer-9775a4ef-c5bc-58e2-beec-931ce7d2fd7b" :answer/id #uuid "9775a4ef-c5bc-58e2-beec-931ce7d2fd7b" :answer/type :answer.type/math :answer/value "\\frac{y}{3z}" :db/ensure [:answer/validate]} {:db/id "answer-77606623-9e12-5922-8bc5-274712f9ce66" :answer/id #uuid "77606623-9e12-5922-8bc5-274712f9ce66" :answer/type :answer.type/math :answer/value "\\frac{y}{x}" :db/ensure [:answer/validate]} {:db/id "answer-fe3b7392-9245-5b25-b8dd-39ac5d0958a5" :answer/id #uuid "fe3b7392-9245-5b25-b8dd-39ac5d0958a5" :answer/type :answer.type/math :answer/value "\\frac{z}{3x}" :db/ensure [:answer/validate]} {:db/id "question-61eea428-2437-5847-999f-591f4a5a456c" :question/id #uuid "61eea428-2437-5847-999f-591f4a5a456c" :question/math-academy-id "q-67242" :question/problem "Which of the following is equivalent to $\\frac{z(5+2z)}{3z}?$" :question/worked-solution "First, we decompose all of the terms into their various factors.\n\n$$\n\\begin{aligned}\\frac{z(5+2z)}{3z}=\\frac{z\\cdot (5+2z)}{3\\cdot z}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $z$'s.\n\n$$\n\\begin{aligned}\\frac{z\\cdot (5+2z)}{3\\cdot z} & = \\\\ \\frac{\\cancel{z}\\cdot (5+2z)}{3\\cdot \\cancel{z}} & = \\\\ \\frac{5+2z}{3}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{5+2z}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-112af529-727f-510a-876d-604ecec5f0bd"] :db/ensure [:question/validate]} {:db/id "answer-field-112af529-727f-510a-876d-604ecec5f0bd" :answer-field/id #uuid "112af529-727f-510a-876d-604ecec5f0bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c4226aa-9491-52f8-9c50-18fb61fb5a1e" :answer-field/choices ["answer-65bf5c02-8884-527a-8596-a864fde66c5c" "answer-28980dc0-67fe-568a-95f7-85f6561039b7" "answer-5c4226aa-9491-52f8-9c50-18fb61fb5a1e" "answer-cb387617-f782-5ecb-bb3d-85ab96c34d51" "answer-efe243fe-0627-5bc7-ac0c-58cbf7e19251"] :db/ensure [:answer-field/validate]} {:db/id "answer-65bf5c02-8884-527a-8596-a864fde66c5c" :answer/id #uuid "65bf5c02-8884-527a-8596-a864fde66c5c" :answer/type :answer.type/math :answer/value "\\frac{2+2z}{3}" :db/ensure [:answer/validate]} {:db/id "answer-28980dc0-67fe-568a-95f7-85f6561039b7" :answer/id #uuid "28980dc0-67fe-568a-95f7-85f6561039b7" :answer/type :answer.type/math :answer/value "\\frac{2+5z}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5c4226aa-9491-52f8-9c50-18fb61fb5a1e" :answer/id #uuid "5c4226aa-9491-52f8-9c50-18fb61fb5a1e" :answer/type :answer.type/math :answer/value "\\frac{5+2z}{3}" :db/ensure [:answer/validate]} {:db/id "answer-cb387617-f782-5ecb-bb3d-85ab96c34d51" :answer/id #uuid "cb387617-f782-5ecb-bb3d-85ab96c34d51" :answer/type :answer.type/math :answer/value "\\frac{5+2z}{z}" :db/ensure [:answer/validate]} {:db/id "answer-efe243fe-0627-5bc7-ac0c-58cbf7e19251" :answer/id #uuid "efe243fe-0627-5bc7-ac0c-58cbf7e19251" :answer/type :answer.type/math :answer/value "\\frac{5+5z}{3}" :db/ensure [:answer/validate]} {:db/id "question-fad200a4-e2f6-57c9-aa77-2766fc482dc1" :question/id #uuid "fad200a4-e2f6-57c9-aa77-2766fc482dc1" :question/math-academy-id "q-41552" :question/problem "Simplify $\\frac{(3x)(7y)}{28y}.$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $(3x)(7y)$ in the numerator becomes $3\\cdot 7\\cdot x\\cdot y,$ and the $28y$ in the denominator becomes $2\\cdot 2\\cdot 7\\cdot y.$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{(3x)(7y)}{28y}=\\frac{3\\cdot 7\\cdot x\\cdot y}{2\\cdot 2\\cdot 7\\cdot y}\\end{aligned}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $7\\text{'s}$ and one pair of $y$'s.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{3\\cdot 7\\cdot x\\cdot y}{2\\cdot 2\\cdot 7\\cdot y} & = \\\\ \\frac{3\\cdot \\cancel{7}\\cdot x\\cdot \\cancel{y}}{2\\cdot 2\\cdot \\cancel{7}\\cdot \\cancel{y}} & = \\\\ \\frac{3\\cdot x}{2\\cdot 2} & = \\\\ \\frac{3}{4}x\\end{aligned}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{3}{4}x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3ac2e58a-247b-5a34-a1a7-53a045e18181"] :db/ensure [:question/validate]} {:db/id "answer-field-3ac2e58a-247b-5a34-a1a7-53a045e18181" :answer-field/id #uuid "3ac2e58a-247b-5a34-a1a7-53a045e18181" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77eff539-c70f-5cc6-a384-798f4fb1bfae" :answer-field/choices ["answer-37115e22-5ffc-53cf-adb7-fa70a8cb055e" "answer-362a7338-66ee-57c0-a245-11f4e62738f1" "answer-77eff539-c70f-5cc6-a384-798f4fb1bfae" "answer-d0c1f978-3d95-58dc-be98-003e32663ad2" "answer-beccfae6-b5ee-5736-b110-8316f9b6d40c"] :db/ensure [:answer-field/validate]} {:db/id "answer-37115e22-5ffc-53cf-adb7-fa70a8cb055e" :answer/id #uuid "37115e22-5ffc-53cf-adb7-fa70a8cb055e" :answer/type :answer.type/math :answer/value "\\frac{3x}{4y}" :db/ensure [:answer/validate]} {:db/id "answer-362a7338-66ee-57c0-a245-11f4e62738f1" :answer/id #uuid "362a7338-66ee-57c0-a245-11f4e62738f1" :answer/type :answer.type/math :answer/value "\\frac{3}{4y}" :db/ensure [:answer/validate]} {:db/id "answer-77eff539-c70f-5cc6-a384-798f4fb1bfae" :answer/id #uuid "77eff539-c70f-5cc6-a384-798f4fb1bfae" :answer/type :answer.type/math :answer/value "\\frac{3}{4}x" :db/ensure [:answer/validate]} {:db/id "answer-d0c1f978-3d95-58dc-be98-003e32663ad2" :answer/id #uuid "d0c1f978-3d95-58dc-be98-003e32663ad2" :answer/type :answer.type/math :answer/value "\\frac{7}{4}x" :db/ensure [:answer/validate]} {:db/id "answer-beccfae6-b5ee-5736-b110-8316f9b6d40c" :answer/id #uuid "beccfae6-b5ee-5736-b110-8316f9b6d40c" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-d8919a5c-5e3b-5274-9d2f-901afddd5e90" :question/id #uuid "d8919a5c-5e3b-5274-9d2f-901afddd5e90" :question/math-academy-id "q-41557" :question/problem "Simplify $\\frac{32x(5z+1)}{12xz}.$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $32x(5z+1)$ in the numerator becomes $2\\cdot 2\\cdot 2\\cdot 2\\cdot 2\\cdot x\\cdot (5z+1),$ and the $12xz$ in the denominator becomes $3\\cdot 2\\cdot 2\\cdot x\\cdot z.$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{32x(5z+1)}{12xz}=\\frac{2\\cdot 2\\cdot 2\\cdot 2\\cdot 2\\cdot x\\cdot (5z+1)}{3\\cdot 2\\cdot 2\\cdot x\\cdot z}\\end{aligned}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there are two pairs of $2\\text{'s}$ and one pair of $x$'s.\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{2\\cdot 2\\cdot 2\\cdot 2\\cdot 2\\cdot x\\cdot (5z+1)}{3\\cdot 2\\cdot 2\\cdot x\\cdot z} & = \\\\ \\frac{\\cancel{2}\\cdot \\cancel{2}\\cdot 2\\cdot 2\\cdot 2\\cdot \\cancel{x}\\cdot (5z+1)}{3\\cdot \\cancel{2}\\cdot \\cancel{2}\\cdot \\cancel{x}\\cdot z} & = \\\\ \\frac{2\\cdot 2\\cdot 2\\cdot (5z+1)}{3\\cdot z} & = \\\\ \\frac{8(5z+1)}{3z}\\end{aligned}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{8(5z+1)}{3z}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-62023835-2ec7-51b8-9552-f67efdf117fc"] :db/ensure [:question/validate]} {:db/id "answer-field-62023835-2ec7-51b8-9552-f67efdf117fc" :answer-field/id #uuid "62023835-2ec7-51b8-9552-f67efdf117fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f72bdc69-b108-572c-bd30-099ea2502466" :answer-field/choices ["answer-2091d8a1-eaab-5a05-8861-1f8abb34b955" "answer-f90a5767-60e8-51c1-8857-0d450ea81290" "answer-85fb3187-facc-57f1-ab70-b630841edb64" "answer-ebc04d96-6d76-50b3-a8c9-411832fae8f7" "answer-f72bdc69-b108-572c-bd30-099ea2502466"] :db/ensure [:answer-field/validate]} {:db/id "answer-2091d8a1-eaab-5a05-8861-1f8abb34b955" :answer/id #uuid "2091d8a1-eaab-5a05-8861-1f8abb34b955" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-f90a5767-60e8-51c1-8857-0d450ea81290" :answer/id #uuid "f90a5767-60e8-51c1-8857-0d450ea81290" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-85fb3187-facc-57f1-ab70-b630841edb64" :answer/id #uuid "85fb3187-facc-57f1-ab70-b630841edb64" :answer/type :answer.type/math :answer/value "\\frac{2(5z+1)}{3z}" :db/ensure [:answer/validate]} {:db/id "answer-ebc04d96-6d76-50b3-a8c9-411832fae8f7" :answer/id #uuid "ebc04d96-6d76-50b3-a8c9-411832fae8f7" :answer/type :answer.type/math :answer/value "\\frac{4(5z+1)}{z}" :db/ensure [:answer/validate]} {:db/id "answer-f72bdc69-b108-572c-bd30-099ea2502466" :answer/id #uuid "f72bdc69-b108-572c-bd30-099ea2502466" :answer/type :answer.type/math :answer/value "\\frac{8(5z+1)}{3z}" :db/ensure [:answer/validate]} {:db/id "question-155136a2-7453-5b52-882f-507c2e2bad0d" :question/id #uuid "155136a2-7453-5b52-882f-507c2e2bad0d" :question/math-academy-id "q-14373" :question/problem "$\\frac{3+2x}{2x+3}=$" :question/worked-solution "First, we notice that $2x+3=3+2x.$ So we have:\n\n$$\n\\begin{aligned}\\frac{3+2x}{2x+3}=\\frac{3+2x}{3+2x}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $3+2x.$\n\n$$\n\\begin{aligned}\\frac{3+2x}{3+2x} & = \\\\ \\frac{\\cancel{(3+2x)}}{\\cancel{(3+2x)}} & = \\\\ 1\\end{aligned}\n$$\n\nThus, the expression simplifies to $1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-14fd58b4-2f30-5ee5-84aa-9be98305fb78"] :db/ensure [:question/validate]} {:db/id "answer-field-14fd58b4-2f30-5ee5-84aa-9be98305fb78" :answer-field/id #uuid "14fd58b4-2f30-5ee5-84aa-9be98305fb78" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fc830cf0-6f39-543f-9250-0e261d7a0ffd" :answer-field/choices ["answer-fc830cf0-6f39-543f-9250-0e261d7a0ffd" "answer-8e0ec6de-9581-5bd8-bb44-d0aa83898ca2" "answer-f4806540-adde-54c6-a865-acf5b657cc39" "answer-0c59e113-f08a-53ee-867d-94d7fb5788b4" "answer-11936538-40d4-54b8-8b7b-d33e072de285"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc830cf0-6f39-543f-9250-0e261d7a0ffd" :answer/id #uuid "fc830cf0-6f39-543f-9250-0e261d7a0ffd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-8e0ec6de-9581-5bd8-bb44-d0aa83898ca2" :answer/id #uuid "8e0ec6de-9581-5bd8-bb44-d0aa83898ca2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f4806540-adde-54c6-a865-acf5b657cc39" :answer/id #uuid "f4806540-adde-54c6-a865-acf5b657cc39" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "answer-0c59e113-f08a-53ee-867d-94d7fb5788b4" :answer/id #uuid "0c59e113-f08a-53ee-867d-94d7fb5788b4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-11936538-40d4-54b8-8b7b-d33e072de285" :answer/id #uuid "11936538-40d4-54b8-8b7b-d33e072de285" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-b735757b-2dac-511b-87bc-3911444d7136" :question/id #uuid "b735757b-2dac-511b-87bc-3911444d7136" :question/math-academy-id "q-75375" :question/problem "$\\frac{3a(a-b)}{9(a-b)}=$" :question/worked-solution "First, we decompose all of the terms into their various factors. The $3a(a-b)$ in the numerator becomes $3\\cdot a\\cdot (a-b),$ and the $9(a-b)$ in the denominator becomes $3\\cdot 3\\cdot (a-b).$\n\n$$\n\\begin{aligned}\\frac{3a(a-b)}{9(a-b)}=\\frac{3\\cdot a\\cdot (a-b)}{3\\cdot 3\\cdot (a-b)}\\end{aligned}\n$$\n\nThen, we cancel out all the pairs of common factors in the numerator and denominator. In this case, there is one pair of $3$'s and one pair of $(a-b)$'s.\n\n$$\n\\begin{aligned}\\frac{3a(a-b)}{9(a-b)} & =\\frac{3\\cdot a\\cdot (a-b)}{3\\cdot 3\\cdot (a-b)} \\\\  & =\\frac{\\cancel{3}\\cdot a\\cdot \\cancel{(a-b)}}{\\cancel{3}\\cdot 3\\cdot \\cancel{(a-b)}} \\\\  & =\\frac{a}{3}\\end{aligned}\n$$\n\nThus, the expression simplifies to $\\frac{a}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b34e94ad-ff95-5978-bc6c-c7f7116d7c1b"] :db/ensure [:question/validate]} {:db/id "answer-field-b34e94ad-ff95-5978-bc6c-c7f7116d7c1b" :answer-field/id #uuid "b34e94ad-ff95-5978-bc6c-c7f7116d7c1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-efdf0132-ec49-5bac-b7db-3e2bb81f938a" :answer-field/choices ["answer-92ca82ab-70b0-5f55-b824-d4d251229f93" "answer-895c3ad6-e436-5b2f-a81b-70ac393a14ba" "answer-eddd6e42-563b-54b5-817b-fd7723075770" "answer-efdf0132-ec49-5bac-b7db-3e2bb81f938a" "answer-7e2c46ec-a87f-561e-bb5a-e80045e5dcac"] :db/ensure [:answer-field/validate]} {:db/id "answer-92ca82ab-70b0-5f55-b824-d4d251229f93" :answer/id #uuid "92ca82ab-70b0-5f55-b824-d4d251229f93" :answer/type :answer.type/math :answer/value "3a" :db/ensure [:answer/validate]} {:db/id "answer-895c3ad6-e436-5b2f-a81b-70ac393a14ba" :answer/id #uuid "895c3ad6-e436-5b2f-a81b-70ac393a14ba" :answer/type :answer.type/math :answer/value "\\frac{3}{a}" :db/ensure [:answer/validate]} {:db/id "answer-eddd6e42-563b-54b5-817b-fd7723075770" :answer/id #uuid "eddd6e42-563b-54b5-817b-fd7723075770" :answer/type :answer.type/math :answer/value "\\frac{a}{2}" :db/ensure [:answer/validate]} {:db/id "answer-efdf0132-ec49-5bac-b7db-3e2bb81f938a" :answer/id #uuid "efdf0132-ec49-5bac-b7db-3e2bb81f938a" :answer/type :answer.type/math :answer/value "\\frac{a}{3}" :db/ensure [:answer/validate]} {:db/id "answer-7e2c46ec-a87f-561e-bb5a-e80045e5dcac" :answer/id #uuid "7e2c46ec-a87f-561e-bb5a-e80045e5dcac" :answer/type :answer.type/math :answer/value "a" :db/ensure [:answer/validate]} {:db/id 17592186055937 :tutorial/content "If a rational expression is expressed in factored form, we can sometimes make the expression even simpler by pulling out factors that are common in both the numerator and denominator.\n\nFor example, suppose that we want to simplify the rational expression\n\n$$\n\\dfrac{4(2x-3)}{2}.\n$$\n\nIf we decompose $4$ into $2\\cdot 2,$ we can pull out a factor of $2$ from both the numerator and denominator:\n\n$$\n\\begin{aligned}\\frac{4(2x-3)}{2} & = \\\\ \\frac{2\\cdot 2\\cdot (2x-3)}{2} & = \\\\ \\frac{2}{2}\\cdot \\frac{2\\cdot (2x-3)}{1}.\\end{aligned}\n$$\n\nThe fraction $\\dfrac{2}{2}$ is the same as $1,$ and anything times $1$ is just itself, so\n\n$$\n\\begin{aligned}\\frac{2}{2}\\cdot \\frac{2\\cdot (2x-3)}{1} & = \\\\ 1\\cdot \\frac{2\\cdot (2x-3)}{1} & = \\\\ \\frac{2\\cdot (2x-3)}{1} \\\\ 2(2x-3).\\end{aligned}\n$$\n\n**Note:** There is a shortcut! We can just \"cancel\" a $2$ from the numerator and denominator.\n\n$$\n\\begin{aligned}\\frac{4(2x-3)}{2} & = \\\\ \\frac{2\\cdot 2\\cdot (2x-3)}{2} & = \\\\ \\frac{\\cancel{2}\\cdot 2\\cdot (2x-3)}{\\cancel{2}} & = \\\\ \\frac{2\\cdot (2x-3)}{1} & = \\\\ 2(2x-3).\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054920 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} [:db/retract 17592186124999 :question/answer-fields 17592186122594] {:db/id 17592186124449 :knowledge-point/questions ["question-87b5b3e0-dcda-563d-b53d-0df7f66aab12"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124450 :knowledge-point/questions ["question-0c2a62d8-6d93-5394-bb23-b474c6edf899"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0c2a62d8-6d93-5394-bb23-b474c6edf899" :question/id #uuid "0c2a62d8-6d93-5394-bb23-b474c6edf899" :question/math-academy-id "q-65128" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\nI. ${f}_{x}(x,y)=\\operatorname{cos}⁡x-\\operatorname{sin}⁡y$ and ${f}_{y}(x,y)=\\operatorname{cos}⁡y-\\operatorname{sin}⁡x$\n\nII. ${f}_{x}(x,y)=y{e}^{xy}$ and ${f}_{y}(x,y)=x{e}^{xy}$\n\nIII. ${f}_{x}(x,y)=2y+1$ and ${f}_{y}(x,y)=2y+1$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)=-\\operatorname{cos}⁡y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\operatorname{cos}⁡y-\\operatorname{sin}⁡x)=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(y{e}^{xy}) \\\\  & ={e}^{xy}+xy{e}^{xy} \\\\  & ={e}^{xy}(1+xy) \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x{e}^{xy}) \\\\  & ={e}^{xy}+xy{e}^{xy} \\\\  & ={e}^{xy}(1+xy).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2y+1)=2 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2y+1)=0\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$,  the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II only'." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ff4a0306-bebb-5a0b-88e8-580bcd8a3741"] :db/ensure [:question/validate]} {:db/id "answer-field-ff4a0306-bebb-5a0b-88e8-580bcd8a3741" :answer-field/id #uuid "ff4a0306-bebb-5a0b-88e8-580bcd8a3741" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd42a3d6-7453-56cc-b6fd-7e6f716d0a3c" :answer-field/choices ["answer-002afc6b-3ae6-5e4d-9e87-6404be2be05d" "answer-d3510268-8c4c-529e-8b03-2fd8c635e27b" "answer-dfc862f5-359e-590e-930c-858b88ff0363" "answer-dd42a3d6-7453-56cc-b6fd-7e6f716d0a3c" "answer-a95258ee-6056-5703-bec4-79d09d5e79de"] :db/ensure [:answer-field/validate]} {:db/id "answer-002afc6b-3ae6-5e4d-9e87-6404be2be05d" :answer/id #uuid "002afc6b-3ae6-5e4d-9e87-6404be2be05d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d3510268-8c4c-529e-8b03-2fd8c635e27b" :answer/id #uuid "d3510268-8c4c-529e-8b03-2fd8c635e27b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-dfc862f5-359e-590e-930c-858b88ff0363" :answer/id #uuid "dfc862f5-359e-590e-930c-858b88ff0363" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-dd42a3d6-7453-56cc-b6fd-7e6f716d0a3c" :answer/id #uuid "dd42a3d6-7453-56cc-b6fd-7e6f716d0a3c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-a95258ee-6056-5703-bec4-79d09d5e79de" :answer/id #uuid "a95258ee-6056-5703-bec4-79d09d5e79de" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-87b5b3e0-dcda-563d-b53d-0df7f66aab12" :question/id #uuid "87b5b3e0-dcda-563d-b53d-0df7f66aab12" :question/math-academy-id "q-65129" :question/problem "Given that the function $f(x,y)$ and all of its higher-order partial derivatives are continuous on an open set $U,$ evaluate ${f}_{yxy}(1,\\frac{\\pi }{2})$ if ${f}_{yy}(x,y)=-{x}^{2}\\operatorname{cos}⁡(xy).$" :question/worked-solution "As the higher-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal. Hence, we have\n\n$$\n\\begin{aligned}{f}_{yxy}(x,y) & ={f}_{yyx}(x,y) \\\\  & =\\frac{∂}{∂x}({f}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-{x}^{2}\\operatorname{cos}⁡(xy)) \\\\  & =-2x\\cdot \\operatorname{cos}⁡(xy)+(-{x}^{2})\\cdot (-y\\operatorname{sin}⁡(xy)) \\\\  & =-2x\\operatorname{cos}⁡(xy)+{x}^{2}y\\operatorname{sin}⁡(xy).\\end{aligned}\n$$\n\nNow, we evaluate the partial derivative at the point $(1,\\frac{\\pi }{2}):$\n\n$$\n{f}_{yxy}(1,\\frac{\\pi }{2})=-2(1)\\operatorname{cos}⁡(1\\cdot \\frac{\\pi }{2})+(1)^{2}\\cdot \\frac{\\pi }{2}\\cdot \\operatorname{sin}⁡(1\\cdot \\frac{\\pi }{2})=\\frac{\\pi }{2}\\,\\,\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-50f2ed47-78e7-59d4-a40f-57fb0a2f9402"] :db/ensure [:question/validate]} {:db/id "answer-field-50f2ed47-78e7-59d4-a40f-57fb0a2f9402" :answer-field/id #uuid "50f2ed47-78e7-59d4-a40f-57fb0a2f9402" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-23f5ce90-f71e-52dc-8beb-408f7faeaa27" :answer-field/choices ["answer-4a8aa56b-9b6e-5e43-81d5-2db6976aeebe" "answer-48a543dd-5073-5eff-a396-7a9535994086" "answer-684701da-26b3-560c-8537-f88180932fce" "answer-23f5ce90-f71e-52dc-8beb-408f7faeaa27" "answer-eeb1a895-8ba1-56dc-9e30-7108e7d80a9e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a8aa56b-9b6e-5e43-81d5-2db6976aeebe" :answer/id #uuid "4a8aa56b-9b6e-5e43-81d5-2db6976aeebe" :answer/type :answer.type/math :answer/value "-2+\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-48a543dd-5073-5eff-a396-7a9535994086" :answer/id #uuid "48a543dd-5073-5eff-a396-7a9535994086" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-684701da-26b3-560c-8537-f88180932fce" :answer/id #uuid "684701da-26b3-560c-8537-f88180932fce" :answer/type :answer.type/math :answer/value "2+\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-23f5ce90-f71e-52dc-8beb-408f7faeaa27" :answer/id #uuid "23f5ce90-f71e-52dc-8beb-408f7faeaa27" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-eeb1a895-8ba1-56dc-9e30-7108e7d80a9e" :answer/id #uuid "eeb1a895-8ba1-56dc-9e30-7108e7d80a9e" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} [:db/retract 17592186124100 :answer-field/choices 17592186124101] [:db/retract 17592186124100 :answer-field/choices 17592186124102] [:db/retract 17592186124100 :answer-field/choices 17592186124104] [:db/retract 17592186124100 :answer-field/choices 17592186124105] [:db/retract 17592186122366 :answer-field/choices 17592186122368] [:db/retract 17592186122366 :answer-field/choices 17592186122370] [:db/retract 17592186122366 :answer-field/choices 17592186122371] [:db/retract 17592186122366 :answer-field/choices 17592186122367] {:db/id 17592186124469 :knowledge-point/questions ["question-b5969d89-d7a6-55d3-97d8-1ebc95c98dd0" "question-aa703c37-d0d3-5fc5-8021-cece98eb14f3" "question-2ad8b1a6-b8e1-5739-bfbc-4544e317c6e3" "question-608efbbd-2dcf-58ab-9644-3b94a19193a4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124470 :knowledge-point/questions ["question-f5e2cc69-b41b-55a6-ba1d-f0aa44f4db50" "question-23fc0071-5d5d-57b9-949a-5e0f696a08ef"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124593 :knowledge-point/questions ["question-4fd8f651-0427-56fb-a0df-c03def6f1c03" "question-fc2162e8-e3d2-5905-8722-73fb096c219a" "question-0ccfc773-296b-50db-8da8-c0588c64c45e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124471 :knowledge-point/questions ["question-99c3ab32-c332-5aab-98f3-193b3fead123" "question-68446125-1b3e-53ed-aad0-d4e0129128a8" "question-c6083028-59c6-57ef-95a8-453f1847efa9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b5969d89-d7a6-55d3-97d8-1ebc95c98dd0" :question/id #uuid "b5969d89-d7a6-55d3-97d8-1ebc95c98dd0" :question/math-academy-id "q-95053" :question/problem "If $f(x,y)={x}^{2}+xy$ and $r(t)=(t+1)\\,i-{t}^{2}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+xy)\\,i+\\frac{∂}{∂y}({x}^{2}+xy)\\,j \\\\  & =(2x+y)\\,i+x\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=t+1$ and $y=-{t}^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2t+2-{t}^{2})\\,i+(t+1)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(-{t}^{2})\\,j \\\\  & =\\,i-2t\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((2t+2-{t}^{2})\\,i+(t+1)\\,j)\\cdot (\\,i-2t\\,j) \\\\  & =2t+2-{t}^{2}-2t(t+1) \\\\  & =2t+2-{t}^{2}-2{t}^{2}-2t \\\\  & =2-3{t}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f5d24599-ab4c-5c66-8f82-5120438263f0"] :db/ensure [:question/validate]} {:db/id "answer-field-f5d24599-ab4c-5c66-8f82-5120438263f0" :answer-field/id #uuid "f5d24599-ab4c-5c66-8f82-5120438263f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c876a545-69bd-57fe-b996-cb8971e263d5" :answer-field/choices ["answer-446c6267-5187-59df-b71e-b14bacbbc752" "answer-c876a545-69bd-57fe-b996-cb8971e263d5" "answer-cb391fc8-c0cb-57ad-8f3d-ae952561b48a" "answer-032cc53a-d445-5e45-affb-dbc26bb23949" "answer-38580c3a-82d9-598a-afe3-0eb7825be631"] :db/ensure [:answer-field/validate]} {:db/id "answer-446c6267-5187-59df-b71e-b14bacbbc752" :answer/id #uuid "446c6267-5187-59df-b71e-b14bacbbc752" :answer/type :answer.type/math :answer/value "2+4t-3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c876a545-69bd-57fe-b996-cb8971e263d5" :answer/id #uuid "c876a545-69bd-57fe-b996-cb8971e263d5" :answer/type :answer.type/math :answer/value "2-3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-cb391fc8-c0cb-57ad-8f3d-ae952561b48a" :answer/id #uuid "cb391fc8-c0cb-57ad-8f3d-ae952561b48a" :answer/type :answer.type/math :answer/value "2-4t" :db/ensure [:answer/validate]} {:db/id "answer-032cc53a-d445-5e45-affb-dbc26bb23949" :answer/id #uuid "032cc53a-d445-5e45-affb-dbc26bb23949" :answer/type :answer.type/math :answer/value "3+3t-{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-38580c3a-82d9-598a-afe3-0eb7825be631" :answer/id #uuid "38580c3a-82d9-598a-afe3-0eb7825be631" :answer/type :answer.type/math :answer/value "4t-{t}^{2}" :db/ensure [:answer/validate]} {:db/id "question-aa703c37-d0d3-5fc5-8021-cece98eb14f3" :question/id #uuid "aa703c37-d0d3-5fc5-8021-cece98eb14f3" :question/math-academy-id "q-167406" :question/problem "If $f(x,y)={e}^{x-y}$ and $r(t)={t}^{2}\\,i-t\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}{e}^{x-y}\\,i+\\frac{∂}{∂y}{e}^{x-y}\\,j \\\\  & ={e}^{x-y}\\,i-{e}^{x-y}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2}$ and $y=-t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & ={e}^{{t}^{2}+t}\\,i-{e}^{{t}^{2}+t}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(-t)\\,j \\\\  & =2t\\,i-\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =({e}^{{t}^{2}+t}\\,i-{e}^{{t}^{2}+t}\\,j)\\cdot (2t\\,i-\\,j) \\\\  & ={e}^{{t}^{2}+t}\\cdot 2t+(-{e}^{{t}^{2}+t})\\cdot (-1) \\\\  & =(2t+1){e}^{{t}^{2}+t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8c59d1a9-7623-5670-96a8-dca459663150"] :db/ensure [:question/validate]} {:db/id "answer-field-8c59d1a9-7623-5670-96a8-dca459663150" :answer-field/id #uuid "8c59d1a9-7623-5670-96a8-dca459663150" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-571e0ae0-7b23-51f2-b237-5930ff5b4a90" :answer-field/choices ["answer-571e0ae0-7b23-51f2-b237-5930ff5b4a90" "answer-cc9e20ec-6a55-5371-95d9-8a1fc2f05681" "answer-15e8a119-89e7-5e83-8ece-e6e69dba1106" "answer-68fdb16f-c294-542e-b24f-3fcf75971b20" "answer-ba2b5ef5-5b34-543c-ac98-cc2b1b5278c2"] :db/ensure [:answer-field/validate]} {:db/id "answer-571e0ae0-7b23-51f2-b237-5930ff5b4a90" :answer/id #uuid "571e0ae0-7b23-51f2-b237-5930ff5b4a90" :answer/type :answer.type/math :answer/value "(2t+1){e}^{{t}^{2}+t}" :db/ensure [:answer/validate]} {:db/id "answer-cc9e20ec-6a55-5371-95d9-8a1fc2f05681" :answer/id #uuid "cc9e20ec-6a55-5371-95d9-8a1fc2f05681" :answer/type :answer.type/math :answer/value "(t+1){e}^{{t}^{2}-t}" :db/ensure [:answer/validate]} {:db/id "answer-15e8a119-89e7-5e83-8ece-e6e69dba1106" :answer/id #uuid "15e8a119-89e7-5e83-8ece-e6e69dba1106" :answer/type :answer.type/math :answer/value "(t-2){e}^{{t}^{2}+t}" :db/ensure [:answer/validate]} {:db/id "answer-68fdb16f-c294-542e-b24f-3fcf75971b20" :answer/id #uuid "68fdb16f-c294-542e-b24f-3fcf75971b20" :answer/type :answer.type/math :answer/value "2t{e}^{{t}^{2}+t}" :db/ensure [:answer/validate]} {:db/id "answer-ba2b5ef5-5b34-543c-ac98-cc2b1b5278c2" :answer/id #uuid "ba2b5ef5-5b34-543c-ac98-cc2b1b5278c2" :answer/type :answer.type/math :answer/value "{t}^{2}{e}^{{t}^{2}-t}" :db/ensure [:answer/validate]} {:db/id "question-2ad8b1a6-b8e1-5739-bfbc-4544e317c6e3" :question/id #uuid "2ad8b1a6-b8e1-5739-bfbc-4544e317c6e3" :question/math-academy-id "q-95055" :question/problem "If $f(x,y)=\\operatorname{ln}⁡({x}^{3}y)$ and $r(t)=t\\,i+{e}^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}\\operatorname{ln}⁡({x}^{3}y)\\,i+\\frac{∂}{∂y}\\operatorname{ln}⁡({x}^{3}y)\\,j \\\\  & =\\frac{3{x}^{2}y}{{x}^{3}y}\\,i+\\frac{{x}^{3}}{{x}^{3}y}\\,j \\\\  & =\\frac{3}{x}\\,i+\\frac{1}{y}\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=t$ and $y={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{3}{t}\\,i+\\frac{1}{{e}^{t}}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j \\\\  & =\\,i+{e}^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{3}{t}\\,i+\\frac{1}{{e}^{t}}\\,j)\\cdot (\\,i+{e}^{t}\\,j) \\\\  & =\\frac{3}{t}+\\frac{{e}^{t}}{{e}^{t}} \\\\  & =\\frac{3}{t}+1 \\\\  & =\\frac{t+3}{t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-306c4e3a-7620-56d0-8ab5-267aba392210"] :db/ensure [:question/validate]} {:db/id "answer-field-306c4e3a-7620-56d0-8ab5-267aba392210" :answer-field/id #uuid "306c4e3a-7620-56d0-8ab5-267aba392210" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b44d800e-4a42-5329-8b39-02e75b4ca367" :answer-field/choices ["answer-5b802ceb-0898-5764-b40e-d7ea6a72486c" "answer-189f09ce-2bb2-5efc-97b0-05b2a4b3fbb1" "answer-b44d800e-4a42-5329-8b39-02e75b4ca367" "answer-65254441-20bf-539f-a01a-719a7b06e2d2" "answer-629e7fba-04e6-54e1-8d56-6ef59c0da0a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b802ceb-0898-5764-b40e-d7ea6a72486c" :answer/id #uuid "5b802ceb-0898-5764-b40e-d7ea6a72486c" :answer/type :answer.type/math :answer/value "3+{e}^{t}" :db/ensure [:answer/validate]} {:db/id "answer-189f09ce-2bb2-5efc-97b0-05b2a4b3fbb1" :answer/id #uuid "189f09ce-2bb2-5efc-97b0-05b2a4b3fbb1" :answer/type :answer.type/math :answer/value "\\frac{3{e}^{t}+t}{t{e}^{t}}" :db/ensure [:answer/validate]} {:db/id "answer-b44d800e-4a42-5329-8b39-02e75b4ca367" :answer/id #uuid "b44d800e-4a42-5329-8b39-02e75b4ca367" :answer/type :answer.type/math :answer/value "\\frac{t+3}{t}" :db/ensure [:answer/validate]} {:db/id "answer-65254441-20bf-539f-a01a-719a7b06e2d2" :answer/id #uuid "65254441-20bf-539f-a01a-719a7b06e2d2" :answer/type :answer.type/math :answer/value "\\frac{t{e}^{t}+3}{t}" :db/ensure [:answer/validate]} {:db/id "answer-629e7fba-04e6-54e1-8d56-6ef59c0da0a5" :answer/id #uuid "629e7fba-04e6-54e1-8d56-6ef59c0da0a5" :answer/type :answer.type/math :answer/value "\\frac{{e}^{t}+3}{{e}^{t}}" :db/ensure [:answer/validate]} {:db/id "question-608efbbd-2dcf-58ab-9644-3b94a19193a4" :question/id #uuid "608efbbd-2dcf-58ab-9644-3b94a19193a4" :question/math-academy-id "q-167407" :question/problem "If $f(x,y)=\\sqrt{xy}$ and $r(t)={t}^{3}\\,i+t\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(\\sqrt{xy})\\,i+\\frac{∂}{∂y}(\\sqrt{xy})\\,j \\\\  & =\\frac{\\sqrt{y}}{2\\sqrt{x}}\\,i+\\frac{\\sqrt{x}}{2\\sqrt{y}}\\,j\\text{ }\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{3}$ and $y=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{\\sqrt{t}}{2\\sqrt{{t}^{3}}}\\,i+\\frac{\\sqrt{{t}^{3}}}{2\\sqrt{t}}\\,j \\\\  & =\\frac{1}{2t}\\,i+\\frac{t}{2}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =3{t}^{2}\\,i+j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{1}{2t}\\,i+\\frac{t}{2}\\,j)\\cdot (3{t}^{2}\\,i+j) \\\\  & =\\frac{3{t}^{2}}{2t}+\\frac{t}{2} \\\\  & =\\frac{3}{2}t+\\frac{1}{2}t \\\\  & =2t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8891d227-4f4f-5b72-a172-ba46661cec18"] :db/ensure [:question/validate]} {:db/id "answer-field-8891d227-4f4f-5b72-a172-ba46661cec18" :answer-field/id #uuid "8891d227-4f4f-5b72-a172-ba46661cec18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ceaa9304-14fa-5f01-a4f8-01269d44b5c4" :answer-field/choices ["answer-ceaa9304-14fa-5f01-a4f8-01269d44b5c4" "answer-5e27ed02-56c4-5c23-9e9b-e839f9be174b" "answer-f416028e-1e7f-5522-8bc3-1c8b6b7f478d" "answer-7d0375e9-56a8-5366-9c6f-1cacf6261aca" "answer-275babd6-f291-5f51-9ada-2d31636b381f"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceaa9304-14fa-5f01-a4f8-01269d44b5c4" :answer/id #uuid "ceaa9304-14fa-5f01-a4f8-01269d44b5c4" :answer/type :answer.type/math :answer/value "2t" :db/ensure [:answer/validate]} {:db/id "answer-5e27ed02-56c4-5c23-9e9b-e839f9be174b" :answer/id #uuid "5e27ed02-56c4-5c23-9e9b-e839f9be174b" :answer/type :answer.type/math :answer/value "\\frac{3t}{2}" :db/ensure [:answer/validate]} {:db/id "answer-f416028e-1e7f-5522-8bc3-1c8b6b7f478d" :answer/id #uuid "f416028e-1e7f-5522-8bc3-1c8b6b7f478d" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{t}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7d0375e9-56a8-5366-9c6f-1cacf6261aca" :answer/id #uuid "7d0375e9-56a8-5366-9c6f-1cacf6261aca" :answer/type :answer.type/math :answer/value "\\frac{t}{2}" :db/ensure [:answer/validate]} {:db/id "answer-275babd6-f291-5f51-9ada-2d31636b381f" :answer/id #uuid "275babd6-f291-5f51-9ada-2d31636b381f" :answer/type :answer.type/math :answer/value "\\sqrt{t}" :db/ensure [:answer/validate]} {:db/id 17592186125250 :question/problem "If $f(x,y,z)=z(x+y)$ and $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(z(x+y))\\,i+\\frac{∂}{∂y}(z(x+y))\\,j+\\frac{∂}{∂z}(z(x+y))\\,k \\\\  & =z\\,i+z\\,j+(x+y)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,$ $y=\\operatorname{cos}⁡t$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & ={e}^{t}\\,i+{e}^{t}\\,j+(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =({e}^{t}\\,i+{e}^{t}\\,j+(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\,k)\\cdot (\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+{e}^{t}\\,k) \\\\  & ={e}^{t}\\cdot \\operatorname{cos}⁡t+{e}^{t}\\cdot (-\\operatorname{sin}⁡t)+(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\cdot {e}^{t} \\\\  & ={e}^{t}\\operatorname{cos}⁡t-{e}^{t}\\operatorname{sin}⁡t+{e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\  & =2{e}^{t}\\operatorname{cos}⁡t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186124100 :answer-field/correct "answer-eef6c2ca-b384-52f9-bf10-2db701968ad9" :answer-field/choices ["answer-ae4d169e-765b-5d10-9ef3-ea60b0437938" "answer-8ab97f80-a525-5bbe-a6b4-4f61835de51f" "answer-eef6c2ca-b384-52f9-bf10-2db701968ad9" "answer-e711ca65-092d-53a1-9492-fad3c11a523c"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae4d169e-765b-5d10-9ef3-ea60b0437938" :answer/id #uuid "ae4d169e-765b-5d10-9ef3-ea60b0437938" :answer/type :answer.type/math :answer/value "2{e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)" :db/ensure [:answer/validate]} {:db/id "answer-8ab97f80-a525-5bbe-a6b4-4f61835de51f" :answer/id #uuid "8ab97f80-a525-5bbe-a6b4-4f61835de51f" :answer/type :answer.type/math :answer/value "2{e}^{t}+\\operatorname{sin}⁡t+\\operatorname{cos}⁡t" :db/ensure [:answer/validate]} {:db/id "answer-eef6c2ca-b384-52f9-bf10-2db701968ad9" :answer/id #uuid "eef6c2ca-b384-52f9-bf10-2db701968ad9" :answer/type :answer.type/math :answer/value "2{e}^{t}\\operatorname{cos}⁡t" :db/ensure [:answer/validate]} {:db/id "answer-e711ca65-092d-53a1-9492-fad3c11a523c" :answer/id #uuid "e711ca65-092d-53a1-9492-fad3c11a523c" :answer/type :answer.type/math :answer/value "2{e}^{t}\\operatorname{sin}⁡t" :db/ensure [:answer/validate]} {:db/id "question-f5e2cc69-b41b-55a6-ba1d-f0aa44f4db50" :question/id #uuid "f5e2cc69-b41b-55a6-ba1d-f0aa44f4db50" :question/math-academy-id "q-95143" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)$ and $r(t)=t\\,i+{t}^{2}\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)\\,i+\\frac{∂}{∂y}\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)\\,j+\\frac{∂}{∂z}\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)\\,k \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}\\,i-\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\operatorname{sin}⁡z}{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}\\,j+\\frac{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{cos}⁡z}{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}\\,k \\\\  & =\\operatorname{cot}⁡x\\,i-\\operatorname{tan}⁡y\\,j+\\operatorname{cot}⁡z\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,$ $y={t}^{2}$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\operatorname{cot}⁡t\\,i-\\operatorname{tan}⁡{t}^{2}\\,j+\\operatorname{cot}⁡{e}^{t}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =i+2t\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\operatorname{cot}⁡t\\,i-\\operatorname{tan}⁡{t}^{2}\\,j+\\operatorname{cot}⁡{e}^{t}\\,k)\\cdot (i+2t\\,j+{e}^{t}\\,k) \\\\  & =\\operatorname{cot}⁡t-2t\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{cot}⁡{e}^{t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-73405ecf-58c2-52c0-a13d-a399aaa1b75c"] :db/ensure [:question/validate]} {:db/id "answer-field-73405ecf-58c2-52c0-a13d-a399aaa1b75c" :answer-field/id #uuid "73405ecf-58c2-52c0-a13d-a399aaa1b75c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bce18e25-d9a2-5b97-b848-b56b779ae552" :answer-field/choices ["answer-b34fbe3e-3237-5a50-aaa6-a8cad66ce7ef" "answer-bce18e25-d9a2-5b97-b848-b56b779ae552" "answer-a28056a9-f916-52a5-9c57-bf67a29a290d" "answer-1a625792-3ebb-5931-8a2d-6a88c5f87ba5" "answer-2f3fec76-0a6e-5e27-983b-461d88932bfb"] :db/ensure [:answer-field/validate]} {:db/id "answer-b34fbe3e-3237-5a50-aaa6-a8cad66ce7ef" :answer/id #uuid "b34fbe3e-3237-5a50-aaa6-a8cad66ce7ef" :answer/type :answer.type/math :answer/value "2\\operatorname{cot}⁡t-\\operatorname{tan}⁡{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-bce18e25-d9a2-5b97-b848-b56b779ae552" :answer/id #uuid "bce18e25-d9a2-5b97-b848-b56b779ae552" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡t-2t\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{cot}⁡{e}^{t}" :db/ensure [:answer/validate]} {:db/id "answer-a28056a9-f916-52a5-9c57-bf67a29a290d" :answer/id #uuid "a28056a9-f916-52a5-9c57-bf67a29a290d" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡t-\\operatorname{tan}⁡{t}^{2}+\\operatorname{cot}⁡{e}^{t}" :db/ensure [:answer/validate]} {:db/id "answer-1a625792-3ebb-5931-8a2d-6a88c5f87ba5" :answer/id #uuid "1a625792-3ebb-5931-8a2d-6a88c5f87ba5" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡{e}^{t}-2\\operatorname{tan}⁡{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2f3fec76-0a6e-5e27-983b-461d88932bfb" :answer/id #uuid "2f3fec76-0a6e-5e27-983b-461d88932bfb" :answer/type :answer.type/math :answer/value "t\\operatorname{cot}⁡t+{t}^{2}\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{tan}⁡{e}^{t}" :db/ensure [:answer/validate]} {:db/id "question-23fc0071-5d5d-57b9-949a-5e0f696a08ef" :question/id #uuid "23fc0071-5d5d-57b9-949a-5e0f696a08ef" :question/math-academy-id "q-95074" :question/problem "If $f(x,y,z)={x}^{2}+{y}^{2}+2{z}^{2}$ and $r(t)=(t+1)\\,i+(t-1)\\,j+\\operatorname{sin}⁡t\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}+2{z}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2}+2{z}^{2})\\,j+\\frac{∂}{∂z}({x}^{2}+{y}^{2}+2{z}^{2})\\,k \\\\  & =2x\\,i+2y\\,j+4z\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t+1,$ $y=t-1$ and $z=\\operatorname{sin}⁡t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =2(t+1)\\,i+2(t-1)\\,j+4\\operatorname{sin}⁡t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =i+j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2(t+1)\\,i+2(t-1)\\,j+4\\operatorname{sin}⁡t\\,k)\\cdot (i+j+\\operatorname{cos}⁡t\\,k) \\\\  & =2(t+1)\\cdot 1+2(t-1)\\cdot 1+4\\operatorname{sin}⁡t\\cdot \\operatorname{cos}⁡t \\\\  & =2t+2+2t-2+4\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =4(t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-65e8ce36-6bdd-5ffc-86d9-2cca52842880"] :db/ensure [:question/validate]} {:db/id "answer-field-65e8ce36-6bdd-5ffc-86d9-2cca52842880" :answer-field/id #uuid "65e8ce36-6bdd-5ffc-86d9-2cca52842880" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c3353af3-19ba-5e14-a733-a22abed74ffe" :answer-field/choices ["answer-800531bb-e5bf-57d0-94df-bfb46de70ee9" "answer-87ac30df-06f9-515c-b483-8fa371168b08" "answer-49a16002-fb70-57d8-b56c-e846ae55b5f1" "answer-c3353af3-19ba-5e14-a733-a22abed74ffe" "answer-eaa24879-c05e-53a3-b066-9afb3802f261"] :db/ensure [:answer-field/validate]} {:db/id "answer-800531bb-e5bf-57d0-94df-bfb46de70ee9" :answer/id #uuid "800531bb-e5bf-57d0-94df-bfb46de70ee9" :answer/type :answer.type/math :answer/value "2(2{t}^{2}-\\operatorname{sin}⁡t)" :db/ensure [:answer/validate]} {:db/id "answer-87ac30df-06f9-515c-b483-8fa371168b08" :answer/id #uuid "87ac30df-06f9-515c-b483-8fa371168b08" :answer/type :answer.type/math :answer/value "2({t}^{2}-1)+\\operatorname{cos}⁡t" :db/ensure [:answer/validate]} {:db/id "answer-49a16002-fb70-57d8-b56c-e846ae55b5f1" :answer/id #uuid "49a16002-fb70-57d8-b56c-e846ae55b5f1" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡2t" :db/ensure [:answer/validate]} {:db/id "answer-c3353af3-19ba-5e14-a733-a22abed74ffe" :answer/id #uuid "c3353af3-19ba-5e14-a733-a22abed74ffe" :answer/type :answer.type/math :answer/value "4(t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t)" :db/ensure [:answer/validate]} {:db/id "answer-eaa24879-c05e-53a3-b066-9afb3802f261" :answer/id #uuid "eaa24879-c05e-53a3-b066-9afb3802f261" :answer/type :answer.type/math :answer/value "t(1+\\operatorname{sin}⁡t\\operatorname{cos}⁡t)" :db/ensure [:answer/validate]} {:db/id "question-4fd8f651-0427-56fb-a0df-c03def6f1c03" :question/id #uuid "4fd8f651-0427-56fb-a0df-c03def6f1c03" :question/math-academy-id "q-94874" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\sqrt{2}$ given that $∇f(x,y)=(\\operatorname{ln}⁡(x+y)+\\frac{x}{x+y})i+\\frac{x}{x+y}\\,j$ and $r(t)=2t\\,i+(1-2t)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=(\\operatorname{ln}⁡(x+y)+\\frac{x}{x+y})i+\\frac{x}{x+y}\\,j.\n$$\n\nFirst, we substitute $x=2t$ and $y=1-2t$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(\\operatorname{ln}⁡(2t+1-2t)+\\frac{2t}{2t+1-2t})i+\\frac{2t}{2t+1-2t}\\,j \\\\  & =2t\\,i+2t\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(1-2t)\\,j \\\\  & =2\\,i+(-2)\\,j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2t\\,i+2t\\,j)\\cdot (2\\,i+(-2)\\,j) \\\\  & =2t\\cdot 2+2t\\cdot (-2) \\\\  & =4t-4t \\\\  & =0.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=\\sqrt{2},$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\sqrt{2}))] & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-87c2325f-89dd-5faa-85c5-6f78e19a16ca"] :db/ensure [:question/validate]} {:db/id "answer-field-87c2325f-89dd-5faa-85c5-6f78e19a16ca" :answer-field/id #uuid "87c2325f-89dd-5faa-85c5-6f78e19a16ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5a40eb2d-45dd-5e4f-bfc4-ce7f311e8219" :answer-field/choices ["answer-5a40eb2d-45dd-5e4f-bfc4-ce7f311e8219" "answer-10678e1e-886a-5a4e-b7c2-d43590d9da42" "answer-3c735127-556e-521a-a97e-a560cb0e5a28" "answer-5d6b668e-9dfd-55fa-bd2b-afca9acc2e9a" "answer-3bf77277-da5c-508b-b19f-23412ad069a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a40eb2d-45dd-5e4f-bfc4-ce7f311e8219" :answer/id #uuid "5a40eb2d-45dd-5e4f-bfc4-ce7f311e8219" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-10678e1e-886a-5a4e-b7c2-d43590d9da42" :answer/id #uuid "10678e1e-886a-5a4e-b7c2-d43590d9da42" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-3c735127-556e-521a-a97e-a560cb0e5a28" :answer/id #uuid "3c735127-556e-521a-a97e-a560cb0e5a28" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{2}-1" :db/ensure [:answer/validate]} {:db/id "answer-5d6b668e-9dfd-55fa-bd2b-afca9acc2e9a" :answer/id #uuid "5d6b668e-9dfd-55fa-bd2b-afca9acc2e9a" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\sqrt{2}+1)" :db/ensure [:answer/validate]} {:db/id "answer-3bf77277-da5c-508b-b19f-23412ad069a7" :answer/id #uuid "3bf77277-da5c-508b-b19f-23412ad069a7" :answer/type :answer.type/math :answer/value "\\sqrt{2}-1" :db/ensure [:answer/validate]} {:db/id "question-fc2162e8-e3d2-5905-8722-73fb096c219a" :question/id #uuid "fc2162e8-e3d2-5905-8722-73fb096c219a" :question/math-academy-id "q-94880" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=1$ given that $∇f(x,y)=\\operatorname{arctan}⁡y\\,i+\\frac{x}{1+{y}^{2}}\\,j$ and $r(t)=({t}^{2}+1)\\,i+t\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=\\operatorname{arctan}⁡y\\,i+\\frac{x}{1+{y}^{2}}\\,j.\n$$\n\nFirst, we substitute $x={t}^{2}+1$ and $y=t$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\operatorname{arctan}⁡t\\,i+\\frac{{t}^{2}+1}{1+{t}^{2}}\\,j \\\\  & =\\operatorname{arctan}⁡t\\,i+j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =2t\\,i+j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\operatorname{arctan}⁡t\\,i+j)\\cdot (2t\\,i+j) \\\\  & =\\operatorname{arctan}⁡t\\cdot 2t+1\\cdot 1 \\\\  & =2t\\operatorname{arctan}⁡t+1.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(1))] & =2(1)\\operatorname{arctan}⁡1+1 \\\\  & =2\\cdot \\frac{\\pi }{4}+1 \\\\  & =\\frac{\\pi }{2}+1 \\\\  & =\\frac{\\pi +2}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5689c88b-fb4c-5488-beac-e34a9824569a"] :db/ensure [:question/validate]} {:db/id "answer-field-5689c88b-fb4c-5488-beac-e34a9824569a" :answer-field/id #uuid "5689c88b-fb4c-5488-beac-e34a9824569a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c35cedf1-0de5-5562-b74c-d3e0a68630e7" :answer-field/choices ["answer-0e692ef2-7942-50c0-987c-003e0499c7d1" "answer-7ca40bf8-6377-5d1a-9803-7cbf03f171f3" "answer-c35cedf1-0de5-5562-b74c-d3e0a68630e7" "answer-fc35db42-0a91-517b-8f1b-307df57fe44c" "answer-5dbb788f-4b96-5fa4-a950-81307ab26f6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-0e692ef2-7942-50c0-987c-003e0499c7d1" :answer/id #uuid "0e692ef2-7942-50c0-987c-003e0499c7d1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-7ca40bf8-6377-5d1a-9803-7cbf03f171f3" :answer/id #uuid "7ca40bf8-6377-5d1a-9803-7cbf03f171f3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-c35cedf1-0de5-5562-b74c-d3e0a68630e7" :answer/id #uuid "c35cedf1-0de5-5562-b74c-d3e0a68630e7" :answer/type :answer.type/math :answer/value "\\frac{\\pi +2}{2}" :db/ensure [:answer/validate]} {:db/id "answer-fc35db42-0a91-517b-8f1b-307df57fe44c" :answer/id #uuid "fc35db42-0a91-517b-8f1b-307df57fe44c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-5dbb788f-4b96-5fa4-a950-81307ab26f6a" :answer/id #uuid "5dbb788f-4b96-5fa4-a950-81307ab26f6a" :answer/type :answer.type/math :answer/value "{\\pi }^{2}+1" :db/ensure [:answer/validate]} {:db/id "question-0ccfc773-296b-50db-8da8-c0588c64c45e" :question/id #uuid "0ccfc773-296b-50db-8da8-c0588c64c45e" :question/math-academy-id "q-94871" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=-1$ given that $∇f(x,y)=y{e}^{xy}\\,i+(x{e}^{xy}+2y)\\,j$ and $r(t)=(t+1)\\,i+(t-1)\\,j.$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nIn addition, we've been given that\n\n$$\n∇f(x,y)=y{e}^{xy}\\,i+(x{e}^{xy}+2y)\\,j.\n$$\n\nFirst, we substitute $x=t+1$ and $y=t-1$ into $∇f(x,y)$ to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(t-1){e}^{(t+1)(t-1)}\\,i+((t+1){e}^{(t+1)(t-1)}+2(t-1))\\,j \\\\  & =(t-1){e}^{{t}^{2}-1}\\,i+((t+1){e}^{{t}^{2}-1}+2t-2)\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,j \\\\  & =i+j.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((t-1){e}^{{t}^{2}-1}\\,i+((t+1){e}^{{t}^{2}-1}+2t-2)\\,j)\\cdot (i+j) \\\\  & =(t-1){e}^{{t}^{2}-1}\\cdot 1+((t+1){e}^{{t}^{2}-1}+2t-2)\\cdot 1 \\\\  & =(t-1){e}^{{t}^{2}-1}+(t+1){e}^{{t}^{2}-1}+2t-2 \\\\  & =2t{e}^{{t}^{2}-1}+2t-2.\\end{aligned}\n$$\n\nFinally, evaluating the above at $t=-1,$ we obtain\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(-1))] & =2(-1){e}^{(-1)^{2}-1}+2(-1)-2 \\\\  & =-2-2-2 \\\\  & =-6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-35243cd2-2483-5ad0-842a-67891f04a244"] :db/ensure [:question/validate]} {:db/id "answer-field-35243cd2-2483-5ad0-842a-67891f04a244" :answer-field/id #uuid "35243cd2-2483-5ad0-842a-67891f04a244" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4783f08a-d1dc-5e36-a5c3-01e18e5e73b1" :answer-field/choices ["answer-4783f08a-d1dc-5e36-a5c3-01e18e5e73b1" "answer-6acc7f99-e086-5514-b8e6-83a4c9ef8720" "answer-97ef8f60-6130-5ffd-8c09-836902b3e0e3" "answer-5983345c-db95-5ace-9463-67aa96a3fe71" "answer-1600e78f-067b-5159-9df5-0a07460bd35e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4783f08a-d1dc-5e36-a5c3-01e18e5e73b1" :answer/id #uuid "4783f08a-d1dc-5e36-a5c3-01e18e5e73b1" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-6acc7f99-e086-5514-b8e6-83a4c9ef8720" :answer/id #uuid "6acc7f99-e086-5514-b8e6-83a4c9ef8720" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-97ef8f60-6130-5ffd-8c09-836902b3e0e3" :answer/id #uuid "97ef8f60-6130-5ffd-8c09-836902b3e0e3" :answer/type :answer.type/math :answer/value "3-2{e}^{-1}" :db/ensure [:answer/validate]} {:db/id "answer-5983345c-db95-5ace-9463-67aa96a3fe71" :answer/id #uuid "5983345c-db95-5ace-9463-67aa96a3fe71" :answer/type :answer.type/math :answer/value "4e+7" :db/ensure [:answer/validate]} {:db/id "answer-1600e78f-067b-5159-9df5-0a07460bd35e" :answer/id #uuid "1600e78f-067b-5159-9df5-0a07460bd35e" :answer/type :answer.type/math :answer/value "{e}^{-1}+3" :db/ensure [:answer/validate]} {:db/id "question-99c3ab32-c332-5aab-98f3-193b3fead123" :question/id #uuid "99c3ab32-c332-5aab-98f3-193b3fead123" :question/math-academy-id "q-167500" :question/problem "Compute the rate of change of the function $f(x,y,z)=\\operatorname{cos}⁡(xy+z)$ with respect to $t$ along the curve $r(t)=⟨{t}^{2},\\frac{1}{t},t⟩$ at the point $t=\\frac{\\pi }{4}.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{cos}⁡(xy+z)),\\frac{∂}{∂y}(\\operatorname{cos}⁡(xy+z)),\\frac{∂}{∂z}(\\operatorname{cos}⁡(xy+z))⟩ \\\\  & =⟨-y\\operatorname{sin}⁡(xy+z),-x\\operatorname{sin}⁡(xy+z),-\\operatorname{sin}⁡(xy+z)⟩\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2},y=\\frac{1}{t},$ and $z=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨-\\frac{1}{t}\\operatorname{sin}⁡(2t),-{t}^{2}\\operatorname{sin}⁡(2t),-\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t}),\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨2t,-\\frac{1}{{t}^{2}},1⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨-\\frac{1}{t}\\operatorname{sin}⁡(2t),-{t}^{2}\\operatorname{sin}⁡(2t),-\\operatorname{sin}⁡(2t)⟩\\cdot ⟨2t,-\\frac{1}{{t}^{2}},1⟩ \\\\  & =(-\\frac{1}{t}\\operatorname{sin}⁡(2t))\\cdot 2t+(-{t}^{2}\\operatorname{sin}⁡(2t))\\cdot (-\\frac{1}{{t}^{2}})+(-\\operatorname{sin}⁡(2t))\\cdot 1 \\\\  & =-2\\operatorname{sin}⁡(2t)+\\operatorname{sin}⁡(2t)-\\operatorname{sin}⁡(2t) \\\\  & =-2\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=\\frac{\\pi }{4}$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(\\frac{\\pi }{4}))] & =-2\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})=-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ab9b2392-4e70-5610-9864-41016bfde623"] :db/ensure [:question/validate]} {:db/id "answer-field-ab9b2392-4e70-5610-9864-41016bfde623" :answer-field/id #uuid "ab9b2392-4e70-5610-9864-41016bfde623" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e9ac26e-5d8d-5f86-b225-32abc20a36ea" :answer-field/choices ["answer-8e9ac26e-5d8d-5f86-b225-32abc20a36ea" "answer-caa5e437-184f-52d9-8cfa-224935e09da8" "answer-0ed77687-b07d-532f-8400-2a71d4a5ad46" "answer-74be835c-e26b-5172-ac8b-75460bf573b8" "answer-c5a561f8-22fa-5008-be18-18d377fa405a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e9ac26e-5d8d-5f86-b225-32abc20a36ea" :answer/id #uuid "8e9ac26e-5d8d-5f86-b225-32abc20a36ea" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-caa5e437-184f-52d9-8cfa-224935e09da8" :answer/id #uuid "caa5e437-184f-52d9-8cfa-224935e09da8" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-0ed77687-b07d-532f-8400-2a71d4a5ad46" :answer/id #uuid "0ed77687-b07d-532f-8400-2a71d4a5ad46" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-74be835c-e26b-5172-ac8b-75460bf573b8" :answer/id #uuid "74be835c-e26b-5172-ac8b-75460bf573b8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-c5a561f8-22fa-5008-be18-18d377fa405a" :answer/id #uuid "c5a561f8-22fa-5008-be18-18d377fa405a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-68446125-1b3e-53ed-aad0-d4e0129128a8" :question/id #uuid "68446125-1b3e-53ed-aad0-d4e0129128a8" :question/math-academy-id "q-94885" :question/problem "Compute the rate of change of the function $f(x,y)=\\operatorname{arctan}⁡(x+y)$ with respect to $t$ along the curve $r(t)=⟨2t,3t⟩$ at the point $t=1.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{arctan}⁡(x+y)),\\frac{∂}{∂y}(\\operatorname{arctan}⁡(x+y))⟩ \\\\  & =⟨\\frac{1}{1+(x+y)^{2}},\\frac{1}{1+(x+y)^{2}}⟩\\end{aligned}\n$$\n\nNext, we substitute $x=2t$ and $y=3t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨\\frac{1}{1+(2t+3t)^{2}},\\frac{1}{1+(2t+3t)^{2}}⟩ \\\\  & =⟨\\frac{1}{1+(5t)^{2}},\\frac{1}{1+(5t)^{2}}⟩ \\\\  & =⟨\\frac{1}{1+25{t}^{2}},\\frac{1}{1+25{t}^{2}}⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\frac{\\text{d}}{\\text{d}t}(3t)⟩ \\\\  & =⟨2,3⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨\\frac{1}{1+25{t}^{2}},\\frac{1}{1+25{t}^{2}}⟩\\cdot ⟨2,3⟩ \\\\  & =\\frac{1}{1+25{t}^{2}}\\cdot 2+\\frac{1}{1+25{t}^{2}}\\cdot 3 \\\\  & =\\frac{5}{1+25{t}^{2}}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=1$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(1))] & =\\frac{5}{1+25(1)^{2}} \\\\  & =\\frac{5}{1+25} \\\\  & =\\frac{5}{26}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a6277da0-e2f4-5895-b1b1-64bd47ad216a"] :db/ensure [:question/validate]} {:db/id "answer-field-a6277da0-e2f4-5895-b1b1-64bd47ad216a" :answer-field/id #uuid "a6277da0-e2f4-5895-b1b1-64bd47ad216a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-49414ddc-847d-5122-866b-0471fb4d5ffe" :answer-field/choices ["answer-85155c3e-a79b-505c-a718-14f3a3535182" "answer-49414ddc-847d-5122-866b-0471fb4d5ffe" "answer-0bcd1713-5761-536d-9be9-d421928b31e1" "answer-84115f86-a2a8-5473-a1e9-46a7c9992127" "answer-c9baafd5-f541-5292-ba8c-6d10037ebe04"] :db/ensure [:answer-field/validate]} {:db/id "answer-85155c3e-a79b-505c-a718-14f3a3535182" :answer/id #uuid "85155c3e-a79b-505c-a718-14f3a3535182" :answer/type :answer.type/math :answer/value "-\\frac{2}{13}" :db/ensure [:answer/validate]} {:db/id "answer-49414ddc-847d-5122-866b-0471fb4d5ffe" :answer/id #uuid "49414ddc-847d-5122-866b-0471fb4d5ffe" :answer/type :answer.type/math :answer/value "\\frac{5}{26}" :db/ensure [:answer/validate]} {:db/id "answer-0bcd1713-5761-536d-9be9-d421928b31e1" :answer/id #uuid "0bcd1713-5761-536d-9be9-d421928b31e1" :answer/type :answer.type/math :answer/value "\\frac{7}{13}" :db/ensure [:answer/validate]} {:db/id "answer-84115f86-a2a8-5473-a1e9-46a7c9992127" :answer/id #uuid "84115f86-a2a8-5473-a1e9-46a7c9992127" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}-1" :db/ensure [:answer/validate]} {:db/id "answer-c9baafd5-f541-5292-ba8c-6d10037ebe04" :answer/id #uuid "c9baafd5-f541-5292-ba8c-6d10037ebe04" :answer/type :answer.type/math :answer/value "\\pi +2" :db/ensure [:answer/validate]} {:db/id "question-c6083028-59c6-57ef-95a8-453f1847efa9" :question/id #uuid "c6083028-59c6-57ef-95a8-453f1847efa9" :question/math-academy-id "q-94889" :question/problem "Compute the rate of change of the function $f(x,y,z)=x{e}^{y}+z$ with respect to $t$ along the curve $r(t)=⟨4,\\operatorname{ln}⁡t,{e}^{t}⟩$ at the point $t=2.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(x{e}^{y}+z),\\frac{∂}{∂y}(x{e}^{y}+z),\\frac{∂}{∂z}(x{e}^{y}+z)⟩ \\\\  & =⟨{e}^{y},x{e}^{y},1⟩\\end{aligned}\n$$\n\nNext, we substitute $x=4,$ $y=\\operatorname{ln}⁡t$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨{e}^{\\operatorname{ln}⁡t},4{e}^{\\operatorname{ln}⁡t},1⟩ \\\\  & =⟨t,4t,1⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t),{e}^{t}⟩ \\\\  & =⟨0,\\frac{1}{t},{e}^{t}⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨t,4t,1⟩\\cdot ⟨0,\\frac{1}{t},{e}^{t}⟩ \\\\  & =t\\cdot 0+4t\\cdot \\frac{1}{t}+1\\cdot {e}^{t} \\\\  & =4+{e}^{t}.\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=2$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(2))] & =4+{e}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e0c8c22e-7185-5961-8bbd-34aaa39fe635"] :db/ensure [:question/validate]} {:db/id "answer-field-e0c8c22e-7185-5961-8bbd-34aaa39fe635" :answer-field/id #uuid "e0c8c22e-7185-5961-8bbd-34aaa39fe635" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8496cb5b-1076-5966-83ce-efcde2ebfdc8" :answer-field/choices ["answer-1ddc5bf6-629f-5b9e-90fa-568c3a604a38" "answer-f95e9936-472c-5c49-aaf5-2f9eb5565841" "answer-f6cb2b76-1e16-50f5-9407-75051eebbee1" "answer-8496cb5b-1076-5966-83ce-efcde2ebfdc8" "answer-eb2317df-8f4f-5424-b64c-0f6b65e5bd2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ddc5bf6-629f-5b9e-90fa-568c3a604a38" :answer/id #uuid "1ddc5bf6-629f-5b9e-90fa-568c3a604a38" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f95e9936-472c-5c49-aaf5-2f9eb5565841" :answer/id #uuid "f95e9936-472c-5c49-aaf5-2f9eb5565841" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f6cb2b76-1e16-50f5-9407-75051eebbee1" :answer/id #uuid "f6cb2b76-1e16-50f5-9407-75051eebbee1" :answer/type :answer.type/math :answer/value "2{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id "answer-8496cb5b-1076-5966-83ce-efcde2ebfdc8" :answer/id #uuid "8496cb5b-1076-5966-83ce-efcde2ebfdc8" :answer/type :answer.type/math :answer/value "4+{e}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-eb2317df-8f4f-5424-b64c-0f6b65e5bd2a" :answer/id #uuid "eb2317df-8f4f-5424-b64c-0f6b65e5bd2a" :answer/type :answer.type/math :answer/value "{e}^{2}-3" :db/ensure [:answer/validate]} {:db/id 17592186124961 :question/problem "Compute the rate of change of the function $f(x,y)=\\operatorname{sin}⁡(x-y)$ with respect to $t$ along the curve $r(t)=⟨2\\sqrt{t},4t⟩$ at the point $t=1.$" :question/worked-solution "The rate of change of $f(x,y,z)$ with respect to $t$ along the curve $r(t)$ is given by $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$ To calculate this, we can use the chain rule.\n\nThe chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{sin}⁡(x-y)),\\frac{∂}{∂y}(\\operatorname{sin}⁡(x-y))⟩ \\\\  & =⟨\\operatorname{cos}⁡(x-y),-\\operatorname{cos}⁡(x-y)⟩\\end{aligned}\n$$\n\nNext, we substitute $x=2\\sqrt{t}$ and $y=4t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =⟨\\operatorname{cos}⁡(2\\sqrt{t}-4t),-\\operatorname{cos}⁡(2\\sqrt{t}-4t)⟩\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{t}),\\frac{\\text{d}}{\\text{d}t}(4t)⟩ \\\\  & =⟨\\frac{1}{\\sqrt{t}},4⟩.\\end{aligned}\n$$\n\nApplying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =⟨\\operatorname{cos}⁡(2\\sqrt{t}-4t),-\\operatorname{cos}⁡(2\\sqrt{t}-4t)⟩\\cdot ⟨\\frac{1}{\\sqrt{t}},4⟩ \\\\  & =\\operatorname{cos}⁡(2\\sqrt{t}-4t)\\cdot \\frac{1}{\\sqrt{t}}-\\operatorname{cos}⁡(2\\sqrt{t}-4t)\\cdot 4 \\\\  & =\\operatorname{cos}⁡(2\\sqrt{t}-4t)(\\frac{1}{\\sqrt{t}}-4).\\end{aligned}\n$$\n\nTherefore, the rate of change of $f$ along the curve $r(t)$ at $t=1$ is\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(1))] & =\\operatorname{cos}⁡(2\\sqrt{1}-4\\cdot 1)(\\frac{1}{\\sqrt{1}}-4) \\\\  & =-3\\operatorname{cos}⁡2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186122366 :answer-field/correct "answer-5f8f5ab1-0a45-584c-b611-498bfb7e8229" :answer-field/choices ["answer-5f8f5ab1-0a45-584c-b611-498bfb7e8229" "answer-3c938f80-1a2e-5bdc-937f-bbe6aa683da7" "answer-ccd3d589-8795-5da6-b2f2-1c064d2c6d7a" "answer-019ba0e0-ece3-5798-adda-30d5f0d23288"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f8f5ab1-0a45-584c-b611-498bfb7e8229" :answer/id #uuid "5f8f5ab1-0a45-584c-b611-498bfb7e8229" :answer/type :answer.type/math :answer/value "-3\\operatorname{cos}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-3c938f80-1a2e-5bdc-937f-bbe6aa683da7" :answer/id #uuid "3c938f80-1a2e-5bdc-937f-bbe6aa683da7" :answer/type :answer.type/math :answer/value "-3\\operatorname{cos}⁡8" :db/ensure [:answer/validate]} {:db/id "answer-ccd3d589-8795-5da6-b2f2-1c064d2c6d7a" :answer/id #uuid "ccd3d589-8795-5da6-b2f2-1c064d2c6d7a" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-019ba0e0-ece3-5798-adda-30d5f0d23288" :answer/id #uuid "019ba0e0-ece3-5798-adda-30d5f0d23288" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡2" :db/ensure [:answer/validate]}]
