election" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e3af763-2209-577b-a66e-d0ff71895b50" :answer-field/choices ["answer-6660c89c-395f-5a54-bd86-8fd6ca2f7aa0" "answer-1eba0eb3-b779-54f6-8b71-69c87e7e162f" "answer-8ebd8e6e-e81d-5280-9397-ef529ebc5507" "answer-bb49af1f-b29f-550f-9cde-bf9edc9236ca" "answer-6e3af763-2209-577b-a66e-d0ff71895b50"] :db/ensure [:answer-field/validate]} {:db/id "answer-6660c89c-395f-5a54-bd86-8fd6ca2f7aa0" :answer/id #uuid "6660c89c-395f-5a54-bd86-8fd6ca2f7aa0" :answer/type :answer.type/math :answer/value "-\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "answer-1eba0eb3-b779-54f6-8b71-69c87e7e162f" :answer/id #uuid "1eba0eb3-b779-54f6-8b71-69c87e7e162f" :answer/type :answer.type/math :answer/value "-\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id "answer-8ebd8e6e-e81d-5280-9397-ef529ebc5507" :answer/id #uuid "8ebd8e6e-e81d-5280-9397-ef529ebc5507" :answer/type :answer.type/math :answer/value "\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "answer-bb49af1f-b29f-550f-9cde-bf9edc9236ca" :answer/id #uuid "bb49af1f-b29f-550f-9cde-bf9edc9236ca" :answer/type :answer.type/math :answer/value "\\frac{6}{7}" :db/ensure [:answer/validate]} {:db/id "answer-6e3af763-2209-577b-a66e-d0ff71895b50" :answer/id #uuid "6e3af763-2209-577b-a66e-d0ff71895b50" :answer/type :answer.type/math :answer/value "\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id "question-da68c3e8-bcc9-5b44-b44b-1f5e2fc2eb9a" :question/id #uuid "da68c3e8-bcc9-5b44-b44b-1f5e2fc2eb9a" :question/math-academy-id "q-71157" :question/problem "${(\\frac{2}{11})}^{-1}=$" :question/worked-solution "The expression ${(\\frac{2}{11})}^{-1}$ means the reciprocal of $\\frac{2}{11}.$ Therefore,\n\n$$\n{(\\frac{2}{11})}^{-1}=\\frac{11}{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-53643ac3-21d5-5bf8-855c-7a10edbfc067"] :db/ensure [:question/validate]} {:db/id "answer-field-53643ac3-21d5-5bf8-855c-7a10edbfc067" :answer-field/id #uuid "53643ac3-21d5-5bf8-855c-7a10edbfc067" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f368bc1-aef0-57e8-b86a-54eae8aa0cd7" :answer-field/choices ["answer-ce4590ae-7be8-50df-a6d0-f5cac7ad9ebe" "answer-3072be43-dcf8-5fa8-9494-99e39ee2dd94" "answer-8f368bc1-aef0-57e8-b86a-54eae8aa0cd7" "answer-340b3cb9-ad67-517b-a6e0-f0d7db397ded" "answer-1e96ef40-f7b4-505a-b88a-506d83db1f61"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce4590ae-7be8-50df-a6d0-f5cac7ad9ebe" :answer/id #uuid "ce4590ae-7be8-50df-a6d0-f5cac7ad9ebe" :answer/type :answer.type/math :answer/value "-\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3072be43-dcf8-5fa8-9494-99e39ee2dd94" :answer/id #uuid "3072be43-dcf8-5fa8-9494-99e39ee2dd94" :answer/type :answer.type/math :answer/value "-\\frac{9}{11}" :db/ensure [:answer/validate]} {:db/id "answer-8f368bc1-aef0-57e8-b86a-54eae8aa0cd7" :answer/id #uuid "8f368bc1-aef0-57e8-b86a-54eae8aa0cd7" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "answer-340b3cb9-ad67-517b-a6e0-f0d7db397ded" :answer/id #uuid "340b3cb9-ad67-517b-a6e0-f0d7db397ded" :answer/type :answer.type/math :answer/value "\\frac{11}{7}" :db/ensure [:answer/validate]} {:db/id "answer-1e96ef40-f7b4-505a-b88a-506d83db1f61" :answer/id #uuid "1e96ef40-f7b4-505a-b88a-506d83db1f61" :answer/type :answer.type/math :answer/value "\\frac{2}{11}" :db/ensure [:answer/validate]} {:db/id 17592186079710 :tutorial/content "We know how to evaluate expressions like $2^3, 2^2, 2^1$, and even $2^0.$ But what if the power is negative? How would we evaluate $2^{-1},$ for example?\n\nTo help us with that, let's go back to the results table for powers of $2.$\n\n$$\n\\begin{aligned}{2}^{4} & =16 \\\\ {2}^{3} & =8 \\\\ {2}^{2} & =4 \\\\ {2}^{1} & =2 \\\\ {2}^{0} & =1 \\\\ {2}^{-1} & =◻\\,?\\end{aligned}\n$$\n\nAs we go down the list, the number in blue is divided by $2$ every time. If we follow the same pattern, we find that \n\n$$\n2^{\\color{red}{-1}} = {\\color{blue}{1}}\\div 2 = \\dfrac{1}{2}.\n$$\n\nNow, $\\dfrac{1}{2}$ is just the reciprocal of $2.$ So, raising a number to the power of $-1$ is the *same* as finding its reciprocal!" :db/ensure [:tutorial/validate]} {:db/id 17592186078674 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186198400 :knowledge-point/questions ["question-0bbe6736-f555-565a-b497-ef9dcdc55838" "question-58964444-2a46-54cf-b2ee-de1f5f5033d5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198042 :question/problem "![](images/6e/6e97c59a7c736ec70142bc402566385fc2cd9c6aa78e304d70cefab1027078c1.png)\n\nThe function $f(x),$ whose graph is shown above, has a stationary point at $x=0$ and is continuously differentiable everywhere except at $x=-3.$ Which of the following statements **must** be true according to the inverse function theorem?\n\nI. $f$ is invertible in some neighborhood of $x=-3$\n\nII. $f^{-1}(y)$ is continuously differentiable in a neighborhood of $y=0$\n\nIII. The derivative of $f^{-1}(y)$ at $y=-1.1$ equals $\\dfrac{1}{f'(2)}$" :db/ensure [:question/validate]} {:db/id 17592186198234 :question/problem "Find the locations of all of the critical points of the transformation $\\mathbf{T},$ where $\\mathbf T$ is defined as \n\n![](images/8d/8d64929af5483fd2a6517edbd292ffc01db4959430c13ddda6829e1da545c90e.svg)" :question/worked-solution "Given a transformation \n\n![](images/a4/a4848c66ca7c3fa7a1f14e9d4b241a136e283f10ece91f19e689a22f03c92c3b.svg)\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nTo find the locations of the critical points of $\\mathbf T,$ we need to solve \n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}  = 0.\n$$\n\nHere, we have $x(u,v) = u^2-v^2$ and $y(u,v) = u+v.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2u & \\,\\frac{∂x}{∂v} & =-2v \\\\ \\frac{∂y}{∂u} & =1 & \\,\\frac{∂y}{∂v} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -2v \\\\ \\,\\,1\\, & \\,\\,\\,\\,1\\end{aligned}| \\\\  & =2(u+v).\\end{aligned}\n$$\n\nThe function has critical points when $\\dfrac{\\partial (x, y)}{\\partial (u, v)} =0.$ So, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =0 \\\\ 2(u+v) & =0 \\\\ u & =-v.\\end{aligned}\n$$\n\nTherefore, the critical points of $T$ consist of those points that lie on the line $u=-v$  in the $uv$-plane." :db/ensure [:question/validate]} {:db/id 17592186198370 :knowledge-point/questions ["question-52539dbe-37de-5500-97cf-839689e21baa"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198012 :question/problem "Consider all non-critical points of the transformation $\\mathbf{T}:(u,v) \\to (x(u,v),y(u,v)).$ The inverse transformation $\\mathbf T^{-1}(x,y)\\to(u(x,y), v(x,y))$ is given by\n\n![](images/b5/b52614b0fbaccee13747bedb98617811af7a4b13e64e14f761a16e6b274513ed.svg)\n\nFind the Jacobian determinant of $\\mathbf T$ in terms of $u$ and $v.$" :question/worked-solution "Given a transformation \n\n![](images/5e/5e8faca7bd98b1af626603c26aef5fc4d7a65064f4cdc3486670195fc29dff65.svg)\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given $\\mathbf T^{-1}.$ So, we compute the Jacobian determinant of $\\mathbf T$ as follows:\n\n- First, we compute $\\dfrac{\\partial (u, v)}{\\partial (x, y)},$ the Jacobian determinant of $\\mathbf T^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $\\mathbf T$ using the relation\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)} = \\left( \\dfrac{\\partial (u, v)}{\\partial (x, y)} \\right)^{-1}.\n$$\n\nHere, we have $u(x,y) = e^{x+y}$ and $v(x,y) = e^{x-y}.$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & ={e}^{x+y} & \\,\\frac{∂u}{∂y} & ={e}^{x+y} \\\\ \\frac{∂v}{∂x} & ={e}^{x-y} & \\,\\frac{∂v}{∂y} & =-{e}^{x-y}\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{x+y} & {e}^{x+y} \\\\ {e}^{x-y} & -{e}^{x-y}\\end{aligned}| \\\\  & ={e}^{x+y}\\cdot (-{e}^{x-y})-{e}^{x+y}\\cdot {e}^{x-y} \\\\  & =-{e}^{x+y}\\cdot {e}^{x-y}-{e}^{x+y}\\cdot {e}^{x-y} \\\\  & =-2\\cdot {e}^{x+y}\\cdot {e}^{x-y} \\\\  & =-2uv.\\end{aligned}\n$$\n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =-\\frac{1}{2uv}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-0bbe6736-f555-565a-b497-ef9dcdc55838" :question/id #uuid "0bbe6736-f555-565a-b497-ef9dcdc55838" :question/math-academy-id "q-161848" :question/problem "Let $f:U\\to R$ be continuously differentiable on an open set $U⊆R$ such that $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U.$ Which of the following statements **must** be true?\n\nI. The function $f$ is invertible in a neighborhood of $a.$\n\nII. The inverse ${f}^{-1}$ is continuously differentiable in a neighborhood of $b.$\n\nIII. The derivative of ${f}^{-1}$ is given by ${({f}^{-1})}^{′}(b)={f}^{′}(a).$" :question/worked-solution "The inverse function theorem for single-variable functions states the following:\n\n*If $f:U\\to R$ is continuously differentiable on an open set $U⊆R,$ $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *${f}^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of ${f}^{-1}$ is given by* \n\n$$\n{({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}=\\frac{1}{{f}^{′}({f}^{-1}(b))}\\,.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. According to the theorem, the function $f$ must be invertible in some neighborhood of $a.$\n\n- Statement II is true. Indeed, the inverse ${f}^{-1}$ must be continuously differentiable in a neighborhood of $b.$\n\n- Statement III is false. According to the theorem, we must have ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e0d9b917-d0b0-5b1f-9a90-f69dcef445f6"] :db/ensure [:question/validate]} {:db/id "answer-field-e0d9b917-d0b0-5b1f-9a90-f69dcef445f6" :answer-field/id #uuid "e0d9b917-d0b0-5b1f-9a90-f69dcef445f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c19198c7-b862-5756-86f2-b383d975a476" :answer-field/choices ["answer-c19198c7-b862-5756-86f2-b383d975a476" "answer-385ce135-c231-5207-a3a6-8a8c0ed62b98" "answer-714e9dcf-1d76-5e20-ae52-149021021109" "answer-6bdf97b1-4551-5dd2-8760-7f306190cd16" "answer-d3ffeabc-77ac-5a3c-981c-16b319f409b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-c19198c7-b862-5756-86f2-b383d975a476" :answer/id #uuid "c19198c7-b862-5756-86f2-b383d975a476" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-385ce135-c231-5207-a3a6-8a8c0ed62b98" :answer/id #uuid "385ce135-c231-5207-a3a6-8a8c0ed62b98" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-714e9dcf-1d76-5e20-ae52-149021021109" :answer/id #uuid "714e9dcf-1d76-5e20-ae52-149021021109" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-6bdf97b1-4551-5dd2-8760-7f306190cd16" :answer/id #uuid "6bdf97b1-4551-5dd2-8760-7f306190cd16" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-d3ffeabc-77ac-5a3c-981c-16b319f409b4" :answer/id #uuid "d3ffeabc-77ac-5a3c-981c-16b319f409b4" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "question-58964444-2a46-54cf-b2ee-de1f5f5033d5" :question/id #uuid "58964444-2a46-54cf-b2ee-de1f5f5033d5" :question/math-academy-id "q-161864" :question/problem "![](images/53/539115fd470666cb84e3de4b9b3471db6f04d0af6fd3e33897e5115361fe4e7a.png)\n\nThe function $f(x),$ whose graph is shown above, has a stationary point at $x=-3$ and is continuously differentiable everywhere except at $x=1.$  By considering the points indicated in the diagram, determine which of the following statements **must** be true according to the inverse function theorem.\n\nI. $f$ is invertible in some neighborhood of $x=-3$\n\nII. ${f}^{-1}(y)$ is continuously differentiable in a neighborhood of $y=-0.87$\n\nIII. The derivative of ${f}^{-1}(y)$ at $y=3$ equals $\\frac{1}{{f}^{′}(1)}$" :question/worked-solution "The inverse function theorem for single-variable functions states the following:\n\n*If $f:U\\to R$ is continuously differentiable on an open set $U⊆R,$ $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *${f}^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of ${f}^{-1}$ is given by* \n\n$$\n{({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}=\\frac{1}{{f}^{′}({f}^{-1}(b))}\\,.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. The function $f$ does *not* satisfy the conditions for the inverse function theorem at $x=-3$ since ${f}^{′}(-3)=0.$ So, the theorem can't be applied in this situation.\n\n- Statement II is true. Notice that $y=-0.87=f(-1),$ and the function $f$ satisfies the conditions for the inverse function theorem at $x=-1.$ Indeed,\n\n- $f$ is continuously differentiable on an open set containing $x=-1,$ for example, $(-2,0),$ and\n\n- the derivative of $f$ is nonzero at $x=-1,$ i.e., ${f}^{′}(-1)\\ne 0.$\n\nTherefore, by the inverse function theorem, ${f}^{-1}(y)$ is continuously differentiable in a neighborhood of $y=-0.87.$\n\n- Statement III is false. Notice that $y=3=f(1),$ but $f$ is not continuous at $x=1.$ So, the theorem can't be applied in this situation.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2f711b0e-b282-5e5c-bddd-9a2334e0d40d"] :db/ensure [:question/validate]} {:db/id "answer-field-2f711b0e-b282-5e5c-bddd-9a2334e0d40d" :answer-field/id #uuid "2f711b0e-b282-5e5c-bddd-9a2334e0d40d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2f50ad2a-df10-5aee-9bc1-a61707dbdb2e" :answer-field/choices ["answer-15b10d6e-5a1e-5806-882e-1a82370b98d7" "answer-1eba05a4-5234-5408-ae17-a7c92d57b021" "answer-adf0e36f-9070-5c3f-b130-9a8e721211ef" "answer-2f50ad2a-df10-5aee-9bc1-a61707dbdb2e" "answer-301b96b1-099b-590b-be3b-5f9c7fb06ce0"] :db/ensure [:answer-field/validate]} {:db/id "answer-15b10d6e-5a1e-5806-882e-1a82370b98d7" :answer/id #uuid "15b10d6e-5a1e-5806-882e-1a82370b98d7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-1eba05a4-5234-5408-ae17-a7c92d57b021" :answer/id #uuid "1eba05a4-5234-5408-ae17-a7c92d57b021" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-adf0e36f-9070-5c3f-b130-9a8e721211ef" :answer/id #uuid "adf0e36f-9070-5c3f-b130-9a8e721211ef" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-2f50ad2a-df10-5aee-9bc1-a61707dbdb2e" :answer/id #uuid "2f50ad2a-df10-5aee-9bc1-a61707dbdb2e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-301b96b1-099b-590b-be3b-5f9c7fb06ce0" :answer/id #uuid "301b96b1-099b-590b-be3b-5f9c7fb06ce0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-52539dbe-37de-5500-97cf-839689e21baa" :question/id #uuid "52539dbe-37de-5500-97cf-839689e21baa" :question/math-academy-id "q-160585" :question/problem "Consider all non-critical points of the transformation $T:(u,v)\\to (x(u,v),y(u,v)).$ The inverse transformation ${T}^{-1}(x,y)\\to (u(x,y),v(x,y))$ is given by\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}{e}^{{x}^{2}-{y}^{2}} \\\\ x+y\\end{aligned}].\n$$\n\nFind the Jacobian determinant of $T$ in terms of $u$ and $v.$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nIn this case, we're only given ${T}^{-1}.$ So, we compute the Jacobian determinant of $T$ as follows:\n\n- First, we compute $\\frac{∂(u,v)}{∂(x,y)},$ the Jacobian determinant of ${T}^{-1}.$\n\n- Then, we will compute the Jacobian determinant of $T$ using the relation\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}.\n$$\n\nHere, we have $u(x,y)={e}^{{x}^{2}-{y}^{2}}$ and $v(x,y)=x+y.$ \n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂u}{∂x} & =2x{e}^{{x}^{2}-{y}^{2}} & \\,\\frac{∂u}{∂y} & =2y{e}^{{x}^{2}-{y}^{2}} \\\\ \\frac{∂v}{∂x} & =1 & \\,\\frac{∂v}{∂y} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}2x{e}^{{x}^{2}-{y}^{2}} & -2y{e}^{{x}^{2}-{y}^{2}} \\\\ 1 & 1\\end{aligned}| \\\\  & =2x{e}^{{x}^{2}-{y}^{2}}\\cdot 1-(-2y{e}^{{x}^{2}-{y}^{2}})\\cdot 1 \\\\  & =2x{e}^{{x}^{2}-{y}^{2}}+2y{e}^{{x}^{2}-{y}^{2}} \\\\  & =2\\cdot (x+y)\\cdot {e}^{{x}^{2}-{y}^{2}} \\\\  & =2uv.\\end{aligned}\n$$\n\n \n\nFinally, we take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & ={(\\frac{∂(u,v)}{∂(x,y)})}^{-1} \\\\  & =\\frac{1}{2uv}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4670dc2b-4eab-5b4e-ad02-4eea217ed995"] :db/ensure [:question/validate]} {:db/id "answer-field-4670dc2b-4eab-5b4e-ad02-4eea217ed995" :answer-field/id #uuid "4670dc2b-4eab-5b4e-ad02-4eea217ed995" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-83b435cc-8b1e-5f1c-8aa8-a11fa47c493e" :answer-field/choices ["answer-83b435cc-8b1e-5f1c-8aa8-a11fa47c493e" "answer-632ae4e3-ee1f-5e8a-90cc-3116a07be361" "answer-c815be35-c8ac-52ba-8f94-4f8209e87970" "answer-6c54a42e-7de5-5fb7-b8c8-7174b039dd83" "answer-b019fb8d-4639-5879-8f60-c5aaf51eda53"] :db/ensure [:answer-field/validate]} {:db/id "answer-83b435cc-8b1e-5f1c-8aa8-a11fa47c493e" :answer/id #uuid "83b435cc-8b1e-5f1c-8aa8-a11fa47c493e" :answer/type :answer.type/math :answer/value "\\frac{1}{2uv}" :db/ensure [:answer/validate]} {:db/id "answer-632ae4e3-ee1f-5e8a-90cc-3116a07be361" :answer/id #uuid "632ae4e3-ee1f-5e8a-90cc-3116a07be361" :answer/type :answer.type/math :answer/value "\\frac{2u}{v}" :db/ensure [:answer/validate]} {:db/id "answer-c815be35-c8ac-52ba-8f94-4f8209e87970" :answer/id #uuid "c815be35-c8ac-52ba-8f94-4f8209e87970" :answer/type :answer.type/math :answer/value "\\frac{2v}{u}" :db/ensure [:answer/validate]} {:db/id "answer-6c54a42e-7de5-5fb7-b8c8-7174b039dd83" :answer/id #uuid "6c54a42e-7de5-5fb7-b8c8-7174b039dd83" :answer/type :answer.type/math :answer/value "\\frac{u}{2v}" :db/ensure [:answer/validate]} {:db/id "answer-b019fb8d-4639-5879-8f60-c5aaf51eda53" :answer/id #uuid "b019fb8d-4639-5879-8f60-c5aaf51eda53" :answer/type :answer.type/math :answer/value "\\frac{v}{2u}" :db/ensure [:answer/validate]} {:db/id 17592186199460 :tutorial/content "Let's now state the so-called **inverse function theorem** for single-variable functions:\n\n*If $f: U \\to \\Bbb R$ is continuously differentiable on an open set $U\\subseteq \\mathbb R,$ $f(a) = b$ and $f'(a)\\neq 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *$f^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of $f^{-1}$ is given by* \n\n$$\n\\left(f^{-1}\\right)'(b) = \\dfrac{1}{f'(a)} =\\dfrac{1}{f'(f^{-1}(b))}\\,.\n$$\n\nTo explain this concretely, consider the graph below:\n\n![](images/4d/4dfd8b142b594a2ca4f0e39f9b8ca1e04018bf0efd63f9dc2235bd61e9f9d70e.png)\n\nIn this example, the function $f$ is continuously differentiable at $x=a$ and has a nonzero derivative. As a result, $f^{-1}$ exists in a neighborhood of $x=b$ and is continuously differentiable at this point.\n\nOn the other hand, if $f$ is continuously differentiable at $x=a$ but $f'(a) = 0,$ then one of two things can happen:\n\n- **Case 1**: The function $f$ does not have a local inverse at $a.$\n\n![](images/04/04ee310e6068e517aec42a67fa83837986f8807e1250b89b52e7a62e3975bb38.png)\n\nIn the example above, $f$ is not one-to-one in a neighborhood of $a,$ so it's not invertible there.\n\n- **Case 2**: The function $f$ has a local inverse at $a,$ but its inverse is not continuously differentiable at $b.$\n\n![](images/3e/3e2738a16f999d503fb295f4fd6535a854884468a4d190ffa537a4ec9295490c.png)\n\nIn the example above, $f$ is invertible in a neighborhood of $a,$ but $f^{-1}$ is not differentiable at $x=b$ since it has a vertical tangent at this point." :db/ensure [:tutorial/validate]} {:db/id 17592186199450 :tutorial/content "Consider a transformation $\\mathbf T,$ given by\n\n![](images/fe/fefb7b82a6da1421bb96798fe6377e66199b50b8630dc396518927a0f3fe204b.svg)\n\nThe points in the $(u,v)$ plane where $\\mathbf T$ is *locally* non-invertible are known as **critical points**. \n\nWe've already seen that $\\mathbf T$ is locally non-invertible when the Jacobian determinant is zero. Therefore, the critical points of $\\mathbf T$ are the solutions to the equation\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}=0.\n$$\n\n  \n\nLet's compute the critical points of the following transformation:\n\n![](images/8e/8e55b2da9a0c1fcf1ab901d361c50b652c906b92f0fcd4b158793f7782cfe5f4.svg)\n\nFirst, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =4u & \\,\\frac{∂x}{∂v} & =-6v \\\\ \\frac{∂y}{∂u} & =-1 & \\,\\frac{∂y}{∂v} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}4u & -6v \\\\ -1 & 1\\end{aligned}| \\\\  & =4u\\cdot 1-(-6v)\\cdot (-1) \\\\  & =4u-6v.\\end{aligned}\n$$\n\nThe function has critical points when the Jacobian equals zero. So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =0 \\\\ 4u-6v & =0 \\\\ 2u-3v & =0.\\end{aligned}\n$$\n\nTherefore, the critical points of $\\mathbf{T}$ consist of those points that lie on the line $2u-3v=0$  in the $uv$-plane, shown below. \n\n![](images/5c/5c544e3d3ecbdeaf7dc372b40ee0f37cb14e3ba292b8180a263c91103a9efe61.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186199477 :tutorial/content "The inverse function theorem can be generalized to transformations too. We state it below:\n\n*Let $\\mathbf T:U \\to \\Bbb R^2$ be a $C^1$ (continuously differentiable) transformation on an open set $U\\subseteq \\mathbb R^2,$ where *\n![](images/82/829c083606df36014d5b5b078b80c1c0ff1edb72f981880b4a1a6a16affb32dc.svg)\n\n*Further, suppose that $(u_0,v_0)$ is **not** a critical point of $\\mathbf T.$* Then,\n\n- *$\\mathbf T$ is locally invertible at $(u_0,v_0),$*\n\n- *$\\mathbf T^{-1},$ the inverse of $\\mathbf T,$ is a $C^1$ function in a neighborhood of $(x_0,y_0),$ and*\n\n- *the Jacobian determinant of $\\mathbf T^{-1},$ denoted $\\dfrac{\\partial (u, v)}{\\partial (x, y)} ,$ is given by*\n\n$$\n\\dfrac{\\partial (u, v)}{\\partial (x, y)} = \\left( \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right)^{-1}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186198489 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186192765 :knowledge-point/questions ["question-aa86399c-45ea-5f74-a86a-9df5e96aefc4" "question-600bd5a7-d330-5937-a607-067ad2bf01ca"] :db/ensure [:knowledge-point/validate]} {:db/id "question-aa86399c-45ea-5f74-a86a-9df5e96aefc4" :question/id #uuid "aa86399c-45ea-5f74-a86a-9df5e96aefc4" :question/math-academy-id "q-71811" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 2,\\,0\\le {y}^{2}\\le 4\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<9,\\,0\\le x\\le 3\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,0\\le y<\\sqrt{x},\\,1\\le x\\le 4\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,0).$\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(4,2).$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a27d4985-c893-59c2-8d1d-cd7a9be7d49e"] :db/ensure [:question/validate]} {:db/id "answer-field-a27d4985-c893-59c2-8d1d-cd7a9be7d49e" :answer-field/id #uuid "a27d4985-c893-59c2-8d1d-cd7a9be7d49e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69786cd2-b99b-5dbd-8075-213ab71d07dd" :answer-field/choices ["answer-9e72f8ca-cf52-50d2-beaf-003a6572d927" "answer-9807ea88-a3a9-5154-a546-71a17c56832c" "answer-69786cd2-b99b-5dbd-8075-213ab71d07dd" "answer-49b6d884-1f1f-5515-9208-44fc250671f4" "answer-b735a3c9-2177-54de-b227-f9c00a922b09"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e72f8ca-cf52-50d2-beaf-003a6572d927" :answer/id #uuid "9e72f8ca-cf52-50d2-beaf-003a6572d927" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-9807ea88-a3a9-5154-a546-71a17c56832c" :answer/id #uuid "9807ea88-a3a9-5154-a546-71a17c56832c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-69786cd2-b99b-5dbd-8075-213ab71d07dd" :answer/id #uuid "69786cd2-b99b-5dbd-8075-213ab71d07dd" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-49b6d884-1f1f-5515-9208-44fc250671f4" :answer/id #uuid "49b6d884-1f1f-5515-9208-44fc250671f4" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-b735a3c9-2177-54de-b227-f9c00a922b09" :answer/id #uuid "b735a3c9-2177-54de-b227-f9c00a922b09" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-600bd5a7-d330-5937-a607-067ad2bf01ca" :question/id #uuid "600bd5a7-d330-5937-a607-067ad2bf01ca" :question/math-academy-id "q-71813" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,1\\le x<2,\\,2<y<4\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,-1\\le x\\le 1,\\,0\\le y\\le 2\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,3).$ On the other hand, it does not contain some other boundary points, for example, the point $(2,3).$\n\n- The second set is *open* since it doesn't contain any of its boundary points (the corresponding inequality is strict).\n\n- The third set is *closed* since it contains all its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0b9663fd-5968-52a8-ba68-181cef60c992"] :db/ensure [:question/validate]} {:db/id "answer-field-0b9663fd-5968-52a8-ba68-181cef60c992" :answer-field/id #uuid "0b9663fd-5968-52a8-ba68-181cef60c992" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8dd16611-f690-5a0f-a18d-5609fa7747fa" :answer-field/choices ["answer-662d6cbf-df0b-5a2b-864d-c8e3c7d7c84f" "answer-8dd16611-f690-5a0f-a18d-5609fa7747fa" "answer-009bebc1-1d70-5146-acb2-345610e6c246" "answer-ce0da569-9446-52c8-a13b-44c64c37b563" "answer-872fa692-204b-5b6c-a856-b98e7bca186a"] :db/ensure [:answer-field/validate]} {:db/id "answer-662d6cbf-df0b-5a2b-864d-c8e3c7d7c84f" :answer/id #uuid "662d6cbf-df0b-5a2b-864d-c8e3c7d7c84f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-8dd16611-f690-5a0f-a18d-5609fa7747fa" :answer/id #uuid "8dd16611-f690-5a0f-a18d-5609fa7747fa" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-009bebc1-1d70-5146-acb2-345610e6c246" :answer/id #uuid "009bebc1-1d70-5146-acb2-345610e6c246" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-ce0da569-9446-52c8-a13b-44c64c37b563" :answer/id #uuid "ce0da569-9446-52c8-a13b-44c64c37b563" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-872fa692-204b-5b6c-a856-b98e7bca186a" :answer/id #uuid "872fa692-204b-5b6c-a856-b98e7bca186a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186110737 :knowledge-point/questions ["question-72233131-e693-5fea-8917-0160c71e51e0" "question-06a538f6-9964-548c-a747-1f94df2f31bc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110316 :question/problem "If $z + 9 = 12,$ then what is the value of $z?$" :question/worked-solution "If we substitute ${\\color{blue}{z}}={\\color{blue}{3}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}z+9 & =12 \\\\ 3+9 & =12 \\\\ 12 & =12\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $z=3.$" :db/ensure [:question/validate]} {:db/id 17592186110738 :knowledge-point/questions ["question-1b15f6ab-703e-5435-802f-d0e72d7b1bd2" "question-42533c96-48d8-5008-9e2c-fd9575aaa4a1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110317 :question/problem "What is the solution to the equation $a - 3 = 4?$" :question/worked-solution "If we substitute ${\\color{blue}{a}}={\\color{blue}{7}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}a-3 & =4 \\\\ 7-3 & =4 \\\\ 4 & =4\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $a=7.$" :db/ensure [:question/validate]} {:db/id 17592186110739 :knowledge-point/questions ["question-e151b111-03ef-5f1a-9971-58474f0c89d9" "question-837b73e9-3871-5e24-9f24-4e27d1769365"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110318 :question/problem "If $2b = 8,$ then $b=$" :question/worked-solution "If we substitute ${\\color{blue}{b}}={\\color{blue}{4}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}2b & =8 \\\\ 2\\cdot 4 & =8 \\\\ 8 & =8\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $b=4.$" :db/ensure [:question/validate]} {:db/id 17592186110740 :knowledge-point/questions ["question-9a04160c-cdc7-57d1-904e-82dbc1485a07" "question-47a845f2-df50-5b7b-8443-4a0869837acd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110319 :question/problem "If  $\\dfrac{15}{c} = 5,$ then $c=$" :question/worked-solution "If we substitute ${\\color{blue}{c}}={\\color{blue}{3}}$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\\frac{15}{c} & =5 \\\\ \\frac{15}{3} & =5 \\\\ 5 & =5\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $c = \\bbox[3pt,Gainsboro]{\\color{blue}3}.$" :db/ensure [:question/validate]} {:db/id "question-72233131-e693-5fea-8917-0160c71e51e0" :question/id #uuid "72233131-e693-5fea-8917-0160c71e51e0" :question/math-academy-id "q-185352" :question/problem "The solution to the equation $x+4=16$ is $x=${{field-1}}." :question/worked-solution "If we substitute $x=12$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}x+4 & =16 \\\\ 12+4 & =16 \\\\ 16 & =16\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $x=12.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cd3613bf-4ad6-50aa-841f-13ac20fe2310"] :db/ensure [:question/validate]} {:db/id "answer-field-cd3613bf-4ad6-50aa-841f-13ac20fe2310" :answer-field/id #uuid "cd3613bf-4ad6-50aa-841f-13ac20fe2310" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b2c9e595-a8a5-5d07-9c29-b401f34520d3" :answer-field/choices ["answer-b2c9e595-a8a5-5d07-9c29-b401f34520d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2c9e595-a8a5-5d07-9c29-b401f34520d3" :answer/id #uuid "b2c9e595-a8a5-5d07-9c29-b401f34520d3" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-06a538f6-9964-548c-a747-1f94df2f31bc" :question/id #uuid "06a538f6-9964-548c-a747-1f94df2f31bc" :question/math-academy-id "q-185357" :question/problem "If $x+6=5,$ then $x=${{field-1}}." :question/worked-solution "If we substitute $x=-1$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}x+6 & =5 \\\\ (-1)+6 & =5 \\\\ -1+6 & =5 \\\\ 5 & =5\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $x=-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-45115ba6-3193-559e-807e-9bd67f06d9f9"] :db/ensure [:question/validate]} {:db/id "answer-field-45115ba6-3193-559e-807e-9bd67f06d9f9" :answer-field/id #uuid "45115ba6-3193-559e-807e-9bd67f06d9f9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bae70d18-b31b-5b3f-bd75-7bb1bf8e5adc" :answer-field/choices ["answer-bae70d18-b31b-5b3f-bd75-7bb1bf8e5adc"] :db/ensure [:answer-field/validate]} {:db/id "answer-bae70d18-b31b-5b3f-bd75-7bb1bf8e5adc" :answer/id #uuid "bae70d18-b31b-5b3f-bd75-7bb1bf8e5adc" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "question-1b15f6ab-703e-5435-802f-d0e72d7b1bd2" :question/id #uuid "1b15f6ab-703e-5435-802f-d0e72d