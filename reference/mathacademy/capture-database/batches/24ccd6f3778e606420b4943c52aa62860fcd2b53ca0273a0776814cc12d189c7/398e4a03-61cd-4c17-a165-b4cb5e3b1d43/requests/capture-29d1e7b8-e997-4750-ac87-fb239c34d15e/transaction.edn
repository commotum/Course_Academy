/blank :answer-field/correct "answer-2f8dbf42-204b-5155-b977-a77996fdf4ab" :answer-field/choices ["answer-2f8dbf42-204b-5155-b977-a77996fdf4ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f8dbf42-204b-5155-b977-a77996fdf4ab" :answer/id #uuid "2f8dbf42-204b-5155-b977-a77996fdf4ab" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-9a04160c-cdc7-57d1-904e-82dbc1485a07" :question/id #uuid "9a04160c-cdc7-57d1-904e-82dbc1485a07" :question/math-academy-id "q-67226" :question/problem "If $\\frac{k}{8}=3,$ then $k=$" :question/worked-solution "If we substitute $k=24$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\\frac{k}{8} & =3 \\\\ \\frac{24}{8} & =3 \\\\ 3 & =3\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $k=24.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5adc46a9-b6c4-5539-859c-24f3b3d112ea"] :db/ensure [:question/validate]} {:db/id "answer-field-5adc46a9-b6c4-5539-859c-24f3b3d112ea" :answer-field/id #uuid "5adc46a9-b6c4-5539-859c-24f3b3d112ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-953feb0d-34c0-5847-b041-d5ec9a21191b" :answer-field/choices ["answer-735d1ccc-23ca-5fa3-86fe-6a46f79445ad" "answer-066f2cc5-ce42-529c-8d40-a46f183e28f3" "answer-70b4d034-c5d9-53b4-9a6f-241938055b7c" "answer-953feb0d-34c0-5847-b041-d5ec9a21191b" "answer-56a09c64-3423-5518-a891-8df390e23ab6"] :db/ensure [:answer-field/validate]} {:db/id "answer-735d1ccc-23ca-5fa3-86fe-6a46f79445ad" :answer/id #uuid "735d1ccc-23ca-5fa3-86fe-6a46f79445ad" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "answer-066f2cc5-ce42-529c-8d40-a46f183e28f3" :answer/id #uuid "066f2cc5-ce42-529c-8d40-a46f183e28f3" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-70b4d034-c5d9-53b4-9a6f-241938055b7c" :answer/id #uuid "70b4d034-c5d9-53b4-9a6f-241938055b7c" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-953feb0d-34c0-5847-b041-d5ec9a21191b" :answer/id #uuid "953feb0d-34c0-5847-b041-d5ec9a21191b" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-56a09c64-3423-5518-a891-8df390e23ab6" :answer/id #uuid "56a09c64-3423-5518-a891-8df390e23ab6" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-47a845f2-df50-5b7b-8443-4a0869837acd" :question/id #uuid "47a845f2-df50-5b7b-8443-4a0869837acd" :question/math-academy-id "q-185509" :question/problem "If $\\frac{56}{x}=7,$ then $x=${{field-1}}." :question/worked-solution "If we substitute $x=8$ into the given equation, we get a true statement:\n\n$$\n\\begin{aligned}\\frac{56}{x} & =7 \\\\ \\frac{56}{8} & =7 \\\\ 7 & =7\\,✓\\end{aligned}\n$$\n\nTherefore, the solution is $x=8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2a3d4426-b590-5a75-af88-af07ed3dbf33"] :db/ensure [:question/validate]} {:db/id "answer-field-2a3d4426-b590-5a75-af88-af07ed3dbf33" :answer-field/id #uuid "2a3d4426-b590-5a75-af88-af07ed3dbf33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e3f9c768-b8a7-5402-886b-eeba90a02cfc" :answer-field/choices ["answer-e3f9c768-b8a7-5402-886b-eeba90a02cfc"] :db/ensure [:answer-field/validate]} {:db/id "answer-e3f9c768-b8a7-5402-886b-eeba90a02cfc" :answer/id #uuid "e3f9c768-b8a7-5402-886b-eeba90a02cfc" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186111910 :tutorial/content "An **equation** consists of two mathematical expressions separated by an equals $(=)$ sign. The expressions may or may not contain variables. Two examples of equations are shown below:\n\n$$\n2 + 3 = 5 \\qquad\\qquad 2 + x = 5\n$$\n\n \n\nAn equation is **true** if the expression to the left side of the equals sign is equal to the expression on the right side. Otherwise, if the left side is not equal to the right side, then the equation is **false**. For instance,\n\n- the equation $2 + 3 = 5$ is **true**, whereas\n\n- the equation $2+2 = 5$ is **false**.\n\nAs a result, the equation\n\n$$\n2 + x = 5\n$$\n\nis true *only if* $x=3.$ We say that $x=3$ is the **solution** to the equation $2+x=5.$" :db/ensure [:tutorial/validate]} {:db/id 17592186110808 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186133756 :knowledge-point/questions ["question-e7e40f9d-527f-556e-806c-7a796edd693d" "question-7db25f7d-3356-5632-8759-eb38fc83f21e" "question-659a44e7-6c36-5b88-91e1-e77f6a2823f8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133755 :knowledge-point/questions ["question-4d5db12b-aca4-5679-a4bf-a23907fa0446"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186271994 :question/problem "Given that $\\{i,j\\}$ is the standard basis of ${R}^{2}$ and that the images of $i$ and $j$ under the action of a linear transformation $T$ are $⟨-1,2⟩$ and $⟨3,-8⟩$, respectively, what is the standard matrix of $T?$" :db/ensure [:question/validate]} {:db/id "question-e7e40f9d-527f-556e-806c-7a796edd693d" :question/id #uuid "e7e40f9d-527f-556e-806c-7a796edd693d" :question/math-academy-id "q-77951" :question/problem "Given that $\\{i,j,k\\}$ is the standard basis of ${R}^{3}$ and that the images of $i,$ $j,$ and $k$ under the action of a linear transformation $T$ are $⟨1,-1,3⟩,$ $⟨-4,3,5⟩,$ and $⟨0,-3,1⟩,$ respectively, what is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}1 & -4 & 0 \\\\ -1 & 3 & -3 \\\\ 3 & 5 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d3bb9935-cbbe-5e49-8e35-aa2149056cca"] :db/ensure [:question/validate]} {:db/id "answer-field-d3bb9935-cbbe-5e49-8e35-aa2149056cca" :answer-field/id #uuid "d3bb9935-cbbe-5e49-8e35-aa2149056cca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bbe7e136-1bd0-5275-b754-c0dd7ff6eb86" :answer-field/choices ["answer-f0795b90-0461-5e09-bfb7-07ba358d1fa4" "answer-421a0f70-0553-5a87-9749-31b728d24e73" "answer-c3f4f6b3-3932-5b4d-8f6f-fdabb0d8152a" "answer-bbe7e136-1bd0-5275-b754-c0dd7ff6eb86" "answer-410a1be0-af9e-519a-8c5c-976d74a48858"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0795b90-0461-5e09-bfb7-07ba358d1fa4" :answer/id #uuid "f0795b90-0461-5e09-bfb7-07ba358d1fa4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 3 & -3 \\\\ 3 & 5 & 1 \\\\ 1 & -4 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-421a0f70-0553-5a87-9749-31b728d24e73" :answer/id #uuid "421a0f70-0553-5a87-9749-31b728d24e73" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 3 & 5 \\\\ 0 & -3 & 1 \\\\ 1 & -1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c3f4f6b3-3932-5b4d-8f6f-fdabb0d8152a" :answer/id #uuid "c3f4f6b3-3932-5b4d-8f6f-fdabb0d8152a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -1 & 3 \\\\ -4 & 3 & 5 \\\\ 0 & -3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-bbe7e136-1bd0-5275-b754-c0dd7ff6eb86" :answer/id #uuid "bbe7e136-1bd0-5275-b754-c0dd7ff6eb86" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -4 & 0 \\\\ -1 & 3 & -3 \\\\ 3 & 5 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-410a1be0-af9e-519a-8c5c-976d74a48858" :answer/id #uuid "410a1be0-af9e-519a-8c5c-976d74a48858" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -4 & 0 \\\\ 3 & 5 & 1 \\\\ -1 & 3 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-7db25f7d-3356-5632-8759-eb38fc83f21e" :question/id #uuid "7db25f7d-3356-5632-8759-eb38fc83f21e" :question/math-academy-id "q-43831" :question/problem "Given that $\\{i,j\\}$ is the standard basis of ${R}^{2}$ and that the images of $i$ and $j$ under the action of a linear transformation $T$ are $⟨-4,3⟩$ and $⟨5,0⟩$, respectively, what is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nTherefore, the standard matrix for this linear transformation is \n\n$$\nT=[\\begin{aligned}-4 & 5 \\\\ 3 & 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4498ce2-5816-50b4-b958-14ca5968f0b8"] :db/ensure [:question/validate]} {:db/id "answer-field-f4498ce2-5816-50b4-b958-14ca5968f0b8" :answer-field/id #uuid "f4498ce2-5816-50b4-b958-14ca5968f0b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28cc40d6-3384-53d9-a33b-2b15b315fb64" :answer-field/choices ["answer-c315fa0d-18b4-5d07-8bb1-3c68c6498d48" "answer-c2374e82-81fa-556e-95bf-676b03288667" "answer-28cc40d6-3384-53d9-a33b-2b15b315fb64" "answer-81c81ee7-5dc1-520e-b6bb-1d4571b8c42e" "answer-add2ffad-ea81-500e-9fda-394920da2ff5"] :db/ensure [:answer-field/validate]} {:db/id "answer-c315fa0d-18b4-5d07-8bb1-3c68c6498d48" :answer/id #uuid "c315fa0d-18b4-5d07-8bb1-3c68c6498d48" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 3 \\\\ 5 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c2374e82-81fa-556e-95bf-676b03288667" :answer/id #uuid "c2374e82-81fa-556e-95bf-676b03288667" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 3 \\\\ 5 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-28cc40d6-3384-53d9-a33b-2b15b315fb64" :answer/id #uuid "28cc40d6-3384-53d9-a33b-2b15b315fb64" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & 5 \\\\ 3 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-81c81ee7-5dc1-520e-b6bb-1d4571b8c42e" :answer/id #uuid "81c81ee7-5dc1-520e-b6bb-1d4571b8c42e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & -4 \\\\ 0 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-add2ffad-ea81-500e-9fda-394920da2ff5" :answer/id #uuid "add2ffad-ea81-500e-9fda-394920da2ff5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 3 \\\\ -4 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-659a44e7-6c36-5b88-91e1-e77f6a2823f8" :question/id #uuid "659a44e7-6c36-5b88-91e1-e77f6a2823f8" :question/math-academy-id "q-77952" :question/problem "Given that $\\{i,j,k\\}$ is the standard basis of ${R}^{3}$ and that the images of $i,$ $j,$ and $k$ under the action of a linear transformation $T$ are $⟨1,-4,-1⟩,$ $⟨-3,-2,5⟩,$ and $⟨1,0,0⟩,$ respectively, what is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{3}$ can be represented as a $3\\times 3$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i,j,$ and $k$ under the action of the transformation.\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}1 & -3 & 1 \\\\ -4 & -2 & 0 \\\\ -1 & 5 & 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cae2df7d-db8e-56df-a0a9-d18c8a2876b9"] :db/ensure [:question/validate]} {:db/id "answer-field-cae2df7d-db8e-56df-a0a9-d18c8a2876b9" :answer-field/id #uuid "cae2df7d-db8e-56df-a0a9-d18c8a2876b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-958b422f-cfe6-5018-975b-a8efbacbddc9" :answer-field/choices ["answer-1d4a0944-b188-5d35-baa8-8a8a88a994ba" "answer-958b422f-cfe6-5018-975b-a8efbacbddc9" "answer-9cfa3692-efef-5b3e-940d-57c277809203" "answer-2ab529e4-93ab-5203-b0f9-a8a2a958fd1b" "answer-f724ed95-68fb-54fb-b004-f6295840c4e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d4a0944-b188-5d35-baa8-8a8a88a994ba" :answer/id #uuid "1d4a0944-b188-5d35-baa8-8a8a88a994ba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 & -2 & 0 \\\\ 1 & -3 & 1 \\\\ -1 & 5 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-958b422f-cfe6-5018-975b-a8efbacbddc9" :answer/id #uuid "958b422f-cfe6-5018-975b-a8efbacbddc9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -3 & 1 \\\\ -4 & -2 & 0 \\\\ -1 & 5 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9cfa3692-efef-5b3e-940d-57c277809203" :answer/id #uuid "9cfa3692-efef-5b3e-940d-57c277809203" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -3 & 1 \\\\ 0 & -4 & -2 \\\\ 5 & 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2ab529e4-93ab-5203-b0f9-a8a2a958fd1b" :answer/id #uuid "2ab529e4-93ab-5203-b0f9-a8a2a958fd1b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -4 & -1 \\\\ -3 & -2 & 5 \\\\ 1 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f724ed95-68fb-54fb-b004-f6295840c4e1" :answer/id #uuid "f724ed95-68fb-54fb-b004-f6295840c4e1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & -4 & -1 \\\\ 1 & 0 & 0 \\\\ -3 & -2 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-4d5db12b-aca4-5679-a4bf-a23907fa0446" :question/id #uuid "4d5db12b-aca4-5679-a4bf-a23907fa0446" :question/math-academy-id "q-77997" :question/problem "![](images/d6/d6a750225b9912b9b4735f5dbc0f8b0a8b63fbe7616405e0e53bff31d10fc61d.png)\n\nIn the diagram above,  $i$ and $j$ are the vectors of the standard basis of ${R}^{2}$, while ${i}^{′}$ and  ${j}^{′}$ are their images under the linear transformation $T.$\nWhat is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}2 \\\\ 3\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3cd92ddd-b799-5fa5-92ec-700545653a91"] :db/ensure [:question/validate]} {:db/id "answer-field-3cd92ddd-b799-5fa5-92ec-700545653a91" :answer-field/id #uuid "3cd92ddd-b799-5fa5-92ec-700545653a91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-194e6537-4699-5a25-81a6-e3f4bb381d20" :answer-field/choices ["answer-aa7b04f0-6191-5e63-a29d-f574c47d27f6" "answer-9ad371d8-7861-58f8-aba0-91eb68129c83" "answer-194e6537-4699-5a25-81a6-e3f4bb381d20" "answer-d1315408-ee7a-5c30-89fe-f5daa47d3aee" "answer-b48e758f-6e45-574b-b4d0-a1bdbc264f7b"] :db/ensure [:answer-field/validate]} {:db/id "answer-aa7b04f0-6191-5e63-a29d-f574c47d27f6" :answer/id #uuid "aa7b04f0-6191-5e63-a29d-f574c47d27f6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 1 \\\\ 2 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9ad371d8-7861-58f8-aba0-91eb68129c83" :answer/id #uuid "9ad371d8-7861-58f8-aba0-91eb68129c83" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-194e6537-4699-5a25-81a6-e3f4bb381d20" :answer/id #uuid "194e6537-4699-5a25-81a6-e3f4bb381d20" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -1 \\\\ 3 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d1315408-ee7a-5c30-89fe-f5daa47d3aee" :answer/id #uuid "d1315408-ee7a-5c30-89fe-f5daa47d3aee" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b48e758f-6e45-574b-b4d0-a1bdbc264f7b" :answer/id #uuid "b48e758f-6e45-574b-b4d0-a1bdbc264f7b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 \\\\ 2 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186403926 :question/problem "The linear transformation $T$ has the standard matrix \n\n$$\nT=[\\begin{aligned}2 & 4 \\\\ 1 & -5\\end{aligned}].\n$$\n\n \nWhat are the respective images of the standard basis vectors $\\{i,j\\}$ of ${R}^{2}$ under the action of $T?$" :question/worked-solution "**Method 1**\n\nThe images of the vectors in the standard basis $\\{i,j\\}$ are the first and second columns of $T,$ respectively. \n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}T(i) & =T[\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\ T(j) & =T[\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}4 \\\\ -5\\end{aligned}]\\end{aligned}\n$$\n\n**Method 2**\n\nWe can find the images of the vectors in the standard basis $\\{i,j\\}$ by computing the matrix products $T\\cdot i$ and $T\\cdot j:$\n\n$$\n\\begin{aligned}T(i) & =T\\cdot i=[\\begin{aligned}2 & 4 \\\\ 1 & -5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\ T(j) & =T\\cdot j=[\\begin{aligned}2 & 4 \\\\ 1 & -5\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}4 \\\\ -5\\end{aligned}]\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133962 :knowledge-point/questions ["question-fa6ce3e2-d928-5ded-b467-af49a788ffd9" "question-87efd59d-ce0a-5957-a5fd-7fe6753d07aa"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133492 :question/problem "Evaluate $\\dfrac{x-2}{x+1}$ for $x=5.$" :question/worked-solution "We replace $x$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{x-2}{x+1} & = \\\\ \\frac{5-2}{5+1} & = \\\\ \\frac{3}{6} & = \\\\ \\frac{1}{2} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133963 :knowledge-point/questions ["question-5b344d92-93c1-5290-a0ad-6b1e4107b056"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133494 :question/problem "Evaluate $\\dfrac{3(2a-1)}{2(3a+1)}$ for $a=1.$" :question/worked-solution "We replace $a$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3(2a-1)}{2(3a+1)} & = \\\\ \\frac{3(2(1)-1)}{2(3(1)+1)} & = \\\\ \\frac{3(2-1)}{2(3+1)} & = \\\\ \\frac{3(1)}{2(4)} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133964 :knowledge-point/questions ["question-e26eed03-f29f-5ce3-a1e7-151a8b9035cd" "question-9225fcc6-6a47-5dc8-ba01-452e86bfb00e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133493 :question/problem "Evaluate $\\dfrac{1}{p} + \\dfrac{1}{2p}$ for $p=4.$" :question/worked-solution "We replace $p$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{1}{p}+\\frac{1}{2p} & = \\\\ \\frac{1}{4}+\\frac{1}{2\\cdot 4} & = \\\\ \\frac{1}{4}+\\frac{1}{8} & = \\\\ \\frac{2}{8}+\\frac{1}{8} & = \\\\ \\frac{2+1}{8} & = \\\\ \\frac{3}{8} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133965 :knowledge-point/questions ["question-15e3ee11-29b6-56d8-a84c-a4bce1a94db1" "question-c7c69cd2-d2ae-54a6-bb6d-38d0dd05009e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133495 :question/problem "Evaluate $\\dfrac{n-2}{m-1} + \\dfrac{2(m+1)}{n}$ for $m=4$ and $n=6.$" :question/worked-solution "We replace $m$ with $4$ and $n$ with $6$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{n-2}{m-1}+\\frac{2(m+1)}{n} & = \\\\ \\frac{6-2}{4-1}+\\frac{2(4+1)}{6} & = \\\\ \\frac{4}{3}+\\frac{2(5)}{6} & = \\\\ \\frac{4}{3}+\\frac{10}{6} & = \\\\ \\frac{4}{3}+\\frac{5}{3} & = \\\\ \\frac{4+5}{3} & = \\\\ \\frac{9}{3} & = \\\\ 3 & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-fa6ce3e2-d928-5ded-b467-af49a788ffd9" :question/id #uuid "fa6ce3e2-d928-5ded-b467-af49a788ffd9" :question/math-academy-id "q-99771" :question/problem "Evaluate $\\frac{5x+8}{3-x}$ for $x=1.$" :question/worked-solution "We replace $x$ with $1$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x+8}{3-x} & = \\\\ \\frac{5(1)+8}{3-1} & = \\\\ \\frac{13}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1fef7ddd-1525-56e1-9913-003a91c9ac36"] :db/ensure [:question/validate]} {:db/id "answer-field-1fef7ddd-1525-56e1-9913-003a91c9ac36" :answer-field/id #uuid "1fef7ddd-1525-56e1-9913-003a91c9ac36" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47743e4d-66ff-57e8-a301-5fcb5f2dd10f" :answer-field/choices ["answer-47743e4d-66ff-57e8-a301-5fcb5f2dd10f" "answer-3d3677bf-742c-53a4-a047-d86fc48f3bbf" "answer-3ddfa06b-86d5-559c-85a2-4fc800367521" "answer-7ba6ab15-6cf9-5ef9-a2bd-146153a7b34d" "answer-6039b89d-8e65-5ba1-8241-2b05954ba057"] :db/ensure [:answer-field/validate]} {:db/id "answer-47743e4d-66ff-57e8-a301-5fcb5f2dd10f" :answer/id #uuid "47743e4d-66ff-57e8-a301-5fcb5f2dd10f" :answer/type :answer.type/math :answer/value "\\frac{13}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3d3677bf-742c-53a4-a047-d86fc48f3bbf" :answer/id #uuid "3d3677bf-742c-53a4-a047-d86fc48f3bbf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3ddfa06b-86d5-559c-85a2-4fc800367521" :answer/id #uuid "3ddfa06b-86d5-559c-85a2-4fc800367521" :answer/type :answer.type/math :answer/value "\\frac{2}{13}" :db/ensure [:answer/validate]} {:db/id "answer-7ba6ab15-6cf9-5ef9-a2bd-146153a7b34d" :answer/id #uuid "7ba6ab15-6cf9-5ef9-a2bd-146153a7b34d" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "answer-6039b89d-8e65-5ba1-8241-2b05954ba057" :answer/id #uuid "6039b89d-8e65-5ba1-8241-2b05954ba057" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "question-87efd59d-ce0a-5957-a5fd-7fe6753d07aa" :question/id #uuid "87efd59d-ce0a-5957-a5fd-7fe6753d07aa" :question/math-academy-id "q-175684" :question/problem "If $x=4,$ then $\\frac{5x-4}{x-2}=${{field-1}}." :question/worked-solution "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{5x-4}{x-2} & = \\\\ \\frac{5(4)-4}{4-2} & = \\\\ \\frac{16}{2} & = \\\\ 8\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c649b4ef-f1a9-5c40-9e0e-b1c1946fdccc"] :db/ensure [:question/validate]} {:db/id "answer-field-c649b4ef-f1a9-5c40-9e0e-b1c1946fdccc" :answer-field/id #uuid "c649b4ef-f1a9-5c40-9e0e-b1c1946fdccc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dad6b761-626c-5e60-b184-97c3c374f08a" :answer-field/choices ["answer-dad6b761-626c-5e60-b184-97c3c374f08a"] :db/ensure [:answer-field/validate]} {:db/id "answer-dad6b761-626c-5e60-b184-97c3c374f08a" :answer/id #uuid "dad6b761-626c-5e60-b184-97c3c374f08a" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186234263 :question/answer-fields ["answer-field-bc540408-0f45-50a3-8a94-f7c3024065c7"] :db/ensure [:question/validate]} {:db/id "answer-field-bc540408-0f45-50a3-8a94-f7c3024065c7" :answer-field/id #uuid "bc540408-0f45-50a3-8a94-f7c3024065c7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e9e04f32-f49f-5493-8cf1-70b85078e012" :answer-field/choices ["answer-e9e04f32-f49f-5493-8cf1-70b85078e012" "answer-43dc56a9-ef06-5ad5-95ce-cadbd8aaaa52" "answer-5de57ac8-c0f1-53fd-85b6-a8da90591bd7" "answer-3a9dcd64-e665-5bbe-99de-6af676869a0e" "answer-0293cb2c-bda1-5c83-8a0c-78a43f11388d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9e04f32-f49f-5493-8cf1-70b85078e012" :answer/id #uuid "e9e04f32-f49f-5493-8cf1-70b85078e012" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-43dc56a9-ef06-5ad5-95ce-cadbd8aaaa52" :answer/id #uuid "43dc56a9-ef06-5ad5-95ce-cadbd8aaaa52" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-5de57ac8-c0f1-53fd-85b6-a8da90591bd7" :answer/id #uuid "5de57ac8-c0f1-53fd-85b6-a8da90591bd7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-3a9dcd64-e665-5bbe-99de-6af676869a0e" :answer/id #uuid "3a9dcd64-e665-5bbe-99de-6af676869a0e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-0293cb2c-bda1-5c83-8a0c-78a43f11388d" :answer/id #uuid "0293cb2c-bda1-5c83-8a0c-78a43f11388d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-5b344d92-93c1-5290-a0ad-6b1e4107b056" :question/id #uuid "5b344d92-93c1-5290-a0ad-6b1e4107b056" :question/math-academy-id "q-99873" :question/problem "Evaluate $\\frac{p(5p-2)}{6(3p+8)}$ for $p=-3.$" :question/worked-solution "We replace $p$ with $-3$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{p(5p-2)}{6(3p+8)} & = \\\\ \\frac{(-3)(5(-3)-2)}{6(3(-3)+8)} & = \\\\ \\frac{(-3)(-15-2)}{6(-9+8)} & = \\\\ \\frac{(-3)(-17)}{6(-1)} & = \\\\ \\frac{51}{(-6)} & = \\\\ -\\frac{17}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-14dd0833-e969-55f0-900c-6ed71684dc4e"] :db/ensure [:question/validate]} {:db/id "answer-field-14dd0833-e969-55f0-900c-6ed71684dc4e" :answer-field/id #uuid "14dd0833-e969-55f0-900c-6ed71684dc4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8998867c-2920-592a-b642-f1440b72c516" :answer-field/choices ["answer-8998867c-2920-592a-b642-f1440b72c516" "answer-d88a5b69-267c-5551-979c-1ae79b8e5657" "answer-492ca173-32de-5ad3-ab96-01eda6d35cd3" "answer-73fd8ce8-60c1-5892-97a7-ca62b504e224" "answer-9a93ac9b-b8c1-54ca-9c6c-3304b49dca1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-8998867c-2920-592a-b642-f1440b72c516" :answer/id #uuid "8998867c-2920-592a-b642-f1440b72c516" :answer/type :answer.type/math :answer/value "-\\frac{17}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d88a5b69-267c-5551-979c-1ae79b8e5657" :answer/id #uuid "d88a5b69-267c-5551-979c-1ae79b8e5657" :answer/type :answer.type/math :answer/value "-\\frac{1}{17}" :db/ensure [:answer/validate]} {:db/id "answer-492ca173-32de-5ad3-ab96-01eda6d35cd3" :answer/id #uuid "492ca173-32de-5ad3-ab96-01eda6d35cd3" :answer/type :answer.type/math :answer/value "-\\frac{2}{17}" :db/ensure [:answer/validate]} {:db/id "answer-73fd8ce8-60c1-5892-97a7-ca62b504e224" :answer/id #uuid "73fd8ce8-60c1-5892-97a7-ca62b504e224" :answer/type :answer.type/math :answer/value "-\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "answer-9a93ac9b-b8c1-54ca-9c6c-3304b49dca1a" :answer/id #uuid "9a93ac9b-b8c1-54ca-9c6c-3304b49dca1a" :answer/type :answer.type/math :answer/value "-\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "question-e26eed03-f29f-5ce3-a1e7-151a8b9035cd" :question/id #uuid "e26eed03-f29f-5ce3-a1e7-151a8b9035cd" :question/math-academy-id "q-175875" :question/problem "If $p=5,$ then $\\frac{3p}{10}+\\frac{1}{p}=${{field-1}}." :question/worked-solution "We replace $p$ with $5$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{3p}{10}+\\frac{1}{p}= \\\\ \\frac{3(5)}{10}+\\frac{1}{5} & = \\\\ \\frac{15}{10}+\\frac{1}{5} & = \\\\ \\frac{15}{10}+\\frac{2}{10} & = \\\\ \\frac{15+2}{10} & = \\\\ \\frac{17}{10}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5cc10fd6-407a-53fb-b5c9-ca815a84b79f"] :db/ensure [:question/validate]} {:db/id "answer-field-5cc10fd6-407a-53fb-b5c9-ca815a84b79f" :answer-field/id #uuid "5cc10fd6-407a-53fb-b5c9-ca815a84b79f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-72bc25be-0c58-52ca-abbd-b05107247f5b" :answer-field/choices ["answer-72bc25be-0c58-52ca-abbd-b05107247f5b"] :db/ensure [:answer-field/validate]} {:db/id "answer-72bc25be-0c58-52ca-abbd-b05107247f5b" :answer/id #uuid "72bc25be-0c58-52ca-abbd-b05107247f5b" :answer/type :answer.type/math :answer/value "\\frac{17}{10}" :db/ensure [:answer/validate]} {:db/id "question-9225fcc6-6a47-5dc8-ba01-452e86bfb00e" :question/id #uuid "9225fcc6-6a47-5dc8-ba01-452e86bfb00e" :question/math-academy-id "q-173732" :question/problem "If $x=4,$ then $\\frac{4}{x}+\\frac{12}{5x}=${{field-1}}." :question/worked-solution "We replace $x$ with $4$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{4}{x}+\\frac{12}{5x} & = \\\\ \\frac{4}{4}+\\frac{12}{5\\cdot 4} & = \\\\ 1+\\frac{3}{5} & = \\\\ \\frac{5}{5}+\\frac{3}{5} & = \\\\ \\frac{5+3}{5} & = \\\\ \\frac{8}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0f109fc3-9149-5bcd-ab8c-1f1c08cac4eb"] :db/ensure [:question/validate]} {:db/id "answer-field-0f109fc3-9149-5bcd-ab8c-1f1c08cac4eb" :answer-field/id #uuid "0f109fc3-9149-5bcd-ab8c-1f1c08cac4eb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer-field/choices ["answer-7f65767b-700b-514d-abc3-d7fa9a5ea4a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer/id #uuid "7f65767b-700b-514d-abc3-d7fa9a5ea4a1" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id "question-15e3ee11-29b6-56d8-a84c-a4bce1a94db1" :question/id #uuid "15e3ee11-29b6-56d8-a84c-a4bce1a94db1" :question/math-academy-id "q-67237" :question/problem "Evaluate $\\frac{6x}{2t}-\\frac{3x}{t}$ if $x=-1$ and $t=3$ ." :question/worked-solution "We replace $x$ with $-1$ and $t$ with $3$ in the expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6x}{2t}-\\frac{3x}{t} & = \\\\ \\frac{6(-1)}{2(3)}-\\frac{3(-1)}{3} & = \\\\ \\frac{-6}{6}-\\frac{-3}{3} & = \\\\ -1-(-1) & = \\\\ 0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5ce10bcb-f75f-5da4-9cc0-483d51851272"] :db/ensure [:question/validate]} {:db/id "answer-field-5ce10bcb-f75f-5da4-9cc0-483d51851272" :answer-field/id #uuid "5ce10bcb-f75f-5da4-9cc0-483d51851272" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-948f56c7-8f8d-5b25-a476-f644a3998656" :answer-field/choices ["answer-6bf40da0-404d-5051-9d95-09134da5b392" "answer-948f56c7-8f8d-5b25-a476-f644a3998656" "answer-8e50ea8a-2303-5b56-a731-389bce2ade00" "answer-13cd9def-d62d-523f-bcc8-d8abfd3e4096" "answer-0fa47c90-822e-5cae-9c90-9811be703303"] :db/ensure [:answer-field/validate]} {:db/id "answer-6bf40da0-404d-5051-9d95-09134da5b392" :answer/id #uuid "6bf40da0-404d-5051-9d95-09134da5b392" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "answer-948f56c7-8f8d-5b25-a476-f644a3998656" :answer/id #uuid "948f56c7-8f8d-5b25-a476-f644a3998656" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-8e50ea8a-2303-5b56-a731-389bce2ade00" :answer/id #uuid "8e50ea8a-2303-5b56-a731-389bce2ade00" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-13cd9def-d62d-523f-bcc8-d8abfd3e4096" :answer/id #uuid "13cd9def-d62d-523f-bcc8-d8abfd3e4096" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-0fa47c90-822e-5cae-9c90-9811be703303" :answer/id #uuid "0fa47c90-822e-5cae-9c90-9811be703303" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-c7c69cd2-d2ae-54a6-bb6d-38d0dd05009e" :question/id #uuid "c7c69cd2-d2ae-54a6-bb6d-38d0dd05009e" :question/math-academy-id "q-175906" :question/problem "If $x=-4$ and $y=3,$ then $\\frac{3x+2}{3}+\\frac{x+y}{2y}=${{field-1}}." :question/worked-solution "Replacing $x$ with $-4$ and $y$ with $3$ in the expression, we get the following:\n\n$$\n\\begin{aligned}\\frac{3x+2}{3}+\\frac{x+y}{2y} & = \\\\ \\frac{3(-4)+2}{3}+\\frac{-4+3}{2(3)} & = \\\\ \\frac{-12+2}{3}+\\frac{(-1)}{6} & = \\\\ -\\frac{10}{3}-\\frac{1}{6} & = \\\\ -\\frac{20}{6}-\\frac{1}{6} & = \\\\ \\frac{-20-1}{6} & = \\\\ -\\frac{21}{6} & = \\\\ -\\frac{7}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f7d10e84-318f-5815-a469-6c3b1e58e115"] :db/ensure [:question/validate]} {:db/id "answer-field-f7d10e84-318f-5815-a469-6c3b1e58e115" :answer-field/id #uuid "f7d10e84-318f-5815-a469-6c3b1e58e115" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-90695084-425d-5a63-8e98-c52c1fc270bc" :answer-field/choices ["answer-90695084-425d-5a63-8e98-c52c1fc270bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-90695084-425d-5a63-8e98-c52c1fc270bc" :answer/id #uuid "90695084-425d-5a63-8e98-c52c1fc270bc" :answer/type :answer.type/math :answer/value "-\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id 17592186135171 :tutorial/content "A **rational expression** is, roughly speaking, an algebraic expression that's in the form of a fraction, or contains fractions.\n\nTo evaluate a rational expression like $\\dfrac 6 x$ for $x=2,$ all we need to do is replace $x$ with $2$ in the above expression and simplify as much as possible.\n\n$$\n\\begin{aligned}\\frac{6}{x}=\\frac{6}{2}=3\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186134036 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} [:db/retract 17592186229678 :question/answer-fields 17592186228250] [:db/retract 17592186308005 :answer-field/choices 17592186307377] [:db/retract 17592186310976 :answer-field/choices 17592186310093] [:db/retract 17592186311181 :answer-field/choices 17592186310157] [:db/retract 17592186310930 :answer-field/choices 17592186309498] [:db/retract 17592186311107 :answer-field/choices 17592186309667] [:db/retract 17592186310906 :answer-field/choices 17592186310412] [:db/retract 17592186307690 :answer-field/choices 17592186307115] [:db/retract 17592186307541 :answer-field/choices 17592186305524] {:db/id 17592186228914 :question/problem "![](images/b2/b295374b3b08a5d81309c92f39b38e29f1e44159a8c96e7fdfeb4cc561818585.svg)\nFind the solution to the initial value problem above.\n\n*Hint: ![](images/e7/e773bbc2fc731a397cc747fffa2e5424a30a513e8b56e0337c56bbbe7953f837.svg) where ![](images/9b/9b205047979771af4c5e88a6a9798729cb464fa080b0b46cbfc70b3c77ce8a83.svg)*" :question/worked-solution "Writing our system in matrix form, we get\n![](images/80/8004eea851883dbf0360ca3e5f39678967cdf5060668508f65cf3e5d54d6b027.svg)\nwhere ![](images/eb/ebe84b2cfbe7f95afe2c819b1d1d7790061c81744295076ac5bc739c13832dbe.svg) and ![](images/ed/edd1f7c4e50501b6849b37c98e822621d64d2f5d90a5de35b96d569814bb2a3a.svg) So, the matrix of the system is ![](images/5c/5c91edafde3ff3c119a58783296b9f8c56ecd3604d6b663af6d764a911fe1d72.svg)\n\nGiven the system $\\mathbf{x}'(t) = A \\mathbf{x}(t)+\\mathbf{g}(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\n\\mathbf{x}(t) = \\underbrace{e^{A(t-t_0)} \\, \\mathbf{x}(t_0)}_{\\text{homogeneous part}} + \\underbrace{\\int_{t_0}^{t} e^{A(t-s)} \\mathbf{g}(s) \\, \\text{d}s}_{\\text{particular solution}},\n$$\n\nwhere $\\mathbf x(t_0)$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n![](images/ed/ed77716162d9ecdeee50cd26172985ed4a5038cad903ca4729da1d9895fc9cc4.svg)\nSince the initial conditions are given at $t = t_0 = 0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}x(0) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{3t} & t{e}^{3t} \\\\ 0 & {e}^{3t}\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n![](images/22/22f92a117def6f3377a72f871d58d23cf339290a55c0f7d297ccb797b5046bf7.svg)\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}{e}^{3(t-s)} & (t-s){e}^{3(t-s)} \\\\ 0 & {e}^{3(t-s)}\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{3(t-s)} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{-3s+3t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}{e}^{-3s+3t} \\\\ 0\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\frac{1}{3}{e}^{-3s+3t} \\\\ 0\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\frac{1}{3}{e}^{3t}-\\frac{1}{3} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\frac{1}{3}{e}^{3t}-\\frac{1}{3} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3}{e}^{3t}-\\frac{1}{3} \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}{e}^{3t}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n![](images/34/348882682fbf17c25c759980898770a40422158cc3592d1fa51aa73a941f5cb6.svg)" :db/ensure [:question/validate]} {:db/id 17592186229133 :knowledge-point/questions ["question-87681964-b1bd-5510-b05d-db92c8b0be06"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186228915 :question/problem "Consider the inhomogeneous system  $\\mathbf{x}'(t)=A\\mathbf{x}(t)+\\mathbf{g}(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $\\mathbf{x}(t)$ passing through $\\mathbf{x}(t_0)$ is presented below.\n\n$\\textrm{L1}{:}\\;$ Let $\\mathbf{y}(t)=e^{-A(t-t_0)}\\mathbf{x}(t)$  \n\n$\\textrm{L2}{:}\\;$ $\\mathbf{y}'(t) = -Ae^{-A(t-t_0)}\\mathbf{x}(t) + e^{-A(t-t_0)}\\mathbf{x}'(t)$  \n\n$\\textrm{L3}{:}\\;$ $\\mathbf{y}'(t)=e^{-A(t-t_0)}\\mathbf{g}(t)$  \n\n$\\textrm{L4}{:}\\;$ $\\displaystyle\\mathbf{y}(t)-\\mathbf{y}(t_0) = \\int_{t_0}^{t} e^{-A(s-t_0)}\\mathbf{g}(s) \\, \\text{d}s$\n\n$\\textrm{L5}{:}\\;$ $\\mathbf{y}(t_0)=\\mathbf{x}(t_0)$ \n\n$\\textrm{L6}{:}\\;$ $\\displaystyle\\mathbf{y}(t)=\\mathbf{x}(t_0)+\\int_{t_0}^{t} e^{-A(s-t_0)}\\mathbf{g}(s) \\, \\text{d}s$  \n\n$\\textrm{L7}{:}\\;$ $\\displaystyle e^{A(t-t_0)}\\mathbf{y}(t)=e^{A(t-t_0)}\\mathbf{x}(t_0)+\\int_{t_0}^{t} e^{A(t-s)}\\mathbf{g}(s) \\, \\text{d}s$\n\n$\\textrm{L8}{:}\\;$ $e^{A(t-t_0)}\\mathbf{y}(t)=\\mathbf{x}(t)$\n\n$\\textrm{L9}{:}\\;$ $\\displaystyle\\mathbf{x}(t)=e^{A(t-t_0)}\\mathbf{x}(t_0)+\\int_{t_0}^{t} e^{A(t-s)}\\mathbf{g}(s) \\, \\text{d}s$\n\nFill in the blanks with the correct reasons to justify each step of the reasoning.\n\n$\\quad$ Line $\\textrm{L3}$ follows from $\\textrm{L2}$ by  ![](images/a5/a57b16a4b4392ad68547e3192dfde0c795d11e960c5100e14cd54c275df18415.svg).\n\n$\\quad$ Line $\\textrm{L5}$ follows from line $\\textrm{L1}$ by ![](images/28/281de511438021a8e37a938beb7039bb060a44f944da15128634c8a037f9830e.svg).\n\n$\\quad$ Line $\\textrm{L8}$ follows from line $\\textrm{L1}$ by ![](images/62/62aae06fe282decc2963be0ca8d0018b30fac355624b46226e93d27033a6e2e2.svg)." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\textrm{L2}$ and $\\textrm{L3}.$ Starting from\n\n$$\n\\mathbf{y}'(t) = -Ae^{-A(t-t_0)}\\mathbf{x}(t) + e^{-A(t-t_0)}\\mathbf{x}'(t)\n$$\n\nin $\\textrm{L2}$ and substituting $\\mathbf{x}'(t)=A\\mathbf{x}(t)+\\mathbf{g}(t)$ from the original system gives\n\n$$\n\\begin{aligned}{y}^{′}(t) & =-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}(Ax(t)+g(t)) \\\\  & =-A{e}^{-A(t-{t}_{0})}x(t)+A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}g(t) \\\\  & ={e}^{-A(t-{t}_{0})}g(t).\\end{aligned}\n$$\n\nThus, $\\textrm{L3}$ follows from $\\textrm{L2}$ by ![](images/83/83729359deb05033193c0efafb53f3d3164d7974543a2549eb63276bbd834311.svg)\n\n- Next, we consider lines $\\textrm{L1}$ and $\\textrm{L5}.$ Evaluating $\\mathbf{y}(t)=e^{-A(t-t_0)}\\mathbf{x}(t)$ at $t=t_0$ gives\n\n$$\n\\mathbf{y}(t_0)=e^{-A(t_0-t_0)}\\mathbf{x}(t_0)=I\\mathbf{x}(t_0)=\\mathbf{x}(t_0).\n$$\n\nTherefore, $\\textrm{L5}$ follows from line $\\textrm{L1}$  by ![](images/7e/7e6ad910e9037e26dc2fd533bbab660b6c6f90e48b05975b071390d6063a9219.svg)\n\n- Finally, we consider lines $\\textrm{L1}$ and $\\textrm{L8}.$ Multiplying both sides of\n\n$$\n\\mathbf{y}(t)=e^{-A(t-t_0)}\\mathbf{x}(t)\n$$\n\nfrom $\\textrm{L1}$ by $e^{A(t-t_0)}$ gives\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})}y(t) & ={e}^{A(t-{t}_{0})}{e}^{-A(t-{t}_{0})}x(t) \\\\  & =x(t).\\end{aligned}\n$$\n\nTherefore, $\\textrm{L8}$ follows from $\\textrm{L1}$ by ![](images/75/759ebf5f590b98c90b82384ce915060a412eeb20af8f9fe0949dacb9a1b9980f.svg)" :db/ensure [:question/validate]} {:db/id 17592186229131 :knowledge-point/questions ["question-55496bb1-52a1-5f42-8a88-3b3b54310c44" "question-462afb47-f28d-50fb-a384-b84e85e58f07"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186396516 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"170px\">$3\\operatorname{cosh}⁡(2(t-1))+\\operatorname{sinh}⁡(2(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td><td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"170px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">${e}^{2s}\\operatorname{sinh}⁡(2(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id "question-55496bb1-52a1-5f42-8a88-3b3b54310c44" :question/id #uuid "55496bb1-52a1-5f42-8a88-3b3b54310c44" :question/math-academy-id "q-334927" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}]x+[\\begin{aligned}0 \\\\ {e}^{4t}\\end{aligned}],\\,x(1)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">$5\\operatorname{sin}⁡(4(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">${e}^{4s}\\operatorname{cos}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cos}⁡(4(t-1)) & \\operatorname{sin}⁡(4(t-1)) \\\\ -\\operatorname{sin}⁡(4(t-1)) & \\operatorname{cos}⁡(4(t-1))\\end{aligned}][\\begin{aligned}0 \\\\ 5\\end{aligned}] \\\\  & =[\\begin{aligned}5\\operatorname{sin}⁡(4(t-1)) \\\\ 5\\operatorname{cos}⁡(4(t-1))\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(4(t-s)) & \\operatorname{sin}⁡(4(t-s)) \\\\ -\\operatorname{sin}⁡(4(t-s)) & \\operatorname{cos}⁡(4(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ {e}^{4s}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{4s}\\operatorname{sin}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cos}⁡(4(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}5\\operatorname{sin}⁡(4(t-1)) \\\\ 5\\operatorname{cos}⁡(4(t-1))\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{4s}\\operatorname{sin}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cos}⁡(4(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b68e6796-375b-5d49-8e2e-66926ee5d502" "answer-field-1954211e-be5b-5ec7-9793-f1e117c5135a"] :db/ensure [:question/validate]} {:db/id "answer-field-b68e6796-375b-5d49-8e2e-66926ee5d502" :answer-field/id #uuid "b68e6796-375b-5d49-8e2e-66926ee5d502" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2d30f021-ca55-5b32-8ba2-aebcfc919c9f" :answer-field/choices ["answer-2d30f021-ca55-5b32-8ba2-aebcfc919c9f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d30f021-ca55-5b32-8ba2-aebcfc919c9f" :answer/id #uuid "2d30f021-ca55-5b32-8ba2-aebcfc919c9f" :answer/type :answer.type/math :answer/value "{e}^{4s}\\operatorname{sin}⁡(4(t-s))" :db/ensure [:answer/validate]} {:db/id "answer-field-1954211e-be5b-5ec7-9793-f1e117c5135a" :answer-field/id #uuid "1954211e-be5b-5ec7-9793-f1e117c5135a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-508628f6-63a5-5e6a-a776-4ba0722db871" :answer-field/choices ["answer-508628f6-63a5-5e6a-a776-4ba0722db871"] :db/ensure [:answer-field/validate]} {:db/id "answer-508628f6-63a5-5e6a-a776-4ba0722db871" :answer/id #uuid "508628f6-63a5-5e6a-a776-4ba0722db871" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡(4(t-1))" :db/ensure [:answer/validate]} {:db/id 17592186308696 :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}]x+[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,x(0)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">$5\\operatorname{sin}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$-\\operatorname{sin}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186307584 :answer-field/correct "answer-74474233-2fa8-51ba-9cb4-da5296695f41" :answer-field/choices ["answer-74474233-2fa8-51ba-9cb4-da5296695f41"] :db/ensure [:answer-field/validate]} {:db/id "answer-74474233-2fa8-51ba-9cb4-da5296695f41" :answer/id #uuid "74474233-2fa8-51ba-9cb4-da5296695f41" :answer/type :answer.type/math :answer/value "\\cos(4(t-s))" :db/ensure [:answer/validate]} {:db/id 17592186307623 :answer-field/correct "answer-677ff288-ab7f-56c0-a677-5f7330959d63" :answer-field/choices ["answer-677ff288-ab7f-56c0-a677-5f7330959d63"] :db/ensure [:answer-field/validate]} {:db/id "answer-677ff288-ab7f-56c0-a677-5f7330959d63" :answer/id #uuid "677ff288-ab7f-56c0-a677-5f7330959d63" :answer/type :answer.type/math :answer/value "5\\cos(4t)" :db/ensure [:answer/validate]} {:db/id "question-462afb47-f28d-50fb-a384-b84e85e58f07" :question/id #uuid "462afb47-f28d-50fb-a384-b84e85e58f07" :question/math-academy-id "q-334920" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}]x+[\\begin{aligned}0 \\\\ {e}^{4t}\\end{aligned}],\\,x(0)=[\\begin{aligned}1 \\\\ 3\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">$\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td><td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">${e}^{4s}\\operatorname{sinh}⁡(4(t-s))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{At}\\,x(0) & =[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}][\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ {e}^{4s}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{4s}\\operatorname{sinh}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}{e}^{4s}\\operatorname{sinh}⁡(4(t-s)) \\\\ {e}^{4s}\\operatorname{cosh}⁡(4(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4952d3ec-dd70-5ca3-b11d-7bddbd2cbfa1" "answer-field-d776bb26-ce4b-5844-8f89-c1e2c8830a03"] :db/ensure [:question/validate]} {:db/id "answer-field-4952d3ec-dd70-5ca3-b11d-7bddbd2cbfa1" :answer-field/id #uuid "4952d3ec-dd70-5ca3-b11d-7bddbd2cbfa1" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-740b8e1d-0233-597c-ac41-6431abd888f5" :answer-field/choices ["answer-deba3bee-d355-5039-ab99-fbef85ee9df4" "answer-1469716d-c345-5ffe-8890-e1981e80d56a" "answer-740b8e1d-0233-597c-ac41-6431abd888f5" "answer-3a5c4e43-e417-5c07-a2c3-eb9628d96e3b"] :db/ensure [:answer-field/validate]} {:db/id "answer-deba3bee-d355-5039-ab99-fbef85ee9df4" :answer/id #uuid "deba3bee-d355-5039-ab99-fbef85ee9df4" :answer/type :answer.type/math :answer/value "3\\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "answer-1469716d-c345-5ffe-8890-e1981e80d56a" :answer/id #uuid "1469716d-c345-5ffe-8890-e1981e80d56a" :answer/type :answer.type/math :answer/value "3\\operatorname{sinh}⁡(4t)+\\operatorname{cosh}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "answer-740b8e1d-0233-597c-ac41-6431abd888f5" :answer/id #uuid "740b8e1d-0233-597c-ac41-6431abd888f5" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(4t)+3\\operatorname{cosh}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "answer-3a5c4e43-e417-5c07-a2c3-eb9628d96e3b" :answer/id #uuid "3a5c4e43-e417-5c07-a2c3-eb9628d96e3b" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(4t)-3\\operatorname{cosh}⁡(4t)" :db/ensure [:answer/validate]} {:db/id "answer-field-d776bb26-ce4b-5844-8f89-c1e2c8830a03" :answer-field/id #uuid "d776bb26-ce4b-5844-8f89-c1e2c8830a03" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-76d12e8f-d604-5766-8275-33330f073e0a" :answer-field/choices 