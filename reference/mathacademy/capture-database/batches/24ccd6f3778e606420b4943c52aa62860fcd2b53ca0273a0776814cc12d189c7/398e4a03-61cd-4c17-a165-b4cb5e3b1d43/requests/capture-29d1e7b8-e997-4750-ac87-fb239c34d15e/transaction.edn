[{:db/id 17592186078574 :knowledge-point/questions ["question-61aa5cdd-68ec-5b7d-a4df-b02fb60d2719" "question-d2db0e2b-c2ae-5849-b446-12d0b1a083c2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078150 :question/worked-solution "The expression $3^{-1}$ means the reciprocal of $3$. Hence\n\n$$\n3^{-1} = \\dfrac{1}{3}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186078575 :knowledge-point/questions ["question-8a458e24-cc7c-5bd6-9622-f18c8346613c" "question-05d822fa-9466-542c-b991-b0e81032fa5c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078151 :question/problem "What is $(-4)^{-1}?$" :question/worked-solution "The expression $(-4)^{-1}$ means the reciprocal of $-4.$ Therefore,\n\n$$\n(-4)^{-1} = -\\dfrac{1}{4}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186078576 :knowledge-point/questions ["question-bfba5122-2e77-55a1-99f5-47e064f8cc14" "question-da68c3e8-bcc9-5b44-b44b-1f5e2fc2eb9a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078152 :question/problem "Evaluate $\\left(\\dfrac{2}{3}\\right)^{-1}.$" :question/worked-solution "The expression $\\left(\\dfrac{2}{3}\\right)^{-1}$ means the reciprocal of $\\dfrac{2}{3}.$ Therefore,\n\n$$\n\\left(\\dfrac{2}{3}\\right)^{-1} = \\dfrac{3}{2}.\n$$" :db/ensure [:question/validate]} {:db/id "question-61aa5cdd-68ec-5b7d-a4df-b02fb60d2719" :question/id #uuid "61aa5cdd-68ec-5b7d-a4df-b02fb60d2719" :question/math-academy-id "q-100198" :question/problem "${25}^{-1}=$" :question/worked-solution "The expression ${25}^{-1}$ means the reciprocal of $25.$ Hence\n\n$$\n{25}^{-1}=\\frac{1}{25}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5ee317b4-35bb-511b-b6aa-37c74d7daf5e"] :db/ensure [:question/validate]} {:db/id "answer-field-5ee317b4-35bb-511b-b6aa-37c74d7daf5e" :answer-field/id #uuid "5ee317b4-35bb-511b-b6aa-37c74d7daf5e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-96538560-76c0-5