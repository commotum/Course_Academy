6b48621-49d9-5b78-b295-e4625cfd3145" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fead1c73-30c9-59a8-94c2-69c1b572ca7f" :answer-field/choices ["answer-a5613e99-0c63-5fea-a3f4-de16d9f37878" "answer-76dd4622-7b42-5852-945a-b5eead441723" "answer-be0124c8-a638-5d71-8192-beef025b53d4" "answer-0c9b5b22-1261-57ae-b393-0b6b1b6c421d" "answer-fead1c73-30c9-59a8-94c2-69c1b572ca7f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5613e99-0c63-5fea-a3f4-de16d9f37878" :answer/id #uuid "a5613e99-0c63-5fea-a3f4-de16d9f37878" :answer/type :answer.type/math :answer/value "1+2{n}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-76dd4622-7b42-5852-945a-b5eead441723" :answer/id #uuid "76dd4622-7b42-5852-945a-b5eead441723" :answer/type :answer.type/math :answer/value "1+4{n}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-be0124c8-a638-5d71-8192-beef025b53d4" :answer/id #uuid "be0124c8-a638-5d71-8192-beef025b53d4" :answer/type :answer.type/math :answer/value "1-2{n}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0c9b5b22-1261-57ae-b393-0b6b1b6c421d" :answer/id #uuid "0c9b5b22-1261-57ae-b393-0b6b1b6c421d" :answer/type :answer.type/math :answer/value "1-4{n}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-fead1c73-30c9-59a8-94c2-69c1b572ca7f" :answer/id #uuid "fead1c73-30c9-59a8-94c2-69c1b572ca7f" :answer/type :answer.type/math :answer/value "1-4{n}^{4}" :db/ensure [:answer/validate]} {:db/id "question-4a8a7bf3-5b8f-5a40-b9f8-b1ddba947324" :question/id #uuid "4a8a7bf3-5b8f-5a40-b9f8-b1ddba947324" :question/math-academy-id "q-31176" :question/problem "$({x}^{m}-2{y}^{n})({x}^{m}+2{y}^{n})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a={x}^{m}$ and $b=2{y}^{n},$ we have\n\n$$\n\\begin{aligned}({x}^{m}-2{y}^{n})({x}^{m}+2{y}^{n}) & = \\\\ {({x}^{m})}^{2}-{(2{y}^{n})}^{2} & = \\\\ {({x}^{m})}^{2}-{2}^{2}\\cdot {({y}^{n})}^{2} & = \\\\ {x}^{2m}-4{y}^{2n}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c66292c-e36a-5e53-8923-f81b1303b890"] :db/ensure [:question/validate]} {:db/id "answer-field-9c66292c-e36a-5e53-8923-f81b1303b890" :answer-field/id #uuid "9c66292c-e36a-5e53-8923-f81b1303b890" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8651a14d-b29c-5410-b18b-9006aa26e59b" :answer-field/choices ["answer-a96ea889-07a5-542d-bfc6-b28a257fafd9" "answer-f72a7406-29d1-50c7-b869-6a5dfeeab416" "answer-79fb38e2-b8f8-59e4-8e66-c482f633d831" "answer-8651a14d-b29c-5410-b18b-9006aa26e59b" "answer-c8e6d4be-489a-5d61-86a2-a12c1aba0257"] :db/ensure [:answer-field/validate]} {:db/id "answer-a96ea889-07a5-542d-bfc6-b28a257fafd9" :answer/id #uuid "a96ea889-07a5-542d-bfc6-b28a257fafd9" :answer/type :answer.type/math :answer/value "2{x}^{m}+{x}^{m}{y}^{n}-2{y}^{n}" :db/ensure [:answer/validate]} {:db/id "answer-f72a7406-29d1-50c7-b869-6a5dfeeab416" :answer/id #uuid "f72a7406-29d1-50c7-b869-6a5dfeeab416" :answer/type :answer.type/math :answer/value "{x}^{2m}+4{x}^{m}{y}^{n}+2{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-79fb38e2-b8f8-59e4-8e66-c482f633d831" :answer/id #uuid "79fb38e2-b8f8-59e4-8e66-c482f633d831" :answer/type :answer.type/math :answer/value "{x}^{2m}+{x}^{m}{y}^{n}-2{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-8651a14d-b29c-5410-b18b-9006aa26e59b" :answer/id #uuid "8651a14d-b29c-5410-b18b-9006aa26e59b" :answer/type :answer.type/math :answer/value "{x}^{2m}-4{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-c8e6d4be-489a-5d61-86a2-a12c1aba0257" :answer/id #uuid "c8e6d4be-489a-5d61-86a2-a12c1aba0257" :answer/type :answer.type/math :answer/value "{x}^{m}+{x}^{m}{y}^{n}-2{y}^{n}" :db/ensure [:answer/validate]} {:db/id 17592186139152 :question/problem "$({x}^{n}+3{y}^{n})({x}^{n}-3{y}^{n})=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a={x}^{n}$ and $b=3{y}^{n},$ we have\n\n$$\n\\begin{aligned}({x}^{n}+3{y}^{n})({x}^{n}-3{y}^{n}) & = \\\\ {({x}^{n})}^{2}-(3{y}^{n})^{2} & = \\\\ {x}^{2n}-{3}^{2}\\cdot ({y}^{n})^{2} & = \\\\ {x}^{2n}-9{y}^{2n}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186137860 :answer-field/correct "answer-754ba023-6388-50a6-b77b-a9be36a73709" :answer-field/choices ["answer-e3950d0a-a3f2-5ea2-abeb-da47c233ce45" "answer-d4151343-07d5-5eba-9fab-f9f55fdb3683" "answer-1915d7ff-b586-5fb5-90f4-d69da270222f" "answer-b3e00615-af87-5a34-8ad3-47a40357e4de" "answer-754ba023-6388-50a6-b77b-a9be36a73709"] :db/ensure [:answer-field/validate]} {:db/id "answer-e3950d0a-a3f2-5ea2-abeb-da47c233ce45" :answer/id #uuid "e3950d0a-a3f2-5ea2-abeb-da47c233ce45" :answer/type :answer.type/math :answer/value "{x}^{2n}+3{x}^{n}{y}^{n}-9{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-d4151343-07d5-5eba-9fab-f9f55fdb3683" :answer/id #uuid "d4151343-07d5-5eba-9fab-f9f55fdb3683" :answer/type :answer.type/math :answer/value "{x}^{2n}+6{x}^{n}{y}^{n}-9{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-1915d7ff-b586-5fb5-90f4-d69da270222f" :answer/id #uuid "1915d7ff-b586-5fb5-90f4-d69da270222f" :answer/type :answer.type/math :answer/value "{x}^{2n}+9{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-b3e00615-af87-5a34-8ad3-47a40357e4de" :answer/id #uuid "b3e00615-af87-5a34-8ad3-47a40357e4de" :answer/type :answer.type/math :answer/value "{x}^{2n}-6{x}^{n}{y}^{n}-9{y}^{2n}" :db/ensure [:answer/validate]} {:db/id "answer-754ba023-6388-50a6-b77b-a9be36a73709" :answer/id #uuid "754ba023-6388-50a6-b77b-a9be36a73709" :answer/type :answer.type/math :answer/value "{x}^{2n}-9{y}^{2n}" :db/ensure [:answer/validate]} {:db/id 17592186139725 :tutorial/content "The **difference of squares formula** states the product of the sum and the difference of two monomials is equal to the difference of their squares:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nWe can check that this result is correct by expanding the binomial in the usual way, as follows:\n\n$$\n\\eqalign{\n\t\t({\\color{blue}a} + {\\color{red}b})(a - b) &= \\[5pt]\n\t\t{\\color{blue}a}(a - b) + {\\color{red}b}(a - b) &= \\[5pt]\n\t\ta^2 - ab + ab - b^2 &= \\[5pt]\n\t\ta^2 - b^2 \\,& {\\color{green}{\\checkmark}}\n\t}\n$$\n\nNotice that the middle two terms $- ab$ and $ab$ cancel each other out, leaving only $a^2 - b^2.$ \n\nIf the order of multiplication is switched, the formula still remains the same:\n\n$$\n(a - b)(a + b) = a^2 - b^2\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186138601 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186133834 :knowledge-point/questions ["question-888487e0-300d-510a-97fe-31196306b818"] :db/ensure [:knowledge-point/validate]} {:db/id "question-888487e0-300d-510a-97fe-31196306b818" :question/id #uuid "888487e0-300d-510a-97fe-31196306b818" :question/math-academy-id "q-81344" :question/problem "If $D$ is the finite region enclosed by the curves $y=1-{x}^{2}$ and $y=x-1,$ then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's make a sketch of our region.\n\n![](images/24/24683f81da1c7e90ccbd51748f5f46407137be4a40ef5f0678292b70f0781eff.png)\n\nNow, let's represent $D$ as a type I region. \n\n- To determine the $x$-limits, we need to find the $x$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $x:$\n\n$$\n\\begin{aligned}1-{x}^{2} & =x-1 \\\\ {x}^{2}+x-2 & =0 \\\\ (x+2)(x-1) & =0\\end{aligned}\n$$\n\nSo, $x$-limits are \n$-2\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](images/e9/e955ad94bca70a8e6f996d81814ffa8fcc7a322d5979db7b0726d39558b6aa86.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 1,\\,x-1\\le y\\le 1-{x}^{2}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{-2}^{1}{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy\\,dx \\\\  & ={\\int }_{-2}^{1}[{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6b82a6ed-9537-5fe1-9550-c6deec72fd33"] :db/ensure [:question/validate]} {:db/id "answer-field-6b82a6ed-9537-5fe1-9550-c6deec72fd33" :answer-field/id #uuid "6b82a6ed-9537-5fe1-9550-c6deec72fd33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2fd070a6-0119-5dfa-9699-94cd22f9107e" :answer-field/choices ["answer-2f2a6974-156a-58a1-912d-d4e9e5c9106b" "answer-2fd070a6-0119-5dfa-9699-94cd22f9107e" "answer-c039e0dd-3463-5163-9811-98a986c4da00" "answer-69d1e9a7-9e40-528b-9934-3556f8295863" "answer-90fcc974-e6d1-5c13-933d-0f0e398bfcdc"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f2a6974-156a-58a1-912d-d4e9e5c9106b" :answer/id #uuid "2f2a6974-156a-58a1-912d-d4e9e5c9106b" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{1}[{\\int }_{1-{x}^{2}}^{x-1}f(x,y)\\text{ }dy]dx" :db/ensure [:answer/validate]} {:db/id "answer-2fd070a6-0119-5dfa-9699-94cd22f9107e" :answer/id #uuid "2fd070a6-0119-5dfa-9699-94cd22f9107e" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{1}[{\\int }_{x-1}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/ensure [:answer/validate]} {:db/id "answer-c039e0dd-3463-5163-9811-98a986c4da00" :answer/id #uuid "c039e0dd-3463-5163-9811-98a986c4da00" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{1-{x}^{2}}[{\\int }_{-2}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/ensure [:answer/validate]} {:db/id "answer-69d1e9a7-9e40-528b-9934-3556f8295863" :answer/id #uuid "69d1e9a7-9e40-528b-9934-3556f8295863" :answer/type :answer.type/math :answer/value "{\\int }_{x-1}^{1-{x}^{2}}[{\\int }_{-2}^{1}f(x,y)\\text{ }dy]dx" :db/ensure [:answer/validate]} {:db/id "answer-90fcc974-e6d1-5c13-933d-0f0e398bfcdc" :answer/id #uuid "90fcc974-e6d1-5c13-933d-0f0e398bfcdc" :answer/type :answer.type/math :answer/value "{\\int }_{x-1}^{1}[{\\int }_{-2}^{1-{x}^{2}}f(x,y)\\text{ }dy]dx" :db/ensure [:answer/validate]} {:db/id 17592186133836 :knowledge-point/questions ["question-c45bffe5-25bf-5869-8e87-fa24cb3ec218"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c45bffe5-25bf-5869-8e87-fa24cb3ec218" :question/id #uuid "c45bffe5-25bf-5869-8e87-fa24cb3ec218" :question/math-academy-id "q-81369" :question/problem "Evaluate the double integral ${∬}_{D}8x{y}^{3}\\,dA,\\,$\nwhere $D$ is the finite region enclosed by the circle ${x}^{2}+{y}^{2}=1$ and below the $x$-axis." :question/worked-solution "Since $y\\le 0,$ we obtain\n\n$$\n{x}^{2}+{y}^{2}=1\\,⟹\\,y=-\\sqrt{1-{x}^{2}}.\n$$\n\nLet's make a sketch of our region.\n\n![](images/9c/9c6b1dd7d81d124888ddd588027eed908a0eaecb2c42ebc79f3253c4123dbe86.png)\n\nNotice that $D$ is a type I region.\n\n- We already know the intersection of the circle with the line $y=0.$\nSo, the $x$-limits are \n$-1\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](images/bd/bd584d7481549b792e786a7186ba7ee87cd536258c5a0135f36ee17d96c4880d.png)\n\nAs a result, the integral is defined over the following type I region: \n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le 0\\}\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}8x{y}^{3}\\,dA={\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{0}8x{y}^{3}\\,dy\\,dx\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{0}8x{y}^{3}\\,dy\\,dx & ={\\int }_{-1}^{1}2x[{\\int }_{-\\sqrt{1-{x}^{2}}}^{0}4{y}^{3}\\,dy]dx \\\\  & ={\\int }_{-1}^{1}2x{[{y}^{4}]}_{-\\sqrt{1-{x}^{2}}}^{0}\\,dx \\\\  & ={\\int }_{-1}^{1}2x(0-{(-\\sqrt{1-{x}^{2}})}^{4})\\,dx \\\\  & ={\\int }_{-1}^{1}(-2x(1-{x}^{2})^{2})\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}(-2x(1-{x}^{2})^{2})\\,dx & ={[\\frac{(1-{x}^{2})^{3}}{3}]}_{-1}^{1} \\\\  & =-\\frac{(1-{1}^{2})^{3}}{3}-\\frac{(1-(-1)^{2})^{3}}{3} \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6d527e9c-2e5b-5948-a599-77a3b28decc4"] :db/ensure [:question/validate]} {:db/id "answer-field-6d527e9c-2e5b-5948-a599-77a3b28decc4" :answer-field/id #uuid "6d527e9c-2e5b-5948-a599-77a3b28decc4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-35ff924d-fce0-5c71-95a8-6294d9e42e37" :answer-field/choices ["answer-35ff924d-fce0-5c71-95a8-6294d9e42e37" "answer-f32f6e2b-ace4-5f4f-b08b-21b50a871738" "answer-6f0180ea-f116-5dcb-8c89-f5ec1242588d" "answer-1b905570-3bc1-56c6-b7bf-ad922d213480" "answer-158bc465-6c57-523d-9cf3-6f83f39945fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-35ff924d-fce0-5c71-95a8-6294d9e42e37" :answer/id #uuid "35ff924d-fce0-5c71-95a8-6294d9e42e37" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f32f6e2b-ace4-5f4f-b08b-21b50a871738" :answer/id #uuid "f32f6e2b-ace4-5f4f-b08b-21b50a871738" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-6f0180ea-f116-5dcb-8c89-f5ec1242588d" :answer/id #uuid "6f0180ea-f116-5dcb-8c89-f5ec1242588d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-1b905570-3bc1-56c6-b7bf-ad922d213480" :answer/id #uuid "1b905570-3bc1-56c6-b7bf-ad922d213480" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "answer-158bc465-6c57-523d-9cf3-6f83f39945fc" :answer/id #uuid "158bc465-6c57-523d-9cf3-6f83f39945fc" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id 17592186133835 :knowledge-point/questions ["question-790fc9b6-72db-52a7-bf88-41ac2c2d70f6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-790fc9b6-72db-52a7-bf88-41ac2c2d70f6" :question/id #uuid "790fc9b6-72db-52a7-bf88-41ac2c2d70f6" :question/math-academy-id "q-132281" :question/problem "${\\int }_{0}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\text{ }x(y-1)\\,dy\\,dx=$" :question/worked-solution "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\text{ }x(y-1)\\,dy\\,dx & ={\\int }_{0}^{1}x[{\\int }_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\text{ }(y-1)\\,dy]dx \\\\  & ={\\int }_{0}^{1}x{[\\frac{1}{2}{y}^{2}-y]}_{-\\sqrt{1-{x}^{2}}}^{\\sqrt{1-{x}^{2}}}\\,dx \\\\  & ={\\int }_{0}^{1}x(\\frac{1}{2}(1-{x}^{2})-\\sqrt{1-{x}^{2}}-\\frac{1}{2}(1-{x}^{2})-\\sqrt{1-{x}^{2}})dx \\\\  & ={\\int }_{0}^{1}x(-2\\sqrt{1-{x}^{2}})dx \\\\  & ={\\int }_{0}^{1}-2x\\sqrt{1-{x}^{2}}\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}-2x\\sqrt{1-{x}^{2}}\\,dx & ={[\\frac{2(1-{x}^{2})^{3/2}}{3}]}_{0}^{1} \\\\  & =0-\\frac{2}{3} \\\\  & =-\\frac{2}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-09e3c1e0-e6e5-5167-83b3-cae11270cfdc"] :db/ensure [:question/validate]} {:db/id "answer-field-09e3c1e0-e6e5-5167-83b3-cae11270cfdc" :answer-field/id #uuid "09e3c1e0-e6e5-5167-83b3-cae11270cfdc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-31357fe9-e1fa-537d-89ee-79b4cac4b7cf" :answer-field/choices ["answer-60d03f26-4c90-5b4e-b801-3e8d67f98fb7" "answer-31357fe9-e1fa-537d-89ee-79b4cac4b7cf" "answer-12c2c52e-7edb-55fd-994f-8e6f5b4d4dd4" "answer-4d8fcc2a-87cb-52dc-883a-bec15bf93188" "answer-15e4ed08-ffaf-52de-97e2-cfa7db153d54"] :db/ensure [:answer-field/validate]} {:db/id "answer-60d03f26-4c90-5b4e-b801-3e8d67f98fb7" :answer/id #uuid "60d03f26-4c90-5b4e-b801-3e8d67f98fb7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-31357fe9-e1fa-537d-89ee-79b4cac4b7cf" :answer/id #uuid "31357fe9-e1fa-537d-89ee-79b4cac4b7cf" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-12c2c52e-7edb-55fd-994f-8e6f5b4d4dd4" :answer/id #uuid "12c2c52e-7edb-55fd-994f-8e6f5b4d4dd4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4d8fcc2a-87cb-52dc-883a-bec15bf93188" :answer/id #uuid "4d8fcc2a-87cb-52dc-883a-bec15bf93188" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-15e4ed08-ffaf-52de-97e2-cfa7db153d54" :answer/id #uuid "15e4ed08-ffaf-52de-97e2-cfa7db153d54" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "activity-61b909f0-ec60-5577-af75-e7859906eb7e" :activity/id #uuid "61b909f0-ec60-5577-af75-e7859906eb7e" :activity/title "Double Integrals Over Type I Regions" :activity/type :activity.type/review :activity/scope 17592186049997 :activity/course 17592186046658 :activity/steps ["step-0ba397eb-27d1-5f99-9aee-673204cdeaff" "step-8054baf7-76fc-513c-bc8c-95f9b72f74a0" "step-85ca4b6f-ad35-500c-8f70-cb09fc202e4f" "step-dc3dd7a9-c45b-51da-a49f-0da3682d6427" "step-3af15913-e8bd-5162-bb11-0248e7dc9e39"] :activity/first-step "step-0ba397eb-27d1-5f99-9aee-673204cdeaff" :db/ensure [:activity/validate]} {:db/id "step-0ba397eb-27d1-5f99-9aee-673204cdeaff" :step/id #uuid "0ba397eb-27d1-5f99-9aee-673204cdeaff" :step/content "question-888487e0-300d-510a-97fe-31196306b818" :step/next "step-8054baf7-76fc-513c-bc8c-95f9b72f74a0" :db/ensure [:step/validate]} {:db/id "step-8054baf7-76fc-513c-bc8c-95f9b72f74a0" :step/id #uuid "8054baf7-76fc-513c-bc8c-95f9b72f74a0" :step/content 17592186351295 :step/next "step-85ca4b6f-ad35-500c-8f70-cb09fc202e4f" :db/ensure [:step/validate]} {:db/id "step-85ca4b6f-ad35-500c-8f70-cb09fc202e4f" :step/id #uuid "85ca4b6f-ad35-500c-8f70-cb09fc202e4f" :step/content "question-c45bffe5-25bf-5869-8e87-fa24cb3ec218" :step/next "step-dc3dd7a9-c45b-51da-a49f-0da3682d6427" :db/ensure [:step/validate]} {:db/id "step-dc3dd7a9-c45b-51da-a49f-0da3682d6427" :step/id #uuid "dc3dd7a9-c45b-51da-a49f-0da3682d6427" :step/content "question-790fc9b6-72db-52a7-bf88-41ac2c2d70f6" :step/next "step-3af15913-e8bd-5162-bb11-0248e7dc9e39" :db/ensure [:step/validate]} {:db/id "step-3af15913-e8bd-5162-bb11-0248e7dc9e39" :step/id #uuid "3af15913-e8bd-5162-bb11-0248e7dc9e39" :step/content 17592186268855 :db/ensure [:step/validate]} {:db/id 17592186171933 :knowledge-point/questions ["question-bb148c29-2fa3-5a15-9be6-3a95df07f188" "question-c4adaad6-9b04-5b58-a83e-194edc0437bb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bb148c29-2fa3-5a15-9be6-3a95df07f188" :question/id #uuid "bb148c29-2fa3-5a15-9be6-3a95df07f188" :question/math-academy-id "q-132399" :question/problem "Which digits, when inserted into the blank, make the number $35\\,832\\,4◻2$ divisible by $6?$\n\nI. $6$\n\nII. $7$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n3+5+8+3+2+4+◻+2=27+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $6$ into the blank, we get $35\\,832\\,462,$ which is divisible by $2.$ Then the sum of the digits is $27+6=33,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $7$ into the blank, we get $35\\,832\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $27+7=34,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $9$ into the blank, we get $35\\,832\\,492,$ which is divisible by $2.$ Then the sum of the digits is $27+9=36,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-39f46cce-e058-5bf2-9268-00ee8313197f"] :db/ensure [:question/validate]} {:db/id "answer-field-39f46cce-e058-5bf2-9268-00ee8313197f" :answer-field/id #uuid "39f46cce-e058-5bf2-9268-00ee8313197f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9c0a5c0-452d-5300-bcce-eff988f09d98" :answer-field/choices ["answer-f9c0a5c0-452d-5300-bcce-eff988f09d98" "answer-12afe4b3-21c1-5226-88fa-1a4798e15712" "answer-2feba7be-006f-5377-a598-baf491efcc41" "answer-d4078e9e-cf26-5341-9d23-42f6201b2a76" "answer-f188ef76-ca50-506c-82c0-30d85353b6d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9c0a5c0-452d-5300-bcce-eff988f09d98" :answer/id #uuid "f9c0a5c0-452d-5300-bcce-eff988f09d98" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-12afe4b3-21c1-5226-88fa-1a4798e15712" :answer/id #uuid "12afe4b3-21c1-5226-88fa-1a4798e15712" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-2feba7be-006f-5377-a598-baf491efcc41" :answer/id #uuid "2feba7be-006f-5377-a598-baf491efcc41" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-d4078e9e-cf26-5341-9d23-42f6201b2a76" :answer/id #uuid "d4078e9e-cf26-5341-9d23-42f6201b2a76" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-f188ef76-ca50-506c-82c0-30d85353b6d5" :answer/id #uuid "f188ef76-ca50-506c-82c0-30d85353b6d5" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "question-c4adaad6-9b04-5b58-a83e-194edc0437bb" :question/id #uuid "c4adaad6-9b04-5b58-a83e-194edc0437bb" :question/math-academy-id "q-132400" :question/problem "Which digits, when inserted into the blank, make the number $11\\,521\\,6◻6$ divisible by $6?$\n\nI. $3$\n\nII. $7$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n1+1+5+2+1+6+◻+6=22+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $3$ into the blank, we get $11\\,521\\,636,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $22+3=25,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $7$ into the blank, we get $11\\,521\\,676,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $22+7=29,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $9$ into the blank, we get $11\\,521\\,696,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $22+9=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\nTherefore, the correct answer is \"None.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f364f54-37f9-5c16-b23e-1b97b8dd9c4c"] :db/ensure [:question/validate]} {:db/id "answer-field-6f364f54-37f9-5c16-b23e-1b97b8dd9c4c" :answer-field/id #uuid "6f364f54-37f9-5c16-b23e-1b97b8dd9c4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e295efd-cfd7-5826-8bdb-23fabf9e7f01" :answer-field/choices ["answer-291773ce-54e7-5de8-a209-c43955975d44" "answer-65401151-5ed3-53b1-8618-d2d6f6d8473e" "answer-4185b1db-1e91-57f5-b0ed-f446a3cc2f83" "answer-02938ac2-a904-589b-95cf-e1e584154abd" "answer-1e295efd-cfd7-5826-8bdb-23fabf9e7f01"] :db/ensure [:answer-field/validate]} {:db/id "answer-291773ce-54e7-5de8-a209-c43955975d44" :answer/id #uuid "291773ce-54e7-5de8-a209-c43955975d44" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-65401151-5ed3-53b1-8618-d2d6f6d8473e" :answer/id #uuid "65401151-5ed3-53b1-8618-d2d6f6d8473e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4185b1db-1e91-57f5-b0ed-f446a3cc2f83" :answer/id #uuid "4185b1db-1e91-57f5-b0ed-f446a3cc2f83" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-02938ac2-a904-589b-95cf-e1e584154abd" :answer/id #uuid "02938ac2-a904-589b-95cf-e1e584154abd" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-1e295efd-cfd7-5826-8bdb-23fabf9e7f01" :answer/id #uuid "1e295efd-cfd7-5826-8bdb-23fabf9e7f01" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id 17592186172311 :question/problem "Which digits, when inserted into the blank, make the number $66\\,333\\,9◻0$ divisible by $6?$\n\nI. $0$\n\nII. $3$\n\nIII. $9$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n6+6+3+3+3+9+◻+0=30+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $0$ into the blank, we get $66\\,333\\,900,$ which is divisible by $2.$ Then the sum of the digits is $30+0=30,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $3$ into the blank, we get $66\\,333\\,930,$ which is divisible by $2.$ Then the sum of the digits is $30+3=33,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $9$ into the blank, we get $66\\,333\\,990,$ which is divisible by $2.$ Then the sum of the digits is $30+9=39,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186168729 :answer-field/correct 17592186168734 :db/ensure [:answer-field/validate]} {:db/id "activity-12fb99b1-6cf8-5a19-b791-8128678b255e" :activity/id #uuid "12fb99b1-6cf8-5a19-b791-8128678b255e" :activity/title "Divisibility of Integers by 3, 9, 6, and 7" :activity/type :activity.type/review :activity/scope 17592186050318 :activity/course 17592186046648 :activity/steps ["step-2d9e737d-3beb-558d-b409-89e4144e50cb" "step-6d652c62-b3a3-5b32-af56-3ba9c69395ee" "step-e6219abf-feda-5f67-92ad-2d82ceb7152e"] :activity/first-step "step-2d9e737d-3beb-558d-b409-89e4144e50cb" :db/ensure [:activity/validate]} {:db/id "step-2d9e737d-3beb-558d-b409-89e4144e50cb" :step/id #uuid "2d9e737d-3beb-558d-b409-89e4144e50cb" :step/content "question-bb148c29-2fa3-5a15-9be6-3a95df07f188" :step/next "step-6d652c62-b3a3-5b32-af56-3ba9c69395ee" :db/ensure [:step/validate]} {:db/id "step-6d652c62-b3a3-5b32-af56-3ba9c69395ee" :step/id #uuid "6d652c62-b3a3-5b32-af56-3ba9c69395ee" :step/content "question-c4adaad6-9b04-5b58-a83e-194edc0437bb" :step/next "step-e6219abf-feda-5f67-92ad-2d82ceb7152e" :db/ensure [:step/validate]} {:db/id "step-e6219abf-feda-5f67-92ad-2d82ceb7152e" :step/id #uuid "e6219abf-feda-5f67-92ad-2d82ceb7152e" :step/content 17592186172311 :db/ensure [:step/validate]} {:db/id 17592186172089 :knowledge-point/questions ["question-49e7f17d-b251-56fb-a73b-9aa663a5feb5" "question-e4160743-42ed-5b1d-80ee-6f99ed405134" "question-22b679e5-bd2f-5f85-b6e8-97dc0feb70a5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-49e7f17d-b251-56fb-a73b-9aa663a5feb5" :question/id #uuid "49e7f17d-b251-56fb-a73b-9aa663a5feb5" :question/math-academy-id "q-123410" :question/problem "![](images/ef/ef5fe44009ea42457243052cff584a216ee94636d8e3c16ff9446e85b8eca551.png)\n\nWhich of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=1-5\\operatorname{cos}⁡\\theta \\,$ for $\\frac{\\pi }{6}\\le \\theta \\le \\frac{7\\pi }{6},$ shown above?" :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-5\\operatorname{cos}⁡\\theta ,$ we have \n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=5\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{(1-5\\operatorname{cos}⁡\\theta )^{2}+(5\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{1-10\\operatorname{cos}⁡\\theta +25{cos}^{2}⁡\\theta +25{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{1-10\\operatorname{cos}⁡\\theta +25}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{26-10\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-86b07591-e098-5b5d-80e3-d30542d3cd68"] :db/ensure [:question/validate]} {:db/id "answer-field-86b07591-e098-5b5d-80e3-d30542d3cd68" :answer-field/id #uuid "86b07591-e098-5b5d-80e3-d30542d3cd68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d1fcdafd-bf7d-5de0-8c88-50a987f3891f" :answer-field/choices ["answer-e65466c4-bccb-5f49-930c-7f3a5aefd1ef" "answer-07e65c36-be44-5f01-9c76-e2d474ae0429" "answer-416c60e9-e558-531b-9580-88325c39f159" "answer-d1fcdafd-bf7d-5de0-8c88-50a987f3891f" "answer-d1393249-3bf9-5edc-8048-09a57dbf1249"] :db/ensure [:answer-field/validate]} {:db/id "answer-e65466c4-bccb-5f49-930c-7f3a5aefd1ef" :answer/id #uuid "e65466c4-bccb-5f49-930c-7f3a5aefd1ef" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{10-26\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-07e65c36-be44-5f01-9c76-e2d474ae0429" :answer/id #uuid "07e65c36-be44-5f01-9c76-e2d474ae0429" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{16+10\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-416c60e9-e558-531b-9580-88325c39f159" :answer/id #uuid "416c60e9-e558-531b-9580-88325c39f159" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{18-8\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d1fcdafd-bf7d-5de0-8c88-50a987f3891f" :answer/id #uuid "d1fcdafd-bf7d-5de0-8c88-50a987f3891f" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{26-10\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d1393249-3bf9-5edc-8048-09a57dbf1249" :answer/id #uuid "d1393249-3bf9-5edc-8048-09a57dbf1249" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /6}^{7\\pi /6}\\sqrt{8-18\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186172090 :knowledge-point/questions ["question-6017b841-30bb-5249-81e7-cac41367e88a" "question-dcd1fd46-503a-5471-9362-496d88e411cc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6017b841-30bb-5249-81e7-cac41367e88a" :question/id #uuid "6017b841-30bb-5249-81e7-cac41367e88a" :question/math-academy-id "q-123548" :question/problem "![](images/b9/b9ea317575efcb32d8234309e80fecfd4385c99dbe69dd9c33d3fa7d80313bb6.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=2+2\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2},$ shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2+2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(2+2\\operatorname{cos}⁡\\theta )}^{2}+{(-2\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{4+8\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta +4{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{8}{\\int }_{0}^{\\pi /2}\\sqrt{1+\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{8}{\\int }_{0}^{\\pi /2}\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\theta }{2})\\,\\text{d}\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{\\theta }{2}){|}_{0}^{\\pi /2} \\\\  & =8(\\operatorname{sin}⁡(\\frac{\\pi }{4})-\\operatorname{sin}⁡0) \\\\  & =4\\sqrt{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-416c49b7-a3b7-5531-9507-24f1c4541b91"] :db/ensure [:question/validate]} {:db/id "answer-field-416c49b7-a3b7-5531-9507-24f1c4541b91" :answer-field/id #uuid "416c49b7-a3b7-5531-9507-24f1c4541b91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7daf2602-5ddf-5b93-9c8f-85bf86b1183f" :answer-field/choices ["answer-eb789a46-0304-547b-8796-b1b162722c73" "answer-7daf2602-5ddf-5b93-9c8f-85bf86b1183f" "answer-500ad374-633d-5acc-8fc6-2c954b7ceee0" "answer-dd638516-5b00-5d2e-b7d7-70996ad3e87f" "answer-c4195c77-54de-55db-b8bc-7aa9584420e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb789a46-0304-547b-8796-b1b162722c73" :answer/id #uuid "eb789a46-0304-547b-8796-b1b162722c73" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-7daf2602-5ddf-5b93-9c8f-85bf86b1183f" :answer/id #uuid "7daf2602-5ddf-5b93-9c8f-85bf86b1183f" :answer/type :answer.type/math :answer/value "4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-500ad374-633d-5acc-8fc6-2c954b7ceee0" :answer/id #uuid "500ad374-633d-5acc-8fc6-2c954b7ceee0" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-dd638516-5b00-5d2e-b7d7-70996ad3e87f" :answer/id #uuid "dd638516-5b00-5d2e-b7d7-70996ad3e87f" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c4195c77-54de-55db-b8bc-7aa9584420e9" :answer/id #uuid "c4195c77-54de-55db-b8bc-7aa9584420e9" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "question-e4160743-42ed-5b1d-80ee-6f99ed405134" :question/id #uuid "e4160743-42ed-5b1d-80ee-6f99ed405134" :question/math-academy-id "q-149786" :question/problem "![](images/24/24f7ae31455abc10e60814b6b599966c92680422432c82f6cc7386d6d414f29c.png)\n\nWhich of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=\\operatorname{cos}⁡\\theta +1$ for $0\\le \\theta \\le \\pi ,$ shown above?" :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{cos}⁡\\theta +1,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(\\operatorname{cos}⁡\\theta +1)}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{cos}^{2}⁡\\theta +2\\operatorname{cos}⁡\\theta +1+{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2\\operatorname{cos}⁡\\theta +1+1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{2\\operatorname{cos}⁡\\theta +2}\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bf074d1f-8612-5220-b189-30860f156e17"] :db/ensure [:question/validate]} {:db/id "answer-field-bf074d1f-8612-5220-b189-30860f156e17" :answer-field/id #uuid "bf074d1f-8612-5220-b189-30860f156e17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8eac4e6e-fe81-5a84-9636-cabf10c5314f" :answer-field/choices ["answer-8eac4e6e-fe81-5a84-9636-cabf10c5314f" "answer-236acfde-42f2-51a3-82ca-3600a09ce0a6" "answer-b1c5c96c-0c63-5cb2-88af-e9d02ac33333" "answer-acc1c101-f384-5d1e-ab31-e736b726cbf0" "answer-38ff41e9-dd02-5d21-92a8-581369d18b20"] :db/ensure [:answer-field/validate]} {:db/id "answer-8eac4e6e-fe81-5a84-9636-cabf10c5314f" :answer/id #uuid "8eac4e6e-fe81-5a84-9636-cabf10c5314f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2\\operatorname{cos}⁡\\theta +2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-236acfde-42f2-51a3-82ca-3600a09ce0a6" :answer/id #uuid "236acfde-42f2-51a3-82ca-3600a09ce0a6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2\\operatorname{sin}⁡\\theta +2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b1c5c96c-0c63-5cb2-88af-e9d02ac33333" :answer/id #uuid "b1c5c96c-0c63-5cb2-88af-e9d02ac33333" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{2{cos}^{2}⁡\\theta +2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-acc1c101-f384-5d1e-ab31-e736b726cbf0" :answer/id #uuid "acc1c101-f384-5d1e-ab31-e736b726cbf0" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{\\operatorname{cos}⁡2\\theta +1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-38ff41e9-dd02-5d21-92a8-581369d18b20" :answer/id #uuid "38ff41e9-dd02-5d21-92a8-581369d18b20" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{{sin}^{2}⁡\\theta +1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-22b679e5-bd2f-5f85-b6e8-97dc0feb70a5" :question/id #uuid "22b679e5-bd2f-5f85-b6e8-97dc0feb70a5" :question/math-academy-id "q-149799" :question/problem "Which of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=\\theta {e}^{\\theta }\\,$ for $0\\le \\theta \\le \\pi \\,?$" :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta {e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=(1+\\theta ){e}^{\\theta }.\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(\\theta {e}^{\\theta })}^{2}+{((1+\\theta ){e}^{\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{\\theta }^{2}{e}^{2\\theta }+(1+\\theta )^{2}{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{e}^{2\\theta }({\\theta }^{2}+1+2\\theta +{\\theta }^{2})}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{e}^{\\theta }\\sqrt{2{\\theta }^{2}+2\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a8b124e2-32da-5651-8541-39b8419c32ee"] :db/ensure [:question/validate]} {:db/id "answer-field-a8b124e2-32da-5651-8541-39b8419c32ee" :answer-field/id #uuid "a8b124e2-32da-5651-8541-39b8419c32ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0d1c4079-2e4b-58ce-bcdd-cef5dccc4c25" :answer-field/choices ["answer-2dfd78b7-9d7a-58b9-8cb4-d7bec505415d" "answer-4170ee29-2690-59a0-ac02-7ef811bc4abc" "answer-42a9d64f-13f1-500c-89f4-8b8e1616488f" "answer-0d1c4079-2e4b-58ce-bcdd-cef5dccc4c25" "answer-33feb924-d253-5720-9471-b530f5057780"] :db/ensure [:answer-field/validate]} {:db/id "answer-2dfd78b7-9d7a-58b9-8cb4-d7bec505415d" :answer/id #uuid "2dfd78b7-9d7a-58b9-8cb4-d7bec505415d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{\\theta {e}^{\\theta }+1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-4170ee29-2690-59a0-ac02-7ef811bc4abc" :answer/id #uuid "4170ee29-2690-59a0-ac02-7ef811bc4abc" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{{\\theta }^{2}{e}^{2\\theta }+1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-42a9d64f-13f1-500c-89f4-8b8e1616488f" :answer/id #uuid "42a9d64f-13f1-500c-89f4-8b8e1616488f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{e}^{2\\theta }\\sqrt{{\\theta }^{2}+2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-0d1c4079-2e4b-58ce-bcdd-cef5dccc4c25" :answer/id #uuid "0d1c4079-2e4b-58ce-bcdd-cef5dccc4c25" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{e}^{\\theta }\\sqrt{2{\\theta }^{2}+2\\theta +1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-33feb924-d253-5720-9471-b530f5057780" :answer/id #uuid "33feb924-d253-5720-9471-b530f5057780" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{e}^{\\theta }\\sqrt{{\\theta }^{2}+1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-dcd1fd46-503a-5471-9362-496d88e411cc" :question/id #uuid "dcd1fd46-503a-5471-9362-496d88e411cc" :question/math-academy-id "q-149819" :question/problem "![](images/c7/c700a13da4a3b21940ec6268a89670eee850fc6206285bd3b444959a8b386276.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r={cos}^{3}⁡(\\frac{\\theta }{3})$ for $0\\le \\theta \\le \\frac{3\\pi }{2},$ shown above." :question/worked-solution "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={cos}^{3}⁡(\\frac{\\theta }{3}),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-\\operatorname{sin}⁡(\\frac{\\theta }{3}){cos}^{2}⁡(\\frac{\\theta }{3}).\n$$\n\nTherefore, we evaluate our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\sqrt{{({cos}^{3}⁡(\\frac{\\theta }{3}))}^{2}+{(-\\operatorname{sin}⁡(\\frac{\\theta }{3}){cos}^{2}⁡(\\frac{\\theta }{3}))}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\sqrt{{cos}^{6}⁡(\\frac{\\theta }{3})+{sin}^{2}⁡(\\frac{\\theta }{3}){cos}^{4}⁡(\\frac{\\theta }{3})}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\sqrt{{cos}^{4}⁡(\\frac{\\theta }{3})[{cos}^{2}⁡(\\frac{\\theta }{3})+{sin}^{2}⁡(\\frac{\\theta }{3})]}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\sqrt{{cos}^{4}⁡(\\frac{\\theta }{3})}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}{cos}^{2}⁡(\\frac{\\theta }{3})\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\frac{1}{2}[1+\\operatorname{cos}⁡(\\frac{2\\theta }{3})]\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta +\\frac{3}{2}\\operatorname{sin}⁡(\\frac{2\\theta }{3})]}_{0}^{3\\pi /2} \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-87114391-cb4d-5092-83cc-b2e18baed326"] :db/ensure [:question/validate]} {:db/id "answer-field-87114391-cb4d-5092-83cc-b2e18baed326" :answer-field/id #uuid "87114391-cb4d-5092-83cc-b2e18baed326" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-614ec109-ddf5-5d69-8b6f-788cffd7d795" :answer-field/choices ["answer-c60010fa-7943-5d78-8597-6d6fec062ebb" "answer-6bec234f-7e3b-515c-a2ad-33a2c8025357" "answer-654af1d0-1b91-562a-9226-854b3fe81f62" "answer-960e21ae-a0b1-56a4-a8e3-7aa555730f7a" "answer-614ec109-ddf5-5d69-8b6f-788cffd7d795"] :db/ensure [:answer-field/validate]} {:db/id "answer-c60010fa-7943-5d78-8597-6d6fec062ebb" :answer/id #uuid "c60010fa-7943-5d78-8597-6d6fec062ebb" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-6bec234f-7e3b-515c-a2ad-33a2c8025357" :answer/id #uuid "6bec234f-7e3b-515c-a2ad-33a2c8025357" :answer/type :answer.type/math :answer/value "3\\pi " :db/ensure [:answer/validate]} {:db/id "answer-654af1d0-1b91-562a-9226-854b3fe81f62" :answer/id #uuid "654af1d0-1b91-562a-9226-854b3fe81f62" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-960e21ae-a0b1-56a4-a8e3-7aa555730f7a" :answer/id #uuid "960e21ae-a0b1-56a4-a8e3-7aa555730f7a" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-614ec109-ddf5-5d69-8b6f-788cffd7d795" :answer/id #uuid "614ec109-ddf5-5d69-8b6f-788cffd7d795" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "activity-495233f9-f743-506d-b5fc-eaec14701f70" :activity/id #uuid "495233f9-f743-506d-b5fc-eaec14701f70" :activity/title "Further Properties of Line Integrals of Scalar Functions" :activity/type :activity.type/review :activity/scope 17592186049041 :activity/course 17592186046660 :activity/steps ["step-1b071591-3de0-5c1f-8aeb-668f34070824" "step-748e2a73-740f-5666-bb51-de197b0e3f99" "step-f880bd39-bc57-5d41-b262-cb0554da3861" "step-3c48a8d6-bb4a-559a-912c-74a8d59f12d8" "step-73aaaa88-a71a-530e-8d01-e165dd7e3bfc"] :activity/first-step "step-1b071591-3de0-5c1f-8aeb-668f34070824" :db/ensure [:activity/validate]} {:db/id "step-1b071591-3de0-5c1f-8aeb-668f34070824" :step/id #uuid "1b071591-3de0-5c1f-8aeb-668f34070824" :step/content "question-49e7f17d-b251-56fb-a73b-9aa663a5feb5" :step/next "step-748e2a73-740f-5666-bb51-de197b0e3f99" :db/ensure [:step/validate]} {:db/id "step-748e2a73-740f-5666-bb51-de197b0e3f99" :step/id #uuid "748e2a73-740f-5666-bb51-de197b0e3f99" :step/content "question-6017b841-30bb-5249-81e7-cac41367e88a" :step/next "step-f880bd39-bc57-5d41-b262-cb0554da3861" :db/ensure [:step/validate]} {:db/id "step-f880bd39-bc57-5d41-b262-cb0554da3861" :step/id #uuid "f880bd39-bc57-5d41-b262-cb0554da3861" :step/content "question-e4160743-42ed-5b1d-80ee-6f99ed405134" :step/next "step-3c48a8d6-bb4a-559a-912c-74a8d59f12d8" :db/ensure [:step/validate]} {:db/id "step-3c48a8d6-bb4a-559a-912c-74a8d59f12d8" :step/id #uuid "3c48a8d6-bb4a-559a-912c-74a8d59f12d8" :step/content "question-22b679e5-bd2f-5f85-b6e8-97dc0feb70a5" :step/next "step-73aaaa88-a71a-530e-8d01-e165dd7e3bfc" :db/ensure [:step/validate]} {:db/id "step-73aaaa88-a71a-530e-8d01-e165dd7e3bfc" :step/id #uuid "73aaaa88-a71a-530e-8d01-e165dd7e3bfc" :step/content "question-dcd1fd46-503a-5471-9362-496d88e411cc" :db/ensure [:step/validate]} {:db/id 17592186133889 :knowledge-point/questions ["question-75ca7d55-6e3f-58c8-8a50-805ce5d1a756"] :db/ensure [:knowledge-point/validate]} {:db/id "question-75ca7d55-6e3f-58c8-8a50-805ce5d1a756" :question/id #uuid "75ca7d55-6e3f-58c8-8a50-805ce5d1a756" :question/math-academy-id "q-41838" :question/problem "Consider the vector field $F={x}^{2}yz\\,i+{x}^{3}y\\,j+z\\operatorname{arctan}⁡(\\frac{y}{x})\\,k.$ Evaluate $\\text{div}\\,F$ at the point $(-1,-1,2).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}({x}^{2}yz)+\\frac{∂}{∂y}({x}^{3}y)+\\frac{∂}{∂z}(z\\operatorname{arctan}⁡(\\frac{y}{x})) \\\\  & =2xyz+{x}^{3}+\\operatorname{arctan}⁡(\\frac{y}{x})\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(-1,-1,2),$ and obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F(-1,-1,2) & =2(-1)(-1)(2)+(-1)^{3}+\\operatorname{arctan}⁡(\\frac{-1}{-1}) \\\\  & =4-1+\\frac{\\pi }{4} \\\\  & =3+\\frac{\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-346d1a8e-e297-5ff1-8dff-7d5740531d20"] :db/ensure [:question/validate]} {:db/id "answer-field-346d1a8e-e297-5ff1-8dff-7d5740531d20" :answer-field/id #uuid "346d1a8e-e297-5ff1-8dff-7d5740531d20" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d185a6d1-cc28-52e1-8c76-58d00373669d" :answer-field/choices ["answer-5db37158-5959-5928-a4a3-8612494e2e92" "answer-4a8a0905-3f5a-57f9-b71d-c2127323b463" "answer-d185a6d1-cc28-52e1-8c76-58d00373669d" "answer-7a1781db-53be-5369-8346-96df148295ac" "answer-5b08ebea-7284-5412-99de-e04b22ab6d40"] :db/ensure [:answer-field/validate]} {:db/id "answer-5db37158-5959-5928-a4a3-8612494e2e92" :answer/id #uuid "5db37158-5959-5928-a4a3-8612494e2e92" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-4a8a0905-3f5a-57f9-b71d-c2127323b463" :answer/id #uuid "4a8a0905-3f5a-57f9-b71d-c2127323b463" :answer/type :answer.type/math :answer/value "2-\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-d185a6d1-cc28-52e1-8c76-58d00373669d" :answer/id #uuid "d185a6d1-cc28-52e1-8c76-58d00373669d" :answer/type :answer.type/math :answer/value "3+\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-7a1781db-53be-5369-8346-96df148295ac" :answer/id #uuid "7a1781db-53be-5369-8346-96df148295ac" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-5b08ebea-7284-5412-99de-e04b22ab6d40" :answer/id #uuid "5b08ebea-7284-5412-99de-e04b22ab6d40" :answer/type :answer.type/math :answer/value "4+\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id 17592186133880 :knowledge-point/questions ["question-3aad6c37-ff96-5a6c-89b9-a9f32a30b3d7" "question-aefd685f-6837-5195-a54c-56ec619b88d6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3aad6c37-ff96-5a6c-89b9-a9f32a30b3d7" :question/id #uuid "3aad6c37-ff96-5a6c-89b9-a9f32a30b3d7" :question/math-academy-id "q-105570" :question/problem "![](images/2b/2b64c156519b685acf390c51c1ea3e1540d82e0f7e047cf2f804d38a23956604.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nI. $∇\\cdot F=0$\n\nII. $∇\\cdot F>0$\n\nIII. $∇\\cdot F<0$\n\nIV. $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the length of the vectors' $x$-components increase as we move away from the origin in the horizontal direction. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-22420a9a-1575-5698-aa34-04729efa2a61"] :db/ensure [:question/validate]} {:db/id "answer-field-22420a9a-1575-5698-aa34-04729efa2a61" :answer-field/id #uuid "22420a9a-1575-5698-aa34-04729efa2a61" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7b6cb7f0-12ce-523b-a991-3f45078b3156" :answer-field/choices ["answer-516c5078-1161-5f0b-8b9d-0636463d00b0" "answer-87d47221-a635-52a3-99d0-f5a56e12e0ed" "answer-94b6c747-e673-5cf6-a43f-ad3df20d8406" "answer-7b6cb7f0-12ce-523b-a991-3f45078b3156" "answer-43bc396a-d9ed-5bb3-b93d-0fb796ec2097"] :db/ensure [:answer-field/validate]} {:db/id "answer-516c5078-1161-5f0b-8b9d-0636463d00b0" :answer/id #uuid "516c5078-1161-5f0b-8b9d-0636463d00b0" :answer/type :answer.type/text :answer/value "I and IV only" :db/ensure [:answer/validate]} {:db/id "answer-87d47221-a635-52a3-99d0-f5a56e12e0ed" :answer/id #uuid "87d47221-a635-52a3-99d0-f5a56e12e0ed" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-94b6c747-e673-5cf6-a43f-ad3df20d8406" :answer/id #uuid "94b6c747-e673-5cf6-a43f-ad3df20d8406" :answer/type :answer.type/text :answer/value "II and IV only" :db/ensure [:answer/validate]} {:db/id "answer-7b6cb7f0-12ce-523b-a991-3f45078b3156" :answer/id #uuid "7b6cb7f0-12ce-523b-a991-3f45078b3156" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-43bc396a-d9ed-5bb3-b93d-0fb796ec2097" :answer/id #uuid "43bc396a-d9ed-5bb3-b93d-0fb796ec2097" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-aefd685f-6837-5195-a54c-56ec619b88d6" :question/id #uuid "aefd685f-6837-5195-a54c-56ec619b88d6" :question/math-academy-id "q-105574" :question/problem "![](images/c1/c1dd3e659d2580103232fa68620c60f493477649e1c4a8880023e6c6de88a167.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nI. $∇\\cdot F=0$\n\nII. $∇\\cdot F>0$\n\nIII. $∇\\cdot F<0$\n\nIV. $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement III is true, whereas statements I and II are false. Notice that the lengths of the vector's $y$-components decrease as we move vertically towards the origin. Therefore, the vector field $F$ acts like a sink at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fb66c9a3-57be-589b-8044-dbc471e3b934"] :db/ensure [:question/validate]} {:db/id "answer-field-fb66c9a3-57be-589b-8044-dbc471e3b934" :answer-field/id #uuid "fb66c9a3-57be-589b-8044-dbc471e3b934" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c82e88d-36a4-5cf5-b6fa-804eb0316710" :answer-field/choices ["answer-14e8ce4b-4397-5131-8016-ac24d8139492" "answer-d8ee5433-5dac-5d77-ba1c-0052b43bbfb6" "answer-4c0cb281-c41d-56fc-b840-37c1e1e299b7" "answer-86a9b14f-682a-56ff-b5d7-630ab6d0e48f" "answer-8c82e88d-36a4-5cf5-b6fa-804eb0316710"] :db/ensure [:answer-field/validate]} {:db/id "answer-14e8ce4b-4397-5131-8016-ac24d8139492" :answer/id #uuid "14e8ce4b-4397-5131-8016-ac24d8139492" :answer/type :answer.type/text :answer/value "I and IV only" :db/ensure [:answer/validate]} {:db/id "answer-d8ee5433-5dac-5d77-ba1c-0052b43bbfb6" :answer/id #uuid "d8ee5433-5dac-5d77-ba1c-0052b43bbfb6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4c0cb281-c41d-56fc-b840-37c1e1e299b7" :answer/id #uuid "4c0cb281-c41d-56fc-b840-37c1e1e299b7" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-86a9b14f-682a-56ff-b5d7-630ab6d0e48f" :answer/id #uuid "86a9b14f-682a-56ff-b5d7-630ab6d0e48f" :answer/type :answer.type/text :answer/value "III and IV only" :db/ensure [:answer/validate]} {:db/id "answer-8c82e88d-36a4-5cf5-b6fa-804eb0316710" :answer/id #uuid "8c82e88d-36a4-5cf5-b6fa-804eb0316710" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-13de39d3-3bb8-598c-9ef9-38c2d90d7a15" :activity/id #uuid "13de39d3-3bb8-598c-9ef9-38c2d90d7a15" :activity/title "The Divergence of a Vector Field" :activity/type :activity.type/review :activity/scope 17592186049459 :activity/course 17592186046659 :activity/steps ["step-adea8609-2822-5adc-b454-084b01390c94" "step-9e3f811c-54a6-5c26-bdfa-8aaa897c63e3" "step-05100288-b9ed-59fd-b7a9-9a2592fbbb50" "step-2e0d18ce-acf0-5440-b4c0-fe1c45eb2401" "step-1b54e950-07e6-508f-8bbf-26f7181e85f0"] :activity/first-step "step-adea8609-2822-5adc-b454-084b01390c94" :db/ensure [:activity/validate]} {:db/id "step-adea8609-2822-5adc-b454-084b01390c94" :step/id #uuid "adea8609-2822-5adc-b454-084b01390c94" :step/content "question-75ca7d55-6e3f-58c8-8a50-805ce5d1a756" :step/next "step-9e3f811c-54a6-5c26-bdfa-8aaa897c63e3" :db/ensure [:step/validate]} {:db/id "step-9e3f811c-54a6-5c26-bdfa-8aaa897c63e3" :step/id #uuid "9e3f811c-54a6-5c26-bdfa-8aaa897c63e3" :step/content "question-3aad6c37-ff96-5a6c-89b9-a9f32a30b3d7" :step/next "step-05100288-b9ed-59fd-b7a9-9a2592fbbb50" :db/ensure [:step/validate]} {:db/id "step-05100288-b9ed-59fd-b7a9-9a2592fbbb50" :step/id #uuid "05100288-b9ed-59fd-b7a9-9a2592fbbb50" :step/content "question-aefd685f-6837-5195-a54c-56ec619b88d6" :step/next "step-2e0d18ce-acf0-5440-b4c0-fe1c45eb2401" :db/ensure [:step/validate]} {:db/id "step-2e0d18ce-acf0-5440-b4c0-fe1c45eb2401" :step/id #uuid "2e0d18ce-acf0-5440-b4c0-fe1c45eb2401" :step/content 17592186259490 :step/next "step-1b54e950-07e6-508f-8bbf-26f7181e85f0" :db/ensure [:step/validate]} {:db/id "step-1b54e950-07e6-508f-8bbf-26f7181e85f0" :step/id #uuid "1b54e950-07e6-508f-8bbf-26f7181e85f0" :step/content 17592186266056 :db/ensure [:step/validate]} {:db/id 17592186147415 :knowledge-point/questions ["question-319f568f-1d7f-56e6-aaee-eed8bdcd4507"] :db/ensure [:knowledge-point/validate]} {:db/id "question-319f568f-1d7f-56e6-aaee-eed8bdcd4507" :question/id #uuid "319f568f-1d7f-56e6-aaee-eed8bdcd4507" :question/math-academy-id "q-166804" :question/problem "Expressed as a single fraction, the exact area of the plot of land is$\\,${{field-1}}\nhectares." :question/worked-solution "The exact area of land is ${(\\frac{7}{9})}^{2}$ hectares.\n\nWriting ${(\\frac{7}{9})}^{2}$ with multiplication signs, we get\n\n$$\n\\begin{aligned}{(\\frac{7}{9})}^{2} & ={{\\frac{7}{9}\\times \\frac{7}{9}}_{⏟}}_{2\\text{ times}} \\\\  & =\\frac{7\\times 7}{9\\times 9} \\\\  & =\\frac{49}{81}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{(\\frac{7}{9})}^{2}=\\frac{49}{81}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30583036-b5c2-5e98-859d-3145c20f317d"] :db/ensure [:question/validate]} {:db/id "answer-field-30583036-b5c2-5e98-859d-3145c20f317d" :answer-field/id #uuid "30583036-b5c2-5e98-859d-3145c20f317d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1a4c5101-e4ab-510b-a90b-1f80dc5e7721" :answer-field/choices ["answer-1a4c5101-e4ab-510b-a90b-1f80dc5e7721"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a4c5101-e4ab-510b-a90b-1f80dc5e7721" :answer/id #uuid "1a4c5101-e4ab-510b-a90b-1f80dc5e7721" :answer/type :answer.type/math :answer/value "\\frac{49}{81}" :db/ensure [:answer/validate]} {:db/id 17592186054858 :knowledge-point/questions ["question-5d4461c0-b1a3-50ea-9b6f-7279220b9f4b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5d4461c0-b1a3-50ea-9b6f-7279220b9f4b" :question/id #uuid "5d4461c0-b1a3-50ea-9b6f-7279220b9f4b" :question/math-academy-id "q-166805" :question/problem "To prepare liquid fertilizer, $5.5$ grams of fertilizer powder should be dissolved in a liter of water. How much powder must be dissolved in $8.6$ liters of water to make fertilizer?\n\nExpressed as a decimal, \n{{field-1}}\n$\\,$grams of powder must be dissolved in $8.6$ liters of water." :question/worked-solution "To determine the amount of powder that must be dissolved in $8.6$ liters of water, we have to multiply $8.6$ by $5.5.$\n\nWe proceed by multiplying the two numbers just as we would with whole numbers.\n\n$$\n\\begin{aligned} & \\begin{aligned} &  &  &  & \\,\\,\\,\\,\\,\\begin{aligned}\\boxed{3} \\\\ \\boxed{3}\\end{aligned}\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\begin{aligned}\\boxed{} \\\\ \\boxed{0}\\end{aligned}\\,\\,\\,\\, &  \\\\  &  &  &  & \\,\\,\\,\\,8\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.6\\,\\,\\,\\, \\\\ \\,\\,\\,\\,\\times \\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,.5\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\,4\\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\  & \\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\,\\,\\,4\\,\\,\\,\\,\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\,\\end{aligned}\\end{aligned}\n$$\n\nWe now count the total number of decimal places in the two factors.\n\nThere is $1$ decimal place in $8.6$ and there is $1$ decimal place in $5.5.$\nTherefore, their product will have $1+1=2$ decimal places.\n\nSo, we take our value of $4730$ and add a decimal point to make a number with $2$ decimal places.\n\n$$\n47\\,\\overset{↓}{.}\\,\\,\\,{{30}_{⏟}}_{2\\text{ digits}}\n$$\n\nHence, $8.6\\times 5.5=47.30=47.3.$\n\nWe conclude that $47.3$ grams of powder must be dissolved in $8.6$ liters of water." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-efce6c9c-9575-5794-8252-ed79a4699e45"] :db/ensure [:question/validate]} {:db/id "answer-field-efce6c9c-9575-5794-8252-ed79a4699e45" :answer-field/id #uuid "efce6c9c-9575-5794-8252-ed79a4699e45" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d2675299-d6cf-5aaa-92e1-6451ffe45542" :answer-field/choices ["answer-d2675299-d6cf-5aaa-92e1-6451ffe45542"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2675299-d6cf-5aaa-92e1-6451ffe45542" :answer/id #uuid "d2675299-d6cf-5aaa-92e1-6451ffe45542" :answer/type :answer.type/math :answer/value "47.3" :db/ensure [:answer/validate]} {:db/id 17592186138368 :knowledge-point/questions ["question-88140710-3cf2-5db3-9844-9b23db7c5cfc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-88140710-3cf2-5db3-9844-9b23db7c5cfc" :question/id #uuid "88140710-3cf2-5db3-9844-9b23db7c5cfc" :question/math-academy-id "q-166806" :question/problem "Orlando used $0.3\\,\\text{kg}$ of powdered fertilizer on Monday morning. He then used $0.18\\,\\text{kg}$ of powdered fertilizer on Monday afternoon. How much powder did Orlando use that day?\n\nExpressed as a decimal, Orlando used$\\,$\n{{field-1}}\n$\\text{kg}$ of powdered fertilizer." :question/worked-solution "To determine the amount of powder Orlando used, we need to calculate the sum $0.3+0.18.$\n\nThere is $1$ decimal place in $0.3$ and $2$ decimal places in $0.18.$\n\nTo add the numbers, they both need to have the same number of decimals. Hence, we rewrite the first number so that it has $2$ decimal places:\n\n$$\n0.3=0.30\n$$\n\nNext, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nFinally, we proceed by adding the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\begin{aligned} \\\\ \\end{aligned}\\,\\,\\,\\, &  &  \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,3\\,\\,\\,\\, & \\,\\,\\,\\,0\\,\\,\\,\\, \\\\ \\,\\,\\,\\,+\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,1\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, Orlando used $0.48\\,\\text{kg}$ of powdered fertilizer." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b59f696c-7ffe-5130-82fd-2b129a555d20"] :db/ensure [:question/validate]} {:db/id "answer-field-b59f696c-7ffe-5130-82fd-2b129a555d20" :answer-field/id #uuid "b59f696c-7ffe-5130-82fd-2b129a555d20" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b26ff19c-06ea-5b77-a484-27ad05fc75d3" :answer-field/choices ["answer-b26ff19c-06ea-5b77-a484-27ad05fc75d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b26ff19c-06ea-5b77-a484-27ad05fc75d3" :answer/id #uuid "b26ff19c-06ea-5b77-a484-27ad05fc75d3" :answer/type :answer.type/math :answer/value "0.48" :db/ensure [:answer/validate]} {:db/id 17592186054862 :knowledge-point/questions ["question-d5ff9fd7-f4d9-5987-9375-7f097e607931"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d5ff9fd7-f4d9-5987-9375-7f097e607931" :question/id #uuid "d5ff9fd7-f4d9-5987-9375-7f097e607931" :question/math-academy-id "q-166807" :question/problem "The package of powdered fertilizer that Orlando opened before starting work on Monday weighed $0.95\\,\\text{kg}.$ How much fertilizer was left in the package after he'd finished on Monday afternoon?\n\nExpressed as a decimal, there was$\\,$\n{{field-1}}\n$\\text{kg}$ of fertilizer left." :question/worked-solution "In part 3, we find that Orlando used $0.48\\,\\text{kg}$ of fertilizer on Monday.\n\nTo determine the amount of fertilizer left in the package, we need to calculate $0.95-0.48.$\n\nFirst, we line up the decimal points:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  &  & \\,\\,\\,\\,.\\,\\,\\,\\, &  & \\end{aligned}\n$$\n\nNext, we proceed by subtracting the two numbers just as we would with whole numbers:\n\n$$\n\\begin{aligned} &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ \\end{aligned}\\,\\,\\,\\, &  & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 8\\end{aligned}\\,\\,\\,\\, & \\,\\,\\,\\,\\,\\begin{aligned} \\\\ 15\\end{aligned}\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,9\\,\\,\\,\\, & \\,\\,\\,\\,5\\,\\,\\,\\, \\\\ \\,\\,\\,\\,-\\,\\,\\,\\, &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,8\\,\\,\\,\\, \\\\  &  & \\,\\,\\,\\,0\\,\\,\\,\\, & \\,\\,\\,\\,.\\,\\,\\,\\, & \\,\\,\\,\\,4\\,\\,\\,\\, & \\,\\,\\,\\,7\\,\\,\\,\\,\\end{aligned}\n$$\n\nTherefore, $0.47\\,\\text{kg}$ of fertilizer remained." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9795c27f-91f6-581d-90ed-a7431126765e"] :db/ensure [:question/validate]} {:db/id "answer-field-9795c27f-91f6-581d-90ed-a7431126765e" :answer-field/id #uuid "9795c27f-91f6-581d-90ed-a7431126765e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1010a43c-fb7e-515d-bae0-b8eed8842553" :answer-field/choices ["answer-1010a43c-fb7e-515d-bae0-b8eed8842553"] :db/ensure [:answer-field/validate]} {:db/id "answer-1010a43c-fb7e-515d-bae0-b8eed8842553" :answer/id #uuid "1010a43c-fb7e-515d-bae0-b8eed8842553" :answer/type :answer.type/math :answer/value "0.47" :db/ensure [:answer/validate]} {:db/id 17592186073705 :knowledge-point/questions ["question-e29d8681-5a80-5808-b535-ab9dc2e4503c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e29d8681-5a80-5808-b535-ab9dc2e4503c" :question/id #uuid "e29d8681-5a80-5808-b535-ab9dc2e4503c" :question/math-academy-id "q-166808" :question/problem "During a particular weekend, Orlando made $10\\,\\frac{1}{2}$ liters of liquid fertilizer. He used $9\\,\\frac{1}{6}$ liters from this amount. How much liquid fertilizer did Orlando have left over? Express your answer as a mixed number in its lowest terms.\n\nOrlando had$\\,$\n{{field-1}}\n$\\,$liters of liquid fertilizer left over." :question/worked-solution "Orlando had $(10\\,\\frac{1}{2}-9\\,\\frac{1}{6})$ liters of liquid fertilizer left over.\n\nWriting $10\\,\\frac{1}{2}$ as an improper fraction, we have\n\n$$\n10\\,\\frac{1}{2}=\\frac{10\\times 2+1}{2}=\\frac{21}{2}.\n$$\n\nWriting $9\\,\\frac{1}{6}$ as an improper fraction, we have\n\n$$\n9\\,\\frac{1}{6}=\\frac{9\\times 6+1}{6}=\\frac{55}{6}.\n$$\n\nTherefore, our problem now is to work out the following:\n\n$$\n\\frac{21}{2}-\\frac{55}{6}\n$$\n\nTo subtract two fractions with unlike denominators, we need to express each fraction as an equivalent fraction with a common denominator.\n\nIn this question, we can make a common denominator of $6.$\n\nTo put $\\frac{21}{2}$ over a denominator of $6,$ we multiply the numerator and denominator by $3:$\n\n$$\n\\frac{21}{2}=\\frac{21\\times 3}{2\\times 3}=\\frac{63}{6}\n$$\n\nWe can now subtract the fractions. We keep the denominator the same, and we subtract the numerators:\n\n$$\n\\frac{63}{6}-\\frac{55}{6}=\\frac{8}{6}\n$$\n\nSimplifying, we have\n\n$$\n\\frac{8}{6}=\\frac{8÷2}{6÷2}=\\frac{4}{3}.\n$$\n\nFinally, we convert back to a mixed number:\n\n$$\n\\frac{4}{3}=1\\,\\text{R}\\,1=1\\,\\frac{1}{3}\n$$\n\nTherefore, Orlando had $1\\,\\frac{1}{3}$ liters of liquid fertilizer left over." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5138ec1b-11c8-5624-8ae0-30b14a7ff9f7"] :db/ensure [:question/validate]} {:db/id "answer-field-5138ec1b-11c8-5624-8ae0-30b14a7ff9f7" :answer-field/id #uuid "5138ec1b-11c8-5624-8ae0-30b14a7ff9f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a23b3b85-3b3f-5cad-b5eb-d6d6c2bf5943" :answer-field/choices ["answer-a23b3b85-3b3f-5cad-b5eb-d6d6c2bf5943"] :db/ensure [:answer-field/validate]} {:db/id "answer-a23b3b85-3b3f-5cad-b5eb-d6d6c2bf5943" :answer/id #uuid "a23b3b85-3b3f-5cad-b5eb-d6d6c2bf5943" :answer/type :answer.type/math :answer/value "1\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id 17592186073676 :knowledge-point/questions ["question-5606b628-dd5a-51e3-a0c0-f4f6b8db27d7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5606b628-dd5a-51e3-a0c0-f4f6b8db27d7" :question/id #uuid "5606b628-dd5a-51e3-a0c0-f4f6b8db27d7" :question/math-academy-id "q-166809" :question/problem "Orlando bought $6$ packages of powdered fertilizer, for which he paid $$96.44.$ Estimate the price of each package by rounding the amount of money he spent to the nearest dollar.\n\nThe approximate price of each package is $\n{{field-1}}." :question/worked-solution "To estimate the price of each package, we need to find an approximation to $96.44÷6.$\n\nSo, we round the dividend to the nearest whole number:\n\n$$\n96.44\\to 96\n$$\n\nNow, we divide $96$ by $6$ as usual:\n\n$$\n96÷6=16\n$$\n\nTherefore, the approximate price of each package is $$16.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0bba3ab6-f9f8-574e-8261-1a84cd0c3faa"] :db/ensure [:question/validate]} {:db/id "answer-field-0bba3ab6-f9f8-574e-8261-1a84cd0c3faa" :answer-field/id #uuid "0bba3ab6-f9f8-574e-8261-1a84cd0c3faa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c41f39ef-abdb-5ed8-84f4-7d095d72ad6a" :answer-field/choices ["answer-c41f39ef-abdb-5ed8-84f4-7d095d72ad6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-c41f39ef-abdb-5ed8-84f4-7d095d72ad6a" :answer/id #uuid "c41f39ef-abdb-5ed8-84f4-7d095d72ad6a" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "multistep-09bfd754-ec9d-5f97-ba14-6b16906c1f3e" :multistep/id #uuid "09bfd754-ec9d-5f97-ba14-6b16906c1f3e" :multistep/context "Orlando wants to prepare and use liquid fertilizer on a ${(\\frac{7}{9})}^{2}$ hectare plot of land located on his farm." :multistep/steps ["step-f9dfbbaa-32ec-59db-9c4a-af4215cd2286" "step-0dea133d-38d7-5e9d-be97-1523a15613ed" "step-a40799f7-5820-5197-8386-13a490766fe9" "step-d2f42671-6e27-5767-8033-1903c6c14426" "step-da388f04-2c89-564e-9098-bf3330aa1b8b" "step-77ccb2b4-8521-5fb0-838a-8d9e733377c7"] :multistep/first-step "step-f9dfbbaa-32ec-59db-9c4a-af4215cd2286" :db/ensure [:multistep/validate]} {:db/id "step-f9dfbbaa-32ec-59db-9c4a-af4215cd2286" :step/id #uuid "f9dfbbaa-32ec-59db-9c4a-af4215cd2286" :step/content "question-319f568f-1d7f-56e6-aaee-eed8bdcd4507" :step/next "step-0dea133d-38d7-5e9d-be97-1523a15613ed" :db/ensure [:step/validate]} {:db/id "step-0dea133d-38d7-5e9d-be97-1523a15613ed" :step/id #uuid "0dea133d-38d7-5e9d-be97-1523a15613ed" :step/content "question-5d4461c0-b1a3-50ea-9b6f-7279220b9f4b" :step/next "step-a40799f7-5820-5197-8386-13a490766fe9" :db/ensure [:step/validate]} {:db/id "step-a40799f7-5820-5197-8386-13a490766fe9" :step/id #uuid "a40799f7-5820-5197-8386-13a490766fe9" :step/content "question-88140710-3cf2-5db3-9844-9b23db7c5cfc" :step/next "step-d2f42671-6e27-5767-8033-1903c6c14426" :db/ensure [:step/validate]} {:db/id "step-d2f42671-6e27-5767-8033-1903c6c14426" :step/id #uuid "d2f42671-6e27-5767-8033-1903c6c14426" :step/content "question-d5ff9fd7-f4d9-5987-9375-7f097e607931" :step/next "step-da388f04-2c89-564e-9098-bf3330aa1b8b" :db/ensure [:step/validate]} {:db/id "step-da388f04-2c89-564e-9098-bf3330aa1b8b" :step/id #uuid "da388f04-2c89-564e-9098-bf3330aa1b8b" :step/content "question-e29d8681-5a80-5808-b535-ab9dc2e4503c" :step/next "step-77ccb2b4-8521-5fb0-838a-8d9e733377c7" :db/ensure [:step/validate]} {:db/id "step-77ccb2b4-8521-5fb0-838a-8d9e733377c7" :step/id #uuid "77ccb2b4-8521-5fb0-838a-8d9e733377c7" :step/content "question-5606b628-dd5a-51e3-a0c0-f4f6b8db27d7" :db/ensure [:step/validate]} {:db/id "assigned-problem-4b8c6a4b-9cea-5b62-8e99-40eac17ca68c" :assigned-problem/id #uuid "4b8c6a4b-9cea-5b62-8e99-40eac17ca68c" :assigned-problem/content "multistep-09bfd754-ec9d-5f97-ba14-6b16906c1f3e" :assigned-problem/topic-coverage [17592186048381 17592186049194 17592186049484 17592186049097 17592186050701 17592186050177] :db/ensure [:assigned-problem/validate]} {:db/id "activity-e837b878-9a6c-52e2-a519-22b1f1e3ba07" :activity/id #uuid "e837b878-9a6c-52e2-a519-22b1f1e3ba07" :activity/title "Decimal and Fraction Operations Applied to Commercial Settings" :activity/type :activity.type/assignment :activity/steps ["step-afa77968-6d53-5517-8e75-865f5e57004e"] :activity/first-step "step-afa77968-6d53-5517-8e75-865f5e57004e" :db/ensure [:activity/validate]} {:db/id "step-afa77968-6d53-5517-8e75-865f5e57004e" :step/id #uuid "afa77968-6d53-5517-8e75-865f5e57004e" :step/content "assigned-problem-4b8c6a4b-9cea-5b62-8e99-40eac17ca68c" :db/ensure [:step/validate]} {:db/id 17592186133839 :knowledge-point/questions ["question-cf43c215-ffc3-5823-9335-496b6c1fd83f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cf43c215-ffc3-5823-9335-496b6c1fd83f" :question/id #uuid "cf43c215-ffc3-5823-9335-496b6c1fd83f" :question/math-academy-id "q-81301" :question/problem "![](images/c3/c3dbd6e26cb67b2f247387c30e03296f790c3f56c03779a7dda5ae5d0b081958.png)\n\nIf $D$ is the finite region enclosed by the lines $x=3-{y}^{3},\\,$ $x={y}^{3},$ and $y=0,$ as shown above, then ${∬}_{D}\\frac{1}{\\sqrt{xy}}\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}3-{y}^{3} & ={y}^{3} \\\\ 2{y}^{3} & =3 \\\\ {y}^{3} & =\\frac{3}{2} \\\\ y & =\\sqrt[3]{\\frac{3}{2}}\\end{aligned}\n$$\n\nSo, $y$-limits are \n$0\\le y\\le \\sqrt[3]{\\frac{3}{2}}.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/36/366146b42d476b8d2a467e607a3bba1ef65ddc8a344b3f0e17ee4652ccc0463a.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le \\sqrt[3]{\\frac{3}{2}},\\,{y}^{3}\\le x\\le 3-{y}^{3}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{\\sqrt{xy}}\\,dA & ={\\int }_{0}^{\\sqrt[3]{3/2}}{\\int }_{{y}^{3}}^{3-{y}^{3}}\\frac{1}{\\sqrt{xy}}\\,dx\\,dy \\\\  & ={\\int }_{0}^{\\sqrt[3]{3/2}}[{\\int }_{{y}^{3}}^{3-{y}^{3}}\\frac{1}{\\sqrt{xy}}\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d7bebbb6-2b2e-5637-b8dd-0175f7869ed4"] :db/ensure [:question/validate]} {:db/id "answer-field-d7bebbb6-2b2e-5637-b8dd-0175f7869ed4" :answer-field/id #uuid "d7bebbb6-2b2e-5637-b8dd-0175f7869ed4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7d7b1686-130b-5256-a8cd-ed668ee1fd00" :answer-field/choices ["answer-27f8b3fc-0f1b-53d7-9969-248547e7b45b" "answer-e13baa75-b4d0-5922-8e2d-cba1a3bda445" "answer-7d7b1686-130b-5256-a8cd-ed668ee1fd00" "answer-0dbf9137-cd18-5b00-8628-35682148d59b" "answer-5807c016-a68d-500a-bafd-bbe8e52e28c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-27f8b3fc-0f1b-53d7-9969-248547e7b45b" :answer/id #uuid "27f8b3fc-0f1b-53d7-9969-248547e7b45b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3-{y}^{3}}[{\\int }_{{y}^{3}}^{\\sqrt[3]{3/2}}\\frac{1}{\\sqrt{xy}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-e13baa75-b4d0-5922-8e2d-cba1a3bda445" :answer/id #uuid "e13baa75-b4d0-5922-8e2d-cba1a3bda445" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt[3]{3/2}}[{\\int }_{3-{y}^{3}}^{{y}^{3}}\\frac{1}{\\sqrt{xy}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-7d7b1686-130b-5256-a8cd-ed668ee1fd00" :answer/id #uuid "7d7b1686-130b-5256-a8cd-ed668ee1fd00" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt[3]{3/2}}[{\\int }_{{y}^{3}}^{3-{y}^{3}}\\frac{1}{\\sqrt{xy}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-0dbf9137-cd18-5b00-8628-35682148d59b" :answer/id #uuid "0dbf9137-cd18-5b00-8628-35682148d59b" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{3}}^{3-{y}^{3}}[{\\int }_{0}^{\\sqrt[3]{3/2}}\\frac{1}{\\sqrt{xy}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-5807c016-a68d-500a-bafd-bbe8e52e28c6" :answer/id #uuid "5807c016-a68d-500a-bafd-bbe8e52e28c6" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{3}}^{\\sqrt[3]{3/2}}[{\\int }_{0}^{3-{y}^{3}}\\frac{1}{\\sqrt{xy}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id 17592186133840 :knowledge-point/questions ["question-c2f72ec4-b491-5de0-a559-269634816f5a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c2f72ec4-b491-5de0-a559-269634816f5a" :question/id #uuid "c2f72ec4-b491-5de0-a559-269634816f5a" :question/math-academy-id "q-81312" :question/problem "${\\int }_{0}^{1}{\\int }_{{y}^{3}}^{{y}^{2}}(y-1)\\,dx\\,dy=$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{y}^{3}}^{{y}^{2}}(y-1)\\,dx\\,dy & ={\\int }_{0}^{1}(y-1)[{\\int }_{{y}^{3}}^{{y}^{2}}\\,dx]\\,dy \\\\  & ={\\int }_{0}^{1}(y-1)\\,[x]_{{y}^{3}}^{{y}^{2}}\\,dy \\\\  & ={\\int }_{0}^{1}(y-1)({y}^{2}-{y}^{3})\\,dy \\\\  & ={\\int }_{0}^{1}(-{y}^{4}+2{y}^{3}-{y}^{2})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(-{y}^{4}+2{y}^{3}-{y}^{2})\\,dy & ={[-\\frac{{y}^{5}}{5}+\\frac{{y}^{4}}{2}-\\frac{{y}^{3}}{3}]}_{0}^{1} \\\\  & =-\\frac{1}{5}+\\frac{1}{2}-\\frac{1}{3} \\\\  & =-\\frac{1}{30}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-899b1e4d-10a7-5a27-99db-9badc378d5e8"] :db/ensure [:question/validate]} {:db/id "answer-field-899b1e4d-10a7-5a27-99db-9badc378d5e8" :answer-field/id #uuid "899b1e4d-10a7-5a27-99db-9badc378d5e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bb439f1a-410c-5eb8-8f44-0f5d3790b885" :answer-field/choices ["answer-d948eeb8-aa2f-59a3-84a4-d8a991007f59" "answer-bb439f1a-410c-5eb8-8f44-0f5d3790b885" "answer-446d2ae8-dc82-50e7-896b-5418a7d5cfcc" "answer-beec0d21-4472-5b7e-8a67-4ff29eca2542" "answer-ef86a85c-17ca-562f-9487-9b3559e88804"] :db/ensure [:answer-field/validate]} {:db/id "answer-d948eeb8-aa2f-59a3-84a4-d8a991007f59" :answer/id #uuid "d948eeb8-aa2f-59a3-84a4-d8a991007f59" :answer/type :answer.type/math :answer/value "-\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "answer-bb439f1a-410c-5eb8-8f44-0f5d3790b885" :answer/id #uuid "bb439f1a-410c-5eb8-8f44-0f5d3790b885" :answer/type :answer.type/math :answer/value "-\\frac{1}{30}" :db/ensure [:answer/validate]} {:db/id "answer-446d2ae8-dc82-50e7-896b-5418a7d5cfcc" :answer/id #uuid "446d2ae8-dc82-50e7-896b-5418a7d5cfcc" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-beec0d21-4472-5b7e-8a67-4ff29eca2542" :answer/id #uuid "beec0d21-4472-5b7e-8a67-4ff29eca2542" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ef86a85c-17ca-562f-9487-9b3559e88804" :answer/id #uuid "ef86a85c-17ca-562f-9487-9b3559e88804" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id 17592186268871 :question/problem "Calculate ${∬}_{D}y\\,dA,$ where $D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,2{y}^{2}\\le x\\le {y}^{2}+1\\}.$" :question/worked-solution "The integral is defined over a type II region $D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,2{y}^{2}\\le x\\le {y}^{2}+1\\}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}y\\,dA & ={\\int }_{0}^{1}{\\int }_{2{y}^{2}}^{{y}^{2}+1}y\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{2{y}^{2}}^{{y}^{2}+1}y\\,dx\\,dy & ={\\int }_{0}^{1}y[{\\int }_{2{y}^{2}}^{{y}^{2}+1}\\,dx]dy \\\\  & ={\\int }_{0}^{1}y[\\,x\\,]_{2{y}^{2}}^{{y}^{2}+1}\\,dy \\\\  & ={\\int }_{0}^{1}y({y}^{2}+1-2{y}^{2})dy \\\\  & ={\\int }_{0}^{1}(y-{y}^{3})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(y-{y}^{3})\\,dy & ={[\\frac{1}{2}{y}^{2}-\\frac{1}{4}{y}^{4}]}_{0}^{1} \\\\  & =\\frac{1}{2}-\\frac{1}{4} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-deb6a015-5188-5c6d-9bbf-340e569612da" :activity/id #uuid "deb6a015-5188-5c6d-9bbf-340e569612da" :activity/title "Double Integrals Over Type II Regions" :activity/type :activity.type/review :activity/scope 17592186050264 :activity/course 17592186046659 :activity/steps ["step-b77fee23-8b22-50d7-96e8-1c58b86a3b31" "step-9ace463d-182e-59e5-aeba-5e1e35ffd968" "step-2afa0257-b116-5a6a-9b0d-60d7a1cd57fb" "step-c80c8b7b-b893-5376-b09c-6e111f90842a" "step-d0735f10-459e-5cba-a81d-a0fc2a9e4e82"] :activity/first-step "step-b77fee23-8b22-50d7-96e8-1c58b86a3b31" :db/ensure [:activity/validate]} {:db/id "step-b77fee23-8b22-50d7-96e8-1c58b86a3b31" :step/id #uuid "b77fee23-8b22-50d7-96e8-1c58b86a3b31" :step/content 17592186134306 :step/next "step-9ace463d-182e-59e5-aeba-5e1e35ffd968" :db/ensure [:step/validate]} {:db/id "step-9ace463d-182e-59e5-aeba-5e1e35ffd968" :step/id #uuid "9ace463d-182e-59e5-aeba-5e1e35ffd968" :step/content "question-cf43c215-ffc3-5823-9335-496b6c1fd83f" :step/next "step-2afa0257-b116-5a6a-9b0d-60d7a1cd57fb" :db/ensure [:step/validate]} {:db/id "step-2afa0257-b116-5a6a-9b0d-60d7a1cd57fb" :step/id #uuid "2afa0257-b116-5a6a-9b0d-60d7a1cd57fb" :step/content "question-c2f72ec4-b491-5de0-a559-269634816f5a" :step/next "step-c80c8b7b-b893-5376-b09c-6e111f90842a" :db/ensure [:step/validate]} {:db/id "step-c80c8b7b-b893-5376-b09c-6e111f90842a" :step/id #uuid "c80c8b7b-b893-5376-b09c-6e111f90842a" :step/content 17592186351288 :step/next "step-d0735f10-459e-5cba-a81d-a0fc2a9e4e82" :db/ensure [:step/validate]} {:db/id "step-d0735f10-459e-5cba-a81d-a0fc2a9e4e82" :step/id #uuid "d0735f10-459e-5cba-a81d-a0fc2a9e4e82" :step/content 17592186268871 :db/ensure [:step/validate]} {:db/id 17592186133822 :knowledge-point/questions ["question-0200c257-e4df-57c1-8eaf-e14f946ede8a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186134372 :question/problem "$$\n\\{\\begin{aligned}7{x}_{1}+2{x}_{2}+{x}_{3}=5 \\\\ 14{x}_{1}+4{x}_{2}+2{x}_{3}=0\\end{aligned}\\,\\,[\\begin{aligned}245 & 70 & a \\\\ 70 & 20 & 10 \\\\ c & 10 & 5\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}35 \\\\ b \\\\ 5\\end{aligned}]\n$$\n\nConsider the system of linear equations and its corresponding normal equation shown above. What is the value of $a+b+c?$" :db/ensure [:question/validate]} {:db/id "question-0200c257-e4df-57c1-8eaf-e14f946ede8a" :question/id #uuid "0200c257-e4df-57c1-8eaf-e14f946ede8a" :question/math-academy-id "q-41913" :question/problem "$$\nA=[\\begin{aligned}1 & 0 & 2 \\\\ 4 & 0 & 8 \\\\ 1 & 1 & 2 \\\\ 0 & 1 & 0\\end{aligned}],\\,b=[\\begin{aligned}3 \\\\ 1 \\\\ 3 \\\\ -1\\end{aligned}]\n$$\n\n \n\nConsider the matrix $A$ and vector $b$ above. If the normal equation corresponding to the system $Ax=b$ is given below, what is the value of $a-b-c?$ \n\n$$\n[\\begin{aligned}18 & 1 & 36 \\\\ 1 & 2 & 2 \\\\ b & 2 & a\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}10 \\\\ 2 \\\\ c\\end{aligned}]\n$$" :question/worked-solution "The normal equation corresponding to $Ax=b$ is given by\n\n$$\n\\begin{aligned}{A}^{T}\\,Ax & ={A}^{T}b \\\\ [\\begin{aligned}1 & 4 & 1 & 0 \\\\ 0 & 0 & 1 & 1 \\\\ 2 & 8 & 2 & 0\\end{aligned}][\\begin{aligned}1 & 0 & 2 \\\\ 4 & 0 & 8 \\\\ 1 & 1 & 2 \\\\ 0 & 1 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] & =[\\begin{aligned}1 & 4 & 1 & 0 \\\\ 0 & 0 & 1 & 1 \\\\ 2 & 8 & 2 & 0\\end{aligned}][\\begin{aligned}3 \\\\ 1 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ [\\begin{aligned}18 & 1 & 36 \\\\ 1 & 2 & 2 \\\\ 36 & 2 & 72\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}] & =[\\begin{aligned}10 \\\\ 2 \\\\ 20\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na=72,\\,b=36,\\,c=20,\n$$\n\nand hence\n\n$$\na-b-c=72-36-20=16.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5dab3d8e-15fe-590d-8c8a-109dbb4d368d"] :db/ensure [:question/validate]} {:db/id "answer-field-5dab3d8e-15fe-590d-8c8a-109dbb4d368d" :answer-field/id #uuid "5dab3d8e-15fe-590d-8c8a-109dbb4d368d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-25aea580-a131-5020-b30d-b5f2b4370628" :answer-field/choices ["answer-8285d911-033a-592a-924a-4fdc1f065e32" "answer-76a4e80b-2f39-52e5-80e8-443d6b5ce7ce" "answer-25aea580-a131-5020-b30d-b5f2b4370628" "answer-97b08ce5-c487-5065-ae59-8968740c7c47" "answer-cdc4dbae-9c2c-52ae-b11f-052f7e384e7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8285d911-033a-592a-924a-4fdc1f065e32" :answer/id #uuid "8285d911-033a-592a-924a-4fdc1f065e32" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-76a4e80b-2f39-52e5-80e8-443d6b5ce7ce" :answer/id #uuid "76a4e80b-2f39-52e5-80e8-443d6b5ce7ce" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-25aea580-a131-5020-b30d-b5f2b4370628" :answer/id #uuid "25aea580-a131-5020-b30d-b5f2b4370628" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-97b08ce5-c487-5065-ae59-8968740c7c47" :answer/id #uuid "97b08ce5-c487-5065-ae59-8968740c7c47" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-cdc4dbae-9c2c-52ae-b11f-052f7e384e7e" :answer/id #uuid "cdc4dbae-9c2c-52ae-b11f-052f7e384e7e" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186269141 :question/problem "$$\n\\{\\begin{aligned}-{x}_{1}+2{x}_{2}=3 \\\\ 2{x}_{1}-4{x}_{2}=-2 \\\\ 3{x}_{1}-6{x}_{2}=1\\end{aligned}\n$$\n\nConsider the system of linear equations shown above. If the general least-squares solution of the system is given by\n\n$$\n[\\begin{aligned}a \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}b \\\\ c\\end{aligned}],\\,{x}_{2}\\in R\n$$\n\nwhat is the value of $7a+\\frac{b}{c}?$" :db/ensure [:question/validate]} [:db/retract 17592186056107 :answer-field/choices 17592186056112] [:db/retract 17592186056107 :answer-field/choices 17592186056108] [:db/retract 17592186056107 :answer-field/choices 17592186056109] [:db/retract 17592186056107 :answer-field/choices 17592186056110] [:db/retract 17592186056107 :answer-field/choices 17592186056111] {:db/id 17592186059826 :knowledge-point/questions ["question-c556bd18-7997-5c17-980e-bee5855d1c3c" "question-2f96fab2-a0f2-58ca-be0a-3d7653559b4b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059385 :question/problem "Which inequality corresponds to the interval $x \\in (1, 5)?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nOur interval contains only parentheses. So, the endpoints are *not* included. \n\n$$\nx\\in {\\color{red}{(}}1, 5{\\color{red}{)}}\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n1 \\,\\,{\\color{red}{<      }}\\,\\,      x  \\,\\,{\\color{red}{<      }}\\,\\,      5\n$$" :db/ensure [:question/validate]} {:db/id 17592186059829 :knowledge-point/questions ["question-8752fefa-3c8b-5341-99df-0d350ae12f59"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059388 :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $1$ and $4$ *are* included. \n\n$$\n1\\,\\, {\\color{blue}{\\le}} \\,\\, x \\,\\, {\\color{blue}{\\le}} \\,\\, 4\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n{\\color{blue}{[}}1,4{\\color{blue}{]}}\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [1,4].\n$$" :db/ensure [:question/validate]} {:db/id 17592186059827 :knowledge-point/questions ["question-8242dd7c-9e76-5a08-b5a0-1fe98445b603" "question-864c6e65-68a8-5041-8665-c620b19d5bdd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059386 :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ to indicate that the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0}\\phantom{0}{\\color{blue}{]}}$ to indicate that the endpoints *are* included.\n\nFor the given interval \n\n$$\n{\\color{red}{{\\big(}}} -4, \\sqrt2\\, {\\color{blue}{\\big]}}\n$$\n\nwe note the following:\n\n- The left endpoint $-4$ is *not* included in the interval. Therefore, we use ${\\color{red}{\\lt}}\\,.$\n\n- The right endpoint $\\sqrt2$ *is* included in the interval. Therefore, we use ${\\color{blue}{\\leq      }}\\,.$\n\nTherefore, the inequality that corresponds to the given interval is \n\n$$\n-4 \\,\\,{\\color{red}{\\lt  }}\\,\\,   y \\,\\,{\\color{blue}{\\leq}}\\,\\, \\sqrt 2.\n$$" :db/ensure [:question/validate]} {:db/id 17592186059828 :knowledge-point/questions ["question-e4c54b2e-3c5e-5169-9ebf-b93154fc2325" "question-bcb3072c-2f63-5292-8519-6339938ea4c2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186059387 :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses ${\\color{red}{(}}\\phantom{0} \\phantom{0}{\\color{red}{)}}$ if the endpoints are *not* included.\n\n- Brackets ${\\color{blue}{[}}\\phantom{0} \\phantom{0}{\\color{blue}{]}}$ if the endpoints *are* included.\n\nThe given interval can be represented by the following inequality:\n\n$$\n-2\\,\\, {\\color{blue}{\\leq}}  \\,\\, x \\,\\, {\\color{red}{\\lt}} \\,\\, 2\n$$\n\nWe can express our inequality in interval notation as follows:\n\n$$\nx\\in {\\color{blue}{[}}-2,2{\\color{red}{)}}\n$$" :db/ensure [:question/validate]} {:db/id "question-c556bd18-7997-5c17-980e-bee5855d1c3c" :question/id #uuid "c556bd18-7997-5c17-980e-bee5855d1c3c" :question/math-academy-id "q-154704" :question/problem "The inequality $-\\sqrt{2}<x<\\sqrt{2}$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-\\sqrt{2}$ and $\\sqrt{2}$ are *not* included. \n\n$$\n-\\sqrt{2}\\,\\,<\\,\\,x\\,\\,<\\,\\,\\sqrt{2}\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-\\sqrt{2},\\sqrt{2})\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-\\sqrt{2},\\sqrt{2}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-657476d4-a8fb-55ad-87cf-4c749b0e1c83"] :db/ensure [:question/validate]} {:db/id "answer-field-657476d4-a8fb-55ad-87cf-4c749b0e1c83" :answer-field/id #uuid "657476d4-a8fb-55ad-87cf-4c749b0e1c83" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer-field/choices ["answer-466db8a9-5692-5840-8350-8a1339f4dc4d" "answer-7c3612a6-8098-5473-9fd3-e8a509fdfc5b" "answer-1ee599d9-032e-5cfa-8854-fa874620cf26" "answer-ea146e9c-cd0f-5d3f-a757-f080a85565c3" "answer-631e7e91-f606-52be-bde6-7906debd7ca2"] :db/ensure [:answer-field/validate]} {:db/id "answer-466db8a9-5692-5840-8350-8a1339f4dc4d" :answer/id #uuid "466db8a9-5692-5840-8350-8a1339f4dc4d" :answer/type :answer.type/math :answer/value "(-\\infty ,\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "answer-7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/id #uuid "7c3612a6-8098-5473-9fd3-e8a509fdfc5b" :answer/type :answer.type/math :answer/value "(-\\sqrt{2},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "answer-1ee599d9-032e-5cfa-8854-fa874620cf26" :answer/id #uuid "1ee599d9-032e-5cfa-8854-fa874620cf26" :answer/type :answer.type/math :answer/value "(-\\sqrt{2},\\sqrt{2}]" :db/ensure [:answer/validate]} {:db/id "answer-ea146e9c-cd0f-5d3f-a757-f080a85565c3" :answer/id #uuid "ea146e9c-cd0f-5d3f-a757-f080a85565c3" :answer/type :answer.type/math :answer/value "[-\\sqrt{2},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "answer-631e7e91-f606-52be-bde6-7906debd7ca2" :answer/id #uuid "631e7e91-f606-52be-bde6-7906debd7ca2" :answer/type :answer.type/math :answer/value "[-\\sqrt{2},\\sqrt{2}]" :db/ensure [:answer/validate]} {:db/id "question-2f96fab2-a0f2-58ca-be0a-3d7653559b4b" :question/id #uuid "2f96fab2-a0f2-58ca-be0a-3d7653559b4b" :question/math-academy-id "q-1256" :question/problem "The inequality $-3<x<-1$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"less than\" symbols. So, the endpoints $-3$ and $-1$ are *not* included. \n\n$$\n-3\\,\\,<\\,\\,x\\,\\,<\\,\\,-1\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n(-3,-1)\n$$\n\nMore formally, we can also write\n\n$$\nx\\in (-3,-1).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94593ba1-9997-5f67-b991-f19edf5d49e7"] :db/ensure [:question/validate]} {:db/id "answer-field-94593ba1-9997-5f67-b991-f19edf5d49e7" :answer-field/id #uuid "94593ba1-9997-5f67-b991-f19edf5d49e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-631edece-fedb-545f-b23e-c597b59cd67d" :answer-field/choices ["answer-631edece-fedb-545f-b23e-c597b59cd67d" "answer-ed26bb47-211c-5dd4-826f-0c63b9010f1e" "answer-7ddeac29-1350-586f-8402-4f2cd5a011bd" "answer-bfc2ca2b-8fa1-563e-a4a9-2513bd36fe61" "answer-53fe5584-384d-5b44-83a0-f1565841f276"] :db/ensure [:answer-field/validate]} {:db/id "answer-631edece-fedb-545f-b23e-c597b59cd67d" :answer/id #uuid "631edece-fedb-545f-b23e-c597b59cd67d" :answer/type :answer.type/math :answer/value "(-3,-1)" :db/ensure [:answer/validate]} {:db/id "answer-ed26bb47-211c-5dd4-826f-0c63b9010f1e" :answer/id #uuid "ed26bb47-211c-5dd4-826f-0c63b9010f1e" :answer/type :answer.type/math :answer/value "(-3,-1]" :db/ensure [:answer/validate]} {:db/id "answer-7ddeac29-1350-586f-8402-4f2cd5a011bd" :answer/id #uuid "7ddeac29-1350-586f-8402-4f2cd5a011bd" :answer/type :answer.type/math :answer/value "(1,3)" :db/ensure [:answer/validate]} {:db/id "answer-bfc2ca2b-8fa1-563e-a4a9-2513bd36fe61" :answer/id #uuid "bfc2ca2b-8fa1-563e-a4a9-2513bd36fe61" :answer/type :answer.type/math :answer/value "[-3,-1)" :db/ensure [:answer/validate]} {:db/id "answer-53fe5584-384d-5b44-83a0-f1565841f276" :answer/id #uuid "53fe5584-384d-5b44-83a0-f1565841f276" :answer/type :answer.type/math :answer/value "[-3,-1]" :db/ensure [:answer/validate]} {:db/id "question-8752fefa-3c8b-5341-99df-0d350ae12f59" :question/id #uuid "8752fefa-3c8b-5341-99df-0d350ae12f59" :question/math-academy-id "q-154728" :question/problem "Which inequality corresponds to the interval $x\\in [-7,0]?$" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses $(,)$ to indicate that the endpoints are *not* included.\n\n- Brackets $[]$ to indicate that the endpoints *are* included.\n\nOur interval contains only brackets. So, the endpoints *are* included. \n\n$$\nx\\in [-7,0]\n$$\n\nTherefore, our interval can be expressed as the following inequality:\n\n$$\n-7\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,0\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8a0884c4-5df6-5fd3-b8ad-b0ee63b9d7ad"] :db/ensure [:question/validate]} {:db/id "answer-field-8a0884c4-5df6-5fd3-b8ad-b0ee63b9d7ad" :answer-field/id #uuid "8a0884c4-5df6-5fd3-b8ad-b0ee63b9d7ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer-field/choices ["answer-a3a2c334-25f5-5b4f-b754-81cc023155a0" "answer-75a68108-a8cc-5fb7-90d8-d305c41c4fae" "answer-a18f6b94-6b53-545a-a37a-bd11450bb699" "answer-943f78de-1311-5dd7-ac1a-856ec0cb4c99" "answer-aefb8691-5a94-57f6-a7c9-d4669ca141d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3a2c334-25f5-5b4f-b754-81cc023155a0" :answer/id #uuid "a3a2c334-25f5-5b4f-b754-81cc023155a0" :answer/type :answer.type/math :answer/value "-7<x<0" :db/ensure [:answer/validate]} {:db/id "answer-75a68108-a8cc-5fb7-90d8-d305c41c4fae" :answer/id #uuid "75a68108-a8cc-5fb7-90d8-d305c41c4fae" :answer/type :answer.type/math :answer/value "-7<x\\le 0" :db/ensure [:answer/validate]} {:db/id "answer-a18f6b94-6b53-545a-a37a-bd11450bb699" :answer/id #uuid "a18f6b94-6b53-545a-a37a-bd11450bb699" :answer/type :answer.type/math :answer/value "-7\\le x<0" :db/ensure [:answer/validate]} {:db/id "answer-943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer/id #uuid "943f78de-1311-5dd7-ac1a-856ec0cb4c99" :answer/type :answer.type/math :answer/value "-7\\le x\\le 0" :db/ensure [:answer/validate]} {:db/id "answer-aefb8691-5a94-57f6-a7c9-d4669ca141d5" :answer/id #uuid "aefb8691-5a94-57f6-a7c9-d4669ca141d5" :answer/type :answer.type/text :answer/value "$x\\le -7$ or $x\\ge 0$" :db/ensure [:answer/validate]} {:db/id 17592186059958 :question/problem "The inequality $-10\\le x\\le 3$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nOur inequality contains only \"or equal to\" symbols. So, the endpoints $-10$ and $3$ *are* included. \n\n$$\n-10\\,\\,\\le \\,\\,x\\,\\,\\le \\,\\,3\n$$\n\nTherefore, we can express our inequality in interval notation as follows:\n\n$$\n[-10,3]\n$$\n\nMore formally, we can also write\n\n$$\nx\\in [-10,3].\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186056107 :answer-field/correct "answer-b9d2aab1-6872-5e77-8697-9067584fdf64" :answer-field/choices ["answer-2eee8041-f4fa-545a-a3f7-4d63c35b6ba8" "answer-3dacba62-f7cd-5fb4-b7ac-b6a55cdc2a73" "answer-982b05bc-9e84-5fbb-95ab-465cc3b39a18" "answer-1b3d8a45-fe13-581e-9e3f-055e9482e906" "answer-b9d2aab1-6872-5e77-8697-9067584fdf64"] :db/ensure [:answer-field/validate]} {:db/id "answer-2eee8041-f4fa-545a-a3f7-4d63c35b6ba8" :answer/id #uuid "2eee8041-f4fa-545a-a3f7-4d63c35b6ba8" :answer/type :answer.type/math :answer/value "(-10,3)" :db/ensure [:answer/validate]} {:db/id "answer-3dacba62-f7cd-5fb4-b7ac-b6a55cdc2a73" :answer/id #uuid "3dacba62-f7cd-5fb4-b7ac-b6a55cdc2a73" :answer/type :answer.type/math :answer/value "(-10,3]" :db/ensure [:answer/validate]} {:db/id "answer-982b05bc-9e84-5fbb-95ab-465cc3b39a18" :answer/id #uuid "982b05bc-9e84-5fbb-95ab-465cc3b39a18" :answer/type :answer.type/math :answer/value "(-\\infty ,3]" :db/ensure [:answer/validate]} {:db/id "answer-1b3d8a45-fe13-581e-9e3f-055e9482e906" :answer/id #uuid "1b3d8a45-fe13-581e-9e3f-055e9482e906" :answer/type :answer.type/math :answer/value "[-10,3)" :db/ensure [:answer/validate]} {:db/id "answer-b9d2aab1-6872-5e77-8697-9067584fdf64" :answer/id #uuid "b9d2aab1-6872-5e77-8697-9067584fdf64" :answer/type :answer.type/math :answer/value "[-10,3]" :db/ensure [:answer/validate]} {:db/id "question-8242dd7c-9e76-5a08-b5a0-1fe98445b603" :question/id #uuid "8242dd7c-9e76-5a08-b5a0-1fe98445b603" :question/math-academy-id "q-73902" :question/problem "The interval $y\\in [-1,2)$ corresponds to the inequality" :question/worked-solution "Every interval can be expressed as an inequality. We use the following notations:\n\n- Parentheses $()$ to indicate that the endpoints are *not* included.\n\n- Brackets $[]$ to indicate that the endpoints *are* included.\n\nFor the given interval \n\n$$\n[-1,2\\,)\n$$\n\nwe note the following:\n\n- The left endpoint $-1$ *is* included in the interval. Therefore, we use $\\le \\,.$\n\n- The right endpoint $2$ is *not* included in the interval. Therefore, we use $<\\,.$\n\nTherefore, the inequality that corresponds to the given interval is \n\n$$\n-1\\,\\,\\le \\,\\,y\\,\\,<\\,\\,2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d78e9d72-459d-5fce-90e1-8180676b9ebb"] :db/ensure [:question/validate]} {:db/id "answer-field-d78e9d72-459d-5fce-90e1-8180676b9ebb" :answer-field/id #uuid "d78e9d72-459d-5fce-90e1-8180676b9ebb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d1720d90-8cb3-5638-bf04-aaa94a4aeaba" :answer-field/choices ["answer-631761de-21bd-51da-88ac-879266e500a8" "answer-43f5ec63-ec14-578f-9c9b-502470b6d4f0" "answer-d1720d90-8cb3-5638-bf04-aaa94a4aeaba" "answer-6315912c-de0b-5577-9bf6-3e2c64fe43c9" "answer-38fce6e7-e608-5049-89bd-6546b8fda8e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-631761de-21bd-51da-88ac-879266e500a8" :answer/id #uuid "631761de-21bd-51da-88ac-879266e500a8" :answer/type :answer.type/math :answer/value "-1<y<2" :db/ensure [:answer/validate]} {:db/id "answer-43f5ec63-ec14-578f-9c9b-502470b6d4f0" :answer/id #uuid "43f5ec63-ec14-578f-9c9b-502470b6d4f0" :answer/type :answer.type/math :answer/value "-1<y\\le 2" :db/ensure [:answer/validate]} {:db/id "answer-d1720d90-8cb3-5638-bf04-aaa94a4aeaba" :answer/id #uuid "d1720d90-8cb3-5638-bf04-aaa94a4aeaba" :answer/type :answer.type/math :answer/value "-1\\le y<2" :db/ensure [:answer/validate]} {:db/id "answer-6315912c-de0b-5577-9bf6-3e2c64fe43c9" :answer/id #uuid "6315912c-de0b-5577-9bf6-3e2c64fe43c9" :answer/type :answer.type/math :answer/value "-1\\le y\\le 2" :db/ensure [:answer/validate]} {:db/id "answer-38fce6e7-e608-5049-89bd-6546b8fda8e6" :answer/id #uuid "38fce6e7-e608-5049-89bd-6546b8fda8e6" :answer/type :answer.type/math :answer/value "-2<y\\le 1" :db/ensure [:answer/validate]} {:db/id "question-864c6e65-68a8-5041-8665-c620b19d5bdd" :question/id #uuid "864c6e65-68a8-5041-8665-c620b19d5bdd" :question/math-academy-id "q-28834" :question/problem "The inequality $-5\\le x<-2$ can be expressed in interval notation as" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nFor the given inequality \n\n$$\n-5\\,\\,\\le \\,\\,x\\,\\,<\\,\\,-2\n$$\n\nwe note the following:\n\n- The left endpoint $-5$ *is* included in the interval. Therefore, we use $[\\,.$\n\n- The right endpoint $-2$ is *not* included in the interval. Therefore, we use $)\\,.$\n\nTherefore, the corresponding interval is\n\n$$\nx\\in [-5,-2).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8e0bb284-b5cb-58ef-a60f-c6b90ddcc36a"] :db/ensure [:question/validate]} {:db/id "answer-field-8e0bb284-b5cb-58ef-a60f-c6b90ddcc36a" :answer-field/id #uuid "8e0bb284-b5cb-58ef-a60f-c6b90ddcc36a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-78f8e2a1-909f-520f-b506-e3974280f4b5" :answer-field/choices ["answer-0eca1adc-bc9c-5c08-a7e6-44e89120d4fd" "answer-4b6c9f84-1d4a-5826-bc2e-d1338c645d51" "answer-78f8e2a1-909f-520f-b506-e3974280f4b5" "answer-2d88ad6c-d451-5917-baac-bf77e2cf6ea7" "answer-26a0db72-b0e4-5ff6-898c-6fbe5090f309"] :db/ensure [:answer-field/validate]} {:db/id "answer-0eca1adc-bc9c-5c08-a7e6-44e89120d4fd" :answer/id #uuid "0eca1adc-bc9c-5c08-a7e6-44e89120d4fd" :answer/type :answer.type/math :answer/value "x\\in (-5,-2)" :db/ensure [:answer/validate]} {:db/id "answer-4b6c9f84-1d4a-5826-bc2e-d1338c645d51" :answer/id #uuid "4b6c9f84-1d4a-5826-bc2e-d1338c645d51" :answer/type :answer.type/math :answer/value "x\\in (-5,-2]" :db/ensure [:answer/validate]} {:db/id "answer-78f8e2a1-909f-520f-b506-e3974280f4b5" :answer/id #uuid "78f8e2a1-909f-520f-b506-e3974280f4b5" :answer/type :answer.type/math :answer/value "x\\in [-5,-2)" :db/ensure [:answer/validate]} {:db/id "answer-2d88ad6c-d451-5917-baac-bf77e2cf6ea7" :answer/id #uuid "2d88ad6c-d451-5917-baac-bf77e2cf6ea7" :answer/type :answer.type/math :answer/value "x\\in [-5,-2]" :db/ensure [:answer/validate]} {:db/id "answer-26a0db72-b0e4-5ff6-898c-6fbe5090f309" :answer/id #uuid "26a0db72-b0e4-5ff6-898c-6fbe5090f309" :answer/type :answer.type/math :answer/value "x\\in [-5,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-e4c54b2e-3c5e-5169-9ebf-b93154fc2325" :question/id #uuid "e4c54b2e-3c5e-5169-9ebf-b93154fc2325" :question/math-academy-id "q-31779" :question/problem "![](images/e9/e91f27df78e4d7c05477917f0875add047f24fa2a2aee2ea26d6191023e80165.png)\n\nWhich of the following intervals corresponds to the segment shown above?" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nThe given interval can be represented by the following inequality:\n\n$$\n2\\,\\,\\le \\,\\,x\\,\\,<\\,\\,4\n$$\n\nWe can express our inequality in interval notation as follows:\n\n$$\nx\\in [2,4)\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b60e6f1c-059f-5729-93e7-1c48af51a16e"] :db/ensure [:question/validate]} {:db/id "answer-field-b60e6f1c-059f-5729-93e7-1c48af51a16e" :answer-field/id #uuid "b60e6f1c-059f-5729-93e7-1c48af51a16e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cdf7548b-e4a5-50e1-aa92-f23ba1bbfbd2" :answer-field/choices ["answer-9b70cd5f-c7a4-5ac6-90e4-50b45fbae29d" "answer-d217314b-12bf-5a1a-a77a-d923987f24ef" "answer-cdf7548b-e4a5-50e1-aa92-f23ba1bbfbd2" "answer-57beea1d-32a4-570f-8016-ffeaf753e471" "answer-cb705797-f47e-532c-b01c-173409681310"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b70cd5f-c7a4-5ac6-90e4-50b45fbae29d" :answer/id #uuid "9b70cd5f-c7a4-5ac6-90e4-50b45fbae29d" :answer/type :answer.type/math :answer/value "x\\in (2,4)" :db/ensure [:answer/validate]} {:db/id "answer-d217314b-12bf-5a1a-a77a-d923987f24ef" :answer/id #uuid "d217314b-12bf-5a1a-a77a-d923987f24ef" :answer/type :answer.type/math :answer/value "x\\in (2,4]" :db/ensure [:answer/validate]} {:db/id "answer-cdf7548b-e4a5-50e1-aa92-f23ba1bbfbd2" :answer/id #uuid "cdf7548b-e4a5-50e1-aa92-f23ba1bbfbd2" :answer/type :answer.type/math :answer/value "x\\in [2,4)" :db/ensure [:answer/validate]} {:db/id "answer-57beea1d-32a4-570f-8016-ffeaf753e471" :answer/id #uuid "57beea1d-32a4-570f-8016-ffeaf753e471" :answer/type :answer.type/math :answer/value "x\\in [2,4]" :db/ensure [:answer/validate]} {:db/id "answer-cb705797-f47e-532c-b01c-173409681310" :answer/id #uuid "cb705797-f47e-532c-b01c-173409681310" :answer/type :answer.type/math :answer/value "x\\in [2,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-bcb3072c-2f63-5292-8519-6339938ea4c2" :question/id #uuid "bcb3072c-2f63-5292-8519-6339938ea4c2" :question/math-academy-id "q-154795" :question/problem "![](images/05/05b54d1b8e401f49861e335fd4736566441017576b30d9b56a6bdfe5e670bffb.png)\n\nWhich of the following intervals corresponds to the segment shown above?" :question/worked-solution "Every inequality can be expressed as an interval. We use the following notations:\n\n- Parentheses $()$ if the endpoints are *not* included.\n\n- Brackets $[]$ if the endpoints *are* included.\n\nThe given interval can be represented by the following inequality:\n\n$$\n-3\\,\\,<\\,\\,x\\,\\,<\\,\\,2\n$$\n\nWe can express our inequality in interval notation as follows:\n\n$$\nx\\in (-3,2)\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-39d8077e-12cd-57cb-8f8e-3f986098c08a"] :db/ensure [:question/validate]} {:db/id "answer-field-39d8077e-12cd-57cb-8f8e-3f986098c08a" :answer-field/id #uuid "39d8077e-12cd-57cb-8f8e-3f986098c08a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4622d0d7-a8c1-5f2c-9352-7f3037f736e4" :answer-field/choices ["answer-4622d0d7-a8c1-5f2c-9352-7f3037f736e4" "answer-55fccfdd-8453-5e6e-a352-f594e50395a0" "answer-04d2bb6c-1af1-5e65-9ea5-53d69510ab43" "answer-533c57fc-8f74-5b0d-adae-a85840204f66" "answer-338136d4-03d3-5b9a-9c7f-00a504b6f047"] :db/ensure [:answer-field/validate]} {:db/id "answer-4622d0d7-a8c1-5f2c-9352-7f3037f736e4" :answer/id #uuid "4622d0d7-a8c1-5f2c-9352-7f3037f736e4" :answer/type :answer.type/math :answer/value "x\\in (-3,2)" :db/ensure [:answer/validate]} {:db/id "answer-55fccfdd-8453-5e6e-a352-f594e50395a0" :answer/id #uuid "55fccfdd-8453-5e6e-a352-f594e50395a0" :answer/type :answer.type/math :answer/value "x\\in (-3,2]" :db/ensure [:answer/validate]} {:db/id "answer-04d2bb6c-1af1-5e65-9ea5-53d69510ab43" :answer/id #uuid "04d2bb6c-1af1-5e65-9ea5-53d69510ab43" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,2)" :db/ensure [:answer/validate]} {:db/id "answer-533c57fc-8f74-5b0d-adae-a85840204f66" :answer/id #uuid "533c57fc-8f74-5b0d-adae-a85840204f66" :answer/type :answer.type/math :answer/value "x\\in [-3,2)" :db/ensure [:answer/validate]} {:db/id "answer-338136d4-03d3-5b9a-9c7f-00a504b6f047" :answer/id #uuid "338136d4-03d3-5b9a-9c7f-00a504b6f047" :answer/type :answer.type/math :answer/value "x\\in [-3,2]" :db/ensure [:answer/validate]} {:db/id 17592186060969 :tutorial/content "Consider the region below, which represents the inequality $2 < x < 5.$\n\n![](images/fe/feeae0bfa9b29e6f034a3fd33d1e9fbd369840835af2d6588892ee6edc2fa120.png)\n\nWe can represent this inequality using **interval notation** as follows:\n\n$$\n(2,5)\n$$\n\nThe parentheses $(\\phantom{0})$ tell us that the endpoints $x=2$ and $x=5$ are *not* included in this interval.\n\nWhen an interval does not include the endpoints, we say that it is **open**. \n\nMore formally, we can also write\n\n$$\nx\\in (2,5).\n$$\n\nThe symbol $\\in$ means \"lies in\" or \"belongs to.\" So, the above reads, \"*$x$ belongs to the (open) interval $(2,5).$*\"" :db/ensure [:tutorial/validate]} {:db/id 17592186060973 :tutorial/content "Now consider the region below, which represents the inequality $-3 \\leq x \\leq 1.$\n\n![](images/38/38c5bf5408bbbeb0f63e198e0564a37e8fe6a34d7f2ce340751d8000443123ed.png)\n\nWe express this inequality using interval notation as follows:\n\n$$\n[-3,1]\n$$\n\nThe brackets $[\\phantom{0}]$ tell us that the endpoints $x=-3$ and $x=1$ *are* included in this interval.\n\nWhen an interval includes the endpoints, we say that it is **closed**. \n\nMore formally, we can also write\n\n$$\nx\\in [-3,1].\n$$\n\nThe above reads, \"*$x$ belongs to the (closed) interval $[-3,1].$*\"" :db/ensure [:tutorial/validate]} {:db/id 17592186060970 :tutorial/content "Some intervals may include one parenthesis and one bracket. \n\nFor example, consider the following interval:\n\n$$\n{\\color{blue}{{\\big[}}} 1,4 {\\color{red}{\\big)}}\n$$\n\nTo express this interval as an inequality, we note the following:\n\n- The left bracket $\\,\\color{blue}[\\,$ tells us that left endpoint $1$ *is* included in the interval. Therefore, we use ${\\color{blue}{\\leq}}$ for this endpoint.\n\n- The right parenthesis $\\,\\color{red})\\,$ tells us that the right endpoint $4$ is *not* included in the interval. Therefore, we use ${\\color{red}{<      }}\\,$ for this endpoint.\n\nTherefore, the inequality that corresponds to the given interval is \n\n$$\n1 \\,\\,{\\color{blue}{\\leq  }}\\,\\,   x \\,\\,{\\color{red}{\\lt}}\\,\\, 4.\n$$\n\nThe interval can be graphed as follows:\n\n![](images/5a/5a67872e8193c2bcc249a9a9006acb916909099e4babdbe5cdfa6d2643c10ad2.png)\n\nIntervals with one bracket and one parenthesis are called **half-open** (or **half-closed**)." :db/ensure [:tutorial/validate]} {:db/id 17592186059917 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186163432 :answer-field/choices 17592186163433] [:db/retract 17592186163432 :answer-field/choices 17592186163434] [:db/retract 17592186163432 :answer-field/choices 17592186163435] [:db/retract 17592186163432 :answer-field/choices 17592186163436] [:db/retract 17592186163432 :answer-field/choices 17592186163437] {:db/id 17592186166851 :knowledge-point/questions ["question-c5b13bf2-e455-5ecd-8fce-8c8ab9a50cfc" "question-10277519-c835-51d7-9d38-5cc5b84c2733"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166852 :knowledge-point/questions ["question-0ebc5c12-2f6e-589d-af5a-42a020eb709e" "question-943c59c7-5044-5ab4-92f0-26722bf35b20" "question-1808d5b9-dae6-5dea-b5bd-62c618289147"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c5b13bf2-e455-5ecd-8fce-8c8ab9a50cfc" :question/id #uuid "c5b13bf2-e455-5ecd-8fce-8c8ab9a50cfc" :question/math-academy-id "q-108799" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\operatorname{sin}⁡(x+y).\n$$\n\nUsing a substitution of the form $z=x+y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =\\operatorname{sin}⁡z\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\operatorname{sin}⁡z.\n$$\n\nTherefore, $f(z)=1+\\operatorname{sin}⁡z.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-662e1ec7-120e-5135-be30-35885522a76f"] :db/ensure [:question/validate]} {:db/id "answer-field-662e1ec7-120e-5135-be30-35885522a76f" :answer-field/id #uuid "662e1ec7-120e-5135-be30-35885522a76f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-17bd8cc8-4bb4-5eff-ada9-0d3691acf532" :answer-field/choices ["answer-46aef1dd-2eb5-515f-a6bb-f8f10224f799" "answer-17bd8cc8-4bb4-5eff-ada9-0d3691acf532" "answer-8b31acd6-793b-5fd9-8007-45f8fd263cd1" "answer-dcb0492d-fea8-543e-b81d-269e86234098" "answer-d686bc1e-099d-5164-b83e-64876d5962cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-46aef1dd-2eb5-515f-a6bb-f8f10224f799" :answer/id #uuid "46aef1dd-2eb5-515f-a6bb-f8f10224f799" :answer/type :answer.type/math :answer/value "-1+\\operatorname{sin}⁡z" :db/ensure [:answer/validate]} {:db/id "answer-17bd8cc8-4bb4-5eff-ada9-0d3691acf532" :answer/id #uuid "17bd8cc8-4bb4-5eff-ada9-0d3691acf532" :answer/type :answer.type/math :answer/value "1+\\operatorname{sin}⁡z" :db/ensure [:answer/validate]} {:db/id "answer-8b31acd6-793b-5fd9-8007-45f8fd263cd1" :answer/id #uuid "8b31acd6-793b-5fd9-8007-45f8fd263cd1" :answer/type :answer.type/math :answer/value "1-\\operatorname{sin}⁡z" :db/ensure [:answer/validate]} {:db/id "answer-dcb0492d-fea8-543e-b81d-269e86234098" :answer/id #uuid "dcb0492d-fea8-543e-b81d-269e86234098" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(z+1)" :db/ensure [:answer/validate]} {:db/id "answer-d686bc1e-099d-5164-b83e-64876d5962cb" :answer/id #uuid "d686bc1e-099d-5164-b83e-64876d5962cb" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(z-1)" :db/ensure [:answer/validate]} {:db/id "question-10277519-c835-51d7-9d38-5cc5b84c2733" :question/id #uuid "10277519-c835-51d7-9d38-5cc5b84c2733" :question/math-academy-id "q-149712" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3-\\frac{1}{(3x-y)^{3}}.\n$$\n\nUsing a substitution of the form $z=3x-y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=3x-y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=3-\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=3-\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}3-\\frac{\\text{d}z}{\\text{d}x} & =3-\\frac{1}{{z}^{3}}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{1}{{z}^{3}}.\n$$\n\nTherefore, $f(z)=\\frac{1}{{z}^{3}}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e2de56b4-f1bc-5880-8c98-289d5a2bf62d"] :db/ensure [:question/validate]} {:db/id "answer-field-e2de56b4-f1bc-5880-8c98-289d5a2bf62d" :answer-field/id #uuid "e2de56b4-f1bc-5880-8c98-289d5a2bf62d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d56be03b-3ecc-54bb-90cd-67c9da112068" :answer-field/choices ["answer-dbdbed3c-05bf-59fb-bce3-b59de8af14d6" "answer-17c2fb32-9b66-536c-8718-eae44692c7a9" "answer-d56be03b-3ecc-54bb-90cd-67c9da112068" "answer-7fe306ca-1607-530b-9c80-4dc6d4945a1b" "answer-3a46b666-9634-59d0-8c48-828293d7b287"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbdbed3c-05bf-59fb-bce3-b59de8af14d6" :answer/id #uuid "dbdbed3c-05bf-59fb-bce3-b59de8af14d6" :answer/type :answer.type/math :answer/value "-\\frac{3}{{z}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-17c2fb32-9b66-536c-8718-eae44692c7a9" :answer/id #uuid "17c2fb32-9b66-536c-8718-eae44692c7a9" :answer/type :answer.type/math :answer/value "3-\\frac{1}{{z}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-d56be03b-3ecc-54bb-90cd-67c9da112068" :answer/id #uuid "d56be03b-3ecc-54bb-90cd-67c9da112068" :answer/type :answer.type/math :answer/value "\\frac{1}{{z}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-7fe306ca-1607-530b-9c80-4dc6d4945a1b" :answer/id #uuid "7fe306ca-1607-530b-9c80-4dc6d4945a1b" :answer/type :answer.type/math :answer/value "\\frac{1}{{z}^{3}}-3" :db/ensure [:answer/validate]} {:db/id "answer-3a46b666-9634-59d0-8c48-828293d7b287" :answer/id #uuid "3a46b666-9634-59d0-8c48-828293d7b287" :answer/type :answer.type/math :answer/value "\\frac{3}{{z}^{3}}+1" :db/ensure [:answer/validate]} {:db/id 17592186167059 :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=(2x-3y)^{2}.\n$$\n\nUsing a substitution of the form $z=2x-3y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=2x-3y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2-3\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{2}{3}-\\frac{1}{3}\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{2}{3}-\\frac{1}{3}\\,\\frac{\\text{d}z}{\\text{d}x} & ={z}^{2}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2-3{z}^{2}.\n$$\n\nTherefore, $f(z)=2-3{z}^{2}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186163432 :answer-field/correct "answer-deb53e97-ac5d-5842-80e7-e5bc8a58a041" :answer-field/choices ["answer-5eb2a735-2e46-54e0-9874-7cbb3c9d2e19" "answer-deb53e97-ac5d-5842-80e7-e5bc8a58a041" "answer-99ead3e1-62a9-5269-ad68-54edae96ed46" "answer-6f8c6b09-5053-55b0-9af4-ddde68c55268" "answer-36446237-fb30-532e-b4bc-0f15cdd21661"] :db/ensure [:answer-field/validate]} {:db/id "answer-5eb2a735-2e46-54e0-9874-7cbb3c9d2e19" :answer/id #uuid "5eb2a735-2e46-54e0-9874-7cbb3c9d2e19" :answer/type :answer.type/math :answer/value "1-2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-deb53e97-ac5d-5842-80e7-e5bc8a58a041" :answer/id #uuid "deb53e97-ac5d-5842-80e7-e5bc8a58a041" :answer/type :answer.type/math :answer/value "2-3{z}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-99ead3e1-62a9-5269-ad68-54edae96ed46" :answer/id #uuid "99ead3e1-62a9-5269-ad68-54edae96ed46" :answer/type :answer.type/math :answer/value "2-{z}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-6f8c6b09-5053-55b0-9af4-ddde68c55268" :answer/id #uuid "6f8c6b09-5053-55b0-9af4-ddde68c55268" :answer/type :answer.type/math :answer/value "3-{z}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-36446237-fb30-532e-b4bc-0f15cdd21661" :answer/id #uuid "36446237-fb30-532e-b4bc-0f15cdd21661" :answer/type :answer.type/math :answer/value "{z}^{2}+3" :db/ensure [:answer/validate]} {:db/id "question-0ebc5c12-2f6e-589d-af5a-42a020eb709e" :question/id #uuid "0ebc5c12-2f6e-589d-af5a-42a020eb709e" :question/math-academy-id "q-149722" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=1-\\frac{{e}^{y-x}}{x-y+1}.\n$$\n\n \nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x-y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1-\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=1-\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}1-\\frac{\\text{d}z}{\\text{d}x} & =1-\\frac{{e}^{-z}}{z+1}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{{e}^{-z}}{z+1}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}(z+1){e}^{z}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int (z+1){e}^{z}\\,\\text{d}z & =\\int \\text{d}x\\end{aligned}\n$$\n\nUsing integration by parts on the left side,\n\n$$\n\\begin{aligned}u=z+1 & \\,⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{z} & \\,⟹\\,v={e}^{z}\\end{aligned}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\\int (z+1){e}^{z}\\,\\text{d}z & =\\int \\text{d}x \\\\ (z+1){e}^{z}-\\int {e}^{z}\\,\\text{d}z & =\\int \\text{d}x \\\\ (z+1){e}^{z}-{e}^{z} & =x+C \\\\ z{e}^{z} & =x+C.\\end{aligned}\n$$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n(x-y){e}^{x-y}=x+C\n$$\n\nTherefore, $g(x,y)=(x-y){e}^{x-y}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0d6cf9d9-7b5d-5a12-954e-3a9a145111eb"] :db/ensure [:question/validate]} {:db/id "answer-field-0d6cf9d9-7b5d-5a12-954e-3a9a145111eb" :answer-field/id #uuid "0d6cf9d9-7b5d-5a12-954e-3a9a145111eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab0d519e-ab8f-5357-872e-b30413c6b3ea" :answer-field/choices ["answer-ab0d519e-ab8f-5357-872e-b30413c6b3ea" "answer-be20304e-f6de-585f-9b63-d71900de2a74" "answer-7df0459b-970a-5ced-a1bc-719c9769982d" "answer-0c044647-5954-578d-89bb-bc6f400412e8" "answer-cb943e39-89bf-5763-b1be-0445659d52a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab0d519e-ab8f-5357-872e-b30413c6b3ea" :answer/id #uuid "ab0d519e-ab8f-5357-872e-b30413c6b3ea" :answer/type :answer.type/math :answer/value "(x-y){e}^{x-y}" :db/ensure [:answer/validate]} {:db/id "answer-be20304e-f6de-585f-9b63-d71900de2a74" :answer/id #uuid "be20304e-f6de-585f-9b63-d71900de2a74" :answer/type :answer.type/math :answer/value "\\frac{2{e}^{y-x}}{x-y}" :db/ensure [:answer/validate]} {:db/id "answer-7df0459b-970a-5ced-a1bc-719c9769982d" :answer/id #uuid "7df0459b-970a-5ced-a1bc-719c9769982d" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x-y}}{x-y}" :db/ensure [:answer/validate]} {:db/id "answer-0c044647-5954-578d-89bb-bc6f400412e8" :answer/id #uuid "0c044647-5954-578d-89bb-bc6f400412e8" :answer/type :answer.type/math :answer/value "{e}^{x-y}+x-y" :db/ensure [:answer/validate]} {:db/id "answer-cb943e39-89bf-5763-b1be-0445659d52a4" :answer/id #uuid "cb943e39-89bf-5763-b1be-0445659d52a4" :answer/type :answer.type/math :answer/value "{e}^{y-x}" :db/ensure [:answer/validate]} {:db/id "question-943c59c7-5044-5ab4-92f0-26722bf35b20" :question/id #uuid "943c59c7-5044-5ab4-92f0-26722bf35b20" :question/math-academy-id "q-108838" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{\\operatorname{sin}⁡(x+2y)}-\\frac{1}{2}.\n$$\n\n \nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=C-2x,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x+2y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+2\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2}\\,\\frac{\\text{d}z}{\\text{d}x}-\\frac{1}{2}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}\\,\\frac{\\text{d}z}{\\text{d}x}-\\frac{1}{2} & =\\frac{1}{\\operatorname{sin}⁡z}-\\frac{1}{2}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{2}{\\operatorname{sin}⁡z}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡z}{2}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\frac{1}{2}\\int \\operatorname{sin}⁡z\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ -\\frac{1}{2}\\operatorname{cos}⁡z & =x+K \\\\ \\operatorname{cos}⁡z & =C-2x,\\end{aligned}\n$$\n\nwhere $C=-2K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\operatorname{cos}⁡(x+2y)=C-2x\\,\\,\n$$\n\nTherefore, $g(x,y)=\\operatorname{cos}⁡(x+2y).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5c6152f7-42f5-56fc-b75a-263cd69c9d19"] :db/ensure [:question/validate]} {:db/id "answer-field-5c6152f7-42f5-56fc-b75a-263cd69c9d19" :answer-field/id #uuid "5c6152f7-42f5-56fc-b75a-263cd69c9d19" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fe722dbc-b929-55b0-84d4-b79092599856" :answer-field/choices ["answer-e18dc9e8-49fb-5ea3-a407-51da0784fc23" "answer-602b69f4-c68b-5264-9f73-206c78d3fa7b" "answer-1a44166c-ce03-507d-b55d-8543dd97c169" "answer-fe722dbc-b929-55b0-84d4-b79092599856" "answer-45350018-8a0e-55eb-b945-48b7b99e9399"] :db/ensure [:answer-field/validate]} {:db/id "answer-e18dc9e8-49fb-5ea3-a407-51da0784fc23" :answer/id #uuid "e18dc9e8-49fb-5ea3-a407-51da0784fc23" :answer/type :answer.type/math :answer/value "-2\\operatorname{cos}⁡(x+2y)" :db/ensure [:answer/validate]} {:db/id "answer-602b69f4-c68b-5264-9f73-206c78d3fa7b" :answer/id #uuid "602b69f4-c68b-5264-9f73-206c78d3fa7b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{sin}⁡(x+2y)" :db/ensure [:answer/validate]} {:db/id "answer-1a44166c-ce03-507d-b55d-8543dd97c169" :answer/id #uuid "1a44166c-ce03-507d-b55d-8543dd97c169" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{cos}⁡(x+2y)" :db/ensure [:answer/validate]} {:db/id "answer-fe722dbc-b929-55b0-84d4-b79092599856" :answer/id #uuid "fe722dbc-b929-55b0-84d4-b79092599856" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(x+2y)" :db/ensure [:answer/validate]} {:db/id "answer-45350018-8a0e-55eb-b945-48b7b99e9399" :answer/id #uuid "45350018-8a0e-55eb-b945-48b7b99e9399" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(x+2y)" :db/ensure [:answer/validate]} {:db/id "question-1808d5b9-dae6-5dea-b5bd-62c618289147" :question/id #uuid "1808d5b9-dae6-5dea-b5bd-62c618289147" :question/math-academy-id "q-149723" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{\\operatorname{ln}⁡(x+y)+2}-1.\n$$\n\n \nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=\\frac{x+C}{x+y},\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =\\frac{1}{\\operatorname{ln}⁡z+2}-1\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{1}{\\operatorname{ln}⁡z+2}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}(\\operatorname{ln}⁡z+2)\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int (\\operatorname{ln}⁡z+2)\\,\\text{d}z & =\\int \\text{d}x\\end{aligned}\n$$\n\nUsing integration by parts on the left side,\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡z+2 & \\,⟹\\,{u}^{′}=\\frac{1}{z} \\\\ {v}^{′}=1 & \\,⟹\\,v=z\\end{aligned}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\\int (\\operatorname{ln}⁡z+2)\\,\\text{d}z & =\\int \\text{d}x \\\\ z(\\operatorname{ln}⁡z+2)-\\int \\text{d}z & =\\int \\text{d}x \\\\ z(\\operatorname{ln}⁡z+2)-z & =x+C \\\\ z(\\operatorname{ln}⁡z+1) & =x+C.\\end{aligned}\n$$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\begin{aligned}(x+y)(\\operatorname{ln}⁡(x+y)+1) & =x+C \\\\ \\operatorname{ln}⁡(x+y)+1 & =\\frac{x+C}{x+y}\\end{aligned}\n$$\n\nTherefore, $g(x,y)=\\operatorname{ln}⁡(x+y)+1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-25217a67-7d84-5b06-8801-01edf4363fd0"] :db/ensure [:question/validate]} {:db/id "answer-field-25217a67-7d84-5b06-8801-01edf4363fd0" :answer-field/id #uuid "25217a67-7d84-5b06-8801-01edf4363fd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d60567b6-30a5-5299-bff7-543ccd03c29b" :answer-field/choices ["answer-807b691f-3c19-516b-a689-d6024d5b6077" "answer-f6059557-3dac-50d0-8066-8dd8cc82e79c" "answer-2e716eff-4358-55b4-8561-ca1c8320c525" "answer-d60567b6-30a5-5299-bff7-543ccd03c29b" "answer-47901134-19b2-5653-9a75-9c013a497690"] :db/ensure [:answer-field/validate]} {:db/id "answer-807b691f-3c19-516b-a689-d6024d5b6077" :answer/id #uuid "807b691f-3c19-516b-a689-d6024d5b6077" :answer/type :answer.type/math :answer/value "-2\\sqrt{\\operatorname{ln}⁡(x+y)}" :db/ensure [:answer/validate]} {:db/id "answer-f6059557-3dac-50d0-8066-8dd8cc82e79c" :answer/id #uuid "f6059557-3dac-50d0-8066-8dd8cc82e79c" :answer/type :answer.type/math :answer/value "2-\\operatorname{ln}⁡(x+y)" :db/ensure [:answer/validate]} {:db/id "answer-2e716eff-4358-55b4-8561-ca1c8320c525" :answer/id #uuid "2e716eff-4358-55b4-8561-ca1c8320c525" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x+y)" :db/ensure [:answer/validate]} {:db/id "answer-d60567b6-30a5-5299-bff7-543ccd03c29b" :answer/id #uuid "d60567b6-30a5-5299-bff7-543ccd03c29b" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x+y)+1" :db/ensure [:answer/validate]} {:db/id "answer-47901134-19b2-5653-9a75-9c013a497690" :answer/id #uuid "47901134-19b2-5653-9a75-9c013a497690" :answer/type :answer.type/math :answer/value "\\sqrt{\\operatorname{ln}⁡(x+y)}" :db/ensure [:answer/validate]} {:db/id 17592186168103 :tutorial/content "Suppose we have a differential equation of the form \n\n$$\ny ' = f ( a x + b y ),\n$$\n\nwhere $a$ and $b$ are real constants. In this case, we can rewrite the equation as a separable differential equation using the substitution $z= ax+by.$ We then proceed to solve this separable equation.\n\n To see how we apply this method, let's consider the following example: \n\n$$\ny' = (x+y)^2\n$$\n\nFirst, we make the substitution\n\n$$\nz = x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\dfrac{\\textrm{d}z}{\\textrm{d}x}  = 1 + \\,\\dfrac{\\textrm{d}y}{\\textrm{d}x} \\quad\\Longrightarrow\\quad\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\dfrac{\\textrm{d}z}{\\textrm{d}x} - 1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & ={z}^{2}\\end{aligned}\n$$\n\nExpressing this equation in the form $z'(x) = g(z)$ gives\n\n$$\n\\dfrac{\\textrm{d}z}{\\textrm{d}x}  = z^2+ 1.\n$$\n\nNotice that this differential equation is separable. So, we separate the variables and integrate both sides with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{1}{{z}^{2}+1}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int \\frac{1}{{z}^{2}+1}\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ \\operatorname{arctan}⁡z & =x+C\\end{aligned}\n$$\n\nFinally, we write the general solution to the equation in terms of $x$ using our original substitution, as follows:\n\n$$\n\\arctan {(x+y)}  = x + C\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186166982 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124442 :knowledge-point/questions ["question-a8c3fd0e-01dd-58d7-b5d0-e6ecb2b5f479"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a8c3fd0e-01dd-58d7-b5d0-e6ecb2b5f479" :question/id #uuid "a8c3fd0e-01dd-58d7-b5d0-e6ecb2b5f479" :question/math-academy-id "q-65054" :question/problem "Evaluate ${f}_{zyx}(1,1,-1)$ for $f(x,y,z)=xy\\operatorname{ln}⁡(x+y+z).$" :question/worked-solution "First, we find the first-order derivative ${f}_{z}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy\\operatorname{ln}⁡(x+y+z)) \\\\  & =xy\\frac{∂}{∂z}(\\operatorname{ln}⁡(x+y+z)) \\\\  & =\\frac{xy}{x+y+z}\\end{aligned}\n$$\n\nNow, we find ${f}_{zy}(x,y,z)$ by differentiating ${f}_{z}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{zy}(x,y,z) & =\\frac{∂}{∂y}({f}_{z}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(\\frac{xy}{x+y+z}) \\\\  & =\\frac{x\\cdot (x+y+z)-xy\\cdot (1)}{(x+y+z)^{2}} \\\\  & =\\frac{{x}^{2}+xy+xz-xy}{(x+y+z)^{2}} \\\\  & =\\frac{{x}^{2}+xz}{(x+y+z)^{2}}\\end{aligned}\n$$\n\nNext, we find ${f}_{zyx}(x,y,z)$ by differentiating ${f}_{zy}(x,y,z)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{zyx}(x,y,z) & =\\frac{∂}{∂x}({f}_{zy}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(\\frac{{x}^{2}+xz}{(x+y+z)^{2}}) \\\\  & =\\frac{(2x+z)\\cdot (x+y+z)^{2}-({x}^{2}+xz)\\cdot (2(x+y+z)\\cdot 1)}{(x+y+z)^{4}} \\\\  & =\\frac{(2x+z)(x+y+z)-2({x}^{2}+xz)}{(x+y+z)^{3}}\\end{aligned}\n$$\n\n \n\nFinally, we evaluate ${f}_{zyx}(x,y,z)$ at $(1,1,-1):$  \n\n$$\n\\begin{aligned}{f}_{zyx}(1,1,-1) & =\\frac{(2(1)+(-1))(1+1+(-1))-2({1}^{2}+1(-1))}{(1+1+(-1))^{3}}=\\frac{(1)(1)-2(0)}{(1)^{3}}=1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-58cd874b-d401-5dae-a003-642f47b6d5e1"] :db/ensure [:question/validate]} {:db/id "answer-field-58cd874b-d401-5dae-a003-642f47b6d5e1" :answer-field/id #uuid "58cd874b-d401-5dae-a003-642f47b6d5e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8bd1a042-f0e1-5280-a93f-79b975c4ee9e" :answer-field/choices ["answer-a5057d38-1225-50a0-b6ad-25ed31fa235e" "answer-0edad87c-2a7e-5ce2-948c-23ebc4486f11" "answer-87f3dc21-f9fe-515d-b7a6-aa328708748c" "answer-8bd1a042-f0e1-5280-a93f-79b975c4ee9e" "answer-ed0e24a1-111c-5e17-8f98-c82fe143a3a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5057d38-1225-50a0-b6ad-25ed31fa235e" :answer/id #uuid "a5057d38-1225-50a0-b6ad-25ed31fa235e" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-0edad87c-2a7e-5ce2-948c-23ebc4486f11" :answer/id #uuid "0edad87c-2a7e-5ce2-948c-23ebc4486f11" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-87f3dc21-f9fe-515d-b7a6-aa328708748c" :answer/id #uuid "87f3dc21-f9fe-515d-b7a6-aa328708748c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-8bd1a042-f0e1-5280-a93f-79b975c4ee9e" :answer/id #uuid "8bd1a042-f0e1-5280-a93f-79b975c4ee9e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-ed0e24a1-111c-5e17-8f98-c82fe143a3a6" :answer/id #uuid "ed0e24a1-111c-5e17-8f98-c82fe143a3a6" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "activity-5b774f06-abdb-5ce8-b0a4-4f02fda3281c" :activity/id #uuid "5b774f06-abdb-5ce8-b0a4-4f02fda3281c" :activity/title "Higher-Order Partial Derivatives" :activity/type :activity.type/review :activity/scope 17592186048781 :activity/course 17592186046658 :activity/steps ["step-345a4ba2-99a5-54c6-920b-943ebcfbdddc" "step-3fdcb306-4c4d-55b0-afc4-b7f0ddec864f" "step-7500e142-5145-59e0-8086-fdd6d710a0a6" "step-0156998a-6e16-5b9a-9f34-3fa9b3ed9afa" "step-ec92f449-cc5d-5eb7-8ed8-e8baf8365b8f"] :activity/first-step "step-345a4ba2-99a5-54c6-920b-943ebcfbdddc" :db/ensure [:activity/validate]} {:db/id "step-345a4ba2-99a5-54c6-920b-943ebcfbdddc" :step/id #uuid "345a4ba2-99a5-54c6-920b-943ebcfbdddc" :step/content "question-a8c3fd0e-01dd-58d7-b5d0-e6ecb2b5f479" :step/next "step-3fdcb306-4c4d-55b0-afc4-b7f0ddec864f" :db/ensure [:step/validate]} {:db/id "step-3fdcb306-4c4d-55b0-afc4-b7f0ddec864f" :step/id #uuid "3fdcb306-4c4d-55b0-afc4-b7f0ddec864f" :step/content 17592186335788 :step/next "step-7500e142-5145-59e0-8086-fdd6d710a0a6" :db/ensure [:step/validate]} {:db/id "step-7500e142-5145-59e0-8086-fdd6d710a0a6" :step/id #uuid "7500e142-5145-59e0-8086-fdd6d710a0a6" :step/content 17592186382379 :step/next "step-0156998a-6e16-5b9a-9f34-3fa9b3ed9afa" :db/ensure [:step/validate]} {:db/id "step-0156998a-6e16-5b9a-9f34-3fa9b3ed9afa" :step/id #uuid "0156998a-6e16-5b9a-9f34-3fa9b3ed9afa" :step/content 17592186268920 :step/next "step-ec92f449-cc5d-5eb7-8ed8-e8baf8365b8f" :db/ensure [:step/validate]} {:db/id "step-ec92f449-cc5d-5eb7-8ed8-e8baf8365b8f" :step/id #uuid "ec92f449-cc5d-5eb7-8ed8-e8baf8365b8f" :step/content 17592186268923 :db/ensure [:step/validate]} {:db/id 17592186192795 :knowledge-point/questions ["question-e74f917e-f8d4-558a-b0ff-23f924d4f647"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192982 :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼B(5,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=5,\\,{x}_{2}=3,\\,{x}_{3}=2,\\,{x}_{4}=1.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=5$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{5}{x}){\\theta }^{x}(1-\\theta )^{5-x},\\,x=0,1,…,5.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{5}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{5-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{5-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(5-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(5-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(5n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{3}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{5}{{x}_{4}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{5}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{5}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(5n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=4,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{5}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{5}{5})\\cdot (\\genfrac{}{}{0pt}{}{5}{3})\\cdot (\\genfrac{}{}{0pt}{}{5}{2})\\cdot (\\genfrac{}{}{0pt}{}{5}{1}) \\\\  & =1\\cdot 10\\cdot 10\\cdot 5 \\\\  & =500,\\end{aligned}\n$$\n\nand\n\n$$\nS=5+3+2+1=11.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(500)+11\\operatorname{ln}⁡\\theta +(5\\cdot 4-11)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡(500)+11\\operatorname{ln}⁡\\theta +9\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=500+11+9=520.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186189778 :answer-field/correct 17592186189779 :db/ensure [:answer-field/validate]} {:db/id 17592186192796 :knowledge-point/questions ["question-64469fd0-ae43-5b41-a537-3c86d8172dbc" "question-c465be49-1518-5dd7-9865-0bd33016513b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192983 :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼Po(\\theta )$ with unknown rate parameter $\\theta .$ You're given the particular sample\n\n$$\n{x}_{1}=3,\\,{x}_{2}=4,\\,{x}_{3}=2.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=a\\theta +b\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡c.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent Poisson random variables with unknown parameter $\\theta .$ Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & ={e}^{-\\theta }\\cdot \\frac{{\\theta }^{x}}{x!}.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta }\\cdot \\frac{{\\theta }^{{x}_{i}}}{{x}_{i}!}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta })+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡(\\theta )-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-\\theta {\\sum }_{i=1}^{n}1+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-n\\theta +\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-\\operatorname{ln}⁡({\\prod }_{i=1}^{n}{x}_{i}!)\\end{aligned}\n$$\n\nNow, using the sample data with $n=3,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i}! & =3!\\cdot 4!\\cdot 2!=6\\cdot 24\\cdot 2=288, \\\\ {\\sum }_{i=1}^{n}{x}_{i} & =3+4+2=9.\\end{aligned}\n$$\n\nTherefore, substituting the above values into our expression for $l(\\theta ),$ we get\n\n$$\n\\begin{aligned}l(\\theta ) & =-3\\theta +9\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡288.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=-3+9+288=294.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186189784 :answer-field/correct 17592186189789 :db/ensure [:answer-field/validate]} {:db/id "question-64469fd0-ae43-5b41-a537-3c86d8172dbc" :question/id #uuid "64469fd0-ae43-5b41-a537-3c86d8172dbc" :question/math-academy-id "q-159843" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼Po(\\theta )$ with unknown rate parameter $\\theta .$ You're given the particular sample\n\n$$\n{x}_{1}=4,\\,{x}_{2}=1,\\,{x}_{3}=0,\\,{x}_{4}=2.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=a\\theta +b\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡c.\n$$\n\nFind the value of $a+b+c.$\n\n*Hint: The probability mass function for a Poisson distribution is given by* \n\n$$\nf(x)=\\frac{{\\theta }^{x}{e}^{-\\theta }}{x!},\\,x=0,1,2,…\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent Poisson random variables with unknown parameter $\\theta .$ Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & ={e}^{-\\theta }\\cdot \\frac{{\\theta }^{x}}{x!}.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta }\\cdot \\frac{{\\theta }^{{x}_{i}}}{{x}_{i}!}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta })+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡(\\theta )-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-\\theta {\\sum }_{i=1}^{n}1+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-n\\theta +\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-\\operatorname{ln}⁡({\\prod }_{i=1}^{n}{x}_{i}!)\\end{aligned}\n$$\n\nNow, using the sample data with $n=4,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i}! & =4!\\cdot 1!\\cdot 0!\\cdot 2!=24\\cdot 1\\cdot 1\\cdot 2=48, \\\\ {\\sum }_{i=1}^{n}{x}_{i} & =4+1+0+2=7.\\end{aligned}\n$$\n\nTherefore, substituting the above values into our expression for $l(\\theta ),$ we get\n\n$$\n\\begin{aligned}l(\\theta ) & =-4\\theta +7\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡48.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=-4+7+48=51.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-85d1b04e-0566-577b-b438-e45254ccaf6a"] :db/ensure [:question/validate]} {:db/id "answer-field-85d1b04e-0566-577b-b438-e45254ccaf6a" :answer-field/id #uuid "85d1b04e-0566-577b-b438-e45254ccaf6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc56eca9-6be3-5f0a-a094-0678f9e9170c" :answer-field/choices ["answer-1b3f6197-0b93-51c0-a8fc-1a87b0fc384c" "answer-68a0ae60-a9a2-588a-aa23-b3eff3415153" "answer-bc56eca9-6be3-5f0a-a094-0678f9e9170c" "answer-3b8670f5-d19e-53f5-a1e9-7b40322e7c8f" "answer-a4a21446-5779-5e15-a526-d39dc8f0ed50"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b3f6197-0b93-51c0-a8fc-1a87b0fc384c" :answer/id #uuid "1b3f6197-0b93-51c0-a8fc-1a87b0fc384c" :answer/type :answer.type/math :answer/value "43" :db/ensure [:answer/validate]} {:db/id "answer-68a0ae60-a9a2-588a-aa23-b3eff3415153" :answer/id #uuid "68a0ae60-a9a2-588a-aa23-b3eff3415153" :answer/type :answer.type/math :answer/value "47" :db/ensure [:answer/validate]} {:db/id "answer-bc56eca9-6be3-5f0a-a094-0678f9e9170c" :answer/id #uuid "bc56eca9-6be3-5f0a-a094-0678f9e9170c" :answer/type :answer.type/math :answer/value "51" :db/ensure [:answer/validate]} {:db/id "answer-3b8670f5-d19e-53f5-a1e9-7b40322e7c8f" :answer/id #uuid "3b8670f5-d19e-53f5-a1e9-7b40322e7c8f" :answer/type :answer.type/math :answer/value "54" :db/ensure [:answer/validate]} {:db/id "answer-a4a21446-5779-5e15-a526-d39dc8f0ed50" :answer/id #uuid "a4a21446-5779-5e15-a526-d39dc8f0ed50" :answer/type :answer.type/math :answer/value "58" :db/ensure [:answer/validate]} {:db/id "question-c465be49-1518-5dd7-9865-0bd33016513b" :question/id #uuid "c465be49-1518-5dd7-9865-0bd33016513b" :question/math-academy-id "q-159844" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼Po(\\theta )$ with unknown rate parameter $\\theta .$ You're given the particular sample\n\n$$\n{x}_{1}=1,\\,{x}_{2}=6,\\,{x}_{3}=1.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=a\\theta +b\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡c.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent Poisson random variables with unknown parameter $\\theta .$ Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & ={e}^{-\\theta }\\cdot \\frac{{\\theta }^{x}}{x!}.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta }\\cdot \\frac{{\\theta }^{{x}_{i}}}{{x}_{i}!}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta })+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡(\\theta )-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-\\theta {\\sum }_{i=1}^{n}1+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-n\\theta +\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-\\operatorname{ln}⁡({\\prod }_{i=1}^{n}{x}_{i}!)\\end{aligned}\n$$\n\nNow, using the sample data with $n=3,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i}! & =1!\\cdot 6!\\cdot 1!=1\\cdot 720\\cdot 1=720, \\\\ {\\sum }_{i=1}^{n}{x}_{i} & =1+6+1=8.\\end{aligned}\n$$\n\nTherefore, substituting the above values into our expression for $l(\\theta ),$ we get\n\n$$\n\\begin{aligned}l(\\theta ) & =-3\\theta +8\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡720.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=-3+8+720=725.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f542d437-7725-5d57-a73d-ba62feecfe4e"] :db/ensure [:question/validate]} {:db/id "answer-field-f542d437-7725-5d57-a73d-ba62feecfe4e" :answer-field/id #uuid "f542d437-7725-5d57-a73d-ba62feecfe4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a0b0333d-4556-5509-a952-2fc4a3727122" :answer-field/choices ["answer-4ba06777-c305-5eb9-bc4b-fa8052f7aca5" "answer-4d3b5d82-8ea1-5bfd-82b1-7c058b7d2373" "answer-a0b0333d-4556-5509-a952-2fc4a3727122" "answer-f8280fca-980c-52dc-bac8-4baeb8109cb7" "answer-5eea3cbc-3134-5d61-ad72-b78a7587ebc2"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ba06777-c305-5eb9-bc4b-fa8052f7aca5" :answer/id #uuid "4ba06777-c305-5eb9-bc4b-fa8052f7aca5" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "answer-4d3b5d82-8ea1-5bfd-82b1-7c058b7d2373" :answer/id #uuid "4d3b5d82-8ea1-5bfd-82b1-7c058b7d2373" :answer/type :answer.type/math :answer/value "720" :db/ensure [:answer/validate]} {:db/id "answer-a0b0333d-4556-5509-a952-2fc4a3727122" :answer/id #uuid "a0b0333d-4556-5509-a952-2fc4a3727122" :answer/type :answer.type/math :answer/value "725" :db/ensure [:answer/validate]} {:db/id "answer-f8280fca-980c-52dc-bac8-4baeb8109cb7" :answer/id #uuid "f8280fca-980c-52dc-bac8-4baeb8109cb7" :answer/type :answer.type/math :answer/value "731" :db/ensure [:answer/validate]} {:db/id "answer-5eea3cbc-3134-5d61-ad72-b78a7587ebc2" :answer/id #uuid "5eea3cbc-3134-5d61-ad72-b78a7587ebc2" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-e74f917e-f8d4-558a-b0ff-23f924d4f647" :question/id #uuid "e74f917e-f8d4-558a-b0ff-23f924d4f647" :question/math-academy-id "q-159904" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼B(4,\\theta )$ with unknown probability of success $\\theta .$ You're given the particular sample \n\n$$\n{x}_{1}=1,\\,{x}_{2}=2,\\,{x}_{3}=3,\\,{x}_{4}=4.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=\\operatorname{ln}⁡a+b\\operatorname{ln}⁡\\theta +c\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent binomial random variables with an unknown probability of success $\\theta $ and $N=4$ as the number of trials. Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & =(\\genfrac{}{}{0pt}{}{N}{x}){\\theta }^{x}(1-\\theta )^{N-x},\\,x=0,1,…,N \\\\  & =(\\genfrac{}{}{0pt}{}{4}{x}){\\theta }^{x}(1-\\theta )^{4-x},\\,x=0,1,…,4.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡((\\genfrac{}{}{0pt}{}{4}{{x}_{i}}){\\theta }^{{x}_{i}}(1-\\theta )^{4-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})+\\operatorname{ln}⁡((1-\\theta )^{4-{x}_{i}}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡\\theta +{\\sum }_{i=1}^{n}(4-{x}_{i})\\operatorname{ln}⁡(1-\\theta ) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}+\\operatorname{ln}⁡(1-\\theta ){\\sum }_{i=1}^{n}(4-{x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})+S\\operatorname{ln}⁡\\theta +(4n-S)\\operatorname{ln}⁡(1-\\theta )\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$\n\nNow, note that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}) & =\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{1}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{2}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{3}})+\\operatorname{ln}⁡(\\genfrac{}{}{0pt}{}{4}{{x}_{4}}) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}})).\\end{aligned}\n$$\n\nSo, our expression for $l(\\theta )$ becomes\n\n$$\nl(\\theta )=\\operatorname{ln}⁡({\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}))+S\\operatorname{ln}⁡\\theta +(4n-S)\\operatorname{ln}⁡(1-\\theta ).\n$$\n\nNow, using the sample data with $n=4,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}(\\genfrac{}{}{0pt}{}{4}{{x}_{i}}) & =(\\genfrac{}{}{0pt}{}{4}{1})\\cdot (\\genfrac{}{}{0pt}{}{4}{2})\\cdot (\\genfrac{}{}{0pt}{}{4}{3})\\cdot (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  & =4\\cdot 6\\cdot 4\\cdot 1 \\\\  & =96,\\end{aligned}\n$$\n\nand\n\n$$\nS=1+2+3+4=10.\n$$\n\nSubstituting the above values into our expression for $l(\\theta )$, we get\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡(96)+10\\operatorname{ln}⁡\\theta +(4\\cdot 4-10)\\operatorname{ln}⁡(1-\\theta ) \\\\  & =\\operatorname{ln}⁡(96)+10\\operatorname{ln}⁡\\theta +6\\operatorname{ln}⁡(1-\\theta ).\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=96+10+6=112.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5a56878b-d9e6-528f-a90b-8eb05bc5081f"] :db/ensure [:question/validate]} {:db/id "answer-field-5a56878b-d9e6-528f-a90b-8eb05bc5081f" :answer-field/id #uuid "5a56878b-d9e6-528f-a90b-8eb05bc5081f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fbbf59dd-b827-5507-a139-4f86e1f3682c" :answer-field/choices ["answer-a69c00ce-c12a-53c6-b22c-ceb683008661" "answer-fbbf59dd-b827-5507-a139-4f86e1f3682c" "answer-1bef3a60-20f8-5cfb-8010-dc7503bbc503" "answer-aecb29d6-6f0a-5cb9-b349-858797ff2117" "answer-05029119-649c-5ee0-922d-7be3044e0bb7"] :db/ensure [:answer-field/validate]} {:db/id "answer-a69c00ce-c12a-53c6-b22c-ceb683008661" :answer/id #uuid "a69c00ce-c12a-53c6-b22c-ceb683008661" :answer/type :answer.type/math :answer/value "108" :db/ensure [:answer/validate]} {:db/id "answer-fbbf59dd-b827-5507-a139-4f86e1f3682c" :answer/id #uuid "fbbf59dd-b827-5507-a139-4f86e1f3682c" :answer/type :answer.type/math :answer/value "112" :db/ensure [:answer/validate]} {:db/id "answer-1bef3a60-20f8-5cfb-8010-dc7503bbc503" :answer/id #uuid "1bef3a60-20f8-5cfb-8010-dc7503bbc503" :answer/type :answer.type/math :answer/value "118" :db/ensure [:answer/validate]} {:db/id "answer-aecb29d6-6f0a-5cb9-b349-858797ff2117" :answer/id #uuid "aecb29d6-6f0a-5cb9-b349-858797ff2117" :answer/type :answer.type/math :answer/value "121" :db/ensure [:answer/validate]} {:db/id "answer-05029119-649c-5ee0-922d-7be3044e0bb7" :answer/id #uuid "05029119-649c-5ee0-922d-7be3044e0bb7" :answer/type :answer.type/math :answer/value "125" :db/ensure [:answer/validate]} {:db/id "activity-1cf54a38-7312-5d37-92a8-dc89f388d28f" :activity/id #uuid "1cf54a38-7312-5d37-92a8-dc89f388d28f" :activity/title "Log-Likelihood Functions for Discrete Probability Distributions" :activity/type :activity.type/review :activity/scope 17592186048346 :activity/course 17592186046658 :activity/steps ["step-c6a17d7e-1485-51bb-be6e-d6e6626dac3b" "step-aba41867-2e25-52f9-872f-a91e12458e1c" "step-122feefd-544d-5e14-bfd2-c9ac02d4abec" "step-949e1efa-cf43-5598-9a3f-e2a09ae9e53f" "step-c476b7cb-9b67-5d92-b4d7-00081ed3f837"] :activity/first-step "step-c6a17d7e-1485-51bb-be6e-d6e6626dac3b" :db/ensure [:activity/validate]} {:db/id "step-c6a17d7e-1485-51bb-be6e-d6e6626dac3b" :step/id #uuid "c6a17d7e-1485-51bb-be6e-d6e6626dac3b" :step/content 17592186192982 :step/next "step-aba41867-2e25-52f9-872f-a91e12458e1c" :db/ensure [:step/validate]} {:db/id "step-aba41867-2e25-52f9-872f-a91e12458e1c" :step/id #uuid "aba41867-2e25-52f9-872f-a91e12458e1c" :step/content 17592186192983 :step/next "step-122feefd-544d-5e14-bfd2-c9ac02d4abec" :db/ensure [:step/validate]} {:db/id "step-122feefd-544d-5e14-bfd2-c9ac02d4abec" :step/id #uuid "122feefd-544d-5e14-bfd2-c9ac02d4abec" :step/content "question-64469fd0-ae43-5b41-a537-3c86d8172dbc" :step/next "step-949e1efa-cf43-5598-9a3f-e2a09ae9e53f" :db/ensure [:step/validate]} {:db/id "step-949e1efa-cf43-5598-9a3f-e2a09ae9e53f" :step/id #uuid "949e1efa-cf43-5598-9a3f-e2a09ae9e53f" :step/content "question-c465be49-1518-5dd7-9865-0bd33016513b" :step/next "step-c476b7cb-9b67-5d92-b4d7-00081ed3f837" :db/ensure [:step/validate]} {:db/id "step-c476b7cb-9b67-5d92-b4d7-00081ed3f837" :step/id #uuid "c476b7cb-9b67-5d92-b4d7-00081ed3f837" :step/content "question-e74f917e-f8d4-558a-b0ff-23f924d4f647" :db/ensure [:step/validate]} {:db/id 17592186064276 :knowledge-point/questions ["question-c0098ac0-7ed8-5f08-8d20-947c580b7f8e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064119 :question/problem "Simplify the product $(x - 3)(x^2 - 2x + 6).$" :question/worked-solution "We distribute both terms of the binomial to the trinomial in the second parenthesis. Then, we simplify.\n\n$$\n\\eqalign{\n\t\t(x - 3)(x^2 - 2x + 6) &= \\\n\t\tx(x^2 - 2x + 6) - 3(x^2 - 2x + 6) &= \\\n\t\tx^3 - 2x^2 + 6x - 3x^2 + 6x - 18 &= \\\n\t\tx^3 - 5x^2 + 12x - 18\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064277 :knowledge-point/questions ["question-d7c22bb7-72a0-576c-8d37-5df7a0b2d33e" "question-efb60196-718e-5a66-900b-f5c4e1c9517a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064120 :question/problem "Given that  $(3s^2 + 2s - 1)(s^2 + s + 2) = 3s^4 + \\bbox[3pt,Gainsboro]{a}s^3 + \\bbox[3pt,Gainsboro]{b}s^2 + \\bbox[3pt,Gainsboro]{c}s - 2,$ calculate $a+b+c.$" :question/worked-solution "We distribute all three terms of the trinomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify.\n\n$$\n\\begin{aligned}(3{s}^{2}+2s-1)({s}^{2}+s+2) & = \\\\ 3{s}^{2}({s}^{2}+s+2)+2s({s}^{2}+s+2)+(-1)({s}^{2}+s+2) & = \\\\ 3{s}^{4}+3{s}^{3}+6{s}^{2}+2{s}^{3}+2{s}^{2}+4s-{s}^{2}-s-2 & = \\\\ 3{s}^{4}+5{s}^{3}+7{s}^{2}+3s-2\\end{aligned}\n$$\n\nMatching up the coefficients, we find that $a=5,$ $b=7,$ and $c=3.$\n\nSo, we have\n\n$$\na + b + c = 5 + 7 + 3 = 15.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064278 :knowledge-point/questions ["question-ad1d70aa-42cb-5c9b-8e55-ba51dafe3613" "question-6568de84-d0cb-5425-90cd-1a3ef070df84"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064121 :question/problem "What is the coefficient of $a^2b$ in the product $(a+b)(a^2 + ab + b^2)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify.\n\n$$\n\\begin{aligned}(a+b)({a}^{2}+ab+{b}^{2}) & = \\\\ a({a}^{2}+ab+{b}^{2})+b({a}^{2}+ab+{b}^{2}) & = \\\\ {a}^{3}+{a}^{2}b+a{b}^{2}+{a}^{2}b+a{b}^{2}+{b}^{3} & = \\\\ {a}^{3}+2{a}^{2}b+2a{b}^{2}+{b}^{3} & \\end{aligned}\n$$\n\nTherefore, the coefficient of $a^2 b$ is $2.$" :db/ensure [:question/validate]} {:db/id 17592186233791 :question/answer-fields ["answer-field-f5ad427f-a5c6-5d28-90ed-675589d89537"] :db/ensure [:question/validate]} {:db/id "answer-field-f5ad427f-a5c6-5d28-90ed-675589d89537" :answer-field/id #uuid "f5ad427f-a5c6-5d28-90ed-675589d89537" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4c8f52e7-2b8e-575c-9217-06206fea6f30" :answer-field/choices ["answer-30c71a89-1b78-5e7a-bc51-93f4bdcc0b79" "answer-b74b1c83-4325-5d72-b041-4d5e0349539b" "answer-581beaca-78ca-59ab-ba2b-664041e07f97" "answer-4c8f52e7-2b8e-575c-9217-06206fea6f30" "answer-d0c91194-623b-5e2f-ae4f-faff21602694"] :db/ensure 