64-5aaf-a2ac-d25521c85278"] :db/ensure [:question/validate]} {:db/id "answer-field-b44317ba-2764-5aaf-a2ac-d25521c85278" :answer-field/id #uuid "b44317ba-2764-5aaf-a2ac-d25521c85278" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9ee4d24e-23ef-5ad1-93ac-34b77b84473c" :answer-field/choices ["answer-9ee4d24e-23ef-5ad1-93ac-34b77b84473c"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ee4d24e-23ef-5ad1-93ac-34b77b84473c" :answer/id #uuid "9ee4d24e-23ef-5ad1-93ac-34b77b84473c" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "activity-5fe34547-15c9-5b67-8853-ec0046fda80a" :activity/id #uuid "5fe34547-15c9-5b67-8853-ec0046fda80a" :activity/title "Dividing With Negative Decimals and Fractions" :activity/type :activity.type/review :activity/scope 17592186048392 :activity/course 17592186046648 :activity/steps ["step-4a47f131-26dd-585f-ba85-92f4312d0160" "step-e5cfbbd4-d11e-5405-ba15-8c0b2976f8c2" "step-2473d2dd-c36e-59cc-a24d-7cd36087675c"] :activity/first-step "step-4a47f131-26dd-585f-ba85-92f4312d0160" :db/ensure [:activity/validate]} {:db/id "step-4a47f131-26dd-585f-ba85-92f4312d0160" :step/id #uuid "4a47f131-26dd-585f-ba85-92f4312d0160" :step/content "question-35226f58-033d-50fc-9ed5-94472de795ca" :step/next "step-e5cfbbd4-d11e-5405-ba15-8c0b2976f8c2" :db/ensure [:step/validate]} {:db/id "step-e5cfbbd4-d11e-5405-ba15-8c0b2976f8c2" :step/id #uuid "e5cfbbd4-d11e-5405-ba15-8c0b2976f8c2" :step/content "question-ab43471e-dafe-5dcf-b8bc-06037ed994ac" :step/next "step-2473d2dd-c36e-59cc-a24d-7cd36087675c" :db/ensure [:step/validate]} {:db/id "step-2473d2dd-c36e-59cc-a24d-7cd36087675c" :step/id #uuid "2473d2dd-c36e-59cc-a24d-7cd36087675c" :step/content "question-2ad85a11-bba5-5fae-afa8-bc7f058da66c" :db/ensure [:step/validate]} {:db/id "activity-0521a0d5-f5e3-5c81-bc28-29faeb852deb" :activity/id #uuid "0521a0d5-f5e3-5c81-bc28-29faeb852deb" :activity/title "Resonance 