s+2) & = \\\\ {s}^{4}-{s}^{3}+2{s}^{2}+2{s}^{3}-2{s}^{2}+4s-{s}^{2}+s-2 & = \\\\ {s}^{4}+{s}^{3}-{s}^{2}+5s-2\\end{aligned}\n$$\n\nTherefore, $a=1,$ $b=-1,$ and $c=5.$ So, \n\n$$\na+b+c=1+(-1)+5=5.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f11bf0b1-7d95-5083-be12-730d1dee4129"] :db/ensure [:question/validate]} {:db/id "answer-field-f11bf0b1-7d95-5083-be12-730d1dee4129" :answer-field/id #uuid "f11bf0b1-7d95-5083-be12-730d1dee4129" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-74aecbb6-b8e5-5ebd-857f-df6f9036c234" :answer-field/choices ["answer-913d3085-e6ae-5f6f-898a-07d1e1175573" "answer-e0fd4e23-d57a-5ac8-b610-7ece1ba4ab1c" "answer-d509cae9-f2bc-5f3b-ac9d-5abef902b561" "answer-fd942ed2-02f2-5c55-b087-0fd2363dcdd9" "answer-74aecbb6-b8e5-5ebd-857f-df6f9036c234"] :db/ensure [:answer-field/validate]} {:db/id "answer-913d3085-e6ae-5f6f-898a-07d1e1175573" :answer/id #uuid "913d3085-e6ae-5f6f-898a-07d1e1175573" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-e0fd4e23-d57a-5ac8-b610-7ece1ba4ab1c" :answer/id #uuid "e0fd4e23-d57a-5ac8-b610-7ece1ba4ab1c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-d509cae9-f2bc-5f3b-ac9d-5abef902b561" :answer/id #uuid "d509cae9-f2bc-5f3b-ac9d-5abef902b561" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-fd942ed2-02f2-5c55-b087-0fd2363dcdd9" :answer/id #uuid "fd942ed2-02f2-5c55-b087-0fd2363dcdd9" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-74aecbb6-b8e5-5ebd-857f-df6f9036c234" :answer/id #uuid "74aecbb6-b8e5-5ebd-857f-df6f9036c234" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186234405 :question/answer-fields ["answer-field-ef32ad11-6f3b-5dfc-a8a9-de51cab41cf5"] :db/ensure [:question/valid