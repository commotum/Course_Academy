[{:db/id 17592186120365 :question/problem "Determine the dimension of $\\text{Span}\\{[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}],[\\begin{aligned}-2 \\\\ 1 \\\\ -1\\end{aligned}],[\\begin{aligned}2 \\\\ -2 \\\\ 3\\end{aligned}]\\}.$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -2 & 2 \\\\ -2 & 1 & -2 \\\\ 1 & -1 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}2 & -2 & 2 \\\\ 0 & -1 & 0 \\\\ 1 & -1 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼[\\begin{aligned}2 & -2 & 2 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $3$ pivot columns (or alternatively, it has exactly $3$ non-zero rows). \n\nTherefore, the dimension of the span is $3.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186118304 :answer-field/correct 17592186118308 :db/ensure [:answer-field/validate]} {:db/id 17592186119845 :knowledge-point/questions ["question-b149c895-74ab-53c4-8e34-ba4f249fb566"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b149c895-74ab-53c4-8e34-ba4f249fb566" :question/id #uuid "b149c895-74ab-53c4-8e34-ba4f249fb566" :question/math-academy-id "q-79314" :question/problem "$\\text{dim}(\\text{Span}\\{[\\begin{aligned}-5 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]\\})=$" :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned}[\\begin{aligned}-5 & 2 & 0 & 1 \\\\ 0 & 0 & -2 & 0 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn this case, our matrix is already in a row echelon form.\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $2$ pivot columns (or alternatively, $2$ non-zero rows). \n\nTherefore,\n$\\text{dim}(\\text{Span}\\{[\\begin{aligned}-5 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ -2 \\\\ 0 \\\\ 0\\end{aligned}],[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]\\})=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6d524d4c-bdb9-5865-a9c3-811956ada022"] :db/ensure [:question/validate]} {:db/id "answer-field-6d524d4c-bdb9-5865-a9c3-811956ada022" :answer-field/id #uuid "6d524d4c-bdb9-5865-a9c3-811956ada022" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2674be6f-e836-53b6-ad75-f49bcd215297" :answer-field/choices ["answer-d68f1746-c721-55d0-abfa-7820321d3544" "answer-2fdaf3df-3466-5a46-9d91-de545d17a174" "answer-2674be6f-e836-53b6-ad75-f49bcd215297" "answer-628e0240-3161-5a31-bec3-d0d78a344f09" "answer-ca9bbb01-90f1-5914-b05b-4fdbb5c155e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-d68f1746-c721-55d0-abfa-7820321d3544" :answer/id #uuid "d68f1746-c721-55d0-abfa-7820321d3544" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-2fdaf3df-3466-5a46-9d91-de545d17a174" :answer/id #uuid "2fdaf3df-3466-5a46-9d91-de545d17a174" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-2674be6f-e836-53b6-ad75-f49bcd215297" :answer/id #uuid "2674be6f-e836-53b6-ad75-f49bcd215297" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-628e0240-3161-5a31-bec3-d0d78a344f09" :answer/id #uuid "628e0240-3161-5a31-bec3-d0d78a344f09" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-ca9bbb01-90f1-5914-b05b-4fdbb5c155e7" :answer/id #uuid "ca9bbb01-90f1-5914-b05b-4fdbb5c155e7" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "activity-7ba47f17-0fae-5ac4-aeae-fb08378b5bc9" :activity/id #uuid "7ba47f17-0fae-5ac4-aeae-fb08378b5bc9" :activity/title "The Dimension of a Span" :activity/type :activity.type/review :activity/scope 17592186048218 :activity/course 17592186046658 :activity/steps ["step-ca098e19-bec0-502e-83bc-ca18e83625bc" "step-c8698e91-362f-52ce-8632-aab433d3ae0e" "step-17a473c6-6c8d-5968-aa6a-8059d32a39f1" "step-60bb4227-9814-5e8d-9517-43a71cd69291" "step-34dded57-bc20-5c74-8a7c-26db7d4b2c49"] :activity/first-step "step-ca098e19-bec0-502e-83bc-ca18e83625bc" :db/ensure [:activity/validate]} {:db/id "step-ca098e19-bec0-502e-83bc-ca18e83625bc" :step/id #uuid "ca098e19-bec0-502e-83bc-ca18e83625bc" :step/content 17592186120365 :step/next "step-c8698e91-362f-52ce-8632-aab433d3ae0e" :db/ensure [:step/validate]} {:db/id "step-c8698e91-362f-52ce-8632-aab433d3ae0e" :step/id #uuid "c8698e91-362f-52ce-8632-aab433d3ae0e" :step/content 17592186481376 :step/next "step-17a473c6-6c8d-5968-aa6a-8059d32a39f1" :db/ensure [:step/validate]} {:db/id "step-17a473c6-6c8d-5968-aa6a-8059d32a39f1" :step/id #uuid "17a473c6-6c8d-5968-aa6a-8059d32a39f1" :step/content 17592186348199 :step/next "step-60bb4227-9814-5e8d-9517-43a71cd69291" :db/ensure [:step/validate]} {:db/id "step-60bb4227-9814-5e8d-9517-43a71cd69291" :step/id #uuid "60bb4227-9814-5e8d-9517-43a71cd69291" :step/content "question-b149c895-74ab-53c4-8e34-ba4f249fb566" :step/next "step-34dded57-bc20-5c74-8a7c-26db7d4b2c49" :db/ensure [:step/validate]} {:db/id "step-34dded57-bc20-5c74-8a7c-26db7d4b2c49" :step/id #uuid "34dded57-bc20-5c74-8a7c-26db7d4b2c49" :step/content 17592186278261 :db/ensure [:step/validate]} {:db/id 17592186133918 :knowledge-point/questions ["question-835570d9-9990-53ad-94a8-897ce7e4ef85"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133524 :question/problem "Evaluate $\\sqrt{x} + 2x -1$ when $x=16.$" :question/worked-solution "We replace $x$ with $16$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x}+2x-1 & = \\\\ \\sqrt{16}+2\\cdot 16-1 & = \\\\ \\sqrt{{4}^{2}}+32-1 & = \\\\ 4+32-1 & = \\\\ 35\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133919 :knowledge-point/questions ["question-f713a7bd-9c0b-5d5c-8fbb-e0cb95a59072" "question-47b013be-1b3f-5223-b931-2de57a055397"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133525 :question/problem "Evaluate $\\sqrt{3x-1}$ for $x=3.$" :question/worked-solution "We replace $x$ with $3$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{3x-1} & = \\\\ \\sqrt{3\\cdot 3-1} & = \\\\ \\sqrt{9-1} & = \\\\ \\sqrt{8} & \\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{8} & = \\\\ \\sqrt{4\\cdot 2} & = \\\\ \\sqrt{{2}^{2}\\cdot 2} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{2} & = \\\\ 2\\sqrt{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133920 :knowledge-point/questions ["question-8f049718-46eb-5f7d-b555-f56c650c3d43" "question-eb936307-5973-5d57-8360-74e0a38a6a75"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133526 :question/problem "Given that $f(x) = \\dfrac{\\sqrt{9x+3}}{\\sqrt{x-2}},$ find  $f(5).$" :question/worked-solution "We replace $x$ with $5$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(5) & =\\frac{\\sqrt{9(5)+3}}{\\sqrt{(5)-2}} \\\\  & =\\frac{\\sqrt{48}}{\\sqrt{3}} \\\\  & =\\sqrt{\\frac{48}{3}} \\\\  & =\\sqrt{16} \\\\  & =\\sqrt{{4}^{2}} \\\\  & =4\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133921 :knowledge-point/questions ["question-39e9c0e1-e2d8-5a05-8dd1-6cb147dae13d" "question-b915ea49-eb32-5bde-bff7-6605ab07f81d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133527 :question/problem "Evaluate $\\sqrt[3]{x+6}$ at $x=2.$" :question/worked-solution "We replace $x$ with $2$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{x+6} & = \\\\ \\sqrt[3]{2+6} & = \\\\ \\sqrt[3]{8} & = \\\\ \\sqrt[3]{{2}^{3}} & = \\\\ 2\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-835570d9-9990-53ad-94a8-897ce7e4ef85" :question/id #uuid "835570d9-9990-53ad-94a8-897ce7e4ef85" :question/math-academy-id "q-41328" :question/problem "Find the value of $\\frac{1}{3}\\sqrt{3+3y-6x}$ when $x=-4$ and $y=3.$" :question/worked-solution "We replace $x$ with $-4$ and $y$ with $3$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\sqrt{3+3y-6x} & = \\\\ \\frac{1}{3}\\sqrt{3+3\\cdot 3-6\\cdot (-4)} & = \\\\ \\frac{1}{3}\\sqrt{3+9+24} & = \\\\ \\frac{1}{3}\\sqrt{36} & = \\\\ \\frac{1}{3}\\sqrt{{6}^{2}} & = \\\\ \\frac{1}{3}\\cdot 6 & = \\\\ 2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fce42114-c1b5-50a6-bf85-6ab3f5076bae"] :db/ensure [:question/validate]} {:db/id "answer-field-fce42114-c1b5-50a6-bf85-6ab3f5076bae" :answer-field/id #uuid "fce42114-c1b5-50a6-bf85-6ab3f5076bae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2f3a61b6-3f9c-5e3a-93ac-ec4bc5edb44a" :answer-field/choices ["answer-11619533-2dd2-5a3d-81c2-7ecb3d60408b" "answer-2f3a61b6-3f9c-5e3a-93ac-ec4bc5edb44a" "answer-f63e6f58-7157-5263-bd40-2a29df7413e1" "answer-55716078-9de3-567e-a8ba-7657ff811bd6" "answer-cc98a45c-95cd-5beb-b363-4ca699f09bda"] :db/ensure [:answer-field/validate]} {:db/id "answer-11619533-2dd2-5a3d-81c2-7ecb3d60408b" :answer/id #uuid "11619533-2dd2-5a3d-81c2-7ecb3d60408b" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-2f3a61b6-3f9c-5e3a-93ac-ec4bc