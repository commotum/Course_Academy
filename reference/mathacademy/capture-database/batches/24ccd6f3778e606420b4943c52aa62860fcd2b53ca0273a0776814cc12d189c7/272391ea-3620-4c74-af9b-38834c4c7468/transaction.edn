validate]} {:db/id "answer-field-b05f2dfd-a721-5b93-9f30-acb8924f6d69" :answer-field/id #uuid "b05f2dfd-a721-5b93-9f30-acb8924f6d69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e80e679-f6b4-5b04-9218-ed350b2a908a" :answer-field/choices ["answer-111e1e23-33ab-5eb5-be89-a0516b2a0f95" "answer-9e80e679-f6b4-5b04-9218-ed350b2a908a" "answer-1ec5b16b-b497-5100-aef7-c6132ee98485" "answer-c7d48439-0e03-55e0-b331-25d7d27150ec" "answer-dafcd1fb-53a4-534a-b4b7-54b36e312d96"] :db/ensure [:answer-field/validate]} {:db/id "answer-111e1e23-33ab-5eb5-be89-a0516b2a0f95" :answer/id #uuid "111e1e23-33ab-5eb5-be89-a0516b2a0f95" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-9e80e679-f6b4-5b04-9218-ed350b2a908a" :answer/id #uuid "9e80e679-f6b4-5b04-9218-ed350b2a908a" :answer/type :answer.type/math :answer/value "2\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "answer-1ec5b16b-b497-5100-aef7-c6132ee98485" :answer/id #uuid "1ec5b16b-b497-5100-aef7-c6132ee98485" :answer/type :answer.type/math :answer/value "4\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "answer-c7d48439-0e03-55e0-b331-25d7d27150ec" :answer/id #uuid "c7d48439-0e03-55e0-b331-25d7d27150ec" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-dafcd1fb-53a4-534a-b4b7-54b36e312d96" :answer/id #uuid "dafcd1fb-53a4-534a-b4b7-54b36e312d96" :answer/type :answer.type/math :answer/value "7\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "question-47b013be-1b3f-5223-b931-2de57a055397" :question/id #uuid "47b013be-1b3f-5223-b931-2de57a055397" :question/math-academy-id "q-110876" :question/problem "Evaluate $\\sqrt{x+6}$ for $x=18.$" :question/worked-solution "We replace $x$ with $18$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}\\sqrt{x+6} & = \\\\ \\sqrt{18+6} & = \\\\ \\sqrt{24}\\end{aligned}\n$$\n\nWe can simplify even further using the product rule:\n\n$$\n\\begin{aligned}\\sqrt{24} & = \\\\ \\sqrt{4\\cdot 6} & = \\\\ \\sqrt{{2}^{2}\\cdot 6} & = \\\\ \\sqrt{{2}^{2}}\\cdot \\sqrt{6} & = \\\\ 2\\sqrt{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8e90436a-a035-56c5-a51b-e49d7f390847"] :db/ensure [:question/validate]} {:db/id "answer-field-8e90436a-a035-56c5-a51b-e49d7f390847" :answer-field/id #uuid "8e90436a-a035-56c5-a51b-e49d7f390847" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc62b660-ca90-5160-8d3b-b8f9d40e5821" :answer-field/choices ["answer-bc62b660-ca90-5160-8d3b-b8f9d40e5821" "answer-4616f056-d400-5fed-af7e-805ceebb663a" "answer-56837697-58ac-5ac8-bb0e-bac392cdf4c4" "answer-dfbfbe94-55cc-5cd7-acb5-5a1300990f3c" "answer-ca122d4f-8f7f-562e-8e01-40a512ff22e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc62b660-ca90-5160-8d3b-b8f9d40e5821" :answer/id #uuid "bc62b660-ca90-5160-8d3b-b8f9d40e5821" :answer/type :answer.type/math :answer/value "2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-4616f056-d400-5fed-af7e-805ceebb663a" :answer/id #uuid "4616f056-d400-5fed-af7e-805ceebb663a" :answer/type :answer.type/math :answer/value "3\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-56837697-58ac-5ac8-bb0e-bac392cdf4c4" :answer/id #uuid "56837697-58ac-5ac8-bb0e-bac392cdf4c4" :answer/type :answer.type/math :answer/value "4\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-dfbfbe94-55cc-5cd7-acb5-5a1300990f3c" :answer/id #uuid "dfbfbe94-55cc-5cd7-acb5-5a1300990f3c" :answer/type :answer.type/math :answer/value "6\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-ca122d4f-8f7f-562e-8e01-40a512ff22e4" :answer/id #uuid "ca122d4f-8f7f-562e-8e01-40a512ff22e4" :answer/type :answer.type/math :answer/value "6\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-8f049718-46eb-5f7d-b555-f56c650c3d43" :question/id #uuid "8f049718-46eb-5f7d-b555-f56c650c3d43" :question/math-academy-id "q-52468" :question/problem "Given $f(x)=\\frac{\\sqrt{6-x}}{\\sqrt{2x}},$ find $f(4).$" :question/worked-solution "We replace $x$ with $4$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(4) & =\\frac{\\sqrt{6-4}}{\\sqrt{2(4)}} \\\\  & =\\frac{\\sqrt{2}}{\\sqrt{8}} \\\\  & =\\sqrt{\\frac{2}{8}} \\\\  & =\\sqrt{\\frac{1}{4}} \\\\  & =\\frac{\\sqrt{1}}{\\sqrt{4}} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fb2688e1-5e14-5f96-96c0-66110c3015b3"] :db/ensure [:question/validate]} {:db/id "answer-field-fb2688e1-5e14-5f96-96c0-66110c3015b3" :answer-field/id #uuid "fb2688e1-5e14-5f96-96c0-66110c3015b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a32d3e56-29c9-5f9e-ae3b-31974d85ea9b" :answer-field/choices ["answer-4b1d7bf3-79e8-5f6a-a787-1942ef2d447c" "answer-72ecac52-df71-5a38-a2de-7bbcc536ca98" "answer-c5ffdf83-1221-565a-a1d5-b13a32ab5b2d" "answer-a32d3e56-29c9-5f9e-ae3b-31974d85ea9b" "answer-14b446ee-925e-5150-9102-8ce738601644"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b1d7bf3-79e8-5f6a-a787-1942ef2d447c" :answer/id #uuid "4b1d7bf3-79e8-5f6a-a787-1942ef2d447c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-72ecac52-df71-5a38-a2de-7bbcc536ca98" :answer/id #uuid "72ecac52-df71-5a38-a2de-7bbcc536ca98" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c5ffdf83-1221-565a-a1d5-b13a32ab5b2d" :answer/id #uuid "c5ffdf83-1221-565a-a1d5-b13a32ab5b2d" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-a32d3e56-29c9-5f9e-ae3b-31974d85ea9b" :answer/id #uuid "a32d3e56-29c9-5f9e-ae3b-31974d85ea9b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-14b446ee-925e-5150-9102-8ce738601644" :answer/id #uuid "14b446ee-925e-5150-9102-8ce738601644" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "question-eb936307-5973-5d57-8360-74e0a38a6a75" :question/id #uuid "eb936307-5973-5d57-8360-74e0a38a6a75" :question/math-academy-id "q-110880" :question/problem "Given $f(x)=\\frac{\\sqrt{2x+1}}{\\sqrt{x}},$ find $f(4).$" :question/worked-solution "We replace $x$ with $4$ in the given expression, and simplify:\n\n$$\n\\begin{aligned}f(4) & =\\frac{\\sqrt{2(4)+1}}{\\sqrt{4}} \\\\  & =\\frac{\\sqrt{8+1}}{\\sqrt{4}} \\\\  & =\\frac{\\sqrt{9}}{\\sqrt{4}} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f7673ceb-8e6d-5364-9482-6b416602c124"] :db/ensure [:question/validate]} {:db/id "answer-field-f7673ceb-8e6d-5364-9482-6b416602c124" :answer-field/id #uuid "f7673ceb-8e6d-5364-9482-6b416602c124" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-31db443d-c6d0-5385-b07f-7e9d5e679d9f" :answer-field/choices ["answer-2ce0c442-0a71-57e6-8c71-2a00f8f9d8c0" "answer-31db443d-c6d0-5385-b07f-7e9d5e679d9f" "answer-dfadbbd3-1cac-5ceb-92f1-382d762f0a51" "answer-cc8f25ab-9e0b-5ba1-a2ce-d0e96e483f92" "answer-a14f8f6f-4411-5acd-ac00-53bbe0011da0"] :db/ensure [:answer-field/validate]} {:db/id "answer-2ce0c442-0a71-57e6-8c71-2a00f8f9d8c0" :answer/id #uuid "2ce0c442-0a71-57e6-8c71-2a00f8f9d8c0" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-31db443d-c6d0-5385-b07f-7e9d5e679d9f" :answer/id #uuid "31db443d-c6d0-5385-b07f-7e9d5e679d9f" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-dfadbbd3-1cac-5ceb-92f1-382d762f0a51" :answer/id #uuid "dfadbbd3-1cac-5ceb-92f1-382d762f0a51" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-cc8f25ab-9e0b-5ba1