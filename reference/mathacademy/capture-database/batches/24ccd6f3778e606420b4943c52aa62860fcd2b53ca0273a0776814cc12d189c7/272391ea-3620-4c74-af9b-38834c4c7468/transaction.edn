2}-4t+4) & = \\\\ {t}^{2}({t}^{2}-4t+4)+(-6t)({t}^{2}-4t+4)+9({t}^{2}-4t+4) & = \\\\ {t}^{4}-4{t}^{3}+4{t}^{2}-6{t}^{3}+24{t}^{2}-24t+9{t}^{2}-36t+36 & = \\\\ {t}^{4}-10{t}^{3}+37{t}^{2}-60t+36\\end{aligned}\n$$\n\nTherefore, $a=-10,$ $b=37,$ and $c=-60.$ So, \n\n$$\na+b+c=-10+37+(-60)=-33.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b2072f7a-cde2-54db-a02e-520c47dd2afc"] :db/ensure [:question/validate]} {:db/id "answer-field-b2072f7a-cde2-54db-a02e-520c47dd2afc" :answer-field/id #uuid "b2072f7a-cde2-54db-a02e-520c47dd2afc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-afcb38cd-b552-5548-a076-654fa26d9cec" :answer-field/choices ["answer-043b906f-a914-598a-9f91-5ca6fcec0a3f" "answer-afcb38cd-b552-5548-a076-654fa26d9cec" "answer-45da7d3c-cb8c-5c94-8b92-1b817b5a7a63" "answer-234ba434-25d1-5f9f-b0f4-93fdd591f9c9" "answer-70ae1955-aef8-599b-9edf-0669967c6133"] :db/ensure [:answer-field/validate]} {:db/id "answer-043b906f-a914-598a-9f91-5ca6fcec0a3f" :answer/id #uuid "043b906f-a914-598a-9f91-5ca6fcec0a3f" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "answer-afcb38cd-b552-5548-a076-654fa26d9cec" :answer/id #uuid "afcb38cd-b552-5548-a076-654fa26d9cec" :answer/type :answer.type/math :answer/value "-33" :db/ensure [:answer/validate]} {:db/id "answer-45da7d3c-cb8c-5c94-8b92-1b817b5a7a63" :answer/id #uuid "45da7d3c-cb8c-5c94-8b92-1b817b5a7a63" :answer/type :answer.type/math :answer/value "-36" :db/ensure [:answer/validate]} {:db/id "answer-234ba434-25d1-5f9f-b0f4-93fdd591f9c9" :answer/id #uuid "234ba434-25d1-5f9f-b0f4-93fdd591f9c9" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-70ae1955-aef8-599b-9edf-0669967c6133" :answer/id #uuid "70ae1955-aef8-599b-9edf-0669967c6133" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "question-ad1d70aa-42cb-5c9b-8e55-ba51dafe3613" :question/id #uuid "ad1d70aa-42cb-5c9b-8e55-ba51dafe3613" :question/math-academy-id "q-2824" :question/problem "What is the coefficient of $zx$ in the product $(2x-y+2z)(y+2x)?$" :question/worked-solution "We distribute the terms of the trinomial in the first set of parentheses to the binomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(2x-y+2z)(y+2x) & = \\\\ 2x(y+2x)+(-y)(y+2x)+2z(y+2x) & = \\\\ 2xy+4{x}^{2}-{y}^{2}-2xy+2zy+4zx & = \\\\ 4{x}^{2}-{y}^{2}+2zy+4zx\\end{aligned}\n$$\n\nTherefore,  the coefficient of $zx$ is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6aa15b14-1505-5982-a0d8-def0168c9e04"] :db/ensure [:question/validate]} {:db/id "answer-field-6aa15b14-1505-5982-a0d8-def0168c9e04" :answer-field/id #uuid "6aa15b14-1505-5982-a0d8-def0168c9e04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-765bdb1f-67ac-5dc9-bba2-204cd7872f04" :answer-field/choices ["answer-ab9be181-5cb5-5df7-a4fe-95000c00d7d7" "answer-a9ee0db0-eadf-5cac-9bef-5cd84f91d4de" "answer-5a9d9b4b-ca94-5d3d-944d-072608c2a0de" "answer-e5120102-be3d-54f2-8be6-81caab2a8713" "answer-765bdb1f-67ac-5dc9-bba2-204cd7872f04"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab9be181-5cb5-5df7-a4fe-95000c00d7d7" :answer/id #uuid "ab9be181-5cb5-5df7-a4fe-95000c00d7d7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-a9ee0db0-eadf-5cac-9bef-5cd84f91d4de" :answer/id #uuid "a9ee0db0-eadf-5cac-9bef-5cd84f91d4de" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-5a9d9b4b-ca94-5d3d-944d-072608c2a0de" :answer/id #uuid "5a9d9b4b-ca94-5d3d-944d-072608c2a0de" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-e5120102-be3d-54f2-8be6-81caab2a8713" :answer/id #uuid "e5120102-be3d-54f2-8be6-81caab2a8713" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-765bdb1f-67ac-5dc9-bba2-204cd7872f04" :answer/id #uuid "765bdb1f-67ac-5dc9-bba2-204cd7872f04" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-6568de84-d0cb-5425-90cd-1a3ef070df84" :question/id #uuid "6568de84-d0cb-5425-90cd-1a3ef070df84" :question/math-academy-id "q-78193" :question/problem "What is the coefficient of $v{w}^{2}$ in the product $(v+w)({v}^{2}+4vw+{w}^{2})?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(v+w)({v}^{2}+4vw+{w}^{2}) & = \\\\ v({v}^{2}+4vw+{w}^{2})+w({v}^{2}+4vw+{w}^{2}) & = \\\\ {v}^{3}+4{v}^{2}w+v{w}^{2}+{v}^{2}w+4v{w}^{2}+{w}^{3} & = \\\\ {v}^{3}+5{v}^{2}w+5v{w}^{2}+{w}^{3} & \\end{aligned}\n$$\n\nTherefore, the coefficient of $v{w}^{2}$ is $5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-51974270-1ca8-52e1-824e-f717ac5b66dc"] :db/ensure [:question/validate]} {:db/id "answer-field-51974270-1ca8-52e1-824e-f717ac5b66dc" :answer-field/id #uuid "51974270-1ca8-52e1-824e-f717ac5b66dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a2f632f9-78c7-5486-b830-3a6212593dcc" :answer-field/choices ["answer-27a47b63-7e07-581d-978f-3dccf5855a7a" "answer-cd9434a0-e706-544d-be79-f52eabca7932" "answer-a2f632f9-78c7-5486-b830-3a6212593dcc" "answer-56772ae2-cad4-5fde-980a-bbea606ea018" "answer-e4f5c15f-6fb5-5fc1-a3e6-e8629f0df664"] :db/ensure [:answer-field/validate]} {:db/id "answer-27a47b63-7e07-581d-978f-3dccf5855a7a" :answer/id #uuid "27a47b63-7e07-581d-978f-3dccf5855a7a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-cd9434a0-e706-544d-be79-f52eabca7932" :answer/id #uuid "cd9434a0-e706-544d-be79-f52eabca7932" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a2f632f9-78c7-5486-b830-3a6212593dcc" :answer/id #uuid "a2f632f9-78c7-5486-b830-3a6212593dcc" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-56772ae2-cad4-5fde-980a-bbea606ea018" :answer/id #uuid "56772ae2-cad4-5fde-980a-bbea606ea018" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-e4f5c15f-6fb5-5fc1-a3e6-e8629f0df664" :answer/id #uuid "e4f5c15f-6fb5-5fc1-a3e6-e8629f0df664" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186065375 :tutorial/content "To multiply a binomial and a trinomial, we take each term of the binomial and multiply it by every term in the trinomial. Then, we simplify by collecting like terms.\n\nFor example, to multiply $({\\color{blue}{x}} + {\\color{red}{3}})$ and $(x^2 + 2x+4),$ we multiply ${\\color{blue}{x}}$ and $(x^2 + 2x+4),$ and then we add this to the product of ${\\color{red}{3}}$ and $(x^2 + 2x+4).$ \n\n$$\n\\begin{aligned}(x+3)({x}^{2}+2x+4) & = \\\\ x({x}^{2}+2x+4)+3({x}^{2}+2x+4) & = \\\\ {x}^{3}+2{x}^{2}+4x+3{x}^{2}+6x+12\\end{aligned}\n$$\n\nThen, we group the like terms and simplify:\n\n$$\n\\begin{aligned}{x}^{3}+2{x}^{2}+4x+3{x}^{2}+6x+12 & = \\\\ {x}^{3}+2{x}^{2}+3{x}^{2}+4x+6x+12 & = \\\\ {x}^{3}+5{x}^{2}+10x+12\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186064448 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} [:db/retract 17592186304363 :answer-field/choices 17592186302775] [:db/retract 17592186304119 :answer-field/choices 17592186302805] [:db/retract 17592186304734 :answer-field/choices 17592186303265] [:db/retract 17592186311172 :answer-field/choices 17592186310756] [:db/retract 17592186311223 :answer-field/choices 17592186310735] [:db/retract 17592186311278 :answer-field/choices 17592186308941] [:db/retract 17592186167185 :question/answer-fields 17592186164135] [:db/retract 17592186167185 :question/answer-fields 17592186164136] {:db/id 17592186166936 :knowledge-point/questions ["question-2f885aae-2228-5978-9940-05380822e48d" "question-dc370c50-c95d-53af-9285-c137ac273145"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166524 :question/problem "Consider the following system of differential equations:\n\n$$\n\\mathbf{x}'(t) =\nA\n\\mathbf{x}(t) +\n\\mathbf{f}(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form $\\mathbf{x}_p(t)  = \\Phi \\mathbf{u}(t),$ where $\\Phi$ is a fundamental matrix for the corresponding homogeneous system and $\\mathbf{u}(t)$ is a column vector of functions to be determined. A derivation of the formula for $\\mathbf x_p(t)$ is given below. \n\n$\\textrm{L1}{:}\\:$ $\\mathbf{x}_p(t)  = \\Phi \\mathbf{u}(t)$\n\n$\\textrm{L2}{:}\\:$ $\\mathbf{x}'_p(t) = \\Phi \\mathbf{u}'(t) + \\Phi' \\mathbf{u}(t)$\n\n$\\textrm{L3}{:}\\:$ $\\Phi \\mathbf{u}'(t) + \\Phi' \\mathbf{u}(t) = A \\Phi \\mathbf{u}(t) + \\mathbf{f}(t)$\n\n$\\textrm{L4}{:}\\:$ $\\Phi' = A \\Phi$\n\n$\\textrm{L5}{:}\\:$ $\\Phi \\mathbf{u}'(t) = \\mathbf{f}(t)$\n\n$\\textrm{L6}{:}\\:$ $\\mathbf{u}'(t) = \\Phi^{-1}(t) \\mathbf{f}(t)$\n\n$\\textrm{L7}{:}\\:$ $\\displaystyle\\mathbf{u}(t) = \\int \\Phi^{-1} \\mathbf{f}(t) \\, \\text{d}t$\n\n$\\textrm{L8}{:}\\:$ $\\displaystyle\\mathbf{x}_p(t) = \\Phi \\int \\Phi^{-1}\\mathbf{f}(t) \\, \\text{d}t$\n\nFill in the blanks with the correct reasons to justify each step of the reasoning.\n\n$\\quad$ Line $\\textrm{L4}$ follows from the fact that ![](images/e2/e2e16ba2ee71f82214649c533dc658cdba72e3b3f49cf8563f117ee2fe89a07d.svg) matrix.\n\n$\\quad$ Line $\\textrm{L6}$ follows from line $\\textrm{L5}$ by  ![](images/2d/2dd0b78f14b4f044b6c747da364728bb5555f5c36710b6bf66ab74cc7f5e294f.svg) both sides of the equation.\n\n$\\quad$ Line $\\textrm{L8}$ is obtained by substituting $\\textrm{L7}$ into ![](images/01/01ab649cd1dec87ec0dd5c1f3f8f79ce76553d52463ae2c6102c0ce7be67163d.svg)" :question/worked-solution "Let's examine each statement in turn.\n\n- We first consider line $\\textrm{L4}.$ Since $\\Phi$ is a fundamental matrix, its columns are solutions to the homogeneous system $\\mathbf{x}'(t) =A\\mathbf{x}(t),$ i.e., by substituting any column $\\mathbf{c}(t)$ of $\\Phi$ into the homogeneous system, we get\n\n$$\n\\mathbf{c}'(t) =A\\mathbf{c}(t),\n$$\n\nwhere $\\mathbf{c}'(t)$ is the corresponding column of derivatives in $\\Phi.$ As a result, this means that $\\Phi' = A \\Phi.$ Therefore, $\\textrm{L4}$ follows from the fact that ![](images/d5/d59c4945960aa127fa7c03bcf32bd9bab88f237932bf222dd796a3153145ed4c.svg) matrix.\n\n- Next, we consider lines $\\textrm{L5}$ and $\\textrm{L6}.$ Since $\\Phi$ is a fundamental matrix, its columns are linearly independent. So, $\\Phi$ is invertible. Therefore, $\\textrm{L6}$ follows from $\\textrm{L5}$ by ![](images/13/13d7995b324919ea6f2f7b3cb45abc58bb48c87d82165aea6bb455059952764c.svg) both sides of the equation:\n\n$$\n\\begin{aligned}{Φ}^{-1}\\cdot Φ{u}^{′}(t) & ={Φ}^{-1}\\cdot f(t) \\\\ ({Φ}^{-1}Φ)\\cdot {u}^{′}(t) & ={Φ}^{-1}\\cdot f(t) \\\\ {u}^{′}(t) & ={Φ}^{-1}\\cdot f(t)\\end{aligned}\n$$\n\n- Finally, we consider lines $\\textrm{L1},$ $\\textrm{L7},$ and $\\textrm{L8}.$ Substituting\n\n$$\n\\mathbf{u}(t) = \\int \\Phi^{-1} \\mathbf{f}(t) \\, \\text{d}t\n$$\n\nfrom $\\textrm{L7}$ into $\\textrm{L1},$ we get\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φu(t) \\\\  & =Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, $\\textrm{L8}$ is obtained by substituting $\\textrm{L7}$ into  ![](images/28/28362ce6a7bd47f8c810d5fc3772428094f65e66a4e88df145b0c91a9e9016e9.svg)" :db/ensure [:question/validate]} {:db/id 17592186166937 :knowledge-point/questions ["question-b7f6c605-b7b1-59c8-8433-ca15cc2ba91a" "question-b0ea864c-5060-5aaa-9a4d-f96c65c21a98"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166525 :question/problem "![](images/02/02f22b5daa1290af87e8a15340bd2e75abdb9305136f9b7f3162763e4dee440e.svg)\nConsider the system of differential equations and the fundamental matrix of the corresponding homogeneous system above. Using the method of variation of parameters, compute $\\Phi^{-1} \\, \\mathbf{f}(t)$ and the particular solution $\\mathbf{x}_p(t)$ of the system." :question/worked-solution "We'll look for a particular solution in the form\n\n$$\n\\mathbf{x}_p(t)  = \\Phi \\, \\mathbf{u}(t)\n$$\n\nwhere $\\Phi$ is a fundamental matrix for the corresponding homogeneous system, $\\mathbf{f}(t)$ is the forcing column vector and\n\n$$\n\\mathbf{u}(t) = \\int \\Phi^{-1} \\, \\mathbf{f}(t) \\, \\text{d}t.\n$$\n\nIn our case,\n![](images/31/3139ce9adc8c4803bc8cf3332e76c2bad4cb35489024478178ab74023dee7e44.svg)\n\nSince $\\Phi$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2 \\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{0\\cdot (-2{e}^{-4t})-2{e}^{-4t}\\cdot {e}^{3t}}[\\begin{aligned}-2{e}^{-4t} & -2{e}^{-4t} \\\\ -{e}^{3t} & 0\\end{aligned}] \\\\  & =-\\frac{{e}^{t}}{2}[\\begin{aligned}-2{e}^{-4t} & -2{e}^{-4t} \\\\ -{e}^{3t} & 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{-3t} & {e}^{-3t} \\\\ \\frac{1}{2}{e}^{4t} & 0\\end{aligned}] \\\\ {Φ}^{-1}\\,f(t) & =[\\begin{aligned}{e}^{-3t} & {e}^{-3t} \\\\ \\frac{1}{2}{e}^{4t} & 0\\end{aligned}][\\begin{aligned}{e}^{t} \\\\ 2{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}3{e}^{-2t} \\\\ \\frac{1}{2}{e}^{5t}\\end{aligned}]\\end{aligned}\n$$\n\nNow, using our formula for $\\mathbf{u}(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}3{e}^{-2t} \\\\ \\frac{1}{2}{e}^{5t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 3{e}^{-2t}\\,\\text{d}t \\\\ \\int \\frac{1}{2}{e}^{5t}\\,\\text{d}t\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{3}{2}{e}^{-2t} \\\\ \\frac{1}{10}{e}^{5t}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}0 & 2{e}^{-4t} \\\\ {e}^{3t} & -2{e}^{-4t}\\end{aligned}][\\begin{aligned}-\\frac{3}{2}{e}^{-2t} \\\\ \\frac{1}{10}{e}^{5t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{5}{e}^{t} \\\\ -\\frac{17}{10}{e}^{t}\\end{aligned}] \\\\  & ={e}^{t}[\\begin{aligned}\\frac{1}{5} \\\\ -\\frac{17}{10}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166938 :knowledge-point/questions ["question-858d57fe-416e-56c5-af8b-4ea6e4298062"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166526 :question/problem "![](images/2a/2a4a67e816a9de4c0278f607d2e98ceae6cbd315df086980d7a604da88ed1926.svg)\nConsider the system of differential equations. Using the method of variation of parameters, the general solution of the equation can be written in the form\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\"><img alt=\"\" src=\"images/07/07ad5e11661f5d8ede3728e39999890e71848ffc0290b471e9b4130f026431a2.svg\"/></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$\\boxed{\\rule{0pt}{1.3em}\\phantom{xxxxxxxx}}$\n\n</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">.</td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\n\\mathbf{x}(t) = \\mathbf{x}_c(t) + \\mathbf{x}_p(t)\n$$\n\nwhere $\\mathbf{x}_c(t)$ is the complementary solution (solution of the corresponding homogeneous system) and $\\mathbf{x}_p(t)$ is a particular solution.\n\nNotice that we are given that\n![](images/85/8570eb051b14077d86cbe0cda29f79d12de8529001c6e9b3a2698c107792ef1b.svg)\n\nWe'll look for a particular solution in the form\n\n$$\n\\mathbf{x}_p(t)  = \\Phi \\, \\mathbf{u}(t)\n$$\n\nwhere $\\Phi$ is a fundamental matrix for the corresponding homogeneous system, $\\mathbf{f}(t)$ is the forcing column vector and\n\n$$\n\\mathbf{u}(t) = \\int \\Phi^{-1} \\, \\mathbf{f}(t) \\, \\text{d}t.\n$$\n\nIn our case,\n![](images/9f/9fe602a563fbfbfd3f3331df7243ebf1aa5aa1c90a01550a033d4a4dfd0f0639.svg)\n\nSince $\\Phi$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2 \\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-2t}\\cdot {e}^{-4t}-0}[\\begin{aligned}{e}^{-4t} & 0 \\\\ 0 & {e}^{-2t}\\end{aligned}] \\\\  & ={e}^{6t}[\\begin{aligned}{e}^{-4t} & 0 \\\\ 0 & {e}^{-2t}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2t} & 0 \\\\ 0 & {e}^{4t}\\end{aligned}]. \\\\ {Φ}^{-1}\\,f(t) & =[\\begin{aligned}{e}^{2t} & 0 \\\\ 0 & {e}^{4t}\\end{aligned}][\\begin{aligned}2t \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2t{e}^{2t} \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nNow, using our formula for $\\mathbf{u}(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}2t{e}^{2t} \\\\ 0\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 2t{e}^{2t}\\,\\text{d}t \\\\ \\int 0\\,\\text{d}t\\end{aligned}].\\end{aligned}\n$$\n\nIntegrating the components by parts, we get the following:\n\n- For the first component, let $u=2t$ and $\\text{d}v=e^{2t}\\,\\text{d}t.$ Then, $\\text{d}u=2\\,\\text{d}t$ and $v=\\dfrac{1}{2}e^{2t}.$ So,\n\n$$\n\\begin{aligned}\\int 2t{e}^{2t}\\,\\text{d}t & =(2t)\\cdot \\frac{1}{2}{e}^{2t}-\\int \\frac{1}{2}{e}^{2t}(2\\,\\text{d}t) \\\\  & =t{e}^{2t}-\\int {e}^{2t}\\,\\text{d}t \\\\  & =t{e}^{2t}-\\frac{1}{2}{e}^{2t} \\\\  & =\\frac{1}{2}{e}^{2t}(2t-1).\\end{aligned}\n$$\n\n- For the second component, the integrand is zero, so the integral is zero.\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{-2t} & 0 \\\\ 0 & {e}^{-4t}\\end{aligned}][\\begin{aligned}\\frac{1}{2}{e}^{2t}(2t-1) \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2t-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186304363 :answer-field/correct 17592186303295 :db/ensure [:answer-field/validate]} {:db/id 17592186304119 :answer-field/correct 17592186303429 :db/ensure [:answer-field/validate]} {:db/id 17592186304734 :answer-field/correct 17592186303782 :db/ensure [:answer-field/validate]} {:db/id 17592186311172 :answer-field/correct 17592186308746 :db/ensure [:answer-field/validate]} {:db/id 17592186311223 :answer-field/correct 17592186309507 :db/ensure [:answer-field/validate]} {:db/id 17592186311278 :answer-field/correct 17592186310337 :db/ensure [:answer-field/validate]} {:db/id "question-2f885aae-2228-5978-9940-05380822e48d" :question/id #uuid "2f885aae-2228-5978-9940-05380822e48d" :question/math-academy-id "q-336714" :question/problem "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from line $\\text{L1}$ by {{field-1}} both sides of  the equation.\n\n$\\,$ Line $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into the {{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L5}$ by {{field-3}} both sides of the equation.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by {{field-4}} both sides of the equation." :question/worked-solution "Let's examine each statement in turn.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ To get $\\text{L2},$ we are $\\text{differentiating}$ with respect to $t$ both sides of the equation in $\\text{L1}:$\n\n$$\n\\begin{aligned}{x}_{p}^{′}(t) & =(Φu(t))^{′} \\\\ {x}_{p}^{′}(t) & =Φ{u}^{′}(t)+{Φ}^{′}u(t)\\end{aligned}\n$$\n\n- Next we consider lines $\\text{L1},$ $\\text{L2},$ and $\\text{L3}.$ Let's substitute ${x}_{p}(t)=Φu(t)$ from $\\text{L1}$ and ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$ from $\\text{L2}$ into the initial system of ODEs:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =Ax(t)+f(t) \\\\ Φ{u}^{′}(t)+{Φ}^{′}u(t) & =AΦu(t)+f(t)\\end{aligned}\n$$\n\nTherefore, $\\text{L3}$ is obtained by substituting $\\text{L1}\\text{ and }\\text{L2}$ into the initial system of ODEs.\n\n- Next, we consider lines $\\text{L5}$ and $\\text{L6}.$ Since $Φ$ is a fundamental matrix, its columns are linearly independent. So, $Φ$ is invertible. Therefore, $\\text{L6}$ follows from $\\text{L5}$ by $\\text{pre-multiplying by }{Φ}^{-1}$ both sides of the equation:\n\n$$\n\\begin{aligned}{Φ}^{-1}\\cdot Φ{u}^{′}(t) & ={Φ}^{-1}\\cdot f(t) \\\\ ({Φ}^{-1}Φ)\\cdot {u}^{′}(t) & ={Φ}^{-1}\\cdot f(t) \\\\ {u}^{′}(t) & ={Φ}^{-1}\\cdot f(t).\\end{aligned}\n$$\n\n- Finally, we consider lines $\\text{L6}$ and $\\text{L7}.$ To get $\\text{L7},$ we are $\\text{integrating}$ both sides of the equation in $\\text{L6}:$\n\n$$\n\\begin{aligned}\\int {u}^{′}(t)\\,\\text{d}t & =\\int {Φ}^{-1}(t)f(t)\\,\\text{d}t \\\\ u(t) & =\\int {Φ}^{-1}f(t)\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-df59866d-4c1e-5c2c-a658-0b6f4acd9b56" "answer-field-cbc02d96-2205-5f54-a299-6c