te]} {:db/id "step-6f8e4396-102c-5e78-8d1e-683b8f19f689" :step/id #uuid "6f8e4396-102c-5e78-8d1e-683b8f19f689" :step/content "question-1430584e-5e6b-5a21-98c2-3433956718bf" :db/ensure [:step/validate]} [:db/retract 17592186137854 :answer-field/choices 17592186137856] [:db/retract 17592186137854 :answer-field/choices 17592186137857] [:db/retract 17592186137854 :answer-field/choices 17592186137858] [:db/retract 17592186137854 :answer-field/choices 17592186137859] [:db/retract 17592186137854 :answer-field/choices 17592186137855] [:db/retract 17592186137860 :answer-field/choices 17592186137861] [:db/retract 17592186137860 :answer-field/choices 17592186137862] [:db/retract 17592186137860 :answer-field/choices 17592186137863] [:db/retract 17592186137860 :answer-field/choices 17592186137864] [:db/retract 17592186137860 :answer-field/choices 17592186137865] {:db/id 17592186138420 :knowledge-point/questions ["question-6c871005-09ff-5497-b5c8-d9bfa75173ab" "question-bb3555b9-96c6-521f-8784-a2e30e2526a4" "question-f31bb0dc-4f18-5dd8-8c4d-ef7d0360e3ae" "question-ab277d55-701f-5a3b-8c81-a817296b0326"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138186 :question/problem "Expand $(x + 3)(x - 3).$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=x$ and $b=3,$ we have\n\n$$\n\\eqalign{\n\t\t(x + 3)(x - 3) &= \\[5pt]\n\t\tx^2 - 3^2 &= \\[5pt]\n\t\tx^2 - 9.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186138421 :knowledge-point/questions ["question-b84ec7b7-6813-5817-a8fb-50c9de1b86e9" "question-e564aec0-fea4-5f31-8155-02342652a572"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138187 :question/problem "Expand $(5x - 4)(5x + 4) .$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=5x$ and $b=4,$ we have\n\n$$\n\\eqalign{\n\t\t(5x - 4)(5x + 4) &= \\[5pt]\n\t\t(5x)^2 - (4)^2 &= \\[5pt]\n\t\t25x^2 - 16.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186138422 :knowledge-point/questions ["question-3eea8cdc-2e47-57e6-a2cc-366fd1162497"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138188 :question/problem "Expand $(6x + y^2)(6x - y^2) .$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=6x$ and $b=y^2,$ we have\n\n$$\n\\eqalign{\n\t\t(6x + y^2)(6x - y^2) &= \\[5pt]\n\t\t(6x)^2 - \\left(y^2\\right)^2 &= \\[5pt]\n\t\t36x^2 - y^4.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186138423 :knowledge-point/questions ["question-4a8a7bf3-5b8f-5a40-b9f8-b1ddba947324"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138189 :question/problem "Expand $(2x^n-1)(2x^n+1).$" :question/worked-solution "We will use the difference of square formula:\n\n$$\n(a + b)(a - b) = a^2 - b^2\n$$\n\nSubstituting $a=2x^n$ and $b=1,$ we have\n\n$$\n\\begin{aligned}(2{x}^{n}-1)(2{x}^{n}+1) & = \\\\ {(2{x}^{n})}^{2}-(1)^{2} & = \\\\ {2}^{2}\\cdot ({x}^{n})^{2}-1 & = \\\\ 4{x}^{2n}-1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-6c871005-09ff-5497-b5c8-d9bfa75173ab" :question/id #uuid "6c871005-09ff-5497-b5c8-d9bfa75173ab" :question/math-academy-id "q-110716" :question/problem "$(9-y)(9+y)=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=9$ and $b=y,$ we have\n\n$$\n\\begin{aligned}(9-y)(9+y) & = \\\\ {9}^{2}-{y}^{2} & = \\\\ 81-{y}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e15b82c8-d6ca-58f4-9a30-37b8485a176e"] :db/ensure [:question/validate]} {:db/id "answer-field-e15b82c8-d6ca-58f4-9a30-37b8485a176e" :answer-field/id #uuid "e15b82c8-d6ca-58f4-9a30-37b8485a176e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-500a8310-ca26-58f9-8936-872ef14dcc3