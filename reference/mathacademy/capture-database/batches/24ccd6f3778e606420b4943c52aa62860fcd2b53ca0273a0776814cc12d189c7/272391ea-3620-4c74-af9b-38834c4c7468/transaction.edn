pe/radio :answer-field/correct "answer-89cb1df2-e524-5570-9838-bdd99a2d88d6" :answer-field/choices ["answer-6ada63d2-f554-569d-adf8-851cac7fd0c7" "answer-f8de2013-753a-599d-accc-a03d56128aa1" "answer-f222be28-aefa-5ea1-ae26-55a00d649b12" "answer-6861b754-7244-526a-bb95-db4bb52ba278" "answer-89cb1df2-e524-5570-9838-bdd99a2d88d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ada63d2-f554-569d-adf8-851cac7fd0c7" :answer/id #uuid "6ada63d2-f554-569d-adf8-851cac7fd0c7" :answer/type :answer.type/math :answer/value "36{y}^{2}+9" :db/ensure [:answer/validate]} {:db/id "answer-f8de2013-753a-599d-accc-a03d56128aa1" :answer/id #uuid "f8de2013-753a-599d-accc-a03d56128aa1" :answer/type :answer.type/math :answer/value "36{y}^{2}-18y-9" :db/ensure [:answer/validate]} {:db/id "answer-f222be28-aefa-5ea1-ae26-55a00d649b12" :answer/id #uuid "f222be28-aefa-5ea1-ae26-55a00d649b12" :answer/type :answer.type/math :answer/value "36{y}^{2}-36y+9" :db/ensure [:answer/validate]} {:db/id "answer-6861b754-7244-526a-bb95-db4bb52ba278" :answer/id #uuid "6861b754-7244-526a-bb95-db4bb52ba278" :answer/type :answer.type/math :answer/value "36{y}^{2}-36y-9" :db/ensure [:answer/validate]} {:db/id "answer-89cb1df2-e524-5570-9838-bdd99a2d88d6" :answer/id #uuid "89cb1df2-e524-5570-9838-bdd99a2d88d6" :answer/type :answer.type/math :answer/value "36{y}^{2}-9" :db/ensure [:answer/validate]} {:db/id 17592186139151 :question/problem "$(3{x}^{2}-2y)(3{x}^{2}+2y)=$" :question/worked-solution "We will use the difference of squares formula:\n\n$$\n(a+b)(a-b)={a}^{2}-{b}^{2}\n$$\n\nSubstituting $a=3{x}^{2}$ and $b=2y,$ we have\n\n$$\n\\begin{aligned}(3{x}^{2}-2y)(3{x}^{2}+2y) & = \\\\ {(3{x}^{2})}^{2}-(2y)^{2} & = \\\\ 9{x}^{4}-4{y}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186137854 :answer-field/correct "answer-b42599b7-aa2d-5b6b-a16a-905840183e72" :answer-field/choices ["answer-e253494d-ebf2-5ebc-b66a-512100b15481" "answer-ba