tion/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-02ad41b4-5643-5fdd-94bb-5143aa556000"] :db/ensure [:question/validate]} {:db/id "answer-field-02ad41b4-5643-5fdd-94bb-5143aa556000" :answer-field/id #uuid "02ad41b4-5643-5fdd-94bb-5143aa556000" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-847d5534-9a07-591e-8c65-030a30cdf269" :answer-field/choices ["answer-bf0dc2fd-800b-5cc0-abd4-015b13c25b9b" "answer-18c4c7ec-5083-5460-99fa-85cb717da0d7" "answer-847d5534-9a07-591e-8c65-030a30cdf269" "answer-e062f903-0c5a-5932-92b5-ed51805f36a6" "answer-a7e924e6-94bb-598a-91c2-4fb36c4c10ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf0dc2fd-800b-5cc0-abd4-015b13c25b9b" :answer/id #uuid "bf0dc2fd-800b-5cc0-abd4-015b13c25b9b" :answer/type :answer.type/text :answer/value "Negative" :db/ensure [:answer/validate]} {:db/id "answer-18c4c7ec-5083-5460-99fa-85cb717da0d7" :answer/id #uuid "18c4c7ec-5083-5460-99fa-85cb717da0d7" :answer/type :answer.type/text :answer/value "Not enough information" :db/ensure [:answer/validate]} {:db/id "answer-847d5534-9a07-591e-8c65-030a30cdf269" :answer/id #uuid "847d5534-9a07-591e-8c65-030a30cdf269" :answer/type :answer.type/text :answer/value "Positive" :db/ensure [:answer/validate]} {:db/id "answer-e062f903-0c5a-5932-92b5-ed51805f36a6" :answer/id #uuid "e062f903-0c5a-5932-92b5-ed51805f36a6" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id "answer-a7e924e6-94bb-598a-91c2-4fb36c4c10ad" :answer/id #uuid "a7e924e6-94bb-598a-91c2-4fb36c4c10ad" :answer/type :answer.type/text :answer/value "Zero" :db/ensure [:answer/validate]} {:db/id "activity-09d4bb8f-af12-534d-8b4d-e6041622fc03" :activity/id #uuid "09d4bb8f-af12-534d-8b4d-e6041622fc03" :activity/title "Calculating Slopes of Straight Lines" :activity/type :activity.type/review :activity/scope 17592186049061 :activity/course 17592186046648 :activity/steps ["step-a6d8