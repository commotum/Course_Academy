e "0" :db/ensure [:answer/validate]} {:db/id "answer-edc65bcc-d2fe-53b4-adbb-14fbe3820622" :answer/id #uuid "edc65bcc-d2fe-53b4-adbb-14fbe3820622" :answer/type :answer.type/math :answer/value "\\text{Col}(AB)" :db/ensure [:answer/validate]} {:db/id "answer-469aaf27-4b35-5ddb-af60-0d3a090cdba2" :answer/id #uuid "469aaf27-4b35-5ddb-af60-0d3a090cdba2" :answer/type :answer.type/math :answer/value "\\text{Null}(AB)" :db/ensure [:answer/validate]} {:db/id "answer-8ef7a3c7-e6d0-590a-b888-9bcd103feaf9" :answer/id #uuid "8ef7a3c7-e6d0-590a-b888-9bcd103feaf9" :answer/type :answer.type/math :answer/value "\\text{Null}({B}^{T}{A}^{T})" :db/ensure [:answer/validate]} {:db/id "answer-d1b15563-4d8e-5b3b-bc52-ab610dd2ec47" :answer/id #uuid "d1b15563-4d8e-5b3b-bc52-ab610dd2ec47" :answer/type :answer.type/math :answer/value "{R}^{m}" :db/ensure [:answer/validate]} {:db/id "activity-9ad0665c-4138-59ae-93cc-e6c2dc9739c7" :activity/id #uuid "9ad0665c-4138-59ae-93cc-e6c2dc9739c7" :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type :activity.type/review :activity/scope 17592186049881 :activity/course 17592186046660 :activity/steps ["step-004ef1a7-c656-507c-a13c-b006f3f85452" "step-e1b380f9-a0f5-5846-b099-eca54ee4d1fe" "step-976c6c0f-2b52-5b2f-a247-68cc82512cf5" "step-a1794f0c-c435-5d32-9d3f-3acd3b837de1" "step-fdb62714-5e6a-5d9d-a318-b5c03ffa46c2"] :activity/first-step "step-004ef1a7-c656-507c-a13c-b006f3f85452" :db/ensure [:activity/validate]} {:db/id "step-004ef1a7-c656-507c-a13c-b006f3f85452" :step/id #uuid "004ef1a7-c656-507c-a13c-b006f3f85452" :step/content 17592186134070 :step/next "step-e1b380f9-a0f5-5846-b099-eca54ee4d1fe" :db/ensure [:step/validate]} {:db/id "step-e1b380f9-a0f5-5846-b099-eca54ee4d1fe" :step/id #uuid "e1b380f9-a0f5-5846-b099-eca54ee4d1fe" :step/content 17592186134072 :step/next "step-976c6c0f-2b52-5b2f-a247-68cc82512cf5" :db/ensure [:step/validate]} {:db/id "step-976c6c0f-2b52-5b2f-a247-68cc82512cf5" :step/id #uuid "976c6c0f-2b52-5b2f-a247-68cc82512cf5" :step/content "question-c0dba1c9-96a3-58a5-b951-f858c4ad10f5" :step/next "step-a1794f0c-c435-5d32-9d3f-3acd3b837de1" :db/ensure [:step/validate]} {:db/id "step-a1794f0c-c435-5d32-9d3f-3acd3b837de1" :step/id #uuid "a1794f0c-c435-5d32-9d3f-3acd3b837de1" :step/content 17592186380580 :step/next "step-fdb62714-5e6a-5d9d-a318-b5c03ffa46c2" :db/ensure [:step/validate]} {:db/id "step-fdb62714-5e6a-5d9d-a318-b5c03ffa46c2" :step/id #uuid "fdb62714-5e6a-5d9d-a318-b5c03ffa46c2" :step/content 17592186362784 :db/ensure [:step/validate]} {:db/id 17592186115310 :knowledge-point/questions ["question-48c1b745-ea84-58de-8c55-67874acb2883" "question-49a4d1a9-08de-560d-b9e9-2048bdc86e7d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115139 :question/problem "Find all of the real solutions to the equation $9x^4 = \\dfrac{1}{9}.$" :question/worked-solution "We can solve this equation by isolating the $x^4$ term and then taking the $4$th root of each side.\n\nFirst, let's isolate the $x^4$ term on the left-hand side:\n\n$$\n\\begin{aligned}9{x}^{4} & =\\frac{1}{9} \\\\ {x}^{4} & =\\frac{1}{81}\\end{aligned}\n$$\n\nNow, we take the $4$th root of each side and solve for $x.$ Since the exponent $(4)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{4} & =\\frac{1}{81} \\\\ \\sqrt[4]{{x}^{4}} & =\\pm \\sqrt[4]{\\frac{1}{81}} \\\\ x & =\\pm \\sqrt[4]{{(\\frac{1}{3})}^{4}} \\\\ x & =\\pm \\frac{1}{3}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm \\dfrac13.$" :db/ensure [:question/validate]} {:db/id 17592186115311 :knowledge-point/questions ["question-f481106a-9bb9-56a6-bdda-a603ba8e3a03" "question-80133e3d-6a6e-531f-96e9-2c88946d7720"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115140 :question/problem "Find all of the real solutions to the equation $(x-3)^4=-\\dfrac{1}{81}.$" :question/worked-solution "Notice that $(x-3)^4 \\geq 0$ for all values of $x$ because the exponent ($4$) is even. This expression can never be negative. \n\nTherefore, there are no real solutions to this equation." :db/ensure [:question/validate]} {:db/id "question-48c1b745-ea84-58de-8c55-67874acb2883" :question/id #uuid "48c1b745-ea84-58de-8c55-67874acb2883" :question/math-academy-id "q-111432" :question/problem "Find all of the real solutions to the equation ${x}^{8}=256.$" :question/worked-solution "We can solve this equation by taking the $8$th root of each side and solving for $x.$ Since the exponent $(8)$  is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{8} & =256 \\\\ \\sqrt[8]{{x}^{8}} & =\\pm \\sqrt[8]{256} \\\\ x & =\\pm \\sqrt[8]{{2}^{8}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d41a6a03-8ac6-50f3-989c-c4f2f248ef4a"] :db/ensure [:question/validate]} {:db/id "answer-field-d41a6a03-8ac6-50f3-989c-c4f2f248ef4a" :answer-field/id #uuid "d41a6a03-8ac6-50f3-989c-c4f2f248ef4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d47a91dc-8ede-5f9c-9d92-2ef194aa7d7c" :answer-field/choices ["answer-d47a91dc-8ede-5f9c-9d92-2ef194aa7d7c" "answer-8077695a-7be0-5f57-a402-02fe156c48c4" "answer-e370bcbf-edcc-5e53-bfa1-d3a7f7b920d2" "answer-5e02902a-4e09-5633-8b9e-162c48602cea" "answer-456ceebb-e8a3-5b0f-859b-21d38bb5eedc"] :db/ensure [:answer-field/validate]} {:db/id "answer-d47a91dc-8ede-5f9c-9d92-2ef194aa7d7c" :answer/id #uuid "d47a91dc-8ede-5f9c-9d92-2ef194aa7d7c" :answer/type :answer.type/math :answer/value "\\pm 2" :db/ensure [:answer/validate]} {:db/id "answer-8077695a-7be0-5f57-a402-02fe156c48c4" :answer/id #uuid "8077695a-7be0-5f57-a402-02fe156c48c4" :answer/type :answer.type/math :answer/value "\\pm 4" :db/ensure [:answer/validate]} {:db/id "answer-e370bcbf-edcc-5e53-bfa1-d3a7f7b920d2" :answer/id #uuid "e370bcbf-edcc-5e53-bfa1-d3a7f7b920d2" :answer/type :answer.type/math :answer/value "\\pm 8" :db/ensure [:answer/validate]} {:db/id "answer-5e02902a-4e09-5633-8b9e-162c48602cea" :answer/id #uuid "5e02902a-4e09-5633-8b9e-162c48602cea" :answer/type :answer.type/text :answer/value "$2$ only" :db/ensure [:answer/validate]} {:db/id "answer-456ceebb-e8a3-5b0f-859b-21d38bb5eedc" :answer/id #uuid "456ceebb-e8a3-5b0f-859b-21d38bb5eedc" :answer/type :answer.type/text :answer/value "$4$ only" :db/ensure [:answer/validate]} {:db/id "question-49a4d1a9-08de-560d-b9e9-2048bdc86e7d" :question/id #uuid "49a4d1a9-08de-560d-b9e9-2048bdc86e7d" :question/math-academy-id "q-91337" :question/problem "Find all of the real solutions to the equation ${x}^{6}=64.$" :question/worked-solution "We can solve this equation by taking the $6$th root of each side and solving for $x.$ Since the exponent $(6)$  is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}{x}^{6} & =64 \\\\ \\sqrt[6]{{x}^{6}} & =\\pm \\sqrt[6]{64} \\\\ x & =\\pm \\sqrt[6]{{2}^{6}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3a974b9a-1983-5b53-86c0-307685fb8dcb"] :db/ensure [:question/validate]} {:db/id "answer-field-3a974b9a-1983-5b53-86c0-307685fb8dcb" :answer-field/id #uuid "3a974b9a-1983-5b53-86c0-307685fb8dcb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2123cae8-cb1a-5228-85b4-5f749192b6a4" :answer-field/choices ["answer-2123cae8-cb1a-5228-85b4-5f749192b6a4" "answer-f8b599f8-ea72-5a9e-a427-3abc331f2f40" "answer-2fd8b37a-1e03-5b26-9907-5b4238479f4f" "answer-a079d803-c0e8-5a69-908f-7d7f78c8f16a" "answer-2b3fe37f-f28d-59da-ba3c-f29c6d8c79be"] :db/ensure [:answer-field/validate]} {:db/id "answer-2123cae8-cb1a-5228-85b4-5f749192b6a4" :answer/id #uuid "2123cae8-cb1a-5228-85b4-5f749192b6a4" :answer/type :answer.type/math :answer/value "\\pm 2" :db/ensure [:answer/validate]} {:db/id "answer-f8b599f8-ea72-5a9e-a427-3abc331f2f40" :answer/id #uuid "f8b599f8-ea72-5a9e-a427-3abc331f2f40" :answer/type :answer.type/math :answer/value "\\pm 4" :db/ensure [:answer/validate]} {:db/id "answer-2fd8b37a-1e03-5b26-9907-5b4238479f4f" :answer/id #uuid "2fd8b37a-1e03-5b26-9907-5b4238479f4f" :answer/type :answer.type/math :answer/value "\\pm 8" :db/ensure [:answer/validate]} {:db/id "answer-a079d803-c0e8-5a69-908f-7d7f78c8f16a" :answer/id #uuid "a079d803-c0e8-5a69-908f-7d7f78c8f16a" :answer/type :answer.type/text :answer/value "$2$ only" :db/ensure [:answer/validate]} {:db/id "answer-2b3fe37f-f28d-59da-ba3c-f29c6d8c79be" :answer/id #uuid "2b3fe37f-f28d-59da-ba3c-f29c6d8c79be" :answer/type :answer.type/text :answer/value "$4$ only" :db/ensure [:answer/validate]} {:db/id "question-f481106a-9bb9-56a6-bdda-a603ba8e3a03" :question/id #uuid "f481106a-9bb9-56a6-bdda-a603ba8e3a03" :question/math-academy-id "q-111442" :question/problem "Find all of the real solutions to the equation $\\frac{(x+4)^{4}}{25}=25.$" :question/worked-solution "We can solve this equation by isolating the $(x+4)^{4}$ term and then taking the $4$th root of each side.\n\nFirst, let's isolate the $(x+4)^{4}$ term on the left-hand side:\n\n$$\n\\begin{aligned}\\frac{(x+4)^{4}}{25} & =25 \\\\ (x+4)^{4} & =625\\end{aligned}\n$$\n\nNow, we take the $4$th root of each side and solve for $x.$ Since the exponent $(4)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}(x+4)^{4} & =625 \\\\ \\sqrt[4]{(x+4)^{4}} & =\\pm \\sqrt[4]{625} \\\\ x+4 & =\\pm \\sqrt[4]{{5}^{4}} \\\\ x+4 & =\\pm 5 \\\\ x & =-4\\pm 5\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-9$ and $x=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ddb6fa7b-1fb9-5740-bed5-f388b665266b"] :db/ensure [:question/validate]} {:db/id "answer-field-ddb6fa7b-1fb9-5740-bed5-f388b665266b" :answer-field/id #uuid "ddb6fa7b-1fb9-5740-bed5-f388b665266b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c80c0be2-5eb8-5f9b-bcf9-872d44ce5073" :answer-field/choices ["answer-f33d340d-daf0-5075-96f9-10bbd81a45f3" "answer-c80c0be2-5eb8-5f9b-bcf9-872d44ce5073" "answer-046961d9-841f-51f7-ba46-6248fd584f28" "answer-dd046e4c-0a37-524b-be1d-418cb02c11ba" "answer-12570bb9-131f-5544-adfe-03cf59187a89"] :db/ensure [:answer-field/validate]} {:db/id "answer-f33d340d-daf0-5075-96f9-10bbd81a45f3" :answer/id #uuid "f33d340d-daf0-5075-96f9-10bbd81a45f3" :answer/type :answer.type/math :answer/value "\\pm 5" :db/ensure [:answer/validate]} {:db/id "answer-c80c0be2-5eb8-5f9b-bcf9-872d44ce5073" :answer/id #uuid "c80c0be2-5eb8-5f9b-bcf9-872d44ce5073" :answer/type :answer.type/text :answer/value "$-9$ and $1$" :db/ensure [:answer/validate]} {:db/id "answer-046961d9-841f-51f7-ba46-6248fd584f28" :answer/id #uuid "046961d9-841f-51f7-ba46-6248fd584f28" :answer/type :answer.type/text :answer/value "$1$ only" :db/ensure [:answer/validate]} {:db/id "answer-dd046e4c-0a37-524b-be1d-418cb02c11ba" :answer/id #uuid "dd046e4c-0a37-524b-be1d-418cb02c11ba" :answer/type :answer.type/text :answer/value "$5$ only" :db/ensure [:answer/validate]} {:db/id "answer-12570bb9-131f-5544-adfe-03cf59187a89" :answer/id #uuid "12570bb9-131f-5544-adfe-03cf59187a89" :answer/type :answer.type/text :answer/value "There are no real solutions" :db/ensure [:answer/validate]} {:db/id "question-80133e3d-6a6e-531f-96e9-2c88946d7720" :question/id #uuid "80133e3d-6a6e-531f-96e9-2c88946d7720" :question/math-academy-id "q-91443" :question/problem "Find all of the real solutions to the equation $8(x+3)^{6}=512.$" :question/worked-solution "We can solve this equation by isolating the $(x+3)^{6}$ term and then taking the $6$th root of each side.\n\nFirst, let's isolate the $(x+3)^{6}$ term on the left-hand side:\n\n$$\n\\begin{aligned}8(x+3)^{6} & =512 \\\\ (x+3)^{6} & =64\\end{aligned}\n$$\n\nNow, we take the $6$th root of each side and solve for $x.$ Since the exponent $(6)$ is even, we consider both the positive and negative solutions:\n\n$$\n\\begin{aligned}(x+3)^{6} & =64 \\\\ \\sqrt[6]{(x+3)^{6}} & =\\pm \\sqrt[6]{64} \\\\ x+3 & =\\pm \\sqrt[6]{{2}^{6}} \\\\ x+3 & =\\pm 2 \\\\ x & =-3\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-1$ and $x=-5.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7e4f76af-0404-5cab-83e6-644ae34e1cdf"] :db/ensure [:question/validate]} {:db/id "answer-field-7e4f76af-0404-5cab-83e6-644ae34e1cdf" :answer-field/id #uuid "7e4f76af-0404-5cab-83e6-644ae34e1cdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-455d03c1-5919-5d7e-b1aa-81cabab616bb" :answer-field/choices ["answer-455d03c1-5919-5d7e-b1aa-81cabab616bb" "answer-f3987bc8-0469-592b-a842-c96c0962f6f3" "answer-9eb81f1d-9e84-581c-a6cc-af1d05970df8" "answer-867e2980-c6e6-52f9-86f1-c4e70fe4b20f" "answer-d8ab36c9-f58f-5bb6-be84-4b0f66dfa592"] :db/ensure [:answer-field/validate]} {:db/id "answer-455d03c1-5919-5d7e-b1aa-81cabab616bb" :answer/id #uuid "455d03c1-5919-5d7e-b1aa-81cabab616bb" :answer/type :answer.type/text :answer/value "$-1$ and $-5$" :db/ensure [:answer/validate]} {:db/id "answer-f3987bc8-0469-592b-a842-c96c0962f6f3" :answer/id #uuid "f3987bc8-0469-592b-a842-c96c0962f6f3" :answer/type :answer.type/text :answer/value "$-1$ and $7$" :db/ensure [:answer/validate]} {:db/id "answer-9eb81f1d-9e84-581c-a6cc-af1d05970df8" :answer/id #uuid "9eb81f1d-9e84-581c-a6cc-af1d05970df8" :answer/type :answer.type/text :answer/value "$1$ and $-5$" :db/ensure [:answer/validate]} {:db/id "answer-867e2980-c6e6-52f9-86f1-c4e70fe4b20f" :answer/id #uuid "867e2980-c6e6-52f9-86f1-c4e70fe4b20f" :answer/type :answer.type/text :answer/value "$1$ and $3$" :db/ensure [:answer/validate]} {:db/id "answer-d8ab36c9-f58f-5bb6-be84-4b0f66dfa592" :answer/id #uuid "d8ab36c9-f58f-5bb6-be84-4b0f66dfa592" :answer/type :answer.type/text :answer/value "$1$ and $5$" :db/ensure [:answer/validate]} {:db/id 17592186116534 :tutorial/content "How do we solve an equation with a variable raised to an even exponent, such as\n\n$$\nx^6 = 64?\n$$\n\nWe can solve this equation by taking the $6$th root of each side and solving for $x.$ \n\nSince the exponent $(6)$ is even, there will be two real solutions (positive and negative):\n\n$$\n\\begin{aligned}{x}^{6} & =64 \\\\ \\sqrt[6]{{x}^{6}} & =\\pm \\sqrt[6]{64} \\\\ x & =\\pm \\sqrt[6]{{2}^{6}} \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\pm 2.$\n\nIn general, we have the following rule of thumb:\n\n*When $n$ is even, and we take the $n$th root of both sides of $x^n = a$ with $a \\geq 0,$ we get two solutions (positive and negative):* \n\n$$\nx = \\pm\\sqrt[n]{a}\n$$\n\n**Watch out!** If $a<0$ and $n$ is even, equation  $x^n = a$ has no solution since, in this case, $x^n \\geq 0$ for any real $x.$" :db/ensure [:tutorial/validate]} {:db/id 17592186115421 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186115236 :knowledge-point/questions ["question-11aeb2f0-20f1-51d5-8c52-39a1558cd757"] :db/ensure [:knowledge-point/validate]} {:db/id "question-11aeb2f0-20f1-51d5-8c52-39a1558cd757" :question/id #uuid "11aeb2f0-20f1-51d5-8c52-39a1558cd757" :question/math-academy-id "q-47651" :question/problem "Which of the following completes the statement so that it is true:\n\n*If the lines $y-x=1$ and $x+ky=4$, where $k$ is a constant, intersect at exactly one point, then $\\text{__________}$ .*\n\nI. the lines $y-x=0$ and $x+ky=0$ don't intersect\n\nII. the lines $y-x=0$ and $x+ky=0$ intersect at infinitely many points\n\nIII. $det[\\begin{aligned}-1 & 1 \\\\ 1 & k\\end{aligned}]\\ne 0$" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNotice that if we set \n\n$$\nA=[\\begin{aligned}-1 & 1 \\\\ 1 & k\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\n  \n\nthen the fourth part of the theorem is true. Hence,  all the other parts of the theorem are true too. Therefore, according to the theorem, only option III give us a true statement: \n\n- *If the lines $y-x=1$ and $x+ky=4$, where $k$ is a constant, intersect at exactly one point, then $det[\\begin{aligned}-1 & 1 \\\\ 1 & k\\end{aligned}]\\ne 0$ .* $\\,✓$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-273b6a9c-3dfc-5014-9117-506724cb00ae"] :db/ensure [:question/validate]} {:db/id "answer-field-273b6a9c-3dfc-5014-9117-506724cb00ae" :answer-field/id #uuid "273b6a9c-3dfc-5014-9117-506724cb00ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3dac26d2-ebbe-5a1e-83fa-4b3b6d5b4e28" :answer-field/choices ["answer-939de576-f6fe-534e-bcc7-b91eb70d6b02" "answer-551b68dd-eb85-5e01-8e30-fd3cc7694f1d" "answer-efaad133-59c6-5b2b-9d22-976c341550bf" "answer-c357f7bd-3a09-51e9-abea-8dc1deeb12c8" "answer-3dac26d2-ebbe-5a1e-83fa-4b3b6d5b4e28"] :db/ensure [:answer-field/validate]} {:db/id "answer-939de576-f6fe-534e-bcc7-b91eb70d6b02" :answer/id #uuid "939de576-f6fe-534e-bcc7-b91eb70d6b02" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-551b68dd-eb85-5e01-8e30-fd3cc7694f1d" :answer/id #uuid "551b68dd-eb85-5e01-8e30-fd3cc7694f1d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-efaad133-59c6-5b2b-9d22-976c341550bf" :answer/id #uuid "efaad133-59c6-5b2b-9d22-976c341550bf" :answer/type :answer.type/text :answer/value "II  only" :db/ensure [:answer/validate]} {:db/id "answer-c357f7bd-3a09-51e9-abea-8dc1deeb12c8" :answer/id #uuid "c357f7bd-3a09-51e9-abea-8dc1deeb12c8" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-3dac26d2-ebbe-5a1e-83fa-4b3b6d5b4e28" :answer/id #uuid "3dac26d2-ebbe-5a1e-83fa-4b3b6d5b4e28" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-bf58cc30-c0d8-5d47-9482-24ba16b9e39f" :activity/id #uuid "bf58cc30-c0d8-5d47-9482-24ba16b9e39f" :activity/title "The Invertible Matrix Theorem in Terms of 2x2 Systems of Equations" :activity/type :activity.type/review :activity/scope 17592186050906 :activity/course 17592186046658 :activity/steps ["step-028bab25-3fed-5252-aa96-72f7de3058fa" "step-59b4b15c-df1d-52b3-a1d2-1425a0066736" "step-8ca0b9cc-1fcf-55ba-84e5-387e60cec625" "step-96da7574-bc62-58b8-af70-6d04a234aff0" "step-882122b9-54f2-5353-858e-8a741a0617ea"] :activity/first-step "step-028bab25-3fed-5252-aa96-72f7de3058fa" :db/ensure [:activity/validate]} {:db/id "step-028bab25-3fed-5252-aa96-72f7de3058fa" :step/id #uuid "028bab25-3fed-5252-aa96-72f7de3058fa" :step/content 17592186323750 :step/next "step-59b4b15c-df1d-52b3-a1d2-1425a0066736" :db/ensure [:step/validate]} {:db/id "step-59b4b15c-df1d-52b3-a1d2-1425a0066736" :step/id #uuid "59b4b15c-df1d-52b3-a1d2-1425a0066736" :step/content "question-11aeb2f0-20f1-51d5-8c52-39a1558cd757" :step/next "step-8ca0b9cc-1fcf-55ba-84e5-387e60cec625" :db/ensure [:step/validate]} {:db/id "step-8ca0b9cc-1fcf-55ba-84e5-387e60cec625" :step/id #uuid "8ca0b9cc-1fcf-55ba-84e5-387e60cec625" :step/content 17592186377668 :step/next "step-96da7574-bc62-58b8-af70-6d04a234aff0" :db/ensure [:step/validate]} {:db/id "step-96da7574-bc62-58b8-af70-6d04a234aff0" :step/id #uuid "96da7574-bc62-58b8-af70-6d04a234aff0" :step/content 17592186342017 :step/next "step-882122b9-54f2-5353-858e-8a741a0617ea" :db/ensure [:step/validate]} {:db/id "step-882122b9-54f2-5353-858e-8a741a0617ea" :step/id #uuid "882122b9-54f2-5353-858e-8a741a0617ea" :step/content 17592186400331 :db/ensure [:step/validate]} {:db/id 17592186162125 :knowledge-point/questions ["question-e9cd0722-c129-5c15-8f19-958d5be79276"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162415 :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(9,10)=0.65,\\,F(6,10)=0.31,\\,F(3,10)=0.12,\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{3,6,9,12\\},\\,{S}_{Y}=\\{2,4,6,8,10,12\\}.\n$$\n\nFind $P(3<X\\le 9,Y\\le 10).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{3,6,9,12\\}\\times \\{2,4,6,8,10,12\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support.\n\n![](images/77/7790a013e37bb86c00b44b1c022d6597f9bbdd57616c48e7ee7dfe8ddf512c63.png)\n\nLet's sketch the region corresponding to the probability we wish to find.\n\n![](images/37/379f0690fdbe92b7fb8f66cce4f12b214a23c6299fb8df71edf56d37fc0387fe.png)\n\nGeometrically, this region can be obtained by taking all points in the infinite rectangle that has its top-right corner at $(9,10)$ (the blue region below) and *subtracting* all points in the infinite rectangle that has its top-right corner at $(3,10)$ (the red region below).\n\n![](images/90/90a6730747b59a9886acbdf21880ca6a7ec3266142522ea5b32f07090963a98d.png)\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(3<X\\le 9,Y\\le 10) & =\\overset{\\text{top-right corner at }(9,10)}{\\overset{⏞}{P(X\\le 9,Y\\le 10)}}-\\overset{\\text{top-right corner at }(3,10)}{\\overset{⏞}{P(X\\le 3,Y\\le 10)}} \\\\  & =F(9,10)-F(3,10) \\\\  & =0.65-0.12 \\\\  & =0.53.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186159692 :answer-field/correct 17592186159694 :db/ensure [:answer-field/validate]} {:db/id 17592186162131 :knowledge-point/questions ["question-16e811ad-5456-5081-b6e1-700ad3de1eb9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186162421 :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(7,1)=\\frac{9}{16},\\,F(7,-2)=\\frac{1}{4},\\,F(3,1)=\\frac{1}{8},\\,F(3,-2)=\\frac{1}{16},\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{1,3,5,7,9\\},\\,{S}_{Y}=\\{-2,-1,0,1,2\\}.\n$$\n\nFind $P(5\\le X\\le 8,-1\\le Y\\le 1).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{1,3,5,7,9\\}\\times \\{-2,-1,0,1,2\\}.\n$$\n\nLet's plot the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support, and sketch the region corresponding to the probability we wish to find.\n\n![](images/9e/9ebff161899c6f61af3dffc1a5a0069de14bafd9b138293a945138e2951d066d.png)\n\nNotice that this region encompasses the same possible support points as the rectangular region with its top-right corner at $(7,1)$ and bottom-left corner at $(3,-2)$ below, where the top and right boundaries are inclusive and the bottom and left boundaries are exclusive.\n\n![](images/e2/e25278ed6d9712d8d2d2cabda5d1d0dbbf10aa8193f1342e7b4b66b26f9154e3.png)\n\nGeometrically, this region can be obtained as follows:\n\n1\\. Take the infinite rectangle that has its top-right corner at $(7,1).$\n\n2\\. Subtract the infinite rectangles that have their top-right corners at $(7,-2)$ and $(3,1).$\n\n3\\. Finally, we need to add back the infinite rectangle that has its top-right corner at $(3,-2).$ This is because we subtracted this region twice in step 2.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(5\\le X\\le 8,-1\\le Y\\le 1) & =\\overset{\\text{top-right corner at }(7,1)}{\\overset{⏞}{P(X\\le 7,Y\\le 1)}} \\\\  & \\,-\\overset{\\text{bottom-right corner at }(7,-2)}{\\overset{⏞}{P(X\\le 7,Y\\le -2)}}-\\overset{\\text{top-left corner at }(3,1)}{\\overset{⏞}{P(X\\le 3,Y\\le 1)}} \\\\  & \\,+\\overset{\\text{bottom-left corner at }(3,-2)}{\\overset{⏞}{P(X\\le 3,Y\\le -2)}} \\\\  & =F(7,1)-F(7,-2)-F(3,1)+F(3,-2) \\\\  & =\\frac{9}{16}-\\frac{1}{4}-\\frac{1}{8}+\\frac{1}{16} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186159728 :answer-field/correct 17592186159733 :db/ensure [:answer-field/validate]} {:db/id 17592186162130 :knowledge-point/questions ["question-fb06fe3b-f0e6-5f9b-9f03-e38285ba59c1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fb06fe3b-f0e6-5f9b-9f03-e38285ba59c1" :question/id #uuid "fb06fe3b-f0e6-5f9b-9f03-e38285ba59c1" :question/math-academy-id "q-146415" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{-1,0,1\\},\\,{S}_{Y}=\\{1,2,3\\}.\n$$\n\nFind an expression for the corresponding joint CDF when $x<-1,y>2.$" :question/worked-solution "If $X$ and $Y$ are discrete random variables with the joint probability mass function $f(x,y),$ then the corresponding joint CDF is given by\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)={\\sum }_{{x}_{i}\\le x}{\\sum }_{{y}_{i}\\le y}f({x}_{i},{y}_{i}).\n$$\n\nNote the following:\n\n- We can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{-1,0,1\\}\\times \\{1,2,3\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support. Let's also consider a point $(x,y)$ where $x<-1$ and $y>2,$ and a region $Δ$ that lies below and to the left of this point.\n\n![](images/41/41e8a9d9ec73c9c10a73c4dcd8a8fe9051401d6ab31c8274fdf8f22adb2437da.png)\n\nSince every value in the support of $X$ is at least $-1$ and $x<-1,$ no possible value of $X$ satisfies $X\\le x.$ Therefore, there are no points in the joint support that lie in the region $Δ.$\n\nHence,\n\n$$\nF(x,y)=P(X\\le x,Y\\le y)=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-473ef6d8-60c9-5504-8ce5-d78f894c72f3"] :db/ensure [:question/validate]} {:db/id "answer-field-473ef6d8-60c9-5504-8ce5-d78f894c72f3" :answer-field/id #uuid "473ef6d8-60c9-5504-8ce5-d78f894c72f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c50b7eba-5426-53e7-a693-b3a4082cd5dc" :answer-field/choices ["answer-c50b7eba-5426-53e7-a693-b3a4082cd5dc" "answer-8a615a1e-0c9e-52a7-9428-2729a456062a" "answer-dc5a4b19-57de-5fe5-bab6-461309d9b799" "answer-54feaaa8-dd22-5ec0-9f20-e02541fd09ca" "answer-a9eb4b4d-0d8f-5334-bdd7-099229f155e8"] :db/ensure [:answer-field/validate]} {:db/id "answer-c50b7eba-5426-53e7-a693-b3a4082cd5dc" :answer/id #uuid "c50b7eba-5426-53e7-a693-b3a4082cd5dc" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-8a615a1e-0c9e-52a7-9428-2729a456062a" :answer/id #uuid "8a615a1e-0c9e-52a7-9428-2729a456062a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-dc5a4b19-57de-5fe5-bab6-461309d9b799" :answer/id #uuid "dc5a4b19-57de-5fe5-bab6-461309d9b799" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-54feaaa8-dd22-5ec0-9f20-e02541fd09ca" :answer/id #uuid "54feaaa8-dd22-5ec0-9f20-e02541fd09ca" :answer/type :answer.type/math :answer/value "\\frac{2}{y}" :db/ensure [:answer/validate]} {:db/id "answer-a9eb4b4d-0d8f-5334-bdd7-099229f155e8" :answer/id #uuid "a9eb4b4d-0d8f-5334-bdd7-099229f155e8" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "question-e9cd0722-c129-5c15-8f19-958d5be79276" :question/id #uuid "e9cd0722-c129-5c15-8f19-958d5be79276" :question/math-academy-id "q-146618" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(9,10)=0.8,\\,F(9,4)=0.3,\\,F(6,10)=0.4,\\,F(6,4)=0.2,\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{3,6,9,12\\},\\,{S}_{Y}=\\{2,4,6,8,10,12\\}.\n$$\n\nFind $P(6<X\\le 9,4<Y\\le 10).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{3,6,9,12\\}\\times \\{2,4,6,8,10,12\\}.\n$$\n\nLet's sketch the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support.\n\n![](images/77/7790a013e37bb86c00b44b1c022d6597f9bbdd57616c48e7ee7dfe8ddf512c63.png)\n\nLet's sketch the region corresponding to the probability we wish to find.\n\n![](images/65/6535c5bf152e8a9b09bf5522cdc442668add6c4cc7a0df4e07307f9931886a80.png)\n\nGeometrically, this region can be obtained as follows:\n\n1\\. Take the infinite rectangle that has its top-right corner at $(9,10).$\n\n2\\. Subtract the infinite rectangles that have their top-right corners at $(9,4)$ and $(6,10).$\n\n3\\. Finally, we need to add back the infinite rectangle that has its top-right corner at $(6,4).$ This is because we subtracted this region twice in step 2.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(6<X\\le 9,4<Y\\le 10) & =\\overset{\\text{top-right corner at }(9,10)}{\\overset{⏞}{P(X\\le 9,Y\\le 10)}} \\\\  & \\,-\\overset{\\text{top-right corner at }(9,4)}{\\overset{⏞}{P(X\\le 9,Y\\le 4)}}-\\overset{\\text{top-right corner at }(6,10)}{\\overset{⏞}{P(X\\le 6,Y\\le 10)}} \\\\  & \\,+\\overset{\\text{top-right corner at }(6,4)}{\\overset{⏞}{P(X\\le 6,Y\\le 4)}} \\\\  & =F(9,10)-F(9,4)-F(6,10)+F(6,4) \\\\  & =0.8-0.3-0.4+0.2 \\\\  & =0.3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f1436435-7d0e-595c-99fd-60d4245df591"] :db/ensure [:question/validate]} {:db/id "answer-field-f1436435-7d0e-595c-99fd-60d4245df591" :answer-field/id #uuid "f1436435-7d0e-595c-99fd-60d4245df591" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5226bb01-1d74-50d5-ae38-837109e0e401" :answer-field/choices ["answer-52c9b21a-4477-5890-bc16-7ba55dac052a" "answer-5226bb01-1d74-50d5-ae38-837109e0e401" "answer-213c512b-4d83-52c6-aea3-4aa799b73e2a" "answer-6ad4d637-0bcc-57fd-a92b-74aa8cebd839" "answer-67f944a8-f948-5604-bc8c-ae5256daf681"] :db/ensure [:answer-field/validate]} {:db/id "answer-52c9b21a-4477-5890-bc16-7ba55dac052a" :answer/id #uuid "52c9b21a-4477-5890-bc16-7ba55dac052a" :answer/type :answer.type/math :answer/value "0.2" :db/ensure [:answer/validate]} {:db/id "answer-5226bb01-1d74-50d5-ae38-837109e0e401" :answer/id #uuid "5226bb01-1d74-50d5-ae38-837109e0e401" :answer/type :answer.type/math :answer/value "0.3" :db/ensure [:answer/validate]} {:db/id "answer-213c512b-4d83-52c6-aea3-4aa799b73e2a" :answer/id #uuid "213c512b-4d83-52c6-aea3-4aa799b73e2a" :answer/type :answer.type/math :answer/value "0.4" :db/ensure [:answer/validate]} {:db/id "answer-6ad4d637-0bcc-57fd-a92b-74aa8cebd839" :answer/id #uuid "6ad4d637-0bcc-57fd-a92b-74aa8cebd839" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "answer-67f944a8-f948-5604-bc8c-ae5256daf681" :answer/id #uuid "67f944a8-f948-5604-bc8c-ae5256daf681" :answer/type :answer.type/math :answer/value "0.8" :db/ensure [:answer/validate]} {:db/id "question-16e811ad-5456-5081-b6e1-700ad3de1eb9" :question/id #uuid "16e811ad-5456-5081-b6e1-700ad3de1eb9" :question/math-academy-id "q-146850" :question/problem "Suppose $X$ and $Y$ are discrete random variables. Let the joint CDF of $X$ and $Y$ be $F(x,y),$ where\n\n$$\nF(4,1)=0.8,\\,F(4,-1)=0.2,\\,F(2,1)=0.3,\\,F(2,-1)=0.1,\n$$\n\nand the supports of $X$ and $Y$, respectively, are\n\n$$\n{S}_{X}=\\{1,2,3,4,5\\},\\,{S}_{Y}=\\{-2,-1,0,1,2\\}.\n$$\n\nFind $P(3\\le X<5,0\\le Y<2).$" :question/worked-solution "Note the following:\n\n- For a given joint PMF $f(x,y),$ we can think of each point where $f(x,y)\\ne 0$ as a point mass in the plane, where the \"probability mass\" at each point equals the probability associated with that point.\n\n- The joint CDF $F(x,y)=P(X\\le x,Y\\le y)$ is the total \"probability mass\" that lies in the infinite rectangular region that has its top-right corner at $(x,y)$ and whose sides are parallel to the coordinate axis.\n\nGiven the supports of $X$ and $Y,$ the joint support $S$ is a subset of\n\n$$\n{S}_{X}\\times {S}_{Y}=\\{1,2,3,4,5\\}\\times \\{-2,-1,0,1,2\\}.\n$$\n\nLet's plot the points in ${S}_{X}\\times {S}_{Y},$ which contains the joint support, and sketch the region corresponding to the probability we wish to find.\n\n![](images/62/6287f4884b335466bc7e1d6da17190f32d447f065e37a37e79a1aa48a6109415.png)\n\nNotice that this region encompasses the same possible support points as the rectangular region with its top-right corner at $(4,1)$ and bottom-left corner at $(2,-1)$ below, where the top and right boundaries are inclusive and the bottom and left boundaries are exclusive.\n\n![](images/d4/d4d76ca2e80bccda9cbcfa4e28c628dffcec62b3fb42d62f9315fce2623e12fe.png)\n\nGeometrically, this region can be obtained as follows:\n\n1\\. Take the infinite rectangle that has its top-right corner at $(4,1).$\n\n2\\. Subtract the infinite rectangles that have their top-right corners at $(4,-1)$ and $(2,1).$\n\n3\\. Finally, we need to add back the infinite rectangle that has its top-right corner at $(2,-1).$ This is because we subtracted this region twice in step 2.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1\\le X<4,-1\\le Y<1) & =\\overset{\\text{top-right corner at }(4,1)}{\\overset{⏞}{P(X\\le 4,Y\\le 1)}} \\\\  & \\,-\\overset{\\text{top-right corner at }(4,-1)}{\\overset{⏞}{P(X\\le 4,Y\\le -1)}}-\\overset{\\text{top-right corner at }(2,1)}{\\overset{⏞}{P(X\\le 2,Y\\le 1)}} \\\\  & \\,+\\overset{\\text{top-right corner at }(2,-1)}{\\overset{⏞}{P(X\\le 2,Y\\le -1)}} \\\\  & =F(4,1)-F(4,-1)-F(2,1)+F(2,-1) \\\\  & =0.8-0.2-0.3+0.1 \\\\  & =0.4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c8f6e27d-ab4f-5fa8-b770-f3c479ac71cc"] :db/ensure [:question/validate]} {:db/id "answer-field-c8f6e27d-ab4f-5fa8-b770-f3c479ac71cc" :answer-field/id #uuid "c8f6e27d-ab4f-5fa8-b770-f3c479ac71cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b5fa6b80-a26f-5238-b751-494b1bf5de75" :answer-field/choices ["answer-3ee2c542-f613-5ede-8ccb-305ddcfbc168" "answer-d3c04b39-0608-5124-9679-01b2add1f439" "answer-b53d2705-bd93-5c90-aa2b-ac6668486ee3" "answer-b5fa6b80-a26f-5238-b751-494b1bf5de75" "answer-5595a205-6820-5fcd-b0d1-66910f4baf36"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ee2c542-f613-5ede-8ccb-305ddcfbc168" :answer/id #uuid "3ee2c542-f613-5ede-8ccb-305ddcfbc168" :answer/type :answer.type/math :answer/value "0.1" :db/ensure [:answer/validate]} {:db/id "answer-d3c04b39-0608-5124-9679-01b2add1f439" :answer/id #uuid "d3c04b39-0608-5124-9679-01b2add1f439" :answer/type :answer.type/math :answer/value "0.2" :db/ensure [:answer/validate]} {:db/id "answer-b53d2705-bd93-5c90-aa2b-ac6668486ee3" :answer/id #uuid "b53d2705-bd93-5c90-aa2b-ac6668486ee3" :answer/type :answer.type/math :answer/value "0.3" :db/ensure [:answer/validate]} {:db/id "answer-b5fa6b80-a26f-5238-b751-494b1bf5de75" :answer/id #uuid "b5fa6b80-a26f-5238-b751-494b1bf5de75" :answer/type :answer.type/math :answer/value "0.4" :db/ensure [:answer/validate]} {:db/id "answer-5595a205-6820-5fcd-b0d1-66910f4baf36" :answer/id #uuid "5595a205-6820-5fcd-b0d1-66910f4baf36" :answer/type :answer.type/math :answer/value "0.8" :db/ensure [:answer/validate]} {:db/id "activity-8dcc3cb1-af1f-5fd5-a39e-26295bdafc56" :activity/id #uuid "8dcc3cb1-af1f-5fd5-a39e-26295bdafc56" :activity/title "The Joint CDF of Two Discrete Random Variables" :activity/type :activity.type/review :activity/scope 17592186050971 :activity/course 17592186046659 :activity/steps ["step-899d50e9-e351-5b30-86ee-501f13c58952" "step-8838afa5-73ed-52cd-9c3d-38413c09ae41" "step-3c9389f8-aafc-528d-9a81-dbc2216f32cd" "step-2f96dcd0-a5cb-5224-89fd-80e1b854634b" "step-9c8530ec-4ccc-55e4-81ee-29272379bcc6"] :activity/first-step "step-899d50e9-e351-5b30-86ee-501f13c58952" :db/ensure [:activity/validate]} {:db/id "step-899d50e9-e351-5b30-86ee-501f13c58952" :step/id #uuid "899d50e9-e351-5b30-86ee-501f13c58952" :step/content 17592186162415 :step/next "step-8838afa5-73ed-52cd-9c3d-38413c09ae41" :db/ensure [:step/validate]} {:db/id "step-8838afa5-73ed-52cd-9c3d-38413c09ae41" :step/id #uuid "8838afa5-73ed-52cd-9c3d-38413c09ae41" :step/content 17592186162421 :step/next "step-3c9389f8-aafc-528d-9a81-dbc2216f32cd" :db/ensure [:step/validate]} {:db/id "step-3c9389f8-aafc-528d-9a81-dbc2216f32cd" :step/id #uuid "3c9389f8-aafc-528d-9a81-dbc2216f32cd" :step/content "question-fb06fe3b-f0e6-5f9b-9f03-e38285ba59c1" :step/next "step-2f96dcd0-a5cb-5224-89fd-80e1b854634b" :db/ensure [:step/validate]} {:db/id "step-2f96dcd0-a5cb-5224-89fd-80e1b854634b" :step/id #uuid "2f96dcd0-a5cb-5224-89fd-80e1b854634b" :step/content "question-e9cd0722-c129-5c15-8f19-958d5be79276" :step/next "step-9c8530ec-4ccc-55e4-81ee-29272379bcc6" :db/ensure [:step/validate]} {:db/id "step-9c8530ec-4ccc-55e4-81ee-29272379bcc6" :step/id #uuid "9c8530ec-4ccc-55e4-81ee-29272379bcc6" :step/content "question-16e811ad-5456-5081-b6e1-700ad3de1eb9" :db/ensure [:step/validate]} {:db/id 17592186105705 :knowledge-point/questions ["question-6053c699-eed7-5f85-aa40-b59fc9957b5c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6053c699-eed7-5f85-aa40-b59fc9957b5c" :question/id #uuid "6053c699-eed7-5f85-aa40-b59fc9957b5c" :question/math-academy-id "q-68973" :question/problem "$\\frac{3}{5\\sqrt{3}}=$" :question/worked-solution "To remove the radical $\\sqrt{3}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{3}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{3}{5\\sqrt{3}} & = \\\\ \\frac{3}{5\\sqrt{3}}\\cdot \\frac{\\sqrt{3}}{\\sqrt{3}} & = \\\\ \\frac{3\\sqrt{3}}{5\\cdot (\\sqrt{3})^{2}} & = \\\\ \\frac{3\\sqrt{3}}{5\\cdot 3} & = \\\\ \\frac{\\sqrt{3}}{5} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8e4335f4-0a43-52eb-920e-e7c8066542cb"] :db/ensure [:question/validate]} {:db/id "answer-field-8e4335f4-0a43-52eb-920e-e7c8066542cb" :answer-field/id #uuid "8e4335f4-0a43-52eb-920e-e7c8066542cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer-field/choices ["answer-eafd7840-0948-5dc2-99ff-617d14233294" "answer-9541ae86-02b9-5a82-a43c-89a200374f23" "answer-08ba6809-48d6-572e-a887-ee445eb17ac5" "answer-e294048f-eaaa-5e29-aeaf-312c92a62877" "answer-e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-eafd7840-0948-5dc2-99ff-617d14233294" :answer/id #uuid "eafd7840-0948-5dc2-99ff-617d14233294" :answer/type :answer.type/math :answer/value "3\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-9541ae86-02b9-5a82-a43c-89a200374f23" :answer/id #uuid "9541ae86-02b9-5a82-a43c-89a200374f23" :answer/type :answer.type/math :answer/value "5\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-08ba6809-48d6-572e-a887-ee445eb17ac5" :answer/id #uuid "08ba6809-48d6-572e-a887-ee445eb17ac5" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e294048f-eaaa-5e29-aeaf-312c92a62877" :answer/id #uuid "e294048f-eaaa-5e29-aeaf-312c92a62877" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{15}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer/id #uuid "e1e2d6be-e1f7-5b7f-b3e5-50ad0be9ac8e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id 17592186105706 :knowledge-point/questions ["question-ae109d24-9fc2-5d5a-8052-a06c5bb12363" "question-0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ae109d24-9fc2-5d5a-8052-a06c5bb12363" :question/id #uuid "ae109d24-9fc2-5d5a-8052-a06c5bb12363" :question/math-academy-id "q-68978" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{7}}=$" :question/worked-solution "To remove the radical $\\sqrt{7}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{7}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{7}}\\cdot \\frac{\\sqrt{7}}{\\sqrt{7}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{(\\sqrt{7})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{7}}{7} & = \\\\ \\frac{\\sqrt{3\\cdot 7}}{7} & = \\\\ \\frac{\\sqrt{21}}{7} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a3bf9e83-273c-5b34-b405-581696dd025a"] :db/ensure [:question/validate]} {:db/id "answer-field-a3bf9e83-273c-5b34-b405-581696dd025a" :answer-field/id #uuid "a3bf9e83-273c-5b34-b405-581696dd025a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f7a6999-f8f4-59e0-98e0-015a493f1d2f" :answer-field/choices ["answer-c52da2ef-45c8-5cc1-8d40-dcc039628f7c" "answer-89a01196-ecc5-54e7-97a0-a62b76df60ac" "answer-6f7a6999-f8f4-59e0-98e0-015a493f1d2f" "answer-9af2d328-e266-562e-9983-62f0ac8950e5" "answer-e2e5fe20-ac58-5d90-b58b-91cc21887122"] :db/ensure [:answer-field/validate]} {:db/id "answer-c52da2ef-45c8-5cc1-8d40-dcc039628f7c" :answer/id #uuid "c52da2ef-45c8-5cc1-8d40-dcc039628f7c" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{7}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-89a01196-ecc5-54e7-97a0-a62b76df60ac" :answer/id #uuid "89a01196-ecc5-54e7-97a0-a62b76df60ac" :answer/type :answer.type/math :answer/value "\\frac{9\\sqrt{7}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-6f7a6999-f8f4-59e0-98e0-015a493f1d2f" :answer/id #uuid "6f7a6999-f8f4-59e0-98e0-015a493f1d2f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{21}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-9af2d328-e266-562e-9983-62f0ac8950e5" :answer/id #uuid "9af2d328-e266-562e-9983-62f0ac8950e5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{63}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-e2e5fe20-ac58-5d90-b58b-91cc21887122" :answer/id #uuid "e2e5fe20-ac58-5d90-b58b-91cc21887122" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}}{21}" :db/ensure [:answer/validate]} {:db/id "question-0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3" :question/id #uuid "0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3" :question/math-academy-id "q-68979" :question/problem "$\\frac{\\sqrt{3}}{\\sqrt{5}}=$" :question/worked-solution "To remove the radical $\\sqrt{5}$ from the denominator, all we need to do is multiply both the numerator and denominator by $\\sqrt{5}$ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}}{\\sqrt{5}} & = \\\\ \\frac{\\sqrt{3}}{\\sqrt{5}}\\cdot \\frac{\\sqrt{5}}{\\sqrt{5}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{(\\sqrt{5})^{2}} & = \\\\ \\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} & \\end{aligned}\n$$\n\nNow, we use the product rule to simplify the numerator:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{3}\\cdot \\sqrt{5}}{5} & = \\\\ \\frac{\\sqrt{3\\cdot 5}}{5} & = \\\\ \\frac{\\sqrt{15}}{5} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a8d63188-077b-53b4-bf34-059f17e831ae"] :db/ensure [:question/validate]} {:db/id "answer-field-a8d63188-077b-53b4-bf34-059f17e831ae" :answer-field/id #uuid "a8d63188-077b-53b4-bf34-059f17e831ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer-field/choices ["answer-8b1b5fba-fdd8-5128-9a27-cbfb26a9e1c4" "answer-a519e98f-6574-52d8-8a8c-870b9a1a0093" "answer-e7a916dc-cd3b-563d-8a31-4a98472fc173" "answer-e7d7cf72-8c4a-588a-92d9-55fa1de43c10" "answer-aabd3a95-2d4e-5129-96fc-6ea2f3661cd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b1b5fba-fdd8-5128-9a27-cbfb26a9e1c4" :answer/id #uuid "8b1b5fba-fdd8-5128-9a27-cbfb26a9e1c4" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer/id #uuid "a519e98f-6574-52d8-8a8c-870b9a1a0093" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{15}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e7a916dc-cd3b-563d-8a31-4a98472fc173" :answer/id #uuid "e7a916dc-cd3b-563d-8a31-4a98472fc173" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{30}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-e7d7cf72-8c4a-588a-92d9-55fa1de43c10" :answer/id #uuid "e7d7cf72-8c4a-588a-92d9-55fa1de43c10" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-aabd3a95-2d4e-5129-96fc-6ea2f3661cd0" :answer/id #uuid "aabd3a95-2d4e-5129-96fc-6ea2f3661cd0" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{15}" :db/ensure [:answer/validate]} {:db/id "activity-28e4707c-4172-5804-bb5b-31ce59766c25" :activity/id #uuid "28e4707c-4172-5804-bb5b-31ce59766c25" :activity/title "Rationalizing Denominators" :activity/type :activity.type/review :activity/scope 17592186048702 :activity/course 17592186046648 :activity/steps ["step-707ae3ed-9b4d-5300-a0d5-6ced1c7337f1" "step-052fe2c5-40e8-568d-a7e6-4596a024895e" "step-61942193-2d0a-56bf-a25c-0114eb566388"] :activity/first-step "step-707ae3ed-9b4d-5300-a0d5-6ced1c7337f1" :db/ensure [:activity/validate]} {:db/id "step-707ae3ed-9b4d-5300-a0d5-6ced1c7337f1" :step/id #uuid "707ae3ed-9b4d-5300-a0d5-6ced1c7337f1" :step/content "question-6053c699-eed7-5f85-aa40-b59fc9957b5c" :step/next "step-052fe2c5-40e8-568d-a7e6-4596a024895e" :db/ensure [:step/validate]} {:db/id "step-052fe2c5-40e8-568d-a7e6-4596a024895e" :step/id #uuid "052fe2c5-40e8-568d-a7e6-4596a024895e" :step/content "question-ae109d24-9fc2-5d5a-8052-a06c5bb12363" :step/next "step-61942193-2d0a-56bf-a25c-0114eb566388" :db/ensure [:step/validate]} {:db/id "step-61942193-2d0a-56bf-a25c-0114eb566388" :step/id #uuid "61942193-2d0a-56bf-a25c-0114eb566388" :step/content "question-0166b33d-cd65-51f2-b6e7-3a4bfb8c5ea3" :db/ensure [:step/validate]} {:db/id 17592186064349 :knowledge-point/questions ["question-131ccfe9-849e-53c3-a3f1-91aed4a65240" "question-42436934-3a89-50ee-8455-624cf79683ae"] :db/ensure [:knowledge-point/validate]} {:db/id "question-131ccfe9-849e-53c3-a3f1-91aed4a65240" :question/id #uuid "131ccfe9-849e-53c3-a3f1-91aed4a65240" :question/math-academy-id "q-22237" :question/problem "If $b-5c=c-4b,$ then $b=$" :question/worked-solution "We need to isolate the variable $b.$ To do this, we treat $c$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $4b$ to both sides of the equation:\n\n$$\n\\begin{aligned}b-5c & =c-4b \\\\ b-5c+4b & =c-4b+4b \\\\ b+4b-5c & =c-4b+4b \\\\ 5b-5c & =c\\end{aligned}\n$$\n\nThen, we add $5c$ to both sides of the equation:\n\n$$\n\\begin{aligned}5b-5c & =c \\\\ 5b-5c+5c & =c+5c \\\\ 5b & =6c\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $5:$\n\n$$\n\\begin{aligned}5b & =6c \\\\ \\frac{5b}{5} & =\\frac{6c}{5} \\\\ \\frac{\\cancel{5}b}{\\cancel{5}} & =\\frac{6c}{5} \\\\ b & =\\frac{6c}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ce86109f-c522-5257-a1af-0a30eb61a2af"] :db/ensure [:question/validate]} {:db/id "answer-field-ce86109f-c522-5257-a1af-0a30eb61a2af" :answer-field/id #uuid "ce86109f-c522-5257-a1af-0a30eb61a2af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-30bc4eb9-206e-5878-a8f0-6d3c2752521a" :answer-field/choices ["answer-84cad270-ffb9-54b7-ab0b-714c6f9ff0a8" "answer-afd965a8-0cc0-5acc-b8a9-26911d6de0b9" "answer-3b0f64e1-9ba9-5de5-968c-21a2b8c1abe8" "answer-30bc4eb9-206e-5878-a8f0-6d3c2752521a" "answer-77627a96-f8aa-5bce-bdbe-ab14bc8f3202"] :db/ensure [:answer-field/validate]} {:db/id "answer-84cad270-ffb9-54b7-ab0b-714c6f9ff0a8" :answer/id #uuid "84cad270-ffb9-54b7-ab0b-714c6f9ff0a8" :answer/type :answer.type/math :answer/value "\\frac{2c}{5}" :db/ensure [:answer/validate]} {:db/id "answer-afd965a8-0cc0-5acc-b8a9-26911d6de0b9" :answer/id #uuid "afd965a8-0cc0-5acc-b8a9-26911d6de0b9" :answer/type :answer.type/math :answer/value "\\frac{3c}{5}" :db/ensure [:answer/validate]} {:db/id "answer-3b0f64e1-9ba9-5de5-968c-21a2b8c1abe8" :answer/id #uuid "3b0f64e1-9ba9-5de5-968c-21a2b8c1abe8" :answer/type :answer.type/math :answer/value "\\frac{4c}{5}" :db/ensure [:answer/validate]} {:db/id "answer-30bc4eb9-206e-5878-a8f0-6d3c2752521a" :answer/id #uuid "30bc4eb9-206e-5878-a8f0-6d3c2752521a" :answer/type :answer.type/math :answer/value "\\frac{6c}{5}" :db/ensure [:answer/validate]} {:db/id "answer-77627a96-f8aa-5bce-bdbe-ab14bc8f3202" :answer/id #uuid "77627a96-f8aa-5bce-bdbe-ab14bc8f3202" :answer/type :answer.type/math :answer/value "\\frac{7c}{5}" :db/ensure [:answer/validate]} {:db/id 17592186064348 :knowledge-point/questions ["question-041420d0-7112-5aa8-8e70-44b04f8459e6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-041420d0-7112-5aa8-8e70-44b04f8459e6" :question/id #uuid "041420d0-7112-5aa8-8e70-44b04f8459e6" :question/math-academy-id "q-135011" :question/problem "If $\\frac{z}{3}-2y=1$ then $z=$" :question/worked-solution "We need to isolate the variable $z.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $2y$ to both sides of the equation:\n\n$$\n\\begin{aligned}\\frac{z}{3}-2y & =1 \\\\ \\frac{z}{3}-2y+2y & =1+2y \\\\ \\frac{z}{3} & =1+2y\\end{aligned}\n$$\n\nThen, we multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}\\frac{z}{3} & =1+2y \\\\ 3\\cdot \\frac{z}{3} & =3\\cdot (1+2y) \\\\ \\cancel{3}\\cdot \\frac{z}{\\cancel{3}} & =3\\cdot (1+2y) \\\\ z & =3\\cdot (1+2y) \\\\ z & =3\\cdot 1+3\\cdot 2y \\\\ z & =3+6y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b4aba618-e4e2-5bd3-9df6-670dd46cecef"] :db/ensure [:question/validate]} {:db/id "answer-field-b4aba618-e4e2-5bd3-9df6-670dd46cecef" :answer-field/id #uuid "b4aba618-e4e2-5bd3-9df6-670dd46cecef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-15ea45d4-5b0c-536f-977e-e4f7ad0b6a37" :answer-field/choices ["answer-15ea45d4-5b0c-536f-977e-e4f7ad0b6a37" "answer-f0e2634c-f79a-5536-b6e7-b72d016dd451" "answer-cabe9447-7e18-5fc2-b800-d12efc44ec31" "answer-01b21b33-50e5-5cbe-9b22-24f73902555e" "answer-eb9cf60f-e518-550d-b474-33adf1d185b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-15ea45d4-5b0c-536f-977e-e4f7ad0b6a37" :answer/id #uuid "15ea45d4-5b0c-536f-977e-e4f7ad0b6a37" :answer/type :answer.type/math :answer/value "3+6y" :db/ensure [:answer/validate]} {:db/id "answer-f0e2634c-f79a-5536-b6e7-b72d016dd451" :answer/id #uuid "f0e2634c-f79a-5536-b6e7-b72d016dd451" :answer/type :answer.type/math :answer/value "3-2y" :db/ensure [:answer/validate]} {:db/id "answer-cabe9447-7e18-5fc2-b800-d12efc44ec31" :answer/id #uuid "cabe9447-7e18-5fc2-b800-d12efc44ec31" :answer/type :answer.type/math :answer/value "3-6y" :db/ensure [:answer/validate]} {:db/id "answer-01b21b33-50e5-5cbe-9b22-24f73902555e" :answer/id #uuid "01b21b33-50e5-5cbe-9b22-24f73902555e" :answer/type :answer.type/math :answer/value "\\frac{1+2y}{3}" :db/ensure [:answer/validate]} {:db/id "answer-eb9cf60f-e518-550d-b474-33adf1d185b2" :answer/id #uuid "eb9cf60f-e518-550d-b474-33adf1d185b2" :answer/type :answer.type/math :answer/value "\\frac{2y-1}{3}" :db/ensure [:answer/validate]} {:db/id "question-42436934-3a89-50ee-8455-624cf79683ae" :question/id #uuid "42436934-3a89-50ee-8455-624cf79683ae" :question/math-academy-id "q-176587" :question/problem "Given that $2x-y=y-x,$ express $x$ in terms of $y.$\n\n$x=$\n{{field-1}}" :question/worked-solution "We need to isolate the variable $x.$ To do this, we treat $y$ as though it were a constant and apply the addition and multiplication principles as usual.\n\nFirst, we add $y$ to both sides of the equation:\n\n$$\n\\begin{aligned}2x-y & =y-x \\\\ 2x-y+y & =y-x+y \\\\ 2x & =-x+2y\\end{aligned}\n$$\n\nThen, we add $x$ to both sides of the equation:\n\n$$\n\\begin{aligned}2x & =-x+2y \\\\ 2x+x & =-x+2y+x \\\\ 3x & =2y\\end{aligned}\n$$\n\nFinally, we divide both sides of the equation by $3:$\n\n$$\n\\begin{aligned}3x & =2y \\\\ \\frac{3x}{3} & =\\frac{2y}{3} \\\\ \\frac{\\cancel{3}x}{\\cancel{3}} & =\\frac{2y}{3} \\\\ x & =\\frac{2y}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c06f8f1f-3ac5-52a2-ba1c-01d871adb3a0"] :db/ensure [:question/validate]} {:db/id "answer-field-c06f8f1f-3ac5-52a2-ba1c-01d871adb3a0" :answer-field/id #uuid "c06f8f1f-3ac5-52a2-ba1c-01d871adb3a0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-57e54aa5-0ae5-5529-8641-8aded4a5dfa9" :answer-field/choices ["answer-57e54aa5-0ae5-5529-8641-8aded4a5dfa9"] :db/ensure [:answer-field/validate]} {:db/id "answer-57e54aa5-0ae5-5529-8641-8aded4a5dfa9" :answer/id #uuid "57e54aa5-0ae5-5529-8641-8aded4a5dfa9" :answer/type :answer.type/math :answer/value "\\frac{2y}{3}" :db/ensure [:answer/validate]} {:db/id "activity-c1215756-a0c0-5b05-bb70-32ae79c955b4" :activity/id #uuid "c1215756-a0c0-5b05-bb70-32ae79c955b4" :activity/title "Solving Two-Variable Equations" :activity/type :activity.type/review :activity/scope 17592186050622 :activity/course 17592186046648 :activity/steps ["step-c76c91ea-1fa5-50f4-8d7c-4155dbbf366c" "step-dc32766e-e6b6-52c0-84bc-2ef3316dead6" "step-f6f165f3-2e0f-519e-8f2f-88ed8efb2170"] :activity/first-step "step-c76c91ea-1fa5-50f4-8d7c-4155dbbf366c" :db/ensure [:activity/validate]} {:db/id "step-c76c91ea-1fa5-50f4-8d7c-4155dbbf366c" :step/id #uuid "c76c91ea-1fa5-50f4-8d7c-4155dbbf366c" :step/content "question-131ccfe9-849e-53c3-a3f1-91aed4a65240" :step/next "step-dc32766e-e6b6-52c0-84bc-2ef3316dead6" :db/ensure [:step/validate]} {:db/id "step-dc32766e-e6b6-52c0-84bc-2ef3316dead6" :step/id #uuid "dc32766e-e6b6-52c0-84bc-2ef3316dead6" :step/content "question-041420d0-7112-5aa8-8e70-44b04f8459e6" :step/next "step-f6f165f3-2e0f-519e-8f2f-88ed8efb2170" :db/ensure [:step/validate]} {:db/id "step-f6f165f3-2e0f-519e-8f2f-88ed8efb2170" :step/id #uuid "f6f165f3-2e0f-519e-8f2f-88ed8efb2170" :step/content "question-42436934-3a89-50ee-8455-624cf79683ae" :db/ensure [:step/validate]} {:db/id 17592186096706 :knowledge-point/questions ["question-67e144f2-2a3f-5e5b-9938-978ba91cf547" "question-da7d6a02-447c-52f1-87f8-add9a2f9923e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-67e144f2-2a3f-5e5b-9938-978ba91cf547" :question/id #uuid "67e144f2-2a3f-5e5b-9938-978ba91cf547" :question/math-academy-id "q-14160" :question/problem "![](images/2a/2a195992bbda673f38856ee5b5ea6f0f14f6cf1303df200d0125e29f365a51e3.png)\n\nWhat is the $x$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(1,-2)$ and passes through the point $(5,2).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(1,-2)$ into the above gives\n\n$$\n(y+2)^{2}=4p(x-1).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(5,2),$ we substitute $x=5$ and $y=2$ into the equation and get\n\n$$\n\\begin{aligned}(2+2)^{2} & =4p(5-1) \\\\ 16 & =4p(4) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+2)^{2} & =4(x-1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola  and solve for $x:$\n\n$$\n\\begin{aligned}(0+2)^{2} & =4(x-1) \\\\ 4 & =4(x-1) \\\\ 1 & =x-1 \\\\ x & =1+1 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f352a4e4-ace7-5237-beb9-55b20b2b14aa"] :db/ensure [:question/validate]} {:db/id "answer-field-f352a4e4-ace7-5237-beb9-55b20b2b14aa" :answer-field/id #uuid "f352a4e4-ace7-5237-beb9-55b20b2b14aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-39666ba2-d1b2-597c-b370-bacf043984d9" :answer-field/choices ["answer-39666ba2-d1b2-597c-b370-bacf043984d9" "answer-88a7cf58-d916-590f-9785-5e3e2335fcc8" "answer-f4fccee5-efce-59e3-b554-79d8ba6b664a" "answer-91de9c2e-7046-525e-8743-3f166f6387d8" "answer-bef9eaf4-0153-5684-97cd-4baabb718807"] :db/ensure [:answer-field/validate]} {:db/id "answer-39666ba2-d1b2-597c-b370-bacf043984d9" :answer/id #uuid "39666ba2-d1b2-597c-b370-bacf043984d9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-88a7cf58-d916-590f-9785-5e3e2335fcc8" :answer/id #uuid "88a7cf58-d916-590f-9785-5e3e2335fcc8" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-f4fccee5-efce-59e3-b554-79d8ba6b664a" :answer/id #uuid "f4fccee5-efce-59e3-b554-79d8ba6b664a" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-91de9c2e-7046-525e-8743-3f166f6387d8" :answer/id #uuid "91de9c2e-7046-525e-8743-3f166f6387d8" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-bef9eaf4-0153-5684-97cd-4baabb718807" :answer/id #uuid "bef9eaf4-0153-5684-97cd-4baabb718807" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-da7d6a02-447c-52f1-87f8-add9a2f9923e" :question/id #uuid "da7d6a02-447c-52f1-87f8-add9a2f9923e" :question/math-academy-id "q-73835" :question/problem "![](images/89/8965c5f1d97491db6ab606adf083d0d19d1a5812e7cd8060019b8253e9b726cd.png)\n\nWhat is the $x$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-2,2)$ and passes through the point $(7,5).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(-2,2)$ into the above gives\n\n$$\n(y-2)^{2}=4p(x+2).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(7,5),$ we substitute $x=7$ and $y=5$ into the equation and get\n\n$$\n\\begin{aligned}(5-2)^{2} & =4p(7+2) \\\\ 9 & =4p(9) \\\\ p & =\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-2)^{2} & =(x+2).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(0-2)^{2} & =(x+2) \\\\ 4 & =x+2 \\\\ x & =4-2 \\\\ x & =2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-442e0f0e-7158-585e-a6f1-74b91f5e78ad"] :db/ensure [:question/validate]} {:db/id "answer-field-442e0f0e-7158-585e-a6f1-74b91f5e78ad" :answer-field/id #uuid "442e0f0e-7158-585e-a6f1-74b91f5e78ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eb93ffdc-f3a1-5a8a-add9-8b3ab4687a54" :answer-field/choices ["answer-eb93ffdc-f3a1-5a8a-add9-8b3ab4687a54" "answer-16a63b0f-5612-5697-9957-612d1afe2968" "answer-4e986982-9ed8-549e-8c70-12068b401fa8" "answer-bdd1f648-8d54-565c-aea2-285561a08bbe" "answer-e0b6c92a-bb8f-5e61-895e-e5d4cb68972d"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb93ffdc-f3a1-5a8a-add9-8b3ab4687a54" :answer/id #uuid "eb93ffdc-f3a1-5a8a-add9-8b3ab4687a54" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-16a63b0f-5612-5697-9957-612d1afe2968" :answer/id #uuid "16a63b0f-5612-5697-9957-612d1afe2968" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-4e986982-9ed8-549e-8c70-12068b401fa8" :answer/id #uuid "4e986982-9ed8-549e-8c70-12068b401fa8" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bdd1f648-8d54-565c-aea2-285561a08bbe" :answer/id #uuid "bdd1f648-8d54-565c-aea2-285561a08bbe" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e0b6c92a-bb8f-5e61-895e-e5d4cb68972d" :answer/id #uuid "e0b6c92a-bb8f-5e61-895e-e5d4cb68972d" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id 17592186096708 :knowledge-point/questions ["question-d42d975f-c622-5e1c-8f09-860b1ab55e6f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d42d975f-c622-5e1c-8f09-860b1ab55e6f" :question/id #uuid "d42d975f-c622-5e1c-8f09-860b1ab55e6f" :question/math-academy-id "q-251808" :question/problem "![](images/8f/8f138ed24e1fa76264b344faf3d1a91082b5d0ecc76b66f069939c358176438f.png)\n\nThe value of the $y$-intercept of the parabola shown above  is{{field-1}}." :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(4,5)$ and passes through the point $(6,3).$\n\nThe general standard equation of an up- or down-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k),\n$$\n\nand substituting $(h,k)=(4,5)$ into the above gives\n\n$$\n(x-4)^{2}=4p(y-5).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(6,3),$ we substitute $x=6$ and $y=3$ into the equation and get\n\n$$\n\\begin{aligned}(6-4)^{2} & =4p(3-5) \\\\ 4 & =4p(-2) \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-4)^{2} & =-2(y-5).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(0-4)^{2} & =-2(y-5) \\\\ 16 & =-2(y-5) \\\\ -8 & =y-5 \\\\ y & =-3\\end{aligned}\n$$\n\nTherefore, the $y$-intercept is $-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c9e3b73-c2d8-584a-94b4-ea5f381f00cf"] :db/ensure [:question/validate]} {:db/id "answer-field-6c9e3b73-c2d8-584a-94b4-ea5f381f00cf" :answer-field/id #uuid "6c9e3b73-c2d8-584a-94b4-ea5f381f00cf" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9a6a9d26-433a-5092-af7f-f5759c6b0c0d" :answer-field/choices ["answer-9a6a9d26-433a-5092-af7f-f5759c6b0c0d"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a6a9d26-433a-5092-af7f-f5759c6b0c0d" :answer/id #uuid "9a6a9d26-433a-5092-af7f-f5759c6b0c0d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "activity-faaf5678-c9e5-5976-961c-e2fbc44826c4" :activity/id #uuid "faaf5678-c9e5-5976-961c-e2fbc44826c4" :activity/title "Calculating Intercepts of Parabolas" :activity/type :activity.type/review :activity/scope 17592186048350 :activity/course 17592186046658 :activity/steps ["step-f9932df0-eac7-523c-8872-a1bb24c06acd" "step-a17d4a2d-9cd6-514d-9640-3a0c7e5237bc" "step-75a1ff4f-96ae-55ce-832c-1ac2a8ea2583" "step-960da46e-e772-553c-8034-951c971e908d" "step-4c426ccb-6df2-54c6-bf9e-14c12edc8adc"] :activity/first-step "step-f9932df0-eac7-523c-8872-a1bb24c06acd" :db/ensure [:activity/validate]} {:db/id "step-f9932df0-eac7-523c-8872-a1bb24c06acd" :step/id #uuid "f9932df0-eac7-523c-8872-a1bb24c06acd" :step/content "question-67e144f2-2a3f-5e5b-9938-978ba91cf547" :step/next "step-a17d4a2d-9cd6-514d-9640-3a0c7e5237bc" :db/ensure [:step/validate]} {:db/id "step-a17d4a2d-9cd6-514d-9640-3a0c7e5237bc" :step/id #uuid "a17d4a2d-9cd6-514d-9640-3a0c7e5237bc" :step/content "question-da7d6a02-447c-52f1-87f8-add9a2f9923e" :step/next "step-75a1ff4f-96ae-55ce-832c-1ac2a8ea2583" :db/ensure [:step/validate]} {:db/id "step-75a1ff4f-96ae-55ce-832c-1ac2a8ea2583" :step/id #uuid "75a1ff4f-96ae-55ce-832c-1ac2a8ea2583" :step/content 17592186290524 :step/next "step-960da46e-e772-553c-8034-951c971e908d" :db/ensure [:step/validate]} {:db/id "step-960da46e-e772-553c-8034-951c971e908d" :step/id #uuid "960da46e-e772-553c-8034-951c971e908d" :step/content "question-d42d975f-c622-5e1c-8f09-860b1ab55e6f" :step/next "step-4c426ccb-6df2-54c6-bf9e-14c12edc8adc" :db/ensure [:step/validate]} {:db/id "step-4c426ccb-6df2-54c6-bf9e-14c12edc8adc" :step/id #uuid "4c426ccb-6df2-54c6-bf9e-14c12edc8adc" :step/content 17592186292537 :db/ensure [:step/validate]} [:db/retract 17592186310901 :answer-field/choices 17592186309353] [:db/retract 17592186311098 :answer-field/choices 17592186310204] [:db/retract 17592186311523 :answer-field/choices 17592186310132] {:db/id 17592186229132 :knowledge-point/questions ["question-30dbc074-1ece-5bdf-8ee0-957449e10161" "question-e9f770d5-4f03-58ec-b9ae-bcbaf7705c59"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186308718 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=2y(t) \\\\ {y}^{′}(t)=-2x(t)+3,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(2t) & \\operatorname{sin}⁡(2t) \\\\ -\\operatorname{sin}⁡(2t) & \\operatorname{cos}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\frac{1}{2}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"180px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :db/ensure [:question/validate]} {:db/id 17592186307958 :answer-field/correct "answer-6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer-field/choices ["answer-6963f53e-90b3-59a4-b3ac-6bc885da9965"] :db/ensure [:answer-field/validate]} {:db/id "answer-6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer/id #uuid "6963f53e-90b3-59a4-b3ac-6bc885da9965" :answer/type :answer.type/math :answer/value "3-\\cos(2t)+2\\sin(2t)" :db/ensure [:answer/validate]} {:db/id "question-30dbc074-1ece-5bdf-8ee0-957449e10161" :question/id #uuid "30dbc074-1ece-5bdf-8ee0-957449e10161" :question/math-academy-id "q-335068" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=7y(t)+7 \\\\ {y}^{′}(t)=-7x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & \\operatorname{sin}⁡(7t) \\\\ -\\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 7 \\\\ -7 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">$2\\operatorname{sin}⁡(7t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 7 \\\\ -7 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}7 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 7 \\\\ -7 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & \\operatorname{sin}⁡(7t) \\\\ -\\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(7t) & \\operatorname{sin}⁡(7t) \\\\ -\\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(7(t-s)) & \\operatorname{sin}⁡(7(t-s)) \\\\ -\\operatorname{sin}⁡(7(t-s)) & \\operatorname{cos}⁡(7(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(7(t-s)) & \\operatorname{sin}⁡(7(t-s)) \\\\ -\\operatorname{sin}⁡(7(t-s)) & \\operatorname{cos}⁡(7(t-s))\\end{aligned}][\\begin{aligned}7 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}7\\operatorname{cos}⁡(7(t-s)) \\\\ -7\\operatorname{sin}⁡(7(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}7\\operatorname{cos}⁡(7(t-s)) \\\\ -7\\operatorname{sin}⁡(7(t-s))\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{sin}⁡(7(t-s)) \\\\ -\\operatorname{cos}⁡(7(t-s))\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)-1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)\\end{aligned}]+[\\begin{aligned}\\operatorname{sin}⁡(7t) \\\\ \\operatorname{cos}⁡(7t)-1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡(7t) \\\\ 2\\operatorname{cos}⁡(7t)-1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8e66a9d5-c3d1-5ab6-8270-3abb2df59cb7"] :db/ensure [:question/validate]} {:db/id "answer-field-8e66a9d5-c3d1-5ab6-8270-3abb2df59cb7" :answer-field/id #uuid "8e66a9d5-c3d1-5ab6-8270-3abb2df59cb7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c02e4fa5-edc3-5680-b383-eb861b94c2ae" :answer-field/choices ["answer-c02e4fa5-edc3-5680-b383-eb861b94c2ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-c02e4fa5-edc3-5680-b383-eb861b94c2ae" :answer/id #uuid "c02e4fa5-edc3-5680-b383-eb861b94c2ae" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡(7t)-1" :db/ensure [:answer/validate]} {:db/id "question-e9f770d5-4f03-58ec-b9ae-bcbaf7705c59" :question/id #uuid "e9f770d5-4f03-58ec-b9ae-bcbaf7705c59" :question/math-academy-id "q-335166" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=4y(t) \\\\ {y}^{′}(t)=4x(t)+4,\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"80px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">$\\operatorname{sinh}⁡(4t)$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}0 \\\\ 4\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 4 \\\\ 4 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{aligned}][\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(4(t-s)) & \\operatorname{sinh}⁡(4(t-s)) \\\\ \\operatorname{sinh}⁡(4(t-s)) & \\operatorname{cosh}⁡(4(t-s))\\end{aligned}][\\begin{aligned}0 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}4\\operatorname{sinh}⁡(4(t-s)) \\\\ 4\\operatorname{cosh}⁡(4(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}4\\operatorname{sinh}⁡(4(t-s)) \\\\ 4\\operatorname{cosh}⁡(4(t-s))\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{cosh}⁡(4(t-s)) \\\\ -\\operatorname{sinh}⁡(4(t-s))\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)-1 \\\\ \\operatorname{sinh}⁡(4t)\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]+[\\begin{aligned}\\operatorname{cosh}⁡(4t)-1 \\\\ \\operatorname{sinh}⁡(4t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(4t)-1 \\\\ \\operatorname{sinh}⁡(4t)\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7f5cfcb1-f43f-54aa-937a-52c96207e17b"] :db/ensure [:question/validate]} {:db/id "answer-field-7f5cfcb1-f43f-54aa-937a-52c96207e17b" :answer-field/id #uuid "7f5cfcb1-f43f-54aa-937a-52c96207e17b" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-a547dde1-3353-563d-9dc4-c26608fe2262" :answer-field/choices ["answer-cd1db945-1bea-566f-ac8f-8accdd99a0c5" "answer-a547dde1-3353-563d-9dc4-c26608fe2262" "answer-6b596b99-7294-5ff0-b898-15ee8d9ff660" "answer-e10e0aba-3ff2-54c6-8ed9-ecc46df06c76"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd1db945-1bea-566f-ac8f-8accdd99a0c5" :answer/id #uuid "cd1db945-1bea-566f-ac8f-8accdd99a0c5" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡(4t)+1" :db/ensure [:answer/validate]} {:db/id "answer-a547dde1-3353-563d-9dc4-c26608fe2262" :answer/id #uuid "a547dde1-3353-563d-9dc4-c26608fe2262" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡(4t)-1" :db/ensure [:answer/validate]} {:db/id "answer-6b596b99-7294-5ff0-b898-15ee8d9ff660" :answer/id #uuid "6b596b99-7294-5ff0-b898-15ee8d9ff660" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(4t)+1" :db/ensure [:answer/validate]} {:db/id "answer-e10e0aba-3ff2-54c6-8ed9-ecc46df06c76" :answer/id #uuid "e10e0aba-3ff2-54c6-8ed9-ecc46df06c76" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(4t)-1" :db/ensure [:answer/validate]} {:db/id 17592186310901 :answer-field/correct 17592186309796 :db/ensure [:answer-field/validate]} {:db/id 17592186311098 :answer-field/correct 17592186310002 :db/ensure [:answer-field/validate]} {:db/id 17592186311523 :answer-field/correct 17592186310168 :db/ensure [:answer-field/validate]} {:db/id "activity-b9d3e9cf-c6b8-5144-84b6-fb2bd0e11696" :activity/id #uuid "b9d3e9cf-c6b8-5144-84b6-fb2bd0e11696" :activity/title "Solving Inhomogeneous Systems of ODEs Using Matrix Methods" :activity/type :activity.type/review :activity/scope 17592186050707 :activity/course 17592186046660 :activity/steps ["step-2a864f75-78c7-5949-a06f-5424af17ac17" "step-2fbeaf38-2336-5aee-bfc1-de7e502565a2" "step-06d91f07-0fea-5beb-aa8a-cd77b3e6a896" "step-2231ccca-1dd5-57de-b365-dbd0a5f43637" "step-c5aef665-a069-598d-9521-f09b9a91fe69"] :activity/first-step "step-2a864f75-78c7-5949-a06f-5424af17ac17" :db/ensure [:activity/validate]} {:db/id "step-2a864f75-78c7-5949-a06f-5424af17ac17" :step/id #uuid "2a864f75-78c7-5949-a06f-5424af17ac17" :step/content 17592186308718 :step/next "step-2fbeaf38-2336-5aee-bfc1-de7e502565a2" :db/ensure [:step/validate]} {:db/id "step-2fbeaf38-2336-5aee-bfc1-de7e502565a2" :step/id #uuid "2fbeaf38-2336-5aee-bfc1-de7e502565a2" :step/content "question-30dbc074-1ece-5bdf-8ee0-957449e10161" :step/next "step-06d91f07-0fea-5beb-aa8a-cd77b3e6a896" :db/ensure [:step/validate]} {:db/id "step-06d91f07-0fea-5beb-aa8a-cd77b3e6a896" :step/id #uuid "06d91f07-0fea-5beb-aa8a-cd77b3e6a896" :step/content "question-e9f770d5-4f03-58ec-b9ae-bcbaf7705c59" :step/next "step-2231ccca-1dd5-57de-b365-dbd0a5f43637" :db/ensure [:step/validate]} {:db/id "step-2231ccca-1dd5-57de-b365-dbd0a5f43637" :step/id #uuid "2231ccca-1dd5-57de-b365-dbd0a5f43637" :step/content 17592186396735 :step/next "step-c5aef665-a069-598d-9521-f09b9a91fe69" :db/ensure [:step/validate]} {:db/id "step-c5aef665-a069-598d-9521-f09b9a91fe69" :step/id #uuid "c5aef665-a069-598d-9521-f09b9a91fe69" :step/content 17592186311585 :db/ensure [:step/validate]} {:db/id 17592186231428 :knowledge-point/questions ["question-64d62ce0-8437-5a77-8100-0fa04bf9d1d8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-64d62ce0-8437-5a77-8100-0fa04bf9d1d8" :question/id #uuid "64d62ce0-8437-5a77-8100-0fa04bf9d1d8" :question/math-academy-id "q-343690" :question/problem "A particle of mass $0.8\\,\\text{kg}$ is attached to a massless spring. An external periodic force \n\n$$\nF(t)=(4{cos}^{2}\\,(\\frac{5}{2}t)-2)\\,\\text{N}\n$$\n\nis applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping and the system experiences resonance, what is the spring constant $k?$\n\n$k=$\n{{field-1}}${\\text{kg/s}}^{2}$" :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m$ and $F(t)$ gives\n\n$$\n0.8{y}^{″}=-ky+(4{cos}^{2}\\,(\\frac{5}{2}t)-2).\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+\\frac{5k}{4}y=\\frac{5}{2}(2{cos}^{2}\\,(\\frac{5}{2}t)-1).\n$$\n\nThe complementary solution ${y}_{c}$ here represents simple harmonic motion, and it can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration, and $\\omega $ is the system's internal frequency.\n\nIn our case,\n\n$$\n{\\omega }^{2}=\\frac{5k}{4}\\,⟹\\,k=\\frac{4}{5}{\\omega }^{2}.\n$$\n\nThe oscillator experiences resonance when the frequency of the external periodic force $f(t)=\\frac{5}{2}(2{cos}^{2}\\,(\\frac{5}{2}t)-1)$ is equal to the frequency of the complementary solution $\\omega .$ Since\n\n$$\nf(t)=\\frac{5}{2}(2{cos}^{2}\\,(\\frac{5}{2}t)-1)=\\frac{5}{2}\\operatorname{cos}⁡(5t),\n$$\n\nthe frequency of the external periodic force is $5.$\n\nTherefore,\n\n$$\nk=\\frac{4}{5}{\\omega }^{2}=\\frac{4}{5}\\cdot {5}^{2}=20\\,{\\text{kg/s}}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e18cc19c-c2dd-5d83-85f6-24d5473b0766"] :db/ensure [:question/validate]} {:db/id "answer-field-e18cc19c-c2dd-5d83-85f6-24d5473b0766" :answer-field/id #uuid "e18cc19c-c2dd-5d83-85f6-24d5473b0766" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2f1673e8-dffa-58ad-a21d-370ac4f21d2f" :answer-field/choices ["answer-2f1673e8-dffa-58ad-a21d-370ac4f21d2f"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f1673e8-dffa-58ad-a21d-370ac4f21d2f" :answer/id #uuid "2f1673e8-dffa-58ad-a21d-370ac4f21d2f" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "activity-45da9bbc-1512-5651-8f30-bc8c978f6a42" :activity/id #uuid "45da9bbc-1512-5651-8f30-bc8c978f6a42" :activity/title "Resonance in Vibrating Systems" :activity/type :activity.type/review :activity/scope 17592186048966 :activity/course 17592186046659 :activity/steps ["step-2265a2b8-a125-50ed-bfc1-8d6afde6c2a6" "step-3fe268b2-a12f-5127-8880-a5efc009faa7" "step-683c98ce-5d82-50d3-a3f8-d24ea690b317" "step-04593abc-de35-5ea9-a146-5ea660c1a706" "step-c95a38fe-1860-539e-b737-8be81b3f72b1"] :activity/first-step "step-2265a2b8-a125-50ed-bfc1-8d6afde6c2a6" :db/ensure [:activity/validate]} {:db/id "step-2265a2b8-a125-50ed-bfc1-8d6afde6c2a6" :step/id #uuid "2265a2b8-a125-50ed-bfc1-8d6afde6c2a6" :step/content 17592186335729 :step/next "step-3fe268b2-a12f-5127-8880-a5efc009faa7" :db/ensure [:step/validate]} {:db/id "step-3fe268b2-a12f-5127-8880-a5efc009faa7" :step/id #uuid "3fe268b2-a12f-5127-8880-a5efc009faa7" :step/content 17592186357702 :step/next "step-683c98ce-5d82-50d3-a3f8-d24ea690b317" :db/ensure [:step/validate]} {:db/id "step-683c98ce-5d82-50d3-a3f8-d24ea690b317" :step/id #uuid "683c98ce-5d82-50d3-a3f8-d24ea690b317" :step/content 17592186317420 :step/next "step-04593abc-de35-5ea9-a146-5ea660c1a706" :db/ensure [:step/validate]} {:db/id "step-04593abc-de35-5ea9-a146-5ea660c1a706" :step/id #uuid "04593abc-de35-5ea9-a146-5ea660c1a706" :step/content "question-64d62ce0-8437-5a77-8100-0fa04bf9d1d8" :step/next "step-c95a38fe-1860-539e-b737-8be81b3f72b1" :db/ensure [:step/validate]} {:db/id "step-c95a38fe-1860-539e-b737-8be81b3f72b1" :step/id #uuid "c95a38fe-1860-539e-b737-8be81b3f72b1" :step/content 17592186442740 :db/ensure [:step/validate]} [:db/retract 17592186132954 :answer-field/choices 17592186132955] [:db/retract 17592186132954 :answer-field/choices 17592186132957] [:db/retract 17592186132954 :answer-field/choices 17592186132958] {:db/id 17592186133849 :knowledge-point/questions ["question-9962cae8-99a7-590f-a35c-df110645462c" "question-3c3cdc1a-ff2a-59c0-9009-f0a0d149abd3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133673 :question/problem "The taxi fare, in dollars, charged by a particular cab company is given by the expression \n\n$$\n6m+8,\n$$\n\nwhere $m$ is the number of miles traveled. What do the constant term and the coefficient of $m$ represent in this context?" :question/worked-solution "The expression tells us that the cab company charges $\\[math]6$ for each mile traveled, plus a \"base fee\" of $\\[/math]8.$\n\n- The constant term is $8.$ We can think of this as the fee (in dollars) for traveling zero miles.\n\n- The coefficient of $m$ is $6.$ This represents the fee (in dollars) charged for every mile traveled." :db/ensure [:question/validate]} {:db/id 17592186133850 :knowledge-point/questions ["question-a52234c2-10d3-5f1e-bf78-705f84575746"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133674 :question/problem "A  recording studio charges musicians an initial fee of $\\[math]70$ to record an album. The studio also charges an additional fee of $\\[/math]55$ per hour.\nWhat expression gives the cost of recording an album in terms of the number of hours $h?$" :question/worked-solution "If $h$ is the number of hours used to record an album, and the studio charges an fee of $\\[math]55$ per hour, then the cost for $h$ hours must be $55h.$ \n\nHowever, there is also a fixed fee for recording an album. This fee is $\\[/math]70.$ Consequently, the constant term of the expression should be $70.$\n\nTherefore, the expression that represents the total cost of recording an album is:\n\n$$\n55 h+70\n$$" :db/ensure [:question/validate]} {:db/id 17592186133947 :knowledge-point/questions ["question-c71a7e7c-58e1-5206-bb4a-519f537223c7" "question-c61855c0-f32e-503f-84bf-b1654b65b8ce" "question-9076f1fb-4181-58aa-adca-483a1b65f8fe" "question-fb9924ff-c4e2-52dd-bf49-e683873b21a5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133538 :question/worked-solution "The price before taxes of the turkey is $N$ dollars.\n\nThe amount of tax is $7\\%$ of the price of the turkey, or $0.07N.$\n\nTherefore, the expression that represents the total cost of the turkey after tax is: \n\n$$\nN+0.07N\n$$" :db/ensure [:question/validate]} {:db/id 17592186133851 :knowledge-point/questions ["question-0fdb87d2-4260-5682-92a9-c298d9309d20" "question-5846d998-51e9-574a-9a51-5526adf86d55" "question-261e2c7f-a2b0-5f74-8412-23a24f65f2b4" "question-f7d200e6-96cf-5acb-92f7-781b4bd31a5f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133675 :question/problem "In a particular fast-food restaurant, a standard lunch consists of $2$ hot dogs for $H$ dollars each, $8$ potato wedges for $W$ dollars each, and $1$ drink $D$ dollars. Monica went to the fast-food restaurant to pick up lunch for her family, and the total bill was\n\n$$\n5(2H + 8W + D)\n$$\n\ndollars. \nWhat does the factor $5$ mean in this context?" :question/worked-solution "Two hot dogs cost $2H$ dollars, eight potato wedges cost $8W$ dollars, and a drink costs $D$ dollars. Thus, each standard lunch costs \n\n$$\n2H + 8W + D\n$$\n\ndollars. Monica's bill comes to \n\n$$\n5(2H + 8W + D)\n$$\n\ndollars, which is $5$ times the cost of a single standard lunch. Thus, the factor $5$ must be the total number of standard lunches that Monica purchased." :db/ensure [:question/validate]} {:db/id "question-9962cae8-99a7-590f-a35c-df110645462c" :question/id #uuid "9962cae8-99a7-590f-a35c-df110645462c" :question/math-academy-id "q-110161" :question/problem "For babysitting, Mia receives payment, in dollars, given by the expression $35h+15,$ where $h$ is the time, in hours, she spends babysitting. \n\nWhat does the coefficient of $h$ represent in this context?" :question/worked-solution "The expression tells us that Mia is paid $$35$ for each hour, plus a 'base fee' of $$15.$\n\nThe coefficient of  $h$ is $35.$  This represents the fee Mia charges for each hour she spends babysitting." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b6be27ac-a148-5263-8d74-f364a5f6e009"] :db/ensure [:question/validate]} {:db/id "answer-field-b6be27ac-a148-5263-8d74-f364a5f6e009" :answer-field/id #uuid "b6be27ac-a148-5263-8d74-f364a5f6e009" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fe3f6585-01e8-5422-acf5-6c5b0f143b8b" :answer-field/choices ["answer-fe3f6585-01e8-5422-acf5-6c5b0f143b8b" "answer-30db6c4e-ebd5-5d55-a0b2-e0987ef922fd" "answer-a63dce54-2649-5f0f-bdc6-8907552a1825" "answer-a17138fe-e225-53fa-a3da-047555a53844" "answer-de60f4c8-74e2-5986-ac25-af7804d3bba8"] :db/ensure [:answer-field/validate]} {:db/id "answer-fe3f6585-01e8-5422-acf5-6c5b0f143b8b" :answer/id #uuid "fe3f6585-01e8-5422-acf5-6c5b0f143b8b" :answer/type :answer.type/text :answer/value "Mia charges $$35$ for every hour of babysitting." :db/ensure [:answer/validate]} {:db/id "answer-30db6c4e-ebd5-5d55-a0b2-e0987ef922fd" :answer/id #uuid "30db6c4e-ebd5-5d55-a0b2-e0987ef922fd" :answer/type :answer.type/text :answer/value "The minimum amount Mia is paid for babysitting one hour is  $$15.$" :db/ensure [:answer/validate]} {:db/id "answer-a63dce54-2649-5f0f-bdc6-8907552a1825" :answer/id #uuid "a63dce54-2649-5f0f-bdc6-8907552a1825" :answer/type :answer.type/text :answer/value "The total amount Mia is paid for babysitting is $$45.$" :db/ensure [:answer/validate]} {:db/id "answer-a17138fe-e225-53fa-a3da-047555a53844" :answer/id #uuid "a17138fe-e225-53fa-a3da-047555a53844" :answer/type :answer.type/text :answer/value "The total amount Mia is paid for babysitting is $$50.$" :db/ensure [:answer/validate]} {:db/id "answer-de60f4c8-74e2-5986-ac25-af7804d3bba8" :answer/id #uuid "de60f4c8-74e2-5986-ac25-af7804d3bba8" :answer/type :answer.type/text :answer/value "The total amount Mia is paid for babysitting one hour is  $$15.$" :db/ensure [:answer/validate]} {:db/id "question-3c3cdc1a-ff2a-59c0-9009-f0a0d149abd3" :question/id #uuid "3c3cdc1a-ff2a-59c0-9009-f0a0d149abd3" :question/math-academy-id "q-110213" :question/problem "The fee a plumber charges for a callout is given by the expression $45h+50,$ where $h$ is the time, in hours, it takes him to complete the job. \n\nWhat does the constant term of the expression represent in this context?" :question/worked-solution "The expression tells us that the plumber charges $$45$ every hour, plus a 'base fee' of $$50.$ \n\nThe constant term is $50.$ This represents the fee (in dollars) the plumber charges for working zero hours." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9a3ba977-bb42-571f-927f-26ead2900a1a"] :db/ensure [:question/validate]} {:db/id "answer-field-9a3ba977-bb42-571f-927f-26ead2900a1a" :answer-field/id #uuid "9a3ba977-bb42-571f-927f-26ead2900a1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2a67811b-f29e-538f-b426-88d2cb9739cc" :answer-field/choices ["answer-e43410a9-5aea-53d7-9e5a-278d95bd9050" "answer-b95df9f3-a591-58e0-8524-58acceb34fff" "answer-743e3fec-53b8-5572-8d24-c126b8e02dbc" "answer-2a67811b-f29e-538f-b426-88d2cb9739cc" "answer-1014f958-5844-52f9-a049-95143a1c4847"] :db/ensure [:answer-field/validate]} {:db/id "answer-e43410a9-5aea-53d7-9e5a-278d95bd9050" :answer/id #uuid "e43410a9-5aea-53d7-9e5a-278d95bd9050" :answer/type :answer.type/text :answer/value "The plumber charges $$45$ per hour." :db/ensure [:answer/validate]} {:db/id "answer-b95df9f3-a591-58e0-8524-58acceb34fff" :answer/id #uuid "b95df9f3-a591-58e0-8524-58acceb34fff" :answer/type :answer.type/text :answer/value "The plumber charges $$50$ per hour." :db/ensure [:answer/validate]} {:db/id "answer-743e3fec-53b8-5572-8d24-c126b8e02dbc" :answer/id #uuid "743e3fec-53b8-5572-8d24-c126b8e02dbc" :answer/type :answer.type/text :answer/value "The plumber charges $$95$ per hour." :db/ensure [:answer/validate]} {:db/id "answer-2a67811b-f29e-538f-b426-88d2cb9739cc" :answer/id #uuid "2a67811b-f29e-538f-b426-88d2cb9739cc" :answer/type :answer.type/text :answer/value "The plumber's fee for working zero hours is $$50.$" :db/ensure [:answer/validate]} {:db/id "answer-1014f958-5844-52f9-a049-95143a1c4847" :answer/id #uuid "1014f958-5844-52f9-a049-95143a1c4847" :answer/type :answer.type/text :answer/value "The plumber's hourly rate." :db/ensure [:answer/validate]} {:db/id 17592186134486 :question/worked-solution "If $n$ is the number of toppings, and the pizzeria charges $$3$ per topping, then the cost for $n$ toppings must be $3n.$ \n\nHowever, there is also a fixed fee for the cheese pizza. This fee is $$15.$ Consequently, the constant term of the expression should be $15.$\n\nTherefore, the expression that represents the total cost (in dollars) of a pizza with $n$ toppings is:\n\n$$\n3n+15\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186132954 :answer-field/correct "answer-87dd191d-0ea0-5d3b-ae24-7e204ca5aaac" :answer-field/choices ["answer-c95a2671-29b2-5fbd-9631-c123bec1c154" "answer-36fcf1e8-a22a-517c-abc5-7a70a42ef00f" "answer-87dd191d-0ea0-5d3b-ae24-7e204ca5aaac"] :db/ensure [:answer-field/validate]} {:db/id "answer-c95a2671-29b2-5fbd-9631-c123bec1c154" :answer/id #uuid "c95a2671-29b2-5fbd-9631-c123bec1c154" :answer/type :answer.type/math :answer/value "15n+3" :db/ensure [:answer/validate]} {:db/id "answer-36fcf1e8-a22a-517c-abc5-7a70a42ef00f" :answer/id #uuid "36fcf1e8-a22a-517c-abc5-7a70a42ef00f" :answer/type :answer.type/math :answer/value "15n+3n" :db/ensure [:answer/validate]} {:db/id "answer-87dd191d-0ea0-5d3b-ae24-7e204ca5aaac" :answer/id #uuid "87dd191d-0ea0-5d3b-ae24-7e204ca5aaac" :answer/type :answer.type/math :answer/value "3n+15" :db/ensure [:answer/validate]} {:db/id "question-a52234c2-10d3-5f1e-bf78-705f84575746" :question/id #uuid "a52234c2-10d3-5f1e-bf78-705f84575746" :question/math-academy-id "q-44815" :question/problem "Paul is buying a cell phone at an online store. The price of the cell phone is $P$ dollars, and Paul also has to pay $$15$ for the shipping and handling of the product.\n\nWhat expression represents the total cost, in dollars, of the cell phone?" :question/worked-solution "The price of the cell phone is $P$ dollars.  \n\nThe amount for shipping and handling is $$15.$\n\n Hence, Paul's total bill for the cell phone will be $P+15$ dollars." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8ae26588-3055-5b2b-8fae-e3af9eb41e65"] :db/ensure [:question/validate]} {:db/id "answer-field-8ae26588-3055-5b2b-8fae-e3af9eb41e65" :answer-field/id #uuid "8ae26588-3055-5b2b-8fae-e3af9eb41e65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bf2ae639-7aba-53cf-9684-cc8c1115b541" :answer-field/choices ["answer-0c406a0f-af31-5af6-99df-d3dc091819a5" "answer-3997a93d-5a41-5663-8d38-470dc7a8f828" "answer-becae382-922a-538d-a88a-8010c37df62e" "answer-bf2ae639-7aba-53cf-9684-cc8c1115b541" "answer-92913609-8371-5fb8-b553-76afa675c073"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c406a0f-af31-5af6-99df-d3dc091819a5" :answer/id #uuid "0c406a0f-af31-5af6-99df-d3dc091819a5" :answer/type :answer.type/math :answer/value "15(P+1)" :db/ensure [:answer/validate]} {:db/id "answer-3997a93d-5a41-5663-8d38-470dc7a8f828" :answer/id #uuid "3997a93d-5a41-5663-8d38-470dc7a8f828" :answer/type :answer.type/math :answer/value "15P" :db/ensure [:answer/validate]} {:db/id "answer-becae382-922a-538d-a88a-8010c37df62e" :answer/id #uuid "becae382-922a-538d-a88a-8010c37df62e" :answer/type :answer.type/math :answer/value "15P+P" :db/ensure [:answer/validate]} {:db/id "answer-bf2ae639-7aba-53cf-9684-cc8c1115b541" :answer/id #uuid "bf2ae639-7aba-53cf-9684-cc8c1115b541" :answer/type :answer.type/math :answer/value "P+15" :db/ensure [:answer/validate]} {:db/id "answer-92913609-8371-5fb8-b553-76afa675c073" :answer/id #uuid "92913609-8371-5fb8-b553-76afa675c073" :answer/type :answer.type/math :answer/value "P+15P" :db/ensure [:answer/validate]} {:db/id "question-c71a7e7c-58e1-5206-bb4a-519f537223c7" :question/id #uuid "c71a7e7c-58e1-5206-bb4a-519f537223c7" :question/math-academy-id "q-110306" :question/problem "The retail price of a particular model of cell phone, at Jordan's Electronics, is \n$C$ dollars and the purchaser also has to pay an $11%$  tax.\n\nWhich expression represents the total cost, in dollars, of the cell phone after tax is applied?" :question/worked-solution "The price of the cell phone before taxes is $C$ dollars.\n\nThe amount of tax the purchaser has to pay is $11%$ of the price of a phone or $0.11C$ dollars.\n\nTherefore, the expression that represents the total cost (in dollars) of the cell phone after tax is:\n\n \n\n$$\nC+0.11C.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0d5848f3-de8b-5e77-ae8c-93ecc64fcbab"] :db/ensure [:question/validate]} {:db/id "answer-field-0d5848f3-de8b-5e77-ae8c-93ecc64fcbab" :answer-field/id #uuid "0d5848f3-de8b-5e77-ae8c-93ecc64fcbab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7acdeb0f-7bb1-5a18-8a2b-8c88b7479e1e" :answer-field/choices ["answer-1e8742da-db5e-58f6-b049-51d7f44550d4" "answer-7acdeb0f-7bb1-5a18-8a2b-8c88b7479e1e" "answer-f2d47c67-3d58-5ea7-b1c9-915a65e374dc" "answer-d7208da5-3498-5fd9-8c49-a4af223fb476" "answer-2e907824-60b3-51b3-a5a4-b88812f86ad8"] :db/ensure [:answer-field/validate]} {:db/id "answer-1e8742da-db5e-58f6-b049-51d7f44550d4" :answer/id #uuid "1e8742da-db5e-58f6-b049-51d7f44550d4" :answer/type :answer.type/math :answer/value "C+0.11" :db/ensure [:answer/validate]} {:db/id "answer-7acdeb0f-7bb1-5a18-8a2b-8c88b7479e1e" :answer/id #uuid "7acdeb0f-7bb1-5a18-8a2b-8c88b7479e1e" :answer/type :answer.type/math :answer/value "C+0.11C" :db/ensure [:answer/validate]} {:db/id "answer-f2d47c67-3d5