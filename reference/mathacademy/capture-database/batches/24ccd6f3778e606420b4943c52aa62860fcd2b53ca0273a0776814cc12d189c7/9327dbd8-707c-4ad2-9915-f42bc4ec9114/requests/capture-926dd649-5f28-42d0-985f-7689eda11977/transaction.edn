 #uuid "e8c36437-99d9-5669-9e31-260f96acb2d3" :answer/type :answer.type/math :answer/value "P+0.12" :db/ensure [:answer/validate]} {:db/id "answer-935f6d6b-83c3-56a4-be16-0c7248a977bb" :answer/id #uuid "935f6d6b-83c3-56a4-be16-0c7248a977bb" :answer/type :answer.type/math :answer/value "P+0.12P" :db/ensure [:answer/validate]} {:db/id "answer-5e41dd3d-3353-51e8-9aba-56c20a6d135a" :answer/id #uuid "5e41dd3d-3353-51e8-9aba-56c20a6d135a" :answer/type :answer.type/math :answer/value "P+1.2P" :db/ensure [:answer/validate]} {:db/id "answer-341d5fe8-20a0-562c-848f-94212a29d786" :answer/id #uuid "341d5fe8-20a0-562c-848f-94212a29d786" :answer/type :answer.type/math :answer/value "P+12" :db/ensure [:answer/validate]} {:db/id "answer-c5a13f7b-bc19-5485-bb61-b3d2526f8a80" :answer/id #uuid "c5a13f7b-bc19-5485-bb61-b3d2526f8a80" :answer/type :answer.type/math :answer/value "P+12P" :db/ensure [:answer/validate]} {:db/id "question-9076f1fb-4181-58aa-adca-483a1b65f8fe" :question/id #uuid "9076f1fb-4181-58aa-adca-483a1b65f8fe" :question/math-academy-id "q-75774" :question/problem "Sophie reserves a hotel room. The price of the room is $T$ dollars and, additionally, she must pay a $9%$ luxury tax.\n\nWhich expression gives the total cost, in dollars, of the hotel room after tax is applied?" :question/worked-solution "The price before taxes of a hotel room is $T$ dollars.\n\nThe amount of taxes Sophie pays is  $9%$ of the price of the hotel room, or $0.09T.$\n\nTherefore, the expression that represents the total cost (in dollars) of the  hotel room after luxury tax is:\n\n \n\n$$\nT+0.09T\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6ab5d524-2b50-5c5a-b48c-e9ea4678be8f"] :db/ensure [:question/validate]} {:db/id "answer-field-6ab5d524-2b50-5c5a-b48c-e9ea4678be8f" :answer-field/id #uuid "6ab5d524-2b50-5c5a-b48c-e9ea4678be8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47509097-65c5