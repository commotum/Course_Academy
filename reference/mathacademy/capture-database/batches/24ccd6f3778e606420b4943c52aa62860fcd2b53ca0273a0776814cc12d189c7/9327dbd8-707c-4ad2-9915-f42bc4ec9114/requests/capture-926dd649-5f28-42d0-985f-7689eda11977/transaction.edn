f-b4fb-975ae5652b90"] :topic/title "Working With Unit Prices" :db/ensure [:topic/identity-validate]} {:db/id "knowledge-point-d550bb4f-72a6-5b74-b050-8fdc2af6b23f" :knowledge-point/id #uuid "d550bb4f-72a6-5b74-b050-8fdc2af6b23f" :knowledge-point/canonical-example "question-df05a979-ea59-5937-80a7-89e9e0014ca8" :knowledge-point/questions ["question-bdeb06fe-5bf9-53f7-a73a-0e78ccea8201" "question-6365884e-1b89-5166-9bc6-57eac1293079" "question-ca144f12-4645-5673-bdbf-eb03fabe7dfa" "question-2c8fda57-c0ae-5471-9e00-bdb61e2342a8" "question-2a794af8-7414-51a7-a6c7-994b60009b14"] :knowledge-point/title "Calculating a Total Price from a Unit Price" :db/ensure [:knowledge-point/validate]} {:db/id "question-df05a979-ea59-5937-80a7-89e9e0014ca8" :question/id #uuid "df05a979-ea59-5937-80a7-89e9e0014ca8" :question/math-academy-id "e-4539" :question/problem "Micah is going to the store to buy some sunflower seeds. How much would it cost to buy $\\dfrac{1}{4}$ of a pound of sunflower seeds?\n\n| Item | Price |\n| --- | --- |\n| Pumpkin Seeds | $\\[math] 8 / \\text{lb}$ |\n| Sunflower Seeds | $\\[/math] 5 / \\text{lb}$ |" :question/worked-solution "The price of sunflower seeds is $\\[math] 5 / \\text{lb}.$ To find the cost of  $\\dfrac{1}{4}$ of a pound of sunflower seeds, we multiply:\n\n$$\n\\begin{aligned}5\\times \\frac{1}{4} & =\\frac{5}{1}\\times \\frac{1}{4} \\\\  & =\\frac{5\\times 1}{1\\times 4} \\\\  & =\\frac{5}{4} \\\\  & =5÷4 \\\\  & =1.25\\end{aligned}\n$$\n\nTherefore, it would cost $\\[/math] 1.25$ to buy $\\dfrac{1}{4}$ of a pound of sunflower seeds." :db/ensure [:question/validate]} {:db/id "knowledge-point-04d9118c-9cc2-5bb5-a7c4-ce43be06a65d" :knowledge-point/id #uuid "04d9118c-9cc2-5bb5-a7c4-ce43be06a65d" :knowledge-point/canonical-example "question-b63d3979-8319-52e5-833c-e4230a367cb0" :knowledge-point/questions ["question-a79d949c-d327-5106-907b-7c4645b173b3" "question-d34abd56-cdca-5fad-b44a-9d3b63e57048" "question-60c429d6-78bf-52f4-a402-0b1e67fa2508" "question-1900fcae-3d76-5147-a463-152f960f7a6c" "question-bb84f58e-e39d-5a83-ae84-6b21925b6b81"] :knowledge-point/title "Determining the Best Deal by Computing Unit Prices" :db/ensure [:knowledge-point/validate]} {:db/id "question-b63d3979-8319-52e5-833c-e4230a367cb0" :question/id #uuid "b63d3979-8319-52e5-833c-e4230a367cb0" :question/math-academy-id "e-4540" :question/problem "At the store, there are three different boxes of corn flakes cereal.\n\n- Box $A$ contains $18$ ounces of cereal, and costs $\\[math]  3.60 \\, .$\n\n- Box $B$ contains $15$ ounces of cereal, and costs $\\[/math]  3.30 \\, .$\n\n- Box $C$ contains $20$ ounces of cereal, and costs $\\[math]  3.80 \\, .$\n\nWhich box of cereal is the best deal?" :question/worked-solution "The best deal is the box with the lowest unit price. So, we need to compute the unit prices for all three boxes. To compute the unit price, we divide the price by the total number of ounces.\n\n- Dividing the total cost by the number of ounces in box $A,$ we get\n\n$$\n3.60 \\div 18 = 0.20 \\, .\n$$\n\nSo, the unit price of box $A$ is $\\[math]  0.20.$\n\n- Dividing the total cost by the number of ounces in box $B,$ we get\n\n$$\n3.30 \\div 15 = 0.22 \\, .\n$$\n\nSo, the unit price of box $B$ is $\\[/math]  0.22.$\n\n- Dividing the total cost by the number of ounces in box $C,$ we get\n\n$$\n3.80 \\div 20 = 0.19 \\, .\n$$\n\nSo, the unit price of box $C$ is $\\[math]  0.19.$\n\nFrom the above, we see that box $C$ has the lowest unit price. Therefore, box $C$ is the best deal." :db/ensure [:question/validate]} {:db/id "knowledge-point-1321abcb-7c99-5fef-b4fb-975ae5652b90" :knowledge-point/id #uuid "1321abcb-7c99-5fef-b4fb-975ae5652b90" :knowledge-point/canonical-example "question-3a104615-4887-59c8-9722-bb07b6cca5ae" :knowledge-point/questions ["question-689d0fea-adfc-579c-9b61-c303964b2aec" "question-517daee3-2d5a-5b03-be17-46f0dc74f72d" "question-1dc8a6fb-a221-5a8e-ae1b-b509f998884f" "question-7e6dd181-7d62-533c-99d8-31ea5383ac30" "question-8ca824bb-dbd7-559a-8d0c-91866baabae8"] :knowledge-point/title "Working With a Reciprocal Unit Price" :db/ensure [:knowledge-point/validate]} {:db/id "question-3a104615-4887-59c8-9722-bb07b6cca5ae" :question/id #uuid "3a104615-4887-59c8-9722-bb07b6cca5ae" :question/math-academy-id "e-4542" :question/problem "Andy sells homemade lemonade for $\\[math]  4$ per liter. Beth wants to buy some lemonade from Andy, but she only has $\\[/math]  1.$ How much lemonade can Beth buy?" :question/worked-solution "We are given the unit rate of $\\[math]  4$ per liter (dollars per liter). To find the amount of lemonade that Beth can buy for $\\[/math]  1,$ we need to find the unit rate in liters per dollar. So, we take the reciprocal:\n\n$$\n4 \\,\\textrm{dollars per liter} \\quad\\rightarrow\\quad \\dfrac{1}{4}  \\,\\textrm{liters per dollar}\n$$\n\nSo, the unit rate is $\\dfrac{1}{4}$ liters per dollar. Therefore, Beth can buy $\\dfrac{1}{4}$ of a liter of lemonade." :db/ensure [:question/validate]} {:db/id "question-bdeb06fe-5bf9-53f7-a73a-0e78ccea8201" :question/id #uuid "bdeb06fe-5bf9-53f7-a73a-0e78ccea8201" :question/math-academy-id "q-355000" :question/problem "Mike wants to buy some pears. The price of pears in a nearby store is $$0.95/lb.$ How much would Mike pay for $5$ pounds of pears?" :question/worked-solution "The unit price of pears is $$0.95/lb.$ To find the cost of $5$ pounds of pears, we multiply:\n\n$$\n\\begin{aligned}0.95\\times 5 & =4.75\\end{aligned}\n$$\n\nTherefore, Mike would pay $$4.75$ for $5$ pounds of pears." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1954635e-9596-5e91-8a02-4bb30d0e73e5"] :db/ensure [:question/validate]} {:db/id "answer-field-1954635e-9596-5e91-8a02-4bb30d0e73e5" :answer-field/id #uuid "1954635e-9596-5e91-8a02-4bb30d0e73e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-079a2517-4d56-5eed-8ef9-7c5047c37012" :answer-field/choic