.25\\end{aligned}\n$$\n\nTherefore, it would cost Lucy $$0.25$ to buy $\\frac{1}{8}$ of a pound of strawberries." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dda18ad2-1aab-58db-8a5d-ef25eccb820b"] :db/ensure [:question/validate]} {:db/id "answer-field-dda18ad2-1aab-58db-8a5d-ef25eccb820b" :answer-field/id #uuid "dda18ad2-1aab-58db-8a5d-ef25eccb820b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c2052c91-2426-59c5-ae44-f0f821bc2a1e" :answer-field/choices ["answer-c2052c91-2426-59c5-ae44-f0f821bc2a1e" "answer-4d633cf9-4173-5078-b2c7-9dd14eaae49f" "answer-fae86507-68e7-50ad-82f1-c9c0f63237ab" "answer-b879ec52-feb5-5016-b1db-1d2f346400df" "answer-a9bf3200-0325-5542-b7a2-fade1f2cbd73"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2052c91-2426-59c5-ae44-f0f821bc2a1e" :answer/id #uuid "c2052c91-2426-59c5-ae44-f0f821bc2a1e" :answer/type :answer.type/text :answer/value "$$0.25$" :db/ensure [:answer/validate]} {:db/id "answer-4d633cf9-4173-5078-b2c7-9dd14eaae49f" :answer/id #uuid "4d633cf9-4173-5078-b2c7-9dd14eaae49f" :answer/type :answer.type/text :answer/value "$$0.30$" :db/ensure [:answer/validate]} {:db/id "answer-fae86507-68e7-50ad-82f1-c9c0f63237ab" :answer/id #uuid "fae86507-68e7-50ad-82f1-c9c0f63237ab" :answer/type :answer.type/text :answer/value "$$0.35$" :db/ensure [:answer/validate]} {:db/id "answer-b879ec52-feb5-5016-b1db-1d2f346400df" :answer/id #uuid "b879ec52-feb5-5016-b1db-1d2f346400df" :answer/type :answer.type/text :answer/value "$$0.40$" :db/ensure [:answer/validate]} {:db/id "answer-a9bf3200-0325-5542-b7a2-fade1f2cbd73" :answer/id #uuid "a9bf3200-0325-5542-b7a2-fade1f2cbd73" :answer/type :answer.type/text :answer/value "$$0.55$" :db/ensure [:answer/validate]} {:db/id "question-ca144f12-4645-5673-bdbf-eb03fabe7dfa" :question/id #uuid "ca144f12-4645-5673-bdbf-eb03fabe7dfa" :question/math-academy-id "q-355001" :question/problem "Lisa wants to buy some bulk candy. The price of candy in a nearby store is $$2.15/lb.$ How much would Lisa pay for $3$ pounds of candy?" :question/worked-solution "The unit price of candy is $$2.15/lb.$ To find the cost of $3$ pounds of candy, we multiply:\n\n$$\n\\begin{aligned}2.15\\times 3 & =6.45\\end{aligned}\n$$\n\nTherefore, Lisa would pay $$6.45$ for $3$ pounds of candy." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1906a29d-4d9b-50df-ad00-44791606ded9"] :db/ensure [:question/validate]} {:db/id "answer-field-1906a29d-4d9b-50df-ad00-44791606ded9" :answer-field/id #uuid "1906a29d-4d9b-50df-ad00-44791606ded9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16f414c6-c343-5b46-b956-13f7a77a3ac6" :answer-field/choices ["answer-2260e319-a8e5-5403-a8bc-8d5baf42eaa7" "answer-4c4c9cef-6bf2-55c8-b4d4-f601158a5b87" "answer-16f414c6-c343-5b46-b956-13f7a77a3ac6" "answer-f94be7dc-89de-5abe-8a54-0a987e94efc3" "answer-28d976a2-2411-58bc-982a-3a5e1a363f04"] :db/ensure [:answer-field/validate]} {:db/id "answer-2260e319-a8e5-5403-a8bc-8d5baf42eaa7" :answer/id #uuid "2260e319-a8e5-5403-a8bc-8d5baf42eaa7" :answer/type :answer.type/text :answer/value "$$6.15$" :db/ensure [:answer/validate]} {:db/id "answer-4c4c9cef-6bf2-55c8-b4d4-f601158a5b87" :answer/id #uuid "4c4c9cef-6bf2-55c8-b4d4-f601158a5b87" :answer/type :answer.type/text :answer/value "$$6.30$" :db/ensure [:answer/validate]} {:db/id "answer-16f414c6-c343-5b46-b956-13f7a77a3ac6" :answer/id #uuid "16f414c6-c343-5b46-b956-13f7a77a3ac6" :answer/type :answer.type/text :answer/value "$$6.45$" :db/ensure [:answer/validate]} {:db/id "answer-f94be7dc-89de-5abe-8a54-0a987e94efc3" :answer/id #uuid "f94be7dc-89de-5abe-8a54-0a987e94efc3" :answer/type :answer.type/text :answer/value "$$6.65$" :db/ensure [:answer/validate]} {:db/id "answer-28d976a2-2411-58bc-982a-3a5e1a363f04" :answer/id #uuid "28d976a2-2411-58bc-982a-3a5e1a363f04" :answer/type :answer.type/text :answer/value "$$6.75$" :db/ensure [:answer/validate]} {:db/id "question-2c8fda57-c0ae-5471-9e00-bdb61e2342a8" :question/id #uuid "2c8fda57-c0ae-5471-9e00-bdb61e2342a8" :question/math-academy-id "q-68499" :question/problem "Tom wants to buy some oranges. The price of oranges in a nearby store is $$0.75/lb.$ How much would Tom pay for $3$ pounds of oranges?" :question/worked-solution "The unit price of oranges is $$0.75/lb.$ To find the cost of  $3$ pounds of oranges, we multiply:\n\n$$\n\\begin{aligned}0.75\\times 3 & =2.25\\end{aligned}\n$$\n\nTherefore, Tom would pay  $$2.25$ for $3$ pounds of oranges." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d13f49db-850b-534f-9692-eae74792b2af"] :db/ensure [:question/validate]} {:db/id "answer-field-d13f49db-850b-534f-9692-eae74792b2af" :answer-field/id #uuid "d13f49db-850b-534f-9692-eae74792b2af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-733f2223-ff58-5735-895f-5c187dcac54d" :answer-field/choices ["answer-733f2223-ff58-5735-895f-5c187dcac54d" "answer-65a407fb-2c2e-5eea-9622-e240d63f4b8e" "answer-d013e98b-4bc5-5a90-ba41-2136950f1de6" "answer-978dbf02-7f59-53c4-bbfa-9a43b780f0e4" "answer-79b23ce1-9781-5f36-bbb5-222a6e15ea80"] :db/ensure [:answer-field/validate]} {:db/id "answer-733f2223-ff58-5735-895f-5c187dcac54d" :answer/id #uuid "733f2223-ff58-5735-895f-5c187dcac54d" :answer/type :answer.type/text :answer/value "$$2.25$" :db/ensure [:answer/validate]} {:db/id "answer-65a407fb-2c2e-5eea-9622-e240d63f4b8e" :answer/id #uuid "65a407fb-2c2e-5eea-9622-e240d63f4b8e" :answer/type :answer.type/text :answer/value "$$2.45$" :db/ensure [:answer/validate]} {:db/id "answer-d013e98b-4bc5-5a90-ba41-2136950f1de6" :answer/id #uuid "d013e98b-4bc5-5a90-ba41-2136950f1de6" :answer/type :answer.type/text :answer/value "$$2.50$" :db/ensure [:answer/validate]} {:db/id "answer-978dbf02-7f59-53c4-bbfa-9a43b780f0e4" :answer/id #uuid "978dbf02-7f5