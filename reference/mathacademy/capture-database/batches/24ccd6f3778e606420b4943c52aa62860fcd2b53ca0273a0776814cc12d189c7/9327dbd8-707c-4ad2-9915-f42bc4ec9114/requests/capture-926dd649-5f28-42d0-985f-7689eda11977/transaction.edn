.\n\n$$\n\\begin{aligned}(r-2s)({r}^{2}+{s}^{2}) & = \\\\ r({r}^{2}+{s}^{2})+(-2s)({r}^{2}+{s}^{2}) & = \\\\ {r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}.\\end{aligned}\n$$\n\nWe cannot simplify the above expression any further because there are no like terms." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6164af12-a061-5247-be0b-02a0af340dc4"] :db/ensure [:question/validate]} {:db/id "answer-field-6164af12-a061-5247-be0b-02a0af340dc4" :answer-field/id #uuid "6164af12-a061-5247-be0b-02a0af340dc4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer-field/choices ["answer-ad0f2020-3fca-5d25-b5e4-b0d419345bb8" "answer-1b16ee72-72ca-517a-b1b1-2198b148afbc" "answer-759904a1-8636-537e-9c40-516d7deaa4c3" "answer-907ffe26-5485-53ae-a1fa-c8f1197ef46e" "answer-6d7ad74c-af73-5446-9052-df37d91b1f6d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad0f2020-3fca-5d25-b5e4-b0d419345bb8" :answer/id #uuid "ad0f2020-3fca-5d25-b5e4-b0d419345bb8" :answer/type :answer.type/math :answer/value "{r}^{3}+rs-2s{r}^{2}+{s}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-1b16ee72-72ca-517a-b1b1-2198b148afbc" :answer/id #uuid "1b16ee72-72ca-517a-b1b1-2198b148afbc" :answer/type :answer.type/math :answer/value "{r}^{3}+rs-2s{r}^{2}-2{s}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-759904a1-8636-537e-9c40-516d7deaa4c3" :answer/id #uuid "759904a1-8636-537e-9c40-516d7deaa4c3" :answer/type :answer.type/math :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}+2{s}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer/id #uuid "907ffe26-5485-53ae-a1fa-c8f1197ef46e" :answer/type :answer.type/math :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-2{s}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-6d7ad74c-af73-5446-9052-df37d91b1f6d" :answer/id #uuid "6d7ad74c-af73-5446-9052-df37d91b1f6d" :answer/type :answer.type/math :answer/value "{r}^{3}+r{s}^{2}-2s{r}^{2}-{s}^{3}" :db/ensure [:answer/validate]} {:db/id 17592186064242 :knowledge-point/questions ["question-0944dac9-480d-52ed-acdf-aeb980d5e726" "question-e2cad58f-c472-581c-a16b-711a6072cc50"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0944dac9-480d-52ed-acdf-aeb980d5e726" :question/id #uuid "0944dac9-480d-52ed-acdf-aeb980d5e726" :question/math-academy-id "q-52152" :question/problem "$(5w+2)(3w-5)=$" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(5w+2)(3w-5) & = \\\\ 5w(3w-5)+2(3w-5) & = \\\\ 15{w}^{2}-25w+6w-10 & = \\\\ 15{w}^{2}-19w-10\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cdeb2f7f-39f3-55df-bda0-3ce7a30bfa82"] :db/ensure [:question/validate]} {:db/id "answer-field-cdeb2f7f-39f3-55df-bda0-3ce7a30bfa82" :answer-field/id #uuid "cdeb2f7f-39f3-55df-bda0-3ce7a30bfa82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer-field/choices ["answer-725a4025-c76c-5f78-bc98-4504976b2a0e" "answer-25e004be-f08e-52db-afcf-7bfb57aca531" "answer-33f29d9f-b7f9-538d-84ef-87f102db7a58" "answer-c9194380-fd78-526b-86b8-a0353fc773b6" "answer-4a1a226c-3b58-5de1-bdd1-09862e44a749"] :db/ensure [:answer-field/validate]} {:db/id "answer-725a4025-c76c-5f78-bc98-4504976b2a0e" :answer/id #uuid "725a4025-c76c-5f78-bc98-4504976b2a0e" :answer/type :answer.type/math :answer/value "15{w}^{2}+19w-10" :db/ensure [:answer/validate]} {:db/id "answer-25e004be-f08e-52db-afcf-7bfb57aca531" :answer/id #uuid "25e004be-f08e-52db-afcf-7bfb57aca531" :answer/type :answer.type/math :answer/value "15{w}^{2}+19w-7" :db/ensure [:answer/validate]} {:db/id "answer-33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer/id #uuid "33f29d9f-b7f9-538d-84ef-87f102db7a58" :answer/type :answer.type/math :answer/value "15{w}^{2}-19w-10" :db/ensure [:answer/validate]} {:db/id "answer-c9194380-fd78-526b-86b8-a0353fc773b6" :answer/id #uuid "c9194380-fd78-526b-86b8-a0353fc773b6" :answer/type :answer.type/math :answer/value "15{w}^{2}-31w-10" :db/ensure [:answer/validate]} {:db/id "answer-4a1a226c-3b58-5de1-bdd1-09862e44a749" :answer/id #uuid "4a1a226c-3b58-5de1-bdd1-09862e44a749" :answer/type :answer.type/math :answer/value "15{w}^{2}-31w-7" :db/ensure [:answer/validate]} {:db/id "question-e2cad58f-c472-581c-a16b-711a6072cc50" :question/id #uuid "e2cad58f-c472-581c-a16b-711a6072cc50" :question/math-academy-id "q-216712" :question/problem "Expand the following product of binomials. Write your answer in **standard form.**\n\n$(8y+1)(2y+5)=$\n{{field-1}}" :question/worked-solution "We take each term of the first binomial and multiply it by the second binomial. Then, we simplify by collecting like terms.\n\n$$\n\\begin{aligned}(8y+1)(2y+5) & = \\\\ 8y(2y+5)+1(2y+5) & = \\\\ 16{y}^{2}+40y+2y+5 & = \\\\ 16{y}^{2}+42y+5\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e00f9b37-087b-5f93-99a9-aa065185418d"] :db/ensure [:question/validate]} {:db/id "answer-field-e00f9b37-087b-5f93-99a9-aa065185418d" :answer-field/id #uuid "e00f9b37-087b-5f93-99a9-aa065185418d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer-field/choices ["answer-0c2a21ab-44c4-5643-851b-b4a76932cc75"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/id #uuid "0c2a21ab-44c4-5643-851b-b4a76932cc75" :answer/type :answer.type/math :answer/value "16y^{2}+42y+5" :db/ensure [:answer/validate]} {:db/id "activity-8721e25f-828d-529f-8d37-00132303e9c8" :activity/id #uuid "8721e25f-828d-529f-8d37-00132303e9c8" :activity/title "Multiplying Binomials" :activity/type :activity.type/review :activity/scope 17592186050818 :activity/course 17592186046648 :activity/steps ["step-eb20a321-9a03-525a-8fd7-cf559bae04c2" "step-6dab3f05-590c-5fd9-986b-e9d3f2e3114c" "step-d0ea6c41-f392-560c-af01-cf23e5e44c12"] :activity/first-step "step-eb20a321-9a03-525a-8fd7-cf559bae04c2" :db/ensure [:activity/validate]} {:db/id "step-eb20a321-9a03-525a-8fd7-cf559bae04c2" :step/id #uuid "eb20a321-9a03-525a-8fd7-cf559bae04c2" :step/content "question-4f37487a-b4b8-5992-9edf-d3983de67b65" :step/next "step-6dab3f05-590c-5fd9-986b-e9d3f2e3114c" :db/ensure [:step/validate]} {:db/id "step-6dab3f05-590c-5fd9-986b-e9d3f2e3114c" :step/id #uuid "6dab3f05-590c-5fd9-986b-e9d3f2e3114c" :step/content "question-0944dac9-480d-52ed-acdf-aeb980d5e726" :step/next "step-d0ea6c41-f392-560c-af01-cf23e5e44c12" :db/ensure [:step/validate]} {:db/id "step-d0ea6c41-f392-560c-af01-cf23e5e44c12" :step/id #uuid "d0ea6c41-f392-560c-af01-cf23e5e44c12" :step/content "question-e2cad58f-c472-581c-a16b-711a6072cc50" :db/ensure [:step/validate]} {:db/id 17592186073899 :knowledge-point/questions ["question-d345ec95-0d6e-5d8e-a681-8aa64a38a770" "question-fce25e13-2247-5592-b858-9038960a704e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d345ec95-0d6e-5d8e-a681-8aa64a38a770" :question/id #uuid "d345ec95-0d6e-5d8e-a681-8aa64a38a770" :question/math-academy-id "q-61238" :question/problem "What is the distance between the points $(-2,2)$  and $(-2,7)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/39/39ac0f7718d7ee4ca8ed96b43c4f5ff9b644e0a3f7b5e2629052468b36ccf687.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $5$ units, so the distance equals $5.$\n\n![](images/59/5995f7494a28a33cc4bdeef51d7d4cc0a85ee8e3219d8630d366c50345629d54.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/1c/1cb541f6fcbb93b30a8f154763b0daa60e3b76142db1001ce804a2a68ba79247.png)\n\nThe point $(-2,7)$ is at a distance of $7$ from the $x$-axis, and the point $(-2,2)$ is at a distance of $2$ from the $x$-axis. Therefore, the distance between the two points is $7-2=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ce35d819-2898-51ad-bcff-556e53b6cc07"] :db/ensure [:question/validate]} {:db/id "answer-field-ce35d819-2898-51ad-bcff-556e53b6cc07" :answer-field/id #uuid "ce35d819-2898-51ad-bcff-556e53b6cc07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b32d799a-1971-505f-9d44-6d88dea78839" :answer-field/choices ["answer-4844ffa7-9148-54b8-9e72-b30c1cb0c11e" "answer-800b7dfe-1222-53bf-82a3-9afc3077f999" "answer-cde81723-b01c-5413-aefe-9f6e7a2f5589" "answer-b32d799a-1971-505f-9d44-6d88dea78839" "answer-ee3d1b5c-cd0f-5511-8f83-2c24cef83452"] :db/ensure [:answer-field/validate]} {:db/id "answer-4844ffa7-9148-54b8-9e72-b30c1cb0c11e" :answer/id #uuid "4844ffa7-9148-54b8-9e72-b30c1cb0c11e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-800b7dfe-1222-53bf-82a3-9afc3077f999" :answer/id #uuid "800b7dfe-1222-53bf-82a3-9afc3077f999" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-cde81723-b01c-5413-aefe-9f6e7a2f5589" :answer/id #uuid "cde81723-b01c-5413-aefe-9f6e7a2f5589" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-b32d799a-1971-505f-9d44-6d88dea78839" :answer/id #uuid "b32d799a-1971-505f-9d44-6d88dea78839" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-ee3d1b5c-cd0f-5511-8f83-2c24cef83452" :answer/id #uuid "ee3d1b5c-cd0f-5511-8f83-2c24cef83452" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-fce25e13-2247-5592-b858-9038960a704e" :question/id #uuid "fce25e13-2247-5592-b858-9038960a704e" :question/math-academy-id "q-61243" :question/problem "What is the distance between the points $(-5,-2)$  and $(-5,-9)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/35/353bedad7a1692dea35f8b6adf30b7b461458c7852b4123a3fc865e1b23370a6.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $7$ units, so the distance equals $7.$\n\n![](images/e3/e3516729d7662a3b4438a3d3085da3428605d026ba3387a71afeb085e2bd3e73.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $x$-axis and then subtracting.\n\n![](images/f8/f8c5583d14d4e5ca50df3ce906254446c402177734f352169d794de2bb7dea5c.png)\n\nThe point $(-5,-2)$ is at a distance of $2$ from the $x$-axis, and the point $(-5,-9)$ is at a distance of $9$ from the $x$-axis. Therefore, the distance between the two points is $9-2=7.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7857e68d-f576-5073-be69-923b7ef4e7c9"] :db/ensure [:question/validate]} {:db/id "answer-field-7857e68d-f576-5073-be69-923b7ef4e7c9" :answer-field/id #uuid "7857e68d-f576-5073-be69-923b7ef4e7c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer-field/choices ["answer-70a17d06-9360-5c19-9fa3-a5b4fb34974f" "answer-c731f4ef-fe9c-53df-889c-769685b74d4a" "answer-ea8a321d-e3fc-594f-880d-2f2880f86d49" "answer-6ec87af5-64e1-5fd2-bd75-166d861e724a" "answer-42efa052-c9ab-54d8-9f6d-f34afac5ba39"] :db/ensure [:answer-field/validate]} {:db/id "answer-70a17d06-9360-5c19-9fa3-a5b4fb34974f" :answer/id #uuid "70a17d06-9360-5c19-9fa3-a5b4fb34974f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c731f4ef-fe9c-53df-889c-769685b74d4a" :answer/id #uuid "c731f4ef-fe9c-53df-889c-769685b74d4a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-ea8a321d-e3fc-594f-880d-2f2880f86d49" :answer/id #uuid "ea8a321d-e3fc-594f-880d-2f2880f86d49" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer/id #uuid "6ec87af5-64e1-5fd2-bd75-166d861e724a" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-42efa052-c9ab-54d8-9f6d-f34afac5ba39" :answer/id #uuid "42efa052-c9ab-54d8-9f6d-f34afac5ba39" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186073900 :knowledge-point/questions ["question-95857c13-ed71-5f23-a1a7-f058676d3273"] :db/ensure [:knowledge-point/validate]} {:db/id "question-95857c13-ed71-5f23-a1a7-f058676d3273" :question/id #uuid "95857c13-ed71-5f23-a1a7-f058676d3273" :question/math-academy-id "q-161670" :question/problem "What is the distance between the points $(-1,5)$  and $(3,5)?$" :question/worked-solution "**Method 1** \n\nWe plot the given points in the coordinate plane.\n\n![](images/74/74dfce8c8444a841f9f742d70204d82b22157bf5b955bb2691eb0cdefe62fb75.png)\n\nThe distance between two points is the length of the line segment that connects them.\n\nFrom the diagram, we see that the length of the segment is $4$ units, so the distance equals $4.$\n\n![](images/4d/4df0d2515a43236634f934879d6a4d8926cc09163f79216ce288e07e2ba28e72.png)\n\n**Method 2**\n\nWe can find the distance between the two points by finding the distance of each point from the $y$-axis and then adding.\n\n![](images/aa/aaf091301a2b004e80bef49a2893eed00f0a28693d8799ee366ed47425869a9c.png)\n\nThe point $(-1,5)$ is at a distance of $1$ from the $y$-axis, and the point $(3,5)$ is at a distance of $3$ from the $y$-axis. Therefore, the distance between the two points is $1+3=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7a673c29-4fae-58d2-bcf6-86accdee64d1"] :db/ensure [:question/validate]} {:db/id "answer-field-7a673c29-4fae-58d2-bcf6-86accdee64d1" :answer-field/id #uuid "7a673c29-4fae-58d2-bcf6-86accdee64d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer-field/choices ["answer-dceb000c-8083-5f83-9e97-ae002b6b6ba1" "answer-b85c490c-92e9-5030-a0f6-291132b15fa4" "answer-5bdc2701-e79a-5b33-86a6-ef27722a55d2" "answer-80300fbe-d90a-591a-928d-9196db5a2240" "answer-6822bf50-caeb-554f-938f-a5cc8683af71"] :db/ensure [:answer-field/validate]} {:db/id "answer-dceb000c-8083-5f83-9e97-ae002b6b6ba1" :answer/id #uuid "dceb000c-8083-5f83-9e97-ae002b6b6ba1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-b85c490c-92e9-5030-a0f6-291132b15fa4" :answer/id #uuid "b85c490c-92e9-5030-a0f6-291132b15fa4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer/id #uuid "5bdc2701-e79a-5b33-86a6-ef27722a55d2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-80300fbe-d90a-591a-928d-9196db5a2240" :answer/id #uuid "80300fbe-d90a-591a-928d-9196db5a2240" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-6822bf50-caeb-554f-938f-a5cc8683af71" :answer/id #uuid "6822bf50-caeb-554f-938f-a5cc8683af71" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "activity-4ad6406f-28ca-5b57-94e6-4b4cc6fef04e" :activity/id #uuid "4ad6406f-28ca-5b57-94e6-4b4cc6fef04e" :activity/title "Distances Between Points in the Coordinate Plane" :activity/type :activity.type/review :activity/scope 17592186049868 :activity/course 17592186046648 :activity/steps ["step-ef3e2ccc-1312-5209-8ec4-fde9203f2c0d" "step-d5842dc7-b1b