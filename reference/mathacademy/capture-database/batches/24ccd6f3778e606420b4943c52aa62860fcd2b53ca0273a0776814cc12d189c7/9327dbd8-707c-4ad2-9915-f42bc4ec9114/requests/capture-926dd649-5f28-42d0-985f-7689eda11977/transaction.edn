choices 17592186380136] [:db/retract 17592186380133 :answer-field/choices 17592186380137] [:db/retract 17592186380133 :answer-field/choices 17592186380138] [:db/retract 17592186371639 :answer-field/choices 17592186371640] [:db/retract 17592186371639 :answer-field/choices 17592186371641] [:db/retract 17592186371639 :answer-field/choices 17592186371642] [:db/retract 17592186371639 :answer-field/choices 17592186371643] [:db/retract 17592186371639 :answer-field/choices 17592186371644] {:db/id 17592186054637 :knowledge-point/questions ["question-3c03ab7a-4491-5a50-9d10-a9d4303200d3" "question-704dcf7a-18fa-5b3e-a4d5-711d349f8966"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054638 :knowledge-point/questions ["question-e7e6e44c-b5ac-5425-8892-5340b5b344d9" "question-89c6e0d5-6929-5303-908c-02dab60ff0bc" "question-b86efe0a-54ca-5d2e-8b08-c543ca6f9fa1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054639 :knowledge-point/questions ["question-ae77173a-2ca2-505c-a9f6-aa510463577a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054640 :knowledge-point/questions ["question-c09d0cf0-247f-5da8-86ac-5074f5239c65"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054449 :question/problem "Which of the following statements are true?\n\nI. $\\mathcal{P}(\\{\\{\\emptyset\\}\\})  = \\{ \\emptyset, \\{\\emptyset\\} \\}$\n\nII. $\\mathcal{P} (\\{ \\emptyset, \\{0\\} \\} ) = \\{ \\emptyset, \\{0\\}, \\{\\{\\emptyset\\}\\}, \\{0, \\emptyset\\} \\}$\n\nIII. $\\mathcal{P}( \\mathcal{P}(\\{y\\}))  = \\{ \\emptyset, \\{\\emptyset\\}, \\{\\{y\\}\\}, \\{\\emptyset, \\{y\\}\\} \\}$" :db/ensure [:question/validate]} {:db/id "question-3c03ab7a-4491-5a50-9d10-a9d4303200d3" :question/id #uuid "3c03ab7a-4491-5a50-9d10-a9d4303200d3" :question/math-academy-id "q-105127" :question/problem "If $X=\\{x,y\\},$ then $P(X)=$" :question/worked-solution "The power set of $X,$ denoted $P(X),$ is the set that contains every possible subset of $X,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $X$ using a tree diagram.\n\n![](images/be/bea8536b726a48046b995d180bd9136146d491721a9197f696c7a5e9af43a6ba.png)\n\nAccording to our diagram, the subsets of $X$ are\n\n$$\n∅=\\{\\},\\,\\{x\\},\\,\\{y\\},\\,\\{x,y\\}.\n$$\n\nTherefore, we have\n\n$$\nP(X)=\\{∅,\\{x\\},\\{y\\},\\{x,y\\}\\}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-14dab3b2-22c1-5f2b-adcf-90441344d58c"] :db/ensure [:question/validate]} {:db/id "answer-field-14dab3b2-22c1-5f2b-adcf-90441344d58c" :answer-field/id #uuid "14dab3b2-22c1-5f2b-adcf-90441344d58c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e74e2092-2925-569e-886c-80bc60ca20d7" :answer-field/choices ["answer-b10ff497-27d6-5108-adb4-5fa60e2cf4da" "answer-0392591f-5068-5700-a5bc-4d271db178a6" "answer-cf5be63a-fb4b-57d1-997b-57d44ca45c85" "answer-bcd24002-3393-5c3f-be05-4886caf51bb5" "answer-e74e2092-2925-569e-886c-80bc60ca20d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-b10ff497-27d6-5108-adb4-5fa60e2cf4da" :answer/id #uuid "b10ff497-27d6-5108-adb4-5fa60e2cf4da" :answer/type :answer.type/math :answer/value "\\{\\{x,y\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-0392591f-5068-5700-a5bc-4d271db178a6" :answer/id #uuid "0392591f-5068-5700-a5bc-4d271db178a6" :answer/type :answer.type/math :answer/value "\\{\\{x\\},\\{n\\},\\{x,y\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-cf5be63a-fb4b-57d1-997b-57d44ca45c85" :answer/id #uuid "cf5be63a-fb4b-57d1-997b-57d44ca45c85" :answer/type :answer.type/math :answer/value "\\{\\{x\\},\\{y\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-bcd24002-3393-5c3f-be05-4886caf51bb5" :answer/id #uuid "bcd24002-3393-5c3f-be05-4886caf51bb5" :answer/type :answer.type/math :answer/value "\\{∅,\\{x,y\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-e74e2092-2925-569e-886c-80bc60ca20d7" :answer/id #uuid "e74e2092-2925-569e-886c-80bc60ca20d7" :answer/type :answer.type/math :answer/value "\\{∅,\\{x\\},\\{y\\},\\{x,y\\}\\}" :db/ensure [:answer/validate]} {:db/id 17592186395714 :question/problem "If $X=\\{2,4,8\\}$, then $P(X)=$" :question/worked-solution "The power set of $X,$ denoted $P(X),$ is the set that contains every possible subset of $X,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $X$ using a tree diagram. \n\n![](images/58/580d7c32378a2af641fb1066cec4ec24cc6c5b140ccf9475f9a3e3a68367d30d.png)\n\nAccording to our diagram, the subsets of $X$ are\n\n$$\n∅=\\{\\},\\,\\{2\\},\\,\\{4\\},\\,\\{8\\},\\,\\{2,4\\},\\,\\{2,8\\},\\,\\{4,8\\},\\,\\{2,4,8\\}.\n$$\n\nTherefore, we have\n\n$$\nP(X)=\\{∅,\\{2\\},\\{4\\},\\{8\\},\\{2,4\\},\\{2,8\\},\\{4,8\\},\\{2,4,8\\}\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186395715 :answer-field/correct "answer-20acfa57-ba3c-50b2-bb9e-5983c1d52588" :answer-field/choices ["answer-8affc093-0d42-5251-829d-298db802893d" "answer-df9ade01-7caa-541b-8ee0-1d15f0996bf1" "answer-eb79cdae-6d66-5016-97e5-c17676e59ed0" "answer-20acfa57-ba3c-50b2-bb9e-5983c1d52588" "answer-1e5e3846-4681-50a3-9773-00a804ac8630"] :db/ensure [:answer-field/validate]} {:db/id "answer-8affc093-0d42-5251-829d-298db802893d" :answer/id #uuid "8affc093-0d42-5251-829d-298db802893d" :answer/type :answer.type/math :answer/value "\\{\\{2\\},\\{4\\},\\{8\\},\\{2,4,8\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-df9ade01-7caa-541b-8ee0-1d15f0996bf1" :answer/id #uuid "df9ade01-7caa-541b-8ee0-1d15f0996bf1" :answer/type :answer.type/math :answer/value "\\{∅,2,4,8,\\{2,4\\},\\{2,8\\},\\{4,8\\},\\{2,4,8\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-eb79cdae-6d66-5016-97e5-c17676e59ed0" :answer/id #uuid "eb79cdae-6d66-5016-97e5-c17676e59ed0" :answer/type :answer.type/math :answer/value "\\{∅,\\{2,4,8\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-20acfa57-ba3c-50b2-bb9e-5983c1d52588" :answer/id #uuid "20acfa57-ba3c-50b2-bb9e-5983c1d52588" :answer/type :answer.type/math :answer/value "\\{∅,\\{2\\},\\{4\\},\\{8\\},\\{2,4\\},\\{2,8\\},\\{4,8\\},\\{2,4,8\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-1e5e3846-4681-50a3-9773-00a804ac8630" :answer/id #uuid "1e5e3846-4681-50a3-9773-00a804ac8630" :answer/type :answer.type/math :answer/value "\\{∅,\\{2\\},\\{4\\},\\{8\\},\\{2,4\\},\\{2,8\\},\\{4,8\\}\\}" :db/ensure [:answer/validate]} {:db/id "question-704dcf7a-18fa-5b3e-a4d5-711d349f8966" :question/id #uuid "704dcf7a-18fa-5b3e-a4d5-711d349f8966" :question/math-academy-id "q-80957" :question/problem "If $A=\\{4,\\{∅\\}\\},$ then $P(A)=$" :question/worked-solution "The power set of $A,$ denoted $P(A),$ is the set that contains every possible subset of $A,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $A$ using a tree diagram.\n\n![](images/05/05aba1d74ce21be5c12c7f72b0e5e9f5862b2a8ee67436f18fad1da1542bbc11.png)\n\nAccording to our diagram, the subsets of $A$ are\n\n$$\n∅=\\{\\},\\,\\{\\{∅\\}\\},\\,\\{4\\},\\,\\{4,\\{∅\\}\\}.\n$$\n\nTherefore, we have \n\n$$\nP(A)=\\{∅,\\{4\\},\\{\\{∅\\}\\},\\{4,\\{∅\\}\\}\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ab5b3c9e-bbb0-559d-a773-6cdda5c1c612"] :db/ensure [:question/validate]} {:db/id "answer-field-ab5b3c9e-bbb0-559d-a773-6cdda5c1c612" :answer-field/id #uuid "ab5b3c9e-bbb0-559d-a773-6cdda5c1c612" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ed5500f-bcf2-53ee-834e-61226994af42" :answer-field/choices ["answer-322ae03d-133c-5074-9e05-af54ba584511" "answer-6ed5500f-bcf2-53ee-834e-61226994af42" "answer-172f8ad4-9f1b-5676-8d3f-54267405333f" "answer-9a801ce9-232f-5884-9a02-c3c2fe9c87d9" "answer-dceabe73-fed2-5041-8609-f752f3b509e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-322ae03d-133c-5074-9e05-af54ba584511" :answer/id #uuid "322ae03d-133c-5074-9e05-af54ba584511" :answer/type :answer.type/math :answer/value "\\{\\{4\\},\\{\\{∅\\}\\},\\{4,