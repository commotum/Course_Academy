d "answer-041a1878-2410-51b2-ba62-e8a0ae2c724e" :answer/id #uuid "041a1878-2410-51b2-ba62-e8a0ae2c724e" :answer/type :answer.type/math :answer/value "\\{∅,\\{1\\},\\{2\\},\\{\\{1\\},\\{2\\}\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-a8e61ff3-e8f6-5d5f-ab76-30b6ea01cd2e" :answer/id #uuid "a8e61ff3-e8f6-5d5f-ab76-30b6ea01cd2e" :answer/type :answer.type/math :answer/value "\\{∅,\\{1\\},\\{\\{2\\}\\},\\{\\{1\\},2\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-5ee9e92c-9f59-51ae-adae-d6e6882b1c09" :answer/id #uuid "5ee9e92c-9f59-51ae-adae-d6e6882b1c09" :answer/type :answer.type/math :answer/value "\\{∅,\\{\\{1\\},\\{2\\}\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-0ed52aff-3c0b-54e2-9e8e-fdd487a9db8a" :answer/id #uuid "0ed52aff-3c0b-54e2-9e8e-fdd487a9db8a" :answer/type :answer.type/math :answer/value "\\{∅,\\{\\{1\\}\\},\\{\\{2\\}\\},\\{1,2\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-f738adac-5914-58d7-8737-9625c0a60d47" :answer/id #uuid "f738adac-5914-58d7-8737-9625c0a60d47" :answer/type :answer.type/math :answer/value "\\{∅,\\{\\{1\\}\\},\\{\\{2\\}\\},\\{\\{1\\},\\{2\\}\\}\\}" :db/ensure [:answer/validate]} {:db/id 17592186371638 :question/problem "If $Y=\\{0\\}$, then $P(Y)=$" :question/worked-solution "The power set of $Y,$ denoted $P(Y),$ is the set that contains every possible subset of $Y,$ including the empty set $∅.$\n\nSo, let's list out the subsets of $Y:$\n\n- The subset with no elements is $∅.$\n\n- The subset with $1$ element is $Y$ itself: $\\{0\\}.$\n\nTherefore, we have\n\n$$\nP(Y)=\\{∅,\\{0\\}\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186371639 :answer-field/correct "answer-dbe3119c-b864-5462-9e05-10fa108548dd" :answer-field/choices ["answer-e9b1c88c-f1cb-5698-bf02-cd8fe3fdcdd1" "answer-0c1c389c-dbb1-53dc-ac4d-4e01a9c976c6" "answer-fd19a9b6-5134-5a6d-9dea-f118fbddcbc6" "answer-dbe3119c-b864-5462-9e05-10fa108548dd" "answer-b94a6e8e-3cef-5f35-b5b6-00983e01cf9a"] :db/ensure [:answer-field/validate]} {:db/id "answer-e9b1c88c-f1cb-5698-bf02-cd8fe3fdcdd1" :answer/id #uuid "e9b1c88c-f1cb-5698-bf02-cd8fe3fdcdd1" :answer/type :answer.type/math :answer/value "\\{\\{0\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-0c1c389c-dbb1-53dc-ac4d-4e01a9c976c6" :answer/id #uuid "0c1c389c-dbb1-53dc-ac4d-4e01a9c976c6" :answer/type :answer.type/math :answer/value "\\{\\{∅\\},\\{0\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-fd19a9b6-5134-5a6d-9dea-f118fbddcbc6" :answer/id #uuid "fd19a9b6-5134-5a6d-9dea-f118fbddcbc6" :answer/type :answer.type/math :answer/value "\\{∅,0\\}" :db/ensure [:answer/validate]} {:db/id "answer-dbe3119c-b864-5462-9e05-10fa108548dd" :answer/id #uuid "dbe3119c-b864-5462-9e05-10fa108548dd" :answer/type :answer.type/math :answer/value "\\{∅,\\{0\\}\\}" :db/ensure [:answer/validate]} {:db/id "answer-b94a6e8e-3cef-5f35-b5b6-00983e01cf9a" :answer/id #uuid "b94a6e8e-3cef-5f35-b5b6-00983e01cf9a" :answer/type :answer.type/math :answer/value "\\{∅,\\{\\}\\}" :db/ensure [:answer/validate]} {:db/id "question-e7e6e44c-b5ac-5425-8892-5340b5b344d9" :question/id #uuid "e7e6e44c-b5ac-5425-8892-5340b5b344d9" :question/math-academy-id "q-105149" :question/problem "If $K=\\{3,k,9\\},$ then $|P(K)|=$" :question/worked-solution "For any set $K,$ we have $|P(K)|={2}^{|K|}.$ \n\nIn this case, $|K|=3,$ so we have\n\n$$\n|P(K)|={2}^{|K|}={2}^{3}=8.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8f7ab2b3-fc07-54ae-97c0-4588ea2f4b91"] :db/ensure [:question/validate]} {:db/id "answer-field-8f7ab2b3-fc07-54ae-97c0-4588ea2f4b91" :answer-field/id #uuid "8f7ab2b3-fc07-54ae-97c0-4588ea2f4b91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b880071f-cd23-5321-bef1-28e108f31adb" :answer-field/choices ["answer-6bb5be5a-25fc-5243-a0a7-d419679e5c42" "answer-d1249453-5a0e-5a14-93c6-359ff868f213" "answer-e94edc0d-f8b1-5079-90dc-7efac6603889" "answer-b880071f-cd23-5321-bef1-28e108f31adb" "answer-f29511ba-7f18-5c45-958f-b93413c35ae6"] :db/ensure [:answer-field/validate]} {:db/id "answer-6bb5be5a-25fc-5243-a0a7-d419679e5c42" :answer/id #uuid "6bb5be5a-25fc-5243-a0a7-d419679e5c42" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-d1249453-5a0e-5a14-93c6-359ff868f213" :answer/id #uuid "d1249453-5a0e-5a14-93c6-359ff868f213" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-e94edc0d-f8b1-5079-90dc-7efac6603889" :answer/id #uuid "e94edc0d-f8b1-5079-90dc-7efac6603889" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-b880071f-cd23-5321-bef1-28e108f31adb" :answer/id #uuid "b880071f-cd23-5321-bef1-28e108f31adb" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-f29511ba-7f18-5c45-958f-b93413c35ae6" :answer/id #uuid "f29511ba-7f18-5c45-958f-b93413c35ae6" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186054979 :question/problem "Suppose that $A$ is a set. If $|A|=5$, then $|P(A)|=$" :question/worked-solution "For any set $A,$ we have $|P(A)|={2}^{|A|}.$ \n\nIn this case, $|A|=5,$ so we have\n\n$$\n|P(A)|={2}^{|A|}={2}^{5}=32.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186051404 :answer-field/correct 17592186051409 :db/ensure [:answer-field/validate]} {:db/id "question-89c6e0d5-6929-5303-908c-02dab60ff0bc" :question/id #uuid "89c6e0d5-6929-5303-908c-02dab60ff0bc" :question/math-academy-id "q-80976" :question/problem "If $Y=\\{\\{∅\\},5,\\{1\\}\\}$, then $|P(Y)|=$" :question/worked-solution "For any set $Y,$ we have $|P(Y)|={2}^{|Y|}.$ \n\nIn this case, $|Y|=3,$ so we have\n\n$$\n|P(Y)|={2}^{|Y|}={2}^{3}=8.\n$$\n\nRemember that $\\{∅\\}$ is a single element in the set $X,$ and the same is true for $\\{1\\}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-59b2fac7-5091-5fe2-826f-e3922de13921"] :db/ensure [:question/validate]} {:db/id "answer-field-59b2fac7-5091-5fe2-826f-e3922de13921" :answer-field/id #uuid "59b2fac7-5091-5fe2-826f-e3922de13921" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c63dd40b-f69b-5675-8c56-bde589f5312f" :answer-field/choices ["answer-97c3aeb5-618c-5db7-a426-7e7a538ea8c9" "answer-9bcce55e-c787-5bfb-bb44-66980f246a6a" "answer-115fa93c-57d6-5be7-ac70-6bd718d4859b" "answer-aff82101-5e36-5ee2-97a1-872e06c1379b" "answer-c63dd40b-f69b-5675-8c56-bde589f5312f"] :db/ensure [:answer-field/validate]} {:db/id "answer-97c3aeb5-618c-5db7-a426-7e7a538ea8c9" :answer/id #uuid "97c3aeb5-618c-5db7-a426-7e7a538ea8c9" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-9bcce55e-c787-5bfb-bb44-66980f246a6a" :answer/id #uuid "9bcce55e-c787-5bfb-bb44-66980f246a6a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-115fa93c-57d6-5be7-ac70-6bd718d4859b" :answer/id #uuid "115fa93c-57d6-5be7-ac70-6bd718d4859b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-aff82101-5e36-5ee2-97a1-872e06c1379b" :answer/id #uuid "aff82101-5e36-5ee2-97a1-872e06c1379b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-c63dd40b-f69b-5675-8c56-bde589f5312f" :answer/id #uuid "c63dd40b-f69b-5675-8c56-bde589f5312f" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-b86efe0a-54ca-5d2e-8b08-c543ca6f9fa1" :question/id #uuid "b86efe0a-54ca-5d2e-8b08-c543ca6f9fa1" :question/math-academy-id "q-80974" :question/problem "If $D=\\{-1,1\\},$ then $|P(D)|=$" :question/worked-solution "For any set $D,$ we have $|P(D)|={2}^{|D|}.$ \n\nIn this case, $|D|=2,$ so we have\n\n$$\n|P(D)|={2}^{|D|}={2}^{2}=4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2b4bd622-a7d5-5d65-a386-67459ee7e722"] :db/ensure [:question/validate]} {:db/id "answer-field-2b4bd622-a7d5-5d65-a386-67459ee7e722" :answer-field/id #uuid "2b4bd622-a7d5-5d65-a386-67459ee7e722" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f44b21dc-c93a-53fe-aec7-f8790d0c947c" :answer-field/choices ["answer-911081fa-081e-5875-9f98-5817bbf3efc5" "answer-5e8b4df6-8ce1-52fe-8b9a-b0f90fd5c98a" "answer-a3d1bd51-b8e9-5c1a-94ac-99e23e2ae7bd" "answer-f44b21dc-c93a-53fe-aec7-f8790d0c947c" "answer-c0a0f58b-1f39-5bd1-86e6-904cde31e1e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-911081fa-081e-5875-9f98-5817bbf3efc5" :answer/id #uuid "911081fa-081e-5875-9f98-5817bbf3efc5" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5e8b4df6-8ce1-52fe-8b9a-b0f90fd5c98a" :answer/id #uuid "5e8b4df6-8ce1-52fe-8b9a-b0f90fd5c98a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-a3d1bd51-b8e9-5c1a-94ac-99e23e2ae7bd" :answer/id #uuid "a3d1bd51-b8e9-5c1a-94ac-99e23e2ae7bd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f44b21dc-c93a-53fe-aec7-f8790d0c947c" :answer/id #uuid "f44b21dc-c93a-53fe-aec7-f8790d0c947c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-c0a0f58b-1f39-5bd1-86e6-904cde31e1e7" :answer/id #uuid "c0a0f58b-1f39-5bd1-86e6-904cde31e1e7" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186054949 :question/problem "If $A=\\{2,3\\}$ and $B=∅$ then $|P(A\\times P(B))|=$" :question/worked-solution "For any set $S,$ we have $|P(S)|={2}^{|S|}.$ Also, $|S\\times T|=|S|\\cdot |T|.$\n\nIn our case, \n\n$$\n|A|=2,\\,|B|=0.\n$$\n\nAs a result, \n\n$$\n|P(B)|={2}^{|B|}={2}^{0}=1.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}|P(A\\times P(B))| & ={2}^{|A\\times P(B)|} \\\\  & ={2}^{|A|\\,\\cdot \\,P(B)} \\\\  & ={2}^{2\\cdot 1} \\\\  & ={2}^{2} \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186051224 :answer-field/correct 17592186051225 :db/ensure [:answer-field/validate]} {:db/id "question-ae77173a-2ca2-505c-a9f6-aa510463577a" :question/id #uuid "ae77173a-2ca2-505c-a9f6-aa510463577a" :question/math-academy-id "q-182220" :question/problem "If $A=\\{a,b\\}$ and $B=\\{-1,0,1\\}$ then $|P(A)\\times P(B)|=$" :question/worked-solution "For any set $S,$ we have $|P(S)|={2}^{|S|}.$ Also, $|S\\times T|=|S|\\cdot |T|.$\n\nIn our case, \n\n$$\n|A|=2,\\,|B|=3.\n$$\n\nAs a result, \n\n$$\n\\begin{aligned}|P(A)| & ={2}^{|A|}={2}^{2}=4, \\\\ |P(B)| & ={2}^{|B|}={2}^{3}=8.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}|P(A)\\times P(B)| & =|P(A)|\\cdot |P(B)| \\\\  & =4\\cdot 8 \\\\  & =32.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0897cc65-9984-54a2-806e-46d5a90e4e82"] :db/ensure [:question/validate]} {:db/id "answer-field-0897cc65-9984-54a2-806e-46d5a90e4e82" :answer-field/id #uuid "0897cc65-9984-54a2-806e-46d5a90e4e82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72e7fe21-cd04-5a89-bcbe-229db8147b9a" :answer-field/choices ["answer-4794f642-3b02-51ca-9585-9769bde5fecd" "answer-36059e63-9c7a-5044-a5ff-3b7c78c5dfdc" "answer-72e7fe21-cd04-5a89-bcbe-229db8147b9a" "answer-7734f6e2-fb37-506c-9eb4-4527bf88dc19" "answer-680911ea-bae1-58de-a47e-87ff2e8dfc56"] :db/ensure [:answer-field/validate]} {:db/id "answer-4794f642-3b02-51ca-9585-9769bde5fecd" :answer/id #uuid "4794f642-3b02-51ca-9585-9769bde5fecd" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-36059e63-9c7a-5044-a5ff-3b7c78c5dfdc" :answer/id #uuid "36059e63-9c7a-5044-a5ff-3b7c78c5dfdc" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-72e7fe21-cd04-5a89-bcbe-229db8147b9a" :answer/id #uuid "72e7fe21-cd04-5a89-bcbe-229db8147b9a" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-7734f6e2-fb37-506c-9eb4-4527bf88dc19" :answer/id #uuid "7734f6e2-fb37-506c-9eb4-4527bf88dc19" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-680911ea-bae1-58de-a47e-87ff2e8dfc56" :answer/id #uuid "680911ea-bae1-58de-a47e-87ff2e8dfc56" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186372405 :question/problem "If $Y=\\{1\\}$ and $Z=\\{m,n\\}$ then $|P(Z)\\times P(Y\\times Z)|=$" :db/ensure [:question/validate]} {:db/id "question-c09d0cf0-247f-5da8-86ac-5074f5239c65" :question/id #uuid "c09d0cf0-247f-5da8-86ac-5074f5239c65" :question/math-academy-id "q-182230" :question/problem "Which of the following statements are true?\n\nI. $P(∅)=\\{∅\\}$\n\nII. $P(a)=\\{∅,\\{a\\}\\}$\n\nIII. $P(\\{∅,\\{∅\\}\\})=\\{∅,\\{∅,\\{∅\\}\\}\\}$" :question/worked-solution "The power set of $T,$ denoted $P(T),$ is the set that contains every possible subset of $T,$ including the empty set $∅.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, the power set of the set $∅$ is $\\{∅\\}.$\n\n- Statement II is false. Notice that $a$ is not a set. So, the notation $P(a)$ does not make sense.\n\n- Statement III is false. Notice that we are given the set $\\{∅,\\{∅\\}\\}.$ So, its power set must be $\\{∅,\\{∅\\},\\{\\{∅\\}\\},\\{∅,\\{∅\\}\\}\\}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-40cf1680-4aee-5c33-aa84-ca0ab1d7eb28"] :db/ensure [:question/validate]} {:db/id "answer-field-40cf1680-4aee-5c33-aa84-ca0ab1d7eb28" :answer-field/id #uuid "40cf1680-4aee-5c33-aa84-ca0ab1d7eb28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c1edf78e-6f48-5a04-a34c-815cb29263ad" :answer-field/choices ["answer-60b488d3-4af9-5408-86d2-64b7a88c37f8" "answer-c1edf78e-6f48-5a04-a34c-815cb29263ad" "answer-ccd790ba-34d4-55f8-967b-992968640c54" "answer-e0b76802-f72d-59b0-b07c-30e15c9a52bb" "answer-19828ad7-6154-5b2d-840b-b3b96f511f7b"] :db/ensure [:answer-field/validate]} {:db/id "answer-60b488d3-4af9-5408-86d2-64b7a88c37f8" :answer/id #uuid "60b488d3-4af9-5408-86d2-64b7a88c37f8" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-c1edf78e-6f48-5a04-a34c-815cb29263ad" :answer/id #uuid "c1edf78e-6f48-5a04-a34c-815cb29263ad" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-ccd790ba-34d4-55f8-967b-992968640c54" :answer/id #uuid "ccd790ba-34d4-55f8-967b-992968640c54" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-e0b76802-f72d-59b0-b07c-30e15c9a52bb" :answer/id #uuid "e0b76802-f72d-59b0-b07c-30e15c9a52bb" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-19828ad7-6154-5b2d-840b-b3b96f511f7b" :answer/id #uuid "19828ad7-6154-5b2d-840b-b3b96f511f7b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186056045 :tutorial/content "Suppose $S$ is a set. The **power set** of $S,$ denoted $\\mathcal{P}(S),$ is the set containing every subset of $S,$ *including* the empty set.\n\nFor example, let's find the power set of the set\n\n$$\nS = \\{ 1,2,3 \\}.\n$$\n\nTo do this, we list out all the subsets of $S{:}$\n\n- The subset containing no elements is $\\emptyset.$\n\n- The subsets containing $1$ element are $\\{ 1 \\},$ $\\{ 2 \\},$ and $\\{ 3 \\}.$\n\n- The subsets containing $2$ elements are $\\{ 1,2 \\},$  $\\{ 1,3 \\},$ and  $\\{ 2,3 \\}.$\n\n- The subset containing $3$ elements is $S$ itself: $\\{ 1,2,3 \\}.$\n\nNow, let's put all these subsets together as elements of a single set. We get\n\n$$\n\\mathcal{P}(S) = \\big\\{ \\emptyset, \\{1\\}, \\{2\\}, \\{3\\}, \\{ 1,2 \\}, \\{ 1,3 \\}, \\{ 2,3 \\}, \\{ 1,2,3 \\} \\big\\}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186056060 :tutorial/content "Another way to generate all the subsets of $S=\\{ 1,2,3 \\}$ is using a tree diagram. We start off with the empty set $\\{\\}$ and generate additional subsets of $S$ by systematically inserting or excluding elements of $S.$\n\nLet's go through the process.\n\n- Start with the empty set $\\{\\}$ at the root node of our tree. This is the parent node.\n\n- Draw two branches pointing away from the parent node. The tip of each arrow gives a child node. Label one branch 'No' and the other 'Yes'.\n\n![](images/a4/a4b17d8114cc48cdc858d036b839d766dcb60f3b400a096406479c9daf7afac0.png)\n\n- We'll now write down a subset of $S$ at each child node:\n\n- At the child node (tip of the arrow) whose branch is labeled 'No,' we write down the parent node's set.\n\n$$\n\\{\\}\n$$\n\n- At the child node whose branch is labeled 'Yes,' we create a new set by inserting the *first* element of $S$ into the parent node's set. This gives the following subset of $S{:}$\n\n$$\n\\{1\\}\n$$\n\nWe now have the following diagram.\n\n![](images/61/61c6c192df26a22cac5dddad6b2692a519da055730fe9738f3173cb38229cf8b.png)\n\nWe repeat the process, setting the subsets found in the previous step as the new parent nodes. \n\n- We start by considering the parent node $\\{\\}{:}$\n\n- At the child node whose branch is labeled 'No', we write down the parent node's set.\n\n$$\n\\{\\}\n$$\n\n- At the child node whose branch is labeled 'Yes,' we create a new set by inserting the *second* element of $S$ into the parent node's set. This gives the following subset of $S{:}$\n\n$$\n\\{2\\}\n$$\n\nWe now have the following diagram.\n\n![](images/6e/6e43b6022b5939b824995936d8ab910b7b3d2e821a6c96be63606245f6e60dbb.png)\n\n- Then, we consider the parent node $\\{1\\}{:}$\n\n- At the child node whose branch is labeled 'No', we write down the parent node's set.\n\n$$\n\\{1\\}\n$$\n\n- At the child node whose branch is labeled 'Yes,' we create a new set by inserting the *second* element of $S$ into the parent node's set. This gives the following subset of $S{:}$\n\n$$\n\\{1,2\\}\n$$\n\nWe now have the following diagram.\n\n![](images/6f/6f81c80039f14260bdfdb8d55a34820874fe518e076d2718629d4faf385e92d5.png)\n\n- Finally, we repeat the process for the new parent nodes $\\{\\}, \\{2\\}, \\{1\\},$ and $\\{1,2\\}.$ \n\nOur final tree diagram looks as follows.\n\n![](images/12/127ee1187ebf3a2cc498c88326285d5adf5d609cf3276885e8c9d525435133eb.png)\n\nThe final column lists all subsets of $S.$ \n\n$$\n\\emptyset = \\{\\},\\quad \\{1\\},\\quad \\{2\\},\\quad \\{3\\},\\quad \\{ 1,2 \\},\\quad \\{ 1,3 \\},\\quad \\{ 2,3 \\},\\quad \\{ 1,2,3 \\}\n$$\n\nFinally then, we can write down $\\mathcal P(S){:}$\n\n$$\n\\mathcal{P}(S) = \\big\\{ \\emptyset, \\{1\\}, \\{2\\}, \\{3\\}, \\{ 1,2 \\}, \\{ 1,3 \\}, \\{ 2,3 \\}, \\{ 1,2,3 \\} \\big\\}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186056046 :tutorial/content "Suppose we have a finite set $S$ with cardinality $|S|.$ Then, the cardinality of $\\mathcal P(S)$ is given by\n\n$$\n\\left|\\mathcal{P}(S)\\right| = 2^{\\left| S \\right|}.\n$$\n\nIn other words, a finite set with cardinality $|S|$ has $2^{|S|}$ subsets.\n\nFor example, for the set $S = \\{ a,b,c \\},$ we have $|S| = 3,$ and therefore\n\n$$\n\\left|\\mathcal{P}(S)\\right| = 2^{\\left| S \\right|} = 2^3 = 8.\n$$\n\nThis tells us that $S$ has $8$ subsets, and consequently, $\\mathcal{P}(S)$ has $8$ elements. \n\n$$\n\\mathcal{P}(S) = \\big\\{\n\\underbrace{\\emptyset}_1,\n\\underbrace{ \\{a\\}}_2,\n\\underbrace{ \\{b\\}}_3,\n\\underbrace{ \\{c\\}}_4,\n\\underbrace{ \\{ a,b \\}}_5,\n\\underbrace{ \\{ a,c \\}}_6,\n\\underbrace{ \\{ b,c \\}}_7,\n\\underbrace{ \\{ a,b,c \\}}_8 \n\\big\\}\n$$\n\nNote the following:\n\n- It's clear from our rule that if $S$ is finite, then $\\mathcal P(S)$ is finite.\n\n- It can be shown that if $S$ is infinite, then $\\mathcal P(S)$ is also infinite.\n\nWe'll discuss power sets of infinite sets at the end of this lesson and in future lessons." :db/ensure [:tutorial/validate]} {:db/id 17592186056061 :tutorial/content "In this lesson, our primary focus was on power sets of *finite* sets. The definition of the power set of an *infinite* set mirrors that of finite sets. Namely, it comprises all possible subsets.\n\nAs we already understand, for finite sets, the size of power sets grows exponentially based on the size of the underlying set: \n\n$$\n\\big| \\mathcal{P}(X) \\big| = 2^{|X|}\n$$\n\nWhen dealing with power sets of infinite sets, the situation is more intricate. \n\nFor example, let's consider $\\mathbb{R}^2,$ the set containing all points on the Cartesian plane. What are the elements of the power set $\\mathcal P(\\mathbb R^2)?$\n\nAny collection of points on the plane is a subset of $\\mathbb R^2.$ Such subsets can be visualized as black-and-white images on the plane, where points belonging to the subset are drawn in black, and points not belonging to the subset are represented in white.\n\nFor instance, each of the following images gives us a specific element of $\\mathcal{P}(\\mathbb{R}^2){:}$\n\n![](images/bb/bbdb49640183563e0cb137b3c57095edd8b81bceac4dcda1bf3460371df17930.png)\n\nIt follows that any text, be it any or all existing Math Academy lessons, those planned for the future, or any other possible text (finite or infinite), including those not yet written, are all contained within $\\mathcal{P}(\\mathbb{R}^2).$ \n\n![](images/c4/c47487cf1a7253bfafd5419cd824df30669a575d4b90f3fddc36566e920325bc.png)\n\nIt's somewhat extraordinary that such a vast and important set can be expressed using just the symbols $\\mathcal P(\\mathbb R^2).$" :db/ensure [:tutorial/validate]} {:db/id 17592186054910 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186138428 :knowledge-point/questions ["question-c9a868a0-9ff5-502d-bfb3-d844b4fb7b1e" "question-a55c7de6-c7b2-5322-91c9-db2555bd65eb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138083 :question/problem "Consider the following system of equations:\n\n$$\n\\{\\begin{aligned}x+2y=8 \\\\ 2x-y=6\\end{aligned}\n$$\n\nUse the diagram below to determine this system's solution $(x,y)$.\n\n![](images/6f/6f0b7960b9b4c98250741b009da2ad19c1123c5b7adf9cd5072430fb9a879dc9.png)" :question/worked-solution "The solution of the system corresponds to the point of intersection of the lines. \n\n![](images/5c/5c1c69adc880ea7cfdb5a4e0a10abd6032d2eedf0386923b94df9b7c173edd6d.png)\n\nIn this case, we have the point $(4,2).$ Therefore, the solution to the given system is $(4,2).$" :db/ensure [:question/validate]} {:db/id 17592186138429 :knowledge-point/questions ["question-a3bf32ff-8a8a-5a9c-9ed7-618f0df95533" "question-ca8cc474-a6fd-5f11-ade6-2ba10c4d804f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138084 :question/worked-solution "The pools have the same amount of water when the two graphs intersect.\n\n![](images/cf/cf7a9b8bdccbc66086c473813523ed893ee192830965300a8c4a0702ad065fc3.png)\n\nIn this case, we have the point $(5,400).$ So, both pools have the same amount ($400\\,\\textrm{L}$) of water at $t=5$ days." :db/ensure [:question/validate]} {:db/id "question-c9a868a0-9ff5-502d-bfb3-d844b4fb7b1e" :question/id #uuid "c9a868a0-9ff5-502d-bfb3-d844b4fb7b1e" :question/math-academy-id "q-238028" :question/problem "![](images/02/02ea40d2c1f7b8fc1d5b82a2d04f2f21a6adb0a88fa73e7dc42cbe6664f0c662.png)\n\nConsider the following system of equations:\n\n$$\n\\{\\begin{aligned}5x+y=-20 \\\\ x-y=-4\\end{aligned}\n$$\n\nUse the diagram provided to determine the solution $(x,y)$ of this system.\n\nThe solution is\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "The solution of the system corresponds to the point of intersection of the lines. \n\n![](images/f8/f85c4c0066a850e75910aa3a9fa4330e7c68705e7b19a3e7d1d180cb4052db36.png)\n\nIn this case, we have the point $(-4,0).$ Therefore, the solution to the given system is $(-4,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-92442ae6-dc9e-5db2-8908-41c187dc3802" "answer-field-deb8d3cc-43db-57ee-b058-3bf7f426495b"] :db/ensure [:question/validate]} {:db/id "answer-field-92442ae6-dc9e-5db2-8908-41c187dc3802" :answer-field/id #uuid "92442ae6-dc9e-5db2-8908-41c187dc3802" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0fc914b7-105f-525a-b258-7af2fb8b7248" :answer-field/choices ["answer-0fc914b7-105f-525a-b258-7af2fb8b7248"] :db/ensure [:answer-field/validate]} {:db/id "answer-0fc914b7-105f-525a-b258-7af2fb8b7248" :answer/id #uuid "0fc914b7-105f-525a-b258-7af2fb8b7248" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-field-deb8d3cc-43db-57ee-b058-3bf7f426495b" :answer-field/id #uuid "deb8d3cc-43db-57ee-b058-3bf7f426495b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a34dce4b-39d8-54ff-b6f3-a5af4de7b38b" :answer-field/choices ["answer-a34dce4b-39d8-54ff-b6f3-a5af4de7b38b"] :db/ensure [:answer-field/validate]} {:db/id "answer-a34dce4b-39d8-54ff-b6f3-a5af4de7b38b" :answer/id #uuid "a34dce4b-39d8-54ff-b6f3-a5af4de7b38b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-a55c7de6-c7b2-5322-91c9-db2555bd65eb" :question/id #uuid "a55c7de6-c7b2-5322-91c9-db2555bd65eb" :question/math-academy-id "q-238005" :question/problem "![](images/49/495f9509b35049e62f7f67f8fac64378f5abf77fcef19afe2694b6f774b57b8d.png)\n\nConsider the following system of equations:\n\n$$\n\\{\\begin{aligned}y=2x+1 \\\\ x+y=-5\\end{aligned}\n$$\n\nUse the diagram provided to determine the solution $(x,y)$ of this system.\n\nThe solution is\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "The solution of the system corresponds to the point of intersection of the lines. \n\n![](images/81/8137f53c1e125e3fed67683948f623bbb359a302b6e761cc86f1ccb63f8e9486.png)\n\nIn this case, we have the point $(-2,-3).$ Therefore, the solution to the given system is $(-2,-3).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ca7a4bd-ad35-5201-a6da-2f5ac1196ed0" "answer-field-b40ad16d-7110-51bc-933a-e0c09f683108"] :db/ensure [:question/validate]} {:db/id "answer-field-0ca7a4bd-ad35-5201-a6da-2f5ac1196ed0" :answer-field/id #uuid "0ca7a4bd-ad35-5201-a6da-2f5ac1196ed0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-967d1f0e-7855-5c2c-9ef6-2779d7cff221" :answer-field/choices ["answer-967d1f0e-7855-5c2c-9ef6-2779d7cff221"] :db/ensure [:answer-field/validate]} {:db/id "answer-967d1f0e-7855-5c2c-9ef6-2779d7cff221" :answer/id #uuid "967d1f0e-7855-5c2c-9ef6-2779d7cff221" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-b40ad16d-7110-51bc-933a-e0c09f683108" :answer-field/id #uuid "b40ad16d-7110-51bc-933a-e0c09f683108" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-07812d0b-490d-5ad2-8d6e-bda7d8e3f361" :answer-field/choices ["answer-07812d0b-490d-5ad2-8d6e-bda7d8e3f361"] :db/ensure [:answer-field/validate]} {:db/id "answer-07812d0b-490d-5ad2-8d6e-bda7d8e3f361" :answer/id #uuid "07812d0b-490d-5ad2-8d6e-bda7d8e3f361" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-a3bf32ff-8a8a-5a9c-9ed7-618f0df95533" :question/id #uuid "a3bf32ff-8a8a-5a9c-9ed7-618f0df95533" :question/math-academy-id "q-102519" :question/problem "![](images/1a/1a9b092dbb1a08d4cfc877ab4dc62e68ca90663bc87b810354e4973a90ff8d9a.png)\n\nThe graph above shows the altitude of airplane $A$ and airplane $B$ after they have taken off, one after the other. After how many minutes will both planes be at the same altitude?" :question/worked-solution "Here, we need to find the point of intersection of the two graphs.\n\n![](images/6c/6c0b061e315f7470aa16c034b92592306ca2f56885af03e3e5d6646619c8f02f.png)\n\nIn this case, we have the point $(12,20).$ So, it takes $12$ minutes for both planes to get to the same altitude (of $20,000\\,\\text{ft}$)." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-43721d87-b496-5e15-a547-48275c3223eb"] :db/ensure [:question/validate]} {:db/id "answer-field-43721d87-b496-5e15-a547-48275c3223eb" :answer-field/id #uuid "43721d87-b496-5e15-a547-48275c3223eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc5be401-1db9-577f-abaa-64e6b0582a13" :answer-field/choices ["answer-cc5be401-1db9-577f-abaa-64e6b0582a13" "answer-d0be3572-171d-5d71-b61e-85a14b9758f4" "answer-e314fbb2-9d20-57e5-adf7-cd144decb4de" "answer-b254f926-d589-50ae-b341-6ebc93724448" "answer-0f144b51-08aa-5ffe-b091-e27424160a32"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc5be401-1db9-577f-abaa-64e6b0582a13" :answer/id #uuid "cc5be401-1db9-577f-abaa-64e6b0582a13" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-d0be3572-171d-5d71-b61e-85a14b9758f4" :answer/id #uuid "d0be3572-171d-5d71-b61e-85a14b9758f4" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-e314fbb2-9d20-57e5-adf7-cd144decb4de" :answer/id #uuid "e314fbb2-9d20-57e5-adf7-cd144decb4de" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-b254f926-d589-50ae-b341-6ebc93724448" :answer/id #uuid "b254f926-d589-50ae-b341-6ebc93724448" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-0f144b51-08aa-5ffe-b091-e27424160a32" :answer/id #uuid "0f144b51-08aa-5ffe-b091-e27424160a32" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-ca8cc474-a6fd-5f11-ade6-2ba10c4d804f" :question/id #uuid "ca8cc474-a6fd-5f11-ade6-2ba10c4d804f" :question/math-academy-id "q-237989" :question/problem "![](images/45/4534ed02abf6740df78c3285292e7235391bc76352e16cfdcd2a149dfc7046c4.png)\n\nWater is being pumped from tank $A$ to tank $B.$ The graph above shows the amount of water (in liters) in each tank as a function of time (in minutes). At what time do tanks $A$ and $B$ contain the same amount of water?\n\nThe tanks contain the same amount of water after{{field-1}}minutes." :question/worked-solution "The tanks contain the same amount when the two graphs intersect.\n\n![](images/23/23efe932ef71f93f3a455a93bda45ded7e44b059853308f6d760a4df4bc7d349.png)\n\nIn this case, we have the point $(4,15).$ So, the tanks contain the same amount ($15\\,\\text{L}$) of water after $t=4$ minutes." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8ef33cc4-fb24-544f-9ed0-f50976bb0e51"] :db/ensure [:question/validate]} {:db/id "answer-field-8ef33cc4-fb24-544f-9ed0-f50976bb0e51" :answer-field/id #uuid "8ef33cc4-fb24-544f-9ed0-f50976bb0e51" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bb2a30ae-1ed6-57e5-9b9b-bfdb69e70b5d" :answer-field/choices ["answer-bb2a30ae-1ed6-57e5-9b9b-bfdb69e70b5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb2a30ae-1ed6-57e5-9b9b-bfdb69e70b5d" :answer/id #uuid "bb2a30ae-1ed6-57e5-9b9b-bfdb69e70b5d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186139667 :tutorial/content "Suppose that we want to know the values of $x$ and $y$ that satisfy *both* of the equations\n\n$$\n\\{\\begin{aligned}x-y=-4 \\\\ 6x-y=6.\\end{aligned}\n$$\n\nWe call this a **system of linear equations**. The equations of the system define two straight lines, so we can visualize the system by plotting both lines on the same graph.\n\n![](images/59/59f16d57e74fd94fdab464eca22cea1271b19a3b78114446e31343cfabd15a12.png)\n\nThe solution of the system corresponds to the point where the two lines intersect. In this case, it is the point $(2,6)$, as shown above. So $x=2$ and $y=6$ form the **solution** to the system. We can write the solution as the ordered pair $(2, 6).$\n\nWhenever we find a solution to a system of equations, it is a good idea to double-check our result. To check that the solution $x=2,y=6$ is the correct solution, we substitute our solution into *both* of the equations. \n\nLet's check the first equation.\n\n$$\n\\begin{aligned}x-y & \\,=\\,-4 \\\\ (2)-(6) & =-4 \\\\ -4 & =-4\\,✓\\end{aligned}\n$$\n\nNow we check the second equation:\n\n$$\n\\begin{aligned}6x-y & \\,=\\,6 \\\\ 6(2)-6 & =6 \\\\ 6 & =6\\,✓\\end{aligned}\n$$\n\nSince $x=2$ and $y=6$ satisfied *both* equations, it is indeed the solution to the system of equations." :db/ensure [:tutorial/validate]} {:db/id 17592186138586 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186307570 :answer-field/correct "answer-93728e3d-4732-5ef6-8a21-7fde64d07dcd" :answer-field/choices ["answer-93728e3d-4732-5ef6-8a21-7fde64d07dcd"] :db/ensure [:answer-field/validate]} {:db/id "answer-93728e3d-4732-5ef6-8a21-7fde64d07dcd" :answer/id #uuid "93728e3d-4732-5ef6-8a21-7fde64d07dcd" :answer/type :answer.type/math :answer/value "48t^2(4t^3-1)" :db/ensure [:answer/validate]} {:db/id 17592186307741 :answer-field/correct "answer-6325146b-ac91-512c-88e2-d5557a7035bf" :answer-field/choices ["answer-6325146b-ac91-512c-88e2-d5557a7035bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-6325146b-ac91-512c-88e2-d5557a7035bf" :answer/id #uuid "6325146b-ac91-512c-88e2-d5557a7035bf" :answer/type :answer.type/math :answer/value "1+e^t" :db/ensure [:answer/validate]} {:db/id "activity-3fc4b6f4-448c-556a-9808-6a0a8e96a629" :activity/id #uuid "3fc4b6f4-448c-556a-9808-6a0a8e96a629" :activity/title "Differentiating Under the Integral Sign" :activity/type :activity.type/review :activity/scope 17592186048817 :activity/course 17592186046659 :activity/steps ["step-2682eeb7-9303-5555-aa81-d4f1b1bc53e1" "step-e52f37a8-a447-5f85-8c13-490937937ec2" "step-b8e332a4-d8ae-569b-9c08-56ffd9814faa" "step-90fefbca-de6e-5ca6-b465-c9d927b723d9"] :activity/first-step "step-2682eeb7-9303-5555-aa81-d4f1b1bc53e1" :db/ensure [:activity/validate]} {:db/id "step-2682eeb7-9303-5555-aa81-d4f1b1bc53e1" :step/id #uuid "2682eeb7-9303-5555-aa81-d4f1b1bc53e1" :step/content 17592186308705 :step/next "step-e52f37a8-a447-5f85-8c13-490937937ec2" :db/ensure [:step/validate]} {:db/id "step-e52f37a8-a447-5f85-8c13-490937937ec2" :step/id #uuid "e52f37a8-a447-5f85-8c13-490937937ec2" :step/content 17592186229676 :step/next "step-b8e332a4-d8ae-569b-9c08-56ffd9814faa" :db/ensure [:step/validate]} {:db/id "step-b8e332a4-d8ae-569b-9c08-56ffd9814faa" :step/id #uuid "b8e332a4-d8ae-569b-9c08-56ffd9814faa" :step/content 17592186311551 :step/next "step-90fefbca-de6e-5ca6-b465-c9d927b723d9" :db/ensure [:step/validate]} {:db/id "step-90fefbca-de6e-5ca6-b465-c9d927b723d9" :step/id #uuid "90fefbca-de6e-5ca6-b465-c9d927b723d9" :step/content 17592186311555 :db/ensure [:step/validate]}]
