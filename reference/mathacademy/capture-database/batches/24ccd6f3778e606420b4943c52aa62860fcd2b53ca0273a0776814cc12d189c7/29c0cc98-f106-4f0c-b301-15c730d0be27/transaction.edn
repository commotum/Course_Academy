0521b20e8c1" "question-e49f5076-911d-5cdf-8140-a000de972953"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179585 :question/problem "Which of the following are partitions of the real interval $[1,9]?$\n\nI. $\\{1, 4, 5, 8\\}$\n\nII. $\\{1, 3, 4, 9\\}$\n\nIII. $1 <     2  <    9$" :db/ensure [:question/validate]} {:db/id 17592186179720 :knowledge-point/questions ["question-28824d9b-0c0b-596c-9f64-75c745081e48" "question-f1ddbd77-4be4-59b3-aa0d-217f8714ae20"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179721 :knowledge-point/questions ["question-1bfa03d7-9352-51b2-9697-231f8df40ac5" "question-8a05e0a6-f018-5eeb-9fa0-754bde9f9f75" "question-785f4fec-653e-532c-a878-3835d225527c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179976 :question/problem "Which of the following are partitions of the real interval $[1,8]?$\n\nI. $1<2<4<8$\n\nII. $\\{1,3,4,8\\}$\n\nIII. $\\{2,4,8\\}$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[1,8].$\n\n- Statement II is a partition of $[1,8].$\n\n- Statement III is not a partition of $[1,8]$ since it does not include the left endpoint $a=1.$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186177525 :answer-field/correct 17592186177526 :answer-field/choices ["answer-eb4418cf-cb76-5ba5-8c96-25fcc0a22bab"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb4418cf-cb76-5ba5-8c96-25fcc0a22bab" :answer/id #uuid "eb4418cf-cb76-5ba5-8c96-25fcc0a22bab" :answer/type :answer.type/text :answer/value "None of the statements give a partition of $[1,8]$" :db/ensure [:answer/validate]} {:db/id "question-84a42ed7-7cdb-52df-a889-40521b20e8c1" :question/id #uuid "84a42ed7-7cdb-52df-a889-40521b20e8c1" :question/math-academy-id "q-122930" :question/problem "Which of the following are partitions of the real interval $[4,8]?$\n\nI. $4<6<8$\n\nII. $5<6<7<8$\n\nIII. $4<5<6<7$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[4,8].$\n\n- Statement II is not a partition of $[4,8]$ since it does not include the left endpoint $a=4.$\n\n- Statement III is not a partition of $[4,8]$ since it does not include the right endpoint $b=8.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-97615891-a50f-5ff1-b957-2fefa73efcae"] :db/ensure [:question/validate]} {:db/id "answer-field-97615891-a50f-5ff1-b957-2fefa73efcae" :answer-field/id #uuid "97615891-a50f-5ff1-b957-2fefa73efcae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-99d35ace-ff4e-55ea-8ebe-8efeba21fc3b" :answer-field/choices ["answer-4650d883-0024-5fb8-8a3b-926b85faeb7b" "answer-99d35ace-ff4e-55ea-8ebe-8efeba21fc3b" "answer-91e31bb5-4dda-578c-be6e-626d6d5b43b0" "answer-a79fcbcd-1c42-57fb-8ad9-6ece2081ead7" "answer-962aff86-8fb7-5334-ab89-1ce2ce31f5a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-4650d883-0024-5fb8-8a3b-926b85faeb7b" :answer/id #uuid "4650d883-0024-5fb8-8a3b-926b85faeb7b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-99d35ace-ff4e-55ea-8ebe-8efeba21fc3b" :answer/id #uuid "99d35ace-ff4e-55ea-8ebe-8efeba21fc3b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-91e31bb5-4dda-578c-be6e-626d6d5b43b0" :answer/id #uuid "91e31bb5-4dda-578c-be6e-626d6d5b43b0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-a79fcbcd-1c42-57fb-8ad9-6ece2081ead7" :answer/id #uuid "a79fcbcd-1c42-57fb-8ad9-6ece2081ead7" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-962aff86-8fb7-5334-ab89-1ce2ce31f5a1" :answer/id #uuid "962aff86-8fb7-5334-ab89-1ce2ce31f5a1" :answer/type :answer.type/text :answer/value "None of the statements give a partition of $[4,8]$" :db/ensure [:answer/validate]} {:db/id "question-e49f5076-911d-5cdf-8140-a000de972953" :question/id #uuid "e49f5076-911d-5cdf-8140-a000de972953" :question/math-academy-id "q-122934" :question/problem "Which of the following are partitions of the real interval $[0,6]?$\n\nI. $0<2<4<8$\n\nII. $\\{0,3,6\\}$\n\nIII. $0<1<3<5<6$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[0,6]$ since $8$ does not belong to $[0,6].$\n\n- Statement II is a partition of $[0,6].$\n\n- Statement III is a partition of $[0,6].$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2b6f0340-20ad-55e8-b95b-71619bc5062f"] :db/ensure [:question/validate]} {:db/id "answer-field-2b6f0340-20ad-55e8-b95b-71619bc5062f" :answer-field/id #uuid "2b6f0340-20ad-55e8-b95b-71619bc5062f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-15b01046-18e1-58bb-9aae-addee4a5482b" :answer-field/choices ["answer-79640bcf-217a-5e27-aca2-3c90383899ae" "answer-84c6b261-478a-5a3c-8af3-eb635d34e070" "answer-15b01046-18e1-58bb-9aae-addee4a5482b" "answer-cc89bb28-0e81-56bc-b07d-003f53e45ba1" "answer-9e84a909-3d25-5602-9873-2133f303f3b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-79640bcf-217a-5e27-aca2-3c90383899ae" :answer/id #uuid "79640bcf-217a-5e27-aca2-3c90383899ae" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-84c6b261-478a-5a3c-8af3-eb635d34e070" :answer/id #uuid "84c6b261-478a-5a3c-8af3-eb635d34e070" :answer/type :answer.type/text :answer/value "II  only" :db/ensure [:answer/validate]} {:db/id "answer-15b01046-18e1-58bb-9aae-addee4a5482b" :answer/id #uuid "15b01046-18e1-58bb-9aae-addee4a5482b" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-cc89bb28-0e81-56bc-b07d-003f53e45ba1" :answer/id #uuid "cc89bb28-0e81-56bc-b07d-003f53e45ba1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-9e84a909-3d25-5602-9873-2133f303f3b4" :answer/id #uuid "9e84a909-3d25-5602-9873-2133f303f3b4" :answer/type :answer.type/text :answer/value "None of the statements give a partition of $[0,6]$" :db/ensure [:answer/validate]} {:db/id "question-28824d9b-0c0b-596c-9f64-75c745081e48" :question/id #uuid "28824d9b-0c0b-596c-9f64-75c745081e48" :question/math-academy-id "q-122969" :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[2,8].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}Δ{x}_{i}.$" :question/worked-solution "Note that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[2,8],$ because\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =({x}_{1}-{x}_{0})+({x}_{2}-{x}_{1})+({x}_{3}-{x}_{2})+⋯+({x}_{m}-{x}_{m-1}) \\\\  & =(\\cancel{{x}_{1}}-{x}_{0})+(\\cancel{{x}_{2}}-\\cancel{{x}_{1}})+(\\cancel{{x}_{3}}-\\cancel{{x}_{2}})+⋯+({x}_{m}-\\cancel{{x}_{m-1}}) \\\\  & =-{x}_{0}+{x}_{m} \\\\  & ={x}_{m}-{x}_{0} \\\\  & =8-2 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-da6d1a46-d11c-5863-8635-3e515e9d04b1"] :db/ensure [:question/validate]} {:db/id "answer-field-da6d1a46-d11c-5863-8635-3e515e9d04b1" :answer-field/id #uuid "da6d1a46-d11c-5863-8635-3e515e9d04b1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6dbdbd0b-c1a2-51c0-a8f5-15cb04158568" :answer-field/choices ["answer-d6c61e9b-6f94-5835-aa08-0cb0ef8d2485" "answer-929a1813-87ee-5a94-b302-53b3394322ee" "answer-960de9e7-c3d1-548d-bb28-aea79c7b0d3b" "answer-6dbdbd0b-c1a2-51c0-a8f5-15cb04158568" "answer-d15c5ee3-1df2-5a89-801e-42aef64a0cac"] :db/ensure [:answer-field/validate]} {:db/id "answer-d6c61e9b-6f94-5835-aa08-0cb0ef8d2485" :answer/id #uuid "d6c61e9b-6f94-5835-aa08-0cb0ef8d2485" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-929a1813-87ee-5a94-b302-53b3394322ee" :answer/id #uuid "929a1813-87ee-5a94-b302-53b3394322ee" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-960de9e7-c3d1-548d-bb28-aea79c7b0d3b" :answer/id #uuid "960de9e7-c3d1-548d-bb28-aea79c7b0d3b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-6dbdbd0b-c1a2-51c0-a8f5-15cb04158568" :answer/id #uuid "6dbdbd0b-c1a2-51c0-a8f5-15cb04158568" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-d15c5ee3-1df2-5a89-801e-42aef64a0cac" :answer/id #uuid "d15c5ee3-1df2-5a89-801e-42aef64a0cac" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-f1ddbd77-4be4-59b3-aa0d-217f8714ae20" :question/id #uuid "f1ddbd77-4be4-59b3-aa0d-217f8714ae20" :question/math-academy-id "q-122971" :question/problem "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[-5,5].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}Δ{y}_{j}.$" :question/worked-solution "Note that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[-5,5],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =5-(-5) \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ee43f80-f80a-52f4-830f-025c4b4ca95b"] :db/ensure [:question/validate]} {:db/id "answer-field-0ee43f80-f80a-52f4-830f-025c4b4ca95b" :answer-field/id #uuid "0ee43f80-f80a-52f4-830f-025c4b4ca95b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-07195f6c-4e48-5dcc-aec2-5d69c56026d6" :answer-field/choices ["answer-07195f6c-4e48-5dcc-aec2-5d69c56026d6" "answer-5665712a-009d-5af0-a804-20166b15f257" "answer-f878e57d-c65e-5d5e-8918-ff905b1034b8" "answer-ff90e828-6c3f-5567-ad48-f5f15d008572" "answer-916a6352-92eb-5096-b435-cd193b6feb37"] :db/ensure [:answer-field/validate]} {:db/id "answer-07195f6c-4e48-5dcc-aec2-5d69c56026d6" :answer/id #uuid "07195f6c-4e48-5dcc-aec2-5d69c56026d6" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-5665712a-009d-5af0-a804-20166b15f257" :answer/id #uuid "5665712a-009d-5af0-a804-20166b15f257" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-f878e57d-c65e-5d5e-8918-ff905b1034b8" :answer/id #uuid "f878e57d-c65e-5d5e-8918-ff905b1034b8" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-ff90e828-6c3f-5567-ad48-f5f15d008572" :answer/id #uuid "ff90e828-6c3f-5567-ad48-f5f15d008572" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-916a6352-92eb-5096-b435-cd193b6feb37" :answer/id #uuid "916a6352-92eb-5096-b435-cd193b6feb37" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186256762 :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[4,9].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}7Δ{z}_{k}.$" :db/ensure [:question/validate]} {:db/id 17592186256761 :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[2,10].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}-4Δ{x}_{i}.$" :db/ensure [:question/validate]} {:db/id 17592186179974 :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[0,3].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}5Δ{x}_{i}.$" :db/ensure [:question/validate]} {:db/id "question-1bfa03d7-9352-51b2-9697-231f8df40ac5" :question/id #uuid "1bfa03d7-9352-51b2-9697-231f8df40ac5" :question/math-academy-id "q-122989" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-4,-2].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" :question/worked-solution "We can simplify the given summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-4$ and ${z}_{q}=-2$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & =(-2)^{2}-(-4)^{2} \\\\  & =-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4c5455b8-9a9d-5129-b786-a83ab740510c"] :db/ensure [:question/validate]} {:db/id "answer-field-4c5455b8-9a9d-5129-b786-a83ab740510c" :answer-field/id #uuid "4c5455b8-9a9d-5129-b786-a83ab740510c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebe90562-cdd2-5780-939d-bc592f3ec852" :answer-field/choices ["answer-f34d9a61-167a-51a4-ad53-fbf35898e99a" "answer-ebe90562-cdd2-5780-939d-bc592f3ec852" "answer-7ea547c4-139e-5f3e-b342-d36b9f80ab00" "answer-9e97d679-8620-566e-aef5-b860139a2b3b" "answer-defd9c97-e8e8-51b6-b6df-85204c78bae5"] :db/ensure [:answer-field/validate]} {:db/id "answer-f34d9a61-167a-51a4-ad53-fbf35898e99a" :answer/id #uuid "f34d9a61-167a-51a4-ad53-fbf35898e99a" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-ebe90562-cdd2-5780-939d-bc592f3ec852" :answer/id #uuid "ebe90562-cdd2-5780-939d-bc592f3ec852" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-7ea547c4-139e-5f3e-b342-d36b9f80ab00" :answer/id #uuid "7ea547c4-139e-5f3e-b342-d36b9f80ab00" :answer/type :answer.type/math :answer/value "-14" :db/ensure [:answer/validate]} {:db/id "answer-9e97d679-8620-566e-aef5-b860139a2b3b" :answer/id #uuid "9e97d679-8620-566e-aef5-b860139a2b3b" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "answer-defd9c97-e8e8-51b6-b6df-85204c78bae5" :answer/id #uuid "defd9c97-e8e8-51b6-b6df-85204c78bae5" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id 17592186256768 :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-2,4].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" :db/ensure [:question/validate]} {:db/id "question-8a05e0a6-f018-5eeb-9fa0-754bde9f9f75" :question/id #uuid "8a05e0a6-f018-5eeb-9fa0-754bde9f9f75" :question/math-academy-id "q-122993" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[2,6].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}\\frac{({z}_{k}+{z}_{k-1})}{2}Δ{z}_{k}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{k=1}^{q}\\frac{({z}_{k}+{z}_{k-1})}{2}Δ{z}_{k}=\\frac{1}{2}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.\n$$\n\nWe can simplify the summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=2$ and ${z}_{q}=6$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={6}^{2}-{2}^{2} \\\\  & =32.\\end{aligned}\n$$\n\n  \n\nFinally, we have\n\n$$\n\\frac{1}{2}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}=\\frac{1}{2}\\cdot 32=16.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e8508966-666d-5767-9f3e-6f1a14747298"] :db/ensure [:question/validate]} {:db/id "answer-field-e8508966-666d-5767-9f3e-6f1a14747298" :answer-field/id #uuid "e8508966-666d-5767-9f3e-6f1a14747298" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bb600cb6-7d76-5292-a580-58d7c9f435f9" :answer-field/choices ["answer-1bfa3377-49dd-5c01-9f92-6c06b6561a19" "answer-bb600cb6-7d76-5292-a580-58d7c9f435f9" "answer-759843ef-ad38-5c40-b7cb-3f8900a9347d" "answer-3c274b0a-1fe7-5023-be4b-fa97d2764212" "answer-7a6913dc-7a10-5568-8db9-9fb86dab5d97"] :db/ensure [:answer-field/validate]} {:db/id "answer-1bfa3377-49dd-5c01-9f92-6c06b6561a19" :answer/id #uuid "1bfa3377-49dd-5c01-9f92-6c06b6561a19" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-bb600cb6-7d76-5292-a580-58d7c9f435f9" :answer/id #uuid "bb600cb6-7d76-5292-a580-58d7c9f435f9" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-759843ef-ad38-5c40-b7cb-3f8900a9347d" :answer/id #uuid "759843ef-ad38-5c40-b7cb-3f8900a9347d" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-3c274b0a-1fe7-5023-be4b-fa97d2764212" :answer/id #uuid "3c274b0a-1fe7-5023-be4b-fa97d2764212" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-7a6913dc-7a10-5568-8db9-9fb86dab5d97" :answer/id #uuid "7a6913dc-7a10-5568-8db9-9fb86dab5d97" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "question-785f4fec-653e-532c-a878-3835d225527c" :question/id #uuid "785f4fec-653e-532c-a878-3835d225527c" :question/math-academy-id "q-122994" :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[1,10].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}2({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}2({x}_{i}+{x}_{i-1})Δ{x}_{i}=2{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{m} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=1$ and ${x}_{m}=10$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={10}^{2}-{1}^{2} \\\\  & =99.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n2{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}=2\\cdot 99=198.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-df659612-579e-586d-b30d-ba9a4e631fa2"] :db/ensure [:question/validate]} {:db/id "answer-field-df659612-579e-586d-b30d-ba9a4e631fa2" :answer-field/id #uuid "df659612-579e-586d-b30d-ba9a4e631fa2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8c1fe78-e46c-5dc7-811d-7c100ded5e0e" :answer-field/choices ["answer-3e17c7a9-6c99-5817-8972-75e58e23f040" "answer-a8cc2c6a-d627-5733-9397-df08623f6047" "answer-3fa8eabe-8df9-5652-9574-6fce6e9ce159" "answer-f8c1fe78-e46c-5dc7-811d-7c100ded5e0e" "answer-154c6ccd-afa9-5d6e-b30d-795512a973b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-3e17c7a9-6c99-5817-8972-75e58e23f040" :answer/id #uuid "3e17c7a9-6c99-5817-8972-75e58e23f040" :answer/type :answer.type/math :answer/value "190" :db/ensure [:answer/validate]} {:db/id "answer-a8cc2c6a-d627-5733-9397-df08623f6047" :answer/id #uuid "a8cc2c6a-d627-5733-9397-df08623f6047" :answer/type :answer.type/math :answer/value "192" :db/ensure [:answer/validate]} {:db/id "answer-3fa8eabe-8df9-5652-9574-6fce6e9ce159" :answer/id #uuid "3fa8eabe-8df9-5652-9574-6fce6e9ce159" :answer/type :answer.type/math :answer/value "196" :db/ensure [:answer/validate]} {:db/id "answer-f8c1fe78-e46c-5dc7-811d-7c100ded5e0e" :answer/id #uuid "f8c1fe78-e46c-5dc7-811d-7c100ded5e0e" :answer/type :answer.type/math :answer/value "198" :db/ensure [:answer/validate]} {:db/id "answer-154c6ccd-afa9-5d6e-b30d-795512a973b4" :answer/id #uuid "154c6ccd-afa9-5d6e-b30d-795512a973b4" :answer/type :answer.type/math :answer/value "200" :db/ensure [:answer/validate]} {:db/id 17592186179975 :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[0,2].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" :db/ensure [:question/validate]} {:db/id 17592186179851 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186069301 :question/problem "![](images/cd/cd878559d6be37faa60bdb33cbebe2f124d09744aa4df7dae40372499116f239.png)\n\nWhat is the length of $\\overset{―}{CD}?$" :question/worked-solution "From the figure, we note that the points $C$ and $D$ have coordinates ${{(-5,3)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(2,-1)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively.\n\nTo find the length of $\\overset{―}{CD},$ we use the distance formula:\n\n$$\n\\begin{aligned}CD & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-5))^{2}+(-1-3)^{2}} \\\\  & =\\sqrt{(7)^{2}+(-4)^{2}} \\\\  & =\\sqrt{49+16} \\\\  & =\\sqrt{65}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186066976 :answer-field/correct 17592186066981 :db/ensure [:answer-field/validate]} {:db/id 17592186068721 :knowledge-point/questions ["question-9dd278e6-83f6-5c4b-b1f1-6a6ae9e2e467"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9dd278e6-83f6-5c4b-b1f1-6a6ae9e2e467" :question/id #uuid "9dd278e6-83f6-5c4b-b1f1-6a6ae9e2e467" :question/math-academy-id "q-119011" :question/problem "What is the distance between the points $(-4\\sqrt{5},-2\\sqrt{5})$ and $(\\sqrt{5},-12\\sqrt{5})?$" :question/worked-solution "In this case, we have ${{(-4\\sqrt{5},-2\\sqrt{5})}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(\\sqrt{5},-12\\sqrt{5})}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\nSo, the distance $d$ can be calculated using the distance formula, as follows:\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{{(\\sqrt{5}-(-4\\sqrt{5}))}^{2}+{(-12\\sqrt{5}-(-2\\sqrt{5}))}^{2}} \\\\  & =\\sqrt{(5\\sqrt{5})^{2}+(-10\\sqrt{5})^{2}} \\\\  & =\\sqrt{25(5)+100(5)} \\\\  & =\\sqrt{125+500} \\\\  & =\\sqrt{625} \\\\  & =25\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8db667e4-c6ff-50ef-bf4d-33616aab5cf2"] :db/ensure [:question/validate]} {:db/id "answer-field-8db667e4-c6ff-50ef-bf4d-33616aab5cf2" :answer-field/id #uuid "8db667e4-c6ff-50ef-bf4d-33616aab5cf2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ebbeab2f-2e72-502f-8588-62b91c0340f5" :answer-field/choices ["answer-7c2e9f91-d463-5286-9ed4-c97a3b93b2bc" "answer-ebbeab2f-2e72-502f-8588-62b91c0340f5" "answer-5c855929-b300-53bb-b2f5-24705e47b13c" "answer-c60b17ee-f26e-5eec-9f8d-f02e776c1ea8" "answer-6221fb69-119d-504d-b579-13f039a770b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c2e9f91-d463-5286-9ed4-c97a3b93b2bc" :answer/id #uuid "7c2e9f91-d463-5286-9ed4-c97a3b93b2bc" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-ebbeab2f-2e72-502f-8588-62b91c0340f5" :answer/id #uuid "ebbeab2f-2e72-502f-8588-62b91c0340f5" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-5c855929-b300-53bb-b2f5-24705e47b13c" :answer/id #uuid "5c855929-b300-53bb-b2f5-24705e47b13c" :answer/type :answer.type/math :answer/value "5\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-c60b17ee-f26e-5eec-9f8d-f02e776c1ea8" :answer/id #uuid "c60b17ee-f26e-5eec-9f8d-f02e776c1ea8" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-6221fb69-119d-504d-b579-13f039a770b9" :answer/id #uuid "6221fb69-119d-504d-b579-13f039a770b9" :answer/type :answer.type/math :answer/value "\\sqrt{65}" :db/ensure [:answer/validate]} {:db/id "question-10bae273-6993-5b75-9a9e-139dcefc8633" :question/id #uuid "10bae273-6993-5b75-9a9e-139dcefc8633" :question/math-academy-id "q-216294" :question/problem "![](images/94/941efa39e90b946e68ea9ccc65ab7b97f4fce84d1cccbaa19135f8c87383a22f.png)\n\nThe exact length of $\\overset{―}{AB}$ is{{field-1}}." :question/worked-solution "From the figure, we note that the points $A$ and $B$ have coordinates ${{(-2,3)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(2,7)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})},$ respectively.\n\nTo find the length of $\\overset{―}{AB},$ we use the distance formula:\n\n$$\n\\begin{aligned}AB & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-2))^{2}+(7-3)^{2}} \\\\  & =\\sqrt{{4}^{2}+{4}^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =\\sqrt{32} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-69167d57-152a-5b5e-a04c-0fa20c63b0b4"] :db/ensure [:question/validate]} {:db/id "answer-field-69167d57-152a-5b5e-a04c-0fa20c63b0b4" :answer-field/id #uuid "69167d57-152a-5b5e-a04c-0fa20c63b0b4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a941df4e-944d-5b40-96d0-15089e219a36" :answer-field/choices ["answer-a941df4e-944d-5b40-96d0-15089e219a36"] :db/ensure [:answer-field/validate]} {:db/id "answer-a941df4e-944d-5b40-96d0-15089e219a36" :answer/id #uuid "a941df4e-944d-5b40-96d0-15089e219a36" :answer/type :answer.type/math :answer/value "4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "activity-04dd10aa-617a-57e9-9def-004b4d0d2ea1" :activity/id #uuid "04dd10aa-617a-57e9-9def-004b4d0d2ea1" :activity/title "The Distance Formula" :activity/type :activity.type/review :activity/scope 17592186050975 :activity/course 17592186046647 :activity/steps ["step-31a02459-846b-594d-a08e-bf91b9b551fd" "step-31c22abb-16d4-5821-a52d-1bfe8c5323e2" "step-6cdce9b7-05c1-5e9f-8efe-1d31cef1a31b"] :activity/first-step "step-31a02459-846b-594d-a08e-bf91b9b551fd" :db/ensure [:activity/validate]} {:db/id "step-31a02459-846b-594d-a08e-bf91b9b551fd" :step/id #uuid "31a02459-846b-594d-a08e-bf91b9b551fd" :step/content 17592186069301 :step/next "step-31c22abb-16d4-5821-a52d-1bfe8c5323e2" :db/ensure [:step/validate]} {:db/id "step-31c22abb-16d4-5821-a52d-1bfe8c5323e2" :step/id #uuid "31c22abb-16d4-5821-a52d-1bfe8c5323e2" :step/content "question-9dd278e6-83f6-5c4b-b1f1-6a6ae9e2e467" :step/next "step-6cdce9b7-05c1-5e9f-8efe-1d31cef1a31b" :db/ensure [:step/validate]} {:db/id "step-6cdce9b7-05c1-5e9f-8efe-1d31cef1a31b" :step/id #uuid "6cdce9b7-05c1-5e9f-8efe-1d31cef1a31b" :step/content "question-10bae273-6993-5b75-9a9e-139dcefc8633" :db/ensure [:step/validate]} {:db/id 17592186162360 :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $5,$ $3,$ and $0,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $5,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=5\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{5}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{5}.$" :db/ensure [:question/validate]} {:db/id 17592186412767 :question/problem "A $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ Given that the eigenvalues of ${A}^{T}A$ are $11$ and $4,$ find the length of the ellipse's semi-major axis." :question/worked-solution "The matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$\n\nSince the largest eigenvalue of ${A}^{T}A$ is $11,$ we obtain\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}=11\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=\\sqrt{11}.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is $\\sqrt{11}.$" :db/ensure [:question/validate]} {:db/id 17592186369741 :question/problem "A $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ Given that the singular values of $A$ are ${\\sigma }_{1}=8,$ ${\\sigma }_{2}=2\\sqrt{5},$ and ${\\sigma }_{3}=0,$ find the length of the semi-major axis of the ellipse." :question/worked-solution "The matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto the ellipse $\\{Ax\\,|\\,‖x‖=1\\}$ in ${R}^{2}.$\n\nFirst, let's re-write the squared distance from the origin to the point $Ax$ on our ellipse, as follows:\n\n$$\n\\begin{aligned}‖Ax{‖}^{2} & =(Ax)^{T}(Ax) \\\\  & =({x}^{T}\\,{A}^{T})(Ax) \\\\  & ={x}^{T}\\,({A}^{T}\\,A)x,\\end{aligned}\n$$\n\n  \n\nwhere ${x}^{T}({A}^{T}A)x$ is the quadratic form with the symmetric matrix ${A}^{T}A.$ \n\nThe maximum value of this quadratic form, when $‖x‖=1,$ is equal to the largest eigenvalue of the matrix ${A}^{T}A.$ \n\nThe square roots of the eigenvalues of ${A}^{T}A$ are called the *singular values* of $A.$ Since the largest singular value of $A$ is ${\\sigma }_{1}=8,$ the largest eigenvalue of ${A}^{T}A$ must be ${\\lambda }_{1}={\\sigma }_{1}^{2}={8}^{2}.$ So, we obtain that\n\n$$\n{max}_{‖x‖=1}\\{‖Ax{‖}^{2}\\}={8}^{2}\\,⟹\\,{max}_{‖x‖=1}\\{‖Ax‖\\}=8.\n$$\n\n \n\nTherefore, the semi-major axis of our ellipse is ${\\sigma }_{1}=8.$" :db/ensure [:question/validate]} {:db/id 17592186269244 :question/problem "![](images/d4/d4947e37239d2ac2950b536d7afc2d0810ea713c437b7095a43e123d50ff2b34.png)\n\nA $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ what are the nonzero singular values of $A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=8={\\sigma }_{1},$ and\n\n- $||A{v}_{2}||=5={\\sigma }_{2}.$\n\nTherefore, the nonzero singular values of $A$ are ${\\sigma }_{1}=8$ and ${\\sigma }_{2}=5.$" :db/ensure [:question/validate]} {:db/id 17592186383431 :question/problem "![](images/63/63d5de8c08559ecc88b4fd7e2184204a1e6ea2f8a9e8ca6af7959e2354876e3f.png)\n\nA $2\\times 2$ matrix $A$ maps the unit circle $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{2}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ which of the following is an eigenvector corresponding to the eigenvalue $9$ of ${A}^{T}A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=5={\\sigma }_{1},$ which means that ${\\lambda }_{1}={5}^{2}=25,$ and\n\n- $||A{v}_{2}||=3={\\sigma }_{2},$ which means that ${\\lambda }_{2}={3}^{2}=9.$\n\nTherefore, an eigenvector corresponding to the eigenvalue ${\\lambda }_{2}=9$ of ${A}^{T}A$ is ${v}_{2}.$" :db/ensure [:question/validate]} {:db/id "activity-eb21dc6b-2d80-592a-b7a0-6c3fee156a8e" :activity/id #uuid "eb21dc6b-2d80-592a-b7a0-6c3fee156a8e" :activity/title "The Singular Values of a Matrix" :activity/type :activity.type/review :activity/scope 17592186050205 :activity/course 17592186046658 :activity/steps ["step-8e86f3d8-3c6b-5dfb-8619-654db11074d9" "step-4b60e7be-0a56-5bba-9861-738aac8f8ee4" "step-9ba70a3c-71a0-5cb6-a4db-f475dda224da" "step-9127aacb-30a9-55a4-8d76-24d419b593cf" "step-c2b79e93-d3ce-53a6-844f-76207ef1c04e"] :activity/first-step "step-8e86f3d8-3c6b-5dfb-8619-654db11074d9" :db/ensure [:activity/validate]} {:db/id "step-8e86f3d8-3c6b-5dfb-8619-654db11074d9" :step/id #uuid "8e86f3d8-3c6b-5dfb-8619-654db11074d9" :step/content 17592186162360 :step/next "step-4b60e7be-0a56-5bba-9861-738aac8f8ee4" :db/ensure [:step/validate]} {:db/id "step-4b60e7be-0a56-5bba-9861-738aac8f8ee4" :step/id #uuid "4b60e7be-0a56-5bba-9861-738aac8f8ee4" :step/content 17592186412767 :step/next "step-9ba70a3c-71a0-5cb6-a4db-f475dda224da" :db/ensure [:step/validate]} {:db/id "step-9ba70a3c-71a0-5cb6-a4db-f475dda224da" :step/id #uuid "9ba70a3c-71a0-5cb6-a4db-f475dda224da" :step/content 17592186369741 :step/next "step-9127aacb-30a9-55a4-8d76-24d419b593cf" :db/ensure [:step/validate]} {:db/id "step-9127aacb-30a9-55a4-8d76-24d419b593cf" :step/id #uuid "9127aacb-30a9-55a4-8d76-24d419b593cf" :step/content 17592186269244 :step/next "step-c2b79e93-d3ce-53a6-844f-76207ef1c04e" :db/ensure [:step/validate]} {:db/id "step-c2b79e93-d3ce-53a6-844f-76207ef1c04e" :step/id #uuid "c2b79e93-d3ce-53a6-844f-76207ef1c04e" :step/content 17592186383431 :db/ensure [:step/validate]}]
