1} &=  \\\\\nx^{8} \\cdot y^{4} &=  \\\\\n&= x^{8}y^{4}\n\\end{aligned}\n$$" 13194139535343 17592186045417 false] [17592186110299 1074 "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{({x}^{2}y)}^{3}\\cdot {x}^{2}y= &  \\\\ {({x}^{2})}^{3}\\cdot {y}^{3}\\cdot {x}^{2}y & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2\\cdot 3}\\cdot {y}^{3}\\cdot {x}^{2}y & = \\\\ {x}^{6}\\cdot {y}^{3}\\cdot {x}^{2}y & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{6}\\cdot {y}^{3}\\cdot {x}^{2}y= &  \\\\ {x}^{6}\\cdot {x}^{2}\\cdot {y}^{3}\\cdot y= &  \\\\ {x}^{6+2}\\cdot {y}^{3+1} & = \\\\ {x}^{8}\\cdot {y}^{4} & = \\\\ {x}^{8}{y}^{4} & \\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186110300 1071 "Given that $a=2x^3$ and $b=\\dfrac{x}{y}$, express $ab^2$ in terms of $x$ and $y$." 13194139535343 17592186045417 false] [17592186110300 1071 "Given that $a=2x^3$ and $b=\\dfrac{x}{y},$ express $ab^2$ in terms of $x$ and $y.$" 13194139535343 17592186045417 true] [17592186110300 1074 "First, we substitute for $a$ and $b$:\n\n$$\nab^{2} = 2x^{3}(\\frac{x}{y})^{2}\n$$\n\nThen, we apply the power of quotient rule:\n\n$$\n2x^{3}(\\frac{x}{y})^{2} = 2x^{3}(\\frac{x^{2}}{y^{2}})\n$$\n\nFinally, we multiply and apply the product rule:\n\n$$\n\\begin{aligned}\n2x^{3}(\\frac{x^{2}}{y^{2}}) &=  \\\\\n\\frac{2x^{3} \\cdot x^{2}}{y^{2}} &=  \\\\\n\\frac{2x^{3 + 2}}{y^{2}} &=  \\\\\n&= \\frac{2x^{5}}{y^{2}}\n\\end{aligned}\n$$" 13194139535343 17592186045417 false] [17592186110300 1074 "First, we substitute for $a$ and $b\\mathbin{:}$\n\n$$\n\\begin{aligned}a{b}^{2}=2{x}^{3}{(\\frac{x}{y})}^{2}\\end{aligned}\n$$\n\nThen, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}2{x}^{3}{(\\frac{x}{y})}^{2}=2{x}^{3}(\\frac{{x}^{2}}{{y}^{2}})\\end{aligned}\n$$\n\nFinally, we multiply and apply the product rule:\n\n$$\n\\begin{aligned}2{x}^{3}(\\frac{{x}^{2}}{{y}^{2}}) & = \\\\ \\frac{2{x}^{3}\\cdot {x}^{2}}{{y}^{2}} & = \\\\ \\frac{2{x}^{3+2}}{{y}^{2}} & = \\\\ \\frac{2{x}^{5}}{{y}^{2}} & \\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186110301 1071 "Simplify the expression $\\dfrac {\\sqrt{y}} {\\sqrt[3]{y}}$." 13194139535343 17592186045417 false] [17592186110301 1071 "Simplify the expression $\\dfrac {\\sqrt{y}} {\\sqrt[3]{y}}.$" 13194139535343 17592186045417 true] [17592186110301 1074 "First, we rewrite the radicals as fractional exponents:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{y}}{\\sqrt[3]{y}}=\\frac{{y}^{1/2}}{{y}^{1/3}}\\end{aligned}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{1/2}}{{y}^{1/3}} & = \\\\ {y}^{1/2-1/3} & = \\\\ {y}^{3/6-2/6} & = \\\\ {y}^{1/6}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{1/6}=\\sqrt[6]{y}\\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186110301 1074 "First, we rewrite the radicals as fractional exponents:\n\n$$\n\\frac{\\sqrt{y}}{\\sqrt[3]{y}} = \\frac{y^{1/2}}{y^{1/3}}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\n\\frac{y^{1/2}}{y^{1/3}} &=  \\\\\ny^{1/2 - 1/3} &=  \\\\\ny^{3/6 - 2/6} &=  \\\\\n&= y^{1/6}\n\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\ny^{1/6} = \\sqrt[6]{y}\n$$" 13194139535343 17592186045417 false] [17592186110355 1071 "Find the measure of an angle that's supplementary to an angle of $(7x -63)^\\circ$." 13194139535343 17592186045417 false] [17592186110355 1071 "Find the measure of an angle that's supplementary to an angle of $(7x -63)^\\circ.$" 13194139535343 17592186045417 true] [17592186110355 1074 "Two angles are supplementary if their measures add up to $180^\\circ$.\n\nSo, the measure of an angle that's supplementary to an angle of $(7x -63)^\\circ$ must be\n\n$$\n\\begin{aligned}\n180^{∘} - (7x - 63)^{∘} &= (180 - 7x + 63)^{∘} \\\\\n&= (180 + 63 - 7x)^{∘} \\\\\n&= (243 - 7x)^{∘}\n\\end{aligned}\n$$" 13194139535343 17592186045417 false] [17592186110355 1074 "Two angles are supplementary if their measures add up to $180^\\circ.$ \n\nSo, the measure of an angle that's supplementary to an angle of $(7x -63)^\\circ$ must be\n\n$$\n\\begin{aligned}{180}^{∘}-(7x-63)^{∘} & =(180-7x+63)^{∘} \\\\  & =(180+63-7x)^{∘} \\\\  & =(243-7x)^{∘}.\\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186110356 1074 "Since the two angles are supplementary, the sum of their measures is equal to $180^\\circ$. Therefore:\n\n$$\n\\begin{aligned}\n(3y - 17^{∘}) + (y + 37^{∘}) &= 180^{∘} \\\\\n4y + 20^{∘} &= 180^{∘} \\\\\n4y &= 160^{∘} \\\\\ny &= 40^{∘}\n\\end{aligned}\n$$" 13194139535343 17592186045417 false] [17592186110356 1074 "Since the two angles are supplementary, the sum of their measures is equal to $180^\\circ$. Therefore:\n\n$$\n\\begin{aligned}(3y-{17}^{∘})+(y+{37}^{∘}) & ={180}^{∘} \\\\ 4y+{20}^{∘} & ={180}^{∘} \\\\ 4y & ={160}^{∘} \\\\ y & ={40}^{∘}\\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186110357 1074 "![](images/ea/ea11964802b9ebca124a7f31b93fe58c30e619fc7279658bdcfcf7b683f24bb0.png)\n\nTwo angles are supplementary if their measures add up to $180^\\circ$, a straight angle.\n\nOnly $\\angle DGF$ is supplementary to $\\angle DGB$ in the given diagram." 13194139535343 17592186045417 false] [17592186110357 1074 "![](images/ea/ea11964802b9ebca124a7f31b93fe58c30e619fc7279658bdcfcf7b683f24bb0.png)\n\nTwo angles are supplementary if their measures add up to $180^\\circ,$ a straight angle.\n\nOnly $\\angle DGF$ is supplementary to $\\angle DGB$ in the given diagram." 13194139535343 17592186045417 true] [17592186110358 1071 "![](images/22/22e71949f4a63a7f650c38841bd67d3e5cb415a5c8819b0ea4ce80431bf6dbfb.png)\n\nGiven that $\\overline{AD}$ is a segment, what is the measure of $\\angle FOD$?" 13194139535343 17592186045417 false] [17592186110358 1071 "![](images/22/22e71949f4a63a7f650c38841bd67d3e5cb415a5c8819b0ea4ce80431bf6dbfb.png)\n\nGiven that $\\overline{AD}$ is a segment, what is the measure of $\\angle FOD?$" 13194139535343 17592186045417 true] [17592186110358 1074 "![](images/41/416aef1d024c1b926eb33bada7611bb1d345b0d9daa2d59730b05bab85617c05.png)\n\nTwo angles are supplementary if their measures add up to $180^\\circ$, a straight angle.\n\nSince $\\overline{AD}$ is a segment, we have that $\\angle AOF$ and $\\angle FOD$ are supplementary.\n\n$$\nm \\angle AOF + m \\angle FOD = 180^\\circ\n$$\n\nTherefore, the measure of $\\angle FOD$ is given by\n\n$$\n\\begin{aligned}\nm∠FOD &= 180^{∘} - m∠AOF \\\\\n&= 180^{∘} - 45^{∘} \\\\\n&= 135^{∘}\n\\end{aligned}\n$$" 13194139535343 17592186045417 false] [17592186110358 1074 "![](images/41/416aef1d024c1b926eb33bada7611bb1d345b0d9daa2d59730b05bab85617c05.png)\n\nTwo angles are supplementary if their measures add up to $180^\\circ,$ a straight angle.\n\nSince $\\overline{AD}$ is a segment, we have that $\\angle AOF$ and $\\angle FOD$ are supplementary. \n\n$$\nm \\angle AOF + m \\angle FOD = 180^\\circ\n$$\n\nTherefore, the measure of $\\angle FOD$ is given by\n\n$$\n\\begin{aligned}m∠FOD & ={180}^{∘}-m∠AOF \\\\  & ={180}^{∘}-{45}^{∘} \\\\  & ={135}^{∘}\\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186110419 1074 "In general, congruent polygons have the same shape. In other words:\n\n- they have the same number of sides,\n\n- all corresponding sides are congruent, and\n\n- all corresponding interior angles are congruent.\n\n$\\mathcal{P}$ and $\\mathcal{Q}$ have the same shape: They have congruent corresponding sides and congruent corresponding angles. This implies that $\\mathcal{P} \\cong \\mathcal{Q}.$" 13194139535343 17592186045417 true] [17592186110419 1074 "In general, congruent polygons have the same shape. In other words:\n\n- they have the same number of sides,\n- all corresponding sides are congruent, and\n- all corresponding interior angles are congruent.\n\n$\\mathcal{P}$ and $\\mathcal{Q}$ have the same shape: They have congruent corresponding sides and congruent corresponding angles. This implies that $\\mathcal{P} \\cong \\mathcal{Q}$." 13194139535343 17592186045417 false] [17592186110420 1071 "Which of the following statements are true for the polygons $\\mathcal{A}$, $\\mathcal{B}$, and $\\mathcal{C}$ shown below?\n\n1. $\\mathcal{A}\\cong\\mathcal{B}$\n2. $\\mathcal{B}\\cong\\mathcal{C}$\n3. $\\mathcal{C}\\cong\\mathcal{A}$\n\n![](images/a1/a13f283489521fc43d73a5a128b79ff937dca760c8cea330706efe6f39ac26f6.png)" 13194139535343 17592186045417 false] [17592186110420 1071 "Which of the following statements are true for the polygons $\\mathcal{A},$ $\\mathcal{B},$ and $\\mathcal{C}$ shown below?\n\nI. $\\mathcal{A}\\cong\\mathcal{B}$\n\nII. $\\mathcal{B}\\cong\\mathcal{C}$\n\nIII. $\\mathcal{C}\\cong\\mathcal{A}$\n\n![](images/a1/a13f283489521fc43d73a5a128b79ff937dca760c8cea330706efe6f39ac26f6.png)" 13194139535343 17592186045417 true] [17592186110420 1074 "In general, congruent polygons have the same shape. In other words:\n\n- they have the same number of sides,\n\n- all corresponding sides are congruent, and\n\n- all corresponding interior angles are congruent.\n\nWith that in mind, let's compare the given polygons.\n\n- Statement I is true. Since the polygons $\\mathcal{A}$ and $\\mathcal{B}$ have the same number of sides and all corresponding sides and angles are congruent, we conclude that $\\mathcal{A}\\cong\\mathcal{B}.$\n\n- Statement II is false. Notice that the polygons $\\mathcal{B}$ and $\\mathcal{C}$ have the same number of sides, but they don't seem to have the same shape. In particular, we notice they don't have corresponding congruent angles ($\\mathcal{B}$ does not have right angles, while $\\mathcal{C}$ does).\n\n- Statement III is false. By the same reasoning as above, we can see that the polygons $\\mathcal{C}$ and $\\mathcal{A}$ are not congruent.\n\nTherefore, the correct answer is \"I only.\"" 13194139535343 17592186045417 true] [17592186110420 1074 "In general, congruent polygons have the same shape. In other words:\n\n- they have the same number of sides,\n- all corresponding sides are congruent, and\n- all corresponding interior angles are congruent.\n\nWith that in mind, let's compare the given polygons.\n\n- Statement I is true. Since the polygons $\\mathcal{A}$ and $\\mathcal{B}$ have the same number of sides and all corresponding sides and angles are congruent, we conclude that $\\mathcal{A}\\cong\\mathcal{B}$.\n- Statement II is false. Notice that the polygons $\\mathcal{B}$ and $\\mathcal{C}$ have the same number of sides, but they don't seem to have the same shape. In particular, we notice they don't have corresponding congruent angles ($\\mathcal{B}$ does not have right angles, while $\\mathcal{C}$ does).\n- Statement III is false. By the same reasoning as above, we can see that the polygons $\\mathcal{C}$ and $\\mathcal{A}$ are not congruent.\n\nTherefore, the correct answer is \"I only.\"" 13194139535343 17592186045417 false] [17592186110421 1074 "First, notice that $\\angle A \\cong \\angle C$.\n\nLet's determine the vertices in the second quadrilateral that correspond to $A$. First, notice the following:\n\n$$\n\\begin{aligned}\nAB &= XY \\\\\nAD &= XW \\\\\n&= ∠A \\mid ≅∠X\n\\end{aligned}\n$$\n\nTherefore,\n\n- vertex $A$ corresponds to vertex $X$, and\n- vertex $C$ corresponds to vertex $Z$ (since $C$ is opposite $A$ and $Z$ is opposite $X$).\n\nAs for the other two vertices, notice we have two more pairs of congruent angles:\n\n$$\n\\begin{bmatrix}∠B & ≅∠Y \\\\ ∠D & ≅∠W\\end{bmatrix}\n$$\n\nSimilarly, we have two more pairs of congruent sides:\n\n$$\n\\begin{aligned}\nCD &= ZW \\\\\nBC &= YZ\n\\end{aligned}\n$$\n\nTherefore,\n\n- vertex $B$ corresponds to $Y$, and\n- vertex $D$ corresponds to $W$.\n\nFinally, we conclude that a correct congruence statement is\n\n$$\nABCD \\cong XYZW\n$$" 13194139535343 17592186045417 false] [17592186110421 1074 "First, notice that $\\angle A \\cong \\angle C.$ \n\nLet's determine the vertices in the second quadrilateral that correspond to $A.$ First, notice the following:\n\n$$\n\\begin{aligned}AB & =XY \\\\ AD & =XW \\\\ ∠A & ≅∠X\\end{aligned}\n$$\n\nTherefore, \n\n- vertex $A$ corresponds to vertex $X,$ and\n\n- vertex $C$ corresponds to vertex $Z$ (since $C$ is opposite $A$ and $Z$ is opposite $X$).\n\nAs for the other two vertices, notice we have two more pairs of congruent angles:\n\n$$\n\\begin{aligned}∠B & ≅∠Y \\\\ ∠D & ≅∠W.\\end{aligned}\n$$\n\nSimilarly, we have two more pairs of congruent sides:\n\n$$\n\\begin{aligned}CD & =ZW \\\\ BC & =YZ\\end{aligned}\n$$\n\nTherefore,\n\n- vertex $B$ corresponds to $Y,$ and\n\n- vertex $D$ corresponds to $W.$\n\nFinally, we conclude that a correct congruence statement is\n\n$$\nABCD \\cong XYZW .\n$$" 13194139535343 17592186045417 true] [17592186110422 1071 "Given that $ABCDE \\cong PQRST$, find $x+y$.\n\n![](images/f1/f133fecf2229bc78933ad0e73bb707dd17cad45ae087037b3a327e3ef4dbbc73.png)" 13194139535343 17592186045417 false] [17592186110422 1071 "Given that $ABCDE \\cong PQRST,$ find $x+y.$\n\n![](images/88/881eaba27f633ffe94791fef3d3ebfd68504fa887796ec235db2c8546e160657.png)" 13194139535343 17592186045417 true] [17592186110422 1074 "The statement $ABCDE \\cong PQRST$ means that $\\mathcal R$ and $\\mathcal Q$ are congruent. Moreover,\n\n- vertex $A$ corresponds to vertex $P$,\n- vertex $B$ corresponds to vertex $Q$,\n- vertex $C$ corresponds to vertex $R$,\n- vertex $D$ corresponds to vertex $S$,\n- vertex $E$ corresponds to vertex $T$.\n\nTherefore,\n\n$$\n\\begin{aligned}\nCD &= RS \\\\\nx &= 2\n\\end{aligned}\n$$\n\nAlso, we have\n\n$$\n\\begin{aligned}\nm∠A &= m∠P \\\\\n82^{∘} &= (11y + 5)^{∘} \\\\\n77 &= 11y \\\\\n7 &= y\n\\end{aligned}\n$$\n\nFinally,\n\n$$\nx+y = 2+7=9\n$$" 13194139535343 17592186045417 false] [17592186110422 1074 "The statement $ABCDE \\cong PQRST$ means that $\\mathcal{K}$ and $\\mathcal{M}$ are congruent. Moreover,\n\n- vertex $A$ corresponds to vertex $P,$\n\n- vertex $B$ corresponds to vertex $Q,$\n\n- vertex $C$ corresponds to vertex $R,$\n\n- vertex $D$ corresponds to vertex $S,$\n\n- vertex $E$ corresponds to vertex $T.$\n\nTherefore,\n\n$$\n\\begin{aligned}CD & =RS \\\\ x & =2.\\end{aligned}\n$$\n\nAlso, we have\n\n$$\n\\begin{aligned}m∠A & =m∠P \\\\ {82}^{∘} & =(11y+5)^{∘} \\\\ 77 & =11y \\\\ 7 & =y.\\end{aligned}\n$$\n\nFinally,\n\n$$\nx+y = 2+7=9.\n$$" 13194139535343 17592186045417 true] [17592186110627 1038 #edb/ref 17592186499469 13194139535343 17592186045417 true] [17592186110627 1038 #edb/ref 17592186499474 13194139535343 17592186045417 true] [17592186110627 1038 #edb/ref 17592186499519 13194139535343 17592186045417 true] [17592186110661 1038 #edb/ref 17592186499508 13194139535343 17592186045417 true] [17592186110662 1038 #edb/ref 17592186499549 13194139535343 17592186045417 true] [17592186110663 1038 #edb/ref 17592186499483 13194139535343 17592186045417 true] [17592186110663 1038 #edb/ref 17592186499500 13194139535343 17592186045417 true] [17592186110663 1038 #edb/ref 17592186499524 13194139535343 17592186045417 true] [17592186110790 1038 #edb/ref 17592186499475 13194139535343 17592186045417 true] [17592186110790 1038 #edb/ref 17592186499493 13194139535343 17592186045417 true] [17592186110791 1038 #edb/ref 17592186499487 13194139535343 17592186045417 true] [17592186110792 1038 #edb/ref 17592186499465 13194139535343 17592186045417 true] [17592186110792 1038 #edb/ref 17592186499533 13194139535343 17592186045417 true] [17592186110792 1038 #edb/ref 17592186499557 13194139535343 17592186045417 true] [17592186110793 1038 #edb/ref 17592186499452 13194139535343 17592186045417 true] [17592186110793 1038 #edb/ref 17592186499471 13194139535343 17592186045417 true] [17592186110813 1050 420.0 13194139535343 17592186045417 true] [17592186110866 1050 420.0 13194139535343 17592186045417 true] [17592186110868 1050 480.0 13194139535343 17592186045417 true] [17592186110915 1070 #edb/ref 17592186045487 13194139535343 17592186045417 true] [17592186110915 1071 "${(x{y}^{2})}^{2}\\cdot xy=$" 13194139535343 17592186045417 true] [17592186110915 1071 "What is $(xy^{2})^{2} \\cdot xy$?" 13194139535343 17592186045417 false] [17592186110915 1074 "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{(x{y}^{2})}^{2}\\cdot xy={x}^{2}\\cdot ({y}^{2})^{2}\\cdot xy & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot ({y}^{2})^{2}\\cdot xy & = \\\\ {x}^{2}\\cdot {y}^{2\\cdot 2}\\cdot xy & = \\\\ {x}^{2}\\cdot {y}^{4}\\cdot xy & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {y}^{4}\\cdot xy & = \\\\ ({x}^{2}\\cdot x)\\cdot ({y}^{4}\\cdot y) & = \\\\ {x}^{2+1}\\cdot {y}^{4+1} & = \\\\ {x}^{3}\\cdot {y}^{5} & = \\\\ {x}^{3}{y}^{5} & \\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186111065 1070 #edb/ref 17592186045485 13194139535343 17592186045417 true] [17592186111065 1071 "![](images/10/10cd6e85765f6b79ab4bdab95f9ba9c34b012529b9bcd5d3cbdb93765cd99d6a.png)\n\nGiven the polygon $P$ shown above, which of the following polygons is congruent to $P$?" 13194139535343 17592186045417 false] [17592186111065 1071 "![](images/10/10cd6e85765f6b79ab4bdab95f9ba9c34b012529b9bcd5d3cbdb93765cd99d6a.png)\n\nGiven the polygon $P$ shown above, which of the following polygons is congruent to $P?$" 13194139535343 17592186045417 true] [17592186111065 1074 "In general, congruent polygons have the same shape. In other words:\n\n- they have the same number of sides,\n\n- all corresponding sides are congruent, and\n\n- all corresponding interior angles are congruent.\n\nWith that in mind, let's compare each of the given polygons to $P.$\n\n- The polygon $P$ is an octagon (it has eight sides). So, the polygons $R,$ $T,$ and $Q$ can't be congruent to the polygon $P$ because they do not have $8$ sides.\n\n- The polygon $S$ is *not* congruent to $\\,P$ (even though they both have $8$ sides) because $S$ and $P$ don't have the same shape. In particular, notice that $P$ has a right angle, while $S$ doesn't have a right angle.\n\nOn the other hand, $P$ and $U$ have the same shape: They have congruent corresponding sides and congruent corresponding angles. This implies that $P≅U.$" 13194139535343 17592186045417 true] [17592186111086 1070 #edb/ref 17592186045485 13194139535343 17592186045417 true] [17592186111086 1071 "$\\frac{100{x}^{7}{y}^{3}}{20{x}^{3}{y}^{2}}=$" 13194139535343 17592186045417 true] [17592186111086 1071 "What is $\\frac{100x^{7}y^{3}}{20x^{3}y^{2}}$?" 13194139535343 17592186045417 false] [17592186111086 1074 "We separate the fraction, group the two variables separately, and apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{100{x}^{7}{y}^{3}}{20{x}^{3}{y}^{2}} & = \\\\ \\frac{100}{20}\\cdot \\frac{{x}^{7}}{{x}^{3}}\\cdot \\frac{{y}^{3}}{{y}^{2}} & = \\\\ 5\\cdot {x}^{(7-3)}\\cdot {y}^{(3-2)} & = \\\\ 5{x}^{4}{y}^{1} & = \\\\ 5{x}^{4}y\\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186111093 1070 #edb/ref 17592186045485 13194139535343 17592186045417 true] [17592186111093 1071 "![](images/fa/fa57e1d088e5384cfd7a08d524877e6a9fafce413f0b3039d59d90dd074d361b.png)\n\nWhich of the following statements are true for the polygons $P$, $Q$ and $R$ shown above?\n\n1. $P≅Q$\n2. $Q≅R$\n3. $P≅R$" 13194139535343 17592186045417 false] [17592186111093 1071 "![](images/fa/fa57e1d088e5384cfd7a08d524877e6a9fafce413f0b3039d59d90dd074d361b.png)\n\nWhich of the following statements are true for the polygons $P$, $Q$ and $R$ shown above?\n\nI. $P≅Q$\n\nII. $Q≅R$\n\nIII. $P≅R$" 13194139535343 17592186045417 true] [17592186111093 1074 "In general, congruent polygons have the same shape. In other words:\n\n- they have the same number of sides,\n\n- all corresponding sides are congruent, and\n\n- all corresponding interior angles are congruent.\n\nWith that in mind, let's compare the given polygons.\n\n- Statement I is false. Notice that the polygons $P$ and $Q$ have the same number of sides, but they don't seem to have the same shape. In particular, we notice they don't have corresponding congruent angles ($P$ does not have right angles, while $Q$ does).\n\n- Statement II is false. By the same reasoning as above, we can see that the polygons $Q$ and $R$ are not congruent.\n\n- Statement III is true. Since the polygons $P$ and $R$ have the same number of sides and all corresponding sides and angles are congruent, we conclude that $P≅R.$\n\nTherefore, the correct answer is \"III only.\"" 13194139535343 17592186045417 true] [17592186111824 1064 "Sometimes, we might need to use more than one rule of exponents to simplify an expression. First, let's remind ourselves of all of the rules of exponents.\n\n- Radicals as fractional exponents: $\\sqrt[n]{x} = x^{1/n}$\n\n- The product rule: $a^n \\cdot a^m = a^{n+m}$\n\n- The quotient rule: $\\dfrac{a^n}{a^m} = a^{n-m}$\n\n- The power rule: $\\left( a^m \\right)^n = a^{mn}$\n\n- The power of product rule: $(ab)^n = a^nb^n$\n\n- The power of quotient rule: $\\left(\\dfrac a b \\right)^n = \\dfrac{a^n}{b^n}$\n\nAs an example, let's simplify the following expression:\n\n$$\n\\left(u^2 v\\right)^3\n$$\n\nWe start by using the power of product rule:\n\n$$\n\\begin{aligned}{({u}^{2}v)}^{3}={({u}^{2})}^{3}\\cdot {v}^{3}\\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{({u}^{2})}^{3}\\cdot {v}^{3} & = \\\\ {u}^{(2\\cdot 3)}\\cdot {v}^{3} & = \\\\ {u}^{6}\\cdot {v}^{3} & = \\\\ {u}^{6}{v}^{3}\\end{aligned}\n$$" 13194139535343 17592186045417 true] [17592186111824 1064 "Sometimes, we might need to use more than one rule of exponents to simplify an expression. First, let's remind ourselves of all of the rules of exponents.\n\n- Radicals as fractional exponents: $\\sqrt[n]{x} = x^{1/n}$\n- The product rule: $a^n \\cdot a^m = a^{n+m}$\n- The quotient rule: $\\dfrac{a^n}{a^m} = a^{n-m}$\n- The power rule: $\\left(a^m \\right)^n = a^{mn}$\n- The power of product rule: $(ab)^n = a^nb^n$\n- The power of quotient rule: $\\left(\\dfrac a b \\right)^n = \\dfrac{a^n}{b^n}$\n\nAs an example, let's simplify the following expression:\n\n$$\n\\left(u^2 v\\right)^3\n$$\n\nWe start by using the power of product rule:\n\n$$\n(u^{2}v)^{3} = (u^{2})^{3} \\cdot v^{3}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}\n(u^{2})^{3} \\cdot v^{3} &=  \\\\\nu^{(2 \\cdot 3)} \\cdot v^{3} &=  \\\\\nu^{6} \\cdot v^{3} &=  \\\\\n&= u^{6}v^{3}\n\\end{aligned}\n$$" 13194139535343 17592186045417 false] [17592186111851 1064 "Two polygons are **congruent** if they have the same shape. This means that\n\n- they have the same number of sides,\n\n- all corresponding sides are congruent, and\n\n- all corresponding interior angles are congruent.\n\nConsider the two polygons $\\mathcal{P}$ and $\\mathcal{Q}$ below. Are they congruent?\n\n![](images/b0/b0a11815bf9006ccdca0ebe71ff7ba53ac7526c71a715ece71914b103b4a24a8.png)\n\nLet's check these criteria for our polygons $\\mathcal{P}$ and $\\mathcal{Q}.$ We can see that both polygons have $3$ sides, and\n\n$$\n\\begin{aligned}\\overset{―}{AB} & ≅\\overset{―}{XY}\\,, & \\overset{―}{AC} & ≅\\overset{―}{XZ}\\,, & \\overset{―}{BC} & ≅\\overset{―}{YZ}\\,, \\\\ ∠X & ≅∠A\\,, & ∠Y & ≅∠B\\,, & ∠Z & ≅∠C\\,.\\end{aligned}\n$$\n\nTherefore, the polygons are congruent, and we can write \n\n$$\nABC \\cong XYZ.\n$$\n\nThe order in which we write the symbols is important: the corresponding vertices have to be in the same order.\n\nWe can also write $\\mathcal{P} \\cong \\mathcal{Q}.$" 13194139535343 17592186045417 true] [17592186111851 1064 "Two polygons are **congruent** if they have the same shape. This means that\n\n- they have the same number of sides,\n- all corresponding sides are congruent, and\n- all corresponding interior angles are congruent.\n\nConsider the two polygons $\\mathcal{P}$ and $\\mathcal{Q}$ below. Are they congruent?\n\n![](images/b0/b0a11815bf9006ccdca0ebe71ff7ba53ac7526c71a715ece71914b103b4a24a8.png)\n\nLet's check these criteria for our polygons $\\mathcal{P}$ and $\\mathcal{Q}$. We can see that both polygons have $3$ sides, and\n$\\begin{bmatrix}AB^(―) & ≅XY^(―), & AC^(―) & ≅XZ^(―), & BC^(―) & ≅YZ^(―), \\\\ ∠X & ≅∠A, & ∠Y & ≅∠B, & ∠Z & ≅∠C\\end{bmatrix}$.\nTherefore, the polygons are congruent, and we can write\n$ABC \\cong XYZ$.\n\nThe order in which we write the symbols is important: the corresponding vertices have to be in the same order.\n\nWe can also write $\\mathcal{P} \\cong \\mathcal{Q}$." 13194139535343 17592186045417 false] [17592186111904 1064 "To simplify the expression $x\\cdot \\sqrt[3]{x^2}$, we first rewrite the radical as a fractional exponent:\n\n$$\nx \\cdot \\sqrt[3]{x^2} = x \\cdot \\left(x^2 \\right)^{1/3}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\nx \\cdot \\left(x^2 \\right)^{1/3} = x \\cdot x^{2(1/3)} = x \\cdot x^{2/3}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}\nx \\cdot x^{2/3} &=  \\\\\nx^{1 + 2/3} &=  \\\\\n&= x^{5/3}\n\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\nx^{5/3} = \\sqrt[3]{x^5}\n$$\n\nNotice that, by combining the radicals as fractional exponents and power rules, we get the following formula:\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}\n$$" 13194139535343 17592186045417 false] [17592186111904 1064 "To simplify the expression $x\\cdot \\sqrt[3]{x^2},$ we first rewrite the radical as a fractional exponent:\n\n$$\nx \\cdot \\sqrt[3]{x^2} = x \\cdot \\left( x^2 \\right)^{1/3}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\nx \\cdot \\left( x^2 \\right)^{1/3} = x \\cdot x^{2(1/3)} = x \\cdot x^{2/3}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}x\\cdot {x}^{2/3} & = \\\\ {x}^{1+2/3} & = \\\\ {x}^{5/3} & \\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\nx^{5/3} = \\sqrt[3]{x^5}\n$$\n\nNotice that, by combining the radicals as fractional exponents and power rules, we get the following formula:\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}\n$$" 13194139535343 17592186045417 true] [17592186111922 1064 "Two angles are **supplementary** if their measures add up to $180^\\circ$.\n\n![](images/88/886f1ce19ad595b470d5ad13943b780bd5a22ee737908d9554e97bd08c9ce985.png)\n\nThese angles are supplementary because the sum of their measures is $180^\\circ{:}$\n\n$$\n105^\\circ +75^\\circ = 180^\\circ\n$$\n\nA **linear pair** is a pair of adjacent angles formed when two lines intersect. The angles shown above form a linear pair.\n\nThe **linear pair postulate** states the following:\n\n> If two angles form a linear pair, then they are supplementary.\n\nThe converse is *not* true. That is, if two angles are supplementary, they do not necessarily form a linear pair.\n\nTo see why, consider the diagram shown below:\n\n![](images/29/29ff0dfefb0b535342f4e8060b37fb2404983fc150681bb02d18fa6e5b00f899.png)\n\nAlthough the angles are supplementary (the sum of their measures is\n\n$$\n120^\\circ + 60^\\circ = 180^\\circ\n$$\n\n), they do not form a linear pair of angles since they are not adjacent." 13194139535343 17592186045417 false] [17592186111922 1064 "Two angles are **supplementary** if their measures add up to $180^\\circ.$\n\n![](images/88/886f1ce19ad595b470d5ad13943b780bd5a22ee737908d9554e97bd08c9ce985.png)\n\nThese angles are supplementary because the sum of their measures is $180^\\circ{:}$\n\n$$\n105^\\circ +75^\\circ = 180^\\circ\n$$\n\nA **linear pair** is a pair of adjacent angles formed when two lines intersect. The angles shown above form a linear pair.\n\nThe **linear pair postulate** states the following:\n\nIf two angles form a linear pair, then they are supplementary.\n\nThe converse is *not* true. That is, if two angles are supplementary, they do not necessarily form a linear pair.\n\nTo see why, consider the diagram shown below:\n\n![](images/29/29ff0dfefb0b535342f4e8060b37fb2404983fc150681bb02d18fa6e5b00f899.png)\n\nAlthough the angles are supplementary (the sum of their measures is $120^\\circ + 60^\\circ = 180^\\circ$), they do not form a linear pair of angles since they are not adjacent." 13194139535343 17592186045417 true] [17592186118125 1075 #edb/ref 17592186498861 13194139535343 17592186045417 true] [17592186118125 1078 #edb/ref 17592186498861 13194139535343 17592186045417 true] [17592186119548 1074 "The diagram shows a series RCL circuit with a source electromotive force (EMF) of $20\\sin(4t)\\,\\textrm{V},$ a resistor of resistance $30\\,\\Omega,$ a capacitor of capacitance $0.05\\,\\textrm{F},$ and an inductor of inductance $10\\,\\textrm{H}.$\n\nThe current $I,$ measured in amperes, is defined as the rate of flow of charge $q,$ measured in coulombs.\n\n$$\nI = \\dfrac{\\mathrm{d}q}{\\mathrm{d}t}\n$$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RCL circuit, there are three voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=30\\,\\Omega.$ So,\n\n$$\nV_R = 30I = 30\\,\\dfrac{\\mathrm{d}q}{\\mathrm{d}t}.\n$$\n\n- The voltage drop across the capacitor is related to its charge by $q = CV_C.$ Therefore,\n\n$$\nV_C = \\dfrac{q}{C} = \\dfrac{q}{0.05} = 20q.\n$$\n\n- The voltage drop across the inductor is proportional to the rate of change of current, with a constant of proportionality $L = 10\\,\\textrm{H}.$ Hence,\n\n$$\nV_L = 10\\,\\dfrac{\\mathrm{d}I}{\\mathrm{d}t} = 10\\,\\dfrac{\\mathrm{d}}{\\mathrm{d}t}\\left(\\dfrac{\\mathrm{d}q}{\\mathrm{d}t}\\right) = 10\\,\\dfrac{\\mathrm{d}^2q}{\\mathrm{d}t^2}.\n$$\n\nTherefore, by Kirchhoff's voltage law, the differential equation governing the amount of charge $q$ on the capacitor is\n\n$$\n20\\sin(4t) = 30\\,\\dfrac{\\mathrm{d}q}{\\mathrm{d}t} + 20q + 10\\,\\dfrac{\\mathrm{d}^2q}{\\mathrm{d}t^2},\n$$\n\nwhich gives\n\n$$\n\\dfrac{\\mathrm{d}^2q}{\\mathrm{d}t^2} + 3\\,\\dfrac{\\mathrm{d}q}{\\mathrm{d}t} + 2q = 2\\sin(4t).\n$$\n\nThe given equation is a second-order linear equation with constant coefficients. To find the general solution, we must sum the complementary and particular solutions.\n\n- To find the complementary solution $q_c,$ we solve the corresponding homogeneous equation, given by\n\n$$\n\\dfrac{\\mathrm{d}^2q_c}{\\mathrm{d}t^2} + 3\\,\\dfrac{\\mathrm{d}q_c}{\\mathrm{d}t} + 2q_c = 0.\n$$\n\nSolving using an integration technique, such as a trial solution, we obtain the complementary solution\n\n$$\nq_c(t) = Ae^{-t} + Be^{-2t},\n$$\n\nwhere $A$ and $B$ are constants.\n\n- Next, we find the particular solution. Note that the right-hand side of the inhomogeneous equation is sinusoidal with argument $4t.$ So, we assume that the particular solution is also a sinusoidal with argument $4t,$ i.e.,\n\n$$\nq_p(t) = \\alpha\\cos(4t) + \\beta\\sin(4t).\n$$\n\nTo find the values of $\\alpha$ and $\\beta,$ we substitute\n\n$$\n\\begin{aligned}{q}_{p} & =\\alpha \\operatorname{cos}⁡(4t)+\\beta \\operatorname{sin}⁡(4t), \\\\ \\frac{d{q}_{p}}{dt} & =-4\\alpha \\operatorname{sin}⁡(4t)+4\\beta \\operatorname{cos}⁡(4t), \\\\ \\frac{{d}^{2}{q}_{p}}{d{t}^{2}} & =-16\\alpha \\operatorname{cos}⁡(4t)-16\\beta \\operatorname{sin}⁡(4t),\\end{aligned}\n$$\n\ninto the inhomogeneous equation and group like terms on the left-hand side:\n\n$$\n\\begin{aligned}(-16\\alpha \\operatorname{cos}⁡(4t)-16\\beta \\operatorname{sin}⁡(4t))+3(-4\\alpha \\operatorname{sin}⁡(4t)+4\\beta \\operatorname{cos}⁡(4t)) &  \\\\ \\,+2(\\alpha \\operatorname{cos}⁡(4t)+\\beta \\operatorname{sin}⁡(4t)) & =2\\operatorname{sin}⁡(4t) \\\\ (-14\\alpha +12\\beta )\\operatorname{cos}⁡(4t)+(-12\\alpha -14\\beta )\\operatorname{sin}⁡(4t) & =2\\operatorname{sin}⁡(4t).\\end{aligned}\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\{\\begin{aligned}-14\\alpha +12\\beta =0\\, & (\\text{equating the coefficients of}\\,\\operatorname{cos}⁡(4t)) \\\\ -12\\alpha -14\\beta =2\\, & (\\text{equating the coefficients of}\\,\\operatorname{sin}⁡(4t))\\end{aligned}\n$$\n\nSolving this system gives $\\alpha = -\\dfrac{6}{85}$ and $\\beta = -\\dfrac{7}{85}.$ Therefore, the particular solution is\n\n$$\nq_p(t) = -\\dfrac{6}{85}\\cos(4t) - \\dfrac{7}{85}\\sin(4t).\n$$\n\nNow, since the general solution is given by the sum of the complementary solution and the particular solution, the general solution in our case is\n\n$$\nq(t) = q_c(t) + q_p(t) = Ae^{-t} + Be^{-2t} - \\dfrac{6}{85}\\cos(4t) - \\dfrac{7}{85}\\sin(4t).\n$$\n\nNote the following:\n\n- The quantity $q_c(t) = Ae^{-t} + Be^{-2t}$ is the *transient charge*, since it goes to zero as $t \\to \\infty.$\n\n- The function $q_p(t) = -\\dfrac{6}{85}\\cos(4t) - \\dfrac{7}{85}\\sin(4t)$ is the *steady-state charge*. It governs the charge's long-term behavior.\n\nTherefore, as $t\\to\\infty,$ we have\n\n$$\nq(t)\\approx q_p(t) = -\\dfrac{6}{85}\\cos(4t) - \\dfrac{7}{85}\\sin(4t).\n$$\n\nFinally, the amplitude of the steady-state charge, in coulombs, is given by\n\n$$\n\\sqrt{\\left(-\\dfrac{6}{85}\\right)^2 + \\left(-\\dfrac{7}{85}\\right)^2} \\approx 0.11,\n$$\n\nrounded to two decimal places." 13194139535343 17592186045417 true] [17592186119548 1074 "The diagram shows a series RCL circuit with a source electromotive force (EMF) of $20\\sin(4t)\\,\\textrm{V},$ a resistor of resistance $30\\,\\Omega,$ a capacitor of capacitance $0.05\\,\\textrm{F},$ and an inductor of inductance $10\\,\\textrm{H}.$\n\nThe current $I,$ measured in amperes, is defined as the rate of flow of charge $q,$ measured in coulombs.\n\n$$\nI = \\dfrac{\\mathrm{d}q}{\\mathrm{d}t}\n$$\n\nKirchhoff's voltage law states that in a series circuit, the source voltage (EMF) equals the sum of the voltage drops.\n\nIn an RCL circuit, there are three voltage drops:\n\n- The voltage drop across the resistor is proportional to the current, with a constant of proportionality $R=30\\,\\Omega.$ So,\n\n$$\nV_R = 30I = 30\\,\\dfrac{\\mathrm{d}q}{\\mathrm{d}t}.\n$$\n\n- The voltage drop across the capacitor is related to its charge by $q = CV_C.$ Therefore,\n\n$$\nV_C = \\dfrac{q}{C} = \\df