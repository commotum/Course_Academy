e]} {:db/id "answer-e5310698-c35b-500a-b6f5-49e8935cbe38" :answer/id #uuid "e5310698-c35b-500a-b6f5-49e8935cbe38" :answer/type :answer.type/math :answer/value "∠CGD" :db/ensure [:answer/validate]} {:db/id 17592186111922 :tutorial/content "Two angles are **supplementary** if their measures add up to $180^\\circ.$\n\n![](images/88/886f1ce19ad595b470d5ad13943b780bd5a22ee737908d9554e97bd08c9ce985.png)\n\nThese angles are supplementary because the sum of their measures is $180^\\circ{:}$\n\n$$\n105^\\circ +75^\\circ = 180^\\circ\n$$\n\nA **linear pair** is a pair of adjacent angles formed when two lines intersect. The angles shown above form a linear pair.\n\nThe **linear pair postulate** states the following:\n\nIf two angles form a linear pair, then they are supplementary.\n\nThe converse is *not* true. That is, if two angles are supplementary, they do not necessarily form a linear pair.\n\nTo see why, consider the diagram shown below:\n\n![](images/29/29ff0dfefb0b535342f4e8060b37fb2404983fc150681bb02d18fa6e5b00f899.png)\n\nAlthough the angles are supplementary (the sum of their measures is $120^\\circ + 60^\\circ = 180^\\circ$), they do not form a linear pair of angles since they are not adjacent." :db/ensure [:tutorial/validate]} {:db/id 17592186110866 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124652 :knowledge-point/questions ["question-aac5719a-7a14-5fc9-ab07-f4320aad4083"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124651 :knowledge-point/questions ["question-a43bb9df-6cd4-59cd-9e78-40afc4cecca9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a43bb9df-6cd4-59cd-9e78-40afc4cecca9" :question/id #uuid "a43bb9df-6cd4-59cd-9e78-40afc4cecca9" :question/math-academy-id "q-164396" :question/problem "Identify the surface $4{x}^{2}+\\frac{{y}^{2}}{9}+{z}^{2}=1.$" :question/worked-solution "Recall that the equation of an ellipsoid centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nThus, our equation is an ellipsoid with $a=\\frac{1}{2},\\,b=3,\\,c=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ea6e680c-b0bb-5dbd-a194-b67f3d2e815c"] :db/ensure [:question/validate]} {:db/id "answer-field-ea6e680c-b0bb-5dbd-a194-b67f3d2e815c" :answer-field/id #uuid "ea6e680c-b0bb-5dbd-a194-b67f3d2e815c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a63234ad-3ec9-5fca-ae38-85b9a41f3dfa" :answer-field/choices ["answer-021522e8-a9df-59e6-b84b-91834f2968d3" "answer-fa72b501-4cb3-5f6c-8dfe-1efa05d79c7d" "answer-d7b37c1b-e271-50f4-b1c0-d70da4980e40" "answer-1c777e07-effa-5159-bdca-6498cfc63f89" "answer-a63234ad-3ec9-5fca-ae38-85b9a41f3dfa"] :db/ensure [:answer-field/validate]} {:db/id "answer-021522e8-a9df-59e6-b84b-91834f2968d3" :answer/id #uuid "021522e8-a9df-59e6-b84b-91834f2968d3" :answer/type :answer.type/text :answer/value "A cylinder" :db/ensure [:answer/validate]} {:db/id "answer-fa72b501-4cb3-5f6c-8dfe-1efa05d79c7d" :answer/id #uuid "fa72b501-4cb3-5f6c-8dfe-1efa05d79c7d" :answer/type :answer.type/text :answer/value "A hyperboloid of one sheet" :db/ensure [:answer/validate]} {:db/id "answer-d7b37c1b-e271-50f4-b1c0-d70da4980e40" :answer/id #uuid "d7b37c1b-e271-50f4-b1c0-d70da4980e40" :answer/type :answer.type/text :answer/value "A hyperboloid of two sheets" :db/ensure [:answer/validate]} {:db/id "answer-1c777e07-effa-5159-bdca-6498cfc63f89" :answer/id #uuid "1c777e07-effa-5159-bdca-6498cfc63f89" :answer/type :answer.type/text :answer/value "A paraboloid" :db/ensure [:answer/validate]} {:db/id "answer-a63234ad-3ec9-5fca-ae38-85b9a41f3dfa" :answer/id #uuid "a63234ad-3ec9-5fca-ae38-85b9a41f3dfa" :answer/type :answer.type/text :answer/value "An ellipsoid" :db/ensure [:answer/validate]} {:db/id "question-aac5719a-7a14-5fc9-ab07-f4320aad4083" :question/id #uuid "aac5719a-7a14-5fc9-ab07-f4320aad4083" :question/math-academy-id "q-164513" :question/problem "Identify the surface $y={x}^{2}-\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\ny=\\frac{{x}^{2}}{{a}^{2}}-\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $y$-axis and $a=1,\\,c=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ef272bc8-d53b-5b80-88af-a0c05c5cfeb7"] :db/ensure [:question/validate]} {:db/id "answer-field-ef272bc8-d53b-5b80-88af-a0c05c5cfeb7" :answer-field/id #uuid "ef272bc8-d53b-5b80-88af-a0c05c5cfeb7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ff2e8e7-86f1-53c7-b6c0-8eaa30d0d9e8" :answer-field/choices ["answer-750ac996-47c9-5708-8786-361c28fa8bcb" "answer-6ff2e8e7-86f1-53c7-b6c0-8eaa30d0d9e8" "answer-df499b4c-c6a3-5ad4-a3fc-438688b9685f" "answer-c9c9013c-3150-59d3-828f-685becb59007" "answer-389ea0f9-8a1f-5cb1-ad91-524b12efbd32"] :db/ensure [:answer-field/validate]} {:db/id "answer-750ac996-47c9-5708-8786-361c28fa8bcb" :answer/id #uuid "750ac996-47c9-5708-8786-361c28fa8bcb" :answer/type :answer.type/text :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/ensure [:answer/validate]} {:db/id "answer-6ff2e8e7-86f1-53c7-b6c0-8eaa30d0d9e8" :answer/id #uuid "6ff2e8e7-86f1-53c7-b6c0-8eaa30d0d9e8" :answer/type :answer.type/text :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/ensure [:answer/validate]} {:db/id "answer-df499b4c-c6a3-5ad4-a3fc-438688b9685f" :answer/id #uuid "df499b4c-c6a3-5ad4-a3fc-438688b9685f" :answer/type :answer.type/text :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $x$-axis" :db/ensure [:answer/validate]} {:db/id "answer-c9c9013c-3150-59d3-828f-685becb59007" :answer/id #uuid "c9c9013c-3150-59d3-828f-685becb59007" :answer/type :answer.type/text :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $y$-axis" :db/ensure [:answer/validate]} {:db/id "answer-389ea0f9-8a1f-5cb1-ad91-524b12efbd32" :answer/id #uuid "389ea0f9-8a1f-5cb1-ad91-524b12efbd32" :answer/type :answer.type/text :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/ensure [:answer/validate]} {:db/id "activity-36149860-d4ac-5977-bb67-7aa72386654c" :activity/id #uuid "36149860-d4ac-5977-bb67-7aa72386654c" :activity/title "Identifying Quadric Surfaces" :activity/type :activity.type/review :activity/scope 17592186050005 :activity/course 17592186046659 :activity/steps ["step-5c548eb8-9df3-51c7-a5ac-8d8c6f9aee14" "step-89ae8bd8-6821-50c2-ae85-b282e63cacb4" "step-922bfb7c-f62a-573a-8240-5f30e75ef4b9" "step-2899eb8d-728e-5caa-a932-24666f3bf8fd" "step-98a0cfb3-88e2-53f4-9c05-0b0a0c14511d"] :activity/first-step "step-5c548eb8-9df3-51c7-a5ac-8d8c6f9aee14" :db/ensure [:activity/validate]} {:db/id "step-5c548eb8-9df3-51c7-a5ac-8d8c6f9aee14" :step/id #uuid "5c548eb8-9df3-51c7-a5ac-8d8c6f9aee14" :step/content 17592186323754 :step/next "step-89ae8bd8-6821-50c2-ae85-b282e63cacb4" :db/ensure [:step/validate]} {:db/id "step-89ae8bd8-6821-50c2-ae85-b282e63cacb4" :step/id #uuid "89ae8bd8-6821-50c2-ae85-b282e63cacb4" :step/content 17592186323841 :step/next "step-922bfb7c-f62a-573a-8240-5f30e75ef4b9" :db/ensure [:step/validate]} {:db/id "step-922bfb7c-f62a-573a-8240-5f30e75ef4b9" :step/id #uuid "922bfb7c-f62a-573a-8240-5f30e75ef4b9" :step/content 17592186124831 :step/next "step-2899eb8d-728e-5caa-a932-24666f3bf8fd" :db/ensure [:step/validate]} {:db/id "step-2899eb8d-728e-5caa-a932-24666f3bf8fd" :step/id #uuid "2899eb8d-728e-5caa-a932-24666f3bf8fd" :step/content "question-a43bb9df-6cd4-59cd-9e78-40afc4cecca9" :step/next "step-98a0cfb3-88e2-53f4-9c05-0b0a0c14511d" :db/ensure [:step/validate]} {:db/id "step-98a0cfb3-88e2-53f4-9c05-0b0a0c14511d" :step/id #uuid "98a0cfb3-88e2-53f4-9c05-0b0a0c14511d" :step/content "question-aac5719a-7a14-5fc9-ab07-f4320aad4083" :db/ensure [:step/validate]} [:db/retract 17592186198610 :question/answer-fields 17592186194291] {:db/id 17592186278495 :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,3u-2v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,0\\le u\\le 5,\\,-3\\le v\\le 3\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(3u-2v)⟩ \\\\  & =⟨1,\\,0,\\,3⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(3u-2v)⟩ \\\\  & =⟨0,\\,1,\\,-2⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 3 \\\\ 0 & 1 & -2\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 3 \\\\ 1 & -2\\end{aligned}|,\\,-|\\begin{aligned}1 & 3 \\\\ 0 & -2\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-3,\\,2,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨z,\\,-y,\\,2x⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=3u-2v} \\\\  & =⟨3u-2v,\\,-v,\\,2u⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3u-2v,\\,-v,\\,2u⟩\\cdot ⟨-3,\\,2,\\,1⟩ \\\\  & =(3u-2v)\\cdot (-3)+(-v)\\cdot (2)+2u\\cdot 1 \\\\  & =-9u+6v-2v+2u \\\\  & =-7u+4v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨z,\\,-y,\\,2x⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(-7u+4v)\\,\\text{d}A \\\\  & ={\\int }_{0}^{5}{\\int }_{-3}^{3}(-7u+4v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186198610 :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,u+v⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,0\\le u\\le 2,\\,0\\le v\\le 2\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(u+v)⟩ \\\\  & =⟨1,\\,0,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(u+v)⟩ \\\\  & =⟨0,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}|,\\,-|\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨{x}^{2},\\,{y}^{2},\\,{z}^{2}⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=u+v} \\\\  & =⟨{u}^{2},\\,{v}^{2},\\,(u+v)^{2}⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨{u}^{2},\\,{v}^{2},\\,(u+v)^{2}⟩\\cdot ⟨-1,\\,-1,\\,1⟩ \\\\  & ={u}^{2}\\cdot (-1)+{v}^{2}\\cdot (-1)+(u+v)^{2}\\cdot 1 \\\\  & =-{u}^{2}-{v}^{2}+{u}^{2}+2uv+{v}^{2} \\\\  & =2uv.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨{x}^{2},\\,{y}^{2},\\,{z}^{2}⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(2uv)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}2uv\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186278518 :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,v-u⟩\n$$\n\nover the domain \n\n$$\nD=\\{(u,v)\\,:\\,0\\le u\\le 2,\\,-1\\le v\\le 2\\}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(v-u)⟩ \\\\  & =⟨1,\\,0,\\,-1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(v-u)⟩ \\\\  & =⟨0,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & -1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & -1 \\\\ 1 & 1\\end{aligned}|,\\,-|\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨z,\\,y+2z,\\,2x-y⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=v-u} \\\\  & =⟨v-u,\\,v+2(v-u),\\,2u-v⟩ \\\\  & =⟨v-u,\\,3v-2u,\\,2u-v⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨v-u,\\,3v-2u,\\,2u-v⟩\\cdot ⟨1,\\,-1,\\,1⟩ \\\\  & =(v-u)\\cdot 1+(3v-2u)\\cdot (-1)+(2u-v)\\cdot 1 \\\\  & =v-u-3v+2u+2u-v \\\\  & =3u-3v.\\end{aligned}\n$$\n\n \n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨z,\\,y+2z,\\,2x-y⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(3u-3v)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{2}(3u-3v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186401254 :question/problem "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}}-Q\\frac{∂g}{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}}+R)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :db/ensure [:question/validate]} {:db/id "activity-9cb27925-b522-563b-a9ed-d0243cb056b4" :activity/id #uuid "9cb27925-b522-563b-a9ed-d0243cb056b4" :activity/title "Calculating Flux Through Cartesian Surfaces" :activity/type :activity.type/review :activity/scope 17592186048253 :activity/course 17592186046660 :activity/steps ["step-085a5662-c83a-5261-aadd-4e17a1724de2" "step-4dda445a-4e0e-5224-bc48-e70c3bb8a968" "step-d9521b99-85a2-58ce-8fc3-398a930f1cb4" "step-01b09de2-5016-5421-a764-c1a1b5c31868" "step-360e3413-397c-51d3-b4e5-e0b6a144beee"] :activity/first-step "step-085a5662-c83a-5261-aadd-4e17a1724de2" :db/ensure [:activity/validate]} {:db/id "step-085a5662-c83a-5261-aadd-4e17a1724de2" :step/id #uuid "085a5662-c83a-5261-aadd-4e17a1724de2" :step/content 17592186278495 :step/next "step-4dda445a-4e0e-5224-bc48-e70c3bb8a968" :db/ensure [:step/validate]} {:db/id "step-4dda445a-4e0e-5224-bc48-e70c3bb8a968" :step/id #uuid "4dda445a-4e0e-5224-bc48-e70c3bb8a968" :step/content 17592186198610 :step/next "step-d9521b99-85a2-58ce-8fc3-398a930f1cb4" :db/ensure [:step/validate]} {:db/id "step-d9521b99-85a2-58ce-8fc3-398a930f1cb4" :step/id #uuid "d9521b99-85a2-58ce-8fc3-398a930f1cb4" :step/content 17592186278506 :step/next "step-01b09de2-5016-5421-a764-c1a1b5c31868" :db/ensure [:step/validate]} {:db/id "step-01b09de2-5016-5421-a764-c1a1b5c31868" :step/id #uuid "01b09de2-5016-5421-a764-c1a1b5c31868" :step/content 17592186278518 :step/next "step-360e3413-397c-51d3-b4e5-e0b6a144beee" :db/ensure [:step/validate]} {:db/id "step-360e3413-397c-51d3-b4e5-e0b6a144beee" :step/id #uuid "360e3413-397c-51d3-b4e5-e0b6a144beee" :step/content 17592186401254 :db/ensure [:step/validate]} {:db/id 17592186124455 :knowledge-point/questions ["question-b96af04a-99a9-59d6-b4b4-fac54542ff08" "question-ea587ab0-d077-5468-b262-1697c88c7094"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b96af04a-99a9-59d6-b4b4-fac54542ff08" :question/id #uuid "b96af04a-99a9-59d6-b4b4-fac54542ff08" :question/math-academy-id "q-65205" :question/problem "Consider the plane curve $x{e}^{y}-1=xy.$ Find a tangent vector to that curve at the point $(1,0).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}x{e}^{y}-1 & =xy \\\\ x{e}^{y}-xy & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=x{e}^{y}-xy$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve that passes through the point $(1,0)$ can be computed as follows:\n\n$$\nt(1,0)={f}_{y}(1,0)i-{f}_{x}(1,0)j\n$$\n\n \n\nSo, we calculate $t(x,y)$ and evaluate it at $(1,0):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(x{e}^{y}-xy)i-\\frac{∂}{∂x}(x{e}^{y}-xy)j \\\\  & =(x{e}^{y}-x)i-({e}^{y}-y)j \\\\ t(1,0) & =((1){e}^{0}-(1))i-({e}^{0}-(0))j \\\\  & =-j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-j.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f7015fd4-ab37-5009-8ea6-02df343db6e5"] :db/ensure [:question/validate]} {:db/id "answer-field-f7015fd4-ab37-5009-8ea6-02df343db6e5" :answer-field/id #uuid "f7015fd4-ab37-5009-8ea6-02df343db6e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ca1550ba-8b0e-51be-878a-b2b84082b1f0" :answer-field/choices ["answer-9d918342-1efd-5f5f-a70c-62d3002a283b" "answer-b5fcce98-7907-5c3f-8f29-c741eb4b7cca" "answer-7b5ff22c-2612-54bb-bf13-52b4667b899d" "answer-ca1550ba-8b0e-51be-878a-b2b84082b1f0" "answer-39ba8864-9639-569c-861f-6e638330546b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d918342-1efd-5f5f-a70c-62d3002a283b" :answer/id #uuid "9d918342-1efd-5f5f-a70c-62d3002a283b" :answer/type :answer.type/math :answer/value "-i" :db/ensure [:answer/validate]} {:db/id "answer-b5fcce98-7907-5c3f-8f29-c741eb4b7cca" :answer/id #uuid "b5fcce98-7907-5c3f-8f29-c741eb4b7cca" :answer/type :answer.type/math :answer/value "-i+j" :db/ensure [:answer/validate]} {:db/id "answer-7b5ff22c-2612-54bb-bf13-52b4667b899d" :answer/id #uuid "7b5ff22c-2612-54bb-bf13-52b4667b899d" :answer/type :answer.type/math :answer/value "-i-j" :db/ensure [:answer/validate]} {:db/id "answer-ca1550ba-8b0e-51be-878a-b2b84082b1f0" :answer/id #uuid "ca1550ba-8b0e-51be-878a-b2b84082b1f0" :answer/type :answer.type/math :answer/value "-j" :db/ensure [:answer/validate]} {:db/id "answer-39ba8864-9639-569c-861f-6e638330546b" :answer/id #uuid "39ba8864-9639-569c-861f-6e638330546b" :answer/type :answer.type/math :answer/value "i-j" :db/ensure [:answer/validate]} {:db/id "question-ea587ab0-d077-5468-b262-1697c88c7094" :question/id #uuid "ea587ab0-d077-5468-b262-1697c88c7094" :question/math-academy-id "q-72389" :question/problem "Consider the plane curve $2{e}^{xy}=x+y+1.$ Find a tangent vector to that curve at the point $(0,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{e}^{xy} & =x+y+1 \\\\ 2{e}^{xy}-x-y-1 & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{e}^{xy}-x-y-1$, our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve that passes through the point $(0,1)$ can be computed as follows:\n\n$$\nt(0,1)={f}_{y}(0,1)\\,i-{f}_{x}(0,1)\\,j\n$$\n\nSo, we calculate $t(x,y)$ and evaluate it at $(0,1):$\n\n$$\n\\begin{aligned}t(x,y) & =\\frac{∂}{∂y}(2{e}^{xy}-x-y-1)\\,i-\\frac{∂}{∂x}(2{e}^{xy}-x-y-1)\\,j \\\\  & =(2x{e}^{xy}-1)\\,i-(2y{e}^{xy}-1)\\,j \\\\ t(0,1) & =(2(0){e}^{(0)(1)}-1)\\,i-(2(1){e}^{(0)(1)}-1)\\,j \\\\  & =-i-j\\end{aligned}\n$$\n\nTherefore, our tangent vector is $-i-j.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0f7da737-6ab6-5dc3-a356-5e38af59041a"] :db/ensure [:question/validate]} {:db/id "answer-field-0f7da737-6ab6-5dc3-a356-5e38af59041a" :answer-field/id #uuid "0f7da737-6ab6-5dc3-a356-5e38af59041a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0e1052d2-3a28-5ca0-9e37-9f2ccf48871c" :answer-field/choices ["answer-5cf883f8-d823-5d14-9a1b-8d3c64093c5c" "answer-0f687a71-756e-59f6-bc52-a42d2a1ff16b" "answer-0e1052d2-3a28-5ca0-9e37-9f2ccf48871c" "answer-1ac23b03-c1ad-5ab7-be63-a35fc34705f7" "answer-fac357f6-d241-5f53-aa60-7685a0cfadeb"] :db/ensure [:answer-field/validate]} {:db/id "answer-5cf883f8-d823-5d14-9a1b-8d3c64093c5c" :answer/id #uuid "5cf883f8-d823-5d14-9a1b-8d3c64093c5c" :answer/type :answer.type/math :answer/value "-3\\,i-2\\,j" :db/ensure [:answer/validate]} {:db/id "answer-0f687a71-756e-59f6-bc52-a42d2a1ff16b" :answer/id #uuid "0f687a71-756e-59f6-bc52-a42d2a1ff16b" :answer/type :answer.type/math :answer/value "-i-3\\,j" :db/ensure [:answer/validate]} {:db/id "answer-0e1052d2-3a28-5ca0-9e37-9f2ccf48871c" :answer/id #uuid "0e1052d2-3a28-5ca0-9e37-9f2ccf48871c" :answer/type :answer.type/math :answer/value "-i-j" :db/ensure [:answer/validate]} {:db/id "answer-1ac23b03-c1ad-5ab7-be63-a35fc34705f7" :answer/id #uuid "1ac23b03-c1ad-5ab7-be63-a35fc34705f7" :answer/type :answer.type/math :answer/value "2\\,i-3\\,j" :db/ensure [:answer/validate]} {:db/id "answer-fac357f6-d241-5f53-aa60-7685a0cfadeb" :answer/id #uuid "fac357f6-d241-5f53-aa60-7685a0cfadeb" :answer/type :answer.type/math :answer/value "2\\,i-j" :db/ensure [:answer/validate]} {:db/id 17592186124456 :knowledge-point/questions ["question-b5a12ff0-24e0-5963-9f16-1e9a01270fba"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b5a12ff0-24e0-5963-9f16-1e9a01270fba" :question/id #uuid "b5a12ff0-24e0-5963-9f16-1e9a01270fba" :question/math-academy-id "q-72439" :question/problem "At which points on the curve ${y}^{2}-xy=x+1$ is the tangent vector to the curve perpendicular to the vector $i?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}-xy & =x+1 \\\\ {y}^{2}-xy-x & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}-xy-x$, our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}-xy-x)i-\\frac{∂}{∂x}({y}^{2}-xy-x)j \\\\  & =(2y-x)\\,i+(y+1)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i$, we must have $t\\cdot i=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot i & =0 \\\\ ((2y-x)\\,i+(y+1)\\,j)\\cdot i & =0 \\\\ 2y-x & =0 \\\\ x & =2y\\end{aligned}\n$$\n\nSubstituting $x=2y$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}-(2y)y-(2y) & =1 \\\\ {y}^{2}-2{y}^{2}-2y-1 & =0 \\\\ -{y}^{2}-2y-1 & =0 \\\\ {y}^{2}+2y+1 & =0 \\\\ (y+1)^{2} & =0 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally:\n\n- If $y=-1$, we get $x=-2$ and the corresponding point is $(-2,-1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f38fea1a-0a62-5cc4-9aaa-d50dbb5879df"] :db/ensure [:question/validate]} {:db/id "answer-field-f38fea1a-0a62-5cc4-9aaa-d50dbb5879df" :answer-field/id #uuid "f38fea1a-0a62-5cc4-9aaa-d50dbb5879df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2b1f9282-40f6-534c-9cb9-df688ee64de0" :answer-field/choices ["answer-e67fa0c9-ee34-5eea-a810-dee87b7233d9" "answer-d553a226-27d4-508f-a4c8-4c5c6f0cd0cb" "answer-2b1f9282-40f6-534c-9cb9-df688ee64de0" "answer-a70e370b-8012-5ba7-8c81-0ea9db91d6f7" "answer-9c2fce83-b1b2-5397-8cab-576be2461576"] :db/ensure [:answer-field/validate]} {:db/id "answer-e67fa0c9-ee34-5eea-a810-dee87b7233d9" :answer/id #uuid "e67fa0c9-ee34-5eea-a810-dee87b7233d9" :answer/type :answer.type/text :answer/value "$(-1,-2)$  and $(1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-d553a226-27d4-508f-a4c8-4c5c6f0cd0cb" :answer/id #uuid "d553a226-27d4-508f-a4c8-4c5c6f0cd0cb" :answer/type :answer.type/text :answer/value "$(-2,-1)$  and $(1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-2b1f9282-40f6-534c-9cb9-df688ee64de0" :answer/id #uuid "2b1f9282-40f6-534c-9cb9-df688ee64de0" :answer/type :answer.type/text :answer/value "$(-2,-1)$ only" :db/ensure [:answer/validate]} {:db/id "answer-a70e370b-8012-5ba7-8c81-0ea9db91d6f7" :answer/id #uuid "a70e370b-8012-5ba7-8c81-0ea9db91d6f7" :answer/type :answer.type/text :answer/value "$(1,-1)$ only" :db/ensure [:answer/validate]} {:db/id "answer-9c2fce83-b1b2-5397-8cab-576be2461576" :answer/id #uuid "9c2fce83-b1b2-5397-8cab-576be2461576" :answer/type :answer.type/text :answer/value "$(1,2)$ only" :db/ensure [:answer/validate]} {:db/id "activity-5ef3df9a-43f6-544e-9018-3bb84592edfe" :activity/id #uuid "5ef3df9a-43f6-544e-9018-3bb84592edfe" :activity/title "Tangent Lines to Level Curves" :activity/type :activity.type/review :activity/scope 17592186049511 :activity/course 17592186046659 :activity/steps ["step-05a2099a-d88b-5b18-b5ca-d033c5db5614" "step-8b2ff19d-a282-5f52-b7ed-a3b65431ddba" "step-dcad53eb-6ded-5184-a27b-881f5dbfc54b" "step-2f4293a9-a10e-5b28-82a5-1a8b2fd293b4" "step-4cfb1824-7d95-5b0c-8d42-9c86792c679d"] :activity/first-step "step-05a2099a-d88b-5b18-b5ca-d033c5db5614" :db/ensure [:activity/validate]} {:db/id "step-05a2099a-d88b-5b18-b5ca-d033c5db5614" :step/id #uuid "05a2099a-d88b-5b18-b5ca-d033c5db5614" :step/content 17592186124970 :step/next "step-8b2ff19d-a282-5f52-b7ed-a3b65431ddba" :db/ensure [:step/validate]} {:db/id "step-8b2ff19d-a282-5f52-b7ed-a3b65431ddba" :step/id #uuid "8b2ff19d-a282-5f52-b7ed-a3b65431ddba" :step/content "question-b96af04a-99a9-59d6-b4b4-fac54542ff08" :step/next "step-dcad53eb-6ded-5184-a27b-881f5dbfc54b" :db/ensure [:step/validate]} {:db/id "step-dcad53eb-6ded-5184-a27b-881f5dbfc54b" :step/id #uuid "dcad53eb-6ded-5184-a27b-881f5dbfc54b" :step/content "question-ea587ab0-d077-5468-b262-1697c88c7094" :step/next "step-2f4293a9-a10e-5b28-82a5-1a8b2fd293b4" :db/ensure [:step/validate]} {:db/id "step-2f4293a9-a10e-5b28-82a5-1a8b2fd293b4" :step/id #uuid "2f4293a9-a10e-5b28-82a5-1a8b2fd293b4" :step/content "question-b5a12ff0-24e0-5963-9f16-1e9a01270fba" :step/next "step-4cfb1824-7d95-5b0c-8d42-9c86792c679d" :db/ensure [:step/validate]} {:db/id "step-4cfb1824-7d95-5b0c-8d42-9c86792c679d" :step/id #uuid "4cfb1824-7d95-5b0c-8d42-9c86792c679d" :step/content 17592186363031 :db/ensure [:step/validate]} {:db/id 17592186138430 :knowledge-point/questions ["question-d4a7e4f5-44ad-5538-a987-14a969b63b6d" "question-ab23edc2-70be-5457-b5af-37bf9a82da09"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138166 :question/problem "The force $F,$ measured in $\\text{kg}\\, \\text m / \\text s^2$, applied to a motorcycle varies directly with its acceleration $a,$ measured in $\\textrm{m}/\\textrm{s}^2.$ When the acceleration of the motorcycle is $a=5\\,\\textrm{m}/\\textrm{s}^2,$ the force is $F=2\\,000\\,\\text{kg}\\, \\text m / \\text s^2.$ What is the constant of variation?" :question/worked-solution "The force $F$ is directly proportional to the acceleration $a,$ so we have\n\n$$\nF = k{a},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that when the acceleration is $a=5\\, \\textrm{m}/\\,\\textrm{s}^2,$ the force is $F=2\\,000\\,\\text{kg}\\, \\text m / \\text s^2.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}2\\,000 & =k\\cdot (5) \\\\ 2\\,000 & =5k \\\\ \\frac{2\\,000}{5} & =k \\\\ 400 & =k\\end{aligned}\n$$\n\nFinally, since $k = \\dfrac{F}{a},$ we have that the units of $k$ are\n\n$$\n\\begin{aligned}\\frac{{\\text{kg m/s}}^{2}}{\\text{m}/{\\text{s}}^{2}} & =\\frac{\\text{kg}\\cancel{{\\text{m/s}}^{2}}}{\\cancel{\\text{m}/{\\text{s}}^{2}}} \\\\  & =\\text{kg}.\\end{aligned}\n$$\n\nTherefore, our final answer is $k = 400\\,\\textrm{kg}.$" :db/ensure [:question/validate]} {:db/id 17592186138431 :knowledge-point/questions ["question-db05b6d0-7f2f-569f-a84a-34026d2fb3c2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138168 :question/problem "The stretch $s,$ measured in centimeters $(\\textrm{cm}),$ of a loaded spring varies directly with the load $l,$ measured in grams $(\\mathrm{g}).$ When the load is $l=8\\,\\mathrm{g},$ the stretch is $s=9.6\\,\\mathrm{cm}.$ Find the load when the stretch is $s=7.2\\,\\mathrm{cm}.$" :question/worked-solution "The stretch $s$ is directly proportional to the load $l,$ so we have\n\n$$\ns = k{l},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that when $l=8\\,\\mathrm{g},$ we have $s=9.6\\,\\mathrm{cm}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}9.6 & =k\\cdot (8) \\\\ 9.6 & =8k \\\\ \\frac{9.6}{8} & =k \\\\ 1.2 & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\ns = 1.2l.\n$$\n\nWe can use this equation to find the load when the stretch is $s=7.2\\,\\mathrm{cm},$ as follows:\n\n$$\n\\begin{aligned}l & =\\frac{s}{1.2} \\\\  & =\\frac{7.2}{1.2} \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the load when $s=7.2\\,\\mathrm{cm}$ is $l=6 \\,\\textrm{g}.$" :db/ensure [:question/validate]} {:db/id 17592186138432 :knowledge-point/questions ["question-58ce1cea-1782-532b-bc46-409e39fb6f1c" "question-bcc34549-4b02-5866-8337-252ca34764e3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138171 :question/problem "The force $F$, in newtons ($\\mathrm N$), that an elastic spring exerts on an object varies directly with the **square** of the extension of the spring $L,$ measured in meters. If the force is $F = 4\\,\\mathrm N$ when $L=0.1\\,\\mathrm m,$ then what equation models this situation?" :question/worked-solution "The force $F$ is directly proportional to the square of the spring extension $L$, so we have\n\n$$\nF = kL^2,\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $F=4\\,\\textrm{N}$ when $L=0.1\\,\\textrm m.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}4 & =k\\cdot (0.1)^{2} \\\\ 4 & =k\\cdot 0.01 \\\\ \\frac{4}{0.01} & =k \\\\ 400 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nF = 400L^2.\n$$" :db/ensure [:question/validate]} {:db/id "question-d4a7e4f5-44ad-5538-a987-14a969b63b6d" :question/id #uuid "d4a7e4f5-44ad-5538-a987-14a969b63b6d" :question/math-academy-id "q-120267" :question/problem "The price $P,$ in dollars, of electricity in a certain city is directly proportional to the consumption $C,$ measured in kilowatt-hour ($\\text{kWh}).$ When the consumption is $C=24\\,\\text{kWh},$ the price is $P=$264.$ What is the constant of variation?" :question/worked-solution "The price $P$ is directly proportional to the consumption $C,$ so we have\n\n$$\nP=kC,\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that when the consumption is $C=24\\,\\text{kWh},$ the price is $P=$264.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}264 & =k\\cdot (24) \\\\ 264 & =24k \\\\ \\frac{264}{24} & =k \\\\ 11 & =k\\end{aligned}\n$$\n\nFinally, since $k=\\frac{P}{C},$ we have that the units of $k$ are\n\n$$\n\\begin{aligned}\\frac{\\text{dollars}}{\\text{kWh}} & =\\text{dollars per kilowatt-hour}.\\end{aligned}\n$$\n\nTherefore, our final answer is $k=$11$ per kilowatt-hour." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f89aa7c6-1fef-528f-abe7-c21638260283"] :db/ensure [:question/validate]} {:db/id "answer-field-f89aa7c6-1fef-528f-abe7-c21638260283" :answer-field/id #uuid "f89aa7c6-1fef-528f-abe7-c21638260283" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce533a25-089b-537e-8dde-61ffcb8f0059" :answer-field/choices ["answer-f26961c7-1ca7-5189-b4cf-cdafb8ec8804" "answer-ce533a25-089b-537e-8dde-61ffcb8f0059" "answer-ca5eac2f-debe-569b-8366-35580cfe8d78" "answer-e7ca6b9e-1e40-5500-b6d9-7ef11a2f7b70" "answer-1f94ed45-75ca-5605-8b5a-a84fd9be3ec0"] :db/ensure [:answer-field/validate]} {:db/id "answer-f26961c7-1ca7-5189-b4cf-cdafb8ec8804" :answer/id #uuid "f26961c7-1ca7-5189-b4cf-cdafb8ec8804" :answer/type :answer.type/text :answer/value "$$10$ per kilowatt-hour" :db/ensure [:answer/validate]} {:db/id "answer-ce533a25-089b-537e-8dde-61ffcb8f0059" :answer/id #uuid "ce533a25-089b-537e-8dde-61ffcb8f0059" :answer/type :answer.type/text :answer/value "$$11$  per kilowatt-hour" :db/ensure [:answer/validate]} {:db/id "answer-ca5eac2f-debe-569b-8366-35580cfe8d78" :answer/id #uuid "ca5eac2f-debe-569b-8366-35580cfe8d78" :answer/type :answer.type/text :answer/value "$$12$ per kilowatt-hour" :db/ensure [:answer/validate]} {:db/id "answer-e7ca6b9e-1e40-5500-b6d9-7ef11a2f7b70" :answer/id #uuid "e7ca6b9e-1e40-5500-b6d9-7ef11a2f7b70" :answer/type :answer.type/text :answer/value "$$8$ per kilowatt-hour" :db/ensure [:answer/validate]} {:db/id "answer-1f94ed45-75ca-5605-8b5a-a84fd9be3ec0" :answer/id #uuid "1f94ed45-75ca-5605-8b5a-a84fd9be3ec0" :answer/type :answer.type/text :answer/value "$$9$ per kilowatt-hour" :db/ensure [:answer/validate]} {:db/id "question-ab23edc2-70be-5457-b5af-37bf9a82da09" :question/id #uuid "ab23edc2-70be-5457-b5af-37bf9a82da09" :question/math-academy-id "q-236468" :question/problem "The force $F,$ measured in newtons $(\\text{N})$, needed to extend a spring by some length $l,$ measured in $\\text{m},$ is directly proportional to $l.$ When the extension of the spring is $l=0.005\\,\\text{m},$ the force on the spring is $F=25\\,\\text{N}.$ What is the constant of variation?\n\nThe constant of variation is\n{{field-1}}$\\text{N/m}.$" :question/worked-solution "The force $F$ is directly proportional to the extension $l,$ so we have\n\n$$\nF=kl,\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that when the extension is $l=0.005\\,\\text{m},$ the force is $F=25\\,\\text{N}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}25 & =k\\cdot (0.005) \\\\ 25 & =0.005k \\\\ \\frac{25}{0.005} & =k \\\\ 5\\,000 & =k\\end{aligned}\n$$\n\nFinally, since $k=\\frac{F}{l},$ we have that the units of $k$ are\n\n$$\n\\begin{aligned}\\frac{\\text{N}}{\\text{m}} & =\\text{N/m}.\\end{aligned}\n$$\n\nTherefore, our final answer is $k=5\\,000\\,\\text{N/m}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-52620407-ea92-57d1-b97d-ba8ffdfea5f7"] :db/ensure [:question/validate]} {:db/id "answer-field-52620407-ea92-57d1-b97d-ba8ffdfea5f7" :answer-field/id #uuid "52620407-ea92-57d1-b97d-ba8ffdfea5f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0183e978-f0f7-5e61-91f0-df707d2dabe4" :answer-field/choices ["answer-0183e978-f0f7-5e61-91f0-df707d2dabe4"] :db/ensure [:answer-field/validate]} {:db/id "answer-0183e978-f0f7-5e61-91f0-df707d2dabe4" :answer/id #uuid "0183e978-f0f7-5e61-91f0-df707d2dabe4" :answer/type :answer.type/math :answer/value "5000" :db/ensure [:answer/validate]} {:db/id 17592186138738 :question/problem "The volume of space $V$ a particular gas occupies, measured in liters $(L),$ is directly proportional to its temperature $T,$ measured in Kelvin $(\\text{K}).$ The volume of the gas is $V=48\\,\\text{L}$ when its temperature is $T=360\\,\\text{K}.$ Find the volume of the gas when its temperature is $300\\,\\text{K}.$\n\nThe volume of the gas is\n{{field-1}}$\\text{L}.$" :question/worked-solution "The volume of the gas can be modeled as a direct variation\n\n$$\nV=kT,\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that the gas occupies $V=48\\,\\text{L}$ at $T=360\\,\\text{K}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}48 & =k\\cdot 360 \\\\ \\frac{48}{360} & =k \\\\ \\frac{2}{15} & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\nV=\\frac{2}{15}T.\n$$\n\nWe can use this equation to find the volume occupied by the gas when $T=300\\,\\text{K}$:\n\n$$\nV=\\frac{2}{15}\\cdot 300=40\n$$\n\nTherefore, when the temperature of the gas is $300\\,\\text{K},$ its volume is $40\\,\\text{L}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186135494 :answer-field/correct "answer-2d044086-0ee3-503c-9c68-39695bdbd252" :answer-field/choices ["answer-2d044086-0ee3-503c-9c68-39695bdbd252"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d044086-0ee3-503c-9c68-39695bdbd252" :answer/id #uuid "2d044086-0ee3-503c-9c68-39695bdbd252" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "question-db05b6d0-7f2f-569f-a84a-34026d2fb3c2" :question/id #uuid "db05b6d0-7f2f-569f-a84a-34026d2fb3c2" :question/math-academy-id "q-116379" :question/problem "The amount of bleach $b,$ measured in gallons ($gal$), in a certain detergent product varies directly with the amount of water $w,$ measured in gallons, in the product. When the amount of bleach is $b=1.25\\,gal,$ the amount of water is $w=3.75\\,gal.$ Find the amount of bleach when the amount of water is $w=9\\,gal.$" :question/worked-solution "The amount of bleach $b$ is directly proportional to the amount of water $w,$ so we have\n\n$$\nb=kw.\n$$\n\nWe are told that when the amount of bleach is $b=1.25\\,gal,$ the amount of water is $w=3.75\\,gal.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}1.25 & =k\\cdot (3.75) \\\\ 1.25 & =3.75k \\\\ \\frac{1.25}{3.75} & =k \\\\ \\frac{1}{3} & =k\\end{aligned}\n$$\n\nWe now have the equation\n\n$$\nb=\\frac{1}{3}w.\n$$\n\nWe can use this equation to find the amount of bleach when the amount of water is  $w=9\\,gal,$ as follows:\n\n$$\nb=\\frac{1}{3}\\cdot (9)=3\n$$\n\nTherefore, the amount of bleach when $w=9\\,gal$ is $b=3\\,\\text{gal}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-66ac539c-1bae-55e9-b4d4-dd3955107d53"] :db/ensure [:question/validate]} {:db/id "answer-field-66ac539c-1bae-55e9-b4d4-dd3955107d53" :answer-field/id #uuid "66ac539c-1bae-55e9-b4d4-dd3955107d53" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e1fd269-64ac-5cb9-a215-b63ceb27fc80" :answer-field/choices ["answer-eb3d929f-a284-5d04-9531-bbd2d160416a" "answer-dfbebcfc-0bf6-59d0-b330-74754c1eba0e" "answer-8e1fd269-64ac-5cb9-a215-b63ceb27fc80" "answer-ab1c1d7e-46a2-51a8-b2a2-114e1301182c" "answer-18a2f508-0d3f-5485-b4c9-6bc0c4278ca5"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb3d929f-a284-5d04-9531-bbd2d160416a" :answer/id #uuid "eb3d929f-a284-5d04-9531-bbd2d160416a" :answer/type :answer.type/math :answer/value "2.25\\,\\text{gal}" :db/ensure [:answer/validate]} {:db/id "answer-dfbebcfc-0bf6-59d0-b330-74754c1eba0e" :answer/id #uuid "dfbebcfc-0bf6-59d0-b330-74754c1eba0e" :answer/type :answer.type/math :answer/value "27\\,\\text{gal}" :db/ensure [:answer/validate]} {:db/id "answer-8e1fd269-64ac-5cb9-a215-b63ceb27fc80" :answer/id #uuid "8e1fd269-64ac-5cb9-a215-b63ceb27fc80" :answer/type :answer.type/math :answer/value "3\\,\\text{gal}" :db/ensure [:answer/validate]} {:db/id "answer-ab1c1d7e-46a2-51a8-b2a2-114e1301182c" :answer/id #uuid "ab1c1d7e-46a2-51a8-b2a2-114e1301182c" :answer/type :answer.type/math :answer/value "6\\,\\text{gal}" :db/ensure [:answer/validate]} {:db/id "answer-18a2f508-0d3f-5485-b4c9-6bc0c4278ca5" :answer/id #uuid "18a2f508-0d3f-5485-b4c9-6bc0c4278ca5" :answer/type :answer.type/math :answer/value "9\\,\\text{gal}" :db/ensure [:answer/validate]} {:db/id "question-58ce1cea-1782-532b-bc46-409e39fb6f1c" :question/id #uuid "58ce1cea-1782-532b-bc46-409e39fb6f1c" :question/math-academy-id "q-116487" :question/problem "The fuel cost $C,$ in dollars per hour, for running a train is directly proportional to the **square** of its speed $v,$ measured in miles per hour. If it costs $$15$ per hour to run a train that moves at a speed of $100$ miles per hour, what equation models this situation?" :question/worked-solution "The fuel cost $C$ is directly proportional to the square of the speed $v,$ so we have\n\n$$\nC=k{v}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $C=15$ dollars per hour when $v=100\\,\\text{mph}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}15 & =k\\cdot {100}^{2} \\\\ 15 & =k\\cdot 10\\,000 \\\\ \\frac{15}{10\\,000} & =k \\\\ 0.0015 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nC=0.0015{v}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a8b9ec7b-af39-5a0f-ac6b-c6ef3096bc15"] :db/ensure [:question/validate]} {:db/id "answer-field-a8b9ec7b-af39-5a0f-ac6b-c6ef3096bc15" :answer-field/id #uuid "a8b9ec7b-af39-5a0f-ac6b-c6ef3096bc15" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6fed4ddb-cbbf-5f1c-a210-5f9a64c7d92c" :answer-field/choices ["answer-6fed4ddb-cbbf-5f1c-a210-5f9a64c7d92c" "answer-dd0a6a5d-4232-555b-8922-a61347f972aa" "answer-ca2276a8-b089-5eaf-91b4-9feb332e28c9" "answer-12b979b7-6e4f-5676-8218-ccaffa35d740" "answer-6887182b-a952-50cd-8cb0-b8ad15fa5b51"] :db/ensure [:answer-field/validate]} {:db/id "answer-6fed4ddb-cbbf-5f1c-a210-5f9a64c7d92c" :answer/id #uuid "6fed4ddb-cbbf-5f1c-a210-5f9a64c7d92c" :answer/type :answer.type/math :answer/value "C=0.0015{v}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-dd0a6a5d-4232-555b-8922-a61347f972aa" :answer/id #uuid "dd0a6a5d-4232-555b-8922-a61347f972aa" :answer/type :answer.type/math :answer/value "C=0.0225{v}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ca2276a8-b089-5eaf-91b4-9feb332e28c9" :answer/id #uuid "ca2276a8-b089-5eaf-91b4-9feb332e28c9" :answer/type :answer.type/math :answer/value "C=0.15v" :db/ensure [:answer/validate]} {:db/id "answer-12b979b7-6e4f-5676-8218-ccaffa35d740" :answer/id #uuid "12b979b7-6e4f-5676-8218-ccaffa35d740" :answer/type :answer.type/math :answer/value "C=6.66v" :db/ensure [:answer/validate]} {:db/id "answer-6887182b-a952-50cd-8cb0-b8ad15fa5b51" :answer/id #uuid "6887182b-a952-50cd-8cb0-b8ad15fa5b51" :answer/type :answer.type/math :answer/value "C=667{v}^{2}" :db/ensure [:answer/validate]} {:db/id "question-bcc34549-4b02-5866-8337-252ca34764e3" :question/id #uuid "bcc34549-4b02-5866-8337-252ca34764e3" :question/math-academy-id "q-116482" :question/problem "At a car rental agency, the charge $C,$ in dollars, for renting a car varies directly with the **square** of the distance  $d$ traveled by the car, measured in miles. If it costs $$5$ to rent a car to drive $20$ miles, then what equation models this situation?" :question/worked-solution "The charge $C$ is directly proportional to the square of the distance $d,$ so we have\n\n$$\nC=k{d}^{2},\n$$\n\nwhere $k$ is the constant of variation.\n\nWe are told that $C=$5$ when $d=20\\,\\text{mi}.$ We can use this information to solve for $k,$ as follows:\n\n$$\n\\begin{aligned}5 & =k\\cdot {20}^{2} \\\\ 5 & =k\\cdot 400 \\\\ \\frac{5}{400} & =k \\\\ \\frac{1}{80} & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nC=\\frac{1}{80}{d}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-270ef63f-3e5e-536c-9d39-f7c20c134b1a"] :db/ensure [:question/validate]} {:db/id "answer-field-270ef63f-3e5e-536c-9d39-f7c20c134b1a" :answer-field/id #uuid "270ef63f-3e5e-536c-9d39-f7c20c134b1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-952f0fad-eee9-5eee-ad0d-09f697bb097f" :answer-field/choices ["answer-e6312e0e-4657-594a-abdf-411d6e729836" "answer-21a503e1-50cb-5b32-98a2-2a6c31f0e6ca" "answer-0c4b80d1-6933-5dca-8089-68049788a17c" "answer-cc4c9be9-340f-5193-9dc3-ebe2c288db65" "answer-952f0fad-eee9-5eee-ad0d-09f697bb097f"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6312e0e-4657-594a-abdf-411d6e729836" :answer/id #uuid "e6312e0e-4657-594a-abdf-411d6e729836" :answer/type :answer.type/math :answer/value "C=20d" :db/ensure [:answer/validate]} {:db/id "answer-21a503e1-50cb-5b32-98a2-2a6c31f0e6ca" :answer/id #uuid "21a503e1-50cb-5b32-98a2-2a6c31f0e6ca" :answer/type :answer.type/math :answer/value "C=80{d}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0c4b80d1-6933-5dca-8089-68049788a17c" :answer/id #uuid "0c4b80d1-6933-5dca-8089-68049788a17c" :answer/type :answer.type/math :answer/value "C=\\frac{1}{20}d" :db/ensure [:answer/validate]} {:db/id "answer-cc4c9be9-340f-5193-9dc3-ebe2c288db65" :answer/id #uuid "cc4c9be9-340f-5193-9dc3-ebe2c288db65" :answer/type :answer.type/math :answer/value "C=\\frac{1}{6\\,400}{d}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-952f0fad-eee9-5eee-ad0d-09f697bb097f" :answer/id #uuid "952f0fad-eee9-5eee-ad0d-09f697bb097f" :answer/type :answer.type/math :answer/value "C=\\frac{1}{80}{d}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186139717 :tutorial/content "A good example of a direct variation model is the distance an object travels when moving at a constant rate. In this case, the corresponding direct variation equation is \n\n$$\nd=vt,\n$$\n\n \n\nwhere \n\n- $d$ is the total distance traveled by the object,\n\n- $t$ is the total time that the object has been traveling, and,\n\n- $v$ is the constant of proportionality, called the **speed** of the object.\n\nFor instance, if an object travels a distance of $24\\,\\textrm m$ in $4$ seconds, then we can substitute $d=24\\,\\textrm m$ and $t=4\\,\\textrm s$ into the above equation and solve for $v,$ as follows:\n\n$$\n\\begin{aligned}24 & =v\\cdot 4 \\\\ \\frac{24}{4} & =v \\\\ 6 & =v\\end{aligned}\n$$\n\nSo, the equation that relates $d$ and $t$ is\n\n$$\nd=6t.\n$$\n\n \n\nOne thing to note is that the constant of proportionality $v = 6$ also has units. So let's work out what these units are.\n\nSince we have\n\n$$\nd = vt,\n$$\n\nit follows that\n\n$$\nv = \\dfrac{d}{t}.\n$$\n\nSo, the units of $v$ are\n\n$$\n\\dfrac{\\textrm m}{\\textrm s} = \\textrm m / \\textrm s.\n$$\n\nTherefore, the constant of proportionality (including its unit) is $v = 6\\, \\textrm m / \\textrm s.$" :db/ensure [:tutorial/validate]} {:db/id 17592186139719 :tutorial/content "When modeling proportional relationships, we sometimes find that a quantity $y$ varies directly with the *square* of a second quantity $x.$ In such cases, we write\n\n$$\ny = kx^2.\n$$\n\nFor example, consider a circle of radius $r,$ measured in centimeters.\n\n![](images/fa/fad3151a754d96d3e4ad97fa812ce7087601cebe7c4ab00f7b3c8cd603b140c0.png)\n\nIt can be shown that the area $A,$ measured in square meters, of a circle varies directly with the *square* of the radius $r.$ Therefore, we have the equation\n\n$$\nA = k r^2.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186138600 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id "activity-7116892c-7fc3-5b1b-aa93-d2dfc9d1e89e" :activity/id #uuid "7116892c-7fc3-5b1b-aa93-d2dfc9d1e89e" :activity/title "Conditions When a Determinant Equals Zero" :activity/type :activity.type/review :activity/scope 17592186049312 :activity/course 17592186046658 :activity/steps ["step-c48a0407-2623-5e3c-b4d7-9d37ae7f101c" "step-e27b814b-a73a-54cb-83e5-018345109fb2" "step-96688804-9fe5-58e3-852b-6c7c9c3bf052" "step-72bae4bc-a32a-5255-ba7a-a875edc0b957" "step-9b5040f7-fe09-55f4-9bb3-3899218d89d2"] :activity/first-step "step-c48a0407-2623-5e3c-b4d7-9d37ae7f101c" :db/ensure [:activity/validate]} {:db/id "step-c48a0407-2623-5e3c-b4d7-9d37ae7f101c" :step/id #uuid "c48a0407-2623-5e3c-b4d7-9d37ae7f101c" :step/content 17592186134393 :step/next "step-e27b814b-a73a-54cb-83e5-018345109fb2" :db/ensure [:step/validate]} {:db/id "step-e27b814b-a73a-54cb-83e5-018345109fb2" :step/id #uuid "e27b814b-a73a-54cb-83e5-018345109fb2" :step/content 17592186134394 :step/next "step-96688804-9fe5-58e3-852b-6c7c9c3bf052" :db/ensure [:step/validate]} {:db/id "step-96688804-9fe5-58e3-852b-6c7c9c3bf052" :step/id #uuid "96688804-9fe5-58e3-852b-6c7c9c3bf052" :step/content 17592186415477 :step/next "step-72bae4bc-a32a-5255-ba7a-a875edc0b957" :db/ensure [:step/validate]} {:db/id "step-72bae4bc-a32a-5255-ba7a-a875edc0b957" :step/id #uuid "72bae4bc-a32a-5255-ba7a-a875edc0b957" :step/content 17592186134414 :step/next "step-9b5040f7-fe09-55f4-9bb3-3899218d89d2" :db/ensure [:step/validate]} {:db/id "step-9b5040f7-fe09-55f4-9bb3-3899218d89d2" :step/id #uuid "9b5040f7-fe09-55f4-9bb3-3899218d89d2" :step/content 17592186272012 :db/ensure [:step/validate]} {:db/id 17592186092374 :knowledge-point/questions ["question-657b78ff-bfd8-5861-b182-c1815c474783"] :db/ensure [:knowledge-point/validate]} {:db/id "question-657b78ff-bfd8-5861-b182-c1815c474783" :question/id #uuid "657b78ff-bfd8-5861-b182-c1815c474783" :question/math-academy-id "q-9534" :question/problem "Find the arc length of the polar curve $r=2{e}^{3\\theta }$ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2{e}^{3\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=6{e}^{3\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{(2{e}^{3\\theta })}^{2}+{(6{e}^{3\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{4{e}^{6\\theta }+36{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{40{e}^{6\\theta }}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{10}{\\int }_{-\\pi /2}^{\\pi /2}{e}^{3\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{2\\sqrt{10}}{3}{e}^{3\\theta }{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-62f08aa4-9c3b-5881-9036-fcd624473552"] :db/ensure [:question/validate]} {:db/id "answer-field-62f08aa4-9c3b-5881-9036-fcd624473552" :answer-field/id #uuid "62f08aa4-9c3b-5881-9036-fcd624473552" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7929dc7-bc71-5a90-8bb2-c5a85e81928b" :answer-field/choices ["answer-39bd8942-8ea6-5f03-b9c2-980c08387095" "answer-a7929dc7-bc71-5a90-8bb2-c5a85e81928b" "answer-3f95ea7f-6aac-57fb-89fc-e3618b1effd6" "answer-e97e245e-6898-5e7c-8a99-3baaa90c0589" "answer-472465ce-5697-565a-b045-a23526f9815c"] :db/ensure [:answer-field/validate]} {:db/id "answer-39bd8942-8ea6-5f03-b9c2-980c08387095" :answer/id #uuid "39bd8942-8ea6-5f03-b9c2-980c08387095" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}+{e}^{-3\\pi /2})" :db/ensure [:answer/validate]} {:db/id "answer-a7929dc7-bc71-5a90-8bb2-c5a85e81928b" :answer/id #uuid "a7929dc7-bc71-5a90-8bb2-c5a85e81928b" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{10}}{3}({e}^{3\\pi /2}-{e}^{-3\\pi /2})" :db/ensure [:answer/validate]} {:db/id "answer-3f95ea7f-6aac-57fb-89fc-e3618b1effd6" :answer/id #uuid "3f95ea7f-6aac-57fb-89fc-e3618b1effd6" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{10}}{3}{e}^{3\\pi /2}" :db/ensure [:answer/validate]} {:db/id "answer-e97e245e-6898-5e7c-8a99-3baaa90c0589" :answer/id #uuid "e97e245e-6898-5e7c-8a99-3baaa90c0589" :answer/type :answer.type/math :answer/value "\\frac{8}{3}{e}^{3\\pi /2}" :db/ensure [:answer/validate]} {:db/id "answer-472465ce-5697-565a-b045-a23526f9815c" :answer/id #uuid "472465ce-5697-565a-b045-a23526f9815c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}({e}^{2\\pi /3}-{e}^{-2\\pi /3})" :db/ensure [:answer/validate]} {:db/id 17592186092373 :knowledge-point/questions ["question-85d77d15-6969-5117-952d-e2b202d58514" "question-d774fdc1-484c-5e5e-b140-afbc35a348d0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-85d77d15-6969-5117-952d-e2b202d58514" :question/id #uuid "85d77d15-6969-5117-952d-e2b202d58514" :question/math-academy-id "q-15123" :question/problem "Which of the following gives the arc length of the polar curve $r=\\theta +\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta +\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=1-\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(\\theta +\\operatorname{cos}⁡\\theta )^{2}+(1-\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{({\\theta }^{2}+2\\theta \\operatorname{cos}⁡\\theta +{cos}^{2}⁡\\theta )+(1-2\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f107053f-9248-55df-a0bd-cf3499751023"] :db/ensure [:question/validate]} {:db/id "answer-field-f107053f-9248-55df-a0bd-cf3499751023" :answer-field/id #uuid "f107053f-9248-55df-a0bd-cf3499751023" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-51cc30b4-2098-5551-9641-1f9551e409a2" :answer-field/choices ["answer-0989efb5-1038-59ac-8680-60117382e68a" "answer-1ce9d6eb-3f8f-56eb-a2d0-a4cfacaf7268" "answer-38d06719-2aef-52ec-b523-72bbe2d5ce07" "answer-52b44f14-c340-50a7-9cae-50d08c357aa5" "answer-51cc30b4-2098-5551-9641-1f9551e409a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-0989efb5-1038-59ac-8680-60117382e68a" :answer/id #uuid "0989efb5-1038-59ac-8680-60117382e68a" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /4}\\sqrt{(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-1ce9d6eb-3f8f-56eb-a2d0-a4cfacaf7268" :answer/id #uuid "1ce9d6eb-3f8f-56eb-a2d0-a4cfacaf7268" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /4}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-38d06719-2aef-52ec-b523-72bbe2d5ce07" :answer/id #uuid "38d06719-2aef-52ec-b523-72bbe2d5ce07" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{2(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-52b44f14-c340-50a7-9cae-50d08c357aa5" :answer/id #uuid "52b44f14-c340-50a7-9cae-50d08c357aa5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+1}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-51cc30b4-2098-5551-9641-1f9551e409a2" :answer/id #uuid "51cc30b4-2098-5551-9641-1f9551e409a2" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}+2(\\theta \\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )+2}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-d774fdc1-484c-5e5e-b140-afbc35a348d0" :question/id #uuid "d774fdc1-484c-5e5e-b140-afbc35a348d0" :question/math-academy-id "q-51202" :question/problem "![](images/87/87a3563153fe0310767a79a96df0df5f6c0824027776b761df4a792b8b9b235e.png)\n\nWhich of the following gives the arc length of the polar curve $r=1-2\\operatorname{cos}⁡\\theta $ for $\\frac{\\pi }{3}\\le \\theta \\le \\pi $ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1-2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{(1-2\\operatorname{cos}⁡\\theta )^{2}+(2\\operatorname{sin}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4{cos}^{2}⁡\\theta +4{sin}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{1-4\\operatorname{cos}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cafcbac5-e575-5e1d-93e5-5e527facd2e3"] :db/ensure [:question/validate]} {:db/id "answer-field-cafcbac5-e575-5e1d-93e5-5e527facd2e3" :answer-field/id #uuid "cafcbac5-e575-5e1d-93e5-5e527facd2e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a35283a7-4adc-5de1-826d-87a387cd4479" :answer-field/choices ["answer-c87b6998-b8e9-5934-9893-be14c9c09927" "answer-160e2a0c-f074-5874-a5f2-17cc1fc2cae2" "answer-d102d768-01d6-510f-bd39-ea2452eac6cc" "answer-6d20f288-51ab-5e95-ad79-fa5df49f89a1" "answer-a35283a7-4adc-5de1-826d-87a387cd4479"] :db/ensure [:answer-field/validate]} {:db/id "answer-c87b6998-b8e9-5934-9893-be14c9c09927" :answer/id #uuid "c87b6998-b8e9-5934-9893-be14c9c09927" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /3}^{\\pi /3}\\sqrt{5+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-160e2a0c-f074-5874-a5f2-17cc1fc2cae2" :answer/id #uuid "160e2a0c-f074-5874-a5f2-17cc1fc2cae2" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /3}\\sqrt{1-4\\operatorname{cos}⁡\\theta +5{cos}^{2}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d102d768-01d6-510f-bd39-ea2452eac6cc" :answer/id #uuid "d102d768-01d6-510f-bd39-ea2452eac6cc" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{3+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6d20f288-51ab-5e95-ad79-fa5df49f89a1" :answer/id #uuid "6d20f288-51ab-5e95-ad79-fa5df49f89a1" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{3-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-a35283a7-4adc-5de1-826d-87a387cd4479" :answer/id #uuid "a35283a7-4adc-5de1-826d-87a387cd4479" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /3}^{\\pi }\\sqrt{5-4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186320241 :answer-field/correct "answer-048e136b-84ec-5868-b091-1a12da7bcf24" :answer-field/choices ["answer-048e136b-84ec-5868-b091-1a12da7bcf24"] :db/ensure [:answer-field/validate]} {:db/id "answer-048e136b-84ec-5868-b091-1a12da7bcf24" :answer/id #uuid "048e136b-84ec-5868-b091-1a12da7bcf24" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{2}(e^{\\pi}-1)" :db/ensure [:answer/validate]} {:db/id "activity-caa1b6ea-7850-5c84-a961-1177d87914d7" :activity/id #uuid "caa1b6ea-7850-5c84-a961-1177d87914d7" :activity/title "The Arc Length of a Polar Curve" :activity/type :activity.type/review :activity/scope 17592186050779 :activity/course 17592186046660 :activity/steps ["step-4ff166b5-1643-51d7-8f4b-ee7431c1594b" "step-db0cc4c9-0bed-5ca2-bb65-0c11a769bc8e" "step-dadf755e-73d7-51d2-8724-9a8bc861f212" "step-2648cacf-aed7-52cf-9142-851e9f4e62e6" "step-f2616e77-5be4-5384-a0e8-bab12d8f6047"] :activity/first-step "step-4ff166b5-1643-51d7-8f4b-ee7431c1594b" :db/ensure [:activity/validate]} {:db/id "step-4ff166b5-1643-51d7-8f4b-ee7431c1594b" :step/id #uuid "4ff166b5-1643-51d7-8f4b-ee7431c1594b" :step/content "question-657b78ff-bfd8-5861-b182-c1815c474783" :step/next "step-db0cc4c9-0bed-5ca2-bb65-0c11a769bc8e" :db/ensure [:step/validate]} {:db/id "step-db0cc4c9-0bed-5ca2-bb65-0c11a769bc8e" :step/id #uuid "db0cc4c9-0bed-5ca2-bb65-0c11a769bc8e" :step/content "question-85d77d15-6969-5117-952d-e2b202d58514" :step/next "step-dadf755e-73d7-51d2-8724-9a8bc861f212" :db/ensure [:step/validate]} {:db/id "step-dadf755e-73d7-51d2-8724-9a8bc861f212" :step/id #uuid "dadf755e-73d7-51d2-8724-9a8bc861f212" :step/content 17592186401014 :step/next "step-2648cacf-aed7-52cf-9142-851e9f4e62e6" :db/ensure [:step/validate]} {:db/id "step-2648cacf-aed7-52cf-9142-851e9f4e62e6" :step/id #uuid "2648cacf-aed7-52cf-9142-851e9f4e62e6" :step/content "question-d774fdc1-484c-5e5e-b140-afbc35a348d0" :step/next "step-f2616e77-5be4-5384-a0e8-bab12d8f6047" :db/ensure [:step/validate]} {:db/id "step-f2616e77-5be4-5384-a0e8-bab12d8f6047" :step/id #uuid "f2616e77-5be4-5384-a0e8-bab12d8f6047" :step/content 17592186321141 :db/ensure [:step/validate]} {:db/id 17592186129197 :knowledge-point/questions ["question-5e32ec93-9a95-5b63-b1e8-8733a4d5c7af"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5e32ec93-9a95-5b63-b1e8-8733a4d5c7af" :question/id #uuid "5e32ec93-9a95-5b63-b1e8-8733a4d5c7af" :question/math-academy-id "q-82910" :question/problem "Using the change of variables \n\n$$\nu=x+y,\\,v=y,\n$$\n\ncalculate the area of the finite region $D$ bounded by the curves $(x+y)^{3}-y=0$ and $(x+y)^{2}-y=0.$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=x+y,\\,v=y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $x+y=u$ and $y=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(x+y)^{3}-y=0\\,⟹\\,{u}^{3}-v=0\\,⟹\\,v={u}^{3},\\end{aligned}\n$$\n\nwhile substituting $x+y=u$ and $y=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}(x+y)^{2}-y=0\\,⟹\\,{u}^{2}-v=0\\,⟹\\,v={u}^{2}.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}v={u}^{3} \\\\ v={u}^{2}\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{u}^{2}(u-1)=0 \\\\ v=u.\\end{aligned}\\end{aligned}\n$$\n\nSo, the intersection points are $(0,0)$ and $(1,1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation \n\n$$\nΔ=\\{(u,v)\\,:\\,0\\le u\\le 1,\\,{u}^{3}\\le v\\le {u}^{2}\\}.\n$$\n\n![](images/a8/a8d2549c665a918cc8d69c69136fcb49e654ebb9aa5e53611155798e791b36a9.png)\n\n   \n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}| \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=(1)^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{0}^{1}[{\\int }_{{u}^{3}}^{{u}^{2}}\\,dv]du \\\\  & ={\\int }_{0}^{1}v{|}_{{u}^{3}}^{{u}^{2}}\\,du \\\\  & ={\\int }_{0}^{1}({u}^{2}-{u}^{3})du \\\\  & ={[\\frac{{u}^{3}}{3}-\\frac{{u}^{4}}{4}]}_{0}^{1} \\\\  & =\\frac{1}{3}-\\frac{1}{4} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-06575685-8b6e-5313-b708-d919a2eb705b"] :db/ensure [:question/validate]} {:db/id "answer-field-06575685-8b6e-5313-b708-d919a2eb705b" :answer-field/id #uuid "06575685-8b6e-5313-b708-d919a2eb705b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b1f2bf6-1e84-5da8-8223-f7a8617abe63" :answer-field/choices ["answer-3b1f2bf6-1e84-5da8-8223-f7a8617abe63" "answer-aaa17f5a-3932-5a85-be4a-9e7f8aca50c3" "answer-e507ffc4-50dc-56ba-8db0-2ce573a2305a" "answer-af9d5967-0e62-5e9c-80be-bb9563606efe" "answer-17418eda-e303-583e-abb8-8163f34cf65c"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b1f2bf6-1e84-5da8-8223-f7a8617abe63" :answer/id #uuid "3b1f2bf6-1e84-5da8-8223-f7a8617abe63" :answer/type :answer.type/math :answer/value "\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "answer-aaa17f5a-3932-5a85-be4a-9e7f8aca50c3" :answer/id #uuid "aaa17f5a-3932-5a85-be4a-9e7f8aca50c3" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-e507ffc4-50dc-56ba-8db0-2ce573a2305a" :answer/id #uuid "e507ffc4-50dc-56ba-8db0-2ce573a2305a" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-af9d5967-0e62-5e9c-80be-bb9563606efe" :answer/id #uuid "af9d5967-0e62-5e9c-80be-bb9563606efe" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-17418eda-e303-583e-abb8-8163f34cf65c" :answer/id #uuid "17418eda-e303-583e-abb8-8163f34cf65c" :answer/type :answer.type/math :answer/value "\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id 17592186373339 :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=y+3x,\\,v=x\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nSubstituting $y+3x=u$ and $x=v$ into the equation of the first curve, we get\n\n$$\n\\begin{aligned}(y+3x)^{2}-x=3\\,⟹\\,{u}^{2}-v=3\\,⟹\\,v={u}^{2}-3,\\end{aligned}\n$$\n\nwhile substituting $x=v$ into the equation of the second curve, we obtain\n\n$$\n\\begin{aligned}x=1\\,⟹\\,v=1.\\end{aligned}\n$$\n\nTo find the intersections of the curves in the $uv$-plane, we solve the following system:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}v={u}^{2}-3 \\\\ v=1\\end{aligned}\\,⟹\\,\\{\\begin{aligned}u=\\pm 2 \\\\ v=1.\\end{aligned}\\end{aligned}\n$$\n\nSo, the intersection points are $(\\pm 2,1).$\n\nTherefore, our domain in the $uv$-plane has the type I representation\n\n$$\nΔ=\\{(u,v)\\,:\\,-2\\le u\\le 2,\\,{u}^{2}-3\\le v\\le 1\\}.\n$$\n\n![](images/26/2687f0cc14eb0b476ea5f4ba7272e7f248bb7dcb276a0e2b0c39e551501b011d.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 1 & 0\\end{aligned}| \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=(-1)^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-1|\\text{d}u\\text{d}v \\\\  & ={\\int }_{-2}^{2}[{\\int }_{{u}^{2}-3}^{1}\\,dv]du \\\\  & ={\\int }_{-2}^{2}[v]_{{u}^{2}-3}^{1}\\,du \\\\  & ={\\int }_{-2}^{2}(1-({u}^{2}-3))\\,du \\\\  & ={\\int }_{-2}^{2}(4-{u}^{2})\\,du \\\\  & ={[4u-\\frac{{u}^{3}}{3}]}_{-2}^{2} \\\\  & =16-\\frac{16}{3} \\\\  & =\\frac{32}{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186129262 :knowledge-point/questions ["question-77ed6de7-60cd-57e5-95ef-8b1b61a0f9cb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-77ed6de7-60cd-57e5-95ef-8b1b61a0f9cb" :question/id #uuid "77ed6de7-60cd-57e5-95ef-8b1b61a0f9cb" :question/math-academy-id "q-160638" :question/problem "Use a change of variables to calculate the area of the finite region $D$ in the first quadrant bounded by the following curves and lines.\n\n$$\ny=\\frac{5}{{e}^{x}},\\,y=\\frac{12}{{e}^{x}},\\,2y-1=0,\\,2y-5=0\n$$" :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n{e}^{x}y=5,\\,{e}^{x}y=12,\\,2y=1,\\,2y=5\n$$\n\nThis suggests the following change of variables:\n\n$$\nu={e}^{x}y,\\,v=2y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u={e}^{x}y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & {e}^{x}y=5\\,\\text{ }\\,⟹\\,u=5 \\\\  & {e}^{x}y=12\\,⟹\\,u=12\\end{aligned}\n$$\n\nAnd we substitute $v=2y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & 2y=1\\,⟹\\,v=1 \\\\  & 2y=5\\,⟹\\,v=5\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,5\\le u\\le 12,\\,1\\le v\\le 5\\}\n$$\n\n![](images/61/615d6822e60e9b5ff646497e14df1468e1fd09ee67fab5c334b635d130f16f14.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{x}y & {e}^{x} \\\\ 0 & 2\\end{aligned}| \\\\  & =2{e}^{x}y \\\\  & =2u.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=\\frac{1}{2u}.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|\\frac{1}{2u}|\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{∬}_{Δ}\\frac{1}{u}\\,\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{5}^{12}\\frac{1}{u}\\,\\text{d}u{\\int }_{1}^{5}\\,\\text{d}v \\\\  & =\\frac{1}{2}\\cdot (\\operatorname{ln}⁡(12)-\\operatorname{ln}⁡(5))\\cdot (5-1) \\\\  & =2\\operatorname{ln}⁡(\\frac{12}{5})\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fecc3609-91c7-5f66-a205-ec1648ad9bd1"] :db/ensure [:question/validate]} {:db/id "answer-field-fecc3609-91c7-5f66-a205-ec1648ad9bd1" :answer-field/id #uuid "fecc3609-91c7-5f66-a205-ec1648ad9bd1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1e226dc-7e0d-534a-9b5e-f226b2636d31" :answer-field/choices ["answer-f378af41-a686-5292-9362-123eea7e70ea" "answer-e1e226dc-7e0d-534a-9b5e-f226b2636d31" "answer-2b9b4ef9-8eb6-5c5c-b433-5ffc4c7236ae" "answer-88676aa6-a08b-583a-a6f9-2618bd726361" "answer-5e8c6c00-5b20-53bc-acb7-b0b31ab2298d"] :db/ensure [:answer-field/validate]} {:db/id "answer-f378af41-a686-5292-9362-123eea7e70ea" :answer/id #uuid "f378af41-a686-5292-9362-123eea7e70ea" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(60)" :db/ensure [:answer/validate]} {:db/id "answer-e1e226dc-7e0d-534a-9b5e-f226b2636d31" :answer/id #uuid "e1e226dc-7e0d-534a-9b5e-f226b2636d31" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(\\frac{12}{5})" :db/ensure [:answer/validate]} {:db/id "answer-2b9b4ef9-8eb6-5c5c-b433-5ffc4c7236ae" :answer/id #uuid "2b9b4ef9-8eb6-5c5c-b433-5ffc4c7236ae" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(\\frac{5}{12})" :db/ensure [:answer/validate]} {:db/id "answer-88676aa6-a08b-583a-a6f9-2618bd726361" :answer/id #uuid "88676aa6-a08b-583a-a6f9-2618bd726361" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{12}{5})" :db/ensure [:answer/validate]} {:db/id "answer-5e8c6c00-5b20-53bc-acb7-b0b31ab2298d" :answer/id #uuid "5e8c6c00-5b20-53bc-acb7-b0b31ab2298d" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{5}{12})" :db/ensure [:answer/validate]} {:db/id 17592186371886 :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nWe'll assume this transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv,\n$$\n\n  \n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required area, we proceed in five steps:\n\n**Step 1**: Find a suitable change of variables.\n\nNotice that we can rewrite the equations of our curves as follows:\n\n$$\n4x-3y=-1,\\,4x-3y=2,\\,3x-2y=1,\\,3x-2y=3\n$$\n\nThis suggests the following change of variables:\n\n$$\nu=4x-3y,\\,v=3x-2y\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=4x-3y$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & 4x-3y=-1\\,⟹\\,u=-1 \\\\  & 4x-3y=2\\,⟹\\,u=2\\end{aligned}\n$$\n\nAnd we substitute $v=3x-2y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & 3x-2y=1\\,⟹\\,v=1 \\\\  & 3x-2y=3\\,⟹\\,v=3\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,-1\\le u\\le 2,\\,1\\le v\\le 3\\}\n$$\n\n![](images/5d/5dc4be989300dca3e52b7ff1dfb6a21c60409976fe55d42f5ae530f033725a64.png)\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}4 & -3 \\\\ 3 & -2\\end{aligned}| \\\\  & =-8+9 \\\\  & =1.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=1.\n$$\n\nNote that $\\frac{∂(u,v)}{∂(x,y)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|1|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{-1}^{2}\\,\\text{d}u{\\int }_{1}^{3}\\,\\text{d}v \\\\  & =(2-(-1))\\cdot (3-1) \\\\  & =6\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186371913 :question/worked-solution "The area of the required region is given by\n\n$$\n{∬}_{D}dxdy.\n$$\n\nLet's define a transformation $T$ as follows: \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required area, we will use the change of variables formula\n\n$$\n{∬}_{D}dxdy={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$  \n\nNote that the changes of variables\n\n$$\nu=\\frac{1}{xy},\\,v={x}^{2}y\n$$\n\n \n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required area, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nWe substitute $u=\\frac{1}{xy}$ into the equations of the first and second curves:\n\n$$\n\\begin{aligned} & y=\\frac{1}{2x} & ⟹\\, & \\frac{1}{xy}=2 & ⟹\\, & u=2 \\\\  & y=\\frac{1}{3x} & ⟹\\, & \\frac{1}{xy}=3 & ⟹\\, & u=3\\end{aligned}\n$$\n\nAnd we substitute $v={x}^{2}y$ into the equations of the third and fourth curves:\n\n$$\n\\begin{aligned} & y=\\frac{1}{{x}^{2}} & ⟹\\, & {x}^{2}y=1 & ⟹\\, & v=1 \\\\  & y=\\frac{3}{{x}^{2}} & ⟹\\, & {x}^{2}y=3 & ⟹\\, & v=3\\end{aligned}\n$$\n\nTherefore, our domain in the $uv$-plane is the following rectangle:\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 3,\\,1\\le v\\le 3\\}\n$$\n\n![](images/05/05d2ca47db245b147cb52f95a474a60ece144931c8b6e1e40c6628a99b53d690.png)\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{1}{{x}^{2}y} & -\\frac{1}{x{y}^{2}} \\\\ 2xy & \\text{ }\\text{ }{x}^{2}\\end{aligned}| \\\\  & =\\frac{1}{y}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={(\\frac{∂(u,v)}{∂(x,y)})}^{-1}=y=\\frac{{x}^{2}{y}^{2}}{{x}^{2}y}=\\frac{1}{{u}^{2}v}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$  In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Compute the required area.\n\nWe calculate the required area by performing the change of variables:\n\n$$\n\\begin{aligned}{∬}_{D}\\text{d}x\\text{d}y & ={∬}_{Δ}|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}|-\\frac{1}{{u}^{2}v}|\\,\\text{d}u\\text{d}v \\\\  & ={\\int }_{2}^{3}{\\int }_{1}^{3}\\frac{1}{{u}^{2}v}\\,\\text{d}u\\,\\text{d}v \\\\  & ={\\int }_{2}^{3}\\frac{1}{{u}^{2}}\\,\\text{d}u{\\int }_{1}^{3}\\frac{1}{v}\\,\\text{d}v \\\\  & =(-\\frac{1}{3}+\\frac{1}{2})\\cdot (\\operatorname{ln}⁡3-\\operatorname{ln}⁡1) \\\\  & =\\frac{1}{6}\\operatorname{ln}⁡3.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-f2bc7a10-1a64-5702-870d-eb64ad2d650c" :activity/id #uuid "f2bc7a10-1a64-5702-870d-eb64ad2d650c" :activity/title "Computing Areas Using a Change of Variables" :activity/type :activity.type/review :activity/scope 17592186050705 :activity/course 17592186046659 :activity/steps ["step-486db070-d151-53d7-9850-f2f093b172d4" "step-0aa5fab4-668b-577d-91a3-ac72b6d14200" "step-2fc3ef89-3fe1-5a0b-b8af-8112d233e0f3" "step-a2e7eed7-b052-54ef-bf9d-8a28ecab7ca6" "step-01bfa9b8-ea54-5e15-adea-d773f4a9fc72"] :activity/first-step "step-486db070-d151-53d7-9850-f2f093b172d4" :db/ensure [:activity/validate]} {:db/id "step-486db070-d151-53d7-9850-f2f093b172d4" :step/id #uuid "486db070-d151-53d7-9850-f2f093b172d4" :step/content "question-5e32ec93-9a95-5b63-b1e8-8733a4d5c7af" :step/next "step-0aa5fab4-668b-577d-91a3-ac72b6d14200" :db/ensure [:step/validate]} {:db/id "step-0aa5fab4-668b-577d-91a3-ac72b6d14200" :step/id #uuid "0aa5fab4-668b-577d-91a3-ac72b6d14200" :step/content 17592186373339 :step/next "step-2fc3ef89-3fe1-5a0b-b8af-8112d233e0f3" :db/ensure [:step/validate]} {:db/id "step-2fc3ef89-3fe1-5a0b-b8af-8112d233e0f3" :step/id #uuid "2fc3ef89-3fe1-5a0b-b8af-8112d233e0f3" :step/content "question-77ed6de7-60cd-57e5-95ef-8b1b61a0f9cb" :step/next "step-a2e7eed7-b052-54ef-bf9d-8a28ecab7ca6" :db/ensure [:step/validate]} {:db/id "step-a2e7eed7-b052-54ef-bf9d-8a28ecab7ca6" :step/id #uuid "a2e7eed7-b052-54ef-bf9d-8a28ecab7ca6" :step/content 17592186371886 :step/next "step-01bfa9b8-ea54-5e15-adea-d773f4a9fc72" :db/ensure [:step/validate]} {:db/id "step-01bfa9b8-ea54-5e15-adea-d773f4a9fc72" :step/id #uuid "01bfa9b8-ea54-5e15-adea-d773f4a9fc72" :step/content 17592186371913 :db/ensure [:step/validate]} [:db/retract 17592186107381 :answer-field/choices 17592186107382] [:db/retract 17592186107381 :answer-field/choices 17592186107383] [:db/retract 17592186107381 :answer-field/choices 17592186107384] [:db/retract 17592186107381 :answer-field/choices 17592186107385] [:db/retract 17592186107381 :answer-field/choices 17592186107386] [:db/retract 17592186108275 :answer-field/choices 17592186108276] [:db/retract 17592186108275 :answer-field/choices 17592186108277] [:db/retract 17592186108275 :answer-field/choices 17592186108278] [:db/retract 17592186108275 :answer-field/choices 17592186108279] [:db/retract 17592186108275 :answer-field/choices 17592186108280] {:db/id 17592186110661 :knowledge-point/questions ["question-8bcb7c88-fa9c-5de4-82d6-48872f12ed89"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110299 :question/problem "Simplify the expression $\\left(x^2y\\right)^3\\cdot x^2y.$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{({x}^{2}y)}^{3}\\cdot {x}^{2}y= &  \\\\ {({x}^{2})}^{3}\\cdot {y}^{3}\\cdot {x}^{2}y & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2\\cdot 3}\\cdot {y}^{3}\\cdot {x}^{2}y & = \\\\ {x}^{6}\\cdot {y}^{3}\\cdot {x}^{2}y & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{6}\\cdot {y}^{3}\\cdot {x}^{2}y= &  \\\\ {x}^{6}\\cdot {x}^{2}\\cdot {y}^{3}\\cdot y= &  \\\\ {x}^{6+2}\\cdot {y}^{3+1} & = \\\\ {x}^{8}\\cdot {y}^{4} & = \\\\ {x}^{8}{y}^{4} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186110662 :knowledge-point/questions ["question-e0110074-4c62-517f-b5cb-ff4cff4e0579"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110300 :question/problem "Given that $a=2x^3$ and $b=\\dfrac{x}{y},$ express $ab^2$ in terms of $x$ and $y.$" :question/worked-solution "First, we substitute for $a$ and $b\\mathbin{:}$\n\n$$\n\\begin{aligned}a{b}^{2}=2{x}^{3}{(\\frac{x}{y})}^{2}\\end{aligned}\n$$\n\nThen, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}2{x}^{3}{(\\frac{x}{y})}^{2}=2{x}^{3}(\\frac{{x}^{2}}{{y}^{2}})\\end{aligned}\n$$\n\nFinally, we multiply and apply the product rule:\n\n$$\n\\begin{aligned}2{x}^{3}(\\frac{{x}^{2}}{{y}^{2}}) & = \\\\ \\frac{2{x}^{3}\\cdot {x}^{2}}{{y}^{2}} & = \\\\ \\frac{2{x}^{3+2}}{{y}^{2}} & = \\\\ \\frac{2{x}^{5}}{{y}^{2}} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186110663 :knowledge-point/questions ["question-842d5936-85a3-5b6e-b4fa-f505a9d0860b" "question-64c8a090-cafc-5e88-b591-72ecb0cc7b81" "question-af52435b-8d7b-5fb6-b052-723de06fafd6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110301 :question/problem "Simplify the expression $\\dfrac {\\sqrt{y}} {\\sqrt[3]{y}}.$" :question/worked-solution "First, we rewrite the radicals as fractional exponents:\n\n$$\n\\begin{aligned}\\frac{\\sqrt{y}}{\\sqrt[3]{y}}=\\frac{{y}^{1/2}}{{y}^{1/3}}\\end{aligned}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{1/2}}{{y}^{1/3}} & = \\\\ {y}^{1/2-1/3} & = \\\\ {y}^{3/6-2/6} & = \\\\ {y}^{1/6}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{1/6}=\\sqrt[6]{y}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186110915 :question/problem "${(x{y}^{2})}^{2}\\cdot xy=$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{(x{y}^{2})}^{2}\\cdot xy={x}^{2}\\cdot ({y}^{2})^{2}\\cdot xy & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot ({y}^{2})^{2}\\cdot xy & = \\\\ {x}^{2}\\cdot {y}^{2\\cdot 2}\\cdot xy & = \\\\ {x}^{2}\\cdot {y}^{4}\\cdot xy & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {y}^{4}\\cdot xy & = \\\\ ({x}^{2}\\cdot x)\\cdot ({y}^{4}\\cdot y) & = \\\\ {x}^{2+1}\\cdot {y}^{4+1} & = \\\\ {x}^{3}\\cdot {y}^{5} & = \\\\ {x}^{3}{y}^{5} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186107381 :answer-field/correct "answer-c6c5e286-786c-531a-9d5c-0e950304344b" :answer-field/choices ["answer-f782fcb1-f0ea-5483-a7e2-650059b3d532" "answer-7a323d59-5faf-5c86-b1dd-4ba95d8c8921" "answer-3c756396-e727-5a1d-b715-610a47f49def" "answer-c6c5e286-786c-531a-9d5c-0e950304344b" "answer-b80387b4-edd3-5386-acd2-762477d07957"] :db/ensure [:answer-field/validate]} {:db/id "answer-f782fcb1-f0ea-5483-a7e2-650059b3d532" :answer/id #uuid "f782fcb1-f0ea-5483-a7e2-650059b3d532" :answer/type :answer.type/math :answer/value "{x}^{2}{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-7a323d59-5faf-5c86-b1dd-4ba95d8c8921" :answer/id #uuid "7a323d59-5faf-5c86-b1dd-4ba95d8c8921" :answer/type :answer.type/math :answer/value "{x}^{2}{y}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-3c756396-e727-5a1d-b715-610a47f49def" :answer/id #uuid "3c756396-e727-5a1d-b715-610a47f49def" :answer/type :answer.type/math :answer/value "{x}^{2}{y}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-c6c5e286-786c-531a-9d5c-0e950304344b" :answer/id #uuid "c6c5e286-786c-531a-9d5c-0e950304344b" :answer/type :answer.type/math :answer/value "{x}^{3}{y}^{5}" :db/ensure [:answer/validate]} {:db/id "answer-b80387b4-edd3-5386-acd2-762477d07957" :answer/id #uuid "b80387b4-edd3-5386-acd2-762477d07957" :answer/type :answer.type/math :answer/value "{x}^{4}{y}^{8}" :db/ensure [:answer/validate]} {:db/id "question-8bcb7c88-fa9c-5de4-82d6-48872f12ed89" :question/id #uuid "8bcb7c88-fa9c-5de4-82d6-48872f12ed89" :question/math-academy-id "q-141984" :question/problem "${({a}^{2}b)}^{3}\\cdot ab=$" :question/worked-solution "We start by using the power of product rule:\n\n$$\n\\begin{aligned}{({a}^{2}b)}^{3}\\cdot ab=({a}^{2})^{3}\\cdot {b}^{3}\\cdot ab & \\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}({a}^{2})^{3}\\cdot {b}^{3}\\cdot ab & = \\\\ {a}^{2\\cdot 3}\\cdot {b}^{3}\\cdot ab & = \\\\ {a}^{6}\\cdot {b}^{3}\\cdot ab & \\end{aligned}\n$$\n\nFinally, we use the product rule:\n\n$$\n\\begin{aligned}{a}^{6}\\cdot {b}^{3}\\cdot ab & = \\\\ ({a}^{6}\\cdot a)\\cdot ({b}^{3}\\cdot b) & = \\\\ {a}^{6+1}\\cdot {b}^{3+1} & = \\\\ {a}^{7}\\cdot {b}^{4} & = \\\\ {a}^{7}{b}^{4} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-262de599-4be0-58c1-8c31-b5e8da1d1817"] :db/ensure [:question/validate]} {:db/id "answer-field-262de599-4be0-58c1-8c31-b5e8da1d1817" :answer-field/id #uuid "262de599-4be0-58c1-8c31-b5e8da1d1817" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3cb1b4cf-3291-5299-99a3-e0138a299fe2" :answer-field/choices ["answer-a049de80-4ef4-573d-94a4-648d945c51f0" "answer-1d432e0b-5e73-5082-9179-2c0e5ce1c203" "answer-4b251482-3f03-5972-a333-8643986852ba" "answer-e19aa923-8c4f-59fb-90ad-9fe011b14fc1" "answer-3cb1b4cf-3291-5299-99a3-e0138a299fe2"] :db/ensure [:answer-field/validate]} {:db/id "answer-a049de80-4ef4-573d-94a4-648d945c51f0" :answer/id #uuid "a049de80-4ef4-573d-94a4-648d945c51f0" :answer/type :answer.type/math :answer/value "{a}^{3}{b}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1d432e0b-5e73-5082-9179-2c0e5ce1c203" :answer/id #uuid "1d432e0b-5e73-5082-9179-2c0e5ce1c203" :answer/type :answer.type/math :answer/value "{a}^{4}{b}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-4b251482-3f03-5972-a333-8643986852ba" :answer/id #uuid "4b251482-3f03-5972-a333-8643986852ba" :a