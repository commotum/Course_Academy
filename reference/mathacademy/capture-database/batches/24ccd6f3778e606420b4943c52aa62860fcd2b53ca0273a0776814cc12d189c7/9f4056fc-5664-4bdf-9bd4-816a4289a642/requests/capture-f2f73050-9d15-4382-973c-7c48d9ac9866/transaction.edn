f6963-cb9f-513f-a758-f012e520f227" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a05d4d7e-5c15-5e06-83d0-1d348de7fb94" :answer-field/choices ["answer-12f0faf7-bc3b-5987-b926-60ef170179b1" "answer-3a95a1f3-57cb-53e9-a86e-eb6ce17f0bd5" "answer-cc020065-3a08-59fa-9688-70e25b9deae8" "answer-222f9576-892b-5013-8880-e641d57b3eff" "answer-a05d4d7e-5c15-5e06-83d0-1d348de7fb94"] :db/ensure [:answer-field/validate]} {:db/id "answer-12f0faf7-bc3b-5987-b926-60ef170179b1" :answer/id #uuid "12f0faf7-bc3b-5987-b926-60ef170179b1" :answer/type :answer.type/math :answer/value "\\sqrt[3]{40}" :db/ensure [:answer/validate]} {:db/id "answer-3a95a1f3-57cb-53e9-a86e-eb6ce17f0bd5" :answer/id #uuid "3a95a1f3-57cb-53e9-a86e-eb6ce17f0bd5" :answer/type :answer.type/math :answer/value "\\sqrt[3]{90}" :db/ensure [:answer/validate]} {:db/id "answer-cc020065-3a08-59fa-9688-70e25b9deae8" :answer/id #uuid "cc020065-3a08-59fa-9688-70e25b9deae8" :answer/type :answer.type/math :answer/value "\\sqrt{20}" :db/ensure [:answer/validate]} {:db/id "answer-222f9576-892b-5013-8880-e641d57b3eff" :answer/id #uuid "222f9576-892b-5013-8880-e641d57b3eff" :answer/type :answer.type/math :answer/value "\\sqrt{27}" :db/ensure [:answer/validate]} {:db/id "answer-a05d4d7e-5c15-5e06-83d0-1d348de7fb94" :answer/id #uuid "a05d4d7e-5c15-5e06-83d0-1d348de7fb94" :answer/type :answer.type/math :answer/value "\\sqrt{29}" :db/ensure [:answer/validate]} {:db/id "question-eabdbec5-6ee0-5977-9aec-0268ef8c060f" :question/id #uuid "eabdbec5-6ee0-5977-9aec-0268ef8c060f" :question/math-academy-id "q-556457" :question/problem "Consider the numbers $\\sqrt[3]{15},$ $\\sqrt{7},$ and $\\sqrt[3]{50}.$ Write these three numbers in increasing order.\n\nThe three numbers in increasing order are\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}." :question/worked-solution "First, we find two consecutive whole numbers that bracket each root. We do this by finding the perfect powers just below and just above the number under the radical.\n\n- For $\\sqrt[3]{15}:$\nSince $8<15<27,$ we have $\\sqrt[3]{8}<\\sqrt[3]{15}<\\sqrt[3]{27}.$ This means $2<\\sqrt[3]{15}<3.$\n\n- For $\\sqrt{7}:$\nSince $4<7<9,$ we have $\\sqrt{4}<\\sqrt{7}<\\sqrt{9}.$ This means $2<\\sqrt{7}<3.$\n\n- For $\\sqrt[3]{50}:$\nSince $27<50<64,$ we have $\\sqrt[3]{27}<\\sqrt[3]{50}<\\sqrt[3]{64}.$ This means $3<\\sqrt[3]{50}<4.$\n\nFrom these bounds, we can see that $\\sqrt[3]{50}$ is the greatest of the three numbers because it is greater than $3,$ while the other two are less than $3.$ \n\nHowever, both $\\sqrt[3]{15}$ and $\\sqrt{7}$ are between $2$ and $3.$ To compare them, we need to test some decimal values. We can square or cube decimals to find closer approximations:\n\n- Testing tenths for $\\sqrt[3]{15}:$ \nSince ${2.4}^{3}=13.824$ and ${2.5}^{3}=15.625,$ we know that $2.4<\\sqrt[3]{15}<2.5.$\n\n- Testing tenths for $\\sqrt{7}:$\nSince ${2.6}^{2}=6.76$ and ${2.7}^{2}=7.29,$ we know that $2.6<\\sqrt{7}<2.7.$\n\nComparing these tighter bounds, we see that $\\sqrt[3]{15}<2.5<2.6<\\sqrt{7}.$\n\nCombining all our comparisons, we have\n\n$$\n\\sqrt[3]{15}<\\sqrt{7}<\\sqrt[3]{50}.\n$$\n\nTherefore, the three numbers in increasing order are $\\sqrt[3]{15},$ $\\sqrt{7},$ and $\\sqrt[3]{50}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0bf68efe-ba6a-5c86-a64b-eac1b2a52670" "answer-field-296ffddb-57f3-5e82-8004-569d6ecc2c8b" "answer-field-c45d8af0-cf84-5a43-9ff7-0caf13a20bd2"] :db/ensure [:question/validate]} {:db/id "answer-field-0bf68efe-ba6a-5c86-a64b-eac1b2a52670" :answer-field/id #uuid "0bf68efe-ba6a-5c86-a64b-eac1b2a52670" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3df0edd1-81de-5dc7-bf9d-070d5092683d" :answer-field/choices ["answer-3df0edd1-81de-5dc7-bf9d-070d5092683d"] :db/ensure [:answer-field/validate]} {:db/id "answer-3df0edd1-81de-5dc7-bf9d-070d5092683d" :answer/id #uuid "3df0edd1-81de-5dc7-bf9d-070d5092683d" :answer/type :answer.type/math :answer/value "\\sqrt[3]{15}" :db/ensure [:answer/validate]} {:db/id "answer-field-296ffddb-57f3-5e82-8004-569d6ecc2c8b" :answer-field/id #uuid "296ffddb-57f3-5e82-8004-569d6ecc2c8b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bd163a8e-84d9-57bb-9aa8-d32182147119" :answer-field/choices ["answer-bd163a8e-84d9-57bb-9aa8-d32182147119"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd163a8e-84d9-57bb-9aa8-d32182147119" :answer/id #uuid "bd163a8e-84d9-57bb-9aa8-d32182147119" :answer/type :answer.type/math :answer/value "\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "answer-field-c45d8af0-cf84-5a43-9ff7-0caf13a20bd2" :answer-field/id #uuid "c45d8af0-cf84-5a43-9ff7-0caf13a20bd2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-386d47cd-f86e-52af-ad14-6e2e9a99775a" :answer-field/choices ["answer-386d47cd-f86e-52af-ad14-6e2e9a99775a"] :db/ensure [:answer-field/validate]} {:db/id "answer-386d47cd-f86e-52af-ad14-6e2e9a99775a" :answer/id #uuid "386d47cd-f86e-52af-ad14-6e2e9a99775a" :answer/type :answer.type/math :answer/value "\\sqrt[3]{50}" :db/ensure [:answer/validate]} {:db/id "question-6c62dfe4-3d3e-58f1-bc84-569e3d239868" :question/id #uuid "6c62dfe4-3d3e-58f1-bc84-569e3d239868" :question/math-academy-id "q-556452" :question/problem "Consider the numbers $\\sqrt{20},$ $\\sqrt{5},$ and $\\sqrt{11}.$ Write these three numbers in order from least to greatest.\n\nThe numbers, in order from least to greatest, are:\n{{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}." :question/worked-solution "First, we find two consecutive whole numbers that bracket each root. We do this by finding the perfect squares just below and just above the number under the radical.\n\n- For $\\sqrt{5}:$ \nSince $4<5<9,$ we have $\\sqrt{4}<\\sqrt{5}<\\sqrt{9}.$ This means $2<\\sqrt{5}<3.$\n\n- For $\\sqrt{11}:$\nSince $9<11<16,$ we have $\\sqrt{9}<\\sqrt{11}<\\sqrt{16}.$ This means $3<\\sqrt{11}<4.$\n\n- For $\\sqrt{20}:$\nSince $16<20<25,$ we have $\\sqrt{16}<\\sqrt{20}<\\sqrt{25}.$ This means $4<\\sqrt{20}<5.$\n\nFrom these bounds, we can see that all three numbers fall into different unit intervals:\n\n$$\n2<\\sqrt{5}<3<\\sqrt{11}<4<\\sqrt{20}<5\n$$\n\nComparing these intervals, we have\n\n$$\n\\sqrt{5}<\\sqrt{11}<\\sqrt{20}.\n$$\n\nTherefore, the numbers in order from least to greatest are $\\sqrt{5},$ $\\sqrt{11},$ and $\\sqrt{20}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d33d2751-7e75-5dbd-bca0-6496988af9d1" "answer-field-2760b992-09fe-54cf-af2f-15bbcbde2bdb" "answer-field-a9e423ea-407f-5b27-8c11-fd5320a77861"] :db/ensure [:question/validate]} {:db/id "answer-field-d33d2751-7e75-5dbd-bca0-6496988af9d1" :answer-field/id #uuid "d33d2751-7e75-5dbd-bca0-6496988af9d1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-903d0b1b-7527-5803-a385-024d69b24c6c" :answer-field/choices ["answer-903d0b1b-7527-5803-a385-024d69b24c6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-903d0b1b-7527-5803-a385-024d69b24c6c" :answer/id #uuid "903d0b1b-7527-5803-a385-024d69b24c6c" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-field-2760b992-09fe-54cf-af2f-15bbcbde2bdb" :answer-field/id #uuid "2760b992-09fe-54cf-af2f-15bbcbde2bdb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1cc29c4e-ec58-5b08-9e0a-929c54b9bbef" :answer-field/choices ["answer-1cc29c4e-ec58-5b08-9e0a-929c54b9bbef"] :db/ensure [:answer-field/validate]} {:db/id "answer-1cc29c4e-ec58-5b08-9e0a-929c54b9bbef" :answer/id #uuid "1cc29c4e-ec58-5b08-9e0a-929c54b9bbef" :answer/type :answer.type/math :answer/value "\\sqrt{11}" :db/ensure [:answer/validate]} {:db/id "answer-field-a9e423ea-407f-5b27-8c11-fd5320a77861" :answer-field/id #uuid "a9e423ea-407f-5b27-8c11-fd5320a77861" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-95b5a366-a285-587e-a7ce-81b79d2706de" :answer-field/choices ["answer-95b5a366-a285-587e-a7ce-81b79d2706de"] :db/ensure [:answer-field/validate]} {:db/id "answer-95b5a366-a285-587e-a7ce-81b79d2706de" :answer/id #uuid "95b5a366-a285-587e-a7ce-81b79d2706de" :answer/type :answer.type/math :answer/value "\\sqrt{20}" :db/ensure [:answer/validate]} {:db/id "question-fbc69846-f4f2-5c08-841b-d6a9c38b8533" :question/id #uuid "fbc69846-f4f2-5c08-841b-d6a9c38b8533" :question/math-academy-id "q-556449" :question/problem "Between which two consecutive tenths does $\\sqrt[3]{150}$ lie?" :question/worked-solution "To find the two consecutive tenths between which $\\sqrt[3]{150}$ lies, we need to find two numbers with one decimal place whose cubes bracket $150$.\n\nFirst, let's establish between which two consecutive integers $\\sqrt[3]{150}$ lies.\nWe know that ${5}^{3}=125$ and ${6}^{3}=216$.\nSince $125<150<216$, we know that $5<\\sqrt[3]{150}<6$.\n\nNext, we can test decimals between $5$ and $6$ to narrow down the interval:\n\n$$\n\\begin{aligned}{5.2}^{3} & =140.608 \\\\ {5.3}^{3} & =148.877 \\\\ {5.4}^{3} & =157.464\\end{aligned}\n$$\n\nSince $148.877<150<157.464$, we can write:\n\n$$\n{5.3}^{3}<150<{5.4}^{3}\n$$\n\nTaking the cube root of each part of the inequality gives:\n\n$$\n5.3<\\sqrt[3]{150}<5.4\n$$\n\nTherefore, $\\sqrt[3]{150}$ lies between $5.3$ and $5.4$." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-36bfb1eb-f137-5f6f-9630-d9ca368026c4"] :db/ensure [:question/validate]} {:db/id "answer-field-36bfb1eb-f137-5f6f-9630-d9ca368026c4" :answer-field/id #uuid "36bfb1eb-f137-5f6f-9630-d9ca368026c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8934d595-91f0-55e0-b2e6-ed53be38d094" :answer-field/choices ["answer-1e5f6962-b775-55e8-9685-83c9a8b7ed56" "answer-f94d9e65-45f5-5149-92ec-9f358b105729" "answer-8934d595-91f0-55e0-b2e6-ed53be38d094" "answer-3d4c227c-f3fd-5e20-b4e7-30a7351a37fd" "answer-a5838ac1-4595-5be0-885a-21b66891f9d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-1e5f6962-b775-55e8-9685-83c9a8b7ed56" :answer/id #uuid "1e5f6962-b775-55e8-9685-83c9a8b7ed56" :answer/type :answer.type/text :answer/value "$3.7$ and $3.8$" :db/ensure [:answer/validate]} {:db/id "answer-f94d9e65-45f5-5149-92ec-9f358b105729" :answer/id #uuid "f94d9e65-45f5-5149-92ec-9f358b105729" :answer/type :answer.type/text :answer/value "$5.2$ and $5.3$" :db/ensure [:answer/validate]} {:db/id "answer-8934d595-91f0-55e0-b2e6-ed53be38d094" :answer/id #uuid "8934d595-91f0-55e0-b2e6-ed53be38d094" :answer/type :answer.type/text :answer/value "$5.3$ and $5.4$" :db/ensure [:answer/validate]} {:db/id "answer-3d4c227c-f3fd-5e20-b4e7-30a7351a37fd" :answer/id #uuid "3d4c227c-f3fd-5e20-b4e7-30a7351a37fd" :answer/type :answer.type/text :answer/value "$5.4$ and $5.5$" :db/ensure [:answer/validate]} {:db/id "answer-a5838ac1-4595-5be0-885a-21b66891f9d6" :answer/id #uuid "a5838ac1-4595-5be0-885a-21b66891f9d6" :answer/type :answer.type/text :answer/value "$5.5$ and $5.6$" :db/ensure [:answer/validate]} {:db/id "question-1a16d859-8fe1-5bbc-a36b-6b57bd9a46c0" :question/id #uuid "1a16d859-8fe1-5bbc-a36b-6b57bd9a46c0" :question/math-academy-id "q-556446" :question/problem "The value of $\\sqrt[3]{50}$ lies between two consecutive tenths $a$ and $b,$ where $a<b.$ Find the values of $a$ and $b.$\n\n$a=$\n{{field-1}}\nand\n$b=$\n{{field-2}}" :question/worked-solution "To find the two consecutive tenths between which $\\sqrt[3]{50}$ lies, we need to find two numbers with one decimal place whose cubes bracket $50$.\n\nFirst, let's establish between which two consecutive integers $\\sqrt[3]{50}$ lies.\nWe know that ${3}^{3}=27$ and ${4}^{3}=64$.\nSince $27<50<64$, we know that $3<\\sqrt[3]{50}<4$.\n\nNext, we can test decimals between $3$ and $4$ to narrow down the interval:\n\n$$\n\\begin{aligned}{3.5}^{3} & =42.875 \\\\ {3.6}^{3} & =46.656 \\\\ {3.7}^{3} & =50.653 \\\\ {3.8}^{3} & =54.872\\end{aligned}\n$$\n\nSince $46.656<50<50.653$, we can write:\n\n$$\n{3.6}^{3}<50<{3.7}^{3}\n$$\n\nTaking the cube root of each part of the inequality gives:\n\n$$\n3.6<\\sqrt[3]{50}<3.7\n$$\n\nSo, $\\sqrt[3]{50}$ lies between $3.6$ and $3.7$. Since we are given that $a<b$, we have $a=3.6$ and $b=3.7$." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-643419a5-aa7e-539b-9065-e765e48f0a7a" "answer-field-648cf6d9-b9fa-597f-93e1-1e473afc1140"] :db/ensure [:question/validate]} {:db/id "answer-field-643419a5-aa7e-539b-9065-e765e48f0a7a" :answer-field/id #uuid "643419a5-aa7e-539b-9065-e765e48f0a7a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-801c3de2-46b2-563c-ad74-0c2d98a2cfb5" :answer-field/choices ["answer-801c3de2-46b2-563c-ad74-0c2d98a2cfb5"] :db/ensure [:answer-field/validate]} {:db/id "answer-801c3de2-46b2-563c-ad74-0c2d98a2cfb5" :answer/id #uuid "801c3de2-46b2-563c-ad74-0c2d98a2cfb5" :answer/type :answer.type/math :answer/value "3.6" :db/ensure [:answer/validate]} {:db/id "answer-field-648cf6d9-b9fa-597f-93e1-1e473afc1140" :answer-field/id #uuid "648cf6d9-b9fa-597f-93e1-1e473afc1140" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e10eadb7-d0b9-516d-a436-28a7ccc472d8" :answer-field/choices ["answer-e10eadb7-d0b9-516d-a436-28a7ccc472d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-e10eadb7-d0b9-516d-a436-28a7ccc472d8" :answer/id #uuid "e10eadb7-d0b9-516d-a436-28a7ccc472d8" :answer/type :answer.type/math :answer/value "3.7" :db/ensure [:answer/validate]} {:db/id "question-eee5e7a8-3d1e-565b-891d-6f10ecae6e7f" :question/id #uuid "eee5e7a8-3d1e-565b-891d-6f10ecae6e7f" :question/math-academy-id "q-556444" :question/problem "Between which two consecutive tenths does $\\sqrt{85}$ lie?" :question/worked-solution "To find the two consecutive tenths between which $\\sqrt{85}$ lies, we need to find two numbers with one decimal place whose squares bracket $85$.\n\nFirst, let's establish between which two consecutive integers $\\sqrt{85}$ lies.\nWe know that ${9}^{2}=81$ and ${10}^{2}=100$.\nSince $81<85<100$, we know that $9<\\sqrt{85}<10$.\n\nNext, we can test decimals between $9$ and $10$ to narrow down the interval:\n\n$$\n\\begin{aligned}{9.1}^{2} & =82.81 \\\\ {9.2}^{2} & =84.64 \\\\ {9.3}^{2} & =86.49\\end{aligned}\n$$\n\nSince $84.64<85<86.49$, we can write:\n\n$$\n{9.2}^{2}<85<{9.3}^{2}\n$$\n\nTaking the square root of each part of the inequality gives:\n\n$$\n9.2<\\sqrt{85}<9.3\n$$\n\nTherefore, $\\sqrt{85}$ lies between $9.2$ and $9.3$." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d68cf0b2-0983-5dca-947f-dad9ec7dbabf"] :db/ensure [:question/validate]} {:db/id "answer-field-d68cf0b2-0983-5dca-947f-dad9ec7dbabf" :answer-field/id #uuid "d68cf0b2-0983-5dca-947f-dad9ec7dbabf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d21cd52-8839-5972-8ad9-4b183e6aa799" :answer-field/choices ["answer-b0ed41e3-39ce-5d9a-99d7-78fcd3a62e00" "answer-09ab94cd-e53f-5030-9794-55a45a2d199a" "answer-2d21cd52-8839-5972-8ad9-4b183e6aa799" "answer-9048679d-6b21-5f81-8bf5-0219c0264b86" "answer-22ffcbe1-1311-5383-ae08-7dc9f5a89559"] :db/ensure [:answer-field/validate]} {:db/id "answer-b0ed41e3-39ce-5d9a-99d7-78fcd3a62e00" :answer/id #uuid "b0ed41e3-39ce-5d9a-99d7-78fcd3a62e00" :answer/type :answer.type/text :answer/value "$9.0$ and $9.1$" :db/ensure [:answer/validate]} {:db/id "answer-09ab94cd-e53f-5030-9794-55a45a2d199a" :answer/id #uuid "09ab94cd-e53f-5030-9794-55a45a2d199a" :answer/type :answer.type/text :answer/value "$9.1$ and $9.2$" :db/ensure [:answer/validate]} {:db/id "answer-2d21cd52-8839-5972-8ad9-4b183e6aa799" :answer/id #uuid "2d21cd52-8