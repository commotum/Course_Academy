er-field/id #uuid "ec4923e3-08ed-59f1-a210-49edf0817c27" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c95abe2c-4f68-5d3c-854b-bebbf38a7f04" :answer-field/choices ["answer-c95abe2c-4f68-5d3c-854b-bebbf38a7f04"] :db/ensure [:answer-field/validate]} {:db/id "answer-c95abe2c-4f68-5d3c-854b-bebbf38a7f04" :answer/id #uuid "c95abe2c-4f68-5d3c-854b-bebbf38a7f04" :answer/type :answer.type/math :answer/value "2.1" :db/ensure [:answer/validate]} {:db/id "answer-field-faa793b1-4a54-5d15-9029-117fb1a34d0c" :answer-field/id #uuid "faa793b1-4a54-5d15-9029-117fb1a34d0c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-499ef7be-c65b-5209-a84c-a4485798a68e" :answer-field/choices ["answer-499ef7be-c65b-5209-a84c-a4485798a68e"] :db/ensure [:answer-field/validate]} {:db/id "answer-499ef7be-c65b-5209-a84c-a4485798a68e" :answer/id #uuid "499ef7be-c65b-5209-a84c-a4485798a68e" :answer/type :answer.type/math :answer/value "2.2" :db/ensure [:answer/validate]} {:db/id "question-92983ecf-db5c-5c74-b988-756fcd6337e6" :question/id #uuid "92983ecf-db5c-5c74-b988-756fcd6337e6" :question/math-academy-id "q-555461" :question/problem "Between which two consecutive tenths does $\\sqrt[3]{45}$ lie?" :question/worked-solution "To find the two consecutive tenths between which $\\sqrt[3]{45}$ lies, we need to find two numbers with one decimal place whose cubes bracket $45$.\n\nFirst, let's establish between which two consecutive integers $\\sqrt[3]{45}$ lies.\nWe know that ${3}^{3}=27$ and ${4}^{3}=64$.\nSince $27<45<64$, we know that $3<\\sqrt[3]{45}<4$.\n\nNext, we can test decimals between $3$ and $4$ to narrow down the interval:\n\n$$\n\\begin{aligned}{3.4}^{3} & =39.304 \\\\ {3.5}^{3} & =42.875 \\\\ {3.6}^{3} & =46.656\\end{aligned}\n$$\n\nSince $42.875<45<46.656$, we can write:\n\n$$\n{3.5}^{3}<45<{3.6}^{3}\n$$\n\nTaking the cube root of each part of the inequality gives:\n\n$$\n3.5<\\sqrt[3]{45}<3.6\n$$\n\nTherefore, $\\sqrt[3]{45}$ lies between $3.5$ and $3.6$." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c01a9710-0c3b-5f44-83dc-6039b3f885a3"] :db/ensure [:question/validate]} {:db/id "answer-field-c01a9710-0c3b-5f44-83dc-6039b3f885a3" :answer-field/id #uuid "c01a9710-0c3b-5f44-83dc-6039b3f885a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ee937844-8f4e-5825-a105-dc5e64b79133" :answer-field/choices ["answer-cf76145a-7d25-5f2d-aedb-75bbb68c9d71" "answer-243c9113-299e-59cf-a357-0cefe6c4d08b" "answer-ee937844-8f4e-5825-a105-dc5e64b79133" "answer-d71b384f-4240-578d-a5d5-a91316c0ae60" "answer-34eef6b1-dd77-5a22-acd0-de325f2fbc1c"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf76145a-7d25-5f2d-aedb-75bbb68c9d71" :answer/id #uuid "cf76145a-7d25-5f2d-aedb-75bbb68c9d71" :answer/type :answer.type/text :answer/value "$2.6$ and $2.7$" :db/ensure [:answer/validate]} {:db/id "answer-243c9113-299e-59cf-a357-0cefe6c4d08b" :answer/id #uuid "243c9113-299e-59cf-a357-0cefe6c4d08b" :answer/type :answer.type/text :answer/value "$3.4$ and $3.5$" :db/ensure [:answer/validate]} {:db/id "answer-ee937844-8f4e-5825-a105-dc5e64b79133" :answer/id #uuid "ee937844-8f4e-5825-a105-dc5e64b79133" :answer/type :answer.type/text :answer/value "$3.5$ and $3.6$" :db/ensure [:answer/validate]} {:db/id "answer-d71b384f-4240-578d-a5d5-a91316c0ae60" :answer/id #uuid "d71b384f-4240-578d-a5d5-a91316c0ae60" :answer/type :answer.type/text :answer/value "$3.6$ and $3.7$" :db/ensure [:answer/validate]} {:db/id "answer-34eef6b1-dd77-5a22-acd0-de325f2fbc1c" :answer/id #uuid "34eef6b1-dd77-5a22-acd0-de325f2fbc1c" :answer/type :answer.type/text :answer/value "$6.7$ and $6.8$" :db/ensure [:answer/validate]} {:db/id "question-b73b2161-1f16-50bc-aeef-165cf5e2f96c" :question/id #uuid "b73b2161-1f16-50bc-aeef-165cf5e2f96c" :question/math-academy-id "q-555464" :question/problem "Which of the following is the best estimate for $\\sqrt{55}?$" :question/worked-solution "To estimate $\\sqrt{55},$ we first find the two perfect squares closest to $55.$\n\nThe closest perfect squares are $49={7}^{2}$ and $64={8}^{2}.$\n\nSince $49<55<64,$ we know that the square root of $55$ lies between $7$ and $8.$ This tells us that $6.8$ and $27.5$ are incorrect estimates.\n\nBecause $55$ is slightly closer to $49$ than to $64$ (the distance to $49$ is $6,$ and the distance to $64$ is $9$), we expect $\\sqrt{55}$ to be near the middle, but slightly less than $7.5.$ \n\nWe can test the plausible choices by squaring them to see which one results in a value closest to $55:$\n\n$$\n\\begin{aligned}{7.1}^{2} & =50.41 \\\\ {7.4}^{2} & =54.76 \\\\ {7.9}^{2} & =62.41\\end{aligned}\n$$\n\nWe can see that ${7.4}^{2}=54.76$ is very close to $55.$ \n\nTherefore, the best estimate for $\\sqrt{55}$ is $7.4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-526aa133-91ed-5e0d-b820-92a175d01133"] :db/ensure [:question/validate]} {:db/id "answer-field-526aa133-91ed-5e0d-b820-92a175d01133" :answer-field/id #uuid "526aa133-91ed-5e0d-b820-92a175d01133" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a7ddc50-b46c-5c7d-8cb0-1357f2ea142b" :answer-field/choices ["answer-b299ca2b-d607-5531-8e61-3649f65397c3" "answer-06c53433-b0f7-519f-a4a8-b7ca0a577929" "answer-e09a3792-a321-5f02-bd73-1d384a4b4fa1" "answer-4a7ddc50-b46c-5c7d-8cb0-1357f2ea142b" "answer-b803fef8-bfa3-5bca-ab56-a503730f1578"] :db/ensure [:answer-field/validate]} {:db/id "answer-b299ca2b-d607-5531-8e61-3649f65397c3" :answer/id #uuid "b299ca2b-d607-5531-8e61-3649f65397c3" :answer/type :answer.type/math :answer/value "27.5" :db/ensure [:answer/validate]} {:db/id "answer-06c53433-b0f7-519f-a4a8-b7ca0a577929" :answer/id #uuid "06c53433-b0f7-519f-a4a8-b7ca0a577929" :answer/type :answer.type/math :answer/value "6.8" :db/ensure [:answer/validate]} {:db/id "answer-e09a3792-a321-5f02-bd73-1d384a4b4fa1" :answer/id #uuid "e09a3792-a321-5f02-bd73-1d384a4b4fa1" :answer/type :answer.type/math :answer/value "7.1" :db/ensure [:answer/validate]} {:db/id "answer-4a7ddc50-b46c-5c7d-8cb0-1357f2ea142b" :answer/id #uuid "4a7ddc50-b46c-5c7d-8cb0-1357f2ea142b" :answer/type :answer.type/math :answer/value "7.4" :db/ensure [:answer/validate]} {:db/id "answer-b803fef8-bfa3-5bca-ab56-a503730f1578" :answer/id #uuid "b803fef8-bfa3-5bca-ab56-a503730f1578" :answer/type :answer.type/math :answer/value "7.9" :db/ensure [:answer/validate]} {:db/id "question-5ec75543-e826-5114-b0c0-b95399a3601d" :question/id #uuid "5ec75543-e826-5114-b0c0-b95399a3601d" :question/math-academy-id "q-556439" :question/problem "Which of the following is the best estimate for $\\sqrt{73}?$" :question/worked-solution "To estimate $\\sqrt{73},$ we first find the two perfect squares closest to $73.$\n\nThe closest perfect squares are $64={8}^{2}$ and $81={9}^{2}.$\n\nSince $64<73<81,$ we know that the square root of $73$ lies between $8$ and $9.$ This tells us that $7.6$ and $36.5$ are incorrect estimates.\n\nBecause $73$ is slightly closer to $81$ than to $64$ (the distance to $64$ is $9,$ and the distance to $81$ is $8$), we expect $\\sqrt{73}$ to be near the middle of the interval.\n\nWe can test the plausible choices by squaring them to see which one results in a value closest to $73:$\n\n$$\n\\begin{aligned}{8.2}^{2} & =67.24 \\\\ {8.5}^{2} & =72.25 \\\\ {8.9}^{2} & =79.21\\end{aligned}\n$$\n\nWe can see that ${8.5}^{2}=72.25$ is very close to $73.$\n\nTherefore, the best estimate for $\\sqrt{73}$ is $8.5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c16649a1-3daf-5fc0-b1e3-d24a080b601c"] :db/ensure [:question/validate]} {:db/id "answer-field-c16649a1-3daf-5fc0-b1e3-d24a080b601c" :answer-field/id #uuid "c16649a1-3daf-5fc0-b1e3-d24a080b601c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc6f82be-1883-5a8c-b6d5-46896e113e24" :answer-field/choices ["answer-40fd4564-da13-5b7e-89af-9366df2bd8dd" "answer-0a464dee-3917-55b2-a7df-14ac5fe20416" "answer-0c001871-c260-5bf6-9737-544d95ebc89d" "answer-dc6f82be-1883-5a8c-b6d5-46896e113e24" "answer-deec2240-9409-5726-8457-08488f63b4df"] :db/ensure [:answer-field/validate]} {:db/id "answer-40fd4564-da13-5b7e-89af-9366df2bd8dd" :answer/id #uuid "40fd4564-da13-5b7e-89af-9366df2bd8dd" :answer/type :answer.type/math :answer/value "36.5" :db/ensure [:answer/validate]} {:db/id "answer-0a464dee-3917-55b2-a7df-14ac5fe20416" :answer/id #uuid "0a464dee-3917-55b2-a7df-14ac5fe20416" :answer/type :answer.type/math :answer/value "7.6" :db/ensure [:answer/validate]} {:db/id "answer-0c001871-c260-5bf6-9737-544d95ebc89d" :answer/id #uuid "0c001871-c260-5bf6-9737-544d95ebc89d" :answer/type :answer.type/math :answer/value "8.2" :db/ensure [:answer/validate]} {:db/id "answer-dc6f82be-1883-5a8c-b6d5-46896e113e24" :answer/id #uuid "dc6f82be-1883-5a8c-b6d5-46896e113e24" :answer/type :answer.type/math :answer/value "8.5" :db/ensure [:answer/validate]} {:db/id "answer-deec2240-9409-5726-8457-08488f63b4df" :answer/id #uuid "deec2240-9409-5726-8457-08488f63b4df" :answer/type :answer.type/math :answer/value "8.9" :db/ensure [:answer/validate]} {:db/id "question-6f1f35ac-b2a3-5225-badd-5521e9e9745c" :question/id #uuid "6f1f35ac-b2a3-5225-badd-5521e9e9745c" :question/math-academy-id "q-556440" :question/problem "Which of the following is the best estimate for $\\sqrt{29}?$" :question/worked-solution "To estimate $\\sqrt{29},$ we first find the two perfect squares closest to $29.$\n\nThe closest perfect squares are $25={5}^{2}$ and $36={6}^{2}.$\n\nSince $25<29<36,$ we know that the square root of $29$ lies between $5$ and $6.$ This tells us that $4.9$ and $14.5$ are incorrect estimates.\n\nBecause $29$ is much closer to $25$ than to $36$ (the distance to $25$ is $4,$ and the distance to $36$ is $7$), we expect $\\sqrt{29}$ to be near the lower end of the interval.\n\nWe can test the plausible choices by squaring them to see which one results in a value closest to $29:$\n\n$$\n\\begin{aligned}{5.4}^{2} & =29.16 \\\\ {5.7}^{2} & =32.49 \\\\ {5.9}^{2} & =34.81\\end{aligned}\n$$\n\nWe can see that ${5.4}^{2}=29.16$ is very close to $29.$\n\nTherefore, the best estimate for $\\sqrt{29}$ is $5.4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-516f3cb0-cb44-5f92-86e6-bf5365f546b1"] :db/ensure [:question/validate]} {:db/id "answer-field-516f3cb0-cb44-5f92-86e6-bf5365f546b1" :answer-field/id #uuid "516f3cb0-cb44-5f92-86e6-bf5365f546b1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-12a8fa1f-db3c-549c-8ff7-0928127d5ac9" :answer-field/choices ["answer-9d9ab33f-37a9-5078-bdf6-fca039d691a4" "answer-80a91325-3ae9-57ec-822f-83c4f37e0cd6" "answer-12a8fa1f-db3c-549c-8ff7-0928127d5ac9" "answer-5c00f9a5-d81f-5aeb-9c70-b3d58c57992c" "answer-2b51bb34-2903-5516-a067-83b068bc6daf"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d9ab33f-37a9-5078-bdf6-fca039d691a4" :answer/id #uuid "9d9ab33f-37a9-5078-bdf6-fca039d691a4" :answer/type :answer.type/math :answer/value "14.5" :db/ensure [:answer/validate]} {:db/id "answer-80a91325-3ae9-57ec-822f-83c4f37e0cd6" :answer/id #uuid "80a91325-3ae9-57ec-822f-83c4f37e0cd6" :answer/type :answer.type/math :answer/value "4.9" :db/ensure [:answer/validate]} {:db/id "answer-12a8fa1f-db3c-549c-8ff7-0928127d5ac9" :answer/id #uuid "12a8fa1f-db3c-549c-8ff7-0928127d5ac9" :answer/type :answer.type/math :answer/value "5.4" :db/ensure [:answer/validate]} {:db/id "answer-5c00f9a5-d81f-5aeb-9c70-b3d58c57992c" :answer/id #uuid "5c00f9a5-d81f-5aeb-9c70-b3d58c57992c" :answer/type :answer.type/math :answer/value "5.7" :db/ensure [:answer/validate]} {:db/id "answer-2b51bb34-2903-5516-a067-83b068bc6daf" :answer/id #uuid "2b51bb34-2903-5516-a067-83b068bc6daf" :answer/type :answer.type/math :answer/value "5.9" :db/ensure [:answer/validate]} {:db/id "question-5ccb9537-59db-525f-88c4-f6dfbe10d934" :question/id #uuid "5ccb9537-59db-525f-88c4-f6dfbe10d934" :question/math-academy-id "q-555465" :question/problem "Which of the following is the best estimate for $\\sqrt[3]{85}?$" :question/worked-solution "To estimate $\\sqrt[3]{85},$ we first locate the perfect cubes that are closest to $85.$\n\nWe know that\n\n$$\n\\begin{aligned}{4}^{3} & =64 \\\\ {5}^{3} & =125\\end{aligned}\n$$\n\nSince $85$ is between $64$ and $125,$ its cube root must be between $4$ and $5.$ This eliminates any choices that do not fall in this range.\n\n![](images/9b/9b97872f5a4258a5b417f6e91bfc33733125b7b0f16299b6cddf06ce3f6cd87b.png)\n\nWe can further refine our estimate by considering distances. The number $85$ is closer to $64$ than it is to $125,$ so we expect its cube root to be closer to $4$ than to $5.$ \n\nLooking at the remaining choices—$4.1,$ $4.4,$ and $4.7$—we can test a value by cubing it to see how close the result is to $85.$ Let's test $4.4$ by cubing it:\n\n$$\n\\begin{aligned}{4.4}^{3} & =4.4\\cdot 4.4\\cdot 4.4 \\\\  & =19.36\\cdot 4.4 \\\\  & =85.184\\end{aligned}\n$$\n\nSince $85.184$ is very close to $85,$ we can confidently choose $4.4$ as our estimate.\n\nTherefore, the best estimate for $\\sqrt[3]{85}$ is $4.4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-49d7f175-4135-5fa7-9bc4-9394239b508a"] :db/ensure [:question/validate]} {:db/id "answer-field-49d7f175-4135-5fa7-9bc4-9394239b508a" :answer-field/id #uuid "49d7f175-4135-5fa7-9bc4-9394239b508a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5683a14a-1515-5481-afdc-0eeb230b0116" :answer-field/choices ["answer-85200cd6-bfeb-5891-809c-50d32e9f5539" "answer-117d531d-98e4-5f84-8504-fea2f6f23c02" "answer-5683a14a-1515-5481-afdc-0eeb230b0116" "answer-0c6307a1-74ba-5c29-ac1d-383f075e9d45" "answer-fd675d85-758d-5dfa-8620-0dc1bf8294ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-85200cd6-bfeb-5891-809c-50d32e9f5539" :answer/id #uuid "85200cd6-bfeb-5891-809c-50d32e9f5539" :answer/type :answer.type/math :answer/value "28.3" :db/ensure [:answer/validate]} {:db/id "answer-117d531d-98e4-5f84-8504-fea2f6f23c02" :answer/id #uuid "117d531d-98e4-5f84-8504-fea2f6f23c02" :answer/type :answer.type/math :answer/value "4.1" :db/ensure [:answer/validate]} {:db/id "answer-5683a14a-1515-5481-afdc-0eeb230b0116" :answer/id #uuid "5683a14a-1515-5481-afdc-0eeb230b0116" :answer/type :answer.type/math :answer/value "4.4" :db/ensure [:answer/validate]} {:db/id "answer-0c6307a1-74ba-5c29-ac1d-383f075e9d45" :answer/id #uuid "0c6307a1-74ba-5c29-ac1d-383f075e9d45" :answer/type :answer.type/math :answer/value "4.7" :db/ensure [:answer/validate]} {:db/id "answer-fd675d85-758d-5dfa-8620-0dc1bf8294ad" :answer/id #uuid "fd675d85-758d-5dfa-8620-0dc1bf8294ad" :answer/type :answer.type/math :answer/value "9.2" :db/ensure [:answer/validate]} {:db/id "question-8b9de470-595d-5301-8412-daba962c6a6e" :question/id #uuid "8b9de470-595d-5301-8412-daba962c6a6e" :question/math-academy-id "q-556486" :question/problem "Estimate the value of $\\sqrt[3]{20},$ rounded to $1$ decimal place.\n\n$\\sqrt[3]{20}≈$\n{{field-1}}" :question/worked-solution "To estimate $\\sqrt[3]{20},$ we first find the two perfect cubes closest to $20.$\n\nThe closest perfect cubes are $8={2}^{3}$ and $27={3}^{3}.$\n\nSince $8<20<27,$ we know that the cube root of $20$ lies between $2$ and $3.$\n\n![](images/c4/c4eb7ee1951d0d402df1553d46bc6e8ce1fdb421adc40949b9e79964484892c6.png)\n\nBecause $20$ is closer to $27$ than to $8,$ we expect $\\sqrt[3]{20}$ to be close to $3.$ \n\nLet's test a decimal near $3,$ such as $2.7,$ by cubing it:\n\n$$\n{2.7}^{3}=19.683\n$$\n\nSince $19.683$ is slightly less than $20,$ we know that $2.7<\\sqrt[3]{20}<2.8.$\n\nNext, we determine whether $20$ is closer to ${2.7}^{3}$ or ${2.8}^{3}:$\n\n- The distance from $20$ to ${2.7}^{3}$ is $20-19.683=0.317.$\n\n- The distance from $20$ to ${2.8}^{3}$ is $21.952-20=1.952.$\n\nSince $20$ is much closer to $19.683,$ $\\sqrt[3]{20}$ is closer to $2.7.$\n\nTherefore, rounded to $1$ decimal place, $\\sqrt[3]{20}≈2.7.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-28e89b58-7411-51b4-b86e-1c63a2770f1a"] :db/ensure [:question/validate]} {:db/id "answer-field-28e89b58-7411-51b4-b86e-1c63a2770f1a" :answer-field/id #uuid "28e89b58-7411-51b4-b86e-1c63a2770f1a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c846da4f-defa-517a-887f-4bb071b66588" :answer-field/choices ["answer-c846da4f-defa-517a-887f-4bb071b66588"] :db/ensure [:answer-field/validate]} {:db/id "answer-c846da4f-defa-517a-887f-4bb071b66588" :answer/id #uuid "c846da4f-defa-517a-887f-4bb071b66588" :answer/type :answer.type/math :answer/value "2.7" :db/ensure [:answer/validate]} {:db/id "tutorial-4dbd01ab-76e0-5e52-b2bb-2efdd00a2058" :tutorial/id #uuid "4dbd01ab-76e0-5e52-b2bb-2efdd00a2058" :tutorial/math-academy-id 23022 :tutorial/title "Introduction" :tutorial/content "Some roots are perfect. For example, ![](images/38/389d3c3681c9e50a78b79c73049365330340f56d1dd87adfa83ed9cc3e3eefed.svg) and ![](images/47/4788ae8534df07b8199121e142f69086fd3aec0f87f201fcf4997831c0b60002.svg) Other roots are not whole numbers, but we can still describe where they belong.\n\nAn **approximation** is a nearby value that helps us understand the size of a number. To approximate roots, we compare the number under the radical to nearby perfect powers.\n\nFor a square root, we compare to perfect squares. Since ![](images/96/96d11100098752a9a927d8b25751f689094ffee73faec61b29b79e0afa375a42.svg) we know\n![](images/49/49fbd1142d93edad07ad98c73bc1dafb04d1e8b5a4820274f51d8cee4e3dfbd3.svg)\n\nFor a cube root, we compare to perfect cubes. Since ![](images/2d/2de677effff1f2ce5ed73724bfdd3bead3f0baab3bac33ed272af03361ec3573.svg) we know\n![](images/7e/7ec574473402909905dc4960cca1ab56bb5790c5fcd80f4ad78cd3b9954dc925.svg)\n\nSo, the main idea is to find familiar benchmark roots first. Once we know the root’s whole-number interval, we can order roots, refine to decimal intervals, and choose reasonable estimates." :db/ensure [:tutorial/validate]} {:db/id "tutorial-914a8dc0-a88e-5f85-bc5d-34aec57c480e" :tutorial/id #uuid "914a8dc0-a88e-5f85-bc5d-34aec57c480e" :tutorial/math-academy-id 23020 :tutorial/title "Finding Whole-Number Bounds for Roots" :tutorial/content "**Bounds** are values that trap a number between a lower value and an upper value. For roots, **whole-number bounds** are consecutive whole numbers that the root lies between.\n\nTo find whole-number bounds, we compare the number under the radical to nearby perfect squares or perfect cubes.\n\nLet's locate ![](images/db/dbd2aff681e9d97891999f08502f4f6e7f41f487b237d6c90e18afa1f77755ef.svg) The nearby perfect squares are ![](images/24/24341571e162e3b4e2ca76590f0ed2e6d8b180365fba30c3fb9ea6041d38179a.svg) and ![](images/3c/3cba1142c4b937d3598aaaed096f8b95178d8c45baf39fb7f9f02f21a21480df.svg) because\n![](images/09/09aad9428a24389e5a19034319e2737d08cf5167bf424e1b78cf0f0e69e49102.svg)\n\nSince ![](images/11/119ef80e819318a00b93e3c34aaca245545c965604be3489dd3529df1232a453.svg) is between these perfect squares, we have\n![](images/8f/8fbdaf9d9bd26df7fe6d1c1ad4403f07ba47a94f1a7f8b0d4e728b6865a7cb23.svg)\n\nTaking the square root of each part gives\n![](images/c9/c9753a4537cde93f9b0a994a0c50bdc6528dba6926bdd021d0cc2b54732277ba.svg)\n\n![](images/44/448579015986d36689743ffeadb6a8b05c96b917778d63a0de7e4a2dd0487370.png)\n\nSo, ![](images/e8/e8219f12c397796f3e761fb39940934f3f6ff51cb7dd3656018be76bcf7db1ba.svg) lies between the consecutive whole numbers ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/fe/fe34f715005da1a8b682c9650a76785673fdf25c3b7c7546bb94824470c54caf.svg) The same idea works for cube roots, except we compare to nearby perfect cubes instead." :db/ensure [:tutorial/validate]} {:db/id "tutorial-52ad8c4f-2f3c-5dcf-8ac3-f9cfff01832e" :tutorial/id #uuid "52ad8c4f-2f3c-5dcf-8ac3-f9cfff01832e" :tutorial/math-academy-id 23019 :tutorial/title "Ordering Irrational Roots" :tutorial/content "When we order irrational roots, we can often compare their whole-number intervals first. A root between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/37/37e17c4a2302e6352fb7186621c9c43bb5e99d43a8a0bc700c0181d36c6cc915.svg) is greater than any root between ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) and ![](images/85/85ab4d14e4ae710116ac84de4b03b3cf35723ab969b7abfba97889c497974147.svg)\n\nSuppose we want to identify the greatest number in this list:\n![](images/3b/3b5235ec98b311f2a082eeb8a35ba2e606f452a5467707a2125ce3f27fd26484.svg)\n\nWe first bracket each root.\n\n- ![](images/04/04217800f61f8a2b9dfc2b4efb67a08c1d9f5ef7e365a5ddae4d163146bc0158.svg) lies between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/b1/b1288d1c08b90d72fcd319980da7943ea4941b9f259ece4086d8b24b1bc0cfb2.svg) since ![](images/a3/a34f852d765024d8ae773b8debb02adc77fc371c656b049104a9330dc604f5a4.svg)\n\n- ![](images/5a/5aa880157a445c826aa5e51bfbdf4f3c5ab83afdadf97fc6f533aa6103d28640.svg) lies between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/b1/b1288d1c08b90d72fcd319980da7943ea4941b9f259ece4086d8b24b1bc0cfb2.svg) since ![](images/64/6442e0ee53f3ae690132986dfe60822810ae2f586296bccecba0ab6a07c871db.svg)\n\n- ![](images/39/398d865ecee9dba51e8ba4918a187f483b9291ff6ae0d2032be0d95d40190ff7.svg) lies between ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) and ![](images/39/39c9d5c6b02f72e65180a1a782af0404d25977c3627c5778e1bcb676286506c4.svg) since ![](images/5b/5bf4ba43a56be76e42af12ac6d00913b93191cb348019c518a60bb6490d412ac.svg)\n\n- ![](images/55/556af15807fb8546143a7adb4457089c3f367764397c6cf94654f30200177aba.svg) lies between ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) and ![](images/e9/e94ce8a42ab6b97ee9c979dcc0a002b557e1c6339e5950f601a66a9af91f67e5.svg) since ![](images/65/65aec0b2f64e5e7991650650102102099e40d0fa3f33b9951e7f42d02bbba8d2.svg)\n\n- ![](images/ba/ba20e4e917e21ab13b9aab507e09632255fccd6346f08f31333fffd468f3eea1.svg) lies between ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) and ![](images/e9/e94ce8a42ab6b97ee9c979dcc0a002b557e1c6339e5950f601a66a9af91f67e5.svg) since ![](images/f4/f4638dd2c251dd734b480e1bcaedeb9e1bee07e2f03ff4c85de10287cae9957b.svg)\n\nThe greatest value must be one of the roots between ![](images/0c/0cf2eee0cdec31b7acdc244a255aaee7d6d520cfeee67b64ac9cf215f5377477.svg) and ![](images/b1/b1288d1c08b90d72fcd319980da7943ea4941b9f259ece4086d8b24b1bc0cfb2.svg) so it is either ![](images/04/04217800f61f8a2b9dfc2b4efb67a08c1d9f5ef7e365a5ddae4d163146bc0158.svg) or ![](images/8b/8bdb2119f2b5ebc9f21dcc182d6b68e8e964156168a62cacb6048ca84b6e4dbf.svg) Since ![](images/eb/eb86e1418a307c988f3b246894cfdf9d0e9c8bbceda1641fb831d30fe9b6fd3b.svg) we know ![](images/45/45ee1b9d94d27812c364bf34c46e918d9c2df4b254adbf86932c2d350cde0822.svg)\n\nTherefore, the greatest number is ![](images/8b/8bdb2119f2b5ebc9f21dcc182d6b68e8e964156168a62cacb6048ca84b6e4dbf.svg)\n\n**Watch out!** We can compare radicands directly only when the roots are the same kind. For example, comparing ![](images/5a/5aa880157a445c826aa5e51bfbdf4f3c5ab83afdadf97fc6f533aa6103d28640.svg) and ![](images/04/04217800f61f8a2b9dfc2b4efb67a08c1d9f5ef7e365a5ddae4d163146bc0158.svg) is safe because both are square roots." :db/ensure [:tutorial/validate]} {:db/id "tutorial-63caa2e6-2c19-5afe-93e1-8e484d252e52" :tutorial/id #uuid "63caa2e6-2c19-5afe-93e1-8e484d252e52" :tutorial/math-academy-id 23018 :tutorial/title "Finding Decimal Bounds for Roots" :tutorial/content "**Decimal bounds** are nearby decimal values that trap a root in a smaller interval, such as between two consecutive tenths.\n\nLet's find the two consecutive tenths between which ![](images/75/75690cbc152b11d764581bab44be87acabbbf69ccaca10786de7fd41462db7c1.svg) lies. First, we find the whole-number bounds:\n![](images/67/670a358c4cfbfff0330b32c236f83d3cf1b52475f6c624873a54bc335aa11b26.svg)\nso\n![](images/0f/0f2da556fe760c541b67a1f219a28784b92ab589f10c67d8bdefe8d4a27548e3.svg)\n\nNow, we test tenths between ![](images/6c/6cb44f25e489afb06ec62d2e95c4d235ece77eb36e2327b856264d2fb8b22c21.svg) and ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) by squaring them. Since ![](images/75/75690cbc152b11d764581bab44be87acabbbf69ccaca10786de7fd41462db7c1.svg) is close to ![](images/3f/3f1007009d0a0d180a52510e7c9ce724113d2deb10051c26452457286845c91c.svg) we can test ![](images/52/521ed5d9c72e7dc13edf7e79df2272294cd869bd5de324f0f7828e2c888c326c.svg) and ![](images/22/227c2d0283023dacad68c1e78194ec0be80b93d52bffea8bd61b5bafc99102df.svg)\n![](images/66/662e926243f31e64daaa74edc74dd4ef9d78e4d24260995fa38db61be6d5cecb.svg)\n\nSince ![](images/e2/e2574f61b59164e433af2aeeb4c0dd160bf84436387873b2af855fa2770b5753.svg) falls between these square values, we have\n![](images/26/26bc3e1ccf6f626db492303aa9d1493c863cf8a10a2e1e46151f1c89ce86c0bd.svg)\n\nTaking square roots gives\n![](images/d1/d1aa32699a90c28680f86d47dca927f92f769ed1e879af7972a3a97030df30db.svg)\n\n![](images/47/4729d848e2e66944d7e2da9f8fc7655a93a59ac5ee20e9454f95b583b39cd8ee.png)\n\nTherefore, ![](images/75/75690cbc152b11d764581bab44be87acabbbf69ccaca10786de7fd41462db7c1.svg) lies between the consecutive tenths ![](images/52/521ed5d9c72e7dc13edf7e79df2272294cd869bd5de324f0f7828e2c888c326c.svg) and ![](images/22/227c2d0283023dacad68c1e78194ec0be80b93d52bffea8bd61b5bafc99102df.svg)" :db/ensure [:tutorial/validate]} {:db/id "tutorial-199fa1b4-f88c-51c4-a84f-275792b90dee" :tutorial/id #uuid "199fa1b4-f88c-51c4-a84f-275792b90dee" :tutorial/math-academy-id 23017 :tutorial/title "Estimating Roots" :tutorial/content "When we **estimate** a root, we choose one nearby decimal value and check that it is reasonable. Bounds tell us the interval; the estimate tells us which value in that interval is closest.\n\nLet's estimate ![](images/39/398d865ecee9dba51e8ba4918a187f483b9291ff6ae0d2032be0d95d40190ff7.svg) rounded to ![](images/95/95836ae470c61ab15bfb67d6f0c92d2ad8d03d400b04473e81e58de3ee44bf32.svg) decimal place. First, we find nearby perfect cubes:\n![](images/bc/bca4e36ccfb33070d91ecf1f82eab6ce7d8e06f71d05000633a58ac03ce19107.svg)\nso\n![](images/cd/cdf283b9d6e8644576f4e97abe9203e4115c00fd43314a2323706d1c643e9c0b.svg)\n\n![](images/36/3636292deb3377b1dfe99da068f300f7dba4ce7fa6acd22164150451dc396ee1.png)\n\nBecause ![](images/bc/bc98a2fdf686f851fd343e6cca8ebf25186c6d4fe401df573939f8e5e1d5d044.svg) is closer to ![](images/c6/c64ba31f35ed2d1f23f3827854effc6461b82c7cfa7f27694bf545acb565c90a.svg) than to ![](images/f9/f9e10c6abbe30486481349d2f58357e01d37bfd670ed37a29313e8556b57fe2c.svg) we expect ![](images/39/398d865ecee9dba51e8ba4918a187f483b9291ff6ae0d2032be0d95d40190ff7.svg) to be closer to ![](images/40/402ff5d0c0c3aaa47f18c89f6d96c95d47840eac13822d596a51bdb0c5f9a4ab.svg) than to ![](images/9f/9fc073d1e6ebde82eb949a875e40be00b9196e9b14473ee13fa47a26a98d8450.svg) Now, we test nearby tenths:\n![](images/47/4703877c1fc434e00d2fc781d77473c9ce8f775257b953203baa76d914c2458b.svg)\n\nSo, ![](images/5d/5dfbe3c8f263be79d4c240a343aeef3ed741dc5d9a72b0b8c21b38cd9548a66c.svg) To decide which tenth is the better estimate, compare distances from ![](images/3b/3b3b7808b8023e6edb41eb64eb15e0198ce6843ff72ec8c44e79786e8932dc84.svg)\n![](images/60/60b754ce1636a8fee75de533c7961f498ac37fd7f6b471971e420985069f3c22.svg)\n\nSince ![](images/bc/bc98a2fdf686f851fd343e6cca8ebf25186c6d4fe401df573939f8e5e1d5d044.svg) is closer to ![](images/92/9252231dcb743cf6f0c6df56fdcc7e3f30a9c4d371ad30332ac7a5f93b38b3e4.svg) the root is closer to ![](images/10/106a07431c2edab74f94a851a8f9d6d4c67fb6e29b7c2090e316e5c2032195e3.svg) Therefore,\n![](images/5d/5d0fdcc02424b0794c647227784e86791079bbdbc184868c2bbbdec3ddcf86cb.svg)" :db/ensure [:tutorial/validate]} {:db/id "activity-026afa17-469a-5361-b712-278c42146aba" :activity/id #uuid "026afa17-469a-5361-b712-278c42146aba" :activity/title "Approximating Square Roots and Cube Roots" :activity/type :activity.type/lesson :activity/scope "topic-76fea41a-98af-5c68-b72e-6881d877a1e9" :activity/expected-seconds 600.0 :activity/steps ["step-dcf6056d-ef27-5b88-b777-e073060226e7" "step-62da36f8-cd66-52bf-9d7e-c13cf03ade4e" "step-9755cb4a-e49f-5626-89dc-85c19b18c155" "step-b17102b3-2a85-5565-86ee-18a47a1d1472" "step-650093b9-8f2e-54ea-96a0-c4ce86769990" "step-b59cf68c-8312-512d-83a4-ee45cfcfa2cc" "step-4f77a136-9bb5-536c-a5f5-9e3132dc7e39" "step-ea67ea8f-3960-5050-b5de-d9bafa206de8" "step-a9f05ba0-f57e-5845-8ac7-3153bd449a36"] :activity/first-step "step-dcf6056d-ef27-5b88-b777-e073060226e7" :db/ensure [:activity/validate]} {:db/id "step-dcf6056d-ef27-5b88-b777-e073060226e7" :step/id #uuid "dcf6056d-ef27-5b88-b777-e073060226e7" :step/content "tutorial-4dbd01ab-76e0-5e52-b2bb-2efdd00a2058" :step/math-academy-id 835633 :step/next "step-62da36f8-cd66-52bf-9d7e-c13cf03ade4e" :db/ensure [:step/validate]} {:db/id "step-62da36f8-cd66-52bf-9d7e-c13cf03ade4e" :step/id #uuid "62da36f8-cd66-52bf-9d7e-c13cf03ade4e" :step/content "tutorial-914a8dc0-a88e-5f85-bc5d-34aec57c480e" :step/math-academy-id 835631 :step/next "step-9755cb4a-e49f-5626-89dc-85c19b18c155" :db/ensure [:step/validate]} {:db/id "step-9755cb4a-e49f-5626-89dc-85c19b18c155" :step/id #uuid "9755cb4a-e49f-5626-89dc-85c19b18c155" :step/content "knowledge-point-9f6b9f6c-95f0-5c70-b22d-f60c0e9d20da" :step/math-academy-id 834841 :step/next "step-b17102b3-2a85-5565-86ee-18a47a1d1472" :db/ensure [