db/ensure [:answer/validate]} {:db/id "answer-0c3799d1-e22b-508b-99e0-e101484e5368" :answer/id #uuid "0c3799d1-e22b-508b-99e0-e101484e5368" :answer/type :answer.type/math :answer/value "5{x}^{4}y" :db/ensure [:answer/validate]} {:db/id "answer-cb1f5daa-1a7b-5b59-9eaf-11ba1bde0022" :answer/id #uuid "cb1f5daa-1a7b-5b59-9eaf-11ba1bde0022" :answer/type :answer.type/math :answer/value "5{x}^{4}{y}^{2}" :db/ensure [:answer/validate]} {:db/id "question-e0110074-4c62-517f-b5cb-ff4cff4e0579" :question/id #uuid "e0110074-4c62-517f-b5cb-ff4cff4e0579" :question/math-academy-id "q-22838" :question/problem "Which of the following is equivalent to ${(\\frac{{u}^{2}}{-2{v}^{4}})}^{5}?$" :question/worked-solution "We start by using the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{{u}^{2}}{-2{v}^{4}})}^{5} & = \\\\ \\frac{{({u}^{2})}^{5}}{{(-2{v}^{4})}^{5}} & \\end{aligned}\n$$\n\nThen, we apply the power rule in the numerator and the power of product rule in the denominator:\n\n$$\n\\begin{aligned}\\frac{{({u}^{2})}^{5}}{{(-2{v}^{4})}^{5}} & = \\\\ \\frac{{u}^{2\\cdot 5}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} & = \\\\ \\frac{{u}^{10}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} & \\end{aligned}\n$$\n\nFinally, we apply the power rule for exponents:\n\n$$\n\\begin{aligned}\\frac{{u}^{10}}{(-2)^{5}\\cdot {({v}^{4})}^{5}} & = \\\\ \\frac{{u}^{10}}{(-2)^{5}\\cdot {v}^{4\\cdot 5}} & = \\\\ \\frac{{u}^{10}}{(-32)\\cdot {v}^{20}} & = \\\\ -\\frac{{u}^{10}}{32{v}^{20}} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e4acd8be-661d-5d96-83bb-5a718612e8be"] :db/ensure [:question/validate]} {:db/id "answer-field-e4acd8be-661d-5d96-83bb-5a718612e8be" :answer-field/id #uuid "e4acd8be-661d-5d96-83bb-5a718612e8be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-465a9a31-c9a7-5242-b06e-83d1de732242" :answer-field/choices ["answer-cc5a67c3-eb72-52e8-8d6e-906807a56f0f" "answer-465a9a31-c9a7-5242-b06e-83d1de732242" "answer-4ea53a6a-43cc-5424-b0c0-f4959baa4754" "answer-6842d70f-c788-545a-96c5-2eb791e9c865" "answer-a8cdef2e-ff7f-5848-8193-597d13abef49"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc5a67c3-eb72-52e8-8d6e-906807a56f0f" :answer/id #uuid "cc5a67c3-eb72-52e8-8d6e-906807a56f0f" :answer/type :answer.type/math :answer/value "-\\frac{{u}^{10}}{2{v}^{20}}" :db/ensure [:answer/validate]} {:db/id "answer-465a9a31-c9a7-5242-b06e-83d1de732242" :answer/id #uuid "465a9a31-c9a7-5242-b06e-83d1de732242" :answer/type :answer.type/math :answer/value "-\\frac{{u}^{10}}{32{v}^{20}}" :db/ensure [:answer/validate]} {:db/id "answer-4ea53a6a-43cc-5424-b0c0-f4959baa4754" :answer/id #uuid "4ea53a6a-43cc-5424-b0c0-f4959baa4754" :answer/type :answer.type/math :answer/value "-\\frac{{u}^{7}}{32{v}^{9}}" :db/ensure [:answer/validate]} {:db/id "answer-6842d70f-c788-545a-96c5-2eb791e9c865" :answer/id #uuid "6842d70f-c788-545a-96c5-2eb791e9c865" :answer/type :answer.type/math :answer/value "\\frac{{u}^{5}}{16{v}^{5}}" :db/ensure [:answer/validate]} {:db/id "answer-a8cdef2e-ff7f-5848-8193-597d13abef49" :answer/id #uuid "a8cdef2e-ff7f-5848-8193-597d13abef49" :answer/type :answer.type/math :answer/value "\\frac{{u}^{6}}{8{v}^{12}}" :db/ensure [:answer/validate]} {:db/id "question-842d5936-85a3-5b6e-b4fa-f505a9d0860b" :question/id #uuid "842d5936-85a3-5b6e-b4fa-f505a9d0860b" :question/math-academy-id "q-72511" :question/problem "Simplify the expression $y\\cdot \\sqrt[4]{y}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}y\\cdot \\sqrt[4]{y}=y\\cdot {y}^{1/4}\\end{aligned}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}y\\cdot {y}^{1/4} & = \\\\ {y}^{1+1/4} & = \\\\ {y}^{5/4}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{5/4} & =\\sqrt[4]{{y}^{5}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f2675a89-c5db-5be6-a863-504dfe78916e"] :db/ensure [:question/validate]} {:db/id "answer-field-f2675a89-c5db-5be6-a863-504dfe78916e" :answer-field/id #uuid "f2675a89-c5db-5be6-a863-504dfe78916e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bd06633e-df0e-50eb-902f-8ff48110959f" :answer-field/choices ["answer-c48364e6-a284-5fda-a5f7-dfb7c464c310" "answer-bd06633e-df0e-50eb-902f-8ff48110959f" "answer-3195d9ce-4aa6-599a-be0b-62ab0a5b2c62" "answer-2f28308b-720b-5df8-a2b3-3f5e70ac4866" "answer-a28d9916-0048-550e-ab13-3f717c29f173"] :db/ensure [:answer-field/validate]} {:db/id "answer-c48364e6-a284-5fda-a5f7-dfb7c464c310" :answer/id #uuid "c48364e6-a284-5fda-a5f7-dfb7c464c310" :answer/type :answer.type/math :answer/value "\\sqrt[4]{y}" :db/ensure [:answer/validate]} {:db/id "answer-bd06633e-df0e-50eb-902f-8ff48110959f" :answer/id #uuid "bd06633e-df0e-50eb-902f-8ff48110959f" :answer/type :answer.type/math :answer/value "\\sqrt[4]{{y}^{5}}" :db/ensure [:answer/validate]} {:db/id "answer-3195d9ce-4aa6-599a-be0b-62ab0a5b2c62" :answer/id #uuid "3195d9ce-4aa6-599a-be0b-62ab0a5b2c62" :answer/type :answer.type/math :answer/value "\\sqrt{y}" :db/ensure [:answer/validate]} {:db/id "answer-2f28308b-720b-5df8-a2b3-3f5e70ac4866" :answer/id #uuid "2f28308b-720b-5df8-a2b3-3f5e70ac4866" :answer/type :answer.type/math :answer/value "\\sqrt{{y}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-a28d9916-0048-550e-ab13-3f717c29f173" :answer/id #uuid "a28d9916-0048-550e-ab13-3f717c29f173" :answer/type :answer.type/math :answer/value "\\sqrt{{y}^{5}}" :db/ensure [:answer/validate]} {:db/id "question-64c8a090-cafc-5e88-b591-72ecb0cc7b81" :question/id #uuid "64c8a090-cafc-5e88-b591-72ecb0cc7b81" :question/math-academy-id "q-142145" :question/problem "Simplify the expression $\\sqrt{y}\\cdot \\sqrt[4]{y}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}\\sqrt{y}\\cdot \\sqrt[4]{y}={y}^{1/2}\\cdot {y}^{1/4}\\end{aligned}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}{y}^{1/2}\\cdot {y}^{1/4} & = \\\\ {y}^{1/2+1/4} & = \\\\ {y}^{3/4}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{3/4} & =\\sqrt[4]{{y}^{3}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2373b85f-68d6-5beb-815d-bde5b1392e92"] :db/ensure [:question/validate]} {:db/id "answer-field-2373b85f-68d6-5beb-815d-bde5b1392e92" :answer-field/id #uuid "2373b85f-68d6-5beb-815d-bde5b1392e92" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer-field/choices ["answer-b33aa548-4b46-5ab9-830b-ffa8ce5ad423" "answer-0c2c17b6-ee01-55d3-81de-a6a069a28374" "answer-badfdb89-f38f-5c6f-b938-cf0c832948ff" "answer-b150665b-cc55-5a3e-9bc9-352c3cbb62f2" "answer-7470470e-9dcb-5cb6-a298-354e8bd306a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-b33aa548-4b46-5ab9-830b-ffa8ce5ad423" :answer/id #uuid "b33aa548-4b46-5ab9-830b-ffa8ce5ad423" :answer/type :answer.type/math :answer/value "\\sqrt[3]{y}" :db/ensure [:answer/validate]} {:db/id "answer-0c2c17b6-ee01-55d3-81de-a6a069a28374" :answer/id #uuid "0c2c17b6-ee01-55d3-81de-a6a069a28374" :answer/type :answer.type/math :answer/value "\\sqrt[3]{{y}^{4}}" :db/ensure [:answer/validate]} {:db/id "answer-badfdb89-f38f-5c6f-b938-cf0c832948ff" :answer/id #uuid "badfdb89-f38f-5c6f-b938-cf0c832948ff" :answer/type :answer.type/math :answer/value "\\sqrt[4]{y}" :db/ensure [:answer/validate]} {:db/id "answer-b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer/id #uuid "b150665b-cc55-5a3e-9bc9-352c3cbb62f2" :answer/type :answer.type/math :answer/value "\\sqrt[4]{{y}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-7470470e-9dcb-5cb6-a298-354e8bd306a9" :answer/id #uuid "7470470e-9dcb-5cb6-a298-354e8bd306a9" :answer/type :answer.type/math :answer/value "\\sqrt[6]{y}" :db/ensure [:answer/validate]} {:db/id "question-af52435b-8d7b-5fb6-b052-723de06fafd6" :question/id #uuid "af52435b-8d7b-5fb6-b052-723de06fafd6" :question/math-academy-id "q-104671" :question/problem "Simplify the expression $\\frac{{y}^{9}}{\\sqrt[3]{{y}^{7}}}.$" :question/worked-solution "First, we rewrite the radical as a fractional exponent:\n\n$$\n\\begin{aligned}\\frac{{y}^{9}}{\\sqrt[3]{{y}^{7}}}=\\frac{{y}^{9}}{{({y}^{7})}^{1/3}}\\end{aligned}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\n\\frac{{y}^{9}}{{({y}^{7})}^{1/3}}=\\frac{{y}^{9}}{{y}^{7(1/3)}}=\\frac{{y}^{9}}{{y}^{7/3}}\n$$\n\nThen, we apply the quotient rule:\n\n$$\n\\begin{aligned}\\frac{{y}^{9}}{{y}^{7/3}} & = \\\\ {y}^{9-7/3} & = \\\\ {y}^{20/3}\\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\n\\begin{aligned}{y}^{20/3} & =\\sqrt[3]{{y}^{20}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d8df651f-f104-583c-9836-0f9f71da1bc3"] :db/ensure [:question/validate]} {:db/id "answer-field-d8df651f-f104-583c-9836-0f9f71da1bc3" :answer-field/id #uuid "d8df651f-f104-583c-9836-0f9f71da1bc3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c464b8a-119e-51a8-ab64-abc53812e731" :answer-field/choices ["answer-a1cb0968-e908-510a-9a85-6ab2251201bf" "answer-7df0dfb7-2b06-5629-941d-770a6b80e3e5" "answer-b1241184-32b5-5462-84ef-9651c1478e5b" "answer-7c464b8a-119e-51a8-ab64-abc53812e731" "answer-b1ba8311-f3f5-56e3-b433-b35071e9ac33"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1cb0968-e908-510a-9a85-6ab2251201bf" :answer/id #uuid "a1cb0968-e908-510a-9a85-6ab2251201bf" :answer/type :answer.type/math :answer/value "\\sqrt[20]{{y}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-7df0dfb7-2b06-5629-941d-770a6b80e3e5" :answer/id #uuid "7df0dfb7-2b06-5629-941d-770a6b80e3e5" :answer/type :answer.type/math :answer/value "\\sqrt[34]{{y}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-b1241184-32b5-5462-84ef-9651c1478e5b" :answer/id #uuid "b1241184-32b5-5462-84ef-9651c1478e5b" :answer/type :answer.type/math :answer/value "\\sqrt[3]{{y}^{19}}" :db/ensure [:answer/validate]} {:db/id "answer-7c464b8a-119e-51a8-ab64-abc53812e731" :answer/id #uuid "7c464b8a-119e-51a8-ab64-abc53812e731" :answer/type :answer.type/math :answer/value "\\sqrt[3]{{y}^{20}}" :db/ensure [:answer/validate]} {:db/id "answer-b1ba8311-f3f5-56e3-b433-b35071e9ac33" :answer/id #uuid "b1ba8311-f3f5-56e3-b433-b35071e9ac33" :answer/type :answer.type/math :answer/value "\\sqrt[3]{{y}^{34}}" :db/ensure [:answer/validate]} {:db/id 17592186111824 :tutorial/content "Sometimes, we might need to use more than one rule of exponents to simplify an expression. First, let's remind ourselves of all of the rules of exponents.\n\n- Radicals as fractional exponents: $\\sqrt[n]{x} = x^{1/n}$\n\n- The product rule: $a^n \\cdot a^m = a^{n+m}$\n\n- The quotient rule: $\\dfrac{a^n}{a^m} = a^{n-m}$\n\n- The power rule: $\\left( a^m \\right)^n = a^{mn}$\n\n- The power of product rule: $(ab)^n = a^nb^n$\n\n- The power of quotient rule: $\\left(\\dfrac a b \\right)^n = \\dfrac{a^n}{b^n}$\n\nAs an example, let's simplify the following expression:\n\n$$\n\\left(u^2 v\\right)^3\n$$\n\nWe start by using the power of product rule:\n\n$$\n\\begin{aligned}{({u}^{2}v)}^{3}={({u}^{2})}^{3}\\cdot {v}^{3}\\end{aligned}\n$$\n\nThen, we use the power rule:\n\n$$\n\\begin{aligned}{({u}^{2})}^{3}\\cdot {v}^{3} & = \\\\ {u}^{(2\\cdot 3)}\\cdot {v}^{3} & = \\\\ {u}^{6}\\cdot {v}^{3} & = \\\\ {u}^{6}{v}^{3}\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186111904 :tutorial/content "To simplify the expression $x\\cdot \\sqrt[3]{x^2},$ we first rewrite the radical as a fractional exponent:\n\n$$\nx \\cdot \\sqrt[3]{x^2} = x \\cdot \\left( x^2 \\right)^{1/3}\n$$\n\nNow, we apply the power rule for exponents:\n\n$$\nx \\cdot \\left( x^2 \\right)^{1/3} = x \\cdot x^{2(1/3)} = x \\cdot x^{2/3}\n$$\n\nThen, we apply the product rule:\n\n$$\n\\begin{aligned}x\\cdot {x}^{2/3} & = \\\\ {x}^{1+2/3} & = \\\\ {x}^{5/3} & \\end{aligned}\n$$\n\nFinally, we express the result as a radical:\n\n$$\nx^{5/3} = \\sqrt[3]{x^5}\n$$\n\nNotice that, by combining the radicals as fractional exponents and power rules, we get the following formula:\n\n$$\n\\sqrt[n]{x^m} = x^{m/n}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186110813 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186197624 :answer-field/choices 17592186197625] [:db/retract 17592186197624 :answer-field/choices 17592186197626] [:db/retract 17592186197624 :answer-field/choices 17592186197627] [:db/retract 17592186197624 :answer-field/choices 17592186197628] [:db/retract 17592186197624 :answer-field/choices 17592186197629] {:db/id 17592186198397 :knowledge-point/questions ["question-21557ab9-79b3-55a0-a104-51c3d273599e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198959 :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le x+y\\le 2,\\,1\\le x-y\\le 2,\\,1\\le z\\le (x-y)(x+y)\\}.\n$$\n\nBy performing the change of variables\n\n$$\nu=x+y,\\,v=x-y,\\,w=\\sqrt{z},\n$$\n\nthe triple integral\n\n$$\n{∭}_{R}3\\sqrt{z}\\,dV\n$$\n\ncan be written in terms of $u,$ $v,$ and $w$ as" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+y,\\,v=x-y,\\,w=\\sqrt{z}\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,1\\le v\\le 2,\\,1\\le {w}^{2}\\le uv\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & \\frac{1}{2\\sqrt{z}}\\end{aligned}| \\\\  & =\\frac{1}{2\\sqrt{z}}(-1)^{3+3}|\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}| \\\\  & =\\frac{1}{2\\sqrt{z}}(-1-1) \\\\  & =-\\frac{1}{\\sqrt{z}} \\\\  & =-\\frac{1}{w}\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-w.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}3\\sqrt{z}\\,dV & ={∭}_{Δ}3w\\cdot |-w|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}3{w}^{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{uv}3{w}^{2}\\,dw\\,dv\\,du\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186197624 :answer-field/correct "answer-04edc689-9e29-5c9b-8da2-da4420287986" :answer-field/choices ["answer-314e6482-a456-5bda-8904-887833458d85" "answer-9156d344-2302-5c4e-b0e7-6f7c95dca531" "answer-cd799ece-9c4a-56a0-b053-cc390590f85c" "answer-57cc1828-6342-5346-b05d-7d143db10ddf" "answer-04edc689-9e29-5c9b-8da2-da4420287986"] :db/ensure [:answer-field/validate]} {:db/id "answer-314e6482-a456-5bda-8904-887833458d85" :answer/id #uuid "314e6482-a456-5bda-8904-887833458d85" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}3\\sqrt{w}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-9156d344-2302-5c4e-b0e7-6f7c95dca531" :answer/id #uuid "9156d344-2302-5c4e-b0e7-6f7c95dca531" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{2}3{w}^{2}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-cd799ece-9c4a-56a0-b053-cc390590f85c" :answer/id #uuid "cd799ece-9c4a-56a0-b053-cc390590f85c" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{u+v}3w\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-57cc1828-6342-5346-b05d-7d143db10ddf" :answer/id #uuid "57cc1828-6342-5346-b05d-7d143db10ddf" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{uv}3\\sqrt{w}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "answer-04edc689-9e29-5c9b-8da2-da4420287986" :answer/id #uuid "04edc689-9e29-5c9b-8da2-da4420287986" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{1}^{2}{\\int }_{1}^{uv}3{w}^{2}\\,dw\\,dv\\,du" :db/ensure [:answer/validate]} {:db/id "question-21557ab9-79b3-55a0-a104-51c3d273599e" :question/id #uuid "21557ab9-79b3-55a0-a104-51c3d273599e" :question/math-academy-id "q-161868" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le \\frac{2x-y}{2}\\le 1,\\,0\\le \\frac{y}{2}\\le 2,\\,0\\le z\\le 3\\}.\n$$\n\nGiven the change of variables\n\n$$\nu=\\frac{2x-y}{2},\\,v=\\frac{y}{2},\\,w=\\frac{z}{3},\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}(\\frac{2x-y}{2}+\\frac{z}{3})\\,dV={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{1}\\bbox[3pt,border:1pt solid black]{\\phantom{AAAAAA}}\\,dw\\,dv\\,du\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{2x-y}{2},\\,v=\\frac{y}{2},\\,w=\\frac{z}{3},\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 2,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -\\frac{1}{2} & 0 \\\\ 0 & \\,\\,\\,\\frac{1}{2} & 0 \\\\ 0 & 0 & \\frac{1}{3}\\end{aligned}| \\\\  & =\\frac{1}{3}|\\begin{aligned}1 & -\\frac{1}{2} \\\\ 0 & \\,\\,\\,\\frac{1}{2}\\end{aligned}| \\\\  & =\\frac{1}{3}(\\frac{1}{2}-0) \\\\  & =\\frac{1}{6}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=6.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(\\frac{2x-y}{2}+\\frac{z}{3})\\,dV & ={∭}_{Δ}(u+w)\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}(u+w)\\cdot |6|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{1}\\,6(u+w)\\,dw\\,dv\\,du\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-219a7147-3bde-5244-974f-5c2639b194f2"] :db/ensure [:question/validate]} {:db/id "answer-field-219a7147-3bde-5244-974f-5c2639b194f2" :answer-field/id #uuid "219a7147-3bde-5244-974f-5c2639b194f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0c97c988-3336-5cff-9def-ec7413102202" :answer-field/choices ["answer-5760564c-6d75-5aa4-a9ab-7873348de3bc" "answer-0c97c988-3336-5cff-9def-ec7413102202" "answer-449afe6a-6893-523f-8969-4d9facf23e7a" "answer-1c002a85-7881-5d55-b3a3-c0858f2a52d4" "answer-9cc9fd42-c83a-5ec5-bb24-9d73b0ba363e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5760564c-6d75-5aa4-a9ab-7873348de3bc" :answer/id #uuid "5760564c-6d75-5aa4-a9ab-7873348de3bc" :answer/type :answer.type/math :answer/value "(u-w-v)" :db/ensure [:answer/validate]} {:db/id "answer-0c97c988-3336-5cff-9def-ec7413102202" :answer/id #uuid "0c97c988-3336-5cff-9def-ec7413102202" :answer/type :answer.type/math :answer/value "6(u+w)" :db/ensure [:answer/validate]} {:db/id "answer-449afe6a-6893-523f-8969-4d9facf23e7a" :answer/id #uuid "449afe6a-6893-523f-8969-4d9facf23e7a" :answer/type :answer.type/math :answer/value "6(v-w)" :db/ensure [:answer/validate]} {:db/id "answer-1c002a85-7881-5d55-b3a3-c0858f2a52d4" :answer/id #uuid "1c002a85-7881-5d55-b3a3-c0858f2a52d4" :answer/type :answer.type/math :answer/value "\\frac{1}{6}(u+v-w)" :db/ensure [:answer/validate]} {:db/id "answer-9cc9fd42-c83a-5ec5-bb24-9d73b0ba363e" :answer/id #uuid "9cc9fd42-c83a-5ec5-bb24-9d73b0ba363e" :answer/type :answer.type/math :answer/value "\\frac{1}{6}(v-w)" :db/ensure [:answer/validate]} {:db/id 17592186198398 :knowledge-point/questions ["question-787730fc-5924-57cd-ac3a-f6e87e085583"] :db/ensure [:knowledge-point/validate]} {:db/id "question-787730fc-5924-57cd-ac3a-f6e87e085583" :question/id #uuid "787730fc-5924-57cd-ac3a-f6e87e085583" :question/math-academy-id "q-161893" :question/problem "Use the change of variables \n\n$$\nu=x+y,\\,v=y-x,\\,w=z,\n$$\n\nto evaluate the triple integral\n\n$$\n∭(x+y){e}^{y-x}\\,dV,\n$$\n\n \nwhere the region $R$ is given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le x+y\\le 2,\\,0\\le y-x\\le 1,\\,0\\le z\\le 3\\}.\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+y,\\,v=y-x,\\,w=z,\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,1\\le u\\le 2,\\,0\\le v\\le 1,\\,0\\le w\\le 3\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}| \\\\  & =1-(-1) \\\\  & =2.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=\\frac{1}{2}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+y){e}^{y-x}\\,dV & ={∭}_{Δ}u{e}^{v}\\cdot |-\\frac{1}{2}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}\\frac{u{e}^{v}}{2}\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}{\\int }_{0}^{3}\\frac{u{e}^{v}}{2}\\,dw\\,dv\\,du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}u\\,du\\cdot {\\int }_{0}^{1}{e}^{v}\\,dv\\cdot {\\int }_{0}^{3}dw \\\\  & =\\frac{1}{2}\\cdot [\\frac{{u}^{2}}{2}]_{u=1}^{u=2}\\cdot {[{e}^{v}]}_{v=0}^{v=1}\\cdot [w]_{w=0}^{w=3} \\\\  & =\\frac{1}{2}(2-\\frac{1}{2})\\cdot (e-1)\\cdot (3-0) \\\\  & =\\frac{9}{4}(e-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2030cf44-2880-55da-b8da-7f5dffbc7894"] :db/ensure [:question/validate]} {:db/id "answer-field-2030cf44-2880-55da-b8da-7f5dffbc7894" :answer-field/id #uuid "2030cf44-2880-55da-b8da-7f5dffbc7894" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7d9780c4-afc1-59e7-ac65-84b80ad23ee1" :answer-field/choices ["answer-1784c964-2bd8-551a-9e62-6cb6f2560ce3" "answer-903bd708-b320-50fc-b991-e52faae4df28" "answer-4f74f069-41cb-54fc-8a9a-08d22d7c1865" "answer-7d9780c4-afc1-59e7-ac65-84b80ad23ee1" "answer-255b1548-0862-5d3a-8e4b-d22ea5aa0f02"] :db/ensure [:answer-field/validate]} {:db/id "answer-1784c964-2bd8-551a-9e62-6cb6f2560ce3" :answer/id #uuid "1784c964-2bd8-551a-9e62-6cb6f2560ce3" :answer/type :answer.type/math :answer/value "3e" :db/ensure [:answer/validate]} {:db/id "answer-903bd708-b320-50fc-b991-e52faae4df28" :answer/id #uuid "903bd708-b320-50fc-b991-e52faae4df28" :answer/type :answer.type/math :answer/value "3e+2" :db/ensure [:answer/validate]} {:db/id "answer-4f74f069-41cb-54fc-8a9a-08d22d7c1865" :answer/id #uuid "4f74f069-41cb-54fc-8a9a-08d22d7c1865" :answer/type :answer.type/math :answer/value "\\frac{3e}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7d9780c4-afc1-59e7-ac65-84b80ad23ee1" :answer/id #uuid "7d9780c4-afc1-59e7-ac65-84b80ad23ee1" :answer/type :answer.type/math :answer/value "\\frac{9}{4}(e-1)" :db/ensure [:answer/validate]} {:db/id "answer-255b1548-0862-5d3a-8e4b-d22ea5aa0f02" :answer/id #uuid "255b1548-0862-5d3a-8e4b-d22ea5aa0f02" :answer/type :answer.type/math :answer/value "\\frac{e-1}{3}" :db/ensure [:answer/validate]} {:db/id 17592186198399 :knowledge-point/questions ["question-ad40770e-3352-5877-ade7-ccfd965beccc" "question-92990ecc-5ba0-56e3-944d-6e84f299eb57"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ad40770e-3352-5877-ade7-ccfd965beccc" :question/id #uuid "ad40770e-3352-5877-ade7-ccfd965beccc" :question/math-academy-id "q-162185" :question/problem "Find the volume bounded by the region $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,-1\\le {x}^{2}-y\\le 1,\\,1\\le \\,x\\le 2,\\,0\\le z\\le 3\\}.\n$$" :question/worked-solution "Recall that the volume of $R$ can be found as \n\n$$\nV={∭}_{R}\\text{d}V.\n$$\n\nLet's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required volume, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nThe inequalities that define the region $R,$\n\n$$\n-1\\le {x}^{2}-y\\le 1,\\,1\\le \\,x\\le 2,\\,0\\le z\\le 3,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu={x}^{2}-y,\\,v=x,\\,w=z.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required volume, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,-1\\le u\\le 1,\\,1\\le v\\le 2,\\,0\\le w\\le 3\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & -1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{2+1}|\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}| \\\\  & =1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=1.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}dV & ={∭}_{Δ}1\\cdot |1|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{-1}^{1}{\\int }_{1}^{2}{\\int }_{0}^{3}\\,dw\\,dv\\,du \\\\  & ={\\int }_{-1}^{1}du\\cdot {\\int }_{1}^{2}dv\\cdot {\\int }_{0}^{3}dw \\\\  & =[u]_{u=-1}^{u=1}\\cdot [v]_{v=1}^{v=2}\\cdot [w]_{w=0}^{w=3} \\\\  & =(1-(-1))\\cdot (2-1)\\cdot (3-0) \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-612abc3f-006a-54a9-ba2c-ed70e2955dbe"] :db/ensure [:question/validate]} {:db/id "answer-field-612abc3f-006a-54a9-ba2c-ed70e2955dbe" :answer-field/id #uuid "612abc3f-006a-54a9-ba2c-ed70e2955dbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a4d46a27-dd36-5701-8dd1-b3331e4e3270" :answer-field/choices ["answer-e83877aa-f978-5e05-a20d-0069c96a2685" "answer-7649b34b-2218-533c-b3c5-146847fddc3d" "answer-040577a1-f488-586f-a244-5ac52452a051" "answer-a4d46a27-dd36-5701-8dd1-b3331e4e3270" "answer-134f7fbf-b645-5f5e-a680-2cf1d5fc853c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e83877aa-f978-5e05-a20d-0069c96a2685" :answer/id #uuid "e83877aa-f978-5e05-a20d-0069c96a2685" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-7649b34b-2218-533c-b3c5-146847fddc3d" :answer/id #uuid "7649b34b-2218-533c-b3c5-146847fddc3d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-040577a1-f488-586f-a244-5ac52452a051" :answer/id #uuid "040577a1-f488-586f-a244-5ac52452a051" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-a4d46a27-dd36-5701-8dd1-b3331e4e3270" :answer/id #uuid "a4d46a27-dd36-5701-8dd1-b3331e4e3270" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-134f7fbf-b645-5f5e-a680-2cf1d5fc853c" :answer/id #uuid "134f7fbf-b645-5f5e-a680-2cf1d5fc853c" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-92990ecc-5ba0-56e3-944d-6e84f299eb57" :question/id #uuid "92990ecc-5ba0-56e3-944d-6e84f299eb57" :question/math-academy-id "q-162210" :question/problem "Find the volume bounded by the region $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,0\\le y-{e}^{x}\\le 1,\\,1\\le y\\le 2,\\,0\\le z{e}^{-x}\\le 1\\}.\n$$" :question/worked-solution "Recall that the volume of $R$ can be found as \n\n$$\nV={∭}_{R}\\text{d}V.\n$$\n\nLet's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo compute the required volume, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nThe inequalities that define the region $R,$\n\n$$\n0\\le y-{e}^{x}\\le 1,\\,1\\le y\\le 2,\\,0\\le z{e}^{-x}\\le 1,\n$$\n\nsuggest that we use the change of variables\n\n$$\nu=y-{e}^{x},\\,v=y,\\,w=z{e}^{-x}.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo compute the required volume, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v,w)\\,:\\,0\\le u\\le 1,\\,1\\le v\\le 2,\\,0\\le w\\le 1\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}-{e}^{x} & 1 & 0 \\\\ 0 & 1 & 0 \\\\ -z{e}^{-x} & 0 & {e}^{-x}\\end{aligned}| \\\\  & =1(-1)^{2+2}|\\begin{aligned}-{e}^{x} & 0 \\\\ -z{e}^{-x} & {e}^{-x}\\end{aligned}| \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}dV & ={∭}_{Δ}1\\cdot |-1|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{1}{\\int }_{1}^{2}{\\int }_{0}^{1}dw\\,dv\\,du \\\\  & ={\\int }_{0}^{1}du\\cdot {\\int }_{1}^{2}dv\\cdot {\\int }_{0}^{1}dw \\\\  & =[u]_{u=0}^{u=1}\\cdot [v]_{v=1}^{v=2}\\cdot [w]_{w=0}^{w=1} \\\\  & =(1-0)\\cdot (2-1)\\cdot (1-0) \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-772a5b09-0846-503c-9495-bc958a42c8ce"] :db/ensure [:question/validate]} {:db/id "answer-field-772a5b09-0846-503c-9495-bc958a42c8ce" :answer-field/id #uuid "772a5b09-0846-503c-9495-bc958a42c8ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a6520622-46f1-5688-af38-61a3ff107da8" :answer-field/choices ["answer-a6520622-46f1-5688-af38-61a3ff107da8" "answer-c17ed11d-1615-505b-9ee3-f62b086faf02" "answer-12666955-acda-50b1-a759-415719031788" "answer-faf10f5c-fe15-5f32-843c-38243f61e787" "answer-33260567-19af-5f87-8391-f7b7b20532c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6520622-46f1-5688-af38-61a3ff107da8" :answer/id #uuid "a6520622-46f1-5688-af38-61a3ff107da8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-c17ed11d-1615-505b-9ee3-f62b086faf02" :answer/id #uuid "c17ed11d-1615-505b-9ee3-f62b086faf02" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-12666955-acda-50b1-a759-415719031788" :answer/id #uuid "12666955-acda-50b1-a759-415719031788" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-faf10f5c-fe15-5f32-843c-38243f61e787" :answer/id #uuid "faf10f5c-fe15-5f32-843c-38243f61e787" :answer/type :answer.type/math :answer/value "\\frac{e}{2}" :db/ensure [:answer/validate]} {:db/id "answer-33260567-19af-5f87-8391-f7b7b20532c1" :answer/id #uuid "33260567-19af-5f87-8391-f7b7b20532c1" :answer/type :answer.type/math :answer/value "e" :db/ensure [:answer/validate]} {:db/id "activity-70e5a969-4930-5f59-a691-24b99f9f02ca" :activity/id #uuid "70e5a969-4930-5f59-a691-24b99f9f02ca" :activity/title "Computing Triple Integrals Using a Change of Variables" :activity/type :activity.type/review :activity/scope 17592186049639 :activity/course 17592186046660 :activity/steps ["step-4e424c3d-338b-5df6-aae5-f03d2886355c" "step-e20f59c5-7952-5312-97e3-4d44495b61dc" "step-c04691e5-85fd-5cb5-b13a-fc0b06ac55dd" "step-997f14cb-37bb-5df1-8d09-16e21f99f0e8" "step-d3034e3f-9bca-5084-a008-31d00f87ec29"] :activity/first-step "step-4e424c3d-338b-5df6-aae5-f03d2886355c" :db/ensure [:activity/validate]} {:db/id "step-4e424c3d-338b-5df6-aae5-f03d2886355c" :step/id #uuid "4e424c3d-338b-5df6-aae5-f03d2886355c" :step/content 17592186198959 :step/next "step-e20f59c5-7952-5312-97e3-4d44495b61dc" :db/ensure [:step/validate]} {:db/id "step-e20f59c5-7952-5312-97e3-4d44495b61dc" :step/id #uuid "e20f59c5-7952-5312-97e3-4d44495b61dc" :step/content "question-21557ab9-79b3-55a0-a104-51c3d273599e" :step/next "step-c04691e5-85fd-5cb5-b13a-fc0b06ac55dd" :db/ensure [:step/validate]} {:db/id "step-c04691e5-85fd-5cb5-b13a-fc0b06ac55dd" :step/id #uuid "c04691e5-85fd-5cb5-b13a-fc0b06ac55dd" :step/content "question-787730fc-5924-57cd-ac3a-f6e87e085583" :step/next "step-997f14cb-37bb-5df1-8d09-16e21f99f0e8" :db/ensure [:step/validate]} {:db/id "step-997f14cb-37bb-5df1-8d09-16e21f99f0e8" :step/id #uuid "997f14cb-37bb-5df1-8d09-16e21f99f0e8" :step/content "question-ad40770e-3352-5877-ade7-ccfd965beccc" :step/next "step-d3034e3f-9bca-5084-a008-31d00f87ec29" :db/ensure [:step/validate]} {:db/id "step-d3034e3f-9bca-5084-a008-31d00f87ec29" :step/id #uuid "d3034e3f-9bca-5084-a008-31d00f87ec29" :step/content "question-92990ecc-5ba0-56e3-944d-6e84f299eb57" :db/ensure [:step/validate]} {:db/id 17592186179776 :knowledge-point/questions ["question-8662a311-148d-52aa-9581-67da3a804b43"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8662a311-148d-52aa-9581-67da3a804b43" :question/id #uuid "8662a311-148d-52aa-9581-67da3a804b43" :question/math-academy-id "q-162537" :question/problem "Which of the following is a stream function for the vector field\n$F(x,y)={x}^{2}\\operatorname{sin}⁡y\\,i+x\\operatorname{cos}⁡y\\,j?$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that $F(x,y)={x}^{2}\\operatorname{sin}⁡y\\,i+x\\operatorname{cos}⁡y\\,j$ is a vector field with simply connected domain $D={R}^{2},$ where $P(x,y)={x}^{2}\\operatorname{sin}⁡y$ and $Q(x,y)=x\\operatorname{cos}⁡y.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x\\operatorname{sin}⁡y,\\,\\frac{∂Q}{∂y} & =-x\\operatorname{sin}⁡y.\\end{aligned}\n$$\n\nHence, $F$ has a no stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2x\\operatorname{sin}⁡y+(-x\\operatorname{sin}⁡y)=x\\operatorname{sin}⁡y\\ne 0.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3a53c735-9b72-59d0-8d36-96505245d570"] :db/ensure [:question/validate]} {:db/id "answer-field-3a53c735-9b72-59d0-8d36-96505245d570" :answer-field/id #uuid "3a53c735-9b72-59d0-8d36-96505245d570" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e371cf2c-6265-557b-893f-ac88cb328896" :answer-field/choices ["answer-2f63601b-8c18-5c62-9c1d-b23197c0248e" "answer-9c7cb5ce-c76c-525b-952b-985fcb08f78a" "answer-2837348b-6d6d-5f9c-b59a-17f08f8c704b" "answer-61678505-c4a2-51bf-9209-a1b476663d99" "answer-e371cf2c-6265-557b-893f-ac88cb328896"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f63601b-8c18-5c62-9c1d-b23197c0248e" :answer/id #uuid "2f63601b-8c18-5c62-9c1d-b23197c0248e" :answer/type :answer.type/math :answer/value "xy{sin}^{2}⁡y" :db/ensure [:answer/validate]} {:db/id "answer-9c7cb5ce-c76c-525b-952b-985fcb08f78a" :answer/id #uuid "9c7cb5ce-c76c-525b-952b-985fcb08f78a" :answer/type :answer.type/math :answer/value "x{y}^{2}\\operatorname{sin}⁡y" :db/ensure [:answer/validate]} {:db/id "answer-2837348b-6d6d-5f9c-b59a-17f08f8c704b" :answer/id #uuid "2837348b-6d6d-5f9c-b59a-17f08f8c704b" :answer/type :answer.type/math :answer/value "{x}^{2}y\\operatorname{sin}⁡y" :db/ensure [:answer/validate]} {:db/id "answer-61678505-c4a2-51bf-9209-a1b476663d99" :answer/id #uuid "61678505-c4a2-51bf-9209-a1b476663d99" :answer/type :answer.type/math :answer/value "{x}^{2}{y}^{2}\\operatorname{sin}⁡y" :db/ensure [:answer/validate]} {:db/id "answer-e371cf2c-6265-557b-893f-ac88cb328896" :answer/id #uuid "e371cf2c-6265-557b-893f-ac88cb328896" :answer/type :answer.type/text :answer/value "$F$ has no stream function" :db/ensure [:answer/validate]} {:db/id 17592186179774 :knowledge-point/questions ["question-faed1d58-d701-5e29-bb64-3a9beae53a8b" "question-8e84ccf0-2025-55a1-91ce-ccafeeadc53e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-faed1d58-d701-5e29-bb64-3a9beae53a8b" :question/id #uuid "faed1d58-d701-5e29-bb64-3a9beae53a8b" :question/math-academy-id "q-162567" :question/problem "![](images/9f/9f2f77c6c2047dcd3f542fc0f640a68b45a4d40784d0e7eaacdcadb002c79de5.png)\n\nConsider the vector field $F$ shown above. Which of the following shows the streamlines of this vector field?" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nOf the given options, the only level curves tangential to the vector field at every point are shown below.\n\n![](images/dd/dd47775ffb4cba4cc01dde0bf404dca12bdeecc24e2f58639c04f1feda8293ee.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6c353f18-26f0-57c7-b34f-03eb3c1ed93a"] :db/ensure [:question/validate]} {:db/id "answer-field-6c353f18-26f0-57c7-b34f-03eb3c1ed93a" :answer-field/id #uuid "6c353f18-26f0-57c7-b34f-03eb3c1ed93a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dcc9ec84-1b7b-5e9c-a576-3127b03fef54" :answer-field/choices ["answer-dcc9ec84-1b7b-5e9c-a576-3127b03fef54" "answer-66c14112-d0b5-53d0-8392-f270d6eec5a9" "answer-56d8e193-cdfa-5f8f-af06-4ddefe6b4ec5" "answer-8332446a-894a-5efa-b549-105c9d96f0bf" "answer-4c2467c5-2c2d-5b5d-bc2b-28eb5cd0d0ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-dcc9ec84-1b7b-5e9c-a576-3127b03fef54" :answer/id #uuid "dcc9ec84-1b7b-5e9c-a576-3127b03fef54" :answer/type :answer.type/image :answer/value "images/2a/2ad340e6cd5a65e7f563ac898e7a56805a6d61e53ece75a6a4469031c60a62a5.png" :db/ensure [:answer/validate]} {:db/id "answer-66c14112-d0b5-53d0-8392-f270d6eec5a9" :answer/id #uuid "66c14112-d0b5-53d0-8392-f270d6eec5a9" :answer/type :answer.type/image :answer/value "images/42/42e1190d821286b8f66f39850d6c895b2801ef3e3f736d4e4df80df2e6ce513d.png" :db/ensure [:answer/validate]} {:db/id "answer-56d8e193-cdfa-5f8f-af06-4ddefe6b4ec5" :answer/id #uuid "56d8e193-cdfa-5f8f-af06-4ddefe6b4ec5" :answer/type :answer.type/image :answer/value "images/91/91e7124ef57462e9d8e0045582ccc8149608c687f3a822071345fa5b5f532cdd.png" :db/ensure [:answer/validate]} {:db/id "answer-8332446a-894a-5efa-b549-105c9d96f0bf" :answer/id #uuid "8332446a-894a-5efa-b549-105c9d96f0bf" :answer/type :answer.type/image :answer/value "images/d0/d060084a75147a69ffd6a74da31bfad2f9ad807dedddb5ee3b8fc20993432f9c.png" :db/ensure [:answer/validate]} {:db/id "answer-4c2467c5-2c2d-5b5d-bc2b-28eb5cd0d0ad" :answer/id #uuid "4c2467c5-2c2d-5b5d-bc2b-28eb5cd0d0ad" :answer/type :answer.type/image :answer/value "images/ef/ef27d204f39550af6a529640dd3e3c24f13dcd7c7d9631c5fd6d2a6d1e47ebcf.png" :db/ensure [:answer/validate]} {:db/id 17592186179766 :knowledge-point/questions ["question-c7c0eb25-897e-5093-b34f-0455f3db55f9" "question-310694c7-b1be-5cf8-b20f-09c0a8e64636"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c7c0eb25-897e-5093-b34f-0455f3db55f9" :question/id #uuid "c7c0eb25-897e-5093-b34f-0455f3db55f9" :question/math-academy-id "q-162615" :question/problem "Which of the following vector fields have a stream function?\n\nI. $F(x,y)=({y}^{3}-3{x}^{2}y)\\,i+({x}^{3}+3x{y}^{2})\\,j$\n\nII. $F(x,y)=2x\\,i+4{y}^{4}\\,j$\n\nIII. $F(x,y)=(x+y)\\,i-3y\\,j$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field I has a stream function. Indeed, the partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=-6xy,\\,\\frac{∂Q}{∂y} & =6xy.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=(-6xy)+6xy=0\n$$\n\n- Vector field II doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2,\\,\\frac{∂Q}{∂y} & =16{y}^{3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2+16{y}^{3}\\ne 0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =-3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=1+(-3)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0cb50c3b-df4c-5b33-bad4-52581805f032"] :db/ensure [:question/validate]} {:db/id "answer-field-0cb50c3b-df4c-5b33-bad4-52581805f032" :answer-field/id #uuid "0cb50c3b-df4c-5b33-bad4-52581805f032" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d03c985-35da-5986-ad82-1850226331bc" :answer-field/choices ["answer-2d390a46-6a6d-580f-aedb-aa1ff6dfc987" "answer-2d03c985-35da-5986-ad82-1850226331bc" "answer-82a30966-fd2e-5ead-9908-43144c65211f" "answer-50ac5137-180c-55d6-9f11-2a2575b2db27" "answer-c5c1e3bd-329c-592b-a22f-764ef4182668"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d390a46-6a6d-580f-aedb-aa1ff6dfc987" :answer/id #uuid "2d390a46-6a6d-580f-aedb-aa1ff6dfc987" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-2d03c985-35da-5986-ad82-1850226331bc" :answer/id #uuid "2d03c985-35da-5986-ad82-1850226331bc" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-82a30966-fd2e-5ead-9908-43144c65211f" :answer/id #uuid "82a30966-fd2e-5ead-9908-43144c65211f" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-50ac5137-180c-55d6-9f11-2a2575b2db27" :answer/id #uuid "50ac5137-180c-55d6-9f11-2a2575b2db27" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c5c1e3bd-329c-592b-a22f-764ef4182668" :answer/id #uuid "c5c1e3bd-329c-592b-a22f-764ef4182668" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-8e84ccf0-2025-55a1-91ce-ccafeeadc53e" :question/id #uuid "8e84ccf0-2025-55a1-91ce-ccafeeadc53e" :question/math-academy-id "q-162621" :question/problem "Which of the following represents the streamlines of the vector field $F(x,y)=(x-1)i-y\\,j$ over the domain $D={R}^{2}.$" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that \n\n$$\nF(x,y)=(x-1)i-y\\,j\n$$\n\n is a vector field with simply connected domain $D,$ where $P(x,y)=x-1$ and $Q(x,y)=-y.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=1,\\,\\frac{∂Q}{∂y} & =-1.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=1-1=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}=x-1,\\,\\frac{∂ψ}{∂x}=y.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)=xy-y+f(x),\\,ψ(x,y)=xy+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f(x)=0$ or $g(y)=-y,$ we have\n\n$$\nψ(x,y)=xy-y.\n$$\n\nFinally, we find the level curves of the stream function $ψ(x,y)=xy-y$ given by the equations $ψ(x,y)=c.$\n\nNotice that the range of $ψ(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$ So, we have:\n\n$$\n\\begin{aligned}ψ(x,y) & =c \\\\ xy-y & =c \\\\ y(x-1) & =c \\\\ y & =\\frac{c}{x-1}\\end{aligned}\n$$\n\nThe equation above gives us a family of hyperbolas with asymptotes $y=0$ and $x=1$ and, for $c=0,$ the lines $y=0$ and $x=1.$ Therefore, the correct graph (along with the vector field $F$) is as follows:\n\n![](images/dc/dcf779041bbae1ce0a6c89042277b4dc33bb1eabe16d42a7824945a118951e0b.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fbb9fdb9-29b3-51cf-8b8d-3e71313f6843"] :db/ensure [:question/validate]} {:db/id "answer-field-fbb9fdb9-29b3-51cf-8b8d-3e71313f6843" :answer-field/id #uuid "fbb9fdb9-29b3-51cf-8b8d-3e71313f6843" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2eccd188-ea83-597f-abf8-03ad9133061a" :answer-field/choices ["answer-9eedb55c-c4b8-5b99-a700-dafb5e8a0479" "answer-b0d994a1-a196-5c00-a356-dbb042053b6d" "answer-675416c8-3285-5ede-b099-55462b554c3d" "answer-2eccd188-ea83-597f-abf8-03ad9133061a" "answer-57f76c7f-ba08-5d98-870b-229dd3bdfcca"] :db/ensure [:answer-field/validate]} {:db/id "answer-9eedb55c-c4b8-5b99-a700-dafb5e8a0479" :answer/id #uuid "9eedb55c-c4b8-5b99-a700-dafb5e8a0479" :answer/type :answer.type/image :answer/value "images/2a/2a4e9e152f2da6d5b254cc6f3eb6f6c6d71dcf96e139116753587f7663d39b2f.png" :db/ensure [:answer/validate]} {:db/id "answer-b0d994a1-a196-5c00-a356-dbb042053b6d" :answer/id #uuid "b0d994a1-a196-5c00-a356-dbb042053b6d" :answer/type :answer.type/image :answer/value "images/97/9708321a993fcee685037db3ff120203d00a0c62892cf3712139e9afaa0426fd.png" :db/ensure [:answer/validate]} {:db/id "answer-675416c8-3285-5ede-b099-55462b554c3d" :answer/id #uuid "675416c8-3285-5ede-b099-55462b554c3d" :answer/type :answer.type/image :answer/value "images/a2/a2fd8b46cf90aa751bfbd5f6c39257b8097a4898a5f5807bf5876a462d925fb2.png" :db/ensure [:answer/validate]} {:db/id "answer-2eccd188-ea83-597f-abf8-03ad9133061a" :answer/id #uuid "2eccd188-ea83-597f-abf8-03ad9133061a" :answer/type :answer.type/image :answer/value "images/b8/b83a05a3fd79bf42ef45a16565194bf104214647a06144641e9b7bd66613ffaf.png" :db/ensure [:answer/validate]} {:db/id "answer-57f76c7f-ba08-5d98-870b-229dd3bdfcca" :answer/id #uuid "57f76c7f-ba08-5d98-870b-229dd3bdfcca" :answer/type :answer.type/image :answer/value "images/f4/f4ad2cbbaccce4edae6e7e4901c6269a91aae1b364beba9b8bcc419d8e32c0e5.png" :db/ensure [:answer/validate]} {:db/id "question-310694c7-b1be-5cf8-b20f-09c0a8e64636" :question/id #uuid "310694c7-b1be-5cf8-b20f-09c0a8e64636" :question/math-academy-id "q-162638" :question/problem "Which of the following vector fields have a stream function?\n\nI. $F(x,y)=\\operatorname{sinh}⁡x\\operatorname{cos}⁡y\\,i-\\operatorname{cosh}⁡x\\operatorname{sin}⁡y\\,j$\n\nII. $F(x,y)=x\\operatorname{cos}⁡y\\,i+y\\operatorname{sin}⁡x\\,j$\n\nIII. $F(x,y)=({x}^{2}+4y)\\,i-(2{x}^{2}{y}^{2}+y)\\,j$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nWith that in mind, let's consider each vector field.\n\n- Vector field does have a stream function. Indeed, the partial derivatives are given by:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=\\operatorname{cosh}⁡x\\operatorname{cos}⁡y,\\,\\frac{∂Q}{∂y} & =-\\operatorname{cosh}⁡x\\operatorname{cos}⁡y.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=\\operatorname{cosh}⁡x\\operatorname{cos}⁡y+(-\\operatorname{cosh}⁡x\\operatorname{cos}⁡y)=0.\n$$\n\n- Vector field II doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=\\operatorname{cos}⁡y,\\,\\frac{∂Q}{∂y} & =\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=\\operatorname{cos}⁡y+\\operatorname{sin}⁡x\\ne 0.\n$$\n\n- Vector field III doesn't have a stream function. The partial derivatives are given by\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x,\\,\\frac{∂Q}{∂y} & =-4{x}^{2}y-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2x-(4{x}^{2}y+1)\\ne 0.\n$$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-000a0f4a-ae7b-5f51-a759-311c42f36adf"] :db/ensure [:question/validate]} {:db/id "answer-field-000a0f4a-ae7b-5f51-a759-311c42f36adf" :answer-field/id #uuid "000a0f4a-ae7b-5f51-a759-311c42f36adf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d3d04b97-b925-5d6c-8da1-814296c0c804" :answer-field/choices ["answer-d3d04b97-b925-5d6c-8da1-814296c0c804" "answer-83dea68e-c1c5-56fd-83b2-641ed6509139" "answer-7b6b43ea-6957-5564-abd5-fa3a9b69baee" "answer-d1084bbd-c9b1-5b9e-aba8-ccbe75dad070" "answer-4d194298-7b9f-5375-a63e-abe0fd00183b"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3d04b97-b925-5d6c-8da1-814296c0c804" :answer/id #uuid "d3d04b97-b925-5d6c-8da1-814296c0c804" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-83dea68e-c1c5-56fd-83b2-641ed6509139" :answer/id #uuid "83dea68e-c1c5-56fd-83b2-641ed6509139" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-7b6b43ea-6957-5564-abd5-fa3a9b69baee" :answer/id #uuid "7b6b43ea-6957-5564-abd5-fa3a9b69baee" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-d1084bbd-c9b1-5b9e-aba8-ccbe75dad070" :answer/id #uuid "d1084bbd-c9b1-5b9e-aba8-ccbe75dad070" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-4d194298-7b9f-5375-a63e-abe0fd00183b" :answer/id #uuid "4d194298-7b9f-5375-a63e-abe0fd00183b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-3e0c32a3-e400-5e80-92e0-610abde1479e" :activity/id #uuid "3e0c32a3-e400-5e80-92e0-610abde1479e" :activity/title "Stream Functions" :activity/type :activity.type/review :activity/scope 17592186049617 :activity/course 17592186046659 :activity/steps ["step-b9e6b2cd-32af-5db6-aad9-b1a728102b9b" "step-65923646-0a7d-5ade-9535-52fba8e7f6b1" "step-e363175b-25ee-538d-8a8a-ba6522f9725a" "step-794a8d11-192c-55a5-a0c6-593db9195676" "step-374bcc7d-ec2b-5e61-9b8f-f3e9cc285dcd"] :activity/first-step "step-b9e6b2cd-32af-5db6-aad9-b1a728102b9b" :db/ensure [:activity/validate]} {:db/id "step-b9e6b2cd-32af-5db6-aad9-b1a728102b9b" :step/id #uuid "b9e6b2cd-32af-5db6-aad9-b1a728102b9b" :step/content "question-8662a311-148d-52aa-9581-67da3a804b43" :step/next "step-65923646-0a7d-5ade-9535-52fba8e7f6b1" :db/ensure [:step/validate]} {:db/id "step-65923646-0a7d-5ade-9535-52fba8e7f6b1" :step/id #uuid "65923646-0a7d-5ade-9535-52fba8e7f6b1" :step/content "question-faed1d58-d701-5e29-bb64-3a9beae53a8b" :step/next "step-e363175b-25ee-538d-8a8a-ba6522f9725a" :db/ensure [:step/validate]} {:db/id "step-e363175b-25ee-538d-8a8a-ba6522f9725a" :step/id #uuid "e363175b-25ee-538d-8a8a-ba6522f9725a" :step/content "question-c7c0eb25-897e-5093-b34f-0455f3db55f9" :step/next "step-794a8d11-192c-55a5-a0c6-593db9195676" :db/ensure [:step/validate]} {:db/id "step-794a8d11-192c-55a5-a0c6-593db9195676" :step/id #uuid "794a8d11-192c-55a5-a0c6-593db9195676" :step/content "question-8e84ccf0-2025-55a1-91ce-ccafeeadc53e" :step/next "step-374bcc7d-ec2b-5e61-9b8f-f3e9cc285dcd" :db/ensure [:step/validate]} {:db/id "step-374bcc7d-ec2b-5e61-9b8f-f3e9cc285dcd" :step/id #uuid "374bcc7d-ec2b-5e61-9