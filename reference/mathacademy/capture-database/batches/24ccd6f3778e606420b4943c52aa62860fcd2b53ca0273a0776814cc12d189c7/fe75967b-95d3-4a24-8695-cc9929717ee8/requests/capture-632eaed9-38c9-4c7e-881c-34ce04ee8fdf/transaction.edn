sech}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-d88b228f-0bb7-5bcc-ba0a-47bf3064e252" :answer/id #uuid "d88b228f-0bb7-5bcc-ba0a-47bf3064e252" :answer/type :answer.type/math :answer/value "\\operatorname{coth}⁡x(\\operatorname{csch}⁡x-3\\operatorname{coth}⁡x)" :db/ensure [:answer/validate]} {:db/id "answer-4ab17e12-16fb-560a-9043-5efb3ec8c7c7" :answer/id #uuid "4ab17e12-16fb-560a-9043-5efb3ec8c7c7" :answer/type :answer.type/math :answer/value "\\operatorname{csch}⁡x(3\\operatorname{csch}⁡x+\\operatorname{coth}⁡x)" :db/ensure [:answer/validate]} {:db/id "answer-9e902e56-a500-5a45-80bd-107225b4bc77" :answer/id #uuid "9e902e56-a500-5a45-80bd-107225b4bc77" :answer/type :answer.type/math :answer/value "\\operatorname{csch}⁡x(\\operatorname{csch}⁡x-3\\operatorname{coth}⁡x)" :db/ensure [:answer/validate]} {:db/id "answer-0c174169-aa47-5034-8eb6-f7f3f6a67204" :answer/id #uuid "0c174169-aa47-5034-8eb6-f7f3f6a67204" :answer/type :answer.type/math :answer/value "\\operatorname{csch}⁡x\\operatorname{coth}⁡x+3{csch}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id 17592186167368 :question/problem "$$\n\nFind the derivative of $y=\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x.$" :question/worked-solution "First, we recall the results for the derivatives of the basic reciprocal hyperbolic functions:\n\n$$\n(\\operatorname{sech}⁡x)^{′}=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x,\\,(\\operatorname{csch}⁡x)^{′}=-\\operatorname{csch}⁡x\\operatorname{coth}⁡x,\\,(\\operatorname{coth}⁡x)^{′}=-{csch}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x-2\\operatorname{csch}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{csch}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2(-\\operatorname{csch}⁡x\\operatorname{coth}⁡x) \\\\  & =-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165416 :answer-field/correct "answer-73ac46a2-08ba-5ab9-a955-921da4e67be0" :answer-field/choices ["answer-73ac46a2-08ba-5ab9-a955-921da4e67be0" "answer-1a0450e8-6fb9-5c06-a492-b2d7b234798f" "answer-43babeff-1414-59a6-a743-e2ee441fdb19" "answer-6d949e4f-b4ed-5bc7-9540-4068520fb9fc" "answer-fbf636ca-0581-5e6c-b5fd-6de80891eeb2"] :db/ensure [:answer-field/validate]} {:db/id "answer-73ac46a2-08ba-5ab9-a955-921da4e67be0" :answer/id #uuid "73ac46a2-08ba-5ab9-a955-921da4e67be0" :answer/type :answer.type/math :answer/value "-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x\\operatorname{coth}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-1a0450e8-6fb9-5c06-a492-b2d7b234798f" :answer/id #uuid "1a0450e8-6fb9-5c06-a492-b2d7b234798f" :answer/type :answer.type/math :answer/value "-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x+2{csch}^{2}⁡x\\operatorname{coth}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-43babeff-1414-59a6-a743-e2ee441fdb19" :answer/id #uuid "43babeff-1414-59a6-a743-e2ee441fdb19" :answer/type :answer.type/math :answer/value "\\operatorname{sech}⁡x(-\\operatorname{tanh}⁡x-2\\operatorname{sech}⁡x)" :db/ensure [:answer/validate]} {:db/id "answer-6d949e4f-b4ed-5bc7-9540-4068520fb9fc" :answer/id #uuid "6d949e4f-b4ed-5bc7-9540-4068520fb9fc" :answer/type :answer.type/math :answer/value "\\operatorname{sech}⁡x(\\operatorname{tanh}⁡x+2\\operatorname{csch}⁡x)" :db/ensure [:answer/validate]} {:db/id "answer-fbf636ca-0581-5e6c-b5fd-6de80891eeb2" :answer/id #uuid "fbf636ca-0581-5e6c-b5fd-6de80891eeb2" :answer/type :answer.type/math :answer/value "\\operatorname{sech}⁡x\\operatorname{tanh}⁡x-2{csch}^{2}⁡x\\operatorname{coth}⁡x" :db/ensure [:answer/validate]} {:db/id "question-6703e5b6-66a0-5cda-938a-ed7160c9206e" :question/id #uuid "6703e5b6-66a0-5cda-938a-ed7160c9206e" :question/math-academy-id "q-95568" :question/problem "$$\n\nFind the derivative of $f(x)=4\\operatorname{sech}⁡3x.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=4\\operatorname{sech}⁡g,\\,g=3x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=-4\\operatorname{sech}⁡g\\operatorname{tanh}⁡g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=3.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-4\\operatorname{sech}⁡g\\operatorname{tanh}⁡g\\cdot 3 \\\\  & =-12\\operatorname{sech}⁡g\\operatorname{tanh}⁡g \\\\  & =-12\\operatorname{sech}⁡3x\\operatorname{tanh}⁡3x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a9230a28-06b0-581f-81e1-12ba5c6ce005"] :db/ensure [:question/validate]} {:db/id "answer-field-a9230a28-06b0-581f-81e1-12ba5c6ce005" :answer-field/id #uuid "a9230a28-06b0-581f-81e1-12ba5c6ce005" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-20318a3b-cddf-5f49-a770-aa54022d9211" :answer-field/choices ["answer-20318a3b-cddf-5f49-a770-aa54022d9211" "answer-93151f0c-21d4-5e36-9952-db632486e2a8" "answer-fdd64067-8043-5950-a2a1-3a7b7fdce288" "answer-2ba9842f-6d92-5b98-9e66-644e6c2d1a4a" "answer-01b6c708-c1e5-5ee0-b136-0843073b4ec1"] :db/ensure [:answer-field/validate]} {:db/id "answer-20318a3b-cddf-5f49-a770-aa54022d9211" :answer/id #uuid "20318a3b-cddf-5f49-a770-aa54022d9211" :answer/type :answer.type/math :answer/value "-12\\operatorname{sech}⁡3x\\operatorname{tanh}⁡3x" :db/ensure [:answer/validate]} {:db/id "answer-93151f0c-21d4-5e36-9952-db632486e2a8" :answer/id #uuid "93151f0c-21d4-5e36-9952-db632486e2a8" :answer/type :answer.type/math :answer/value "-12{tanh}^{2}⁡3x" :db/ensure [:answer/validate]} {:db/id "answer-fdd64067-8043-5950-a2a1-3a7b7fdce288" :answer/id #uuid "fdd64067-8043-5950-a2a1-3a7b7fdce288" :answer/type :answer.type/math :answer/value "-4{csch}^{2}⁡3x" :db/ensure [:answer/validate]} {:db/id "answer-2ba9842f-6d92-5b98-9e66-644e6c2d1a4a" :answer/id #uuid "2ba9842f-6d92-5b98-9e66-644e6c2d1a4a" :answer/type :answer.type/math :answer/value "12\\operatorname{csch}⁡3x\\operatorname{tanh}⁡3x" :db/ensure [:answer/validate]} {:db/id "answer-01b6c708-c1e5-5ee0-b136-0843073b4ec1" :answer/id #uuid "01b6c708-c1e5-5ee0-b136-0843073b4ec1" :answer/type :answer.type/math :answer/value "8\\operatorname{sech}⁡3x\\operatorname{tanh}⁡3x" :db/ensure [:answer/validate]} {:db/id "question-51513d5e-ca42-5754-a902-1af12bc25041" :question/id #uuid "51513d5e-ca42-5754-a902-1af12bc25041" :question/math-academy-id "q-95569" :question/problem "$$\n\nFind the derivative of $f(x)=-\\operatorname{csch}⁡{x}^{2}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=-\\operatorname{csch}⁡g,\\,g={x}^{2}\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=\\operatorname{csch}⁡g\\operatorname{coth}⁡g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\operatorname{csch}⁡g\\operatorname{coth}⁡g\\cdot 2x \\\\  & =2x\\operatorname{csch}⁡g\\operatorname{coth}⁡g \\\\  & =2x\\operatorname{csch}⁡{x}^{2}\\operatorname{coth}⁡{x}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a73eab0e-5052-533a-9a91-63a4d2681994"] :db/ensure [:question/validate]} {:db/id "answer-field-a73eab0e-5052-533a-9a91-63a4d2681994" :answer-field/id #uuid "a73eab0e-5052-533a-9a91-63a4d2681994" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-58eb1a2f-da58-55f3-8568-74f50a7918a0" :answer-field/choices ["answer-adc65e90-ae5d-5e28-b418-5de7054b3a31" "answer-58eb1a2f-da58-55f3-8568-74f50a7918a0" "answer-e88cd52a-ff88-5f62-99a9-073b12b25a57" "answer-9f37f12b-a6ff-5b18-8085-e0b9d1178fa0" "answer-81b12827-b2c6-5675-8386-55a92b9f0a33"] :db/ensure [:answer-field/validate]} {:db/id "answer-adc65e90-ae5d-5e28-b418-5de7054b3a31" :answer/id #uuid "adc65e90-ae5d-5e28-b418-5de7054b3a31" :answer/type :answer.type/math :answer/value "-2x\\operatorname{sech}⁡{x}^{2}\\operatorname{coth}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-58eb1a2f-da58-55f3-8568-74f50a7918a0" :answer/id #uuid "58eb1a2f-da58-55f3-8568-74f50a7918a0" :answer/type :answer.type/math :answer/value "2x\\operatorname{csch}⁡{x}^{2}\\operatorname{coth}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e88cd52a-ff88-5f62-99a9-073b12b25a57" :answer/id #uuid "e88cd52a-ff88-5f62-99a9-073b12b25a57" :answer/type :answer.type/math :answer/value "2x{coth}^{2}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-9f37f12b-a6ff-5b18-8085-e0b9d1178fa0" :answer/id #uuid "9f37f12b-a6ff-5b18-8085-e0b9d1178fa0" :answer/type :answer.type/math :answer/value "\\operatorname{csch}⁡2x\\operatorname{coth}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-81b12827-b2c6-5675-8386-55a92b9f0a33" :answer/id #uuid "81b12827-b2c6-5675-8386-55a92b9f0a33" :answer/type :answer.type/math :answer/value "{x}^{2}\\operatorname{csch}⁡{x}^{2}\\operatorname{coth}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "question-b9b1e144-f837-55bf-a0c3-8113231511af" :question/id #uuid "b9b1e144-f837-55bf-a0c3-8113231511af" :question/math-academy-id "q-95577" :question/problem "$$\n\nFind the derivative of $f(x)=2{sech}^{2}⁡x.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=2{g}^{2},\\,g=\\operatorname{sech}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=4g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =4g(-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x) \\\\  & =4(\\operatorname{sech}⁡x)(-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x) \\\\  & =-4{sech}^{2}⁡x\\operatorname{tanh}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-33fef8da-1fed-575c-b52c-5735f185e8df"] :db/ensure [:question/validate]} {:db/id "answer-field-33fef8da-1fed-575c-b52c-5735f185e8df" :answer-field/id #uuid "33fef8da-1fed-575c-b52c-5735f185e8df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8b54fd43-f7d2-592e-902d-5621425e00b2" :answer-field/choices ["answer-78513305-089d-5926-bd36-dc21c4328d46" "answer-8b54fd43-f7d2-592e-902d-5621425e00b2" "answer-e944c330-fa87-5fb5-b030-527351a8f08a" "answer-61276995-74bd-5344-aa45-015217ab0d57" "answer-6bd2715d-56f1-531c-9661-a9c48c9057cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-78513305-089d-5926-bd36-dc21c4328d46" :answer/id #uuid "78513305-089d-5926-bd36-dc21c4328d46" :answer/type :answer.type/math :answer/value "-2\\operatorname{sech}⁡x{tanh}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-8b54fd43-f7d2-592e-902d-5621425e00b2" :answer/id #uuid "8b54fd43-f7d2-592e-902d-5621425e00b2" :answer/type :answer.type/math :answer/value "-4{sech}^{2}⁡x\\operatorname{tanh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-e944c330-fa87-5fb5-b030-527351a8f08a" :answer/id #uuid "e944c330-fa87-5fb5-b030-527351a8f08a" :answer/type :answer.type/math :answer/value "2\\operatorname{sech}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-61276995-74bd-5344-aa45-015217ab0d57" :answer/id #uuid "61276995-74bd-5344-aa45-015217ab0d57" :answer/type :answer.type/math :answer/value "4\\operatorname{sech}⁡x\\operatorname{tanh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-6bd2715d-56f1-531c-9661-a9c48c9057cf" :answer/id #uuid "6bd2715d-56f1-531c-9661-a9c48c9057cf" :answer/type :answer.type/math :answer/value "4\\operatorname{sech}⁡x{tanh}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "question-6866b59d-bbba-56df-8e9c-26cc543fc023" :question/id #uuid "6866b59d-bbba-56df-8e9c-26cc543fc023" :question/math-academy-id "q-95566" :question/problem "$$\n\nFind the derivative of $f(x)=-2\\operatorname{csch}⁡(1-4x).$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=-2\\operatorname{csch}⁡g,\\,g=1-4x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=2\\operatorname{csch}⁡g\\operatorname{coth}⁡g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=-4.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2\\operatorname{csch}⁡g\\operatorname{coth}⁡g\\cdot (-4) \\\\  & =-8\\operatorname{csch}⁡g\\operatorname{coth}⁡g \\\\  & =-8\\operatorname{csch}⁡(1-4x)\\operatorname{coth}⁡(1-4x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-49f4380a-e4c2-512c-bf58-08136b8a4df3"] :db/ensure [:question/validate]} {:db/id "answer-field-49f4380a-e4c2-512c-bf58-08136b8a4df3" :answer-field/id #uuid "49f4380a-e4c2-512c-bf58-08136b8a4df3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-000ac2db-823f-5c0a-b07e-bb2931ec4a29" :answer-field/choices ["answer-fb8f51dd-25a7-51e7-9f0d-a86386cfddb2" "answer-000ac2db-823f-5c0a-b07e-bb2931ec4a29" "answer-0b9e21a4-7a29-56e5-b72e-0fdff889f662" "answer-d3a28112-e00d-5d59-939f-1f4609fb499d" "answer-bb7be486-4971-575d-b870-4310be3f5e35"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb8f51dd-25a7-51e7-9f0d-a86386cfddb2" :answer/id #uuid "fb8f51dd-25a7-51e7-9f0d-a86386cfddb2" :answer/type :answer.type/math :answer/value "-4\\operatorname{csch}⁡(1-4x)\\operatorname{tanh}⁡(1-4x)" :db/ensure [:answer/validate]} {:db/id "answer-000ac2db-823f-5c0a-b07e-bb2931ec4a29" :answer/id #uuid "000ac2db-823f-5c0a-b07e-bb2931ec4a29" :answer/type :answer.type/math :answer/value "-8\\operatorname{csch}⁡(1-4x)\\operatorname{coth}⁡(1-4x)" :db/ensure [:answer/validate]} {:db/id "answer-0b9e21a4-7a29-56e5-b72e-0fdff889f662" :answer/id #uuid "0b9e21a4-7a29-56e5-b72e-0fdff889f662" :answer/type :answer.type/math :answer/value "-8\\operatorname{sech}⁡(1-4x)\\operatorname{coth}⁡(1-4x)" :db/ensure [:answer/validate]} {:db/id "answer-d3a28112-e00d-5d59-939f-1f4609fb499d" :answer/id #uuid "d3a28112-e00d-5d59-939f-1f4609fb499d" :answer/type :answer.type/math :answer/value "2\\operatorname{csch}⁡(1-4x)\\operatorname{coth}⁡(1-4x)" :db/ensure [:answer/validate]} {:db/id "answer-bb7be486-4971-575d-b870-4310be3f5e35" :answer/id #uuid "bb7be486-4971-575d-b870-4310be3f5e35" :answer/type :answer.type/math :answer/value "4\\operatorname{sech}⁡(1-4x)\\operatorname{coth}⁡(1-4x)" :db/ensure [:answer/validate]} {:db/id "question-76beb3b0-dbd8-5192-b70b-0a4bac401337" :question/id #uuid "76beb3b0-dbd8-5192-b70b-0a4bac401337" :question/math-academy-id "q-95570" :question/problem "$$\n\nFind the derivative of $f(x)=\\operatorname{coth}⁡({x}^{2}-1).$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=\\operatorname{coth}⁡g,\\,g={x}^{2}-1\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=-{csch}^{2}⁡g,\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=2x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-{csch}^{2}⁡g\\cdot 2x \\\\  & =-2x{csch}^{2}⁡g \\\\  & =-2x{csch}^{2}⁡({x}^{2}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fdada9a0-319d-50fa-a0c4-8211688157c0"] :db/ensure [:question/validate]} {:db/id "answer-field-fdada9a0-319d-50fa-a0c4-8211688157c0" :answer-field/id #uuid "fdada9a0-319d-50fa-a0c4-8211688157c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c853cba8-3165-56c6-a436-2b32f112bafb" :answer-field/choices ["answer-e6496d12-4f39-58a0-bc57-cd3eaaeb3ece" "answer-c853cba8-3165-56c6-a436-2b32f112bafb" "answer-d5214c15-24d4-5045-a3fa-cdf23f818462" "answer-c2870e74-3428-5720-b294-4aedf55aa1a2" "answer-4e61680f-34d0-54c9-a581-fc46337f2489"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6496d12-4f39-58a0-bc57-cd3eaaeb3ece" :answer/id #uuid "e6496d12-4f39-58a0-bc57-cd3eaaeb3ece" :answer/type :answer.type/math :answer/value "-2x\\operatorname{csch}⁡({x}^{2}-1)\\operatorname{coth}⁡({x}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-c853cba8-3165-56c6-a436-2b32f112bafb" :answer/id #uuid "c853cba8-3165-56c6-a436-2b32f112bafb" :answer/type :answer.type/math :answer/value "-2x{csch}^{2}⁡({x}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-d5214c15-24d4-5045-a3fa-cdf23f818462" :answer/id #uuid "d5214c15-24d4-5045-a3fa-cdf23f818462" :answer/type :answer.type/math :answer/value "-x{csch}^{2}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-c2870e74-3428-5720-b294-4aedf55aa1a2" :answer/id #uuid "c2870e74-3428-5720-b294-4aedf55aa1a2" :answer/type :answer.type/math :answer/value "-{x}^{3}{csch}^{2}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-4e61680f-34d0-54c9-a581-fc46337f2489" :answer/id #uuid "4e61680f-34d0-54c9-a581-fc46337f2489" :answer/type :answer.type/math :answer/value "2x{sech}^{2}⁡({x}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "question-05fabaa5-d0f1-544a-aecb-26138b15f8e2" :question/id #uuid "05fabaa5-d0f1-544a-aecb-26138b15f8e2" :question/math-academy-id "q-95580" :question/problem "$$\n\nIf $f(x)={x}^{2}\\operatorname{csch}⁡4x,$ then ${f}^{′}(x)=2x\\operatorname{csch}⁡4x\\cdot g(x).$ What is $g(x)?$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}$ and $v(x)=\\operatorname{csch}⁡4x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2})}^{′}\\cdot \\operatorname{csch}⁡4x+{x}^{2}\\cdot {(\\operatorname{csch}⁡4x)}^{′} \\\\  & =2x\\cdot \\operatorname{csch}⁡4x+{x}^{2}\\cdot (-4\\operatorname{csch}⁡4x\\operatorname{coth}⁡4x) \\\\  & =2x\\operatorname{csch}⁡4x-4{x}^{2}\\operatorname{csch}⁡4x\\operatorname{coth}⁡4x \\\\  & =2x\\operatorname{csch}⁡4x\\cdot {{(1-2x\\operatorname{coth}⁡4x)}_{⏟}}_{g(x)}\\end{aligned}\n$$\n\nTherefore, $g(x)=1-2x\\operatorname{coth}⁡4x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1f3fe267-45dc-5a4c-8818-eeaf17174ee4"] :db/ensure [:question/validate]} {:db/id "answer-field-1f3fe267-45dc-5a4c-8818-eeaf17174ee4" :answer-field/id #uuid "1f3fe267-45dc-5a4c-8818-eeaf17174ee4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-43fa1256-5bed-59ec-868b-cad71abb11e4" :answer-field/choices ["answer-b9aedc43-fe07-5c3a-8a28-1ba22a9c08b2" "answer-43fa1256-5bed-59ec-868b-cad71abb11e4" "answer-197fd5ad-27fa-5f37-82bd-6030ed45adaf" "answer-0d162b6f-3bb5-573d-9a18-2c860b4368a4" "answer-85b20bf6-ba1e-536c-9760-343ba5f356c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9aedc43-fe07-5c3a-8a28-1ba22a9c08b2" :answer/id #uuid "b9aedc43-fe07-5c3a-8a28-1ba22a9c08b2" :answer/type :answer.type/math :answer/value "1+x\\operatorname{coth}⁡4x" :db/ensure [:answer/validate]} {:db/id "answer-43fa1256-5bed-59ec-868b-cad71abb11e4" :answer/id #uui