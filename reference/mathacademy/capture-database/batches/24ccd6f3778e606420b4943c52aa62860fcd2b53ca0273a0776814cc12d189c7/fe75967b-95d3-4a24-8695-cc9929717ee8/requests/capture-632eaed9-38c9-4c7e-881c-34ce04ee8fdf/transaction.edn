merator and denominator by the conjugate $\\sqrt{7}+\\sqrt{3},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{6}{\\sqrt{7}-\\sqrt{3}} & = \\\\ \\frac{6}{\\sqrt{7}-\\sqrt{3}}\\cdot \\frac{\\sqrt{7}+\\sqrt{3}}{\\sqrt{7}+\\sqrt{3}} & = \\\\ \\frac{6(\\sqrt{7}+\\sqrt{3})}{(\\sqrt{7}-\\sqrt{3})(\\sqrt{7}+\\sqrt{3})} & = \\\\ \\text{ }\\frac{6(\\sqrt{7}+\\sqrt{3})}{(\\sqrt{7})^{2}-(\\sqrt{3})^{2}} & = \\\\ \\frac{6(\\sqrt{7}+\\sqrt{3})}{7-3} & = \\\\ \\frac{6(\\sqrt{7}+\\sqrt{3})}{4} & = \\\\ \\frac{3(\\sqrt{7}+\\sqrt{3})}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5beded78-a8f2-554e-a6f6-30e70f9c3c8c"] :db/ensure [:question/validate]} {:db/id "answer-field-5beded78-a8f2-554e-a6f6-30e70f9c3c8c" :answer-field/id #uuid "5beded78-a8f2-554e-a6f6-30e70f9c3c8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72687189-2904-5415-8f68-a2005ded6f1b" :answer-field/choices ["answer-42a587ea-a2dc-5010-8fc2-6b011658ec94" "answer-2da510ec-5b98-588f-928e-d5c8aad57cb5" "answer-d7bf0f95-1760-5f9f-8816-867c677a4f9a" "answer-72687189-2904-5415-8f68-a2005ded6f1b" "answer-14e9c5e7-56dd-5716-a24c-744b86fd4e7a"] :db/ensure [:answer-field/validate]} {:db/id "answer-42a587ea-a2dc-5010-8fc2-6b011658ec94" :answer/id #uuid "42a587ea-a2dc-5010-8fc2-6b011658ec94" :answer/type :answer.type/math :answer/value "2(\\sqrt{7}+\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "answer-2da510ec-5b98-588f-928e-d5c8aad57cb5" :answer/id #uuid "2da510ec-5b98-588f-928e-d5c8aad57cb5" :answer/type :answer.type/math :answer/value "3(\\sqrt{7}+\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "answer-d7bf0f95-1760-5f9f-8816-867c677a4f9a" :answer/id #uuid "d7bf0f95-1760-5f9f-8816-867c677a4f9a" :answer/type :answer.type/math :answer/value "\\frac{2(\\sqrt{7}+\\sqrt{3})}{3}" :db/ensure [:answer/validate]} {:db/id "answer-72687189-2904-5415-8f68-a2005ded6f1b" :answer/id #uuid "72687189-2904-5415-8f68-a200