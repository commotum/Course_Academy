0b648aa-d5d0-5faf-af78-d419c6aabd7f" "answer-8ecfa99c-b906-53f2-a081-af849a74bca6" "answer-1875ea73-f13c-57d4-a741-70e155a12822" "answer-ec29873a-f026-5265-a671-9e55b4a56120" "answer-2d6d74ab-d342-56fb-8ea0-9a4106caa0c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-20b648aa-d5d0-5faf-af78-d419c6aabd7f" :answer/id #uuid "20b648aa-d5d0-5faf-af78-d419c6aabd7f" :answer/type :answer.type/math :answer/value "9a" :db/ensure [:answer/validate]} {:db/id "answer-8ecfa99c-b906-53f2-a081-af849a74bca6" :answer/id #uuid "8ecfa99c-b906-53f2-a081-af849a74bca6" :answer/type :answer.type/math :answer/value "\\frac{9}{a}" :db/ensure [:answer/validate]} {:db/id "answer-1875ea73-f13c-57d4-a741-70e155a12822" :answer/id #uuid "1875ea73-f13c-57d4-a741-70e155a12822" :answer/type :answer.type/math :answer/value "a" :db/ensure [:answer/validate]} {:db/id "answer-ec29873a-f026-5265-a671-9e55b4a56120" :answer/id #uuid "ec29873a-f026-5265-a671-9e55b4a56120" :answer/type :answer.type/math :answer/value "a+9" :db/ensure [:answer/validate]} {:db/id "answer-2d6d74ab-d342-56fb-8ea0-9a4106caa0c6" :answer/id #uuid "2d6d74ab-d342-56fb-8ea0-9a4106caa0c6" :answer/type :answer.type/math :answer/value "a-9" :db/ensure [:answer/validate]} {:db/id 17592186054808 :knowledge-point/questions ["question-5fcefc3b-3a62-52cf-8d40-3f5f5111128b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5fcefc3b-3a62-52cf-8d40-3f5f5111128b" :question/id #uuid "5fcefc3b-3a62-52cf-8d40-3f5f5111128b" :question/math-academy-id "q-59573" :question/problem "Which of the following shows the point $C(4,-2)?$" :question/worked-solution "Starting at the origin, we move along the $x$ and $y$ axes to get to the point $C.$\n\nFirst, we move along the $x$-axis. The point $C$ has an $x$-coordinate of $4,$ so we move $4$ units to the *right*, in the positive direction of the $x$-axis.\n\nThen, we move along the $y$-axis. The point $C$ has a $y$-coordinate of $-2,$ so we move $2$ units *down*, in the negative direction of the $y$-axis.\n\n![](images/68/68f55dd9851c7fa3805dec284aad2a9eb7e07b77a94a3f6b4b9b8ddcfd630baf.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7aa45b8e-9c33-5004-99f5-78ff433678de"] :db/ensure [:question/validate]} {:db/id "answer-field-7aa45b8e-9c33-5004-99f5-78ff433678de" :answer-field/id #uuid "7aa45b8e-9c33-5004-99f5-78ff433678de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b929ed83-d50d-5862-b6bc-725ac667dc63" :answer-field/choices ["answer-bda3e1de-b475-5735-b969-15801c531d99" "answer-c51dc5bc-7e69-5880-bf7b-7f4360c6fde9" "answer-84dde297-f47c-5339-8e01-2e2bafa2de21" "answer-b929ed83-d50d-5862-b6bc-725ac667dc63" "answer-588ba6f3-14c9-59a5-b705-66f74d2ebf4b"] :db/ensure [:answer-field/validate]} {:db/id "answer-bda3e1de-b475-5735-b969-15801c531d99" :answer/id #uuid "bda3e1de-b475-5735-b969-15801c531d99" :answer/type :answer.type/image :answer/value "images/23/23aff8a750818ac3d61cc37abc7b83b0cacf8e969c55263307c77ba135526051.png" :db/ensure [:answer/validate]} {:db/id "answer-c51dc5bc-7e69-5880-bf7b-7f4360c6fde9" :answer/id #uuid "c51dc5bc-7e69-5880-bf7b-7f4360c6fde9" :answer/type :answer.type/image :answer/value "images/44/441b927cbf4fd4ea918ea0004751c636b475795fdd1e78aecf8fb7edc5b63a51.png" :db/ensure [:answer/validate]} {:db/id "answer-84dde297-f47c-5339-8e01-2e2bafa2de21" :answer/id #uuid "84dde297-f47c-5339-8e01-2e2bafa2de21" :answer/type :answer.type/image :answer/value "images/44/44488b8a200581f18875184e849c35d2c3995d6282b1af73914ade5bd64dba64.png" :db/ensure [:answer/validate]} {:db/id "answer-b929ed83-d50d-5862-b6bc-725ac667dc63" :answer/id #uuid "b929ed83-d50d-5862-b6bc-725ac667dc63" :answer/type :answer.type/image :answer/value "images/68/68f55dd9851c7fa3805dec284aad2a9eb7e07b77a94a3f6b4b9b8ddcfd630baf.png" :db/ensure [:answer/validate]} {:db/id "answer-588ba6f3-14c9-59a5-b705-66f74d2ebf4b" :answer/id #uuid "588ba6f3-14c9-59a5-b705-66f74d2ebf4b" :answer/type :answer.type/image :answer/value "images/e1/e1b3aaa4c958433b2dedd7bc9bef9f4327954f37f6ab4191251daaabc14e1ac2.png" :db/ensure [:answer/validate]} {:db/id 17592186152124 :knowledge-point/questions ["question-9f63b51c-dc94-5351-8801-eb6438eefe9b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9f63b51c-dc94-5351-8801-eb6438eefe9b" :question/id #uuid "9f63b51c-dc94-5351-8801-eb6438eefe9b" :question/math-academy-id "q-98372" :question/problem "Which of the following are natural numbers?\n\nI. $4$\n\nII. $-1$\n\nIII. $0$" :question/worked-solution "The natural numbers consist of all positive whole numbers.\n\n$$\n1,\\,2,\\,3,\\,4,\\,5,…\n$$\n\nOf the given numbers, $4$ is a natural number, but $-1$ and $0$ are not.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ce83d198-e8da-5698-936e-5f3c729fa5e3"] :db/ensure [:question/validate]} {:db/id "answer-field-ce83d198-e8da-5698-936e-5f3c729fa5e3" :answer-field/id #uuid "ce83d198-e8da-5698-936e-5f3c729fa5e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1daba185-8b77-5aec-aef0-5e19b2cbe869" :answer-field/choices ["answer-323103e8-cc86-5e4d-a7f3-f4b3fad56610" "answer-86d6d528-b089-5674-9ee6-21c3da5c9504" "answer-1daba185-8b77-5aec-aef0-5e19b2cbe869" "answer-c03e7d1f-d6a3-5a89-aba6-58d3bf03d60e" "answer-ab2fb77e-c67e-5fa6-b913-1652d2e05a5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-323103e8-cc86-5e4d-a7f3-f4b3fad56610" :answer/id #uuid "323103e8-cc86-5e4d-a7f3-f4b3fad56610" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-86d6d528-b089-5674-9ee6-21c3da5c9504" :answer/id #uuid "86d6d528-b089-5674-9ee6-21c3da5c9504" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-1daba185-8b77-5aec-aef0-5e19b2cbe869" :answer/id #uuid "1daba185-8b77-5aec-aef0-5e19b2cbe869" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-c03e7d1f-d6a3-5a89-aba6-58d3bf03d60e" :answer/id #uuid "c03e7d1f-d6a3-5a89-aba6-58d3bf03d60e" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-ab2fb77e-c67e-5fa6-b913-1652d2e05a5d" :answer/id #uuid "ab2fb77e-c67e-5fa6-b913-1652d2e05a5d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id 17592186064364 :knowledge-point/questions ["question-e4257f22-304f-5aae-a7d4-d381f535406f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e4257f22-304f-5aae-a7d4-d381f535406f" :question/id #uuid "e4257f22-304f-5aae-a7d4-d381f535406f" :question/math-academy-id "q-43032" :question/problem "$4\\cdot (-3.5)=$" :question/worked-solution "We have a product of a positive number $(4)$ and a negative number $(-3.5).$ So the product will be negative:\n\n$$\n4\\cdot (-3.5)=-\\boxed{}\n$$\n\nNow, to compute the number that goes in the box, we multiply $4$ by $3.5$ without any signs: $4\\cdot 3.5=14.$ So, we get\n\n$$\n4\\cdot (-3.5)=-14.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-30fab160-3791-5756-af82-eb9b85bfd673"] :db/ensure [:question/validate]} {:db/id "answer-field-30fab160-3791-5756-af82-eb9b85bfd673" :answer-field/id #uuid "30fab160-3791-5756-af82-eb9b85bfd673" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a5a3790b-50cd-59a8-b9ee-bc0773804594" :answer-field/choices ["answer-9ceaee27-6a87-5935-a239-9ab3c4ce482e" "answer-a5a3790b-50cd-59a8-b9ee-bc0773804594" "answer-9b12df53-fb74-533e-b0bd-f7a6b55abdd6" "answer-097f1ec8-cd7a-54e6-b09c-ad492b1b69d5" "answer-d0b39389-0b4f-557d-8541-f36e3d737e1d"] :db/ensure [:answer-field/validate]} {:db/id "answer-9ceaee27-6a87-5935-a239-9ab3c4ce482e" :answer/id #uuid "9ceaee27-6a87-5935-a239-9ab3c4ce482e" :ans