4d2-b40f-9e61dc190ae1" :step/content "question-e345f1f6-4e4b-57f5-a961-226088f10a38" :step/next "step-9791145a-39f3-503d-85e5-4249e43b05a5" :db/ensure [:step/validate]} {:db/id "step-9791145a-39f3-503d-85e5-4249e43b05a5" :step/id #uuid "9791145a-39f3-503d-85e5-4249e43b05a5" :step/content "question-2295df98-ce45-53e5-ab4e-ebfbd4881c7a" :db/ensure [:step/validate]} [:db/retract 17592186063851 :answer-field/choices 17592186063856] [:db/retract 17592186063851 :answer-field/choices 17592186063852] [:db/retract 17592186063851 :answer-field/choices 17592186063853] [:db/retract 17592186063851 :answer-field/choices 17592186063854] [:db/retract 17592186063851 :answer-field/choices 17592186063855] [:db/retract 17592186063881 :answer-field/choices 17592186063882] [:db/retract 17592186063881 :answer-field/choices 17592186063883] [:db/retract 17592186063881 :answer-field/choices 17592186063884] [:db/retract 17592186063881 :answer-field/choices 17592186063885] [:db/retract 17592186063881 :answer-field/choices 17592186063886] {:db/id 17592186064293 :knowledge-point/questions ["question-5680853a-d12c-5a26-9f72-c834e93e1139" "question-7995d4d6-c95b-5da1-93d8-010d3c638707"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064294 :knowledge-point/questions ["question-ffbc29d4-283f-5ef8-b5e9-fbf587b07a8e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064137 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\sech x) = -\\sech{x}\\tanh x \n\\quad\\Rightarrow\\quad  \n\\int \\sech{x}\\tanh{x} \\, \\textrm dx = -\\sech{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-3\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x & =-3\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =-3(-\\operatorname{sech}⁡x)+C \\\\  & =3\\operatorname{sech}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064295 :knowledge-point/questions ["question-0e3dc46b-f218-5db9-8dad-c903a297971f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064138 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\tanh x) = \\sech^2{x} \\quad\\Rightarrow\\quad  \\int \\sech^2{x} \\, \\textrm dx = \\tanh{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 6{sech}^{2}⁡x\\,\\text{d}x=6\\int {sech}^{2}⁡x\\,\\text{d}x=6\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064296 :knowledge-point/questions ["question-c8cdc03f-da95-544a-8d8d-7ede702d3109"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064139 :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\coth x) = -\\csch^2{x} \\quad\\Rightarrow\\quad  \\int \\csch^2{x} \\, \\textrm dx = -\\coth{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8{csch}^{2}⁡x)\\,\\text{d}x & =-8\\int {csch}^{2}⁡x\\,\\text{d}x \\\\  & =-(-8\\operatorname{coth}⁡x)+C \\\\  & =8\\operatorname{coth}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064966 :question/problem "$$\n\n$\\int 2\\operatorname{cosh}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x\\,⇒\\,\\int \\operatorname{cosh}⁡x\\,\\text{d}x=\\operatorname{sinh}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 2\\operatorname{cosh}⁡x\\,\\text{d}x & =2\\int \\operatorname{cosh}⁡x\\,\\text{d}x \\\\  & =2\\operatorname{sinh}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186063851 :answer-field/correct "answer-fc47d088-7fa9-5e9d-b775-a4836da902e8" :answer-field/choices ["answer-b868faa3-115c-5037-8c5f-5af78b26efc5" "answer-b4152a38-4c87-5f27-a424-8cf6b74504ae" "answer-b43a16d4-9dc6-5733-a699-04e2130521c0" "answer-fc47d088-7fa9-5e9d-b775-a4836da902e8" "answer-52b56404-c1f6-5cb4-bb91-10e6e886fc75"] :db/ensure [:answer-field/validate]} {:db/id "answer-b868faa3-115c-5037-8c5f-5af78b26efc5" :answer/id #uuid "b868faa3-115c-5037-8c5f-5af78b26efc5" :answer/type :answer.type/math :answer/value "-2\\operatorname{cosh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-b4152a38-4c87-5f27-a424-8cf6b74504ae" :answer/id #uuid "b4152a38-4c87-5f27-a424-8cf6b74504ae" :answer/type :answer.type/math :answer/value "-2\\operatorname{sinh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-b43a16d4-9dc6-5733-a699-04e2130521c0" :answer/id #uuid "b43a16d4-9dc6-5733-a699-04e2130521c0" :answer/type :answer.type/math :answer/value "2\\operatorname{cosh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-fc47d088-7fa9-5e9d-b775-a4836da902e8" :answer/id #uuid "fc47d088-7fa9-5e9d-b775-a4836da902e8" :answer/type :answer.type/math :answer/value "2\\operatorname{sinh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-52b56404-c1f6-5cb4-bb91-10e6e886fc75" :answer/id #uuid "52b56404-c1f6-5cb4-bb91-10e6e886fc75" :answer/type :answer.type/math :answer/value "2{sinh}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "question-5680853a-d12c-5a26-9f72-c834e93e1139" :question/id #uuid "5680853a-d12c-5a26-9f72-c834e93e1139" :question/math-academy-id "q-95956" :question/problem "$$\n\n$\\int (\\operatorname{sinh}⁡\\theta +\\operatorname{cosh}⁡\\theta )\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sinh}⁡\\theta )=\\operatorname{cosh}⁡\\theta \\,⇒\\,\\int \\operatorname{cosh}⁡\\theta \\,\\text{d}\\theta =\\operatorname{sinh}⁡\\theta +C, \\\\ \\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cosh}⁡\\theta )=\\operatorname{sinh}⁡\\theta \\,⇒\\,\\int \\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta =\\operatorname{cosh}⁡\\theta +C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sinh}⁡\\theta +\\operatorname{cosh}⁡\\theta )\\text{d}\\theta  & =\\int \\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta +\\int \\operatorname{cosh}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{cosh}⁡\\theta +\\operatorname{sinh}⁡\\theta +C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eb741f5b-1565-5f14-84f1-11d38fa22341"] :db/ensure [:question/validate]} {:db/id "answer-field-eb741f5b-1565-5f14-84f1-11d38fa22341" :answer-field/id #uuid "eb741f5b-1565-5f14-84f1-11d38fa22341" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dba14e5a-1a6d-5364-a9bf-6ab6a216a658" :answer-field/choices ["answer-4844cdb8-54b6-58e7-9883-9ea6ad306b6b" "answer-dba14e5a-1a6d-5364-a9bf-6ab6a216a658" "answer-33e31558-b1ad-57d7-9906-0a080ecae66d" "answer-b3a02f87-5bc6-5cae-bb41-f06b4832cd2e" "answer-f7d5ee27-868d-5a63-b44c-9ac842072ad9"] :db/ensure [:answer-field/validate]} {:db/id "answer-4844cdb8-54b6-58e7-9883-9ea6ad306b6b" :answer/id #uuid "4844cdb8-54b6-58e7-9883-9ea6ad306b6b" :answer/type :answer.type/math :answer/value "-\\operatorname{cosh}⁡\\theta -\\operatorname{sinh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-dba14e5a-1a6d-5364-a9bf-6ab6a216a658" :answer/id #uuid "dba14e5a-1a6d-5364-a9bf-6ab6a216a658" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡\\theta +\\operatorname{sinh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-33e31558-b1ad-57d7-9906-0a080ecae66d" :answer/id #uuid "33e31558-b1ad-57d7-9906-0a080ecae66d" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡\\theta -\\operatorname{sinh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-b3a02f87-5bc6-5cae-bb41-f06b4832cd2e" :answer/id #uuid "b3a02f87-5bc6-5cae-bb41-f06b4832cd2e" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡\\theta -\\operatorname{cosh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-f7d5ee27-868d-5a63-b44c-9ac842072ad9" :answer/id #uuid "f7d5ee27-868d-5a63-b44c-9ac842072ad9" :answer/type :answer.type/math :answer/value "{cosh}^{2}⁡\\theta -{sinh}^{2}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "question-7995d4d6-c95b-5da1-93d8-010d3c638707" :question/id #uuid "7995d4d6-c95b-5da1-93d8-010d3c638707" :question/math-academy-id "q-95909" :question/problem "$$\n\n$\\int -\\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cosh}⁡\\theta )=\\operatorname{sinh}⁡\\theta \\,⇒\\,\\int \\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta =\\operatorname{cosh}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int -\\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta  & =-\\int \\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{cosh}⁡\\theta +C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c6cba0c5-8479-50ea-a249-95b79380050f"] :db/ensure [:question/validate]} {:db/id "answer-field-c6cba0c5-8479-50ea-a249-95b79380050f" :answer-field/id #uuid "c6cba0c5-8479-50ea-a249-95b79380050f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8199aae-116a-53f8-840a-2990e580b70d" :answer-field/choices ["answer-a8199aae-116a-53f8-840a-2990e580b70d" "answer-b0a02980-95b5-557f-9e99-abda9f9db051" "answer-c50d0e1e-33a7-53da-ae12-90847d58278c" "answer-27f12f58-c14d-5f00-971f-69569a27dcb3" "answer-e084d397-fa5c-5580-84df-2d9b1aca946b"] :db/ensure [:answer-field/validate]} {:db/id "answer-a8199aae-116a-53f8-840a-2990e580b70d" :answer/id #uuid "a8199aae-116a-53f8-840a-2990e580b70d" :answer/type :answer.type/math :answer/value "-\\operatorname{cosh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-b0a02980-95b5-557f-9e99-abda9f9db051" :answer/id #uuid "b0a02980-95b5-557f-9e99-abda9f9db051" :answer/type :answer.type/math :answer/value "-{sinh}^{2}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-c50d0e1e-33a7-53da-ae12-90847d58278c" :answer/id #uuid "c50d0e1e-33a7-53da-ae12-90847d58278c" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-27f12f58-c14d-5f00-971f-69569a27dcb3" :answer/id #uuid "27f12f58-c14d-5f00-971f-69569a27dcb3" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-e084d397-fa5c-5580-84df-2d9b1aca946b" :answer/id #uuid "e084d397-fa5c-5580-84df-2d9b1aca946b" :answer/type :answer.type/math :answer/value "{cosh}^{2}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "question-ffbc29d4-283f-5ef8-b5e9-fbf587b07a8e" :question/id #uuid "ffbc29d4-283f-5ef8-b5e9-fbf587b07a8e" :question/math-academy-id "q-96005" :question/problem "$\\int (\\operatorname{sech}⁡\\theta \\operatorname{tanh}⁡\\theta +\\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta )\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sech}⁡\\theta )=-\\operatorname{sech}⁡\\theta \\operatorname{tanh}⁡\\theta \\,⇒\\,\\int \\operatorname{sech}⁡\\theta \\operatorname{tanh}⁡\\theta \\,\\text{d}\\theta =-\\operatorname{sech}⁡\\theta +C,\n$$\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{csch}⁡\\theta )=-\\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta \\,⇒\\,\\int \\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta \\,\\text{d}\\theta =-\\operatorname{csch}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (\\operatorname{sech}⁡\\theta \\operatorname{tanh}⁡\\theta +\\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta )\\text{d}\\theta  & =\\int \\operatorname{sech}⁡\\theta \\operatorname{tanh}⁡\\theta \\,\\text{d}\\theta +\\int \\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\operatorname{sech}⁡\\theta -\\operatorname{csch}⁡\\theta +C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-648c646f-2bd9-5a85-a024-f0c27585558a"] :db/ensure [:question/validate]} {:db/id "answer-field-648c646f-2bd9-5a85-a024-f0c27585558a" :answer-field/id #uuid "648c646f-2bd9-5a85-a024-f0c27585558a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ade9eed-c5c4-565b-acac-43354d6d4592" :answer-field/choices ["answer-8ade9eed-c5c4-565b-acac-43354d6d4592" "answer-988ba85f-211c-5967-a5c9-1cbd2778c642" "answer-0e82c151-1920-5947-872e-8b406562dca9" "answer-2b203117-7b62-5d18-9946-2202fe61e7b3" "answer-ee4f403f-2f2f-5e9f-9a1a-e4cbde1d272e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ade9eed-c5c4-565b-acac-43354d6d4592" :answer/id #uuid "8ade9eed-c5c4-565b-acac-43354d6d4592" :answer/type :answer.type/math :answer/value "-\\operatorname{sech}⁡\\theta -\\operatorname{csch}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-988ba85f-211c-5967-a5c9-1cbd2778c642" :answer/id #uuid "988ba85f-211c-5967-a5c9-1cbd2778c642" :answer/type :answer.type/math :answer/value "-\\operatorname{sech}⁡\\theta -{csch}^{2}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-0e82c151-1920-5947-872e-8b406562dca9" :answer/id #uuid "0e82c151-1920-5947-872e-8b406562dca9" :answer/type :answer.type/math :answer/value "\\operatorname{sech}⁡\\theta +\\operatorname{csch}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-2b203117-7b62-5d18-9946-2202fe61e7b3" :answer/id #uuid "2b203117-7b62-5d18-9946-2202fe61e7b3" :answer/type :answer.type/math :answer/value "\\operatorname{sech}⁡\\theta -\\operatorname{csch}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-ee4f403f-2f2f-5e9f-9a1a-e4cbde1d272e" :answer/id #uuid "ee4f403f-2f2f-5e9f-9a1a-e4cbde1d272e" :answer/type :answer.type/math :answer/value "{sech}^{2}⁡\\theta +{csch}^{2}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "question-0e3dc46b-f218-5db9-8dad-c903a297971f" :question/id #uuid "0e3dc46b-f218-5db9-8dad-c903a297971f" :question/math-academy-id "q-96018" :question/problem "$$\n\n$\\int (3+2{sech}^{2}⁡w)\\,\\text{d}w=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}w}(\\operatorname{tanh}⁡w)={sech}^{2}⁡w\\,⇒\\,\\int {sech}^{2}⁡w\\,\\text{d}w=\\operatorname{tanh}⁡w+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (3+2{sech}^{2}⁡w)\\,\\text{d}w & =\\int 3\\,\\text{d}w+\\int 2{sech}^{2}⁡w\\,\\text{d}w \\\\  & =3\\int \\,\\text{d}w+2\\int {sech}^{2}⁡w\\,\\text{d}w \\\\  & =3w+2\\operatorname{tanh}⁡w+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1e409ac3-04c8-5f18-8a8d-ca01f062f3ca"] :db/ensure [:question/validate]} {:db/id "answer-field-1e409ac3-04c8-5f18-8a8d-ca01f062f3ca" :answer-field/id #uuid "1e409ac3-04c8-5f18-8a8d-ca01f062f3ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04ed125b-9b3f-5c4f-be3f-84aebb4f4be4" :answer-field/choices ["answer-813bd999-cd21-564f-a2bc-503c82639ef5" "answer-b90ef3b9-5386-53d5-8771-6ae41b6a6450" "answer-5d613db4-7b9d-5ddf-915e-76f616c79dbb" "answer-04ed125b-9b3f-5c4f-be3f-84aebb4f4be4" "answer-71f0d344-b735-5e37-ab56-41d8eba570db"] :db/ensure [:answer-field/validate]} {:db/id "answer-813bd999-cd21-564f-a2bc-503c82639ef5" :answer/id #uuid "813bd999-cd21-564f-a2bc-503c82639ef5" :answer/type :answer.type/math :answer/value "3+2\\operatorname{coth}⁡w+C" :db/ensure [:answer/validate]} {:db/id "answer-b90ef3b9-5386-53d5-8771-6ae41b6a6450" :answer/id #uuid "b90ef3b9-5386-53d5-8771-6ae41b6a6450" :answer/type :answer.type/math :answer/value "3-2\\operatorname{tanh}⁡w+C" :db/ensure [:answer/validate]} {:db/id "answer-5d613db4-7b9d-5ddf-915e-76f616c79dbb" :answer/id #uuid "5d613db4-7b9d-5ddf-915e-76f616c79dbb" :answer/type :answer.type/math :answer/value "3w+2\\operatorname{coth}⁡w+C" :db/ensure [:answer/validate]} {:db/id "answer-04ed125b-9b3f-5c4f-be3f-84aebb4f4be4" :answer/id #uuid "04ed125b-9b3f-5c4f-be3f-84aebb4f4be4" :answer/type :answer.type/math :answer/value "3w+2\\operatorname{tanh}⁡w+C" :db/ensure [:answer/validate]} {:db/id "answer-71f0d344-b735-5e37-ab56-41d8eba570db" :answer/id #uuid "71f0d344-b735-5e37-ab56-41d8eba570db" :answer/type :answer.type/math :answer/value "3w-2\\operatorname{tanh}⁡w+C" :db/ensure [:answer/validate]} {:db/id "question-c8cdc03f-da95-544a-8d8d-7ede702d3109" :question/id #uuid "c8cdc03f-da95-544a-8d8d-7ede702d3109" :question/math-academy-id "q-96051" :question/problem "$\\int \\operatorname{sin}⁡\\frac{\\pi }{5}\\,{csch}^{2}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{csch}^{2}⁡x\\,⇒\\,\\int {csch}^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡\\frac{\\pi }{5}\\,{csch}^{2}⁡x\\,\\text{d}x & =\\operatorname{sin}⁡\\frac{\\pi }{5}\\,\\int {csch}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{sin}⁡\\frac{\\pi }{5}\\,\\operatorname{coth}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-98f39c56-36d9-5e09-95c9-775d62585187"] :db/ensure [:question/validate]} {:db/id "answer-field-98f39c56-36d9-5e09-95c9-775d62585187" :answer-field/id #uuid "98f39c56-36d9-5e09-95c9-775d62585187" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3913e98d-6f83-56d3-91d7-ff2f32e15e3a" :answer-field/choices ["answer-3913e98d-6f83-56d3-91d7-ff2f32e15e3a" "answer-8d0fce6e-25a6-5623-a414-4de231b8bded" "answer-4902412c-0550-564e-869c-3d3c7116bee9" "answer-3aeb0a67-56ca-5962-8e3b-7bedc6372910" "answer-56341777-5636-52fc-a550-48d78387c058"] :db/ensure [:answer-field/validate]} {:db/id "answer-3913e98d-6f83-56d3-91d7-ff2f32e15e3a" :answer/id #uuid "3913e98d-6f83-56d3-91d7-ff2f32e15e3a" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡\\frac{\\pi }{5}\\,\\operatorname{coth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-8d0fce6e-25a6-5623-a414-4de231b8bded" :answer/id #uuid "8d0fce6e-25a6-5623-a414-4de231b8bded" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡\\frac{\\pi }{5}\\,\\operatorname{tanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-4902412c-0550-564e-869c-3d3c7116bee9" :answer/id #uuid "4902412c-0550-564e-869c-3d3c7116bee9" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\frac{\\pi }{5}\\,\\operatorname{coth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-3aeb0a67-56ca-5962-8e3b-7bedc6372910" :answer/id #uuid "3aeb0a67-56ca-5962-8e3b-7bedc6372910" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\frac{\\pi }{5}\\,\\operatorname{tanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-56341777-5636-52fc-a550-48d78387c058" :answer/id #uuid "56341777-5636-52fc-a550-48d78387c058" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\frac{\\pi }{5}\\,{coth}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186064971 :question/problem "$$\n\n$\\int 4{csch}^{2}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{csch}^{2}⁡x\\,⇒\\,\\int {csch}^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 4{csch}^{2}⁡x\\,\\text{d}x & =4\\int {csch}^{2}⁡x\\,\\text{d}x \\\\  & =-4\\operatorname{coth}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186063881 :answer-field/correct "answer-2246e344-4fce-54a4-b3ff-1285907e3b1e" :answer-field/choices ["answer-2246e344-4fce-54a4-b3ff-1285907e3b1e" "answer-0075baee-8162-536a-a1aa-424af9c1888c" "answer-56c3407d-f5bf-5b83-98bb-b6f2afb56bbd" "answer-4708a223-4b97-50f3-ae35-227f3d98f8b9" "answer-8b636f38-63a2-5cc3-a702-a1c9d0a01952"] :db/ensure [:answer-field/validate]} {:db/id "answer-2246e344-4fce-54a4-b3ff-1285907e3b1e" :answer/id #uuid "2246e344-4fce-54a4-b3ff-1285907e3b1e" :answer/type :answer.type/math :answer/value "-4\\operatorname{coth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-0075baee-8162-536a-a1aa-424af9c1888c" :answer/id #uuid "0075baee-8162-536a-a1aa-424af9c1888c" :answer/type :answer.type/math :answer/value "-4\\operatorname{tanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-56c3407d-f5bf-5b83-98bb-b6f2afb56bbd" :answer/id #uuid "56c3407d-f5bf-5b83-98bb-b6f2afb56bbd" :answer/type :answer.type/math :answer/value "-4{tanh}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-4708a223-4b97-50f3-ae35-227f3d98f8b9" :answer/id #uuid "4708a223-4b97-50f3-ae35-227f3d98f8b9" :answer/type :answer.type/math :answer/value "4\\operatorname{coth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "answer-8b636f38-63a2-5cc3-a702-a1c9d0a01952" :answer/id #uuid "8b636f38-63a2-5cc3-a702-a1c9d0a01952" :answer/type :answer.type/math :answer/value "4\\operatorname{tanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id 17592186065392 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nBy considering the derivatives of the hyperbolic tangent, secant, cosecant, and cotangent, we arrive at the following results:\n\n$$\n\\begin{aligned}\\int {sech}^{2}⁡x\\text{ }\\text{d}x & =\\operatorname{tanh}⁡x+C \\\\ \\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\text{ }\\text{d}x & =-\\operatorname{sech}⁡x+C \\\\ \\int \\operatorname{csch}⁡x\\operatorname{coth}⁡x\\text{ }\\text{d}x & =-\\operatorname{csch}⁡x+C \\\\ \\int {csch}^{2}⁡x\\text{ }\\text{d}x & =-\\operatorname{coth}⁡x+C\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186064404 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186119837 :knowledge-point/questions ["question-83aacc67-1785-59c3-94ae-6f65bea01fe4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-83aacc67-1785-59c3-94ae-6f65bea01fe4" :question/id #uuid "83aacc67-1785-59c3-94ae-6f65bea01fe4" :question/math-academy-id "q-108881" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x+2}{3}=\\frac{y+1}{2}=\\frac{z}{4},\\,Π:r\\cdot ⟨3,-1,2⟩=25.\n$$" :question/worked-solution "From the equation of the line $l$, we know that it passes through the point $A(-2,-1,0)$ and it is parallel to the vector $v=⟨3,2,4⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨-2,-1,0⟩+t⟨3,2,4⟩ \\\\  & =⟨-2+3t,-1+2t,4t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨-2+3t,-1+2t,4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-1,2⟩ & =25 \\\\ ⟨-2+3t,-1+2t,4t⟩\\cdot ⟨3,-1,2⟩ & =25 \\\\ 3(-2+3t)-(-1+2t)+2(4t) & =25 \\\\ -6+9t+1-2t+8t & =25 \\\\ 15t & =30 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-2+3(2),-1+2(2),4(2)⟩ \\\\  & =⟨4,3,8⟩.\\end{aligned}\n$$\n\nSo, we get $P(4,3,8).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c8d9ffbc-23ef-519d-9512-884d3bb1903d"] :db/ensure [:question/validate]} {:db/id "answer-field-c8d9ffbc-23ef-519d-9512-884d3bb1903d" :answer-field/id #uuid "c8d9ffbc-23ef-519d-9512-884d3bb1903d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer-field/choices ["answer-97dcbf66-8c48-507d-96c6-a848577b2e92" "answer-13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" "answer-0a4e4e53-6530-5d9b-ac71-88fa4a852643" "answer-a9993b57-a418-5d19-be94-6b1c3a3b00c8" "answer-3e792c4b-0f89-58e4-ad54-bf65b7f20967"] :db/ensure [:answer-field/validate]} {:db/id "answer-97dcbf66-8c48-507d-96c6-a848577b2e92" :answer/id #uuid "97dcbf66-8c48-507d-96c6-a848577b2e92" :answer/type :answer.type/math :answer/value "(-5,-3,-4)" :db/ensure [:answer/validate]} {:db/id "answer-13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/id #uuid "13d7977a-6ece-5a3d-a4d3-a046ae5ee70a" :answer/type :answer.type/math :answer/value "(4,3,8)" :db/ensure [:answer/validate]} {:db/id "answer-0a4e4e53-6530-5d9b-ac71-88fa4a852643" :answer/id #uuid "0a4e4e53-6530-5d9b-ac71-88fa4a852643" :answer/type :answer.type/math :answer/value "(7,5,12)" :db/ensure [:answer/validate]} {:db/id "answer-a9993b57-a418-5d19-be94-6b1c3a3b00c8" :answer/id #uuid "a9993b57-a418-5d19-be94-6b1c3a3b00c8" :answer/type :answer.type/math :answer/value "(8,5,8)" :db/ensure [:answer/validate]} {:db/id "answer-3e792c4b-0f89-58e4-ad54-bf65b7f20967" :answer/id #uuid "3e792c4b-0f89-58e4-ad54-bf65b7f20967" :answer/type :answer.type/text :answer/value "No intersection" :db/ensure [:answer/validate]}]
