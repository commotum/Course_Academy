86193194 :step/next "step-36d19675-a010-5c2a-8793-7b1c7dc46266" :db/ensure [:step/validate]} {:db/id "step-36d19675-a010-5c2a-8793-7b1c7dc46266" :step/id #uuid "36d19675-a010-5c2a-8793-7b1c7dc46266" :step/content "question-6141f906-6242-52a2-92a1-6fa0f7b0342a" :step/next "step-23769111-4f78-5f80-a5ce-c23eb81061b1" :db/ensure [:step/validate]} {:db/id "step-23769111-4f78-5f80-a5ce-c23eb81061b1" :step/id #uuid "23769111-4f78-5f80-a5ce-c23eb81061b1" :step/content "question-871ccc09-e09c-5033-9027-58208490bfda" :step/next "step-bd709fd0-dfec-5ed5-b548-5cd3d4707f29" :db/ensure [:step/validate]} {:db/id "step-bd709fd0-dfec-5ed5-b548-5cd3d4707f29" :step/id #uuid "bd709fd0-dfec-5ed5-b548-5cd3d4707f29" :step/content "question-bde496f4-3c68-52cf-9034-88a484da871a" :step/next "step-88bd62ec-15d2-5a2e-93d2-79206567236d" :db/ensure [:step/validate]} {:db/id "step-88bd62ec-15d2-5a2e-93d2-79206567236d" :step/id #uuid "88bd62ec-15d2-5a2e-93d2-79206567236d" :step/content "question-6aba45a4-2e2c-520c-97f5-9345f709dabd" :db/ensure [:step/validate]} {:db/id 17592186054614 :knowledge-point/questions ["question-7700df8a-7603-5144-96dd-4cda2bbcc154"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054525 :question/problem "What is the value of $4\\textrm{i}^3?$" :question/worked-solution "Let's recall the first few powers of $\\textrm{i},$ where $\\textrm{i} = \\sqrt{-1}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}4{\\text{i}}^{3} & =4\\cdot (-\\text{i})=-4\\text{i}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054615 :knowledge-point/questions ["question-e97c4d66-5268-5c26-8025-6f1540da8cb0" "question-963c1f30-8cab-5b1e-a22e-507ad07f1c0a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054526 :question/problem "Simplify $\\textrm{i}^{15}.$" :question/worked-solution "To find the value of $\\textrm{i}$ to some positive integer power $n$, we divide $n$ by $4$ and raise $\\textrm{i}$ to the remainder.\n\nIn our case, we have $n=15.$ Dividing the power by $4,$ we get\n\n$$\n15\\div 4 = 3\\,\\textrm{R} \\color{blue}{3}.\n$$\n\nSo the remainder is $\\color{blue}3.$ Therefore,\n\n$$\n\\textrm{i}^{15} = \\textrm{i}^{\\color{blue}{3}} = -\\textrm{i}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186054616 :knowledge-point/questions ["question-a99262a6-2443-5dc5-a1ae-4680319ed028" "question-ee98c1bb-35f5-5014-9747-c74bb8f7a21e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054527 :question/problem "If $a = \\textrm{i}^9$ and $b = \\textrm{i}^{7},$ then $ab =$" :question/worked-solution "Using the addition law for exponents, we have\n\n$$\nab =\\textrm{i}^9\\cdot\\textrm{i}^7 = \\textrm{i}^{9+7} = \\textrm{i}^{16}.\n$$\n\nTo find the value of $\\textrm{i}$ raised to some positive integer power $n,$ we divide $n$ by $4$ and raise $\\textrm{i}$ to the remainder.\n\nIn our case, we have $n=16.$ Dividing the power by $4,$ we get\n\n$$\n16\\div 4 = 4\\,\\textrm{R} \\color{blue}{0}.\n$$\n\nSo the remainder is $\\color{blue}0.$ Therefore,\n\n$$\n\\textrm{i}^{16} = \\textrm{i}^{\\color{blue}{0}} =1.\n$$" :db/ensure [:question/validate]} {:db/id 17592186054617 :knowledge-point/questions ["question-fd293abd-5e28-58d2-85df-2177162157d2" "question-40959c8e-9382-5950-9324-5f121903c27d" "question-397ae4dc-5dce-54bd-9646-1b3867960198"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054528 :question/problem "Find the value of $\\textrm{i}^{-2}.$" :question/worked-solution "First, using the laws of exponents, we can write\n\n$$\n\\textrm{i}^{-2}=\\dfrac{1}{\\textrm{i}^2}.\n$$\n\nWe now recall that $\\textrm{i}^2 = -1.$ Therefore,\n\n$$\n\\dfrac{1}{\\textrm{i}^2} = \\dfrac{1}{(-1)} = -1.\n$$" :db/ensure [:question/validate]} {:db/id "question-7700df8a-7603-5144-96dd-4cda2bbcc154" :question/id #uuid "7700df8a-7603-5144-96dd-4cda2bbcc154" :question/math-academy-id "q-66390" :question/problem "What is the value of $15{\\text{i}}^{4}+15{\\text{i}}^{2}?$" :question/worked-solution "Let's recall the first few powers of $\\text{i},$ where $\\text{i}=\\sqrt{-1}:$\n\n$$\n\\begin{aligned}{\\text{i}}^{0} & =1 \\\\ {\\text{i}}^{1} & =\\text{i} \\\\ {\\text{i}}^{2} & =-1 \\\\ {\\text{i}}^{3} & ={\\text{i}}^{2}\\cdot \\text{i}=(-1)\\cdot \\text{i}=-\\text{i} \\\\ {\\text{i}}^{4} & ={\\text{i}}^{2}\\cdot {\\text{i}}^{2}=(-1)\\cdot (-1)=1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}15{\\text{i}}^{4}+15{\\text{i}}^{2}=15(1)+15(-1)=0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8f887e31-395f-5f9a-910f-099fe04892b3"] :db/ensure [:question/validate]} {:db/id "answer-field-8f887e31-395f-5f9a-910f-099fe04892b3" :answer-field/id #uuid "8f887e31-395f-5f9a-910f-099fe04892b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fff0f52d-e3f6-56b2-b753-038b074f395c" :answer-field/choices ["answer-05e86823-606d-52b9-b22c-08dc8213a50f" "answer-b9ec1402-18e1-5807-b8e4-f930d98509cb" "answer-fff0f52d-e3f6-56b2-b753-038b074f395c" "answer-35695b19-9dc0-5ad2-b6d8-e4361c0009b9" "answer-26d08161-81ec-5c98-aa09-3753da662eb2"] :db/ensure [:answer-field/validate]} {:db/id "answer-05e86823-606d-52b9-b22c-08dc8213a50f" :answer/id #uuid "05e86823-606d-52b9-b22c-08dc8213a50f" :answer/type :answer.type/math :answer/value "-15" :db/ensure [:answer/validate]} {:db/id "answer-b9ec1402-18e1-5807-b8e4-f930d98509cb" :answer/id #uuid "b9ec1402-18e1-5807-b8e4-f930d98509cb" :answer/type :answer.type/math :answer/value "-30\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-fff0f52d-e3f6-56b2-b753-038b074f395c" :answer/id #uuid "fff0f52d-e3f6-56b2-b753-038b074f395c" :answer/type :answer.type/math :answer/value