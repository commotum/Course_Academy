answer-field-1239588e-50a4-52fa-9f56-2372f3d6c0ed"] :db/ensure [:question/validate]} {:db/id "answer-field-1239588e-50a4-52fa-9f56-2372f3d6c0ed" :answer-field/id #uuid "1239588e-50a4-52fa-9f56-2372f3d6c0ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc504732-4c06-5c31-b7b3-ed11f4ba1707" :answer-field/choices ["answer-09a11886-ba0a-5688-ae42-6dba68e1d651" "answer-4077c927-c70e-5d55-98fb-81d0b8fabfa4" "answer-dc504732-4c06-5c31-b7b3-ed11f4ba1707" "answer-e54e6c46-50cd-5170-a2b5-90a0063808a2" "answer-b652bb4a-19f0-5d00-84a5-07c32285b424"] :db/ensure [:answer-field/validate]} {:db/id "answer-09a11886-ba0a-5688-ae42-6dba68e1d651" :answer/id #uuid "09a11886-ba0a-5688-ae42-6dba68e1d651" :answer/type :answer.type/math :answer/value "7\\sqrt{2}-8" :db/ensure [:answer/validate]} {:db/id "answer-4077c927-c70e-5d55-98fb-81d0b8fabfa4" :answer/id #uuid "4077c927-c70e-5d55-98fb-81d0b8fabfa4" :answer/type :answer.type/math :answer/value "7\\sqrt{2}-9" :db/ensure [:answer/validate]} {:db/id "answer-dc504732-4c06-5c31-b7b3-ed11f4ba1707" :answer/id #uuid "dc504732-4c06-5c31-b7b3-ed11f4ba1707" :answer/type :answer.type/math :answer/value "8\\sqrt{2}-9" :db/ensure [:answer/validate]} {:db/id "answer-e54e6c46-50cd-5170-a2b5-90a0063808a2" :answer/id #uuid "e54e6c46-50cd-5170-a2b5-90a0063808a2" :answer/type :answer.type/math :answer/value "\\frac{8\\sqrt{2}-9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b652bb4a-19f0-5d00-84a5-07c32285b424" :answer/id #uuid "b652bb4a-19f0-5d00-84a5-07c32285b424" :answer/type :answer.type/math :answer/value "\\frac{8\\sqrt{2}-9}{4}" :db/ensure [:answer/validate]} {:db/id "question-4303b0e2-8da8-5cbc-9699-e12d9f977852" :question/id #uuid "4303b0e2-8da8-5cbc-9699-e12d9f977852" :question/math-academy-id "q-293711" :question/problem "Rationalize the denominator of $\\frac{1+\\sqrt{5}}{\\sqrt{8}-\\sqrt{2}}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{8}+\\sqrt{2}.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{8}+\\sqrt{2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1+\\sqrt{5}}{\\sqrt{8}-\\sqrt{2}} & = \\\\ \\frac{1+\\sqrt{5}}{\\sqrt{8}-\\sqrt{2}}\\cdot \\frac{\\sqrt{8}+\\sqrt{2}}{\\sqrt{8}+\\sqrt{2}} & = \\\\ \\frac{(1+\\sqrt{5})(\\sqrt{8}+\\sqrt{2})}{(\\sqrt{8}+\\sqrt{2})(\\sqrt{8}-\\sqrt{2})} & = \\\\ \\frac{\\sqrt{8}+\\sqrt{2}+\\sqrt{40}+\\sqrt{10}}{(\\sqrt{8})^{2}-(\\sqrt{2})^{2}} & = \\\\ \\frac{2\\sqrt{2}+\\sqrt{2}+2\\sqrt{10}+\\sqrt{10}}{8-2} & = \\\\ \\frac{3\\sqrt{2}+3\\sqrt{10}}{6}= \\\\ \\frac{\\sqrt{2}+\\sqrt{10}}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a395ed64-2a38-5c8a-8ef9-10317ec52a0f"] :db/ensure [:question/validate]} {:db/id "answer-field-a395ed64-2a38-5c8a-8ef9-10317ec52a0f" :answer-field/id #uuid "a395ed64-2a38-5c8a-8ef9-10317ec52a0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-99dd91a7-7d0c-5adc-ad43-6d81eb4f0df0" :answer-field/choices ["answer-7459bda2-26bd-5869-a23c-dee040b75fb3" "answer-99dd91a7-7d0c-5adc-ad43-6d81eb4f0df0" "answer-0b7a18ec-3843-5cbc-8a5d-b60819493f11" "answer-1d0d9767-2d96-5f24-9479-9a6e77c04025" "answer-b58d011f-ee1b-5465-b238-3ad396acb5bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-7459bda2-26bd-5869-a23c-dee040b75fb3" :answer/id #uuid "7459bda2-26bd-5869-a23c-dee040b75fb3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+2\\sqrt{10}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-99dd91a7-7d0c-5adc-ad43-6d81eb4f0df0" :answer/id #uuid "99dd91a7-7d0c-5adc-ad43-6d81eb4f0df0" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+\\sqrt{10}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-0b7a18ec-3843-5cbc-8a5d-b60819493f11" :answer/id #uuid "0b7a18ec-3843-5cbc-8a5d-b60819493f11" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+\\sqrt{10}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-1d0d9767-2d96-5f24-9479-9a6e77c04025" :answer/id #uuid "1d0d9767-2d96-5f24-9479-9a6e77c04025" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+\\sqrt{10}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-b58d011f-ee1b-5465-b238-3ad396acb5bf" :answer/id #uuid "b58d011f-ee1b-5465-b238-3ad396acb5bf" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}-\\sqrt{10}}{6}" :db/ensure [:answer/validate]} {:db/id "question-5aa76a5d-2fdf-5390-a4d4-41bc22f928df" :question/id #uuid "5aa76a5d-2fdf-5390-a4d4-41bc22f928df" :question/math-academy-id "q-293700" :question/problem "Rationalize the denominator of $\\frac{2-\\sqrt{5}}{\\sqrt{5}+1}.$" :question/worked-solution "First, note that the denominator's conjugate is $\\sqrt{5}-1.$\n\nNow, to rationalize the denominator, we multiply both the numerator and denominator by the conjugate $\\sqrt{5}-1,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{2-\\sqrt{5}}{\\sqrt{5}+1} & = \\\\ \\frac{2-\\sqrt{5}}{\\sqrt{5}+1}\\cdot \\frac{\\sqrt{5}-1}{\\sqrt{5}-1} & = \\\\ \\frac{(2-\\sqrt{5})(\\sqrt{5}-1)}{(\\sqrt{5}+1)(\\sqrt{5}-1)} & = \\\\ \\frac{2\\sqrt{5}-2-(\\sqrt{5})^{2}+\\sqrt{5}}{(\\sqrt{5})^{2}-(1)^{2}} & = \\\\ \\frac{2\\sqrt{5}-2-5+\\sqrt{5}}{5-1} & = \\\\ \\frac{3\\sqrt{5}-7}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d60c623e-cd54-521e-b4cc-4ee18ee381c1"] :db/ensure [:question/validate]} {:db/id "answer-field-d60c623e-cd54-521e-b4cc-4ee18ee381c1" :answer-field/id #uuid "d60c623e-cd54-521e-b4cc-4ee18ee381c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eace7a1d-adb7-55cc-b124-2f588406660b" :answer-field/choices ["answer-e4315590-fb74-5bd1-859f-d18f7a914d2b" "answer-ca073c5c-f114-5614-9d30-fddd83084c4e" "answer-52506a91-197c-5fae-8c50-1577880fdaea" "answer-eace7a1d-adb7-55cc-b124-2f588406660b" "answer-c7a2949a-2eac-5516-8b3e-0a0551438446"] :db/ensure [:answer-field/validate]} {:db/id "answer-e4315590-fb74-5bd1-859f-d18f7a914d2b" :answer/id #uuid "e4315590-fb74-5bd1-859f-d18f7a914d2b" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{5}+7}{4}" :db/ensure [:answer/validate]} {:db/id "answer-ca073c5c-f114-5614-9d30-fddd83084c4e" :answer/id #uuid "ca073c5c-f114-5614-9d30-fddd83084c4e" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{5}-3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-52506a91-197c-5fae-8c50-1577880fdaea" :answer/id #uuid "52506a91-197c-5fae-8c50-1577880fdaea" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{5}-5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-eace7a1d-adb7-55cc-b124-2f588406660b" :answer/id #uuid "eace7a1d-adb7-55cc-b124-2f588406660b" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{5}-7}{4}" :db/ensure [:answer/validate]} {:db/id "answer-c7a2949a-2eac-5516-8b3e-0a0551438446" :answer/id #uuid "c7a2949a-2eac-5516-8b3e-0a0551438446" :answer/type :answer.type/math :answer/value "\\sqrt{5}-2" :db/ensure [:answer/validate]} {:db/id 17592186055933 :tutorial/content "When simplifying numerical expressions, it is generally preferable to avoid having radicals in the denominator. In cases where we wish to remove a radical from a denominator, we must **rationalize the denominator**.\n\nIf the denominator of an expression consists of two terms and includes one or more radicals, we rationalize it by multiplying both the numerator and the denominator by the **conjugate** of the denominator. \n\nTo illustrate, consider the following expression:\n\n$$\n\\dfrac{1}{1+\\sqrt{2}}\n$$\n\n \n\nTo find the conjugate of the denominator $1+\\sqrt{2},$ we *flip the sign* between the two terms. So, the conjugate of the denominator is \n\n$$\n1\\,{\\color{blue}{-}}\\,\\sqrt{2}.\n$$\n\nNow, to rationalize the denominator, we start by multiplying both the numerator and denominator by the conjugate $1-\\sqrt{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{1+\\sqrt{2}} & = \\\\ \\frac{1}{1+\\sqrt{2}}\\cdot \\frac{1-\\sqrt{2}}{1-\\sqrt{2}} & = \\\\ \\frac{1\\cdot (1-\\sqrt{2})}{(1+\\sqrt{2})(1-\\sqrt{2})} &  \\\\ \\frac{1-\\sqrt{2}}{(1+\\sqrt{2})(1-\\sqrt{2})} & \\end{aligned}\n$$\n\nNow, we recall the difference of squares formula:\n\n$$\n(a+b)(a-b) = a^2 - b^2\n$$\n\nApplying the difference of squares formula with $a=1, b=\\sqrt 2$ to simplify the denominator, we get\n\n$$\n\\begin{aligned}\\frac{1-\\sqrt{2}}{(1+\\sqrt{2})(1-\\sqrt{2})} & = \\\\ \\frac{1-\\sqrt{2}}{{1}^{2}-(\\sqrt{2})^{2}} & = \\\\ \\frac{1-\\sqrt{2}}{1-2} & = \\\\ \\frac{1-\\sqrt{2}}{-1} & = \\\\ \\sqrt{2}-1.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054928 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186124520 :knowledge-point/questions ["question-a01ead83-2905-5cc8-8484-4d72b8de14e4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a01ead83-2905-5cc8-8484-4d72b8de14e4" :question/id #uuid "a01ead83-2905-5cc8-8484-4d72b8de14e4" :question/math-academy-id "q-81239" :question/problem "Given the transformation $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}2y+z \\\\ -y+5x \\\\ -5x+y\\end{aligned}],$ find its rank." :question/worked-solution "First, the standard matrix of $T$ is given by\n\n$$\nT=[\\begin{aligned}0 & 2 & 1 \\\\ 5 & -1 & 0 \\\\ -5 & 1 & 0\\end{aligned}].\n$$\n\nRecall that $\\text{rank}(T)=\\text{dim}(\\text{Im}(T))=\\text{rank}(T).$ \n\nSo, we need to find the rank of the matrix $T.$ We reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}0 & 2 & 1 \\\\ 5 & -1 & 0 \\\\ -5 & 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}5 & -1 & 0 \\\\ 0 & 2 & 1 \\\\ -5 & 1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}5 & -1 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, since $T$ has $2$ pivot columns, we have that \n\n$$\n\\text{rank}(T)=\\text{rank}(T)=2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2dbe192f-fcea-5d95-af24-f30d6daade9b"] :db/ensure [:question/validate]} {:db/id "answer-field-2dbe192f-fcea-5d95-af24-f30d6daade9b" :answer-field/id #uuid "2dbe192f-fcea-5d95-af24-f30d6daade9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b499b3e0-0dd0-5a05-adf7-53d6d40b5113" :answer-field/choices ["answer-4fa18032-4597-5888-897a-1a2abf563191" "answer-0288ba49-d327-52cb-b676-e2f9dcdcbd55" "answer-b499b3e0-0dd0-5a05-adf7-53d6d40b5113" "answer-69597ef3-9ef8-5e15-99d8-b0dffa509414" "answer-8f1742c1-604f-5ffd-86c6-2860f5beb7d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fa18032-4597-5888-897a-1a2abf563191" :answer/id #uuid "4fa18032-4597-5888-897a-1a2abf563191" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-0288ba49-d327-52cb-b676-e2f9dcdcbd55" :answer/id #uuid "0288ba49-d327-52cb-b676-e2f9dcdcbd55" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b499b3e0-0dd0-5a05-adf7-53d6d40b5113" :answer/id #uuid "b499b3e0-0dd0-5a05-adf7-53d6d40b5113" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-69597ef3-9ef8-5e15-99d8-b0dffa509414" :answer/id #uuid "69597ef3-9ef8-5e15-99d8-b0dffa509414" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-8f1742c1-604f-5ffd-86c6-2860f5beb7d5" :answer/id #uuid "8f1742c1-604f-5ffd-86c6-2860f5beb7d5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "activity-30da5289-d976-5a27-8d1b-3ca387c32832" :activity/id #uuid "30da5289-d976-5a27-8d1b-3ca387c32832" :activity/title "The Image and Rank of a Linear Transformation" :activity/type :activity.type/review :activity/scope 17592186049539 :activity/course 17592186046644 :activi