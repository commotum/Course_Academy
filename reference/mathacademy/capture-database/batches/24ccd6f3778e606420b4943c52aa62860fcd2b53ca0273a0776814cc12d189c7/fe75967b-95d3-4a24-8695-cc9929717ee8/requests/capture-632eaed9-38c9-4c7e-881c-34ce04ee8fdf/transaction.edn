008-b9fc-e618f65747e4" :step/next "step-febeff6c-5ada-57a3-a1f8-8bc1079ec0d0" :db/ensure [:step/validate]} {:db/id "step-febeff6c-5ada-57a3-a1f8-8bc1079ec0d0" :step/id #uuid "febeff6c-5ada-57a3-a1f8-8bc1079ec0d0" :step/content "question-58e1bdfb-9550-5950-b391-e8892b95af10" :step/next "step-e610be17-d713-5476-8573-4ab202853156" :db/ensure [:step/validate]} {:db/id "step-e610be17-d713-5476-8573-4ab202853156" :step/id #uuid "e610be17-d713-5476-8573-4ab202853156" :step/content "question-1e85b0be-111d-5b57-b950-c149f90f77dc" :db/ensure [:step/validate]} {:db/id 17592186064153 :knowledge-point/questions ["question-e7907942-0453-56fa-81c8-7f3d98729c3f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064839 :question/problem "The birth rate of crocodiles in a river is modeled by $B(t)=6\\cdot {e}^{0.25t}$ crocodiles per year, while the rate of death is modeled by $D(t)=4\\cdot {e}^{0.25t}$ crocodiles per year, where $t$ represents the number of years since the year $2000.$  \n\nWhat was the rate of change of the crocodile population in $2012?$ Round your answer to the nearest integer." :question/worked-solution "The rate of change in the crocodile population $t$ years since $2000$ is equal to the birth rate minus the death rate, that is\n\n$$\nB(t)-D(t).\n$$\n\nSince $2012$ is $12$ years after $2000$, we have $t=12.$ Substituting $t=12,$ the rate of change of the crocodile population in the river  in $2012$ was\n\n$$\n\\begin{aligned}B(12)-D(12) & =6\\cdot {e}^{0.25(12)}-4\\cdot {e}^{0.25(12)} \\\\  & =6{e}^{3}-4{e}^{3} \\\\  & =2{e}^{3} \\\\  & ≈40.\\end{aligned}\n$$\n\nTherefore, the rate of change of the crocodile population in the river in $2012$ is approximately $40$ crocodiles per year." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186063091 :answer-field/correct 17592186063093 :db/ensure [:answer-field/validate]} {:db/id "question-e7907942-0453-56fa-81c8-7f3d98729c3f" :question/id #uuid "e7907942-0453-56fa-81c8-7f3d98729c3f" :question/math-academy-id "q-112104" :question/problem "The electrical resistivity of a copper wire varies with the temperature. The function $R(T)$ gives the resistivity of a wire at a temperature of $T$ degrees Celsius. What is the best interpretation of ${R}^{′}(10)=-0.01?$" :question/worked-solution "The function ${R}^{′}(T)$ represents the rate at which the resistivity of the wire is decreasing at $T$ degrees Celsius.\n\nTherefore, since it is negative, ${R}^{′}(10)=-0.01$ means:\n\n$\\,$ *At $10$ degrees Celsius, the resistivity of the wire decreases at a rate of $0.01$ units per degree.*" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7b611e52-ac20-5642-b35b-9cb7a57a497c"] :db/ensure [:question/validate]} {:db/id "answer-field-7b611e52-ac20-5642-b35b-9cb7a57a497c" :answer-field/id #uuid "7b611e52-ac20-5642-b35b-9cb7a57a497c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1071b292-1c48-516f-adc9-50669f444bd1" :answer-field/choices ["answer-1071b292-1c48-516f-adc9-50669f444bd1" "answer-e4b5bf6c-a912-5724-a3ac-e6ee153cd77d" "answer-e35b0b0f-5813-594b-9eea-774b722ff5ab" "answer-55c40cb2-7242-57e4-a518-1d8459f9122c" "answer-f895225b-6973-503a-8662-72877ccbd1b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-1071b292-1c48-516f-adc9-50669f444bd1" :answer/id #uuid "1071b292-1c48-516f-adc9-50669f444bd1" :answer/type :answer.type/text :answer/value "At $10$ degrees Celsius, the resistivity of the wire decreases at a rate of $0.01$ units per degree" :db/ensure [:answer/validate]} {:db/id "answer-e4b5bf6c-a912-5724-a3ac-e6ee153cd77d" :answer/id #uuid "e4b5bf6c-a912-5724-a3ac-e6ee153cd77d" :answer/type :answer.type/text :answer/value "At $10$ degrees Celsius, the resistivity of the wire increases at a rate of $0.01$ units per degree" :db/ensure [:answer/validate]} {:db/id "answer-e35b0b0f-5813-594b-9eea-774b722ff5ab" :answer/id #uuid "e35b0b0f-5813-594b-9eea-774b722ff5ab" :answer/type :answer.type/text :answer/value "At $10$ degrees Celsius, the resistivity of the wire is $0.01$ units" :db/ensure [:answer/validate]} {:db/id "answer-55c40cb2-7242-57e4-a518-1d8459f9122c" :answer/id #uuid "55c40cb2-7242-57e4-a518-1d8459f9122c" :answer/type :answer.type/text :answer/value "At $10$ degrees Celsius, the resistivity of the wire is $0.01$ units less than its value at ${0}^{∘}$" :db/ensure [:answer/validate]} {:db/id "answer-f895225b-6973-503a-8662-72877ccbd1b2" :answer/id #uuid "f895225b-6973-503a-8662-72877ccbd1b2" :answer/type :answer.type/text :answer/value "For each interval of $10$ degrees Celsius, the resistivity of the wire decreases by $0.01$ units" :db/ensure [:answer/validate]} {:db/id "activity-3bdd210c-9c04-5e69-a3ac-cdfe8109d5df" :activity/id #uuid "3bdd210c-9c04-5e69-a3ac-cdfe8109d5df" :activity/title "Interpreting the Meaning of the Derivative in Context" :activity/type :activity.type/review :activity/scope 17592186048835 :activity/course 17592186046647 :activity/steps ["step-90ed548d-7b9f-5b06-a9d7-d32c049ddb79" "step-15d5622f-a373-5ea6-99ae-45dd9cf87f84" "step-0e00795a-bf92-5c91-9599-9b3a42d17f2e"] :activity/first-step "step-90ed548d-7b9f-5b06-a9d7-d32c049ddb79" :db/ensure [:activity/validate]} {:db/id "step-90ed548d-7b9f-5b06-a9d7-d32c049ddb79" :step/id #uuid "90ed548d-7b9f-5b06-a9d7-d32c049ddb79" :step/content 17592186329907 :step/next "step-15d5622f-a373-5ea6-99ae-45dd9cf87f84" :db/ensure [:step/validate]} {:db/id "step-15d5622f-a373-5ea6-99ae-45dd9cf87f84" :step/id #uuid "15d5622f-a373-5ea6-99ae-45dd9cf87f84" :step/content 17592186064839 :step/next "step-0e00795a-bf92-5c91-9599-9b3a42d17f2e" :db/ensure [:step/validate]} {:db/id "step-0e00795a-bf92-5c91-9599-9b3a42d17f2e" :step/id #uuid "0e00795a-bf92-5c91-9599-9b3a42d17f2e" :step/content "question-e7907942-0453-56fa-81c8-7f3d98729c3f" :db/ensure [:step/validate]} {:db/id 17592186068830 :knowledge-point/questions ["question-4a3ed51c-6c18-5fdf-aaa4-d46ab866edd6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4a3ed51c-6c18-5fdf-aaa4-d46ab866edd6" :question/id #uuid "4a3ed51c-6c18-5fdf-aaa4-d46ab866edd6" :question/math-academy-id "q-27537" :question/problem "Which of the following is the graph of $y=2{(\\frac{1}{7})}^{x}+3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{7})}^{x}:$\n\n![](images/75/75bb797ddbea41de97c1c4ba52e142342bfffb4f9b2b9b82111ebc94abf55446.png)\n\nNext, we plot the graph of $y=2{(\\frac{1}{7})}^{x}.$ To do this, we scale the graph above by a factor of $2.$ The $y$-intercept moves from $(0,1)$ to $(0,2)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/d6/d68957038bfad7dfb4547d69abd178b087dde6c0f7c8ba95aa0fcd7547ccebe6.png)\n\nFinally, we plot the graph of $y=2{(\\frac{1}{7})}^{x}+3.$ To do this, we shift the above graph $3$ units up. The $y$-intercept moves from $(0,2)$ to $(0,5)$ and the horizontal asymptote moves from $y=0$ to $y=3.$\n\n![](images/fb/fb918b3042ca95c9401f2938258b7f13c909a87d18448c6e36c410a3d092dd94.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bc82adce-c8de-5498-affa-bca1f361d52c"] :db/ensure [:question/validate]} {:db/id "answer-field-bc82adce-c8de-5498-affa-bca1f361d52c" :answer-field/id #uuid "bc82adce-c8de-5498-affa-bca1f361d52c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-95ed6a5f-c6df-523f-b42e-cd835a9a1c8a" :answer-field/choices ["answer-37a5d74f-d40f-5fd5-80ec-9ce4a581202b" "answer-22d13b87-15e2-5156-af20-e9f92d7d3e83" "answer-426cb82b-e20d-5f97-8a0f-067aa9119d68" "answer-efcd7883-e1fd-57d5-928e-040cec2366cc" "answer-95ed6a5f-c6df-523f-b42e-cd835a9a1c8a"] :db/ensure [:answer-field/validate]} {:db/id "answer-37a5d74f-d40f-5fd5-80ec-9ce4a581202b" :answer/id #uuid "37a5d74f-d40f-5fd5-80ec-9ce4a581202b" :answer/type :answer.type/image :answer/value "images/2e/2e900d35853346bfbbcac7bb7b48298d45dc39313a549c1459b3ae