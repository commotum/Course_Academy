bbcef" "answer-7bdb203c-403b-5c7a-9b7e-0846cc37c78e" "answer-a18f517d-5d7a-5713-a2a7-49bee54b80b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1de2945-364c-50aa-8988-3364d0eee183" :answer/id #uuid "f1de2945-364c-50aa-8988-3364d0eee183" :answer/type :answer.type/math :answer/value "[-1,4]" :db/ensure [:answer/validate]} {:db/id "answer-239ed64f-b9a3-58e8-a207-a68375ffaf55" :answer/id #uuid "239ed64f-b9a3-58e8-a207-a68375ffaf55" :answer/type :answer.type/math :answer/value "[-1,6]" :db/ensure [:answer/validate]} {:db/id "answer-07499a9c-8e67-54b9-9395-d93c708bbcef" :answer/id #uuid "07499a9c-8e67-54b9-9395-d93c708bbcef" :answer/type :answer.type/math :answer/value "[-1,9]" :db/ensure [:answer/validate]} {:db/id "answer-7bdb203c-403b-5c7a-9b7e-0846cc37c78e" :answer/id #uuid "7bdb203c-403b-5c7a-9b7e-0846cc37c78e" :answer/type :answer.type/math :answer/value "[-3,0]" :db/ensure [:answer/validate]} {:db/id "answer-a18f517d-5d7a-5713-a2a7-49bee54b80b9" :answer/id #uuid "a18f517d-5d7a-5713-a2a7-49bee54b80b9" :answer/type :answer.type/math :answer/value "[0,6]" :db/ensure [:answer/validate]} {:db/id 17592186064268 :knowledge-point/questions ["question-c6acc05f-c544-5e0c-918b-0d7218132aa6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c6acc05f-c544-5e0c-918b-0d7218132aa6" :question/id #uuid "c6acc05f-c544-5e0c-918b-0d7218132aa6" :question/math-academy-id "q-101729" :question/problem "The table below lists values of $f(x)$ at distinct $x$-values. Knowing that the average rate of change of the function $f(x)$ on the interval $[3p,5]$ is $-2,$ find the value of $p.$ \n\n| $x$ | $\\,-10\\,$ | $\\,-7\\,$ | $\\,3p\\,$ | $\\,-2\\,$ | $\\,0\\,$ | $\\,1\\,$ | $\\,5\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $\\,12\\,$ | $\\,8\\,$ | $\\,11\\,$ | $\\,-2\\,$ | $\\,3\\,$ | $\\,-16\\,$ | $\\,-8\\,$ |" :question/worked-solution "Using the formula for the average rate of change, we get\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{f(b)-f(a)}{b-a} \\\\  & =\\frac{f(5)-f(3p)}{5-3p} \\\\  & =\\frac{-8-11}{5-3p} \\\\  & =\\frac{-19}{5-3p}.\\end{aligned}\n$$\n\nNow, we know that $\\frac{Δf}{Δx}=-2$ on the interval $[3p,5].$ Thus, \n\n$$\n\\frac{-19}{5-3p}=-2.\n$$\n\nSolving for $p,$ we have\n\n$$\n\\begin{aligned}\\frac{-19}{5-3p} & =-2 \\\\ -19 & =-2\\cdot (5-3p) \\\\ -19 & =-10+6p \\\\ -19+10 & =6p \\\\ -9 & =6p \\\\ \\frac{-9}{6} & =\\frac{6p}{6} \\\\ -\\frac{3}{2} & =p.\\end{aligned}\n$$\n\nTherefore, we conclude that $p=-\\frac{3}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ffb11692-b94a-52a8-a712-f1575499549c"] :db/ensure [:question/validate]} {:db/id "answer-field-ffb11692-b94a-52a8-a712-f1575499549c" :answer-field/id #uuid "ffb11692-b94a-52a8-a712-f1575499549c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c477754f-139c-565b-8756-f6505de16c44" :answer-field/choices ["answer-230851de-2e37-58e2-83a6-08333ab1a503" "answer-97893439-7f84-5b6b-8ef2-2103da171047" "answer-0a593d74-32d6-5a69-a98b-ba5cb32852de" "answer-c477754f-139c-565b-8756-f6505de16c44" "answer-8afbee44-783e-5d4e-ae7f-0733ea8987a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-230851de-2e37-58e2-83a6-08333ab1a503" :answer/id #uuid "230851de-2e37-58e2-83a6-08333ab1a503" :answer/type :answer.type/math :answer/value "p=-1" :db/ensure [:answer/validate]} {:db/id "answer-97893439-7f84-5b6b-8ef2-2103da171047" :answer/id #uuid "97893439-7f84-5b6b-8ef2-2103da171047" :answer/type :answer.type/math :answer/value "p=-2" :db/ensure [:answer/validate]} {:db/id "answer-0a593d74-32d6-5a69-a98b-ba5cb32852de" :answer/id #uuid "0a593d74-32d6-5a69-a98b-ba5cb32852de" :answer/type :answer.type/math :answer/value "p=-3" :db/ensure [:answer/validate]} {:db/id "answer-c477754f-139c-565b-8756-f6505de16c44" :answer/id #uuid "c477754f-139c-565b-8756-f6505de16c44" :answer/type :answer.type/math :answer/value "p=-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8afbee44-783e-5d4e-ae7f-0733ea8987a4" :answer/id #uuid "8afbee44-783e-5d4e-ae7f-0733ea8987a4" :answer/type :answer.type/math :answer/value "p=-\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "activity-af71ffd9-d2a7-5da4-8d73-f6984dc9c6d5" :activity/id #uuid "af71ffd9-d2a7-5da4-8d73-f6984dc9c6d5" :activity/title "The Average Rate of Change of a Function" :activity/type :activity.type/review :activity/scope 17592186050572 :activity/course 17592186046647 :activity/steps ["step-94f83715-b9d0-5214-9dc7-59839d65afa8" "step-f2c7f57f-4477-5450-97f5-dfadff385e2d" "step-9f4a8224-65c7-50bd-92b8-559516e2b29f"] :activity/first-step "step-94f83715-b9d0-5214-9dc7-59839d65afa8" :db/ensure [:activity/validate]} {:db/id "step-94f83715-b9d0-5214-9dc7-59839d65afa8" :step/id #uuid "94f83715-b9d0-5214-9dc7-59839d65afa8" :step/content 17592186233625 :step/next "step-f2c7f57f-4477-5450-97f5-dfadff385e2d" :db/ensure [:step/validate]} {:db/id "step-f2c7f57f-4477-5450-97f5-dfadff385e2d" :step/id #uuid "f2c7f57f-4477-5450-97f5-dfadff385e2d" :step/content 17592186234251 :step/next "step-9f4a8224-65c7-50bd-92b8-559516e2b29f" :db/ensure [:step/validate]} {:db/id "step-9f4a8224-65c7-50bd-92b8-559516e2b29f" :step/id #uuid "9f4a8224-65c7-50bd-92b8-559516e2b29f" :step/content "question-c6acc05f-c544-5e0c-918b-0d7218132aa6" :db/ensure [:step/validate]} [:db/retract 17592186113610 :answer-field/choices 17592186113612] [:db/retract 17592186113610 :answer-field/choices 17592186113613] [:db/retract 17592186113610 :answer-field/choices 17592186113615] [:db/retract 17592186113508 :answer-field/choices 17592186113509] [:db/retract 17592186113508 :answer-field/choices 17592186113510] [:db/retract 17592186113508 :answer-field/choices 17592186113511] [:db/retract 17592186113508 :answer-field/choices 17592186113512] [:db/retract 17592186113508 :answer-field/choices 17592186113513] {:db/id 17592186115386 :knowledge-point/questions ["question-2c409cd1-fe1f-5e01-a403-dbc5d06f9573" "question-e7a9644a-6597-5c1c-8581-2dcd08c08372" "question-d22af4f5-52e4-5523-b72f-519be01c5f87" "question-8a16b58b-bb85-5099-b69a-a964f563de29" "question-37a31447-f0c5-5a53-afc7-a1edb4864b07"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115387 :knowledge-point/questions ["question-6199f517-7214-5d4f-b510-e7e4d600a748" "question-9a567a48-e070-587a-94df-8a2d7148a763" "question-2cd66931-0513-5d1c-9823-4729248ee301" "question-86cd099b-e0a6-5dec-b63e-d3e60dda2214" "question-e2503fc5-32a5-54fb-be4e-1b9923b33c22"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115389 :knowledge-point/questions ["question-bd1d10fc-2d48-5d8e-aa22-57b49e0e6a49" "question-33768c70-a4a8-56c5-b929-58df88c6ba1b" "question-0e9c7e83-813e-5902-881b-22d16eab32e5" "question-e00ec48a-b851-58e1-a999-f80b28436a4f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2c409cd1-fe1f-5e01-a403-dbc5d06f9573" :question/id #uuid "2c409cd1-fe1f-5e01-a403-dbc5d06f9573" :question/math-academy-id "q-127734" :question/problem "Calculate ${lim}_{t\\to 2}f(t),$ if $f(t)=⟨{e}^{t-2},\\,\\sqrt{6-t},\\,\\frac{3}{t+2}⟩.$" :question/worked-solution "First, recall that\n\n$$\n{lim}_{t\\to 2}f(t)=⟨{lim}_{t\\to 2}{e}^{t-2},\\,{lim}_{t\\to 2}\\sqrt{6-t},\\,{lim}_{t\\to 2}\\frac{3}{t+2}⟩.\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}{e}^{t-2} & ={e}^{2-2} \\\\  & ={e}^{0} \\\\  & =1.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\sqrt{6-t} & =\\sqrt{6-2} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\frac{3}{t+2} & =\\frac{3}{2+2} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nHence, ${lim}_{t\\to 2}f(t)=⟨1,2,\\frac{3}{4}⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8fb29db3-ac82-5b56-ae72-c2f44640f27f"] :db/ensure [:question/validate]} {:db/id "answer-field-8fb29db3-ac82-5b56-ae72-c2f44640f27f" :answer-field/id #uuid "8fb29db3-ac82-5b56-ae72-c2f44640f27f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-17bfca3e-307e-5781-bcef-233b9377631e" :answer-field/choices ["answer-502c5e1c-390a-5709-91ed-47d4584cce04" "answer-17bfca3e-307e-5781-bcef-233b9377631e" "answer-87d95073-b451-52be-860e-7824c423abac" "answer-2fbe2ff0-d6cc-58ae-957f-7ee6c2b531e0" "answer-8def5c03-9698-5566-8421-3e7a87a68af7"] :db/ensure [:answer-field/validate]} {:db/id "answer-502c5e1c-390a-5709-91ed-47d4584cce04" :answer/id #uuid "502c5e1c-390a-5709-91ed-47d4584cce04" :answer/type :answer.type/math :answer/value "⟨1,2,\\frac{1}{4}⟩" :db/ensure [:answer/validate]} {:db/id "answer-17bfca3e-307e-5781-bcef-233b9377631e" :answer/id #uuid "17bfca3e-307e-5781-bcef-233b9377631e" :answer/type :answer.type/math :answer/value "⟨1,2,\\frac{3}{4}⟩" :db/ensure [:answer/validate]} {:db/id "answer-87d95073-b451-52be-860e-7824c423abac" :answer/id #uuid "87d95073-b451-52be-860e-7824c423abac" :answer/type :answer.type/math :answer/value "⟨1,\\frac{1}{2},\\frac{3}{4}⟩" :db/ensure [:answer/validate]} {:db/id "answer-2fbe2ff0-d6cc-58ae-957f-7ee6c2b531e0" :answer/id #uuid "2fbe2ff0-d6cc-58ae-957f-7ee6c2b531e0" :answer/type :answer.type/math :answer/value "⟨2,\\frac{3}{4},1⟩" :db/ensure [:answer/validate]} {:db/id "answer-8def5c03-9698-5566-8421-3e7a87a68af7" :answer/id #uuid "8def5c03-9698-5566-8421-3e7a87a68af7" :answer/type :answer.type/math :answer/value "⟨3,0,\\frac{3}{2}⟩" :db/ensure [:answer/validate]} {:db/id "question-e7a9644a-6597-5c1c-8581-2dcd08c08372" :question/id #uuid "e7a9644a-6597-5c1c-8581-2dcd08c08372" :question/math-academy-id "q-130205" :question/problem "Calculate ${lim}_{s\\to 1}f(s),$ if $f(s)=[\\begin{aligned}\\sqrt{5-s} \\\\ \\frac{{e}^{1-s}}{s} \\\\ (1+5s)^{1-s}\\end{aligned}].$" :question/worked-solution "First, recall that\n\n$$\n{lim}_{s\\to 1}f(s)=[\\begin{aligned}{lim}_{s\\to 1}\\sqrt{5-s} \\\\ {lim}_{s\\to 1}\\frac{{e}^{1-s}}{s} \\\\ {lim}_{s\\to 1}\\,(1+5s)^{1/(2s)}.\\end{aligned}]\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}\\sqrt{5-s} & =\\sqrt{5-1} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}\\frac{{e}^{1-s}}{s}=\\frac{{e}^{1-1}}{1}=1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}\\,(1+5s)^{1-s} & =(1+5\\cdot 1)^{1-1} \\\\  & ={6}^{0} \\\\  & =1.\\end{aligned}\n$$\n\nHence, ${lim}_{s\\to 1}f(s)=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-934d475b-f1bc-5ebd-a7fa-3293dabf3b69"] :db/ensure [:question/validate]} {:db/id "answer-field-934d475b-f1bc-5ebd-a7fa-3293dabf3b69" :answer-field/id #uuid "934d475b-f1bc-5ebd-a7fa-3293dabf3b69" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b92debbe-4905-5cf5-ac7e-54ae5dd148f3" :answer-field/choices ["answer-526b9721-1d50-5045-be99-28fbfc65b137" "answer-8118547b-32c2-5862-a697-3f257283fb92" "answer-14ae2243-a263-5f30-bc1e-4f040a2ebd84" "answer-1238dba3-92d9-5c65-88f6-15a8db8223ec" "answer-b92debbe-4905-5cf5-ac7e-54ae5dd148f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-526b9721-1d50-5045-be99-28fbfc65b137" :answer/id #uuid "526b9721-1d50-5045-be99-28fbfc65b137" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8118547b-32c2-5862-a697-3f257283fb92" :answer/id #uuid "8118547b-32c2-5862-a697-3f257283fb92" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-14ae2243-a263-5f30-bc1e-4f040a2ebd84" :answer/id #uuid "14ae2243-a263-5f30-bc1e-4f040a2ebd84" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1238dba3-92d9-5c65-88f6-15a8db8223ec" :answer/id #uuid "1238dba3-92d9-5c65-88f6-15a8db8223ec" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b92debbe-4905-5cf5-ac7e-54ae5dd148f3" :answer/id #uuid "b92debbe-4905-5cf5-ac7e-54ae5dd148f3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-d22af4f5-52e4-5523-b72f-519be01c5f87" :question/id #uuid "d22af4f5-52e4-5523-b72f-519be01c5f87" :question/math-academy-id "q-130202" :question/problem "Calculate ${lim}_{s\\to 2}f(s)$, if $f(s)=⟨\\frac{5}{{e}^{s-2}},\\,3\\operatorname{cos}⁡(4-2s),\\,{s}^{3}-5⟩.$" :question/worked-solution "First, recall that\n\n$$\n{lim}_{s\\to 2}f(s)=⟨{lim}_{s\\to 2}\\frac{5}{{e}^{s-2}},\\,{lim}_{s\\to 2}3\\operatorname{cos}⁡(4-2s),\\,{lim}_{s\\to 2}\\,({s}^{3}-5)⟩.\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 2}\\frac{5}{{e}^{s-2}} & =\\frac{5}{{e}^{2-2}}=5.\\end{aligned}\n$$\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 2}3\\operatorname{cos}⁡(4-2s) & =3{lim}_{s\\to 2}\\operatorname{cos}⁡(4-2s) \\\\  & =3\\cdot \\operatorname{cos}⁡(4-2\\cdot 2) \\\\  & =3\\cdot \\operatorname{cos}⁡0 \\\\  & =3.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 2}\\,({s}^{3}-5) & ={2}^{3}-5=3.\\end{aligned}\n$$\n\nHence, ${lim}_{s\\to 2}f(s)=⟨5,3,3⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-84e8b7b2-23ed-5a0a-99f0-5172dcf54f18"] :db/ensure [:question/validate]} {:db/id "answer-field-84e8b7b2-23ed-5a0a-99f0-5172dcf54f18" :answer-field/id #uuid "84e8b7b2-23ed-5a0a-99f0-5172dcf54f18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be42811a-f4bf-56a2-abb8-9899f924d1af" :answer-field/choices ["answer-07b010d6-1bf1-5424-be3f-473792bd873e" "answer-2f82b2ed-bb1e-5c79-9b96-dcd0e6db45e3" "answer-21e427fa-5df8-5fc8-ab03-e130781f6c1e" "answer-be42811a-f4bf-56a2-abb8-9899f924d1af" "answer-c3e4948e-79e5-5d75-89f0-87fe6fc505da"] :db/ensure [:answer-field/validate]} {:db/id "answer-07b010d6-1bf1-5424-be3f-473792bd873e" :answer/id #uuid "07b010d6-1bf1-5424-be3f-473792bd873e" :answer/type :answer.type/math :answer/value "⟨1,8,3⟩" :db/ensure [:answer/validate]} {:db/id "answer-2f82b2ed-bb1e-5c79-9b96-dcd0e6db45e3" :answer/id #uuid "2f82b2ed-bb1e-5c79-9b96-dcd0e6db45e3" :answer/type :answer.type/math :answer/value "⟨2,-3,8⟩" :db/ensure [:answer/validate]} {:db/id "answer-21e427fa-5df8-5fc8-ab03-e130781f6c1e" :answer/id #uuid "21e427fa-5df8-5fc8-ab03-e130781f6c1e" :answer/type :answer.type/math :answer/value "⟨3,5,3⟩" :db/ensure [:answer/validate]} {:db/id "answer-be42811a-f4bf-56a2-abb8-9899f924d1af" :answer/id #uuid "be42811a-f4bf-56a2-abb8-9899f924d1af" :answer/type :answer.type/math :answer/value "⟨5,3,3⟩" :db/ensure [:answer/validate]} {:db/id "answer-c3e4948e-79e5-5d75-89f0-87fe6fc505da" :answer/id #uuid "c3e4948e-79e5-5d75-89f0-87fe6fc505da" :answer/type :answer.type/math :answer/value "⟨6,3,-3⟩" :db/ensure [:answer/validate]} {:db/id "question-8a16b58b-bb85-5099-b69a-a964f563de29" :question/id #uuid "8a16b58b-bb85-5099-b69a-a964f563de29" :question/math-academy-id "q-127725" :question/problem "Find the limit ${lim}_{t\\to 0}f(t),$ if $f(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+(t+2)^{2}\\,k.$" :question/worked-solution "First, recall that\n\n$$\n{lim}_{t\\to 0}f(t)=({lim}_{t\\to 0}\\operatorname{sin}⁡t)i+({lim}_{t\\to 0}\\operatorname{cos}⁡t)j+({lim}_{t\\to 0}(t+2)^{2})k.\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\operatorname{sin}⁡t & =\\operatorname{sin}⁡0=0.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\operatorname{cos}⁡0=1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\,(t+2)^{2} & =(0+2)^{2}=4.\\end{aligned}\n$$\n\nHence, ${lim}_{t\\to 0}f(t)=j+4\\,k.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8276de71-5ba4-56fb-966c-b20d81bdc55e"] :db/ensure [:question/validate]} {:db/id "answer-field-8276de71-5ba4-56fb-966c-b20d81bdc55e" :answer-field/id #uuid "8276de71-5ba4-56fb-966c-b20d81bdc55e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e79ab410-d634-5646-bfb0-ece61ffb440f" :answer-field/choices ["answer-f827c61f-b0c2-5eb2-aa99-dfd1a0790afa" "answer-1b00c5fc-121b-578b-aae9-3de39a26ee79" "answer-62b08d41-0939-5d9c-8e45-e87ba0e15a2b" "answer-f6be0740-a62e-58fd-9a09-75e30cd955e9" "answer-e79ab410-d634-5646-bfb0-ece61ffb440f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f827c61f-b0c2-5eb2-aa99-dfd1a0790afa" :answer/id #uuid "f827c61f-b0c2-5eb2-aa99-dfd1a0790afa" :answer/type :answer.type/math :answer/value "2\\,i-j+4\\,k" :db/ensure [:answer/validate]} {:db/id "answer-1b00c5fc-121b-578b-aae9-3de39a26ee79" :answer/id #uuid "1b00c5fc-121b-578b-aae9-3de39a26ee79" :answer/type :answer.type/math :answer/value "3\\,i+j+3\\,k" :db/ensure [:answer/validate]} {:db/id "answer-62b08d41-0939-5d9c-8e45-e87ba0e15a2b" :answer/id #uuid "62b08d41-0939-5d9c-8e45-e87ba0e15a2b" :answer/type :answer.type/math :answer/value "i+2\\,j" :db/ensure [:answer/validate]} {:db/id "answer-f6be0740-a62e-58fd-9a09-75e30cd955e9" :answer/id #uuid "f6be0740-a62e-58fd-9a09-75e30cd955e9" :answer/type :answer.type/math :answer/value "i+4\\,k" :db/ensure [:answer/validate]} {:db/id "answer-e79ab410-d634-5646-bfb0-ece61ffb440f" :answer/id #uuid "e79ab410-d634-5646-bfb0-ece61ffb440f" :answer/type :answer.type/math :answer/value "j+4\\,k" :db/ensure [:answer/validate]} {:db/id "question-37a31447-f0c5-5a53-afc7-a1edb4864b07" :question/id #uuid "37a31447-f0c5-5a53-afc7-a1edb4864b07" :question/math-academy-id "q-32987" :question/problem "Calculate ${lim}_{s\\to 0}f(s)$, if $f(s)=[\\begin{aligned}\\sqrt{s+8} \\\\ \\frac{\\operatorname{arcsin}⁡s}{s} \\\\ (1+2s)^{1/(2s)}\\end{aligned}].$" :question/worked-solution "First, recall that:\n\n$$\n{lim}_{s\\to 0}f(s)=[\\begin{aligned}{lim}_{s\\to 0}\\sqrt{s+8} \\\\ {lim}_{s\\to 0}\\frac{\\operatorname{arcsin}⁡s}{s} \\\\ {lim}_{s\\to 0}(1+2s)^{1/(2s)}\\end{aligned}]\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}\\sqrt{s+8} & =\\sqrt{0+8} \\\\  & =\\sqrt{8} \\\\  & =\\sqrt{{2}^{3}} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\n- The second component can be found using L'Hopital's Rule:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}\\frac{\\operatorname{arcsin}⁡s}{s} & ={lim}_{s\\to 0}\\frac{{(\\operatorname{arcsin}⁡s)}^{′}}{{s}^{′}} \\\\  & ={lim}_{s\\to 0}\\frac{\\frac{1}{\\sqrt{1-{s}^{2}}}}{1} \\\\  & ={lim}_{s\\to 0}\\frac{1}{\\sqrt{1-{s}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1-{0}^{2}}} \\\\  & =1\\end{aligned}\n$$\n\n- The third component can be found using a special limit:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}(1+2s)^{1/(2s)} & ={lim}_{u\\to 0}(1+u)^{1/u}=e\\end{aligned}\n$$\n\nHence, ${lim}_{s\\to 0}f(s)=[\\begin{aligned}2\\sqrt{2} \\\\ 1 \\\\ e\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-84218ae0-ac5d-5acd-ba70-5324cc9dc6e0"] :db/ensure [:question/validate]} {:db/id "answer-field-84218ae0-ac5d-5acd-ba70-5324cc9dc6e0" :answer-field/id #uuid "84218ae0-ac5d-5acd-ba70-5324cc9dc6e0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-58c3f0b4-edb0-5ecc-b12a-48bd5b853604" :answer-field/choices ["answer-e71f20cb-af6e-5fbd-8e27-40edcce524cd" "answer-16f9d3ac-e7ee-5e21-82c1-471755a55162" "answer-58c3f0b4-edb0-5ecc-b12a-48bd5b853604" "answer-fbb22881-51b2-5948-adba-093b2535b458" "answer-3d7dcd81-555d-55d1-a1bb-f7eb9aaa9c08"] :db/ensure [:answer-field/validate]} {:db/id "answer-e71f20cb-af6e-5fbd-8e27-40edcce524cd" :answer/id #uuid "e71f20cb-af6e-5fbd-8e27-40edcce524cd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2\\sqrt{2} \\\\ 0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-16f9d3ac-e7ee-5e21-82c1-471755a55162" :answer/id #uuid "16f9d3ac-e7ee-5e21-82c1-471755a55162" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2\\sqrt{2} \\\\ 0 \\\\ e\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-58c3f0b4-edb0-5ecc-b12a-48bd5b853604" :answer/id #uuid "58c3f0b4-edb0-5ecc-b12a-48bd5b853604" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2\\sqrt{2} \\\\ 1 \\\\ e\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fbb22881-51b2-5948-adba-093b2535b458" :answer/id #uuid "fbb22881-51b2-5948-adba-093b2535b458" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2\\sqrt{2} \\\\ e \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-3d7dcd81-555d-55d1-a1bb-f7eb9aaa9c08" :answer/id #uuid "3d7dcd81-555d-55d1-a1bb-f7eb9aaa9c08" :answer/type :answer.type/math :answer/value "[\\begin{aligned}8 \\\\ 1 \\\\ e\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-6199f517-7214-5d4f-b510-e7e4d600a748" :question/id #uuid "6199f517-7214-5d4f-b510-e7e4d600a748" :question/math-academy-id "q-130211" :question/problem "Calculate ${lim}_{s\\to 1}‖f(s)‖,$ if $f(s)=[\\begin{aligned}\\sqrt{5-s} \\\\ \\frac{{e}^{1-s}}{s} \\\\ (1+5s)^{1-s}\\end{aligned}].$" :question/worked-solution "First, recall that\n\n$$\n{lim}_{s\\to 1}f(s)=[\\begin{aligned}{lim}_{s\\to 1}\\sqrt{5-s} \\\\ {lim}_{s\\to 1}\\frac{{e}^{1-s}}{1-s} \\\\ {lim}_{s\\to 1}\\,(1+5s)^{1/(2s)}\\end{aligned}].\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}\\sqrt{5-s} & =\\sqrt{5-1} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}\\frac{{e}^{1-s}}{s}=\\frac{1}{1}=1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}\\,(1+5s)^{1-s} & =(1+5\\cdot 1)^{1-1}=1.\\end{aligned}\n$$\n\nHence, ${lim}_{s\\to 1}f(s)=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}].$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $1$ is\n\n$$\n\\begin{aligned}{lim}_{s\\to 1}‖f(s)‖ & =‖{lim}_{s\\to 1}f(s)‖ \\\\  & =‖[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]‖ \\\\  & =\\sqrt{{2}^{2}+{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8dbde469-aa7e-5bcb-a66c-2dae3c6fa5e6"] :db/ensure [:question/validate]} {:db/id "answer-field-8dbde469-aa7e-5bcb-a66c-2dae3c6fa5e6" :answer-field/id #uuid "8dbde469-aa7e-5bcb-a66c-2dae3c6fa5e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b5d6b95a-ada9-5465-b9fb-5a72172eca4a" :answer-field/choices ["answer-a7554a6f-0aea-5a5a-9c28-e56e4d345ff6" "answer-a396a767-5b66-5bd2-8cc1-072e21a93b90" "answer-f06540a4-643a-5da8-a809-4757dd6f0a17" "answer-b5d6b95a-ada9-5465-b9fb-5a72172eca4a" "answer-e4fb20f9-8aa7-571a-9473-7ce075be4841"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7554a6f-0aea-5a5a-9c28-e56e4d345ff6" :answer/id #uuid "a7554a6f-0aea-5a5a-9c28-e56e4d345ff6" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-a396a767-5b66-5bd2-8cc1-072e21a93b90" :answer/id #uuid "a396a767-5b66-5bd2-8cc1-072e21a93b90" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f06540a4-643a-5da8-a809-4757dd6f0a17" :answer/id #uuid "f06540a4-643a-5da8-a809-4757dd6f0a17" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-b5d6b95a-ada9-5465-b9fb-5a72172eca4a" :answer/id #uuid "b5d6b95a-ada9-5465-b9fb-5a72172eca4a" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-e4fb20f9-8aa7-571a-9473-7ce075be4841" :answer/id #uuid "e4fb20f9-8aa7-571a-9473-7ce075be4841" :answer/type :answer.type/math :answer/value "\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "question-9a567a48-e070-587a-94df-8a2d7148a763" :question/id #uuid "9a567a48-e070-587a-94df-8a2d7148a763" :question/math-academy-id "q-32976" :question/problem "Calculate ${lim}_{s\\to 0}‖f(s)‖$, if $f(s)=[\\begin{aligned}\\frac{s}{(s+1)^{2}} \\\\ \\frac{{sin}^{2}⁡s}{{s}^{2}} \\\\ \\frac{1-\\operatorname{cos}⁡s}{2{s}^{2}}\\end{aligned}]\\,.$" :question/worked-solution "First, recall that:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}f(s) & =[\\begin{aligned}{lim}_{s\\to 0}\\frac{s}{(s+1)^{2}} \\\\ {lim}_{s\\to 0}\\frac{{sin}^{2}⁡s}{{s}^{2}} \\\\ {lim}_{s\\to 0}\\frac{1-\\operatorname{cos}⁡s}{2{s}^{2}}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}\\frac{s}{(s+1)^{2}} & =\\frac{0}{(0+1)^{2}}=0\\end{aligned}\n$$\n\n- The second component can be found using a special limit:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}\\frac{{sin}^{2}⁡s}{{s}^{2}} & ={lim}_{s\\to 0}{(\\frac{\\operatorname{sin}⁡s}{s})}^{2} \\\\  & ={({lim}_{s\\to 0}\\frac{\\operatorname{sin}⁡s}{s})}^{2} \\\\  & ={1}^{2} \\\\  & =1\\end{aligned}\n$$\n\n- The third component can be found using L'Hopital's Rule twice:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}\\frac{1-\\operatorname{cos}⁡s}{2{s}^{2}} & ={lim}_{s\\to 0}\\frac{{(1-\\operatorname{cos}⁡s)}^{″}}{{(2{s}^{2})}^{″}} \\\\  & ={lim}_{s\\to 0}\\frac{\\operatorname{cos}⁡s}{4} \\\\  & =\\frac{\\operatorname{cos}⁡0}{4} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$\n\nHence, ${lim}_{s\\to 0}f(s)=[\\begin{aligned}0 \\\\ 1 \\\\ 1/4\\end{aligned}]\\,.$\n\nFinally, the limit of $‖f(s)‖$ as $s$ approaches $0$ is:\n\n$$\n\\begin{aligned}{lim}_{s\\to 0}‖f(s)‖ & =‖{lim}_{s\\to 0}f(s)‖ \\\\  & =‖[\\begin{aligned}0 \\\\ 1 \\\\ 1/4\\end{aligned}]‖ \\\\  & =\\sqrt{{0}^{2}+{1}^{2}+{(\\frac{1}{4})}^{2}} \\\\  & =\\sqrt{\\frac{17}{16}} \\\\  & =\\frac{\\sqrt{17}}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a738fbe9-b746-555f-a431-6ff37c754328"] :db/ensure [:question/validate]} {:db/id "answer-field-a738fbe9-b746-555f-a431-6ff37c754328" :answer-field/id #uuid "a738fbe9-b746-555f-a431-6ff37c754328" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c5495620-9d83-5275-9d56-bcfc0407808d" :answer-field/choices ["answer-60f53833-01a7-51b3-b367-c22fe50326ff" "answer-e0f6b4d0-5d37-52d1-8795-c9a0b9d298d3" "answer-206b7aff-d2d1-5f6a-add6-b653f58dc164" "answer-c5495620-9d83-5275-9d56-bcfc0407808d" "answer-a0d74bba-4689-5ebb-920d-944005be742c"] :db/ensure [:answer-field/validate]} {:db/id "answer-60f53833-01a7-51b3-b367-c22fe50326ff" :answer/id #uuid "60f53833-01a7-51b3-b367-c22fe50326ff" :answer/type :answer.type/math :answer/value "\\frac{17}{16}" :db/ensure [:answer/validate]} {:db/id "answer-e0f6b4d0-5d37-52d1-8795-c9a0b9d298d3" :answer/id #uuid "e0f6b4d0-5d37-52d1-8795-c9a0b9d298d3" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-206b7aff-d2d1-5f6a-add6-b653f58dc164" :answer/id #uuid "206b7aff-d2d1-5f6a-add6-b653f58dc164" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{15}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-c5495620-9d83-5275-9d56-bcfc0407808d" :answer/id #uuid "c5495620-9d83-5275-9d56-bcfc0407808d" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{17}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-a0d74bba-4689-5ebb-920d-944005be742c" :answer/id #uuid "a0d74bba-4689-5ebb-920d-944005be742c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{2}" :db/ensure [:answer/validate]} {:db/id "question-2cd66931-0513-5d1c-9823-4729248ee301" :question/id #uuid "2cd66931-0513-5d1c-9823-4729248ee301" :question/math-academy-id "q-32979" :question/problem "Find the limit ${lim}_{t\\to 1}‖f(t)‖$, if $f(t)=\\frac{4+t}{5}\\,i+\\frac{\\operatorname{sin}⁡(t-1)}{{t}^{2}-1}\\,j+\\sqrt{9t}\\,k.$" :question/worked-solution "First, recall that:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}f(t) & =({lim}_{t\\to 1}\\frac{4+t}{5})\\,i+({lim}_{t\\to 1}\\frac{\\operatorname{sin}⁡(t-1)}{{t}^{2}-1})\\,j+({lim}_{t\\to 1}\\sqrt{9t})\\,k\\end{aligned}\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}\\frac{4+t}{5} & =\\frac{4+1}{5}=1\\end{aligned}\n$$\n\n- The second component can be found using a special limit:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}\\frac{\\operatorname{sin}⁡(t-1)}{{t}^{2}-1} & ={lim}_{t\\to 1}\\frac{\\operatorname{sin}⁡(t-1)}{(t-1)(t+1)} \\\\  & =({lim}_{t\\to 1}\\frac{1}{t+1})\\cdot ({lim}_{t\\to 1}\\frac{\\operatorname{sin}⁡(t-1)}{t-1}) \\\\  & =(\\frac{1}{1+1})\\cdot 1 \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\n- For the third component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}\\sqrt{9t} & =\\sqrt{9(1)}=3\\end{aligned}\n$$\n\nHence, ${lim}_{t\\to 1}f(t)=i+\\frac{1}{2}\\,j+3\\,k.$\n\nFinally, the limit of $‖f(t)‖$ as $t$ approaches $1$ is:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}‖f(t)‖ & =‖{lim}_{t\\to 1}f(t)‖ \\\\  & =‖i+\\frac{1}{2}\\,j+3\\,k‖ \\\\  & =\\sqrt{{1}^{2}+{(\\frac{1}{2})}^{2}+{3}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{4}+9} \\\\  & =\\sqrt{\\frac{41}{4}} \\\\  & =\\frac{\\sqrt{41}}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d1f9bfc4-206c-5615-9e86-3cd20425df2f"] :db/ensure [:question/validate]} {:db/id "answer-field-d1f9bfc4-206c-5615-9e86-3cd20425df2f" :answer-field/id #uuid "d1f9bfc4-206c-5615-9e86-3cd20425df2f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e4967a7e-ba74-5964-80d2-08e8ecb2bbc2" :answer-field/choices ["answer-d146c1fe-0d81-525c-ab3e-04de8c098617" "answer-4d2524ac-5a9e-5166-a59a-c4b1cc71b052" "answer-830ff5aa-499a-5e23-8b6c-9f66271ff7d0" "answer-e4967a7e-ba74-5964-80d2-08e8ecb2bbc2" "answer-4696a05b-aa71-5436-909d-4ad6cc69953d"] :db/ensure [:answer-field/validate]} {:db/id "answer-d146c1fe-0d81-525c-ab3e-04de8c098617" :answer/id #uuid "d146c1fe-0d81-525c-ab3e-04de8c098617" :answer/type :answer.type/math :answer/value "\\frac{39}{4}" :db/ensure [:answer/validate]} {:db/id "answer-4d2524ac-5a9e-5166-a59a-c4b1cc71b052" :answer/id #uuid "4d2524ac-5a9e-5166-a59a-c4b1cc71b052" :answer/type :answer.type/math :answer/value "\\frac{41}{4}" :db/ensure [:answer/validate]} {:db/id "answer-830ff5aa-499a-5e23-8b6c-9f66271ff7d0" :answer/id #uuid "830ff5aa-499a-5e23-8b6c-9f66271ff7d0" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{39}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e4967a7e-ba74-5964-80d2-08e8ecb2bbc2" :answer/id #uuid "e4967a7e-ba74-5964-80d2-08e8ecb2bbc2" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{41}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4696a05b-aa71-5436-909d-4ad6cc69953d" :answer/id #uuid "4696a05b-aa71-5436-909d-4ad6cc69953d" :answer/type :answer.type/math :answer/value "\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "question-86cd099b-e0a6-5dec-b63e-d3e60dda2214" :question/id #uuid "86cd099b-e0a6-5dec-b63e-d3e60dda2214" :question/math-academy-id "q-69728" :question/problem "Calculate ${lim}_{t\\to 3}‖f(t)‖$, if $f(t)=[\\begin{aligned}{t}^{2}-3t \\\\ \\frac{1}{{t}^{2}-8} \\\\ 5-2t\\end{aligned}].$" :question/worked-solution "First, recall that:\n\n$$\n{lim}_{t\\to 3}f(t)=[\\begin{aligned}{lim}_{t\\to 3}({t}^{2}-3t) \\\\ {lim}_{t\\to 3}\\frac{1}{{t}^{2}-8} \\\\ {lim}_{t\\to 3}(5-2t)\\end{aligned}]\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 3}({t}^{2}-3t) & ={3}^{2}-3(3)=0\\end{aligned}\n$$\n\n- For the second component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 3}\\frac{1}{{t}^{2}-8} & =\\frac{1}{{3}^{2}-8}=1\\end{aligned}\n$$\n\n- For the third component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 3}(5-2t) & =5-2(3)=-1\\end{aligned}\n$$\n\nHence, ${lim}_{t\\to 3}f(t)=[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}].$\n\nFinally, the limit of $‖f(t)‖$ as $t$ approaches $3$ is\n\n$$\n\\begin{aligned}{lim}_{t\\to 3}‖f(t)‖ & =‖{lim}_{t\\to 3}f(t)‖ \\\\  & =‖[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]‖ \\\\  & =\\sqrt{{0}^{2}+{1}^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c84f65d5-7aae-5814-8581-c9fd5f811b31"] :db/ensure [:question/validate]} {:db/id "answer-field-c84f65d5-7aae-5814-8581-c9fd5f811b31" :answer-field/id #uuid "c84f65d5-7aae-5814-8581-c9fd5f811b31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-343f0047-5e45-5525-a95d-3d82e6459514" :answer-field/choices ["answer-cb7e9cb6-5c59-5664-9b12-adadc37bf320" "answer-343f0047-5e45-5525-a95d-3d82e6459514" "answer-c8baf397-fb31-54b6-9eeb-ba95d1df79e3" "answer-2100df4f-3a3b-55cc-a852-f5c980aced39" "answer-94d0189d-b6e8-5ec0-91a7-24c6aa1126d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb7e9cb6-5c59-5664-9b12-adadc37bf320" :answer/id #uuid "cb7e9cb6-5c59-5664-9b12-adadc37bf320" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-343f0047-5e45-5525-a95d-3d82e6459514" :answer/id #uuid "343f0047-5e45-5525-a95d-3d82e6459514" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-c8baf397-fb31-54b6-9eeb-ba95d1df79e3" :answer/id #uuid "c8baf397-fb31-54b6-9eeb-ba95d1df79e3" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-2100df4f-3a3b-55cc-a852-f5c980aced39" :answer/id #uuid "2100df4f-3a3b-55cc-a852-f5c980aced39" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-94d0189d-b6e8-5ec0-91a7-24c6aa1126d6" :answer/id #uuid "94d0189d-b6e8-5ec0-91a7-24c6aa1126d6" :answer/type :answer.type/math :answer/value "\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "question-e2503fc5-32a5-54fb-be4e-1b9923b33c22" :question/id #uuid "e2503fc5-32a5-54fb-be4e-1b9923b33c22" :question/math-academy-id "q-130214" :question/problem "Find the limit $\\,{lim}_{t\\to 0}‖f(t)‖,$ if $f(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+(t+2)^{2}\\,k.$" :question/worked-solution "First, recall that\n\n$$\n{lim}_{t\\to 0}f(t)=({lim}_{t\\to 0}\\operatorname{sin}⁡t)i+({lim}_{t\\to 0}\\operatorname{cos}⁡t)j+({lim}_{t\\to 0}(t+2)^{2})k.\n$$\n\nNow, we find the limits one by one.\n\n- For the first component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\operatorname{sin}⁡t & =\\operatorname{sin}⁡0=0.\\end{aligned}\n$$\n\n- For the second component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\operatorname{cos}⁡0=1.\\end{aligned}\n$$\n\n- For the third component, we have\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}\\,(t+2)^{2} & =(0+2)^{2}=4.\\end{aligned}\n$$\n\nHence, ${lim}_{t\\to 0}f(t)=j+4\\,k.$\n\nFinally, the limit of $‖f(t)‖$ as $t$ approaches $0$ is\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}‖f(t)‖ & =‖{lim}_{t\\to 0}f(t)‖ \\\\  & =‖j+4\\,k‖ \\\\  & =\\sqrt{{1}^{2}+{4}^{2}} \\\\  & =\\sqrt{17}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1e315895-d72c-57a7-afdc-8b9e80c82011"] :db/ensure [:question/validate]} {:db/id "answer-field-1e315895-d72c-57a7-afdc-8b9e80c82011" :answer-field/id #uuid "1e315895-d72c-57a7-afdc-8b9e80c82011" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-da5b2088-8a89-5d89-85f1-998f57543e12" :answer-field/choices ["answer-6b1e462f-0fdb-5ac8-9d5a-a2cd343788a3" "answer-7b02dac2-3766-5b1d-ac19-4a68e0d2e58c" "answer-4d97c90b-cd25-5463-946f-99b8a6ec2eec" "answer-da5b2088-8a89-5d89-85f1-998f57543e12" "answer-e71055d1-1a13-57e4-884a-be0ba2d1be55"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b1e462f-0fdb-5ac8-9d5a-a2cd343788a3" :answer/id #uuid "6b1e462f-0fdb-5ac8-9d5a-a2cd343788a3" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "answer-7b02dac2-3766-5b1d-ac19-4a68e0d2e58c" :answer/id #uuid "7b02dac2-3766-5b1d-ac19-4a68e0d2e58c" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-4d97c90b-cd25-5463-946f-99b8a6ec2eec" :answer/id #uuid "4d97c90b-cd25-5463-946f-99b8a6ec2eec" :answer/type :answer.type/math :answer/value "3\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id "answer-da5b2088-8a89-5d89-85f1-998f57543e12" :answer/id #uuid "da5b2088-8a89-5d89-85f1-998f57543e12" :answer/type :answer.type/math :answer/value "\\sqrt{17}" :db/ensure [:answer/validate]} {:db/id "answer-e71055d1-1a13-57e4-884a-be0ba2d1be55" :answer/id #uuid "e71055d1-1a13-57e4-884a-be0ba2d1be55" :answer/type :answer.type/math :answer/value "\\sqrt{7}" :db/ensure [:answer/validate]} {:db/id 17592186115388 :knowledge-point/questions ["question-7d74654a-36dd-50ce-be7e-dc0c748c4dcb" "question-2e0611fa-e2b7-5168-b829-407939c6ea09" "question-b9ad6ae2-908f-5e67-9c92-f2b932e8cd1f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7d74654a-36dd-50ce-be7e-dc0c748c4dcb" :question/id #uuid "7d74654a-36dd-50ce-be7e-dc0c748c4dcb" :question/math-academy-id "q-69736" :question/problem "Find ${lim}_{t\\to \\infty }[g(t)+2f(t)]$ given that $f(t)$ and $g(t)$ are defined as follows:\n\n$$\n\\begin{aligned}f(t) & =\\frac{{t}^{2}}{1-{t}^{2}}\\,i+(1+\\frac{1}{t})\\,j+{t}^{-2}\\,k \\\\ g(t) & =2\\,i+{e}^{-t}\\,j+{(1+\\frac{1}{t})}^{t}\\,k\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\infty }f(t) & =({lim}_{t\\to \\infty }\\frac{{t}^{2}}{1-{t}^{2}})\\,i+({lim}_{t\\to \\infty }(1+\\frac{1}{t}))\\,j-({lim}_{t\\to \\infty }{t}^{-2})\\,k, \\\\ {lim}_{t\\to \\infty }g(t) & =({lim}_{t\\to \\infty }2)\\,i-({lim}_{t\\to \\infty }{e}^{-t})\\,j+({lim}_{t\\to \\infty }{(1+\\frac{1}{t})}^{t})\\,k.\\end{aligned}\n$$\n\nLet's find the limits one-by-one.\n\n$$\n\\begin{aligned} & {lim}_{t\\to \\infty }\\frac{{t}^{2}}{1-{t}^{2}}={lim}_{t\\to \\infty }\\frac{1}{\\frac{1}{{t}^{2}}-1}=-1 \\\\  & {lim}_{t\\to \\infty }(1+\\frac{1}{t})=1+{lim}_{t\\to \\infty }\\frac{1}{t}=1 \\\\  & {lim}_{t\\to \\infty }{t}^{-2}={lim}_{t\\to \\infty }\\frac{1}{{t}^{2}}=0 \\\\  & {lim}_{t\\to \\infty }2=2 \\\\  & {lim}_{t\\to \\infty }{e}^{-t}=0 \\\\  & {lim}_{t\\to \\infty }{(1+\\frac{1}{t})}^{t}=e\\end{aligned}\n$$\n\nSo, we get:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\infty }f(t) & =-1\\,i+1\\,j+0\\,k \\\\  & =-i+j, \\\\ {lim}_{t\\to \\infty }g(t) & =2\\,i+0\\,j+e\\,k \\\\  & =2\\,i+e\\,k.\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\infty }[g(t)+2f(t)] & ={lim}_{t\\to \\infty }g(t)+2{lim}_{t\\to \\infty }f(t) \\\\  & =(2\\,i+e\\,k)+2(-i+j) \\\\  & =2j+e\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f149eee6-2250-502c-8bd6-58d081055e65"] :db/ensure [:question/validate]} {:db/id "answer-field-f149eee6-2250-502c-8bd6-58d081055e65" :answer-field/id #uuid "f149eee6-2250-502c-8bd6-58d081055e65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-197c2f63-1083-5901-8e61-bfcf01463d0b" :answer-field/choices ["answer-71e370b0-a033-516b-ac92-3d2a5f4e8fe2" "answer-197c2f63-1083-5901-8e61-bfcf01463d0b" "answer-917a3dde-c5a6-52e4-a99f-41cfccafc5ed" "answer-b5a29a28-e998-5dd3-a0ec-234ddb1be820" "answer-6f8f006f-3832-5387-87b5-aeddea710ee9"] :db/ensure [:answer-field/validate]} {:db/id "answer-71e370b0-a033-516b-ac92-3d2a5f4e8fe2" :answer/id #uuid "71e370b0-a033-516b-ac92-3d2a5f4e8fe2" :answer/type :answer.type/math :answer/value "2i+j+(e+2)\\,k" :db/ensure [:answer/validate]} {:db/id "answer-197c2f63-1083-5901-8e61-bfcf01463d0b" :answer/id #uuid "197c2f63-1083-5901-8e61-bfcf01463d0b" :answer/type :answer.type/math :answer/value "2j+e\\,k" :db/ensure [:answer/validate]} {:db/id "answer-917a3dde-c5a6-52e4-a99f-41cfccafc5ed" :answer/id #uuid "917a3dde-c5a6-52e4-a99f-41cfccafc5ed" :answer/type :answer.type/math :answer/value "3i+2j+e\\,k" :db/ensure [:answer/validate]} {:db/id "answer-b5a29a28-e998-5dd3-a0ec-234ddb1be820" :answer/id #uuid "b5a29a28-e998-5dd3-a0ec-234ddb1be820" :answer/type :answer.type/math :answer/value "i+(e+2)\\,k" :db/ensure [:answer/validate]} {:db/id "answer-6f8f006f-3832-5387-87b5-aeddea710ee9" :answer/id #uuid "6f8f006f-3832-5387-87b5-aeddea710ee9" :answer/type :answer.type/math :answer/value "i+2j+e\\,k" :db/ensure [:answer/validate]} {:db/id "question-2e0611fa-e2b7-5168-b829-407939c6ea09" :question/id #uuid "2e0611fa-e2b7-5168-b829-407939c6ea09" :question/math-academy-id "q-130314" :question/problem "Find ${lim}_{t\\to 0}[f(t)+4g(t)]$ given that $f(t)$ and $g(t)$ are defined as\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}3{e}^{t} \\\\ \\operatorname{tan}⁡t \\\\ \\frac{{t}^{2}+9}{t+3}\\end{aligned}],\\,g(t)=[\\begin{aligned}t-2 \\\\ \\frac{3t-2}{{t}^{2}-1} \\\\ {2}^{t}\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t) & =[\\begin{aligned}{lim}_{t\\to 0}3{e}^{t} \\\\ {lim}_{t\\to 0}\\operatorname{tan}⁡t \\\\ {lim}_{t\\to 0}\\frac{{t}^{2}+9}{t+3}\\end{aligned}]=[\\begin{aligned}3{e}^{0} \\\\ \\operatorname{tan}⁡0 \\\\ \\frac{{0}^{2}+9}{0+3}\\end{aligned}]=[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}] \\\\ {lim}_{t\\to 0}g(t) & =[\\begin{aligned}{lim}_{t\\to 0}\\,(t-2) \\\\ {lim}_{t\\to 0}\\frac{3t-2}{{t}^{2}-1} \\\\ {lim}_{t\\to 0}{2}^{t}\\end{aligned}]=[\\begin{aligned}0-2 \\\\ \\frac{3(0)-2}{{0}^{2}-1} \\\\ {2}^{0}\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}[f(t)+4g(t)] & ={lim}_{t\\to 0}f(t)+4{lim}_{t\\to 0}g(t) \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}]+4[\\begin{aligned}-2 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}]+[\\begin{aligned}-8 \\\\ 8 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}-5 \\\\ 8 \\\\ 7\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7abde80b-69ef-507f-b94f-bbbd90c33e11"] :db/ensure [:question/validate]} {:db/id "answer-field-7abde80b-69ef-507f-b94f-bbbd90c33e11" :answer-field/id #uuid "7abde80b-69ef-507f-b94f-bbbd90c33e11" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-25f2c083-595e-5fcf-8705-992e3499809e" :answer-field/choices ["answer-f15462a2-749c-5944-bb07-7d5e7d74d1ef" "answer-b85451f7-8926-5daf-a871-fbd1b79aa49e" "answer-ac2ab553-7e7d-50fd-b187-d9032a06e4bd" "answer-25f2c083-595e-5fcf-8705-992e3499809e" "answer-aadcbce8-c359-50f5-aca1-5c3b876cfa99"] :db/ensure [:answer-field/validate]} {:db/id "answer-f15462a2-749c-5944-bb07-7d5e7d74d1ef" :answer/id #uuid "f15462a2-749c-5944-bb07-7d5e7d74d1ef" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-11 \\\\ -8 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b85451f7-8926-5daf-a871-fbd1b79aa49e" :answer/id #uuid "b85451f7-8926-5daf-a871-fbd1b79aa49e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ac2ab553-7e7d-50fd-b187-d9032a06e4bd" :answer/id #uuid "ac2ab553-7e7d-50fd-b187-d9032a06e4bd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 6 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-25f2c083-595e-5fcf-8705-992e3499809e" :answer/id #uuid "25f2c083-595e-5fcf-8705-992e3499809e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 \\\\ 8 \\\\ 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-aadcbce8-c359-50f5-aca1-5c3b876cfa99" :answer/id #uuid "aadcbce8-c359-50f5-aca1-5c3b876cfa99" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186115774 :question/problem "Find ${lim}_{t\\to 0}[3f(t)-g(t)]$ given that\n$f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t) & =⟨\\operatorname{cos}⁡t,{t}^{2}-2,\\frac{t-3}{{t}^{2}+1}⟩ \\\\ g(t) & =⟨\\operatorname{sin}⁡t,\\sqrt{t}+\\sqrt{2},2⟩\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t) & =⟨{lim}_{t\\to 0}(\\operatorname{cos}⁡t),\\,{lim}_{t\\to 0}({t}^{2}-2),\\,{lim}_{t\\to 0}(\\frac{t-3}{{t}^{2}+1})⟩ \\\\  & =⟨\\operatorname{cos}⁡0,{0}^{2}-2,\\frac{0-3}{{0}^{2}+1}⟩ \\\\  & =⟨1,-2,-3⟩ \\\\ {lim}_{t\\to 0}g(t) & =⟨{lim}_{t\\to 0}(\\operatorname{sin}⁡t),\\,{lim}_{t\\to 0}(\\sqrt{t}+\\sqrt{2}),\\,{lim}_{t\\to 0}(2)⟩ \\\\  & =⟨\\operatorname{sin}⁡0,\\sqrt{0}+\\sqrt{2},2⟩ \\\\  & =⟨0,\\sqrt{2},2⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}[3f(t)-g(t)] & ={lim}_{t\\to 0}3f(t)-{lim}_{t\\to 0}g(t) \\\\  & =3{lim}_{t\\to 0}f(t)-{lim}_{t\\to 0}g(t) \\\\  & =3⟨1,-2,-3⟩-⟨0,\\sqrt{2},2⟩ \\\\  & =⟨3,-6,-9⟩-⟨0,\\sqrt{2},2⟩ \\\\  & =⟨3-0,-6-\\sqrt{2},-9-2⟩ \\\\  & =⟨3,-6-\\sqrt{2},-11⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186113610 :answer-field/correct "answer-e79ae4b9-769d-5736-8cb4-dfec47ef6427" :answer-field/choices ["answer-dead4f12-ca88-5ad3-a931-528e8d88c330" "answer-e79ae4b9-769d-5736-8cb4-dfec47ef6427" "answer-7cd4211b-e621-58bc-80fd-e9a6165b6884"] :db/ensure [:answer-field/validate]} {:db/id "answer-dead4f12-ca88-5ad3-a931-528e8d88c330" :answer/id #uuid "dead4f12-ca88-5ad3-a931-528e8d88c330" :answer/type :answer.type/math :answer/value "⟨-3,6+\\sqrt{2},11⟩" :db/ensure [:answer/validate]} {:db/id "answer-e79ae4b9-769d-5736-8cb4-dfec47ef6427" :answer/id #uuid "e79ae4b9-769d-5736-8cb4-dfec47ef6427" :answer/type :answer.type/math :answer/value "⟨3,-6-\\sqrt{2},-11⟩" :db/ensure [:answer/validate]} {:db/id "answer-7cd4211b-e621-58bc-80fd-e9a6165b6884" :answer/id #uuid "7cd4211b-e621-58bc-80fd-e9a6165b6884" :answer/type :answer.type/math :answer/value "⟨3,6,11⟩" :db/ensure [:answer/validate]} {:db/id 17592186115757 :question/problem "Find ${lim}_{t\\to 1}[5f(t)+2g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t) & =⟨{t}^{2},{t}^{3},\\frac{1}{{t}^{2}}⟩ \\\\ g(t) & =⟨5-{t}^{3},{t}^{2}-t+2,4⟩\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}f(t) & =⟨{lim}_{t\\to 1}({t}^{2}),\\,{lim}_{t\\to 1}({t}^{3}),\\,{lim}_{t\\to 1}(\\frac{1}{{t}^{2}})⟩ \\\\  & =⟨{1}^{2},{1}^{3},\\frac{1}{{1}^{2}}⟩ \\\\  & =⟨1,1,1⟩ \\\\ {lim}_{t\\to 1}g(t) & =⟨{lim}_{t\\to 1}(5-{t}^{3}),\\,{lim}_{t\\to 1}({t}^{2}-t+2),\\,{lim}_{t\\to 1}(4)⟩ \\\\  & =⟨5-{1}^{3},{1}^{2}-1+2,4⟩ \\\\  & =⟨4,2,4⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}[5f(t)+2g(t)] & ={lim}_{t\\to 1}5f(t)+{lim}_{t\\to 1}2g(t) \\\\  & =5{lim}_{t\\to 1}f(t)+2{lim}_{t\\to 1}g(t) \\\\  & =5⟨1,1,1⟩+2⟨4,2,4⟩ \\\\  & =⟨5,5,5⟩+⟨8,4,8⟩ \\\\  & =⟨13,9,13⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186113508 :answer-field/correct "answer-37bbc342-deb2-5c62-b5f4-4c2ab96ccd4e" :answer-field/choices ["answer-37bbc342-deb2-5c62-b5f4-4c2ab96ccd4e" "answer-c0e423a8-fc07-5848-a11c-d74f2340c97d" "answer-4bbf07ed-8d8c-58e9-8f86-748f6bc62fb9" "answer-662e9f3a-b518-5488-a346-0c63d5a3acbf" "answer-32f93cd8-2b18-5b9c-aa26-87db0d6e56ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-37bbc342-deb2-5c62-b5f4-4c2ab96ccd4e" :answer/id #uuid "37bbc342-deb2-5c62-b5f4-4c2ab96ccd4e" :answer/type :answer.type/math :answer/value "⟨13,9,13⟩" :db/ensure [:answer/validate]} {:db/id "answer-c0e423a8-fc07-5848-a11c-d74f2340c97d" :answer/id #uuid "c0e423a8-fc07-5848-a11c-d74f2340c97d" :answer/type :answer.type/math :answer/value "⟨5,5,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-4bbf07ed-8d8c-58e9-8f86-748f6bc62fb9" :answer/id #uuid "4bbf07ed-8d8c-58e9-8f86-748f6bc62fb9" :answer/type :answer.type/math :answer/value "⟨8,4,8⟩" :db/ensure [:answer/validate]} {:db/id "answer-662e9f3a-b518-5488-a346-0c63d5a3acbf" :answer/id #uuid "662e9f3a-b518-5488-a346-0c63d5a3acbf" :answer/type :answer.type/math :answer/value "⟨8,8,8⟩" :db/ensure [:answer/validate]} {:db/id "answer-32f93cd8-2b18-5b9c-aa26-87db0d6e56ce" :answer/id #uuid "32f93cd8-2b18-5b9c-aa26-87db0d6e56ce" :answer/type :answer.type/math :answer/value "⟨9,13,9⟩" :db/ensure [:answer/validate]} {:db/id "question-b9ad6ae2-908f-5e67-9c92-f2b932e8cd1f" :question/id #uuid "b9ad6ae2-908f-5e67-9c92-f2b932e8cd1f" :question/math-academy-id "q-69730" :question/problem "Find ${lim}_{t\\to 0}[f(t)+g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}{t}^{2} \\\\ {e}^{t} \\\\ \\frac{\\operatorname{sin}⁡t}{t}\\end{aligned}],\\,g(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ 1 \\\\ \\frac{2t-1}{{t}^{2}+1}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t)=[\\begin{aligned}{lim}_{t\\to 0}{t}^{2} \\\\ {lim}_{t\\to 0}{e}^{t} \\\\ {lim}_{t\\to 0}\\frac{\\operatorname{sin}⁡t}{t}\\end{aligned}]=[\\begin{aligned}{0}^{2} \\\\ {e}^{0} \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNote that the third component is a special limit.\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}g(t)=[\\begin{aligned}{lim}_{t\\to 0}\\operatorname{cos}⁡t \\\\ {lim}_{t\\to 0}1 \\\\ {lim}_{t\\to 0}\\frac{2t-1}{{t}^{2}+1}\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡0 \\\\ 1 \\\\ \\frac{2(0)-1}{{0}^{2}+1})\\end{aligned}]=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}[f(t)+g(t)] & ={lim}_{t\\to 0}f(t)+{lim}_{t\\to 0}g(t) \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1a9b9373-bdb4-5460-8dab-9626078627ed"] :db/ensure [:question/validate]} {:db/id "answer-field-1a9b9373-bdb4-5460-8dab-9626078627ed" :answer-field/id #uuid "1a9b9373-bdb4-5460-8dab-9626078627ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e1b88bd-51e6-5eb2-949f-71b11846824d" :answer-field/choices ["answer-0df3defd-3254-5256-8de1-8bab9ab5c062" "answer-78285f75-cb3b-5911-b998-4b1257c89e6e" "answer-7b8c9926-eedb-56f1-bea0-3e8216b12c98" "answer-d51fe666-cdc2-5a8b-9abc-7c4c02e5d063" "answer-2e1b88bd-51e6-5eb2-949f-71b11846824d"] :db/ensure [:answer-field/validate]} {:db/id "answer-0df3defd-3254-5256-8de1-8bab9ab5c062" :answer/id #uuid "0df3defd-3254-5256-8de1-8bab9ab5c062" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-78285f75-cb3b-5911-b998-4b1257c89e6e" :answer/id #uuid "78285f75-cb3b-5911-b998-4b1257c89e6e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7b8c9926-eedb-56f1-bea0-3e8216b12c98" :answer/id #uuid "7b8c9926-eedb-56f1-bea0-3e8216b12c98" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d51fe666-cdc2-5a8b-9abc-7c4c02e5d063" :answer/id #uuid "d51fe666-cdc2-5a8b-9abc-7c4c02e5d063" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2e1b88bd-51e6-5eb2-949f-71b11846824d" :answer/id #uuid "2e1b88bd-51e6-5eb2-949f-71b11846824d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-bd1d10fc-2d48-5d8e-aa22-57b49e0e6a49" :question/id #uuid "bd1d10fc-2d48-5d8e-aa22-57b49e0e6a49" :question/math-academy-id "q-130321" :question/problem "Find ${lim}_{t\\to 2}[f(t)\\times g(t)]$ given that $f(t)$ and $g(t)$ are defined as\n\n$$\n\\begin{aligned}f(t) & =⟨6-{t}^{3},\\,{t}^{2}-6,\\,\\frac{16}{{t}^{3}}⟩, \\\\ g(t) & =⟨5-\\operatorname{ln}⁡(3-t),\\,\\sqrt{6-t},\\,2t⟩.\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}f(t) & =⟨{lim}_{t\\to 2}\\,(6-{t}^{3}),\\,{lim}_{t\\to 2}\\,({t}^{2}-6),\\,{lim}_{t\\to 2}\\frac{16}{{t}^{3}}⟩ \\\\  & =⟨6-{2}^{3},{2}^{2}-6,\\frac{16}{{2}^{3}}⟩ \\\\  & =⟨-2,-2,2⟩ \\\\ {lim}_{t\\to 2}g(t) & =⟨{lim}_{t\\to 2}\\,(5-\\operatorname{ln}⁡(3-t)),\\,{lim}_{t\\to 2}\\,\\sqrt{6-t},\\,{lim}_{t\\to 2}\\,2t⟩ \\\\  & =⟨5-\\operatorname{ln}⁡(3-2),\\sqrt{6-2},2(2)⟩ \\\\  & =⟨5,2,4⟩\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}[f(t)\\times g(t)] & ={lim}_{t\\to 2}f(t)\\times {lim}_{t\\to 2}g(t) \\\\  & =⟨-2,-2,2⟩\\times ⟨5,2,4⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ -2 & -2 & 2 \\\\ 5 & 2 & 4\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 2 \\\\ 2 & 4\\end{aligned}|i-|\\begin{aligned}-2 & 2 \\\\ 5 & 4\\end{aligned}|j+|\\begin{aligned}-2 & -2 \\\\ 5 & 2\\end{aligned}|k \\\\  & =((-2)\\cdot 4-2\\cdot 2)\\,i-((-2)\\cdot 4-5\\cdot 2)\\,j+((-2)\\cdot 2-5\\cdot (-2))\\,k \\\\  & =-12\\,i+18\\,j+6\\,k \\\\  & =⟨-12,18,6⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4a9c7ac2-4c78-5bd6-ac32-375910d4abbb"] :db/ensure [:question/validate]} {:db/id "answer-field-4a9c7ac2-4c78-5bd6-ac32-375910d4abbb" :answer-field/id #uuid "4a9c7ac2-4c78-5bd6-ac32-375910d4abbb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7eacfd82-115e-5369-9ea0-e0661e38dc5a" :answer-field/choices ["answer-7eacfd82-115e-5369-9ea0-e0661e38dc5a" "answer-37a1710a-45e4-557c-9442-1e74ba9112ce" "answer-e9e869f0-043f-53a7-9d36-e47ddd23102f" "answer-3f8fd679-95eb-5199-ba6a-a1cfb67ca9ca" "answer-bbc42210-6e93-5e95-b495-30f65a2b1ba3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7eacfd82-115e-5369-9ea0-e0661e38dc5a" :answer/id #uuid "7eacfd82-115e-5369-9ea0-e0661e38dc5a" :answer/type :answer.type/math :answer/value "⟨-12,18,6⟩" :db/ensure [:answer/validate]} {:db/id "answer-37a1710a-45e4-557c-9442-1e74ba9112ce" :answer/id #uuid "37a1710a-45e4-557c-9442-1e74ba9112ce" :answer/type :answer.type/math :answer/value "⟨-18,12,6⟩" :db/ensure [:answer/validate]} {:db/id "answer-e9e869f0-043f-53a7-9d36-e47ddd23102f" :answer/id #uuid "e9e869f0-043f-53a7-9d36-e47ddd23102f" :answer/type :answer.type/math :answer/value "⟨-2,8,6⟩" :db/ensure [:answer/validate]} {:db/id "answer-3f8fd679-95eb-5199-ba6a-a1cfb67ca9ca" :answer/id #uuid "3f8fd679-95eb-5199-ba6a-a1cfb67ca9ca" :answer/type :answer.type/math :answer/value "⟨12,8,9⟩" :db/ensure [:answer/validate]} {:db/id "answer-bbc42210-6e93-5e95-b495-30f65a2b1ba3" :answer/id #uuid "bbc42210-6e93-5e95-b495-30f65a2b1ba3" :answer/type :answer.type/math :answer/value "⟨5,2,4⟩" :db/ensure [:answer/validate]} {:db/id "question-33768c70-a4a8-56c5-b929-58df88c6ba1b" :question/id #uuid "33768c70-a4a8-56c5-b929-58df88c6ba1b" :question/math-academy-id "q-78268" :question/problem "Find the limit ${lim}_{t\\to 1}[f(t)\\cdot g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}\\frac{\\operatorname{ln}⁡t}{t-1} \\\\ \\frac{2\\operatorname{cos}⁡\\pi t}{t} \\\\ \\frac{2\\operatorname{sin}⁡\\pi t}{t}\\end{aligned}],\\,g(t)=[\\begin{aligned}\\frac{{t}^{2}-2t+1}{t+1} \\\\ \\frac{\\operatorname{ln}⁡t+t}{t+1} \\\\ \\frac{{e}^{t+1}}{t+1}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}f(t) & =[\\begin{aligned}{lim}_{t\\to 1}\\,(\\frac{\\operatorname{ln}⁡t}{t-1}) \\\\ {lim}_{t\\to 1}\\,(\\frac{2\\operatorname{cos}⁡\\pi t}{t}) \\\\ {lim}_{t\\to 1}\\,(\\frac{2\\operatorname{sin}⁡\\pi t}{t})\\end{aligned}]=[\\begin{aligned}{lim}_{t\\to 1}\\,(\\frac{(\\operatorname{ln}⁡t)^{′}}{(t-1)^{′}}) \\\\ {lim}_{t\\to 1}\\,(\\frac{2\\operatorname{cos}⁡\\pi t}{t}) \\\\ {lim}_{t\\to 1}\\,(\\frac{2\\operatorname{sin}⁡\\pi t}{t})\\end{aligned}]=[\\begin{aligned}{lim}_{t\\to 1}\\,(\\frac{1}{t}) \\\\ \\frac{2\\operatorname{cos}⁡\\pi }{1} \\\\ \\frac{2\\operatorname{sin}⁡\\pi }{1}\\end{aligned}]=[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nNote that for the first component of ${lim}_{t\\to 1}f(t)$ we used L'Hopital's Rule.\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}g(t) & =[\\begin{aligned}{lim}_{t\\to 1}\\,\\frac{{t}^{2}-2t+1}{t+1} \\\\ {lim}_{t\\to 1}\\,\\frac{\\operatorname{ln}⁡t+t}{t+1} \\\\ {lim}_{t\\to 1}\\,\\frac{{e}^{t+1}}{t+1}\\end{aligned}]=[\\begin{aligned}\\frac{{1}^{2}-2\\cdot 1+1}{1+1} \\\\ \\frac{\\operatorname{ln}⁡1+1}{1+1} \\\\ \\frac{{e}^{1+1}}{1+1}\\end{aligned}]=[\\begin{aligned}0 \\\\ \\frac{1}{2} \\\\ \\frac{{e}^{2}}{2}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 1}[f(t)\\cdot g(t)] & ={lim}_{t\\to 1}f(t)\\cdot {lim}_{t\\to 1}g(t) \\\\  & =[\\begin{aligned}1 \\\\ -2 \\\\ 0\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ \\frac{1}{2} \\\\ \\frac{{e}^{2}}{2}\\end{aligned}] \\\\  & =1\\cdot 0+(-2)\\cdot \\frac{1}{2}+0\\cdot \\frac{{e}^{2}}{2} \\\\  & =-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b24006f7-dcb6-5a3e-962f-d3babb6d995e"] :db/ensure [:question/validate]} {:db/id "answer-field-b24006f7-dcb6-5a3e-962f-d3babb6d995e" :answer-field/id #uuid "b24006f7-dcb6-5a3e-962f-d3babb6d995e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-873d5f29-f5c3-5d96-8997-2e96d20efdab" :answer-field/choices ["answer-873d5f29-f5c3-5d96-8997-2e96d20efdab" "answer-8ccbdb14-9c0c-5f46-a3d4-ae2fd1da959c" "answer-920aaecc-64b5-5927-be63-43fbf263f51a" "answer-5f6847e3-eb2c-5cc6-9cd0-83733cfef02d" "answer-4e7082bf-94bc-5f95-a646-926615cd1b1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-873d5f29-f5c3-5d96-8997-2e96d20efdab" :answer/id #uuid "873d5f29-f5c3-5d96-8997-2e96d20efdab" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-8ccbdb14-9c0c-5f46-a3d4-ae2fd1da959c" :answer/id #uuid "8ccbdb14-9c0c-5f46-a3d4-ae2fd1da959c" :answer/type :answer.type/math :answer/value "-{e}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-920aaecc-64b5-5927-be63-43fbf263f51a" :answer/id #uuid "920aaecc-64b5-5927-be63-43fbf263f51a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-5f6847e3-eb2c-5cc6-9cd0-83733cfef02d" :answer/id #uuid "5f6847e3-eb2c-5cc6-9cd0-83733cfef02d" :answer/type :answer.type/math :answer/value "1-\\frac{{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4e7082bf-94bc-5f95-a646-926615cd1b1a" :answer/id #uuid "4e7082bf-94bc-5f95-a646-926615cd1b1a" :answer/type :answer.type/math :answer/value "\\frac{1-{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "question-0e9c7e83-813e-5902-881b-22d16eab32e5" :question/id #uuid "0e9c7e83-813e-5902-881b-22d16eab32e5" :question/math-academy-id "q-78269" :question/problem "Find the limit ${lim}_{t\\to 0}[f(t)\\cdot g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t) & =⟨\\frac{{t}^{2}-2t+2}{t+1},\\,\\frac{\\operatorname{sin}⁡(2t)}{t},\\,t\\operatorname{sin}⁡t⟩ \\\\ g(t) & =⟨\\frac{{e}^{2t}-1}{t},\\,1-\\operatorname{cos}⁡t,\\,t+1⟩\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t) & =⟨{lim}_{t\\to 0}\\frac{{t}^{2}-2t+2}{t+1},\\,{lim}_{t\\to 0}\\frac{\\operatorname{sin}⁡(2t)}{t},\\,{lim}_{t\\to 0}t\\operatorname{sin}⁡t⟩ \\\\  & =⟨{lim}_{t\\to 0}\\frac{{t}^{2}-2t+2}{t+1},\\,2{lim}_{t\\to 0}\\frac{\\operatorname{sin}⁡(2t)}{(2t)},\\,{lim}_{t\\to 0}t\\operatorname{sin}⁡t⟩ \\\\  & =⟨\\frac{{0}^{2}-2\\cdot 0+2}{0+1},\\,2\\cdot 1,\\,0\\cdot \\operatorname{sin}⁡0⟩ \\\\  & =⟨2,2,0⟩\\end{aligned}\n$$\n\nNote that for the second component of ${lim}_{t\\to 0}f(t)$ we used a special limit ${lim}_{u\\to 0}\\frac{\\operatorname{sin}⁡u}{u}=1.$\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}g(t) & =⟨{lim}_{t\\to 0}\\frac{{e}^{2t}-1}{t},\\,{lim}_{t\\to 0}(1-\\operatorname{cos}⁡t),\\,{lim}_{t\\to 0}(t+1)⟩ \\\\  & =⟨{lim}_{t\\to 0}\\frac{({e}^{2t}-1)^{′}}{(t)^{′}},\\,{lim}_{t\\to 0}(1-\\operatorname{cos}⁡t),\\,{lim}_{t\\to 0}(t+1)⟩ \\\\  & =⟨{lim}_{t\\to 0}\\frac{2{e}^{2t}}{1},\\,{lim}_{t\\to 0}(1-\\operatorname{cos}⁡t),\\,{lim}_{t\\to 0}(t+1)⟩ \\\\  & =⟨2{e}^{0},\\,1-\\operatorname{cos}⁡0,\\,0+1⟩ \\\\  & =⟨2,0,1⟩\\end{aligned}\n$$\n\nNote that for the first component of ${lim}_{t\\to 0}g(t)$ we used L'Hopital's Rule.\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}[f(t)\\cdot g(t)] & ={lim}_{t\\to 0}f(t)\\cdot {lim}_{t\\to 0}g(t) \\\\  & =⟨2,\\,2,\\,0⟩\\cdot ⟨2,0,1⟩ \\\\  & =2\\cdot 2+2\\cdot 0+0\\cdot 1 \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fa331f7b-2a1a-5cc2-9b0b-49206016e7e3"] :db/ensure [:question/validate]} {:db/id "answer-field-fa331f7b-2a1a-5cc2-9b0b-49206016e7e3" :answer-field/id #uuid "fa331f7b-2a1a-5cc2-9b0b-49206016e7e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dfc4555a-8d25-52bb-84f7-9a18b8237849" :answer-field/choices ["answer-0e7b3ee8-302c-5bb1-a016-50116576c2f2" "answer-7f679746-4683-54bf-906e-e3418d6fd20d" "answer-dfc4555a-8d25-52bb-84f7-9a18b8237849" "answer-a18cb561-1016-5b60-a141-a208ee290e53" "answer-9a621fae-e013-5531-ad51-a186fffabdb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-0e7b3ee8-302c-5bb1-a016-50116576c2f2" :answer/id #uuid "0e7b3ee8-302c-5bb1-a016-50116576c2f2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-7f679746-4683-54bf-906e-e3418d6fd20d" :answer/id #uuid "7f679746-4683-54bf-906e-e3418d6fd20d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-dfc4555a-8d25-52bb-84f7-9a18b8237849" :answer/id #uuid "dfc4555a-8d25-52bb-84f7-9a18b8237849" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-a18cb561-1016-5b60-a141-a208ee290e53" :answer/id #uuid "a18cb561-1016-5b60-a141-a208ee290e53" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-9a621fae-e013-5531-ad51-a186fffabdb1" :answer/id #uuid "9a621fae-e013-5531-ad51-a186fffabdb1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-e00ec48a-b851-58e1-a999-f80b28436a4f" :question/id #uuid "e00ec48a-b851-58e1-a999-f80b28436a4f" :question/math-academy-id "q-130317" :question/problem "Find the limit ${lim}_{t\\to 0}[f(t)\\cdot g(t)]$ given that $f(t)$ and $g(t)$ are defined as\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}3{e}^{t} \\\\ \\operatorname{tan}⁡t \\\\ \\frac{{t}^{2}+9}{t+3}\\end{aligned}],\\,g(t)=[\\begin{aligned}t-2 \\\\ \\frac{3t-2}{{t}^{2}-1} \\\\ {2}^{t}\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t) & =[\\begin{aligned}{lim}_{t\\to 0}3{e}^{t} \\\\ {lim}_{t\\to 0}\\operatorname{tan}⁡t \\\\ {lim}_{t\\to 0}\\frac{{t}^{2}+9}{t+3}\\end{aligned}]=[\\begin{aligned}3{e}^{0} \\\\ \\operatorname{tan}⁡0 \\\\ \\frac{{0}^{2}+9}{0+3}\\end{aligned}]=[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}] \\\\ {lim}_{t\\to 0}g(t) & =[\\begin{aligned}{lim}_{t\\to 0}\\,(t-2) \\\\ {lim}_{t\\to 0}\\frac{3t-2}{{t}^{2}-1} \\\\ {lim}_{t\\to 0}{2}^{t}\\end{aligned}]=[\\begin{aligned}0-2 \\\\ \\frac{3(0)-2}{{0}^{2}-1} \\\\ {2}^{0}\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}[f(t)\\cdot g(t)] & ={lim}_{t\\to 0}f(t)\\cdot {lim}_{t\\to 0}g(t) \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =3(-2)+0(2)+3(1) \\\\  & =-3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-df762a5a-9fee-5f06-a818-ced60d8cdc38"] :db/ensure [:question/validate]} {:db/id "answer-field-df762a5a-9fee-5f06-a818-ced60d8cdc38" :answer-field/id #uuid "df762a5a-9fee-5f06-a818-ced60d8cdc38" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-67f4a994-694a-52fa-9687-ee0e3b608236" :answer-field/choices ["answer-67f4a994-694a-52fa-9687-ee0e3b608236" "answer-76d89423-c5cf-587f-afc3-f3c4191d18a9" "answer-7247832d-b063-5bbc-a125-48edef9b555a" "answer-374e28b1-9d60-5567-9006-2366cebd20ac" "answer-bc1fe512-d096-5581-975f-b0f625e130b3"] :db/ensure [:answer-field/validate]} {:db/id "answer-67f4a994-694a-52fa-9687-ee0e3b608236" :answer/id #uuid "67f4a994-694a-52fa-9687-ee0e3b608236" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-76d89423-c5cf-587f-afc3-f3c4191d18a9" :answer/id #uuid "76d89423-c5cf-587f-afc3-f3c4191d18a9" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-7247832d-b063-5bbc-a125-48edef9b555a" :answer/id #uuid "7247832d-b063-5bbc-a125-48edef9b555a" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-374e28b1-9d60-5567-9006-2366cebd20ac" :answer/id #uuid "374e28b1-9d60-5567-9006-2366cebd20ac" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-bc1fe512-d096-5581-975f-b0f625e130b3" :answer/id #uuid "bc1fe512-d096-5581-975f-b0f625e130b3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186115759 :question/problem "Find the limit ${lim}_{t\\to \\pi }[f(t)\\cdot g(t)]$ given that $f(t)$ and $g(t)$ are defined as:\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ 1+\\operatorname{cos}⁡t \\\\ \\frac{4t}{\\pi }\\end{aligned}],\\,g(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ 2+\\operatorname{tan}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "First, we find the limit of each function:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\pi }f(t) & =[\\begin{aligned}{lim}_{t\\to \\pi }\\,(\\operatorname{sin}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(1+\\operatorname{cos}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(\\frac{4t}{\\pi })\\end{aligned}]=[\\begin{aligned}\\operatorname{sin}⁡\\pi  \\\\ 1+\\operatorname{cos}⁡\\pi  \\\\ \\frac{4\\pi }{\\pi }\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 4\\end{aligned}] \\\\ {lim}_{t\\to \\pi }g(t) & =[\\begin{aligned}{lim}_{t\\to \\pi }\\,(\\operatorname{cos}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(2+\\operatorname{tan}⁡t) \\\\ {lim}_{t\\to \\pi }\\,(\\operatorname{cos}⁡t)\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡\\pi  \\\\ (2+\\operatorname{tan}⁡\\pi ) \\\\ \\operatorname{cos}⁡\\pi \\end{aligned}]=[\\begin{aligned}-1 \\\\ 2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we use properties of limits to calculate the final result:\n\n$$\n\\begin{aligned}{lim}_{t\\to \\pi }[f(t)\\cdot g(t)] & ={lim}_{t\\to \\pi }f(t)\\cdot {lim}_{t\\to \\pi }g(t) \\\\  & =[\\begin{aligned}0 \\\\ 0 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}-1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =0\\cdot (-1)+0\\cdot 2+4\\cdot (-1) \\\\  & =-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186113520 :answer-field/correct 17592186113523 :db/ensure [:answer-field/validate]} {:db/id 17592186116437 :tutorial/content "To find the limit of a vector function, we compute the limit of each component individually. So, if $\\mathbf f (t) = x(t) \\ \\mathbf {i} + y(t) \\ \\mathbf {j} +z(t) \\ \\mathbf {k}$ is our vector function, then the limit is computed as follows:\n\n$$\n\\displaystyle \\lim_{t\\to a} \\mathbf f (t) = \\bigg[ \\lim_{t \\to a} x(t) \\bigg] \\mathbf {i} + \\bigg[ \\lim_{t \\to a}y(t) \\bigg] \\mathbf {j} +\\bigg[ \\lim_{t \\to a}z(t) \\bigg] \\mathbf {k}\n$$\n\nThe limit on the left exists *if and only if* all the limits on the right exist too.\n\nFor example, suppose we are given the vector function\n\n$$\n\\mathbf f (t) = \\left( 5+t \\right) \\ \\mathbf {i} +  (t^{2}-1) \\ \\mathbf {j} + \\sin{t} \\ \\mathbf {k},\n$$\n\nand we want to compute the limit $\\lim\\limits_{t \\to 0} \\mathbf f (t).$ To do this, we find the limit of each component function as follows:\n\n$$\n\\begin{aligned}{lim}_{t\\to 0}f(t) & =[\\,{{{lim}_{t\\to 0}(5+t)}_{⏟}}_{=\\,5}\\,]i+[\\,{{{lim}_{t\\to 0}({t}^{2}-1)\\,}_{⏟}}_{=\\,-1}]j+[\\,{{{lim}_{t\\to 0}\\operatorname{sin}⁡t\\,}_{⏟}}_{=\\,0}]k \\\\  & =5\\text{ }i+(-1)\\text{ }j+0\\text{ }k \\\\  & =⟨5,\\,-1,\\,0⟩\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186116438 :tutorial/content "Many properties of limits of scalar functions extend naturally to limits of vector functions. For instance, if $\\mathbf f(t)$ and $\\mathbf g(t)$ are vector functions and $p,q$ are constants, then\n\n$$\n\\lim_{t \\to a}\\left[p \\ \\mathbf f(t) + q \\ \\mathbf g(t)\\right] =  p \\ \\lim_{t \\to a}\\mathbf f(t) + q \\ \\lim_{t \\to a}\\mathbf g(t).\n$$\n\nWe also have the following property for the magnitude:\n\n$$\n\\begin{aligned}{lim}_{t\\to a}‖f(t)‖ & =‖{lim}_{t\\to a}f(t)‖,\\end{aligned}\n$$\n\nwhere $\\left\\| \\mathbf f(t) \\right\\|$ denotes the magnitude of the vector $\\mathbf f(t)$." :db/ensure [:tutorial/validate]} {:db/id 17592186116439 :tutorial/content "For two vector functions, the limit of a product is equal to the product of the limits:\n\n$$\n\\begin{aligned}{lim}_{t\\to a}[f(t)\\cdot g(t)] & ={lim}_{t\\to a}f(t)\\cdot {lim}_{t\\to a}g(t) \\\\ {lim}_{t\\to a}[f(t)\\times g(t)] & ={lim}_{t\\to a}f(t)\\times {lim}_{t\\to a}g(t)\\end{aligned}\n$$\n\nHere, $\\mathbf f(t)\\cdot \\mathbf g(t)$ and $\\mathbf f(t) \\times \\mathbf g(t)$ are the dot product and the cross product of $\\mathbf f(t)$ and $\\mathbf g(t),$ respectively." :db/ensure [:tutorial/validate]} {:db/id 17592186115485 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186124437 :knowledge-point/questions ["question-4e141666-84d5-5edd-9a4e-a7cb3e788f33"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/id #uuid "4e141666-84d5-5edd-9a4e-a7cb3e788f33" :question/math-academy-id "q-132581" :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $x=2.$ Given that the point $P$ with $y$-coordinate $\\frac{\\pi }{4}$ lies on $C$, and that ${f}_{y}=y\\operatorname{sin}⁡(xy-\\frac{\\pi }{3})$, find the slope of the tangent to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=2.$ Hence, the slope of the tangent to the curve $C$ at the point where $y=\\frac{\\pi }{4}$ will be given by the partial derivative ${f}_{y}(2,\\frac{\\pi }{4}).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(2,\\frac{\\pi }{4}):$ \n\n$$\n\\begin{aligned}{f}_{y}(2,\\frac{\\pi }{4}) & =\\frac{\\pi }{4}\\cdot \\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}-\\frac{\\pi }{3}) \\\\  & =\\frac{\\pi }{4}\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\pi }{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{\\pi }{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bd0c0893-97b7-5c87-8979-00978834031e"] :db/ensure [:question/validate]} {:db/id "answer-field-bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/id #uuid "bd0c0893-97b7-5c87-8979-00978834031e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer-field/choices ["answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" "answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" "answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" "answer-8af33f3e-47b0-5222-adb2-0e369970c083" "answer-647eb414-70e2-51df-bace-381aeabfab1b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/id #uuid "5e6dbddc-14bc-525e-8243-43d97f13d5de" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/id #uuid "a03c2c09-7f10-51f5-b6e9-049c1b7317c5" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/id #uuid "c9bdd2b2-810c-5ef0-84b0-8ece0783d384" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8af33f3e-47b0-5222-adb2-0e369970c083" :answer/id #uuid "8af33f3e-47b0-5222-adb2-0e369970c083" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "answer-647eb414-70e2-51df-bace-381aeabfab1b" :answer/id #uuid "647eb414-70e2-51df-bace-381aeabfab1b" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{8}" :db/ensure [:answer/validate]} {:db/id 17592186124438 :knowledge-point/questions ["question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/id #uuid "bd4791a4-a5ea-5e12-b1c8-f45a53372bd0" :question/math-academy-id "q-71214" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=\\frac{\\pi }{2}.$ Given that the point $P(1,\\frac{\\pi }{2},0)$ lies on $C$, and that ${f}_{x}=2\\operatorname{sin}⁡(xy)-x\\operatorname{cos}⁡y$, find the equations of the tangent line to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=\\frac{\\pi }{2}.$ Hence, the slope of the tangent to the curve at the point $P(1,\\frac{\\pi }{2},0)$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(1,\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})} & =2\\operatorname{sin}⁡(1\\cdot \\frac{\\pi }{2})-1\\cdot \\operatorname{cos}⁡\\frac{\\pi }{2} \\\\  & =2\\cdot 1-1\\cdot 0 \\\\  & =2\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(1,\\frac{\\pi }{2})} & =\\frac{∂z}{∂x}{|}_{(1,\\frac{\\pi }{2})}(x-1) \\\\ z-0 & =2(x-1) \\\\ z & =2x-2\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(1,\\frac{\\pi }{2},0)$ can be given as the intersection of two planes, as follows:\n\n$$\n\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc"] :db/ensure [:question/validate]} {:db/id "answer-field-d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/id #uuid "d2ed29c1-ef21-57a0-9839-78668465edfc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer-field/choices ["answer-1f196182-837a-5bce-a183-aadf810b7f54" "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" "answer-1df674f5-22d1-57e9-8542-daec656270b9" "answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" "answer-54faae86-df4c-5126-b41f-7bacd23c8482"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f196182-837a-5bce-a183-aadf810b7f54" :answer/id #uuid "1f196182-837a-5bce-a183-aadf810b7f54" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/id #uuid "76b72c1f-3222-52aa-ba57-d8ef2a3b29a2" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=2x-2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-1df674f5-22d1-57e9-8542-daec656270b9" :answer/id #uuid "1df674f5-22d1-57e9-8542-daec656270b9" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=3x-3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/id #uuid "4d8b41aa-822d-5816-ad83-338eb5cc1486" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=x-1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "answer-54faae86-df4c-5126-b41f-7bacd23c8482" :answer/id #uuid "54faae86-df4c-5126-b41f-7bacd23c8482" :answer/type :answer.type/math :answer/value "\\{\\begin{aligned}y=\\frac{\\pi }{2} \\\\ z=x-2\\end{aligned}" :db/ensure [:answer/validate]} {:db/id 17592186124439 :knowledge-point/questions ["question-19ce6755-ce5c-5344-86b9-dca6271615dd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-19ce6755-ce5c-5344-86b9-dca6271615dd" :question/id #uuid "19ce6755-ce5c-5344-86b9-dca6271615dd" :question/math-academy-id "q-132608" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=0.$ Given that the point $P(\\frac{1}{2},0,1)$ lies on $C$, and that ${f}_{x}=(y+1)\\operatorname{cos}⁡(\\pi x)+2x\\operatorname{cos}⁡(\\pi y)\\operatorname{sin}⁡(\\pi x)$, which of the following gives a tangent vector to $C$ at $P?$" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $y=0.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(\\frac{1}{2},0).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(\\frac{1}{2},0):$\n\n$$\n\\begin{aligned}{f}_{x}(\\frac{1}{2},0) & =(0+1)\\operatorname{cos}⁡(\\pi \\cdot \\frac{1}{2})+2(\\frac{1}{2})\\operatorname{cos}⁡(\\pi \\cdot 0)\\operatorname{sin}⁡(\\pi \\cdot \\frac{1}{2}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(0)\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =0+1 \\\\  & =1\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(\\frac{1}{2},0) & ={f}_{x}(\\frac{1}{2},0)(x-\\frac{1}{2}) \\\\ z-1 & =1(x-\\frac{1}{2}) \\\\ z-1 & =x-\\frac{1}{2} \\\\ z & =x+\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(\\frac{1}{2},0,1)$ can be given as the intersection of two planes:\n\n$$\n\\{\\begin{aligned}y=0 \\\\ z=x+\\frac{1}{2}\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=0,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=x+\\frac{1}{2}$ (or $x-z+\\frac{1}{2}=0$), a normal vector to the plane is ${n}_{2}=⟨1,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨1,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}\\right| \\\\  & =-i-k\\end{aligned}\n$$\n\nFinally, since $-i-k$ is parallel to the tangent line, then $-(-i-k)=i+k$ is also parallel to it." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc"] :db/ensure [:question/validate]} {:db/id "answer-field-3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/id #uuid "3db3d25b-6794-5819-bf20-9d7f989372fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer-field/choices ["answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" "answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" "answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" "answer-e312bb41-87f9-5deb-9841-5b5f28418294" "answer-e72b0968-76fc-5d45-85c7-a1f5300ad455"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/id #uuid "fa10a00d-f989-5e31-96e2-3b5966e8e36b" :answer/type :answer.type/math :answer/value "2\\,i+k" :db/ensure [:answer/validate]} {:db/id "answer-3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/id #uuid "3a92a5b0-f742-5f72-9fed-2fa17746b3d7" :answer/type :answer.type/math :answer/value "3\\,i-2\\,k" :db/ensure [:answer/validate]} {:db/id "answer-fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/id #uuid "fc7c1f10-9c81-523f-bfa3-f0d613a444d5" :answer/type :answer.type/math :answer/value "i+2\\,k" :db/ensure [:answer/validate]} {:db/id "answer-e312bb41-87f9-5deb-9841-5b5f28418294" :answer/id #uuid "e312bb41-87f9-5deb-9841-5b5f28418294" :answer/type :answer.type/math :answer/value "i+k" :db/ensure [:answer/validate]} {:db/id "answer-e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/id #uuid "e72b0968-76fc-5d45-85c7-a1f5300ad455" :answer/type :answer.type/math :answer/value "i-k" :db/ensure [:answer/validate]} {:db/id 17592186179680 :knowledge-point/questions ["question-351787b8-999c-59c8-b44f-8fe6c60247fb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186180296 :question/problem "Find the real solution to the equation $2(x+4)^{3}=686.$" :question/worked-solution "We can solve this equation by isolating the $(x+4)^{3}$ term and then taking the $3$rd root of each side.\n\nFirst, let's isolate the $(x+4)^{3}$ term on the left-hand side:\n\n$$\n\\begin{aligned}2(x+4)^{3} & =686 \\\\ (x+4)^{3} & =343\\end{aligned}\n$$\n\nNow, we take the $3$rd root of each side and solve for $x.$ Since $n=3$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x+4)^{3} & =343 \\\\ \\sqrt[3]{(x+4)^{3}} & =\\sqrt[3]{343} \\\\ x+4 & =\\sqrt[3]{{7}^{3}} \\\\ x+4 & =7 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the solution is $x=3.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186179320 :answer-field/correct 17592186179321 :db/ensure [:answer-field/validate]} {:db/id 17592186179681 :knowledge-point/questions ["question-ee997e26-088f-52b1-8913-d296b8992e92"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ee997e26-088f-52b1-8913-d296b8992e92" :question/id #uuid "ee997e26-088f-52b1-8913-d296b8992e92" :question/math-academy-id "q-91348" :question/problem "Find the real solution to the equation ${x}^{7}=-\\frac{1}{128}.$" :question/worked-solution "We can solve this equation by taking the $7$th root of each side and solving for $x.$ Since $n=7$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}{x}^{7} & =-\\frac{1}{128} \\\\ \\sqrt[7]{{x}^{7}} & =\\sqrt[7]{(-\\frac{1}{128})} \\\\ x & =\\sqrt[7]{{(-\\frac{1}{2})}^{7}} \\\\ x & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution is $x=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-76b0b8d7-ead0-5e0b-96f7-c011cf47b3ce"] :db/ensure [:question/validate]} {:db/id "answer-field-76b0b8d7-ead0-5e0b-96f7-c011cf47b3ce" :answer-field/id #uuid "76b0b8d7-ead0-5e0b-96f7-c011cf47b3ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-097ae540-a1c3-563f-958f-879f687d07c8" :answer-field/choices ["answer-7356e8b2-c698-5246-b83e-adcafee91941" "answer-097ae540-a1c3-563f-958f-879f687d07c8" "answer-27ed339f-1ba9-5371-b98d-4f3e5a4957d9" "answer-4b16ec7e-f0ec-57c4-b0d0-1fe68110981c" "answer-7375c3cd-5447-5289-b4b3-d26964bf0961"] :db/ensure [:answer-field/validate]} {:db/id "answer-7356e8b2-c698-5246-b83e-adcafee91941" :answer/id #uuid "7356e8b2-c698-5246-b83e-adcafee91941" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-097ae540-a1c3-563f-958f-879f687d07c8" :answer/id #uuid "097ae540-a1c3-563f-958f-879f687d07c8" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-27ed339f-1ba9-5371-b98d-4f3e5a4957d9" :answer/id #uuid "27ed339f-1ba9-5371-b98d-4f3e5a4957d9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-4b16ec7e-f0ec-57c4-b0d0-1fe68110981c" :answer/id #uuid "4b16ec7e-f0ec-57c4-b0d0-1fe68110981c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-7375c3cd-5447-5289-b4b3-d26964bf0961" :answer/id #uuid "7375c3cd-5447-5289-b4b3-d26964bf0961" :answer/type :answer.type/text :answer/value "There is no real solution" :db/ensure [:answer/validate]} {:db/id "question-351787b8-999c-59c8-b44f-8fe6c60247fb" :question/id #uuid "351787b8-999c-59c8-b44f-8fe6c60247fb" :question/math-academy-id "q-91369" :question/problem "Find the real solution to the equation $(x-3)^{7}=-128.$" :question/worked-solution "We can solve this equation by taking the $7$th root of each side and solving for $x.$\nSince $n=7$ is odd, there is only one real solution to this equation:\n\n$$\n\\begin{aligned}(x-3)^{7} & =-128 \\\\ \\sqrt[7]{(x-3)^{7}} & =\\sqrt[7]{-128} \\\\ x-3 & =\\sqrt[7]{(-2)^{7}} \\\\ x-3 & =-2 \\\\ x & =1\\end{aligned}\n$$\n\nTherefore, the solution is $x=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8dda18e4-efa2-53cb-b386-72e8b9f7b0ad"] :db/ensure [:question/validate]} {:db/id "answer-field-8dda18e4-efa2-53cb-b386-72e8b9f7b0ad" :answer-field/id #uuid "8dda18e4-efa2-53cb-b386-72e8b9f7b0ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a22620b9-3627-519a-9fcf-882b66fb2509" :answer-field/choices ["answer-51605067-0787-53ee-aaf2-ba1451c7298b" "answer-2c8f8e6f-e697-5bb7-bf75-2e4331631d5d" "answer-a22620b9-3627-519a-9fcf-882b66fb2509" "answer-6fcb20f0-7b84-5ab6-9881-9ca58e2d8984" "answer-25486f62-97da-5109-9737-87f525d30db1"] :db/ensure [:answer-field/validate]} {:db/id "answer-51605067-0787-53ee-aaf2-ba1451c7298b" :answer/id #uuid "51605067-0787-53ee-aaf2-ba1451c7298b" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-2c8f8e6f-e697-5bb7-bf75-2e4331631d5d" :answer/id #uuid "2c8f8e6f-e697-5bb7-bf75-2e4331631d5d" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-a22620b9-3627-519a-9fcf-882b66fb2509" :answer/id #uuid "a22620b9-3627-519a-9fcf-882b66fb2509" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-6fcb20f0-7b84-5ab6-9881-9ca58e2d8984" :answer/id #uuid "6fcb20f0-7b84-5ab6-9881-9ca58e2d8984" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-25486f62-97da-5109-9737-87f525d30db1" :answer/id #uuid "25486f62-97da-5109-9737-87f525d30db1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "activity-ab25c004-2d05-58f2-a0d6-54009af95a70" :activity/id #uuid "ab25c004-2d05-58f2-a0d6-54009af95a70" :activity/title "Solving Equations With Odd Exponents Using the Nth Root Method" :activity/type :activity.type/review :activity/scope 17592186049066 :activity/course 17592186046647 :activity/steps ["step-e8f889b2-3513-5a19-aa94-03ceb44dba6e" "step-d915e072-457e-5546-ab5a-73371243b5c8" "step-1bd75efd-e9f9-5e75-ad2e-b07553799349"] :activity/first-step "step-e8f889b2-3513-5a19-aa94-03ceb44dba6e" :db/ensure [:activity/validate]} {:db/id "step-e8f889b2-3513-5a19-aa94-03ceb44dba6e" :step/id #uuid "e8f889b2-3513-5a19-aa94-03ceb44dba6e" :step/content 17592186180296 :step/next "step-d915e072-457e-5546-ab5a-73371243b5c8" :db/ensure [:step/validate]} {:db/id "step-d915e072-457e-5546-ab5a-73371243b5c8" :step/id #uuid "d915e072-457e-5546-ab5a-73371243b5c8" :step/content "question-ee997e26-088f-52b1-8913-d296b8992e92" :step/next "step-1bd75efd-e9f9-5e75-ad2e-b07553799349" :db/ensure [:step/validate]} {:db/id "step-1bd75efd-e9f9-5e75-ad2e-b07553799349" :step/id #uuid "1bd75efd-e9f9-5e75-ad2e-b07553799349" :step/content "question-351787b8-999c-59c8-b44f-8fe6c60247fb" :db/ensure [:step/validate]} {:db/id 17592186166806 :knowledge-point/questions ["question-a95ee677-1642-5975-8b50-8432d56de160" "question-d6b27f7b-e94e-5d63-abcb-feb8d8bed4dd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a95ee677-1642-5975-8b50-8432d56de160" :question/id #uuid "a95ee677-1642-5975-8b50-8432d56de160" :question/math-academy-id "q-97770" :question/problem "$\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-4x & =-({x}^{2}+4x) \\\\  & =-({x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}) \\\\  & =-((x+2)^{2}-4) \\\\  & =4-(x+2)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x}}\\text{d}x & =\\int \\frac{1}{(x+2)\\sqrt{4-(x+2)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{2(x+2)\\sqrt{1-{(\\frac{x+2}{2})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{(\\frac{x+2}{2})\\sqrt{1-{(\\frac{x+2}{2})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+2}{2}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x}}\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{(\\frac{x+2}{2})\\sqrt{1-{(\\frac{x+2}{2})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot 2\\,\\text{d}u \\\\  & =\\frac{1}{2}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{2}\\operatorname{arsech}⁡(\\frac{x+2}{2})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0526b46b-564d-561d-a9aa-fedc41539160"] :db/ensure [:question/validate]} {:db/id "answer-field-0526b46b-564d-561d-a9aa-fedc41539160" :answer-field/id #uuid "0526b46b-564d-561d-a9aa-fedc41539160" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aa279346-be14-5108-9c91-ebb49fea3432" :answer-field/choices ["answer-bb94fb36-58d4-5f5c-9e67-67e40c60505c" "answer-aa279346-be14-5108-9c91-ebb49fea3432" "answer-259a3844-82ae-5b24-a85f-f38b2f21f870" "answer-4e03b87e-8d9e-547f-803e-f3b920ae8222" "answer-0cb145f1-f9ae-5d5e-9acb-c2e8557eb522"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb94fb36-58d4-5f5c-9e67-67e40c60505c" :answer/id #uuid "bb94fb36-58d4-5f5c-9e67-67e40c60505c" :answer/type :answer.type/math :answer/value "-4\\operatorname{arsech}⁡(\\frac{x+2}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-aa279346-be14-5108-9c91-ebb49fea3432" :answer/id #uuid "aa279346-be14-5108-9c91-ebb49fea3432" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(\\frac{x+2}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-259a3844-82ae-5b24-a85f-f38b2f21f870" :answer/id #uuid "259a3844-82ae-5b24-a85f-f38b2f21f870" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{arsech}⁡(\\frac{x+2}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-4e03b87e-8d9e-547f-803e-f3b920ae8222" :answer/id #uuid "4e03b87e-8d9e-547f-803e-f3b920ae8222" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arcsch}⁡(\\frac{x+2}{2})+C" :db/ensure [:answer/validate]} {:db/id "answer-0cb145f1-f9ae-5d5e-9acb-c2e8557eb522" :answer/id #uuid "0cb145f1-f9ae-5d5e-9acb-c2e8557eb522" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcsch}⁡(\\frac{x+2}{2})+C" :db/ensure [:answer/validate]} {:db/id "question-d6b27f7b-e94e-5d63-abcb-feb8d8bed4dd" :question/id #uuid "d6b27f7b-e94e-5d63-abcb-feb8d8bed4dd" :question/math-academy-id "q-97777" :question/problem "$\\int \\frac{3}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}-6x & =-({x}^{2}+6x) \\\\  & =-({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) \\\\  & =-((x+3)^{2}-9) \\\\  & =9-(x+3)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{3}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\int \\frac{3}{(x+3)\\sqrt{9-{(x+3)}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{9-9{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x+3}{3}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{(x+3)\\sqrt{-{x}^{2}-6x}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{(\\frac{x+3}{3})\\sqrt{1-{(\\frac{x+3}{3})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot 3\\,\\text{d}u \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(\\frac{x+3}{3})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a1d9e3fb-7750-5a4b-a417-c4a5e9cfd326"] :db/ensure [:question/validate]} {:db/id "answer-field-a1d9e3fb-7750-5a4b-a417-c4a5e9cfd326" :answer-field/id #uuid "a1d9e3fb-7750-5a4b-a417-c4a5e9cfd326" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-39d34837-ebfe-5409-b1ab-da122aa01d5e" :answer-field/choices ["answer-7b8de859-a1f8-5dd2-834f-fa91b60b37c6" "answer-4c246a52-305e-5adb-972f-c828583b7f6d" "answer-b61c450a-f091-5a01-bd84-81b3a853a9d5" "answer-39d34837-ebfe-5409-b1ab-da122aa01d5e" "answer-1065a3b5-7eb0-5108-b4e2-8a64406d6063"] :db/ensure [:answer-field/validate]} {:db/id "answer-7b8de859-a1f8-5dd2-834f-fa91b60b37c6" :answer/id #uuid "7b8de859-a1f8-5dd2-834f-fa91b60b37c6" :answer/type :answer.type/math :answer/value "-3\\operatorname{arsech}⁡(\\frac{x+3}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-4c246a52-305e-5adb-972f-c828583b7f6d" :answer/id #uuid "4c246a52-305e-5adb-972f-c828583b7f6d" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}\\operatorname{arcsch}⁡(\\frac{x+3}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-b61c450a-f091-5a01-bd84-81b3a853a9d5" :answer/id #uuid "b61c450a-f091-5a01-bd84-81b3a853a9d5" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡(\\frac{x+3}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-39d34837-ebfe-5409-b1ab-da122aa01d5e" :answer/id #uuid "39d34837-ebfe-5409-b1ab-da122aa01d5e" :answer/type :answer.type/math :answer/value "-\\operatorname{arsech}⁡(\\frac{x+3}{3})+C" :db/ensure [:answer/validate]} {:db/id "answer-1065a3b5-7eb0-5108-b4e2-8a64406d6063" :answer/id #uuid "1065a3b5-7eb0-5108-b4e2-8a64406d6063" :answer/type :answer.type/math :answer/value "\\operatorname{arcsch}⁡(\\frac{x+3}{3})+C" :db/ensure [:answer/validate]} {:db/id 17592186166808 :knowledge-point/questions ["question-38a6fd7f-85a4-5b9d-9914-3bd5a2ab420c" "question-6a55ffae-eeb7-54cf-a5ce-c644ed8a6a5a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-38a6fd7f-85a4-5b9d-9914-3bd5a2ab420c" :question/id #uuid "38a6fd7f-85a4-5b9d-9914-3bd5a2ab420c" :question/math-academy-id "q-97904" :question/problem "$\\int \\frac{\\sqrt{2}}{|x-5|\\sqrt{{x}^{2}-10x+27}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-10x+27 & ={x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2}+27 \\\\  & =(x-5)^{2}+2\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{2}}{|x-5|\\sqrt{{x}^{2}-10x+27}}\\,\\text{d}x & =\\int \\frac{\\sqrt{2}}{|x-5|\\sqrt{2+(x-5)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|\\frac{x-5}{\\sqrt{2}}|\\sqrt{2+2{(\\frac{x-5}{\\sqrt{2}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{2}}\\int \\frac{1}{|\\frac{x-5}{\\sqrt{2}}|\\sqrt{1+{(\\frac{x-5}{\\sqrt{2}})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x-5}{\\sqrt{2}}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{2}}\\,⟹\\,\\text{d}x=\\sqrt{2}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{1}{\\sqrt{2}}\\int \\frac{1}{|\\frac{x-5}{\\sqrt{2}}|\\sqrt{1+{(\\frac{x-5}{\\sqrt{2}})}^{2}}}\\text{d}x & =\\frac{1}{\\sqrt{2}}\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\cdot \\sqrt{2}\\,\\text{d}u \\\\  & =\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arcsch}⁡u+C \\\\  & =-\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0b36eef3-f0c2-5b45-97f7-a2607c73a159"] :db/ensure [:question/validate]} {:db/id "answer-field-0b36eef3-f0c2-5b45-97f7-a2607c73a159" :answer-field/id #uuid "0b36eef3-f0c2-5b45-97f7-a2607c73a159" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fba7141a-d135-5744-8bbd-0158aa2f9308" :answer-field/choices ["answer-6b7d1c78-ae26-55ef-86e8-9c531b3f1a3e" "answer-fba7141a-d135-5744-8bbd-0158aa2f9308" "answer-bf7b4cd4-4878-5393-9a31-5c5c09f3bcdd" "answer-ddb986c7-c26a-5de1-8745-8a63847438c3" "answer-5a472c55-b621-565c-b578-f92c20cbb266"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b7d1c78-ae26-55ef-86e8-9c531b3f1a3e" :answer/id #uuid "6b7d1c78-ae26-55ef-86e8-9c531b3f1a3e" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "answer-fba7141a-d135-5744-8bbd-0158aa2f9308" :answer/id #uuid "fba7141a-d135-5744-8bbd-0158aa2f9308" :answer/type :answer.type/math :answer/value "-\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "answer-bf7b4cd4-4878-5393-9a31-5c5c09f3bcdd" :answer/id #uuid "bf7b4cd4-4878-5393-9a31-5c5c09f3bcdd" :answer/type :answer.type/math :answer/value "-\\sqrt{2}\\operatorname{arcsch}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "answer-ddb986c7-c26a-5de1-8745-8a63847438c3" :answer/id #uuid "ddb986c7-c26a-5de1-8745-8a63847438c3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{arsech}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "answer-5a472c55-b621-565c-b578-f92c20cbb266" :answer/id #uuid "5a472c55-b621-565c-b578-f92c20cbb266" :answer/type :answer.type/math :answer/value "\\operatorname{arsech}⁡(\\frac{x-5}{\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "question-6a55ffae-eeb7-54cf-a5ce-c644ed8a6a5a" :question/id #uuid "6a55ffae-eeb7-54cf-a5ce-c644ed8a6a5a" :question/math-academy-id "q-97905" :question/problem "$\\int -\\frac{15}{|5x+10|\\sqrt{{x}^{2}+4x+5}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}+4x+5 & ={x}^{2}+2\\cdot 2x+{2}^{2}-{2}^{2}+5 \\\\  & =(x+2)^{2}+1\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int -\\frac{15}{|5x-10|\\sqrt{{x}^{2}+4x+5}}\\,\\text{d}x=-\\int \\frac{15}{5|x+2|\\sqrt{1+(x+2)^{2}}}\\,\\text{d}x=-3\\int \\frac{1}{|x+2|\\sqrt{1+(x+2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x+2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}-3\\int \\frac{1}{|x+2|\\sqrt{1+(x+2)^{2}}}\\text{d}x & =-3\\int \\frac{1}{|u|\\sqrt{1+{u}^{2}}}\\,\\text{d}u \\\\  & =3\\operatorname{arcsch}⁡u+C \\\\  & =3\\operatorname{arcsch}⁡(x+2)+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-96a55f92-f39f-5881-94c0-2f84b4c3471a"] :db/ensure [:question/validate]} {:db/id "answer-field-96a55f92-f39f-5881-94c0-2f84b4c3471a" :answer-field/id #uuid "96a55f92-f39f-5881-94c0-2f84b4c3471a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba54fe97-ce78-59e0-ba7b-9401d786d8de" :answer-field/choices ["answer-e66f808f-00b9-5dfa-be64-b5ad0a17a5cb" "answer-5a909a9b-174b-5639-8410-d7e274a5815f" "answer-ba54fe97-ce78-59e0-ba7b-9401d786d8de" "answer-7f16f630-7db7-5f3c-9f65-39971597a4cc" "answer-6890919f-3dff-518f-b537-36ec02be3bc0"] :db/ensure [:answer-field/validate]} {:db/id "answer-e66f808f-00b9-5dfa-be64-b5ad0a17a5cb" :answer/id #uuid "e66f808f-00b9-5dfa-be64-b5ad0a17a5cb" :answer/type :answer.type/math :answer/value "-3\\operatorname{arsech}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-5a909a9b-174b-5639-8410-d7e274a5815f" :answer/id #uuid "5a909a9b-174b-5639-8410-d7e274a5815f" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}\\operatorname{arsech}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-ba54fe97-ce78-59e0-ba7b-9401d786d8de" :answer/id #uuid "ba54fe97-ce78-59e0-ba7b-9401d786d8de" :answer/type :answer.type/math :answer/value "3\\operatorname{arcsch}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-7f16f630-7db7-5f3c-9f65-39971597a4cc" :answer/id #uuid "7f16f630-7db7-5f3c-9f65-39971597a4cc" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{arcsch}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-6890919f-3dff-518f-b537-36ec02be3bc0" :answer/id #uuid "6890919f-3dff-518f-b537-36ec02be3bc0" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\operatorname{arcsch}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id 17592186166809 :knowledge-point/questions ["question-1369cbfd-a46c-5064-baa1-cbe5720fb540"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1369cbfd-a46c-5064-baa1-cbe5720fb540" :question/id #uuid "1369cbfd-a46c-5064-baa1-cbe5720fb540" :question/math-academy-id "q-97910" :question/problem "Calculate $\\int \\frac{1}{16-(3x+2)^{2}}\\,\\text{d}x=$" :question/worked-solution "First, we note that\n\n$$\n\\int \\frac{1}{16-(3x+2)^{2}}\\,\\text{d}x=\\int \\frac{1}{16-16(\\frac{1}{16}(3x+2)^{2})}\\,\\text{d}x=\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(3x+2))}^{2}}\\,\\text{d}x.\n$$\n\nLet $u=\\frac{1}{4}(3x+2).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{4}\\,⟹\\,\\text{d}x=\\frac{4}{3}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{16}\\int \\frac{1}{1-{(\\frac{1}{4}(3x+2))}^{2}}\\,\\text{d}x & =\\frac{1}{16}\\int \\frac{1}{1-{u}^{2}}\\,\\cdot \\frac{4}{3}\\,\\text{d}u \\\\  & =\\frac{1}{12}\\cdot \\operatorname{arcoth}⁡u+C \\\\  & =\\frac{1}{12}\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C.\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{3x+2}{4}|>1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4fbff315-ecc9-5c1a-aaa6-d1781060ca7f"] :db/ensure [:question/validate]} {:db/id "answer-field-4fbff315-ecc9-5c1a-aaa6-d1781060ca7f" :answer-field/id #uuid "4fbff315-ecc9-5c1a-aaa6-d1781060ca7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-85052561-0afa-5d49-a8cd-46da05f90e90" :answer-field/choices ["answer-8adcb99e-b119-5618-808f-7b0725c00dbe" "answer-e861d624-48ec-543a-aaf6-deee37e2e5ca" "answer-e08a4d2f-d017-5f6c-b6cc-e8a0f88c0fb9" "answer-85052561-0afa-5d49-a8cd-46da05f90e90" "answer-09596fbb-5f17-590f-b8c6-41aea4206883"] :db/ensure [:answer-field/validate]} {:db/id "answer-8adcb99e-b119-5618-808f-7b0725c00dbe" :answer/id #uuid "8adcb99e-b119-5618-808f-7b0725c00dbe" :answer/type :answer.type/math :answer/value "-\\frac{1}{16}\\operatorname{arcoth}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-e861d624-48ec-543a-aaf6-deee37e2e5ca" :answer/id #uuid "e861d624-48ec-543a-aaf6-deee37e2e5ca" :answer/type :answer.type/math :answer/value "-\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C" :db/ensure [:answer/validate]} {:db/id "answer-e08a4d2f-d017-5f6c-b6cc-e8a0f88c0fb9" :answer/id #uuid "e08a4d2f-d017-5f6c-b6cc-e8a0f88c0fb9" :answer/type :answer.type/math :answer/value "\\frac{1}{12}\\operatorname{arcoth}⁡(3x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-85052561-0afa-5d49-a8cd-46da05f90e90" :answer/id #uuid "85052561-0afa-5d49-a8cd-46da05f90e90" :answer/type :answer.type/math :answer/value "\\frac{1}{12}\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C" :db/ensure [:answer/validate]} {:db/id "answer-09596fbb-5f17-590f-b8c6-41aea4206883" :answer/id #uuid "09596fbb-5f17-590f-b8c6-41aea4206883" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcoth}⁡(\\frac{3x+2}{4})+C" :db/ensure [:answer/validate]} {:db/id "activity-0cd59e01-3499-5e0d-9dff-47c2f8678675" :activity/id #uuid "0cd59e01-3499-5e0d-9dff-47c2f8678675" :activity/title "Integration Using Inverse Reciprocal Hyperbolic Functions and Completing the Square" :activity/type :activity.type/review :activity/scope 17592186049052 :activity/course 17592186046668 :activity/steps ["step-9ddb5345-ef98-5ee3-a8a7-421a3b7a527f" "step-b873437c-8a91-5a52-b7b4-61177581823b" "step-49d1f9ce-7282-5ee1-8586-6e53e7242013" "step-aaa68476-6aa2-5a3d-89b3-b111ae8473a4" "step-227deb9f-a9be-5caf-9b21-75db4f696e28"] :activity/first-step "step-9ddb5345-ef98-5ee3-a8a7-421a3b7a527f" :db/ensure [:activity/validate]} {:db/id "step-9ddb5345-ef98-5ee3-a8a7-421a3b7a527f" :step/id #uuid "9ddb5345-ef98-5ee3-a8a7-421a3b7a527f" :step/content "question-a95ee677-1642-5975-8b50-8432d56de160" :step/next "step-b873437c-8a91-5a52-b7b4-61177581823b" :db/ensure [:step/validate]} {:db/id "step-b873437c-8a91-5a52-b7b4-61177581823b" :step/id #uuid "b873437c-8a91-5a52-b7b4-61177581823b" :step/content "question-d6b27f7b-e94e-5d63-abcb-feb8d8bed4dd" :step/next "step-49d1f9ce-7282-5ee1-8586-6e53e7242013" :db/ensure [:step/validate]} {:db/id "step-49d1f9ce-7282-5ee1-8586-6e53e7242013" :step/id #uuid "49d1f9ce-7282-5ee1-8586-6e53e7242013" :step/content "question-38a6fd7f-85a4-5b9d-9914-3bd5a2ab420c" :step/next "step-aaa68476-6aa2-5a3d-89b3-b111ae8473a4" :db/ensure [:step/validate]} {:db/id "step-aaa68476-6aa2-5a3d-89b3-b111ae8473a4" :step/id #uuid "aaa68476-6aa2-5a3d-89b3-b111ae8473a4" :step/content "question-6a55ffae-eeb7-54cf-a5ce-c644ed8a6a5a" :step/next "step-227deb9f-a9be-5caf-9b21-75db4f696e28" :db/ensure [:step/validate]} {:db/id "step-227deb9f-a9be-5caf-9b21-75db4f696e28" :step/id #uuid "227deb9f-a9be-5caf-9b21-75db4f696e28" :step/content "question-1369cbfd-a46c-5064-baa1-cbe5720fb540" :db/ensure [:step/validate]} {:db/id 17592186229142 :knowledge-point/questions ["question-eaac4ca3-6936-5237-9e98-3d7aa72b5385"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eaac4ca3-6936-5237-9e98-3d7aa72b5385" :question/id #uuid "eaac4ca3-6936-5237-9e98-3d7aa72b5385" :question/math-academy-id "q-335025" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-2y(t) \\\\ {y}^{′}(t)=-2x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & -\\operatorname{sinh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & -\\operatorname{sinh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(2t) & -\\operatorname{sinh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8ea9a430-3071-50b8-b617-7ec74f7a4ddc"] :db/ensure [:question/validate]} {:db/id "answer-field-8ea9a430-3071-50b8-b617-7ec74f7a4ddc" :answer-field/id #uuid "8ea9a430-3071-50b8-b617-7ec74f7a4ddc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-63a09f8e-7c0b-5249-a0c2-f6b28192c424" :answer-field/choices ["answer-63a09f8e-7c0b-5249-a0c2-f6b28192c424" "answer-246dbb57-80e4-56b7-8e34-27bb9114f64c" "answer-45cfe9fb-b684-53e4-ab59-2be2f93d9858" "answer-4bdeeefb-735e-5811-8754-67e744ec5c92" "answer-d3e28dd3-0453-550c-862e-c838b2f1aca0"] :db/ensure [:answer-field/validate]} {:db/id "answer-63a09f8e-7c0b-5249-a0c2-f6b28192c424" :answer/id #uuid "63a09f8e-7c0b-5249-a0c2-f6b28192c424" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-246dbb57-80e4-56b7-8e34-27bb9114f64c" :answer/id #uuid "246dbb57-80e4-56b7-8e34-27bb9114f64c" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "answer-45cfe9fb-b684-53e4-ab59-2be2f93d9858" :answer/id #uuid "45cfe9fb-b684-53e4-ab59-2be2f93d9858" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4bdeeefb-735e-5811-8754-67e744ec5c92" :answer/id #uuid "4bdeeefb-735e-5811-8754-67e744ec5c92" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d3e28dd3-0453-550c-862e-c838b2f1aca0" :answer/id #uuid "d3e28dd3-0453-550c-862e-c838b2f1aca0" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(2t) \\\\ -\\operatorname{sinh}⁡(2t)\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(2t) \\\\ \\operatorname{cosh}⁡(2t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186229144 :knowledge-point/questions ["question-701145a1-1f00-509b-9c1b-60626233c2a4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-701145a1-1f00-509b-9c1b-60626233c2a4" :question/id #uuid "701145a1-1f00-509b-9c1b-60626233c2a4" :question/math-academy-id "q-335434" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=4y(t) \\\\ {y}^{′}(t)=-4x(t),\\end{aligned}\\,[\\begin{aligned}x(1) \\\\ y(1)\\end{aligned}]=[\\begin{aligned}0 \\\\ 3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"130px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 4 \\\\ -4 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nSo, we can write our general solution as\n\n$$\nx(t)={Φ}_{0}(t)c={e}^{At}\\,c,\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system. Substituting $t={t}_{0},$ we have\n\n$$\nx({t}_{0})={e}^{A{t}_{0}}\\,c\n$$\n\nand since ${e}^{At}$ is invertible for all $t,$ we have\n\n$$\nc={e}^{-A{t}_{0}}\\,x({t}_{0}).\n$$\n\nPlugging the above back into our expression for $x(t),$ we get\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,{e}^{-A{t}_{0}}\\,x({t}_{0}) \\\\  & ={e}^{A(t-{t}_{0})}\\,x({t}_{0}).\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{A(t-1)}\\,x(1) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(4(t-1)) & \\operatorname{sin}⁡(4(t-1)) \\\\ -\\operatorname{sin}⁡(4(t-1)) & \\operatorname{cos}⁡(4(t-1))\\end{aligned}][\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}\\,3\\operatorname{sin}⁡(4(t-1))\\, \\\\ \\,3\\operatorname{cos}⁡(4(t-1))\\,\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0f7c85fb-7d21-5d48-8f24-4c37d6bc47ea" "answer-field-9ff392b1-754b-5f5c-ad8a-af1f4c91dfa9"] :db/ensure [:question/validate]} {:db/id "answer-field-0f7c85fb-7d21-5d48-8f24-4c37d6bc47ea" :answer-field/id #uuid "0f7c85fb-7d21-5d48-8f24-4c37d6bc47ea" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d3e6f6d2-ce35-5cb0-a6c5-f9b0db8f35b2" :answer-field/choices ["answer-d3e6f6d2-ce35-5cb0-a6c5-f9b0db8f35b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3e6f6d2-ce35-5cb0-a6c5-f9b0db8f35b2" :answer/id #uuid "d3e6f6d2-ce35-5cb0-a6c5-f9b0db8f35b2" :answer/type :answer.type/math :answer/value "3\\sin(4(t-1))" :db/ensure [:answer/validate]} {:db/id "answer-field-9ff392b1-754b-5f5c-ad8a-af1f4c91dfa9" :answer-field/id #uuid "9ff392b1-754b-5f5c-ad8a-af1f4c91dfa9" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f8ac02a8-cb92-5cdb-baec-1e8c677c1a9c" :answer-field/choices ["answer-f8ac02a8-cb92-5cdb-baec-1e8c677c1a9c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8ac02a8-cb92-5cdb-baec-1e8c677c1a9c" :answer/id #uuid "f8ac02a8-cb92-5cdb-baec-1e8c677c1a9c" :answer/type :answer.type/math :answer/value "3\\cos(4(t-1))" :db/ensure [:answer/validate]} {:db/id "activity-d79f13d1-043c-58ab-89f2-0282f6144b80" :activity/id #uuid "d79f13d1-043c-58ab-89f2-0282f6144b80" :activity/title "Solving Homogeneous Systems of ODEs Using Matrix Methods" :activity/type :activity.type/review :activity/scope 17592186048231 :activity/course 17592186046668 :activity/steps ["step-3c2b1be3-b138-5354-826d-0d722fe6ba4e" "step-8d6857f9-1674-50e2-bd6e-08e1076f3091" "step-0b859571-5266-5412-bce5-e8cf5c6397c7" "step-66628ba8-6a25-551d-82f3-4c8835969083" "step-cd08637e-a1a7-546e-8e76-ea7112573f7e"] :activity/first-step "step-3c2b1be3-b138-5354-826d-0d722fe6ba4e" :db/ensure [:activity/validate]} {:db/id "step-3c2b1be3-b138-5354-826d-0d722fe6ba4e" :step/id #uuid "3c2b1be3-b138-5354-826d-0d722fe6ba4e" :step/content 17592186402113 :step/next "step-8d6857f9-1674-50e2-bd6e-08e1076f3091" :db/ensure [:step/validate]} {:db/id "step-8d6857f9-1674-50e2-bd6e-08e1076f3091" :step/id #uuid "8d6857f9-1674-50e2-bd6e-08e1076f3091" :step/content 17592186229669 :step/next "step-0b859571-5266-5412-bce5-e8cf5c6397c7" :db/ensure [:step/validate]} {:db/id "step-0b859571-5266-5412-bce5-e8cf5c6397c7" :step/id #uuid "0b859571-5266-5412-bce5-e8cf5c6397c7" :step/content "question-eaac4ca3-6936-5237-9e98-3d7aa72b5385" :step/next "step-66628ba8-6a25-551d-82f3-4c8835969083" :db/ensure [:step/validate]} {:db/id "step-66628ba8-6a25-551d-82f3-4c8835969083" :step/id #uuid "66628ba8-6a25-551d-82f3-4c8835969083" :step/content 17592186311562 :step/next "step-cd08637e-a1a7-546e-8e76-ea7112573f7e" :db/ensure [:step/validate]} {:db/id "step-cd08637e-a1a7-546e-8e76-ea7112573f7e" :step/id #uuid "cd08637e-a1a7-546e-8e76-ea7112573f7e" :step/content "question-701145a1-1f00-509b-9c1b-60626233c2a4" :db/ensure [:step/validate]} [:db/retract 17592186110017 :answer-field/choices 17592186110018] [:db/retract 17592186110017 :answer-field/choices 17592186110019] [:db/retract 17592186110017 :answer-field/choices 17592186110020] [:db/retract 17592186110017 :answer-field/choices 17592186110021] [:db/retract 17592186110017 :answer-field/choices 17592186110022] {:db/id 17592186110676 :knowledge-point/questions ["question-66bc9e90-0e6b-5349-afc6-a4320dc355fe" "question-82de78d8-db02-58ba-afa8-a2bcae276094"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110302 :question/problem "Which of the following plots is the graph of $y = \\log (x)?$\n\n![](images/5f/5f38ded6da0c01657574cf0a40d86d2c5d2ce6b9ff1c29ceaaefbbe82103a277.png)" :question/worked-solution "Let's recall some of the basic properties of $y=\\log (x)\\mathbin{:}$\n\n- The graph passes through the point $(1,0).$\n\n- For $x>1,$ the function is positive and grows very slowly as we increase $x.$ We say that $y\\rightarrow \\infty$ (slowly) as $x\\rightarrow \\infty.$\n\n- The domain is $x>0$, and the range is $-\\infty < y < \\infty.$ The function is not defined at $x=0.$\n\n- The function has the vertical asymptote $x=0.$\n\n- The function is an increasing function.\n\nOf the given plots, the only one that displays all of these properties is II. (For example, plots I, III, and IV all do not have a vertical asymptote $x=0.$)" :db/ensure [:question/validate]} {:db/id 17592186110677 :knowledge-point/questions ["question-d6e79644-f01f-5d41-959c-0424a55445f9" "question-db1e03ac-5baa-5855-b6ca-f2c610df9446"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110303 :question/problem "What are the domain and range of the function $y=\\ln x ?$" :question/worked-solution "Let's recall the graph of $y = \\ln x.$\n\n![](images/00/004c1050017c1a0631d0dda46c8335248b4f05dad15645513b71e88588d4ed0c.png)\n\nThe domain of $y=\\ln x$ is $x \\in (0,\\infty)$ and the range is $y \\in (-\\infty,\\infty).$" :db/ensure [:question/validate]} {:db/id 17592186110305 :question/problem "What is the vertical asymptote of $y=\\log_{2} x?$" :question/worked-solution "Let's recall the graph of $y=\\log_{2} x.$\n\n![](images/96/96d7da4dd7415b769803b9cea8ebf91b65db2ba5afe0249af9d16521eb0f4818.png)\n\nFrom the graph, we see that the function $y=\\log_{2} x$ has the vertical asymptote at $x=0.$" :db/ensure [:question/validate]} {:db/id 17592186110678 :knowledge-point/questions ["question-96d6c320-22a1-578b-bc1b-575bf1a1c004"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110304 :question/problem "Which of the following statements are true regarding the function $y=\\ln(x)?$\n\nI. $y\\rightarrow-\\infty$ as $x\\rightarrow 0^+$\n\nII. The curve passes through the point $(1,0)$\n\nIII. $y\\rightarrow\\infty$ as $x\\rightarrow -\\infty$" :question/worked-solution "First, let's plot the graph of $y=\\ln (x).$\n\n![](images/d9/d9ca282050c64ffc1ab1950dd6d89288e6d65d680e45bbc9ef29c1a4ae2c3a67.png)\n\nNow, let's consider each statement.\n\n- Statement I is true. As $x$ approaches $0^+,$ $y$ decreases without bound.\n\n- Statement II is true. Substituting $x=1$ into the equation of the curve gives a result of $0\\mathbin{:}$\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(1)=0\\,✓\\end{aligned}\n$$\n\n- Statement III is false. The function is not defined for $x<0,$ so the function is not defined as $x \\to -\\infty.$\n\nIn conclusion, only statements I and II are true." :db/ensure [:question/validate]} {:db/id "question-66bc9e90-0e6b-5349-afc6-a4320dc355fe" :question/id #uuid "66bc9e90-0e6b-5349-afc6-a4320dc355fe" :question/math-academy-id "q-156691" :question/problem "Which of the following diagrams shows the graph of $y={log}_{10}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y={log}_{10}⁡x:$\n\n- The domain is $x>0$, and the range is $-\\infty <y<\\infty .$\n\n- The graph has the vertical asymptote $x=0.$\n\n- The function is an increasing function.\n\n- The graph passes through the point $(1,0).$\n\n- For $x>1$, the graph is positive and grows very slowly as we increase $x.$ We say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/5a/5a52b4fcfb2cc410c894f69771ff450ceef1366048438345d1444e35186d9d76.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3d617350-105e-5169-869d-979d77b96b31"] :db/ensure [:question/validate]} {:db/id "answer-field-3d617350-105e-5169-869d-979d77b96b31" :answer-field/id #uuid "3d617350-105e-5169-869d-979d77b96b31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9b18b20-9338-545b-83f7-9561c2d8b175" :answer-field/choices ["answer-f8775698-5cd7-5b37-9787-6fd7662e068d" "answer-c9b18b20-9338-545b-83f7-9561c2d8b175" "answer-4139f992-18c2-541d-a17f-bdc977442718" "answer-1d8576c7-cf28-59ab-aad4-68888834444a" "answer-5e372c06-b64e-5e8e-886f-b67cf7c92ad5"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8775698-5cd7-5b37-9787-6fd7662e068d" :answer/id #uuid "f8775698-5cd7-5b37-9787-6fd7662e068d" :answer/type :answer.type/image :answer/value "images/3d/3d64f2d38b0e063e58591eb2bac178e1a2edf07342fe2d1489c350201b2158aa.png" :db/ensure [:answer/validate]} {:db/id "answer-c9b18b20-9338-545b-83f7-9561c2d8b175" :answer/id #uuid "c9b18b20-9338-545b-83f7-9561c2d8b175" :answer/type :answer.type/image :answer/value "images/5a/5a52b4fcfb2cc410c894f69771ff450ceef1366048438345d1444e35186d9d76.png" :db/ensure [:answer/validate]} {:db/id "answer-4139f992-18c2-541d-a17f-bdc977442718" :answer/id #uuid "4139f992-18c2-541d-a17f-bdc977442718" :answer/type :answer.type/image :answer/value "images/79/79996a9f196d55043211af691824a64337a1f9fb311caabc73c26cb11507a032.png" :db/ensure [:answer/validate]} {:db/id "answer-1d8576c7-cf28-59ab-aad4-68888834444a" :answer/id #uuid "1d8576c7-cf28-59ab-aad4-68888834444a" :answer/type :answer.type/image :answer/value "images/84/84b02de91145eb07f7953fc66990d0eb4c05ac4a472dfdd1c45897f603630ecc.png" :db/ensure [:answer/validate]} {:db/id "answer-5e372c06-b64e-5e8e-886f-b67cf7c92ad5" :answer/id #uuid "5e372c06-b64e-5e8e-886f-b67cf7c92ad5" :answer/type :answer.type/image :answer/value "images/f9/f9c4a79e5132b4759fbf8d9352c000a0963ea67ee4dfe225c12ae0bf9c2a8ba7.png" :db/ensure [:answer/validate]} {:db/id "question-82de78d8-db02-58ba-afa8-a2bcae276094" :question/id #uuid "82de78d8-db02-58ba-afa8-a2bcae276094" :question/math-academy-id "q-69693" :question/problem "Which of the following diagrams shows the graph of $y={log}_{2}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y={log}_{2}⁡x:$\n\n- The domain is $x>0$, and the range is $-\\infty <y<\\infty .$\n\n- The graph has the vertical asymptote $x=0.$\n\n- The function is an increasing function.\n\n- The graph passes through the point $(1,0).$\n\n- For $x>1$, the graph is positive and grows very slowly as we increase $x.$ We say that $y\\to \\infty $ (slowly) as $x\\to \\infty .$\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/28/285e69e8c0914643c1fb695d0146a5e83304d74f9e8fbd8efbc2100a7f32bd9e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e4e9db8c-de87-5771-b057-8503dbc84d01"] :db/ensure [:question/validate]} {:db/id "answer-field-e4e9db8c-de87-5771-b057-8503dbc84d01" :answer-field/id #uuid "e4e9db8c-de87-5771-b057-8503dbc84d01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b9bfadd0-e374-585c-b6a5-326839b56ad8" :answer-field/choices ["answer-b9bfadd0-e374-585c-b6a5-326839b56ad8" "answer-2821546d-1b86-59e1-aefc-96a353b7c4d6" "answer-cc03d8ac-77bf-5178-838d-353b0a613a52" "answer-96c77cf6-e1bd-580c-9fce-429624d4e465" "answer-019e96cc-90d0-5b45-819f-c08d766dfb34"] :db/ensure [:answer-field/validate]} {:db/id "answer-b9bfadd0-e374-585c-b6a5-326839b56ad8" :answer/id #uuid "b9bfadd0-e374-585c-b6a5-326839b56ad8" :answer/type :answer.type/image :answer/value "images/28/285e69e8c0914643c1fb695d0146a5e83304d74f9e8fbd8efbc2100a7f32bd9e.png" :db/ensure [:answer/validate]} {:db/id "answer-2821546d-1b86-59e1-aefc-96a353b7c4d6" :answer/id #uuid "2821546d-1b86-59e1-aefc-96a353b7c4d6" :answer/type :answer.type/image :answer/value "images/5d/5d4fb47e0dc5d3328f985be136691a4f34765b804c100f58ed6d8ad378e20409.png" :db/ensure [:answer/validate]} {:db/id "answer-cc03d8ac-77bf-5178-838d-353b0a613a52" :answer/id #uuid "cc03d8ac-77bf-5178-838d-353b0a613a52" :answer/type :answer.type/image :answer/value "images/8e/8e7af01c65f51d61eb73eac91d4678d772eb00a6046d00efc50e675f573c07c4.png" :db/ensure [:answer/validate]} {:db/id "answer-96c77cf6-e1bd-580c-9fce-429624d4e465" :answer/id #uuid "96c77cf6-e1bd-580c-9fce-429624d4e465" :answer/type :answer.type/image :answer/value "images/9c/9c6d1189439bab1a83653c410b9d7528337707e9b99ec33a87b49118152db4de.png" :db/ensure [:answer/validate]} {:db/id "answer-019e96cc-90d0-5b45-819f-c08d766dfb34" :answer/id #uuid "019e96cc-90d0-5b45-819f-c08d766dfb34" :answer/type :answer.type/image :answer/value "images/df/dfc188411db17364c61df7fdc938658f683ebaf987b546c6656724b49af3dd05.png" :db/ensure [:answer/validate]} {:db/id "question-d6e79644-f01f-5d41-959c-0424a55445f9" :question/id #uuid "d6e79644-f01f-5d41-959c-0424a55445f9" :question/math-academy-id "q-156696" :question/problem "What's the range of $f(x)={log}_{10}⁡x?$" :question/worked-solution "Let's recall the graph of $y={log}_{10}⁡x.$\n\n![](images/46/460a26a36316db034c93017f45aba301b1a39146b1dcb60b3024d3a20a824314.png)\n\nThe domain of $y={log}_{10}⁡x$ is $x\\in (0,\\infty )$ and the range is $y\\in (-\\infty ,\\infty ).$\n\nTherefore, the correct answer is \"All real numbers.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-fiel