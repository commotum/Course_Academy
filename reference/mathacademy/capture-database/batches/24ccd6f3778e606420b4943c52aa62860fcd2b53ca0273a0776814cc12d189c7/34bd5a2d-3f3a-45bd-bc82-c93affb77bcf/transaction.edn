orrect "answer-e708cbcb-204a-515f-a2ee-8880e52ab193" :answer-field/choices ["answer-0f9d67ae-479b-5212-a32d-ea72ac199fdf" "answer-66a4a5e4-546c-53dd-b661-09d0f6e93243" "answer-3121334e-b5ff-5d7f-b931-c4cc6aff67e3" "answer-e708cbcb-204a-515f-a2ee-8880e52ab193" "answer-44050778-0a11-5b3d-8de9-552e09f1598c"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f9d67ae-479b-5212-a32d-ea72ac199fdf" :answer/id #uuid "0f9d67ae-479b-5212-a32d-ea72ac199fdf" :answer/type :answer.type/math :answer/value "28\\sqrt[3]{s{t}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-66a4a5e4-546c-53dd-b661-09d0f6e93243" :answer/id #uuid "66a4a5e4-546c-53dd-b661-09d0f6e93243" :answer/type :answer.type/math :answer/value "7\\sqrt[3]{st}" :db/ensure [:answer/validate]} {:db/id "answer-3121334e-b5ff-5d7f-b931-c4cc6aff67e3" :answer/id #uuid "3121334e-b5ff-5d7f-b931-c4cc6aff67e3" :answer/type :answer.type/math :answer/value "\\sqrt[3]{14st}" :db/ensure [:answer/validate]} {:db/id "answer-e708cbcb-204a-515f-a2ee-8880e52ab193" :answer/id #uuid "e708cbcb-204a-515f-a2ee-8880e52ab193" :answer/type :answer.type/math :answer/value "\\sqrt[3]{28s{t}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-44050778-0a11-5b3d-8de9-552e09f1598c" :answer/id #uuid "44050778-0a11-5b3d-8de9-552e09f1598c" :answer/type :answer.type/math :answer/value "t\\sqrt[3]{28s}" :db/ensure [:answer/validate]} {:db/id "activity-966a76d8-0c6e-5591-b99a-1917424d151b" :activity/id #uuid "966a76d8-0c6e-5591-b99a-1917424d151b" :activity/title "Combining Radical Expressions Using the Product Rule" :activity/type :activity.type/review :activity/scope 17592186048132 :activity/course 17592186046647 :activity/steps ["step-f58651f1-e6af-576f-8e7f-3b48b9f27e36" "step-3a66b197-3ff8-5d27-8cde-046d95da9317" "step-25b65737-ade2-56c9-a926-c3e2f2a2500e"] :activity/first-step "step-f58651f1-e6af-576f-8e7f-3b48b9f27e36" :db/ensure [:activity/validate]} {:db/id "step-f58651f1-e6af-576f-8e7f-3b48b9f27e36" :step/id #uuid "f58651f1-e6af-576f-8e7f-3b48b9f27e36" :step/content "question-60bf46ec-c41d-5bd2-93b6-b056ca651773" :step/next "step-3a66b197-3ff8-5d27-8cde-046d95da9317" :db/ensure [:step/validate]} {:db/id "step-3a66b197-3ff8-5d27-8cde-046d95da9317" :step/id #uuid "3a66b197-3ff8-5d27-8cde-046d95da9317" :step/content "question-bd6c8038-fcc2-5fa5-ad44-54f20efc3514" :step/next "step-25b65737-ade2-56c9-a926-c3e2f2a2500e" :db/ensure [:step/validate]} {:db/id "step-25b65737-ade2-56c9-a926-c3e2f2a2500e" :step/id #uuid "25b65737-ade2-56c9-a926-c3e2f2a2500e" :step/content "question-41a2ad72-53df-54b1-8f6d-95041c4754db" :db/ensure [:step/validate]} {:db/id 17592186204011 :knowledge-point/questions ["question-7487be5e-d3cc-5ed9-9625-a2ce92482f7c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7487be5e-d3cc-5ed9-9625-a2ce92482f7c" :question/id #uuid "7487be5e-d3cc-5ed9-9625-a2ce92482f7c" :question/math-academy-id "q-251806" :question/problem "Consider the two sets of $8$ paired observations in the table below.\n\n| **$\\,{x}_{i}\\,$** | $16$ | $9$ | $12$ | $10$ | $11$ | $11$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| **$\\,{y}_{i}\\,$** | $10$ | $14$ | $8$ | $10$ | $7$ | $8$ | $2$ | $4$ |\n\nGiven that ${\\sum }_{i=1}^{8}{x}_{i}{y}_{i}=695,$ calculate ${S}_{xy}.$" :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the sum of products of deviations from the means can be calculated as follows:\n\n$$\n\\begin{aligned}{S}_{xy} & ={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & ={\\sum }_{i}{x}_{i}{y}_{i}-\\frac{1}{n}({\\sum }_{i=1}^{n}{x}_{i})({\\sum }_{i=1}^{n}{y}_{i})\\end{aligned}\n$$\n\nFirst, we calculate the sum of the ${x}_{i}$ and ${y}_{i}:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =16+9+12+10+11+11+6+9=84, \\\\ {\\sum }_{i=1}^{n}{y}_{i} & =10+14+8+10+7+8+2+4=63\\end{aligned}\n$$\n\nWe are given that ${\\sum }_{i=1}^{8}{x}_{i}{y}_{i}=695.$\n\nFinally, by substituting in the above formula, we get\n\n$$\n{S}_{xy}=695-\\frac{1}{8}(84)(63)=695-661.5=33.5.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-71771a9c-6d44-5ba0-b159-1c1d1cb21717"] :db/ensure [:question/validate]} {:db/id "answer-field-71771a9c-6d44-5ba0-b159-1c1d1cb21717" :answer-field/id #uuid "71771a9c-6d44-5ba0-b159-1c1d1cb21717" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a38d71f2-fdd4-5997-bdf4-77d25628f1b8" :answer-field/choices ["answer-c7395bc7-0a3c-5f1c-a9c6-0a647dc4241a" "answer-afb01973-c81f-590b-a69b-afca6cd48a7b" "answer-3cacd545-fd7c-5c12-b57f-e54b5d1d6829" "answer-0c5d8ba4-23fd-58c5-878f-33e321fefa74" "answer-a38d71f2-fdd4-5997-bdf4-77d25628f1b8"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7395bc7-0a3c-5f1c-a9c6-0a647dc4241a" :answer/id #uuid "c7395bc7-0a3c-5f1c-a9c6-0a647dc4241a" :answer/type :answer.type/math :answer/value "{S}_{xy}=24" :db/ensure [:answer/validate]} {:db/id "answer-afb01973-c81f-590b-a69b-afca6cd48a7b" :answer/id #uuid "afb01973-c81f-590b-a69b-afca6cd48a7b" :answer/type :answer.type/math :answer/value "{S}_{xy}=27.5" :db/ensure [:answer/validate]} {:db/id "answer-3cacd545-fd7c-5c12-b57f-e54b5d1d6829" :answer/id #uuid "3cacd545-fd7c-5c12-b57f-e54b5d1d6829" :answer/type :answer.type/math :answer/value "{S}_{xy}=30.5" :db/ensure [:answer/validate]} {:db/id "answer-0c5d8ba4-23fd-58c5-878f-33e321fefa74" :answer/id #uuid "0c5d8ba4-23fd-58c5-878f-33e321fefa74" :answer/type :answer.type/math :answer/value "{S}_{xy}=32" :db/ensure [:answer/validate]} {:db/id "answer-a38d71f2-fdd4-5997-bdf4-77d25628f1b8" :answer/id #uuid "a38d71f2-fdd4-5997-bdf4-77d25628f1b8" :answer/type :answer.type/math :answer/value "{S}_{xy}=33.5" :db/ensure [:answer/validate]} {:db/id 17592186204009 :knowledge-point/questions ["question-17851fea-30ed-54e9-89be-985c48bef200"] :db/ensure [:knowledge-point/validate]} {:db/id "question-17851fea-30ed-54e9-89be-985c48bef200" :question/id #uuid "17851fea-30ed-54e9-89be-985c48bef200" :question/math-academy-id "q-251850" :question/problem "Consider two sets of $20$ paired observations ${x}_{1},{x}_{2},…,{x}_{20},$ and ${y}_{1},{y}_{2},…,{y}_{20}.$ You are given that\n\n$$\n\\begin{aligned}{S}_{xx}=60,\\,{S}_{yy}=116,\\,{S}_{xy}=100.\\end{aligned}\n$$\n\nThen, ${\\sigma }_{y}^{2}=$\n{{field-1}}." :question/worked-solution "Given a set of $n$ paired observations ${x}_{1},{x}_{2},…,{x}_{n}$ and ${y}_{1},{y}_{2},…,{y}_{n},$ the variance of ${y}_{i}$ can be calculated as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{y}^{2} & =\\frac{{S}_{yy}}{n},\\end{aligned}\n$$\n\nwhere ${S}_{yy}$ is the sum of squared deviations from the mean for the data ${y}_{i}.$\n\nWe are given that ${S}_{yy}=116.$ Substituting the given statistic in the above formula, we get\n\n$$\n\\begin{aligned}{\\sigma }_{y}^{2} & =\\frac{116}{20} \\\\  & =5.8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1b5318d2-3f2f-55cf-b4e0-80a9f6598453"] :db/ensure [:question/validate]} {:db/id "answer-field-1b5318d2-3f2f-55cf-b4e0-80a9f6598453" :answer-field/id #uuid "1b5318d2-3f2f-55cf-b4e0-80a9f6598453" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6f3cf9a4-e088-5b99-9833-d8bb8c2bb442" :answer-field/choices ["answer-6f3cf9a4-e088-5b99-9833-d8bb8c2bb442"] :db/ensure [:answer-field/validate]} {:db/id "answer-6f3cf9a4-e088-5b99-9833-d8bb8c2bb442" :answer/id #uuid "6f3cf9a4-e088-5b99-9833-d8bb8c2bb442" :answer/type :answer.type/math :answer/value "5.8" :db/ensure [:answer/validate]} {:db/id "activity-3db7337d-a389-5665-8389-d09f94e9de5d" :activity/id #uuid "3db7337d-a389-5665-8389-d09f94e9de5d" :activity/title "Sums of Squares" :activity/type :activity.type/review :activity/scope 17592186050406 :activity/course 17592186046647 :activity/steps ["step-ad3cd3d3-d40e-5da8-8eb0-d07f1135677a" "step-b482909e-911d-5802-9b01-f344a82c291e" "step-a7895719-cd74-5149-b7a2-f4d6e3aaf4d8"] :activity/first-step "step-ad3cd3d3-d40e-5da8-8eb0-d07f1135677a" :db/ensure [:activity/validate]} {:db/id "step-ad3cd3d3-d40e-5da8-8eb0-d07f1135677a" :step/id #uuid "ad3cd3d3-d40e-5da8-8eb0-d07f1135677a" :step/content 17592186512921 :step/next "step-b482909e-911d-5802-9b01-f344a82c291e" :db/ensure [:step/validate]} {:db/id "step-b482909e-911d-5802-9b01-f344a82c291e" :step/id #uuid "b482909e-911d-5802-9b01-f344a82c291e" :step/content "question-7487be5e-d3cc-5ed9-9625-a2ce92482f7c" :step/next "step-a7895719-cd74-5149-b7a2-f4d6e3aaf4d8" :db/ensure [:step/validate]} {:db/id "step-a7895719-cd74-5149-b7a2-f4d6e3aaf4d8" :step/id #uuid "a7895719-cd74-5149-b7a2-f4d6e3aaf4d8" :step/content "question-17851fea-30ed-54e9-89be-985c48bef200" :db/ensure [:step/validate]} {:db/id 17592186192764 :knowledge-point/questions ["question-c7bf2d22-67db-5bfb-9d76-d999020db50d" "question-6e1139bd-70c8-5172-a11e-474495b10da9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c7bf2d22-67db-5bfb-9d76-d999020db50d" :question/id #uuid "c7bf2d22-67db-5bfb-9d76-d999020db50d" :question/math-academy-id "q-105190" :question/problem "Which of the following sets are open?\n\nI. $[0,15]$\n\nII. $(-3,5]\\cup [6,8)$\n\nIII. $(1,6)$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(1,6)$ is open. The boundary points are $1$, and $6.$ None of them lie in the set.\n\nThe other sets are not open because:\n\n- $[0,15]$ has two boundary points $0$, and $15$, and both of them lie in the set.\n\n- $(-3,5]\\cup [6,8)$ has four boundary points $-3$, $5$, $6$, and $8$, and the points $5$ and $6$ lie in the set.\n\nTherefore, the correct answer is \"III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c9d3d2d-5c89-5028-8119-349ee1ac7225"] :db/ensure [:question/validate]} {:db/id "answer-field-9c9d3d2d-5c89-5028-8119-349ee1ac7225" :answer-field/id #uuid "9c9d3d2d-5c89-5028-8119-349ee1ac7225" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df327c23-f0d8-51b7-8f66-04274266589e" :answer-field/choices ["answer-5ff4f3ba-42e5-570f-bca8-ed45b21cb1f7" "answer-1ed67d77-19b4-542e-9fbf-7d6adca9ad93" "answer-c0c57c73-2803-51dc-b2db-124289558110" "answer-e09f8edf-88de-5e68-86d0-9a2c8f07968e" "answer-df327c23-f0d8-51b7-8f66-04274266589e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ff4f3ba-42e5-570f-bca8-ed45b21cb1f7" :answer/id #uuid "5ff4f3ba-42e5-570f-bca8-ed45b21cb1f7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-1ed67d77-19b4-542e-9fbf-7d6adca9ad93" :answer/id #uuid "1ed67d77-19b4-542e-9fbf-7d6adca9ad93" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-c0c57c73-2803-51dc-b2db-124289558110" :answer/id #uuid "c0c57c73-2803-51dc-b2db-124289558110" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-e09f8edf-88de-5e68-86d0-9a2c8f07968e" :answer/id #uuid "e09f8edf-88de-5e68-86d0-9a2c8f07968e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-df327c23-f0d8-51b7-8f66-04274266589e" :answer/id #uuid "df327c23-f0d8-51b7-8f66-04274266589e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186193325 :question/problem "Which of the following sets are closed?\n\nI. $[1,2]\\cup [3,4]$\n\nII. $[0,1)$\n\nIII. $[0,1)\\cup (1,2]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[1,2]\\cup [3,4]$ is closed. It consists of two parts, where the boundary points are $1,2,3,$ and $4.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $[0,1)$ has a boundary point $1$, which does not lie in the set.\n\n- $[0,1)\\cup (1,2]$ has a boundary point $1$, which does not lie in the set.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186191877 :answer-field/correct 17592186191878 :db/ensure [:answer-field/validate]} {:db/id "question-6e1139bd-70c8-5172-a11e-474495b10da9" :question/id #uuid "6e1139bd-70c8-5172-a11e-474495b10da9" :question/math-academy-id "q-71799" :question/problem "Which of the following sets are open?\n\nI. $(-4,1)$\n\nII. $(2,4)\\cup (5,6)$\n\nIII. $(0,1)\\cup (7,9]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-4,1)$ and $(2,4)\\cup (5,6)$ are open because:\n\n- The boundary points of the set $(-4,1)$ are $-4$, and $1.$ None of them lie in the set.\n\n- The boundary points of the set  $(2,4)\\cup (5,6)$ are $2$, $4$, $5$, and $6.$ None of them lie in the set.\n\nThe other set is not open because $(0,1)\\cup (7,9]$ has four boundary points $0$, $1$, $7$, and $9$, and the point $9$ lies in the set.\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-088f8fb8-c517-5efa-a60f-bfc3f63f3d91"] :db/ensure [:question/validate]} {:db/id "answer-field-088f8fb8-c517-5efa-a60f-bfc3f63f3d91" :answer-field/id #uuid "088f8fb8-c517-5efa-a60f-bfc3f63f3d91" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1ed8fb2e-025d-558e-b734-33e4b83dc4e1" :answer-field/choices ["answer-1ed8fb2e-025d-558e-b734-33e4b83dc4e1" "answer-f302f02f-61a4-575b-9708-5be939245e79" "answer-ab767696-bebf-5e3e-898c-7b6fb784dec2" "answer-fffeb0c3-dc23-57b1-9396-d4b717c58bd3" "answer-0fe60442-b181-5edf-a66e-97f8860604d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ed8fb2e-025d-558e-b734-33e4b83dc4e1" :answer/id #uuid "1ed8fb2e-025d-558e-b734-33e4b83dc4e1" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f302f02f-61a4-575b-9708-5be939245e79" :answer/id #uuid "f302f02f-61a4-575b-9708-5be939245e79" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-ab767696-bebf-5e3e-898c-7b6fb784dec2" :answer/id #uuid "ab767696-bebf-5e3e-898c-7b6fb784dec2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-fffeb0c3-dc23-57b1-9396-d4b717c58bd3" :answer/id #uuid "fffeb0c3-dc23-57b1-9396-d4b717c58bd3" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-0fe60442-b181-5edf-a66e-97f8860604d5" :answer/id #uuid "0fe60442-b181-5edf-a66e-97f8860604d5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186193375 :question/problem "Which of the following sets are open?\n\nI. $(-\\infty ,1]$\n\nII. $(0,1)\\cup (5,6)$\n\nIII. $[-3,-1)\\cup (0,1]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(0,1)\\cup (5,6)$ is open. It consists of two parts, where the boundary points are $0$, $1$, $5$, and $6.$ None of them lie in the set.\n\nThe other sets are not open because:\n\n- $(-\\infty ,1]$ has a boundary point $1$ and it lies in the set.\n\n- $[-3,-1)\\cup (0,1]$ has four boundary points $-3$, $-1$, $0$, and $1$, and the points $-3$ and $1$ lie in the set.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186192177 :answer-field/correct 17592186192179 :db/ensure [:answer-field/validate]} {:db/id 17592186083167 :knowledge-point/questions ["question-488cdf32-d755-59bf-889e-a9cbc58dc41a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-488cdf32-d755-59bf-889e-a9cbc58dc41a" :question/id #uuid "488cdf32-d755-59bf-889e-a9cbc58dc41a" :question/math-academy-id "q-5870" :question/problem "The table below defines the function $f(x).$ Is the function even, odd, or neither?\n\n| **$x$** | $-6$ | $-4$ | $-2$ | $2$ | $4$ | $6$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $85$ | $75$ | $30$ | $-30$ | $-75$ | $-85$ |" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$ in the domain of $f$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$ in the domain of $f$\n\nFor our function, we have\n\n$$\n\\begin{aligned}f(-6) & =85=-f(6), \\\\ f(-4) & =75=-f(4), \\\\ f(-2) & =30=-f(2).\\end{aligned}\n$$\n\nThis means that $f(-x)=-f(x)$ for all $x$ in the domain of the function. Therefore, $f(x)$ is an odd function.\n\n$$\n\\begin{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fb959f88-2ef8-53d8-991e-77e015bb77af"] :db/ensure [:question/validate]} {:db/id "answer-field-fb959f88-2ef8-53d8-991e-77e015bb77af" :answer-field/id #uuid "fb959f88-2ef8-53d8-991e-77e015bb77af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54507137-2751-518f-a7f2-bf1dc9ab044b" :answer-field/choices ["answer-edf6e733-5e69-5efe-8ed4-57ef94ac17ad" "answer-9df12679-6f98-598d-ba66-d0981661d244" "answer-a55644e4-c45b-579a-9be2-0a59b0e03d92" "answer-b754548b-7d8c-5141-94fa-e1ffa626e2bb" "answer-54507137-2751-518f-a7f2-bf1dc9ab044b"] :db/ensure [:answer-field/validate]} {:db/id "answer-edf6e733-5e69-5efe-8ed4-57ef94ac17ad" :answer/id #uuid "edf6e733-5e69-5efe-8ed4-57ef94ac17ad" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-9df12679-6f98-598d-ba66-d0981661d244" :answer/id #uuid "9df12679-6f98-598d-ba66-d0981661d244" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-a55644e4-c45b-579a-9be2-0a59b0e03d92" :answer/id #uuid "a55644e4-c45b-579a-9be2-0a59b0e03d92" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-b754548b-7d8c-5141-94fa-e1ffa626e2bb" :answer/id #uuid "b754548b-7d8c-5141-94fa-e1ffa626e2bb" :answer/type :answer.type/text :answer/value "Neither even nor odd" :db/ensure [:answer/validate]} {:db/id "answer-54507137-2751-518f-a7f2-bf1dc9ab044b" :answer/id #uuid "54507137-2751-518f-a7f2-bf1dc9ab044b" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id 17592186083185 :knowledge-point/questions ["question-81602105-d969-550d-9191-b0d8d8e1aacf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-81602105-d969-550d-9191-b0d8d8e1aacf" :question/id #uuid "81602105-d969-550d-9191-b0d8d8e1aacf" :question/math-academy-id "q-72132" :question/problem "Is the function $f(x)={x}^{3}+8x$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{3}+8(-x) \\\\  & =-{x}^{3}-8x.\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-({x}^{3}+8x) \\\\  & =-{x}^{3}-8x.\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94f1e14e-2d96-586a-93e5-1ee8371fd0d7"] :db/ensure [:question/validate]} {:db/id "answer-field-94f1e14e-2d96-586a-93e5-1ee8371fd0d7" :answer-field/id #uuid "94f1e14e-2d96-586a-93e5-1ee8371fd0d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f24d99a9-b905-5ab2-8163-7cffe9f00a38" :answer-field/choices ["answer-284ae4e5-3a75-512a-96da-43be36b80b67" "answer-17b5c879-2bfc-5ae7-aa01-8fe08c59be91" "answer-7dc2f9cc-543f-5ad1-a14a-7870a7b49c6b" "answer-54a22cd0-e927-5fcf-9c2a-bab375f9af7a" "answer-f24d99a9-b905-5ab2-8163-7cffe9f00a38"] :db/ensure [:answer-field/validate]} {:db/id "answer-284ae4e5-3a75-512a-96da-43be36b80b67" :answer/id #uuid "284ae4e5-3a75-512a-96da-43be36b80b67" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-17b5c879-2bfc-5ae7-aa01-8fe08c59be91" :answer/id #uuid "17b5c879-2bfc-5ae7-aa01-8fe08c59be91" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-7dc2f9cc-543f-5ad1-a14a-7870a7b49c6b" :answer/id #uuid "7dc2f9cc-543f-5ad1-a14a-7870a7b49c6b" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-54a22cd0-e927-5fcf-9c2a-bab375f9af7a" :answer/id #uuid "54a22cd0-e927-5fcf-9c2a-bab375f9af7a" :answer/type :answer.type/text :answer/value "Neither even nor odd" :db/ensure [:answer/validate]} {:db/id "answer-f24d99a9-b905-5ab2-8163-7cffe9f00a38" :answer/id #uuid "f24d99a9-b905-5ab2-8163-7cffe9f00a38" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id 17592186083166 :knowledge-point/questions ["question-422c65f7-5866-5757-b32d-736e922491f4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-422c65f7-5866-5757-b32d-736e922491f4" :question/id #uuid "422c65f7-5866-5757-b32d-736e922491f4" :question/math-academy-id "q-110654" :question/problem "![](images/58/58e4554f6e5081ec5db6876222a7eeea24135743e4b68e25204084e097066ea4.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs II, III, and IV do not have rotational symmetry of order $2$ about the origin. So, it is **not** an odd function.\n\n- On the other hand, graph I does have rotational symmetry about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that graph  I  show odd functions.\n\n![](images/3b/3b5e234a3416a5e7100468b81f170171a873508eb0c87bba126009daca9e49bc.png)\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-050fe5b1-848b-5f4c-879f-6f713c662044"] :db/ensure [:question/validate]} {:db/id "answer-field-050fe5b1-848b-5f4c-879f-6f713c662044" :answer-field/id #uuid "050fe5b1-848b-5f4c-879f-6f713c662044" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e14c93c6-83bb-5c7c-9828-cce9626951e8" :answer-field/choices ["answer-a6b0e609-1235-5fa1-becc-779f66d23762" "answer-e14c93c6-83bb-5c7c-9828-cce9626951e8" "answer-58b55549-1f9a-54cb-ae86-f76e94971508" "answer-c7aedaf8-9103-5c9c-b19c-4b12dccbbfed" "answer-09408971-4d52-596c-8834-deedff8b5844"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6b0e609-1235-5fa1-becc-779f66d23762" :answer/id #uuid "a6b0e609-1235-5fa1-becc-779f66d23762" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-e14c93c6-83bb-5c7c-9828-cce9626951e8" :answer/id #uuid "e14c93c6-83bb-5c7c-9828-cce9626951e8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-58b55549-1f9a-54cb-ae86-f76e94971508" :answer/id #uuid "58b55549-1f9a-54cb-ae86-f76e94971508" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c7aedaf8-9103-5c9c-b19c-4b12dccbbfed" :answer/id #uuid "c7aedaf8-9103-5c9c-b19c-4b12dccbbfed" :answer/type :answer.type/text :answer/value "III and IV only" :db/ensure [:answer/validate]} {:db/id "answer-09408971-4d52-596c-8834-deedff8b5844" :answer/id #uuid "09408971-4d52-596c-8834-deedff8b5844" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-41678cc0-e593-570b-9d61-39b46d08abce" :activity/id #uuid "41678cc0-e593-570b-9d61-39b46d08abce" :activity/title "Even and Odd Functions" :activity/type :activity.type/review :activity/scope 17592186049873 :activity/course 17592186046647 :activity/steps ["step-ded6bb87-7c64-5310-bc38-a96687a81f7e" "step-545bc88a-4a8b-5887-ade6-fe79621432ec" "step-fde45626-5d27-5ac1-aae7-f958ff15be66"] :activity/first-step "step-ded6bb87-7c64-5310-bc38-a96687a81f7e" :db/ensure [:activity/validate]} {:db/id "step-ded6bb87-7c64-5310-bc38-a96687a81f7e" :step/id #uuid "ded6bb87-7c64-5310-bc38-a96687a81f7e" :step/content "question-488cdf32-d755-59bf-889e-a9cbc58dc41a" :step/next "step-545bc88a-4a8b-5887-ade6-fe79621432ec" :db/ensure [:step/validate]} {:db/id "step-545bc88a-4a8b-5887-ade6-fe79621432ec" :step/id #uuid "545bc88a-4a8b-5887-ade6-fe79621432ec" :step/content "question-81602105-d969-550d-9191-b0d8d8e1aacf" :step/next "step-fde45626-5d27-5ac1-aae7-f958ff15be66" :db/ensure [:step/validate]} {:db/id "step-fde45626-5d27-5ac1-aae7-f958ff15be66" :step/id #uuid "fde45626-5d27-5ac1-aae7-f958ff15be66" :step/content "question-422c65f7-5866-5757-b32d-736e922491f4" :db/ensure [:step/validate]} {:db/id 17592186124458 :knowledge-point/questions ["question-d5075c32-f624-572f-a2d3-78616466d14e" "question-f7872fd6-9c54-5e48-b08b-71d8ca0a2063" "question-df6440e4-6b40-5b4e-87c9-62e58eb89d0e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124459 :knowledge-point/questions ["question-ffacb628-f280-51e0-9811-c0f525cc08ac" "question-8889b56a-bb69-56d7-b6a6-42f214a1a3f7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124460 :knowledge-point/questions ["question-0fb365d6-3918-560a-af36-ae398310b595" "question-56172e38-6320-5f34-8b75-aab1067f37e6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d5075c32-f624-572f-a2d3-78616466d14e" :question/id #uuid "d5075c32-f624-572f-a2d3-78616466d14e" :question/math-academy-id "q-86430" :question/problem "Find the directional derivative of the function $f(x,y)=(2{x}^{2}-y)^{2}$ at the point $A(-1,1)$ in the direction towards the point $B(-2,2).$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the direction vector and the corresponding unit vector:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨-2,2⟩-⟨-1,1⟩ \\\\  & =⟨-1,1⟩ \\\\ u & =\\frac{\\overset{\\to }{AB}}{‖\\overset{\\to }{AB}‖} \\\\  & =\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}}}⟨-1,1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-1,1⟩\\end{aligned}\n$$\n\nNow, we calculate the gradient $∇f(x,y)$ and evaluate it at the point $A(-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨\\frac{∂}{∂x}(2{x}^{2}-y)^{2},\\,\\frac{∂}{∂y}(2{x}^{2}-y)^{2}⟩ \\\\  & =⟨16{x}^{3}-8xy,\\,2y-4{x}^{2}⟩ \\\\ ∇f(-1,1) & =⟨16(-1)^{3}-8(-1)(1),\\,2(1)-4(-1)^{2}⟩ \\\\  & =⟨-8,-2⟩\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(-1,1) & =∇f(-1,1)\\cdot u \\\\  & =⟨-8,-2⟩\\cdot ⟨-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩ \\\\  & =(-8)\\cdot (-\\frac{1}{\\sqrt{2}})-2\\cdot (\\frac{1}{\\sqrt{2}}) \\\\  & =\\frac{6}{\\sqrt{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aa2be9cd-8e25-5c22-a57c-dbf36efef798"] :db/ensure [:question/validate]} {:db/id "answer-field-aa2be9cd-8e25-5c22-a57c-dbf36efef798" :answer-field/id #uuid "aa2be9cd-8e25-5c22-a57c-dbf36efef798" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-da9987fb-7331-55ac-8916-60a446822552" :answer-field/choices ["answer-00433fb2-2689-50b6-b5ae-b3213b484e7d" "answer-bc4239ca-8453-592c-a801-dc055bf9ad37" "answer-da9987fb-7331-55ac-8916-60a446822552" "answer-c97f5424-984d-5602-8981-349f5455aec9" "answer-81f0d8bc-19f0-5e3d-ad6f-8e1c66829afd"] :db/ensure [:answer-field/validate]} {:db/id "answer-00433fb2-2689-50b6-b5ae-b3213b484e7d" :answer/id #uuid "00433fb2-2689-50b6-b5ae-b3213b484e7d" :answer/type :answer.type/math :answer/value "-3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-bc4239ca-8453-592c-a801-dc055bf9ad37" :answer/id #uuid "bc4239ca-8453-592c-a801-dc055bf9ad37" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-da9987fb-7331-55ac-8916-60a446822552" :answer/id #uuid "da9987fb-7331-55ac-8916-60a446822552" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-c97f5424-984d-5602-8981-349f5455aec9" :answer/id #uuid "c97f5424-984d-5602-8981-349f5455aec9" :answer/type :answer.type/math :answer/value "6\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-81f0d8bc-19f0-5e3d-ad6f-8e1c66829afd" :answer/id #uuid "81f0d8bc-19f0-5e3d-ad6f-8e1c66829afd" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "question-f7872fd6-9c54-5e48-b08b-71d8ca0a2063" :question/id #uuid "f7872fd6-9c54-5e48-b08b-71d8ca0a2063" :question/math-academy-id "q-83552" :question/problem "Find the directional derivative of the function $f(x,y)=x\\operatorname{ln}⁡y+y\\operatorname{ln}⁡x$ at the point $(1,1)$ in the direction of the vector $v=2i+j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{2}^{2}+{1}^{2}}=\\sqrt{5} \\\\ u & =\\frac{1}{\\sqrt{5}}(2i+j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y+y\\operatorname{ln}⁡x)\\text{ }i+\\frac{∂}{∂y}(x\\operatorname{ln}⁡y+y\\operatorname{ln}⁡x)\\text{ }j \\\\  & =(\\operatorname{ln}⁡y+\\frac{y}{x})\\,i+(\\frac{x}{y}+\\operatorname{ln}⁡x)\\,j \\\\ ∇\\,f(1,1) & =(\\operatorname{ln}⁡1+\\frac{1}{1})\\,i+(\\frac{1}{1}+\\operatorname{ln}⁡1)\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(1,1) & =∇\\,f(1,1)\\cdot u \\\\  & =(i+j)\\cdot (\\frac{2}{\\sqrt{5}}i+\\frac{1}{\\sqrt{5}}j) \\\\  & =\\frac{1\\cdot 2+1\\cdot 1}{\\sqrt{5}} \\\\  & =\\frac{3\\sqrt{5}}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5f6b8a55-8b0f-5157-98ff-b7ec894bdaee"] :db/ensure [:question/validate]} {:db/id "answer-field-5f6b8a55-8b0f-5157-98ff-b7ec894bdaee" :answer-field/id #uuid "5f6b8a55-8b0f-5157-98ff-b7ec894bdaee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ea52a0e-e6a5-522f-8a2f-e28cb7fa9518" :answer-field/choices ["answer-48b88652-e6ed-5cdf-94e0-9c52630df3e3" "answer-2ea52a0e-e6a5-522f-8a2f-e28cb7fa9518" "answer-804a3d7f-93d1-5460-9e8a-4cea93ac58d2" "answer-0c8383c9-5a00-5106-8ade-ebcb1afc1644" "answer-68b0f87b-d56a-5e56-bcb2-6c135e0e44a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-48b88652-e6ed-5cdf-94e0-9c52630df3e3" :answer/id #uuid "48b88652-e6ed-5cdf-94e0-9c52630df3e3" :answer/type :answer.type/math :answer/value "3\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-2ea52a0e-e6a5-522f-8a2f-e28cb7fa9518" :answer/id #uuid "2ea52a0e-e6a5-522f-8a2f-e28cb7fa9518" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-804a3d7f-93d1-5460-9e8a-4cea93ac58d2" :answer/id #uuid "804a3d7f-93d1-5460-9e8a-4cea93ac58d2" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-0c8383c9-5a00-5106-8ade-ebcb1afc1644" :answer/id #uuid "0c8383c9-5a00-5106-8ade-ebcb1afc1644" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-68b0f87b-d56a-5e56-bcb2-6c135e0e44a4" :answer/id #uuid "68b0f87b-d56a-5e56-bcb2-6c135e0e44a4" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "question-df6440e4-6b40-5b4e-87c9-62e58eb89d0e" :question/id #uuid "df6440e4-6b40-5b4e-87c9-62e58eb89d0e" :question/math-academy-id "q-130258" :question/problem "Find the directional derivative of the function $f(x,y)={x}^{2}-6xy+{y}^{2}$ at the point $(-1,3)$ in the direction of the vector $v=i+j.$" :question/worked-solution "The directional derivative ${f}_{u}^{′}(a,b)$ of a function $f(x,y)$ at the point $(a,b)$ in the direction of the vector $v$ is given by\n\n$$\n{f}_{u}^{′}(a,b)=∇f(a,b)\\cdot u\n$$\n\nwhere $u$ is a unit vector in the direction of $v.$\n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{1}^{2}+{1}^{2}}=\\sqrt{2} \\\\ u & =\\frac{1}{\\sqrt{2}}(i+j)\\end{aligned}\n$$\n\nNow, we compute the gradient $∇f(x,y)$ and evaluate it at the point $(-1,3):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & =\\frac{∂}{∂x}({x}^{2}-6xy+{y}^{2})\\text{ }i+\\frac{∂}{∂y}({x}^{2}-6xy+{y}^{2})\\text{ }j \\\\  & =(2x-6y)\\,i+(2y-6x)j \\\\ ∇\\,f(-1,3) & =(2(-1)-6(3))\\,i+(2(3)-6(-1))j \\\\  & =-20\\,i+12\\,j\\end{aligned}\n$$\n\nTherefore, the directional derivative is\n\n$$\n\\begin{aligned}{f}_{u}^{′}(-1,3) & =∇\\,f(-1,3)\\cdot u \\\\  & =(-20\\,i+12\\,j)\\cdot \\frac{1}{\\sqrt{2}}(i+j) \\\\  & =\\frac{-20(1)+12(1)}{\\sqrt{2}} \\\\  & =-\\frac{8}{\\sqrt{2}} \\\\  & =-4\\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-235850d9-4b74-5c62-9d1d-41026c4c9828"] :db/ensure [:question/validate]} {:db/id "answer-field-235850d9-4b74-5c62-9d1d-41026c4c9828" :answer-field/id #uuid "235850d9-4b74-5c62-9d1d-41026c4c9828" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3293ed3c-f84a-5bdd-b26a-c1ac19d7d55f" :answer-field/choices ["answer-04dcdfb7-813c-5013-92a6-1f6a2e40d34a" "answer-3293ed3c-f84a-5bdd-b26a-c1ac19d7d55f" "answer-992d4136-ab07-5324-b78a-7177af5b18ce" "answer-7d25f5da-9280-508e-a834-dd75fe932211" "answer-6635b13b-ede2-5436-984d-23828cf04773"] :db/ensure [:answer-field/validate]} {:db/id "answer-04dcdfb7-813c-5013-92a6-1f6a2e40d34a" :answer/id #uuid "04dcdfb7-813c-5013-92a6-1f6a2e40d34a" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-3293ed3c-f84a-5bdd-b26a-c1ac19d7d55f" :answer/id #uuid "3293ed3c-f84a-5bdd-b26a-c1ac19d7d55f" :answer/type :answer.type/math :answer/value "-4\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-992d4136-ab07-5324-b78a-7177af5b18ce" :answer/id #uuid "992d4136-ab07-5324-b78a-7177af5b18ce" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-7d25f5da-9280-508e-a834-dd75fe932211" :answer/id #uuid "7d25f5da-9280-508e-a834-dd75fe932211" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-6635b13b-ede2-5436-984d-23828cf04773" :answer/id #uuid "6635b13b-ede2-5436-984d-23828cf04773" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "question-ffacb628-f280-51e0-9811-c0f525cc08ac" :question/id #uuid "ffacb628-f280-51e0-9811-c0f525cc08ac" :question/math-academy-id "q-83591" :question/problem "In what direction does the function $f(x,y)=x\\operatorname{tan}⁡y+2{x}^{2}-\\operatorname{ln}⁡x$ decrease most rapidly at the point $(1,\\frac{\\pi }{4})?$" :question/worked-solution "At a given point, a function $f(x,y)$ decreases most rapidly in the direction opposite to that of its gradient.\n\nSo, we compute $-∇f(x,y)$ and evaluate it at the point $(1,\\frac{\\pi }{4}):$\n\n$$\n\\begin{aligned}-∇f(x,y) & =-\\frac{∂}{∂x}(x\\operatorname{tan}⁡y+2{x}^{2}-\\operatorname{ln}⁡x)\\text{ }i-\\frac{∂}{∂y}(x\\operatorname{tan}⁡y+2{x}^{2}-\\operatorname{ln}⁡x)\\text{ }j \\\\  & =-(\\operatorname{tan}⁡y+4x-\\frac{1}{x})i-x{sec}^{2}⁡y\\text{ }j \\\\ -∇f(1,\\frac{\\pi }{4}) & =-(\\operatorname{tan}⁡(\\frac{\\pi }{4})+4\\cdot 1-\\frac{1}{1})i-1\\cdot {sec}^{2}⁡(\\frac{\\pi }{4})\\text{ }j \\\\  & =-4\\,i-2\\,j\\end{aligned}\n$$\n\nTherefore, the function decreases most rapidly in the direction of $-4\\,i-2\\,j.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fe69802c-24d6-5c9a-b43c-e07a25e5de2d"] :db/ensure [:question/validate]} {:db/id "answer-field-fe69802c-24d6-5c9a-b43c-e07a25e5de2d" :answer-field/id #uuid "fe69802c-24d6-5c9a-b43c-e07a25e5de2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-96c6d7cb-49e7-5e45-b566-508c8a442dec" :answer-field/choices ["answer-57ea209f-e155-526a-94ca-0d966c493e42" "answer-96c6d7cb-49e7-5e45-b566-508c8a442dec" "answer-d18ea431-dd2b-59ac-94dc-2a47eca46a91" "answer-9f5e6c1e-a123-5805-9a48-ff55d4732a4f" "answer-b3791795-25ea-52db-9a06-ea2ad48e2ced"] :db/ensure [:answer-field/validate]} {:db/id "answer-57ea209f-e155-526a-94ca-0d966c493e42" :answer/id #uuid "57ea209f-e155-526a-94ca-0d966c493e42" :answer/type :answer.type/math :answer/value "-2\\,i+\\frac{1}{4}\\,j" :db/ensure [:answer/validate]} {:db/id "answer-96c6d7cb-49e7-5e45-b566-508c8a442dec" :answer/id #uuid "96c6d7cb-49e7-5e45-b566-508c8a442dec" :answer/type :answer.type/math :answer/value "-4\\,i-2\\,j" :db/ensure [:answer/validate]} {:db/id "answer-d18ea431-dd2b-59ac-94dc-2a47eca46a91" :answer/id #uuid "d18ea431-dd2b-59ac-94dc-2a47eca46a91" :answer/type :answer.type/math :answer/value "-4\\,i-\\frac{1}{2}\\,j" :db/ensure [:answer/validate]} {:db/id "answer-9f5e6c1e-a123-5805-9a48-ff55d4732a4f" :answer/id #uuid "9f5e6c1e-a123-5805-9a48-ff55d4732a4f" :answer/type :answer.type/math :answer/value "-6\\,i-\\frac{\\sqrt{2}}{2}\\,j" :db/ensure [:answer/validate]} {:db/id "answer-b3791795-25ea-52db-9a06-ea2ad48e2ced" :answer/id #uuid "b3791795-25ea-52db-9a06-ea2ad48e2ced" :answer/type :answer.type/math :answer/value "4\\,i-\\frac{1}{2}\\,j" :db/ensure [:answer/validate]} {:db/id "question-8889b56a-bb69-56d7-b6a6-42f214a1a3f7" :question/id #uuid "8889b56a-bb69-56d7-b6a6-42f214a1a3f7" :question/math-academy-id "q-130270" :question/problem "In what direction does the function $g(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}-xyz$ increase most rapidly at the point $(1,0,-2)?$" :question/worked-solution "At a given point, a function $g(x,y,z)$ increases most rapidly in the direction of its gradient at that point.\n\nSo, we compute $∇g(x,y,z)$ and evaluate it at the point $(1,0,-2):$\n\n$$\n\\begin{aligned}∇g(x,y,z) & =⟨\\frac{∂}{∂x}({x}^{2}+{y}^{2}+{z}^{2}-xyz),\\,\\frac{∂}{∂y}({x}^{2}+{y}^{2}+{z}^{2}-xyz),\\,\\frac{∂}{∂z}({x}^{2}+{y}^{2}+{z}^{2}-xyz)⟩ \\\\  & =⟨2x-yz,\\,2y-xz,\\,2z-xy⟩ \\\\ ∇g(1,0,-2) & =⟨2(1)-0(-2),2(0)-1(-2),2(-2)-1(0)⟩ \\\\  & =⟨2,2,-4⟩\\end{aligned}\n$$\n\nTherefore, the function increases most rapidly in the direction of $⟨2,2,-4⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ff3c854a-2ec4-5aac-9265-718757aee35e"] :db/ensure [:question/validate]} {:db/id "answer-field-ff3c854a-2ec4-5aac-9265-718757aee35e" :answer-field/id #uuid "ff3c854a-2ec4-5aac-9265-718757aee35e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c90851b6-ccde-53db-beb3-491291ef5d9b" :answer-field/choices ["answer-352ad72c-95f5-5fae-a15a-05da0c1da3cc" "answer-1e39c336-a544-5c66-93cf-3ffb2d7f86bf" "answer-53343afc-152e-5acb-9d54-08cb170116b5" "answer-053be929-7775-5fb0-bbbd-3704056bc94e" "answer-c90851b6-ccde-53db-beb3-491291ef5d9b"] :db/ensure [:answer-field/validate]} {:db/id "answer-352ad72c-95f5-5fae-a15a-05da0c1da3cc" :answer/id #uuid "352ad72c-95f5-5fae-a15a-05da0c1da3cc" :answer/type :answer.type/math :answer/value "⟨-1,-1,2⟩" :db/ensure [:answer/validate]} {:db/id "answer-1e39c336-a544-5c66-93cf-3ffb2d7f86bf" :answer/id #uuid "1e39c336-a544-5c66-93cf-3ffb2d7f86bf" :answer/type :answer.type/math :answer/value "⟨0,2,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-53343afc-152e-5acb-9d54-08cb170116b5" :answer/id #uuid "53343afc-152e-5acb-9d54-08cb170116b5" :answer/type :answer.type/math :answer/value "⟨1,-2,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-053be929-7775-5fb0-bbbd-3704056bc94e" :answer/id #uuid "053be929-7775-5fb0-bbbd-3704056bc94e" :answer/type :answer.type/math :answer/value "⟨1,0,-2⟩" :db/ensure [:answer/validate]} {:db/id "answer-c90851b6-ccde-53db-beb3-491291ef5d9b" :answer/id #uuid "c90851b6-ccde-53db-beb3-491291ef5d9b" :answer/type :answer.type/math :answer/value "⟨2,2,-4⟩" :db/ensure [:answer/validate]} {:db/id "question-0fb365d6-3918-560a-af36-ae398310b595" :question/id #uuid "0fb365d6-3918-560a-af36-ae398310b595" :question/math-academy-id "q-130802" :question/problem "Consider the function $g(x,y)={y}^{x}.$ What is the rate of change of $g(x,y)$ at the point $(1,e)$ in the direction of the vector $v=⟨4,-3⟩?$" :question/worked-solution "The rate of change of $g(x,y)$ at the point $(1,e)$ in the direction of $v$ is equal to the directional derivative ${g}_{u}^{′}(1,e).$ \n\nFirst, we find the unit vector $u$ in the direction of $v:$\n\n$$\n\\begin{aligned}‖v‖ & =\\sqrt{{4}^{2}+(-3)^{2}}=5 \\\\ u & =\\frac{1}{5}⟨4,-3⟩\\end{aligned}\n$$\n\nNow, we find the gradient $∇g(x,y)$ and evaluate it at the point $(1,e):$\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨\\frac{∂}{∂x}({y}^{x}),\\,\\frac{∂}{∂y}({y}^{x})⟩ \\\\  & =⟨{y}^{x}\\operatorname{ln}⁡y,\\,x{y}^{x-1}⟩ \\\\ ∇g(1,e) & =⟨{e}^{1}\\operatorname{ln}⁡e,1{e}^{1-1}⟩ \\\\  & =⟨e,1⟩\\end{aligned}\n$$\n\nFinally, the directional derivative ${g}_{u}^{′}(1,e)$ is\n\n$$\n\\begin{aligned}{g}_{u}^{′}(1,e) & =∇g(1,e)\\cdot u \\\\  & =⟨e,1⟩\\cdot \\frac{1}{5}⟨4,-3⟩ \\\\  & =\\frac{e(4)+1(-3)}{5} \\\\  & =\\frac{4e-3}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-75da4e92-2341-5f89-a517-37e979e4303c"] :db/ensure [:question/validate]} {:db/id "answer-field-75da4e92-2341-5f89-a517-37e979e4303c" :answer-field/id #uuid "75da4e92-2341-5f89-a517-37e979e4303c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-605a4f94-5783-5014-8c0c-c25bbcb39d7b" :answer-field/choices ["answer-e79adf25-7969-5327-8be1-24d409ff0b06" "answer-5c6bd500-a363-5876-8fc0-e3190803b613" "answer-5aa574d4-0537-5c0c-bc48-fbc415d1fec3" "answer-83f43442-0622-5df7-8058-787b935ebf97" "answer-605a4f94-5783-5014-8c0c-c25bbcb39d7b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e79adf25-7969-5327-8be1-24d409ff0b06" :answer/id #uuid "e79adf25-7969-5327-8be1-24d409ff0b06" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-5c6bd500-a363-5876-8fc0-e3190803b613" :answer/id #uuid "5c6bd500-a363-5876-8fc0-e3190803b613" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5aa574d4-0537-5c0c-bc48-fbc415d1fec3" :answer/id #uuid "5aa574d4-0537-5c0c-bc48-fbc415d1fec3" :answer/type :answer.type/math :answer/value "2e+3" :db/ensure [:answer/validate]} {:db/id "answer-83f43442-0622-5df7-8058-787b935ebf97" :answer/id #uuid "83f43442-0622-5df7-8058-787b935ebf97" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-605a4f94-5783-5014-8c0c-c25bbcb39d7b" :answer/id #uuid "605a4f94-5783-5014-8c0c-c25bbcb39d7b" :answer/type :answer.type/math :answer/value "\\frac{4e-3}{5}" :db/ensure [:answer/validate]} {:db/id "question-56172e38-6320-5f34-8b75-aab1067f37e6" :question/id #uuid "56172e38-6320-5f34-8b75-aab1067f37e6" :question/math-academy-id "q-86543" :question/problem "Consider the function $g(x,y)=\\operatorname{ln}⁡({y}^{2}\\operatorname{cos}⁡x).$ What is the rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},4)$ in the direction in which the function increases most rapidly?" :question/worked-solution "At a given point, a function $g(x,y)$ increases most rapidly in the direction of its gradient at that point.\n\nIn our case, we compute $∇g(x,y)$ and evaluate it at the point $(\\frac{\\pi }{4},4):$\n\n$$\n\\begin{aligned}∇\\,g(x,y) & =⟨\\frac{∂}{∂x}(\\operatorname{ln}⁡({y}^{2}\\operatorname{cos}⁡x)),\\,\\frac{∂}{∂y}(\\operatorname{ln}⁡({y}^{2}\\operatorname{cos}⁡x))⟩ \\\\  & =⟨-\\operatorname{tan}⁡x,\\,\\frac{2}{y}⟩ \\\\ ∇\\,g(\\frac{\\pi }{4},4) & =⟨-\\operatorname{tan}⁡(\\frac{\\pi }{4}),\\,\\frac{2}{4}⟩ \\\\  & =⟨-1,\\,\\frac{1}{2}⟩\\end{aligned}\n$$\n\nFinally, the rate of change of $g(x,y)$ at the point $(\\frac{\\pi }{4},4)$ in the direction of $∇g(\\frac{\\pi }{4},4)$ is given by\n\n$$\n\\begin{aligned}‖∇\\,g(\\frac{\\pi }{4},4)‖ & =‖⟨-1,\\frac{1}{2}⟩‖ \\\\  & =\\sqrt{1+\\frac{1}{4}} \\\\  & =\\sqrt{\\frac{5}{4}} \\\\  & =\\frac{\\sqrt{5}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-45ab83aa-a438-50c5-87d1-85ddbe0b15e9"] :db/ensure [:question/validate]} {:db/id "answer-field-45ab83aa-a438-50c5-87d1-85ddbe0b15e9" :answer-field/id #uuid "45ab83aa-a438-50c5-87d1-85ddbe0b15e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd1cc6cd-5009-53a5-9550-f7f07275d8a5" :answer-field/choices ["answer-a937d5cd-9309-5b00-a446-cdfd649551b2" "answer-e69a9ba3-ccae-56d8-8e5f-5d06921f70e9" "answer-189ec891-a762-54dd-8e28-66f7d86f7621" "answer-cd1cc6cd-5009-53a5-9550-f7f07275d8a5" "answer-b2d80ddb-b0ea-50ab-81d2-6892d56e013c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a937d5cd-9309-5b00-a446-cdfd649551b2" :answer/id #uuid "a937d5cd-9309-5b00-a446-cdfd649551b2" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e69a9ba3-ccae-56d8-8e5f-5d06921f70e9" :answer/id #uuid "e69a9ba3-ccae-56d8-8e5f-5d06921f70e9" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-189ec891-a762-54dd-8e28-66f7d86f7621" :answer/id #uuid "189ec891-a762-54dd-8e28-66f7d86f7621" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-cd1cc6cd-5009-53a5-9550-f7f07275d8a5" :answer/id #uuid "cd1cc6cd-5009-53a5-9550-f7f07275d8a5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b2d80ddb-b0ea-50ab-81d2-6892d56e013c" :answer/id #uuid "b2d80ddb-b0ea-50ab-81d2-6892d56e013c" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{4}" :db/ensure [:answer/validate]}]
