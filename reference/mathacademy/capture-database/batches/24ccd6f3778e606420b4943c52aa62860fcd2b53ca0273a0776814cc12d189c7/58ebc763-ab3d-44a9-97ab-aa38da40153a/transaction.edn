5" "answer-dac1018b-4417-5222-82ba-3c287ae4438a"] :db/ensure [:answer-field/validate]} {:db/id "answer-91b7ccf3-5bfc-5ce8-919f-a98b77646a71" :answer/id #uuid "91b7ccf3-5bfc-5ce8-919f-a98b77646a71" :answer/type :answer.type/text :answer/value "$10\\,\\frac{1}{2}$ cups" :db/ensure [:answer/validate]} {:db/id "answer-7ce1b0b9-e11a-5126-81c3-75bdd87e6fe4" :answer/id #uuid "7ce1b0b9-e11a-5126-81c3-75bdd87e6fe4" :answer/type :answer.type/text :answer/value "$11\\,\\frac{1}{2}$ cups" :db/ensure [:answer/validate]} {:db/id "answer-74f300fc-a4cc-5903-b3a9-c5c9c3e1f4e5" :answer/id #uuid "74f300fc-a4cc-5903-b3a9-c5c9c3e1f4e5" :answer/type :answer.type/text :answer/value "$12\\,\\frac{1}{2}$ cups" :db/ensure [:answer/validate]} {:db/id "answer-5792a8b4-8924-5147-9d55-c30ccd005655" :answer/id #uuid "5792a8b4-8924-5147-9d55-c30ccd005655" :answer/type :answer.type/text :answer/value "$13\\,\\frac{1}{2}$ cups" :db/ensure [:answer/validate]} {:db/id "answer-dac1018b-4417-5222-82ba-3c287ae4438a" :answer/id #uuid "dac1018b-4417-5222-82ba-3c287ae4438a" :answer/type :answer.type/text :answer/value "$14\\,\\frac{1}{2}$ cups" :db/ensure [:answer/validate]} {:db/id 17592186184809 :question/problem "Fred is $4\\,\\frac{1}{2}\\,\\text{ft}$ tall. Julie is $\\frac{4}{5}$ of Fred's height. How tall is Julie?" :question/worked-solution "To find out Julie's height, we need to calculate $4\\,\\frac{1}{2}\\times \\frac{4}{5}.$\n\nFirst, we write $4\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n4\\,\\frac{1}{2}=\\frac{(4\\times 2)+1}{2}=\\frac{9}{2}\n$$\n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{9}{2}\\times \\frac{4}{5}\n$$\n\nNotice that the first fraction's denominator ($2$) and the second fraction's numerator ($4$) have a common \nfactor of $2.$ \n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{9}{2}\\times \\frac{4}{5} & =\\frac{9}{5}\\times \\frac{4}{2} \\\\  & =\\frac{9}{5}\\times \\frac{2}{1} \\\\  & =\\frac{9\\times 2}{5\\times 1} \\\\  & =\\frac{18}{5}\\end{aligned}\n$$\n\nFinally, converting this to a mixed number, we get\n\n$$\n18÷5=3\\,\\text{R}\\,3=3\\,\\frac{3}{5}.\n$$\n\nSo, Julie is $3\\,\\frac{3}{5}\\,\\text{ft}$ tall." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186183463 :answer-field/correct "answer-17e6a7d5-71e0-5bbc-821b-dbe1461bb350" :answer-field/choices ["answer-d76ffbc9-7805-5ab5-bba9-30ddcd54b0bf" "answer-17e6a7d5-71e0-5bbc-821b-dbe1461bb350" "answer-57da555e-68b6-5fa2-b13b-dee74f0e9b97" "answer-96ff3fe5-bc70-55f3-823c-889e467c771f" "answer-7b25dd3f-f250-5233-ac64-082fc0ce89df"] :db/ensure [:answer-field/validate]} {:db/id "answer-d76ffbc9-7805-5ab5-bba9-30ddcd54b0bf" :answer/id #uuid "d76ffbc9-7805-5ab5-bba9-30ddcd54b0bf" :answer/type :answer.type/math :answer/value "3\\,\\frac{2}{5}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-17e6a7d5-71e0-5bbc-821b-dbe1461bb350" :answer/id #uuid "17e6a7d5-71e0-5bbc-821b-dbe1461bb350" :answer/type :answer.type/math :answer/value "3\\,\\frac{3}{5}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-57da555e-68b6-5fa2-b13b-dee74f0e9b97" :answer/id #uuid "57da555e-68b6-5fa2-b13b-dee74f0e9b97" :answer/type :answer.type/math :answer/value "3\\,\\frac{4}{5}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-96ff3fe5-bc70-55f3-823c-889e467c771f" :answer/id #uuid "96ff3fe5-bc70-55f3-823c-889e467c771f" :answer/type :answer.type/math :answer/value "3\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-7b25dd3f-f250-5233-ac64-082fc0ce89df" :answer/id #uuid "7b25dd3f-f250-5233-ac64-082fc0ce89df" :answer/type :answer.type/math :answer/value "4\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "question-7c7467de-330b-5939-83a9-4571e046a2da" :question/id #uuid "7c7467de-330b-5939-83a9-4571e046a2da" :question/math-academy-id "q-60535" :question/problem "A country road is $2\\,\\frac{1}{2}\\,\\text{mi}$ long. If $\\frac{3}{4}$ of it is paved with asphalt, how long is the paved part?" :question/worked-solution "To find out the length of the paved part of the road, we need to calculate $2\\,\\frac{1}{2}\\times \\frac{3}{4}.$ \n\nFirst, we write $2\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{2}=\\frac{(2\\times 2)+1}{2}=\\frac{5}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{5}{2}\\times \\frac{3}{4}=\\frac{5\\times 3}{2\\times 4}=\\frac{15}{8}\n$$\n\nFinally, by converting this fraction to a mixed number, we get\n\n$$\n15÷8=1\\,\\text{R}\\,7=1\\,\\frac{7}{8}.\n$$\n\nSo, the paved part of the road is $1\\,\\frac{7}{8}\\,\\text{mi}$ long." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cc4270c3-9d05-590f-ac4c-442b755be0bb"] :db/ensure [:question/validate]} {:db/id "answer-field-cc4270c3-9d05-590f-ac4c-442b755be0bb" :answer-field/id #uuid "cc4270c3-9d05-590f-ac4c-442b755be0bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f26b7497-f839-5917-8900-4c877fea7302" :answer-field/choices ["answer-c8eb3508-f619-5116-9486-e669b794a1b1" "answer-145fc0da-b7aa-5abe-8ab2-177b4bf37048" "answer-f26b7497-f839-5917-8900-4c877fea7302" "answer-3800f64f-a7fd-5fab-a59c-c39bbfe1c084" "answer-23b745be-1845-5881-ae0c-4d6185edc055"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8eb3508-f619-5116-9486-e669b794a1b1" :answer/id #uuid "c8eb3508-f619-5116-9486-e669b794a1b1" :answer/type :answer.type/math :answer/value "1\\,\\frac{1}{2}\\,\\text{mi}" :db/ensure [:answer/validate]} {:db/id "answer-145fc0da-b7aa-5abe-8ab2-177b4bf37048" :answer/id #uuid "145fc0da-b7aa-5abe-8ab2-177b4bf37048" :answer/type :answer.type/math :answer/value "1\\,\\frac{3}{4}\\,\\text{mi}" :db/ensure [:answer/validate]} {:db/id "answer-f26b7497-f839-5917-8900-4c877fea7302" :answer/id #uuid "f26b7497-f839-5917-8900-4c877fea7302" :answer/type :answer.type/math :answer/value "1\\,\\frac{7}{8}\\,\\text{mi}" :db/ensure [:answer/validate]} {:db/id "answer-3800f64f-a7fd-5fab-a59c-c39bbfe1c084" :answer/id #uuid "3800f64f-a7fd-5fab-a59c-c39bbfe1c084" :answer/type :answer.type/math :answer/value "2\\,\\frac{3}{8}\\,\\text{mi}" :db/ensure [:answer/validate]} {:db/id "answer-23b745be-1845-5881-ae0c-4d6185edc055" :answer/id #uuid "23b745be-1845-5881-ae0c-4d6185edc055" :answer/type :answer.type/math :answer/value "2\\,\\frac{5}{8}\\,\\text{mi}" :db/ensure [:answer/validate]} {:db/id 17592186184818 :question/problem "A box of cornflakes cereal weighs $1\\frac{1}{2}\\,\\text{oz}.$ Last week, Debby ate $2$ full boxes and another box which was only $\\frac{1}{4}$ full. How many ounces of this cereal did Debby eat in total?" :question/worked-solution "Notice that Debby had $2+\\frac{1}{4}=2\\,\\frac{1}{4}$ boxes of cornflakes. So, to find out the total weight, we need to calculate $1\\,\\frac{1}{2}\\times 2\\,\\frac{1}{4}.$\n\nFirst, we write  $1\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n1\\,\\frac{1}{2}=\\frac{(1\\times 2)+1}{2}=\\frac{3}{2}\n$$\n\nWe also write $2\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{4}=\\frac{(2\\times 4)+1}{4}=\\frac{9}{4}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{3}{2}\\times \\frac{9}{4}=\\frac{3\\times 9}{2\\times 8}=\\frac{27}{8}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{27}{8}=3\\,\\text{R}\\,3=3\\,\\frac{3}{8}\n$$\n\nSo, Debby ate a total of $3\\,\\frac{3}{8}\\,\\text{oz}$ of cornflakes cereal." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186183517 :answer-field/correct "answer-34d3b599-fe88-57be-8f39-d8fc532b0060" :answer-field/choices ["answer-9dad3397-6218-5978-83c9-3f31dd0a3330" "answer-17ff12d1-0b1c-5615-8879-4f1628cbf97c" "answer-e38fc58a-3f60-52da-a6a5-b7ac046c04d5" "answer-80c0f712-b0d7-53bd-9f2f-3a8efb1b1cca" "answer-34d3b599-fe88-57be-8f39-d8fc532b0060"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dad3397-6218-5978-83c9-3f31dd0a3330" :answer/id #uuid "9dad3397-6218-5978-83c9-3f31dd0a3330" :answer/type :answer.type/math :answer/value "2\\,\\frac{1}{8}\\,\\text{oz}" :db/ensure [:answer/validate]} {:db/id "answer-17ff12d1-0b1c-5615-8879-4f1628cbf97c" :answer/id #uuid "17ff12d1-0b1c-5615-8879-4f1628cbf97c" :answer/type :answer.type/math :answer/value "2\\,\\frac{5}{8}\\,\\text{oz}" :db/ensure [:answer/validate]} {:db/id "answer-e38fc58a-3f60-52da-a6a5-b7ac046c04d5" :answer/id #uuid "e38fc58a-3f60-52da-a6a5-b7ac046c04d5" :answer/type :answer.type/math :answer/value "2\\,\\frac{7}{8}\\,\\text{oz}" :db/ensure [:answer/validate]} {:db/id "answer-80c0f712-b0d7-53bd-9f2f-3a8efb1b1cca" :answer/id #uuid "80c0f712-b0d7-53bd-9f2f-3a8efb1b1cca" :answer/type :answer.type/math :answer/value "3\\,\\frac{1}{8}\\,\\text{oz}" :db/ensure [:answer/validate]} {:db/id "answer-34d3b599-fe88-57be-8f39-d8fc532b0060" :answer/id #uuid "34d3b599-fe88-57be-8f39-d8fc532b0060" :answer/type :answer.type/math :answer/value "3\\,\\frac{3}{8}\\,\\text{oz}" :db/ensure [:answer/validate]} {:db/id "question-222813e8-d21a-59ba-b697-7bcb16bc7844" :question/id #uuid "222813e8-d21a-59ba-b697-7bcb16bc7844" :question/math-academy-id "q-60612" :question/problem "A can of bitter lemon drink contains $1\\,\\frac{2}{3}\\,\\text{g}$ of sugar. If Phil drank $1$ whole can and $\\frac{3}{5}$ of a second can, how many grams of sugar did he drink?" :question/worked-solution "Notice that Phil drank a total of $1+\\frac{3}{5}=1\\,\\frac{3}{5}$ cans of the beverage. So, to find out how many grams of sugar he drank, we need to calculate $1\\,\\frac{2}{3}\\times 1\\,\\frac{3}{5}.$    \n\nFirst, we write  $1\\,\\frac{2}{3}$ as an improper fraction:\n\n$$\n1\\,\\frac{2}{3}=\\frac{(1\\times 3)+2}{3}=\\frac{5}{3}\n$$\n\nWe also write $1\\,\\frac{3}{5}$ as an improper fraction:\n\n$$\n1\\,\\frac{3}{5}=\\frac{(1\\times 5)+3}{5}=\\frac{8}{5}\n$$\n\nSo now, we need to solve the following multiplication problem:\n\n$$\n\\frac{5}{3}\\times \\frac{8}{5}\n$$\n\nNotice that the first fraction's numerator ($5$) and the second fraction's denominator ($5$) have a common factor of $5.$\n\nTherefore, we can simplify our problem by swapping the denominators first and then multiplying the resulting fractions:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\times \\frac{8}{5} & =\\frac{5}{5}\\times \\frac{8}{3} \\\\  & =1\\times \\frac{8}{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{8}{3}=2\\,\\text{R}\\,2=2\\,\\frac{2}{3}\n$$\n\nSo, Phil drank $2\\,\\frac{2}{3}\\,\\text{g}$ of sugar." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-390deacb-80eb-5c32-93dc-2caad56c72e5"] :db/ensure [:question/validate]} {:db/id "answer-field-390deacb-80eb-5c32-93dc-2caad56c72e5" :answer-field/id #uuid "390deacb-80eb-5c32-93dc-2caad56c72e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fbea6d94-3174-559e-8095-4488656b9a55" :answer-field/choices ["answer-69cfebc1-0895-5011-b698-23c2db2dafb7" "answer-7b97cea5-6bcf-5b68-975e-af70b010accc" "answer-fbea6d94-3174-559e-8095-4488656b9a55" "answer-e4d2ab0b-a96a-5cb6-af20-ac52c6e2a6ec" "answer-156bdc6e-3d42-5028-bc35-b5559648827e"] :db/ensure [:answer-field/validate]} {:db/id "answer-69cfebc1-0895-5011-b698-23c2db2dafb7" :answer/id #uuid "69cfebc1-0895-5011-b698-23c2db2dafb7" :answer/type :answer.type/math :answer/value "1\\,\\frac{1}{3}\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-7b97cea5-6bcf-5b68-975e-af70b010accc" :answer/id #uuid "7b97cea5-6bcf-5b68-975e-af70b010accc" :answer/type :answer.type/math :answer/value "2\\,\\frac{1}{5}\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-fbea6d94-3174-559e-8095-4488656b9a55" :answer/id #uuid "fbea6d94-3174-559e-8095-4488656b9a55" :answer/type :answer.type/math :answer/value "2\\,\\frac{2}{3}\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-e4d2ab0b-a96a-5cb6-af20-ac52c6e2a6ec" :answer/id #uuid "e4d2ab0b-a96a-5cb6-af20-ac52c6e2a6ec" :answer/type :answer.type/math :answer/value "2\\,\\frac{4}{5}\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-156bdc6e-3d42-5028-bc35-b5559648827e" :answer/id #uuid "156bdc6e-3d42-5028-bc35-b5559648827e" :answer/type :answer.type/math :answer/value "3\\,\\frac{1}{3}\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "question-35b950d1-e08b-5f6b-af7f-1977577a5d81" :question/id #uuid "35b950d1-e08b-5f6b-af7f-1977577a5d81" :question/math-academy-id "q-212001" :question/problem "A farmer has five $2\\,\\frac{1}{4}$-acre fields. He planted wheat in $3$ fields and in $\\frac{1}{2}$ of another field. How many acres of wheat did the farmer plant?" :question/worked-solution "Notice that the farmer planted wheat in $3+\\frac{1}{2}=3\\,\\frac{1}{2}$ fields. So, to find out the total acres, we need to calculate $2\\,\\frac{1}{4}\\times 3\\,\\frac{1}{2}.$\n\nFirst, we write $2\\,\\frac{1}{4}$ as an improper fraction:\n\n$$\n2\\,\\frac{1}{4}=\\frac{(2\\times 4)+1}{4}=\\frac{9}{4}\n$$\n\nWe also write $3\\,\\frac{1}{2}$ as an improper fraction:\n\n$$\n3\\,\\frac{1}{2}=\\frac{(3\\times 2)+1}{2}=\\frac{7}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\frac{9}{4}\\times \\frac{7}{2}=\\frac{9\\times 7}{4\\times 2}=\\frac{63}{8}\n$$\n\nFinally, we write the resulting improper fraction as a mixed number:\n\n$$\n\\frac{63}{8}=7\\,\\text{R}\\,7=7\\,\\frac{7}{8}\n$$\n\nSo, the farmer planted $7\\,\\frac{7}{8}$ acres of wheat." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4df7ed25-2b81-5abe-a336-102de5ca8d6b"] :db/ensure [:question/validate]} {:db/id "answer-field-4df7ed25-2b81-5abe-a336-102de5ca8d6b" :answer-field/id #uuid "4df7ed25-2b81-5abe-a336-102de5ca8d6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-59bc80e5-3d2d-56c6-99d8-a8c4a7fa8df3" :answer-field/choices ["answer-a00a6840-b57b-5199-b23e-1052928bfb31" "answer-aaf0e212-f4b4-50d3-9b43-dd1bd5dbf1aa" "answer-59bc80e5-3d2d-56c6-99d8-a8c4a7fa8df3" "answer-aff326ea-fe93-5341-8889-ae5d6b9507b6" "answer-4cf7c18b-415b-5ab1-87c5-2ef3d61e9275"] :db/ensure [:answer-field/validate]} {:db/id "answer-a00a6840-b57b-5199-b23e-1052928bfb31" :answer/id #uuid "a00a6840-b57b-5199-b23e-1052928bfb31" :answer/type :answer.type/text :answer/value "$7\\,\\frac{3}{8}$ acres" :db/ensure [:answer/validate]} {:db/id "answer-aaf0e212-f4b4-50d3-9b43-dd1bd5dbf1aa" :answer/id #uuid "aaf0e212-f4b4-50d3-9b43-dd1bd5dbf1aa" :answer/type :answer.type/text :answer/value "$7\\,\\frac{5}{8}$ acres" :db/ensure [:answer/validate]} {:db/id "answer-59bc80e5-3d2d-56c6-99d8-a8c4a7fa8df3" :answer/id #uuid "59bc80e5-3d2d-56c6-99d8-a8c4a7fa8df3" :answer/type :answer.type/text :answer/value "$7\\,\\frac{7}{8}$ acres" :db/ensure [:answer/validate]} {:db/id "answer-aff326ea-fe93-5341-8889-ae5d6b9507b6" :answer/id #uuid "aff326ea-fe93-5341-8889-ae5d6b9507b6" :answer/type :answer.type/text :answer/value "$8\\,\\frac{3}{8}$ acres" :db/ensure [:answer/validate]} {:db/id "answer-4cf7c18b-415b-5ab1-87c5-2ef3d61e9275" :answer/id #uuid "4cf7c18b-415b-5ab1-87c5-2ef3d61e9275" :answer/type :answer.type/text :answer/value "$8\\,\\frac{5}{8}$ acres" :db/ensure [:answer/validate]} {:db/id 17592186185379 :tutorial/content "Multiplication of mixed fractions occurs regularly in real-life situations.\n\nFor example, suppose that a country road is $5 \\, \\dfrac 12\\,\\textrm{km}$ long. If $\\dfrac 35$ of it is paved with asphalt, how long is the paved part?  \n\nTo find out the length of the paved part of the road, we need to calculate $5 \\, \\dfrac{1}{2} \\times \\dfrac{3}{5}.$ \n\nFirst, we write $5 \\,\\dfrac{1}{2}$ as an improper fraction:\n\n$$\n5 \\,\\dfrac{1}{2} = \\dfrac{(5 \\times 2) + 1}{2} = \\dfrac{11}{2}\n$$\n\nNow, we can multiply the two numbers. We multiply the numerators, and we multiply the denominators:\n\n$$\n\\dfrac{11}{2} \\times \\dfrac{3}{5} =  \\dfrac{11 \\times 3}{2 \\times 5} = \\dfrac{33}{10}\n$$\n\nFinally, by converting this fraction to a mixed number, we get\n\n$$\n33 \\div 10 = 3\\,\\textrm{R}\\,3 = 3\\,\\dfrac{3}{10}.\n$$\n\nSo, the paved part of the road is $3\\,\\dfrac{3}{10}\\,\\textrm{km}$ long." :db/ensure [:tutorial/validate]} {:db/id 17592186184361 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} [:db/retract 17592186185616 :answer-field/choices 17592186185617] [:db/retract 17592186185616 :answer-field/choices 17592186185618] [:db/retract 17592186185616 :answer-field/choices 17592186185619] [:db/retract 17592186185616 :answer-field/choices 17592186185620] [:db/retract 17592186185616 :answer-field/choices 17592186185621] [:db/retract 17592186185610 :answer-field/choices 17592186185611] [:db/retract 17592186185610 :answer-field/choices 17592186185612] [:db/retract 17592186185610 :answer-field/choices 17592186185613] [:db/retract 17592186185610 :answer-field/choices 17592186185614] [:db/retract 17592186185610 :answer-field/choices 17592186185615] [:db/retract 17592186185604 :answer-field/choices 17592186185605] [:db/retract 17592186185604 :answer-field/choices 17592186185606] [:db/retract 17592186185604 :answer-field/choices 17592186185607] [:db/retract 17592186185604 :answer-field/choices 17592186185608] [:db/retract 17592186185604 :answer-field/choices 17592186185609] {:db/id 17592186188283 :knowledge-point/questions ["question-27ec3d52-24b4-5797-862b-64e2b932e1b5" "question-aecd358b-06cc-5c20-9edb-c893e2b56662" "question-4c5ba2c5-2aab-5530-84f9-62121bb3609f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186187987 :question/problem "Consider a sample of size $n=9$ from a normal population. Given that the sample mean is $50$ and the sample standard deviation is $1.5,$ find a $99\\%$ confidence interval for the population mean $\\mu$ of the distribution.\n\n*Hint: Use the fact that $P(T > 3.355) = 0.005,$ where $T$ has a student's $t$-distribution with $8$ degrees of freedom.*" :question/worked-solution "We are told that the population is normally distributed, but we do not know the population variance $\\sigma^2.$\n\nIn cases like this, the random variable\n\n$$\n\\dfrac{\\overline{X} - \\mu}{S/\\sqrt n}\n$$\n\nfollows a student's $t$-distribution $T_{n-1}$ with $n-1$ degrees of freedom, where \n\n- $\\overline{X}$ is the sample mean,\n\n- $\\mu$ is the population mean,\n\n- $S^2$ is the sample variance, and\n\n- $n$ is the sample size.\n\nGiven a value $\\alpha$ between $0$ and $1,$ the corresponding $[100(1-\\alpha)]\\%$ confidence interval for the population mean $\\mu$ is given by\n\n$$\n\\overline{x} \\pm t_{n-1,\\alpha/2} \\cdot \\dfrac{s}{\\sqrt{n}},\n$$\n\nwhere $P(T > t_{n-1,\\alpha/2}) = \\dfrac{\\alpha}{2},$ and $T$ has a student's $t$-distribution with $n-1$ degrees of freedom.\n\nIn our case,\n\n$$\n\\overline{x}=50, \\qquad\nn = 9, \\qquad\ns = 1.5.\n$$\n\nWe are interested in finding a $99\\%$ confidence interval. So, we have \n\n$$\n\\alpha=1-0.99=0.01 \\qquad\\Longrightarrow\\qquad\n\\dfrac{\\alpha}{2}=0.005.\n$$\n\nWe are given that $P(T > 3.355) = 0.005.$ As a result, \n\n$$\nt_{n-1,\\alpha/2} = t_{8,0.005} = 3.355.\n$$\n\n![](images/84/84f060ec1a5e8a8b3db0c0866ebef9db1c242e944717a5abfd28447e0eddb9be.png)\n\nTherefore, a $99\\%$ confidence interval for the population mean $\\mu$ is the following:\n\n$$\n\\begin{aligned}50 & \\pm 3.355\\cdot \\frac{1.5}{\\sqrt{9}} \\\\ 50 & \\pm 1.678\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186188285 :knowledge-point/questions ["question-6b03a1f2-3bac-59ff-a005-6c994dad1ca7" "question-4ae17796-447a-5d04-9973-717e1d847688" "question-2d606c2e-8088-532b-9f1f-331fecee3381" "question-b0647362-6c93-5a80-87bb-0e4349d8ef9c" "question-79c0fa2f-3630-597c-948c-a11745cb42f9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186187989 :question/problem "Consider a sample of size $n=100$ from a population. Given that the sample mean is $30,$ and the sample standard deviation is $8,$ find a $90\\%$ confidence interval for the population mean $\\mu$ of the distribution.\n\n*Hint: Use the fact that $P(T > 1.66) = 0.05,$ where $T$ has a student's $t$-distribution with $99$ degrees of freedom.*" :question/worked-solution "We do not know the distribution of the population, nor do we know the population variance $\\sigma^2.$ However, the sample size $n = 100 \\geq 30$ is *sufficiently large*. \n\nIn cases like this, the random variable\n\n$$\n\\dfrac{\\overline{X} - \\mu}{S/\\sqrt n}\n$$\n\ncan be approximated by the student's $t$-distribution $T_{n-1}$ with $n-1$ degrees of freedom, where \n\n- $\\overline{X}$ is the sample mean,\n\n- $\\mu$ is the population mean,\n\n- $S^2$ is the sample variance, and\n\n- $n$ is the sample size.\n\nGiven a value $\\alpha$ between $0$ and $1,$ the corresponding $[100(1-\\alpha)]\\%$ confidence interval for the population mean $\\mu$ is given by\n\n$$\n\\overline{x} \\pm  t_{n-1,\\alpha/2} \\cdot \\dfrac{s}{\\sqrt{n}},\n$$\n\nwhere $P(T > t_{n-1,\\alpha/2}) = \\dfrac{\\alpha}{2},$ and $T$ has a student's $t$-distribution with $n-1$ degrees of freedom.\n\nIn our case,\n\n$$\n\\overline{x}=30, \\qquad \nn = 100, \\qquad\ns = 8.\n$$\n\nWe are interested in finding a $90\\%$ confidence interval. So, we have \n\n$$\n\\alpha=1-0.9=0.1 \\qquad\\Longrightarrow\\qquad\n\\dfrac{\\alpha}{2}=0.05.\n$$\n\nWe are given that $P(T > 1.66) = 0.05.$ As a result,  \n\n$$\nt_{n-1,\\alpha/2} = t_{99,0.05} = 1.66.\n$$\n\n![](images/8d/8d4cd3a76fffee915059c849d3bac4ca395deb3e2cfe5ab1701e9ee4737b4401.png)\n\n \n\nTherefore, the $90\\%$ confidence interval for the population mean $\\mu$ is the following:\n\n$$\n\\begin{aligned}30 & \\pm 1.66\\cdot \\frac{8}{\\sqrt{100}} \\\\ 30 & \\pm 1.328\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186188284 :knowledge-point/questions ["question-d3b129d2-0cd5-58e9-b5e8-9079b387fb53" "question-3c887832-1efe-5629-bd9f-7e1600f20497" "question-7a68a1f9-858f-5d69-bc49-809a211decce" "question-b9cb4d01-534f-524c-85ee-ddefd795826f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186187988 :question/problem "A tire manufacturer measures the stopping distance of a new tire model from $60 \\, \\textrm{mph}$ on a standard test car.   A sample of $81$ stopping distances yielded a sample mean of $132\\, \\textrm{ ft}$ with a sample standard deviation of $5.4 \\, \\textrm{ft}.$ Find a $95\\%$ confidence interval for the mean stopping distance $\\mu$ of these tires.    \n\n*Hint: Given a random variable $T$ that has a student's $t$-distribution $T_k$ with $k$ degrees of freedom, the table below shows the $t$-scores $t_{k,p}$ such that $P(T > t_{k,p}) = p$ for some particular values of $k$ and $p.$*\n\n| $k \\setminus p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $79$ | $\\,1.292\\,$ | $\\,1.664\\,$ | $\\,1.990\\,$ | $\\,2.374\\,$ | $\\,2.640\\,$ |\n| $80$ | $\\,1.292\\,$ | $\\,1.664\\,$ | $\\,1.990\\,$ | $\\,2.374\\,$ | $\\,2.639\\,$ |\n| $81$ | $\\,1.292\\,$ | $\\,1.664\\,$ | $\\,1.990\\,$ | $\\,2.373\\,$ | $\\,2.638\\,$ |" :question/worked-solution "We do not know the distribution of the population, nor do we know the population variance $\\sigma^2.$ However, the sample size $n = 81 \\geq 30$ is *sufficiently large*. \n\nIn cases like this, the random variable\n\n$$\n\\dfrac{\\overline{X} - \\mu}{S/\\sqrt n}\n$$\n\ncan be approximated by the student's $t$-distribution $T_{n-1}$ with $n-1$ degrees of freedom, where  \n\n- $\\overline{X}$ is the sample mean,\n\n- $\\mu$ is the population mean,\n\n- $S^2$ is the sample variance, and\n\n- $n$ is the sample size.\n\nGiven a value $\\alpha$ between $0$ and $1,$ the corresponding $[100(1-\\alpha)]\\%$ confidence interval for the population mean $\\mu$ is given by\n\n$$\n\\overline{x} \\pm  t_{n-1,\\alpha/2} \\cdot \\dfrac{s}{\\sqrt{n}},\n$$\n\nwhere $P(T > t_{n-1,\\alpha/2}) = \\dfrac{\\alpha}{2},$ and $T$ has a student's $t$-distribution with $n-1$ degrees of freedom.\n\nIn our case,\n\n$$\n\\overline{x}=132 \\, \\textrm{ft}, \\qquad\nn = 81, \\qquad\ns = 5.4 \\, \\textrm{ft}.\n$$\n\nWe are interested in finding a $95\\%$ confidence interval. So, we have \n\n$$\n\\alpha=1-0.95=0.05 \\qquad\\Longrightarrow\\qquad\n\\dfrac{\\alpha}{2}=0.025.\n$$\n\nWe also need to find the $t$-score value $t_{80,0.025}$ such that $P(T > t_{80, 0.025}) = 0.025,$ where $T$ has a student's $t$-distribution with $n-1=81-1=80$ degrees of freedom.\n\n![](images/d5/d513fbeee39a42a5e897c1b171d7e820196066517c5aa1c6c12549a98ce00ddd.png)\n\nFrom the percentage points table of the $t$-distribution, we obtain that $t_{80,0.025}=1.990{:}$ \n\n| $k \\setminus p$ | $0.100$ | $0.050$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.025}$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $79$ | $1.292$ | $1.664$ | $1.990$ | $2.374$ | $2.640$ |\n| $\\bbox[2pt,Gainsboro]{\\color{blue}80}$ | $1.292$ | $1.664$ | $\\bbox[2pt,Gainsboro]{\\color{blue}1.990}$ | $2.374$ | $2.639$ |\n| $81$ | $1.292$ | $1.664$ | $1.990$ | $2.373$ | $2.638$ |\n\nTherefore, the $95\\%$ confidence interval for the population mean $\\mu$ is the following:\n\n$$\n\\begin{aligned}132 & \\pm 1.99\\cdot \\frac{5.4}{\\sqrt{81}}\\,\\text{ft} \\\\ 132 & \\pm 1.194\\,\\text{ft}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186188556 :question/problem "![](images/0b/0b5037831d90f93fb6b8b0603655162e4f362a638b35c569f7c5e07007974b3d.png)\n\nConsider a sample of size $n=16$ from a normal population. Given that the sample mean is $50,$ and the sample standard deviation is $8,$ find a $90%$ confidence interval for the population mean $\\mu $ of the distribution.\n\n*Hint: Use the fact that $P(T>1.753)=0.05,$ where $T$ has a student's $t$-distribution with $15$ degrees of freedom,  as shown in the diagram above.*" :question/worked-solution "We are told that the population is normally distributed, but we do not know the population variance ${\\sigma }^{2}.$\n\nIn cases like this, the random variable\n\n$$\n\\frac{\\overset{―}{X}-\\mu }{S/\\sqrt{n}}\n$$\n\nfollows a student's $t$-distribution ${T}_{n-1}$ with $n-1$ degrees of freedom, where \n\n- $\\overset{―}{X}$ is the sample mean,\n\n- $\\mu $ is the population mean,\n\n- ${S}^{2}$ is the sample variance, and\n\n- $n$ is the sample size.\n\nGiven a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the population mean $\\mu $ is given by\n\n$$\n\\overset{―}{x}\\pm {t}_{n-1,\\alpha /2}\\cdot \\frac{s}{\\sqrt{n}},\n$$\n\nwhere $P(T>{t}_{n-1,\\alpha /2})=\\frac{\\alpha }{2},$ and $T$ has a student's $t$-distribution with $n-1$ degrees of freedom.\n\nIn our case,\n\n$$\n\\overset{―}{x}=50,\\,n=16,\\,s=8.\n$$\n\nWe are interested in finding a $90%$ confidence interval. So, we have \n\n$$\n\\alpha =1-0.9=0.1\\,⟹\\,\\frac{\\alpha }{2}=0.05.\n$$\n\nWe are given that $P(T>1.753)=0.05.$ As a result, \n\n$$\n{t}_{n-1,\\alpha /2}={t}_{15,0.05}=1.753.\n$$\n\nTherefore, a $90%$ confidence interval for the population mean $\\mu $ is the following:\n\n$$\n\\begin{aligned} & 50\\pm 1.753\\cdot \\frac{8}{\\sqrt{16}} \\\\  & 50\\pm 3.506\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186185616 :answer-field/correct "answer-9ad098dc-7f2c-5437-8222-2899d151ab9c" :answer-field/choices ["answer-32de77ab-6c1d-5a97-8cb0-561563d33d28" "answer-9cd21b09-a056-56e6-ac86-61501d334558" "answer-c5407ccc-e312-5feb-94a8-95e28811eacd" "answer-c538e266-2b11-5784-8d91-7aa3595545cd" "answer-9ad098dc-7f2c-5437-8222-2899d151ab9c"] :db/ensure [:answer-field/validate]} {:db/id "answer-32de77ab-6c1d-5a97-8cb0-561563d33d28" :answer/id #uuid "32de77ab-6c1d-5a97-8cb0-561563d33d28" :answer/type :answer.type/math :answer/value "16\\pm 2.415" :db/ensure [:answer/validate]} {:db/id "answer-9cd21b09-a056-56e6-ac86-61501d334558" :answer/id #uuid "9cd21b09-a056-56e6-ac86-61501d334558" :answer/type :answer.type/math :answer/value "16\\pm 3.506" :db/ensure [:answer/validate]} {:db/id "answer-c5407ccc-e312-5feb-94a8-95e28811eacd" :answer/id #uuid "c5407ccc-e312-5feb-94a8-95e28811eacd" :answer/type :answer.type/math :answer/value "50\\pm 1.753" :db/ensure [:answer/validate]} {:db/id "answer-c538e266-2b11-5784-8d91-7aa3595545cd" :answer/id #uuid "c538e266-2b11-5784-8d91-7aa3595545cd" :answer/type :answer.type/math :answer/value "50\\pm 2.415" :db/ensure [:answer/validate]} {:db/id "answer-9ad098dc-7f2c-5437-8222-2899d151ab9c" :answer/id #uuid "9ad098dc-7f2c-5437-8222-2899d151ab9c" :answer/type :answer.type/math :answer/value "50\\pm 3.506" :db/ensure [:answer/validate]} {:db/id "question-27ec3d52-24b4-5797-862b-64e2b932e1b5" :question/id #uuid "27ec3d52-24b4-5797-862b-64e2b932e1b5" :question/math-academy-id "q-142574" :question/problem "Consider a sample of size $n=16$ from a normal population. Given that the sample mean is $5.4$ and the sample standard deviation is $8,$ find a $99%$ confidence interval for the population mean $\\mu $ of the distribution.\n\n*Hint: Use the fact that $P(T>2.947)=0.005,$ where $T$ has a student's $t$-distribution with $15$ degrees of freedom.*" :question/worked-solution "We are told that the population is normally distributed, but we do not know the population variance ${\\sigma }^{2}.$\n\nIn cases like this, the random variable\n\n$$\n\\frac{\\overset{―}{X}-\\mu }{S/\\sqrt{n}}\n$$\n\nfollows a student's $t$-distribution ${T}_{n-1}$ with $n-1$ degrees of freedom, where \n\n- $\\overset{―}{X}$ is the sample mean,\n\n- $\\mu $ is the population mean,\n\n- ${S}^{2}$ is the sample variance, and\n\n- $n$ is the sample size.\n\nGiven a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the population mean $\\mu $ is given by\n\n$$\n\\overset{―}{x}-{t}_{n-1,\\alpha /2}\\cdot \\frac{s}{\\sqrt{n}}\\le \\mu \\le \\overset{―}{x}+{t}_{n-1,\\alpha /2}\\cdot \\frac{s}{\\sqrt{n}},\n$$\n\nwhere $P(T>{t}_{n-1,\\alpha /2})=\\frac{\\alpha }{2},$ and $T$ has a student's $t$-distribution with $n-1$ degrees of freedom.\n\nIn our case,\n\n$$\n\\overset{―}{x}=5.4,\\,n=16,\\,s=8.\n$$\n\nWe are interested in finding a $99%$ confidence interval. So, we have \n\n$$\n\\alpha =1-0.99=0.01\\,⟹\\,\\frac{\\alpha }{2}=0.005.\n$$\n\nWe are given that $P(T>2.947)=0.005.$ As a result, \n\n$$\n{t}_{n-1,\\alpha /2}={t}_{15,0.005}=2.947.\n$$\n\n![](images/bb/bbaa00deb18e38f1b201317615a790764519ad5d2c5b436fe13044a09c71beac.png)\n\nTherefore, a $99%$ confidence interval for the population mean $\\mu $ is the following:\n\n$$\n\\begin{aligned}5.4 & \\pm 2.947\\cdot \\frac{8}{\\sqrt{16}} \\\\ 5.4 & \\pm 5.894\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f6d766a-ea73-5a42-be0b-a9ac219d158b"] :db/ensure [:question/validate]} {:db/id "answer-field-6f6d766a-ea73-5a42-be0b-a9ac219d158b" :answer-field/id #uuid "6f6d766a-ea73-5a42-be0b-a9ac219d158b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-19e1155e-4080-5d86-9fb4-472204d0fabf" :answer-field/choices ["answer-a903a349-4713-507e-9844-98a6ac0b3509" "answer-e3ace7cb-9051-5506-b8cb-1f60b97ef81b" "answer-4789ab41-6901-54eb-aa3f-53c0093afcea" "answer-b1050771-aa4e-50b6-be4b-e655bb7f5f6e" "answer-19e1155e-4080-5d86-9fb4-472204d0fabf"] :db/ensure [:answer-field/validate]} {:db/id "answer-a903a349-4713-507e-9844-98a6ac0b3509" :answer/id #uuid "a903a349-4713-507e-9844-98a6ac0b3509" :answer/type :answer.type/math :answer/value "1.6\\pm 5.849" :db/ensure [:answer/validate]} {:db/id "answer-e3ace7cb-9051-5506-b8cb-1f60b97ef81b" :answer/id #uuid "e3ace7cb-9051-5506-b8cb-1f60b97ef8