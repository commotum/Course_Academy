dio :answer-field/correct "answer-1409de6f-8d4c-561a-bf02-e951797f383b" :answer-field/choices ["answer-f98bd692-ae23-58eb-8a79-31282bc0610f" "answer-c8a76dcc-4b19-5947-8692-6d6df0c64d65" "answer-badeb28a-792c-5ea5-8883-c07f39f28e6f" "answer-1409de6f-8d4c-561a-bf02-e951797f383b" "answer-10416c63-126d-535c-8234-46889c821e2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-f98bd692-ae23-58eb-8a79-31282bc0610f" :answer/id #uuid "f98bd692-ae23-58eb-8a79-31282bc0610f" :answer/type :answer.type/math :answer/value "-\\sqrt{3z}" :db/ensure [:answer/validate]} {:db/id "answer-c8a76dcc-4b19-5947-8692-6d6df0c64d65" :answer/id #uuid "c8a76dcc-4b19-5947-8692-6d6df0c64d65" :answer/type :answer.type/math :answer/value "-\\sqrt{z}" :db/ensure [:answer/validate]} {:db/id "answer-badeb28a-792c-5ea5-8883-c07f39f28e6f" :answer/id #uuid "badeb28a-792c-5ea5-8883-c07f39f28e6f" :answer/type :answer.type/math :answer/value "3z" :db/ensure [:answer/validate]} {:db/id "answer-1409de6f-8d4c-561a-bf02-e951797f383b" :answer/id #uuid "1409de6f-8d4c-561a-bf02-e951797f383b" :answer/type :answer.type/math :answer/value "\\sqrt{3z}" :db/ensure [:answer/validate]} {:db/id "answer-10416c63-126d-535c-8234-46889c821e2d" :answer/id #uuid "10416c63-126d-535c-8234-46889c821e2d" :answer/type :answer.type/math :answer/value "\\sqrt{z}" :db/ensure [:answer/validate]} {:db/id "question-40cade47-943f-50c4-8cf4-c4d5f9b88bc8" :question/id #uuid "40cade47-943f-50c4-8cf4-c4d5f9b88bc8" :question/math-academy-id "q-134506" :question/problem "$2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}2\\sqrt{p}-\\sqrt{16p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{4}} & = \\\\ 2\\sqrt{p}-\\sqrt{16\\cdot p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}\\cdot p} & = \\\\ 2\\sqrt{p}-\\sqrt{16}\\cdot \\sqrt{p}+\\sqrt[3]{p}+\\sqrt[3]{{p}^{3}}\\cdot \\sqrt[3]{p} & = \\\\ 2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}2\\sqrt{p}-4\\sqrt{p}+\\sqrt[3]{p}+p\\sqrt[3]{p} & = \\\\ (2-4)\\sqrt{p}+(1+p)\\sqrt[3]{p} & = \\\\ -2\\sqrt{p}+(1+p)\\sqrt[3]{p} & = \\\\ (p+1)\\sqrt[3]{p}-2\\sqrt{p}\\end{aligned}\n$$\n\nNotice that we cannot combine the $\\sqrt[3]{p}$ and $\\sqrt{p}$ terms." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4914e07f-3d93-5356-b4b8-8517fb1d7635"] :db/ensure [:question/validate]} {:db/id "answer-field-4914e07f-3d93-5356-b4b8-8517fb1d7635" :answer-field/id #uuid "4914e07f-3d93-5356-b4b8-8517fb1d7635" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c01e360-4b50-5260-b311-2ea621722164" :answer-field/choices ["answer-e2171678-dbe0-5c40-aba8-dc750a70794f" "answer-8b456b28-3a4a-5b14-a2fc-7ae17008160f" "answer-7c01e360-4b50-5260-b311-2ea621722164" "answer-a5345b39-e7c1-50d0-9c54-c658acc7bcb6" "answer-3fd144af-d507-5334-8bb4-0403c5376fa2"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2171678-dbe0-5c40-aba8-dc750a70794f" :answer/id #uuid "e2171678-dbe0-5c40-aba8-dc750a70794f" :answer/type :answer.type/math :answer/value "(1-p)\\sqrt[3]{p}-2\\sqrt{p}" :db/ensure [:answer/validate]} {:db/id "answer-8b456b28-3a4a-5b14-a2fc-7ae17008160f" :answer/id #uuid "8b456b28-3a4a-5b14-a2fc-7ae17008160f" :answer/type :answer.type/math :answer/value "(1-p)\\sqrt{p}-4\\sqrt[3]{p}" :db/ensure [:answer/validate]} {:db/id "answer-7c01e360-4b50-5260-b311-2ea621722164" :answer/id #uuid "7c01e360-4b50-5260-b311-2ea621722164" :answer/type :answer.type/math :answer/value "(p+1)\\sqrt[3]{p}-2\\sqrt{p}" :db/ensure [:answer/validate]} {:db/id "answer-a5345b39-e7c1-50d0-9c54-c658acc7bcb6" :answer/id #uuid "a5345b39-e7c1-50d0-9c54-c658acc7bcb6" :answer/type :answer.type/math :answer/value "(p+1)\\sqrt{p}-2\\sqrt[3]{p}" :db/ensure [:answer/validate]} {:db/id "answer-3fd144af-d507-5334-8bb4-0403c5376fa2" :answer/id #uuid "3fd144af-d507-5334-8bb4-0403c5376fa2" :answer/type :answer.type/math :answer/value "(p-4)\\sqrt[3]{p}+\\sqrt{p}" :db/ensure [:answer/validate]} {:db/id "question-b5988724-f4b1-5a52-8719-b7ac5bee89d1" :question/id #uuid "b5988724-f4b1-5a52-8719-b7ac5bee89d1" :question/math-academy-id "q-134508" :question/problem "$7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t}=$" :question/worked-solution "We simplify each of the radical terms using the product rule:\n\n$$\n\\begin{aligned}7-\\sqrt[3]{2{t}^{4}}+6t\\sqrt[3]{2t} & = \\\\ 7-\\sqrt[3]{{t}^{3}\\cdot 2t}+6t\\sqrt[3]{2t} & = \\\\ 7-\\sqrt[3]{{t}^{3}}\\cdot \\sqrt[3]{2t}+6t\\sqrt[3]{2t} & = \\\\ 7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} & \\end{aligned}\n$$\n\nFinally, we combine the like terms:\n\n$$\n\\begin{aligned}7-t\\sqrt[3]{2t}+6t\\sqrt[3]{2t} & = \\\\ 7+(-t+6t)\\sqrt[3]{2t} & = \\\\ 7+5t\\sqrt[3]{2t} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9972e5ae-f3d9-5083-8d1b-be6157c6f289"] :db/ensure [:question/validate]} {:db/id "answer-field-9972e5ae-f3d9-5083-8d1b-be6157c6f289" :answer-field/id #uuid "9972e5ae-f3d9-5083-8d1b-be6157c6f289" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-30d278a9-e551-5555-b465-1a9126efba85" :answer-field/choices ["answer-2cb30476-4c76-58e1-aa56-f618bffdd6d1" "answer-9da8cfd5-4237-5f1e-9ddc-17c0aa461cd6" "answer-a3012e8a-4fdb-529f-9953-c32624052358" "answer-30d278a9-e551-5555-b465-1a9126efba85" "answer-3032bfa5-dbf0-5f11-91e9-fbf7414cabe8"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cb30476-4c76-58e1-aa56-f618bffdd6d1" :answer/id #uuid "2cb30476-4c76-58e1-aa56-f618bffdd6d1" :answer/type :answer.type/math :answer/value "(7+5t)\\sqrt[3]{2t}" :db/ensure [:answer/validate]} {:db/id "answer-9da8cfd5-4237-5f1e-9ddc-17c0aa461cd6" :answer/id #uuid "9da8cfd5-4237-5f1e-9ddc-17c0aa461cd6" :answer/type :answer.type/math :answer/value "(t+7)\\sqrt[3]{2t}" :db/ensure [:answer/validate]} {:db/id "answer-a3012e8a-4f