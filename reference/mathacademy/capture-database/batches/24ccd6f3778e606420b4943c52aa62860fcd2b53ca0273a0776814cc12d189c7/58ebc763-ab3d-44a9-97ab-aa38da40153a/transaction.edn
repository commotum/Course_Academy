\\frac{2}{2}y & =\\frac{11}{2} \\\\ 3x-y & =\\frac{11}{2} \\\\ -y & =-3x+\\frac{11}{2} \\\\ y & =3x-\\frac{11}{2}.\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope is $3.$\n\nFrom the given options, the only line that has a slope of $3$ is $y=3x-8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-04d55a55-dcb2-5f1f-bb49-f359d2f4f066"] :db/ensure [:question/validate]} {:db/id "answer-field-04d55a55-dcb2-5f1f-bb49-f359d2f4f066" :answer-field/id #uuid "04d55a55-dcb2-5f1f-bb49-f359d2f4f066" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b220cef-1e57-5c7c-b8c9-140cde054ae5" :answer-field/choices ["answer-7f25e14f-dfb9-523c-b53b-932d5481661c" "answer-73ec87cf-5e2f-5cab-8bf8-4edb168c5394" "answer-c722783d-27d3-5cb8-8edc-899b5962a24e" "answer-6b220cef-1e57-5c7c-b8c9-140cde054ae5" "answer-63aec5ed-70dd-568a-b800-b96182667ad1"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f25e14f-dfb9-523c-b53b-932d5481661c" :answer/id #uuid "7f25e14f-dfb9-523c-b53b-932d5481661c" :answer/type :answer.type/math :answer/value "y=-12x+4" :db/ensure [:answer/validate]} {:db/id "answer-73ec87cf-5e2f-5cab-8bf8-4edb168c5394" :answer/id #uuid "73ec87cf-5e2f-5cab-8bf8-4edb168c5394" :answer/type :answer.type/math :answer/value "y=-3x+6" :db/ensure [:answer/validate]} {:db/id "answer-c722783d-27d3-5cb8-8edc-899b5962a24e" :answer/id #uuid "c722783d-27d3-5cb8-8edc-899b5962a24e" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{3}x+2" :db/ensure [:answer/validate]} {:db/id "answer-6b220cef-1e57-5c7c-b8c9-140cde054ae5" :answer/id #uuid "6b220cef-1e57-5c7c-b8c9-140cde054ae5" :answer/type :answer.type/math :answer/value "y=3x-8" :db/ensure [:answer/validate]} {:db/id "answer-63aec5ed-70dd-568a-b800-b96182667ad1" :answer/id #uuid "63aec5ed-70dd-568a-b800-b96182667ad1" :answer/type :answer.type/math :answer/value "y=\\frac{1}{12}x-\\frac{2}{5}" :db/ensur