sure [:answer/validate]} {:db/id "question-8bec425d-e327-5350-ad55-2bf5d8347c9a" :question/id #uuid "8bec425d-e327-5350-ad55-2bf5d8347c9a" :question/math-academy-id "q-100757" :question/problem "${(6\\cdot 8)}^{3}\\cdot {6}^{5}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{(6\\cdot 8)}^{3}\\cdot {6}^{5}={6}^{3}\\cdot {8}^{3}\\cdot {6}^{5}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n\\begin{aligned}{6}^{3}\\cdot {8}^{3}\\cdot {6}^{5} & ={6}^{3}\\cdot {6}^{5}\\cdot {8}^{3} \\\\  & ={6}^{3+5}\\cdot {8}^{3} \\\\  & ={6}^{8}\\cdot {8}^{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-11312e6f-7278-523b-b492-30e222c5f5a7"] :db/ensure [:question/validate]} {:db/id "answer-field-11312e6f-7278-523b-b492-30e222c5f5a7" :answer-field/id #uuid "11312e6f-7278-523b-b492-30e222c5f5a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8011c4e-cb58-515e-9fe0-ab3c788f1478" :answer-field/choices ["answer-cf81bb58-a87f-5a0e-91a5-9f5976da0085" "answer-d2f55899-6b14-567d-959e-9963101cb1f8" "answer-74a93e7b-8e23-5952-a163-17d5bb75323b" "answer-a8011c4e-cb58-515e-9fe0-ab3c788f1478" "answer-3611b83a-05fd-57c0-964f-6cdb6a750d10"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf81bb58-a87f-5a0e-91a5-9f5976da0085" :answer/id #uuid "cf81bb58-a87f-5a0e-91a5-9f5976da0085" :answer/type :answer.type/math :answer/value "{6}^{2}\\cdot {8}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-d2f55899-6b14-567d-959e-9963101cb1f8" :answer/id #uuid "d2f55899-6b14-567d-959e-9963101cb1f8" :answer/type :answer.type/math :answer/value "{6}^{3}\\cdot {8}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-74a93e7b-8e23-5952-a163-17d5bb75323b" :answer/id #uuid "74a93e7b-8e23-5952-a163-17d5bb75323b" :answer/type :answer.type/math :answer/value "{6}^{3}\\cdot {8}^{8}" :db/ensure [:answer/validate]} {:d