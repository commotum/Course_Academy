e34-541c824a1cf8" "step-d34432c1-07b0-58c4-a35d-f354ab6b00c0" "step-8202d26a-ddb4-51a5-a248-916138bbdab9" "step-8d89a719-5776-5738-90c1-4252105b7daa"] :activity/first-step "step-6ce6f69a-e8bd-5bb3-8b7f-545dd51be273" :db/ensure [:activity/validate]} {:db/id "step-6ce6f69a-e8bd-5bb3-8b7f-545dd51be273" :step/id #uuid "6ce6f69a-e8bd-5bb3-8b7f-545dd51be273" :step/content 17592186503723 :step/next "step-2a815087-9d2f-5f79-be34-541c824a1cf8" :db/ensure [:step/validate]} {:db/id "step-2a815087-9d2f-5f79-be34-541c824a1cf8" :step/id #uuid "2a815087-9d2f-5f79-be34-541c824a1cf8" :step/content "question-5fdf7d2e-21a5-5a00-afb9-716691a79836" :step/next "step-d34432c1-07b0-58c4-a35d-f354ab6b00c0" :db/ensure [:step/validate]} {:db/id "step-d34432c1-07b0-58c4-a35d-f354ab6b00c0" :step/id #uuid "d34432c1-07b0-58c4-a35d-f354ab6b00c0" :step/content "question-adce0112-6117-576f-afb6-900e0d57f067" :step/next "step-8202d26a-ddb4-51a5-a248-916138bbdab9" :db/ensure [:step/validate]} {:db/id "step-8202d26a-ddb4-51a5-a248-916138bbdab9" :step/id #uuid "8202d26a-ddb4-51a5-a248-916138bbdab9" :step/content "question-5753a7d8-bd1a-52e7-a471-c1acec6a4f75" :step/next "step-8d89a719-5776-5738-90c1-4252105b7daa" :db/ensure [:step/validate]} {:db/id "step-8d89a719-5776-5738-90c1-4252105b7daa" :step/id #uuid "8d89a719-5776-5738-90c1-4252105b7daa" :step/content 17592186397752 :db/ensure [:step/validate]} {:db/id 17592186147571 :knowledge-point/questions ["question-87d542d6-aac4-513b-9fc9-107312f9fcdf" "question-ec5e8c7c-c10d-59da-bddc-7ee7a7739de6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147208 :question/problem "A mountain has a glacier with a depth of $75\\,\\textrm{m}.$ The depth of the glacier reduces by $\\dfrac{1}{4}$ every year. Construct a function that represents the depth $d(t)$ of the glacier after $t$ years." :question/worked-solution "The depth of the glacier is $75\\,\\textrm{m},$ and this reduces by $\\dfrac{1}{4}$ every year. Therefore, the depth decays exponentially with a decay factor of $\\dfrac 3 4.$\n\nThe formula for exponential decay (in terms of a decay factor $b$) is\n\n$$\nd(t) = ab^t.\n$$\n\nIn our case, we have the following:\n\n- $a=75 \\textrm{ m }$ is the initial depth of the glacier.\n\n- $b = \\dfrac 3 4$ is the decay factor.\n\n- $t =$  the time, in years.\n\nTherefore, the correct expression for the depth $d(t)$ is\n\n$$\nd(t)= 75 \\cdot \\left(\\dfrac 3 4\\right)^{t}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186147570 :knowledge-point/questions ["question-76eb003d-42ac-559c-8f1c-f5ce54d3972f" "question-5be49d8c-c7c0-5d12-b018-ff8157121a39"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147207 :question/problem "The number of members $m$ of a club after $t$ years is given by the formula \n\n$$\nm(t) = 766 \\cdot (\\textrm{___})^{t}.\n$$\n\nIf there were $766$ members initially, and the number of members decreases by $22\\%$ each year, what is the missing value in the expression for $m(t)?$" :question/worked-solution "The formula for exponential decay (in terms of a decay rate $r$) is\n\n$$\nm(t) = a(1-r)^t.\n$$\n\nIn our case, we have the following:\n\n- $a=766$ is the initial number of members.\n\n- $r = 0.22$ is the decay rate ($22\\%$ expressed as a decimal).\n\n- $t=$ the time, in years.\n\nTherefore, the correct expression for $m$ is\n\n$$\nm(t)= 766\\cdot (1 - 0.22)^{t} = 766\\cdot (0.78)^{t}.\n$$\n\nSo, the missing number is $0.78.$" :db/ensure [:question/validate]} {:db/id "question-87d542d6-aac4-513b-9fc9-107312f9fcdf" :question/id #uuid "87d542d6-aac4-513b-9fc9-107312f9fcdf" :question/math-academy-id "q-61704" :question/problem "Ralf is investigating the effect of a substance on some bacteria. In the beginning, there were $3\\,000$ bacteria. After introducing the substance, Ralf noticed that the number of bacteria reduces by $\\frac{1}{4}$ every minute.\n\nThe function $y(t)$ models the number of bacteria after $t$ minutes and is given by\n\n$$\ny(t)=3\\,000\\cdot {(\\text{___})}^{t}.\n$$\n\nWhat number is missing?" :question/worked-solution "If the number of alive bacteria reduces by $\\frac{1}{4}$ every minute, then $\\frac{3}{4}$ of the bacteria remains every minute. So the decay factor is $\\frac{3}{4}.$\n\nThe formula for exponential decay (in terms of a decay factor $b$) is\n\n$$\ny=a{b}^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=3\\,000$ is the initial number of bacteria.\n\n- $b=\\frac{3}{4}$ is the decay factor.\n\n- $t=$ the time, in minutes.\n\nTherefore, the correct expression for $y(t)$ is\n\n$$\ny(t)=3\\,000\\cdot {(\\frac{3}{4})}^{t}.\n$$\n\nSo the missing number is $\\frac{3}{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-97c59463-67ac-5c37-b808-28ec533a2185"] :db/ensure [:question/validate]} {:db/id "answer-field-97c59463-67ac-5c37-b808-28ec533a2185" :answer-field/id #uuid "97c59463-67ac-5c37-b808-28ec533a2185" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-36174f42-7a31-57ce-a2f7-fc99f9926df2" :answer-field/choices ["answer-32a56108-53b2-53e0-b3aa-7b816128a40c" "answer-cfac9794-90ef-53f2-8ace-d19fb1866019" "answer-36174f42-7a31-57ce-a2f7-fc99f9926df2" "answer-e4479b0b-ed9e-566c-b900-f0e0cabba3d8" "answer-f3e49bb4-a7ca-56cb-8d47-e747459a6da9"] :db/ensure [:answer-field/validate]} {:db/id "answer-32a56108-53b2-53e0-b3aa-7b816128a40c" :answer/id #uuid "32a56108-53b2-53e0-b3aa-7b816128a40c" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-cfac9794-90ef-53f2-8ace-d19fb1866019" :answer/id #uuid "cfac9794-90ef-53f2-8ace-d19fb1866019" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-36174f42-7a31-57ce-a2f7-fc99f9926df2" :answer/id #uuid "36174f42-7a31-57ce-a2f7-fc99f9926df2" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-e4479b0b-ed9e-566c-b900-f0e0cabba3d8" :answer/id #uuid "e4479b0b-ed9e-566c-b900-f0e0cabba3d8" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-f3e49bb4-a7ca-56cb-8d47-e747459a6da9" :answer/id #uuid "f3e49bb4-a7ca-56cb-8d47-e747459a6da9" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "question-ec5e8c7c-c10d-59da-bddc-7ee7a7739de6" :question/id #uuid "ec5e8c7c-c10d-59da-bddc-7ee7a7739de6" :question/math-academy-id "q-62062" :question/problem "Joel invested $$11\\,280.$ The investment performed poorly, losing one-eighth of its value every month.\n\nThe function $p(t)$ models the value of the investment after $t$ months and is given by\n\n$$\np(t)=11\\,280\\cdot {(\\text{___})}^{t}.\n$$\n\nWhat number is missing?" :question/worked-solution "The initial investment was $$11\\,280$, and this decreased by $\\frac{1}{8}$ every month.\n\nIf the investment value is reduced by $\\frac{1}{8},$ then $\\frac{7}{8}$ of its value remained every month. So the decay factor is $\\frac{7}{8}.$\n\nThe formula for exponential decay (in terms of a decay factor $b$) is\n\n$$\np=a{b}^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=11\\,280$ is the initial investment.\n\n- $b=\\frac{7}{8}$ is the decay factor.\n\n- $t=$ the time, in months.\n\nTherefore, the correct expression for $p(t)$ is\n\n$$\np(t)=11\\,280\\cdot {(\\frac{7}{8})}^{t}.\n$$\n\nSo the missing number is $\\frac{7}{8}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4450d37-cda0-50d9-ad71-0e2c1df13152"] :db/ensure [:question/validate]} {:db/id "answer-field-f4450d37-cda0-50d9-ad71-0e2c1df13152" :answer-field/id #uuid "f4450d37-cda0-50d9-ad71-0e2c1df13152" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3064872-5e4c-57e5-9d47-2c2deb22dec2" :answer-field/choices ["answer-463b2e71-dbe7-52d1-afb3-71d62e0273b3" "answer-c3ec6af2-4f1a-52c6-a25e-18c1477fc5d1" "answer-eb3970cd-670c-51c7-b392-e17578742da3" "answer-a3064872-5e4c-57e5-9d47-2c2deb22dec2" "answer-3af5368a-546f-56e4-bff8-dab5438a0709"] :db/ensure [:answer-field/validate]} {:db/id "answer-463b2e71-dbe7-52d1-afb3-71d62e0273b3" :answer/id #uuid "463b2e71-dbe7-52d1-afb3-71d62e0273b3" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-c3ec6af2-4f1a-52c6-a25e-18c1477fc5d1" :answer/id #uuid "c3ec6af2-4f1a-52c6-a25e-18c1477fc5d1" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "answer-eb3970cd-670c-51c7-b392-e17578742da3" :answer/id #uuid "eb3970cd-670c-51c7-b392-e17578742da3" :answer/type :answer.type/math :answer/value "\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "answer-a3064872-5e4c-57e5-9d47-2c2deb22dec2" :answer/id #uuid "a3064872-5e4c-57e5-9d47-2c2deb22dec2" :answer/type :answer.type/math :answer/value "\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "answer-3af5368a-546f-56e4-bff8-dab5438a0709" :answer/id #uuid "3af5368a-546f-56e4-bff8-dab5438a0709" :answer/type :answer.type/math :answer/value "\\frac{9}{8}" :db/ensure [:answer/validate]} {:db/id "question-76eb003d-42ac-559c-8f1c-f5ce54d3972f" :question/id #uuid "76eb003d-42ac-559c-8f1c-f5ce54d3972f" :question/math-academy-id "q-61793" :question/problem "The population of a certain animal species is declining at a rate of $3%$ per year. If the species' initial population was $5\\,000$ when the observations started, then which function correctly represents $y(t),$ the population of the species after $t$ years?" :question/worked-solution "The formula for exponential decay (in terms of a decay rate $r$) is\n\n$$\ny(t)=a(1-r)^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=5\\,000$ is the initial population.\n\n- $r=0.03$ is the decay rate ($3%$ expressed as a decimal).\n\n- $t=$ the time, in years.\n\nTherefore, the correct expression for $y$ is\n\n$$\ny(t)=5\\,000\\cdot (1-0.03)^{t}=5\\,000\\cdot (0.97)^{t}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8da6b427-b2a9-5273-9d5b-a3e0321ac702"] :db/ensure [:question/validate]} {:db/id "answer-field-8da6b427-b2a9-5273-9d5b-a3e0321ac702" :answer-field/id #uuid "8da6b427-b2a9-5273-9d5b-a3e0321ac702" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-93358351-2598-53cd-95f8-321fc0f75e71" :answer-field/choices ["answer-c904b59d-277d-5b2f-87ed-d1719d7ae5d0" "answer-93358351-2598-53cd-95f8-321fc0f75e71" "answer-8c60717e-c83d-574a-b40b-5304cef96988" "answer-7e827a54-6096-5c80-bba1-693df6b26718" "answer-c3a71056-b38b-5ae1-9295-ea4b98694c2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c904b59d-277d-5b2f-87ed-d1719d7ae5d0" :answer/id #uuid "c904b59d-277d-5b2f-87ed-d1719d7ae5d0" :answer/type :answer.type/math :answer/value "y(t)=5\\,000\\cdot (0.03)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-93358351-2598-53cd-95f8-321fc0f75e71" :answer/id #uuid "93358351-2598-53cd-95f8-321fc0f75e71" :answer/type :answer.type/math :answer/value "y(t)=5\\,000\\cdot (0.97)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-8c60717e-c83d-574a-b40b-5304cef96988" :answer/id #uuid "8c60717e-c83d-574a-b40b-5304cef96988" :answer/type :answer.type/math :answer/value "y(t)=5\\,000\\cdot (1.03)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-7e827a54-6096-5c80-bba1-693df6b26718" :answer/id #uuid "7e827a54-6096-5c80-bba1-693df6b26718" :answer/type :answer.type/math :answer/value "y(t)=5\\,000\\cdot (1.97)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-c3a71056-b38b-5ae1-9295-ea4b98694c2d" :answer/id #uuid "c3a71056-b38b-5ae1-9295-ea4b98694c2d" :answer/type :answer.type/math :answer/value "y(t)=5\\,{000}^{t}\\cdot (0.97)^{t}" :db/ensure [:answer/validate]} {:db/id "question-5be49d8c-c7c0-5d12-b018-ff8157121a39" :question/id #uuid "5be49d8c-c7c0-5d12-b018-ff8157121a39" :question/math-academy-id "q-62054" :question/problem "The daily milk production on Debbie's farm has decreased at a rate of $12%$ every month. If the daily milk production was $1\\,130$ liters initially, then which function correctly represents $p(t),$ the daily milk production after $t$ months?" :question/worked-solution "The formula for exponential decay (in terms of a decay rate $r$) is\n\n$$\np(t)=a(1-r)^{t}.\n$$\n\nIn our case, we have the following:\n\n- $a=1\\,130$ is the initial daily milk production.\n\n- $r=0.12$ is the decay rate ($12%$ expressed as a decimal).\n\n- $t=$ the time, in months.\n\nTherefore, the correct expression for $p$ is\n\n$$\np(t)=1\\,130\\cdot (1-0.12)^{t}=1\\,130\\cdot (0.88)^{t}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c1172f21-48d5-50a2-8bbb-2e078be6a776"] :db/ensure [:question/validate]} {:db/id "answer-field-c1172f21-48d5-50a2-8bbb-2e078be6a776" :answer-field/id #uuid "c1172f21-48d5-50a2-8bbb-2e078be6a776" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e1e730d-f056-5195-a7a4-c483231ec40c" :answer-field/choices ["answer-d7e5ec68-33d5-5add-8170-e5568b2bb7dc" "answer-cf39f467-3e06-5bbf-a6dd-84f47ff74723" "answer-0fc51612-7335-5405-a867-06bedef88589" "answer-9e1e730d-f056-5195-a7a4-c483231ec40c" "answer-1971332b-98bc-5d82-9a5c-5ade21bcf18c"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7e5ec68-33d5-5add-8170-e5568b2bb7dc" :answer/id #uuid "d7e5ec68-33d5-5add-8170-e5568b2bb7dc" :answer/type :answer.type/math :answer/value "p(t)=1\\,130\\cdot (0.02)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-cf39f467-3e06-5bbf-a6dd-84f47ff74723" :answer/id #uuid "cf39f467-3e06-5bbf-a6dd-84f47ff74723" :answer/type :answer.type/math :answer/value "p(t)=1\\,130\\cdot (0.12)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-0fc51612-7335-5405-a867-06bedef88589" :answer/id #uuid "0fc51612-7335-5405-a867-06bedef88589" :answer/type :answer.type/math :answer/value "p(t)=1\\,130\\cdot (0.78)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-9e1e730d-f056-5195-a7a4-c483231ec40c" :answer/id #uuid "9e1e730d-f056-5195-a7a4-c483231ec40c" :answer/type :answer.type/math :answer/value "p(t)=1\\,130\\cdot (0.88)^{t}" :db/ensure [:answer/validate]} {:db/id "answer-1971332b-98bc-5d82-9a5c-5ade21bcf18c" :answer/id #uuid "1971332b-98bc-5d82-9a5c-5ade21bcf18c" :answer/type :answer.type/math :answer/value "p(t)=1\\,130\\cdot (0.98)^{t}" :db/ensure [:answer/validate]} {:db/id 17592186148687 :tutorial/content "To model an exponential decay situation, it is often useful to start by setting up a function which represents the exponential decay. Then, we can evaluate that function as needed.\n\nFor example, suppose that a car's value depreciates by one-fifth every year. If the car was purchased for $\\[math]25\\,000,$ then what function gives the car's value after $t$ years? \n\nFirst, note that if the car's value reduces by $\\dfrac 1 5$ every year, then $\\dfrac 4 5$ of its value remains every year.\n\nLet's write down what we know:\n\n- $a = 25\\,000$ is the **initial value** of the car (in dollars).\n\n- $b = \\dfrac 4 5$ is the **decay factor**.\n\n- $t=$ the time, in years.\n\nLet $y(t)$ be the car's value after $t$ years. The formula for $y(t)$ is given by\n\n$$\ny(t) = ab^t.\n$$\n\nSubstituting our values for $a$ and $b,$ we get\n\n$$\ny(t) = 25\\,000\\left(\\dfrac 4 5\\right)^t.\n$$\n\nTo find the value of the car after $5$ years, we substitute $t=5$ into the above:\n\n$$\n\\begin{aligned}y(5)=25\\,000\\cdot {(\\frac{4}{5})}^{5}=8\\,192\\end{aligned}\n$$\n\nTherefore, the car will be worth $\\[/math] 8\\,192$ in $5$ years." :db/ensure [:tutorial/validate]} {:db/id 17592186148688 :tutorial/content "It's common to use a **decay rate** (rather than a decay factor) when describing exponential decay. A decay rate is typically expressed using a percent.\n\nFor example, suppose that after treatment with a particular antibiotic, the number of infected cells in a specimen decreased by $30\\%$ per hour. If there were approximately $5$ million infected cells at the beginning of the treatment, how many infected cells remained after $3$ hours?\n\nLet $y(t)$ be the number of infected cells after $t$ hours. The formula for exponential decay (in terms of a decay rate $r$) is\n\n$$\ny = a(1-r)^t.\n$$\n\nNotice that this is very similar to the formula for exponential growth. The difference here is that we have a minus $(-)$ instead of a plus $(+)$ in the parentheses.\n\nIn our case, we have:\n\n- $a=5$ is the initial number of infected cells (in millions).\n\n- $r = 0.30$ is the decay rate ($30\\%$ expressed as a decimal).\n\n- $t=$ the time, in hours.\n\nTherefore, the correct expression for $y(t)$ is\n\n$$\ny  = 5(1-0.3)^{t}.\n$$\n\nSimplifying the above gives\n\n$$\ny(t) =5(0.7)^{t}.\n$$\n\nEvaluating the function for $t=3$ hours, we get\n\n$$\ny(3) = 5(0.7)^{3} = 1.715.\n$$\n\nTherefore, after $3$ hours, there were $1.715$ million infected cells.\n\nWhen writing down a formula for exponential decay, the key takeaway is this:\n\n- If we're given a **decay rate** (usually expressed as a percent), then we use the formula $y(t) = a(1-r)^t.$\n\n- If we're given a **decay factor**, then we use the formula $y(t) = ab^t.$" :db/ensure [:tutorial/validate]} {:db/id 17592186147672 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186115385 :knowledge-point/questions ["question-8a686be2-6ff3-542b-aec0-e3ca1a18babf" "question-a99e73a5-2dae-5b2f-a4fd-53ba3d7abecd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186114950 :question/problem "A house was purchased for $\\[math]90\\,000.$ Shortly after purchasing the property, the owners discovered widening cracks in the foundation. As a result, the value of the property is reduced by one-half every year. What does the expression $\\[/math]\\,90\\,000\\left(\\dfrac{1}{2}\\right)^6$ mean in this context?" :question/worked-solution "The given expression is an exponential decay expression of the form $y(t) = a \\cdot b^t,$ where we have the following:\n\n- $a=90\\,000$ represents the purchase price of the property.\n\n- $b = \\dfrac 1 2$ is the decay factor.\n\n- $t = 6$ the time, in years, since the property was bought.\n\nSince $t=6,$ the expression $\\[math]\\,90\\,000\\left(\\dfrac{1}{2}\\right)^6$ gives the value of the property after $6$ years." :db/ensure [:question/validate]} {:db/id 17592186115383 :knowledge-point/questions ["question-bce8526b-2382-5fd4-882b-274b4364bd61" "question-d33dc350-97af-5862-9547-76e026eaf801"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186114948 :question/problem "The value of a certain stock, in dollars, decays according to the formula\n\n$$\nV(t)= 4\\, 500\\cdot (0.85)^t,\n$$\n\nwhere $t$ is the time, in years, since the stock was bought. \n\nI. What does $V(3)$ mean in this context?\n\nII. Calculate $V(2) - V(3),$ and determine its meaning in this context." :question/worked-solution "- The value $V(3)$ represents the value of the function $V(t)$ at $t=3.$ In this context, it represents the value of the stock $3$ years after the initial investment.\n\n- By similar reasoning to the above, $V(2)$ represents the stock's value $2$ years after the initial investment. Therefore, the expression\n\n$$\nV(2) - V(3)\n$$\n\nrepresents the total reduction in the value of the stock between $t=2$ and $t=3$ years since the initial investment.\n\nNow, let's compute its value. We get\n\n$$\n\\begin{aligned}V(2)-V(3) & =4\\,500\\cdot (0.85)^{2}-4\\,500\\cdot (0.85)^{3} \\\\  & =487.6874 \\\\  & ≈488,\\end{aligned}\n$$\n\nrounded to the nearest integer. Therefore, the value of the stock dropped by $\\[math]488$ between years $2$ and $3.$" :db/ensure [:question/validate]} {:db/id 17592186115384 :knowledge-point/questions ["question-8a688991-2eb3-5f8d-836d-4a680ceee3ff" "question-836a9482-113e-597c-80f8-a8ed0a6b01c8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186114949 :question/problem "The market value ![](images/93/93636eb5ea1d6d8df4d0390651023dd9a4aa32ff9077d3edca03c6a4d2593c9f.svg) of a car, in dollars, ![](images/70/707bb132def3690d81bf1f0c8cf416c1382322ab19d66264cdab1decc4669307.svg) years since it was first purchased depreciates according to the following rule: \n![](images/9e/9eab3a81e5055a62b6e3dbba458b267fadf4ebdfe44786f23259fabc3d1cd409.svg)\n\nWhat does the base of the exponential expression ![](images/d6/d660f48227bd14736021adeb26de738a61fe583d94bc205ead8a5bab1c1acb61.svg) mean in this context?" :question/worked-solution "The given expression is an exponential decay expression of the form ![](images/52/527f98e7ede20d48ea37c58afcb0d4489fa5ad6651f21e3a7d1c08f5e3bb76ac.svg) where\n\n- ![](images/b6/b6cceb36174e4439694c8b988c00019d9707a7b6377e0c806c51c8d330e0ab4b.svg) represents the initial value of the car (in dollars).\n\n- ![](images/ef/ef47ff747a4899500bf1cdaa584e477954cd417238e8b7e695862da9b0022c6a.svg) where ![](images/3a/3a4ef1c1b261a53f9c45d0c90f2d44b155125fe1e7b1359406830111b4846f2f.svg) is the decay rate.\n\n- ![](images/70/707bb132def3690d81bf1f0c8cf416c1382322ab19d66264cdab1decc4669307.svg) is the time since the car was first purchased, in years.\n\nSolving for the decay rate ![](images/22/22d9393dcae7cd46f7da8986fc4764e2f14e127fb9dcdf114770ad2de2f6b098.svg) we get\n\n![](images/64/64161e1a2f19b6bdb3f7651e8a553179126ccf33901d20311347dbd9ff98aaab.svg)\n\nNow, ![](images/85/85eb3227c042f8ec4de535b2fb7fc37c5cd34735961e5ba26e6a511eff5707b5.svg) (expressed as a percent) is equal to ![](images/92/92e44f079247c93011878456e1294adc24fe51c089fd07e12107f1ad75e2d91d.svg) \n\nSo, the base of the exponential expression ![](images/55/551172a22e640525b7b69ef43cab353b50dd3ca6123574a3dd5df79475ea5496.svg) means that the value of the car depreciates by ![](images/41/414c7a992cb07b0cf60bef2446dc3eb4072aeb99acedf6d77c02b5c183cdfc63.svg) each year." :db/ensure [:question/validate]} {:db/id "question-8a686be2-6ff3-542b-aec0-e3ca1a18babf" :question/id #uuid "8a686be2-6ff3-542b-aec0-e3ca1a18babf" :question/math-academy-id "q-64117" :question/problem "A scientist observes that the mass, in grams, of a particular substance decays exponentially according to the rule  $12\\cdot (0.5)^{t},$ where $t$ is the time, in hours, since the beginning of observations.  What does the factor $12$ mean in this context?" :question/worked-solution "The given expression is an exponential decay expression of the form $y(t)=a\\cdot {b}^{t},$ where we have the following:\n\n- $a=12$ represents the initial mass of the sample.\n\n- $b=0.5$ is the decay factor.\n\n- $t$ is the time since the beginning of the observations, in hours.\n\nSince $a=12,$ this indicates that the sample's mass at the beginning of the observations was  $12$ grams." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4e6cc398-d3e6-51a5-bca6-28d64f2320a0"] :db/ensure [:question/validate]} {:db/id "answer-field-4e6cc398-d3e6-51a5-bca6-28d64f2320a0" :answer-field/id #uuid "4e6cc398-d3e6-51a5-bca6-28d64f2320a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab312762-790a-5e64-a63c-e1d4cb623633" :answer-field/choices ["answer-c7f1b31a-5249-57a7-91f8-34f57014c41d" "answer-4de488ef-505a-500b-ad78-f583f6144c09" "answer-c7b43987-37f7-5364-b35f-58555cc0100d" "answer-af234de8-eaa1-5aa9-92f0-3abd4d8f2279" "answer-ab312762-790a-5e64-a63c-e1d4cb623633"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7f1b31a-5249-57a7-91f8-34f57014c41d" :answer/id #uuid "c7f1b31a-5249-57a7-91f8-34f57014c41d" :answer/type :answer.type/text :answer/value "The mass of the sample decreases by $12$ grams every $5$ hours" :db/ensure [:answer/validate]} {:db/id "answer-4de488ef-505a-500b-ad78-f583f6144c09" :answer/id #uuid "4de488ef-505a-500b-ad78-f583f6144c09" :answer/type :answer.type/text :answer/value "The mass of the sample decreases by $12$ grams every hour" :db/ensure [:answer/validate]} {:db/id "answer-c7b43987-37f7-5364-b35f-58555cc0100d" :answer/id #uuid "c7b43987-37f7-5364-b35f-58555cc0100d" :answer/type :answer.type/text :answer/value "The mass of the sample increases by  $12$ grams every hour" :db/ensure [:answer/validate]} {:db/id "answer-af234de8-eaa1-5aa9-92f0-3abd4d8f2279" :answer/id #uuid "af234de8-eaa1-5aa9-92f0-3abd4d8f2279" :answer/type :answer.type/text :answer/value "The mass of the sample will always be at least $12$ grams" :db/ensure [:answer/validate]} {:db/id "answer-ab312762-790a-5e64-a63c-e1d4cb623633" :answer/id #uuid "ab312762-790a-5e64-a63c-e1d4cb623633" :answer/type :answer.type/text :answer/value "The sample's mass at the beginning of the observations was $12$ grams" :db/ensure [:answer/validate]} {:db/id "question-a99e73a5-2dae-5b2f-a4fd-53ba3d7abecd" :question/id #uuid "a99e73a5-2dae-5b2f-a4fd-53ba3d7abecd" :question/math-academy-id "q-112449" :question/problem "Due to a quarantine initiated in March $2020$, the number of reservations per night in a hotel decreased by one-quarter each month. By the end of $2020,$ the number of reservations per night decreased to $75\\cdot {(\\frac{3}{4})}^{9}.$ What does the factor $75$ mean in this context?" :question/worked-solution "The given expression is an exponential decay expression of the form $y(t)=a\\cdot {b}^{t}$, where we have the following:\n\n- $a=75$ represents the initial number of reservations per night.\n\n- $b=\\frac{3}{4}$ is the decay factor.\n\n- $t=9$ is the time, in months, since March $2020.$\n\nSince $a=75,$ this indicates that there were $75$ reservations initially." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ade6f4de-4aa6-5980-a9cd-b629e28dce38"] :db/ensure [:question/validate]} {:db/id "answer-field-ade6f4de-4aa6-5980-a9cd-b629e28dce38" :answer-field/id #uuid "ade6f4de-4aa6-5980-a9cd-b629e28dce38" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0bedd74b-c037-5d37-8e5f-1cba0a6bb7e3" :answer-field/choices ["answer-f23ec721-40a9-5e3e-97ba-f085f6149342" "answer-e8038edb-8fa3-5906-a2f7-a4795323716f" "answer-f8e554fa-e8b6-5704-866b-b331bc16cd1a" "answer-c0bd5f77-7ec1-5bab-b04b-3f9ff06d4e35" "answer-0bedd74b-c037-5d37-8e5f-1cba0a6bb7e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-f23ec721-40a9-5e3e-97ba-f085f6149342" :answer/id #uuid "f23ec721-40a9-5e3e-97ba-f085f6149342" :answer/type :answer.type/text :answer/value "The number of reservations per night decreased by $75$ each year" :db/ensure [:answer/validate]} {:db/id "answer-e8038edb-8fa3-5906-a2f7-a4795323716f" :answer/id #uuid "e8038edb-8fa3-5906-a2f7-a4795323716f" :answer/type :answer.type/text :answer/value "The number of reservations per night increased by $75$ each year" :db/ensure [:answer/validate]} {:db/id "answer-f8e554fa-e8b6-5704-866b-b331bc16cd1a" :answer/id #uuid "f8e554fa-e8b6-5704-866b-b331bc16cd1a" :answer/type :answer.type/text :answer/value "There were $75$ reservations per night $9$ months after March $2020$" :db/ensure [:answer/validate]} {:db/id "answer-c0bd5f77-7ec1-5bab-b04b-3f9ff06d4e35" :answer/id #uuid "c0bd5f77-7ec1-5bab-b04b-3f9ff06d4e35" :answer/type :answer.type/text :answer/value "There were $75$ reservations per night each month in $2020$" :db/ensure [:answer/validate]} {:db/id "answer-0bedd74b-c037-5d37-8e5f-1cba0a6bb7e3" :answer/id #uuid "0bedd74b-c037-5d37-8e5f-1cba0a6bb7e3" :answer/type :answer.type/text :answer/value "There were $75$ reservations per night initially" :db/ensure [:answer/validate]} {:db/id "question-bce8526b-2382-5fd4-882b-274b4364bd61" :question/id #uuid "bce8526b-2382-5fd4-882b-274b4364bd61" :question/math-academy-id "q-112525" :question/problem "The caffeine level, in milligrams, in a patient's bloodstream $t$ hours after drinking a cup of coffee is given by the function $C(t)=140\\cdot {(0.9)}^{t}.$ How much caffeine is metabolized between the second and third hour after drinking the coffee?" :question/worked-solution "We need to find the level of caffeine in the blood between $t=2$ and $t=3$ hours after drinking a cup of coffee. To calculate this, we find the level of caffeine in the blood after $2$ hours, and we subtract from it the level of caffeine in the blood after $3$ hours. So we need to evaluate\n\n$$\nC(2)-C(3).\n$$\n\nThe level of caffeine in the blood after $2$ hours is \n\n$$\n\\begin{aligned}C(2) & =140\\cdot {(0.9)}^{2} \\\\  & =140\\cdot 0.81 \\\\  & =113.4.\\end{aligned}\n$$\n\nThe level of caffeine in the blood after $3$ hours is \n\n$$\n\\begin{aligned}C(3) & =140\\cdot {(0.9)}^{3} \\\\  & =140\\cdot 0.729 \\\\  & =102.06.\\end{aligned}\n$$\n\nThus, the level of caffeine metabolized between $t=2$ and $t=3$ hours after drinking a cup of coffee is\n\n$$\n113.4-102.06=11.34.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-73fafd4e-edd5-5743-8519-b748f97293c4"] :db/ensure [:question/validate]} {:db/id "answer-field-73fafd4e-edd5-5743-8519-b748f97293c4" :answer-field/id #uuid "73fafd4e-edd5-5743-8519-b748f97293c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eff17da3-f67e-5378-acc1-934fd0f5f227" :answer-field/choices ["answer-db2ae0a7-f5fd-53f5-a329-0691e24fa0c1" "answer-eff17da3-f67e-5378-acc1-934fd0f5f227" "answer-9c797564-dac6-5eb1-9127-ab310ef8c78f" "answer-f0b02a77-2883-57bb-aa83-9fb226ae367c" "answer-d24c93c8-1dc6-5d91-94ea-78f93185c722"] :db/ensure [:answer-field/validate]} {:db/id "answer-db2ae0a7-f5fd-53f5-a329-0691e24fa0c1" :answer/id #uuid "db2ae0a7-f5fd-53f5-a329-0691e24fa0c1" :answer/type :answer.type/text :answer/value "$102.06$ milligrams" :db/ensure [:answer/validate]} {:db/id "answer-eff17da3-f67e-5378-acc1-934fd0f5f227" :answer/id #uuid "eff17da3-f67e-5378-acc1-934fd0f5f227" :answer/type :answer.type/text :answer/value "$11.34$ milligrams" :db/ensure [:answer/validate]} {:db/id "answer-9c797564-dac6-5eb1-9127-ab310ef8c78f" :answer/id #uuid "9c797564-dac6-5eb1-9127-ab310ef8c78f" :answer/type :answer.type/text :answer/value "$113.4$ milligrams" :db/ensure [:answer/validate]} {:db/id "answer-f0b02a77-2883-57bb-aa83-9fb226ae367c" :answer/id #uuid "f0b02a77-2883-57bb-aa83-9fb226ae367c" :answer/type :answer.type/text :answer/value "$12$ milligrams" :db/ensure [:answer/validate]} {:db/id "answer-d24c93c8-1dc6-5d91-94ea-78f93185c722" :answer/id #uuid "d24c93c8-1dc6-5d91-94ea-78f93185c722" :answer/type :answer.type/text :answer/value "$126$ milligrams" :db/ensure [:answer/validate]} {:db/id "question-d33dc350-97af-5862-9547-76e026eaf801" :question/id #uuid "d33dc350-97af-5862-9547-76e026eaf801" :question/math-academy-id "q-64120" :question/problem "The value of a boat, in dollars, depreciates according to the function $p(t)=10\\,000\\cdot {(0.9)}^{t},$ where $t$ is the number of years since the boat was purchased. Calculate $p(4),$ and determine its meaning in this context." :question/worked-solution "The value $p(4)$ represents the value of $p(t)$ at $t=4.$ In this context, it represents the value of the boat $4$ years after it was purchased.\n\nSubstituting $t=4$ into the expression for $p(t)$ gives\n\n$$\n\\begin{aligned}p(4) & =10\\,000\\cdot {(0.9)}^{4} \\\\  & =10\\,000\\cdot (0.656\\,1) \\\\  & =6\\,561.\\end{aligned}\n$$\n\nTherefore, the value of the boat after four years is $$6,561.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f94aa7fe-c122-5d2e-afea-03c77be24593"] :db/ensure [:question/validate]} {:db/id "answer-field-f94aa7fe-c122-5d2e-afea-03c77be24593" :answer-field/id #uuid "f94aa7fe-c122-5d2e-afea-03c77be24593" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bac5181e-4303-5faa-80ee-d64ecc1d0d99" :answer-field/choices ["answer-682f9c50-f1ca-51af-837c-a05b5dbf2539" "answer-b7bdc9c1-3109-5c94-87c8-c835fb3e0d4f" "answer-bac5181e-4303-5faa-80ee-d64ecc1d0d99" "answer-3e6168c3-ec73-5842-ac0b-41e0e64d2017" "answer-571af005-5fac-5ee1-92d0-b458708d0ac7"] :db/ensure [:answer-field/validate]} {:db/id "answer-682f9c50-f1ca-51af-837c-a05b5dbf2539" :answer/id #uuid "682f9c50-f1ca-51af-837c-a05b5dbf2539" :answer/type :answer.type/text :answer/value "The value of the boat after $4$ years is $$10\\,000.$" :db/ensure [:answer/validate]} {:db/id "answer-b7bdc9c1-3109-5c94-87c8-c835fb3e0d4f" :answer/id #uuid "b7bdc9c1-3109-5c94-87c8-c835fb3e0d4f" :answer/type :answer.type/text :answer/value "The value of the boat after $4$ years is $$5\\,901.$" :db/ensure [:answer/validate]} {:db/id "answer-bac5181e-4303-5faa-80ee-d64ecc1d0d99" :answer/id #uuid "bac5181e-4303-5faa-80ee-d64ecc1d0d99" :answer/type :answer.type/text :answer/value "The value of the boat after $4$ years is $$6\\,561.$" :db/ensure [:answer/validate]} {:db/id "answer-3e6168c3-ec73-5842-ac0b-41e0e64d2017" :answer/id #uuid "3e6168c3-ec73-5842-ac0b-41e0e64d2017" :answer/type :answer.type/text :answer/value "The value of the boat after $4$ years is $$7\\,290.$" :db/ensure [:answer/validate]} {:db/id "answer-571af005-5fac-5ee1-92d0-b458708d0ac7" :answer/id #uuid "571af005-5fac-5ee1-92d0-b458708d0ac7" :answer/type :answer.type/text :answer/value "The value of the boat depreciates by $$\\,10\\,000$ every four years" :db/ensure [:answer/validate]} {:db/id "question-8a688991-2eb3-5f8d-836d-4a680ceee3ff" :question/id #uuid "8a688991-2eb3-5f8d-836d-4a680ceee3ff" :question/math-academy-id "q-85527" :question/problem "The daily number of customers to a particular cafe declines according to the expression $500\\cdot (0.83)^{t}$, where $t$ is the number of days since the local news reported that the cafe did not pass a health inspection. \nWhat does the base of the exponential expression $(0.83)$ mean in this context?" :question/worked-solution "The given expression is an exponential decay expression of the form $y(t)=a\\cdot (1-r)^{t},$ where:\n\n- $a=500$ represents the initial number of customers.\n\n- $1-r=0.83,$ where $r$ is the decay rate.\n\n- $t$ is the time in days since the local news reported that the cafe did not pass a health inspection.\n\nSolving for $r,$ we get\n\n$$\n1-r=0.83\\,⟹\\,r=0.17.\n$$\n\nNow, $0.17$ (expressed as a percent) is equal to $17%.$ \n\nSo, the base of the exponential expression $0.83$ means that the number of customers decreases by $17%$ every day." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6aec91ab-d82d-5f67-b158-63b64417a2fd"] :db/ensure [:question/validate]} {:db/id "answer-field-6aec91ab-d82d-5f67-b158-63b64417a2fd" :answer-field/id #uuid "6aec91ab-d82d-5f67-b158-63b64417a2fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-842fdb7d-aaed-5236-a16e-8730aca130cd" :answer-field/choices ["answer-842fdb7d-aaed-5236-a16e-8730aca130cd" "answer-1f2fd4bc-8ad8-5931-940b-12d788278a82" "answer-5b462848-a0e5-5c5d-9e8b-6adbac840b81" "answer-62598ce9-1c57-55c6-9267-929be01338ae" "answer-bf65f838-2329-5424-bfb0-efc4aa5e22da"] :db/ensure [:answer-field/validate]} {:db/id "answer-842fdb7d-aaed-5236-a16e-8730aca130cd" :answer/id #uuid "842fdb7d-aaed-5236-a16e-8730aca130cd" :answer/type :answer.type/text :answer/value "The number of customers decreases by $17%$ every day" :db/ensure [:answer/validate]} {:db/id "answer-1f2fd4bc-8ad8-5931-940b-12d788278a82" :answer/id #uuid "1f2fd4bc-8ad8-5931-940b-12d788278a82" :answer/type :answer.type/text :answer/value "The number of customers decreases by $83%$ every day" :db/ensure [:answer/validate]} {:db/id "answer-5b462848-a0e5-5c5d-9e8b-6adbac840b81" :answer/id #uuid "5b462848-a0e5-5c5d-9e8b-6adbac840b81" :answer/type :answer.type/text :answer/value "The number of customers increases by $17%$ every day" :db/ensure [:answer/validate]} {:db/id "answer-62598ce9-1c57-55c6-9267-929be01338ae" :answer/id #uuid "62598ce9-1c57-55c6-9267-929be01338ae" :answer/type :answer.type/text :answer/value "The number of customers increases by $83%$ every day" :db/ensure [:answer/validate]} {:db/id "answer-bf65f838-2329-5424-bfb0-efc4aa5e22da" :answer/id #uuid "bf65f838-2329-5424-bfb0-efc4aa5e22da" :answer/type :answer.type/text :answer/value "There were $83$ customers initially." :db/ensure [:answer/validate]} {:db/id "question-836a9482-113e-597c-80f8-a8ed0a6b01c8" :question/id #uuid "836a9482-113e-597c-80f8-a8ed0a6b01c8" :question/math-academy-id "q-85526" :question/problem "Due to acaricides, the population of ticks in a certain park decreases according to the expression $20\\,000\\cdot (0.7)^{t},$ where $t$ is the time, in weeks, since acaricides were first applied. What does the base of the exponential expression $(0.7)$ mean in this context?" :question/worked-solution "The given expression is an exponential decay expression of the form $y(t)=a\\cdot (1-r)^{t},$ where:\n\n- $a=20\\,000$ represents the initial number of ticks.\n\n- $1-r=0.7,$ where $r$ is the decay rate.\n\n- $t$ is the time, in weeks, since the acaricides were first applied.\n\nSolving for $r,$ we get\n\n$$\n1-r=0.7\\,⟹\\,r=0.3.\n$$\n\nNow, $0.3$ (expressed as a percent) is equal to $30%.$ \n\nSo, the base of the exponential expression $0.7$ means that the population of ticks decreases by $30%$ every week." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7c41047d-dc64-5d42-b2e6-178103fc1b49"] :db/ensure [:question/validate]} {:db/id "answer-field-7c41047d-dc64-5d42-b2e6-178103fc1b49" :answer-field/id #uuid "7c41047d-dc64-5d42-b2e6-178103fc1b49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-19383a11-e51a-5394-8c61-b649e6bdd6a7" :answer-field/choices ["answer-19383a11-e51a-5394-8c61-b649e6bdd6a7" "answer-556e5656-5915-5883-a0df-bf099080f624" "answer-beffae14-374a-5cc1-afc4-57fb68a71704" "answer-97a9c6fb-5cd4-57fa-9e3d-7809fba02632" "answer-c5cace87-2dbe-5012-8bc0-2f5187cf6ad9"] :db/ensure [:answer-field/validate]} {:db/id "answer-19383a11-e51a-5394-8c61-b649e6bdd6a7" :answer/id #uuid "19383a11-e51a-5394-8c61-b649e6bdd6a7" :answer/type :answer.type/text :answer/value "The population of ticks decreases by $30%$ every week" :db/ensure [:answer/validate]} {:db/id "answer-556e5656-5915-5883-a0df-bf099080f624" :answer/id #uuid "556e5656-5915-5883-a0df-bf099080f624" :answer/type :answer.type/text :answer/value "The population of ticks decreases by $70%$ every week" :db/ensure [:answer/validate]} {:db/id "answer-beffae14-374a-5cc1-afc4-57fb68a71704" :answer/id #uuid "beffae14-374a-5cc1-afc4-57fb68a71704" :answer/type :answer.type/text :answer/value "The population of ticks increases by $30%$ every week" :db/ensure [:answer/validate]} {:db/id "answer-97a9c6fb-5cd4-57fa-9e3d-7809fba02632" :answer/id #uuid "97a9c6fb-5cd4-57fa-9e3d-7809fba02632" :answer/type :answer.type/text :answer/value "The population of ticks increases by $70%$ every week" :db/ensure [:answer/validate]} {:db/id "answer-c5cace87-2dbe-5012-8bc0-2f5187cf6ad9" :answer/id #uuid "c5cace87-2dbe-5012-8bc0-2f5187cf6ad9" :answer/type :answer.type/text :answer/value "There were $70$ ticks initially" :db/ensure [:answer/validate]} {:db/id 17592186116434 :tutorial/content "In this lesson, we will learn how to interpret various aspects of an exponential decay expression or function.\n\nFor example, suppose that, due to overfishing, a fish population decays exponentially. The population $y(t)$ is given by\n\n$$\ny(t) = 5\\,000 \\left(\\dfrac 1 2\\right)^t,\n$$\n\nwhere $t$ is the time, in months, since the overfishing began. What can we deduce about the population of fish from this model?\n\nThe first thing to notice is that the function above is an exponential decay function of the form\n\n$$\ny(t) = a \\cdot b^t.\n$$\n\nSo, we can deduce the following:\n\n- $a=5\\,000$ represents the initial value. So this tells us that there were $5\\,000$ fish when the overfishing began.\n\n- $b = \\dfrac 1 2$ is the decay factor. Since $0 < b < 1,$ this tells us that we're dealing with exponential decay, *not* exponential growth (for exponential growth we need $b > 1$).\n\n- $t$ is the time, in months, since the overfishing began." :db/ensure [:tutorial/validate]} {:db/id 17592186115438 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186127117 :answer-field/choices 17592186127120] [:db/retract 17592186127117 :answer-field/choices 17592186127121] [:db/retract 17592186127117 :answer-field/choices 17592186127122] [:db/retract 17592186127117 :answer-field/choices 17592186127118] [:db/retract 17592186127117 :answer-field/choices 17592186127119] {:db/id 17592186129161 :knowledge-point/questions ["question-95921cae-0a0b-5427-8528-229b03960d35"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129606 :question/problem "For the function $f(x,y,z)=\\operatorname{ln}⁡(\\sqrt{yz})-\\sqrt{x+1},$ find the equation of the level surface $f(x,y,z)=0.$" :question/worked-solution "Recall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{ln}⁡(\\sqrt{yz})-\\sqrt{x+1} & =0 \\\\ \\operatorname{ln}⁡(\\sqrt{yz}) & =\\sqrt{x+1} \\\\ \\sqrt{yz} & ={e}^{\\sqrt{x+1}} \\\\ yz & ={({e}^{\\sqrt{x+1}})}^{2} \\\\ z & =\\frac{{e}^{2\\sqrt{x+1}}}{y}\\end{aligned}\n$$\n\nTherefore, the level surface for $c=0$ is the surface $z=\\frac{{e}^{2\\sqrt{x+1}}}{y}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186127117 :answer-field/correct "answer-c6ff3e45-de27-5738-a884-ad437f51e2b6" :answer-field/choices ["answer-1eaf098d-4f19-555f-9faf-939cea3c6583" "answer-c6ff3e45-de27-5738-a884-ad437f51e2b6" "answer-07bae223-68a9-5961-9914-da375ccce6c0" "answer-88df6524-28d0-527e-835e-f94d1cb3d8aa" "answer-ea4da4e5-c2d2-5952-a370-830c063e72c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-1eaf098d-4f19-555f-9faf-939cea3c6583" :answer/id #uuid "1eaf098d-4f19-555f-9faf-939cea3c6583" :answer/type :answer.type/math :answer/value "z=\\frac{x+1}{y}" :db/ensure [:answer/validate]} {:db/id "answer-c6ff3e45-de27-5738-a884-ad437f51e2b6" :answer/id #uuid "c6ff3e45-de27-5738-a884-ad437f51e2b6" :answer/type :answer.type/math :answer/value "z=\\frac{{e}^{2\\sqrt{x+1}}}{y}" :db/ensure [:answer/validate]} {:db/id "answer-07bae223-68a9-5961-9914-da375ccce6c0" :answer/id #uuid "07bae223-68a9-5961-9914-da375ccce6c0" :answer/type :answer.type/math :answer/value "z=\\frac{{e}^{\\sqrt{x+1}}}{y}" :db/ensure [:answer/validate]} {:db/id "answer-88df6524-28d0-527e-835e-f94d1cb3d8aa" :answer/id #uuid "88df6524-28d0-527e-835e-f94d1cb3d8aa" :answer/type :answer.type/math :answer/value "z=\\frac{{e}^{x+1}}{y}" :db/ensure [:answer/validate]} {:db/id "answer-ea4da4e5-c2d2-5952-a370-830c063e72c9" :answer/id #uuid "ea4da4e5-c2d2-5952-a370-830c063e72c9" :answer/type :answer.type/math :answer/value "z={e}^{2\\sqrt{x+1}-y}" :db/ensure [:answer/validate]} {:db/id "question-95921cae-0a0b-5427-8528-229b03960d35" :question/id #uuid "95921cae-0a0b-5427-8528-229b03960d35" :question/math-academy-id "q-71584" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=\\frac{1}{3{x}^{2}+{y}^{2}}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{1}{3{x}^{2}+{y}^{2}} & =c \\\\ c(3{x}^{2}+{y}^{2}) & =1 \\\\ 3c{x}^{2}+c{y}^{2} & =1\\end{aligned}\n$$\n\nNotice that $f(x,y,z)$ can't be zero or negative. Therefore, we get a family of surfaces given by\n\n$$\n3c{x}^{2}+c{y}^{2}=1,\\,c\\in (0,\\infty ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-113c6c84-a326-59a4-aca0-106d9621d960"] :db/ensure [:question/validate]} {:db/id "answer-field-113c6c84-a326-59a4-aca0-106d9621d960" :answer-field/id #uuid "113c6c84-a326-59a4-aca0-106d9621d960" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d194602d-cc7c-51ec-a4ff-52ca3453f17d" :answer-field/choices ["answer-6ddf0199-8b66-5e41-b0ea-4bdf1a9d0e7b" "answer-fd32e248-1201-5b37-b595-0f0420859b89" "answer-d194602d-cc7c-51ec-a4ff-52ca3453f17d" "answer-8d268ae2-5c04-5477-bdf6-af3c935a1550" "answer-073764a6-4153-5fe6-b84d-4c9ca0a950a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ddf0199-8b66-5e41-b0ea-4bdf1a9d0e7b" :answer/id #uuid "6ddf0199-8b66-5e41-b0ea-4bdf1a9d0e7b" :answer/type :answer.type/text :answer/value "A family of elliptic paraboloids: $3c{x}^{2}+c{y}^{2}=z$" :db/ensure [:answer/validate]} {:db/id "answer-fd32e248-1201-5b37-b595-0f0420859b89" :answer/id #uuid "fd32e248-1201-5b37-b595-0f0420859b89" :answer/type :answer.type/text :answer/value "A family of hyperboloids of one sheet: $3c{x}^{2}+c{y}^{2}-{z}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "answer-d194602d-cc7c-51ec-a4ff-52ca3453f17d" :answer/id #uuid "d194602d-cc7c-51ec-a4ff-52ca3453f17d" :answer/type :answer.type/text :answer/value "A family of surfaces given by $3c{x}^{2}+c{y}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "answer-8d268ae2-5c04-5477-bdf6-af3c935a1550" :answer/id #uuid "8d268ae2-5c04-5477-bdf6-af3c935a1550" :answer/type :answer.type/text :answer/value "A family of surfaces given by $3c{x}^{2}-c{y}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "answer-073764a6-4153-5fe6-b84d-4c9ca0a950a2" :answer/id #uuid "073764a6-4153-5fe6-b84d-4c9ca0a950a2" :answer/type :answer.type/text :answer/value "A family of surfaces given by $3c{x}^{2}-c{y}^{2}={z}^{2}$" :db/ensure [:answer/validate]} {:db/id 17592186129326 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186485418 :answer-field/correct "answer-b97ecb8d-3184-5f67-a554-c761f886d4ec" :answer-field/choices ["answer-b97ecb8d-3184-5f67-a554-c761f886d4ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-b97ecb8d-3184-5f67-a554-c761f886d4ec" :answer/id #uuid "b97ecb8d-3184-5f67-a554-c761f886d4ec" :answer/type :answer.type/math :answer/value "1\\frac{2}{7}" :db/ensure [:answer/validate]} [:db/retract 17592186100413 :answer-field/choices 17592186100416] [:db/retract 17592186100413 :answer-field/choices 17592186100417] [:db/retract 17592186100413 :answer-field/choices 17592186100418] [:db/retract 17592186100413 :answer-field/choices 17592186100414] [:db/retract 17592186100413 :answer-field/choices 17592186100415] {:db/id 17592186100838 :knowledge-point/questions ["question-1a6b4914-aa75-5cc3-80a2-4dde99e3c7aa" "question-761b830c-0a32-54fa-8bad-182a530f7511" "question-b92c6e01-0c5a-5f6e-a138-545af5c6ad5d" "question-5c2829d5-9e3f-5d96-8caf-fe7beef5d605" "question-c4e37c29-e44f-56ff-9916-25bc220edbdb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100648 :question/problem "Suppose that we want to make a box with a square base and without a lid using metal sheets. We have only $4 \\, \\textrm{m} ^ 2$ of sheet metal to create the box. Given that the volume of the box has been maximized, find the value of $x.$\n\n![](images/68/6821176223c59c981ac57cfa754044a145754b747baf7985f7eefd073dcd8758.png)" :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such that the volume\n\n$$\nV = x\\cdot x\\cdot y = x^2 y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $4 \\, \\textrm{m} ^ 2$. So, we have the constraint equation\n\n$$\n\\eqalign{\n S &= \\textrm{(area of the base) } + 4 \\, \\textrm{(area of one side) } \\[5pt]\n4 &= x^2 + 4 x y.}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation: \n\n$$\ny = \\dfrac{1}{x} - \\dfrac{x}{4}\n$$\n\nThen, we substitute $y = \\dfrac{1}{x} - \\dfrac{x}{4}$ in the expression $V=x^2y,$ and we get\n\n$$\n\\eqalign{\nV(x) &= x^2 \\left( \\dfrac{1}{x} - \\dfrac{x}{4}\\right) \\[5pt]\n&= x - \\dfrac{x^3}{4}.\n}\n$$\n\n \n\n**Step 4**: We solve the equation $V'(x)=0.$ Taking the derivative, we have\n\n$$\nV'(x) = 1 - \\dfrac{3x^2}{4},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\eqalign{\nV'(x) &= 0 \\[5pt]\n1 - \\dfrac{3x^2}{4} &=0 \\[5pt]\nx^2 &= \\dfrac{4}{3} \\[5pt]\nx &= \\dfrac{2\\sqrt{3}}{3}.\n}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=\\dfrac{2\\sqrt{3}}{3}$ is a maximum using the second derivative test. The second derivative is\n\n$$\nV''(x) = -\\dfrac{3}{2}x \\quad \\Longrightarrow \\quad V''\\left(\\dfrac{2\\sqrt{3}}{3}\\right) = -\\sqrt{3} < 0.\n$$\n\nSince $V''\\left(\\dfrac{2\\sqrt{3}}{3}\\right)$ is negative, we conclude that $x=\\dfrac{2\\sqrt{3}}{3}$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x= \\dfrac{2\\sqrt{3}}{3}\\,\\mathrm{m}.$" :db/ensure [:question/validate]} {:db/id 17592186100839 :knowledge-point/questions ["question-90ab0435-552f-51ca-b675-8d58a2c58837" "question-97252151-ba80-5f2a-b51f-786d26797ca5" "question-64a50494-969c-52da-a2bf-9af25982f51d" "question-445bb805-c2f6-5166-9dd9-5663cfa2ac32" "question-e2adf7b9-c049-5411-a710-9c822b654299"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100649 :question/problem "Consider a box with a square base with side lengths $x$ and height $y,$ as shown below. The volume of the box is $1$ cubic unit. Given that the surface area of the box has been minimized, find the value of $x.$\n\n![](images/5f/5f852cff121a53206cdcfeb8f4a0efec5a43fd2ed73ab569ec537cbe896b405c.png)" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the surface area\n\n$$\nS = 2x^2 + 4xy\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume is exactly $1$ cubic unit. So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot x\\cdot y \\\\ 1 & ={x}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}{x}^{2}y & =1 \\\\ y & =\\frac{1}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $S,$ and we get\n\n$$\n\\begin{aligned}S & =2{x}^{2}+4xy \\\\  & =2{x}^{2}+4x\\cdot \\frac{1}{{x}^{2}} \\\\  & =2{x}^{2}+\\frac{4}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation $S'(x)=0.$ Taking the derivative, we have\n\n$$\nS'(x) = 4x - \\dfrac{4}{x^2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{S}^{′}(x) & =0 \\\\ 4x-\\frac{4}{{x}^{2}} & =0 \\\\ 4x & =\\frac{4}{{x}^{2}} \\\\ 4{x}^{3} & =4 \\\\ {x}^{3} & =1 \\\\ x & =1.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=1$ is a minimum using the second derivative test. The second derivative is\n\n$$\nS''(x) = 4 + \\frac{8}{x^3} \\quad \\Longrightarrow \\quad S''(1) = 4 + 8 = 12 > 0.\n$$\n\nSince $S''\\left(1\\right)$ is positive, we conclude that $x=1$ is indeed a minimum of $S(x).$\n\nTherefore, the box with the smallest possible surface area has side length $x= 1$ unit." :db/ensure [:question/validate]} {:db/id 17592186100940 :knowledge-point/questions ["question-5f708375-cdc1-53f8-8bb4-b17c1643502c" "question-d9422237-5095-57b7-8cd1-109d7184ed3e" "question-caab3419-40f4-5f42-9fc6-7d0c53c70e6a" "question-180b48d4-1e2c-527c-b442-f02b5ba67824"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100771 :question/problem "A box with no lid and a square base has a manufacturing cost that depends on two materials. The material for the base costs $\\[math]4$ per square meter, and the material for the lateral faces costs $\\[/math]2$ per square meter. The box must have a volume of $8\\,\\mathrm{m^3}.$\n\nWhat is the value of $x$ for the box that has the smallest production cost? \n\n![](images/a6/a6f83d3c86e6d5c2e470f68e2e75f32c2fb7573a08cc188d2fd7080103351076.png)" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =4{x}^{2}+2\\cdot 4xy \\\\  & =4{x}^{2}+8xy\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $8\\,\\mathrm{m^3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot x\\cdot y \\\\ 8 & ={x}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}{x}^{2}y & =8 \\\\ y & =\\frac{8}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =4{x}^{2}+8xy \\\\ C & =4{x}^{2}+8x\\cdot \\frac{8}{{x}^{2}} \\\\ C & =4{x}^{2}+\\frac{64}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation $C'(x)=0.$ Taking the derivative, we have\n\n$$\nC'(x) = 8x - \\frac{64}{x^2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(x) & =0 \\\\ 8x-\\frac{64}{{x}^{2}} & =0 \\\\ 8{x}^{3} & =64 \\\\ {x}^{3} & =8 \\\\ x & =2.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=2$ is a minimum using the second derivative test. The second derivative is\n\n$$\nC''(x) = 8 + \\dfrac{128}{x^3} \\quad \\Longrightarrow \\quad C''\\left(2\\right) > 0.\n$$\n\nSince $C''\\left( 2\\right)$ is positive, we conclude that $x=2$ is indeed a minimum of $C(x).$" :db/ensure [:question/validate]} {:db/id 17592186100939 :knowledge-point/questions ["question-d416390a-8b08-58ae-b4bd-805af1c30ba3" "question-3a8692c9-b01b-529e-b66c-5ef584b340c0" "question-35d71232-f38b-500b-9a6f-4af0bdca3a38" "question-fcc5cb30-3a54-5c1c-aecb-10ee16fa7222" "question-9d40af61-e6e1-509f-9bd7-a155591f2abe"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100770 :question/problem "A piece of cardboard measures $12\\,\\mathrm{cm}\\times 8\\, \\mathrm{cm}.$ A tray of height $y\\,\\textrm{cm}$ is formed by cutting a $y\\times y \\,\\textrm{cm}^2$ square from each of the corners and folding up the sides, as shown in the diagram. Determine the height of the box that gives the maximum possible volume. Round your answer to two decimal places.\n\n![](images/4a/4a3bab5daf0f7426d5b2ddf418439d7c6b8a6651a3de7b17dcfcdf2f6616f898.png)" :question/worked-solution "**Step 1**: We need to find the values of $x, y,$ and $z$ such that the volume\n\n$$\nV = xyz\n$$\n\nis the greatest possible value.\n\n**Step 2**: Notice that the width $x$ and the depth $z$ of the tray are given by\n\n$$\nx=12 - 2y,\\qquad z=8-2y.\n$$\n\n \n\nSince $x > 0$ and $z > 0,$ we must have that $12-2y > 0$ and $8-2y >0$, hence $y<       4.$ Therefore, the range of validity for $y$ is $0 <             y <             4.$\n\n**Step 3**: Substituting the above into the expression for $V,$ we get\n\n$$\n\\begin{aligned}V & =xyz \\\\  & =(12-2y)(y)(8-2y) \\\\  & =4{y}^{3}-40{y}^{2}+96y.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation $V'(y) = 0.$ Taking the first derivative, we have\n\n$$\nV'(y) = 12y^2 - 80y + 96,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 12{y}^{2}-80y+96 & =0 \\\\ 3{y}^{2}-20y+24 & =0 \\\\ y & =\\frac{10\\pm 2\\sqrt{7}}{3}.\\end{aligned}\n$$\n\nWe discard $\\dfrac{10 + 2\\sqrt{7}}{3}$ since we already know that $0 <      y <     4.$\n\n**Step 5**: We confirm that $\\dfrac{10 - 2\\sqrt{7}}{3}$ is a maximum using the second derivative test. The second derivative is\n\n$$\nV''(y) = 24y -80 .\n$$\n\nSince $V'' \\left(\\dfrac{10 - 2\\sqrt{7}}{3}\\right)$ is negative, we conclude that $\\dfrac{10-2\\sqrt{7}}{3}$ is indeed a maximum of $V(y).$\n\nTherefore, the stationary point $y=\\dfrac{10- 2\\sqrt{7}}{3} \\approx 1.57$ gives the maximum possible volume." :db/ensure [:question/validate]} {:db/id "question-1a6b4914-aa75-5cc3-80a2-4dde99e3c7aa" :question/id #uuid "1a6b4914-aa75-5cc3-80a2-4dde99e3c7aa" :question/math-academy-id "q-345710" :question/problem "![](images/9d/9d3a3f70571b0bfca1d4c5251113b915a8061955cb6f48c310d1939571c14e47.png)\n\nConsider a box with a surface area of $432$ square units whose depth $z$ is twice its height $y.$ Find the value of $y$ that maximizes the volume of the box. Do not round the answer.\n\n$y=$\n{{field-1}} units" :question/worked-solution "**Step 1**: We need to find the value of $y$ such that the volume\n\n$$\nV=x\\cdot y\\cdot z=x\\cdot y\\cdot (2y)=2x{y}^{2}\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $432$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 432 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $z=2y,$ we get the constraint equation\n\n$$\n\\begin{aligned}432 & =2xy+2x(2y)+2y(2y) \\\\ 432 & =2xy+4xy+4{y}^{2} \\\\ 432 & =6xy+4{y}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\nx=\\frac{72}{y}-\\frac{2}{3}y\n$$\n\nThen, we substitute the above into the expression $V=2x{y}^{2}$, and we get\n\n$$\n\\begin{aligned}V(y) & =2{y}^{2}(\\frac{72}{y}-\\frac{2}{3}y) \\\\  & =144y-\\frac{4}{3}{y}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(y)=144-4{y}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 144-4{y}^{2} & =0 \\\\ {y}^{2} & =36 \\\\ y & =6.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $y$ must be positive.\n\n**Step 5**: We confirm that $y=6$ gives a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=-8y\\,⟹\\,{V}^{″}(6)=-48<0,\n$$\n\nSince ${V}^{″}(6)$ is negative, we conclude that this is indeed a maximum of $V(y).$\n\nTherefore, the box with the largest possible volume has height $y=6$ units." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d2612f85-d0e6-5136-9f42-955b4fa6d7df"] :db/ensure [:question/validate]} {:db/id "answer-field-d2612f85-d0e6-5136-9f42-955b4fa6d7df" :answer-field/id #uuid "d2612f85-d0e6-5136-9f42-955b4fa6d7df" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e89341e7-0a99-54b4-8ee8-d0404032d7ce" :answer-field/choices ["answer-e89341e7-0a99-54b4-8ee8-d0404032d7ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-e89341e7-0a99-54b4-8ee8-d0404032d7ce" :answer/id #uuid "e89341e7-0a99-54b4-8ee8-d0404032d7ce" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-761b830c-0a32-54fa-8bad-182a530f7511" :question/id #uuid "761b830c-0a32-54fa-8bad-182a530f7511" :question/math-academy-id "q-86444" :question/problem "![](images/c4/c4bbdc87980efd87c64fdb8fa693078817e16bbff136f94a2ac4dfc2c651b17d.png)\n\nConsider a box with a surface area of $48$ square units whose width $x$ is twice its depth $z.$ Given that the volume of the box has been maximized, find the value of $z.$" :question/worked-solution "**Step 1**: We need to find the values of $x,y,$ and $z$ such as the volume\n\n$$\nV=x\\cdot y\\cdot z=2z\\cdot y\\cdot z=2{z}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $48$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 48 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $x=2z,$ we get the constraint equation\n\n$$\n\\begin{aligned}48 & =2(2z)y+2(2z)z+2yz \\\\ 48 & =4yz+4{z}^{2}+2yz \\\\ 48 & =6zy+4{z}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\ny=\\frac{8}{z}-\\frac{2z}{3}\n$$\n\nThen, we substitute the above into the expression $V=2{z}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(z) & =2{z}^{2}(\\frac{8}{z}-\\frac{2z}{3}) \\\\  & =16z-\\frac{4{z}^{3}}{3}.\\end{aligned}\n$$\n\n \n\n**Step 4**: We solve the equation ${V}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(z)=16-4{z}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(z) & =0 \\\\ 16-4{z}^{2} & =0 \\\\ 4{z}^{2} & =16 \\\\ {z}^{2} & =4 \\\\ z & =2.\\end{aligned}\n$$\n\nNote that in the last step we only considered the positive root because the side length $z$ must be positive. \n\n**Step 5**: We confirm that $z=2$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(z)=-8z\\,⟹\\,{V}^{″}(2)=-16<0.\n$$\n\nSince ${V}^{″}(2)$ is negative, we conclude that $z=2$ is indeed a maximum of $V(z).$\n\nTherefore, the box with the largest possible volume has the depth $z=2$ units." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4602ce5d-f822-5ca0-be6a-48bf4ed019b6"] :db/ensure [:question/validate]} {:db/id "answer-field-4602ce5d-f822-5ca0-be6a-48bf4ed019b6" :answer-field/id #uuid "4602ce5d-f822-5ca0-be6a-48bf4ed019b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0537abd7-a8e3-5e03-942c-995d6f529136" :answer-field/choices ["answer-6cb12530-fd20-580c-82b5-c18a59275996" "answer-0537abd7-a8e3-5e03-942c-995d6f529136" "answer-5ca78e5f-4526-5e7d-b040-fddd4bb1d76e" "answer-d7e32750-215a-562c-b103-dd8b4e7efcae" "answer-d4e971d1-8c16-5fc9-b311-c4c6b9cd78ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-6cb12530-fd20-580c-82b5-c18a59275996" :answer/id #uuid "6cb12530-fd20-580c-82b5-c18a59275996" :answer/type :answer.type/text :answer/value "$1$ unit" :db/ensure [:answer/validate]} {:db/id "answer-0537abd7-a8e3-5e03-942c-995d6f529136" :answer/id #uuid "0537abd7-a8e3-5e03-942c-995d6f529136" :answer/type :answer.type/text :answer/value "$2$ units" :db/ensure [:answer/validate]} {:db/id "answer-5ca78e5f-4526-5e7d-b040-fddd4bb1d76e" :answer/id #uuid "5ca78e5f-4526-5e7d-b040-fddd4bb1d76e" :answer/type :answer.type/text :answer/value "$3$ units" :db/ensure [:answer/validate]} {:db/id "answer-d7e32750-215a-562c-b103-dd8b4e7efcae" :answer/id #uuid "d7e32750-215a-562c-b103-dd8b4e7efcae" :answer/type :answer.type/text :answer/value "$\\frac{3}{2}$ units" :db/ensure [:answer/validate]} {:db/id "answer-d4e971d1-8c16-5fc9-b311-c4c6b9cd78ac" :answer/id #uuid "d4e971d1-8c16-5fc9-b311-c4c6b9cd78ac" :answer/type :answer.type/text :answer/value "$\\frac{5}{2}$ units" :db/ensure [:answer/validate]} {:db/id "question-b92c6e01-0c5a-5f6e-a138-545af5c6ad5d" :question/id #uuid "b92c6e01-0c5a-5f6e-a138-545af5c6ad5d" :question/math-academy-id "q-315610" :question/problem "![](images/d8/d85a061ab65d269f22f589e7f57b07a6d474db5f6f29c8c8b412701b99de5241.png)\n\nA box has a square base with side lengths $x$ and height $y,$ as shown above. The surface area of the box is $294$ square units. Find the value of $x$ that maximizes the volume of the box. Do not round the answer.\n\n$x=$\n{{field-1}} units" :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such that the volume\n\n$$\nV={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $294$ square units. So, we have the constraint equation\n\n$$\n\\begin{aligned}S & =2\\,\\text{(area of the base)}+4\\,\\text{(area of one side)} \\\\ 294 & =2{x}^{2}+4xy.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation:\n\n$$\ny=\\frac{147}{2x}-\\frac{x}{2}\n$$\n\nThen, we substitute $y=\\frac{147}{2x}-\\frac{x}{2}$ in the expression $V={x}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(x) & ={x}^{2}(\\frac{147}{2x}-\\frac{x}{2}) \\\\  & =\\frac{147}{2}x-\\frac{1}{2}{x}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(x)=\\frac{147}{2}-\\frac{3}{2}{x}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(x) & =0 \\\\ \\frac{147}{2}-\\frac{3}{2}{x}^{2} & =0 \\\\ {x}^{2} & =49 \\\\ x & =7.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=7$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(x)=-3x\\,⟹\\,{V}^{″}(7)=-21<0.\n$$\n\nSince ${V}^{″}(7)$ is negative, we conclude that $x=7$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x=7$ units." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ff4887d-6a17-5344-b94f-128a6e93bf49"] :db/ensure [:question/validate]} {:db/id "answer-field-1ff4887d-6a17-5344-b94f-128a6e93bf49" :answer-field/id #uuid "1ff4887d-6a17-5344-b94f-128a6e93bf49" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b59cd9ec-ed17-5488-ab14-6feb69d8c6cb" :answer-field/choices ["answer-b59cd9ec-ed17-5488-ab14-6feb69d8c6cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-b59cd9ec-ed17-5488-ab14-6feb69d8c6cb" :answer/id #uuid "b59cd9ec-ed17-5488-ab14-6feb69d8c6cb" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-5c2829d5-9e3f-5d96-8caf-fe7beef5d605" :question/id #uuid "5c2829d5-9e3f-5d96-8caf-fe7beef5d605" :question/math-academy-id "q-81624" :question/problem "![](images/5c/5cd38fb898d5cc3fcef43ae6397b02f22fbd06cbe598263fe77ce6b936c16bae.png)\n\nA box has a square base with side lengths $x$ and height $y,$ as shown above. The surface area of the box is $216$ square units. Given that the volume of the box has been maximized, find the value of $x.$" :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such as the volume\n\n$$\nV=x\\cdot x\\cdot y={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: The surface area is $216$ square units. So, we have the constraint equation\n\n$$\n\\begin{aligned}S & =2\\,\\text{(area of the base) }+4\\,\\text{(area of  one side) } \\\\ 216 & =2{x}^{2}+4xy.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject in the constraint equation: \n\n$$\ny=\\frac{54}{x}-\\frac{x}{2}\n$$\n\nThen, we substitute $y=\\frac{54}{x}-\\frac{x}{2}$ in the expression $V={x}^{2}y,$ and we get\n\n$$\n\\begin{aligned}V(x) & ={x}^{2}(\\frac{54}{x}-\\frac{x}{2}) \\\\  & =54x-\\frac{{x}^{3}}{2}.\\end{aligned}\n$$\n\n \n\n**Step 4**: We solve the equation ${V}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(x)=54-\\frac{3{x}^{2}}{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(x) & =0 \\\\ 54-\\frac{3{x}^{2}}{2} & =0 \\\\ {x}^{2} & =36 \\\\ x & =6.\\end{aligned}\n$$\n\nNote that in the last step we only considered the positive root because the side length $x$ must be positive. \n\n**Step 5**: We confirm that $x=6$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(x)=-3x\\,⟹\\,{V}^{″}(6)=-18<0.\n$$\n\nSince ${V}^{″}(6)$ is negative, we conclude that $x=6$ is indeed a maximum of $V(x).$\n\nTherefore, the box with the largest possible volume has side length $x=6$ units." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-af63dc13-ad18-585b-9f3f-932bce3c80b8"] :db/ensure [:question/validate]} {:db/id "answer-field-af63dc13-ad18-585b-9f3f-932bce3c80b8" :answer-field/id #uuid "af63dc13-ad18-585b-9f3f-932bce3c80b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-61917c9e-d8db-5a3f-a72d-206eb95c4b0d" :answer-field/choices ["answer-c3374e3f-172e-58dd-b094-862ba6252100" "answer-968347dd-9afb-5d48-84b6-9fc50d70394b" "answer-5a1e80b2-f250-5ef6-99c1-91f6419b33d5" "answer-61917c9e-d8db-5a3f-a72d-206eb95c4b0d" "answer-e29877a7-cf42-546e-901c-5f55c93b0628"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3374e3f-172e-58dd-b094-862ba6252100" :answer/id #uuid "c3374e3f-172e-58dd-b094-862ba6252100" :answer/type :answer.type/text :answer/value "$3$ units" :db/ensure [:answer/validate]} {:db/id "answer-968347dd-9afb-5d48-84b6-9fc50d70394b" :answer/id #uuid "968347dd-9afb-5d48-84b6-9fc50d70394b" :answer/type :answer.type/text :answer/value "$4$ units" :db/ensure [:answer/validate]} {:db/id "answer-5a1e80b2-f250-5ef6-99c1-91f6419b33d5" :answer/id #uuid "5a1e80b2-f250-5ef6-99c1-91f6419b33d5" :answer/type :answer.type/text :answer/value "$5$ units" :db/ensure [:answer/validate]} {:db/id "answer-61917c9e-d8db-5a3f-a72d-206eb95c4b0d" :answer/id #uuid "61917c9e-d8db-5a3f-a72d-206eb95c4b0d" :answer/type :answer.type/text :answer/value "$6$ units" :db/ensure [:answer/validate]} {:db/id "answer-e29877a7-cf42-546e-901c-5f55c93b0628" :answer/id #uuid "e29877a7-cf42-546e-901c-5f55c93b0628" :answer/type :answer.type/text :answer/value "$7$ units" :db/ensure [:answer/validate]} {:db/id "question-c4e37c29-e44f-56ff-9916-25bc220edbdb" :question/id #uuid "c4e37c29-e44f-56ff-9916-25bc220edbdb" :question/math-academy-id "q-345713" :question/problem "![](images/18/1859fcfa509ac8b8c93feed744df6fb66e87fc318811d75ad3cd154c6ab1bb96.png)\n\nConsider a box with a surface area of $196$ square units whose height $y$ is three halves its width $x.$ Find the value of $y$ that maximizes the volume of the box. Do not round the answer.\n\n$y=$\n{{field-1}} units" :question/worked-solution "**Step 1**: We need to find the value of $y$ such that the volume\n\n$$\nV=x\\cdot y\\cdot z\n$$\n\nis the greatest possible value.\n\nSince $y=\\frac{3}{2}x,$ we have $x=\\frac{2}{3}y,$ so\n\n$$\nV=(\\frac{2}{3}y)\\cdot y\\cdot z=\\frac{2}{3}{y}^{2}z.\n$$\n\n**Step 2**: The surface area is $196$ square units. So, we have\n\n$$\n\\begin{aligned}S & =2xy+2xz+2yz \\\\ 196 & =2xy+2xz+2yz.\\end{aligned}\n$$\n\nNow, using the fact that $x=\\frac{2}{3}y,$ we get the constraint equation\n\n$$\n\\begin{aligned}196 & =2(\\frac{2}{3}y)y+2(\\frac{2}{3}y)z+2yz \\\\ 196 & =\\frac{4}{3}{y}^{2}+\\frac{4}{3}yz+2yz \\\\ 196 & =\\frac{4}{3}{y}^{2}+\\frac{10}{3}yz.\\end{aligned}\n$$\n\n**Step 3**: We make one of the variables the subject in the constraint equation:\n\n$$\nz=\\frac{294}{5y}-\\frac{2}{5}y\n$$\n\nThen, we substitute the above into the expression $V=\\frac{2}{3}{y}^{2}z$, and we get\n\n$$\n\\begin{aligned}V(y) & =\\frac{2}{3}{y}^{2}(\\frac{294}{5y}-\\frac{2}{5}y) \\\\  & =\\frac{196}{5}y-\\frac{4}{15}{y}^{3}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{V}^{′}(y)=\\frac{196}{5}-\\frac{4}{5}{y}^{2},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ \\frac{196}{5}-\\frac{4}{5}{y}^{2} & =0 \\\\ 196-4{y}^{2} & =0 \\\\ {y}^{2} & =49 \\\\ y & =7.\\end{aligned}\n$$\n\nNote that in the last step, we only considered the positive root because the side length $y$ must be positive.\n\n**Step 5**: We confirm that $y=7$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=-\\frac{8}{5}y\\,⟹\\,{V}^{″}(7)=-\\frac{56}{5}<0,\n$$\n\nSince ${V}^{″}(7)$ is negative, we conclude that $y=7$ is indeed a maximum of $V(y).$\n\nTherefore, the box with the largest possible volume has height $y=7$ units." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-841e7323-7f64-53a7-aa26-e95f6869d185"] :db/ensure [:question/validate]} {:db/id "answer-field-841e7323-7f64-53a7-aa26-e95f6869d185" :answer-field/id #uuid "841e7323-7f64-53a7-aa26-e95f6869d185" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-41208bc8-7dc8-5f8b-831f-821f27086162" :answer-field/choices ["answer-41208bc8-7dc8-5f8b-831f-821f27086162"] :db/ensure [:answer-field/validate]} {:db/id "answer-41208bc8-7dc8-5f8b-831f-821f27086162" :answer/id #uuid "41208bc8-7dc8-5f8b-831f-821f27086162" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-90ab0435-552f-51ca-b675-8d58a2c58837" :question/id #uuid "90ab0435-552f-51ca-b675-8d58a2c58837" :question/math-academy-id "q-346764" :question/problem "![](images/1e/1e039fda5af235c4a9948853295846eaadb064fede888b84fdb5be552a35e3f1.png)\n\nConsider a box with width $x,$ height $y,$ and depth $z,$ as shown above. The depth of the box is one-third its width. Given that the box's volume is $288$ cubic units, what is the smallest possible surface area ${S}_{\\text{min}}$ of the box? Do not round the answer.\n\n${S}_{\\text{min}}=$\n{{field-1}} square units" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the surface area\n\n$$\nS=2xz+2xy+2yz\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume is $288$ cubic units. So, we have \n\n$$\n\\begin{aligned}V & =x\\cdot y\\cdot z \\\\ 288 & =xyz.\\end{aligned}\n$$\n\nNow, using the fact that $z=\\frac{x}{3},$ we get the constraint equation\n\n$$\n288=xy(\\frac{x}{3})=\\frac{{x}^{2}y}{3}.\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}y}{3} & =288 \\\\ {x}^{2}y & =864 \\\\ y & =\\frac{864}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $S,$ and get\n\n$$\n\\begin{aligned}S & =2xz+2xy+2yz \\\\  & =2x(\\frac{x}{3})+2x(\\frac{864}{{x}^{2}})+2(\\frac{864}{{x}^{2}})(\\frac{x}{3}) \\\\  & =\\frac{2}{3}{x}^{2}+\\frac{1728}{x}+\\frac{576}{x} \\\\  & =\\frac{2}{3}{x}^{2}+\\frac{2304}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${S}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{S}^{′}(x)=\\frac{4}{3}x-\\frac{2304}{{x}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{S}^{′}(x) & =0 \\\\ \\frac{4}{3}x-\\frac{2304}{{x}^{2}} & =0 \\\\ \\frac{4}{3}x & =\\frac{2304}{{x}^{2}} \\\\ \\frac{4}{3}{x}^{3} & =2304 \\\\ {x}^{3} & =1728 \\\\ x & =12.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=12$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{S}^{″}(x)=\\frac{4}{3}+\\frac{4608}{{x}^{3}}\\,⟹\\,{S}^{″}(12)=\\frac{4}{3}+\\frac{8}{3}=4>0.\n$$\n\nSince ${S}^{″}(12)$ is positive, we conclude that $x=12$ is indeed a minimum.\n\nNow, the smallest surface area ${S}_{\\text{min}}$ that the box can have is\n\n$$\n\\begin{aligned}{S}_{\\text{min}}=S(12) & =\\frac{2}{3}(12)^{2}+\\frac{2304}{12} \\\\  & =96+192 \\\\  & =288\\,\\text{square units}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8e01c9b5-042f-5087-a1d7-da3ece6e125a"] :db/ensure [:question/validate]} {:db/id "answer-field-8e01c9b5-042f-5087-a1d7-da3ece6e125a" :answer-field/id #uuid "8e01c9b5-042f-5087-a1d7-da3ece6e125a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a2ef43e3-fa57-5e96-87ba-acda532bcaf9" :answer-field/choices ["answer-a2ef43e3-fa57-5e96-87ba-acda532bcaf9"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2ef43e3-fa57-5e96-87ba-acda532bcaf9" :answer/id #uuid "a2ef43e3-fa57-5e96-87ba-acda532bcaf9" :answer/type :answer.type/math :answer/value "288" :db/ensure [:answer/validate]} {:db/id "question-97252151-ba80-5f2a-b51f-786d26797ca5" :question/id #uuid "97252151-ba80-5f2a-b51f-786d26797ca5" :question/math-academy-id "q-117209" :question/problem "![](images/d7/d77c003f88d428578c7f249feb4d0d086c8151c1ef21348d806a0baba751000d.png)\n\nConsider a box with width $x,$ height $y,$ and depth $z,$ as shown above. The width of the box is four times its height. Given that the box's volume is $800$ cubic units, what is the smallest possible surface area of the box?" :question/worked-solution "**Step 1**: We need to find the value of $y$ such that the surface area\n\n$$\n\\begin{aligned}S & =2xz+2xy+2yz\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume is exactly $800$ cubic units. So, we have \n\n$$\n\\begin{aligned}V & =x\\cdot y\\cdot z \\\\ 800 & =xyz\\end{aligned}\n$$\n\nNow, using the fact that $x=4y,$ we get the constraint equation\n\n$$\n800=4z{y}^{2}.\n$$\n\n**Step 3**: We make $z$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}4z{y}^{2} & =800 \\\\ z & =\\frac{200}{{y}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $S,$ and get\n\n$$\n\\begin{aligned}S & =2xz+2xy+2yz \\\\  & =2(4y)(\\frac{200}{{y}^{2}})+2(4y)y+2y(\\frac{200}{{y}^{2}}) \\\\  & =\\frac{1\\,600}{y}+8{y}^{2}+\\frac{400}{y} \\\\  & =8{y}^{2}+\\frac{2\\,000}{y}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${S}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{S}^{′}(y)=16y-\\frac{2\\,000}{{y}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{S}^{′}(y) & =0 \\\\ 16y-\\frac{2\\,000}{{y}^{2}} & =0 \\\\ 16{y}^{3}-2\\,000 & =0 \\\\ 16{y}^{3} & =2\\,000 \\\\ {y}^{3} & =125 \\\\ y & =5\\end{aligned}\n$$\n\n**Step 5**: We confirm that $y=5$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{S}^{″}(y)=16+\\frac{4\\,000}{{y}^{3}}\\,⟹\\,{S}^{″}(5)=16+32=48>0.\n$$\n\nSince ${S}^{″}(5)$ is positive, we conclude that $y=5$ is indeed a minimum.\n\nNow, the smallest surface area that the box can have is\n\n$$\n\\begin{aligned}S(5) & =8(5)^{2}+\\frac{2\\,000}{5}=600.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bd09338f-1eac-5ac9-a363-c02375d91036"] :db/ensure [:question/validate]} {:db/id "answer-field-bd09338f-1eac-5ac9-a363-c02375d91036" :answer-field/id #uuid "bd09338f-1eac-5ac9-a363-c02375d91036" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6034439d-a48b-58b5-9b55-6d0abcc38a01" :answer-field/choices ["answer-2573315e-ce38-5e15-95e7-e11143891fae" "answer-2a1eb4e2-b09b-5531-8ce3-4cb94ffd09ed" "answer-44905299-0cd4-574c-b947-6089c607bb4e" "answer-75398515-7084-5c1a-8210-e2c60d6cf6e0" "answer-6034439d-a48b-58b5-9b55-6d0abcc38a01"] :db/ensure [:answer-field/validate]} {:db/id "answer-2573315e-ce38-5e15-95e7-e11143891fae" :answer/id #uuid "2573315e-ce38-5e15-95e7-e11143891fae" :answer/type :answer.type/text :answer/value "$125$ square units" :db/ensure [:answer/validate]} {:db/id "answer-2a1eb4e2-b09b-5531-8ce3-4cb94ffd09ed" :answer/id #uuid "2a1eb4e2-b09b-5531-8ce3-4cb94ffd09ed" :answer/type :answer.type/text :answer/value "$1\\,200$ square units" :db/ensure [:answer/validate]} {:db/id "answer-44905299-0cd4-574c-b947-6089c607bb4e" :answer/id #uuid "44905299-0cd4-574c-b947-6089c607bb4e" :answer/type :answer.type/text :answer/value "$300$ square units" :db/ensure [:answer/validate]} {:db/id "answer-75398515-7084-5c1a-8210-e2c60d6cf6e0" :answer/id #uuid "75398515-7084-5c1a-8210-e2c60d6cf6e0" :answer/type :answer.type/text :answer/value "$480$ square units" :db/ensure [:answer/validate]} {:db/id "answer-6034439d-a48b-58b5-9b55-6d0abcc38a01" :answer/id #uuid "6034439d-a48b-58b5-9b55-6d0abcc38a01" :answer/type :answer.type/text :answer/value "$600$ square units" :db/ensure [:answer/validate]} {:db/id "question-64a50494-969c-52da-a2bf-9af25982f51d" :question/id #uuid "64a50494-969c-52da-a2bf-9af25982f51d" :question/math-academy-id "q-346825" :question/problem "![](images/c6/c652b4ce5aa631211824e1f05160bf870c29d3c4d54ea54c29c627aaf7754eea.png)\n\nConsider a box with width $x,$ height $y,$ and depth $z,$ as shown above. The depth of the box is four times its height. Given that the box's volume is $800$ cubic units, what is the smallest possible surface area ${S}_{\\text{min}}$ of the box? Do not round the answer.\n\n${S}_{\\text{min}}=$\n{{field-1}} square units" :question/worked-solution "**Step 1**: We need to find the value of $y$ such that the surface area\n\n$$\nS=2xz+2xy+2yz\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume is $800$ cubic units. So, we have \n\n$$\n\\begin{aligned}V & =x\\cdot y\\cdot z \\\\ 800 & =xyz.\\end{aligned}\n$$\n\nNow, using the fact that $z=4y,$ we get the constraint equation\n\n$$\n800=4x{y}^{2}.\n$$\n\n**Step 3**: We make $x$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}4x{y}^{2} & =800 \\\\ x & =\\frac{200}{{y}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $S,$ and get\n\n$$\n\\begin{aligned}S & =2xz+2xy+2yz \\\\  & =2x(4y)+2xy+2y(4y) \\\\  & =8xy+2xy+8{y}^{2} \\\\  & =10xy+8{y}^{2} \\\\  & =10(\\frac{200}{{y}^{2}})y+8{y}^{2} \\\\  & =\\frac{2000}{y}+8{y}^{2}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${S}^{′}(y)=0.$ Taking the derivative, we have\n\n$$\n{S}^{′}(y)=16y-\\frac{2000}{{y}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{S}^{′}(y) & =0 \\\\ 16y-\\frac{2000}{{y}^{2}} & =0 \\\\ 16{y}^{3} & =2000 \\\\ {y}^{3} & =125 \\\\ y & =5.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $y=5$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{S}^{″}(y)=16+\\frac{4000}{{y}^{3}}\\,⟹\\,{S}^{″}(5)=16+32=48>0.\n$$\n\nSince ${S}^{″}(5)$ is positive, we conclude that $y=5$ is indeed a minimum.\n\nNow, the smallest surface area ${S}_{\\text{min}}$ that the box can have is\n\n$$\n\\begin{aligned}{S}_{\\text{min}}=S(5) & =8(5)^{2}+\\frac{2000}{5} \\\\  & =600\\,\\text{square units}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cd5596fc-df37-5148-b08d-7e5e925c165e"] :db/ensure [:question/validate]} {:db/id "answer-field-cd5596fc-df37-5148-b08d-7e5e925c165e" :answer-field/id #uuid "cd5596fc-df37-5148-b08d-7e5e925c165e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-45e4e7cf-9f38-5d15-8955-648658aadaf8" :answer-field/choices ["answer-45e4e7cf-9f38-5d15-8955-648658aadaf8"] :db/ensure [:answer-field/validate]} {:db/id "answer-45e4e7cf-9f38-5d15-8955-648658aadaf8" :answer/id #uuid "45e4e7cf-9f38-5d15-8955-648658aadaf8" :answer/type :answer.type/math :answer/value "600" :db/ensure [:answer/validate]} {:db/id "question-445bb805-c2f6-5166-9dd9-5663cfa2ac32" :question/id #uuid "445bb805-c2f6-5166-9dd9-5663cfa2ac32" :question/math-academy-id "q-117067" :question/problem "![](images/bf/bf3beb1908abd2d626d4b49efb010f3ac5d7cb82fec7e22abd13fbc457c7202d.png)\n\nConsider a box with a square base with side lengths $x$ and height $y,$ as shown above. The volume of the box is $729$ cubic units. Given that the surface area of the box has been minimized, find the value of $x.$" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the surface area\n\n$$\nS=2{x}^{2}+4xy\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume is exactly $729$ cubic units. So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot x\\cdot y \\\\ 729 & ={x}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}{x}^{2}y & =729 \\\\ y & =\\frac{729}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $S,$ and we get\n\n$$\n\\begin{aligned}S & =2{x}^{2}+4xy \\\\  & =2{x}^{2}+4x\\cdot \\frac{729}{{x}^{2}} \\\\  & =2{x}^{2}+\\frac{2\\,916}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${S}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{S}^{′}(x)=4x-\\frac{2\\,916}{{x}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{S}^{′}(x) & =0 \\\\ 4x-\\frac{2\\,916}{{x}^{2}} & =0 \\\\ 4x & =\\frac{2\\,916}{{x}^{2}} \\\\ 4{x}^{3} & =2\\,916 \\\\ {x}^{3} & =729 \\\\ x & =9.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=9$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{S}^{″}(x)=4+\\frac{5\\,832}{{x}^{3}}\\,⟹\\,{S}^{″}(9)=4+8=12>0.\n$$\n\nSince ${S}^{″}(9)$ is positive, we conclude that $x=9$ is indeed a minimum of $S(x).$\n\nTherefore, the box with the smallest possible surface area has side length $x=9$ units." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3ffc3bc9-b67e-553a-8876-32a82d53bb92"] :db/ensure [:question/validate]} {:db/id "answer-field-3ffc3bc9-b67e-553a-8876-32a82d53bb92" :answer-field/id #uuid "3ffc3bc9-b67e-553a-8876-32a82d53bb92" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a81c7081-d409-50fc-a5d5-0affee1b286d" :answer-field/choices ["answer-1cef5b7b-b072-57d5-b226-3e45c14777e9" "answer-9ce634b2-8e9c-5c35-a0a8-0bf72ec280a1" "answer-cac5d717-4eb0-5b8e-ae4f-c092a41af513" "answer-f4860dfb-22d8-5b0a-b06b-9249cc015ccc" "answer-a81c7081-d409-50fc-a5d5-0affee1b286d"] :db/ensure [:answer-field/validate]} {:db/id "answer-1cef5b7b-b072-57d5-b226-3e45c14777e9" :answer/id #uuid "1cef5b7b-b072-57d5-b226-3e45c14777e9" :answer/type :answer.type/text :answer/value "$18$ units" :db/ensure [:answer/validate]} {:db/id "answer-9ce634b2-8e9c-5c35-a0a8-0bf72ec280a1" :answer/id #uuid "9ce634b2-8e9c-5c35-a0a8-0bf72ec280a1" :answer/type :answer.type/text :answer/value "$3$ units" :db/ensure [:answer/validate]} {:db/id "answer-cac5d717-4eb0-5b8e-ae4f-c092a41af513" :answer/id #uuid "cac5d717-4eb0-5b8e-ae4f-c092a41af513" :answer/type :answer.type/text :answer/value "$4$ units" :db/ensure [:answer/validate]} {:db/id "answer-f4860dfb-22d8-5b0a-b06b-9249cc015ccc" :answer/id #uuid "f4860dfb-22d8-5b0a-b06b-9249cc015ccc" :answer/type :answer.type/text :answer/value "$8$ units" :db/ensure [:answer/validate]} {:db/id "answer-a81c7081-d409-50fc-a5d5-0affee1b286d" :answer/id #uuid "a81c7081-d409-50fc-a5d5-0affee1b286d" :answer/type :answer.type/text :answer/value "$9$ units" :db/ensure [:answer/validate]} {:db/id "question-e2adf7b9-c049-5411-a710-9c822b654299" :question/id #uuid "e2adf7b9-c049-5411-a710-9c822b654299" :question/math-academy-id "q-346760" :question/problem "![](images/6f/6f753b0f958204f705f0d59610210ae20e8f3096f0a9847bf72e2d3ab43a6305.png)\n\nConsider a box with width $x,$ height $y,$ and depth $z,$ as shown above. The depth of the box is half its width. Given that the box's volume is $243$ cubic units, what is the smallest possible surface area ${S}_{\\text{min}}$ of the box? Do not round the answer.\n\n${S}_{\\text{min}}=$\n{{field-1}} square units" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the surface area\n\n$$\nS=2xz+2xy+2yz\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume is $243$ cubic units. So, we have \n\n$$\n\\begin{aligned}V & =x\\cdot y\\cdot z \\\\ 243 & =xyz.\\end{aligned}\n$$\n\nNow, using the fact that $z=\\frac{x}{2},$ we get the constraint equation\n\n$$\n243=xy(\\frac{x}{2})=\\frac{{x}^{2}y}{2}.\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}y}{2} & =243 \\\\ {x}^{2}y & =486 \\\\ y & =\\frac{486}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $S,$ and get\n\n$$\n\\begin{aligned}S & =2xz+2xy+2yz \\\\  & =2x(\\frac{x}{2})+2x(\\frac{486}{{x}^{2}})+2(\\frac{486}{{x}^{2}})(\\frac{x}{2}) \\\\  & ={x}^{2}+\\frac{972}{x}+\\frac{486}{x} \\\\  & ={x}^{2}+\\frac{1458}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${S}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{S}^{′}(x)=2x-\\frac{1458}{{x}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{S}^{′}(x) & =0 \\\\ 2x-\\frac{1458}{{x}^{2}} & =0 \\\\ 2x & =\\frac{1458}{{x}^{2}} \\\\ 2{x}^{3} & =1458 \\\\ {x}^{3} & =729 \\\\ x & =9.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=9$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{S}^{″}(x)=2+\\frac{2916}{{x}^{3}}\\,⟹\\,{S}^{″}(9)=2+4=6>0.\n$$\n\nSince ${S}^{″}(9)$ is positive, we conclude that $x=9$ is indeed a minimum.\n\nNow, the smallest surface area ${S}_{\\text{min}}$ that the box can have is\n\n$$\n\\begin{aligned}{S}_{\\text{min}}=S(9) & ={9}^{2}+\\frac{1458}{9} \\\\  & =243\\,\\text{square units}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eae4d3f6-b44e-59db-a081-02bc4a4fa2c9"] :db/ensure [:question/validate]} {:db/id "answer-field-eae4d3f6-b44e-59db-a081-02bc4a4fa2c9" :answer-field/id #uuid "eae4d3f6-b44e-59db-a081-02bc4a4fa2c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f7c8741a-939b-59a0-976b-bf72431b48ea" :answer-field/choices ["answer-f7c8741a-939b-59a0-976b-bf72431b48ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7c8741a-939b-59a0-976b-bf72431b48ea" :answer/id #uuid "f7c8741a-939b-59a0-976b-bf72431b48ea" :answer/type :answer.type/math :answer/value "243" :db/ensure [:answer/validate]} {:db/id "question-5f708375-cdc1-53f8-8bb4-b17c1643502c" :question/id #uuid "5f708375-cdc1-53f8-8bb4-b17c1643502c" :question/math-academy-id "q-315628" :question/problem "![](images/85/8548c87f15edc7e7c903c753767f12bd6f4c6f0294ff07734659583907f2ea4a.png)\n\nA box whose width $x$ is $2$ times its depth $z$ has a manufacturing cost that depends on two materials. The material for the top and bottom costs $$5$ per square foot, and the material for the lateral faces costs $$2$ per square foot. The box must have a volume of $180\\,{ft}^{3}.$\n\nWhat is the value of $z$ for the box that has the smallest production cost? Do not round the answer.\n\n$z=$\n{{field-1}} units" :question/worked-solution "**Step 1**: We need to find the value of $z$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =5\\cdot 2xz+2\\cdot 2xy+2\\cdot 2yz \\\\  & =10xz+4xy+4yz\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $180\\,{ft}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot z\\cdot y \\\\ 180 & =2{z}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}2{z}^{2}y & =180 \\\\ y & =\\frac{90}{{z}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =10xz+4xy+4yz \\\\  & =10(2z)z+4(2z)(\\frac{90}{{z}^{2}})+4\\,(\\frac{90}{{z}^{2}})\\,z \\\\  & =20{z}^{2}+\\frac{720}{z}+\\frac{360}{z} \\\\  & =20{z}^{2}+\\frac{1080}{z}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(z)=40z-\\frac{1080}{{z}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(z) & =0 \\\\ 40z-\\frac{1080}{{z}^{2}} & =0 \\\\ 40{z}^{3} & =1080 \\\\ {z}^{3} & =27 \\\\ z & =3.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $z=3$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(z)=40+\\frac{2160}{{z}^{3}}\\,⟹\\,{C}^{″}(3)=40+80=120>0.\n$$\n\nSince ${C}^{″}(3)$ is positive, we conclude that $z=3$ is indeed a minimum of $C(z).$\n\nTherefore, the production cost is the smallest when $z=3$ units." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-53a722bb-d1a0-58ce-8c66-814e286c6be3"] :db/ensure [:question/validate]} {:db/id "answer-field-53a722bb-d1a0-58ce-8c66-814e286c6be3" :answer-field/id #uuid "53a722bb-d1a0-58ce-8c66-814e286c6be3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b5a0bdd6-6cc8-57e4-9c9b-50dfb154eeb3" :answer-field/choices ["answer-b5a0bdd6-6cc8-57e4-9c9b-50dfb154eeb3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5a0bdd6-6cc8-57e4-9c9b-50dfb154eeb3" :answer/id #uuid "b5a0bdd6-6cc8-57e4-9c9b-50dfb154eeb3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-d9422237-5095-57b7-8cd1-109d7184ed3e" :question/id #uuid "d9422237-5095-57b7-8cd1-109d7184ed3e" :question/math-academy-id "q-3478" :question/problem "![](images/31/31df5fe79f2aa8715321b6500474683a01732788e5fafc3300dfffc83c266893.png)\n\nA box whose width $x$ is $3$ times its depth $z$ has a manufacturing cost that depends on two materials. The material for the top and bottom costs $$5$ per square foot, and the material for the lateral faces costs $$2$ per square foot. The box must have a volume of $50\\,{ft}^{3}.$\n\nWhat is the value of $z$ for the box that has the smallest production cost?" :question/worked-solution "**Step 1**: We need to find the value of $z$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =5\\cdot 2xz+2\\cdot 2xy+2\\cdot 2yz \\\\  & =10xz+4xy+4yz\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $50\\,{ft}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot z\\cdot y \\\\ 50 & =3{z}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}3{z}^{2}y & =50 \\\\ y & =\\frac{50}{3{z}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =10xz+4xy+4yz \\\\ C & =10(3z)z+4(3z)(\\frac{50}{3{z}^{2}})+4(\\frac{50}{3{z}^{2}})z \\\\ C & =30{z}^{2}+\\frac{200}{z}+\\frac{200}{3z} \\\\ C & =30{z}^{2}+\\frac{800}{3z}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(z)=60z-\\frac{800}{3{z}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(z) & =0 \\\\ 60z-\\frac{800}{3{z}^{2}} & =0 \\\\ 180{z}^{3} & =800 \\\\ {z}^{3} & =\\frac{800}{180} \\\\ z & =\\sqrt[3]{\\frac{40}{9}}.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $z=\\sqrt[3]{\\frac{40}{9}}$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(z)=60+\\frac{1\\,600}{{z}^{3}}\\,⟹\\,{C}^{″}(\\sqrt[3]{\\frac{40}{9}})>0.\n$$\n\nSince ${C}^{″}(\\sqrt[3]{\\frac{40}{9}})$ is positive, we conclude that $z=\\sqrt[3]{\\frac{40}{9}}$ is indeed a minimum of $C(z).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-16e36503-d61e-578e-a1eb-685a25da07ba"] :db/ensure [:question/validate]} {:db/id "answer-field-16e36503-d61e-578e-a1eb-685a25da07ba" :answer-field/id #uuid "16e36503-d61e-578e-a1eb-685a25da07ba" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aa618909-09fa-50e1-9cee-475c9b27fe6b" :answer-field/choices ["answer-a90c4b99-8675-5177-b0b8-164a692c771e" "answer-aa618909-09fa-50e1-9cee-475c9b27fe6b" "answer-d1fbaa07-68f0-58af-a21d-b167d65507c3" "answer-18d43fd9-ce54-5930-a946-911c379fee1a" "answer-640087a7-09a2-5c75-8887-63269d193583"] :db/ensure [:answer-field/validate]} {:db/id "answer-a90c4b99-8675-5177-b0b8-164a692c771e" :answer/id #uuid "a90c4b99-8675-5177-b0b8-164a692c771e" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{16}{9}}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-aa618909-09fa-50e1-9cee-475c9b27fe6b" :answer/id #uuid "aa618909-09fa-50e1-9cee-475c9b27fe6b" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{40}{9}}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-d1fbaa07-68f0-58af-a21d-b167d65507c3" :answer/id #uuid "d1fbaa07-68f0-58af-a21d-b167d65507c3" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{4}{9}}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-18d43fd9-ce54-5930-a946-911c379fee1a" :answer/id #uuid "18d43fd9-ce54-5930-a946-911c379fee1a" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{80}{6}}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-640087a7-09a2-5c75-8887-63269d193583" :answer/id #uuid "640087a7-09a2-5c75-8887-63269d193583" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{8}{6}}\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "question-caab3419-40f4-5f42-9fc6-7d0c53c70e6a" :question/id #uuid "caab3419-40f4-5f42-9fc6-7d0c53c70e6a" :question/math-academy-id "q-315627" :question/problem "![](images/a9/a9de332f316c91f9739208d11828f6a0f7d035589dc4f3adc921e5108453cc12.png)\n\nA box with no lid and a square base has a manufacturing cost that depends on two materials. The material for the base costs $$5$ per square meter, and the material for the lateral faces costs $$2$ per square meter. The box must have a volume of $10\\,{m}^{3}.$\n\nWhat is the value of $x$ for the box that has the smallest production cost? Do not round the answer.\n\n$x=$\n{{field-1}} units" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =5{x}^{2}+2\\cdot 4xy \\\\  & =5{x}^{2}+8xy\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $10\\,{m}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot x\\cdot y \\\\ 10 & ={x}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}{x}^{2}y & =10 \\\\ y & =\\frac{10}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =5{x}^{2}+8xy \\\\  & =5{x}^{2}+8x\\cdot \\frac{10}{{x}^{2}} \\\\  & =5{x}^{2}+\\frac{80}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(x)=10x-\\frac{80}{{x}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(x) & =0 \\\\ 10x-\\frac{80}{{x}^{2}} & =0 \\\\ 10{x}^{3} & =80 \\\\ {x}^{3} & =8 \\\\ x & =2.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=2$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(x)=10+\\frac{160}{{x}^{3}}\\,⟹\\,{C}^{″}(2)=10+20=30>0.\n$$\n\nSince ${C}^{″}(2)$ is positive, we conclude that $x=2$ is indeed a minimum of $C(x).$\n\nTherefore, the production cost is the smallest when $x=2$ units." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d8ff7838-e070-56e4-b546-4f88fee98842"] :db/ensure [:question/validate]} {:db/id "answer-field-d8ff7838-e070-56e4-b546-4f88fee98842" :answer-field/id #uuid "d8ff7838-e070-56e4-b546-4f88fee98842" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cb8296ad-44f4-5c3a-8ae1-cca1ab925305" :answer-field/choices ["answer-cb8296ad-44f4-5c3a-8ae1-cca1ab925305"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb8296ad-44f4-5c3a-8ae1-cca1ab925305" :answer/id #uuid "cb8296ad-44f4-5c3a-8ae1-cca1ab925305" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-180b48d4-1e2c-527c-b442-f02b5ba67824" :question/id #uuid "180b48d4-1e2c-527c-b442-f02b5ba67824" :question/math-academy-id "q-347235" :question/problem "![](images/ab/ab0416aeff61e4916acc1765a7931da0a41a64ba9d0ac4c05a322de6a1ed431b.png)\n\nA box whose depth $z$ is equal to half of its height $y$ has a manufacturing cost that depends on two materials. The material for the top and bottom costs $$4$ per square meter, and the material for the lateral faces costs $$1$ per square meter. The box must have a volume of $36\\,{m}^{3}.$\n\nWhat is the value of $z$ for the box that has the smallest production cost? Do not round the answer.\n\n$z=$\n{{field-1}} units" :question/worked-solution "**Step 1**: We need to find the value of $z$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =4\\cdot 2xz+1\\cdot 2xy+1\\cdot 2yz \\\\  & =8xz+2xy+2yz\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $36\\,{m}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot z\\cdot y \\\\ 36 & =xz(2z) \\\\ 36 & =2x{z}^{2}.\\end{aligned}\n$$\n\n**Step 3**: We make $x$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}2x{z}^{2} & =36 \\\\ x & =\\frac{18}{{z}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =8xz+2xy+2yz \\\\  & =8\\,(\\frac{18}{{z}^{2}})\\,z+2\\,(\\frac{18}{{z}^{2}})\\,(2z)+2(2z)z \\\\  & =\\frac{144}{z}+\\frac{72}{z}+4{z}^{2} \\\\  & =4{z}^{2}+\\frac{216}{z}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(z)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(z)=8z-\\frac{216}{{z}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(z) & =0 \\\\ 8z-\\frac{216}{{z}^{2}} & =0 \\\\ 8{z}^{3} & =216 \\\\ {z}^{3} & =27 \\\\ z & =3.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $z=3$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(z)=8+\\frac{432}{{z}^{3}}\\,⟹\\,{C}^{″}(3)=8+16=24>0.\n$$\n\nSince ${C}^{″}(3)$ is positive, we conclude that $z=3$ is indeed a minimum of $C(z).$\n\nTherefore, the production cost is the smallest when $z=3$ units." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ac8dc0c5-5a97-55c6-b567-1d5f02ebaee4"] :db/ensure [:question/validate]} {:db/id "answer-field-ac8dc0c5-5a97-55c6-b567-1d5f02ebaee4" :answer-field/id #uuid "ac8dc0c5-5a97-55c6-b567-1d5f02ebaee4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ccade439-4e5d-58b2-8228-d6bfc35a07d3" :answer-field/choices ["answer-ccade439-4e5d-58b2-8228-d6bfc35a07d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-ccade439-4e5d-58b2-8228-d6bfc35a07d3" :answer/id #uuid "ccade439-4e5d-58b2-8228-d6bfc35a07d3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186101542 :question/problem "![](images/a6/a6f83d3c86e6d5c2e470f68e2e75f32c2fb7573a08cc188d2fd7080103351076.png)\n\nA box with no lid and a square base has a manufacturing cost that depends on two materials. The material for the base costs $$3$ per square meter, and the material for the lateral faces costs $$2$ per square meter. The box must have a volume of $6\\,{m}^{3}.$\n\nWhat is the value of $x$ for the box that has the smallest production cost?" :question/worked-solution "**Step 1**: We need to find the value of $x$ such that the manufacturing cost\n\n$$\n\\begin{aligned}C & =3{x}^{2}+2\\cdot 4xy \\\\  & =3{x}^{2}+8xy\\end{aligned}\n$$\n\nis the smallest possible value.\n\n**Step 2**: The volume must be $6\\,{m}^{3}.$ So, we have the constraint equation\n\n$$\n\\begin{aligned}V & =x\\cdot x\\cdot y \\\\ 6 & ={x}^{2}y.\\end{aligned}\n$$\n\n**Step 3**: We make $y$ the subject of the constraint equation:\n\n$$\n\\begin{aligned}{x}^{2}y & =6 \\\\ y & =\\frac{6}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we substitute the above into our expression for $C,$ and get\n\n$$\n\\begin{aligned}C & =3{x}^{2}+8xy \\\\ C & =3{x}^{2}+8x\\cdot \\frac{6}{{x}^{2}} \\\\ C & =3{x}^{2}+\\frac{48}{x}.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${C}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{C}^{′}(x)=6x-\\frac{48}{{x}^{2}},\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{C}^{′}(x) & =0 \\\\ 6x-\\frac{48}{{x}^{2}} & =0 \\\\ 6{x}^{3} & =48 \\\\ {x}^{3} & =8 \\\\ x & =2.\\end{aligned}\n$$\n\n**Step 5**: We confirm that $x=2$ is a minimum using the second derivative test. The second derivative is\n\n$$\n{C}^{″}(x)=6+\\frac{96}{{x}^{3}}\\,⟹\\,{C}^{″}(2)>0.\n$$\n\nSince ${C}^{″}(2)$ is positive, we conclude that $x=2$ is indeed a minimum of $C(x).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186100413 :answer-field/correct "answer-8c4420d0-9b62-5853-8a99-67b9e82b1494" :answer-field/choices ["answer-8c4420d0-9b62-5853-8a99-67b9e82b1494" "answer-cf7e01cf-e36a-5ed1-9454-a4f35f123b2b" "answer-09226b22-fab1-50b0-a68c-e86048752975" "answer-687a4f32-8d24-5c9e-833e-310bc0bfadb2" "answer-3a981284-4556-5394-822e-11d7ee3bd54e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c4420d0-9b62-5853-8a99-67b9e82b1494" :answer/id #uuid "8c4420d0-9b62-5853-8a99-67b9e82b1494" :answer/type :answer.type/math :answer/value "2\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-cf7e01cf-e36a-5ed1-9454-a4f35f123b2b" :answer/id #uuid "cf7e01cf-e36a-5ed1-9454-a4f35f123b2b" :answer/type :answer.type/math :answer/value "3\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-09226b22-fab1-50b0-a68c-e86048752975" :answer/id #uuid "09226b22-fab1-50b0-a68c-e86048752975" :answer/type :answer.type/math :answer/value "4\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-687a4f32-8d24-5c9e-833e-310bc0bfadb2" :answer/id #uuid "687a4f32-8d24-5c9e-833e-310bc0bfadb2" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-3a981284-4556-5394-822e-11d7ee3bd54e" :answer/id #uuid "3a981284-4556-5394-822e-11d7ee3bd54e" :answer/type :answer.type/math :answer/value "\\frac{5}{2}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "question-d416390a-8b08-58ae-b4bd-805af1c30ba3" :question/id #uuid "d416390a-8b08-58ae-b4bd-805af1c30ba3" :question/math-academy-id "q-86451" :question/problem "![](images/cf/cf7c07babafa92e2c88e2e08727edc0d724b05f1318f6cf022d9f8b31ff668d7.png)\n\nA piece of cardboard measures $15\\,in\\times 8\\,in.$ A tray of height $y\\,\\text{in}$ is formed by cutting a $y\\times y\\,{\\text{in}}^{2}$ square from each of the corners and folding up the sides, as shown in the diagram. Determine the height of the box that gives the maximum possible volume." :question/worked-solution "**Step 1**: We need to find the values of $x,y,$ and $z$ such that the volume\n\n$$\nV=xyz\n$$\n\nis the greatest possible value.\n\n**Step 2**: Notice that the width $x$ and the depth $z$ of the tray are given by\n\n$$\nx=15-2y,\\,z=8-2y.\n$$\n\n \n\nSince $x>0$ and $z>0,$ we must have that $15-2y>0$ and $8-2y>0$, hence $y<4.$ Therefore, the range of validity for $y$ is $0<y<4.$\n\n**Step 3**: Substituting the above into the expression for $V,$ we get\n\n$$\n\\begin{aligned}V & =xyz \\\\  & =(15-2y)(y)(8-2y) \\\\  & =4{y}^{3}-46{y}^{2}+120y.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the first derivative, we have\n\n$$\n{V}^{′}(y)=12{y}^{2}-92y+120,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 12{y}^{2}-92y+120 & =0 \\\\ 3{y}^{2}-23y+30 & =0 \\\\ (3y-5)(y-6) & =0 \\\\ y & =\\frac{5}{3},\\,6.\\end{aligned}\n$$\n\nWe discard $6$ since we already know that $0<y<4.$\n\n**Step 5**: We confirm that $\\frac{5}{3}$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=24y-92.\n$$\n\nSince ${V}^{″}(\\frac{5}{3})$ is negative, we conclude that $\\frac{5}{3}$ is indeed a maximum of $V(y).$\n\nTherefore, the stationary point $y=\\frac{5}{3}$ gives the maximum possible volume." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6a47ad8f-644d-5ed1-821f-c9fc750297cf"] :db/ensure [:question/validate]} {:db/id "answer-field-6a47ad8f-644d-5ed1-821f-c9fc750297cf" :answer-field/id #uuid "6a47ad8f-644d-5ed1-821f-c9fc750297cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ec1e2fe-2b9d-576b-93e5-7123f52b7b55" :answer-field/choices ["answer-525d95f6-b301-501d-a8ef-8b62fe4587c0" "answer-cbd10116-e90b-519e-9bff-6dab94a09c84" "answer-2ec1e2fe-2b9d-576b-93e5-7123f52b7b55" "answer-23276101-7865-5bce-a378-809937535d11" "answer-ec0d608f-b2b9-5bdb-a629-b7cb6a133bd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-525d95f6-b301-501d-a8ef-8b62fe4587c0" :answer/id #uuid "525d95f6-b301-501d-a8ef-8b62fe4587c0" :answer/type :answer.type/math :answer/value "2\\,in" :db/ensure [:answer/validate]} {:db/id "answer-cbd10116-e90b-519e-9bff-6dab94a09c84" :answer/id #uuid "cbd10116-e90b-519e-9bff-6dab94a09c84" :answer/type :answer.type/math :answer/value "3\\,in" :db/ensure [:answer/validate]} {:db/id "answer-2ec1e2fe-2b9d-576b-93e5-7123f52b7b55" :answer/id #uuid "2ec1e2fe-2b9d-576b-93e5-7123f52b7b55" :answer/type :answer.type/math :answer/value "\\frac{5}{3}\\,in" :db/ensure [:answer/validate]} {:db/id "answer-23276101-7865-5bce-a378-809937535d11" :answer/id #uuid "23276101-7865-5bce-a378-809937535d11" :answer/type :answer.type/math :answer/value "\\frac{7}{3}\\,in" :db/ensure [:answer/validate]} {:db/id "answer-ec0d608f-b2b9-5bdb-a629-b7cb6a133bd9" :answer/id #uuid "ec0d608f-b2b9-5bdb-a629-b7cb6a133bd9" :answer/type :answer.type/math :answer/value "\\frac{8}{3}\\,in" :db/ensure [:answer/validate]} {:db/id "question-3a8692c9-b01b-529e-b66c-5ef584b340c0" :question/id #uuid "3a8692c9-b01b-529e-b66c-5ef584b340c0" :question/math-academy-id "q-347239" :question/problem "![](images/61/61e7943162b7df06af1d6ba805630268e872031e1cb27b566810ee7fc22e6bbc.png)\n\nA piece of cardboard measures $18\\,ft\\times 18\\,ft.$ A tray of height $y\\,\\text{ft}$ is formed by cutting a $y\\times y\\,{\\text{ft}}^{2}$ square from each of the corners and folding up the sides, as shown in the diagram. Determine the height $y$ of the box that gives the maximum possible volume.\n\n$y=$\n{{field-1}} $\\text{ft}$" :question/worked-solution "**Step 1**: We need to find the values of $x,y,$ and $z$ such that the volume\n\n$$\nV=xyz\n$$\n\nis the greatest possible value.\n\n**Step 2**: Notice that the width $x$ and the depth $z$ of the tray are given by\n\n$$\nx=18-2y,\\,z=18-2y.\n$$\n\n \n\nSince $x>0$ and $z>0,$ we must have that $18-2y>0$ and $18-2y>0$, hence $y<9.$ Therefore, the range of validity for $y$ is $0<y<9.$\n\n**Step 3**: Substituting the above into the expression for $V,$ we get\n\n$$\n\\begin{aligned}V & =xyz \\\\  & =(18-2y)(y)(18-2y) \\\\  & =4{y}^{3}-72{y}^{2}+324y.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the first derivative, we have\n\n$$\n{V}^{′}(y)=12{y}^{2}-144y+324,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 12{y}^{2}-144y+324 & =0 \\\\ {y}^{2}-12y+27 & =0 \\\\ y & =3,\\,9.\\end{aligned}\n$$\n\nWe discard $9$ since we already know that $0<y<9.$\n\n**Step 5**: We confirm that $3$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=24y-144.\n$$\n\nSince ${V}^{″}(3)$ is negative, we conclude that $3$ is indeed a maximum of $V(y).$\n\nTherefore, the height of the box with the maximum volume is $y=3\\text{ ft}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e8fd8fc6-4e2b-5b7a-b070-aeac64a96f45"] :db/ensure [:question/validate]} {:db/id "answer-field-e8fd8fc6-4e2b-5b7a-b070-aeac64a96f45" :answer-field/id #uuid "e8fd8fc6-4e2b-5b7a-b070-aeac64a96f45" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8aade02d-3d6a-5403-98d7-565fd490407e" :answer-field/choices ["answer-8aade02d-3d6a-5403-98d7-565fd490407e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8aade02d-3d6a-5403-98d7-565fd490407e" :answer/id #uuid "8aade02d-3d6a-5403-98d7-565fd490407e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-35d71232-f38b-500b-9a6f-4af0bdca3a38" :question/id #uuid "35d71232-f38b-500b-9a6f-4af0bdca3a38" :question/math-academy-id "q-18398" :question/problem "![](images/b0/b024db5e134e25212b44cef850118a6823148b01f782c67dccc42f12b82e3854.png)\n\nA piece of cardboard measures $8\\,cm\\times 6\\,cm.$ A tray of height $y\\,\\text{cm}$ is formed by cutting a $y\\times y\\,{\\text{cm}}^{2}$ square from each of the corners and folding up the sides, as shown in the diagram. Determine the height of the box that gives the maximum possible volume. Round your answer to two decimal places." :question/worked-solution "**Step 1**: We need to find the values of $x,y,$ and $z$ such that the volume\n\n$$\nV=xyz\n$$\n\nis the greatest possible value.\n\n**Step 2**: Notice that the width $x$ and the depth $z$ of the tray are given by\n\n$$\nx=8-2y,\\,z=6-2y.\n$$\n\n \n\nSince $x>0$ and $z>0,$ we must have that $8-2y>0$ and $6-2y>0$, hence $y<3.$ Therefore, the range of validity for $y$ is $0<y<3.$\n\n**Step 3**: Substituting the above into the expression for $V,$ we get\n\n$$\n\\begin{aligned}V & =xyz \\\\  & =(8-2y)(y)(6-2y) \\\\  & =4{y}^{3}-28{y}^{2}+48y.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the first derivative, we have\n\n$$\n{V}^{′}(y)=12{y}^{2}-56y+48,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 12{y}^{2}-56y+48 & =0 \\\\ 3{y}^{2}-14y+12 & =0 \\\\ y & =\\frac{7\\pm \\sqrt{13}}{3}.\\end{aligned}\n$$\n\nWe discard $\\frac{7+\\sqrt{13}}{3}$ since we already know that $0<y<3.$\n\n**Step 5**: We confirm that $\\frac{7-\\sqrt{13}}{3}$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=24y-56.\n$$\n\nSince ${V}^{″}(\\frac{7-\\sqrt{13}}{3})$ is negative, we conclude that $\\frac{7-\\sqrt{13}}{3}$ is indeed a maximum of $V(y).$\n\nTherefore, the stationary point $y=\\frac{7-\\sqrt{13}}{3}≈1.13$ gives the maximum possible volume." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0c84e7ef-df56-5495-af8d-6a63b68ee4c6"] :db/ensure [:question/validate]} {:db/id "answer-field-0c84e7ef-df56-5495-af8d-6a63b68ee4c6" :answer-field/id #uuid "0c84e7ef-df56-5495-af8d-6a63b68ee4c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7798b91c-2cf5-5d5c-8c9d-b4d9222d8914" :answer-field/choices ["answer-887b771c-1695-5de3-bfd7-ca8cef6a9293" "answer-7798b91c-2cf5-5d5c-8c9d-b4d9222d8914" "answer-00940964-97b0-5faa-b185-3728352533b9" "answer-0bb26296-d74b-52fe-95d8-c6f170dec861" "answer-ee27090a-6532-5bde-812c-260b6eef1e2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-887b771c-1695-5de3-bfd7-ca8cef6a9293" :answer/id #uuid "887b771c-1695-5de3-bfd7-ca8cef6a9293" :answer/type :answer.type/math :answer/value "0.85\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-7798b91c-2cf5-5d5c-8c9d-b4d9222d8914" :answer/id #uuid "7798b91c-2cf5-5d5c-8c9d-b4d9222d8914" :answer/type :answer.type/math :answer/value "1.13\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-00940964-97b0-5faa-b185-3728352533b9" :answer/id #uuid "00940964-97b0-5faa-b185-3728352533b9" :answer/type :answer.type/math :answer/value "1.76\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-0bb26296-d74b-52fe-95d8-c6f170dec861" :answer/id #uuid "0bb26296-d74b-52fe-95d8-c6f170dec861" :answer/type :answer.type/math :answer/value "2.42\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-ee27090a-6532-5bde-812c-260b6eef1e2c" :answer/id #uuid "ee27090a-6532-5bde-812c-260b6eef1e2c" :answer/type :answer.type/math :answer/value "2.73\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "question-fcc5cb30-3a54-5c1c-aecb-10ee16fa7222" :question/id #uuid "fcc5cb30-3a54-5c1c-aecb-10ee16fa7222" :question/math-academy-id "q-117300" :question/problem "![](images/dd/dd5731dcea0cc6bc8ffc0aad963f4b05b57a7422512a2df3df64666e63254f77.png)\n\nA piece of cardboard measures $10\\,in\\times 10\\,in.$ A tray of height $y\\,\\text{in}$ is formed by cutting a $y\\times y\\,{\\text{in}}^{2}$ square from each of the corners and folding up the sides, as shown in the diagram. Determine the height of the box that gives the maximum possible volume." :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such that the volume\n\n$$\nV={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: Notice that the side length $x$ of the tray is given by\n\n$$\nx=10-2y.\n$$\n\n \n\nSince $x>0,$ we must have that $10-2y>0$ hence $y<5.$ Therefore, the range of validity for $y$ is $0<y<5.$\n\n**Step 3**: Substituting the above into the expression for $V,$ we get\n\n$$\n\\begin{aligned}V & ={x}^{2}y \\\\  & =(10-2y)^{2}y \\\\  & =4{y}^{3}-40{y}^{2}+100y.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the first derivative, we have\n\n$$\n{V}^{′}(y)=12{y}^{2}-80y+100,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 12{y}^{2}-80y+100 & =0 \\\\ 3{y}^{2}-20y+25 & =0 \\\\ (3y-5)(y-5) & =0 \\\\ y & =\\frac{5}{3},\\,5.\\end{aligned}\n$$\n\nWe discard $5$ since we already know that $0<y<5.$\n\n**Step 5**: We confirm that $\\frac{5}{3}$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=24y-80.\n$$\n\nSince ${V}^{″}(\\frac{5}{3})=-40$ is negative, we conclude that $\\frac{5}{3}$ is indeed a maximum of $V(y).$\n\nTherefore, the stationary point $y=\\frac{5}{3}$ gives the maximum possible volume." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d64e9272-ea26-5829-b8f3-83104e2c4323"] :db/ensure [:question/validate]} {:db/id "answer-field-d64e9272-ea26-5829-b8f3-83104e2c4323" :answer-field/id #uuid "d64e9272-ea26-5829-b8f3-83104e2c4323" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c98ae24e-d838-52a1-a11a-fea3b0533b58" :answer-field/choices ["answer-042154b1-fd7b-5ea0-a9dd-903c37c5121d" "answer-6961a8a1-a684-5ee8-a675-a2847e5fc708" "answer-9b149e48-1ae1-5688-a860-750568060011" "answer-954a97db-91e2-5d6b-ab5d-4b9819568a15" "answer-c98ae24e-d838-52a1-a11a-fea3b0533b58"] :db/ensure [:answer-field/validate]} {:db/id "answer-042154b1-fd7b-5ea0-a9dd-903c37c5121d" :answer/id #uuid "042154b1-fd7b-5ea0-a9dd-903c37c5121d" :answer/type :answer.type/math :answer/value "2\\,in" :db/ensure [:answer/validate]} {:db/id "answer-6961a8a1-a684-5ee8-a675-a2847e5fc708" :answer/id #uuid "6961a8a1-a684-5ee8-a675-a2847e5fc708" :answer/type :answer.type/math :answer/value "5\\,in" :db/ensure [:answer/validate]} {:db/id "answer-9b149e48-1ae1-5688-a860-750568060011" :answer/id #uuid "9b149e48-1ae1-5688-a860-750568060011" :answer/type :answer.type/math :answer/value "\\frac{10}{3}\\,in" :db/ensure [:answer/validate]} {:db/id "answer-954a97db-91e2-5d6b-ab5d-4b9819568a15" :answer/id #uuid "954a97db-91e2-5d6b-ab5d-4b9819568a15" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\,in" :db/ensure [:answer/validate]} {:db/id "answer-c98ae24e-d838-52a1-a11a-fea3b0533b58" :answer/id #uuid "c98ae24e-d838-52a1-a11a-fea3b0533b58" :answer/type :answer.type/math :answer/value "\\frac{5}{3}\\,in" :db/ensure [:answer/validate]} {:db/id "question-9d40af61-e6e1-509f-9bd7-a155591f2abe" :question/id #uuid "9d40af61-e6e1-509f-9bd7-a155591f2abe" :question/math-academy-id "q-117241" :question/problem "![](images/8c/8cb99cea56d8a57b607589305bfe225610c63504239296e0b6eb81ba220feec8.png)\n\nA piece of cardboard measures $6\\,in\\times 6\\,in.$ A tray of height $y\\,\\text{in}$ is formed by cutting a $y\\times y\\,{\\text{in}}^{2}$ square from each of the corners and folding up the sides, as shown in the diagram. Determine the height of the box that gives the maximum possible volume." :question/worked-solution "**Step 1**: We need to find the values of $x$ and $y$ such that the volume\n\n$$\nV={x}^{2}y\n$$\n\nis the greatest possible value.\n\n**Step 2**: Notice that the side length $x$  of the tray is given by\n\n$$\nx=6-2y.\n$$\n\n \n\nSince $x>0,$ we must have that $6-2y>0$ hence $y<3.$ Therefore, the range of validity for $y$ is $0<y<3.$\n\n**Step 3**: Substituting the above into the expression for $V,$ we get\n\n$$\n\\begin{aligned}V & ={x}^{2}y \\\\  & =(6-2y)^{2}y \\\\  & =4{y}^{3}-24{y}^{2}+36y.\\end{aligned}\n$$\n\n**Step 4**: We solve the equation ${V}^{′}(y)=0.$ Taking the first derivative, we have\n\n$$\n{V}^{′}(y)=12{y}^{2}-48y+36,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{V}^{′}(y) & =0 \\\\ 12{y}^{2}-48y+36 & =0 \\\\ {y}^{2}-4y+3 & =0 \\\\ (y-3)(y-1) & =0 \\\\ y & =3,\\,1.\\end{aligned}\n$$\n\nWe discard $3$ since we already know that $0<y<3.$\n\n**Step 5**: We confirm that $1$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{V}^{″}(y)=24y-48.\n$$\n\nSince ${V}^{″}(1)=-24$ is negative, we conclude that $1$ is indeed a maximum of $V(y).$\n\nTherefore, the stationary point $y=1$ gives the maximum possible volume." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-35baf691-b4a2-51d8-96ed-a1fca9cb3892"] :db/ensure [:question/validate]} {:db/id "answer-field-35baf691-b4a2-51d8-96ed-a1fca9cb3892" :answer-field/id #uuid "35baf691-b4a2-51d8-96ed-a1fca9cb3892" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e2d0047-f71e-567a-9cbc-a87a09c1479e" :answer-field/choices ["answer-8e2d0047-f71e-567a-9cbc-a87a09c1479e" "answer-ef1eb9b3-b355-549d-a844-49cdeade472f" "answer-6906c0f1-d8ed-5f69-ba54-d57564c88902" "answer-cfd9f6c1-ced8-54ec-a16e-875898447c86" "answer-0e77def9-8497-50c1-95c3-1513b70a43d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e2d0047-f71e-567a-9cbc-a87a09c1479e" :answer/id #uuid "8e2d0047-f71e-567a-9cbc-a87a09c1479e" :answer/type :answer.type/math :answer/value "1\\,in" :db/ensure [:answer/validate]} {:db/id "answer-ef1eb9b3-b355-549d-a844-49cdeade472f" :answer/id #uuid "ef1eb9b3-b355-549d-a844-49cdeade472f" :answer/type :answer.type/math :answer/value "2\\,in" :db/ensure [:answer/validate]} {:db/id "answer-6906c0f1-d8ed-5f69-ba54-d57564c88902" :answer/id #uuid "6906c0f1-d8ed-5f69-ba54-d57564c88902" :answer/type :answer.type/math :answer/value "3\\,in" :db/ensure [:answer/validate]} {:db/id "answer-cfd9f6c1-ced8-54ec-a16e-875898447c86" :answer/id #uuid "cfd9f6c1-ced8-54ec-a16e-875898447c86" :answer/type :answer.type/math :answer/value "6\\,in" :db/ensure [:answer/validate]} {:db/id "answer-0e77def9-8497-50c1-95c3-1513b70a43d2" :answer/id #uuid "0e77def9-8497-50c1-95c3-1513b70a43d2" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\,in" :db/ensure [:answer/validate]} {:db/id 17592186102010 :tutorial/content "Let's remind ourselves of the general strategy for optimization problems:\n\n1\\. Draw a diagram of the situation, introducing variables where necessary.\n\n2\\. Write down the equation of the quantity that you're trying to maximize or minimize. This is called the **objective function**, and it might include more than one variable.\n\n3\\. Write down the constraint equation.\n\n4\\. Use the constraint equation to write the objective function in terms of a single variable only.\n\n5\\. Differentiate the objective function, set it equal to zero, and solve for the stationary points.\n\n6\\. Test each stationary point using the second derivative test. Or you can use the first derivative test if it's easier.\n\nWe can use differentiation to solve optimization problems involving boxes and trays, such as maximizing a box's volume given a fixed amount of material." :db/ensure [:tutorial/validate]} {:db/id 17592186101068 :activity/expected-seconds 1500.0 :db/ensure [:activity/validate]} {:db/id 17592186083232 :knowledge-point/questions ["question-87021664-1460-517e-b0da-ae45fc0bbb9e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-87021664-1460-517e-b0da-ae45fc0bbb9e" :question/id #uuid "87021664-1460-517e-b0da-ae45fc0bbb9e" :question/math-academy-id "q-83831" :question/problem "For the polynomial $f(x)=4{x}^{4}-12{x}^{2}+x+1,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $1,$ and its factors are $\\pm 1.$\n\n- The leading coefficient is $4,$ and its factors are $\\pm 1,$ $\\pm 2$ and $\\pm 4.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}.\\end{aligned}\n$$\n\nNotice that none of these potential roots are duplicates. Listing those potential roots in order from least to greatest in absolute value, we have\n\n$$\n\\begin{aligned}\\pm \\frac{1}{4}, & \\pm \\frac{1}{2}, & \\pm 1.\\end{aligned}\n$$\n\nThis makes a total of $6$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 3=6.$)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e68114ce-13fb-5bcc-bd0f-4d1c50824307"] :db/ensure [:question/validate]} {:db/id "answer-field-e68114ce-13fb-5bcc-bd0f-4d1c50824307" :answer-field/id #uuid "e68114ce-13fb-5bcc-bd0f-4d1c50824307" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-000d0b8b-482a-53a8-87ce-fe362b914282" :answer-field/choices ["answer-3334f6ee-ea48-5b27-93c8-f3725a806b83" "answer-50c09e5c-1c9d-53b7-9773-98ff2805aa40" "answer-67e31522-060a-5e95-9560-1ac9b15d8ba1" "answer-000d0b8b-482a-53a8-87ce-fe362b914282" "answer-e0e893b0-43f9-5fae-8bb4-0d4cfd2cce16"] :db/ensure [:answer-field/validate]} {:db/id "answer-3334f6ee-ea48-5b27-93c8-f3725a806b83" :answer/id #uuid "3334f6ee-ea48-5b27-93c8-f3725a806b83" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-50c09e5c-1c9d-53b7-9773-98ff2805aa40" :answer/id #uuid "50c09e5c-1c9d-53b7-9773-98ff2805aa40" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-67e31522-060a-5e95-9560-1ac9b15d8ba1" :answer/id #uuid "67e31522-060a-5e95-9560-1ac9b15d8ba1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-000d0b8b-482a-53a8-87ce-fe362b914282" :answer/id #uuid "000d0b8b-482a-53a8-87ce-fe362b914282" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-e0e893b0-43f9-5fae-8bb4-0d4cfd2cce16" :answer/id #uuid "e0e893b0-43f9-5fae-8bb4-0d4cfd2cce16" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "activity-ce408938-6ff2-5ee9-9af3-b3e6dc563bd5" :activity/id #uuid "ce408938-6ff2-5ee9-9af3-b3e6dc563bd5" :activity/title "The Rational Roots Theorem" :activity/type :activity.type/review :activity/scope 17592186050429 :activity/course 17592186046658 :activity/steps ["step-58d4a216-d386-5004-acc6-1259a07e1494" "step-5496c088-fa95-5052-8432-a8ee6731ca57" "step-98570077-079e-5420-bc17-984e3fb96b3b" "step-d86879e5-509b-538b-b3ff-c28fdb97936e" "step-c5006e3f-438a-526e-aab3-e8ec1d08a5ad"] :activity/first-step "step-58d4a216-d386-5004-acc6-1259a07e1494" :db/ensure [:activity/validate]} {:db/id "step-58d4a216-d386-5004-acc6-1259a07e1494" :step/id #uuid "58d4a216-d386-5004-acc6-1259a07e1494" :step/content "question-87021664-1460-517e-b0da-ae45fc0bbb9e" :step/next "step-5496c088-fa95-5052-8432-a8ee6731ca57" :db/ensure [:step/validate]} {:db/id "step-5496c088-fa95-5052-8432-a8ee6731ca57" :step/id #uuid "5496c088-fa95-5052-8432-a8ee6731ca57" :step/content 17592186247313 :step/next "step-98570077-079e-5420-bc17-984e3fb96b3b" :db/ensure [:step/validate]} {:db/id "step-98570077-079e-5420-bc17-984e3fb96b3b" :step/id #uuid "98570077-079e-5420-bc17-984e3fb96b3b" :step/content 17592186302137 :step/next "step-d86879e5-509b-538b-b3ff-c28fdb97936e" :db/ensure [:step/validate]} {:db/id "step-d86879e5-509b-538b-b3ff-c28fdb97936e" :step/id #uuid "d86879e5-509b-538b-b3ff-c28fdb97936e" :step/content 17592186492830 :step/next "step-c5006e3f-438a-526e-aab3-e8ec1d08a5ad" :db/ensure [:step/validate]} {:db/id "step-c5006e3f-438a-526e-aab3-e8ec1d08a5ad" :step/id #uuid "c5006e3f-438a-526e-aab3-e8ec1d08a5ad" :step/content 17592186302145 :db/ensure [:step/validate]} {:db/id 17592186166888 :knowledge-point/questions ["question-efd53794-367f-547c-a3cb-0e0a7df2cfac"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167480 :question/problem "Given $X∼B(7,0.6),$ compute $P(1<X\\le 3).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.6)^{x}(0.4)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1<X\\le 3) & =P(X\\in \\{2,3\\}) \\\\  & =f(2)+f(3) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{2})(0.6)^{2}(0.4)^{7-2}+(\\genfrac{}{}{0pt}{}{7}{3})(0.6)^{3}(0.4)^{7-3} \\\\  & =21(0.6)^{2}(0.4)^{5}+35(0.6)^{3}(0.4)^{4} \\\\  & ≈0.2710\\end{aligned}\n$$\n\nto $4$ decimal places." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186166088 :answer-field/correct 17592186166092 :db/ensure [:answer-field/validate]} {:db/id 17592186166889 :knowledge-point/questions ["question-f971c3b7-c38e-56ce-b09c-6e2a701c1e91"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167481 :question/problem "Given that $X∼B(9,0.3),$ compute $P(X\\le 7).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(9,0.3),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{9}{x})(0.3)^{x}(0.7)^{9-x}.\n$$\n\nComputing $P(X\\le 7)$ will require us to compute $f(x)$ at $x=0,1,2,…,7.$ However, if we compute the complement $P(X>7)$ instead, then we will only have to compute $f(x)$ at $x=8,9,$ which will result in a much faster computation.\n\nComputing $P(X>7),$ we get\n\n$$\n\\begin{aligned}P(X>7) & =P(X\\in \\{8,9\\}) \\\\  & =f(8)+f(9) \\\\  & =(\\genfrac{}{}{0pt}{}{9}{8})(0.3)^{8}(0.7)^{9-8}+(\\genfrac{}{}{0pt}{}{9}{9})(0.3)^{9}(0.7)^{9-9} \\\\  & =9(0.3)^{8}(0.7)+(0.3)^{9} \\\\  & ≈0.0004\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 7) & =1-P(X>7) \\\\  & ≈1-0.0004 \\\\  & =0.9996\\end{aligned}\n$$\n\nrounded to $4$ decimal places." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186166094 :answer-field/correct 17592186166096 :db/ensure [:answer-field/validate]} {:db/id 17592186166887 :knowledge-point/questions ["question-dda52838-e549-5595-ba17-f5adb7013bf8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dda52838-e549-5595-ba17-f5adb7013bf8" :question/id #uuid "dda52838-e549-5595-ba17-f5adb7013bf8" :question/math-academy-id "q-97505" :question/problem "Given that $X∼B(7,0.4),$ compute $P(X\\le 2).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.4),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.4)^{x}(0.6)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 2) & =P(X\\in \\{0,1,2\\}) \\\\  & =f(0)+f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{0})(0.4)^{0}(0.6)^{7-0}+(\\genfrac{}{}{0pt}{}{7}{1})(0.4)^{1}(0.6)^{7-1}+(\\genfrac{}{}{0pt}{}{7}{2})(0.4)^{2}(0.6)^{7-2} \\\\  & =1(0.4)^{0}(0.6)^{7}+7(0.4)(0.6)^{6}+21(0.4)^{2}(0.6)^{5} \\\\  & ≈0.4199\\end{aligned}\n$$\n\nto $4$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-93f42f81-64bc-5bdc-8f24-11963ed6c867"] :db/ensure [:question/validate]} {:db/id "answer-field-93f42f81-64bc-5bdc-8f24-11963ed6c867" :answer-field/id #uuid "93f42f81-64bc-5bdc-8f24-11963ed6c867" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-31bf5d69-eb49-5b8a-a67c-fc27f690f962" :answer-field/choices ["answer-31bf5d69-eb49-5b8a-a67c-fc27f690f962" "answer-79d1b1e6-898f-5dd4-b846-71873e97741c" "answer-1db86219-2eac-5c9f-a3bf-973d5602b642" "answer-9469b8cc-2e3f-5043-bf24-87474596ac91" "answer-2d77499c-5ed0-5cea-aa1b-50bd167e5262"] :db/ensure [:answer-field/validate]} {:db/id "answer-31bf5d69-eb49-5b8a-a67c-fc27f690f962" :answer/id #uuid "31bf5d69-eb49-5b8a-a67c-fc27f690f962" :answer/type :answer.type/math :answer/value "0.4199" :db/ensure [:answer/validate]} {:db/id "answer-79d1b1e6-898f-5dd4-b846-71873e97741c" :answer/id #uuid "79d1b1e6-898f-5dd4-b846-71873e97741c" :answer/type :answer.type/math :answer/value "0.4414" :db/ensure [:answer/validate]} {:db/id "answer-1db86219-2eac-5c9f-a3bf-973d5602b642" :answer/id #uuid "1db86219-2eac-5c9f-a3bf-973d5602b642" :answer/type :answer.type/math :answer/value "0.4613" :db/ensure [:answer/validate]} {:db/id "answer-9469b8cc-2e3f-5043-bf24-87474596ac91" :answer/id #uuid "9469b8cc-2e3f-5043-bf24-87474596ac91" :answer/type :answer.type/math :answer/value "0.5586" :db/ensure [:answer/validate]} {:db/id "answer-2d77499c-5ed0-5cea-aa1b-50bd167e5262" :answer/id #uuid "2d77499c-5ed0-5cea-aa1b-50bd167e5262" :answer/type :answer.type/math :answer/value "0.5801" :db/ensure [:answer/validate]} {:db/id "question-f971c3b7-c38e-56ce-b09c-6e2a701c1e91" :question/id #uuid "f971c3b7-c38e-56ce-b09c-6e2a701c1e91" :question/math-academy-id "q-129982" :question/problem "Given that $X∼B(6,0.6),$ compute $P(X\\ge 2).$ Round your final answer to $4$ decimal places." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(6,0.6),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{6}{x})(0.6)^{x}(0.4)^{6-x}.\n$$\n\nComputing $P(X\\ge 2)$ will require us to compute $f(x)$ at $x=2,3,4,5,6.$ However, if we compute the complement $P(X<2)$ instead, then we will only have to compute $f(x)$ at $x=0,1,$ which will result in a much faster computation.\n\nComputing $P(X<2),$ we get\n\n$$\n\\begin{aligned}P(X<2) & =P(X\\in \\{0,1\\}) \\\\  & =f(0)+f(1) \\\\  & =(\\genfrac{}{}{0pt}{}{6}{0})(0.6)^{0}(0.4)^{6-0}+(\\genfrac{}{}{0pt}{}{6}{1})(0.6)^{1}(0.4)^{6-1} \\\\  & =1(0.6)^{0}(0.4)^{6}+6(0.6)^{1}(0.4)^{5} \\\\  & ≈0.0410\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & =1-P(X<2) \\\\  & ≈1-0.0410 \\\\  & =0.9590\\end{aligned}\n$$\n\nrounded to $4$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8debddd-d193-5cbb-9714-1e57ecfc0d4a"] :db/ensure [:question/validate]} {:db/id "answer-field-b8debddd-d193-5cbb-9714-1e57ecfc0d4a" :answer-field/id #uuid "b8debddd-d193-5cbb-9714-1e57ecfc0d4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f827e693-1cfa-5aac-8c0d-f7f620f2e41c" :answer-field/choices ["answer-34af392b-1136-50d8-a203-652c8d606c68" "answer-e377b303-c9d0-5210-973d-2b50b7f6f27d" "answer-bf4229ee-a75e-56ad-8370-aa5a487d6cda" "answer-57c3c507-2e75-561a-bece-cbf7a22ed1b7" "answer-f827e693-1cfa-5aac-8c0d-f7f620f2e41c"] :db/ensure [:answer-field/validate]} {:db/id "answer-34af392b-1136-50d8-a203-652c8d606c68" :answer/id #uuid "34af392b-1136-50d8-a203-652c8d606c68" :answer/type :answer.type/math :answer/value "0.8410" :db/ensure [:answer/validate]} {:db/id "answer-e377b303-c9d0-5210-973d-2b50b7f6f27d" :answer/id #uuid "e377b303-c9d0-5210-973d-2b50b7f6f27d" :answer/type :answer.type/math :answer/value "0.8543" :db/ensure [:answer/validate]} {:db/id "answer-bf4229ee-a75e-56ad-8370-aa5a487d6cda" :answer/id #uuid "bf4229ee-a75e-56ad-8370-aa5a487d6cda" :answer/type :answer.type/math :answer/value "0.8792" :db/ensure [:answer/validate]} {:db/id "answer-57c3c507-2e75-561a-bece-cbf7a22ed1b7" :answer/id #uuid "57c3c507-2e75-561a-bece-cbf7a22ed1b7" :answer/type :answer.type/math :answer/value "0.9382" :db/ensure [:answer/validate]} {:db/id "answer-f827e693-1cfa-5aac-8c0d-f7f620f2e41c" :answer/id #uuid "f827e693-1cfa-5aac-8c0d-f7f620f2e41c" :answer/type :answer.type/math :answer/value "0.9590" :db/ensure [:answer/validate]} {:db/id "question-efd53794-367f-547c-a3cb-0e0a7df2cfac" :question/id #uuid "efd53794-367f-547c-a3cb-0e0a7df2cfac" :question/math-academy-id "q-276035" :question/problem "If $X∼B(4,\\frac{1}{3}),$  then, **rounded to $3$ decimal places**, $P(1\\le X<3)≈${{field-1}} ." :question/worked-solution "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial, we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(4,\\frac{1}{3}),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{4}{x}){(\\frac{1}{3})}^{x}{(\\frac{2}{3})}^{4-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(1\\le X<3) & =P(X\\in \\{1,2\\}) \\\\  & =f(1)+f(2) \\\\  & =(\\genfrac{}{}{0pt}{}{4}{1}){(\\frac{1}{3})}^{1}{(\\frac{2}{3})}^{4-1}+(\\genfrac{}{}{0pt}{}{4}{2}){(\\frac{1}{3})}^{2}{(\\frac{2}{3})}^{4-2} \\\\  & =4{(\\frac{1}{3})}^{1}{(\\frac{2}{3})}^{3}+6{(\\frac{1}{3})}^{2}{(\\frac{2}{3})}^{2} \\\\  & ≈0.691\\end{aligned}\n$$\n\n \nrounded to $3$ decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-82753b1d-4114-53cd-9ba7-e76ac29f8bca"] :db/ensure [:question/validate]} {:db/id "answer-field-82753b1d-4114-53cd-9ba7-e76ac29f8bca" :answer-field/id #uuid "82753b1d-4114-53cd-9ba7-e76ac29f8bca" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-06093a48-e545-54b9-8ae5-487035b494fe" :answer-field/choices ["answer-06093a48-e545-54b9-8ae5-487035b494fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-06093a48-e545-54b9-8ae5-487035b494fe" :answer/id #uuid "06093a48-e545-54b9-8ae5-487035b494fe" :answer/type :answer.type/math :answer/value "0.691" :db/ensure [:answer/validate]} {:db/id "activity-17fbaf4c-9f7a-5678-be04-a367ec203e49" :activity/id #uuid "17fbaf4c-9f7a-5678-be04-a367ec203e49" :activity/title "The Binomial Distribution" :activity/type :activity.type/review :activity/scope 17592186050651 :activity/course 17592186046644 :activity/steps ["step-e39bc8c2-f9ad-5e96-a8c2-647e7e52166c" "step-27436152-bd5a-5f69-b3fd-2d154aea4738" "step-b3074db6-1ee5-5a4e-a6ad-c1535401d0eb" "step-473e7155-20e8-5e80-ac4b-75b4a1d0dac2" "step-8df4b920-6b6d-51b2-b008-73e34d27e428"] :activity/first-step "step-e39bc8c2-f9ad-5e96-a8c2-647e7e52166c" :db/ensure [:activity/validate]} {:db/id "step-e39bc8c2-f9ad-5e96-a8c2-647e7e52166c" :step/id #uuid "e39bc8c2-f9ad-5e96-a8c2-647e7e52166c" :step/content 17592186167480 :step/next "step-27436152-bd5a-5f69-b3fd-2d154aea4738" :db/ensure [:step/validate]} {:db/id "step-27436152-bd5a-5f69-b3fd-2d154aea4738" :step/id #uuid "27436152-bd5a-5f69-b3fd-2d154aea4738" :step/content 17592186167481 :step/next "step-b3074db6-1ee5-5a4e-a6ad-c1535401d0eb" :db/ensure [:step/validate]} {:db/id "step-b3074db6-1ee5-5a4e-a6ad-c1535401d0eb" :step/id #uuid "b3074db6-1ee5-5a4e-a6ad-c1535401d0eb" :step/content "question-dda52838-e549-5595-ba17-f5adb7013bf8" :step/next "step-473e7155-20e8-5e80-ac4b-75b4a1d0dac2" :db/ensure [:step/validate]} {:db/id "step-473e7155-20e8-5e80-ac4b-75b4a1d0dac2" :step/id #uuid "473e7155-20e8-5e80-ac4b-75b4a1d0dac2" :step/content "question-f971c3b7-c38e-56ce-b09c-6e2a701c1e91" :step/next "step-8df4b920-6b6d-51b2-b008-73e34d27e428" :db/ensure [:step/validate]} {:db/id "step-8df4b920-6b6d-51b2-b008-73e34d27e428" :step/id #uuid "8df4b920-6b6d-51b2-b008-73e34d27e428" :step/content "question-efd53794-367f-547c-a3cb-0e0a7df2cfac" :db/ensure [:step/validate]} [:db/retract 17592186184876 :question/answer-fields 17592186183865] [:db/retract 17592186183883 :answer-field/choices 17592186183888] [:db/retract 17592186183883 :answer-field/choices 17592186183884] [:db/retract 17592186183883 :answer-field/choices 17592186183885] [:db/retract 17592186183883 :answer-field/choices 17592186183886] [:db/retract 17592186183883 :answer-field/choices 17592186183887] {:db/id 17592186184879 :question/problem "What are the singular values of the matrix $A=[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]?$" :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nFirst, we calculate ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}]}^{T}[\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ -4 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}0 & -4 & 0 \\\\ 3 & 0 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}9 & 0 & -12 \\\\ 0 & 16 & 0 \\\\ -12 & 0 & 16\\end{aligned}]\\end{aligned}\n$$\n\nNow, we solve the characteristic equation of ${A}^{T}\\,A:$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}9-\\lambda  & 0 & -12 \\\\ 0 & 16-\\lambda  & 0 \\\\ -12 & 0 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )|\\begin{aligned}9-\\lambda  & -12 \\\\ -12 & 16-\\lambda \\end{aligned}| & =0 \\\\ (16-\\lambda )((9-\\lambda )(16-\\lambda )-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-9\\lambda -16\\lambda +144-144) & =0 \\\\ (16-\\lambda )({\\lambda }^{2}-25\\lambda ) & =0 \\\\ \\lambda (\\lambda -16)(\\lambda -25) & =0 \\\\ \\lambda  & =25,\\,16,\\,0\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{25}=5 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{16}=4 \\\\ {\\sigma }_{3} & =\\sqrt{{\\lambda }_{3}}=\\sqrt{0}=0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186183883 :answer-field/correct "answer-22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer-field/choices ["answer-2a9003af-2b01-57da-a933-16ff4579b8dd" "answer-ebe89adf-37a2-5724-a8e8-777891808839" "answer-e99a56fa-1127-5a1f-872f-bba0b1b2c89b" "answer-22d60bfe-9b93-5322-a886-7bb0f57eff46" "answer-80e9ab77-14e2-509c-baf9-6e9048da53b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a9003af-2b01-57da-a933-16ff4579b8dd" :answer/id #uuid "2a9003af-2b01-57da-a933-16ff4579b8dd" :answer/type :answer.type/math :answer/value "25,\\,4,\\,0" :db/ensure [:answer/validate]} {:db/id "answer-ebe89adf-37a2-5724-a8e8-777891808839" :answer/id #uuid "ebe89adf-37a2-5724-a8e8-777891808839" :answer/type :answer.type/math :answer/value "3,\\,2,\\,0" :db/ensure [:answer/validate]} {:db/id "answer-e99a56fa-1127-5a1f-872f-bba0b1b2c89b" :answer/id #uuid "e99a56fa-1127-5a1f-872f-bba0b1b2c89b" :answer/type :answer.type/math :answer/value "3,\\,3,\\,0" :db/ensure [:answer/validate]} {:db/id "answer-22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer/id #uuid "22d60bfe-9b93-5322-a886-7bb0f57eff46" :answer/type :answer.type/math :answer/value "5,\\,4,\\,0" :db/ensure [:answer/validate]} {:db/id "answer-80e9ab77-14e2-509c-baf9-6e9048da53b9" :answer/id #uuid "80e9ab77-14e2-509c-baf9-6e9048da53b9" :answer/type :answer.type/math :answer/value "9,\\,4,\\,0" :db/ensure [:answer/validate]} {:db/id "activity-25c36865-a3f4-539d-ab87-b42995a49a22" :activity/id #uuid "25c36865-a3f4-539d-ab87-b42995a49a22" :activity/title "Computing the Singular Values of a Matrix" :activity/type :activity.type/review :activity/scope 17592186049462 :activity/course 17592186046644 :activity/steps ["step-b7075bef-316c-5493-a497-4195378a1e59" "step-f17c08c3-3583-5a53-8194-3b1d81d7c6a0" "step-08b16f9c-1a48-5e48-899f-7bdd30c63128" "step-e0f1a8d8-c027-55c3-946a-482b070b07cc" "step-d6b3e1f2-3037-5a02-a9b8-d618b9003666"] :activity/first-step "step-b7075bef-316c-5493-a497-4195378a1e59" :db/ensure [:activity/validate]} {:db/id "step-b7075bef-316c-5493-a497-4195378a1e59" :step/id #uuid "b7075bef-316c-5493-a497-4195378a1e59" :step/content 17592186184876 :step/next "step-f17c08c3-3583-5a53-8194-3b1d81d7c6a0" :db/ensure [:step/validate]} {:db/id "step-f17c08c3-3583-5a53-8194-3b1d81d7c6a0" :step/id #uuid "f17c08c3-3583-5a53-8194-3b1d81d7c6a0" :step/content 17592186184879 :step/next "step-08b16f9c-1a48-5e48-899f-7bdd30c63128" :db/ensure [:step/validate]} {:db/id "step-08b16f9c-1a48-5e48-899f-7bdd30c63128" :step/id #uuid "08b16f9c-1a48-5e48-899f-7bdd30c63128" :step/content 17592186493969 :step/next "step-e0f1a8d8-c027-55c3-946a-482b070b07cc" :db/ensure [:step/validate]} {:db/id "step-e0f1a8d8-c027-55c3-946a-482b070b07cc" :step/id #uuid "e0f1a8d8-c027-55c3-946a-482b070b07cc" :step/content 17592186368913 :step/next "step-d6b3e1f2-3037-5a02-a9b8-d618b9003666" :db/ensure [:step/validate]} {:db/id "step-d6b3e1f2-3037-5a02-a9b8-d618b9003666" :step/id #uuid "d6b3e1f2-3037-5a02-a9b8-d618b9003666" :step/content 17592186415575 :db/ensure [:step/validate]} [:db/retract 17592186191187 :answer-field/choices 17592186191188] [:db/retract 17592186191187 :answer-field/choices 17592186191190] [:db/retract 17592186191187 :answer-field/choices 17592186191191] [:db/retract 17592186191187 :answer-field/choices 17592186191192] {:db/id 17592186192654 :knowledge-point/questions ["question-2a68ca7c-dc16-5d70-b5c4-e7c98a96c8e2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192585 :question/problem "Consider the following system of equations. \n\n$$\n\\{\\begin{aligned}a+4b=1 \\\\ 2a+b=-5\\end{aligned}\n$$\n\nDescribe the steps needed to eliminate the variable $a$ from this system by filling in the missing information below.\n\n$\\qquad$ *To eliminate $a,$ multiply the $\\,\\textbf{__________}\\,$equation by $\\,\\textbf{______}\\,$, \nand add the equations.*" :question/worked-solution "Notice that the coefficient of $a$ in the first equation is $1,$ while in the second equation it is $2.$ \n\nIf we multiply the first equation by ${\\color{blue}-2},$ then the coefficient of $a$ will turn into $-2,$ which will cancel with the coefficient of $2$ in the second equation.\n\n![](images/2b/2b0aa0d1dbfeb1e711bde6e7741fe5706aa126d71c44ae417d3c78d01b83547a.svg)\n\nNow, when we add the two equations, the variable $a$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{-2a}-8b & =-2 \\\\ \\cancel{2a}+b & =-5 \\\\ (-8b+b) & =(-2-5) \\\\ -7b & =-7\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n*To eliminate $a,$ multiply the $\\bbox[3pt,Gainsboro]{\\color{blue}\\text{first}}$ equation by $\\bbox[3pt,Gainsboro]{\\color{blue}-2},$ and add the equations*." :db/ensure [:question/validate]} {:db/id 17592186192655 :knowledge-point/questions ["question-09338f11-6e50-5f7e-baa9-764c66288045" "question-5ba7c176-1d51-52ad-ad1b-a588df23024a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192586 :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned}3x+4y=2 \\\\ x-2y=4\\end{aligned}\n$$\n\nDescribe the steps needed to eliminate the variable $y$ from this system by filling in the missing information below.\n\n$\\qquad$ *To eliminate $y,$ multiply the $\\,\\textbf{__________}\\,$equation by $\\,\\textbf{______}\\,$, \nand add the equations.*" :question/worked-solution "Notice that the coefficient of $y$ in the first equation is $4,$ while in the second equation it is $-2.$ \n\nIf we multiply the second equation by ${\\color{blue}2},$ then the coefficient of $y$ will turn into $-4,$ which will cancel with the coefficient of $4$ in the first equation.\n\n![](images/0e/0e494f68d4859d46c3c369274e415f10a850c664343d41cce8dcfcfdd660e17c.svg)\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}3x+\\cancel{4y} & =2 \\\\ 2x-\\cancel{4y} & =8 \\\\ (3x+2x) & =(2+8) \\\\ 5x & =10\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n*To eliminate $y,$ multiply the $\\bbox[3pt,Gainsboro]{\\color{blue}\\text{second}}$ equation by $\\bbox[3pt,Gainsboro]{\\color{blue}2},$ and add the equations*." :db/ensure [:question/validate]} {:db/id 17592186192656 :knowledge-point/questions ["question-4775db8b-54b5-507a-83b4-6fee15253323"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192587 :question/problem "Find the solution $(x,y)$ to the following system of equations using the elimination method:\n\n$$\n\\{\\begin{aligned}2x+3y=8 \\\\ x-2y=-3\\end{aligned}\n$$" :question/worked-solution "Notice that the coefficient of $x$ in the first equation is $2,$ while in the second equation it is $1.$\n\nIf we multiply the second equation by $-2,$ then the $x$-coefficient will become $-2,$ which will cancel with the coefficient of $2$ in the first equation.\n![](images/a7/a7e5f9f09d67dd14a4797e5675585973e3aafeb1ee96e9021d245f49ce9c1c7e.svg)\n\nNow, when we add the two equations, the variable $x$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{2x}+3y & =8 \\\\ \\cancel{-2x}+4y & =6 \\\\ (3y+4y) & =(8+6) \\\\ 7y & =14 \\\\ y & =2\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $y = 2.$ However, we still need to find $x.$ To do this, we substitute $y = 2$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\\begin{aligned}x-2y & =-3 \\\\ x-2(2) & =-3 \\\\ x-4 & =-3 \\\\ x & =1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=1, \\,y=2,$ which can be expressed as $(1,2).$" :db/ensure [:question/validate]} {:db/id 17592186192657 :knowledge-point/questions ["question-4c472f9d-cfda-5414-a840-ee6d18544bcc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192588 :question/problem "Find the solution $(u,v)$ to the following system of equations using the elimination method:\n\n$$\n\\{\\begin{aligned}5u-6v=3 \\\\ -3u+2v=-5\\end{aligned}\n$$" :question/worked-solution "Notice that the $v$-coefficient in the first equation is $-6,$ while in the second equation it is $2.$ \n\nIf we multiply the second equation by $3,$ then the $v$-coefficient will become $6,$ which will cancel with the coefficient of $-6$ in the first equation.\n![](images/e7/e701d299976539abdbbe6e9c311c2db14c23cca6817c5a3de5b5c05a95760d99.svg)\n\nNow, when we add the two equations, the variable $v$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}5u-\\cancel{6v} & =3 \\\\ -9u+\\cancel{6v} & =-15 \\\\ (5u-9u) & =(3-15) \\\\ -4u & =-12 \\\\ u & =3\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $u = 3.$ However, we still need to find $v.$ To do this, we substitute $u = 3$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}-3u+2v & =-5 \\\\ -3(3)+2v & =-5 \\\\ -9+2v & =-5 \\\\ 2v & =4 \\\\ v & =2\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $u = 3, \\,v = 2,$ which can be expressed as $(3,2).$" :db/ensure [:question/validate]} {:db/id "question-2a68ca7c-dc16-5d70-b5c4-e7c98a96c8e2" :question/id #uuid "2a68ca7c-dc16-5d70-b5c4-e7c98a96c8e2" :question/math-academy-id "q-238035" :question/problem "Consider the following system of equations. \n\n$$\n\\{\\begin{aligned}10x-3y=36 \\\\ 2x+5y=-4\\end{aligned}\n$$\n\nDescribe the steps needed to eliminate the variable $x$ from the system:\n\nTo eliminate $x,$ multiply the \n{{field-1}} \nequation by \n{{field-2}}, \nand add the equations." :question/worked-solution "Notice that the coefficient of $x$ in the first equation is $10,$ while in the second equation it is $2.$ \n\nIf we multiply the second equation by $-5,$ then the coefficient of $x$ will turn into $-10,$ which will cancel with the coefficient of $10$ in the first equation.\n\n$$\n\\{\\begin{aligned}10x-3y=36 \\\\ (\\,2x+5y=-4\\,)\\,\\times (-5)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}10x-3y=36 \\\\ -10x-25y=20\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $x$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{10x}-3y & =36 \\\\ -\\cancel{10x}-25y & =20 \\\\ (-3y-25y) & =(36+20) \\\\ -28y & =56 \\\\ y & =-2\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n*Multiply the $\\text{second}$ equation by $-5,$ and add the equations*." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-15d7b3eb-155c-54a4-84ac-4a02f7b9e7e6" "answer-field-4fa84268-830c-548e-ba16-e867f14c3bf3"] :db/ensure [:question/validate]} {:db/id "answer-field-15d7b3eb-155c-54a4-84ac-4a02f7b9e7e6" :answer-field/id #uuid "15d7b3eb-155c-54a4-84ac-4a02f7b9e7e6" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-396c0c6a-1e03-5316-868c-3693041a6a8d" :answer-field/choices ["answer-7405e912-7fbf-5e14-9ed1-9fa8aad46b93" "answer-396c0c6a-1e03-5316-868c-3693041a6a8d"] :db/ensure [:answer-field/validate]} {:db/id "answer-7405e912-7fbf-5e14-9ed1-9fa8aad46b93" :answer/id #uuid "7405e912-7fbf-5e14-9ed1-9fa8aad46b93" :answer/type :answer.type/text :answer/value "first" :db/ensure [:answer/validate]} {:db/id "answer-396c0c6a-1e03-5316-868c-3693041a6a8d" :answer/id #uuid "396c0c6a-1e03-5316-868c-3693041a6a8d" :answer/type :answer.type/text :answer/value "second" :db/ensure [:answer/validate]} {:db/id "answer-field-4fa84268-830c-548e-ba16-e867f14c3bf3" :answer-field/id #uuid "4fa84268-830c-548e-ba16-e867f14c3bf3" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-564482bf-2dea-55bc-82ec-61c16390e434" :answer-field/choices ["answer-564482bf-2dea-55bc-82ec-61c16390e434" "answer-ed089b80-c77d-5a59-8fbf-99ba45caaf88" "answer-802cf47d-d04d-59cb-9afb-86ba6294bc49" "answer-82dc65ea-5abd-5f0e-b1d6-8d53cd015c74"] :db/ensure [:answer-field/validate]} {:db/id "answer-564482bf-2dea-55bc-82ec-61c16390e434" :answer/id #uuid "564482bf-2dea-55bc-82ec-61c16390e434" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-ed089b80-c77d-5a59-8fbf-99ba45caaf88" :answer/id #uuid "ed089b80-c77d-5a59-8fbf-99ba45caaf88" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-802cf47d-d04d-59cb-9afb-86ba6294bc49" :answer/id #uuid "802cf47d-d04d-59cb-9afb-86ba6294bc49" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-82dc65ea-5abd-5f0e-b1d6-8d53cd015c74" :answer/id #uuid "82dc65ea-5abd-5f0e-b1d6-8d53cd015c74" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186193242 :question/problem "Consider the following system of equations. \n\n$$\n\\{\\begin{aligned}3s+4t=8 \\\\ s+5t=10\\end{aligned}\n$$\n\nDescribe the steps needed to eliminate the variable $s$ from the system:\n\nTo eliminate $s,$ multiply the \n{{field-1}} \nequation by \n{{field-2}}, \nand add the equations." :question/worked-solution "Notice that the coefficient of $s$ in the first equation is $3,$ while in the second equation it is $1.$ \n\nIf we multiply the second equation by $-3,$ then the coefficient of $s$ will turn into $-3,$ which will cancel with the coefficient of $3$ in the first equation.\n\n$$\n\\{\\begin{aligned}3s+4t=8 \\\\ (\\,s+5t=10\\,)\\,\\times (-3)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}3s+4t=8 \\\\ -3s-15t=-30\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $s$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{3s}+4t & =8 \\\\ -\\cancel{3s}-15t & =-30 \\\\ (4t-15t) & =(8-30) \\\\ -11t & =-22 \\\\ t & =2\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n*Multiply the $\\text{second}$ equation by $-3,$ and add the equations*." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186191245 :answer-field/correct 17592186191246 :db/ensure [:answer-field/validate]} {:db/id 17592186191248 :answer-field/correct 17592186191250 :db/ensure [:answer-field/validate]} {:db/id "question-09338f11-6e50-5f7e-baa9-764c66288045" :question/id #uuid "09338f11-6e50-5f7e-baa9-764c66288045" :question/math-academy-id "q-238044" :question/problem "Consider the following system of equations. \n\n$$\n\\{\\begin{aligned}-5x+y=8 \\\\ 8x-7y=25\\end{aligned}\n$$\n\nDescribe the steps needed to eliminate the variable $y$ from the system:\n\nTo eliminate $y,$ multiply the \n{{field-1}} \nequation by \n{{field-2}}, \nand add the equations." :question/worked-solution "Notice that the coefficient of $y$ in the first equation is $1,$ while in the second equation it is $-7.$ \n\nIf we multiply the first equation by $7,$ then the coefficient of $y$ will turn into $7,$ which will cancel with the coefficient of $-7$ in the second equation.\n\n$$\n\\{\\begin{aligned}(\\,-5x+y=8\\,)\\,\\times (7) \\\\ 8x-7y=25\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-35x+7y=56 \\\\ 8x-7y=25\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}-35x+\\cancel{7y} & =56 \\\\ 8x-\\cancel{7y} & =25 \\\\ (-35x+8x) & =(56+25) \\\\ -27x & =81\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n*To eliminate $y,$ multiply the $\\text{first}$ equation by $7,$ and add the equations*." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8e78a58b-7fed-5d4a-8336-150e88af3ff3" "answer-field-4046a4d7-d1ee-512c-8f22-ac17abe07653"] :db/ensure [:question/validate]} {:db/id "answer-field-8e78a58b-7fed-5d4a-8336-150e88af3ff3" :answer-field/id #uuid "8e78a58b-7fed-5d4a-8336-150e88af3ff3" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-58ca67c6-ef0f-5fd0-bbf0-abeced525206" :answer-field/choices ["answer-58ca67c6-ef0f-5fd0-bbf0-abeced525206" "answer-8c9c819a-e67f-55f7-ae5e-0327e8b580c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-58ca67c6-ef0f-5fd0-bbf0-abeced525206" :answer/id #uuid "58ca67c6-ef0f-5fd0-bbf0-abeced525206" :answer/type :answer.type/text :answer/value "first" :db/ensure [:answer/validate]} {:db/id "answer-8c9c819a-e67f-55f7-ae5e-0327e8b580c9" :answer/id #uuid "8c9c819a-e67f-55f7-ae5e-0327e8b580c9" :answer/type :answer.type/text :answer/value "second" :db/ensure [:answer/validate]} {:db/id "answer-field-4046a4d7-d1ee-512c-8f22-ac17abe07653" :answer-field/id #uuid "4046a4d7-d1ee-512c-8f22-ac17abe07653" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-82649ab6-63e2-5e38-9a54-9307deefdeb7" :answer-field/choices ["answer-f1e16c77-b35b-5b8b-82d8-51637fcbbe74" "answer-8b82b948-2752-5af9-8b4b-7dbe6940b437" "answer-012d1788-aae6-5b3f-9a33-32cfe9441bb7" "answer-82649ab6-63e2-5e38-9a54-9307deefdeb7"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1e16c77-b35b-5b8b-82d8-51637fcbbe74" :answer/id #uuid "f1e16c77-b35b-5b8b-82d8-51637fcbbe74" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-8b82b948-2752-5af9-8b4b-7dbe6940b437" :answer/id #uuid "8b82b948-2752-5af9-8b4b-7dbe6940b437" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "answer-012d1788-aae6-5b3f-9a33-32cfe9441bb7" :answer/id #uuid "012d1788-aae6-5b3f-9a33-32cfe9441bb7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-82649ab6-63e2-5e38-9a54-9307deefdeb7" :answer/id #uuid "82649ab6-63e2-5e38-9a54-9307deefdeb7" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-5ba7c176-1d51-52ad-ad1b-a588df23024a" :question/id #uuid "5ba7c176-1d51-52ad-ad1b-a588df23024a" :question/math-academy-id "q-238051" :question/problem "Consider the following system of equations. \n\n$$\n\\{\\begin{aligned}3p+2q=11 \\\\ p+q=4\\end{aligned}\n$$\n\nDescribe the steps needed to eliminate the variable $q$ from the system:\n\nTo eliminate $q,$ multiply the \n{{field-1}} \nequation by \n{{field-2}}, \nand add the equations." :question/worked-solution "Notice that the coefficient of $q$ in the first equation is $2,$ while in the second equation it is $1.$ \n\nIf we multiply the second equation by $-2,$ then the coefficient of $q$ will turn into $-2,$ which will cancel with the coefficient of $2$ in the first equation.\n\n$$\n\\{\\begin{aligned}3p+2q=11 \\\\ (\\,p+q=4\\,)\\,\\times (-2)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}3p+2q=11 \\\\ -2p-2q=-8\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $q$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}3p+\\cancel{2q} & =11 \\\\ -2p-\\cancel{2q} & =-8 \\\\ (3p-2p) & =(11-8) \\\\ p & =3\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is the following:\n\n*To eliminate $q,$ multiply the $\\text{second}$ equation by $-2,$ and add the equations*." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6752cba9-1654-5c73-9d09-080f3eb8532e" "answer-field-22d35b8c-5919-5861-973d-60696f665ffd"] :db/ensure [:question/validate]} {:db/id "answer-field-6752cba9-1654-5c73-9d09-080f3eb8532e" :answer-field/id #uuid "6752cba9-1654-5c73-9d09-080f3eb8532e" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-a15f6018-6390-5ae8-8699-d85026a934d8" :answer-field/choices ["answer-aea80158-002e-503d-aa81-d682984720c2" "answer-a15f6018-6390-5ae8-8699-d85026a934d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-aea80158-002e-503d-aa81-d682984720c2" :answer/id #uuid "aea80158-002e-503d-aa81-d682984720c2" :answer/type :answer.type/text :answer/value "first" :db/ensure [:answer/validate]} {:db/id "answer-a15f6018-6390-5ae8-8699-d85026a934d8" :answer/id #uuid "a15f6018-6390-5ae8-8699-d85026a934d8" :answer/type :answer.type/text :answer/value "second" :db/ensure [:answer/validate]} {:db/id "answer-field-22d35b8c-5919-5861-973d-60696f665ffd" :answer-field/id #uuid "22d35b8c-5919-5861-973d-60696f665ffd" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-62b5b5df-e1f1-5779-aade-7a55fb1642e8" :answer-field/choices ["answer-62b5b5df-e1f1-5779-aade-7a55fb1642e8" "answer-184b7ab4-4868-5106-9bdf-4e1438c33364" "answer-bffa8226-fe91-5e80-8884-d0fbe91ee966" "answer-4662f5b1-a02f-591b-952a-acc6e7eaed94"] :db/ensure [:answer-field/validate]} {:db/id "answer-62b5b5df-e1f1-5779-aade-7a55fb1642e8" :answer/id #uuid "62b5b5df-e1f1-5779-aade-7a55fb1642e8" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-184b7ab4-4868-5106-9bdf-4e1438c33364" :answer/id #uuid "184b7ab4-4868-5106-9bdf-4e1438c33364" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-bffa8226-fe91-5e80-8884-d0fbe91ee966" :answer/id #uuid "bffa8226-fe91-5e80-8884-d0fbe91ee966" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-4662f5b1-a02f-591b-952a-acc6e7eaed94" :answer/id #uuid "4662f5b1-a02f-591b-952a-acc6e7eaed94" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186193226 :question/problem "Find the solution $(x,y)$ to the following system of equations using the elimination method:\n\n$$\n\\{\\begin{aligned}4x-5y=0 \\\\ 2x-3y=2\\end{aligned}\n$$\n\n*Hint: Eliminate the variable $x.$*" :question/worked-solution "Notice that the $x$-coefficient in the first equation is $4,$ while in the second equation it is $2.$ \n\nIf we multiply the second equation by $-2,$ then the $x$-coefficient will become $-4,$ which will cancel with the coefficient of $4$ in the first equation.\n\n$$\n\\{\\begin{aligned}4x-5y=0 \\\\ (\\,2x-3y=2\\,)\\,\\times (-2)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}4x-5y=0 \\\\ -4x+6y=-4\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $x$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{4x}-5y & =0 \\\\ -\\cancel{4x}+6y & =-4 \\\\ (-5y+6y) & =(0-4) \\\\ y & =-4\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $y=-4.$ However, we still need to find $x.$ To do this, we substitute $y=-4$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}\\begin{aligned}4x-5y & =0 \\\\ 4x-5(-4) & =0 \\\\ 4x+20 & =0 \\\\ 4x & =-20 \\\\ x & =-5\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-5,\\,y=-4,$ which can be expressed as $(-5,-4).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186191187 :answer-field/correct 17592186191189 :answer-field/choices ["answer-f55c1c33-5ff5-5f10-90f5-08f56a27906c" "answer-ac47150e-5e39-5c69-9314-ddb4609e8210" "answer-7891246f-146f-5da4-be15-343b7425f61f" "answer-8468d23b-6f42-50bf-9e79-d910d35e0ee2"] :db/ensure [:answer-field/validate]} {:db/id "answer-f55c1c33-5ff5-5f10-90f5-08f56a27906c" :answer/id #uuid "f55c1c33-5ff5-5f10-90f5-08f56a27906c" :answer/type :answer.type/math :answer/value "(-5,1)" :db/ensure [:answer/validate]} {:db/id "answer-ac47150e-5e39-5c69-9314-ddb4609e8210" :answer/id #uuid "ac47150e-5e39-5c69-9314-ddb4609e8210" :answer/type :answer.type/math :answer/value "(-5,2)" :db/ensure [:answer/validate]} {:db/id "answer-7891246f-146f-5da4-be15-343b7425f61f" :answer/id #uuid "7891246f-146f-5da4-be15-343b7425f61f" :answer/type :answer.type/math :answer/value "(-5,3)" :db/ensure [:answer/validate]} {:db/id "answer-8468d23b-6f42-50bf-9e79-d910d35e0ee2" :answer/id #uuid "8468d23b-6f42-50bf-9e79-d910d35e0ee2" :answer/type :answer.type/math :answer/value "(4,5)" :db/ensure [:answer/validate]} {:db/id "question-4775db8b-54b5-507a-83b4-6fee15253323" :question/id #uuid "4775db8b-54b5-507a-83b4-6fee15253323" :question/math-academy-id "q-238082" :question/problem "Consider the following system of equations:\n\n$$\n\\{\\begin{aligned}6x+13y=21 \\\\ 2x+6y=12\\end{aligned}\n$$\n\nThe solution $(x,y)$ to this system is $($\n{{field-1}}$\\,,$\n{{field-2}}\n$).$" :question/worked-solution "Notice that the coefficient of $x$ in the  first  equation is $6,$ while in the second equation it is $2.$ \n\nIf we multiply the second equation by $-3,$ then the $x$-coefficient will become $-6,$ which will cancel with the coefficient of $6$ in the first equation.\n\n$$\n\\{\\begin{aligned}6x+13y=21 \\\\ (\\,2x+6y=12\\,)\\,\\times (-3)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}6x+13y=21 \\\\ -6x-18y=-36\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $x$ will be eliminated:\n\n$$\n\\begin{aligned}\\cancel{6x}+13y & =21 \\\\ -\\cancel{6x}-18y & =-36 \\\\ (13y-18y) & =(21-36) \\\\ -5y & =-15 \\\\ y & =3\\end{aligned}\n$$\n\nSo, the solution must have $y=3.$ However, we still need to find $x.$ To do this, we substitute $y=3$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}6x+13y & =21 \\\\ 6x+13(3) & =21 \\\\ 6x+39 & =21 \\\\ 6x & =-18 \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-3,\\,y=3,$ which can be expressed as $(-3,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2696769d-e344-58f2-b122-e8524fb62262" "answer-field-2adc4195-f1d2-500e-8a09-82e4a8b25e53"] :db/ensure [:question/validate]} {:db/id "answer-field-2696769d-e344-58f2-b122-e8524fb62262" :answer-field/id #uuid "2696769d-e344-58f2-b122-e8524fb62262" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9dddb3dd-6633-5329-a169-4b39e35735ca" :answer-field/choices ["answer-9dddb3dd-6633-5329-a169-4b39e35735ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dddb3dd-6633-5329-a169-4b39e35735ca" :answer/id #uuid "9dddb3dd-6633-5329-a169-4b39e35735ca" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-field-2adc4195-f1d2-500e-8a09-82e4a8b25e53" :answer-field/id #uuid "2adc4195-f1d2-500e-8a09-82e4a8b25e53" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5032cf38-f7e1-5f19-b56e-8d84bbbcec8a" :answer-field/choices ["answer-5032cf38-f7e1-5f19-b56e-8d84bbbcec8a"] :db/ensure [:answer-field/validate]} {:db/id "answer-5032cf38-f7e1-5f19-b56e-8d84bbbcec8a" :answer/id #uuid "5032cf38-f7e1-5f19-b56e-8d84bbbcec8a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186193285 :question/problem "Consider the following system of equations:\n\n$$\n\\{\\begin{aligned}-5x+2y=11 \\\\ 7x+4y=5\\end{aligned}\n$$\n\nFind the solution $(x,y)$ to this system by eliminating the variable $y.$\n\nThe solution is $($\n{{field-1}}$\\,,$\n{{field-2}}\n$).$" :question/worked-solution "Notice that the $y$-coefficient in the first equation is $2,$ while in the second equation it is $4.$ \n\nIf we multiply the first equation by $-2,$ then the $y$-coefficient will become $-4,$ which will cancel with the coefficient of $4$ in the second equation.\n\n$$\n\\{\\begin{aligned}(\\,-5x+2y=11\\,)\\,\\times (-2) \\\\ 7x+4y=5\\end{aligned}\\,⟹\\,\\{\\begin{aligned}10x-4y=-22 \\\\ 7x+4y=5\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $y$ will be eliminated:\n\n$$\n\\begin{aligned}10x-\\cancel{4y} & =-22 \\\\ 7x+\\cancel{4y} & =5 \\\\ (10x+7x) & =(-22+5) \\\\ 17x & =-17 \\\\ x & =-1\\end{aligned}\n$$\n\nSo, the solution must have $x=-1.$ However, we still need to find $y.$ To do this, we substitute $x=-1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}7x+4y & =5 \\\\ 7(-1)+4y & =5 \\\\ -7+4y & =5 \\\\ 4y & =12 \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-1,\\,y=3,$ which can be expressed as $(-1,3).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186191552 :answer-field/correct "answer-5deaa590-2cc0-5e91-b357-5a9ea981fe20" :answer-field/choices ["answer-5deaa590-2cc0-5e91-b357-5a9ea981fe20"] :db/ensure [:answer-field/validate]} {:db/id "answer-5deaa590-2cc0-5e91-b357-5a9ea981fe20" :answer/id #uuid "5deaa590-2cc0-5e91-b357-5a9ea981fe20" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id 17592186191553 :answer-field/correct "answer-c6e8f613-08b6-5743-b480-77cc2a7e2ff1" :answer-field/choices ["answer-c6e8f613-08b6-5743-b480-77cc2a7e2ff1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6e8f613-08b6-5743-b480-77cc2a7e2ff1" :answer/id #uuid "c6e8f613-08b6-5743-b480-77cc2a7e2ff1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-4c472f9d-cfda-5414-a840-ee6d18544bcc" :question/id #uuid "4c472f9d-cfda-5414-a840-ee6d18544bcc" :question/math-academy-id "q-170159" :question/problem "Find the solution $(p,q)$ to the following system of equations using the elimination method:\n\n$$\n\\{\\begin{aligned}3p+2q=11 \\\\ 5p+4q=19\\end{aligned}\n$$\n\n*Hint: Eliminate the variable $q.$*" :question/worked-solution "Notice that the $q$-coefficient in the first equation is $2,$ while in the second equation it is $4.$ \n\nIf we multiply the first equation by $-2,$ then the $q$-coefficient will become $-4,$ which will cancel with the coefficient of $4$ in the second equation.\n\n$$\n\\{\\begin{aligned}(\\,3p+2q=11\\,)\\,\\times (-2) \\\\ 5p+4q=19\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-6p-4q=-22 \\\\ 5p+4q=19\\end{aligned}\n$$\n\nNow, when we add the two equations, the variable $q$ will be eliminated:\n\n$$\n\\begin{aligned}\\begin{aligned}-6p-\\cancel{4q} & =-22 \\\\ 5p+\\cancel{4q} & =19 \\\\ (-6p+5p) & =(-22+19) \\\\ -p & =-3 \\\\ p & =3\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $p=3.$ However, we still need to find $q.$ To do this, we substitute $p=3$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}3p+2q & =11 \\\\ 3(3)+2q & =11 \\\\ 9+2q & =11 \\\\ 2q & =2 \\\\ q & =1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=3,\\,q=1,$ which can be expressed as $(3,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d1429b72-180d-5d2a-ae39-57cc2cf7b25c"] :db/ensure [:question/validate]} {:db/id "answer-field-d1429b72-180d-5d2a-ae39-57cc2cf7b25c" :answer-field/id #uuid "d1429b72-180d-5d2a-ae39-57cc2cf7b25c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-60ff1fa4-ffc7-5336-b3af-c476f0ceefb0" :answer-field/choices ["answer-c386a187-6f74-5af7-a28a-842f181e5f36" "answer-7e050490-5650-55a2-bbaf-c33b2adf2dd8" "answer-f8157de3-2831-5e1e-a4bb-0158173f239a" "answer-60ff1fa4-ffc7-5336-b3af-c476f0ceefb0" "answer-6d3b6243-75d7-5af0-9491-17de5aeb8a29"] :db/ensure [:answer-field/validate]} {:db/id "answer-c386a187-6f74-5af7-a28a-842f181e5f36" :answer/id #uuid "c386a187-6f74-5af7-a28a-842f181e5f36" :answer/type :answer.type/math :answer/value "(1,4)" :db/ensure [:answer/validate]} {:db/id "answer-7e050490-5650-55a2-bbaf-c33b2adf2dd8" :answer/id #uuid "7e050490-5650-55a2-bbaf-c33b2adf2dd8" :answer/type :answer.type/math :answer/value "(1,7)" :db/ensure [:answer/validate]} {:db/id "answer-f8157de3-2831-5e1e-a4bb-0158173f239a" :answer/id #uuid "f8157de3-2831-5e1e-a4bb-0158173f239a" :answer/type :answer.type/math :answer/value "(3,-5)" :db/ensure [:answer/validate]} {:db/id "answer-60ff1fa4-ffc7-5336-b3af-c476f0ceefb0" :answer/id #uuid "60ff1fa4-ffc7-5336-b3af-c476f0ceefb0" :answer/type :answer.type/math :answer/value "(3,1)" :db/ensure [:answer/validate]} {:db/id "answer-6d3b6243-75d7-5af0-9491-17de5aeb8a29" :answer/id #uuid "6d3b6243-75d7-5af0-9491-17de5aeb8a29" :answer/type :answer.type/math :answer/value "(5,-2)" :db/ensure [:answer/validate]} {:db/id 17592186193941 :tutorial/content "Suppose we want to solve the following system of linear equations using the elimination method:\n\n$$\n\\{\\begin{aligned}x+2y=1 \\\\ x-y=-2\\end{aligned}\n$$\n\nAs it stands, adding the two equations will not eliminate any of the variables. \n\nHowever, suppose we want to eliminate the variable $x$. We begin by multiplying the second equation by $\\color{blue}-1$, which gives the following equivalent system:\n\n![](images/72/724119f2404af61332fcabbb5cda3522f9d338a4c6427084e5901e1ca7cd4498.svg)\n\nThen, we add the two resulting equations together. This will eliminate the variable $x,$ allowing us to solve for $y\\mathbin{:}$\n\n$$\n\\begin{aligned}\\begin{aligned}\\cancel{x}+2y & =1 \\\\ -\\cancel{x}+y & =2 \\\\ (2y+y) & =(1+2) \\\\ 3y & =3 \\\\ y & =1\\end{aligned}\\end{aligned}\n$$\n\nSo, the solution must have $y=1.$ However, we still need to find $x.$ To do this, we substitute $y=1$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}\\begin{aligned}x-y & =-2 \\\\ x-(1) & =-2 \\\\ x & =-1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-1$ and $y=1,$ which can be expressed as $(-1, 1).$" :db/ensure [:tutorial/validate]} {:db/id 17592186192905 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]}]
