86f7378d21285ade9c911a2d3bb91c7d017c65e49ee630097.png)\n\nFrom the graph, the curves intersect only at $(1,3).$ Therefore, this is the solution of the corresponding system." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d20bd7ef-2fea-5efb-aaa2-6b1719553681"] :db/ensure [:question/validate]} {:db/id "answer-field-d20bd7ef-2fea-5efb-aaa2-6b1719553681" :answer-field/id #uuid "d20bd7ef-2fea-5efb-aaa2-6b1719553681" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f4927aaa-3d49-5986-a393-72de21877033" :answer-field/choices ["answer-4d98a310-e9b7-5ef4-9bb9-92806fb54f34" "answer-f4927aaa-3d49-5986-a393-72de21877033" "answer-7949f610-b893-5379-acac-b1a1e5967346" "answer-cc3f883e-af4a-5c18-a9da-cfbad645617e" "answer-334ca7f3-24ed-5e10-aab2-8fa9e6895014"] :db/ensure [:answer-field/validate]} {:db/id "answer-4d98a310-e9b7-5ef4-9bb9-92806fb54f34" :answer/id #uuid "4d98a310-e9b7-5ef4-9bb9-92806fb54f34" :answer/type :answer.type/text :answer/value "$(0,2)$ only" :db/ensure [:answer/validate]} {:db/id "answer-f4927aaa-3d49-5986-a393-72de21877033" :answer/id #uuid "f4927aaa-3d49-5986-a393-72de21877033" :answer/type :answer.type/text :answer/value "$(1,3)$ only" :db/ensure [:answer/validate]} {:db/id "answer-7949f610-b893-5379-acac-b1a1e5967346" :answer/id #uuid "7949f610-b893-5379-acac-b1a1e5967346" :answer/type :answer.type/text :answer/value "$(2,3)$ only" :db/ensure [:answer/validate]} {:db/id "answer-cc3f883e-af4a-5c18-a9da-cfbad645617e" :answer/id #uuid "cc3f883e-af4a-5c18-a9da-cfbad645617e" :answer/type :answer.type/text :answer/value "$(3,1)$ only" :db/ensure [:answer/validate]} {:db/id "answer-334ca7f3-24ed-5e10-aab2-8fa9e6895014" :answer/id #uuid "334ca7f3-24ed-5e10-aab2-8fa9e6895014" :answer/type :answer.type/text :answer/value "$(\\frac{1}{2},2)$ only" :db/ensure [:answer/validate]} {:db/id "question-74d5d63f-ce92-5d6a-9703-105dc97e875a" :question/id #uuid "74d5d63f-ce92-5d6a-9703-105dc97e875a" :question/math-academy-id "q-78306" :question/problem "![](images/b7/b7ba17234415854d4d07721715ad411db6fb6c87e840193861a9b35244057416.png)\n\nUsing the graphical method, find the solutions $(x,y)$ of the following system of equations:\n\n$$\n\\{\\begin{aligned}y=f(x) \\\\ y=g(x)\\end{aligned}\n$$" :question/worked-solution "The solutions $(x,y)$ of the system correspond to the intersection points of the two curves.\n\n![](images/03/0361be3b806f4d7fdff73d913e7926ec52658652eaf88eed25bec41d5a340c06.png)\n\nFrom the graph, the curves intersect only at $(2,5).$ Therefore, this is the solution of the corresponding system." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f5e5da56-8e5c-51db-8045-74ccbacef795"] :db/ensure [:question/validate]} {:db/id "answer-field-f5e5da56-8e5c-51db-8045-74ccbacef795" :answer-field/id #uuid "f5e5da56-8e5c-51db-8045-74ccbacef795" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f78474e6-2e9b-5885-b7f3-08a8e32c28b7" :answer-field/choices ["answer-162a1e87-a1ca-5c7a-b5fe-9a2d76853ffa" "answer-f29fa8e0-2cf0-51c4-b1a8-322fdbefab1f" "answer-d1ecd0e0-aa51-51b7-b4b7-f2c004d109ba" "answer-ef5ff481-3da1-5a88-a771-8477febe4680" "answer-f78474e6-2e9b-5885-b7f3-08a8e32c28b7"] :db/ensure [:answer-field/validate]} {:db/id "answer-162a1e87-a1ca-5c7a-b5fe-9a2d76853ffa" :answer/id #uuid "162a1e87-a1ca-5c7a-b5fe-9a2d76853ffa" :answer/type :answer.type/text :answer/value "$(0,4)$ and $(2,5)$" :db/ensure [:answer/validate]} {:db/id "answer-f29fa8e0-2cf0-51c4-b1a8-322fdbefab1f" :answer/id #uuid "f29fa8e0-2cf0-51c4-b1a8-322fdbefab1f" :answer/type :answer.type/text :answer/value "$(0,4)$ only" :db/ensure [:answer/validate]} {:db/id "answer-d1ecd0e0-aa51-51b7-b4b7-f2c004d109ba" :answer/id #uuid "d1ecd0e0-aa51-51b7-b4b7-f2c004d109ba" :answer/type :answer.type/text :answer/value "$(1,2)$ and $(2,5)$" :db/ensure [:answer/validate]} {:db/id "answer-ef5ff481-3da1-5a88-a771-8477febe4680" :answer/id #uuid "ef5ff481-3da1-5a88-a771-8477febe4680" :answer/type :answer.type/text :answer/value "$(1,2)$ only" :db/ensure [:answer/validate]} {:db/id "answer-f78474e6-2e9b-5885-b7f3-08a8e32c28b7" :answer/id #uuid "f78474e6-2e9b-5885-b7f3-08a8e32c28b7" :answer/type :answer.type/text :answer/value "$(2,5)$ only" :db/ensure [:answer/validate]} {:db/id 17592186055982 :tutorial/content "Suppose we want to solve the following system of equations:\n![](images/01/01eee66dd39797b90503716f097ff604a4f339d8ea0a25ceef9b8ea7a0898ab4.svg)\n\nTo solve systems of equations *graphically*, we first draw each of the equations in the same coordinate system. Then, the solution of the system is given by the common points where the lines intersect.\n\nLet's see how this method works for the system above. To plot the functions given by the equations, we first rewrite them by making ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg) the subject in each equation.\n![](images/c7/c7778dd2c82032ef68ad8221a990abe1b2bafb4e36a7a0e2640a43856be58c5a.svg) \n\nThen, we draw the lines in the same coordinate system:\n\n![](images/47/47fb02cf8bb4668b24034302fd4265ec5261f4d244cd9d9d599afeffd91d2424.png)\n\nThe lines intersect at the point ![](images/d8/d87c68d6226f4bb9ecf52ab576a5ac45c83fbb02c83edd1af04ac235dd518467.svg), which is the solution to our system.\n\n![](images/b3/b3b95135ad9a758f891280b15e8bd6f6165bf9f47a76a1c99280af02dad78911.png)\n\nWe can also use the graphical method to solve systems of equations where the corresponding functions are not straight lines. These types of systems are called **nonlinear systems**. Let's consider such an example." :db/ensure [:tutorial/validate]} {:db/id 17592186054864 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186157457 :knowledge-point/questions ["question-5fdf7d2e-21a5-5a00-afb9-716691a79836" "question-adce0112-6117-576f-afb6-900e0d57f067"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5fdf7d2e-21a5-5a00-afb9-716691a79836" :question/id #uuid "5fdf7d2e-21a5-5a00-afb9-716691a79836" :question/math-academy-id "q-337475" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y=6\\operatorname{sinh}⁡3x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{3x})}^{′}-3(u{e}^{3x}) & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x}+3u{e}^{3x}-3u{e}^{3x} & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x}+\\cancel{3u{e}^{3x}}-\\cancel{3u{e}^{3x}} & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′}{e}^{3x} & =6\\operatorname{sinh}⁡3x \\\\ {u}^{′} & =6{e}^{-3x}\\operatorname{sinh}⁡3x\\end{aligned}\n$$\n\nUsing the fact that \n\n$$\n\\operatorname{sinh}⁡3x=\\frac{{e}^{3x}-{e}^{-3x}}{2}\n$$\n\nour equation for $u$ becomes\n\n$$\n\\begin{aligned}{u}^{′} & =6{e}^{-3x}\\operatorname{sinh}⁡3x \\\\  & =6{e}^{-3x}(\\frac{{e}^{3x}-{e}^{-3x}}{2}) \\\\  & =3{e}^{-3x}({e}^{3x}-{e}^{-3x}) \\\\  & =3-3{e}^{-6x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =3-3{e}^{-6x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 3-3{e}^{-6x}\\,\\text{d}x \\\\ u & =3x+\\frac{1}{2}{e}^{-6x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{3x} \\\\  & =3x{e}^{3x}+\\frac{1}{2}{e}^{-3x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a17ac1c5-d149-5ebf-8927-158723ddb605" "answer-field-8f2b4430-672a-5bf3-807e-80a3453382c0" "answer-field-1a7bb3c4-5f99-5055-85cf-792009ea367b"] :db/ensure [:question/validate]} {:db/id "answer-field-a17ac1c5-d149-5ebf-8927-158723ddb605" :answer-field/id #uuid "a17ac1c5-d149-5ebf-8927-158723ddb605" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-051c9750-97c1-5281-b90e-9994fbef376b" :answer-field/choices ["answer-a8312813-e54b-52a6-b6b9-51feaefb1de9" "answer-f55f4069-0947-5902-9b9e-4194006e3fe2" "answer-051c9750-97c1-5281-b90e-9994fbef376b" "answer-7f15f83b-8c0f-5827-b511-b0cca04cf4c5" "answer-c8881434-0fe7-5f65-a6ba-6bbdbf42ac37"] :db/ensure [:answer-field/validate]} {:db/id "answer-a8312813-e54b-52a6-b6b9-51feaefb1de9" :answer/id #uuid "a8312813-e54b-52a6-b6b9-51feaefb1de9" :answer/type :answer.type/math :answer/value "u(x){e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "answer-f55f4069-0947-5902-9b9e-4194006e3fe2" :answer/id #uuid "f55f4069-0947-5902-9b9e-4194006e3fe2" :answer/type :answer.type/math :answer/value "u(x){e}^{-6x}" :db/ensure [:answer/validate]} {:db/id "answer-051c9750-97c1-5281-b90e-9994fbef376b" :answer/id #uuid "051c9750-97c1-5281-b90e-9994fbef376b" :answer/type :answer.type/math :answer/value "u(x){e}^{3x}" :db/ensure [:answer/validate]} {:db/id "answer-7f15f83b-8c0f-5827-b511-b0cca04cf4c5" :answer/id #uuid "7f15f83b-8c0f-5827-b511-b0cca04cf4c5" :answer/type :answer.type/math :answer/value "u(x){e}^{6x}" :db/ensure [:answer/validate]} {:db/id "answer-c8881434-0fe7-5f65-a6ba-6bbdbf42ac37" :answer/id #uuid "c8881434-0fe7-5f65-a6ba-6bbdbf42ac37" :answer/type :answer.type/math :answer/value "u(x){e}^{9x}" :db/ensure [:answer/validate]} {:db/id "answer-field-8f2b4430-672a-5bf3-807e-80a3453382c0" :answer-field/id #uuid "8f2b4430-672a-5bf3-807e-80a3453382c0" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-8ad355eb-c779-513f-be3e-7ffebc0b039b" :answer-field/choices ["answer-bf951e29-b66d-506c-9922-457610fdd7f6" "answer-8ad355eb-c779-513f-be3e-7ffebc0b039b" "answer-9a08cb88-e308-5923-8a7a-40f0260d87f6" "answer-a2025edc-5ef5-5831-9d2e-09965e794712"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf951e29-b66d-506c-9922-457610fdd7f6" :answer/id #uuid "bf951e29-b66d-506c-9922-457610fdd7f6" :answer/type :answer.type/math :answer/value "1-\\frac{1}{2}x{e}^{-6x}" :db/ensure [:answer/validate]} {:db/id "answer-8ad355eb-c779-513f-be3e-7ffebc0b039b" :answer/id #uuid "8ad355eb-c779-513f-be3e-7ffebc0b039b" :answer/type :answer.type/math :answer/value "3x+\\frac{1}{2}{e}^{-6x}" :db/ensure [:answer/validate]} {:db/id "answer-9a08cb88-e308-5923-8a7a-40f0260d87f6" :answer/id #uuid "9a08cb88-e308-5923-8a7a-40f0260d87f6" :answer/type :answer.type/math :answer/value "3x+\\frac{1}{6}{e}^{-6x}" :db/ensure [:answer/validate]} {:db/id "answer-a2025edc-5ef5-5831-9d2e-09965e794712" :answer/id #uuid "a2025edc-5ef5-5831-9d2e-09965e794712" :answer/type :answer.type/math :answer/value "3x-\\frac{1}{2}{e}^{-6x}" :db/ensure [:answer/validate]} {:db/id "answer-field-1a7bb3c4-5f99-5055-85cf-792009ea367b" :answer-field/id #uuid "1a7bb3c4-5f99-5055-85cf-792009ea367b" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-fcd05d60-383c-5086-b2f2-a8d58e22437d" :answer-field/choices ["answer-969dac44-be6b-55c3-9e32-bc9b239ac320" "answer-fcd05d60-383c-5086-b2f2-a8d58e22437d" "answer-9cf4b20a-605e-5c2b-bb92-3273af82d50d" "answer-441fd9ba-02ad-5b58-b31f-7123f793b71d"] :db/ensure [:answer-field/validate]} {:db/id "answer-969dac44-be6b-55c3-9e32-bc9b239ac320" :answer/id #uuid "969dac44-be6b-55c3-9e32-bc9b239ac320" :answer/type :answer.type/math :answer/value "3x{e}^{-3x}+\\frac{1}{2}{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "answer-fcd05d60-383c-5086-b2f2-a8d58e22437d" :answer/id #uuid "fcd05d60-383c-5086-b2f2-a8d58e22437d" :answer/type :answer.type/math :answer/value "3x{e}^{3x}+\\frac{1}{2}{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "answer-9cf4b20a-605e-5c2b-bb92-3273af82d50d" :answer/id #uuid "9cf4b20a-605e-5c2b-bb92-3273af82d50d" :answer/type :answer.type/math :answer/value "3x{e}^{3x}-\\frac{1}{2}{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "answer-441fd9ba-02ad-5b58-b31f-7123f793b71d" :answer/id #uuid "441fd9ba-02ad-5b58-b31f-7123f793b71d" :answer/type :answer.type/math :answer/value "{e}^{3x}+\\frac{1}{2}x{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "question-adce0112-6117-576f-afb6-900e0d57f067" :question/id #uuid "adce0112-6117-576f-afb6-900e0d57f067" :question/math-academy-id "q-337526" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-4y=16\\operatorname{sinh}⁡4x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-4{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{4x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{4x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{4x})}^{′}-4(u{e}^{4x}) & =16\\operatorname{sinh}⁡4x \\\\ {u}^{′}{e}^{4x}+4u{e}^{4x}-4u{e}^{4x} & =16\\operatorname{sinh}⁡4x \\\\ {u}^{′}{e}^{4x}+\\cancel{4u{e}^{4x}}-\\cancel{4u{e}^{4x}} & =16\\operatorname{sinh}⁡4x \\\\ {u}^{′}{e}^{4x} & =16\\operatorname{sinh}⁡4x \\\\ {u}^{′} & =16{e}^{-4x}\\operatorname{sinh}⁡4x\\end{aligned}\n$$\n\nUsing the fact that \n\n$$\n\\operatorname{sinh}⁡4x=\\frac{{e}^{4x}-{e}^{-4x}}{2}\n$$\n\nour equation for $u$ becomes\n\n$$\n\\begin{aligned}{u}^{′} & =16{e}^{-4x}\\operatorname{sinh}⁡4x \\\\  & =16{e}^{-4x}(\\frac{{e}^{4x}-{e}^{-4x}}{2}) \\\\  & =8{e}^{-4x}({e}^{4x}-{e}^{-4x}) \\\\  & =8-8{e}^{-8x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =8-8{e}^{-8x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 8-8{e}^{-8x}\\,\\text{d}x \\\\ u & =8x+{e}^{-8x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{4x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{4x} \\\\  & =8x{e}^{4x}+{e}^{-4x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d9324986-dc8e-56cf-affb-81d9274ea958" "answer-field-23bc5b9e-0309-5c0f-a261-a533ceac5bb2" "answer-field-d34519d1-654b-50eb-a652-7f98090b4427"] :db/ensure [:question/validate]} {:db/id "answer-field-d9324986-dc8e-56cf-affb-81d9274ea958" :answer-field/id #uuid "d9324986-dc8e-56cf-affb-81d9274ea958" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-e228f210-a90d-5991-975d-f9c2f0b7416a" :answer-field/choices ["answer-aacafe0e-5f45-594f-af93-bbdab4f15874" "answer-df1d3c99-484f-5c4a-b945-29f6e6aaa30b" "answer-275b8a15-bc0b-5e5c-86af-632ebcfba8b9" "answer-e228f210-a90d-5991-975d-f9c2f0b7416a" "answer-a1869588-4b98-59e1-96f4-ff1a600d8834"] :db/ensure [:answer-field/validate]} {:db/id "answer-aacafe0e-5f45-594f-af93-bbdab4f15874" :answer/id #uuid "aacafe0e-5f45-594f-af93-bbdab4f15874" :answer/type :answer.type/math :answer/value "u(x){e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "answer-df1d3c99-484f-5c4a-b945-29f6e6aaa30b" :answer/id #uuid "df1d3c99-484f-5c4a-b945-29f6e6aaa30b" :answer/type :answer.type/math :answer/value "u(x){e}^{-8x}" :db/ensure [:answer/validate]} {:db/id "answer-275b8a15-bc0b-5e5c-86af-632ebcfba8b9" :answer/id #uuid "275b8a15-bc0b-5e5c-86af-632ebcfba8b9" :answer/type :answer.type/math :answer/value "u(x){e}^{12x}" :db/ensure [:answer/validate]} {:db/id "answer-e228f210-a90d-5991-975d-f9c2f0b7416a" :answer/id #uuid "e228f210-a90d-5991-975d-f9c2f0b7416a" :answer/type :answer.type/math :answer/value "u(x){e}^{4x}" :db/ensure [:answer/validate]} {:db/id "answer-a1869588-4b98-59e1-96f4-ff1a600d8834" :answer/id #uuid "a1869588-4b98-59e1-96f4-ff1a600d8834" :answer/type :answer.type/math :answer/value "u(x){e}^{8x}" :db/ensure [:answer/validate]} {:db/id "answer-field-23bc5b9e-0309-5c0f-a261-a533ceac5bb2" :answer-field/id #uuid "23bc5b9e-0309-5c0f-a261-a533ceac5bb2" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-572f375a-067a-5a7b-8a7d-bf629da1a48f" :answer-field/choices ["answer-e8298673-1ed0-5ba3-a20b-d11c59c9e2e4" "answer-f0a135e2-6bd6-52bb-b1b1-0b14d3f74e09" "answer-1de0f2ba-ffe2-5a6b-89cd-556d8f691f99" "answer-572f375a-067a-5a7b-8a7d-bf629da1a48f"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8298673-1ed0-5ba3-a20b-d11c59c9e2e4" :answer/id #uuid "e8298673-1ed0-5ba3-a20b-d11c59c9e2e4" :answer/type :answer.type/math :answer/value "1+2x{e}^{-8x}" :db/ensure [:answer/validate]} {:db/id "answer-f0a135e2-6bd6-52bb-b1b1-0b14d3f74e09" :answer/id #uuid "f0a135e2-6bd6-52bb-b1b1-0b14d3f74e09" :answer/type :answer.type/math :answer/value "1+x{e}^{-8x}" :db/ensure [:answer/validate]} {:db/id "answer-1de0f2ba-ffe2-5a6b-89cd-556d8f691f99" :answer/id #uuid "1de0f2ba-ffe2-5a6b-89cd-556d8f691f99" :answer/type :answer.type/math :answer/value "8x+2{e}^{-8x}" :db/ensure [:answer/validate]} {:db/id "answer-572f375a-067a-5a7b-8a7d-bf629da1a48f" :answer/id #uuid "572f375a-067a-5a7b-8a7d-bf629da1a48f" :answer/type :answer.type/math :answer/value "8x+{e}^{-8x}" :db/ensure [:answer/validate]} {:db/id "answer-field-d34519d1-654b-50eb-a652-7f98090b4427" :answer-field/id #uuid "d34519d1-654b-50eb-a652-7f98090b4427" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-dc95adb5-f92a-5a3d-adb4-eb25560bfcf0" :answer-field/choices ["answer-1fb39d55-b678-52fb-8de4-aaf0efa68f51" "answer-dc95adb5-f92a-5a3d-adb4-eb25560bfcf0" "answer-6b1a0ed5-39a5-5b49-889d-036a63baa72f" "answer-0d1746bc-f878-52ec-b146-aec22500c4a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-1fb39d55-b678-52fb-8de4-aaf0efa68f51" :answer/id #uuid "1fb39d55-b678-52fb-8de4-aaf0efa68f51" :answer/type :answer.type/math :answer/value "8x{e}^{4x}+2{e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "answer-dc95adb5-f92a-5a3d-adb4-eb25560bfcf0" :answer/id #uuid "dc95adb5-f92a-5a3d-adb4-eb25560bfcf0" :answer/type :answer.type/math :answer/value "8x{e}^{4x}+{e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "answer-6b1a0ed5-39a5-5b49-889d-036a63baa72f" :answer/id #uuid "6b1a0ed5-39a5-5b49-889d-036a63baa72f" :answer/type :answer.type/math :answer/value "{e}^{4x}+2x{e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "answer-0d1746bc-f878-52ec-b146-aec22500c4a5" :answer/id #uuid "0d1746bc-f878-52ec-b146-aec22500c4a5" :answer/type :answer.type/math :answer/value "{e}^{4x}+x{e}^{-4x}" :db/ensure [:answer/validate]} {:db/id 17592186157456 :knowledge-point/questions ["question-5753a7d8-bd1a-52e7-a471-c1acec6a4f75"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5753a7d8-bd1a-52e7-a471-c1acec6a4f75" :question/id #uuid "5753a7d8-bd1a-52e7-a471-c1acec6a4f75" :question/math-academy-id "q-352894" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-2y={x}^{2}.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-2{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{2x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{2x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{2x})}^{′}-2(u{e}^{2x}) & ={x}^{2} \\\\ {u}^{′}{e}^{2x}+2u{e}^{2x}-2u{e}^{2x} & ={x}^{2} \\\\ {u}^{′}{e}^{2x}+\\cancel{2u{e}^{2x}}-\\cancel{2u{e}^{2x}} & ={x}^{2} \\\\ {u}^{′}{e}^{2x} & ={x}^{2} \\\\ {u}^{′} & ={e}^{-2x}({x}^{2})\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & ={e}^{-2x}({x}^{2}) \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int {e}^{-2x}({x}^{2})\\,\\text{d}x \\\\ u & =\\int {e}^{-2x}({x}^{2})\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{2x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{2x} \\\\  & =\\int {e}^{-2x}({x}^{2})\\,\\text{d}x\\cdot {e}^{2x} \\\\  & ={e}^{2x}\\int {e}^{-2x}({x}^{2})\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fbadbf3f-b18a-5a99-9826-e9ff4c997442" "answer-field-24592161-15b0-5490-bf70-ec314dc5ab32" "answer-field-aec757a1-adaa-50b6-9d63-cc3bd102c0d3"] :db/ensure [:question/validate]} {:db/id "answer-field-fbadbf3f-b18a-5a99-9826-e9ff4c997442" :answer-field/id #uuid "fbadbf3f-b18a-5a99-9826-e9ff4c997442" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-80497a1c-8142-5bdf-a1ab-0bf6183b5f4b" :answer-field/choices ["answer-14a6edef-23b0-5485-8d01-f1b5d32f3b42" "answer-60ed5253-398b-5c0a-8f8d-ca5190048731" "answer-80497a1c-8142-5bdf-a1ab-0bf6183b5f4b" "answer-27ab71c1-e83e-5aaf-af19-b551cd5fa99d" "answer-d1bef3d2-cd60-5852-b113-b1025b37297d"] :db/ensure [:answer-field/validate]} {:db/id "answer-14a6edef-23b0-5485-8d01-f1b5d32f3b42" :answer/id #uuid "14a6edef-23b0-5485-8d01-f1b5d32f3b42" :answer/type :answer.type/math :answer/value "u(x){e}^{-2x}" :db/ensure [:answer/validate]} {:db/id "answer-60ed5253-398b-5c0a-8f8d-ca5