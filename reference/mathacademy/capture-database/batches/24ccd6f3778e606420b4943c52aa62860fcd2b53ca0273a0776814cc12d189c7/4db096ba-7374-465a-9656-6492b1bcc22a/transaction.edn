on" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3ef489de-8397-5276-8e40-3eb47ebf67b7" :answer-field/choices ["answer-5906b509-0f5b-5789-9f64-085720db0c8c" "answer-6e2302e0-f4bc-50ea-baa8-9ed96b988bd9" "answer-ae47675e-e182-568c-9d7f-237b8107f5d7" "answer-3ef489de-8397-5276-8e40-3eb47ebf67b7" "answer-bb0dcb46-938d-5272-bee5-f7421c4009e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-5906b509-0f5b-5789-9f64-085720db0c8c" :answer/id #uuid "5906b509-0f5b-5789-9f64-085720db0c8c" :answer/type :answer.type/math :answer/value "k=-1,5" :db/ensure [:answer/validate]} {:db/id "answer-6e2302e0-f4bc-50ea-baa8-9ed96b988bd9" :answer/id #uuid "6e2302e0-f4bc-50ea-baa8-9ed96b988bd9" :answer/type :answer.type/math :answer/value "k=-3,5" :db/ensure [:answer/validate]} {:db/id "answer-ae47675e-e182-568c-9d7f-237b8107f5d7" :answer/id #uuid "ae47675e-e182-568c-9d7f-237b8107f5d7" :answer/type :answer.type/math :answer/value "k=-5,-1" :db/ensure [:answer/validate]} {:db/id "answer-3ef489de-8397-5276-8e40-3eb47ebf67b7" :answer/id #uuid "3ef489de-8397-5276-8e40-3eb47ebf67b7" :answer/type :answer.type/math :answer/value "k=-5,-3" :db/ensure [:answer/validate]} {:db/id "answer-bb0dcb46-938d-5272-bee5-f7421c4009e7" :answer/id #uuid "bb0dcb46-938d-5272-bee5-f7421c4009e7" :answer/type :answer.type/math :answer/value "k=3,5" :db/ensure [:answer/validate]} {:db/id "question-2cc2023e-80ab-5c70-bfaa-8494aaa05a23" :question/id #uuid "2cc2023e-80ab-5c70-bfaa-8494aaa05a23" :question/math-academy-id "q-140126" :question/problem "Let $u=[\\begin{aligned}-2 \\\\ 5 \\\\ 7 \\\\ 5\\end{aligned}],v=[\\begin{aligned}3 \\\\ 2 \\\\ -2 \\\\ 2\\end{aligned}]$ and $w=[\\begin{aligned}0 \\\\ 2 \\\\ 0 \\\\ -3\\end{aligned}]$ be vectors such that $u\\,⊥\\,v.$ Find $(u-2v)\\cdot (v+2w).$" :question/worked-solution "Since $u$ and $v$ are orthogonal vectors, we have that $u\\cdot v=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(u-2v)\\cdot (v+2w) & =u\\cdot v-2(v\\cdot v)+2(u\\cdot w)-4(v\\cdot w) \\\\  & =0-2(v\\cdot v)+2(u\\cdot w)-4(v\\cdot w) \\\\  & =-2(3\\cdot 3+2\\cdot 2+(-2)\\cdot (-2)+2\\cdot 2) \\\\  & +2((-2)\\cdot 0+5\\cdot 2+7\\cdot 0+5\\cdot (-3)) \\\\  & -4(3\\cdot 0+2\\cdot 2+(-2)\\cdot 0+2\\cdot (-3)) \\\\  & =-2(21)+2(-5)-4(-2) \\\\  & =-42-10+8 \\\\  & =-44.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-798ee90a-3456-534c-b511-46a11430e83e"] :db/ensure [:question/validate]} {:db/id "answer-field-798ee90a-3456-534c-b511-46a11430e83e" :answer-field/id #uuid "798ee90a-3456-534c-b511-46a11430e83e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-35773d41-e18d-5fce-a034-669f53d754f0" :answer-field/choices ["answer-f914dd17-6ae2-5347-bb6e-00d10036b162" "answer-d3ab5e73-3550-5ce2-810e-1d8800b0a15b" "answer-35773d41-e18d-5fce-a034-669f53d754f0" "answer-fab371f0-ea2c-5149-a335-661af52e0fef" "answer-b40f3ee7-6d48-5c77-8c17-7b2922b35b60"] :db/ensure [:answer-field/validate]} {:db/id "answer-f914dd17-6ae2-5347-bb6e-00d10036b162" :answer/id #uuid "f914dd17-6ae2-5347-bb6e-00d10036b162" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-d3ab5e73-3550-5ce2-810e-1d8800b0a15b" :answer/id #uuid "d3ab5e73-3550-5ce2-810e-1d8800b0a15b" :answer/type :answer.type/math :answer/value "-36" :db/ensure [:answer/validate]} {:db/id "answer-35773d41-e18d-5fce-a034-669f53d754f0" :answer/id #uuid "35773d41-e18d-5fce-a034-669f53d754f0" :answer/type :answer.type/math :answer/value "-44" :db/ensure [:answer/validate]} {:db/id "answer-fab371f0-ea2c-5149-a335-661af52e0fef" :answer/id #uuid "fab371f0-ea2c-5149-a335-661af52e0fef" :answer/type :answer.type/math :answer/value "46" :db/ensure [:answer/validate]} {:db/id "answer-b40f3ee7-6d48-5c77-8c17-7b2922b35b60" :answer/id #uuid "b40f3ee7-6d48-5c77-8c17-7b2922b35b60" :answer/type :answer.type/math 