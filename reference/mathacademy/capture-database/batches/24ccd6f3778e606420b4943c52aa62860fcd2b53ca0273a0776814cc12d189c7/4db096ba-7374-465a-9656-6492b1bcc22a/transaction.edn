8ff6-30b09a2ff344" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{8}" :db/ensure [:answer/validate]} {:db/id 17592186375055 :question/problem "$$\nF(x)=\\{\\begin{aligned}-4, & x\\in [-\\frac{\\pi }{2},0) \\\\ 2\\operatorname{sin}⁡x, & x\\in [0,\\frac{\\pi }{2})\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $\\pi $-periodic extension $f(x)$ of $F(x)$ converges when $x=\\frac{\\pi }{2}.$\n\nThe Fourier series converges to {{field-1}} when $x=\\frac{\\pi }{2}.$" :db/ensure [:question/validate]} {:db/id "activity-7561226a-c4c4-531a-b031-f64d92fb4a30" :activity/id #uuid "7561226a-c4c4-531a-b031-f64d92fb4a30" :activity/title "Convergence of Fourier Series" :activity/type :activity.type/review :activity/scope 17592186050989 :activity/course 17592186046644 :activity/steps ["step-5d01adcd-f270-5af1-9222-71935e9dab45" "step-ab5a7fdd-1411-570c-8898-03bed4d4b76d" "step-05862192-baca-5966-ba59-871832f53fa7" "step-25c32ee0-cde1-52dc-a55d-04342210f54d" "step-af8c258e-ccf8-5173-8bbf-21e285594589"] :activity/first-step "step-5d01adcd-f270-5af1-9222-71935e9dab45" :db/ensure [:activity/validate]} {:db/id "step-5d01adcd-f270-5af1-9222-71935e9dab45" :step/id #uuid "5d01adcd-f270-5af1-9222-71935e9dab45" :step/content 17592186167293 :step/next "step-ab5a7fdd-1411-570c-8898-03bed4d4b76d" :db/ensure [:step/validate]} {:db/id "step-ab5a7fdd-1411-570c-8898-03bed4d4b76d" :step/id #uuid "ab5a7fdd-1411-570c-8898-03bed4d4b76d" :step/content 17592186375034 :step/next "step-05862192-baca-5966-ba59-871832f53fa7" :db/ensure [:step/validate]} {:db/id "step-05862192-baca-5966-ba59-871832f53fa7" :step/id #uuid "05862192-baca-5966-ba59-871832f53fa7" :step/content 17592186402302 :step/next "step-25c32ee0-cde1-52dc-a55d-04342210f54d" :db/ensure [:step/validate]} {:db/id "step-25c32ee0-cde1-52dc-a55d-04342210f54d" :step/id #uuid "25c32ee0-cde1-52dc-a55d-04342210f54d" :step/content "question-9ad7e028-7ba2-59c0-89a8-df18813