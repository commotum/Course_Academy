37-5381-8d15-204b6ac865ce" "answer-4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" "answer-62bb9ba1-65af-5dbd-86ad-fd392199db41"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf19757d-7c06-5aab-9d24-02031f634cd9" :answer/id #uuid "cf19757d-7c06-5aab-9d24-02031f634cd9" :answer/type :answer.type/math :answer/value "(¬P∧Q)∨R" :db/ensure [:answer/validate]} {:db/id "answer-7189fd7d-69c5-59f4-9504-860c0442c666" :answer/id #uuid "7189fd7d-69c5-59f4-9504-860c0442c666" :answer/type :answer.type/math :answer/value "(¬P∨Q)∧R" :db/ensure [:answer/validate]} {:db/id "answer-9a4ce621-af37-5381-8d15-204b6ac865ce" :answer/id #uuid "9a4ce621-af37-5381-8d15-204b6ac865ce" :answer/type :answer.type/math :answer/value "(¬P∨Q)∨R" :db/ensure [:answer/validate]} {:db/id "answer-4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" :answer/id #uuid "4617d3d0-3ffa-59f8-bebe-9f1b4563ee42" :answer/type :answer.type/math :answer/value "(¬P∨R)∧Q" :db/ensure [:answer/validate]} {:db/id "answer-62bb9ba1-65af-5dbd-86ad-fd392199db41" :answer/id #uuid "62bb9ba1-65af-5dbd-86ad-fd392199db41" :answer/type :answer.type/math :answer/value "¬P∨(Q∧R)" :db/ensure [:answer/validate]} {:db/id "activity-c1660eca-e139-5686-9782-99e1cae0d92e" :activity/id #uuid "c1660eca-e139-5686-9782-99e1cae0d92e" :activity/title "Quiz 5" :activity/type :activity.type/assessment :activity/course 17592186046658 :activity/steps ["step-773ecc3f-347e-51a4-aa4e-8e6fe98247d8" "step-2ba69236-63ce-5e86-bc2d-fc9e6a6ed08f" "step-8d34645a-0ab4-52e4-8b35-bc0e3d610aa7" "step-8fdb4546-c1ce-56f8-99f7-175189831b5c" "step-e8e35945-97d6-5cc1-b14c-bebae6d5504a" "step-33347817-cc49-5766-869f-ba7c79f13e79" "step-282fa0dd-941b-516f-838f-7d24582c01b9"] :activity/first-step "step-773ecc3f-347e-51a4-aa4e-8e6fe98247d8" :db/ensure [:activity/validate]} {:db/id "step-773ecc3f-347e-51a4-aa4e-8e6fe98247d8" :step/id #uuid "773ecc3f-347e-51a4-aa4e-8e6fe98247d8" :step/content 17592186134541 :step/next "step-2ba69236-63ce-5e86-bc2d-fc9e6a6ed08f" :db/ensure [:step/validate]} {:db/id "step-2ba69236-63ce-5e86-bc2d-fc9e6a6ed08f" :step/id #uuid "2ba69236-63ce-5e86-bc2d-fc9e6a6ed08f" :step/content "question-62a31be5-1f88-5fce-bc3d-c7a604a6e638" :step/next "step-8d34645a-0ab4-52e4-8b35-bc0e3d610aa7" :db/ensure [:step/validate]} {:db/id "step-8d34645a-0ab4-52e4-8b35-bc0e3d610aa7" :step/id #uuid "8d34645a-0ab4-52e4-8b35-bc0e3d610aa7" :step/content "question-6d3ae80f-587f-5674-9679-5efb33bf0d2c" :step/next "step-8fdb4546-c1ce-56f8-99f7-175189831b5c" :db/ensure [:step/validate]} {:db/id "step-8fdb4546-c1ce-56f8-99f7-175189831b5c" :step/id #uuid "8fdb4546-c1ce-56f8-99f7-175189831b5c" :step/content 17592186342160 :step/next "step-e8e35945-97d6-5cc1-b14c-bebae6d5504a" :db/ensure [:step/validate]} {:db/id "step-e8e35945-97d6-5cc1-b14c-bebae6d5504a" :step/id #uuid "e8e35945-97d6-5cc1-b14c-bebae6d5504a" :step/content 17592186272029 :step/next "step-33347817-cc49-5766-869f-ba7c79f13e79" :db/ensure [:step/validate]} {:db/id "step-33347817-cc49-5766-869f-ba7c79f13e79" :step/id #uuid "33347817-cc49-5766-869f-ba7c79f13e79" :step/content "question-8da6073f-aed1-5284-a635-95231dda9375" :step/next "step-282fa0dd-941b-516f-838f-7d24582c01b9" :db/ensure [:step/validate]} {:db/id "step-282fa0dd-941b-516f-838f-7d24582c01b9" :step/id #uuid "282fa0dd-941b-516f-838f-7d24582c01b9" :step/content "question-d785d990-0971-50ad-9ff0-c1525a2beb2a" :db/ensure [:step/validate]} {:db/id 17592186133771 :knowledge-point/questions ["question-2cc2023e-80ab-5c70-bfaa-8494aaa05a23"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186134208 :question/problem "Let $u=[\\begin{aligned}4 \\\\ -2 \\\\ 1 \\\\ -3\\end{aligned}],v=[\\begin{aligned}-4 \\\\ 3 \\\\ 5 \\\\ 4\\end{aligned}]$ and $w=[\\begin{aligned}2 \\\\ -5 \\\\ 7 \\\\ -3\\end{aligned}]$ be vectors such that $v$ and $w$ are orthogonal. Find $(u+9v)\\cdot w+v\\cdot (u+7w).$" :question/worked-solution "Since $v$ and $w$ are orthogonal vectors, we have that $v\\cdot w=0.$ Therefore, using linearity of the dot product to expand the parentheses, we have\n\n$$\n\\begin{aligned}(u+9v)\\cdot w+v\\cdot (u+7w) & =u\\cdot w+(9v)\\cdot w+v\\cdot u+v\\cdot (7w) \\\\  & =u\\cdot w+9(v\\cdot w)+v\\cdot u+7(v\\cdot w) \\\\  & =u\\cdot w+9\\cdot 0+v\\cdot u+7\\cdot 0 \\\\  & =u\\cdot w+v\\cdot u \\\\  & =(4\\cdot 2+(-2)\\cdot (-5)+1\\cdot 7+(-3)\\cdot (-3)) \\\\  & +((-4)\\cdot 4+3\\cdot (-2)+5\\cdot 1+4\\cdot (-3)) \\\\  & =(8+10+7+9)+(-16-6+5-12) \\\\  & =34-29 \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186131287 :answer-field/correct 17592186131292 :db/ensure [:answer-field/validate]} {:db/id 17592186133770 :knowledge-point/questions ["question-a905591c-e962-54f6-a8cc-c6c8bf83d953" "question-fff3565b-721f-5145-afe3-b8fe4b216b1a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a905591c-e962-54f6-a8cc-c6c8bf83d953" :question/id #uuid "a905591c-e962-54f6-a8cc-c6c8bf83d953" :question/math-academy-id "q-39987" :question/problem "If $u=[\\begin{aligned}1 \\\\ -3 \\\\ 2k \\\\ -2\\end{aligned}]$ and $v=[\\begin{aligned}-5 \\\\ 1 \\\\ 4 \\\\ k\\end{aligned}]$ are orthogonal vectors, then $k=$" :question/worked-solution "Since $u⊥v$, they are orthogonal vectors, we have that their dot product is equal to zero.\nFirst, let's calculate the dot product in terms of $k$:\n\n$$\n\\begin{aligned}u\\cdot v & ={u}_{1}\\cdot {v}_{1}+{u}_{2}\\cdot {v}_{2}+{u}_{3}\\cdot {v}_{3}+{u}_{4}\\cdot {v}_{4} \\\\  & =1\\cdot (-5)+(-3)\\cdot 1+2k\\cdot 4+(-2)\\cdot k \\\\  & =-5-3+8k-2k \\\\  & =6k-8\\end{aligned}\n$$\n\nEquating the dot product to zero, we have\n\n$$\n\\begin{aligned}6k-8 & =0 \\\\ 6k & =8 \\\\ k & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3235cbb9-445e-59a3-8203-e82d292f2f8e"] :db/ensure [:question/validate]} {:db/id "answer-field-3235cbb9-445e-59a3-8203-e82d292f2f8e" :answer-field/id #uuid "3235cbb9-445e-59a3-8203-e82d292f2f8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-063cd8a4-7d99-5777-9168-56c532dfaca6" :answer-field/choices ["answer-bcbec869-0470-580f-b035-e097fc54e083" "answer-7397c384-842b-5369-95fb-1b1cd887ef97" "answer-0250a6fc-047f-5134-8219-025d2c93f557" "answer-63a57dbb-d4db-55f5-9f59-2754a4ca3e84" "answer-063cd8a4-7d99-5777-9168-56c532dfaca6"] :db/ensure [:answer-field/validate]} {:db/id "answer-bcbec869-0470-580f-b035-e097fc54e083" :answer/id #uuid "bcbec869-0470-580f-b035-e097fc54e083" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-7397c384-842b-5369-95fb-1b1cd887ef97" :answer/id #uuid "7397c384-842b-5369-95fb-1b1cd887ef97" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-0250a6fc-047f-5134-8219-025d2c93f557" :answer/id #uuid "0250a6fc-047f-5134-8219-025d2c93f557" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-63a57dbb-d4db-55f5-9f59-2754a4ca3e84" :answer/id #uuid "63a57dbb-d4db-55f5-9f59-2754a4ca3e84" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-063cd8a4-7d99-5777-9168-56c532dfaca6" :answer/id #uuid "063cd8a4-7d99-5777-9168-56c532dfaca6" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id 17592186133772 :knowledge-point/questions ["question-308fc3e8-c583-59b4-999d-1160fdbc5784"] :db/ensure [:knowledge-point/validate]} {:db/id "question-308fc3e8-c583-59b4-999d-1160fdbc5784" :question/id #uuid "308fc3e8-c583-59b4-999d-1160fdbc5784" :question/math-academy-id "q-74190" :question/problem "Let $u=[\\begin{aligned}a \\\\ -1 \\\\ b \\\\ 2\\end{aligned}],v=[\\begin{aligned}2 \\\\ 4 \\\\ -2 \\\\ 5\\end{aligned}],$ and $w=[\\begin{aligned}1 \\\\ -3 \\\\ 1 \\\\ -3\\end{aligned}]$ be vectors such that $u$ is orthogonal to $v$ and $w.$ What is the value of $a-b?$" :question/worked-solution "Given that $u$ is orthogonal to $v$ and $w$, we have\n\n$$\n\\{\\begin{aligned}u\\cdot v=0 \\\\ u\\cdot w=0.\\end{aligned}\n$$\n\nLet's consider the first equation $u\\cdot v=0.$ Calculating the dot product in terms of $a$ and $b$, we get\n\n$$\n\\begin{aligned}u\\cdot v & =0 \\\\ a\\cdot 2+(-1)\\cdot 4+b\\cdot (-2)+2\\cdot 5 & =0 \\\\ 2a-4-2b+10 & =0 \\\\ 2a-2b & =-6.\\end{aligned}\n$$\n\nSimilarly, for the second equation $u\\cdot w=0$, we obtain\n\n$$\n\\begin{aligned}u\\cdot w & =0 \\\\ a\\cdot 1+(-1)\\cdot (-3)+b\\cdot 1+2\\cdot (-3) & =0 \\\\ a+3+b-6 & =0 \\\\ a+b & =3.\\end{aligned}\n$$\n\nSo, to find the values of $a$ and $b$, we need to solve the system\n\n$$\n\\{\\begin{aligned}2a-2b=-6 \\\\ a+b=3.\\end{aligned}\n$$\n\nMultiplying the second equation by $-2$ and adding the result to the first equation, we obtain\n\n$$\n-4b=-12\\,⟹\\,b=3.\n$$\n\nSubstituting $b=3$ into the first equation, we get\n\n$$\n\\begin{aligned}2a-2(3) & =-6 \\\\ 2a-6 & =-6 \\\\ 2a & =0 \\\\ a & =0.\\end{aligned}\n$$\n\nFinally, we have that\n\n$$\na-b=0-3=-3.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c7504c88-811b-566a-be94-9e43fa618465"] :db/ensure [:question/validate]} {:db/id "answer-field-c7504c88-811b-566a-be94-9e43fa618465" :answer-field/id #uuid "c7504c88-811b-566a-be94-9e43fa618465" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2e6d6850-cb8a-54f6-be70-b9a8c1c07ba7" :answer-field/choices ["answer-4bdaf9a0-53ad-54b2-b4b6-e33f7f3ff1c7" "answer-2e6d6850-cb8a-54f6-be70-b9a8c1c07ba7" "answer-8f49ce40-633b-5445-b62b-5026574b4cc0" "answer-0f1be44e-4c09-570b-900c-d5331c4a7cb2" "answer-29d501de-e778-5839-9046-8064ae32b095"] :db/ensure [:answer-field/validate]} {:db/id "answer-4bdaf9a0-53ad-54b2-b4b6-e33f7f3ff1c7" :answer/id #uuid "4bdaf9a0-53ad-54b2-b4b6-e33f7f3ff1c7" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-2e6d6850-cb8a-