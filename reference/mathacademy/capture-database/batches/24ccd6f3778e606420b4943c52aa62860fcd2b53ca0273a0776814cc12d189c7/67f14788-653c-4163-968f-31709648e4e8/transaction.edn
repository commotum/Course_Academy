a72-bb50-5a7a-a965-62ff8a107f26" "step-75507dff-4f4d-5b89-a3f1-7cd41cb6835c"] :activity/first-step "step-a64c28fc-1ca6-5640-89a6-d8051d9dde56" :db/ensure [:activity/validate]} {:db/id "step-a64c28fc-1ca6-5640-89a6-d8051d9dde56" :step/id #uuid "a64c28fc-1ca6-5640-89a6-d8051d9dde56" :step/content 17592186229740 :step/next "step-3333a917-cfff-58f6-aefa-a4cb333c9354" :db/ensure [:step/validate]} {:db/id "step-3333a917-cfff-58f6-aefa-a4cb333c9354" :step/id #uuid "3333a917-cfff-58f6-aefa-a4cb333c9354" :step/content 17592186317274 :step/next "step-0dcdb20b-ebe0-5c21-b7b8-023e7ee38c1e" :db/ensure [:step/validate]} {:db/id "step-0dcdb20b-ebe0-5c21-b7b8-023e7ee38c1e" :step/id #uuid "0dcdb20b-ebe0-5c21-b7b8-023e7ee38c1e" :step/content "question-f427f52d-d8d0-506f-a966-8597af9a76fe" :step/next "step-68e12a72-bb50-5a7a-a965-62ff8a107f26" :db/ensure [:step/validate]} {:db/id "step-68e12a72-bb50-5a7a-a965-62ff8a107f26" :step/id #uuid "68e12a72-bb50-5a7a-a965-62ff8a107f26" :step/content "question-d1348d32-c72c-5639-a597-5810a3541a7f" :step/next "step-75507dff-4f4d-5b89-a3f1-7cd41cb6835c" :db/ensure [:step/validate]} {:db/id "step-75507dff-4f4d-5b89-a3f1-7cd41cb6835c" :step/id #uuid "75507dff-4f4d-5b89-a3f1-7cd41cb6835c" :step/content "question-9876167b-d3d3-5f4c-9305-b455d21b66dc" :db/ensure [:step/validate]} {:db/id 17592186096616 :knowledge-point/questions ["question-de4c520d-e939-5935-ab41-475d00b0a086" "question-d2ff517e-a169-5a1c-9487-46b4246b351b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-de4c520d-e939-5935-ab41-475d00b0a086" :question/id #uuid "de4c520d-e939-5935-ab41-475d00b0a086" :question/math-academy-id "q-17382" :question/problem "Given that $y=3\\operatorname{ln}⁡x+2{e}^{x}$, find the slope of the tangent at $x=1.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x}+2{e}^{x}\\,.\n$$\n\nTherefore, the slope  of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{3}{x}+2{e}^{x})|}_{x=1} \\\\  & =\\frac{3}{1}+2{e}^{1} \\\\  & =3+2e\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3848e352-91c9-5cd2-91d3-3c804cea2ed3"] :db/ensure [:question/validate]} {:db/id "answer-field-3848e352-91c9-5cd2-91d3-3c804cea2ed3" :answer-field/id #uuid "3848e352-91c9-5cd2-91d3-3c804cea2ed3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-27a612df-1175-56b7-ab0d-5a99177ef558" :answer-field/choices ["answer-27db33f7-179e-55c9-8b80-bd9a663c2e69" "answer-16b0bf70-d0c6-5265-85ca-2d4c67b3b29d" "answer-27a612df-1175-56b7-ab0d-5a99177ef558" "answer-dd199b45-1cbb-5d70-a666-0e5b05022b74" "answer-1d48afac-9c4c-549b-83f2-b72451b70ea3"] :db/ensure [:answer-field/validate]} {:db/id "answer-27db33f7-179e-55c9-8b80-bd9a663c2e69" :answer/id #uuid "27db33f7-179e-55c9-8b80-bd9a663c2e69" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-16b0bf70-d0c6-5265-85ca-2d4c67b3b29d" :answer/id #uuid "16b0bf70-d0c6-5265-85ca-2d4c67b3b29d" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "answer-27a612df-1175-56b7-ab0d-5a99177ef558" :answer/id #uuid "27a612df-1175-56b7-ab0d-5a99177ef558" :answer/type :answer.type/math :answer/value "3+2e" :db/ensure [:answer/validate]} {:db/id "answer-dd199b45-1cbb-5d70-a666-0e5b05022b74" :answer/id #uuid "dd199b45-1cbb-5d70-a666-0e5b05022b74" :answer/type :answer.type/math :answer/value "\\frac{2e}{3+2e}" :db/ensure [:answer/validate]} {:db/id "answer-1d48afac-9c4c-549b-83f2-b72451b70ea3" :answer/id #uuid "1d48afac-9c4c-549b-83f2-b72451b70ea3" :answer/type :answer.type/math :answer/value "\\frac{3+2e}{2e}" :db/ensure [:answer/validate]} {:db/id 17592186096614 :knowledge-point/questions ["question-a201ee06-61a2-5773-8a24-56af686eb568"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a201ee06-61a2-5773-8a24-56af686eb568" :question/id #uuid "a201ee06-61a2-5773-8a24-56af686eb568" :question/math-academy-id "q-339978" :question/problem "Given that $y=-3\\operatorname{ln}⁡x+{10}^{x}-1$, find $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$ \n{{field-1}}" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+{10}^{x}-1) \\\\  & =-3(\\frac{1}{x})+{10}^{x}\\operatorname{ln}⁡(10) \\\\  & =-\\frac{3}{x}+{10}^{x}\\operatorname{ln}⁡(10).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5cbfb684-4d22-5eea-b2a7-3432b18ace7e"] :db/ensure [:question/validate]} {:db/id "answer-field-5cbfb684-4d22-5eea-b2a7-3432b18ace7e" :answer-field/id #uuid "5cbfb684-4d22-5eea-b2a7-3432b18ace7e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8429822b-a07a-5669-ae42-aeb9f8f5a3d8" :answer-field/choices ["answer-8429822b-a07a-5669-ae42-aeb9f8f5a3d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-8429822b-a07a-5669-ae42-aeb9f8f5a3d8" :answer/id #uuid "8429822b-a07a-5669-ae42-aeb9f8f5a3d8" :answer/type :answer.type/math :answer/value "-\\frac{3}{x}+10^x\\ln 10" :db/ensure [:answer/validate]} {:db/id "question-d2ff517e-a169-5a1c-9487-46b4246b351b" :question/id #uuid "d2ff517e-a169-5a1c-9487-46b4246b351b" :question/math-academy-id "q-340023" :question/problem "Given the function $y=-3\\operatorname{ln}⁡x+4{e}^{x},$ the slope of the tangent line at $x=1$ is{{field-1}}." :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{ln}⁡x+4{e}^{x}) \\\\  & =-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x)+4\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =-3\\cdot \\frac{1}{x}+4{e}^{x} \\\\  & =-\\frac{3}{x}+4{e}^{x}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(-\\frac{3}{x}+4{e}^{x})|}_{x=1} \\\\  & =-\\frac{3}{1}+4{e}^{1} \\\\  & =-3+4e\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-89f12e8d-bf93-5637-a264-6851084e5f96"] :db/ensure [:question/validate]} {:db/id "answer-field-89f12e8d-bf93-5637-a264-6851084e5f96" :answer-field/id #uuid "89f12e8d-bf93-5637-a264-6851084e5f96" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f716f286-0901-500a-b1e6-20a7dee63999" :answer-field/choices ["answer-f716f286-0901-500a-b1e6-20a7dee63999"] :db/ensure [:answer-field/validate]} {:db/id "answer-f716f286-0901-500a-b1e6-20a7dee63999" :answer/id #uuid "f716f286-0901-500a-b1e6-20a7dee63999" :answer/type :answer.type/math :answer/value "-3+4e" :db/ensure [:answer/validate]} {:db/id "activity-b5cb9568-f704-53f1-beaa-d5085eac04fc" :activity/id #uuid "b5cb9568-f704-53f1-beaa-d5085eac04fc" :activity/title "Differentiating Logarithmic Functions" :activity/type :activity.type/review :activity/scope 17592186050690 :activity/course 17592186046647 :activity/steps ["step-2a942685-248c-5d59-9658-99f916f859a9" "step-1d6993b8-0e14-54e1-8ab0-bf5e5194170c" "step-782e6b17-e16b-5fe8-941a-0b4c677aff59"] :activity/first-step "step-2a942685-248c-5d59-9658-99f916f859a9" :db/ensure [:activity/validate]} {:db/id "step-2a942685-248c-5d59-9658-99f916f859a9" :step/id #uuid "2a942685-248c-5d59-9658-99f916f859a9" :step/content "question-de4c520d-e939-5935-ab41-475d00b0a086" :step/next "step-1d6993b8-0e14-54e1-8ab0-bf5e5194170c" :db/ensure [:step/validate]} {:db/id "step-1d6993b8-0e14-54e1-8ab0-bf5e5194170c" :step/id #uuid "1d6993b8-0e14-54e1-8ab0-bf5e5194170c" :step/content "question-a201ee06-61a2-5773-8a24-56af686eb568" :step/next "step-782e6b17-e16b-5fe8-941a-0b4c677aff59" :db/ensure [:step/validate]} {:db/id "step-782e6b17-e16b-5fe8-941a-0b4c677aff59" :step/id #uuid "782e6b17-e16b-5fe8-941a-0b4c677aff59" :step/content "question-d2ff517e-a169-5a1c-9487-46b4246b351b" :db/ensure [:step/validate]} [:db/retract 17592186126614 :answer-field/choices 17592186126615] [:db/retract 17592186126614 :answer-field/choices 17592186126616] [:db/retract 17592186126614 :answer-field/choices 17592186126617] [:db/retract 17592186126614 :answer-field/choices 17592186126618] [:db/retract 17592186126614 :answer-field/choices 17592186126619] {:db/id 17592186129268 :knowledge-point/questions ["question-66285a95-784c-5363-bee3-101afc12cafb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129519 :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1,\\,y\\ge 0,\\,1\\le z\\le 2\\},\n$$\n\nthen ${∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V=$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/60/603dc3142d8329fd9ff9fe8d09b131fe09497405f761918d59261fde314772c6.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $1$ whose axis passes through the point $(1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z=2.$\n\nWith that in mind, let's now write the $(x-1)^{2}+{y}^{2}=1$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta -1)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta -2r\\operatorname{cos}⁡\\theta +1+{r}^{2}{sin}^{2}⁡\\theta  & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,1\\le z\\le 2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186126614 :answer-field/correct "answer-3049d143-915e-5318-81f0-56825c644df0" :answer-field/choices ["answer-26efd65d-e4b0-5765-a52f-7e5570d50b21" "answer-3049d143-915e-5318-81f0-56825c644df0" "answer-17bc181a-8974-5f88-9734-198cc3d71ac0" "answer-b5c377e8-f5a2-5500-8cd7-722a46d1c396" "answer-7ee7a4ae-58f1-55dc-93b1-0b065f6a2752"] :db/ensure [:answer-field/validate]} {:db/id "answer-26efd65d-e4b0-5765-a52f-7e5570d50b21" :answer/id #uuid "26efd65d-e4b0-5765-a52f-7e5570d50b21" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{-2\\operatorname{sin}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-3049d143-915e-5318-81f0-56825c644df0" :answer/id #uuid "3049d143-915e-5318-81f0-56825c644df0" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-17bc181a-8974-5f88-9734-198cc3d71ac0" :answer/id #uuid "17bc181a-8974-5f88-9734-198cc3d71ac0" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b5c377e8-f5a2-5500-8cd7-722a46d1c396" :answer/id #uuid "b5c377e8-f5a2-5500-8cd7-722a46d1c396" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{-\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-7ee7a4ae-58f1-55dc-93b1-0b065f6a2752" :answer/id #uuid "7ee7a4ae-58f1-55dc-93b1-0b065f6a2752" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186411857 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/02/021047e8d472a91eeeb7b45d239a1577cb7b03c873e0cb7f20ddd5ca0b69b1a3.png)\n\nThe region $R$ is a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=y+3=r\\operatorname{sin}⁡\\theta +3.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <\\frac{\\pi }{2},\\,0\\le z\\le r\\operatorname{sin}⁡\\theta +3\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}4x\\,\\text{d}V & ={∭}_{Δ}4r\\operatorname{cos}⁡\\theta \\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}{\\int }_{0}^{r\\operatorname{sin}⁡\\theta +3}4{r}^{2}\\operatorname{cos}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{2}\\operatorname{cos}⁡\\theta [z]_{z=0}^{z=r\\operatorname{sin}⁡\\theta +3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{2}\\operatorname{cos}⁡\\theta (r\\operatorname{sin}⁡\\theta +3)\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta +12{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}2{r}^{3}\\operatorname{sin}⁡2\\theta +12{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{[\\frac{1}{2}{r}^{4}\\operatorname{sin}⁡2\\theta +4{r}^{3}\\operatorname{cos}⁡\\theta ]}_{r=0}^{r=2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}(2)^{4}\\operatorname{sin}⁡2\\theta +4(2)^{3}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}8\\operatorname{sin}⁡2\\theta +32\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  \\\\  & =[-4\\operatorname{cos}⁡2\\theta +32\\operatorname{sin}⁡\\theta ]_{\\theta =0}^{\\theta =\\pi /2} \\\\  & =-4(-1-1)+32(1-0)) \\\\  & =40.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186129267 :knowledge-point/questions ["question-6699d568-4112-5bd7-abf4-a27c0cbde6ce"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6699d568-4112-5bd7-abf4-a27c0cbde6ce" :question/id #uuid "6699d568-4112-5bd7-abf4-a27c0cbde6ce" :question/math-academy-id "q-161614" :question/problem "The region $R$ is enclosed inside the cylinder ${x}^{2}+{y}^{2}=4$ for $y\\le 0,$ between the surfaces $z=0$ and $z={x}^{2}+{y}^{2}+9.$ Express the following triple integral in cylindrical polar coordinates. \n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/35/350b2dc98a09957c17f1ab629e21021c30fcccd9443068c722fe7565f04dcbfe.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z={x}^{2}+{y}^{2}+9={r}^{2}+9.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le {r}^{2}+9\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b54ca112-ae75-5f34-8db6-6d52d5ea414f"] :db/ensure [:question/validate]} {:db/id "answer-field-b54ca112-ae75-5f34-8db6-6d52d5ea414f" :answer-field/id #uuid "b54ca112-ae75-5f34-8db6-6d52d5ea414f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1210b916-b4ea-5cba-9d0b-88ffd8db5b52" :answer-field/choices ["answer-609ff4b7-e3e7-59dc-bd1a-628643aa1eef" "answer-b198dc59-a572-58ee-95d9-e619f5217eeb" "answer-8405bbf3-f8ff-5256-911f-3b037174a5a3" "answer-b3bf8739-96ec-51ef-aae4-6adf4a13a184" "answer-1210b916-b4ea-5cba-9d0b-88ffd8db5b52"] :db/ensure [:answer-field/validate]} {:db/id "answer-609ff4b7-e3e7-59dc-bd1a-628643aa1eef" :answer/id #uuid "609ff4b7-e3e7-59dc-bd1a-628643aa1eef" :answer/type :answer.type/math :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{r+9}\\frac{1}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b198dc59-a572-58ee-95d9-e619f5217eeb" :answer/id #uuid "b198dc59-a572-58ee-95d9-e619f5217eeb" :answer/type :answer.type/math :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8405bbf3-f8ff-5256-911f-3b037174a5a3" :answer/id #uuid "8405bbf3-f8ff-5256-911f-3b037174a5a3" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{r+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-b3bf8739-96ec-51ef-aae4-6adf4a13a184" :answer/id #uuid "b3bf8739-96ec-51ef-aae4-6adf4a13a184" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{1}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-1210b916-b4ea-5cba-9d0b-88ffd8db5b52" :answer/id #uuid "1210b916-b4ea-5cba-9d0b-88ffd8db5b52" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{2}{\\int }_{0}^{{r}^{2}+9}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186367701 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f4/f4c6f3acefa5d89fd5064de469952da3d68d379559bb4a6a4990a2ea24e4f861.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(0,0)$ in the $xy$-plane, and is\n\n- bounded below by  $z=\\sqrt{{x}^{2}+{y}^{2}}=\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }=r,$  and\n\n- bounded above by $z=1.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 1,\\,0\\le \\theta <2\\pi ,\\,r\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\int }_{r}^{1}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}[z]_{z=r}^{z=1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}(1-r)\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{r}^{3}-{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[\\frac{1}{4}{r}^{4}-\\frac{1}{5}{r}^{5}]}_{r=0}^{r=1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{4}-\\frac{1}{5}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{20}\\,\\text{d}\\theta  \\\\  & ={[\\frac{1}{20}\\theta ]}_{\\theta =0}^{\\theta =2\\pi } \\\\  & =\\frac{1}{20}(2\\pi -0) \\\\  & =\\frac{\\pi }{10}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-66285a95-784c-5363-bee3-101afc12cafb" :question/id #uuid "66285a95-784c-5363-bee3-101afc12cafb" :question/math-academy-id "q-161635" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y+2)^{2}\\le 4,\\,x\\ge 0,\\,0\\le z\\le \\sqrt{{x}^{2}+{y}^{2}}\\},\n$$\n\nthen ${∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V=$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/2f/2f36451290eda3db5221e1a5fdbc1647bbedafa97cd47e22d5523d457c4cb83e.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,-2)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=\\sqrt{{x}^{2}+{y}^{2}}=r.$\n\nWith that in mind, let's now write the ${x}^{2}+(y+2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta +2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +4r\\operatorname{sin}⁡\\theta +4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+4\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -4\\operatorname{sin}⁡\\theta ,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le z\\le r\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}z({x}^{2}-{y}^{2})\\,\\text{d}V & ={∭}_{Δ}z({(r\\operatorname{cos}⁡\\theta )}^{2}-{(r\\operatorname{sin}⁡\\theta )}^{2})\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}{r}^{3}z({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta )\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c3d4b2ef-ed57-5651-8502-b9160bd5e70c"] :db/ensure [:question/validate]} {:db/id "answer-field-c3d4b2ef-ed57-5651-8502-b9160bd5e70c" :answer-field/id #uuid "c3d4b2ef-ed57-5651-8502-b9160bd5e70c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a7ada78-9c1e-53ce-bfd6-73c9704db4ca" :answer-field/choices ["answer-137dcd13-d6dd-5100-aa1a-4ef83376e70e" "answer-6a7ada78-9c1e-53ce-bfd6-73c9704db4ca" "answer-9b6bc81a-88bf-5b77-b8c7-6ed75d98d631" "answer-dd82ed50-ec04-508c-a578-c8dd2bbd72c2" "answer-8156f8ac-e493-504e-aade-245eb369fa1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-137dcd13-d6dd-5100-aa1a-4ef83376e70e" :answer/id #uuid "137dcd13-d6dd-5100-aa1a-4ef83376e70e" :answer/type :answer.type/math :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{2}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6a7ada78-9c1e-53ce-bfd6-73c9704db4ca" :answer/id #uuid "6a7ada78-9c1e-53ce-bfd6-73c9704db4ca" :answer/type :answer.type/math :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-9b6bc81a-88bf-5b77-b8c7-6ed75d98d631" :answer/id #uuid "9b6bc81a-88bf-5b77-b8c7-6ed75d98d631" :answer/type :answer.type/math :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{4\\operatorname{cos}⁡\\theta }{\\int }_{0}^{r}{r}^{2}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-dd82ed50-ec04-508c-a578-c8dd2bbd72c2" :answer/id #uuid "dd82ed50-ec04-508c-a578-c8dd2bbd72c2" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-4\\operatorname{sin}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8156f8ac-e493-504e-aade-245eb369fa1a" :answer/id #uuid "8156f8ac-e493-504e-aade-245eb369fa1a" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{4\\operatorname{cos}⁡\\theta }{\\int }_{0}^{r}{r}^{3}z\\operatorname{cos}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "activity-6ab65a62-0180-5c83-b482-911736032d72" :activity/id #uuid "6ab65a62-0180-5c83-b482-911736032d72" :activity/title "Triple Integrals in Cylindrical Polar Coordinates" :activity/type :activity.type/review :activity/scope 17592186050343 :activity/course 17592186046660 :activity/steps ["step-5648bad5-7e32-562e-bd70-bbba5c57e146" "step-d7e28ed7-cdc1-5df8-ab7d-eefe1d5ae7d4" "step-be70a3f8-c406-5a9b-891c-02059ad17049" "step-22b7656d-019a-56b7-926b-93a46d02e49e" "step-367406bd-b7b5-5676-8915-81cb9f329432"] :activity/first-step "step-5648bad5-7e32-562e-bd70-bbba5c57e146" :db/ensure [:activity/validate]} {:db/id "step-5648bad5-7e32-562e-bd70-bbba5c57e146" :step/id #uuid "5648bad5-7e32-562e-bd70-bbba5c57e146" :step/content 17592186129519 :step/next "step-d7e28ed7-cdc1-5df8-ab7d-eefe1d5ae7d4" :db/ensure [:step/validate]} {:db/id "step-d7e28ed7-cdc1-5df8-ab7d-eefe1d5ae7d4" :step/id #uuid "d7e28ed7-cdc1-5df8-ab7d-eefe1d5ae7d4" :step/content 17592186411857 :step/next "step-be70a3f8-c406-5a9b-891c-02059ad17049" :db/ensure [:step/validate]} {:db/id "step-be70a3f8-c406-5a9b-891c-02059ad17049" :step/id #uuid "be70a3f8-c406-5a9b-891c-02059ad17049" :step/content "question-6699d568-4112-5bd7-abf4-a27c0cbde6ce" :step/next "step-22b7656d-019a-56b7-926b-93a46d02e49e" :db/ensure [:step/validate]} {:db/id "step-22b7656d-019a-56b7-926b-93a46d02e49e" :step/id #uuid "22b7656d-019a-56b7-926b-93a46d02e49e" :step/content 17592186367701 :step/next "step-367406bd-b7b5-5676-8915-81cb9f329432" :db/ensure [:step/validate]} {:db/id "step-367406bd-b7b5-5676-8915-81cb9f329432" :step/id #uuid "367406bd-b7b5-5676-8915-81cb9f329432" :step/content "question-66285a95-784c-5363-bee3-101afc12cafb" :db/ensure [:step/validate]} {:db/id 17592186124452 :knowledge-point/questions ["question-6491bac7-604f-53bc-80e6-378575a48cb4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124453 :knowledge-point/questions ["question-ec0d423c-ac59-5358-a37f-88f2016b24ef"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124558 :knowledge-point/questions ["question-3e84a1e0-ab07-582e-a187-ce57adaa478b" "question-cbddc293-6a3c-5b64-88ba-c447f360dc9b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124457 :knowledge-point/questions ["question-416deefa-43e7-520e-bca5-f8da057711d0" "question-585a757a-6bf9-546a-9bf9-80289d848f80"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6491bac7-604f-53bc-80e6-378575a48cb4" :question/id #uuid "6491bac7-604f-53bc-80e6-378575a48cb4" :question/math-academy-id "q-129324" :question/problem "Determine ${lim}_{x\\to (-2,0)}(2x-y+3).$" :question/worked-solution "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=2x-y+3.\n$$\n\nThe function $f(x,y)$ is continuous for all values of $x$ and $y.$ So, we can calculate the limit by substituting $(-2,0)$ into the function:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-2,0)}(2x-y+3) & =2(-2)-0+3 \\\\  & =-4-0+3 \\\\  & =-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eecb02cb-44a7-5766-9e3d-1d6dd4f8028f"] :db/ensure [:question/validate]} {:db/id "answer-field-eecb02cb-44a7-5766-9e3d-1d6dd4f8028f" :answer-field/id #uuid "eecb02cb-44a7-5766-9e3d-1d6dd4f8028f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-804fbbe3-5623-55ba-bc08-0b6088ac245d" :answer-field/choices ["answer-804fbbe3-5623-55ba-bc08-0b6088ac245d" "answer-48c22d73-cf17-502a-b856-207b42d6d523" "answer-649ec646-7b0f-548e-9c35-08857d9dbb67" "answer-b490877c-e83c-59f4-a1c9-d3fa593a9f58" "answer-ed15ba70-79a7-5e28-8379-b7e2a244dd71"] :db/ensure [:answer-field/validate]} {:db/id "answer-804fbbe3-5623-55ba-bc08-0b6088ac245d" :answer/id #uuid "804fbbe3-5623-55ba-bc08-0b6088ac245d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-48c22d73-cf17-502a-b856-207b42d6d523" :answer/id #uuid "48c22d73-cf17-502a-b856-207b42d6d523" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-649ec646-7b0f-548e-9c35-08857d9dbb67" :answer/id #uuid "649ec646-7b0f-548e-9c35-08857d9dbb67" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b490877c-e83c-59f4-a1c9-d3fa593a9f58" :answer/id #uuid "b490877c-e83c-59f4-a1c9-d3fa593a9f58" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-ed15ba70-79a7-5e28-8379-b7e2a244dd71" :answer/id #uuid "ed15ba70-79a7-5e28-8379-b7e2a244dd71" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186124937 :question/problem "Find ${lim}_{x\\to (1,1)}\\frac{{x}^{2}{y}^{2}}{{x}^{3}+{y}^{3}}.$" :question/worked-solution "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)=\\frac{{x}^{2}{y}^{2}}{{x}^{3}+{y}^{3}}.\n$$\n\nThe function $f(x,y)$ is continuous except when the denominator is zero. However, the point $(1,1)$ does not cause the denominator to vanish, so we can calculate the limit by substituting  $(1,1)$ into the function:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}\\frac{{x}^{2}{y}^{2}}{{x}^{3}+{y}^{3}}=\\frac{{1}^{2}\\cdot {1}^{2}}{{1}^{3}+{1}^{3}}=\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186122222 :answer-field/correct 17592186122223 :db/ensure [:answer-field/validate]} {:db/id 17592186125223 :question/problem "Find  ${lim}_{x\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}}=\\frac{2\\cdot 2\\cdot (-1)-(-1)\\cdot {2}^{2}}{{2}^{2}-{2}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2,-1)}\\frac{xyz-z{y}^{2}}{{y}^{2}-{x}^{2}} & ={lim}_{x\\to (2,2,-1)}\\frac{yz(x-y)}{-(x-y)(x+y)} \\\\  & ={lim}_{x\\to (2,2,-1)}\\frac{yz}{-x-y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2,-1)}\\frac{yz}{-x-y} & =\\frac{2\\cdot (-1)}{-2-2} \\\\  & =\\frac{-2}{-4} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186123938 :answer-field/correct 17592186123943 :db/ensure [:answer-field/validate]} {:db/id "question-ec0d423c-ac59-5358-a37f-88f2016b24ef" :question/id #uuid "ec0d423c-ac59-5358-a37f-88f2016b24ef" :question/math-academy-id "q-65138" :question/problem "${lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+3xy+{y}^{2}}{{x}^{3}+xy+{x}^{2}y+{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+3xy+{y}^{2}}{{x}^{3}+xy+{x}^{2}y+{y}^{2}}=\\frac{2\\cdot (-1)^{2}+3\\cdot (-1)\\cdot 1+{1}^{2}}{(-1)^{3}+(-1)\\cdot 1+(-1)^{2}\\cdot 1+{1}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by factoring the numerator and denominator and then canceling common factors:\n\n$$\n\\begin{aligned}{lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+3xy+{y}^{2}}{{x}^{3}+xy+{x}^{2}y+{y}^{2}} & ={lim}_{(x,y)\\to (-1,1)}\\frac{2{x}^{2}+2xy+xy+{y}^{2}}{{x}^{2}(x+y)+y(x+y)} \\\\  & ={lim}_{(x,y)\\to (-1,1)}\\frac{2x(x+y)+y(x+y)}{({x}^{2}+y)(x+y)} \\\\  & ={lim}_{(x,y)\\to (-1,1)}\\frac{(2x+y)(x+y)}{({x}^{2}+y)(x+y)} \\\\  & ={lim}_{(x,y)\\to (-1,1)}\\frac{2x+y}{{x}^{2}+y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{(x,y)\\to (-1,1)}\\frac{2x+y}{{x}^{2}+y} & =\\frac{2(-1)+(1)}{(-1)^{2}+1} \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-\\frac{1}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d7ebaa1a-8a6b-5d7a-acd1-3db045338942"] :db/ensure [:question/validate]} {:db/id "answer-field-d7ebaa1a-8a6b-5d7a-acd1-3db045338942" :answer-field/id #uuid "d7ebaa1a-8a6b-5d7a-acd1-3db045338942" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f3957818-b350-5503-95cc-19f562857757" :answer-field/choices ["answer-b04bbf06-0a8f-5897-8e52-3272aed01886" "answer-f3957818-b350-5503-95cc-19f562857757" "answer-55deb21b-ba9f-58dd-91dc-0aad1e32f9a2" "answer-116e62d7-9676-5ce3-b68b-c1b2b15289ab" "answer-1c785494-6256-5978-8b37-733bf1a00a68"] :db/ensure [:answer-field/validate]} {:db/id "answer-b04bbf06-0a8f-5897-8e52-3272aed01886" :answer/id #uuid "b04bbf06-0a8f-5897-8e52-3272aed01886" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-f3957818-b350-5503-95cc-19f562857757" :answer/id #uuid "f3957818-b350-5503-95cc-19f562857757" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-55deb21b-ba9f-58dd-91dc-0aad1e32f9a2" :answer/id #uuid "55deb21b-ba9f-58dd-91dc-0aad1e32f9a2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-116e62d7-9676-5ce3-b68b-c1b2b15289ab" :answer/id #uuid "116e62d7-9676-5ce3-b68b-c1b2b15289ab" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1c785494-6256-5978-8b37-733bf1a00a68" :answer/id #uuid "1c785494-6256-5978-8b37-733bf1a00a68" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-3e84a1e0-ab07-582e-a187-ce57adaa478b" :question/id #uuid "3e84a1e0-ab07-582e-a187-ce57adaa478b" :question/math-academy-id "q-74961" :question/problem "${lim}_{x\\to (3,1,2)}\\,\\frac{y-x+z}{\\sqrt{x-z}-\\sqrt{y}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (3,1,2)}\\,\\frac{y-x+z}{\\sqrt{x-z}-\\sqrt{y}}=\\frac{1-3+2}{\\sqrt{3-2}-\\sqrt{1}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (3,1,2)}\\,\\frac{y-x+z}{\\sqrt{x-z}-\\sqrt{y}} & ={lim}_{x\\to (3,1,2)}\\,\\frac{(y-x+z)(\\sqrt{x-z}+\\sqrt{y})}{(\\sqrt{x-z}-\\sqrt{y})(\\sqrt{x-z}+\\sqrt{y})} \\\\  & ={lim}_{x\\to (3,1,2)}\\,\\frac{(y-x+z)(\\sqrt{x-z}+y)}{{(\\sqrt{x-z})}^{2}-{(\\sqrt{y})}^{2}} \\\\  & ={lim}_{x\\to (3,1,2)}\\,\\frac{(y-x+z)(\\sqrt{x-z}+y)}{x-z-y} \\\\  & ={lim}_{x\\to (3,1,2)}\\,\\frac{-(x-z-y)(\\sqrt{x-z}+y)}{x-z-y} \\\\  & ={lim}_{x\\to (3,1,2)}-(\\sqrt{x-z}+y)\\end{aligned}\n$$\n\n \n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (3,1,2)}-(\\sqrt{x-z}+y) & =-(\\sqrt{3-2}+1) \\\\  & =-(1+1) \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0c29978b-66bd-5fe3-92c9-25071bfcad0d"] :db/ensure [:question/validate]} {:db/id "answer-field-0c29978b-66bd-5fe3-92c9-25071bfcad0d" :answer-field/id #uuid "0c29978b-66bd-5fe3-92c9-25071bfcad0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77866715-4a00-54a6-9bca-78618431fd9a" :answer-field/choices ["answer-77866715-4a00-54a6-9bca-78618431fd9a" "answer-d3d96702-504b-5f4f-9d1f-1e62ddfecd8b" "answer-48848976-5af9-59a1-a8d5-7f34db74d877" "answer-984fc114-e07e-535b-bbfd-cf1625fa9db5" "answer-c27ee232-913c-501f-8f38-24c7f5cfaae8"] :db/ensure [:answer-field/validate]} {:db/id "answer-77866715-4a00-54a6-9bca-78618431fd9a" :answer/id #uuid "77866715-4a00-54a6-9bca-78618431fd9a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-d3d96702-504b-5f4f-9d1f-1e62ddfecd8b" :answer/id #uuid "d3d96702-504b-5f4f-9d1f-1e62ddfecd8b" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-48848976-5af9-59a1-a8d5-7f34db74d877" :answer/id #uuid "48848976-5af9-59a1-a8d5-7f34db74d877" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-984fc114-e07e-535b-bbfd-cf1625fa9db5" :answer/id #uuid "984fc114-e07e-535b-bbfd-cf1625fa9db5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c27ee232-913c-501f-8f38-24c7f5cfaae8" :answer/id #uuid "c27ee232-913c-501f-8f38-24c7f5cfaae8" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-cbddc293-6a3c-5b64-88ba-c447f360dc9b" :question/id #uuid "cbddc293-6a3c-5b64-88ba-c447f360dc9b" :question/math-academy-id "q-129347" :question/problem "Determine ${lim}_{x\\to (9,1,3)}\\frac{x-{y}^{2}{z}^{2}}{\\sqrt{x}-yz}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (9,1,3)}\\frac{x-{y}^{2}{z}^{2}}{\\sqrt{x}-yz} & =\\frac{9-({1}^{2})({3}^{2})}{\\sqrt{9}-1(3)} \\\\  & =\\frac{9-9}{3-3} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (9,1,3)}\\frac{x-{y}^{2}{z}^{2}}{\\sqrt{x}-yz} & ={lim}_{x\\to (9,1,3)}\\frac{(x-{y}^{2}{z}^{2})(\\sqrt{x}+yz)}{(\\sqrt{x}-yz)(\\sqrt{x}+yz)} \\\\  & ={lim}_{x\\to (9,1,3)}\\frac{(x-{y}^{2}{z}^{2})(\\sqrt{x}+yz)}{x-{y}^{2}{z}^{2}} \\\\  & ={lim}_{x\\to (9,1,3)}\\frac{\\cancel{(x-{y}^{2}{z}^{2})}(\\sqrt{x}+yz)}{\\cancel{x-{y}^{2}{z}^{2}}} \\\\  & ={lim}_{x\\to (9,1,3)}(\\sqrt{x}+yz)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (9,1,3)}(\\sqrt{x}+yz) & =\\sqrt{9}+1(3) \\\\  & =3+3 \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a3985035-b9b2-56db-8d94-fdc34f531158"] :db/ensure [:question/validate]} {:db/id "answer-field-a3985035-b9b2-56db-8d94-fdc34f531158" :answer-field/id #uuid "a3985035-b9b2-56db-8d94-fdc34f531158" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-41b96b77-5e73-5c67-af13-27ac8b7eb13f" :answer-field/choices ["answer-d9bef289-3178-5ae8-94bb-0bc7078744bc" "answer-f8c561d0-62a5-54e4-bf55-93094dadec30" "answer-02f47eef-aa78-50a5-b976-e93df5f4c292" "answer-41b96b77-5e73-5c67-af13-27ac8b7eb13f" "answer-c5a30f22-3124-51ba-913f-5a068a49c15a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9bef289-3178-5ae8-94bb-0bc7078744bc" :answer/id #uuid "d9bef289-3178-5ae8-94bb-0bc7078744bc" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-f8c561d0-62a5-54e4-bf55-93094dadec30" :answer/id #uuid "f8c561d0-62a5-54e4-bf55-93094dadec30" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-02f47eef-aa78-50a5-b976-e93df5f4c292" :answer/id #uuid "02f47eef-aa78-50a5-b976-e93df5f4c292" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-41b96b77-5e73-5c67-af13-27ac8b7eb13f" :answer/id #uuid "41b96b77-5e73-5c67-af13-27ac8b7eb13f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-c5a30f22-3124-51ba-913f-5a068a49c15a" :answer/id #uuid "c5a30f22-3124-51ba-913f-5a068a49c15a" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "question-416deefa-43e7-520e-bca5-f8da057711d0" :question/id #uuid "416deefa-43e7-520e-bca5-f8da057711d0" :question/math-academy-id "q-74967" :question/problem "${lim}_{x\\to (0,0)}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-{0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the line $y=0$ (the $x$-axis),  we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=0}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2\\cdot {0}^{2}}{2{x}^{2}-{0}^{2}} \\\\  & ={lim}_{x\\to 0}\\,0 \\\\  & =0.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{y}^{2}}{2{x}^{2}-{y}^{2}}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a63c1194-144a-5227-ac9c-0935b59c5eb5"] :db/ensure [:question/validate]} {:db/id "answer-field-a63c1194-144a-5227-ac9c-0935b59c5eb5" :answer-field/id #uuid "a63c1194-144a-5227-ac9c-0935b59c5eb5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2776b54f-1b5d-5a24-9264-60188b98a30d" :answer-field/choices ["answer-91e130a9-184e-5357-91fa-a31e71ffed64" "answer-47a3084a-dea7-5252-a052-f22a8d9afbb1" "answer-9b09b8cb-03b3-5495-a712-64af8592a360" "answer-8e2058cc-d3ee-5a9d-abaa-0c2aab0fc895" "answer-2776b54f-1b5d-5a24-9264-60188b98a30d"] :db/ensure [:answer-field/validate]} {:db/id "answer-91e130a9-184e-5357-91fa-a31e71ffed64" :answer/id #uuid "91e130a9-184e-5357-91fa-a31e71ffed64" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-47a3084a-dea7-5252-a052-f22a8d9afbb1" :answer/id #uuid "47a3084a-dea7-5252-a052-f22a8d9afbb1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-9b09b8cb-03b3-5495-a712-64af8592a360" :answer/id #uuid "9b09b8cb-03b3-5495-a712-64af8592a360" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-8e2058cc-d3ee-5a9d-abaa-0c2aab0fc895" :answer/id #uuid "8e2058cc-d3ee-5a9d-abaa-0c2aab0fc895" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-2776b54f-1b5d-5a24-9264-60188b98a30d" :answer/id #uuid "2776b54f-1b5d-5a24-9264-60188b98a30d" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-585a757a-6bf9-546a-9bf9-80289d848f80" :question/id #uuid "585a757a-6bf9-546a-9bf9-80289d848f80" :question/math-academy-id "q-74968" :question/problem "${lim}_{x\\to (0,0)}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}}=\\frac{0\\cdot 0}{2\\cdot {0}^{2}+3\\cdot {0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{{x}^{2}}{2{x}^{2}+3{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{{x}^{2}}{5{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{1}{5} \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the line $y=-x$,  we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=-x}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{-{x}^{2}}{2{x}^{2}+3{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{-{x}^{2}}{5{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,(-\\frac{1}{5}) \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{xy}{2{x}^{2}+3{y}^{2}}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f1873304-acce-598c-9592-a96cff0a14c5"] :db/ensure [:question/validate]} {:db/id "answer-field-f1873304-acce-598c-9592-a96cff0a14c5" :answer-field/id #uuid "f1873304-acce-598c-9592-a96cff0a14c5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c7cccb62-ae0c-505e-946a-32fd9dfe1c5b" :answer-field/choices ["answer-b3785525-f411-5114-943e-5a2cf050adfb" "answer-24c334b8-5f64-5024-8be8-3440026a135f" "answer-b689f50d-16ad-525a-aff0-c88e838473ce" "answer-d4522578-3775-5aa6-9639-2a945876ec85" "answer-c7cccb62-ae0c-505e-946a-32fd9dfe1c5b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3785525-f411-5114-943e-5a2cf050adfb" :answer/id #uuid "b3785525-f411-5114-943e-5a2cf050adfb" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-24c334b8-5f64-5024-8be8-3440026a135f" :answer/id #uuid "24c334b8-5f64-5024-8be8-3440026a135f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b689f50d-16ad-525a-aff0-c88e838473ce" :answer/id #uuid "b689f50d-16ad-525a-aff0-c88e838473ce" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d4522578-3775-5aa6-9639-2a945876ec85" :answer/id #uuid "d4522578-3775-5aa6-9639-2a945876ec85" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-c7cccb62-ae0c-505e-946a-32fd9dfe1c5b" :answer/id #uuid "c7cccb62-ae0c-505e-946a-32fd9dfe1c5b" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} [:db/retract 17592186177549 :answer-field/choices 17592186177553] {:db/id 17592186179723 :knowledge-point/questions ["question-7147d280-b22a-57e1-b370-a9886ed9abe3" "question-f1be0d7b-0db0-5190-8f45-38feec497f84"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179720 :knowledge-point/questions ["question-d8715c2d-ca5b-51c2-9a33-2dfd408c50a1" "question-cc3f1bc7-f9c3-504a-985e-91fc4c5b8f28" "question-6f562602-9739-513b-8ce5-9ee1b6ec86ba"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179721 :knowledge-point/questions ["question-dc9a0f07-fee9-5b1d-8ce4-fb565f5e676a" "question-05eaf340-4492-5bdf-bad0-8c07f4ea4867" "question-a66dfc35-4f40-599b-91f5-fb79cdcce84b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7147d280-b22a-57e1-b370-a9886ed9abe3" :question/id #uuid "7147d280-b22a-57e1-b370-a9886ed9abe3" :question/math-academy-id "q-122939" :question/problem "Which of the following are partitions of the real interval $[3,9]?$\n\nI. $\\{3,5,8,9\\}$\n\nII. $3<4<6<7<8$\n\nIII. $\\{1,3,4,8,9\\}$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[3,9].$\n\n- Statement II is not a partition of $[3,9]$  since it does not include the right endpoint $b=9.$\n\n- Statement III is not a partition of $[3,9]$ since $1$ does not belong to $[3,9].$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-319bb08e-4683-5c08-aab9-56b1c9e9788e"] :db/ensure [:question/validate]} {:db/id "answer-field-319bb08e-4683-5c08-aab9-56b1c9e9788e" :answer-field/id #uuid "319bb08e-4683-5c08-aab9-56b1c9e9788e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1ce56cc-ee25-5c68-bd33-78072ae13ee3" :answer-field/choices ["answer-f1ce56cc-ee25-5c68-bd33-78072ae13ee3" "answer-5af6f2ec-1bb5-53de-8834-b73287f1f358" "answer-07280aa0-0a15-5cad-b859-df57e9aa3811" "answer-b86248a1-8983-58de-bd4b-152b44d11496" "answer-28820aa3-a522-5b90-866a-f41417cccf71"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1ce56cc-ee25-5c68-bd33-78072ae13ee3" :answer/id #uuid "f1ce56cc-ee25-5c68-bd33-78072ae13ee3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-5af6f2ec-1bb5-53de-8834-b73287f1f358" :answer/id #uuid "5af6f2ec-1bb5-53de-8834-b73287f1f358" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-07280aa0-0a15-5cad-b859-df57e9aa3811" :answer/id #uuid "07280aa0-0a15-5cad-b859-df57e9aa3811" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-b86248a1-8983-58de-bd4b-152b44d11496" :answer/id #uuid "b86248a1-8983-58de-bd4b-152b44d11496" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-28820aa3-a522-5b90-866a-f41417cccf71" :answer/id #uuid "28820aa3-a522-5b90-866a-f41417cccf71" :answer/type :answer.type/text :answer/value "None of the statements give a partition of $[3,9]$" :db/ensure [:answer/validate]} {:db/id "question-f1be0d7b-0db0-5190-8f45-38feec497f84" :question/id #uuid "f1be0d7b-0db0-5190-8f45-38feec497f84" :question/math-academy-id "q-122927" :question/problem "Which of the following are partitions of the real interval $[0,9]?$\n\nI. $1<5<9$\n\nII. $0<5<7<9<10$\n\nIII. $\\{0,1,2,6,8,9\\}$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[0,9]$ since it does not include the left endpoint $a=0.$\n\n- Statement II is not a partition of $[0,9]$ since $10$ does not belong to $[0,9].$\n\n- Statement III is a partition of $[0,9].$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6f92f0b4-0a41-57e7-a39d-64357b2aae64"] :db/ensure [:question/validate]} {:db/id "answer-field-6f92f0b4-0a41-57e7-a39d-64357b2aae64" :answer-field/id #uuid "6f92f0b4-0a41-57e7-a39d-64357b2aae64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd21c562-ed67-5570-a203-81f2c562ff91" :answer-field/choices ["answer-a2db442f-009d-59c4-83fb-5b0ac675dabe" "answer-b03c8658-e3d9-5a74-88b7-3be40d508f45" "answer-81dcfe51-ff64-5d71-bcd4-185222abe7c6" "answer-fd21c562-ed67-5570-a203-81f2c562ff91" "answer-0637e47d-67c0-5502-84f3-9b0174a432bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2db442f-009d-59c4-83fb-5b0ac675dabe" :answer/id #uuid "a2db442f-009d-59c4-83fb-5b0ac675dabe" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-b03c8658-e3d9-5a74-88b7-3be40d508f45" :answer/id #uuid "b03c8658-e3d9-5a74-88b7-3be40d508f45" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-81dcfe51-ff64-5d71-bcd4-185222abe7c6" :answer/id #uuid "81dcfe51-ff64-5d71-bcd4-185222abe7c6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-fd21c562-ed67-5570-a203-81f2c562ff91" :answer/id #uuid "fd21c562-ed67-5570-a203-81f2c562ff91" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-0637e47d-67c0-5502-84f3-9b0174a432bf" :answer/id #uuid "0637e47d-67c0-5502-84f3-9b0174a432bf" :answer/type :answer.type/text :answer/value "None of the statements give a partition of $[0,9]$" :db/ensure [:answer/validate]} {:db/id 17592186179980 :question/problem "Which of the following are partitions of the real interval $[-2,6]?$\n\nI. $\\{-2,-1,0,6\\}$\n\nII. $\\{0,2,4,6\\}$\n\nIII. $-2<2<4<5$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP=\\{{x}_{0},{x}_{1},…,{x}_{n}\\}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[-2,6].$\n\n- Statement II is not a partition of $[-2,6]$ since it does not include the left endpoint $a=-2.$\n\n- Statement III is not a partition of $[-2,6]$ since it does not include the right endpoint $b=6.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186177549 :answer-field/correct 17592186177550 :answer-field/choices ["answer-dd41f658-680c-5ade-9061-774bf59f8a78"] :db/ensure [:answer-field/validate]} {:db/id "answer-dd41f658-680c-5ade-9061-774bf59f8a78" :answer/id #uuid "dd41f658-680c-5ade-9061-774bf59f8a78" :answer/type :answer.type/text :answer/value "None of the statements give a partition of $[-2,6]$" :db/ensure [:answer/validate]} {:db/id "question-d8715c2d-ca5b-51c2-9a33-2dfd408c50a1" :question/id #uuid "d8715c2d-ca5b-51c2-9a33-2dfd408c50a1" :question/math-academy-id "q-122974" :question/problem "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[5,14].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}-2Δ{y}_{j}.$" :question/worked-solution "First, we take the factor $(-2)$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}-2Δ{y}_{j}=-2{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[5,14],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =14-5 \\\\  & =9.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n-2{\\sum }_{j=1}^{n}Δ{y}_{j}=(-2)\\cdot 9=-18.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-40d499b8-83d9-584d-a15f-d8ff66161865"] :db/ensure [:question/validate]} {:db/id "answer-field-40d499b8-83d9-584d-a15f-d8ff66161865" :answer-field/id #uuid "40d499b8-83d9-584d-a15f-d8ff66161865" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0b294371-d2cf-5786-a52b-a3ec80e77916" :answer-field/choices ["answer-23d6fb4a-c0e9-550f-9034-f8e548969d25" "answer-0b294371-d2cf-5786-a52b-a3ec80e77916" "answer-0466c30e-087e-59ca-a910-d62dd06529b1" "answer-e25bea0f-811e-5d97-897e-71ff469847f3" "answer-ce7b67e1-c08a-5ac9-b206-ac3755f0d0e0"] :db/ensure [:answer-field/validate]} {:db/id "answer-23d6fb4a-c0e9-550f-9034-f8e548969d25" :answer/id #uuid "23d6fb4a-c0e9-550f-9034-f8e548969d25" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-0b294371-d2cf-5786-a52b-a3ec80e77916" :answer/id #uuid "0b294371-d2cf-5786-a52b-a3ec80e77916" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "answer-0466c30e-087e-59ca-a910-d62dd06529b1" :answer/id #uuid "0466c30e-087e-59ca-a910-d62dd06529b1" :answer/type :answer.type/math :answer/value "-21" :db/ensure [:answer/validate]} {:db/id "answer-e25bea0f-811e-5d97-897e-71ff469847f3" :answer/id #uuid "e25bea0f-811e-5d97-897e-71ff469847f3" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-ce7b67e1-c08a-5ac9-b206-ac3755f0d0e0" :answer/id #uuid "ce7b67e1-c08a-5ac9-b206-ac3755f0d0e0" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "question-cc3f1bc7-f9c3-504a-985e-91fc4c5b8f28" :question/id #uuid "cc3f1bc7-f9c3-504a-985e-91fc4c5b8f28" :question/math-academy-id "q-122970" :question/problem "Let $P=\\{{z}_{0},{z}_{1},…,{z}_{q}\\}$ be a partition of the interval $[-1,5].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}Δ{z}_{k}.$" :question/worked-solution "Note that ${\\sum }_{k=1}^{q}Δ{z}_{k}$ is just the length of the interval $[-1,5],$ because\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}Δ{z}_{k} & =({z}_{1}-{z}_{0})+({z}_{2}-{z}_{1})+({z}_{3}-{z}_{2})+⋯+({z}_{q}-{z}_{q-1}) \\\\  & =(\\cancel{{z}_{1}}-{z}_{0})+(\\cancel{{z}_{2}}-\\cancel{{z}_{1}})+(\\cancel{{z}_{3}}-\\cancel{{z}_{2}})+⋯+({z}_{q}-\\cancel{{z}_{q-1}}) \\\\  & =-{z}_{0}+{z}_{q} \\\\  & ={z}_{q}-{z}_{0} \\\\  & =5-(-1) \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-22ae7436-4bbe-5fcc-854f-c0169c08414a"] :db/ensure [:question/validate]} {:db/id "answer-field-22ae7436-4bbe-5fcc-854f-c0169c08414a" :answer-field/id #uuid "22ae7436-4bbe-5fcc-854f-c0169c08414a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-73462704-1981-5028-8fec-c5d6dc17e1c0" :answer-field/choices ["answer-bc9994d7-bf6e-5198-81f7-14cfcc3177be" "answer-57339cd1-2256-5617-8f6c-982e93fc9118" "answer-56421b11-be0b-5c59-ba07-4a27ea12aeb0" "answer-73462704-1981-5028-8fec-c5d6dc17e1c0" "answer-bedeea4f-2a49-56fe-a4fe-32e000846cf5"] :db/ensure [:answer-field/validate]} {:db/id "answer-bc9994d7-bf6e-5198-81f7-14cfcc3177be" :answer/id #uuid "bc9994d7-bf6e-5198-81f7-14cfcc3177be" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-57339cd1-2256-5617-8f6c-982e93fc9118" :answer/id #uuid "57339cd1-2256-5617-8f6c-982e93fc9118" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-56421b11-be0b-5c59-ba07-4a27ea12aeb0" :answer/id #uuid "56421b11-be0b-5c59-ba07-4a27ea12aeb0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-73462704-1981-5028-8fec-c5d6dc17e1c0" :answer/id #uuid "73462704-1981-5028-8fec-c5d6dc17e1c0" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-bedeea4f-2a49-56fe-a4fe-32e000846cf5" :answer/id #uuid "bedeea4f-2a49-56fe-a4fe-32e000846cf5" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-6f562602-9739-513b-8ce5-9ee1b6ec86ba" :question/id #uuid "6f562602-9739-513b-8ce5-9ee1b6ec86ba" :question/math-academy-id "q-122978" :question/problem "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[-8,-1].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}6Δ{y}_{j}.$" :question/worked-solution "First, we take the factor $6$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}6Δ{y}_{j}=6{\\sum }_{j=1}^{n}Δ{y}_{j}\\end{aligned}\n$$\n\nNote that ${\\sum }_{j=1}^{n}Δ{y}_{j}$ is just the length of the interval $[-8,-1],$ because\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}Δ{y}_{j} & =({y}_{1}-{y}_{0})+({y}_{2}-{y}_{1})+({y}_{3}-{y}_{2})+⋯+({y}_{n}-{y}_{n-1}) \\\\  & =(\\cancel{{y}_{1}}-{y}_{0})+(\\cancel{{y}_{2}}-\\cancel{{y}_{1}})+(\\cancel{{y}_{3}}-\\cancel{{y}_{2}})+⋯+({y}_{n}-\\cancel{{y}_{n-1}}) \\\\  & =-{y}_{0}+{y}_{n} \\\\  & ={y}_{n}-{y}_{0} \\\\  & =(-1)-(-8) \\\\  & =8-1 \\\\  & =7.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n6{\\sum }_{j=1}^{n}Δ{y}_{j}=6\\cdot 7=42.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0711e56e-0fef-5c4e-9ebf-c65efa6dc178"] :db/ensure [:question/validate]} {:db/id "answer-field-0711e56e-0fef-5c4e-9ebf-c65efa6dc178" :answer-field/id #uuid "0711e56e-0fef-5c4e-9ebf-c65efa6dc178" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e771eb07-8276-52c9-b71a-3b4a1e9b2424" :answer-field/choices ["answer-6793c687-c2b2-5217-9580-14080fc036ee" "answer-e771eb07-8276-52c9-b71a-3b4a1e9b2424" "answer-e32e7705-3634-5ead-a672-a3f47e684868" "answer-89411040-8795-5cdc-afcb-a6a871e66201" "answer-00e7e2b7-5333-519e-b710-29aad16267c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-6793c687-c2b2-5217-9580-14080fc036ee" :answer/id #uuid "6793c687-c2b2-5217-9580-14080fc036ee" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-e771eb07-8276-52c9-b71a-3b4a1e9b2424" :answer/id #uuid "e771eb07-8276-52c9-b71a-3b4a1e9b2424" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "answer-e32e7705-3634-5ead-a672-a3f47e684868" :answer/id #uuid "e32e7705-3634-5ead-a672-a3f47e684868" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "answer-89411040-8795-5cdc-afcb-a6a871e66201" :answer/id #uuid "89411040-8795-5cdc-afcb-a6a871e66201" :answer/type :answer.type/math :answer/value "49" :db/ensure [:answer/validate]} {:db/id "answer-00e7e2b7-5333-519e-b710-29aad16267c0" :answer/id #uuid "00e7e2b7-5333-519e-b710-29aad16267c0" :answer/type :answer.type/math :answer/value "54" :db/ensure [:answer/validate]} {:db/id 17592186179978 :question/problem "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[0,4].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}8({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{j=1}^{n}8({y}_{j}+{y}_{j-1})Δ{y}_{j}=8{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=0$ and ${y}_{n}=4$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={4}^{2}-{0}^{2} \\\\  & =16.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n8{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=8\\cdot 16=128.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186177537 :answer-field/correct 17592186177541 :db/ensure [:answer-field/validate]} {:db/id "question-dc9a0f07-fee9-5b1d-8ce4-fb565f5e676a" :question/id #uuid "dc9a0f07-fee9-5b1d-8ce4-fb565f5e676a" :question/math-academy-id "q-122990" :question/problem "Let $P=\\{{y}_{0},{y}_{1},…,{y}_{n}\\}$ be a partition of the interval $[1,5].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}3({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{j=1}^{n}3({y}_{j}+{y}_{j-1})Δ{y}_{j}=3{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=1$ and ${y}_{n}=5$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={5}^{2}-{1}^{2} \\\\  & =24.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n3{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=3\\cdot 24=72.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-019097f3-fdab-5454-bc86-1d21ce7596c8"] :db/ensure [:question/validate]} {:db/id "answer-field-019097f3-fdab-5454-bc86-1d21ce7596c8" :answer-field/id #uuid "019097f3-fdab-5454-bc86-1d21ce7596c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-deb437d9-0c5c-5360-9b95-1de1be05df9d" :answer-field/choices ["answer-568b639c-1df2-5465-ae3f-cab03875fcc9" "answer-73360c2e-e156-5ffa-be8e-de6002887e7b" "answer-6bac9d9b-f57a-5238-be05-6cf4c551208f" "answer-deb437d9-0c5c-5360-9b95-1de1be05df9d" "answer-68f15989-0de0-53f1-af30-851ceb992d05"] :db/ensure [:answer-field/validate]} {:db/id "answer-568b639c-1df2-5465-ae3f-cab03875fcc9" :answer/id #uuid "568b639c-1df2-5465-ae3f-cab03875fcc9" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-73360c2e-e156-5ffa-be8e-de6002887e7b" :answer/id #uuid "73360c2e-e156-5ffa-be8e-de6002887e7b" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "answer-6bac9d9b-f57a-5238-be05-6cf4c551208f" :answer/id #uuid "6bac9d9b-f57a-5238-be05-6cf4c551208f" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "answer-deb437d9-0c5c-5360-9b95-1de1be05df9d" :answer/id #uuid "deb437d9-0c5c-5360-9b95-1de1be05df9d" :answer/type :answer.type/math :answer/value "72" :db/ensure [:answer/validate]} {:db/id "answer-68f15989-0de0-53f1-af30-851ceb992d05" :answer/id #uuid "68f15989-0de0-53f1-af30-851ceb992d05" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id "question-05eaf340-4492-5bdf-bad0-8c07f4ea4867" :question/id #uuid "05eaf340-4492-5bdf-bad0-8c07f4ea4867" :question/math-academy-id "q-122991" :question/problem "Let $P=\\{{x}_{0},{x}_{1},…,{x}_{m}\\}$ be a partition of the interval $[1,3].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}5({x}_{i}+{x}_{i-1})Δ{x}_{i}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}5({x}_{i}+{x}_{i-1})Δ{x}_{i}=5{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}.\n$$\n\nWe can simplify the summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & =({x}_{1}+{x}_{0})Δ{x}_{1}+({x}_{2}+{x}_{1})Δ{x}_{2}+⋯+({x}_{m}+{x}_{m-1})Δ{x}_{m} \\\\  & =({x}_{1}+{x}_{0})({x}_{1}-{x}_{0})+({x}_{2}+{x}_{1})({x}_{2}-{x}_{1})+⋯+({x}_{m}+{x}_{m-1})({x}_{m}-{x}_{m-1}) \\\\  & =({x}_{1}^{2}-{x}_{0}^{2})+({x}_{2}^{2}-{x}_{1}^{2})+⋯+({x}_{m}^{2}-{x}_{m-1}^{2}) \\\\  & =(\\cancel{{x}_{1}^{2}}-{x}_{0}^{2})+(\\cancel{{x}_{2}^{2}}-\\cancel{{x}_{1}^{2}})+⋯+({x}_{m}^{2}-\\cancel{{x}_{m-1}^{2}}) \\\\  & =-{x}_{0}^{2}+{x}_{m}^{2} \\\\  & ={x}_{m}^{2}-{x}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${x}_{0}=1$ and ${x}_{m}=3$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i} & ={x}_{m}^{2}-{x}_{0}^{2} \\\\  & ={3}^{2}-{1}^{2} \\\\  & =8.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n5{\\sum }_{i=1}^{m}({x}_{i}+{x}_{i-1})Δ{x}_{i}=5\\cdot 8=40.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6bc2b85d-9cd8-5e64-a647-58d882625bef"] :db/ensure [:question/validate]} {:db/id "answer-field-6bc2b85d-9cd8-5e64-a647-58d882625bef" :answer-field/id #uuid "6bc2b85d-9cd8-5e64-a647-58d882625bef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91fb9dca-7989-55a5-9a68-0b46baa2c599" :answer-field/choices ["answer-34bce388-8a83-530c-8716-465e9c3dc065" "answer-5469ea0b-1a7d-5c68-80b4-70b7cbf036cc" "answer-8819dcf4-13cd-534f-9ba0-5764e2cf7081" "answer-91fb9dca-7989-55a5-9a68-0b46baa2c599" "answer-54d4ac3d-bde5-557b-bc85-c76af89abd05"] :db/ensure [:a