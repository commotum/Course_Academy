393902-7f32-566b-b8b1-1ba0ecc047ce" :step/content "question-a275c58b-24cd-59ec-af04-d47c2cd4c395" :step/next "step-ff60ef8b-6d6e-5dfc-8313-798cacb1cd63" :db/ensure [:step/validate]} {:db/id "step-ff60ef8b-6d6e-5dfc-8313-798cacb1cd63" :step/id #uuid "ff60ef8b-6d6e-5dfc-8313-798cacb1cd63" :step/content "question-5cd68e49-7c20-564f-9257-0043b16b7cd5" :db/ensure [:step/validate]} {:db/id 17592186096753 :knowledge-point/questions ["question-5eb29534-af26-5796-a547-b3d37b08dcde"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5eb29534-af26-5796-a547-b3d37b08dcde" :question/id #uuid "5eb29534-af26-5796-a547-b3d37b08dcde" :question/math-academy-id "q-81915" :question/problem "![](images/8f/8f4a991a9da8b339bf2af1085787ba18227ee0926b1c280d8f3173f86c0713c8.png)\n\nCalculate the height $h$ of the cylinder above given that its volume is $32\\pi \\,{\\text{m}}^{3}$ and its radius is $2\\,\\text{m}.$" :question/worked-solution "The volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nSubstituting $V=32\\pi \\,{\\text{m}}^{3}$ and $r=2\\,\\text{m}$ into the formula and solving for $r,$ we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ 32\\pi  & =\\pi (2)^{2}h \\\\ 4\\pi h & =32\\pi  \\\\ h & =8\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e0b91d38-c85a-5ca6-b1d0-07bdd6a02bc7"] :db/ensure [:question/validate]} {:db/id "answer-field-e0b91d38-c85a-5ca6-b1d0-07bdd6a02bc7" :answer-field/id #uuid "e0b91d38-c85a-5ca6-b1d0-07bdd6a02bc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f05222b-ffc2-508d-b319-7b3440be97a0" :answer-field/choices ["answer-ef173a09-7b32-5954-b935-8bfb00ab0876" "answer-a12b3df0-bdc0-5e40-9e2a-234f91f81889" "answer-521b3deb-98a0-5aac-88d4-88a41b70ad08" "answer-9c9189d0-29f7-57e1-8870-d9a3b7c5dec5" "answer-3f05222b-ffc2-508d-b319-7b3440be97a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef173a09-7b32-5954-b935-8bfb00ab0876" :answer/id #uuid "ef173a09-7b32-5954-b935-8bfb00ab0876" :answer/type :answer.type/math :answer/value "10\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-a12b3df0-bdc0-5e40-9e2a-234f91f81889" :answer/id #uuid "a12b3df0-bdc0-5e40-9e2a-234f91f81889" :answer/type :answer.type/math :answer/value "12\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-521b3deb-98a0-5aac-88d4-88a41b70ad08" :answer/id #uuid "521b3deb-98a0-5aac-88d4-88a41b70ad08" :answer/type :answer.type/math :answer/value "16\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-9c9189d0-29f7-57e1-8870-d9a3b7c5dec5" :answer/id #uuid "9c9189d0-29f7-57e1-8870-d9a3b7c5dec5" :answer/type :answer.type/math :answer/value "6\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-3f05222b-ffc2-508d-b319-7b3440be97a0" :answer/id #uuid "3f05222b-ffc2-508d-b319-7b3440be97a0" :answer/type :answer.type/math :answer/value "8\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186096755 :knowledge-point/questions ["question-b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" "question-f5dc2452-94d3-5570-b907-2fef94df0654"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" :question/id #uuid "b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" :question/math-academy-id "q-82230" :question/problem "Find an expression for the volume $V$ of a cylinder in terms of $r$ given that $\\frac{r}{h}=7,$ where $r$ is the radius of the base and $h$ is the height of the cylinder." :question/worked-solution "Our goal is to express $V$ in terms of $r.$ Therefore, we need to isolate $h$ in the above equation:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =7 \\\\ r & =7h \\\\ \\frac{r}{7} & =h \\\\ h & =\\frac{r}{7}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $h=\\frac{r}{7}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\  & =\\pi {r}^{2}\\cdot \\frac{r}{7} \\\\  & =\\frac{\\pi {r}^{3}}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c832f4c5-f92a-5365-ab96-cf109440464a"] :db/ensure [:question/validate]} {:db/id "answer-field-c832f4c5-f92a-5365-ab96-cf109440464a" :answer-field/id #uuid "c832f4c5-f92a-5365-ab96-cf109440464a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2" :answer-field/choices ["answer-11f8333c-e93a-5108-b3b7-ab45006d5420" "answer-212bb867-70af-5f7b-a414-5e31d4b0b6db" "answer-9673114b-bd22-5fb9-ad53-02a14467bfd5" "answer-88cce9ed-686f-55ba-94f1-65f657182f53" "answer-5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-11f8333c-e93a-5108-b3b7-ab45006d5420" :answer/id #uuid "11f8333c-e93a-5108-b3b7-ab45006d5420" :answer/type :answer.type/math :answer/value "V=49\\pi {r}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-212bb867-70af-5f7b-a414-5e31d4b0b6db" :answer/id #uuid "212bb867-70af-5f7b-a414-5e31d4b0b6db" :answer/type :answer.type/math :answer/value "V=7\\pi {r}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-9673114b-bd22-5fb9-ad53-02a14467bfd5" :answer/id #uuid "9673114b-bd22-5fb9-ad53-02a14467bfd5" :answer/type :answer.type/math :answer/value "V=\\frac{\\pi {r}^{3}}{14}" :db/ensure [:answer/validate]} {:db/id "answer-88cce9ed-686f-55ba-94f1-65f657182f53" :answer/id #uuid "88cce9ed-686f-55ba-94f1-65f657182f53" :answer/type :answer.type/math :answer/value "V=\\frac{\\pi {r}^{3}}{49}" :db/ensure [:answer/validate]} {:db/id "answer-5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2" :answer/id #uuid "5ec30d2a-cfae-520d-91ee-dc9d7ec9d2f2" :answer/type :answer.type/math :answer/value "V=\\frac{\\pi {r}^{3}}{7}" :db/ensure [:answer/validate]} {:db/id "question-f5dc2452-94d3-5570-b907-2fef94df0654" :question/id #uuid "f5dc2452-94d3-5570-b907-2fef94df0654" :question/math-academy-id "q-82238" :question/problem "Find an expression for the height $h$ of a cylinder in terms of its volume $V$ given that the ratio of the radius of the base to the height of the cylinder is $\\frac{1}{3}.$" :question/worked-solution "Using the fact that the ratio of the radius $r$ of the base to the height $h$ is $\\frac{1}{3},$ we have that\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3}.\\end{aligned}\n$$\n\nOur goal is to express $h$ in terms of $V.$ Therefore, we need to isolate $r$ in the above equation, which we do using cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{r}{h} & =\\frac{1}{3} \\\\ 3r & =h \\\\ r & =\\frac{h}{3}\\end{aligned}\n$$\n\nThe volume of a cylinder with radius $r$ and height $h$ is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nTherefore, substituting $r=\\frac{h}{3}$ into the formula, we get\n\n$$\n\\begin{aligned}V & =\\pi {r}^{2}h \\\\ V & =\\pi {(\\frac{h}{3})}^{2}\\cdot h \\\\ V & =\\pi \\cdot \\frac{{h}^{2}}{9}\\cdot h \\\\ V & =\\frac{\\pi {h}^{3}}{9} \\\\ {h}^{3} & =\\frac{9V}{\\pi } \\\\ h & =\\sqrt[3]{\\frac{9V}{\\pi }}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bb9d811f-3a95-59ec-9157-3f2c0587bc0b"] :db/ensure [:question/validate]} {:db/id "answer-field-bb9d811f-3a95-59ec-9157-3f2c0587bc0b" :answer-field/id #uuid "bb9d811f-3a95-59ec-9157-3f2c0587bc0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9d33a1a2-0563-576d-b3d4-649b89c427fb" :answer-field/choices ["answer-81410aa3-599c-5b7e-a1db-6dce30fb6236" "answer-d5d09076-162e-5ae2-8e86-9ff98030f326" "answer-9d33a1a2-0563-576d-b3d4-649b89c427fb" "answer-515340d0-d9cf-5eb4-ac80-59dfc5346185" "answer-0406e5ab-8732-5f42-9dc0-2ef98837edfc"] :db/ensure [:answer-field/validate]} {:db/id "answer-81410aa3-599c-5b7e-a1db-6dce30fb6236" :answer/id #uuid "81410aa3-599c-5b7e-a1db-6dce30fb6236" :answer/type :answer.type/math :answer/value "h=\\sqrt[3]{9\\pi V}" :db/ensure [:answer/validate]} {:db/id "answer-d5d09076-162e-5ae2-8e86-9ff98030f326" :answer/id #uuid "d5d09076-162e-5ae2-8e86-9ff98030f326" :answer/type :answer.type/math :answer/value "h=\\sqrt[3]{\\frac{3V}{\\pi }}" :db/ensure [:answer/validate]} {:db/id "answer-9d33a1a2-0563-576d-b3d4-649b89c427fb" :answer/id #uuid "9d33a1a2-0563-576d-b3d4-649b89c427fb" :answer/type :answer.type/math :answer/value "h=\\sqrt[3]{\\frac{9V}{\\pi }}" :db/ensure [:answer/validate]} {:db/id "answer-515340d0-d9cf-5eb4-ac80-59dfc5346185" :answer/id #uuid "515340d0-d9cf-5eb4-ac80-59dfc5346185" :answer/type :answer.type/math :answer/value "h=\\sqrt[3]{\\frac{V}{3\\pi }}" :db/ensure [:answer/validate]} {:db/id "answer-0406e5ab-8732-5f42-9dc0-2ef98837edfc" :answer/id #uuid "0406e5ab-8732-5f42-9dc0-2ef98837edfc" :answer/type :answer.type/math :answer/value "h=\\sqrt[3]{\\frac{V}{9\\pi }}" :db/ensure [:answer/validate]} {:db/id "activity-42bed486-179b-5d59-a8d9-0bbf928cd95a" :activity/id #uuid "42bed486-179b-5d59-a8d9-0bbf928cd95a" :activity/title "Volumes of Cylinders" :activity/type :activity.type/review :activity/scope 17592186048125 :activity/course 17592186046647 :activity/steps ["step-9822215a-42a3-56a6-a0a6-dc2017d21772" "step-b52b85e5-1c03-5db8-95e2-91e3dfb13d95" "step-61c0bf1f-cc04-57ab-bfd5-8623e720630d"] :activity/first-step "step-9822215a-42a3-56a6-a0a6-dc2017d21772" :db/ensure [:activity/validate]} {:db/id "step-9822215a-42a3-56a6-a0a6-dc2017d21772" :step/id #uuid "9822215a-42a3-56a6-a0a6-dc2017d21772" :step/content "question-5eb29534-af26-5796-a547-b3d37b08dcde" :step/next "step-b52b85e5-1c03-5db8-95e2-91e3dfb13d95" :db/ensure [:step/validate]} {:db/id "step-b52b85e5-1c03-5db8-95e2-91e3dfb13d95" :step/id #uuid "b52b85e5-1c03-5db8-95e2-91e3dfb13d95" :step/content "question-b2ff9ba6-9b7a-53dd-94e6-0ac24157cb77" :step/next "step-61c0bf1f-cc04-57ab-bfd5-8623e720630d" :db/ensure [:step/validate]} {:db/id "step-61c0bf1f-cc04-57ab-bfd5-8623e720630d" :step/id #uuid "61c0bf1f-cc04-57ab-bfd5-8623e720630d" :step/content "question-f5dc2452-94d3-5570-b907-2fef94df0654" :db/ensure [:step/validate]} [:db/retract 17592186116561 :answer-field/choices 17592186116562] [:db/retract 17592186116561 :answer-field/choices 17592186116563] [:db/retract 17592186116561 :answer-field/choices 17592186116564] [:db/retract 17592186116561 :answer-field/choices 17592186116565] [:db/retract 17592186116561 :answer-field/choices 17592186116566] {:db/id 17592186119891 :knowledge-point/questions ["question-2bf849af-f99e-5349-b3c0-22dba12fdf42" "question-2a4cb01f-06d4-5935-8045-405f9fc7f7c5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186120059 :question/problem "What is the volume of a rectangular solid that has length, width, and height of $12\\,\\text{cm},$ $2\\,\\text{cm},$ and $6\\,\\text{cm},$ respectively?" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=12\\,\\text{cm},\\,w=2\\,\\text{cm},\\,h=6\\,\\text{cm}\n$$\n\ninto the formula, we obtain\n\n$$\nV=12\\cdot 2\\cdot 6=144\\,{\\text{cm}}^{3}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186116561 :answer-field/correct "answer-8264b847-9b31-5c26-a47a-abb69aefe7c2" :answer-field/choices ["answer-8264b847-9b31-5c26-a47a-abb69aefe7c2" "answer-d8f037c6-07c2-51a5-84dc-2c31c263acab" "answer-f858a6e5-20ce-59ad-bec5-dc8ce7c64703" "answer-78b2c91b-12ce-5f53-b377-c69bef0f68a3" "answer-5104876b-fa5a-51a5-9904-e5d1363c0b10"] :db/ensure [:answer-field/validate]} {:db/id "answer-8264b847-9b31-5c26-a47a-abb69aefe7c2" :answer/id #uuid "8264b847-9b31-5c26-a47a-abb69aefe7c2" :answer/type :answer.type/math :answer/value "144{\\text{ cm}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-d8f037c6-07c2-51a5-84dc-2c31c263acab" :answer/id #uuid "d8f037c6-07c2-51a5-84dc-2c31c263acab" :answer/type :answer.type/math :answer/value "168{\\text{ cm}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-f858a6e5-20ce-59ad-bec5-dc8ce7c64703" :answer/id #uuid "f858a6e5-20ce-59ad-bec5-dc8ce7c64703" :answer/type :answer.type/math :answer/value "216{\\text{ cm}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-78b2c91b-12ce-5f53-b377-c69bef0f68a3" :answer/id #uuid "78b2c91b-12ce-5f53-b377-c69bef0f68a3" :answer/type :answer.type/math :answer/value "2\\sqrt{46}{\\text{ cm}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-5104876b-fa5a-51a5-9904-e5d1363c0b10" :answer/id #uuid "5104876b-fa5a-51a5-9904-e5d1363c0b10" :answer/type :answer.type/math :answer/value "72{\\text{ cm}}^{3}" :db/ensure [:answer/validate]} {:db/id "question-2bf849af-f99e-5349-b3c0-22dba12fdf42" :question/id #uuid "2bf849af-f99e-5349-b3c0-22dba12fdf42" :question/math-academy-id "q-118848" :question/problem "![](images/c3/c38953be7964fa371aaf82b20318aa87f9cc2641ada73c9f2778eeed61713450.png)\n\nDetermine the length of the rectangular solid above given that its volume is $105\\,{\\text{cm}}^{3}.$" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nV=105,\\,w=5,\\,h=7\n$$\n\ninto the formula, we obtain the following\n\n$$\n\\begin{aligned}105 & =l\\cdot 5\\cdot 7 \\\\ 105 & =35l \\\\ l & =3\\end{aligned}\n$$\n\nTherefore, the length is $3\\,\\text{cm}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f142235c-4b9c-5720-bdc0-9cd4320ec5e0"] :db/ensure [:question/validate]} {:db/id "answer-field-f142235c-4b9c-5720-bdc0-9cd4320ec5e0" :answer-field/id #uuid "f142235c-4b9c-5720-bdc0-9cd4320ec5e0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-61b87019-ffdf-519c-ae5d-090eb7a4c23a" :answer-field/choices ["answer-da38aa33-19f6-578b-adf3-631d77411995" "answer-27a9d428-0