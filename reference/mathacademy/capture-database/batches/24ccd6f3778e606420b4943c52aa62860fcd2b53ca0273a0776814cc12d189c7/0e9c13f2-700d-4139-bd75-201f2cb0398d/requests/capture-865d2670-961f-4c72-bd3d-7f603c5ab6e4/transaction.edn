a-a8f78bbd10d0" :db/ensure [:step/validate]} {:db/id "step-fdc6fa8c-fa41-52b8-916a-a8f78bbd10d0" :step/id #uuid "fdc6fa8c-fa41-52b8-916a-a8f78bbd10d0" :step/content 17592186064746 :step/next "step-ff4cb2b5-d9a6-59ba-963c-0aa10dc966cd" :db/ensure [:step/validate]} {:db/id "step-ff4cb2b5-d9a6-59ba-963c-0aa10dc966cd" :step/id #uuid "ff4cb2b5-d9a6-59ba-963c-0aa10dc966cd" :step/content "question-3c104695-c936-5d0f-b4ab-74c8ede24e1a" :step/next "step-016be58b-34c7-56e0-bb25-ce68f3db4b2d" :db/ensure [:step/validate]} {:db/id "step-016be58b-34c7-56e0-bb25-ce68f3db4b2d" :step/id #uuid "016be58b-34c7-56e0-bb25-ce68f3db4b2d" :step/content "question-eee859cf-032a-5a34-a81e-4f392e60f1ec" :step/next "step-13dd978b-1f46-5e2b-91cd-11bd806fc55d" :db/ensure [:step/validate]} {:db/id "step-13dd978b-1f46-5e2b-91cd-11bd806fc55d" :step/id #uuid "13dd978b-1f46-5e2b-91cd-11bd806fc55d" :step/content "question-651d48b6-dcdd-5bc2-87b4-a66ffecf04ac" :step/next "step-05c3145b-6657-521b-9f88-78380cc745b3" :db/ensure [:step/validate]} {:db/id "step-05c3145b-6657-521b-9f88-78380cc745b3" :step/id #uuid "05c3145b-6657-521b-9f88-78380cc745b3" :step/content "question-6ca180bb-426b-5acf-99a3-c4512087f7c5" :step/next "step-3c693221-729c-566b-98f4-3284a540a9dc" :db/ensure [:step/validate]} {:db/id "step-3c693221-729c-566b-98f4-3284a540a9dc" :step/id #uuid "3c693221-729c-566b-98f4-3284a540a9dc" :step/content "question-16908ce6-e741-598e-9537-76866b0601d0" :step/next "step-31915826-2175-53bc-9331-33006aaf0069" :db/ensure [:step/validate]} {:db/id "step-31915826-2175-53bc-9331-33006aaf0069" :step/id #uuid "31915826-2175-53bc-9331-33006aaf0069" :step/content 17592186138753 :step/next "step-79088bd5-79e2-5c98-8986-fdff7cce2c37" :db/ensure [:step/validate]} {:db/id "step-79088bd5-79e2-5c98-8986-fdff7cce2c37" :step/id #uuid "79088bd5-79e2-5c98-8986-fdff7cce2c37" :step/content "question-9169a9eb-58fd-54ef-9fd7-4f2515dd156b" :step/next "step-4e37dfac-86f5-5175-88bd-f25e50366f0c" :db/ensure [:step/validate]} {:db/id "step-4e37dfac-86f5-5175-88bd-f25e50366f0c" :step/id #uuid "4e37dfac-86f5-5175-88bd-f25e50366f0c" :step/content "question-69122235-d824-5d29-8715-1c0104966b58" :db/ensure [:step/validate]} {:db/id 17592186188291 :knowledge-point/questions ["question-3da31f55-8d6c-5a19-aa68-60451055a7de" "question-a29a3c61-aa9f-590b-908a-6227844310f9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3da31f55-8d6c-5a19-aa68-60451055a7de" :question/id #uuid "3da31f55-8d6c-5a19-aa68-60451055a7de" :question/math-academy-id "q-119166" :question/problem "The volume of a cylinder decreases at a rate that's proportional to the square of its radius. Write down a differential equation describing the rate of change of the radius, $r(t),$ in this process. Assume that the height of the cylinder does not change and that $K>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **volume** of a cylinder **decreases** at a rate that's **proportional** to the **square of its radius**.*\n\nWe note the following:\n\n- The question describes the *rate* at which the *volume $V$ of a cylinder* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}V}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}V}{\\text{d}t}$ *decreases* at a rate that's *proportional to the square of its radius.* Therefore,\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-k{r}^{2},\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}r}{\\text{d}t}.$\n\nThe volume $V$ of a cylinder is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nDifferentiating this equation with respect to $t,$ and the fact that the height of the cylinder does not change, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}h) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =2\\pi hr\\frac{\\text{d}r}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =-k{r}^{2} \\\\ 2\\pi hr\\frac{\\text{d}r}{\\text{d}t} & =-k{r}^{2} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-\\frac{k{r}^{2}}{2\\pi hr} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-\\frac{kr}{2\\pi h}.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{2\\pi h}>0\n$$\n\n \n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}r}{\\text{d}t}=-Kr.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-60e99a5a-7fef-5572-9023-63b84b45c7f5"] :db/ensure [:question/validate]} {:db/id "answer-field-60e99a5a-7fef-5572-9023-63b84b45c7f5" :answer-field/id #uuid "60e99a5a-7fef-5572-9023-63b84b45c7f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4fb5aa8c-19fb-505d-99d0-6d1e5e391d3e" :answer-field/choices ["answer-4fb5aa8c-19fb-505d-99d0-6d1e5e391d3e" "answer-a8cbfbe5-1faa-5f71-b7e8-8941f3018693" "answer-feafdf56-0689-5b42-9564-9aa9c5d0dfa7" "answer-1973d584-80ce-553d-a306-6d2016596bab" "answer-86e0e1ed-497b-5bc3-9be6-1e1fb1057fc6"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fb5aa8c-19fb-505d-99d0-6d1e5e391d3e" :answer/id #uuid "4fb5aa8c-19fb-505d-99d0-6d1e5e391d3e" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-Kr" :db/ensure [:answer/validate]} {:db/id "answer-a8cbfbe5-1faa-5f71-b7e8-8941f3018693" :answer/id #uuid "a8cbfbe5-1faa-5f71-b7e8-8941f3018693" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-K{r}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-feafdf56-0689-5b42-9564-9aa9c5d0dfa7" :answer/id #uuid "feafdf56-0689-5b42-9564-9aa9c5d0dfa7" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-\\frac{K}{r}" :db/ensure [:answer/validate]} {:db/id "answer-1973d584-80ce-553d-a306-6d2016596bab" :answer/id #uuid "1973d584-80ce-553d-a306-6d2016596bab" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=K-r" :db/ensure [:answer/validate]} {:db/id "answer-86e0e1ed-497b-5bc3-9be6-1e1fb1057fc6" :answer/id #uuid "86e0e1ed-497b-5bc3-9be6-1e1fb1057fc6" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=K{r}^{2}" :db/ensure [:answer/validate]} {:db/id "question-a29a3c61-aa9f-590b-908a-6227844310f9" :question/id #uuid "a29a3c61-aa9f-590b-908a-6227844310f9" :question/math-academy-id "q-119170" :question/problem "The volume of a cylinder decreases at a rate proportional to its volume. Write down a differential equation describing the rate of change of the height, $h(t),$ in this process. \nAssume that the radius of the cylinder does not change and that $k>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **volume** of a cylinder **decreases** at a rate **proportional** to its **volume**. *\n\nWe note the following:\n\n- The question describes the *rate* at which the *volume $V$ of a cylinder* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}V}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}V}{\\text{d}t}$ *decreases* at a rate *proportional to the volume.* Therefore,\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-kV,\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}h}{\\text{d}t}.$\n\nThe volume $V$ of a cylinder is given by\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nDifferentiating this equation with respect to $t,$ and using the fact that the radius of the cylinder does not change, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}h) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\pi {r}^{2}\\frac{\\text{d}h}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =-kV \\\\ \\pi {r}^{2}\\frac{\\text{d}h}{\\text{d}t} & =-k(\\pi {r}^{2}h) \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{k\\pi {r}^{2}h}{\\pi {r}^{2}} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-kh.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2ef6a3fe-d635-518d-8afa-e08f3e08c478"] :db/ensure [:question/validate]} {:db/id "answer-field-2ef6a3fe-d635-518d-8afa-e08f3e08c478" :answer-field/id #uuid "2ef6a3fe-d635-518d-8afa-e08f3e08c478" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-25636b1a-6d91-597e-9b19-e787394d985e" :answer-field/choices ["answer-9415b7a9-5a1a-57a3-803c-ddf72eef3856" "answer-bab4b395-1c32-5273-a354-4159ddc0b2ae" "answer-25636b1a-6d91-597e-9b19-e787394d985e" "answer-dc7edd2e-8ea0-5615-81cd-8f820d79ec79" "answer-031ea96a-3096-54b0-ad2a-4f96e9d8183b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9415b7a9-5a1a-57a3-803c-ddf72eef3856" :answer/id #uuid "9415b7a9-5a1a-57a3-803c-ddf72eef3856" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}h}{\\text{d}t}=-\\frac{k}{h}" :db/ensure [:answer/validate]} {:db/id "answer-bab4b395-1c32-5273-a354-4159ddc0b2ae" :answer/id #uuid "bab4b395-1c32-5273-a354-4159ddc0b2ae" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}h}{\\text{d}t}=-k" :db/ensure [:answer/validate]} {:db/id "answer-25636b1a-6d91-597e-9b19-e787394d985e" :answer/id #uuid "25636b1a-6d91-597e-9b19-e787394d985e" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}h}{\\text{d}t}=-kh" :db/ensure [:answer/validate]} {:db/id "answer-dc7edd2e-8ea0-5615-81cd-8f820d79ec79" :answer/id #uuid "dc7edd2e-8ea0-5615-81cd-8f820d79ec79" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}h}{\\text{d}t}=-k{h}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-031ea96a-3096-54b0-ad2a-4f96e9d8183b" :answer/id #uuid "031ea96a-3096-54b0-ad2a-4f96e9d8183b" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}h}{\\text{d}t}=k-h" :db/ensure [:answer/validate]} {:db/id 17592186188257 :knowledge-point/questions ["question-a8d62c5b-3e1c-59af-b194-160b1241f14c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a8d62c5b-3e1c-59af-b194-160b1241f14c" :question/id #uuid "a8d62c5b-3e1c-59af-b194-160b1241f14c" :question/math-academy-id "q-143132" :question/problem "The area of a circle decreases at a rate that's proportional to the cube of its radius. Write down a differential equation describing the rate of change of the radius, $r(t),$ in this process. Assume that $K>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **area** of a circle **decreases** at a **rate** that's **proportional** to the cube of its **radius**. *\n\nWe note the following:\n\n- The question describes the *rate* at which the *area $A$ of a circle* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}A}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}A}{\\text{d}t}$ *decreases* at a rate that's *proportional* to the cube of its *radius.* In other words,\n\n$$\n\\frac{\\text{d}A}{\\text{d}t}=-k{r}^{3}\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}r}{\\text{d}t}.$\n\nThe area of a circle is given by \n\n$$\nA=\\pi {r}^{2}.\n$$\n\n \n\nDifferentiating this equation with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\pi {r}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =2\\pi r\\frac{\\text{d}r}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =-k{r}^{3} \\\\ 2\\pi r\\frac{\\text{d}r}{\\text{d}t} & =-k{r}^{3} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-\\frac{k{r}^{3}}{2\\pi r} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-\\frac{k{r}^{2}}{2\\pi }.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{2\\pi }>0\n$$\n\n \n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}r}{\\text{d}t}=-K{r}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e60fe765-3ba7-5b2e-a3cc-67f6b659f5d1"] :db/ensure [:question/validate]} {:db/id "answer-field-e60fe765-3ba7-5b2e-a3cc-67f6b659f5d1" :answer-field/id #uuid "e60fe765-3ba7-5b2e-a3cc-67f6b659f5d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2010fc61-4364-5862-a96d-774075019bbc" :answer-field/choices ["answer-705dbc1d-a754-523f-92e0-8940c3b04884" "answer-ce1b73b6-ad80-5c74-ab55-18bad8b8f274" "answer-2010fc61-4364-5862-a96d-774075019bbc" "answer-d69ff15d-ef03-5444-8c1a-9ce4ef60002c" "answer-f9f93573-3c61-5ff8-b156-76483ae8624a"] :db/ensure [:answer-field/validate]} {:db/id "answer-705dbc1d-a754-523f-92e0-8940c3b04884" :answer/id #uuid "705dbc1d-a754-523f-92e0-8940c3b04884" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-K" :db/ensure [:answer/validate]} {:db/id "answer-ce1b73b6-ad80-5c74-ab55-18bad8b8f274" :answer/id #uuid "ce1b73b6-ad80-5c74-ab55-18bad8b8f274" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-Kr" :db/ensure [:answer/validate]} {:db/id "answer-2010fc61-4364-5862-a96d-774075019bbc" :answer/id #uuid "2010fc61-4364-5862-a96d-774075019bbc" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-K{r}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-d69ff15d-ef03-5444-8c1a-9ce4ef60002c" :answer/id #uuid "d69ff15d-ef03-5444-8c1a-9ce4ef60002c" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-\\frac{K}{r}" :db/ensure [:answer/validate]} {:db/id "answer-f9f93573-3c61-5ff8-b156-76483ae8624a" :answer/id #uuid "f9f93573-3c61-5ff8-b156-76483ae8624a" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-\\frac{K}{{r}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186188292 :knowledge-point/questions ["question-500cc9b6-df77-5d16-8dd2-a74988fb81dd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-500cc9b6-df77-5d16-8dd2-a74988fb81dd" :question/id #uuid "500cc9b6-df77-5d16-8dd2-a74988fb81dd" :question/math-academy-id "q-143140" :question/problem "At each point $P$ on a particular curve, the derivative ${y}^{′}(x)$ is **inversely** proportional to the shortest distance from $P$ to the $y$-axis. The derivative at the point $(2,8)$ equals $5.$ What differential equation describes this curve?" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*At each point $P$ on a particular curve, the **derivative** ${y}^{′}(x)$ is **inversely proportional** to the **shortest distance from $P$ to the $y$-axis**.*\n\nWe note the following:\n\n- The *shortest distance from $P$ to the $y$-axis* is given by $|x|.$\n\n- Since the *derivative* is *inversely proportional* to the shortest distance from $P$ to the $y$-axis, we have \n\n$$\n{y}^{′}(x)=k\\cdot \\frac{1}{|x|}\n$$\n\nwhere $k$ is a constant.\n\nSo, our differential equation is\n\n$$\n{y}^{′}(x)=\\frac{k}{|x|}.\n$$\n\nIn addition, we're told that ${y}^{′}(x)=5$ when at the point $(2,8).$ We can use this to determine the value of the coefficient $k:$\n\n$$\n\\begin{aligned}5=\\frac{k}{|2|}\\,⟹\\,k=10\\end{aligned}\n$$\n\nFinally, the differential equation describing the curve is\n\n$$\n{y}^{′}(x)=\\frac{10}{|x|}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5fa9844e-bf08-5151-a0ef-3ca82c6b8c21"] :db/ensure [:question/validate]} {:db/id "answer-field-5fa9844e-bf08-5151-a0ef-3ca82c6b8c21" :answer-field/id #uuid "5fa9844e-bf08-5151-a0ef-3ca82c6b8c21" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6004d047-d373-53e3-95ab-5c21565957f5" :answer-field/choices ["answer-6004d047-d373-53e3-95ab-5c21565957f5" "answer-53f1b9c6-6af0-5a2a-af00-95a3f317bc35" "answer-98ba0312-7934-5cd5-a8d0-964450104886" "answer-69b6b7e0-47f8-5d3f-90c7-9cc539874ad8" "answer-a9291194-9f4c-5ec3-89de-d6aac381c602"] :db/ensure [:answer-field/validate]} {:db/id "answer-6004d047-d373-53e3-95ab-5c21565957f5" :answer/id #uuid "6004d047-d373-53e3-95a