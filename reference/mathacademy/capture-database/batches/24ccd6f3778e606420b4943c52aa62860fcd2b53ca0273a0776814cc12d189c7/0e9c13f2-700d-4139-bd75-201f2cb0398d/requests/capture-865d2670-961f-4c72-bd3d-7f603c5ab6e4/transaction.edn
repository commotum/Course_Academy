059-663a-593e-a69e-1ea1a37547dc" :db/ensure [:activity/validate]} {:db/id "step-11d78059-663a-593e-a69e-1ea1a37547dc" :step/id #uuid "11d78059-663a-593e-a69e-1ea1a37547dc" :step/content "question-e7583ab2-cbcb-5d88-b90e-238c2a3f8662" :step/next "step-373b8be8-53f7-5b27-8a05-c288bb469b27" :db/ensure [:step/validate]} {:db/id "step-373b8be8-53f7-5b27-8a05-c288bb469b27" :step/id #uuid "373b8be8-53f7-5b27-8a05-c288bb469b27" :step/content "question-1873fa45-940e-5434-9a04-82891d309ea9" :step/next "step-69f97c9d-1171-5397-90c7-026c8b339a1f" :db/ensure [:step/validate]} {:db/id "step-69f97c9d-1171-5397-90c7-026c8b339a1f" :step/id #uuid "69f97c9d-1171-5397-90c7-026c8b339a1f" :step/content "question-9ddda73a-66ad-5c78-97bd-db73c90fdc26" :db/ensure [:step/validate]} {:db/id 17592186068902 :knowledge-point/questions ["question-1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94" :question/id #uuid "1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94" :question/math-academy-id "q-31964" :question/problem "$9{y}^{2}-6y+1=$" :question/worked-solution "The \"square of a difference\" formula states that\n\n$$\n{a}^{2}-2ab+{b}^{2}=(a-b)^{2}.\n$$\n\nWe will use this formula to factor the given trinomial. Our trinomial is\n\n$$\n9{y}^{2}-6y+1.\n$$\n\nFirst, we write both the quadratic term and the constant term as perfect squares:\n\n$$\n\\begin{aligned}(3y)^{2}-6y+(1)^{2}\\end{aligned}\n$$\n\nNext, we factor a $2$ out of the linear term:\n\n$$\n\\begin{aligned}(3y)^{2}-2(3y)+(1)^{2}\\end{aligned}\n$$\n\nThen, we write the middle parentheses $(3y)$ as a product of $3y$ and $1:$ \n\n$$\n\\begin{aligned}(3y)^{2}-2(3y\\cdot 1)+(1)^{2}\\end{aligned}\n$$\n\nFinally, we factor the trinomial using the square of difference formula with $a=3y$ and $b=1.$ This gives \n\n$$\n\\begin{aligned}(3y-1)^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bbdf1e33-0fba-578c-aaad-d0ea6db8cbc2"] :db/ensure [:question/validate]} {:db/id "answer-field-bbdf1e33-0fba-578c-aaad-d0ea6db8cbc2" :answer-field/id #uuid "bbdf1e33-0fba-578c-aaad-d0ea6db8cbc2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b7268394-d3df-50dd-aefd-a1d483bd162e" :answer-field/choices ["answer-b7268394-d3df-50dd-aefd-a1d483bd162e" "answer-2bb9bce2-0c34-585a-9786-18cdbee30507" "answer-41931e51-fe5c-5024-b27f-7666c39e6cec" "answer-c4b7e90c-e93d-59fc-87e0-2091f13f04ee" "answer-bfc42d89-bdf4-5894-9f74-40a503a37160"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7268394-d3df-50dd-aefd-a1d483bd162e" :answer/id #uuid "b7268394-d3df-50dd-aefd-a1d483bd162e" :answer/type :answer.type/math :answer/value "(3y-1)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2bb9bce2-0c34-585a-9786-18cdbee30507" :answer/id #uuid "2bb9bce2-0c34-585a-9786-18cdbee30507" :answer/type :answer.type/math :answer/value "(3y-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-41931e51-fe5c-5024-b27f-7666c39e6cec" :answer/id #uuid "41931e51-fe5c-5024-b27f-7666c39e6cec" :answer/type :answer.type/math :answer/value "(y-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c4b7e90c-e93d-59fc-87e0-2091f13f04ee" :answer/id #uuid "c4b7e90c-e93d-59fc-87e0-2091f13f04ee" :answer/type :answer.type/math :answer/value "3(y-1)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-bfc42d89-bdf4-5894-9f74-40a503a37160" :answer/id #uuid "bfc42d89-bdf4-5894-9f74-40a503a37160" :answer/type :answer.type/math :answer/value "9(y-1)^{2}" :db/ensure [:answer/validate]} {:db/id 17592186068849 :knowledge-point/questions ["question-cf9a0034-0b04-5113-8b59-eaa614930923"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cf9a0034-0b04-5113-8b59-eaa614930923" :question/id #uuid "cf9a0034-0b04-5113-8b59-eaa614930923" :question/math-academy-id "q-44032" :question/problem "Factor $-4{x}^{2}+4x-1.$" :question/worked-solution "Notice that the leading coefficient is negative. To reduce the expression to a more familiar form, we can factor out $-1,$ as follows:\n\n$$\n\\begin{aligned}-4{x}^{2}+4x-1 & = \\\\ -(4{x}^{2}-4x+1)\\end{aligned}\n$$\n\nNow, we factor the quadratic expression inside the parentheses using the square of a difference formula:\n\n$$\n\\begin{aligned}4{x}^{2}-4x+1 & = \\\\ (2x)^{2}-4x+{1}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x)+{1}^{2} & = \\\\ (2x-1)^{2} & \\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}-(4{x}^{2}-4x+1) & = \\\\ -(2x-1)^{2} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d785b8b3-293e-5ba6-866c-d51249e905eb"] :db/ensure [:question/validate]} {:db/id "answer-field-d785b8b3-293e-5ba6-866c-d51249e905eb" :answer-field/id #uuid "d785b8b3-293e-5ba6-866c-d51249e905eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-30bc40bd-0baa-53bc-b504-a2c240a14dc2" :answer-field/choices ["answer-995306bc-ae35-5f95-966b-0932e6545022" "answer-62b93017-abd9-5aa6-a8a4-50b59a42230d" "answer-37d6615e-66de-5728-ae8f-8e2fb4faec1f" "answer-30bc40bd-0baa-53bc-b504-a2c240a14dc2" "answer-464d7d12-8513-5d3d-b8c3-79b6c483fb54"] :db/ensure [:answer-field/validate]} {:db/id "answer-995306bc-ae35-5f95-966b-0932e6545022" :answer/id #uuid "995306bc-ae35-5f95-966b-0932e6545022" :answer/type :answer.type/math :answer/value "(4x-1)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-62b93017-abd9-5aa6-a8a4-50b59a42230d" :answer/id #uuid "62b93017-abd9-5aa6-a8a4-50b59a42230d" :answer/type :answer.type/math :answer/value "(x-2)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-37d6615e-66de-5728-ae8f-8e2fb4faec1f" :answer/id #uuid "37d6615e-66de-5728-ae8f-8e2fb4faec1f" :answer/type :answer.type/math :answer/value "-(2x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-30bc40bd-0baa-53bc-b504-a2c240a14dc2" :answer/id #uuid "30bc40bd-0baa-53bc-b504-a2c240a14dc2" :answer/type :answer.type/math :answer/value "-(2x-1)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-464d7d12-8513-5d3d-b8c3-79b6c483fb54" :answer/id #uuid "464d7d12-8513-5d3d-b8c3-79b6c483fb54" :answer/type :answer.type/math :answer/value "-(4x-1)^{2}" :db/ensure [:answer/validate]} {:db/id 17592186068848 :knowledge-point/questions ["question-f03b5992-4a97-5b3b-9545-c672d1a6e209"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f03b5992-4a97-5b3b-9545-c672d1a6e209" :question/id #uuid "f03b5992-4a97-5b3b-9545-c672d1a6e209" :question/math-academy-id "q-79002" :question/problem "Factor $16{x}^{2}-48x+36.$" :question/worked-solution "Notice that all of the terms have a common factor of $4.$ Therefore, we can simplify the expression by factoring out $4,$ as follows:\n\n$$\n\\begin{aligned}16{x}^{2}-48x+36 & = \\\\ 4(4{x}^{2}-12x+9)\\end{aligned}\n$$\n\nNow, let's factor the expression inside parentheses using the square of a difference formula: \n\n$$\n\\begin{aligned}4{x}^{2}-12x+9 & = \\\\ (2x)^{2}-12x+{3}^{2} & = \\\\ (2x)^{2}-2\\cdot (2x\\cdot 3)+{3}^{2} & = \\\\ (2x-3)^{2}\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\begin{aligned}4(4{x}^{2}-12x+9) & = \\\\ 4(2x-3)^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e25dd26-d9cd-5142-93e6-a7e8dbdac2b4"] :db/ensure [:question/validate]} {:db/id "answer-field-5e25dd26-d9cd-5142-93e6-a7e8dbdac2b4" :answer-field/id #uuid "5e25dd26-d9cd-5142-93e6-a7e8dbdac2b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" :answer-field/choices ["answer-5bd98886-b613-531e-838d-f40fd260e8e4" "answer-39ef85ad-8276-5ed8-b41e-7af905c91f91" "answer-374194b8-85ae-5815-89c6-1a8f87cc6dbe" "answer-bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" "answer-8c94784c-933a-51ab-b0f4-2713a3427fc9"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bd98886-b613-531e-838d-f40fd260e8e4" :answer/id #uuid "5bd98886-b613-531e-838d-f40fd260e8e4" :answer/type :answer.type/math :answer/value "(2x+1)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-39ef85ad-8276-5ed8-b41e-7af905c91f91" :answer/id #uuid "39ef85ad-8276-5ed8-b41e-7af905c91f91" :answer/type :answer.type/math :answer/value "(x+3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-374194b8-85ae-5815-89c6-1a8f87cc6dbe" :answer/id #uuid "374194b8-85ae-5815-89c6-1a8f87cc6dbe" :answer/type :answer.type/math :answer/value "2(2x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" :answer/id #uuid "bbb07f95-43b5-5477-a9d0-0c1c20b3c07b" :answer/type :answer.type/math :answer/value "4(2x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8c94784c-933a-51ab-b0f4-2713a3427fc9" :answer/id #uuid "8c94784c-933a-51ab-b0f4-2713a3427fc9" :answer/type :answer.type/math :answer/value "4(x-3)^{2}" :db/ensure [:answer/validate]} {:db/id "activity-f6b132f1-8395-5934-a798-3dc92cf19ca0" :activity/id #uuid "f6b132f1-8395-5934-a798-3dc92cf19ca0" :activity/title "Factoring Perfect Square Trinomials With Leading Coefficients" :activity/type :activity.type/review :activity/scope 17592186051032 :activity/course 17592186046647 :activity/steps ["step-7da91827-5e59-5953-84fa-3077985bee0d" "step-bf2aa872-b9dd-51ab-a97f-7add7180d9e9" "step-77f81baa-f622-5822-ad79-2391b7a40d19"] :activity/first-step "step-7da91827-5e59-5953-84fa-3077985bee0d" :db/ensure [:activity/validate]} {:db/id "step-7da91827-5e59-5953-84fa-3077985bee0d" :step/id #uuid "7da91827-5e59-5953-84fa-3077985bee0d" :step/content "question-1c00ad8d-9908-5ab2-b9e6-65ef0d5fcd94" :step/next "step-bf2aa872-b9dd-51ab-a97f-7add7180d9e9" :db/ensure [:step/validate]} {:db/id "step-bf2aa872-b9dd-51ab-a97f-7add7180d9e9" :step/id #uuid "bf2aa872-b9dd-51ab-a97f-7add7180d9e9" :step/content "question-cf9a0034-0b04-5113-8b59-eaa614930923" :step/next "step-77f81baa-f622-5822-ad79-2391b7a40d19" :db/ensure [:step/validate]} {:db/id "step-77f81baa-f622-5822-ad79-2391b7a40d19" :step/id #uuid "77f81baa-f622-5822-ad79-2391b7a40d19" :step/content "question-f03b5992-4a97-5b3b-9545-c672d1a6e209" :db/ensure [:step/validate]} [:db/retract 17592186203401 :answer-field/choices 17592186203402] [:db/retract 17592186203401 :answer-field/choices 17592186203403] [:db/retract 17592186203401 :answer-field/choices 17592186203404] [:db/retract 17592186203401 :answer-field/choices 17592186203405] [:db/retract 17592186203401 :answer-field/choices 17592186203406] [:db/retract 17592186203432 :answer-field/choices 17592186203433] [:db/retract 17592186203432 :answer-field/choices 17592186203434] [:db/retract 17592186203432 :answer-field/choices 17592186203435] [:db/retract 17592186203432 :answer-field/choices 17592186203436] [:db/retract 17592186203432 :answer-field/choices 17592186203437] {:db/id 17592186204080 :knowledge-point/questions ["question-ae4e117c-08e3-5ee2-be97-840ec47e6061"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186204578 :question/problem "Consider the function $L:{R}^{2\\times 3}\\to R$ defined by $L(A)={y}^{T}Ax$ where \n\n$$\nx=[\\begin{aligned}0 \\\\ 10 \\\\ 20\\end{aligned}],\\,y=[\\begin{aligned}7 \\\\ 8\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{3}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=y\\cdot {x}^{T}.$\n\nEvaluating at the given values $x=[\\begin{aligned}0 \\\\ 10 \\\\ 20\\end{aligned}]$ and $y=[\\begin{aligned}7 \\\\ 8\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=[\\begin{aligned}7 \\\\ 8\\end{aligned}]\\cdot [\\begin{aligned}0 & 10 & 20\\end{aligned}]=[\\begin{aligned}0 & 70 & 140 \\\\ 0 & 80 & 160\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203401 :answer-field/correct "answer-736cbadd-3b7b-553e-ac3e-54c9d0aa1309" :answer-field/choices ["answer-9df978fd-8d29-5189-99c3-1b1404d874c1" "answer-90109471-65f3-534e-ab7f-25d38145cf97" "answer-736cbadd-3b7b-553e-ac3e-54c9d0aa1309" "answer-7257e47e-0bbc-5f6f-8e0d-fa05a95547d9" "answer-d4aa7742-e290-58bb-8b89-9a097ad03132"] :db/ensure [:answer-field/validate]} {:db/id "answer-9df978fd-8d29-5189-99c3-1b1404d874c1" :answer/id #uuid "9df978fd-8d29-5189-99c3-1b1404d874c1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 \\\\ 10 & 70 \\\\ 20 & 80\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-90109471-65f3-534e-ab7f-25d38145cf97" :answer/id #uuid "90109471-65f3-534e-ab7f-25d38145cf97" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 \\\\ 70 & 80 \\\\ 140 & 160\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-736cbadd-3b7b-553e-ac3e-54c9d0aa1309" :answer/id #uuid "736cbadd-3b7b-553e-ac3e-54c9d0aa1309" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 70 & 140 \\\\ 0 & 80 & 160\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7257e47e-0bbc-5f6f-8e0d-fa05a95547d9" :answer/id #uuid "7257e47e-0bbc-5f6f-8e0d-fa05a95547d9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2 & 0 \\\\ 4 & 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d4aa7742-e290-58bb-8b89-9a097ad03132" :answer/id #uuid "d4aa7742-e290-58bb-8b89-9a097ad03132" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 4 \\\\ 2 & 0 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-ae4e117c-08e3-5ee2-be97-840ec47e6061" :question/id #uuid "ae4e117c-08e3-5ee2-be97-840ec47e6061" :question/math-academy-id "q-269381" :question/problem "Consider the function $L:{R}^{2\\times 2}\\to R$ defined by $L(A)=2({y}^{T}Ax)$ where \n\n$$\nx=[\\begin{aligned}9 \\\\ 0\\end{aligned}],\\,y=[\\begin{aligned}1 \\\\ -1\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}10 & 10 \\\\ -5 & -5\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{2}{\\sum }_{j=1}^{2}{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=2(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $x=[\\begin{aligned}9 \\\\ 0\\end{aligned}]$ and $y=[\\begin{aligned}1 \\\\ -1\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=2([\\begin{aligned}1 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}9 & 0\\end{aligned}])=2([\\begin{aligned}9 & 0 \\\\ -9 & 0\\end{aligned}])=[\\begin{aligned}18 & 0 \\\\ -18 & 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b6e05b4e-adf0-5ec5-b639-9d019a4a9d63"] :db/ensure [:question/validate]} {:db/id "answer-field-b6e05b4e-adf0-5ec5-b639-9d019a4a9d63" :answer-field/id #uuid "b6e05b4e-adf0-5ec5-b639-9d019a4a9d63" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9c769625-2afb-52e2-9006-b7df92b8cd0b" :answer-field/choices ["answer-976542d7-dd7f-5daf-aab6-bb5f2d5588dd" "answer-9c769625-2afb-52e2-9006-b7df92b8cd0b" "answer-af1b5240-994c-562c-9dae-36bc16150a71" "answer-a54b3b29-5e7b-5355-993d-c1692b182224" "answer-cf9d05e7-08ac-5c52-8f0b-08fb9cac8514"] :db/ensure [:answer-field/validate]} {:db/id "answer-976542d7-dd7f-5daf-aab6-bb5f2d5588dd" :answer/id #uuid "976542d7-dd7f-5daf-aab6-bb5f2d5588dd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9c769625-2afb-52e2-9006-b7df92b8cd0b" :answer/id #uuid "9c769625-2afb-52e2-9006-b7df92b8cd0b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 & 0 \\\\ -18 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-af1b5240-994c-562c-9dae-36bc16150a71" :answer/id #uuid "af1b5240-994c-562c-9dae-36bc16150a71" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 \\\\ -18\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a54b3b29-5e7b-5355-993d-c1692b182224" :answer/id #uuid "a54b3b29-5e7b-5355-993d-c1692b182224" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 0 \\\\ -9 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-cf9d05e7-08ac-5c52-8f0b-08fb9cac8514" :answer/id #uuid "cf9d05e7-08ac-5c52-8f0b-08fb9cac8514" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & 0 \\\\ 0 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186204584 :question/problem "Consider the function $L:{R}^{3\\times 2}\\to R$ defined by $L(A)=3({y}^{T}Ax)$ where \n\n$$\nx=[\\begin{aligned}3 \\\\ 3\\end{aligned}],\\,y=[\\begin{aligned}0 \\\\ -1 \\\\ 4\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}-2 & 3 \\\\ 5 & 1 \\\\ -1 & 0\\end{aligned}]?$" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWriting out $L$ in component-wise notation as \n\n$$\nL={\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}3{a}_{ij}{y}_{i}{x}_{j},\n$$\n\nwe have\n\n$$\n\\frac{∂L}{∂{a}_{ij}}=3{y}_{i}{x}_{j}.\n$$\n\nThus, ${∇}_{A}L=3(y\\cdot {x}^{T}).$\n\nEvaluating at the given values $x=[\\begin{aligned}3 \\\\ 3\\end{aligned}]$ and $y=[\\begin{aligned}0 \\\\ -1 \\\\ 4\\end{aligned}],$ we get\n\n$$\n{∇}_{A}L=3([\\begin{aligned}0 \\\\ -1 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}3 & 3\\end{aligned}])=3([\\begin{aligned}0 & 0 \\\\ -3 & -3 \\\\ 12 & 12\\end{aligned}])=[\\begin{aligned}0 & 0 \\\\ -9 & -9 \\\\ 36 & 36\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186203432 :answer-field/correct "answer-312a355a-904b-5eca-ae0f-c9e77ad2f94c" :answer-field/choices ["answer-3fa26cf7-587f-542e-bf6a-224a38d8a577" "answer-d830e853-f6f7-552e-b9bf-8e3dfedadf7a" "answer-d64795ea-1505-54f8-ad01-cafe6fb7fa86" "answer-312a355a-904b-5eca-ae0f-c9e77ad2f94c" "answer-c54ab21b-6f6b-5453-8f98-703092e388ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-3fa26cf7-587f-542e-bf6a-224a38d8a577" :answer/id #uuid "3fa26cf7-587f-542e-bf6a-224a38d8a577" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 3 \\\\ 5 & 1 \\\\ -1 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d830e853-f6f7-552e-b9bf-8e3dfedadf7a" :answer/id #uuid "d830e853-f6f7-552e-b9bf-8e3dfedadf7a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -9 & 36 \\\\ 0 & -9 & 36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d64795ea-1505-54f8-ad01-cafe6fb7fa86" :answer/id #uuid "d64795ea-1505-54f8-ad01-cafe6fb7fa86" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 \\\\ -3 & -3 \\\\ 12 & 12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-312a355a-904b-5eca-ae0f-c9e77ad2f94c" :answer/id #uuid "312a355a-904b-5eca-ae0f-c9e77ad2f94c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 0 \\\\ -9 & -9 \\\\ 36 & 36\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c54ab21b-6f6b-5453-8f98-703092e388ed" :answer/id #uuid "c54ab21b-6f6b-5453-8f98-703092e388ed" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -18 \\\\ 72\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186204081 :knowledge-point/questions ["question-a276eb8e-dc20-5069-8231-5e2d2d2a281a" "question-43f1cf78-e476-5744-a4e1-4eb640602151"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a276eb8e-dc20-5069-8231-5e2d2d2a281a" :question/id #uuid "a276eb8e-dc20-5069-8231-5e2d2d2a281a" :question/math-academy-id "q-269429" :question/problem "Consider the function $L:{R}^{2\\times 2}\\to R$ defined by $L(A)=\\frac{1}{2}(Ax-b)^{T}(Ax-b),$ where\n\n$$\nx=[\\begin{aligned}2 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 4\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 0 \\\\ 2 & -1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${∇}_{A}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">$9$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$-6$</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=Ax-b\\in {R}^{2}.$ Then, $L(A)=\\frac{1}{2}{y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}(\\frac{1}{2}{y}^{T}y)=y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}={y}_{k}.\n$$\n\nWriting out $y=Ax-b$ in component-wise notation as \n\n$$\n{y}_{i}={\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}={x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & ={y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $A=[\\begin{aligned}1 & 0 \\\\ 2 & -1\\end{aligned}],$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =y\\cdot {x}^{T} \\\\  & =(Ax-b)\\cdot {x}^{T} \\\\  & =([\\begin{aligned}1 & 0 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}]-[\\begin{aligned}-1 \\\\ 4\\end{aligned}])\\cdot [\\begin{aligned}2 & 3\\end{aligned}] \\\\  & =([\\begin{aligned}2 \\\\ 1\\end{aligned}]-[\\begin{aligned}-1 \\\\ 4\\end{aligned}])\\cdot [\\begin{aligned}2 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -3\\end{aligned}]\\cdot [\\begin{aligned}2 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 9 \\\\ -6 & -9\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fd131918-eda5-51aa-9124-e861cbcfd218" "answer-field-5fa668de-a737-5f91-800a-6c4b031f88c5"] :db/ensure [:question/validate]} {:db/id "answer-field-fd131918-eda5-51aa-9124-e861cbcfd218" :answer-field/id #uuid "fd131918-eda5-51aa-9124-e861cbcfd218" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-33107365-8d72-59e7-84e4-fb7248465cbf" :answer-field/choices ["answer-33107365-8d72-59e7-84e4-fb7248465cbf"] :db/ensure [:answer-field/validate]} {:db/id "answer-33107365-8d72-59e7-84e4-fb7248465cbf" :answer/id #uuid "33107365-8d72-59e7-84e4-fb7248465cbf" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-field-5fa668de-a737-5f91-800a-6c4b031f88c5" :answer-field/id #uuid "5fa668de-a737-5f91-800a-6c4b031f88c5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5e1e29d1-1888-52aa-8dc6-4b2845f73611" :answer-field/choices ["answer-5e1e29d1-1888-52aa-8dc6-4b2845f73611"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e1e29d1-1888-52aa-8dc6-4b2845f73611" :answer/id #uuid "5e1e29d1-1888-52aa-8dc6-4b2845f73611" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "question-43f1cf78-e476-5744-a4e1-4eb640602151" :question/id #uuid "43f1cf78-e476-5744-a4e1-4eb640602151" :question/math-academy-id "q-269517" :question/problem "Consider the function $L:{R}^{2\\times 2}\\to R$ defined by $L(A)=(4Ax-5b)^{T}(4Ax-5b),$ where\n\n$$\nx=[\\begin{aligned}0 \\\\ 4\\end{aligned}],\\,b=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].\n$$\n\nWhat is ${∇}_{A}L$ at \n$A=[\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}]?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"2\" width=\"30px\">\n${∇}_{A}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">$832$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "The gradient of $L$ with respect to $A$ is a matrix of the same shape as $A$, with $(i,j)$th entry given by\n\n$$\n\\frac{∂L}{∂{a}_{ij}},\n$$\n\nthe partial derivative of $L$ with respect to the $(i,j)$th entry of $A.$\n\nWe can compute $\\frac{∂L}{∂{a}_{ij}}$ by applying the chain rule.\n\nLet $y=4Ax-5b\\in {R}^{2}.$ Then, $L(A)={y}^{T}y$ and\n\n$$\n\\frac{∂L}{∂{a}_{ij}}={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}}\n$$\n\nNow, since \n\n$$\n{∇}_{y}L={∇}_{y}({y}^{T}y)=2y,\n$$\n\nwe have that\n\n$$\n\\frac{∂L}{∂{y}_{k}}=2{y}_{k}.\n$$\n\nWriting out $y=4Ax-5b$ in component-wise notation as \n\n$$\n{y}_{i}=4{\\sum }_{j=1}^{2}{a}_{ij}{x}_{j}-5{b}_{i},\n$$\n\nwe have \n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=4{x}_{j}$ if $i=k$, and\n\n- $\\frac{∂{y}_{k}}{∂{a}_{ij}}=0$ if $i\\ne k.$\n\nThis means that \n\n$$\n\\begin{aligned}\\frac{∂L}{∂{a}_{ij}} & ={\\sum }_{k=1}^{2}\\frac{∂L}{∂{y}_{k}}\\cdot \\frac{∂{y}_{k}}{∂{a}_{ij}} \\\\  & =\\frac{∂L}{∂{y}_{i}}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot \\frac{∂{y}_{i}}{∂{a}_{ij}} \\\\  & =2{y}_{i}\\cdot 4{x}_{j} \\\\  & =8{y}_{i}{x}_{j}.\\end{aligned}\n$$\n\nThe $(i,j)$th entry of ${∇}_{A}L$ is $8$ times the $i$th entry of $y$ multiplied by the $j$th entry of $x$, so\n\n$$\n{∇}_{A}L=8y\\cdot {x}^{T}.\n$$\n\nFinally, evaluating ${∇}_{A}L$ at $A=[\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}],$ we get\n\n$$\n\\begin{aligned}{∇}_{A}L & =8y\\cdot {x}^{T} \\\\  & =8(4Ax-5b)\\cdot {x}^{T} \\\\  & =8(4[\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 4\\end{aligned}]-5[\\begin{aligned}-2 \\\\ 3\\end{aligned}])\\cdot [\\begin{aligned}0 & 4\\end{aligned}] \\\\  & =8([\\begin{aligned}16 \\\\ -16\\end{aligned}]-[\\begin{aligned}-10 \\\\ 15\\end{aligned}])\\cdot [\\begin{aligned}0 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}208 \\\\ -248\\end{aligned}]\\cdot [\\begin{aligned}0 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 832 \\\\ 0 & -992\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0fefe5d8-100f-5282-b59e-0d1be2e84a1c" "answer-field-00abc28b-95f9-5105-a5d2-782d2db3d65a"] :db/ensure [:question/validate]} {:db/id "answer-field-0fefe5d8-100f-5282-b59e-0d1be2e84a1c" :answer-field/id #uuid "0fefe5d8-100f-5282-b59e-0d1be2e84a1c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e7d3c641-98ec-536a-b7ca-05afeccd2ec6" :answer-field/choices ["answer-e7d3c641-98ec-536a-b7ca-05afeccd2ec6"] :db/ensure [:answer-field/validate]} {:db/id "answer-e7d3c641-98ec-536a-b7ca-05afeccd2ec6" :answer/id #uuid "e7d3c641-98ec-536a-b7ca-05afeccd2ec6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-00abc28b-95f9-5105-a5d2-782d2db3d65a" :answer-field/id #uuid "00abc28b-95f9-5105-a5d2-782d2db3d65a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ed298814-70d0-5656-b6e2-258ce3641ddb" :answer-field/choices ["answer-ed298814-70d0-5656-b6e2-258ce3641ddb"] :db/ensure [:answer-field/validate]} {:db/id "answer-ed298814-70d0-5656-b6e2-258ce3641ddb" :answer/id #uuid "ed298814-70d0-5656-b6e2-258ce3641ddb" :answer/type :answer.type/math :answer/value "-992" :db/ensure [:answer/validate]} {:db/id "activity-2404189e-9656-51cd-a3b5-6c13f1ff213f" :activity/id #uuid "2404189e-9656-51cd-a3b5-6c13f1ff213f" :activity/title "Matrix Gradients" :activity/type :activity.type/review :activity/scope 17592186048550 :activity/course 17592186046658 :activity/steps ["step-b6011297-6460-5ecb-9f16-906f524f351c" "step-4fd46510-de50-56a6-8167-99996004b4ea" "step-117f03df-7ecf-55d7-878d-f554adc908c2" "step-66630ed2-72bb-5fad-a04e-d80e51de9e27" "step-15fbb940-fc98-53cc-ba92-f859f422626f"] :activity/first-step "step-b6011297-6460-5ecb-9f16-906f524f351c" :db/ensure [:activity/validate]} {:db/id "step-b6011297-6460-5ecb-9f16-906f524f351c" :step/id #uuid "b6011297-6460-5ecb-9f16-906f524f351c" :step/content 17592186204578 :step/next "step-4fd46510-de50-56a6-8167-99996004b4ea" :db/ensure [:step/validate]} {:db/id "step-4fd46510-de50-56a6-8167-99996004b4ea" :step/id #uuid "4fd46510-de50-56a6-8167-99996004b4ea" :step/content "question-ae4e117c-08e3-5ee2-be97-840ec47e6061" :step/next "step-117f03df-7ecf-55d7-878d-f554adc908c2" :db/ensure [:step/validate]} {:db/id "step-117f03df-7ecf-55d7-878d-f554adc908c2" :step/id #uuid "117f03df-7ecf-55d7-878d-f554adc908c2" :step/content 17592186204584 :step/next "step-66630ed2-72bb-5fad-a04e-d80e51de9e27" :db/ensure [:step/validate]} {:db/id "step-66630ed2-72bb-5fad-a04e-d80e51de9e27" :step/id #uuid "66630ed2-72bb-5fad-a04e-d80e51de9e27" :step/content "question-a276eb8e-dc20-5069-8231-5e2d2d2a281a" :step/next "step-15fbb940-fc98-53cc-ba92-f859f422626f" :db/ensure [:step/validate]} {:db/id "step-15fbb940-fc98-53cc-ba92-f859f422626f" :step/id #uuid "15fbb940-fc98-53cc-ba92-f859f422626f" :step/content "question-43f1cf78-e476-5744-a4e1-4eb640602151" :db/ensure [:step/validate]} {:db/id 17592186188339 :knowledge-point/questions ["question-f6596362-8154-5a9b-b6ee-af9895a85a60"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188327 :knowledge-point/questions ["question-0a174da3-b391-5e95-bb6f-67313dad4a2d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0a174da3-b391-5e95-bb6f-67313dad4a2d" :question/id #uuid "0a174da3-b391-5e95-bb6f-67313dad4a2d" :question/math-academy-id "q-146203" :question/problem "| $x$ | $1$ | $2$ | $4$ |\n| --- | --- | --- | --- |\n| ${f}_{X|Y}(x\\,|\\,2)$ | $0.3$ | $0.45$ | $0.25$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=2]$ given that the conditional probability mass function ${f}_{X|Y}(x\\,|\\,2)$ is shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|2}=2.2.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=2] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,2)]-{\\mu }_{X|2}^{2} \\\\  & =[(1)^{2}\\cdot 0.3+(2)^{2}\\cdot 0.45+(4)^{2}\\cdot 0.25]-(2.2)^{2} \\\\  & =0.3+1.8+4-4.84 \\\\  & =1.26.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4d904fdd-21aa-5b06-aab9-981bfbc03271"] :db/ensure [:question/validate]} {:db/id "answer-field-4d904fdd-21aa-5b06-aab9-981bfbc03271" :answer-field/id #uuid "4d904fdd-21aa-5b06-aab9-981bfbc03271" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b28d688f-5c4d-53f7-89d3-91e51d6d25a6" :answer-field/choices ["answer-1ad02fa8-3481-5a35-8f97-e44b965d8aa4" "answer-b7eefa51-6fa1-53f2-a256-4865ca5dfa9f" "answer-b28d688f-5c4d-53f7-89d3-91e51d6d25a6" "answer-9edb3ba8-6472-5571-8e40-1e3dfa7a1e0d" "answer-cfd19712-7a9f-5b0a-9bd8-01f5e442e63d"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ad02fa8-3481-5a35-8f97-e44b965d8aa4" :answer/id #uuid "1ad02fa8-3481-5a35-8f97-e44b965d8aa4" :answer/type :answer.type/math :answer/value "1.08" :db/ensure [:answer/validate]} {:db/id "answer-b7eefa51-6fa1-53f2-a256-4865ca5dfa9f" :answer/id #uuid "b7eefa51-6fa1-53f2-a256-4865ca5dfa9f" :answer/type :answer.type/math :answer/value "1.15" :db/ensure [:answer/validate]} {:db/id "answer-b28d688f-5c4d-53f7-89d3-91e51d6d25a6" :answer/id #uuid "b28d688f-5c4d-53f7-89d3-91e51d6d25a6" :answer/type :answer.type/math :answer/value "1.26" :db/ensure [:answer/validate]} {:db/id "answer-9edb3ba8-6472-5571-8e40-1e3dfa7a1e0d" :answer/id #uuid "9edb3ba8-6472-5571-8e40-1e3dfa7a1e0d" :answer/type :answer.type/math :answer/value "1.32" :db/ensure [:answer/validate]} {:db/id "answer-cfd19712-7a9f-5b0a-9bd8-01f5e442e63d" :answer/id #uuid "cfd19712-7a9f-5b0a-9bd8-01f5e442e63d" :answer/type :answer.type/math :answer/value "1.38" :db/ensure [:answer/validate]} {:db/id "question-f6596362-8154-5a9b-b6ee-af9895a85a60" :question/id #uuid "f6596362-8154-5a9b-b6ee-af9895a85a60" :question/math-academy-id "q-146227" :question/problem "| $f$ | $Y=0$ | $Y=2$ | $Y=4$ |\n| --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{3}{16}$ | $\\frac{1}{16}$ |\n| $X=2$ | $\\frac{3}{8}$ | $0$ | $\\frac{1}{8}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[Y\\,|\\,X=2]$ given that $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{Y|2}=1.$" :question/worked-solution "Recall that the conditional variance of $Y$ given $X=x$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=x] & =\\text{E}[(Y-{\\mu }_{Y|x})^{2}\\,|\\,X=x] \\\\  & =\\text{E}[{Y}^{2}\\,|\\,X=x]-{\\mu }_{Y|x}^{2} \\\\  & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,x)]-{\\mu }_{Y|x}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{Y|X}(y\\,|\\,x),$ let's first find the marginal distribution for $X,$ corresponding to the row totals: \n\n| $f$ | $Y=0$ | $Y=2$ | $Y=4$ | ${f}_{X}(x)$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{4}$ | $\\frac{3}{16}$ | $\\frac{1}{16}$ | $\\frac{1}{2}$ |\n| $X=2$ | $\\frac{3}{8}$ | $0$ | $\\frac{1}{8}$ | $\\frac{1}{2}$ |\n\nThe conditional probability mass function of $Y$ given that $X=x$ is\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding row total, we obtain the conditional probability mass function of $Y$ given that $X=x:$\n\n| ${f}_{Y|X}(y\\,|\\,x)$ | $Y=0$ | $Y=2$ | $Y=4$ |  |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $\\frac{1}{2}$ | $\\frac{3}{8}$ | $\\frac{1}{8}$ | $1$ |\n| $X=2$ | $\\frac{3}{4}$ | $0$ | $\\frac{1}{4}$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[Y\\,|\\,X=2] & =[{\\sum }_{y}{y}^{2}\\,{f}_{Y|X}(y\\,|\\,2)]-{\\mu }_{Y|2}^{2} \\\\  & =[{0}^{2}\\cdot \\frac{3}{4}+{2}^{2}\\cdot 0+{4}^{2}\\cdot \\frac{1}{4}]-{1}^{2} \\\\  & =0+0+4-1 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ebb5d8b0-09a9-5d9e-8e09-86d97b61cdf1"] :db/ensure [:question/validate]} {:db/id "answer-field-ebb5d8b0-09a9-5d9e-8e09-86d97b61cdf1" :answer-field/id #uuid "ebb5d8b0-09a9-5d9e-8e09-86d97b61cdf1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16d692bd-0e74-560a-a96c-8d8461608311" :answer-field/choices ["answer-16d692bd-0e74-560a-a96c-8d8461608311" "answer-b4ff7745-61b1-5fe6-ad1b-f5ee14b3580b" "answer-9267e4c1-e2af-5f31-bbf9-2d596a42e1d0" "answer-e265f954-217e-5676-a722-342362e50106" "answer-74a88296-9ddf-544e-9d53-a64399f2a11a"] :db/ensure [:answer-field/validate]} {:db/id "answer-16d692bd-0e74-560a-a96c-8d8461608311" :answer/id #uuid "16d692bd-0e74-560a-a96c-8d8461608311" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-b4ff7745-61b1-5fe6-ad1b-f5ee14b3580b" :answer/id #uuid "b4ff7745-61b1-5fe6-ad1b-f5ee14b3580b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-9267e4c1-e2af-5f31-bbf9-2d596a42e1d0" :answer/id #uuid "9267e4c1-e2af-5f31-bbf9-2d596a42e1d0" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-e265f954-217e-5676-a722-342362e50106" :answer/id #uuid "e265f954-217e-5676-a722-342362e50106" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-74a88296-9ddf-544e-9d53-a64399f2a11a" :answer/id #uuid "74a88296-9ddf-544e-9d53-a64399f2a11a" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id 17592186188328 :knowledge-point/questions ["question-9a9df102-8e4d-542b-ad62-072cc2469e7e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9a9df102-8e4d-542b-ad62-072cc2469e7e" :question/id #uuid "9a9df102-8e4d-542b-ad62-072cc2469e7e" :question/math-academy-id "q-146287" :question/problem "| $f$ | $Y=3$ | $Y=9$ |\n| --- | --- | --- |\n| $X=3$ | $\\frac{1}{27}$ | $\\frac{2}{9}$ |\n| $X=6$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n| $X=9$ | $\\frac{5}{27}$ | $\\frac{1}{3}$ |\n\nSuppose $X$ and $Y$ are discrete random variables. Find $\\text{Var}[X\\,|\\,Y=3]$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above and the corresponding conditional expected value is ${\\mu }_{X|3}=\\frac{22}{3}.$" :question/worked-solution "Recall that the conditional variance of $X$ given $Y=y$ is defined by\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=y] & =\\text{E}[(X-{\\mu }_{X|y})^{2}\\,|\\,Y=y] \\\\  & =\\text{E}[{X}^{2}\\,|\\,Y=y]-{\\mu }_{X|y}^{2} \\\\  & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,y)]-{\\mu }_{X|y}^{2}.\\end{aligned}\n$$\n\nIn order to find ${f}_{X|Y}(x\\,|\\,y),$ let's first find the marginal distribution of $Y,$ corresponding to the column totals: \n\n| $f$ | $Y=3$ | $Y=9$ |\n| --- | --- | --- |\n| $X=3$ | $\\frac{1}{27}$ | $\\frac{2}{9}$ |\n| $X=6$ | $\\frac{1}{9}$ | $\\frac{1}{9}$ |\n| $X=9$ | $\\frac{5}{27}$ | $\\frac{1}{3}$ |\n| ${f}_{Y}(y)$ | $\\frac{1}{3}$ | $\\frac{2}{3}$ |\n\nThe conditional probability mass function of $X$ given that $Y=y$ is\n\n$$\n{f}_{X|Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nTherefore, dividing each joint probability by the corresponding column total, we obtain the conditional probability mass function of $X$ given that $Y=y:$\n\n| ${f}_{X|Y}(x\\,|\\,y)$ | $Y=3$ | $Y=9$ |\n| --- | --- | --- |\n| $X=3$ | $\\frac{1}{9}$ | $\\frac{1}{3}$ |\n| $X=6$ | $\\frac{1}{3}$ | $\\frac{1}{6}$ |\n| $X=9$ | $\\frac{5}{9}$ | $\\frac{1}{2}$ |\n|  | $1$ | $1$ |\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\\text{Var}[X\\,|\\,Y=3] & =[{\\sum }_{x}{x}^{2}\\,{f}_{X|Y}(x\\,|\\,3)]-{\\mu }_{X|3}^{2} \\\\  & =[{3}^{2}\\cdot \\frac{1}{9}+{6}^{2}\\cdot \\frac{1}{3}+{9}^{2}\\cdot \\frac{5}{9}]-{(\\frac{22}{3})}^{2} \\\\  & =1+12+45-\\frac{484}{9} \\\\  & =\\frac{38}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2224a384-1d96-5035-96d8-8e3991487107"] :db/ensure [:question/validate]} {:db/id "answer-field-2224a384-1d96-5035-96d8-8e3991487107" :answer-field/id #uuid "2224a384-1d96-5035-96d8-8e3991487107" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "an