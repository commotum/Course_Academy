lds ["answer-field-7fca9031-9da9-5b3f-bdb6-33776b8b11df"] :db/ensure [:question/validate]} {:db/id "answer-field-7fca9031-9da9-5b3f-bdb6-33776b8b11df" :answer-field/id #uuid "7fca9031-9da9-5b3f-bdb6-33776b8b11df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6803c870-457e-5570-b150-242064d877b7" :answer-field/choices ["answer-6803c870-457e-5570-b150-242064d877b7" "answer-ea4562b1-cb09-56bb-b332-50c8ff359486" "answer-297e3ba8-3ec2-51c0-8643-c2fb9b7d1c93" "answer-a285a759-8c2e-5fa1-8ef2-860eef0594a7" "answer-b4b289fa-1eee-5b83-b6eb-48dcbdf93bbe"] :db/ensure [:answer-field/validate]} {:db/id "answer-6803c870-457e-5570-b150-242064d877b7" :answer/id #uuid "6803c870-457e-5570-b150-242064d877b7" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-ea4562b1-cb09-56bb-b332-50c8ff359486" :answer/id #uuid "ea4562b1-cb09-56bb-b332-50c8ff359486" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-297e3ba8-3ec2-51c0-8643-c2fb9b7d1c93" :answer/id #uuid "297e3ba8-3ec2-51c0-8643-c2fb9b7d1c93" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-a285a759-8c2e-5fa1-8ef2-860eef0594a7" :answer/id #uuid "a285a759-8c2e-5fa1-8ef2-860eef0594a7" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-b4b289fa-1eee-5b83-b6eb-48dcbdf93bbe" :answer/id #uuid "b4b289fa-1eee-5b83-b6eb-48dcbdf93bbe" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-29481c76-b7fa-575a-9ace-40d060b32844" :question/id #uuid "29481c76-b7fa-575a-9ace-40d060b32844" :question/math-academy-id "q-78102" :question/problem "Calculate ${lim}_{x\\to -3}{log}_{7}⁡(x+3).$" :question/worked-solution "Let's sketch the graph of $y={log}_{7}⁡(x+3).$\n\n![](images/0b/0b45cd648830ad88c2f21865c1bfd704783a7b5d9ce3510646ae55e98d2d95ac.png)\n\nThe function is not defined for $x\\le -3.$ Therefore,\n\n$$\n{lim}_{x\\to (-3)^{-}}{log}_{7}⁡(x+3)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>-3.$ Moreover,\n\n$$\n{lim}_{x\\to (-3)^{+}}{log}_{7}⁡(x+3)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to -3}{log}_{7}⁡(x+3)=\\text{DNE}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ef353a81-f085-5f7c-bea2-edd66e33a6a2"] :db/ensure [:question/validate]} {:db/id "answer-field-ef353a81-f085-5f7c-bea2-edd66e33a6a2" :answer-field/id #uuid "ef353a81-f085-5f7c-bea2-edd66e33a6a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf45625d-0eac-56fb-9026-80a2e5480905" :answer-field/choices ["answer-13b7b802-4cfb-59ae-8f7e-a0a096cb02e3" "answer-6532bdbf-67c3-5cb8-b17b-f39dc8c37c15" "answer-0cba6f4f-7f15-556c-a7f3-40384f4762be" "answer-77699979-865d-5845-a4a5-998145367451" "answer-cf45625d-0eac-56fb-9026-80a2e5480905"] :db/ensure [:answer-field/validate]} {:db/id "answer-13b7b802-4cfb-59ae-8f7e-a0a096cb02e3" :answer/id #uuid "13b7b802-4cfb-59ae-8f7e-a0a096cb02e3" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-6532bdbf-67c3-5cb8-b17b-f39dc8c37c15" :answer/id #uuid "6532bdbf-67c3-5cb8-b17b-f39dc8c37c15" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-0cba6f4f-7f15-556c-a7f3-40384f4762be" :answer/id #uuid "0cba6f4f-7f15-556c-a7f3-40384f4762be" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-77699979-865d-5845-a4a5-998145367451" :answer/id #uuid "77699979-865d-5845-a4a5-998145367451" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-cf45625d-0eac-56fb-9026-80a2e5480905" :answer/id #uuid "cf45625d-0eac-56fb-9026-80a2e5480905" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "question-1d09c144-84e6-5d74-866a-0f1eb2fa303b" :question/id #uuid "1d09c144-84e6-5d74-866a-0f1eb2fa303b" :question/math-academy-id "q-67658" :question/problem "Calculate ${lim}_{x\\to (-2)}{log}_{2}⁡(x+2).$" :question/worked-solution "Let's sketch the graph of $y={log}_{2}⁡(x+2).$\n\n![](images/5c/5c4b062938cc4e3d64f11f9ad3bd8da9431581e9a1b0278a977a64c0d727c73d.png)\n\nThe function is not defined for $x\\le -2.$ Therefore,\n\n$$\n{lim}_{x\\to -{2}^{-}}{log}_{2}⁡(x+2)=\\text{DNE}.\n$$\n\nHowever, the function is defined for $x>-2.$ Moreover,\n\n$$\n{lim}_{x\\to -{2}^{+}}{log}_{2}⁡(x+2)=-\\infty .\n$$\n\nSince the left and right-sided limits are not equal, we have\n\n$$\n{lim}_{x\\to -2}{log}_{2}⁡(x+2)=\\text{DNE}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3e1c1c73-b29d-551a-9e59-e04e1561113d"] :db/ensure [:question/validate]} {:db/id "answer-field-3e1c1c73-b29d-551a-9e59-e04e1561113d" :answer-field/id #uuid "3e1c1c73-b29d-551a-9e59-e04e1561113d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-522c42bc-ffdf-5445-a281-9e67e13da065" :answer-field/choices ["answer-ce81e711-5293-5867-b8ca-b0091a8e51f5" "answer-784225b7-fdbd-5ed5-98bf-a5c7fd5f5031" "answer-dd67f345-0127-58ed-a1c4-1ae6514154f5" "answer-f2db4690-93ae-558e-9493-a372055b41d7" "answer-522c42bc-ffdf-5445-a281-9e67e13da065"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce81e711-5293-5867-b8ca-b0091a8e51f5" :answer/id #uuid "ce81e711-5293-5867-b8ca-b0091a8e51f5" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-784225b7-fdbd-5ed5-98bf-a5c7fd5f5031" :answer/id #uuid "784225b7-fdbd-5ed5-98bf-a5c7fd5f5031" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "answer-dd67f345-0127-58ed-a1c4-1ae6514154f5" :answer/id #uuid "dd67f345-0127-58ed-a1c4-1ae6514154f5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-f2db4690-93ae-558e-9493-a372055b41d7" :answer/id #uuid "f2db4690-93ae-558e-9493-a372055b41d7" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "answer-522c42bc-ffdf-5445-a281-9e67e13da065" :answer/id #uuid "522c42bc-ffdf-5445-a281-9e67e13da065" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id 17592186107069 :tutorial/content "Let's look at the graph of $y=\\log_2{x}$ below.\n\n![](images/00/004265d2269924c6ce8905b6b92e9050b84066b3b5a3cc5383c75dd08e62f413.png)\n\nFrom the graph, we see that\n\n$$\n\\lim_{x\\to3}\\log_2{x} = \\log_2{3}\\approx 1.58.\n$$\n\nFor logarithmic functions, the limit at a point is equal to the value of the function at that point, so for any base $b \\gt 1$ we have\n\n$$\n\\lim_{x\\to c}\\log_b{x} = \\log_b{c}.\n$$\n\nRemember that logarithms are only defined for positive inputs $x\\gt 0,$ so we must have $c>0.$ Otherwise, the limit does not exist $\\textrm{(DNE}).$" :db/ensure [:tutorial/validate]} {:db/id 17592186107070 :tutorial/content "Let's take a look again at the function $y=\\log_2(x).$\n\n![](images/30/30a66b56ea1422fc61941d22aedbbf3f17e06810e66e6590490bd4b7188fd361.png)\n\nAs $x$ gets larger and larger, the curve increases without bound. So, we have\n\n$$\n\\lim_{x\\to\\infty} \\log_2{x}= \\infty.\n$$\n\nThe curve is not defined for $x\\leq 0,$ but as $x$ approaches zero from the right the curve *decreases* without bound. So\n\n$$\n\\lim_{x\\to0^+}\\log_2{x} = -\\infty.\n$$\n\nAlso, note that\n\n$$\n\\lim_{x\\to0^-}\\log_2{x} = \\textrm{DNE},\\qquad\\qquad \\lim_{x\\to0}\\log_2{x} = \\textrm{DNE}.\n$$\n\nThese properties are true for logarithms of any base $b\\gt 1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186106004 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} [:db/retract 17592186159374 :answer-field/choices 17592186159376] [:db/retract 17592186159374 :answer-field/choices 17592186159375] {:db/id 17592186162362 :question/problem "![](images/93/931f7cc1fe4cc6a45c1f586bb017bb3eda8f7745aa3973c13f08aa8521c39400.png)\n\nA $2\\times 3$ matrix $A$ maps the unit sphere $\\{x\\,|\\,‖x‖=1\\}$ from ${R}^{3}$ onto an ellipse in ${R}^{2}.$ The corresponding ellipse and its principal axes are depicted in the diagram above. Given that ${v}_{1}$ and ${v}_{2}$ are unit eigenvectors of ${A}^{T}A,$ what are the nonzero singular values of $A?$" :question/worked-solution "Suppose $A$ is an $m\\times n$ matrix. Let \n\n$$\n\\{{v}_{1},{v}_{2}\\,…,{v}_{n}\\}\n$$\n\nbe an *orthonormal* basis of ${R}^{n}$ consisting of the eigenvectors of ${A}^{T}A$ with corresponding eigenvalues \n\n$$\n{\\lambda }_{1}\\ge {\\lambda }_{2}\\ge …\\ge {\\lambda }_{n}.\n$$\n\nThen,\n\n- ${\\sigma }_{1}=\\sqrt{{\\lambda }_{1}}$ is the length of $A{v}_{1},$\n\n- ${\\sigma }_{2}=\\sqrt{{\\lambda }_{2}}$ is the length of $A{v}_{2},$\n\n- $⋯$\n\nIn our example, we see that\n\n- $||A{v}_{1}||=4={\\sigma }_{1},$ and\n\n- $||A{v}_{2}||=2={\\sigma }_{2}.$\n\nTherefore, the nonzero singular values of $A$ are ${\\sigma }_{1}=4$ and ${\\sigma }_{2}=2.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186159374 :answer-field/correct 17592186159379 :answer-field/choices ["answer-38f9c426-dab0-57b7-aa76-6f687589b344" "answer-585850a0-2e98-5454-a5ce-c2c74b29b565"] :db/ensure [:answer-field/validate]} {:db/id "answer-38f9c426-dab0-57b7-aa76-6f687589b344" :answer/id #uuid "38f9c426-dab0-57b7-aa76-6f687589b344" :answer/type :answer.type/text :answer/value "$4{v}_{1}$ and $2{v}_{1}$" :db/ensure [:answer/validate]} {:db/id "answer-585850a0-2e98-5454-a5ce-c2c74b29b565" :answer/id #uuid "585850a0-2e98-5454-a5ce-c2c74b29b565" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{1}$" :db/ensure [:answer/validate]} {:db/id "activity-8c4631f5-ce38-50ca-8db4-4b2dd080d0df" :activity/id #uuid "8c4631f5-ce38-50ca-8db4-4b2dd080d0df" :activity/title "The Singular Values of a Matrix" :activity/type :activity.type/review :activity/scope 17592186050205 :activity/course 17592186046660 :activity/steps ["step-ec8da15c-64b8-543b-87b6-4d2e08009505" "step-7935da3a-469b-5bce-9e33-166b16dfa9be" "step-45611da9-d3af-5cc7-b007-af7ba19a6423" "step-410080ab-5733-5c31-94d9-fda79a0bc8c5" "step-fdfac010-d775-5eb5-8960-f4712e637036"] :activity/first-step "step-ec8da15c-64b8-543b-87b6-4d2e08009505" :db/ensure [:activity/validate]} {:db/id "step-ec8da15c-64b8-543b-87b6-4d2e08009505" :step/id #uuid "ec8da15c-64b8-543b-87b6-4d2e08009505" :step/content 17592186162362 :step/next "step-7935da3a-469b-5bce-9e33-166b16dfa9be" :db/ensure [:step/validate]} {:db/id "step-7935da3a-469b-5bce-9e33-166b16dfa9be" :step/id #uuid "7935da3a-469b-5bce-9e33-166b16dfa9be" :step/content 17592186269240 :step/next "step-45611da9-d3af-5cc7-b007-af7ba19a6423" :db/ensure [:step/validate]} {:db/id "step-45611da9-d3af-5cc7-b007-af7ba19a6423" :step/id #uuid "45611da9-d3af-5cc7-b007-af7ba19a6423" :step/content 17592186503755 :step/next "step-410080ab-5733-5c31-94d9-fda79a0bc8c5" :db/ensure [:step/validate]} {:db/id "step-410080ab-5733-5c31-94d9-fda79a0bc8c5" :step/id #uuid "410080ab-5733-5c31-94d9-fda79a0bc8c5" :step/content 17592186400763 :step/next "step-fdfac010-d775-5eb5-8960-f4712e637036" :db/ensure [:step/validate]} {:db/id "step-fdfac010-d775-5eb5-8960-f4712e637036" :step/id #uuid "fdfac010-d775-5eb5-8960-f4712e637036" :step/content 17592186269246 :db/ensure [:step/validate]} {:db/id 17592186073914 :knowledge-point/questions ["question-889c45f8-a956-5ef6-ac2b-6cd191ad30dc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-889c45f8-a956-5ef6-ac2b-6cd191ad30dc" :question/id #uuid "889c45f8-a956-5ef6-ac2b-6cd191ad30dc" :question/math-academy-id "q-53664" :question/problem "![](images/01/01b6ade0a9b4945c0381848092e9b2289f823c49b2c5c138a29187e7f541787c.png)\n\nThe two pentagons shown above are similar. What is the correct similarity statement?" :question/worked-solution "Since, \n\n$$\n\\begin{aligned}∠A≅∠U,\\,∠B≅∠V,\\,∠C≅∠W,\\,∠D≅∠X,\\,∠E≅∠Y,\\end{aligned}\n$$\n\nwe conclude that \n\n- $A$ corresponds to $U,$\n\n- $B$ corresponds to $V,$\n\n- $C$ corresponds to $W,$\n\n- $D$ corresponds to $X,$\n\n- $E$ corresponds to $Y.$\n\nTherefore, $ABCDE∼UVWXY.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3086ccfe-34d4-5016-955b-04dc749a45e1"] :db/ensure [:question/validate]} {:db/id "answer-field-3086ccfe-34d4-5016-955b-04dc749a45e1" :answer-field/id #uuid "3086ccfe-34d4-5016-955b-04dc749a45e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e831d608-ab95-5cb5-bd60-e9a515a2274f" :answer-field/choices ["answer-e831d608-ab95-5cb5-bd60-e9a515a2274f" "answer-f074f9a2-1f24-594d-a3e3-1978813ac002" "answer-f496cc6b-a69d-5e9f-b778-efe587c3fac0" "answer-0560459a-bce6-5338-82e7-960929cfc752" "answer-3d8bb24e-348f-5983-913d-51ca2226f57e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e831d608-ab95-5cb5-bd60-e9a515a2274f" :answer/id #uuid "e831d608-ab95-5cb5-bd60-e9a515a2274f" :answer/type :answer.type/math :answer/value "ABCDE∼UVWXY" :db/ensure [:answer/validate]} {:db/id "answer-f074f9a2-1f24-594d-a3e3-1978813ac002" :answer/id #uuid "f074f9a2-1f24-594d-a3e3-1978813ac002" :answer/type :answer.type/math :answer/value "ABCDE∼UYXWV" :db/ensure [:answer/validate]} {:db/id "answer-f496cc6b-a69d-5e9f-b778-efe587c3fac0" :answer/id #uuid "f496cc6b-a69d-5e9f-b778-efe587c3fac0" :answer/type :answer.type/math :answer/value "ABCDE∼YUVWX" :db/ensure [:answer/validate]} {:db/id "answer-0560459a-bce6-5338-82e7-960929cfc752" :answer/id #uuid "0560459a-bce6-5338-82e7-960929cfc752" :answer/type :answer.type/math :answer/value "EABCD∼XYUVW" :db/ensure [:answer/validate]} {:db/id "answer-3d8bb24e-348f-5983-913d-51ca2226f57e" :answer/id #uuid "3d8bb24e-348f-5983-913d-51ca2226f57e" :answer/type :answer.type/math :answer/value "EABCD∼YUVXW" :db/ensure [:answer/validate]} {:db/id 17592186074218 :question/problem "Given that $△ABC∼△{A}^{′}{B}^{′}{C}^{′},$ $AB=4\\,cm$ and $BC=6\\,cm,$\nwhich of the following could be the values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}?$\n\nI. ${A}^{′}{B}^{′}=16\\,cm,\\,{B}^{′}{C}^{′}=24\\,cm$\n\nII. ${A}^{′}{B}^{′}=20\\,cm,\\,{B}^{′}{C}^{′}=30\\,cm$\n\nIII. ${A}^{′}{B}^{′}=32\\,cm,\\,{B}^{′}{C}^{′}=42\\,cm$" :question/worked-solution "For similar polygons, the ratios of lengths of the corresponding sides should be the same.\n\n- Let's check for this in option I:\n\n$$\n\\begin{aligned}\\frac{AB}{{A}^{′}{B}^{′}} & =\\frac{4}{16}=\\frac{1}{4}, \\\\ \\frac{BC}{{B}^{′}{C}^{′}} & =\\frac{6}{24}=\\frac{1}{4}\\,.\\end{aligned}\n$$\n\nSo, option I does give possible values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}.$\n\n- For option II, we have\n\n$$\n\\begin{aligned}\\frac{AB}{{A}^{′}{B}^{′}} & =\\frac{4}{20}=\\frac{1}{5}, \\\\ \\frac{BC}{{B}^{′}{C}^{′}} & =\\frac{6}{30}=\\frac{1}{5}\\,.\\end{aligned}\n$$\n\nSo, option II does give possible values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}.$\n\n- For option III, we have\n\n$$\n\\begin{aligned}\\frac{AB}{{A}^{′}{B}^{′}} & =\\frac{4}{32}=\\frac{1}{8}, \\\\ \\frac{BC}{{B}^{′}{C}^{′}} & =\\frac{6}{42}=\\frac{1}{7}\\,.\\end{aligned}\n$$\n\nSo, option III does not give possible values of ${A}^{′}{B}^{′}$ and ${B}^{′}{C}^{′}.$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186071546 :answer-field/correct 17592186071548 :db/ensure [:answer-field/validate]} {:db/id 17592186073913 :knowledge-point/questions ["question-5a648c7b-b62d-5742-8e25-e411a6e50067"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5a648c7b-b62d-5742-8e25-e411a6e50067" :question/id #uuid "5a648c7b-b62d-5742-8e25-e411a6e50067" :question/math-academy-id "q-88002" :question/problem "![](images/99/99212835e0eec95ac4ebd0c7d0fd49e1bb7e1a392f53251aa49510ac8ef5b65d.png)\n\nWhich of the above quadrilaterals are similar to $T$ (other than $T$ itself)?" :question/worked-solution "First, notice that $T$ is a right trapezoid with one pair of parallel opposite sides.\n\nWith that in mind, let's examine each of the given polygons.\n\n- $K$ is *not* similar to $T.$ The polygon $K$ is a right trapezoid, and the corresponding angles are congruent, but the ratios of the lengths of the corresponding sides are not the same: \n\n$$\n\\frac{7}{14}\\ne \\frac{6}{6}\n$$\n\n- $R$ is *not* similar to $T$ because $R$ is not a trapezoid (it's a rectangle since it has $2$ pairs of opposite parallel sides, and $2$ pairs of right angles).\n\n- $M$ is similar to $T.$ Indeed, $M$ is a right trapezoid. Furthermore, the corresponding angles are congruent, and the ratios of the lengths of the corresponding sides are the same:\n\n$$\n\\frac{7}{14}=\\frac{3}{6}\n$$\n\nTherefore, the correct answer is \"$M$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-865551b8-c0d8-5cf9-868e-7a602dfa6e44"] :db/ensure [:question/validate]} {:db/id "answer-field-865551b8-c0d8-5cf9-868e-7a602dfa6e44" :answer-field/id #uuid "865551b8-c0d8-5cf9-868e-7a602dfa6e44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54e63c6d-254e-54cc-8466-5d5bf3d74155" :answer-field/choices ["answer-c0715756-6c47-5bbc-ac2f-30e9b24661cd" "answer-5bdfd74e-ff63-5abb-9563-5fa157d583fd" "answer-8419996f-9e9b-515d-b6eb-d75dfba8906e" "answer-54e63c6d-254e-54cc-8466-5d5bf3d74155" "answer-3c8c637f-7506-5929-a813-aedf842eb2f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-c0715756-6c47-5bbc-ac2f-30e9b24661cd" :answer/id #uuid "c0715756-6c47-5bbc-ac2f-30e9b24661cd" :answer/type :answer.type/text :answer/value "$K$ and $M$ only" :db/ensure [:answer/validate]} {:db/id "answer-5bdfd74e-ff63-5abb-9563-5fa157d583fd" :answer/id #uuid "5bdfd74e-ff63-5abb-9563-5fa157d583fd" :answer/type :answer.type/text :answer/value "$K$ only" :db/ensure [:answer/validate]} {:db/id "answer-8419996f-9e9b-515d-b6eb-d75dfba8906e" :answer/id #uuid "8419996f-9e9b-515d-b6eb-d75dfba8906e" :answer/type :answer.type/text :answer/value "$M$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-54e63c6d-254e-54cc-8466-5d5bf3d74155" :answer/id #uuid "54e63c6d-254e-54cc-8466-5d5bf3d74155" :answer/type :answer.type/text :answer/value "$M$ only" :db/ensure [:answer/validate]} {:db/id "answer-3c8c637f-7506-5929-a813-aedf842eb2f5" :answer/id #uuid "3c8c637f-7506-5929-a813-aedf842eb2f5" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "activity-d340a7ac-67ef-5612-b337-ffb063b5d526" :activity/id #uuid "d340a7ac-67ef-5612-b337-ffb063b5d526" :activity/title "Similarity and Similar Polygons" :activity/type :activity.type/review :activity/scope 17592186049112 :activity/course 17592186046647 :activity/steps ["step-9a482e98-3882-5312-9956-5490d87f2d07" "step-4f04fdc1-79b6-5d81-b085-c044626bc257" "step-a8d4dd43-e6fc-58cb-b0ab-de5e3f09f025"] :activity/first-step "step-9a482e98-3882-5312-9956-5490d87f2d07" :db/ensure [:activity/validate]} {:db/id "step-9a482e98-3882-5312-9956-5490d87f2d07" :step/id #uuid "9a482e98-3882-5312-9956-5490d87f2d07" :step/content "question-889c45f8-a956-5ef6-ac2b-6cd191ad30dc" :step/next "step-4f04fdc1-79b6-5d81-b085-c044626bc257" :db/ensure [:step/validate]} {:db/id "step-4f04fdc1-79b6-5d81-b085-c044626bc257" :step/id #uuid "4f04fdc1-79b6-5d81-b085-c044626bc257" :step/content 17592186074218 :step/next "step-a8d4dd43-e6fc-58cb-b0ab-de5e3f09f025" :db/ensure [:step/validate]} {:db/id "step-a8d4dd43-e6fc-58cb-b0ab-de5e3f09f025" :step/id #uuid "a8d4dd43-e6fc-58cb-b0ab-de5e3f09f025" :step/content "question-5a648c7b-b62d-5742-8e25-e411a6e50067" :db/ensure [:step/validate]} {:db/id 17592186119926 :knowledge-point/questions ["question-4d8749ea-387f-52be-af2d-efee12373f36" "question-b0506b4c-4bb7-5b50-9f2e-88bb9d3c3ed6" "question-659cad17-10ef-5a6e-af0d-5c68299c5ad8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4d8749ea-387f-52be-af2d-efee12373f36" :question/id #uuid "4d8749ea-387f-52be-af2d-efee12373f36" :question/math-academy-id "q-156682" :question/problem "Let $L$ be the line with equation $x+y=1$ in ${R}^{2}.$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is **not** a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x \\\\ 1-x\\end{aligned}],\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $x+y=1:$\n\n$$\n\\begin{aligned}x+y & =1 \\\\ (0)+(0) & =1 \\\\ 0 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example, $a=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0+1 \\\\ 1+0\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n \nHowever, $[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\notin L$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}x+y & =1 \\\\ (1)+(1) & =1 \\\\ 2 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"IV only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7d8139c2-5f3f-5d4c-a02c-7713bd2ce796"] :db/ensure [:question/validate]} {:db/id "answer-field-7d8139c2-5f3f-5d4c-a02c-7713bd2ce796" :answer-field/id #uuid "7d8139c2-5f3f-5d4c-a02c-7713bd2ce796" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3aaac4dc-8cc1-5e8d-a4d0-c9f1414c29d0" :answer-field/choices ["answer-7c410928-3ce9-5370-862c-096ef43c12b9" "answer-611c61c9-2060-5668-8f8b-b62583834963" "answer-27b679e1-d8ce-51e5-9729-049a3614b190" "answer-c3520d96-4f07-5cf1-8505-57df5ffddb99" "answer-3aaac4dc-8cc1-5e8d-a4d0-c9f1414c29d0"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c410928-3ce9-5370-862c-096ef43c12b9" :answer/id #uuid "7c410928-3ce9-5370-862c-096ef43c12b9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-611c61c9-2060-5668-8f8b-b62583834963" :answer/id #uuid "611c61c9-2060-5668-8f8b-b62583834963" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-27b679e1-d8ce-51e5-9729-049a3614b190" :answer/id #uuid "27b679e1-d8ce-51e5-9729-049a3614b190" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-c3520d96-4f07-5cf1-8505-57df5ffddb99" :answer/id #uuid "c3520d96-4f07-5cf1-8505-57df5ffddb99" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "answer-3aaac4dc-8cc1-5e8d-a4d0-c9f1414c29d0" :answer/id #uuid "3aaac4dc-8cc1-5e8d-a4d0-c9f1414c29d0" :answer/type :answer.type/text :answer/value "IV only" :db/ensure [:answer/validate]} {:db/id "question-b0506b4c-4bb7-5b50-9f2e-88bb9d3c3ed6" :question/id #uuid "b0506b4c-4bb7-5b50-9f2e-88bb9d3c3ed6" :question/math-academy-id "q-157293" :question/problem "Let $L$ be the line with equation $2x-y=3$ in ${R}^{2}.$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x \\\\ 2x-3\\end{aligned}],\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $2x-y=3:$\n\n$$\n\\begin{aligned}2x-y & =3 \\\\ 2(0)-(0) & =3 \\\\ 0 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example, $a=[\\begin{aligned}0 \\\\ -3\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}0 \\\\ -3\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]=[\\begin{aligned}0+1 \\\\ -3-1\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\n \nHowever, $[\\begin{aligned}1 \\\\ -4\\end{aligned}]\\notin L$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}2x-y & =3 \\\\ 2(1)-(-4) & =3 \\\\ 6 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is false. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"None of the statements are true.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a7b047d0-d015-53e1-8720-01100b323493"] :db/ensure [:question/validate]} {:db/id "answer-field-a7b047d0-d015-53e1-8720-01100b323493" :answer-field/id #uuid "a7b047d0-d015-53e1-8720-01100b323493" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c7873f66-26a0-59de-9a80-d3b3617f5997" :answer-field/choices ["answer-aaf8be50-2dcb-53c5-b934-278e3226720a" "answer-e9d96ee1-5b25-51c2-816d-45db597b2b2c" "answer-c017120c-6cc9-5db6-9d68-80c622f3d73c" "answer-9461a998-4cc2-5192-a97d-04cf50c8bd74" "answer-c7873f66-26a0-59de-9a80-d3b3617f5997"] :db/ensure [:answer-field/validate]} {:db/id "answer-aaf8be50-2dcb-53c5-b934-278e3226720a" :answer/id #uuid "aaf8be50-2dcb-53c5-b934-278e3226720a" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-e9d96ee1-5b25-51c2-816d-45db597b2b2c" :answer/id #uuid "e9d96ee1-5b25-51c2-816d-45db597b2b2c" :answer/type :answer.type/text :answer/value "I and IV only" :db/ensure [:answer/validate]} {:db/id "answer-c017120c-6cc9-5db6-9d68-80c622f3d73c" :answer/id #uuid "c017120c-6cc9-5db6-9d68-80c622f3d73c" :answer/type :answer.type/text :answer/value "I, II, and III only" :db/ensure [:answer/validate]} {:db/id "answer-9461a998-4cc2-5192-a97d-04cf50c8bd74" :answer/id #uuid "9461a998-4cc2-5192-a97d-04cf50c8bd74" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c7873f66-26a0-59de-9a80-d3b3617f5997" :answer/id #uuid "c7873f66-26a0-59de-9a80-d3b3617f5997" :answer/type :answer.type/text :answer/value "None of the statements are true" :db/ensure [:answer/validate]} {:db/id "question-659cad17-10ef-5a6e-af0d-5c68299c5ad8" :question/id #uuid "659cad17-10ef-5a6e-af0d-5c68299c5ad8" :question/math-academy-id "q-156650" :question/problem "Let $L$ be the line with equation $3x+y=4$ in ${R}^{2}.$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is **not** a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x \\\\ -3x+4\\end{aligned}],\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The coordinates of the zero-vector do not satisfy the equation $y=-3x+4:$\n\n$$\n\\begin{aligned}y & =-3x+4 \\\\ (0) & =-3(0)+4 \\\\ 0 & =4\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let, for example,$a=[\\begin{aligned}0 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ from $L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}0 \\\\ 4\\end{aligned}]+[\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0+1 \\\\ 4+1\\end{aligned}]=[\\begin{aligned}1 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\n \nHowever, $[\\begin{aligned}1 \\\\ 5\\end{aligned}]\\notin L$ since substituting the coordinates into the equation, we obtain the following: \n\n$$\n\\begin{aligned}y & =-3x+4 \\\\ (5) & =-3(1)+4 \\\\ 5 & =1\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin L,$ this set is not closed under scalar multiplication.\n\n- Statement IV is true. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"IV only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f2d8f279-2cfe-5521-bbd6-ad8903d4bc62"] :db/ensure [:question/validate]} {:db/id "answer-field-f2d8f279-2cfe-5521-bbd6-ad8903d4bc62" :answer-field/id #uuid "f2d8f279-2cfe-5521-bbd6-ad8903d4bc62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-daa59206-3a60-5124-961d-56dd6e50b326" :answer-field/choices ["answer-3ebd4668-8267-5d3a-b4f4-d5cbfd1c4329" "answer-66e85388-f612-522c-bc5e-3676641770ea" "answer-7a79477f-76f5-54d3-8cfb-e2dac391c8d3" "answer-f01111f4-c13f-5cd1-8954-a88c666d6100" "answer-daa59206-3a60-5124-961d-56dd6e50b326"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ebd4668-8267-5d3a-b4f4-d5cbfd1c4329" :answer/id #uuid "3ebd4668-8267-5d3a-b4f4-d5cbfd1c4329" :answer/type :answer.type/text :answer/value "I  and IV only" :db/ensure [:answer/validate]} {:db/id "answer-66e85388-f612-522c-bc5e-3676641770ea" :answer/id #uuid "66e85388-f612-522c-bc5e-3676641770ea" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-7a79477f-76f5-54d3-8cfb-e2dac391c8d3" :answer/id #uuid "7a79477f-76f5-54d3-8cfb-e2dac391c8d3" :answer/type :answer.type/text :answer/value "II and IV only" :db/ensure [:answer/validate]} {:db/id "answer-f01111f4-c13f-5cd1-8954-a88c666d6100" :answer/id #uuid "f01111f4-c13f-5cd1-8954-a88c666d6100" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-daa59206-3a60-5124-961d-56dd6e50b326" :answer/id #uuid "daa59206-3a60-5124-961d-56dd6e50b326" :answer/type :answer.type/text :answer/value "IV only" :db/ensure [:answer/validate]} {:db/id 17592186121126 :tutorial/content "A **subspace** of $\\mathbb{R}^n$ is a subset of $\\mathbb R^n$ that is closed  under vector addition and scalar multiplication. In other words: \n\n$H\\subseteq \\mathbb R^n$ is a subspace of $\\mathbb{R}^n$ if and only if it satisfies the following properties:\n\n- *Closure under vector addition:* \n\n$\\qquad$ If $\\mathbf{u}$ and $\\mathbf{v}$ are in $H,$ then their sum $\\mathbf{u}+\\mathbf{v}$ is also in $H.$\n\n- *Closure under scalar multiplication:* \n\n$\\qquad$ If $\\mathbf{u}$ is in $H,$ then $c\\cdot \\mathbf{u}$ is also in $H$ for any scalar number $c.$\n\nFor example, consider the line $L$ with equation $y=3x$ in $\\mathbb{R}^2.$ Is $L$ a subspace of $\\mathbb{R}^2?$ \n\nFirst, notice that we can express the points on $L$ as the following set:\n\n![](images/1f/1f380f9928da2dd44ff157a72fce97c02ae44626df515d52ece6ff5feee302d2.svg)\n\nIn other words, $L$ contains all vectors of the form ![](images/90/90996c2ffae29c3bd9cd3ab398cca4dd7e1b8fbe275de8520a72a16e504fb0f3.svg) where $x$ is a real number.\n\nTo determine whether $L$ is a subspace of $\\mathbb R^2,$ we need to check the two conditions above. \n\n- Let's pick two arbitrary vectors in $L,$ namely, ![](images/59/59be22e80d0be32c84a8c2bdb2f2c96b23a0941d4aba26bdefa078fd299c137c.svg) and ![](images/d7/d78ea4fcfbd469e88b7fe46e28ac6f396a538c577f4defdd1b3d60e60df3c4b7.svg) If we compute their sum, we get\n\n$$\n\\begin{aligned}u+v & =[\\begin{aligned}{u}_{1} \\\\ 3{u}_{1}\\end{aligned}]+[\\begin{aligned}{v}_{1} \\\\ 3{v}_{1}\\end{aligned}] \\\\  & =[\\begin{aligned}{u}_{1}+{v}_{1} \\\\ 3{u}_{1}+3{v}_{1}\\end{aligned}] \\\\  & =[\\begin{aligned}{u}_{1}+{v}_{1} \\\\ 3\\cdot ({u}_{1}+{v}_{1})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $y=3x.$ Therefore, $\\mathbf{u}+\\mathbf{v} \\in L. \\quad {\\color{green}\\checkmark}$\n\n- Let's pick an arbitrary vector in $L,$ namely, ![](images/75/759c7883ad2772f20a090ad2f8c5dfe01031ca31e2b5f0e7681c945c9256c91d.svg) Then, for any scalar $c$ we have\n\n$$\n\\begin{aligned}c\\cdot u & =c\\cdot [\\begin{aligned}{u}_{1} \\\\ 3{u}_{1}\\end{aligned}] \\\\  & =[\\begin{aligned}c{u}_{1} \\\\ 3\\cdot c{u}_{1}\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $y=3x.$ Therefore, $c\\cdot \\mathbf{u}\\in L. \\quad {\\color{green}\\checkmark}$\n\nThe set $L$ satisfies both conditions. So, we can conclude that it is a subspace of $\\mathbb{R}^2.$\n\n**Note:** Since the second condition must be satisfied for any $c,$ including $c=0,$ we can conclude that every subspace must contain the zero vector $\\mathbf{0}.$ So, if a set does not contain $\\mathbf{0}$ then it is *not* a subspace of $\\mathbb{R}^n.$\n\nFor instance, the set \n\n![](images/a1/a15e0b4fc4544421e572d15b8fd016c3fa8721e0ecf3f8808a469c3252d1f6d6.svg)\n\ndoes *not* contain the zero vector (since $0 \\neq 0 + 1$), and consequently it is *not* a subspace of $\\mathbb{R}^2.$" :db/ensure [:tutorial/validate]} {:db/id 17592186121127 :tutorial/content "Recall that $H$ is a subspace of $\\mathbb{R}^n$ if and only if it satisfies the following properties:\n\n*Closure under vector addition:* \n\n $\\qquad$ If $\\mathbf{u}$ and $\\mathbf{v}$ are in $H,$ then their sum $\\mathbf{u}+\\mathbf{v}$ is also in $H.$\n\n*Closure under scalar multiplication:* \n\n $\\qquad$ If $\\mathbf{u}$ is in $H,$ then $c\\cdot \\mathbf{u}$ is also in $H$ for any scalar number $c.$\n\nLet $L$ be the line in $\\mathbb{R}^3$ that passes through the points $(0,0,0)$ and $(4,1,-2).$ Is $L$ a subspace of $\\mathbb{R}^3?$ \n\nFirst, note that the direction vector of the line $L$ is \n![](images/25/25fa34994b33e0d11fd8990dddbfda276857e699018b4701c6e2eaf13acb0c20.svg)\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]+t[\\begin{aligned}4 \\\\ 1 \\\\ -2\\end{aligned}]=[\\begin{aligned}4t \\\\ t \\\\ -2t\\end{aligned}]\\end{aligned}\n$$\n\nfor $t\\in\\mathbb R,$ and the corresponding Cartesian equation is \n\n$$\n\\dfrac x4=y=\\dfrac z{-2}.\n$$\n\nTo determine whether $L$ is a subspace, we need to check the two conditions above:\n\n- Let's pick two arbitrary vectors in $L,$ namely, ![](images/d7/d7f1a3cf1625ff12bc96324dc428e1c95d271d8a72de603b671f722b9173281d.svg) and ![](images/25/255fc61225b017a51ae60b1d157787ac4b60fe596ebaa8296b48053b87b2eae7.svg) If we compute their sum, we get\n\n$$\n\\begin{aligned}u+v & =[\\begin{aligned}4{u}_{1} \\\\ {u}_{1} \\\\ -2{u}_{1}\\end{aligned}]+[\\begin{aligned}4{v}_{1} \\\\ {v}_{1} \\\\ -2{v}_{1}\\end{aligned}] \\\\  & =[\\begin{aligned}4{u}_{1}+4{v}_{1} \\\\ {u}_{1}+{v}_{1} \\\\ (-2{u}_{1})+(-2{v}_{1})\\end{aligned}] \\\\  & =[\\begin{aligned}4\\cdot ({u}_{1}+{v}_{1}) \\\\ {u}_{1}+{v}_{1} \\\\ (-2)\\cdot ({u}_{1}+{v}_{1})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $\\dfrac x4=y=\\dfrac z{-2}.$ Therefore, $\\mathbf{u}+\\mathbf{v}\\in L. \\quad {\\color{green}\\checkmark}$\n\n- Let's pick an arbitrary vector in $L,$ namely, ![](images/7f/7f7df4272eae1975b5802d54dfae499c528661ba0ae82faff45bb26f6cfab276.svg) Then, for any scalar $c,$ we have\n\n$$\n\\begin{aligned}c\\cdot u & =c\\cdot [\\begin{aligned}4{u}_{1} \\\\ {u}_{1} \\\\ -2{u}_{1}\\end{aligned}] \\\\  & =[\\begin{aligned}4\\cdot c{u}_{1} \\\\ c{u}_{1} \\\\ (-2)\\cdot c{u}_{1}\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $\\dfrac x4=y=\\dfrac z{-2}.$ Therefore, $c\\cdot \\mathbf{u}\\in L. \\quad {\\color{green}\\checkmark}$\n\nThe set $L$ satisfies both conditions. So, we can conclude that it is a subspace of $\\mathbb{R}^3.$" :db/ensure [:tutorial/validate]} {:db/id 17592186121128 :tutorial/content "Again, recall that $H$ is a subspace of $\\mathbb{R}^n$ if and only if it satisfies the following properties:\n\n- *Closure under vector addition:* \n\n$\\qquad$ If $\\mathbf{u}$ and $\\mathbf{v}$ are in $H,$ then their sum $\\mathbf{u}+\\mathbf{v}$ is also in $H.$\n\n- *Closure under scalar multiplication:* \n\n$\\qquad$ If $\\mathbf{u}$ is in $H,$ then $c\\cdot \\mathbf{u}$ is also in $H$ for any scalar number $c.$\n\nConsider the plane $\\Pi$ with equation $z=4x-2y$ in $\\mathbb{R}^3.$ \n\nNotice that $\\Pi$ contains vectors of the form \n\n![](images/95/956757aa0ce5b4721db582cd9d03dffaa21b1fdf6f8c60b5c6465f9cf012201d.svg)\n\nIs $\\Pi$ a subspace of $\\mathbb{R}^3?$ To find out, we need to check the two conditions above. \n\n- Let's pick two arbitrary vectors in $\\Pi,$ namely, ![](images/da/da46ac38012b220c5cf956076a81b76a21eb1242d21fae69f071531401d5d41d.svg) and ![](images/3e/3ee33188044335cd84f42b7621a5d255fdab972d89bef3d816c2b5a4da93dab0.svg) If we compute their sum, we get\n\n$$\n\\begin{aligned}u+v & =[\\begin{aligned}{u}_{1} \\\\ {u}_{2} \\\\ 4{u}_{1}-2{u}_{2}\\end{aligned}]+[\\begin{aligned}{v}_{1} \\\\ {v}_{2} \\\\ 4{v}_{1}-2{v}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{u}_{1}+{v}_{1} \\\\ {u}_{2}+{v}_{2} \\\\ 4{u}_{1}-2{u}_{2}+4{v}_{1}-2{v}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{u}_{1}+{v}_{1} \\\\ {u}_{2}+{v}_{2} \\\\ 4\\cdot ({u}_{1}+{v}_{1})-2\\cdot ({u}_{2}+{v}_{2})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=4x-2y.$ Therefore, $\\mathbf{u}+\\mathbf{v}\\in \\Pi. \\quad {\\color{green}\\checkmark}$\n\n- Let's pick an arbitrary vector in $\\Pi,$ say, ![](images/27/277ea18a8e1721fdaa880025e3abb4fcb1ff3e8ec96730ca7597fbd584ef6500.svg) Then, for any scalar $c$ we have\n\n$$\n\\begin{aligned}c\\cdot u & =c\\cdot [\\begin{aligned}{u}_{1} \\\\ {u}_{2} \\\\ 4{u}_{1}-2{u}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}c{u}_{1} \\\\ c{u}_{2} \\\\ 4\\cdot c{u}_{1}-2\\cdot c{u}_{2}\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=4x-2y.$ Therefore, $c\\cdot \\mathbf{u}\\in \\Pi. \\quad {\\color{green}\\checkmark}$\n\nThe set $\\Pi$ satisfies both conditions. So, we can conclude that it is a subspace of $\\mathbb{R}^3.$" :db/ensure [:tutorial/validate]} {:db/id "activity-a33f7cdf-c097-51ce-a889-89b173e9d05f" :activity/id #uuid "a33f7cdf-c097-51ce-a889-89b173e9d05f" :activity/title "Singular Value Decomposition of 2x2 Matrices" :activity/type :activity.type/review :activity/scope 17592186050726 :activity/course 17592186046660 :activity/steps ["step-33df4382-d71f-54aa-802f-de21b261aecd" "step-efda492f-25e3-5015-b6b0-eea97e75b0a2" "step-83da4fcb-da5c-5ebd-a4f5-98796e047c6f" "step-0daf925a-435b-5aa2-8acf-a1aac6e83791" "step-87122226-7320-5d34-b3e1-309f1140548c"] :activity/first-step "step-33df4382-d71f-54aa-802f-de21b261aecd" :db/ensure [:activity/validate]} {:db/id "step-33df4382-d71f-54aa-802f-de21b261aecd" :step/id #uuid "33df4382-d71f-54aa-802f-de21b261aecd" :step/content 17592186496274 :step/next "step-efda492f-25e3-5015-b6b0-eea97e75b0a2" :db/ensure [:step/validate]} {:db/id "step-efda492f-25e3-5015-b6b0-eea97e75b0a2" :step/id #uuid "efda492f-25e3-5015-b6b0-eea97e75b0a2" :step/content 17592186371332 :step/next "step-83da4fcb-da5c-5ebd-a4f5-98796e047c6f" :db/ensure [:step/validate]} {:db/id "step-83da4fcb-da5c-5ebd-a4f5-98796e047c6f" :step/id #uuid "83da4fcb-da5c-5ebd-a4f5-98796e047c6f" :step/content 17592186395121 :step/next "step-0daf925a-435b-5aa2-8acf-a1aac6e83791" :db/ensure [:step/validate]} {:db/id "step-0daf925a-435b-5aa2-8acf-a1aac6e83791" :step/id #uuid "0daf925a-435b-5aa2-8acf-a1aac6e83791" :step/content 17592186520509 :step/next "step-87122226-7320-5d34-b3e1-309f1140548c" :db/ensure [:step/validate]} {:db/id "step-87122226-7320-5d34-b3e1-309f1140548c" :step/id #uuid "87122226-7320-5d34-b3e1-309f1140548c" :step/content 17592186418154 :db/ensure [:step/validate]} {:db/id "activity-8715c487-0b12-5327-aa8b-9187744e1a6c" :activity/id #uuid "8715c487-0b12-5327-aa8b-9187744e1a6c" :activity/title "Singular Value Decomposition of 2x2 Matrices With Zero or Repeated Eigenvalues" :activity/type :activity.type/review :activity/scope 17592186050770 :activity/course 17592186046660 :activity/steps ["step-a2b97ba0-88ba-5adf-8f05-540740493628" "step-f5f5f202-5c86-5ea3-a306-5e1e5c5e460b" "step-e90e878c-5226-5e47-bf76-b85f9ac367fc" "step-812c0b8f-47ec-5265-9084-b51205ac80ef" "step-438937b8-08ef-597d-b9ab-e914eb2bdd23"] :activity/first-step "step-a2b97ba0-88ba-5adf-8f05-540740493628" :db/ensure [:activity/validate]} {:db/id "step-a2b97ba0-88ba-5adf-8f05-540740493628" :step/id #uuid "a2b97ba0-88ba-5adf-8f05-540740493628" :step/content 17592186404843 :step/next "step-f5f5f202-5c86-5ea3-a306-5e1e5c5e460b" :db/ensure [:step/validate]} {:db/id "step-f5f5f202-5c86-5ea3-a306-5e1e5c5e460b" :step/id #uuid "f5f5f202-5c86-5ea3-a306-5e1e5c5e460b" :step/content 17592186371374 :step/next "step-e90e878c-5226-5e47-bf76-b85f9ac367fc" :db/ensure [:step/validate]} {:db/id "step-e90e878c-5226-5e47-bf76-b85f9ac367fc" :step/id #uuid "e90e878c-5226-5e47-bf76-b85f9ac367fc" :step/content 17592186167466 :step/next "step-812c0b8f-47ec-5265-9084-b51205ac80ef" :db/ensure [:step/validate]} {:db/id "step-812c0b8f-47ec-5265-9084-b51205ac80ef" :step/id #uuid "812c0b8f-47ec-5265-9084-b51205ac80ef" :step/content 17592186167468 :step/next "step-438937b8-08ef-597d-b9ab-e914eb2bdd23" :db/ensure [:step/validate]} {:db/id "step-438937b8-08ef-597d-b9ab-e914eb2bdd23" :step/id #uuid "438937b8-08ef-597d-b9ab-e914eb2bdd23" :step/content 17592186383452 :db/ensure [:step/validate]} {:db/id 17592186124611 :knowledge-point/questions ["question-602e236f-f7ee-52d9-b1ca-e9d90f7ae370" "question-17eec8d8-70be-5d2a-8c5e-928ea708ee3b" "question-a261cf1f-d1e0-58d8-b832-e9ddda3c5b83"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124606 :knowledge-point/questions ["question-6547ba2d-be83-5b17-a5ce-a14f2d6a7139" "question-90802828-69ad-5b22-b55e-e0d3346dd2ca"] :db/ensure [:knowledge-point/validate]} {:db/id "question-602e236f-f7ee-52d9-b1ca-e9d90f7ae370" :question/id #uuid "602e236f-f7ee-52d9-b1ca-e9d90f7ae370" :question/math-academy-id "q-105765" :question/problem "Let $f(x,y,z)$ be a function that is differentiable at each point on the line segment $\\overset{―}{AB},$ where $a=⟨2,-1,3⟩$ and $b=⟨3,-1,1⟩$ are the position vectors of $A$ and $B,$ respectively. If $f(a)=6$ and $f(b)=2,$ then what is missing from the statement below?\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that $\\text{_______________}\\,.$ *" :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nIn our case, we have \n\n$$\n\\begin{aligned}f(b)-f(a) & =∇f(c)\\cdot (b-a) \\\\ 2-6 & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot (⟨3,-1,1⟩-⟨2,-1,3⟩) \\\\ -4 & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot ⟨1,0,-2⟩ \\\\ -4 & ={f}_{x}(c)-2{f}_{z}(c).\\end{aligned}\n$$\n\nTherefore, the complete sentence is as follows:\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that ${f}_{x}(c)-2{f}_{z}(c)=-4.$ *" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9e1c7f39-4e9f-5c82-b6fa-abd61898eb6e"] :db/ensure [:question/validate]} {:db/id "answer-field-9e1c7f39-4e9f-5c82-b6fa-abd61898eb6e" :answer-field/id #uuid "9e1c7f39-4e9f-5c82-b6fa-abd61898eb6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e85f9d44-f329-5e20-aaa4-f71caa80370d" :answer-field/choices ["answer-77ea2481-3641-5d62-90a6-8b6caf3cf8c1" "answer-e2c4e6f4-8acc-5247-8b67-ba9dc37255f8" "answer-dfbff4da-22a8-5978-8ab8-a17622d4fde0" "answer-f9fb1752-c3b8-5541-93ef-2714c93c51b4" "answer-e85f9d44-f329-5e20-aaa4-f71caa80370d"] :db/ensure [:answer-field/validate]} {:db/id "answer-77ea2481-3641-5d62-90a6-8b6caf3cf8c1" :answer/id #uuid "77ea2481-3641-5d62-90a6-8b6caf3cf8c1" :answer/type :answer.type/math :answer/value "2{f}_{x}(c)-{f}_{z}(c)=8" :db/ensure [:answer/validate]} {:db/id "answer-e2c4e6f4-8acc-5247-8b67-ba9dc37255f8" :answer/id #uuid "e2c4e6f4-8acc-5247-8b67-ba9dc37255f8" :answer/type :answer.type/math :answer/value "{f}_{x}(c)+{f}_{y}(c)-2{f}_{z}(c)=-4" :db/ensure [:answer/validate]} {:db/id "answer-dfbff4da-22a8-5978-8ab8-a17622d4fde0" :answer/id #uuid "dfbff4da-22a8-5978-8ab8-a17622d4fde0" :answer/type :answer.type/math :answer/value "{f}_{x}(c)-2{f}_{y}(c)+{f}_{z}(c)=8" :db/ensure [:answer/validate]} {:db/id "answer-f9fb1752-c3b8-5541-93ef-2714c93c51b4" :answer/id #uuid "f9fb1752-c3b8-5541-93ef-2714c93c51b4" :answer/type :answer.type/math :answer/value "{f}_{x}(c)-2{f}_{y}(c)=-4" :db/ensure [:answer/validate]} {:db/id "answer-e85f9d44-f329-5e20-aaa4-f71caa80370d" :answer/id #uuid "e85f9d44-f329-5e20-aaa4-f71caa80370d" :answer/type :answer.type/math :answer/value "{f}_{x}(c)-2{f}_{z}(c)=-4" :db/ensure [:answer/validate]} {:db/id "question-17eec8d8-70be-5d2a-8c5e-928ea708ee3b" :question/id #uuid "17eec8d8-70be-5d2a-8c5e-928ea708ee3b" :question/math-academy-id "q-130834" :question/problem "Let $f(x,y,z)$ be a function that is differentiable at each point on the line segment $\\overset{―}{AB},$ where $a=⟨1,0,2⟩$ and $b=⟨0,2,3⟩$ are the position vectors of $A$ and $B,$ respectively. If $f(a)=-2$ and $f(b)=5,$ then what is missing from the statement below?\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that $\\text{_______________}\\,.$ *" :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nIn our case, we have \n\n$$\n\\begin{aligned}f(b)-f(a) & =∇f(c)\\cdot (b-a) \\\\ 5-(-2) & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot (⟨0,2,3⟩-⟨1,0,2⟩) \\\\ 7 & =⟨{f}_{x}(c),{f}_{y}(c),{f}_{z}(c)⟩\\cdot ⟨-1,2,1⟩ \\\\ 7 & =-{f}_{x}(c)+2{f}_{y}(c)+{f}_{z}(c).\\end{aligned}\n$$\n\nTherefore, the complete sentence is as follows:\n\n*The mean value theorem states that there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that ${f}_{x}(c)-2{f}_{y}(c)-{f}_{z}(c)=-7.$ *" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4dc25338-e3f2-565d-8f71-40061dd4364a"] :db/ensure [:question/validate]} {:db/id "answer-field-4dc25338-e3f2-565d-8f71-40061dd4364a" :answer-field/id #uuid "4dc25338-e3f2-565d-8f71-40061dd4364a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-754bba4a-fb4d-5db6-b459-3248551d0a50" :answer-field/choices ["answer-1794b49b-1f1d-51f2-bedf-3e99b67fa251" "answer-e263679e-0346-5705-aeb7-b8a5c54c9770" "answer-754bba4a-fb4d-5db6-b459-3248551d0a50" "answer-261c21c2-d16a-58fe-a2ee-2828cc3a3b5f" "answer-06b2b739-da94-553c-b42f-0bb5d830c78c"] :db/ensure [:answer-field/validate]} {:db/id "answer-1794b49b-1f1d-51f2-bedf-3e99b67fa251" :answer/id #uuid "1794b49b-1f1d-51f2-bedf-3e99b67fa251" :answer/type :answer.type/math :answer/value "-2{f}_{x}(c)+{f}_{y}(c)-5{f}_{z}(c)=2" :db/ensure [:answer/validate]} {:db/id "answer-e263679e-0346-5705-aeb7-b8a5c54c9770" :answer/id #uuid "e263679e-0346-5705-aeb7-b8a5c54c9770" :answer/type :answer.type/math :answer/value "-4{f}_{x}(c)+2{f}_{y}(c)+3{f}_{z}(c)=5" :db/ensure [:answer/validate]} {:db/id "answer-754bba4a-fb4d-5db6-b459-3248551d0a50" :answer/id #uuid "754bba4a-fb4d-5db6-b459-3248551d0a50" :answer/type :answer.type/math :answer/value "-{f}_{x}(c)+2{f}_{y}(c)+{f}_{z}(c)=7" :db/ensure [:answer/validate]} {:db/id "answer-261c21c2-d16a-58fe-a2ee-2828cc3a3b5f" :answer/id #uuid "261c21c2-d16a-58fe-a2ee-2828cc3a3b5f" :answer/type :answer.type/math :answer/value "3{f}_{x}(c)-3{f}_{y}(c)-2{f}_{z}(c)=4" :db/ensure [:answer/validate]} {:db/id "answer-06b2b739-da94-553c-b42f-0bb5d830c78c" :answer/id #uuid "06b2b739-da94-553c-b42f-0bb5d830c78c" :answer/type :answer.type/math :answer/value "{f}_{x}(c)-{f}_{y}(c)+2{f}_{z}(c)=-1" :db/ensure [:answer/validate]} {:db/id "question-a261cf1f-d1e0-58d8-b832-e9ddda3c5b83" :question/id #uuid "a261cf1f-d1e0-58d8-b832-e9ddda3c5b83" :question/math-academy-id "q-105745" :question/problem "Let $f(x,y)$ be a function that is differentiable at each point on the line segment $\\overset{―}{AB},$ where $a=⟨2,5⟩$ and $b=⟨3,-2⟩$ are the position vectors of $A$ and $B,$ respectively. If $f(a)=-3$ and $f(b)=5,$ then according to the mean value theorem, which of the following must be true for some point $C\\in \\overset{―}{AB}$ with position vector $c?$" :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}f(b)-f(a) & =∇f(c)·(b-a) \\\\ 5-(-3) & =⟨{f}_{x}(c),{f}_{y}(c)⟩\\cdot (⟨3,-2⟩-⟨2,5⟩) \\\\ 8 & =⟨{f}_{x}(c),{f}_{y}(c)⟩\\cdot ⟨1,-7⟩ \\\\ 8 & ={f}_{x}(c)-7{f}_{y}(c).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-63dbf298-8043-509c-939e-873fdfa9afc9"] :db/ensure [:question/validate]} {:db/id "answer-field-63dbf298-8043-509c-939e-873fdfa9afc9" :answer-field/id #uuid "63dbf298-8043-509c-939e-873fdfa9afc9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bc0ddb38-2274-5275-a53e-375a42e5487d" :answer-field/choices ["answer-3515ef3b-1145-5a2c-83ec-ef4b995ee066" "answer-ed84c972-9d23-59fb-87df-f4c078367fa1" "answer-2e91ee75-c53a-5920-9a45-5ccb0a2e7cba" "answer-7d424855-c52c-5f97-848a-81dd93164aaa" "answer-bc0ddb38-2274-5275-a53e-375a42e5487d"] :db/ensure [:answer-field/validate]} {:db/id "answer-3515ef3b-1145-5a2c-83ec-ef4b995ee066" :answer/id #uuid "3515ef3b-1145-5a2c-83ec-ef4b995ee066" :answer/type :answer.type/math :answer/value "-2{f}_{x}(c)+5{f}_{y}(c)=8" :db/ensure [:answer/validate]} {:db/id "answer-ed84c972-9d23-59fb-87df-f4c078367fa1" :answer/id #uuid "ed84c972-9d23-59fb-87df-f4c078367fa1" :answer/type :answer.type/math :answer/value "-{f}_{x}(c)+7{f}_{y}(c)=-2" :db/ensure [:answer/validate]} {:db/id "answer-2e91ee75-c53a-5920-9a45-5ccb0a2e7cba" :answer/id #uuid "2e91ee75-c53a-5920-9a45-5ccb0a2e7cba" :answer/type :answer.type/math :answer/value "-{f}_{x}(c)+7{f}_{y}(c)=2" :db/ensure [:answer/validate]} {:db/id "answer-7d424855-c52c-5f97-848a-81dd93164aaa" :answer/id #uuid "7d424855-c52c-5f97-848a-81dd93164aaa" :answer/type :answer.type/math :answer/value "7{f}_{x}(c)-{f}_{y}(c)=8" :db/ensure [:answer/validate]} {:db/id "answer-bc0ddb38-2274-5275-a53e-375a42e5487d" :answer/id #uuid "bc0ddb38-2274-5275-a53e-375a42e5487d" :answer/type :answer.type/math :answer/value "{f}_{x}(c)-7{f}_{y}(c)=8" :db/ensure [:answer/validate]} {:db/id "question-6547ba2d-be83-5b17-a5ce-a14f2d6a7139" :question/id #uuid "6547ba2d-be83-5b17-a5ce-a14f2d6a7139" :question/math-academy-id "q-106068" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y)={y}^{2}-{x}^{2}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,1⟩$ and $b=⟨3,7⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)={y}^{2}-{x}^{2}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,1⟩$ and $b=⟨3,7⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(3,7)-f(0,1) & =∇f(c)\\cdot (⟨3,7⟩-⟨0,1⟩) \\\\ ({7}^{2}-{3}^{2})-({1}^{2}-{0}^{2}) & =∇f(c)\\cdot ⟨3,6⟩ \\\\ 39 & =∇f(c)\\cdot ⟨3,6⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨-2x,2y⟩, \\\\ ∇f(c) & =⟨-2{c}_{1},2{c}_{2}⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}39 & =∇f⟨c⟩\\cdot ⟨3,6⟩ \\\\ 39 & =⟨-2{c}_{1},2{c}_{2}⟩\\cdot ⟨3,6⟩ \\\\ 39 & =-6{c}_{1}+12{c}_{2} \\\\ 13 & =-2{c}_{1}+4{c}_{2}\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-1}{7-1} & =\\frac{x-0}{3-0} \\\\ \\frac{y-1}{6} & =\\frac{x}{3} \\\\ y-1 & =2x \\\\ y & =2x+1.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =2{c}_{1}+1.\\end{aligned}\n$$\n\nSubstituting the above into the equation $-2{c}_{1}+4{c}_{2}=13,$ we get \n\n$$\n\\begin{aligned}-2{c}_{1}+4(2{c}_{1}+1) & =13 \\\\ -2{c}_{1}+8{c}_{1}+4 & =13 \\\\ 6{c}_{1} & =9 \\\\ {c}_{1} & =\\frac{3}{2}.\\end{aligned}\n$$\n\nFinally, we find ${c}_{2}=2{c}_{1}+1=4.$ So, the point $C$ that satisfies the mean value theorem is $(\\frac{3}{2},4).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-de865212-4382-5303-8e7d-34adf3e8bc14"] :db/ensure [:question/validate]} {:db/id "answer-field-de865212-4382-5303-8e7d-34adf3e8bc14" :answer-field/id #uuid "de865212-4382-5303-8e7d-34adf3e8bc14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-217dd2de-918f-5112-b69d-bfbe04aa4177" :answer-field/choices ["answer-e908e1ac-36c7-569f-adae-97102cdf51d7" "answer-b81437b6-492a-5768-8149-02555c33e13b" "answer-1be1a0af-86dc-5ce9-b9dd-45a2a74d1d04" "answer-217dd2de-918f-5112-b69d-bfbe04aa4177" "answer-3731b121-3d08-5491-b0f5-428c1d0c462f"] :db/ensure [:answer-field/validate]} {:db/id "answer-e908e1ac-36c7-569f-adae-97102cdf51d7" :answer/id #uuid "e908e1ac-36c7-569f-adae-97102cdf51d7" :answer/type :answer.type/math :answer/value "(1,3)" :db/ensure [:answer/validate]} {:db/id "answer-b81437b6-492a-5768-8149-02555c33e13b" :answer/id #uuid "b81437b6-492a-5768-8149-02555c33e13b" :answer/type :answer.type/math :answer/value "(2,5)" :db/ensure [:answer/validate]} {:db/id "answer-1be1a0af-86dc-5ce9-b9dd-45a2a74d1d04" :answer/id #uuid "1be1a0af-86dc-5ce9-b9dd-45a2a74d1d04" :answer/type :answer.type/math :answer/value "(\\frac{1}{2},2)" :db/ensure [:answer/validate]} {:db/id "answer-217dd2de-918f-5112-b69d-bfbe04aa4177" :answer/id #uuid "217dd2de-918f-5112-b69d-bfbe04aa4177" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},4)" :db/ensure [:answer/validate]} {:db/id "answer-3731b121-3d08-5491-b0f5-428c1d0c462f" :answer/id #uuid "3731b121-3d08-5491-b0f5-428c1d0c462f" :answer/type :answer.type/math :answer/value "(\\frac{5}{2},6)" :db/ensure [:answer/validate]} {:db/id "question-90802828-69ad-5b22-b55e-e0d3346dd2ca" :question/id #uuid "90802828-69ad-5b22-b55e-e0d3346dd2ca" :question/math-academy-id "q-106066" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y)=xy$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,0⟩$ and $b=⟨2,4⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)=xy$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,0⟩$ and $b=⟨2,4⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(2,4)-f(0,0) & =∇f(c)\\cdot (⟨2,4⟩-⟨0,0⟩) \\\\ 2(4)-0(0) & =∇f(c)\\cdot ⟨2,4⟩ \\\\ 8 & =∇f(c)\\cdot ⟨2,4⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨y,x⟩, \\\\ ∇f(c) & =⟨{c}_{2},{c}_{1}⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}8 & =∇f⟨c⟩\\cdot ⟨2,4⟩ \\\\ 8 & =⟨{c}_{2},{c}_{1}⟩\\cdot ⟨2,4⟩ \\\\ 8 & =2{c}_{2}+4{c}_{1} \\\\ 4 & ={c}_{2}+2{c}_{1}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-0}{4-0} & =\\frac{x-0}{2-0} \\\\ \\frac{y}{4} & =\\frac{x}{2} \\\\ y & =2x.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & =2{c}_{1}.\\end{aligned}\n$$\n\nSubstituting the above into the equation $2{c}_{2}+4{c}_{1}=8,$ we get \n\n$$\n\\begin{aligned}2{c}_{1}+2{c}_{1} & =4 \\\\ 4{c}_{1} & =4 \\\\ {c}_{1} & =1.\\end{aligned}\n$$\n\nFinally, we find ${c}_{2}=2{c}_{1}=2.$ So, the point $C$ that satisfies the mean value theorem is $(1,2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c781cea5-efe5-5962-aeb0-616e30494f29"] :db/ensure [:question/validate]} {:db/id "answer-field-c781cea5-efe5-5962-aeb0-616e30494f29" :answer-field/id #uuid "c781cea5-efe5-5962-aeb0-616e30494f29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-448a0750-9b44-5659-83b7-923153eddba1" :answer-field/choices ["answer-448a0750-9b44-5659-83b7-923153eddba1" "answer-a7dcc3a0-efb9-5f2d-8dcb-78d2815d4b24" "answer-c19232e5-f92c-5f53-ab11-91b76aef364a" "answer-e9fc269a-8a0c-5e6f-b0a6-fbc93fcbbf17" "answer-eb2ef189-5218-5f4d-b4b4-6ce38062ef65"] :db/ensure [:answer-field/validate]} {:db/id "answer-448a0750-9b44-5659-83b7-923153eddba1" :answer/id #uuid "448a0750-9b44-5659-83b7-923153eddba1" :answer/type :answer.type/math :answer/value "(1,2)" :db/ensure [:answer/validate]} {:db/id "answer-a7dcc3a0-efb9-5f2d-8dcb-78d2815d4b24" :answer/id #uuid "a7dcc3a0-efb9-5f2d-8dcb-78d2815d4b24" :answer/type :answer.type/math :answer/value "(\\frac{1}{2},1)" :db/ensure [:answer/validate]} {:db/id "answer-c19232e5-f92c-5f53-ab11-91b76aef364a" :answer/id #uuid "c19232e5-f92c-5f53-ab11-91b76aef364a" :answer/type :answer.type/math :answer/value "(\\frac{1}{4},\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-e9fc269a-8a0c-5e6f-b0a6-fbc93fcbbf17" :answer/id #uuid "e9fc269a-8a0c-5e6f-b0a6-fbc93fcbbf17" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},3)" :db/ensure [:answer/validate]} {:db/id "answer-eb2ef189-5218-5f4d-b4b4-6ce38062ef65" :answer/id #uuid "eb2ef189-5218-5f4d-b4b4-6ce38062ef65" :answer/type :answer.type/math :answer/value "(\\frac{3}{4},\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id 17592186133719 :question/worked-solution "The least-squares solution of $A\\mathbf{x}=\\mathbf{b}$ satisfies the normal equation\n\n$$\nA^T A\\mathbf{x} = A^T\\mathbf{b}.\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, it satisfies $Q^T Q = I,$ and we get\n\n$$\nR^T R \\mathbf{x} = R^T \\! Q^T \\mathbf{b}.\n$$\n\nFinally, since $R^T$ is invertible, pre-multiplying by $(R^T)^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ \\bbox[5px,border:1px solid black]{\\,R\\phantom{|}}\\,\\,x & ={Q}^{T}\\,b.\\end{aligned}\n$$\n\nTherefore, the missing parts of the equation are $R$ and $Q^T.$" :db/ensure [:question/validate]} {:db/id 17592186363154 :question/problem "$$\n\\bbox[5px,border:1px solid black]{\\phantom{A}}\\,x={Q}^{T}\\,\\bbox[5px,border:1px solid black]{\\phantom{A}}\n$$\n\nLet $A=QR$  be a QR decomposition of an $m\\times n$ matrix $A$ with linearly independent columns, and the matrix equation above gives the least-squares solution of $Ax=b.$ From left to right, what are the missing parts of the equation?" :db/ensure [:question/validate]} {:db/id 17592186410808 :question/problem "$$\nx=\\bbox[5px,border:1px solid black]{\\phantom{A}}\\,{Q}^{T}\\,b\n$$\n\nLet $A=QR$  be a QR decomposition of an $m\\times n$ matrix $A$ with linearly independent columns, and the expression above gives the least-squares solution of $Ax=b.$ What is the missing part of the equation?" :db/ensure [:question/validate]} {:db/id 17592186401097 :question/problem "$$\nx=\\bbox[5px,border:1px solid black]{\\phantom{A}}\\,\\bbox[5px,border:1px solid black]{\\phantom{A}}\\,b\n$$\n\nLet $A=QR$  be a QR decomposition of an $m\\times n$ matrix $A$ with linearly independent columns, and the expression above gives the least-squares solution of $Ax=b.$ From left to right, what are the missing parts of the equation?" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the normal equation\n\n$$\n{A}^{T}Ax={A}^{T}b.\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}\\,{Q}^{T}b.\n$$\n\nThen, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b\\end{aligned}\n$$\n\nFinally, since $R$ is invertible, pre-multiplying by ${R}^{-1}$ gives\n\n$$\n\\begin{aligned}{R}^{-1}\\cdot Rx & ={R}^{-1}\\cdot {Q}^{T}b \\\\ x & =\\bbox[6px,border:1px solid black]{\\,\\phantom{|}\\,\\,{R}^{-1}\\,}\\,{Q}^{T}\\,b.\\end{aligned}\n$$\n\nTherefore, the missing parts of the equation are ${R}^{-1}$ and ${Q}^{T}.$" :db/ensure [:question/validate]} {:db/id 17592186410809 :question/problem "$$\nx=\\bbox[5px,border:1px solid black]{\\phantom{A}}\\,{Q}^{T}\\,\\bbox[5px,border:1px solid black]{\\phantom{A}}\n$$\n\nLet $A=QR$  be a QR decomposition of an $m\\times n$ matrix $A$ with linearly independent columns, and the expression above gives the least-squares solution of $Ax=b.$ From left to right, what are the missing parts of the equation?" :question/worked-solution "The least-squares solution of $Ax=b$ satisfies the normal equation\n\n$$\n{A}^{T}Ax={A}^{T}b.\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}\\,{Q}^{T}b.\n$$\n\nThen, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nFinally, since $R$ is invertible, pre-multiplying by ${R}^{-1}$ gives\n\n$$\n\\begin{aligned}{R}^{-1}\\cdot Rx & ={R}^{-1}\\cdot {Q}^{T}b \\\\ x & =\\bbox[4px,border:1px solid black]{{R}^{-1}\\phantom{|}}\\,\\,{Q}^{T}\\,\\,b.\\end{aligned}\n$$\n\nTherefore, the missing parts of the equation are ${R}^{-1}$ and $b.$" :db/ensure [:question/validate]} {:db/id 17592186133803 :knowledge-point/questions ["question-e0061631-6269-58a0-a054-4e33a330ba6f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e0061631-6269-58a0-a054-4e33a330ba6f" :question/id #uuid "e0061631-6269-58a0-a054-4e33a330ba6f" :question/math-academy-id "q-139798" :question/problem "Given the QR decomposition $A=QR,$ find the least-squares solution to $Ax=b,$ where\n\n$$\nQ=\\frac{1}{9}[\\begin{aligned}8 & -1 \\\\ 4 & 4 \\\\ -1 & 8\\end{aligned}],\\,R=\\frac{1}{9}[\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}],\\,b=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "The least-squares solution $Ax=b$ satisfies the corresponding normal equation:\n\n$$\n{A}^{T}Ax={A}^{T}b\n$$\n\nSubstituting $A=QR,$ we obtain\n\n$$\n\\begin{aligned}{A}^{T}Ax & ={A}^{T}b \\\\ (QR)^{T}QRx & =(QR)^{T}b \\\\ {R}^{T}({Q}^{T}Q)Rx & ={R}^{T}{Q}^{T}b.\\end{aligned}\n$$\n\nSince $Q$ has orthonormal columns, ${Q}^{T}Q=I,$ and we get\n\n$$\n{R}^{T}Rx={R}^{T}{Q}^{T}b.\n$$\n\nFinally, since ${R}^{T}$ is invertible, pre-multiplying by $({R}^{T})^{-1}$ gives\n\n$$\n\\begin{aligned}({R}^{T})^{-1}\\cdot {R}^{T}Rx & =({R}^{T})^{-1}\\cdot {R}^{T}{Q}^{T}b \\\\ Rx & ={Q}^{T}b.\\end{aligned}\n$$\n\nNow, substituting our matrices, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{9}[\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}]}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{9}[\\begin{aligned}8 & 4 & -1 \\\\ -1 & 4 & 8\\end{aligned}]}}\\overset{b}{\\overset{⏞}{[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}} \\\\ [\\begin{aligned}9 & 8 \\\\ 0 & 1\\end{aligned}]x & =[\\begin{aligned}-9 \\\\ 9\\end{aligned}]\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\{\\begin{aligned}9{x}_{1}+8{x}_{2}=-9 \\\\ {x}_{2}=9.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=9.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}9{x}_{1}+8(9) & =-9 \\\\ 9{x}_{1} & =-81 \\\\ {x}_{1} & =-9.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $Ax=b$ is $[\\begin{aligned}-9 \\\\ 9\\end{aligned}].$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-99733e29-1d7e-5770-81f4-dc925a89eb32"] :db/ensure [:question/validate]} {:db/id "answer-field-99733e29-1d7e-5770-81f4-dc925a89eb32" :answer-field/id #uuid "99733e29-1d7e-5770-81f4-dc925a89eb32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8c06bd3e-d522-582e-8e6e-842930f9ae84" :answer-field/choices ["answer-2e9e21c3-28d7-5744-b751-8735eef80c3e" "answer-6c912a39-aa9c-5584-bd27-ebb5f9b76c23" "answer-ae08b2e2-ed79-5464-95a9-3d40e4f6d24d" "answer-45ccbd17-a611-5e51-8f96-c134314902f7" "answer-8c06bd3e-d522-582e-8e6e-842930f9ae84"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e9e21c3-28d7-5744-b751-8735eef80c3e" :answer/id #uuid "2e9e21c3-28d7-5744-b751-8735eef80c3e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6c912a39-aa9c-5584-bd27-ebb5f9b76c23" :answer/id #uuid "6c912a39-aa9c-5584-bd27-ebb5f9b76c23" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ae08b2e2-ed79-5464-95a9-3d40e4f6d24d" :answer/id #uuid "ae08b2e2-ed79-5464-95a9-3d40e4f6d24d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-45ccbd17-a611-5e51-8f96-c134314902f7" :answer/id #uuid "45ccbd17-a611-5e51-8f96-c134314902f7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-8c06bd3e-d522-582e-8e6e-842930f9ae84" :answer/id #uuid "8c06bd3e-d522-582e-8e6e-842930f9ae84" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186135143 :tutorial/content "Let's find the least-squares solution to $A\\mathbf{x} = \\mathbf{b},$ where $A = QR,$ and\n![](images/4e/4e2433312f3a424aa161d5aeec63df38787c43435a9c2af44ba6b3d63f9ef065.svg)\n\nPreviously, we showed that the normal equation corresponding to $A\\mathbf{x}=\\mathbf{b},$ where $A=QR,$ can be reduced to\n\n$$\nR \\mathbf{x} = Q^T \\mathbf{b}.\n$$\n\nSubstituting our matrices into this equation, we have\n\n$$\n\\begin{aligned}\\overset{R}{\\overset{⏞}{\\frac{1}{\\sqrt{2}}[\\begin{aligned}2 & -4 \\\\ 0 & 3\\end{aligned}]}}x & =\\overset{{Q}^{T}}{\\overset{⏞}{\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}]}}\\overset{b}{\\overset{⏞}{[\\begin{aligned}2 \\\\ 4\\end{aligned}]}} \\\\ [\\begin{aligned}2 & -4 \\\\ 0 & 3\\end{aligned}]x & =[\\begin{aligned}2 \\\\ 6\\end{aligned}],\\end{aligned}\n$$\n\nwhich gives the system\n\n$$\n\\{\\begin{aligned}2{x}_{1}-4{x}_{2}=2 \\\\ 3{x}_{2}=6.\\end{aligned}\n$$\n\nFrom the second equation, we get $x_2=2.$ Substituting this into the first equation, we obtain\n\n$$\n\\begin{aligned}2{x}_{1}-4(2) & =2 \\\\ 2{x}_{1} & =10 \\\\ {x}_{1} & =5.\\end{aligned}\n$$\n\nTherefore, the least-squares solution to $A\\mathbf{x} = \\mathbf{b}$ is ![](images/72/723835f5ecb612e7d79c29ada9cc05241ffd4f233e29c9ed9a643994580a8c36.svg)" :db/ensure [:tutorial/validate]} [:db/retract 17592186278119 :answer-field/choices 17592186276194] [:db/retract 17592186278119 :answer-field/choices 17592186277190] [:db/retract 17592186278119 :answer-field/choices 17592186276424] [:db/retract 17592186278119 :answer-field/choices 17592186276334] [:db/retract 17592186274851 :answer-field/choices 17592186272390] [:db/retract 17592186274851 :answer-field/choices 17592186274424] [:db/retract 17592186274851 :answer-field/choices 17592186274622] [:db/retract 17592186274851 :answer-field/choices 17592186273631] [:db/retract 17592186277760 :answer-field/choices 17592186275904] [:db/retract 17592186277760 :answer-field/choices 17592186276336] [:db/retract 17592186277760 :answer-field/choices 17592186276056] [:db/retract 17592186277760 :answer-field/choices 17592186275917] {:db/id 17592186124638 :knowledge-point/questions ["question-911398b5-8165-51fb-be3f-bfee0bb6f77f" "question-9c34765f-7311-53ab-be9b-191b42487450" "question-be7cd3c6-b4d8-58fc-a0bb-f9185ad55778"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124636 :knowledge-point/questions ["question-8e55ad1f-d84a-5ded-9fca-459293bc995a" "question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" "question-a1824679-625d-5463-b2f3-fb72a493af82"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124640 :knowledge-point/questions ["question-e70a4727-f486-57b6-aa40-dbf0dba8fb16" "question-7a819c67-d4ea-5946-94af-b50fc8d8ad96" "question-e5fbae1b-fa0a-5638-bec4-5b64d04c9a07" "question-8a09ec73-a8f5-5e32-98fd-165c3e60bda6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124637 :knowledge-point/questions ["question-aca8e51f-98b0-5cbe-9d48-2cf6165eb100" "question-28327fac-a614-5756-91bd-3fcab54fcda2" "question-f90f5dc8-4e9d-5e87-800a-708d8b32cd8d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/id #uuid "911398b5-8165-51fb-be3f-bfee0bb6f77f" :question/math-academy-id "q-158571" :question/problem "Evaluate $z=\\frac{2y-x}{{x}^{3}-{y}^{2}-4}$ at the point $(2,-2).$" :question/worked-solution "To evaluate our multivariable function at the point $(2,-2),$ we substitute $x=2$ and $y=-2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(2,-2)} & =\\frac{2y-x}{{x}^{3}-{y}^{2}-4}\\,{|}_{(2,-2)} \\\\  & =\\frac{2(-2)-2}{{2}^{3}-(-2)^{2}-4} \\\\  & =\\frac{-4-2}{8-4-4} \\\\  & =\\frac{(-6)}{0},\\end{aligned}\n$$\n\nwhich is undefined." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-378dd559-16b2-53c2-b64a-808e9c526e35"] :db/ensure [:question/validate]} {:db/id "answer-field-378dd559-16b2-53c2-b64a-808e9c526e35" :answer-field/id #uuid "378dd559-16b2-53c2-b64a-808e9c526e35" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c11088d1-89b4-5f2e-9c65-45b33b86af64" :answer-field/choices ["answer-4332d078-c596-5ab9-a9fd-b2600b41dcb1" "answer-f1a761eb-6b14-555e-ba52-76a27a6e6871" "answer-529e6e4c-543b-5b5d-91ba-42883dfabf92" "answer-ade04a22-b4eb-505b-8eb9-82420c1e8561" "answer-c11088d1-89b4-5f2e-9c65-45b33b86af64"] :db/ensure [:answer-field/validate]} {:db/id "answer-4332d078-c596-5ab9-a9fd-b2600b41dcb1" :answer/id #uuid "4332d078-c596-5ab9-a9fd-b2600b41dcb1" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-f1a761eb-6b14-555e-ba52-76a27a6e6871" :answer/id #uuid "f1a761eb-6b14-555e-ba52-76a27a6e6871" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-529e6e4c-543b-5b5d-91ba-42883dfabf92" :answer/id #uuid "529e6e4c-543b-5b5d-91ba-42883dfabf92" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-ade04a22-b4eb-505b-8eb9-82420c1e8561" :answer/id #uuid "ade04a22-b4eb-505b-8eb9-82420c1e8561" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "answer-c11088d1-89b4-5f2e-9c65-45b33b86af64" :answer/id #uuid "c11088d1-89b4-5f2e-9c65-45b33b86af64" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id "question-9c34765f-7311-53ab-be9b-191b42487450" :question/id #uuid "9c34765f-7311-53ab-be9b-191b42487450" :question/math-academy-id "q-158585" :question/problem "Evaluate $z={2}^{-x}+\\frac{1}{y}$ at the point $(2,2).$" :question/worked-solution "To evaluate our multivariable function at the point $(2,2),$ we substitute $x=2$ and $y=2$ into the function expression:\n\n$$\n\\begin{aligned}z\\,{|}_{(2,2)} & =({2}^{-x}+\\frac{1}{y}){|}_{(2,2)} \\\\  & ={2}^{-2}+\\frac{1}{2} \\\\  & =\\frac{1}{{2}^{2}}+\\frac{1}{2} \\\\  & =\\frac{1}{4}+\\frac{1}{2} \\\\  & =\\frac{3}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda"] :db/ensure [:question/validate]} {:db/id "answer-field-893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/id #uuid "893376bc-f857-5c82-9b7f-472d1ddbccda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" :answer-field/choices ["answer-dbef1e38-02bf-5cd7-beba-116a24ac4bd4" "answer-8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" "answer-c4a63f4b-3cca-51c6-b369-5d4f828546a4" "answer-a69cfe99-5dda-5c7f-a8ae-e9e88f862d43" "answer-e866b3d9-12d2-51c5-a482-af43a7c89490"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbef1e38-02bf-5cd7-beba-116a24ac4bd4" :answer/id #uuid "dbef1e38-02bf-5cd7-beba-116a24ac4bd4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" :answer/id #uuid "8ca77a3e-9085-58ef-87e4-a39c3ee58fbe" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c4a63f4b-3cca-51c6-b