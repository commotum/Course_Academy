wer-field/choices ["answer-5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" "answer-802c8eca-f606-57bb-ba41-d622b1cfd092" "answer-d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" "answer-3fa5338f-2040-50a2-8215-a65d278835dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" :answer/id #uuid "5f64eacd-5b71-5fb7-a6a8-59aa2ee03f20" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-802c8eca-f606-57bb-ba41-d622b1cfd092" :answer/id #uuid "802c8eca-f606-57bb-ba41-d622b1cfd092" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" :answer/id #uuid "d9a97e5b-e0be-5f92-8ef2-8ec7a7cfb42a" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne -1\\}" :db/ensure [:answer/validate]} {:db/id "answer-3fa5338f-2040-50a2-8215-a65d278835dd" :answer/id #uuid "3fa5338f-2040-50a2-8215-a65d278835dd" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,2x+y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "question-8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/id #uuid "8e55ad1f-d84a-5ded-9fca-459293bc995a" :question/math-academy-id "q-158549" :question/problem "Find the domain of the function $f(x,y)=\\frac{y}{{x}^{2}-1}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-1\\ne 0\\,⟹\\,{x}^{2}\\ne 1\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb"] :db/ensure [:question/validate]} {:db/id "answer-field-90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/id #uuid "90be3a6c-5de3-5d62-b8c6-33fbd612aecb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e1a68aca-012d-5c87-957b-411dd32e2492" :answer-field/choices ["answer-cedcf912-6c17-5453-a419-96804f0a8e01" "answer-766255f4-6ead-5147-a37a-dead8da19ddc" "answer-3795c09d-83a0-5e77-8d46-905638f8cd94" "answer-e1a68aca-012d-5c87-957b-411dd32e2492" "answer-afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-cedcf912-6c17-5453-a419-96804f0a8e01" :answer/id #uuid "cedcf912-6c17-5453-a419-96804f0a8e01" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}=1\\}" :db/ensure [:answer/validate]} {:db/id "answer-766255f4-6ead-5147-a37a-dead8da19ddc" :answer/id #uuid "766255f4-6ead-5147-a37a-dead8da19ddc" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-3795c09d-83a0-5e77-8d46-905638f8cd94" :answer/id #uuid "3795c09d-83a0-5e77-8d46-905638f8cd94" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-e1a68aca-012d-5c87-957b-411dd32e2492" :answer/id #uuid "e1a68aca-012d-5c87-957b-411dd32e2492" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}\\ne 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad" :answer/id #uuid "afd5b1b0-fcf3-5a5d-8da1-bec2e7cc53ad" :answer/type :answer.type/text :answer/value "The domain is the entire $xy-$plane" :db/ensure [:answer/validate]} {:db/id "question-0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/id #uuid "0f0c6fb0-68b0-537c-ab8d-954592bf8ad5" :question/math-academy-id "q-158561" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{y-{x}^{2}}}{2x-y}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n\\{\\begin{aligned}y-{x}^{2}\\ge 0 \\\\ 2x-y\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}y\\ge {x}^{2} \\\\ y\\ne 2x\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y\\ne 2x\\}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fbec5fcc-3c3a-5ffd-b0f3-92a5d7992122"] :db/ensure [:question/validate]} {:db/id "answer-field-fbec5fcc-3c3a-5ffd-b0f3-92a5d7992122" :answer-field/id #uuid "fbec5fcc-3c3a-5ffd-b0f3-92a5d7992122" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-235f0230-c6a2-58fc-bd59-7672f354b6da" :answer-field/choices ["answer-aef90284-fc08-5b4f-9e81-9caa92dfe802" "answer-aae1a469-d68e-59c0-a688-35b023ed0b2f" "answer-b015e9e9-ed69-58a1-bc47-3d84c2927025" "answer-235f0230-c6a2-58fc-bd59-7672f354b6da" "answer-c6cc232c-cc23-5849-87bd-c3d853e16f7b"] :db/ensure [:answer-field/validate]} {:db/id "answer-aef90284-fc08-5b4f-9e81-9caa92dfe802" :answer/id #uuid "aef90284-fc08-5b4f-9e81-9caa92dfe802" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y<{x}^{2},\\,y\\ne 2x\\}" :db/ensure [:answer/validate]} {:db/id "answer-aae1a469-d68e-59c0-a688-35b023ed0b2f" :answer/id #uuid "aae1a469-d68e-59c0-a688-35b023ed0b2f" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y={x}^{2},\\,y>2x\\}" :db/ensure [:answer/validate]} {:db/id "answer-b015e9e9-ed69-58a1-bc47-3d84c2927025" :answer/id #uuid "b015e9e9-ed69-58a1-bc47-3d84c2927025" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y>2x\\}" :db/ensure [:answer/validate]} {:db/id "answer-235f0230-c6a2-58fc-bd59-7672f354b6da" :answer/id #uuid "235f0230-c6a2-58fc-bd59-7672f354b6da" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge {x}^{2},\\,y\\ne 2x\\}" :db/ensure [:answer/validate]} {:db/id "answer-c6cc232c-cc23-5849-87bd-c3d853e16f7b" :answer/id #uuid "c6cc232c-cc23-5849-87bd-c3d853e16f7b" :answer/type :answer.type/text :answer/value "The domain is the entire $xy-$plane" :db/ensure [:answer/validate]} {:db/id "question-a1824679-625d-5463-b2f3-fb72a493af82" :question/id #uuid "a1824679-625d-5463-b2f3-fb72a493af82" :question/math-academy-id "q-158554" :question/problem "Find the domain of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}-{y}^{2}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n{x}^{2}-{y}^{2}\\ne 0\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0\\}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d0effc05-87d0-589c-bbda-8eebc905e53e"] :db/ensure [:question/validate]} {:db/id "answer-field-d0effc05-87d0-589c-bbda-8eebc905e53e" :answer-field/id #uuid "d0effc05-87d0-589c-bbda-8eebc905e53e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3cd2fadc-384e-56c3-ae50-0d963c2dd45a" :answer-field/choices ["answer-0f719873-855b-510a-a974-761504b7537d" "answer-0acdc5a5-82d8-5e8c-8ed0-61de70bd1223" "answer-3cd2fadc-384e-56c3-ae50-0d963c2dd45a" "answer-afcfd169-0a6a-5b23-9542-bc1a80e450be" "answer-76aded1e-0a67-55a3-a895-85e73d77a133"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f719873-855b-510a-a974-761504b7537d" :answer/id #uuid "0f719873-855b-510a-a974-761504b7537d" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-0acdc5a5-82d8-5e8c-8ed0-61de70bd1223" :answer/id #uuid "0acdc5a5-82d8-5e8c-8ed0-61de70bd1223" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}=0\\}" :db/ensure [:answer/validate]} {:db/id "answer-3cd2fadc-384e-56c3-ae50-0d963c2dd45a" :answer/id #uuid "3cd2fadc-384e-56c3-ae50-0d963c2dd45a" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-afcfd169-0a6a-5b23-9542-bc1a80e450be" :answer/id #uuid "afcfd169-0a6a-5b23-9542-bc1a80e450be" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}\\ne 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-76aded1e-0a67-55a3-a895-85e73d77a133" :answer/id #uuid "76aded1e-0a67-55a3-a895-85e73d77a133" :answer/type :answer.type/text :answer/value "The domain is the entire $xy-$plane" :db/ensure [:answer/validate]} {:db/id 17592186275453 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n\\begin{aligned}1-{x}^{2}-{y}^{2}>0\\,⟹\\,{x}^{2}+{y}^{2}<1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186274851 :answer-field/correct "answer-cc963b79-b269-5331-848d-67f4ee353859" :answer-field/choices ["answer-0401f3db-693c-55a6-a2a6-cdcb8f618641" "answer-cc963b79-b269-5331-848d-67f4ee353859" "answer-b88c88cc-ef4e-5607-aff6-aeedbfce6369" "answer-56d57d91-2728-51bc-b291-e2245cc07a65"] :db/ensure [:answer-field/validate]} {:db/id "answer-0401f3db-693c-55a6-a2a6-cdcb8f618641" :answer/id #uuid "0401f3db-693c-55a6-a2a6-cdcb8f618641" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<0\\}" :db/ensure [:answer/validate]} {:db/id "answer-cc963b79-b269-5331-848d-67f4ee353859" :answer/id #uuid "cc963b79-b269-5331-848d-67f4ee353859" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-b88c88cc-ef4e-5607-aff6-aeedbfce6369" :answer/id #uuid "b88c88cc-ef4e-5607-aff6-aeedbfce6369" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-56d57d91-2728-51bc-b291-e2245cc07a65" :answer/id #uuid "56d57d91-2728-51bc-b291-e2245cc07a65" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id 17592186278214 :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression under the logarithm is positive, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities: \n\n$$\n\\{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ \\operatorname{ln}⁡({x}^{2}-{y}^{2})\\ne 0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}{x}^{2}-{y}^{2}>0 \\\\ {x}^{2}-{y}^{2}\\ne 1\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186277760 :answer-field/correct "answer-c250b76c-84fb-5171-96ad-26f59f4cc182" :answer-field/choices ["answer-c250b76c-84fb-5171-96ad-26f59f4cc182" "answer-afb9bfc6-03a7-5955-a866-f8b80cc14adc" "answer-5a2a0eb0-6434-58f7-9e6c-4792c1123498" "answer-9c51b544-d4a2-5932-8f15-bac18a3bfea1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c250b76c-84fb-5171-96ad-26f59f4cc182" :answer/id #uuid "c250b76c-84fb-5171-96ad-26f59f4cc182" :answer/type :answer.type/math :answer/value "\\{(x,y)\\in {R}^{2}\\,:\\,{x}^{2}-{y}^{2}>0,\\,{x}^{2}-{y}^{2}\\ne 1\\}" :db/ensure