w the height, we proceed as follows:\n\n- Extend the line segment $\\overset{―}{PQ}.$\n\n![](images/26/265ee40283911b754264224b3b0f349b24cae377373941304865b336a53c7b8e.png)\n\n- Draw the perpendicular from $R$ to $\\overset{⟷}{PQ}.$\n\n![](images/2e/2e48106e4aedb44faef00060f6af9632bd0c8e62eb8d06f12606c2a476bacac3.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-678739dc-dd99-5411-8aaf-f8c9ecc011df"] :db/ensure [:question/validate]} {:db/id "answer-field-678739dc-dd99-5411-8aaf-f8c9ecc011df" :answer-field/id #uuid "678739dc-dd99-5411-8aaf-f8c9ecc011df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9c9dd0c-f5d7-5a25-8f7a-404b4d4b1521" :answer-field/choices ["answer-7c137d98-33bd-5cfc-8f63-359ad6471b1e" "answer-c9c9dd0c-f5d7-5a25-8f7a-404b4d4b1521" "answer-aead06b8-c27b-5d22-b1e5-e50e94418aa7" "answer-e7e35b9d-a5b5-58b5-ad4a-c12b98096c07" "answer-af7cf62f-39bf-5878-a434-74498dd8362d"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c137d98-33bd-5cfc-8f63-359ad6471b1e" :answer/id #uuid "7c137d98-33bd-5cfc-8f63-359ad6471b1e" :answer/type :answer.type/image :answer/value "images/0b/0bc641736877902ac9272906ed276d36d475ef8060c3c00f0814d9881c3a2153.png" :db/ensure [:answer/validate]} {:db/id "answer-c9c9dd0c-f5d7-5a25-8f7a-404b4d4b1521" :answer/id #uuid "c9c9dd0c-f5d7-5a25-8f7a-404b4d4b1521" :answer/type :answer.type/image :answer/value "images/2e/2e48106e4aedb44faef00060f6af9632bd0c8e62eb8d06f12606c2a476bacac3.png" :db/ensure [:answer/validate]} {:db/id "answer-aead06b8-c27b-5d22-b1e5-e50e94418aa7" :answer/id #uuid "aead06b8-c27b-5d22-b1e5-e50e94418aa7" :answer/type :answer.type/image :answer/value "images/b0/b06b43ef5a57621be16e22eeaf3e60f76fc9203752af363ada5e6ab5081cfa19.png" :db/ensure [:answer/validate]} {:db/id "answer-e7e35b9d-a5b5-58b5-ad4a-c12b98096c07" :answer/id #uuid "e7e35b9d-a5b5-58b5-ad4a-c12b98096c07" :answer/type :answer.type/image :answer/value "images/c7/c7b37d825464a35ef515d3cd7ce388025a1c93e07ae80246344d4785360d5d9e.png" :db/ensure [:answer/validate]} {:db/id "answer-af7cf62f-39bf-5878-a434-74498dd8362d" :answer/id #uuid "af7cf62f-39bf-5878-a434-74498dd8362d" :answer/type :answer.type/image :answer/value "images/d5/d5cd2b3c3dbc4a9231a8738bea83a51bb731e94ef971864ac9174edcc7f1a3ba.png" :db/ensure [:answer/validate]} {:db/id "activity-b344a744-3440-50e5-9d6c-33f6246db0c2" :activity/id #uuid "b344a744-3440-50e5-9d6c-33f6246db0c2" :activity/title "Heights of Triangles" :activity/type :activity.type/review :activity/scope 17592186048472 :activity/course 17592186046647 :activity/steps ["step-85fdfdf6-5023-58b6-a609-0e7f25680884" "step-ede84000-89a5-5f8c-b530-b23f7c1c76f7" "step-af027b92-4026-580f-8e12-1889fa5766ab"] :activity/first-step "step-85fdfdf6-5023-58b6-a609-0e7f25680884" :db/ensure [:activity/validate]} {:db/id "step-85fdfdf6-5023-58b6-a609-0e7f25680884" :step/id #uuid "85fdfdf6-5023-58b6-a609-0e7f25680884" :step/content 17592186294980 :step/next "step-ede84000-89a5-5f8c-b530-b23f7c1c76f7" :db/ensure [:step/validate]} {:db/id "step-ede84000-89a5-5f8c-b530-b23f7c1c76f7" :step/id #uuid "ede84000-89a5-5f8c-b530-b23f7c1c76f7" :step/content "question-97cef597-7bfc-539c-89dd-d586cabec0a9" :step/next "step-af027b92-4026-580f-8e12-1889fa5766ab" :db/ensure [:step/validate]} {:db/id "step-af027b92-4026-580f-8e12-1889fa5766ab" :step/id #uuid "af027b92-4026-580f-8e12-1889fa5766ab" :step/content "question-a800f321-defb-572d-a55b-71be8add2663" :db/ensure [:step/validate]} [:db/retract 17592186134378 :question/answer-fields 17592186132307] [:db/retract 17592186127069 :answer-field/choices 17592186127072] [:db/retract 17592186127069 :answer-field/choices 17592186127073] [:db/retract 17592186127069 :answer-field/choices 17592186127074] [:db/retract 17592186127069 :answer-field/choices 17592186127070] [:db/retract 17592186127069 :answer-field/choices 17592186127071] [:db/retract 17592186127081 :answer-field/choices 17592186127082] [:db/retract 17592186127081 :answer-field/choices 17592186127083] [:db/retract 17592186127081 :answer-field/choices 17592186127084] [:db/retract 17592186127081 :answer-field/choices 17592186127085] [:db/retract 17592186127081 :answer-field/choices 17592186127086] {:db/id 17592186129079 :knowledge-point/questions ["question-a6978155-572b-505c-b00f-8a94900d562b" "question-30043088-8017-56c1-83d2-93da6bb272cf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129598 :question/problem "Given the function $f(x,y,z)=8x-{y}^{2}-z$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(2,4,1).$" :question/worked-solution "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(2,4,1):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(8x-{y}^{2}-z)\\text{ }i+\\frac{∂}{∂y}(8x-{y}^{2}-z)\\text{ }j+\\frac{∂}{∂z}(8x-{y}^{2}-z)\\text{ }k \\\\  & =8\\text{ }i-2y\\text{ }j-k \\\\ ∇\\,f(2,4,1) & =8\\text{ }i-2(4)\\text{ }j-k \\\\  & =8\\,i-8\\,j-k \\\\  & =⟨8,-8,-1⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(2,4,1)\\cdot ⟨x-2,\\,y-4,\\,z-1⟩ & =0 \\\\ ⟨8,-8,-1⟩\\cdot ⟨x-2,\\,y-4,\\,z-1⟩ & =0 \\\\ 8(x-2)-8(y-4)-(z-1) & =0 \\\\ 8x-8y-z+17 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186127069 :answer-field/correct "answer-1f6d48ea-6821-57e2-a08d-03c0df57f1fc" :answer-field/choices ["answer-8557f4fa-1dde-5394-8517-125fc24a6773" "answer-1f6d48ea-6821-57e2-a08d-03c0df57f1fc" "answer-cab2ba0b-9650-5f9b-91ef-76a60e669e57" "answer-ffe7ca6b-fd6f-5924-928d-5e695abdf5af" "answer-26f0ba69-c6a6-59af-b0ab-7cf128edb457"] :db/ensure [:answer-field/validate]} {:db/id "answer-8557f4fa-1dde-5394-8517-125fc24a6773" :answer/id #uuid "8557f4fa-1dde-5394-8517-125fc24a6773" :answer/type :answer.type/math :answer/value "2x-8y-3z+4=0" :db/ensure [:answer/validate]} {:db/id "answer-1f6d48ea-6821-57e2-a08d-03c0df57f1fc" :answer/id #uuid "1f6d48ea-6821-57e2-a08d-03c0df57f1fc" :answer/type :answer.type/math :answer/value "8x-8y-z+17=0" :db/ensure [:answer/validate]} {:db/id "answer-cab2ba0b-9650-5f9b-91ef-76a60e669e57" :answer/id #uuid "cab2ba0b-9650-5f9b-91ef-76a60e669e57" :answer/type :answer.type/math :answer/value "8x-y-z+27=0" :db/ensure [:answer/validate]} {:db/id "answer-ffe7ca6b-fd6f-5924-928d-5e695abdf5af" :answer/id #uuid "ffe7ca6b-fd6f-5924-928d-5e695abdf5af" :answer/type :answer.type/math :answer/value "x-8y-z+7=0" :db/ensure [:answer/validate]} {:db/id "answer-26f0ba69-c6a6-59af-b0ab-7cf128edb457" :answer/id #uuid "26f0ba69-c6a6-59af-b0ab-7cf128edb457" :answer/type :answer.type/math :answer/value "x-y-z+17=0" :db/ensure [:answer/validate]} {:db/id "question-a6978155-572b-505c-b00f-8a94900d562b" :question/id #uuid "a6978155-572b-505c-b00f-8a94900d562b" :question/math-academy-id "q-102702" :question/problem "Given the function $f(x,y,z)={e}^{y}\\operatorname{cos}⁡2x+{z}^{2}$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(\\frac{\\pi }{4},4,1).$" :question/worked-solution "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(\\frac{\\pi }{4},4,1):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({e}^{y}\\operatorname{cos}⁡2x+{z}^{2})\\text{ }i+\\frac{∂}{∂y}({e}^{y}\\operatorname{cos}⁡2x+{z}^{2})\\text{ }j+\\frac{∂}{∂z}({e}^{y}\\operatorname{cos}⁡2x+{z}^{2})\\text{ }k \\\\  & =-2{e}^{y}\\operatorname{sin}⁡2x\\text{ }i+{e}^{y}\\operatorname{cos}⁡2x\\text{ }j+2zk \\\\ ∇\\,f(\\frac{\\pi }{4},4,1) & =-2{e}^{4}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\text{ }i+{e}^{4}\\operatorname{cos}⁡(\\frac{\\pi }{2})\\text{ }j+2(1)k \\\\  & =-2{e}^{4}\\,i+0\\,j+2k \\\\  & =⟨-2{e}^{4},0,2⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(\\frac{\\pi }{4},4,1)\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩ & =0 \\\\ ⟨-2{e}^{4},0,2⟩\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩ & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6cd0d23f-0d58-5865-9c0a-7562b441a711"] :db/ensure [:question/validate]} {:db/id "answer-field-6cd0d23f-0d58-5865-9c0a-7562b441a711" :answer-field/id #uuid "6cd0d23f-0d58-5865-9c0a-7562b441a711" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-364d2199-0b35-5058-91d2-00830dfeac8c" :answer-field/choices ["answer-424acf8b-08ac-5611-8aa3-de65c4fec28f" "answer-364d2199-0b35-5058-91d2-00830dfeac8c" "answer-bb62c03c-bf38-5191-8248-65e025952de8" "answer-2ce47d28-eaa1-546c-8183-2127b628176c" "answer-d9cbbaea-b40c-59ab-894a-2ac16a7ce025"] :db/ensure [:answer-field/validate]} {:db/id "answer-424acf8b-08ac-5611-8aa3-de65c4fec28f" :answer/id #uuid "424acf8b-08ac-5611-8aa3-de65c4fec28f" :answer/type :answer.type/math :answer/value "⟨-2e,0,4⟩\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩=0" :db/ensure [:answer/validate]} {:db/id "answer-364d2199-0b35-5058-91d2-00830dfeac8c" :answer/id #uuid "364d2199-0b35-5058-91d2-00830dfeac8c" :answer/type :answer.type/math :answer/value "⟨-2{e}^{4},0,2⟩\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩=0" :db/ensure [:answer/validate]} {:db/id "answer-bb62c03c-bf38-5191-8248-65e025952de8" :answer/id #uuid "bb62c03c-bf38-5191-8248-65e025952de8" :answer/type :answer.type/math :answer/value "⟨-{e}^{4},1,2⟩\\cdot ⟨x-\\frac{\\pi }{4},\\,y-4,\\,z-1⟩=0" :db/ensure [:answer/validate]} {:db/id "answer-2ce47d28-eaa1-546c-8183-2127b628176c" :answer/id #uuid "2ce47d28-eaa1-546c-8183-2127b628176c" :answer/type :answer.type/math :answer/value "⟨{e}^{2},0,2⟩\\cdot ⟨x+\\frac{\\pi }{4},\\,y+4,\\,z+1⟩=0" :db/ensure [:answer/validate]} {:db/id "answer-d9cbbaea-b40c-59ab-894a-2ac16a7ce025" :answer/id #uuid "d9cbbaea-b40c-59ab-894a-2ac16a7ce025" :answer/type :answer.type/math :answer/value "⟨{e}^{4},-2,2⟩\\cdot ⟨x+\\frac{\\pi }{4},\\,y+4,\\,z+1⟩=0" :db/ensure [:answer/validate]} {:db/id "question-30043088-8017-56c1-83d2-93da6bb272cf" :question/id #uuid "30043088-8017-56c1-83d2-93da6bb272cf" :question/math-academy-id "q-102703" :question/problem "Given the function $f(x,y,z)=x{z}^{2}+z{y}^{3}$, find the equation of the tangent plane to the level surface that passes  through the point where $(x,y,z)=(-2,1,2).$" :question/worked-solution "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(-2,1,2):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(x{z}^{2}+z{y}^{3})\\text{ }i+\\frac{∂}{∂y}(x{z}^{2}+z{y}^{3})\\text{ }j+\\frac{∂}{∂z}(x{z}^{2}+z{y}^{3})\\text{ }k \\\\  & ={z}^{2}\\text{ }i+3z{y}^{2}\\text{ }j+(2xz+{y}^{3})k \\\\ ∇\\,f(-2,1,2) & ={2}^{2}\\text{ }i+3(2)(1)^{2}\\text{ }j+(2(-2)(2)+{1}^{3})k \\\\  & =4\\,i+6\\,j-7k \\\\  & =⟨4,6,-7⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(-2,1,2)\\cdot ⟨x+2,\\,y-1,\\,z-2⟩ & =0 \\\\ ⟨4,6,-7⟩\\cdot ⟨x+2,\\,y-1,\\,z-2⟩ & =0 \\\\ 4(x+2)+6(y-1)-7(z-2) & =0 \\\\ 4x+6y-7z+16 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b016f984-0965-530b-9037-6011cff75823"] :db/ensure [:question/validate]} {:db/id "answer-field-b016f984-0965-530b-9037-6011cff75823" :answer-field/id #uuid "b016f984-0965-530b-9037-6011cff75823" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8df5cb89-1973-568a-8fe2-75da826fe44b" :answer-field/choices ["answer-64c1ef79-ce0d-5e2d-a02b-a0743459fdc6" "answer-80c96624-afbf-51f5-ae72-3a63b863ae88" "answer-27c7e31a-c41b-53fc-b037-5645baeb20a8" "answer-8df5cb89-1973-568a-8fe2-75da826fe44b" "answer-95ed8ce1-129d-58d4-a6b8-504127151a0e"] :db/ensure [:answer-field/validate]} {:db/id "answer-64c1ef79-ce0d-5e2d-a02b-a0743459fdc6" :answer/id #uuid "64c1ef79-ce0d-5e2d-a02b-a0743459fdc6" :answer/type :answer.type/math :answer/value "2x+6y-5z+11=0" :db/ensure [:answer/validate]} {:db/id "answer-80c96624-afbf-51f5-ae72-3a63b863ae88" :answer/id #uuid "80c96624-afbf-51f5-ae72-3a63b863ae88" :answer/type :answer.type/math :answer/value "3x+y-7z+10=0" :db/ensure [:answer/validate]} {:db/id "answer-27c7e31a-c41b-53fc-b037-5645baeb20a8" :answer/id #uuid "27c7e31a-c41b-53fc-b037-5645baeb20a8" :answer/type :answer.type/math :answer/value "4x+3y-z+12=0" :db/ensure [:answer/validate]} {:db/id "answer-8df5cb89-1973-568a-8fe2-75da826fe44b" :answer/id #uuid "8df5cb89-1973-568a-8fe2-75da826fe44b" :answer/type :answer.type/math :answer/value "4x+6y-7z+16=0" :db/ensure [:answer/validate]} {:db/id "answer-95ed8ce1-129d-58d4-a6b8-504127151a0e" :answer/id #uuid "95ed8ce1-129d-58d4-a6b8-504127151a0e" :answer/type :answer.type/math :answer/value "x+6y-5z+13=0" :db/ensure [:answer/validate]} {:db/id 17592186129600 :question/problem "Consider the surface ${z}^{2}{x}^{2}=xy.$ Find the equation of the tangent plane to that surface at the point $(1,4,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{z}^{2}{x}^{2} & =xy \\\\ {z}^{2}{x}^{2}-xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y,z)={z}^{2}{x}^{2}-xy$, our surface can be viewed as the level surface $f(x,y,z)=0.$ \n\nRecall that the equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(1,4,2):$\n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({z}^{2}{x}^{2}-xy)\\text{ }i+\\frac{∂}{∂y}({z}^{2}{x}^{2}-xy)\\text{ }j+\\frac{∂}{∂z}({z}^{2}{x}^{2}-xy)\\text{ }k \\\\  & =(2x{z}^{2}-y)\\text{ }i-x\\text{ }j+2{x}^{2}z\\text{ }k \\\\ ∇\\,f(1,4,2) & =(2(1)(2)^{2}-4)\\text{ }i-(1)\\text{ }j+2(1)^{2}(2)\\text{ }k \\\\  & =4\\,i-j+4\\,k \\\\  & =⟨4,-1,4⟩\\end{aligned}\n$$\n\nFinally, we can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(1,4,2)\\cdot ⟨x-1,\\,y-4,\\,z-2⟩ & =0 \\\\ ⟨4,-1,4⟩\\cdot ⟨x-1,\\,y-4,\\,z-2⟩ & =0 \\\\ 4(x-1)-(y-4)+4(z-2) & =0 \\\\ 4x-y+4z-8 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186127081 :answer-field/correct "answer-ff7ed63d-750d-54bf-8371-1814117fcf83" :answer-field/choices ["answer-8836857f-687d-51a9-9e63-479e93fe0344" "answer-62a220cd-8c27-5009-a1fd-57c7a47dcb2a" "answer-ff7ed63d-750d-54bf-8371-1814117fcf83" "answer-74a368df-df2e-55cb-bc0b-a4c8c3882092" "answer-2fc71dc5-7a1f-52cb-9b38-fc75c1afe802"] :db/ensure [:answer-field/validate]} {:db/id "answer-8836857f-687d-51a9-9e63-479e93fe0344" :answer/id #uuid "8836857f-687d-51a9-9e63-479e93fe0344" :answer/type :answer.type/math :answer/value "4x-4z+12=0" :db/ensure [:answer/validate]} {:db/id "answer-62a220cd-8c27-5009-a1fd-57c7a47dcb2a" :answer/id #uuid "62a220cd-8c27-5009-a1fd-57c7a47dcb2a" :answer/type :answer.type/math :answer/value "4x-y+4z+1=0" :db/ensure [:answer/validate]} {:db/id "answer-ff7ed63d-750d-54bf-8371-1814117fcf83" :answer/id #uuid "ff7ed63d-750d-54bf-8371-1814117fcf83" :answer/type :answer.type/math :answer/value "4x-y+4z-8=0" :db/ensure [:answer/validate]} {:db/id "answer-74a368df-df2e-55cb-bc0b-a4c8c3882092" :answer/id #uuid "74a368df-df2e-55cb-bc0b-a4c8c3882092" :answer/type :answer.type/math :answer/value "x-y+z+1=0" :db/ensure [:answer/validate]} {:db/id "answer-2fc71dc5-7a1f-52cb-9b38-fc75c1afe802" :answer/id #uuid "2fc71dc5-7a1f-52cb-9b38-fc75c1afe802" :answer/type :answer.type/math :answer/value "x-y+z+4=0" :db/ensure [:answer/validate]} {:db/id 17592186138455 :knowledge-point/questions ["question-d2d2cf77-d5f7-5477-9cd1-8f7ee0800051" "question-7a74b26f-0105-5ef0-8131-fbfddb81968a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138064 :question/problem "What is the sum of the first and last terms of the following sequence? \n\n$$\n3,\\quad-5,\\quad7,\\quad-9,\\quad11,\\quad-13,\\quad15\n$$" :question/worked-solution "The first term is $3$ and the last term is $15.$ Their sum is $3+15 = 18.$" :db/ensure [:question/validate]} {:db/id 17592186138456 :knowledge-point/questions ["question-4c253992-f8f6-54f1-85fd-c768c36b2399" "question-0f81e122-7862-59a0-9cd2-28031f67f42e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138066 :question/problem "Which of the following statements is true regarding the sequence $f(n) =5-2n$ for $n\\geq 1?$\n\nI. Its second term is larger than the first term\n\nII. Its third term is $-1$\n\nIII. Its last term is $-5$" :question/worked-solution "Let's look at each statement in turn:\n\n- The first and second terms of the sequence are represented by $f(1)$ and $f(2),$ respectively. We can compute these values using the rule $f(n) = 5-2n,$ as follows;\n\n$$\n\\begin{aligned}f(1) & =5-2(1)=3 \\\\ f(2) & =5-2(2)=1\\end{aligned}\n$$\n\nWe see that the second term $f(2)=1$ is smaller than the first term $f(1)=3.$ Therefore, statement I is false.\n\n- We compute the third term as follows:\n\n$$\nf(3)=5-2(3)=-1\n$$\n\nTherefore, statement II is true.\n\n- The sequence is defined for $n\\geq 1,$ which means that there is no limit to how large $n$ can be. There is no last term, because the sequence keeps going on forever. Therefore, statement III is false.\n\nIn conclusion, only statement II is true." :db/ensure [:question/validate]} {:db/id 17592186138457 :knowledge-point/questions ["question-041652e3-e5d6-50e5-af62-e1885be6626d" "question-f29afdcb-efb1-549b-8468-0f53b64a94c5" "question-fc6510bd-b576-581a-8664-e81e95aec6a7" "question-69da1904-3ed5-5a22-8299-a97a8db45c15"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138065 :question/problem "A sequence is defined as $a_n =n^2$ for $n\\geq 1.$ What is the sum of its second and third terms?" :question/worked-solution "Using $a_n$ notation, the second and third terms are $a_2$ and $a_3,$ respectively.\n\nWe can compute these values using the rule $a_n=n^2,$ as follows:\n\n$$\n\\begin{aligned}{a}_{2} & ={2}^{2}=4 \\\\ {a}_{3} & ={3}^{2}=9\\end{aligned}\n$$\n\nSo, the sum of the second and third terms is\n\n$$\na_2+a_3=4+9=13.\n$$" :db/ensure [:question/validate]} {:db/id "question-d2d2cf77-d5f7-5477-9cd1-8f7ee0800051" :question/id #uuid "d2d2cf77-d5f7-5477-9cd1-8f7ee0800051" :question/math-academy-id "q-262870" :question/problem "What are the second and last terms of the following sequence? \n\n$$\n7,\\,14,\\,21,\\,28,\\,35,\\,42\n$$\n\nThe second term is\n{{field-1}}\nand the last term is\n{{field-2}}." :question/worked-solution "For this sequence:\n\n- The first term is $7$\n\n- The second term is $14$\n\n- The third term is $21$\n\n- The fourth term is $28$\n\n- The fifth term is $35$\n\n- The sixth term is $42$\n\nTherefore, the second term is $14$ and the last term is $42.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dad9a537-c8c8-5a4d-92d7-f01642118b81" "answer-field-ee083db5-3ee1-5761-a700-038e4b0040ba"] :db/ensure [:question/validate]} {:db/id "answer-field-dad9a537-c8c8-5a4d-92d7-f01642118b81" :answer-field/id #uuid "dad9a537-c8c8-5a4d-92d7-f01642118b81" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a775068e-f991-59be-b61c-3d9f355a74b9" :answer-field/choices ["answer-a775068e-f991-59be-b61c-3d9f355a74b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-a775068e-f991-59be-b61c-3d9f355a74b9" :answer/id #uuid "a775068e-f991-59be-b61c-3d9f355a74b9" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-field-ee083db5-3ee1-5761-a700-038e4b0040ba" :answer-field/id #uuid "ee083db5-3ee1-5761-a700-038e4b0040ba" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b245a09b-ec25-541f-85cc-5f78e8d65ee1" :answer-field/choices ["answer-b245a09b-ec25-541f-85cc-5f78e8d65ee1"] :db/ensure [:answer-field/validate]} {:db/id "answer-b245a09b-ec25-541f-85cc-5f78e8d65ee1" :answer/id #uuid "b245a09b-ec25-541f-85cc-5f78e8d65ee1" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "question-7a74b26f-0105-5ef0-8131-fbfddb81968a" :question/id #uuid "7a74b26f-0105-5ef0-8131-fbfddb81968a" :question/math-academy-id "q-51910" :question/problem "What is the sum of the fifth, sixth, and seventh terms of the following sequence?\n\n$$\n-9,\\,-6,\\,-3,\\,0,\\,6,\\,12,\\,18\n$$" :question/worked-solution "For this sequence:\n\n- The first term is $-9$\n\n- The second term is $-6$\n\n- The third term is $-3$\n\n- The fourth term is $0$\n\n- The fifth term is $6$\n\n- The sixth term is $12$\n\n- The seventh term is $18$\n\nTherefore, the sum of the fifth, sixth, and seventh terms is \n\n$$\n6+12+18=36.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-995c06b4-7bac-59b0-a82d-0a7e0e7228e7"] :db/ensure [:question/validate]} {:db/id "answer-field-995c06b4-7bac-59b0-a82d-0a7e0e7228e7" :answer-field/id #uuid "995c06b4-7bac-59b0-a82d-0a7e0e7228e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a45af28-5cc9-5658-aa35-aaec70fc1d48" :answer-field/choices ["answer-12760c89-057a-5646-bd7e-e4decd5252bc" "answer-718ba38f-a078-591e-947d-1c1a65f291b4" "answer-7b1b5972-01ce-5b30-8f15-0c9438fef885" "answer-d10dd191-65ed-571b-9925-28908e586be7" "answer-4a45af28-5cc9-5658-aa35-aaec70fc1d48"] :db/ensure [:answer-field/validate]} {:db/id "answer-12760c89-057a-5646-bd7e-e4decd5252bc" :answer/id #uuid "12760c89-057a-5646-bd7e-e4decd5252bc" :answer/type :answer.type/math :answer/value "-18" :db/ensure [:answer/validate]} {:db/id "answer-718ba38f-a078-591e-947d-1c1a65f291b4" :answer/id #uuid "718ba38f-a078-591e-947d-1c1a65f291b4" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-7b1b5972-01ce-5b30-8f15-0c9438fef885" :answer/id #uuid "7b1b5972-01ce-5b30-8f15-0c9438fef885" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-d10dd191-65ed-571b-9925-28908e586be7" :answer/id #uuid "d10dd191-65ed-571b-9925-28908e586be7" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-4a45af28-5cc9-5658-aa35-aaec70fc1d48" :answer/id #uuid "4a45af28-5cc9-5658-aa35-aaec70fc1d48" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-4c253992-f8f6-54f1-85fd-c768c36b2399" :question/id #uuid "4c253992-f8f6-54f1-85fd-c768c36b2399" :question/math-academy-id "q-223474" :question/problem "A sequence is defined as $f(n)={n}^{2}-1$ for $n\\ge 1.$ What are the $3$rd and $6$th terms of the sequence?\n\nThe $3$rd term is\n{{field-1}}\nand the $6$th term is\n{{field-2}}." :question/worked-solution "Using the definition of the sequence, we find the $3$rd and $6$th terms corresponding to $n=3$ and $n=6,$ respectively:\n\n$$\n\\begin{aligned}f(3) & ={3}^{2}-1=8 \\\\ f(6) & ={6}^{2}-1=35\\end{aligned}\n$$\n\nTherefore, the $3$rd term is $8$ and the $6$th term is $35.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-92fed66e-500f-5762-be56-7e7c4552f0c6" "answer-field-cde7e62d-c2d6-5dd4-8154-82d02af8a287"] :db/ensure [:question/validate]} {:db/id "answer-field-92fed66e-500f-5762-be56-7e7c4552f0c6" :answer-field/id #uuid "92fed66e-500f-5762-be56-7e7c4552f0c6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ec440bfe-ea82-57e4-97da-c797c45e181e" :answer-field/choices ["answer-ec440bfe-ea82-57e4-97da-c797c45e181e"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec440bfe-ea82-57e4-97da-c797c45e181e" :answer/id #uuid "ec440bfe-ea82-57e4-97da-c797c45e181e" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-field-cde7e62d-c2d6-5dd4-8154-82d02af8a287" :answer-field/id #uuid "cde7e62d-c2d6-5dd4-8154-82d02af8a287" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5012a895-a225-58c1-9810-e7dffea25a49" :answer-field/choices ["answer-5012a895-a225-58c1-9810-e7dffea25a49"] :db/ensure [:answer-field/validate]} {:db/id "answer-5012a895-a225-58c1-9810-e7dffea25a49" :answer/id #uuid "5012a895-a225-58c1-9810-e7dffea25a49" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "question-0f81e122-7862-59a0-9cd2-28031f67f42e" :question/id #uuid "0f81e122-7862-59a0-9cd2-28031f67f42e" :question/math-academy-id "q-51917" :question/problem "A sequence is defined as $f(n)=3n-1$ for $n\\ge 1.$ What is the $5$th term of the sequence?" :question/worked-solution "To find the $5$th term, we substitute $n=5$ into the definition of the sequence:\n\n$$\n\\begin{aligned}f(n) & =3n-1 \\\\ f(5) & =3(5)-1 \\\\ f(5) & =14\\end{aligned}\n$$\n\nTherefore, the $5$th term is $14.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bec59771-dc1d-558c-afd4-2f7c1d0ebf2b"] :db/ensure [:question/validate]} {:db/id "answer-field-bec59771-dc1d-558c-afd4-2f7c1d0ebf2b" :answer-field/id #uuid "bec59771-dc1d-558c-afd4-2f7c1d0ebf2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e7203b52-8665-59ba-a989-ef111d423033" :answer-field/choices ["answer-05b6eb5f-f291-5567-bf9d-80ffe9def8c0" "answer-e7203b52-8665-59ba-a989-ef111d423033" "answer-22fbf7be-c1f0-54ef-8c83-7ccdd5beff61" "answer-cac79b2e-c97f-592b-af1d-faacecd0e377" "answer-a77fff65-39f6-5675-abd8-2e50dfee4d19"] :db/ensure [:answer-field/validate]} {:db/id "answer-05b6eb5f-f291-5567-bf9d-80ffe9def8c0" :answer/id #uuid "05b6eb5f-f291-5567-bf9d-80ffe9def8c0" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-e7203b52-8665-59ba-a989-ef111d423033" :answer/id #uuid "e7203b52-8665-59ba-a989-ef111d423033" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-22fbf7be-c1f0-54ef-8c83-7ccdd5beff61" :answer/id #uuid "22fbf7be-c1f0-54ef-8c83-7ccdd5beff61" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-cac79b2e-c97f-592b-af1d-faacecd0e377" :answer/id #uuid "cac79b2e-c97f-592b-af1d-faacecd0e377" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-a77fff65-39f6-5675-abd8-2e50dfee4d19" :answer/id #uuid "a77fff65-39f6-5675-abd8-2e50dfee4d19" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-041652e3-e5d6-50e5-af62-e1885be6626d" :question/id #uuid "041652e3-e5d6-50e5-af62-e1885be6626d" :question/math-academy-id "q-263003" :question/problem "If a sequence is defined as ${a}_{n}=7-3{n}^{2}$ for $n\\ge 1,$ then the sum of the third and fifth terms is{{field-1}}." :question/worked-solution "We substitute $n=3$ and $n=5$ into the definition of the sequence:\n\n$$\n\\begin{aligned}{a}_{3} & =7-3(3)^{2}=-20 \\\\ {a}_{5} & =7-3(5)^{2}=-68\\end{aligned}\n$$\n\nTherefore, the sum of the third and fifth terms is\n\n$$\n{a}_{3}+{a}_{5}=(-20)+(-68)=-88.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ab59f18d-be7d-5017-adf7-171d8d1ade47"] :db/ensure [:question/validate]} {:db/id "answer-field-ab59f18d-be7d-5017-adf7-171d8d1ade47" :answer-field/id #uuid "ab59f18d-be7d-5017-adf7-171d8d1ade47" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4dcaad24-9937-5eb5-8e1b-2b214068fe9e" :answer-field/choices ["answer-4dcaad24-9937-5eb5-8e1b-2b214068fe9e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4dcaad24-9937-5eb5-8e1b-2b214068fe9e" :answer/id #uuid "4dcaad24-9937-5eb5-8e1b-2b214068fe9e" :answer/type :answer.type/math :answer/value "-88" :db/ensure [:answer/validate]} {:db/id "question-f29afdcb-efb1-549b-8468-0f53b64a94c5" :question/id #uuid "f29afdcb-efb1-549b-8468-0f53b64a94c5" :question/math-academy-id "q-61145" :question/problem "A sequence is defined as ${a}_{n}=3n-2$ for $n\\ge 1.$ What is the sum of the third and fourth terms?" :question/worked-solution "We substitute $n=3$ and $n=4$ into the definition of the sequence:\n\n$$\n\\begin{aligned}{a}_{3} & =3(3)-2=7 \\\\ {a}_{4} & =3(4)-2=10\\end{aligned}\n$$\n\nTherefore, the sum of the third and fourth terms is\n\n$$\n{a}_{3}+{a}_{4}=7+10=17.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4cf5687d-1b58-5d00-a36e-60929c2459dd"] :db/ensure [:question/validate]} {:db/id "answer-field-4cf5687d-1b58-5d00-a36e-60929c2459dd" :answer-field/id #uuid "4cf5687d-1b58-5d00-a36e-60929c2459dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-522626a5-bf0b-54d0-a6e0-40e3923844ad" :answer-field/choices ["answer-bcba76b5-246f-56ae-8cd3-76cbae67ed37" "answer-100fb983-8d65-541a-b869-4fc441d08865" "answer-522626a5-bf0b-54d0-a6e0-40e3923844ad" "answer-8ab5a3bb-590b-57a6-9513-86017a2683ad" "answer-51e57a9c-0b53-5fd2-8134-d370f512590e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bcba76b5-246f-56ae-8cd3-76cbae67ed37" :answer/id #uuid "bcba76b5-246f-56ae-8cd3-76cbae67ed37" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-100fb983-8d65-541a-b869-4fc441d08865" :answer/id #uuid "100fb983-8d65-541a-b869-4fc441d08865" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-522626a5-bf0b-54d0-a6e0-40e3923844ad" :answer/id #uuid "522626a5-bf0b-54d0-a6e0-40e3923844ad" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "answer-8ab5a3bb-590b-57a6-9513-86017a2683ad" :answer/id #uuid "8ab5a3bb-590b-57a6-9513-86017a2683ad" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "answer-51e57a9c-0b53-5fd2-8134-d370f512590e" :answer/id #uuid "51e57a9c-0b53-5fd2-8134-d370f512590e" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-fc6510bd-b576-581a-8664-e81e95aec6a7" :question/id #uuid "fc6510bd-b576-581a-8664-e81e95aec6a7" :question/math-academy-id "q-101278" :question/problem "Which of the following statements is true regarding the sequence ${a}_{n}=4n+1$ for $n\\ge 1?$\n\nI. Its first term is $5$\n\nII. Its first term is twice the second term\n\nIII. Its last term is $41$" :question/worked-solution "Let's analyze each statement in turn.\n\n- The first term of the sequence is represented by ${a}_{1}.$ Using the rule ${a}_{n}=4n+1,$ we compute ${a}_{1}=4+1=5.$ Therefore, statement I is true.\n\n- The second term of the sequence is represented by ${a}_{2}.$ Using the rule ${a}_{n}=4n+1,$ we compute ${a}_{2}=8+1=9.$  The first term was ${a}_{1}=5,$ and the second term is ${a}_{2}=9,$ so the first term is not twice the second term. Therefore, statement II is false.\n\n- The sequence is defined for $n\\ge 1,$ which means that there is no limit to how large $n$ can be. There is no last term because the sequence keeps going on forever. Therefore, statement III is false.\n\nIn conclusion, only statement I is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f733173d-d399-586b-b3ed-e56eee05876e"] :db/ensure [:question/validate]} {:db/id "answer-field-f733173d-d399-586b-b3ed-e56eee05876e" :answer-field/id #uuid "f733173d-d399-586b-b3ed-e56eee05876e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a96399f-01c4-5213-b107-8109020c06da" :answer-field/choices ["answer-96f2a7f1-fdbf-5211-9740-86643e3c1238" "answer-2f1e5d33-798f-59a0-8cf6-2e862eec20f5" "answer-6a96399f-01c4-5213-b107-8109020c06da" "answer-d0c04a4f-b605-5d91-9d74-4d6db89400bb" "answer-91212a9f-d8f0-5071-b277-4b62392480e2"] :db/ensure [:answer-field/validate]} {:db/id "answer-96f2a7f1-fdbf-5211-9740-86643e3c1238" :answer/id #uuid "96f2a7f1-fdbf-5211-9740-86643e3c1238" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-2f1e5d33-798f-59a0-8cf6-2e862eec20f5" :answer/id #uuid "2f1e5d33-798f-59a0-8cf6-2e862eec20f5" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-6a96399f-01c4-5213-b107-8109020c06da" :answer/id #uuid "6a96399f-01c4-5213-b107-8109020c06da" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d0c04a4f-b605-5d91-9d74-4d6db89400bb" :answer/id #uuid "d0c04a4f-b605-5d91-9d74-4d6db89400bb" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-91212a9f-d8f0-5071-b277-4b62392480e2" :answer/id #uuid "91212a9f-d8f0-5071-b277-4b62392480e2" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "question-69da1904-3ed5-5a22-8299-a97a8db45c15" :question/id #uuid "69da1904-3ed5-5a22-8299-a97a8db45c15" :question/math-academy-id "q-101290" :question/problem "A sequence is defined as ${a}_{n}=2n+5$ for $n\\ge 1.$ What is the sum of the third and fourth terms?" :question/worked-solution "We substitute $n=3$ and $n=4$ into the definition of the sequence:\n\n$$\n\\begin{aligned}{a}_{3} & =2(3)+5=11 \\\\ {a}_{4} & =2(4)+5=13\\end{aligned}\n$$\n\nTherefore, the sum of the third and fourth terms is\n\n$$\n{a}_{3}+{a}_{4}=11+13=24.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8e713a8a-5f6a-5b0c-a684-717a46996831"] :db/ensure [:question/validate]} {:db/id "answer-field-8e713a8a-5f6a-5b0c-a684-717a46996831" :answer-field/id #uuid "8e713a8a-5f6a-5b0c-a684-717a46996831" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d044f1bc-cb08-5254-84b4-44bbb9073fd0" :answer-field/choices ["answer-8304f7e9-1fea-5ccd-a9a7-ef4de3d1d439" "answer-020cab41-2efd-529a-9701-6a25b46b30af" "answer-03c6ae7d-ca5f-5984-9cf2-d30dffcfeb71" "answer-de554208-b10f-5daf-92f0-0c6f8b17cd7e" "answer-d044f1bc-cb08-5254-84b4-44bbb9073fd0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8304f7e9-1fea-5ccd-a9a7-ef4de3d1d439" :answer/id #uuid "8304f7e9-1fea-5ccd-a9a7-ef4de3d1d439" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-020cab41-2efd-529a-9701-6a25b46b30af" :answer/id #uuid "020cab41-2efd-529a-9701-6a25b46b30af" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-03c6ae7d-ca5f-5984-9cf2-d30dffcfeb71" :answer/id #uuid "03c6ae7d-ca5f-5984-9cf2-d30dffcfeb71" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-de554208-b10f-5daf-92f0-0c6f8b17cd7e" :answer/id #uuid "de554208-b10f-5daf-92f0-0c6f8b17cd7e" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-d044f1bc-cb08-5254-84b4-44bbb9073fd0" :answer/id #uuid "d044f1bc-cb08-5254-84b4-44bbb9073fd0" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id 17592186139601 :tutorial/content "A **sequence** is a list of numbers. \n\nFor example, the following list of numbers is a sequence:\n\n$$\n{\\color{blue}{4}},\\qquad {\\color{blue}{8}},\\qquad {\\color{blue}{12}},\\qquad {\\color{blue}{16}}\n$$\n\nThe numbers in a sequence are called **terms**. For this sequence:\n\n- the **first term** is ${\\color{blue}{4}}$\n\n- the **second term** is ${\\color{blue}{8}}$\n\n- the **third term** is ${\\color{blue}{12}}$\n\n- the **fourth term** is ${\\color{blue}{16}}.$ This is also called the **last term** of the sequence." :db/ensure [:tutorial/validate]} {:db/id 17592186139741 :tutorial/content "Let's return to the following sequence:\n\n$$\n{\\color{blue}{4}},\\qquad {\\color{blue}{8}},\\qquad {\\color{blue}{12}},\\qquad {\\color{blue}{16}}\n$$\n\nFor this sequence:\n\n- the ${\\color{red}{1}}$st term is ${\\color{blue}{4}}$\n\n- the ${\\color{red}{2}}$nd term is ${\\color{blue}{8}}$\n\n- the ${\\color{red}{3}}$rd term is ${\\color{blue}{12}}$\n\n- the ${\\color{red}{4}}$th term is ${\\color{blue}{16}}$\n\nWe can represent our sequence using a mapping diagram, as shown below.\n\n![](images/55/55ce8f88af49913a493e6f9062f9f72c01f5cc707dc7f87e1862b750f696f7a0.png)\n\nThe input values refer to the position of each term in the sequence. \n\nNotice that each input value is mapped to one (and only one) output value. Therefore, this sequence is also a *function*, which we can call $f({\\color{red}{n}}).$ For sequences, we usually use the letter $n$ instead of $x$ for the input variable.\n\nSo, for this function, we have the following input and output values:\n\n$$\n\\begin{aligned}f(1) & =4 \\\\ f(2) & =8 \\\\ f(3) & =12 \\\\ f(4) & =16\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186139742 :tutorial/content "Let's find the sequence generated by the following function:\n\n$$\nf({\\color{red}{n}}) = {\\color{red}{n}} + 1\n$$\n\nWe can find the first five terms of this sequence by substituting ${\\color{red}{n}} = {\\color{red}{1}},{\\color{red}{2}}, {\\color{red}{3}},{\\color{red}{4}},{\\color{red}{5}}$ into the function. \n\n$$\n\\begin{aligned}f(1) & =1+1=2 \\\\ f(2) & =2+1=3 \\\\ f(3) & =3+1=4 \\\\ f(4) & =4+1=5 \\\\ f(5) & =5+1=6\\end{aligned}\n$$\n\nTherefore, this function generates the following sequence:\n\n$$\n{\\color{blue}{2}},\\qquad {\\color{blue}{3}},\\qquad {\\color{blue}{4}},\\qquad {\\color{blue}{5}}, \\qquad {\\color{blue}{6}}, \\qquad \\ldots\n$$\n\nThe \"$\\ldots$\" at the end tells us this sequence continues forever. In other words, this sequence has no last term!\n\nIf we want to find, say, the ${\\color{red}{100}}$th term of the sequence, we simply substitute ${\\color{red}{n}}= {\\color{red}{100}}$ into our function:\n\n$$\nf({\\color{red}{100}}) = {\\color{red}{100}} + 1 = {\\color{blue}{101}}\n$$\n\nTherefore, the ${\\color{red}{100}}$th term of the sequence is ${\\color{blue}{101}} .$\n\nWe usually need to specify which values of ${\\color{red}{n}}$ are allowed to be used in our function. To do this, we can write our function as follows:\n\n$$\nf({\\color{red}{n}}) = {\\color{red}{n}} + 1, \\qquad  {\\color{red}{n}} \\geq 1\n$$\n\nThe statement ${\\color{red}{n}} \\geq 1$ specifies the function's *domain*. It tells us we can input integer values greater than or equal to $1$ into our function. \n\nFinally, since every term of the sequence can be generated using our function, we say that $f({\\color{red}{n}})$ *generates the ${\\color{red}{n}}$th term of the sequence*." :db/ensure [:tutorial/validate]} {:db/id 17592186139600 :tutorial/content "Let's consider the following sequence once more:\n\n$$\n{\\color{blue}{2}},\\qquad {\\color{blue}{3}},\\qquad {\\color{blue}{4}},\\qquad {\\color{blue}{5}}, \\qquad {\\color{blue}{6}}, \\qquad \\ldots\n$$\n\nMathematicians sometimes prefer not to use function notation when describing sequences. The alternative is to use **sequence notation**. With sequence notation, we refer to the ${\\color{red}{n}}$th term of the sequence as $a_{\\color{red}{n}}.$\n\nSo for the sequence listed above, we have:\n\n$$\n\\begin{aligned}{a}_{1} & =2 \\\\ {a}_{2} & =3 \\\\ {a}_{3} & =4 \\\\ {a}_{4} & =5 \\\\ {a}_{5} & =6\\end{aligned}\n$$\n\nRecall that we were able to express this sequence using function notation as follows:\n\n$$\nf({\\color{red}{n}}) = {\\color{red}{n}}+1, \\qquad n\\geq 1\n$$\n\nIn sequence notation, the formula looks similar:\n\n$$\na_{\\color{red}{n}} = {\\color{red}{n}}+1, \\qquad n\\geq 1\n$$\n\nWe can calculate the ${\\color{red}{99}}$th term of our sequence by substituting ${\\color{red}{n}}=99$ into the expression $a_{\\color{red}{n}}{:}$\n\n$$\na_{\\color{red}{99}} = {\\color{red}{99}}+1 = {\\color{blue}{100}}\n$$\n\nTherefore, the ${\\color{red}{99}}$th term of our sequence is ${\\color{blue}{100}}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186138598 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
