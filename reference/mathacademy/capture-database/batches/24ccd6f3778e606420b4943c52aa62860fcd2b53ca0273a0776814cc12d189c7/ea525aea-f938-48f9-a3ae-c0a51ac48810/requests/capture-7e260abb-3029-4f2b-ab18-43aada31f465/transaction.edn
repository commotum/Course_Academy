n/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators. \n\nSince the denominators $7$ and $2$ are prime numbers, they are already represented by their respective prime factorizations. \n\nNow, we write down each prime factor, and we raise each factor to the highest power given in either factorization:\n\n- the highest power of $7$ is $1$\n\n- the highest power of $2$ is also $1$\n\nTherefore, the lowest common denominator is ${7}^{1}\\cdot {2}^{1}=14.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-56ea52af-12b6-5644-b4a6-ed05e7a0427f"] :db/ensure [:question/validate]} {:db/id "answer-field-56ea52af-12b6-5644-b4a6-ed05e7a0427f" :answer-field/id #uuid "56ea52af-12b6-5644-b4a6-ed05e7a0427f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer-field/choices ["answer-0fc56540-d358-50d3-b73a-c0b1425f94b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/id #uuid "0fc56540-d358-50d3-b73a-c0b1425f94b5" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "activity-0f953c2b-c29d-5f31-8376-5f13777043a0" :activity/id #uuid "0f953c2b-c29d-5f31-8376-5f13777043a0" :activity/title "Quiz 21" :activity/type :activity.type/assessment :activity/course 17592186046647 :activity/steps ["step-47c4606f-8ebf-5865-94dc-f08b36d8f5af" "step-9b7559a0-2252-5bd4-af1e-a93265c6f941" "step-977c3dea-b742-55e2-995c-c851a738de08" "step-0d37e1d3-6c33-5f0f-bc28-e7b63d04fffd" "step-f7f235c3-b4f6-5d1c-9fcc-d0e8c62cf484" "step-c892973b-5533-5fc4-ac18-c5f0e8662f83" "step-6082acad-1a61-5e48-a711-2234a35580ad" "step-4c3b6142-2ace-585c-97b7-d4c65b594061" "step-af473a3b-d261-5719-88fc-cd279c0b70e5" "step-1945aad4-ec78-547d-9bd0-70ae80932ccf" "step-e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" "step-ed5c5991-e25b-5506-8cce-