3a3b-d261-5719-88fc-cd279c0b70e5" :db/ensure [:step/validate]} {:db/id "step-af473a3b-d261-5719-88fc-cd279c0b70e5" :step/id #uuid "af473a3b-d261-5719-88fc-cd279c0b70e5" :step/content "question-01d6b59b-be2b-52a2-b7cf-129c1864b658" :step/next "step-1945aad4-ec78-547d-9bd0-70ae80932ccf" :db/ensure [:step/validate]} {:db/id "step-1945aad4-ec78-547d-9bd0-70ae80932ccf" :step/id #uuid "1945aad4-ec78-547d-9bd0-70ae80932ccf" :step/content "question-d77788ff-b482-51d4-bdb1-79e3cff6db85" :step/next "step-e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" :db/ensure [:step/validate]} {:db/id "step-e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" :step/id #uuid "e047b69d-3db6-52d0-bf3d-6c688a3ce9c0" :step/content "question-78772149-6410-5606-9ad3-23c6e01f9b0e" :step/next "step-ed5c5991-e25b-5506-8cce-f164e5317337" :db/ensure [:step/validate]} {:db/id "step-ed5c5991-e25b-5506-8cce-f164e5317337" :step/id #uuid "ed5c5991-e25b-5506-8cce-f164e5317337" :step/content "question-093f60b7-b595-5220-994a-63101bc04a42" :db/ensure [:step/validate]} {:db/id 17592186166904 :knowledge-point/questions ["question-83030669-b615-545c-b0dd-a292bd26151d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-83030669-b615-545c-b0dd-a292bd26151d" :question/id #uuid "83030669-b615-545c-b0dd-a292bd26151d" :question/math-academy-id "q-333014" :question/problem "Consider the following inhomogeneous system of linear differential equations:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}\\frac{5}{3} & -\\frac{8}{3} \\\\ -\\frac{4}{3} & \\frac{1}{3}\\end{aligned}]x(t)+[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}]\n$$\n\nThe complementary solution to this system is given by\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThen, the general solution of the system is\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $x(t)={x}_{c}(t)+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,{t}^{2}+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    $\\,\\,t+\\,\\,$\n  </td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    {{field-2}}\n  </td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"40px\" rowspan=\"2\">\n    .\n  </td>\n</tr>\n<tr>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">$-1$</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n<td height=\"30px\" width=\"5px\"></td>\n<td align=\"center\">\n    $-2$\n  </td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nThe forcing term\n\n$$\n[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}]\n$$\n\nof the inhomogeneous system of ODEs is polynomial of degree $2.$ Therefore, we assume that the particular solution is also polynomial of degree $2,$ i.e.\n\n$$\n{x}_{p}(t)=[\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]{t}^{2}+[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]t+[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\n$$\n\nwhere ${a}_{1},{a}_{2},{b}_{1},{b}_{2},{c}_{1},{c}_{2}$ are constants that are to be determined. \n\nCalculating the derivative of ${x}_{p}$ with respect to $t$ gives\n\n$$\n{x}_{p}^{′}(t)=[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}].\n$$\n\nTo find the unknown constants, we substitute ${x}_{p}$ and ${x}_{p}^{′}$ into our system:\n\n$$\n\\begin{aligned}[\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}\\frac{5}{3} & -\\frac{8}{3} \\\\ -\\frac{4}{3} & \\frac{1}{3}\\end{aligned}][\\begin{aligned}{a}_{1}{t}^{2}+{b}_{1}t+{c}_{1} \\\\ {a}_{2}{t}^{2}+{b}_{2}t+{c}_{2}\\end{aligned}]+[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}] \\\\ [\\begin{aligned}2{a}_{1}t+{b}_{1} \\\\ 2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(\\frac{5{a}_{1}-8{a}_{2}}{3}){t}^{2}+(\\frac{5{b}_{1}-8{b}_{2}}{3})t+(\\frac{5{c}_{1}-8{c}_{2}}{3}) \\\\ (\\frac{-4{a}_{1}+{a}_{2}}{3}){t}^{2}+(\\frac{-4{b}_{1}+{b}_{2}}{3})t+(\\frac{-4{c}_{1}+{c}_{2}}{3})\\end{aligned}]+[\\begin{aligned}-6{t}^{2}+\\frac{41}{3}t-8 \\\\ 3{t}^{2}-\\frac{13}{3}t+5\\end{aligned}] \\\\ [\\begin{aligned}0{t}^{2}+2{a}_{1}t+{b}_{1} \\\\ 0{t}^{2}+2{a}_{2}t+{b}_{2}\\end{aligned}] & =[\\begin{aligned}(\\frac{5{a}_{1}-8{a}_{2}-18}{3}){t}^{2}+(\\frac{5{b}_{1}-8{b}_{2}+41}{3})t+(\\frac{5{c}_{1}-8{c}_{2}-24}{3}) \\\\ (\\frac{-4{a}_{1}+{a}_{2}+9}{3}){t}^{2}+(\\frac{-4{b}_{1}+{b}_{2}-13}{3})t+(\\frac{-4{c}_{1}+{c}_{2}+15}{3})\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding coefficients of like powers of $t,$ we get the following system:\n\n$$\n\\{\\begin{aligned}\\frac{5{a}_{1}-8{a}_{2}-18}{3}=0 \\\\ \\frac{-4{a}_{1}+{a}_{2}+9}{3}=0 \\\\ \\frac{5{b}_{1}-8{b}_{2}+41}{3}=2{a}_{1} \\\\ \\frac{-4{b}_{1}+{b}_{2}-13}{3}=2{a}_{2} \\\\ \\frac{5{c}_{1}-8{c}_{2}-24}{3}={b}_{1} \\\\ \\frac{-4{c}_{1}+{c}_{2}+15}{3}={b}_{2}\\end{aligned}\n$$\n\nSolving the first and second equations, we get\n\n$$\n{a}_{1}=2,\\,{a}_{2}=-1.\n$$\n\nSubstituting these into the second and third equations, and solving for ${b}_{1}$ and ${b}_{2},$ we get\n\n$$\n{b}_{1}=-1,\\,{b}_{2}=3.\n$$\n\nFinally, substituting these last two values into the fourth and sixth equations, and solving for ${c}_{1}$ and ${c}_{2},$ we have\n\n$$\n{c}_{1}=1,\\,{c}_{2}=-2.\n$$\n\nTherefore, the particular solution is\n\n$$\n{x}_{p}(t)=[\\begin{aligned}2{t}^{2}-t+1 \\\\ -{t}^{2}+3t-2\\end{aligned}]=[\\begin{aligned}2 \\\\ -1\\end{aligned}]{t}^{2}+[\\begin{aligned}-1 \\\\ 3\\end{aligned}]t+[\\begin{aligned}1 \\\\ -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-68ebb6bc-8ecd-5644-95d4-7ec3ae49104a" "answer-field-ecb59f7c-3318-5766-b4e8-a59390b05bce" "answer-field-e2f40649-92a8-5fb9-9467-241241b205e5"] :db/ensure [:question/validate]} {:db/id "answer-field-68ebb6bc-8ecd-5644-95d4-7ec3ae49104a" :answer-field/id #uuid "68ebb6bc-8ecd-5644-95d4-7ec3ae49104a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-93ad8973-8142-5ec3-9098-90c172b538cc" :answer-field/choices ["answer-93ad8973-8142-5ec3-9098-90c172b538cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-93ad8973-8142-5ec3-9098-90c172b538cc" :answer/id #uuid "93ad8973-8142-5ec3-9098-90c172b538cc" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-ecb59f7c-3318-5766-b4e8-a59390b05bce" :answer-field/id #uuid "ecb59f7c-3318-5766-b4e8-a59390b05bce" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c8b19b21-147d-5fdc-8f4d-a5e1d36c4409" :answer-field/choices ["answer-c8b19b21-147d-5fdc-8f4d-a5e1d36c4409"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8b19b21-147d-5fdc-8f4d-a5e1d36c4409" :answer/id #uuid "c8b19b21-147d-5fdc-8f4d-a5e1d36c4409" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-e2f40649-92a8-5fb9-9467-241241b205e5" :answer-field/id #uuid "e2f40649-92a8-5fb9-9467-241241b205e5" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2d3c4717-e0dc-535a-af6f-a87c7e67b231" :answer-field/choices ["answer-2d3c4717-e0dc-535a-af6f-a87c7e67b231"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d3c4717-e0dc-535a-af6f-a87c7e67b231" :answer/id #uuid "2d3c4717-e0dc-535a-af6f-a87c7e67b231" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186166905 :knowledge-point/questions ["question-e4dc2c43-c8eb-5bcf-a39b-abeb3bbb2764" "question-338f9068-6af3-5a99-af8d-48b1ac33890b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e4dc2c43-c8eb-5bcf-a39b-abeb3bbb2764" :question/id #uuid "e4dc2c43-c8eb-5bcf-a39b-abeb3bbb2764" :question/math-academy-id "q-333596" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]x(t)+{e}^{-t}[\\begin{aligned}-1 \\\\ -3\\end{aligned}],\\,x(0)=[\\begin{aligned}3 \\\\ -2\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]\\,-$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}t{e}^{2t} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].$" :question/worked-solution "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}t{e}^{2t} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{2(0)} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0\\cdot {e}^{2(0)} \\\\ {e}^{2(0)}\\end{aligned}]+{e}^{-0}[\\begin{aligned}0 \\\\ 1\\end{aligned}] & =[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}0 \\\\ 1\\end{aligned}] & =[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}+1\\end{aligned}] & =[\\begin{aligned}3 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n\\{\\begin{aligned}{c}_{1}=3 \\\\ {c}_{2}+1=-2\\end{aligned}\n$$\n\nFrom the first equation, we have ${c}_{1}=3.$ From the second equation, we get ${c}_{2}=-3.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=3\\cdot [\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]-3\\cdot [\\begin{aligned}t{e}^{2t} \\\\ {e}^{2t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6da43cad-9102-5837-b0fd-1a8a586b0473" "answer-field-9d8e6467-de2d-5e39-8c4a-83e68c137488"] :db/ensure [:question/validate]} {:db/id "answer-field-6da43cad-9102-5837-b0fd-1a8a586b0473" :answer-field/id #uuid "6da43cad-9102-5837-b0fd-1a8a586b0473" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-97a52fdf-3469-584f-9753-ff054f6fb144" :answer-field/choices ["answer-97a52fdf-3469-584f-9753-ff054f6fb144"] :db/ensure [:answer-field/validate]} {:db/id "answer-97a52fdf-3469-584f-9753-ff054f6fb144" :answer/id #uuid "97a52fdf-3469-584f-9753-ff054f6fb144" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-9d8e6467-de2d-5e39-8c4a-83e68c137488" :answer-field/id #uuid "9d8e6467-de2d-5e39-8c4a-83e68c137488" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bf902f7a-5b81-5b56-a8db-6e1126ebbd99" :answer-field/choices ["answer-bf902f7a-5b81-5b56-a8db-6e1126ebbd99"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf902f7a-5b81-5b56-a8db-6e1126ebbd99" :answer/id #uuid "bf902f7a-5b81-5b56-a8db-6e1126ebbd99" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-338f9068-6af3-5a99-af8d-48b1ac33890b" :question/id #uuid "338f9068-6af3-5a99-af8d-48b1ac33890b" :question/math-academy-id "q-333610" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]x(t)+[\\begin{aligned}-{t}^{2}+3t-2 \\\\ -4t+8\\end{aligned}],\\,x(0)=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]\\,-$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}{t}^{2}-t+1 \\\\ 2t-3\\end{aligned}].$" :question/worked-solution "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}{t}^{2}-t+1 \\\\ 2t-3\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{0} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {e}^{2(0)}\\end{aligned}]+[\\begin{aligned}{0}^{2}-0+1 \\\\ 2(0)-3\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -3\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+1 \\\\ {c}_{2}-3\\end{aligned}] & =[\\begin{aligned}2 \\\\ -5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n\\{\\begin{aligned}{c}_{1}+1=2 \\\\ {c}_{2}-3=-5\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=1.$ From the second equation, we have ${c}_{2}=-2.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=1\\cdot [\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]-2\\cdot [\\begin{aligned}0 \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}{t}^{2}-t+1 \\\\ 2t-3\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1a013588-c06c-5f55-940c-cbbd3057b90b" "answer-field-f188d9c6-552e-5855-a6ab-7fbed03f69d1"] :db/ensure [:question/validate]} {:db/id "answer-field-1a013588-c06c-5f55-940c-cbbd3057b90b" :answer-field/id #uuid "1a013588-c06c-5f55-940c-cbbd3057b90b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-388279d1-e34b-50a4-9ce3-cc8dace5482c" :answer-field/choices ["answer-388279d1-e34b-50a4-9ce3-cc8dace5482c"] :db/ensure [:answer-field/validate]} {:db/id "answer-388279d1-e34b-50a4-9ce3-cc8dace5482c" :answer/id #uuid "388279d1-e34b-50a4-9ce3-cc8dace5482c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-f188d9c6-552e-5855-a6ab-7fbed03f69d1" :answer-field/id #uuid "f188d9c6-552e-5855-a6ab-7fbed03f69d1" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8cfa8656-14de-5766-be79-8ae7b5309f14" :answer-field/choices ["answer-8cfa8656-14de-5766-be79-8ae7b5309f14"] :db/ensure [:answer-field/validate]} {:db/id "answer-8cfa8656-14de-5766-be79-8ae7b5309f14" :answer/id #uuid "8cfa8656-14de-5766-be79-8ae7b5309f14" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "activity-cd780238-6561-5335-8628-86c0ec2f992b" :activity/id #uuid "cd780238-6561-5335-8628-86c0ec2f992b" :activity/title "Solving Inhomogeneous Systems of ODEs" :activity/type :activity.type/review :activity/scope 17592186050801 :activity/course 17592186046660 :activity/steps ["step-b1481bb9-2ae6-5119-bb02-e73517637dbf" "step-8af18c3c-574b-5432-b3c3-e6d29db74282" "step-4b0c53fd-63dc-5e60-91b1-9c112e1416ed" "step-8300d53d-a4ca-5fa3-80df-bd513e8ce9c1" "step-97a61470-ffa2-5ca9-9f97-05f72a262645"] :activity/first-step "step-b1481bb9-2ae6-5119-bb02-e73517637dbf" :db/ensure [:activity/validate]} {:db/id "step-b1481bb9-2ae6-5119-bb02-e73517637dbf" :step/id #uuid "b1481bb9-2ae6-5119-bb02-e73517637dbf" :step/content 17592186305112 :step/next "step-8af18c3c-574b-5432-b3c3-e6d29db74282" :db/ensure [:step/validate]} {:db/id "step-8af18c3c-574b-5432-b3c3-e6d29db74282" :step/id #uuid "8af18c3c-574b-5432-b3c3-e6d29db74282" :step/content 17592186305149 :step/next "step-4b0c53fd-63dc-5e60-91b1-9c112e1416ed" :db/ensure [:step/validate]} {:db/id "step-4b0c53fd-63dc-5e60-91b1-9c112e1416ed" :step/id #uuid "4b0c53fd-63dc-5e60-91b1-9c112e1416ed" :step/content "question-83030669-b615-545c-b0dd-a292bd26151d" :step/next "step-8300d53d-a4ca-5fa3-80df-bd513e8ce9c1" :db/ensure [:step/validate]} {:db/id "step-8300d53d-a4ca-5fa3-80df-bd513e8ce9c1" :step/id #uuid "8300d53d-a4ca-5fa3-80df-bd513e8ce9c1" :step/content "question-e4dc2c43-c8eb-5bcf-a39b-abeb3bbb2764" :step/next "step-97a61470-ffa2-5ca9-9f97-05f72a262645" :db/ensure [:step/validate]} {:db/id "step-97a61470-ffa2-5ca9-9f97-05f72a262645" :step/id #uuid "97a61470-ffa2-5ca9-9f97-05f72a262645" :step/content "question-338f9068-6af3-5a99-af8d-48b1ac33890b" :db/ensure [:step/validate]} [:db/retract 17592186190996 :answer-field/choices 17592186190997] [:db/retract 17592186190996 :answer-field/choices 17592186190998] [:db/retract 17592186190996 :answer-field/choices 17592186190999] [:db/retract 17592186190996 :answer-field/choices 17592186191000] [:db/retract 17592186190996 :answer-field/choices 17592186191001] {:db/id 17592186192792 :knowledge-point/questions ["question-629276db-5577-5de0-b4ed-4cb541d19524" "question-cc803095-076a-5b93-b2c7-da97793184ac"] :db/ensure [:knowledge-point/validate]} {:db/id "question-629276db-5577-5de0-b4ed-4cb541d19524" :question/id #uuid "629276db-5577-5de0-b4ed-4cb541d19524" :question/math-academy-id "q-158686" :question/problem "![](images/e0/e006f41f3c8a0201623c88bd4f3738bea05258690c8a0adef297769341a3f490.png)\n\nGiven that $r$, $s$ and $t$ in the above diagram are parallel, find $m∠1.$" :question/worked-solution "Consider $∠2$ in the diagram below.\n\n![](images/2b/2bca55a68d4a0695c73f82ca82d5fae386d9b8d57b058bc1cf694bee902cff25.png)\n\nNotice that $∠2$ and the angle whose measure is ${42}^{∘}$ are alternate exterior angles formed when the transversal $u$ cuts the parallel lines $r$ and $s.$ Hence, \n\n$$\nm∠2={42}^{∘}.\n$$\n\nAlso, notice that the angle determined by $∠1$ and $∠2$ and the angle whose measure is ${108}^{∘}$ are corresponding angles formed when the transversal $v$ cuts the parallel lines $s$ and $t.$ Hence, \n\n$$\nm∠1+m∠2={108}^{∘}.\n$$\n\nNow, substituting $m∠2$ into the equation, we can find $m∠1:$\n\n$$\n\\begin{aligned}m∠1+m∠2 & ={108}^{∘} \\\\ m∠1+{42}^{∘} & ={108}^{∘} \\\\ m∠1 & ={66}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f103b71a-3895-5bbb-9e5b-34cbab5a6e85"] :db/ensure [:question/validate]} {:db/id "answer-field-f103b71a-3895-5bbb-9e5b-34cbab5a6e85" :answer-field/id #uuid "f103b71a-3895-5bbb-9e5b-34cbab5a6e85" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c95af01a-89de-5e7a-af1b-8256384ea06b" :answer-field/choices ["answer-ef27bd67-7618-5a40-88e1-2590421dc7a9" "answer-c95af01a-89de-5e7a-af1b-8256384ea06b" "answer-8698773b-0f0c-5034-aa7f-9e6b850c7169" "answer-8df7c2df-5ee2-59e1-bdbf-8bf112440439" "answer-caf3290d-1f86-5c91-9631-5c5198c4c243"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef27bd67-7618-5a40-88e1-2590421dc7a9" :answer/id #uuid "ef27bd67-7618-5a40-88e1-2590421dc7a9" :answer/type :answer.type/math :answer/value "{63}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c95af01a-89de-5e7a-af1b-8256384ea06b" :answer/id #uuid "c95af01a-89de-5e7a-af1b-8256384ea06b" :answer/type :answer.type/math :answer/value "{66}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-8698773b-0f0c-5034-aa7f-9e6b850c7169" :answer/id #uuid "8698773b-0f0c-5034-aa7f-9e6b850c7169" :answer/type :answer.type/math :answer/value "{68}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-8df7c2df-5ee2-59e1-bdbf-8bf112440439" :answer/id #uuid "8df7c2df-5ee2-59e1-bdbf-8bf112440439" :answer/type :answer.type/math :answer/value "{72}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-caf3290d-1f86-5c91-9631-5c5198c4c243" :answer/id #uuid "caf3290d-1f86-5c91-9631-5c5198c4c243" :answer/type :answer.type/math :answer/value "{75}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-cc803095-076a-5b93-b2c7-da97793184ac" :question/id #uuid "cc803095-076a-5b93-b2c7-da97793184ac" :question/math-academy-id "q-158688" :question/problem "![](images/6f/6f1cb5dc40aec6a6a6402d01c50ed85d30c7992606d9957b92084a0a097823c4.png)\n\nGiven that $r$, $s$ and $t$ in the above diagram are parallel, find $m∠1.$" :question/worked-solution "Consider $∠2$ in the diagram below.\n\n![](images/5a/5afb2a0f9f26dc3c02b52ac50743e9541f587349267b0c322cb2644b09c48617.png)\n\nNotice that $∠2$ and the angle whose measure is ${66}^{∘}$ are alternate exterior angles formed when the transversal $v$ cuts the parallel lines $r$ and $s.$ Hence, \n\n$$\nm∠2={66}^{∘}.\n$$\n\nAlso, notice that the angle determined by $∠1$ and $∠2$ and the angle whose measure is ${127}^{∘}$ are corresponding angles formed when the transversal $u$ cuts the parallel lines $s$ and $t.$ Hence, \n\n$$\nm∠1+m∠2={127}^{∘}.\n$$\n\nNow, substituting $m∠2$ into the equation, we can find $m∠1:$\n\n$$\n\\begin{aligned}m∠1+m∠2 & ={127}^{∘} \\\\ m∠1+{66}^{∘} & ={127}^{∘} \\\\ m∠1 & ={61}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-70727cad-1fa5-57b5-a403-bf29c9a59dfd"] :db/ensure [:question/validate]} {:db/id "answer-field-70727cad-1fa5-57b5-a403-bf29c9a59dfd" :answer-field/id #uuid "70727cad-1fa5-57b5-a403-bf29c9a59dfd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-33302008-aa55-56c7-bf1e-e55a835f4440" :answer-field/choices ["answer-f7fdc5c3-1a1e-5f72-b392-a3e4399ed4df" "answer-a353db00-3bd9-5418-b1a7-d5c0cb85203b" "answer-33302008-aa55-56c7-bf1e-e55a835f4440" "answer-5bd8f886-846d-5e11-b514-e23f590ce77c" "answer-d7db8ed6-3853-5c35-a03f-c6dcacaddf74"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7fdc5c3-1a1e-5f72-b392-a3e4399ed4df" :answer/id #uuid "f7fdc5c3-1a1e-5f72-b392-a3e4399ed4df" :answer/type :answer.type/math :answer/value "{53}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-a353db00-3bd9-5418-b1a7-d5c0cb85203b" :answer/id #uuid "a353db00-3bd9-5418-b1a7-d5c0cb85203b" :answer/type :answer.type/math :answer/value "{57}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-33302008-aa55-56c7-bf1e-e55a835f4440" :answer/id #uuid "33302008-aa55-56c7-bf1e-e55a835f4440" :answer/type :answer.type/math :answer/value "{61}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-5bd8f886-846d-5e11-b514-e23f590ce77c" :answer/id #uuid "5bd8f886-846d-5e11-b514-e23f590ce77c" :answer/type :answer.type/math :answer/value "{66}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d7db8ed6-3853-5c35-a03f-c6dcacaddf74" :answer/id #uuid "d7db8ed6-3853-5c35-a03f-c6dcacaddf74" :answer/type :answer.type/math :answer/value "{69}^{∘}" :db/ensure [:answer/validate]} {:db/id 17592186193185 :question/problem "![](images/51/5178d7f2910b4a28116022968e6a2d5580b9284d65bb7dc973e36f4c2a2f4ccd.png)\n\nGiven that $\\overset{↔}{AB}∥\\overset{↔}{CF},$ what is the measure of $∠AFB?$" :question/worked-solution "Notice that $∠BAF$  and $∠AFC$ are alternate interior angles formed when the transversal $\\overset{↔}{AF}$ cuts the parallel lines $\\overset{↔}{AB}$ and $\\overset{↔}{CF}.$ Hence, \n\n$$\nm∠AFC=m∠BAF={71}^{∘}.\n$$\n\n \n\n![](images/bf/bfb1ce1e2aba3efe901251ad40f84fda062e8324c4dd7a1f2888081724679842.png)\n\nAlso, notice that $∠FBE$  and $∠BFC$ are alternate interior angles formed when the transversal $\\overset{↔}{BF}$ cuts the parallel lines $\\overset{↔}{AB}$ and $\\overset{↔}{CF}.$ Hence, \n\n$$\nm∠BFC=m∠FBE={139}^{∘}.\n$$\n\nNow, using the angle addition postulate, we can find $∠AFB:$\n\n$$\n\\begin{aligned}m∠AFB & =m∠BFC-m∠AFC \\\\  & ={139}^{∘}-{71}^{∘} \\\\  & ={68}^{∘}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186190996 :answer-field/correct "answer-07dd7dbb-1d31-58ac-93ec-fcfc332956fe" :answer-field/choices ["answer-375400ff-c52d-5bbf-907d-e17f2006ada1" "answer-823a6e7f-c033-5efb-8a44-adace0500a45" "answer-07dd7dbb-1d31-58ac-93ec-fcfc332956fe" "answer-1e757923-be14-5077-9aa9-a10fe8134a56" "answer-d56434a5-ddf0-597d-be37-b19db9d7ca53"] :db/ensure [:answer-field/validate]} {:db/id "answer-375400ff-c52d-5bbf-907d-e17f2006ada1" :answer/id #uuid "375400ff-c52d-5bbf-907d-e17f2006ada1" :answer/type :answer.type/math :answer/value "{65}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-823a6e7f-c033-5efb-8a44-adace0500a45" :answer/id #uuid "823a6e7f-c033-5efb-8a44-adace0500a45" :answer/type :answer.type/math :answer/value "{66}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-07dd7dbb-1d31-58ac-93ec-fcfc332956fe" :answer/id #uuid "07dd7dbb-1d31-58ac-93ec-fcfc332956fe" :answer/type :answer.type/math :answer/value "{68}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-1e757923-be14-5077-9aa9-a10fe8134a56" :answer/id #uuid "1e757923-be14-5077-9aa9-a10fe8134a56" :answer/type :answer.type/math :answer/value "{71}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-d56434a5-ddf0-597d-be37-b19db9d7ca53" :answer/id #uuid "d56434a5-ddf0-597d-be37-b19db9d7ca53" :answer/type :answer.type/math :answer/value "{75}^{∘}" :db/ensure [:answer/validate]} {:db/id "activity-2a28b0f1-59c1-594d-9877-8a7f572f0bb8" :activity/id #uuid "2a28b0f1-59c1-594d-9877-8a7f572f0bb8" :activity/title "Alternate Angles" :activity/type :activity.type/review :activity/scope 17592186049376 :activity/course 17592186046647 :activity/steps ["step-09fb06eb-701d-5463-91d5-97d3fc405eb0" "step-a30153b6-a2a1-51a8-96d6-00e1d3c2b000" "step-f5e8c6b0-7a6b-5451-bf18-97985e726974"] :activity/first-step "step-09fb06eb-701d-5463-91d5-97d3fc405eb0" :db/ensure [:activity/validate]} {:db/id "step-09fb06eb-701d-5463-91d5-97d3fc405eb0" :step/id #uuid "09fb06eb-701d-5463-91d5-97d3fc405eb0" :step/content "question-629276db-5577-5de0-b4ed-4cb541d19524" :step/next "step-a30153b6-a2a1-51a8-96d6-00e1d3c2b000" :db/ensure [:step/validate]} {:db/id "step-a30153b6-a2a1-51a8-96d6-00e1d3c2b000" :step/id #uuid "a30153b6-a2a1-51a8-96d6-00e1d3c2b000" :step/content "question-cc803095-076a-5b93-b2c7-da97793184ac" :step/next "step-f5e8c6b0-7a6b-5451-bf18-97985e726974" :db/ensure [:step/validate]} {:db/id "step-f5e8c6b0-7a6b-5451-bf18-97985e726974" :step/id #uuid "f5e8c6b0-7a6b-5451-bf18-97985e726974" :step/content 17592186193185 :db/ensure [:step/validate]} {:db/id 17592186073714 :knowledge-point/questions ["question-f548e29c-4fb0-5de0-8aa0-2659faa5a2eb" "question-1a0af22d-5fcd-5a62-b138-4a5969bb9fc8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f548e29c-4fb0-5de0-8aa0-2659faa5a2eb" :question/id #uuid "f548e29c-4fb0-5de0-8aa0-2659faa5a2eb" :question/math-academy-id "q-73720" :question/problem "Find the midpoint of the line segment with endpoints $(-w,7z)$ and $(5w,-3z).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(-w,7z)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(5w,-3z)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-w+5w}{2},\\frac{7z+(-3z)}{2}) \\\\  & =(\\frac{-w+5w}{2},\\frac{7z-3z}{2}) \\\\  & =(\\frac{4w}{2},\\frac{4z}{2}) \\\\  & =(2w,2z).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-87c637ca-477b-51e8-ad73-42e7989eff3f"] :db/ensure [:question/validate]} {:db/id "answer-field-87c637ca-477b-51e8-ad73-42e7989eff3f" :answer-field/id #uuid "87c637ca-477b-51e8-ad73-42e7989eff3f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1707b2e5-7f13-581b-928d-cb954858885d" :answer-field/choices ["answer-2c117928-80a8-595c-9b86-d8c72d7f0afb" "answer-00b86450-d396-50c2-b792-96eb2e069dee" "answer-c0661565-ff3d-5e5e-b035-22e247858f0b" "answer-1707b2e5-7f13-581b-928d-cb954858885d" "answer-2295ae60-1e26-5128-8f27-466b06ffd6c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c117928-80a8-595c-9b86-d8c72d7f0afb" :answer/id #uuid "2c117928-80a8-595c-9b86-d8c72d7f0afb" :answer/type :answer.type/math :answer/value "(-2w,-2z)" :db/ensure [:answer/validate]} {:db/id "answer-00b86450-d396-50c2-b792-96eb2e069dee" :answer/id #uuid "00b86450-d396-50c2-b792-96eb2e069dee" :answer/type :answer.type/math :answer/value "(-w,-z)" :db/ensure [:answer/validate]} {:db/id "answer-c0661565-ff3d-5e5e-b035-22e247858f0b" :answer/id #uuid "c0661565-ff3d-5e5e-b035-22e247858f0b" :answer/type :answer.type/math :answer/value "(-w,2z)" :db/ensure [:answer/validate]} {:db/id "answer-1707b2e5-7f13-581b-928d-cb954858885d" :answer/id #uuid "1707b2e5-7f13-581b-928d-cb954858885d" :answer/type :answer.type/math :answer/value "(2w,2z)" :db/ensure [:answer/validate]} {:db/id "answer-2295ae60-1e26-5128-8f27-466b06ffd6c1" :answer/id #uuid "2295ae60-1e26-5128-8f27-466b06ffd6c1" :answer/type :answer.type/math :answer/value "(2w,3z)" :db/ensure [:answer/validate]} {:db/id "question-1a0af22d-5fcd-5a62-b138-4a5969bb9fc8" :question/id #uuid "1a0af22d-5fcd-5a62-b138-4a5969bb9fc8" :question/math-academy-id "q-73730" :question/problem "Find the midpoint of the line segment with endpoints $(8p,-q)$ and $(-2p,-9q).$" :question/worked-solution "Let $({x}_{m},{y}_{m})$ be the midpoint between ${{(8p,-q)}_{⏟}}_{\\text{(}{x}_{1}\\text{,}\\,{y}_{1})}$ and ${{(-2p,-9q)}_{⏟}}_{\\text{(}{x}_{2}\\text{,}\\,{y}_{2})}.$\n\nWe use the midpoint formula as follows:\n\n$$\n\\begin{aligned}({x}_{m},{y}_{m}) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{8p+(-2p)}{2},\\frac{-q+(-9q)}{2}) \\\\  & =(\\frac{8p-2p}{2},\\frac{-q-9q}{2}) \\\\  & =(\\frac{6p}{2},\\frac{-10q}{2}) \\\\  & =(3p,-5q).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-47c69590-b35f-5b4e-b1cf-478ea7e99763"] :db/ensure [:question/validate]} {:db/id "answer-field-47c69590-b35f-5b4e-b1cf-478ea7e99763" :answer-field/id #uuid "47c69590-b35f-5b4e-b1cf-478ea7e99763" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b2dfc1f4-7244-51d1-b08e-beaf085cffe1" :answer-field/choices ["answer-2248598d-8d45-5b33-a1bb-161e7e022f16" "answer-13df7405-37a9-5376-a794-b50ade14b257" "answer-b2dfc1f4-7244-51d1-b08e-beaf085cffe1" "answer-cd30a56d-8702-5fad-b81c-b55db3829574" "answer-41743567-93b3-52b5-956f-5e3cf584ae66"] :db/ensure [:answer-field/validate]} {:db/id "answer-2248598d-8d45-5b33-a1bb-161e7e022f16" :answer/id #uuid "2248598d-8d45-5b33-a1bb-161e7e022f16" :answer/type :answer.type/math :answer/value "(2p,-4q)" :db/ensure [:answer/validate]} {:db/id "answer-13df7405-37a9-5376-a794-b50ade14b257" :answer/id #uuid "13df7405-37a9-5376-a794-b50ade14b257" :answer/type :answer.type/math :answer/value "(2p,-5q)" :db/ensure [:answer/validate]} {:db/id "answer-b2dfc1f4-7244-51d1-b08e-beaf085cffe1" :answer/id #uuid "b2dfc1f4-7244-51d1-b08e-beaf085cffe1" :answer/type :answer.type/math :answer/value "(3p,-5q)" :db/ensure [:answer/validate]} {:db/id "answer-cd30a56d-8702-5fad-b81c-b55db3829574" :answer/id #uuid "cd30a56d-8702-5fad-b81c-b55db3829574" :answer/type :answer.type/math :answer/value "(4p,-2q)" :db/ensure [:answer/validate]} {:db/id "answer-41743567-93b3-52b5-956f-5e3cf584a