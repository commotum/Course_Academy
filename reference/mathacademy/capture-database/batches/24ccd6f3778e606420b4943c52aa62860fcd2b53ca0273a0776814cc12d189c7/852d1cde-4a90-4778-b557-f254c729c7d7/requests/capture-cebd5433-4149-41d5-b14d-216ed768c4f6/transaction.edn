-817c-73b31f6cb117" :step/id #uuid "3021eda6-e3b8-5219-817c-73b31f6cb117" :step/content "question-3619ef06-3622-5375-8459-4e89f07dd7d1" :step/next "step-5c114556-2f90-598a-a61e-2e9035fcc22d" :db/ensure [:step/validate]} {:db/id "step-5c114556-2f90-598a-a61e-2e9035fcc22d" :step/id #uuid "5c114556-2f90-598a-a61e-2e9035fcc22d" :step/content "question-9663f7f5-26ed-525b-a4e7-8ebcf7b4896a" :db/ensure [:step/validate]} {:db/id 17592186166811 :knowledge-point/questions ["question-196ecf31-b7aa-5c38-b760-a54c4f34d305" "question-ff24eb5c-4023-53e8-863a-4c063695bc62" "question-0af3be74-c5b3-5ec8-af78-1603fe65ae67" "question-fab073b9-61b0-51f3-a69e-3645145ce1fa" "question-0325034f-c697-5e84-82d0-1d5908709799"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166649 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\csch (-9).$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\csch x$ is \n\n$$\n\\csch x = \\dfrac{1}{\\sinh x} = \\dfrac {2}{e^{x} - e^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\csch (-9) =\\dfrac{2}{e^{-9}-e^{-(-9)}}=\\dfrac{2}{e^{-9}-e^{9}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186166810 :knowledge-point/questions ["question-bc92dd53-1396-50af-a160-bf5a5b938587" "question-aa7fb149-1626-56db-aafd-3693bf4f703f" "question-558ac263-8cd5-56f3-9f79-c76511bfad24" "question-a717dc62-f0d0-579e-9ded-2923a5f96442" "question-221afffc-6058-53ae-8f4b-ca54ee801c93"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166648 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\sech  \\left( -t \\right).$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\sech{x}$ is\n\n$$\n\\sech{x} = \\dfrac{1}{\\cosh x} = \\dfrac{2}{e^{x}+e^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sech}⁡(-t) & =\\frac{2}{{e}^{-t}+{e}^{-(-t)}} \\\\  & =\\frac{2}{{e}^{-t}+{e}^{t}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166812 :knowledge-point/questions ["question-f714102a-964b-532c-b041-8149ac6f2160" "question-a8d94db5-30b8-5d58-91bd-e8bbc8dd17c5" "question-9460a409-51fa-5175-bdf4-3dbd6c50a02e" "question-3203ea85-5b81-5f7d-8926-d8feaf4a8223"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166650 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nEvaluate $\\coth  (-\\ln 3).$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe definition of $\\coth x$ is \n\n$$\n\\begin{aligned}\\operatorname{coth}⁡x & =\\frac{1}{\\operatorname{tanh}⁡x} \\\\  & =\\frac{{e}^{x}+{e}^{-x}}{{e}^{x}-{e}^{-x}} \\\\  & =\\frac{{e}^{2x}+1}{{e}^{2x}-1} \\\\  & =\\frac{1+{e}^{-2x}}{1-{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the fourth definition, we get\n\n$$\n\\begin{aligned}\\operatorname{coth}⁡(-\\operatorname{ln}⁡3) & =\\frac{1+{e}^{-2(-\\operatorname{ln}⁡3)}}{1-{e}^{-2(-\\operatorname{ln}⁡3)}} \\\\  & =\\frac{1+{e}^{2\\operatorname{ln}⁡3}}{1-{e}^{2\\operatorname{ln}⁡3}} \\\\  & =\\frac{1+{e}^{\\operatorname{ln}⁡{3}^{2}}}{1-{e}^{\\operatorname{ln}⁡{3}^{2}}} \\\\  & =\\frac{1+{3}^{2}}{1-{3}^{2}} \\\\  & =\\frac{1+9}{1-9} \\\\  & =\\frac{10}{(-8)} \\\\  & =-\\frac{5}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-196ecf31-b7aa-5c38-b760-a54c4f34d305" :question/id #uuid "196ecf31-b7aa-5c38-b760-a54c4f34d305" :question/math-academy-id "q-96531" :question/problem "$$\n\n$\\operatorname{csch}⁡(-2\\operatorname{ln}⁡2)=$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-2\\operatorname{ln}⁡2) & =\\frac{2}{{e}^{-2\\operatorname{ln}⁡2}-{e}^{-(-2\\operatorname{ln}⁡2)}} \\\\  & =\\frac{2}{{e}^{-2\\operatorname{ln}⁡2}-{e}^{2\\operatorname{ln}⁡2}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡{2}^{-2}}-{e}^{\\operatorname{ln}⁡{2}^{2}}} \\\\  & =\\frac{2}{{2}^{-2}-{2}^{2}} \\\\  & =\\frac{2}{(\\frac{1}{4}-4)} \\\\  & =\\frac{2}{(-\\frac{15}{4})} \\\\  & =-\\frac{8}{15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-273b91a1-bbe7-504f-a91e-d8be18aa8ef2"] :db/ensure [:question/validate]} {:db/id "answer-field-273b91a1-bbe7-504f-a91e-d8be18aa8ef2" :answer-field/id #uuid "273b91a1-bbe7-504f-a91e-d8be18aa8ef2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-978426ac-e8fc-5307-a926-b42029a81429" :answer-field/choices ["answer-1fed9afb-d84e-5a5c-9427-67c85f80b53f" "answer-978426ac-e8fc-5307-a926-b42029a81429" "answer-c2fb5695-2b16-5a62-9ddc-880edd81d5c3" "answer-bcbb33a9-826e-5e2e-b378-e4b369c0ac56" "answer-6ac49a99-6c9e-556a-a07b-1d7dbcc6149f"] :db/ensure [:answer-field/validate]} {:db/id "answer-1fed9afb-d84e-5a5c-9427-67c85f80b53f" :answer/id #uuid "1fed9afb-d84e-5a5c-9427-67c85f80b53f" :answer/type :answer.type/math :answer/value "-\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "answer-978426ac-e8fc-5307-a926-b42029a81429" :answer/id #uuid "978426ac-e8fc-5307-a926-b42029a81429" :answer/type :answer.type/math :answer/value "-\\frac{8}{15}" :db/ensure [:answer/validate]} {:db/id "answer-c2fb5695-2b16-5a62-9ddc-880edd81d5c3" :answer/id #uuid "c2fb5695-2b16-5a62-9ddc-880edd81d5c3" :answer/type :answer.type/math :answer/value "\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bcbb33a9-826e-5e2e-b378-e4b369c0ac56" :answer/id #uuid "bcbb33a9-826e-5e2e-b378-e4b369c0ac56" :answer/type :answer.type/math :answer/value "\\frac{8}{15}" :db/ensure [:answer/validate]} {:db/id "answer-6ac49a99-6c9e-556a-a07b-1d7dbcc6149f" :answer/id #uuid "6ac49a99-6c9e-556a-a07b-1d7dbcc6149f" :answer/type :answer.type/math :answer/value "\\frac{8}{17}" :db/ensure [:answer/validate]} {:db/id "question-ff24eb5c-4023-53e8-863a-4c063695bc62" :question/id #uuid "ff24eb5c-4023-53e8-863a-4c063695bc62" :question/math-academy-id "q-340819" :question/problem "$$\nEvaluate $\\operatorname{csch}⁡(-\\operatorname{ln}⁡\\sqrt{5}).$ **Do not round** your answer.\n\n$$\n$\\operatorname{csch}⁡(-\\operatorname{ln}⁡\\sqrt{5})=$\n{{field-1}}" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-\\operatorname{ln}⁡\\sqrt{5}) & =\\frac{2}{{e}^{-\\operatorname{ln}⁡\\sqrt{5}}-{e}^{-(-\\operatorname{ln}⁡\\sqrt{5})}} \\\\  & =\\frac{2}{{e}^{-\\operatorname{ln}⁡\\sqrt{5}}-{e}^{\\operatorname{ln}⁡\\sqrt{5}}} \\\\  & =\\frac{2}{{e}^{\\operatorname{ln}⁡{(\\sqrt{5})}^{-1}}-{e}^{\\operatorname{ln}⁡\\sqrt{5}}} \\\\  & =\\frac{2}{(\\frac{1}{\\sqrt{5}}-\\sqrt{5})} \\\\  & =\\frac{2}{(\\frac{1-5}{\\sqrt{5}})} \\\\  & =\\frac{2}{(-\\frac{4}{\\sqrt{5}})} \\\\  & =2\\times (-\\frac{\\sqrt{5}}{4}) \\\\  & =-\\frac{\\sqrt{5}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-53b6dda4-c668-5dd7-ba0c-f66c9657a070"] :db/ensure [:question/validate]} {:db/id "answer-field-53b6dda4-c668-5dd7-ba0c-f66c9657a070" :answer-field/id #uuid "53b6dda4-c668-5dd7-ba0c-f66c9657a070" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2f84a058-98da-5a43-85a6-c9443bc774a5" :answer-field/choices ["answer-2f84a058-98da-5a43-85a6-c9443bc774a5"] :db/ensure [:answer-field/validate]} {:db/id "answer-2f84a058-98da-5a43-85a6-c9443bc774a5" :answer/id #uuid "2f84a058-98da-5a43-85a6-c9443bc774a5" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{5}}{2}" :db/ensure [:answer/validate]} {:db/id "question-0af3be74-c5b3-5ec8-af78-1603fe65ae67" :question/id #uuid "0af3be74-c5b3-5ec8-af78-1603fe65ae67" :question/math-academy-id "q-125697" :question/problem "$$\n\nGiven that $t\\ne 0,$ which of the following is equivalent to $\\operatorname{csch}⁡(\\sqrt{7}\\,t)?$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{csch}⁡(\\sqrt{7}\\,t)=\\frac{2}{{e}^{\\sqrt{7}\\,t}-{e}^{-\\sqrt{7}\\,t}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7d773b97-3525-57be-a57f-ceea3ffecda1"] :db/ensure [:question/validate]} {:db/id "answer-field-7d773b97-3525-57be-a57f-ceea3ffecda1" :answer-field/id #uuid "7d773b97-3525-57be-a57f-ceea3ffecda1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-51c3df0e-f346-58f8-a1a7-e2f348dc3a7d" :answer-field/choices ["answer-ee9d8b4f-f902-5aa7-9fd9-c20bea2a594d" "answer-efeddf4f-a4bb-59b8-be1d-5e20bb9b7d50" "answer-ec243bc5-3d7b-52fd-ab4b-73c0c6a79dac" "answer-a756acf0-aa6d-52e6-88e8-2d4bcfb72051" "answer-51c3df0e-f346-58f8-a1a7-e2f348dc3a7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ee9d8b4f-f902-5aa7-9fd9-c20bea2a594d" :answer/id #uuid "ee9d8b4f-f902-5aa7-9fd9-c20bea2a594d" :answer/type :answer.type/math :answer/value "\\frac{2}{{e}^{-\\sqrt{7}\\,t}-{e}^{\\sqrt{7}\\,t}}" :db/ensure [:answer/validate]} {:db/id "answer-efeddf4f-a4bb-59b8-be1d-5e20bb9b7d50" :answer/id #uuid "efeddf4f-a4bb-59b8-be1d-5e20bb9b7d50" :answer/type :answer.type/math :answer/value "\\frac{2}{{e}^{7t}+{e}^{-7t}}" :db/ensure [:answer/validate]} {:db/id "answer-ec243bc5-3d7b-52fd-ab4b-73c0c6a79dac" :answer/id #uuid "ec243bc5-3d7b-52fd-ab4b-73c0c6a79dac" :answer/type :answer.type/math :answer/value "\\frac{2}{{e}^{7t}-{e}^{-7t}}" :db/ensure [:answer/validate]} {:db/id "answer-a756acf0-aa6d-52e6-88e8-2d4bcfb72051" :answer/id #uuid "a756acf0-aa6d-52e6-88e8-2d4bcfb72051" :answer/type :answer.type/math :answer/value "\\frac{2}{{e}^{\\sqrt{7}\\,t}+{e}^{-\\sqrt{7}\\,t}}" :db/ensure [:answer/validate]} {:db/id "answer-51c3df0e-f346-58f8-a1a7-e2f348dc3a7d" :answer/id #uuid "51c3df0e-f346-58f8-a1a7-e2f348dc3a7d" :answer/type :answer.type/math :answer/value "\\frac{2}{{e}^{\\sqrt{7}\\,t}-{e}^{-\\sqrt{7}\\,t}}" :db/ensure [:answer/validate]} {:db/id "question-fab073b9-61b0-51f3-a69e-3645145ce1fa" :question/id #uuid "fab073b9-61b0-51f3-a69e-3645145ce1fa" :question/math-academy-id "q-125696" :question/problem "$$\n\n$\\operatorname{csch}⁡(-\\sqrt{3})=$" :question/worked-solution "$$\n\nThe definition of $\\operatorname{csch}⁡x$ is \n\n$$\n\\operatorname{csch}⁡x=\\frac{1}{\\operatorname{sinh}⁡x}=\\frac{2}{{e}^{x}-{e}^{-x}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csch}⁡(-\\sqrt{3}) & =\\frac{2}{{e}^{-\\sqrt{3}}-{e}^{-(-\\sqrt{3})}} \\\\  & =\\frac{2}{{e}^{-\\sqrt{3}}-{e}^{\\sqrt{3}}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-375a804b-87fc-5142-975b-318473d44915"] :db/ensure [:question/validate]} {:db/id "answer-field-375a804b-87fc-5142-975b-318473d44915" :answer-field/id #uuid "375a804b-87fc-5142-975b-318473d44915" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fc2e0dae-54b9-5461-9300-18d71043228a" :answer-field/choices ["answer-fc2e0dae-54b9-5461-9300-18d710