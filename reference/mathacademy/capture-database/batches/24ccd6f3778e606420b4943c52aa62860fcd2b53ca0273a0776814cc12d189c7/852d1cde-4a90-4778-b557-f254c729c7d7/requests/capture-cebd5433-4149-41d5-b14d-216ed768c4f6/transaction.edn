wer/value "d-9e-2f" :db/ensure [:answer/validate]} {:db/id "question-b8beba6a-7b91-5602-93f9-62eba4e754b8" :question/id #uuid "b8beba6a-7b91-5602-93f9-62eba4e754b8" :question/math-academy-id "q-2596" :question/problem "Which of the following is equivalent to $\\frac{4a-6b}{4}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in the individual terms, we get\n\n$$\n\\begin{aligned}\\frac{4a-6b}{4} & = \\\\ \\frac{4a}{4}-\\frac{6b}{4} & = \\\\ \\frac{4}{4}\\cdot a-\\frac{6}{4}\\cdot b & = \\\\ a-\\frac{3}{2}\\cdot b & = \\\\ a-\\frac{3b}{2} & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a56dfd75-69de-5099-a23d-5bcbe223963a"] :db/ensure [:question/validate]} {:db/id "answer-field-a56dfd75-69de-5099-a23d-5bcbe223963a" :answer-field/id #uuid "a56dfd75-69de-5099-a23d-5bcbe223963a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer-field/choices ["answer-b3b993a8-041c-5f04-b5e8-b517b901f0ff" "answer-6a973a8f-68d4-5f16-b9b5-43302aeb1566" "answer-2b6d12dd-a924-575c-bf78-e849044273ab" "answer-233176ce-70f9-5e6d-87d1-a9ee42aee061" "answer-98adbab9-1df8-5350-9e28-7f78e7ab5f5f"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3b993a8-041c-5f04-b5e8-b517b901f0ff" :answer/id #uuid "b3b993a8-041c-5f04-b5e8-b517b901f0ff" :answer/type :answer.type/math :answer/value "1-\\frac{3b}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6a973a8f-68d4-5f16-b9b5-43302aeb1566" :answer/id #uuid "6a973a8f-68d4-5f16-b9b5-43302aeb1566" :answer/type :answer.type/math :answer/value "4a-\\frac{3b}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2b6d12dd-a924-575c-bf78-e849044273ab" :answer/id #uuid "2b6d12dd-a924-575c-bf78-e849044273ab" :answer/type :answer.type/math :answer/value "a-4" :db/ensure [:answer/validate]} {:db/id "answer-233176ce-70f9-5e6d-87d1-a9ee42aee061" :answer/id #uuid "233176ce-70f9-5e6d-87d1-a9ee42aee061" :answer/type :answer.type/math :answer/value "a-6b" :db/ensure [:answer/validate]} {:db/id "answer-98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer/id #uuid "98adbab9-1df8-5350-9e28-7f78e7ab5f5f" :answer/type :answer.type/math :answer/value "a-\\frac{3b}{2}" :db/ensure [:answer/validate]} {:db/id "question-18e51362-5c55-557f-b76e-006c8ec5e5f2" :question/id #uuid "18e51362-5c55-557f-b76e-006c8ec5e5f2" :question/math-academy-id "q-103607" :question/problem "Which of the following is equivalent to $\\frac{12-3y}{6}?$" :question/worked-solution "Splitting the fraction into separate terms and then simplifying the fractions in individual terms, we get\n\n$$\n\\begin{aligned}\\frac{12-3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3y}{6} & = \\\\ \\frac{12}{6}-\\frac{3}{6}\\cdot y & = \\\\ 2-\\frac{1}{2}\\cdot y & = \\\\ 2-\\frac{y}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-abc45ee2-9c31-50c1-96af-d62cdd130b8d"] :db/ensure [:question/validate]} {:db/id "answer-field-abc45ee2-9c31-50c1-96af-d62cdd130b8d" :answer-field/id #uuid "abc45ee2-9c31-50c1-96af-d62cdd130b8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c6076542-ac8d-521b-91c3-c0f173f61489" :answer-field/choices ["answer-c6076542-ac8d-521b-91c3-c0f173f61489" "answer-db0641d9-8d65-5bc9-86fa-3e03187c823e" "answer-320dbf36-2cfb-59da-86bb-c1a4774c9420" "answer-c52cd410-949a-5ecc-9db0-e370a7d7839c" "answer-19980522-9bdd-55a7-8d9d-8828e76405ba"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6076542-ac8d-521b-91c3-c0f173f61489" :answer/id #uuid "c6076542-ac8d-521b-91c3-c0f173f61489" :answer/type :answer.type/math :answer/value "2-\\frac{y}{2}" :db/ensure [:answer/validate]} {:db/id "answer-db0641d9-8d65-5bc9-86fa-3e03187c823e" :answer/id #uuid "db0641d9-8d65-5bc9-86fa-3e03187c823e" :answer/type :answer.type/math :answer/value "2-y" :db/ensure [:answer/valida