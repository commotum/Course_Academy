stion/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3235286d-76ea-568e-a9be-0249cc7ffbea"] :db/ensure [:question/validate]} {:db/id "answer-field-3235286d-76ea-568e-a9be-0249cc7ffbea" :answer-field/id #uuid "3235286d-76ea-568e-a9be-0249cc7ffbea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" :answer-field/choices ["answer-f606c8f4-0164-5bb8-968e-6ee4d224953a" "answer-e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" "answer-f88ff125-ed18-5a84-bda5-936ae6d644fa" "answer-b85887ad-503b-5a31-9a5f-ed5afa3bbe07" "answer-1e651fca-df91-5a95-892f-780cef22a6df"] :db/ensure [:answer-field/validate]} {:db/id "answer-f606c8f4-0164-5bb8-968e-6ee4d224953a" :answer/id #uuid "f606c8f4-0164-5bb8-968e-6ee4d224953a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" :answer/id #uuid "e97b3397-a0ac-5681-a4c2-e3b524dbb8eb" :answer/type :answer.type/math :answer/value "-\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "answer-f88ff125-ed18-5a84-bda5-936ae6d644fa" :answer/id #uuid "f88ff125-ed18-5a84-bda5-936ae6d644fa" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-b85887ad-503b-5a31-9a5f-ed5afa3bbe07" :answer/id #uuid "b85887ad-503b-5a31-9a5f-ed5afa3bbe07" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-1e651fca-df91-5a95-892f-780cef22a6df" :answer/id #uuid "1e651fca-df91-5a95-892f-780cef22a6df" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "question-e03bdc50-8826-55ed-961a-7b04fba13b73" :question/id #uuid "e03bdc50-8826-55ed-961a-7b04fba13b73" :question/math-academy-id "q-43064" :question/problem "Find $det({A}^{-1}),$ if $A=[\\begin{aligned}5 & 1 \\\\ -2 & 4\\end{aligned}].$" :question/worked-solution "Given an invertible $n\\times n$ matrix $A,$ we have\n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}.\n$$\n\nFirst, we find $det(A):$\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}5 & 1 \\\\ -2 & 4\\end{aligned}] \\\\  & =20+2 \\\\  & =22\\end{aligned}\n$$\n\nTherefore, we obtain \n\n$$\ndet({A}^{-1})=\\frac{1}{det(A)}=\\frac{1}{22}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e2f9929b-cbb7-535e-88cc-fde1a1ddedec"] :db/ensure [:question/validate]} {:db/id "answer-field-e2f9929b-cbb7-535e-88cc-fde1a1ddedec" :answer-field/id #uuid "e2f9929b-cbb7-535e-88cc-fde1a1ddedec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18c8e0eb-b4ed-5750-97d5-7df316c93a28" :answer-field/choices ["answer-ccf68bac-d6a7-5572-952f-aca8d66f7daf" "answer-bb8b9732-250a-5c1f-8b41-8e1659261954" "answer-5109da14-c4b1-5d66-8b72-c7c4fe59acde" "answer-18c8e0eb-b4ed-5750-97d5-7df316c93a28" "answer-8e41c8c1-320c-5148-80c5-566550b07342"] :db/ensure [:answer-field/validate]} {:db/id "answer-ccf68bac-d6a7-5572-952f-aca8d66f7daf" :answer/id #uuid "ccf68bac-d6a7-5572-952f-aca8d66f7daf" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-bb8b9732-250a-5c1f-8b41-8e1659261954" :answer/id #uuid "bb8b9732-250a-5c1f-8b41-8e1659261954" :answer/type :answer.type/math :answer/value "\\frac{1}{11}" :db/ensure [:answer/validate]} {:db/id "answer-5109da14-c4b1-5d66-8b72-c7c4fe59acde" :answer/id #uuid "5109da14-c4b1-5d66-8b72-c7c4fe59acde" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-18c8e0eb-b4ed-5750-97d5-7df316c93a28" :answer/id #uuid "18c8e0eb-b4ed-5750-97d5-7df316c93a28" :answer/type :answer.type/math :answer/value "\\frac{1}{22}" :db/ensure [:answer/validate]} {:db/id "answer-8e41c8c1-320c-5148-80c5-566550b07342" :answer/id #uuid "8e41c8c1-320c-5148-80c5-566550b07342" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id 17592186119780 :knowledge-point/questions ["question-e3cff1af-b64e-5d5d-98b9-281348f5cad1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e3cff1af-b64e-5d5d-98b9-281348f5cad1" :question/id #uuid "e3cff1af-b64e-5d5d-98b9-281348f5cad1" :question/math-academy-id "q-130697" :question/problem "Given that \n$|\\begin{aligned}a+5 & 5 \\\\ b & -3\\end{aligned}|=-34$,\nfind \n$|\\begin{aligned}a+4 & 5 \\\\ b+2 & -3\\end{aligned}|.$" :question/worked-solution "We \"factor out\" the given determinant from the determinant we would like to find:\n\n$$\n\\begin{aligned}|\\begin{aligned}a+4 & 5 \\\\ b+2 & -3\\end{aligned}| & =|\\begin{aligned}(a+5)-1 & 5 \\\\ b+2 & -3\\end{aligned}|\\end{aligned}\n$$\n\nNow, using the linearity property of determinants, we obtain\n\n$$\n\\begin{aligned}|\\begin{aligned}(a+5)-1 & 5 \\\\ b+2 & -3\\end{aligned}| & ={{|\\begin{aligned}a+5 & 5 \\\\ b & -3\\end{aligned}|}_{⏟}}_{-34}+|\\begin{aligned}-1 & 5 \\\\ 2 & -3\\end{aligned}| \\\\  & =-34+(3-10) \\\\  & =-41.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c336fca6-9149-5cbc-a19d-a2bfb6cf6d63"] :db/ensure [:question/validate]} {:db/id "answer-field-c336fca6-9149-5cbc-a19d-a2bfb6cf6d63" :answer-field/id #uuid "c336fca6-9149-5cbc-a19d-a2bfb6cf6d63" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1535aac7-a580-50c9-bb4b-02062ef10430" :answer-field/choices ["answer-30b9adea-211f-53a0-9e3a-0b6f4d8b955e" "answer-1535aac7-a580-50c9-bb4b-02062ef10430" "answer-a12728ba-7099-5bf8-8866-47c0e9602d58" "answer-a12f5c16-20dd-5336-876b-869d81a32fc6" "answer-6744b428-41a3-57bb-b1be-72c3c470befb"] :db/ensure [:answer-field/validate]} {:db/id "answer-30b9adea-211f-53a0-9e3a-0b6f4d8b955e" :answer/id #uuid "30b9adea-211f-53a0-9e3a-0b6f4d8b955e" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "answer-1535aac7-a580-50c9-b