me{tanh}⁡x) \\\\  & =-14\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) \\\\  & =-14{sech}^{2}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105400 :answer-field/correct "answer-6afe7590-983c-5055-b634-f23668b4479a" :answer-field/choices ["answer-dcca89ce-1c2a-5f4f-9e58-06422a45ac17" "answer-eee61a84-48b6-5de9-a0ee-843724a5c034" "answer-6afe7590-983c-5055-b634-f23668b4479a" "answer-bdf14151-de92-5027-9e09-b8edaa494eb4" "answer-d88597ba-10ae-5fed-83f9-8d2ffce379f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-dcca89ce-1c2a-5f4f-9e58-06422a45ac17" :answer/id #uuid "dcca89ce-1c2a-5f4f-9e58-06422a45ac17" :answer/type :answer.type/math :answer/value "-14\\operatorname{sech}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-eee61a84-48b6-5de9-a0ee-843724a5c034" :answer/id #uuid "eee61a84-48b6-5de9-a0ee-843724a5c034" :answer/type :answer.type/math :answer/value "-14{csch}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-6afe7590-983c-5055-b634-f23668b4479a" :answer/id #uuid "6afe7590-983c-5055-b634-f23668b4479a" :answer/type :answer.type/math :answer/value "-14{sech}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-bdf14151-de92-5027-9e09-b8edaa494eb4" :answer/id #uuid "bdf14151-de92-5027-9e09-b8edaa494eb4" :answer/type :answer.type/math :answer/value "14{csch}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-d88597ba-10ae-5fed-83f9-8d2ffce379f9" :answer/id #uuid "d88597ba-10ae-5fed-83f9-8d2ffce379f9" :answer/type :answer.type/math :answer/value "14{sech}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "question-49c81891-b661-5bda-b31c-54f1cc0220f3" :question/id #uuid "49c81891-b661-5bda-b31c-54f1cc0220f3" :question/math-academy-id "q-165764" :question/problem "$$\n\nFind the derivative of $f(x)={e}^{\\operatorname{tanh}⁡{x}^{2}}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf={e}^{g},\\,g=\\operatorname{tanh}⁡s,\\,s={x}^{2}\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}s}\\cdot \\frac{\\text{d}s}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}g}={e}^{g},\\,\\frac{\\text{d}g}{\\text{d}s}={sech}^{2}⁡s,\\,\\frac{\\text{d}s}{\\text{d}x}=2x.\\end{aligned}\n$$\n\nFinally, multiplying the three results together and substituting for $g$ and $s$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={e}^{g}\\cdot {sech}^{2}⁡s\\cdot 2x \\\\  & ={e}^{\\operatorname{tanh}⁡{x}^{2}}\\cdot {sech}^{2}⁡{x}^{2}\\cdot 2x \\\\  & =2x{e}^{\\operatorname{tanh}⁡{x}^{2}}{sech}^{2}⁡{x}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c1758f56-8a11-59aa-87ff-3d7393707dd8"] :db/ensure [:question/validate]} {:db/id "answer-field-c1758f56-8a11-59aa-87ff-3d7393707dd8" :answer-field/id #uuid "c1758f56-8a11-59aa-87ff-3d7393707dd8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b7343704-b6ba-5f2d-a062-42537a712dd6" :answer-field/choices ["answer-2d9d5eb0-a002-5a56-9626-9a307dc92e97" "answer-b7343704-b6ba-5f2d-a062-42537a712dd6" "answer-0d05d41c-03ea-5483-92aa-af31d2669524" "answer-8982439d-179b-56ff-9170-4b8f7f5cd5a9" "answer-cdf51d8c-9d4d-5b3e-a107-4a55357ce776"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d9d5eb0-a002-5a56-9626-9a307dc92e97" :answer/id #uuid "2d9d5eb0-a002-5a56-9626-9a307dc92e97" :answer/type :answer.type/math :answer/value "2x{e}^{\\operatorname{tanh}⁡{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-b7343704-b6ba-5f2d-a062-42537a712dd6" :answer/id #uuid "b7343704-b6ba-5f2d-a062-42537a712dd6" :answer/type :answer.type/math :answer/value "2x{e}^{\\operatorname{tanh}⁡{x}^{2}}{sech}^{2}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0d05d41c-03ea-5483-92aa-af31d2669524" :answer/id #uuid "0d05d41c-03ea-5483-92aa-af31d2669524" :answer/type :answer.type/math :answer/value "2x{e}^{\\operatorname{tanh}⁡{x}^{2}}{tanh}^{2}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8982439d-179b-56ff-9170-4b8f7f5cd5a9" :answer/id #uuid "8982439d-179b-56ff-9170-4b8f7f5cd5a9" :answer/type :answer.type/math :answer/value "{e}^{{sech}^{2}⁡{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-cdf51d8c-9d4d-5b3e-a107-4a55357ce776" :answer/id #uuid "cdf51d8c-9d4d-5b3e-a107-4a55357ce776" :answer/type :answer.type/math :answer/value "{e}^{{sech}^{2}⁡{x}^{2}}{sech}^{2}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "question-f4f3ca36-fa30-5fa4-b1a8-a0cc296aaddc" :question/id #uuid "f4f3ca36-fa30-5fa4-b1a8-a0cc296aaddc" :question/math-academy-id "q-95683" :question/problem "$$\n\nFind the derivative of $f(x)=\\frac{2}{\\operatorname{cosh}⁡x}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=\\frac{2}{g},\\,g=\\operatorname{cosh}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=-\\frac{2}{{g}^{2}},\n$$\n\nand \n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=\\operatorname{sinh}⁡x,\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{2}{{g}^{2}}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{2}{{cosh}^{2}⁡x}\\cdot \\operatorname{sinh}⁡x \\\\  & =-\\frac{2\\operatorname{sinh}⁡x}{{cosh}^{2}⁡x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-591aed53-5fc1-5718-aec4-5541a100c653"] :db/ensure [:question/validate]} {:db/id "answer-field-591aed53-5fc1-5718-aec4-5541a100c653" :answer-field/id #uuid "591aed53-5fc1-5718-aec4-5541a100c653" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-485634ed-c1d2-554e-96aa-54fcfd862af2" :answer-field/choices ["answer-191cd351-d4ff-5f52-907b-a2c3f524d64f" "answer-485634ed-c1d2-554e-96aa-54fcfd862af2" "answer-d22f6724-03d0-588c-afd0-a8fb517b5b3c" "answer-cd92acaa-1c83-560e-a425-aed5df0e16b8" "answer-1b20229e-fd53-5bb6-967d-eaca865549dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-191cd351-d4ff-5f52-907b-a2c3f524d64f" :answer/id #uuid "191cd351-d4ff-5f52-907b-a2c3f524d64f" :answer/type :answer.type/math :answer/value "-2\\operatorname{tanh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-485634ed-c1d2-554e-96aa-54fcfd862af2" :answer/id #uuid "485634ed-c1d2-554e-96aa-54fcfd862af2" :answer/type :answer.type/math :answer/value "-\\frac{2\\operatorname{sinh}⁡x}{{cosh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-d22f6724-03d0-588c-afd0-a8fb517b5b3c" :answer/id #uuid "d22f6724-03d0-588c-afd0-a8fb517b5b3c" :answer/type :answer.type/math :answer/value "-\\frac{2}{{cosh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-cd92acaa-1c83-560e-a425-aed5df0e16b8" :answer/id #uuid "cd92acaa-1c83-560e-a425-aed5df0e16b8" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{sinh}⁡x}{\\operatorname{cosh}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-1b20229e-fd53-5bb6-967d-eaca865549dc" :answer/id #uuid "1b20229e-fd53-5bb6-967d-eaca865549dc" :answer/type :answer.type/math :answer/value "\\frac{2}{\\operatorname{cosh}⁡x\\operatorname{sinh}⁡x}" :db/ensure [:answer/validate]} {:db/id 17592186106543 :question/problem "$$\n\nFind the derivative of $f(x)=4{sinh}^{3}⁡x.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=4{g}^{3},\\,g=\\operatorname{sinh}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=12{g}^{2}\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=\\operatorname{cosh}⁡x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =12{g}^{2}\\cdot \\operatorname{cosh}⁡x \\\\  & =12{sinh}^{2}⁡x\\operatorname{cosh}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105406 :answer-field/correct "answer-e0e529d4-29ad-5e2d-a3bb-7cec86152a0a" :answer-field/choices ["answer-61917980-9a7b-5ded-8bc9-fd9f14dfd212" "answer-9517511c-9bba-5b13-ac76-a5fbb5664726" "answer-c9ea6e59-85b4-5444-807e-a267c4b16631" "answer-e339479e-f7b9-56c7-8d79-9607ad1c038a" "answer-e0e529d4-29ad-5e2d-a3bb-7cec86152a0a"] :db/ensure [:answer-field/validate]} {:db/id "answer-61917980-9a7b-5ded-8bc9-fd9f14dfd212" :answer/id #uuid "61917980-9a7b-5ded-8bc9-fd9f14dfd212" :answer/type :answer.type/math :answer/value "-12{cosh}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-9517511c-9bba-5b13-ac76-a5fbb5664726" :answer/id #uuid "9517511c-9bba-5b13-ac76-a5fbb5664726" :answer/type :answer.type/math :answer/value "-12{sinh}^{2}⁡x\\operatorname{cosh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-c9ea6e59-85b4-5444-807e-a267c4b16631" :answer/id #uuid "c9ea6e59-85b4-5444-807e-a267c4b16631" :answer/type :answer.type/math :answer/value "12\\operatorname{sinh}⁡x{cosh}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-e339479e-f7b9-56c7-8d79-9607ad1c038a" :answer/id #uuid "e339479e-f7b9-56c7-8d79-9607ad1c038a" :answer/type :answer.type/math :answer/value "12{cosh}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-e0e529d4-29ad-5e2d-a3bb-7cec86152a0a" :answer/id #uuid "e0e529d4-29ad-5e2d-a3bb-7cec86152a0a" :answer/type :answer.type/math :answer/value "12{sinh}^{2}⁡x\\operatorname{cosh}⁡x" :db/ensure [:answer/validate]} {:db/id "question-7c706f9d-3f1b-52c2-a133-ccf4032fcc0e" :question/id #uuid "7c706f9d-3f1b-52c2-a133-ccf4032fcc0e" :question/math-academy-id "q-95682" :question/problem "$$\n\nFind the derivative of $f(x)=\\frac{1}{\\operatorname{sinh}⁡{x}^{3}}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=\\frac{1}{g},\\,g=\\operatorname{sinh}⁡s,\\,s={x}^{3}\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}s}\\cdot \\frac{\\text{d}s}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}g} & =-\\frac{1}{{g}^{2}},\\,\\frac{\\text{d}g}{\\text{d}s}=\\operatorname{cosh}⁡s,\\,\\frac{\\text{d}s}{\\text{d}x}=3{x}^{2}.\\end{aligned}\n$$\n\nFinally, multiplying the three results together and substituting for $g$ and $s$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{1}{{g}^{2}}\\cdot \\operatorname{cosh}⁡s\\cdot 3{x}^{2} \\\\  & =-\\frac{1}{{sinh}^{2}⁡{x}^{3}}\\cdot \\operatorname{cosh}⁡{x}^{3}\\cdot 3{x}^{2} \\\\  & =-\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{{sinh}^{2}⁡{x}^{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d1ea0ed9-861a-53c7-a186-58ae5ac5ba7e"] :db/ensure [:question/validate]} {:db/id "answer-field-d1ea0ed9-861a-53c7-a186-58ae5ac5ba7e" :answer-field/id #uuid "d1ea0ed9-861a-53c7-a186-58ae5ac5ba7e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-850b3671-0aaa-5270-8744-c50895b0849f" :answer-field/choices ["answer-ceb54f55-a1ae-5979-8460-80acb2a96a67" "answer-850b3671-0aaa-5270-8744-c50895b0849f" "answer-672925f1-f187-5823-b735-1420d87c9526" "answer-acfbff32-5d56-5f99-a479-a3fd08b6c9f6" "answer-93445aab-8702-553f-ab97-b9a3cb2200c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceb54f55-a1ae-5979-8460-80acb2a96a67" :answer/id #uuid "ceb54f55-a1ae-5979-8460-80acb2a96a67" :answer/type :answer.type/math :answer/value "-3{x}^{2}\\operatorname{coth}⁡{x}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-850b3671-0aaa-5270-8744-c50895b0849f" :answer/id #uuid "850b3671-0aaa-5270-8744-c50895b0849f" :answer/type :answer.type/math :answer/value "-\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{{sinh}^{2}⁡{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-672925f1-f187-5823-b735-1420d87c9526" :answer/id #uuid "672925f1-f187-5823-b735-1420d87c9526" :answer/type :answer.type/math :answer/value "-\\frac{3{x}^{2}}{\\operatorname{sinh}⁡{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-acfbff32-5d56-5f99-a479-a3fd08b6c9f6" :answer/id #uuid "acfbff32-5d56-5f99-a479-a3fd08b6c9f6" :answer/type :answer.type/math :answer/value "3{x}^{2}\\operatorname{tanh}⁡{x}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-93445aab-8702-553f-ab97-b9a3cb2200c1" :answer/id #uuid "93445aab-8702-553f-ab97-b9a3cb2200c1" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{2}\\operatorname{cosh}⁡{x}^{3}}{\\operatorname{sinh}⁡{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "question-443677a2-c964-52f1-8cf6-218af419b0bb" :question/id #uuid "443677a2-c964-52f1-8cf6-218af419b0bb" :question/math-academy-id "q-95679" :question/problem "$$\n\nFind the derivative of $f(x)=\\sqrt{\\operatorname{cosh}⁡x}.$" :question/worked-solution "First, we express $f(x)$ as a composite function:\n\n$$\nf=\\sqrt{g},\\,g=\\operatorname{cosh}⁡x\n$$\n\nThe chain rule states that\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}g}\\cdot \\frac{\\text{d}g}{\\text{d}x}.\n$$\n\nDifferentiating, we have\n\n$$\n\\frac{\\text{d}f}{\\text{d}g}=\\frac{1}{2\\sqrt{g}},\n$$\n\nand\n\n$$\n\\frac{\\text{d}g}{\\text{d}x}=\\operatorname{sinh}⁡x.\n$$\n\nFinally, multiplying the two results together and substituting for $g$ gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{2\\sqrt{g}}\\cdot \\operatorname{sinh}⁡x \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{cosh}⁡x}}\\cdot \\operatorname{sinh}⁡x \\\\  & =\\frac{\\operatorname{sinh}⁡x}{2\\sqrt{\\operatorname{cosh}⁡x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9cfca816-bc30-5f31-9e0a-1b5f9bda2fa4"] :db/ensure [:question/validate]} {:db/id "answer-field-9cfca816-bc30-5f31-9e0a-1b5f9bda2fa4" :answer-field/id #uuid "9cfca816-bc30-5f31-9e0a-1b5f9bda2fa4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f475adb8-5f2b-51b8-a0a6-4047f2d0ffd5" :answer-field/choices ["answer-914f56cc-4060-57bf-89d0-0a445dd0731f" "answer-341be771-60b0-5345-aa0c-7e45ecd45913" "answer-5f49f538-1253-5e21-8246-7c102f63b285" "answer-1448c9bb-c9db-5637-be5b-90691bc5ca9d" "answer-f475adb8-5f2b-51b8-a0a6-4047f2d0ffd5"] :db/ensure [:answer-field/validate]} {:db/id "answer-914f56cc-4060-57bf-89d0-0a445dd0731f" :answer/id #uuid "914f56cc-4060-57bf-89d0-0a445dd0731f" :answer/type :answer.type/math :answer/value "-\\frac{1}{2\\sqrt{\\operatorname{cosh}⁡x}}" :db/ensure [:answer/validate]} {:db/id "answer-341be771-60b0-5345-aa0c-7e45ecd45913" :answer/id #uuid "341be771-60b0-5345-aa0c-7e45ecd45913" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{sinh}⁡x}{2\\sqrt{\\operatorname{cosh}⁡x}}" :db/ensure [:answer/validate]} {:db/id "answer-5f49f538-1253-5e21-8246-7c102f63b285" :answer/id #uuid "5f49f538-1253-5e21-8246-7c102f63b285" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{\\operatorname{cosh}⁡x}}" :db/ensure [:answer/validate]} {:db/id "answer-1448c9bb-c9db-5637-be5b-90691bc5ca9d" :answer/id #uuid "1448c9bb-c9db-5637-be5b-90691bc5ca9d" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{\\operatorname{sinh}⁡x}}" :db/ensure [:answer/validate]} {:db/id "answer-f475adb8-5f2b-51b8-a0a6-4047f2d0ffd5" :answer/id #uuid "f475adb8-5f2b-51b8-a0a6-4047f2d0ffd5" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sinh}⁡x}{2\\sqrt{\\operatorname{cosh}⁡x}}" :db/ensure [:answer/validate]} {:db/id "question-5de32c1d-3413-5361-b37c-92eba300a033" :question/id #uuid "5de32c1d-3413-5361-b37c-92eba300a033" :question/math-academy-id "q-95273" :question/problem "$$\n\nFind the derivative of $f(x)=\\operatorname{ln}⁡x\\operatorname{cosh}⁡{x}^{2}.$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\operatorname{ln}⁡x$ and $v(x)=\\operatorname{cosh}⁡{x}^{2}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\operatorname{ln}⁡x)^{′}\\cdot \\operatorname{cosh}⁡{x}^{2}+\\operatorname{ln}⁡x\\cdot (\\operatorname{cosh}⁡{x}^{2})^{′} \\\\  & =\\frac{1}{x}\\cdot \\operatorname{cosh}⁡{x}^{2}+\\operatorname{ln}⁡x\\cdot 2x\\operatorname{sinh}⁡{x}^{2} \\\\  & =\\frac{\\operatorname{cosh}⁡{x}^{2}}{x}+2x\\operatorname{ln}⁡x\\operatorname{sinh}⁡{x}^{2} \\\\  & =\\frac{1}{x}(\\operatorname{cosh}⁡{x}^{2}+2{x}^{2}\\operatorname{ln}⁡x\\operatorname{sinh}⁡{x}^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2123a3dc-e920-55e9-b33f-cf225d0a613e"] :db/ensure [:question/validate]} {:db/id "answer-field-2123a3dc-e920-55e9-b33f-cf225d0a613e" :answer-field/id #uuid "2123a3dc-e920-55e9-b33f-cf225d0a613e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea584e92-fcda-51a3-9556-dc0237337ffb" :answer-field/choices ["answer-ea584e92-fcda-51a3-9556-dc0237337ffb" "answer-33f18d0e-672d-55d5-929d-96f39df6363e" "answer-b6b665fd-cf22-58e0-9bb0-895a93be8e31" "answer-86d3ef02-0153-55b2-8be6-0d0c5fc622a9" "answer-335091e9-2f76-5644-9871-ff99b44332cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea584e92-fcda-51a3-9556-dc0237337ffb" :answer/id #uuid "ea584e92-fcda-51a3-9556-dc0237337ffb" :answer/type :answer.type/math :answer/value "\\frac{1}{x}(\\operatorname{cosh}⁡{x}^{2}+2{x}^{2}\\operatorname{ln}⁡x\\operatorname{sinh}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-33f18d0e-672d-55d5-929d-96f39df6363e" :answer/id #uuid "33f18d0e-672d-55d5-929d-96f39df6363e" :answer/type :answer.type/math :answer/value "\\frac{1}{x}(\\operatorname{cosh}⁡{x}^{2}+2{x}^{2}\\operatorname{sinh}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-b6b665fd-cf22-58e0-9bb0-895a93be8e31" :answer/id #uuid "b6b665fd-cf22-58e0-9bb0-895a93be8e31" :answer/type :answer.type/math :answer/value "\\frac{1}{x}(\\operatorname{cosh}⁡{x}^{2}-2\\operatorname{ln}⁡x\\operatorname{sinh}⁡{x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-86d3ef02-0153-55b2-8be6-0d0c5fc622a9" :answer/id #uuid "86d3ef02-0153-55b2-8be6-0d0c5fc622a9" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡{x}^{2}+2x\\operatorname{ln}⁡x\\operatorname{sinh}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-335091e9-2f76-5644-9871-ff99b44332cc" :answer/id #uuid "335091e9-2f76-5644-9871-ff99b44332cc" :answer/type :answer.type/math :answer/value "\\operatorname{cosh}⁡{x}^{2}-2\\operatorname{ln}⁡x\\operatorname{sinh}⁡{x}^{2}" :db/ensure [:answer/validate]} {:db/id "question-5d5258aa-0eff-5685-bbfc-832665398ac8" :question/id #uuid "5d5258aa-0eff-5685-bbfc-832665398ac8" :question/math-academy-id "q-165768" :question/problem "$$\n\nFind the derivative of $t(x)={x}^{4}\\operatorname{tanh}⁡{x}^{3}.$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{4}$ and $v(x)=\\operatorname{tanh}⁡{x}^{3}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{t}^{′}(x) & =({x}^{4})^{′}\\cdot \\operatorname{tanh}⁡{x}^{3}+{x}^{4}\\cdot (\\operatorname{tanh}⁡{x}^{3})^{′} \\\\  & =4{x}^{3}\\cdot \\operatorname{tanh}⁡{x}^{3}+{x}^{4}\\cdot 3{x}^{2}{sech}^{2}⁡{x}^{3} \\\\  & =4{x}^{3}\\operatorname{tanh}⁡{x}^{3}+3{x}^{6}{sech}^{2}⁡{x}^{3} \\\\  & ={x}^{3}(4\\operatorname{tanh}⁡{x}^{3}+3{x}^{3}{sech}^{2}⁡{x}^{3})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ec831a69-91d7-5f4f-b333-65069789c09e"] :db/ensure [:question/validate]} {:db/id "answer-field-ec831a69-91d7-5f4f-b333-65069789c09e" :answer-field/id #uuid "ec831a69-91d7-5f4f-b333-65069789c09e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b78b565d-f891-5af0-a9bc-c15c2a69d9e1" :answer-field/choices ["answer-341588b0-e576-5b38-951a-6a4b0b80aa65" "answer-b623ea0e-88cb-5afa-9b2e-75fa617f8b6d" "answer-b78b565d-f891-5af0-a9bc-c15c2a69d9e1" "answer-2f15ee6d-3774-57ff-9f40-a364a73b2883" "answer-fe7a160f-b010-5b9c-8d7a-ac5d3301bb8d"] :db/ensure [:answer-field/validate]} {:db/id "answer-341588b0-e576-5b38-951a-6a4b0b80aa65" :answer/id #uuid "341588b0-e576-5b38-951a-6a4b0b80aa65" :answer/type :answer.type/math :answer/value "4{x}^{3}\\operatorname{tanh}⁡3{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-b623ea0e-88cb-5afa-9b2e-75fa617f8b6d" :answer/id #uuid "b623ea0e-88cb-5afa-9b2e-75fa617f8b6d" :answer/type :answer.type/math :answer/value "4{x}^{3}{sech}^{2}⁡{x}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-b78b565d-f891-5af0-a9bc-c15c2a69d9e1" :answer/id #uuid "b78b565d-f891-5af0-a9bc-c15c2a69d9e1" :answer/type :answer.type/math :answer/value "{x}^{3}(4\\operatorname{tanh}⁡{x}^{3}+3{x}^{3}{sech}^{2}⁡{x}^{3})" :db/ensure [:answer/validate]} {:db/id "answer-2f15ee6d-3774-57ff-9f40-a364a73b2883" :answer/id #uuid "2f15ee6d-3774-57ff-9f40-a364a73b2883" :answer/type :answer.type/math :answer/value "{x}^{3}(\\operatorname{tanh}⁡3{x}^{2}+2{x}^{2}{sech}^{2}⁡{x}^{3})" :db/ensure [:answer/validate]} {:db/id "answer-fe7a160f-b010-5b9c-8d7a-ac5d3301bb8d" :answer/id #uuid "fe7a160f-b010-5b9c-8d7a-ac5d3301bb8d" :answer/type :answer.type/math :answer/value "{x}^{3}(\\operatorname{tanh}⁡{x}^{3}+{x}^{3}{sech}^{2}⁡{x}^{3})" :db/ensure [:answer/validate]} {:db/id 17592186106540 :question/problem "$$\n\nFind the derivative of $w(x)={e}^{2x}\\operatorname{cosh}⁡2x.$" :question/worked-solution "Here, we have the product of two functions $u(x)={e}^{2x}$ and $v(x)=\\operatorname{cosh}⁡2x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{w}^{′}(x) & =({e}^{2x})^{′}\\cdot \\operatorname{cosh}⁡2x+{e}^{2x}\\cdot (\\operatorname{cosh}⁡2x)^{′} \\\\  & =2{e}^{2x}\\cdot \\operatorname{cosh}⁡2x+{e}^{2x}\\cdot 2\\operatorname{sinh}⁡2x \\\\  & =2{e}^{2x}\\operatorname{cosh}⁡2x+2{e}^{2x}\\operatorname{sinh}⁡2x \\\\  & =2{e}^{2x}(\\operatorname{cosh}⁡2x+\\operatorname{sinh}⁡2x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105388 :answer-field/correct "answer-82171af4-fb2e-56b0-8999-b7117e2c797c" :answer-field/choices ["answer-82171af4-fb2e-56b0-8999-b7117e2c797c" "answer-fc685e5a-8d40-527a-a550-5d3e672e7015" "answer-241c0bdc-f4bb-51b1-847c-684d81e4ca27" "answer-79b780ac-11b2-5671-aae3-c6cd7fc2e3e9" "answer-0773a2e6-3184-5b9e-9278-3a6f401436e3"] :db/ensure [:answer-field/validate]} {:db/id "answer-82171af4-fb2e-56b0-8999-b7117e2c797c" :answer/id #uuid "82171af4-fb2e-56b0-8999-b7117e2c797c" :answer/type :answer.type/math :answer/value "2{e}^{2x}(\\operatorname{cosh}⁡2x+\\operatorname{sinh}⁡2x)" :db/ensure [:answer/validate]} {:db/id "answer-fc685e5a-8d40-527a-a550-5d3e672e7015" :answer/id #uuid "fc685e5a-8d40-527a-a550-5d3e672e7015" :answer/type :answer.type/math :answer/value "2{e}^{2x}(\\operatorname{cosh}⁡2x-\\operatorname{sinh}⁡2x)" :db/ensure [:answer/validate]} {:db/id "answer-241c0bdc-f4bb-51b1-847c-684d81e4ca27" :answer/id #uuid "241c0bdc-f4bb-51b1-847c-684d81e4ca27" :answer/type :answer.type/math :answer/value "2{e}^{2x}\\operatorname{cosh}⁡2x+2\\operatorname{sinh}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-79b780ac-11b2-5671-aae3-c6cd7fc2e3e9" :answer/id #uuid "79b780ac-11b2-5671-aae3-c6cd7fc2e3e9" :answer/type :answer.type/math :answer/value "4{e}^{2x}\\operatorname{cosh}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-0773a2e6-3184-5b9e-9278-3a6f401436e3" :answer/id #uuid "0773a2e6-3184-5b9e-9278-3a6f401436e3" :answer/type :answer.type/math :answer/value "{e}^{2x}(\\operatorname{cosh}⁡2x+\\operatorname{sinh}⁡2x)" :db/ensure [:answer/validate]} {:db/id 17592186106538 :question/problem "$$\n\nFind the derivative of $f(x)={x}^{2}\\operatorname{sinh}⁡2x.$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}$ and $v(x)=\\operatorname{sinh}⁡2x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{2})^{′}\\cdot \\operatorname{sinh}⁡2x+{x}^{2}\\cdot (\\operatorname{sinh}⁡2x)^{′} \\\\  & =2x\\cdot \\operatorname{sinh}⁡2x+{x}^{2}\\cdot 2\\operatorname{cosh}⁡2x \\\\  & =2x\\operatorname{sinh}⁡2x+2{x}^{2}\\operatorname{cosh}⁡2x \\\\  & =2x(\\operatorname{sinh}⁡2x+x\\operatorname{cosh}⁡2x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105376 :answer-field/correct "answer-cea62be6-2c20-5e26-b67d-12c7b38438a8" :answer-field/choices ["answer-cea62be6-2c20-5e26-b67d-12c7b38438a8" "answer-0116124c-af9a-5e9f-874b-588e5ddd3dd2" "answer-49849ce4-23af-5cbb-932a-1d6ee714f754" "answer-e6682837-b2ba-5929-8144-5c9ae9c8eca8" "answer-fbf8b51e-aeb9-5b54-bfe8-609633f31c67"] :db/ensure [:answer-field/validate]} {:db/id "answer-cea62be6-2c20-5e26-b67d-12c7b38438a8" :answer/id #uuid "cea62be6-2c20-5e26-b67d-12c7b38438a8" :answer/type :answer.type/math :answer/value "2x(\\operatorname{sinh}⁡2x+x\\operatorname{cosh}⁡2x)" :db/ensure [:answer/validate]} {:db/id "answer-0116124c-af9a-5e9f-874b-588e5ddd3dd2" :answer/id #uuid "0116124c-af9a-5e9f-874b-588e5ddd3dd2" :answer/type :answer.type/math :answer/value "2x(\\operatorname{sinh}⁡2x-x\\operatorname{cosh}⁡2x)" :db/ensure [:answer/validate]} {:db/id "answer-49849ce4-23af-5cbb-932a-1d6ee714f754" :answer/id #uuid "49849ce4-23af-5cbb-932a-1d6ee714f754" :answer/type :answer.type/math :answer/value "2x(x\\operatorname{cosh}⁡2x-\\operatorname{sinh}⁡2x)" :db/ensure [:answer/validate]} {:db/id "answer-e6682837-b2ba-5929-8144-5c9ae9c8eca8" :answer/id #uuid "e6682837-b2ba-5929-8144-5c9ae9c8eca8" :answer/type :answer.type/math :answer/value "2{x}^{2}(\\operatorname{sinh}⁡2x+\\operatorname{cosh}⁡2x)" :db/ensure [:answer/validate]} {:db/id "answer-fbf8b51e-aeb9-5b54-bfe8-609633f31c67" :answer/id #uuid "fbf8b51e-aeb9-5b54-bfe8-609633f31c67" :answer/type :answer.type/math :answer/value "2{x}^{2}\\operatorname{cosh}⁡2x" :db/ensure [:answer/validate]} {:db/id "question-a7015904-a594-5558-b15e-195c0d212c67" :question/id #uuid "a7015904-a594-5558-b15e-195c0d212c67" :question/math-academy-id "q-165769" :question/problem "$$\n\nFind the derivative of $f(x)={e}^{3x}\\operatorname{sinh}⁡{x}^{4}.$" :question/worked-solution "Here, we have the product of two functions $u(x)={e}^{3x}$ and $v(x)=\\operatorname{sinh}⁡{x}^{4}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({e}^{3x})^{′}\\cdot \\operatorname{sinh}⁡{x}^{4}+{e}^{3x}\\cdot (\\operatorname{sinh}⁡{x}^{4})^{′} \\\\  & =3{e}^{3x}\\cdot \\operatorname{sinh}⁡{x}^{4}+{e}^{3x}\\cdot 4{x}^{3}\\operatorname{cosh}⁡{x}^{4} \\\\  & =3{e}^{3x}\\operatorname{sinh}⁡{x}^{4}+4{x}^{3}{e}^{3x}\\operatorname{cosh}⁡{x}^{4} \\\\  & ={e}^{3x}(3\\operatorname{sinh}⁡{x}^{4}+4{x}^{3}\\operatorname{cosh}⁡{x}^{4})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a90bc6f3-7675-51c0-8f81-861695983257"] :db/ensure [:question/validate]} {:db/id "answer-field-a90bc6f3-7675-51c0-8f81-861695983257" :answer-field/id #uuid "a90bc6f3-7675-51c0-8f81-861695983257" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-15fc69fc-fac4-5619-8273-9adb15c09055" :answer-field/choices ["answer-626ea5e2-61b3-5089-9081-0a57f33a63f8" "answer-e33b4b7a-c489-548c-a8f4-61729169dcc3" "answer-15fc69fc-fac4-5619-8273-9adb15c09055" "answer-3204c239-058e-5cf9-9535-25ada5d2567f" "answer-3e2c23e0-5899-5e6c-a7b9-e13b0b091f4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-626ea5e2-61b3-5089-9081-0a57f33a63f8" :answer/id #uuid "626ea5e2-61b3-5089-9081-0a57f33a63f8" :answer/type :answer.type/math :answer/value "3{e}^{3x}\\operatorname{sinh}⁡{x}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-e33b4b7a-c489-548c-a8f4-61729169dcc3" :answer/id #uuid "e33b4b7a-c489-548c-a8f4-61729169dcc3" :answer/type :answer.type/math :answer/value "4{x}^{3}{e}^{3x}\\operatorname{cosh}⁡{x}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-15fc69fc-fac4-5619-8273-9adb15c09055" :answer/id #uuid "15fc69fc-fac4-5619-8273-9adb15c09055" :answer/type :answer.type/math :answer/value "{e}^{3x}(3\\operatorname{sinh}⁡{x}^{4}+4{x}^{3}\\operatorname{cosh}⁡{x}^{4})" :db/ensure [:answer/validate]} {:db/id "answer-3204c239-058e-5cf9-9535-25ada5d2567f" :answer/id #uuid "3204c239-058e-5cf9-9535-25ada5d2567f" :answer/type :answer.type/math :answer/value "{e}^{3x}(\\operatorname{sinh}⁡{x}^{4}+\\operatorname{cosh}⁡{x}^{4})" :db/ensure [:answer/validate]} {:db/id "answer-3e2c23e0-5899-5e6c-a7b9-e13b0b091f4f" :answer/id #uuid "3e2c23e0-5899-5e6c-a7b9-e13b0b091f4f" :answer/type :answer.type/math :answer/value "{e}^{3x}\\operatorname{sinh}⁡{x}^{4}+{x}^{3}\\operatorname{cosh}⁡{x}^{4}" :db/ensure [:answer/validate]} {:db/id "question-e582897a-43fa-53c9-83f2-0eb49fceb2e4" :question/id #uuid "e582897a-43fa-53c9-83f2-0eb49fceb2e4" :question/math-academy-id "q-95326" :question/problem "$$\n\nFind the derivative of $t(x)=\\frac{\\operatorname{cosh}⁡x}{{e}^{x}}.$" :question/worked-solution "In this case, the expression for $t(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{cosh}⁡x$ and $v(x)={e}^{x}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{t}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\operatorname{cosh}⁡x)^{′}\\cdot {e}^{x}-\\operatorname{cosh}⁡x\\cdot ({e}^{x})^{′}}{({e}^{x})^{2}} \\\\  & =\\frac{{e}^{x}\\operatorname{sinh}⁡x-{e}^{x}\\operatorname{cosh}⁡x}{{e}^{2x}} \\\\  & =\\frac{{e}^{x}(\\operatorname{sinh}⁡x-\\operatorname{cosh}⁡x)}{{e}^{2x}} \\\\  & =\\frac{\\operatorname{sinh}⁡x-\\operatorname{cosh}⁡x}{{e}^{x}}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-badf3675-593b-53b1-9b12-80230857c7e8"] :db/ensure [:question/validate]} {:db/id "answer-field-badf3675-593b-53b1-9b12-80230857c7e8" :answer-field/id #uuid "badf3675-593b-53b1-9b12-80230857c7e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-467b4753-1290-59b3-86c3-2ba3d8ddca0f" :answer-field/choices ["answer-16d2edcc-109d-5306-bc8f-e2bcf5cc5aa3" "answer-0f278621-e8ee-51fe-9d85-6f6789f750a4" "answer-467b4753-1290-59b3-86c3-2ba3d8ddca0f" "answer-11a34fc4-eb35-51d7-a29a-e83a642d8a6d" "answer-7e420d49-518e-5659-a187-584260e2d461"] :db/ensure [:answer-field/validate]} {:db/id "answer-16d2edcc-109d-5306-bc8f-e2bcf5cc5aa3" :answer/id #uuid "16d2edcc-109d-5306-bc8f-e2bcf5cc5aa3" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "answer-0f278621-e8ee-51fe-9d85-6f6789f750a4" :answer/id #uuid "0f278621-e8ee-51fe-9d85-6f6789f750a4" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sinh}⁡x-\\operatorname{cosh}⁡x}{{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "answer-467b4753-1290-59b3-86c3-2ba3d8ddca0f" :answer/id #uuid "467b4753-1290-59b3-86c3-2ba3d8ddca0f" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sinh}⁡x-\\operatorname{cosh}⁡x}{{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "answer-11a34fc4-eb35-51d7-a29a-e83a642d8a6d" :answer/id #uuid "11a34fc4-eb35-51d7-a29a-e83a642d8a6d" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}(\\operatorname{cosh}⁡x+\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-7e420d49-518e-5659-a187-584260e2d461" :answer/id #uuid "7e420d49-518e-5659-a187-584260e2d461" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}\\operatorname{sinh}⁡x+\\operatorname{cosh}⁡x}{2{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "question-620df981-8ac1-59e8-bd3d-58c107521764" :question/id #uuid "620df981-8ac1-59e8-bd3d-58c107521764" :question/math-academy-id "q-95319" :question/problem "$$\n\nFind the derivative of $g(x)=\\frac{{x}^{2}}{\\operatorname{cosh}⁡x}.$" :question/worked-solution "In this case, the expression for $g(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={x}^{2}$ and $v(x)=\\operatorname{cosh}⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{g}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{2})^{′}\\cdot \\operatorname{cosh}⁡x-{x}^{2}\\cdot (\\operatorname{cosh}⁡x)^{′}}{(\\operatorname{cosh}⁡x)^{2}} \\\\  & =\\frac{2x\\operatorname{cosh}⁡x-{x}^{2}\\operatorname{sinh}⁡x}{{cosh}^{2}⁡x} \\\\  & =\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7190823c-7b62-5fe3-8832-a1c3ce66183b"] :db/ensure [:question/validate]} {:db/id "answer-field-7190823c-7b62-5fe3-8832-a1c3ce66183b" :answer-field/id #uuid "7190823c-7b62-5fe3-8832-a1c3ce66183b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-22d02516-dc5f-556e-b39b-13fd3d6b51e6" :answer-field/choices ["answer-22d02516-dc5f-556e-b39b-13fd3d6b51e6" "answer-f4ad5635-7e83-5570-a915-b14de794c9a4" "answer-a599deda-ccd7-5dbd-bc5d-645966e7e62e" "answer-4191a7a4-bbad-54ca-ae0a-22ddbb9adf9c" "answer-52b32764-b280-54de-ab6f-645fd35e4af5"] :db/ensure [:answer-field/validate]} {:db/id "answer-22d02516-dc5f-556e-b39b-13fd3d6b51e6" :answer/id #uuid "22d02516-dc5f-556e-b39b-13fd3d6b51e6" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-f4ad5635-7e83-5570-a915-b14de794c9a4" :answer/id #uuid "f4ad5635-7e83-5570-a915-b14de794c9a4" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{sinh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-a599deda-ccd7-5dbd-bc5d-645966e7e62e" :answer/id #uuid "a599deda-ccd7-5dbd-bc5d-645966e7e62e" :answer/type :answer.type/math :answer/value "\\frac{x(\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{\\operatorname{cosh}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-4191a7a4-bbad-54ca-ae0a-22ddbb9adf9c" :answer/id #uuid "4191a7a4-bbad-54ca-ae0a-22ddbb9adf9c" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}(2\\operatorname{cosh}⁡x+x\\operatorname{sinh}⁡x)}{\\operatorname{sinh}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-52b32764-b280-54de-ab6f-645fd35e4af5" :answer/id #uuid "52b32764-b280-54de-ab6f-645fd35e4af5" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}(2\\operatorname{cosh}⁡x+x\\operatorname{sinh}⁡x)}{{cosh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id 17592186106539 :question/problem "$$\n\nFind the derivative of $f(x)=\\frac{{x}^{2}}{\\operatorname{sinh}⁡x}.$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={x}^{2}$ and $v(x)=\\operatorname{sinh}⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({x}^{2})^{′}\\cdot \\operatorname{sinh}⁡x-{x}^{2}\\cdot (\\operatorname{sinh}⁡x)^{′}}{(\\operatorname{sinh}⁡x)^{2}} \\\\  & =\\frac{2x\\operatorname{sinh}⁡x-{x}^{2}\\operatorname{cosh}⁡x}{{sinh}^{2}⁡x} \\\\  & =\\frac{x(2\\operatorname{sinh}⁡x-x\\operatorname{cosh}⁡x)}{{sinh}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105382 :answer-field/correct "answer-cdffa413-16d4-5eb6-ad55-dfdc472ea585" :answer-field/choices ["answer-d8e40cb5-f377-55c4-ae84-c4ae98fa80a6" "answer-2b637c9d-91e6-5581-9efa-bec60883d4fc" "answer-9c2611e4-4e0c-5724-b6ea-f82a8121df8f" "answer-fdf59cbd-7de4-59b2-a619-f048af40fe43" "answer-cdffa413-16d4-5eb6-ad55-dfdc472ea585"] :db/ensure [:answer-field/validate]} {:db/id "answer-d8e40cb5-f377-55c4-ae84-c4ae98fa80a6" :answer/id #uuid "d8e40cb5-f377-55c4-ae84-c4ae98fa80a6" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{cosh}⁡x-x\\operatorname{sinh}⁡x)}{{sinh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-2b637c9d-91e6-5581-9efa-bec60883d4fc" :answer/id #uuid "2b637c9d-91e6-5581-9efa-bec60883d4fc" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{sinh}⁡x-x\\operatorname{cosh}⁡x)}{2\\operatorname{sinh}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-9c2611e4-4e0c-5724-b6ea-f82a8121df8f" :answer/id #uuid "9c2611e4-4e0c-5724-b6ea-f82a8121df8f" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{sinh}⁡x-x\\operatorname{cosh}⁡x)}{\\operatorname{cosh}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-fdf59cbd-7de4-59b2-a619-f048af40fe43" :answer/id #uuid "fdf59cbd-7de4-59b2-a619-f048af40fe43" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{sinh}⁡x-x\\operatorname{cosh}⁡x)}{{cosh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-cdffa413-16d4-5eb6-ad55-dfdc472ea585" :answer/id #uuid "cdffa413-16d4-5eb6-ad55-dfdc472ea585" :answer/type :answer.type/math :answer/value "\\frac{x(2\\operatorname{sinh}⁡x-x\\operatorname{cosh}⁡x)}{{sinh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id 17592186106541 :question/problem "$$\n\nIf $w(x)=\\frac{{e}^{x}}{\\operatorname{tanh}⁡2x},$ then ${w}^{′}(x)=\\frac{{e}^{x}\\cdot g(x)}{{tanh}^{2}⁡2x}.$ What is $g(x)?$" :question/worked-solution "In this case, the expression for $w(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=\\operatorname{tanh}⁡2x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{w}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot \\operatorname{tanh}⁡2x-{e}^{x}\\cdot (\\operatorname{tanh}⁡2x)^{′}}{(\\operatorname{tanh}⁡2x)^{2}} \\\\  & =\\frac{{e}^{x}\\operatorname{tanh}⁡2x-{e}^{x}\\cdot 2{sech}^{2}⁡2x}{{tanh}^{2}⁡2x} \\\\  & =\\frac{{e}^{x}\\overset{g(x)}{\\overset{⏞}{(\\operatorname{tanh}⁡2x-2{sech}^{2}⁡2x)}}}{{tanh}^{2}⁡2x}\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $g(x)=\\operatorname{tanh}⁡2x-2{sech}^{2}⁡2x.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105394 :answer-field/correct "answer-15289765-de82-59df-97ba-0d29417be3c4" :answer-field/choices ["answer-fd90929f-74bf-5dd1-86c7-150fc2bee7dc" "answer-4bcf399a-5aed-50cf-b2a4-349b4f1efa84" "answer-396bbd32-45a7-503a-a769-5eda633edbb8" "answer-2867b1dd-6971-5434-8f40-5cf09d8f7298" "answer-15289765-de82-59df-97ba-0d29417be3c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd90929f-74bf-5dd1-86c7-150fc2bee7dc" :answer/id #uuid "fd90929f-74bf-5dd1-86c7-150fc2bee7dc" :answer/type :answer.type/math :answer/value "2{sech}^{2}⁡2x-\\operatorname{tanh}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-4bcf399a-5aed-50cf-b2a4-349b4f1efa84" :answer/id #uuid "4bcf399a-5aed-50cf-b2a4-349b4f1efa84" :answer/type :answer.type/math :answer/value "2{sech}^{2}⁡x+\\operatorname{tanh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-396bbd32-45a7-503a-a769-5eda633edbb8" :answer/id #uuid "396bbd32-45a7-503a-a769-5eda633edbb8" :answer/type :answer.type/math :answer/value "\\operatorname{tanh}⁡2x+2{sech}^{2}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-2867b1dd-6971-5434-8f40-5cf09d8f7298" :answer/id #uuid "2867b1dd-6971-5434-8f40-5cf09d8f7298" :answer/type :answer.type/math :answer/value "\\operatorname{tanh}⁡2x-2\\operatorname{sech}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-15289765-de82-59df-97ba-0d29417be3c4" :answer/id #uuid "15289765-de82-59df-97ba-0d29417be3c4" :answer/type :answer.type/math :answer/value "\\operatorname{tanh}⁡2x-2{sech}^{2}⁡2x" :db/ensure [:answer/validate]} {:db/id "question-f50f96cb-b22b-5bd9-91c4-b27ea7e844e6" :question/id #uuid "f50f96cb-b22b-5bd9-91c4-b27ea7e844e6" :question/math-academy-id "q-95321" :question/problem "$$\n\nFind the derivative of $t(x)=\\frac{\\operatorname{sinh}⁡x}{x}.$" :question/worked-solution "In this case, the expression for $t(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{sinh}⁡x$ and $v(x)=x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{t}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\operatorname{sinh}⁡x)^{′}\\cdot x-\\operatorname{sinh}⁡x\\cdot (x)^{′}}{(x)^{2}} \\\\  & =\\frac{x\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x}{{x}^{2}}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0b4e66d0-cce5-5bca-be9d-88ea3aa6f7f5"] :db/ensure [:question/validate]} {:db/id "answer-field-0b4e66d0-cce5-5bca-be9d-88ea3aa6f7f5" :answer-field/id #uuid "0b4e66d0-cce5-5bca-be9d-88ea3aa6f7f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d216dca9-fa9f-5804-8e8b-132f728099a3" :answer-field/choices ["answer-2923920c-8f34-5883-92c8-64a3c4a7a2d1" "answer-8eb6be51-7e62-5c25-a3e3-ae0db051bb18" "answer-4f595895-4d69-5dd1-a2dd-9562d3e2896a" "answer-a870595f-b9a9-5b6a-9775-c3a36a8f8d3c" "answer-d216dca9-fa9f-5804-8e8b-132f728099a3"] :db/ensure [:answer-field/validate]} {:db/id "answer-2923920c-8f34-5883-92c8-64a3c4a7a2d1" :answer/id #uuid "2923920c-8f34-5883-92c8-64a3c4a7a2d1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{cosh}⁡{x}^{2}+2\\operatorname{sinh}⁡x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-8eb6be51-7e62-5c25-a3e3-ae0db051bb18" :answer/id #uuid "8eb6be51-7e62-5c25-a3e3-ae0db051bb18" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{cosh}⁡x+\\operatorname{sinh}⁡x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-4f595895-4d69-5dd1-a2dd-9562d3e2896a" :answer/id #uuid "4f595895-4d69-5dd1-a2dd-9562d3e2896a" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x}{2x}" :db/ensure [:answer/validate]} {:db/id "answer-a870595f-b9a9-5b6a-9775-c3a36a8f8d3c" :answer/id #uuid "a870595f-b9a9-5b6a-9775-c3a36a8f8d3c" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x}{{sinh}^{2}⁡x}" :db/ensure [:answer/validate]} {:db/id "answer-d216dca9-fa9f-5804-8e8b-132f728099a3" :answer/id #uuid "d216dca9-fa9f-5804-8e8b-132f728099a3" :answer/type :answer.type/math :answer/value "\\frac{x\\operatorname{cosh}⁡x-\\operatorname{sinh}⁡x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186107119 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nSince the hyperbolic functions are defined in terms of exponential functions, we can easily calculate their derivatives. \n\nThe derivatives of the basic hyperbolic functions are as follows:  \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) & =\\operatorname{cosh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x) & =\\operatorname{sinh}⁡x \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) & ={sech}^{2}⁡x\\end{aligned}\n$$\n\nLet's use these results to find the derivative of the following function:\n\n$$\ny = \\sinh{x} - 2\\cosh{x}\n$$\n\nUsing the usual properties of derivatives, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x-2\\operatorname{cosh}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)+\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{cosh}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)-2\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x) \\\\  & =\\operatorname{cosh}⁡x-2\\operatorname{sinh}⁡x.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186107120 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n%$\n\nWe would like the prove the following result:\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\sinh{x}) = \\cosh x\n$$\n\nTo do this, we revert to the definition of the hyperbolic sine:\n\n$$\n\\sinh x = \\dfrac{1}{2}(e^x-e^{-x}).\n$$\n\nDifferentiating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}({e}^{x}-{e}^{-x})) \\\\  & =\\frac{1}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}-{e}^{-x}) \\\\  & =\\frac{1}{2}({e}^{x}+{e}^{-x}) \\\\  & =\\operatorname{cosh}⁡x.\\end{aligned}\n$$\n\nThe proof for the derivative of the hyperbolic cosine is very similar. You may wish to try it for yourself." :db/ensure [:tutorial/validate]} {:db/id 17592186107121 :tutorial/content "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nWe would like the prove the following result:\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\tanh{x}) = \\sech^2{x}\n$$\n\nWe do this using the definition of the hyperbolic tangent. The most convenient definition to work with for this purpose is\n\n$$\n\\tanh{x} = \\dfrac{e^{2x}-1}{e^{2x}+1}.\n$$\n\nDifferentiating the above equation with respect to $x$ using the quotient rule, we arrive at\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{{e}^{2x}-1}{{e}^{2x}+1}) \\\\  & =\\frac{({e}^{2x}-1)^{′}\\cdot ({e}^{2x}+1)-({e}^{2x}-1)\\cdot ({e}^{2x}+1)^{′}}{({e}^{2x}+1)^{2}} \\\\  & =\\frac{(2{e}^{2x})({e}^{2x}+1)-({e}^{2x}-1)(2{e}^{2x})}{({e}^{2x}+1)^{2}} \\\\  & =\\frac{2{e}^{4x}+2{e}^{2x}-2{e}^{4x}+2{e}^{2x}}{({e}^{2x}+1)^{2}} \\\\  & =\\frac{4{e}^{2x}}{({e}^{2x}+1)^{2}} \\\\  & ={(\\frac{2{e}^{x}}{{e}^{2x}+1})}^{2} \\\\  & ={(\\frac{2}{{e}^{x}+{e}^{-x}})}^{2} \\\\  & ={sech}^{2}⁡x.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186105995 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}]
