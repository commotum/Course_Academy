iculty/hard :question/answer-fields ["answer-field-dc4447ed-0309-5781-8693-3c34c1c2934f" "answer-field-3b37a3b1-6734-5517-b9b6-09a79f9d9a30"] :db/ensure [:question/validate]} {:db/id "answer-field-dc4447ed-0309-5781-8693-3c34c1c2934f" :answer-field/id #uuid "dc4447ed-0309-5781-8693-3c34c1c2934f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5f4e0111-628c-57f0-a84a-ba72cd5d67ec" :answer-field/choices ["answer-5f4e0111-628c-57f0-a84a-ba72cd5d67ec"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f4e0111-628c-57f0-a84a-ba72cd5d67ec" :answer/id #uuid "5f4e0111-628c-57f0-a84a-ba72cd5d67ec" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-field-3b37a3b1-6734-5517-b9b6-09a79f9d9a30" :answer-field/id #uuid "3b37a3b1-6734-5517-b9b6-09a79f9d9a30" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8a89be58-04f8-549a-99ab-01a52f4fea1f" :answer-field/choices ["answer-8a89be58-04f8-549a-99ab-01a52f4fea1f"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a89be58-04f8-549a-99ab-01a52f4fea1f" :answer/id #uuid "8a89be58-04f8-549a-99ab-01a52f4fea1f" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "question-bbd97f04-776a-53ed-8d9f-1d2d316080bc" :question/id #uuid "bbd97f04-776a-53ed-8d9f-1d2d316080bc" :question/math-academy-id "q-618" :question/problem "$(8-\\sqrt{-4})-(-7+\\sqrt{-49})=$" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(8-\\sqrt{-4})-(-7+\\sqrt{-49}) & =(8-2\\,\\text{i})-(-7+7\\,\\text{i}) \\\\  & =(8-(-7))+(-2-7)\\,\\text{i} \\\\  & =(8+7)-9\\,\\text{i} \\\\  & =15-9\\,\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c00f6f1d-0c52-564e-8f1d-74a94a299c58"] :db/ensure [:question/validate]} {:db/id "answer-field-c00f6f1d-0c52-564e-8f1d-74a94a299c58" :answer-field/id #uuid "c00f6f1d-0c52-564e-8f1d-74a94a299c58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-da207f9b-cdb4-5aff-abdc-a42363b85af1" :answer-field/choices ["answer-129c5a15-dc44-5123-9a94-b553fc2ed6ce" "answer-9bb59b1b-b8fb-5e75-87b7-c4b675f155cf" "answer-d951c13c-35a9-58ae-b365-491af89b2363" "answer-da207f9b-cdb4-5aff-abdc-a42363b85af1" "answer-d741f620-b286-539d-baca-62f96f932304"] :db/ensure [:answer-field/validate]} {:db/id "answer-129c5a15-dc44-5123-9a94-b553fc2ed6ce" :answer/id #uuid "129c5a15-dc44-5123-9a94-b553fc2ed6ce" :answer/type :answer.type/math :answer/value "-15+9\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-9bb59b1b-b8fb-5e75-87b7-c4b675f155cf" :answer/id #uuid "9bb59b1b-b8fb-5e75-87b7-c4b675f155cf" :answer/type :answer.type/math :answer/value "1-9\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-d951c13c-35a9-58ae-b365-491af89b2363" :answer/id #uuid "d951c13c-35a9-58ae-b365-491af89b2363" :answer/type :answer.type/math :answer/value "15-5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-da207f9b-cdb4-5aff-abdc-a42363b85af1" :answer/id #uuid "da207f9b-cdb4-5aff-abdc-a42363b85af1" :answer/type :answer.type/math :answer/value "15-9\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-d741f620-b286-539d-baca-62f96f932304" :answer/id #uuid "d741f620-b286-539d-baca-62f96f932304" :answer/type :answer.type/math :answer/value "6\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "question-246ccde2-7d9b-5b08-9b39-f9d20f01227f" :question/id #uuid "246ccde2-7d9b-5b08-9b39-f9d20f01227f" :question/math-academy-id "q-250309" :question/problem "Evaluate the following expression. Use $i$ to denote the imaginary unit.\n\n$-5\\,\\text{i}-8\\,\\text{i}=$\n{{field-1}}" :question/worked-solution "To add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nIn this case, $-5\\,\\text{i}$ and $8\\,\\text{i}$ are purely imaginary numbers. Therefore, we only need to add their imaginary parts, as follows:\n\n$$\n-5\\,\\text{i}-8\\,\\text{i}=(-5-8)\\,\\text{i}=-13\\,\\text{i}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-12c79ce4-e236-5b81-a2c2-6e089ea4d1fc"] :db/ensure [:question/validate]} {:db/id "answer-field-12c79ce4-e236-5b81-a2c2-6e089ea4d1fc" :answer-field/id #uuid "12c79ce4-e236-5b81-a2c2-6e089ea4d1fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-499d2470-ca75-5036-b798-09ddfbde9645" :answer-field/choices ["answer-499d2470-ca75-5036-b798-09ddfbde9645"] :db/ensure [:answer-field/validate]} {:db/id "answer-499d2470-ca75-5036-b798-09ddfbde9645" :answer/id #uuid "499d2470-ca75-5036-b798-09ddfbde9645" :answer/type :answer.type/math :answer/value "-13i" :db/ensure [:answer/validate]} {:db/id 17592186055454 :question/problem "$-5\\,\\text{i}+\\text{i}=$" :question/worked-solution "To add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nIn this case, $-5\\,\\text{i}$ and $\\text{i}$ are purely imaginary numbers. Therefore, we only need to add their imaginary parts, as follows:\n\n$$\n\\begin{aligned}-5\\,\\text{i}+\\text{i} & =-5\\,\\text{i}+1\\,\\text{i}=(-5+1)\\,\\text{i}=-4\\,\\text{i}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186053961 :answer-field/correct "answer-2579f201-b32d-5e4d-8992-d2d1d9d6da62" :answer-field/choices ["answer-2579f201-b32d-5e4d-8992-d2d1d9d6da62" "answer-07c3e071-9981-54b0-a37f-1ac68b832cca" "answer-4ee5568d-f299-5e9d-a5de-8fe35d08ac54" "answer-d88c9e27-515a-5605-86dd-ff88c6464b8b" "answer-cdf1c958-dea0-587f-b51c-d8fe3c4f42df"] :db/ensure [:answer-field/validate]} {:db/id "answer-2579f201-b32d-5e4d-8992-d2d1d9d6da62" :answer/id #uuid "2579f201-b32d-5e4d-8992-d2d1d9d6da62" :answer/type :answer.type/math :answer/value "-4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-07c3e071-9981-54b0-a37f-1ac68b832cca" :answer/id #uuid "07c3e071-9981-54b0-a37f-1ac68b832cca" :answer/type :answer.type/math :answer/value "-5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-4ee5568d-f299-5e9d-a5de-8fe35d08ac54" :answer/id #uuid "4ee5568d-f299-5e9d-a5de-8fe35d08ac54" :answer/type :answer.type/math :answer/value "-6\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-d88c9e27-515a-5605-86dd-ff88c6464b8b" :answer/id #uuid "d88c9e27-515a-5605-86dd-ff88c6464b8b" :answer/type :answer.type/math :answer/value "4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-cdf1c958-dea0-587f-b51c-d8fe3c4f42df" :answer/id #uuid "cdf1c958-dea0-587f-b51c-d8fe3c4f42df" :answer/type :answer.type/math :answer/value "5\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186055967 :tutorial/content "To add complex numbers, we just add the real parts and add the imaginary parts separately. For example,\n\n$$\n\\begin{aligned}(3+5\\text{i})+(2-3\\text{i}) & =(3+5\\text{i})+(2-3\\text{i}) \\\\  & =(3+2)+(5+(-\\,3))\\text{i} \\\\  & =(3+2)+(5-3)\\text{i} \\\\  & =5+2\\text{i}\\end{aligned}\n$$\n\nIn general, we write\n\n$$\n(a + b\\textrm{i}) + (c + d\\textrm{i}) = (a + c) + (b + d)\\textrm{i}.\n$$\n\nSubtracting complex numbers works in the same way: we just subtract the real parts and subtract the imaginary parts separately. For example,\n\n$$\n\\begin{aligned}(3+5\\text{i})-(2-3\\text{i}) & =(3+5\\text{i})-(2-3\\text{i}) \\\\  & =(3-2)+(5-(-\\,3))\\text{i} \\\\  & =(3-2)+(5+3)\\text{i} \\\\  & =1+8\\text{i}.\\end{aligned}\n$$\n\nIn general, we write\n\n$$\n(a + b\\textrm{i}) - (c + d\\textrm{i}) = (a - c) + (b - d)\\textrm{i}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054893 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186078383 :knowledge-point/questions ["question-fbda5c07-3c3f-5393-8bd3-32f9b514a1ca"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fbda5c07-3c3f-5393-8bd3-32f9b514a1ca" :question/id #uuid "fbda5c07-3c3f-5393-8bd3-32f9b514a1ca" :question/math-academy-id "q-166070" :question/problem "The function $p(x)$ is defined as\n\n$$\np(x)=\\{\\begin{aligned}k+10, & \\,x\\le 3, \\\\ g(x), & \\,x>3.\\end{aligned}\n$$\n\n \n\nFind the value of the constant $k$ that makes $p(x)$ continuous at $x=3.$\n\n$k\\,=$\n{{field-1}}" :question/worked-solution "We have the piecewise function\n\n$$\np(x)=\\{\\begin{aligned}k+10, & \\,x\\le 3, \\\\ 8x-\\frac{2}{3}{x}^{3}, & \\,x>3.\\end{aligned}\n$$\n\n \n\nAt $x=3,$ the left-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}p(x) & =p(3) \\\\  & =k+10,\\end{aligned}\n$$\n\n \n\nand the right-sided limit is\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{+}}p(x) & ={lim}_{x\\to {3}^{+}}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8(3)-\\frac{2}{3}(3)^{3} \\\\  & =24-18 \\\\  & =6.\\end{aligned}\n$$\n\nIn order for $p(x)$ to be continuous at $x=3,$ we require that\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}p(x) & ={lim}_{x\\to {3}^{+}}p(x) \\\\ k+10 & =6 \\\\ k & =-4.\\end{aligned}\n$$\n\nTherefore, $p(x)$ is continuous at $x=3$ when $k=-4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-43939460-e1b0-596e-a7b7-ed6180d6c370"] :db/ensure [:question/validate]} {:db/id "answer-field-43939460-e1b0-596e-a7b7-ed6180d6c370" :answer-field/id #uuid "43939460-e1b0-596e-a7b7-ed6180d6c370" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6c3822e0-7f7b-5338-85bf-9c5070788c44" :answer-field/choices ["answer-6c3822e0-7f7b-5338-85bf-9c5070788c44"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c3822e0-7f7b-5338-85bf-9c5070788c44" :answer/id #uuid "6c3822e0-7f7b-5338-85bf-9c5070788c44" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id 17592186059675 :knowledge-point/questions ["question-83dc5138-e470-5b8f-b97c-b3006ebeb428"] :db/ensure [:knowledge-point/validate]} {:db/id "question-83dc5138-e470-5b8f-b97c-b3006ebeb428" :question/id #uuid "83dc5138-e470-5b8f-b97c-b3006ebeb428" :question/math-academy-id "q-166071" :question/problem "$\\frac{\\text{d}h}{\\text{d}x}\\,=${{field-1}}" :question/worked-solution "We know that \n\n$$\n\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\n$$\n\nApplying this formula and the constant multiple rules, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x) \\\\  & =-4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\  & =-4\\cdot (\\operatorname{cos}⁡x) \\\\  & =-4\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0c175b32-cf9f-563c-b23b-dd0064f3ca32"] :db/ensure [:question/validate]} {:db/id "answer-field-0c175b32-cf9f-563c-b23b-dd0064f3ca32" :answer-field/id #uuid "0c175b32-cf9f-563c-b23b-dd0064f3ca32" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer-field/choices ["answer-f06a75e2-cb48-5e18-9b9c-3baddcbbb99f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer/id #uuid "f06a75e2-cb48-5e18-9b9c-3baddcbbb99f" :answer/type :answer.type/math :answer/value "-4\\cos x" :db/ensure [:answer/validate]} {:db/id 17592186059677 :knowledge-point/questions ["question-60d8ee2b-aed9-5a87-bc1d-99d095c196bb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-60d8ee2b-aed9-5a87-bc1d-99d095c196bb" :question/id #uuid "60d8ee2b-aed9-5a87-bc1d-99d095c196bb" :question/math-academy-id "q-166072" :question/problem "${g}^{″}(x)=${{field-1}}" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(8x-\\frac{2}{3}{x}^{3}) \\\\  & =8-\\frac{2}{3}\\cdot 3{x}^{2} \\\\  & =8-2{x}^{2}.\\end{aligned}\n$$\n\nFinally, computing the second derivative, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(x) & =\\frac{\\text{d}}{\\text{d}x}(8-2{x}^{2}) \\\\  & =-4x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-826eda45-40bd-506b-a5bb-0ddbb36d06dc"] :db/ensure [:question/validate]} {:db/id "answer-field-826eda45-40bd-506b-a5bb-0ddbb36d06dc" :answer-field/id #uuid "826eda45-40bd-506b-a5bb-0ddbb36d06dc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer-field/choices ["answer-75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer/id #uuid "75bfff0a-4c65-5fd2-b1ef-35a173aa2b7e" :answer/type :answer.type/math :answer/value "-4x" :db/ensure [:answer/validate]} {:db/id 17592186096619 :knowledge-point/questions ["question-d1eaed8d-b238-536c-b3a6-a6e7f9e94a12"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d1eaed8d-b238-536c-b3a6-a6e7f9e94a12" :question/id #uuid "d1eaed8d-b238-536c-b3a6-a6e7f9e94a12" :question/math-academy-id "q-166073" :question/problem "If a curve $C$ is defined by the equation $y=f(x)\\cdot h(x),$ calculate the slope of the tangent line to the curve at the point where $x=\\pi .$\n\nSlope $\\,=$\n{{field-1}}" :question/worked-solution "We differentiate using the product rule. Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x})=\\frac{1}{2}{e}^{x} \\\\ \\frac{\\text{d}h}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{sin}⁡x)=-4\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =f\\frac{\\text{d}h}{\\text{d}x}+h\\frac{\\text{d}f}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{x}\\cdot (-4\\operatorname{cos}⁡x)+(-4\\operatorname{sin}⁡x)\\cdot \\frac{1}{2}{e}^{x} \\\\  & =-2{e}^{x}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\pi $ into the formula and get\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=\\pi } & =-2{e}^{\\pi }(\\operatorname{cos}⁡\\pi +\\operatorname{sin}⁡\\pi ) \\\\  & =-2{e}^{\\pi }(-1+0) \\\\  & =2{e}^{\\pi }.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $2{e}^{\\pi }.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f49d4659-1c96-5a65-a285-84ed00e2cd31"] :db/ensure [:question/validate]} {:db/id "answer-field-f49d4659-1c96-5a65-a285-84ed00e2cd31" :answer-field/id #uuid "f49d4659-1c96-5a65-a285-84ed00e2cd31" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer-field/choices ["answer-e2f634bf-1fab-5c5c-9faf-cca696e95edd"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer/id #uuid "e2f634bf-1fab-5c5c-9faf-cca696e95edd" :answer/type :answer.type/math :answer/value "2e^{\\pi}" :db/ensure [:answer/validate]} {:db/id 17592186092240 :knowledge-point/questions ["question-745a29fd-db69-5896-9d5f-b9b3dcaa95b6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-745a29fd-db69-5896-9d5f-b9b3dcaa95b6" :question/id #uuid "745a29fd-db69-5896-9d5f-b9b3dcaa95b6" :question/math-academy-id "q-166074" :question/problem "The equation of the normal to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is$\\,y=$\n{{field-1}}." :question/worked-solution "When $x=\\pi ,$ we have\n\n$$\n\\begin{aligned}y(\\pi ) & =f(\\pi )\\cdot h(\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot (-4\\operatorname{sin}⁡\\pi ) \\\\  & =\\frac{1}{2}{e}^{\\pi }\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nIn part 4, we found that the slope of the tangent line to the curve $y=f(x)\\cdot h(x)$ at the point where $x=\\pi $ is $m=2{e}^{\\pi }.$ Therefore, the slope of the normal ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{2{e}^{\\pi }}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-{y}_{1} & ={m}^{′}(x-{x}_{1}) \\\\ y-0 & =-\\frac{1}{2{e}^{\\pi }}(x-\\pi ) \\\\ y & =-\\frac{x}{2{e}^{\\pi }}+\\frac{\\pi }{2{e}^{\\pi }}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-059506ee-d597-56af-bfce-bf17819d6958"] :db/ensure [:question/validate]} {:db/id "answer-field-059506ee-d597-56af-bfce-bf17819d6958" :answer-field/id #uuid "059506ee-d597-56af-bfce-bf17819d6958" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-190621cf-ca9e-5595-8816-3501bc000442" :answer-field/choices ["answer-190621cf-ca9e-5595-8816-3501bc000442"] :db/ensure [:answer-field/validate]} {:db/id "answer-190621cf-ca9e-5595-8816-3501bc000442" :answer/id #uuid "190621cf-ca9e-5595-8816-3501bc000442" :answer/type :answer.type/math :answer/value "-\\frac{x-\\pi}{2e^{\\pi}}" :db/ensure [:answer/validate]} {:db/id 17592186096621 :knowledge-point/questions ["question-709bef3c-1deb-5177-94a0-6a0cd6bca192"] :db/ensure [:knowledge-point/validate]} {:db/id "question-709bef3c-1deb-5177-94a0-6a0cd6bca192" :question/id #uuid "709bef3c-1deb-5177-94a0-6a0cd6bca192" :question/math-academy-id "q-166075" :question/problem "$\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h})\\,=${{field-1}}" :question/worked-solution "Recall that $f(x)=\\frac{1}{2}{e}^{x}$ and $h(x)=-4\\operatorname{sin}⁡x.$\n\nWe apply the quotient rule, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{f}{h}) & =\\frac{{f}^{′}(x)\\cdot h(x)-f(x)\\cdot {h}^{′}(x)}{[h(x)]^{2}} \\\\  & =\\frac{{(\\frac{1}{2}{e}^{x})}^{′}\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)^{′}}{(-4\\operatorname{sin}⁡x)^{2}} \\\\  & =\\frac{(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{sin}⁡x)-(\\frac{1}{2}{e}^{x})\\cdot (-4\\operatorname{cos}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{2{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{16{sin}^{2}⁡x} \\\\  & =\\frac{{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{8{sin}^{2}⁡x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ba412a72-8abe-5840-811a-70be04c017e7"] :db/ensure [:question/validate]} {:db/id "answer-field-ba412a72-8abe-5840-811a-70be04c017e7" :answer-field/id #uuid "ba412a72-8abe-5840-811a-70be04c017e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer-field/choices ["answer-7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/id #uuid "7f4e9c3e-c075-5ee8-b58c-ef68c609d2b9" :answer/type :answer.type/math :answer/value "\\frac{e^x(\\cos x-\\sin x)}{8\\sin^2 x}" :db/ensure [:answer/validate]} {:db/id 17592186092263 :knowledge-point/questions ["question-2d877a64-29c8-5e32-8920-d62abb73e697"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2d877a64-29c8-5e32-8920-d62abb73e697" :question/id #uuid "2d877a64-29c8-5e32-8920-d62abb73e697" :question/math-academy-id "q-166076" :question/problem "Given that $y=f(h(x)),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}\\,=$\n{{field-1}}" :question/worked-solution "First, notice that $y$ is a composite function:\n\n$$\ny=\\frac{1}{2}{e}^{h},\\,h=-4\\operatorname{sin}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}h}=\\frac{1}{2}{e}^{h},\\,\\frac{\\text{d}h}{\\text{d}x}=-4\\operatorname{cos}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}h}\\cdot \\frac{\\text{d}h}{\\text{d}x} \\\\  & =\\frac{1}{2}{e}^{h}\\cdot (-4\\operatorname{cos}⁡x) \\\\  & =-2{e}^{-4\\operatorname{sin}⁡x}\\operatorname{cos}⁡x \\\\  & =-\\frac{2\\operatorname{cos}⁡x}{{e}^{4\\operatorname{sin}⁡x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bb0216fd-fe08-5818-afd9-7fc21cfab6bb"] :db/ensure [:question/validate]} {:db/id "answer-field-bb0216fd-fe08-5818-afd9-7fc21cfab6bb" :answer-field/id #uuid "bb0216fd-fe08-5818-afd9-7fc21cfab6bb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c73650fb-8ca5-5747-bbe3-f451e92a6a69" :answer-field/choices ["answer-c73650fb-8ca5-5747-bbe3-f451e92a6a69"] :db/ensure [:answer-field/validate]} {:db/id "answer-c73650fb-8ca5-5747-bbe3-f451e92a6a69" :answer/id #uuid "c73650fb-8ca5-5747-bbe3-f451e92a6a69" :answer/type :answer.type/math :answer/value "-2e^{-4\\sin x}\\cos x" :db/ensure [:answer/validate]} {:db/id 17592186064273 :knowledge-point/questions ["question-d78b3b66-caba-5b75-9179-7631fdc0e796"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d78b3b66-caba-5b75-9179-7631fdc0e796" :question/id #uuid "d78b3b66-caba-5b75-9179-7631fdc0e796" :question/math-academy-id "q-166077" :question/problem "![](images/5d/5d2bfbefca5ce0a0b04accad183d0f43537d600c72000058b59f692398259a80.png)\n\nThe graph of $y=g(x)$ for $x\\in [-3,3]$ is plotted above. In ascending order, what are the $x$-coordinates of the points on this interval where ${g}^{′}(x)=0?$\n\n${g}^{′}(x)=0\\,$ when $\\,x\\,=$\n{{field-1}}\n$\\,$ and $\\,x\\,=$\n{{field-2}}\n." :question/worked-solution "A stationary point of $g(x)$ is a value of $x$ where ${g}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.  \n\nIn the given graph, we can see that at $x=-2$ and $x=2,$ the tangent to the graph is horizontal, so we have ${g}^{′}(x)=0$ at these points.\n\n![](images/36/36fd58470a5361250fa7852d92abe2b9c2dbf18ca97d00e51ea4013f8f3aa348.png)\n\n \n\nTherefore, there are two stationary points, and their $x$-coordinates (in ascending order) are $x=-2$ and $x=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0f1f1a16-dad9-5c77-b873-2409266dc186" "answer-field-e547d708-bc0b-5d82-8783-16718788d1d8"] :db/ensure [:question/validate]} {:db/id "answer-field-0f1f1a16-dad9-5c77-b873-2409266dc186" :answer-field/id #uuid "0f1f1a16-dad9-5c77-b873-2409266dc186" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-233b9c64-ca46-556b-a55b-afac855b6ea4" :answer-field/choices ["answer-233b9c64-ca46-556b-a55b-afac855b6ea4"] :db/ensure [:answer-field/validate]} {:db/id "answer-233b9c64-ca46-556b-a55b-afac855b6ea4" :answer/id #uuid "233b9c64-ca46-556b-a55b-afac855b6ea4" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-e547d708-bc0b-5d82-8783-16718788d1d8" :answer-field/id #uuid "e547d708-bc0b-5d82-8783-16718788d1d8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-578b231b-5611-5088-bf50-85af5441c79a" :answer-field/choices ["answer-578b231b-5611-5088-bf50-85af5441c79a"] :db/ensure [:answer-field/validate]} {:db/id "answer-578b231b-5611-5088-bf50-85af5441c79a" :answer/id #uuid "578b231b-5611-5088-bf50-85af5441c79a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186064178 :knowledge-point/questions ["question-2932e26e-2b57-549a-866d-7abe171c7f20"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2932e26e-2b57-549a-866d-7abe171c7f20" :question/id #uuid "2932e26e-2b57-549a-866d-7abe171c7f20" :question/math-academy-id "q-166078" :question/problem "$\\int h(x)\\,\\text{d}x\\,=${{field-1}}\n$+\\,C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "Recall that\n\n$$\n\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int h(x)\\,\\text{d}x & =\\int -4\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-4(-\\operatorname{cos}⁡x)+C \\\\  & =4\\operatorname{cos}⁡x+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-685c059e-7098-5c75-b848-36830bd2c7c1"] :db/ensure [:question/validate]} {:db/id "answer-field-685c059e-7098-5c75-b848-36830bd2c7c1" :answer-field/id #uuid "685c059e-7098-5c75-b848-36830bd2c7c1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer-field/choices ["answer-1a232ba6-fdfc-512b-a78c-01e0aa14d08a"] :db/ensure [:answer-field/validate]} {:db/id "answer-1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/id #uuid "1a232ba6-fdfc-512b-a78c-01e0aa14d08a" :answer/type :answer.type/math :answer/value "4\\cos x" :db/ensure [:answer/validate]} {:db/id 17592186064177 :knowledge-point/questions ["question-7323da16-6dcc-5329-81f1-5b6cb91bd332"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7323da16-6dcc-5329-81f1-5b6cb91bd332" :question/id #uuid "7323da16-6dcc-5329-81f1-5b6cb91bd332" :question/math-academy-id "q-166079" :question/problem "$\\int (4f(x)+3g(x))\\,\\text{d}x\\,=${{field-1}}\n$+C,\\,$ where $C$ is an arbitrary constant." :question/worked-solution "We combine the sum and the constant multiple rules, as follows:\n\n$$\n\\begin{aligned}\\int (4f(x)+3g(x))\\text{d}x & =\\int (4\\cdot \\frac{1}{2}{e}^{x}+3(8x-\\frac{2}{3}{x}^{3}))\\text{d}x \\\\  & =\\int (2{e}^{x}+24x-2{x}^{3})\\text{d}x \\\\  & =2\\int {e}^{x}\\,\\text{d}x+24\\int x\\,\\text{d}x-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{e}^{x}+24\\cdot \\frac{{x}^{2}}{2}-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{e}^{x}-\\frac{{x}^{4}}{2}+12{x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9a994c66-aac8-5b19-bc23-3cf37a49b2cc"] :db/ensure [:question/validate]} {:db/id "answer-field-9a994c66-aac8-5b19-bc23-3cf37a49b2cc" :answer-field/id #uuid "9a994c66-aac8-5b19-bc23-3cf37a49b2cc" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-569b842d-17a2-53d4-9b00-9b5178c0a749" :answer-field/choices ["answer-569b842d-17a2-53d4-9b00-9b5178c0a749"] :db/ensure [:answer-field/validate]} {:db/id "answer-569b842d-17a2-53d4-9b00-9b5178c0a749" :answer/id #uuid "569b842d-17a2-53d4-9b00-9b5178c0a749" :answer/type :answer.type/math :answer/value "2e^x+12x^2-\\frac{x^4}{2}" :db/ensure [:answer/validate]} {:db/id "multistep-c918a931-a94f-57cf-9983-07568d2db58a" :multistep/id #uuid "c918a931-a94f-57cf-9983-07568d2db58a" :multistep/context "Consider the following functions: \n\n$$\nf(x)=\\frac{1}{2}{e}^{x},\\,g(x)=8x-\\frac{2}{3}{x}^{3},\\,h(x)=-4\\operatorname{sin}⁡x\n$$" :multistep/steps ["step-1cdb8aa6-8ecf-556b-897d-ed5387e45285" "step-710f4f2b-0d09-5252-85a4-0e43efb200b1" "step-52c4219e-a8d2-540b-930a-53ae79e3d7aa" "step-20a1a95d-5d23-50cc-a5eb-c111e96d8376" "step-6318fb84-c369-5d02-a31f-f2cf6cab22b3" "step-50fe811b-de32-57c9-9c1e-57847199bb20" "step-770fb640-115f-5370-812e-c9a5f929df77" "step-49ad54e7-0681-59d7-bdbd-37e117d97c3e" "step-f27a5cb2-e0b1-5191-9fed-3d27d4175a6b" "step-69e93e1d-5d1a-5360-9dcc-40c766d917f2"] :multistep/first-step "step-1cdb8aa6-8ecf-556b-897d-ed5387e45285" :db/ensure [:multistep/validate]} {:db/id "step-1cdb8aa6-8ecf-556b-897d-ed5387e45285" :step/id #uuid "1cdb8aa6-8ecf-556b-897d-ed5387e45285" :step/content "question-fbda5c07-3c3f-5393-8bd3-32f9b514a1ca" :step/next "step-710f4f2b-0d09-5252-85a4-0e43efb200b1" :db/ensure [:step/validate]} {:db/id "step-710f4f2b-0d09-5252-85a4-0e43efb2