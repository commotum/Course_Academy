8a2d-cd08fa683704" :answer-field/choices ["answer-1f13dace-deeb-5459-8d06-c6c340fa8c8c" "answer-39829f81-a9cf-5068-bf86-ed19ab5065ae" "answer-85a1a928-ea1a-584e-b442-0719b4f51dbc" "answer-88b82b32-8bc8-502a-8a2d-cd08fa683704" "answer-080d06a2-ac80-5731-a0d0-206b199bf240"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f13dace-deeb-5459-8d06-c6c340fa8c8c" :answer/id #uuid "1f13dace-deeb-5459-8d06-c6c340fa8c8c" :answer/type :answer.type/math :answer/value "{log}_{1/2}⁡9=81" :db/ensure [:answer/validate]} {:db/id "answer-39829f81-a9cf-5068-bf86-ed19ab5065ae" :answer/id #uuid "39829f81-a9cf-5068-bf86-ed19ab5065ae" :answer/type :answer.type/math :answer/value "{log}_{1/9}⁡81=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-85a1a928-ea1a-584e-b442-0719b4f51dbc" :answer/id #uuid "85a1a928-ea1a-584e-b442-0719b4f51dbc" :answer/type :answer.type/math :answer/value "{log}_{2}⁡81=9" :db/ensure [:answer/validate]} {:db/id "answer-88b82b32-8bc8-502a-8a2d-cd08fa683704" :answer/id #uuid "88b82b32-8bc8-502a-8a2d-cd08fa683704" :answer/type :answer.type/math :answer/value "{log}_{81}⁡9=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-080d06a2-ac80-5731-a0d0-206b199bf240" :answer/id #uuid "080d06a2-ac80-5731-a0d0-206b199bf240" :answer/type :answer.type/math :answer/value "{log}_{9}⁡81=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-3dd9e34f-3ee0-5a42-8a59-8773ae3a745a" :question/id #uuid "3dd9e34f-3ee0-5a42-8a59-8773ae3a745a" :question/math-academy-id "q-66569" :question/problem "$\\sqrt[3]{4}≈1.587$ is equivalent to" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{4}^{1/3}≈1.587\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${4}^{1/3}≈1.587$ with $a={b}^{x},$ we get $a=1.587,b=4$ and $x=\\frac{1}{3}.$\n\nTherefore, the approximation $\\sqrt[3]{4}≈1.587$ is equivalent to ${log}_{4}⁡(1.587)≈\\frac{1}{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2d76220b-8379-56f0-b6f2-29c1efe40950"] :db/ensure [:question/validate]} {:db/id "answer-field-2d76220b-8379-56f0-b6f2-29c1efe40950" :answer-field/id #uuid "2d76220b-8379-56f0-b6f2-29c1efe40950" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-11bc61a1-c5df-575f-a750-df7c1b87d279" :answer-field/choices ["answer-44f257e1-6c2d-5a7b-b95b-d1cc1c85a226" "answer-de29e40b-df70-5eef-a11c-b501cec6c718" "answer-1036a5d2-4490-507d-98fa-001436fca0c1" "answer-11bc61a1-c5df-575f-a750-df7c1b87d279" "answer-80e8559d-f893-517b-8e0e-7cc3f3f01d21"] :db/ensure [:answer-field/validate]} {:db/id "answer-44f257e1-6c2d-5a7b-b95b-d1cc1c85a226" :answer/id #uuid "44f257e1-6c2d-5a7b-b95b-d1cc1c85a226" :answer/type :answer.type/math :answer/value "{log}_{1.587}⁡(4)≈\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-de29e40b-df70-5eef-a11c-b501cec6c718" :answer/id #uuid "de29e40b-df70-5eef-a11c-b501cec6c718" :answer/type :answer.type/math :answer/value "{log}_{1.587}⁡(\\frac{1}{3})≈4" :db/ensure [:answer/validate]} {:db/id "answer-1036a5d2-4490-507d-98fa-001436fca0c1" :answer/id #uuid "1036a5d2-4490-507d-98fa-001436fca0c1" :answer/type :answer.type/math :answer/value "{log}_{1/3}⁡(1.587)≈4" :db/ensure [:answer/validate]} {:db/id "answer-11bc61a1-c5df-575f-a750-df7c1b87d279" :answer/id #uuid "11bc61a1-c5df-575f-a750-df7c1b87d279" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(1.587)≈\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-80e8559d-f893-517b-8e0e-7cc3f3f01d21" :answer/id #uuid "80e8559d-f893-517b-8e0e-7cc3f3f01d21" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(\\frac{1}{3})≈1.587" :db/ensure [:answer/validate]} {:db/id "question-be53ea1d-fce1-50b2-b27f-f485b9e423e6" :question/id #uuid "be53ea1d-fce1-50b2-b27f-f485b9e423e6" :question/math-academy-id "q-66504" :question/problem "$\\sqrt{2}≈1.414$ can be expressed as" :question/worked-solution "Notice that the given approximation can be written using exponents as follows:\n\n$$\n{2}^{1/2}≈1.412\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{1/2}≈1.412$ with $a={b}^{x},$ we get $a=1.412,b=2$ and $x=\\frac{1}{2}.$\n\nTherefore, the approximation $\\sqrt{2}≈1.414$ can be expressed as ${log}_{2}⁡(1.414)≈\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c725419d-ab8e-5561-9557-352ac0cb53cd"] :db/ensure [:question/validate]} {:db/id "answer-field-c725419d-ab8e-5561-9557-352ac0cb53cd" :answer-field/id #uuid "c725419d-ab8e-5561-9557-352ac0cb53cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-333d8f38-b484-5b5c-869f-463a6bcb7de1" :answer-field/choices ["answer-1271b9bb-4fdb-5546-ba5d-c1a6d89b1fad" "answer-4d05961b-3847-5b4d-a042-e9b4bdb8e4d7" "answer-49d0c7ae-e60f-5aab-ae75-f8fed70ad7c1" "answer-333d8f38-b484-5b5c-869f-463a6bcb7de1" "answer-8582ee23-38f4-5200-ad88-a59804769f78"] :db/ensure [:answer-field/validate]} {:db/id "answer-1271b9bb-4fdb-5546-ba5d-c1a6d89b1fad" :answer/id #uuid "1271b9bb-4fdb-5546-ba5d-c1a6d89b1fad" :answer/type :answer.type/math :answer/value "{log}_{1.414}⁡(2)≈\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4d05961b-3847-5b4d-a042-e9b4bdb8e4d7" :answer/id #uuid "4d05961b-3847-5b4d-a042-e9b4bdb8e4d7" :answer/type :answer.type/math :answer/value "{log}_{1/2}⁡(1.414)≈2" :db/ensure [:answer/validate]} {:db/id "answer-49d0c7ae-e60f-5aab-ae75-f8fed70ad7c1" :answer/id #uuid "49d0c7ae-e60f-5aab-ae75-f8fed70ad7c1" :answer/type :answer.type/math :answer/value "{log}_{1/2}⁡(2)≈1.414" :db/ensure [:answer/validate]} {:db/id "answer-333d8f38-b484-5b5c-869f-463a6bcb7de1" :answer/id #uuid "333d8f38-b484-5b5c-869f-463a6bcb7de1" :answer/type :answer.type/math :answer/value "{log}_{2}⁡(1.414)≈\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8582ee23-38f4-5200-ad88-a59804769f78" :answer/id #uuid "8582ee23-38f4-5200-ad88-a59804769f78" :answer/type :answer.type/math :answer/value "{log}_{2}⁡(\\frac{1}{2})≈1.414" :db/ensure [:answer/validate]} {:db/id 17592186065354 :tutorial/content "A **logarithm** (or log) is an operation that's the *inverse* of exponentiation. \n\nFor example, we know that ${\\color{blue}{2}}^{\\color{red}{3}} = 8.$ But we can also write this using a logarithm as\n\n$$\n\\log_{\\color{blue}{2}}(8) = {\\color{red}{3}}.\n$$\n\nIn words, we would say \"log of $8$ with base ${\\color{blue}{2}}$ equals ${\\color{red}{3}}$\". The **base** of the logarithm is always the base of the exponential expression.\n\nSince exponents and logarithms are opposite operations, an exponential equation can always be expressed in logarithmic form, and vice versa.\n\nIn general, the logarithm of $a$ with positive base $b \\neq 1$ is defined as follows:\n\n$a = {\\color{blue}b}^{\\color{red}x}$ is equivalent to $\\log_{\\color{blue}b}{a} = {\\color{red}x}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186065351 :tutorial/content "What logarithmic equation is equivalent to the equation $\\sqrt{4} = 2 ?$\n\nNotice that the given equation can be written using exponents as\n\n$$\n4^{1/2} = 2.\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $4^{1/2} = 2$ with $a = b^x,$ we get $a = 2, b = 4,$ and $x=\\dfrac{1}{2}.$\n\nTherefore, the equation $\\sqrt{4} = 2$ is equivalent to $\\log_{4}{2}= \\dfrac{1}{2}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186064463 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186133885 :knowledge-point/questions ["question-9d632f6e-3556-5d97-834c-4e1de9c56681"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9d632f6e-3556-5d97-834c-4e1de9c56681" :question/id #uuid "9d632f6e-3556-5d97-834c-4e1de9c56681" :question/math-academy-id "q-109858" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Col}({A}^{T}+{B}^{T})$ for all compatible matrices $A$ and $B?$\n\nI. $\\text{Null}(A+B)$\n\nII. $\\text{Col}(A+B)$\n\nIII. $\\text{Null}({A}^{T}+{B}^{T})$" :question/worked-solution "Recall that $\\text{Col}({A}^{T}+{B}^{T})$ is the row space of $({A}^{T}+{B}^{T})^{T}=A+B.$ This consists of all linear combinations of the rows of $A+B.$\n\nIf a vector is orthogonal to every linear combination of the rows of $A+B,$ it must be orthogonal to each row of $A+B.$\nBut notice that when pre-multiplying a vector by $A+B,$ we actually multiply each row of $A+B$ by that vector.\nSo, $\\text{Col}({A}^{T}+{B}^{T})$ must be orthogonal to the null space of $A+B,$ which is $\\text{Null}(A+B).$\n\nTherefore, the correct answer is \"I only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/de/de22dd5b352e1d5be48f4b6ed3b2a4657ae623c1bd288d3464559758ea334af7.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ea9559f3-a3c8-59ae-9017-a04ed616a025"] :db/ensure [:question/validate]} {:db/id "answer-field-ea9559f3-a3c8-59ae-9017-a04ed616a025" :answer-field/id #uuid "ea9559f3-a3c8-59ae-9017-a04ed616a025" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd1d87ab-3668-53ac-951d-faeb38987ac2" :answer-field/choices ["answer-48ab1b2f-ec6e-507b-9701-7686776d5ac6" "answer-dd1d87ab-3668-53ac-951d-faeb38987ac2" "answer-4b89e055-2ad7-5945-ba06-41fd9a844ae2" "answer-5279f1a0-7964-5e07-bb5f-5a1cc2249ed2" "answer-a13c9b82-7a72-5392-b4b2-9e4a90902573"] :db/ensure [:answer-field/validate]} {:db/id "answer-48ab1b2f-ec6e-507b-9701-7686776d5ac6" :answer/id #uuid "48ab1b2f-ec6e-507b-9701-7686776d5ac6" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-dd1d87ab-3668-53ac-951d-faeb38987ac2" :answer/id #uuid "dd1d87ab-3668-53ac-951d-faeb38987ac2" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4b89e055-2ad7-5945-ba06-41fd9a844ae2" :answer/id #uuid "4b89e055-2ad7-5945-ba06-41fd9a844ae2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5279f1a0-7964-5e07-bb5f-5a1cc2249ed2" :answer/id #uuid "5279f1a0-7964-5e07-bb5f-5a1cc2249ed2" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-a13c9b82-7a72-5392-b4b2-9e4a90902573" :answer/id #uuid "a13c9b82-7a72-5392-b4b2-9e4a90902573" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186133887 :knowledge-point/questions ["question-5241b6a1-96aa-5720-ba1b-4d884df832da"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5241b6a1-96aa-5720-ba1b-4d884df832da" :question/id #uuid "5241b6a1-96aa-5720-ba1b-4d884df832da" :question/math-academy-id "q-109877" :question/problem "Consider a $3\\times 2$ matrix $A.$ If $\\text{dim}(\\text{Col}({A}^{T}))=2,$ then $\\text{dim}(\\text{Null}(A))=$" :question/worked-solution "The four fundamental subspaces of a matrix $A$ can be schematically visualized, as shown below.\n\n![](images/88/889b83fadd26b377c4dd34143c9b16541630c04e90de3d9b005e7147ead75ad5.png)\n\nIn our case, we are given that $m=3,$ $n=2,$ and $r=2.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{dim}(\\text{Null}(A)) & =n-r=2-2=0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-27448a27-2ab1-5f66-ac78-eb27dc883118"] :db/ensure [:question/validate]} {:db/id "answer-field-27448a27-2ab1-5f66-ac78-eb27dc883118" :answer-field/id #uuid "27448a27-2ab1-5f66-ac78-eb27dc883118" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0ffd03e5-d22d-5766-a803-65f19cfd5c3b" :answer-field/choices ["answer-0ffd03e5-d22d-5766-a803-65f19cfd5c3b" "answer-e4975b80-f61d-5eb9-898f-fe70609d075c" "answer-568a861a-1250-5245-9ac3-b13ddd599d76" "answer-afc78170-0f40-51ef-9a2e-a8c37ba5fad6" "answer-407da24d-3379-5bc7-b2ac-f9a5576feabc"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ffd03e5-d22d-5766-a803-65f19cfd5c3b" :answer/id #uuid "0ffd03e5-d22d-5766-a803-65f19cfd5c3b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-e4975b80-f61d-5eb9-898f-fe70609d075c" :answer/id #uuid "e4975b80-f61d-5eb9-898f-fe70609d075c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-568a861a-1250-5245-9ac3-b13ddd599d76" :answer/id #uuid "568a861a-1250-5245-9ac3-b13ddd599d76" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-afc78170-0f40-51ef-9a2e-a8c37ba5fad6" :answer/id #uuid "afc78170-0f40-51ef-9a2e-a8c37ba5fad6" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-407da24d-3379-5bc7-b2ac-f9a5576feabc" :answer/id #uuid "407da24d-3379-5bc7-b2ac-f9a5576feabc" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "activity-ddb5d27f-6cfa-5d9a-8baa-a423632644e2" :activity/id #uuid "ddb5d27f-6cfa-5d9a-8baa-a423632644e2" :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type :activity.type/review :activity/scope 17592186049881 :activity/course 17592186046644 :activity/steps ["step-14c1aa12-7e87-5b1e-9c66-6bd7f1359f4f" "step-56314e20-2366-500d-aee8-f1badacd2314" "step-2df8d215-4169-5ff0-96f8-b514b08b3eb0" "step-78d36b97-fb9f-562b-a664-3f90af4e59df" "step-bc095201-9245-5703-95d0-69f9cc120dd7"] :activity/first-step "step-14c1aa12-7e87-5b1e-9c66-6bd7f1359f4f" :db/ensure [:activity/validate]} {:db/id "step-14c1aa12-7e87-5b1e-9c66-6bd7f1359f4f" :step/id #uuid "14c1aa12-7e87-5b1e-9c66-6bd7f1359f4f" :step/content 17592186407245 :step/next "step-56314e20-2366-500d-aee8-f1badacd2314" :db/ensure [:step/validate]} {:db/id "step-56314e20-2366-500d-aee8-f1badacd2314" :step/id #uuid "56314e20-2366-500d-aee8-f1badacd2314" :step/content "question-9d632f6e-3556-5d97-834c-4e1de9c56681" :step/next "step-2df8d215-4169-5ff0-96f8-b514b08b3eb0" :db/ensure [:step/validate]} {:db/id "step-2df8d215-4169-5ff0-96f8-b514b08b3eb0" :step/id #uuid "2df8d215-4169-5ff0-96f8-b514b08b3eb0" :step/content 17592186362770 :step/next "step-78d36b97-fb9f-562b-a664-3f90af4e59df" :db/ensure [:step/validate]} {:db/id "step-78d36b97-fb9f-562b-a664-3f90af4e59df" :step/id #uuid "78d36b97-fb9f-562b-a664-3f90af4e59df" :step/content 17592186407244 :step/next "step-bc095201-9245-5703-95d0-69f9cc120dd7" :db/ensure [:step/validate]} {:db/id "step-bc095201-9245-5703-95d0-69f9cc120dd7" :step/id #uuid "bc095201-9245-5703-95d0-69f9cc120dd7" :step/content "question-5241b6a1-96aa-5720-ba1b-4d884df832da" :db/ensure [:step/validate]} [:db/retract 17592186067000 :answer-field/choices 17592186067001] [:db/retract 17592186067000 :answer-field/choices 17592186067002] [:db/retract 17592186067000 :answer-field/choices 17592186067003] [:db/retract 17592186067000 :answer-field/choices 17592186067004] [:db/retract 17592186067000 :answer-field/choices 17592186067005] {:db/id 17592186068749 :knowledge-point/questions ["question-01d0ba8c-f3fb-52e6-bc68-8e1659694309"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068582 :question/problem "Is $x=3$ a root of the polynomial $2x^3+8x^2-2x-8?$" :question/worked-solution "Substituting $3$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\eqalign{\n\t\t2(3)^3+8(3)^2-2(3)-8 &= \\\n\t\t2(27)+8(9)-6-8 &= \\\n\t\t54+72-14 &= \\\n\t\t112\n\t}\n$$\n\nThe polynomial does *not* equal $0$ when $3$ is substituted for $x.$\n\nTherefore, $3$ is *not* a root." :db/ensure [:question/validate]} {:db/id 17592186068750 :knowledge-point/questions ["question-6dc4cf16-d154-5217-ba51-01445eca1e9d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068583 :question/problem "Find $p$ if $3$ is a root of $x^3-3x+p.$" :question/worked-solution "Since $x=3$ is a root, we have $f(3)=0.$ Therefore, we can evaluate the polynomial at $x=3,$ set it equal to $0,$ and solve the equation for the parameter $p\\mathbin{:}$\n\n$$\n\\begin{aligned}(3)^{3}-3(3)+p & =0 \\\\ 27-9+p & =0 \\\\ p & =-18\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-01d0ba8c-f3fb-52e6-bc68-8e1659694309" :question/id #uuid "01d0ba8c-f3fb-52e6-bc68-8e1659694309" :question/math-academy-id "q-114096" :question/problem "Which of the following is **NOT** a root of the polynomial ${x}^{3}-{x}^{2}-21x+45?$\n\nI. $x=3$\n\nII. $x=4$\n\nIII. $x=5$" :question/worked-solution "- Substituting $3$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}{3}^{3}-{3}^{2}-21(3)+45 & = \\\\ 27-9-63+45 & = \\\\ 0\\end{aligned}\n$$\n\nThe polynomial is $0$ when $3$ is substituted for $x.$ Therefore, $3$ is a root.\n\n- Substituting $4$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}{4}^{3}-{4}^{2}-21(4)+45 & = \\\\ 64-16-84+45 & = \\\\ 9\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $4$ is substituted for $x.$ Therefore, $4$ is *not*  a root.\n\n- Substituting $5$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}{5}^{3}-{5}^{2}-21(5)+45 & = \\\\ 125-25-105+45 & = \\\\ 40\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $5$ is substituted for $x.$ Therefore, $5$ is *not*  a root.\n\nTherefore, the values that are *not* roots are $x=4$ and $x=5,$ so the correct answer is \"II and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-973ef37b-f85d-515c-b5ff-cf8e3417a87e"] :db/ensure [:question/validate]} {:db/id "answer-field-973ef37b-f85d-515c-b5ff-cf8e3417a87e" :answer-field/id #uuid "973ef37b-f85d-515c-b5ff-cf8e3417a87e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e3d73040-b6a3-590a-8f1a-f21f92d2e834" :answer-field/choices ["answer-26aca2b6-27fd-5137-9f5a-b761d0340f16" "answer-bfaf3574-1d71-5d97-bc40-fa0a286b8c0d" "answer-e3d73040-b6a3-590a-8f1a-f21f92d2e834" "answer-fed866e1-3125-5187-99bc-41e67b687920" "answer-c90944c5-320d-596d-8f3d-d4daa4e170c5"] :db/ensure [:answer-field/validate]} {:db/id "answer-26aca2b6-27fd-5137-9f5a-b761d0340f16" :answer/id #uuid "26aca2b6-27fd-5137-9f5a-b761d0340f16" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-bfaf3574-1d71-5d97-bc40-fa0a286b8c0d" :answer/id #uuid "bfaf3574-1d71-5d97-bc40-fa0a286b8c0d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e3d73040-b6a3-590a-8f1a-f21f92d2e834" :answer/id #uuid "e3d73040-b6a3-590a-8f1a-f21f92d2e834" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-fed866e1-3125-5187-99bc-41e67b687920" :answer/id #uuid "fed866e1-3125-5187-99bc-41e67b687920" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c90944c5-320d-596d-8f3d-d4daa4e170c5" :answer/id #uuid "c90944c5-320d-596d-8f3d-d4daa4e170c5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186069316 :question/problem "Which of the following is **NOT** a root of the polynomial ${x}^{4}-13{x}^{2}+36?$\n\nI. $x=4$\n\nII. $x=2$\n\nIII. $x=-4$" :question/worked-solution "- Substituting $4$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}{4}^{4}-13(4)^{2}+36 & = \\\\ 256-13(16)+36 & = \\\\ 256-208+36 & = \\\\ 84\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $4$ is substituted for $x.$ Therefore, $4$ is *not*  a root.\n\n- Substituting $2$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}{2}^{4}-13(2)^{2}+36 & = \\\\ 16-13(4)+36 & = \\\\ 16-52+36 & = \\\\ 0\\end{aligned}\n$$\n\nThe polynomial is $0$ when $2$ is substituted for $x.$ Therefore, $2$ is a root.\n\n- Substituting $-4$ for $x$ in the polynomial and evaluating, we get the following result:\n\n$$\n\\begin{aligned}(-4)^{4}-13(-4)^{2}+36 & = \\\\ 256-13(16)+36 & = \\\\ 256-208+36 & = \\\\ 84\\end{aligned}\n$$\n\nThe polynomial does *not* equal $0$ when $-4$ is substituted for $x.$ Therefore, $-4$ is *not*  a root.\n\nTherefore, the values that are *not* roots are $x=4$ and $x=-4,$ so the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186067066 :answer-field/correct 17592186067070 :db/ensure [:answer-field/validate]} {:db/id 17592186069305 :question/problem "Find $a$ if $-2$ is a root of ${x}^{4}+a{x}^{3}-11{x}^{2}+60x+100.$" :question/worked-solution "Since  $x=-2$ is a root, we have $f(-2)=0.$ Therefore, we can evaluate the polynomial at $x=-2,$ set it equal to $0,$ and solve the equation for the parameter $a:$\n\n$$\n\\begin{aligned}(-2)^{4}+a(-2)^{3}-11(-2)^{2}+60(-2)+100 & =0 \\\\ 16-8a-44-120+100 & =0 \\\\ -8a-48 & =0 \\\\ -8a & =48 \\\\ a & =-6\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186067000 :answer-field/correct "answer-fae75ffa-784f-514f-a697-d19f80fd75b3" :answer-field/choices ["answer-fae75ffa-784f-514f-a697-d19f80fd75b3" "answer-1c26992c-eeda-521a-91c1-51ff8ccc188a" "answer-8f8f7c9e-2f92-5ee6-b16c-88a200fa7761" "answer-6113f01d-038a-5ec5-b1bc-33c2dc4ce6db" "answer-a6c1d10e-3180-570f-b6a8-67238002e359"] :db/ensure [:answer-field/validate]} {:db/id "answer-fae75ffa-784f-514f-a697-d19f80fd75b3" :answer/id #uuid "fae75ffa-784f-514f-a697-d19f80fd75b3" :answer/type :answer.type/math :answer/value "a=-6" :db/ensure [:answer/validate]} {:db/id "answer-1c26992c-eeda-521a-91c1-51ff8ccc188a" :answer/id #uuid "1c26992c-eeda-521a-91c1-51ff8ccc188a" :answer/type :answer.type/math :answer/value "a=-8" :db/ensure [:answer/validate]} {:db/id "answer-8f8f7c9e-2f92-5ee6-b16c-88a200fa7761" :answer/id #uuid "8f8f7c9e-2f92-5ee6-b16c-88a200fa7761" :answer/type :answer.type/math :answer/value "a=48" :db/ensure [:answer/validate]} {:db/id "answer-6113f01d-038a-5ec5-b1bc-33c2dc4ce6db" :answer/id #uuid "6113f01d-038a-5ec5-b1bc-33c2dc4ce6db" :answer/type :answer.type/math :answer/value "a=6" :db/ensure [:answer/validate]} {:db/id "answer-a6c1d10e-3180-570f-b6a8-67238002e359" :answer/id #uuid "a6c1d10e-3180-570f-b6a8-67238002e359" :answer/type :answer.type/math :answer/value "a=8" :db/ensure [:answer/validate]} {:db/id "question-6dc4cf16-d154-5217-ba51-01445eca1e9d" :question/id #uuid "6dc4cf16-d154-5217-ba51-01445eca1e9d" :question/math-academy-id "q-14001" :question/problem "Find $p$ if $5$ is a root of $f(x)=6{x}^{2}+4px-10.$" :question/worked-solution "Since  $x=5$ is a root, we have $f(5)=0.$ Therefore, we can evaluate the polynomial at $x=5,$ set it equal to $0,$ and solve the equation for the parameter $p:$\n\n$$\n\\begin{aligned}6(5)^{2}+4p(5)-10 & =0 \\\\ 6(25)+20p-10 & =0 \\\\ 150+20p-10 & =0 \\\\ 140+20p & =0 \\\\ 20p & =-140 \\\\ p & =-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ee58cba8-ea3f-5e96-a12e-8748931de619"] :db/ensure [:question/validate]} {:db/id "answer-field-ee58cba8-ea3f-5e96-a12e-8748931de619" :answer-field/id #uuid "ee58cba8-ea3f-5e96-a12e-8748931de619" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a5f3c4e-7117-5231-97ac-d46e036354a1" :answer-field/choices ["answer-43ca2c7d-d240-55ed-8330-bebe574fc9f4" "answer-4a5f3c4e-7117-5231-97ac-d46e036354a1" "answer-75caf8e3-d457-5667-b62f-35a6de77d769" "answer-f8d013c3-4d16-528c-96a4-cec120511278" "answer-cf097d6d-7e5d-5696-967e-7db28b75519d"] :db/ensure [:answer-field/validate]} {:db/id "answer-43ca2c7d-d240-55ed-8330-bebe574fc9f4" :answer/id #uuid "43ca2c7d-d240-55ed-8330-bebe574fc9f4" :answer/type :answer.type/math :answer/value "p=-11" :db/ensure [:answer/validate]} {:db/id "answer-4a5f3c4e-7117-5231-97ac-d46e036354a1" :answer/id #uuid "4a5f3c4e-7117-5231-97ac-d46e036354a1" :answer/type :answer.type/math :answer/value "p=-7" :db/ensure [:answer/validate]} {:db/id "answer-75caf8e3-d457-5667-b62f-35a6de77d769" :answer/id #uuid "75caf8e3-d457-5667-b62f-35a6de77d769" :answer/type :answer.type/math :answer/value "p=-8" :db/ensure [:answer/validate]} {:db/id "answer-f8d013c3-4d16-528c-96a4-cec120511278" :answer/id #uuid "f8d013c3-4d16-528c-96a4-cec120511278" :answer/type :answer.type/math :answer/value "p=2" :db/ensure [:answer/validate]} {:db/id "answer-cf097d6d-7e5d-5696-967e-7db28b75519d" :answer/id #uuid "cf097d6d-7e5d-5696-967e-7db28b75519d" :answer/type :answer.type/math :answer/value "p=8" :db/ensure [:answer/validate]} {:db/id 17592186069968 :tutorial/content "A **root** of a polynomial is a value that will make the polynomial equal zero when substituted for the polynomial's variable.\n\nFor example, consider the polynomial $x^2-9.$ This polynomial has two roots, $x=3$ and $x=-3,$ because the polynomial evaluates to $0$ when either of these values is substituted for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x=3\\,⇒\\,{x}^{2}-9 & = \\\\ (3)^{2}-9 & = \\\\ 9-9 & = \\\\ 0 & \\,✓ \\\\ x=-3\\,⇒\\,{x}^{2}-9 & = \\\\ (-3)^{2}-9 & = \\\\ 9-9 & = \\\\ 0 & \\,✓\\end{aligned}\n$$\n\nOn the other hand, a number like $x=1$ is *not* a root of the polynomial because the polynomial does not evaluate to $0$ when this value is substituted for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}x=1\\,⇒\\,{x}^{2}-9 & = \\\\ (1)^{2}-9 & = \\\\ 1-9 & = \\\\ -8 & \\,\\times \\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186069969 :tutorial/content "A **parametric polynomial** is a polynomial in which one of the coefficients is itself represented as another variable.\n\nFor example, the polynomial below is a parametric polynomial:\n\n$$\nf(x)=2x^2 -px\n$$\n\nHere, $p$ is a **parameter**,  which means that it corresponds to a certain constant value. Unlike the variable $x,$ the parameter is treated exactly like any other coefficient. It's only special in that we don't know its numerical value.\n\nIf we're given the root of a polynomial, we can find the numerical value of a parameter. Let's say, for instance, that a root of the above polynomial is $x=1.$ This means that the polynomial is zero for that value:\n\n$$\nf(1)=0\n$$\n\nTherefore, we can evaluate the polynomial at $x=1,$ set it equal to $0,$ and solve the equation for the parameter $p\\mathbin{:}$\n\n$$\n\\begin{aligned}f(1) & =0 \\\\ 2(1)^{2}-p(1) & =0 \\\\ 2-p & =0 \\\\ p & =2\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186068994 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} [:db/retract 17592186164942 :answer-field/choices 17592186164944] [:db/retract 17592186164942 :answer-field/choices 17592186164945] [:db/retract 17592186164942 :answer-field/choices 17592186164946] [:db/retract 17592186164942 :answer-field/choices 17592186164947] [:db/retract 17592186164942 :answer-field/choices 17592186164943] {:db/id 17592186167287 :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-5x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$\n\n$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-5x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=-\\frac{10}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =-\\frac{10}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =-\\frac{10}{\\pi }(\\frac{1}{n}[x\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =-\\frac{10}{n\\pi }((\\pi \\cdot \\operatorname{sin}⁡(n\\pi )-0\\cdot \\operatorname{sin}⁡(0))+\\frac{1}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =-\\frac{10}{n\\pi }(0+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{10(1-\\operatorname{cos}⁡(n\\pi ))}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{10(1-(-1)^{n})}{\\pi {n}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164942 :answer-field/correct "answer-6d8b9a94-844b-5230-8dbb-b4c344711de3" :answer-field/choices ["answer-c7e08bad-7124-5ce3-a617-6b90238949c8" "answer-6d8b9a94-844b-5230-8dbb-b4c344711de3" "answer-b5a680c6-0157-5a05-94c1-5c01714f6875" "answer-f337a419-32eb-5a19-8398-32003a3095f3" "answer-b99d012c-5ec1-5e92-a060-6a3e721a6f80"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7e08bad-7124-5ce3-a617-6b90238949c8" :answer/id #uuid "c7e08bad-7124-5ce3-a617-6b90238949c8" :answer/type :answer.type/math :answer/value "\\frac{10(1+(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "answer-6d8b9a94-844b-5230-8dbb-b4c344711de3" :answer/id #uuid "6d8b9a94-844b-5230-8dbb-b4c344711de3" :answer/type :answer.type/math :answer/value "\\frac{10(1-(-1)^{n})}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-b5a680c6-0157-5a05-94c1-5c01714f6875" :answer/id #uuid "b5a680c6-0157-5a05-94c1-5c01714f6875" :answer/type :answer.type/math :answer/value "\\frac{2(1-(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "answer-f337a419-32eb-5a19-8398-32003a3095f3" :answer/id #uuid "f337a419-32eb-5a19-8398-32003a3095f3" :answer/type :answer.type/math :answer/value "\\frac{5(1+(-1)^{n})}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-b99d012c-5ec1-5e92-a060-6a3e721a6f80" :answer/id #uuid "b99d012c-5ec1-5e92-a060-6a3e721a6f80" :answer/type :answer.type/math :answer/value "\\frac{5(1-(-1)^{n})}{4\\pi n}" :db/ensure [:answer/validate]} {:db/id 17592186166958 :knowledge-point/questions ["question-26db2697-717d-50e6-ae97-51a48de209b3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186314636 :answer-field/correct "answer-90e13064-1840-57e2-82c0-fd9d4a429d06" :answer-field/choices ["answer-90e13064-1840-57e2-82c0-fd9d4a429d06"] :db/ensure [:answer-field/validate]} {:db/id "answer-90e13064-1840-57e2-82c0-fd9d4a429d06" :answer/id #uuid "90e13064-1840-57e2-82c0-fd9d4a429d06" :answer/type :answer.type/math :answer/value "-\\frac{3}{\\pi}" :db/ensure [:answer/validate]} {:db/id "question-26db2697-717d-50e6-ae97-51a48de209b3" :question/id #uuid "26db2697-717d-50e6-ae97-51a48de209b3" :question/math-academy-id "q-341279" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=8{x}^{2}+3$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=8{x}^{2}+3$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(8{x}^{2}+3)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[\\frac{8{x}^{3}}{3}+3x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(\\frac{8{\\pi }^{3}}{3}+3\\pi )-0 \\\\  & =2(\\frac{8{\\pi }^{2}}{3}+3).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cb950154-2aa3-5ddf-9f65-38fa15780a80"] :db/ensure [:question/validate]} {:db/id "answer-field-cb950154-2aa3-5ddf-9f65-38fa15780a80" :answer-field/id #uuid "cb950154-2aa3-5ddf-9f65-38fa15780a80" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-89f23f80-b8ac-5ae5-88f7-06c168735fcb" :answer-field/choices ["answer-89f23f80-b8ac-5ae5-88f7-06c168735fcb"] :db/ensure [:answer-field/validate]} {:db/id "answer-89f23f80-b8ac-5ae5-88f7-06c168735fcb" :answer/id #uuid "89f23f80-b8ac-5ae5-88f7-06c168735fcb" :answer/type :answer.type/math :answer/value "2(\\frac{8{\\pi }^{2}}{3}+3)" :db/ensure [:answer/validate]} {:db/id 17592186314680 :answer-field/correct "answer-b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer-field/choices ["answer-b2388473-f7b4-5371-bdaf-2f5d22ad6092"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer/id #uuid "b2388473-f7b4-5371-bdaf-2f5d22ad6092" :answer/type :answer.type/math :answer/value "\\frac{4(\\sqrt{2}-2)}{\\pi}" :db/ensure [:answer/validate]} {:db/id "activity-8229b7db-f15f-558a-b67e-bb5853ab5391" :activity/id #uuid "8229b7db-f15f-558a-b67e-bb5853ab5391" :activity/title "Fourier Cosine Series" :activity/type :activity.type/review :activity/scope 17592186048344 :activity/course 17592186046644 :activity/steps ["step-f37eaecf-ceca-5b8a-8da1-959b745cbf01" "step-1fefaa6c-96e4-5e0c-9b62-f9a44f298e46" "step-b1aa6535-b004-55a7-a4a7-b78abf7554a6" "step-1302a897-b488-5761-8180-38c3d3c896d9" "step-d6edea3f-3c0e-5cad-bbff-2b7a637b5929"] :activity/first-step "step-f37eaecf-ceca-5b8a-8da1-959b745cbf01" :db/ensure [:activity/validate]} {:db/id "step-f37eaecf-ceca-5b8a-8da1-959b745cbf01" :step/id #uuid "f37eaecf-ceca-5b8a-8da1-959b745cbf01" :step/content 17592186167287 :step/next "step-1fefaa6c-96e4-5e0c-9b62-f9a44f298e46" :db/ensure [:step/validate]} {:db/id "step-1fefaa6c-96e4-5e0c-9b62-f9a44f298e46" :step/id #uuid "1fefaa6c-96e4-5e0c-9b62-f9a44f298e46" :step/content 17592186167290 :step/next "step-b1aa6535-b004-55a7-a4a7-b78abf7554a6" :db/ensure [:step/validate]} {:db/id "step-b1aa6535-b004-55a7-a4a7-b78abf7554a6" :step/id #uuid "b1aa6535-b004-55a7-a4a7-b78abf7554a6" :step/content 17592186315077 :step/next "step-1302a897-b488-5761-8180-38c3d3c896d9" :db/ensure [:step/validate]} {:db/id "step-1302a897-b488-5761-8180-38c3d3c896d9" :step/id #uuid "1302a897-b488-5761-8180-38c3d3c896d9" :step/content "question-26db2697-717d-50e6-ae97-51a48de209b3" :step/next "step-d6edea3f-3c0e-5cad-bbff-2b7a637b5929" :db/ensure [:step/validate]} {:db/id "step-d6edea3f-3c0e-5cad-bbff-2b7a637b5929" :step/id #uuid "d6edea3f-3c0e-5cad-bbff-2b7a637b5929" :step/content 17592186315080 :db/ensure [:step/validate]} [:db/retract 17592186189688 :answer-field/choices 17592186189689] [:db/retract 17592186189688 :answer-field/choices 17592186189690] [:db/retract 17592186189688 :answer-field/choices 17592186189691] [:db/retract 17592186189688 :answer-field/choices 17592186189692] [:db/retract 17592186189688 :answer-field/choices 17592186189693] [:db/retract 17592186189676 :answer-field/choices 17592186189680] [:db/retract 17592186189676 :answer-field/choices 17592186189681] [:db/retract 17592186189676 :answer-field/choices 17592186189677] [:db/retract 17592186189676 :answer-field/choices 17592186189678] [:db/retract 17592186189676 :answer-field/choices 17592186189679] {:db/id 17592186192696 :knowledge-point/questions ["question-e7322fc5-138d-596a-9e83-0b51cc3f5715" "question-b0942e9b-0d31-57a8-9f11-cdccb8f6633f" "question-95e787d7-1400-508c-9805-e2c36a0d2bcb" "question-09aebc44-422b-52f7-a02d-eaf1743e7ebe"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192401 :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n![](images/78/7839eb7b2cfa2511661a6f2822930cd54ef4c3f2cb7df53448af61bdb7f63766.svg)\nFind the second principal component of the data, given that the eigenvalues of $C$ are $16$ and $6.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n\\lambda_1 \\gt \\lambda_2 \\gt \\cdots\\gt \\lambda_n\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector $\\mathbf u_1$ corresponding to the $1$st eigenvalue $\\lambda_1,$\n\n- the $2$nd principal component is the unit eigenvector $\\mathbf u_2$ corresponding to the $2$nd eigenvalue $\\lambda_2,$\n\n- $\\cdots$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are $\\lambda_1=16$ and $\\lambda_2=6.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue $\\lambda_2=6{:}$\n\nApplying our usual algorithm for finding eigenvectors, we have\n\n$$\n\\begin{aligned}C-6I & =[\\begin{aligned}7 & 3 \\\\ 3 & 15\\end{aligned}]-6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-6I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](images/e5/e5ce684566df94e2d3691bb3fd75b78e46bbfe20bc3ed037618175c619cbe89a.svg) \n\nFinally, dividing $\\mathbf{v}_2$ by its norm $\\| \\mathbf{v}_2 \\| = \\sqrt{10},$ we get \n\n![](images/10/10818d19ffec73c77257977086f97924f8c3ff35fdb4cb46a1a84fa243bbcdbb.svg) \n\nTherefore, the second principal component of the data is ![](images/3c/3cfd9b938a757c8e5b06ebf426b71e0439175e862da98ac7e65e74ee413f2d68.svg)" :db/ensure [:question/validate]} {:db/id 17592186192681 :knowledge-point/questions ["question-5374b353-43b9-56d5-bf37-798eca076a47" "question-30659c57-f541-5ec5-857d-e24511eb8172" "question-5ddc6be0-7f0e-552b-88a6-224cbf5ee88c" "question-1dfd23ff-dd1b-5e4d-b783-10b5e0f038d4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186192623 :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n![](images/f5/f51f3460981ca243627f1873a24fa3a50a43275bebdb20c1ced5d64215c71618.svg)\nFind the first principal component of the data, given that the eigenvalues of $S$ are $8,$ $5,$ and $2.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n\\lambda_1 \\gt \\lambda_2 \\gt \\cdots\\gt \\lambda_n\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector $u_1$ corresponding to the $1$st eigenvalue $\\lambda_1,$\n\n- the $2$nd principal component is the unit eigenvector $u_2$ corresponding to the $2$nd eigenvalue $\\lambda_2,$\n\n- $\\cdots$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are \n\n$$\n\\lambda_1=8,\\qquad\n\\lambda_2=5,\\qquad\n\\lambda_3=2.\n$$\n\nSo, we need the unit eigenvector that corresponds to the eigenvalue $\\lambda_1=8{:}$\n\nApplying our usual algorithm for finding eigenvectors, we have\n\n$$\n\\begin{aligned}C-8I & =[\\begin{aligned}5 & 2 & 2 \\\\ 2 & 6 & 0 \\\\ 2 & 0 & 4\\end{aligned}]-8[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-3 & 2 & 2 \\\\ 2 & -2 & 0 \\\\ 2 & 0 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-8I)\\mathbf{x}=\\mathbf{0}$ gives the eigenvector ![](images/eb/eb25f50c2550e470fcdffd1c94a5ff2134043ac34b6a75b14e2ce00d1936a2e8.svg) \n\nFinally, dividing $\\mathbf{v}_1$ by its norm $\\| \\mathbf{v}_1 \\| =3,$ we get \n\n![](images/92/920ccfb9953cf4e17f89b01a1f5512f8c0bbcc368f9af1770f768c1e258127e5.svg) \n\nTherefore, the first principal component of the data is ![](images/0c/0c20bbbce9a9014103e94d0f8b055f6dfec18672f2b313d46b1799d9402f755a.svg)" :db/ensure [:question/validate]} {:db/id "question-e7322fc5-138d-596a-9e83-0b51cc3f5715" :question/id #uuid "e7322fc5-138d-596a-9e83-0b51cc3f5715" :question/math-academy-id "q-138505" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]\n$$\n\nFind the first principal component of the data, given that the eigenvalues of $C$ are $4$ and $2.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=2.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{1}=4:$\n\n$$\n\\begin{aligned}C-4I & =[\\begin{aligned}3 & -1 \\\\ -1 & 3\\end{aligned}]-4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ -1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-4I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ -1\\end{aligned}].$ \n\nFinally, dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-50f8a878-942e-5a59-993e-ff2e07b1ea9e"] :db/ensure [:question/validate]} {:db/id "answer-field-50f8a878-942e-5a59-993e-ff2e07b1ea9e" :answer-field/id #uuid "50f8a878-942e-5a59-993e-ff2e07b1ea9e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1fa9504b-805c-5abe-a81a-22e86efad5cc" :answer-field/choices ["answer-630b44dc-a913-5dc9-9613-2dda312da9f7" "answer-1fa9504b-805c-5abe-a81a-22e86efad5cc" "answer-03883e00-ff01-5a79-b12f-032b887736a8" "answer-058a06a8-4305-5b98-8e52-81f40a72b383" "answer-51578d0d-37f6-594d-8ac9-09733a9ba993"] :db/ensure [:answer-field/validate]} {:db/id "answer-630b44dc-a913-5dc9-9613-2dda312da9f7" :answer/id #uuid "630b44dc-a913-5dc9-9613-2dda312da9f7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1fa9504b-805c-5abe-a81a-22e86efad5cc" :answer/id #uuid "1fa9504b-805c-5abe-a81a-22e86efad5cc" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-03883e00-ff01-5a79-b12f-032b887736a8" :answer/id #uuid "03883e00-ff01-5a79-b12f-032b887736a8" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-058a06a8-4305-5b98-8e52-81f40a72b383" :answer/id #uuid "058a06a8-4305-5b98-8e52-81f40a72b383" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-51578d0d-37f6-594d-8ac9-09733a9ba993" :answer/id #uuid "51578d0d-37f6-594d-8ac9-09733a9ba993" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186192967 :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}3 & 3 \\\\ 3 & 11\\end{aligned}]\n$$\n\nFind the second principal component of the data, given that the eigenvalues of $C$ are $12$ and $2.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=12$ and ${\\lambda }_{2}=2.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{2}=2:$\n\n$$\n\\begin{aligned}C-2I & =[\\begin{aligned}3 & 3 \\\\ 3 & 11\\end{aligned}]-2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-2I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{10},$ we get \n\n$$\n{u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186189688 :answer-field/correct "answer-77c2fdcd-3cfd-5138-b031-10ea6cb25796" :answer-field/choices ["answer-d2934599-3ad3-591c-91b5-c462470674f0" "answer-77c2fdcd-3cfd-5138-b031-10ea6cb25796" "answer-a7ae3c3a-bf66-58f6-85cd-2aa0368d5c16" "answer-4c15a98b-50e4-52bd-a670-8083176f53dd" "answer-0f6874ad-3005-516e-a0ad-5cb17e1bb218"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2934599-3ad3-591c-91b5-c462470674f0" :answer/id #uuid "d2934599-3ad3-591c-91b5-c462470674f0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-77c2fdcd-3cfd-5138-b031-10ea6cb25796" :answer/id #uuid "77c2fdcd-3cfd-5138-b031-10ea6cb25796" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-a7ae3c3a-bf66-58f6-85cd-2aa0368d5c16" :answer/id #uuid "a7ae3c3a-bf66-58f6-85cd-2aa0368d5c16" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-4c15a98b-50e4-52bd-a670-8083176f53dd" :answer/id #uuid "4c15a98b-50e4-52bd-a670-8083176f53dd" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{13}}[\\begin{aligned}-2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0f6874ad-3005-516e-a0ad-5cb17e1bb218" :answer/id #uuid "0f6874ad-3005-516e-a0ad-5cb17e1bb218" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{13}}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-b0942e9b-0d31-57a8-9f11-cdccb8f6633f" :question/id #uuid "b0942e9b-0d31-57a8-9f11-cdccb8f6633f" :question/math-academy-id "q-149394" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}4 & -1 \\\\ -1 & 4\\end{aligned}]\n$$\n\nFind the second principal component of the data, given that the eigenvalues of $C$ are $3$ and $5.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=3.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{2}=3:$\n\n$$\n\\begin{aligned}C-3I & =[\\begin{aligned}4 & -1 \\\\ -1 & 4\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-3I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n{u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bea2c098-2097-5099-aac0-424265525110"] :db/ensure [:question/validate]} {:db/id "answer-field-bea2c098-2097-5099-aac0-424265525110" :answer-field/id #uuid "bea2c098-2097-5099-aac0-424265525110" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-945c5bc7-5ccf-5b4a-bde4-380d4ac4c181" :answer-field/choices ["answer-ab40b264-d780-5195-bc0e-37cb9d9e8ec0" "answer-945c5bc7-5ccf-5b4a-bde4-380d4ac4c181" "answer-b6a7ebc7-af9f-5d77-95c6-d1fe1ed9b95b" "answer-aa993c7c-1cd0-5503-b565-272b278aefff" "answer-74cfacbf-672e-527e-bbbc-6ea56e5d2316"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab40b264-d780-5195-bc0e-37cb9d9e8ec0" :answer/id #uuid "ab40b264-d780-5195-bc0e-37cb9d9e8ec0" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-945c5bc7-5ccf-5b4a-bde4-380d4ac4c181" :answer/id #uuid "945c5bc7-5ccf-5b4a-bde4-380d4ac4c181" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b6a7ebc7-af9f-5d77-95c6-d1fe1ed9b95b" :answer/id #uuid "b6a7ebc7-af9f-5d77-95c6-d1fe1ed9b95b" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-aa993c7c-1cd0-5503-b565-272b278aefff" :answer/id #uuid "aa993c7c-1cd0-5503-b565-272b278aefff" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-74cfacbf-672e-527e-bbbc-6ea56e5d2316" :answer/id #uuid "74cfacbf-672e-527e-bbbc-6ea56e5d2316" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-95e787d7-1400-508c-9805-e2c36a0d2bcb" :question/id #uuid "95e787d7-1400-508c-9805-e2c36a0d2bcb" :question/math-academy-id "q-149395" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}8 & 3 \\\\ 3 & 16\\end{aligned}]\n$$\n\nFind the second principal component of the data, given that the eigenvalues of $C$ are $17$ and $7.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=17$ and ${\\lambda }_{2}=7.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{2}=7:$\n\n$$\n\\begin{aligned}C-7I & =[\\begin{aligned}8 & 3 \\\\ 3 & 16\\end{aligned}]-7[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 3 \\\\ 3 & 9\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-7I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{10},$ we get \n\n$$\n{u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-13ce8fe7-2fa0-5374-84b1-d90a49b96890"] :db/ensure [:question/validate]} {:db/id "answer-field-13ce8fe7-2fa0-5374-84b1-d90a49b96890" :answer-field/id #uuid "13ce8fe7-2fa0-5374-84b1-d90a49b96890" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-592663a7-2308-5850-bedd-0fb5f3ee0ec2" :answer-field/choices ["answer-592663a7-2308-5850-bedd-0fb5f3ee0ec2" "answer-b85fd2dd-6759-5b78-9ba7-4715c2d8f37e" "answer-87935c1d-3718-5f26-8460-6ca7631017a5" "answer-2b1a9875-89ac-5fc5-9906-3cd3164d6d28" "answer-2146da66-b60d-5beb-a83b-603030a5d8e5"] :db/ensure [:answer-field/validate]} {:db/id "answer-592663a7-2308-5850-bedd-0fb5f3ee0ec2" :answer/id #uuid "592663a7-2308-5850-bedd-0fb5f3ee0ec2" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}-3 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b85fd2dd-6759-5b78-9ba7-4715c2d8f37e" :answer/id #uuid "b85fd2dd-6759-5b78-9ba7-4715c2d8f37e" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}[\\begin{aligned}1 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-87935c1d-3718-5f26-8460-6ca7631017a5" :answer/id #uuid "87935c1d-3718-5f26-8460-6ca7631017a5" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2b1a9875-89ac-5fc5-9906-3cd3164d6d28" :answer/id #uuid "2b1a9875-89ac-5fc5-9906-3cd3164d6d28" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2146da66-b60d-5beb-a83b-603030a5d8e5" :answer/id #uuid "2146da66-b60d-5beb-a83b-603030a5d8e5" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-09aebc44-422b-52f7-a02d-eaf1743e7ebe" :question/id #uuid "09aebc44-422b-52f7-a02d-eaf1743e7ebe" :question/math-academy-id "q-149392" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}2 & -2 \\\\ -2 & 5\\end{aligned}]\n$$\n\nFind the first principal component of the data, given that the eigenvalues of $C$ are $1$ and $6.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are ${\\lambda }_{1}=6$ and ${\\lambda }_{2}=1.$\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{1}=6:$\n\n$$\n\\begin{aligned}C-6I & =[\\begin{aligned}2 & -2 \\\\ -2 & 5\\end{aligned}]-6[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-4 & -2 \\\\ -2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-6I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}1 \\\\ -2\\end{aligned}].$\n\nFinally, dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5e062c5c-9135-5dcd-a6cd-4b1e54847cda"] :db/ensure [:question/validate]} {:db/id "answer-field-5e062c5c-9135-5dcd-a6cd-4b1e54847cda" :answer-field/id #uuid "5e062c5c-9135-5dcd-a6cd-4b1e54847cda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eb718a45-f746-52d7-8ff4-472493cc2b18" :answer-field/choices ["answer-64df2e0c-e2f2-597f-994a-e8c482f3d24a" "answer-444c573d-7ae8-5596-961d-d21ec88bd4d4" "answer-eb718a45-f746-52d7-8ff4-472493cc2b18" "answer-ad4c8d99-d2ac-500a-9b5a-349550c1d9f8" "answer-9e518aae-49e5-5927-8b59-ebdd1976a2ee"] :db/ensure [:answer-field/validate]} {:db/id "answer-64df2e0c-e2f2-597f-994a-e8c482f3d24a" :answer/id #uuid "64df2e0c-e2f2-597f-994a-e8c482f3d24a" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-444c573d-7ae8-5596-961d-d21ec88bd4d4" :answer/id #uuid "444c573d-7ae8-5596-961d-d21ec88bd4d4" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-eb718a45-f746-52d7-8ff4-472493cc2b18" :answer/id #uuid "eb718a45-f746-52d7-8ff4-472493cc2b18" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ad4c8d99-d2ac-500a-9b5a-349550c1d9f8" :answer/id #uuid "ad4c8d99-d2ac-500a-9b5a-349550c1d9f8" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9e518aae-49e5-5927-8b59-ebdd1976a2ee" :answer/id #uuid "9e518aae-49e5-5927-8b59-ebdd1976a2ee" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-5374b353-43b9-56d5-bf37-798eca076a47" :question/id #uuid "5374b353-43b9-56d5-bf37-798eca076a47" :question/math-academy-id "q-138531" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}4 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 4\\end{aligned}]\n$$\n\nFind the third principal component of the data, given that the eigenvalues of $C$ are $5,$ $3,$ and $2.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are \n\n$$\n{\\lambda }_{1}=5,\\,{\\lambda }_{2}=3,\\,{\\lambda }_{3}=2.\n$$\n\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{3}=2:$\n\n$$\n\\begin{aligned}C-2I & =[\\begin{aligned}4 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ 1 & 0 & 4\\end{aligned}]-2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}2 & 0 & 1 \\\\ 0 & 0 & 0 \\\\ 1 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-2I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$ \n\nFinally, dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=1,$ we get \n\n$$\n{u}_{3}=\\frac{{v}_{3}}{‖{v}_{3}‖}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-38a98c77-18cd-5480-9aa3-b3e4273a0328"] :db/ensure [:question/validate]} {:db/id "answer-field-38a98c77-18cd-5480-9aa3-b3e4273a0328" :answer-field/id #uuid "38a98c77-18cd-5480-9aa3-b3e4273a0328" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-af67ddbf-eada-5914-aaaa-00feff03ccc6" :answer-field/choices ["answer-af67ddbf-eada-5914-aaaa-00feff03ccc6" "answer-dfb15a69-5ab5-567e-872d-498d5e6ae6e6" "answer-f66f6760-690a-575d-8e8a-2c912554b5d5" "answer-2f26650b-f307-5083-ac8d-c889e76cf7c3" "answer-6770be34-175a-5663-8664-d993ad4bebbf"] :db/ensure [:answer-field/validate]} {:db/id "answer-af67ddbf-eada-5914-aaaa-00feff03ccc6" :answer/id #uuid "af67ddbf-eada-5914-aaaa-00feff03ccc6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-dfb15a69-5ab5-567e-872d-498d5e6ae6e6" :answer/id #uuid "dfb15a69-5ab5-567e-872d-498d5e6ae6e6" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f66f6760-690a-575d-8e8a-2c912554b5d5" :answer/id #uuid "f66f6760-690a-575d-8e8a-2c912554b5d5" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-2f26650b-f307-5083-ac8d-c889e76cf7c3" :answer/id #uuid "2f26650b-f307-5083-ac8d-c889e76cf7c3" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6770be34-175a-5663-8664-d993ad4bebbf" :answer/id #uuid "6770be34-175a-5663-8664-d993ad4bebbf" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{6}}[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-30659c57-f541-5ec5-857d-e24511eb8172" :question/id #uuid "30659c57-f541-5ec5-857d-e24511eb8172" :question/math-academy-id "q-149430" :question/problem "The covariance matrix $C$ of some particular observations is shown below. \n\n$$\nC=[\\begin{aligned}4 & -2 & -3 \\\\ -2 & 5 & 2 \\\\ -3 & 2 & 4\\end{aligned}]\n$$\n\nFind the third principal component of the data, given that the eigenvalues of $C$ are $1,$ $3,$ and $9.$" :question/worked-solution "Recall that the unit eigenvectors of the covariance matrix $C$ are called the principal components of the data. If \n\n$$\n{\\lambda }_{1}>{\\lambda }_{2}>⋯>{\\lambda }_{n}\n$$\n\nare the eigenvalues of $C$ written in descending order, then: \n\n- the $1$st principal component is the unit eigenvector ${u}_{1}$ corresponding to the $1$st eigenvalue ${\\lambda }_{1},$\n\n- the $2$nd principal component is the unit eigenvector ${u}_{2}$ corresponding to the $2$nd eigenvalue ${\\lambda }_{2},$\n\n- $⋯$\n\nand so on.\n\nIn our case, the eigenvalues of the covariance matrix $C,$ in descending order, are \n\n$$\n{\\lambda }_{1}=9,\\,{\\lambda }_{2}=3,\\,{\\lambda }_{3}=1.\n$$\n\nSo, we need the unit eigenvector that corresponds to the eigenvalue ${\\lambda }_{3}=1:$\n\n$$\n\\begin{aligned}C-I & =[\\begin{aligned}4 & -2 & -3 \\\\ -2 & 5 & 2 \\\\ -3 & 2 & 4\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}3 & -2 & -3 \\\\ -2 & 4 & 2 \\\\ -3 & 2 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(C-I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$ \n\nFinally, dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n{u}_{3}=\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1e70a197-b3ce-5e88-b246-d5ee3922e949"] :db/ensure [:question/validate]} {:db/id "answer-field-1e70a197-b3ce-5e88-b246-d5ee3922e949" :answer-field/id #uuid "1e70a197-b3ce-5e88-b246-d5ee3922e949" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c355b21c-fab5-547e-b193-a8f5ac6b906a" :answer-field/choices ["answer-6f3241c0-aebf-5f17-b035-18257b7ec1f2" "answer-216c564c-5ad0-50d5-982d-6e8432fadef1" "answer-5c298372-518e-51e5-8af5-1a96d417af2f" "answer-c355b21c-fab5-547e-b193-a8f