ty/easy :db/ensure [:question/validate]} {:db/id 17592186105364 :answer-field/correct "answer-d4048b37-173b-5ab0-9982-dfff18dda897" :answer-field/choices ["answer-51acd88f-4c23-5d1f-9d96-bca4670e17af" "answer-2bba465f-a37c-5c24-b262-1fa7f7e131f1" "answer-d4048b37-173b-5ab0-9982-dfff18dda897" "answer-8cdf0d36-ed23-5f29-85a3-69045f032e8e" "answer-de133ad8-2700-53b6-afe1-b0959b9721a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-51acd88f-4c23-5d1f-9d96-bca4670e17af" :answer/id #uuid "51acd88f-4c23-5d1f-9d96-bca4670e17af" :answer/type :answer.type/math :answer/value "-(2\\operatorname{cosh}⁡x+3\\operatorname{sinh}⁡x)" :db/ensure [:answer/validate]} {:db/id "answer-2bba465f-a37c-5c24-b262-1fa7f7e131f1" :answer/id #uuid "2bba465f-a37c-5c24-b262-1fa7f7e131f1" :answer/type :answer.type/math :answer/value "2\\operatorname{cosh}⁡2x" :db/ensure [:answer/validate]} {:db/id "answer-d4048b37-173b-5ab0-9982-dfff18dda897" :answer/id #uuid "d4048b37-173b-5ab0-9982-dfff18dda897" :answer/type :answer.type/math :answer/value "2\\operatorname{cosh}⁡x+3\\operatorname{sinh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-8cdf0d36-ed23-5f29-85a3-69045f032e8e" :answer/id #uuid "8cdf0d36-ed23-5f29-85a3-69045f032e8e" :answer/type :answer.type/math :answer/value "2\\operatorname{cosh}⁡x-3\\operatorname{sinh}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-de133ad8-2700-53b6-afe1-b0959b9721a4" :answer/id #uuid "de133ad8-2700-53b6-afe1-b0959b9721a4" :answer/type :answer.type/math :answer/value "3\\operatorname{sinh}⁡x-2\\operatorname{cosh}⁡x" :db/ensure [:answer/validate]} {:db/id "question-05b36d37-a26f-5d16-ae0b-dd50ba7890e6" :question/id #uuid "05b36d37-a26f-5d16-ae0b-dd50ba7890e6" :question/math-academy-id "q-95670" :question/problem "$$\n\nFind the derivative of $y=6\\operatorname{cosh}⁡x-\\operatorname{tanh}⁡x.$" :question/worked-solution "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{cosh}⁡x-\\operatorname{tanh}⁡x) \\\\  & =6\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)-\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x) \\\\  & =6\\operatorname{sinh}⁡x-{sech}^{2}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8394f195-7cf1-5ba2-9173-5600bc8349c8"] :db/ensure [:question/validate]} {:db/id "answer-field-8394f195-7cf1-5ba2-9173-5600bc8349c8" :answer-field/id #uuid "8394f195-7cf1-5ba2-9173-5600bc8349c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7489366b-e83b-5e6a-b0ff-16b6391f4b81" :answer-field/choices ["answer-68b6196b-17c0-5be3-898c-a6ae5af8c973" "answer-06ab3879-2e3a-5271-93d4-d0935bd2ca32" "answer-3e36c9ef-6a7c-5a09-b3f9-570560a4f21f" "answer-ac937534-fd96-5c16-81b1-91fa1a169e39" "answer-7489366b-e83b-5e6a-b0ff-16b6391f4b81"] :db/ensure [:answer-field/validate]} {:db/id "answer-68b6196b-17c0-5be3-898c-a6ae5af8c973" :answer/id #uuid "68b6196b-17c0-5be3-898c-a6ae5af8c973" :answer/type :answer.type/math :answer/value "-6\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-06ab3879-2e3a-5271-93d4-d0935bd2ca32" :answer/id #uuid "06ab3879-2e3a-5271-93d4-d0935bd2ca32" :answer/type :answer.type/math :answer/value "-6\\operatorname{sinh}⁡x-{sech}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-3e36c9ef-6a7c-5a09-b3f9-570560a4f21f" :answer/id #uuid "3e36c9ef-6a7c-5a09-b3f9-570560a4f21f" :answer/type :answer.type/math :answer/value "6\\operatorname{sinh}⁡x+\\operatorname{sech}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-ac937534-fd96-5c16-81b1-91fa1a169e39" :answer/id #uuid "ac937534-fd96-5c16-81b1-91fa1a169e39" :answer/type :answer.type/math :answer/value "6\\operatorname{sinh}⁡x+{sech}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-7489366b-e83b-5e6a-b0ff-16b6391f4b81" :answer/id #uuid "7489366b-e83b-5e6a-b0ff-16b6391f4b81" :answer/type :answer.type/math :answer/value "6\\operatorname{sinh}⁡x-{sech}^{2}⁡x" :db/ensure [:answer/validate]} {:db/id "question-16fea3d9-04d8-53ba-a81e-4ab7949c02d8" :question/id #uuid "16fea3d9-04d8-53ba-a81e-4ab7949c02d8" :question/math-academy-id "q-95671" :question/problem "$$\n\nFind the derivative of $y=\\frac{1}{2}\\operatorname{tanh}⁡x-4\\operatorname{sinh}⁡x.$" :question/worked-solution "First, we recall the results for the derivatives of the basic hyperbolic functions:\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x)=\\operatorname{cosh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x,\\,\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\n$$\n\nDifferentiating the given function using these results, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}\\operatorname{tanh}⁡x-4\\operatorname{sinh}⁡x) \\\\  & =\\frac{1}{2}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)-4\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sinh}⁡x) \\\\  & =\\frac{1}{2}{sech}^{2}⁡x-4\\operatorname{cosh}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-29223fdb-fde4-56b6-bbbe-c49644ecd755"] :db/ensure [:question/validate]} {:db/id "answer-field-29223fdb-fde4-56b6-bbbe-c49644ecd755" :answer-field/id #uuid "29223fdb-fde4-56b6-bbbe-c49644ecd755" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-af7c9ea1-288c-5839-b4c5-25fe0687c0f9" :answer-field/choices ["answer-a72f2c7a-f375-5c68-a7ef-897ca237a31f" "answer-755e0dee-1ad3-5455-a72b-95356420ea2b" "a