ate]} {:db/id "answer-f2edac3d-5e7d-5e6d-ab72-3427cf21f39f" :answer/id #uuid "f2edac3d-5e7d-5e6d-ab72-3427cf21f39f" :answer/type :answer.type/math :answer/value "15+12\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-2c5f3c09-13bd-51a0-b193-7c0def637ec4" :answer/id #uuid "2c5f3c09-13bd-51a0-b193-7c0def637ec4" :answer/type :answer.type/math :answer/value "3+4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-0ff78c2c-d893-5e71-a551-f6f4b8bd257b" :answer/id #uuid "0ff78c2c-d893-5e71-a551-f6f4b8bd257b" :answer/type :answer.type/math :answer/value "3-12\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-f436f87f-2fa7-59f1-b789-8fc85b53906b" :answer/id #uuid "f436f87f-2fa7-59f1-b789-8fc85b53906b" :answer/type :answer.type/math :answer/value "3-4\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "question-683bbf9d-fe44-596b-9cba-6b07323bd6d5" :question/id #uuid "683bbf9d-fe44-596b-9cba-6b07323bd6d5" :question/math-academy-id "q-250273" :question/problem "Expressed as a complex number,\n\n$(11-\\sqrt{-80})-(6+\\sqrt{-125})=$\n{{field-1}}$-\\,$\n{{field-2}}$\\text{i}.$" :question/worked-solution "Given the complex number $a+b\\,\\text{i},$ $a$ represents its real part while $b$ represents its imaginary part.\n\nTo add or subtract complex numbers, we add or subtract their real parts, and we add or subtract their imaginary parts.\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(11-\\sqrt{-80})-(6+\\sqrt{-125}) & =(11-\\sqrt{16\\cdot 5}\\,\\text{i})-(6+\\sqrt{25\\cdot 5}\\,\\text{i}) \\\\  & =(11-4\\sqrt{5}\\,\\text{i})-(6+5\\sqrt{5}\\,\\text{i}) \\\\  & =(11-6)+(-4\\sqrt{5}-5\\sqrt{5})\\,\\text{i} \\\\  & =5-9\\sqrt{5}\\,\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1916ec5a-aa89-555d-8e86-4d02c1b34da1" "answer-field-fca53e00-b552-516f-9262-d39536b24fc1"] :db/ensure [:question/validate]} {:db/id "answer-field-1916ec5a-aa89-555d-8e86-4d02c1b34da1" :answer-field/id #uu