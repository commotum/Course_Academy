2})$ is $0.$ All that matters is that as $x$ approaches $-\\frac{3}{2},$ the function $f(x)$ *looks like* it is getting closer and closer to $2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-14414f8e-6193-5fb6-baea-94b2b7d400fa"] :db/ensure [:question/validate]} {:db/id "answer-field-14414f8e-6193-5fb6-baea-94b2b7d400fa" :answer-field/id #uuid "14414f8e-6193-5fb6-baea-94b2b7d400fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a9cd59c-78db-5f98-80ed-7eef9e41e3f4" :answer-field/choices ["answer-5df8c413-c26f-5f42-ac67-136b2b31dc40" "answer-22aa6597-ab52-5b75-99a4-6b7169a14c1f" "answer-9a9cd59c-78db-5f98-80ed-7eef9e41e3f4" "answer-09eb58fc-db0a-591c-80dc-ab3b7bc520c0" "answer-e5b231a6-a623-5fb9-a9f6-14b416081d8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-5df8c413-c26f-5f42-ac67-136b2b31dc40" :answer/id #uuid "5df8c413-c26f-5f42-ac67-136b2b31dc40" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-22aa6597-ab52-5b75-99a4-6b7169a14c1f" :answer/id #uuid "22aa6597-ab52-5b75-99a4-6b7169a14c1f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-9a9cd59c-78db-5f98-80ed-7eef9e41e3f4" :answer/id #uuid "9a9cd59c-78db-5f98-80ed-7eef9e41e3f4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-09eb58fc-db0a-591c-80dc-ab3b7bc520c0" :answer/id #uuid "09eb58fc-db0a-591c-80dc-ab3b7bc520c0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-e5b231a6-a623-5fb9-a9f6-14b416081d8f" :answer/id #uuid "e5b231a6-a623-5fb9-a9f6-14b416081d8f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-87458c76-eabf-5005-ac30-a442db3ab7b3" :question/id #uuid "87458c76-eabf-5005-ac30-a442db3ab7b3" :question/math-academy-id "q-335759" :question/problem "![](images/22/22acfe14709e4992ddadf6d1d4fcd0e2a533c93573c32dd4134ec3498b0ea805.png)\n\nFind ${lim}_{x\\to \\,2}f(x)$ for the function above.\n\n${lim}_{x\\to \\,2}f(x)=$\n{{field-1}}" :question/worked-solution "As $x$ approaches $2,$ the value of $f(x)$ approaches $-3.$ Consequently, \n\n$$\n{lim}_{x\\to \\,2}f(x)=-3.\n$$\n\nRemember, it does not matter that the actual value of $f(2)$ is $-2.$ All that matters is that as $x$ approaches $2,$ the function $f(x)$ *looks like* it is getting closer and closer to $-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-04852450-d7a3-5aa8-bc86-7555a6eb7107"] :db/ensure [:question/validate]} {:db/id "answer-field-04852450-d7a3-5aa8-bc86-7555a6eb7107" :answer-field/id #uuid "04852450-d7a3-5aa8-bc86-7555a6eb7107" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f0a2d33a-8edf-5f9d-9762-1df5f4fdb217" :answer-field/choices ["answer-f0a2d33a-8edf-5f9d-9762-1df5f4fdb217"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0a2d33a-8edf-5f9d-9762-1df5f4fdb217" :answer/id #uuid "f0a2d33a-8edf-5f9d-9762-1df5f4fdb217" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-f5f74f57-aaaa-5a36-a7e2-f4e15eb6a61c" :question/id #uuid "f5f74f57-aaaa-5a36-a7e2-f4e15eb6a61c" :question/math-academy-id "q-300752" :question/problem "![](images/93/93fc83d79679ca9f2b58729af1e3e87c2a01c19c12bc97670fbff398d63d061d.png)\n\nFind ${lim}_{x\\to \\,2}f(x)$ for the function above.\n\n${lim}_{x\\to \\,2}f(x)=$\n{{field-1}}" :question/worked-solution "As $x$ approaches $2,$ the value of $f(x)$ approaches $0.$ Consequently, \n\n$$\n{lim}_{x\\to \\,2}f(x)=0.\n$$\n\nRemember, it does not matter that the actual value of $f(2)$ is $-2.$ All that matters is that as $x$ approaches $2,$ the function $f(x)$ *looks like* it is getting closer and closer to $0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-471d69b4-8ecc-55fb-b5cf-d3a8ac996b27"] :db/ensure [:question/validate]} {:db/id "answer-field-471d69b4-8ecc-55fb-b5cf-d3a8ac996b27" :answer-field/id #uuid "471d69b4-8ecc-55fb-b5cf-d3a8ac996b27" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0ca6bb5d-b4ea-553b-853f-9ceddd8cfae6" :answer-field/choices ["answer-0ca6bb5d-b4ea-553b-853f-9ceddd8cfae6"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ca6bb5d-b4ea-553b-853f-9ceddd8cfae6" :answer/id #uuid "0ca6bb5d-b4ea-553b-853f-9ceddd8cfae6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-0bebd627-ffbe-5f9e-9279-43f33938aacb" :question/id #uuid "0bebd627-ffbe-5f9e-9279-43f33938aacb" :question/math-academy-id "q-34924" :question/problem "![](images/f8/f8b33f31c4b569da24aa8235421698859e74b144e783f0fb917a5f4b3679d834.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above?\n\nI. ${lim}_{x\\to \\,0}f(x)=3$\n\nII. ${lim}_{x\\to \\,-1}f(x)=1$\n\nIII. ${lim}_{x\\to \\,-2}f(x)={lim}_{x\\to \\,1}f(x)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. As $x$ approaches $0,$ the function $f(x)$ approaches the value $y=2.$ Consequently, \n\n$$\n{lim}_{x\\to \\,1}f(x)=2.\n$$\n\n- Statement II is true. As $x$ approaches $-1,$ the function $f(x)$ approaches the value $y=1.$ Consequently, \n\n$$\n{lim}_{x\\to \\,-1}f(x)=1.\n$$\n\n- Statement III is false. As $x$ approaches $-2,$ the function $f(x)$ approaches the value $y=0,$ and consequently \n\n$$\n{lim}_{x\\to \\,-2}f(x)=0.\n$$\n\n \nSimilarly, as $x$ approaches $1,$ the function $f(x)$ approaches the value $y=1,$ and consequently,\n\n$$\n{lim}_{x\\to \\,1}f(x)=1.\n$$\n\nAs a result,\n\n$$\n{lim}_{x\\to \\,-2}f(x)\\ne {lim}_{x\\to \\,1}f(x).\n$$\n\nIn conclusion, only statement II is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-47c4b582-3613-535f-9f83-090b0b7dae3b"] :db/ensure [:question/validate]} {:db/id "answer-field-47c4b582-3613-535f-9f83-090b0b7dae3b" :answer-field/id #uuid "47c4b582-3613-535f-9f83-090b0b7dae3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-00825b34-ca14-5ae2-ab19-c20bf17e8d48" :answer-field/choices ["answer-b7f1fe47-ace4-5f56-b111-f3a8735fbf25" "answer-36a59ce0-10d0-5c8f-a5e5-89f4077f85c2" "answer-d5f221f0-cc8f-5a04-b326-1e63cf89a6e7" "answer-00825b34-ca14-5ae2-ab19-c20bf17e8d48" "answer-d8534147-a200-5784-b2ea-387fd8f94bc7"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7f1fe47-ace4-5f56-b111-f3a8735fbf25" :answer/id #uuid "b7f1fe47-ace4-5f56-b111-f3a8735fbf25" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-36a59ce0-10d0-5c8f-a5e5-89f4077f85c2" :answer/id #uuid "36a59ce0-10d0-5c8f-a5e5-89f4077f85c2" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-d5f221f0-cc8f-5a04-b326-1e63cf89a6e7" :answer/id #uuid "d5f221f0-cc8f-5a04-b326-1e63cf89a6e7" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-00825b34-ca14-5ae2-ab19-c20bf17e8d48" :answer/id #uuid "00825b34-ca14-5ae2-ab19-c20bf17e8d48" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-d8534147-a200-5784-b2ea-387fd8f94bc7" :answer/id #uuid "d8534147-a200-5784-b2ea-387fd8f94bc7" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-e220bff6-4f48-5639-8c40-6889828b8e5d" :question/id #uuid "e220bff6-4f48-5639-8c40-6889828b8e5d" :question/math-academy-id "q-34927" :question/problem "![](images/67/6769c6590446a9599786758ba9cfaf17690f401d864b3ce5f2c3825d9ca432cd.png)\n\nWhich of the following statements are true concerning the function $y=f(x)$ whose graph is shown above?\n\nI. ${lim}_{x\\to \\,-1}f(x)=1$\n\nII. ${lim}_{x\\to \\,0}f(x)=0$\n\nIII. ${lim}_{x\\to \\,1}f(x)={lim}_{x\\to \\,2}f(x)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. As $x$ approaches $-1,$ the function $f(x)$ approaches the value $y=1.$ Consequently, \n\n$$\n{lim}_{x\\to \\,-1}f(x)=1.\n$$\n\n- Statement II is true. As $x$ approaches $0,$ the function $f(x)$ approaches the value $y=0.$ Consequently, \n\n$$\n{lim}_{x\\to \\,0}f(x)=0.\n$$\n\n- Statement III is false. As $x$ approaches $1,$ the function $f(x)$ approaches the value $y=1,$ and consequently \n\n$$\n{lim}_{x\\to \\,1}f(x)=1.\n$$\n\n \nSimilarly, as $x$ approaches $2,$ the function $f(x)$ approaches the value $y=0,$ and consequently, \n\n$$\n{lim}_{x\\to \\,2}f(x)=0.\n$$\n\n As a result,\n\n$$\n{lim}_{x\\to \\,1}f(x)\\ne {lim}_{x\\to \\,2}f(x).\n$$\n\nIn conclusion, only statements I and II are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cf4a92b8-1b37-555c-b412-fdb7e36b861f"] :db/ensure [:question/validate]} {:db/id "answer-field-cf4a92b8-1b37-555c-b412-fdb7e36b861f" :answer-field/id #uuid "cf4a92b8-1b37-555c-b412-fdb7e36b861f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-80be8d3f-0137-5d6e-9361-4b53f0963293" :answer-field/choices ["answer-80be8d3f-0137-5d6e-9361-4b53f0963293" "answer-538b1e9d-53e0-5462-b056-10b1cbc26d00" "answer-4db872f0-8799-5efd-81e7-d8ed8388da7d" "answer-6c526a4b-1fc6-5714-8922-861633a05946" "answer-bba5df6a-0195-5eb0-a6c3-8cde93cd09f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-80be8d3f-0137-5d6e-9361-4b53f0963293" :answer/id #uuid "80be8d3f-0137-5d6e-9361-4b53f0963293" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-538b1e9d-53e0-5462-b056-10b1cbc26d00" :answer/id #uuid "538b1e9d-53e0-5462-b056-10b1cbc26d00" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4db872f0-8799-5efd-81e7-d8ed8388da7d" :answer/id #uuid "4db872f0-8799-5efd-81e7-d8ed8388da7d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-6c526a4b-1fc6-5714-8922-861633a05946" :answer/id #uuid "6c526a4b-1fc6-5714-8922-861633a05946" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-bba5df6a-0195-5eb0-a6c3-8cde93cd09f4" :answer/id #uuid "bba5df6a-0195-5eb0-a6c3-8cde93cd09f4" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186162101 :knowledge-point/questions ["question-d5be6574-3a28-52d0-8e4b-f267e2db636b" "question-5c576b08-9f07-530e-b539-76adf5c7de7d" "question-53bedfc9-6dd3-5f58-8bd9-2e76db557744"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d5be6574-3a28-52d0-8e4b-f267e2db636b" :question/id #uuid "d5be6574-3a28-52d0-8e4b-f267e2db636b" :question/math-academy-id "q-142541" :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X$ has a student's $t$-distribution ${T}_{k}$ with $k$ degrees of freedom. Given that the random variable $X∼{T}_{19},$ find the value of $x$ such that $P(X\\le x)=0.9.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $19$ | $1.328$ | $1.729$ | $2.093$ | $2.539$ | $2.861$ |\n| $20$ | $1.325$ | $1.725$ | $2.086$ | $2.528$ | $2.845$ |\n| $21$ | $1.323$ | $1.721$ | $2.080$ | $2.518$ | $2.831$ |" :question/worked-solution "The table shows probabilities in the form $P(X\\ge x).$ So first, we express the desired probability in this form:\n\n$$\n\\begin{aligned}P(X\\ge x) & =1-P(X\\le x) \\\\  & =1-0.9 \\\\  & =0.1\\end{aligned}\n$$\n\nNow, since $X∼{T}_{19},$ we focus on the row of the table that corresponds to $k=19.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $19$ | $1.328$ | $1.729$ | $2.093$ | $2.539$ | $2.861$ |\n| $20$ | $1.325$ | $1.725$ | $2.086$ | $2.528$ | $2.845$ |\n| $21$ | $1.323$ | $1.721$ | $2.080$ | $2.518$ | $2.831$ |\n\nFrom this row, we see that\n\n$$\nP(X\\ge 1.328)=0.100.\n$$\n\nTherefore, our answer is $x=1.328.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2aecb7f6-bd05-5c5c-981f-c41f2b10cce7"] :db/ensure [:question/validate]} {:db/id "answer-field-2aecb7f6-bd05-5c5c-981f-c41f2b10cce7" :answer-field/id #uuid "2aecb7f6-bd05-5c5c-981f-c41f2b10cce7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7b7993b3-f733-5e81-92fe-d298f6220041" :answer-field/choices ["answer-527bfb4f-9d52-595b-b3f0-ce4b1acefcef" "answer-7b7993b3-f733-5e81-92fe-d298f6220041" "answer-2a2356bf-311c-51bb-9c39-b10fe214fff2" "answer-8cf90eb5-a13e-5686-9760-9e87d8d3d500" "answer-f3b3bcfd-2937-5d70-b9ad-bb649cdc22c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-527bfb4f-9d52-595b-b3f0-ce4b1acefcef" :answer/id #uuid "527bfb4f-9d52-595b-b3f0-ce4b1acefcef" :answer/type :answer.type/math :answer/value "1.323" :db/ensure [:answer/validate]} {:db/id "answer-7b7993b3-f733-5e81-92fe-d298f6220041" :answer/id #uuid "7b7993b3-f733-5e81-92fe-d298f6220041" :answer/type :answer.type/math :answer/value "1.328" :db/ensure [:answer/validate]} {:db/id "answer-2a2356bf-311c-51bb-9c39-b10fe214fff2" :answer/id #uuid "2a2356bf-311c-51bb-9c39-b10fe214fff2" :answer/type :answer.type/math :answer/value "2.528" :db/ensure [:answer/validate]} {:db/id "answer-8cf90eb5-a13e-5686-9760-9e87d8d3d500" :answer/id #uuid "8cf90eb5-a13e-5686-9760-9e87d8d3d500" :answer/type :answer.type/math :answer/value "2.539" :db/ensure [:answer/validate]} {:db/id "answer-f3b3bcfd-2937-5d70-b9ad-bb649cdc22c1" :answer/id #uuid "f3b3bcfd-2937-5d70-b9ad-bb649cdc22c1" :answer/type :answer.type/math :answer/value "2.861" :db/ensure [:answer/validate]} {:db/id "question-5c576b08-9f07-530e-b539-76adf5c7de7d" :question/id #uuid "5c576b08-9f07-530e-b539-76adf5c7de7d" :question/math-academy-id "q-142543" :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X$ has a student's $t$-distribution ${T}_{k}$ with $k$ degrees of freedom. Given that the random variable $X∼{T}_{20},$ find the value of $x$ such that $P(X\\le x)=0.99.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $19$ | $1.328$ | $1.729$ | $2.093$ | $2.539$ | $2.861$ |\n| $20$ | $1.325$ | $1.725$ | $2.086$ | $2.528$ | $2.845$ |\n| $21$ | $1.323$ | $1.721$ | $2.080$ | $2.518$ | $2.831$ |" :question/worked-solution "The table shows probabilities in the form $P(X\\ge x).$ So first, we express the desired probability in this form:\n\n$$\n\\begin{aligned}P(X\\ge x) & =1-P(X\\le x) \\\\  & =1-0.99 \\\\  & =0.01\\end{aligned}\n$$\n\nNow, since $X∼{T}_{20},$ we focus on the row of the table that corresponds to $k=20.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $19$ | $1.328$ | $1.729$ | $2.093$ | $2.539$ | $2.861$ |\n| $20$ | $1.325$ | $1.725$ | $2.086$ | $2.528$ | $2.845$ |\n| $21$ | $1.323$ | $1.721$ | $2.080$ | $2.518$ | $2.831$ |\n\nFrom this row, we see that\n\n$$\nP(X\\ge 2.528)=0.010.\n$$\n\nTherefore, our answer is $x=2.528.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fb69b1a1-571c-5439-bbf9-3a6f22a0ac17"] :db/ensure [:question/validate]} {:db/id "answer-field-fb69b1a1-571c-5439-bbf9-3a6f22a0ac17" :answer-field/id #uuid "fb69b1a1-571c-5439-bbf9-3a6f22a0ac17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c000eb5b-de3d-5c48-8197-770d70f4bc71" :answer-field/choices ["answer-317af612-bd74-5d49-94a6-9a8a6e10174d" "answer-a4a2c2e4-f556-523a-a75e-2e4591426514" "answer-3e3a2f76-a9c8-57ad-af4f-54fc0e6cd390" "answer-c000eb5b-de3d-5c48-8197-770d70f4bc71" "answer-82d3ce4e-9325-578a-bfa5-1a9cb4acdcf7"] :db/ensure [:answer-field/validate]} {:db/id "answer-317af612-bd74-5d49-94a6-9a8a6e10174d" :answer/id #uuid "317af612-bd74-5d49-94a6-9a8a6e10174d" :answer/type :answer.type/math :answer/value "1.325" :db/ensure [:answer/validate]} {:db/id "answer-a4a2c2e4-f556-523a-a75e-2e4591426514" :answer/id #uuid "a4a2c2e4-f556-523a-a75e-2e4591426514" :answer/type :answer.type/math :answer/value "1.328" :db/ensure [:answer/validate]} {:db/id "answer-3e3a2f76-a9c8-57ad-af4f-54fc0e6cd390" :answer/id #uuid "3e3a2f76-a9c8-57ad-af4f-54fc0e6cd390" :answer/type :answer.type/math :answer/value "2.518" :db/ensure [:answer/validate]} {:db/id "answer-c000eb5b-de3d-5c48-8197-770d70f4bc71" :answer/id #uuid "c000eb5b-de3d-5c48-8197-770d70f4bc71" :answer/type :answer.type/math :answer/value "2.528" :db/ensure [:answer/validate]} {:db/id "answer-82d3ce4e-9325-578a-bfa5-1a9cb4acdcf7" :answer/id #uuid "82d3ce4e-9325-578a-bfa5-1a9cb4acdcf7" :answer/type :answer.type/math :answer/value "2.845" :db/ensure [:answer/validate]} {:db/id "question-53bedfc9-6dd3-5f58-8bd9-2e76db557744" :question/id #uuid "53bedfc9-6dd3-5f58-8bd9-2e76db557744" :question/math-academy-id "q-142580" :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X$ has a student's $t$-distribution ${T}_{k}$ with $k$ degrees of freedom. Given that the random variable $X∼{T}_{25},$ find the value of $x$ such that $P(X\\le x)=0.995.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $24$ | $1.318$ | $1.711$ | $2.064$ | $2.492$ | $2.797$ |\n| $25$ | $1.316$ | $1.708$ | $2.060$ | $2.485$ | $2.787$ |\n| $26$ | $1.315$ | $1.706$ | $2.056$ | $2.479$ | $2.779$ |" :question/worked-solution "The table shows probabilities in the form $P(X\\ge x).$ So first, we express the desired probability in this form:\n\n$$\n\\begin{aligned}P(X\\ge x) & =1-P(X\\le x) \\\\  & =1-0.995 \\\\  & =0.005\\end{aligned}\n$$\n\nNow, since $X∼{T}_{25},$ we focus on the row of the table that corresponds to $k=25.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $24$ | $1.318$ | $1.711$ | $2.064$ | $2.492$ | $2.797$ |\n| $25$ | $1.316$ | $1.708$ | $2.060$ | $2.485$ | $2.787$ |\n| $26$ | $1.315$ | $1.706$ | $2.056$ | $2.479$ | $2.779$ |\n\nFrom this row, we see that\n\n$$\nP(X\\ge 2.787)=0.005.\n$$\n\nTherefore, our answer is $x=2.787.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-885ef5b5-44d7-500b-bb70-819519766275"] :db/ensure [:question/validate]} {:db/id "answer-field-885ef5b5-44d7-500b-bb70-819519766275" :answer-field/id #uuid "885ef5b5-44d7-500b-bb70-819519766275" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec242ef5-dc63-533d-8db7-e947ec25bdd4" :answer-field/choices ["answer-a3e04a1f-348f-5bb3-a5be-0930d2f13a9b" "answer-42153ec8-896b-5a88-a532-420303c9dfdc" "answer-fcc85b2f-6e5e-5e04-b574-f8f024c0b55e" "answer-3d5a030c-04ff-5537-a509-3d205630e231" "answer-ec242ef5-dc63-533d-8db7-e947ec25bdd4"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3e04a1f-348f-5bb3-a5be-0930d2f13a9b" :answer/id #uuid "a3e04a1f-348f-5bb3-a5be-0930d2f13a9b" :answer/type :answer.type/math :answer/value "1.318" :db/ensure [:answer/validate]} {:db/id "answer-42153ec8-896b-5a88-a532-420303c9dfdc" :answer/id #uuid "42153ec8-896b-5a88-a532-420303c9dfdc" :answer/type :answer.type/math :answer/value "1.708" :db/ensure [:answer/validate]} {:db/id "answer-fcc85b2f-6e5e-5e04-b574-f8f024c0b55e" :answer/id #uuid "fcc85b2f-6e5e-5e04-b574-f8f024c0b55e" :answer/type :answer.type/math :answer/value "2.485" :db/ensure [:answer/validate]} {:db/id "answer-3d5a030c-04ff-5537-a509-3d205630e231" :answer/id #uuid "3d5a030c-04ff-5537-a509-3d205630e231" :answer/type :answer.type/math :answer/value "2.779" :db/ensure [:answer/validate]} {:db/id "answer-ec242ef5-dc63-533d-8db7-e947ec25bdd4" :answer/id #uuid "ec242ef5-dc63-533d-8db7-e947ec25bdd4" :answer/type :answer.type/math :answer/value "2.787" :db/ensure [:answer/validate]} {:db/id 17592186162103 :knowledge-point/questions ["question-3619ef06-3622-5375-8459-4e89f07dd7d1" "question-9663f7f5-26ed-525b-a4e7-8ebcf7b4896a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3619ef06-3622-5375-8459-4e89f07dd7d1" :question/id #uuid "3619ef06-3622-5375-8459-4e89f07dd7d1" :question/math-academy-id "q-142722" :question/problem "The table below gives the values of $x$ that satisfy $P(X\\ge x)=p,$ where $X$ has a student's $t$-distribution ${T}_{k}$ with $k$ degrees of freedom. Given that the random variable $X∼{T}_{15},$ find the value of $x$ such that $P(|X|\\ge x)=0.02.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $15$ | $1.341$ | $1.753$ | $2.131$ | $2.602$ | $2.947$ |\n| $16$ | $1.337$ | $1.746$ | $2.120$ | $2.583$ | $2.921$ |\n| $17$ | $1.333$ | $1.740$ | $2.110$ | $2.576$ | $2.898$ |" :question/worked-solution "![](images/63/635de7075b0d106ffc2a0f15e65ca7a3406a49945591aa5eae59090c74df1398.png)\n\nDue to the symmetry of the student's $t$-distribution, we have that $P(|X|\\ge x)=0.02$ is equivalent to\n\n$$\n2P(X\\ge x)=0.02\\,⟹\\,P(X\\ge x)=0.01.\n$$\n\nNow, since $X∼{T}_{15},$ we focus on the row of the table that corresponds to $k=15.$\n\n| $k∖p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| $15$ | $1.341$ | $1.753$ | $2.131$ | $2.602$ | $2.947$ |\n| $16$ | $1.337$ | $1.746$ | $2.120$ | $2.583$ | $2.921$ |\n| $17$ | $1.333$ | $1.740$ | $2.110$ | $2.567$ | $2.898$ |\n\nFrom this row, we see that\n\n$$\nP(X\\ge 2.602)=0.010.\n$$\n\nTherefore, our answer is $x=2.602.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-faac0f2c-9586-5270-b3d8-5b3c6c767d29"] :db/ensure [:question/validate]} {:db/id "answer-field-faac0f2c-9586-5270-b3d