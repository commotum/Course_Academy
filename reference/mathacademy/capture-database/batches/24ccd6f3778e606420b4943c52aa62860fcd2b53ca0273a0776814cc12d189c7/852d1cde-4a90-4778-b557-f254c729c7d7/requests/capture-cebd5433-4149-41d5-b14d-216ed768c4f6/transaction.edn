:db/id "step-ce9debe6-891d-529c-892a-2636a0bb6427" :step/id #uuid "ce9debe6-891d-529c-892a-2636a0bb6427" :step/content 17592186167248 :step/next "step-cc9846dd-5c6b-5fee-8018-43e9e9a516aa" :db/ensure [:step/validate]} {:db/id "step-cc9846dd-5c6b-5fee-8018-43e9e9a516aa" :step/id #uuid "cc9846dd-5c6b-5fee-8018-43e9e9a516aa" :step/content 17592186370186 :step/next "step-a38583d0-39a0-55f8-a293-360a29886e88" :db/ensure [:step/validate]} {:db/id "step-a38583d0-39a0-55f8-a293-360a29886e88" :step/id #uuid "a38583d0-39a0-55f8-a293-360a29886e88" :step/content "question-9ec6a2eb-63e4-55a4-849b-ba0f89289e7d" :db/ensure [:step/validate]} {:db/id 17592186064184 :knowledge-point/questions ["question-084b231a-35a2-58f7-86fa-95eb22a6b762" "question-053acc10-5279-5930-8cdc-4b0bb8c6548c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064060 :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $2^4 = 16$ with $a = b^x,$ we get $a = 16,$ $b = 2,$ and $x = 4.$\n\nTherefore, the equation $2^4 = 16$ can be expressed as $\\log_{2}{16} = 4.$" :db/ensure [:question/validate]} {:db/id 17592186064188 :knowledge-point/questions ["question-8064db11-eab8-5f4f-8e90-6d9982417bde" "question-f3941239-6e19-5b0b-909a-0a8f6dea7adb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064063 :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $7^0 = 1$ with $a = b^x,$ we get $a = 1, b = 7,$ and $x=0.$\n\nTherefore, the equation $7^0 = 1$ is equivalent to $\\log_{7}{1}= 0.$\n\nIn general, $\\log_n(1) = 0$ for any $n>0, n\\neq 1.$" :db/ensure [:question/validate]} {:db/id 17592186064187 :knowledge-point/questions ["question-bb68a7c2-cb48-5196-952e-fea6e54d1914" "question-277ed942-8515-5af5-8070-395ac017b6ed"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064062 :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $2^{-5} = \\dfrac{1}{32}$ with $a = b^x,$ we get $a = \\dfrac{1}{32}, b = 2,$ and $x=-5.$\n\nTherefore, the given equation can be expressed as $\\log_{2}\\left( \\dfrac{1}{32} \\right)= -5.$" :db/ensure [:question/validate]} {:db/id 17592186064186 :knowledge-point/questions ["question-79a0a9c5-85f5-5fac-9044-aee801b38acc" "question-3dd9e34f-3ee0-5a42-8a59-8773ae3a745a" "question-be53ea1d-fce1-50b2-b27f-f485b9e423e6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064061 :question/worked-solution "Notice that the given approximation can be written using exponents:\n\n$$\n5^{1/3} \\approx 1.709\n$$\n\nThe logarithm of $a$ with base $b$ is defined as follows:\n\n$a = b^x$ is equivalent to $\\log_{b}{a} = x$\n\nIf we compare $5^{1/3} \\approx 1.709$ with $a = b^x,$ we get $a = 1.709, b = 5,$ and $x=\\dfrac{1}{3}.$\n\nTherefore, the approximation $\\sqrt[3]{5} \\approx 1.709$ is equivalent to $\\log_{5}(1.709) \\approx \\dfrac{1}{3}.$" :db/ensure [:question/validate]} {:db/id "question-084b231a-35a2-58f7-86fa-95eb22a6b762" :question/id #uuid "084b231a-35a2-58f7-86fa-95eb22a6b762" :question/math-academy-id "q-66551" :question/problem "${2}^{x}=32$ is equivalent to" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$a={b}^{x}$ is equivalent to ${log}_{b}⁡a=x$\n\nIf we compare ${2}^{x}=32$ with $a={b}^{x},$ we get $a=32$ and $b=2.$\n\nTherefore, the equation ${2}^{x}=32$ is equivalent to ${log}_{2}⁡32=x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dcd57e18-4821-54a3-925c-9c080aae5c81"] :db/ensure [:question/validate]} {:db/id "answer-field-dcd57e18-4821-54a3-925c-9c080aae5c81" :answer-field/id #uuid "dcd57e18-4821-54a3-925c-9c080aae5c81" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bf5c1add-f890-555f-a