5-5b99-a446-1bd8177ba166" :db/ensure [:step/validate]} {:db/id "step-c4b1e2ec-9235-5b99-a446-1bd8177ba166" :step/id #uuid "c4b1e2ec-9235-5b99-a446-1bd8177ba166" :step/content 17592186435769 :step/next "step-787b572f-897d-5eaa-9a27-f245e1f5c0a7" :db/ensure [:step/validate]} {:db/id "step-787b572f-897d-5eaa-9a27-f245e1f5c0a7" :step/id #uuid "787b572f-897d-5eaa-9a27-f245e1f5c0a7" :step/content "question-e3cff1af-b64e-5d5d-98b9-281348f5cad1" :db/ensure [:step/validate]} {:db/id 17592186083206 :knowledge-point/questions ["question-8b1e4f44-4956-589a-9c17-f83b0ba4a3a8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8b1e4f44-4956-589a-9c17-f83b0ba4a3a8" :question/id #uuid "8b1e4f44-4956-589a-9c17-f83b0ba4a3a8" :question/math-academy-id "q-78875" :question/problem "What is the center of the hyperbola \n$-2{x}^{2}+{y}^{2}+12x=22?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-2{x}^{2}+{y}^{2}+12x & =22 \\\\ {y}^{2}-2{x}^{2}+12x & =22 \\\\ {y}^{2}-2[{x}^{2}-6x] & =22 \\\\ {y}^{2}-2[(x-3)^{2}-9] & =22 \\\\ {y}^{2}-2(x-3)^{2}+18 & =22 \\\\ {y}^{2}-2(x-3)^{2} & =4 \\\\ \\frac{{y}^{2}}{4}-\\frac{(x-3)^{2}}{2} & =1.\\end{aligned}\n$$\n\nHence, the center is $(3,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7ab6b180-5886-5fce-b593-a7f57abd9934"] :db/ensure [:question/validate]} {:db/id "answer-field-7ab6b180-5886-5fce-b593-a7f57abd9934" :answer-field/id #uuid "7ab6b180-5886-5fce-b593-a7f57abd9934" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4bb0fc0f-bf85-5518-928f-1cafb2c16529" :answer-field/choices ["answer-9c303c00-caa4-5f9d-8c1a-1ca9c6fcd03b" "answer-cdd4a15f-4c53-5773-bc25-202bcb38bcc4" "answer-96bf2692-6abc-5e43-bb6a-a762a71a5d9f" "answer-4bb0fc0f-bf85-5518-928f-1cafb2c16529" "answer-50670be3-e6f8-5681-b49f-24e8d755ea39"] :db/ensure [:answer-field/validate]} {:db/id "answer-9c303c00-caa4-5f9d-8c1a-1ca9c6fcd03b" :answer/id #uuid "9c303c00-caa4-5f9d-8c1a-1ca9c6fcd03b" :answer/type :answer.type/math :answer/value "(0,-3)" :db/ensure [:answer/validate]} {:db/id "answer-cdd4a15f-4c53-5773-bc25-202bcb38bcc4" :answer/id #uuid "cdd4a15f-4c53-5773-bc25-202bcb38bcc4" :answer/type :answer.type/math :answer/value "(0,3)" :db/ensure [:answer/validate]} {:db/id "answer-96bf2692-6abc-5e43-bb6a-a762a71a5d9f" :answer/id #uuid "96bf2692-6abc-5e43-bb6a-a762a71a5d9f" :answer/type :answer.type/math :answer/value "(2,4)" :db/ensure [:answer/validate]} {:db/id "answer-4bb0fc0f-bf85-5518-928f-1cafb2c16529" :answer/id #uuid "4bb0fc0f-bf85-5518-928f-1cafb2c16529" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "answer-50670be3-e6f8-5681-b49f-24e8d755ea39" :answer/id #uuid "50670be3-e6f8-5681-b49f-24e8d755ea39" :answer/type :answer.type/math :answer/value "(4,-2)" :db/ensure [:answer/validate]} {:db/id 17592186083299 :knowledge-point/questions ["question-087134b9-662e-5552-a87e-db77c3a63f60"] :db/ensure [:knowledge-point/validate]} {:db/id "question-087134b9-662e-5552-a87e-db77c3a63f60" :question/id #uuid "087134b9-662e-5552-a87e-db77c3a63f60" :question/math-academy-id "q-328385" :question/problem "The center of the hyperbola ${x}^{2}-4{y}^{2}-10x-16y=-5$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}{x}^{2}-4{y}^{2}-10x-16y & =-5 \\\\ ({x}^{2}-10x)-4({y}^{2}+4y) & =-5 \\\\ [(x-5)^{2}-25]-4[(y+2)^{2}-4] & =-5 \\\\ (x-5)^{2}-25-4(y+2)^{2}+16 & =-5 \\\\ (x-5)^{2}-4(y+2)^{2} & =-5+25-16 \\\\ (x-5)^{2}-4(y+2)^{2} & =4 \\\\ \\frac{(x-5)^{2}}{{2}^{2}}-\\frac{(y+2)^{2}}{{1}^{2}} & =1 \\\\ \\frac{(x-5)^{2}}{{2}^{2}}-\\frac{(y-(-2))^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,-2\\,).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e97b146a-e8c3-55b4-8e8f-3964de4d579f" "answer-field-23bd27e0-e3b8-5bc4-b875-9e4e847fe61f"] :db/ensure [:question/validate]} {:db/id "answer-field-e97b146a-e8c3-55b4-8e8f-3964de4d579f" :answer-field/id #uuid "e97b146a-e8c3-55b4-8e8f-3964de4d579f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8dae7fc1-bd49-5916-99bf-03b7065df2d0" :answer-field/choices ["answer-8dae7fc1-bd49-5916-99bf-03b7065df2d0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8dae7fc1-bd49-5916-99bf-03b7065df2d0" :answer/id #uuid "8dae7fc1-bd49-5916-99bf-03b7065df2d0" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-23bd27e0-e3b8-5bc4-b875-9e4e847fe61f" :answer-field/id #uuid "23bd27e0-e3b8-5bc4-b875-9e4e847fe61f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ebed1d30-fad8-5df1-9e58-87c5b6d27c3d" :answer-field/choices ["answer-ebed1d30-fad8-5df1-9e58-87c5b6d27c3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ebed1d30-fad8-5df1-9e58-87c5b6d27c3d" :answer/id #uuid "ebed1d30-fad8-5df1-9e58-87c5b6d27c3d" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "activity-70bed377-303f-52ed-ba33-64c27a0f6c4c" :activity/id #uuid "70bed377-303f-52ed-ba33-64c27a0f6c4c" :activity/title "Equations of Hyperbolas Centered at a General Point" :activity/type :activity.type/review :activity/scope 17592186048866 :activity/course 17592186046658 :activity/steps ["step-e0c9e754-560b-5677-918d-6b010c51852e" "step-32d10c9d-46da-51f3-9257-1ce9131f007f" "step-b97c8dac-8e2f-5613-956d-8cb23b94c77e" "step-5023a990-c640-5750-a60e-6cca22cae8a6" "step-873f02d4-780d-556f-85c8-e028c9f3e094"] :activity/first-step "step-e0c9e754-560b-5677-918d-6b010c51852e" :db/ensure [:activity/validate]} {:db/id "step-e0c9e754-560b-5677-918d-6b010c51852e" :step/id #uuid "e0c9e754-560b-5677-918d-6b010c51852e" :step/content 17592186348116 :step/next "step-32d10c9d-46da-51f3-9257-1ce9131f007f" :db/ensure [:step/validate]} {:db/id "step-32d10c9d-46da-51f3-9257-1ce9131f007f" :step/id #uuid "32d10c9d-46da-51f3-9257-1ce9131f007f" :step/content "question-8b1e4f44-4956-589a-9c17-f83b0ba4a3a8" :step/next "step-b97c8dac-8e2f-5613-956d-8cb23b94c77e" :db/ensure [:step/validate]} {:db/id "step-b97c8dac-8e2f-5613-956d-8cb23b94c77e" :step/id #uuid "b97c8dac-8e2f-5613-956d-8cb23b94c77e" :step/content "question-087134b9-662e-5552-a87e-db77c3a63f60" :step/next "step-5023a990-c640-5750-a60e-6cca22cae8a6" :db/ensure [:step/validate]} {:db/id "step-5023a990-c640-5750-a60e-6cca22cae8a6" :step/id #uuid "5023a990-c640-5750-a60e-6cca22cae8a6" :step/content 17592186302439 :step/next "step-873f02d4-780d-556f-85c8-e028c9f3e094" :db/ensure [:step/validate]} {:db/id "step-873f02d4-780d-556f-85c8-e028c9f3e094" :step/id #uuid "873f02d4-780d-556f-85c8-e028c9f3e094" :step/content 17592186304771 :db/ensure [:step/validate]} {:db/id 17592186064167 :knowledge-point/questions ["question-7c1117fb-96ed-5032-8c50-48772b44cf5c" "question-a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064038 :question/problem "Calculate $\\displaystyle \\int x^2 \\,\\textrm d x.$" :question/worked-solution "We apply the power rule with $n=2$, and we get\n\n$$\n\\int x^2 \\,\\textrm d x = \\dfrac{x^{2+1}}{2+1} + C = \\dfrac{x^3}{3}+C.\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{3}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{3}}{3})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3})+0 & = \\\\ \\frac{1}{3}\\cdot 3{x}^{2} & = \\\\ {x}^{2}\\,✓\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064168 :knowledge-point/questions ["question-34621fcb-1a0d-5d3e-9880-09e09830a08f" "question-37cc1eff-0240-5120-ba5e-14ada8bc6fca"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064039 :question/problem "Find the antiderivative of  $\\sqrt x.$" :question/worked-solution "We start by writing the square root as a rational power, $\\sqrt x= x^{1/2}.$ So, we can apply the power rule with $n=\\dfrac{1}{2}$ and get\n\n$$\n\\begin{aligned}\\int \\sqrt{x}\\,\\text{d}x & =\\int {x}^{1/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{1/2+1}}{(\\frac{1}{2}+1)}+C \\\\  & =\\frac{{x}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2{x}^{3/2}}{3}+C.\\end{aligned}\n$$\n\nAgain, let's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{3/2}}{3}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{2{x}^{3/2}}{3})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{2}{3}\\frac{\\text{d}}{\\text{d}x}({x}^{3/2})+0 & = \\\\ \\frac{2}{3}\\cdot \\frac{3}{2}{x}^{3/2-1} & = \\\\ {x}^{1/2}\\,✓\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064169 :knowledge-point/questions ["question-3ce88619-593c-543d-be7b-78867655bb11" "question-28f4ccc6-88e6-5461-934d-fc36db9c8ad4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064040 :question/problem "Given that $f(x) = \\dfrac 1 {x^3}$ and that $F'(x) = f(x)$, calculate $F(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if $F'(x) = f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNote that $\\dfrac 1 {x^3}= x^{-3}.$ So, we can use the power rule with $n=-3$ and get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =\\int {x}^{-3}\\,\\text{d}x \\\\  & =\\frac{{x}^{-3+1}}{-3+1}+C \\\\  & =-\\frac{{x}^{-2}}{2}+C \\\\  & =-\\frac{1}{2{x}^{2}}+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-7c1117fb-96ed-5032-8c50-48772b44cf5c" :question/id #uuid "7c1117fb-96ed-5032-8c50-48772b44cf5c" :question/math-academy-id "q-113668" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{13}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=13$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{13}\\,\\text{d}x \\\\  & =\\frac{{x}^{13+1}}{13+1}+C \\\\  & =\\frac{{x}^{14}}{14}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{14}}{14})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{14}\\frac{\\text{d}}{\\text{d}x}({x}^{14})+0 & = \\\\ \\frac{1}{14}\\cdot 14\\,{x}^{13} & = \\\\ {x}^{13}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c8fbc5ea-5d9e-52eb-88d3-b4d6971c6c74"] :db/ensure [:question/validate]} {:db/id "answer-field-c8fbc5ea-5d9e-52eb-88d3-b4d6971c6c74" :answer-field/id #uuid "c8fbc5ea-5d9e-52eb-88d3-b4d6971c6c74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer-field/choices ["answer-f56d5cb2-21a5-51fe-8738-17f8affe9a15" "answer-a01e6e97-6d87-5937-8e57-076aaa390207" "answer-3ddf04c2-71d3-54b1-9f4b-d9699e9cc552" "answer-69f7fd71-6066-58ff-973d-5a24b0715dc7" "answer-a8adc543-25c4-55be-8081-e8857819cce0"] :db/ensure [:answer-field/validate]} {:db/id "answer-f56d5cb2-21a5-51fe-8738-17f8affe9a15" :answer/id #uuid "f56d5cb2-21a5-51fe-8738-17f8affe9a15" :answer/type :answer.type/math :answer/value "13{x}^{14}+C" :db/ensure [:answer/validate]} {:db/id "answer-a01e6e97-6d87-5937-8e57-076aaa390207" :answer/id #uuid "a01e6e97-6d87-5937-8e57-076aaa390207" :answer/type :answer.type/math :answer/value "\\frac{{x}^{12}}{12}+C" :db/ensure [:answer/validate]} {:db/id "answer-3ddf04c2-71d3-54b1-9f4b-d9699e9cc552" :answer/id #uuid "3ddf04c2-71d3-54b1-9f4b-d9699e9cc552" :answer/type :answer.type/math :answer/value "\\frac{{x}^{12}}{13}+C" :db/ensure [:answer/validate]} {:db/id "answer-69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/id #uuid "69f7fd71-6066-58ff-973d-5a24b0715dc7" :answer/type :answer.type/math :answer/value "\\frac{{x}^{14}}{14}+C" :db/ensure [:answer/validate]} {:db/id "answer-a8adc543-25c4-55be-8081-e8857819cce0" :answer/id #uuid "a8adc543-25c4-55be-8081-e8857819cce0" :answer/type :answer.type/math :answer/value "{x}^{14}+C" :db/ensure [:answer/validate]} {:db/id "question-a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c" :question/id #uuid "a4e1eabf-8b25-5ba2-8660-9b7cb6a5610c" :question/math-academy-id "q-29994" :question/problem "Calculate $F(x)$ given that $f(x)={x}^{4}$ and ${F}^{′}(x)=f(x).$" :question/worked-solution "Remember that integration is the opposite of differentiation. So, if ${F}^{′}(x)=f(x),$ then integrating both sides of this equation gives\n\n$$\n\\begin{aligned}{F}^{′}(x) & =f(x) \\\\ \\int {F}^{′}(x)\\,\\text{d}x & =\\int f(x)\\,\\text{d}x \\\\ F(x) & =\\int f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe apply the power rule with $n=4$, and we get\n\n$$\n\\begin{aligned}F(x) & =\\int f(x)\\,\\text{d}x \\\\  & =\\int {x}^{4}\\,\\text{d}x \\\\  & =\\frac{{x}^{4+1}}{4+1}+C \\\\  & =\\frac{{x}^{5}}{5}+C.\\end{aligned}\n$$\n\nLet's check by differentiating:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5}+C) & = \\\\ \\frac{\\text{d}}{\\text{d}x}(\\frac{{x}^{5}}{5})+\\frac{\\text{d}}{\\text{d}x}(C) & = \\\\ \\frac{1}{5}\\frac{\\text{d}}{\\text{d}x}({x}^{5})+0 & = \\\\ \\frac{1}{5}\\cdot 5{x}^{4} & = \\\\ {x}^{4}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ee20556c-e250-51aa-b85c-fc28797d2901"] :db/ensure [:question/validate]} {:db/id "answer-field-ee20556c-e250-51aa-b85c-fc28797d2901" :answer-field/id #uuid "ee20556c-e250-51aa-b85c-fc28797d2901" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer-field/choices ["answer-0387228b-625c-57a2-b9a5-65db0be7f989" "answer-78df9ad8-f292-595e-872f-5f8ef18126cc" "answer-6b8e57bc-7acc-5bac-a92c-82592c8e49c3" "answer-b224165e-2200-5c30-be67-560f8a090e5f" "answer-aaf0e947-1093-5e50-a47b-29c991bd99cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-0387228b-625c-57a2-b9a5-65db0be7f989" :answer/id #uuid "0387228b-625c-57a2-b9a5-65db0be7f989" :answer/type :answer.type/math :answer/value "4{x}^{5}+C" :db/ensure [:answer/validate]} {:db/id "answer-78df9ad8-f292-595e-872f-5f8ef18126cc" :answer/id #uuid "78df9ad8-f292-595e-872f-5f8ef18126cc" :answer/type :answer.type/math :answer/value "5{x}^{5}+C" :db/ensure [:answer/validate]} {:db/id "answer-6b8e57bc-7acc-5bac-a92c-82592c8e49c3" :answer/id #uuid "6b8e57bc-7acc-5bac-a92c-82592c8e49c3" :answer/type :answer.type/math :answer/value "\\frac{{x}^{4}}{4}+C" :db/ensure [:answer/validate]} {:db/id "answer-b224165e-2200-5c30-be67-560f8a090e5f" :answer/id #uuid "b224165e-2200-5c30-be67-560f8a090e5f" :answer/type :answer.type/math :answer/value "\\frac{{x}^{4}}{5}+C" :db/ensure [:answer/validate]} {:db/id "answer-aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/id #uuid "aaf0e947-1093-5e50-a47b-29c991bd99cb" :answer/type :answer.type/math :answer/value "\\frac{{x}^