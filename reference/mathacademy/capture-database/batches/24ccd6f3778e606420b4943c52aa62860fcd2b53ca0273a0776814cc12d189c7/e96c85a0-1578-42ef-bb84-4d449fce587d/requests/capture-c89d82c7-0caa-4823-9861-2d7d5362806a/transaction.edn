\ (2)^{3}\\cdot (x)^{3} & = \\\\ (8)\\cdot ({x}^{3}) & = \\\\ 8{x}^{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105851 :knowledge-point/questions ["question-d79e08d6-96d7-5dc0-acd2-d317f660f1d0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105442 :question/problem "Simplify the expression $\\left(pq^{-2}\\right)^3.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(p{q}^{-2})}^{3} & = \\\\ {p}^{3}\\cdot {({q}^{-2})}^{3} & = \\\\ {p}^{3}\\cdot {q}^{(-2)(3)} & = \\\\ {p}^{3}{q}^{-6} & = \\\\ \\frac{{p}^{3}}{{q}^{6}}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105852 :knowledge-point/questions ["question-36aeac2d-5deb-59f2-8d1b-a76ca9d4f792" "question-6a85d6f0-241d-535a-97b2-3383eef73354"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105443 :question/problem "Simplify $(2x^2y^{-1})^{-4}.$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}(2{x}^{2}{y}^{-1})^{-4} & = \\\\ {2}^{-4}\\cdot ({x}^{2})^{-4}\\cdot ({y}^{-1})^{-4} & = \\\\ \\frac{1}{{2}^{4}}\\cdot {x}^{(2)(-4)}\\cdot {y}^{(-1)(-4)} & = \\\\ \\frac{1}{16}\\cdot {x}^{-8}\\cdot {y}^{4} & = \\\\ \\frac{1}{16}\\cdot \\frac{1}{{x}^{8}}\\cdot {y}^{4} & = \\\\ \\frac{{y}^{4}}{16{x}^{8}}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-8c05d166-8209-505e-9ddb-93264370350e" :question/id #uuid "8c05d166-8209-505e-9ddb-93264370350e" :question/math-academy-id "q-51802" :question/problem "${(5w)}^{3}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(5w)}^{3} & = \\\\ {5}^{3}\\cdot {w}^{3} & = \\\\ 125{w}^{3} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-94b7ce7b-ab6b-5593-b657-22ea9bd8ade0"] :db/ensure [:question/validate]} {:db/id "answer-field-94b7ce7b-ab6b-5593-b657-22ea9bd8ade0" :answer-field/id #uui