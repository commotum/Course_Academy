2}\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{v}^{9}\\cdot \\frac{{v}^{5}}{{v}^{12}}={v}^{2}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ca0326c8-0f04-5e25-9913-33c2c01289fb"] :db/ensure [:question/validate]} {:db/id "answer-field-ca0326c8-0f04-5e25-9913-33c2c01289fb" :answer-field/id #uuid "ca0326c8-0f04-5e25-9913-33c2c01289fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3cc7469a-4c5a-5c02-a707-a6d244caa391" :answer-field/choices ["answer-da946435-d01a-5a40-bc6e-afdd394c6d14" "answer-e9bbb3c6-e4c5-5c33-82a6-4a8eea794f84" "answer-68550f76-8068-5a20-95d4-041e618def53" "answer-32b1c548-49f0-5278-ade5-87ae9a836c68" "answer-3cc7469a-4c5a-5c02-a707-a6d244caa391"] :db/ensure [:answer-field/validate]} {:db/id "answer-da946435-d01a-5a40-bc6e-afdd394c6d14" :answer/id #uuid "da946435-d01a-5a40-bc6e-afdd394c6d14" :answer/type :answer.type/math :answer/value "\\frac{1}{{v}^{16}}" :db/ensure [:answer/validate]} {:db/id "answer-e9bbb3c6-e4c5-5c33-82a6-4a8eea794f84" :answer/id #uuid "e9bbb3c6-e4c5-5c33-82a6-4a8eea794f84" :answer/type :answer.type/math :answer/value "\\frac{1}{{v}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-68550f76-8068-5a20-95d4-041e618def53" :answer/id #uuid "68550f76-8068-5a20-95d4-041e618def53" :answer/type :answer.type/math :answer/value "v" :db/ensure [:answer/validate]} {:db/id "answer-32b1c548-49f0-5278-ade5-87ae9a836c68" :answer/id #uuid "32b1c548-49f0-5278-ade5-87ae9a836c68" :answer/type :answer.type/math :answer/value "{v}^{16}" :db/ensure [:answer/validate]} {:db/id "answer-3cc7469a-4c5a-5c02-a707-a6d244caa391" :answer/id #uuid "3cc7469a-4c5a-5c02-a707-a6d244caa391" :answer/type :answer.type/math :answer/value "{v}^{2}" :db/ensure [:answer/validate]} {:db/id "question-3be04767-4c26-5347-b891-6186a74ead6b" :question/id #uuid "3be04767-4c26-5347-b891-6186a74ead6b" :question/math-academy-id "q-72679" :question/problem "Simplify the  expression\n$\\frac{n}{{n}^{4}}\\cdot {n}^{8}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{n}{{n}^{4}}\\cdot {n}^{8} & = \\\\ {n}^{1-4}\\cdot {n}^{8} & = \\\\ {n}^{-3}\\cdot {n}^{8} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{n}^{-3}\\cdot {n}^{8} & = \\\\ {n}^{-3+8} & = \\\\ {n}^{5} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{n}{{n}^{4}}\\cdot {n}^{8}={n}^{5}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8002220d-d13b-50ca-8bb3-c0601d2f074c"] :db/ensure [:question/validate]} {:db/id "answer-field-8002220d-d13b-50ca-8bb3-c0601d2f074c" :answer-field/id #uuid "8002220d-d13b-50ca-8bb3-c0601d2f074c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-faa77c94-d4f3-50ef-910c-42b7691e88dc" :answer-field/choices ["answer-de68479f-5cc4-51ec-9379-a49578fc8571" "answer-c47043fe-0892-5394-979e-3e1a613032ca" "answer-aec841b0-1b3a-503b-aa83-5840f21c3f9f" "answer-36100c30-c4a8-5793-b8d3-4e0f727b569a" "answer-faa77c94-d4f3-50ef-910c-42b7691e88dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-de68479f-5cc4-51ec-9379-a49578fc8571" :answer/id #uuid "de68479f-5cc4-51ec-9379-a49578fc8571" :answer/type :answer.type/math :answer/value "{n}^{-12}" :db/ensure [:answer/validate]} {:db/id "answer-c47043fe-0892-5394-979e-3e1a613032ca" :answer/id #uuid "c47043fe-0892-5394-979e-3e1a613032ca" :answer/type :answer.type/math :answer/value "{n}^{-3}" :db/ensure [:answer/validate]} {:db/id "answer-aec841b0-1b3a-503b-aa83-5840f21c3f9f" :answer/id #uuid "aec841b0-1b3a-503b-aa83-5840f21c3f9f" :answer/type :answer.type/math :answer/value "{n}^{12}" :db/ensure [:answer/validate]} {:db/id "answer-36100c30-c4a8-5793-b8d3-4e0f727b569a" :answer/id #uuid "36100c30-c4a8-5793-b8d3-4e0f727b569a" :answer/type :answer.type/math :answer/value "{n}^{14}" :db/ensure [:answer/validate]} {:db/id "answer-faa77c94-d4f3-50ef-910c-42b7691e88dc" :answer/id #uuid "faa77c94-d4f3-50ef-910c-42b7691e88dc" :answer/type :answer.type/math :answer/value "{n}^{5}" :db/ensure [:answer/validate]} {:db/id "question-8ac0604e-5343-56c6-8dd6-8c555b217bdc" :question/id #uuid "8ac0604e-5343-56c6-8dd6-8c555b217bdc" :question/math-academy-id "q-72682" :question/problem "Simplify the  expression\n${q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}} & = \\\\ {q}^{2}\\cdot {q}^{3-8} & = \\\\ {q}^{2}\\cdot {q}^{-5} & \\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot {q}^{-5} & = \\\\ {q}^{2+(-5)} & = \\\\ {q}^{2-5} & = \\\\ {q}^{-3} & = \\\\ \\frac{1}{{q}^{3}} & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{q}^{2}\\cdot \\frac{{q}^{3}}{{q}^{8}}=\\frac{1}{{q}^{3}}.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-18a56d48-4b3b-5ee9-aa5b-0b92f3bd8a6d"] :db/ensure [:question/validate]} {:db/id "answer-field-18a56d48-4b3b-5ee9-aa5b-0b92f3bd8a6d" :answer-field/id #uuid "18a56d48-4b3b-5ee9-aa5b-0b92f3bd8a6d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer-field/choices ["answer-e0f90363-cd83-574a-8e4c-59b61b493419" "answer-64ef98c1-92eb-56d9-954f-a4978e35f40c" "answer-00ddfa3b-7d8d-5460-89cf-64315fc87036" "answer-46a86097-4fe5-5eec-b23c-2d48991beefe" "answer-4692b4b8-c0ef-5a31-bbc7-0c0cee5491eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0f90363-cd83-574a-8e4c-59b61b493419" :answer/id #uuid "e0f90363-cd83-574a-8e4c-59b61b493419" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer/id #uuid "64ef98c1-92eb-56d9-954f-a4978e35f40c" :answer/type :answer.type/math :answer/value "\\frac{1}{{q}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-00ddfa3b-7d8d-5460-89cf-64315fc87036" :answer/id #uuid "00ddfa3b-7d8d-5460-89cf-64315fc87036" :answer/type :answer.type/math :answer/value "\\frac{1}{{q}^{5}}" :db/ensure [:answer/validate]} {:db/id "answer-46a86097-4fe5-5eec-b23c-2d48991beefe" :answer/id #uuid "46a86097-4fe5-5eec-b23c-2d48991beefe" :answer/type :answer.type/math :answer/value "{q}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-4692b4b8-c0ef-5a31-bbc7-0c0cee5491eb" :answer/id #uuid "4692b4b8-c0ef-5a31-bbc7-0c0cee5491eb" :answer/type :answer.type/math :answer/value "{q}^{5}" :db/ensure [:answer/validate]} {:db/id "question-0e69e5e6-7016-5a90-88d1-935042e944fb" :question/id #uuid "0e69e5e6-7016-5a90-88d1-935042e944fb" :question/math-academy-id "q-72677" :question/problem "Simplify ${a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}}.$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}{a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}} & = \\\\ {a}^{5}\\cdot {a}^{(-3-2)} & = \\\\ {a}^{5}\\cdot {a}^{-5} & \\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{a}^{5}\\cdot {a}^{-5} & = \\\\ {a}^{5+(-5)} & = \\\\ {a}^{5-5} & = \\\\ {a}^{0} & = \\\\ 1 & \\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}{a}^{5}\\cdot \\frac{{a}^{-3}}{{a}^{2}}=1.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2f65387b-3f20-5940-81f4-84e80b5a99c3"] :db/ensure [:question/validate]} {:db/id "answer-field-2f65387b-3f20-5940-81f4-84e80b5a99c3" :answer-field/id #uuid "2f65387b-3f20-5940-81f4-84e80b5a99c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2655cd3b-2747-5203-9113-5c1c82e5f477" :answer-field/choices ["answer-2655cd3b-2747-5203-9113-5c1c82e5f477" "answer-4a5d0cba-b75a-5db6-8ed5-3ab5cbf01c72" "answer-daa1f54f-f802-5d5b-a24b-5777fb6a7514" "answer-3dcd1809-ac2d-5261-ae5d-73e582ca6db3" "answer-dfd7bb96-cae9-57b2-980a-b903d96581dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-2655cd3b-2747-5203-9113-5c1c82e5f477" :answer/id #uuid "2655cd3b-2747-5203-9113-5c1c82e5f477" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-4a5d0cba-b75a-5db6-8ed5-3ab5cbf01c72" :answer/id #uuid "4a5d0cba-b75a-5db6-8ed5-3ab5cbf01c72" :answer/type :answer.type/math :answer/value "\\frac{1}{a}" :db/ensure [:answer/validate]} {:db/id "answer-daa1f54f-f802-5d5b-a24b-5777fb6a7514" :answer/id #uuid "daa1f54f-f802-5d5b-a24b-5777fb6a7514" :answer/type :answer.type/math :answer/value "a" :db/ensure [:answer/validate]} {:db/id "answer-3dcd1809-ac2d-5261-ae5d-73e582ca6db3" :answer/id #uuid "3dcd1809-ac2d-5261-ae5d-73e582ca6db3" :answer/type :answer.type/math :answer/value "{a}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-dfd7bb96-cae9-57b2-980a-b903d96581dc" :answer/id #uuid "dfd7bb96-cae9-57b2-980a-b903d96581dc" :answer/type :answer.type/math :answer/value "{a}^{4}" :db/ensure [:answer/validate]} {:db/id 17592186065337 :tutorial/content "The **quotient rule for exponents** states that when we divide two exponents that have the same base, we take the difference of the exponents in the numerator and denominator:\n\n$$\n\\dfrac{a^n}{a^m}=a^{n-m}\n$$\n\nFor example, \n\n$$\n\\begin{aligned}\\frac{{a}^{5}}{{a}^{2}} & = \\\\ {a}^{(5-2)} & = \\\\ {a}^{3}.\\end{aligned}\n$$\n\nTo see why the quotient rule is true, let's take the above example and work it out again, the long way.\n\nFor the two terms $a^5$ and $a^2$ we have $a^5 = a \\cdot a \\cdot a \\cdot a \\cdot a$ and $a^2 = a \\cdot a.$ If we now substitute these two expressions into $\\dfrac{a^5}{a^2},$ we get the same result:\n\n$$\n\\require{cancel}\n\\eqalign{\n\\dfrac{a^{5}}{a^2}&=\\\n\\dfrac {a \\cdot a \\cdot a \\cdot a \\cdot a} {a \\cdot a}&=\\\n\\dfrac {\\cancel{a} \\cdot \\cancel{a} \\cdot a \\cdot a \\cdot a} {\\cancel{a} \\cdot \\cancel{a} }&=\\\na \\cdot a \\cdot a &=\\\n a^3\n}\n$$\n\nThe quotient rule is just a shortcut for the process above." :db/ensure [:tutorial/validate]} {:db/id 17592186064459 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186184167 :knowledge-point/questions ["question-2e41850a-28e4-5827-a5c3-9f3e4e6f3d17"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2e41850a-28e4-5827-a5c3-9f3e4e6f3d17" :question/id #uuid "2e41850a-28e4-5827-a5c3-9f3e4e6f3d17" :question/math-academy-id "q-106939" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement:*\n\n*If $w$ and $v$ are vectors such that $x+w=v+x$ for some $x\\in V$, then $w=v.$*\n\n*Proof:*\n\n$$\n\\begin{aligned}x+w & =v+x &  & [\\,\\text{given}\\,] \\\\ (x+w)+(-x) & =(v+x)+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (w+x)+(-x) & =(v+x)+(-x) &  & [\\,\\text{axiom __}\\,\\,] \\\\ w+(x+(-x)) & =v+(x+(-x)) &  & [\\,\\text{axiom A2}\\,] \\\\ w+0 & =v+0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ w & =v &  & [\\,\\text{axiom A3}\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following:\n\n$$\n\\begin{aligned}x+w & =v+x &  & [\\,\\text{given}\\,] \\\\ (x+w)+(-x) & =(v+x)+(-x) &  & [\\,\\text{add }-x\\text{ to both sides}\\,] \\\\ (w+x)+(-x) & =(v+x)+(-x) &  & [\\,\\text{axiom }\\text{A1}\\,] \\\\ w+(x+(-x)) & =v+(x+(-x)) &  & [\\,\\text{axiom A2}\\,] \\\\ w+0 & =v+0 &  & [\\,\\text{axiom }\\text{A4}\\,] \\\\ w & =v &  & [\\,\\text{axiom A3}\\,]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-897bc76a-4fe0-590f-a184-6c52a1eda1ae"] :db/ensure [:question/validate]} {:db/id "answer-field-897bc76a-4fe0-590f-a184-6c52a1eda1ae" :answer-field/id #uuid "897bc76a-4fe0-590f-a184-6c52a1eda1ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8a695bc-1cc3-56a9-b517-f1c7b9def310" :answer-field/choices ["answer-cb268be9-b031-56df-a9d8-c22c7df876bd" "answer-f8a695bc-1cc3-56a9-b517-f1c7b9def310" "answer-72a2d8f5-2bbf-5e10-a196-ab974c840f94" "answer-db62e16b-6046-5b50-b4ef-540d0fefbf90" "answer-667d5399-0313-59af-b2e0-802df62fe40c"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb268be9-b031-56df-a9d8-c22c7df876bd" :answer/id #uuid "cb268be9-b031-56df-a9d8-c22c7df876bd" :answer/type :answer.type/text :answer/value "$\\text{A1}$, $\\text{A2}$" :db/ensure [:answer/validate]} {:db/id "answer-f8a695bc-1cc3-56a9-b517-f1c7b9def310" :answer/id #uuid "f8a695bc-1cc3-56a9-b517-f1c7b9def310" :answer/type :answer.type/text :answer/value "$\\text{A1}$, $\\text{A4}$" :db/ensure [:answer/validate]} {:db/id "answer-72a2d8f5-2bbf-5e10-a196-ab974c840f94" :answer/id #uuid "72a2d8f5-2bbf-5e10-a196-ab974c840f94" :answer/type :answer.type/text :answer/value "$\\text{A2}$, $\\text{A3}$" :db/ensure [:answer/validate]} {:db/id "answer-db62e16b-6046-5b50-b4ef-540d0fefbf90" :answer/id #uuid "db62e16b-6046-5b50-b4ef-540d0fefbf90" :answer/type :answer.type/text :answer/value "$\\text{A5}$, $\\text{A2}$" :db/ensure [:answer/validate]} {:db/id "answer-667d5399-0313-59af-b2e0-802df62fe40c" :answer/id #uuid "667d5399-0313-59af-b2e0-802df62fe40c" :answer/type :answer.type/text :answer/value "$\\text{A5}$, $\\text{A4}$" :db/ensure [:answer/validate]} {:db/id "activity-d507fccf-b7e1-5cc3-b520-c32805d9f383" :activity/id #uuid "d507fccf-b7e1-5cc3-b520-c32805d9f383" :activity/title "Defining Abstract Vector Spaces" :activity/type :activity.type/review :activity/scope 17592186049064 :activity/course 17592186046658 :activity/steps ["step-7a435581-1964-5e18-aaa9-6b2d8b1b3a49" "step-01573a3c-c095-5815-9e2c-e98160adf429" "step-12714b70-150c-5e2d-9693-0688dd834525" "step-7c6bc73d-ee47-53b9-9204-a829025e6e21" "step-37dee290-ae86-5ea7-bbc6-9de005b9ccaf"] :activity/first-step "step-7a435581-1964-5e18-aaa9-6b2d8b1b3a49" :db/ensure [:activity/validate]} {:db/id "step-7a435581-1964-5e18-aaa9-6b2d8b1b3a49" :step/id #uuid "7a435581-1964-5e18-aaa9-6b2d8b1b3a49" :step/content 17592186184764 :step/next "step-01573a3c-c095-5815-9e2c-e98160adf429" :db/ensure [:step/validate]} {:db/id "step-01573a3c-c095-5815-9e2c-e98160adf429" :step/id #uuid "01573a3c-c095-5815-9e2c-e98160adf429" :step/content 17592186423671 :step/next "step-12714b70-150c-5e2d-9693-0688dd834525" :db/ensure [:step/validate]} {:db/id "step-12714b70-150c-5e2d-9693-0688dd834525" :step/id #uuid "12714b70-150c-5e2d-9693-0688dd834525" :step/content 17592186419007 :step/next "step-7c6bc73d-ee47-53b9-9204-a829025e6e21" :db/ensure [:step/validate]} {:db/id "step-7c6bc73d-ee47-53b9-9204-a829025e6e21" :step/id #uuid "7c6bc73d-ee47-53b9-9204-a829025e6e21" :step/content 17592186360505 :step/next "step-37dee290-ae86-5ea7-bbc6-9de005b9ccaf" :db/ensure [:step/validate]} {:db/id "step-37dee290-ae86-5ea7-bbc6-9de005b9ccaf" :step/id #uuid "37dee290-ae86-5ea7-bbc6-9de005b9ccaf" :step/content "question-2e41850a-28e4-5827-a5c3-9f3e4e6f3d17" :db/ensure [:step/validate]} [:db/retract 17592186062137 :answer-field/choices 17592186062138] [:db/retract 17592186062137 :answer-field/choices 17592186062139] [:db/retract 17592186062137 :answer-field/choices 17592186062140] [:db/retract 17592186062137 :answer-field/choices 17592186062141] {:db/id 17592186064301 :knowledge-point/questions ["question-838d378f-b0d1-5666-9116-5d6a99c6b6ef"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063922 :question/problem "Find the value of $\\left(x^4\\right)^5.$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\eqalign{\n\\left(x^4\\right)^5\t&= \\\n\tx^{4\\cdot5} \t&= \\\n\tx^{20}\n}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064302 :knowledge-point/questions ["question-9fff3a3a-6d2c-53a9-a9af-98e3c6fa167d" "question-3a39a434-9b02-5a2a-9dbe-af926f01aaf3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063923 :question/problem "If $\\left(x^{-3}\\right)^{-6} = x^n,$ then what is $n?$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\eqalign{\n\t\\left(x^{-3}\\right)^{-6}&=\\\n\tx^{(-3)(-6)}&=\\\n\tx^{18}\n\t}\n$$\n\nTherefore $n=18.$" :db/ensure [:question/validate]} {:db/id 17592186064303 :knowledge-point/questions ["question-620bd9a5-9e55-517b-86cd-e6524b612924" "question-5af0acf2-3a19-5539-aae2-8a4b5d437d31"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063924 :question/problem "Simplify $\\sqrt[4]{x^{-8}}.$" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}\\sqrt[4]{{x}^{-8}} & = \\\\ ({x}^{-8})^{1/4} & = \\\\ {x}^{(-8)\\cdot (1/4)} & = \\\\ {x}^{-2} & = \\\\ \\frac{1}{{x}^{2}}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064304 :knowledge-point/questions ["question-2e9f1022-1926-5a16-afea-9527e06c53ee" "question-1d4b1ea1-1846-5966-be56-ba39843c102c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063925 :question/problem "If $\\left(\\dfrac{1}{\\sqrt[3]{x}}\\right)^4 \\cdot x = x^k$ for some constant $k$, then what is the value of $k?$" :question/worked-solution "First, we convert the radical to a fractional exponent, and then we apply the power rule:\n\n$$\n\\begin{aligned}{(\\frac{1}{\\sqrt[3]{x}})}^{4}\\cdot x & = \\\\ {(\\frac{1}{{x}^{1/3}})}^{4}\\cdot x & = \\\\ {({x}^{-1/3})}^{4}\\cdot x & = \\\\ {x}^{(-1/3)\\cdot (4)}\\cdot x & = \\\\ {x}^{-4/3}\\cdot x & \\end{aligned}\n$$\n\nFinally, we apply the product rule, adding the exponents:\n\n$$\n\\begin{aligned}{x}^{-4/3}\\cdot x & = \\\\ {x}^{-4/3}\\cdot {x}^{1} & = \\\\ {x}^{-4/3+1} & = \\\\ {x}^{-4/3+3/3} & = \\\\ {x}^{-1/3}\\end{aligned}\n$$\n\nTherefore $k=-\\dfrac{1}{3}.$" :db/ensure [:question/validate]} {:db/id 17592186064680 :question/problem "${({x}^{3})}^{2}=$" :question/worked-solution "We multiply the exponents, as follows:\n\n$$\n\\begin{aligned}{({x}^{3})}^{2} & = \\\\ {x}^{3\\cdot 2} & = \\\\ {x}^{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186062137 :answer-field/correct "answer-f420442c-2ea5-5787-b932-56815d206555" :answer-field/choices ["answer-7520ecfb-f9a7-524f-bf87-8ffcdf00908f" "answer-c2eaa2de-f3f4-5729-9fa0-3e79bcc9411f" "answer-f420442c-2ea5-5787-b932-56815d206555" "answer-15a52a15-30d1-581c-aa62-354ee70fc6be"] :db/ensure [:answer-field/validate]} {:db/id "answer-7520ecfb-f9a7-524f-bf87-8ffcdf00908f" :answer/id #uuid "7520ecfb-f9a7-524f-bf87-8ffcdf00908f" :answer/type :answer.type/math :answer/value "{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c2eaa2de-f3f4-5729-9fa0-3e79bcc9411f" :answer/id #uuid "c2eaa2de-f3f4-5729-9fa0-3e79bcc9411f" :answer/type :answer.type/math :answer/value "{x}^{5}" :db/ensure [:answer/validate]} {:db/id "answer-f420442c-2ea5-5787-b932-56815d206555" :answer/id #uuid "f420442c-2ea5-5787-b932-56815d206555" :answer/type :answer.type/math :answer/value "{x}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-15a52a15-30d1-581c-aa62-354ee70fc6be" :answer/id #uuid "15a52a15-30d1-581c-aa62-