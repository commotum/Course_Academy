ot {p}^{(-3)(-3)} & = \\\\ -\\frac{1}{1\\,000}\\cdot {p}^{9} & = \\\\ -\\frac{{p}^{9}}{1\\,000} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3bfd20ac-635b-5cc4-9633-b6d3de267a5e"] :db/ensure [:question/validate]} {:db/id "answer-field-3bfd20ac-635b-5cc4-9633-b6d3de267a5e" :answer-field/id #uuid "3bfd20ac-635b-5cc4-9633-b6d3de267a5e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c16ec5a9-54e2-5072-99f0-3a0626aa8324" :answer-field/choices ["answer-8306d232-c66d-592b-83f7-03b3345b4fda" "answer-c16ec5a9-54e2-5072-99f0-3a0626aa8324" "answer-87ab9acb-0f0f-587a-a9b9-dd92ae5d0e1a" "answer-296939f6-2b9b-50e6-ab06-68d7d605f6f2" "answer-c6c9c830-b447-583e-8995-c9b3bce53b3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-8306d232-c66d-592b-83f7-03b3345b4fda" :answer/id #uuid "8306d232-c66d-592b-83f7-03b3345b4fda" :answer/type :answer.type/math :answer/value "-\\frac{{p}^{6}}{1\\,000}" :db/ensure [:answer/validate]} {:db/id "answer-c16ec5a9-54e2-5072-99f0-3a0626aa8324" :answer/id #uuid "c16ec5a9-54e2-5072-99f0-3a0626aa8324" :answer/type :answer.type/math :answer/value "-\\frac{{p}^{9}}{1\\,000}" :db/ensure [:answer/validate]} {:db/id "answer-87ab9acb-0f0f-587a-a9b9-dd92ae5d0e1a" :answer/id #uuid "87ab9acb-0f0f-587a-a9b9-dd92ae5d0e1a" :answer/type :answer.type/math :answer/value "\\frac{1\\,000}{{p}^{9}}" :db/ensure [:answer/validate]} {:db/id "answer-296939f6-2b9b-50e6-ab06-68d7d605f6f2" :answer/id #uuid "296939f6-2b9b-50e6-ab06-68d7d605f6f2" :answer/type :answer.type/math :answer/value "\\frac{1}{1\\,000{p}^{6}}" :db/ensure [:answer/validate]} {:db/id "answer-c6c9c830-b447-583e-8995-c9b3bce53b3d" :answer/id #uuid "c6c9c830-b447-583e-8995-c9b3bce53b3d" :answer/type :answer.type/math :answer/value "\\frac{1}{1\\,000{p}^{9}}" :db/ensure [:answer/validate]} {:db/id 17592186106276 :question/problem "${({a}^{-1}b)}^{-7}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{({a}^{-1}b)}^{-7} & = \\\\ {({a}^{-1})}^{-7}{(b)}^{-7} & = \\\\ {a}^{(-1)(-7)}\\cdot {b}^{-7} & = \\\\ {a}^{7}\\cdot {b}^{-7} & = \\\\ \\frac{{a}^{7}}{{b}^{7}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186103804 :answer-field/correct "answer-afd5fb21-1da5-53ab-8309-62489fc06914" :answer-field/choices ["answer-70d0b8a3-28af-5be2-a31c-e77c97c45d41" "answer-afd5fb21-1da5-53ab-8309-62489fc06914" "answer-687d14aa-ff54-5c9b-8a40-d8380a3b9c94" "answer-93995dc1-54c8-5047-9c21-12b35d606201"] :db/ensure [:answer-field/validate]} {:db/id "answer-70d0b8a3-28af-5be2-a31c-e77c97c45d41" :answer/id #uuid "70d0b8a3-28af-5be2-a31c-e77c97c45d41" :answer/type :answer.type/math :answer/value "\\frac{1}{{a}^{7}{b}^{7}}" :db/ensure [:answer/validate]} {:db/id "answer-afd5fb21-1da5-53ab-8309-62489fc06914" :answer/id #uuid "afd5fb21-1da5-53ab-8309-62489fc06914" :answer/type :answer.type/math :answer/value "\\frac{{a}^{7}}{{b}^{7}}" :db/ensure [:answer/validate]} {:db/id "answer-687d14aa-ff54-5c9b-8a40-d8380a3b9c94" :answer/id #uuid "687d14aa-ff54-5c9b-8a40-d8380a3b9c94" :answer/type :answer.type/math :answer/value "{a}^{7}{b}^{7}" :db/ensure [:answer/validate]} {:db/id "answer-93995dc1-54c8-5047-9c21-12b35d606201" :answer/id #uuid "93995dc1-54c8-5047-9c21-12b35d606201" :answer/type :answer.type/math :answer/value "{a}^{8}{b}^{-8}" :db/ensure [:answer/validate]} {:db/id 17592186106385 :question/problem "${({x}^{-2}{y}^{6})}^{-2}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{({x}^{-2}{y}^{6})}^{-2} & = \\\\ {({x}^{-2})}^{-2}{({y}^{6})}^{-2} & = \\\\ {x}^{(-2)(-2)}\\cdot {y}^{(6)(-2)} & = \\\\ {x}^{4}{y}^{-12} & = \\\\ \\frac{{x}^{4}}{{y}^{12}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186104458 :answer-field/correct "answ