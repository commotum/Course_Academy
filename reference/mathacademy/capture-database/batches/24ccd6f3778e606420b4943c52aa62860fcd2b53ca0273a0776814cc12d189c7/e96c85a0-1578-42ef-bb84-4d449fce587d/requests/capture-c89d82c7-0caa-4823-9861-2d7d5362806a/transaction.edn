[{:db/id 17592186073806 :knowledge-point/questions ["question-8bd82d37-8d46-5290-9706-952c92700eeb" "question-0ea8ccf7-5897-5ab4-80b3-c1985abc7d80"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073464 :question/problem "Simplify $8\\sqrt 3 - 5\\sqrt 3 + \\sqrt 5.$" :question/worked-solution "We can combine the two $\\sqrt{3}$ terms together, as follows:\n\n$$\n\\begin{aligned}8\\sqrt{3}-5\\sqrt{3}+\\sqrt{5} & = \\\\ (8-5)\\sqrt{3}+\\sqrt{5} & = \\\\ 3\\sqrt{3}+\\sqrt{5} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073789 :knowledge-point/questions ["question-a9e25ac2-f767-5781-99ee-621462efc511" "question-72ebf39d-3bb6-58bc-806b-137a4fead9d6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073664 :question/problem "Simplify the expression $3\\sqrt{80} -8\\sqrt{5}.$" :question/worked-solution "First, we use the product rule for radicals to simplify $\\sqrt{80},$ as follows:\n\n$$\n\\begin{aligned}\\sqrt{80} & =\\sqrt{16\\cdot 5}=\\sqrt{16}\\cdot \\sqrt{5}=4\\sqrt{5} & \\end{aligned}\n$$\n\nAs a result,\n\n$$\n\\begin{aligned}3\\sqrt{80}-8\\sqrt{5} & = \\\\ 3(4\\sqrt{5})-8\\sqrt{5} & = \\\\ 12\\sqrt{5}-8\\sqrt{5}. & \\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt{5}$ terms together:\n\n$$\n\\begin{aligned}12\\sqrt{5}-8\\sqrt{5} & = \\\\ (12-8)\\sqrt{5} & = \\\\ 4\\sqrt{5} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186073788 :knowledge-point/questions ["question-5ea12d57-149c-5e75-92c8-881bf2f1c4e9" "question-589b43ec-34cc-5c99-9404-4a02a5e69293"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073663 :question/problem "Simplify $2\\sqrt[3]{5} +5 \\sqrt{10} -3 \\sqrt[3]{40}.$" :question/worked-solution "First, we use the product rule for radicals, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{40} & =\\sqrt[3]{8\\cdot 5}=\\sqrt[3]{8}\\cdot \\sqrt[3]{5}=2\\sqrt[3]{5} & \\end{aligned}\n$$\n\nAs a result, we have\n\n$$\n\\begin{aligned}2\\sqrt[3]{5}+5\\sqrt{10}-3\\sqrt[3]{40} & = \\\\ 2\\sqrt[3]{5}+5\\sqrt{10}-3(2\\sqrt[3]{5}) & = \\\\ 2\\sqrt[3]{5}+5\\sqrt{10}-6\\sqrt[3]{5}.\\end{aligned}\n$$\n\nNow, we can combine the two $\\sqrt[3]{5}$ terms together:\n\n$$\n\\begin{aligned}2\\sqrt[3]{5}+5\\sqrt{10}-6\\sqrt[3]{5} & = \\\\ 5\\sqrt{10}+(2\\sqrt[3]{5}-6\\sqrt[3]{5}) & = \\\\ 5\\sqrt{10}+(2-6)\\sqrt[3]{5} & = \\\\ 5\\sqrt{10}-4\\sqrt[3]{5} & \\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-8bd82d37-8d46-5290-9706-952c92700eeb" :question/id #uuid "8bd82d37-8d46-5290-9706-952c92700eeb" :question/math-academy-id "q-4031" :question/problem "$10\\sqrt{3}-7\\sqrt{3}+3\\sqrt{2}=$" :question/worked-solution "We can combine the two $\\sqrt{3}$ terms together, as follows:\n\n$$\n\\begin{aligned}10\\sqrt{3}-7\\sqrt{3}+3\\sqrt{2} & = \\\\ (10-7)\\sqrt{3}+3\\sqrt{2} & = \\\\ 3\\sqrt{3}+3\\sqrt{2} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-313f6d3b-87ef-5fe1-a20b-9b07b45be5c3"] :db/ensure [:question/validate]} {:db/id "answer-field-313f6d3b-87ef-5fe1-a20b-9b07b45be5c3" :answer-field/id #uuid "313f6d3b-87ef-5fe1-a20b-9b07b45be5c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3d304dda-963e-5449-a2b5-7b6c48a04212" :answer-field/choices ["answer-2aaf527d-34f7-5ae4-b8a8-94bafa5a4ff2" "answer-99379c0c-fbdc-5b04-b21f-46cc528ca026" "answer-3d304dda-963e-5449-a2b5-7b6c48a04212" "answer-f61ffdce-8ed4-5969-8dc1-2edeb1532a5a" "answer-e58ff2d0-9c33-5c99-b226-92f645dc8184"] :db/ensure [:answer-field/validate]} {:db/id "answer-2aaf527d-34f7-5ae4-b8a8-94bafa5a4ff2" :answer/id #uuid "2aaf527d-34f7-5ae4-b8a8-94bafa5a4ff2" :answer/type :answer.type/math :answer/value "3\\sqrt{2}-3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-99379c0c-fbdc-5b04-b21f-46cc528ca026" :answer/id #uuid "99379c0c-fbdc-5b04-b21f-46cc528ca026" :answer/type :answer.type/math :answer/value "3\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-3