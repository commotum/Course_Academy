60" :question/math-academy-id "q-52131" :question/problem "Given the polynomial $f(x)=3{x}^{2}+1,$ $f(3)=$" :question/worked-solution "We substitute $x=x$ into the expression for $f(x)$ and simplify: \n\n$$\n\\begin{aligned}f(x) & =3{x}^{2}+1 \\\\ f(3) & =3(3)^{2}+1 \\\\  & =27+1 \\\\  & =28\\end{aligned}\n$$\n\nTherefore, $f(3)=28.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-39e37d12-a990-5afb-9a51-3025326ee005"] :db/ensure [:question/validate]} {:db/id "answer-field-39e37d12-a990-5afb-9a51-3025326ee005" :answer-field/id #uuid "39e37d12-a990-5afb-9a51-3025326ee005" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-33703d26-72cd-5cc0-aca3-ff27ce58c3a9" :answer-field/choices ["answer-4a0251a2-5a6f-5f2e-a8d7-4946c3bfa1a2" "answer-7976dd35-fda1-58e9-9f8c-a10bdfaee619" "answer-4a178c66-540d-5353-b5cb-382e367946e5" "answer-33703d26-72cd-5cc0-aca3-ff27ce58c3a9" "answer-d27f363a-0795-5e28-96ae-acdc39887ec9"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a0251a2-5a6f-5f2e-a8d7-4946c3bfa1a2" :answer/id #uuid "4a0251a2-5a6f-5f2e-a8d7-4946c3bfa1a2" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-7976dd35-fda1-58e9-9f8c-a10bdfaee619" :answer/id #uuid "7976dd35-fda1-58e9-9f8c-a10bdfaee619" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-4a178c66-540d-5353-b5cb-382e367946e5" :answer/id #uuid "4a178c66-540d-5353-b5cb-382e367946e5" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-33703d26-72cd-5cc0-aca3-ff27ce58c3a9" :answer/id #uuid "33703d26-72cd-5cc0-aca3-ff27ce58c3a9" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "answer-d27f363a-0795-5e28-96ae-acdc39887ec9" :answer/id #uuid "d27f363a-0795-5e28-96ae-acdc39887ec9" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "question-14cc1a32-5526-5826-8d11-3b9752e2a607" :question/id #uuid "14cc1a32-5526-5826-8d11-3b9752e2a607" :question/math-academy-id "q-74463" :question/problem "Given the polynomial $g(x)={x}^{4}+3{x}^{3}+{x}^{2}-4x,$ $g(1)=$" :question/worked-solution "We substitute $x=1$ into the expression for $g(x)$ and simplify: \n\n$$\n\\begin{aligned}g(x) & ={x}^{4}+3{x}^{3}+{x}^{2}-4x \\\\ g(1) & ={1}^{4}+3\\cdot {1}^{3}+{1}^{2}-4\\cdot 1 \\\\  & =1+3+1-4 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $g(1)=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8f6bd22d-0ba9-56fb-9f12-08c0ea8052b4"] :db/ensure [:question/validate]} {:db/id "answer-field-8f6bd22d-0ba9-56fb-9f12-08c0ea8052b4" :answer-field/id #uuid "8f6bd22d-0ba9-56fb-9f12-08c0ea8052b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2bf881b2-13e8-5a22-ae7e-ec683fc8ab04" :answer-field/choices ["answer-2bf881b2-13e8-5a22-ae7e-ec683fc8ab04" "answer-84297f1f-e6e8-5683-af04-f7b713873948" "answer-57e8cf6d-8d35-5805-8a29-824f9a26363b" "answer-51fefe0c-6917-5f99-be00-78bf52de691d" "answer-60d844b9-8ae4-59d2-a8d1-c0bdccdc4cff"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bf881b2-13e8-5a22-ae7e-ec683fc8ab04" :answer/id #uuid "2bf881b2-13e8-5a22-ae7e-ec683fc8ab04" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-84297f1f-e6e8-5683-af04-f7b713873948" :answer/id #uuid "84297f1f-e6e8-5683-af04-f7b713873948" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-57e8cf6d-8d35-5805-8a29-824f9a26363b" :answer/id #uuid "57e8cf6d-8d35-5805-8a29-824f9a26363b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-51fefe0c-6917-5f99-be00-78bf52de691d" :answer/id #uuid "51fefe0c-6917-5f99-be00-78bf52de691d" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-60d844b9-8ae4-59d2-a8d1-c0bdccdc4cff" :answer/id #uuid "60d844b9-8ae4-59d2-a8d1-c0bdccdc4cff" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "activity-c520d89b-b214-53fa-952a-5cdaa5d839b2" :activity/id #uuid "c520d89b-b214-53fa-952a-5cdaa5d839b2" :activity/title "Introduction to Polynomials" :activity/type :activity.type/review :activity/scope 17592186050396 :activity/course 17592186046648 :activity/steps ["step-f1b78880-72cd-5e06-98fa-ff71eb1c6e50" "step-c2d7fc25-7c71-5f9a-b230-683a6fe78e3a" "step-fb3db9c8-817f-5352-8d1f-22e473869755"] :activity/first-step "step-f1b78880-72cd-5e06-98fa-ff71eb1c6e50" :db/ensure [:activity/validate]} {:db/id "step-f1b78880-72cd-5e06-98fa-ff71eb1c6e50" :step/id #uuid "f1b78880-72cd-5e06-98fa-ff71eb1c6e50" :step/content 17592186078853 :step/next "step-c2d7fc25-7c71-5f9a-b230-683a6fe78e3a" :db/ensure [:step/validate]} {:db/id "step-c2d7fc25-7c71-5f9a-b230-683a6fe78e3a" :step/id #uuid "c2d7fc25-7c71-5f9a-b230-683a6fe78e3a" :step/content "question-c90c9cf4-1ba5-5ca6-8d2b-ccc36ce67160" :step/next "step-fb3db9c8-817f-5352-8d1f-22e473869755" :db/ensure [:step/validate]} {:db/id "step-fb3db9c8-817f-5352-8d1f-22e473869755" :step/id #uuid "fb3db9c8-817f-5352-8d1f-22e473869755" :step/content "question-14cc1a32-5526-5826-8d11-3b9752e2a607" :db/ensure [:step/validate]} [:db/retract 17592186124760 :question/answer-fields 17592186121157] {:db/id 17592186124606 :knowledge-point/questions ["question-b6c8dce9-3855-5452-ba32-6512e799f65b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b6c8dce9-3855-5452-ba32-6512e799f65b" :question/id #uuid "b6c8dce9-3855-5452-ba32-6512e799f65b" :question/math-academy-id "q-36836" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y)=5{y}^{2}-2x$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,2⟩$ and $b=⟨2,3⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)=5{y}^{2}-2x$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,2⟩$ and $b=⟨2,3⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(2,3)-f(0,2) & =∇f(c)\\cdot (⟨2,3⟩-⟨0,2⟩) \\\\ (5(3)^{2}-2(2))-(5(2)^{2}-2(0)) & =∇f(c)\\cdot ⟨2,1⟩ \\\\ 21 & =∇f(c)\\cdot ⟨2,1⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨-2,10y⟩, \\\\ ∇f(c) & =⟨-2,10{c}_{2}⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}21 & =∇f⟨c⟩\\cdot ⟨2,1⟩ \\\\ 21 & =⟨-2,10{c}_{2}⟩\\cdot ⟨2,1⟩ \\\\ 21 & =-4+10{c}_{2} \\\\ 10{c}_{2} & =25 \\\\ {c}_{2} & =\\frac{5}{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-2}{3-2} & =\\frac{x-0}{2-0} \\\\ y-2 & =\\frac{x}{2} \\\\ x & =2y-4.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{1} & =2{c}_{2}-4.\\end{aligned}\n$$\n\nFinally, taking into account that ${c}_{2}=\\frac{5}{2},$ we obtain that ${c}_{1}=2\\cdot \\frac{5}{2}-4=1.$ So, the point $C$ that satisfies the mean value theorem is $(1,\\frac{5}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dcf7b736-691e-5d1f-a95e-1aa8428199b5"] :db/ensure [:question/validate]} {:db/id "answer-field-dcf7b736-691e-5d1f-a95e-1aa8428199b5" :answer-field/id #uuid "dcf7b736-691e-5d1f-a95e-1aa8428199b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1838f568-f154-5028-8a40-70828f862bea" :answer-field/choices ["answer-1838f568-f154-5028-8a40-70828f862bea" "answer-b3f935b5-6dfe-5bcd-8f1a-c9dd6711bf82" "answer-31c22ae3-b2f9-5039-88b3-e917ad61579f" "answer-0b7a5f5b-69d3-59c5-9fe5-d1c3092257a5" "answer-d9857530-796f-58fe-9f92-b5bb11123e5a"] :db/ensure [:answer-field/validate]} {:db/id "answer-1838f568-f154-5028-8a40-70828f862bea" :answer/id #uuid "1838f568-f154-5028-8a40-70828f862bea" :answer/type :answer.type/math :answer/value "(1,\\frac{5}{2})" :db/ensure [:answer/validate]} {:db/id "answer-b3f935b5-6dfe-5bcd-8f1a-c9dd6711bf82" :answer/id #uuid "b3f935b5-6dfe-5bcd-8f1a-c9dd6711bf82" :answer/type :answer.type/math :answer/value "(\\frac{1}{2},\\frac{5}{2})" :db/ensure [:answer/validate]} {:db/id "answer-31c22ae3-b2f9-5039-88b3-e917ad61579f" :answer/id #uuid "31c22ae3-b2f9-5039-88b3-e917ad61579f" :answer/type :answer.type/math :answer/value "(\\frac{1}{3},\\frac{8}{3})" :db/ensure [:answer/validate]} {:db/id "answer-0b7a5f5b-69d3-59c5-9fe5-d1c3092257a5" :answer/id #uuid "0b7a5f5b-69d3-59c5-9fe5-d1c3092257a5" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},\\frac{5}{2})" :db/ensure [:answer/validate]} {:db/id "answer-d9857530-796f-58fe-9f92-b5bb11123e5a" :answer/id #uuid "d9857530-796f-58fe-9f92-b5bb11123e5a" :answer/type :answer.type/math :answer/value "(\\frac{3}{5},\\frac{11}{5})" :db/ensure [:answer/validate]} {:db/id 17592186124607 :knowledge-point/questions ["question-46ec3a18-4fb6-5ee1-a9e8-e76913b4fb34"] :db/ensure [:knowledge-point/validate]} {:db/id "question-46ec3a18-4fb6-5ee1-a9e8-e76913b4fb34" :question/id #uuid "46ec3a18-4fb6-5ee1-a9e8-e76913b4fb34" :question/math-academy-id "q-131031" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y,z)={z}^{2}-x-y$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,0,0⟩$ and $b=⟨-1,-2,3⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that $f(x,y,z)={z}^{2}-x-y$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,0,0⟩$ and $b=⟨-1,-2,3⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(-1,-2,3)-f(0,0,0) & =∇f(c)\\cdot (⟨-1,-2,3⟩-⟨0,0,0⟩) \\\\ 12-0 & =∇f(c)\\cdot ⟨-1,-2,3⟩ \\\\ 12 & =∇f(c)\\cdot ⟨-1,-2,3⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨-1,-1,2z⟩ \\\\ ∇f(c) & =⟨-1,-1,2{c}_{3}⟩.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}12 & =∇f(c)\\cdot ⟨-1,-2,3⟩ \\\\ 12 & =⟨-1,-1,2{c}_{3}⟩\\cdot ⟨-1,-2,3⟩ \\\\ 12 & =1+2+6{c}_{3} \\\\ 6{c}_{3} & =9 \\\\ {c}_{3} & =\\frac{3}{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{x-0}{(-1)} & =\\frac{y-0}{(-2)}=\\frac{z-0}{3} \\\\ -x & =-\\frac{y}{2}=\\frac{z}{3}\\end{aligned}\n$$\n\nParametrizing the line, we get\n\n$$\nx=-t,\\,y=-2t,\\,z=3t,\\,0\\le t\\le 1.\n$$\n\nSince $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩$ satisfies the equation of the line, we have\n\n$$\n{c}_{1}=-t,\\,{c}_{2}=-2t,\\,{c}_{3}=3t.\n$$\n\nSubstituting the above in the equation ${c}_{3}=\\frac{3}{2},$ we get\n\n$$\n\\begin{aligned}3t & =\\frac{3}{2} \\\\ t & =\\frac{1}{2}.\\end{aligned}\n$$\n\nWe can now find the values of ${c}_{1}$ and ${c}_{2}.$ This gives\n\n$$\n\\begin{aligned}{c}_{1} & =-\\frac{1}{2}, \\\\ {c}_{2} & =-2(\\frac{1}{2})=-1.\\end{aligned}\n$$\n\nFinally, the coordinates of $C$ are $(-\\frac{1}{2},-1,\\frac{3}{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-90d7f323-818d-52fb-8511-4569536d3e65"] :db/ensure [:question/validate]} {:db/id "answer-field-90d7f323-818d-52fb-8511-4569536d3e65" :answer-field/id #uuid "90d7f323-818d-52fb-8511-4569536d3e65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3d60600e-4e34-5bbc-a23b-24df864c14a2" :answer-field/choices ["answer-386b2c66-1c9c-5668-963d-1846e13ddbee" "answer-3d60600e-4e34-5bbc-a23b-24df864c14a2" "answer-11ce6875-1f98-55e5-bded-8bc92ce46ff3" "answer-99ce3a43-46d4-5e6f-9976-ddab31567b2d" "answer-3954fbd2-b037-5d6f-b09b-6ee284cd02dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-386b2c66-1c9c-5668-963d-1846e13ddbee" :answer/id #uuid "386b2c66-1c9c-5668-963d-1846e13ddbee" :answer/type :answer.type/math :answer/value "(-1,-2,3)" :db/ensure [:answer/validate]} {:db/id "answer-3d60600e-4e34-5bbc-a23b-24df864c14a2" :answer/id #uuid "3d60600e-4e34-5bbc-a23b-24df864c14a2" :answer/type :answer.type/math :answer/value "(-\\frac{1}{2},-1,\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "answer-11ce6875-1f98-55e5-bded-8bc92ce46ff3" :answer/id #uuid "11ce6875-1f98-55e5-bded-8bc92ce46ff3" :answer/type :answer.type/math :answer/value "(-\\frac{1}{4},-\\frac{1}{2},\\frac{3}{4})" :db/ensure [:answer/validate]} {:db/id "answer-99ce3a43-46d4-5e6f-9976-ddab31567b2d" :answer/id #uuid "99ce3a43-46d4-5e6f-9976-ddab31567b2d" :answer/type :answer.type/math :answer/value "(-\\frac{3}{4},-\\frac{3}{2},\\frac{9}{4})" :db/ensure [:answer/validate]} {:db/id "answer-3954fbd2-b037-5d6f-b09b-6ee284cd02dc" :answer/id #uuid "3954fbd2-b037-5d6f-b09b-6ee284cd02dc" :answer/type :answer.type/math :answer/value "(0,0,0)" :db/ensure [:answer/validate]} {:db/id "activity-6ebba5e7-8870-5a57-b8b6-4495c4c23947" :activity/id #uuid "6ebba5e7-8870-5a57-b8b6-4495c4c23947" :activity/title "The Multivariable Mean-Value Theorem" :activity/type :activity.type/review :activity/scope 17592186049421 :activity/course 17592186046659 :activity/steps ["step-94e32dde-ff91-50a9-ab93-70a32c94ccab" "step-fafd9199-788c-513d-ba61-5620b21205a4" "step-090604db-a13f-5a31-aa02-93d119fcd0b8" "step-69751aa3-ae26-5bd3-a4e3-94ae9355433d" "step-26ecae40-501e-554b-8721-b010b2c744c6"] :activity/first-step "step-94e32dde-ff91-50a9-ab93-70a32c94ccab" :db/ensure [:activity/validate]} {:db/id "step-94e32dde-ff91-50a9-ab93-70a32c94ccab" :step/id #uuid "94e32dde-ff91-50a9-ab93-70a32c94ccab" :step/content "question-b6c8dce9-3855-5452-ba32-6512e799f65b" :step/next "step-fafd9199-788c-513d-ba61-5620b21205a4" :db/ensure [:step/validate]} {:db/id "step-fafd9199-788c-513d-ba61-5620b21205a4" :step/id #uuid "fafd9199-788c-513d-ba61-5620b21205a4" :step/content 17592186124760 :step/next "step-090604db-a13f-5a31-aa02-93d119fcd0b8" :db/ensure [:step/validate]} {:db/id "step-090604db-a13f-5a31-aa02-93d119fcd0b8" :step/id #uuid "090604db-a13f-5a31-aa02-93d119fcd0b8" :step/content 17592186362602 :step/next "step-69751aa3-ae26-5bd3-a4e3-94ae9355433d" :db/ensure [:step/validate]} {:db/id "step-69751aa3-ae26-5bd3-a4e3-94ae9355433d" :step/id #uuid "69751aa3-ae26-5bd3-a4e3-94ae9355433d" :step/content 17592186399517 :step/next "step-26ecae40-501e-554b-8721-b010b2c744c6" :db/ensure [:step/validate]} {:db/id "step-26ecae40-501e-554b-8721-b010b2c744c6" :step/id #uuid "26ecae40-501e-554b-8721-b010b2c744c6" :step/content "question-46ec3a18-4fb6-5ee1-a9e8-e76913b4fb34" :db/ensure [:step/validate]} {:db/id 17592186198448 :knowledge-point/questions ["question-227d7c9d-e02b-5883-bb19-91ec1f4f8788" "question-222e2ed5-e7e4-55fe-9d04-24be2fce81e6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198131 :question/problem "Let $\\mathbf{Q}$ be an orthogonal linear transformation. If ![](images/88/888a6e0af4cb0ad21e91c823ce01e3b7b44005650d8abb33b7e7cd15f5c8b1d0.svg) and ![](images/15/155d90bc4b1df2a185aed86db995a16762338cda30417ecb5a459b131e171dd8.svg), find\n\nI. $\\Vert \\mathbf{Q}(\\mathbf{x}) \\Vert.$\n\nII. $\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}).$" :db/ensure [:question/validate]} {:db/id 17592186198449 :knowledge-point/questions ["question-fd59782d-c853-5fe4-812d-f8b2814488a9" "question-3a3b6415-46fa-5ac6-8f1e-cce0985c5f71"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198130 :question/problem "![](images/20/20b1f07891dd26e4839258d3c2232368b3aebbf527a2b0f31bcdde2369fc66d4.svg)\n\nConsider the vectors above, and let $\\mathbf{Q}$ be an orthogonal linear transformation. Which of the following statements are true?\n\nI. $\\mathbf{u}_1 \\cdot \\mathbf{u}_2 = 0$\n\nII. $\\{\\mathbf{Q}(\\mathbf{u}_1),\\mathbf{Q}(\\mathbf{u}_2)\\}$ is orthogonal\n\nIII. $\\{\\mathbf{Q}(\\mathbf{u}_1),\\mathbf{Q}(\\mathbf{u}_2)\\}$ is orthonormal" :question/worked-solution "Since $\\mathbf{Q}$ is orthogonal, we have that $\\mathbf{Q}(\\mathbf{x}) \\cdot \\mathbf{Q}(\\mathbf{y}) = \\mathbf{x} \\cdot \\mathbf{y}$ for any vectors $\\mathbf{x}$ and $\\mathbf{y}.$\n\nThe linear transformation $\\mathbf{Q}$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $\\mathbf{Q}$ relative to any orthonormal basis (including the standard basis) of $\\mathbb{R}^n$ is orthogonal.\n\n- $|| \\mathbf{Q}(\\mathbf{x}) || = || \\mathbf{x} ||.$\n\n- If $\\mathbf{x} \\perp \\mathbf{y}$ then $\\mathbf{Q}(\\mathbf{x}) \\perp \\mathbf{Q}(\\mathbf{y})$ for any $\\mathbf{x}, \\mathbf{y} \\in \\mathbb{R}^n.$ In general, $\\mathbf{Q}$ preserves the angle between any two vectors.\n\n- $\\mathbf{Q}$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n![](images/ad/adbd35f04ca988a406493df8f3dbda8769184868d5d85da89deb57ae18fb10b0.svg)\n\n- Statement II is true. Indeed, $\\mathbf{Q}(\\mathbf{u}_1) \\perp \\mathbf{Q}(\\mathbf{u}_2)$ since\n\n$$\n\\mathbf{Q}(\\mathbf{u}_1)\\cdot\\mathbf{Q}(\\mathbf{u}_2) = \\mathbf{u}_1\\cdot\\mathbf{u}_2 = 0.\n$$\n\n- Statement III is true. Indeed, both $\\mathbf{Q}(\\mathbf{u}_1)$ and $\\mathbf{Q}(\\mathbf{u}_2)$ are unit vectors:\n\n$$\n\\begin{aligned}‖Q({u}_{1})‖ & =‖{u}_{1}‖=\\sqrt{(\\frac{2\\sqrt{2}}{3})^{2}+(\\frac{1}{3})^{2}}=1 \\\\ ‖Q({u}_{2})‖ & =‖{u}_{2}‖=\\sqrt{(-\\frac{1}{3})^{2}+(\\frac{2\\sqrt{2}}{3})^{2}}=1\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\"" :db/ensure [:question/validate]} {:db/id "question-227d7c9d-e02b-5883-bb19-91ec1f4f8788" :question/id #uuid "227d7c9d-e02b-5883-bb19-91ec1f4f8788" :question/math-academy-id "q-177925" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $Q(x)\\cdot Q(y)$, where $x=[\\begin{aligned}-5 \\\\ 1 \\\\ -1\\end{aligned}]$ and $y=[\\begin{aligned}-2 \\\\ -4 \\\\ 2\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}Q(x)\\cdot Q(y) & =x\\cdot y \\\\  & =(-5)\\cdot (-2)+1\\cdot (-4)+(-1)\\cdot 2 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-115a1ff1-f34b-5f94-b986-bdd47a5c61a1"] :db/ensure [:question/validate]} {:db/id "answer-field-115a1ff1-f34b-5f94-b986-bdd47a5c61a1" :answer-field/id #uuid "115a1ff1-f34b-5f94-b986-bdd47a5c61a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c4184a0-c888-5c3d-95db-cb9cd250614e" :answer-field/choices ["answer-e7d96f0b-0d91-5c5a-8fc4-2f52f9c60496" "answer-6a28217e-b165-5a34-87a3-cba6817510dc" "answer-a78b744f-c950-5a6d-b53e-f4a231ad75de" "answer-5c4184a0-c888-5c3d-95db-cb9cd250614e" "answer-2956a40f-df61-50de-baf2-ec65d371184b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e7d96f0b-0d91-5c5a-8fc4-2f52f9c60496" :answer/id #uuid "e7d96f0b-0d91-5c5a-8fc4-2f52f9c60496" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-6a28217e-b165-5a34-87a3-cba6817510dc" :answer/id #uuid "6a28217e-b165-5a34-87a3-cba6817510dc" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-a78b744f-c950-5a6d-b53e-f4a231ad75de" :answer/id #uuid "a78b744f-c950-5a6d-b53e-f4a231ad75de" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-5c4184a0-c888-5c3d-95db-cb9cd250614e" :answer/id #uuid "5c4184a0-c888-5c3d-95db-cb9cd250614e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-2956a40f-df61-50de-baf2-ec65d371184b" :answer/id #uuid "2956a40f-df61-50de-baf2-ec65d371184b" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-222e2ed5-e7e4-55fe-9d04-24be2fce81e6" :question/id #uuid "222e2ed5-e7e4-55fe-9d04-24be2fce81e6" :question/math-academy-id "q-177845" :question/problem "Let $Q$ be an orthogonal linear transformation. Find $‖Q(x)‖$, where $x=[\\begin{aligned}-1 \\\\ 2 \\\\ -2\\end{aligned}].$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nIn this case, since $Q$ is orthogonal, we have \n\n$$\n\\begin{aligned}‖Q(x)‖ & =‖x‖ \\\\  & =\\sqrt{{x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f8b85cb0-51f8-5559-bd88-b78ed4af2dbf"] :db/ensure [:question/validate]} {:db/id "answer-field-f8b85cb0-51f8-5559-bd88-b78ed4af2dbf" :answer-field/id #uuid "f8b85cb0-51f8-5559-bd88-b78ed4af2dbf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4436a127-bf8f-5d0f-b926-f265c358b489" :answer-field/choices ["answer-a6988062-26b2-5f46-b225-4b080bde730b" "answer-4436a127-bf8f-5d0f-b926-f265c358b489" "answer-05ab90c9-0813-586a-9b44-c98ce8be0379" "answer-012bb29a-9963-57da-b90b-434c91a90ab2" "answer-2e490d2d-7e97-5d30-af73-6a6f000c1b2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6988062-26b2-5f46-b225-4b080bde730b" :answer/id #uuid "a6988062-26b2-5f46-b225-4b080bde730b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-4436a127-bf8f-5d0f-b926-f265c358b489" :answer/id #uuid "4436a127-bf8f-5d0f-b926-f265c358b489" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-05ab90c9-0813-586a-9b44-c98ce8be0379" :answer/id #uuid "05ab90c9-0813-586a-9b44-c98ce8be0379" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-012bb29a-9963-57da-b90b-434c91a90ab2" :answer/id #uuid "012bb29a-9963-57da-b90b-434c91a90ab2" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-2e490d2d-7e97-5d30-af73-6a6f000c1b2c" :answer/id #uuid "2e490d2d-7e97-5d30-af73-6a6f000c1b2c" :answer/type :answer.type/math :answer/value "5\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "question-fd59782d-c853-5fe4-812d-f8b2814488a9" :question/id #uuid "fd59782d-c853-5fe4-812d-f8b2814488a9" :question/math-academy-id "q-140567" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nI. $U=\\{Q([\\begin{aligned}2 \\\\ 5\\end{aligned}]),Q([\\begin{aligned}-2 \\\\ 5\\end{aligned}])\\}$\n\nII. $V=\\{Q([\\begin{aligned}-1 \\\\ \\sqrt{5} \\\\ -2\\end{aligned}]),Q([\\begin{aligned}0 \\\\ 2 \\\\ \\sqrt{5}\\end{aligned}]),Q([\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}])\\}$\n\nIII. $W=\\{Q([\\begin{aligned}2 \\\\ 5\\end{aligned}]),Q([\\begin{aligned}-5 \\\\ 2\\end{aligned}])\\}$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ $\\{Q({u}_{1}),Q({u}_{2})\\},\\,$ $\\{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})\\},\\,$ and $\\,\\{Q({w}_{1}),Q({w}_{2})\\}.$\n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=[\\begin{aligned}2 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}-2 \\\\ 5\\end{aligned}]=-4+25=21\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=[\\begin{aligned}-1 \\\\ \\sqrt{5} \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 2 \\\\ \\sqrt{5}\\end{aligned}]=0+2\\sqrt{5}-2\\sqrt{5}=0,\\,✓ \\\\ Q({v}_{1})\\cdot Q({v}_{3}) & ={v}_{1}\\cdot {v}_{3}=[\\begin{aligned}-1 \\\\ \\sqrt{5} \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]=-2+0-2=-4.\\,\\times  \\\\ {v}_{2}\\cdot {v}_{3} & =[\\begin{aligned}0 \\\\ 2 \\\\ \\sqrt{5}\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 0 \\\\ 1\\end{aligned}]=0+0+\\sqrt{5}=\\sqrt{5}\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=[\\begin{aligned}2 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}-5 \\\\ 2\\end{aligned}]=-10+10=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, the correct answer is \"$W$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bbd54c08-5bbd-5945-9a88-65da2698583c"] :db/ensure [:question/validate]} {:db/id "answer-field-bbd54c08-5bbd-5945-9a88-65da2698583c" :answer-field/id #uuid "bbd54c08-5bbd-5945-9a88-65da2698583c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b8fa2677-4376-5029-b220-a56e49c627ad" :answer-field/choices ["answer-8ec03f18-13be-55eb-92af-32d5b84aa90d" "answer-ae328ea7-ac34-5c69-a500-80ec39d884b3" "answer-9902057c-da91-5c74-b86e-dd54d2418d30" "answer-e17db08c-8042-5528-9797-e2d47b07097c" "answer-b8fa2677-4376-5029-b220-a56e49c627ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ec03f18-13be-55eb-92af-32d5b84aa90d" :answer/id #uuid "8ec03f18-13be-55eb-92af-32d5b84aa90d" :answer/type :answer.type/text :answer/value "$U$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "answer-ae328ea7-ac34-5c69-a500-80ec39d884b3" :answer/id #uuid "ae328ea7-ac34-5c69-a500-80ec39d884b3" :answer/type :answer.type/text :answer/value "$U,V,$ and $W$" :db/ensure [:answer/validate]} {:db/id "answer-9902057c-da91-5c74-b86e-dd54d2418d30" :answer/id #uuid "9902057c-da91-5c74-b86e-dd54d2418d30" :answer/type :answer.type/text :answer/value "$V$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "answer-e17db08c-8042-5528-9797-e2d47b07097c" :answer/id #uuid "e17db08c-8042-5528-9797-e2d47b07097c" :answer/type :answer.type/text :answer/value "$V$ only" :db/ensure [:answer/validate]} {:db/id "answer-b8fa2677-4376-5029-b220-a56e49c627ad" :answer/id #uuid "b8fa2677-4376-5029-b220-a56e49c627ad" :answer/type :answer.type/text :answer/value "$W$ only" :db/ensure [:answer/validate]} {:db/id "question-3a3b6415-46fa-5ac6-8f1e-cce0985c5f71" :question/id #uuid "3a3b6415-46fa-5ac6-8f1e-cce0985c5f71" :question/math-academy-id "q-40515" :question/problem "Let $Q$ be an orthogonal linear transformation. Which of the following are orthogonal sets?\n\nI. $U=\\{Q([\\begin{aligned}4 \\\\ 3\\end{aligned}]),Q([\\begin{aligned}5 \\\\ -1\\end{aligned}])\\}$\n\nII. $V=\\{Q([\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]),Q([\\begin{aligned}3 \\\\ -2 \\\\ \\frac{1}{3}\\end{aligned}]),Q([\\begin{aligned}2 \\\\ 4 \\\\ 6\\end{aligned}])\\}$\n\nIII. $W=\\{Q([\\begin{aligned}5 \\\\ -3\\end{aligned}]),Q([\\begin{aligned}-3 \\\\ -5\\end{aligned}])\\}$" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nLet's denote the elements of $U,W,$ and $V$ respectively as \n\n$\\,$ $\\{Q({u}_{1}),Q({u}_{2})\\},\\,$ $\\{Q({v}_{1}),Q({v}_{2}),Q({v}_{3})\\},\\,$ and $\\,\\{Q({w}_{1}),Q({w}_{2})\\}.$\n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- $Q({u}_{1})\\cdot Q({u}_{2})=0.$\n\n- $Q({v}_{1})\\cdot Q({v}_{2})=0,\\,Q({v}_{1})\\cdot Q({v}_{3})=0,\\,Q({v}_{2})\\cdot Q({v}_{3})=0.$\n\n- $Q({w}_{1})\\cdot Q({w}_{2})=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get \n\n$$\n\\begin{aligned}Q({u}_{1})\\cdot Q({u}_{2}) & ={u}_{1}\\cdot {u}_{2}=[\\begin{aligned}4 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}5 \\\\ -1\\end{aligned}]=20-3=17\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $U$ is not and orthogonal set.\n\n- For the Set $V,$ notice that \n\n$$\n\\begin{aligned}Q({v}_{1})\\cdot Q({v}_{2}) & ={v}_{1}\\cdot {v}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ -2 \\\\ \\frac{1}{3}\\end{aligned}]=3-4+1=0,\\,✓ \\\\ Q({v}_{1})\\cdot Q({v}_{3}) & ={v}_{1}\\cdot {v}_{3}=[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 4 \\\\ 6\\end{aligned}]=2+8+18=28\\ne 0.\\,\\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ we get \n\n$$\n\\begin{aligned}Q({w}_{1})\\cdot Q({w}_{2}) & ={w}_{1}\\cdot {w}_{2}=[\\begin{aligned}5 \\\\ -3\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ -5\\end{aligned}]=-15+15=0.\\,✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthogonal.\n\nTherefore, the correct answer is \"$W$ only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3a79a8e6-4bbb-52fc-b050-7b31066c3423"] :db/ensure [:question/validate]} {:db/id "answer-field-3a79a8e6-4bbb-52fc-b050-7b31066c3423" :answer-field/id #uuid "3a79a8e6-4bbb-52fc-b050-7b31066c3423" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-64b5d7dc-d5a7-536d-952d-7f23ec21eaea" :answer-field/choices ["answer-dcfa56ff-89e4-5c4c-b084-fe9d0a2df44d" "answer-a8a7e5ba-e12b-5de2-9808-9ac0af0c0ae8" "answer-511d2e30-3a63-5d27-8065-e177abbd52b3" "answer-0c21b706-ee61-5347-b1e9-163e20da045d" "answer-64b5d7dc-d5a7-536d-952d-7f23ec21eaea"] :db/ensure [:answer-field/validate]} {:db/id "answer-dcfa56ff-89e4-5c4c-b084-fe9d0a2df44d" :answer/id #uuid "dcfa56ff-89e4-5c4c-b084-fe9d0a2df44d" :answer/type :answer.type/text :answer/value "$U$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "answer-a8a7e5ba-e12b-5de2-9808-9ac0af0c0ae8" :answer/id #uuid "a8a7e5ba-e12b-5de2-9808-9ac0af0c0ae8" :answer/type :answer.type/text :answer/value "$U$ only" :db/ensure [:answer/validate]} {:db/id "answer-511d2e30-3a63-5d27-8065-e177abbd52b3" :answer/id #uuid "511d2e30-3a63-5d27-8065-e177abbd52b3" :answer/type :answer.type/text :answer/value "$V$ and $W$ only" :db/ensure [:answer/validate]} {:db/id "answer-0c21b706-ee61-5347-b1e9-163e20da045d" :answer/id #uuid "0c21b706-ee61-5347-b1e9-163e20da045d" :answer/type :answer.type/text :answer/value "$V$ only" :db/ensure [:answer/validate]} {:db/id "answer-64b5d7dc-d5a7-536d-952d-7f23ec21eaea" :answer/id #uuid "64b5d7dc-d5a7-536d-952d-7f23ec21eaea" :answer/type :answer.type/text :answer/value "$W$ only" :db/ensure [:answer/validate]} {:db/id 17592186198524 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186124470 :knowledge-point/questions ["question-eabe5e6a-dc85-5118-84d2-9aa9f31a6a23"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eabe5e6a-dc85-5118-84d2-9aa9f31a6a23" :question/id #uuid "eabe5e6a-dc85-5118-84d2-9aa9f31a6a23" :question/math-academy-id "q-95086" :question/problem "If $f(x,y,z)=x\\operatorname{sin}⁡(y+z)$ and $r(t)=(t+1)\\,i+2t\\,j+{t}^{2}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(y+z))\\,i+\\frac{∂}{∂y}(x\\operatorname{sin}⁡(y+z))\\,j+\\frac{∂}{∂z}(x\\operatorname{sin}⁡(y+z))\\,k \\\\  & =\\operatorname{sin}⁡(y+z)\\,i+x\\operatorname{cos}⁡(y+z)\\,j+x\\operatorname{cos}⁡(y+z)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t+1,$ $y=2t$ and $z={t}^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\operatorname{sin}⁡(2t+{t}^{2})\\,i+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,j+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =\\,i+2\\,j+2t\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\operatorname{sin}⁡(2t+{t}^{2})\\,i+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,j+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,k)\\cdot (\\,i+2\\,j+2t\\,k) \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})\\cdot 1+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\cdot 2+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\cdot 2t \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)\\operatorname{cos}⁡(2t+{t}^{2})+2t(t+1)\\operatorname{cos}⁡(2t+{t}^{2}) \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)(1+t)\\operatorname{cos}⁡(2t+{t}^{2}) \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)^{2}\\operatorname{cos}⁡(2t+{t}^{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-26f9db34-f1fa-54a6-9839-7f297b6a756c"] :db/ensure [:question/validate]} {:db/id "answer-field-26f9db34-f1fa-54a6-9839-7f297b6a756c" :answer-field/id #uuid "26f9db34-f1fa-54a6-9839-7f297b6a756c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54a8785f-b684-5fbf-ab5e-7a2651308e2f" :answer-field/choices ["answer-1cf61e8f-1cbe-5cf7-b7de-cb285c2945df" "answer-131e1312-3232-541a-a772-9a4195876e08" "answer-54a8785f-b684-5fbf-ab5e-7a2651308e2f" "answer-7b1155ed-ffcf-5482-9835-4e132b93d976" "answer-7d4e5d76-01d4-5027-9d0b-5f4455a3c94c"] :db/ensure [:answer-field/validate]} {:db/id "answer-1cf61e8f-1cbe-5cf7-b7de-cb285c2945df" :answer/id #uuid "1cf61e8f-1cbe-5cf7-b7de-cb285c2945df" :answer/type :answer.type/math :answer/value "(t+1)\\operatorname{sin}⁡(2t+{t}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-131e1312-3232-541a-a772-9a4195876e08" :answer/id #uuid "131e1312-3232-541a-a772-9a4195876e08" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(2t+{t}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-54a8785f-b684-5fbf-ab5e-7a2651308e2f" :answer/id #uuid "54a8785f-b684-5fbf-ab5e-7a2651308e2f" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)^{2}\\operatorname{cos}⁡(2t+{t}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-7b1155ed-ffcf-5482-9835-4e132b93d976" :answer/id #uuid "7b1155ed-ffcf-5482-9835-4e132b93d976" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+2{t}^{2}\\operatorname{cos}⁡(2t+{t}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-7d4e5d76-01d4-5027-9d0b-5f4455a3c94c" :answer/id #uuid "7d4e5d76-01d4-5027-9d0b-5f4455a3c94c" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+\\operatorname{cos}⁡(2t+{t}^{2})" :db/ensure [:answer/validate]} {:db/id "activity-0493dc8c-3f2a-5f14-bb7c-04f41f578eb4" :activity/id #uuid "0493dc8c-3f2a-5f14-bb7c-04f41f578eb4" :activity/title "The Multivariable Chain Rule in Vector Form" :activity/type :activity.type/review :activity/scope 17592186049255 :activity/course 17592186046659 :activity/steps ["step-bb7a2b36-6b63-51f3-9376-761d5f709c35" "step-3232ec86-62d5-5c61-ba3f-93622480e150" "step-2989f12e-e4d2-5eea-a076-313f05f3b144" "step-bd21bb0d-0ac3-5b0d-8a0d-e84c7b42e305" "step-a35955fa-8e05-5fc2-9647-6f1fbb5eff50"] :activity/first-step "step-bb7a2b36-6b63-51f3-9376-761d5f709c35" :db/ensure [:activity/validate]} {:db/id "step-bb7a2b36-6b63-51f3-9376-761d5f709c35" :step/id #uuid "bb7a2b36-6b63-51f3-9376-761d5f709c35" :step/content 17592186323880 :step/next "step-3232ec86-62d5-5c61-ba3f-93622480e150" :db/ensure [:step/validate]} {:db/id "step-3232ec86-62d5-5c61-ba3f-93622480e150" :step/id #uuid "3232ec86-62d5-5c61-ba3f-93622480e150" :step/content 17592186360524 :step/next "step-2989f12e-e4d2-5eea-a076-313f05f3b144" :db/ensure [:step/validate]} {:db/id "step-2989f12e-e4d2-5eea-a076-313f05f3b144" :step/id #uuid "2989f12e-e4d2-5eea-a076-313f05f3b144" :step/content 17592186360529 :step/next "step-bd21bb0d-0ac3-5b0d-8a0d-e84c7b42e305" :db/ensure [:step/validate]} {:db/id "step-bd21bb0d-0ac3-5b0d-8a0d-e84c7b42e305" :step/id #uuid "bd21bb0d-0ac3-5b0d-8a0d-e84c7b42e305" :step/content "question-eabe5e6a-dc85-5118-84d2-9aa9f31a6a23" :step/next "step-a35955fa-8e05-5fc2-9647-6f1fbb5eff50" :db/ensure [:step/validate]} {:db/id "step-a35955fa-8e05-5fc2-9647-6f1fbb5eff50" :step/id #uuid "a35955fa-8e05-5fc2-9647-6f1fbb5eff50" :step/content 17592186360579 :db/ensure [:step/validate]} [:db/retract 17592186063540 :answer-field/choices 17592186063541] [:db/retract 17592186063540 :answer-field/choices 17592186063542] [:db/retract 17592186063540 :answer-field/choices 17592186063544] [:db/retract 17592186063540 :answer-field/choices 17592186063545] {:db/id 17592186064298 :knowledge-point/questions ["question-d7c0bf43-3499-50b5-82df-1f82cb1c3e1b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063919 :question/problem "Simplify $\\dfrac{x^2}{x^3}.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{x}^{3}} & = \\\\ {x}^{(2-3)} & = \\\\ {x}^{-1}\\end{aligned}\n$$\n\nThen, we convert the negative exponent to a positive exponent by taking the reciprocal:\n\n$$\n\\begin{aligned}{x}^{-1} & =\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\dfrac{x^2}{x^3} = \\dfrac 1 x.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064299 :knowledge-point/questions ["question-aa08d046-87b1-535b-9f52-33c08a805a92" "question-d33d9ced-1c2f-559b-84d3-41f7cab066b8" "question-51b4f2a2-d5b5-571a-9fa7-6251a05de673"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063920 :question/problem "Simplify $\\dfrac{z^5}{z^{-3} }.$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{z}^{5}}{{z}^{-3}} & = \\\\ {z}^{5-(-3)} & = \\\\ {z}^{5+3} & = \\\\ {z}^{8}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064300 :knowledge-point/questions ["question-0c16d02f-29ad-5f66-b01c-bdf6dca8d018" "question-faa7323c-2fa9-5fe0-9081-c51997dba998" "question-3be04767-4c26-5347-b891-6186a74ead6b" "question-8ac0604e-5343-56c6-8dd6-8c555b217bdc" "question-0e69e5e6-7016-5a90-88d1-935042e944fb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063921 :question/problem "Simplify the  expression $\\dfrac {p^7} {p^2}  \\cdot p^3 .$" :question/worked-solution "First we apply the quotient rule, subtracting exponents in the fraction:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{p}^{7}}{{p}^{2}}\\cdot {p}^{3} & = \\\\ {p}^{(7-2)}\\cdot {p}^{3} & = \\\\ {p}^{5}\\cdot {p}^{3}\\end{aligned}\\end{aligned}\n$$\n\nThen we apply the product rule, adding exponents in the product:\n\n$$\n\\begin{aligned}\\begin{aligned}{p}^{5}\\cdot {p}^{3} & = \\\\ {p}^{(5+3)} & = \\\\ {p}^{8}\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{p}^{7}}{{p}^{2}}\\cdot {p}^{3}={p}^{8}.\\end{aligned}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-d7c0bf43-3499-50b5-82df-1f82cb1c3e1b" :question/id #uuid "d7c0bf43-3499-50b5-82df-1f82cb1c3e1b" :question/math-academy-id "q-2886" :question/problem "$\\frac{{r}^{9}}{{r}^{3}}=$" :question/worked-solution "We subtract the exponents, as follows:\n\n$$\n\\begin{aligned}\\frac{{r}^{9}}{{r}^{3}} & = \\\\ {r}^{(9-3)} & = \\\\ {r}^{6} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b93b9ede-04e5-56a5-8f3d-1f9ee974530b"] :db/ensure [:question/validate]} {:db/id "answer-field-b93b9ede-04e5-56a5-8f3d-1f9ee974530b" :answer-field/id #uuid "b93b9ede-04e5-56a5-8f3d-1f9ee974530b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f60b09d9-8037-5edf-91f1-413c3c5e8ad5" :answer-field/choices ["answer-86e3f884-9987-5e1b-b338-f3d6361f1272" "answer-15652b6a-f89d-5b13-ba4c-c9109edd3ae2" "answer-4539c934-06dc-505d-9c83-4c4e5581015d" "answer-17330892-079d-594f-9793-ca9800def76b" "answer-f60b09d9-8037-5edf-91f1-413c3c5e8ad5"] :db/ensure [:answer-field/validate]} {:db/id "answer-86e3f884-9987-5e1b-b338-f3d6361f1272" :answer/id #uuid "86e3f884-9987-5e1b-b338-f3d6361f1272" :answer/type :answer.type/math :answer/value "\\frac{1}{{r}^{6}}" :db/ensure [:answer/validate]} {:db/id "answer-15652b6a-f89d-5b13-ba4c-c9109edd3ae2" :answer/id #uuid "15652b6a-f89d-5b13-ba4c-c9109edd3ae2" :answer/type :an