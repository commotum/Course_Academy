lidate]} {:db/id "answer-eade159a-6f25-56c3-9356-c512910ef15e" :answer/id #uuid "eade159a-6f25-56c3-9356-c512910ef15e" :answer/type :answer.type/math :answer/value "\\frac{9p}{|q|}" :db/ensure [:answer/validate]} {:db/id "answer-1b81a56c-810f-573a-97dd-301514efe747" :answer/id #uuid "1b81a56c-810f-573a-97dd-301514efe747" :answer/type :answer.type/math :answer/value "\\frac{9|p|}{q}" :db/ensure [:answer/validate]} {:db/id "answer-a58d28b3-647f-5745-b92e-54ec7959c4b3" :answer/id #uuid "a58d28b3-647f-5745-b92e-54ec7959c4b3" :answer/type :answer.type/math :answer/value "\\frac{|p|}{9|q|}" :db/ensure [:answer/validate]} {:db/id "answer-9b93bd3e-5333-5ae7-b2a4-a70e11e54551" :answer/id #uuid "9b93bd3e-5333-5ae7-b2a4-a70e11e54551" :answer/type :answer.type/math :answer/value "\\pm \\frac{p}{9q}" :db/ensure [:answer/validate]} {:db/id 17592186233381 :question/answer-fields ["answer-field-b6c4f3e7-b119-592e-9f35-31368c3f7121"] :db/ensure [:question/validate]} {:db/id "answer-field-b6c4f3e7-b119-592e-9f35-31368c3f7121" :answer-field/id #uuid "b6c4f3e7-b119-592e-9f35-31368c3f7121" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e35cb55d-2dfd-55eb-bf0f-6fa62c65efa2" :answer-field/choices ["answer-b1faed5d-4a27-57fd-9b17-4d064369014c" "answer-dbac0fc6-9501-50df-88fb-33580ce66e8f" "answer-7c3d666f-f045-5443-9c6d-274e5c6211c1" "answer-e35cb55d-2dfd-55eb-bf0f-6fa62c65efa2" "answer-10e0df1d-e35f-5855-a834-1c94f1908569"] :db/ensure [:answer-field/validate]} {:db/id "answer-b1faed5d-4a27-57fd-9b17-4d064369014c" :answer/id #uuid "b1faed5d-4a27-57fd-9b17-4d064369014c" :answer/type :answer.type/math :answer/value "\\frac{z}{5y}" :db/ensure [:answer/validate]} {:db/id "answer-dbac0fc6-9501-50df-88fb-33580ce66e8f" :answer/id #uuid "dbac0fc6-9501-50df-88fb-33580ce66e8f" :answer/type :answer.type/math :answer/value "\\frac{{z}^{2}}{5{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-7c3d666f-f045-5443-9c6d-274e5c6211c1" :answer/id #uuid "7c3d666f-f045-5443-9c6d-274e5c6211c1" :answer/type :answer.type/math :answer/value "\\frac{|z|}{5y}" :db/ensure [:answer/validate]} {:db/id "answer-e35cb55d-2dfd-55eb-bf0f-6fa62c65efa2" :answer/id #uuid "e35cb55d-2dfd-55eb-bf0f-6fa62c65efa2" :answer/type :answer.type/math :answer/value "\\frac{|z|}{5|y|}" :db/ensure [:answer/validate]} {:db/id "answer-10e0df1d-e35f-5855-a834-1c94f1908569" :answer/id #uuid "10e0df1d-e35f-5855-a834-1c94f1908569" :answer/type :answer.type/math :answer/value "\\pm \\frac{z}{5y}" :db/ensure [:answer/validate]} {:db/id 17592186065343 :tutorial/content "When simplifying an algebraic expression involving square roots, it's useful to remember that\n\n$$\n\\sqrt{x^2} = |x|.\n$$\n\nIt's tempting to think that $\\sqrt{x^2}$ is equivalent to $x,$ but that's not true because $\\sqrt{x^2}$ is always non-negative, even if $x$ is negative.\n\nTo illustrate, let's evaluate $\\sqrt{x^2}$ for a couple of different values of $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\sqrt{{4}^{2}} & =\\sqrt{16}=4 \\\\ \\sqrt{(-4)^{2}} & =\\sqrt{16}=4\\end{aligned}\n$$\n\nIn both cases, using absolute value gives the correct result:\n\n$$\n\\begin{aligned}\\sqrt{{4}^{2}}=|4| & =4 & ✓ \\\\ \\sqrt{(-4)^{2}}=|-4| & =4 & ✓\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186064461 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
