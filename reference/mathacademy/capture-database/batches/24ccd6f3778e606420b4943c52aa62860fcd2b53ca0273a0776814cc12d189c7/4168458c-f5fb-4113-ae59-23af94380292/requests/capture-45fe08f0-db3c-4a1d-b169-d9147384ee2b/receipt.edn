me{ln}⁡{x}^{2})}^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡{x}^{2})}^{2}(\\frac{4{x}^{3}}{3})-\\int (\\frac{4{x}^{3}}{3})(\\frac{4\\operatorname{ln}⁡{x}^{2}}{x})\\,\\text{d}x \\\\  & =\\frac{4{x}^{3}{(\\operatorname{ln}⁡{x}^{2})}^{2}}{3}-\\frac{16}{3}\\int {x}^{2}\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡({x}^{2})\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{2})\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡({x}^{2}))(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{2}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2})}{3}-\\frac{2}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2})}{3}-\\frac{2{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 4{x}^{2}{(\\operatorname{ln}⁡{x}^{2})}^{2}\\,\\text{d}x & =\\frac{4{x}^{3}{(\\operatorname{ln}⁡{x}^{2})}^{2}}{3}-\\frac{16}{3}(\\frac{{x}^{3}\\operatorname{ln}⁡({x}^{2})}{3}-\\frac{2{x}^{3}}{9}+D) \\\\  & =\\frac{4{x}^{3}{(\\operatorname{ln}⁡{x}^{2})}^{2}}{3}-\\frac{16{x}^{3}\\operatorname{ln}⁡({x}^{2})}{9}+\\frac{32{x}^{3}}{27}-\\frac{16D}{3} \\\\  & =\\frac{4{x}^{3}}{27}(9{(\\operatorname{ln}⁡{x}^{2})}^{2}-12\\operatorname{ln}⁡{x}^{2}+8)+C,\\end{aligned}\n$$\n\nWhere, $C=-\\frac{16D}{3}.$" 13194139535947 17592