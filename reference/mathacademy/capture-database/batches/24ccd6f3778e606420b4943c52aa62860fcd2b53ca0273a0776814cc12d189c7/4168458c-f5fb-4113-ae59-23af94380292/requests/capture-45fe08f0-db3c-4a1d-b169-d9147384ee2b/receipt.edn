x}(\\frac{4\\sqrt{{x}^{3}}}{3})=2\\sqrt{x}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(\\frac{4\\sqrt{{x}^{3}}}{3})=0,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(2\\sqrt{x})}^{2}+(0)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+4x}\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{1+4x}}\\sqrt{1+4x}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\sqrt{1+4x}\\cdot y\\,{|}_{0}^{\\sqrt{1+4x}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\sqrt{1+4x}\\cdot \\sqrt{1+4x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(1+4x)\\,\\text{d}x \\\\  & =(x+2{x}^{2})\\,{|}_{0}^{2} \\\\  & =(2+8)-0 \\\\  & =10.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186415936 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=\\frac{4\\sqrt{{x}^{3}}}{3},\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le \\sqrt{1+4x}},\n$$\n\nas shown in the diagram below.\n\n![](images/9a/9a459a9807befc312528771626dca293a7ebbccd97a2c1e938f47a2d90a36726.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(\\frac{4\\sqrt{{x}^{3}}}{3})=2\\sqrt{x}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(\\frac{4\\sqrt{{x}^{3}}}{3})=0,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(2\\sqrt{x})}^{2}+(0)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+4x}\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{1+4x}}\\sqrt{1+4x}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\sqrt{1+4x}\\cdot y\\,{|}_{0}^{\\sqrt{1+4x}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\sqrt{1+4x}\\cdot \\sqrt{1+4x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(1+4x)\\,\\text{d}x \\\\  & =(x+2{x}^{2})\\,{|}_{0}^{2} \\\\  & =(2+8)-0 \\\\  & =10.\\end{aligned}\n$$" 13194139535947 17592186045417 false] [17592186415937 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=xy,\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1\\},\n$$\n\nas shown below.\n\n![](images/f0/f0faa92e0f89c86248abffad7f61cac5d94a3848a7f7be4464c4b28d3915aa32.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(xy)=y, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(xy)=x,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(y)^{2}+(x)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{x}^{2}+{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region $D$ can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+({x}^{2}+{y}^{2})}\\,\\text{d}A & ={∬}_{Δ}\\sqrt{1+{r}^{2}}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}r\\sqrt{1+{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,\\text{d}\\theta {\\int }_{0}^{1}r\\sqrt{1+{r}^{2}}\\,\\text{d}r \\\\  & =2\\pi {\\int }_{0}^{1}r\\sqrt{1+{r}^{2}}\\,\\text{d}r.\\end{aligned}\n$$\n\nSetting $u=1+{r}^{2},$ we get $\\text{d}u=2r\\,\\text{d}r.$ Also, the limits must be changed as follows:\n\n$$\n\\begin{aligned}r & 0 & 1 \\\\ u & 1 & 2\\end{aligned}\n$$\n\n \n\nSubstituting these into our integral, we obtain\n\n$$\n\\begin{aligned}2\\pi {\\int }_{0}^{1}r\\sqrt{1+{r}^{2}}\\,\\text{d}r & =2\\pi \\cdot \\frac{1}{2}{\\int }_{1}^{2}\\sqrt{u}\\,\\text{d}u \\\\  & =\\pi {\\int }_{1}^{2}{u}^{1/2}\\,\\text{d}u \\\\  & =\\pi \\cdot {[\\frac{2}{3}\\,{u}^{3/2}]}_{1}^{2} \\\\  & =\\frac{2\\pi }{3}{[{u}^{3/2}]}_{1}^{2} \\\\  & =\\frac{2\\pi }{3}[{2}^{3/2}-1] \\\\  & =\\frac{2\\pi (2\\sqrt{2}-1)}{3}.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186415937 1074 "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=xy,\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD={(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 1},\n$$\n\nas shown below.\n\n![](images/f0/f0faa92e0f89c86248abffad7f61cac5d94a3848a7f7be4464c4b28d3915aa32.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(xy)=y, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(xy)=x,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(y)^{2}+(x)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{x}^{2}+{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region $D$ can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+({x}^{2}+{y}^{2})}\\,\\text{d}A & ={∬}_{Δ}\\sqrt{1+{r}^{2}}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}r\\sqrt{1+{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,\\text{d}\\theta {\\int }_{0}^{1}r\\sqrt{1+{r}^{2}}\\,\\text{d}r \\\\  & =2\\pi {\\int }_{0}^{1}r\\sqrt{1+{