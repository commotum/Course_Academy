\pi }{6})+\\frac{5\\pi }{6})+2(2\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\frac{\\pi }{6}) \\\\  & =-2(-\\sqrt{3}+\\frac{5\\pi }{6})+2(\\sqrt{3}+\\frac{\\pi }{6}) \\\\  & =4\\sqrt{3}-\\frac{4\\pi }{3}.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547048 1068 #edb/ref 17592186546890 13194139535947 17592186045417 true] [17592186547048 1069 "q-67680" 13194139535947 17592186045417 true] [17592186547048 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547048 1071 "![](images/a8/a8cd5ca7760d21ac5bd86cfb90486ccde755f4aba831808889a20e1ad467eaf9.png)\n\nFind the area of $△ABC.$ Round your answer to two decimal places." 13194139535947 17592186045417 true] [17592186547048 1072 #uuid "bb68b570-72f8-5730-8942-1936207e20f5" 13194139535947 17592186045417 true] [17592186547048 1074 "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}ab\\operatorname{sin}⁡C,\n$$\n\nwhere $∠C$ is between the sides of lengths $a$ and $b.$ \n\nHere, we have\n\n$$\n\\begin{aligned}b & =CA=8, \\\\ a & =CB=10, \\\\ m∠A & ={43}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{43}^{∘}=0.681\\,998,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot 10\\cdot 8\\cdot \\operatorname{sin}⁡{43}^{∘} \\\\  & =40\\cdot (0.681\\,998) \\\\  & ≈27.28\\,{\\text{cm}}^{2},\\end{aligned}\n$$\n\nrounded to two decimal places." 13194139535947 17592186045417 true] [17592186547049 1068 #edb/ref 17592186546867 13194139535947 17592186045417 true] [17592186547049 1069 "q-114875" 13194139535947 17592186045417 true] [17592186547049 1070 #edb/ref 17592186045486 13194139535947 17592186045417 true] [17592186547049 1071 "Evaluate the integral ${\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" 13194139535947 17592186045417 true] [17592186547049 1072 #uuid "bc404082-c599-5306-899d-26fb5a707805" 13194139535947 17592186045417 true] [17592186547049 1074 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}x}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2})(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})(6x)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3{\\int }_{0}^{\\pi /2}x\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(2x)\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}x}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})\\cdot 1\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}\\int \\operatorname{cos}⁡(2x)\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+D\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3(-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+D) \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}+C\\end{aligned}\n$$\n\nwhere $C=-3D.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & ={[\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}]}_{0}^{\\pi /2} \\\\  & =\\frac{3{(\\frac{\\pi }{2})}^{2}\\operatorname{sin}⁡(\\pi )}{2}+\\frac{3(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\pi )}{2}-\\frac{3\\operatorname{sin}⁡(\\pi )}{4}-(\\frac{3(0)^{2}\\operatorname{sin}⁡(0)}{2}+\\frac{3(0)\\operatorname{cos}⁡(0)}{2}-\\frac{3\\operatorname{sin}⁡(0)}{4}) \\\\  & =0+\\frac{3\\pi (-1)}{4}-0-0 \\\\  & =-\\frac{3\\pi }{4}\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547050 1068 #edb/ref 17592186546915 13194139535947 17592186045417 true] [17592186547050 1069 "q-3395" 13194139535947 17592186045417 true] [17592186547050 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547050 1071 "Calculate the integral $\\int ({x}^{2}+2x)\\operatorname{cos}⁡(x)\\,\\text{d}x.$" 13194139535947 17592186045417 true] [17592186547050 1072 #uuid "c07f9c82-279d-54bf-a7cc-232522a75290" 13194139535947 17592186045417 true] [17592186547050 1074 "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}+2x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x+2 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(x)\\,\\text{d}x=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({x}^{2}+2x)\\operatorname{cos}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2}+2x)(\\operatorname{sin}⁡(x))-\\int (\\operatorname{sin}⁡(x))(2x+2)\\,\\text{d}x \\\\  & =({x}^{2}+2x)\\operatorname{sin}⁡(x)-2\\int x\\operatorname{sin}⁡(x)\\text{d}x-2\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =({x}^{2}+2x)\\operatorname{sin}⁡(x)-2\\int x\\operatorname{sin}⁡(x)\\text{d}x+2\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(x)\\,\\text{d}x=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(x)(-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))(1)\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡(x)+\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({x}^{2}+2x)\\operatorname{cos}⁡(x)\\,\\text{d}x & =({x}^{2}+2x)\\operatorname{sin}⁡(x)-2(-x\\operatorname{cos}⁡(x)+\\operatorname{sin}⁡(x)+D)+2\\operatorname{cos}⁡(x) \\\\  & =({x}^{2}+2x)\\operatorname{sin}⁡(x)+2x\\operatorname{cos}⁡(x)-2\\operatorname{sin}⁡(x)+C+2\\operatorname{cos}⁡(x) \\\\  & =({x}^{2}+2x-2)\\operatorname{sin}⁡(x)+2(x+1)\\operatorname{cos}⁡(x)+C,\\end{aligned}\n$$\n\nwhere $C=-2D.$" 13194139535947 17592186045417 true] [17592186547051 1068 #edb/ref 17592186546904 13194139535947 17592186045417 true] [17592186547051 1069 "q-112141" 13194139535947 17592186045417 true] [17592186547051 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547051 1071 "The growth of a mice colony is given by the formula $M(t)=6\\cdot {2}^{t},$ where $t$ is the time, in months, since the beginning of the observation. How many mice will the colony have after $5$ months?" 13194139535947 17592186045417 true] [17592186547051 1072 #uuid "c55619be-bc04-5da4-9e98-241a09beba3a" 13194139535947 17592186045417 true] [17592186547051 1074 "To get the number of mice in the colony after $5$ months, we evaluate the function at $t=5.$ Substituting $t=5$ into the function $M(t)$ gives\n\n$$\n\\begin{aligned}M(5) & =6\\cdot {2}^{5} \\\\  & =6\\cdot 32 \\\\  & =192.\\end{aligned}\n$$\n\n \n\nTherefore, after $5$ months there will be $192$ mice in the colony." 13194139535947 17592186045417 true] [17592186547052 1068 #edb/ref 17592186546862 13194139535947 17592186045417 true] [17592186547052 1069 "q-175691" 13194139535947 17592186045417 true] [17592186547052 1070 #edb/ref 17592186045486 13194139535947 17592186045417 true] [17592186547052 1071 "If $k=\\frac{21-3k}{4},$ then $k=${{field-1}}." 13194139535947 17592186045417 true] [17592186547052 1072 #uuid "c7c751ec-42d9-5e30-a955-bbbf2b18ef36" 13194139535947 17592186045417 true] [17592186547052 1074 "First, we clear the rational expression by multiplying the equation through by $4$:\n\n$$\n\\begin{aligned}k & =\\frac{21-3k}{4} \\\\ \\frac{21-3k}{4} & =k \\\\ 4(\\frac{21-3k}{4}) & =4\\cdot k \\\\ \\cancel{4}(\\frac{21-3k}{\\cancel{4}}) & =4k \\\\ 21-3k & =4k\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}21-3k & =4k \\\\ 21-3k+3k & =4k+3k \\\\ 21 & =7k \\\\ \\frac{21}{7} & =\\frac{7k}{7} \\\\ 3 & =\\frac{\\cancel{7}k}{\\cancel{7}} \\\\ 3 & =k\\end{aligned}\n$$\n\nThus, $k=3.$" 13194139535947 17592186045417 true] [17592186547053 1068 #edb/ref 17592186546854 13194139535947 17592186045417 true] [17592186547053 1069 "q-280272" 13194139535947 17592186045417 true] [17592186547053 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547053 1071 "![](images/9b/9b922282db5fce22af7df867b36545077f7d609dc83ef97abf46d5f9814cbc3c.png)\n\nRounded to the **nearest integer**, the area of $△ABC$ is{{field-1}} ${\\text{mi}}^{2}.$" 13194139535947 17592186045417 true] [17592186547053 1072 #uuid "cade1253-bc92-5811-80c5-a30e8af6f3ca" 13194139535947 17592186045417 true] [17592186547053 1074 "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere, we have\n\n$$\n\\begin{aligned}с & =AB=36, \\\\ b & =AC=36, \\\\ m∠A & ={70}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{70}^{∘}=0.939\\,693,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot 36\\cdot 36\\cdot \\operatorname{sin}⁡{70}^{∘} \\\\  & =648\\cdot (0.939\\,693) \\\\  & ≈609\\,{\\text{mi}}^{2},\\end{aligned}\n$$\n\nrounded to the **nearest integer**." 13194139535947 17592186045417 true] [17592186547054 1068 #edb/ref 17592186546916 13194139535947 17592186045417 true] [17592186547054 1069 "q-344849" 13194139535947 17592186045417 true] [17592186547054 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547054 1071 "Find the least distance between the curve $y=\\sqrt{|x-1|}+2$ and the point $P(2,2).$ Do not round the answer.\n\n$d=$ \n{{field-1}}" 13194139535947 17592186045417 true] [17592186547054 1072 #uuid "ceab1153-db5f-5530-aee8-9a4937774de9" 13194139535947 17592186045417 true] [17592186547054 1074 "Let us consider the *squared* distance $S$ between $(2,2)$ and a general point $P(x,y):$\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-2)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{|x-1|}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-2)^{2} \\\\  & =(x-2)^{2}+{(\\sqrt{|x-1|}+2-2)}^{2} \\\\  & =(x-2)^{2}+|x-1|.\\end{aligned}\n$$\n\nFor $x\\ge 1,$ we have $|x-1|=x-1,$ so\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+x-1 \\\\  & ={x}^{2}-4x+4+x-1 \\\\  & ={x}^{2}-3x+3.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-3 & =0 \\\\ 2x & =3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{3}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{3}{2}$ is given by\n\n$$\nd=\\sqrt{S\\,(\\frac{3}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(\\frac{3}{2})} \\\\  & =\\sqrt{{(\\frac{3}{2})}^{2}-3(\\frac{3}{2})+3} \\\\  & =\\sqrt{\\frac{9}{4}-\\frac{9}{2}+3} \\\\  & =\\sqrt{\\frac{3}{4}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547055 1068 #edb/ref 17592186546909 13194139535947 17592186045417 true] [17592186547055 1069 "q-327578" 13194139535947 17592186045417 true] [17592186547055 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547055 1071 "Museum attendance increased to $120%$ of last year’s total. Of those visitors, $90%$ also attended the art exhibit. What percentage of last year’s total attended the art exhibit?" 13194139535947 17592186045417 true] [17592186547055 1072 #uuid "d087556b-949f-5317-94fd-7ed1bb1bb119" 13194139535947 17592186045417 true] [17592186547055 1074 "Let $x$ be the number of visitors last year.\n\nWe're told that attendance increased to $120%$ of last year’s total. Thus, the new number of visitors is $1.2x.$\n\nWe are also told that of those visitors, $90%$ attended the art exhibit. So, the number of visitors who attended the art exhibit is\n\n$$\n0.9(1.2x)=1.08x.\n$$\n\nThe expression $1.08x$ represents $108%$ of $x.$ Therefore, $108%$ of last year’s total attended the art exhibit." 13194139535947 17592186045417 true] [17592186547056 1068 #edb/ref 17592186546898 13194139535947 17592186045417 true] [17592186547056 1069 "q-100276" 13194139535947 17592186045417 true] [17592186547056 1070 #edb/ref 17592186045486 13194139535947 17592186045417 true] [17592186547056 1071 "What is the value of $y$ if ${e}^{5-y}=\\sqrt[4]{7}?$" 13194139535947 17592186045417 true] [17592186547056 1072 #uuid "d0fb4c30-2477-5421-b3da-f8a97304168e" 13194139535947 17592186045417 true] [17592186547056 1074 "First, we find the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{e}^{5-y} & =\\sqrt[4]{7} \\\\ \\operatorname{ln}⁡({e}^{5-y}) & =\\operatorname{ln}⁡(\\sqrt[4]{7})\\end{aligned}\n$$\n\nNow, we use the fact that $\\operatorname{ln}⁡({e}^{a})=a$ to simplify the left-hand side. This gives:\n\n$$\n5-y=\\operatorname{ln}⁡(\\sqrt[4]{7})\n$$\n\nNext, we write $\\sqrt[4]{7}$ as ${7}^{1/4}.$ So, we get:\n\n$$\n5-y=\\operatorname{ln}⁡({7}^{1/4})\n$$\n\nFinally, we rewrite the right-hand side using power law of logarithms and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}5-y & =\\operatorname{ln}⁡({7}^{1/4}) \\\\ 5-y & =\\frac{1}{4}\\operatorname{ln}⁡(7) \\\\ -y & =\\frac{1}{4}\\operatorname{ln}⁡(7)-5 \\\\ y & =5-\\frac{1}{4}\\operatorname{ln}⁡(7)\\end{aligned}\n$$\n\nTherefore, the solution is $y=5-\\frac{1}{4}\\operatorname{ln}⁡(7).$" 13194139535947 17592186045417 true] [17592186547057 1068 #edb/ref 17592186546911 13194139535947 17592186045417 true] [17592186547057 1068 #edb/ref 17592186546939 13194139535947 17592186045417 true] [17592186547057 1069 "q-342187" 13194139535947 17592186045417 true] [17592186547057 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547057 1071 "Find the equation of the normal line to the curve $y=4x-\\frac{2}{x}$ at the point $(-1,-2).$\n\n$x\\,+$\n{{field-1}}$\\cdot \\,y\\,=$\n{{field-2}}" 13194139535947 17592186045417 true] [17592186547057 1072 #uuid "d27eb9e3-1a36-5293-b88b-ba67a6d55870" 13194139535947 17592186045417 true] [17592186547057 1074 "Let $f(x)=4x-\\frac{2}{x}.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x-\\frac{2}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(4x-2{x}^{-1}) \\\\  & =4+2{x}^{-2} \\\\  & =4+\\frac{2}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(-1,-2):$\n\n$$\nm={f}^{′}(-1)=4+\\frac{2}{(-1)^{2}}=4+2=6\n$$\n\nTherefore, the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{6}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(-2) & =-\\frac{1}{6}[x-(-1)] \\\\ -6(y+2) & =x+1 \\\\ -6y-12 & =x+1 \\\\ x+6\\cdot y & =-13.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547058 1068 #edb/ref 17592186546849 13194139535947 17592186045417 true] [17592186547058 1069 "q-79866" 13194139535947 17592186045417 true] [17592186547058 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547058 1071 "Solve the equation ${log}_{2}⁡(2x-5)=\\frac{1}{3}{log}_{2}⁡(27).$" 13194139535947 17592186045417 true] [17592186547058 1072 #uuid "d3ac80cd-6459-5be8-953c-5d7b28bc8da8" 13194139535947 17592186045417 true] [17592186547058 1074 "First, we use the power rule to simplify the right-hand side. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡(2x-5) & =\\frac{1}{3}{log}_{2}⁡(27) \\\\ {log}_{2}⁡(2x-5) & ={log}_{2}⁡({27}^{1/3}) \\\\ {log}_{2}⁡(2x-5) & ={log}_{2}⁡(3).\\end{aligned}\n$$\n\nSince the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡(2x-5) & ={log}_{2}⁡(3) \\\\ 2x-5 & =3 \\\\ 2x & =8 \\\\ x & =4.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=4$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{2}⁡(2x-5) & ={log}_{2}⁡(2(4)-5) \\\\  & ={log}_{2}⁡(3) \\\\  & =\\frac{1}{3}{log}_{2}⁡(27).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=4$ is a valid solution." 13194139535947 17592186045417 true] [17592186547059 1068 #edb/ref 17592186546921 13194139535947 17592186045417 true] [17592186547059 1069 "q-95757" 13194139535947 17592186045417 true] [17592186547059 1070 #edb/ref 17592186045486 13194139535947 17592186045417 true] [17592186547059 1071 "An archer practices firing an arrow at a target $60$ times. The archer has a $44%$ chance of hitting the bull's eye. Using the normal approximation to the binomial distribution, estimate the probability that the archer hits the bull's eye more than $30$ times. Give your final answer to three decimal places.\n\n*Hint: The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.9\\,$ | $\\,0.8289\\,$ | $\\,0.8315\\,$ | $\\,0.8340\\,$ |\n| $\\,1.0\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ | $\\,0.8577\\,$ |\n| $\\,1.1\\,$ | $\\,0.8749\\,$ | $\\,0.8770\\,$ | $\\,0.8790\\,$ |" 13194139535947 17592186045417 true] [17592186547059 1072 #uuid "d478ba2f-45cc-54a9-9136-5867345b4ca9" 13194139535947 17592186045417 true] [17592186547059 1074 "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=60$ and $p=0.44.$ Therefore, \n\n$$\n\\begin{aligned}np & =60\\cdot 0.44 \\\\  & =26.4 \\\\  & >5\\,✓ \\\\ n(1-p) & =60\\cdot (1-0.44) \\\\  & =33.6 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(60)(0.44)=26.4\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(60)(0.44)(1-0.44)=14.784.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(26.4,14.784).$\n\nNow, we can estimate the desired probability $P(X>30).$ Using a continuity correction, we have\n\n$$\nP(X>30)=P(X\\ge 31)≈P(Y\\ge 30.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 30.5) & =P(Z\\ge \\frac{30.5-26.4}{\\sqrt{14.784}}) \\\\  & ≈P(Z\\ge 1.07) \\\\  & =1-P(Z<1.07) \\\\  & =1-P(Z\\le 1.07) \\\\  & =1-Φ(1.07) \\\\  & =1-0.8577 \\\\  & =0.1423\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X>30)≈0.142.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.1431.$" 13194139535947 17592186045417 true] [17592186547060 1068 #edb/ref 17592186546871 13194139535947 17592186045417 true] [17592186547060 1069 "q-340461" 13194139535947 17592186045417 true] [17592186547060 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547060 1071 "Evaluate the following integral.\n\n${\\int }_{\\pi /4}^{\\pi }\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$ {{field-1}}" 13194139535947 17592186045417 true] [17592186547060 1072 #uuid "d4d3424f-8de3-594c-bbdf-8f7aff226934" 13194139535947 17592186045417 true] [17592186547060 1074 "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(3x) & =\\frac{1}{2}(\\operatorname{cos}⁡(5x-3x)+\\operatorname{cos}⁡(5x+3x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(2x)+\\operatorname{cos}⁡(8x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi }\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi }\\frac{1}{2}\\operatorname{cos}⁡(2x)+\\frac{1}{2}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & ={[\\frac{1}{4}\\operatorname{sin}⁡(2x)+\\frac{1}{16}\\operatorname{sin}⁡(8x)]}_{\\pi /4}^{\\pi } \\\\  & =\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(\\frac{\\pi }{2}))+\\frac{1}{16}(\\operatorname{sin}⁡(8\\pi )-\\operatorname{sin}⁡(2\\pi )) \\\\  & =\\frac{1}{4}(0-1)+\\frac{1}{16}(0-0) \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547061 1068 #edb/ref 17592186546874 13194139535947 17592186045417 true] [17592186547061 1069 "q-18350" 13194139535947 17592186045417 true] [17592186547061 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547061 1071 "![](images/4b/4b0ea03d4978d331f00b3b3aaa30eadc6ebf9eba11eeb5ce24471733dfa5d5ea.png)\n\nWhat's the equation of the above curve?" 13194139535947 17592186045417 true] [17592186547061 1072 #uuid "d6d42626-1630-5415-b727-5fab82c438c2" 13194139535947 17592186045417 true] [17592186547061 1074 "This is the curve $y=-{x}^{3}$ that's been translated \n\n- $1$ unit to the *left*, and\n\n- $2$ units *down*.\n\n![](images/ae/aec16fd32015f07c13874ddb0ff41da1d5eae62a2b008c4d6aad0e0ab4cb0744.png)\n\nTherefore, the correct answer is $y=-(x\\,+\\,1)^{3}\\,-\\,2.$" 13194139535947 17592186045417 true] [17592186547062 1068 #edb/ref 17592186546839 13194139535947 17592186045417 true] [17592186547062 1069 "q-15065" 13194139535947 17592186045417 true] [17592186547062 1070 #edb/ref 17592186045486 13194139535947 17592186045417 true] [17592186547062 1071 "![](images/64/64df05c00478aa48d89b31dc863754cb7208af54fec4cc8b8aa60d7781d112f5.png)\n\nWhich of the following gives the **total** shaded area between the polar curves $r=4\\operatorname{sin}⁡(6\\theta )$ and $r=2,$ as shown above?" 13194139535947 17592186045417 true] [17592186547062 1072 #uuid "d72c64e9-1c34-5dde-8da8-48ecae95911d" 13194139535947 17592186045417 true] [17592186547062 1074 "Consider the first petal counterclockwise from the $x$-axis. First, we find the values of $\\theta $ for which the two curves intersect:\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡(6\\theta ) & =2 \\\\ \\operatorname{sin}⁡(6\\theta ) & =\\frac{1}{2}\\end{aligned}\n$$\n\nThis gives us solutions for $6\\theta \\in [0,\\frac{\\pi }{2}]:$\n\n$$\n6\\theta =\\frac{\\pi }{6},\\frac{5\\pi }{6}\\,⟹\\,\\theta =\\frac{\\pi }{36},\\frac{5\\pi }{36}\n$$\n\nTo determine which is the inner function and which is the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/80/8009286c1ac5315e82f3dbab0e4b39a8997c5294482b31d78e43d68a44de1cb9.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=2,$ and\n\n- *leaves* through the outer function $r=4\\operatorname{sin}⁡(6\\theta ).$\n\nTo find the area, we use the formula\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}\\theta ,\n$$\n\nwhere\n\n$\\,$ ${\\theta }_{1}=\\frac{\\pi }{36},\\,$ and $\\,{\\theta }_{2}=\\frac{5\\pi }{36}.$ \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}{\\int }_{\\pi /36}^{5\\pi /36}[{(4\\operatorname{sin}⁡(6\\theta ))}^{2}-{2}^{2}]\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /36}^{5\\pi /36}(16{sin}^{2}⁡(6\\theta )-4)\\text{d}\\theta  \\\\  & =2{\\int }_{\\pi /36}^{5\\pi /36}(4{sin}^{2}⁡(6\\theta )-1)\\text{d}\\theta \\,.\\end{aligned}\n$$\n\nFinally, the *total* shaded area is\n\n$$\nA=12{A}_{1}=24{\\int }_{\\pi /36}^{5\\pi /36}(4{sin}^{2}⁡(6\\theta )-1)\\,\\text{d}\\theta \\,.\n$$" 13194139535947 17592186045417 true] [17592186547063 1068 #edb/ref 17592186546930 13194139535947 17592186045417 true] [17592186547063 1069 "q-148422" 13194139535947 17592186045417 true] [17592186547063 1070 #edb/ref 17592186045486 13194139535947 17592186045417 true] [17592186547063 1071 "$$\nf(x,y)=\\{\\begin{aligned}\\frac{8({x}^{2}+{y}^{2})}{\\pi }, & \\,x\\ge 0,\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{8}{5\\pi },\\,\\text{E}[Y]=\\frac{8}{5\\pi },\\,\\text{SD}[X]≈0.2719,\\,\\text{SD}[Y]≈0.2719,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." 13194139535947 17592186045417 true] [17592186547063 1072 #uuid "db6e411e-8a97-527f-83cb-17311240c8a4" 13194139535947 17592186045417 true] [17592186547063 1074 "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt{1-{y}^{2}}}xy\\cdot \\frac{8({x}^{2}+{y}^{2})}{\\pi }\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{8}{\\pi }\\text{ }{\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt{1-{y}^{2}}}({x}^{3}y+x{y}^{3})\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{8}{\\pi }{\\int }_{0}^{1}{[\\frac{1}{4}{x}^{4}y+\\frac{1}{2}{x}^{2}{y}^{3}]}_{x=0}^{x=\\sqrt{1-{y}^{2}}}\\text{d}y \\\\  & =\\frac{8}{\\pi }{\\int }_{0}^{1}[\\frac{1}{4}{(1-{y}^{2})}^{2}y+\\frac{1}{2}(1-{y}^{2}){y}^{3}]\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{1}[(1-2{y}^{2}+{y}^{4})y+2(1-{y}^{2}){y}^{3}]\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{1}(y-{y}^{5})\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{[\\frac{1}{2}{y}^{2}-\\frac{1}{6}{y}^{6}]}_{0}^{1} \\\\  & =\\frac{2}{3\\pi }\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{2}{3\\pi }-(\\frac{8}{5\\pi })(\\frac{8}{5\\pi }) \\\\  & =\\frac{50\\pi -192}{75{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(\\frac{50\\pi -192}{75{\\pi }^{2}})}{(0.2719)\\cdot (0.2719)} \\\\  & ≈-0.64,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." 13194139535947 17592186045417 true] [17592186547064 1068 #edb/ref 17592186546923 13194139535947 17592186045417 true] [17592186547064 1069 "q-340459" 13194139535947 17592186045417 true] [17592186547064 1070 #edb/ref 17592186045487 13194139535947 17592186045417 true] [17592186547064 1071 "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(x)\\,\\text{d}x=$ {{field-1}}" 13194139535947 17592186045417 true] [17592186547064 1072 #uuid "dc83095a-e05b-5bdd-9ae4-88a129415b52" 13194139535947 17592186045417 true] [17592186547064 1074 "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{cos}⁡(5x-x)+\\operatorname{cos}⁡(5x+x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(4x)+\\operatorname{cos}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\frac{1}{2}\\operatorname{cos}⁡(4x)+\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{8}\\operatorname{sin}⁡(4x)+\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{0}^{\\pi /4} \\\\  & =\\frac{1}{8}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{12}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{8}(0-0)+\\frac{1}{12}(-1-0) \\\\  & =-\\frac{1}{12}.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547065 1068 #edb/ref 17592186546914 13194139535947 17592186045417 true] [17592186547065 1069 "q-100769" 13194139535947 17592186045417 true] [17592186547065 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547065 1071 "Given that $\\operatorname{log}⁡(3x-5)=\\operatorname{log}⁡(7-x),$ what is the value of $x?$" 13194139535947 17592186045417 true] [17592186547065 1072 #uuid "de567b40-8a36-58e6-967e-d32432dbd495" 13194139535947 17592186045417 true] [17592186547065 1074 "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(3x-5) & =\\operatorname{log}⁡(7-x) \\\\ 3x-5 & =7-x \\\\ 4x & =12 \\\\ x & =3.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=3$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(3(3)-5) & \\overset{?}{=}\\operatorname{log}⁡(7-3) \\\\ \\operatorname{log}⁡(4) & =\\operatorname{log}⁡(4)\\,✓\\end{aligned}\n$$\n\nTherefore, $x=3$ is a valid solution." 13194139535947 17592186045417 true] [17592186547066 1068 #edb/ref 17592186546892 13194139535947 17592186045417 true] [17592186547066 1069 "q-126260" 13194139535947 17592186045417 true] [17592186547066 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547066 1071 "![](images/38/38e504d9538d35b8fbee3e38973205172ef7fc0e54f68c2a4fdeb6feb5b340eb.png)\n\nWhich of the following gives the area of the shaded region that lies between the polar curves $r=3\\operatorname{sin}⁡\\theta $ and $r=\\sqrt{2}+\\operatorname{sin}⁡\\theta ,$ as shown above?" 13194139535947 17592186045417 true] [17592186547066 1072 #uuid "e0d9c8a7-20cc-529a-a843-385acbf53e4f" 13194139535947 17592186045417 true] [17592186547066 1074 "First, we find the values of $\\theta $ for which the two curves intersect:\n\n$$\n\\begin{aligned}3\\operatorname{sin}⁡\\theta  & =\\sqrt{2}+\\operatorname{sin}⁡\\theta  \\\\ 2\\operatorname{sin}⁡\\theta  & =\\sqrt{2} \\\\ \\operatorname{sin}⁡\\theta  & =\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nWe have two solutions: \n\n$\\,$ $\\theta =\\frac{\\pi }{4},\\frac{3\\pi }{4}$    \n\nTo determine the inner function and the outer, let's draw an arrow from the origin that passes through the shaded region.\n\n![](images/1a/1a99df490145fae473eb72c320bb4971fe10b63e1a6f15a4fb8c699f01fb6f83.png)\n\nThe arrow\n\n- *enters* the region through the inner function $r=\\sqrt{2}+\\operatorname{sin}⁡\\theta ,$ and\n\n- *leaves* through the outer function $r=3\\operatorname{sin}⁡\\theta .$\n\nTo find the area, we use the formula\n\n$$\nA=\\frac{1}{2}{\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}([\\text{outer}]^{2}-[\\text{inner}]^{2})\\,\\text{d}\\theta ,\n$$\n\n \n\nwhere\n\n$\\,$ ${\\theta }_{1}=\\frac{\\pi }{4}\\,$ and $\\,{\\theta }_{2}=\\frac{3\\pi }{4}.$    \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}((3\\operatorname{sin}⁡\\theta )^{2}-(\\sqrt{2}+\\operatorname{sin}⁡\\theta )^{2})\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}(9{sin}^{2}⁡\\theta -(2+2\\sqrt{2}\\operatorname{sin}⁡\\theta +{sin}^{2}⁡\\theta ))\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}(8{sin}^{2}⁡\\theta -2\\sqrt{2}\\operatorname{sin}⁡\\theta -2)\\,\\text{d}\\theta .\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547067 1068 #edb/ref 17592186546860 13194139535947 17592186045417 true] [17592186547067 1069 "q-340103" 13194139535947 17592186045417 true] [17592186547067 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547067 1071 "Given the function  $y=\\operatorname{ln}⁡x+2\\cdot {3}^{x}-1$, find the instantaneous rate of change at $x=1.$ Do not round the answer.\n\nThe instantaneous rate of change at $x=1$ is\n{{field-1}}." 13194139535947 17592186045417 true] [17592186547067 1072 #uuid "e2977b6b-7b41-5dba-a0b9-9d44c80b37c2" 13194139535947 17592186045417 true] [17592186547067 1074 "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡x+2\\cdot {3}^{x}-1) \\\\  & =\\frac{1}{x}+2\\cdot {3}^{x}\\operatorname{ln}⁡(3).\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(\\frac{1}{x}+2\\cdot {3}^{x}\\operatorname{ln}⁡(3))|}_{x=1} \\\\  & =\\frac{1}{1}+2\\cdot {3}^{1}\\operatorname{ln}⁡(3) \\\\  & =1+6\\operatorname{ln}⁡(3)\\,.\\end{aligned}\n$$" 13194139535947 17592186045417 true] [17592186547068 1068 #edb/ref 17592186546954 13194139535947 17592186045417 true] [17592186547068 1069 "q-134450" 13194139535947 17592186045417 true] [17592186547068 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547068 1071 "The data sets $x$ and $y$ have the following properties:\n\n$$\n{S}_{xx}=186,\\,{S}_{xy}=2,\\,{S}_{yy}=96\n$$\n\nCalculate the corresponding linear correlation coefficient. Round your answer to $2$ decimal places." 13194139535947 17592186045417 true] [17592186547068 1072 #uuid "e77a74f0-0303-531d-b1fe-933e8eb337ca" 13194139535947 17592186045417 true] [17592186547068 1074 "Recall the definitions of ${S}_{xx},$ ${S}_{xy},$ and ${S}_{yy}$ for the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}:$\n\n$$\n{S}_{xx}={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2},\\,{S}_{xy}={\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\\,{S}_{yy}={\\sum }_{i=1}^{n}({y}_{i}-\\overset{―}{y})^{2}\n$$\n\nThe linear correlation coefficient $\\rho $ of the data sets $x$ and $y$ is given by \n\n$$\n\\rho (x,y)=\\frac{\\text{Cov}(x,y)}{{\\sigma }_{x}\\cdot {\\sigma }_{y}}=\\frac{{S}_{xy}}{\\sqrt{{S}_{xx}\\cdot {S}_{yy}}}.\n$$\n\nUsing the formula, we get\n\n$$\n\\begin{aligned}\\rho (x,y) & =\\frac{2}{\\sqrt{186}\\cdot \\sqrt{96}} \\\\  & ≈\\frac{2}{13.638\\,182\\cdot 9.797\\,959} \\\\  & ≈0.01\\end{aligned}\n$$\n\nrounded to $2$ decimal places." 13194139535947 17592186045417 true] [17592186547069 1068 #edb/ref 17592186546948 13194139535947 17592186045417 true] [17592186547069 1069 "q-218571" 13194139535947 17592186045417 true] [17592186547069 1070 #edb/ref 17592186045485 13194139535947 17592186045417 true] [17592186547069 1071 "If $81{a}^{2}=16,$ then $a=${{field-1}}." 13194139535947 17592186045417 true] [17592186547069 1072 #uuid "e7a7bc64-476c-516f-9ef3-e891c084febe" 13194139535947 17592186045417 true] [17592186547069 1074 "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}8