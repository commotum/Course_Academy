fe-985b-068cd754088c" :step/id #uuid "244028d0-80f0-53fe-985b-068cd754088c" :step/content 17592186262721 :step/next "step-ca75fa0e-2e8e-54d5-8bf1-eb9a2e064862" :db/ensure [:step/validate]} {:db/id "step-ca75fa0e-2e8e-54d5-8bf1-eb9a2e064862" :step/id #uuid "ca75fa0e-2e8e-54d5-8bf1-eb9a2e064862" :step/content 17592186262734 :step/next "step-8ba5ec6f-d785-5185-aba1-3e57718869aa" :db/ensure [:step/validate]} {:db/id "step-8ba5ec6f-d785-5185-aba1-3e57718869aa" :step/id #uuid "8ba5ec6f-d785-5185-aba1-3e57718869aa" :step/content 17592186262738 :db/ensure [:step/validate]} {:db/id "question-bc404082-c599-5306-899d-26fb5a707805" :question/id #uuid "bc404082-c599-5306-899d-26fb5a707805" :question/math-academy-id "q-114875" :question/problem "Evaluate the integral ${\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}x}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2})(\\frac{\\operatorname{sin}⁡(2x)}{2})-\\int (\\frac{\\operatorname{sin}⁡(2x)}{2})(6x)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3{\\int }_{0}^{\\pi /2}x\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(2x)\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}x}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})\\cdot 1\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}\\int \\operatorname{cos}⁡(2x)\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+D\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}-3(-\\frac{x\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+D) \\\\  & =\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}+C\\end{aligned}\n$$\n\nwhere $C=-3D.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x & ={[\\frac{3{x}^{2}\\operatorname{sin}⁡(2x)}{2}+\\frac{3x\\operatorname{cos}⁡(2x)}{2}-\\frac{3\\operatorname{sin}⁡(2x)}{4}]}_{0}^{\\pi /2} \\\\  & =\\frac{3{(\\frac{\\pi }{2})}^{2}\\operatorname{sin}⁡(\\pi )}{2}+\\frac{3(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\pi )}{2}-\\frac{3\\operatorname{sin}⁡(\\pi )}{4}-(\\frac{3(0)^{2}\\operatorname{sin}⁡(0)}{2}+\\frac{3(0)\\operatorname{cos}⁡(0)}{2}-\\frac{3\\operatorname{sin}⁡(0)}{4}) \\\\  & =0+\\frac{3\\pi (-1)}{4}-0-0 \\\\  & =-\\frac{3\\pi }{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-60100382-bef0-5d40-8e4e-57031710307e"] :db/ensure [:question/validate]} {:db/id "answer-field-60100382-bef0-5d40-8e4e-57031710307e" :answer-field/id #uuid "60100382-bef0-5d40-8e4e-57031710307e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea372be5-00ac-5d06-b324-96a9d214c32b" :answer-field/choices ["answer-ea372be5-00ac-5d06-b324-96a9d214c32b" "answer-a47b0af8-b237-5b70-8f37-b67b00a01cef" "answer-71e229f8-046f-5d88-8cf3-15d0ca09c39a" "answer-6f2ba34b-4251-5e97-822e-7d6f89fec290" "answer-52851b61-8b9c-53cc-91c6-5200fa78f1ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea372be5-00ac-5d06-b324-96a9d214c32b" :answer/id #uuid "ea372be5-00ac-5d06-b324-96a9d214c32b" :answer/type :answer.type/math :answer/value "-\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-a47b0af8-b237-5b70-8f37-b67b00a01cef" :answer/id #uuid "a47b0af8-b237-5b70-8f37-b67b00a01cef" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-71e229f8-046f-5d88-8cf3-15d0ca09c39a" :answer/id #uuid "71e229f8-046f-5d88-8cf3-15d0ca09c39a" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-6f2ba34b-4251-5e97-822e-7d6f89fec290" :answer/id #uuid "6f2ba34b-4251-5e97-822e-7d6f89fec290" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-52851b61-8b9c-53cc-91c6-5200fa78f1ed" :answer/id #uuid "52851b61-8b9c-53cc-91c6-5200fa78f1ed" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "question-88eae5cb-fb52-512e-a423-9c404ac93779" :question/id #uuid "88eae5cb-fb52-512e-a423-9c404ac93779" :question/math-academy-id "q-346501" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{e}18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡x)^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=18{x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 18{x}^{2}\\,\\text{d}x=6{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x)}^{2}(6{x}^{3})-\\int (6{x}^{3})(\\frac{2\\operatorname{ln}⁡x}{x})\\,\\text{d}x \\\\  & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-12\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡x}{3}-\\frac{1}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡x}{3}-\\frac{{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\,\\text{d}x & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-12\\int {x}^{2}\\operatorname{ln}⁡x\\,\\text{d}x \\\\  & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-12(\\frac{{x}^{3}\\operatorname{ln}⁡x}{3}-\\frac{{x}^{3}}{9}+D) \\\\  & =6{x}^{3}{(\\operatorname{ln}⁡x)}^{2}-4{x}^{3}\\operatorname{ln}⁡x+\\frac{4{x}^{3}}{3}-12D \\\\  & ={x}^{3}(6{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡x+\\frac{4}{3})+C,\\end{aligned}\n$$\n\nwhere $C=-12D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}18{x}^{2}(\\operatorname{ln}⁡x)^{2}\\text{d}x & ={[{x}^{3}(6{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡x+\\frac{4}{3})]}_{1}^{e} \\\\  & =[{e}^{3}(6{(\\operatorname{ln}⁡e)}^{2}-4\\operatorname{ln}⁡e+\\frac{4}{3})]-[{1}^{3}(6{(\\operatorname{ln}⁡1)}^{2}-4\\operatorname{ln}⁡1+\\frac{4}{3})] \\\\  & =[{e}^{3}(6-4+\\frac{4}{3})]-\\frac{4}{3} \\\\  & =\\frac{10{e}^{3}-4}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e456e79c-9696-5fd5-914c-4b58ab494688"] :db/ensure [:question/validate]} {:db/id "answer-field-e456e79c-9696-5fd5-914c-4b58ab494688" :answer-field/id #uuid "e456e79c-9696-5fd5-914c-4b58ab494688" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3c1e0f93-78e7-591e-b13d-1e75cf7634cc" :answer-field/choices ["answer-3c1e0f93-78e7-591e-b13d-1e75cf7634cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c1e0f93-78e7-591e-b13d-1e75cf7634cc" :answer/id #uuid "3c1e0f93-78e7-591e-b13d-1e75cf7634cc" :answer/type :answer.type/math :answer/value "\\frac{10{e}^{3}-4}{3}" :db/ensure [:answer/validate]} {:db/id 17592186320624 :answer-field/correct "answer-aa63f575-8e52-5911-b87b-39631af04e6c" :answer-field/choices ["answer-aa63f575-8e52-5911-b87b-39631af04e6c"] :db/ensure [:answer-field/validate]} {:db/id "answer-aa63f575-8e52-5911-b87b-39631af04e6c" :answer/id #uuid "aa63f575-8e52-5911-b87b-39631af04e6c" :answer/type :answer.type/math :answer/value "\\pi^{2}-4" :db/ensure [:answer/validate]} {:db/id 17592186320377 :answer-field/correct "answer-3dee1ca0-af04-5580-8c4b-40ffbe8b236e" :answer-field/choices ["answer-3dee1ca0-af04-5580-8c4b-40ffbe8b236e"] :db/ensure [:answer-field/validate]} {:db/id "answer-3dee1ca0-af04-5580-8c4b-40ffbe8b236e" :answer/id #uuid "3dee1ca0-af04-5580-8c4b-40ffbe8b236e" :answer/type :answer.type/math :answer/value "-6\\pi" :db/ensure [:answer/validate]} {:db/id "activity-333b738c-50d1-58ad-bd4c-8e1bcce1c0a9" :activity/id #uuid "333b738c-50d1-58ad-bd4c-8e1bcce1c0a9" :activity/title "Applying the Integration By Parts Twice" :activity/type :activity.type/review :activity/scope 17592186049069 :activity/course 17592186046645 :activity/steps ["step-d6dd1fb5-7500-53b2-92b3-d30c54396c8f" "step-aeb6cf6a-16c5-5b68-852d-5618fe48037e" "step-a4bbd805-d804-517d-a8e5-32021f33212a" "step-c9eb948f-4211-54cf-b715-46e2e89288c3" "step-64a57aef-d6e9-5810-96e6-0a4d5d4de0bb"] :activity/first-step "step-d6dd1fb5-7500-53b2-92b3-d30c54396c8f" :db/ensure [:activity/validate]} {:db/id "step-d6dd1fb5-7500-53b2-92b3-d30c54396c8f" :step/id #uuid "d6dd1fb5-7500-53b2-92b3-d30c54396c8f" :step/content "question-bc404082-c599-5306-899d-26fb5a707805" :step/next "step-aeb6cf6a-16c5-5b68-852d-5618fe48037e" :db/ensure [:step/validate]} {:db/id "step-aeb6cf6a-16c5-5b68-852d-5618fe48037e" :step/id #uuid "aeb6cf6a-16c5-5b68-852d-5618fe48037e" :step/content 17592186250314 :step/next "step-a4bbd805-d804-517d-a8e5-32021f33212a" :db/ensure [:step/validate]} {:db/id "step-a4bbd805-d804-517d-a8e5-32021f33212a" :step/id #uuid "a4bbd805-d804-517d-a8e5-32021f33212a" :step/content "question-88eae5cb-fb52-512e-a423-9c404ac93779" :step/next "step-c9eb948f-4211-54cf-b715-46e2e89288c3" :db/ensure [:step/validate]} {:db/id "step-c9eb948f-4211-54cf-b715-46e2e89288c3" :step/id #uuid "c9eb948f-4211-54cf-b715-46e2e89288c3" :step/content 17592186320942 :step/next "step-64a57aef-d6e9-5810-96e6-0a4d5d4de0bb" :db/ensure [:step/validate]} {:db/id "step-64a57aef-d6e9-5810-96e6-0a4d5d4de0bb" :step/id #uuid "64a57aef-d6e9-5810-96e6-0a4d5d4de0bb" :step/content 17592186320955 :db/ensure [:step/validate]} {:db/id 17592186115316 :knowledge-point/questions ["question-2264ca28-a89d-5082-9433-8c9a3ae7f639"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115990 :question/problem "Given that the random variable $X∼B(100,0.4),$ use the normal approximation to the binomial distribution to approximate $P(X=50).$ Give your final answer to three decimal places\n\n*Hint: The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. *\n\n| $z$ | $\\,0.04\\,$ | $\\,0.05\\,$ | $\\,0.06\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.9\\,$ | $\\,0.9738\\,$ | $\\,0.9744\\,$ | $\\,0.9750\\,$ |\n| $\\,2.0\\,$ | $\\,0.9793\\,$ | $\\,0.9798\\,$ | $\\,0.9803\\,$ |\n| $\\,2.1\\,$ | $\\,0.9838\\,$ | $\\,0.9842\\,$ | $\\,0.9846\\,$ |\n| $\\,2.2\\,$ | $\\,0.9875\\,$ | $\\,0.9878\\,$ | $\\,0.9881\\,$ |\n| $\\,2.3\\,$ | $\\,0.9904\\,$ | $\\,0.9906\\,$ | $\\,0.9909\\,$ |" :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=100$ and $p=0.4.$ Therefore, \n\n$$\n\\begin{aligned}np & =100\\cdot 0.4 \\\\  & =40 \\\\  & >5\\,✓ \\\\ n(1-p) & =100\\cdot (1-0.4) \\\\  & =60 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(100)(0.4)=40\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(100)(0.4)(1-0.4)=24.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(40,24).$\n\nNow, we can approximate the desired probability $P(X=50).$ Using a continuity correction, we have\n\n$$\nP(X=50)≈P(49.5\\le Y\\le 50.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(49.5\\le Y\\le 50.5) & =P(\\frac{49.5-40}{\\sqrt{24}}\\le Z\\le \\frac{50.5-40}{\\sqrt{24}}) \\\\  & ≈P(1.94\\le Z\\le 2.14) \\\\  & =P(Z\\le 2.14)-P(Z<1.94) \\\\  & =P(Z\\le 2.14)-P(Z\\le 1.94) \\\\  & =Φ(2.14)-Φ(1.94) \\\\  & =0.9838-0.9738 \\\\  & =0.010\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=50)≈0.010.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0102.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186114877 :answer-field/correct 17592186114882 :db/ensure [:answer-field/validate]} {:db/id 17592186115315 :knowledge-point/questions ["question-0c7ac018-c572-51bb-a13b-07a9824c7d91"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0c7ac018-c572-51bb-a13b-07a9824c7d91" :question/id #uuid "0c7ac018-c572-51bb-a13b-07a9824c7d91" :question/math-academy-id "q-95722" :question/problem "Which of the following probabilities could be approximated using the normal approximation of the binomial distribution?\n\nI. The probability that a student correctly solves $4$ questions in a $5$-question math test if the student has a $75%$ probability of correctly answering each question.\n\nII. The probability that $42$ flights out of $120$ arrive early at an airport if the probability of a single flight arriving early is $0.45$ for each flight.\n\nIII. The probability of getting $4$ ones on $10$ rolls of a $4$-sided die." :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nLet's now examine each situation.\n\n- In situation I, we have $n=5$ and $p=0.75.$ Therefore,\n\n$$\n\\begin{aligned}np & =5\\cdot 0.75 \\\\  & =3.75 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSo, we *cannot* use the normal approximation of the binomial distribution.\n\n- In situation II, we have $n=120$ and $p=0.45.$ Therefore, \n\n$$\n\\begin{aligned}np & =120\\cdot 0.45 \\\\  & =54 \\\\  & >5\\,✓ \\\\ n(1-p) & =120\\cdot (1-0.45) \\\\  & =66 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can use the normal approximation of the binomial distribution.\n\n- In situation III, we have $n=10$ and $p=\\frac{1}{4}.$ Therefore,\n\n$$\n\\begin{aligned}np & =10\\cdot \\frac{1}{4} \\\\  & =2.5 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSo, we *cannot* use the normal approximation of the binomial distribution.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-26bcb8a5-120e-5253-aed0-dce7591e9442"] :db/ensure [:question/validate]} {:db/id "answer-field-26bcb8a5-120e-5253-aed0-dce7591e9442" :answer-field/id #uuid "26bcb8a5-120e-5253-aed0-dce7591e9442" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f983dc56-76cf-5144-8e25-eee8a8acf15c" :answer-field/choices ["answer-25db45d4-7629-56bc-a46c-f9583b199fb6" "answer-0f393495-fa9e-5fba-89ad-9cf9d34fc9dd" "answer-9100b24b-0cf7-5ad7-b5ab-d45a5d1d1454" "answer-f983dc56-76cf-5144-8e25-eee8a8acf15c" "answer-6e1b6156-1a88-565f-af03-ff5611e465e5"] :db/ensure [:answer-field/validate]} {:db/id "answer-25db45d4-7629-56bc-a46c-f9583b199fb6" :answer/id #uuid "25db45d4-7629-56bc-a46c-f9583b199fb6" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-0f393495-fa9e-5fba-89ad-9cf9d34fc9dd" :answer/id #uuid "0f393495-fa9e-5fba-89ad-9cf9d34fc9dd" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-9100b24b-0cf7-5ad7-b5ab-d45a5d1d1454" :answer/id #uuid "9100b24b-0cf7-5ad7-b5ab-d45a5d1d1454" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-f983dc56-76cf-5144-8e25-eee8a8acf15c" :answer/id #uuid "f983dc56-76cf-5144-8e25-eee8a8acf15c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-6e1b6156-1a88-565f-af03-ff5611e465e5" :answer/id #uuid "6e1b6156-1a88-565f-af03-ff5611e465e5" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186115317 :knowledge-point/questions ["question-d478ba2f-45cc-54a9-9136-5867345b4ca9" "question-f0507dec-a4ee-5084-b5d0-2e0410c8955c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d478ba2f-45cc-54a9-9136-5867345b4ca9" :question/id #uuid "d478ba2f-45cc-54a9-9136-5867345b4ca9" :question/math-academy-id "q-95757" :question/problem "An archer practices firing an arrow at a target $60$ times. The archer has a $44%$ chance of hitting the bull's eye. Using the normal approximation to the binomial distribution, estimate the probability that the archer hits the bull's eye more than $30$ times. Give your final answer to three decimal places.\n\n*Hint: The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. *\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.9\\,$ | $\\,0.8289\\,$ | $\\,0.8315\\,$ | $\\,0.8340\\,$ |\n| $\\,1.0\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ | $\\,0.8577\\,$ |\n| $\\,1.1\\,$ | $\\,0.8749\\,$ | $\\,0.8770\\,$ | $\\,0.8790\\,$ |" :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=60$ and $p=0.44.$ Therefore, \n\n$$\n\\begin{aligned}np & =60\\cdot 0.44 \\\\  & =26.4 \\\\  & >5\\,✓ \\\\ n(1-p) & =60\\cdot (1-0.44) \\\\  & =33.6 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(60)(0.44)=26.4\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(60)(0.44)(1-0.44)=14.784.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(26.4,14.784).$\n\nNow, we can estimate the desired probability $P(X>30).$ Using a continuity correction, we have\n\n$$\nP(X>30)=P(X\\ge 31)≈P(Y\\ge 30.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 30.5) & =P(Z\\ge \\frac{30.5-26.4}{\\sqrt{14.784}}) \\\\  & ≈P(Z\\ge 1.07) \\\\  & =1-P(Z<1.07) \\\\  & =1-P(Z\\le 1.07) \\\\  & =1-Φ(1.07) \\\\  & =1-0.8577 \\\\  & =0.1423\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X>30)≈0.142.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.1431.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b472d12d-8504-5350-ae9c-0cbfdecef465"] :db/ensure [:question/validate]} {:db/id "answer-field-b472d12d-8504-5350-ae9c-0cbfdecef465" :answer-field/id #uuid "b472d12d-8504-5350-ae9c-0cbfdecef465" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cb05e951-7c6f-57f8-9e45-bf5c4d2a882d" :answer-field/choices ["answer-990b93e1-3cac-5f7d-b408-e57be8e31e56" "answer-cb05e951-7c6f-57f8-9e45-bf5c4d2a882d" "answer-62b16514-c244-5b31-97f8-c74504e64a87" "answer-ee565d64-1779-5a10-959b-2a050802e1ca" "answer-f75cf845-2c9a-5c57-90ed-30300c515a53"] :db/ensure [:answer-field/validate]} {:db/id "answer-990b93e1-3cac-5f7d-b408-e57be8e31e56" :answer/id #uuid "990b93e1-3cac-5f7d-b408-e57be8e31e56" :answer/type :answer.type/math :answer/value "0.135" :db/ensure [:answer/validate]} {:db/id "answer-cb05e951-7c6f-57f8-9e45-bf5c4d2a882d" :answer/id #uuid "cb05e951-7c6f-57f8-9e45-bf5c4d2a882d" :answer/type :answer.type/math :answer/value "0.142" :db/ensure [:answer/validate]} {:db/id "answer-62b16514-c244-5b31-97f8-c74504e64a87" :answer/id #uuid "62b16514-c244-5b31-97f8-c74504e64a87" :answer/type :answer.type/math :answer/value "0.149" :db/ensure [:answer/validate]} {:db/id "answer-ee565d64-1779-5a10-959b-2a050802e1ca" :answer/id #uuid "ee565d64-1779-5a10-959b-2a050802e1ca" :answer/type :answer.type/math :answer/value "0.151" :db/ensure [:answer/validate]} {:db/id "answer-f75cf845-2c9a-5c57-90ed-30300c515a53" :answer/id #uuid "f75cf845-2c9a-5c57-90ed-30300c515a53" :answer/type :answer.type/math :answer/value "0.158" :db/ensure [:answer/validate]} {:db/id "question-2264ca28-a89d-5082-9433-8c9a3ae7f639" :question/id #uuid "2264ca28-a89d-5082-9433-8c9a3ae7f639" :question/math-academy-id "q-132293" :question/problem "Using the normal approximation to the binomial distribution, approximate the probability of getting $30$ odd numbers on $70$ rolls of a $6$-sided die. Give your final answer to three decimal places.\n\n*Hint: The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.3\\,$</th><td align=\"center\"> $\\,0.0968\\,$ </td><td align=\"center\"> $\\,0.0951\\,$ </td><td align=\"center\"> $\\,0.0934\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.2\\,$</th><td align=\"center\"> $\\,0.1151\\,$ </td><td align=\"center\"> $\\,0.1131\\,$ </td><td align=\"center\"> $\\,0.1112\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.1\\,$</th><td align=\"center\"> $\\,0.1357\\,$ </td><td align=\"center\"> $\\,0.1335\\,$ </td><td align=\"center\"> $\\,0.1314\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.0\\,$</th><td align=\"center\"> $\\,0.1587\\,$ </td><td align=\"center\"> $\\,0.1562\\,$ </td><td align=\"center\"> $\\,0.1539\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.09\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.3\\,$</th><td align=\"center\"> $\\,0.0854\\,$ </td><td align=\"center\"> $\\,0.0838\\,$ </td><td align=\"center\"> $\\,0.0823\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.2\\,$</th><td align=\"center\"> $\\,0.1020\\,$ </td><td align=\"center\"> $\\,0.1003\\,$ </td><td align=\"center\"> $\\,0.0985\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.1\\,$</th><td align=\"center\"> $\\,0.1210\\,$ </td><td align=\"center\"> $\\,0.1190\\,$ </td><td align=\"center\"> $\\,0.1170\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.0\\,$</th><td align=\"center\"> $\\,0.1423\\,$ </td><td align=\"center\"> $\\,0.1401\\,$ </td><td align=\"center\"> $\\,0.1379\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=70$ and $p=0.5.$ Therefore, \n\n$$\n\\begin{aligned}np & =70\\cdot 0.5 \\\\  & =35 \\\\  & >5\\,✓ \\\\ n(1-p) & =70\\cdot (1-0.5) \\\\  & =35 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(70)(0.5)=35\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(70)(0.5)(1-0.5)=17.5.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(35,17.5).$\n\nNow, we can approximate the desired probability $P(X=30).$ Using a continuity correction, we have\n\n$$\nP(X=30)≈P(29.5\\le Y\\le 30.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(29.5\\le Y\\le 30.5) & =P(\\frac{29.5-35}{\\sqrt{17.5}}\\le Z\\le \\frac{30.5-35}{\\sqrt{17.5}}) \\\\  & ≈P(-1.31\\le Z\\le -1.08) \\\\  & =P(Z\\le -1.08)-P(Z<-1.31) \\\\  & =P(Z\\le -1.08)-P(Z\\le -1.31) \\\\  & =Φ(-1.08)-Φ(-1.31) \\\\  & =0.1401-0.0951 \\\\  & =0.045\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=30)≈0.045.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0469.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6f87428c-0e9e-5478-a109-4d5ef2880e2c"] :db/ensure [:question/validate]} {:db/id "answer-field-6f87428c-0e9e-5478-a109-4d5ef2880e2c" :answer-field/id #uuid "6f87428c-0e9e-5478-a109-4d5ef2880e2c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d5deec87-c49a-59df-8e7a-1cfb510a6f7c" :answer-field/choices ["answer-2d30494f-d6ab-58f3-870e-1e63da9ec982" "answer-86466a98-40c1-52d1-b985-e139aa59131e" "answer-d5deec87-c49a-59df-8e7a-1cfb510a6f7c" "answer-cd74bf35-5ee1-5c09-9af1-09b03f9a0630" "answer-1bc0687c-5235-5fca-8c76-9ff8fac5b144"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d30494f-d6ab-58f3-870e-1e63da9ec982" :answer/id #uuid "2d30494f-d6ab-58f3-870e-1e63da9ec982" :answer/type :answer.type/math :answer/value "0.035" :db/ensure [:answer/validate]} {:db/id "answer-86466a98-40c1-52d1-b985-e139aa59131e" :answer/id #uuid "86466a98-40c1-52d1-b985-e139aa59131e" :answer/type :answer.type/math :answer/value "0.040" :db/ensure [:answer/validate]} {:db/id "answer-d5deec87-c49a-59df-8e7a-1cfb510a6f7c" :answer/id #uuid "d5deec87-c49a-59df-8e7a-1cfb510a6f7c" :answer/type :answer.type/math :answer/value "0.045" :db/ensure [:answer/validate]} {:db/id "answer-cd74bf35-5ee1-5c09-9af1-09b03f9a0630" :answer/id #uuid "cd74bf35-5ee1-5c09-9af1-09b03f9a0630" :answer/type :answer.type/math :answer/value "0.050" :db/ensure [:answer/validate]} {:db/id "answer-1bc0687c-5235-5fca-8c76-9ff8fac5b144" :answer/id #uuid "1bc0687c-5235-5fca-8c76-9ff8fac5b144" :answer/type :answer.type/math :answer/value "0.055" :db/ensure [:answer/validate]} {:db/id "question-f0507dec-a4ee-5084-b5d0-2e0410c8955c" :question/id #uuid "f0507dec-a4ee-5084-b5d0-2e0410c8955c" :question/math-academy-id "q-132494" :question/problem "Given that the random variable $X∼B(100,0.5),$ use the normal approximation to the binomial distribution to approximate $P(43<X<53).$ Give your final answer to three decimal places.\n\n*Hint: The data below is taken from the table of values of the cumulative distribution function $Φ(z)$ for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.5\\,$</th><td align=\"center\"> $\\,0.0668\\,$ </td><td align=\"center\"> $\\,0.0655\\,$ </td><td align=\"center\"> $\\,0.0643\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.4\\,$</th><td align=\"center\"> $\\,0.0808\\,$ </td><td align=\"center\"> $\\,0.0793\\,$ </td><td align=\"center\"> $\\,0.0778\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-1.3\\,$</th><td align=\"center\"> $\\,0.0968\\,$ </td><td align=\"center\"> $\\,0.0951\\,$ </td><td align=\"center\"> $\\,0.0934\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.4\\,$</th><td align=\"center\"> $\\,0.6554\\,$ </td><td align=\"center\"> $\\,0.6591\\,$ </td><td align=\"center\"> $\\,0.6628\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.5\\,$</th><td align=\"center\"> $\\,0.6915\\,$ </td><td align=\"center\"> $\\,0.6950\\,$ </td><td align=\"center\"> $\\,0.6985\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.6\\,$</th><td align=\"center\"> $\\,0.7258\\,$ </td><td align=\"center\"> $\\,0.7291\\,$ </td><td align=\"center\"> $\\,0.7324\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=100$ and $p=0.5.$ Therefore, \n\n$$\n\\begin{aligned}np & =100\\cdot 0.5 \\\\  & =50 \\\\  & >5\\,✓ \\\\ n(1-p) & =100\\cdot (1-0.5) \\\\  & =50 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(100)(0.5)=50\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(100)(0.5)(1-0.5)=25.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(50,25).$\n\nNow, we can estimate the desired probability $P(43<X<53).$ Using a continuity correction, we have\n\n$$\nP(43<X<53)=P(44\\le X\\le 52)≈P(43.5\\le Y\\le 52.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(43.5\\le Y\\le 52.5) & =P(\\frac{43.5-50}{\\sqrt{25}}\\le Z\\le \\frac{52.5-50}{\\sqrt{25}}) \\\\  & ≈P(-1.30\\le Z\\le 0.50) \\\\  & =P(Z\\le 0.50)-P(Z<-1.30) \\\\  & =P(Z\\le 0.50)-P(Z\\le -1.30) \\\\  & =Φ(0.50)-Φ(-1.30) \\\\  & =0.6915-0.0968 \\\\  & =0.5947\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(43<X<53)≈0.595.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.5947.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f0fd26bd-399a-54be-b0ad-a1147ffe314c"] :db/ensure [:question/validate]} {:db/id "answer-field-f0fd26bd-399a-54be-b0ad-a1147ffe314c" :answer-field/id #uuid "f0fd26bd-399a-54be-b0ad-a1147ffe314c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bd077aeb-6760-5099-a288-912ce3b76411" :answer-field/choices ["answer-7a6c5598-a12c-551c-bb3e-56ef60b41e3a" "answer-1cca4320-57c1-5b80-a07b-265d76f41a1e" "answer-bd077aeb-6760-5099-a288-912ce3b76411" "answer-fd7b869e-897e-5d45-a2a6-59726fb76269" "answer-5b68ab59-554f-510e-b7b7-e4327a68e889"] :db/ensure [:answer-field/validate]} {:db/id "answer-7a6c5598-a12c-551c-bb3e-56ef60b41e3a" :answer/id #uuid "7a6c5598-a12c-551c-bb3e-56ef60b41e3a" :answer/type :answer.type/math :answer/value "0.559" :db/ensure [:answer/validate]} {:db/id "answer-1cca4320-57c1-5b80-a07b-265d76f41a1e" :answer/id #uuid "1cca4320-57c1-5b80-a07b-265d76f41a1e" :answer/type :answer.type/math :answer/value "0.575" :db/ensure [:answer/validate]} {:db/id "answer-bd077aeb-6760-5099-a288-912ce3b76411" :answer/id #uuid "bd077aeb-6760-5099-a288-912ce3b76411" :answer/type :answer.type/math :answer/value "0.595" :db/ensure [:answer/validate]} {:db/id "answer-fd7b869e-897e-5d45-a2a6-59726fb76269" :answer/id #uuid "fd7b869e-897e-5d45-a2a6-59726fb76269" :answer/type :answer.type/math :answer/value "0.611" :db/ensure [:answer/validate]} {:db/id "answer-5b68ab59-554f-510e-b7b7-e4327a68e889" :answer/id #uuid "5b68ab59-554f-510e-b7b7-e4327a68e889" :answer/type :answer.type/math :answer/value "0.625" :db/ensure [:answer/validate]} {:db/id "activity-4bcc3786-4ef2-5e94-b4f6-fff60fe059f8" :activity/id #uuid "4bcc3786-4ef2-5e94-b4f6-fff60fe059f8" :activity/title "Normal Approximations of Binomial Distributions" :activity/type :activity.type/review :activity/scope 17592186048589 :activity/course 17592186046658 :activity/steps ["step-9bdf7a37-260b-5c91-9420-b7356d9a3ce1" "step-d41a0344-b097-5c59-92d9-263fbe0c0f50" "step-f669a272-33c5-5b31-b4d7-071551db4a4b" "step-c1f68138-f113-5b99-8a90-b7a879a9472d" "step-9084a555-7b38-5c9d-b00d-d9bbbbf670d8"] :activity/first-step "step-9bdf7a37-260b-5c91-9420-b7356d9a3ce1" :db/ensure [:activity/validate]} {:db/id "step-9bdf7a37-260b-5c91-9420-b7356d9a3ce1" :step/id #uuid "9bdf7a37-260b-5c91-9420-b7356d9a3ce1" :step/content 17592186115990 :step/next "step-d41a0344-b097-5c59-92d9-263fbe0c0f50" :db/ensure [:step/validate]} {:db/id "step-d41a0344-b097-5c59-92d9-263fbe0c0f50" :step/id #uuid "d41a0344-b097-5c59-92d9-263fbe0c0f50" :step/content "question-0c7ac018-c572-51bb-a13b-07a9824c7d91" :step/next "step-f669a272-33c5-5b31-b4d7-071551db4a4b" :db/ensure [:step/validate]} {:db/id "step-f669a272-33c5-5b31-b4d7-071551db4a4b" :step/id #uuid "f669a272-33c5-5b31-b4d7-071551db4a4b" :step/content "question-d478ba2f-45cc-54a9-9136-5867345b4ca9" :step/next "step-c1f68138-f113-5b99-8a90-b7a879a9472d" :db/ensure [:step/validate]} {:db/id "step-c1f68138-f113-5b99-8a90-b7a879a9472d" :step/id #uuid "c1f68138-f113-5b99-8a90-b7a879a9472d" :step/content "question-2264ca28-a89d-5082-9433-8c9a3ae7f639" :step/next "step-9084a555-7b38-5c9d-b00d-d9bbbbf670d8" :db/ensure [:step/validate]} {:db/id "step-9084a555-7b38-5c9d-b00d-d9bbbbf670d8" :step/id #uuid "9084a555-7b38-5c9d-b00d-d9bbbbf670d8" :step/content "question-f0507dec-a4ee-5084-b5d0-2e0410c8955c" :db/ensure [:step/validate]} [:db/retract 17592186115793 :question/answer-fields 17592186113695] [:db/retract 17592186113713 :answer-field/choices 17592186113714] [:db/retract 17592186113713 :answer-field/choices 17592186113715] [:db/retract 17592186113713 :answer-field/choices 17592186113716] [:db/retract 17592186113713 :answer-field/choices 17592186113717] [:db/retract 17592186113713 :answer-field/choices 17592186113718] {:db/id 17592186115375 :knowledge-point/questions ["question-3404cdf4-fad8-57cc-99a9-cffaef1b2f88"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115374 :knowledge-point/questions ["question-f484bd1c-f53f-587d-99ce-e7d9cbfcb8f5" "question-72675a21-05f8-5d93-afac-bc69655e07ff"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f484bd1c-f53f-587d-99ce-e7d9cbfcb8f5" :question/id #uuid "f484bd1c-f53f-587d-99ce-e7d9cbfcb8f5" :question/math-academy-id "q-336663" :question/problem "A tank initially holds $450\\,\\text{gal}$ of a sugar-water solution containing $18\\,\\text{lb}$ of sugar.\nFresh water is poured into the tank at a rate of $15\\,\\text{gal/min},$ while the completely mixed sugar solution leaves the tank at a rate of $10\\,\\text{gal/min}.$\nFind an equation for the amount of sugar $Q(t),$ in pounds, in the tank $t$ minutes after the fresh water is first added." :question/worked-solution "Since $Q$ is the amount of sugar in the tank at time $t,$ the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which sugar enters the tank minus the rate at which sugar leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{lb}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which sugar enters the tank.\n\nFirst, note that fresh water (i.e., a solution containing $0\\,\\text{lb/gal}$ of sugar) enters the tank at a rate of $15\\,\\text{gal/min}.$ So, the rate at which the *sugar* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{lb}}{\\text{gal}})\\cdot (15\\,\\frac{\\text{gal}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}})\\cdot (15\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which sugar exits the tank.\n\nNow, to find the rate at which sugar leaves the tank, we must first determine the volume of solution in the tank at time $t.$\n\n- The tank initially contains $450\\,\\text{gal}$ of solution.\n\n- Fresh water enters the tank at a rate of $15\\,\\text{gal/min}.$ So, after $t$ minutes, $15t\\,\\text{gal}$ have entered the tank.\n\n- The completely mixed solution leaves the tank at a rate of $10\\,\\text{gal/min}.$ So, after $t$ minutes, $10t\\,\\text{gal}$ have left the tank.\n\nAs a result, the volume of solution in the tank after $t$ minutes is \n\n$$\n450+15t-10t=(450+5t)\\,\\text{gal}.\n$$\n\nThen, since $Q$ is the amount of sugar in the tank, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{450+5t}\\,\\frac{\\text{lb}}{\\text{gal}}.\n$$\n\nTherefore, as the completely mixed solution leaves at a rate of $10\\,\\text{gal/min},$ *sugar* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(10\\,\\frac{\\text{gal}}{\\text{min}})\\cdot (\\frac{Q}{450+5t}\\,\\frac{\\text{lb}}{\\text{gal}}) \\\\  & =(10\\,\\frac{\\cancel{\\text{gal}}}{\\text{min}})\\cdot (\\frac{Q}{450+5t}\\,\\frac{\\text{lb}}{\\cancel{\\text{gal}}}) \\\\  & =\\frac{10Q}{450+5t}\\,\\frac{\\text{lb}}{\\text{min}} \\\\  & =\\frac{2Q}{90+t}\\,\\frac{\\text{lb}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\ \\frac{dQ}{dt} & =0-\\frac{2Q}{90+t} \\\\ \\frac{dQ}{dt} & =-\\frac{2}{90+t}\\,Q.\\end{aligned}\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{90+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{2}{90+t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{90+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2\\operatorname{ln}⁡|90+t|+C \\\\ |Q| & ={e}^{-2\\operatorname{ln}⁡|90+t|+C} \\\\ Q(t) & =\\frac{A}{(90+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $18\\,\\text{lb}$ of sugar. So, we can apply the initial condition $Q(0)=18,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =18 \\\\ \\frac{A}{(90+0)^{2}} & =18 \\\\ A & =18\\cdot {90}^{2}\\end{aligned}\n$$\n\nFinally, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=18{(\\frac{90}{90+t})}^{2}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3f739ba7-4312-53fa-a7d7-8241e430155b"] :db/ensure [:question/validate]} {:db/id "answer-field-3f739ba7-4312-53fa-a7d7-8241e430155b" :answer-field/id #uuid "3f739ba7-4312-53fa-a7d7-8241e430155b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e35c7ab7-4248-5c5f-88c0-06d8707fb470" :answer-field/choices ["answer-fb7fcf0b-cbef-5a6f-b78e-83e21545eeb2" "answer-5535e146-fa65-5186-a97a-50884375c362" "answer-e35c7ab7-4248-5c5f-88c0-06d8707fb470" "answer-3c7cd11f-6a9e-530a-85f2-832baf9ebcb1" "answer-6d6a8521-cadb-550b-9b3c-ad524ce80812"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb7fcf0b-cbef-5a6f-b78e-83e21545eeb2" :answer/id #uuid "fb7fcf0b-cbef-5a6f-b78e-83e21545eeb2" :answer/type :answer.type/math :answer/value "Q(t)=1800{(\\frac{9}{90+t})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5535e146-fa65-5186-a97a-50884375c362" :answer/id #uuid "5535e146-fa65-5186-a97a-50884375c362" :answer/type :answer.type/math :answer/value "Q(t)=18\\frac{90}{(90+t)^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-e35c7ab7-4248-5c5f-88c0-06d8707fb470" :answer/id #uuid "e35c7ab7-4248-5c5f-88c0-06d8707fb470" :answer/type :answer.type/math :answer/value "Q(t)=18{(\\frac{90}{90+t})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-3c7cd11f-6a9e-530a-85f2-832baf9ebcb1" :answer/id #uuid "3c7cd11f-6a9e-530a-85f2-832baf9ebcb1" :answer/type :answer.type/math :answer/value "Q(t)=24{(\\frac{90}{90+t})}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-6d6a8521-cadb-550b-9b3c-ad524ce80812" :answer/id #uuid "6d6a8521-cadb-550b-9b3c-ad524ce80812" :answer/type :answer.type/math :answer/value "Q(t)=24{(\\frac{9}{90+t})}^{2}" :db/ensure [:answer/validate]} {:db/id "question-72675a21-05f8-5d93-afac-bc69655e07ff" :question/id #uuid "72675a21-05f8-5d93-afac-bc69655e07ff" :question/math-academy-id "q-336678" :question/problem "A vat initially holds $500\\,\\text{L}$ of a sugar-water solution containing $15\\,\\text{kg}$ of dissolved sugar.\nPure water is pumped into the vat at a rate of $14\\,\\text{L/min},$ while the completely mixed sugar-water solution leaves the vat at a rate of $10\\,\\text{L/min}.$\nFind, rounded to two decimal places, the amount of sugar in the vat $14$ minutes after the water pumping begins." :question/worked-solution "Let $Q$ be the amount of sugar in the vat at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which sugar enters the vat minus the rate at which sugar leaves the vat.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg}/\\text{min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which sugar enters the vat.\n\nNote that pure water (i.e., water containing $0\\,\\text{kg/L}$ of sugar) enters the vat at a rate of $14\\,\\text{L/min}.$ So, the rate at which the *sugar* enters the vat is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (14\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =(0\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}})\\cdot (14\\,\\frac{\\cancel{\\text{L}}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which sugar exits the vat.\n\nTo find the rate at which sugar leaves the vat, we first determine the volume of solution in the vat at time $t.$\n\nThe vat initially contains $500\\,\\text{L}$ of solution; water enters at $14\\,\\text{L/min}$ and drains out at $10\\,\\text{L/min}.$\nAs a result, the amount of solution in the vat after $t$ minutes is \n\n$$\n500+14t-10t=(500+4t)\\,\\text{L}.\n$$\n\nSince $Q$ is the amount of sugar in the vat, the *concentration* of the solution at time $t$ is\n\n$$\n\\frac{Q}{500+4t}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed sugar-water solution leaves at a rate of $10\\,\\text{L/min},$ *sugar* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(10\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{500+4t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =(10\\,\\frac{\\cancel{\\text{L}}}{\\text{min}})\\cdot (\\frac{Q}{500+4t}\\,\\frac{\\text{kg}}{\\cancel{\\text{L}}}) \\\\  & =\\frac{10Q}{500+4t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{5Q}{2(125+t)}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{5Q}{2(125+t)}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{5}{2(125+t)}\\,Q.\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{5}{2(125+t)} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{5}{2(125+t)})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-\\frac{5}{2}\\int \\frac{1}{125+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{5}{2}\\operatorname{ln}⁡|125+t|+C \\\\ |Q| & ={e}^{-\\frac{5}{2}\\operatorname{ln}⁡|125+t|+C} \\\\ Q(t) & =\\frac{A}{(125+t)^{5/2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the vat initially contains $15\\,\\text{kg}$ of sugar. So, we can apply the initial condition $Q(0)=15,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =15 \\\\ \\frac{A}{(125+0)^{5/2}} & =15 \\\\ A & =15\\cdot {125}^{5/2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\nQ(t)=15{(\\frac{125}{125+t})}^{5/2}\n$$\n\nFinally, the amount of sugar in the vat $14$ minutes after the water is first pumped in is\n\n$$\nQ(12)=15{(\\frac{125}{139})}^{5/2}≈11.50\\,\\text{kg},\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-32b609db-0cfa-50ce-be77-ccca954943ac"] :db/ensure [:question/validate]} {:db/id "answer-field-32b609db-0cfa-50ce-be77-ccca954943ac" :answer-field/id #uuid "32b609db-0cfa-50ce-be77-ccca954943ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d0131b4-d374-5e74-aa90-c8abda4a45ee" :answer-field/choices ["answer-6a8e3067-e0d5-573d-b2a5-05f7346c88a9" "answer-2d0131b4-d374-5e74-aa90-c8abda4a45ee" "answer-3001be2d-0b44-511f-939d-52802b97e714" "answer-74737ad0-325a-5620-b4cf-42637b26fb86" "answer-8a1829c7-cd54-5a8c-b939-0c1b1390639f"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a8e3067-e0d5-573d-b2a5-05f7346c88a9" :answer/id #uuid "6a8e3067-e0d5-573d-b2a5-05f7346c88a9" :answer/type :answer.type/math :answer/value "10.84\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-2d0131b4-d374-5e74-aa90-c8abda4a45ee" :answer/id #uuid "2d0131b4-d374-5e74-aa90-c8abda4a45ee" :answer/type :answer.type/math :answer/value "11.50\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-3001be2d-0b44-511f-939d-52802b97e714" :answer/id #uuid "3001be2d-0b44-511f-939d-52802b97e714" :answer/type :answer.type/math :answer/value "11.96\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-74737ad0-325a-5620-b4cf-42637b26fb86" :answer/id #uuid "74737ad0-325a-5620-b4cf-42637b26fb86" :answer/type :answer.type/math :answer/value "12.31\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-8a1829c7-cd54-5a8c-b939-0c1b1390639f" :answer/id #uuid "8a1829c7-cd54-5a8c-b939-0c1b1390639f" :answer/type :answer.type/math :answer/value "12.98\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id 17592186115796 :question/problem "A $9\\,800\\,\\text{mL}$-capacity tank initially holds $7\\,000\\,\\text{mL}$ of a brine (salt-water) solution containing $196\\,\\text{g}$ of salt. Fresh water begins to flow into the tank at a rate of $105\\,\\text{mL/s},$ while the completely mixed brine flows out at a rate of $70\\,\\text{mL/s}.$ Find the amount of salt in the tank at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of salt in the tank at time $t.$ Then, the derivative \n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in seconds. This is equal to the rate at which salt enters the tank minus the rate at which salt leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{g}/\\text{s}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which salt enters the tank.\n\nFirst, note that fresh water (i.e., a brine solution containing $0\\,\\text{g/mL}$ of salt) enters the tank at a rate of $105\\,\\text{mL/s}.$ So, the rate at which the *salt* enters the tank is \n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{g}}{\\text{mL}})\\cdot (105\\,\\frac{\\text{mL}}{\\text{s}}) \\\\  & =(0\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}})\\cdot (105\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}}) \\\\  & =0\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which salt exits the tank.\n\nTo find the rate at which salt leaves the tank, we must first determine the volume of brine in the tank at time $t.$\n\nThe tank initially contains $7\\,000\\,\\text{mL}$ of brine; fresh water enters at $105\\,\\text{mL/s},$ and mixed brine leaves at $70\\,\\text{mL/s}.$\nAs a result, the amount of brine in the tank after $t$ seconds is \n\n$$\nV(t)=7\\,000+105t-70t=35(200+t)\\,\\text{mL}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of salt in the tank, the concentration of the brine at time $t$ is\n\n$$\n\\frac{Q}{35(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}.\n$$\n\nTherefore, as the completely mixed brine leaves at a rate of $70\\,\\text{mL/s},$ *salt* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(70\\,\\frac{\\text{mL}}{\\text{s}})\\cdot (\\frac{Q}{35(200+t)}\\,\\frac{\\text{g}}{\\text{mL}}) \\\\  & =(70\\,\\frac{\\cancel{\\text{mL}}}{\\text{s}})\\cdot (\\frac{Q}{35(200+t)}\\,\\frac{\\text{g}}{\\cancel{\\text{mL}}}) \\\\  & =\\frac{2Q}{200+t}\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore, \n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{2Q}{200+t}\\end{aligned}\n$$\n\nwhich gives the equation\n\n$$\n\\frac{dQ}{dt}=-\\frac{2}{200+t}\\,Q.\n$$\n\n**Step 4**: Integrate the equation\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{2}{200+t} \\\\ \\int \\frac{1}{Q}\\cdot \\frac{dQ}{dt}dt & =\\int (-\\frac{2}{200+t})\\,dt \\\\ \\int \\frac{1}{Q}\\cdot \\,dQ & =-2\\int \\frac{1}{200+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-2(\\operatorname{ln}⁡|200+t|)+C \\\\ \\operatorname{ln}⁡|Q| & =\\operatorname{ln}⁡|(200+t)^{-2}|+C \\\\ |Q| & ={e}^{\\operatorname{ln}⁡|(200+t)^{-2}|+C} \\\\ Q(t) & =\\frac{A}{(200+t)^{2}},\\end{aligned}\n$$\n\nwhere $A=\\pm {e}^{C}$ is a constant of integration.\n\nWe're told that the tank initially contains $196\\,\\text{g}$ of salt. So, we can apply the initial condition $Q(0)=196,$ and solve for $A:$\n\n$$\n\\begin{aligned}Q(0) & =196 \\\\ \\frac{A}{(200+0)^{2}} & =196 \\\\ A & =196(200)^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following expression for $Q(t):$\n\n$$\n\\begin{aligned}Q(t) & =\\frac{196(200)^{2}}{(200+t)^{2}} \\\\  & =196{(\\frac{200}{200+t})}^{2}\\end{aligned}\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. The tank has a capacity of $9\\,800\\,\\text{mL},$ so we can use the condition $V({t}_{o})=9\\,800$ to solve for ${t}_{o}:$\n\n$$\n\\begin{aligned}V({t}_{o}) & =9\\,800 \\\\ 35(200+{t}_{o}) & =9\\,800 \\\\ 200+{t}_{o} & =280 \\\\ {t}_{o} & =80\\,\\text{s}\\end{aligned}\n$$\n\nFinally, the amount of salt in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(80) & =196{(\\frac{200}{200+80})}^{2} \\\\  & =196{(\\frac{5}{7})}^{2} \\\\  & =100\\,\\text{g}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186113713 :answer-field/correct "answer-6eccbf39-7b81-5f1c-9b9b-de95bddd15ef" :answer-field/choices ["answer-6eccbf39-7b81-5f1c-9b9b-de95bddd15ef" "answer-1625cbd3-6d04-52bf-ad57-d5116e771c6a" "answer-81039cc6-be6e-5a3d-9d5d-380bf1e7265b" "answer-ce095df2-3455-538e-9ce0-230be6f286f5" "answer-86f58fcb-92e0-5aca-9ded-ec1b4b86eec8"] :db/ensure [:answer-field/validate]} {:db/id "answer-6eccbf39-7b81-5f1c-9b9b-de95bddd15ef" :answer/id #uuid "6eccbf39-7b81-5f1c-9b9b-de95bddd15ef" :answer/type :answer.type/math :answer/value "100\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-1625cbd3-6d04-52bf-ad57-d5116e771c6a" :answer/id #uuid "1625cbd3-6d04-52bf-ad57-d5116e771c6a" :answer/type :answer.type/math :answer/value "102\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-81039cc6-be6e-5a3d-9d5d-380bf1e7265b" :answer/id #uuid "81039cc6-be6e-5a3d-9d5d-380bf1e7265b" :answer/type :answer.type/math :answer/value "105\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-ce095df2-3455-538e-9ce0-230be6f286f5" :answer/id #uuid "ce095df2-3455-538e-9ce0-230be6f286f5" :answer/type :answer.type/math :answer/value "110\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "answer-86f58fcb-92e0-5aca-9ded-ec1b4b86eec8" :answer/id #uuid "86f58fcb-92e0-5aca-9ded-ec1b4b86eec8" :answer/type :answer.type/math :answer/value "120\\,\\text{g}" :db/ensure [:answer/validate]} {:db/id "question-3404cdf4-fad8-57cc-99a9-cffaef1b2f88" :question/id #uuid "3404cdf4-fad8-57cc-99a9-cffaef1b2f88" :question/math-academy-id "q-336839" :question/problem "A $500\\,\\text{L}$-capacity water tank initially holds $320\\,\\text{L}$ of water containing $20\\,\\text{kg}$ of a dissolved contaminant. Clean water begins to flow into the tank at a rate of $9\\,\\text{L/min},$ while the completely mixed water flows out at a rate of $5\\,\\text{L/min}.$ Find, rounded to two decimal places, the amount of contaminant in the tank at the moment it begins to overflow." :question/worked-solution "Let $Q$ be the amount of contaminant in the tank at time $t.$ Then, the derivative\n\n$$\n\\frac{dQ}{dt}\n$$\n\ndescribes how this amount changes with respect to time $t,$ in minutes. This is equal to the rate at which contaminant enters the tank minus the rate at which contaminant leaves the tank.\n\n$$\n\\frac{dQ}{dt}={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′}\n$$\n\nNote that the units of $\\frac{dQ}{dt},{Q}_{\\text{in}}^{′}$ and ${Q}_{\\text{out}}^{′}$ are $\\text{kg/min}.$ Now, let's compute the required rates of change in steps.\n\n**Step 1**: Calculating the rate at which contaminant enters the tank.\n\nFirst, note that clean water (i.e., water containing $0\\,\\text{kg/L}$ of contaminant) enters the tank at a rate of $9\\,\\text{L/min}.$ So, the rate at which the *contaminant* enters the tank is\n\n$$\n\\begin{aligned}{Q}_{\\text{in}}^{′} & =(0\\,\\frac{\\text{kg}}{\\text{L}})\\cdot (9\\,\\frac{\\text{L}}{\\text{min}}) \\\\  & =0\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 2**: Calculating the rate at which contaminant exits the tank.\n\nTo find the rate at which contaminant leaves the tank, we must first determine the volume of water in the tank at time $t.$\n\nThe tank initially contains $320\\,\\text{L}$ of water; clean water enters at $9\\,\\text{L/min},$ and mixed water leaves at $5\\,\\text{L/min}.$\nAs a result, the amount of water in the tank after $t$ minutes is\n\n$$\nV(t)=320+9t-5t=(320+4t)\\,\\text{L}.\n$$\n\nNote that $V(t)$ is an increasing function, so the tank is filling.\n\nSince $Q$ is the amount of contaminant in the tank, the *concentration* of the water at time $t$ is\n\n$$\n\\frac{Q}{320+4t}\\,\\frac{\\text{kg}}{\\text{L}}.\n$$\n\nTherefore, as the completely mixed water leaves at a rate of $5\\,\\text{L/min},$ *contaminant* leaves at a rate of\n\n$$\n\\begin{aligned}{Q}_{\\text{out}}^{′} & =(5\\,\\frac{\\text{L}}{\\text{min}})\\cdot (\\frac{Q}{320+4t}\\,\\frac{\\text{kg}}{\\text{L}}) \\\\  & =\\frac{5Q}{320+4t}\\,\\frac{\\text{kg}}{\\text{min}} \\\\  & =\\frac{5Q}{4(80+t)}\\,\\frac{\\text{kg}}{\\text{min}}.\\end{aligned}\n$$\n\n**Step 3**: Calculate the overall rate of change.\n\nThe rate of change equals the rate of entry minus the rate of exit. Therefore,\n\n$$\n\\begin{aligned}\\frac{dQ}{dt} & ={Q}_{\\text{in}}^{′}-{Q}_{\\text{out}}^{′} \\\\  & =0-\\frac{5Q}{4(80+t)},\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\frac{dQ}{dt}=-\\frac{5}{4(80+t)}\\,Q.\n$$\n\n**Step 4**: Integrate the equation.\n\nSeparating variables and integrating both sides with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{1}{Q}\\cdot \\frac{dQ}{dt} & =-\\frac{5}{4(80+t)} \\\\ \\int \\frac{1}{Q}\\,dQ & =-\\frac{5}{4}\\int \\frac{1}{80+t}\\,dt \\\\ \\operatorname{ln}⁡|Q| & =-\\frac{5}{4}\\operatorname{ln}⁡|80+t|+C.\\end{aligned}\n$$\n\nThus,\n\n$$\nQ(t)=\\frac{A}{(80+t)^{5/4}}.\n$$\n\nUsing the initial condition $Q(0)=20,$\n\n$$\n\\begin{aligned}\\frac{A}{{80}^{5/4}} & =20 \\\\ A & =20(80)^{5/4}.\\end{aligned}\n$$\n\nSo,\n\n$$\nQ(t)=20{(\\frac{80}{80+t})}^{5/4}.\n$$\n\nNow, let ${t}_{o}$ be the time when the tank begins to overflow. Since the tank has a capacity of $500\\,\\text{L},$\n\n$$\n\\begin{aligned}V({t}_{o}) & =500 \\\\ 320+4{t}_{o} & =500 \\\\ 4{t}_{o} & =180 \\\\ {t}_{o} & =45\\,\\text{min}.\\end{aligned}\n$$\n\nFinally, the amount of contaminant in the tank at the moment it begins to overflow is\n\n$$\n\\begin{aligned}Q(45)7 & =20{(\\frac{80}{80+45})}^{5/4} \\\\  & =20{(\\frac{80}{125})}^{5/4} \\\\  & ≈11.45\\,\\text{kg},\\end{aligned}\n$$\n\nrounded to two decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a2296ad1-b5ad-5318-8ca2-47375c1f24ea"] :db/ensure [:question/validate]} {:db/id "answer-field-a2296ad1-b5ad-5318-8ca2-47375c1f24ea" :answer-field/id #uuid "a2296ad1-b5ad-5318-8ca2-47375c1f24ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3c2f4b0-cd80-5104-a76d-a9103111aecf" :answer-field/choices ["answer-ffb1cc1d-839e-54df-ab22-573f73ec9158" "answer-a664dc99-d82a-50a8-8008-5c999bea8255" "answer-a3c2f4b0-cd80-5104-a76d-a9103111aecf" "answer-05daf3d0-60c8-5258-8b72-1c240c8939ab" "answer-3550769e-3a86-5731-8185-5eb11f50131c"] :db/ensure [:answer-field/validate]} {:db/id "answer-ffb1cc1d-839e-54df-ab22-573f73ec9158" :answer/id #uuid "ffb1cc1d-839e-54df-ab22-573f73ec9158" :answer/type :answer.type/math :answer/value "10.65\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-a664dc99-d82a-50a8-8008-5c999bea8255" :answer/id #uuid "a664dc99-d82a-50a8-8008-5c999bea8255" :answer/type :answer.type/math :answer/value "11.02\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-a3c2f4b0-cd80-5104-a76d-a9103111aecf" :answer/id #uuid "a3c2f4b0-cd80-5104-a76d-a9103111aecf" :answer/type :answer.type/math :answer/value "11.45\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-05daf3d0-60c8-5258-8b72-1c240c8939ab" :answer/id #uuid "05daf3d0-60c8-5258-8b72-1c240c8939ab" :answer/type :answer.type/math :answer/value "12.10\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-3550769e-3a86-5731-8185-5eb11f50131c" :answer/id #uuid "3550769e-3a86-5731-8185-5eb11f50131c" :answer/type :answer.type/math :answer/value "12.85\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "activity-9a2f6d18-d130-5cf4-8e00-d673cc8ce4e6" :activity/id #uuid "9a2f6d18-d130-5cf4-8e00-d673cc8ce4e6" :activity/title "Modeling Mixture Problems With First-Order Separable ODEs" :activity/type :activity.type/review :activity/scope 17592186048608 :activity/course 17592186046660 :activity/steps ["step-b6f00a7c-2a7f-5cd2-8e7e-abe1304677d5" "step-e337b7a5-ecdc-54fc-aa81-83b14318d539" "step-ef5c5245-d0a9-5878-b67d-511982580ee8" "step-e75a037a-1124-59e1-93c8-4111c641fd94" "step-9aa92b3e-4220-5c06-adbf-b59063161b3a"] :activity/first-step "step-b6f00a7c-2a7f-5cd2-8e7e-abe1304677d5" :db/ensure [:activity/validate]} {:db/id "step-b6f00a7c-2a7f-5cd2-8e7e-abe1304677d5" :step/id #uuid "b6f00a7c-2a7f-5cd2-8e7e-abe1304677d5" :step/content 17592186115793 :step/next "step-e337b7a5-ecdc-54fc-aa81-83b14318d539" :db/ensure [:step/validate]} {:db/id "step-e337b7a5-ecdc-54fc-aa81-83b14318d539" :step/id #uuid "e337b7a5-ecdc-54fc-aa81-83b14318d539" :step/content "question-f484bd1c-f53f-587d-99ce-e7d9cbfcb8f5" :step/next "step-ef5c5245-d0a9-5878-b67d-511982580ee8" :db/ensure [:step/validate]} {:db/id "step-ef5c5245-d0a9-5878-b67d-511982580ee8" :step/id #uuid "ef5c5245-d0a9-5878-b67d-511982580ee8" :step/content "question-72675a21-05f8-5d93-afac-bc69655e07ff" :step/next "step-e75a037a-1124-59e1-93c8-4111c641fd94" :db/ensure [:step/validate]} {:db/id "step-e75a037a-1124-59e1-93c8-4111c641fd94" :step/id #uuid "e75a037a-1124-59e1-93c8-4111c641fd94" :step/content 17592186115796 :step/next "step-9aa92b3e-4220-5c06-adbf-b59063161b3a" :db/ensure [:step/validate]} {:db/id "step-9aa92b3e-4220-5c06-adbf-b59063161b3a" :step/id #uuid "9aa92b3e-4220-5c06-adbf-b59063161b3a" :step/content "question-3404cdf4-fad8-57cc-99a9-cffaef1b2f88" :db/ensure [:step/validate]} {:db/id "activity-d6022a2b-4bf1-5e53-8971-24eeeee3f3d3" :activity/id #uuid "d6022a2b-4bf1-5e53-8971-24eeeee3f3d3" :activity/title "Further Modeling With First-Order ODEs" :activity/type :activity.type/review :activity/scope 17592186049739 :activity/course 17592186046645 :activity/steps ["step-2caacd20-fec4-513f-bebd-77f9f2aecd7e" "step-f0052809-97ca-51d0-969f-77faff2a4d64" "step-08819b5d-c31d-5f8f-a25c-647533ce685e" "step-cbacfd83-8629-5916-ac5d-e566d37cbba0" "step-fa547646-60d3-574c-951d-eeb33327ad0d"] :activity/first-step "step-2caacd20-fec4-513f-bebd-77f9f2aecd7e" :db/ensure [:activity/validate]} {:db/id "step-2caacd20-fec4-513f-bebd-77f9f2aecd7e" :step/id #uuid "2caacd20-fec4-513f-bebd-77f9f2aecd7e" :step/content 17592186501187 :step/next "step-f0052809-97ca-51d0-969f-77faff2a4d64" :db/ensure [:step/validate]} {:db/id "step-f0052809-97ca-51d0-969f-77faff2a4d64" :step/id #uuid "f0052809-97ca-51d0-969f-77faff2a4d64" :step/content 17592186373813 :step/next "step-08819b5d-c31d-5f8f-a25c-647533ce685e" :db/ensure [:step/validate]} {:db/id "step-08819b5d-c31d-5f8f-a25c-647533ce685e" :step/id #uuid "08819b5d-c31d-5f8f-a25c-647533ce685e" :step/content 17592186542182 :step/next "step-cbacfd83-8629-5916-ac5d-e566d37cbba0" :db/ensure [:step/validate]} {:db/id "step-cbacfd83-8629-5916-ac5d-e566d37cbba0" :step/id #uuid "cbacfd83-8629-5916-ac5d-e566d37cbba0" :step/content 17592186373827 :step/next "step-fa547646-60d3-574c-951d-eeb33327ad0d" :db/ensure [:step/validate]} {:db/id "step-fa547646-60d3-574c-951d-eeb33327ad0d" :step/id #uuid "fa547646-60d3-574c-951d-eeb33327ad0d" :step/content 17592186373855 :db/ensure [:step/validate]} {:db/id 17592186198248 :knowledge-point/questions ["question-2a9dfae3-b740-55e6-abd9-d9909c3ad491" "question-ceab1153-db5f-5530-aee8-9a4937774de9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186198944 :question/problem "![](images/72/720713e7e1dbfbc9ce3ebb486e8744327c633745d00df7dc862d794eefe57bbc.png)\n\nWhat is the least distance between the curve $y=\\sqrt{x}$ and the point $(4,0)?$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(4,0)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-4)^{2}+(y-0)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-4)^{2}+(y-0)^{2} \\\\  & =(x-4)^{2}+(\\sqrt{x})^{2} \\\\  & ={x}^{2}-8x+16+x \\\\  & ={x}^{2}-7x+16.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-7 & =0 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{7}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{7}{2}$ is given by\n\n$$\nd=\\sqrt{S(\\frac{7}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(\\frac{7}{2})} \\\\  & =\\sqrt{{(\\frac{7}{2})}^{2}-7(\\frac{7}{2})+16} \\\\  & =\\sqrt{\\frac{15}{4}} \\\\  & =\\frac{\\sqrt{15}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186197534 :answer-field/correct 17592186197535 :db/ensure [:answer-field/validate]} {:db/id 17592186198247 :knowledge-point/questions ["question-907519ae-3321-5175-a88f-6dce32f2cb03" "question-5957844f-5ee9-5592-b52f-3fea8df780b1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-907519ae-3321-5175-a88f-6dce32f2cb03" :question/id #uuid "907519ae-3321-5175-a88f-6dce32f2cb03" :question/math-academy-id "q-18500" :question/problem "Find the $y$-coordinate of the point on the curve $y={x}^{2}-2x$ that is closest to the point $(1,4).$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(1,4)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-1)^{2}+(y-4)^{2} \\\\  & ={x}^{2}-2x+1+{y}^{2}-8y+16 \\\\  & ={x}^{2}-2x+{y}^{2}-8y+17\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y={x}^{2}-2x.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(y) & =y+{y}^{2}-8y+17 \\\\  & ={y}^{2}-7y+17.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(y)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(y)=2y-7 & =0 \\\\ 2y & =7 \\\\ y & =\\frac{7}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(y)=2>0.$ Therefore, $y=\\frac{7}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $y=\\frac{7}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e0295622-35a4-5953-aa14-52d047c70fc3"] :db/ensure [:question/validate]} {:db/id "answer-field-e0295622-35a4-5953-aa14-52d047c70fc3" :answer-field/id #uuid "e0295622-35a4-5953-aa14-52d047c70fc3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c96541f4-c7b4-562c-ab5d-50aefc222234" :answer-field/choices ["answer-b641d9de-cddd-5173-aac6-c811671c0ffd" "answer-72775d93-ea9b-54c6-9567-4c8e764952f8" "answer-c96541f4-c7b4-562c-ab5d-50aefc222234" "answer-3a4c3d4e-5b73-5c34-a4c3-53c48c541b63" "answer-bb82afd5-4e30-5905-aad5-28701a369b25"] :db/ensure [:answer-field/validate]} {:db/id "answer-b641d9de-cddd-5173-aac6-c811671c0ffd" :answer/id #uuid "b641d9de-cddd-5173-aac6-c811671c0ffd" :answer/type :answer.type/math :answer/value "y=\\frac{19}{2}" :db/ensure [:answer/validate]} {:db/id "answer-72775d93-ea9b-54c6-9567-4c8e764952f8" :answer/id #uuid "72775d93-ea9b-54c6-9567-4c8e764952f8" :answer/type :answer.type/math :answer/value "y=\\frac{19}{4}" :db/ensure [:answer/validate]} {:db/id "answer-c96541f4-c7b4-562c-ab5d-50aefc222234" :answer/id #uuid "c96541f4-c7b4-562c-ab5d-50aefc222234" :answer/type :answer.type/math :answer/value "y=\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3a4c3d4e-5b73-5c34-a4c3-53c48c541b63" :answer/id #uuid "3a4c3d4e-5b73-5c34-a4c3-53c48c541b63" :answer/type :answer.type/math :answer/value "y=\\frac{\\sqrt{17}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bb82afd5-4e30-5905-aad5-28701a369b25" :answer/id #uuid "bb82afd5-4e30-5905-aad5-28701a369b25" :answer/type :answer.type/math :answer/value "y=\\frac{\\sqrt{7}}{4}" :db/ensure [:answer/validate]} {:db/id "question-5957844f-5ee9-5592-b52f-3fea8df780b1" :question/id #uuid "5957844f-5ee9-5592-b52f-3fea8df780b1" :question/math-academy-id "q-315639" :question/problem "![](images/83/835ffbb783651cfc8f6210fe46f792d7c68f41926a4775e56a570e9bb87b7462.png)\n\nFind the $x$-coordinate of the point on the curve $y=\\sqrt{9x+1}$ that is closest to the point $(8,0).$ Do not round the answer.\n\n$x=$\n{{field-1}}" :question/worked-solution "Let us consider the *squared* distance $S$ between $(8,0)$ and a general point $P(x,y)$:\n\n$$\nS=(x-8)^{2}+{y}^{2}.\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{9x+1}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-8)^{2}+{y}^{2} \\\\  & =(x-8)^{2}+(\\sqrt{9x+1})^{2} \\\\  & =(x-8)^{2}+9x+1 \\\\  & ={x}^{2}-16x+64+9x+1 \\\\  & ={x}^{2}-7x+65.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-7 & =0 \\\\ 2x & =7 \\\\ x & =\\frac{7}{2}.\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{7}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=\\frac{7}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d77e5f19-97fb-5309-b828-6d59517070d0"] :db/ensure [:question/validate]} {:db/id "answer-field-d77e5f19-97fb-5309-b828-6d59517070d0" :answer-field/id #uuid "d77e5f19-97fb-5309-b828-6d59517070d0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-54db5f0b-c4e1-5e3f-bd51-fea3d81ff682" :answer-field/choices ["answer-54db5f0b-c4e1-5e3f-bd51-fea3d81ff682"] :db/ensure [:answer-field/validate]} {:db/id "answer-54db5f0b-c4e1-5e3f-bd51-fea3d81ff682" :answer/id #uuid "54db5f0b-c4e1-5e3f-bd51-fea3d81ff682" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "question-2a9dfae3-b740-55e6-abd9-d9909c3ad491" :question/id #uuid "2a9dfae3-b740-55e6-abd9-d9909c3ad491" :question/math-academy-id "q-344835" :question/problem "![](images/48/48b2ec3916610f624aa308d9c395c43eb7a34418a6457c514dc40ecc82bf2f99.png)\n\nFind the least distance $d$ between the curve $y=\\sqrt{{x}^{2}+1}+1$ and the point $(2,1).$ Do not round the answer.\n\n$d=$\n{{field-1}}" :question/worked-solution "Let us consider the *squared* distance $S$ between $(2,1)$ and a general point $P(x,y)$:\n\n$$\nS=(x-2)^{2}+(y-1)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{{x}^{2}+1}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-2)^{2}+(y-1)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{{x}^{2}+1}+1-1)^{2} \\\\  & =(x-2)^{2}+(\\sqrt{{x}^{2}+1})^{2} \\\\  & =(x-2)^{2}+{x}^{2}+1 \\\\  & ={x}^{2}-4x+4+{x}^{2}+1 \\\\  & =2{x}^{2}-4x+5.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=4x-4 & =0 \\\\ 4x & =4 \\\\ x & =1\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=4>0,$ so $x=1$ gives a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=1$ is given by\n\n$$\nd=\\sqrt{S(1)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(1)} \\\\  & =\\sqrt{2(1)^{2}-4(1)+5} \\\\  & =\\sqrt{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a9413410-1a9d-50b7-9182-e546f0368ec5"] :db/ensure [:question/validate]} {:db/id "answer-field-a9413410-1a9d-50b7-9182-e546f0368ec5" :answer-field/id #uuid "a9413410-1a9d-50b7-9182-e546f0368ec5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d2c19332-1daa-53e4-8c7e-f6edf5736887" :answer-field/choices ["answer-d2c19332-1daa-53e4-8c7e-f6edf5736887"] :db/ensure [:answer-field/validate]} {:db/id "answer-d2c19332-1daa-53e4-8c7e-f6edf5736887" :answer/id #uuid "d2c19332-1daa-53e4-8c7e-f6edf5736887" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "question-ceab1153-db5f-5530-aee8-9a4937774de9" :question/id #uuid "ceab1153-db5f-5530-aee8-9a4937774de9" :question/math-academy-id "q-344849" :question/problem "Find the least distance between the curve $y=\\sqrt{|x-1|}+2$ and the point $P(2,2).$ Do not round the answer.\n\n$d=$ \n{{field-1}}" :question/worked-solution "Let us consider the *squared* distance $S$ between $(2,2)$ and a general point $P(x,y):$\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-2)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{|x-1|}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+(y-2)^{2} \\\\  & =(x-2)^{2}+{(\\sqrt{|x-1|}+2-2)}^{2} \\\\  & =(x-2)^{2}+|x-1|.\\end{aligned}\n$$\n\nFor $x\\ge 1,$ we have $|x-1|=x-1,$ so\n\n$$\n\\begin{aligned}S & =(x-2)^{2}+x-1 \\\\  & ={x}^{2}-4x+4+x-1 \\\\  & ={x}^{2}-3x+3.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-3 & =0 \\\\ 2x & =3 \\\\ x & =\\frac{3}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=\\frac{3}{2}$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=\\frac{3}{2}$ is given by\n\n$$\nd=\\sqrt{S\\,(\\frac{3}{2})}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S\\,(\\frac{3}{2})} \\\\  & =\\sqrt{{(\\frac{3}{2})}^{2}-3(\\frac{3}{2})+3} \\\\  & =\\sqrt{\\frac{9}{4}-\\frac{9}{2}+3} \\\\  & =\\sqrt{\\frac{3}{4}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ae0782a8-a8ce-5695-a710-1fed57c8a4e2"] :db/ensure [:question/validate]} {:db/id "answer-field-ae0782a8-a8ce-5695-a710-1fed57c8a4e2" :answer-field/id #uuid "ae0782a8-a8ce-5695-a710-1fed57c8a4e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-dbfe3030-34aa-5743-844c-793f65847a3e" :answer-field/choices ["answer-dbfe3030-34aa-5743-844c-793f65847a3e"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbfe3030-34aa-5743-844c-793f65847a3e" :answer/id #uuid "dbfe3030-34aa-5743-844c-793f65847a3e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "activity-49557175-272f-5590-8a63-95f82b2b3ff6" :activity/id #uuid "49557175-272f-5590-8a63-95f82b2b3ff6" :activity/title "Optimizing Distances to Curves" :activity/type :activity.type/review :activity/scope 17592186050536 :activity/course 17592186046645 :activity/steps ["step-db305256-c310-5e02-ade5-477388d7db01" "step-2c5a3b83-ee27-5938-906f-66932bc34a39" "step-24b7c382-5fad-5c82-8a7d-642129b1c47a" "step-14d7851b-2592-5b3a-96a9-8d51149c8a93" "step-a088826c-f52e-5e69-8491-0696adb96bbc"] :activity/first-step "step-db305256-c310-5e02-ade5-477388d7db01" :db/ensure [:activity/validate]} {:db/id "step-db305256-c310-5e02-ade5-477388d7db01" :step/id #uuid "db305256-c310-5e02-ade5-477388d7db01" :step/content 17592186198944 :step/next "step-2c5a3b83-ee27-5938-906f-66932bc34a39" :db/ensure [:step/validate]} {:db/id "step-2c5a3b83-ee27-5938-906f-66932bc34a39" :step/id #uuid "2c5a3b83-ee27-5938-906f-66932bc34a39" :step/content "question-907519ae-3321-5175-a88f-6dce32f2cb03" :step/next "step-24b7c382-5fad-5c82-8a7d-642129b1c47a" :db/ensure [:step/validate]} {:db/id "step-24b7c382-5fad-5c82-8a7d-642129b1c47a" :step/id #uuid "24b7c382-5fad-5c82-8a7d-642129b1c47a" :step/content "question-5957844f-5ee9-5592-b52f-3fea8df780b1" :step/next "step-14d7851b-2592-5b3a-96a9-8d51149c8a93" :db/ensure [:step/validate]} {:db/id "step-14d7851b-2592-5b3a-96a9-8d51149c8a93" :step/id #uuid "14d7851b-2592-5b3a-96a9-8d51149c8a93" :step/content "question-2a9dfae3-b740-55e6-abd9-d9909c3ad491" :step/next "step-a088826c-f52e-5e69-8491-0696adb96bbc" :db/ensure [:step/validate]} {:db/id "step-a088826c-f52e-5e69-8491-0696adb96bbc" :step/id #uuid "a088826c-f52e-5e69-8491-0696adb96bbc" :step/content "question-ceab1153-db5f-5530-aee8-9a4937774de9" :db/ensure [:step/validate]} {:db/id 17592186068710 :knowledge-point/questions ["question-5cc362bd-9ac6-5268-99be-c1ee05140ba5"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5cc362bd-9ac6-5268-99be-c1ee05140ba5" :question/id #uuid "5cc362bd-9ac6-5268-99be-c1ee05140ba5" :question/math-academy-id "q-15255" :question/problem "If $|6x+1|=7,$ then $x=$" :question/worked-solution "Either the positive or negative of the expression inside the absolute value must be equal to the right-hand side of the equation.\n\nSo, we set up the two corresponding equations and solve them independently:\n\n- If $|6x+1|=6x+1,$ we obtain:\n\n$$\n\\begin{aligned}|6x+1| & =7 \\\\ 6x+1 & =7 \\\\ 6x & =6 \\\\ \\frac{6x}{6} & =\\frac{6}{6} \\\\ x & =1\\end{aligned}\n$$\n\n- If $|6x+1|=-(6x+1),$ we obtain:\n\n$$\n\\begin{aligned}|6x+1| & =7 \\\\ -(6x+1) & =7 \\\\ -6x-1 & =7 \\\\ -6x & =8 \\\\ \\frac{-6x}{-6} & =\\frac{8}{-6} \\\\ x & =-\\frac{4}{3}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-\\frac{4}{3}$ and $x=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-261897d8-0c26-54e1-abb6-3fd7c538e5ca"] :db/ensure [:question/validate]} {:db/id "answer-field-261897d8-0c26-54e1-abb6-3fd7c538e5ca" :answer-field/id #uuid "261897d8-0c26-54e1-abb6-3fd7c538e5ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-757d810c-9e86-5fbf-8cf5-913d44c8ecd1" :answer-field/choices ["answer-b6328fa1-753b-51ab-91b8-d3ce81c4b837" "answer-456cdfd2-fb44-5da2-8f07-bd5c211a58c5" "answer-9cf9b410-474f-58b7-864c-a13646cfc872" "answer-e08e6d55-7d34-58f1-a2d9-caea99476030" "answer-757d810c-9e86-5fbf-8cf5-913d44c8ecd1"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6328fa1-753b-51ab-91b8-d3ce81c4b837" :answer/id #uuid "b6328fa1-753b-51ab-91b8-d3ce81c4b837" :answer/type :answer.type/text :answer/value "$-1$ or $\\frac{3}{4}$" :db/ensure [:answer/validate]} {:db/id "answer-456cdfd2-fb44-5da2-8f07-bd5c211a58c5" :answer/id #uuid "456cdfd2-fb44-5da2-8f07-bd5c211a58c5" :answer/type :answer.type/text :answer/value "$-1$ or $\\frac{4}{3}$" :db/ensure [:answer/validate]} {:db/id "answer-9cf9b410-474f-58b7-864c-a13646cfc872" :answer/id #uuid "9cf9b410-474f-58b7-864c-a13646cfc872" :answer/type :answer.type/text :answer/value "$-\\frac{3}{4}$ or $1$" :db/ensure [:answer/validate]} {:db/id "answer-e08e6d55-7d34-58f1-a2d9-caea99476030" :answer/id #uuid "e08e6d55-7d34-58f1-a2d9-caea99476030" :answer/type :answer.type/text :answer/value "$-\\frac{4}{3}$ or $-1$" :db/ensure [:answer/validate]} {:db/id "answer-757d810c-9e86-5fbf-8cf5-913d44c8ecd1" :answer/id #uuid "757d810c-9e86-5fbf-8cf5-913d44c8ecd1" :answer/type :answer.type/text :answer/value "$-\\frac{4}{3}$ or $1$" :db/ensure [:answer/validate]} {:db/id 17592186064276 :knowledge-point/questions ["question-a8e3a91e-2825-5391-a044-c55db4444bb3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a8e3a91e-2825-5391-a044-c55db4444bb3" :question/id #uuid "a8e3a91e-2825-5391-a044-c55db4444bb3" :question/math-academy-id "q-78166" :question/problem "Which of the following is equivalent to $(q+1)({q}^{2}+7q+2)?$" :question/worked-solution "We distribute both terms of the binomial in the first set of parentheses to the trinomial in the second set of parentheses. Then, we simplify:\n\n$$\n\\begin{aligned}(q+1)({q}^{2}+7q+2) & = \\\\ q({q}^{2}+7q+2)+1({q}^{2}+7q+2) & = \\\\ {q}^{3}+7{q}^{2}+2q+{q}^{2}+7q+2 & = \\\\ {q}^{3}+8{q}^{2}+9q+2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-762de8d8-0159-59bb-8337-65093404743c"] :db/ensure [:question/validate]} {:db/id "answer-field-762de8d8-0159-59bb-8337-65093404743c" :answer-field/id #uuid "762de8d8-0159-59bb-8337-65093404743c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ec1f128-3776-5271-8e30-9d0869bad2b6" :answer-field/choices ["answer-37dbcef1-e76b-5e55-a4db-d66c6d2410ec" "answer-bfbd346e-3a1c-5efc-8a0e-d27bc886ed8f" "answer-b2ac5fc5-edea-5b7a-b307-204a859e6abe" "answer-0c09a692-6cef-5a2d-8b5b-50519d26eebe" "answer-2ec1f128-3776-5271-8e30-9d0869bad2b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-37dbcef1-e76b-5e55-a4db-d66c6d2410ec" :answer/id #uuid "37dbcef1-e76b-5e55-a4db-d66c6d2410ec" :answer/type :answer.type/math :answer/value "{q}^{3}+10{q}^{2}+12q+2" :db/ensure [:answer/validate]} {:db/id "answer-bfbd346e-3a1c-5efc-8a0e-d27bc886ed8f" :answer/id #uuid "bfbd346e-3a1c-5efc-8a0e-d27bc886ed8f" :answer/type :answer.type/math :answer/value "{q}^{3}+2{q}^{2}+q+2" :db/ensure [:answer/validate]} {:db/id "answer-b2ac5fc5-edea-5b7a-b307-204a859e6abe" :answer/id #uuid "b2ac5fc5-edea-5b7a-b307-204a859e6abe" :answer/type :answer.type/math :answer/value "{q}^{3}+4{q}^{2}+3q+2" :db/ensure [:answer/validate]} {:db/id "answer-0c09a692-6cef-5a2d-8b5b-50519d26eebe" :answer/id #uuid "0c09a692-6cef-5a2d-8b5b-50519d26eebe" :answer/type :answer.type/math :answer/value "{q}^{3}+4{q}^{2}+7q+2" :db/ensure [:answer/validate]} {:db/id "answer-2ec1f128-3776-5271-8e30-9d0869bad2b6" :answer/id #uuid "2ec1f128-3776-5271-8e30-9d0869bad2b6" :answer/type :answer.type/math :answer/value "{q}^{3}+8{q}^{2}+9q+2" :db/ensure [:answer/validate]} {:db/id 17592186068850 :knowledge-point/questions ["question-a6e80d96-0744-50cd-8c8b-fc119a85cde3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a6e80d96-0744-50cd-8c8b-fc119a85cde3" :question/id #uuid "a6e80d96-0744-50cd-8c8b-fc119a85cde3" :question/math-academy-id "q-2968" :question/problem "$\\sqrt[3]{8{x}^{3}{y}^{6}}=$" :question/worked-solution "We write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{8{x}^{3}{y}^{6}} & = \\\\ \\sqrt[3]{2x{y}^{2}\\cdot 2x{y}^{2}\\cdot 2x{y}^{2}} & = \\\\ \\sqrt[3]{{(2x{y}^{2})}^{3}} & = \\\\ 2x{y}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5b8b0c81-e44c-5873-920a-d3c2fc32ba8c"] :db/ensure [:question/validate]} {:db/id "answer-field-5b8b0c81-e44c-5873-920a-d3c2fc32ba8c" :answer-field/id #uuid "5b8b0c81-e44c-5873-920a-d3c2fc32ba8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ffc8fe30-0773-5c9d-a4ea-6cd4800ca4ab" :answer-field/choices ["answer-e0a8bbcc-5f9e-5136-ab98-81d589d1b443" "answer-ffc8fe30-0773-5c9d-a4ea-6cd4800ca4ab" "answer-e4723e12-304f-5208-b860-d84631018ada" "answer-6ed12ee7-f940-52ff-bb7d-8035c6be2d94" "answer-5a6116a1-6852-5a36-a072-1f7cd2571865"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0a8bbcc-5f9e-5136-ab98-81d589d1b443" :answer/id #uuid "e0a8bbcc-5f9e-5136-ab98-81d589d1b443" :answer/type :answer.type/math :answer/value "2xy" :db/ensure [:answer/validate]} {:db/id "answer-ffc8fe30-0773-5c9d-a4ea-6cd4800ca4ab" :answer/id #uuid "ffc8fe30-0773-5c9d-a4ea-6cd4800ca4ab" :answer/type :answer.type/math :answer/value "2x{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e4723e12-304f-5208-b860-d84631018ada" :answer/id #uuid "e4723e12-304f-5208-b860-d84631018ada" :answer/type :answer.type/math :answer/value "2x{y}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-6ed12ee7-f940-52ff-bb7d-8035c6be2d94" :answer/id #uuid "6ed12ee7-f940-52ff-bb7d-8035c6be2d94" :answer/type :answer.type/math :answer/value "2{y}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5a6116a1-6852-5a36-a072-1f7cd2571865" :answer/id #uuid "5a6116a1-6852-5a36-a072-1f7cd2571865" :answer/type :answer.type/math :answer/value "2{y}^{3}" :db/ensure [:answer/validate]} {:db/id 17592186064333 :knowledge-point/questions ["question-0e4d35de-1496-58dd-acc4-9d6da8717950"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0e4d35de-1496-58dd-acc4-9d6da8717950" :question/id #uuid "0e4d35de-1496-58dd-acc4-9d6da8717950" :question/math-academy-id "q-80009" :question/problem "Factor $\\frac{{s}^{2}}{4}-\\frac{1}{36}.$" :question/worked-solution "Before we start our normal process of factoring, notice that all of the terms have a common factor of $\\frac{1}{4}.$ Therefore, we can simplify the expression by factoring out $\\frac{1}{4},$ as follows:\n\n$$\n\\frac{{s}^{2}}{4}-\\frac{1}{36}=\\frac{1}{4}({s}^{2}-\\frac{1}{9})\n$$\n\nNow, let's factor the expression inside parentheses using the difference of squares formula:\n\n$$\n\\begin{aligned}{s}^{2}-\\frac{1}{9} & = \\\\ {s}^{2}-{(\\frac{1}{3})}^{2} & = \\\\ (s-\\frac{1}{3})(s+\\frac{1}{3})\\end{aligned}\n$$\n\nTherefore, our original expression factors as follows:\n\n$$\n\\frac{{s}^{2}}{4}-\\frac{1}{36}=\\frac{1}{4}(s-\\frac{1}{3})(s+\\frac{1}{3})\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0189ffec-539c-5f18-adf5-a8178ffb8b66"] :db/ensure [:question/validate]} {:db/id "answer-field-0189ffec-539c-5f18-adf5-a8178ffb8b66" :answer-field/id #uuid "0189ffec-539c-5f18-adf5-a8178ffb8b66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d12fc8ca-be1b-524b-92aa-34847c9803af" :answer-field/choices ["answer-0d2b8c44-29d4-535a-ac99-52fb8107ea8c" "answer-a5049ad1-06bf-512f-9dc8-6aa664a5b508" "answer-d12fc8ca-be1b-524b-92aa-34847c9803af" "answer-9446f1cc-7e0b-53a2-b234-d433ab653901" "answer-bd1cc090-da2f-589a-a3e1-c6264a798d53"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d2b8c44-29d4-535a-ac99-52fb8107ea8c" :answer/id #uuid "0d2b8c44-29d4-535a-ac99-52fb8107ea8c" :answer/type :answer.type/math :answer/value "(\\frac{s}{4}-\\frac{1}{3})(s+\\frac{1}{3})" :db/ensure [:answer/validate]} {:db/id "answer-a5049ad1-06bf-512f-9dc8-6aa664a5b508" :answer/id #uuid "a5049ad1-06bf-512f-9dc8-6aa664a5b508" :answer/type :answer.type/math :answer/value "(\\frac{s}{4}-\\frac{1}{9})(s+\\frac{1}{9})" :db/ensure [:answer/validate]} {:db/id "answer-d12fc8ca-be1b-524b-92aa-34847c9803af" :answer/id #uuid "d12fc8ca-be1b-524b-92aa-34847c9803af" :answer/type :answer.type/math :answer/value "\\frac{1}{4}(s-\\frac{1}{3})(s+\\frac{1}{3})" :db/ensure [:answer/validate]} {:db/id "answer-9446f1cc-7e0b-53a2-b234-d433ab653901" :answer/id #uuid "9446f1cc-7e0b-53a2-b234-d433ab653901" :answer/type :answer.type/math :answer/value "\\frac{1}{4}(s-\\frac{1}{6})(s+\\frac{1}{6})" :db/ensure [:answer/validate]} {:db/id "answer-bd1cc090-da2f-589a-a3e1-c6264a798d53" :answer/id #uuid "bd1cc090-da2f-589a-a3e1-c6264a798d53" :answer/type :answer.type/math :answer/value "\\frac{1}{4}(s-\\frac{1}{9})(s+\\frac{1}{9})" :db/ensure [:answer/validate]} {:db/id 17592186078578 :knowledge-point/questions ["question-c7c751ec-42d9-5e30-a955-bbbf2b18ef36"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c7c751ec-42d9-5e30-a955-bbbf2b18ef36" :question/id #uuid "c7c751ec-42d9-5e30-a955-bbbf2b18ef36" :question/math-academy-id "q-175691" :question/problem "If $k=\\frac{21-3k}{4},$ then $k=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $4$:\n\n$$\n\\begin{aligned}k & =\\frac{21-3k}{4} \\\\ \\frac{21-3k}{4} & =k \\\\ 4(\\frac{21-3k}{4}) & =4\\cdot k \\\\ \\cancel{4}(\\frac{21-3k}{\\cancel{4}}) & =4k \\\\ 21-3k & =4k\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}21-3k & =4k \\\\ 21-3k+3k & =4k+3k \\\\ 21 & =7k \\\\ \\frac{21}{7} & =\\frac{7k}{7} \\\\ 3 & =\\frac{\\cancel{7}k}{\\cancel{7}} \\\\ 3 & =k\\end{aligned}\n$$\n\nThus, $k=3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-51149079-3dcc-5052-8b68-1b2d681e947d"] :db/ensure [:question/validate]} {:db/id "answer-field-51149079-3dcc-5052-8b68-1b2d681e947d" :answer-field/id #uuid "51149079-3dcc-5052-8b68-1b2d681e947d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ebb827d1-06d8-5d42-8723-79e381e48913" :answer-field/choices ["answer-ebb827d1-06d8-5d42-8723-79e381e48913"] :db/ensure [:answer-field/validate]} {:db/id "answer-ebb827d1-06d8-5d42-8723-79e381e48913" :answer/id #uuid "ebb827d1-06d8-5d42-8723-79e381e48913" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186073788 :knowledge-point/questions ["question-ea5d88b4-44af-57bd-9e77-32e6ed1711e4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ea5d88b4-44af-57bd-9e77-32e6ed1711e4" :question/id #uuid "ea5d88b4-44af-57bd-9e77-32e6ed1711e4" :question/math-academy-id "q-134557" :question/problem "$5\\sqrt[3]{7}+3\\sqrt[3]{7}=$" :question/worked-solution "We can combine the two $\\sqrt[3]{7}$ terms together, as follows:\n\n$$\n\\begin{aligned}5\\sqrt[3]{7}+3\\sqrt[3]{7} & = \\\\ (5+3)\\sqrt[3]{7} & = \\\\ 8\\sqrt[3]{7} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eb3663af-daa1-5e49-a20e-d8dc066d5ffe"] :db/ensure [:question/validate]} {:db/id "answer-field-eb3663af-daa1-5e49-a20e-d8dc066d5ffe" :answer-field/id #uuid "eb3663af-daa1-5e49-a20e-d8dc066d5ffe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bb49b130-736f-5313-b0a7-99e00217b152" :answer-field/choices ["answer-76ee5ca0-7c12-5082-8a34-6cede44eec73" "answer-47eee787-3e3e-501f-9715-79d01e3c299b" "answer-cba321a4-9aa8-5b7d-9849-e923ed678e0f" "answer-906d7098-e8ba-560f-b480-f646bfaa5f9d" "answer-bb49b130-736f-5313-b0a7-99e00217b152"] :db/ensure [:answer-field/validate]} {:db/id "answer-76ee5ca0-7c12-5082-8a34-6cede44eec73" :answer/id #uuid "76ee5ca0-7c12-5082-8a34-6cede44eec73" :answer/type :answer.type/math :answer/value "15\\sqrt[3]{7}" :db/ensure [:answer/validate]} {:db/id "answer-47eee787-3e3e-501f-9715-79d01e3c299b" :answer/id #uuid "47eee787-3e3e-501f-9715-79d01e3c299b" :answer/type :answer.type/math :answer/value "2\\sqrt[3]{7}" :db/ensure [:answer/validate]} {:db/id "answer-cba321a4-9aa8-5b7d-9849-e923ed678e0f" :answer/id #uuid "cba321a4-9aa8-5b7d-9849-e923ed678e0f" :answer/type :answer.type/math :answer/value "3\\sqrt[3]{7}" :db/ensure [:answer/validate]} {:db/id "answer-906d7098-e8ba-560f-b480-f646bfaa5f9d" :answer/id #uuid "906d7098-e8ba-560f-b480-f646bfaa5f9d" :answer/type :answer.type/math :answer/value "5\\sqrt[3]{7}" :db/ensure [:answer/validate]} {:db/id "answer-bb49b130-736f-5313-b0a7-99e00217b152" :answer/id #uuid "bb49b130-736f-5313-b0a7-99e00217b152" :answer/type :answer.type/math :answer/value "8\\sqrt[3]{7}" :db/ensure [:answer/validate]} {:db/id 17592186105850 :knowledge-point/questions ["question-85974f7c-3580-5a6c-8874-1948623d22ef"] :db/ensure [:knowledge-point/validate]} {:db/id "question-85974f7c-3580-5a6c-8874-1948623d22ef" :question/id #uuid "85974f7c-3580-5a6c-8874-1948623d22ef" :question/math-academy-id "q-2683" :question/problem "${(2{x}^{2})}^{4}=$" :question/worked-solution "We apply the power of product rule and then simplify:\n\n$$\n\\begin{aligned}{(2{x}^{2})}^{4} & = \\\\ {2}^{4}{({x}^{2})}^{4} & = \\\\ {2}^{4}{x}^{2\\cdot 4} & = \\\\ 16{x}^{8} & \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1d018f2b-9cf3-598c-a398-3c4cb351b41b"] :db/ensure [:question/validate]} {:db/id "answer-field-1d018f2b-9cf3-598c-a398-3c4cb351b41b" :answer-field/id #uuid "1d018f2b-9cf3-598c-a398-3c4cb351b41b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2564e473-7170-52c5-9ab1-e794dcf3497b" :answer-field/choices ["answer-17de54c2-e2f3-5bc4-aaf4-4390ce60e923" "answer-2564e473-7170-52c5-9ab1-e794dcf3497b" "answer-fd2b7d44-3d0a-5b72-903e-8924ed5d9e02" "answer-1741d705-b726-5f5c-90cb-ea350a8858b9" "answer-a70fb736-9b2d-58e1-941f-63021158e648"] :db/ensure [:answer-field/validate]} {:db/id "answer-17de54c2-e2f3-5bc4-aaf4-4390ce60e923" :answer/id #uuid "17de54c2-e2f3-5bc4-aaf4-4390ce60e923" :answer/type :answer.type/math :answer/value "16{x}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-2564e473-7170-52c5-9ab1-e794dcf3497b" :answer/id #uuid "2564e473-7170-52c5-9ab1-e794dcf3497b" :answer/type :answer.type/math :answer/value "16{x}^{8}" :db/ensure [:answer/validate]} {:db/id "answer-fd2b7d44-3d0a-5b72-903e-8924ed5d9e02" :answer/id #uuid "fd2b7d44-3d0a-5b72-903e-8924ed5d9e02" :answer/type :answer.type/math :answer/value "2{x}^{8}" :db/ensure [:answer/validate]} {:db/id "answer-1741d705-b726-5f5c-90cb-ea350a8858b9" :answer/id #uuid "1741d705-b726-5f5c-90cb-ea350a8858b9" :answer/type :answer.type/math :answer/value "8{x}^{6}" :db/ensure [:answer/validate]} {:db/id "answer-a70fb736-9b2d-58e1-941f-63021158e648" :answer/id #uuid "a70fb736-9b2d-58e1-941f-63021158e648" :answer/type :answer.type/math :answer/value "8{x}^{8}" :db/ensure [:answer/validate]} {:db/id 17592186229195 :knowledge-point/questions ["question-d087556b-949f-5317-94fd-7ed1bb1bb119"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d087556b-949f-5317-94fd-7ed1bb1bb119" :question/id #uuid "d087556b-949f-5317-94fd-7ed1bb1bb119" :question/math-academy-id "q-327578" :question/problem "Museum attendance increased to $120%$ of last year’s total. Of those visitors, $90%$ also attended the art exhibit. What percentage of last year’s total attended the art exhibit?" :question/worked-solution "Let $x$ be the number of visitors last year.\n\nWe're told that attendance increased to $120%$ of last year’s total. Thus, the new number of visitors is $1.2x.$\n\nWe are also told that of those visitors, $90%$ attended the art exhibit. So, the number of visitors who attended the art exhibit is\n\n$$\n0.9(1.2x)=1.08x.\n$$\n\nThe expression $1.08x$ represents $108%$ of $x.$ Therefore, $108%$ of last year’s total attended the art exhibit." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a847d1b0-a797-5a54-9b9a-b76dbf9897f0"] :db/ensure [:question/validate]} {:db/id "answer-field-a847d1b0-a797-5a54-9b9a-b76dbf9897f0" :answer-field/id #uuid "a847d1b0-a797-5a54-9b9a-b76dbf9897f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de9480d8-0c11-519a-b849-0edfe45b1259" :answer-field/choices ["answer-a50805d3-2485-5b8b-9968-ce0b5efb4aca" "answer-de9480d8-0c11-519a-b849-0edfe45b1259" "answer-9a08680b-1b4d-5c5f-9be5-4353c5548985" "answer-dc7e154f-44d3-5452-a2f5-f9e7ea6a2fb9" "answer-72d31ba6-6648-5d65-ad96-c543fe94436d"] :db/ensure [:answer-field/validate]} {:db/id "answer-a50805d3-2485-5b8b-9968-ce0b5efb4aca" :answer/id #uuid "a50805d3-2485-5b8b-9968-ce0b5efb4aca" :answer/type :answer.type/math :answer/value "100%" :db/ensure [:answer/validate]} {:db/id "answer-de9480d8-0c11-519a-b849-0edfe45b1259" :answer/id #uuid "de9480d8-0c11-519a-b849-0edfe45b1259" :answer/type :answer.type/math :answer/value "108%" :db/ensure [:answer/validate]} {:db/id "answer-9a08680b-1b4d-5c5f-9be5-4353c5548985" :answer/id #uuid "9a08680b-1b4d-5c5f-9be5-4353c5548985" :answer/type :answer.type/math :answer/value "110%" :db/ensure [:answer/validate]} {:db/id "answer-dc7e154f-44d3-5452-a2f5-f9e7ea6a2fb9" :answer/id #uuid "dc7e154f-44d3-5452-a2f5-f9e7ea6a2fb9" :answer/type :answer.type/math :answer/value "120%" :db/ensure [:answer/validate]} {:db/id "answer-72d31ba6-6648-5d65-ad96-c543fe94436d" :answer/id #uuid "72d31ba6-6648-5d65-ad96-c543fe94436d" :answer/type :answer.type/math :answer/value "125%" :db/ensure [:answer/validate]} {:db/id 17592186110616 :knowledge-point/questions ["question-7abf9e52-11fe-5f3b-b0b9-36cef1ac7576"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7abf9e52-11fe-5f3b-b0b9-36cef1ac7576" :question/id #uuid "7abf9e52-11fe-5f3b-b0b9-36cef1ac7576" :question/math-academy-id "q-100966" :question/problem "${4}^{8}\\cdot {(4\\cdot 3)}^{7}=$" :question/worked-solution "First, we rewrite the second factor using the power of product rule:\n\n$$\n{4}^{8}\\cdot {(4\\cdot 3)}^{7}={4}^{8}\\cdot {4}^{7}\\cdot {3}^{7}\n$$\n\nFinally, we apply the product rule for exponents, and simplify:\n\n$$\n{4}^{8}\\cdot {4}^{7}\\cdot {3}^{7}={4}^{8+7}\\cdot {3}^{7}={4}^{15}\\cdot {3}^{7}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7de8c48b-a34c-519d-bb8e-f7060eb81878"] :db/ensure [:question/validate]} {:db/id "answer-field-7de8c48b-a34c-519d-bb8e-f7060eb81878" :answer-field/id #uuid "7de8c48b-a34c-519d-bb8e-f7060eb81878" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f40ecd04-70b6-5a81-9df6-cb3a9c87912a" :answer-field/choices ["answer-363c5b82-f408-5bb6-8aec-97014a4cfa20" "answer-9eee6653-8c07-57a0-979e-2d483e2ca9ed" "answer-8e1cc211-24d7-53af-90b0-2c52e75869ba" "answer-f40ecd04-70b6-5a81-9df6-cb3a9c87912a" "answer-e9602b21-d8ad-5b5e-a17e-adee36d38bb1"] :db/ensure [:answer-field/validate]} {:db/id "answer-363c5b82-f408-5bb6-8aec-97014a4cfa20" :answer/id #uuid "363c5b82-f408-5bb6-8aec-97014a4cfa20" :answer/type :answer.type/math :answer/value "4\\cdot {3}^{7}" :db/ensure [:answer/validate]} {:db/id "answer-9eee6653-8c07-57a0-979e-2d483e2ca9ed" :answer/id #uuid "9eee6653-8c07-57a0-979e-2d483e2ca9ed" :answer/type :answer.type/math :answer/value "{4}^{12}\\cdot {3}^{7}" :db/ensure [:answer/validate]} {:db/id "answer-8e1cc211-24d7-53af-90b0-2c52e75869ba" :answer/id #uuid "8e1cc211-24d7-53af-90b0-2c52e75869ba" :answer/type :answer.type/math :answer/value "{4}^{15}\\cdot 3" :db/ensure [:answer/validate]} {:db/id "answer-f40ecd04-70b6-5a81-9df6-cb3a9c87912a" :answer/id #uuid "f40ecd04-70b6-5a81-9df6-cb3a9c87912a" :answer/type :answer.type/math :answer/value "{4}^{15}\\cdot {3}^{7}" :db/ensure [:answer/validate]} {:db/id "answer-e9602b21-d8ad-5b5e-a17e-adee36d38bb1" :answer/id #uuid "e9602b21-d8ad-5b5e-a17e-adee36d38bb1" :answer/type :answer.type/math :answer/value "{4}^{8}\\cdot {7}^{7}" :db/ensure [:answer/validate]} {:db/id 17592186068785 :knowledge-point/questions ["question-895db0ca-e5a4-5d21-a8cf-89c7d272a0e6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-895db0ca-e5a4-5d21-a8cf-89c7d272a0e6" :question/id #uuid "895db0ca-e5a4-5d21-a8cf-89c7d272a0e6" :question/math-academy-id "q-101899" :question/problem "Which of the following values of $x$ satisfy the inequality $\\frac{x}{5}>2\\,?$\n\nI. $x=30$\n\nII. $x=15$\n\nIII. $x=10$" :question/worked-solution "We substitute each value into the given inequality and check to see if the resulting statement is true or false.\n\n- We substitute the value $x=30$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{x}{5} & >2 \\\\ \\frac{30}{5} & >2 \\\\ 6 & >2\\,✓\\end{aligned}\n$$\n\nSo, substituting $x=30$ into the inequality leads to a **true** statement. \n\nTherefore, $x=30$ **satisfies** this inequality.\n\n- We substitute the value $x=15$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{x}{5} & >2 \\\\ \\frac{15}{5} & >2 \\\\ 3 & >2\\,✓\\end{aligned}\n$$\n\nSo, substituting $x=15$ into the inequality leads to a **true** statement. \n\nTherefore, $x=15$ **satisfies** this inequality.\n\n- We substitute the value $x=10$ into the given inequality. We get:\n\n$$\n\\begin{aligned}\\frac{x}{5} & >2 \\\\ \\frac{10}{5} & >2 \\\\ 2 & >2\\,\\times \\end{aligned}\n$$\n\nSo, substituting $x=10$ into the inequality leads to a **false** statement. \n\nTherefore, $x=10$ **does not satisfy** this inequality." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d2cd7973-c8ad-58ba-89e0-21d8e56fd509"] :db/ensure [:question/validate]} {:db/id "answer-field-d2cd7973-c8ad-58ba-89e0-21d8e56fd509" :answer-field/id #uuid "d2cd7973-c8ad-58ba-89e0-21d8e56fd509" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-915831fa-09ee-51d6-9ace-fef8f4f82b86" :answer-field/choices ["answer-915831fa-09ee-51d6-9ace-fef8f4f82b86" "answer-7792606e-6d16-5839-a489-c1736fe5432d" "answer-24e25883-e605-54ce-9779-f65a82700d1e" "answer-82617aa1-ef4b-5420-9570-d95b9a0b9144" "answer-3dbe78df-90e1-5d3d-9a33-ac91b2965582"] :db/ensure [:answer-field/validate]} {:db/id "answer-915831fa-09ee-51d6-9ace-fef8f4f82b86" :answer/id #uuid "915831fa-09ee-51d6-9ace-fef8f4f82b86" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-7792606e-6d16-5839-a489-c1736fe5432d" :answer/id #uuid "7792606e-6d16-5839-a489-c1736fe5432d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-24e25883-e605-54ce-9779-f65a82700d1e" :answer/id #uuid "24e25883-e605-54ce-9779-f65a82700d1e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-82617aa1-ef4b-5420-9570-d95b9a0b9144" :answer/id #uuid "82617aa1-ef4b-5420-9570-d95b9a0b9144" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-3dbe78df-90e1-5d3d-9a33-ac91b2965582" :answer/id #uuid "3dbe78df-90e1-5d3d-9a33-ac91b2965582" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id 17592186068726 :knowledge-point/questions ["question-e7a7bc64-476c-516f-9ef3-e891c084febe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e7a7bc64-476c-516f-9ef3-e891c084febe" :question/id #uuid "e7a7bc64-476c-516f-9ef3-e891c084febe" :question/math-academy-id "q-218571" :question/problem "If $81{a}^{2}=16,$ then $a=${{field-1}}." :question/worked-solution "First, we isolate the ${a}^{2}$ on one side of the equation:\n\n$$\n\\begin{aligned}81{a}^{2} & =16 \\\\ {a}^{2} & =\\frac{16}{81}\\end{aligned}\n$$\n\nThen, we take the square root of both sides of the equation and solve the resulting absolute value equation:\n\n$$\n\\begin{aligned}\\sqrt{{a}^{2}} & =\\sqrt{\\frac{16}{81}} \\\\ |a| & =\\frac{\\sqrt{16}}{\\sqrt{81}} \\\\ |a| & =\\frac{4}{9} \\\\ a & =\\pm \\frac{4}{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ecbd6582-13a5-5dd4-8f0c-314a10cf5dbb"] :db/ensure [:question/validate]} {:db/id "answer-field-ecbd6582-13a5-5dd4-8f0c-314a10cf5dbb" :answer-field/id #uuid "ecbd6582-13a5-5dd4-8f0c-314a10cf5dbb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a779e3c0-db96-5a84-bf30-5894050e9878" :answer-field/choices ["answer-a779e3c0-db96-5a84-bf30-5894050e9878"] :db/ensure [:answer-field/validate]} {:db/id "answer-a779e3c0-db96-5a84-bf30-5894050e9878" :answer/id #uuid "a779e3c0-db96-5a84-bf30-5894050e9878" :answer/type :answer.type/math :answer/value "\\pm\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "activity-540c8787-27dc-5427-9873-8e2c4e1e11ee" :activity/id #uuid "540c8787-27dc-5427-9