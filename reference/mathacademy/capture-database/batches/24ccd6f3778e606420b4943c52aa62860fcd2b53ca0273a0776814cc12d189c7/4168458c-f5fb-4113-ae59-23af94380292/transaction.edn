b1d1-53cf-9319-bc0b880b8a40" :step/id #uuid "e45285b8-b1d1-53cf-9319-bc0b880b8a40" :step/content "question-ea5d88b4-44af-57bd-9e77-32e6ed1711e4" :step/next "step-992e51d2-63c8-5254-b80a-f62e089a6bb3" :db/ensure [:step/validate]} {:db/id "step-992e51d2-63c8-5254-b80a-f62e089a6bb3" :step/id #uuid "992e51d2-63c8-5254-b80a-f62e089a6bb3" :step/content "question-85974f7c-3580-5a6c-8874-1948623d22ef" :step/next "step-4e40c7d9-9377-599c-9025-8f49a608188e" :db/ensure [:step/validate]} {:db/id "step-4e40c7d9-9377-599c-9025-8f49a608188e" :step/id #uuid "4e40c7d9-9377-599c-9025-8f49a608188e" :step/content "question-d087556b-949f-5317-94fd-7ed1bb1bb119" :step/next "step-adc521f0-5c7e-5fc9-be81-2163319851a6" :db/ensure [:step/validate]} {:db/id "step-adc521f0-5c7e-5fc9-be81-2163319851a6" :step/id #uuid "adc521f0-5c7e-5fc9-be81-2163319851a6" :step/content "question-7abf9e52-11fe-5f3b-b0b9-36cef1ac7576" :step/next "step-2162e5b3-3e3d-50a6-a556-bdd42418577f" :db/ensure [:step/validate]} {:db/id "step-2162e5b3-3e3d-50a6-a556-bdd42418577f" :step/id #uuid "2162e5b3-3e3d-50a6-a556-bdd42418577f" :step/content "question-895db0ca-e5a4-5d21-a8cf-89c7d272a0e6" :step/next "step-e172f160-857b-50ac-91c7-c14222212eab" :db/ensure [:step/validate]} {:db/id "step-e172f160-857b-50ac-91c7-c14222212eab" :step/id #uuid "e172f160-857b-50ac-91c7-c14222212eab" :step/content "question-e7a7bc64-476c-516f-9ef3-e891c084febe" :db/ensure [:step/validate]} {:db/id 17592186162140 :knowledge-point/questions ["question-108257b2-5d47-5fa2-8bfe-f9bdb9653702" "question-1a6faf2d-d933-5235-81aa-8381b3e3dfb4" "question-725ce851-768b-5450-a6f8-19b77ae7d6ee" "question-1ca653e0-5f41-50c6-a86a-21726824fff4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161706 :question/problem "The variances of the random variables $X$ and $Y$ are $25$ and $36,$ respectively. Given that $\\textrm{Cov}[X,Y] = 18,$ find the correlation coefficient of $X$ and $Y.$" :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho = \\dfrac{\\textrm{Cov}[X, Y] }{\\textrm {SD}[X] \\cdot \\textrm {SD}[Y]},\n$$\n\nwhere\n\n- $\\textrm{Cov}[X, Y]$ is the covariance, and\n\n- $\\textrm {SD}[X]$ and $\\textrm {SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{\\text{Var}[X]}=\\sqrt{25}=5, \\\\ \\text{SD}[X] & =\\sqrt{\\text{Var}[Y]}=\\sqrt{36}=6.\\end{aligned}\n$$\n\nSubstituting our data in the formula, we obtain\n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[X]} \\\\  & =\\frac{18}{5\\cdot 6} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186162141 :knowledge-point/questions ["question-7da918be-db4c-59cf-8e95-bb2e34ce04e6" "question-77a83823-b66d-5cc9-b223-222b52ef5845"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161707 :question/problem "| $f(x,y)$ | $Y=0$ | $Y=1$ | $f_X$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.5$ | $0.6$ |\n| $X=1$ | $0.3$ | $0.1$ | $0.4$ |\n| $f_Y$ | $0.4$ | $0.6$ | $1$ |\n\nThe joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\textrm {E}[X]=0.4\\qquad\n\\textrm {E}[Y]=0.6, \\qquad\n\\textrm {SD}[X] \\approx 0.4899, \\qquad\n\\textrm {SD}[Y] \\approx 0.4899,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of random variables $X$ and $Y$ is defined as\n\n$$\n\\rho = \\dfrac{\\textrm{Cov}[X, Y] }{\\textrm {SD}[X] \\cdot \\textrm {SD}[Y]},\n$$\n\nwhere\n\n- $\\textrm{Cov}[X, Y]$ is the covariance, and\n\n- $\\textrm {SD}[X]$ and $\\textrm {SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{x\\in {S}_{X}}{\\sum }_{y\\in {S}_{Y}}xy\\,f(x,y) \\\\  & =0\\cdot 0\\cdot 0.1+0\\cdot 1\\cdot 0.5 \\\\  & +1\\cdot 0\\cdot 0.3+1\\cdot 1\\cdot 0.1 \\\\  & =0.1.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =0.1-(0.4)(0.6) \\\\  & =-0.14.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{-0.14}{0.4899\\cdot 0.4899} \\\\  & ≈-0.58,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :db/ensure [:question/validate]} {:db/id 17592186162142 :knowledge-point/questions ["question-db6e411e-8a97-527f-83cb-17311240c8a4" "question-2265fb13-ede5-5876-96c9-a4518515ab31" "question-37a89027-b700-5936-918f-1cda621eae37" "question-6da1a8e2-af30-5f0e-8a87-d537d126dcee" "question-86de9def-10fe-5788-a466-3607900726ce"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161708 :question/problem "![](images/9c/9cf18d64c3f283c730e1d32ee81e3f193e615bb7b0b936dac009c46328826b3d.svg)\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\textrm {E}[X]= \\dfrac{3}{4},\\qquad\n\\textrm {E}[Y]= \\dfrac{5}{12}, \\qquad\n\\textrm {SD}[X]\\approx 0.1936, \\qquad\n\\textrm {SD}[Y]\\approx 0.2444,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho = \\dfrac{\\textrm{Cov}[X, Y] }{\\textrm {SD}[X] \\cdot \\textrm {SD}[Y]},\n$$\n\nwhere\n\n- $\\textrm{Cov}[X, Y]$ is the covariance, and\n\n- $\\textrm {SD}[X]$ and $\\textrm {SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{x}xy\\cdot 2(x+y)\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{x}(2{x}^{2}y+2x{y}^{2})\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{1}{[{x}^{2}{y}^{2}+\\frac{2}{3}x{y}^{3}]}_{y=0}^{y=x}\\text{d}x \\\\  & ={\\int }_{0}^{1}({x}^{4}+\\frac{2}{3}{x}^{4})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{5}{3}{x}^{4}\\,\\text{d}x \\\\  & ={[\\frac{1}{3}{x}^{5}]}_{0}^{1} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{1}{3}-(\\frac{3}{4})(\\frac{5}{12}) \\\\  & =\\frac{1}{48}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(\\frac{1}{48})}{(0.1936)\\cdot (0.2444)} \\\\  & ≈0.44,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :db/ensure [:question/validate]} {:db/id "question-108257b2-5d47-5fa2-8bfe-f9bdb9653702" :question/id #uuid "108257b2-5d47-5fa2-8bfe-f9bdb9653702" :question/math-academy-id "q-148378" :question/problem "Given that $\\text{Cov}[X,Y]=-3,$ $\\text{SD}[X]=3,$ and $\\text{SD}[Y]=2$, find the correlation coefficient of the random variables $X$ and $Y.$" :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nSubstituting our data in the formula, we obtain\n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & =\\frac{-3}{3\\cdot 2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a47ac2fc-ec4f-54bb-92b9-771843969087"] :db/ensure [:question/validate]} {:db/id "answer-field-a47ac2fc-ec4f-54bb-92b9-771843969087" :answer-field/id #uuid "a47ac2fc-ec4f-54bb-92b9-771843969087" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ef55aff8-a3c5-5745-95b9-1636b990fb1c" :answer-field/choices ["answer-ef55aff8-a3c5-5745-95b9-1636b990fb1c" "answer-3f1ab8cb-ee3f-5b2f-b295-5630ccd06a36" "answer-c07daf66-643f-51c9-b5a6-c8358110cee1" "answer-529d96e9-557a-56e5-95ed-388cec93d53d" "answer-07213644-e5d0-599f-bcd5-6d81d5dcab3b"] :db/ensure [:answer-field/validate]} {:db/id "answer-ef55aff8-a3c5-5745-95b9-1636b990fb1c" :answer/id #uuid "ef55aff8-a3c5-5745-95b9-1636b990fb1c" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3f1ab8cb-ee3f-5b2f-b295-5630ccd06a36" :answer/id #uuid "3f1ab8cb-ee3f-5b2f-b295-5630ccd06a36" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c07daf66-643f-51c9-b5a6-c8358110cee1" :answer/id #uuid "c07daf66-643f-51c9-b5a6-c8358110cee1" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-529d96e9-557a-56e5-95ed-388cec93d53d" :answer/id #uuid "529d96e9-557a-56e5-95ed-388cec93d53d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-07213644-e5d0-599f-bcd5-6d81d5dcab3b" :answer/id #uuid "07213644-e5d0-599f-bcd5-6d81d5dcab3b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{6}" :db/ensure [:answer/validate]} {:db/id "question-1a6faf2d-d933-5235-81aa-8381b3e3dfb4" :question/id #uuid "1a6faf2d-d933-5235-81aa-8381b3e3dfb4" :question/math-academy-id "q-148382" :question/problem "Given that $\\text{Cov}[X,Y]=-9,$ $\\text{SD}[X]=2,$ and $\\text{SD}[Y]=5$, find the correlation coefficient of the random variables $X$ and $Y.$" :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nSubstituting our data in the formula, we obtain\n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & =\\frac{-9}{2\\cdot 5} \\\\  & =-\\frac{9}{10}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2212179e-ed1f-5db6-9753-e3dbbfa7a2a4"] :db/ensure [:question/validate]} {:db/id "answer-field-2212179e-ed1f-5db6-9753-e3dbbfa7a2a4" :answer-field/id #uuid "2212179e-ed1f-5db6-9753-e3dbbfa7a2a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd63aed9-5fc4-5aa6-a25f-ac276071a085" :answer-field/choices ["answer-a2de847a-7013-521b-a7f6-357f040b7f13" "answer-493345f6-3f83-55ac-8af5-48356e149a4f" "answer-fd63aed9-5fc4-5aa6-a25f-ac276071a085" "answer-491e9d0b-9b7f-5df2-8441-12f39280dcca" "answer-920b07a2-8356-5fba-b8aa-97c20731338b"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2de847a-7013-521b-a7f6-357f040b7f13" :answer/id #uuid "a2de847a-7013-521b-a7f6-357f040b7f13" :answer/type :answer.type/math :answer/value "-\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-493345f6-3f83-55ac-8af5-48356e149a4f" :answer/id #uuid "493345f6-3f83-55ac-8af5-48356e149a4f" :answer/type :answer.type/math :answer/value "-\\frac{3}{\\sqrt{10}}" :db/ensure [:answer/validate]} {:db/id "answer-fd63aed9-5fc4-5aa6-a25f-ac276071a085" :answer/id #uuid "fd63aed9-5fc4-5aa6-a25f-ac276071a085" :answer/type :answer.type/math :answer/value "-\\frac{9}{10}" :db/ensure [:answer/validate]} {:db/id "answer-491e9d0b-9b7f-5df2-8441-12f39280dcca" :answer/id #uuid "491e9d0b-9b7f-5df2-8441-12f39280dcca" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-920b07a2-8356-5fba-b8aa-97c20731338b" :answer/id #uuid "920b07a2-8356-5fba-b8aa-97c20731338b" :answer/type :answer.type/math :answer/value "\\frac{3}{\\sqrt{10}}" :db/ensure [:answer/validate]} {:db/id 17592186162440 :question/problem "Given that $\\text{Cov}[X,Y]=5,$ $\\text{SD}[X]=2,$ and $\\text{SD}[Y]=4$, find the correlation coefficient of the random variables $X$ and $Y.$" :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nSubstituting our data in the formula, we obtain\n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & =\\frac{5}{2\\cdot 4} \\\\  & =\\frac{5}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186159842 :answer-field/correct 17592186159847 :db/ensure [:answer-field/validate]} {:db/id "question-725ce851-768b-5450-a6f8-19b77ae7d6ee" :question/id #uuid "725ce851-768b-5450-a6f8-19b77ae7d6ee" :question/math-academy-id "q-148383" :question/problem "The variances of the random variables $X$ and $Y$ are $0.09$ and $0.16$, respectively. Given that $\\text{Cov}(X,Y)=-0.03,$ find the correlation coefficient of $X$ and $Y.$" :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nIn our case, we have\n\n$$\n\\begin{aligned}\\text{SD}[X] & =\\sqrt{\\text{Var}[X]}=\\sqrt{0.09}=0.3, \\\\ \\text{SD}[X] & =\\sqrt{\\text{Var}[Y]}=\\sqrt{0.16}=0.4.\\end{aligned}\n$$\n\nSubstituting our data in the formula, we obtain\n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[X]} \\\\  & =\\frac{-0.03}{0.3\\cdot 0.4} \\\\  & =-0.25.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-02c6ffe8-da28-5f04-9f10-7f5fb39f6c51"] :db/ensure [:question/validate]} {:db/id "answer-field-02c6ffe8-da28-5f04-9f10-7f5fb39f6c51" :answer-field/id #uuid "02c6ffe8-da28-5f04-9f10-7f5fb39f6c51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-afca3ed1-0cc7-5272-8c37-2c485a548b58" :answer-field/choices ["answer-f1b60ac1-9510-5724-96d4-4f6222565e6b" "answer-afca3ed1-0cc7-5272-8c37-2c485a548b58" "answer-3b160291-9a4a-556f-855b-a1bdecb15fa4" "answer-7263a393-17bc-5b22-a37e-7d6c9f7fc792" "answer-435e667b-b76a-52f3-8eb3-88f6a0476ab2"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1b60ac1-9510-5724-96d4-4f6222565e6b" :answer/id #uuid "f1b60ac1-9510-5724-96d4-4f6222565e6b" :answer/type :answer.type/math :answer/value "-0.04" :db/ensure [:answer/validate]} {:db/id "answer-afca3ed1-0cc7-5272-8c37-2c485a548b58" :answer/id #uuid "afca3ed1-0cc7-5272-8c37-2c485a548b58" :answer/type :answer.type/math :answer/value "-0.25" :db/ensure [:answer/validate]} {:db/id "answer-3b160291-9a4a-556f-855b-a1bdecb15fa4" :answer/id #uuid "3b160291-9a4a-556f-855b-a1bdecb15fa4" :answer/type :answer.type/math :answer/value "-0.5" :db/ensure [:answer/validate]} {:db/id "answer-7263a393-17bc-5b22-a37e-7d6c9f7fc792" :answer/id #uuid "7263a393-17bc-5b22-a37e-7d6c9f7fc792" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "answer-435e667b-b76a-52f3-8eb3-88f6a0476ab2" :answer/id #uuid "435e667b-b76a-52f3-8eb3-88f6a0476ab2" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "question-1ca653e0-5f41-50c6-a86a-21726824fff4" :question/id #uuid "1ca653e0-5f41-50c6-a86a-21726824fff4" :question/math-academy-id "q-148379" :question/problem "Given that $\\text{Cov}[X,Y]=15,$ $\\text{SD}[X]=10,$ and $\\text{SD}[Y]=5$, find the correlation coefficient of the random variables $X$ and $Y.$" :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nSubstituting our data in the formula, we obtain\n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & =\\frac{15}{10\\cdot 5} \\\\  & =\\frac{3}{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a17f6816-6b84-5155-8989-9c88ab516dc9"] :db/ensure [:question/validate]} {:db/id "answer-field-a17f6816-6b84-5155-8989-9c88ab516dc9" :answer-field/id #uuid "a17f6816-6b84-5155-8989-9c88ab516dc9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-105b4854-df99-5057-8819-5e92ecbdc276" :answer-field/choices ["answer-7105ce47-e65e-58e7-8416-42579ae9d983" "answer-105b4854-df99-5057-8819-5e92ecbdc276" "answer-f23b09ee-e89e-507b-97b3-9134a247f261" "answer-cdb1dff9-6371-5445-8912-de016b27357a" "answer-7f722018-a718-55b8-9443-c65ca8642453"] :db/ensure [:answer-field/validate]} {:db/id "answer-7105ce47-e65e-58e7-8416-42579ae9d983" :answer/id #uuid "7105ce47-e65e-58e7-8416-42579ae9d983" :answer/type :answer.type/math :answer/value "\\frac{3}{100}" :db/ensure [:answer/validate]} {:db/id "answer-105b4854-df99-5057-8819-5e92ecbdc276" :answer/id #uuid "105b4854-df99-5057-8819-5e92ecbdc276" :answer/type :answer.type/math :answer/value "\\frac{3}{10}" :db/ensure [:answer/validate]} {:db/id "answer-f23b09ee-e89e-507b-97b3-9134a247f261" :answer/id #uuid "f23b09ee-e89e-507b-97b3-9134a247f261" :answer/type :answer.type/math :answer/value "\\frac{3}{\\sqrt{10}}" :db/ensure [:answer/validate]} {:db/id "answer-cdb1dff9-6371-5445-8912-de016b27357a" :answer/id #uuid "cdb1dff9-6371-5445-8912-de016b27357a" :answer/type :answer.type/math :answer/value "\\frac{6}{1\\,000}" :db/ensure [:answer/validate]} {:db/id "answer-7f722018-a718-55b8-9443-c65ca8642453" :answer/id #uuid "7f722018-a718-55b8-9443-c65ca8642453" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{\\sqrt{10}}" :db/ensure [:answer/validate]} {:db/id "question-7da918be-db4c-59cf-8e95-bb2e34ce04e6" :question/id #uuid "7da918be-db4c-59cf-8e95-bb2e34ce04e6" :question/math-academy-id "q-148366" :question/problem "| $f(x,y)$ | $Y=0$ | $Y=1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.1$ | $0.2$ |\n| $X=1$ | $0.2$ | $0.6$ | $0.8$ |\n| ${f}_{Y}$ | $0.3$ | $0.7$ | $1$ |\n\nThe joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=0.8\\,\\text{E}[Y]=0.7,\\,\\text{SD}[X]=0.4,\\,\\text{SD}[Y]≈0.4583,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{x\\in {S}_{X}}{\\sum }_{y\\in {S}_{Y}}xy\\,f(x,y) \\\\  & =0\\cdot 0\\cdot 0.1+0\\cdot 1\\cdot 0.1 \\\\  & +1\\cdot 0\\cdot 0.2+1\\cdot 1\\cdot 0.6 \\\\  & =0.6.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =0.6-(0.8)(0.7) \\\\  & =0.04.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{0.04}{0.4\\cdot 0.4583} \\\\  & ≈0.22,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-10a7f369-0b11-52c5-910c-d3314793473c"] :db/ensure [:question/validate]} {:db/id "answer-field-10a7f369-0b11-52c5-910c-d3314793473c" :answer-field/id #uuid "10a7f369-0b11-52c5-910c-d3314793473c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-523e5d29-ef3d-533d-b3d9-6739242fa7ee" :answer-field/choices ["answer-e23b0d2d-cf61-5bf1-a063-a5a75eae372a" "answer-4ae7ef88-80ec-52bf-b1c6-f25e85e1da32" "answer-ff0bb3cc-ac0e-56cc-9257-49e5bfd7e4d9" "answer-523e5d29-ef3d-533d-b3d9-6739242fa7ee" "answer-35a338c4-3e34-50f6-a27f-c7bd6f9c731a"] :db/ensure [:answer-field/validate]} {:db/id "answer-e23b0d2d-cf61-5bf1-a063-a5a75eae372a" :answer/id #uuid "e23b0d2d-cf61-5bf1-a063-a5a75eae372a" :answer/type :answer.type/math :answer/value "-0.32" :db/ensure [:answer/validate]} {:db/id "answer-4ae7ef88-80ec-52bf-b1c6-f25e85e1da32" :answer/id #uuid "4ae7ef88-80ec-52bf-b1c6-f25e85e1da32" :answer/type :answer.type/math :answer/value "-0.35" :db/ensure [:answer/validate]} {:db/id "answer-ff0bb3cc-ac0e-56cc-9257-49e5bfd7e4d9" :answer/id #uuid "ff0bb3cc-ac0e-56cc-9257-49e5bfd7e4d9" :answer/type :answer.type/math :answer/value "0.16" :db/ensure [:answer/validate]} {:db/id "answer-523e5d29-ef3d-533d-b3d9-6739242fa7ee" :answer/id #uuid "523e5d29-ef3d-533d-b3d9-6739242fa7ee" :answer/type :answer.type/math :answer/value "0.22" :db/ensure [:answer/validate]} {:db/id "answer-35a338c4-3e34-50f6-a27f-c7bd6f9c731a" :answer/id #uuid "35a338c4-3e34-50f6-a27f-c7bd6f9c731a" :answer/type :answer.type/math :answer/value "0.56" :db/ensure [:answer/validate]} {:db/id "question-77a83823-b66d-5cc9-b223-222b52ef5845" :question/id #uuid "77a83823-b66d-5cc9-b223-222b52ef5845" :question/math-academy-id "q-148375" :question/problem "| $f(x,y)$ | $Y=-10$ | $Y=0$ | $Y=10$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.4$ | $0.05$ | $0.05$ | $0.5$ |\n| $X=4$ | $0.05$ | $0.05$ | $0.4$ | $0.5$ |\n| ${f}_{Y}$ | $0.45$ | $0.1$ | $0.45$ | $1$ |\n\nThe joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=2,\\,\\text{E}[Y]=0,\\,\\text{SD}[X]=2,\\,\\text{SD}[Y]≈9.4868,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={\\sum }_{x\\in {S}_{X}}{\\sum }_{y\\in {S}_{Y}}xy\\,f(x,y) \\\\  & =0\\cdot (-10)\\cdot 0.4+0\\cdot 0\\cdot 0.05+0\\cdot 10\\cdot 0.05 \\\\  & +4\\cdot (-10)\\cdot 0.05+4\\cdot 0\\cdot 0.05+4\\cdot 10\\cdot 0.4 \\\\  & =14.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =14-(2)(0) \\\\  & =14.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{14}{2\\cdot 9.4868} \\\\  & ≈0.74,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7773313f-b6ec-5d71-babd-97a645cc46df"] :db/ensure [:question/validate]} {:db/id "answer-field-7773313f-b6ec-5d71-babd-97a645cc46df" :answer-field/id #uuid "7773313f-b6ec-5d71-babd-97a645cc46df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8d9818d8-a03f-553d-80d1-8feae43d018e" :answer-field/choices ["answer-dc66e48f-2f69-59da-9829-5e8865ac0ab3" "answer-8cf2dbe1-47bd-52c4-9356-3277c6c0a4b7" "answer-e9323ec5-3d84-5f68-a0df-0a2650658c86" "answer-8cc16f2e-0ce4-50e3-9ce6-2fcd93fe8745" "answer-8d9818d8-a03f-553d-80d1-8feae43d018e"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc66e48f-2f69-59da-9829-5e8865ac0ab3" :answer/id #uuid "dc66e48f-2f69-59da-9829-5e8865ac0ab3" :answer/type :answer.type/math :answer/value "-0.35" :db/ensure [:answer/validate]} {:db/id "answer-8cf2dbe1-47bd-52c4-9356-3277c6c0a4b7" :answer/id #uuid "8cf2dbe1-47bd-52c4-9356-3277c6c0a4b7" :answer/type :answer.type/math :answer/value "-0.84" :db/ensure [:answer/validate]} {:db/id "answer-e9323ec5-3d84-5f68-a0df-0a2650658c86" :answer/id #uuid "e9323ec5-3d84-5f68-a0df-0a2650658c86" :answer/type :answer.type/math :answer/value "0.56" :db/ensure [:answer/validate]} {:db/id "answer-8cc16f2e-0ce4-50e3-9ce6-2fcd93fe8745" :answer/id #uuid "8cc16f2e-0ce4-50e3-9ce6-2fcd93fe8745" :answer/type :answer.type/math :answer/value "0.63" :db/ensure [:answer/validate]} {:db/id "answer-8d9818d8-a03f-553d-80d1-8feae43d018e" :answer/id #uuid "8d9818d8-a03f-553d-80d1-8feae43d018e" :answer/type :answer.type/math :answer/value "0.74" :db/ensure [:answer/validate]} {:db/id "question-db6e411e-8a97-527f-83cb-17311240c8a4" :question/id #uuid "db6e411e-8a97-527f-83cb-17311240c8a4" :question/math-academy-id "q-148422" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{8({x}^{2}+{y}^{2})}{\\pi }, & \\,x\\ge 0,\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{8}{5\\pi },\\,\\text{E}[Y]=\\frac{8}{5\\pi },\\,\\text{SD}[X]≈0.2719,\\,\\text{SD}[Y]≈0.2719,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt{1-{y}^{2}}}xy\\cdot \\frac{8({x}^{2}+{y}^{2})}{\\pi }\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{8}{\\pi }\\text{ }{\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt{1-{y}^{2}}}({x}^{3}y+x{y}^{3})\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{8}{\\pi }{\\int }_{0}^{1}{[\\frac{1}{4}{x}^{4}y+\\frac{1}{2}{x}^{2}{y}^{3}]}_{x=0}^{x=\\sqrt{1-{y}^{2}}}\\text{d}y \\\\  & =\\frac{8}{\\pi }{\\int }_{0}^{1}[\\frac{1}{4}{(1-{y}^{2})}^{2}y+\\frac{1}{2}(1-{y}^{2}){y}^{3}]\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{1}[(1-2{y}^{2}+{y}^{4})y+2(1-{y}^{2}){y}^{3}]\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{\\int }_{0}^{1}(y-{y}^{5})\\,\\text{d}y \\\\  & =\\frac{2}{\\pi }{[\\frac{1}{2}{y}^{2}-\\frac{1}{6}{y}^{6}]}_{0}^{1} \\\\  & =\\frac{2}{3\\pi }\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{2}{3\\pi }-(\\frac{8}{5\\pi })(\\frac{8}{5\\pi }) \\\\  & =\\frac{50\\pi -192}{75{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(\\frac{50\\pi -192}{75{\\pi }^{2}})}{(0.2719)\\cdot (0.2719)} \\\\  & ≈-0.64,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c9e55990-2ad1-513e-bcc2-f70980e885ad"] :db/ensure [:question/validate]} {:db/id "answer-field-c9e55990-2ad1-513e-bcc2-f70980e885ad" :answer-field/id #uuid "c9e55990-2ad1-513e-bcc2-f70980e885ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-116e1223-c9c0-50e1-9796-7612d14b69d2" :answer-field/choices ["answer-e3bf9b68-0dfc-54cc-a6bb-ef6cd1976695" "answer-116e1223-c9c0-50e1-9796-7612d14b69d2" "answer-cee2766c-0382-569e-bb67-a703ad240c37" "answer-fc396241-6675-55dc-9a31-e2e02c8f817b" "answer-3af52246-e75a-5df3-a2e8-127297df4308"] :db/ensure [:answer-field/validate]} {:db/id "answer-e3bf9b68-0dfc-54cc-a6bb-ef6cd1976695" :answer/id #uuid "e3bf9b68-0dfc-54cc-a6bb-ef6cd1976695" :answer/type :answer.type/math :answer/value "-0.47" :db/ensure [:answer/validate]} {:db/id "answer-116e1223-c9c0-50e1-9796-7612d14b69d2" :answer/id #uuid "116e1223-c9c0-50e1-9796-7612d14b69d2" :answer/type :answer.type/math :answer/value "-0.64" :db/ensure [:answer/validate]} {:db/id "answer-cee2766c-0382-569e-bb67-a703ad240c37" :answer/id #uuid "cee2766c-0382-569e-bb67-a703ad240c37" :answer/type :answer.type/math :answer/value "-0.75" :db/ensure [:answer/validate]} {:db/id "answer-fc396241-6675-55dc-9a31-e2e02c8f817b" :answer/id #uuid "fc396241-6675-55dc-9a31-e2e02c8f817b" :answer/type :answer.type/math :answer/value "0.27" :db/ensure [:answer/validate]} {:db/id "answer-3af52246-e75a-5df3-a2e8-127297df4308" :answer/id #uuid "3af52246-e75a-5df3-a2e8-127297df4308" :answer/type :answer.type/math :answer/value "0.35" :db/ensure [:answer/validate]} {:db/id "question-2265fb13-ede5-5876-96c9-a4518515ab31" :question/id #uuid "2265fb13-ede5-5876-96c9-a4518515ab31" :question/math-academy-id "q-148337" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{x+y}{3}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{11}{9},\\,\\text{E}[Y]=\\frac{5}{9},\\,\\text{SD}[X]≈0.5329,\\,\\text{SD}[Y]≈0.2833,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{2}[{\\int }_{0}^{1}xy\\cdot \\frac{x+y}{3}\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{0}^{2}[{\\int }_{0}^{1}({x}^{2}y+x{y}^{2})\\,\\text{d}y]\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{0}^{2}{[\\frac{{x}^{2}{y}^{2}}{2}+\\frac{x{y}^{3}}{3}]}_{y=0}^{y=1}\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{0}^{2}(\\frac{{x}^{2}}{2}+\\frac{x}{3})\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{{x}^{3}}{6}+\\frac{{x}^{2}}{6}]}_{0}^{2} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{2}{3}-(\\frac{11}{9})(\\frac{5}{9}) \\\\  & =-\\frac{1}{81}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(-\\frac{1}{81})}{(0.5329)\\cdot (0.2833)} \\\\  & ≈-0.08,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-abcaf86c-3cea-5f12-a174-9ce2866296f7"] :db/ensure [:question/validate]} {:db/id "answer-field-abcaf86c-3cea-5f12-a174-9ce2866296f7" :answer-field/id #uuid "abcaf86c-3cea-5f12-a174-9ce2866296f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b56517bb-ec5e-584d-9307-e3e474bb3360" :answer-field/choices ["answer-64e5f106-8480-5a83-97f5-e5174d418982" "answer-b56517bb-ec5e-584d-9307-e3e474bb3360" "answer-304f73f4-0397-5854-960b-762988f4153d" "answer-62ec7766-2c11-5907-b71d-e497ceab6d8f" "answer-dcb85af9-dc03-5f44-8022-ff6dccdd0429"] :db/ensure [:answer-field/validate]} {:db/id "answer-64e5f106-8480-5a83-97f5-e5174d418982" :answer/id #uuid "64e5f106-8480-5a83-97f5-e5174d418982" :answer/type :answer.type/math :answer/value "-0.04" :db/ensure [:answer/validate]} {:db/id "answer-b56517bb-ec5e-584d-9307-e3e474bb3360" :answer/id #uuid "b56517bb-ec5e-584d-9307-e3e474bb3360" :answer/type :answer.type/math :answer/value "-0.08" :db/ensure [:answer/validate]} {:db/id "answer-304f73f4-0397-5854-960b-762988f4153d" :answer/id #uuid "304f73f4-0397-5854-960b-762988f4153d" :answer/type :answer.type/math :answer/value "-0.12" :db/ensure [:answer/validate]} {:db/id "answer-62ec7766-2c11-5907-b71d-e497ceab6d8f" :answer/id #uuid "62ec7766-2c11-5907-b71d-e497ceab6d8f" :answer/type :answer.type/math :answer/value "0.06" :db/ensure [:answer/validate]} {:db/id "answer-dcb85af9-dc03-5f44-8022-ff6dccdd0429" :answer/id #uuid "dcb85af9-dc03-5f44-8022-ff6dccdd0429" :answer/type :answer.type/math :answer/value "0.15" :db/ensure [:answer/validate]} {:db/id "question-37a89027-b700-5936-918f-1cda621eae37" :question/id #uuid "37a89027-b700-5936-918f-1cda621eae37" :question/math-academy-id "q-148419" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{2y}{{x}^{2}}+\\frac{1}{2}, & \\,1\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{3}{4}+\\operatorname{ln}⁡2,\\,\\text{E}[Y]=\\frac{7}{12},\\,\\text{SD}[X]≈0.2898,\\,\\text{SD}[Y]≈0.2764,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{1}^{2}[{\\int }_{0}^{1}xy\\cdot (\\frac{2y}{{x}^{2}}+\\frac{1}{2})\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{2}[{\\int }_{0}^{1}(\\frac{2{y}^{2}}{x}+\\frac{1}{2}xy)\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{2}{[\\frac{2}{3x}{y}^{3}+\\frac{1}{4}x{y}^{2}]}_{y=0}^{y=1}\\text{d}x \\\\  & ={\\int }_{1}^{2}(\\frac{2}{3x}+\\frac{1}{4}x)\\,\\text{d}x \\\\  & ={[\\frac{2}{3}\\operatorname{ln}⁡x+\\frac{1}{8}{x}^{2}]}_{1}^{2} \\\\  & =(\\frac{2}{3}\\operatorname{ln}⁡2+\\frac{1}{2}-\\frac{1}{8}) \\\\  & =\\frac{2\\operatorname{ln}⁡2}{3}+\\frac{3}{8}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =(\\frac{2\\operatorname{ln}⁡2}{3}+\\frac{3}{8})-(\\frac{3}{4}+\\operatorname{ln}⁡2)(\\frac{7}{12}) \\\\  & =(\\frac{2\\operatorname{ln}⁡2}{3}-\\frac{7\\operatorname{ln}⁡2}{12})+(\\frac{3}{8}-\\frac{7}{16}) \\\\  & =\\frac{\\operatorname{ln}⁡2}{12}-\\frac{1}{16}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(\\frac{\\operatorname{ln}⁡2}{12}-\\frac{1}{16})}{(0.2898)\\cdot (0.2764)} \\\\  & ≈-0.06,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f36d3cec-3da7-547e-beb8-441c3e66c73b"] :db/ensure [:question/validate]} {:db/id "answer-field-f36d3cec-3da7-547e-beb8-441c3e66c73b" :answer-field/id #uuid "f36d3cec-3da7-547e-beb8-441c3e66c73b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-318edee1-713f-5f01-ae45-ef3fc7f1957c" :answer-field/choices ["answer-318edee1-713f-5f01-ae45-ef3fc7f1957c" "answer-1bc96e3f-b048-53f6-bbac-fc83895ed411" "answer-05ecfb71-5181-5349-90d0-aa801ee90c67" "answer-75eeae67-abff-51e8-b38b-9678a6cab699" "answer-15d9b08c-5b84-5d59-a03e-eb48b8bdcf05"] :db/ensure [:answer-field/validate]} {:db/id "answer-318edee1-713f-5f01-ae45-ef3fc7f1957c" :answer/id #uuid "318edee1-713f-5f01-ae45-ef3fc7f1957c" :answer/type :answer.type/math :answer/value "-0.06" :db/ensure [:answer/validate]} {:db/id "answer-1bc96e3f-b048-53f6-bbac-fc83895ed411" :answer/id #uuid "1bc96e3f-b048-53f6-bbac-fc83895ed411" :answer/type :answer.type/math :answer/value "-0.14" :db/ensure [:answer/validate]} {:db/id "answer-05ecfb71-5181-5349-90d0-aa801ee90c67" :answer/id #uuid "05ecfb71-5181-5349-90d0-aa801ee90c67" :answer/type :answer.type/math :answer/value "-0.18" :db/ensure [:answer/validate]} {:db/id "answer-75eeae67-abff-51e8-b38b-9678a6cab699" :answer/id #uuid "75eeae67-abff-51e8-b38b-9678a6cab699" :answer/type :answer.type/math :answer/value "0.04" :db/ensure [:answer/validate]} {:db/id "answer-15d9b08c-5b84-5d59-a03e-eb48b8bdcf05" :answer/id #uuid "15d9b08c-5b84-5d59-a03e-eb48b8bdcf05" :answer/type :answer.type/math :answer/value "0.23" :db/ensure [:answer/validate]} {:db/id "question-6da1a8e2-af30-5f0e-8a87-d537d126dcee" :question/id #uuid "6da1a8e2-af30-5f0e-8a87-d537d126dcee" :question/math-academy-id "q-148358" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{\\operatorname{cos}⁡(x-y)}{2}, & \\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2} \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{\\pi }{4},\\,\\text{E}[Y]=\\frac{\\pi }{4},\\,\\text{SD}[X]≈0.4332,\\,\\text{SD}[Y]≈0.4332,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician and integration by parts, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /2}[{\\int }_{0}^{\\pi /2}xy\\cdot \\frac{\\operatorname{cos}⁡(x-y)}{2}\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}[{\\int }_{0}^{\\pi /2}xy\\operatorname{cos}⁡(x-y)\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}[xy\\operatorname{sin}⁡(x-y)+y\\operatorname{cos}⁡(x-y)]_{x=0}^{x=\\pi /2}\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}[\\frac{\\pi }{2}y\\operatorname{sin}⁡(\\frac{\\pi }{2}-y)+y\\operatorname{cos}⁡(\\frac{\\pi }{2}-y)-y\\operatorname{cos}⁡(-y)]\\,\\text{d}y \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /2}(\\frac{\\pi }{2}y\\operatorname{cos}⁡y+y\\operatorname{sin}⁡y-y\\operatorname{cos}⁡y)\\,\\text{d}y \\\\  & =\\frac{1}{2}{[(\\frac{\\pi }{2}-1)(y\\operatorname{sin}⁡y+\\operatorname{cos}⁡y)+\\operatorname{sin}⁡y-y\\operatorname{cos}⁡y]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}[(\\frac{\\pi }{2}-1)\\frac{\\pi }{2}+1-(\\frac{\\pi }{2}-1)] \\\\  & =\\frac{{\\pi }^{2}-4\\pi +8}{8}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{{\\pi }^{2}-4\\pi +8}{8}-(\\frac{\\pi }{4})(\\frac{\\pi }{4}) \\\\  & =\\frac{{\\pi }^{2}-8\\pi +16}{16} \\\\  & ={(\\frac{\\pi }{4}-1)}^{2}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{{(\\frac{\\pi }{4}-1)}^{2}}{(0.4332)\\cdot (0.4332)} \\\\  & ≈0.25,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a2b36089-1198-54b4-93f5-8abdffa58d09"] :db/ensure [:question/validate]} {:db/id "answer-field-a2b36089-1198-54b4-93f5-8abdffa58d09" :answer-field/id #uuid "a2b36089-1198-54b4-93f5-8abdffa58d09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8f73334-b1a2-55a1-9029-06b428581140" :answer-field/choices ["answer-0dbf269c-de52-5987-8c5f-a5ab6a428860" "answer-3e34aae8-23b2-5c5e-b6cd-0140500f4a0e" "answer-c0c8562d-d0e1-528d-b700-ac3e947458d5" "answer-548fd2f9-0377-54ba-80cc-2c84f01bfa2b" "answer-f8f73334-b1a2-55a1-9029-06b428581140"] :db/ensure [:answer-field/validate]} {:db/id "answer-0dbf269c-de52-5987-8c5f-a5ab6a428860" :answer/id #uuid "0dbf269c-de52-5987-8c5f-a5ab6a428860" :answer/type :answer.type/math :answer/value "-0.05" :db/ensure [:answer/validate]} {:db/id "answer-3e34aae8-23b2-5c5e-b6cd-0140500f4a0e" :answer/id #uuid "3e34aae8-23b2-5c5e-b6cd-0140500f4a0e" :answer/type :answer.type/math :answer/value "-0.11" :db/ensure [:answer/validate]} {:db/id "answer-c0c8562d-d0e1-528d-b700-ac3e947458d5" :answer/id #uuid "c0c8562d-d0e1-528d-b700-ac3e947458d5" :answer/type :answer.type/math :answer/value "0.09" :db/ensure [:answer/validate]} {:db/id "answer-548fd2f9-0377-54ba-80cc-2c84f01bfa2b" :answer/id #uuid "548fd2f9-0377-54ba-80cc-2c84f01bfa2b" :answer/type :answer.type/math :answer/value "0.17" :db/ensure [:answer/validate]} {:db/id "answer-f8f73334-b1a2-55a1-9029-06b428581140" :answer/id #uuid "f8f73334-b1a2-55a1-9029-06b428581140" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "question-86de9def-10fe-5788-a466-3607900726ce" :question/id #uuid "86de9def-10fe-5788-a466-3607900726ce" :question/math-academy-id "q-148421" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{9}{12}(xy+1), & \\,{y}^{2}\\le x\\le 1,\\,-1\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{3}{5},\\,\\text{E}[Y]=\\frac{1}{7},\\,\\text{SD}[X]≈0.2619,\\,\\text{SD}[Y]≈0.4238,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{-1}^{1}[{\\int }_{{y}^{2}}^{1}xy\\cdot \\frac{9}{12}(xy+1)\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{9}{12}{\\int }_{-1}^{1}[{\\int }_{{y}^{2}}^{1}({x}^{2}{y}^{2}+xy)\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{9}{12}{\\int }_{-1}^{1}{[\\frac{1}{3}{x}^{3}{y}^{2}+\\frac{1}{2}{x}^{2}y]}_{x={y}^{2}}^{x=1}\\text{d}y \\\\  & =\\frac{9}{12}{\\int }_{-1}^{1}(\\frac{1}{3}{y}^{2}+\\frac{1}{2}y-\\frac{1}{3}{y}^{8}-\\frac{1}{2}{y}^{5})\\,\\text{d}y \\\\  & =\\frac{9}{12}{[\\frac{1}{9}{y}^{3}+\\frac{1}{4}{y}^{2}-\\frac{1}{27}{y}^{9}-\\frac{1}{12}{y}^{6}]}_{-1}^{1} \\\\  & =\\frac{9}{12}[\\frac{1}{9}+\\frac{1}{4}-\\frac{1}{27}-\\frac{1}{12}-(-\\frac{1}{9}+\\frac{1}{4}+\\frac{1}{27}-\\frac{1}{12})] \\\\  & =\\frac{9}{12}(\\frac{2}{9}-\\frac{2}{27}) \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{1}{9}-(\\frac{3}{5})(\\frac{1}{7}) \\\\  & =\\frac{8}{315}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(\\frac{8}{315})}{(0.2619)\\cdot (0.4238)} \\\\  & ≈0.23,\\end{aligned}\n$$\n\nrounded to $2$ decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4aa03162-aa27-5b75-80f4-0a2a94c5c65e"] :db/ensure [:question/validate]} {:db/id "answer-field-4aa03162-aa27-5b75-80f4-0a2a94c5c65e" :answer-field/id #uuid "4aa03162-aa27-5b75-80f4-0a2a94c5c65e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1110af6f-ee8e-5716-bb31-7201313d5605" :answer-field/choices ["answer-6ca9fba2-d820-5756-9477-e3b30e8c81f1" "answer-a8f2e5b8-6c24-59e1-81ab-09386b360221" "answer-69f2cc06-4c6a-5ecd-8241-6b6fdbb489e5" "answer-8ff3df5c-e073-5d90-a4a7-c734d4432894" "answer-1110af6f-ee8e-5716-bb31-7201313d5605"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ca9fba2-d820-5756-9477-e3b30e8c81f1" :answer/id #uuid "6ca9fba2-d820-5756-9477-e3b30e8c81f1" :answer/type :answer.type/math :answer/value "-0.03" :db/ensure [:answer/validate]} {:db/id "answer-a8f2e5b8-6c24-59e1-81ab-09386b360221" :answer/id #uuid "a8f2e5b8-6c24-59e1-81ab-09386b360221" :answer/type :answer.type/math :answer/value "-0.11" :db/ensure [:answer/validate]} {:db/id "answer-69f2cc06-4c6a-5ecd-8241-6b6fdbb489e5" :answer/id #uuid "69f2cc06-4c6a-5ecd-8241-6b6fdbb489e5" :answer/type :answer.type/math :answer/value "0.08" :db/ensure [:answer/validate]} {:db/id "answer-8ff3df5c-e073-5d90-a4a7-c734d4432894" :answer/id #uuid "8ff3df5c-e073-5d90-a4a7-c734d4432894" :answer/type :answer.type/math :answer/value "0.12" :db/ensure [:answer/validate]} {:db/id "answer-1110af6f-ee8e-5716-bb31-7201313d5605" :answer/id #uuid "1110af6f-ee8e-5716-bb31-7201313d5605" :answer/type :answer.type/math :answer/value "0.23" :db/ensure [:answer/validate]} {:db/id 17592186163294 :tutorial/content "Let $X$ and $Y$ be two random variables with covariance $\\textrm{Cov}[X, Y]$ and standard deviations $\\textrm {SD}[X]$ and $\\textrm {SD}[Y].$ \n\nThe **correlation coefficient of $X$ and $Y,$** also known as the **Pearson correlation coefficient**, is denoted $\\rho$ (the Greek letter \"rho\") and is defined as\n\n$$\n\\rho = \\dfrac{\\textrm{Cov}[X, Y] }{\\textrm {SD}[X]\\cdot \\textrm {SD}[Y]}.\n$$\n\nNote the following:\n\n- The correlation coefficient satisfies\n\n$$\n-1\\leq \\rho \\leq 1.\n$$\n\n- If $X$ and $Y$ are independent random variables, then \n\n$$\n\\rho = 0.\n$$\n\nThe reverse implication does not always hold. In other words, $\\rho=0$ does *not* imply that $X$ and $Y$ are independent.\n\n- Unlike the covariance, $\\rho$ is a *dimensionless* quantity. This means we'll get the same answer regardless of the units used to measure $X$ and $Y.$\n\n- Also unlike the covariance, $\\rho$ tells the strength of the correlation between $X$ and $Y.$ We typically have the following rule of thumb:\n\n- If $|\\rho| \\gt 0.7,$ the correlation is **strong,** and the data generated by our two random variables closely follow a straight line. \n\n![](images/3f/3fd8b4e85bd76bbf78fdb2b135c49b3fd5e37fd9651dcae29d945d75aa45b905.png)\n\n- If $0.3\\leq |\\rho| \\leq 0.7,$ the correlation is **weak.** The data generated by our random variables follow a straight line, but many are far from the line.\n\n![](images/c1/c132ec90770bb84ad6c7dcc4b24773a923139c616f523ba0a23c1506c40c508c.png)\n\n- If $|\\rho| \\lt 0.3,$ then the correlation is **negligible.** No (linear) correlation exists between the data points generated by the random variables.\n\n![](images/9a/9afa80bfadc40b8b832b17dcea10d66d5a08955909d5bea66c7c010558b5ea19.png)\n\nLet's get some practice computing the correlation coefficient." :db/ensure [:tutorial/validate]} {:db/id 17592186162188 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186092383 :knowledge-point/questions ["question-4e139db0-1707-5607-ac19-864fb4bd55f1" "question-2c14c3ab-0147-5311-bdf2-26e728ddcd5d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4e139db0-1707-5607-ac19-864fb4bd55f1" :question/id #uuid "4e139db0-1707-5607-ac19-864fb4bd55f1" :question/math-academy-id "q-70515" :question/problem "Find where the tangent to the curve $y={x}^{5}+2$ at the point $(-1,1)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)={x}^{5}+2.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{5}+2)=5{x}^{4}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(-1)=5(-1)^{4}=5.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =5(x+1) \\\\ y & =5x+5+1 \\\\ y & =5x+6.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =5x+6 \\\\ x & =-\\frac{6}{5}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-\\frac{6}{5},0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4e5755c3-35f7-5f3d-a001-f80f16bfbe50"] :db/ensure [:question/validate]} {:db/id "answer-field-4e5755c3-35f7-5f3d-a001-f80f16bfbe50" :answer-field/id #uuid "4e5755c3-35f7-5f3d-a001-f80f16bfbe50" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6ba59fb1-af14-5b7b-abe3-1d96725a92c6" :answer-field/choices ["answer-69ddeca3-09f2-58ab-9d78-98c1cd90a178" "answer-cc873da9-faeb-5c9f-918f-a7d548331962" "answer-9ebd227f-5bff-5ee9-8bd2-a6190e5a4b4a" "answer-6ba59fb1-af14-5b7b-abe3-1d96725a92c6" "answer-42fbe54a-78e8-5015-9ce0-c43783605f0e"] :db/ensure [:answer-field/validate]} {:db/id "answer-69ddeca3-09f2-58ab-9d78-98c1cd90a178" :answer/id #uuid "69ddeca3-09f2-58ab-9d78-98c1cd90a178" :answer/type :answer.type/math :answer/value "(-6,0)" :db/ensure [:answer/validate]} {:db/id "answer-cc873da9-faeb-5c9f-918f-a7d548331962" :answer/id #uuid "cc873da9-faeb-5c9f-918f-a7d548331962" :answer/type :answer.type/math :answer/value "(-\\frac{1}{5},0)" :db/ensure [:answer/validate]} {:db/id "answer-9ebd227f-5bff-5ee9-8bd2-a6190e5a4b4a" :answer/id #uuid "9ebd227f-5bff-5ee9-8bd2-a6190e5a4b4a" :answer/type :answer.type/math :answer/value "(-\\frac{3}{5},0)" :db/ensure [:answer/validate]} {:db/id "answer-6ba59fb1-af14-5b7b-abe3-1d96725a92c6" :answer/id #uuid "6ba59fb1-af14-5b7b-abe3-1d96725a92c6" :answer/type :answer.type/math :answer/value "(-\\frac{6}{5},0)" :db/ensure [:answer/validate]} {:db/id "answer-42fbe54a-78e8-5015-9ce0-c43783605f0e" :answer/id #uuid "42fbe54a-78e8-5015-9ce0-c43783605f0e" :answer/type :answer.type/math :answer/value "(0,-\\frac{6}{5})" :db/ensure [:answer/validate]} {:db/id "question-2c14c3ab-0147-5311-bdf2-26e728ddcd5d" :question/id #uuid "2c14c3ab-0147-5311-bdf2-26e728ddcd5d" :question/math-academy-id "q-304084" :question/problem "Find where the tangent to the curve $y=\\frac{2}{x}+x$ at the point  $(2,3)$ intersects the $x$-axis.\n\nThe tangent intersects the $x$-axis at\n$($\n{{field-1}}$,$\n{{field-2}} $).$" :question/worked-solution "Let $f(x)=\\frac{2}{x}+x.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x}+x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{x})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-1})+\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =-2{x}^{-2}+1 \\\\  & =-\\frac{2}{{x}^{2}}+1.\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m & ={f}^{′}(2) \\\\  & =-\\frac{2}{{2}^{2}}+1 \\\\  & =-\\frac{2}{4}+1 \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{2}(x-2) \\\\ y & =\\frac{1}{2}x-1+3 \\\\ y & =\\frac{1}{2}x+2.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}\\frac{1}{2}x+2 & =0 \\\\ \\frac{1}{2}x & =-2 \\\\ x & =-2\\cdot 2 \\\\ x & =-4\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(-4,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fc3c6a28-5baf-5cae-a10f-967bb181d649" "answer-field-a0bed702-55a8-5fce-ad62-782cfcd3d3f5"] :db/ensure [:question/validate]} {:db/id "answer-field-fc3c6a28-5baf-5cae-a10f-967bb181d649" :answer-field/id #uuid "fc3c6a28-5baf-5cae-a10f-967bb181d649" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b6894baa-e048-55ba-9e2f-c9d22cb15c27" :answer-field/choices ["answer-b6894baa-e048-55ba-9e2f-c9d22cb15c27"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6894baa-e048-55ba-9e2f-c9d22cb15c27" :answer/id #uuid "b6894baa-e048-55ba-9e2f-c9d22cb15c27" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-field-a0bed702-55a8-5fce-ad62-782cfcd3d3f5" :answer-field/id #uuid "a0bed702-55a8-5fce-ad62-782cfcd3d3f5" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3668cf4b-8050-5a96-996b-c27c89d6fa21" :answer-field/choices ["answer-3668cf4b-8050-5a96-996b-c27c89d6fa21"] :db/ensure [:answer-field/validate]} {:db/id "answer-3668cf4b-8050-5a96-996b-c27c89d6fa21" :answer/id #uuid "3668cf4b-8050-5a96-996b-c27c89d6fa21" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "activity-70f11865-cb63-5f90-bb94-c66ab6be8368" :activity/id #uuid "70f11865-cb63-5f90-bb94-c66ab6be8368" :activity/title "Calculating the Equation of a Tangent Line Using Differentiation" :activity/type :activity.type/review :activity/scope 17592186050644 :activity/course 17592186046647 :activity/steps ["step-8e022878-16c2-5957-b74e-008a82b54dcb" "step-8f0e1de1-445c-5ef0-8ebc-283d32ff2db4" "step-b17b54ae-3884-5315-bfe6-1b6dd906db79"] :activity/first-step "step-8e022878-16c2-5957-b74e-008a82b54dcb" :db/ensure [:activity/validate]} {:db/id "step-8e022878-16c2-5957-b74e-008a82b54dcb" :step/id #uuid "8e022878-16c2-5957-b74e-008a82b54dcb" :step/content 17592186244126 :step/next "step-8f0e1de1-445c-5ef0-8ebc-283d32ff2db4" :db/ensure [:step/validate]} {:db/id "step-8f0e1de1-445c-5ef0-8ebc-283d32ff2db4" :step/id #uuid "8f0e1de1-445c-5ef0-8ebc-283d32ff2db4" :step/content "question-4e139db0-1707-5607-ac19-864fb4bd55f1" :step/next "step-b17b54ae-3884-5315-bfe6-1b6dd906db79" :db/ensure [:step/validate]} {:db/id "step-b17b54ae-3884-5315-bfe6-1b6dd906db79" :step/id #uuid "b17b54ae-3884-5315-bfe6-1b6dd906db79" :step/content "question-2c14c3ab-0147-5311-bdf2-26e728ddcd5d" :db/ensure [:step/validate]} {:db/id 17592186166952 :knowledge-point/questions ["question-421776ee-f665-581f-82b5-c07ca0624bc4" "question-dc83095a-e05b-5bdd-9ae4-88a129415b52" "question-d4d3424f-8de3-594c-bbdf-8f7aff226934" "question-59e144f7-fb65-5ac7-82c8-6d786a6e59bb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166953 :knowledge-point/questions ["question-0e35aedb-cd68-51d1-a6aa-ac0156232c42" "question-21f1e80e-c6ef-5f3d-9284-ec7adabd2372" "question-2194316f-56dc-52e2-8be5-47b08dc370f4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166954 :knowledge-point/questions ["question-85e8fc1d-5dff-59c4-83a1-b0b53e9abc4c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-421776ee-f665-581f-82b5-c07ca0624bc4" :question/id #uuid "421776ee-f665-581f-82b5-c07ca0624bc4" :question/math-academy-id "q-340458" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(5x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(2x-5x)+\\operatorname{cos}⁡(2x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-3x)+\\operatorname{cos}⁡(7x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(3x)+\\operatorname{cos}⁡(7x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(5x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(3x)+\\frac{1}{2}\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)+\\frac{1}{14}\\operatorname{sin}⁡(7x)]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0))+\\frac{1}{14}(\\operatorname{sin}⁡(\\frac{7\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(-1-0)+\\frac{1}{14}(-1-0) \\\\  & =-\\frac{5}{21}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-767e5e84-d488-5271-8138-b5fbcff6b6b6"] :db/ensure [:question/validate]} {:db/id "answer-field-767e5e84-d488-5271-8138-b5fbcff6b6b6" :answer-field/id #uuid "767e5e84-d488-5271-8138-b5fbcff6b6b6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bb26691a-385a-57d1-8078-1f35f18c73ca" :answer-field/choices ["answer-bb26691a-385a-57d1-8078-1f35f18c73ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-bb26691a-385a-57d1-8078-1f35f18c73ca" :answer/id #uuid "bb26691a-385a-57d1-8078-1f35f18c73ca" :answer/type :answer.type/math :answer/value "-\\frac{5}{21}" :db/ensure [:answer/validate]} {:db/id "question-dc83095a-e05b-5bdd-9ae4-88a129415b52" :question/id #uuid "dc83095a-e05b-5bdd-9ae4-88a129415b52" :question/math-academy-id "q-340459" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{cos}⁡(5x-x)+\\operatorname{cos}⁡(5x+x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(4x)+\\operatorname{cos}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\frac{1}{2}\\operatorname{cos}⁡(4x)+\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{8}\\operatorname{sin}⁡(4x)+\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{0}^{\\pi /4} \\\\  & =\\frac{1}{8}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{12}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{8}(0-0)+\\frac{1}{12}(-1-0) \\\\  & =-\\frac{1}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b96d03be-bed3-558c-a1ef-99668bcb5dc0"] :db/ensure [:question/validate]} {:db/id "answer-field-b96d03be-bed3-558c-a1ef-99668bcb5dc0" :answer-field/id #uuid "b96d03be-bed3-558c-a1ef-99668bcb5dc0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3a0b7907-741b-5293-b278-a9e4a5f33e9a" :answer-field/choices ["answer-3a0b7907-741b-5293-b278-a9e4a5f33e9a"] :db/ensure [:answer-field/validate]} {:db/id "answer-3a0b7907-741b-5293-b278-a9e4a5f33e9a" :answer/id #uuid "3a0b7907-741b-5293-b278-a9e4a5f33e9a" :answer/type :answer.type/math :answer/value "-\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "question-d4d3424f-8de3-594c-bbdf-8f7aff226934" :question/id #uuid "d4d3424f-8de3-594c-bbdf-8f7aff226934" :question/math-academy-id "q-340461" :question/problem "Evaluate the following integral.\n\n${\\int }_{\\pi /4}^{\\pi }\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(3x) & =\\frac{1}{2}(\\operatorname{cos}⁡(5x-3x)+\\operatorname{cos}⁡(5x+3x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(2x)+\\operatorname{cos}⁡(8x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi }\\operatorname{cos}⁡(5x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi }\\frac{1}{2}\\operatorname{cos}⁡(2x)+\\frac{1}{2}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & ={[\\frac{1}{4}\\operatorname{sin}⁡(2x)+\\frac{1}{16}\\operatorname{sin}⁡(8x)]}_{\\pi /4}^{\\pi } \\\\  & =\\frac{1}{4}(\\operatorname{sin}⁡(2\\pi )-\\operatorname{sin}⁡(\\frac{\\pi }{2}))+\\frac{1}{16}(\\operatorname{sin}⁡(8\\pi )-\\operatorname{sin}⁡(2\\pi )) \\\\  & =\\frac{1}{4}(0-1)+\\frac{1}{16}(0-0) \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-691cc2fe-d17d-54b1-9079-15c5e5316c91"] :db/ensure [:question/validate]} {:db/id "answer-field-691cc2fe-d17d-54b1-9079-15c5e5316c91" :answer-field/id #uuid "691cc2fe-d17d-54b1-9079-15c5e5316c91" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-32660273-053d-57c2-8679-1174253ff668" :answer-field/choices ["answer-32660273-053d-57c2-8679-1174253ff668"] :db/ensure [:answer-field/validate]} {:db/id "answer-32660273-053d-57c2-8679-1174253ff668" :answer/id #uuid "32660273-053d-57c2-8679-1174253ff668" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-59e144f7-fb65-5ac7-82c8-6d786a6e59bb" :question/id #uuid "59e144f7-fb65-5ac7-82c8-6d786a6e59bb" :question/math-academy-id "q-340462" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{3\\pi /2}\\operatorname{cos}⁡(x)\\operatorname{cos}⁡(4x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x)\\operatorname{cos}⁡(4x) & =\\frac{1}{2}(\\operatorname{cos}⁡(x-4x)+\\operatorname{cos}⁡(x+4x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-3x)+\\operatorname{cos}⁡(5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(3x)+\\operatorname{cos}⁡(5x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\pi /2}\\operatorname{cos}⁡(x)\\operatorname{cos}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{3\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(3x)+\\frac{1}{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)+\\frac{1}{10}\\operatorname{sin}⁡(5x)]}_{0}^{3\\pi /2} \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(\\frac{9\\pi }{2})-\\operatorname{sin}⁡(0))+\\frac{1}{10}(\\operatorname{sin}⁡(\\frac{15\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(1-0)+\\frac{1}{10}(-1-0) \\\\  & =\\frac{1}{15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f3f3cb93-d5b9-5bb2-99da-ae2d6fb22250"] :db/ensure [:question/validate]} {:db/id "answer-field-f3f3cb93-d5b9-5bb2-99da-ae2d6fb22250" :answer-field/id #uuid "f3f3cb93-d5b9-5bb2-99da-ae2d6fb22250" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ea6691d6-cc63-5f49-a64d-f75321108ff4" :answer-field/choices ["answer-ea6691d6-cc63-5f49-a64d-f75321108ff4"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea6691d6-cc63-5f49-a64d-f75321108ff4" :answer/id #uuid "ea6691d6-cc63-5f49-a64d-f75321108ff4" :answer/type :answer.type/math :answer/value "\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "question-0e35aedb-cd68-51d1-a6aa-ac0156232c42" :question/id #uuid "0e35aedb-cd68-51d1-a6aa-ac0156232c42" :question/math-academy-id "q-340463" :question/problem "$\\int \\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(2x) & =\\frac{1}{2}(\\operatorname{cos}⁡(7x-2x)-\\operatorname{cos}⁡(7x+2x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(5x)-\\operatorname{cos}⁡(9x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(5x)-\\frac{1}{2}\\operatorname{cos}⁡(9x)\\,\\text{d}x \\\\  & =\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{18}\\operatorname{sin}⁡(9x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-81a545ed-cedf-578d-88b8-d6dd3c4f7bb3"] :db/ensure [:question/validate]} {:db/id "answer-field-81a545ed-cedf-578d-88b8-d6dd3c4f7bb3" :answer-field/id #uuid "81a545ed-cedf-578d-88b8-d6dd3c4f7bb3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1683c09b-9789-53b1-b425-0d82094023df" :answer-field/choices ["answer-69a917d4-81bf-557f-a12a-0badc9247a62" "answer-549aa39a-cf9b-5ee8-971c-63b8771771e3" "answer-1683c09b-9789-53b1-b425-0d82094023df" "answer-47eb069d-8f5b-5110-b5ec-8e326b2af849" "answer-96f88a53-e227-5a89-aac3-2479e45d5ef0"] :db/ensure [:answer-field/validate]} {:db/id "answer-69a917d4-81bf-557f-a12a-0badc9247a62" :answer/id #uuid "69a917d4-81bf-557f-a12a-0badc9247a62" :answer/type :answer.type/math :answer/value "\\frac{1}{10}\\operatorname{cos}⁡(5x)-\\frac{1}{18}\\operatorname{cos}⁡(9x)+C" :db/ensure [:answer/validate]} {:db/id "answer-549aa39a-cf9b-5ee8-971c-63b8771771e3" :answer/id #uuid "549aa39a-cf9b-5ee8-971c-63b8771771e3" :answer/type :answer.type/math :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)+\\frac{1}{18}\\operatorname{sin}⁡(9x)+C" :db/ensure [:answer/validate]} {:db/id "answer-1683c09b-9789-53b1-b425-0d82094023df" :answer/id #uuid "1683c09b-9789-53b1-b425-0d82094023df" :answer/type :answer.type/math :answer/value "\\fr