82 :step/next "step-eabab0f7-0351-5fd6-8745-4640d71fe038" :db/ensure [:step/validate]} {:db/id "step-eabab0f7-0351-5fd6-8745-4640d71fe038" :step/id #uuid "eabab0f7-0351-5fd6-8745-4640d71fe038" :step/content 17592186172384 :step/next "step-3e118f3f-9127-5ca6-ad2b-990935fa708c" :db/ensure [:step/validate]} {:db/id "step-3e118f3f-9127-5ca6-ad2b-990935fa708c" :step/id #uuid "3e118f3f-9127-5ca6-ad2b-990935fa708c" :step/content 17592186401391 :step/next "step-6a1d79c3-6996-57c6-bc70-9f767ede18f6" :db/ensure [:step/validate]} {:db/id "step-6a1d79c3-6996-57c6-bc70-9f767ede18f6" :step/id #uuid "6a1d79c3-6996-57c6-bc70-9f767ede18f6" :step/content 17592186363493 :step/next "step-c70ffcd4-c208-5a87-8e66-2f7bd16f3515" :db/ensure [:step/validate]} {:db/id "step-c70ffcd4-c208-5a87-8e66-2f7bd16f3515" :step/id #uuid "c70ffcd4-c208-5a87-8e66-2f7bd16f3515" :step/content 17592186493972 :db/ensure [:step/validate]} {:db/id 17592186115213 :knowledge-point/questions ["question-d3ac80cd-6459-5be8-953c-5d7b28bc8da8" "question-6dbcbc9c-b30e-515a-9390-1cde473a0411"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115215 :knowledge-point/questions ["question-de567b40-8a36-58e6-967e-d32432dbd495" "question-454648d5-f41c-5a23-83bf-f9148d806a00"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115214 :knowledge-point/questions ["question-0107835e-4e3e-5394-afc5-c0c0506cc080"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d3ac80cd-6459-5be8-953c-5d7b28bc8da8" :question/id #uuid "d3ac80cd-6459-5be8-953c-5d7b28bc8da8" :question/math-academy-id "q-79866" :question/problem "Solve the equation ${log}_{2}⁡(2x-5)=\\frac{1}{3}{log}_{2}⁡(27).$" :question/worked-solution "First, we use the power rule to simplify the right-hand side. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡(2x-5) & =\\frac{1}{3}{log}_{2}⁡(27) \\\\ {log}_{2}⁡(2x-5) & ={log}_{2}⁡({27}^{1/3}) \\\\ {log}_{2}⁡(2x-5) & ={log}_{2}⁡(3).\\end{aligned}\n$$\n\nSince the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{2}⁡(2x-5) & ={log}_{2}⁡(3) \\\\ 2x-5 & =3 \\\\ 2x & =8 \\\\ x & =4.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=4$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{2}⁡(2x-5) & ={log}_{2}⁡(2(4)-5) \\\\  & ={log}_{2}⁡(3) \\\\  & =\\frac{1}{3}{log}_{2}⁡(27).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=4$ is a valid solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-389631a9-06db-578a-b331-cd015ccdd6d5"] :db/ensure [:question/validate]} {:db/id "answer-field-389631a9-06db-578a-b331-cd015ccdd6d5" :answer-field/id #uuid "389631a9-06db-578a-b331-cd015ccdd6d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5df44419-fb9b-5b67-b386-8e33fa51a0a7" :answer-field/choices ["answer-985ddd2f-5a93-55b9-b6eb-39e6e65c2266" "answer-dfdfa689-1723-5c62-9474-88ab151694aa" "answer-5df44419-fb9b-5b67-b386-8e33fa51a0a7" "answer-293f6fac-2a04-5dc8-a0a3-e9394c0f7b0f" "answer-adef868d-94c1-557f-b02b-4ee72c5adbd2"] :db/ensure [:answer-field/validate]} {:db/id "answer-985ddd2f-5a93-55b9-b6eb-39e6e65c2266" :answer/id #uuid "985ddd2f-5a93-55b9-b6eb-39e6e65c2266" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-dfdfa689-1723-5c62-9474-88ab151694aa" :answer/id #uuid "dfdfa689-1723-5c62-9474-88ab151694aa" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "answer-5df44419-fb9b-5b67-b386-8e33fa51a0a7" :answer/id #uuid "5df44419-fb9b-5b67-b386-8e33fa51a0a7" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-293f6fac-2a04-5dc8-a0a3-e9394c0f7b0f" :answer/id #uuid "293f6fac-2a04-5dc8-a0a3-e9394c0f7b0f" :answer/type :answer.type/math :answer/value "x=8" :db/ensure [:answer/validate]} {:db/id "answer-adef868d-94c1-557f-b02b-4ee72c5adbd2" :answer/id #uuid "adef868d-94c1-557f-b02b-4ee72c5adbd2" :answer/type :answer.type/math :answer/value "x=9" :db/ensure [:answer/validate]} {:db/id "question-6dbcbc9c-b30e-515a-9390-1cde473a0411" :question/id #uuid "6dbcbc9c-b30e-515a-9390-1cde473a0411" :question/math-academy-id "q-110796" :question/problem "If ${log}_{5}⁡(4-x)=2{log}_{5}⁡2,$ then what is the value of $x?$" :question/worked-solution "First, we use the power rule to simplify the right-hand side. This gives\n\n$$\n\\begin{aligned}{log}_{5}⁡(4-x) & =2{log}_{5}⁡2 \\\\ {log}_{5}⁡(4-x) & ={log}_{5}⁡{2}^{2} \\\\ {log}_{5}⁡(4-x) & ={log}_{5}⁡4.\\end{aligned}\n$$\n\nSince the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{5}⁡(4-x) & ={log}_{5}⁡4 \\\\ 4-x & =4 \\\\ x & =0.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=0$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{5}⁡(4-x) & ={log}_{5}⁡(4-0) \\\\  & ={log}_{5}⁡(4) \\\\  & ={log}_{5}⁡({2}^{2}) \\\\  & =2{log}_{5}⁡2.\\,✓\\end{aligned}\n$$\n\nTherefore, $x=0$ is a valid solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3b216247-45f8-5924-bd09-17bdfae3c6c0"] :db/ensure [:question/validate]} {:db/id "answer-field-3b216247-45f8-5924-bd09-17bdfae3c6c0" :answer-field/id #uuid "3b216247-45f8-5924-bd09-17bdfae3c6c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f49739f0-48e8-5f89-bde8-5a70ceaae178" :answer-field/choices ["answer-7efc7d17-e9cc-5d33-8433-df8a51e85e89" "answer-01559a85-3d08-5f2b-b75b-e99183bdf0aa" "answer-f49739f0-48e8-5f89-bde8-5a70ceaae178" "answer-15629f88-a1af-5330-a437-f1ef36d4d68e" "answer-bef3d0be-49bf-5026-9467-bcf81d5d0568"] :db/ensure [:answer-field/validate]} {:db/id "answer-7efc7d17-e9cc-5d33-8433-df8a51e85e89" :answer/id #uuid "7efc7d17-e9cc-5d33-8433-df8a51e85e89" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-01559a85-3d08-5f2b-b75b-e99183bdf0aa" :answer/id #uuid "01559a85-3d08-5f2b-b75b-e99183bdf0aa" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-f49739f0-48e8-5f89-bde8-5a70ceaae178" :answer/id #uuid "f49739f0-48e8-5f89-bde8-5a70ceaae178" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-15629f88-a1af-5330-a437-f1ef36d4d68e" :answer/id #uuid "15629f88-a1af-5330-a437-f1ef36d4d68e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-bef3d0be-49bf-5026-9467-bcf81d5d0568" :answer/id #uuid "bef3d0be-49bf-5026-9467-bcf81d5d0568" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-de567b40-8a36-58e6-967e-d32432dbd495" :question/id #uuid "de567b40-8a36-58e6-967e-d32432dbd495" :question/math-academy-id "q-100769" :question/problem "Given that $\\operatorname{log}⁡(3x-5)=\\operatorname{log}⁡(7-x),$ what is the value of $x?$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(3x-5) & =\\operatorname{log}⁡(7-x) \\\\ 3x-5 & =7-x \\\\ 4x & =12 \\\\ x & =3.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=3$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(3(3)-5) & \\overset{?}{=}\\operatorname{log}⁡(7-3) \\\\ \\operatorname{log}⁡(4) & =\\operatorname{log}⁡(4)\\,✓\\end{aligned}\n$$\n\nTherefore, $x=3$ is a valid solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ad1a629b-9044-5158-8f0e-280cd361d793"] :db/ensure [:question/validate]} {:db/id "answer-field-ad1a629b-9044-5158-8f0e-280cd361d793" :answer-field/id #uuid "ad1a629b-9044-5158-8f0e-280cd361d793" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ff575287-1487-5af4-b77a-4cb9f14cf356" :answer-field/choices ["answer-56958972-94b5-571f-b4ba-1604c2f5214e" "answer-5bd27eab-1cb3-5722-8b8e-6550c41efc2c" "answer-ff575287-1487-5af4-b77a-4cb9f14cf356" "answer-3c32042f-9a1b-5a1c-90ed-857badec8638" "answer-e65f4b49-cc59-56d2-ad31-186cc7327c2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-56958972-94b5-571f-b4ba-1604c2f5214e" :answer/id #uuid "56958972-94b5-571f-b4ba-1604c2f5214e" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-5bd27eab-1cb3-5722-8b8e-6550c41efc2c" :answer/id #uuid "5bd27eab-1cb3-5722-8b8e-6550c41efc2c" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-ff575287-1487-5af4-b77a-4cb9f14cf356" :answer/id #uuid "ff575287-1487-5af4-b77a-4cb9f14cf356" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-3c32042f-9a1b-5a1c-90ed-857badec8638" :answer/id #uuid "3c32042f-9a1b-5a1c-90ed-857badec8638" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-e65f4b49-cc59-56d2-ad31-186cc7327c2a" :answer/id #uuid "e65f4b49-cc59-56d2-ad31-186cc7327c2a" :answer/type :answer.type/text :answer/value "No real solutions" :db/ensure [:answer/validate]} {:db/id "question-454648d5-f41c-5a23-83bf-f9148d806a00" :question/id #uuid "454648d5-f41c-5a23-83bf-f9148d806a00" :question/math-academy-id "q-100763" :question/problem "Solve $\\operatorname{log}⁡(4x)=\\operatorname{log}⁡(5x+9)$ for $x.$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(4x) & =\\operatorname{log}⁡(5x+9) \\\\ 4x & =5x+9 \\\\ x & =-9.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation: \n\n- Substituting $x=-9$ back into the original equation, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(4x) & \\overset{?}{=}\\operatorname{log}⁡(5x+9) \\\\ \\operatorname{log}⁡(4(-9)) & \\overset{?}{=}\\operatorname{log}⁡(5(-9)+9) \\\\ \\operatorname{log}⁡(-36) & \\overset{?}{=}\\operatorname{log}⁡(-36)\\end{aligned}\n$$\n\nHowever, $\\operatorname{log}⁡(-36)$ is not a real number.\n\nTherefore, we conclude that the equation has no real solutions." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e5df186d-949c-5c4d-8754-3946a2fd4215"] :db/ensure [:question/validate]} {:db/id "answer-field-e5df186d-949c-5c4d-8754-3946a2fd4215" :answer-field/id #uuid "e5df186d-949c-5c4d-8754-3946a2fd4215" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3e0de288-e17e-5bf7-bd37-46f5c2f0e4c8" :answer-field/choices ["answer-b8c1ffbe-1de5-51fd-b0a4-5b7d3d8d008b" "answer-d1f644a8-4fa0-5151-8a54-b0b8fac4da61" "answer-1b439e4f-29b5-5860-82f4-48f94dd1db4f" "answer-76c91ffe-1f19-5e63-972d-f33c42832ac7" "answer-3e0de288-e17e-5bf7-bd37-46f5c2f0e4c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-b8c1ffbe-1de5-51fd-b0a4-5b7d3d8d008b" :answer/id #uuid "b8c1ffbe-1de5-51fd-b0a4-5b7d3d8d008b" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-d1f644a8-4fa0-5151-8a54-b0b8fac4da61" :answer/id #uuid "d1f644a8-4fa0-5151-8a54-b0b8fac4da61" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-1b439e4f-29b5-5860-82f4-48f94dd1db4f" :answer/id #uuid "1b439e4f-29b5-5860-82f4-48f94dd1db4f" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-76c91ffe-1f19-5e63-972d-f33c42832ac7" :answer/id #uuid "76c91ffe-1f19-5e63-972d-f33c42832ac7" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-3e0de288-e17e-5bf7-bd37-46f5c2f0e4c8" :answer/id #uuid "3e0de288-e17e-5bf7-bd37-46f5c2f0e4c8" :answer/type :answer.type/text :answer/value "No real solutions" :db/ensure [:answer/validate]} {:db/id "question-0107835e-4e3e-5394-afc5-c0c0506cc080" :question/id #uuid "0107835e-4e3e-5394-afc5-c0c0506cc080" :question/math-academy-id "q-79873" :question/problem "Solve the equation ${log}_{6}⁡({x}^{2}+20)={log}_{6}⁡(-10x-5).$" :question/worked-solution "Since the logarithms on both sides of the equation have the same base, we can equate the arguments. This gives\n\n$$\n\\begin{aligned}{log}_{6}⁡({x}^{2}+20) & ={log}_{6}⁡(-10x-5) \\\\ {x}^{2}+20 & =-10x-5 \\\\ {x}^{2}+10x+25 & =0 \\\\ (x+5)^{2} & =0 \\\\ x & =-5.\\end{aligned}\n$$\n\nLet's now check for extraneous solutions by substituting back into the original equation:\n\n- Substituting $x=-5$ back into the original equation, we get\n\n$$\n\\begin{aligned}{log}_{6}⁡({x}^{2}+20) & \\overset{?}{=}{log}_{6}⁡(-10x-5) \\\\ {log}_{6}⁡((-5)^{2}+20) & \\overset{?}{=}{log}_{6}⁡(-10(-5)-5) \\\\ {log}_{6}⁡(45) & ={log}_{6}⁡(45).\\,✓\\end{aligned}\n$$\n\nTherefore, $x=-5$ is a valid solution." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fc88efbc-b8e0-5750-b595-44d875bff8cc"] :db/ensure [:question/validate]} {:db/id "answer-field-fc88efbc-b8e0-5750-b595-44d875bff8cc" :answer-field/id #uuid "fc88efbc-b8e0-5750-b595-44d875bff8cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21c7f66e-df91-5a0b-81c5-8323dd0749cd" :answer-field/choices ["answer-64c71b5a-1c3f-56db-ac11-a90b6661d9c1" "answer-7e9deabd-ac4b-5f55-8c56-eb4b90d311b6" "answer-21c7f66e-df91-5a0b-81c5-8323dd0749cd" "answer-27392c0f-6fc9-5c3d-94bd-a227478f1528" "answer-f94bcb29-f716-5ccb-8260-3a2a73f6fdb8"] :db/ensure [:answer-field/validate]} {:db/id "answer-64c71b5a-1c3f-56db-ac11-a90b6661d9c1" :answer/id #uuid "64c71b5a-1c3f-56db-ac11-a90b6661d9c1" :answer/type :answer.type/math :answer/value "x=-15" :db/ensure [:answer/validate]} {:db/id "answer-7e9deabd-ac4b-5f55-8c56-eb4b90d311b6" :answer/id #uuid "7e9deabd-ac4b-5f55-8c56-eb4b90d311b6" :answer/type :answer.type/math :answer/value "x=-45" :db/ensure [:answer/validate]} {:db/id "answer-21c7f66e-df91-5a0b-81c5-8323dd0749cd" :answer/id #uuid "21c7f66e-df91-5a0b-81c5-8323dd0749cd" :answer/type :answer.type/math :answer/value "x=-5" :db/ensure [:answer/validate]} {:db/id "answer-27392c0f-6fc9-5c3d-94bd-a227478f1528" :answer/id #uuid "27392c0f-6fc9-5c3d-94bd-a227478f1528" :answer/type :answer.type/math :answer/value "x=45" :db/ensure [:answer/validate]} {:db/id "answer-f94bcb29-f716-5ccb-8260-3a2a73f6fdb8" :answer/id #uuid "f94bcb29-f716-5ccb-8260-3a2a73f6fdb8" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id 17592186124662 :knowledge-point/questions ["question-1544d2ec-f693-56d4-9990-975c61a78ee3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186296844 :answer-field/correct "answer-90e243fd-b4a7-5bb3-b6f7-98ba2d532cd4" :answer-field/choices ["answer-90e243fd-b4a7-5bb3-b6f7-98ba2d532cd4"] :db/ensure [:answer-field/validate]} {:db/id "answer-90e243fd-b4a7-5bb3-b6f7-98ba2d532cd4" :answer/id #uuid "90e243fd-b4a7-5bb3-b6f7-98ba2d532cd4" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-1544d2ec-f693-56d4-9990-975c61a78ee3" :question/id #uuid "1544d2ec-f693-56d4-9990-975c61a78ee3" :question/math-academy-id "q-339624" :question/problem "Evaluate the limit:\n\n${lim}_{x\\to -\\infty }\\,\\,\\frac{6{x}^{7}-3{x}^{3}-4}{2{x}^{5}+7}=$\n\n{{field-1}}" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{5}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{6{x}^{7}-3{x}^{3}-4}{2{x}^{5}+7} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{6{x}^{7}}{{x}^{5}}-\\frac{3{x}^{3}}{{x}^{5}}-\\frac{4}{{x}^{5}})}{(\\frac{2{x}^{5}}{{x}^{5}}+\\frac{7}{{x}^{5}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(6{x}^{2}-\\frac{3}{{x}^{2}}-\\frac{4}{{x}^{3}})}{(2+\\frac{7}{{x}^{5}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{6{x}^{2}-0-0}{2+0} \\\\  & ={lim}_{x\\to -\\infty }3{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-47f4facf-bcde-5c7b-98da-d06ed85acb33"] :db/ensure [:question/validate]} {:db/id "answer-field-47f4facf-bcde-5c7b-98da-d06ed85acb33" :answer-field/id #uuid "47f4facf-bcde-5c7b-98da-d06ed85acb33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e93e7701-2e6f-5fed-a8e4-049ca8293fd9" :answer-field/choices ["answer-e93e7701-2e6f-5fed-a8e4-049ca8293fd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-e93e7701-2e6f-5fed-a8e4-049ca8293fd9" :answer/id #uuid "e93e7701-2e6f-5fed-a8e4-049ca8293fd9" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "activity-10295d70-6ad8-553d-a5f9-d9b083582e4c" :activity/id #uuid "10295d70-6ad8-553d-a5f9-d9b083582e4c" :activity/title "Limits at Infinity and Horizontal Asymptotes of Rational Functions" :activity/type :activity.type/review :activity/scope 17592186050004 :activity/course 17592186046658 :activity/steps ["step-c6ad608c-1279-5180-92ac-08be742f15d5" "step-22c02e95-1ba7-5783-9176-80a1df536b87" "step-e2351388-b7b0-5b22-9aa1-20839b77e7ca" "step-d1b2f87b-6dcc-5404-a314-4a4505ca7a2d" "step-a143b3fe-a7b0-5158-a0a9-b332fd420167"] :activity/first-step "step-c6ad608c-1279-5180-92ac-08be742f15d5" :db/ensure [:activity/validate]} {:db/id "step-c6ad608c-1279-5180-92ac-08be742f15d5" :step/id #uuid "c6ad608c-1279-5180-92ac-08be742f15d5" :step/content 17592186124911 :step/next "step-22c02e9