-field-07c7d6ce-4f06-5304-8425-c8b4142ed64a"] :db/ensure [:question/validate]} {:db/id "answer-field-07c7d6ce-4f06-5304-8425-c8b4142ed64a" :answer-field/id #uuid "07c7d6ce-4f06-5304-8425-c8b4142ed64a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-80145c95-b84b-5808-923b-3cdcc12a1cfc" :answer-field/choices ["answer-80145c95-b84b-5808-923b-3cdcc12a1cfc" "answer-169a662e-ca2a-5913-89f1-d1da659545d0" "answer-4cc3dc9b-51cc-52e9-b6c0-a1cc1c0fb03c" "answer-66dfa030-6a3d-5117-bac7-4226f2a64aea" "answer-9b5b3876-bff0-5759-89e8-b2b5717a132a"] :db/ensure [:answer-field/validate]} {:db/id "answer-80145c95-b84b-5808-923b-3cdcc12a1cfc" :answer/id #uuid "80145c95-b84b-5808-923b-3cdcc12a1cfc" :answer/type :answer.type/text :answer/value "Daniel bought $2$ cookies per dollar" :db/ensure [:answer/validate]} {:db/id "answer-169a662e-ca2a-5913-89f1-d1da659545d0" :answer/id #uuid "169a662e-ca2a-5913-89f1-d1da659545d0" :answer/type :answer.type/text :answer/value "Daniel bought $3$ cookies per dollar" :db/ensure [:answer/validate]} {:db/id "answer-4cc3dc9b-51cc-52e9-b6c0-a1cc1c0fb03c" :answer/id #uuid "4cc3dc9b-51cc-52e9-b6c0-a1cc1c0fb03c" :answer/type :answer.type/text :answer/value "Daniel bought $4$ cookies per dollar" :db/ensure [:answer/validate]} {:db/id "answer-66dfa030-6a3d-5117-bac7-4226f2a64aea" :answer/id #uuid "66dfa030-6a3d-5117-bac7-4226f2a64aea" :answer/type :answer.type/text :answer/value "Daniel bought $\\frac{1}{2}$ of a cookie per dollar" :db/ensure [:answer/validate]} {:db/id "answer-9b5b3876-bff0-5759-89e8-b2b5717a132a" :answer/id #uuid "9b5b3876-bff0-5759-89e8-b2b5717a132a" :answer/type :answer.type/text :answer/value "Daniel bought $\\frac{1}{4}$ of a cookie per dollar" :db/ensure [:answer/validate]} {:db/id "question-331d0e38-c03a-5100-b4c4-4b758a51792c" :question/id #uuid "331d0e38-c03a-5100-b4c4-4b758a51792c" :question/math-academy-id "q-169436" :question/problem "Steven took $6$ days to read a book of $45$ pages. If he read the same number of pages each day, then at what rate did Steven read the book?" :question/worked-solution "The ratio of pages to days is $45:6.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{45}{6}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $3:$\n\n$$\n\\frac{45÷3}{6÷3}=\\frac{15}{2}\n$$\n\nConsequently, Steven read the book at a rate of $\\frac{15}{2}$ pages per day." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4213ba9e-f4e9-5ba0-9998-319810155b21"] :db/ensure [:question/validate]} {:db/id "answer-field-4213ba9e-f4e9-5ba0-9998-319810155b21" :answer-field/id #uuid "4213ba9e-f4e9-5ba0-9998-319810155b21" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e880148-7aa6-53bf-ad89-967a5fbacc48" :answer-field/choices ["answer-15cc29f7-dc8f-5fe3-8e30-425af9d46268" "answer-6e880148-7aa6-53bf-ad89-967a5fbacc48" "answer-42f2488b-b75d-52e0-a6bd-2789e8ca7a6b" "answer-4804cf81-639c-5ed7-b3c5-3ade8a1d843d" "answer-9b8bb416-2b90-53a3-9d14-8df23ad783de"] :db/ensure [:answer-field/validate]} {:db/id "answer-15cc29f7-dc8f-5fe3-8e30-425af9d46268" :answer/id #uuid "15cc29f7-dc8f-5fe3-8e30-425af9d46268" :answer/type :answer.type/text :answer/value "$7$ pages per day" :db/ensure [:answer/validate]} {:db/id "answer-6e880148-7aa6-53bf-ad89-967a5fbacc48" :answer/id #uuid "6e880148-7aa6-53bf-ad89-967a5fbacc48" :answer/type :answer.type/text :answer/value "$\\frac{15}{2}$ pages per day" :db/ensure [:answer/validate]} {:db/id "answer-42f2488b-b75d-52e0-a6bd-2789e8ca7a6b" :answer/id #uuid "42f2488b-b75d-52e0-a6bd-2789e8ca7a6b" :answer/type :answer.type/text :answer/value "$\\frac{22}{3}$ pages per day" :db/ensure [:answer/validate]} {:db/id "answer-4804cf81-639c-5ed7-b3c5-3ade8a1d843d" :answer/id #uuid "4804cf81-639c-5ed7-b3c5-3ade8a1d843d" :answer/type :answer.type/text :answer/value "$\\frac{25}{2}$ pages per day" :db/ensure [:answer/validate]} {:db/id "answer-9b8bb416-2b90-53a3-9d14-8df23ad783de" :answer/id #uuid "9b8bb416-2b90-53a3-9d14-8df23ad783de" :answer/type :answer.type/text :answer/value "$\\frac{45}{2}$ pages per day" :db/ensure [:answer/validate]} {:db/id "question-585e1f16-1ef5-574f-9665-67875bdab00b" :question/id #uuid "585e1f16-1ef5-574f-9665-67875bdab00b" :question/math-academy-id "q-60454" :question/problem "Sophia bought $14$ peaches for $$4.$ What is the price per peach?" :question/worked-solution "The ratio of dollars to peaches is $4:14.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{4}{14}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $2:$\n\n$$\n\\frac{4÷2}{14÷2}=\\frac{2}{7}\n$$\n\nConsequently, the price of each peach is $\\frac{2}{7}$ of one dollar." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-32cde7f5-8b1f-53c4-a494-a727050f3e25"] :db/ensure [:question/validate]} {:db/id "answer-field-32cde7f5-8b1f-53c4-a494-a727050f3e25" :answer-field/id #uuid "32cde7f5-8b1f-53c4-a494-a727050f3e25" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f3851c55-6bf3-50c0-bc67-1ba830e7289e" :answer-field/choices ["answer-ddf7aa91-b73c-5a4f-abbe-0828f0280238" "answer-f3851c55-6bf3-50c0-bc67-1ba830e7289e" "answer-b56e3421-4c05-5adb-bc5a-29e7ef300c69" "answer-5907624d-87ff-5efe-be98-30c27c1c05a6" "answer-448249d3-e65f-58d7-aa8a-4d8b3c69d0bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-ddf7aa91-b73c-5a4f-abbe-0828f0280238" :answer/id #uuid "ddf7aa91-b73c-5a4f-abbe-0828f0280238" :answer/type :answer.type/text :answer/value "$\\frac{1}{2}$ of one dollar" :db/ensure [:answer/validate]} {:db/id "answer-f3851c55-6bf3-50c0-bc67-1ba830e7289e" :answer/id #uuid "f3851c55-6bf3-50c0-bc67-1ba830e7289e" :answer/type :answer.type/text :answer/value "$\\frac{2}{7}$ of one dollar" :db/ensure [:answer/validate]} {:db/id "answer-b56e3421-4c05-5adb-bc5a-29e7ef300c69" :answer/id #uuid "b56e3421-4c05-5adb-bc5a-29e7ef300c69" :answer/type :answer.type/text :answer/value "$\\frac{4}{7}$ of one dollar" :db/ensure [:answer/validate]} {:db/id "answer-5907624d-87ff-5efe-be98-30c27c1c05a6" :answer/id #uuid "5907624d-87ff-5efe-be98-30c27c1c05a6" :answer/type :answer.type/text :answer/value "$\\frac{5}{2}$ dollars" :db/ensure [:answer/validate]} {:db/id "answer-448249d3-e65f-58d7-aa8a-4d8b3c69d0bb" :answer/id #uuid "448249d3-e65f-58d7-aa8a-4d8b3c69d0bb" :answer/type :answer.type/text :answer/value "$\\frac{7}{2}$ dollars" :db/ensure [:answer/validate]} {:db/id "question-b262ffc7-3f09-5b66-b29a-de72ce27ab0c" :question/id #uuid "b262ffc7-3f09-5b66-b29a-de72ce27ab0c" :question/math-academy-id "q-169435" :question/problem "Lily bought $8$ small cakes for $$12.$ At what unit price did Lily pay?" :question/worked-solution "The ratio of dollars to cakes is $12:8.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{12}{8}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $4:$\n\n$$\n\\frac{12÷4}{8÷4}=\\frac{3}{2}\n$$\n\nConsequently, the unit price Lily paid is $\\frac{3}{2}$ of a dollar per cake." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2b93b1b7-1be7-5e9e-bdda-e5b1b03e0cfd"] :db/ensure [:question/validate]} {:db/id "answer-field-2b93b1b7-1be7-5e9e-bdda-e5b1b03e0cfd" :answer-field/id #uuid "2b93b1b7-1be7-5e9e-bdda-e5b1b03e0cfd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5064c7e8-37f9-58cc-812a-3fac1e503b29" :answer-field/choices ["answer-8a7ea42b-81eb-5020-9db5-7a55afd2da06" "answer-5064c7e8-37f9-58cc-812a-3fac1e503b29" "answer-1a198a15-8241-5caa-afd0-156ee85242df" "answer-8fba30bb-3f31-59ba-8591-7252451e24ba" "answer-df035eb8-f5cf-5b36-9614-347c8b6f1045"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a7ea42b-81eb-5020-9db5-7a55afd2da06" :answer/id #uuid "8a7ea42b-81eb-5020-9db5-7a55afd2da06" :answer/type :answer.type/text :answer/value "$\\frac{2}{3}$ of a dollar per cake" :db/ensure [:answer/validate]} {:db/id "answer-5064c7e8-37f9-58cc-812a-3fac1e503b29" :answer/id #uuid "5064c7e8-37f9-58cc-812a-3fac1e503b29" :answer/type :answer.type/text :answer/value "$\\frac{3}{2}$ of a dollar per cake" :db/ensure [:answer/validate]} {:db/id "answer-1a198a15-8241-5caa-afd0-156ee85242df" :answer/id #uuid "1a198a15-8241-5caa-afd0-156ee85242df" :answer/type :answer.type/text :answer/value "$\\frac{3}{4}$ of a dollar per cake" :db/ensure [:answer/validate]} {:db/id "answer-8fba30bb-3f31-59ba-8591-7252451e24ba" :answer/id #uuid "8fba30bb-3f31-59ba-8591-7252451e24ba" :answer/type :answer.type/text :answer/value "$\\frac{4}{3}$ of a dollar per cake" :db/ensure [:answer/validate]} {:db/id "answer-df035eb8-f5cf-5b36-9614-347c8b6f1045" :answer/id #uuid "df035eb8-f5cf-5b36-9614-347c8b6f1045" :answer/type :answer.type/text :answer/value "$\\frac{5}{2}$ of a dollar per cake" :db/ensure [:answer/validate]} {:db/id "question-bc23fb40-881c-569e-9c33-6084a7f24a37" :question/id #uuid "bc23fb40-881c-569e-9c33-6084a7f24a37" :question/math-academy-id "q-92896" :question/problem "John bought $25$ candies for $$3.$ What is the price per candy?" :question/worked-solution "The ratio of dollars to candies is $3:25.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{3}{25}\n$$\n\nWe can convert this fraction to a decimal by multiplying the numerator and denominator by $4:$\n\n$$\n\\frac{3\\times 4}{25\\times 4}=\\frac{12}{100}=0.12\n$$\n\nConsequently, the cost is $$0.12$ per candy." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2e48d868-c69b-5dee-bf6a-ebad1d294833"] :db/ensure [:question/validate]} {:db/id "answer-field-2e48d868-c69b-5dee-bf6a-ebad1d294833" :answer-field/id #uuid "2e48d868-c69b-5dee-bf6a-ebad1d294833" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-43096657-4ce5-5e3c-835c-31a394a75e54" :answer-field/choices ["answer-0459c439-8b14-5d9a-91df-4ca72c3317da" "answer-43096657-4ce5-5e3c-835c-31a394a75e54" "answer-cbd33eda-7c94-51b4-81af-8d5198b21dc2" "answer-a3fc8369-f5cc-555f-bf36-2240c107e5c5" "answer-3fbd2d81-cda5-56cc-aeb4-82b360bcd345"] :db/ensure [:answer-field/validate]} {:db/id "answer-0459c439-8b14-5d9a-91df-4ca72c3317da" :answer/id #uuid "0459c439-8b14-5d9a-91df-4ca72c3317da" :answer/type :answer.type/text :answer/value "$$0.09$" :db/ensure [:answer/validate]} {:db/id "answer-43096657-4ce5-5e3c-835c-31a394a75e54" :answer/id #uuid "43096657-4ce5-5e3c-835c-31a394a75e54" :answer/type :answer.type/text :answer/value "$$0.12$" :db/ensure [:answer/validate]} {:db/id "answer-cbd33eda-7c94-51b4-81af-8d5198b21dc2" :answer/id #uuid "cbd33eda-7c94-51b4-81af-8d5198b21dc2" :answer/type :answer.type/text :answer/value "$$0.15$" :db/ensure [:answer/validate]} {:db/id "answer-a3fc8369-f5cc-555f-bf36-2240c107e5c5" :answer/id #uuid "a3fc8369-f5cc-555f-bf36-2240c107e5c5" :answer/type :answer.type/text :answer/value "$$0.20$" :db/ensure [:answer/validate]} {:db/id "answer-3fbd2d81-cda5-56cc-aeb4-82b360bcd345" :answer/id #uuid "3fbd2d81-cda5-56cc-aeb4-82b360bcd345" :answer/type :answer.type/text :answer/value "$$0.25$" :db/ensure [:answer/validate]} {:db/id "question-b842ef2a-5852-5df6-832b-3f42a5693c4d" :question/id #uuid "b842ef2a-5852-5df6-832b-3f42a5693c4d" :question/math-academy-id "q-60053" :question/problem "John bought a bouquet of $4$ roses for $$5.$ What is the price per rose?" :question/worked-solution "The ratio of dollars to roses is $5:4.$ Expressing this as a fraction, we have:\n\n$$\n\\frac{5}{4}\n$$\n\nWe can convert this fraction to a decimal by multiplying the numerator and denominator by $25:$\n\n$$\n\\frac{5\\times 25}{4\\times 25}=\\frac{125}{100}=1.25\n$$\n\nConsequently, the cost is $$1.25$ per rose." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5b957a94-7175-5bc9-80b7-6abcaf46ddc4"] :db/ensure [:question/validate]} {:db/id "answer-field-5b957a94-7175-5bc9-80b7-6abcaf46ddc4" :answer-field/id #uuid "5b957a94-7175-5bc9-80b7-6abcaf46ddc4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-66a15fcb-5bd2-5496-87fb-8f0b23fb02c3" :answer-field/choices ["answer-cf680200-8003-557c-b1d1-dd6913a6f41d" "answer-7fd48ad6-aaf3-5965-bdd0-b50d799642b6" "answer-7b9170d3-e547-5e77-abfb-235c973c92ef" "answer-56b1e35a-f7b2-5de6-96a3-a4d4ebe214af" "answer-66a15fcb-5bd2-5496-87fb-8f0b23fb02c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf680200-8003-557c-b1d1-dd6913a6f41d" :answer/id #uuid "cf680200-8003-557c-b1d1-dd6913a6f41d" :answer/type :answer.type/text :answer/value "$$0.60$" :db/ensure [:answer/validate]} {:db/id "answer-7fd48ad6-aaf3-5965-bdd0-b50d799642b6" :answer/id #uuid "7fd48ad6-aaf3-5965-bdd0-b50d799642b6" :answer/type :answer.type/text :answer/value "$$0.75$" :db/ensure [:answer/validate]} {:db/id "answer-7b9170d3-e547-5e77-abfb-235c973c92ef" :answer/id #uuid "7b9170d3-e547-5e77-abfb-235c973c92ef" :answer/type :answer.type/text :answer/value "$$0.80$" :db/ensure [:answer/validate]} {:db/id "answer-56b1e35a-f7b2-5de6-96a3-a4d4ebe214af" :answer/id #uuid "56b1e35a-f7b2-5de6-96a3-a4d4ebe214af" :answer/type :answer.type/text :answer/value "$$1.20$" :db/ensure [:answer/validate]} {:db/id "answer-66a15fcb-5bd2-5496-87fb-8f0b23fb02c3" :answer/id #uuid "66a15fcb-5bd2-5496-87fb-8f0b23fb02c3" :answer/type :answer.type/text :answer/value "$$1.25$" :db/ensure [:answer/validate]} {:db/id 17592186074970 :tutorial/content "A **unit rate** is a comparison of two quantities where one of the terms has a quantity of $1.$ This means the ratio, in fraction form, has a denominator of $1.$\n\nFor instance, suppose Michael earned $\\[math] 200$ by selling $4$ identical tires.\n\nThe ratio of dollars to tires is ${\\color{blue}200}:{\\color{red}4}.$ Writing the ratio as a fraction, we have\n\n$$\n\\dfrac{{\\color{blue}200}}{{\\color{red}4}} \\, .\n$$\n\nThe unit rate is how many dollars Michael got for $1$ tire.\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $4\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}200} \\div 4}{{\\color{red}4} \\div 4} = \\dfrac{{\\color{blue}50}}{{\\color{red}1}}\n$$\n\nThis is the unit rate. In this case, we say that Michael got $\\color{blue}50$ dollars *per* tire." :db/ensure [:tutorial/validate]} {:db/id 17592186073975 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186161979 :knowledge-point/questions ["question-7243696d-a88c-5019-9844-41fc2be79db7" "question-d897469f-7656-5297-824e-0adce50d0f86" "question-e09bb1cf-2314-567d-8f07-99c777c75c71"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161771 :question/problem "Which of the following matrices are symmetric?\n\n![](images/fb/fb428c39bbc03be798bca2463658676de5c684396001cf547e9395352f456bc9.svg)" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA = A^T\n$$\n\nEquivalently, $a_{ij} = a_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P=P^T.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q=Q^T.$\n\n- $R$ is *not* a symmetric matrix. Since $r_{12} \\neq r_{21},$ we obtain $R \\neq R^T.$\n![](images/3f/3f91ec40e717eac93bb38f9c13f7b1700e84ac109ccceaffbb8473ba8d6b4e34.svg)\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\"" :db/ensure [:question/validate]} {:db/id 17592186162024 :knowledge-point/questions ["question-30380c91-5652-5051-8810-4fc9abb6a29f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161816 :question/problem "Which of the following statements are true?\n\nI. If $A$ is *any* $n\\times n$ matrix, then $A+A^T$ is always symmetric.\n\nII. The difference between two $n\\times n$ symmetric matrices is symmetric.\n\nIII. The product of two $n\\times n$ symmetric matrices is symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA = A^T\n$$\n\nEquivalently, $a_{ij} = a_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any matrix $A,$ we have \n\n$$\n\\begin{aligned}(A+{A}^{T})^{T} & ={A}^{T}+({A}^{T})^{T} \\\\  & ={A}^{T}+A \\\\  & =A+{A}^{T}.\\end{aligned}\n$$\n\n- Statement II is true. Indeed, the sum or difference between two symmetric matrices is symmetric.\n\n- Statement III is false. As a counterexample, consider the symmetric matrices \n![](images/81/812e9888b920e0338fd72116464b8b96c8c272f95f180cd46aa3f1db9afac8d2.svg)\nTheir product is not symmetric:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only.\"" :db/ensure [:question/validate]} {:db/id "question-7243696d-a88c-5019-9844-41fc2be79db7" :question/id #uuid "7243696d-a88c-5019-9844-41fc2be79db7" :question/math-academy-id "q-143682" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}3 & \\frac{3}{2} \\\\ \\frac{2}{3} & 2\\end{aligned}],\\,Q=[\\begin{aligned}1 & 0 & -1 \\\\ 0 & 1 & -1 \\\\ -1 & -1 & 0\\end{aligned}],\\,R=[\\begin{aligned}4 & \\sqrt{2} & \\sqrt{3} \\\\ \\sqrt{3} & 0 & 1 \\\\ \\sqrt{2} & 1 & -1\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nQ=[\\begin{aligned}3 & \\frac{3}{2} \\\\ \\frac{2}{3} & 2\\end{aligned}]\n$$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=[\\begin{aligned}4 & \\sqrt{2} & \\sqrt{3} \\\\ \\sqrt{3} & 0 & 1 \\\\ \\sqrt{2} & 1 & -1\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$Q$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0a31ec00-00a0-53b4-8edd-192981b182da"] :db/ensure [:question/validate]} {:db/id "answer-field-0a31ec00-00a0-53b4-8edd-192981b182da" :answer-field/id #uuid "0a31ec00-00a0-53b4-8edd-192981b182da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1c461c57-99a8-539a-b47d-fbbf020a7142" :answer-field/choices ["answer-b860347c-0d9d-588a-96b1-6792b23d38ee" "answer-774b5e57-0730-5cba-97ab-47239dd7c8ff" "answer-f5b378b5-639b-5712-8c19-40d90b345778" "answer-1c461c57-99a8-539a-b47d-fbbf020a7142" "answer-9f141855-904b-5f36-b907-0adae53edccc"] :db/ensure [:answer-field/validate]} {:db/id "answer-b860347c-0d9d-588a-96b1-6792b23d38ee" :answer/id #uuid "b860347c-0d9d-588a-96b1-6792b23d38ee" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-774b5e57-0730-5cba-97ab-47239dd7c8ff" :answer/id #uuid "774b5e57-0730-5cba-97ab-47239dd7c8ff" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-f5b378b5-639b-5712-8c19-40d90b345778" :answer/id #uuid "f5b378b5-639b-5712-8c19-40d90b345778" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-1c461c57-99a8-539a-b47d-fbbf020a7142" :answer/id #uuid "1c461c57-99a8-539a-b47d-fbbf020a7142" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-9f141855-904b-5f36-b907-0adae53edccc" :answer/id #uuid "9f141855-904b-5f36-b907-0adae53edccc" :answer/type :answer.type/text :answer/value "None of the matrices are symmetric" :db/ensure [:answer/validate]} {:db/id "question-d897469f-7656-5297-824e-0adce50d0f86" :question/id #uuid "d897469f-7656-5297-824e-0adce50d0f86" :question/math-academy-id "q-93990" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 3 & 0 \\\\ 2 & 0 & 7\\end{aligned}],\\,Q=[\\begin{aligned}-1 & 0 \\\\ 0 & 2\\end{aligned}],\\,R=[\\begin{aligned}-2 & -1 & 3 \\\\ -1 & 1 & 0 \\\\ 3 & 0 & -1\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$P,$ $Q,$ and $R.$\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6bfed8e4-2eb5-53f3-a595-09aab6d29d72"] :db/ensure [:question/validate]} {:db/id "answer-field-6bfed8e4-2eb5-53f3-a595-09aab6d29d72" :answer-field/id #uuid "6bfed8e4-2eb5-53f3-a595-09aab6d29d72" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-673540be-83fd-5376-9753-b24c76d14c65" :answer-field/choices ["answer-d66b82c9-eba0-5b3e-a4b2-e6a29389bdaf" "answer-8dc4770d-34e5-5dc6-9c74-249ca7cf0eb6" "answer-673540be-83fd-5376-9753-b24c76d14c65" "answer-6770c0a5-8a16-5c3d-9ae5-5a9d1ac80546" "answer-39a0ec05-964e-5b57-9f36-6db5a9356ec3"] :db/ensure [:answer-field/validate]} {:db/id "answer-d66b82c9-eba0-5b3e-a4b2-e6a29389bdaf" :answer/id #uuid "d66b82c9-eba0-5b3e-a4b2-e6a29389bdaf" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-8dc4770d-34e5-5dc6-9c74-249ca7cf0eb6" :answer/id #uuid "8dc4770d-34e5-5dc6-9c74-249ca7cf0eb6" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-673540be-83fd-5376-9753-b24c76d14c65" :answer/id #uuid "673540be-83fd-5376-9753-b24c76d14c65" :answer/type :answer.type/text :answer/value "$P,$ $Q,$ and $R$" :db/ensure [:answer/validate]} {:db/id "answer-6770c0a5-8a16-5c3d-9ae5-5a9d1ac80546" :answer/id #uuid "6770c0a5-8a16-5c3d-9ae5-5a9d1ac80546" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-39a0ec05-964e-5b57-9f36-6db5a9356ec3" :answer/id #uuid "39a0ec05-964e-5b57-9f36-6db5a9356ec3" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "question-e09bb1cf-2314-567d-8f07-99c777c75c71" :question/id #uuid "e09bb1cf-2314-567d-8f07-99c777c75c71" :question/math-academy-id "q-93986" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}],\\,Q=[\\begin{aligned}1 & -2 \\\\ 2 & 3\\end{aligned}],\\,R=[\\begin{aligned}0 & 1 & 5 \\\\ 1 & -1 & \\sqrt{2} \\\\ 5 & \\sqrt{2} & 2\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is *not* a symmetric matrix. Since ${p}_{12}\\ne {p}_{21},$ we obtain $P\\ne {P}^{T}.$\n\n$$\nP=[\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}]\n$$\n\n- $Q$ is *not* a symmetric matrix. Since ${q}_{12}\\ne {q}_{21},$ we obtain $Q\\ne {Q}^{T}.$\n\n$$\nQ=[\\begin{aligned}1 & -2 \\\\ 2 & 3\\end{aligned}]\n$$\n\n- $R$ is a symmetric matrix. Indeed, $R={R}^{T}.$\n\nTherefore, the correct answer is \"$R$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-81a5601c-846e-50b6-b119-42985d6b94c3"] :db/ensure [:question/validate]} {:db/id "answer-field-81a5601c-846e-50b6-b119-42985d6b94c3" :answer-field/id #uuid "81a5601c-846e-50b6-b119-42985d6b94c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47dfbbe1-a2fb-5732-a5c5-a6f9537280bb" :answer-field/choices ["answer-183f703b-ab9e-5113-9a1a-de75fd12da1f" "answer-cb2e292a-4001-5d14-8fc0-0a481cb39830" "answer-bd0b36ec-7dc3-5014-a653-3ed4fb7e64e3" "answer-28596fa1-1975-520d-9ce3-c9a1b5b59843" "answer-47dfbbe1-a2fb-5732-a5c5-a6f9537280bb"] :db/ensure [:answer-field/validate]} {:db/id "answer-183f703b-ab9e-5113-9a1a-de75fd12da1f" :answer/id #uuid "183f703b-ab9e-5113-9a1a-de75fd12da1f" :answer/type :answer.type/text :answer/value "$P$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-cb2e292a-4001-5d14-8fc0-0a481cb39830" :answer/id #uuid "cb2e292a-4001-5d14-8fc0-0a481cb39830" :answer/type :answer.type/text :answer/value "$P$ only" :db/ensure [:answer/validate]} {:db/id "answer-bd0b36ec-7dc3-5014-a653-3ed4fb7e64e3" :answer/id #uuid "bd0b36ec-7dc3-5014-a653-3ed4fb7e64e3" :answer/type :answer.type/text :answer/value "$Q$ and $R$ only" :db/ensure [:answer/validate]} {:db/id "answer-28596fa1-1975-520d-9ce3-c9a1b5b59843" :answer/id #uuid "28596fa1-1975-520d-9ce3-c9a1b5b59843" :answer/type :answer.type/text :answer/value "$Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-47dfbbe1-a2fb-5732-a5c5-a6f9537280bb" :answer/id #uuid "47dfbbe1-a2fb-5732-a5c5-a6f9537280bb" :answer/type :answer.type/text :answer/value "$R$ only" :db/ensure [:answer/validate]} {:db/id "question-30380c91-5652-5051-8810-4fc9abb6a29f" :question/id #uuid "30380c91-5652-5051-8810-4fc9abb6a29f" :question/math-academy-id "q-96590" :question/problem "Which of the following statements are true?\n\nI. If $A$ is symmetric, then ${A}^{2}$ is always symmetric.\n\nII. The sum of *any* two $n\\times n$ matrices is always symmetric.\n\nIII. If $A$ is *any*  $n\\times n$ matrix, then $A+{A}^{T}$ is always symmetric." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, for any symmetric matrix $A,$ we have \n\n$$\n\\begin{aligned}(AA)^{T} & ={A}^{T}{A}^{T} \\\\  & =AA.\\end{aligned}\n$$\n\n- Statement II is false. As a counterexample, consider the matrices \n\n$\\,$ $A=[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}].$ \n\nHowever, their sum is not symmetric:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}1 & -1 \\\\ 1 & 0\\end{aligned}]+[\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]\\end{aligned}\n$$\n\n- Statement III is true. Indeed, for any square matrix $A,$ we have \n\n$$\n\\begin{aligned}(A+{A}^{T})^{T} & ={A}^{T}+({A}^{T})^{T} \\\\  & ={A}^{T}+A \\\\  & =A+{A}^{T}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eb0da733-cf1a-5325-b833-cf95bff8f2c4"] :db/ensure [:question/validate]} {:db/id "answer-field-eb0da733-cf1a-5325-b833-cf95bff8f2c4" :answer-field/id #uuid "eb0da733-cf1a-5325-b833-cf95bff8f2c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f03372e0-a80f-5ce3-be33-01eb134fd706" :answer-field/choices ["answer-c181f6a6-71bb-5baa-8eb0-ca45258a0bd6" "answer-f03372e0-a80f-5ce3-be33-01eb134fd706" "answer-420f0e3f-ae88-5ea1-9342-70b2782bdeca" "answer-f74b165b-f694-5acb-9521-3d180379c521" "answer-0088cf88-e8db-569b-9c4c-21c1044a712c"] :db/ensure [:answer-field/validate]} {:db/id "answer-c181f6a6-71bb-5baa-8eb0-ca45258a0bd6" :answer/id #uuid "c181f6a6-71bb-5baa-8eb0-ca45258a0bd6" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f03372e0-a80f-5ce3-be33-01eb134fd706" :answer/id #uuid "f03372e0-a80f-5ce3-be33-01eb134fd706" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-420f0e3f-ae88-5ea1-9342-70b2782bdeca" :answer/id #uuid "420f0e3f-ae88-5ea1-9342-70b2782bdeca" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-f74b165b-f694-5acb-9521-3d180379c521" :answer/id #uuid "f74b165b-f694-5acb-9521-3d180379c521" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-0088cf88-e8db-569b-9c4c-21c1044a712c" :answer/id #uuid "0088cf88-e8db-569b-9c4c-21c1044a712c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186163222 :tutorial/content "A square matrix $A$ is **symmetric** if it is equal to its transpose:\n\n$$\nA^T = A\n$$\n\nEquivalently, an $n\\times n$ matrix is symmetric if $a_{ij} = a_{ji}$ for all $1 \\leq i,j\\leq n.$\n\nIf $A$ is symmetric, this really means that it is symmetric across its main diagonal. \n\nFor example, the matrix \n\n![](images/0f/0f62a89f8da1ab7bfb86d46fddb441e95e5e3a9554e5a88662691b4df40e19af.svg)\n\nis symmetric since $A^T = A.$ \n\nOn the other hand, the matrix \n\n![](images/78/780de3c3f66b1037e4152224f4aa98b65b8b1b859adfe7c3881bb830d7eecd66.svg)\n\nis not symmetric. Indeed, since $b_{12} \\neq b_{21},$ we have $B^T \\neq B.$" :db/ensure [:tutorial/validate]} {:db/id 17592186163254 :tutorial/content "Suppose that $A$ is a symmetric matrix. Then, we have the following properties:\n\n- $-A$ is symmetric\n\n- $A^m$ is symmetric for any positive integer $m$\n\n- $A^{-1}$ is symmetric for nonsingular $A$\n\nIf $A$ and $B$ are $n\\times n$ symmetric matrices, we have the following properties:\n\n- $A+B$ is symmetric\n\n- The product $A\\cdot B$ is *not* always symmetric. For example, if \n![](images/e4/e41d28b6c6562ada530024fe6ab29cc16447dce14b2f741b8b35758618c78103.svg)\nthen the product $A\\cdot B$ is\n\n$$\n\\begin{aligned}A\\cdot B & =[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 0\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}]\\,\\,\\times \\end{aligned}\n$$\n\n \nwhich is *not* symmetric.\n\nFinally, the following two properties can be used to construct symmetric matrices:\n\n- $A + A^T$ is symmetric for any *square* matrix $A$\n\n- $A^T A$ and $A A^T$ are symmetric for *any* matrix $A$\n\nThe last property is true for *any* $m\\times n$ matrix. This property is particularly useful, as we'll discover in future lessons." :db/ensure [:tutorial/validate]} {:db/id 17592186162214 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186184219 :knowledge-point/questions ["question-fa527559-21f3-5088-ac1e-a7d1439bef18" "question-fb06ba3d-1b9f-5681-af01-0922516167aa"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184172 :knowledge-point/questions ["question-e3a4804f-9ed9-56b0-80c9-162f94bd57af" "question-128f0273-6319-516f-a4e8-3d58e084f0a9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186184071 :question/problem "Which of the following statements are true given that $A$ is a $3 \\times 3$ matrix, and  ![](images/a7/a7171d7bdd2b5c79b55ce6bd204e36304640468bd2ad533ac4032cd5a4ddc2ae.svg) \n\nI. $\\textrm{rank}(A)=1$\n\nII. $A$ is invertible\n\nIII. $\\textrm{Col}(A)$ is a $2$-dimensional subspace of $\\Bbb R^3$" :question/worked-solution "Since $A$ is a $3 \\times 3$ matrix, the invertible matrix theorem states the following:\n\n![](images/ab/ab1cd4be22e0d3344318108914d506f9fc259446654eefff94a36d38afac3f8b.svg)\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\textrm{rank}(A) + \\textrm{nullity}(A) = n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, we have that \n![](images/e7/e7660dfd412f13c5d20dd9e77ec439cdbf2916ebfbccc383d13b5f9ed4032cda.svg) \nwhich means that $\\textrm{nullity}(A) =2.$\n\nNow,  for the matrix $A,$ the number of columns is $n = 3,$ so according to the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =3 \\\\ \\text{rank}(A) & =3-2 \\\\  & =1.\\end{aligned}\n$$\n\n- Statement II is false. Since $\\textrm{nullity}(A) = 2 \\neq 0,$ then by the invertible matrix theorem, $A$ cannot be an invertible matrix.\n\n- Statement III is false. Since $\\textrm{rank}(A) = 1,$ we have that $\\textrm{Col}(A)$ is a $1$-dimensional subspace of $\\Bbb R^3.$\n\nTherefore, the correct answer is \"I only.\"" :db/ensure [:question/validate]} {:db/id "question-fa527559-21f3-5088-ac1e-a7d1439bef18" :question/id #uuid "fa527559-21f3-5088-ac1e-a7d1439bef18" :question/math-academy-id "q-142483" :question/problem "Consider a $8\\times 8$ matrix $A.$ If $\\text{rank}(A)=5$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 5+\\text{nullity}(A) & =8 \\\\ \\text{nullity}(A) & =8-5 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-de313b80-7984-512b-bdaf-802f9aba6f00"] :db/ensure [:question/validate]} {:db/id "answer-field-de313b80-7984-512b-bdaf-802f9aba6f00" :answer-field/id #uuid "de313b80-7984-512b-bdaf-802f9aba6f00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f377ec9-9056-50a3-a0c3-3e7c1dc006c7" :answer-field/choices ["answer-8879e74f-52fc-547b-ac4e-229ffb4a243b" "answer-2624dee0-0e9d-5954-b17a-630c9c03b623" "answer-76d6b8cf-388a-5474-aaf8-b2cb995a67ab" "answer-4f377ec9-9056-50a3-a0c3-3e7c1dc006c7" "answer-94b18bfb-620b-57f0-83d6-6c6dd32ac223"] :db/ensure [:answer-field/validate]} {:db/id "answer-8879e74f-52fc-547b-ac4e-229ffb4a243b" :answer/id #uuid "8879e74f-52fc-547b-ac4e-229ffb4a243b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-2624dee0-0e9d-5954-b17a-630c9c03b623" :answer/id #uuid "2624dee0-0e9d-5954-b17a-630c9c03b623" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-76d6b8cf-388a-5474-aaf8-b2cb995a67ab" :answer/id #uuid "76d6b8cf-388a-5474-aaf8-b2cb995a67ab" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-4f377ec9-9056-50a3-a0c3-3e7c1dc006c7" :answer/id #uuid "4f377ec9-9056-50a3-a0c3-3e7c1dc006c7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-94b18bfb-620b-57f0-83d6-6c6dd32ac223" :answer/id #uuid "94b18bfb-620b-57f0-83d6-6c6dd32ac223" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-fb06ba3d-1b9f-5681-af01-0922516167aa" :question/id #uuid "fb06ba3d-1b9f-5681-af01-0922516167aa" :question/math-academy-id "q-142484" :question/problem "Consider a $8\\times 10$ matrix $A.$ If $\\text{rank}(A)=7$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=10.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 7+\\text{nullity}(A) & =10 \\\\ \\text{nullity}(A) & =10-7 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7e63c75a-0e87-5ea0-8fd9-4a7908e3c449"] :db/ensure [:question/validate]} {:db/id "answer-field-7e63c75a-0e87-5ea0-8fd9-4a7908e3c449" :answer-field/id #uuid "7e63c75a-0e87-5ea0-8fd9-4a7908e3c449" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-50c964b1-c602-5d5d-919e-df6c10f9af08" :answer-field/choices ["answer-a98b8437-83a6-540a-b465-549d1e82c697" "answer-4da61d62-968c-5325-878b-c10d9e629b68" "answer-3065f796-1624-588c-ad6c-8dc59c6f240e" "answer-50c964b1-c602-5d5d-919e-df6c10f9af08" "answer-d659b67d-8b6a-563d-897b-d4779a52e317"] :db/ensure [:answer-field/validate]} {:db/id "answer-a98b8437-83a6-540a-b465-549d1e82c697" :answer/id #uuid "a98b8437-83a6-540a-b465-549d1e82c697" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4da61d62-968c-5325-878b-c10d9e629b68" :answer/id #uuid "4da61d62-968c-5325-878b-c10d9e629b68" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-3065f796-1624-588c-ad6c-8dc59c6f240e" :answer/id #uuid "3065f796-1624-588c-ad6c-8dc59c6f240e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-50c964b1-c602-5d5d-919e-df6c10f9af08" :answer/id #uuid "50c964b1-c602-5d5d-919e-df6c10f9af08" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-d659b67d-8b6a-563d-897b-d4779a52e317" :answer/id #uuid "d659b67d-8b6a-563d-897b-d4779a52e317" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186184756 :question/problem "Consider a $6\\times 7$ matrix $A.$ If $\\text{rank}(A)=5$ then $\\text{nullity}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=7.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 5+\\text{nullity}(A) & =7 \\\\ \\text{nullity}(A) & =7-5 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186183145 :answer-field/correct 17592186183147 :db/ensure [:answer-field/validate]} {:db/id 17592186184754 :question/problem "Consider a $5\\times 8$ matrix $A.$ If $\\text{dim(Null(}A))=3,$ then $\\text{rank}(A)=$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=8.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =8 \\\\ \\text{rank}(A) & =8-3 \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186183133 :answer-field/correct 17592186183136 :db/ensure [:answer-field/validate]} {:db/id 17592186272246 :question/problem "Let $A$ be a $5\\times 7$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3},{b}_{4}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :db/ensure [:question/validate]} {:db/id 17592186184760 :question/problem "Let $A$ be a $3\\times 6$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=6,$ and since $B$ is formed by $3$ vectors, $\\text{rank}(A)=3.$ Therefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 3+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-3 \\\\ \\text{dim(Null}(A)) & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186183169 :answer-field/correct 17592186183173 :db/ensure [:answer-field/validate]} {:db/id 17592186377756 :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}]\\,|\\,\\,{x}_{1},{x}_{2},{x}_{3}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=3.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+3 & =4 \\\\ \\text{rank}(A) & =4-3 \\\\  & =1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186321066 :question/problem "Let $A$ be a $3\\times 5$ matrix. If $B=\\{{b}_{1},{b}_{2},{b}_{3}\\}$ is a basis of $\\text{Col}(A)$, find $\\text{dim(Null}(A)).$" :db/ensure [:question/validate]} {:db/id 17592186184759 :question/problem "Find $\\text{rank}(A)$ given that $\\text{Null}(A)=\\{[\\begin{aligned}2{x}_{2} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{2}+{x}_{3}\\end{aligned}]\\,|\\,\\,{x}_{2},{x}_{3}\\in R\\}.$" :question/worked-solution "According to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nFor the given matrix, we have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, since \n\n$$\n\\text{Null}(A)=\\{{x}_{2}[\\begin{aligned}2 \\\\ 1 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 1\\end{aligned}]\\,|\\,\\,{x}_{2},{x}_{3}\\in R\\}\n$$\n\nwe conclude that $\\text{nullity}(A)=2.$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =4 \\\\ \\text{rank}(A) & =4-2 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186183163 :answer-field/correct 17592186183168 :db/ensure [:answer-field/validate]} {:db/id "question-e3a4804f-9ed9-56b0-80c9-162f94bd57af" :question/id #uuid "e3a4804f-9ed9-56b0-80c9-162f94bd57af" :question/math-academy-id "q-79411" :question/problem "Which of the following statements are true given that $A$ is a $6\\times 6$ matrix which has exactly $2$ non-pivot columns?\n\nI. $A$ is  invertible\n\nII. $\\text{rank}(A)=2$\n\nIII. $\\text{nullity}(A)=2$" :question/worked-solution "Since $A$ is a $6\\times 6$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{6} \\\\  & \\text{dim(Col}(A))=6=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $A$ has $n=6$ columns and $2$ of them are non-pivot ones, it follows that    \n\n$$\n\\text{dim(Col}(A))=6-2=4\\ne 6.\n$$\n\n Thus, according to the invertible matrix theorem $A$ can't be an invertible matrix.\n\n- Statement II is false. Since $\\text{dim(Col}(A))=4$,  then $\\text{rank}(A)=4.$\n\n- Statement III is true. Indeed, since $n=6$, according to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 4+\\text{nullity}(A) & =6 \\\\ \\text{nullity}(A) & =6-4 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8ea1ac60-40da-5758-9bc0-142c36f8f6ce"] :db/ensure [:question/validate]} {:db/id "answer-field-8ea1ac60-40da-5758-9bc0-142c36f8f6ce" :answer-field/id #uuid "8ea1ac60-40da-5758-9bc0-142c36f8f6ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37b42792-707d-5224-838b-cff46365c833" :answer-field/choices ["answer-df796ca4-fa04-56be-ad9e-bc125d4ef4a0" "answer-d4a192c7-d581-5aec-87a2-1e74c429a5b6" "answer-298c6536-dd07-5d51-8c18-8ca670439c0d" "answer-5ec0644e-4274-5048-9b84-1b7e49ed7bcf" "answer-37b42792-707d-5224-838b-cff46365c833"] :db/ensure [:answer-field/validate]} {:db/id "answer-df796ca4-fa04-56be-ad9e-bc125d4ef4a0" :answer/id #uuid "df796ca4-fa04-56be-ad9e-bc125d4ef4a0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d4a192c7-d581-5aec-87a2-1e74c429a5b6" :answer/id #uuid "d4a192c7-d581-5aec-87a2-1e74c429a5b6" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-298c6536-dd07-5d51-8c18-8ca670439c0d" :answer/id #uuid "298c6536-dd07-5d51-8c18-8ca670439c0d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-5ec0644e-4274-5048-9b84-1b7e49ed7bcf" :answer/id #uuid "5ec0644e-4274-5048-9b84-1b7e49ed7bcf" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-37b42792-707d-5224-838b-cff46365c833" :answer/id #uuid "37b42792-707d-5224-838b-cff46365c833" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-128f0273-6319-516f-a4e8-3d58e084f0a9" :question/id #uuid "128f0273-6319-516f-a4e8-3d58e084f0a9" :question/math-academy-id "q-142538" :question/problem "Which of the following statements are true given that $A$ is a $5\\times 5$ matrix with $2$ pivot columns?\n\nI. $\\text{rank}(A)=4$\n\nII. $A$ is invertible\n\nIII. $\\text{nullity}(A)=3$" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nAlso, according to the rank-nullity theorem, if $A$ is a matrix with $n$ columns, then \n\n$$\n\\text{rank}(A)+\\text{nullity}(A)=n.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false.  Since $A$ has $2$ pivot columns, we have $\\text{rank}(A)=2.$\n\n- Statement II is false. For the matrix $A,$ the number of the columns is $n=5.$ Now, since $\\text{rank}(A)\\ne 5,$ then by the invertible matrix theorem, we have that $A$ is not invertible.\n\n- Statement III is true. According to  the rank-nullity theorem, we obtain\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ 2+\\text{nullity}(A) & =5 \\\\ \\text{nullity}(A) & =5-2 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the correct answer is \" III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6a6251f1-889c-581d-b906-e6b75fa33975"] :db/ensure [:question/validate]} {:db/id "answer-field-6a6251f1-889c-581d-b906-e6b75fa33975" :answer-field/id #uuid "6a6251f1-889c-581d-b906-e6b75fa33975" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8884a0e0-0a83-5ace-92f9-fb64604eefa0" :answer-field/choices ["answer-491ec8ca-40f3-5454-809e-b6b418901802" "answer-916469af-a06a-5bf7-a441-a7fdd789fe00" "answer-4bad21d3-8ccb-5f2e-b04d-bc4550a71c3a" "answer-83029887-1c17-5621-b865-840b4e1ed3fc" "answer-8884a0e0-0a83-5ace-92f9-fb64604eefa0"] :db/ensure [:answer-field/validate]} {:db/id "answer-491ec8ca-40f3-5454-809e-b6b418901802" :answer/id #uuid "491ec8ca-40f3-5454-809e-b6b418901802" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-916469af-a06a-5bf7-a441-a7fdd789fe00" :answer/id #uuid "916469af-a06a-5bf7-a441-a7fdd789fe00" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-4bad21d3-8ccb-5f2e-b04d-bc4550a71c3a" :answer/id #uuid "4bad21d3-8ccb-5f2e-b04d-bc4550a71c3a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-83029887-1c17-5621-b865-840b4e1ed3fc" :answer/id #uuid "83029887-1c17-5621-b865-840b4e1ed3fc" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-8884a0e0-0a83-5ace-92f9-fb64604eefa0" :answer/id #uuid "8884a0e0-0a83-5ace-92f9-fb64604eefa0" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186185320 :tutorial/content "When we reduce a matrix to row echelon form, the number of *pivot* columns plus the number of *non-pivot* columns always equals the total number of columns of the matrix. \n\nBy translating this into the language of vector spaces, we get the **rank-nullity theorem**. The rank-nullity theorem relates the rank of a matrix to the dimension of its null space:\n\n*Let $A$ be a matrix (not necessarily square) with $n$ columns. Then,*\n\n$$\n\\textrm{dim(Col}(A)) + \\textrm{dim(Null}(A)) = \\textrm{dim}(\\mathbb{R}^n),\n$$\n\n*or, equivalently,*\n\n$$\n\\textrm{rank}(A) + \\textrm{nullity}(A) = n.\n$$\n\nFor example, suppose that for some matrix $A,$ we have\n\n![](images/30/30f6472f02a4ac47f285fff05e0cdbf56367acdd18231271dc3dccf0040901bd.svg)\n\nWe can use the rank-nullity theorem to calculate $\\textrm{rank}(A).$\n\nIn this case, we must have $n=4,$ since this is the number of components in each of the vectors of the null space. \n\nAlso, we must have $\\textrm{nullity}(A)=2,$ since \n![](images/b5/b5f38590a71a2f8e1f29a5ba98920a10037737c1ebcbd3fd60f08a3e47555141.svg)\n\nTherefore, using the rank-nullity theorem, we have\n\n$$\n\\begin{aligned}\\text{rank}(A)+\\text{nullity}(A) & =n \\\\ \\text{rank}(A)+2 & =4 \\\\ \\text{rank}(A) & =4-2 \\\\  & =2.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186184421 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
