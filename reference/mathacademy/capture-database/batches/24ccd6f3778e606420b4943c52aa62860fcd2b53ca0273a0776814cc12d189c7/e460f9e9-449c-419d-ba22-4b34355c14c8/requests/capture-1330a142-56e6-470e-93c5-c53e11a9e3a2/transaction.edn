-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f868f94-e3de-577d-92ae-da3eee235b05" :answer-field/choices ["answer-573bfd75-87ea-5d70-bdde-ef0ae1843642" "answer-3611d283-6e25-5dfb-a7c1-0f1ff407d90f" "answer-9f868f94-e3de-577d-92ae-da3eee235b05" "answer-278d6804-ad2c-5ac9-91da-3ca3b0cbce26" "answer-a8c08e11-f0f2-5824-87af-6581abace820"] :db/ensure [:answer-field/validate]} {:db/id "answer-573bfd75-87ea-5d70-bdde-ef0ae1843642" :answer/id #uuid "573bfd75-87ea-5d70-bdde-ef0ae1843642" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-3611d283-6e25-5dfb-a7c1-0f1ff407d90f" :answer/id #uuid "3611d283-6e25-5dfb-a7c1-0f1ff407d90f" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-9f868f94-e3de-577d-92ae-da3eee235b05" :answer/id #uuid "9f868f94-e3de-577d-92ae-da3eee235b05" :answer/type :answer.type/math :answer/value "81" :db/ensure [:answer/validate]} {:db/id "answer-278d6804-ad2c-5ac9-91da-3ca3b0cbce26" :answer/id #uuid "278d6804-ad2c-5ac9-91da-3ca3b0cbce26" :answer/type :answer.type/math :answer/value "\\frac{1}{27}" :db/ensure [:answer/validate]} {:db/id "answer-a8c08e11-f0f2-5824-87af-6581abace820" :answer/id #uuid "a8c08e11-f0f2-5824-87af-6581abace820" :answer/type :answer.type/math :answer/value "\\frac{1}{81}" :db/ensure [:answer/validate]} {:db/id "question-d02b196c-7964-5a35-ad18-39ecb861ac94" :question/id #uuid "d02b196c-7964-5a35-ad18-39ecb861ac94" :question/math-academy-id "q-100388" :question/problem "${({(\\frac{1}{2})}^{2})}^{-4}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({(\\frac{1}{2})}^{2})}^{-4}={(\\frac{1}{2})}^{2\\cdot (-4)}={(\\frac{1}{2})}^{-8}\n$$\n\nTo evaluate ${(\\frac{1}{2})}^{-8},$ we find the reciprocal of the base $\\frac{1}{2}$ and then raise that reciprocal to the same power but with the opposite sign:\n\n$$\n{(\\frac{1}{2})}^{-8}={2}^{8}=256\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d9514d09-69aa-5aee-8c9d-3e1f675180bd"] :db/ensure [:question/validate]} {:db/id "answer-field-d9514d09-69aa-5aee-8c9d-3e1f675180bd" :answer-field/id #uuid "d9514d09-69aa-5aee-8c9d-3e1f675180bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4c40c928-474e-5fcd-96e6-d0ce3aef77a9" :answer-field/choices ["answer-4c40c928-474e-5fcd-96e6-d0ce3aef77a9" "answer-caa97124-d2a3-5455-acf8-11d5f0b9b929" "answer-9d3ad9ee-c476-5e5a-a69b-52fd8a0b2b1d" "answer-b94c40cc-5cbd-5681-955d-1efa9075e827" "answer-68e74ddf-5b48-58b7-a653-55ecc87fcc23"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c40c928-474e-5fcd-96e6-d0ce3aef77a9" :answer/id #uuid "4c40c928-474e-5fcd-96e6-d0ce3aef77a9" :answer/type :answer.type/math :answer/value "256" :db/ensure [:answer/validate]} {:db/id "answer-caa97124-d2a3-5455-acf8-11d5f0b9b929" :answer/id #uuid "caa97124-d2a3-5455-acf8-11d5f0b9b929" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-9d3ad9ee-c476-5e5a-a69b-52fd8a0b2b1d" :answer/id #uuid "9d3ad9ee-c476-5e5a-a69b-52fd8a0b2b1d" :answer/type :answer.type/math :answer/value "\\frac{1}{256}" :db/ensure [:answer/validate]} {:db/id "answer-b94c40cc-5cbd-5681-955d-1efa9075e827" :answer/id #uuid "b94c40cc-5cbd-5681-955d-1efa9075e827" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-68e74ddf-5b48-58b7-a653-55ecc87fcc23" :answer/id #uuid "68e74ddf-5b48-58b7-a653-55ecc87fcc23" :answer/type :answer.type/math :answer/value "\\frac{1}{64}" :db/ensure [:answer/validate]} {:db/id 17592186100960 :knowledge-point/questions ["question-978d0300-c7f9-5a68-9e89-1cdeb54f80bf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-978d0300-c7f9-5a68-9e89-1cdeb54f80bf" :question/id #uuid "978d0300-c7f9-5a68-9e89-1cdeb54f80bf" :question/math-academy-id "q-141293" :question/problem "${({9}^{-4})}^{3}=$" :question/worked-solution "To raise a power to another power, we simply multiply the exponents:\n\n$$\n{({9}^{-4})}^{3}={9}^{(-4)\\cdot 3}={9}^{-12}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f14a87c0-d612-5439-9dd2-088dab25a966"] :db/ensure [:question/validate]} {:db/id "answer-field-f14a87c0-d612-5439-9dd2-088dab25a966" :answer-field/id #uuid "f14a87c0-d612-5439-9dd2-088dab25a966" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ee6a70b-b616-56be-8bcf-73082f37284e" :answer-field/choices ["answer-8ee6a70b-b616-56be-8bcf-73082f37284e" "answer-686a2273-2853-5f5d-8366-8009f3d02fa4" "answer-4f31c31f-2b4b-5d8f-8a51-982f370660e3" "answer-34d16f9e-d2cd-5b44-a4c0-add6f7687996" "answer-7e7cf3b8-2ba4-5a59-b901-ba6c46527100"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ee6a70b-b616-56be-8bcf-73082f37284e" :answer/id #uuid "8ee6a70b-b616-56be-8bcf-73082f37284e" :answer/type :answer.type/math :answer/value "{9}^{-12}" :db/ensure [:answer/validate]} {:db/id "answer-686a2273-2853-5f5d-8366-8009f3d02fa4" :answer/id #uuid "686a2273-2853-5f5d-8366-8009f3d02fa4" :answer/type :answer.type/math :answer/value "{9}^{-1}" :db/ensure [:answer/validate]} {:db/id "answer-4f31c31f-2b4b-5d8f-8a51-982f370660e3" :answer/id #uuid "4f31c31f-2b4b-5d8f-8a51-982f370660e3" :answer/type :answer.type/math :answer/value "{9}^{-7}" :db/ensure [:answer/validate]} {:db/id "answer-34d16f9e-d2cd-5b44-a4c0-add6f7687996" :answer/id #uuid "34d16f9e-d2cd-5b44-a4c0-add6f7687996" :answer/type :answer.type/math :answer/value "{9}^{12}" :db/ensure [:answer/validate]} {:db/id "answer-7e7cf3b8-2ba4-5a59-b901-ba6c46527100" :answer/id #uuid "7e7cf3b8-2ba4-5a59-b901-ba6c46527100" :answer/type :answer.type/math :answer/value "{9}^{7}" :db/ensure [:answer/validate]} {:db/id "activity-091fddbe-ab7c-51fb-bdea-75d771ea6a5f" :activity/id #uuid "091fddbe-ab7c-51fb-bdea-75d771ea6a5f" :activity/title "The Power Rule for Exponents" :activity/type :activity.type/review :activity/scope 17592186050697 :activity/course 17592186046648 :activity/steps ["step-243a0607-354b-5e54-9ae1-54b0c3abe028" "step-1d161361-c4ef-544c-9c41-fd9074b5fa81" "step-7debbce3-5913-5b36-9d69-98ef3aba1e4d"] :activity/first-step "step-243a0607-354b-5e54-9ae1-54b0c3abe028" :db/ensure [:activity/validate]} {:db/id "step-243a0607-354b-5e54-9ae1-54b0c3abe028" :step/id #uuid "243a0607-354b-5e54-9ae1-54b0c3abe028" :step/content "question-79c1f428-3f0c-56d7-8ace-b8cfe3cf2061" :step/next "step-1d161361-c4ef-544c-9c41-fd9074b5fa81" :db/ensure [:step/validate]} {:db/id "step-1d161361-c4ef-544c-9c41-fd9074b5fa81" :step/id #uuid "1d161361-c4ef-544c-9c41-fd9074b5fa81" :step/content "question-d02b196c-7964-5a35-ad18-39ecb861ac94" :step/next "step-7debbce3-5913-5b36-9d69-98ef3aba1e4d" :db/ensure [:step/validate]} {:db/id "step-7debbce3-5913-5b36-9d69-98ef3aba1e4d" :step/id #uuid "7debbce3-5913-5b36-9d69-98ef3aba1e4d" :step/content "question-978d0300-c7f9-5a68-9e89-1cdeb54f80bf" :db/ensure [:step/validate]} {:db/id 17592186073886 :knowledge-point/questions ["question-9f8b2137-ad47-5a05-9270-4407d12097e6" "question-87954c9a-1409-5d07-8491-76a8bb88c183"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073570 :question/problem "What is the missing number in the statement below?\n\n$\\qquad$ $16$ chickens in $2$ chicken coops ![](images/63/63d89cadf68ca22a5e3e0d9f6477b44a5ceda512a9d09e5496ad60268191867c.svg) chickens per chicken coop." :question/worked-solution "The ratio of the number of chickens to the number of chicken coops is ${\\color{blue}16}:{\\color{red}2}.$ So we start with the ratio $16:2$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}16}}{{\\color{red}2}}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{16 \\div 2}{2 \\div 2} = \\dfrac{8}{1} = 8\n$$\n\nSo,\n\n$\\qquad$ $16$ chickens in $2$ chicken coops $= 8$ chickens per chicken coop." :db/ensure [:question/validate]} {:db/id 17592186073887 :knowledge-point/questions ["question-6f0e951c-f617-594c-9180-7fe86b2cb1e4" "question-a2b1554d-f282-5078-95da-a93d4133cf2c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073571 :question/worked-solution "The ratio of meters to minutes that Carl walks is ${\\color{blue}450}:{\\color{red}5}.$ So we start with the ratio $450:5$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}450}}{{\\color{red}5}}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $5\\mathbin{:}$\n\n$$\n\\dfrac{{\\color{blue}450}\\div 5}{{\\color{red}5}\\div 5} = \\dfrac{{\\color{blue}90}}{{\\color{red}1}}\n$$\n\nTherefore, Carl walks at a rate of $90$ meters per minute." :db/ensure [:question/validate]} {:db/id 17592186073888 :knowledge-point/questions ["question-331d0e38-c03a-5100-b4c4-4b758a51792c" "question-585e1f16-1ef5-574f-9665-67875bdab00b" "question-b262ffc7-3f09-5b66-b29a-de72ce27ab0c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073572 :question/worked-solution "The ratio of spoken words to minutes is ${\\color{blue}400}:{\\color{red}6}.$ So we start with the ratio $400:6$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}400}}{{\\color{red}6}}\n$$\n\nWe can reduce this fraction to its lowest terms by dividing the numerator and denominator by $2\\mathbin{:}$\n\n$$\n\\dfrac{400 \\div 2}{6 \\div 2} = \\dfrac{200}{3}\n$$\n\nTherefore, Anthony said $\\dfrac{200}{3}$ words per minute." :db/ensure [:question/validate]} {:db/id 17592186073889 :knowledge-point/questions ["question-bc23fb40-881c-569e-9c33-6084a7f24a37" "question-b842ef2a-5852-5df6-832b-3f42a5693c4d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073573 :question/worked-solution "The ratio of words to seconds is ${\\color{blue}3}:{\\color{red}2}.$ Expressing this as a fraction, we have:\n\n$$\n\\dfrac{{\\color{blue}3}}{{\\color{red}2}}\n$$\n\nWe can convert this fraction to a decimal by multiplying the numerator and denominator by $5{:}$\n\n$$\n\\dfrac{3 \\times 5}{2 \\times 5} = \\dfrac{15}{10} = 1.5\n$$\n\nTherefore, Donald writes $1.5$ words per second." :db/ensure [:question/validate]} {:db/id "question-9f8b2137-ad47-5a05-9270-4407d12097e6" :question/id #uuid "9f8b2137-ad47-5a05-9270-4407d12097e6" :question/math-academy-id "q-60443" :question/problem "What is the missing number in the statement below?\n\n$\\,$ $12$ dogs in $6$ houses $=\\boxed{}\\,$  dogs per house." :question/worked-solution "The ratio of the number of dogs to the number of houses is $12:6.$ So we start with the ratio $12:6$ and write it as a fraction:\n\n$$\n\\frac{12}{6}\n$$\n\nWe can make a denominator of $1$ by dividing the numerator and denominator by $6$:\n\n$$\n\\frac{12÷6}{6÷6}=\\frac{2}{1}=2\n$$\n\nSo, $12$ dogs in $6$ houses $=2$ dogs per house." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-73610036-a1a4-5bf7-9d7a-8e6125581598"] :db/ensure [:question/validate]} {:db/id "answer-field-73610036-a1a4-5bf7-9d7a-8e6125581598" :answer-field/id #uuid "73610036-a1a4-5bf7-9d7a-8e6125581598" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-72f30f80-74ed-518b-9c77-1c7612c6c717" :answer-field/choices ["answer-e0a03635-3ade-5366-99b2-98f3f4c173c2" "answer-72f30f80-74ed-518b-9c77-1c7612c6c717" "answer-67b97843-75c1-593d-b940-962f1ba95bec" "answer-f9c3aade-0f21-5bed-aa27-2941dff6fd2c" "answer-9289824a-7f1f-599f-b0a1-505054751089"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0a03635-3ade-5366-99b2-98f3f4c173c2" :answer/id #uuid "e0a03635-3ade-5366-99b2-98f3f4c173c2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-72f30f80-74ed-518b-9c77-1c7612c6c717" :answer/id #uuid "72f30f80-74ed-518b-9c77-1c7612c6c717" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer