}{7})+{(\\frac{6}{7})}^{6}(\\frac{1}{7}) \\\\  & ≈0.1999.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-492d4a9f-68c9-53ae-b5eb-ce8b350b7da0"] :db/ensure [:question/validate]} {:db/id "answer-field-492d4a9f-68c9-53ae-b5eb-ce8b350b7da0" :answer-field/id #uuid "492d4a9f-68c9-53ae-b5eb-ce8b350b7da0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac5e747c-e311-5a20-b8ad-96d90a15c10b" :answer-field/choices ["answer-3ed878e3-0f93-5c46-9db6-c4306f74717d" "answer-a307a07e-5741-55da-9a6e-1697fa3280b9" "answer-03707761-65ce-5e18-9eca-bdcf476813eb" "answer-ac5e747c-e311-5a20-b8ad-96d90a15c10b" "answer-b91dbe80-c8a5-59f3-ada3-cd2a7a39106b"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ed878e3-0f93-5c46-9db6-c4306f74717d" :answer/id #uuid "3ed878e3-0f93-5c46-9db6-c4306f74717d" :answer/type :answer.type/math :answer/value "0.1815" :db/ensure [:answer/validate]} {:db/id "answer-a307a07e-5741-55da-9a6e-1697fa3280b9" :answer/id #uuid "a307a07e-5741-55da-9a6e-1697fa3280b9" :answer/type :answer.type/math :answer/value "0.1871" :db/ensure [:answer/validate]} {:db/id "answer-03707761-65ce-5e18-9eca-bdcf476813eb" :answer/id #uuid "03707761-65ce-5e18-9eca-bdcf476813eb" :answer/type :answer.type/math :answer/value "0.1905" :db/ensure [:answer/validate]} {:db/id "answer-ac5e747c-e311-5a20-b8ad-96d90a15c10b" :answer/id #uuid "ac5e747c-e311-5a20-b8ad-96d90a15c10b" :answer/type :answer.type/math :answer/value "0.1999" :db/ensure [:answer/validate]} {:db/id "answer-b91dbe80-c8a5-59f3-ada3-cd2a7a39106b" :answer/id #uuid "b91dbe80-c8a5-59f3-ada3-cd2a7a39106b" :answer/type :answer.type/math :answer/value "0.2087" :db/ensure [:answer/validate]} {:db/id "question-2f7bb618-1c74-5b28-8d56-423cfe55dc4d" :question/id #uuid "2f7bb618-1c74-5b28-8d56-423cfe55dc4d" :question/math-academy-id "q-97152" :question/problem "Given that $X∼\\text{Geom}(0.72),$ compute $P(6\\le X\\le 10)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.72),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.28)}^{x-1}(0.72), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(6\\le X\\le 10) & =P(X\\in \\{6,7,8,9,10\\}) \\\\  & =P(X=6)+P(X=7)+P(X=8)+P(X=9)+P(X=10) \\\\  & =f(6)+f(7)+f(8)+f(9)+f(10) \\\\  & ={(0.28)}^{5}(0.72)+{(0.28)}^{6}(0.72)+{(0.28)}^{7}(0.72)+{(0.28)}^{8}(0.72)+{(0.28)}^{9}(0.72) \\\\  & ≈0.0017.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-10c44bd4-e5a8-53e6-878a-f99c376f2371"] :db/ensure [:question/validate]} {:db/id "answer-field-10c44bd4-e5a8-53e6-878a-f99c376f2371" :answer-field/id #uuid "10c44bd4-e5a8-53e6-878a-f99c376f2371" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3fc3ec47-e3b7-5812-9ccd-1ec442151913" :answer-field/choices ["answer-bf3ed638-83db-5fce-82cc-aa5c28d1a61f" "answer-cef9b7ec-254a-5349-b752-4905e271220e" "answer-3fc3ec47-e3b7-5812-9ccd-1ec442151913" "answer-1c7a9138-e3f2-59f5-a659-d453de3f4659" "answer-fa1f0722-af81-5137-879e-0be71580c8d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf3ed638-83db-5fce-82cc-aa5c28d1a61f" :answer/id #uuid "bf3ed638-83db-5fce-82cc-aa5c28d1a61f" :answer/type :answer.type/math :answer/value "0.0005" :db/ensure [:answer/validate]} {:db/id "answer-cef9b7ec-254a-5349-b752-4905e271220e" :answer/id #uuid "cef9b7ec-254a-5349-b752-4905e271220e" :answer/type :answer.type/math :answer/value "0.0012" :db/ensure [:answer/validate]} {:db/id "answer-3fc3ec47-e3b7-5812-9ccd-1ec442151913" :answer/id #uuid "3fc3ec47-e3b7-5812-9ccd-1ec442151913" :answer/type :answer.type/math :answer/value "0.0017" :db/ensure [:answer/validate]} {:db/id "answer-1c7a9138-e3f2-59f5-a659-d453de3f4659" :answer/id #uuid "1c7a9138-e3f2-59f5-a659-d453de3f4659" :answer/type :answer.type/math :answer/value "0.0056" :db/ensure [:answer/validate]} {:db/id "answer-fa1f0722-af81-5137-879e-0be71580c8d4" :answer/id #uuid "fa1f0722-af81-5137-879e-0be71580c8d4" :answer/type :answer.type/math :answer/value "0.0087" :db/ensure [:answer/validate]} {:db/id "question-409b1f60-69c1-5499-92f9-7ef6676bbb2d" :question/id #uuid "409b1f60-69c1-5499-92f9-7ef6676bbb2d" :question/math-academy-id "q-130240" :question/problem "Given $X∼\\text{Geom}(0.9),$ compute $P(X>4).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.9),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(0.1)^{x-1}(0.9), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>4.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X>4) & =1-P(X\\le 4)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 4) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & =(0.1)^{0}(0.9)+(0.1)^{1}(0.9)+(0.1)^{2}(0.9)+(0.1)^{3}(0.9) \\\\  & =0.9999.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>4) & =1-P(X\\le 4) \\\\  & =1-0.9999 \\\\  & =0.0001.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1cf79bbd-87e9-5932-996b-d7506f0bd20e"] :db/ensure [:question/validate]} {:db/id "answer-field-1cf79bbd-87e9-5932-996b-d7506f0bd20e" :answer-field/id #uuid "1cf79bbd-87e9-5932-996b-d7506f0bd20e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-388a44e1-09c9-5049-b06d-9b541bad14cb" :answer-field/choices ["answer-388a44e1-09c9-5049-b06d-9b541bad14cb" "answer-81f8b757-ab50-560b-84f0-4b171b81f5da" "answer-09dd5e08-c7b9-5be8-a4d3-f4cc107331c4" "answer-322e9559-5dc4-5f4e-9715-244d5740f1d5" "answer-10deaade-3a9c-5ec3-bc56-7264acd0d86c"] :db/ensure [:answer-field/validate]} {:db/id "answer-388a44e1-09c9-5049-b06d-9b541bad14cb" :answer/id #uuid "388a44e1-09c9-5049-b06d-9b541bad14cb" :answer/type :answer.type/math :answer/value "0.0001" :db/ensure [:answer/validate]} {:db/id "answer-81f8b757-ab50-560b-84f0-4b171b81f5da" :answer/id #uuid "81f8b757-ab50-560b-84f0-4b171b81f5da" :answer/type :answer.type/math :answer/value "0.001" :db/ensure [:answer/validate]} {:db/id "answer-09dd5e08-c7b9-5be8-a4d3-f4cc107331c4" :answer/id #uuid "09dd5e08-c7b9-5be8-a4d3-f4cc107331c4" :answer/type :answer.type/math :answer/value "0.099" :db/ensure [:answer/validate]} {:db/id "answer-322e9559-5dc4-5f4e-9715-244d5740f1d5" :answer/id #uuid "322e9559-5dc4-5f4e-9715-244d5740f1d5" :answer/type :answer.type/math :answer/value "0.901" :db/ensure [:answer/validate]} {:db/id "answer-10deaade-3a9c-5ec3-bc56-7264acd0d86c" :answer/id #uuid "10deaade-3a9c-5ec3-bc56-7264acd0d86c" :answer/type :answer.type/math :answer/value "0.999" :db/ensure [:answer/validate]} {:db/id "question-04c3981e-56b1-51ed-b49e-4d2d764aacc9" :question/id #uuid "04c3981e-56b1-51ed-b49e-4d2d764aacc9" :question/math-academy-id "q-335508" :question/problem "Given $X∼\\text{Geom}(\\frac{7}{8}),$ compute $P(X\\ge 3)$ round to $4$ decimal places.\n\n$P(X\\ge 3)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{7}{8}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{1}{8})}^{x-1}(\\frac{7}{8}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 3.$ However, we can simplify the computation by using the complement instead:\n\n$$\nP(X\\ge 3)=1-P(X<3)\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{1}{8})}^{0}(\\frac{7}{8})+{(\\frac{1}{8})}^{1}(\\frac{7}{8}) \\\\  & =0.984375.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & =1-0.984375 \\\\  & ≈0.0156.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-97d7b59f-a2d2-58e3-a418-18885daa2bc6"] :db/ensure [:question/validate]} {:db/id "answer-field-97d7b59f-a2d2-58e3-a418-18885daa2bc6" :answer-field/id #uuid "97d7b59f-a2d2-58e3-a418-18885daa2bc6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-30f0c895-ef08-58e6-9075-734c56d0693f" :answer-field/choices ["answer-30f0c895-ef08-58e6-9075-734c56d0693f"] :db/ensure [:answer-field/validate]} {:db/id "answer-30f0c895-ef08-58e6-9075-734c56d0693f" :answer/id #uuid "30f0c895-ef08-58e6-9075-734c56d0693f" :answer/type :answer.type/math :answer/value "0.0156" :db/ensure [:answer/validate]} {:db/id "question-f9e4e9da-f36b-5b4a-91a7-731a48c88c99" :question/id #uuid "f9e4e9da-f36b-5b4a-91a7-731a48c88c99" :question/math-academy-id "q-335524" :question/problem "Given $X∼\\text{Geom}(0.4),$ compute the **exact** value of $P(X>4).$\n\n$P(X>4)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.4),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(0.6)^{x-1}(0.4), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>4.$ However, we can simplify the computation by using the complement instead:\n\n$$\nP(X>4)=1-P(X\\le 4)\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 4) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & =(0.6)^{0}(0.4)+(0.6)^{1}(0.4)+(0.6)^{2}(0.4)+(0.6)^{3}(0.4) \\\\  & =0.8704.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>4) & =1-P(X\\le 4) \\\\  & =1-0.8704 \\\\  & =0.1296.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e3e9dd74-0fb3-5ffa-8777-7735bf525da5"] :db/ensure [:question/validate]} {:db/id "answer-field-e3e9dd74-0fb3-5ffa-8777-7735bf525da5" :answer-field/id #uuid "e3e9dd74-0fb3-5ffa-8777-7735bf525da5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4da4c70c-df85-5925-90f4-b8d117992ed7" :answer-field/choices ["answer-4da4c70c-df85-5925-90f4-b8d117992ed7"] :db/ensure [:answer-field/validate]} {:db/id "answer-4da4c70c-df85-5925-90f4-b8d117992ed7" :answer/id #uuid "4da4c70c-df85-5925-90f4-b8d117992ed7" :answer/type :answer.type/math :answer/value "0.1296" :db/ensure [:answer/validate]} {:db/id "question-c2bbdab6-51f8-5199-a746-5b96164dbacd" :question/id #uuid "c2bbdab6-51f8-5199-a746-5b96164dbacd" :question/math-academy-id "q-276116" :question/problem "Given $X∼\\text{Geom}(0.8),$ compute the **exact** value of $P(X>3).$\n\n$P(X>3)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.9),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(0.2)^{x-1}(0.8), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X>3.$ However, we can simplify the computation by using the complement instead:\n\n$$\nP(X>3)=1-P(X\\le 3)\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X\\le 3) & =P(X\\in \\{1,2,3\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3) \\\\  & =f(1)+f(2)+f(3) \\\\  & =(0.2)^{0}(0.8)+(0.2)^{1}(0.8)+(0.2)^{2}(0.8) \\\\  & =0.992.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X>3) & =1-P(X\\le 3) \\\\  & =1-0.992 \\\\  & =0.008.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4b68151b-043e-5564-8a91-ea873b4fca7a"] :db/ensure [:question/validate]} {:db/id "answer-field-4b68151b-043e-5564-8a91-ea873b4fca7a" :answer-field/id #uuid "4b68151b-043e-5564-8a91-ea873b4fca7a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-35185109-1abd-547a-b4ce-7323baa540c2" :answer-field/choices ["answer-35185109-1abd-547a-b4ce-7323baa540c2"] :db/ensure [:answer-field/validate]} {:db/id "answer-35185109-1abd-547a-b4ce-7323baa540c2" :answer/id #uuid "35185109-1abd-547a-b4ce-7323baa540c2" :answer/type :answer.type/math :answer/value "0.008" :db/ensure [:answer/validate]} {:db/id "question-075d366c-d06a-5f72-a1db-49d33772eb88" :question/id #uuid "075d366c-d06a-5f72-a1db-49d33772eb88" :question/math-academy-id "q-130234" :question/problem "Given $X∼\\text{Geom}(\\frac{5}{7}),$ compute $P(X\\ge 3)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{7}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{2}{7})}^{x-1}(\\frac{5}{7}), & x=1,2,3… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nThere are infinitely many values of $X$ such that $X\\ge 3.$ However, we can simplify the computation by using the complement instead:\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3)\\end{aligned}\n$$\n\nComputing the complement, we get\n\n$$\n\\begin{aligned}P(X<3) & =P(X\\in \\{1,2\\}) \\\\  & =P(X=1)+P(X=2) \\\\  & =f(1)+f(2) \\\\  & ={(\\frac{2}{7})}^{0}(\\frac{5}{7})+{(\\frac{2}{7})}^{1}(\\frac{5}{7}) \\\\  & ≈0.9184.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\ge 3) & =1-P(X<3) \\\\  & ≈1-0.9184 \\\\  & =0.0816.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5526fa50-a4a2-58c4-84bf-0839d0ec3ffd"] :db/ensure [:question/validate]} {:db/id "answer-field-5526fa50-a4a2-58c4-84bf-0839d0ec3ffd" :answer-field/id #uuid "5526fa50-a4a2-58c4-84bf-0839d0ec3ffd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c75df401-1338-550f-9685-bdbf40c3f545" :answer-field/choices ["answer-c75df401-1338-550f-9685-bdbf40c3f545" "answer-cbf65f81-805f-53f1-bb8a-3704c0abd456" "answer-0f4f0d37-31fa-580f-a61f-73b377587e0d" "answer-65c9f129-b21a-5d19-8e36-b0303bd7567e" "answer-57493273-713c-5bd8-9c9d-be6b143d9126"] :db/ensure [:answer-field/validate]} {:db/id "answer-c75df401-1338-550f-9685-bdbf40c3f545" :answer/id #uuid "c75df401-1338-550f-9685-bdbf40c3f545" :answer/type :answer.type/math :answer/value "0.0816" :db/ensure [:answer/validate]} {:db/id "answer-cbf65f81-805f-53f1-bb8a-3704c0abd456" :answer/id #uuid "cbf65f81-805f-53f1-bb8a-3704c0abd456" :answer/type :answer.type/math :answer/value "0.1837" :db/ensure [:answer/validate]} {:db/id "answer-0f4f0d37-31fa-580f-a61f-73b377587e0d" :answer/id #uuid "0f4f0d37-31fa-580f-a61f-73b377587e0d" :answer/type :answer.type/math :answer/value "0.2041" :db/ensure [:answer/validate]} {:db/id "answer-65c9f129-b21a-5d19-8e36-b0303bd7567e" :answer/id #uuid "65c9f129-b21a-5d19-8e36-b0303bd7567e" :answer/type :answer.type/math :answer/value "0.7959" :db/ensure [:answer/validate]} {:db/id "answer-57493273-713c-5bd8-9c9d-be6b143d9126" :answer/id #uuid "57493273-713c-5bd8-9c9d-be6b143d9126" :answer/type :answer.type/math :answer/value "0.9184" :db/ensure [:answer/validate]} {:db/id 17592186168075 :tutorial/content "Suppose that we have a sequence of Bernoulli trials, each resulting in success or failure, and with a probability of success $p.$ Let the random variable $X$ represent the number of Bernoulli trials *until the first success*.\n\nIt can be shown that $X$ follows a **geometric distribution** and has the following probability mass function:\n\n![](images/13/13d0eefea25458f7778607118a7673506900d72ee5b8a41826378c8737317e9e.svg)\n\nLet's break this formula down a bit:\n\n- The factor $(1-p)^{x-1}$ represents the probability of getting exactly $(x-1)$ failures, each with probability $(1-p).$\n\n- The factor ${\\color{purple}{p}}$ represents the probability of getting a single success.\n\n- The condition $x=1,2,3,\\ldots$ indicates that the sequence of Bernoulli trials terminates after a minimum of $1$ trial, and there is no maximum number of trials.\n\nIf a random variable $X$ follows a geometric distribution, we say it is a geometric random variable and  write \n\n$$\nX\\sim \\textrm{Geom}(p).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186168108 :tutorial/content "You might be wondering where the geometric distribution gets its name. The answer is that the probability mass function forms a geometric sequence! \n\nSuppose that $X\\sim \\textrm{Geom}(p).$ Then, the probability mass function for this geometric distribution is\n\n$$\n\\begin{aligned}f(x) & =(1-p)^{x-1}p \\\\ f(x) & =p(1-p)^{x-1} \\\\ {{f(x)}_{⏟}}_{{a}_{x}} & ={{p}_{⏟}}_{{a}_{1}}\\cdot ({{1-p}_{⏟}}_{r})^{x-1} \\\\ {a}_{x} & ={a}_{1}\\cdot {r}^{x-1}\\end{aligned}\n$$\n\nSo, we see that the probability mass function can be interpreted as a geometric sequence where the first term is $a_1=p,$ and the common ratio is $r=1-p.$\n\nMoreover, notice that $f(x)$ satisfies all the criteria to be a probability mass function, namely\n\n1\\. $0 \\leq f(x) \\leq 1$ for all $x$ in $S$\n\n2\\. $\\displaystyle \\sum\\limits_{x \\in S} f(x) = 1$\n\nCriterion 1 is clearly true because $0 \\leq p \\leq 1.$ \n\nTo show that criterion 2 is true, we simply need to calculate the sum of this infinite geometric series, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{x\\in S}f(x) & ={\\sum }_{x=1}^{\\infty }p(1-p)^{x-1} \\\\  & =\\frac{p}{1-(1-p)} \\\\  & =\\frac{p}{p} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $f(x)$ is indeed a probability distribution." :db/ensure [:tutorial/validate]} {:db/id 17592186167045 :activity/expected-seconds 1140.0 :db/ensure [:activity/validate]} {:db/id 17592186179652 :knowledge-point/questions ["question-9d214df3-aafe-5a52-bd67-2c23fbad240f" "question-f5d6b2e7-1b54-5bc0-b6ea-58d113518a87"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9d214df3-aafe-5a52-bd67-2c23fbad240f" :question/id #uuid "9d214df3-aafe-5a52-bd67-2c23fbad240f" :question/math-academy-id "q-34734" :question/problem "![](images/58/582236fbb64c0ebeda310cb0007435d4044295b232499ff5771ede846a1b6d05.png)\n\nWhat is the range of the function shown above?" :question/worked-solution "We find the ranges of the individual pieces, and then calculate their union:\n\n- The range of the branch defined on $x\\in [-4,-1)$ is $[0,4]$\n\n- The range of the branch defined on $x\\in [-1,1)$ is $[-2,2)$\n\nTherefore, the range of $f(x)$ is $[0,4]\\cup [-2,2)=[-2,4].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-61208644-8c5b-5f4d-81d6-4e752cb4edbf"] :db/ensure [:question/validate]} {:db/id "answer-field-61208644-8c5b-5f4d-81d6-4e752cb4edbf" :answer-field/id #uuid "61208644-8c5b-5f4d-81d6-4e752cb4edbf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-39cc2ab9-0e69-5e63-9804-2b53b2eb63cb" :answer-field/choices ["answer-5825da8a-a8cd-5ffe-bc88-0e82b360e91d" "answer-b8291b42-df3a-58f9-a0f8-316a3f99fa6a" "answer-b168c6fa-3346-5972-afe9-b5a59f8ae3c9" "answer-39cc2ab9-0e69-5e63-9804-2b53b2eb63cb" "answer-698e15a5-80be-55ee-8a03-6ab33045d444"] :db/ensure [:answer-field/validate]} {:db/id "answer-5825da8a-a8cd-5ffe-bc88-0e82b360e91d" :answer/id #uuid "5825da8a-a8cd-5ffe-bc88-0e82b360e91d" :answer/type :answer.type/math :answer/value "(-2,3)" :db/ensure [:answer/validate]} {:db/id "answer-b8291b42-df3a-58f9-a0f8-316a3f99fa6a" :answer/id #uuid "b8291b42-df3a-58f9-a0f8-316a3f99fa6a" :answer/type :answer.type/math :answer/value "[-2,0]" :db/ensure [:answer/validate]} {:db/id "answer-b168c6fa-3346-5972-afe9-b5a59f8ae3c9" :answer/id #uuid "b168c6fa-3346-5972-afe9-b5a59f8ae3c9" :answer/type :answer.type/math :answer/value "[-2,3)\\cup (3,4]" :db/ensure [:answer/validate]} {:db/id "answer-39cc2ab9-0e69-5e63-9804-2b53b2eb63cb" :answer/id #uuid "39cc2ab9-0e69-5e63-9804-2b53b2eb63cb" :answer/type :answer.type/math :answer/value "[-2,4]" :db/ensure [:answer/validate]} {:db/id "answer-698e15a5-80be-55ee-8a03-6ab33045d444" :answer/id #uuid "698e15a5-80be-55ee-8a03-6ab33045d444" :answer/type :answer.type/math :answer/value "[0,4)" :db/ensure [:answer/validate]} {:db/id 17592186179651 :knowledge-point/questions ["question-24be045a-a1e0-562b-a001-f17a0f6f12b3" "question-30dbc182-568e-5645-9ba2-4447169ef008" "question-2c426db9-03a0-51ed-9522-bdc02ff647af"] :db/ensure [:knowledge-point/validate]} {:db/id "question-24be045a-a1e0-562b-a001-f17a0f6f12b3" :question/id #uuid "24be045a-a1e0-562b-a001-f17a0f6f12b3" :question/math-academy-id "q-79997" :question/problem "![](images/ac/acbf4ae592e7912e6e27415ce99f872c4c0ec1737cfa3269635f37f7fa0fe5db.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- There is no smallest $y$-value.\n\n- The largest $y$-value is $1.$ This occurs when $x\\to -\\infty .$ However, note that this point is not included in the graph.\n\nThe function covers all the $y$-values between $-\\infty $ and $1,$ but not including $1.$\n\nTherefore, the range is $-\\infty <y<1,$ which can also be written as  $-\\infty <f(x)<1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e7dd7694-ccde-505f-9224-5e793348c4a2"] :db/ensure [:question/validate]} {:db/id "answer-field-e7dd7694-ccde-505f-9224-5e793348c4a2" :answer-field/id #uuid "e7dd7694-ccde-505f-9224-5e793348c4a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7bd4f26c-68d7-508b-ae68-df55769b27e1" :answer-field/choices ["answer-7bd4f26c-68d7-508b-ae68-df55769b27e1" "answer-a7ab8a0a-f5d1-5b79-8ad9-de72a82f973b" "answer-077fd3b6-a66f-5992-89ff-f734285036e1" "answer-85a2736a-d41e-5e05-9a88-0d47451e0a05" "answer-c20f2f3c-997e-5379-8c75-90a1c8d674a3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7bd4f26c-68d7-508b-ae68-df55769b27e1" :answer/id #uuid "7bd4f26c-68d7-508b-ae68-df55769b27e1" :answer/type :answer.type/math :answer/value "-\\infty <f(x)<1" :db/ensure [:answer/validate]} {:db/id "answer-a7ab8a0a-f5d1-5b79-8ad9-de72a82f973b" :answer/id #uuid "a7ab8a0a-f5d1-5b79-8ad9-de72a82f973b" :answer/type :answer.type/math :answer/value "-\\infty <f(x)\\le 1" :db/ensure [:answer/validate]} {:db/id "answer-077fd3b6-a66f-5992-89ff-f734285036e1" :answer/id #uuid "077fd3b6-a66f-5992-89ff-f734285036e1" :answer/type :answer.type/math :answer/value "1<f(x)<2" :db/ensure [:answer/validate]} {:db/id "answer-85a2736a-d41e-5e05-9a88-0d47451e0a05" :answer/id #uuid "85a2736a-d41e-5e05-9a88-0d47451e0a05" :answer/type :answer.type/math :answer/value "1<f(x)<\\infty " :db/ensure [:answer/validate]} {:db/id "answer-c20f2f3c-997e-5379-8c75-90a1c8d674a3" :answer/id #uuid "c20f2f3c-997e-5379-8c75-90a1c8d674a3" :answer/type :answer.type/math :answer/value "1\\le f(x)<\\infty " :db/ensure [:answer/validate]} {:db/id "question-30dbc182-568e-5645-9ba2-4447169ef008" :question/id #uuid "30dbc182-568e-5645-9ba2-4447169ef008" :question/math-academy-id "q-129372" :question/problem "![](images/eb/eb292b77908dbb4590b6bbc49c452215edd8e6668e003e0984074a7ca22bf4ff.png)\n\nWhat is the range of the function $f(x),$ shown above?" :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $0.$ This occurs when $x=2.$\n\n- There is no largest $y$-value.\n\nThe function covers all the $y$-values between $0$ and $\\infty ,$ including $0.$\n\nTherefore, the range is $0\\le y<\\infty ,$ which can also be written as  $0\\le f(x)<\\infty .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4c513d9a-67e4-587c-bfd8-0a60d03dc406"] :db/ensure [:question/validate]} {:db/id "answer-field-4c513d9a-67e4-587c-bfd8-0a60d03dc406" :answer-field/id #uuid "4c513d9a-67e4-587c-bfd8-0a60d03dc406" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6d3bfaa-3cdb-5dfc-8e12-4bf0044664fc" :answer-field/choices ["answer-1b96b9f5-5dee-542b-9536-5184c253d217" "answer-536d01f7-fbaf-515c-9cab-bbacb8844c8c" "answer-f6d3bfaa-3cdb-5dfc-8e12-4bf0044664fc" "answer-0d05cb0d-8d25-5449-ac1c-8b614908715e" "answer-61686cce-e8eb-5e02-8245-808eec7d2bd1"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b96b9f5-5dee-542b-9536-5184c253d217" :answer/id #uuid "1b96b9f5-5dee-542b-9536-5184c253d217" :answer/type :answer.type/math :answer/value "0<f(x)<\\infty " :db/ensure [:answer/validate]} {:db/id "answer-536d01f7-fbaf-515c-9cab-bbacb8844c8c" :answer/id #uuid "536d01f7-fbaf-515c-9cab-bbacb8844c8c" :answer/type :answer.type/math :answer/value "0<f(x)\\le 2" :db/ensure [:answer/validate]} {:db/id "answer-f6d3bfaa-3cdb-5dfc-8e12-4bf0044664fc" :answer/id #uuid "f6d3bfaa-3cdb-5dfc-8e12-4bf0044664fc" :answer/type :answer.type/math :answer/value "0\\le f(x)<\\infty " :db/ensure [:answer/validate]} {:db/id "answer-0d05cb0d-8d25-5449-ac1c-8b614908715e" :answer/id #uuid "0d05cb0d-8d25-5449-ac1c-8b614908715e" :answer/type :answer.type/math :answer/value "2<f(x)<\\infty " :db/ensure [:answer/validate]} {:db/id "answer-61686cce-e8eb-5e02-8245-808eec7d2bd1" :answer/id #uuid "61686cce-e8eb-5e02-8245-808eec7d2bd1" :answer/type :answer.type/math :answer/value "2\\le f(x)<\\infty " :db/ensure [:answer/validate]} {:db/id "question-2c426db9-03a0-51ed-9522-bdc02ff647af" :question/id #uuid "2c426db9-03a0-51ed-9522-bdc02ff647af" :question/math-academy-id "q-236388" :question/problem "![](images/49/49288e2c082854cfc27a2d48af2d82a96016a3c1394066471d49873e4c75878e.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\nThe range is \n{{field-1}}{{field-2}}\n$f(x)<$\n{{field-3}}." :question/worked-solution "First, we find the smallest and largest $y$-values in the graph.\n\n- The smallest $y$-value is $1.$ This occurs when $x=0.$\n\n- There is no largest $y$-value.\n\nThe function covers all the $y$-values between $1$ and $\\infty ,$ including $1.$\n\nTherefore, the range is $1\\le y<\\infty ,$ which can also be written as \n$1\\le f(x)<\\infty .$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9abeb5f8-371d-515e-a1f6-7daf65af6f1e" "answer-field-3443567b-7d91-5f03-9d4e-6b2b217a9066" "answer-field-2356dd8e-95af-53aa-99c1-588dd0a4fe73"] :db/ensure [:question/validate]} {:db/id "answer-field-9abeb5f8-371d-515e-a1f6-7daf65af6f1e" :answer-field/id #uuid "9abeb5f8-371d-515e-a1f6-7daf65af6f1e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-80e903e5-f2b3-5ed4-a09b-70f4dda6a048" :answer-field/choices ["answer-80e903e5-f2b3-5ed4-a09b-70f4dda6a048"] :db/ensure [:answer-field/validate]} {:db/id "answer-80e903e5-f2b3-5ed4-a09b-70f4dda6a048" :answer/id #uuid "80e903e5-f2b3-5ed4-a09b-70f4dda6a048" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-field-3443567b-7d91-5f03-9d4e-6b2b217a9066" :answer-field/id #uuid "3443567b-7d91-5f03-9d4e-6b2b217a9066" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-42a84cca-e35f-5c4a-b07e-845a7d28433f" :answer-field/choices ["answer-42a84cca-e35f-5c4a-b07e-845a7d28433f"] :db/ensure [:answer-field/validate]} {:db/id "answer-42a84cca-e35f-5c4a-b07e-845a7d28433f" :answer/id #uuid "42a84cca-e35f-5c4a-b07e-845a7d28433f" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-2356dd8e-95af-53aa-99c1-588dd0a4fe73" :answer-field/id #uuid "2356dd8e-95af-53aa-99c1-588dd0a4fe73" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b3e2fe1e-5ce8-5259-883a-e27ba55b0ebc" :answer-field/choices ["answer-b3e2fe1e-5ce8-5259-883a-e27ba55b0ebc"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3e2fe1e-5ce8-5259-883a-e27ba55b0ebc" :answer/id #uuid "b3e2fe1e-5ce8-5259-883a-e27ba55b0ebc" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-f5d6b2e7-1b54-5bc0-b6ea-58d113518a87" :question/id #uuid "f5d6b2e7-1b54-5bc0-b6ea-58d113518a87" :question/math-academy-id "q-236465" :question/problem "![](images/fa/fae9ac16ebabea7054903ab75f2305f98c757f8ee7fc4924600774e627ad76b4.png)\n\nWhat is the range of the function $f(x),$ shown above?\n\n$\\,$  The range is $f(x)\\in $\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "We find the ranges of the individual pieces, and then calculate their union:\n\n- The range of the branch defined on $x\\in (-3,0]$ is $[-2,0)$\n\n- The range of the branch defined on $x\\in (0,3)$ is $(1,3]$\n\nTherefore, the range of $f(x)$ is $[-2,0)\\cup (1,3].$\n\n**Note:** From the graph, we see that the values $y=0$ and $y=1$ are NOT valid outputs of the function $y=f(x).$ Therefore, we use parentheses $(…)$ instead of brackets $[…]$ at these endpoints." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c1dd13d9-fa2a-56fa-b820-f5ccac336683" "answer-field-4c1a5b0b-3cf6-5be3-bc9c-ae896e933954" "answer-field-d188c86d-e40c-5825-8f05-79c9182cde6b"] :db/ensure [:question/validate]} {:db/id "answer-field-c1dd13d9-fa2a-56fa-b820-f5ccac336683" :answer-field/id #uuid "c1dd13d9-fa2a-56fa-b820-f5ccac336683" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-f543cbe4-e2c6-5a46-b0cd-da91aa24619c" :answer-field/choices ["answer-3294b297-4b44-5f75-9b72-739bc720849c" "answer-da0ff875-c917-5972-a3c4-675de3efc1b3" "answer-f543cbe4-e2c6-5a46-b0cd-da91aa24619c" "answer-0a2e451d-3033-5f0d-89f1-815a64077872"] :db/ensure [:answer-field/validate]} {:db/id "answer-3294b297-4b44-5f75-9b72-739bc720849c" :answer/id #uuid "3294b297-4b44-5f75-9b72-739bc720849c" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-da0ff875-c917-5972-a3c4-675de3efc1b3" :answer/id #uuid "da0ff875-c917-5972-a3c4-675de3efc1b3" :answer/type :answer.type/math :answer/value "(-2,0]" :db/ensure [:answer/validate]} {:db/id "answer-f543cbe4-e2c6-5a46-b0cd-da91aa24619c" :answer/id #uuid "f543cbe4-e2c6-5a46-b0cd-da91aa24619c" :answer/type :answer.type/math :answer/value "[-2,0)" :db/ensure [:answer/validate]} {:db/id "answer-0a2e451d-3033-5f0d-89f1-815a64077872" :answer/id #uuid "0a2e451d-3033-5f0d-89f1-815a64077872" :answer/type :answer.type/math :answer/value "[-2,0]" :db/ensure [:answer/validate]} {:db/id "answer-field-4c1a5b0b-3cf6-5be3-bc9c-ae896e933954" :answer-field/id #uuid "4c1a5b0b-3cf6-5be3-bc9c-ae896e933954" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-52b3e7b8-7456-581e-bfd1-f45bbe1051d9" :answer-field/choices ["answer-3b528277-bd1d-5076-b163-8f585cd1adce" "answer-52b3e7b8-7456-581e-bfd1-f45bbe1051d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b528277-bd1d-5076-b163-8f585cd1adce" :answer/id #uuid "3b528277-bd1d-5076-b163-8f585cd1adce" :answer/type :answer.type/math :answer/value "\\cap " :db/ensure [:answer/validate]} {:db/id "answer-52b3e7b8-7456-581e-bfd1-f45bbe1051d9" :answer/id #uuid "52b3e7b8-7456-581e-bfd1-f45bbe1051d9" :answer/type :answer.type/math :answer/value "\\cup " :db/ensure [:answer/validate]} {:db/id "answer-field-d188c86d-e40c-5825-8f05-79c9182cde6b" :answer-field/id #uuid "d188c86d-e40c-5825-8f05-79c9182cde6b" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-06cf3e4b-7a20-5728-8bde-7ff22aeef87e" :answer-field/choices ["answer-7870d536-7778-52d6-b0f4-199737c42072" "answer-06cf3e4b-7a20-5728-8bde-7ff22aeef87e" "answer-3b1d3a76-5cfb-54b2-8951-80ac1e030c22" "answer-0fd8a5f6-91fd-5671-a481-b81be219a988"] :db/ensure [:answer-field/validate]} {:db/id "answer-7870d536-7778-52d6-b0f4-199737c42072" :answer/id #uuid "7870d536-7778-52d6-b0f4-199737c42072" :answer/type :answer.type/math :answer/value "(1,3)" :db/ensure [:answer/validate]} {:db/id "answer-06cf3e4b-7a20-5728-8bde-7ff22aeef87e" :answer/id #uuid "06cf3e4b-7a20-5728-8bde-7ff22aeef87e" :answer/type :answer.type/math :answer/value "(1,3]" :db/ensure [:answer/validate]} {:db/id "answer-3b1d3a76-5cfb-54b2-8951-80ac1e030c22" :answer/id #uuid "3b1d3a76-5cfb-54b2-8951-80ac1e030c22" :answer/type :answer.type/math :answer/value "[1,3)" :db/ensure [:answer/validate]} {:db/id "answer-0fd8a5f6-91fd-5671-a481-b81be219a988" :answer/id #uuid "0fd8a5f6-91fd-5671-a481-b81be219a988" :answer/type :answer.type/math :answer/value "[1,3]" :db/ensure [:answer/validate]} {:db/id "activity-a4407aef-3121-52a9-b946-f3e8ebff0a98" :activity/id #uuid "a4407aef-3121-52a9-b946-f3e8ebff0a98" :activity/title "The Range of a Function: Advanced Cases" :activity/type :activity.type/review :activity/scope 17592186050580 :activity/course 17592186046658 :activity/steps ["step-537a7146-75a4-56c9-a7db-1e94a31e5c00" "step-027ab44b-48d6-5961-8e71-f93826f26196" "step-bff636d5-d253-5f8b-b379-4b8793e7f844" "step-356e531e-4a8b-5a5a-96af-77c558013231" "step-b4b9a850-1b05-55cc-93b4-fc159fb75d80"] :activity/first-step "step-537a7146-75a4-56c9-a7db-1e94a31e5c00" :db/ensure [:activity/validate]} {:db/id "step-537a7146-75a4-56c9-a7db-1e94a31e5c00" :step/id #uuid "537a7146-75a4-56c9-a7db-1e94a31e5c00" :step/content "question-9d214df3-aafe-5a52-bd67-2c23fbad240f" :step/next "step-027ab44b-48d6-5961-8e71-f93826f26196" :db/ensure [:step/validate]} {:db/id "step-027ab44b-48d6-5961-8e71-f93826f26196" :step/id #uuid "027ab44b-48d6-5961-8e71-f93826f26196" :step/content "question-24be045a-a1e0-562b-a001-f17a0f6f12b3" :step/next "step-bff636d5-d253-5f8b-b379-4b8793e7f844" :db/ensure [:step/validate]} {:db/id "step-bff636d5-d253-5f8b-b379-4b8793e7f844" :step/id #uuid "bff636d5-d253-5f8b-b379-4b8793e7f844" :step/content "question-30dbc182-568e-5645-9ba2-4447169ef008" :step/next "step-356e531e-4a8b-5a5a-96af-77c558013231" :db/ensure [:step/validate]} {:db/id "step-356e531e-4a8b-5a5a-96af-77c558013231" :step/id #uuid "356e531e-4a8b-5a5a-96af-77c558013231" :step/content "question-2c426db9-03a0-51ed-9522-bdc02ff647af" :step/next "step-b4b9a850-1b05-55cc-93b4-fc159fb75d80" :db/ensure [:step/validate]} {:db/id "step-b4b9a850-1b05-55cc-93b4-fc159fb75d80" :step/id #uuid "b4b9a850-1b05-55cc-93b4-fc159fb75d80" :step/content "question-f5d6b2e7-1b54-5bc0-b6ea-58d113518a87" :db/ensure [:step/validate]} [:db/retract 17592186155925 :answer-field/choices 17592186155926] [:db/retract 17592186155925 :answer-field/choices 17592186155927] [:db/retract 17592186155925 :answer-field/choices 17592186155928] [:db/retract 17592186155925 :answer-field/choices 17592186155929] [:db/retract 17592186155925 :answer-field/choices 17592186155930] [:db/retract 17592186157839 :question/answer-fields 17592186155955] [:db/retract 17592186155961 :answer-field/choices 17592186155963] [:db/retract 17592186155961 :answer-field/choices 17592186155964] [:db/retract 17592186155961 :answer-field/choices 17592186155965] {:db/id 17592186157834 :question/problem "![](images/8b/8b694a0907a5cb1c33d44c921b01b8e351059ce3e695485d79b72051f7ed764a.png)\n\nThe region $D$ is enclosed between the curve ${x}^{2}+(y-1)^{2}=1$ and the line $y=1,$ as shown above. What is\n${∬}_{D}{y}^{2}\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at $(0,1).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+(y-1)^{2}=1,$ we obtain\n\n$$\n\\begin{aligned}{x}^{2}+(y-1)^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta -1)^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -2r\\operatorname{sin}⁡\\theta +1 & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{sin}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{sin}⁡\\theta .$\n\n- For $y=1,$ we get\n\n$$\n\\begin{aligned}y & =1 \\\\ r\\operatorname{sin}⁡\\theta  & =1 \\\\ r & =\\frac{1}{\\operatorname{sin}⁡\\theta } \\\\ r & =\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the points $(-1,1)$ and $(1,1).$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{\\pi }{4}$ and $\\theta =\\frac{3\\pi }{4},$ as depicted below.  \n\n![](images/68/68f70968b0dd256159dbfdcbfde4f2f63578237db1770e019c8fb19a5a638eaa.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,\\operatorname{csc}⁡\\theta \\le r\\le 2\\operatorname{sin}⁡\\theta ,\\,\\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{\\int }_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }{r}^{3}{sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta {\\int }_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186155925 :answer-field/correct "answer-cce7b078-805e-5d09-a2f3-9ad87e8072c8" :answer-field/choices ["answer-63ff2307-bdea-53b3-88e5-97b96d5ad36a" "answer-c761b339-ab83-5bb8-80db-4cc0d6bebede" "answer-6e4aa5b4-4bf8-52ba-bb0c-de13688b61cd" "answer-6d4cd776-9de6-538f-9d94-7a3efcb04fad" "answer-cce7b078-805e-5d09-a2f3-9ad87e8072c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-63ff2307-bdea-53b3-88e5-97b96d5ad36a" :answer/id #uuid "63ff2307-bdea-53b3-88e5-97b96d5ad36a" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /2}^{\\pi /2}{sin}^{2}⁡\\theta {\\int }_{\\operatorname{sin}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-c761b339-ab83-5bb8-80db-4cc0d6bebede" :answer/id #uuid "c761b339-ab83-5bb8-80db-4cc0d6bebede" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta {\\int }_{0}^{2\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6e4aa5b4-4bf8-52ba-bb0c-de13688b61cd" :answer/id #uuid "6e4aa5b4-4bf8-52ba-bb0c-de13688b61cd" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta {\\int }_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-6d4cd776-9de6-538f-9d94-7a3efcb04fad" :answer/id #uuid "6d4cd776-9de6-538f-9d94-7a3efcb04fad" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta {\\int }_{0}^{2\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-cce7b078-805e-5d09-a2f3-9ad87e8072c8" :answer/id #uuid "cce7b078-805e-5d09-a2f3-9ad87e8072c8" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta {\\int }_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id 17592186157839 :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $4$ centered at $(0,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=16,$ we obtain $r=4.$\n\n- For $x=2\\sqrt{2},$ we get\n\n$$\n\\begin{aligned}x & =2\\sqrt{2} \\\\ r\\operatorname{cos}⁡\\theta  & =2\\sqrt{2} \\\\ r & =\\frac{2\\sqrt{2}}{\\operatorname{cos}⁡\\theta } \\\\ r & =2\\sqrt{2}\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(2\\sqrt{2},2\\sqrt{2}).$ So, the entire region $D$ lies between the polar lines $\\theta =0$ and $\\theta =\\frac{\\pi }{4},$ as depicted below.  \n\n![](images/37/375e270ce444d9f62b50f9a25abfae781113fdad895833d693061ffffe93f5d3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,2\\sqrt{2}\\operatorname{sec}⁡\\theta \\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{4}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y}{x}\\,\\text{d}A & ={∬}_{Δ}\\frac{r\\operatorname{sin}⁡\\theta }{r\\operatorname{cos}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}r\\operatorname{tan}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{tan}⁡\\theta {\\int }_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}r\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186157840 :question/problem "![](images/df/dfaa18cb3295d3bb1641f440a3c1642758fe793c3605cf7d010121a68bbff47d.png)\n\nEvaluate the double integral ${∬}_{D}\\sqrt{4-{x}^{2}-{y}^{2}}\\,\\text{d}A,$ where the region $D$ in the first quadrant is enclosed between two quarter-circles centered at $O$ of radii $1$ and $2,$ as shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion between the disks of radii $1$ and $2$ centered at the origin. \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n\\{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=1,$ we obtain $r=1.$\n\n- For ${x}^{2}+{y}^{2}=4,$ we obtain $r=2.$\n\nNow, let's find the limits for the parameter $\\theta .$ The entire region lies between the radial lines $\\theta =0$ and $\\theta =\\frac{\\pi }{2},$ as depicted below.  \n\n![](images/46/4660d61851814c87afc7c140dd87e1354785f55cafe4fbc911fd369f768914e3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,1\\le r\\le 2,\\,0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{4-{x}^{2}-{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\sqrt{4-(r\\operatorname{cos}⁡\\theta )^{2}-(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{1}^{2}r\\sqrt{4-{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{[-\\frac{1}{3}(4-{r}^{2})^{3/2}]}_{1}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}-\\frac{1}{3}(0-3\\sqrt{3})\\,\\text{d}\\theta  \\\\  & =\\sqrt{3}{\\int }_{0}^{\\pi /2}\\,\\text{d}\\theta  \\\\  & =\\sqrt{3}[\\theta ]_{0}^{\\pi /2} \\\\  & =\\sqrt{3}(\\frac{\\pi }{2}-0) \\\\  & =\\frac{\\pi \\sqrt{3}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186155961 :answer-field/correct "answer-339ef220-3e41-588b-8376-adbd3ff3fd12" :answer-field/choices ["answer-a1f50510-55ec-59ec-bc2f-bcefacaba339" "answer-339ef220-3e41-588b-8376-adbd3ff3fd12" "answer-68754c06-e278-58cb-aad9-4cc8f6c4502c"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1f50510-55ec-59ec-bc2f-bcefacaba339" :answer/id #uuid "a1f50510-55ec-59ec-bc2f-bcefacaba339" :answer/type :answer.type/math :answer/value "3\\pi " :db/ensure [:answer/validate]} {:db/id "answer-339ef220-3e41-588b-8376-adbd3ff3fd12" :answer/id #uuid "339ef220-3e41-588b-8376-adbd3ff3fd12" :answer/type :answer.type/math :answer/value "\\frac{\\pi \\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-68754c06-e278-58cb-aad9-4cc8f6c4502c" :answer/id #uuid "68754c06-e278-58cb-aad9-4cc8f6c4502c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "activity-a24b5247-c2da-5645-9e05-03878357cafa" :activity/id #uuid "a24b5247-c2da-5645-9e05-03878357cafa" :activity/title "Double Integrals Between Polar Curves" :activity/type :activity.type/review :activity/scope 17592186051016 :activity/course 17592186046659 :activity/steps ["step-6f29dc74-d09a-5b6e-a542-bfc991375287" "step-d044a436-919a-5bca-b4cc-859a4b8341a4" "step-9fcfe624-e47d-5c6a-bcb3-629540a17648" "step-ea22112c-a2f7-5185-ac77-d7f0838d3983" "step-032a341e-0565-552a-b03a-ffb8b061f234"] :activity/first-step "step-6f29dc74-d09a-5b6e-a542-bfc991375287" :db/ensure [:activity/validate]} {:db/id "step-6f29dc74-d09a-5b6e-a542-bfc991375287" :step/id #uuid "6f29dc74-d09a-5b6e-a542-bfc991375287" :step/content 17592186157834 :step/next "step-d044a436-919a-5bca-b4cc-859a4b8341a4" :db/ensure [:step/validate]} {:db/id "step-d044a436-919a-5bca-b4cc-859a4b8341a4" :step/id #uuid "d044a436-919a-5bca-b4cc-859a4b8341a4" :step/content 17592186157839 :step/next "step-9fcfe624-e47d-5c6a-bcb3-629540a17648" :db/ensure [:step/validate]} {:db/id "step-9fcfe624-e47d-5c6a-bcb3-629540a17648" :step/id #uuid "9fcfe624-e47d-5c6a-bcb3-629540a17648" :step/content 17592186157840 :step/next "step-ea22112c-a2f7-5185-ac77-d7f0838d3983" :db/ensure [:step/validate]} {:db/id "step-ea22112c-a2f7-5185-ac77-d7f0838d3983" :step/id #uuid "ea22112c-a2f7-5185-ac77-d7f0838d3983" :step/content 17592186424328 :step/next "step-032a341e-0565-552a-b03a-ffb8b061f234" :db/ensure [:step/validate]} {:db/id "step-032a341e-0565-552a-b03a-ffb8b061f234" :step/id #uuid "032a341e-0565-552a-b03a-ffb8b061f234" :step/content 17592186424327 :db/ensure [:step/validate]} [:db/retract 17592186053775 :answer-field/choices 17592186053776] [:db/retract 17592186053775 :answer-field/choices 17592186053777] [:db/retract 17592186053775 :answer-field/choices 17592186053778] [:db/retract 17592186053775 :answer-field/choices 17592186053779] [:db/retract 17592186053775 :answer-field/choices 17592186053780] {:db/id 17592186054666 :knowledge-point/questions ["question-6bb3e47d-363c-5767-a7cd-275cd49433de" "question-d16b32fa-a461-50f2-a556-45f9c139382e" "question-b8ace067-214c-5217-8009-450b47fbf196"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054390 :question/worked-solution "The graph is a horizontal line where the $y$-value of every point is $-1.$ Consequently, its equation is $y = -1.$" :db/ensure [:question/validate]} {:db/id 17592186054667 :knowledge-point/questions ["question-d4510c05-0038-50e3-b00f-e4a77a1bb718" "question-d1122b7b-df38-56a5-b524-7f63741706f2"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054491 :question/worked-solution "The graph is a vertical line where the $x$-value of every point is $1.$ Consequently, its equation is $x=1.$" :db/ensure [:question/validate]} {:db/id 17592186054668 :knowledge-point/questions ["question-52e56069-89cb-5660-84b2-9dbd8085ccea" "question-58f5d0a1-acf5-5310-991a-59bdebc0ea64"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054391 :question/problem "![](images/45/45ba98becc788f2c39f7e03b13b021beebce36e8cf3c8f50299bdfba041dfff4.png)\n\nWhich of the plots above shows the following lines?\n\n- $x=-1$\n\n- $y=-1$" :question/worked-solution "- On the line $x=-1,$ every point has an $x$-coordinate of $-1.$ Therefore, graph II represents this equation.\n\n- On the line $y=-1,$ every point has an $y$-coordinate of $-1.$ Therefore, graph III represents this equation." :db/ensure [:question/validate]} {:db/id 17592186054669 :knowledge-point/questions ["question-5491ad4f-b530-5712-8610-611282a460f1" "question-72f1e9f4-dfe2-5157-9a7e-252993718bb0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054392 :question/problem "A horizontal line in the $xy$-plane passes through the point $(- 2,4).$ What is the equation of the line? Does the point $(4,-2)$ lie on that line?" :question/worked-solution "Since the horizontal line passes through $(-2,4)$, every point on the line has a $y$-coordinate of $4.$ So, the equation of that line is $y=4.$\n\nThe $y$-coordinate of the point $(4,-2)$ is $-2,$ but all points on the line $y=4$ have a $y$-coordinate of $4.$ So, the point $(4,-2)$ is not on the line.\n\n![](images/0f/0fa994fe8d3da1428d803aa0c6d6c1470eab0fd23e24cd0edd67bb213efec068.png)" :db/ensure [:question/validate]} {:db/id "question-6bb3e47d-363c-5767-a7cd-275cd49433de" :question/id #uuid "6bb3e47d-363c-5767-a7cd-275cd49433de" :question/math-academy-id "q-237286" :question/problem "![](images/b0/b028d2711e3fb28b1d027fc9111b72c9ca5511d12dc33d97305ddd1985fa2c8a.png)\n\nThe equation of the horizontal line shown above is{{field-1}}\n$=$\n{{field-2}}." :question/worked-solution "The graph is a horizontal line where the $y$-value of every point is $-3.$ Consequently, its equation is $y=-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-92837f61-349c-544e-8f92-b94813635832" "answer-field-7c2ead80-2cfe-513a-acb2-38eab5a54f2c"] :db/ensure [:question/validate]} {:db/id "answer-field-92837f61-349c-544e-8f92-b94813635832" :answer-field/id #uuid "92837f61-349c-544e-8f92-b94813635832" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4413926c-6949-5b04-bf2e-dea537af3bf8" :answer-field/choices ["answer-4413926c-6949-5b04-bf2e-dea537af3bf8"] :db/ensure [:answer-field/validate]} {:db/id "answer-4413926c-6949-5b04-bf2e-dea537af3bf8" :answer/id #uuid "4413926c-6949-5b04-bf2e-dea537af3bf8" :answer/type :answer.type/math :answer/value "y" :db/ensure [:answer/validate]} {:db/id "answer-field-7c2ead80-2cfe-513a-acb2-38eab5a54f2c" :answer-field/id #uuid "7c2ead80-2cfe-513a-acb2-38eab5a54f2c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :a