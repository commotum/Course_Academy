.75), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & =(0.25)^{0}(0.75)+(0.25)^{1}(0.75)+(0.25)^{2}(0.75)+(0.25)^{3}(0.75) \\\\  & ≈0.9961.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0b3f1a70-503f-52c2-860a-0c47acfaab21"] :db/ensure [:question/validate]} {:db/id "answer-field-0b3f1a70-503f-52c2-860a-0c47acfaab21" :answer-field/id #uuid "0b3f1a70-503f-52c2-860a-0c47acfaab21" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-23d401c2-e965-5c1f-bf12-a1405281691f" :answer-field/choices ["answer-23d401c2-e965-5c1f-bf12-a1405281691f"] :db/ensure [:answer-field/validate]} {:db/id "answer-23d401c2-e965-5c1f-bf12-a1405281691f" :answer/id #uuid "23d401c2-e965-5c1f-bf12-a1405281691f" :answer/type :answer.type/math :answer/value "0.9961" :db/ensure [:answer/validate]} {:db/id "question-ebe82800-a8b2-58e9-ab4c-047410ac5d4f" :question/id #uuid "ebe82800-a8b2-58e9-ab4c-047410ac5d4f" :question/math-academy-id "q-332934" :question/problem "Given $X∼\\text{Geom}(\\frac{3}{5}),$ compute the **exact** value of $P(3\\le X\\le 6).$\n\n$P(3\\le X\\le 6)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{3}{5}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{2}{5})}^{x-1}(\\frac{3}{5}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3\\le X\\le 6) & =P(X\\in \\{3,4,5,6\\}) \\\\  & =P(X=3)+P(X=4)+P(X=5)+P(X=6) \\\\  & =f(3)+f(4)+f(5)+f(6) \\\\  & ={(\\frac{2}{5})}^{2}(\\frac{3}{5})+{(\\frac{2}{5})}^{3}(\\frac{3}{5})+{(\\frac{2}{5})}^{4}(\\frac{3}{5})+{(\\frac{2}{5})}^{5}(\\frac{3}{5}) \\\\  & =\\frac{2436}{15625}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7f07629a-b94e-5918-a076-295a6afd6ca9"] :db/ensure [:question/validate]} {:db/id "answer-field-7f07629a-b94e-5918-a076-295a6afd6ca9" :answer-field/id #uuid "7f07629a-b94e-5918-a076-295a6afd6ca9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9663b4c1-0d09-501b-85ec-b12bc71c403b" :answer-field/choices ["answer-9663b4c1-0d09-501b-85ec-b12bc71c403b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9663b4c1-0d09-501b-85ec-b12bc71c403b" :answer/id #uuid "9663b4c1-0d09-501b-85ec-b12bc71c403b" :answer/type :answer.type/math :answer/value "\\frac{2436}{15625}" :db/ensure [:answer/validate]} {:db/id "question-e519920d-4b78-559e-a669-c1163fd46764" :question/id #uuid "e519920d-4b78-559e-a669-c1163fd46764" :question/math-academy-id "q-334517" :question/problem "Given that $X∼\\text{Geom}(0.25),$ compute $P(3\\le X<7)$ rounded to $4$ decimal places.\n\n$P(3\\le X<7)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.25),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}(0.75)^{x-1}(0.25), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3\\le X<7) & =P(X\\in \\{3,4,5,6\\}) \\\\  & =P(X=3)+P(X=4)+P(X=5)+P(X=6) \\\\  & =f(3)+f(4)+f(5)+f(6) \\\\  & =(0.75)^{2}(0.25)+(0.75)^{3}(0.25)+(0.75)^{4}(0.25)+(0.75)^{5}(0.25) \\\\  & ≈0.3845.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e6583c9a-95dc-5a97-93ac-4ed54bc666d0"] :db/ensure [:question/validate]} {:db/id "answer-field-e6583c9a-95dc-5a97-93ac-4ed54bc666d0" :answer-field/id #uuid "e6583c9a-95dc-5a97-93ac-4ed54bc666d0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9b2c097b-83d9-5335-adb4-b351e48449d3" :answer-field/choices ["answer-9b2c097b-83d9-5335-adb4-b351e48449d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b2c097b-83d9-5335-adb4-b351e48449d3" :answer/id #uuid "9b2c097b-83d9-5335-adb4-b351e48449d3" :answer/type :answer.type/math :answer/value "0.3845" :db/ensure [:answer/validate]} {:db/id "question-89650cb6-ad4a-5818-b55e-8a9dde9d78b4" :question/id #uuid "89650cb6-ad4a-5818-b55e-8a9dde9d78b4" :question/math-academy-id "q-97164" :question/problem "Given that $X∼\\text{Geom}(\\frac{5}{12}),$ compute $P(4<X<7)$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{12}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{7}{12})}^{x-1}(\\frac{5}{12}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(4<X<7) & =P(X\\in \\{5,6\\}) \\\\  & =P(X=5)+P(X=6) \\\\  & =f(5)+f(6) \\\\  & ={(\\frac{7}{12})}^{4}(\\frac{5}{12})+{(\\frac{7}{12})}^{5}(\\frac{5}{12}) \\\\  & ≈0.0764.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cf820629-906a-5c04-b58a-8d824afc8c32"] :db/ensure [:question/validate]} {:db/id "answer-field-cf820629-906a-5c04-b58a-8d824afc8c32" :answer-field/id #uuid "cf820629-906a-5c04-b58a-8d824afc8c32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1a06965d-e607-5ac2-8527-8aaf4db45332" :answer-field/choices ["answer-c57a8780-ca2e-5b63-8e36-e20cefc4f686" "answer-c470e502-58aa-5ad8-9844-68f75a95a94a" "answer-396ef0a9-9da4-597c-a198-387695b