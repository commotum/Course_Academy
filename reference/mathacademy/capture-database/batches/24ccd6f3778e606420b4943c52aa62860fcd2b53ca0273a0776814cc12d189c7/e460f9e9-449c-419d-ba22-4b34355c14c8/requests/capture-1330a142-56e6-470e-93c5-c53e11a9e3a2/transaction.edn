culty :question.difficulty/easy :question/answer-fields ["answer-field-0beb1338-f5b7-5c64-8a8e-35f279844e52"] :db/ensure [:question/validate]} {:db/id "answer-field-0beb1338-f5b7-5c64-8a8e-35f279844e52" :answer-field/id #uuid "0beb1338-f5b7-5c64-8a8e-35f279844e52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ec06b592-8251-5caa-8800-efc045e64f99" :answer-field/choices ["answer-ec06b592-8251-5caa-8800-efc045e64f99"] :db/ensure [:answer-field/validate]} {:db/id "answer-ec06b592-8251-5caa-8800-efc045e64f99" :answer/id #uuid "ec06b592-8251-5caa-8800-efc045e64f99" :answer/type :answer.type/math :answer/value "\\frac{64}{625}" :db/ensure [:answer/validate]} {:db/id "question-458360eb-fd03-5244-aa64-17cd1909b422" :question/id #uuid "458360eb-fd03-5244-aa64-17cd1909b422" :question/math-academy-id "q-335471" :question/problem "Given $X∼\\text{Geom}(\\frac{5}{9}),$ compute $P(X<5).$ Round your final answer to $4$ decimal places.\n\n$P(X<5)≈$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{5}{9}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{4}{9})}^{x-1}(\\frac{5}{9}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(\\frac{4}{9})}^{0}(\\frac{5}{9})+{(\\frac{4}{9})}^{1}(\\frac{5}{9})+{(\\frac{4}{9})}^{2}(\\frac{5}{9})+{(\\frac{4}{9})}^{3}(\\frac{5}{9}) \\\\  & ≈0.9610.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fdcc3e6a-dcfa-5751-a590-4c15ac84e072"] :db/ensure [:question/validate]} {:db/id "answer-field-fdcc3e6a-dcfa-5751-a590-4c15ac84e072" :answer-field/id #uuid "fdcc3e6a-dcfa-5751-a590-4c15ac84e072" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8e780059-1688-570a-b234-233305003b4d" :answer-field/choices ["answer-8e780059-1688-570a-b234-233305003b4d"] :db/ensure [:answer-field/validate]} {:db/id "answer-8e780059-1688-570a-b234-233305003b4d" :answer/id #uuid "8e780059-1688-570a-b234-233305003b4d" :answer/type :answer.type/math :answer/value "0.9610" :db/ensure [:answer/validate]} {:db/id "question-c5de4d6c-cfeb-57f1-bb0f-e9ef45447169" :question/id #uuid "c5de4d6c-cfeb-57f1-bb0f-e9ef45447169" :question/math-academy-id "q-335472" :question/problem "Given $X∼\\text{Geom}(\\frac{3}{4}),$ compute the **exact** value of $P(X<5).$\n\n$P(X<5)=$\n{{field-1}}" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(\\frac{3}{4}),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(\\frac{1}{4})}^{x-1}(\\frac{3}{4}), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X<5) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(\\frac{1}{4})}^{0}(\\frac{3}{4})+{(\\frac{1}{4})}^{1}(\\frac{3}{4})+{(\\frac{1}{4})}^{2}(\\frac{3}{4})+{(\\frac{1}{4})}^{3}(\\frac{3}{4}) \\\\  & =\\frac{255}{256}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-374164b9-fa8d-5f84-b049-4c4079513c6a"] :db/ensure [:question/validate]} {:db/id "answer-field-374164b9-fa8d-5f84-b049-4c4079513c6a" :answer-field/id #uuid "374164b9-fa8d-5f84-b049-4c4079513c6a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b76c2ecd-bfe3-572f-9e1c-e2783e3ff672" :answer-field/choices ["answer-b76c2ecd-bfe3-572f-9e1c-e2783e3ff672"] :db/ensure [:answer-field/validate]} {:db/id "answer-b76c2ecd-bfe3-572f-9e1c-e2783e3ff672" :answer/id #uuid "b76c2ecd-bfe3-572f-9e1c-e2783e3ff672" :answer/type :answer.type/math :answer/value "\\frac{255}{256}" :db/ensure [:answer/validate]} {:db/id "question-4c144938-ebf0-5b6b-9305-5aba70df7465" :question/id #uuid "4c144938-ebf0-5b6b-9305-5aba70df7465" :question/math-academy-id "q-97139" :question/problem "Given $X∼\\text{Geom}(0.3),$ compute $P(X\\le 4).$" :question/worked-solution "If $X∼\\text{Geom}(p),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\{\\begin{aligned}(1-p)^{x-1}p, & x=1,2,3,… \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$\n\nHere, $X∼\\text{Geom}(0.3),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\{\\begin{aligned}{(0.7)}^{x-1}(0.3), & x=1,2,3,… \\\\ 0, & \\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X\\le 4) & =P(X\\in \\{1,2,3,4\\}) \\\\  & =P(X=1)+P(X=2)+P(X=3)+P(X=4) \\\\  & =f(1)+f(2)+f(3)+f(4) \\\\  & ={(0.7)}^{0}(0.3)+{(0.7)}^{1}(0.3)+{(0.7)}^{2}(0.3)+{(0.7)}^{3}(0.3) \\\\  & =0.7599.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-304c509f-2d66-5c40-a356-df8a6e57df6b"] :db/ensure [:question/validate]} {:db/id "answer-field-304c509f-2d66-5c40-a356-df8a6e57df6b" :answer-field/id #uuid "304c509f-2d66-5c40-a356-df8a6e57df6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4fd3f597-cc5c-5239-86c5-defc4c2266c6" :answer-field/choices ["answer-f8905f57-9f77-5e1f-b352-689e47d528c9" "answer-2c74fa0c-2314-5e85-88dc-c8c520838851" "answer-a2ba8a60-87e0-51ed-982c-b93a5714686d" "answer-4fd3f597-cc5c-5239-86c5-defc4c2266c6" "answer-f1dcd0da-5e77-5501-a9b5-177d314a7506"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8905f57-9f77-5e1f-b352-689e47d528c9" :answer/id #uuid "f8905f57-9f77-5e1f-b352-689e47d528c9" :answer/type :answer.type/math :answer/value "0.7423" :db/ensure