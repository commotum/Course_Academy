stion/validate]} {:db/id "answer-field-2028b9e8-ac7f-529f-9b65-db6fe0e00bcd" :answer-field/id #uuid "2028b9e8-ac7f-529f-9b65-db6fe0e00bcd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-438616ec-0e3f-5fa1-ab3f-1af4fa15b383" :answer-field/choices ["answer-a562429f-cfce-566a-b80b-75f3f18f2e67" "answer-1ac9b960-0aea-5b35-af6f-00262ffb1905" "answer-4299bc79-766a-5c31-9dfb-302e74859eb2" "answer-438616ec-0e3f-5fa1-ab3f-1af4fa15b383" "answer-5c44fbe2-aae3-5b4a-b834-aa349f9ed7a2"] :db/ensure [:answer-field/validate]} {:db/id "answer-a562429f-cfce-566a-b80b-75f3f18f2e67" :answer/id #uuid "a562429f-cfce-566a-b80b-75f3f18f2e67" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-1ac9b960-0aea-5b35-af6f-00262ffb1905" :answer/id #uuid "1ac9b960-0aea-5b35-af6f-00262ffb1905" :answer/type :answer.type/math :answer/value "-2.71" :db/ensure [:answer/validate]} {:db/id "answer-4299bc79-766a-5c31-9dfb-302e74859eb2" :answer/id #uuid "4299bc79-766a-5c31-9dfb-302e74859eb2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-438616ec-0e3f-5fa1-ab3f-1af4fa15b383" :answer/id #uuid "438616ec-0e3f-5fa1-ab3f-1af4fa15b383" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-5c44fbe2-aae3-5b4a-b834-aa349f9ed7a2" :answer/id #uuid "5c44fbe2-aae3-5b4a-b834-aa349f9ed7a2" :answer/type :answer.type/math :answer/value "2.71" :db/ensure [:answer/validate]} {:db/id 17592186065360 :tutorial/content "Any number raised to the power of zero is equal to $1.$ For example, \n\n$$\n2^0 = 1 \\quad\\textrm{and}\\quad (-55)^0=1.\n$$\n\nTo understand why, let's try to convince ourselves that $2^0 = 1.$ First, we write down a table containing all of the powers of $2$:\n\n$$\n\\begin{aligned}{2}^{4} & =16 \\\\ {2}^{3} & =8 \\\\ {2}^{2} & =4 \\\\ {2}^{1} & =2 \\\\ {2}^{0} & =◻\\,?\\end{aligned}\n$$\n\nAs we go down the list, the number in blue is divided by $2$ each time. Following this pattern, we must have \n\n$$\n2^{\\color{red}{0}}  = {\\color{blue}{2}}\\div 2 = 1.\n$$\n\nIt doesn't matter whether the number is positive or negative, a fraction or a decimal, big or small. Raising any non-zero number to the power of zero always gives $1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186064414 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]}]
