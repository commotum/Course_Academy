-467e5a186cc6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f4e272ae-5b22-5640-9232-dfe5010441e0" :answer-field/choices ["answer-302ba10e-b218-5e24-91d5-4a8c40f0ccca" "answer-27734e30-76a1-52c9-a3c2-3ecff23093e5" "answer-f4e272ae-5b22-5640-9232-dfe5010441e0" "answer-cb8037c7-f1b4-55d2-baab-3933b5320eb5" "answer-608c47ac-bfea-58a0-995e-c1bf0f80e4dd"] :db/ensure [:answer-field/validate]} {:db/id "answer-302ba10e-b218-5e24-91d5-4a8c40f0ccca" :answer/id #uuid "302ba10e-b218-5e24-91d5-4a8c40f0ccca" :answer/type :answer.type/math :answer/value "-1,331" :db/ensure [:answer/validate]} {:db/id "answer-27734e30-76a1-52c9-a3c2-3ecff23093e5" :answer/id #uuid "27734e30-76a1-52c9-a3c2-3ecff23093e5" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "answer-f4e272ae-5b22-5640-9232-dfe5010441e0" :answer/id #uuid "f4e272ae-5b22-5640-9232-dfe5010441e0" :answer/type :answer.type/math :answer/value "1,331" :db/ensure [:answer/validate]} {:db/id "answer-cb8037c7-f1b4-55d2-baab-3933b5320eb5" :answer/id #uuid "cb8037c7-f1b4-55d2-baab-3933b5320eb5" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-608c47ac-bfea-58a0-995e-c1bf0f80e4dd" :answer/id #uuid "608c47ac-bfea-58a0-995e-c1bf0f80e4dd" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "question-48d4be4c-58b6-582c-9132-4582bd4667fc" :question/id #uuid "48d4be4c-58b6-582c-9132-4582bd4667fc" :question/math-academy-id "q-71501" :question/problem "$(\\sqrt[3]{-512})^{3}=$" :question/worked-solution "The cube and the cube root cancel each other out. So, we have\n\n$$\n(\\sqrt[3]{-512})^{3}=-512.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-04a9ad5c-ba38-5680-9829-b919a27995bb"] :db/ensure [:question/validate]} {:db/id "answer-field-04a9ad5c-ba38-5680-9829-b919a27995bb" :answer-field/id #uuid "04a9ad5c-ba38-5680-9829-b919a27995bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ea093b8f-b5c5-5c3d-ad4c-0074f856a8aa" :answer-field/choices ["answer-ea093b8f-b5c5-5c3d-ad4c-0074f856a8aa" "answer-2fda2522-c272-54d6-ba91-f1669737ddc4" "answer-4616ecff-c93c-58c5-95bf-35ac62525dac" "answer-d1867fac-1c96-55ad-b404-96cb84161557" "answer-854cce32-d9cb-51a9-ad68-32ffabb3a377"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea093b8f-b5c5-5c3d-ad4c-0074f856a8aa" :answer/id #uuid "ea093b8f-b5c5-5c3d-ad4c-0074f856a8aa" :answer/type :answer.type/math :answer/value "-512" :db/ensure [:answer/validate]} {:db/id "answer-2fda2522-c272-54d6-ba91-f1669737ddc4" :answer/id #uuid "2fda2522-c272-54d6-ba91-f1669737ddc4" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-4616ecff-c93c-58c5-95bf-35ac62525dac" :answer/id #uuid "4616ecff-c93c-58c5-95bf-35ac62525dac" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "answer-d1867fac-1c96-55ad-b404-96cb84161557" :answer/id #uuid "d1867fac-1c96-55ad-b404-96cb84161557" :answer/type :answer.type/math :answer/value "512" :db/ensure [:answer/validate]} {:db/id "answer-854cce32-d9cb-51a9-ad68-32ffabb3a377" :answer/id #uuid "854cce32-d9cb-51a9-ad68-32ffabb3a377" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id 17592186121142 :tutorial/content "Finding the **cube root** of a number is the reverse of cubing a number. We express the cube root using the **radical symbol** $\\sqrt[3]{\\phantom{x}}.$\n\nFor example, the \"cube root of $8$\" equals $\\color{blue}2$ since \n\n$$\n{\\color{blue}2}^3 = {\\color{blue}2}\\cdot {\\color{blue}2}\\cdot {\\color{blue}2} = 8.\n$$\n\nSo, we write $\\sqrt[3]{8}={\\color{blue}2}.$\n\nSome basic cube roots are as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{0} & = & \\sqrt[3]{{0}^{3}} & = & 0 \\\\ \\sqrt[3]{1} & = & \\sqrt[3]{{1}^{3}} & = & 1 \\\\ \\sqrt[3]{8} & = & \\sqrt[3]{{2}^{3}} & = & 2 \\\\ \\sqrt[3]{27} & = & \\sqrt[3]{{3}^{3}} & = & 3 \\\\ \\sqrt[3]{64} & = & \\sqrt[3]{{4}^{3}} & = & 4 \\\\ \\sqrt[3]{125} & = & \\sqrt[3]{{5}^{3}} & = & 5 \\\\ \\sqrt[3]{1\\,000} & = & \\sqrt[3]{{10}^{3}} & = & 10\\end{aligned}\n$$\n\nA **perfect cube** is a number whose cube root is a whole number. So, the numbers \n\n$$\n0,\\qquad 1,\\qquad  8,\\qquad  27,\\qquad  64,\\qquad 125, \\qquad 1\\,000\n$$\n\n are all perfect cubes. You need to remember them." :db/ensure [:tutorial/validate]} {:db/id 17592186121143 :tutorial/content "Unlike the square root, it *is* possible to find the cube root of a negative number.\n\nFor example, $\\sqrt[3]{-8}={\\color{blue}{-2}}$ because\n\n$$\n-8 = ({\\color{blue}{-2}})^3 = ({\\color{blue}{-2}})\\cdot ({\\color{blue}{-2}})\\cdot ({\\color{blue}{-2}}).\n$$\n\nSome basic cube roots of negative numbers are as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{-1} & = & \\sqrt[3]{(-1)^{3}} & = & -1 \\\\ \\sqrt[3]{-8} & = & \\sqrt[3]{(-2)^{3}} & = & -2 \\\\ \\sqrt[3]{-27} & = & \\sqrt[3]{(-3)^{3}} & = & -3 \\\\ \\sqrt[3]{-64} & = & \\sqrt[3]{(-4)^{3}} & = & -4 \\\\ \\sqrt[3]{-125} & = & \\sqrt[3]{(-5)^{3}} & = & -5 \\\\ \\sqrt[3]{-1\\,000} & = & \\sqrt[3]{(-10)^{3}} & = & -10\\end{aligned}\n$$\n\nNote that the numbers \n\n$$\n-1,\\qquad  -8,\\qquad  -27,\\qquad  -64,\\qquad -125, \\qquad -1\\,000\n$$\n\nare all perfect cubes." :db/ensure [:tutorial/validate]} {:db/id 17592186121144 :tutorial/content "Let's calculate $(\\sqrt[3]{64})^3$ by performing each operation one step at a time:\n\n$$\n\\left(\\sqrt[3]{\\color{blue}64}\\right)^3 = \\left(\\sqrt[3]{{\\color{red}4}^3}\\right)^3 = {\\color{red}4}^3 = {\\color{blue}64}\n$$\n\nNotice that cubing the cube root gives the number under the cube root:\n\n$$\n\\left( \\sqrt[3]{64} \\right)^3 = 64\n$$\n\nThis result holds in general. If $\\color{blue}\\square$ is any number, then\n\n$$\n\\left(\\sqrt[3]{\\color{blue}\\square}\\right)^3 = {\\color{blue}\\square}.\n$$\n\nThe cube and the cube root cancel each other out, and we're left with the number that we started with.\n\n![](images/78/784f43f7253e1ed6fa394462a172e22571af06a5318b424ba2eab2157333c6fe.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186121145 :tutorial/content "We can think of the cube root geometrically. For instance, let's represent the number $8$ by a collection of eight items:\n\n![](images/36/3677ea5b5f875e12fdcc6376f6b29b43a663495d20a3fbf69b4937cc61661d79.png)\n\nNow, we can pile them up in the form of a cube where each side is equal to $\\sqrt[3]{8}={\\color{blue}2}\\mathbin{:}$\n\n![](images/30/305e02bdaa4c3efcb9d8047eeb3d3573f39c08714e30ba6053cfc4441053156b.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186120026 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186127399 :answer-field/choices 17592186127400] [:db/retract 17592186127399 :answer-field/choices 17592186127401] [:db/retract 17592186127399 :answer-field/choices 17592186127402] [:db/retract 17592186127399 :answer-field/choices 17592186127403] [:db/retract 17592186127399 :answer-field/choices 17592186127404] {:db/id 17592186129191 :knowledge-point/questions ["question-8d54021f-0d37-540b-875f-4f433fa4e2b8" "question-00b86b57-002e-5667-8521-28c6ba4d5298" "question-2f7d21f4-2434-59d0-b158-63a98b31b96d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129190 :knowledge-point/questions ["question-d9c15809-274b-5c74-bd5b-6fd325ecdfd9" "question-0e844cdc-bfeb-5b03-bf45-d36a53583297"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186129189 :knowledge-point/questions ["question-e49d891d-abb2-5ea6-ab4c-68e975346cd4" "question-cb97248a-192c-5cf9-ad2e-d068b8748779"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8d54021f-0d37-540b-875f-4f433fa4e2b8" :question/id #uuid "8d54021f-0d37-540b-875f-4f433fa4e2b8" :question/math-academy-id "q-82209" :question/problem "Change the order of integration in the double integral ${\\int }_{0}^{1}{\\int }_{1}^{2-{y}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y.$" :question/worked-solution "![](images/48/48a1ef0d61b8b81e2fa0649b95a329099d48a802a5339d730f2da9cf8b59f547.png)\n\nThe diagram above shows the region of integration. It is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,1\\le x\\le 2-{y}^{2}\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=2-{y}^{2}\\,⟹\\,y=\\sqrt{2-x},\n$$\n\nand the bottom boundary of the region is\n\n$$\ny=0.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le \\sqrt{2-x}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/22/22d41ecc443e1520035f52fefe524d88062432ab1643aa19b2e0b76185b191a0.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{1}^{2-{y}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2-x}}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0b369f9a-15dc-509e-a7b9-f81d6504e3a3"] :db/ensure [:question/validate]} {:db/id "answer-field-0b369f9a-15dc-509e-a7b9-f81d6504e3a3" :answer-field/id #uuid "0b369f9a-15dc-509e-a7b9-f81d6504e3a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-78e32947-eba9-51e0-8b4c-87164677417a" :answer-field/choices ["answer-fa5b57f1-6e21-5370-8a4c-9d6a9dd843e5" "answer-1a459d01-9ed5-56d1-8350-6db0e6aae3ba" "answer-78e32947-eba9-51e0-8b4c-87164677417a" "answer-f135f32a-6d59-5ddd-9a2f-500aff8038ea" "answer-fd9bdb23-1fbe-5efd-a16b-c2a57100affd"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa5b57f1-6e21-5370-8a4c-9d6a9dd843e5" :answer/id #uuid "fa5b57f1-6e21-5370-8a4c-9d6a9dd843e5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{1}^{\\sqrt{2-x}}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-1a459d01-9ed5-56d1-8350-6db0e6aae3ba" :answer/id #uuid "1a459d01-9ed5-56d1-8350-6db0e6aae3ba" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt{2-x}}{\\int }_{1}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-78e32947-eba9-51e0-8b4c-87164677417a" :answer/id #uuid "78e32947-eba9-51e0-8b4c-87164677417a" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2-x}}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-f135f32a-6d59-5ddd-9a2f-500aff8038ea" :answer/id #uuid "f135f32a-6d59-5ddd-9a2f-500aff8038ea" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{\\sqrt{2-x}}{\\int }_{0}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-fd9bdb23-1fbe-5efd-a16b-c2a57100affd" :answer/id #uuid "fd9bdb23-1fbe-5efd-a16b-c2a57100affd" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{2-x}}^{2}{\\int }_{0}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186351402 :question/worked-solution "![](images/06/062d32beb0cab13297c21b2eab703fd5e598191c96daa93a9c27337af95a1930.png)\n\nThe diagram above shows the region of integration. It is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,1\\le y\\le 2,\\,2y-2\\le x\\le 2\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=2y-2\\,⟹\\,y=\\frac{x+2}{2},\n$$\n\nand the bottom boundary of the region is\n\n$$\ny=1.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le \\frac{x+2}{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/54/543ffc57d0d32ae9a4bdefa87bd56deb7380061004b7737cf821117b4fb20e2f.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{2y-2}^{2}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{0}^{2}{\\int }_{1}^{(x+2)/2}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186351403 :question/worked-solution "![](images/82/8287ba53b227ddc36aff486ea8d42a83203940ee265163320c19ad6cdb39089e.png)\n\nThe diagram above shows the region of integration. It is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le {x}^{2}\\}.\n$$\n\nNotice that the right boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nand the left boundary of the region is\n\n$$\nx=0.\n$$\n\nTo change the order of integration, we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt{y}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/2c/2c9a41f06d7edfbad9756923d9b70f1d0ffd730350d0b7d2d0e109c1bca9f80d.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{x}^{2}}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{y}}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-00b86b57-002e-5667-8521-28c6ba4d5298" :question/id #uuid "00b86b57-002e-5667-8521-28c6ba4d5298" :question/math-academy-id "q-82211" :question/problem "Change the order of integration in the double integral ${\\int }_{0}^{1}{\\int }_{2y+1}^{3}f(x,y)\\,\\text{d}x\\,\\text{d}y.$" :question/worked-solution "![](images/03/03a006f46e78ec893c21d2a871c54eeccbdb0d74b19385a6a569f787ee1bdd2d.png)\n\nThe diagram above shows the region of integration. It is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,2y+1\\le x\\le 3\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=2y+1\\,⟹\\,y=\\frac{x-1}{2},\n$$\n\nand the bottom boundary of the region is\n\n$$\ny=0.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,1\\le x\\le 3,\\,0\\le y\\le \\frac{x-1}{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/d2/d27e38c7c3de8dda353151cd0347d6bead91cb19d2eb90d08dd485d77899bc27.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{2y+1}^{3}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{1}^{3}{\\int }_{0}^{(x-1)/2}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e1839f04-52db-5ce7-ac3e-01d49177c51f"] :db/ensure [:question/validate]} {:db/id "answer-field-e1839f04-52db-5ce7-ac3e-01d49177c51f" :answer-field/id #uuid "e1839f04-52db-5ce7-ac3e-01d49177c51f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-42411160-e2b2-5009-9eee-fe1c4d6161cd" :answer-field/choices ["answer-426f76c7-04fb-5fbd-affe-8ee9c5415244" "answer-bbbec340-99df-5bac-8d15-3f342fb706b6" "answer-2d14e0cf-c866-5b21-b468-f37f95e4d3a4" "answer-06ee8955-68e7-52be-ab2d-11fb2cdedbcd" "answer-42411160-e2b2-5009-9eee-fe1c4d6161cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-426f76c7-04fb-5fbd-affe-8ee9c5415244" :answer/id #uuid "426f76c7-04fb-5fbd-affe-8ee9c5415244" :answer/type :answer.type/math :answer/value "{\\int }_{(x-1)/2}^{3}{\\int }_{0}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-bbbec340-99df-5bac-8d15-3f342fb706b6" :answer/id #uuid "bbbec340-99df-5bac-8d15-3f342fb706b6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{(x-1)/2}{\\int }_{1}^{3}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-2d14e0cf-c866-5b21-b468-f37f95e4d3a4" :answer/id #uuid "2d14e0cf-c866-5b21-b468-f37f95e4d3a4" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{1}^{(x-1)/2}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-06ee8955-68e7-52be-ab2d-11fb2cdedbcd" :answer/id #uuid "06ee8955-68e7-52be-ab2d-11fb2cdedbcd" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{(x-1)/2}{\\int }_{0}^{3}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-42411160-e2b2-5009-9eee-fe1c4d6161cd" :answer/id #uuid "42411160-e2b2-5009-9eee-fe1c4d6161cd" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{3}{\\int }_{0}^{(x-1)/2}f(x,y)\\,\\text{d}y\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-2f7d21f4-2434-59d0-b158-63a98b31b96d" :question/id #uuid "2f7d21f4-2434-59d0-b158-63a98b31b96d" :question/math-academy-id "q-82342" :question/problem "Change the order of integration in the double integral \n${\\int }_{1}^{4}{\\int }_{0}^{4-x}f(x,y)\\,\\text{d}y\\,\\text{d}x.$" :question/worked-solution "![](images/69/69bff6ba843a7d93cc9c60ec0adfe5986d4eea78beeca8806ec487c64f32310a.png)\n\nThe diagram above shows the region of integration. It is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,1\\le x\\le 4,\\,0\\le y\\le 4-x\\}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\nx=1\n$$\n\nand the right boundary of the region is\n\n$$\ny=4-x\\,⟹\\,x=4-y.\n$$\n\nTo change the order of integration, we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 3,\\,1\\le x\\le 4-y\\},\n$$\n\nas shown in the diagram below.\n\n![](images/47/47bc45edcaaa73ec6fb6010aa6d6fe35c77219b234d7f2b7210f12cec55e500d.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}{\\int }_{0}^{4-x}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{3}{\\int }_{1}^{4-y}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d93ef9dc-afef-559b-a1a8-13f4a2ec251b"] :db/ensure [:question/validate]} {:db/id "answer-field-d93ef9dc-afef-559b-a1a8-13f4a2ec251b" :answer-field/id #uuid "d93ef9dc-afef-559b-a1a8-13f4a2ec251b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd3a87f3-39a9-5ebb-9403-664738176275" :answer-field/choices ["answer-3ae59dc8-d178-5424-be29-70255bcce6a1" "answer-cd3a87f3-39a9-5ebb-9403-664738176275" "answer-e51c6fad-6b06-55bb-90c3-d9788ef7bee1" "answer-54a91fda-7695-5788-94ff-e4b59f55fda2" "answer-c5b7dc90-6bb1-5e01-b095-98e1e090d69f"] :db/ensure [:answer-field/validate]} {:db/id "answer-3ae59dc8-d178-5424-be29-70255bcce6a1" :answer/id #uuid "3ae59dc8-d178-5424-be29-70255bcce6a1" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{3}^{4-y}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-cd3a87f3-39a9-5ebb-9403-664738176275" :answer/id #uuid "cd3a87f3-39a9-5ebb-9403-664738176275" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}{\\int }_{1}^{4-y}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-e51c6fad-6b06-55bb-90c3-d9788ef7bee1" :answer/id #uuid "e51c6fad-6b06-55bb-90c3-d9788ef7bee1" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{4-y}{\\int }_{1}^{3}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-54a91fda-7695-5788-94ff-e4b59f55fda2" :answer/id #uuid "54a91fda-7695-5788-94ff-e4b59f55fda2" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{3}{\\int }_{0}^{4-y}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-c5b7dc90-6bb1-5e01-b095-98e1e090d69f" :answer/id #uuid "c5b7dc90-6bb1-5e01-b095-98e1e090d69f" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4-y}{\\int }_{0}^{3}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id 17592186388300 :question/worked-solution "![](images/e6/e6b8889f9e8025cfca1ee0ae61b67a2f7ec9ec4aee15fab78d2f418a655bbcb8.png)\n\nThe diagram above shows the region of integration. This is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{2}-1\\le x\\le 1-y\\}.\n$$\n\nTo change the order of integration, we need to split $D$ into two type I regions.\n\n![](images/52/52640b30ded8bf2cd19fe7860c7640bde3c8427ae8978f32fb8020b2f7215468.png)\n\nNotice that the bottom and top boundaries of the left region, written in the form $y=y(x),$  are \n\n$\\,$ $y=0\\,$ and $\\,y=\\sqrt{x+1}.$\n\nAlso, the bottom and top boundaries of the right region, written in the form $y=y(x),$ are\n\n$\\,$ $y=0\\,$ and $\\,y=1-x.$ \n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-1\\le x\\le 0,\\,0\\le y\\le \\sqrt{x+1}\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1-x\\}.\n$$\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{y}^{2}-1}^{1-y}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt{x+1}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{1}{\\int }_{0}^{1-x}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186388286 :question/worked-solution "![](images/9a/9a539f69187276895f8f53e2107c1959fefd0aeb7126dcff049569bfc8bc49d3.png)\n\nThe diagram above shows the region of integration. It consists of two type II regions, given by\n\n$$\n\\begin{aligned}D & =\\{(x,y)\\,:\\,-2\\le y\\le 0,\\,-y-2\\le x\\le 0\\}\\,\\cup \\,\\{(x,y)\\,:\\,0\\le y\\le 2,\\,y-2\\le x\\le 0\\}.\\end{aligned}\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx=y-2\\,⟹\\,y=x+2,\n$$\n\nand the bottom boundary of the region is\n\n$$\nx=-y-2\\,⟹\\,y=-x-2.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 0,\\,-x-2\\le y\\le x+2\\},\n$$\n\nas shown in the diagram below.\n\n![](images/ba/ba9c9132c8efdb811e63bebc05e1f46bc8cbc54bcb8246072013a75d53bcb4df.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{0}{\\int }_{-y-2}^{0}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{2}{\\int }_{y-2}^{0}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{-2}^{0}{\\int }_{-x-2}^{x+2}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186351407 :question/worked-solution "![](images/0e/0e338b779e846bc3f5ac981c93f9cda65b63d654c1152aa423f855d12d7978d9.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,x-1\\le y\\le \\sqrt{1-x}\\}.\n$$\n\nTo change the order of integration, we need to split $D$ into two type II regions. \n\n![](images/d2/d2d1df8652af81fbcb789ac05a2d1bf43f9b5b12f394159d0eb17b4ecec90042.png)\n\nNotice that the right boundary of the lower region, written in the form $x=x(y),$  is \n\n$\\,$ $x=y+1.$\n\nAlso, the right boundary of the upper region, written in the form $x=x(y),$ is\n\n$\\,$ $x=1-{y}^{2}.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-1\\le y\\le 0,\\,0\\le x\\le y+1\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le 1-{y}^{2}\\}.\n$$\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{x-1}^{\\sqrt{1-x}}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{-1}^{0}{\\int }_{0}^{y+1}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{1-{y}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-d9c15809-274b-5c74-bd5b-6fd325ecdfd9" :question/id #uuid "d9c15809-274b-5c74-bd5b-6fd325ecdfd9" :question/math-academy-id "q-82252" :question/problem "By changing the order of integration in the following double integrals, express the following sum as a single double integral.\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2-x}}f(x,y)\\,\\text{d}y\\,\\text{d}x\n$$" :question/worked-solution "![](images/20/20055a4c35ca0fdcb119e69118861d9139d23f404ecb530cf7c1b9ecf39a96d6.png)\n\nThe diagram above shows the region of integration. It consists of two type I regions, given by\n\n$$\n\\begin{aligned}D & =\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\sqrt{x}\\}\\,\\cup \\,\\{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le \\sqrt{2-x}\\}.\\end{aligned}\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny=\\sqrt{x}\\,⟹\\,x={y}^{2}\n$$\n\nand the right boundary of the region is\n\n$$\ny=\\sqrt{2-x}\\,⟹\\,x=2-{y}^{2}.\n$$\n\nTo change the order of integration we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{2}\\le x\\le 2-{y}^{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/77/77dda47f9036b7019f0d2ea5d72c1b81e5778e5d7108760a3b0394a213690304.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2-x}}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{1}{\\int }_{{y}^{2}}^{2-{y}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-16ea8257-12db-5556-b03a-96e1c697cec1"] :db/ensure [:question/validate]} {:db/id "answer-field-16ea8257-12db-5556-b03a-96e1c697cec1" :answer-field/id #uuid "16ea8257-12db-5556-b03a-96e1c697cec1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4914a934-b1d7-50ca-be47-fcf36e01d86a" :answer-field/choices ["answer-4914a934-b1d7-50ca-be47-fcf36e01d86a" "answer-fddebde7-b8f3-5e88-b6f1-a2c70fa31c30" "answer-d91f73b0-3181-5ce4-875e-090e6aaafe05" "answer-20692cf1-cecd-5e87-af98-7168623cc593" "answer-80e58883-b2bd-5526-aaab-81ed5508956f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4914a934-b1d7-50ca-be47-fcf36e01d86a" :answer/id #uuid "4914a934-b1d7-50ca-be47-fcf36e01d86a" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{{y}^{2}}^{2-{y}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-fddebde7-b8f3-5e88-b6f1-a2c70fa31c30" :answer/id #uuid "fddebde7-b8f3-5e88-b6f1-a2c70fa31c30" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2-{y}^{2}}{\\int }_{{y}^{2}}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-d91f73b0-3181-5ce4-875e-090e6aaafe05" :answer/id #uuid "d91f73b0-3181-5ce4-875e-090e6aaafe05" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{{y}^{2}}{\\int }_{2-{y}^{2}}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-20692cf1-cecd-5e87-af98-7168623cc593" :answer/id #uuid "20692cf1-cecd-5e87-af98-7168623cc593" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}}^{1}{\\int }_{0}^{2-{y}^{2}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-80e58883-b2bd-5526-aaab-81ed5508956f" :answer/id #uuid "80e58883-b2bd-5526-aaab-81ed5508956f" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}}^{2-{y}^{2}}{\\int }_{0}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-0e844cdc-bfeb-5b03-bf45-d36a53583297" :question/id #uuid "0e844cdc-bfeb-5b03-bf45-d36a53583297" :question/math-academy-id "q-82264" :question/problem "Change the order of integration in the double integral \n${\\int }_{0}^{1}{\\int }_{{x}^{2}-1}^{1-{x}^{3}}f(x,y)\\,\\text{d}y\\,\\text{d}x.$" :question/worked-solution "![](images/37/374acdaf337d1977f938fc66a19a8b933a4464f922c7e9fd45fd39a6cacf920e.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{2}-1\\le y\\le 1-{x}^{3}\\}.\n$$\n\nTo change the order of integration, we need to split $D$ into two type II regions. \n\n![](images/cf/cf06c4d0e0189b8b3e3c60af788c0aa082755db9b9fab17ed0562e79e11cabe9.png)\n\nNotice that the right boundary of the lower region, written in the form $x=x(y),$  is \n\n$\\,$ $x=\\sqrt{y+1}.$\n\nAlso, the right boundary of the upper region, written in the form $x=x(y),$ is\n\n$\\,$ $x=\\sqrt[3]{1-y}.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}=\\{(x,y)\\,:\\,-1\\le y\\le 0,\\,0\\le x\\le \\sqrt{y+1}\\}\n$$\n\nand\n\n$$\n{D}_{2}=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt[3]{1-y}\\}.\n$$\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{x}^{2}-1}^{1-{x}^{3}}f(x,y)\\,\\text{d}y\\,\\text{d}x & ={\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[3]{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-fadcac08-89d6-5545-838e-e0a8639a57f8"] :db/ensure [:question/validate]} {:db/id "answer-field-fadcac08-89d6-5545-838e-e0a8639a57f8" :answer-field/id #uuid "fadcac08-89d6-5545-838e-e0a8639a57f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-05024068-618e-5a36-97e8-3dd5f89d2e35" :answer-field/choices ["answer-bf4de389-d746-55d8-8f5b-1a6e10d06285" "answer-05024068-618e-5a36-97e8-3dd5f89d2e35" "answer-2b959dd5-0210-5775-a6ce-6f9d0418f353" "answer-c9a903b7-8c34-5a07-b341-ca2a13539df1" "answer-31b81b57-daf9-537d-9271-494c49714a7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf4de389-d746-55d8-8f5b-1a6e10d06285" :answer/id #uuid "bf4de389-d746-55d8-8f5b-1a6e10d06285" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt[3]{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-05024068-618e-5a36-97e8-3dd5f89d2e35" :answer/id #uuid "05024068-618e-5a36-97e8-3dd5f89d2e35" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{0}{\\int }_{0}^{\\sqrt{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[3]{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-2b959dd5-0210-5775-a6ce-6f9d0418f353" :answer/id #uuid "2b959dd5-0210-5775-a6ce-6f9d0418f353" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{0}{\\int }_{\\sqrt{y+1}}^{\\sqrt[3]{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-c9a903b7-8c34-5a07-b341-ca2a13539df1" :answer/id #uuid "c9a903b7-8c34-5a07-b341-ca2a13539df1" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt[3]{1-y}}^{\\sqrt{y+1}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-31b81b57-daf9-537d-9271-494c49714a7e" :answer/id #uuid "31b81b57-daf9-537d-9271-494c49714a7e" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{y+1}}^{0}{\\int }_{0}^{1}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[3]{1-y}}f(x,y)\\,\\text{d}x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-e49d891d-abb2-5ea6-ab4c-68e975346cd4" :question/id #uuid "e49d891d-abb2-5ea6-ab4c-68e975346cd4" :question/math-academy-id "q-82353" :question/problem "${\\int }_{0}^{1}{\\int }_{x/2}^{1/2}\\operatorname{sin}⁡({y}^{2})\\,\\text{d}y\\,\\text{d}x=$" :question/worked-solution "![](images/b6/b6b672e4776973f14b8ecff1fc35bcdd50c4229ade12ec74dc09c5327223c25f.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,\\frac{x}{2}\\le y\\le \\frac{1}{2}\\}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x)$ is\n\n$$\nx=0,\n$$\n\nand the right boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny=\\frac{x}{2}\\,⟹\\,x=2y.\n$$\n\nTo change the order of integration, we write $D$ as type II region. Its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le \\frac{1}{2},\\,0\\le x\\le 2y\\},\n$$\n\nas shown in the diagram below.\n\n![](images/09/09f6f71eaf66fe10e73b80ae59a30ddd04478de71dbe37c749674ac9f10d5bd4.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{x/2}^{1/2}\\operatorname{sin}⁡({y}^{2})\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{1/2}{\\int }_{0}^{2y}\\operatorname{sin}⁡({y}^{2})\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}\\operatorname{sin}⁡({y}^{2})[{\\int }_{0}^{2y}\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}\\operatorname{sin}⁡({y}^{2})[x]_{0}^{2y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}2y\\,\\operatorname{sin}⁡({y}^{2})\\,\\text{d}y \\\\  & =[-\\operatorname{cos}⁡({y}^{2})]_{0}^{1/2} \\\\  & =1-\\operatorname{cos}⁡(\\frac{1}{4}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3e37bb84-408f-59ec-be8d-27de1ffdfa7d"] :db/ensure [:question/validate]} {:db/id "answer-field-3e37bb84-408f-59ec-be8d-27de1ffdfa7d" :answer-field/id #uuid "3e37bb84-408f-59ec-be8d-27de1ffdfa7d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-923eb37f-43b5-5b42-9f6f-7c5f6423cc9c" :answer-field/choices ["answer-5b1155cd-f35f-5f58-8850-39c81d2ccf9e" "answer-923eb37f-43b5-5b42-9f6f-7c5f6423cc9c" "answer-7c39c2ee-43ff-5cba-b1e9-66bab554cd0a" "answer-8a2dc93b-07d2-5d02-9f1c-9af81857b7f7" "answer-a9e5f989-9f92-5708-89bc-01325d6b63d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b1155cd-f35f-5f58-8850-39c81d2ccf9e" :answer/id #uuid "5b1155cd-f35f-5f58-8850-39c81d2ccf9e" :answer/type :answer.type/math :answer/value "1-\\operatorname{cos}⁡(\\frac{1}{2})" :db/ensure [:answer/validate]} {:db/id "answer-923eb37f-43b5-5b42-9f6f-7c5f6423cc9c" :answer/id #uuid "923eb37f-43b5-5b42-9f6f-7c5f6423cc9c" :answer/type :answer.type/math :answer/value "1-\\operatorname{cos}⁡(\\frac{1}{4})" :db/ensure [:answer/validate]} {:db/id "answer-7c39c2ee-43ff-5cba-b1e9-66bab554cd0a" :answer/id #uuid "7c39c2ee-43ff-5cba-b1e9-66bab554cd0a" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{1}{2})+1" :db/ensure [:answer/validate]} {:db/id "answer-8a2dc93b-07d2-5d02-9f1c-9af81857b7f7" :answer/id #uuid "8a2dc93b-07d2-5d02-9f1c-9af81857b7f7" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{1}{2})-1" :db/ensure [:answer/validate]} {:db/id "answer-a9e5f989-9f92-5708-89bc-01325d6b63d4" :answer/id #uuid "a9e5f989-9f92-5708-89bc-01325d6b63d4" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{1}{4})" :db/ensure [:answer/validate]} {:db/id 17592186326683 :question/worked-solution "![](images/a8/a85f82756c621bf88b95451f54343be863345278f361fd0f0dd82f5d01c0cb5b.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le 1\\}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\nx=0,\n$$\n\nand the right boundary is\n\n$$\ny={x}^{3}\\,⟹\\,x=\\sqrt[3]{y}.\n$$\n\nTo change the order of integration, we write $D$ as a type II region. Its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le \\sqrt[3]{y}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/82/8243a8c60e4b8b4846d330a00a090d6f93f94f17323c1d0a88d486ba77745451.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{x}^{3}}^{1}\\frac{3{x}^{5}}{\\sqrt{{x}^{6}+{y}^{2}}}\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt[3]{y}}\\frac{3{x}^{5}}{\\sqrt{{x}^{6}+{y}^{2}}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{\\sqrt[3]{y}}\\frac{3{x}^{5}}{\\sqrt{{x}^{6}+{y}^{2}}}\\,\\text{d}x]\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}3{[\\frac{2}{6}\\sqrt{{x}^{6}+{y}^{2}}]}_{0}^{\\sqrt[3]{y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(\\sqrt{2{y}^{2}}-\\sqrt{{y}^{2}})\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y(\\sqrt{2}-1)\\,\\text{d}y \\\\  & =\\frac{(\\sqrt{2}-1)}{2}[{y}^{2}]_{0}^{1} \\\\  & =\\frac{\\sqrt{2}-1}{2}(1-0) \\\\  & =\\frac{\\sqrt{2}-1}{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186129653 :question/problem "${\\int }_{0}^{4}{\\int }_{\\sqrt{x}}^{2}\\operatorname{cos}⁡({y}^{3}+\\pi )\\,\\text{d}y\\,\\text{d}x=$" :question/worked-solution "![](images/19/19d2d5698ad6b22c003b44d1a023c56ae7779a6d26345732bace3723062f6e0d.png)\n\nThe diagram above shows the region of integration. This is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 4,\\,\\sqrt{x}\\le y\\le 2\\}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x)$ is\n\n$$\nx=0,\n$$\n\nand the right boundary of the region, written in the form $y=y(x),$ is\n\n$$\ny=\\sqrt{x}\\,⟹\\,x={y}^{2}.\n$$\n\nTo change the order of integration, we write $D$ as type II region. Its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,0\\le x\\le {y}^{2}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/81/81596115241d43f3935ba9e055a3c748c1c1ae283aa2a6a372492ee8c68170cd.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}{\\int }_{\\sqrt{x}}^{2}\\operatorname{cos}⁡({y}^{3}+\\pi )\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{2}{\\int }_{0}^{{y}^{2}}\\operatorname{cos}⁡({y}^{3}+\\pi )\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\operatorname{cos}⁡({y}^{3}+\\pi )[{\\int }_{0}^{{y}^{2}}\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{2}\\operatorname{cos}⁡({y}^{3}+\\pi )[x]_{0}^{{y}^{2}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{y}^{2}\\operatorname{cos}⁡({y}^{3}+\\pi )\\,\\text{d}y \\\\  & ={[\\frac{\\operatorname{sin}⁡({y}^{3}+\\pi )}{3}]}_{0}^{2} \\\\  & =\\frac{1}{3}(\\operatorname{sin}⁡(8+\\pi )-\\operatorname{sin}⁡\\pi ) \\\\  & =\\frac{\\operatorname{sin}⁡(8+\\pi )}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186127399 :answer-field/correct "answer-d0891b4c-ffff-5f35-831c-5eceb85dcec4" :answer-field/choices ["answer-6478e2d3-fb7a-5c05-b45c-327c0ff72c90" "answer-34c39f6b-c2a5-5718-bc9c-ca24f1e0d9c6" "answer-b5a2d58c-36ab-574d-b5e5-fd1bd11ca515" "answer-d0891b4c-ffff-5f35-831c-5eceb85dcec4" "answer-017629d6-f5b2-5b5c-9795-46c0001e34b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-6478e2d3-fb7a-5c05-b45c-327c0ff72c90" :answer/id #uuid "6478e2d3-fb7a-5c05-b45c-327c0ff72c90" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{sin}⁡(8+\\pi )}{3}" :db/ensure [:answer/validate]} {:db/id "answer-34c39f6b-c2a5-5718-bc9c-ca24f1e0d9c6" :answer/id #uuid "34c39f6b-c2a5-5718-bc9c-ca24f1e0d9c6" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡(8+\\pi )" :db/ensure [:answer/validate]} {:db/id "answer-b5a2d58c-36ab-574d-b5e5-fd1bd11ca515" :answer/id #uuid "b5a2d58c-36ab-574d-b5e5-fd1bd11ca515" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡(4-\\pi )}{3}" :db/ensure [:answer/validate]} {:db/id "answer-d0891b4c-ffff-5f35-831c-5eceb85dcec4" :answer/id #uuid "d0891b4c-ffff-5f35-831c-5eceb85dcec4" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡(8+\\pi )}{3}" :db/ensure [:answer/validate]} {:db/id "answer-017629d6-f5b2-5b5c-9795-46c0001e34b0" :answer/id #uuid "017629d6-f5b2-5b5c-9795-46c0001e34b0" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(4-\\pi )" :db/ensure [:answer/validate]} {:db/id "question-cb97248a-192c-5cf9-ad2e-d068b8748779" :question/id #uuid "cb97248a-192c-5cf9-ad2e-d068b8748779" :question/math-academy-id "q-132646" :question/problem "${\\int }_{0}^{\\operatorname{ln}⁡5}{\\int }_{{e}^{y}}^{5}\\operatorname{sin}⁡(x\\operatorname{ln}⁡x-x)\\,\\text{d}x\\,\\text{d}y=$" :question/worked-solution "![](images/7e/7e0a0b1860f316f7954e85b9d7f6567d9e0c05bf316cb8af3901037abe6fd17e.png)\n\nThe diagram above shows the region of integration. It is a type II region, and its type II representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le \\operatorname{ln}⁡5,\\,{e}^{y}\\le x\\le 5\\}.\n$$\n\nNotice that the top boundary of the region, written in the form $x=x(y),$ is\n\n$$\nx={e}^{y}\\,⟹\\,y=\\operatorname{ln}⁡x,\n$$\n\nand the bottom boundary of the region is\n\n$$\ny=0.\n$$\n\nTo change the order of integration, we write $D$ as a type I region. The type I representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,1\\le x\\le 5,\\,0\\le y\\le \\operatorname{ln}⁡x\\},\n$$\n\nas shown in the diagram below.\n\n![](images/3c/3c95dd90ad02ab708f5893e47e7d7d0c8a212c18aed1972fb1bba1362181c383.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\operatorname{ln}⁡5}{\\int }_{{e}^{y}}^{5}\\operatorname{sin}⁡(x\\operatorname{ln}⁡x-x)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{1}^{5}{\\int }_{0}^{\\operatorname{ln}⁡x}\\operatorname{sin}⁡(x\\operatorname{ln}⁡x-x)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{1}^{5}\\operatorname{sin}⁡(x\\operatorname{ln}⁡x-x)[{\\int }_{0}^{\\operatorname{ln}⁡x}\\text{d}y]\\text{d}x \\\\  & ={\\int }_{1}^{5}\\operatorname{sin}⁡(x\\operatorname{ln}⁡x-x)\\cdot y\\,{|}_{0}^{\\operatorname{ln}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{5}\\operatorname{ln}⁡x\\cdot \\operatorname{sin}⁡(x\\operatorname{ln}⁡x-x)\\,\\text{d}x \\\\  & =-\\operatorname{cos}⁡(x\\operatorname{ln}⁡x-x)\\,{|}_{1}^{5} \\\\  & =-\\operatorname{cos}⁡(5\\operatorname{ln}⁡5-5)+\\operatorname{cos}⁡(1\\operatorname{ln}⁡1-1) \\\\  & =\\operatorname{cos}⁡1-\\operatorname{cos}⁡(5\\operatorname{ln}⁡5-5).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-37f743ed-c677-5ee3-8526-cdbc90d5f567"] :db/ensure [:question/validate]} {:db/id "answer-field-37f743ed-c677-5ee3-8526-cdbc90d5f567" :answer-field/id #uuid "37f743ed-c677-5ee3-8526-cdbc90d5f567" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a4ebc04f-9119-59a3-af0b-d5a0399f055f" :answer-field/choices ["answer-a4ebc04f-9119-59a3-af0b-d5a0399f055f" "answer-04acf838-dfd5-5334-97f8-7fa942e66fe0" "answer-8a9f9754-8306-5ac4-b4ad-620d9f3a59d6" "answer-a28f7432-b412-5573-afe3-367aec0ba7b7" "answer-b5d5f637-b439-5a31-862f-b75cf4d380cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4ebc04f-9119-59a3-af0b-d5a0399f055f" :answer/id #uuid "a4ebc04f-9119-59a3-af0b-d5a0399f055f" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡1-\\operatorname{cos}⁡(5\\operatorname{ln}⁡5-5)" :db/ensure [:answer/validate]} {:db/id "answer-04acf838-dfd5-5334-97f8-7fa942e66fe0" :answer/id #uuid "04acf838-dfd5-5334-97f8-7fa942e66fe0" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡1-\\operatorname{cos}⁡(8\\operatorname{ln}⁡2-4)" :db/ensure [:answer/validate]} {:db/id "answer-8a9f9754-8306-5ac4-b4ad-620d9f3a59d6" :answer/id #uuid "8a9f9754-8306-5ac4-b4ad-620d9f3a59d6" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡2-\\operatorname{cos}⁡(3\\operatorname{ln}⁡3-3)" :db/ensure [:answer/validate]} {:db/id "answer-a28f7432-b412-5573-afe3-367aec0ba7b7" :answer/id #uuid "a28f7432-b412-5573-afe3-367aec0ba7b7" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡2-\\operatorname{cos}⁡(8\\operatorname{ln}⁡2-4)" :db/ensure [:answer/validate]} {:db/id "answer-b5d5f637-b439-5a31-862f-b75cf4d380cd" :answer/id #uuid "b5d5f637-b439-5a31-862f-b75cf4d380cd" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡3-\\operatorname{cos}⁡(6\\operatorname{ln}⁡6-6)" :db/ensure [:answer/validate]} {:db/id 17592186268897 :question/worked-solution "![](images/26/262e1b0c4e0ddf338c527b487fcadc85baac12712f91cb4c54b771e49add25b9.png)\n\nThe diagram above shows the region of integration. It is a type I region, and its type I representation is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 4-{x}^{2}\\}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\nx=0,\n$$\n\nand the right boundary of the region is\n\n$$\ny=4-{x}^{2}\\,⟹\\,x=\\sqrt{4-y}.\n$$\n\nTo change the order of integration, we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 4,\\,0\\le x\\le \\sqrt{4-y}\\},\n$$\n\nas shown in the diagram below.\n\n![](images/48/48c874b069b55599f76a8fe1aa50c5f4db36ff8943d264a107452668d689174b.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{4-{x}^{2}}4x{e}^{8y-{y}^{2}}\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{4-y}}4x{e}^{8y-{y}^{2}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}{e}^{8y-{y}^{2}}[{\\int }_{0}^{\\sqrt{4-y}}4x\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{4}{e}^{8y-{y}^{2}}\\cdot 2{x}^{2}\\,{|}_{0}^{\\sqrt{4-y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}2(4-y){e}^{8y-{y}^{2}}\\,\\text{d}y \\\\  & ={e}^{8y-{y}^{2}}\\,{|}_{0}^{4} \\\\  & ={e}^{8(4)-{4}^{2}}-{e}^{8(0)-{0}^{2}} \\\\  & ={e}^{16}-1.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186129342 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} [:db/retract 17592186131875 :answer-field/choices 17592186131876] [:db/retract 17592186131875 :answer-field/choices 17592186131877] [:db/retract 17592186131875 :answer-field/choices 17592186131878] [:db/retract 17592186131875 :answer-field/choices 17592186131879] [:db/retract 17592186131875 :answer-field/choices 17592186131880] {:db/id 17592186133838 :knowledge-point/questions ["question-9802711d-167f-5fa9-b90b-5993685135b7" "question-c16e9cb6-870f-5672-9efc-e4072f4b672a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133840 :knowledge-point/questions ["question-1a83ee34-1dbf-5891-a221-8c81f41c4ea4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186133841 :knowledge-point/questions ["question-a9c36b7d-47cc-5c7c-bf98-1c203381319d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186268862 :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/85/85d3faac9a27353a8ea5151b3a32f1065aecb02fd07e0b20727c35de0a7fb216.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,{y}^{2}-4\\le x\\le 4-{y}^{2}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{2}-4}^{4-{y}^{2}}f(x,y)\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{2}-4}^{4-{y}^{2}}f(x,y)\\,dx]dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-9802711d-167f-5fa9-b90b-5993685135b7" :question/id #uuid "9802711d-167f-5fa9-b90b-5993685135b7" :question/math-academy-id "q-81235" :question/problem "![](images/c9/c94c22139b5efb671b999a08b926eb7c25672eab6fcbefec886ce8523a82788f.png)\n\nIf $D$ is the finite region enclosed by the curves $x=\\frac{1}{4}(16-{y}^{2}),\\,$ $x=4-y,$ and the line $y=1,$ as shown above, then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/e1/e18c6c41d8fb3ffd15bd31741c849094055dbe3090c524e7645ba6463672d23d.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,1\\le y\\le 4,\\,4-y\\le x\\le \\frac{1}{4}(16-{y}^{2})\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{1}^{4}{\\int }_{4-y}^{(16-{y}^{2})/4}f(x,y)\\,dx\\,dy \\\\  & ={\\int }_{1}^{4}[{\\int }_{4-y}^{(16-{y}^{2})/4}f(x,y)\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-35eca8e7-8a6a-55fb-8c74-791eef5e403a"] :db/ensure [:question/validate]} {:db/id "answer-field-35eca8e7-8a6a-55fb-8c74-791eef5e403a" :answer-field/id #uuid "35eca8e7-8a6a-55fb-8c74-791eef5e403a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c0e735a3-6961-591b-af1d-548b88828135" :answer-field/choices ["answer-d27c3e19-30a2-58ae-b871-a1681a570303" "answer-ce17ec5c-4d49-56a6-b9e5-5a66a85b4bea" "answer-85e43e9a-8f5e-52ce-8d25-65c7198df5c1" "answer-c0e735a3-6961-591b-af1d-548b88828135" "answer-0bd89acc-38db-57cd-a1f8-4c035d4d2152"] :db/ensure [:answer-field/validate]} {:db/id "answer-d27c3e19-30a2-58ae-b871-a1681a570303" :answer/id #uuid "d27c3e19-30a2-58ae-b871-a1681a570303" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{(16-{y}^{2})/4}[{\\int }_{4-y}^{4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-ce17ec5c-4d49-56a6-b9e5-5a66a85b4bea" :answer/id #uuid "ce17ec5c-4d49-56a6-b9e5-5a66a85b4bea" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4-y}[{\\int }_{4}^{(16-{y}^{2})/4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-85e43e9a-8f5e-52ce-8d25-65c7198df5c1" :answer/id #uuid "85e43e9a-8f5e-52ce-8d25-65c7198df5c1" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}[{\\int }_{(16-{y}^{2})/4}^{4-y}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-c0e735a3-6961-591b-af1d-548b88828135" :answer/id #uuid "c0e735a3-6961-591b-af1d-548b88828135" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}[{\\int }_{4-y}^{(16-{y}^{2})/4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-0bd89acc-38db-57cd-a1f8-4c035d4d2152" :answer/id #uuid "0bd89acc-38db-57cd-a1f8-4c035d4d2152" :answer/type :answer.type/math :answer/value "{\\int }_{4-y}^{4}[{\\int }_{1}^{(16-{y}^{2})/4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id 17592186380985 :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/72/72cf3a4044e83e63e579b00d3ca246071787ed4d6b44e4e22fcf963dc10917b4.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,1\\le x\\le (y-1)^{2}+2\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{1}^{(y-1)^{2}+2}xy\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{1}^{(y-1)^{2}+2}xy\\,dx]dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-c16e9cb6-870f-5672-9efc-e4072f4b672a" :question/id #uuid "c16e9cb6-870f-5672-9efc-e4072f4b672a" :question/math-academy-id "q-132388" :question/problem "![](images/9c/9c684a6eaf9961b441cb559656aa2689ed0f25f61add19094df16e617ece8daf.png)\n\nIf $D$ is the finite region enclosed by the curves $x=\\frac{1}{8}{y}^{3},\\,$ $x=3-y,$ and $y=0,$ as shown above, then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/2d/2dcc8a77fea8a9fd3e95022edcd86e0a040c54fd30d88a7931c0542fdeaefd0b.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,\\frac{1}{8}{y}^{3}\\le x\\le 3-y\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{3}/8}^{3-y}f(x,y)\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{3}/8}^{3-y}f(x,y)\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-744f55b6-6eed-5e1b-b5e4-d4fa4c34046b"] :db/ensure [:question/validate]} {:db/id "answer-field-744f55b6-6eed-5e1b-b5e4-d4fa4c34046b" :answer-field/id #uuid "744f55b6-6eed-5e1b-b5e4-d4fa4c34046b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2a5249f3-ca45-56a6-b574-91443e6bc86e" :answer-field/choices ["answer-00ed1d86-32de-5d67-aa19-93461d9e2481" "answer-2a5249f3-ca45-56a6-b574-91443e6bc86e" "answer-ba2c7f9a-ab99-52de-9af7-323fe893b09b" "answer-83f59ee4-8854-554e-8d45-50a43a2ba821" "answer-e2729abb-d481-536b-a55b-43bf63e88602"] :db/ensure [:answer-field/validate]} {:db/id "answer-00ed1d86-32de-5d67-aa19-93461d9e2481" :answer/id #uuid "00ed1d86-32de-5d67-aa19-93461d9e2481" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{3-y}^{{y}^{3}/8}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-2a5249f3-ca45-56a6-b574-91443e6bc86e" :answer/id #uuid "2a5249f3-ca45-56a6-b574-91443e6bc86e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{{y}^{3}/8}^{3-y}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-ba2c7f9a-ab99-52de-9af7-323fe893b09b" :answer/id #uuid "ba2c7f9a-ab99-52de-9af7-323fe893b09b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3-y}[{\\int }_{{y}^{3}/8}^{2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-83f59ee4-8854-554e-8d45-50a43a2ba821" :answer/id #uuid "83f59ee4-8854-554e-8d45-50a43a2ba821" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{3}/8}^{2}[{\\int }_{0}^{3-y}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "answer-e2729abb-d481-536b-a55b-43bf63e88602" :answer/id #uuid "e2729abb-d481-536b-a55b-43bf63e88602" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{3}/8}^{3-y}[{\\int }_{0}^{2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id 17592186351280 :question/worked-solution "First, let's represent $D$ as a type II region. Writing $y={x}^{2}$ and $y=\\sqrt{x-2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y={x}^{2} & \\,⟹\\,x=\\sqrt{y} \\\\ y=\\sqrt{x-2} & \\,⟹\\,x={y}^{2}+2\\end{aligned}\n$$\n\nTo determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/bb/bb3249a9580e754c4ef9c33239c2a51a9b57ca9032a6acbeef7bbc532b2d4345.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,\\sqrt{y}\\le x\\le {y}^{2}+2\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{xy}{1+{y}^{2}}\\,dA & ={\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{{y}^{2}+2}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186381020 :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\frac{1}{4}{y}^{2}+1 & ={y}^{2}-2 \\\\ \\frac{3}{4}{y}^{2}-3 & =0 \\\\ {y}^{2}-4 & =0 \\\\ (y-2)(y+2) & =0\\end{aligned}\n$$\n\nSo, since our region lies above the $x$-axis, the $y$-limits are\n$0\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/9e/9ed5a24f07ad025cbf47d664ac2c9e2f6525e43b0bc73c0b25eb7e3e5c60ac47.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,{y}^{2}-2\\le x\\le \\frac{1}{4}{y}^{2}+1\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}(x-{y}^{2})\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{2}-2}^{{y}^{2}/4+1}(x-{y}^{2})\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{2}-2}^{{y}^{2}/4+1}(x-{y}^{2})\\,dx]dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186381027 :question/worked-solution "First, let's make a sketch of our region.\n\n![](images/c4/c4531d05ef2634d04e590b099ba5ec0269c9c00f12dce82442043cad4377db1a.png)\n\nWe need to represent $D$ as a type II region. Writing $y=\\sqrt{-x}$ and $y=\\frac{1}{2}(x+3)$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y=\\sqrt{-x} & \\,⟹\\,x=-{y}^{2} \\\\ y=\\frac{1}{2}(x+3) & \\,⟹\\,x=2y-3\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}-{y}^{2} & =2y-3 \\\\ {y}^{2}+2y-3 & =0 \\\\ (y+3)(y-1) & =0\\end{aligned}\n$$\n\nSo, since our region lies above the $x$-axis, the $y$-limits are \n$0\\le y\\le 1.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/31/3187c1520326caf6d009cacaf8b13bfc58a3e0eadbbdfd7aab01fb0d4154f476.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,2y-3\\le x\\le -{y}^{2}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{1}{\\int }_{2y-3}^{-{y}^{2}}f(x,y)\\,dx\\,dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186351283 :question/worked-solution "First, let's make a sketch of our region.\n\n![](images/22/2209e57f8cbe84ccf2f930c5cd3004ff5009dfb72f3e4b3262517cf9b8f2b119.png)\n\nWe need to represent $D$ as a type II region. Writing $y=\\frac{1}{x}$ and $y=\\frac{x}{2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y=\\frac{1}{x} & \\,⟹\\,x=\\frac{1}{y} \\\\ y=\\frac{x}{2} & \\,⟹\\,x=2y\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\frac{1}{y} & =2y \\\\ 2y-\\frac{1}{y} & =0 \\\\ \\frac{2{y}^{2}-1}{y} & =0 \\\\ 2{y}^{2}-1 & =0 \\\\ {y}^{2} & =\\frac{1}{2} \\\\ y & =\\pm \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSo, since our region lies in the first quadrant below the line $y=2$ the $y$-limits are \n$\\frac{\\sqrt{2}}{2}\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/1b/1b03741537734087836c22dbb40e2e188825bade657cff129374efe1596bcb3c.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,\\frac{\\sqrt{2}}{2}\\le y\\le 2,\\,\\frac{1}{y}\\le x\\le 2y\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{\\sqrt{2}/2}^{2}{\\int }_{1/y}^{2y}f(x,y)\\,dx\\,dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186407920 :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}8-{y}^{2} & ={y}^{2} \\\\ 8 & =2{y}^{2} \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nSo, $y$-limits are \n$0\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/27/2722224678aeb1f9ea64f42de2dc4fbf6e139350c291de16500957575fd23850.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,{y}^{2}\\le x\\le 8-{y}^{2}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\operatorname{ln}⁡(xy)\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{2}}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{2}}^{8-{y}^{2}}\\operatorname{ln}⁡(xy)\\,dx]dy\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186134306 :question/problem "Consider the finite region $D$ in the $xy$-plane enclosed between the curves $y=2x$ and $y={x}^{2}$ above the line $y=2.$ What is ${∬}_{D}f(x,y)\\,dA\\,$ expressed as a repeated integral?" :question/worked-solution "First, let's make a sketch of our region.\n\n![](images/4e/4e58d7969f0b31206ae8c3385a857c0ad6cf8a42ee79909d51c3a6b58a090852.png)\n\nWe need to represent $D$ as a type II region. Writing $y=2x$ and $y={x}^{2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y=2x & \\,⟹\\,x=\\frac{y}{2} \\\\ y={x}^{2} & \\,⟹\\,x=\\sqrt{y}\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\sqrt{y} & =\\frac{y}{2} \\\\ y & =\\frac{{y}^{2}}{4} \\\\ {y}^{2}-4y & =0 \\\\ y(y-4) & =0\\end{aligned}\n$$\n\nSo, since our region lies above the line $y=2,$ the $y$-limits are \n$2\\le y\\le 4.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/16/16944d6651297f1c13c39ddf3d9160d721f5f29bfa6b0acac0db46c88295964e.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,2\\le y\\le 4,\\,\\frac{y}{2}\\le x\\le \\sqrt{y}\\}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{2}^{4}{\\int }_{y/2}^{\\sqrt{y}}f(x,y)\\,dx\\,dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186131875 :answer-field/correct "answer-dc4f557a-0393-5b7c-9aa1-df8febbf44fa" :answer-field/choices ["answer-c020b011-abec-5f74-a0d6-2e493cdf3a8d" "answer-ce6d84dc-f6bf-5a95-aef6-2d114a0e442f" "answer-dc4f557a-0393-5b7c-9aa1-df8febbf44fa" "answer-b50cbc81-f2c6-5823-bd95-abc058fa081b" "answer-28685095-749a-5991-9be2-402bf87a4783"] :db/ensure [:answer-field/validate]} {:db/id "answer-c020b011-abec-5f74-a0d6-2e493cdf3a8d" :answer/id #uuid "c020b011-abec-5f74-a0d6-2e493cdf3a8d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt{y}}{\\int }_{2}^{y/2}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "answer-ce6d84dc-f6bf-5a95-aef6-2d114a0e442f" :answer/id #uuid "ce6d84dc-f6bf-5a95-aef6-2d114a0e442f" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{4}{\\int }_{\\sqrt{y}}^{y/2}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "answer-dc4f557a-0393-5b7c-9aa1-df8febbf44fa" :answer/id #uuid "dc4f557a-0393-5b7c-9aa1-df8febbf44fa" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{4}{\\int }_{y/2}^{\\sqrt{y}}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "answer-b50cbc81-f2c6-5823-bd95-abc058fa081b" :answer/id #uuid "b50cbc81-f2c6-5823-bd95-abc058fa081b" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{\\sqrt{y}}{\\int }_{0}^{y/2}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "answer-28685095-749a-5991-9be2-402bf87a4783" :answer/id #uuid "28685095-749a-5991-9be2-402bf87a4783" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{y/2}{\\int }_{0}^{\\sqrt{y}}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "question-1a83ee34-1dbf-5891-a221-8c81f41c4ea4" :question/id #uuid "1a83ee34-1dbf-5891-a221-8c81f41c4ea4" :question/math-academy-id "q-132416" :question/problem "${\\int }_{1}^{2}{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx\\,dy=$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx\\,dy & ={\\int }_{1}^{2}[{\\int }_{0}^{\\operatorname{ln}⁡y}y{e}^{x}\\,dx]dy \\\\  & ={\\int }_{1}^{2}[y{e}^{x}]_{0}^{\\operatorname{ln}⁡y}\\,dy \\\\  & ={\\int }_{1}^{2}(y{e}^{\\operatorname{ln}⁡y}-y{e}^{0})\\,dy \\\\  & ={\\int }_{1}^{2}({y}^{2}-y)\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}-y)\\,dy & ={[\\frac{1}{3}{y}^{3}-\\frac{1}{2}{y}^{2}]}_{1}^{2} \\\\  & =(\\frac{8}{3}-2)-(\\frac{1}{3}-\\frac{1}{2}) \\\\  & =\\frac{2}{3}+\\frac{1}{6} \\\\  & =\\frac{5}{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-91ff3f61-f524-514d-8f8d-a3656c78181d"] :db/ensure [:question/validate]} {:db/id "answer-field-91ff3f61-f524-514d-8f8d-a3656c78181d" :answer-field/id #uuid "91ff3f61-f524-514d-8f8d-a3656c78181d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e9be5c54-8a82-5427-b59e-3743cfd14a94" :answer-field/choices ["answer-277a4541-6f08-5e3e-838b-f01d1516b21c" "answer-a50ad013-8b48-5e43-a2a6-1c682d4792ab" "answer-95a06dc1-9e17-565e-a31f-ef0e8161e3db" "answer-b4c25026-72a4-58f2-a297-df0a533795e8" "answer-e9be5c54-8a82-5427-b59e-3743cfd14a94"] :db/ensure [:answer-field/validate]} {:db/id "answer-277a4541-6f08-5e3e-838b-f01d1516b21c" :answer/id #uuid "277a4541-6f08-5e3e-838b-f01d1516b21c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-a50ad013-8b48-5e43-a2a6-1c682d4792ab" :answer/id #uuid "a50ad013-8b48-5e43-a2a6-1c682d4792ab" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-95a06dc1-9e17-565e-a31f-ef0e8161e3db" :answer/id #uuid "95a06dc1-9e17-565e-a31f-ef0e8161e3db" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-b4c25026-72a4-58f2-a297-df0a533795e8" :answer/id #uuid "b4c25026-72a4-58f2-a297-df0a533795e8" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "answer-e9be5c54-8a82-5427-b59e-3743cfd14a94" :answer/id #uuid "e9be5c54-8a82-5427-b59e-3743cfd14a94" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id 17592186268873 :question/problem "Calculate ${∬}_{D}\\frac{{x}^{2}}{y}\\,dA,$ where $D=\\{(x,y)\\,:\\,1\\le y\\le 2,\\,0\\le x\\le {y}^{2}\\}.$" :question/worked-solution "The integral is defined over a type II region $D=\\{(x,y)\\,:\\,1\\le y\\le 2,\\,0\\le x\\le {y}^{2}\\}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{{x}^{2}}{y}\\,dA & ={\\int }_{1}^{2}{\\int }_{0}^{{y}^{2}}\\frac{{x}^{2}}{y}\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{0}^{{y}^{2}}\\frac{{x}^{2}}{y}\\,dx\\,dy & ={\\int }_{1}^{2}\\frac{1}{y}[{\\int }_{0}^{{y}^{2}}{x}^{2}\\,dx]dy \\\\  & ={\\int }_{1}^{2}\\frac{1}{y}{[\\frac{1}{3}{x}^{3}]}_{0}^{{y}^{2}}\\,dy \\\\  & ={\\int }_{1}^{2}\\frac{1}{y}(\\frac{1}{3}{y}^{6}-0)dy \\\\  & ={\\int }_{1}^{2}\\frac{1}{3}{y}^{5}\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{3}{y}^{5}\\,dy & =\\frac{1}{3}{\\int }_{1}^{2}{y}^{5}\\,dy \\\\  & =\\frac{1}{3}{[\\frac{1}{6}{y}^{6}]}_{1}^{2} \\\\  & =\\frac{1}{3}(\\frac{32}{3}-\\frac{1}{6}) \\\\  & =\\frac{1}{3}\\cdot \\frac{21}{2} \\\\  & =\\frac{7}{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186382490 :question/problem "Calculate ${∬}_{D}y{e}^{x}\\,dA,$ where $D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{2}\\le x\\le 2-{y}^{2}\\}.$" :question/worked-solution "The integral is defined over a type II region $D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{2}\\le x\\le 2-{y}^{2}\\}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}y{e}^{x}\\,dA & ={\\int }_{0}^{1}{\\int }_{{y}^{2}}^{2-{y}^{2}}(y\\cdot {e}^{x})\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{{y}^{2}}^{2-{y}^{2}}(y\\cdot {e}^{x})\\,dx\\,dy & ={\\int }_{0}^{1}y[{\\int }_{{y}^{2}}^{2-{y}^{2}}{e}^{x}\\,dx]dy \\\\  & ={\\int }_{0}^{1}y[{e}^{x}]_{{y}^{2}}^{2-{y}^{2}}\\,dy \\\\  & ={\\int }_{0}^{1}y({e}^{2-{y}^{2}}-{e}^{{y}^{2}})dy \\\\  & ={\\int }_{0}^{1}(y{e}^{2-{y}^{2}}-y{e}^{{y}^{2}})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(y{e}^{2-{y}^{2}}-y{e}^{{y}^{2}})\\,dy & ={[-\\frac{1}{2}{e}^{2-{y}^{2}}-\\frac{1}{2}{e}^{{y}^{2}}]}_{0}^{1} \\\\  & =-\\frac{1}{2}({e}^{1}+{e}^{1}-({e}^{2}+{e}^{0})) \\\\  & =\\frac{{e}^{2}-2e+1}{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186407922 :question/worked-solution "Notice that $D$ is a type II region. Since $x\\ge 0,$ we obtain the following equations in terms of $y:$\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=4 & \\,⟹\\,x=\\sqrt{4-{y}^{2}} \\\\ y=2-x & \\,⟹\\,x=2-y\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\sqrt{4-{y}^{2}} & =2-y \\\\ 4-{y}^{2} & =(2-y)^{2} \\\\ 4-{y}^{2} & =4-4y+{y}^{2} \\\\ 2{y}^{2}-4y & =0 \\\\ y(y-2) & =0\\end{aligned}\n$$\n\nSo, since our region lies above the line $y=1,$ the $y$-limits are \n$1\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/f8/f8fedf15e26f64fc344bd7db6ffaa659bd7c130f36f4a39389b6108136836104.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,1\\le y\\le 2,\\,2-y\\le x\\le \\sqrt{4-{y}^{2}}\\}.\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}x\\,dA={\\int }_{1}^{2}{\\int }_{2-y}^{\\sqrt{4-{y}^{2}}}\\,x\\,dx\\,dy\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{\\int }_{2-y}^{\\sqrt{4-{y}^{2}}}\\,x\\,dx\\,dy & ={\\int }_{1}^{2}[{\\int }_{2-y}^{\\sqrt{4-{y}^{2}}}x\\,dx]dy \\\\  & ={\\int }_{1}^{2}\\,\\frac{1}{2}[\\,{x}^{2}\\,]_{2-y}^{\\sqrt{4-{y}^{2}}}\\text{ }dy \\\\  & ={\\int }_{1}^{2}\\,\\frac{1}{2}(4-{y}^{2}-(2-y)^{2})dy \\\\  & ={\\int }_{1}^{2}\\,(2y-{y}^{2})dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\,(2y-{y}^{2})dy & ={[{y}^{2}-\\frac{{y}^{3}}{3}]}_{1}^{2} \\\\  & =(4-\\frac{8}{3})-(1-\\frac{1}{3}) \\\\  & =\\frac{2}{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-a9c36b7d-47cc-5c7c-bf98-1c203381319d" :question/id #uuid "a9c36b7d-47cc-5c7c-bf98-1c203381319d" :question/math-academy-id "q-132532" :question/problem "Calculate ${∬}_{D}2y{e}^{x}\\,dA,$ where $D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le {y}^{2}\\}.$" :question/worked-solution "The integral is defined over a type II region $D=\\{(x,y)\\,:\\,0\\le y\\le 1,\\,0\\le x\\le {y}^{2}\\}.$\n\nSo, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}2y{e}^{x}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{{y}^{2}}2y{e}^{x}\\,dx\\,dy\\end{aligned}\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{{y}^{2}}2y{e}^{x}\\,dx\\,dy & ={\\int }_{0}^{1}2y[{\\int }_{0}^{{y}^{2}}{e}^{x}\\,dx]dy \\\\  & ={\\int }_{0}^{1}2y[\\,{e}^{x}\\,]_{0}^{{y}^{2}}\\,dy \\\\  & ={\\int }_{0}^{1}2y({e}^{{y}^{2}}-{e}^{0})\\,dy \\\\  & ={\\int }_{0}^{1}(2y{e}^{{y}^{2}}-2y)\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(2y{e}^{{y}^{2}}-2y)\\,dy & ={[{e}^{{y}^{2}}-{y}^{2}]}_{0}^{1} \\\\  & =({e}^{1}-1)-({e}^{0}-0) \\\\  & =e-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9057d0d2-ba1b-5966-80e3-02c53e2d8441"] :db/ensure [:question/validate]} {:db/id "answer-field-9057d0d2-ba1b-5966-80e3-02c53e2d8441" :answer-field/id #uuid "9057d0d2-ba1b-5966-80e3-02c53e2d8441" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7ac6117c-6ac7-5259-8419-7056da507f1e" :answer-field/choices ["answer-561c97d2-3393-5c66-a355-2e331ac87f03" "answer-770dffba-b473-54d0-8c91-375e002f00da" "answer-7ac6117c-6ac7-5259-8419-7056da507f1e" "answer-b0edc4cf-07e5-5251-add3-83a790ba9c3a" "answer-91dabac6-48a9-50c8-9bb2-f954d8bd6dda"] :db/ensure [:answer-field/validate]} {:db/id "answer-561c97d2-3393-5c66-a355-2e331ac87f03" :answer/id #uuid "561c97d2-3393-5c66-a355-2e331ac87f03" :answer/type :answer.type/math :answer/value "e+1" :db/ensure [:answer/validate]} {:db/id "answer-770dffba-b473-54d0-8c91-375e002f00da" :answer/id #uuid "770dffba-b473-54d0-8c91-375e002f00da" :answer/type :answer.type/math :answer/value "e-1" :db/ensure [:answer/validate]} {:db/id "answer-7ac6117c-6ac7-5259-8419-7056da507f1e" :answer/id #uuid "7ac6117c-6ac7-5259-8419-7056da507f1e" :answer/type :answer.type/math :answer/value "e-2" :db/ensure [:answer/validate]} {:db/id "answer-b0edc4cf-07e5-5251-add3-83a790ba9c3a" :answer/id #uuid "b0edc4cf-07e5-5251-add3-83a790ba9c3a" :answer/type :answer.type/math :answer/value "{e}^{2}+1" :db/ensure [:answer/validate]} {:db/id "answer-91dabac6-48a9-50c8-9bb2-f954d8bd6dda" :answer/id #uuid "91dabac6-48a9-50c8-9bb2-f954d8bd6dda" :answer/type :answer.type/math :answer/value "{e}^{2}-4" :db/ensure [:answer/validate]} {:db/id 17592186382594 :question/worked-solution "Notice that $D$ is a type II region. Since $x\\ge 0,$ we obtain the following equations in terms of $y:$\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}=4 & \\,⟹\\,x=\\sqrt{1-\\frac{{y}^{2}}{4}} \\\\ {x}^{2}+{y}^{2}=4 & \\,⟹\\,x=\\sqrt{4-{y}^{2}}\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\sqrt{1-\\frac{{y}^{2}}{4}} & =\\sqrt{4-{y}^{2}} \\\\ 1-\\frac{{y}^{2}}{4} & =4-{y}^{2} \\\\ 4-{y}^{2} & =16-4{y}^{2} \\\\ 3{y}^{2} & =12 \\\\ {y}^{2} & =4\\end{aligned}\n$$\n\nSo, since our region lies above the $x$-axis, the $y$-limits are \n$0\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](images/ec/ec8853d64b58c40935b769745d5adb9ebc5c84b7f9407cc93dff4b809ed64ad5.png)\n\nAs a result, we get\n\n$$\nD=\\{(x,y)\\,:\\,0\\le y\\le 2,\\,\\sqrt{1-\\frac{{y}^{2}}{4}}\\le x\\le \\sqrt{4-{y}^{2}}\\}.\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}{x}^{3}\\,dA={\\int }_{0}^{2}{\\int }_{\\sqrt{1-{y}^{2}/4}}^{\\sqrt{4-{y}^{2}}}\\,{x}^{3}\\,dx\\,dy\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{\\sqrt{1-{y}^{2}/4}}^{\\sqrt{4-{y}^{2}}}\\,{x}^{3}\\,dx\\,dy & ={\\int }_{0}^{2}[{\\int }_{\\sqrt{1-{y}^{2}/4}}^{\\sqrt{4-{y}^{2}}}\\,{x}^{3}\\,dx]\\,dy \\\\  & ={\\int }_{0}^{2}\\,{[\\,\\frac{1}{4}{x}^{4}\\,]}_{\\sqrt{1-{y}^{2}/4}}^{\\sqrt{4-{y}^{2}}}\\text{ }dy \\\\  & ={\\int }_{0}^{2}\\,\\frac{1}{4}[{(4-{y}^{2})}^{2}-{(1-\\frac{{y}^{2}}{4})}^{2}]dy \\\\  & =\\frac{1}{4}\\,{\\int }_{0}^{2}\\,[(16-8{y}^{2}+{y}^{4})-(1-\\frac{{y}^{2}}{2}+\\frac{{y}^{4}}{16})]dy \\\\  & =\\frac{1}{4}\\,{\\int }_{0}^{2}\\,(15-\\frac{15}{2}{y}^{2}+\\frac{15}{16}{y}^{4})dy \\\\  & =\\frac{15}{4}\\,{\\int }_{0}^{2}\\,(1-\\frac{{y}^{2}}{2}+\\frac{{y}^{4}}{16})dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{15}{4}\\,{\\int }_{0}^{2}\\,(1-\\frac{{y}^{2}}{2}+\\frac{{y}^{4}}{16})dy & =\\frac{15}{4}{[y-\\frac{{y}^{3}}{6}+\\frac{{y}^{5}}{80}]}_{0}^{2} \\\\  & =\\frac{15}{4}[(2-\\frac{4}{3}+\\frac{2}{5})-0] \\\\  & =4\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186134021 :activity/expected-seconds 1080.0 :db/ensure [:activity/validate]} {:db/id 17592186064221 :knowledge-point/questions ["question-bf661221-c0cb-55d5-9d95-0e82e6a1207a" "question-3a566b97-b1a6-51f5-a466-0f0acaf448eb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186064082 :question/problem "What is $9^0?$" :question/worked-solution "Any number raised to the power of zero is equal to $1.$ So, \n\n$$\n9^0=1.\n$$" :db/ensure [:question/validate]} {:db/id 17592186064222 :knowledge-point/questions ["question-09be84d5-d9f0-51d3-bee8-aa581090a407" "question