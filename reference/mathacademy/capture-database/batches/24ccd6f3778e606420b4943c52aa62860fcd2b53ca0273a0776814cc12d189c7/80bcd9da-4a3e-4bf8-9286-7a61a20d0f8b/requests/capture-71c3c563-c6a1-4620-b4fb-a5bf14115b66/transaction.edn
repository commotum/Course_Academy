ces ["answer-2af12137-dac1-5eb7-befa-2dc017393c8a" "answer-108b4415-53eb-5f00-9db9-d4131952781f" "answer-dddee4c9-f676-52fd-98f5-fd04c4b8d489" "answer-6ae8ba04-1474-505e-aadb-57422c8ef42a" "answer-232a1187-7b1b-5183-a7a3-3de61317cb34"] :db/ensure [:answer-field/validate]} {:db/id "answer-2af12137-dac1-5eb7-befa-2dc017393c8a" :answer/id #uuid "2af12137-dac1-5eb7-befa-2dc017393c8a" :answer/type :answer.type/math :answer/value "-27" :db/ensure [:answer/validate]} {:db/id "answer-108b4415-53eb-5f00-9db9-d4131952781f" :answer/id #uuid "108b4415-53eb-5f00-9db9-d4131952781f" :answer/type :answer.type/math :answer/value "-729" :db/ensure [:answer/validate]} {:db/id "answer-dddee4c9-f676-52fd-98f5-fd04c4b8d489" :answer/id #uuid "dddee4c9-f676-52fd-98f5-fd04c4b8d489" :answer/type :answer.type/math :answer/value "-927" :db/ensure [:answer/validate]} {:db/id "answer-6ae8ba04-1474-505e-aadb-57422c8ef42a" :answer/id #uuid "6ae8ba04-1474-505e-aadb-57422c8ef42a" :answer/type :answer.type/math :answer/value "729" :db/ensure [:answer/validate]} {:db/id "answer-232a1187-7b1b-5183-a7a3-3de61317cb34" :answer/id #uuid "232a1187-7b1b-5183-a7a3-3de61317cb34" :answer/type :answer.type/math :answer/value "927" :db/ensure [:answer/validate]} {:db/id "question-11153da4-48d0-5e46-974b-c9f9e9d4e7ed" :question/id #uuid "11153da4-48d0-5e46-974b-c9f9e9d4e7ed" :question/math-academy-id "q-186262" :question/problem "${(-40)}^{3}=${{field-1}}" :question/worked-solution "To work out ${(-40)}^{3},$ we multiply $-40$ by itself and then multiply the result by $-40$ again:\n\n$$\n\\begin{aligned}(-40)^{3} & =\\overset{1\\,600}{\\overset{⏞}{(-40)\\cdot (-40)}}\\cdot (-40) \\\\  & =1\\,600\\cdot (-40) \\\\  & =-64\\,000\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-57aa9dd1-408d-5e08-ba80-bbf97617e764"] :db/ensure [:question/validate]} {:db/id "answer-field-57aa9dd1-408d-5e08-ba80-bbf97617e764" :answer-field/id #uuid "57aa9dd1-408d-5e08-ba80-bbf9