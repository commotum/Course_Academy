c-3792-587e-a163-26c40f4d94eb" "answer-a1118bb8-6455-533b-9aef-eaee409b5a2c" "answer-9993df05-f359-50f7-b1c6-75b5da25208e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6d362fc-3792-587e-a163-26c40f4d94eb" :answer/id #uuid "b6d362fc-3792-587e-a163-26c40f4d94eb" :answer/type :answer.type/text :answer/value "$1$ dimension" :db/ensure [:answer/validate]} {:db/id "answer-a1118bb8-6455-533b-9aef-eaee409b5a2c" :answer/id #uuid "a1118bb8-6455-533b-9aef-eaee409b5a2c" :answer/type :answer.type/text :answer/value "$2$ dimensions" :db/ensure [:answer/validate]} {:db/id "answer-9993df05-f359-50f7-b1c6-75b5da25208e" :answer/id #uuid "9993df05-f359-50f7-b1c6-75b5da25208e" :answer/type :answer.type/text :answer/value "$3$ dimensions" :db/ensure [:answer/validate]} {:db/id "answer-field-a6f67916-7056-5e5a-a804-244e9775c355" :answer-field/id #uuid "a6f67916-7056-5e5a-a804-244e9775c355" :answer-field/key "field-9" :answer-field/type :answer-field.type/select :answer-field/correct "answer-3090991c-9595-5b07-9cef-7062e8f43424" :answer-field/choices ["answer-91e24e76-6e21-5a21-bb17-9d0e9c61e7b7" "answer-3090991c-9595-5b07-9cef-7062e8f43424" "answer-be5f66e4-edcb-5d11-af52-c47a5a3ba097" "answer-fbb024ed-cc66-59d6-b6bf-58525dee8a9a"] :db/ensure [:answer-field/validate]} {:db/id "answer-91e24e76-6e21-5a21-bb17-9d0e9c61e7b7" :answer/id #uuid "91e24e76-6e21-5a21-bb17-9d0e9c61e7b7" :answer/type :answer.type/math :answer/value "{X}_{\\text{std}}\\cdot V" :db/ensure [:answer/validate]} {:db/id "answer-3090991c-9595-5b07-9cef-7062e8f43424" :answer/id #uuid "3090991c-9595-5b07-9cef-7062e8f43424" :answer/type :answer.type/math :answer/value "{X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-be5f66e4-edcb-5d11-af52-c47a5a3ba097" :answer/id #uuid "be5f66e4-edcb-5d11-af52-c47a5a3ba097" :answer/type :answer.type/math :answer/value "{[\\begin{aligned}{u}_{1} & {u}_{2} & {u}_{3}\\end{aligned}]}^{T}\\cdot {X}_{\\text{std}}" :db/ensure [:answer/validate]} {:db/id "answer-fbb024ed-cc66-59d6-b6bf-58525dee8a9a" :answer/id #uuid "fbb024ed-cc66-59d6-b6bf-58525dee8a9a" :answer/type :answer.type/math :answer/value "{[\\begin{aligned}{u}_{1} & {u}_{2}\\end{aligned}]}^{T}\\cdot {X}_{\\text{std}}" :db/ensure [:answer/validate]} {:db/id 17592186204106 :knowledge-point/questions ["question-1c7b66a2-e4ef-5d7b-9466-353945dad93a" "question-6d89bf53-876c-5233-a22b-c8fa7b16fa9b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1c7b66a2-e4ef-5d7b-9466-353945dad93a" :question/id #uuid "1c7b66a2-e4ef-5d7b-9466-353945dad93a" :question/math-academy-id "q-355845" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}-0.6 & -0.95 & -1.02 \\\\ 0.79 & 0.33 & 1.56 \\\\ -1.48 & -1.17 & -0.66 \\\\ 0.67 & 0.8 & -0.15 \\\\ 0.63 & 0.99 & 0.27\\end{aligned}]\n$$\n\nwhere the data has been standardized (the mean of each feature is $0$ and the standard deviation is $1$).\nWe are also given the SVD decomposition $X=UΣ{V}^{T}$ where:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}-0.462 & 0.174 & -0.685 & 0.1 & 0.527 \\\\ 0.473 & -0.718 & -0.24 & 0.358 & 0.272 \\\\ -0.613 & -0.29 & 0.546 & 0.457 & 0.181 \\\\ 0.253 & 0.517 & -0.053 & 0.798 & -0.17 \\\\ 0.35 & 0.319 & 0.416 & -0.127 & 0.766\\end{aligned}] \\\\ Σ & =[\\begin{aligned}3.171 & 0 & 0 \\\\ 0 & 1.32 & 0 \\\\ 0 & 0 & 0.477 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}] \\\\ V & =[\\begin{aligned}0.615 & 0.231 & -0.754 \\\\ 0.587 & 0.505 & 0.633 \\\\ 0.527 & -0.832 & 0.175\\end{aligned}]\\end{aligned}\n$$\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components.\n\nWe should pick components based on \n{{field-1}}.\n\nIf we wish to preserve $95%$ of the variance, we should reduce the dataset to \n{{field-2}}." :question/worked-solution "In reducing the dimensionality of the dataset, we aim to preserve as much of the original variance as possible. \n\nWe should pick components based on $\\text{the amount of cumulative variance preserved}.$\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\nIn our example, the singular values are\n\n$$\n{\\sigma }_{1}=3.171,\\,{\\sigma }_{2}=1.32,\\,{\\sigma }_{3}=0.477.\n$$\n\nLet us now compute the cumulative variance preserved for different numbers of components.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{\\sigma }_{1}^{2}}{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}=\\frac{{3.171}^{2}}{{3.171}^{2}+{1.32}^{2}+{0.477}^{2}}≈83.6%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{2}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}=\\frac{{3.171}^{2}+{1.32}^{2}}{{3.171}^{2}+{1.32}^{2}+{0.477}^{2}}≈98.1%.\n$$\n\nThus, we obtain that\n\n- reducing the dataset to $1$ dimension would preserve $83.6%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $98.1%$ of the variance.\n\n![](images/1d/1d967881aaa7c2a7cd7f537d70d3637edae36b3edf62e15ac67949925d5ee2ef.png)\n\nTherefore, we should reduce the dataset to $2\\text{ dimensions},$ since this is the minimum number of components that preserves at least $95%$ of the variance." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-22a03984-b019-540f-8de4-513dc1ddbb0f" "answer-field-20bb4000-6ffb-5bec-a89b-04e5bbaff99a"] :db/ensure [:question/validate]} {:db/id "answer-field-22a03984-b019-540f-8de4-513dc1ddbb0f" :answer-field/id #uuid "22a03984-b019-540f-8de4-513dc1ddbb0f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-7b6593be-698b-54b5-93a1-296d85cbd08f" :answer-field/choices ["answer-18b29fe7-3f3b-5d6d-8700-561ac31c65f4" "answer-5c35ddf2-7858-53f4-9880-73848035b2d4" "answer-7b6593be-698b-54b5-93a1-296d85cbd08f" "answer-1427796d-eb86-552f-957a-f1407ab65cae"] :db/ensure [:answer-field/validate]} {:db/id "answer-18b29fe7-3f3b-5d6d-8700-561ac31c65f4" :answer/id #uuid "18b29fe7-3f3b-5d6d-8700-561ac31c65f4" :answer/type :answer.type/text :answer/value "if the eigenvalue is smaller than average" :db/ensure [:answer/validate]} {:db/id "answer-5c35ddf2-7858-53f4-9880-73848035b2d4" :answer/id #uuid "5c35ddf2-7858-53f4-9880-73848035b2d4" :answer/type :answer.type/text :answer/value "if the singular value is greater than $1$" :db/ensure [:answer/validate]} {:db/id "answer-7b6593be-698b-54b5-93a1-296d85cbd08f" :answer/id #uuid "7b6593be-698b-54b5-93a1-296d85cbd08f" :answer/type :answer.type/text :answer/value "the amount of cumulative variance preserved" :db/ensure [:answer/validate]} {:db/id "answer-1427796d-eb86-552f-957a-f1407ab65cae" :answer/id #uuid "1427796d-eb86-552f-957a-f1407ab65cae" :answer/type :answer.type/text :answer/value "the original number of features" :db/ensure [:answer/validate]} {:db/id "answer-field-20bb4000-6ffb-5bec-a89b-04e5bbaff99a" :answer-field/id #uuid "20bb4000-6ffb-5bec-a89b-04e5bbaff99a" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-c6ba0e8a-c0bf-547e-adcc-0ed6d87df774" :answer-field/choices ["answer-d15669cf-2800-56d9-84de-8bb935560c1c" "answer-c6ba0e8a-c0bf-547e-adcc-0ed6d87df774" "answer-c3e3a4e0-3072-52d5-8dd2-90ed5a353f4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d15669cf-2800-56d9-84de-8bb935560c1c" :answer/id #uuid "d15669cf-2800-56d9-84de-8bb935560c1c" :answer/type :answer.type/text :answer/value "$1$ dimension" :db/ensure [:answer/validate]} {:db/id "answer-c6ba0e8a-c0bf-547e-adcc-0ed6d87df774" :answer/id #uuid "c6ba0e8a-c0bf-547e-adcc-0ed6d87df774" :answer/type :answer.type/text :answer/value "$2$ dimensions" :db/ensure [:answer/validate]} {:db/id "answer-c3e3a4e0-3072-52d5-8dd2-90ed5a353f4a" :answer/id #uuid "c3e3a4e0-3072-52d5-8dd2-90ed5a353f4a" :answer/type :answer.type/text :answer/value "$3$ dimensions" :db/ensure [:answer/validate]} {:db/id "question-6d89bf53-876c-5233-a22b-c8fa7b16fa9b" :question/id #uuid "6d89bf53-876c-5233-a22b-c8fa7b16fa9b" :question/math-academy-id "q-355902" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $4$ features in the form of the $5\\times 4$ matrix\n\n$$\nX=[\\begin{aligned}0.93 & 0.98 & -1.44 & -1.13 \\\\ -0.14 & -0.96 & 0.96 & 1.58 \\\\ -1.06 & -1.09 & -0.61 & -0.05 \\\\ -0.86 & 0.96 & 0.42 & 0.08 \\\\ 1.12 & 0.1 & 0.68 & -0.48\\end{aligned}]\n$$\n\nwhere the data has been standardized (the mean of each feature is $0$ and the standard deviation is $1$).\nWe are also given the SVD decomposition $X=UΣ{V}^{T}$ where:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}-0.725 & 0.1 & -0.166 & -0.483 & 0.452 \\\\ 0.64 & -0.269 & -0.185 & -0.532 & 0.449 \\\\ 0.207 & 0.729 & -0.311 & 0.363 & 0.444 \\\\ 0.032 & 0.06 & 0.889 & 0.076 & 0.446 \\\\ -0.149 & -0.619 & -0.227 & 0.588 & 0.444\\end{aligned}] \\\\ Σ & =[\\begin{aligned}3.067 & 0 & 0 & 0 \\\\ 0 & 1.933 & 0 & 0 \\\\ 0 & 0 & 1.517 & 0 \\\\ 0 & 0 & 0 & 0.763 \\\\ 0 & 0 & 0 & 0\\end{aligned}] \\\\ V & =[\\begin{aligned}-0.384 & -0.717 & -0.539 & -0.218 \\\\ -0.5 & -0.229 & 0.78 & -0.297 \\\\ 0.471 & -0.643 & 0.31 & 0.518 \\\\ 0.617 & -0.141 & 0.06 & -0.772\\end{aligned}]\\end{aligned}\n$$\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components.\n\nWe should pick components based on \n{{field-1}}.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to \n{{field-2}}." :question/worked-solution "In reducing the dimensionality of the dataset, we aim to preserve as much of the original variance as possible. \n\nWe should pick components based on $\\text{the amount of cumulative variance preserved}.$\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\nIn our example, the singular values are\n\n$$\n{\\sigma }_{1}=3.067,\\,{\\sigma }_{2}=1.933,\\,{\\sigma }_{3}=1.517,\\,{\\sigma }_{4}=0.763.\n$$\n\nLet us now compute the cumulative variance preserved for different numbers of components.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{\\sigma }_{1}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈58.7%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{2}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}+{1.933}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈82.0%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first three principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈96.4%.\n$$\n\nThus, we obtain that\n\n- reducing the dataset to $1$ dimension would preserve $58.7%$ of the variance,\n\n- reducing the dataset to $2$ dimensions would preserve $82.0%$ of the variance, while\n\n- reducing the dataset to $3$ dimensions would preserve $96.4%$ of the variance.\n\n![](images/ff/ff1aa60e989377c3767643d2538755d932bc40669f550b57040581192a104f8c.png)\n\nTherefore, we should reduce the dataset to $3\\text{ dimensions},$ since this is the minimum number of components that preserves at least $90%$ of the variance." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-68067e86-ba42-567b-bdcd-ca00107fc431" "answer-field-5faada09-26d3-54a9-9980-7006e9efb72b"] :db/ensure [:question/validate]} {:db/id "answer-field-68067e86-ba42-567b-bdcd-ca00107fc431" :answer-field/id #uuid "68067e86-ba42-567b-bdcd-ca00107fc431" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-25191f9d-4f63-51c7-86f9-6e2eba8f5813" :answer-field/choices ["answer-54161fc7-2907-5cdd-98f5-833fcf9a93ee" "answer-7cb19297-4a76-5a65-8e56-43999bd8dc66" "answer-25191f9d-4f63-51c7-86f9-6e2eba8f5813" "answer-1da702c8-fb50-57a2-aba8-86d7f2e992e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-54161fc7-2907-5cdd-98f5-833fcf9a93ee" :answer/id #uuid "54161fc7-2907-5cdd-98f5-833fcf9a93ee" :answer/type :answer.type/text :answer/value "if the eigenvalue is smaller than average" :db/ensure [:answer/validate]} {:db/id "answer-7cb19297-4a76-5a65-8e56-43999bd8dc66" :answer/id #uuid "7cb19297-4a76-5a65-8e56-43999bd8dc66" :answer/type :answer.type/text :answer/value "if the singular value is greater than $1$" :db/ensure [:answer/validate]} {:db/id "answer-25191f9d-4f63-51c7-86f9-6e2eba8f5813" :answer/id #uuid "25191f9d-4f63-51c7-86f9-6e2eba8f5813" :answer/type :answer.type/text :answer/value "the amount of cumulative variance preserved" :db/ensure [:answer/validate]} {:db/id "answer-1da702c8-fb50-57a2-aba8-86d7f2e992e7" :answer/id #uuid "1da702c8-fb50-57a2-aba8-86d7f2e992e7" :answer/type :answer.type/text :answer/value "the original number of features" :db/ensure [:answer/validate]} {:db/id "answer-field-5faada09-26d3-54a9-9980-7006e9efb72b" :answer-field/id #uuid "5faada09-26d3-54a9-9980-7006e9efb72b" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-739620ba-aa1b-5b3d-8863-a2e8f0022963" :answer-field/choices ["answer-c408f96e-ccbc-5cb8-8e08-9511939a15b2" "answer-88e62841-c860-50af-be14-c96305a4714d" "answer-739620ba-aa1b-5b3d-8863-a2e8f0022963" "answer-5ec937d1-e5b9-5630-8e26-295f9d71c684"] :db/ensure [:answer-field/validate]} {:db/id "answer-c408f96e-ccbc-5cb8-8e08-9511939a15b2" :answer/id #uuid "c408f96e-ccbc-5cb8-8e08-9511939a15b2" :answer/type :answer.type/text :answer/value "$1$ dimension" :db/ensure [:answer/validate]} {:db/id "answer-88e62841-c860-50af-be14-c96305a4714d" :answer/id #uuid "88e62841-c860-50af-be14-c96305a4714d" :answer/type :answer.type/text :answer/value "$2$ dimensions" :db/ensure [:answer/validate]} {:db/id "answer-739620ba-aa1b-5b3d-8863-a2e8f0022963" :answer/id #uuid "739620ba-aa1b-5b3d-8863-a2e8f0022963" :answer/type :answer.type/text :answer/value "$3$ dimensions" :db/ensure [:answer/validate]} {:db/id "answer-5ec937d1-e5b9-5630-8e26-295f9d71c684" :answer/id #uuid "5ec937d1-e5b9-5630-8e26-295f9d71c684" :answer/type :answer.type/text :answer/value "$4$ dimensions" :db/ensure [:answer/validate]} {:db/id "question-d96fd40c-87e8-5ffa-bd33-b4b724c33445" :question/id #uuid "d96fd40c-87e8-5ffa-bd33-b4b724c33445" :question/math-academy-id "q-355958" :question/problem "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}0.795 & -5.044 & 1.480 \\\\ 2.471 & -4.893 & 1.132 \\\\ 2.589 & -6.272 & -0.161 \\\\ 0.548 & -6.608 & 1.020 \\\\ 5.379 & -3.807 & 3.126\\end{aligned}]\n$$\n\nWe wish to reduce the dimensionality of the dataset while still preserving as much variance as possible.\n\nSelect the correct options in the following reasoning that walks through the process of reducing the dimensionality of the dataset.\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is \n{{field-1}} \nwith the \n{{field-2}} \nvariance.\n\nThe second principal component is the direction in feature space \n{{field-3}} \nto the first\n{{field-4}}. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to {{field-5}}.\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}-0.81 & 0.25 & 0.14 \\\\ 0.06 & 0.38 & -0.16 \\\\ 0.12 & -0.84 & -1.25 \\\\ -0.94 & -1.13 & -0.25 \\\\ 1.57 & 1.34 & 1.53\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}-0.066 & 0.590 & -0.424 & -0.067 & 0.680 \\\\ 0.055 & -0.056 & -0.505 & 0.841 & -0.178 \\\\ -0.374 & -0.731 & -0.063 & 0.057 & 0.565 \\\\ -0.430 & 0.317 & 0.675 & 0.487 & 0.152 \\\\ 0.817 & -0.116 & 0.325 & 0.220 & 0.405\\end{aligned}], \\\\ Σ & =[\\begin{aligned}3.124 & 0 & 0 \\\\ 0 & 1.309 & 0 \\\\ 0 & 0 & 0.738 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}0.544 & -0.802 & 0.248 \\\\ 0.608 & 0.173 & -0.775 \\\\ 0.578 & 0.572 & 0.581\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe fraction of variance preserved by projecting the data onto the first principal component is \n{{field-6}}.\n\nThe fraction of variance preserved by projecting the data onto the first two principal components is \n{{field-7}}.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to \n{{field-8}}.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={{field-9}}.\n$$" :question/worked-solution "We will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is $\\text{the direction in feature space}$ with the $\\text{most}$ variance.\n\nThe second principal component is the direction $\\text{orthogonal}$ to the first $\\text{principal component}.$\n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to $\\text{standardize the data}.$\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}-0.81 & 0.25 & 0.14 \\\\ 0.06 & 0.38 & -0.16 \\\\ 0.12 & -0.84 & -1.25 \\\\ -0.94 & -1.13 & -0.25 \\\\ 1.57 & 1.34 & 1.53\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}-0.066 & 0.590 & -0.424 & -0.067 & 0.680 \\\\ 0.055 & -0.056 & -0.505 & 0.841 & -0.178 \\\\ -0.374 & -0.731 & -0.063 & 0.057 & 0.565 \\\\ -0.430 & 0.317 & 0.675 & 0.487 & 0.152 \\\\ 0.817 & -0.116 & 0.325 & 0.220 & 0.405\\end{aligned}], \\\\ Σ & =[\\begin{aligned}3.124 & 0 & 0 \\\\ 0 & 1.309 & 0 \\\\ 0 & 0 & 0.738 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}0.544 & -0.802 & 0.248 \\\\ 0.608 & 0.173 & -0.775 \\\\ 0.578 & 0.572 & 0.581\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{3.124}^{2}}{{3.124}^{2}+{1.309}^{2}+{0.738}^{2}}≈81.2%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{3.124}^{2}+{1.309}^{2}}{{3.124}^{2}+{1.309}^{2}+{0.738}^{2}}≈95.5%.\n$$\n\nThus, we have that \n\n- reducing the dataset to $1$ dimension would preserve $81.2%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $95.5%$ of the variance.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to $2\\text{ dimensions}$ , since this is the minimum number of components that preserves at least $90%$ of the variance.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}],\n$$\n\nsince we need to project the data onto the first two principal components, which are the first two columns of $V.$\n\n**Note:** In order to invert the projection and interpret any further analysis in terms of the original features, we need to know the means and standard deviations of the original dataset $X.$ Additionally, in case we have more data, we can use the means and standard deviations of the original dataset to map the new data into the original feature space." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7a286421-776b-5e85-a712-2065d5d835e2" "answer-field-16850f55-af43-55e3-ad92-a64b04f5cd87" "answer-field-be6f8912-b155-50dc-a5eb-1a34f2982bfd" "answer-field-d5533b86-b75f-5b4f-b691-ab7895f8ca87" "answer-field-de5e06b2-261b-5cb7-abf6-2181d50769ea" "answer-field-6d8440b4-c109-51ef-8720-bdbc893ad92b" "answer-field-735358d6-2106-5eb4-bc7b-adf0cbd3ccde" "answer-field-bf80bec0-685f-5049-8ac7-2700161ad366" "answer-field-27d2d9e8-3a92-5999-9d31-fed4d7581f6a"] :db/ensure [:question/validate]} {:db/id "answer-field-7a286421-776b-5e85-a712-2065d5d835e2" :answer-field/id #uuid "7a286421-776b-5e85-a712-2065d5d835e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-320da214-47fa-52c0-9832-e91c6f8a636f" :answer-field/choices ["answer-95248131-6ba2-50d9-8732-380af69edf83" "answer-320da214-47fa-52c0-9832-e91c6f8a636f"] :db/ensure [:answer-field/validate]} {:db/id "answer-95248131-6ba2-50d9-8732-380af69edf83" :answer/id #uuid "9