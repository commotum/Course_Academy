af-bd5a-5af1-a243-a36243a52db6" :step/id #uuid "2dc50eaf-bd5a-5af1-a243-a36243a52db6" :step/content "question-553ad9a0-8f10-59ef-ab22-b325bd3075cb" :step/next "step-2a300984-ba42-56ba-b359-9a1f873369b3" :db/ensure [:step/validate]} {:db/id "step-2a300984-ba42-56ba-b359-9a1f873369b3" :step/id #uuid "2a300984-ba42-56ba-b359-9a1f873369b3" :step/content "question-772edc16-136d-5a38-b38b-aec6a90dcb95" :db/ensure [:step/validate]} [:db/retract 17592186167262 :question/answer-fields 17592186164741] [:db/retract 17592186167262 :question/answer-fields 17592186164746] [:db/retract 17592186167262 :question/answer-fields 17592186164751] [:db/retract 17592186167262 :question/answer-fields 17592186164756] {:db/id 17592186166936 :knowledge-point/questions ["question-3ff1006e-e8fc-5000-8f28-c2da87881b92" "question-026f1da3-fe0b-5238-91da-8230388ad940" "question-41ff18d2-5493-53b7-9e77-82f1434ea309"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3ff1006e-e8fc-5000-8f28-c2da87881b92" :question/id #uuid "3ff1006e-e8fc-5000-8f28-c2da87881b92" :question/math-academy-id "q-336263" :question/problem "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from line $\\text{L1}$ by {{field-1}} both sides of  the equation.\n\n$\\,$ Line $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into the {{field-2}}.\n\n$\\,$ Line $\\text{L4}$ follows from the fact that {{field-3}} matrix." :question/worked-solution "Let's examine each statement in turn.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ To get $\\text{L2},$ we are $\\text{differentiating}$ with respect to $t$ both sides of the equation in $\\text{L1}:$\n\n$$\n\\begin{aligned}{x}_{p}^{′}(t) & =(Φu(t))^{′} \\\\ {x}_{p}^{′}(t) & =Φ{u}^{′}(t)+{Φ}^{′}u(t)\\end{aligned}\n$$\n\n- Next, we consider lines $\\text{L1},$ $\\text{L2},$ and $\\text{L3}.$ Let's substitute ${x}_{p}(t)=Φu(t)$ from $\\text{L1}$ and ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$ from $\\text{L2}$ into the initial system of ODEs:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =Ax(t)+f(t) \\\\ Φ{u}^{′}(t)+{Φ}^{′}u(t) & =AΦu(t)+f(t)\\end{aligned}\n$$\n\nTherefore, $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into $\\text{initial system of ODEs}.$\n\n- Finally we consider line $\\text{L4}.$ Since $Φ$ is a fundamental matrix, its columns are solutions to the homogeneous system ${x}^{′}(t)=Ax(t),$ i.e., by substituting any column $c(t)$ of $Φ$ into the homogeneous system, we get\n\n$$\n{c}^{′}(t)=Ac(t),\n$$\n\nwhere ${c}^{′}(t)$ is the corresponding column of derivatives in $Φ.$ As a result, this means that ${Φ}^{′}=AΦ.$ Therefore, $\\text{L4}$ follows from the fact that $Φ\\text{ is a fundamental}$ matrix." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f50e8ba7-67b1-5e78-8666-8f879edd0fc8" "answer-field-aecbeeb8-f0b5-5474-883d-460ee1474f40" "answer-field-86ebf5a0-9610-584a-85e1-88d2ed6cfed3"] :db/ensure [:question/validate]} {:db/id "answer-field-f50e8ba7-67b1-5e78-8666-8f879edd0fc8" :answer-field/id #uuid "f50e8ba7-67b1-5e78-8666-8f879edd0fc8" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-5968c32c-cb76-50d7-932e-7fcfc8484d2d" :answer-field/choices ["answer-5e3be592-dcca-5b51-8b27-4fe0bff99809" "answer-5968c32c-cb76-50d7-932e-7fcfc8484d2d" "answer-7d9c0755-e67e-5732-bc46-986c5c46a686" "answer-38d2f1d9-20cd-5196-86bb-e7fee36544cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e3be592-dcca-5b51-8b27-4fe0bff99809" :answer/id #uuid "5e3be592-dcca-5b51-8b27-4fe0bff99809" :answer/type :answer.type/text :answer/value "adding $Φ$ to" :db/ensure [:answer/validate]} {:db/id "answer-5968c32c-cb76-50d7-932e-7fcfc8484d2d" :answer/id #uuid "5968c32c-cb76-50d7-932e-7fcfc8484d2d" :answer/type :answer.type/text :answer/value "differentiating" :db/ensure [:answer/validate]} {:db/id "answer-7d9c0755-e67e-5732-bc46-986c5c46a686" :answer/id #uuid "7d9c0755-e67e-5732-bc46-986c5c46a686" :answer/type :answer.type/text :answer/value "integrating" :db/ensure [:answer/validate]} {:db/id "answer-38d2f1d9-20cd-5196-86bb-e7fee36544cc" :answer/id #uuid "38d2f1d9-20cd-5196-86bb-e7fee36544cc" :answer/type :answer.type/text :answer/value "pre-multiplying by ${Φ}^{-1}$" :db/ensure [:answer/validate]} {:db/id "answer-field-aecbeeb8-f0b5-5474-883d-460ee1474f40" :answer-field/id #uuid "aecbeeb8-f0b5-5474-883d-460ee1474f40" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-f169c05a-a69f-5186-bf3c-88e7a89f8bb4" :answer-field/choices ["answer-1f2d72e1-0291-582b-9a39-d0cbb7c7b7e8" "answer-f169c05a-a69f-5186-bf3c-88e7a89f8bb4" "answer-44c37b96-fc14-54ee-af0a-18f5ce07ebf6" "answer-35b08d60-2130-5ed9-9283-6b3941c41557"] :db/ensure [:answer-field/validate]} {:db/id "answer-1f2d72e1-0291-582b-9a39-d0cbb7c7b7e8" :answer/id #uuid "1f2d72e1-0291-582b-9a39-d0cbb7c7b7e8" :answer/type :answer.type/text :answer/value "first shifting theorem" :db/ensure [:answer/validate]} {:db/id "answer-f169c05a-a69f-5186-bf3c-88e7a89f8bb4" :answer/id #uuid "f169c05a-a69f-5186-bf3c-88e7a89f8bb4" :answer/type :answer.type/text :answer/value "initial system of ODEs" :db/ensure [:answer/validate]} {:db/id "answer-44c37b96-fc14-54ee-af0a-18f5ce07ebf6" :answer/id #uuid "44c37b96-fc14-54ee-af0a-18f5ce07ebf6" :answer/type :answer.type/text :answer/value "line $\\text{L4}$" :db/ensure [:answer/validate]} {:db/id "answer-35b08d60-2130-5ed9-9283-6b3941c41557" :answer/id #uuid "35b08d60-2130-5ed9-9283-6b3941c41557" :answer/type :answer.type/text :answer/value "solution of the system of ODEs" :db/ensure [:answer/validate]} {:db/id "answer-field-86ebf5a0-9610-584a-85e1-88d2ed6cfed3" :answer-field/id #uuid "86ebf5a0-9610-584a-85e1-88d2ed6cfed3" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0afb4a52-a6fa-5628-a987-67c61d0437bc" :answer-field/choices ["answer-a8ca98ef-d9ea-5cb8-842b-28069c76b8c8" "answer-b822b7c3-4f8f-510d-ab76-abeacd9652bb" "answer-0afb4a52-a6fa-5628-a987-67c61d0437bc" "answer-e5f41f68-2c43-533b-994f-b50e5699aa55"] :db/ensure [:answer-field/validate]} {:db/id "answer-a8ca98ef-d9ea-5cb8-842b-28069c76b8c8" :answer/id #uuid "a8ca98ef-d9ea-5cb8-842b-28069c76b8c8" :answer/type :answer.type/text :answer/value "$A$ is an invertible" :db/ensure [:answer/validate]} {:db/id "answer-b822b7c3-4f8f-510d-ab76-abeacd9652bb" :answer/id #uuid "b822b7c3-4f8f-510d-ab76-abeacd9652bb" :answer/type :answer.type/text :answer/value "$A$ is the identity" :db/ensure [:answer/validate]} {:db/id "answer-0afb4a52-a6fa-5628-a987-67c61d0437bc" :answer/id #uuid "0afb4a52-a6fa-5628-a987-67c61d0437bc" :answer/type :answer.type/text :answer/value "$Φ$ is a fundamental" :db/ensure [:answer/validate]} {:db/id "answer-e5f41f68-2c43-533b-994f-b50e5699aa55" :answer/id #uuid "e5f41f68-2c43-533b-994f-b50e5699aa55" :answer/type :answer.type/text :answer/value "$Φ$ is a square" :db/ensure [:answer/validate]} {:db/id "question-026f1da3-fe0b-5238-91da-8230388ad940" :question/id #uuid "026f1da3-fe0b-5238-91da-8230388ad940" :question/math-academy-id "q-336702" :question/problem "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from line $\\text{L1}$ by {{field-1}} both sides of  the equation.\n\n$\\,$ Line $\\text{L5}$ follows from lines {{field-2}} by substitution.\n\n$\\,$ Line $\\text{L8}$ is obtained by substituting {{field-3}} into $\\text{L1}.$" :question/worked-solution "Let's examine each statement in turn.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ To get $\\text{L2},$ we are $\\text{differentiating}$ with respect to $t$ both sides of the equation in $\\text{L1}:$\n\n$$\n\\begin{aligned}{x}_{p}^{′}(t) & =(Φu(t))^{′} \\\\ {x}_{p}^{′}(t) & =Φ{u}^{′}(t)+{Φ}^{′}u(t)\\end{aligned}\n$$\n\n- Next, we consider lines $\\text{L3}$, $\\text{L4},$ and $\\text{L5}.$ Let's substitute ${Φ}^{′}=AΦ$ from $\\text{L4}$ into $\\text{L3}:$\n\n$$\n\\begin{aligned}Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t) \\\\ Φ{u}^{′}(t)+\\cancel{AΦu(t)}=\\cancel{AΦu(t)}+f(t) \\\\ Φ{u}^{′}(t)=f(t)\\end{aligned}\n$$\n\nTherefore, $\\text{L5}$ follows from $\\text{L3}\\text{ and }\\text{L4}$ by substitution.\n\n- Finally, we consider lines $\\text{L1},$ $\\text{L7},$ and $\\text{L8}.$ Substituting\n\n$$\nu(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t\n$$\n\nfrom $\\text{L7}$ into $\\text{L1},$ we get\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φu(t) \\\\  & =Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ is obtained by substituting $\\text{L7}$ into $\\text{L1}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9a30296a-81a8-5e8f-8848-aa76261f03d6" "answer-field-46cc18a9-7bbf-5c79-9620-7ec7f585a7f9" "answer-field-76b0d288-93b4-5bf0-996b-46ae4e23d975"] :db/ensure [:question/validate]} {:db/id "answer-field-9a30296a-81a8-5e8f-8848-aa76261f03d6" :answer-field/id #uuid "9a30296a-81a8-5e8f-8848-aa76261f03d6" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4692373c-5bda-5889-b3cb-6f17f3ab4956" :answer-field/choices ["answer-0a6171db-4601-5d55-99e7-40ac8d10f6d9" "answer-4692373c-5bda-5889-b3cb-6f17f3ab4956" "answer-1a1fcebf-64ee-5283-aebc-5134bcebf561" "answer-3f0d3c68-e600-5772-be76-16d671d4234f"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a6171db-4601-5d55-99e7-40ac8d10f6d9" :answer/id #uuid "0a6171db-4601-5d55-99e7-40ac8d10f6d9" :answer/type :answer.type/text :answer/value "adding $Φ$ to" :db/ensure [:answer/validate]} {:db/id "answer-4692373c-5bda-5889-b3cb-6f17f3ab4956" :answer/id #uuid "4692373c-5bda-5889-b3cb-6f17f3ab4956" :answer/type :answer.type/text :answer/value "differentiating" :db/ensure [:answer/validate]} {:db/id "answer-1a1fcebf-64ee-5283-aebc-5134bcebf561" :answer/id #uuid "1a1fcebf-64ee-5283-aebc-5134bcebf561" :answer/type :answer.type/text :answer/value "integrating" :db/ensure [:answer/validate]} {:db/id "answer-3f0d3c68-e600-5772-be76-16d671d4234f" :answer/id #uuid "3f0d3c68-e600-5772-be76-16d671d4234f" :answer/type :answer.type/text :answer/value "pre-multiplying by ${Φ}^{-1}$" :db/ensure [:answer/validate]} {:db/id "answer-field-46cc18a9-7bbf-5c79-9620-7ec7f585a7f9" :answer-field/id #uuid "46cc18a9-7bbf-5c79-9620-7ec7f585a7f9" :answer-field/key "