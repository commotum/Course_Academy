"step-67885360-0e56-54e7-b8aa-2c07475cf1c1" :db/ensure [:step/validate]} {:db/id "step-67885360-0e56-54e7-b8aa-2c07475cf1c1" :step/id #uuid "67885360-0e56-54e7-b8aa-2c07475cf1c1" :step/content "question-6d89bf53-876c-5233-a22b-c8fa7b16fa9b" :step/next "step-0f025f10-87f0-5230-aa1e-c4fc72c4b0be" :db/ensure [:step/validate]} {:db/id "step-0f025f10-87f0-5230-aa1e-c4fc72c4b0be" :step/id #uuid "0f025f10-87f0-5230-aa1e-c4fc72c4b0be" :step/content "question-d96fd40c-87e8-5ffa-bd33-b4b724c33445" :db/ensure [:step/validate]} {:db/id 17592186087837 :knowledge-point/questions ["question-1a906e6f-23fd-5f8d-83eb-286b57e0e8a7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1a906e6f-23fd-5f8d-83eb-286b57e0e8a7" :question/id #uuid "1a906e6f-23fd-5f8d-83eb-286b57e0e8a7" :question/math-academy-id "q-10494" :question/problem "Calculate the points where the hyperbola\n$\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16}=1$\nintersects the line $x=-4.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-4,$ we substitute $x=-4$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{y}^{2}}{8}-\\frac{(-4)^{2}}{16} & =1 \\\\ \\frac{{y}^{2}}{8}-1 & =1 \\\\ \\frac{{y}^{2}}{8} & =1+1 \\\\ \\frac{{y}^{2}}{8} & =2 \\\\ {y}^{2} & =16 \\\\ y & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line  $x=-4$ at the points $(-4,\\pm 4).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a1ef507b-8129-5dce-a6ec-07aaa47a4a1f"] :db/ensure [:question/validate]} {:db/id "answer-field-a1ef507b-8129-5dce-a6ec-07aaa47a4a1f" :answer-field/id #uuid "a1ef507b-8129-5dce-a6ec-07aaa47a4a1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1e97d6d8-9d90-508e-a1ba-244d1ce48296" :answer-field/choices ["answer-3d3008e1-921d-5cf5-839b-6f9f1f5f5711" "answer-e0c259f5-c5fe-5a6