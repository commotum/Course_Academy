e]} {:db/id "answer-field-adec6e58-a95e-5c0a-90a8-cc9a80a3cdc1" :answer-field/id #uuid "adec6e58-a95e-5c0a-90a8-cc9a80a3cdc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4373d867-f227-5bc5-b685-350c980bfb11" :answer-field/choices ["answer-0fd1cadd-a51e-5998-81c1-fca762ad9165" "answer-8382672a-a9da-5510-8816-da326e79c517" "answer-4413fa77-bfff-5d64-9ab0-0d22cea17b21" "answer-f843f2d5-6ccf-5bdc-a13c-6aa810fc91e0" "answer-4373d867-f227-5bc5-b685-350c980bfb11"] :db/ensure [:answer-field/validate]} {:db/id "answer-0fd1cadd-a51e-5998-81c1-fca762ad9165" :answer/id #uuid "0fd1cadd-a51e-5998-81c1-fca762ad9165" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-8382672a-a9da-5510-8816-da326e79c517" :answer/id #uuid "8382672a-a9da-5510-8816-da326e79c517" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-4413fa77-bfff-5d64-9ab0-0d22cea17b21" :answer/id #uuid "4413fa77-bfff-5d64-9ab0-0d22cea17b21" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f843f2d5-6ccf-5bdc-a13c-6aa810fc91e0" :answer/id #uuid "f843f2d5-6ccf-5bdc-a13c-6aa810fc91e0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-4373d867-f227-5bc5-b685-350c980bfb11" :answer/id #uuid "4373d867-f227-5bc5-b685-350c980bfb11" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186111212 :question/problem "By expressing $\\frac{5}{2}{log}_{2}⁡t$ in the form ${log}_{2}⁡({t}^{k}),$ determine the value of $k.$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms, we get:\n\n$$\n\\begin{aligned}\\frac{5}{2}{log}_{2}⁡t & ={log}_{2}⁡({t}^{5/2})\\end{aligned}\n$$\n\nHence $k=\\frac{5}{2}.$" :question/difficulty :question.