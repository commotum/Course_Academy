right)\n$$\n\nUsing the power rule for logarithms, we get\n\n$$\n\\begin{aligned}\\frac{1}{2}{log}_{3}⁡x & ={log}_{3}⁡({x}^{1/2}).\\end{aligned}\n$$\n\nTherefore, $k = \\dfrac{1}{2}.$" :db/ensure [:question/validate]} {:db/id 17592186110598 :knowledge-point/questions ["question-03b07b19-1587-5e10-a223-7c9ddb411106" "question-abb937a1-e6d0-5e25-8254-46eecc862782"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110499 :question/problem "Find the value of $\\ln\\left(x^3\\right)$ if $\\ln(x) = 0.2.$" :question/worked-solution "First, let's recall the power rule for natural logarithms:\n\n$$\n\\ln\\left( c^m \\right) = m\\ln{c}\n$$\n\nUsing the power rule for logarithms and the information given, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{3}) & =3\\cdot \\operatorname{ln}⁡(x) \\\\  & =3\\cdot 0.2 \\\\  & =0.6.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-87e631c2-0787-575b-9e30-ac64f270159d" :question/id #uuid "87e631c2-0787-575b-9e30-ac64f270159d" :question/math-academy-id "q-108203" :question/problem "$\\operatorname{ln}⁡({x}^{5})=$" :question/worked-solution "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms, we get:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{5})=5\\operatorname{ln}⁡x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-718f16aa-73f6-5186-9af4-70c5fc5b859c"] :db/ensure [:question/validate]} {:db/id "answer-field-718f16aa-73f6-5186-9af4-70c5fc5b859c" :answer-field/id #uuid "718f16aa-73f6-5186-9af4-70c5fc5b859c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ef302096-6f7f-54d7-a9e2-d98378f237a6" :answer-field/choices ["answer-c9535bdb-a29f-5d9f-bfbb-1b72f93b2cf4" "answer-428fc9d0-d6e4-5748-97e1-c1560c6587e3" "answer-695cba00-73e4-5455-a33a-71c5595df47f" "answer-ef302096-6f7f-54d7-a9e2-d98378f237a6" "answer-39ee