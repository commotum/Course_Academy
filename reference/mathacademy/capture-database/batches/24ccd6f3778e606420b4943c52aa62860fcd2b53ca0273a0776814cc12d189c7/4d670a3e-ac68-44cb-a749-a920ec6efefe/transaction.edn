8790-b2fc-5728-aa3b-02bd91182c99" :step/id #uuid "c0a58790-b2fc-5728-aa3b-02bd91182c99" :step/content 17592186447159 :step/next "step-ea17984d-b1fd-5109-a5c3-c2c1166176dd" :db/ensure [:step/validate]} {:db/id "step-ea17984d-b1fd-5109-a5c3-c2c1166176dd" :step/id #uuid "ea17984d-b1fd-5109-a5c3-c2c1166176dd" :step/content 17592186405029 :step/next "step-ae34bece-dd6d-55aa-a39e-6fffe351a9e0" :db/ensure [:step/validate]} {:db/id "step-ae34bece-dd6d-55aa-a39e-6fffe351a9e0" :step/id #uuid "ae34bece-dd6d-55aa-a39e-6fffe351a9e0" :step/content 17592186483421 :step/next "step-f760da62-3000-5957-aaa0-e2654d0801a1" :db/ensure [:step/validate]} {:db/id "step-f760da62-3000-5957-aaa0-e2654d0801a1" :step/id #uuid "f760da62-3000-5957-aaa0-e2654d0801a1" :step/content 17592186363363 :step/next "step-a4bc5a2d-3e93-51e5-9f99-7400e1837432" :db/ensure [:step/validate]} {:db/id "step-a4bc5a2d-3e93-51e5-9f99-7400e1837432" :step/id #uuid "a4bc5a2d-3e93-51e5-9f99-7400e1837432" :step/content 17592186363370 :db/ensure [:step/validate]} [:db/retract 17592186093908 :answer-field/choices 17592186093909] [:db/retract 17592186093908 :answer-field/choices 17592186093910] [:db/retract 17592186093908 :answer-field/choices 17592186093911] [:db/retract 17592186093908 :answer-field/choices 17592186093912] [:db/retract 17592186093908 :answer-field/choices 17592186093913] {:db/id 17592186096989 :question/problem "Given that $f(x)=5{e}^{x}+2{x}^{2}-3$, find ${f}^{′}(x).$" :question/worked-solution "Using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x}+2{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(5{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(2{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({e}^{x})+2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-0 \\\\  & =5{e}^{x}+2(2x)-0 \\\\  & =5{e}^{x}+4x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186093908 :answer-field/correct "answer-92c2fe7a-f2f7-5b68-8d4d-cf6414096282" :answer-field/choices ["answer-92c2fe7a-f2f7-5b68-8d4d-cf6414096282" "answer-9caf9432-187f-5eb0-a837-cd39bf99957b" "answer-c2b5f78e-5928-5e0b-9292-bc6f68419181" "answer-1c78d12d-e0a1-56ab-9f9b-0b5ab3109e1b" "answer-207cc40d-fc6f-5da2-b43d-321cce4f0d3b"] :db/ensure [:answer-field/validate]} {:db/id "answer-92c2fe7a-f2f7-5b68-8d4d-cf6414096282" :answer/id #uuid "92c2fe7a-f2f7-5b68-8d4d-cf6414096282" :answer/type :answer.type/math :answer/value "{f}^{′}(x)=5{e}^{x}+4x" :db/ensure [:answer/validate]} {:db/id "answer-9caf9432-187f-5eb0-a837-cd39bf99957b" :answer/id #uuid "9caf9432-187f-5eb0-a837-cd39bf99957b" :answer/type :answer.type/math :answer/value "{f}^{′}(x)=5{e}^{x}+4x-3" :db/ensure [:answer/validate]} {:db/id "answer-c2b5f78e-5928-5e0b-9292-bc6f68419181" :answer/id #uuid "c2b5f78e-5928-5e0b-9292-bc6f68419181" :answer/type :answer.type/math :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1c78d12d-e0a1-56ab-9f9b-0b5ab3109e1b" :answer/id #uuid "1c78d12d-e0a1-56ab-9f9b-0b5ab3109e1b" :answer/type :answer.type/math :answer/value "{f}^{′}(x)=5{e}^{x}+4{x}^{2}-3" :db/ensure [:answer/validate]} {:db/id "answer-207cc40d-fc6f-5da2-b43d-321cce4f0d3b" :answer/id #uuid "207cc40d-fc6f-5da2-b43d-321cce4f0d3b" :answer/type :answer.type/math :answer/value "{f}^{′}(x)={e}^{x}+4x" :db/ensure [:answer/validate]} {:db/id 17592186096612 :knowledge-point/questions ["question-47d673bd-5b90-569f-9bcd-5db84649c548" "question-0f325821-aed1-5216-b5a3-ffaf528190d5" "question-5e010595-5a96-5d35-8548-77ec2815a5a0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-47d673bd-5b90-569f-9bcd-5db84649c548" :question/id #uuid "47d673bd-5b90-569f-9bcd-5db84649c548" :question/math-academy-id "q-340277" :question/problem "Given that $f(x)=3\\cdot {4}^{x}-2{e}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x}-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x})|}_{x=1} \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{1}-2{e}^{1} \\\\  & =12\\operatorname{ln}⁡(4)-2e.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b41aee66-8662-5e0a-8dc7-1405a17238b0"] :db/ensure [:question/validate]} {:db/id "answer-field-b41aee66-8662-5e0a-8dc7-1405a17238b0" :answer-field/id #uuid "b41aee66-8662-5e0a-8dc7-1405a17238b0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8301abdf-6346-54fc-a966-bee78fbb19e6" :answer-field/choices ["answer-8301abdf-6346-54fc-a966-bee78fbb19e6"] :db/ensure [:answer-field/validate]} {:db/id "answer-8301abdf-6346-54fc-a966-bee78fbb19e6" :answer/id #uuid "8301abdf-6346-54fc-a966-bee78fbb19e6" :answer/type :answer.type/math :answer/value "12\\ln 4-2e" :db/ensure [:answer/validate]} {:db/id "question-0f325821-aed1-5216-b5a3-ffaf528190d5" :question/id #uuid "0f325821-aed1-5216-b5a3-ffaf528190d5" :question/math-academy-id "q-340284" :question/problem "Given that $f(x)=\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5))-\\frac{\\text{d}}{\\text{d}x}(3\\cdot {2}^{x}) \\\\  & =0-3\\frac{\\text{d}}{\\text{d}x}({2}^{x}) \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(-3\\operatorname{ln}⁡(2)\\cdot {2}^{x})|}_{x=1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot 2 \\\\  & =-6\\operatorname{ln}⁡(2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4d0c9719-4708-560e-a504-150738be227f"] :db/ensure [:question/validate]} {:db/id "answer-field-4d0c9719-4708-560e-a504-150738be227f" :answer-field/id #uuid "4d0c9719-4708-560e-a504-150738be227f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5669689b-d4c2-598a-9b8e-4640a33a9697" :answer-field/choices ["answer-5669689b-d4c2-598a-9b8e-4640a33a9697"] :db/ensure [:answer-field/validate]} {:db/id "answer-5669689b-d4c2-598a-9b8e-4640a33a9697" :answer/id #uuid "5669689b-d4c2-598a-9b8e-4640a33a9697" :answer/type :answer.type/math :answer/value "-6\\ln 2" :db/ensure [:answer/validate]} {:db/id "question-5e010595-5a96-5d35-8548-77ec2815a5a0" :question/id #uuid "5e010595-5a96-5d35-8548-77ec2815a5a0" :question/math-academy-id "q-340285" :question/problem "Given that $f(x)=5\\cdot {7}^{x}$, the slope of the tangent at $x=0$ is{{field-1}}." :question/worked-solution "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5\\cdot {7}^{x}) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({7}^{x}) \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5\\operatorname{ln}⁡(7)\\cdot {7}^{x})|}_{x=0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot 1 \\\\  & =5\\operatorname{ln}⁡(7).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5f82e929-b888-5d34-a5dc-e42fb4ed9aff"] :db/ensure [:question/validate]} {:db/id "answer-field-5f82e929-b888-5d34-a5dc-e42fb4ed9aff" :answer-field/id #uuid "5f82e929-b888-5d34-a5dc-e42fb4ed9aff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3481b85e-58eb-5313-8a75-21e00c14674a" :answer-field/choices ["answer-3481b85e-58eb-5313-8a75-21e00c14674a"] :db/ensure [:answer-field/validate]} {:db/id "answer-3481b85e-58eb-5313-8a75-21e00c14674a" :answer/id #uuid "3481b85e-58eb-5313-8a75-21e00c14674a" :answer/type :answer.type/math :answer/value "5\\ln 7" :db/ensure [:answer/validate]} {:db/id "activity-943d4724-4157-55d1-a2b7-c6967297f552" :activity/id #uuid "943d4724-4157-55d1-a2b7-c6967297f552" :activity/title "Differentiating Exponential Functions" :activity/type :activity.type/review :activity/scope 17592186048749 :activity/course 17592186046647 :activity/steps ["step-b6c1d9da-40dd-56ff-9485-773b66c48f3c" "step-fbee3716-0f60-561c-b60e-4bde22d77367" "step-c9a5a8b7-be4a-5735-b51b-59b6b55d6cc5" "step-1be5bca1-959e-5dc6-afbd-3797a27d03d0" "step-af2c57ec-5158-512f-86f1-2fb4d3101440"] :activity/first-step "step-b6c1d9da-40dd-56ff-9485-773b66c48f3c" :db/ensure [:activity/validate]} {:db/id "step-b6c1d9da-40dd-56ff-9485-773b66c48f3c" :step/id #uuid "b6c1d9da-40dd-56ff-9485-773b66c48f3c" :step/content 17592186096989 :step/next "step-fbee3716-0f60-561c-b60e-4bde22d77367" :db/ensure [:step/validate]} {:db/id "step-fbee3716-0f60-561c-b60e-4bde22d77367" :step/id #uuid "fbee3716-0f60-561c-b60e-4bde22d77367" :step/content 17592186272085 :step/next "step-c9a5a8b7-be4a-5735-b51b-59b6b55d6cc5" :db/ensure [:step/validate]} {:db/id "step-c9a5a8b7-be4a-5735-b51b-59b6b55d6cc5" :step/id #uuid "c9a5a8b7-be4a-5735-b51b-59b6b55d6cc5" :step/content "question-47d673bd-5b90-569f-9bcd-5db84649c548" :step/next "step-1be5bca1-959e-5dc6-afbd-3797a27d03d0" :db/ensure [:step/validate]} {:db/id "step-1be5bca1-959e-5dc6-afbd-3797a27d03d0" :step/id #uuid "1be5bca1-959e-5dc6-afbd-3797a27d03d0" :step/content "question-0f325821-aed1-5216-b5a3-ffaf528190d5" :step/next "step-af2c57ec-5158-512f-86f1-2fb4d3101440" :db/ensure [:step/validate]} {:db/id "step-af2c57ec-5158-512f-86f1-2fb4d3101440" :step/id #uuid "af2c57ec-5158-512f-86f1-2fb4d3101440" :step/content "question-5e010595-5a96-5d35-8548-77ec2815a5a0" :db/ensure [:step/validate]} {:db/id 17592186162016 :knowledge-point/questions ["question-75ae4937-7257-5ddb-963c-2c5dab077964"] :db/ensure [:knowledge-point/validate]} {:db/id "question-75ae4937-7257-5ddb-963c-2c5dab077964" :question/id #uuid "75ae4937-7257-5ddb-963c-2c5dab077964" :question/math-academy-id "q-140635" :question/problem "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $4\\times 2$ matrix, which of the following statements are true?\n\nI. $U$ is a $4\\times 4$ orthogonal matrix\n\nII. $Σ$ is a $2\\times 2$ matrix\n\nIII. $V$ is a diagonal matrix with only positive elements on the main diagonal" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $4\\times 2$ matrix, $U$ in the singular value decomposition $UΣ{V}^{T}$ must be a $4\\times 4$ orthogonal matrix.\n\n- Statement II is false. Since $A$ is a $4\\times 2$ matrix, $Σ$ must be a $4\\times 2$ matrix.\n\n- Statement III is false. The matrix $V$ in the singular value decomposition $UΣ{V}^{T}$ must be an orthogonal matrix, not a diagonal matrix.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9d2a03a5-a99e-5c9a-aa6c-8403dc252051"] :db/ensure [:question/validate]} {:db/id "answer-field-9d2a03a5-a99e-5c9a-aa6c-8403dc252051" :answer-field/id #uuid "9d2a03a5-a99e-5c9a-aa6c-8403dc252051" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-87a762ea-1f1b-52db-9e42-9df82522b93d" :answer-field/choices ["answer-4ee1bbdc-7319-50f5-b95b-e0b9229082a0" "answer-87a762ea-1f1b-52db-9e42-9df82522b93d" "answer-75c1a5b8-85c2-5eb5-b5b9-c7bab8ab41a0" "answer-5d4fe57c-b619-5bf4-a435-2a7ba27bfb30" "answer-4590f3bd-e752-5e65-a452-9b1d195950f1"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ee1bbdc-7319-50f5-b95b-e0b9229082a0" :answer/id #uuid "4ee1bbdc-7319-50f5-b95b-e0b9229082a0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-87a762ea-1f1b-52db-9e42-9df82522b93d" :answer/id #uuid "87a762ea-1f1b-52db-9e42-9df82522b93d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-75c1a5b8-85c2-5eb5-b5b9-c7bab8ab41a0" :answer/id #uuid "75c1a5b8-85c2-5eb5-b5b9-c7bab8ab41a0" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5d4fe57c-b619-5bf4-a435-2a7ba27bfb30" :answer/id #uuid "5d4fe57c-b619-5bf4-a435-2a7ba27bfb30" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-4590f3bd-e752-5e65-a452-9b1d195950f1" :answer/id #uuid "4590f3bd-e752-5e65-a452-9b1d195950f1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186162664 :question/problem "$$\nA=[\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}],\\,Σ=[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}],\\,V=[\\begin{aligned}{v}_{11} & {v}_{12} \\\\ {v}_{21} & {v}_{22}\\end{aligned}]\n$$\n\nConsider the matrices shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ what is the value of $|{v}_{12}|+|{v}_{22}|?$" :question/worked-solution "If $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ the columns of $V$ must be the right singular vectors of $A,$ i.e., the unit eigenvectors of the matrix ${A}^{T}\\,A.$ \n\nFrom the matrix $Σ,$ we deduce that the singular values are ${\\sigma }_{1}=3$ and ${\\sigma }_{2}=2.$ So, the second column of $V$ corresponds to the singular value ${\\sigma }_{2}=2.$\n\nHence, we need to find a unit eigenvector of ${A}^{T}\\,A$ that corresponds to the eigenvalue ${\\lambda }_{2}={\\sigma }_{2}^{2}=4.$ \n\n- Computing ${A}^{T}\\,A,$ we obtain \n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}]}^{T}[\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ -2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -2 \\\\ -2 & 5\\end{aligned}]\\end{aligned}\n$$\n\n- Computing ${A}^{T}\\,A-4I,$ we get\n\n$$\n{A}^{T}\\,A-4I=[\\begin{aligned}8 & -2 \\\\ -2 & 5\\end{aligned}]-4[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}4 & -2 \\\\ -2 & 1\\end{aligned}]\n$$\n\n- Seeking a non-zero solution of $({A}^{T}\\,A-4I)v=0$ gives the eigenvector $v=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Dividing $v$ by its norm, we get \n\n$$\n\\frac{v}{‖v‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}1 \\\\ 2\\end{aligned}]=[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}].\n$$\n\nTherefore,\n\n$$\n|{v}_{12}|+|{v}_{22}|=|\\frac{1}{\\sqrt{5}}|+|\\frac{2}{\\sqrt{5}}|=\\frac{3}{\\sqrt{5}}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186161276 :answer-field/correct 17592186161278 :db/ensure [:answer-field/validate]} {:db/id 17592186163247 :tutorial/content "Suppose that $A$ is an $m\\times n$ matrix, and \n\n$$\nA= U\\Sigma V^T\n$$\n\nis a singular value decomposition of $A.$ Let's describe how to find the matrices $V$ and $\\Sigma$ of this singular value decomposition. \n\nNotice that if we compute $A^TA,$ we get\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={(UΣ{V}^{T})}^{T}(UΣ{V}^{T}) \\\\  & =(V{Σ}^{T}\\,{U}^{T})(UΣ{V}^{T}) \\\\  & =V{Σ}^{T}({U}^{T}\\,U)Σ{V}^{T} \\\\  & =V{Σ}^{T}({I}_{n})Σ{V}^{T} \\\\  & =V({Σ}^{T}\\,Σ){V}^{T}.\\end{aligned}\n$$\n\nFrom here, we note that $A^T \\! A$ is always symmetric, and that $\\Sigma^T \\! \\Sigma$ is a diagonal matrix with the squares of the singular values on the main diagonal. As a result,\n\n$$\nA^TA = V\\left( \\Sigma^T \\Sigma\\right) V^T\n$$\n\nis an orthogonal diagonalization of the symmetric matrix $A^T \\! A.$ So, to find the matrix $V$ in our SVD, we need to orthogonally diagonalize $A^T A.$\n\nLet's demonstrate how this works in practice by computing the matrices $\\Sigma$ and $V$ in the SVD of the matrix $A,$ given by\n\n![](images/b7/b766ec7d8c00dfc121e707566d21db470c087c3e785f4e1b2868e7f932873c67.svg)\n\nWe proceed as follows:\n\n- Computing $A^T \\! A,$ we obtain \n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}2 & -3 \\\\ 0 & 2\\end{aligned}]}^{T}[\\begin{aligned}2 & -3 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}2 & -3 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -6 \\\\ -6 & 13\\end{aligned}].\\end{aligned}\n$$\n\n- Solving the characteristic equation $|A^T \\! A - \\lambda I| = 0,$ we get the eigenvalues of $A^T \\! A \\mathbin{:}$\n\n$$\n{\\color{blue}{\\lambda_1 = 16}}, \\qquad  {\\color{red}{\\lambda_2 = 1}}\n$$\n\nSo, the corresponding singular values are \n\n$$\n{\\color{blue}\\sigma_1 = \\sqrt{\\lambda_1}  = 4},  \\qquad {\\color{red}\\sigma_2 = \\sqrt{\\lambda_2} = 1}.\n$$\n\nWe now find a unit eigenvector basis of $A^T \\! A.$ These unit eigenvectors will be the columns of our matrix $V$ in the orthogonal diagonalization of $A^T \\! A$.\n\n- Computing $(A^T \\! A - {\\color{blue}\\lambda_1} I),$ we obtain\n![](images/f0/f074943374fd488663eda967ab64f335047f9b6cc91c98c504dcb0f2ee8282a6.svg)\nSeeking a unit solution of $(A^T\\! A - 16I)\\mathbf{v} = \\mathbf{0},$ we get\n![](images/03/03d6a116d751736f50c366cd4721ee7d1dbf39048092272acc6577934f4600c7.svg)\n\n- Computing $(A^T \\! A - {\\color{red}\\lambda_2} I),$ we obtain\n![](images/16/16813fa19b3417b6de49f9c3c1c27cfedca850b473da01d3b0e0a0b3091b6e28.svg)\nSeeking a unit solution of $(A^T\\! A - I)\\mathbf{v} = \\mathbf{0},$ we get\n![](images/32/32b3c9740740767d4d849ac2d73552dee1e225cc507e95a17c727e8c3fcc6275.svg)\n\nFinally, we construct the matrices $\\Sigma$ and $V\\mathbin{:}$\n![](images/85/85c926521f0588117992c019ab0db3723520a14ba4c2879d630ab391462b4af2.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186163317 :tutorial/content "Consider the matrices $A,$ $\\Sigma,$ and $V$ shown below. \n\n![](images/61/61ff6d3a83c2a660ca8369d96ab7bede86f9a124727db8d5a7e320dcd5aaad74.svg)\n\nSuppose we're given that $A=U \\Sigma V^T$ is a singular value decomposition of $A.$ Let's use this information to find the matrix $U.$\n\nFrom the matrix $\\Sigma,$ we deduce that the singular values are $\\color{blue}\\sigma_1=9$ and $\\color{red}\\sigma_2=1.$ \n\nEarlier, we saw that the columns of $\\mathbf u$ are given by\n\n$$\n\\mathbf{u}_i = \\dfrac{1}{\\sigma_i} A\\mathbf{v}_i\n$$\n\nwhere $\\mathbf u_i$ and $\\mathbf v_i$ are the $i$th columns of the matrices $U$ and $V,$ respectively. Therefore, we compute the columns of $\\mathbf u$ as follows:\n\n- First, we compute the vector $\\mathbf u_1\\mathbin{:}$\n\n$$\n\\begin{aligned}{u}_{1} & =\\frac{1}{{\\sigma }_{1}}A{v}_{1} \\\\  & =\\frac{1}{9}[\\begin{aligned}3 & 8 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}\\frac{27}{\\sqrt{10}} \\\\ \\frac{9}{\\sqrt{10}}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}]\\end{aligned}\n$$\n\n- Then, we compute the vector $\\mathbf u_2\\mathbin{:}$\n\n$$\n\\begin{aligned}{u}_{2} & =\\frac{1}{{\\sigma }_{2}}A{v}_{2} \\\\  & =\\frac{1}{1}[\\begin{aligned}3 & 8 \\\\ 0 & 3\\end{aligned}][\\begin{aligned}-\\frac{3}{\\sqrt{10}} \\\\ \\frac{1}{\\sqrt{10}}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]\\end{aligned}\n$$\n\nAs a result, the matrix $U$ in our singular value decomposition of $A$ is given by\n\n![](images/15/159ace613dacf666b32131543c77b3eb602e16226ba2d37e9e8bea4dcff1cb56.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186163246 :tutorial/content "We can now fully describe the algorithm for computing the singular value decomposition of $A.$\n\n- **Step 1.** Compute $A^T \\! A.$\n\n- **Step 2.** Find the singular values. This allows us to construct the second matrix $\\Sigma.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of $A^T \\! A$). This allows us to construct the third matrix $V.$\n\n- **Step 4.** Find the left singular vectors of $A$ using the singular values, right singular vectors, and the formula\n\n$$\n\\mathbf{u}_i = \\dfrac{1}{\\sigma_i} A\\mathbf{v}_i,\n$$\n\n \nwhere $\\mathbf u_i$ and $\\mathbf v_i$ are the $i$th columns of the matrices $U$ and $V,$ respectively. This allows us to construct the matrix $U.$\n\nConsider the matrices $A$ and $\\Sigma$ shown below. Given that $A=U \\Sigma V^T$ is a singular value decomposition of $A,$ let's find the matrices $U$ and $V.$\n\n![](images/ab/abe87fb2a304ff102bb3f703d025c7d41f56cb6fab7fc477b3073cbd820cda6e.svg)\n\nWe find the singular value decomposition of $A$ using our algorithm.\n\n- **Step 1.** Compute $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & =[\\begin{aligned}89 & 16 \\\\ 16 & 113\\end{aligned}]\\end{aligned}\n$$\n\n- **Step 2.** Find the singular values: From the matrix $\\Sigma,$ we deduce that $\\color{blue}\\sigma_1=11$ and $\\color{red}\\sigma_2=9.$\n\n- **Step 3.** Find the right singular vectors of $A$ (i.e., the unit eigenvectors of $A^T \\! A$):\n\n- Seeking a unit solution of $(A^T \\! A - 121I)\\mathbf{v}=\\mathbf{0}$ gives\n![](images/41/4195807c3f61cd730c57340666c8d651e94d2b277f9623da7cd482c1d7123303.svg)\n\n- Seeking a unit solution of $(A^T \\! A - 81I)\\mathbf{v}=\\mathbf{0}$ gives\n![](images/64/64aa31f039ec188355522cffa8a6c62df8c53bb409e55df32ce880d9a9efcd6e.svg)\n\n- **Step 4.** Find the left singular vectors of $A$: Since we know the singular values and right singular vectors, we can compute the columns of $U$ as follows:\n\n$$\n\\begin{aligned}{u}_{1}=\\frac{1}{{\\sigma }_{1}}A{v}_{1}=[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}],\\,{u}_{2}=\\frac{1}{{\\sigma }_{2}}A{v}_{2}=[\\begin{aligned}-\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we construct the matrices $U$ and $V\\mathbin{:}$\n\n![](images/ab/ab0a5a5a284c962414158e5b7c463264b271bdd57decd8e08305285f7243f7bd.svg)" :db/ensure [:tutorial/validate]} {:db/id "activity-dcac007b-4160-5c57-b3fa-73790e770eac" :activity/id #uuid "dcac007b-4160-5c57-b3fa-73790e770eac" :activity/title "The Four Fundamental Subspaces of a Matrix" :activity/type :activity.type/review :activity/scope 17592186049881 :activity/course 17592186046645 :activity/steps ["step-a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" "step-12ea7b05-1139-5991-9ab8-d66b18daabf2" "step-32720668-2e01-58f0-9e8c-cb68020bcffd" "step-03787068-e65a-5894-ac0f-70677b84b503" "step-b86b6c6f-57d1-5201-a6cd-714b57d1a7ce"] :activity/first-step "step-a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" :db/ensure [:activity/validate]} {:db/id "step-a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" :step/id #uuid "a47247ac-314d-5bb2-ba6f-fdd8d1f684d7" :step/content 17592186134071 :step/next "step-12ea7b05-1139-5991-9ab8-d66b18daabf2" :db/ensure [:step/validate]} {:db/id "step-12ea7b05-1139-5991-9ab8-d66b18daabf2" :step/id #uuid "12ea7b05-1139-5991-9ab8-d66b18daabf2" :step/content 17592186362743 :step/next "step-32720668-2e01-58f0-9e8c-cb68020bcffd" :db/ensure [:step/validate]} {:db/id "step-32720668-2e01-58f0-9e8c-cb68020bcffd" :step/id #uuid "32720668-2e01-58f0-9e8c-cb68020bcffd" :step/content 17592186362750 :step/next "step-03787068-e65a-5894-ac0f-70677b84b503" :db/ensure [:step/validate]} {:db/id "step-03787068-e65a-5894-ac0f-70677b84b503" :step/id #uuid "03787068-e65a-5894-ac0f-70677b84b503" :step/content 17592186134077 :step/next "step-b86b6c6f-57d1-5201-a6cd-714b57d1a7ce" :db/ensure [:step/validate]} {:db/id "step-b86b6c6f-57d1-5201-a6cd-714b57d1a7ce" :step/id #uuid "b86b6c6f-57d1-5201-a6cd-714b57d1a7ce" :step/content 17592186362777 :db/ensure [:step/validate]} {:db/id 17592186240996 :question/problem "Let $V={R}_{1}[t],$ the vector space of real polynomials of degree at most $1,$ and let the inner product on $V$ be defined as\n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1).\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{p}_{1}(t)=5t,\\,{p}_{2}(t)=-2t+2,\\,q(t)=-t-4\n$$\n\nFind the orthogonal projection of $q(t)$ onto $S=\\text{Span}\\{{p}_{1}(t),{p}_{2}(t)\\}$ given that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $q(t)$ onto $\\text{Span}\\{{p}_{1}(t)\\}$ equals $-5t.$" :question/worked-solution "Since the set $\\{{p}_{1}(t),{p}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $q(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,q(t)={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t).\n$$\n\nWe are given that ${\\text{proj}}_{{p}_{1}(t)}\\,q(t)=-5t,$ so let's now find the orthogonal projection of $q(t)$ onto $\\text{Span}\\{{p}_{2}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{p}_{2}(t)}\\,q(t)=\\frac{⟨q(t),{p}_{2}(t)⟩}{⟨{p}_{2}(t),{p}_{2}(t)⟩}\\,{p}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨q(t),{p}_{2}(t)⟩ & =q(0){p}_{2}(0)+q(1){p}_{2}(1) \\\\  & =(-t-4){|}_{0}\\cdot (-2t+2){|}_{0}+(-t-4){|}_{1}\\cdot (-2t+2){|}_{1} \\\\  & =(-4)\\cdot 2+(-5)\\cdot 0 \\\\  & =-8,\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{2}(t)⟩ & ={p}_{2}(0){p}_{2}(0)+{p}_{2}(1){p}_{2}(1) \\\\  & =(-2t+2)^{2}{|}_{0}+(-2t+2)^{2}{|}_{1} \\\\  & ={2}^{2}+{0}^{2} \\\\  & =4.\\end{aligned}\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{proj}}_{{p}_{2}(t)}\\,q(t) & =\\frac{-8}{4}\\cdot (-2t+2)=4t-4.\\end{aligned}\n$$\n\n  \n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,q(t) & ={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t) \\\\  & =-5t+(4t-4) \\\\  & =-t-4.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186134064 :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡t,\\,{f}_{2}(t)=\\operatorname{cos}⁡t,\\,g(t)={sin}^{2}⁡t-\\operatorname{cos}⁡t\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{{f}_{1}(t),{f}_{2}(t)\\}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{2}(t)\\}$ equals $-\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set $\\{{f}_{1}(t),{f}_{2}(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{2}(t)}\\,g(t)=-\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}\\{{f}_{1}(t)\\}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{1}(t)⟩}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\,{f}_{1}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{1}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{1}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while ${sin}^{2}⁡t-\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{0}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\cdot \\operatorname{sin}⁡t=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =0-\\operatorname{cos}⁡t \\\\  & =-\\operatorname{cos}⁡t.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186133875 :knowledge-point/questions ["question-bb47ff23-1630-5500-b6a4-5200379ffde8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bb47ff23-1630-5500-b6a4-5200379ffde8" :question/id #uuid "bb47ff23-1630-5500-b6a4-5200379ffde8" :question/math-academy-id "q-105467" :question/problem "Let $V={R}_{1}[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1),\n$$\n\nfind the distance between $f(t)=4t$ and $g(t)=3t-3$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=4t$ and $g(t)=3t-3$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖4t-(3t-3)‖ \\\\  & =‖t+3‖ \\\\  & =\\sqrt{⟨t+3,t+3⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨t+3,t+3⟩ & =(t+3){|}_{0}\\cdot (t+3){|}_{0}+(t+3){|}_{1}\\cdot (t+3){|}_{1} \\\\  & =3\\cdot 3+4\\cdot 4 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{25}=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5b5594d1-b2ee-51bd-9f3b-6fbc40eddcaf"] :db/ensure [:question/validate]} {:db/id "answer-field-5b5594d1-b2ee-51bd-9f3b-6fbc40eddcaf" :answer-field/id #uuid "5b5594d1-b2ee-51bd-9f3b-6fbc40eddcaf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8b0d1b2-9e6e-5c88-a436-a3385da1208b" :answer-field/choices ["answer-af5d4774-4ab0-51ea-ab1d-5bfe0d1c2a08" "answer-c8b0d1b2-9e6e-5c88-a436-a3385da1208b" "answer-a13cafa2-36ee-5a1f-b1e2-a197fbd99fd2" "answer-8aeb3719-7223-5b3f-9a0d-5ec07ace7bda" "answer-55f451c5-1cf6-5e8f-b78f-8d4162ba19df"] :db/ensure [:answer-field/validate]} {:db/id "answer-af5d4774-4ab0-51ea-ab1d-5bfe0d1c2a08" :answer/id #uuid "af5d4774-4ab0-51ea-ab1d-5bfe0d1c2a08" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c8b0d1b2-9e6e-5c88-a436-a3385da1208b" :answer/id #uuid "c8b0d1b2-9e6e-5c88-a436-a3385da1208b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-a13cafa2-36ee-5a1f-b1e2-a197fbd99fd2" :answer/id #uuid "a13cafa2-36ee-5a1f-b1e2-a197fbd99fd2" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-8aeb3719-7223-5b3f-9a0d-5ec07ace7bda" :answer/id #uuid "8aeb3719-7223-5b3f-9a0d-5ec07ace7bda" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-55f451c5-1cf6-5e8f-b78f-8d4162ba19df" :answer/id #uuid "55f451c5-1cf6-5e8f-b78f-8d4162ba19df" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id 17592186241063 :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}\\{g(t)\\}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{{\\int }_{0}^{1}8t\\cdot (4t-2)\\,\\text{d}t}{{\\int }_{0}^{1}(4t-2)^{2}\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{{\\int }_{0}^{1}(32{t}^{2}-16t)\\,\\text{d}t}{{\\int }_{0}^{1}(16{t}^{2}-16t+4)\\,\\text{d}t}\\cdot (4t-2) \\\\  & =\\frac{[\\frac{32}{3}{t}^{3}-8{t}^{2}]_{0}^{1}}{[\\frac{16}{3}{t}^{3}-8{t}^{2}+4t]_{0}^{1}}\\cdot (4t-2) \\\\  & =\\frac{(\\frac{32}{3}-8)-0}{(\\frac{16}{3}-4)-0}\\cdot (6t-3) \\\\  & =\\frac{(\\frac{8}{3})}{(\\frac{4}{3})}\\cdot (4t+2) \\\\  & =2\\cdot (4t-2) \\\\  & =8t-4.\\end{aligned}\n$$\n\nThe distance between $f(t)=8t$ and the subspace spanned by $g(t)=4t-2$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-{\\text{proj}}_{g(t)}\\,f(t)‖ \\\\  & =‖8t-(8t-4)‖ \\\\  & =‖4‖ \\\\  & =\\sqrt{⟨4,4⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨4,4⟩ & ={\\int }_{0}^{1}4\\cdot 4\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}16\\,\\text{d}t \\\\  & =16t\\,{|}_{0}^{1} \\\\  & =16-0 \\\\  & =16.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{16}=4.$" :db/ensure [:question/validate]} {:db/id "activity-523c181c-49b6-5cd6-8fa6-f326baf39d66" :activity/id #uuid "523c181c-49b6-5cd6-8fa6-f326baf39d66" :activity/title "Projecting Vectors Onto Subspaces in Inner Product Spaces" :activity/type :activity.type/review :activity/scope 17592186050841 :activity/course 17592186046660 :activity/steps ["step-7dcbde88-fad6-5855-868c-5505b488f9cb" "step-32c4db97-0f9a-5a4a-9397-f3afd25d9b5a" "step-25ebdf79-afa5-5b0e-8ef3-42e59a98265f" "step-71427223-2fdd-5bbd-81e0-02928d1f72bb" "step-8daf7e4b-481a-569d-84a0-20ce16510f71"] :activity/first-step "step-7dcbde88-fad6-5855-868c-5505b488f9cb" :db/ensure [:activity/validate]} {:db/id "step-7dcbde88-fad6-5855-868c-5505b488f9cb" :step/id #uuid "7dcbde88-fad6-5855-868c-5505b488f9cb" :step/content 17592186240996 :step/next "step-32c4db97-0f9a-5a4a-9397-f3afd25d9b5a" :db/ensure [:step/validate]} {:db/id "step-32c4db97-0f9a-5a4a-9397-f3afd25d9b5a" :step/id #uuid "32c4db97-0f9a-5a4a-9397-f3afd25d9b5a" :step/content 17592186134064 :step/next "step-25ebdf79-afa5-5b0e-8ef3-42e59a98265f" :db/ensure [:step/validate]} {:db/id "step-25ebdf79-afa5-5b0e-8ef3-42e59a98265f" :step/id #uuid "25ebdf79-afa5-5b0e-8ef3-42e59a98265f" :step/content "question-bb47ff23-1630-5500-b6a4-5200379ffde8" :step/next "step-71427223-2fdd-5bbd-81e0-02928d1f72bb" :db/ensure [:step/validate]} {:db/id "step-71427223-2fdd-5bbd-81e0-02928d1f72bb" :step/id #uuid "71427223-2fdd-5bbd-81e0-02928d1f72bb" :step/content 17592186241063 :step/next "step-8daf7e4b-481a-569d-84a0-20ce16510f71" :db/ensure [:step/validate]} {:db/id "step-8daf7e4b-481a-569d-84a0-20ce16510f71" :step/id #uuid "8daf7e4b-481a-569d-84a0-20ce16510f71" :step/content 17592186241070 :db/ensure [:step/validate]} {:db/id 17592186152152 :knowledge-point/questions ["question-e3f890f2-0602-53b4-b697-bf1bfc15cf9a" "question-a3ec1567-3655-5115-83b3-81bdfee12880" "question-efacd675-1f5e-570d-8835-58b0708fe7ea"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186152151 :knowledge-point/questions ["question-dfc2de0e-3b59-5c5d-bed1-0d2b8726dbb0" "question-d30a7455-cf28-573b-a7f5-088c618e903c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151939 :question/problem "Let $R = [1,5] \\times [2,6]$ be a region in the $xy$-plane, and let $f(x,y) = 65-x^2-y^2.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,3,5\\},\\,{P}_{2}=\\{2,4,6\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id 17592186152150 :knowledge-point/questions ["question-4bd06db2-69af-51a2-9fd5-21474b678038"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151938 :question/problem "Let $R = [0,2]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y) = x+2y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{0,1,2\\},\\,{P}_{2}=\\{1,2,3\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id "question-e3f890f2-0602-53b4-b697-bf1bfc15cf9a" :question/id #uuid "e3f890f2-0602-53b4-b697-bf1bfc15cf9a" :question/math-academy-id "q-123057" :question/problem "![](images/16/16e592cd81e6539e26f10b6bd9352b047576df24b74b4df693f5f2f69799b228.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" :question/worked-solution "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=6.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =6\\cdot {M}_{11}+6\\cdot {M}_{21}+6\\cdot {M}_{12}+6\\cdot {M}_{22} \\\\  & =6({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0fb99eb4-e0b4-5357-8ce8-08584c6260b4"] :db/ensure [:question/validate]} {:db/id "answer-field-0fb99eb4-e0b4-5357-8ce8-08584c6260b4" :answer-field/id #uuid "0fb99eb4-e0b4-5357-8ce8-08584c6260b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b766cfd8-6c6f-5a73-8c80-f2d0880c659a" :answer-field/choices ["answer-b766cfd8-6c6f-5a73-8c80-f2d0880c659a" "answer-2f3098d3-875b-59ab-8cac-dfd53d3cd743" "answer-370d35e1-74cd-5762-b7ee-1e0055383a68" "answer-00ec49a8-4c66-57e0-837c-295202d2c300" "answer-6f04ca05-8b47-57ce-86ea-b16c43610fdd"] :db/ensure [:answer-field/validate]} {:db/id "answer-b766cfd8-6c6f-5a73-8c80-f2d0880c659a" :answer/id #uuid "b766cfd8-6c6f-5a73-8c80-f2d0880c659a" :answer/type :answer.type/math :answer/value "6({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22})" :db/ensure [:answer/validate]} {:db/id "answer-2f3098d3-875b-59ab-8cac-dfd53d3cd743" :answer/id #uuid "2f3098d3-875b-59ab-8cac-dfd53d3cd743" :answer/type :answer.type/math :answer/value "6\\cdot {M}_{11}\\cdot {M}_{21}\\cdot {M}_{12}\\cdot {M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-370d35e1-74cd-5762-b7ee-1e0055383a68" :answer/id #uuid "370d35e1-74cd-5762-b7ee-1e0055383a68" :answer/type :answer.type/math :answer/value "6{M}_{11}+{M}_{21}+6{M}_{12}+{M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-00ec49a8-4c66-57e0-837c-295202d2c300" :answer/id #uuid "00ec49a8-4c66-57e0-837c-295202d2c300" :answer/type :answer.type/math :answer/value "6{M}_{11}+{M}_{21}+{M}_{12}+6{M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-6f04ca05-8b47-57ce-86ea-b16c43610fdd" :answer/id #uuid "6f04ca05-8b47-57ce-86ea-b16c43610fdd" :answer/type :answer.type/math :answer/value "{M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}" :db/ensure [:answer/validate]} {:db/id "question-a3ec1567-3655-5115-83b3-81bdfee12880" :question/id #uuid "a3ec1567-3655-5115-83b3-81bdfee12880" :question/math-academy-id "q-123053" :question/problem "![](images/fe/fe238b0f1c4a9c34f569c9f4c4655f4a6094ee00a225a0d418fff7276705060d.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" :question/worked-solution "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=2\n$$\n\nand\n\n$$\n\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=6.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =2\\cdot {M}_{11}+2\\cdot {M}_{21}+6\\cdot {M}_{12}+6\\cdot {M}_{22} \\\\  & =2{M}_{11}+2{M}_{21}+6{M}_{12}+6{M}_{22}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-35f6b671-0fc0-5734-b06f-e7fe4838a002"] :db/ensure [:question/validate]} {:db/id "answer-field-35f6b671-0fc0-5734-b06f-e7fe4838a002" :answer-field/id #uuid "35f6b671-0fc0-5734-b06f-e7fe4838a002" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-54327926-359a-5165-a08e-59aa2c9b606c" :answer-field/choices ["answer-6bf11002-5e0a-5591-bba5-640a8959e1ea" "answer-12cae175-9eb8-52ec-b5ee-cca018af75f3" "answer-54327926-359a-5165-a08e-59aa2c9b606c" "answer-96a56b16-b20c-581c-9afb-e98db8c8345b" "answer-fdeb3993-9cd1-512d-855a-4efc536c8941"] :db/ensure [:answer-field/validate]} {:db/id "answer-6bf11002-5e0a-5591-bba5-640a8959e1ea" :answer/id #uuid "6bf11002-5e0a-5591-bba5-640a8959e1ea" :answer/type :answer.type/math :answer/value "16{M}_{11}\\cdot {M}_{21}\\cdot {M}_{12}\\cdot {M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-12cae175-9eb8-52ec-b5ee-cca018af75f3" :answer/id #uuid "12cae175-9eb8-52ec-b5ee-cca018af75f3" :answer/type :answer.type/math :answer/value "2{M}_{11}+2{M}_{21}+3{M}_{12}+3{M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-54327926-359a-5165-a08e-59aa2c9b606c" :answer/id #uuid "54327926-359a-5165-a08e-59aa2c9b606c" :answer/type :answer.type/math :answer/value "2{M}_{11}+2{M}_{21}+6{M}_{12}+6{M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-96a56b16-b20c-581c-9afb-e98db8c8345b" :answer/id #uuid "96a56b16-b20c-581c-9afb-e98db8c8345b" :answer/type :answer.type/math :answer/value "{M}_{11}+{M}_{21}+3{M}_{12}+3{M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-fdeb3993-9cd1-512d-855a-4efc536c8941" :answer/id #uuid "fdeb3993-9cd1-512d-855a-4efc536c8941" :answer/type :answer.type/math :answer/value "{M}_{11}+{M}_{21}+6{M}_{12}+6{M}_{22}" :db/ensure [:answer/validate]} {:db/id "question-efacd675-1f5e-570d-8835-58b0708fe7ea" :question/id #uuid "efacd675-1f5e-570d-8835-58b0708fe7ea" :question/math-academy-id "q-123124" :question/problem "![](images/df/dfba17c3f5744cf122c8051226bc627799bd261b4a5ed6f4d8a03b405dea0c50.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" :question/worked-solution "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=3.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =3\\cdot {M}_{11}+3\\cdot {M}_{21}+3\\cdot {M}_{12}+3\\cdot {M}_{22} \\\\  & =3({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c8e8e57f-c7b6-551b-bce9-5ffb5155b1cc"] :db/ensure [:question/validate]} {:db/id "answer-field-c8e8e57f-c7b6-551b-bce9-5ffb5155b1cc" :answer-field/id #uuid "c8e8e57f-c7b6-551b-bce9-5ffb5155b1cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f4c6b4ce-018b-515d-bef0-2f04e8ea0da2" :answer-field/choices ["answer-76161c0c-8afc-5f25-94bc-a96e00d6677b" "answer-f4c6b4ce-018b-515d-bef0-2f04e8ea0da2" "answer-11523a51-2013-50cb-87e8-a988018c32d1" "answer-c35fdd4c-7015-5d94-bf90-fea0b4a09186" "answer-4d0a71d9-6603-5944-abe0-c07308a877f8"] :db/ensure [:answer-field/validate]} {:db/id "answer-76161c0c-8afc-5f25-94bc-a96e00d6677b" :answer/id #uuid "76161c0c-8afc-5f25-94bc-a96e00d6677b" :answer/type :answer.type/math :answer/value "12({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22})" :db/ensure [:answer/validate]} {:db/id "answer-f4c6b4ce-018b-515d-bef0-2f04e8ea0da2" :answer/id #uuid "f4c6b4ce-018b-515d-bef0-2f04e8ea0da2" :answer/type :answer.type/math :answer/value "3({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22})" :db/ensure [:answer/validate]} {:db/id "answer-11523a51-2013-50cb-87e8-a988018c32d1" :answer/id #uuid "11523a51-2013-50cb-87e8-a988018c32d1" :answer/type :answer.type/math :answer/value "3{M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-c35fdd4c-7015-5d94-bf90-fea0b4a09186" :answer/id #uuid "c35fdd4c-7015-5d94-bf90-fea0b4a09186" :answer/type :answer.type/math :answer/value "3{M}_{11}\\cdot {M}_{21}\\cdot {M}_{12}\\cdot {M}_{22}" :db/ensure [:answer/validate]} {:db/id "answer-4d0a71d9-6603-5944-abe0-c07308a877f8" :answer/id #uuid "4d0a71d9-6603-5944-abe0-c07308a877f8" :answer/type :answer.type/math :answer/value "{M}_{11}+3{M}_{21}+{M}_{12}+{M}_{22}" :db/ensure [:answer/validate]} {:db/id 17592186345052 :question/problem "Let $R=[1,3]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)=30-{x}^{2}-{y}^{2}.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3\\},\\,{P}_{2}=\\{2,3,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id "question-dfc2de0e-3b59-5c5d-bed1-0d2b8726dbb0" :question/id #uuid "dfc2de0e-3b59-5c5d-bed1-0d2b8726dbb0" :question/math-academy-id "q-123237" :question/problem "Let $R=[2,4]\\times [1,5]$ be a region in the $xy$-plane, and let $f(x,y)=21-xy.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{2,3,4\\},\\,{P}_{2}=\\{1,3,5\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :question/worked-solution "First, let's draw the region $R$ and the partition $P.$\n\n![](images/38/38fcf924a077c207ff66fca76d63333d0f28986432b795c889f22b725faca078.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=2$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =2\\cdot {M}_{11}+2\\cdot {M}_{21}+2\\cdot {M}_{12}+2\\cdot {M}_{22} \\\\  & =2({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=21-xy$ decreases as $x$ increases, and\n\n- $f(x,y)=21-xy$ decreases as $y$ increases.\n\n![](images/9e/9e1d5a5dcf056f15fdf9e15b4caf3a2f506549ec785c752579bce5b6e12662cb.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/60/609917e6e3e397c9a1bfb4ba92a85535034c657d2bc96ae3b833bea381aea36f.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(2,1)=19 \\\\ {M}_{21} & =f(3,1)=18 \\\\ {M}_{12} & =f(2,3)=15 \\\\ {M}_{22} & =f(3,3)=12\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =2(19+18+15+12) \\\\  & =128.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-e47b3773-65aa-5f66-b8a4-eb883505683f"] :db/ensure [:question/validate]} {:db/id "answer-field-e47b3773-65aa-5f66-b8a4-eb883505683f" :answer-field/id #uuid "e47b3773-65aa-5f66-b8a4-eb883505683f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-67407550-c6d3-587a-83b4-48f6586a1291" :answer-field/choices ["answer-d3d8aea7-bbec-54d3-8ebb-b3137b99fa0f" "answer-67407550-c6d3-587a-83b4-48f6586a1291" "answer-b98388a5-aced-5f8d-aba9-d6a4f497027f" "answer-3550e5c8-3ba6-5c87-99b0-9752c6948031" "answer-16d247e3-5c48-51d4-b215-9d8d51d0483f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3d8aea7-bbec-54d3-8ebb-b3137b99fa0f" :answer/id #uuid "d3d8aea7-bbec-54d3-8ebb-b3137b99fa0f" :answer/type :answer.type/math :answer/value "108" :db/ensure [:answer/validate]} {:db/id "answer-67407550-c6d3-587a-83b4-48f6586a1291" :answer/id #uuid "67407550-c6d3-587a-83b4-48f6586a1291" :answer/type :answer.type/math :answer/value "128" :db/ensure [:answer/validate]} {:db/id "answer-b98388a5-aced-5f8d-aba9-d6a4f497027f" :answer/id #uuid "b98388a5-aced-5f8d-aba9-d6a4f497027f" :answer/type :answer.type/math :answer/value "156" :db/ensure [:answer/validate]} {:db/id "answer-3550e5c8-3ba6-5c87-99b0-9752c6948031" :answer/id #uuid "3550e5c8-3ba6-5c87-99b0-9752c6948031" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "answer-16d247e3-5c48-51d4-b215-9d8d51d0483f" :answer/id #uuid "16d247e3-5c48-51d4-b215-9d8d51d0483f" :answer/type :answer.type/math :answer/value "92" :db/ensure [:answer/validate]} {:db/id "question-d30a7455-cf28-573b-a7f5-088c618e903c" :question/id #uuid "d30a7455-cf28-573b-a7f5-088c618e903c" :question/math-academy-id "q-123231" :question/problem "Let $R=[1,4]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)=16-xy.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3,4\\},\\,{P}_{2}=\\{2,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :question/worked-solution "First, let's draw the region $R$ and the partition $P.$\n\n![](images/de/deff4f8b668e3c7327d92132f579c16d1f99dd5b52603b2f6afe6b7c6c5b7bb6.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{31}\\cdot \\text{Area}({R}_{31}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=2$ for all $3$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =2\\cdot {M}_{11}+2\\cdot {M}_{21}+2\\cdot {M}_{31} \\\\  & =2({M}_{11}+{M}_{21}+{M}_{31}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=16-xy$ decreases as $x$ increases, and\n\n- $f(x,y)=16-xy$ decreases as $y$ increases.\n\n![](images/21/21cd2d1c002e5b66100396f9e4d5708b8ffd7fd2b9b6cc7b7078cd5507011a0d.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/9e/9ebca45ee50cf0fe5f91e21427524600b26a512f10340c18c995c16f9cfe372d.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(1,2)=14 \\\\ {M}_{21} & =f(2,2)=12 \\\\ {M}_{31} & =f(3,2)=10\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =2(14+12+10) \\\\  & =72.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0fd3b050-eb07-5223-9aa5-20d0a7f35114"] :db/ensure [:question/validate]} {:db/id "answer-field-0fd3b050-eb07-5223-9aa5-20d0a7f35114" :answer-field/id #uuid "0fd3b050-eb07-5223-9aa5-20d0a7f35114" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3989a74d-2dc1-572b-bd50-bd4dc84f2a40" :answer-field/choices ["answer-2163f261-b0e3-5afe-af6d-ae5ea46969f6" "answer-398097ad-1342-5db5-93d2-00dc4659d2ee" "answer-f4a69bed-2b30-5998-a7d0-481c3cc1de3a" "answer-3989a74d-2dc1-572b-bd50-bd4dc84f2a40" "answer-50307643-fa90-566b-bcf8-3b0e643e8d94"] :db/ensure [:answer-field/validate]} {:db/id "answer-2163f261-b0e3-5afe-af6d-ae5ea46969f6" :answer/id #uuid "2163f261-b0e3-5afe-af6d-ae5ea46969f6" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-398097ad-1342-5db5-93d2-00dc4659d2ee" :answer/id #uuid "398097ad-1342-5db5-93d2-00dc4659d2ee" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "answer-f4a69bed-2b30-5998-a7d0-481c3cc1de3a" :answer/id #uuid "f4a69bed-2b30-5998-a7d0-481c3cc1de3a" :answer/type :answer.type/math :answer/value "54" :db/ensure [:answer/validate]} {:db/id "answer-3989a74d-2dc1-572b-bd50-bd4dc84f2a40" :answer/id #uuid "3989a74d-2dc1-572b-bd50-bd4dc84f2a40" :answer/type :answer.type/math :answer/value "72" :db/ensure [:answer/validate]} {:db/id "answer-50307643-fa90-566b-bcf8-3b0e643e8d94" :answer/id #uuid "50307643-fa90-566b-bcf8-3b0e643e8d94" :answer/type :answer.type/math :answer/value "88" :db/ensure [:answer/validate]} {:db/id 17592186152719 :question/problem "Let $R=[-2,2]\\times [-2,2]$ be a region in the $xy$-plane, and let $f(x,y)=6-2x-y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{-2,0,2\\},\\,{P}_{2}=\\{-2,0,2\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :question/worked-solution "First, let's draw the region $R$ and the partition $P.$\n\n![](images/c8/c8b7ffacce26030414c0e319624f5c171d28599f0cf9375e40ddaf252d6b7380.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=4$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =4\\cdot {M}_{11}+4\\cdot {M}_{21}+4\\cdot {M}_{12}+4\\cdot {M}_{22} \\\\  & =4({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=6-2x-y$ decreases as $x$ increases, and\n\n- $f(x,y)=6-2x-y$ decreases as $y$ increases.\n\n![](images/77/770593c18eaaebff55c73151b0e98628bd4ece00b75380b29fde8d1721f1cf16.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/8d/8dc8062cb5c436a0135abd2340fcaa39560658c4a23f13f0cb70893789a81836.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(-2,-2)=12 \\\\ {M}_{21} & =f(0,-2)=8 \\\\ {M}_{12} & =f(-2,0)=10 \\\\ {M}_{22} & =f(0,0)=6\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =4(12+8+10+6) \\\\  & =144.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186150821 :answer-field/correct 17592186150825 :db/ensure [:answer-field/validate]} {:db/id 17592186152713 :question/problem "Let $R=[-1,1]\\times [-1,1]$ be a region in the $xy$-plane, and let $f(x,y)=5-3x-y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{-1,0,1\\},\\,{P}_{2}=\\{-1,0,1\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id 17592186152398 :question/problem "Let $R=[2,10]\\times [3,7]$ be a region in the $xy$-plane, and let $f(x,y)=x+y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{2,6,10\\},\\,{P}_{2}=\\{3,5,7\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :question/worked-solution "First, let's draw the region $R$ and the partition $P.$\n\n![](images/09/0938d12d93c4f962a4ebd8daa7efe4543fc30c419be7d89f165e21bcadce84bb.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=8$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =8\\cdot {M}_{11}+8\\cdot {M}_{21}+8\\cdot {M}_{12}+8\\cdot {M}_{22} \\\\  & =8({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=x+y$ increases as $x$ increases, and\n\n- $f(x,y)=x+y$ increases as $y$ increases.\n\n![](images/af/af324138b21609cef59f49df0920ecc12681b8cb7667a843ff2d3fff3c27ea13.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion. \n\n![](images/14/14b50472bce6d935803ca4f74bb5b1761903c0b0b015ce72e7e1e5e08f35868b.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(6,5)=11 \\\\ {M}_{21} & =f(10,5)=15 \\\\ {M}_{12} & =f(6,7)=13 \\\\ {M}_{22} & =f(10,7)=17\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =8(11+15+13+17) \\\\  & =448.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186148919 :answer-field/correct 17592186148921 :db/ensure [:answer-field/validate]} {:db/id 17592186256779 :question/problem "Let $R=[1,7]\\times [1,6]$ be a region in the $xy$-plane, and let $f(x,y)=xy.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,3,5,7\\},\\,{P}_{2}=\\{1,6\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id "question-4bd06db2-69af-51a2-9fd5-21474b678038" :question/id #uuid "4bd06db2-69af-51a2-9fd5-21474b678038" :question/math-academy-id "q-75176" :question/problem "Let $R=[1,4]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)=x+2y-3.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3,4\\},\\,{P}_{2}=\\{2,3,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :question/worked-solution "First, let's draw the region $R$ and the partition $P.$\n\n![](images/89/89c82b8d1f3eaf79c7df0a67f377a240a949dda328cd2f448370077d2871c244.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\n\\begin{aligned}U(f,P) & ={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{31}\\cdot \\text{Area}({R}_{31}) \\\\  & \\,+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22})+{M}_{32}\\cdot \\text{Area}({R}_{32}),\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $6$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\nU(f,P)={M}_{11}+{M}_{21}+{M}_{31}+{M}_{12}+{M}_{22}+{M}_{32}.\n$$\n\nNow, notice that\n\n- $f(x,y)=x+2y-3$ increases as $x$ increases, and\n\n- $f(x,y)=x+2y-3$ increases as $y$ increases.\n\n![](images/78/7888eaa17b26267cc8bed166500ba504fe5a893b30eb90876f2074520e28e8ba.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/ea/eadef808ebc8ff5503de8cefbbbf3a1d64bf3149f0c0c80166c891550ddee91d.png)\n\nHence,\n\n$$\n\\begin{aligned}{M}_{11} & =f(2,3)=5 \\\\ {M}_{21} & =f(3,3)=6 \\\\ {M}_{31} & =f(4,3)=7 \\\\ {M}_{12} & =f(2,4)=7 \\\\ {M}_{22} & =f(3,4)=8 \\\\ {M}_{32} & =f(4,4)=9\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =5+6+7+7+8+9 \\\\  & =42.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7e998d72-50f3-55e6-8d59-b1ab24f7504c"] :db/ensure [:question/validate]} {:db/id "answer-field-7e998d72-50f3-55e6-8d59-b1ab24f7504c" :answer-field/id #uuid "7e998d72-50f3-55e6-8d59-b1ab24f7504c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-19b4d37c-af3f-5a0b-b1a5-aa4f21cf5ba8" :answer-field/choices ["answer-75856a7f-2f29-5d07-acad-a77f3e052314" "answer-2a88b7ea-918e-5f5d-b524-932d57163e6d" "answer-907c182d-7aff-57bd-84fa-04408cb79bc7" "answer-a852062d-d706-5f9f-9981-e973136b8709" "answer-19b4d37c-af3f-5a0b-b1a5-aa4f21cf5ba8"] :db/ensure [:answer-field/validate]} {:db/id "answer-75856a7f-2f29-5d07-acad-a77f3e052314" :answer/id #uuid "75856a7f-2f29-5d07-acad-a77f3e052314" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-2a88b7ea-918e-5f5d-b524-932d57163e6d" :answer/id #uuid "2a88b7ea-918e-5f5d-b524-932d57163e6d" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-907c182d-7aff-57bd-84fa-04408cb79bc7" :answer/id #uuid "907c182d-7aff-57bd-84fa-04408cb79bc7" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "answer-a852062d-d706-5f9f-9981-e973136b8709" :answer/id #uuid "a852062d-d706-5f9f-9981-e973136b8709" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "answer-19b4d37c-af3f-5a0b-b1a5-aa4f21cf5ba8" :answer/id #uuid "19b4d37c-af3f-5a0b-b1a5-aa4f21cf5ba8" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id 17592186152712 :question/problem "Let $R=[2,4]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)={x}^{2}+{y}^{2}.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{2,3,4\\},\\,{P}_{2}=\\{2,3,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :question/worked-solution "First, let's draw the region $R$ and the partition $P.$\n\n![](images/e8/e88b9d4b756f76a8b7c75287f0c4e3ff07f7b458dcdcea703769fc6da56f2a12.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\nU(f,P)={M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}.\n$$\n\nNow, notice that\n\n- $f(x,y)={x}^{2}+{y}^{2}$ increases as $x$ increases, and\n\n- $f(x,y)={x}^{2}+{y}^{2}$ increases as $y$ increases.\n\n![](images/8d/8dc9b8c4634691d17614c39e542488fb17d2918737be0dad5d262cd9a1fd827a.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion. \n\n![](images/be/beb238668c9c1ebb66f8c7ec3cd8a40b267b47d7ba1cbd2e351c65b3c17d7a84.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(3,3)=18 \\\\ {M}_{21} & =f(4,3)=25 \\\\ {M}_{12} & =f(3,4)=25 \\\\ {M}_{22} & =f(4,4)=32\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =18+25+25+32 \\\\  & =100.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186150779 :answer-field/correct 17592186150784 :db/ensure [:answer-field/validate]} {:db/id 17592186345041 :question/problem "Let $R=[3,5]\\times [1,3]$ be a region in the $xy$-plane, and let $f(x,y)={x}^{2}+3{y}^{2}-2.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{3,4,5\\},\\,{P}_{2}=\\{1,2,3\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" :db/ensure [:question/validate]} {:db/id 17592186153417 :tutorial/content "In this lesson, we will describe a process for calculating an **upper bound** for the volume enclosed between a surface $z=f(x,y)$ and the $xy$-plane. \n\nAs an example, consider the rectangle $R$ in the $xy$-plane, defined as\n\n$$\n\\begin{aligned}R=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1\\}.\\end{aligned}\n$$\n\nA sketch of the region $R$ is shown below.\n\n![](images/bf/bf7ef4752b0910b5544707eef97c854d8eeeedbc221a81c5fa631cf38b8b8d9a.png)\n\nNow consider the function $f(x,y) = 3-x^2-y^2,$ defined over $R,$ shown below.\n\n![](images/34/34f7936b29e6a177ae0c831e36654dc5059514580a1947324a40d52320b83e5a.png)\n\nThe space underneath the surface and above the region $R$ defines a fixed volume $V.$ Our goal is to find an upper bound for $V.$ We do this by approximating this volume using rectangular solids. \n\nWe start by partitioning the $x$- and $y$-intervals of $R.$ Let's pick two subintervals of equal length for both $x$ and $y.$\n\n![](images/c3/c375b605ca6b7d7f2935218976f5e09db5ed2cfb64d811b1fe0a854d02646a36.png)\n\nThe region $R$ is now partitioned into $4$ rectangles:\n\n![](images/20/2026210e2cd58b2f2f7290a2d4f4186875903d146d02597787393727afd7f6a6.png)\n\nWe seek an *upper* bound for the volume $V.$ So, we let $M_{ij}$ be the *largest* value of $f$ in each subregion $R_{ij}.$ We then define a rectangular solid in each subregion whose base is $R_{ij}$ and whose height is $M_{ij}.$ \n\nFor example, the rectangular solid corresponding to $R_{11}$ is given below. \n\n![](images/62/62cee54b71235dc75cab863f0971735ec221fc61a022edf78994ea3f935c1cd4.png)\n\nThe volume of this rectangular solid is\n\n$$\nM_{11}\\cdot \\textrm{Area}(R_{11})  = \\dfrac14M_{11}.\n$$\n\nSimilarly, the volumes of the rectangular solids formed by the partitions $R_{21}, R_{12},$ and $R_{22}$ respectively are\n\n$$\n\\dfrac14M_{21}, \\qquad \\dfrac14M_{12}, \\qquad \\dfrac14M_{22}.\n$$\n\nDrawing all four rectangular solids, we get a volume that looks as follows:\n\n![](images/f8/f8f44d8a180838cb2b79b775483260ea9a30608cb8a618eaf86a5edcabd2c610.png)\n\nThe upper bound $U$ for our volume is the sum of the volumes of our four rectangular solids. This gives\n\n$$\nU = \\dfrac14(M_{11} + M_{21} + M_{12} + M_{22}).\n$$\n\nThe number $U$ is called the **upper Riemann sum with respect to the given partition**.\n\n**Note:** We don't yet know the values of $M_{ij},$ the height of each solid. We'll learn to figure these out a little later in the lesson. For now, we will just focus on writing $U$ as an expression of $M_{ij}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186152326 :activity/expected-seconds 600.0 :db/ensure [:activity/validate]} {:db/id 17592186054733 :knowledge-point/questions ["question-079ed9ef-ed52-5aa5-892f-741aff5b9f4c" "question-553ad9a0-8f10-59ef-ab22-b325bd3075cb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-079ed9ef-ed52-5aa5-892f-741aff5b9f4c" :question/id #uuid "079ed9ef-ed52-5aa5-892f-741aff5b9f4c" :question/math-academy-id "q-16296" :question/problem "$(6-9\\,\\text{i})(6+9\\,\\text{i})=$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-9\\,\\text{i})(6+9\\,\\text{i}) & =6\\cdot 6+6\\cdot 9\\,\\text{i}+(-9\\,\\text{i})\\cdot 6+(-9\\,\\text{i})\\cdot 9\\,\\text{i} \\\\  & =36+54\\,\\text{i}-54\\,\\text{i}-81\\,{\\text{i}}^{2} \\\\  & =36-81\\cdot (-1) \\\\  & =36+81 \\\\  & =117.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ecefc22e-34e7-5318-982a-11314974e138"] :db/ensure [:question/validate]} {:db/id "answer-field-ecefc22e-34e7-5318-982a-11314974e138" :answer-field/id #uuid "ecefc22e-34e7-5318-982a-11314974e138" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e79a1e12-010f-589f-8be2-c9f49ab64cec" :answer-field/choices ["answer-d46811a2-7647-5666-89f8-61c884b6aea1" "answer-0059d172-90f9-5235-b4b6-a75ec1495e4d" "answer-8dbdb540-b9c7-5f11-ada4-b26f705d451f" "answer-019bcb77-6632-5049-bc18-e7872975dbf5" "answer-e79a1e12-010f-589f-8be2-c9f49ab64cec"] :db/ensure [:answer-field/validate]} {:db/id "answer-d46811a2-7647-5666-89f8-61c884b6aea1" :answer/id #uuid "d46811a2-7647-5666-89f8-61c884b6aea1" :answer/type :answer.type/math :answer/value "-115" :db/ensure [:answer/validate]} {:db/id "answer-0059d172-90f9-5235-b4b6-a75ec1495e4d" :answer/id #uuid "0059d172-90f9-5235-b4b6-a75ec1495e4d" :answer/type :answer.type/math :answer/value "-85+15\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-8dbdb540-b9c7-5f11-ada4-b26f705d451f" :answer/id #uuid "8dbdb540-b9c7-5f11-ada4-b26f705d451f" :answer/type :answer.type/math :answer/value "-95" :db/ensure [:answer/validate]} {:db/id "answer-019bcb77-6632-5049-bc18-e7872975dbf5" :answer/id #uuid "019bcb77-6632-5049-bc18-e7872975dbf5" :answer/type :answer.type/math :answer/value "115+15\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-e79a1e12-010f-589f-8be2-c9f49ab64cec" :answer/id #uuid "e79a1e12-010f-589f-8be2-c9f49ab64cec" :answer/type :answer.type/math :answer/value "117" :db/ensure [:answer/validate]} {:db/id "question-553ad9a0-8f10-59ef-ab22-b325bd3075cb" :question/id #uuid "553ad9a0-8f10-59ef-ab22-b325bd3075cb" :question/math-academy-id "q-16297" :question/problem "$(3+7\\,\\text{i})(3+3\\,\\text{i})=$" :question/worked-solution "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(3+7\\,\\text{i})(3+3\\,\\text{i}) & =3\\cdot 3+3\\cdot 3\\,\\text{i}+7\\,\\text{i}\\cdot 3+7\\,\\text{i}\\cdot 3\\,\\text{i} \\\\  & =9+9\\,\\text{i}+21\\,\\text{i}+21\\,{\\text{i}}^{2} \\\\  & =9+30\\,\\text{i}+21\\cdot (-1) \\\\  & =9+30\\,\\text{i}-21 \\\\  & =-12+30\\,\\text{i}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-580c7707-147e-5610-a367-5714a00847a6"] :db/ensure [:question/validate]} {:db/id "answer-field-580c7707-147e-5610-a367-5714a00847a6" :answer-field/id #uuid "580c7707-147e-5610-a367-5714a00847a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0b547066-5b29-546d-8cd5-74b2bb005d5d" :answer-field/choices ["answer-28d2ad66-3a96-5b91-af9f-1f8a95b92045" "answer-0b547066-5b29-546d-8cd5-74b2bb005d5d" "answer-ba47eb89-2c3e-50f5-a576-4e75f6181684" "answer-9e1c27a1-fc83-51da-9238-863b51cf68a5" "answer-0ebbfedf-cc4d-5617-919c-fd8b3aaa4d8d"] :db/ensure [:answer-field/validate]} {:db/id "answer-28d2ad66-3a96-5b91-af9f-1f8a95b92045" :answer/id #uuid "28d2ad66-3a96-5b91-af9f-1f8a95b92045" :answer/type :answer.type/math :answer/value "-12+21\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-0b547066-5b29-546d-8cd5-74b2bb005d5d" :answer/id #uuid "0b547066-5b29-546d-8cd5-74b2bb005d5d" :answer/type :answer.type/math :answer/value "-12+30\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-ba47eb89-2c3e-50f5-a576-4e75f6181684" :answer/id #uuid "ba47eb89-2c3e-50f5-a576-4e75f6181684" :answer/type :answer.type/math :answer/value "-9-30\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-9e1c27a1-fc83-51da-9238-863b51cf68a5" :answer/id #uuid "9e1c27a1-fc83-51da-9238-863b51cf68a5" :answer/type :answer.type/math :answer/value "12+30\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id "answer-0ebbfedf-cc4d-5617-919c-fd8b3aaa4d8d" :answer/id #uuid "0ebbfedf-cc4d-5617-919c-fd8b3aaa4d8d" :answer/type :answer.type/math :answer/value "12-30\\,\\text{i}" :db/ensure [:answer/validate]} {:db/id 17592186054731 :knowledge-point/questions ["question-772edc16-136d-5a38-b38b-aec6a90dcb95"] :db/ensure [:knowledge-point/validate]} {:db/id "question-772edc16-136d-5a38-b38b-aec6a90dcb95" :question/id #uuid "772edc16-136d-5a38-b38b-aec6a90dcb95" :question/math-academy-id "q-66366" :question/problem "$(-6\\,\\text{i})\\cdot 2\\,\\text{i}=$" :question/worked-solution "Multiplying two purely imaginary numbers is similar to multiplying two monomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(-6\\text{i})\\cdot 2\\text{i} & =(-6)\\cdot 2\\cdot {\\text{i}}^{2} \\\\  & =-12\\,{\\text{i}}^{2} \\\\  & =(-12)\\cdot (-1) \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cb931a4e-d37d-5213-b9b8-c126cb3cd7c4"] :db/ensure [:question/validate]} {:db/id "answer-field-cb931a4e-d37d-5213-b9b8-c126cb3cd7c4" :answer-field/id #uuid "cb931a4e-d37d-5213-b9b8-c126cb3cd7c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1bf090e9-0296-565a-8db8-9326d0c65848" :answer-field/choices ["answer-8a115bf7-930c-59fc-a6