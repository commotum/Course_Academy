cd41647247" :db/ensure [:step/validate]} {:db/id "step-0d21c858-7859-5d5f-8350-22cd41647247" :step/id #uuid "0d21c858-7859-5d5f-8350-22cd41647247" :step/content "question-b5a32830-d248-5fc8-bc7e-b05512cbde4a" :db/ensure [:step/validate]} {:db/id 17592186054624 :knowledge-point/questions ["question-8b91269e-ac3e-5858-87ab-575f9e7b0df8" "question-4d345e50-4921-588f-ae74-039f20e6e137"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054539 :question/worked-solution "Using the product rule for natural logarithms, we can combine the first two terms of the given expression as follows:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(2)+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(y)=\\operatorname{ln}⁡(2x)-\\operatorname{ln}⁡(y)\\end{aligned}\n$$\n\nNow, using the quotient rule for natural logarithms, we get\n\n$$\n\\ln(2x)-\\ln(y) = \\ln \\left( \\dfrac{2x}{y} \\right).\n$$\n\nTherefore,\n\n$$\n\\ln(2)+\\ln(x)-\\ln(y) = \\ln\\left(\\dfrac{2x}{y}\\right).\n$$" :db/ensure [:question/validate]} {:db/id 17592186054622 :knowledge-point/questions ["question-9796dfce-fb6b-57bd-b442-e9278daaaa20" "question-841f3191-5c7e-5e47-b725-127033cb9a73"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054537 :question/worked-solution "Using the power rule for logarithms, we can rewrite the second term to obtain\n\n$$\n\\log(3)+4\\log(y)=\\log(3)+\\log(y^4).\n$$\n\nNow, using the product rule for logarithms, we can combine the two terms to get\n\n$$\n\\log(3)+\\log(y^4)=\\log\\left(3y^4\\right).\n$$\n\nTherefore,\n\n$$\n\\log(3)+4\\log(y)=\\log\\left(3y^4\\right).\n$$" :db/ensure [:question/validate]} {:db/id 17592186054623 :knowledge-point/questions ["question-7a291781-59c8-57ab-aafe-d8f0841ec267" "question-a8ef19a1-f2fa-5f29-a4ae-a1f3f6bb227d" "question-2c8cf324-472b-5836-8692-8d44663200a5" "question-e70f2288-3b25-5d12-a8c5-361a6e66e0f3" "question-49c1090f-0d14-5ccb-9c30-a8b9c4fffd87"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054538 :question/worked-solution "Using the power rule for logarithms, we can rewrite both terms of the expression as follows:\n\n$$\n\\begin{aligned}3\\operatorname{log}⁡(x)-2\\operatorname{log}⁡(5) & =\\operatorname{log}⁡({x}^{3})-\\operatorname{log}⁡({5}^{2}) \\\\  & =\\operatorname{log}⁡({x}^{3})-\\operatorname{log}⁡(25)\\end{aligned}\n$$\n\nNow, using the quotient rule for logarithms, we can combine the two terms to get\n\n$$\n\\log\\left(x^3\\right) - \\log(25) =\\log\\left( \\dfrac{x^3}{25} \\right).\n$$\n\nTherefore,\n\n$$\n3\\log(x) - 2\\log(5) =  \\log\\left( \\dfrac{x^3}{25} \\right).\n$$" :db/ensure [:question/validate]} {:db/id 17592186054625 :knowledge-point/questions ["question-34847574-efca-5670-8924-e70a3bcc31ce" "question-e3b649a8-d282-53b7-b8c8-e883fd47c0b9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054542 :question/worked-solution "Using the power rule for logarithms, we can rewrite the first term of the given expression as follows:\n\n$$\n\\begin{aligned}3\\operatorname{log}⁡(2)+\\operatorname{log}⁡(x)-\\operatorname{log}⁡(4) & =\\operatorname{log}⁡({2}^{3})+\\operatorname{log}⁡(x)-\\operatorname{log}⁡(4) \\\\  & =\\operatorname{log}⁡(8)+\\operatorname{log}⁡(x)-\\operatorname{log}⁡(4)\\end{aligned}\n$$\n\nNow, using the product rule for logarithms, we can combine the first two terms to obtain\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(8)+\\operatorname{log}⁡(x)-\\operatorname{log}⁡(4)=\\operatorname{log}⁡(8x)-\\operatorname{log}⁡(4).\\end{aligned}\n$$\n\nFinally, using the quotient rule for logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(8x)-\\operatorname{log}⁡(4) & =\\operatorname{log}⁡(\\frac{8x}{4}) \\\\  & =\\operatorname{log}⁡(2x).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n3\\log(2)+\\log(x)-\\log(4) = \\log\\left(2x\\right).\n$$" :db/ensure [:question/validate]} {:db/id "question-8b91269e-ac3e-5858-87ab-575f9e7b0df8" :question/id #uuid "8b91269e-ac3e-5858-87ab-575f9e7b0df8" :question/math-academy-id "q-66781" :question/problem "${log}_{3}⁡(\\frac{5x}{27})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡(\\frac{5x}{27}) & ={log}_{3}⁡(5x)-{log}_{3}⁡(27) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-{log}_{3}⁡({3}^{3}) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9f77377e-ee2a-59ef-bb46-445ff072d429"] :db/ensure [:question/validate]} {:db/id "answer-field-9f77377e-ee2a-59ef-bb46-445ff072d429" :answer-field/id #uuid "9f77377e-ee2a-59ef-bb46-445ff072d429" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c27c541-3a63-5fc4-ab19-bafc688b3c69" :answer-field/choices ["answer-390b5693-f1ca-5a29-a8de-7aacb1098e9e" "answer-3c27c541-3a63-5fc4-ab19-bafc688b3c69" "answer-170013cd-1ce2-5957-923e-754a4df4bd3d" "answer-6173b34d-e283-50ae-9765-c9f0bdcdfe52" "answer-8e12ed65-2a4a-5809-a1a7-871496b64eeb"] :db/ensure [:answer-field/validate]} {:db/id "answer-390b5693-f1ca-5a29-a8de-7aacb1098e9e" :answer/id #uuid "390b5693-f1ca-5a29-a8de-7aacb1098e9e" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)+3" :db/ensure [:answer/validate]} {:db/id "answer-3c27c541-3a63-5fc4-ab19-bafc688b3c69" :answer/id #uuid "3c27c541-3a63-5fc4-ab19-bafc688b3c69" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-3" :db/ensure [:answer/validate]} {:db/id "answer-170013cd-1ce2-5957-923e-754a4df4bd3d" :answer/id #uuid "170013cd-1ce2-5957-923e-754a4df4bd3d" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(5)+{log}_{3}⁡(x)-9" :db/ensure [:answer/validate]} {:db/id "answer-6173b34d-e283-50ae-9765-c9f0bdcdfe52" :answer/id #uuid "6173b34d-e283-50ae-9765-c9f0bdcdfe52" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(5)-{log}_{3}⁡(x)+3" :db/ensure [:answer/validate]} {:db/id "answer-8e12ed65-2a4a-5809-a1a7-871496b64eeb" :answer/id #uuid "8e12ed65-2a4a-5809-a1a7-871496b64eeb" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(5)-{log}_{3}⁡(x)-9" :db/ensure [:answer/validate]} {:db/id "question-4d345e50-4921-588f-ae74-039f20e6e137" :question/id #uuid "4d345e50-4921-588f-ae74-039f20e6e137" :question/math-academy-id "q-100242" :question/problem "$\\operatorname{ln}⁡(\\frac{ex}{5})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{ex}{5}) & =\\operatorname{ln}⁡(ex)-\\operatorname{ln}⁡(5) \\\\  & =\\operatorname{ln}⁡(e)+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5) \\\\  & =1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2ee605d5-badf-5ba4-afaa-ea809cbe4caf"] :db/ensure [:question/validate]} {:db/id "answer-field-2ee605d5-badf-5ba4-afaa-ea809cbe4caf" :answer-field/id #uuid "2ee605d5-badf-5ba4-afaa-ea809cbe4caf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" :answer-field/choices ["answer-7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" "answer-276974b1-5543-5e63-b8c1-928234d07545" "answer-61e1ae29-15b8-582a-aa4f-7bb4c3defafc" "answer-166addb8-c2f1-5d2d-9873-0a17afec2f1d" "answer-88f6512a-e755-51b7-8dea-3427afc1e864"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" :answer/id #uuid "7c5cb179-ffca-5fe5-89e3-4dc4c59454a4" :answer/type :answer.type/math :answer/value "1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5)" :db/ensure [:answer/validate]} {:db/id "answer-276974b1-5543-5e63-b8c1-928234d07545" :answer/id #uuid "276974b1-5543-5e63-b8c1-928234d07545" :answer/type :answer.type/math :answer/value "1+\\operatorname{ln}⁡(x-5)" :db/ensure [:answer/validate]} {:db/id "answer-61e1ae29-15b8-582a-aa4f-7bb4c3defafc" :answer/id #uuid "61e1ae29-15b8-582a-aa4f-7bb4c3defafc" :answer/type :answer.type/math :answer/value "1-\\operatorname{ln}⁡(x)+\\frac{5}{e}" :db/ensure [:answer/validate]} {:db/id "answer-166addb8-c2f1-5d2d-9873-0a17afec2f1d" :answer/id #uuid "166addb8-c2f1-5d2d-9873-0a17afec2f1d" :answer/type :answer.type/math :answer/value "e+\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(5)" :db/ensure [:answer/validate]} {:db/id "answer-88f6512a-e755-51b7-8dea-3427afc1e864" :answer/id #uuid "88f6512a-e755-51b7-8dea-3427afc1e864" :answer/type :answer.type/math :answer/value "e-\\operatorname{ln}⁡(x)-5" :db/ensure [:answer/validate]} {:db/id "question-9796dfce-fb6b-57bd-b442-e9278daaaa20" :question/id #uuid "9796dfce-fb6b-57bd-b442-e9278daaaa20" :question/math-academy-id "q-98925" :question/problem "If ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4$, then ${log}_{2}⁡(x{y}^{3})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{2}⁡(x{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(x{y}^{3}) & ={log}_{2}⁡(x)+{log}_{2}⁡({y}^{3}) \\\\  & ={log}_{2}⁡(x)+3{log}_{2}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4,$ we conclude that\n\n$$\n\\begin{aligned}{log}_{2}⁡(x)+3{log}_{2}⁡(y) & =k+3\\cdot 4 \\\\  & =k+12.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{log}_{2}⁡(x{y}^{3})=k+12.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3aab8c1f-76ff-5a2c-9c46-d7294b8c857e"] :db/ensure [:question/validate]} {:db/id "answer-field-3aab8c1f-76ff-5a2c-9c46-d7294b8c857e" :answer-field/id #uuid "3aab8c1f-76ff-5a2c-9c46-d7294b8c857e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a31007c0-bb7e-5195-b1fe-bac89c68dbbd" :answer-field/choices ["answer-de2a4dff-046b-5136-b0e7-22b11eceaca1" "answer-1fb557ae-9a47-526e-ae26-b4f9d80275d1" "answer-a31007c0-bb7e-5195-b1fe-bac89c68dbbd" "answer-daad00e3-599f-5edb-abd8-30682e338221" "answer-cff918bc-b5d0-5906-8d66-bbe4168f3474"] :db/ensure [:answer-field/validate]} {:db/id "answer-de2a4dff-046b-5136-b0e7-22b11eceaca1" :answer/id #uuid "de2a4dff-046b-5136-b0e7-22b11eceaca1" :answer/type :answer.type/math :answer/value "12k" :db/ensure [:answer/validate]} {:db/id "answer-1fb557ae-9a47-526e-ae26-b4f9d80275d1" :answer/id #uuid "1fb557ae-9a47-526e-ae26-b4f9d80275d1" :answer/type :answer.type/math :answer/value "7k" :db/ensure [:answer/validate]} {:db/id "answer-a31007c0-bb7e-5195-b1fe-bac89c68dbbd" :answer/id #uuid "a31007c0-bb7e-5195-b1fe-bac89c68dbbd" :answer/type :answer.type/math :answer/value "k+12" :db/ensure [:answer/validate]} {:db/id "answer-daad00e3-599f-5edb-abd8-30682e338221" :answer/id #uuid "daad00e3-599f-5edb-abd8-30682e338221" :answer/type :answer.type/math :answer/value "k+7" :db/ensure [:answer/validate]} {:db/id "answer-cff918bc-b5d0-5906-8d66-bbe4168f3474" :answer/id #uuid "cff918bc-b5d0-5906-8d66-bbe4168f3474" :answer/type :answer.type/math :answer/value "k-12" :db/ensure [:answer/validate]} {:db/id "question-841f3191-5c7e-5e47-b725-127033cb9a73" :question/id #uuid "841f3191-5c7e-5e47-b725-127033cb9a73" :question/math-academy-id "q-79453" :question/problem "If ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, then ${log}_{5}⁡({x}^{2}{y}^{3})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{5}⁡({x}^{2}{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{5}⁡({x}^{2}{y}^{3}) & ={log}_{5}⁡({x}^{2})+{log}_{5}⁡({y}^{3}) \\\\  & =2{log}_{5}⁡(x)+3{log}_{5}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, we conclude that\n\n$$\n2{log}_{5}⁡(x)+3{log}_{5}⁡(y)=2\\cdot 3+3\\cdot 2=12.\n$$\n\nHence\n\n$$\n{log}_{5}⁡({x}^{2}{y}^{3})=12.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2cd04507-0815-5cf4-b8b9-c2671207a55b"] :db/ensure [:question/validate]} {:db/id "answer-field-2cd04507-0815-5cf4-b8b9-c2671207a55b" :answer-field/id #uuid "2cd04507-0815-5cf4-b8b9-c2671207a55b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b67ada9d-787b-5291-af4f-7eef69f5678d" :answer-field/choices ["answer-e80ede49-5f0c-5bd8-a8bd-3022152fe7f2" "answer-b67ada9d-787b-5291-af4f-7eef69f5678d" "answer-9eef2f87-e855-5d53-80f4-202dbca3fd5d" "answer-986de02b-222a-5a6d-891b-6e5b891ef90a" "answer-a677f03a-acb9-5439-be1f-b1eb7dee2b3c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e80ede49-5f0c-5bd8-a8bd-3022152fe7f2" :answer/id #uuid "e80ede49-5f0c-5bd8-a8bd-3022152fe7f2" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-b67ada9d-787b-5291-af4f-7eef69f5678d" :answer/id #uuid "b67ada9d-787b-5291-af4f-7eef69f5678d" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-9eef2f87-e855-5d53-80f4-202dbca3fd5d" :answer/id #uuid "9eef2f87-e855-5d53-80f4-202dbca3fd5d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-986de02b-222a-5a6d-891b-6e5b891ef90a" :answer/id #uuid "986de02b-222a-5a6d-891b-6e5b891ef90a" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-a677f03a-acb9-5439-be1f-b1eb7dee2b3c" :answer/id #uuid "a677f03a-acb9-5439-be1f-b1eb7dee2b3c" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-7a291781-59c8-57ab-aafe-d8f0841ec267" :question/id #uuid "7a291781-59c8-57ab-aafe-d8f0841ec267" :question/math-academy-id "q-47198" :question/problem "$\\operatorname{ln}⁡(\\frac{{z}^{6}}{13})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient quotient and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{{z}^{6}}{13}) & =\\operatorname{ln}⁡({z}^{6})-\\operatorname{ln}⁡(13) \\\\  & =6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b0f4d0f6-7f8a-58c2-8e17-d618255d36d0"] :db/ensure [:question/validate]} {:db/id "answer-field-b0f4d0f6-7f8a-58c2-8e17-d618255d36d0" :answer-field/id #uuid "b0f4d0f6-7f8a-58c2-8e17-d618255d36d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba338d13-209f-57cf-bc5e-38caaf642b94" :answer-field/choices ["answer-e1f1b615-0943-5954-af8a-c55ae24c583b" "answer-ba338d13-209f-57cf-bc5e-38caaf642b94" "answer-71ac5314-1262-522d-bc00-0042ccd70e85" "answer-4e543ebb-1b6e-57d7-a4cc-de52b91accec" "answer-0269a173-54ba-5ccf-a6e0-995965a165aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1f1b615-0943-5954-af8a-c55ae24c583b" :answer/id #uuid "e1f1b615-0943-5954-af8a-c55ae24c583b" :answer/type :answer.type/math :answer/value "13\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-ba338d13-209f-57cf-bc5e-38caaf642b94" :answer/id #uuid "ba338d13-209f-57cf-bc5e-38caaf642b94" :answer/type :answer.type/math :answer/value "6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13)" :db/ensure [:answer/validate]} {:db/id "answer-71ac5314-1262-522d-bc00-0042ccd70e85" :answer/id #uuid "71ac5314-1262-522d-bc00-0042ccd70e85" :answer/type :answer.type/math :answer/value "6\\operatorname{ln}⁡(z-13)" :db/ensure [:answer/validate]} {:db/id "answer-4e543ebb-1b6e-57d7-a4cc-de52b91accec" :answer/id #uuid "4e543ebb-1b6e-57d7-a4cc-de52b91accec" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(13)-6\\operatorname{ln}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-0269a173-54ba-5ccf-a6e0-995965a165aa" :answer/id #uuid "0269a173-54ba-5ccf-a6e0-995965a165aa" :answer/type :answer.type/math :answer/value "z\\operatorname{ln}⁡(6)-\\operatorname{ln}⁡(13)" :db/ensure [:answer/validate]} {:db/id "question-a8ef19a1-f2fa-5f29-a4ae-a1f3f6bb227d" :question/id #uuid "a8ef19a1-f2fa-5f29-a4ae-a1f3f6bb227d" :question/math-academy-id "q-1110" :question/problem "Express $\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y) & ={log}_{5}⁡({x}^{1/2})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡(\\sqrt{x})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡(\\frac{\\sqrt{x}}{{y}^{5}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3df2d483-a123-580b-8ed7-a2a425df48f0"] :db/ensure [:question/validate]} {:db/id "answer-field-3df2d483-a123-580b-8ed7-a2a425df48f0" :answer-field/id #uuid "3df2d483-a123-580b-8ed7-a2a425df48f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b7267a79-3839-5f21-b62c-09c9545b4060" :answer-field/choices ["answer-896cc279-0ed5-5375-8db2-e1b363fec667" "answer-1de3d2cd-60aa-59f4-9c1c-0d3d70e7064b" "answer-6a2fdb68-0b95-5c0e-94b2-81028526e2ef" "answer-b7267a79-3839-5f21-b62c-09c9545b4060" "answer-3adf2bc5-273b-5e81-9d24-ceeca3bf0302"] :db/ensure [:answer-field/validate]} {:db/id "answer-896cc279-0ed5-5375-8db2-e1b363fec667" :answer/id #uuid "896cc279-0ed5-5375-8db2-e1b363fec667" :answer/type :answer.type/math :answer/value "\\sqrt{x}-1" :db/ensure [:answer/validate]} {:db/id "answer-1de3d2cd-60aa-59f4-9c1c-0d3d70e7064b" :answer/id #uuid "1de3d2cd-60aa-59f4-9c1c-0d3d70e7064b" :answer/type :answer.type/math :answer/value "\\sqrt{x}-{y}^{5}" :db/ensure [:answer/validate]} {:db/id "answer-6a2fdb68-0b95-5c0e-94b2-81028526e2ef" :answer/id #uuid "6a2fdb68-0b95-5c0e-94b2-81028526e2ef" :answer/type :answer.type/math :answer/value "{log}_{5}⁡(\\frac{\\sqrt{x}}{5y})" :db/ensure [:answer/validate]} {:db/id "answer-b7267a79-3839-5f21-b62c-09c9545b4060" :answer/id #uuid "b7267a79-3839-5f21-b62c-09c9545b4060" :answer/type :answer.type/math :answer/value "{log}_{5}⁡(\\frac{\\sqrt{x}}{{y}^{5}})" :db/ensure [:answer/validate]} {:db/id "answer-3adf2bc5-273b-5e81-9d24-ceeca3bf0302" :answer/id #uuid "3adf2bc5-273b-5e81-9d24-ceeca3bf0302" :answer/type :answer.type/math :answer/value "{log}_{5}⁡(\\sqrt{x})" :db/ensure [:answer/validate]} {:db/id "question-2c8cf324-472b-5836-8692-8d44663200a5" :question/id #uuid "2c8cf324-472b-5836-8692-8d44663200a5" :question/math-academy-id "q-1101" :question/problem "$\\operatorname{log}⁡(\\frac{3y}{\\sqrt{x}})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(\\frac{3y}{\\sqrt{x}}) & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡(\\sqrt{x}) \\\\  & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡({x}^{1/2}) \\\\  & =\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f6b9d0a5-0953-5666-a839-4b5670a6fac3"] :db/ensure [:question/validate]} {:db/id "answer-field-f6b9d0a5-0953-5666-a839-4b5670a6fac3" :answer-field/id #uuid "f6b9d0a5-0953-5666-a839-4b5670a6fac3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7581ab19-811f-5e47-b443-b607c614c0b1" :answer-field/choices ["answer-e87adda8-665d-5091-a708-f9408a979f13" "answer-ad34430e-a9d9-513c-8d4f-f1869c33c3a6" "answer-78a1a98e-88c2-5374-88b4-1257de2627c0" "answer-190687e3-a7f2-5a29-8dc7-a0bea5da56e2" "answer-7581ab19-811f-5e47-b443-b607c614c0b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-e87adda8-665d-5091-a708-f9408a979f13" :answer/id #uuid "e87adda8-665d-5091-a708-f9408a979f13" :answer/type :answer.type/math :answer/value "3\\operatorname{log}⁡(y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-ad34430e-a9d9-513c-8d4f-f1869c33c3a6" :answer/id #uuid "ad34430e-a9d9-513c-8d4f-f1869c33c3a6" :answer/type :answer.type/math :answer/value "\\operatorname{log}⁡(3y)+2\\operatorname{log}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-78a1a98e-88c2-5374-88b4-1257de2627c0" :answer/id #uuid "78a1a98e-88c2-5374-88b4-1257de2627c0" :answer/type :answer.type/math :answer/value "\\operatorname{log}⁡(3y)+\\frac{1}{2}\\operatorname{log}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-190687e3-a7f2-5a29-8dc7-a0bea5da56e2" :answer/id #uuid "190687e3-a7f2-5a29-8dc7-a0bea5da56e2" :answer/type :answer.type/math :answer/value "\\operatorname{log}⁡(3y)-2\\operatorname{log}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-7581ab19-811f-5e47-b443-b607c614c0b1" :answer/id #uuid "7581ab19-811f-5e47-b443-b607c614c0b1" :answer/type :answer.type/math :answer/value "\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x)" :db/ensure [:answer/validate]} {:db/id "question-e70f2288-3b25-5d12-a8c5-361a6e66e0f3" :question/id #uuid "e70f2288-3b25-5d12-a8c5-361a6e66e0f3" :question/math-academy-id "q-100243" :question/problem "Express $\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y) & ={log}_{4}⁡({x}^{1/3})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡(\\sqrt[3]{x})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡(\\frac{\\sqrt[3]{x}}{y}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bb4f622f-2866-535c-a540-b48bd6d1ad52"] :db/ensure [:question/validate]} {:db/id "answer-field-bb4f622f-2866-535c-a540-b48bd6d1ad52" :answer-field/id #uuid "bb4f622f-2866-535c-a540-b48bd6d1ad52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer-field/choices ["answer-57aa5928-9fe8-571f-bec1-84a8858c534f" "answer-0e893e4b-1f92-52ad-ad87-c504cbe090a4" "answer-5db0ca0e-d6da-543d-94a6-0b0616316cbd" "answer-ecfa35ae-3197-55c3-8180-1535e0873fbd" "answer-c76a97fc-fdf4-5ad6-8243-95edbdc9a876"] :db/ensure [:answer-field/validate]} {:db/id "answer-57aa5928-9fe8-571f-bec1-84a8858c534f" :answer/id #uuid "57aa5928-9fe8-571f-bec1-84a8858c534f" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(\\frac{3x}{y})" :db/ensure [:answer/validate]} {:db/id "answer-0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer/id #uuid "0e893e4b-1f92-52ad-ad87-c504cbe090a4" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(\\frac{\\sqrt[3]{x}}{y})" :db/ensure [:answer/validate]} {:db/id "answer-5db0ca0e-d6da-543d-94a6-0b0616316cbd" :answer/id #uuid "5db0ca0e-d6da-543d-94a6-0b0616316cbd" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(\\frac{x}{3y})" :db/ensure [:answer/validate]} {:db/id "answer-ecfa35ae-3197-55c3-8180-1535e0873fbd" :answer/id #uuid "ecfa35ae-3197-55c3-8180-1535e0873fbd" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(\\frac{{x}^{3}}{y})" :db/ensure [:answer/validate]} {:db/id "answer-c76a97fc-fdf4-5ad6-8243-95edbdc9a876" :answer/id #uuid "c76a97fc-fdf4-5ad6-8243-95edbdc9a876" :answer/type :answer.type/math :answer/value "{log}_{4}⁡(\\sqrt[3]{x}y)" :db/ensure [:answer/validate]} {:db/id "question-49c1090f-0d14-5ccb-9c30-a8b9c4fffd87" :question/id #uuid "49c1090f-0d14-5ccb-9c30-a8b9c4fffd87" :question/math-academy-id "q-79403" :question/problem "Express $4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y)$ as a single logarithm." :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y) & =\\operatorname{ln}⁡({x}^{4})-\\operatorname{ln}⁡({y}^{2}) \\\\  & =\\operatorname{ln}⁡(\\frac{{x}^{4}}{{y}^{2}}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4f6009af-c9fb-5d51-99cd-1ba483beaabc"] :db/ensure [:question/validate]} {:db/id "answer-field-4f6009af-c9fb-5d51-99cd-1ba483beaabc" :answer-field/id #uuid "4f6009af-c9fb-5d51-99cd-1ba483beaabc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-69b0b1b4-2068-59f6-8caa-0232583e7632" :answer-field/choices ["answer-5d51face-45fc-5f92-aa4c-e940cfa9f9a6" "answer-08538244-0a29-5cc7-b86c-0a8d7eb92a45" "answer-69b0b1b4-2068-59f6-8caa-0232583e7632" "answer-e5bfefa4-4a1a-5bbe-945c-432a0e867b73" "answer-bd225b51-2569-5aab-a898-96374e23410e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5d51face-45fc-5f92-aa4c-e940cfa9f9a6" :answer/id #uuid "5d51face-45fc-5f92-aa4c-e940cfa9f9a6" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{x}{y})" :db/ensure [:answer/validate]} {:db/id "answer-08538244-0a29-5cc7-b86c-0a8d7eb92a45" :answer/id #uuid "08538244-0a29-5cc7-b86c-0a8d7eb92a45" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{{x}^{2}}{y})" :db/ensure [:answer/validate]} {:db/id "answer-69b0b1b4-2068-59f6-8caa-0232583e7632" :answer/id #uuid "69b0b1b4-2068-59f6-8caa-0232583e7632" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{{x}^{4}}{{y}^{2}})" :db/ensure [:answer/validate]} {:db/id "answer-e5bfefa4-4a1a-5bbe-945c-432a0e867b73" :answer/id #uuid "e5bfefa4-4a1a-5bbe-945c-432a0e867b73" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{{y}^{2}}{x})" :db/ensure [:answer/validate]} {:db/id "answer-bd225b51-2569-5aab-a898-96374e23410e" :answer/id #uuid "bd225b51-2569-5aab-a898-96374e23410e" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(\\frac{{y}^{4}}{{x}^{2}})" :db/ensure [:answer/validate]} {:db/id "question-34847574-efca-5670-8924-e70a3bcc31ce" :question/id #uuid "34847574-efca-5670-8924-e70a3bcc31ce" :question/math-academy-id "q-66923" :question/problem "${log}_{2}⁡(\\frac{\\sqrt{x}{y}^{2}}{z})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get\n\n$$\n{log}_{2}⁡(\\frac{\\sqrt{x}{y}^{2}}{z})={log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z).\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z)={log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) & ={log}_{2}⁡({x}^{1/2})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) \\\\  & =\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\\end{aligned}\n$$\n\nTherefore\n\n$$\n{log}_{2}⁡(\\frac{\\sqrt{x}{y}^{2}}{z})=\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b2475f77-a3bc-521f-922f-608b63eb6022"] :db/ensure [:question/validate]} {:db/id "answer-field-b2475f77-a3bc-521f-922f-608b63eb6022" :answer-field/id #uuid "b2475f77-a3bc-521f-922f-608b63eb6022" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" :answer-field/choices ["answer-0cece677-9803-52b0-b907-23768dbe2ac7" "answer-ec14ff8e-fb9a-5ae2-9974-b0a7e6bb510d" "answer-6a89e1fb-1817-5ee7-bb66-dae6fa7f2260" "answer-6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" "answer-fb088d0f-9bbb-51fc-8107-4545e4127621"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cece677-9803-52b0-b907-23768dbe2ac7" :answer/id #uuid "0cece677-9803-52b0-b907-23768dbe2ac7" :answer/type :answer.type/math :answer/value "2{log}_{2}⁡(x)+\\frac{1}{2}{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-ec14ff8e-fb9a-5ae2-9974-b0a7e6bb510d" :answer/id #uuid "ec14ff8e-fb9a-5ae2-9974-b0a7e6bb510d" :answer/type :answer.type/math :answer/value "2{log}_{2}⁡(x)-2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-6a89e1fb-1817-5ee7-bb66-dae6fa7f2260" :answer/id #uuid "6a89e1fb-1817-5ee7-bb66-dae6fa7f2260" :answer/type :answer.type/math :answer/value "2{log}_{2}⁡(x)-\\frac{1}{2}{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" :answer/id #uuid "6929a7d0-50d3-5bd8-b005-5eaf6c8afc89" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-fb088d0f-9bbb-51fc-8107-4545e4127621" :answer/id #uuid "fb088d0f-9bbb-51fc-8107-4545e4127621" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{log}_{2}⁡(x)-2{log}_{2}⁡(y)+{log}_{2}⁡(z)" :db/ensure [:answer/validate]} {:db/id "question-e3b649a8-d282-53b7-b8c8-e883fd47c0b9" :question/id #uuid "e3b649a8-d282-53b7-b8c8-e883fd47c0b9" :question/math-academy-id "q-79406" :question/problem "${log}_{3}⁡(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}})=$" :question/worked-solution "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get:\n\n$$\n{log}_{3}⁡(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}})={log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})={log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z}).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n{log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z})=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$\n\nTherefore\n\n$$\n{log}_{3}⁡(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}})=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3ccb3dbb-60a9-5fb3-a5b6-44c5f5ad437b"] :db/ensure [:question/validate]} {:db/id "answer-field-3ccb3dbb-60a9-5fb3-a5b6-44c5f5ad437b" :answer-field/id #uuid "3ccb3dbb-60a9-5fb3-a5b6-44c5f5ad437b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-10851533-4282-5b80-bae7-98d8fc92685d" :answer-field/choices ["answer-290b87bb-8570-5cb4-83b9-b6d2e59941cd" "answer-10851533-4282-5b80-bae7-98d8fc92685d" "answer-84635862-dc5f-5a84-88a5-ebc9a5b22bda" "answer-91fec59e-a5fa-5664-9d8b-2381d008fe09" "answer-599a54dc-6c33-56a6-8830-1ae45124f78d"] :db/ensure [:answer-field/validate]} {:db/id "answer-290b87bb-8570-5cb4-83b9-b6d2e59941cd" :answer/id #uuid "290b87bb-8570-5cb4-83b9-b6d2e59941cd" :answer/type :answer.type/math :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-10851533-4282-5b80-bae7-98d8fc92685d" :answer/id #uuid "10851533-4282-5b80-bae7-98d8fc92685d" :answer/type :answer.type/math :answer/value "2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-84635862-dc5f-5a84-88a5-ebc9a5b22bda" :answer/id #uuid "84635862-dc5f-5a84-88a5-ebc9a5b22bda" :answer/type :answer.type/math :answer/value "2{log}_{3}⁡(x)+{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-91fec59e-a5fa-5664-9d8b-2381d008fe09" :answer/id #uuid "91fec59e-a5fa-5664-9d8b-2381d008fe09" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(x)+{log}_{3}⁡(y)+\\frac{1}{2}{log}_{3}⁡(z)" :db/ensure [:answer/validate]} {:db/id "answer-599a54dc-6c33-56a6-8830-1ae45124f78d" :answer/id #uuid "599a54dc-6c33-56a6-8830-1ae45124f78d" :answer/type :answer.type/math :answer/value "{log}_{3}⁡(x)-{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z)" :db/ensure [:answer/validate]} {:db/id 17592186055969 :tutorial/content "Recall that logarithms that share a common base $n$ obey the following three laws:\n\n- **The Product Rule**\n\n$$\n\\log_n(a) + \\log_n(b) = \\log_n(ab)\n$$\n\n- **The Quotient Rule**\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left( \\dfrac{a}{b} \\right)\n$$\n\n- **The Power Rule**\n\n$$\n\\log_n(c^m)= m\\log_n\\left( c \\right)\n$$\n\nWe can use these laws together to simplify a logarithmic expression.\n\nFor instance, we can write $3\\log_2(x) + \\dfrac 1 2 \\log_2(y)$ as an expression containing a single term.\n\nFirst, using the power rule, we can write\n\n$$\n\\eqalign {\n\t3\\log_2(x) + \\dfrac 1 2 \\log_2(y) &= \\log_2\\left(x^3\\right) + \\log_2\\left(y^{1/ 2}\\right)\\\n\t&= \\log_2\\left(x^3\\right) + \\log_2 \\left(\\sqrt{y}\\right)\t.\n\t}\n$$\n\nNow, using the product rule, we get\n\n$$\n\\log_2\\left(x^3\\right) + \\log_2 \\left(\\sqrt{y}\\right) = \\log_2 \\left(x^3\\sqrt{y}\\right).\n$$\n\nTherefore,\n\n$$\n3\\log_2(x) + \\dfrac 1 2 \\log_2(y) = \\log_2 \\left(x^3\\sqrt{y}\\right).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186054892 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]}]
