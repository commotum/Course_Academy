=-6\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-abd7fc75-76ad-538d-8473-a58530f6d817"] :db/ensure [:question/validate]} {:db/id "answer-field-abd7fc75-76ad-538d-8473-a58530f6d817" :answer-field/id #uuid "abd7fc75-76ad-538d-8473-a58530f6d817" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f54be357-0b0e-5eb1-9cf5-f059be49aadf" :answer-field/choices ["answer-f54be357-0b0e-5eb1-9cf5-f059be49aadf" "answer-eb7be00e-68c2-5e0d-baee-30814e8f0558" "answer-40c7ee0c-a229-553d-8145-37422e8684fa" "answer-5dc4140c-ff98-5ca1-9dfe-07b84f312647" "answer-7cbcd85f-3ddc-53d4-a644-eeb257393505"] :db/ensure [:answer-field/validate]} {:db/id "answer-f54be357-0b0e-5eb1-9cf5-f059be49aadf" :answer/id #uuid "f54be357-0b0e-5eb1-9cf5-f059be49aadf" :answer/type :answer.type/math :answer/value "r=-6\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-eb7be00e-68c2-5e0d-baee-30814e8f0558" :answer/id #uuid "eb7be00e-68c2-5e0d-baee-30814e8f0558" :answer/type :answer.type/math :answer/value "r=-6\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-40c7ee0c-a229-553d-8145-37422e8684fa" :answer/id #uuid "40c7ee0c-a229-553d-8145-37422e8684fa" :answer/type :answer.type/math :answer/value "r=-6\\operatorname{tan}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-5dc4140c-ff98-5ca1-9dfe-07b84f312647" :answer/id #uuid "5dc4140c-ff98-5ca1-9dfe-07b84f312647" :answer/type :answer.type/math :answer/value "r=6\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-7cbcd85f-3ddc-53d4-a644-eeb257393505" :answer/id #uuid "7cbcd85f-3ddc-53d4-a644-eeb257393505" :answer/type :answer.type/math :answer/value "r=6\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "question-06dd95dd-7aca-5dd6-bbfa-f6a3626f7868" :question/id #uuid "06dd95dd-7aca-5dd6-bbfa-f6a3626f7868" :question/math-academy-id "q-17277" :question/problem "![](images/97/97b246abafb0152ac4f36d3d71476664cfb687fedaae62fc854aad4113a6b082.png)\n\nWhat is the polar equation of the curve shown above?" :question/worked-solution "The diagram shows a circle of radius $|a|=|-4.5|=4.5$ centered at the point $(-4.5,0).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{cos}⁡\\theta  \\\\  & =2\\cdot (-4.5)\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =-9\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e7181550-dec7-576e-8010-58a13c746104"] :db/ensure [:question/validate]} {:db/id "answer-field-e7181550-dec7-576e-8010-58a13c746104" :answer-field/id #uuid "e7181550-dec7-576e-8010-58a13c746104" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-56848177-37b1-52a1-84d2-395faabcf2f1" :answer-field/choices ["answer-56848177-37b1-52a1-84d2-395faabcf2f1" "answer-be1bae2f-fb53-5aaa-9ae9-fd8016470834" "answer-0ead7495-9d1a-5f6e-99a3-8e36672e478a" "answer-86f098f5-e383-5c34-807c-21780f62cae2" "answer-39303a4a-5088-510c-9caa-10c1d8540af2"] :db/ensure [:answer-field/validate]} {:db/id "answer-56848177-37b1-52a1-84d2-395faabcf2f1" :answer/id #uuid "56848177-37b1-52a1-84d2-395faabcf2f1" :answer/type :answer.type/math :answer/value "r=-9\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-be1bae2f-fb53-5aaa-9ae9-fd8016470834" :answer/id #uuid "be1bae2f-fb53-5aaa-9ae9-fd8016470834" :answer/type :answer.type/math :answer/value "r=-9\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-0ead7495-9d1a-5f6e-99a3-8e36672e478a" :answer/id #uuid "0ead7495-9d1a-5f6e-99a3-8e36672e478a" :answer/type :answer.type/math :answer/value "r=3\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-86f098f5-e383-5c34-807c-21780f62cae2" :answer/id #uuid "86f098f5-e383-5c34-807c-21780f62cae2" :answer/type :answer.type/math :answer/value "r=9\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-39303a4a-5088-510c-9caa-10c1d8540af2" :answer/id #uuid "39303a4a-5088-510c-9caa-10c1d8540af2" :answer/type :answer.type/math :answer/value "r=9\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "question-d345ebc0-fb4a-55bd-95ea-a1eddcced6e5" :question/id #uuid "d345ebc0-fb4a-55bd-95ea-a1eddcced6e5" :question/math-academy-id "q-281480" :question/problem "![](images/49/49238b18533c2ded8180a8532325f14c3b052fb32c58a81892877fba2a4ee054.png)\n\nThe polar equation of the given curve is $r=${{field-1}}." :question/worked-solution "The diagram shows a circle of radius $|a|=|-6|=6$ centered at the point $(-6,0).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{cos}⁡\\theta  \\\\  & =2\\cdot (-6)\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =-12\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e203115c-e10d-5845-891b-2d11e9765a9c"] :db/ensure [:question/validate]} {:db/id "answer-field-e203115c-e10d-5845-891b-2d11e9765a9c" :answer-field/id #uuid "e203115c-e10d-5845-891b-2d11e9765a9c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-bafe0ed7-0bd4-55e8-a804-d4e574db739d" :answer-field/choices ["answer-bafe0ed7-0bd4-55e8-a804-d4e574db739d"] :db/ensure [:answer-field/validate]} {:db/id "answer-bafe0ed7-0bd4-55e8-a804-d4e574db739d" :answer/id #uuid "bafe0ed7-0bd4-55e8-a804-d4e574db739d" :answer/type :answer.type/math :answer/value "-12\\cos\\theta" :db/ensure [:answer/validate]} {:db/id "question-7fdddd6d-d41d-5369-b195-6ee0cc2418de" :question/id #uuid "7fdddd6d-d41d-5369-b195-6ee0cc2418de" :question/math-academy-id "q-16470" :question/problem "![](images/ae/aee2a6a03d8dc10cd56e6e2df279fcf88672d0c83d0ae7abc86a0c8b1a3e434d.png)\n\nWhat is the polar equation of the curve shown above?" :question/worked-solution "The diagram shows a circle of radius $a=1$ centered at the point $(0,1).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{sin}⁡\\theta  \\\\  & =2\\cdot 1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ed1dad79-818d-5104-8482-8cae5910311a"] :db/ensure [:question/validate]} {:db/id "answer-field-ed1dad79-818d-5104-8482-8cae5910311a" :answer-field/id #uuid "ed1dad79-818d-5104-8482-8cae5910311a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5748e38-7810-59d4-bbef-a5e6fa736e65" :answer-field/choices ["answer-f5748e38-7810-59d4-bbef-a5e6fa736e65" "answer-8306e858-4a13-52c8-b0b3-d9a21b955da0" "answer-db805938-1a26-554c-8de2-fa5d15082599" "answer-26170fed-0808-5028-b332-6f767e823106" "answer-c9e39e06-98ba-5d78-b2ed-a3a2bc1bd3ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-f5748e38-7810-59d4-bbef-a5e6fa736e65" :answer/id #uuid "f5748e38-7810-59d4-bbef-a5e6fa736e65" :answer/type :answer.type/math :answer/value "r=2\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8306e858-4a13-52c8-b0b3-d9a21b955da0" :answer/id #uuid "8306e858-4a13-52c8-b0b3-d9a21b955da0" :answer/type :answer.type/math :answer/value "r=2\\theta " :db/ensure [:answer/validate]} {:db/id "answer-db805938-1a26-554c-8de2-fa5d15082599" :answer/id #uuid "db805938-1a26-554c-8de2-fa5d15082599" :answer/type :answer.type/math :answer/value "r=4\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-26170fed-0808-5028-b332-6f767e823106" :answer/id #uuid "26170fed-0808-5028-b332-6f767e823106" :answer/type :answer.type/math :answer/value "r=4\\theta " :db/ensure [:answer/validate]} {:db/id "answer-c9e39e06-98ba-5d78-b2ed-a3a2bc1bd3ca" :answer/id #uuid "c9e39e06-98ba-5d78-b2ed-a3a2bc1bd3ca" :answer/type :answer.type/math :answer/value "r=\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "question-e14b9dd2-f663-55f7-a3e0-3b4821a83167" :question/id #uuid "e14b9dd2-f663-55f7-a3e0-3b4821a83167" :question/math-academy-id "q-281499" :question/problem "![](images/1a/1a5390c0531968e8ef7f3817aa7ceb539ea08633fbfce611736cd3b548c17c1e.png)\n\nThe polar equation of the given curve is $r=${{field-1}}." :question/worked-solution "The diagram shows a circle of radius $|a|=|-1.5|=1.5$ centered at the point $(0,-1.5).$\n\nIn polar coordinates, the equation of such a circle is given by\n\n$$\n\\begin{aligned}r & =2a\\operatorname{sin}⁡\\theta  \\\\  & =2\\cdot (-1.5)\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =-3\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9954e5e0-82ec-58d8-b662-5f315b96877d"] :db/ensure [:question/validate]} {:db/id "answer-field-9954e5e0-82ec-58d8-b662-5f315b96877d" :answer-field/id #uuid "9954e5e0-82ec-58d8-b662-5f315b96877d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0cf10e9f-c6d6-5e2f-b906-1ed89575ede3" :answer-field/choices ["answer-0cf10e9f-c6d6-5e2f-b906-1ed89575ede3"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cf10e9f-c6d6-5e2f-b906-1ed89575ede3" :answer/id #uuid "0cf10e9f-c6d6-5e2f-b906-1ed89575ede3" :answer/type :answer.type/math :answer/value "-3\\sin\\theta" :db/ensure [:answer/validate]} {:db/id 17592186106074 :question/problem "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-1,1).$ What is the value of $k?$" :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{1}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|-\\frac{1}{1}| \\\\  & =\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(\\sqrt{2},\\frac{3\\pi }{4}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ \\sqrt{2} & =k\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\ \\sqrt{2} & =k(-\\frac{1}{\\sqrt{2}}) \\\\ k & =-2\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-2\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/e4/e46b6d286319331da310aecbaaf6b0aaa38243d239697e6c07374341e0ff62d8.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186102330 :answer-field/correct 17592186102335 :db/ensure [:answer-field/validate]} {:db/id "question-b69fb899-dda9-520e-9df1-5f655ac32f35" :question/id #uuid "b69fb899-dda9-520e-9df1-5f655ac32f35" :question/math-academy-id "q-121354" :question/problem "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-1,\\sqrt{3}).$ What is the value of $k?$" :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(\\sqrt{3})}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|-\\frac{\\sqrt{3}}{1}| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(2,\\frac{2\\pi }{3}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 2 & =k\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\ 2 & =k(-\\frac{1}{2}) \\\\ k & =-4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/f8/f85ddaa01b6f2232627375ec622232a245c6e7e21fb9e294cd0801fd45433d73.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-949b8458-1c9d-5893-a395-0d0724748af6"] :db/ensure [:question/validate]} {:db/id "answer-field-949b8458-1c9d-5893-a395-0d0724748af6" :answer-field/id #uuid "949b8458-1c9d-5893-a395-0d0724748af6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a82f221-b74d-53a8-8503-dd83640fa112" :answer-field/choices ["answer-9a82f221-b74d-53a8-8503-dd83640fa112" "answer-a4b697a9-1b21-56af-8f8c-9f4c93fcecf3" "answer-3c779408-7831-5160-b0c8-60656efd484a" "answer-07fd8dbf-8464-5213-809c-abf7fe832f06" "answer-ac2ba49b-f75f-5551-9a43-d83d73aeffba"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a82f221-b74d-53a8-8503-dd83640fa112" :answer/id #uuid "9a82f221-b74d-53a8-8503-dd83640fa112" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-a4b697a9-1b21-56af-8f8c-9f4c93fcecf3" :answer/id #uuid "a4b697a9-1b21-56af-8f8c-9f4c93fcecf3" :answer/type :answer.type/math :answer/value "-4\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-3c779408-7831-5160-b0c8-60656efd484a" :answer/id #uuid "3c779408-7831-5160-b0c8-60656efd484a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-07fd8dbf-8464-5213-809c-abf7fe832f06" :answer/id #uuid "07fd8dbf-8464-5213-809c-abf7fe832f06" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-ac2ba49b-f75f-5551-9a43-d83d73aeffba" :answer/id #uuid "ac2ba49b-f75f-5551-9a43-d83d73aeffba" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-2e8e220e-5d02-535f-8203-20819203c421" :question/id #uuid "2e8e220e-5d02-535f-8203-20819203c421" :question/math-academy-id "q-281737" :question/problem "If the polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-3,-3),$  then $k=${{field-1}}." :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(3)}^{2}+{(3)}^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the third quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi +\\operatorname{arctan}⁡|\\frac{-3}{-3}| \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(3\\sqrt{2},\\frac{5\\pi }{4}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 3\\sqrt{2} & =k\\operatorname{cos}⁡(\\frac{5\\pi }{4}) \\\\ 3\\sqrt{2} & =k(-\\frac{1}{\\sqrt{2}}) \\\\ k & =-6\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-6\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/72/72cb94d6ed11f7502e7810d7d201ba71e594ed97a7a3eadd789732ca3dcb8968.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9cf19871-6dd2-593d-bf3f-f7ad27ac4fd0"] :db/ensure [:question/validate]} {:db/id "answer-field-9cf19871-6dd2-593d-bf3f-f7ad27ac4fd0" :answer-field/id #uuid "9cf19871-6dd2-593d-bf3f-f7ad27ac4fd0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2bf6bafc-4476-5a9e-af7f-e7e2638c73cc" :answer-field/choices ["answer-2bf6bafc-4476-5a9e-af7f-e7e2638c73cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bf6bafc-4476-5a9e-af7f-e7e2638c73cc" :answer/id #uuid "2bf6bafc-4476-5a9e-af7f-e7e2638c73cc" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "question-5fff1012-20ae-54c4-8327-06d77bbed9eb" :question/id #uuid "5fff1012-20ae-54c4-8327-06d77bbed9eb" :question/math-academy-id "q-121522" :question/problem "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-\\frac{9}{2},-\\frac{3\\sqrt{3}}{2}).$ What is the value of $k?$" :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-\\frac{9}{2})}^{2}+{(-\\frac{3\\sqrt{3}}{2})}^{2}} \\\\  & =\\sqrt{\\frac{81}{4}+\\frac{27}{4}} \\\\  & =\\sqrt{27} \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the third quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi +\\operatorname{arctan}⁡|\\frac{-\\frac{3\\sqrt{3}}{2}}{-\\frac{9}{2}}| \\\\  & =\\pi +\\operatorname{arctan}⁡\\frac{\\sqrt{3}}{3} \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(3\\sqrt{3},\\frac{7\\pi }{6}).$  \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 3\\sqrt{3} & =k\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\ 3\\sqrt{3} & =k(-\\frac{\\sqrt{3}}{2}) \\\\ k & =-6\\end{aligned}\n$$\n\n \n\nTherefore, the equation of the curve is $r=-6\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/99/999a34650676174083aa479669eecca0c837dc8e5f1397a81a8949d8f9dc9de1.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-73fea5df-076e-5c43-b1fe-9e9657547c19"] :db/ensure [:question/validate]} {:db/id "answer-field-73fea5df-076e-5c43-b1fe-9e9657547c19" :answer-field/id #uuid "73fea5df-076e-5c43-b1fe-9e9657547c19" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cf7c9130-467b-5bbc-adb8-bda779f897f5" :answer-field/choices ["answer-f056c49a-e227-56b9-82af-8dff44909eb9" "answer-02678531-9c49-5d43-ac23-ff708b70c36a" "answer-cf7c9130-467b-5bbc-adb8-bda779f897f5" "answer-61ecb54f-4cf4-55d8-87f1-9831a5a2ebfb" "answer-998509c8-dbe2-5773-9816-4eebd147b0d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-f056c49a-e227-56b9-82af-8dff44909eb9" :answer/id #uuid "f056c49a-e227-56b9-82af-8dff44909eb9" :answer/type :answer.type/math :answer/value "-2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-02678531-9c49-5d43-ac23-ff708b70c36a" :answer/id #uuid "02678531-9c49-5d43-ac23-ff708b70c36a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-cf7c9130-467b-5bbc-adb8-bda779f897f5" :answer/id #uuid "cf7c9130-467b-5bbc-adb8-bda779f897f5" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-61ecb54f-4cf4-55d8-87f1-9831a5a2ebfb" :answer/id #uuid "61ecb54f-4cf4-55d8-87f1-9831a5a2ebfb" :answer/type :answer.type/math :answer/value "-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-998509c8-dbe2-5773-9816-4eebd147b0d7" :answer/id #uuid "998509c8-dbe2-5773-9816-4eebd147b0d7" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-0054ec1e-580f-564e-8493-248291e1368b" :question/id #uuid "0054ec1e-580f-564e-8493-248291e1368b" :question/math-academy-id "q-281742" :question/problem "If the polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-3,\\sqrt{3}),$  then $k=${{field-1}}." :question/worked-solution "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-3)}^{2}+{(\\sqrt{3})}^{2}} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|\\frac{\\sqrt{3}}{-3}| \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(2\\sqrt{3},\\frac{5\\pi }{6}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}2\\sqrt{3} & =k\\operatorname{cos}⁡\\theta  \\\\ 2\\sqrt{3} & =k\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\ 2\\sqrt{3} & =k(-\\frac{\\sqrt{3}}{2}) \\\\ k & =-4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/de/def95f29f6397b0f6eab20afb6327d8f3f99fdc52fbeac0b0c2af8b228d060a9.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6bbb16c8-6341-55ff-b300-2282e814f399"] :db/ensure [:question/validate]} {:db/id "answer-field-6bbb16c8-6341-55ff-b300-2282e814f399" :answer-field/id #uuid "6bbb16c8-6341-55ff-b300-2282e814f399" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5351d84c-4882-5054-a0c1-cbc0e962e2cb" :answer-field/choices ["answer-5351d84c-4882-5054-a0c1-cbc0e962e2cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-5351d84c-4882-5054-a0c1-cbc0e962e2cb" :answer/id #uuid "5351d84c-4882-5054-a0c1-cbc0e962e2cb" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id 17592186107086 :tutorial/content "When a circle is not centered at the origin, we can still write its equation in polar form. In fact, the polar equation of a circle is particularly straightforward when it passes through the origin and its center lies on the $x$-axis.\n\nFor example, let $a$ be some nonzero real number, and consider a circle of radius $|a|$ with center at the point $(a,0)$. \n\n![](images/46/4632ae0baaced6ba3699fddf859b71226b5fcebe4700bbbdf4774d1d701e53ad.png)\n\nWith a little bit of geometry and trigonometry, it turns out that the equation of this circle in polar form is given by\n\n$$\nr=2a\\cos\\theta.\n$$\n\nWe'll derive this result at the end of the lesson.\n\nSo, for instance, if $a=2$, then we have a circle of radius $2$ centered at $(2,0),$ and its polar equation is\n\n$$\nr= 4 \\cos\\theta.\n$$\n\nSimilarly, if $a=-2,$ then we have a circle of radius $|{-2}| = 2$ centered at $(-2,0),$ and its polar equation is\n\n$$\nr= -4 \\cos\\theta.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186107087 :tutorial/content "Now, let $a$ be some nonzero real number, and let's consider a circle of radius $|a|$ whose center is at the point $(0,a).$\n\n![](images/40/40477171cd880e675656ed0093c26a85ebe02b7939ec9421a1bcc52c763a68fe.png)\n\nNotice that this circle passes through the origin, and its center lies on the $y$-axis.\n\nAgain, using some geometry and trigonometry, it's possible to show that the polar equation of the circle is\n\n$$\nr=2a \\sin \\theta.\n$$\n\nWe'll derive this result at the end of the lesson.\n\nSo, for instance, if $a=2,$ then we have a circle of radius $2$ centered at $(0,2),$ and its polar equation is\n\n$$\nr=4 \\sin \\theta.\n$$\n\nSimilarly, if $a=-3$, then we have a circle of radius $|{-3}| = 3$ centered at $(0,-3),$ and its polar equation is\n\n$$\nr=-6 \\sin \\theta.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186107028 :tutorial/content "![](images/46/4632ae0baaced6ba3699fddf859b71226b5fcebe4700bbbdf4774d1d701e53ad.png)\n\nSuppose we want to derive the polar equation of a circle with\n\n- center at $(a, 0)$, where $a \\ne 0$, and\n\n- radius $|a|$, so that it passes through the origin.\n\nLet a point $P$ on the circle have polar coordinates $(r, \\theta)$. Then, the Cartesian coordinates of $P$ are\n\n$$\n(x, y) = (r\\cos\\theta, \\, r\\sin\\theta).\n$$\n\nThe distance from $P$ to the center $(a, 0)$ is equal to the radius $|a|.$ We can describe this using the distance formula:\n\n$$\n\\sqrt{(r\\cos\\theta - a)^2 + (r\\sin\\theta)^2} = |a|\n$$\n\nSquaring both sides, we get\n\n$$\n(r\\cos\\theta - a)^2 + (r\\sin\\theta)^2 = a^2.\n$$\n\nExpanding both terms yields\n\n$$\nr^2\\cos^2\\theta - 2ar\\cos\\theta + a^2 + r^2\\sin^2\\theta = a^2.\n$$\n\nThen, we combine like terms:\n\n$$\nr^2(\\cos^2\\theta + \\sin^2\\theta) - 2ar\\cos\\theta + a^2 = a^2\n$$\n\nSince $\\cos^2\\theta + \\sin^2\\theta = 1$, we can simplify the above as follows:\n\n$$\nr^2 - 2ar\\cos\\theta + a^2 = a^2\n$$\n\nSubtracting $a^2$ from both sides gives\n\n$$\nr^2 - 2ar\\cos\\theta = 0.\n$$\n\nThen, we factor our equation:\n\n$$\nr(r - 2a\\cos\\theta) = 0\n$$\n\nSo, either $r = 0$ (which corresponds to the origin, already on the circle), or\n\n$$\nr = 2a\\cos\\theta,\n$$\n\nwhich is the desired polar equation of the circle." :db/ensure [:tutorial/validate]} {:db/id 17592186107029 :tutorial/content "![](images/a2/a2662be5d74155ca29b600cf48982a1ee2b0db62459334af7784394cabea8687.png)\n\nSuppose we want to derive the polar equation of a circle with\n\n- center at $(0, a)$, where $a \\ne 0$, and\n\n- radius $|a|$, so that it passes through the origin.\n\nLet a point $P$ on the circle have polar coordinates $(r, \\theta)$. Then, the Cartesian coordinates of $P$ are\n\n$$\n(x, y) = (r\\cos\\theta, \\, r\\sin\\theta).\n$$\n\nThe distance from $P$ to the center $(0, a)$ is equal to the radius $|a|.$ We can describe this using the distance formula:\n\n$$\n\\sqrt{(r\\cos\\theta - 0)^2 + (r\\sin\\theta - a)^2} = |a|\n$$\n\nSquaring both sides, we get\n\n$$\n(r\\cos\\theta)^2 + (r\\sin\\theta - a)^2 = a^2.\n$$\n\nExpanding both terms yields\n\n$$\nr^2\\cos^2\\theta + r^2\\sin^2\\theta - 2ar\\sin\\theta + a^2 = a^2.\n$$\n\nThen, we combine like terms:\n\n$$\nr^2(\\cos^2\\theta + \\sin^2\\theta) - 2ar\\sin\\theta + a^2 = a^2\n$$\n\nSince $\\cos^2\\theta + \\sin^2\\theta = 1$, we simplify:\n\n$$\nr^2 - 2ar\\sin\\theta + a^2 = a^2\n$$\n\nSubtracting $a^2$ from both sides gives\n\n$$\nr^2 - 2ar\\sin\\theta = 0.\n$$\n\nThen, we factor our equation:\n\n$$\nr(r - 2a\\sin\\theta) = 0\n$$\n\nSo, either $r = 0$ (which corresponds to the origin, already on the circle), or\n\n$$\nr = 2a\\sin\\theta,\n$$\n\nwhich is the desired polar equation of the circle." :db/ensure [:tutorial/validate]} {:db/id 17592186105952 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186068732 :knowledge-point/questions ["question-eeaf419f-60bd-5e26-a56f-c339e863386b" "question-a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eeaf419f-60bd-5e26-a56f-c339e863386b" :question/id #uuid "eeaf419f-60bd-5e26-a56f-c339e863386b" :question/math-academy-id "q-80" :question/problem "Solve the equation ${3}^{y}=81.$" :question/worked-solution "First, we rewrite $81$ as ${3}^{4}$ to get:\n\n$$\n\\begin{aligned}{3}^{y} & =81 \\\\ {3}^{y} & ={3}^{4}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents:\n\n$$\n\\begin{aligned}{3}^{y} & ={3}^{4} \\\\ y & =4\\end{aligned}\n$$\n\nTherefore, the solution is $y=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9ca78635-18fa-5e3d-9d10-fbb809a1f37f"] :db/ensure [:question/validate]} {:db/id "answer-field-9ca78635-18fa-5e3d-9d10-fbb809a1f37f" :answer-field/id #uuid "9ca78635-18fa-5e3d-9d10-fbb809a1f37f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" :answer-field/choices ["answer-d3491e51-ea1f-58eb-85da-ce79e7691031" "answer-9a86847d-23cc-55e2-bcd7-a9694dcba515" "answer-e06b7cc3-71e1-5a4d-8b96-8f5989ac4eb6" "answer-4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" "answer-408391ae-d464-521f-b3b1-0616515cdb2e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3491e51-ea1f-58eb-85da-ce79e7691031" :answer/id #uuid "d3491e51-ea1f-58eb-85da-ce79e7691031" :answer/type :answer.type/math :answer/value "y=-3" :db/ensure [:answer/validate]} {:db/id "answer-9a86847d-23cc-55e2-bcd7-a9694dcba515" :answer/id #uuid "9a86847d-23cc-55e2-bcd7-a9694dcba515" :answer/type :answer.type/math :answer/value "y=2" :db/ensure [:answer/validate]} {:db/id "answer-e06b7cc3-71e1-5a4d-8b96-8f5989ac4eb6" :answer/id #uuid "e06b7cc3-71e1-5a4d-8b96-8f5989ac4eb6" :answer/type :answer.type/math :answer/value "y=3" :db/ensure [:answer/validate]} {:db/id "answer-4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" :answer/id #uuid "4e83f3fd-bf6e-52e8-a020-7d0bc696a11b" :answer/type :answer.type/math :answer/value "y=4" :db/ensure [:answer/validate]} {:db/id "answer-408391ae-d464-521f-b3b1-0616515cdb2e" :answer/id #uuid "408391ae-d464-521f-b3b1-0616515cdb2e" :answer/type :answer.type/math :answer/value "y=\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "question-a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9" :question/id #uuid "a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9" :question/math-academy-id "q-45486" :question/problem "Solve the equation ${5}^{x}=\\frac{1}{125}.$" :question/worked-solution "First, we rewrite $125$ as ${5}^{3}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{125} \\\\ {5}^{x} & =\\frac{1}{{5}^{3}} \\\\ {5}^{x} & ={5}^{-3}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-3} \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution is $x=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8819a29e-57d4-59e0-a6c9-1c8665d8df6a"] :db/ensure [:question/validate]} {:db/id "answer-field-8819a29e-57d4-59e0-a6c9-1c8665d8df6a" :answer-field/id #uuid "8819a29e-57d4-59e0-a6c9-1c8665d8df6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2edcc807-3636-52ce-bfc5-aaeaf9e3c605" :answer-field/choices ["answer-79e2e42a-4919-5f80-adf9-a1f3434370e3" "answer-2edcc807-3636-52ce-bfc5-aaeaf9e3c605" "answer-8dd35fa6-7512-5340-9b7a-de251ebbb42e" "answer-b5d42485-2e6e-5647-b440-f854c28552be" "answer-712df8a0-8d70-5d49-b320-e800a8bdd2ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-79e2e42a-4919-5f80-adf9-a1f3434370e3" :answer/id #uuid "79e2e42a-4919-5f80-adf9-a1f3434370e3" :answer/type :answer.type/math :answer/value "x=-125" :db/ensure [:answer/validate]} {:db/id "answer-2edcc807-3636-52ce-bfc5-aaeaf9e3c605" :answer/id #uuid "2edcc807-3636-52ce-bfc5-aaeaf9e3c605" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-8dd35fa6-7512-5340-9b7a-de251ebbb42e" :answer/id #uuid "8dd35fa6-7512-5340-9b7a-de251ebbb42e" :answer/type :answer.type/math :answer/value "x=-5" :db/ensure [:answer/validate]} {:db/id "answer-b5d42485-2e6e-5647-b440-f854c28552be" :answer/id #uuid "b5d42485-2e6e-5647-b440-f854c28552be" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-712df8a0-8d70-5d49-b320-e800a8bdd2ad" :answer/id #uuid "712df8a0-8d70-5d49-b320-e800a8bdd2ad" :answer/type :answer.type/math :answer/value "x=\\frac{1}{125}" :db/ensure [:answer/validate]} {:db/id 17592186068733 :knowledge-point/questions ["question-3044149e-5bfc-5de0-b490-60c442d8ed07"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3044149e-5bfc-5de0-b490-60c442d8ed07" :question/id #uuid "3044149e-5bfc-5de0-b490-60c442d8ed07" :question/math-academy-id "q-45533" :question/problem "What is the solution to  $2\\cdot {8}^{y}=\\frac{1}{4}?$" :question/worked-solution "First, we isolate the term with the variable exponent by dividing both sides by $2$:\n\n$$\n\\begin{aligned}2\\cdot {8}^{y} & =\\frac{1}{4} \\\\ \\frac{2\\cdot {8}^{y}}{2} & =\\frac{(\\frac{1}{4})}{2} \\\\ {8}^{y} & =\\frac{1}{8}\\end{aligned}\n$$\n\nNow, we rewrite $\\frac{1}{8}$ as ${8}^{-1}$ to get:\n\n$$\n\\begin{aligned}{8}^{y} & =\\frac{1}{8} \\\\ {8}^{y} & ={8}^{-1}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(8)$, we equate the exponents:\n\n$$\n\\begin{aligned}{8}^{y} & ={8}^{-1} \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=-1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cd01a93c-d6e2-540b-8c0d-44c14937bd8f"] :db/ensure [:question/validate]} {:db/id "answer-field-cd01a93c-d6e2-540b-8c0d-44c14937bd8f" :answer-field/id #uuid "cd01a93c-d6e2-540b-8c0d-44c14937bd8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer-field/choices ["answer-780d7c64-0c00-5d57-b7ce-66b2f26ef78a" "answer-6a19ff45-4f16-58c5-a481-27c3e6c6c4b9" "answer-9ed9741b-2e78-58ae-b8cc-62e01e46a889" "answer-2c14bd25-60b1-5db9-a5b5-db353df1d229" "answer-9d1f2a50-d198-5902-817a-d0db539435f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/id #uuid "780d7c64-0c00-5d57-b7ce-66b2f26ef78a" :answer/type :answer.type/math :answer/value "y=-1" :db/ensure [:answer/validate]} {:db/id "answer-6a19ff45-4f16-58c5-a481-27c3e6c6c4b9" :answer/id #uuid "6a19ff45-4f16-58c5-a481-27c3e6c6c4b9" :answer/type :answer.type/math :answer/value "y=-2" :db/ensure [:answer/validate]} {:db/id "answer-9ed9741b-2e78-58ae-b8cc-62e01e46a889" :answer/id #uuid "9ed9741b-2e78-58ae-b8cc-62e01e46a889" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "answer-2c14bd25-60b1-5db9-a5b5-db353df1d229" :answer/id #uuid "2c14bd25-60b1-5db9-a5b5-db353df1d229" :answer/type :answer.type/math :answer/value "y=4" :db/ensure [:answer/validate]} {:db/id "answer-9d1f2a50-d198-5902-817a-d0db539435f4" :answer/id #uuid "9d1f2a50-d198-5902-817a-d0db539435f4" :answer/type :answer.type/math :answer/value "y=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "activity-5b788ddf-8728-5b13-bf64-a344eae95d32" :activity/id #uuid "5b788ddf-8728-5b13-bf64-a344eae95d32" :activity/title "Solving Exponential Equations" :activity/type :activity.type/review :activity/scope 17592186050511 :activity/course 17592186046647 :activity/steps ["step-6149d5bb-fed8-598b-8014-01b1ee9b8064" "step-ad4d284e-5319-5752-a7e6-913170f0dc13" "step-02fdcf69-8aea-585d-b9f7-39f84eb04ef4"] :activity/first-step "step-6149d5bb-fed8-598b-8014-01b1ee9b8064" :db/ensure [:activity/validate]} {:db/id "step-6149d5bb-fed8-598b-8014-01b1ee9b8064" :step/id #uuid "6149d5bb-fed8-598b-8014-01b1ee9b8064" :step/content "question-eeaf419f-60bd-5e26-a56f-c339e863386b" :step/next "step-ad4d284e-5319-5752-a7e6-913170f0dc13" :db/ensure [:step/validate]} {:db/id "step-ad4d284e-5319-5752-a7e6-913170f0dc13" :step/id #uuid "ad4d284e-5319-5752-a7e6-913170f0dc13" :step/content "question-a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9" :step/next "step-02fdcf69-8aea-585d-b9f7-39f84eb04ef4" :db/ensure [:step/validate]} {:db/id "step-02fdcf69-8aea-585d-b9f7-39f84eb04ef4" :step/id #uuid "02fdcf69-8aea-585d-b9f7-39f84eb04ef4" :step/content "question-3044149e-5bfc-5de0-b490-60c442d8ed07" :db/ensure [:step/validate]} {:db/id 17592186078458 :knowledge-point/questions ["question-ea6c80e5-0a00-5798-9872-7c227f663338" "question-9d1054aa-9f73-56ea-a93c-1d65449f0f07"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ea6c80e5-0a00-5798-9872-7c227f663338" :question/id #uuid "ea6c80e5-0a00-5798-9872-7c227f663338" :question/math-academy-id "q-5158" :question/problem "Factor $162{x}^{4}-2.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $2.$ To simplify the computation, we can factor out the $2,$ as follows:\n\n$$\n162{x}^{4}-2=2\\cdot 81{x}^{4}-2\\cdot 1=2(81{x}^{4}-1)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n2(81{x}^{4}-1)=2({(9{x}^{2})}^{2}-{1}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n2({(9{x}^{2})}^{2}-{1}^{2})=2(9{x}^{2}+1)(9{x}^{2}-1)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}2(9{x}^{2}+1)(9{x}^{2}-1) & =2(9{x}^{2}+1)({(3x)}^{2}-{1}^{2}) \\\\  & =2(9{x}^{2}+1)(3x+1)(3x-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b0587497-190f-5a43-9cd6-5471c683bb02"] :db/ensure [:question/validate]} {:db/id "answer-field-b0587497-190f-5a43-9cd6-5471c683bb02" :answer-field/id #uuid "b0587497-190f-5a43-9cd6-5471c683bb02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0d552ff0-06bd-50a5-91ff-6ffdaa4a9172" :answer-field/choices ["answer-93fefd61-c204-5b19-a4c2-00c6446d535d" "answer-0d552ff0-06bd-50a5-91ff-6ffdaa4a9172" "answer-4fe39158-c45c-5d07-8234-bb5aae85c535" "answer-c30ff4b0-ccfb-548c-9ce7-dea8ff9ce182" "answer-03b42502-8bb9-505b-a96e-7773c8d16207"] :db/ensure [:answer-field/validate]} {:db/id "answer-93fefd61-c204-5b19-a4c2-00c6446d535d" :answer/id #uuid "93fefd61-c204-5b19-a4c2-00c6446d535d" :answer/type :answer.type/math :answer/value "(9{x}^{2}+1)(3x+1)(3x-1)" :db/ensure [:answer/validate]} {:db/id "answer-0d552ff0-06bd-50a5-91ff-6ffdaa4a9172" :answer/id #uuid "0d552ff0-06bd-50a5-91ff-6ffdaa4a9172" :answer/type :answer.type/math :answer/value "2(9{x}^{2}+1)(3x+1)(3x-1)" :db/ensure [:answer/validate]} {:db/id "answer-4fe39158-c45c-5d07-8234-bb5aae85c535" :answer/id #uuid "4fe39158-c45c-5d07-8234-bb5aae85c535" :answer/type :answer.type/math :answer/value "2(9{x}^{2}+1)(x+1)(x-1)" :db/ensure [:answer/validate]} {:db/id "answer-c30ff4b0-ccfb-548c-9ce7-dea8ff9ce182" :answer/id #uuid "c30ff4b0-ccfb-548c-9ce7-dea8ff9ce182" :answer/type :answer.type/math :answer/value "2(9{x}^{2}+1)(x+3)(x-3)" :db/ensure [:answer/validate]} {:db/id "answer-03b42502-8bb9-505b-a96e-7773c8d16207" :answer/id #uuid "03b42502-8bb9-505b-a96e-7773c8d16207" :answer/type :answer.type/math :answer/value "9({x}^{2}+1)(2x+1)(2x-1)" :db/ensure [:answer/validate]} {:db/id "question-9d1054aa-9f73-56ea-a93c-1d65449f0f07" :question/id #uuid "9d1054aa-9f73-56ea-a93c-1d65449f0f07" :question/math-academy-id "q-14136" :question/problem "Factor $405-5{x}^{4}$ completely." :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms in our expression have a common factor of $5.$ To simplify the computation, we can factor out the $5,$ as follows:\n\n$$\n405-5{x}^{4}=5\\cdot 81-5\\cdot {x}^{4}=5(81-{x}^{4})\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n5(81-{x}^{4})=5({9}^{2}-{({x}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n5({9}^{2}-{({x}^{2})}^{2})=5(9+{x}^{2})(9-{x}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}5(9+{x}^{2})(9-{x}^{2}) & =5(9+{x}^{2})({3}^{2}-{x}^{2}) \\\\  & =5(9+{x}^{2})(3+x)(3-x)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2a88efbc-787f-5fb5-83b1-796e67980740"] :db/ensure [:question/validate]} {:db/id "answer-field-2a88efbc-787f-5fb5-83b1-796e67980740" :answer-field/id #uuid "2a88efbc-787f-5fb5-83b1-796e67980740" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-59ca59b3-bc66-5b41-a2e1-7c1ae9fe7294" :answer-field/choices ["answer-f1000809-2185-56a5-bdfc-7e3b96b60d0d" "answer-9dda105c-aa70-5651-a006-68417da9eb64" "answer-6d2fa2a2-76fd-5930-ad81-eaacf5fc4cf2" "answer-59ca59b3-bc66-5b41-a2e1-7c1ae9fe7294" "answer-9564c43f-732c-5b28-875b-f898f59a8974"] :db/ensure [:answer-field/validate]} {:db/id "answer-f1000809-2185-56a5-bdfc-7e3b96b60d0d" :answer/id #uuid "f1000809-2185-56a5-bdfc-7e3b96b60d0d" :answer/type :answer.type/math :answer/value "(3+5{x}^{2})(3-5x)" :db/ensure [:answer/validate]} {:db/id "answer-9dda105c-aa70-5651-a006-68417da9eb64" :answer/id #uuid "9dda105c-aa70-5651-a006-68417da9eb64" :answer/type :answer.type/math :answer/value "(9+{x}^{2})(3+x)(3-x)" :db/ensure [:answer/validate]} {:db/id "answer-6d2fa2a2-76fd-5930-ad81-eaacf5fc4cf2" :answer/id #uuid "6d2fa2a2-76fd-5930-ad81-eaacf5fc4cf2" :answer/type :answer.type/math :answer/value "5(9+x)(3+x)(3-x)" :db/ensure [:answer/validate]} {:db/id "answer-59ca59b3-bc66-5b41-a2e1-7c1ae9fe7294" :answer/id #uuid "59ca59b3-bc66-5b41-a2e1-7c1ae9fe7294" :answer/type :answer.type/math :answer/value "5(9+{x}^{2})(3+x)(3-x)" :db/ensure [:answer/validate]} {:db/id "answer-9564c43f-732c-5b28-875b-f898f59a8974" :answer/id #uuid "9564c43f-732c-5b28-875b-f898f59a8974" :answer/type :answer.type/math :answer/value "5(9+{x}^{2})(3-x)" :db/ensure [:answer/validate]} {:db/id 17592186078459 :knowledge-point/questions ["question-e8441a51-7883-5a5e-8db4-a90d1cf66e2c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e8441a51-7883-5a5e-8db4-a90d1cf66e2c" :question/id #uuid "e8441a51-7883-5a5e-8db4-a90d1cf66e2c" :question/math-academy-id "q-37704" :question/problem "Factor the expression $q-q{p}^{4}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $q.$ To simplify the computation, we can factor out the $q,$ as follows:\n\n$$\nq-q{p}^{4}=q(1-{p}^{4})\n$$\n\nThe expression in parenthesis can be written as a difference of squares:\n\n$$\nq(1-{p}^{4})=q({1}^{2}-{({p}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\nq({1}^{2}-{({p}^{2})}^{2})=q(1+{p}^{2})(1-{p}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}q(1+{p}^{2})(1-{p}^{2}) & =q(1+{p}^{2})({1}^{2}-{p}^{2}) \\\\  & =q(1+{p}^{2})(1+p)(1-p)\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b41f4802-1656-5ba5-847f-6205f19dba68"] :db/ensure [:question/validate]} {:db/id "answer-field-b41f4802-1656-5ba5-847f-6205f19dba68" :answer-field/id #uuid "b41f4802-1656-5ba5-847f-6205f19dba68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1650bfee-6d96-54e8-852e-43b6f64d4dc6" :answer-field/choices ["answer-b49a8467-4b46-5b5a-b841-8a75970290cc" "answer-df55db35-4751-5083-ab35-5e84e6e5d77b" "answer-1650bfee-6d96-54e8-852e-43b6f64d4dc6" "answer-90af1bab-a6dd-5030-b070-2e84c0e4c42e" "answer-cb74c517-de27-581f-addd-2aa201faca40"] :db/ensure [:answer-field/validate]} {:db/id "answer-b49a8467-4b46-5b5a-b841-8a75970290cc" :answer/id #uuid "b49a8467-4b46-5b5a-b841-8a75970290cc" :answer/type :answer.type/math :answer/value "(1+{p}^{2})(q+p)(q-p)" :db/ensure [:answer/validate]} {:db/id "answer-df55db35-4751-5083-ab35-5e84e6e5d77b" :answer/id #uuid "df55db35-4751-5083-ab35-5e84e6e5d77b" :answer/type :answer.type/math :answer/value "(q+{p}^{2})(1+p)(1-p)" :db/ensure [:answer/validate]} {:db/id "answer-1650bfee-6d96-54e8-852e-43b6f64d4dc6" :answer/id #uuid "1650bfee-6d96-54e8-852e-43b6f64d4dc6" :answer/type :answer.type/math :answer/value "q(1+{p}^{2})(1+p)(1-p)" :db/ensure [:answer/validate]} {:db/id "answer-90af1bab-a6dd-5030-b070-2e84c0e4c42e" :answer/id #uuid "90af1bab-a6dd-5030-b070-2e84c0e4c42e" :answer/type :answer.type/math :answer/value "q(1+{p}^{2})(1+p)^{2}" :db/ensure [:answer/validate]} {:db/id "answer-cb74c517-de27-581f-addd-2aa201faca40" :answer/id #uuid "cb74c517-de27-581f-addd-2aa201faca40" :answer/type :answer.type/math :answer/value "q(1+{p}^{2})(1-p)^{2}" :db/ensure [:answer/validate]} {:db/id "activity-eed68adb-a450-57b7-b0d5-8619e4e60ac4" :activity/id #uuid "eed68adb-a450-57b7-b0d5-8619e4e60ac4" :activity/title "Factoring Higher-Order Polynomials as a Difference of Squares" :activity/type :activity.type/review :activity/scope 17592186050307 :activity/course 17592186046647 :activity/steps ["step-3a47ef1d-656e-59aa-a1f2-1e451ba9cc9b" "step-11a4f52f-16a4-5b59-b64b-ade4253003f6" "step-242e6e23-2c2b-5bc2-a03d-30dec26a6ea4"] :activity/first-step "step-3a47ef1d-656e-59aa-a1f2-1e451ba9cc9b" :db/ensure [:activity/validate]} {:db/id "step-3a47ef1d-656e-59aa-a1f2-1e451ba9cc9b" :step/id #uuid "3a47ef1d-656e-59aa-a1f2-1e451ba9cc9b" :step/content "question-ea6c80e5-0a00-5798-9872-7c227f663338" :step/next "step-11a4f52f-16a4-5b59-b64b-ade4253003f6" :db/ensure [:step/validate]} {:db/id "step-11a4f52f-16a4-5b59-b64b-ade4253003f6" :step/id #uuid "11a4f52f-16a4-5b59-b64b-ade4253003f6" :step/content "question-9d1054aa-9f73-56ea-a93c-1d65449f0f07" :step/next "step-242e6e23-2c2b-5bc2-a03d-30dec26a6ea4" :db/ensure [:step/validate]} {:db/id "step-242e6e23-2c2b-5bc2-a03d-30dec26a6ea4" :step/id #uuid "242e6e23-2c2b-5bc2-a03d-30dec26a6ea4" :step/content "question-e8441a51-7883-5a5e-8db4-a90d1cf66e2c" :db/ensure [:step/validate]} {:db/id 17592186184197 :knowledge-point/questions ["question-66207faf-3d6b-5406-8c58-c05d9d84a48f" "question-1e0723ce-a987-5c3e-a185-24b9f3aa7c5c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-66207faf-3d6b-5406-8c58-c05d9d84a48f" :question/id #uuid "66207faf-3d6b-5406-8c58-c05d9d84a48f" :question/math-academy-id "q-95283" :question/problem "Which of the following statements are true?\n\nI. The matrix $A=[\\begin{aligned}-10 & 0 \\\\ 0 & 0\\end{aligned}]$ has one negative singular value.\n\nII. Any $2\\times 4$ matrix $A$ has at most $4$ distinct singular values.\n\nIII. Any $6\\times 3$ matrix $A$ has at most $6$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have any negative singular value.\n\n- Statement II is true. Indeed,  since $A$ is a $2\\times 4$ matrix and ${A}^{T}$ is a $4\\times 2$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 2}\\times {A}_{2\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement III is false. Since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a29f2b28-9204-5899-8070-b3f5ffe02498"] :db/ensure [:question/validate]} {:db/id "answer-field-a29f2b28-9204-5899-8070-b3f5ffe02498" :answer-field/id #uuid "a29f2b28-9204-5899-8070-b3f5ffe02498" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aa4333dc-3ea2-5e37-ab50-ec3e34c12a9e" :answer-field/choices ["answer-db2d98c7-af14-5f48-be6c-f11b82999c7b" "answer-1d848745-0d69-5731-947e-0a9ae11809b4" "answer-09638aaf-77e9-5651-870e-522b6cc8115f" "answer-aa4333dc-3ea2-5e37-ab50-ec3e34c12a9e" "answer-c588edce-5cf5-501a-93b4-d2734b483461"] :db/ensure [:answer-field/validate]} {:db/id "answer-db2d98c7-af14-5f48-be6c-f11b82999c7b" :answer/id #uuid "db2d98c7-af14-5f48-be6c-f11b82999c7b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-1d848745-0d69-5731-947e-0a9ae11809b4" :answer/id #uuid "1d848745-0d69-5731-947e-0a9ae11809b4" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-09638aaf-77e9-5651-870e-522b6cc8115f" :answer/id #uuid "09638aaf-77e9-5651-870e-522b6cc8115f" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-aa4333dc-3ea2-5e37-ab50-ec3e34c12a9e" :answer/id #uuid "aa4333dc-3ea2-5e37-ab50-ec3e34c12a9e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c588edce-5cf5-501a-93b4-d2734b483461" :answer/id #uuid "c588edce-5cf5-501a-93b4-d2734b483461" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-1e0723ce-a987-5c3e-a185-24b9f3aa7c5c" :question/id #uuid "1e0723ce-a987-5c3e-a185-24b9f3aa7c5c" :question/math-academy-id "q-95270" :question/problem "Which of the following statements are true?\n\nI. Any $3\\times 4$ matrix $A$ has at most $4$ distinct singular values.\n\nII. Any $8\\times 6$ matrix $A$ has at most $8$ distinct singular values.\n\nIII. The matrix $A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]$ has one negative singular value." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since $A$ is a $3\\times 4$ matrix and ${A}^{T}$ is a $4\\times 3$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 3}\\times {A}_{3\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement II is false. Since $A$ is a $8\\times 6$ matrix and ${A}^{T}$ is a $6\\times 8$ matrix, ${A}^{T}\\,A$ must be a $6\\times 6$ matrix: \n\n$$\n{{A}^{T}}_{6\\times 8}\\times {A}_{8\\times 6}={{A}^{T}\\,A}_{6\\times 6}\n$$\n\nHence, $A$ has at most $6$ distinct singular values.\n\n- Statement III is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have a negative singular value.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0c3c93af-58f9-530c-baad-0a629ae81ede"] :db/ensure [:question/validate]} {:db/id "answer-field-0c3c93af-58f9-530c-baad-0a629ae81ede" :answer-field/id #uuid "0c3c93af-58f9-530c-baad-0a629ae81ede" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-79ac5216-69de-5dc4-a92b-b636df49e5d3" :answer-field/choices ["answer-026e9975-ba0c-5eae-815a-fcd1e665b3d2" "answer-79ac5216-69de-5dc4-a92b-b636df49e5d3" "answer-7f21a217-b4f0-55ce-b377-f084a5b14d24" "answer-e014b07e-27e4-516d-adc5-1ef689408d39" "answer-c2c913d4-93f7-5765-8bb6-090f7d52622b"] :db/ensure [:answer-field/validate]} {:db/id "answer-026e9975-ba0c-5eae-815a-fcd1e665b3d2" :answer/id #uuid "026e9975-ba0c-5eae-815a-fcd1e665b3d2" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-79ac5216-69de-5dc4-a92b-b636df49e5d3" :answer/id #uuid "79ac5216-69de-5dc4-a92b-b636df49e5d3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-7f21a217-b4f0-55ce-b377-f084a5b14d24" :answer/id #uuid "7f21a217-b4f0-55ce-b377-f084a5b14d24" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-e014b07e-27e4-516d-adc5-1ef689408d39" :answer/id #uuid "e014b07e-27e4-516d-adc5-1ef689408d39" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c2c913d4-93f7-5765-8bb6-090f7d52622b" :answer/id #uuid "c2c913d4-93f7-5765-8bb6-090f7d52622b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186185322 :tutorial/content "Recall that the singular values of a real matrix $A$ are the square roots of the eigenvalues of the matrix $A^T \\! A.$\n\nAlso, since $A^T \\! A$ is a positive semi-definite matrix, the eigenvalues of $A^T \\! A$ must be always non-negative real numbers.\n\nLet's compute the singular values of the matrix $A,$ given by \n\n![](images/a9/a9edbe1fee59758c9557d95ea8f62468f9f3cb98449c437a274bdbf5c30f7dc6.svg)\n\nNow, since\n\n- $A$ is a $3 \\times 2$ matrix, and\n\n- $A^T$ is a $2 \\times 3$ matrix,\n\nthen $A^T \\! A$  must be a $2 \\times 2$ matrix:\n\n$$\n\\underset{\\bbox[Gainsboro, 2pt]{\\large 2} \\times {\\large 3}}{A^T} \\times \\underset{{\\large 3} \\times \\bbox[Gainsboro, 2pt]{\\large 2}}{A} = \n\\underset{\\bbox[Gainsboro, 2pt]{\\large 2} \\times \\bbox[Gainsboro, 2pt]{\\large 2}}{A^T \\! A}\n$$\n\nLet's now compute our singular values. First, we calculate $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}{A}^{T}\\,A & ={[\\begin{aligned}\\,0 & \\,2 \\\\ \\,\\,-2 & \\,0 \\\\ 2 & 1\\end{aligned}]}^{T}[\\begin{aligned}\\,0 & \\,2 \\\\ \\,\\,-2 & \\,0 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 & 2 \\\\ 2 & 0 & 1\\end{aligned}][\\begin{aligned}\\,0 & \\,2 \\\\ \\,\\,-2 & \\,0 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 2 \\\\ 2 & 5\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the eigenvalues of $A^T \\! A\\mathbin{:}$\n\n$$\n\\begin{aligned}|{A}^{T}\\,A-\\lambda I| & =0 \\\\ |\\begin{aligned}8-\\lambda  & 2 \\\\ 2 & 5-\\lambda \\end{aligned}| & =0 \\\\ (8-\\lambda )(5-\\lambda )-4 & =0 \\\\ {\\lambda }^{2}-13\\lambda +36 & =0 \\\\ (\\lambda -9)(\\lambda -4) & =0 \\\\ \\lambda  & =9,\\,4\\end{aligned}\n$$\n\nTherefore, the singular values of $A$ are as follows:\n\n$$\n\\begin{aligned}{\\sigma }_{1} & =\\sqrt{{\\lambda }_{1}}=\\sqrt{9}=3 \\\\ {\\sigma }_{2} & =\\sqrt{{\\lambda }_{2}}=\\sqrt{4}=2\\end{aligned}\n$$\n\nNote the following:\n\n- When listing the singular values of a matrix, we usually write them in descending order.\n\n- If $A$ is a $m\\times n$ matrix, then $A^T A$ is a $n\\times n$ positive semi-definite matrix. This means that $A$ has *at most* $n$ distinct singular values." :db/ensure [:tutorial/validate]} {:db/id 17592186365845 :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}-20\\lambda {y}^{′}+100{\\lambda }^{2}y=0,\\,y(0)=0,\\,y\\,(\\frac{1}{2})+{y}^{′}\\,(\\frac{1}{2})=0,\\,0\\le x\\le \\frac{1}{2},\\,\\lambda \\in R.\n$$\n\nFind the eigenvalues and eigenfunctions of this problem. Assume that $B$ and $C$ are constants.\n\n$\\,$ The eigenvalues are $\\lambda =$ {{field-1}}.\n\n$\\,$ The eigenfunctions are $y=$ {{field-2}}." :db/ensure [:question/validate]} {:db/id 17592186166940 :knowledge-point/questions ["question-648c7fb6-34ca-53e3-ba2b-a6cf79213062"] :db/ensure [:knowledge-point/validate]} {:db/id "question-648c7fb6-34ca-53e3-ba2b-a6cf79213062" :question/id #uuid "648c7fb6-34ca-53e3-ba2b-a6cf79213062" :question/math-academy-id "q-338913" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+49{\\lambda }^{2}y=0,\\,{y}^{′}(0)={y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" :question/worked-solution "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions ${y}^{′}(0)={y}^{′}(2)=0$ yields $A=0.$ Thus, we have a nontrivial solution, so $\\lambda =0$ is a parameter corresponding to the eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+49{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 7\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(7\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(7\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x)+B\\operatorname{sin}⁡(7\\lambda x).\n$$\n\nDifferentiating gives\n\n$$\n{y}^{′}=-7A\\lambda \\operatorname{sin}⁡(7\\lambda x)+7B\\lambda \\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(0)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(0)+7B\\lambda \\operatorname{cos}⁡(0)=0\n$$\n\nwhich gives $B=0.$ So, we have\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(2)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(14\\lambda )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n14\\lambda =n\\pi \n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{n\\pi }{14}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9c89b6fc-2543-5375-ab12-8c5c3b4ded4d" "answer-field-9f0c0ee2-17d3-59de-a732-734f1a510b76"] :db/ensure [:question/validate]} {:db/id "answer-field-9c89b6fc-2543-5375-ab12-8c5c3b4ded4d" :answer-field/id #uuid "9c89b6fc-2543-5375-ab12-8c5c3b4ded4d" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-f0ba5cbd-77f0-51e1-853b-981e94517aea" :answer-field/choices ["answer-1b77aee6-038f-5fb6-8e37-86b0bbba4aba" "answer-f0ba5cbd-77f0-51e1-853b-981e94517aea" "answer-a65b53c3-6b83-58ec-ab00-d0e3e1f10487" "answer-0e71254c-e0c3-52aa-adb5-692437b5a10e" "answer-17c609b3-a070-57e3-b76f-89aea6bb093e"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b77aee6-038f-5fb6-8e37-86b0bbba4aba" :answer/id #uuid "1b77aee6-038f-5fb6-8e37-86b0bbba4aba" :answer/type :answer.type/math :answer/value "\\frac{7n\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-f0ba5cbd-77f0-51e1-853b-981e94517aea" :answer/id #uuid "f0ba5cbd-77f0-51e1-853b-981e94517aea" :answer/type :answer.type/math :answer/value "\\frac{n\\pi }{14}" :db/ensure [:answer/validate]} {:db/id "answer-a65b53c3-6b83-58ec-ab00-d0e3e1f10487" :answer/id #uuid "a65b53c3-6b83-58ec-ab00-d0e3e1f10487" :answer/type :answer.type/math :answer/value "\\frac{n\\pi }{7}" :db/ensure [:answer/validate]} {:db/id "answer-0e71254c-e0c3-52aa-adb5-692437b5a10e" :answer/id #uuid "0e71254c-e0c3-52aa-adb5-692437b5a10e" :answer/type :answer.type/math :answer/value "\\frac{n}{14}" :db/ensure [:answer/validate]} {:db/id "answer-17c609b3-a070-57e3-b76f-89aea6bb093e" :answer/id #uuid "17c609b3-a070-57e3-b76f-89aea6bb093e" :answer/type :answer.type/math :answer/value "\\frac{n}{7}" :db/ensure [:answer/validate]} {:db/id "answer-field-9f0c0ee2-17d3-59de-a732-734f1a510b76" :answer-field/id #uuid "9f0c0ee2-17d3-59de-a732-734f1a510b76" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4aa47990-58f3-5096-8b77-8c4ac5b32a12" :answer-field/choices ["answer-4aa47990-58f3-5096-8b77-8c4ac5b32a12" "answer-b1218580-144b-5528-875c-a87a479b27f5" "answer-9c089454-6485-5a34-8c18-f408f079ca03" "answer-809028e1-3f32-54af-9337-604142d70915" "answer-bd81cd0e-c825-53fe-8a34-c3d587ddcf8e" "answer-d1d5e092-eb0f-57a1-9f9e-03c7c474790a"] :db/ensure [:answer-field/validate]} {:db/id "answer-4aa47990-58f3-5096-8b77-8c4ac5b32a12" :answer/id #uuid "4aa47990-58f3-5096-8b77-8c4ac5b32a12" :answer/type :answer.type/math :answer/value "{B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x)" :db/ensure [:answer/validate]} {:db/id "answer-b1218580-144b-5528-875c-a87a479b27f5" :answer/id #uuid "b1218580-144b-5528-875c-a87a479b27f5" :answer/type :answer.type/math :answer/value "{B}_{n}\\operatorname{cos}⁡(\\frac{{\\lambda