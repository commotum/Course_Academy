e62"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110492 :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left( \\dfrac{a}{b} \\right)\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get\n\n$$\n\\begin{aligned}2{log}_{2}⁡(25)-2{log}_{2}⁡(5) & =2({log}_{2}⁡(25)-{log}_{2}⁡(5)) \\\\  & =2({log}_{2}⁡(\\frac{25}{5})) \\\\  & =2{log}_{2}⁡(5).\\end{aligned}\n$$\n\nTherefore,\n\n$$\n2\\log_2(25) - 2\\log_2(5) = 2\\log_2(5).\n$$" :db/ensure [:question/validate]} {:db/id 17592186110589 :knowledge-point/questions ["question-20936b5f-864e-5ae6-90f1-dfba78a6f020"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110490 :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n\\log_n(a) - \\log_n(b) = \\log_n\\left( \\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}{log}_{3}⁡(\\frac{2}{5}) & ={log}_{3}⁡(2)-{log}_{3}⁡(5).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186110592 :knowledge-point/questions ["question-ada9c1dd-522d-5138-9cfe-44ee7af19872" "question-99f3a3dc-a29b-56b3-b6b2-eb00c09e4e97"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186110493 :question/worked-solution "First, let's recall the quotient rule for natural logarithms:\n\n$$\n\\ln(a) - \\ln(b) = \\ln\\left( \\dfrac{a}{b} \\right)\n$$\n\nUsing the quotient rule for natural logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{p}{q}) & =\\operatorname{ln}⁡(p)-\\operatorname{ln}⁡(q) \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186111055 :question/problem "Express ${log}_{2}⁡({x}^{3})-{log}_{2}⁡(x)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as:\n\n$$\n\\begin{aligned}{log}_{2}⁡({x}^{3})-{log}_{2}⁡(x) & ={log}_{2}⁡(\\frac{{x}^{3}}{x}) \\\\  & ={log}_{2}⁡({x}^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186108087 :answer-field/correct "answer-d83c88c8-1213-5064-9f38-c3cdba0753f1" :answer-field/choices ["answer-586a7d70-5172-59a1-9741-2c4ca73c06b6" "answer-d83c88c8-1213-5064-9f38-c3cdba0753f1" "answer-af492c68-51a5-5572-bb8d-b7ffebbda341" "answer-027931f1-c81a-5437-9a6a-eaecb93a762a" "answer-87cfe6cf-ae32-54c0-8cf9-e7edf787bdc3"] :db/ensure [:answer-field/validate]} {:db/id "answer-586a7d70-5172-59a1-9741-2c4ca73c06b6" :answer/id #uuid "586a7d70-5172-59a1-9741-2c4ca73c06b6" :answer/type :answer.type/math :answer/value "{log}_{2}⁡(x)" :db/ensure [:answer/validate]} {:db/id "answer-d83c88c8-1213-5064-9f38-c3cdba0753f1" :answer/id #uuid "d83c88c8-1213-5064-9f38-c3cdba0753f1" :answer/type :answer.type/math :answer/value "{log}_{2}⁡({x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-af492c68-51a5-5572-bb8d-b7ffebbda341" :answer/id #uuid "af492c68-51a5-5572-bb8d-b7ffebbda341" :answer/type :answer.type/math :answer/value "{log}_{2}⁡({x}^{3})" :db/ensure [:answer/validate]} {:db/id "answer-027931f1-c81a-5437-9a6a-eaecb93a762a" :answer/id #uuid "027931f1-c81a-5437-9a6a-eaecb93a762a" :answer/type :answer.type/math :answer/value "{log}_{2}⁡({x}^{3}+x)" :db/ensure [:answer/validate]} {:db/id "answer-87cfe6cf-ae32-54c0-8cf9-e7edf787bdc3" :answer/id #uuid "87cfe6cf-ae32-54c0-8cf9-e7edf787bdc3" :answer/type :answer.type/math :answer/value "{log}_{2}⁡({x}^{3}-x)" :db/ensure [:answer/validate]} {:db/id "question-15c5c76c-d78d-5592-bdec-a5d9824a4594" :question/id #uuid "15c5c76c-d78d-5592-bdec-a5d9824a4594" :question/math-academy-id "q-66765" :question/problem "Express ${log}_{2}⁡(7)-{log}_{2}⁡(5)$ as a single logarithm." :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as:\n\n$$\n{log}_{2}⁡(7)-{log}_{2}⁡(5)={log}_{2}⁡(\\frac{7}{5})\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-92823537-f145-578d-8121-413772b2c835"] :db/ensure [:question/validate]} {:db/id "answer-field-92823537-f145-578d-8121-413772b2c835" :answer-field/id #uuid "92823537-f145-578d-8121-413772b2c835" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18804b67-878e-56f2-a908-9dd72d5c6203" :answer-field/choices ["answer-9eff8071-7a7a-58ad-9478-1815b1968cb1" "answer-846f084c-4d8e-5b3c-94e0-bd4bc2d3d3de" "answer-74910754-3a09-5360-8578-a6e630ecceac" "answer-b99e14c7-a03d-57b7-b791-a59cc36431e5" "answer-18804b67-878e-56f2-a908-9dd72d5c6203"] :db/ensure [:answer-field/validate]} {:db/id "answer-9eff8071-7a7a-58ad-9478-1815b1968cb1" :answer/id #uuid "9eff8071-7a7a-58ad-9478-1815b1968cb1" :answer/type :answer.type/math :answer/value "\\operatorname{log}⁡(2)" :db/ensure [:answer/validate]} {:db/id "answer-846f084c-4d8e-5b3c-94e0-bd4bc2d3d3de" :answer/id #uuid "846f084c-4d8e-5b3c-94e0-bd4bc2d3d3de" :answer/type :answer.type/math :answer/value "\\operatorname{log}⁡(35)" :db/ensure [:answer/validate]} {:db/id "answer-74910754-3a09-5360-8578-a6e630ecceac" :answer/id #uuid "74910754-3a09-5360-8578-a6e630ecceac" :answer/type :answer.type/math :answer/value "{log}_{2}⁡(2)" :db/ensure [:answer/validate]} {:db/id "answer-b99e14c7-a03d-57b7-b791-a59cc36431e5" :answer/id #uuid "b99e14c7-a03d-57b7-b791-a59cc36431e5" :answer/type :answer.type/math :answer/value "{log}_{2}⁡(35)" :db/ensure [:answer/validate]} {:db/id "answer-18804b67-878e-56f2-a908-9dd72d5c6203" :answer/id #uuid "18804b67-878e-56f2-a908-9dd72d5c6203" :answer/type :answer.type/math :answer/value "{log}_{2}⁡(\\frac{7}{5})" :db/ensure [:answer/validate]} {:db/id 17592186234207 :question/problem "$6{log}_{5}⁡(100)-6{log}_{5}⁡(4)=$" :question/worked-solution "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get:\n\n$$\n\\begin{aligned}6{log}_{5}⁡(100)-6{log}_{5}⁡(4) & =6({log}_{5}⁡(100)-{log}_{5}⁡(4)) \\\\  & =6{log}_{5}⁡(\\frac{100}{4}) \\\\  & =6{log}_{5}⁡(25)\\end{aligned}\n$$\n\nNow, since ${5}^{2}=25$, then ${log}_{5}⁡(25)={log}_{5}⁡({5}^{2})=2.$ Therefore:\n\n$$\n6{log}_{5}⁡(25)=6\\cdot 2=12.\n$$" :question/answer-fields ["answer-field-51e26732-12ca-5a69-9f16-67129aa50da4"] :db/ensure [:question/validate]} {:db/id "answer-field-51e26732-12ca-5a69-9f16-67129aa50da4" :answer-field/id #uuid "51e26732-12ca-5a69-9f16-67129aa50da4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-28ec0d1a-fbc1-5041-8e40-636cd7efa33f" :answer-field/choices ["answer-f507a8d2-4685-5d46-9b8b-f4be0c73f455" "answer-28ec0d1a-fbc1-5041-8e40-636cd7efa33f" "answer-4cc1e664-6c62-5c39-b7eb-8b0cdd0da386" "answer-bf0a2323-dacf-55d7-8bd0-de0f8bb99950" "answer-4ecfee0c-ab43-511e-bbf7-24b4470eee72"] :db/ensure [:answer-field/validate]} {:db/id "answer-f507a8d2-4685-5d46-9b8b-f4be0c73f455" :answer/id #uuid "f507a8d2-4685-5d46-9b8b-f4be0c73f455" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-28ec0d1a-fbc1-5041-8e40-636cd7efa33f" :answer/id #uuid "28ec0d1a-fbc1-5041-8e40-636cd7efa33f" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-4cc1e664-6c62-5c39-b7eb-8b0cdd0da386" :answer/id #uuid "4cc1e664-6c62-5c39-b7eb-8b0cdd0da386" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-bf0a2323-dacf-55d7-8bd0-de0f8bb99950" :answer/id #uuid "bf0a2323-dacf-55d7-8bd0-de0f8bb99950" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db