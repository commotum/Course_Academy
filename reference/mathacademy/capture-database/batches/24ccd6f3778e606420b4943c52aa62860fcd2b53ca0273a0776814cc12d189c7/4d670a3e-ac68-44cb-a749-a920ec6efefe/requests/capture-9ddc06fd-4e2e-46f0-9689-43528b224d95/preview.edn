5417 true] [17592186543467 1075 #edb/ref 17592186543242 13194139535925 17592186045417 true] [17592186543467 1076 #edb/ref 17592186045492 13194139535925 17592186045417 true] [17592186543467 1077 "field-2" 13194139535925 17592186045417 true] [17592186543467 1078 #edb/ref 17592186543242 13194139535925 17592186045417 true] [17592186543467 1079 #uuid "fa17f357-450d-5ebf-a036-6faafdfbae46" 13194139535925 17592186045417 true] [17592186543468 1075 #edb/ref 17592186542634 13194139535925 17592186045417 true] [17592186543468 1075 #edb/ref 17592186542740 13194139535925 17592186045417 true] [17592186543468 1075 #edb/ref 17592186543100 13194139535925 17592186045417 true] [17592186543468 1075 #edb/ref 17592186543140 13194139535925 17592186045417 true] [17592186543468 1076 #edb/ref 17592186045494 13194139535925 17592186045417 true] [17592186543468 1077 "field-4" 13194139535925 17592186045417 true] [17592186543468 1078 #edb/ref 17592186542634 13194139535925 17592186045417 true] [17592186543468 1079 #uuid "ffeb5c19-09f0-5528-a066-b2ec8f17f60c" 13194139535925 17592186045417 true] [17592186543469 1068 #edb/ref 17592186543358 13194139535925 17592186045417 true] [17592186543469 1069 "q-281742" 13194139535925 17592186045417 true] [17592186543469 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543469 1071 "If the polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-3,\\sqrt{3}),$  then $k=${{field-1}}." 13194139535925 17592186045417 true] [17592186543469 1072 #uuid "0054ec1e-580f-564e-8493-248291e1368b" 13194139535925 17592186045417 true] [17592186543469 1074 "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-3)}^{2}+{(\\sqrt{3})}^{2}} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|\\frac{\\sqrt{3}}{-3}| \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(2\\sqrt{3},\\frac{5\\pi }{6}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}2\\sqrt{3} & =k\\operatorname{cos}⁡\\theta  \\\\ 2\\sqrt{3} & =k\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\ 2\\sqrt{3} & =k(-\\frac{\\sqrt{3}}{2}) \\\\ k & =-4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/de/def95f29f6397b0f6eab20afb6327d8f3f99fdc52fbeac0b0c2af8b228d060a9.png)" 13194139535925 17592186045417 true] [17592186543470 1068 #edb/ref 17592186543400 13194139535925 17592186045417 true] [17592186543470 1068 #edb/ref 17592186543414 13194139535925 17592186045417 true] [17592186543470 1069 "q-337265" 13194139535925 17592186045417 true] [17592186543470 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543470 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\sqrt{7}\\operatorname{sin}⁡x$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$ \n{{field-1}}$\\,{x}_{2}=$ \n{{field-2}}." 13194139535925 17592186045417 true] [17592186543470 1072 #uuid "0135fc07-6118-52f5-9b57-2dcf9eca07ac" 13194139535925 17592186045417 true] [17592186543470 1074 "First, we factor the equation:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x\\operatorname{cos}⁡x & =\\sqrt{7}\\operatorname{sin}⁡x \\\\ \\operatorname{sin}⁡x\\operatorname{cos}⁡x-\\sqrt{7}\\operatorname{sin}⁡x & =0 \\\\ \\operatorname{sin}⁡x(\\operatorname{cos}⁡x-\\sqrt{7}) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{sin}⁡x=0,\\,\\operatorname{cos}⁡x-\\sqrt{7}=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sin}⁡x=0.$ The solutions to this equation for $0\\le x<2\\pi $ are $x=0,\\,\\pi .$\n\n- Then, we solve $\\operatorname{cos}⁡x-\\sqrt{7}=0,$ or equivalently $\\operatorname{cos}⁡x=\\sqrt{7}.$ But since $|\\operatorname{cos}⁡x|\\le 1,$ then $\\operatorname{cos}⁡x=\\sqrt{7}$ has no solution.\n\nArranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}=0,\\,{x}_{2}=\\pi .\n$$" 13194139535925 17592186045417 true] [17592186543471 1068 #edb/ref 17592186543335 13194139535925 17592186045417 true] [17592186543471 1068 #edb/ref 17592186543369 13194139535925 17592186045417 true] [17592186543471 1068 #edb/ref 17592186543395 13194139535925 17592186045417 true] [17592186543471 1069 "q-336702" 13194139535925 17592186045417 true] [17592186543471 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543471 1071 "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from line $\\text{L1}$ by {{field-1}} both sides of  the equation.\n\n$\\,$ Line $\\text{L5}$ follows from lines {{field-2}} by substitution.\n\n$\\,$ Line $\\text{L8}$ is obtained by substituting {{field-3}} into $\\text{L1}.$" 13194139535925 17592186045417 true] [17592186543471 1072 #uuid "026f1da3-fe0b-5238-91da-8230388ad940" 13194139535925 17592186045417 true] [17592186543471 1074 "Let's examine each statement in turn.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ To get $\\text{L2},$ we are $\\text{differentiating}$ with respect to $t$ both sides of the equation in $\\text{L1}:$\n\n$$\n\\begin{aligned}{x}_{p}^{′}(t) & =(Φu(t))^{′} \\\\ {x}_{p}^{′}(t) & =Φ{u}^{′}(t)+{Φ}^{′}u(t)\\end{aligned}\n$$\n\n- Next, we consider lines $\\text{L3}$, $\\text{L4},$ and $\\text{L5}.$ Let's substitute ${Φ}^{′}=AΦ$ from $\\text{L4}$ into $\\text{L3}:$\n\n$$\n\\begin{aligned}Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t) \\\\ Φ{u}^{′}(t)+\\cancel{AΦu(t)}=\\cancel{AΦu(t)}+f(t) \\\\ Φ{u}^{′}(t)=f(t)\\end{aligned}\n$$\n\nTherefore, $\\text{L5}$ follows from $\\text{L3}\\text{ and }\\text{L4}$ by substitution.\n\n- Finally, we consider lines $\\text{L1},$ $\\text{L7},$ and $\\text{L8}.$ Substituting\n\n$$\nu(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t\n$$\n\nfrom $\\text{L7}$ into $\\text{L1},$ we get\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φu(t) \\\\  & =Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ is obtained by substituting $\\text{L7}$ into $\\text{L1}.$" 13194139535925 17592186045417 true] [17592186543472 1068 #edb/ref 17592186543368 13194139535925 17592186045417 true] [17592186543472 1069 "q-25145" 13194139535925 17592186045417 true] [17592186543472 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543472 1071 "Find the value of ${log}_{z}⁡(512)$ if ${log}_{z}⁡(8)=0.3.$" 13194139535925 17592186045417 true] [17592186543472 1072 #uuid "03b07b19-1587-5e10-a223-7c9ddb411106" 13194139535925 17592186045417 true] [17592186543472 1074 "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms and the information given, we get:\n\n$$\n\\begin{aligned}{log}_{z}⁡(512) & ={log}_{z}⁡({8}^{3}) \\\\  & =3\\cdot {log}_{z}⁡(8) \\\\  & =3\\cdot 0.3 \\\\  & =0.9\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543473 1068 #edb/ref 17592186543372 13194139535925 17592186045417 true] [17592186543473 1068 #edb/ref 17592186543384 13194139535925 17592186045417 true] [17592186543473 1069 "q-335497" 13194139535925 17592186045417 true] [17592186543473 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543473 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $3\\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘})+\\frac{3}{2}=0,$ for $0\\le x<{360}^{∘},$  are\n\n${x}_{1}=$\n {{field-1}}${}^{∘},\\,{x}_{2}=$ \n{{field-2}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543473 1072 #uuid "0663d30d-9045-55b3-9c5e-7d0dcf4eda51" 13194139535925 17592186045417 true] [17592186543473 1074 "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}3\\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘})+\\frac{3}{2} & =0 \\\\ 3\\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘}) & =-\\frac{3}{2} \\\\ \\operatorname{cos}⁡(\\frac{3x}{2}-{60}^{∘}) & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}\\frac{3x}{2}-{60}^{∘} & ={120}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & \\frac{3x}{2}-{60}^{∘} & ={240}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}\\frac{3x}{2} & ={120}^{∘}+{60}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{3x}{2} & ={240}^{∘}+{60}^{∘}+n\\cdot {360}^{∘} \\\\ \\frac{3x}{2} & ={180}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{3x}{2} & ={300}^{∘}+n\\cdot {360}^{∘} \\\\ 3x & ={360}^{∘}+n\\cdot {720}^{∘} & \\, & \\, & 3x & ={600}^{∘}+n\\cdot {720}^{∘} \\\\ x & ={120}^{∘}+n\\cdot {240}^{∘} & \\, & \\, & x & ={200}^{∘}+n\\cdot {240}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain\n$0\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={120}^{∘},$ and $x={200}^{∘}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<{360}^{∘}.$\n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}={120}^{∘},\\,{x}_{2}={200}^{∘}.\n$$" 13194139535925 17592186045417 true] [17592186543474 1068 #edb/ref 17592186543455 13194139535925 17592186045417 true] [17592186543474 1069 "q-17277" 13194139535925 17592186045417 true] [17592186543474 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543474 1071 "![](images/97/97b246abafb0152ac4f36d3d71476664cfb687fedaae62fc854aad4113a6b082.png)\n\nWhat is the polar equation of the curve shown above?" 13194139535925 17592186045417 true] [17592186543474 1072 #uuid "06dd95dd-7aca-5dd6-bbfa-f6a3626f7868" 13194139535925 17592186045417 true] [17592186543474 1074 "The diagram shows a circle of radius $|a|=|-4.5|=4.5$ centered at the point $(-4.5,0).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{cos}⁡\\theta  \\\\  & =2\\cdot (-4.5)\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =-9\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543475 1068 #edb/ref 17592186543461 13194139535925 17592186045417 true] [17592186543475 1069 "q-16296" 13194139535925 17592186045417 true] [17592186543475 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543475 1071 "$(6-9\\,\\text{i})(6+9\\,\\text{i})=$" 13194139535925 17592186045417 true] [17592186543475 1072 #uuid "079ed9ef-ed52-5aa5-892f-741aff5b9f4c" 13194139535925 17592186045417 true] [17592186543475 1074 "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(6-9\\,\\text{i})(6+9\\,\\text{i}) & =6\\cdot 6+6\\cdot 9\\,\\text{i}+(-9\\,\\text{i})\\cdot 6+(-9\\,\\text{i})\\cdot 9\\,\\text{i} \\\\  & =36+54\\,\\text{i}-54\\,\\text{i}-81\\,{\\text{i}}^{2} \\\\  & =36-81\\cdot (-1) \\\\  & =36+81 \\\\  & =117.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543476 1068 #edb/ref 17592186543297 13194139535925 17592186045417 true] [17592186543476 1069 "q-102233" 13194139535925 17592186045417 true] [17592186543476 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543476 1071 "Find the $x$-coordinate of the point on the curve $y=2{x}^{2}-2$ whose tangent has a slope of $2.$" 13194139535925 17592186045417 true] [17592186543476 1072 #uuid "0be8176c-dc51-5ee3-ab7e-f7738c95222f" 13194139535925 17592186045417 true] [17592186543476 1074 "Let $f(x)=2{x}^{2}-2.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}-2) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({x}^{2})-2\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =2\\cdot 2x-0 \\\\  & =4x.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=2$ and solve for $x:$\n\n$$\n\\begin{aligned}4x & =2 \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $2$ at the point where $x=\\frac{1}{2}.$" 13194139535925 17592186045417 true] [17592186543477 1068 #edb/ref 17592186543338 13194139535925 17592186045417 true] [17592186543477 1069 "q-340284" 13194139535925 17592186045417 true] [17592186543477 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543477 1071 "Given that $f(x)=\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." 13194139535925 17592186045417 true] [17592186543477 1072 #uuid "0f325821-aed1-5216-b5a3-ffaf528190d5" 13194139535925 17592186045417 true] [17592186543477 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5)-3\\cdot {2}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡(5))-\\frac{\\text{d}}{\\text{d}x}(3\\cdot {2}^{x}) \\\\  & =0-3\\frac{\\text{d}}{\\text{d}x}({2}^{x}) \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(-3\\operatorname{ln}⁡(2)\\cdot {2}^{x})|}_{x=1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot {2}^{1} \\\\  & =-3\\operatorname{ln}⁡(2)\\cdot 2 \\\\  & =-6\\operatorname{ln}⁡(2).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543478 1068 #edb/ref 17592186543329 13194139535925 17592186045417 true] [17592186543478 1069 "q-90672" 13194139535925 17592186045417 true] [17592186543478 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543478 1071 "Given that $X$ is a random variable such that $X∼U[-14,-12],$ find $\\text{Var}[X].$" 13194139535925 17592186045417 true] [17592186543478 1072 #uuid "0fcd3eab-4854-55ff-b2c1-1082ea396d46" 13194139535925 17592186045417 true] [17592186543478 1074 "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-14$ and $b=-12.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(-12-(-14))^{2}}{12}=\\frac{4}{12}=\\frac{1}{3}.\n$$" 13194139535925 17592186045417 true] [17592186543479 1068 #edb/ref 17592186543389 13194139535925 17592186045417 true] [17592186543479 1069 "q-66765" 13194139535925 17592186045417 true] [17592186543479 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543479 1071 "Express ${log}_{2}⁡(7)-{log}_{2}⁡(5)$ as a single logarithm." 13194139535925 17592186045417 true] [17592186543479 1072 #uuid "15c5c76c-d78d-5592-bdec-a5d9824a4594" 13194139535925 17592186045417 true] [17592186543479 1074 "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, the given expression can be rewritten as:\n\n$$\n{log}_{2}⁡(7)-{log}_{2}⁡(5)={log}_{2}⁡(\\frac{7}{5})\n$$" 13194139535925 17592186045417 true] [17592186543480 1068 #edb/ref 17592186543406 13194139535925 17592186045417 true] [17592186543480 1069 "q-10494" 13194139535925 17592186045417 true] [17592186543480 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543480 1071 "Calculate the points where the hyperbola\n$\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16}=1$\nintersects the line $x=-4.$" 13194139535925 17592186045417 true] [17592186543480 1072 #uuid "1a906e6f-23fd-5f8d-83eb-286b57e0e8a7" 13194139535925 17592186045417 true] [17592186543480 1074 "To find the points where the hyperbola intersects the line $x=-4,$ we substitute $x=-4$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{y}^{2}}{8}-\\frac{(-4)^{2}}{16} & =1 \\\\ \\frac{{y}^{2}}{8}-1 & =1 \\\\ \\frac{{y}^{2}}{8} & =1+1 \\\\ \\frac{{y}^{2}}{8} & =2 \\\\ {y}^{2} & =16 \\\\ y & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line  $x=-4$ at the points $(-4,\\pm 4).$" 13194139535925 17592186045417 true] [17592186543481 1068 #edb/ref 17592186543312 13194139535925 17592186045417 true] [17592186543481 1068 #edb/ref 17592186543314 13194139535925 17592186045417 true] [17592186543481 1069 "q-355845" 13194139535925 17592186045417 true] [17592186543481 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543481 1071 "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}-0.6 & -0.95 & -1.02 \\\\ 0.79 & 0.33 & 1.56 \\\\ -1.48 & -1.17 & -0.66 \\\\ 0.67 & 0.8 & -0.15 \\\\ 0.63 & 0.99 & 0.27\\end{aligned}]\n$$\n\nwhere the data has been standardized (the mean of each feature is $0$ and the standard deviation is $1$).\nWe are also given the SVD decomposition $X=UΣ{V}^{T}$ where:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}-0.462 & 0.174 & -0.685 & 0.1 & 0.527 \\\\ 0.473 & -0.718 & -0.24 & 0.358 & 0.272 \\\\ -0.613 & -0.29 & 0.546 & 0.457 & 0.181 \\\\ 0.253 & 0.517 & -0.053 & 0.798 & -0.17 \\\\ 0.35 & 0.319 & 0.416 & -0.127 & 0.766\\end{aligned}] \\\\ Σ & =[\\begin{aligned}3.171 & 0 & 0 \\\\ 0 & 1.32 & 0 \\\\ 0 & 0 & 0.477 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}] \\\\ V & =[\\begin{aligned}0.615 & 0.231 & -0.754 \\\\ 0.587 & 0.505 & 0.633 \\\\ 0.527 & -0.832 & 0.175\\end{aligned}]\\end{aligned}\n$$\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components.\n\nWe should pick components based on \n{{field-1}}.\n\nIf we wish to preserve $95%$ of the variance, we should reduce the dataset to \n{{field-2}}." 13194139535925 17592186045417 true] [17592186543481 1072 #uuid "1c7b66a2-e4ef-5d7b-9466-353945dad93a" 13194139535925 17592186045417 true] [17592186543481 1074 "In reducing the dimensionality of the dataset, we aim to preserve as much of the original variance as possible. \n\nWe should pick components based on $\\text{the amount of cumulative variance preserved}.$\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\nIn our example, the singular values are\n\n$$\n{\\sigma }_{1}=3.171,\\,{\\sigma }_{2}=1.32,\\,{\\sigma }_{3}=0.477.\n$$\n\nLet us now compute the cumulative variance preserved for different numbers of components.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{\\sigma }_{1}^{2}}{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}=\\frac{{3.171}^{2}}{{3.171}^{2}+{1.32}^{2}+{0.477}^{2}}≈83.6%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{2}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}=\\frac{{3.171}^{2}+{1.32}^{2}}{{3.171}^{2}+{1.32}^{2}+{0.477}^{2}}≈98.1%.\n$$\n\nThus, we obtain that\n\n- reducing the dataset to $1$ dimension would preserve $83.6%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $98.1%$ of the variance.\n\n![](images/1d/1d967881aaa7c2a7cd7f537d70d3637edae36b3edf62e15ac67949925d5ee2ef.png)\n\nTherefore, we should reduce the dataset to $2\\text{ dimensions},$ since this is the minimum number of components that preserves at least $95%$ of the variance." 13194139535925 17592186045417 true] [17592186543482 1068 #edb/ref 17592186543298 13194139535925 17592186045417 true] [17592186543482 1069 "q-95270" 13194139535925 17592186045417 true] [17592186543482 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543482 1071 "Which of the following statements are true?\n\nI. Any $3\\times 4$ matrix $A$ has at most $4$ distinct singular values.\n\nII. Any $8\\times 6$ matrix $A$ has at most $8$ distinct singular values.\n\nIII. The matrix $A=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]$ has one negative singular value." 13194139535925 17592186045417 true] [17592186543482 1072 #uuid "1e0723ce-a987-5c3e-a185-24b9f3aa7c5c" 13194139535925 17592186045417 true] [17592186543482 1074 "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since $A$ is a $3\\times 4$ matrix and ${A}^{T}$ is a $4\\times 3$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 3}\\times {A}_{3\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement II is false. Since $A$ is a $8\\times 6$ matrix and ${A}^{T}$ is a $6\\times 8$ matrix, ${A}^{T}\\,A$ must be a $6\\times 6$ matrix: \n\n$$\n{{A}^{T}}_{6\\times 8}\\times {A}_{8\\times 6}={{A}^{T}\\,A}_{6\\times 6}\n$$\n\nHence, $A$ has at most $6$ distinct singular values.\n\n- Statement III is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have a negative singular value.\n\nTherefore, the correct answer is \"I only.\"" 13194139535925 17592186045417 true] [17592186543483 1068 #edb/ref 17592186543294 13194139535925 17592186045417 true] [17592186543483 1069 "q-47257" 13194139535925 17592186045417 true] [17592186543483 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543483 1071 "${log}_{3}⁡(\\frac{x}{y})=$" 13194139535925 17592186045417 true] [17592186543483 1072 #uuid "20936b5f-864e-5ae6-90f1-dfba78a6f020" 13194139535925 17592186045417 true] [17592186543483 1074 "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, we obtain:\n\n$$\n\\begin{aligned}{log}_{3}⁡(\\frac{x}{y}) & ={log}_{3}⁡(x)-{log}_{3}⁡(y)\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543484 1068 #edb/ref 17592186543380 13194139535925 17592186045417 true] [17592186543484 1069 "q-82331" 13194139535925 17592186045417 true] [17592186543484 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543484 1071 "![](images/1d/1dd38a3d7e9969b9cc74c043261fd2f4d3ee1c1293a623fd812e31256b4ec766.png)\n\nThe graph above shows the curve $y=2\\operatorname{cos}⁡x\\operatorname{sin}⁡x$ and the curve $y=-\\operatorname{cos}⁡x$ on the interval ${0}^{∘}<x<{360}^{∘}.$ The curves intersect at the points $A,B,C$ and $D$, as shown. Find the product of the $x$-coordinates of $B$ and $D.$" 13194139535925 17592186045417 true] [17592186543484 1072 #uuid "22a4714b-c9b9-595d-bd56-cdf122336677" 13194139535925 17592186045417 true] [17592186543484 1074 "At the intersection points, the $y$ values of both graphs are the same. This gives \nthe equation $2\\operatorname{cos}⁡x\\operatorname{sin}⁡x=-\\operatorname{cos}⁡x.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡x\\operatorname{sin}⁡x & =-\\operatorname{cos}⁡x \\\\ 2\\operatorname{cos}⁡x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x & =0 \\\\ \\operatorname{cos}⁡x(2\\operatorname{sin}⁡x+1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{cos}⁡x=0,\\,2\\operatorname{sin}⁡x+1=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{cos}⁡x=0.$ The solutions to this equation for ${0}^{∘}<x<{360}^{∘}$ are $x={90}^{∘},\\,{270}^{∘}.$\n\n- Then, we solve $2\\operatorname{sin}⁡x+1=0,$ or equivalently $\\operatorname{sin}⁡x=-\\frac{1}{2}.$ The solutions to this equation for ${0}^{∘}<x<{360}^{∘}$ are $x={210}^{∘},\\,{330}^{∘}.$\n\nCombining all solutions from both equations, we get\n\n$$\n{x}_{1}={90}^{∘},\\,{x}_{2}={210}^{∘},\\,{x}_{3}={270}^{∘},\\,{x}_{4}={330}^{∘}.\n$$\n\nFinally, the product of the $x$-coordinates of $B$ and $D$ is \n\n$$\n210\\cdot 330=69\\,300.\n$$" 13194139535925 17592186045417 true] [17592186543485 1068 #edb/ref 17592186543438 13194139535925 17592186045417 true] [17592186543485 1069 "q-79508" 13194139535925 17592186045417 true] [17592186543485 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543485 1071 "Which of the sequences below are geometric sequences?\n\nI. $-3,\\,33,\\,-363,\\,…$\n\nII. $4,\\,52,\\,572,\\,…$\n\nIII. $-2,\\,24,\\,-312,\\,…$" 13194139535925 17592186045417 true] [17592186543485 1072 #uuid "28e7f38a-8ff9-507f-8c27-7cd729b83484" 13194139535925 17592186045417 true] [17592186543485 1074 "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{33}{(-3)}=-11 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-363)}{33}=-11\\end{aligned}\n$$\n\n- Sequence II is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{52}{4}=13 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{572}{52}=11\\end{aligned}\n$$\n\n- Sequence III is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{24}{(-2)}=-12 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-312)}{24}=-13\\end{aligned}\n$$\n\nIn conclusion, only sequence I could be a geometric sequence." 13194139535925 17592186045417 true] [17592186543486 1068 #edb/ref 17592186543373 13194139535925 17592186045417 true] [17592186543486 1069 "q-16471" 13194139535925 17592186045417 true] [17592186543486 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543486 1071 "Which of the following is the graph of the polar curve $r=-5\\operatorname{cos}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543486 1072 #uuid "290754c3-90f1-5be3-bcd9-34d500e1127f" 13194139535925 17592186045417 true] [17592186543486 1074 "The polar equation $r=2a\\operatorname{cos}⁡\\theta $ defines a circle of radius $a$ centered at the point $(a,0).$\n\nIn our case, we have $r=-5\\operatorname{cos}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{(-5)}{2}=-\\frac{5}{2}.\n$$\n\nTherefore, the equation $r=-5\\operatorname{cos}⁡\\theta $ gives a circle of radius $|-2.5|=2.5$ centered at the point $(-2.5,0),$ as shown below.\n\n![](images/02/02093df668e46e73e5204c8d971d06eb99a2e8ee8d33666573a8bea4b62e890b.png)" 13194139535925 17592186045417 true] [17592186543487 1068 #edb/ref 17592186543465 13194139535925 17592186045417 true] [17592186543487 1069 "q-1101" 13194139535925 17592186045417 true] [17592186543487 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543487 1071 "$\\operatorname{log}⁡(\\frac{3y}{\\sqrt{x}})=$" 13194139535925 17592186045417 true] [17592186543487 1072 #uuid "2c8cf324-472b-5836-8692-8d44663200a5" 13194139535925 17592186045417 true] [17592186543487 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(\\frac{3y}{\\sqrt{x}}) & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡(\\sqrt{x}) \\\\  & =\\operatorname{log}⁡(3y)-\\operatorname{log}⁡({x}^{1/2}) \\\\  & =\\operatorname{log}⁡(3y)-\\frac{1}{2}\\operatorname{log}⁡(x).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543488 1068 #edb/ref 17592186543305 13194139535925 17592186045417 true] [17592186543488 1069 "q-102235" 13194139535925 17592186045417 true] [17592186543488 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543488 1071 "Find the $x$-coordinate of the point on the curve $y={x}^{2}+2x+1$ whose tangent has a slope of $-2.$" 13194139535925 17592186045417 true] [17592186543488 1072 #uuid "2d253a70-5faa-50fb-9a2a-215f206560d5" 13194139535925 17592186045417 true] [17592186543488 1074 "Let $f(x)={x}^{2}+2x+1.$ The slope of the tangent at the point $x$ is equal to ${f}^{′}(x).$ Computing the derivative, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+2x+1) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+2\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(1) \\\\  & =2x+2\\cdot 1+0 \\\\  & =2x+2.\\end{aligned}\n$$\n\nWe now set ${f}^{′}(x)=-2$ and solve for $x:$\n\n$$\n\\begin{aligned}2x+2 & =-2 \\\\ 2x & =-2-2 \\\\ 2x & =-4 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the slope of the tangent is equal to $-2$ at the point where $x=-2.$" 13194139535925 17592186045417 true] [17592186543489 1068 #edb/ref 17592186543398 13194139535925 17592186045417 true] [17592186543489 1069 "q-281737" 13194139535925 17592186045417 true] [17592186543489 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543489 1071 "If the polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-3,-3),$  then $k=${{field-1}}." 13194139535925 17592186045417 true] [17592186543489 1072 #uuid "2e8e220e-5d02-535f-8203-20819203c421" 13194139535925 17592186045417 true] [17592186543489 1074 "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(3)}^{2}+{(3)}^{2}} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the third quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi +\\operatorname{arctan}⁡|\\frac{-3}{-3}| \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(3\\sqrt{2},\\frac{5\\pi }{4}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 3\\sqrt{2} & =k\\operatorname{cos}⁡(\\frac{5\\pi }{4}) \\\\ 3\\sqrt{2} & =k(-\\frac{1}{\\sqrt{2}}) \\\\ k & =-6\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-6\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/72/72cb94d6ed11f7502e7810d7d201ba71e594ed97a7a3eadd789732ca3dcb8968.png)" 13194139535925 17592186045417 true] [17592186543490 1068 #edb/ref 17592186543444 13194139535925 17592186045417 true] [17592186543490 1069 "q-45533" 13194139535925 17592186045417 true] [17592186543490 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543490 1071 "What is the solution to  $2\\cdot {8}^{y}=\\frac{1}{4}?$" 13194139535925 17592186045417 true] [17592186543490 1072 #uuid "3044149e-5bfc-5de0-b490-60c442d8ed07" 13194139535925 17592186045417 true] [17592186543490 1074 "First, we isolate the term with the variable exponent by dividing both sides by $2$:\n\n$$\n\\begin{aligned}2\\cdot {8}^{y} & =\\frac{1}{4} \\\\ \\frac{2\\cdot {8}^{y}}{2} & =\\frac{(\\frac{1}{4})}{2} \\\\ {8}^{y} & =\\frac{1}{8}\\end{aligned}\n$$\n\nNow, we rewrite $\\frac{1}{8}$ as ${8}^{-1}$ to get:\n\n$$\n\\begin{aligned}{8}^{y} & =\\frac{1}{8} \\\\ {8}^{y} & ={8}^{-1}\\end{aligned}\n$$\n\nFinally, since both sides of the equation share the same base $(8)$, we equate the exponents:\n\n$$\n\\begin{aligned}{8}^{y} & ={8}^{-1} \\\\ y & =-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=-1.$" 13194139535925 17592186045417 true] [17592186543491 1068 #edb/ref 17592186543423 13194139535925 17592186045417 true] [17592186543491 1069 "q-66923" 13194139535925 17592186045417 true] [17592186543491 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543491 1071 "${log}_{2}⁡(\\frac{\\sqrt{x}{y}^{2}}{z})=$" 13194139535925 17592186045417 true] [17592186543491 1072 #uuid "34847574-efca-5670-8924-e70a3bcc31ce" 13194139535925 17592186045417 true] [17592186543491 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get\n\n$$\n{log}_{2}⁡(\\frac{\\sqrt{x}{y}^{2}}{z})={log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z).\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{2}⁡(\\sqrt{x}{y}^{2})-{log}_{2}⁡(z)={log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{2}⁡(\\sqrt{x})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) & ={log}_{2}⁡({x}^{1/2})+{log}_{2}⁡({y}^{2})-{log}_{2}⁡(z) \\\\  & =\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\\end{aligned}\n$$\n\nTherefore\n\n$$\n{log}_{2}⁡(\\frac{\\sqrt{x}{y}^{2}}{z})=\\frac{1}{2}{log}_{2}⁡(x)+2{log}_{2}⁡(y)-{log}_{2}⁡(z).\n$$" 13194139535925 17592186045417 true] [17592186543492 1068 #edb/ref 17592186543382 13194139535925 17592186045417 true] [17592186543492 1068 #edb/ref 17592186543419 13194139535925 17592186045417 true] [17592186543492 1068 #edb/ref 17592186543464 13194139535925 17592186045417 true] [17592186543492 1069 "q-336263" 13194139535925 17592186045417 true] [17592186543492 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543492 1071 "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from line $\\text{L1}$ by {{field-1}} both sides of  the equation.\n\n$\\,$ Line $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into the {{field-2}}.\n\n$\\,$ Line $\\text{L4}$ follows from the fact that {{field-3}} matrix." 13194139535925 17592186045417 true] [17592186543492 1072 #uuid "3ff1006e-e8fc-5000-8f28-c2da87881b92" 13194139535925 17592186045417 true] [17592186543492 1074 "Let's examine each statement in turn.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ To get $\\text{L2},$ we are $\\text{differentiating}$ with respect to $t$ both sides of the equation in $\\text{L1}:$\n\n$$\n\\begin{aligned}{x}_{p}^{′}(t) & =(Φu(t))^{′} \\\\ {x}_{p}^{′}(t) & =Φ{u}^{′}(t)+{Φ}^{′}u(t)\\end{aligned}\n$$\n\n- Next, we consider lines $\\text{L1},$ $\\text{L2},$ and $\\text{L3}.$ Let's substitute ${x}_{p}(t)=Φu(t)$ from $\\text{L1}$ and ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$ from $\\text{L2}$ into the initial system of ODEs:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =Ax(t)+f(t) \\\\ Φ{u}^{′}(t)+{Φ}^{′}u(t) & =AΦu(t)+f(t)\\end{aligned}\n$$\n\nTherefore, $\\text{L3}$ is obtained by substituting $\\text{L1}$ and $\\text{L2}$ into $\\text{initial system of ODEs}.$\n\n- Finally we consider line $\\text{L4}.$ Since $Φ$ is a fundamental matrix, its columns are solutions to the homogeneous system ${x}^{′}(t)=Ax(t),$ i.e., by substituting any column $c(t)$ of $Φ$ into the homogeneous system, we get\n\n$$\n{c}^{′}(t)=Ac(t),\n$$\n\nwhere ${c}^{′}(t)$ is the corresponding column of derivatives in $Φ.$ As a result, this means that ${Φ}^{′}=AΦ.$ Therefore, $\\text{L4}$ follows from the fact that $Φ\\text{ is a fundamental}$ matrix." 13194139535925 17592186045417 true] [17592186543493 1068 #edb/ref 17592186543295 13194139535925 17592186045417 true] [17592186543493 1068 #edb/ref 17592186543304 13194139535925 17592186045417 true] [17592186543493 1068 #edb/ref 17592186543405 13194139535925 17592186045417 true] [17592186543493 1068 #edb/ref 17592186543468 13194139535925 17592186045417 true] [17592186543493 1069 "q-336712" 13194139535925 17592186045417 true] [17592186543493 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543493 1071 "Consider the following system of differential equations:\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nUsing the method of variation of parameters, we wish to find a particular solution in the form ${x}_{p}(t)=Φu(t),$ where $Φ$ is a fundamental matrix for the corresponding homogeneous system and $u(t)$ is a column vector of functions to be determined. A derivation of the formula for ${x}_{p}(t)$ is given below. \n\n$\\text{L1}:\\,$ ${x}_{p}(t)=Φu(t)$\n\n$\\text{L2}:\\,$ ${x}_{p}^{′}(t)=Φ{u}^{′}(t)+{Φ}^{′}u(t)$\n\n$\\text{L3}:\\,$ $Φ{u}^{′}(t)+{Φ}^{′}u(t)=AΦu(t)+f(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}=AΦ$\n\n$\\text{L5}:\\,$ $Φ{u}^{′}(t)=f(t)$\n\n$\\text{L6}:\\,$ ${u}^{′}(t)={Φ}^{-1}(t)f(t)$\n\n$\\text{L7}:\\,$ $u(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\n$\\text{L8}:\\,$ ${x}_{p}(t)=Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L4}$ follows from the fact that {{field-1}} matrix.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by {{field-2}} both sides of the equation.\n\n$\\,$ Line $\\text{L8}$ is obtained by substituting {{field-3}} into {{field-4}}." 13194139535925 17592186045417 true] [17592186543493 1072 #uuid "41ff18d2-5493-53b7-9e77-82f1434ea309" 13194139535925 17592186045417 true] [17592186543493 1074 "Let's examine each statement in turn.\n\n- We first we consider line $\\text{L4}.$ Since $Φ$ is a fundamental matrix, its columns are solutions to the homogeneous system ${x}^{′}(t)=Ax(t),$ i.e., by substituting any column $c(t)$ of $Φ$ into the homogeneous system, we get\n\n$$\n{c}^{′}(t)=Ac(t),\n$$\n\nwhere ${c}^{′}(t)$ is the corresponding column of derivatives in $Φ.$ As a result, this means that ${Φ}^{′}=AΦ.$ Therefore, $\\text{L4}$ follows from the fact that $Φ\\text{ is a fundamental}$ matrix.\n\n- Next, we consider lines $\\text{L6}$ and $\\text{L7}.$ To get $\\text{L7},$ we are $\\text{integrating}$ both sides of the equation in $\\text{L6}:$\n\n$$\n\\begin{aligned}\\int {u}^{′}(t)\\,\\text{d}t & =\\int {Φ}^{-1}(t)f(t)\\,\\text{d}t \\\\ u(t) & =\\int {Φ}^{-1}f(t)\\,\\text{d}t\\end{aligned}\n$$\n\n- Finally, we consider lines $\\text{L1},$ $\\text{L7},$ and $\\text{L8}.$ Substituting\n\n$$\nu(t)=\\int {Φ}^{-1}f(t)\\,\\text{d}t\n$$\n\nfrom $\\text{L7}$ into $\\text{L1},$ we get\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φu(t) \\\\  & =Φ\\int {Φ}^{-1}f(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore, $\\text{L8}$ is obtained by substituting $\\text{L7}$ into $\\text{L1}.$" 13194139535925 17592186045417 true] [17592186543494 1068 #edb/ref 17592186543408 13194139535925 17592186045417 true] [17592186543494 1069 "q-65968" 13194139535925 17592186045417 true] [17592186543494 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543494 1071 "Consider the equation $\\operatorname{cos}⁡2x=-\\frac{1}{2}$ for ${0}^{∘}\\le x<{360}^{∘}.$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order,  what is the numerical value of ${x}_{1}\\cdot {x}_{3}?$" 13194139535925 17592186045417 true] [17592186543494 1072 #uuid "44457776-708f-510a-afa3-90718ee8b770" 13194139535925 17592186045417 true] [17592186543494 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x & ={120}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & 2x & ={240}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{{120}^{∘}}{2}+\\frac{n\\cdot {360}^{∘}}{2} & \\, & \\, & x & =\\frac{{240}^{∘}}{2}+\\frac{n\\cdot {360}^{∘}}{2} \\\\ x & ={60}^{∘}+n\\cdot {180}^{∘} & \\, & \\, & x & ={120}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={60}^{∘}$ and $x={120}^{∘}$\n\n- Setting $n=1$ gives $x={240}^{∘}$ and $x={300}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ So, the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ (written in ascending order) are\n\n$$\nx={60}^{∘},\\,{120}^{∘},\\,{240}^{∘},\\,{300}^{∘}\n$$\n\nFinally, since ${x}_{1}={60}^{∘}$ and ${x}_{3}={240}^{∘},$ the numerical value of ${x}_{1}\\cdot {x}_{3}$ is $60\\cdot 240=14\\,400.$" 13194139535925 17592186045417 true] [17592186543495 1068 #edb/ref 17592186543323 13194139535925 17592186045417 true] [17592186543495 1068 #edb/ref 17592186543409 13194139535925 17592186045417 true] [17592186543495 1068 #edb/ref 17592186543432 13194139535925 17592186045417 true] [17592186543495 1069 "q-335765" 13194139535925 17592186045417 true] [17592186543495 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543495 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $4\\operatorname{cos}⁡(3x+{30}^{∘})-2=0,$ for ${0}^{∘}\\le x<{360}^{∘},$ are ${x}_{1},{x}_{2},{x}_{3},{x}_{4},{x}_{5},$ and ${x}_{6}.$ Determine ${x}_{2},$ ${x}_{4},$ and ${x}_{6}.$\n\n$\\,{x}_{2}=$ \n{{field-1}}${}^{∘},\\,{x}_{4}=$ \n{{field-2}}${}^{∘},\\,{x}_{6}=$ \n{{field-3}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543495 1072 #uuid "468c5cf8-2c4e-5dd6-96eb-d94e2d3f4648" 13194139535925 17592186045417 true] [17592186543495 1074 "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}4\\operatorname{cos}⁡(3x+{30}^{∘})-2 & =0 \\\\ 4\\operatorname{cos}⁡(3x+{30}^{∘}) & =2 \\\\ \\operatorname{cos}⁡(3x+{30}^{∘}) & =\\frac{1}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}3x+{30}^{∘} & ={60}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & 3x+{30}^{∘} & ={300}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}3x & ={60}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 3x & ={300}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} \\\\ 3x & ={30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 3x & ={270}^{∘}+n\\cdot {360}^{∘} \\\\ x & ={10}^{∘}+n\\cdot {120}^{∘} & \\, & \\, & x & ={90}^{∘}+n\\cdot {120}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={10}^{∘}$ and $x={90}^{∘}.$\n\n- Setting $n=1$ gives $x={130}^{∘}$ and $x={210}^{∘}.$\n\n- Setting $n=2$ gives $x={250}^{∘}$ and $x={330}^{∘}.$\n\nAll other integer values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$  \n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}={10}^{∘},\\,{x}_{2}={90}^{∘},\\,{x}_{3}={130}^{∘},\\,{x}_{4}={210}^{∘},\\,{x}_{5}={250}^{∘},\\,{x}_{6}={330}^{∘}.\n$$" 13194139535925 17592186045417 true] [17592186543496 1068 #edb/ref 17592186543355 13194139535925 17592186045417 true] [17592186543496 1069 "q-159947" 13194139535925 17592186045417 true] [17592186543496 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543496 1071 "Suppose ${X}_{1},{X}_{2},…,{X}_{10}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},…,{x}_{10},$ you're given that \n\n$$\n{\\sum }_{i=1}^{10}{x}_{i}=41.2,\\,{\\sum }_{i=1}^{10}{x}_{i}^{2}=182.6.\n$$\n\n \nGiven that the log-likelihood function of the sample is\n\n$$\nl(\\theta )=-5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2},\n$$\n\nwhat is the value of $a+b+c?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and standard deviation $1$ is given by* \n\n$$\nf(x)=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" 13194139535925 17592186045417 true] [17592186543496 1072 #uuid "47a49d65-e85d-5b9b-a8c6-e21bc37526ef" 13194139535925 17592186045417 true] [17592186543496 1074 "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=10$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nWe are told that ${\\sum }_{i=1}^{10}{x}_{i}=41.2,$ ${\\sum }_{i=1}^{10}{x}_{i}^{2}=182.6,$ and $n=10.$ Therefore, \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{10}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(182.6-2\\theta \\cdot 41.2+10{\\theta }^{2}) \\\\  & =-5\\operatorname{ln}⁡(2\\pi )+(-91.3)+41.2\\theta +(-5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=(-91.3)+41.2+(-5)=-55.1.\n$$" 13194139535925 17592186045417 true] [17592186543497 1068 #edb/ref 17592186543424 13194139535925 17592186045417 true] [17592186543497 1069 "q-340277" 13194139535925 17592186045417 true] [17592186543497 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543497 1071 "Given that $f(x)=3\\cdot {4}^{x}-2{e}^{x}$, the slope of the tangent at $x=1$ is{{field-1}}." 13194139535925 17592186045417 true] [17592186543497 1072 #uuid "47d673bd-5b90-569f-9bcd-5db84649c548" 13194139535925 17592186045417 true] [17592186543497 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x}-2{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3\\cdot {4}^{x})-\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}({4}^{x})-2\\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(3\\operatorname{ln}⁡(4)\\cdot {4}^{x}-2{e}^{x})|}_{x=1} \\\\  & =3\\operatorname{ln}⁡(4)\\cdot {4}^{1}-2{e}^{1} \\\\  & =12\\operatorname{ln}⁡(4)-2e.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543498 1068 #edb/ref 17592186543339 13194139535925 17592186045417 true] [17592186543498 1069 "q-79403" 13194139535925 17592186045417 true] [17592186543498 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543498 1071 "Express $4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y)$ as a single logarithm." 13194139535925 17592186045417 true] [17592186543498 1072 #uuid "49c1090f-0d14-5ccb-9c30-a8b9c4fffd87" 13194139535925 17592186045417 true] [17592186543498 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}4\\operatorname{ln}⁡(x)-2\\operatorname{ln}⁡(y) & =\\operatorname{ln}⁡({x}^{4})-\\operatorname{ln}⁡({y}^{2}) \\\\  & =\\operatorname{ln}⁡(\\frac{{x}^{4}}{{y}^{2}}).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543499 1068 #edb/ref 17592186543293 13194139535925 17592186045417 true] [17592186543499 1068 #edb/ref 17592186543299 13194139535925 17592186045417 true] [17592186543499 1068 #edb/ref 17592186543370 13194139535925 17592186045417 true] [17592186543499 1068 #edb/ref 17592186543433 13194139535925 17592186045417 true] [17592186543499 1069 "q-337256" 13194139535925 17592186045417 true] [17592186543499 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543499 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\sqrt{3}\\operatorname{sin}⁡x$ for $-\\pi \\le x<\\pi ,$  are\n\n${x}_{1}=$ \n{{field-1}}$\\,{x}_{2}=$ \n{{field-2}}$\\,{x}_{3}=$ \n{{field-3}}$\\,{x}_{4}=$ \n{{field-4}}." 13194139535925 17592186045417 true] [17592186543499 1072 #uuid "49fd94b7-d87e-5482-b74a-14a44acf4a47" 13194139535925 17592186045417 true] [17592186543499 1074 "First, we factor the equation:\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡x\\operatorname{cos}⁡x & =\\sqrt{3}\\operatorname{sin}⁡x \\\\ 2\\operatorname{sin}⁡x\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x & =0 \\\\ \\operatorname{sin}⁡x(2\\operatorname{cos}⁡x-\\sqrt{3}) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{sin}⁡x=0,\\,2\\operatorname{cos}⁡x-\\sqrt{3}=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sin}⁡x=0.$ The solutions to this equation for $-\\pi \\le x<\\pi $ are $x=-\\pi ,\\,0.$\n\n- Then, we solve $2\\operatorname{cos}⁡x-\\sqrt{3}=0,$ or equivalently $\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.$ The solutions to this equation for $-\\pi \\le x<\\pi $ are $x=-\\frac{\\pi }{6},\\,\\frac{\\pi }{6}.$\n\nArranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}=-\\pi ,\\,{x}_{2}=-\\frac{\\pi }{6},\\,{x}_{3}=0,\\,{x}_{4}=\\frac{\\pi }{6}.\n$$" 13194139535925 17592186045417 true] [17592186543500 1068 #edb/ref 17592186543322 13194139535925 17592186045417 true] [17592186543500 1069 "q-23987" 13194139535925 17592186045417 true] [17592186543500 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543500 1071 "Consider the equation $\\operatorname{cos}⁡x(2\\operatorname{sin}⁡x-1)=0$ for ${0}^{∘}\\le x\\le {180}^{∘}.$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ are written in ascending order, then what is the numerical value of ${x}_{1}\\cdot {x}_{3}?$" 13194139535925 17592186045417 true] [17592186543500 1072 #uuid "4a638344-d920-5adc-900d-8c273723b689" 13194139535925 17592186045417 true] [17592186543500 1074 "By the zero-product property, we have to solve two equations: \n\n$$\n\\operatorname{cos}⁡x=0,\\,2\\operatorname{sin}⁡x-1=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{cos}⁡x=0.$ The solution to this equation for ${0}^{∘}\\le x\\le {180}^{∘}$  is $x={90}^{∘}.$\n\n- Then, we solve $2\\operatorname{sin}⁡x-1=0,$ or equivalently $\\operatorname{sin}⁡x=\\frac{1}{2}.$ The solutions to this equation for ${0}^{∘}\\le x\\le {180}^{∘}$ are $x={30}^{∘},{150}^{∘}.$\n\nCombining all solutions from both equations, we get\n\n$$\n{x}_{1}={30}^{∘},\\,{x}_{2}={90}^{∘},\\,{x}_{3}={150}^{∘}.\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{3}=30\\cdot 150=4\\,500.\n$$" 13194139535925 17592186045417 true] [17592186543501 1068 #edb/ref 17592186543377 13194139535925 17592186045417 true] [17592186543501 1069 "q-75176" 13194139535925 17592186045417 true] [17592186543501 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543501 1071 "Let $R=[1,4]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)=x+2y-3.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3,4\\},\\,{P}_{2}=\\{2,3,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" 13194139535925 17592186045417 true] [17592186543501 1072 #uuid "4bd06db2-69af-51a2-9fd5-21474b678038" 13194139535925 17592186045417 true] [17592186543501 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/89/89c82b8d1f3eaf79c7df0a67f377a240a949dda328cd2f448370077d2871c244.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\n\\begin{aligned}U(f,P) & ={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{31}\\cdot \\text{Area}({R}_{31}) \\\\  & \\,+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22})+{M}_{32}\\cdot \\text{Area}({R}_{32}),\\end{aligned}\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=1$ for all $6$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\nU(f,P)={M}_{11}+{M}_{21}+{M}_{31}+{M}_{12}+{M}_{22}+{M}_{32}.\n$$\n\nNow, notice that\n\n- $f(x,y)=x+2y-3$ increases as $x$ increases, and\n\n- $f(x,y)=x+2y-3$ increases as $y$ increases.\n\n![](images/78/7888eaa17b26267cc8bed166500ba504fe5a893b30eb90876f2074520e28e8ba.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *largest* possible $x$ and the *largest* possible $y.$ This is the value at the *top right corner* of each subregion.\n\n![](images/ea/eadef808ebc8ff5503de8cefbbbf3a1d64bf3149f0c0c80166c891550ddee91d.png)\n\nHence,\n\n$$\n\\begin{aligned}{M}_{11} & =f(2,3)=5 \\\\ {M}_{21} & =f(3,3)=6 \\\\ {M}_{31} & =f(4,3)=7 \\\\ {M}_{12} & =f(2,4)=7 \\\\ {M}_{22} & =f(3,4)=8 \\\\ {M}_{32} & =f(4,4)=9\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =5+6+7+7+8+9 \\\\  & =42.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543502 1068 #edb/ref 17592186543320 13194139535925 17592186045417 true] [17592186543502 1069 "q-100242" 13194139535925 17592186045417 true] [17592186543502 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543502 1071 "$\\operatorname{ln}⁡(\\frac{ex}{5})=$" 13194139535925 17592186045417 true] [17592186543502 1072 #uuid "4d345e50-4921-588f-ae74-039f20e6e137" 13194139535925 17592186045417 true] [17592186543502 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{ex}{5}) & =\\operatorname{ln}⁡(ex)-\\operatorname{ln}⁡(5) \\\\  & =\\operatorname{ln}⁡(e)+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5) \\\\  & =1+\\operatorname{ln}⁡(x)-\\operatorname{ln}⁡(5).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543503 1068 #edb/ref 17592186543345 13194139535925 17592186045417 true] [17592186543503 1069 "q-16297" 13194139535925 17592186045417 true] [17592186543503 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543503 1071 "$(3+7\\,\\text{i})(3+3\\,\\text{i})=$" 13194139535925 17592186045417 true] [17592186543503 1072 #uuid "553ad9a0-8f10-59ef-ab22-b325bd3075cb" 13194139535925 17592186045417 true] [17592186543503 1074 "Multiplying two complex numbers is similar to multiplying two binomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(3+7\\,\\text{i})(3+3\\,\\text{i}) & =3\\cdot 3+3\\cdot 3\\,\\text{i}+7\\,\\text{i}\\cdot 3+7\\,\\text{i}\\cdot 3\\,\\text{i} \\\\  & =9+9\\,\\text{i}+21\\,\\text{i}+21\\,{\\text{i}}^{2} \\\\  & =9+30\\,\\text{i}+21\\cdot (-1) \\\\  & =9+30\\,\\text{i}-21 \\\\  & =-12+30\\,\\text{i}.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543504 1068 #edb/ref 17592186543457 13194139535925 17592186045417 true] [17592186543504 1069 "q-121513" 13194139535925 17592186045417 true] [17592186543504 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543504 1071 "Consider the equation $\\operatorname{cos}⁡(\\frac{3x}{2})=-\\frac{1}{2}$ for ${0}^{∘}\\le x<{360}^{∘}.$ If the solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ are written in ascending order,  what is the numerical value of ${x}_{1}+{x}_{3}?$" 13194139535925 17592186045417 true] [17592186543504 1072 #uuid "597abfab-9fa0-5884-9650-9d3a1ca7b418" 13194139535925 17592186045417 true] [17592186543504 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}\\frac{3x}{2} & ={120}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & \\frac{3x}{2} & ={240}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}3x & ={240}^{∘}+n\\cdot {720}^{∘} & \\, & \\, & 3x & ={480}^{∘}+n\\cdot {720}^{∘} \\\\ x & =\\frac{{240}^{∘}}{3}+\\frac{n\\cdot {720}^{∘}}{3} & \\, & \\, & x & =\\frac{{480}^{∘}}{3}+\\frac{n\\cdot {720}^{∘}}{3} \\\\ x & ={80}^{∘}+n\\cdot {240}^{∘} & \\, & \\, & x & ={160}^{∘}+n\\cdot {240}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={80}^{∘}$ and $x={160}^{∘}$\n\n- Setting $n=1$ gives $x={320}^{∘}$ and $x={400}^{∘}.$ We reject the solution ${400}^{∘}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ So, the solutions ${x}_{1},{x}_{2}$ and ${x}_{3}$ (written in ascending order) are\n\n$$\nx={80}^{∘},\\,{160}^{∘},\\,{320}^{∘}\n$$\n\nFinally, since ${x}_{1}={80}^{∘}$ and ${x}_{3}={320}^{∘},$ the numerical value of ${x}_{1}\\text{ }+{x}_{3}$ is $80+320=400.$" 13194139535925 17592186045417 true] [17592186543505 1068 #edb/ref 17592186543321 13194139535925 17592186045417 true] [17592186543505 1069 "q-159960" 13194139535925 17592186045417 true] [17592186543505 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543505 1071 "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $0.5,\\,-0.8,\\,-1.3$ is\n\n$$\nl(\\theta )=-1.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" 13194139535925 17592186045417 true] [17592186543505 1072 #uuid "5c4c55fe-2946-5795-a8c6-76c349270710" 13194139535925 17592186045417 true] [17592186543505 1074 "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.5+(-0.8)+(-1.3) \\\\  & =-1.6 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.5)^{2}+(-0.8)^{2}+(-1.3)^{2} \\\\  & =2.58\\end{aligned}\n$$\n\nand $n=3.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{3}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(2.58-2\\theta \\cdot (-1.6)+3{\\theta }^{2}) \\\\  & =-1.5\\operatorname{ln}⁡(2\\pi )+(-1.29)+(-1.6)\\theta +(-1.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-1.29+(-1.6)+(-1.5)=-4.39.\n$$" 13194139535925 17592186045417 true] [17592186543506 1068 #edb/ref 17592186543436 13194139535925 17592186045417 true] [17592186543506 1069 "q-24178" 13194139535925 17592186045417 true] [17592186543506 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543506 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\sqrt{3}\\operatorname{cos}⁡x\\operatorname{tan}⁡x+3\\operatorname{cos}⁡x=0$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139535925 17592186045417 true] [17592186543506 1072 #uuid "5c63aa2a-bac5-5697-a40d-14aec41163e5" 13194139535925 17592186045417 true] [17592186543506 1074 "Note that the function $\\operatorname{tan}⁡x$ is not defined at $x={90}^{∘},\\,{270}^{∘}.$ \n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}\\sqrt{3}\\operatorname{cos}⁡x\\operatorname{tan}⁡x+3\\operatorname{cos}⁡x & =0 \\\\ \\operatorname{cos}⁡x(\\sqrt{3}\\operatorname{tan}⁡x+3) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n\\operatorname{cos}⁡x=0,\\,\\sqrt{3}\\operatorname{tan}⁡x+3=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{cos}⁡x=0.$ The solutions to this equation for ${0}^{∘}\\le x<{360}^{∘}$  are $x={90}^{∘},\\,{270}^{∘}.$\n\n- Then, we solve $\\sqrt{3}\\operatorname{tan}⁡x+3=0,$ or equivalently $\\operatorname{tan}⁡x=-\\sqrt{3}.$ The solutions to this equation for ${0}^{∘}\\le x<{360}^{∘}$ are $x={120}^{∘},\\,{300}^{∘}.$\n\nTaking into account that ${90}^{∘},\\,{270}^{∘}$ are excluded values, and combining all solutions from both equations, we get\n\n$$\n{x}_{1}={120}^{∘},\\,{x}_{2}={300}^{∘}.\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=120\\cdot 300=36\\,000.\n$$" 13194139535925 17592186045417 true] [17592186543507 1068 #edb/ref 17592186543349 13194139535925 17592186045417 true] [17592186543507 1069 "q-340285" 13194139535925 17592186045417 true] [17592186543507 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543507 1071 "Given that $f(x)=5\\cdot {7}^{x}$, the slope of the tangent at $x=0$ is{{field-1}}." 13194139535925 17592186045417 true] [17592186543507 1072 #uuid "5e010595-5a96-5d35-8548-77ec2815a5a0" 13194139535925 17592186045417 true] [17592186543507 1074 "Applying the formula, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5\\cdot {7}^{x}) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({7}^{x}) \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{x}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=0$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=0} & ={(5\\operatorname{ln}⁡(7)\\cdot {7}^{x})|}_{x=0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot {7}^{0} \\\\  & =5\\operatorname{ln}⁡(7)\\cdot 1 \\\\  & =5\\operatorname{ln}⁡(7).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543508 1068 #edb/ref 17592186543365 13194139535925 17592186045417 true] [17592186543508 1069 "q-121522" 13194139535925 17592186045417 true] [17592186543508 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543508 1071 "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-\\frac{9}{2},-\\frac{3\\sqrt{3}}{2}).$ What is the value of $k?$" 13194139535925 17592186045417 true] [17592186543508 1072 #uuid "5fff1012-20ae-54c4-8327-06d77bbed9eb" 13194139535925 17592186045417 true] [17592186543508 1074 "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-\\frac{9}{2})}^{2}+{(-\\frac{3\\sqrt{3}}{2})}^{2}} \\\\  & =\\sqrt{\\frac{81}{4}+\\frac{27}{4}} \\\\  & =\\sqrt{27} \\\\  & =3\\sqrt{3}.\\end{aligned}\n$$\n\nNow, since $A$ lies in the third quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi +\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi +\\operatorname{arctan}⁡|\\frac{-\\frac{3\\sqrt{3}}{2}}{-\\frac{9}{2}}| \\\\  & =\\pi +\\operatorname{arctan}⁡\\frac{\\sqrt{3}}{3} \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(3\\sqrt{3},\\frac{7\\pi }{6}).$  \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 3\\sqrt{3} & =k\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\ 3\\sqrt{3} & =k(-\\frac{\\sqrt{3}}{2}) \\\\ k & =-6\\end{aligned}\n$$\n\n \n\nTherefore, the equation of the curve is $r=-6\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/99/999a34650676174083aa479669eecca0c837dc8e5f1397a81a8949d8f9dc9de1.png)" 13194139535925 17592186045417 true] [17592186543509 1068 #edb/ref 17592186543417 13194139535925 17592186045417 true] [17592186543509 1068 #edb/ref 17592186543448 13194139535925 17592186045417 true] [17592186543509 1069 "q-335807" 13194139535925 17592186045417 true] [17592186543509 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543509 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{cos}⁡(\\frac{x}{2}+{30}^{∘})=\\frac{1}{2},$ for $-{180}^{∘}\\le x<{180}^{∘},$  are\n\n${x}_{1}=$\n{{field-1}}${}^{∘},\\,{x}_{2}=$\n{{field-2}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543509 1072 #uuid "637ba677-860c-50d3-9633-f9db8d1adb0f" 13194139535925 17592186045417 true] [17592186543509 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}\\frac{x}{2}+{30}^{∘} & ={60}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & \\frac{x}{2}+{30}^{∘} & ={300}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}\\frac{x}{2} & ={60}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{x}{2} & ={300}^{∘}-{30}^{∘}+n\\cdot {360}^{∘} \\\\ \\frac{x}{2} & ={30}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & \\frac{x}{2} & ={270}^{∘}+n\\cdot {360}^{∘} \\\\ x & ={60}^{∘}+n\\cdot {720}^{∘} & \\, & \\, & x & ={540}^{∘}+n\\cdot {720}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-{180}^{∘}\\le x<{180}^{∘}.$\n\n- Setting $n=-1$ gives $x=-{660}^{∘}$ and $x=-{180}^{∘}.$  We reject the solution $-{660}^{∘}$ since it lies outside the domain of interest.\n\n- Setting $n=0$ gives $x={60}^{∘}$ and $x={540}^{∘}.$  We reject the solution ${540}^{∘}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $-{180}^{∘}\\le x<{180}^{∘}.$ \n\nSo, in ascending order, the solutions are \n\n$$\n{x}_{1}={-180}^{∘},\\,{x}_{2}={60}^{∘}.\n$$" 13194139535925 17592186045417 true] [17592186543510 1068 #edb/ref 17592186543396 13194139535925 17592186045417 true] [17592186543510 1068 #edb/ref 17592186543402 13194139535925 17592186045417 true] [17592186543510 1069 "q-338913" 13194139535925 17592186045417 true] [17592186543510 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543510 1071 "Consider the boundary value problem\n\n$$\n{y}^{″}+49{\\lambda }^{2}y=0,\\,{y}^{′}(0)={y}^{′}(2)=0,\\,0\\le x\\le 2,\\,\\lambda \\ge 0.\n$$\n\nFind the parameter values corresponding to the eigenvalues and the associated eigenfunctions of this problem.\n\n$\\,$ The eigenvalues correspond to the parameter values ${\\lambda }_{n}=$ {{field-1}}, where $n\\in N.$\n\n$\\,$ The eigenfunctions are ${y}_{n}(x)=$ {{field-2}}, where ${B}_{n}\\in R.$" 13194139535925 17592186045417 true] [17592186543510 1072 #uuid "648c7fb6-34ca-53e3-ba2b-a6cf79213062" 13194139535925 17592186045417 true] [17592186543510 1074 "We consider the cases $\\lambda =0$ and $\\lambda \\ne 0$ separately, since they correspond to different solutions. \n\n**Case 1**: First, we consider $\\lambda =0.$ \n\nSetting $\\lambda =0$ gives the equation\n\n$$\n{y}^{″}=0.\n$$\n\nIntegrating this equation gives\n\n$$\ny=Ax+B.\n$$\n\nApplying the conditions ${y}^{′}(0)={y}^{′}(2)=0$ yields $A=0.$ Thus, we have a nontrivial solution, so $\\lambda =0$ is a parameter corresponding to the eigenvalue.\n\n**Case 2**: Next, we consider $\\lambda >0.$\n\nTo find the fundamental solutions, we set $y={e}^{mx}.$ The auxiliary equation is\n\n$$\n\\begin{aligned}{m}^{2}+49{\\lambda }^{2} & =0.\\end{aligned}\n$$\n\nSo, we have $m=\\pm 7\\text{i}\\lambda .$ So, the fundamental solutions are \n\n$$\n{y}_{1}(x)=\\operatorname{cos}⁡(7\\lambda x),\\,{y}_{2}(x)=\\operatorname{sin}⁡(7\\lambda x)\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x)+B\\operatorname{sin}⁡(7\\lambda x).\n$$\n\nDifferentiating gives\n\n$$\n{y}^{′}=-7A\\lambda \\operatorname{sin}⁡(7\\lambda x)+7B\\lambda \\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(0)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(0)+7B\\lambda \\operatorname{cos}⁡(0)=0\n$$\n\nwhich gives $B=0.$ So, we have\n\n$$\ny=A\\operatorname{cos}⁡(7\\lambda x).\n$$\n\nApplying the boundary condition ${y}^{′}(2)=0$ yields\n\n$$\n-7A\\lambda \\operatorname{sin}⁡(14\\lambda )=0.\n$$\n\nFor nontrivial solutions, we require \n\n$$\n14\\lambda =n\\pi \n$$\n\nfor $n\\in N.$ This gives the parameter values corresponding to the eigenvalues:\n\n$$\n{\\lambda }_{n}=\\frac{n\\pi }{14}.\n$$\n\nThe corresponding eigenfunctions are \n\n$$\n{y}_{n}(x)={B}_{n}\\operatorname{cos}⁡(7{\\lambda }_{n}x),\\,{B}_{n}\\in R.\n$$" 13194139535925 17592186045417 true] [17592186543511 1068 #edb/ref 17592186543407 13194139535925 17592186045417 true] [17592186543511 1069 "q-95283" 13194139535925 17592186045417 true] [17592186543511 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543511 1071 "Which of the following statements are true?\n\nI. The matrix $A=[\\begin{aligned}-10 & 0 \\\\ 0 & 0\\end{aligned}]$ has one negative singular value.\n\nII. Any $2\\times 4$ matrix $A$ has at most $4$ distinct singular values.\n\nIII. Any $6\\times 3$ matrix $A$ has at most $6$ distinct singular values." 13194139535925 17592186045417 true] [17592186543511 1072 #uuid "66207faf-3d6b-5406-8c58-c05d9d84a48f" 13194139535925 17592186045417 true] [17592186543511 1074 "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false.  All singular values of any matrix are non-negative. So, \n$A$  can't have any negative singular value.\n\n- Statement II is true. Indeed,  since $A$ is a $2\\times 4$ matrix and ${A}^{T}$ is a $4\\times 2$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 2}\\times {A}_{2\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\n- Statement III is false. Since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"II only.\"" 13194139535925 17592186045417 true] [17592186543512 1068 #edb/ref 17592186543307 13194139535925 17592186045417 true] [17592186543512 1068 #edb/ref 17592186543459 13194139535925 17592186045417 true] [17592186543512 1068 #edb/ref 17592186543466 13194139535925 17592186045417 true] [17592186543512 1069 "q-335752" 13194139535925 17592186045417 true] [17592186543512 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543512 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{cos}⁡(4x+{20}^{∘})=\\frac{1}{2},$ for ${0}^{∘}\\le x<{360}^{∘},$ are ${x}_{1},{x}_{2},{x}_{3},{x}_{4},{x}_{5},{x}_{6},{x}_{7},$ and ${x}_{8}.$ Determine ${x}_{3},$ ${x}_{6},$ and ${x}_{8}.$\n\n$\\,{x}_{3}=$ \n{{field-1}}${}^{∘},\\,{x}_{6}=$ \n{{field-2}}${}^{∘},\\,{x}_{8}=$ \n{{field-3}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543512 1072 #uuid "689ab27d-73f0-5878-911e-f4bfe8b4c90e" 13194139535925 17592186045417 true] [17592186543512 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}4x+{20}^{∘} & ={60}^{∘}+n\\cdot {360}^{∘}, & \\, & \\, & 4x+{20}^{∘} & ={300}^{∘}+n\\cdot {360}^{∘}.\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}4x & ={60}^{∘}-{20}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 4x & ={300}^{∘}-{20}^{∘}+n\\cdot {360}^{∘} \\\\ 4x & ={40}^{∘}+n\\cdot {360}^{∘} & \\, & \\, & 4x & ={280}^{∘}+n\\cdot {360}^{∘} \\\\ x & ={10}^{∘}+n\\cdot {90}^{∘} & \\, & \\, & x & ={70}^{∘}+n\\cdot {90}^{∘}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={10}^{∘}$ and $x={70}^{∘}.$\n\n- Setting $n=1$ gives $x={100}^{∘}$ and $x={160}^{∘}.$\n\n- Setting $n=2$ gives $x={190}^{∘}$ and $x={250}^{∘}.$\n\n- Setting $n=3$ gives $x={280}^{∘}$ and $x={340}^{∘}.$\n\nAll other integer values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ \n\nSo, in ascending order, the solutions are\n\n$$\n\\begin{aligned}{x}_{1} & ={10}^{∘},\\, & {x}_{2} & ={70}^{∘},\\, & {x}_{3} & ={100}^{∘}, & {x}_{4} & ={160}^{∘},\\, \\\\ {x}_{5} & ={190}^{∘},\\, & {x}_{6} & ={250}^{∘},\\, & {x}_{7} & ={280}^{∘}, & {x}_{8} & ={340}^{∘}.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543513 1068 #edb/ref 17592186543410 13194139535925 17592186045417 true] [17592186543513 1068 #edb/ref 17592186543467 13194139535925 17592186045417 true] [17592186543513 1069 "q-338519" 13194139535925 17592186045417 true] [17592186543513 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543513 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $2\\operatorname{cot}⁡x\\operatorname{sec}⁡x+\\operatorname{cot}⁡x-2\\operatorname{sec}⁡x-1=0,$ for $-\\pi \\le x<\\pi ,$ are\n\n${x}_{1}=$\n{{field-1}}$,\\,{x}_{2}=$ \n{{field-2}}." 13194139535925 17592186045417 true] [17592186543513 1072 #uuid "68f4987d-ed26-5738-89d9-828f518f37d4" 13194139535925 17592186045417 true] [17592186543513 1074 "Note that the functions $\\operatorname{cot}⁡x$ and $\\operatorname{sec}⁡x$ are not defined at the points where $\\operatorname{sin}⁡x=0$ or $\\operatorname{cos}⁡x=0.$ On the interval $-\\pi \\le x<\\pi ,$ the excluded values are $x=0,\\,\\pm \\frac{\\pi }{2},\\,\\pm \\pi .$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}2\\operatorname{cot}⁡x\\operatorname{sec}⁡x+\\operatorname{cot}⁡x-2\\operatorname{sec}⁡x-1 & =0 \\\\ \\operatorname{cot}⁡x(2\\operatorname{sec}⁡x+1)-(2\\operatorname{sec}⁡x+1) & =0 \\\\ (2\\operatorname{sec}⁡x+1)(\\operatorname{cot}⁡x-1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n2\\operatorname{sec}⁡x+1=0,\\,\\operatorname{cot}⁡x-1=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $2\\operatorname{sec}⁡x+1=0,$ or equivalently $\\operatorname{cos}⁡x=-2.$ But since $|\\operatorname{cos}⁡x|\\le 1,$ then $\\operatorname{cos}⁡x=-2$ has no solution.\n\n- Then, we solve $\\operatorname{cot}⁡x-1=0,$ or equivalently $\\operatorname{tan}⁡x=1.$ The solutions to this equation for $-\\pi \\le x<\\pi ,$ are $x=-\\frac{3\\pi }{4},\\,\\frac{\\pi }{4}.$\n\nArranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}=-\\frac{3\\pi }{4},\\,{x}_{2}=\\frac{\\pi }{4}.\n$$" 13194139535925 17592186045417 true] [17592186543514 1068 #edb/ref 17592186543343 13194139535925 17592186045417 true] [17592186543514 1069 "q-99953" 13194139535925 17592186045417 true] [17592186543514 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543514 1071 "Express $6\\operatorname{ln}⁡(68)-6\\operatorname{ln}⁡(17)$ as a single logarithm." 13194139535925 17592186045417 true] [17592186543514 1072 #uuid "692975c7-d71f-5bff-afaa-3fff34d21e62" 13194139535925 17592186045417 true] [17592186543514 1074 "First, let's recall the quotient rule for natural logarithms:\n\n$$\n\\operatorname{ln}⁡(a)-\\operatorname{ln}⁡(b)=\\operatorname{ln}⁡(\\frac{a}{b})\n$$\n\nIf we factor the given expression and use the quotient rule for logarithms, we get:\n\n$$\n\\begin{aligned}6\\operatorname{ln}⁡(68)-6\\operatorname{ln}⁡(17) & =6(\\operatorname{ln}⁡(68)-\\operatorname{ln}⁡(17)) \\\\  & =6\\operatorname{ln}⁡(\\frac{68}{17}) \\\\  & =6\\operatorname{ln}⁡(4)\\end{aligned}\n$$\n\nTherefore:\n\n$$\n6\\operatorname{ln}⁡(68)-6\\operatorname{ln}⁡(17)=6\\operatorname{ln}⁡(4)\n$$" 13194139535925 17592186045417 true] [17592186543515 1068 #edb/ref 17592186543350 13194139535925 17592186045417 true] [17592186543515 1068 #edb/ref 17592186543353 13194139535925 17592186045417 true] [17592186543515 1069 "q-355902" 13194139535925 17592186045417 true] [17592186543515 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543515 1071 "Suppose we have a dataset consisting of $5$ datapoints with $4$ features in the form of the $5\\times 4$ matrix\n\n$$\nX=[\\begin{aligned}0.93 & 0.98 & -1.44 & -1.13 \\\\ -0.14 & -0.96 & 0.96 & 1.58 \\\\ -1.06 & -1.09 & -0.61 & -0.05 \\\\ -0.86 & 0.96 & 0.42 & 0.08 \\\\ 1.12 & 0.1 & 0.68 & -0.48\\end{aligned}]\n$$\n\nwhere the data has been standardized (the mean of each feature is $0$ and the standard deviation is $1$).\nWe are also given the SVD decomposition $X=UΣ{V}^{T}$ where:\n\n$$\n\\begin{aligned}U & =[\\begin{aligned}-0.725 & 0.1 & -0.166 & -0.483 & 0.452 \\\\ 0.64 & -0.269 & -0.185 & -0.532 & 0.449 \\\\ 0.207 & 0.729 & -0.311 & 0.363 & 0.444 \\\\ 0.032 & 0.06 & 0.889 & 0.076 & 0.446 \\\\ -0.149 & -0.619 & -0.227 & 0.588 & 0.444\\end{aligned}] \\\\ Σ & =[\\begin{aligned}3.067 & 0 & 0 & 0 \\\\ 0 & 1.933 & 0 & 0 \\\\ 0 & 0 & 1.517 & 0 \\\\ 0 & 0 & 0 & 0.763 \\\\ 0 & 0 & 0 & 0\\end{aligned}] \\\\ V & =[\\begin{aligned}-0.384 & -0.717 & -0.539 & -0.218 \\\\ -0.5 & -0.229 & 0.78 & -0.297 \\\\ 0.471 & -0.643 & 0.31 & 0.518 \\\\ 0.617 & -0.141 & 0.06 & -0.772\\end{aligned}]\\end{aligned}\n$$\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components.\n\nWe should pick components based on \n{{field-1}}.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to \n{{field-2}}." 13194139535925 17592186045417 true] [17592186543515 1072 #uuid "6d89bf53-876c-5233-a22b-c8fa7b16fa9b" 13194139535925 17592186045417 true] [17592186543515 1074 "In reducing the dimensionality of the dataset, we aim to preserve as much of the original variance as possible. \n\nWe should pick components based on $\\text{the amount of cumulative variance preserved}.$\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\nIn our example, the singular values are\n\n$$\n{\\sigma }_{1}=3.067,\\,{\\sigma }_{2}=1.933,\\,{\\sigma }_{3}=1.517,\\,{\\sigma }_{4}=0.763.\n$$\n\nLet us now compute the cumulative variance preserved for different numbers of components.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{\\sigma }_{1}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈58.7%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{2}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}+{1.933}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈82.0%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first three principal components is \n\n$$\n\\frac{{\\sum }_{i=1}^{3}{\\sigma }_{i}^{2}}{{\\sum }_{i=1}^{4}{\\sigma }_{i}^{2}}=\\frac{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}}{{3.067}^{2}+{1.933}^{2}+{1.517}^{2}+{0.763}^{2}}≈96.4%.\n$$\n\nThus, we obtain that\n\n- reducing the dataset to $1$ dimension would preserve $58.7%$ of the variance,\n\n- reducing the dataset to $2$ dimensions would preserve $82.0%$ of the variance, while\n\n- reducing the dataset to $3$ dimensions would preserve $96.4%$ of the variance.\n\n![](images/ff/ff1aa60e989377c3767643d2538755d932bc40669f550b57040581192a104f8c.png)\n\nTherefore, we should reduce the dataset to $3\\text{ dimensions},$ since this is the minimum number of components that preserves at least $90%$ of the variance." 13194139535925 17592186045417 true] [17592186543516 1068 #edb/ref 17592186543427 13194139535925 17592186045417 true] [17592186543516 1069 "q-3600" 13194139535925 17592186045417 true] [17592186543516 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543516 1071 "Factor $\\frac{1}{27}+{z}^{3}.$" 13194139535925 17592186045417 true] [17592186543516 1072 #uuid "733ab756-eb23-5365-83ae-dfce071139ee" 13194139535925 17592186045417 true] [17592186543516 1074 "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n\\frac{1}{27}+{z}^{3}={(\\frac{1}{3})}^{3}+{z}^{3}\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}\\frac{1}{27}+{z}^{3} & ={(\\frac{1}{3})}^{3}+{z}^{3} \\\\  & =(\\frac{1}{3}+z)({(\\frac{1}{3})}^{2}-\\frac{1}{3}\\cdot z+{z}^{2}) \\\\  & =(\\frac{1}{3}+z)(\\frac{1}{9}-\\frac{z}{3}+{z}^{2})\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543517 1068 #edb/ref 17592186543399 13194139535925 17592186045417 true] [17592186543517 1069 "q-140635" 13194139535925 17592186045417 true] [17592186543517 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543517 1071 "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $4\\times 2$ matrix, which of the following statements are true?\n\nI. $U$ is a $4\\times 4$ orthogonal matrix\n\nII. $Σ$ is a $2\\times 2$ matrix\n\nIII. $V$ is a diagonal matrix with only positive elements on the main diagonal" 13194139535925 17592186045417 true] [17592186543517 1072 #uuid "75ae4937-7257-5ddb-963c-2c5dab077964" 13194139535925 17592186045417 true] [17592186543517 1074 "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $4\\times 2$ matrix, $U$ in the singular value decomposition $UΣ{V}^{T}$ must be a $4\\times 4$ orthogonal matrix.\n\n- Statement II is false. Since $A$ is a $4\\times 2$ matrix, $Σ$ must be a $4\\times 2$ matrix.\n\n- Statement III is false. The matrix $V$ in the singular value decomposition $UΣ{V}^{T}$ must be an orthogonal matrix, not a diagonal matrix.\n\nTherefore, the correct answer is \"I only.\"" 13194139535925 17592186045417 true] [17592186543518 1068 #edb/ref 17592186543442 13194139535925 17592186045417 true] [17592186543518 1069 "q-66366" 13194139535925 17592186045417 true] [17592186543518 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543518 1071 "$(-6\\,\\text{i})\\cdot 2\\,\\text{i}=$" 13194139535925 17592186045417 true] [17592186543518 1072 #uuid "772edc16-136d-5a38-b38b-aec6a90dcb95" 13194139535925 17592186045417 true] [17592186543518 1074 "Multiplying two purely imaginary numbers is similar to multiplying two monomials. We also use the fact that ${\\text{i}}^{2}=-1.$\n\nFor the given problem, we have\n\n$$\n\\begin{aligned}(-6\\text{i})\\cdot 2\\text{i} & =(-6)\\cdot 2\\cdot {\\text{i}}^{2} \\\\  & =-12\\,{\\text{i}}^{2} \\\\  & =(-12)\\cdot (-1) \\\\  & =12.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543519 1068 #edb/ref 17592186543422 13194139535925 17592186045417 true] [17592186543519 1069 "q-47198" 13194139535925 17592186045417 true] [17592186543519 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543519 1071 "$\\operatorname{ln}⁡(\\frac{{z}^{6}}{13})=$" 13194139535925 17592186045417 true] [17592186543519 1072 #uuid "7a291781-59c8-57ab-aafe-d8f0841ec267" 13194139535925 17592186045417 true] [17592186543519 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient quotient and then the power rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(\\frac{{z}^{6}}{13}) & =\\operatorname{ln}⁡({z}^{6})-\\operatorname{ln}⁡(13) \\\\  & =6\\operatorname{ln}⁡(z)-\\operatorname{ln}⁡(13).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543520 1068 #edb/ref 17592186543346 13194139535925 17592186045417 true] [17592186543520 1068 #edb/ref 17592186543354 13194139535925 17592186045417 true] [17592186543520 1068 #edb/ref 17592186543394 13194139535925 17592186045417 true] [17592186543520 1068 #edb/ref 17592186543429 13194139535925 17592186045417 true] [17592186543520 1068 #edb/ref 17592186543453 13194139535925 17592186045417 true] [17592186543520 1069 "q-274686" 13194139535925 17592186045417 true] [17592186543520 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543520 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $2\\operatorname{cos}⁡(5x)+2=0,$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$\n {{field-1}}$,\\,{x}_{2}=$ \n{{field-2}}$,\\,{x}_{3}=$ \n{{field-3}}$,\\,{x}_{4}=$ \n{{field-4}}$,\\,{x}_{5}=$ \n{{field-5}}." 13194139535925 17592186045417 true] [17592186543520 1072 #uuid "7afac99d-b74c-555b-b269-d08cbbf29447" 13194139535925 17592186045417 true] [17592186543520 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡(5x)+2 & =0 \\\\ 2\\operatorname{cos}⁡(5x) & =-2 \\\\ \\operatorname{cos}⁡(5x) & =-1\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}5x & =\\pi +2n\\pi .\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{\\pi +2n\\pi }{5} \\\\ x & =\\frac{(2n+1)\\pi }{5}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{5}.$\n\n- Setting $n=1$ gives $x=\\frac{3\\pi }{5}.$\n\n- Setting $n=2$ gives $x=\\pi .$\n\n- Setting $n=3$ gives $x=\\frac{7\\pi }{5}.$\n\n- Setting $n=4$ gives $x=\\frac{9\\pi }{5}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ \n\nSo, in ascending order, the solutions are\n\n$$\n{x}_{1}=\\frac{\\pi }{5},\\,{x}_{2}=\\frac{3\\pi }{5},\\,{x}_{3}=\\pi ,\\,{x}_{4}=\\frac{7\\pi }{5},\\,{x}_{5}=\\frac{9\\pi }{5}.\n$$" 13194139535925 17592186045417 true] [17592186543521 1068 #edb/ref 17592186543462 13194139535925 17592186045417 true] [17592186543521 1069 "q-16470" 13194139535925 17592186045417 true] [17592186543521 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543521 1071 "![](images/ae/aee2a6a03d8dc10cd56e6e2df279fcf88672d0c83d0ae7abc86a0c8b1a3e434d.png)\n\nWhat is the polar equation of the curve shown above?" 13194139535925 17592186045417 true] [17592186543521 1072 #uuid "7fdddd6d-d41d-5369-b195-6ee0cc2418de" 13194139535925 17592186045417 true] [17592186543521 1074 "The diagram shows a circle of radius $a=1$ centered at the point $(0,1).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{sin}⁡\\theta  \\\\  & =2\\cdot 1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543522 1068 #edb/ref 17592186543309 13194139535925 17592186045417 true] [17592186543522 1068 #edb/ref 17592186543387 13194139535925 17592186045417 true] [17592186543522 1069 "q-338464" 13194139535925 17592186045417 true] [17592186543522 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543522 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{cos}⁡x\\operatorname{tan}⁡x+\\sqrt{3}\\operatorname{cos}⁡x=0,$ for ${0}^{∘}\\le x<{360}^{∘},$ are\n\n${x}_{1}=$ \n{{field-1}}${}^{∘},\\,{x}_{2}=$ \n{{field-2}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543522 1072 #uuid "81da0bad-95e8-53a0-9f19-ddc55b628c5f" 13194139535925 17592186045417 true] [17592186543522 1074 "Note that the function $\\operatorname{tan}⁡x$ is not defined at $x={90}^{∘},\\,{270}^{∘}.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x\\operatorname{tan}⁡x+\\sqrt{3}\\operatorname{cos}⁡x & =0 \\\\ \\operatorname{cos}⁡x(\\operatorname{tan}⁡x+\\sqrt{3}) & =0\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{cos}⁡x=0,\\,\\operatorname{tan}⁡x+\\sqrt{3}=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{cos}⁡x=0.$ The solutions to this equation for ${0}^{∘}\\le x<{360}^{∘}$ are $x={90}^{∘},\\,{270}^{∘}.$\n\n- Then, we solve $\\operatorname{tan}⁡x+\\sqrt{3}=0,$ or equivalently $\\operatorname{tan}⁡x=-\\sqrt{3}.$ The solutions to this equation for ${0}^{∘}\\le x<{360}^{∘}$ are $x={120}^{∘},\\,{300}^{∘}.$\n\nTaking into account that ${90}^{∘}$ and ${270}^{∘}$ are excluded values, and arranging the remaining solutions in ascending order, we get\n\n$$\n{x}_{1}={120}^{∘},\\,{x}_{2}={300}^{∘}.\n$$" 13194139535925 17592186045417 true] [17592186543523 1068 #edb/ref 17592186543375 13194139535925 17592186045417 true] [17592186543523 1069 "q-69640" 13194139535925 17592186045417 true] [17592186543523 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543523 1071 "Factor $\\frac{8}{{t}^{6}}-1000.$" 13194139535925 17592186045417 true] [17592186543523 1072 #uuid "82176286-a684-5858-a421-cc4a4b4187bd" 13194139535925 17592186045417 true] [17592186543523 1074 "The difference of cubes formula is given by\n\n$$\n{a}^{3}-{b}^{3}=(a-b)({a}^{2}+ab+{b}^{2}).\n$$\n\nNotice that all of the terms have a common factor of $8.$ To simplify the computation, we can factor out the $8,$ as follows:\n\n$$\n\\frac{8}{{t}^{6}}-1000=8(\\frac{1}{{t}^{6}}-125)\n$$\n\nThe expression in parentheses can be written as a difference of cubes:\n\n$$\n8(\\frac{1}{{t}^{6}}-125)=8({(\\frac{1}{{t}^{2}})}^{3}-{5}^{3})\n$$\n\nNow, we factor the expression in parentheses using the difference of cubes formula:\n\n$$\n\\begin{aligned}\\frac{8}{{t}^{6}}-1000 & =8({(\\frac{1}{{t}^{2}})}^{3}-{5}^{3}) \\\\  & =8(\\frac{1}{{t}^{2}}-5)({(\\frac{1}{{t}^{2}})}^{2}+\\frac{1}{{t}^{2}}\\cdot 5+{5}^{2}) \\\\  & =8(\\frac{1}{{t}^{2}}-5)(\\frac{1}{{t}^{4}}+\\frac{5}{{t}^{2}}+25)\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543524 1068 #edb/ref 17592186543319 13194139535925 17592186045417 true] [17592186543524 1069 "q-79453" 13194139535925 17592186045417 true] [17592186543524 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543524 1071 "If ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, then ${log}_{5}⁡({x}^{2}{y}^{3})=$" 13194139535925 17592186045417 true] [17592186543524 1072 #uuid "841f3191-5c7e-5e47-b725-127033cb9a73" 13194139535925 17592186045417 true] [17592186543524 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{5}⁡({x}^{2}{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{5}⁡({x}^{2}{y}^{3}) & ={log}_{5}⁡({x}^{2})+{log}_{5}⁡({y}^{3}) \\\\  & =2{log}_{5}⁡(x)+3{log}_{5}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{5}⁡(x)=3$ and ${log}_{5}⁡(y)=2$, we conclude that\n\n$$\n2{log}_{5}⁡(x)+3{log}_{5}⁡(y)=2\\cdot 3+3\\cdot 2=12.\n$$\n\nHence\n\n$$\n{log}_{5}⁡({x}^{2}{y}^{3})=12.\n$$" 13194139535925 17592186045417 true] [17592186543525 1068 #edb/ref 17592186543362 13194139535925 17592186045417 true] [17592186543525 1069 "q-108203" 13194139535925 17592186045417 true] [17592186543525 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543525 1071 "$\\operatorname{ln}⁡({x}^{5})=$" 13194139535925 17592186045417 true] [17592186543525 1072 #uuid "87e631c2-0787-575b-9e30-ac64f270159d" 13194139535925 17592186045417 true] [17592186543525 1074 "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms, we get:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({x}^{5})=5\\operatorname{ln}⁡x\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543526 1068 #edb/ref 17592186543403 13194139535925 17592186045417 true] [17592186543526 1069 "q-66781" 13194139535925 17592186045417 true] [17592186543526 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543526 1071 "${log}_{3}⁡(\\frac{5x}{27})=$" 13194139535925 17592186045417 true] [17592186543526 1072 #uuid "8b91269e-ac3e-5858-87ab-575f9e7b0df8" 13194139535925 17592186045417 true] [17592186543526 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule and then the product rule for logarithms, we have\n\n$$\n\\begin{aligned}{log}_{3}⁡(\\frac{5x}{27}) & ={log}_{3}⁡(5x)-{log}_{3}⁡(27) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-{log}_{3}⁡({3}^{3}) \\\\  & ={log}_{3}⁡(5)+{log}_{3}⁡(x)-3.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543527 1068 #edb/ref 17592186543302 13194139535925 17592186045417 true] [17592186543527 1068 #edb/ref 17592186543334 13194139535925 17592186045417 true] [17592186543527 1068 #edb/ref 17592186543336 13194139535925 17592186045417 true] [17592186543527 1069 "q-338812" 13194139535925 17592186045417 true] [17592186543527 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543527 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $4\\operatorname{cos}⁡(3x-\\frac{\\pi }{6})+2=0,$ for $0<x<\\pi ,$  are\n\n${x}_{1}=$ \n{{field-1}}$,\\,{x}_{2}=$ \n{{field-2}}$,\\,{x}_{3}=$ \n{{field-3}}." 13194139535925 17592186045417 true] [17592186543527 1072 #uuid "8d85e958-8094-54f0-80e0-53c48caaf572" 13194139535925 17592186045417 true] [17592186543527 1074 "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}4\\operatorname{cos}⁡(3x-\\frac{\\pi }{6})+2 & =0 \\\\ 4\\operatorname{cos}⁡(3x-\\frac{\\pi }{6}) & =-2 \\\\ \\operatorname{cos}⁡(3x-\\frac{\\pi }{6}) & =-\\frac{1}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}3x-\\frac{\\pi }{6} & =\\frac{2\\pi }{3}+n\\cdot 2\\pi , & \\, & \\, & 3x-\\frac{\\pi }{6} & =\\frac{4\\pi }{3}+n\\cdot 2\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}3x & =\\frac{2\\pi }{3}+\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & 3x & =\\frac{4\\pi }{3}+\\frac{\\pi }{6}+n\\cdot 2\\pi  \\\\ 3x & =\\frac{5\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & 3x & =\\frac{3\\pi }{2}+n\\cdot 2\\pi  \\\\ x & =\\frac{5\\pi }{18}+n\\cdot \\frac{2\\pi }{3} & \\, & \\, & x & =\\frac{\\pi }{2}+n\\cdot \\frac{2\\pi }{3}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0<x<\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{5\\pi }{18}$ and $x=\\frac{\\pi }{2}.$\n\n- Setting $n=1$ gives $x=\\frac{17\\pi }{18}$ and $x=\\frac{7\\pi }{6}.$  We reject the solution $\\frac{7\\pi }{6}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0<x<\\pi .$ \n\nSo, in ascending order, the solutions are \n\n$$\n{x}_{1}=\\frac{5\\pi }{18},\\,{x}_{2}=\\frac{\\pi }{2},\\,{x}_{3}=\\frac{17\\pi }{18}.\n$$" 13194139535925 17592186045417 true] [17592186543528 1068 #edb/ref 17592186543418 13194139535925 17592186045417 true] [17592186543528 1069 "q-47230" 13194139535925 17592186045417 true] [17592186543528 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543528 1071 "By expressing $\\operatorname{log}⁡\\sqrt{6x}$ in the form $p\\operatorname{log}⁡(6x),$ determine the value of $p.$" 13194139535925 17592186045417 true] [17592186543528 1072 #uuid "8f6c580a-c90e-5ca5-ad86-b6a33b799e39" 13194139535925 17592186045417 true] [17592186543528 1074 "First, let's recall the power rule for logarithms:\n\n$$\n\\operatorname{log}⁡({c}^{m})=m\\operatorname{log}⁡(c)\n$$\n\nUsing the power rule for logarithms, the given expression can be rewritten as:\n\n$$\n\\begin{aligned}\\operatorname{log}⁡\\sqrt{6x} & =\\operatorname{log}⁡((6x)^{1/2}) \\\\  & =\\frac{1}{2}\\operatorname{log}⁡(6x)\\end{aligned}\n$$\n\nHence, $p=\\frac{1}{2}.$" 13194139535925 17592186045417 true] [17592186543529 1068 #edb/ref 17592186543383 13194139535925 17592186045417 true] [17592186543529 1069 "q-86987" 13194139535925 17592186045417 true] [17592186543529 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543529 1071 "Which of the following is the graph of the polar curve $r=-3\\operatorname{cos}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543529 1072 #uuid "90664198-1ae6-5ca3-8d3a-7072c273c129" 13194139535925 17592186045417 true] [17592186543529 1074 "The polar equation $r=2a\\operatorname{cos}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(a,0).$\n\nIn our case, we have $r=-3\\operatorname{cos}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{(-3)}{2}=-\\frac{3}{2}.\n$$\n\nTherefore, the equation $r=-3\\operatorname{cos}⁡\\theta $ gives a circle of radius $|-1.5|=1.5$ centered at the point $(-1.5,0),$ as shown below.\n\n![](images/74/748c15bf1cb55a3ed5ce4d08c4458e12f6ad97df1f1658831968d41c8c8f4bbb.png)" 13194139535925 17592186045417 true] [17592186543530 1068 #edb/ref 17592186543420 13194139535925 17592186045417 true] [17592186543530 1069 "q-159926" 13194139535925 17592186045417 true] [17592186543530 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543530 1071 "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ The log-likelihood function of the sample $8,\\,3,\\,5,\\,10$ is\n\n$$\nl(\\theta )=a\\operatorname{ln}⁡\\theta +b\\theta .\n$$\n\nWhat is the value of $a+b?$" 13194139535925 17592186045417 true] [17592186543530 1072 #uuid "9473cd62-7434-5b05-96e0-e08528b86ef4" 13194139535925 17592186045417 true] [17592186543530 1074 "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\theta {e}^{-\\theta x}) \\\\  & =\\operatorname{ln}⁡\\theta +\\operatorname{ln}⁡({e}^{-\\theta x}) \\\\  & =\\operatorname{ln}⁡\\theta -\\theta x.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(\\operatorname{ln}⁡\\theta -\\theta {x}_{i}) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡\\theta -\\theta {\\sum }_{i=1}^{n}{x}_{i} \\\\  & =n\\operatorname{ln}⁡\\theta -\\theta {\\sum }_{i=1}^{n}{x}_{i}\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{n}{x}_{i} & =8+3+5+10=26\\end{aligned}\n$$\n\nand $n=4.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =4\\operatorname{ln}⁡\\theta -\\theta \\cdot 26 \\\\  & =4\\operatorname{ln}⁡\\theta +(-26)\\theta .\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=4+(-26)=-22.\n$$" 13194139535925 17592186045417 true] [17592186543531 1068 #edb/ref 17592186543330 13194139535925 17592186045417 true] [17592186543531 1069 "q-98925" 13194139535925 17592186045417 true] [17592186543531 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543531 1071 "If ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4$, then ${log}_{2}⁡(x{y}^{3})=$" 13194139535925 17592186045417 true] [17592186543531 1072 #uuid "9796dfce-fb6b-57bd-b442-e9278daaaa20" 13194139535925 17592186045417 true] [17592186543531 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nNote that ${log}_{2}⁡(x{y}^{3})$ can be rewritten using the product and power rules as follows:\n\n$$\n\\begin{aligned}{log}_{2}⁡(x{y}^{3}) & ={log}_{2}⁡(x)+{log}_{2}⁡({y}^{3}) \\\\  & ={log}_{2}⁡(x)+3{log}_{2}⁡(y)\\end{aligned}\n$$\n\nNow, since ${log}_{2}⁡(x)=k$ and ${log}_{2}⁡(y)=4,$ we conclude that\n\n$$\n\\begin{aligned}{log}_{2}⁡(x)+3{log}_{2}⁡(y) & =k+3\\cdot 4 \\\\  & =k+12.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{log}_{2}⁡(x{y}^{3})=k+12.\n$$" 13194139535925 17592186045417 true] [17592186543532 1068 #edb/ref 17592186543317 13194139535925 17592186045417 true] [17592186543532 1069 "q-24442" 13194139535925 17592186045417 true] [17592186543532 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543532 1071 "If $\\operatorname{log}⁡(2)=p$ and $\\operatorname{log}⁡(y)=q$, then $\\operatorname{log}⁡(\\frac{2}{y})=$" 13194139535925 17592186045417 true] [17592186543532 1072 #uuid "99f3a3dc-a29b-56b3-b6b2-eb00c09e4e97" 13194139535925 17592186045417 true] [17592186543532 1074 "First, let's recall the quotient rule for common logarithms:\n\n$$\n\\operatorname{log}⁡(a)-\\operatorname{log}⁡(b)=\\operatorname{log}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for common logarithms, we have:\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(\\frac{2}{y}) & =\\operatorname{log}⁡(2)-\\operatorname{log}⁡(y) \\\\  & =p-q\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543533 1068 #edb/ref 17592186543379 13194139535925 17592186045417 true] [17592186543533 1069 "q-8471" 13194139535925 17592186045417 true] [17592186543533 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543533 1071 "Consider the equation $\\operatorname{cos}⁡(2x-\\frac{7\\pi }{6})=-\\frac{1}{2}$ for $0\\le x<2\\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{1}\\cdot {x}_{4}?$" 13194139535925 17592186045417 true] [17592186543533 1072 #uuid "9acc1f61-f727-5595-afa3-5b687cb64df5" 13194139535925 17592186045417 true] [17592186543533 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x-\\frac{7\\pi }{6} & =-\\frac{2\\pi }{3}+2n\\pi , & \\, & \\, & 2x-\\frac{7\\pi }{6} & =\\frac{2\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{2}+2n\\pi  & \\, & \\, & 2x & =\\frac{11\\pi }{6}+2n\\pi  \\\\ x & =\\frac{\\pi }{4}+n\\pi  & \\, & \\, & x & =\\frac{11\\pi }{12}+n\\pi  \\\\ x & =\\frac{(4n+1)\\pi }{4} & \\, & \\, & x & =\\frac{(12n+11)\\pi }{12}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{4}$ and $x=\\frac{11\\pi }{12}$\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{4}$ and $x=\\frac{23\\pi }{12}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$  So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{4},\\,\\frac{11\\pi }{12},\\,\\frac{5\\pi }{4},\\,\\frac{23\\pi }{12}.\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{4}=\\frac{\\pi }{4}\\cdot \\frac{23\\pi }{12}=\\frac{23{\\pi }^{2}}{48}.\n$$" 13194139535925 17592186045417 true] [17592186543534 1068 #edb/ref 17592186543318 13194139535925 17592186045417 true] [17592186543534 1069 "q-14136" 13194139535925 17592186045417 true] [17592186543534 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543534 1071 "Factor $405-5{x}^{4}$ completely." 13194139535925 17592186045417 true] [17592186543534 1072 #uuid "9d1054aa-9f73-56ea-a93c-1d65449f0f07" 13194139535925 17592186045417 true] [17592186543534 1074 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms in our expression have a common factor of $5.$ To simplify the computation, we can factor out the $5,$ as follows:\n\n$$\n405-5{x}^{4}=5\\cdot 81-5\\cdot {x}^{4}=5(81-{x}^{4})\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n5(81-{x}^{4})=5({9}^{2}-{({x}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n5({9}^{2}-{({x}^{2})}^{2})=5(9+{x}^{2})(9-{x}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}5(9+{x}^{2})(9-{x}^{2}) & =5(9+{x}^{2})({3}^{2}-{x}^{2}) \\\\  & =5(9+{x}^{2})(3+x)(3-x)\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543535 1068 #edb/ref 17592186543311 13194139535925 17592186045417 true] [17592186543535 1069 "q-86983" 13194139535925 17592186045417 true] [17592186543535 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543535 1071 "Which of the following is the graph of the polar curve $r=2.5\\operatorname{cos}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543535 1072 #uuid "9d2a01e3-0185-5503-82e9-9d6a8de6c36a" 13194139535925 17592186045417 true] [17592186543535 1074 "The polar equation $r=2a\\operatorname{cos}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(a,0).$\n\nIn our case, we have $r=2.5\\operatorname{cos}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{2.5}{2}=1.25.\n$$\n\nTherefore, the equation $r=2.5\\operatorname{cos}⁡\\theta $ gives a circle of radius $|1.25|=1.25$ centered at the point $(1.25,0),$ as shown below.\n\n![](images/11/110736084be735e5e103fe6c541cc3f98140743495cc7d23cbb2242c0eade076.png)" 13194139535925 17592186045417 true] [17592186543536 1068 #edb/ref 17592186543291 13194139535925 17592186045417 true] [17592186543536 1069 "q-280313" 13194139535925 17592186045417 true] [17592186543536 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543536 1071 "Which of the following is the graph of the polar curve $r=-7\\operatorname{sin}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543536 1072 #uuid "9d973ab4-2c91-51a2-bf21-8cc67388babd" 13194139535925 17592186045417 true] [17592186543536 1074 "The polar equation $r=2a\\operatorname{sin}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(0,a).$\n\nIn our case, we have $r=-7\\operatorname{sin}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{(-7)}{2}=-\\frac{7}{2}=-3.5.\n$$\n\nTherefore, the equation $r=-7\\operatorname{sin}⁡\\theta $ gives a circle of radius $|-3.5|=3.5$ centered at the point $(0,-3.5),$ as shown below.\n\n![](images/1e/1ec8b2c39de3bbb0bf91cf5fd3c075e266e12c21b625171111576258825eeb48.png)" 13194139535925 17592186045417 true] [17592186543537 1068 #edb/ref 17592186543344 13194139535925 17592186045417 true] [17592186543537 1069 "q-108205" 13194139535925 17592186045417 true] [17592186543537 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543537 1071 "By expressing $\\frac{3}{4}\\operatorname{ln}⁡x$ in the form $\\operatorname{ln}⁡({x}^{k}),$ determine the value of $k.$" 13194139535925 17592186045417 true] [17592186543537 1072 #uuid "9f684a9a-73a2-5a55-8105-9ed436326180" 13194139535925 17592186045417 true] [17592186543537 1074 "First, let's recall the power rule for logarithms:\n\n$$\n{log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)\n$$\n\nUsing the power rule for logarithms, we get:\n\n$$\n\\frac{3}{4}\\operatorname{ln}⁡x=\\operatorname{ln}⁡({x}^{3/4})\n$$\n\nHence $k=\\frac{3}{4}.$" 13194139535925 17592186045417 true] [17592186543538 1068 #edb/ref 17592186543328 13194139535925 17592186045417 true] [17592186543538 1069 "q-90621" 13194139535925 17592186045417 true] [17592186543538 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543538 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $2\\operatorname{tan}⁡x\\operatorname{csc}⁡x+\\operatorname{tan}⁡x-2\\operatorname{csc}⁡x-1=0$ for $-\\pi \\le x<\\pi ,$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139535925 17592186045417 true] [17592186543538 1072 #uuid "a135a2c5-e84d-52d5-89de-19fd76614f68" 13194139535925 17592186045417 true] [17592186543538 1074 "Note that the function $\\operatorname{csc}⁡x$ is not defined at the points where $\\operatorname{sin}⁡x=0.$ On the interval $-\\pi \\le x<\\pi ,$ the excluded values are $x=-\\pi ,\\,0.$\n\nOn the other hand, the function $\\operatorname{tan}⁡x$ is not defined at the points where $\\operatorname{cos}⁡x=0.$ On the interval $-\\pi \\le x<\\pi ,$ the excluded values are $x=-\\frac{\\pi }{2},\\,\\frac{\\pi }{2}.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}2\\operatorname{tan}⁡x\\operatorname{csc}⁡x+\\operatorname{tan}⁡x-2\\operatorname{csc}⁡x-1 & =0 \\\\ \\operatorname{tan}⁡x(2\\operatorname{csc}⁡x+1)-(2\\operatorname{csc}⁡x+1) & =0 \\\\ (2\\operatorname{csc}⁡x+1)(\\operatorname{tan}⁡x-1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n2\\operatorname{csc}⁡x+1=0,\\,\\operatorname{tan}⁡x-1=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $2\\operatorname{csc}⁡x+1=0,$ or equivalently $\\operatorname{sin}⁡x=-2.$ But since $|\\operatorname{sin}⁡x|\\le 1,$ then $\\operatorname{sin}⁡x=2$ has no solution.\n\n- Then, we solve $\\operatorname{tan}⁡x-1=0,$ or equivalently $\\operatorname{tan}⁡x=1.$ The solutions to this equation for $-\\pi \\le x<\\pi $ are $x=-\\frac{3\\pi }{4},\\frac{\\pi }{4}.$\n\nCombining all solutions from both equations, we get\n\n$$\n{x}_{1}=-\\frac{3\\pi }{4},\\,{x}_{2}=\\frac{\\pi }{4}.\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=-\\frac{3\\pi }{4}\\cdot \\frac{\\pi }{4}=-\\frac{3{\\pi }^{2}}{16}.\n$$" 13194139535925 17592186045417 true] [17592186543539 1068 #edb/ref 17592186543325 13194139535925 17592186045417 true] [17592186543539 1069 "q-123053" 13194139535925 17592186045417 true] [17592186543539 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543539 1071 "![](images/fe/fe238b0f1c4a9c34f569c9f4c4655f4a6094ee00a225a0d418fff7276705060d.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139535925 17592186045417 true] [17592186543539 1072 #uuid "a3ec1567-3655-5115-83b3-81bdfee12880" 13194139535925 17592186045417 true] [17592186543539 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNow, notice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=2\n$$\n\nand\n\n$$\n\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=6.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =2\\cdot {M}_{11}+2\\cdot {M}_{21}+6\\cdot {M}_{12}+6\\cdot {M}_{22} \\\\  & =2{M}_{11}+2{M}_{21}+6{M}_{12}+6{M}_{22}.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543540 1068 #edb/ref 17592186543385 13194139535925 17592186045417 true] [17592186543540 1069 "q-45486" 13194139535925 17592186045417 true] [17592186543540 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543540 1071 "Solve the equation ${5}^{x}=\\frac{1}{125}.$" 13194139535925 17592186045417 true] [17592186543540 1072 #uuid "a79b6cc2-bbc0-53f7-9fa7-3b0e82f61fd9" 13194139535925 17592186045417 true] [17592186543540 1074 "First, we rewrite $125$ as ${5}^{3}$ to get:\n\n$$\n\\begin{aligned}{5}^{x} & =\\frac{1}{125} \\\\ {5}^{x} & =\\frac{1}{{5}^{3}} \\\\ {5}^{x} & ={5}^{-3}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(5)$, we equate the exponents:\n\n$$\n\\begin{aligned}{5}^{x} & ={5}^{-3} \\\\ x & =-3\\end{aligned}\n$$\n\nTherefore, the solution is $x=-3.$" 13194139535925 17592186045417 true] [17592186543541 1068 #edb/ref 17592186543332 13194139535925 17592186045417 true] [17592186543541 1069 "q-1110" 13194139535925 17592186045417 true] [17592186543541 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543541 1071 "Express $\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y)$ as a single logarithm." 13194139535925 17592186045417 true] [17592186543541 1072 #uuid "a8ef19a1-f2fa-5f29-a4ae-a1f3f6bb227d" 13194139535925 17592186045417 true] [17592186543541 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{2}{log}_{5}⁡(x)-5{log}_{5}⁡(y) & ={log}_{5}⁡({x}^{1/2})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡(\\sqrt{x})-{log}_{5}⁡({y}^{5}) \\\\  & ={log}_{5}⁡(\\frac{\\sqrt{x}}{{y}^{5}}).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543542 1068 #edb/ref 17592186543360 13194139535925 17592186045417 true] [17592186543542 1068 #edb/ref 17592186543371 13194139535925 17592186045417 true] [17592186543542 1069 "q-338486" 13194139535925 17592186045417 true] [17592186543542 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543542 1071 "![](images/25/2593d513ce130090a84cc26e71bf321960712a6ccb2d8ff82e55e4728cc0657c.png)\n\nThe graph above shows the curve $y=2{cos}^{2}⁡x$ and the curve $y=\\operatorname{cos}⁡x$ on the interval $0\\le x<2\\pi .$ The curves intersect at the points $A,B,C,$ and $D,$ as shown. Determine the exact values of the $x$-coordinates of points $A$ and $D,$ in radians.\n\nThe $x$-coordinate of point $A$ is\n{{field-1}}\nand the $x$-coordinate of point $D$ is\n{{field-2}}." 13194139535925 17592186045417 true] [17592186543542 1072 #uuid "aa82973f-2912-57c5-acdd-b4b8b9abbe44" 13194139535925 17592186045417 true] [17592186543542 1074 "At the intersection points, the $y$ values of both graphs are the same. This gives the equation $2{cos}^{2}⁡x=\\operatorname{cos}⁡x.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}2{cos}^{2}⁡x & =\\operatorname{cos}⁡x \\\\ 2{cos}^{2}⁡x-\\operatorname{cos}⁡x & =0 \\\\ \\operatorname{cos}⁡x(2\\operatorname{cos}⁡x-1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{cos}⁡x=0,\\,2\\operatorname{cos}⁡x-1=0.\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{cos}⁡x=0.$ The solutions to this equation for $0\\le x<2\\pi $ are $x=\\frac{\\pi }{2},\\,\\frac{3\\pi }{2}.$\n\n- Then, we solve $2\\operatorname{cos}⁡x-1=0,$ or equivalently $\\operatorname{cos}⁡x=\\frac{1}{2}.$ The solutions to this equation for $0\\le x<2\\pi $ are $x=\\frac{\\pi }{3},\\,\\frac{5\\pi }{3}.$\n\nCombining the solutions and ordering them from smallest to largest, we obtain\n\n$$\n{x}_{1}=\\frac{\\pi }{3},\\,{x}_{2}=\\frac{\\pi }{2},\\,{x}_{3}=\\frac{3\\pi }{2},\\,{x}_{4}=\\frac{5\\pi }{3}.\n$$\n\nTherefore, the $x$-coordinate of point $A$ is\n$\\frac{\\pi }{3}$\nand the $x$-coordinate of point $D$ is\n$\\frac{5\\pi }{3}.$" 13194139535925 17592186045417 true] [17592186543543 1068 #edb/ref 17592186543352 13194139535925 17592186045417 true] [17592186543543 1069 "q-121231" 13194139535925 17592186045417 true] [17592186543543 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543543 1071 "Which of the following is the graph of the polar curve $r=8\\operatorname{sin}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543543 1072 #uuid "aac4981c-3e93-5227-8d9f-16b46e3776f7" 13194139535925 17592186045417 true] [17592186543543 1074 "The polar equation $r=2a\\operatorname{sin}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(0,a).$\n\nIn our case, we have $r=8\\operatorname{sin}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{8}{2}=4.\n$$\n\nTherefore, the equation $r=8\\operatorname{sin}⁡\\theta $ gives a circle of radius $|4|=4$ centered at the point $(0,4),$ as shown below.\n\n![](images/3b/3b15873d4cd95216db84ecccbad4394397469c501745663605c3ac360c2d723e.png)" 13194139535925 17592186045417 true] [17592186543544 1068 #edb/ref 17592186543313 13194139535925 17592186045417 true] [17592186543544 1069 "q-159961" 13194139535925 17592186045417 true] [17592186543544 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543544 1071 "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4},{X}_{5}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,{1}^{2}),$ where $\\theta $ is an unknown mean. The log-likelihood function of the sample $0.7,\\,0.6,\\,-0.5,\\,1.7,\\,-1.1$ is\n\n$$\nl(\\theta )=-2.5\\operatorname{ln}⁡(2\\pi )+a+b\\theta +c{\\theta }^{2}\n$$\n\nWhat is the value of $a+b+c?$" 13194139535925 17592186045417 true] [17592186543544 1072 #uuid "aaf34c24-70f2-59f0-ad3e-3eb728abaa5d" 13194139535925 17592186045417 true] [17592186543544 1074 "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i};\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i};\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=5$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x,\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nNext, we write down the log-density function:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡f(x,\\theta ) & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2}) \\\\  & =\\operatorname{ln}⁡(\\frac{1}{\\sqrt{2\\pi }})+\\operatorname{ln}⁡({e}^{-(x-\\theta )^{2}/2}) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{(x-\\theta )^{2}}{2}.\\end{aligned}\n$$\n\nNow, we can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}(-\\frac{1}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{({x}_{i}-\\theta )^{2}}{2}) \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-{\\sum }_{i=1}^{n}\\frac{({x}_{i}-\\theta )^{2}}{2} \\\\  & =-\\frac{n}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}({\\sum }_{i=1}^{n}{x}_{i}^{2}-2\\theta {\\sum }_{i=1}^{n}{x}_{i}+n{\\theta }^{2})\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.7+0.6+(-0.5)+1.7+(-1.1) \\\\  & =1.4 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.7)^{2}+(0.6)^{2}+(-0.5)^{2}+(1.7)^{2}+(-1.1)^{2} \\\\  & =5.2\\end{aligned}\n$$\n\nand $n=5.$ Therefore,  \n\n$$\n\\begin{aligned}l(\\theta ) & =-\\frac{5}{2}\\operatorname{ln}⁡(2\\pi )-\\frac{1}{2}(5.2-2\\theta \\cdot (1.4)+5{\\theta }^{2}) \\\\  & =-2.5\\operatorname{ln}⁡(2\\pi )+(-2.6)+(1.4)\\theta +(-2.5){\\theta }^{2}.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b+c=-2.6+(1.4)+(-2.5)=-3.7.\n$$" 13194139535925 17592186045417 true] [17592186543545 1068 #edb/ref 17592186543364 13194139535925 17592186045417 true] [17592186543545 1069 "q-100023" 13194139535925 17592186045417 true] [17592186543545 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543545 1071 "If $\\operatorname{log}⁡(x)=5,$ what is $\\operatorname{log}⁡({x}^{6})?$" 13194139535925 17592186045417 true] [17592186543545 1072 #uuid "abb937a1-e6d0-5e25-8254-46eecc862782" 13194139535925 17592186045417 true] [17592186543545 1074 "First, let's recall the power rule for logarithms:\n\n$$\n\\operatorname{log}⁡({c}^{m})=m\\operatorname{log}⁡(c)\n$$\n\nUsing the power rule for logarithms and the information given, we get\n\n$$\n\\begin{aligned}\\operatorname{log}⁡({x}^{6}) & =6\\cdot \\operatorname{log}⁡(x) \\\\  & =6\\cdot 5 \\\\  & =30.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543546 1068 #edb/ref 17592186543327 13194139535925 17592186045417 true] [17592186543546 1069 "q-250665" 13194139535925 17592186045417 true] [17592186543546 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543546 1071 "Consider the following geometric sequence:\n\n$$\n-4,\\,16,\\,-64,\\,256,\\,…\n$$\n\nThe fifth term of this sequence is{{field-1}}." 13194139535925 17592186045417 true] [17592186543546 1072 #uuid "abfcac51-46f8-5836-b296-e3921e8850cc" 13194139535925 17592186045417 true] [17592186543546 1074 "![](images/84/84c714b0c37c7f28cb83c59e3455755470ff6aa69da145c80ccea19200b1ad8f.png)\n\nNotice that the sequence is geometric, with a common ratio of \n\n$$\nr=\\frac{16}{(-4)}=-4.\n$$\n\nSo, we can get each term by multiplying the previous term by $-4.$ \n\nContinuing to list terms of the sequence until we get to the $5$th term, we obtain the following:\n\n![](images/40/400ef822bd63631f65a4190f8367e84878c03a302c3202a112e9de2858ae4249.png)\n\nTherefore, the $5$th term is $-1\\,024.$" 13194139535925 17592186045417 true] [17592186543547 1068 #edb/ref 17592186543342 13194139535925 17592186045417 true] [17592186543547 1069 "q-108201" 13194139535925 17592186045417 true] [17592186543547 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543547 1071 "If $\\operatorname{log}⁡(y)=k$ and $\\operatorname{log}⁡(\\frac{y}{x})=m$, then $\\operatorname{log}⁡(x)=$" 13194139535925 17592186045417 true] [17592186543547 1072 #uuid "ada9c1dd-522d-5138-9cfe-44ee7af19872" 13194139535925 17592186045417 true] [17592186543547 1074 "First, let's recall the quotient rule for logarithms:\n\n$$\n{log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})\n$$\n\nUsing the quotient rule for logarithms, we have\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(x) & =\\operatorname{log}⁡(\\frac{y}{(\\frac{y}{x})}) \\\\  & =\\operatorname{log}⁡(y)-\\operatorname{log}⁡(\\frac{y}{x}) \\\\  & =k-m.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543548 1068 #edb/ref 17592186543439 13194139535925 17592186045417 true] [17592186543548 1069 "q-8422" 13194139535925 17592186045417 true] [17592186543548 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543548 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡(2x+\\frac{\\pi }{6})=-\\frac{1}{2}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139535925 17592186045417 true] [17592186543548 1072 #uuid "af242b6e-a0fa-5102-becb-649e55619922" 13194139535925 17592186045417 true] [17592186543548 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{6} & =-\\frac{2\\pi }{3}+2n\\pi , & \\, & \\, & 2x+\\frac{\\pi }{6} & =\\frac{2\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{\\pi }{2}+2n\\pi  \\\\ x & =-\\frac{5\\pi }{12}+n\\pi  & \\, & \\, & x & =\\frac{\\pi }{4}+n\\pi  \\\\ x & =\\frac{(12n-5)\\pi }{12} & \\, & \\, & x & =\\frac{(4n+1)\\pi }{4}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=-\\frac{5\\pi }{12}$ and $x=\\frac{\\pi }{4}.$ We reject $-\\frac{5\\pi }{12}$ since it lies outside the domain of interest.\n\n- Setting $n=1$ gives $x=\\frac{7\\pi }{12}$ and $x=\\frac{5\\pi }{4}.$ We reject $\\frac{5\\pi }{4}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0<x\\le \\pi .$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{4}\\cdot \\frac{7\\pi }{12}=\\frac{7{\\pi }^{2}}{48}.\n$$" 13194139535925 17592186045417 true] [17592186543549 1068 #edb/ref 17592186543458 13194139535925 17592186045417 true] [17592186543549 1069 "q-100019" 13194139535925 17592186045417 true] [17592186543549 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543549 1071 "$7{log}_{2}⁡t=$" 13194139535925 17592186045417 true] [17592186543549 1072 #uuid "b071d322-d430-5f91-b157-0d44ee6fac29" 13194139535925 17592186045417 true] [17592186543549 1074 "First, let's recall the power rule for logarithms:\n\n$$\n\\operatorname{log}⁡({c}^{m})=m\\operatorname{log}⁡(c)\n$$\n\nUsing the power rule for logarithms, we obtain\n\n$$\n7{log}_{2}⁡t={log}_{2}⁡({t}^{7}).\n$$" 13194139535925 17592186045417 true] [17592186543550 1068 #edb/ref 17592186543401 13194139535925 17592186045417 true] [17592186543550 1069 "q-134812" 13194139535925 17592186045417 true] [17592186543550 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543550 1071 "![](images/24/243a4212d1128a79203493bf672ad1c956fe0f48aad6abbb910de2861d99669c.png)\n\nA dog food company records data on the number of dogs $(x)$ sheltered at some kennels across the country and the corresponding amount of dog food $y$ (in kilograms) consumed in a month. The scatter plot for the data and the corresponding linear regression line are shown above. \n\nAccording to the regression model, what is the residual for the highlighted data point?" 13194139535925 17592186045417 true] [17592186543550 1072 #uuid "b2848e9c-e485-5752-8daf-a5d57b496ccb" 13194139535925 17592186045417 true] [17592186543550 1074 "The residual equals the difference between the actual value of the dependent variable and the value estimated using the linear regression model:\n\n$$\n\\text{Residual}=\\text{Actual}-\\text{Estimated}\n$$\n\n \n\nThe highlighted datapoint has coordinates $(10,175).$ So, our actual value is $y=175.$\n\nOn the other hand, the point on the regression line that corresponds to $x=10$ has the $y$-coordinate $200.$ So, our estimated value is $\\overset{^}{y}=200.$\n\n![](images/2c/2cd59a9ae9c7ad474a9d5a308d4b8f3c9b96be70acdf1e3613dfc4757ff01766.png)\n\nAs a result, \n\n$$\n\\begin{aligned}\\text{Residual} & =\\text{Actual}-\\text{Estimated} \\\\  & =y-\\overset{^}{y} \\\\  & =175-200 \\\\  & =-25.\\end{aligned}\n$$\n\nTherefore, the residual is $-25\\,kg.$" 13194139535925 17592186045417 true] [17592186543551 1068 #edb/ref 17592186543292 13194139535925 17592186045417 true] [17592186543551 1069 "q-130714" 13194139535925 17592186045417 true] [17592186543551 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543551 1071 "Given that $X$ is a random variable such that $X∼U[3,8],$ find $\\text{SD}[X].$ Round your answer to three decimal places." 13194139535925 17592186045417 true] [17592186543551 1072 #uuid "b5a32830-d248-5fc8-bc7e-b05512cbde4a" 13194139535925 17592186045417 true] [17592186543551 1074 "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=3$ and $b=8.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(8-3)^{2}}{12}=\\frac{25}{12}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{25}{12}}=\\frac{5\\sqrt{3}}{6}≈1.443.\n$$" 13194139535925 17592186045417 true] [17592186543552 1068 #edb/ref 17592186543391 13194139535925 17592186045417 true] [17592186543552 1069 "q-121354" 13194139535925 17592186045417 true] [17592186543552 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543552 1071 "The polar curve $r=k\\operatorname{cos}⁡\\theta ,$ where $k$ is a constant, passes through the point $A$ with Cartesian coordinates $(-1,\\sqrt{3}).$ What is the value of $k?$" 13194139535925 17592186045417 true] [17592186543552 1072 #uuid "b69fb899-dda9-520e-9df1-5f655ac32f35" 13194139535925 17592186045417 true] [17592186543552 1074 "First, we find the polar coordinates of the point $A.$ The distance from $A$ to the origin is\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(\\sqrt{3})}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nNow, since $A$ lies in the second quadrant, we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\pi -\\operatorname{arctan}⁡|-\\frac{\\sqrt{3}}{1}| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nSo, the polar coordinates of $A$ are $(r,\\theta )=(2,\\frac{2\\pi }{3}).$ \n\nTo find the value of $k$, we substitute the polar coordinates of the point $A$ into the polar equation of the curve:\n\n$$\n\\begin{aligned}r & =k\\operatorname{cos}⁡\\theta  \\\\ 2 & =k\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\ 2 & =k(-\\frac{1}{2}) \\\\ k & =-4\\end{aligned}\n$$\n\nTherefore, the equation of the curve is $r=-4\\operatorname{cos}⁡\\theta ,$ as shown below.\n\n![](images/f8/f85ddaa01b6f2232627375ec622232a245c6e7e21fb9e294cd0801fd45433d73.png)" 13194139535925 17592186045417 true] [17592186543553 1068 #edb/ref 17592186543463 13194139535925 17592186045417 true] [17592186543553 1069 "q-109800" 13194139535925 17592186045417 true] [17592186543553 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543553 1071 "Which of the sequences below are geometric sequences?\n\nI. $2,\\,4,\\,10,\\,…$\n\nII. $-5,\\,10,\\,-20,\\,…$\n\nIII. $1,\\,-4,\\,-16,\\,…$" 13194139535925 17592186045417 true] [17592186543553 1072 #uuid "b85423f1-a316-59dd-932f-ac0693226903" 13194139535925 17592186045417 true] [17592186543553 1074 "A sequence is geometric if there is a common ratio between its terms. Let's check each sequence in turn.\n\n- Sequence I is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{4}{2}=2 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{10}{4}=\\frac{5}{2}\\end{aligned}\n$$\n\n- Sequence II is geometric. For each pair of consecutive terms, the common ratio is the same:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{10}{(-5)}=-2 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-20)}{10}=-2\\end{aligned}\n$$\n\n- Sequence III is not geometric because not every pair of consecutive terms has the same ratio. To see this, we only need to go up to the third term:\n\n$$\n\\begin{aligned}\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-4)}{1}=-4 \\\\ \\frac{{a}_{3}}{{a}_{2}} & =\\frac{(-16)}{(-4)}=4\\end{aligned}\n$$\n\nIn conclusion, only sequence II could be a geometric sequence." 13194139535925 17592186045417 true] [17592186543554 1068 #edb/ref 17592186543347 13194139535925 17592186045417 true] [17592186543554 1069 "q-105467" 13194139535925 17592186045417 true] [17592186543554 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543554 1071 "Let $V={R}_{1}[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1),\n$$\n\nfind the distance between $f(t)=4t$ and $g(t)=3t-3$ with respect to the inner product." 13194139535925 17592186045417 true] [17592186543554 1072 #uuid "bb47ff23-1630-5500-b6a4-5200379ffde8" 13194139535925 17592186045417 true] [17592186543554 1074 "The distance between $f(t)=4t$ and $g(t)=3t-3$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖4t-(3t-3)‖ \\\\  & =‖t+3‖ \\\\  & =\\sqrt{⟨t+3,t+3⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨t+3,t+3⟩ & =(t+3){|}_{0}\\cdot (t+3){|}_{0}+(t+3){|}_{1}\\cdot (t+3){|}_{1} \\\\  & =3\\cdot 3+4\\cdot 4 \\\\  & =25.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{25}=5.$" 13194139535925 17592186045417 true] [17592186543555 1068 #edb/ref 17592186543413 13194139535925 17592186045417 true] [17592186543555 1068 #edb/ref 17592186543451 13194139535925 17592186045417 true] [17592186543555 1069 "q-339149" 13194139535925 17592186045417 true] [17592186543555 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543555 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $cos\\,(x+\\frac{\\pi }{6})=\\frac{1}{2},$ for $0\\le x<2\\pi ,$ are\n\n${x}_{1}=$ \n{{field-1}}, $\\,{x}_{2}=$ \n{{field-2}}." 13194139535925 17592186045417 true] [17592186543555 1072 #uuid "bf7fd672-fd24-5897-b0f7-1572fe68c96d" 13194139535925 17592186045417 true] [17592186543555 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}x+\\frac{\\pi }{6} & =\\frac{\\pi }{3}+n\\cdot 2\\pi , & \\, & \\, & x+\\frac{\\pi }{6} & =\\frac{5\\pi }{3}+n\\cdot 2\\pi .\\end{aligned}\n$$\n\nSolving our two equations for $x$ gives:\n\n$$\n\\begin{aligned}x & =\\frac{\\pi }{3}-\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & x & =\\frac{5\\pi }{3}-\\frac{\\pi }{6}+n\\cdot 2\\pi  \\\\ x & =\\frac{\\pi }{6}+n\\cdot 2\\pi  & \\, & \\, & x & =\\frac{3\\pi }{2}+n\\cdot 2\\pi \\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{6}$ and $x=\\frac{3\\pi }{2}.$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$\n\nSo, the solutions to the equation, in ascending order, are \n\n$$\n{x}_{1}=\\frac{\\pi }{6},\\,{x}_{2}=\\frac{3\\pi }{2}.\n$$" 13194139535925 17592186045417 true] [17592186543556 1068 #edb/ref 17592186543430 13194139535925 17592186045417 true] [17592186543556 1069 "q-121537" 13194139535925 17592186045417 true] [17592186543556 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543556 1071 "Consider the equation $2\\sqrt{3}\\operatorname{cos}⁡(\\frac{5x}{2})+3=0$ for $0\\le x<2\\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ and ${x}_{5}$ are written in ascending order, what is the value of ${x}_{1}\\cdot {x}_{3}?$" 13194139535925 17592186045417 true] [17592186543556 1072 #uuid "c08c7d82-b9b5-59ff-a4f6-2f1eac5d7e57" 13194139535925 17592186045417 true] [17592186543556 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}2\\sqrt{3}\\operatorname{cos}⁡(\\frac{5x}{2})+3 & =0 \\\\ 2\\sqrt{3}\\operatorname{cos}⁡(\\frac{5x}{2}) & =-3 \\\\ \\operatorname{cos}⁡(\\frac{5x}{2}) & =-\\frac{3}{2\\sqrt{3}} \\\\ \\operatorname{cos}⁡(\\frac{5x}{2}) & =-\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}\\frac{5x}{2} & =\\frac{5\\pi }{6}+2n\\pi , & \\, & \\, & \\frac{5x}{2} & =\\frac{7\\pi }{6}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}5x & =\\frac{5\\pi }{3}+4n\\pi  & \\, & \\, & 5x & =\\frac{7\\pi }{3}+4n\\pi  \\\\ x & =\\frac{\\pi }{3}+\\frac{4n\\pi }{5} & \\, & \\, & x & =\\frac{7\\pi }{15}+\\frac{4n\\pi }{5} \\\\ x & =\\frac{(12n+5)\\pi }{15} & \\, & \\, & x & =\\frac{(12n+7)\\pi }{15}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{3}$ and $x=\\frac{7\\pi }{15}$\n\n- Setting $n=1$ gives $x=\\frac{17\\pi }{15}$  and $x=\\frac{19\\pi }{15}.$\n\n- Setting $n=2$ gives $x=\\frac{29\\pi }{15}$  and $x=\\frac{31\\pi }{15}.$ We reject the solution $\\frac{31\\pi }{15}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4},{x}_{5}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{3},\\,\\frac{7\\pi }{15},\\,\\frac{17\\pi }{15},\\,\\frac{19\\pi }{15},\\,\\frac{29\\pi }{15}.\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{3}=\\frac{\\pi }{3}\\cdot \\frac{17\\pi }{15}=\\frac{17{\\pi }^{2}}{45}.\n$$" 13194139535925 17592186045417 true] [17592186543557 1068 #edb/ref 17592186543337 13194139535925 17592186045417 true] [17592186543557 1069 "q-130712" 13194139535925 17592186045417 true] [17592186543557 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543557 1071 "Given that $X$ is a random variable such that $X∼U[-8,1],$ find $\\text{Var}[X].$" 13194139535925 17592186045417 true] [17592186543557 1072 #uuid "c8776b39-34f7-5d7c-be21-f79bcc825464" 13194139535925 17592186045417 true] [17592186543557 1074 "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-8$ and $b=1.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(1-(-8))^{2}}{12}=\\frac{81}{12}=\\frac{27}{4}.\n$$" 13194139535925 17592186045417 true] [17592186543558 1068 #edb/ref 17592186543296 13194139535925 17592186045417 true] [17592186543558 1069 "q-8416" 13194139535925 17592186045417 true] [17592186543558 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543558 1071 "Consider the equation $\\operatorname{cos}⁡(2x+\\frac{\\pi }{6})=\\frac{1}{2}$ for $0\\le x<2\\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the value of ${x}_{2}\\cdot {x}_{3}?$" 13194139535925 17592186045417 true] [17592186543558 1072 #uuid "cd740014-1051-58c1-bf02-d54c44856f2e" 13194139535925 17592186045417 true] [17592186543558 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{\\pi }{6} & =\\frac{\\pi }{3}+2n\\pi , & \\, & \\, & 2x+\\frac{\\pi }{6} & =\\frac{5\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =\\frac{\\pi }{3}-\\frac{\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{5\\pi }{3}-\\frac{\\pi }{6}+2n\\pi  \\\\ 2x & =\\frac{\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{3\\pi }{2}+2n\\pi  \\\\ x & =\\frac{\\pi }{12}+n\\pi  & \\, & \\, & x & =\\frac{3\\pi }{4}+n\\pi  \\\\ x & =\\frac{(1+12n)\\pi }{12} & \\, & \\, & x & =\\frac{(3+4n)\\pi }{4}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<2\\pi .$\n\n- Setting $n=0$ gives $x=\\frac{\\pi }{12}$ and $x=\\frac{3\\pi }{4}$\n\n- Setting $n=1$ gives $x=\\frac{13\\pi }{12}$  and $x=\\frac{7\\pi }{4}$\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<2\\pi .$ So, the solutions ${x}_{1},{x}_{2},{x}_{3},{x}_{4}$ (written in ascending order) are\n\n$$\nx=\\frac{\\pi }{12},\\,\\frac{3\\pi }{4},\\,\\frac{13\\pi }{12},\\,\\frac{7\\pi }{4}.\n$$\n\nFinally,\n\n$$\n{x}_{2}\\cdot {x}_{3}=\\frac{3\\pi }{4}\\cdot \\frac{13\\pi }{12}=\\frac{13{\\pi }^{2}}{16}.\n$$" 13194139535925 17592186045417 true] [17592186543559 1068 #edb/ref 17592186543376 13194139535925 17592186045417 true] [17592186543559 1069 "q-65411" 13194139535925 17592186045417 true] [17592186543559 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543559 1071 "Consider the equation $\\operatorname{sin}⁡x\\operatorname{sec}⁡x-2\\operatorname{sin}⁡x=0$ for $0\\le x\\le \\pi .$ If the solutions ${x}_{1},{x}_{2},{x}_{3}$ are written in ascending order, then what is ${x}_{2}\\cdot {x}_{3}?$" 13194139535925 17592186045417 true] [17592186543559 1072 #uuid "cf8eafa9-ba3d-54d7-ae84-18acaa32c81c" 13194139535925 17592186045417 true] [17592186543559 1074 "Note that the function $\\operatorname{sec}⁡x$ is not defined at the points where $\\operatorname{cos}⁡x=0.$ In the given interval, the excluded value is $x=\\frac{\\pi }{2}.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x\\operatorname{sec}⁡x-2\\operatorname{sin}⁡x & =0 \\\\ \\operatorname{sin}⁡x(\\operatorname{sec}⁡x-2) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations: \n\n$$\n\\operatorname{sin}⁡x=0,\\,\\operatorname{sec}⁡x-2=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sin}⁡x=0.$ The solutions to this equation for $0\\le x\\le \\pi $  are $x=0,\\,\\pi .$\n\n- Then, we solve $\\operatorname{sec}⁡x-2=0,$ or equivalently $\\operatorname{sec}⁡x=2.$ The solution to this equation for $0\\le x\\le \\pi $ is $x=\\frac{\\pi }{3}.$\n\nCombining all solutions from both equations, we get\n\n$$\n{x}_{1}=0,\\,{x}_{2}=\\frac{\\pi }{3},\\,{x}_{3}=\\pi .\n$$\n\nFinally, \n\n$$\n{x}_{2}\\cdot {x}_{3}=\\frac{\\pi }{3}\\cdot \\pi =\\frac{{\\pi }^{2}}{3}.\n$$" 13194139535925 17592186045417 true] [17592186543560 1068 #edb/ref 17592186543301 13194139535925 17592186045417 true] [17592186543560 1069 "q-123231" 13194139535925 17592186045417 true] [17592186543560 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543560 1071 "Let $R=[1,4]\\times [2,4]$ be a region in the $xy$-plane, and let $f(x,y)=16-xy.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{1,2,3,4\\},\\,{P}_{2}=\\{2,4\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" 13194139535925 17592186045417 true] [17592186543560 1072 #uuid "d30a7455-cf28-573b-a7f5-088c618e903c" 13194139535925 17592186045417 true] [17592186543560 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/de/deff4f8b668e3c7327d92132f579c16d1f99dd5b52603b2f6afe6b7c6c5b7bb6.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{31}\\cdot \\text{Area}({R}_{31}),\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=2$ for all $3$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =2\\cdot {M}_{11}+2\\cdot {M}_{21}+2\\cdot {M}_{31} \\\\  & =2({M}_{11}+{M}_{21}+{M}_{31}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=16-xy$ decreases as $x$ increases, and\n\n- $f(x,y)=16-xy$ decreases as $y$ increases.\n\n![](images/21/21cd2d1c002e5b66100396f9e4d5708b8ffd7fd2b9b6cc7b7078cd5507011a0d.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/9e/9ebca45ee50cf0fe5f91e21427524600b26a512f10340c18c995c16f9cfe372d.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(1,2)=14 \\\\ {M}_{21} & =f(2,2)=12 \\\\ {M}_{31} & =f(3,2)=10\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =2(14+12+10) \\\\  & =72.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543561 1068 #edb/ref 17592186543450 13194139535925 17592186045417 true] [17592186543561 1069 "q-281480" 13194139535925 17592186045417 true] [17592186543561 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543561 1071 "![](images/49/49238b18533c2ded8180a8532325f14c3b052fb32c58a81892877fba2a4ee054.png)\n\nThe polar equation of the given curve is $r=${{field-1}}." 13194139535925 17592186045417 true] [17592186543561 1072 #uuid "d345ebc0-fb4a-55bd-95ea-a1eddcced6e5" 13194139535925 17592186045417 true] [17592186543561 1074 "The diagram shows a circle of radius $|a|=|-6|=6$ centered at the point $(-6,0).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{cos}⁡\\theta  \\\\  & =2\\cdot (-6)\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =-12\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543562 1068 #edb/ref 17592186543428 13194139535925 17592186045417 true] [17592186543562 1069 "q-134798" 13194139535925 17592186045417 true] [17592186543562 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543562 1071 "![](images/b3/b375c1e162a9f1c2892903c20606921673498579f9b41f633447832fd3ea2192.png)\n\nThe scatter plot for the data sets $x$ and $y$ of paired observations and the corresponding linear regression line are shown above.\n\nAccording to the regression model, what is the residual for the highlighted datapoint?" 13194139535925 17592186045417 true] [17592186543562 1072 #uuid "d6509173-6968-54cb-999d-d5fe096ebbff" 13194139535925 17592186045417 true] [17592186543562 1074 "The residual equals the difference between the actual value of the dependent variable and the value estimated using the linear regression model:\n\n$$\n\\text{Residual}=\\text{Actual}-\\text{Estimated}\n$$\n\n \n\nThe highlighted datapoint has coordinates $(4,70).$ So, our actual value is $y=70.$\n\nOn the other hand, the point on the regression line that corresponds to $x=4$ has the $y$-coordinate $50.$ So, our estimated value of is $\\overset{^}{y}=50.$\n\n![](images/04/041f64255345edf7ac37bd61e0ab97a93cc2696f028a53ba0896e0659966c2d8.png)\n\n \n\nTherefore, the residual is\n\n$$\n\\begin{aligned}\\text{Residual} & =\\text{Actual}-\\text{Estimated} \\\\  & =y-\\overset{^}{y} \\\\  & =70-50 \\\\  & =20.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543303 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543315 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543359 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543363 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543374 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543434 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543435 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543446 13194139535925 17592186045417 true] [17592186543563 1068 #edb/ref 17592186543447 13194139535925 17592186045417 true] [17592186543563 1069 "q-355958" 13194139535925 17592186045417 true] [17592186543563 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543563 1071 "Suppose we have a dataset consisting of $5$ datapoints with $3$ features in the form of the $5\\times 3$ matrix\n\n$$\nX=[\\begin{aligned}0.795 & -5.044 & 1.480 \\\\ 2.471 & -4.893 & 1.132 \\\\ 2.589 & -6.272 & -0.161 \\\\ 0.548 & -6.608 & 1.020 \\\\ 5.379 & -3.807 & 3.126\\end{aligned}]\n$$\n\nWe wish to reduce the dimensionality of the dataset while still preserving as much variance as possible.\n\nSelect the correct options in the following reasoning that walks through the process of reducing the dimensionality of the dataset.\n\nWe will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is \n{{field-1}} \nwith the \n{{field-2}} \nvariance.\n\nThe second principal component is the direction in feature space \n{{field-3}} \nto the first\n{{field-4}}. \n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to {{field-5}}.\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}-0.81 & 0.25 & 0.14 \\\\ 0.06 & 0.38 & -0.16 \\\\ 0.12 & -0.84 & -1.25 \\\\ -0.94 & -1.13 & -0.25 \\\\ 1.57 & 1.34 & 1.53\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}-0.066 & 0.590 & -0.424 & -0.067 & 0.680 \\\\ 0.055 & -0.056 & -0.505 & 0.841 & -0.178 \\\\ -0.374 & -0.731 & -0.063 & 0.057 & 0.565 \\\\ -0.430 & 0.317 & 0.675 & 0.487 & 0.152 \\\\ 0.817 & -0.116 & 0.325 & 0.220 & 0.405\\end{aligned}], \\\\ Σ & =[\\begin{aligned}3.124 & 0 & 0 \\\\ 0 & 1.309 & 0 \\\\ 0 & 0 & 0.738 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}0.544 & -0.802 & 0.248 \\\\ 0.608 & 0.173 & -0.775 \\\\ 0.578 & 0.572 & 0.581\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe fraction of variance preserved by projecting the data onto the first principal component is \n{{field-6}}.\n\nThe fraction of variance preserved by projecting the data onto the first two principal components is \n{{field-7}}.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to \n{{field-8}}.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={{field-9}}.\n$$" 13194139535925 17592186045417 true] [17592186543563 1072 #uuid "d96fd40c-87e8-5ffa-bd33-b4b724c33445" 13194139535925 17592186045417 true] [17592186543563 1074 "We will use principal component analysis to reduce the dimensionality of the dataset. The first principal component is $\\text{the direction in feature space}$ with the $\\text{most}$ variance.\n\nThe second principal component is the direction $\\text{orthogonal}$ to the first $\\text{principal component}.$\n\nIn order to reduce the dimensionality of the dataset, we will project the data onto the first few principal components, picking the number of components based on the amount of cumulative variance preserved.\n\nThe first step is to $\\text{standardize the data}.$\n\nThe standardized data matrix is\n\n$$\n{X}_{\\text{std}}=[\\begin{aligned}-0.81 & 0.25 & 0.14 \\\\ 0.06 & 0.38 & -0.16 \\\\ 0.12 & -0.84 & -1.25 \\\\ -0.94 & -1.13 & -0.25 \\\\ 1.57 & 1.34 & 1.53\\end{aligned}].\n$$\n\nThe SVD of the standardized data matrix is\n\n$$\n\\begin{aligned}{X}_{\\text{std}} & =UΣ{V}^{T},\\,\\text{where} \\\\ U & =[\\begin{aligned}-0.066 & 0.590 & -0.424 & -0.067 & 0.680 \\\\ 0.055 & -0.056 & -0.505 & 0.841 & -0.178 \\\\ -0.374 & -0.731 & -0.063 & 0.057 & 0.565 \\\\ -0.430 & 0.317 & 0.675 & 0.487 & 0.152 \\\\ 0.817 & -0.116 & 0.325 & 0.220 & 0.405\\end{aligned}], \\\\ Σ & =[\\begin{aligned}3.124 & 0 & 0 \\\\ 0 & 1.309 & 0 \\\\ 0 & 0 & 0.738 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}], \\\\ V & =[\\begin{aligned}0.544 & -0.802 & 0.248 \\\\ 0.608 & 0.173 & -0.775 \\\\ 0.578 & 0.572 & 0.581\\end{aligned}].\\end{aligned}\n$$\n\nWe compute the cumulative variance preserved for different numbers of components.\n\nThe variance along a principal component is equal to the corresponding eigenvalue of the covariance matrix, which is proportional to the square of the corresponding singular value of the data matrix.\n\n- The fraction of variance preserved by projecting the data onto the first principal component is \n\n$$\n\\frac{{3.124}^{2}}{{3.124}^{2}+{1.309}^{2}+{0.738}^{2}}≈81.2%.\n$$\n\n- The fraction of variance preserved by projecting the data onto the first two principal components is \n\n$$\n\\frac{{3.124}^{2}+{1.309}^{2}}{{3.124}^{2}+{1.309}^{2}+{0.738}^{2}}≈95.5%.\n$$\n\nThus, we have that \n\n- reducing the dataset to $1$ dimension would preserve $81.2%$ of the variance, while\n\n- reducing the dataset to $2$ dimensions would preserve $95.5%$ of the variance.\n\nIf we wish to preserve $90%$ of the variance, we should reduce the dataset to $2\\text{ dimensions}$ , since this is the minimum number of components that preserves at least $90%$ of the variance.\n\nWriting ${v}_{1},{v}_{2},{v}_{3}$ for the columns of $V$ and ${u}_{1},{u}_{2},{u}_{3},{u}_{4},{u}_{5}$ for the columns of $U$, the reduced dataset is\n\n$$\n{X}_{\\text{red}}={X}_{\\text{std}}\\cdot [\\begin{aligned}{v}_{1} & {v}_{2}\\end{aligned}],\n$$\n\nsince we need to project the data onto the first two principal components, which are the first two columns of $V.$\n\n**Note:** In order to invert the projection and interpret any further analysis in terms of the original features, we need to know the means and standard deviations of the original dataset $X.$ Additionally, in case we have more data, we can use the means and standard deviations of the original dataset to map the new data into the original feature space." 13194139535925 17592186045417 true] [17592186543564 1068 #edb/ref 17592186543443 13194139535925 17592186045417 true] [17592186543564 1069 "q-67450" 13194139535925 17592186045417 true] [17592186543564 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543564 1071 "Given that $8$, $2x$, and $x$ are the first three terms of a geometric sequence, find $x.$" 13194139535925 17592186045417 true] [17592186543564 1072 #uuid "d9c0d129-478a-533e-ada4-db9e83c26531" 13194139535925 17592186045417 true] [17592186543564 1074 "The first three terms are\n\n$$\n\\begin{aligned}{a}_{1}=8,\\,{a}_{2}=2x,\\,{a}_{3}=x.\\end{aligned}\n$$\n\nThe common ratio of the first two terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}}=\\frac{2x}{8}=\\frac{x}{4}.\\end{aligned}\n$$\n\nOn the other hand, the common ratio of the second and third terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}}=\\frac{x}{2x}=\\frac{1}{2}.\\end{aligned}\n$$\n\nSo, by equating the values for $r$ and solving for $x,$ we conclude that\n\n$$\n\\begin{aligned}\\frac{x}{4} & =\\frac{1}{2} \\\\ x & =\\frac{1}{2}\\cdot 4 \\\\ x & =2.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543565 1068 #edb/ref 17592186543316 13194139535925 17592186045417 true] [17592186543565 1069 "q-96543" 13194139535925 17592186045417 true] [17592186543565 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543565 1071 "Given that $X$ is a random variable such that $X∼U[-1,5],$ find $\\text{SD}[X].$ Round your answer to three decimal places." 13194139535925 17592186045417 true] [17592186543565 1072 #uuid "da016258-0a74-55d6-826a-b4bf1b04b20f" 13194139535925 17592186045417 true] [17592186543565 1074 "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-1$ and $b=5.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(5-(-1))^{2}}{12}=\\frac{36}{12}=3.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{3}≈1.732.\n$$" 13194139535925 17592186045417 true] [17592186543566 1068 #edb/ref 17592186543426 13194139535925 17592186045417 true] [17592186543566 1069 "q-17263" 13194139535925 17592186045417 true] [17592186543566 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543566 1071 "Which of the following is the graph of the polar curve $r=5\\operatorname{sin}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543566 1072 #uuid "daaf9013-5976-5a1b-a75f-74d8d2c1a5cd" 13194139535925 17592186045417 true] [17592186543566 1074 "The polar equation $r=2a\\operatorname{sin}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(0,a).$\n\nIn our case, we have $r=5\\operatorname{sin}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{5}{2}.\n$$\n\nTherefore, the equation $r=5\\operatorname{sin}⁡\\theta $ gives a circle of radius $|\\frac{5}{2}|=\\frac{5}{2}$ centered at the point $(0,2.5),$ as shown below.\n\n![](images/83/8375e6709a6a7f34183b821411aaa251341666f948164d498b012f07af744a45.png)" 13194139535925 17592186045417 true] [17592186543567 1068 #edb/ref 17592186543356 13194139535925 17592186045417 true] [17592186543567 1068 #edb/ref 17592186543437 13194139535925 17592186045417 true] [17592186543567 1068 #edb/ref 17592186543445 13194139535925 17592186045417 true] [17592186543567 1068 #edb/ref 17592186543460 13194139535925 17592186045417 true] [17592186543567 1069 "q-337172" 13194139535925 17592186045417 true] [17592186543567 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543567 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $\\operatorname{tan}⁡x\\operatorname{sin}⁡x=\\operatorname{sin}⁡x$ for $-\\pi \\le x<\\pi ,$  are\n\n${x}_{1}=$ \n{{field-1}}$,\\,{x}_{2}=$\n{{field-2}}$,\\,{x}_{3}=$ \n{{field-3}}$,\\,{x}_{4}=$\n{{field-4}}." 13194139535925 17592186045417 true] [17592186543567 1072 #uuid "df0bb882-2469-5cab-82f5-df4eee26a54c" 13194139535925 17592186045417 true] [17592186543567 1074 "Note that the function $\\operatorname{tan}⁡x$ is not defined at the points where $\\operatorname{cos}⁡x=0.$ In the given interval, the excluded values are $x=-\\frac{\\pi }{2},\\frac{\\pi }{2}.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡x\\operatorname{sin}⁡x & =\\operatorname{sin}⁡x \\\\ \\operatorname{tan}⁡x\\operatorname{sin}⁡x-\\operatorname{sin}⁡x & =0 \\\\ \\operatorname{sin}⁡x(\\operatorname{tan}⁡x-1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{sin}⁡x=0,\\,\\operatorname{tan}⁡x-1=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sin}⁡x=0.$ The solutions to this equation for $-\\pi \\le x<\\pi $ are $x=-\\pi ,\\,0.$\n\n- Then, we solve $\\operatorname{tan}⁡x-1=0,$ or equivalently $\\operatorname{tan}⁡x=1.$ The solutions to this equation for $-\\pi \\le x<\\pi $ are $x=-\\frac{3\\pi }{4},\\,\\frac{\\pi }{4}.$\n\nTaking into account that $-\\frac{\\pi }{2},\\,\\frac{\\pi }{2}$ are excluded values, and arranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}=-\\pi ,\\,{x}_{2}=-\\frac{3\\pi }{4},\\,{x}_{3}=0,\\,{x}_{4}=\\frac{\\pi }{4}.\n$$" 13194139535925 17592186045417 true] [17592186543568 1068 #edb/ref 17592186543367 13194139535925 17592186045417 true] [17592186543568 1068 #edb/ref 17592186543441 13194139535925 17592186045417 true] [17592186543568 1069 "q-337260" 13194139535925 17592186045417 true] [17592186543568 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543568 1071 "Expressed in **ascending order** in radians, the exact solutions to the equation $\\operatorname{tan}⁡x\\operatorname{cos}⁡x=\\sqrt{7}\\operatorname{tan}⁡x$ for $0\\le x<2\\pi ,$  are\n\n${x}_{1}=$ \n{{field-1}}$\\,{x}_{2}=$ \n{{field-2}}." 13194139535925 17592186045417 true] [17592186543568 1072 #uuid "df31d07c-21a6-58c5-a19d-926033829f92" 13194139535925 17592186045417 true] [17592186543568 1074 "Note that the function $\\operatorname{tan}⁡x$ is not defined at $x=\\frac{\\pi }{2},\\frac{3\\pi }{2}.$\n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡x\\operatorname{cos}⁡x & =\\sqrt{7}\\operatorname{tan}⁡x \\\\ \\operatorname{tan}⁡x\\operatorname{cos}⁡x-\\sqrt{7}\\operatorname{tan}⁡x & =0 \\\\ \\operatorname{tan}⁡x(\\operatorname{cos}⁡x-\\sqrt{7}) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{tan}⁡x=0,\\,\\operatorname{cos}⁡x-\\sqrt{7}=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{tan}⁡x=0.$ The solutions to this equation for $0\\le x<2\\pi $ are $x=0,\\,\\pi .$\n\n- Then, we solve $\\operatorname{cos}⁡x-\\sqrt{7}=0,$ or equivalently $\\operatorname{cos}⁡x=\\sqrt{7}.$ But since $|\\operatorname{cos}⁡x|\\le 1,$ then $\\operatorname{cos}⁡x=\\sqrt{7}$ has no solution.\n\nArranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}=0,\\,{x}_{2}=\\pi .\n$$" 13194139535925 17592186045417 true] [17592186543569 1068 #edb/ref 17592186543452 13194139535925 17592186045417 true] [17592186543569 1069 "q-123237" 13194139535925 17592186045417 true] [17592186543569 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543569 1071 "Let $R=[2,4]\\times [1,5]$ be a region in the $xy$-plane, and let $f(x,y)=21-xy.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}=\\{2,3,4\\},\\,{P}_{2}=\\{1,3,5\\},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nCalculate the upper Riemann sum $U(f,P).$" 13194139535925 17592186045417 true] [17592186543569 1072 #uuid "dfc2de0e-3b59-5c5d-bed1-0d2b8726dbb0" 13194139535925 17592186045417 true] [17592186543569 1074 "First, let's draw the region $R$ and the partition $P.$\n\n![](images/38/38fcf924a077c207ff66fca76d63333d0f28986432b795c889f22b725faca078.png)\n\nThe upper sum $U(f,P)$ is given by\n\n$$\nU(f,P)={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22})\n$$\n\nwhere ${M}_{ij}$ is the *maximum* value of $f$ in each subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nTaking into account the fact that $\\text{Area}({R}_{ij})=2$ for all $4$ subregions, the formula for $U(f,P)$ reduces to\n\n$$\n\\begin{aligned}U(f,P) & =2\\cdot {M}_{11}+2\\cdot {M}_{21}+2\\cdot {M}_{12}+2\\cdot {M}_{22} \\\\  & =2({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$\n\nNow, notice that\n\n- $f(x,y)=21-xy$ decreases as $x$ increases, and\n\n- $f(x,y)=21-xy$ decreases as $y$ increases.\n\n![](images/9e/9e1d5a5dcf056f15fdf9e15b4caf3a2f506549ec785c752579bce5b6e12662cb.png)\n\nAs a result, the *maximum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *smallest* possible $y.$ This is the value at the *bottom left corner* of each subregion.\n\n![](images/60/609917e6e3e397c9a1bfb4ba92a85535034c657d2bc96ae3b833bea381aea36f.png)\n\nHence:\n\n$$\n\\begin{aligned}{M}_{11} & =f(2,1)=19 \\\\ {M}_{21} & =f(3,1)=18 \\\\ {M}_{12} & =f(2,3)=15 \\\\ {M}_{22} & =f(3,3)=12\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}U(f,P) & =2(19+18+15+12) \\\\  & =128.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543570 1068 #edb/ref 17592186543456 13194139535925 17592186045417 true] [17592186543570 1069 "q-121251" 13194139535925 17592186045417 true] [17592186543570 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543570 1071 "Which of the following is the graph of the polar curve $r=\\operatorname{sin}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543570 1072 #uuid "e0c88cba-2b84-5672-a20e-1cf48e9f5298" 13194139535925 17592186045417 true] [17592186543570 1074 "The polar equation $r=2a\\operatorname{sin}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(0,a).$\n\nIn our case, we have $r=\\operatorname{sin}⁡\\theta =1\\cdot \\operatorname{sin}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{1}{2}.\n$$\n\nTherefore, the equation $r=\\operatorname{sin}⁡\\theta $ gives a circle of radius $|\\frac{1}{2}|=0.5$ centered at the point $(0,0.5),$ as shown below.\n\n![](images/c4/c41b20869064a366a1b62d6189d87c540e96196891a8abe1cf9b5c240b52a881.png)" 13194139535925 17592186045417 true] [17592186543571 1068 #edb/ref 17592186543393 13194139535925 17592186045417 true] [17592186543571 1069 "q-281499" 13194139535925 17592186045417 true] [17592186543571 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543571 1071 "![](images/1a/1a5390c0531968e8ef7f3817aa7ceb539ea08633fbfce611736cd3b548c17c1e.png)\n\nThe polar equation of the given curve is $r=${{field-1}}." 13194139535925 17592186045417 true] [17592186543571 1072 #uuid "e14b9dd2-f663-55f7-a3e0-3b4821a83167" 13194139535925 17592186045417 true] [17592186543571 1074 "The diagram shows a circle of radius $|a|=|-1.5|=1.5$ centered at the point $(0,-1.5).$\n\nIn polar coordinates, the equation of such a circle is given by\n\n$$\n\\begin{aligned}r & =2a\\operatorname{sin}⁡\\theta  \\\\  & =2\\cdot (-1.5)\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =-3\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543572 1068 #edb/ref 17592186543306 13194139535925 17592186045417 true] [17592186543572 1069 "q-96563" 13194139535925 17592186045417 true] [17592186543572 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543572 1071 "Given that $X$ is a random variable such that $X∼U[-15,-8],$ find $\\text{SD}[X].$ Round your answer to three decimal places." 13194139535925 17592186045417 true] [17592186543572 1072 #uuid "e2d806a2-2942-5a78-912e-4a549e08c6e1" 13194139535925 17592186045417 true] [17592186543572 1074 "If the random variable $X$ is distributed uniformly over the interval $[a,b],$ then \n\n$$\n\\text{Var}[X]=\\frac{(b-a)^{2}}{12}.\n$$\n\nIn our case, we have $a=-15$ and $b=-8.$ Therefore,\n\n$$\n\\text{Var}[X]=\\frac{(-8-(-15))^{2}}{12}=\\frac{49}{12}.\n$$\n\nFinally,\n\n$$\n\\text{SD}[X]=\\sqrt{\\frac{49}{12}}=\\frac{7\\sqrt{3}}{6}≈2.021.\n$$" 13194139535925 17592186045417 true] [17592186543573 1068 #edb/ref 17592186543331 13194139535925 17592186045417 true] [17592186543573 1069 "q-79406" 13194139535925 17592186045417 true] [17592186543573 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543573 1071 "${log}_{3}⁡(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}})=$" 13194139535925 17592186045417 true] [17592186543573 1072 #uuid "e3b649a8-d282-53b7-b8c8-e883fd47c0b9" 13194139535925 17592186045417 true] [17592186543573 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the quotient rule for logarithms, we get:\n\n$$\n{log}_{3}⁡(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}})={log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})\n$$\n\nNow, using the product rule for logarithms, we obtain\n\n$$\n{log}_{3}⁡({x}^{2}{y}^{3})-{log}_{3}⁡(\\sqrt{z})={log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z}).\n$$\n\nFinally, using the power rule for logarithms, we have\n\n$$\n{log}_{3}⁡({x}^{2})+{log}_{3}⁡({y}^{3})-{log}_{3}⁡(\\sqrt{z})=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$\n\nTherefore\n\n$$\n{log}_{3}⁡(\\frac{{x}^{2}{y}^{3}}{\\sqrt{z}})=2{log}_{3}⁡(x)+3{log}_{3}⁡(y)-\\frac{1}{2}{log}_{3}⁡(z).\n$$" 13194139535925 17592186045417 true] [17592186543574 1068 #edb/ref 17592186543300 13194139535925 17592186045417 true] [17592186543574 1069 "q-123057" 13194139535925 17592186045417 true] [17592186543574 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543574 1071 "![](images/16/16e592cd81e6539e26f10b6bd9352b047576df24b74b4df693f5f2f69799b228.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139535925 17592186045417 true] [17592186543574 1072 #uuid "e3f890f2-0602-53b4-b697-bf1bfc15cf9a" 13194139535925 17592186045417 true] [17592186543574 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=6.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =6\\cdot {M}_{11}+6\\cdot {M}_{21}+6\\cdot {M}_{12}+6\\cdot {M}_{22} \\\\  & =6({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543575 1068 #edb/ref 17592186543340 13194139535925 17592186045417 true] [17592186543575 1069 "q-66446" 13194139535925 17592186045417 true] [17592186543575 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543575 1071 "If $f(x)={x}^{2}+2x-5$, then $f(2p-1)=$" 13194139535925 17592186045417 true] [17592186543575 1072 #uuid "e5a43bfc-062d-59bd-8636-9805b214ca53" 13194139535925 17592186045417 true] [17592186543575 1074 "To find $f(2p-1),$ we write down the function $f$ and replace every occurrence of $x$ with $(2p-1):$\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}+2x-5 \\\\ f(2p-1) & =(2p-1)^{2}+2(2p-1)-5\\end{aligned}\n$$\n\nThen, we simplify as follows:\n\n$$\n\\begin{aligned}f(2p-1) & =(2p-1)^{2}+2(2p-1)-5 \\\\  & =(2p-1)(2p-1)+4p-2-5 \\\\  & =4{p}^{2}-2p-2p+1+4p-7 \\\\  & =4{p}^{2}-6\\end{aligned}\n$$\n\nTherefore, $f(2p-1)=4{p}^{2}-6.$" 13194139535925 17592186045417 true] [17592186543576 1068 #edb/ref 17592186543404 13194139535925 17592186045417 true] [17592186543576 1069 "q-250840" 13194139535925 17592186045417 true] [17592186543576 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543576 1071 "Given that $\\frac{x}{4}$, $x$, and $64$ are the first three terms of a geometric sequence, find $x.$\n\n$x=$\n{{field-1}}" 13194139535925 17592186045417 true] [17592186543576 1072 #uuid "e6d790e0-5c33-5dec-949d-78146efef13a" 13194139535925 17592186045417 true] [17592186543576 1074 "The first three terms are as follows:\n\n$$\n\\begin{aligned}{a}_{1}=\\frac{x}{4},\\,{a}_{2}=x,\\,{a}_{3}=64.\\end{aligned}\n$$\n\nThe common ratio of the first two terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}}=\\frac{x}{(\\frac{x}{4})}=x\\cdot \\frac{4}{x}=4.\\end{aligned}\n$$\n\nOn the other hand, the common ratio of the second and third terms is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{3}}{{a}_{2}}=\\frac{64}{x}.\\end{aligned}\n$$\n\nSo, by equating the values for $r$ and solving for $x,$ we conclude that\n\n$$\n\\begin{aligned}4 & =\\frac{64}{x} \\\\ 4x & =64 \\\\ x & =\\frac{64}{4} \\\\ x & =16.\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543577 1068 #edb/ref 17592186543431 13194139535925 17592186045417 true] [17592186543577 1069 "q-100243" 13194139535925 17592186045417 true] [17592186543577 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543577 1071 "Express $\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y)$ as a single logarithm." 13194139535925 17592186045417 true] [17592186543577 1072 #uuid "e70f2288-3b25-5d12-a8c5-361a6e66e0f3" 13194139535925 17592186045417 true] [17592186543577 1074 "The laws of logarithms are:\n\n- ${log}_{n}⁡(a)+{log}_{n}⁡(b)={log}_{n}⁡(ab)$ - the product rule\n\n- ${log}_{n}⁡(a)-{log}_{n}⁡(b)={log}_{n}⁡(\\frac{a}{b})$ - the quotient rule\n\n- ${log}_{n}⁡({c}^{m})=m{log}_{n}⁡(c)$ - the power rule\n\nUsing the power rule and then the quotient rule for logarithms, we obtain\n\n$$\n\\begin{aligned}\\frac{1}{3}{log}_{4}⁡(x)-{log}_{4}⁡(y) & ={log}_{4}⁡({x}^{1/3})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡(\\sqrt[3]{x})-{log}_{4}⁡(y) \\\\  & ={log}_{4}⁡(\\frac{\\sqrt[3]{x}}{y}).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543578 1068 #edb/ref 17592186543310 13194139535925 17592186045417 true] [17592186543578 1069 "q-222425" 13194139535925 17592186045417 true] [17592186543578 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543578 1071 "If $f(x)=2{x}^{2}-1,$ then $(f∘f)(x)=${{field-1}}." 13194139535925 17592186045417 true] [17592186543578 1072 #uuid "e71385aa-2fca-5283-a0e8-74b07850b796" 13194139535925 17592186045417 true] [17592186543578 1074 "First, we note that $(f∘f)(x)$ is equivalent to $f(f(x)).$\n\nTo find $f(f(x)),$ we write down the function $f$ and replace every occurrence of $x$ with $f(x):$\n\n$$\n\\begin{aligned}f(x) & =2{x}^{2}-1 \\\\ f(f(x)) & =2(f(x))^{2}-1\\end{aligned}\n$$\n\nThen, we substitute $f(x)=2{x}^{2}-1$ into the right-hand side of the above and simplify, as follows:\n\n$$\n\\begin{aligned}f(f(x)) & =2(f(x))^{2}-1 \\\\  & =2(2{x}^{2}-1)^{2}-1 \\\\  & =2(4{x}^{4}-4{x}^{2}+1)-1 \\\\  & =8{x}^{4}-8{x}^{2}+1\\end{aligned}\n$$\n\nTherefore, $(f∘f)(x)=8{x}^{4}-8{x}^{2}+1.$" 13194139535925 17592186045417 true] [17592186543579 1068 #edb/ref 17592186543425 13194139535925 17592186045417 true] [17592186543579 1069 "q-37704" 13194139535925 17592186045417 true] [17592186543579 1070 #edb/ref 17592186045486 13194139535925 17592186045417 true] [17592186543579 1071 "Factor the expression $q-q{p}^{4}.$" 13194139535925 17592186045417 true] [17592186543579 1072 #uuid "e8441a51-7883-5a5e-8db4-a90d1cf66e2c" 13194139535925 17592186045417 true] [17592186543579 1074 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $q.$ To simplify the computation, we can factor out the $q,$ as follows:\n\n$$\nq-q{p}^{4}=q(1-{p}^{4})\n$$\n\nThe expression in parenthesis can be written as a difference of squares:\n\n$$\nq(1-{p}^{4})=q({1}^{2}-{({p}^{2})}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\nq({1}^{2}-{({p}^{2})}^{2})=q(1+{p}^{2})(1-{p}^{2})\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}q(1+{p}^{2})(1-{p}^{2}) & =q(1+{p}^{2})({1}^{2}-{p}^{2}) \\\\  & =q(1+{p}^{2})(1+p)(1-p)\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543580 1068 #edb/ref 17592186543421 13194139535925 17592186045417 true] [17592186543580 1069 "q-5158" 13194139535925 17592186045417 true] [17592186543580 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543580 1071 "Factor $162{x}^{4}-2.$" 13194139535925 17592186045417 true] [17592186543580 1072 #uuid "ea6c80e5-0a00-5798-9872-7c227f663338" 13194139535925 17592186045417 true] [17592186543580 1074 "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that all of the terms have a common factor of $2.$ To simplify the computation, we can factor out the $2,$ as follows:\n\n$$\n162{x}^{4}-2=2\\cdot 81{x}^{4}-2\\cdot 1=2(81{x}^{4}-1)\n$$\n\nThe expression in parentheses can be written as a difference of squares:\n\n$$\n2(81{x}^{4}-1)=2({(9{x}^{2})}^{2}-{1}^{2})\n$$\n\nNow, we factor our expression using the difference of squares formula:\n\n$$\n2({(9{x}^{2})}^{2}-{1}^{2})=2(9{x}^{2}+1)(9{x}^{2}-1)\n$$\n\nFinally, we notice that the expression in the second set of parentheses is also a difference of squares. Therefore, the expression can be factored further, as follows:\n\n$$\n\\begin{aligned}2(9{x}^{2}+1)(9{x}^{2}-1) & =2(9{x}^{2}+1)({(3x)}^{2}-{1}^{2}) \\\\  & =2(9{x}^{2}+1)(3x+1)(3x-1)\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543581 1068 #edb/ref 17592186543415 13194139535925 17592186045417 true] [17592186543581 1069 "q-17269" 13194139535925 17592186045417 true] [17592186543581 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543581 1071 "![](images/73/7341b6d76c74c20596b627167ee90bed0f00cc435b3d1a23c7b9976e353f79d5.png)\n\nWhat is the polar equation of the curve shown above?" 13194139535925 17592186045417 true] [17592186543581 1072 #uuid "eb541cd2-06d9-513e-814b-43ef4f1b8af7" 13194139535925 17592186045417 true] [17592186543581 1074 "The diagram shows a circle of radius $|a|=|-3|=3$ centered at the point $(-3,0).$ \n\nIn polar coordinates, the equation of such a circle is given by \n\n$$\n\\begin{aligned}r & =2a\\operatorname{cos}⁡\\theta  \\\\  & =2\\cdot (-3)\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =-6\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543582 1068 #edb/ref 17592186543348 13194139535925 17592186045417 true] [17592186543582 1068 #edb/ref 17592186543390 13194139535925 17592186045417 true] [17592186543582 1068 #edb/ref 17592186543416 13194139535925 17592186045417 true] [17592186543582 1068 #edb/ref 17592186543454 13194139535925 17592186045417 true] [17592186543582 1069 "q-274637" 13194139535925 17592186045417 true] [17592186543582 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543582 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $\\operatorname{sin}⁡x\\operatorname{tan}⁡x-\\sqrt{3}\\operatorname{sin}⁡x=0,$ for ${0}^{∘}\\le x<{360}^{∘},$  are\n\n${x}_{1}=$ \n{{field-1}}${}^{∘},\\,{x}_{2}=$ \n{{field-2}}${}^{∘},\\,{x}_{3}=$ \n{{field-3}}${}^{∘},\\,{x}_{4}=$ \n{{field-4}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543582 1072 #uuid "eb877a39-4dd4-5455-8e16-f850f269ea03" 13194139535925 17592186045417 true] [17592186543582 1074 "Note that the function $\\operatorname{tan}⁡x$ is not defined at $x={90}^{∘},\\,{270}^{∘}.$ \n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x\\operatorname{tan}⁡x-\\sqrt{3}\\operatorname{sin}⁡x & =0 \\\\ \\operatorname{sin}⁡x(\\operatorname{tan}⁡x-\\sqrt{3}) & =0\\end{aligned}\n$$\n\nBy the zero-product property, we have to solve two equations: \n\n$$\n\\operatorname{sin}⁡x=0,\\,\\operatorname{tan}⁡x-\\sqrt{3}=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sin}⁡x=0.$ The solutions to this equation for ${0}^{∘}\\le x<{360}^{∘}$  are $x={0}^{∘},\\,{180}^{∘}.$\n\n- Then, we solve $\\operatorname{tan}⁡x-\\sqrt{3}=0,$ or equivalently $\\operatorname{tan}⁡x=\\sqrt{3}.$ The solutions to this equation for ${0}^{∘}\\le x<{360}^{∘}$ are $x={60}^{∘},\\,{240}^{∘}.$\n\nArranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}={0}^{∘},\\,{x}_{2}={60}^{∘},\\,{x}_{3}={180}^{∘},\\,{x}_{4}={240}^{∘}.\n$$" 13194139535925 17592186045417 true] [17592186543583 1068 #edb/ref 17592186543397 13194139535925 17592186045417 true] [17592186543583 1069 "q-80" 13194139535925 17592186045417 true] [17592186543583 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543583 1071 "Solve the equation ${3}^{y}=81.$" 13194139535925 17592186045417 true] [17592186543583 1072 #uuid "eeaf419f-60bd-5e26-a56f-c339e863386b" 13194139535925 17592186045417 true] [17592186543583 1074 "First, we rewrite $81$ as ${3}^{4}$ to get:\n\n$$\n\\begin{aligned}{3}^{y} & =81 \\\\ {3}^{y} & ={3}^{4}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3)$, we equate the exponents:\n\n$$\n\\begin{aligned}{3}^{y} & ={3}^{4} \\\\ y & =4\\end{aligned}\n$$\n\nTherefore, the solution is $y=4.$" 13194139535925 17592186045417 true] [17592186543584 1068 #edb/ref 17592186543392 13194139535925 17592186045417 true] [17592186543584 1069 "q-65970" 13194139535925 17592186045417 true] [17592186543584 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543584 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡2x=-\\frac{\\sqrt{3}}{2}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139535925 17592186045417 true] [17592186543584 1072 #uuid "ef6f56bf-b6a0-53ab-9821-d8f13185e30a" 13194139535925 17592186045417 true] [17592186543584 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{6}+2n\\pi , & \\, & \\, & 2x & =\\frac{5\\pi }{6}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =-\\frac{5\\pi }{6}+2n\\pi  & \\, & \\, & 2x & =\\frac{5\\pi }{6}+2n\\pi  \\\\ x & =-\\frac{5\\pi }{12}+n\\pi  & \\, & \\, & x & =\\frac{5\\pi }{12}+n\\pi  \\\\ x & =\\frac{(12n-5)\\pi }{12} & \\, & \\, & x & =\\frac{(12n+5)\\pi }{12}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=-\\frac{5\\pi }{12}$ and $x=\\frac{5\\pi }{12}.$ We reject the solution $-\\frac{5\\pi }{12}$ since it lies outside the domain of interest.\n\n- Setting $n=1$ gives $x=\\frac{7\\pi }{12}$ and $x=\\frac{17\\pi }{12}.$ We reject the solution $\\frac{17\\pi }{12}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<\\pi .$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{5\\pi }{12}\\cdot \\frac{7\\pi }{12}=\\frac{35{\\pi }^{2}}{144}.\n$$" 13194139535925 17592186045417 true] [17592186543585 1068 #edb/ref 17592186543440 13194139535925 17592186045417 true] [17592186543585 1069 "q-123124" 13194139535925 17592186045417 true] [17592186543585 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543585 1071 "![](images/df/dfba17c3f5744cf122c8051226bc627799bd261b4a5ed6f4d8a03b405dea0c50.png)\n\nConsider the partition of the rectangular region $R$ shown above and the positive function $f(x,y)$ defined on $R.$ Which of the following gives an expression for the upper Riemann sum of $f$ with respect to this partition.\n\n*Hint: ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}$*" 13194139535925 17592186045417 true] [17592186543585 1072 #uuid "efacd675-1f5e-570d-8835-58b0708fe7ea" 13194139535925 17592186045417 true] [17592186543585 1074 "To calculate the upper Riemann sum $U$ with respect to the given partition, we compute the sum of the volumes of $4$ rectangular solids, one for each ${R}_{ij}.$\n\nThe volume of the rectangular solid corresponding to each subregion ${R}_{ij}$ is given by\n\n$$\n{M}_{ij}\\cdot \\text{Area}({R}_{ij}).\n$$\n\nwhere ${M}_{ij}$ denotes the maximum value of $f$ on the subregion ${R}_{ij}.$ We pick the *maximum* value of $f$ because we're finding the *upper* sum.\n\nSo in our case, we have\n\n$$\nU={M}_{11}\\cdot \\text{Area}({R}_{11})+{M}_{21}\\cdot \\text{Area}({R}_{21})+{M}_{12}\\cdot \\text{Area}({R}_{12})+{M}_{22}\\cdot \\text{Area}({R}_{22}).\n$$\n\nNotice that\n\n$$\n\\text{Area}({R}_{11})=\\text{Area}({R}_{21})=\\text{Area}({R}_{12})=\\text{Area}({R}_{22})=3.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}U & =3\\cdot {M}_{11}+3\\cdot {M}_{21}+3\\cdot {M}_{12}+3\\cdot {M}_{22} \\\\  & =3({M}_{11}+{M}_{21}+{M}_{12}+{M}_{22}).\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543586 1068 #edb/ref 17592186543324 13194139535925 17592186045417 true] [17592186543586 1069 "q-3900" 13194139535925 17592186045417 true] [17592186543586 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543586 1071 "Evaluate $f(x)={x}^{2}-6x+9$ at $x=a+2.$" 13194139535925 17592186045417 true] [17592186543586 1072 #uuid "efcb8d92-e0fd-53fd-9869-69a86351884a" 13194139535925 17592186045417 true] [17592186543586 1074 "To find $f(a+2),$ we write down the function $f$ and replace every occurrence of $x$ with $(a+2):$\n\n$$\n\\begin{aligned}f(x) & ={x}^{2}-6x+9 \\\\ f(a+2) & =(a+2)^{2}-6(a+2)+9\\end{aligned}\n$$\n\nThen, we simplify as follows:\n\n$$\n\\begin{aligned}f(a+2) & =(a+2)^{2}-6(a+2)+9 \\\\  & =(a+2)(a+2)-6a-12+9 \\\\  & ={a}^{2}+2a+2a+4-6a-3 \\\\  & ={a}^{2}-2a+1\\end{aligned}\n$$\n\nTherefore, $f(a+2)={a}^{2}-2a+1.$" 13194139535925 17592186045417 true] [17592186543587 1068 #edb/ref 17592186543361 13194139535925 17592186045417 true] [17592186543587 1069 "q-134808" 13194139535925 17592186045417 true] [17592186543587 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543587 1071 "![](images/08/08ce939458d5c298805692df7d10bed2abdcf81ec874da3f61dbe15f59fc141a.png)\n\nA biologist records the heights $y$ (in meters) of several oak trees at certain times $x$ (in years) after they were planted. The scatter plot for the data and the corresponding linear regression line are shown above.  \n\nAccording to the regression model, what is the residual for the highlighted datapoint?" 13194139535925 17592186045417 true] [17592186543587 1072 #uuid "f1b17b2b-5f71-5d88-80f9-025ec7f6d205" 13194139535925 17592186045417 true] [17592186543587 1074 "The residual equals the difference between the actual value of the dependent variable and the value estimated using the linear regression model:\n\n$$\n\\text{Residual}=\\text{Actual}-\\text{Estimated}\n$$\n\n \n\nThe highlighted datapoint has coordinates $(6,6.5).$ So, our actual value is $y=6.5.$\n\nOn the other hand, the point on the regression line that corresponds to $x=6$ has the $y$-coordinate $5.5.$ So, our estimated value is $\\overset{^}{y}=5.5.$\n\n![](images/ee/eedd1cadb2ba49fb95f9e18f9bef365942e53521e6894a270c9a1e1474f3ed71.png)\n\nAs a result, \n\n$$\n\\begin{aligned}\\text{Residual} & =\\text{Actual}-\\text{Estimated} \\\\  & =y-\\overset{^}{y} \\\\  & =6.5-5.5 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the residual is $1\\,\\text{m}.$" 13194139535925 17592186045417 true] [17592186543588 1068 #edb/ref 17592186543366 13194139535925 17592186045417 true] [17592186543588 1069 "q-65971" 13194139535925 17592186045417 true] [17592186543588 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543588 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡2x=\\frac{1}{2}$ for $0\\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" 13194139535925 17592186045417 true] [17592186543588 1072 #uuid "f8328338-c374-57d6-bab7-26f0397ea50b" 13194139535925 17592186045417 true] [17592186543588 1074 "We will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{3}+2n\\pi , & \\, & \\, & 2x & =\\frac{\\pi }{3}+2n\\pi .\\end{aligned}\n$$\n\nSolving the two equations above for $x$ gives:\n\n$$\n\\begin{aligned}2x & =-\\frac{\\pi }{3}+2n\\pi  & \\, & \\, & 2x & =\\frac{\\pi }{3}+2n\\pi  \\\\ x & =-\\frac{\\pi }{6}+n\\pi  & \\, & \\, & x & =\\frac{\\pi }{6}+n\\pi  \\\\ x & =\\frac{(6n-1)\\pi }{6} & \\, & \\, & x & =\\frac{(6n+1)\\pi }{6}\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0\\le x<\\pi .$\n\n- Setting $n=0$ gives $x=-\\frac{\\pi }{6}$ and $x=\\frac{\\pi }{6}.$ We reject the solution $-\\frac{\\pi }{6}$ since it lies outside the domain of interest.\n\n- Setting $n=1$ gives $x=\\frac{5\\pi }{6}$ and $x=\\frac{7\\pi }{6}.$ We reject the solution $\\frac{7\\pi }{6}$ since it lies outside the domain of interest.\n\nAll other values of $n$ generate solutions outside the domain $0\\le x<\\pi .$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{6}\\cdot \\frac{5\\pi }{6}=\\frac{5{\\pi }^{2}}{36}.\n$$" 13194139535925 17592186045417 true] [17592186543589 1068 #edb/ref 17592186543378 13194139535925 17592186045417 true] [17592186543589 1069 "q-121266" 13194139535925 17592186045417 true] [17592186543589 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543589 1071 "Which of the following is the graph of the polar curve $r=12\\operatorname{sin}⁡\\theta ?$" 13194139535925 17592186045417 true] [17592186543589 1072 #uuid "f8583d4e-1a83-5981-bb25-84847566b1c0" 13194139535925 17592186045417 true] [17592186543589 1074 "The polar equation $r=2a\\operatorname{sin}⁡\\theta $ defines a circle of radius $|a|$ centered at the point $(0,a).$\n\nIn our case, we have $r=12\\operatorname{sin}⁡\\theta ,$ and therefore\n\n$$\na=\\frac{12}{2}=6.\n$$\n\nTherefore, the equation $r=12\\operatorname{sin}⁡\\theta $ gives a circle of radius $|6|=6$ centered at the point $(0,6),$ as shown below.\n\n![](images/ad/adf3c76c7b9bcb1d1c8a917716bf6df70cf456d03db4ef8759b049686975bae3.png)" 13194139535925 17592186045417 true] [17592186543590 1068 #edb/ref 17592186543381 13194139535925 17592186045417 true] [17592186543590 1069 "q-23996" 13194139535925 17592186045417 true] [17592186543590 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543590 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sin}⁡x(\\operatorname{cos}⁡x-2)=0$ for ${0}^{∘}\\le x\\le {180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139535925 17592186045417 true] [17592186543590 1072 #uuid "f95ce679-5df8-536b-9a6e-bc83e05e288c" 13194139535925 17592186045417 true] [17592186543590 1074 "By the zero-product property, we have to solve two equations: \n\n$$\n\\operatorname{sin}⁡x=0,\\,\\operatorname{cos}⁡x-2=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sin}⁡x=0.$ The solutions to this equation for ${0}^{∘}\\le x\\le {180}^{∘}$  are $x={0}^{∘},{180}^{∘}.$\n\n- Then, we solve $\\operatorname{cos}⁡x-2=0,$ or equivalently $\\operatorname{cos}⁡x=2.$ But since $|\\operatorname{cos}⁡x|\\le 1,$ then $\\operatorname{cos}⁡x=2$ has no solution.\n\nCombining all solutions from both equations, we get\n\n$$\n{x}_{1}={0}^{∘},\\,{x}_{2}={180}^{∘}.\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=0\\cdot 180=0.\n$$" 13194139535925 17592186045417 true] [17592186543591 1068 #edb/ref 17592186543351 13194139535925 17592186045417 true] [17592186543591 1069 "q-37550" 13194139535925 17592186045417 true] [17592186543591 1070 #edb/ref 17592186045485 13194139535925 17592186045417 true] [17592186543591 1071 "Factor the expression $8{x}^{6}+27{y}^{3}.$" 13194139535925 17592186045417 true] [17592186543591 1072 #uuid "faeaf850-1aff-5e10-9fc0-51026df9825a" 13194139535925 17592186045417 true] [17592186543591 1074 "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n8{x}^{6}+27{y}^{3}={(2{x}^{2})}^{3}+(3y)^{3}\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}8{x}^{6}+27{y}^{3} & ={(2{x}^{2})}^{3}+(3y)^{3} \\\\  & =(2{x}^{2}+3y)({(2{x}^{2})}^{2}-2{x}^{2}\\cdot 3y+(3y)^{2}) \\\\  & =(2{x}^{2}+3y)(4{x}^{4}-6{x}^{2}y+9{y}^{2})\\end{aligned}\n$$" 13194139535925 17592186045417 true] [17592186543592 1068 #edb/ref 17592186543308 13194139535925 17592186045417 true] [17592186543592 1068 #edb/ref 17592186543357 13194139535925 17592186045417 true] [17592186543592 1069 "q-337369" 13194139535925 17592186045417 true] [17592186543592 1070 #edb/ref 17592186045487 13194139535925 17592186045417 true] [17592186543592 1071 "Expressed in **ascending order** in degrees, the exact solutions to the equation $2\\operatorname{sec}⁡x\\operatorname{tan}⁡x-2\\operatorname{sec}⁡x=0,$ for $0\\le x<{360}^{∘},$ are\n\n${x}_{1}=$\n{{field-1}}${}^{∘},\\,{x}_{2}=$ \n{{field-2}}${}^{∘}.$" 13194139535925 17592186045417 true] [17592186543592 1072 #uuid "fc1ed235-5329-5107-b309-feec267a8cde" 13194139535925 17592186045417 true] [17592186543592 1074 "Note that the functions $\\operatorname{sec}⁡x$ and $\\operatorname{tan}⁡x$ are not defined at the points where $\\operatorname{cos}⁡x=0.$ On the interval $0\\le x<{360}^{∘},$ the excluded values are $x={90}^{∘},\\,{270}^{∘}.$ \n\nFirst, we factor the equation:\n\n$$\n\\begin{aligned}2\\operatorname{sec}⁡x\\operatorname{tan}⁡x-2\\operatorname{sec}⁡x & =0 \\\\ 2\\operatorname{sec}⁡x(\\operatorname{tan}⁡x-1) & =0\\end{aligned}\n$$\n\nTherefore, by the zero-product property, we have to solve two equations:\n\n$$\n\\operatorname{sec}⁡x=0,\\,\\operatorname{tan}⁡x-1=0\n$$\n\nLet's solve each equation separately.\n\n- First, we solve $\\operatorname{sec}⁡x=0.$ Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ so it is never equal to zero. Therefore, this equation has no solutions.\n\n- Then, we solve $\\operatorname{tan}⁡x-1=0,$ or equivalently, $\\operatorname{tan}⁡x=1.$ The solutions to this equation for $0\\le x<{360}^{∘}$ are $x={45}^{∘},\\,{225}^{∘}.$\n\nArranging all solutions from both equations in ascending order, we get\n\n$$\n{x}_{1}={45}^{∘},\\,{x}_{2}={225}^{∘}.\n$$" 13194139535925 17592186045417 true] [17592186543593 1058 #edb/ref 17592186543607 13194139535925 17592186045417 true] [17592186543593 1062 #uuid "0192679b-c21d-5e4f-9008-8825cfa9a134" 13194139535925 17592186045417 true] [17592186543593 1063 #edb/ref 17592186314743 13194139535925 17592186045417 true] [17592186543594 1058 #edb/ref 17592186543635 13194139535925 17592186045417 true] [17592186543594 1062 #uuid "0218cccb-f086-56d9-b8f9-aa20f5c1b9cb" 13194139535925 17592186045417 true] [17592186543594 1063 #edb/ref 17592186543485 13194139535925 17592186045417 true] [17592186543595 1062 #uuid "02fdcf69-8aea-585d-b9f7-39f84eb04ef4" 13194139535925 17592186045417 true] [17592186543595 1063 #edb/ref 17592186543490 13194139535925 17592186045417 true] [17592186543596 1058 #edb/ref 17592186543659 13194139535925 17592186045417 true] [17592186543596 1062 #uuid "03787068-e65a-5894-ac0f-70677b84b503" 13194139535925 17592186045417 true] [17592186543596 1063 #edb/ref 17592186134077 13194139535925 17592186045417 true] [17592186543597 1058 #edb/ref 17592186543604 13194139535925 17592186045417 true] [17592186543597 1062 #uuid "060e