9bb47f58-6a91-54e3-954c-27e73a96817b" :answer/id #uuid "9bb47f58-6a91-54e3-954c-27e73a96817b" :answer/type :answer.type/math :answer/value "602\\,932" :db/ensure [:answer/validate]} {:db/id "activity-ec377670-844f-59bc-9b32-cf2ea3943abe" :activity/id #uuid "ec377670-844f-59bc-9b32-cf2ea3943abe" :activity/title "The Rules of Sum and Product" :activity/type :activity.type/review :activity/scope 17592186049300 :activity/course 17592186046647 :activity/steps ["step-5744d1ec-fa9a-5b99-ba8d-35143652adb2" "step-b8e913b8-185b-5bcc-ae9e-051600db7349" "step-00671462-c347-5948-8e69-c488cd0be50a"] :activity/first-step "step-5744d1ec-fa9a-5b99-ba8d-35143652adb2" :db/ensure [:activity/validate]} {:db/id "step-5744d1ec-fa9a-5b99-ba8d-35143652adb2" :step/id #uuid "5744d1ec-fa9a-5b99-ba8d-35143652adb2" :step/content 17592186284760 :step/next "step-b8e913b8-185b-5bcc-ae9e-051600db7349" :db/ensure [:step/validate]} {:db/id "step-b8e913b8-185b-5bcc-ae9e-051600db7349" :step/id #uuid "b8e913b8-185b-5bcc-ae9e-051600db7349" :step/content 17592186233597 :step/next "step-00671462-c347-5948-8e69-c488cd0be50a" :db/ensure [:step/validate]} {:db/id "step-00671462-c347-5948-8e69-c488cd0be50a" :step/id #uuid "00671462-c347-5948-8e69-c488cd0be50a" :step/content 17592186332931 :db/ensure [:step/validate]} {:db/id 17592186157437 :knowledge-point/questions ["question-cf4d19a8-5c2e-5168-bc23-2f319900269a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cf4d19a8-5c2e-5168-bc23-2f319900269a" :question/id #uuid "cf4d19a8-5c2e-5168-bc23-2f319900269a" :question/math-academy-id "q-110802" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {10}^{x}-3x\\cdot {10}^{x}+2\\cdot {10}^{x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {10}^{x}-3x\\cdot {10}^{x}+2\\cdot {10}^{x} & =0 \\\\ ({x}^{2}-3x+2){10}^{x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-3x+2=0\\,\\text{and}\\,{10}^{x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-3x+2=0$ can be factored as\n\n$$\n(x-1)(x-2)=0,\n$$\n\nwhich leads to the solutions $x=1,2.$\n\n- The equation ${10}^{x}=0$ has no solutions because ${10}^{x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=1,2,$ and their product is $1\\cdot 2=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-be34ef91-5efd-5e6a-b5e1-ff532d2967ca"] :db/ensure [:question/validate]} {:db/id "answer-field-be34ef91-5efd-5e6a-b5e1-ff532d2967ca" :answer-field/id #uuid "be34ef91-5efd-5e6a-b5e1-ff532d2967ca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2057272a-a597-5b12-aed1-a3af401bdb53" :answer-field/choices ["answer-c4f09f88-2ade-51fb-8aa2-5f0ea6cac91f" "answer-5796b45f-c2ac-5d55-b3fc-c9c7d0eeaab2" "answer-8501c1b4-2888-5212-9951-757335f5b2f5" "answer-669845e1-7425-5a30-8b6e-cf58c8bc05e6" "answer-2057272a-a597-5b12-aed1-a3af401bdb53"] :db/ensure [:answer-field/validate]} {:db/id "answer-c4f09f88-2ade-51fb-8aa2-5f0ea6cac91f" :answer/id #uuid "c4f09f88-2ade-51fb-8aa2-5f0ea6cac91f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-5796b45f-c2ac-5d55-b3fc-c9c7d0eeaab2" :answer/id #uuid "5796b45f-c2ac-5d55-b3fc-c9c7d0eeaab2" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-8501c1b4-2888-5212-9951-757335f5b2f5" :answer/id #uuid "8501c1b4-2888-5212-9951-757335f5b2f5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-669845e1-7425-5a30-8b6e-cf58c8bc05e6" :answer/id #uuid "669845e1-7425-5a30-8b6e-cf58c8bc05e6" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-2057272a-a597-5b12-aed1-a3af401bdb53" :answer/id #uuid "2057272a-a597-5b12-aed1-a3af401bdb53" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "activity-2509a6a0-9df2-57e4-aee9-31a2cd4f3649" :activity/id #uuid "2509a6a0-9df2-57e4-aee9-31a2cd4f3649" :activity/title "Solving Exponential Equations Using the Zero-Product Property" :activity/type :activity.type/review :activity/scope 17592186048423 :activity/course 17592186046647 :activity/steps ["step-82b4b547-400b-5d76-b8a1-fb3d5c269718" "step-a1e388b6-4b60-5a84-a896-498b3b87a0f2" "step-edd4ce43-80f9-5f81-818c-9ae2ce5ab4d1"] :activity/first-step "step-82b4b547-400b-5d76-b8a1-fb3d5c269718" :db/ensure [:activity/validate]} {:db/id "step-82b4b547-400b-5d76-b8a1-fb3d5c269718" :step/id #uuid "82b4b547-400b-5d76-b8a1-fb3d5c269718" :step/content "question-cf4d19a8-5c2e-5168-bc23-2f319900269a" :step/next "step-a1e388b6-4b60-5a84-a896-498b3b87a0f2" :db/ensure [:step/validate]} {:db/id "step-a1e388b6-4b60-5a84-a896-498b3b87a0f2" :step/id #uuid "a1e388b6-4b60-5a84-a896-498b3b87a0f2" :step/content 17592186292659 :step/next "step-edd4ce43-80f9-5f81-818c-9ae2ce5ab4d1" :db/ensure [:step/validate]} {:db/id "step-edd4ce43-80f9-5f81-818c-9ae2ce5ab4d1" :step/id #uuid "edd4ce43-80f9-5f81-818c-9ae2ce5ab4d1" :step/content 17592186292662 :db/ensure [:step/validate]} {:db/id 17592186119839 :knowledge-point/questions ["question-c7dcf7da-2297-59af-930a-8b2c6aff00d1" "question-4f033659-c7d6-5be9-97da-6420561e0286"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c7dcf7da-2297-59af-930a-8b2c6aff00d1" :question/id #uuid "c7dcf7da-2297-59af-930a-8b2c6aff00d1" :question/math-academy-id "q-129099" :question/problem "Find the shortest distance between the point $P(-4,3,-1)$ and the plane $Π$ with equation $(r-⟨6,-1,4⟩)\\cdot ⟨4,0,-3⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,-1,4).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨6,-1,4⟩-⟨-4,3,-1⟩ \\\\  & =⟨10,-4,5⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨4,0,-3⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|10\\cdot 4+(-4)\\cdot 0+5\\cdot (-3)|}{\\sqrt{{4}^{2}+{0}^{2}+(-3)^{2}}} \\\\  & =\\frac{|40+0-15|}{\\sqrt{16+9}} \\\\  & =\\frac{|25|}{\\sqrt{25}} \\\\  & =\\frac{25}{5} \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6ab8132e-9ff7-5697-a331-2b7476559e4f"] :db/ensure [:question/validate]} {:db/id "answer-field-6ab8132e-9ff7-5697-a331-2b7476559e4f" :answer-field/id #uuid "6ab8132e-9ff7-5697-a331-2b7476559e4f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-38452af2-3463-5e38-b50f-517dc777cb12" :answer-field/choices ["answer-a3d86851-66fb-594c-bde9-ae083bc8675f" "answer-e6d74405-0178-5fb3-b7ac-3794c3723eac" "answer-38452af2-3463-5e38-b50f-517dc777cb12" "answer-5269850f-0a46-56fc-897c-8ca14b3bd2c7" "answer-f61645ce-a87d-59da-b373-17d56da8e2f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3d86851-66fb-594c-bde9-ae083bc8675f" :answer/id #uuid "a3d86851-66fb-594c-bde9-ae083bc8675f" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-e6d74405-0178-5fb3-b7ac-3794c3723eac" :answer/id #uuid "e6d74405-0178-5fb3-b7ac-3794c3723eac" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-38452af2-3463-5e38-b50f-517dc777cb12" :answer/id #uuid "38452af2-3463-5e38-b50f-517dc777cb12" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-5269850f-0a46-56fc-897c-8ca14b3bd2c7" :answer/id #uuid "5269850f-0a46-56fc-897c-8ca14b3bd2c7" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-f61645ce-a87d-59da-b373-17d56da8e2f9" :answer/id #uuid "f61645ce-a87d-59da-b373-17d56da8e2f9" :answer/type :answer.type/math :answer/value "\\frac{28}{5}" :db/ensure [:answer/validate]} {:db/id "question-4f033659-c7d6-5be9-97da-6420561e0286" :question/id #uuid "4f033659-c7d6-5be9-97da-6420561e0286" :question/math-academy-id "q-129101" :question/problem "Find the shortest distance between the point $P(7,-2,3)$ and the plane $Π$ with equation $(r-⟨5,-1,6⟩)\\cdot ⟨-6,3,2⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(5,-1,6).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨5,-1,6⟩-⟨7,-2,3⟩ \\\\  & =⟨-2,1,3⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨-6,3,2⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-2)\\cdot (-6)+1\\cdot 3+3\\cdot 2|}{\\sqrt{(-6)^{2}+{3}^{2}+{2}^{2}}} \\\\  & =\\frac{|12+3+6|}{\\sqrt{36+9+4}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7fc70b3f-42c6-5104-a98d-c3951c9ae2dd"] :db/ensure [:question/validate]} {:db/id "answer-field-7fc70b3f-42c6-5104-a98d-c3951c9ae2dd" :answer-field/id #uuid "7fc70b3f-42c6-5104-a98d-c3951c9ae2dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d8ba0ca6-2710-5bc6-975d-35ed2106bb35" :answer-field/choices ["answer-15641019-eb48-5052-a403-60ab3dfb5dc2" "answer-d8ba0ca6-2710-5bc6-975d-35ed2106bb35" "answer-2ab0e081-5b86-55e7-981c-cd34744c91c3" "answer-c462e695-1e8c-53ef-a160-41238e99ef40" "answer-0746c2b1-8397-5ca4-bcc4-2be9ad0a31a8"] :db/ensure [:answer-field/validate]} {:db/id "answer-15641019-eb48-5052-a403-60ab3dfb5dc2" :answer/id #uuid "15641019-eb48-5052-a403-60ab3dfb5dc2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-d8ba0ca6-2710-5bc6-975d-35ed2106bb35" :answer/id #uuid "d8ba0ca6-2710-5bc6-975d-35ed2106bb35" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-2ab0e081-5b86-55e7-981c-cd34744c91c3" :answer/id #uuid "2ab0e081-5b86-55e7-981c-cd34744c91c3" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-c462e695-1e8c-53ef-a160-41238e99ef40" :answer/id #uuid "c462e695-1e8c-53ef-a160-41238e99ef40" :answer/type :answer.type/math :answer/value "\\frac{11}{3}" :db/ensure [:answer/validate]} {:db/id "answer-0746c2b1-8397-5ca4-bcc4-2be9ad0a31a8" :answer/id #uuid "0746c2b1-8397-5ca4-bcc4-2be9ad0a31a8" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id 17592186083324 :knowledge-point/questions ["question-1a1059d5-573e-59f8-8d92-01104e325d82" "question-bb189cdf-2b97-5db2-ae7a-d4991a5c036b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1a1059d5-573e-59f8-8d92-01104e325d82" :question/id #uuid "1a1059d5-573e-59f8-8d92-01104e325d82" :question/math-academy-id "q-132444" :question/problem "A player's height in a particular professional basketball league is normally distributed with a mean of $77$ inches and a standard deviation of $3.57$ inches.\nWhat is the probability that the height of a randomly selected player is more than $76$ inches but less than $78$ inches?\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.1\\,$</th>\n<td align=\"center\"> $\\,0.5636\\,$ </td>\n<td align=\"center\"> $\\,0.5675\\,$ </td>\n<td align=\"center\"> $\\,0.5714\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th>\n<td align=\"center\"> $\\,0.6026\\,$ </td>\n<td align=\"center\"> $\\,0.6064\\,$ </td>\n<td align=\"center\"> $\\,0.6103\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.3\\,$</th>\n<td align=\"center\"> $\\,0.6406\\,$ </td>\n<td align=\"center\"> $\\,0.6443\\,$ </td>\n<td align=\"center\"> $\\,0.6480\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th>\n<td align=\"center\"> $\\,0.3594\\,$ </td>\n<td align=\"center\"> $\\,0.3557\\,$ </td>\n<td align=\"center\"> $\\,0.3520\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th>\n<td align=\"center\"> $\\,0.3974\\,$ </td>\n<td align=\"center\"> $\\,0.3936\\,$ </td>\n<td align=\"center\"> $\\,0.3897\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th>\n<td align=\"center\"> $\\,0.4364\\,$ </td>\n<td align=\"center\"> $\\,0.4325\\,$ </td>\n<td align=\"center\"> $\\,0.4286\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Let $X$ represent the height (in inches) of a randomly selected player. Then we have $X∼N(77,{3.57}^{2}).$\n\nWe want to find $P(76<X<78).$ First, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(76<X<78) & =P(\\frac{76-77}{3.57}<Z<\\frac{78-77}{3.57}) \\\\  & =P(-0.28<Z<0.28)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.28<Z<0.28) & =P(Z<0.28)-P(Z\\le -0.28) \\\\  & =P(Z\\le 0.28)-P(Z\\le -0.28) \\\\  & =Φ(0.28)-Φ(-0.28)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(0.28) & =0.6103 \\\\ Φ(-0.28) & =0.3897.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}P(-0.28<Z<0.28) & =Φ(0.28)-Φ(-0.28) \\\\  & =0.6103-0.3897 \\\\  & =0.2206 \\\\  & ≈0.22\\end{aligned}\n$$\n\nTherefore, the probability that the height of a randomly selected player is more than $76$ inches but less than $78$ inches is approximately $0.22.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6a80460b-81a6-5762-8a66-e56c03dc6782"] :db/ensure [:question/validate]} {:db/id "answer-field-6a80460b-81a6-5762-8a66-e56c03dc6782" :answer-field/id #uuid "6a80460b-81a6-5762-8a66-e56c03dc6782" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4e878814-1cec-558c-9ad5-c9d1d1636938" :answer-field/choices ["answer-70ba8ee7-e027-558d-ba3b-6caf25bcdd99" "answer-4e878814-1cec-558c-9ad5-c9d1d1636938" "answer-4dccfb7c-69d9-5e39-bdc6-b9c1f9d8666a" "answer-10a8235a-b96e-5fa1-8108-e0e6dd4ab2d0" "answer-5923c2ed-ea1c-5b9b-918c-6ab0788b0527"] :db/ensure [:answer-field/validate]} {:db/id "answer-70ba8ee7-e027-558d-ba3b-6caf25bcdd99" :answer/id #uuid "70ba8ee7-e027-558d-ba3b-6caf25bcdd99" :answer/type :answer.type/math :answer/value "0.17" :db/ensure [:answer/validate]} {:db/id "answer-4e878814-1cec-558c-9ad5-c9d1d1636938" :answer/id #uuid "4e878814-1cec-558c-9ad5-c9d1d1636938" :answer/type :answer.type/math :answer/value "0.22" :db/ensure [:answer/validate]} {:db/id "answer-4dccfb7c-69d9-5e39-bdc6-b9c1f9d8666a" :answer/id #uuid "4dccfb7c-69d9-5e39-bdc6-b9c1f9d8666a" :answer/type :answer.type/math :answer/value "0.23" :db/ensure [:answer/validate]} {:db/id "answer-10a8235a-b96e-5fa1-8108-e0e6dd4ab2d0" :answer/id #uuid "10a8235a-b96e-5fa1-8108-e0e6dd4ab2d0" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "answer-5923c2ed-ea1c-5b9b-918c-6ab0788b0527" :answer/id #uuid "5923c2ed-ea1c-5b9b-918c-6ab0788b0527" :answer/type :answer.type/math :answer/value "0.27" :db/ensure [:answer/validate]} {:db/id "question-bb189cdf-2b97-5db2-ae7a-d4991a5c036b" :question/id #uuid "bb189cdf-2b97-5db2-ae7a-d4991a5c036b" :question/math-academy-id "q-132711" :question/problem "The annual income of an employee in a large company is normally distributed with a mean of $$50\\,000$ and a standard deviation of $$15\\,000.$ What is the probability that a randomly selected employee's income is more than $$46\\,700$ but less than $$56\\,150?$ Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th>\n<td align=\"center\"> $\\,0.4207\\,$ </td>\n<td align=\"center\"> $\\,0.4168\\,$ </td>\n<td align=\"center\"> $\\,0.4129\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th>\n<td align=\"center\"> $\\,0.4602\\,$ </td>\n<td align=\"center\"> $\\,0.4562\\,$ </td>\n<td align=\"center\"> $\\,0.4522\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.0\\,$</th>\n<td align=\"center\"> $\\,0.5000\\,$ </td>\n<td align=\"center\"> $\\,0.4960\\,$ </td>\n<td align=\"center\"> $\\,0.4920\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th>\n<td align=\"center\"> $\\,0.5793\\,$ </td>\n<td align=\"center\"> $\\,0.5832\\,$ </td>\n<td align=\"center\"> $\\,0.5871\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.3\\,$</th>\n<td align=\"center\"> $\\,0.6179\\,$ </td>\n<td align=\"center\"> $\\,0.6217\\,$ </td>\n<td align=\"center\"> $\\,0.6255\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.4\\,$</th>\n<td align=\"center\"> $\\,0.6554\\,$ </td>\n<td align=\"center\"> $\\,0.6591\\,$ </td>\n<td align=\"center\"> $\\,0.6628\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Let $X$ represent the annual income (in dollars) of a randomly selected employee. Then we have $X∼N(50\\,000,15\\,{000}^{2}).$\n\nWe want to find $P(46\\,700<X<56\\,150).$ First, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(46\\,700<X<56\\,150) & =P(\\frac{46\\,700-50\\,000}{15\\,000}<Z<\\frac{56\\,150-50\\,000}{15\\,000}) \\\\  & =P(-0.22<Z<0.41)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.22<Z<0.41) & =P(Z<0.41)-P(Z\\le -0.22) \\\\  & =P(Z\\le 0.41)-P(Z\\le -0.22) \\\\  & =Φ(0.41)-Φ(-0.22)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(0.41) & =0.6591 \\\\ Φ(-0.22) & =0.4129.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}P(-0.22<Z<0.41) & =Φ(0.41)-Φ(-0.22) \\\\  & =0.6591-0.4129 \\\\  & =0.2462 \\\\  & ≈0.25\\end{aligned}\n$$\n\nTherefore, the probability that a randomly selected employee's income is more than $$46\\,700$ but less than $$56\\,150$ is approximately $0.25.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-606b941c-af91-539a-a82d-135b0666034b"] :db/ensure [:question/validate]} {:db/id "answer-field-606b941c-af91-539a-a82d-135b0666034b" :answer-field/id #uuid "606b941c-af91-539a-a82d-135b0666034b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9f019a42-6b8b-554e-91e3-893c44124a34" :answer-field/choices ["answer-cccb4d2d-b8aa-572e-aae2-f7163ea703a2" "answer-fb074b86-3190-5f6d-8a8e-9fbdb9461d89" "answer-e80d0d28-5add-54e4-97f4-c1b73ae40982" "answer-9f019a42-6b8b-554e-91e3-893c44124a34" "answer-6e35f18e-1bf6-5d1a-8e59-13ab06067872"] :db/ensure [:answer-field/validate]} {:db/id "answer-cccb4d2d-b8aa-572e-aae2-f7163ea703a2" :answer/id #uuid "cccb4d2d-b8aa-572e-aae2-f7163ea703a2" :answer/type :answer.type/math :answer/value "0.17" :db/ensure [:answer/validate]} {:db/id "answer-fb074b86-3190-5f6d-8a8e-9fbdb9461d89" :answer/id #uuid "fb074b86-3190-5f6d-8a8e-9fbdb9461d89" :answer/type :answer.type/math :answer/value "0.22" :db/ensure [:answer/validate]} {:db/id "answer-e80d0d28-5add-54e4-97f4-c1b73ae40982" :answer/id #uuid "e80d0d28-5add-54e4-97f4-c1b73ae40982" :answer/type :answer.type/math :answer/value "0.23" :db/ensure [:answer/validate]} {:db/id "answer-9f019a42-6b8b-554e-91e3-893c44124a34" :answer/id #uuid "9f019a42-6b8b-554e-91e3-893c44124a34" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "answer-6e35f18e-1bf6-5d1a-8e59-13ab06067872" :answer/id #uuid "6e35f18e-1bf6-5d1a-8e59-13ab06067872" :answer/type :answer.type/math :answer/value "0.27" :db/ensure [:answer/validate]} {:db/id 17592186083326 :knowledge-point/questions ["question-7012a871-ceb2-5bf5-9d51-cddf37c78344"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7012a871-ceb2-5bf5-9d51-cddf37c78344" :question/id #uuid "7012a871-ceb2-5bf5-9d51-cddf37c78344" :question/math-academy-id "q-133054" :question/problem "The average volume of soda in cans is $12$ ounces. Additionally, in $3%$ of cans, the soda volume is less than $11.7$ ounces. Assuming the volume of soda is normally distributed, find the percentage of cans containing less than $12.2$ ounces of soda, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,1.0\\,$ | $\\,0.8531\\,$ | $\\,0.8554\\,$ | $\\,0.8577\\,$ |\n| $\\,1.1\\,$ | $\\,0.8749\\,$ | $\\,0.8770\\,$ | $\\,0.8790\\,$ |\n| $\\,1.2\\,$ | $\\,0.8944\\,$ | $\\,0.8962\\,$ | $\\,0.8980\\,$ |" :question/worked-solution "Let $X$ represent the volume of soda in a randomly selected can. Then we have $X∼N(12,{\\sigma }^{2}),$ and we want to find $P(X<12.2).$ But first, we need to find the standard deviation $\\sigma .$\n\nWe know that $P(X<11.7)=0.03.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<11.7) & =0.03 \\\\ P(Z\\le \\frac{11.7-12}{\\sigma }) & =0.03 \\\\ Φ(\\frac{-0.3}{\\sigma }) & =0.03 \\\\ \\frac{-0.3}{\\sigma } & ={Φ}^{-1}(0.03)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.03)≈-1.8808.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{-0.3}{\\sigma } & =-1.8808 \\\\ \\frac{1}{\\sigma } & =6.26933 \\\\ \\sigma  & =\\frac{1}{6.26933} \\\\  & ≈0.1595.\\end{aligned}\n$$\n\n \n\nFinally, we can solve for $P(X<12.2)$ as follows:\n\n$$\n\\begin{aligned}P(X<12.2) & =P(X\\le 12.2) \\\\  & =P(Z\\le \\frac{12.2-12}{0.1595}) \\\\  & ≈P(Z\\le 1.25) \\\\  & =Φ(1.25) \\\\  & ≈89.4%\\end{aligned}\n$$\n\nTherefore, approximately $89.4%$  of soda cans contain less than $12.2$ ounces of soda." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d7a92c6e-2892-5988-ae79-425c23feccca"] :db/ensure [:question/validate]} {:db/id "answer-field-d7a92c6e-2892-5988-ae79-425c23feccca" :answer-field/id #uuid "d7a92c6e-2892-5988-ae79-425c23feccca" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3cebdaf-ad45-5124-8538-17b343686fe2" :answer-field/choices ["answer-30d8cfe9-4b93-5f75-80a5-535b163dfe29" "answer-34d6d3c7-1689-5248-895a-b81d7cf970d4" "answer-66956326-a3a4-5914-80b0-99ab80e8cc5d" "answer-b3cebdaf-ad45-5124-8538-17b343686fe2" "answer-6466cbf3-e0e7-5e28-a7cc-3d9c12cae870"] :db/ensure [:answer-field/validate]} {:db/id "answer-30d8cfe9-4b93-5f75-80a5-535b163dfe29" :answer/id #uuid "30d8cfe9-4b93-5f75-80a5-535b163dfe29" :answer/type :answer.type/math :answer/value "85.3%" :db/ensure [:answer/validate]} {:db/id "answer-34d6d3c7-1689-5248-895a-b81d7cf970d4" :answer/id #uuid "34d6d3c7-1689-5248-895a-b81d7cf970d4" :answer/type :answer.type/math :answer/value "87.5%" :db/ensure [:answer/validate]} {:db/id "answer-66956326-a3a4-5914-80b0-99ab80e8cc5d" :answer/id #uuid "66956326-a3a4-5914-80b0-99ab80e8cc5d" :answer/type :answer.type/math :answer/value "87.9%" :db/ensure [:answer/validate]} {:db/id "answer-b3cebdaf-ad45-5124-8538-17b343686fe2" :answer/id #uuid "b3cebdaf-ad45-5124-8538-17b343686fe2" :answer/type :answer.type/math :answer/value "89.4%" :db/ensure [:answer/validate]} {:db/id "answer-6466cbf3-e0e7-5e28-a7cc-3d9c12cae870" :answer/id #uuid "6466cbf3-e0e7-5e28-a7cc-3d9c12cae870" :answer/type :answer.type/math :answer/value "89.8%" :db/ensure [:answer/validate]} {:db/id "activity-64330229-1f3f-5a64-b45a-9aa819eb027e" :activity/id #uuid "64330229-1f3f-5a64-b45a-9aa819eb027e" :activity/title "Modeling With the Normal Distribution" :activity/type :activity.type/review :activity/scope 17592186050198 :activity/course 17592186046644 :activity/steps ["step-7b705082-7666-5f62-ba6d-d0a2f1a92ff1" "step-e8276290-fe52-5206-80df-9c013697fd59" "step-befbee96-262c-5724-ba3a-760d3be072eb" "step-748cd377-8e7f-5346-aa3b-db4fe18ddcb5" "step-84ec6b96-1b9c-5175-9b67-1af8a664fc76"] :activity/first-step "step-7b705082-7666-5f62-ba6d-d0a2f1a92ff1" :db/ensure [:activity/validate]} {:db/id "step-7b705082-7666-5f62-ba6d-d0a2f1a92ff1" :step/id #uuid "7b705082-7666-5f62-ba6d-d0a2f1a92ff1" :step/content 17592186493962 :step/next "step-e8276290-fe52-5206-80df-9c013697fd59" :db/ensure [:step/validate]} {:db/id "step-e8276290-fe52-5206-80df-9c013697fd59" :step/id #uuid "e8276290-fe52-5206-80df-9c013697fd59" :step/content "question-1a1059d5-573e-59f8-8d92-01104e325d82" :step/next "step-befbee96-262c-5724-ba3a-760d3be072eb" :db/ensure [:step/validate]} {:db/id "step-befbee96-262c-5724-ba3a-760d3be072eb" :step/id #uuid "befbee96-262c-5724-ba3a-760d3be072eb" :step/content "question-bb189cdf-2b97-5db2-ae7a-d4991a5c036b" :step/next "step-748cd377-8e7f-5346-aa3b-db4fe18ddcb5" :db/ensure [:step/validate]} {:db/id "step-748cd377-8e7f-5346-aa3b-db4fe18ddcb5" :step/id #uuid "748cd377-8e7f-5346-aa3b-db4fe18ddcb5" :step/content "question-7012a871-ceb2-5bf5-9d51-cddf37c78344" :step/next "step-84ec6b96-1b9c-5175-9b67-1af8a664fc76" :db/ensure [:step/validate]} {:db/id "step-84ec6b96-1b9c-5175-9b67-1af8a664fc76" :step/id #uuid "84ec6b96-1b9c-5175-9b67-1af8a664fc76" :step/content 17592186302169 :db/ensure [:step/validate]} {:db/id 17592186074081 :question/problem "If $m∠A=(5x+16)^{∘}$ and $m∠B=(x+8)^{∘},$ find a value of $x$ that satisfies $\\operatorname{cot}⁡A=\\operatorname{tan}⁡B.$  Suppose that both $∠A$ and $∠B$ are acute." :question/worked-solution "If both angles are acute and $\\operatorname{cot}⁡A=\\operatorname{tan}⁡B,$ then the angles $∠A$ and $∠B$ must be complementary, and we have\n\n$$\n\\begin{aligned}(5x+16)^{∘}+(x+8)^{∘} & ={90}^{∘} \\\\ (6x+24)^{∘} & ={90}^{∘} \\\\ 6x+24 & =90 \\\\ 6x & =66 \\\\ x & =11.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186070354 :answer-field/correct 17592186070359 :db/ensure [:answer-field/validate]} {:db/id 17592186073674 :knowledge-point/questions ["question-48f83c42-2b91-552c-8245-857f1b1c658c" "question-2741d45a-fa16-53e2-880b-c02211a343a6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-48f83c42-2b91-552c-8245-857f1b1c658c" :question/id #uuid "48f83c42-2b91-552c-8245-857f1b1c658c" :question/math-academy-id "q-54180" :question/problem "Express $\\operatorname{cos}⁡(\\theta +{31}^{∘})$ as a cofunction of a complementary angle." :question/worked-solution "We know that the cofunction of $\\operatorname{cos}⁡\\theta $ is $\\operatorname{sin}⁡\\theta ,$ and the angle complementary to $\\theta +{31}^{∘}$ is \n\n$$\n{90}^{∘}-(\\theta +{31}^{∘})={90}^{∘}-\\theta -{31}^{∘}={59}^{∘}-\\theta .\n$$\n\nSo we have\n\n$$\n\\operatorname{cos}⁡(\\theta +{31}^{∘})=\\operatorname{sin}⁡({90}^{∘}-(\\theta +{31}^{∘}))=\\operatorname{sin}⁡({59}^{∘}-\\theta ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5d9dfd76-7e56-51fc-b4c9-69b55120139b"] :db/ensure [:question/validate]} {:db/id "answer-field-5d9dfd76-7e56-51fc-b4c9-69b55120139b" :answer-field/id #uuid "5d9dfd76-7e56-51fc-b4c9-69b55120139b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fc4b055c-aeb5-5d2a-b243-457b5c94d048" :answer-field/choices ["answer-a2f9945e-67bd-552a-92a0-da62f3ed7aec" "answer-249bd755-b9fc-5059-a4cc-054bc42e9314" "answer-eddd4ec4-631c-5919-aeb3-fe7717bba038" "answer-fc4b055c-aeb5-5d2a-b243-457b5c94d048" "answer-e568a46e-9865-52b5-95e3-a68f91b5f928"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2f9945e-67bd-552a-92a0-da62f3ed7aec" :answer/id #uuid "a2f9945e-67bd-552a-92a0-da62f3ed7aec" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡({31}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-249bd755-b9fc-5059-a4cc-054bc42e9314" :answer/id #uuid "249bd755-b9fc-5059-a4cc-054bc42e9314" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡({59}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-eddd4ec4-631c-5919-aeb3-fe7717bba038" :answer/id #uuid "eddd4ec4-631c-5919-aeb3-fe7717bba038" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡({31}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-fc4b055c-aeb5-5d2a-b243-457b5c94d048" :answer/id #uuid "fc4b055c-aeb5-5d2a-b243-457b5c94d048" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡({59}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-e568a46e-9865-52b5-95e3-a68f91b5f928" :answer/id #uuid "e568a46e-9865-52b5-95e3-a68f91b5f928" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡({59}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id 17592186073673 :knowledge-point/questions ["question-177a5181-a104-5ae5-8d0b-29a1b6bce482"] :db/ensure [:knowledge-point/validate]} {:db/id "question-177a5181-a104-5ae5-8d0b-29a1b6bce482" :question/id #uuid "177a5181-a104-5ae5-8d0b-29a1b6bce482" :question/math-academy-id "q-67541" :question/problem "Determine a value of $x$ satisfying the equation $\\operatorname{tan}⁡{51}^{∘}=\\operatorname{cot}⁡x.$" :question/worked-solution "Since the tangent of an angle equals the cotangent of its complement, we have\n\n$$\n\\operatorname{tan}⁡{51}^{∘}=\\operatorname{cot}⁡({90}^{∘}-{51}^{∘})=\\operatorname{cot}⁡{39}^{∘}.\n$$\n\nTherefore, $x={39}^{∘}$ satisfies the given equation." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-987f7db7-dd4a-52e2-baa4-bf058dad8795"] :db/ensure [:question/validate]} {:db/id "answer-field-987f7db7-dd4a-52e2-baa4-bf058dad8795" :answer-field/id #uuid "987f7db7-dd4a-52e2-baa4-bf058dad8795" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-52894601-4ce1-5150-accd-ddb12bf8ce0a" :answer-field/choices ["answer-95595f2a-9508-56a1-9b79-2e80f73d9cfe" "answer-f0745c84-f316-5a12-9678-2861eb0bf75f" "answer-52894601-4ce1-5150-accd-ddb12bf8ce0a" "answer-c879ab7d-d2e0-5cdf-a36d-49043d561722" "answer-1d6260fb-52da-585b-8762-43ddb0c85bd9"] :db/ensure [:answer-field/validate]} {:db/id "answer-95595f2a-9508-56a1-9b79-2e80f73d9cfe" :answer/id #uuid "95595f2a-9508-56a1-9b79-2e80f73d9cfe" :answer/type :answer.type/math :answer/value "{28}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-f0745c84-f316-5a12-9678-2861eb0bf75f" :answer/id #uuid "f0745c84-f316-5a12-9678-2861eb0bf75f" :answer/type :answer.type/math :answer/value "{32}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-52894601-4ce1-5150-accd-ddb12bf8ce0a" :answer/id #uuid "52894601-4ce1-5150-accd-ddb12bf8ce0a" :answer/type :answer.type/math :answer/value "{39}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-c879ab7d-d2e0-5cdf-a36d-49043d561722" :answer/id #uuid "c879ab7d-d2e0-5cdf-a36d-49043d561722" :answer/type :answer.type/math :answer/value "{49}^{∘}" :db/ensure [:answer/validate]} {:db/id "answer-1d6260fb-52da-585b-8762-43ddb0c85bd9" :answer/id #uuid "1d6260fb-52da-585b-8762-43ddb0c85bd9" :answer/type :answer.type/math :answer/value "{65}^{∘}" :db/ensure [:answer/validate]} {:db/id "question-2741d45a-fa16-53e2-880b-c02211a343a6" :question/id #uuid "2741d45a-fa16-53e2-880b-c02211a343a6" :question/math-academy-id "q-121635" :question/problem "Express $\\operatorname{csc}⁡({52}^{∘}-\\theta )$ as a cofunction of a complementary angle." :question/worked-solution "We know that the cofunction of $\\operatorname{csc}⁡\\theta $ is $\\operatorname{sec}⁡\\theta ,$ and the angle complementary to ${52}^{∘}-\\theta $ is \n\n$$\n{90}^{∘}-({52}^{∘}-\\theta )={90}^{∘}-{52}^{∘}+\\theta =\\theta +{38}^{∘}.\n$$\n\n \n\n So we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡({52}^{∘}-\\theta )=\\operatorname{sec}⁡({90}^{∘}-({52}^{∘}-\\theta ))=\\operatorname{sec}⁡(\\theta +{38}^{∘}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7dda5fed-8473-5945-9921-a17a8674675e"] :db/ensure [:question/validate]} {:db/id "answer-field-7dda5fed-8473-5945-9921-a17a8674675e" :answer-field/id #uuid "7dda5fed-8473-5945-9921-a17a8674675e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db5ab455-9105-51dc-b743-f8595cf1ed86" :answer-field/choices ["answer-28286d6d-ad07-57e3-bf30-df2a9fc9669f" "answer-db5ab455-9105-51dc-b743-f8595cf1ed86" "answer-bf651374-36d8-557f-b681-3dc03d4228d6" "answer-6c996574-91a9-51e8-9312-f04c34295651" "answer-3e419048-16ff-5c66-ae89-db3a66c0e04b"] :db/ensure [:answer-field/validate]} {:db/id "answer-28286d6d-ad07-57e3-bf30-df2a9fc9669f" :answer/id #uuid "28286d6d-ad07-57e3-bf30-df2a9fc9669f" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡(\\theta +{38}^{∘})" :db/ensure [:answer/validate]} {:db/id "answer-db5ab455-9105-51dc-b743-f8595cf1ed86" :answer/id #uuid "db5ab455-9105-51dc-b743-f8595cf1ed86" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡(\\theta +{38}^{∘})" :db/ensure [:answer/validate]} {:db/id "answer-bf651374-36d8-557f-b681-3dc03d4228d6" :answer/id #uuid "bf651374-36d8-557f-b681-3dc03d4228d6" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡({38}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-6c996574-91a9-51e8-9312-f04c34295651" :answer/id #uuid "6c996574-91a9-51e8-9312-f04c34295651" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡({38}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "answer-3e419048-16ff-5c66-ae89-db3a66c0e04b" :answer/id #uuid "3e419048-16ff-5c66-ae89-db3a66c0e04b" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡({38}^{∘}-\\theta )" :db/ensure [:answer/validate]} {:db/id "activity-2f13de55-4b4a-58a1-86bc-d11cf8ac70ea" :activity/id #uuid "2f13de55-4b4a-58a1-86bc-d11cf8ac70ea" :activity/title "Trigonometric Functions of Complementary Angles" :activity/type :activity.type/review :activity/scope 17592186050295 :activity/course 17592186046647 :activity/steps ["step-b6a5d555-12ef-5ca1-a482-6a77ec3f6c76" "step-ae182013-f585-5116-920c-7437b922e562" "step-fe87cad6-ab86-5015-a4aa-04da945279b2" "step-7b98e68e-3539-59ad-9433-947e7808f548"] :activity/first-step "step-b6a5d555-12ef-5ca1-a482-6a77ec3f6c76" :db/ensure [:activity/validate]} {:db/id "step-b6a5d555-12ef-5ca1-a482-6a77ec3f6c76" :step/id #uuid "b6a5d555-12ef-5ca1-a482-6a77ec3f6c76" :step/content 17592186074081 :step/next "step-ae182013-f585-5116-920c-7437b922e562" :db/ensure [:step/validate]} {:db/id "step-ae182013-f585-5116-920c-7437b922e562" :step/id #uuid "ae182013-f585-5116-920c-7437b922e562" :step/content "question-48f83c42-2b91-552c-8245-857f1b1c658c" :step/next "step-fe87cad6-ab86-5015-a4aa-04da945279b2" :db/ensure [:step/validate]} {:db/id "step-fe87cad6-ab86-5015-a4aa-04da945279b2" :step/id #uuid "fe87cad6-ab86-5015-a4aa-04da945279b2" :step/content "question-177a5181-a104-5ae5-8d0b-29a1b6bce482" :step/next "step-7b98e68e-3539-59ad-9433-947e7808f548" :db/ensure [:step/validate]} {:db/id "step-7b98e68e-3539-59ad-9433-947e7808f548" :step/id #uuid "7b98e68e-3539-59ad-9433-947e7808f548" :step/content "question-2741d45a-fa16-53e2-880b-c02211a343a6" :db/ensure [:step/validate]} {:db/id 17592186054609 :knowledge-point/questions ["question-d1b18b73-e150-5d64-9819-aec4cb39257d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054520 :question/problem "Calculate $\\displaystyle \\int \\dfrac{2}{3} x \\,\\textrm d x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{2}{3}x\\,\\text{d}x & =\\frac{2}{3}\\int x\\,\\text{d}x \\\\  & =\\frac{2}{3}(\\frac{{x}^{1+1}}{1+1})+C \\\\  & =\\frac{2}{3}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{1}{3}{x}^{2}+C\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186054610 :knowledge-point/questions ["question-ff9e2022-4a53-5fe0-872f-a1ba9a04eeb7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054521 :question/problem "Calculate $\\displaystyle \\int 6 \\,\\textrm d x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int 6\\,\\text{d}x & =6\\int 1\\,\\text{d}x \\\\  & =6\\int {x}^{0}\\,\\text{d}x \\\\  & =6\\cdot \\frac{{x}^{0+1}}{0+1}+C \\\\  & =6\\cdot x+C \\\\  & =6x+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\displaystyle \\int k \\,\\textrm d x = kx + C.$" :db/ensure [:question/validate]} {:db/id "question-d1b18b73-e150-5d64-9819-aec4cb39257d" :question/id #uuid "d1b18b73-e150-5d64-9819-aec4cb39257d" :question/math-academy-id "q-71161" :question/problem "Calculate $\\int (-3{x}^{4})\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int (-3{x}^{4})\\,\\text{d}x & =-3\\int {x}^{4}\\,\\text{d}x \\\\  & =-3(\\frac{{x}^{4+1}}{4+1})+C \\\\  & =-3\\cdot \\frac{{x}^{5}}{5}+C \\\\  & =-\\frac{3{x}^{5}}{5}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ed5d147f-c842-54bd-aa6e-2a8c2bb0981a"] :db/ensure [:question/validate]} {:db/id "answer-field-ed5d147f-c842-54bd-aa6e-2a8c2bb0981a" :answer-field/id #uuid "ed5d147f-c842-54bd-aa6e-2a8c2bb0981a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-33ec99ac-f5a9-54c6-98e8-d72f51562c10" :answer-field/choices ["answer-901f86ad-20b1-5cdb-a778-0edeead6c1fb" "answer-33ec99ac-f5a9-54c6-98e8-d72f51562c10" "answer-b43f7a5c-b51d-5889-ab8d-1480bbb2e7bd" "answer-2796cfc5-c5b4-5036-9f76-eece180c2cc2" "answer-4374fd25-2d74-5431-80a5-28f72721f792"] :db/ensure [:answer-field/validate]} {:db/id "answer-901f86ad-20b1-5cdb-a778-0edeead6c1fb" :answer/id #uuid "901f86ad-20b1-5cdb-a778-0edeead6c1fb" :answer/type :answer.type/math :answer/value "-3{x}^{5}+C" :db/ensure [:answer/validate]} {:db/id "answer-33ec99ac-f5a9-54c6-98e8-d72f51562c10" :answer/id #uuid "33ec99ac-f5a9-54c6-98e8-d72f51562c10" :answer/type :answer.type/math :answer/value "-\\frac{3{x}^{5}}{5}+C" :db/ensure [:answer/validate]} {:db/id "answer-b43f7a5c-b51d-5889-ab8d-1480bbb2e7bd" :answer/id #uuid "b43f7a5c-b51d-5889-ab8d-1480bbb2e7bd" :answer/type :answer.type/math :answer/value "-\\frac{5{x}^{4}}{3}+C" :db/ensure [:answer/validate]} {:db/id "answer-2796cfc5-c5b4-5036-9f76-eece180c2cc2" :answer/id #uuid "2796cfc5-c5b4-5036-9f76-eece180c2cc2" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{5}}{5}+C" :db/ensure [:answer/validate]} {:db/id "answer-4374fd25-2d74-5431-80a5-28f72721f792" :answer/id #uuid "4374fd25-2d74-5431-80a5-28f72721f792" :answer/type :answer.type/math :answer/value "3{x}^{5}+C" :db/ensure [:answer/validate]} {:db/id 17592186234301 :question/answer-fields ["answer-field-8b2dd282-7c66-5a9f-93bd-d3e9bb5a8ef8"] :db/ensure [:question/validate]} {:db/id "answer-field-8b2dd282-7c66-5a9f-93bd-d3e9bb5a8ef8" :answer-field/id #uuid "8b2dd282-7c66-5a9f-93bd-d3e9bb5a8ef8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9efc680f-55f3-555d-96a2-ae3ddb7269d4" :answer-field/choices ["answer-9efc680f-55f3-555d-96a2-ae3ddb7269d4" "answer-23b23d50-ec7e-5283-bb24-57bc04c38817" "answer-6bff873d-db16-58c6-828d-9d04047ad325" "answer-5c964151-5623-5fdc-9ce7-4cfbdba1065e" "answer-590fc5e9-5d00-592b-afac-117c353a8649"] :db/ensure [:answer-field/validate]} {:db/id "answer-9efc680f-55f3-555d-96a2-ae3ddb7269d4" :answer/id #uuid "9efc680f-55f3-555d-96a2-ae3ddb7269d4" :answer/type :answer.type/math :answer/value "-\\frac{1}{8{y}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "answer-23b23d50-ec7e-5283-bb24-57bc04c38817" :answer/id #uuid "23b23d50-ec7e-5283-bb24-57bc04c38817" :answer/type :answer.type/math :answer/value "-\\frac{4}{3{y}^{5}}+C" :db/ensure [:answer/validate]} {:db/id "answer-6bff873d-db16-58c6-828d-9d04047ad325" :answer/id #uuid "6bff873d-db16-58c6-828d-9d04047ad325" :answer/type :answer.type/math :answer/value "-\\frac{5}{2{y}^{4}}+C" :db/ensure [:answer/validate]} {:db/id "answer-5c964151-5623-5fdc-9ce7-4cfbdba1065e" :answer/id #uuid "5c964151-5623-5fdc-9ce7-4cfbdba1065e" :answer/type :answer.type/math :answer/value "-\\frac{8}{{y}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "answer-590fc5e9-5d00-592b-afac-117c353a8649" :answer/id #uuid "590fc5e9-5d00-592b-afac-117c353a8649" :answer/type :answer.type/math :answer/value "2{y}^{5}+C" :db/ensure [:answer/validate]} {:db/id "question-ff9e2022-4a53-5fe0-872f-a1ba9a04eeb7" :question/id #uuid "ff9e2022-4a53-5fe0-872f-a1ba9a04eeb7" :question/math-academy-id "q-71211" :question/problem "Calculate $\\int \\sqrt{2}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\sqrt{2}\\,\\text{d}x & =\\sqrt{2}\\int 1\\,\\text{d}x \\\\  & =\\sqrt{2}\\int {x}^{0}\\,\\text{d}x \\\\  & =\\sqrt{2}\\cdot \\frac{{x}^{0+1}}{0+1}+C \\\\  & =\\sqrt{2}\\cdot x+C \\\\  & =\\sqrt{2}x+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-50f1b673-19f5-5164-922c-b2dc053f239a"] :db/ensure [:question/validate]} {:db/id "answer-field-50f1b673-19f5-5164-922c-b2dc053f239a" :answer-field/id #uuid "50f1b673-19f5-5164-922c-b2dc053f239a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b61f7c74-a68c-57f9-a458-5c56d1c4158f" :answer-field/choices ["answer-e38f07bf-781f-5e6f-94e6-5baf1c776460" "answer-03efb655-847a-5bcb-957d-58c75c12c43d" "answer-b61f7c74-a68c-57f9-a458-5c56d1c4158f" "answer-baa6b3d3-506a-5dae-b764-a83e73f9e8f8" "answer-018a5852-2b19-5946-a5b1-21699845a15e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e38f07bf-781f-5e6f-94e6-5baf1c776460" :answer/id #uuid "e38f07bf-781f-5e6f-94e6-5baf1c776460" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{x}+C" :db/ensure [:answer/validate]} {:db/id "answer-03efb655-847a-5bcb-957d-58c75c12c43d" :answer/id #uuid "03efb655-847a-5bcb-957d-58c75c12c43d" :answer/type :answer.type/math :answer/value "\\frac{x}{\\sqrt{2}}+C" :db/ensure [:answer/validate]} {:db/id "answer-b61f7c74-a68c-57f9-a458-5c56d1c4158f" :answer/id #uuid "b61f7c74-a68c-57f9-a458-5c56d1c4158f" :answer/type :answer.type/math :answer/value "\\sqrt{2}x+C" :db/ensure [:answer/validate]} {:db/id "answer-baa6b3d3-506a-5dae-b764-a83e73f9e8f8" :answer/id #uuid "baa6b3d3-506a-5dae-b764-a83e73f9e8f8" :answer/type :answer.type/math :answer/value "\\sqrt{2}{x}^{2}+C" :db/ensure [:answer/validate]} {:db/id "answer-018a5852-2b19-5946-a5b1-21699845a15e" :answer/id #uuid "018a5852-2b19-5946-a5b1-21699845a15e" :answer/type :answer.type/math :answer/value "x+C" :db/ensure [:answer/validate]} {:db/id 17592186055999 :tutorial/content "Suppose we want to find the integral of a power function multiplied by a constant, like $5x^2.$ How do we proceed?\n\nAccording to the **constant factor rule**, we can just take the constant factor out of the integral, like this:\n\n$$\n\\int 5 x^2\\, \\textrm{d}x = 5\\cdot \\int x^2 \\,\\textrm{d}x\n$$\n\nThen, we solve the integral using the power rule:\n\n$$\n\\begin{aligned}5\\cdot \\int {x}^{2}\\,\\text{d}x & =5\\cdot (\\frac{{x}^{2+1}}{2+1})+C \\\\  & =\\frac{5}{3}{x}^{3}+C\\end{aligned}\n$$\n\nWe can use this trick in general. Whenever the integrand is a function $f(x)$ multiplied by a constant $k,$ we can simplify as\n\n$$\n\\int k f(x)\\, \\textrm{d}x = k \\int f(x) \\,\\textrm{d}x.\n$$\n\n**Watch out!** We can only take *constant factors* out of integrals. We *cannot* take any variables out of integrals." :db/ensure [:tutorial/validate]} {:db/id 17592186054903 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186073917 :knowledge-point/questions ["question-cfe4ea96-fddc-550c-ac7a-6ec2d2c94652" "question-1ea750dd-05b5-599b-a75b-1d40366d85dc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cfe4ea96-fddc-550c-ac7a-6ec2d2c94652" :question/id #uuid "cfe4ea96-fddc-550c-ac7a-6ec2d2c94652" :question/math-academy-id "q-53703" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. $(x,y)↦(x-5,y)$\n\nII. $(x,y)↦(-y,x)$\n\nIII. $(x,y)↦(x,3y)$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I represents a translation by $5$ units to the left. Thus, it is a similarity transformation.\n\n- Transformation II represents a rotation by ${90}^{∘}$ counterclockwise around the origin. Thus, it is a similarity transformation.\n\n- Transformation III represents a stretch of factor $3$ in the $y$-direction. This is not a rigid motion.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eec1a239-a69c-51bb-a8aa-9e0e02460536"] :db/ensure [:question/validate]} {:db/id "answer-field-eec1a239-a69c-51bb-a8aa-9e0e02460536" :answer-field/id #uuid "eec1a239-a69c-51bb-a8aa-9e0e02460536" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0a4dea26-3eb3-5f68-9eb1-02c2680a892f" :answer-field/choices ["answer-0a4dea26-3eb3-5f68-9eb1-02c2680a892f" "answer-fb5e5c56-e5ce-55fd-bc03-e48b07508467" "answer-6c7e6e72-0b09-5a44-9520-dfe8cf8a7a8b" "answer-eaba3792-c563-5079-bcd1-af361f15f0d4" "answer-fc9917d3-0d49-551d-bb4f-aa7e5e3ff567"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a4dea26-3eb3-5f68-9eb1-02c2680a892f" :answer/id #uuid "0a4dea26-3eb3-5f68-9eb1-02c2680a892f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-fb5e5c56-e5ce-55fd-bc03-e48b07508467" :answer/id #uuid "fb5e5c56-e5ce-55fd-bc03-e48b07508467" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-6c7e6e72-0b09-5a44-9520-dfe8cf8a7a8b" :answer/id #uuid "6c7e6e72-0b09-5a44-9520-dfe8cf8a7a8b" :answer/type :answer.type/text :answer/value "I, II and III" :db/ensure [:answer/validate]} {:db/id "answer-eaba3792-c563-5079-bcd1-af361f15f0d4" :answer/id #uuid "eaba3792-c563-5079-bcd1-af361f15f0d4" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-fc9917d3-0d49-551d-bb4f-aa7e5e3ff567" :answer/id #uuid "fc9917d3-0d49-551d-bb4f-aa7e5e3ff567" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-1ea750dd-05b5-599b-a75b-1d40366d85dc" :question/id #uuid "1ea750dd-05b5-599b-a75b-1d40366d85dc" :question/math-academy-id "q-89161" :question/problem "Which of the following transformations map any polygon to a similar polygon?\n\nI. Stretching with stretch factor $6$ in the $x$-direction, then a translation by $2$ units downward\n\nII. Rotation by ${45}^{∘}$ clockwise around a point $O$ followed by reflection over a line $l$\n\nIII. Dilation of scale factor $4$ with center at $A,$ then translation by $6$ units to the right" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations.\n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the transformations in turn.\n\n- Transformation I includes stretching in only one direction. Thus, it is not a similarity transformation.\n\n- Transformation II is a combination of rotation and a reflection, which are rigid motions. Thus, it is a similarity transformation.\n\n- Transformation III is a combination of dilation of scale factor $4$ and a translation. Thus, it is a similarity transformation.\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f4eeffe0-d387-54ea-99bf-7c07fda39ad8"] :db/ensure [:question/validate]} {:db/id "answer-field-f4eeffe0-d387-54ea-99bf-7c07fda39ad8" :answer-field/id #uuid "f4eeffe0-d387-54ea-99bf-7c07fda39ad8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be0af016-3822-5b80-b2b9-b035f07b9902" :answer-field/choices ["answer-41f1557f-aa1b-5c6b-97f9-3183a0fdae13" "answer-8861175f-b2e1-5165-afbc-bffd586e1f4b" "answer-c746c42b-4136-5b7a-8e70-85095e0c0424" "answer-be0af016-3822-5b80-b2b9-b035f07b9902" "answer-5eeba46f-9dda-59a4-86da-d1ee0173c9ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-41f1557f-aa1b-5c6b-97f9-3183a0fdae13" :answer/id #uuid "41f1557f-aa1b-5c6b-97f9-3183a0fdae13" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-8861175f-b2e1-5165-afbc-bffd586e1f4b" :answer/id #uuid "8861175f-b2e1-5165-afbc-bffd586e1f4b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-c746c42b-4136-5b7a-8e70-85095e0c0424" :answer/id #uuid "c746c42b-4136-5b7a-8e70-85095e0c0424" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-be0af016-3822-5b80-b2b9-b035f07b9902" :answer/id #uuid "be0af016-3822-5b80-b2b9-b035f07b9902" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-5eeba46f-9dda-59a4-86da-d1ee0173c9ef" :answer/id #uuid "5eeba46f-9dda-59a4-86da-d1ee0173c9ef" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id 17592186073784 :knowledge-point/questions ["question-e8890925-6102-5a39-922f-cbb90bd120c9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e8890925-6102-5a39-922f-cbb90bd120c9" :question/id #uuid "e8890925-6102-5a39-922f-cbb90bd120c9" :question/math-academy-id "q-89714" :question/problem "A square $ABCD$ is translated by $3$ units to the left and $3$ units upward. If the resulting quadrilateral is $PQRS,$ which of the following statements must be true?\n\nI. $ABCD∼PQRS$\n\nII. $ABCD≅PQRS$\n\nIII. $\\overset{―}{BC}≅\\overset{―}{QR}$" :question/worked-solution "A similarity transformation is any transformation made up of rigid motions (rotations, reflections, and translations) and dilations. \n\nA similarity transformation will map any polygon to a similar polygon.\n\nWith that in mind, let's examine each of the statements in turn.\n\n- Statement I is true. We are given a combination of translations. As a result, we obtain that \n\n$$\nABCD∼PQRS.\n$$\n\n- Statement II is true. Since our combined transformation consists of rigid motions only (namely, translations), the distance between all points is preserved under the transformation. Therefore,  we obtain that \n\n$$\nABCD≅PQRS.\n$$\n\n- Statement III is true. Since $ABCD≅PQRS,$ all corresponding sides must be congruent. Therefore, \n\n$$\n\\overset{―}{BC}≅\\overset{―}{QR}.\n$$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6f5beb74-044c-5e40-8586-8ba7b7f03022"] :db/ensure [:question/validate]} {:db/id "answer-field-6f5beb74-044c-5e40-8586-8ba7b7f03022" :answer-field/id #uuid "6f5beb74-044c-5e40-8586-8ba7b7f03022" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc6eb254-4764-5546-881b-d06219358af3" :answer-field/choices ["answer-1ed52675-1674-5013-b977-2c1156e5c97e" "answer-eb50b3d4-f784-52f7-8f87-e4315c20fe44" "answer-dc6eb254-4764-5546-881b-d06219358af3" "answer-de8ea9cd-d289-5e31-b480-860682054345" "answer-def95e8e-df89-5823-b269-5d8d58bb3e5b"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ed52675-1674-5013-b977-2c1156e5c97e" :answer/id #uuid "1ed52675-1674-5013-b977-2c1156e5c97e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-eb50b3d4-f784-52f7-8f87-e4315c20fe44" :answer/id #uuid "eb50b3d4-f784-52f7-8f87-e4315c20fe44" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-dc6eb254-4764-5546-881b-d06219358af3" :answer/id #uuid "dc6eb254-4764-5546-881b-d06219358af3" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-de8ea9cd-d289-5e31-b480-860682054345" :answer/id #uuid "de8ea9cd-d289-5e31-b480-860682054345" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-def95e8e-df89-5823-b269-5d8d58bb3e5b" :answer/id #uuid "def95e8e-df89-5823-b269-5d8d58bb3e5b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "activity-de7cd668-3db3-5af6-b281-2d79561e3e20" :activity/id #uuid "de7cd668-3db3-5af6-b281-2d79561e3e20" :activity/title "Similarity Transformations" :activity/type :activity.type/review :activity/scope 17592186048583 :activity/course 17592186046647 :activity/steps ["step-eab95375-eb28-5e00-b681-d227e2c00467" "step-ccd3e0af-ff85-5d17-8152-0c5d9758036f" "step-34047e62-3d93-591d-8a51-e16282e2c37f"] :activity/first-step "step-eab95375-eb28-5e00-b681-d227e2c00467" :db/ensure [:activity/validate]} {:db/id "step-eab95375-eb28-5e00-b681-d227e2c00467" :step/id #uuid "eab95375-eb28-5e00-b681-d227e2c00467" :step/content "question-cfe4ea96-fddc-550c-ac7a-6ec2d2c94652" :step/next "step-ccd3e0af-ff85-5d17-8152-0c5d9758036f" :db/ensure [:step/validate]} {:db/id "step-ccd3e0af-ff85-5d17-8152-0c5d9758036f" :step/id #uuid "ccd3e0af-ff85-5d17-8152-0c5d9758036f" :step/content "question-1ea750dd-05b5-599b-a75b-1d40366d85dc" :step/next "step-34047e62-3d93-591d-8a51-e16282e2c37f" :db/ensure [:step/validate]} {:db/id "step-34047e62-3d93-591d-8a51-e16282e2c37f" :step/id #uuid "34047e62-3d93-591d-8a51-e16282e2c37f" :step/content "question-e8890925-6102-5a39-922f-cbb90bd120c9" :db/ensure [:step/validate]} [:db/retract 17592186175582 :answer-field/choices 17592186175584] [:db/retract 17592186175582 :answer-field/choices 17592186175585] [:db/retract 17592186175582 :answer-field/choices 17592186175586] [:db/retract 17592186175582 :answer-field/choices 17592186175587] [:db/retract 17592186175582 :answer-field/choices 17592186175583] {:db/id 17592186175947 :knowledge-point/questions ["question-aa64cd03-641d-5fbe-b490-fd0f93407035" "question-b39bf78a-2c45-5cec-8ca0-7f6b069d4c47" "question-d4806679-d98f-5bc2-87be-0a6d9963a840" "question-172429bc-7db9-5917-9fbf-cfae2b8af5b0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175796 :question/problem "The graph of $y=f'(x)$, the derivative of $y=f(x)$, is defined on the interval $[-2,3]$ as shown below. Find all of the inflection points of $y=f(x)$ for $x\\in(-2,3).$ \n\n![](images/1d/1da07563588809f268054c88f684f47c701f4daeeb2bfdcb5c01d3f4d9aaa397.png)" :question/worked-solution "First, note that $f'(x)$ exists at every point on the interval $x\\in [-2,3].$\n\nWe need to investigate the behavior of $f''(x).$ We recall the following:\n\n- When $f'(x)$ is increasing, we have $f''(x)>0.$\n\n- When $f'(x)$ is decreasing, we have $f''(x)<       0.$\n\nThe function $f(x)$ has an inflection point at $x=a,$ if the following two conditions are satisfied:\n\n- $f''(x)=0$ or $f''(x)$ is undefined, and\n\n- $f''(x)$ changes its sign (from negative to positive or vice versa) at that point.\n\nWe summarize the information from the given graph in the table below:\n\n| $x$ | $(-2,-1)$ | $-1$ | $(-1,1)$ | $1$ | $(1,3)$ |\n| --- | --- | --- | --- | --- | --- |\n| $f'$ | $\\searrow$ |  | $\\searrow$ |  | $\\nearrow$ |\n| $f''$ | $-$ | $\\text{not def.}$ | $-$ | $\\text{not def.}$ | $+$ |\n\nFrom the table, we see that $f''(x)$ changes its sign at the point $x=1.$ Therefore, $x=1$ is a point of inflection of $y=f(x).$\n\nNote that the sign of $f''(x)$ does not change at $x=-1,$ and so this is *not* a point of inflection." :db/ensure [:question/validate]} {:db/id 17592186175900 :knowledge-point/questions ["question-627aa48c-c5a6-5e2c-bbad-89df3a735c3c" "question-b66a1e23-ff78-5796-afef-31e3ad188600" "question-613b77ce-0261-57ef-a0c0-d6ed0660c89d" "question-1cc6f806-f012-5062-b71f-ffac34d675d4" "question-90895ef1-1562-5ad7-aeaa-a3c532c8d41b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175765 :question/problem "The graph $y=g'(x),$ the derivative of $y=g(x),$ is shown below. Which of the following statements **must** be true?\n\nI. $g(x)$ has a relative maximum at $x=1.5$\n\nII. $g(x)$ has a relative minimum at $x=5$\n\nIII. $g(x)$ has an inflection point at $x=3.5$\n\n![](images/58/582d792bf3854b0060e23e171fdc0c72e6486d09b0f1be47552ec4338d3f8ba1.png)" :question/worked-solution "First, notice that $y=g'(x)$ intersects the $x$-axis at the points $A$ and $B,$ as shown below.\n\n![](images/fb/fbfcc5d729dea273d9b60c2ef80e10696aa0631698a7cb4ff009f54fb59b1ea3.png)\n\nAn extremum of $y=g(x)$ occurs when the graph $y=g'(x)$ changes its sign. Checking the first derivative at the points $A$ and $B,$ we see that\n\n- the point $A,$ at $x=1.5,$ is a relative maximum of $g(x)$ since the derivative $g'(x)$ switches from positive to negative, and\n\n- the point $B,$ at $x=5,$ is a relative minimum of $g(x)$ since the derivative $g'(x)$ switches from negative to positive.\n\nTherefore, statements I and II are true.\n\nNow, an inflection point may occur where the second derivative $y=g''(x)$ is zero (the tangent line to $y=g'(x)$ is horizontal) or $y=g''(x)$ does not exist (a rapid change in the slope). Indeed, at the point $x=3.5,$ which we label as $C,$ we see that the slope of $g'(x)$ is zero, meaning that $g''(x)=0.$\n\n![](images/e4/e4e945f8e45cd67982246dbd1798f3958eff114f7dc04ff98c3a30f5f570eff9.png)\n\nWe obtain an inflection point if the slope of the tangent line to $y=g'(x)$ changes its sign. Thus, we have an inflection point at $C$, where the slope goes from negative to positive. Therefore, statement III is true.\n\nIn conclusion, all three statements are true." :db/ensure [:question/validate]} {:db/id "question-aa64cd03-641d-5fbe-b490-fd0f93407035" :question/id #uuid "aa64cd03-641d-5fbe-b490-fd0f93407035" :question/math-academy-id "q-104027" :question/problem "![](images/9f/9ffebb1757b03211d1dd7d8d53ea8a02bd5262534fb868b44662f5a4e5f6fbd8.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of $y=f(x)$, is defined on the interval $[-3,3]$ as shown above. Find all of the inflection points of $y=f(x)$ for $x\\in (-3,3).$" :question/worked-solution "First, note that ${f}^{′}(x)$ exists at every point on the interval $x\\in [-3,3].$\n\nWe need to investigate the behavior of ${f}^{″}(x).$ We recall the following:\n\n- When ${f}^{′}(x)$ is increasing, we have ${f}^{″}(x)>0.$\n\n- When ${f}^{′}(x)$ is decreasing, we have ${f}^{″}(x)<0.$\n\nThe function $f(x)$ has an inflection point at $x=a,$ if the following two conditions are satisfied:\n\n- ${f}^{″}(x)=0$ or ${f}^{″}(x)$ is undefined, and\n\n- ${f}^{″}(x)$ changes its sign (from negative to positive or vice versa) at that point.\n\nWe summarize the information from the given graph in the table below:\n\n| $x$ | $(-3,-1)$ | $-1$ | $(-1,0)$ | $0$ | $(0,1)$ | $1$ | $(1,3)$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $↗$ |  | $↘$ |  | $↗$ |  | $↗$ |\n| ${f}^{″}$ | $+$ | $0$ | $-$ | $\\text{not def.}$ | $+$ | $\\text{not def.}$ | $+$ |\n\nFrom the table, we conclude that ${f}^{″}(x)$ changes its sign at the points $x=-1$ and $x=0$ (note that ${f}^{″}(x)$ does not change the sign when it passes through $x=1$). Therefore, $x=-1$ and $x=0$ are  the points of inflection of $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6413a700-8297-5d14-a631-3c517a8e3a82"] :db/ensure [:question/validate]} {:db/id "answer-field-6413a700-8297-5d14-a631-3c517a8e3a82" :answer-field/id #uuid "6413a700-8297-5d14-a631-3c517a8e3a82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5dfd7198-ef12-5126-93c7-69d69036ae74" :answer-field/choices ["answer-5dfd7198-ef12-5126-93c7-69d69036ae74" "answer-40e0d2de-b084-5a07-afc2-79680730e646" "answer-6b97aa84-fc94-58d4-91a9-22371fae28a7" "answer-aaa76cea-fc52-5a9f-a2a3-c9175a2ee88b" "answer-20f2b55d-569c-51eb-b9b0-8f386f1d3fd2"] :db/ensure [:answer-field/validate]} {:db/id "answer-5dfd7198-ef12-5126-93c7-69d69036ae74" :answer/id #uuid "5dfd7198-ef12-5126-93c7-69d69036ae74" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=0$" :db/ensure [:answer/validate]} {:db/id "answer-40e0d2de-b084-5a07-afc2-79680730e646" :answer/id #uuid "40e0d2de-b084-5a07-afc2-79680730e646" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-6b97aa84-fc94-58d4-91a9-22371fae28a7" :answer/id #uuid "6b97aa84-fc94-58d4-91a9-22371fae28a7" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-aaa76cea-fc52-5a9f-a2a3-c9175a2ee88b" :answer/id #uuid "aaa76cea-fc52-5a9f-a2a3-c9175a2ee88b" :answer/type :answer.type/text :answer/value "$x=0$ only" :db/ensure [:answer/validate]} {:db/id "answer-20f2b55d-569c-51eb-b9b0-8f386f1d3fd2" :answer/id #uuid "20f2b55d-569c-51eb-b9b0-8f386f1d3fd2" :answer/type :answer.type/text :answer/value "$x=1$ only" :db/ensure [:answer/validate]} {:db/id "question-b39bf78a-2c45-5cec-8ca0-7f6b069d4c47" :question/id #uuid "b39bf78a-2c45-5cec-8ca0-7f6b069d4c47" :question/math-academy-id "q-104018" :question/problem "![](images/e9/e9da73fadd389e8cb47c58eb980e0f2dee6b36f3bb0475466090bd5ac3bfb35c.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of $y=f(x)$, is defined on the interval $[-4,4]$ and shown above. Find all the inflection points for $y=f(x)$ on $(-4,4).$" :question/worked-solution "First, note that ${f}^{′}(x)$ exists at every point of the interval $x\\in [-4,4].$\n\nWe need to investigate the behavior of ${f}^{″}(x).$ We recall the following:\n\n- When ${f}^{′}(x)$ is increasing, we have ${f}^{″}(x)>0.$\n\n- When ${f}^{′}(x)$ is decreasing, we have ${f}^{″}(x)<0.$\n\nThe function $f(x)$ has an inflection point at $x=a,$ if the following two conditions are satisfied:\n\n- ${f}^{″}(x)=0$ or ${f}^{″}(x)$ is undefined, and\n\n- ${f}^{″}(x)$ changes its sign (from negative to positive or vice versa) at that point.\n\nWe summarize the information from the given graph in the table below:\n\n| $x$ | $(-4,-1)$ | $-1$ | $(-1,1)$ | $1$ | $(1,2)$ | $2$ | $(2,4)$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $↗$ |  | $\\text{const.}$ |  | $↗$ | $0$ | $↘$ |\n| ${f}^{″}$ | $+$ | $\\text{not def.}$ | $0$ | $\\text{not def.}$ | $+$ | $0$ | $-$ |\n\nFrom the table, we conclude that ${f}^{″}(x)$ changes its sign only  at the point $x=2.$ Therefore, $x=2$ is the only point of inflection of $y=f(x).$\n\n**Watch out!** The second derivative ${f}^{″}(x)$ does not change the sign when it passes through $x=-1$ or $x=1.$  Hence, neither $x=-1$ nor $x=1$ are points of inflection." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6eb636e9-e746-565d-8b30-702d3ffe597c"] :db/ensure [:question/validate]} {:db/id "answer-field-6eb636e9-e746-565d-8b30-702d3ffe597c" :answer-field/id #uuid "6eb636e9-e746-565d-8b30-702d3ffe597c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75334e32-7f03-5dfa-934f-b50d3ecfae98" :answer-field/choices ["answer-1d0f4454-3e2f-5733-8bb0-b8e1a8a2990e" "answer-bc9cc757-6fcd-59be-b35b-eae8323497d7" "answer-48cd4f95-5f94-5695-82e8-0b0840d549a1" "answer-a2b4b19f-126b-5d73-9cfc-c884d8dca55b" "answer-75334e32-7f03-5dfa-934f-b50d3ecfae98"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d0f4454-3e2f-5733-8bb0-b8e1a8a2990e" :answer/id #uuid "1d0f4454-3e2f-5733-8bb0-b8e1a8a2990e" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-bc9cc757-6fcd-59be-b35b-eae8323497d7" :answer/id #uuid "bc9cc757-6fcd-59be-b35b-eae8323497d7" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-48cd4f95-5f94-5695-82e8-0b0840d549a1" :answer/id #uuid "48cd4f95-5f94-5695-82e8-0b0840d549a1" :answer/type :answer.type/text :answer/value "$x=1$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-a2b4b19f-126b-5d73-9cfc-c884d8dca55b" :answer/id #uuid "a2b4b19f-126b-5d73-9cfc-c884d8dca55b" :answer/type :answer.type/text :answer/value "$x=1$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-75334e32-7f03-5dfa-934f-b50d3ecfae98" :answer/id #uuid "75334e32-7f03-5dfa-934f-b50d3ecfae98" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id "question-d4806679-d98f-5bc2-87be-0a6d9963a840" :question/id #uuid "d4806679-d98f-5bc2-87be-0a6d9963a840" :question/math-academy-id "q-104009" :question/problem "![](images/a1/a16176b3fe7ff15ca90aef4a829d53d5f8e64c16c9e0f623ca0d7378cc7fa8f1.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of $y=f(x)$, is defined on the interval $[-3,3]$ as shown above. Find all of the inflection points of $y=f(x)$ for $x\\in (-3,3).$" :question/worked-solution "First, note that ${f}^{′}(x)$ exists at every point on the interval $x\\in [-3,3].$ \n\nWe need to investigate the behavior of ${f}^{″}(x).$ We recall the following:\n\n- When ${f}^{′}(x)$ is increasing, we have ${f}^{″}(x)>0.$\n\n- When ${f}^{′}(x)$ is decreasing, we have ${f}^{″}(x)<0.$\n\nThe function $f(x)$ has an inflection point at $x=a,$ if the following two conditions are satisfied:\n\n- ${f}^{″}(x)=0$ or ${f}^{″}(x)$ is undefined, and\n\n- ${f}^{″}(x)$ changes its sign (from negative to positive or vice versa) at that point.\n\nWe summarize the information from the given graph in the table below:\n\n| $x$ | $(-3,-2)$ | $-2$ | $(-2,-1)$ | $-1$ | $(-1,1)$ | $1$ | $(1,3)$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $↗$ |  | $↘$ |  | $↗$ |  | $↘$ |\n| ${f}^{″}$ | $+$ | $0$ | $-$ | $\\text{not def.}$ | $+$ | $\\text{not def.}$ | $-$ |\n\nFrom the table, we conclude that ${f}^{″}(x)$ changes its sign at the points $x=-2,$  $x=-1$ and $x=1.$ Therefore, $x=-2,$ $x=-1$ and $x=1$ are  the points of inflection of $y=f(x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-18eb4c75-46a0-5a83-b09d-9588dd282967"] :db/ensure [:question/validate]} {:db/id "answer-field-18eb4c75-46a0-5a83-b09d-9588dd282967" :answer-field/id #uuid "18eb4c75-46a0-5a83-b09d-9588dd282967" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7760ce3-fd8a-5b32-94d8-4cb2bb52143a" :answer-field/choices ["answer-524b76af-8aa4-5c07-b317-b7edfa6e3f76" "answer-d246892f-bf9b-50d6-a3de-71fe4d2e1a03" "answer-302fde07-bc48-5c72-b8b3-034b319ccbbf" "answer-e1ffc3b9-671e-5a5a-8aa7-e17a9cbf4f00" "answer-a7760ce3-fd8a-5b32-94d8-4cb2bb52143a"] :db/ensure [:answer-field/validate]} {:db/id "answer-524b76af-8aa4-5c07-b317-b7edfa6e3f76" :answer/id #uuid "524b76af-8aa4-5c07-b317-b7edfa6e3f76" :answer/type :answer.type/text :answer/value "$x=-1$  and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-d246892f-bf9b-50d6-a3de-71fe4d2e1a03" :answer/id #uuid "d246892f-bf9b-50d6-a3de-71fe4d2e1a03" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=-1$" :db/ensure [:answer/validate]} {:db/id "answer-302fde07-bc48-5c72-b8b3-034b319ccbbf" :answer/id #uuid "302fde07-bc48-5c72-b8b3-034b319ccbbf" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=1$" :db/ensure [:answer/validate]} {:db/id "answer-e1ffc3b9-671e-5a5a-8aa7-e17a9cbf4f00" :answer/id #uuid "e1ffc3b9-671e-5a5a-8aa7-e17a9cbf4f00" :answer/type :answer.type/text :answer/value "$x=-2$ only" :db/ensure [:answer/validate]} {:db/id "answer-a7760ce3-fd8a-5b32-94d8-4cb2bb52143a" :answer/id #uuid "a7760ce3-fd8a-5b32-94d8-4cb2bb52143a" :answer/type :answer.type/text :answer/value "$x=-2,$ $x=-1$  and $x=1$" :db/ensure [:answer/validate]} {:db/id "question-172429bc-7db9-5917-9fbf-cfae2b8af5b0" :question/id #uuid "172429bc-7db9-5917-9fbf-cfae2b8af5b0" :question/math-academy-id "q-342885" :question/problem "![](images/15/1505bc3714405515ec7d5a834c6d08f849b3adbf8678a76b3b5cf27ccf394e28.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of $y=f(x)$, is defined on the interval $[-3,3]$ as shown above. In **ascending order**, the points of inflection of  $y=f(x)$ for $x\\in (-3,3)$ are\n\n$x=$\n{{field-1}}, $\\,x=$\n\n{{field-2}}, $\\,x=$\n{{field-3}}." :question/worked-solution "First, note that ${f}^{′}(x)$ exists at every point on the interval $x\\in [-3,3].$\n\nWe need to investigate the behavior of ${f}^{″}(x).$ We recall the following:\n\n- When ${f}^{′}(x)$ is increasing, we have ${f}^{″}(x)>0.$\n\n- When ${f}^{′}(x)$ is decreasing, we have ${f}^{″}(x)<0.$\n\nThe function $f(x)$ has an inflection point at $x=a,$ if the following two conditions are satisfied:\n\n- ${f}^{″}(x)=0$ or ${f}^{″}(x)$ is undefined, and\n\n- ${f}^{″}$ changes its sign (from negative to positive or vice versa) at that point\n\nWe summarize the information from the given graph in the table below:\n\n| $x$ | $(-3,-2)$ | $-2$ | $(-2,-1)$ | $-1$ | $(-1,0)$ | $0$ | $(0,1)$ | $1$ | $(1,2)$ | $2$ | $(2,3)$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $↗$ |  | $↘$ |  | $↘$ |  | $↗$ |  | $↗$ |  | $↘$ |\n| ${f}^{″}$ | $+$ | $\\text{not def.}$ | $-$ | $0$ | $-$ | $\\text{not def.}$ | $+$ | $0$ | $+$ | $\\text{not def.}$ | $-$ |\n\nFrom the table, we see that ${f}^{″}(x)$ changes its sign at the points $x=-2,$ $x=0,$ and $x=2$ (note that ${f}^{″}(x)$ does not change the sign when it passes through $x=-1$ and $x=1$).\n\nTherefore, in ascending order, the points of inflection are \n\n$$\nx=-2,\\,x=0,\\,x=2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-26b788ac-a0f8-59c2-8a01-0ec009831d0f" "answer-field-75ffc624-fd9a-513f-a70d-71e23491db92" "answer-field-e99ddf10-2ad1-5e8d-b98e-05b3db34966c"] :db/ensure [:question/validate]} {:db/id "answer-field-26b788ac-a0f8-59c2-8a01-0ec009831d0f" :answer-field/id #uuid "26b788ac-a0f8-59c2-8a01-0ec009831d0f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-393c5acb-26e9-5ef0-ad19-710d1bfb42a7" :answer-field/choices ["answer-393c5acb-26e9-5ef0-ad19-710d1bfb42a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-393c5acb-26e9-5ef0-ad19-710d1bfb42a7" :answer/id #uuid "393c5acb-26e9-5ef0-ad19-710d1bfb42a7" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-75ffc624-fd9a-513f-a70d-71e23491db92" :answer-field/id #uuid "75ffc624-fd9a-513f-a70d-71e23491db92" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4a531457-4411-5f7f-9349-fe057e4a59ce" :answer-field/choices ["answer-4a531457-4411-5f7f-9349-fe057e4a59ce"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a531457-4411-5f7f-9349-fe057e4a59ce" :answer/id #uuid "4a531457-4411-5f7f-9349-fe057e4a59ce" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-e99ddf10-2ad1-5e8d-b98e-05b3db34966c" :answer-field/id #uuid "e99ddf10-2ad1-5e8d-b98e-05b3db34966c" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ba2f3daf-be8b-5b31-8c93-24d592d01dba" :answer-field/choices ["answer-ba2f3daf-be8b-5b31-8c93-24d592d01dba"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba2f3daf-be8b-5b31-8c93-24d592d01dba" :answer/id #uuid "ba2f3daf-be8b-5b31-8c93-24d592d01dba" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186176574 :question/problem "![](images/19/199a0809c86f57743fe954d1221656198f92339f146722928b46e598680d299f.png)\n\nThe graph of $y={f}^{′}(x)$, the derivative of $y=f(x)$, is defined on the interval $[-3,3]$ as shown above. Find all of the inflection points of $y=f(x)$ for $x\\in (-3,3).$" :question/worked-solution "First, note that ${f}^{′}(x)$ exists at every point on the interval $x\\in [-3,3].$\n\nWe need to investigate the behavior of ${f}^{″}(x).$ We recall the following:\n\n- When ${f}^{′}(x)$ is increasing, we have ${f}^{″}(x)>0.$\n\n- When ${f}^{′}(x)$ is decreasing, we have ${f}^{″}(x)<0.$\n\nThe function $f(x)$ has an inflection point at $x=a,$ if the following two conditions are satisfied:\n\n- ${f}^{″}(x)=0$ or ${f}^{″}(x)$ is undefined, and\n\n- ${f}^{″}(x)$ changes its sign (from negative to positive or vice versa) at that point.\n\nWe summarize the information from the given graph in the table below:\n\n| $x$ | $(-3,-1)$ | $-1$ | $(-1,1)$ | $1$ | $(1,3)$ |\n| --- | --- | --- | --- | --- | --- |\n| ${f}^{′}$ | $↗$ |  | $↘$ |  | $↗$ |\n| ${f}^{″}$ | $+$ | $\\text{not def.}$ | $-$ | $\\text{not def.}$ | $+$ |\n\nFrom the table, we conclude that ${f}^{″}(x)$ changes its sign at the points $x=-1$ and $x=1.$ Therefore, $x=-1$ and $x=1$ are the points of inflection of $y=f(x).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186175582 :answer-field/correct "answer-8f6cec58-1be3-5172-8721-f21acb7fd27f" :answer-field/choices ["answer-8f6cec58-1be3-5172-8721-f21acb7fd27f" "answer-d1df2cbc-6331-51a2-b674-f40ca0e480f0" "answer-cebddd16-be70-5c64-b343-e678dc075919" "answer-e9e68976-17e1-5b7d-962e-22b6597e86d8" "answer-0139d7bf-fb60-5bb3-895a-29c8b2baffc2"] :db/ensure [:answer-field/validate]} {:db/id "answer-8f6cec58-1be3-5172-8721-f21acb7fd27f" :answer/id #uuid "8f6cec58-1be3-5172-8721-f21acb7fd27f" :answer/type :answer.type/math :answer/value "x=\\pm 1" :db/ensure [:answer/validate]} {:db/id "answer-d1df2cbc-6331-51a2-b674-f40ca0e480f0" :answer/id #uuid "d1df2cbc-6331-51a2-b674-f40ca0e480f0" :answer/type :answer.type/text :answer/value "$x=-1$ only" :db/ensure [:answer/validate]} {:db/id "answer-cebddd16-be70-5c64-b343-e678dc075919" :answer/id #uuid "cebddd16-be70-5c64-b343-e678dc075919" :answer/type :answer.type/text :answer/value "$x=1$ only" :db/ensure [:answer/validate]} {:db/id "answer-e9e68976-17e1-5b7d-962e-22b6597e86d8" :answer/id #uuid "e9e68976-17e1-5b7d-962e-22b6597e86d8" :answer/type :answer.type/text :answer/value "$x=\\pm 1$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-0139d7bf-fb60-5bb3-895a-29c8b2baffc2" :answer/id #uuid "0139d7bf-fb60-5bb3-895a-29c8b2baffc2" :answer/type :answer.type/text :answer/value "$x=\\pm 1$ and $x=\\pm 2$" :db/ensure [:answer/validate]} {:db/id "question-627aa48c-c5a6-5e2c-bbad-89df3a735c3c" :question/id #uuid "627aa48c-c5a6-5e2c-bbad-89df3a735c3c" :question/math-academy-id "q-48933" :question/problem "![](images/30/30e2b42fd5b3ab5fb1ee538079b518fa4b98a637e81d7f9aad23b4dd718a4541.png)\n\nThe graph $y={h}^{′}(x)$, the derivative of $y=h(x)$, is shown above. Which of the following statements **must** be true?\n\nI. $h(x)$ has a relative maximum at $x=-2$\n\nII. The graph of $y=h(x)$ is concave down on the interval $(-2,1)$\n\nIII. $h(x)$ has a relative minimum at $x=3$" :question/worked-solution "Let's examine each of the statements separately.\n\n- Statement I is true. The graph $y={h}^{′}(x)$ intersects the $x$-axis at $x=-2$ meaning that ${h}^{′}(x)=0.$ Moreover, ${h}^{′}(x)$ changes its sign by going from positive to negative. Thus, there is a relative maximum at this point.\n\n- Statement II is false. The slope of the tangent line to $y={h}^{′}(x)$ changes its sign somewhere near $x=0.$ Hence, the graph $y=h(x)$ has an inflection point inside $(-2,1).$\n\n- Statement III is false. We have that ${h}^{′}(3)=0$ but ${h}^{′}(x)$ does not change its sign around this point. Thus, there is no extremum.\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5d770aae-42c0-5f0b-871d-eb4f44a03763"] :db/ensure [:question/validate]} {:db/id "answer-field-5d770aae-42c0-5f0b-871d-eb4f44a03763" :answer-field/id #uuid "5d770aae-42c0-5f0b-871d-eb4f44a03763" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a46c0b10-4731-5f98-bc15-bdb6fcf71a3f" :answer-field/choices ["answer-f47e3b37-7280-5e88-99ac-68de6ea9db99" "answer-c7b2d1e5-35ac-5046-99e3-a3b600bbe480" "answer-a46c0b10-4731-5f98-bc15-bdb6fcf71a3f" "answer-2707dfe2-84ea-5aa5-8685-b049f75c1c45" "answer-1506571b-f473-5928-83bd-11a20fc0ef9f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f47e3b37-7280-5e88-99ac-68de6ea9db99" :answer/id #uuid "f47e3b37-7280-5e88-99ac-68de6ea9db99" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-c7b2d1e5-35ac-5046-99e3-a3b600bbe480" :answer/id #uuid "c7b2d1e5-35ac-5046-99e3-a3b600bbe480" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-a46c0b10-4731-5f98-bc15-bdb6fcf71a3f" :answer/id #uuid "a46c0b10-4731-5f98-bc15-bdb6fcf71a3f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-2707dfe2-84ea-5aa5-8685-b049f75c1c45" :answer/id #uuid "2707dfe2-84ea-5aa5-8685-b049f75c1c45" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-1506571b-f473-5928-83bd-11a20fc0ef9f" :answer/id #uuid "1506571b-f473-5928-83bd-11a20fc0ef9f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-b66a1e23-ff78-5796-afef-31e3ad188600" :question/id #uuid "b66a1e23-ff78-5796-afef-31e3ad188600" :question/math-academy-id "q-104046" :question/problem "![](images/e5/e54c40efd2e67f41ab726eaf3ef13c56aab8acb56222e8db3c53de47e6bcf547.png)\n\nThe graph $y={f}^{′}(x)$, the derivative of $y=f(x)$, is shown above. Of the following, which best describes the function $y=f(x)$ on the interval $[-4,5]?$" :question/worked-solution "First, notice that $y={f}^{′}(x)$ intersects the $x$-axis (where we have ${f}^{′}(x)=0$) twice, at the points $A,$ $B$ and $C$ shown below.\n\n![](images/76/76c04c26b2641990e4528fb3e89c4ef72c7a27c67e289c88cb1d6034baf67ef7.png)\n\nAn extremum of $y=f(x)$ occurs when the graph $y={f}^{′}(x)$ changes its sign. Hence, we have a relative minimum at $A,$  since the derivative goes from negative to positive, and a relative maximum at $B,$  since the derivative goes from positive to negative.\n\nNow, an inflection point may occur where the second derivative $y={f}^{″}(x)$ is zero (the tangent line to $y={f}^{′}(x)$ is horizontal) or $y={f}^{″}(x)$ does not exist (a rapid change in the slope). These are the points $C$, $D,$ $E,$ and $F$ as shown on the graph below.\n\n![](images/12/1264de8104784e808891fbe44b176e0624e05fa1ea8058cf533c732016eca63d.png)\n\n \n\nWe obtain an inflection point if the slope of the tangent line to $y={f}^{′}(x)$ changes its sign. Thus, we have inflection points only at $C,D,$ and $E.$ Indeed, at points $C$ and $E$ the slope goes from positive to negative, while at $D$ the slope goes from negative to positive.\n\nTherefore, we get two relative extrema and three inflection points on $[-2,5]$ for $y=f(x).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b9cdc9c3-e9e6-55b0-85d0-226a22912581"] :db/ensure [:question/validate]} {:db/id "answer-field-b9cdc9c3-e9e6-55b0-85d0-226a22912581" :answer-field/id #uuid "b9cdc9c3-e9e6-55b0-85d0-226a22912581" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7d0bf746-9111-5462-8ba6-af6603c4c595" :answer-field/choices ["answer-fe5ac39a-198c-5dfd-ad39-72d3c6e2c864" "answer-09f70fff-74e5-5199-bd4b-3d36c38c70d3" "answer-7d0bf746-9111-5462-8ba6-af6603c4c595" "answer-58385d01-708f-525a-a0fd-c0e22b81dd95" "answer-41cffa6e-d5cc-5d5d-a843-ac6331011ca9"] :db/ensure [:answer-field/validate]} {:db/id "answer-fe5ac39a-198c-5dfd-ad39-72d3c6e2c864" :answer/id #uuid "fe5ac39a-198c-5dfd-ad39-72d3c6e2c864" :answer/type :answer.type/text :answer/value "$f(x)$ has a relative maximum and two inflection points" :db/ensure [:answer/validate]} {:db/id "answer-09f70fff-74e5-5199-bd4b-3d36c38c70d3" :answer/id #uuid "09f70fff-74e5-5199-bd4b-3d36c38c70d3" :answer/type :answer.type/text :answer/value "$f(x)$ has a relative minimum and two inflection points" :db/ensure [:answer/validate]} {:db/id "answer-7d0bf746-9111-5462-8ba6-af6603c4c595" :answer/id #uuid "7d0bf746-9111-5462-8ba6-af6603c4c595" :answer/type :answer.type/text :answer/value "$f(x)$ has two relative extrema and three inflection points" :db/ensure [:answer/validate]} {:db/id "answer-58385d01-708f-525a-a0fd-c0e22b81dd95" :answer/id #uuid "58385d01-708f-525a-a0fd-c0e22b81dd95" :answer/type :answer.type/text :answer/value "$f(x)$ has two relative maximum and one inflection point" :db/ensure [:answer/validate]} {:db/id "answer-41cffa6e-d5cc-5d5d-a843-ac6331011ca9" :answer/id #uuid "41cffa6e-d5cc-5d5d-a843-ac6331011ca9" :answer/type :answer.type/text :answer/value "$f(x)$ has two relative minimum and one inflection point" :db/ensure [:answer/validate]} {:db/id "question-613b77ce-0261-57ef-a0c0-d6ed0660c89d" :question/id #uuid "613b77ce-0261-57ef-a0c0-d6ed0660c89d" :question/math-academy-id "q-104037" :question/problem "![](images/6d/6d9d6bbd1f54319a6bf1aa8dae03d6ea7dc19e8430e7a5bfd72e805edbcfb6d5.png)\n\nThe graph $y={g}^{′}(x)$, the derivative of $y=g(x)$, is shown above. Which of the following statements **must** be true?\n\nI. The graph of $y=g(x)$ is concave down on the interval $(-1,1)$\n\nII. $g(x)$ has a critical point at $x=-2$\n\nIII. $g(x)$ has a relative minimum at $x=1$" :question/worked-solution "Let's examine each of the statements separately.\n\n- Statement I is false. The graph ${g}^{′}(x)$ is increasing on the interval $(0,1).$ Hence, ${g}^{″}(x)$ must be positive on $(0,1)$ and therefore, the graph of $y=g(x)$ is concave up on $(0,1)⊂(-1,1).$\n\n- Statement II is false. From the graph, we can conclude that ${g}^{′}(-2)$ exists and that it is not equal to $0.$ So, $x=-2$ is not a critical point of the function.\n\n- Statement III is true. Indeed, the first derivative ${g}^{′}(x)$ changes its sign at the point $x=1,$ from negative to positive. Therefore $g(x)$ has a relative minimum at $x=1.$\n\nTherefore, the correct answer is \"III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-dbc98646-cfbc-5ee7-82cb-9e03b52e88b7"] :db/ensure [:question/validate]} {:db/id "answer-field-dbc98646-cfbc-5ee7-82cb-9e03b52e88b7" :answer-field/id #uuid "dbc98646-cfbc-5ee7-82cb-9e03b52e88b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-24002a8c-4053-5201-bc0c-28685f54124a" :answer-field/choices ["answer-b96497cf-5c5b-55ec-980b-febea838617b" "answer-a888ff1a-d08a-5b98-a570-ea8ced7b3307" "answer-ba8a1bb5-c6cc-5faa-acf3-5cc85aaa3b08" "answer-7458719f-c08d-5909-b6c4-2332f4752741" "answer-24002a8c-4053-5201-bc0c-28685f54124a"] :db/ensure [:answer-field/validate]} {:db/id "answer-b96497cf-5c5b-55ec-980b-febea838617b" :answer/id #uuid "b96497cf-5c5b-55ec-980b-febea838617b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-a888ff1a-d08a-5b98-a570-ea8ced7b3307" :answer/id #uuid "a888ff1a-d08a-5b98-a570-ea8ced7b3307" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-ba8a1bb5-c6cc-5faa-acf3-5cc85aaa3b08" :answer/id #uuid "ba8a1bb5-c6cc-5faa-acf3-5cc85aaa3b08" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-7458719f-c08d-5909-b6c4-2332f4752741" :answer/id #uuid "7458719f-c08d-5909-b6c4-2332f4752741" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-24002a8c-4053-5201-bc0c-28685f54124a" :answer/id #uuid "24002a8c-4053-5201-bc0c-28685f54124a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-1cc6f806-f012-5062-b71f-ffac34d675d4" :question/id #uuid "1cc6f806-f012-5062-b71f-ffac34d675d4" :question/math-academy-id "q-49086" :question/problem "![](images/5a/5a753c70df3b523ccdeead554bee653ebba355d41ef95aea7ace17236fd38829.png)\n\nThe graph $y={g}^{′}(x)$, the derivative of $y=g(x)$, is shown above. Of the following, which best describes the function $y=g(x)$ on the interval $[-4,4]?$" :question/worked-solution "First, notice that $y={g}^{′}(x)$ intersects the $x$-axis (where we have ${g}^{′}(x)=0$) twice, at the points $A$ and $B$ as shown below.\n\n![](images/42/42e073c044b6bf9ced663bcb55bbd89d7ac79f85f918ca3364d2be3b2f8e74bc.png)\n\nAn extremum of $y=g(x)$ occurs when the graph $y={g}^{′}(x)$ changes its sign. Hence, we have an extremum at $B$ only. This is a relative maximum since the derivative goes from positive to negative.\n\nNow, an inflection point may occur where the second derivative $y={g}^{″}(x)$ is zero (the tangent line to $y={g}^{′}(x)$ is horizontal) or $y={g}^{″}(x)$ does not exist (a rapid change in the slope). These are points the $A$, $C$ and $D$ on the graph.\n\n![](images/65/650e68ff0dfbb6f0b679559a46532f2e29fb970f392a6bd4932b8363c2aa6777.png)\n\nWe obtain an inflection point if the slope of the tangent line to $y={g}^{′}(x)$ changes its sign. Thus, we have an inflection point at $A$, where the slope goes from negative to positive, and an inflection point at $C$, where the slope goes from positive to negative.\n\nTherefore, we get one relative maximum and two inflection points on $[-4,4]$ for $y=g(x).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6626c773-e0b2-5ef5-874e-85aeb86e599a"] :db/ensure [:question/validate]} {:db/id "answer-field-6626c773-e0b2-5ef5-874e-85aeb86e599a" :answer-field/id #uuid "6626c773-e0b2-5ef5-874e-85aeb86e599a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-274f6761-6dee-5f58-970a-634abfeec5f8" :answer-field/choices ["answer-274f6761-6dee-5f58-970a-634abfeec5f8" "answer-13c651e1-b750-5b3b-853a-335582693525" "answer-1af5da52-60e7-52ce-a067-eb10b1254363" "answer-1bf67587-3e1f-5acf-9d8f-828394e302f8" "answer-81d0c727-e883-5ab7-9182-e230e6ef6478"] :db/ensure [:answer-field/validate]} {:db/id "answer-274f6761-6dee-5f58-970a-634abfeec5f8" :answer/id #uuid "274f6761-6dee-5f58-970a-634abfeec5f8" :answer/type :answer.type/text :answer/value "$g(x)$ has one relative maximum and two inflection points" :db/ensure [:answer/validate]} {:db/id "answer-13c651e1-b750-5b3b-853a-335582693525" :answer/id #uuid "13c651e1-b750-5b3b-853a-335582693525" :answer/type :answer.type/text :answer/value "$g(x)$ has one relative maximum, one relative minimum, and one inflection point" :db/ensure [:answer/validate]} {:db/id "answer-1af5da52-60e7-52ce-a067-eb10b1254363" :answer/id #uuid "1af5da52-60e7-52ce-a067-eb10b1254363" :answer/type :answer.type/text :answer/value "$g(x)$ has one relative maximum, one relative minimum, and two inflection points" :db/ensure [:answer/validate]} {:db/id "answer-1bf67587-3e1f-5acf-9d8f-828394e302f8" :answer/id #uuid "1bf67587-3e1f-5acf-9d8f-828394e302f8" :answer/type :answer.type/text :answer/value "$g(x)$ has one relative minimum and one inflection point" :db/ensure [:answer/validate]} {:db/id "answer-81d0c727-e883-5ab7-9182-e230e6ef6478" :answer/id #uuid "81d0c727-e883-5ab7-9182-e230e6ef6478" :answer/type :answer.type/text :answer/value "$g(x)$ has two relative minima and two inflection points" :db/ensure [:answer/validate]} {:db/id "question-90895ef1-1562-5ad7-aeaa-a3c532c8d41b" :question/id #uuid "90895ef1-1562-5ad7-aeaa-a3c532c8d41b" :question/math-academy-id "q-104028" :question/problem "![](images/19/19ebd6ce74bf6b25b920869403effa677c6a4bef2dedef38a81f77794c99a195.png)\n\nThe graph $y={h}^{′}(x)$, the derivative of $y=h(x)$, is shown above. Which of the following statements **must** be true?\n\nI. $h(x)$ has a relative maximum at $x=-3$\n\nII. $h(x)$ has an inflection point on the interval $(0,2)$\n\nIII. $h(x)$ has a relative minimum at $x=2$" :question/worked-solution "Let's examine each of the statements separately.\n\n- Statement I is false. The graph of $y={h}^{′}(x)$ does not change sign around $x=-3$, therefore, there cannot be a relative extremum at this point.\n\n- Statement II is true. The slope of the tangent line to $y={h}^{′}(x)$ changes its sign somewhere near $x=1.$ Hence, the graph $y=h(x)$ has an inflection point inside $(0,2).$\n\n- Statement III is false. The graph of $y={h}^{′}(x)$ does not change sign around $x=2$, therefore, there cannot be a relative extremum at this point.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-13ddd976-7c9f-580f-a147-d2bc02dfe62e"] :db/ensure [:question/validate]} {:db/id "answer-field-13ddd976-7c9f-580f-a147-d2bc02dfe62e" :answer-field/id #uuid "13ddd976-7c9f-580f-a147-d2bc02dfe62e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8bb37db-fe44-5eec-a16e-9ca0e8df8a9a" :answer-field/choices ["answer-dc5ae25e-6d73-551e-a90f-5960d39695c3" "answer-b62c0101-16f2-5788-97d4-6a5710cf73f0" "answer-831d41b8-bd9e-5681-8c78-22285a833ee2" "answer-a8bb37db-fe44-5eec-a16e-9ca0e8df8a9a" "answer-aa1d5f2d-417e-586f-9ace-9804af68af61"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc5ae25e-6d73-551e-a90f-5960d39695c3" :answer/id #uuid "dc5ae25e-6d73-551e-a90f-5960d39695c3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-b62c0101-16f2-5788-97d4-6a5710cf73f0" :answer/id #uuid "b62c0101-16f2-5788-97d4-6a5710cf73f0" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-831d41b8-bd9e-5681-8c78-22285a833ee2" :answer/id #uuid "831d41b8-bd9e-5681-8c78-22285a833ee2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-a8bb37db-fe44-5eec-a16e-9ca0e8df8a9a" :answer/id #uuid "a8bb37db-fe44-5eec-a16e-9ca0e8df8a9a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-aa1d5f2d-417e-586f-9ace-9804af68af61" :answer/id #uuid "aa1d5f2d-417e-586f-9ace-9804af68af61" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186177063 :tutorial/content "Recall that we can use the second derivative to determine the concavity of a differentiable function $f(x)\\mathbin{:}$\n\n- $f(x)$ is concave up on an interval $(a,b)$ if $f''(x) > 0$ on $(a,b),$ while\n\n- $f(x)$ is concave down on an interval $(a,b)$ if $f''(x) < 0$ on $(a,b).$\n\nSo, to determine intervals of concavity of $f(x)$ by looking at the graph of $f'(x),$ we need to pay attention to where $f'(x)$ is increasing or decreasing.\n\n- If $f'(x)$ is increasing, then $f''(x)>0,$ which means $f(x)$ is concave up.\n\n![](images/8a/8ac780a2dfa4d6c32449b750ff236568764de920d38e363d1badf4c7324c9c94.png)\n\n- If $f'(x)$ is decreasing, then $f''(x)<0,$ which means $f(x)$ is concave down.\n\n![](images/2b/2bcc5e92916f582dc75450241c0223b55dab287d24e06b55e4d8fde56c7f927c.png)\n\nAlso, recall that $f(x)$ has an inflection point at $x=a$ if $f''(x)$ changes its sign around $x=a.$ So, to determine the inflection points of $f(x)$ by looking at a graph of $f'(x),$ we need to pay attention to where $f'(x)$ switches from increasing to decreasing (or vice versa). \n\nIn other words, we need to pay attention to relative extrema on the graph of $f'(x).$\n\n![](images/68/68a0a5523690eceb319bff14916528b6c1727d68e393373553bc42fbf6be6f16.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186176100 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186198435 :knowledge-point/questions ["question-f8fd8fac-7611-58e8-a16a-eb7f95407000"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f8fd8fac-7611-58e8-a16a-eb7f95407000" :question/id #uuid "f8fd8fac-7611-58e8-a16a-eb7f95407000" :question/math-academy-id "q-163132" :question/problem "For the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x,y)=\\operatorname{cos}⁡(3x-y),\n$$\n\nthe quadratic Taylor polynomial of $f$ about $a=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is given by\n\n$$\nf(x)≈∗+[\\begin{aligned}∗ & 0\\end{aligned}][\\begin{aligned}∗ \\\\ y\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}∗ \\\\ y\\end{aligned}]}^{T}[\\begin{aligned}∗ & 3 \\\\ ∗ & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nFind the sum of the six missing expressions." :question/worked-solution "Suppose that the function $f:{R}^{n}\\to R$ is defened by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶z\n$$\n\n \n\nand is twice differentiable at $x=a.$ Then, the quadratic Taylor polynomial of $f$ about $a$ is given by\n\n$$\n\\begin{aligned}f(x) & ≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a),\\end{aligned}\n$$\n\nwhere\n\n$$\n{f}^{′}(a)={[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]|}_{x=a}\n$$\n\nand\n\n$$\n{f}^{″}(a)={[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}]}_{x=a}\n$$\n\nIn this case, we have the following:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}], & \\,{f}^{″}(x) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the terms of our Taylor polynomial:\n\n- Calculating the value of the function, we have\n\n$$\n\\begin{aligned}f(0,0) & =1.\\end{aligned}\n$$\n\n- Calculating the first derivatives, we have the following:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =[\\begin{aligned}-3\\operatorname{sin}⁡(3x-y) & \\operatorname{sin}⁡(3x-y)\\end{aligned}] \\\\ {f}^{′}(0,0) & =[\\begin{aligned}0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n- Calculating the second derivative, we have the following:\n\n$$\n\\begin{aligned}{f}^{″}(x) & =[\\begin{aligned}-9\\operatorname{cos}⁡(3x-y) & 3\\operatorname{cos}⁡(3x-y) \\\\ 3\\operatorname{cos}⁡(3x-y) & -\\operatorname{cos}⁡(3x-y)\\end{aligned}] \\\\ {f}^{″}(0,0) & =[\\begin{aligned}-9 & 3 \\\\ 3 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈1+[\\begin{aligned}0 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}x \\\\ y\\end{aligned}]}^{T}[\\begin{aligned}-9 & 3 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nFinally, the sum of the missing expressions is\n\n$$\n1+0+x+x+(-9)+3=2x-5.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-70dfe391-1be5-5314-819b-7419c185891e"] :db/ensure [:question/validate]} {:db/id "answer-field-70dfe391-1be5-5314-819b-7419c185891e" :answer-field/id #uuid "70dfe391-1be5-5314-819b-7419c185891e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4a73e654-74cd-553c-bd37-5755a05e3bca" :answer-field/choices ["answer-45a5c347-378b-5252-8c5b-08cec2880c91" "answer-1f322457-25fd-5a66-86e8-083d4272a096" "answer-4a73e654-74cd-553c-bd37-5755a05e3bca" "answer-6f9a04e1-a076-5063-b000-58d0bd6211f0" "answer-a5683896-77cb-5f32-b1ff-4d08b73452cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-45a5c347-378b-5252-8c5b-08cec2880c91" :answer/id #uuid "45a5c347-378b-5252-8c5b-08cec2880c91" :answer/type :answer.type/math :answer/value "2x+2" :db/ensure [:answer/validate]} {:db/id "answer-1f322457-25fd-5a66-86e8-083d4272a096" :answer/id #uuid "1f322457-25fd-5a66-86e8-083d4272a096" :answer/type :answer.type/math :answer/value "2x+4" :db/ensure [:answer/validate]} {:db/id "answer-4a73e654-74cd-553c-bd37-5755a05e3bca" :answer/id #uuid "4a73e654-74cd-553c-bd37-5755a05e3bca" :answer/type :answer.type/math :answer/value "2x-5" :db/ensure [:answer/validate]} {:db/id "answer-6f9a04e1-a076-5063-b000-58d0bd6211f0" :answer/id #uuid "6f9a04e1-a076-5063-b000-58d0bd6211f0" :answer/type :answer.type/math :answer/value "3x+6" :db/ensure [:answer/validate]} {:db/id "answer-a5683896-77cb-5f32-b1ff-4d08b73452cb" :answer/id #uuid "a5683896-77cb-5f32-b1ff-4d08b73452cb" :answer/type :answer.type/math :answer/value "3x-8" :db/ensure [:answer/validate]} {:db/id "activity-73d6c53c-cf73-5107-b825-a50e663e7151" :activity/id #uuid "73d6c53c-cf73-5107-b825-a50e663e7151" :activity/title "Second-Degree Taylor Polynomials of Multivariable Functions" :activity/type :activity.type/review :activity/scope 17592186048786 :activity/course 17592186046658 :activity/steps ["step-4115843a-5f65-5106-84b6-76017adc7761" "step-7d2357c9-6ba0-5690-b808-3580c8ab9687" "step-61d3b2c9-87d8-5d72-b2fc-bc5dc51aac62" "step-02df79de-1a4d-5335-b5b6-f27a07496e01" "step-da8884f4-3bad-5c57-9954-af1f3e1ee6f0"] :activity/first-step "step-4115843a-5f65-5106-84b6-76017adc7761" :db/ensure [:activity/validate]} {:db/id "step-4115843a-5f65-5106-84b6-76017adc7761" :step/id #uuid "4115843a-5f65-5106-84b6-76017adc7761" :step/content 17592186281607 :step/next "step-7d2357c9-6ba0-5690-b808-3580c8ab9687" :db/ensure [:step/validate]} {:db/id "step-7d2357c9-6ba0-5690-b808-3580c8ab9687" :step/id #uuid "7d2357c9-6ba0-5690-b808-3580c8ab9687" :step/content "question-f8fd8fac-7611-58e8-a16a-eb7f95407000" :step/next "step-61d3b2c9-87d8-5d72-b2fc-bc5dc51aac62" :db/ensure [:step/validate]} {:db/id "step-61d3b2c9-87d8-5d72-b2fc-bc5dc51aac62" :step/id #uuid "61d3b2c9-87d8-5d72-b2fc-bc5dc51aac62" :step/content 17592186198678 :step/next "step-02df79de-1a4d-5335-b5b6-f27a07496e01" :db/ensure [:step/validate]} {:db/id "step-02df79de-1a4d-5335-b5b6-f27a07496e01" :step/id #uuid "02df79de-1a4d-5335-b5b6-f27a07496e01" :step/content 17592186284521 :step/next "step-da8884f4-3bad-5c57-9954-af1f3e1ee6f0" :db/ensure [:step/validate]} {:db/id "step-da8884f4-3bad-5c57-9954-af1f3e1ee6f0" :step/id #uuid "da8884f4-3bad-5c57-9954-af1f3e1ee6f0" :step/content 17592186367908 :db/ensure [:step/validate]} {:db/id 17592186083486 :question/problem "![](images/9c/9c092436e6f2f66cd2ade33818209f001d1481f962c086da09c284975af83795.png)\n\nGiven the above sample space, find $P({X}^{′}).$" :question/worked-solution "The Venn diagram tells us that $P(X)=\\frac{2}{5}.$ So, we have\n\n$$\n\\begin{aligned}P({X}^{′}) & =1-P(X) \\\\  & =1-\\frac{2}{5} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186079811 :answer-field/correct 17592186079812 :db/ensure [:answer-field/validate]} {:db/id 17592186083213 :knowledge-point/questions ["question-7764a147-f3f7-5293-8ab2-21a4f6d2919a" "question-8518694b-ea1e-5380-a35c-13f3072f6df4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7764a147-f3f7-5293-8ab2-21a4f6d2919a" :question/id #uuid "7764a147-f3f7-5293-8ab2-21a4f6d2919a" :question/math-academy-id "q-84435" :question/problem "![](images/a3/a347f23ec8c99fda74de190515eb7aa2d071be29ca106b99116b3d050cb8a1fe.png)\n\nGiven the above sample space, find $P(X).$" :question/worked-solution "The Venn diagram tells us that $P({X}^{′})=0.749.$ So, we have\n\n$$\n\\begin{aligned}P(X) & =1-P({X}^{′}) \\\\  & =1-0.749 \\\\  & =0.251.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dee1b406-0379-5d58-ba7e-b9ef815df898"] :db/ensure [:question/validate]} {:db/id "answer-field-dee1b406-0379-5d58-ba7e-b9ef815df898" :answer-field/id #uuid "dee1b406-0379-5d58-ba7e-b9ef815df898" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-618e6135-f56b-58e3-9328-1dabdd58e75e" :answer-field/choices ["answer-98e412be-1a3f-5243-b5d3-e6079198e12b" "answer-c03ce4f2-8551-5443-840b-a6936ad84d20" "answer-618e6135-f56b-58e3-9328-1dabdd58e75e" "answer-d82264de-339c-5e57-9840-e930e1482ddb" "answer-bc95322b-4d62-5251-8e5a-af2d36102789"] :db/ensure [:answer-field/validate]} {:db/id "answer-98e412be-1a3f-5243-b5d3-e6079198e12b" :answer/id #uuid "98e412be-1a3f-5243-b5d3-e6079198e12b" :answer/type :answer.type/math :answer/value "0.201" :db/ensure [:answer/validate]} {:db/id "answer-c03ce4f2-8551-5443-840b-a6936ad84d20" :answer/id #uuid "c03ce4f2-8551-5443-840b-a6936ad84d20" :answer/type :answer.type/math :answer/value "0.250" :db/ensure [:answer/validate]} {:db/id "answer-618e6135-f56b-58e3-9328-1dabdd58e75e" :answer/id #uuid "618e6135-f56b-58e3-9328-1dabdd58e75e" :answer/type :answer.type/math :answer/value "0.251" :db/ensure [:answer/validate]} {:db/id "answer-d82264de-339c-5e57-9840-e930e1482ddb" :answer/id #uuid "d82264de-339c-5e57-9840-e930e1482ddb" :answer/type :answer.type/math :answer/value "0.521" :db/ensure [:answer/validate]} {:db/id "answer-bc95322b-4d62-5251-8e5a-af2d36102789" :answer/id #uuid "bc95322b-4d62-5251-8e5a-af2d36102789" :answer/type :answer.type/math :answer/value "0.551" :db/ensure [:answer/validate]} {:db/id "question-8518694b-ea1e-5380-a35c-13f3072f6df4" :question/id #uuid "8518694b-ea1e-5380-a35c-13f3072f6df4" :question/math-academy-id "q-84440" :question/problem "![](images/52/5245725446c23cc37e5ca4ad5b4def939c1544100eb3488092f59c4ed0f8beaa.png)\n\nConsider the sample space $S$ with the Venn diagram given above. What is $P(A)?$" :question/worked-solution "From the given Venn diagram, we have $P(A)=y$ and $P({A}^{′})=\\frac{y}{22}.$\nTherefore\n\n$$\n\\begin{aligned}P(A)+P({A}^{′}) & =1 \\\\ y+\\frac{y}{22} & =1 \\\\ \\frac{23y}{22} & =1 \\\\ y & =\\frac{22}{23}.\\end{aligned}\n$$\n\nConsequently,  $P(A)=y=\\frac{22}{23}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8d3be114-0077-5092-b1f3-6cfed4a013eb"] :db/ensure [:question/validate]} {:db/id "answer-field-8d3be114-0077-5092-b1f3-6cfed4a013eb" :answer-field/id #uuid "8d3be114-0077-5092-b1f3-6cfed4a013eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a89f9d8f-ba4e-55a2-9762-c20470143c7a" :answer-field/choices ["answer-a2568178-6c14-5310-b06c-f6da6cadd369" "answer-cb0bbe30-3e25-5367-88f5-88e0431bffb0" "answer-64e91312-ff58-54f3-b439-a8ba0e101cf9" "answer-a89f9d8f-ba4e-55a2-9762-c20470143c7a" "answer-d990847b-1002-5b97-9e33-5b92b5b1594f"] :db/ensure [:answer-field/validate]} {:db/id "answer-a2568178-6c14-5310-b06c-f6da6cadd369" :answer/id #uuid "a2568178-6c14-5310-b06c-f6da6cadd369" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "answer-cb0bbe30-3e25-5367-88f5-88e0431bffb0" :answer/id #uuid "cb0bbe30-3e25-5367-88f5-88e0431bffb0" :answer/type :answer.type/math :answer/value "\\frac{1}{22}" :db/ensure [:answer/validate]} {:db/id "answer-64e91312-ff58-54f3-b439-a8ba0e101cf9" :answer/id #uuid "64e91312-ff58-54f3-b439-a8ba0e101cf9" :answer/type :answer.type/math :answer/value "\\frac{1}{23}" :db/ensure [:answer/validate]} {:db/id "answer-a89f9d8f-ba4e-55a2-9762-c20470143c7a" :answer/id #uuid "a89f9d8f-ba4e-55a2-9762-c20470143c7a" :answer/type :answer.type/math :answer/value "\\frac{22}{23}" :db/ensure [:answer/validate]} {:db/id "answer-d990847b-1002-5b97-9e33-5b92b5b1594f" :answer/id #uuid "d990847b-1002-5b97-9e33-5b92b5b1594f" :answer/type :answer.type/math :answer/value "\\frac{23}{22}" :db/ensure [:answer/validate]} {:db/id "activity-e2fcbe2f-4ff6-58b3-8208-814e82a85124" :activity/id #uuid "e2fcbe2f-4ff6-58b3-8208-814e82a85124" :activity/title "Venn Diagrams in Probability" :activity/type :activity.type/review :activity/scope 17592186048135 :activity/course 17592186046647 :activity/steps ["step-c6e45cc7-205e-57d1-80c2-e67d0fe17e04" "step-2c9093fe-c1c5-5ee0-9d9c-ed832e4df4f4" "step-20e5a0d7-e4a4-5527-9522-5eac4387dd43"] :activity/first-step "step-c6e45cc7-205e-57d1-80c2-e67d0fe17e04" :db/ensure [:activity/validate]} {:db/id "step-c6e45cc7-205e-57d1-80c2-e67d0fe17e04" :step/id #uuid "c6e45cc7-205e-57d1-80c2-e67d0fe17e04" :step/content 17592186083486 :step/next "step-2c9093fe-c1c5-5ee0-9d9c-ed832e4df4f4" :db/ensure [:step/validate]} {:db/id "step-2c9093fe-c1c5-5ee0-9d9c-ed832e4df4f4" :step/id #uuid "2c9093fe-c1c5-5ee0-9d9c-ed832e4df4f4" :step/content "question-7764a147-f3f7-5293-8ab2-21a4f6d2919a" :step/next "step-20e5a0d7-e4a4-5527-9522-5eac4387dd43" :db/ensure [:step/validate]} {:db/id "step-20e5a0d7-e4a4-5527-9522-5eac4387dd43" :step/id #uuid "20e5a0d7-e4a4-5527-9522-5eac4387dd43" :step/content "question-8518694b-ea1e-5380-a35c-13f3072f6df4" :db/ensure [:step/validate]} {:db/id 17592186106039 :question/problem "Let $c=[\\begin{aligned}8 \\\\ -2 \\\\ -1\\end{aligned}]$ and $d=[\\begin{aligned}3 \\\\ -1 \\\\ -2\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{8\\cdot 3+(-2)\\cdot (-1)+(-1)\\cdot (-2)}{{3}^{2}+(-1)^{2}+(-2)^{2}}d \\\\  & =\\frac{28}{14}⟨3,-1,-2⟩ \\\\  & =2⟨3,-1,-2⟩ \\\\  & =⟨6,-2,-4⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186102120 :answer-field/correct 17592186102121 :db/ensure [:answer-field/validate]} {:db/id 17592186105703 :knowledge-point/questions ["question-3e9794d9-d867-58d6-b0bf-dba6e4bdc40f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3e9794d9-d867-58d6-b0bf-dba6e4bdc40f" :question/id #uuid "3e9794d9-d867-58d6-b0bf-dba6e4bdc40f" :question/math-academy-id "q-212468" :question/problem "Let $a=[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 2 \\\\ -1\\end{aligned}].$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =2\\cdot x+1\\cdot 2+(-2)\\cdot (-1) \\\\  & =2x+4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2x+4 & =0 \\\\ 2x & =-4 \\\\ x & =-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4525fe90-b193-5b48-b3bb-abdfaeefdf59"] :db/ensure [:question/validate]} {:db/id "answer-field-4525fe90-b193-5b48-b3bb-abdfaeefdf59" :answer-field/id #uuid "4525fe90-b193-5b48-b3bb-abdfaeefdf59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5354d7be-d996-5b5d-9ca6-24a10a4fbd73" :answer-field/choices ["answer-5354d7be-d996-5b5d-9ca6-24a10a4fbd73" "answer-f42861f6-846f-5a1a-8226-366618cfad81" "answer-aed3df03-2c3b-5c10-a310-ac9a1632c9c6" "answer-4a2a25d0-fade-5da7-98d3-71d579549d21" "answer-53138d0d-94ec-533d-b5de-57a8e1562435"] :db/ensure [:answer-field/validate]} {:db/id "answer-5354d7be-d996-5b5d-9ca6-24a10a4fbd73" :answer/id #uuid "5354d7be-d996-5b5d-9ca6-24a10a4fbd73" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-f42861f6-846f-5a1a-8226-366618cfad81" :answer/id #uuid "f42861f6-846f-5a1a-8226-366618cfad81" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-aed3df03-2c3b-5c10-a310-ac9a1632c9c6" :answer/id #uuid "aed3df03-2c3b-5c10-a310-ac9a1632c9c6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4a2a25d0-fade-5da7-98d3-71d579549d21" :answer/id #uuid "4a2a25d0-fade-5da7-98d3-71d579549d21" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-53138d0d-94ec-533d-b5de-57a8e1562435" :answer/id #uuid "53138d0d-94ec-533d-b5de-57a8e1562435" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "activity-134b7c36-e3d4-5ff3-967c-1af7c2f8479d" :activity/id #uuid "134b7c36-e3d4-5ff3-967c-1af7c2f8479d" :activity/title "Calculating a Vector Projection" :activity/type :activity.type/review :activity/scope 17592186050394 :activity/course 17592186046658 :activity/steps ["step-e3d8663d-8e07-5d28-a2bb-2551ee604b3e" "step-7fdea43e-2ef3-540c-8eb6-285efc757bcc" "step-3c4ec6fe-fb11-5a18-8ebf-e8780276a7b7" "step-c6467b08-7b58-5ad5-af76-05af741961e6" "step-9d3d55fd-f06c-5f15-ae5b-beb6a1f0e922"] :activity/first-step "step-e3d8663d-8e07-5d28-a2bb-2551ee604b3e" :db/ensure [:activity/validate]} {:db/id "step-e3d8663d-8e07-5d28-a2bb-2551ee604b3e" :step/id #uuid "e3d8663d-8e07-5d28-a2bb-2551ee604b3e" :step/content 17592186441587 :step/next "step-7fdea43e-2ef3-540c-8eb6-285efc757bcc" :db/ensure [:step/validate]} {:db/id "step-7fdea43e-2ef3-540c-8eb6-285efc757bcc" :step/id #uuid "7fdea43e-2ef3-540c-8eb6-285efc757bcc" :step/content 17592186106039 :step/next "step-3c4ec6fe-fb11-5a18-8ebf-e8780276a7b7" :db/ensure [:step/validate]} {:db/id "step-3c4ec6fe-fb11-5a18-8ebf-e8780276a7b7" :step/id #uuid "3c4ec6fe-fb11-5a18-8ebf-e8780276a7b7" :step/content "question-3e9794d9-d867-58d6-b0bf-dba6e4bdc40f" :step/next "step-c6467b08-7b58-5ad5-af76-05af741961e6" :db/ensure [:step/validate]} {:db/id "step-c6467b08-7b58-5ad5-af76-05af741961e6" :step/id #uuid "c6467b08-7b58-5ad5-af76-05af741961e6" :step/content 17592186292823 :step/next "step-9d3d55fd-f06c-5f15-ae5b-beb6a1f0e922" :db/ensure [:step/validate]} {:db/id "step-9d3d55fd-f06c-5f15-ae5b-beb6a1f0e922" :step/id #uuid "9d3d55fd-f06c-5f15-ae5b-beb6a1f0e922" :step/content 17592186297546 :db/ensure [:step/validate]} {:db/id 17592186231418 :knowledge-point/questions ["question-a160ea33-0abc-551b-81fb-aa9297d75028" "question-07505f7b-3ca5-545d-9207-d1e1cfa4ebbe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a160ea33-0abc-551b-81fb-aa9297d75028" :question/id #uuid "a160ea33-0abc-551b-81fb-aa9297d75028" :question/math-academy-id "q-343758" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}-5y=f(x),\\,y(0)=-2\n$$\n\nwhere $f(x)$ is a $4$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(0)=0.$*\n\nThe solution is \n\n$y(x)∼$  \n{{field-1}} \n$+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{\\pi n}{2}x)+{b}_{n}sin\\,(\\frac{\\pi n}{2}x))$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}-5y=0$ is \n\n$$\n{y}_{c}=A{e}^{5x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}-5y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{5x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{\\pi n}{2}x)+{b}_{n}sin\\,(\\frac{\\pi n}{2}x))\n$$\n\nNow, we apply the initial condition $y(0)=-2.$ Using the hint that the particular solution part evaluates to zero at $x=0,$ we have\n\n$$\n\\begin{aligned}y(0) & =A{e}^{5(0)}+{y}_{p}(0) \\\\ -2 & =A(1)+0 \\\\ A & =-2.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=-2{e}^{5x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-2{e}^{5x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{\\pi n}{2}x)+{b}_{n}sin\\,(\\frac{\\pi n}{2}x)).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9688ef1e-aa0f-557f-92e7-8f181132182a"] :db/ensure [:question/validate]} {:db/id "answer-field-9688ef1e-aa0f-557f-92e7-8f181132182a" :answer-field/id #uuid "9688ef1e-aa0f-557f-92e7-8f181132182a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4ccc9c21-c3ce-5f4a-ba59-583860541dee" :answer-field/choices ["answer-4ccc9c21-c3ce-5f4a-ba59-583860541dee"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ccc9c21-c3ce-5f4a-ba59-583860541dee" :answer/id #uuid "4ccc9c21-c3ce-5f4a-ba59-583860541dee" :answer/type :answer.type/math :answer/value "-2e^{5x}" :db/ensure [:answer/validate]} {:db/id "question-07505f7b-3ca5-545d-9207-d1e1cfa4ebbe" :question/id #uuid "07505f7b-3ca5-545d-9207-d1e1cfa4ebbe" :question/math-academy-id "q-343946" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(1)=-3\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(1)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))\n$$\n\nNow, we apply the initial condition $y(1)=-3.$ Using the hint that the particular solution part evaluates to zero at $x=1,$ we have\n\n$$\n\\begin{aligned}y(1) & =A{e}^{-4(1)}+{y}_{p}(1) \\\\ -3 & =A{e}^{-4}+0 \\\\ A & =-3{e}^{4}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(-3{e}^{4}){e}^{-4x}=-3{e}^{4-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼-3{e}^{4-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x)).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-600c0667-9438-5a96-b5a3-42ddde81d0e1"] :db/ensure [:question/validate]} {:db/id "answer-field-600c0667-9438-5a96-b5a3-42ddde81d0e1" :answer-field/id #uuid "600c0667-9438-5a96-b5a3-42ddde81d0e1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-69b3c7ed-0ad2-5549-acf8-acdbd9e0e4ea" :answer-field/choices ["answer-69b3c7ed-0ad2-5549-acf8-acdbd9e0e4ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-69b3c7ed-0ad2-5549-acf8-acdbd9e0e4ea" :answer/id #uuid "69b3c7ed-0ad2-5549-acf8-acdbd9e0e4ea" :answer/type :answer.type/math :answer/value "-3e^{-4(x-1)}" :db/ensure [:answer/validate]} {:db/id 17592186231419 :knowledge-point/questions ["question-465baa29-a84f-575d-bfbc-3ca094c0808a" "question-c1ec13b9-1623-5452-ac2a-c54844694d83" "question-6e09043a-2656-5006-b96f-e232ecdf95b0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-465baa29-a84f-575d-bfbc-3ca094c0808a" :question/id #uuid "465baa29-a84f-575d-bfbc-3ca094c0808a" :question/math-academy-id "q-343950" :question/problem "$$\n{y}^{″}+2y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=3\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $2\\pi $-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx)\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+2=0$ gives roots $\\lambda =\\pm \\sqrt{2}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x)+B\\operatorname{sin}⁡(\\sqrt{2}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=3.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}x)+{\\sum }_{n=1}^{\\infty }n{b}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nApplying ${y}^{′}(0)=3$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}3 & =B\\sqrt{2}+{\\sum }_{n=1}^{\\infty }n{b}_{n} \\\\ B\\sqrt{2} & =3-{\\sum }_{n=1}^{\\infty }n{b}_{n} \\\\ B & =\\frac{3}{\\sqrt{2}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{2}}.\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{2}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{sin}⁡(\\sqrt{2}x)(\\frac{3}{\\sqrt{2}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{2}})+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx)\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3b3e1afe-7ade-5f8c-9104-fa8e0533e940"] :db/ensure [:question/validate]} {:db/id "answer-field-3b3e1afe-7ade-5f8c-9104-fa8e0533e940" :answer-field/id #uuid "3b3e1afe-7ade-5f8c-9104-fa8e0533e940" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-0d9a685b-e7bf-53bd-99ed-2a928b6f1ba2" :answer-field/choices ["answer-532771d5-519d-50af-94e8-f4b6987d74f4" "answer-0a99c937-0618-51b0-9ee8-a05c39b743bf" "answer-7c6ebad4-4e5c-5893-89b1-194838c5792a" "answer-0d9a685b-e7bf-53bd-99ed-2a928b6f1ba2"] :db/ensure [:answer-field/validate]} {:db/id "answer-532771d5-519d-50af-94e8-f4b6987d74f4" :answer/id #uuid "532771d5-519d-50af-94e8-f4b6987d74f4" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)(\\frac{3}{\\sqrt{2}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{2}})" :db/ensure [:answer/validate]} {:db/id "answer-0a99c937-0618-51b0-9ee8-a05c39b743bf" :answer/id #uuid "0a99c937-0618-51b0-9ee8-a05c39b743bf" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{2}x)(3-{\\sum }_{n=1}^{\\infty }n{b}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-7c6ebad4-4e5c-5893-89b1-194838c5792a" :answer/id #uuid "7c6ebad4-4e5c-5893-89b1-194838c5792a" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{2}x)(\\frac{3}{\\sqrt{2}}+{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{2}})" :db/ensure [:answer/validate]} {:db/id "answer-0d9a685b-e7bf-53bd-99ed-2a928b6f1ba2" :answer/id #uuid "0d9a685b-e7bf-53bd-99ed-2a928b6f1ba2" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{2}x)(\\frac{3}{\\sqrt{2}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{2}})" :db/ensure [:answer/validate]} {:db/id "question-c1ec13b9-1623-5452-ac2a-c54844694d83" :question/id #uuid "c1ec13b9-1623-5452-ac2a-c54844694d83" :question/math-academy-id "q-344034" :question/problem "$$\n{y}^{″}+5y=f(x),\\,y(0)=3,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an even, $3$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{2\\pi n}{3}x)\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an even function and the differential operator contains no ${y}^{′}$ (damping) term, the particular solution inherits the symmetry and is also an even function consisting only of cosine terms. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{2\\pi n}{3}x).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+5=0$ gives roots $\\lambda =\\pm \\sqrt{5}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{5}x)+B\\operatorname{sin}⁡(\\sqrt{5}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\n{y}^{′}(x)∼-A\\sqrt{5}\\operatorname{sin}⁡(\\sqrt{5}x)+B\\sqrt{5}\\operatorname{cos}⁡(\\sqrt{5}x)-{\\sum }_{n=1}^{\\infty }\\frac{2\\pi n}{3}{a}_{n}sin\\,(\\frac{2\\pi n}{3}x).\n$$\n\nUsing the derivative condition ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{5}\\operatorname{sin}⁡(0)+B\\sqrt{5}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }\\frac{2\\pi n}{3}{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{5}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we use the condition $y(0)=3.$ With $B=0,$ the total solution is\n\n$$\ny(x)∼A\\operatorname{cos}⁡(\\sqrt{5}x)+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{2\\pi n}{3}x).\n$$\n\nApplying $y(0)=3$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}3 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =3-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nSubstituting $A$ back into ${y}_{c}=A\\operatorname{cos}⁡(\\sqrt{5}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{cos}⁡(\\sqrt{5}x)(3-{\\sum }_{n=0}^{\\infty }{a}_{n})+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{2\\pi n}{3}x)\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8e8e4fce-3b23-5eb0-9715-6b625c2b4dc5"] :db/ensure [:question/validate]} {:db/id "answer-field-8e8e4fce-3b23-5eb0-9715-6b625c2b4dc5" :answer-field/id #uuid "8e8e4fce-3b23-5eb0-9715-6b625c2b4dc5" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-96e14832-25ec-5cc2-9b80-eef2d0a5f2d7" :answer-field/choices ["answer-9a8746fb-2ea4-58ca-a484-de8db975ddb3" "answer-96e14832-25ec-5cc2-9b80-eef2d0a5f2d7" "answer-be7962f1-2c0b-553d-affa-31d3acba17bc" "answer-f9874a00-5d86-506a-b77b-4b0ce2fc6efe"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a8746fb-2ea4-58ca-a484-de8db975ddb3" :answer/id #uuid "9a8746fb-2ea4-58ca-a484-de8db975ddb3" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{5}x)(3+{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-96e14832-25ec-5cc2-9b80-eef2d0a5f2d7" :answer/id #uuid "96e14832-25ec-5cc2-9b80-eef2d0a5f2d7" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{5}x)(3-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-be7962f1-2c0b-553d-affa-31d3acba17bc" :answer/id #uuid "be7962f1-2c0b-553d-affa-31d3acba17bc" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{5}x)({\\sum }_{n=0}^{\\infty }{a}_{n}-3)" :db/ensure [:answer/validate]} {:db/id "answer-f9874a00-5d86-506a-b77b-4b0ce2fc6efe" :answer/id #uuid "f9874a00-5d86-506a-b77b-4b0ce2fc6efe" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{5}x)(3-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "question-6e09043a-2656-5006-b96f-e232ecdf95b0" :question/id #uuid "6e09043a-2656-5006-b96f-e232ecdf95b0" :question/math-academy-id "q-344045" :question/problem "$$\n{y}^{″}+5{\\pi }^{2}y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }\\,\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{3}(20-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{3}(20-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+5{\\pi }^{2}=0$ gives roots $\\lambda =\\pm \\sqrt{5}\\pi \\,\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{5}\\pi x)+B\\operatorname{sin}⁡(\\sqrt{5}\\pi x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=0.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{5}\\pi \\operatorname{cos}⁡(\\sqrt{5}\\pi x)+{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\n$$\n\nApplying ${y}^{′}(0)=0$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}0 & =B\\sqrt{5}\\pi +{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})} \\\\ B\\sqrt{5}\\pi  & =-{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})} \\\\ B & =-\\frac{1}{\\sqrt{5}\\pi }{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})} \\\\  & =-{\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n\\sqrt{5}{\\pi }^{3}(20-{n}^{2})} \\\\  & =-{\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}.\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{5}\\pi x)$, we find the missing part:\n\n$$\ny(x)∼-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}+{\\sum }_{n=1}^{\\infty }\\,\\frac{20(-1)^{n}}{{n}^{2}{\\pi }^{3}(20-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ca20e363-d96f-5c7c-870a-e0d6761fc82a"] :db/ensure [:question/validate]} {:db/id "answer-field-ca20e363-d96f-5c7c-870a-e0d6761fc82a" :answer-field/id #uuid "ca20e363-d96f-5c7c-870a-e0d6761fc82a" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-987d4650-fafb-51a4-b9a2-850870587748" :answer-field/choices ["answer-987d4650-fafb-51a4-b9a2-850870587748" "answer-2e579e2a-cf55-5dc2-9631-36dd85e6533e" "answer-69bd26b6-6e3c-5c38-a3bc-9ab6d641cd52" "answer-b57bb91e-bc6a-52e3-9e91-2b526a2371b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-987d4650-fafb-51a4-b9a2-850870587748" :answer/id #uuid "987d4650-fafb-51a4-b9a2-850870587748" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}(-1)^{n}}{n{\\pi }^{3}(20-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "answer-2e579e2a-cf55-5dc2-9631-36dd85e6533e" :answer/id #uuid "2e579e2a-cf55-5dc2-9631-36dd85e6533e" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{5}}{n{\\pi }^{3}(20-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "answer-69bd26b6-6e3c-5c38-a3bc-9ab6d641cd52" :answer/id #uuid "69bd26b6-6e3c-5c38-a3bc-9ab6d641cd52" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{10(-1)^{n}}{n{\\pi }^{2}(20-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "answer-b57bb91e-bc6a-52e3-9e91-2b526a2371b1" :answer/id #uuid "b57bb91e-bc6a-52e3-9e91-2b526a2371b1" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{5}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{20}{n{\\pi }^{2}(20-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "activity-d6257b83-ba04-500d-a732-6cba09c74c43" :activity/id #uuid "d6257b83-ba04-500d-a732-6cba09c74c43" :activity/title "Solving IVPs Using Fourier Series" :activity/type :activity.type/review :activity/scope 17592186049479 :activity/course 17592186046644 :activity/steps ["step-515e9c6d-b678-5d79-bcd7-3b888453f523" "step-3214bc2f-1faf-54eb-adf1-7d3eb074c726" "step-9efa598a-3ff9-5f3e-ac3f-7a8b4ea4f3f9" "step-440bf108-473d-537f-bb47-60b7f6685da1" "step-600c0d6e-c648-5b58-bf0e-a4cd3e20ffb9"] :activity/first-step "step-515e9c6d-b678-5d79-bcd7-3b888453f523" :db/ensure [:activity/validate]} {:db/id "step-515e9c6d-b678-5d79-bcd7-3b888453f523" :step/id #uuid "515e9c6d-b678-5d79-bcd7-3b888453f523" :step/content "question-a160ea33-0abc-551b-81fb-aa9297d75028" :step/next "step-3214bc2f-1faf-54eb-adf1-7d3eb074c726" :db/ensure [:step/validate]} {:db/id "step-3214bc2f-1faf-54eb-adf1-7d3eb074c726" :step/id #uuid "3214bc2f-1faf-54eb-adf1-7d3eb074c726" :step/content "question-07505f7b-3ca5-545d-9207-d1e1cfa4ebbe" :step/next "step-9efa598a-3ff9-5f3e-ac3f-7a8b4ea4f3f9" :db/ensure [:step/validate]} {:db/id "step-9efa598a-3ff9-5f3e-ac3f-7a8b4ea4f3f9" :step/id #uuid "9efa598a-3ff9-5f3e-ac3f-7a8b4ea4f3f9" :step/content "question-465baa29-a84f-575d-bfbc-3ca094c0808a" :step/next "step-440bf108-473d-537f-bb47-60b7f6685da1" :db/ensure [:step/validate]} {:db/id "step-440bf108-473d-537f-bb47-60b7f6685da1" :step/id #uuid "440bf108-473d-537f-bb47-60b7f6685da1" :step/content "question-c1ec13b9-1623-5452-ac2a-c54844694d83" :step/next "step-600c0d6e-c648-5b58-bf0e-a4cd3e20ffb9" :db/ensure [:step/validate]} {:db/id "step-600c0d6e-c648-5b58-bf0e-a4cd3e20ffb9" :step/id #uuid "600c0d6e-c648-5b58-bf0e-a4cd3e20ffb9" :step/content "question-6e09043a-2656-5006-b96f-e232ecdf95b0" :db/ensure [:step/validate]} {:db/id 17592186179649 :knowledge-point/questions ["question-1f6be087-1fa7-52c8-8b37-3dc253f9f151"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1f6be087-1fa7-52c8-8b37-3dc253f9f151" :question/id #uuid "1f6be087-1fa7-52c8-8b37-3dc253f9f151" :question/math-academy-id "q-70298" :question/problem "If $\\frac{2y}{6y+1}+Z=\\frac{x+1}{3x},$ then what is $Z?$" :question/worked-solution "Since $\\frac{2y}{6y+1}+Z=\\frac{x+1}{3x},$ we have\n\n$$\n\\begin{aligned}Z & =\\frac{x+1}{3x}-\\frac{2y}{6y+1}.\\end{aligned}\n$$\n\nNow, we need to put the fractions over a common denominator of $3x(6y+1),$ since there are no common factors in either denominator that we can exploit. \n\nTo do this, we multiply the top and bottom of the first fraction by $6y+1,$ and the top and bottom of the second fraction by $3x:$ \n\n$$\n\\begin{aligned}Z & =\\frac{x+1}{3x}-\\frac{2y}{6y+1} \\\\  & =\\frac{6y+1}{6y+1}\\cdot \\frac{x+1}{3x}-\\frac{3x}{3x}\\cdot \\frac{2y}{6y+1} \\\\  & =\\frac{(6y+1)(x+1)}{3x(6y+1)}-\\frac{3x(2y)}{3x(6y+1)} \\\\  & =\\frac{(6y+1)(x+1)-3x(2y)}{3x(6y+1)} \\\\  & =\\frac{6yx+x+6y+1-6xy}{3x(6y+1)} \\\\  & =\\frac{x+6y+1}{3x(6y+1)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-76acf816-9d43-55de-b720-1823543ac3f0"] :db/ensure [:question/validate]} {:db/id "answer-field-76acf816-9d43-55de-b720-1823543ac3f0" :answer-field/id #uuid "76acf816-9d43-55de-b720-1823543ac3f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b6e44f64-471c-5144-a4df-c008428924d8" :answer-field/choices ["answer-c641f253-108d-57d7-b92a-300f6c43cac3" "answer-c128981f-be94-519f-99fe-617a7e7058aa" "answer-b6e44f64-471c-5144-a4df-c008428924d8" "answer-8739ac13-98e3-58b6-bd8d-3dcf3862c9ab" "answer-23cffcff-4a22-5e78-8990-abb8fe32d5d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-c641f253-108d-57d7-b92a-300f6c43cac3" :answer/id #uuid "c641f253-108d-57d7-b92a-300f6c43cac3" :answer/type :answer.type/math :answer/value "\\frac{3xy+6y+2}{3x+6y+1}" :db/ensure [:answer/validate]} {:db/id "answer-c128981f-be94-519f-99fe-617a7e7058aa" :answer/id #uuid "c128981f-be94-519f-99fe-617a7e7058aa" :answer/type :answer.type/math :answer/value "\\frac{6xy+x+6y+1}{3x(6y+1)}" :db/ensure [:answer/validate]} {:db/id "answer-b6e44f64-471c-5144-a4df-c008428924d8" :answer/id #uuid "b6e44f64-471c-5144-a4df-c008428924d8" :answer/type :answer.type/math :answer/value "\\frac{x+6y+1}{3x(6y+1)}" :db/ensure [:answer/validate]} {:db/id "answer-8739ac13-98e3-58b6-bd8d-3dcf3862c9ab" :answer/id #uuid "8739ac13-98e3-58b6-bd8d-3dcf3862c9ab" :answer/type :answer.type/math :answer/value "\\frac{x-y-1}{3x(6y+1)}" :db/ensure [:answer/validate]} {:db/id "answer-23cffcff-4a22-5e78-8990-abb8fe32d5d7" :answer/id #uuid "23cffcff-4a22-5e78-8990-abb8fe32d5d7" :answer/type :answer.type/math :answer/value "\\frac{xy+12y-4x+1}{3x(6y+1)}" :db/ensure [:answer/validate]} {:db/id "activity-6fdef0bc-21c9-5e03-80e4-df685b2f8a55" :activity/id #uuid "6fdef0bc-21c9-5e03-80e4-df685b2f8a55" :activity/title "Adding Rational Expressions With No Common Factors in the Denominator" :activity/type :activity.type/review :activity/scope 17592186050310 :activity/course 17592186046647 :activity/steps ["step-96219574-7431-50c0-baf3-3503c3ab2b03" "step-9fadf4e2-4826-56c6-8d16-4e2b4f03bec4" "step-805d3373-2bfa-59ad-b9de-b827b3792b78"] :activity/first-step "step-96219574-7431-50c0-baf3-3503c3ab2b03" :db/ensure [:activity/validate]} {:db/id "step-96219574-7431-50c0-baf3-3503c3ab2b03" :step/id #uuid "96219574-7431-50c0-baf3-3503c3ab2b03" :step/content 17592186180183 :step/next "step-9fadf4e2-4826-56c6-8d16-4e2b4f03bec4" :db/ensure [:step/validate]} {:db/id "step-9fadf4e2-4826-56c6-8d16-4e2b4f03bec4" :step/id #uuid "9fadf4e2-4826-56c6-8d16-4e2b4f03bec4" :step/content "question-1f6be087-1fa7-52c8-8b37-3dc253f9f151" :step/next "step-805d3373-2bfa-59ad-b9de-b827b3792b78" :db/ensure [:step/validate]} {:db/id "step-805d3373-2bfa-59ad-b9de-b827b3792b78" :step/id #uuid "805d3373-2bfa-59ad-b9de-b827b3792b78" :step/content 17592186338784 :db/ensure [:step/validate]} {:db/id 17592186054638 :knowledge-point/questions ["question-0186524d-998b-54c6-a0f5-fa7d2edb8c89"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0186524d-998b-54c6-a0f5-fa7d2edb8c89" :question/id #uuid "0186524d-998b-54c6-a0f5-fa7d2edb8c89" :question/math-academy-id "q-105146" :question/problem "If $A=\\{1,8,\\{8,9\\},5,4,\\{2,7\\}\\}$, then $|P(A)|=$" :question/worked-solution "For any set $A,$ we have $|P(A)|={2}^{|A|}.$ \n\nIn this case, $|A|=6,$ so we have\n\n$$\n|P(A)|={2}^{|A|}={2}^{6}=64.\n$$\n\nRemember that $\\{8,9\\}$ is a single element in the set $A,$ and the same is true for $\\{2,7\\}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a26ebfcb-41a7-5e48-bdd5-7e3c756aa992"] :db/ensure [:question/validate]} {:db/id "answer-field-a26ebfcb-41a7-5e48-bdd5-7e3c7