e-fe48-5c6f-985b-70ceb6762c4e" "step-ebc42d35-f4dd-5905-852b-c5cb495a2b71"] :activity/first-step "step-a4c2be1d-d683-59b4-aa78-adac0b909f27" :db/ensure [:activity/validate]} {:db/id "step-a4c2be1d-d683-59b4-aa78-adac0b909f27" :step/id #uuid "a4c2be1d-d683-59b4-aa78-adac0b909f27" :step/content 17592186373257 :step/next "step-0f236f0b-57a6-5471-a446-6ce42cac2342" :db/ensure [:step/validate]} {:db/id "step-0f236f0b-57a6-5471-a446-6ce42cac2342" :step/id #uuid "0f236f0b-57a6-5471-a446-6ce42cac2342" :step/content "question-0186524d-998b-54c6-a0f5-fa7d2edb8c89" :step/next "step-a5910cbe-18d6-5500-b155-fa1070c1e5b1" :db/ensure [:step/validate]} {:db/id "step-a5910cbe-18d6-5500-b155-fa1070c1e5b1" :step/id #uuid "a5910cbe-18d6-5500-b155-fa1070c1e5b1" :step/content 17592186379127 :step/next "step-50dc482e-fe48-5c6f-985b-70ceb6762c4e" :db/ensure [:step/validate]} {:db/id "step-50dc482e-fe48-5c6f-985b-70ceb6762c4e" :step/id #uuid "50dc482e-fe48-5c6f-985b-70ceb6762c4e" :step/content 17592186383680 :step/next "step-ebc42d35-f4dd-5905-852b-c5cb495a2b71" :db/ensure [:step/validate]} {:db/id "step-ebc42d35-f4dd-5905-852b-c5cb495a2b71" :step/id #uuid "ebc42d35-f4dd-5905-852b-c5cb495a2b71" :step/content 17592186379134 :db/ensure [:step/validate]} [:db/retract 17592186338348 :answer-field/choices 17592186336769] [:db/retract 17592186338348 :answer-field/choices 17592186337303] [:db/retract 17592186338348 :answer-field/choices 17592186337192] [:db/retract 17592186338348 :answer-field/choices 17592186337881] [:db/retract 17592186338348 :answer-field/choices 17592186337210] [:db/retract 17592186408094 :answer-field/choices 17592186408085] [:db/retract 17592186408094 :answer-field/choices 17592186408086] [:db/retract 17592186408094 :answer-field/choices 17592186408088] [:db/retract 17592186408094 :answer-field/choices 17592186408091] {:db/id 17592186124555 :knowledge-point/questions ["question-30e8d5c3-bff2-59db-90d6-3878e212499e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186339004 :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & =\\frac{(z-1)^{2}}{5} \\\\ (z-1)^{2} & =5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1) \\\\ (z-1) & =\\pm \\sqrt{5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1)}\\end{aligned}\n$$\n\n  \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186338348 :answer-field/correct "answer-844c12cc-6c29-5811-8962-30dc8d6a532a" :answer-field/choices ["answer-bea4c84f-b068-5e60-82b9-448a2bf9137c" "answer-844c12cc-6c29-5811-8962-30dc8d6a532a" "answer-f56fd478-739e-5168-a707-21a2be18cb60" "answer-2e168002-1ed1-57b4-8e6b-f6204db8e27b" "answer-27163c60-302f-5873-ad00-05f9fc6cf2b2"] :db/ensure [:answer-field/validate]} {:db/id "answer-bea4c84f-b068-5e60-82b9-448a2bf9137c" :answer/id #uuid "bea4c84f-b068-5e60-82b9-448a2bf9137c" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-844c12cc-6c29-5811-8962-30dc8d6a532a" :answer/id #uuid "844c12cc-6c29-5811-8962-30dc8d6a532a" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-f56fd478-739e-5168-a707-21a2be18cb60" :answer/id #uuid "f56fd478-739e-5168-a707-21a2be18cb60" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-2e168002-1ed1-57b4-8e6b-f6204db8e27b" :answer/id #uuid "2e168002-1ed1-57b4-8e6b-f6204db8e27b" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}<0\\}" :db/ensure [:answer/validate]} {:db/id "answer-27163c60-302f-5873-ad00-05f9fc6cf2b2" :answer/id #uuid "27163c60-302f-5873-ad00-05f9fc6cf2b2" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}>0\\}" :db/ensure [:answer/validate]} {:db/id "question-30e8d5c3-bff2-59db-90d6-3878e212499e" :question/id #uuid "30e8d5c3-bff2-59db-90d6-3878e212499e" :question/math-academy-id "q-71962" :question/problem "The projection of the intersection between the hyperboloid of two sheets $\\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16}+\\frac{(z-3)^{2}}{4}=-1$ and the plane $z=2$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=2$, we substitute $z=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16}+\\frac{(2-3)^{2}}{4} & =-1 \\\\ \\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16}+\\frac{1}{4} & =-1 \\\\ \\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16} & =-1-\\frac{1}{4} \\\\ \\frac{5(x-1)^{2}}{4}-\\frac{5(y-2)^{2}}{16} & =-\\frac{5}{4} \\\\ -(x-1)^{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ -\\frac{(x-1)^{2}}{{1}^{2}}+\\frac{(y-2)^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $1$ and $2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0955de35-ea37-5ad6-adbf-c21830b3db59"] :db/ensure [:question/validate]} {:db/id "answer-field-0955de35-ea37-5ad6-adbf-c21830b3db59" :answer-field/id #uuid "0955de35-ea37-5ad6-adbf-c21830b3db59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9b2cfb5a-966e-5a34-9f6a-912523db2991" :answer-field/choices ["answer-9b2cfb5a-966e-5a34-9f6a-912523db2991" "answer-ce7489bd-6451-5b1e-97b4-a9223f471ec3" "answer-b228c86f-d810-5b29-9d46-f26a62956d15" "answer-0cdbf0ca-75db-5f90-8955-64242b699cd1" "answer-2d6b1552-a10c-5a67-a222-9a99ec23f185"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b2cfb5a-966e-5a34-9f6a-912523db2991" :answer/id #uuid "9b2cfb5a-966e-5a34-9f6a-912523db2991" :answer/type :answer.type/text :answer/value "$1$ and $2$" :db/ensure [:answer/validate]} {:db/id "answer-ce7489bd-6451-5b1e-97b4-a9223f471ec3" :answer/id #uuid "ce7489bd-6451-5b1e-97b4-a9223f471ec3" :answer/type :answer.type/text :answer/value "$1$ and $2\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "answer-b228c86f-d810-5b29-9d46-f26a62956d15" :answer/id #uuid "b228c86f-d810-5b29-9d46-f26a62956d15" :answer/type :answer.type/text :answer/value "$1$ and $\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "answer-0cdbf0ca-75db-5f90-8955-64242b699cd1" :answer/id #uuid "0cdbf0ca-75db-5f90-8955-64242b699cd1" :answer/type :answer.type/text :answer/value "$2$ and $4$" :db/ensure [:answer/validate]} {:db/id "answer-2d6b1552-a10c-5a67-a222-9a99ec23f185" :answer/id #uuid "2d6b1552-a10c-5a67-a222-9a99ec23f185" :answer/type :answer.type/text :answer/value "$2$ and $5$" :db/ensure [:answer/validate]} {:db/id 17592186408095 :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-\\frac{{z}^{2}}{16} & =1 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & =\\frac{{z}^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =16(\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1) \\\\ z & =\\pm 4\\sqrt{\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+(y-1)^{2}-1 & \\ge 0 \\\\ \\frac{(x-2)^{2}}{4}+(y-1)^{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x-2)^{2}}{4}+(y-1)^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1\\}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186408094 :answer-field/correct "answer-17558800-ef18-55b3-ad7e-9cffc30e4b03" :answer-field/choices ["answer-17558800-ef18-55b3-ad7e-9cffc30e4b03" "answer-172e525a-825d-5e3f-b466-60fd613e7f14" "answer-82e3a295-901e-5dba-be99-3c91dbacf4cb" "answer-530f0720-d51a-5a62-b99e-18a15d0fb434"] :db/ensure [:answer-field/validate]} {:db/id "answer-17558800-ef18-55b3-ad7e-9cffc30e4b03" :answer/id #uuid "17558800-ef18-55b3-ad7e-9cffc30e4b03" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-172e525a-825d-5e3f-b466-60fd613e7f14" :answer/id #uuid "172e525a-825d-5e3f-b466-60fd613e7f14" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+(y-1)^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-82e3a295-901e-5dba-be99-3c91dbacf4cb" :answer/id #uuid "82e3a295-901e-5dba-be99-3c91dbacf4cb" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{(x-2)^{2}}{4}+{y}^{2}\\ge 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-530f0720-d51a-5a62-b99e-18a15d0fb434" :answer/id #uuid "530f0720-d51a-5a62-b99e-18a15d0fb434" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,\\frac{{x}^{2}}{2}+(y-1)^{2}\\le 1\\}" :db/ensure [:answer/validate]} {:db/id "activity-95da094c-cb37-530d-9171-267dcdd5dd88" :activity/id #uuid "95da094c-cb37-530d-9171-267dcdd5dd88" :activity/title "Hyperboloids" :activity/type :activity.type/review :activity/scope 17592186048527 :activity/course 17592186046658 :activity/steps ["step-e804d623-c83b-5e42-aa9d-2d4da33cd8cf" "step-5a386b7d-1c57-5048-9724-e307c6b38500" "step-b7b019dc-5193-51bb-bdb4-64a14504da05" "step-c7c29bd2-52a7-58da-bab6-7c5edcb62364" "step-045330c4-8b5b-55b5-b71b-fe9403aa1a72"] :activity/first-step "step-e804d623-c83b-5e42-aa9d-2d4da33cd8cf" :db/ensure [:activity/validate]} {:db/id "step-e804d623-c83b-5e42-aa9d-2d4da33cd8cf" :step/id #uuid "e804d623-c83b-5e42-aa9d-2d4da33cd8cf" :step/content 17592186391951 :step/next "step-5a386b7d-1c57-5048-9724-e307c6b38500" :db/ensure [:step/validate]} {:db/id "step-5a386b7d-1c57-5048-9724-e307c6b38500" :step/id #uuid "5a386b7d-1c57-5048-9724-e307c6b38500" :step/content 17592186339004 :step/next "step-b7b019dc-5193-51bb-bdb4-64a14504da05" :db/ensure [:step/validate]} {:db/id "step-b7b019dc-5193-51bb-bdb4-64a14504da05" :step/id #uuid "b7b019dc-5193-51bb-bdb4-64a14504da05" :step/content "question-30e8d5c3-bff2-59db-90d6-3878e212499e" :step/next "step-c7c29bd2-52a7-58da-bab6-7c5edcb62364" :db/ensure [:step/validate]} {:db/id "step-c7c29bd2-52a7-58da-bab6-7c5edcb62364" :step/id #uuid "c7c29bd2-52a7-58da-bab6-7c5edcb62364" :step/content 17592186339027 :step/next "step-045330c4-8b5b-55b5-b71b-fe9403aa1a72" :db/ensure [:step/validate]} {:db/id "step-045330c4-8b5b-55b5-b71b-fe9403aa1a72" :step/id #uuid "045330c4-8b5b-55b5-b71b-fe9403aa1a72" :step/content 17592186408095 :db/ensure [:step/validate]} {:db/id 17592186068869 :knowledge-point/questions ["question-aae92775-ad9b-57e5-9350-754a9cbc68ef" "question-64f4689c-0324-5dae-856b-8909998bf3a4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068555 :question/problem "The equation $\\log_3{9} = 2$ is equivalent to $b^2 = 9.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_3{9} = 2$ with $\\log_{b}{a} = x,$ we get $a = 9,$ $b = 3,$ and $x = 2.$\n\nTherefore, the given equation is equivalent to $3^2 = 9.$ Consequently, $b = 3.$" :db/ensure [:question/validate]} {:db/id 17592186068870 :knowledge-point/questions ["question-2a3b35fb-676f-5131-9e77-51463f02e70a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068556 :question/problem "The equation $\\log_{6}{1} = 0$ is equivalent to $b^0 = 1.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_{6}{1} = 0$ with $\\log_{b}{a} = x,$ we get $a = 1,$ $b = 6,$ and $x = 0.$\n\nTherefore, the given equation is equivalent to $6^0 = 1.$ Consequently, $b = 6.$" :db/ensure [:question/validate]} {:db/id 17592186068871 :knowledge-point/questions ["question-0f86c4d0-d8e3-5aa8-b5e8-035ca8958055"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068557 :question/problem "The equation $\\log_{16}{4} = \\dfrac{1}{2}$ is equivalent to $\\sqrt{b} = 4.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_{16}{4} = \\dfrac{1}{2}$ with $\\log_{b}{a} = x,$ we get $a = 4,$ $b = 16,$ and $x = \\dfrac{1}{2}.$\n\nTherefore, the given equation is equivalent to $16^{1/2} = 4,$ which is also equivalent to $\\sqrt{16} = 4.$ Consequently, $b = 16.$" :db/ensure [:question/validate]} {:db/id 17592186068872 :knowledge-point/questions ["question-c561c471-e505-55e6-9a2d-28f93bd6cab2" "question-3a8971db-b741-5f69-8444-adec12e8e30e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186068558 :question/problem "The equation $\\log_{2}\\left( \\dfrac{1}{8} \\right) = -3$ is equivalent to $b^{-3} = \\dfrac{1}{8}.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{b}{a} = x$ is equivalent to $a = b^x$\n\nIf we compare $\\log_{2}\\left( \\dfrac{1}{8} \\right) = -3$ with $\\log_{b}{a} = x,$ we get $a = \\dfrac{1}{8},$ $b = 2,$ and $x = -3.$\n\nTherefore, the given equation is equivalent to $2^{-3} = \\dfrac{1}{8}.$ Consequently, $b = 2.$" :db/ensure [:question/validate]} {:db/id "question-aae92775-ad9b-57e5-9350-754a9cbc68ef" :question/id #uuid "aae92775-ad9b-57e5-9350-754a9cbc68ef" :question/math-academy-id "q-252538" :question/problem "If the equation ${log}_{2}⁡(128)=7$ is equivalent to ${b}^{7}=128,$  then $b=${{field-1}}." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{2}⁡(128)=7$ with ${log}_{b}⁡a=x,$ we get $a=128,$ $b=2,$ and $x=7.$\n\nTherefore, the given equation is equivalent to ${2}^{7}=128.$ Consequently,  $b=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0930c3d0-53cc-5d15-bfd8-a8503884e324"] :db/ensure [:question/validate]} {:db/id "answer-field-0930c3d0-53cc-5d15-bfd8-a8503884e324" :answer-field/id #uuid "0930c3d0-53cc-5d15-bfd8-a8503884e324" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a9c06735-3f62-57f4-8f53-da25745305f2" :answer-field/choices ["answer-a9c06735-3f62-57f4-8f53-da25745305f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-a9c06735-3f62-57f4-8f53-da25745305f2" :answer/id #uuid "a9c06735-3f62-57f4-8f53-da25745305f2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "question-64f4689c-0324-5dae-856b-8909998bf3a4" :question/id #uuid "64f4689c-0324-5dae-856b-8909998bf3a4" :question/math-academy-id "q-2980" :question/problem "The equation ${log}_{5}⁡25=2$ is equivalent to ${5}^{x}=25.$ Determine the value of $x.$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{5}⁡25=2$ with ${log}_{b}⁡a=x,$ we get $a=25,$ $b=5,$ and $x=2.$\n\nTherefore, the given equation is equivalent to ${5}^{2}=25.$ Consequently, $x=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-934413ab-30d2-543e-88f1-d9983567fd65"] :db/ensure [:question/validate]} {:db/id "answer-field-934413ab-30d2-543e-88f1-d9983567fd65" :answer-field/id #uuid "934413ab-30d2-543e-88f1-d9983567fd65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4da4d7be-c5a8-584c-91b0-619bdf3835fa" :answer-field/choices ["answer-5f494f82-2a8e-511a-a5f7-95c5c399691d" "answer-63f3ea92-f52c-56c3-8b20-3b383c879868" "answer-6413616d-1584-5b78-a8c7-cbeb44d42980" "answer-4da4d7be-c5a8-584c-91b0-619bdf3835fa" "answer-248c9929-9c65-53a5-a9cc-d21a16479557"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f494f82-2a8e-511a-a5f7-95c5c399691d" :answer/id #uuid "5f494f82-2a8e-511a-a5f7-95c5c399691d" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-63f3ea92-f52c-56c3-8b20-3b383c879868" :answer/id #uuid "63f3ea92-f52c-56c3-8b20-3b383c879868" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-6413616d-1584-5b78-a8c7-cbeb44d42980" :answer/id #uuid "6413616d-1584-5b78-a8c7-cbeb44d42980" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4da4d7be-c5a8-584c-91b0-619bdf3835fa" :answer/id #uuid "4da4d7be-c5a8-584c-91b0-619bdf3835fa" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-248c9929-9c65-53a5-a9cc-d21a16479557" :answer/id #uuid "248c9929-9c65-53a5-a9cc-d21a16479557" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186069477 :question/problem "The equation ${log}_{5}⁡5=1$ is equivalent to ${b}^{1}=5.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{5}⁡5=1$ with ${log}_{b}⁡a=x,$ we get $a=5,$ $b=5,$ and $x=1.$\n\nTherefore, the given equation is equivalent to ${5}^{1}=5.$ Consequently, $b=5.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186068032 :answer-field/correct 17592186068034 :db/ensure [:answer-field/validate]} {:db/id "question-2a3b35fb-676f-5131-9e77-51463f02e70a" :question/id #uuid "2a3b35fb-676f-5131-9e77-51463f02e70a" :question/math-academy-id "q-252568" :question/problem "If the equation ${log}_{9}⁡9=1$ is equivalent to ${b}^{1}=9,$  then $b=${{field-1}}." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{9}⁡9=1$ with ${log}_{b}⁡a=x,$ we get $a=9,$ $b=9,$ and $x=1.$\n\nTherefore, the given equation is equivalent to ${9}^{1}=9.$ Consequently, $b=9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c0c14681-361a-58ea-b4a8-72d314ead574"] :db/ensure [:question/validate]} {:db/id "answer-field-c0c14681-361a-58ea-b4a8-72d314ead574" :answer-field/id #uuid "c0c14681-361a-58ea-b4a8-72d314ead574" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8ce8fb57-7506-51c7-b90a-ddd7717dc73d" :answer-field/choices ["answer-8ce8fb57-7506-51c7-b90a-ddd7717dc73d"] :db/ensure [:answer-field/validate]} {:db/id "answer-8ce8fb57-7506-51c7-b90a-ddd7717dc73d" :answer/id #uuid "8ce8fb57-7506-51c7-b90a-ddd7717dc73d" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186069191 :question/problem "If the equation ${log}_{25}⁡5=\\frac{1}{2}$ is equivalent to $\\sqrt{b}=5,$  then $b=${{field-1}}." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{25}⁡5=\\frac{1}{2}$ with ${log}_{b}⁡a=x,$ we get $a=5,$ $b=25,$ and $x=\\frac{1}{2}.$\n\nTherefore, the given equation is equivalent to ${25}^{1/2}=5,$ which is also equivalent to $\\sqrt{25}=5.$ Consequently, $b=25.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186066342 :answer-field/correct "answer-be3aa958-bc48-54b0-a782-1a49bad9967f" :answer-field/choices ["answer-be3aa958-bc48-54b0-a782-1a49bad9967f"] :db/ensure [:answer-field/validate]} {:db/id "answer-be3aa958-bc48-54b0-a782-1a49bad9967f" :answer/id #uuid "be3aa958-bc48-54b0-a782-1a49bad9967f" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "question-0f86c4d0-d8e3-5aa8-b5e8-035ca8958055" :question/id #uuid "0f86c4d0-d8e3-5aa8-b5e8-035ca8958055" :question/math-academy-id "q-66712" :question/problem "The equation ${log}_{64}⁡4=\\frac{1}{3}$ is equivalent to $\\sqrt[3]{b}=4.$ What is the value of $b?$" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{64}⁡4=\\frac{1}{3}$ with ${log}_{b}⁡a=x,$ we get $a=4,$ $b=64,$ and $x=\\frac{1}{3}.$\n\nTherefore, the given equation is equivalent to ${64}^{1/3}=4,$ which is also equivalent to $\\sqrt[3]{64}=4.$ Consequently, $b=64.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d539a766-54de-5613-af75-0127b62c8b04"] :db/ensure [:question/validate]} {:db/id "answer-field-d539a766-54de-5613-af75-0127b62c8b04" :answer-field/id #uuid "d539a766-54de-5613-af75-0127b62c8b04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2db6b4d0-742c-582f-b93d-371992bf1b0c" :answer-field/choices ["answer-b8075a70-ebe1-5696-8f99-e244b69d1b1d" "answer-97a54a04-fc50-5f6c-af22-ba0a20eb76c1" "answer-152d058e-e060-5154-920e-08f3d6b98426" "answer-31db2f98-07b7-509d-a62c-b977feaa1ac2" "answer-2db6b4d0-742c-582f-b93d-371992bf1b0c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b8075a70-ebe1-5696-8f99-e244b69d1b1d" :answer/id #uuid "b8075a70-ebe1-5696-8f99-e244b69d1b1d" :answer/type :answer.type/math :answer/value "128" :db/ensure [:answer/validate]} {:db/id "answer-97a54a04-fc50-5f6c-af22-ba0a20eb76c1" :answer/id #uuid "97a54a04-fc50-5f6c-af22-ba0a20eb76c1" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-152d058e-e060-5154-920e-08f3d6b98426" :answer/id #uuid "152d058e-e060-5154-920e-08f3d6b98426" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-31db2f98-07b7-509d-a62c-b977feaa1ac2" :answer/id #uuid "31db2f98-07b7-509d-a62c-b977feaa1ac2" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "answer-2db6b4d0-742c-582f-b93d-371992bf1b0c" :answer/id #uuid "2db6b4d0-742c-582f-b93d-371992bf1b0c" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "question-c561c471-e505-55e6-9a2d-28f93bd6cab2" :question/id #uuid "c561c471-e505-55e6-9a2d-28f93bd6cab2" :question/math-academy-id "q-252619" :question/problem "If the equation ${log}_{1/4}⁡64=-3$ is equivalent to ${b}^{-3}=a,$  then $a=${{field-1}}." :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{1/4}⁡64=-3$ with ${log}_{b}⁡a=x,$ we get $a=64,$ $b=\\frac{1}{4},$ and $x=-3.$\n\nTherefore, the equation ${log}_{1/4}⁡64=-3$ is equivalent to ${(\\frac{1}{4})}^{-3}=64.$ Consequently, $a=64.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-29ade9f6-f749-5ec9-893d-33df04f83e39"] :db/ensure [:question/validate]} {:db/id "answer-field-29ade9f6-f749-5ec9-893d-33df04f83e39" :answer-field/id #uuid "29ade9f6-f749-5ec9-893d-33df04f83e39" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b4dc213e-ad65-5a21-812e-d696846cae8c" :answer-field/choices ["answer-b4dc213e-ad65-5a21-812e-d696846cae8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4dc213e-ad65-5a21-812e-d696846cae8c" :answer/id #uuid "b4dc213e-ad65-5a21-812e-d696846cae8c" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "question-3a8971db-b741-5f69-8444-adec12e8e30e" :question/id #uuid "3a8971db-b741-5f69-8444-adec12e8e30e" :question/math-academy-id "q-252634" :question/problem "Express the equation ${log}_{5}⁡(\\frac{1}{125})=-3$ in exponential form. Write the exponential term on the left-hand side of the equation.\n\n{{field-1}}$=$\n{{field-2}}" :question/worked-solution "The logarithm of $a$ with base $b$ is defined as follows:\n\n${log}_{b}⁡a=x$ is equivalent to $a={b}^{x}$\n\nIf we compare ${log}_{5}⁡(\\frac{1}{125})=-3$ with ${log}_{b}⁡a=x,$ we get $a=\\frac{1}{125},$ $b=5,$ and $x=-3.$\n\nTherefore, the given equation is equivalent to \n\n$$\n{5}^{-3}=\\frac{1}{125}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b81e3147-4f8f-5dc1-aa20-2dd74fcc8034" "answer-field-99dc7578-e9a5-5def-a6d4-42f491265aea"] :db/ensure [:question/validate]} {:db/id "answer-field-b81e3147-4f8f-5dc1-aa20-2dd74fcc8034" :answer-field/id #uuid "b81e3147-4f8f-5dc1-aa20-2dd74fcc8034" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-62333d8a-a547-57b1-ac3c-5c56714cd529" :answer-field/choices ["answer-62333d8a-a547-57b1-ac3c-5c56714cd529"] :db/ensure [:answer-field/validate]} {:db/id "answer-62333d8a-a547-57b1-ac3c-5c56714cd529" :answer/id #uuid "62333d8a-a547-57b1-ac3c-5c56714cd529" :answer/type :answer.type/math :answer/value "5^{-3}" :db/ensure [:answer/validate]} {:db/id "answer-field-99dc7578-e9a5-5def-a6d4-42f491265aea" :answer-field/id #uuid "99dc7578-e9a5-5def-a6d4-42f491265aea" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4330ae15-f6f7-57b1-809f-2e8698af44d8" :answer-field/choices ["answer-4330ae15-f6f7-57b1-809f-2e8698af44d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-4330ae15-f6f7-57b1-809f-2e8698af44d8" :answer/id #uuid "4330ae15-f6f7-57b1-809f-2e8698af44d8" :answer/type :answer.type/math :answer/value "\\frac{1}{125}" :db/ensure [:answer/validate]} {:db/id 17592186069965 :tutorial/content "So far, we have expressed an exponential equation in logarithm form. We can also go the other way, and express a logarithmic equation in exponential form.\n\nRemember, the base of the logarithm is always the base of the exponential expression.\nFor instance, if we know that $\\log_{\\color{blue}{2}}(8) = {\\color{red}{3}},$ we could write this using an exponent as\n\n$$\n{\\color{blue}{2}}^{\\color{red}{3}} = 8.\n$$\n\nIn general, the logarithm of $a$ with base $b$ is defined as follows:\n\n$\\log_{\\color{blue}b}{a} = {\\color{red}x}$ is equivalent to $a = {\\color{blue}b}^{\\color{red}x}.$" :db/ensure [:tutorial/validate]} {:db/id 17592186068984 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186174088 :answer-field/choices 17592186174089] [:db/retract 17592186174088 :answer-field/choices 17592186174092] {:db/id 17592186175957 :knowledge-point/questions ["question-b63e7390-032d-5732-93f4-683f3a627416" "question-b8a8e489-11e9-52ae-86cf-436bdb177f60"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b63e7390-032d-5732-93f4-683f3a627416" :question/id #uuid "b63e7390-032d-5732-93f4-683f3a627416" :question/math-academy-id "q-15495" :question/problem "A rumor is spreading in a city. The rate of growth in the number of people $P(t)$ who heard the rumor follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=12P-0.000\\,2{P}^{2},\\,P(0)=2\\,000.\n$$\n\nwhere $t$ is the time, measured in hours. For which value of $P$ is the number of people who heard the rumor growing at the fastest possible rate?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/9d/9d8f5340bba4d3c407e43f2bc64a4aa2ea986be89b8024baaa4e8ae65e96e5d5.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}\\frac{dP}{dt} & =12P-0.000\\,2{P}^{2} \\\\  & =0.000\\,02P(60\\,000-P)\\end{aligned}\n$$\n\nFrom here, we see that $a=60\\,000.$ Hence, the carrying capacity is $60\\,000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 60\\,000=30\\,000.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c19ec431-2d31-55ac-9370-03580e2d85ee"] :db/ensure [:question/validate]} {:db/id "answer-field-c19ec431-2d31-55ac-9370-03580e2d85ee" :answer-field/id #uuid "c19ec431-2d31-55ac-9370-03580e2d85ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b70a52a-3757-5bac-863c-6e7a9ca75c5d" :answer-field/choices ["answer-3d4fb25d-27d2-5e5c-bcfd-c01b03fe7b16" "answer-4b70a52a-3757-5bac-863c-6e7a9ca75c5d" "answer-f4473ebd-4861-56d2-8435-0aad1abb7b6e" "answer-8f83a6a6-3e56-5e96-b0ee-342a84b5b56d" "answer-0cfd9676-eb74-5ebe-b031-0a788f78718e"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d4fb25d-27d2-5e5c-bcfd-c01b03fe7b16" :answer/id #uuid "3d4fb25d-27d2-5e5c-bcfd-c01b03fe7b16" :answer/type :answer.type/math :answer/value "120\\,000" :db/ensure [:answer/validate]} {:db/id "answer-4b70a52a-3757-5bac-863c-6e7a9ca75c5d" :answer/id #uuid "4b70a52a-3757-5bac-863c-6e7a9ca75c5d" :answer/type :answer.type/math :answer/value "30\\,000" :db/ensure [:answer/validate]} {:db/id "answer-f4473ebd-4861-56d2-8435-0aad1abb7b6e" :answer/id #uuid "f4473ebd-4861-56d2-8435-0aad1abb7b6e" :answer/type :answer.type/math :answer/value "45\\,000" :db/ensure [:answer/validate]} {:db/id "answer-8f83a6a6-3e56-5e96-b0ee-342a84b5b56d" :answer/id #uuid "8f83a6a6-3e56-5e96-b0ee-342a84b5b56d" :answer/type :answer.type/math :answer/value "60\\,000" :db/ensure [:answer/validate]} {:db/id "answer-0cfd9676-eb74-5ebe-b031-0a788f78718e" :answer/id #uuid "0cfd9676-eb74-5ebe-b031-0a788f78718e" :answer/type :answer.type/math :answer/value "75\\,000" :db/ensure [:answer/validate]} {:db/id 17592186176305 :question/problem "Consider the following differential equation for the function $y=y(t):$\n\n$$\n{y}^{′}=1\\,000y-10{y}^{2},\\,y(0)=40\n$$\n\nWhat is ${lim}_{t\\to \\infty }y(t)?$" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity.\n\nA diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's factor the right-hand side of the given equation. This gives\n\n$$\n{y}^{′}=10y(100-y),\\,y(0)=40.\n$$\n\nFrom here, we see that $a=100.$ Hence, the carrying capacity is $100.$\n\nFor a given logistic growth model, $y\\to a$ as $t\\to \\infty .$ Therefore,\n\n$$\n{lim}_{t\\to \\infty }y(t)=100.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186174088 :answer-field/correct 17592186174090 :answer-field/choices ["answer-c00bef54-cb61-5193-b9dc-726065db63fa" "answer-67918e66-eb46-5022-8e71-699c7b27de4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-c00bef54-cb61-5193-b9dc-726065db63fa" :answer/id #uuid "c00bef54-cb61-5193-b9dc-726065db63fa" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "answer-67918e66-eb46-5022-8e71-699c7b27de4f" :answer/id #uuid "67918e66-eb46-5022-8e71-699c7b27de4f" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id 17592186176020 :knowledge-point/questions ["question-f4a129bc-20d0-5e0c-8e4d-26304c226b31" "question-94d0a8c6-e1cc-589d-baf5-ae5d11bc5ecc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f4a129bc-20d0-5e0c-8e4d-26304c226b31" :question/id #uuid "f4a129bc-20d0-5e0c-8e4d-26304c226b31" :question/math-academy-id "q-118558" :question/problem "The population $y(t)$ of beavers in a river follows the logistic growth model\n\n$$\n{y}^{′}=0.2y(8-\\frac{y}{100}),\\,y(0)=200,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible beaver population?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =0.2y(8-\\frac{y}{100}) \\\\  & =0.2y(\\frac{800-y}{100}) \\\\  & =\\frac{0.2y}{100}(800-y) \\\\  & =0.002y(800-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=800.$ Hence, the carrying capacity is $800,$ and we conclude that the number of beavers cannot exceed $800.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-701ad097-1360-59f4-8891-d19c7b1ca762"] :db/ensure [:question/validate]} {:db/id "answer-field-701ad097-1360-59f4-8891-d19c7b1ca762" :answer-field/id #uuid "701ad097-1360-59f4-8891-d19c7b1ca762" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4562e56f-79a7-5953-82dc-cdefccb01ccd" :answer-field/choices ["answer-0c56636a-f906-5735-8c37-7b2138e8f77d" "answer-bf315d70-83f5-5ea5-abd9-3ae3cfc47fdb" "answer-02150670-428b-56e2-9985-6194ff4b8ee1" "answer-4562e56f-79a7-5953-82dc-cdefccb01ccd" "answer-f7d2bf34-d828-5bcd-970b-c54ad54643d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-0c56636a-f906-5735-8c37-7b2138e8f77d" :answer/id #uuid "0c56636a-f906-5735-8c37-7b2138e8f77d" :answer/type :answer.type/math :answer/value "1\\,000" :db/ensure [:answer/validate]} {:db/id "answer-bf315d70-83f5-5ea5-abd9-3ae3cfc47fdb" :answer/id #uuid "bf315d70-83f5-5ea5-abd9-3ae3cfc47fdb" :answer/type :answer.type/math :answer/value "320" :db/ensure [:answer/validate]} {:db/id "answer-02150670-428b-56e2-9985-6194ff4b8ee1" :answer/id #uuid "02150670-428b-56e2-9985-6194ff4b8ee1" :answer/type :answer.type/math :answer/value "600" :db/ensure [:answer/validate]} {:db/id "answer-4562e56f-79a7-5953-82dc-cdefccb01ccd" :answer/id #uuid "4562e56f-79a7-5953-82dc-cdefccb01ccd" :answer/type :answer.type/math :answer/value "800" :db/ensure [:answer/validate]} {:db/id "answer-f7d2bf34-d828-5bcd-970b-c54ad54643d2" :answer/id #uuid "f7d2bf34-d828-5bcd-970b-c54ad54643d2" :answer/type :answer.type/math :answer/value "860" :db/ensure [:answer/validate]} {:db/id "question-94d0a8c6-e1cc-589d-baf5-ae5d11bc5ecc" :question/id #uuid "94d0a8c6-e1cc-589d-baf5-ae5d11bc5ecc" :question/math-academy-id "q-119848" :question/problem "The population $y(t)$ of elephants on a certain African wildlife reserve follows the logistic growth model\n\n$$\n{y}^{′}=26y-0.0002{y}^{2},\\,y(0)=120,\n$$\n\nwhere $t$ is the time, in years, since the observations began. According to this model, what is the maximum possible population of elephants?" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{y}^{′}=ky(a-y),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>y$ is the carrying capacity. \n\nThe carrying capacity $a$ represents the maximum possible population. A diagram showing a typical logistic growth curve is shown below.\n\n![](images/57/57f4b604c546daed4f1cb3895191fae0ccac33b5c17aac705f203f0a837c7e69.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}{y}^{′} & =26y-0.0002{y}^{2} \\\\  & =0.0002y(130\\,000-y)\\end{aligned}\n$$\n\nFrom here, we see that $a=130\\,000.$ Hence, the carrying capacity is $130\\,000,$ and we conclude that the number of elephants cannot exceed $130\\,000.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-85a62696-1e6e-54dd-bb76-a23cc2767801"] :db/ensure [:question/validate]} {:db/id "answer-field-85a62696-1e6e-54dd-bb76-a23cc2767801" :answer-field/id #uuid "85a62696-1e6e-54dd-bb76-a23cc2767801" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d449452a-bba6-5329-88f3-21fa31072558" :answer-field/choices ["answer-d449452a-bba6-5329-88f3-21fa31072558" "answer-f8137660-b678-5be7-9f4e-4e308f57cd8b" "answer-8ed5ba35-1c17-5530-84e8-dc60fa32a602" "answer-33fd38fb-b73c-5e14-af38-22ca47425e43" "answer-3bd45c43-fd6b-5dfa-8ec5-d8595124bde2"] :db/ensure [:answer-field/validate]} {:db/id "answer-d449452a-bba6-5329-88f3-21fa31072558" :answer/id #uuid "d449452a-bba6-5329-88f3-21fa31072558" :answer/type :answer.type/math :answer/value "130\\,000" :db/ensure [:answer/validate]} {:db/id "answer-f8137660-b678-5be7-9f4e-4e308f57cd8b" :answer/id #uuid "f8137660-b678-5be7-9f4e-4e308f57cd8b" :answer/type :answer.type/math :answer/value "13\\,000" :db/ensure [:answer/validate]} {:db/id "answer-8ed5ba35-1c17-5530-84e8-dc60fa32a602" :answer/id #uuid "8ed5ba35-1c17-5530-84e8-dc60fa32a602" :answer/type :answer.type/math :answer/value "1\\,200" :db/ensure [:answer/validate]} {:db/id "answer-33fd38fb-b73c-5e14-af38-22ca47425e43" :answer/id #uuid "33fd38fb-b73c-5e14-af38-22ca47425e43" :answer/type :answer.type/math :answer/value "1\\,300" :db/ensure [:answer/validate]} {:db/id "answer-3bd45c43-fd6b-5dfa-8ec5-d8595124bde2" :answer/id #uuid "3bd45c43-fd6b-5dfa-8ec5-d8595124bde2" :answer/type :answer.type/math :answer/value "2\\,600" :db/ensure [:answer/validate]} {:db/id "question-b8a8e489-11e9-52ae-86cf-436bdb177f60" :question/id #uuid "b8a8e489-11e9-52ae-86cf-436bdb177f60" :question/math-academy-id "q-353486" :question/problem "The population $P(t)$ of elk in a protected national park follows the logistic growth model\n\n$$\n\\frac{dP}{dt}=5P-0.001{P}^{2},\\,P(0)=200,\n$$\n\nwhere $t$ is the time, measured in years. For which value of $P$ is the elk population growing at the fastest possible rate?\n\n$P=$\n{{field-1}}" :question/worked-solution "A logistic growth equation has the form\n\n$$\n{P}^{′}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nFor a logistic growth model, the fastest rate of growth occurs when $P=\\frac{1}{2}a.$\n\n![](images/90/9019b26b417c757bbfab79afb39379c1fc7a892bc44e934c6f23c339deacfd68.png)\n\nFirst, let's rewrite the right-hand side of the given equation so that it matches the form above:\n\n$$\n\\begin{aligned}\\frac{dP}{dt} & =5P-0.001{P}^{2} \\\\  & =0.001P(5000-P)\\end{aligned}\n$$\n\nFrom here, we see that $a=5000.$ Hence, the carrying capacity is $5000,$ and $P$ grows at its fastest possible rate when \n\n$$\nP=\\frac{1}{2}a=\\frac{1}{2}\\cdot 5000=2500.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aa8b8268-0d26-5cf4-8d60-0789f0a8afa9"] :db/ensure [:question/validate]} {:db/id "answer-field-aa8b8268-0d26-5cf4-8d60-0789f0a8afa9" :answer-field/id #uuid "aa8b8268-0d26-5cf4-8d60-0789f0a8afa9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4083cc71-3bcb-5360-9978-e4ce2aebb68e" :answer-field/choices ["answer-4083cc71-3bcb-5360-9978-e4ce2aebb68e"] :db/ensure [:answer-field/validate]} {:db/id "answer-4083cc71-3bcb-5360-9978-e4ce2aebb68e" :answer/id #uuid "4083cc71-3bcb-5360-9978-e4ce2aebb68e" :answer/type :answer.type/math :answer/value "2500" :db/ensure [:answer/validate]} {:db/id "activity-df4cdd91-8906-5e4a-b0e5-b2f695c09521" :activity/id #uuid "df4cdd91-8906-5e4a-b0e5-b2f695c09521" :activity/title "Qualitative Analysis of the Logistic Growth Equation" :activity/type :activity.type/review :activity/scope 17592186050011 :activity/course 17592186046644 :activity/steps ["step-6f1e6e85-1cc9-56f5-81c5-125a6a2d