75154e395" :step/content 17592186297458 :step/next "step-20a5bad1-0380-5cbe-880b-37b9d31deb30" :db/ensure [:step/validate]} {:db/id "step-20a5bad1-0380-5cbe-880b-37b9d31deb30" :step/id #uuid "20a5bad1-0380-5cbe-880b-37b9d31deb30" :step/content 17592186297459 :step/next "step-8d90c070-8a52-56ce-b438-2598dfd524f5" :db/ensure [:step/validate]} {:db/id "step-8d90c070-8a52-56ce-b438-2598dfd524f5" :step/id #uuid "8d90c070-8a52-56ce-b438-2598dfd524f5" :step/content 17592186317528 :step/next "step-3ea34d17-8a70-5fd7-9907-80cd1fee528f" :db/ensure [:step/validate]} {:db/id "step-3ea34d17-8a70-5fd7-9907-80cd1fee528f" :step/id #uuid "3ea34d17-8a70-5fd7-9907-80cd1fee528f" :step/content 17592186317532 :db/ensure [:step/validate]} [:db/retract 17592186120239 :question/answer-fields 17592186117593] {:db/id 17592186119838 :knowledge-point/questions ["question-4c18b1c7-8bdd-5391-9b67-8443fd23166f" "question-47b66d2c-d386-5a47-ab3a-e7307c9bb3f9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4c18b1c7-8bdd-5391-9b67-8443fd23166f" :question/id #uuid "4c18b1c7-8bdd-5391-9b67-8443fd23166f" :question/math-academy-id "q-73998" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=8+3t \\\\ y=-6+7t \\\\ z=2t\\end{aligned}\\,\\text{and}\\,Π:2x+5y-8z=186.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x+5y-8z & =186 \\\\ 2(8+3t)+5(-6+7t)-8(2t) & =186 \\\\ 16+6t-30+35t-16t & =186 \\\\ 25t & =200 \\\\ t & =8\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=8$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=8+3(8)=32 \\\\ y=-6+7(8)=50 \\\\ z=2(8)=16\\end{aligned}\n$$\n\nSo, the intersection point is $P(32,50,16).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-616c22d5-e3ac-50e3-88f8-ae593e1ea4d6"] :db/ensure [:question/validate]} {:db/id "answer-field-616c22d5-e3ac-50e3-88f8-ae593e1ea4d6" :answer-field/id #uuid "616c22d5-e3ac-50e3-88f8-ae593e1ea4d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-739dc482-cca6-5907-b91b-15164a66f7c4" :answer-field/choices ["answer-cde85d08-f475-531a-bd01-73f6eb9051bb" "answer-140b7152-7be6-5b10-b162-4dcea3796757" "answer-7062112e-23e0-5023-abc6-42331af0e0bc" "answer-739dc482-cca6-5907-b91b-15164a66f7c4" "answer-d54b4cb0-06e8-5602-a1ad-89fba9fb6215"] :db/ensure [:answer-field/validate]} {:db/id "answer-cde85d08-f475-531a-bd01-73f6eb9051bb" :answer/id #uuid "cde85d08-f475-531a-bd01-73f6eb9051bb" :answer/type :answer.type/math :answer/value "(12,25,36)" :db/ensure [:answer/validate]} {:db/id "answer-140b7152-7be6-5b10-b162-4dcea3796757" :answer/id #uuid "140b7152-7be6-5b10-b162-4dcea3796757" :answer/type :answer.type/math :answer/value "(23,5,6)" :db/ensure [:answer/validate]} {:db/id "answer-7062112e-23e0-5023-abc6-42331af0e0bc" :answer/id #uuid "7062112e-23e0-5023-abc6-42331af0e0bc" :answer/type :answer.type/math :answer/value "(3,50,6)" :db/ensure [:answer/validate]} {:db/id "answer-739dc482-cca6-5907-b91b-15164a66f7c4" :answer/id #uuid "739dc482-cca6-5907-b91b-15164a66f7c4" :answer/type :answer.type/math :answer/value "(32,50,16)" :db/ensure [:answer/validate]} {:db/id "answer-d54b4cb0-06e8-5602-a1ad-89fba9fb6215" :answer/id #uuid "d54b4cb0-06e8-5602-a1ad-89fba9fb6215" :answer/type :answer.type/text :answer/value "No intersection" :db/ensure [:answer/validate]} {:db/id "question-47b66d2c-d386-5a47-ab3a-e7307c9bb3f9" :question/id #uuid "47b66d2c-d386-5a47-ab3a-e7307c9bb3f9" :question/math-academy-id "q-108335" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\{\\begin{aligned}x=4-t \\\\ y=2+3t \\\\ z=-6+5t\\end{aligned}\\,\\text{and}\\,Π:6x-4y+z+16=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}6x-4y+z+16 & =0 \\\\ 6(4-t)-4(2+3t)+(-6+5t) & =-16 \\\\ 24-6t-8-12t-6+5t & =-16 \\\\ -13t & =-26 \\\\ t & =2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=2$ into the parametric equations of the line:\n\n$$\n\\{\\begin{aligned}x=4-2=2 \\\\ y=2+3(2)=8 \\\\ z=-6+5(2)=4\\end{aligned}\n$$\n\nSo, the intersection point is  $P(2,8,4).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-96cd3fdc-919f-5a7e-9267-58831d9b0de1"] :db/ensure [:question/validate]} {:db/id "answer-field-96cd3fdc-919f-5a7e-9267-58831d9b0de1" :answer-field/id #uuid "96cd3fdc-919f-5a7e-9267-58831d9b0de1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-58a61e2d-79ec-5942-a542-a599506c947f" :answer-field/choices ["answer-58a61e2d-79ec-5942-a542-a599506c947f" "answer-f5f1cb12-78bd-54f6-9673-719b825438c6" "answer-be96b637-0ffd-5d98-b663-5c2fe316eeca" "answer-5933b3cc-3b81-55f6-a9e9-d8ce70b49ee7" "answer-8c3399b1-2e8d-5048-9705-3b903a795275"] :db/ensure [:answer-field/validate]} {:db/id "answer-58a61e2d-79ec-5942-a542-a599506c947f" :answer/id #uuid "58a61e2d-79ec-5942-a542-a599506c947f" :answer/type :answer.type/math :answer/value "(2,8,4)" :db/ensure [:answer/validate]} {:db/id "answer-f5f1cb12-78bd-54f6-9673-719b825438c6" :answer/id #uuid "f5f1cb12-78bd-54f6-9673-719b825438c6" :answer/type :answer.type/math :answer/value "(3,5,-1)" :db/ensure [:answer/validate]} {:db/id "answer-be96b637-0ffd-5d98-b663-5c2fe316eeca" :answer/id #uuid "be96b637-0ffd-5d98-b663-5c2fe316eeca" :answer/type :answer.type/math :answer/value "(6,-4,-16)" :db/ensure [:answer/validate]} {:db/id "answer-5933b3cc-3b81-55f6-a9e9-d8ce70b49ee7" :answer/id #uuid "5933b3cc-3b81-55f6-a9e9-d8ce70b49ee7" :answer/type :answer.type/math :answer/value "(6,-4,1)" :db/ensure [:answer/validate]} {:db/id "answer-8c3399b1-2e8d-5048-9705-3b903a795275" :answer/id #uuid "8c3399b1-2e8d-5048-9705-3b903a795275" :answer/type :answer.type/text :answer/value "No intersection" :db/ensure [:answer/validate]} {:db/id "activity-a05a4f34-cba1-54e4-b6a6-f7ada8846659" :activity/id #uuid "a05a4f34-cba1-54e4-b6a6-f7ada8846659" :activity/title "The Intersection Between a Line and a Plane" :activity/type :activity.type/review :activity/scope 17592186050148 :activity/course 17592186046644 :activity/steps ["step-5afd2fb8-f672-52e7-a18b-c486687e5ed6" "step-ae6d11cd-9598-5c2f-b52d-5379a477c70b" "step-46aaa850-40f1-5820-9c52-4b357fdbea2f" "step-736e1f94-c79a-5f94-aec8-100a0d8ad1be" "step-6b2e7866-b57f-55d0-8fca-843a70bc51a0"] :activity/first-step "step-5afd2fb8-f672-52e7-a18b-c486687e5ed6" :db/ensure [:activity/validate]} {:db/id "step-5afd2fb8-f672-52e7-a18b-c486687e5ed6" :step/id #uuid "5afd2fb8-f672-52e7-a18b-c486687e5ed6" :step/content 17592186120239 :step/next "step-ae6d11cd-9598-5c2f-b52d-5379a477c70b" :db/ensure [:step/validate]} {:db/id "step-ae6d11cd-9598-5c2f-b52d-5379a477c70b" :step/id #uuid "ae6d11cd-9598-5c2f-b52d-5379a477c70b" :step/content 17592186402093 :step/next "step-46aaa850-40f1-5820-9c52-4b357fdbea2f" :db/ensure [:step/validate]} {:db/id "step-46aaa850-40f1-5820-9c52-4b357fdbea2f" :step/id #uuid "46aaa850-40f1-5820-9c52-4b357fdbea2f" :step/content "question-4c18b1c7-8bdd-5391-9b67-8443fd23166f" :step/next "step-736e1f94-c79a-5f94-aec8-100a0d8ad1be" :db/ensure [:step/validate]} {:db/id "step-736e1f94-c79a-5f94-aec8-100a0d8ad1be" :step/id #uuid "736e1f94-c79a-5f94-aec8-100a0d8ad1be" :step/content "question-47b66d2c-d386-5a47-ab3a-e7307c9bb3f9" :step/next "step-6b2e7866-b57f-55d0-8fca-843a70bc51a0" :db/ensure [:step/validate]} {:db/id "step-6b2e7866-b57f-55d0-8fca-843a70bc51a0" :step/id #uuid "6b2e7866-b57f-55d0-8fca-843a70bc51a0" :step/content 17592186515570 :db/ensure [:step/validate]} [:db/retract 17592186135916 :answer-field/choices 17592186135920] [:db/retract 17592186135916 :answer-field/choices 17592186135921] [:db/retract 17592186135916 :answer-field/choices 17592186135917] [:db/retract 17592186135916 :answer-field/choices 17592186135918] [:db/retract 17592186135916 :answer-field/choices 17592186135919] {:db/id 17592186138442 :knowledge-point/questions ["question-a4020071-b095-5022-af4b-4598557e943b" "question-0d475207-225c-5dcb-85b4-165f52b26314"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138314 :question/worked-solution "We are given the units $\\dfrac{\\textrm{mg}}{\\textrm{m}},$ and we want to convert this into $\\dfrac{\\textrm{g}}{\\textrm{m}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\dfrac{\\textrm{mg}}{\\textrm{m}}\\cdot\\, \\dfrac{?}{?} = \\dfrac{\\textrm{g}}{\\textrm{m}}\n$$\n\nWe want to replace $\\textrm{mg}$ with $\\textrm{g}.$ To get rid of $\\textrm{mg},$ we can put $\\textrm{mg}$ in the denominator so that it cancels out. To introduce $\\textrm{g},$ we can put $\\textrm{g}$ in the numerator.\n\n$$\n\\require{cancel}\n\\dfrac{\\cancel{\\textrm{mg}} }{\\textrm{m}}\\cdot \\dfrac{\\textrm{g} }{\\cancel{ \\textrm{mg} } } = \\dfrac{\\textrm{g}}{\\textrm{m}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\require{cancel}\n\\dfrac{\\textrm{mg} }{\\textrm{m}}\\cdot \\dfrac{\\textrm{g} }{ \\textrm{mg} } = \\dfrac{\\textrm{g}}{\\textrm{m}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The density given in the problem statement is $3\\,950 \\, \\dfrac{\\textrm{mg}}{\\textrm{m}}.$\n\n- There are $1\\,000$ milligrams per gram. Taking the reciprocal, there are $\\dfrac{1}{1\\,000}$ grams per milligram.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}3\\,950\\,\\frac{\\text{mg}}{\\text{m}} & =3\\,950\\,\\frac{\\text{mg}}{\\text{m}}\\cdot \\frac{1}{1\\,000}\\,\\frac{\\text{g}}{\\text{mg}} \\\\  & =(3\\,950\\cdot \\frac{1}{1\\,000})\\,\\frac{\\cancel{\\text{mg}}}{\\text{m}}\\cdot \\frac{\\text{g}}{\\cancel{\\text{mg}}} \\\\  & =3.95\\,\\frac{\\text{g}}{\\text{m}}.\\end{aligned}\n$$\n\nThus, the linear mass density of the string is $3.95\\,\\textrm{g}/\\textrm{m}.$" :db/ensure [:question/validate]} {:db/id 17592186138443 :knowledge-point/questions ["question-642f1676-b974-5c20-b33e-f45029a01f5a" "question-5082eabf-27a1-5373-b336-872133f4c0e0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138315 :question/worked-solution "We are given the units $\\dfrac{\\textrm{g}}{\\textrm{min}},$ and we want to convert this into $\\dfrac{\\textrm{g}}{\\textrm{s}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\dfrac{\\textrm{g}}{\\textrm{min}}\\cdot\\, \\dfrac{?}{?} = \\dfrac{\\textrm{g}}{\\textrm{s}}\n$$\n\nWe want to replace $\\textrm{min}$ with $\\textrm{s}.$ To get rid of $\\textrm{min},$ we can put $\\textrm{min}$ in the numerator so that it cancels out. To introduce $\\textrm{s},$ we can put $\\textrm{s}$ in the denominator.\n\n$$\n\\require{cancel}\n\\dfrac{\\textrm{g} }{ \\cancel{\\textrm{min}}}\\cdot \\dfrac{ \\cancel{ \\textrm{min} } }{ \\textrm{s} } = \\dfrac{\\textrm{g}}{\\textrm{s}}\n$$\n\nTherefore, our conversion formula is\n\n$$\n\\dfrac{\\textrm{g} }{ \\textrm{min}}\\cdot \\dfrac{  \\textrm{min}  }{ \\textrm{s} } = \\dfrac{\\textrm{g}}{\\textrm{s}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The rate given in the problem statement is $120 \\, \\dfrac{\\textrm{g}}{\\textrm{min}}.$\n\n- There are $60$ seconds per minute. Taking the reciprocal, there are $\\dfrac{1}{60}$ minutes per second.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}120\\,\\frac{\\text{g}}{\\text{min}} & =120\\,\\frac{\\text{g}}{\\text{min}}\\cdot \\frac{1}{60}\\,\\frac{\\text{min}}{\\text{s}} \\\\  & =(120\\cdot \\frac{1}{60})\\,\\frac{\\text{g}}{\\cancel{\\text{min}}}\\cdot \\frac{\\cancel{\\text{min}}}{\\text{s}} \\\\  & =2\\,\\frac{\\text{g}}{\\text{s}}.\\end{aligned}\n$$\n\nThus, the sand runs through the sand timer at a rate of $2 \\,\\textrm{g}/\\textrm{s}.$" :db/ensure [:question/validate]} {:db/id 17592186138444 :knowledge-point/questions ["question-e856700f-73de-59c0-8d3a-1f40df24d089"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138316 :question/worked-solution "We are given the units $\\dfrac{\\textrm{km}}{\\textrm{hour}},$ and we want to convert this into $\\dfrac{\\textrm{m}}{\\textrm{s}}.$ We're converting two units instead of just one, so we're going to have to multiply by two conversion factors:\n\n$$\n\\dfrac{\\textrm{km}}{\\textrm{hour}}\\cdot \\,\\dfrac{?}{?} \\cdot \\,\\dfrac{?}{?} = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nOne of the conversion factors should change $\\textrm{km}$ to $\\textrm{m}.$\n\n$$\n\\dfrac{\\cancel{\\color{blue}\\textrm{km}} }{\\textrm{hour}}\\cdot \\dfrac{\\textrm{m}}{\\cancel{\\color{blue}\\textrm{km}} } \\cdot \\,\\dfrac{?}{?} = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nThe other conversion factor should change $\\textrm{hour}$ into $\\textrm{s}.$\n\n$$\n\\dfrac{\\cancel{\\color{blue}\\textrm{km}} }{ \\cancel{\\color{red}\\textrm{hour}} }\\cdot \\dfrac{\\textrm{m}}{\\cancel{\\color{blue}\\textrm{km}} } \\cdot \\dfrac{ \\cancel{\\color{red}\\textrm{hour}} }{ \\textrm{s} } = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\dfrac{\\color{black}\\textrm{km} }{ \\color{black}\\textrm{hour} }\\cdot \\dfrac{\\textrm{m}}{\\color{black}\\textrm{km} } \\cdot \\dfrac{ \\color{black}\\textrm{hour} }{ \\textrm{s} } = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The rate given in the problem statement is $360 \\, \\dfrac{\\textrm{km}}{\\textrm{hour}}.$\n\n- There are $1\\,000$ meters per kilometer.\n\n- The number of seconds in one hour is given by\n\n$$\n\\begin{aligned}1\\,\\text{hour} & =60\\,\\text{minutes} \\\\  & =60\\cdot 1\\,\\text{minute} \\\\  & =60\\cdot 60\\,\\text{s} \\\\  & =3\\,600\\,\\text{s}.\\end{aligned}\n$$\n\nTaking the reciprocal, we find that there are $\\dfrac{1}{3\\,600}$ hours per second.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}360\\,\\frac{\\text{km}}{\\text{hour}} & =360\\,\\frac{\\text{km}}{\\text{hour}}\\cdot 1\\,000\\,\\frac{\\text{m}}{\\text{km}}\\cdot \\frac{1}{3\\,600}\\,\\frac{\\text{hour}}{\\text{s}} \\\\  & =(360\\cdot 1\\,000\\cdot \\frac{1}{3\\,600})\\,\\frac{\\cancel{\\text{km}}}{\\cancel{\\text{hour}}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{km}}}\\cdot \\frac{\\cancel{\\text{hour}}}{\\text{s}} \\\\  & =100\\,\\frac{\\text{m}}{\\text{s}}.\\end{aligned}\n$$\n\nThus, the speed of the falcon is $100$ meters per second." :db/ensure [:question/validate]} {:db/id "question-a4020071-b095-5022-af4b-4598557e943b" :question/id #uuid "a4020071-b095-5022-af4b-4598557e943b" :question/math-academy-id "q-105547" :question/problem "The acceleration of a cyclist is $1.5\\,{\\text{m/s}}^{2}.$ What is the cyclist's acceleration in ${\\text{km/s}}^{2}?$" :question/worked-solution "We are given the units $\\frac{\\text{m}}{{\\text{s}}^{2}},$ and we want to convert this into $\\frac{\\text{km}}{{\\text{s}}^{2}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\frac{\\text{m}}{{\\text{s}}^{2}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{km}}{{\\text{s}}^{2}}\n$$\n\nWe want to replace $\\text{m}$ with $\\text{km}.$ To get rid of $\\text{m},$ we can put $\\text{m}$ in the denominator so that it cancels out. To introduce $\\text{km},$ we can put $\\text{km}$ in the numerator.\n\n$$\n\\frac{\\cancel{\\text{m}}}{{\\text{s}}^{2}}\\cdot \\frac{\\text{km}}{\\cancel{\\text{m}}}=\\frac{\\text{km}}{{\\text{s}}^{2}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{m}}{{\\text{s}}^{2}}\\cdot \\frac{\\text{km}}{\\text{m}}=\\frac{\\text{km}}{{\\text{s}}^{2}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The acceleration given in the problem statement is $1.5\\,\\frac{\\text{m}}{{\\text{s}}^{2}}.$\n\n- There are $1\\,000$ meters per kilometer. Taking the reciprocal, there are $\\frac{1}{1\\,000}$ kilometers per meter.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}1.5\\,\\frac{\\text{m}}{{\\text{s}}^{2}} & =1.5\\,\\frac{\\text{m}}{{\\text{s}}^{2}}\\cdot \\frac{1}{1\\,000}\\,\\frac{\\text{km}}{\\text{m}} \\\\  & =1.5\\cdot \\frac{1}{1\\,000}(\\frac{\\cancel{\\text{m}}}{{\\text{s}}^{2}}\\cdot \\frac{\\text{km}}{\\cancel{\\text{m}}}) \\\\  & =0.001\\,5\\,\\frac{\\text{km}}{{\\text{s}}^{2}}.\\end{aligned}\n$$\n\nThus, the acceleration of the cyclist is $0.001\\,5\\,\\text{km}/{\\text{s}}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ecc56b39-eec2-58a2-8d1d-910e05bec8f7"] :db/ensure [:question/validate]} {:db/id "answer-field-ecc56b39-eec2-58a2-8d1d-910e05bec8f7" :answer-field/id #uuid "ecc56b39-eec2-58a2-8d1d-910e05bec8f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3a5523c-6f55-59d2-b7c2-6c598b3d19c9" :answer-field/choices ["answer-a3a5523c-6f55-59d2-b7c2-6c598b3d19c9" "answer-8b9a5554-46d2-5bd3-9bac-5ac0beea217a" "answer-aab27a45-ad45-576b-b764-0f80ee6bf45e" "answer-492377d5-2038-59ab-be78-068c1d4f8b93" "answer-15f65945-b500-528c-b740-17a557b9ff0a"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3a5523c-6f55-59d2-b7c2-6c598b3d19c9" :answer/id #uuid "a3a5523c-6f55-59d2-b7c2-6c598b3d19c9" :answer/type :answer.type/math :answer/value "0.001\\,5\\,\\text{km}/{\\text{s}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8b9a5554-46d2-5bd3-9bac-5ac0beea217a" :answer/id #uuid "8b9a5554-46d2-5bd3-9bac-5ac0beea217a" :answer/type :answer.type/math :answer/value "0.015\\,\\text{km}/{\\text{s}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-aab27a45-ad45-576b-b764-0f80ee6bf45e" :answer/id #uuid "aab27a45-ad45-576b-b764-0f80ee6bf45e" :answer/type :answer.type/math :answer/value "0.15\\,\\text{km}/{\\text{s}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-492377d5-2038-59ab-be78-068c1d4f8b93" :answer/id #uuid "492377d5-2038-59ab-be78-068c1d4f8b93" :answer/type :answer.type/math :answer/value "150\\,\\text{km}/{\\text{s}}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-15f65945-b500-528c-b740-17a557b9ff0a" :answer/id #uuid "15f65945-b500-528c-b740-17a557b9ff0a" :answer/type :answer.type/math :answer/value "15\\,\\text{km}/{\\text{s}}^{2}" :db/ensure [:answer/validate]} {:db/id "question-0d475207-225c-5dcb-85b4-165f52b26314" :question/id #uuid "0d475207-225c-5dcb-85b4-165f52b26314" :question/math-academy-id "q-105551" :question/problem "A cruise ship on the high seas travels at a speed of $972$ centimeters per second. What is the speed of the ship in meters per second?" :question/worked-solution "We are given the units $\\frac{\\text{cm}}{\\text{s}},$ and we want to convert this into $\\frac{\\text{m}}{\\text{s}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\frac{\\text{cm}}{\\text{s}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{m}}{\\text{s}}\n$$\n\nWe want to replace $\\text{cm}$ with $\\text{m}.$ To get rid of $\\text{cm},$ we can put $\\text{cm}$ in the denominator so that it cancels out. To introduce $\\text{m},$ we can put $\\text{m}$ in the numerator.\n\n$$\n\\frac{\\cancel{\\text{cm}}}{\\text{s}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{cm}}}=\\frac{\\text{m}}{\\text{s}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{cm}}{\\text{s}}\\cdot \\frac{\\text{m}}{\\text{cm}}=\\frac{\\text{m}}{\\text{s}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The speed given in the problem statement is $972\\,\\frac{\\text{cm}}{\\text{s}}.$\n\n- There are $100$ centimeters per meter. Taking the reciprocal, there are $\\frac{1}{100}$ meters per centimeter.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}972\\,\\frac{\\text{cm}}{\\text{s}} & =972\\,\\frac{\\text{cm}}{\\text{s}}\\cdot \\frac{1}{100}\\,\\frac{\\text{m}}{\\text{cm}} \\\\  & =972\\cdot \\frac{1}{100}(\\frac{\\cancel{\\text{cm}}}{\\text{s}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{cm}}}) \\\\  & =9.72\\,\\frac{\\text{m}}{\\text{s}}.\\end{aligned}\n$$\n\nThus, the speed of the cruise is $9.72\\,\\text{m}/\\text{s}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4da99ea6-5345-5314-8a2c-a1800552e160"] :db/ensure [:question/validate]} {:db/id "answer-field-4da99ea6-5345-5314-8a2c-a1800552e160" :answer-field/id #uuid "4da99ea6-5345-5314-8a2c-a1800552e160" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f638ad08-eeb3-554a-98df-a3d74479967d" :answer-field/choices ["answer-b3f79363-79cd-5503-9bee-b923c291154b" "answer-f638ad08-eeb3-554a-98df-a3d74479967d" "answer-9ff5a488-9441-5023-926c-ce3a0b335fed" "answer-917086dd-8ad2-56fb-8eb0-55b0aeef4f7e" "answer-f3bd8d2d-544f-5f51-b969-f8bb0251dbd8"] :db/ensure [:answer-field/validate]} {:db/id "answer-b3f79363-79cd-5503-9bee-b923c291154b" :answer/id #uuid "b3f79363-79cd-5503-9bee-b923c291154b" :answer/type :answer.type/math :answer/value "0.972\\,\\text{m}/\\text{s}" :db/ensure [:answer/validate]} {:db/id "answer-f638ad08-eeb3-554a-98df-a3d74479967d" :answer/id #uuid "f638ad08-eeb3-554a-98df-a3d74479967d" :answer/type :answer.type/math :answer/value "9.72\\,\\text{m}/\\text{s}" :db/ensure [:answer/validate]} {:db/id "answer-9ff5a488-9441-5023-926c-ce3a0b335fed" :answer/id #uuid "9ff5a488-9441-5023-926c-ce3a0b335fed" :answer/type :answer.type/math :answer/value "97.2\\,\\text{m}/\\text{s}" :db/ensure [:answer/validate]} {:db/id "answer-917086dd-8ad2-56fb-8eb0-55b0aeef4f7e" :answer/id #uuid "917086dd-8ad2-56fb-8eb0-55b0aeef4f7e" :answer/type :answer.type/math :answer/value "97\\,200\\,\\text{m}/\\text{s}" :db/ensure [:answer/validate]} {:db/id "answer-f3bd8d2d-544f-5f51-b969-f8bb0251dbd8" :answer/id #uuid "f3bd8d2d-544f-5f51-b969-f8bb0251dbd8" :answer/type :answer.type/math :answer/value "9\\,720\\,\\text{m}/\\text{s}" :db/ensure [:answer/validate]} {:db/id "question-642f1676-b974-5c20-b33e-f45029a01f5a" :question/id #uuid "642f1676-b974-5c20-b33e-f45029a01f5a" :question/math-academy-id "q-46697" :question/problem "A car travels at a speed of $2.5$ kilometers per minute. What is this in kilometers per hour?" :question/worked-solution "We are given the units $\\frac{\\text{km}}{\\text{min}},$ and we want to convert this into $\\frac{\\text{km}}{\\text{hour}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\frac{\\text{km}}{\\text{min}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{km}}{\\text{hour}}\n$$\n\nWe want to replace $\\text{min}$ with $\\text{hour}.$ To get rid of $\\text{min},$ we can put $\\text{min}$ in the numerator so that it cancels out. To introduce $\\text{hour},$ we can put $\\text{hour}$ in the denominator.\n\n$$\n\\frac{\\text{km}}{\\cancel{\\text{min}}}\\cdot \\frac{\\cancel{\\text{min}}}{\\text{hour}}=\\frac{\\text{km}}{\\text{hour}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{km}}{\\text{min}}\\cdot \\frac{\\text{min}}{\\text{hour}}=\\frac{\\text{km}}{\\text{hour}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The rate given in the problem statement is $2.5\\,\\frac{\\text{km}}{\\text{min}}.$\n\n- There are $60$ minutes in one hour.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}2.5\\,\\frac{\\text{km}}{\\text{min}} & =2.5\\,\\frac{\\text{km}}{\\text{min}}\\cdot 60\\,\\frac{\\text{min}}{\\text{hour}} \\\\  & =2.5\\cdot 60(\\frac{\\text{km}}{\\cancel{\\text{min}}}\\cdot \\frac{\\cancel{\\text{min}}}{\\text{hour}}) \\\\  & =150\\,\\frac{\\text{km}}{\\text{hour}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-16da39d2-fdd0-5aa5-84cd-d52ae5dab2c1"] :db/ensure [:question/validate]} {:db/id "answer-field-16da39d2-fdd0-5aa5-84cd-d52ae5dab2c1" :answer-field/id #uuid "16da39d2-fdd0-5aa5-84cd-d52ae5dab2c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f967064-3dce-5f42-b291-550af58a18c6" :answer-field/choices ["answer-f0e752a9-62d5-5350-8ec9-a86a3355e5cb" "answer-7f967064-3dce-5f42-b291-550af58a18c6" "answer-462d5be7-6aa9-513b-9a51-6ade4b44dd82" "answer-ae284407-e445-5a54-b789-f40aae94b7e9" "answer-311a3504-e36b-5f10-892e-bdeb105186c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0e752a9-62d5-5350-8ec9-a86a3355e5cb" :answer/id #uuid "f0e752a9-62d5-5350-8ec9-a86a3355e5cb" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-7f967064-3dce-5f42-b291-550af58a18c6" :answer/id #uuid "7f967064-3dce-5f42-b291-550af58a18c6" :answer/type :answer.type/math :answer/value "150" :db/ensure [:answer/validate]} {:db/id "answer-462d5be7-6aa9-513b-9a51-6ade4b44dd82" :answer/id #uuid "462d5be7-6aa9-513b-9a51-6ade4b44dd82" :answer/type :answer.type/math :answer/value "1\\,500" :db/ensure [:answer/validate]} {:db/id "answer-ae284407-e445-5a54-b789-f40aae94b7e9" :answer/id #uuid "ae284407-e445-5a54-b789-f40aae94b7e9" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "answer-311a3504-e36b-5f10-892e-bdeb105186c8" :answer/id #uuid "311a3504-e36b-5f10-892e-bdeb105186c8" :answer/type :answer.type/math :answer/value "600" :db/ensure [:answer/validate]} {:db/id "question-5082eabf-27a1-5373-b336-872133f4c0e0" :question/id #uuid "5082eabf-27a1-5373-b336-872133f4c0e0" :question/math-academy-id "q-105556" :question/problem "A racecar can reach a speed of $360$ kilometers per hour. What is this speed in kilometers per second?" :question/worked-solution "We are given the units $\\frac{\\text{km}}{\\text{h}},$ and we want to convert this into $\\frac{\\text{km}}{\\text{s}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\frac{\\text{km}}{\\text{h}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{km}}{\\text{s}}\n$$\n\nWe want to replace $\\text{h}$ with $\\text{s}.$ To get rid of $\\text{h},$ we can put $\\text{h}$ in the numerator so that it cancels out. To introduce $\\text{s},$ we can put $\\text{s}$ in the denominator.\n\n$$\n\\frac{\\text{km}}{\\cancel{\\text{h}}}\\cdot \\frac{\\cancel{\\text{h}}}{\\text{s}}=\\frac{\\text{km}}{\\text{s}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{km}}{\\text{h}}\\cdot \\frac{\\text{h}}{\\text{s}}=\\frac{\\text{km}}{\\text{s}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The speed given in the problem statement is $360\\,\\frac{\\text{km}}{\\text{h}}.$\n\n- There are $3\\,600$ seconds per hour. Taking the reciprocal, there are $\\frac{1}{3\\,600}$ hours per second.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}360\\,\\frac{\\text{km}}{\\text{h}} & =360\\,\\frac{\\text{km}}{\\text{h}}\\cdot \\frac{1}{3\\,600}\\,\\frac{\\text{h}}{\\text{s}} \\\\  & =(360\\cdot \\frac{1}{3\\,600})\\,\\frac{\\text{km}}{\\cancel{\\text{h}}}\\cdot \\frac{\\cancel{\\text{h}}}{\\text{s}} \\\\  & =0.1\\,\\frac{\\text{km}}{\\text{s}}.\\end{aligned}\n$$\n\nThus, the race car reach a speed  of $0.1\\,\\text{km}/\\text{s}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-45a8bede-a863-52ca-9cb6-ae8ed026f9dd"] :db/ensure [:question/validate]} {:db/id "answer-field-45a8bede-a863-52ca-9cb6-ae8ed026f9dd" :answer-field/id #uuid "45a8bede-a863-52ca-9cb6-ae8ed026f9dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b523d36c-1bf0-53cc-978b-b71319d7a12d" :answer-field/choices ["answer-2526bd24-622c-5111-ad94-fbb56ead3d23" "answer-b523d36c-1bf0-53cc-978b-b71319d7a12d" "answer-5ec01a81-fb61-582d-ae8d-2125920edf15" "answer-c3e8dd65-936c-5ce5-b9fd-88eb040a28a2" "answer-49972733-8d9d-5321-b836-cf1a178c9f8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-2526bd24-622c-5111-ad94-fbb56ead3d23" :answer/id #uuid "2526bd24-622c-5111-ad94-fbb56ead3d23" :answer/type :answer.type/math :answer/value "0.01\\,\\frac{\\text{km}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-b523d36c-1bf0-53cc-978b-b71319d7a12d" :answer/id #uuid "b523d36c-1bf0-53cc-978b-b71319d7a12d" :answer/type :answer.type/math :answer/value "0.1\\,\\frac{\\text{km}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-5ec01a81-fb61-582d-ae8d-2125920edf15" :answer/id #uuid "5ec01a81-fb61-582d-ae8d-2125920edf15" :answer/type :answer.type/math :answer/value "0.6\\,\\frac{\\text{km}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-c3e8dd65-936c-5ce5-b9fd-88eb040a28a2" :answer/id #uuid "c3e8dd65-936c-5ce5-b9fd-88eb040a28a2" :answer/type :answer.type/math :answer/value "10\\,\\frac{\\text{km}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-49972733-8d9d-5321-b836-cf1a178c9f8e" :answer/id #uuid "49972733-8d9d-5321-b836-cf1a178c9f8e" :answer/type :answer.type/math :answer/value "6\\,\\frac{\\text{km}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "question-e856700f-73de-59c0-8d3a-1f40df24d089" :question/id #uuid "e856700f-73de-59c0-8d3a-1f40df24d089" :question/math-academy-id "q-52044" :question/problem "A tree sapling grows by $2$ centimeters per day. Assuming that one year has $365$ days, how many meters does the tree grow in one year?" :question/worked-solution "We are given the units $\\frac{\\text{cm}}{\\text{day}},$ and we want to convert this into $\\frac{\\text{m}}{\\text{year}}.$ We're converting two units instead of just one, so we're going to have to multiply by two conversion factors:\n\n$$\n\\frac{\\text{cm}}{\\text{day}}\\cdot \\,\\frac{?}{?}\\cdot \\,\\frac{?}{?}=\\frac{\\text{m}}{\\text{year}}\n$$\n\nOne of the conversion factors should change $\\text{cm}$ to $\\text{m}.$\n\n$$\n\\frac{\\cancel{\\text{cm}}}{\\text{day}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{cm}}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{m}}{\\text{year}}\n$$\n\nThe other conversion factor should change $\\text{day}$ into $\\text{year}.$\n\n$$\n\\frac{\\cancel{\\text{cm}}}{\\cancel{\\text{day}}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{cm}}}\\cdot \\frac{\\cancel{\\text{days}}}{\\text{year}}=\\frac{\\text{m}}{\\text{year}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{cm}}{\\text{day}}\\cdot \\frac{\\text{m}}{\\text{cm}}\\cdot \\frac{\\text{days}}{\\text{year}}=\\frac{\\text{m}}{\\text{year}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The rate given in the problem statement is $2\\,\\frac{\\text{cm}}{\\text{day}}.$\n\n- There are $100$ centimeters in one meter, therefore, there are $\\frac{1}{100}$ meters in one centimeter.\n\n- There are $365$ days in one year.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}2\\,\\frac{\\text{cm}}{\\text{day}} & =2\\,\\frac{\\text{cm}}{\\text{day}}\\cdot \\frac{1}{100}\\,\\frac{\\text{m}}{\\text{cm}}\\cdot 365\\,\\frac{\\text{days}}{\\text{year}} \\\\  & =2\\cdot \\frac{1}{100}\\cdot 365(\\frac{\\cancel{\\text{cm}}}{\\cancel{\\text{day}}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{cm}}}\\cdot \\frac{\\cancel{\\text{days}}}{\\text{year}}) \\\\  & =7.3\\,\\frac{\\text{m}}{\\text{year}}.\\end{aligned}\n$$\n\nConsequently, $2$ centimeters per day is equivalent to $7.3$ meters per year. In one year, the tree grows by $7.3$ meters." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3a0b5d40-1768-5377-8893-9229f2f0b027"] :db/ensure [:question/validate]} {:db/id "answer-field-3a0b5d40-1768-5377-8893-9229f2f0b027" :answer-field/id #uuid "3a0b5d40-1768-5377-8893-9229f2f0b027" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd3dad55-53b9-5149-9af5-5e3b2c18ac2d" :answer-field/choices ["answer-cd64ecf1-525c-5508-8649-19fa1da0870a" "answer-086d4688-33de-5a64-866f-902df4384ebc" "answer-fd3dad55-53b9-5149-9af5-5e3b2c18ac2d" "answer-6f915334-6b87-5751-ad38-2d634085831f" "answer-4d872133-f4d9-5e17-b850-ddc1193b671a"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd64ecf1-525c-5508-8649-19fa1da0870a" :answer/id #uuid "cd64ecf1-525c-5508-8649-19fa1da0870a" :answer/type :answer.type/text :answer/value "$6.5$ meters" :db/ensure [:answer/validate]} {:db/id "answer-086d4688-33de-5a64-866f-902df4384ebc" :answer/id #uuid "086d4688-33de-5a64-866f-902df4384ebc" :answer/type :answer.type/text :answer/value "$6.9$ meters" :db/ensure [:answer/validate]} {:db/id "answer-fd3dad55-53b9-5149-9af5-5e3b2c18ac2d" :answer/id #uuid "fd3dad55-53b9-5149-9af5-5e3b2c18ac2d" :answer/type :answer.type/text :answer/value "$7.3$ meters" :db/ensure [:answer/validate]} {:db/id "answer-6f915334-6b87-5751-ad38-2d634085831f" :answer/id #uuid "6f915334-6b87-5751-ad38-2d634085831f" :answer/type :answer.type/text :answer/value "$7.8$ meters" :db/ensure [:answer/validate]} {:db/id "answer-4d872133-f4d9-5e17-b850-ddc1193b671a" :answer/id #uuid "4d872133-f4d9-5e17-b850-ddc1193b671a" :answer/type :answer.type/text :answer/value "$8.1$ meters" :db/ensure [:answer/validate]} {:db/id 17592186138828 :question/problem "Lewis spends $0.5$ hours per day studying. How many minutes per week does Lewis study for?" :question/worked-solution "We are given the units $\\frac{\\text{hours}}{\\text{day}},$ and we want to convert this into $\\frac{\\text{min}}{\\text{week}}.$ We're converting two units instead of just one, so we're going to have to multiply by two conversion factors:\n\n$$\n\\frac{\\text{hours}}{\\text{day}}\\cdot \\,\\frac{?}{?}\\cdot \\,\\frac{?}{?}=\\frac{\\text{min}}{\\text{week}}\n$$\n\nOne of the conversion factors should change $\\text{hours}$ to $\\text{min}.$\n\n$$\n\\frac{\\cancel{\\text{hours}}}{\\text{day}}\\cdot \\frac{\\text{min}}{\\cancel{\\text{hour}}}\\cdot \\,\\frac{?}{?}=\\frac{\\text{m}}{\\text{s}}\n$$\n\nThe other conversion factor should change $\\text{day}$ into $\\text{week}.$\n\n$$\n\\frac{\\cancel{\\text{hours}}}{\\cancel{\\text{day}}}\\cdot \\frac{\\text{min}}{\\cancel{\\text{hour}}}\\cdot \\frac{\\cancel{\\text{days}}}{\\text{week}}=\\frac{\\text{min}}{\\text{week}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\frac{\\text{hours}}{\\text{day}}\\cdot \\frac{\\text{min}}{\\text{hour}}\\cdot \\frac{\\text{days}}{\\text{week}}=\\frac{\\text{min}}{\\text{week}}.\n$$\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The rate given in the problem statement is $0.5\\,\\frac{\\text{hours}}{\\text{day}}.$\n\n- There are $60$ minutes per hour.\n\n- There are $7$ days per week.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}0.5\\,\\frac{\\text{hours}}{\\text{day}} & =0.5\\,\\frac{\\text{hours}}{\\text{day}}\\cdot 60\\,\\frac{\\text{min}}{\\text{hour}}\\cdot 7\\,\\frac{\\text{days}}{\\text{week}} \\\\  & =(0.5\\cdot 60\\cdot 7)\\,\\frac{\\cancel{\\text{hours}}}{\\cancel{\\text{day}}}\\cdot \\frac{\\text{min}}{\\cancel{\\text{hour}}}\\cdot \\frac{\\cancel{\\text{days}}}{\\text{week}} \\\\  & =210\\,\\frac{\\text{min}}{\\text{week}}.\\end{aligned}\n$$\n\nThus, Lewis studies at a rate of $210\\,\\text{min/week}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186135916 :answer-field/correct "answer-53097714-c01c-56b3-be37-c288fe7f3d0e" :answer-field/choices ["answer-92fc4243-c171-52b5-801c-0bafb7621011" "answer-afc05660-fc2c-5907-a9a0-b2ebe8087619" "answer-1e2988fa-d18c-5b90-ac1c-561062dc8688" "answer-53097714-c01c-56b3-be37-c288fe7f3d0e" "answer-ea00352a-797f-5364-8b6d-067ce9cbb891"] :db/ensure [:answer-field/validate]} {:db/id "answer-92fc4243-c171-52b5-801c-0bafb7621011" :answer/id #uuid "92fc4243-c171-52b5-801c-0bafb7621011" :answer/type :answer.type/math :answer/value "150\\,\\text{min/week}" :db/ensure [:answer/validate]} {:db/id "answer-afc05660-fc2c-5907-a9a0-b2ebe8087619" :answer/id #uuid "afc05660-fc2c-5907-a9a0-b2ebe8087619" :answer/type :answer.type/math :answer/value "160\\,\\text{min/week}" :db/ensure [:answer/validate]} {:db/id "answer-1e2988fa-d18c-5b90-ac1c-561062dc8688" :answer/id #uuid "1e2988fa-d18c-5b90-ac1c-561062dc8688" :answer/type :answer.type/math :answer/value "175\\,\\text{min/week}" :db/ensure [:answer/validate]} {:db/id "answer-53097714-c01c-56b3-be37-c288fe7f3d0e" :answer/id #uuid "53097714-c01c-56b3-be37-c288fe7f3d0e" :answer/type :answer.type/math :answer/value "210\\,\\text{min/week}" :db/ensure [:answer/validate]} {:db/id "answer-ea00352a-797f-5364-8b6d-067ce9cbb891" :answer/id #uuid "ea00352a-797f-5364-8b6d-067ce9cbb891" :answer/type :answer.type/math :answer/value "250\\,\\text{min/week}" :db/ensure [:answer/validate]} {:db/id 17592186139599 :tutorial/content "We can use unit conversions to convert from one set of units to another.\n\nFor instance, the speed of sound is approximately $0.34$ kilometers per second. What is this in meters per second? We can find out using the following two steps.\n\n** Step 1: Create a conversion formula.**\n\nWe are given the units $\\dfrac{\\textrm{km}}{\\textrm{s}},$ and we want to convert this into $\\dfrac{\\textrm{m}}{\\textrm{s}}.$ To figure out what we need to multiply by, we can set up an equation to help us:\n\n$$\n\\dfrac{\\textrm{km}}{s}\\cdot\\, \\dfrac{?}{?} = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nWe want to replace $\\textrm{km}$ with $\\textrm{m}.$ To get rid of $\\textrm{km},$ we can put $\\textrm{km}$ in the denominator so that it cancels out:\n\n$$\n\\require{cancel}\n\\dfrac{\\cancel{\\textrm{km}} }{s}\\cdot \\dfrac{?}{\\cancel{ \\textrm{km} } } = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nThen, to introduce $\\textrm{m},$ we can put $\\textrm{m}$ in the numerator:\n\n$$\n\\require{cancel}\n\\dfrac{\\cancel{\\textrm{km}} }{s}\\cdot \\dfrac{\\textrm{m} }{\\cancel{ \\textrm{km} } } = \\dfrac{\\textrm{m}}{\\textrm{s}}\n$$\n\nSo, our conversion formula is\n\n$$\n\\dfrac{\\textrm{km}}{s}\\cdot \\dfrac{\\textrm{m} }{\\textrm{km} } = \\dfrac{\\textrm{m}}{\\textrm{s}}.\n$$\n\n**Step 2: Use the conversion formula.**\n\nNow that we have our conversion formula, we need to determine the correct numbers to use, and apply it.\n\n- The speed that we wish to convert is $0.34 \\, \\dfrac{\\textrm{km}}{\\textrm{s}}.$\n\n- There are $1\\,000$ meters per kilometer.\n\nApplying our conversion formula, we have\n\n$$\n\\begin{aligned}0.34\\,\\frac{\\text{km}}{\\text{s}} & =0.34\\,\\frac{\\text{km}}{\\text{s}}\\cdot 1\\,000\\,\\frac{\\text{m}}{\\text{km}} \\\\  & =(0.34\\cdot 1\\,000)\\,\\frac{\\cancel{\\text{km}}}{\\text{s}}\\cdot \\frac{\\text{m}}{\\cancel{\\text{km}}} \\\\  & =340\\,\\frac{\\text{m}}{\\text{s}}.\\end{aligned}\n$$\n\nThus, the speed of sound is $340$ meters per second." :db/ensure [:tutorial/validate]} {:db/id 17592186138592 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id 17592186179818 :knowledge-point/questions ["question-bea17d69-eb40-57fe-baa2-90eb85105abf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bea17d69-eb40-57fe-baa2-90eb85105abf" :question/id #uuid "bea17d69-eb40-57fe-baa2-90eb85105abf" :question/math-academy-id "q-60197" :question/problem "In an electronics store, the ratio of the number of cell phones to the total number of gadgets sold (cell phones and computers) is $\\frac{8}{11}.$ If $16$ cell phones were sold in a week, how many computers were sold?" :question/worked-solution "We are given that the ratio of the number of cell phones sold to the number of gadgets (cell phones and computers) sold is $\\frac{8}{11}.$\n\nIn this fraction, the numerator represents the number of cell phones sold and the denominator represents the number of cell phones and computers sold.\n\nWe can make a numerator of $16$ by multiplying the numerator and denominator by $2:$\n\n$$\n\\frac{8\\times 2}{11\\times 2}=\\frac{16}{22}\n$$\n\nTherefore, the number of cell phones and computers sold that week was $22.$ Of this amount, the number of computers sold was\n\n$$\n22-16=6.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c50e1709-fb35-5c84-a6d5-30b4b5bd93b8"] :db/ensure [:question/validate]} {:db/id "answer-field-c50e1709-fb35-5c84-a6d5-30b4b5bd93b8" :answer-field/id #uuid "c50e1709-fb35-5c84-a6d5-30b4b5bd93b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-70b5c337-134d-5b23-8234-a694bfeab0ab" :answer-field/choices ["answer-dc72bee6-483f-5536-ad4b-5f542ab698ad" "answer-70b5c337-134d-5b23-8234-a694bfeab0ab" "answer-701eba46-6034-5191-b8c0-f4010b286be4" "answer-bff2951a-541e-5f2c-b035-f5b17ef671ea" "answer-5f71bb97-ece8-546e-a7a7-8359437ebda2"] :db/ensure [:answer-field/validate]} {:db/id "answer-dc72bee6-483f-5536-ad4b-5f542ab698ad" :answer/id #uuid "dc72bee6-483f-5536-ad4b-5f542ab698ad" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-70b5c337-134d-5b23-8234-a694bfeab0ab" :answer/id #uuid "70b5c337-134d-5b23-8234-a694bfeab0ab" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-701eba46-6034-5191-b8c0-f4010b286be4" :answer/id #uuid "701eba46-6034-5191-b8c0-f4010b286be4" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-bff2951a-541e-5f2c-b035-f5b17ef671ea" :answer/id #uuid "bff2951a-541e-5f2c-b035-f5b17ef671ea" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-5f71bb97-ece8-546e-a7a7-8359437ebda2" :answer/id #uuid "5f71bb97-ece8-546e-a7a7-8359437ebda2" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186179817 :knowledge-point/questions ["question-7dd5c31e-e5f0-51dc-a3ec-12e73e8808ee"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7dd5c31e-e5f0-51dc-a3ec-12e73e8808ee" :question/id #uuid "7dd5c31e-e5f0-51dc-a3ec-12e73e8808ee" :question/math-academy-id "q-147064" :question/problem "The ratio of sheep to goats in Manuel's herd is $3:1.$\nIf Manuel has $30$ sheep, how many animals are in the herd in total?" :question/worked-solution "We start with the ratio $3:1$ and write it as a fraction:\n\n$$\n\\frac{3}{1}\n$$\n\nIn this fraction, the numerator represents the number of sheep, and the denominator represents the number of goats.\n\nWe can make a numerator of $30$ by multiplying the numerator and denominator by $10:$\n\n$$\n\\frac{3\\times 10}{1\\times 10}=\\frac{30}{10}\n$$\n\nTherefore, Manuel has $30$ sheep and $10$ goats. So, the total number of animals in the herd is \n\n$$\n30+10=40.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d304b13f-6fc1-5cd7-bca3-7aa0d027956e"] :db/ensure [:question/validate]} {:db/id "answer-field-d304b13f-6fc1-5cd7-bca3-7aa0d027956e" :answer-field/id #uuid "d304b13f-6fc1-5cd7-bca3-7aa0d027956e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eddc115b-1150-555f-bd2f-52f8639641ce" :answer-field/choices ["answer-33b33412-cf90-51cd-bf23-bd54dfd122f5" "answer-29fbf3dc-a47e-54b1-bcf8-7e68c453ce58" "answer-635a14ed-c473-5b21-9e9c-024325325da0" "answer-eddc115b-1150-555f-bd2f-52f8639641ce" "answer-d4530301-1e8c-5fda-aec9-3766286b1b3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-33b33412-cf90-51cd-bf23-bd54dfd122f5" :answer/id #uuid "33b33412-cf90-51cd-bf23-bd54dfd122f5" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-29fbf3dc-a47e-54b1-bcf8-7e68c453ce58" :answer/id #uuid "29fbf3dc-a47e-54b1-bcf8-7e68c453ce58" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-635a14ed-c473-5b21-9e9c-024325325da0" :answer/id #uuid "635a14ed-c473-5b21-9e9c-024325325da0" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-eddc115b-1150-555f-bd2f-52f8639641ce" :answer/id #uuid "eddc115b-1150-555f-bd2f-52f8639641ce" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-d4530301-1e8c-5fda-aec9-3766286b1b3a" :answer/id #uuid "d4530301-1e8c-5fda-aec9-3766286b1b3a" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "activity-23866e55-455f-5349-a24f-744eddf74337" :activity/id #uuid "23866e55-455f-5349-a24f-744eddf74337" :activity/title "Further Reasoning With Equivalent Ratios" :activity/type :activity.type/review :activity/scope 17592186049495 :activity/course 17592186046647 :activity/steps ["step-351d27f8-ae58-54cf-867a-22cc22f2bf67" "step-fe452996-f813-52b6-bce9-784c946d6846" "step-c440cbf8-556c-5d78-8335-881bde443fbb"] :activity/first-step "step-351d27f8-ae58-54cf-867a-22cc22f2bf67" :db/ensure [:activity/validate]} {:db/id "step-351d27f8-ae58-54cf-867a-22cc22f2bf67" :step/id #uuid "351d27f8-ae58-54cf-867a-22cc22f2bf67" :step/content 17592186180233 :step/next "step-fe452996-f813-52b6-bce9-784c946d6846" :db/ensure [:step/validate]} {:db/id "step-fe452996-f813-52b6-bce9-784c946d6846" :step/id #uuid "fe452996-f813-52b6-bce9-784c946d6846" :step/content "question-bea17d69-eb40-57fe-baa2-90eb85105abf" :step/next "step-c440cbf8-556c-5d78-8335-881bde443fbb" :db/ensure [:step/validate]} {:db/id "step-c440cbf8-556c-5d78-8335-881bde443fbb" :step/id #uuid "c440cbf8-556c-5d78-8335-881bde443fbb" :step/content "question-7dd5c31e-e5f0-51dc-a3ec-12e73e8808ee" :db/ensure [:step/validate]} {:db/id 17592186054611 :knowledge-point/questions ["question-0dffdb23-4e19-5e3b-9c5d-b76e7cdb23fa"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186234092 :question/answer-fields ["answer-field-46b5e342-2f59-5f17-97d7-60225f6e5208"] :db/ensure [:question/validate]} {:db/id "answer-field-46b5e342-2f59-5f17-97d7-60225f6e5208" :answer-field/id #uuid "46b5e342-2f59-5f17-97d7-60225f6e5208" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ae50b601-00f2-5d2d-862d-a236109f9bed" :answer-field/choices ["answer-ae50b601-00f2-5d2d-862d-a236109f9bed" "answer-574a7f7b-4e6e-5629-b9e0-03d3d14a8260" "answer-0232f6d1-cc47-55de-8533-bead91016a51" "answer-3581fa24-c005-5f7c-a7ef-a44af78898c7" "answer-cb4ed9aa-c01d-5794-9c67-4387dd7bdb77"] :db/ensure [:answer-field/validate]} {:db/id "answer-ae50b601-00f2-5d2d-862d-a236109f9bed" :answer/id #uuid "ae50b601-00f2-5d2d-862d-a236109f9bed" :answer/type :answer.type/math :answer/value "-33" :db/ensure [:answer/validate]} {:db/id "answer-574a7f7b-4e6e-5629-b9e0-03d3d14a8260" :answer/id #uuid "574a7f7b-4e6e-5629-b9e0-03d3d14a8260" :answer/type :answer.type/math :answer/value "-41" :db/ensure [:answer/validate]} {:db/id "answer-0232f6d1-cc47-55de-8533-bead91016a51" :answer/id #uuid "0232f6d1-cc47-55de-8533-bead91016a51" :answer/type :answer.type/math :answer/value "-77" :db/ensure [:answer/validate]} {:db/id "answer-3581fa24-c005-5f7c-a7ef-a44af78898c7" :answer/id #uuid "3581fa24-c005-5f7c-a7ef-a44af78898c7" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "answer-cb4ed9aa-c01d-5794-9c67-4387dd7bdb77" :answer/id #uuid "cb4ed9aa-c01d-5794-9c67-4387dd7bdb77" :answer/type :answer.type/math :answer/value "77" :db/ensure [:answer/validate]} {:db/id "question-0dffdb23-4e19-5e3b-9c5d-b76e7cdb23fa" :question/id #uuid "0dffdb23-4e19-5e3b-9c5d-b76e7cdb23fa" :question/math-academy-id "q-66419" :question/problem "Given $f(x)=8{x}^{2}+1$ and $g(x)=2x-2,$ find  $(fg)(1).$" :question/worked-solution "The notation $(fg)(x)$ means  the product of the functions  $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(fg)(1),$ we find $f(1)$ and $g(1),$ and then multiply the results.\n\nFirst, we find $f(1)$ and $g(1):$\n\n$$\n\\begin{aligned}f(1) & =8(1)^{2}+1=9 \\\\ g(1) & =2(1)-2=0\\end{aligned}\n$$\n\n \n\nNow, we multiply the results:\n\n$$\n(fg)(1)=f(1)g(1)=9\\cdot 0=0\n$$\n\n**Method 2**\n\nFirst, we find $(fg)(x)$ by multiplying the two functions:\n\n$$\n\\begin{aligned}(fg)(x) & =(8{x}^{2}+1)(2x-2) \\\\  & =16{x}^{3}-16{x}^{2}+2x-2\\end{aligned}\n$$\n\nNow, we evaluate $(fg)(1):$ \n\n$$\n\\begin{aligned}(fg)(1) & =16(1)^{3}-16(1)^{2}+2(1)-2 \\\\  & =16-16+2-2 \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ff0d330b-f0bf-5ed3-9055-16241719d8a0"] :db/ensure [:question/validate]} {:db/id "answer-field-ff0d330b-f0bf-5ed3-9055-16241719d8a0" :answer-field/id #uuid "ff0d330b-f0bf-5ed3-9055-16241719d8a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5c4f1670-871c-59ee-8a82-19f3fd41d372" :answer-field/choices ["answer-5c4f1670-871c-59ee-8a82-19f3fd41d372" "answer-b56a0556-d0b6-58d1-ae92-072bdafe84ad" "answer-4cc163ae-67c3-5dbb-9c2e-df65985cece8" "answer-c9da03d1-95db-5bd2-ac01-db50a9b70c37" "answer-7d98d607-1295-57e0-82a2-4957c73eb6f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c4f1670-871c-59ee-8a82-19f3fd41d372" :answer/id #uuid "5c4f1670-871c-59ee-8a82-19f3fd41d372" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b56a0556-d0b6-58d1-ae92-072bdafe84ad" :answer/id #uuid "b56a0556-d0b6-58d1-ae92-072bdafe84ad" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-4cc163ae-67c3-5dbb-9c2e-df65985cece8" :answer/id #uuid "4cc163ae-67c3-5dbb-9c2e-df65985cece8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-c9da03d1-95db-5bd2-ac01-db50a9b70c37" :answer/id #uuid "c9da03d1-95db-5bd2-ac01-db50a9b70c37" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-7d98d607-1295-57e0-82a2-4957c73eb6f9" :answer/id #uuid "7d98d607-1295-57e0-82a2-4957c73eb6f9" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186054612 :knowledge-point/questions ["question-76e8734a-ae7e-5bfd-82cf-840027d7b221"] :db/ensure [:knowledge-point/validate]} {:db/id "question-76e8734a-ae7e-5bfd-82cf-840027d7b221" :question/id #uuid "76e8734a-ae7e-5bfd-82cf-840027d7b221" :question/math-academy-id "q-66437" :question/problem "Given $f(x)={x}^{2}-4$ and $g(x)=2x+2,$ find  $(f/g)(2).$" :question/worked-solution "The notation $(f/g)(x)$ means the quotient of the functions $f(x)$ and $g(x).$\n\n**Method 1**\n\nTo evaluate $(f/g)(2),$ we find $f(2)$ and $g(2),$ and then divide the results.\n\nFirst, we find $f(2)$ and $g(2):$\n\n$$\n\\begin{aligned}f(2) & =(2)^{2}-4=0 \\\\ g(2) & =2(2)+2=6\\end{aligned}\n$$\n\n \n\nNow, we divide the results:\n\n$$\n(f/g)(2)=\\frac{f(2)}{g(2)}=\\frac{0}{6}=0\n$$\n\n**Method 2**\n\nFirst, we find $(f/g)(x)$ by dividing $f$ by $g$:\n\n$$\n\\begin{aligned}(f/g)(x)=\\frac{{x}^{2}-4}{2x+2}\\end{aligned}\n$$\n\nNow, we evaluate $(f/g)(2):$  \n\n$$\n\\begin{aligned}(f/g)(2) & =\\frac{(2)^{2}-4}{2(2)+2}=\\frac{0}{6}=0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b0def8c5-0e76-5633-984d-4a0398a720ad"] :db/ensure [:question/validate]} {:db/id "answer-field-b0def8c5-0e76-5633-984d-4a0398a720ad" :answer-field/id #uuid "b0def8c5-0e76-5633-984d-4a0398a720ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer-field/choices ["answer-2045e6fa-2eac-591c-966c-1fdb56bcfe80" "answer-02da732e-8f8f-522b-a0af-c292550ebd0e" "answer-7eaec706-9934-5e79-9ce3-c47dee2c41e0" "answer-5f02d874-962f-54b5-b78b-81b45af705f6" "answer-12fd6f4f-4886-505e-ae42-dc7cc6984c42"] :db/ensure [:answer-field/validate]} {:db/id "answer-2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer/id #uuid "2045e6fa-2eac-591c-966c-1fdb56bcfe80" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-02da732e-8f8f-522b-a0af-c292550ebd0e" :answer/id #uuid "02da732e-8f8f-522b-a0af-c292550ebd0e" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-7eaec706-9934-5e79-9ce3-c47dee2c41e0" :answer/id #uuid "7eaec706-9934-5e79-9ce3-c47dee2c41e0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-5f02d874-962f-54b5-b78b-81b45af705f6" :answer/id #uuid "5f02d874-962f-54b5-b78b-81b45af705f6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-12fd6f4f-4886-505e-ae42-dc7cc6984c42" :answer/id #uuid "12fd6f4f-4886-505e-ae42-dc7cc6984c42" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id "activity-7ce49917-85e7-5228-8878-60a8c1f29960" :activity/id #uuid "7ce49917-85e7-5228-8878-60a8c1f29960" :activity/title "The Arithmetic of Functions" :activity/type :activity.type/review :activity/scope 17592186050782 :activity/course 17592186046647 :activity/steps ["step-dbee05de-3d07-576a-9368-57acc32e5170" "step-8915ea14-a53d-5e03-ae86-339fcc7361b9" "step-c74026d0-f786-50c1-b154-b7d927f144aa" "step-f577bcab-36ae-5324-94f9-2ea6a15c229b"] :activity/first-step "step-dbee05de-3d07-576a-9368-57acc32e5170" :db/ensure [:activity/validate]} {:db/id "step-dbee05de-3d07-576a-9368-57acc32e5170" :step/id #uuid "dbee05de-3d07-576a-9368-57acc32e5170" :step/content 17592186234092 :step/next "step-8915ea14-a53d-5e03-ae86-339fcc7361b9" :db/ensure [:step/validate]} {:db/id "step-8915ea14-a53d-5e03-ae86-339fcc7361b9" :step/id #uuid "8915ea14-a53d-5e03-ae86-339fcc7361b9" :step/content "question-0dffdb23-4e19-5e3b-9c5d-b76e7cdb23fa" :step/next "step-c74026d0-f786-50c1-b154-b7d927f144aa" :db/ensure [:step/validate]} {:db/id "step-c74026d0-f786-50c1-b154-b7d927f144aa" :step/id #uuid "c74026d0-f786-50c1-b154-b7d927f144aa" :step/content 17592186234199 :step/next "step-f577bcab-36ae-5324-94f9-2ea6a15c229b" :db/ensure [:step/validate]} {:db/id "step-f577bcab-36ae-5324-94f9-2ea6a15c229b" :step/id #uuid "f577bcab-36ae-5324-94f9-2ea6a15c229b" :step/content "question-76e8734a-ae7e-5bfd-82cf-840027d7b221" :db/ensure [:step/validate]} [:db/retract 17592186165470 :answer-field/choices 17592186165472] [:db/retract 17592186165470 :answer-field/choices 17592186165473] [:db/retract 17592186165470 :answer-field/choices 17592186165474] [:db/retract 17592186165470 :answer-field/choices 17592186165475] [:db/retract 17592186165470 :answer-field/choices 17592186165471] {:db/id 17592186166754 :knowledge-point/questions ["question-2c958fbe-a6a3-5e35-b0a4-3549e7aa33c5" "question-ca24054b-57db-5111-abb2-9a1c0e62e7da" "question-a4eeca3f-6b34-52eb-84b0-9a3e73ae1349" "question-aa4e4da2-fcbb-5aa7-a6f1-72dee8a3b1b4" "question-02e5e578-2923-57b2-a053-9b7f26dd5f2f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166592 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = 2\\arsinh{x^2},$ then find $\\dfrac {\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh x) = \\dfrac{1}{\\sqrt{x^2+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2\\operatorname{arsinh}⁡{x}^{2}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡{x}^{2}) \\\\  & =2\\cdot \\frac{1}{\\sqrt{{({x}^{2})}^{2}+1}}\\cdot {({x}^{2})}^{′} \\\\  & =2\\cdot \\frac{1}{\\sqrt{{x}^{4}+1}}\\cdot 2x \\\\  & =\\frac{4x}{\\sqrt{{x}^{4}+1}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166755 :knowledge-point/questions ["question-d4997d00-7652-5cc7-a200-60025211209a" "question-f7d6b312-8b7a-5ed1-a8f0-4e6a0733fe64" "question-18d061e8-8362-58bf-a0a8-8ae72383d1a4" "question-1e29259a-0f4e-5a3f-8104-feccbcb01883"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166593 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y =\\arcosh(x+1),$ then find $\\dfrac {\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic cosine function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcosh x) = \\dfrac{1}{\\sqrt{x^2-1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡(x+1)) \\\\  & =\\frac{1}{\\sqrt{(x+1)^{2}-1}}\\cdot (x+1)^{′} \\\\  & =\\frac{1}{\\sqrt{({x}^{2}+2x+1)-1}}\\cdot 1 \\\\  & =\\frac{1}{\\sqrt{{x}^{2}+2x}} \\\\  & =\\frac{1}{\\sqrt{x(x+2)}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166756 :knowledge-point/questions ["question-4b8c9d43-7595-500c-b3ee-cac3fe18402d" "question-032db788-5417-5a60-9bc5-91af6b1ca366" "question-bc18352d-fce3-5063-b58a-47ac19e5cf8d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166594 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $y = \\artanh{4x},$ then find $\\dfrac {\\textrm{d}y}{\\textrm{d}x}.$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nThe formula for the derivative of the inverse hyperbolic tangent function is\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\artanh x) = \\dfrac{1}{1-x^2}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡4x) \\\\  & =\\frac{1}{1-{(4x)}^{2}}\\cdot {(4x)}^{′} \\\\  & =\\frac{1}{1-16{x}^{2}}\\cdot 4 \\\\  & =\\frac{4}{1-16{x}^{2}}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186166595 :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nIf $w(x) = e^{2x}\\artanh{x},$ then $w'(x)=2e^{2x}\\artanh{x} + y(x).$ What is $y(x)?$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nHere, we have the product of two functions $u(x) = e^{2x}$ and $v(x)=\\artanh{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{w}^{′}(x) & ={({e}^{2x})}^{′}\\cdot \\operatorname{artanh}⁡x+{e}^{2x}\\cdot {(\\operatorname{artanh}⁡x)}^{′} \\\\  & =2{e}^{2x}\\cdot \\operatorname{artanh}⁡x+{e}^{2x}\\cdot \\frac{1}{1-{x}^{2}} \\\\  & =2{e}^{2x}\\operatorname{artanh}⁡x+{{\\frac{{e}^{2x}}{1-{x}^{2}}}_{⏟}}_{y(x)}\\end{aligned}\n$$\n\nTherefore, $y(x) = \\dfrac{e^{2x}}{1 - x^2}.$" :db/ensure [:question/validate]} {:db/id "question-2c958fbe-a6a3-5e35-b0a4-3549e7aa33c5" :question/id #uuid "2c958fbe-a6a3-5e35-b0a4-3549e7aa33c5" :question/math-academy-id "q-95419" :question/problem "$$\n\nIf $y=\\frac{1}{4}\\operatorname{arsinh}⁡2{x}^{2},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}\\operatorname{arsinh}⁡2{x}^{2}) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡2{x}^{2}) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{\\sqrt{{(2{x}^{2})}^{2}+1}}\\cdot {(2{x}^{2})}^{′} \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{\\sqrt{4{x}^{4}+1}}\\cdot 4x \\\\  & =\\frac{x}{\\sqrt{4{x}^{4}+1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-de980059-9619-56fd-bc0c-0fa09f73dc66"] :db/ensure [:question/validate]} {:db/id "answer-field-de980059-9619-56fd-bc0c-0fa09f73dc66" :answer-field/id #uuid "de980059-9619-56fd-bc0c-0fa09f73dc66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a924941b-e8c9-5ed5-80b8-ad7a06f41304" :answer-field/choices ["answer-d46dfd71-e586-55eb-8c97-07a1e7452b66" "answer-292e7bbd-999c-520e-bb6b-1e42da3fa632" "answer-fa1af559-472b-5b48-b982-a14b98c054ca" "answer-795d6440-8fe5-57dc-ae9c-d5da35732f54" "answer-a924941b-e8c9-5ed5-80b8-ad7a06f41304"] :db/ensure [:answer-field/validate]} {:db/id "answer-d46dfd71-e586-55eb-8c97-07a1e7452b66" :answer/id #uuid "d46dfd71-e586-55eb-8c97-07a1e7452b66" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{4{x}^{4}+1}}" :db/ensure [:answer/validate]} {:db/id "answer-292e7bbd-999c-520e-bb6b-1e42da3fa632" :answer/id #uuid "292e7bbd-999c-520e-bb6b-1e42da3fa632" :answer/type :answer.type/math :answer/value "\\frac{2x}{\\sqrt{4{x}^{4}+1}}" :db/ensure [:answer/validate]} {:db/id "answer-fa1af559-472b-5b48-b982-a14b98c054ca" :answer/id #uuid "fa1af559-472b-5b48-b982-a14b98c054ca" :answer/type :answer.type/math :answer/value "\\frac{4x}{\\sqrt{{x}^{4}+1}}" :db/ensure [:answer/validate]} {:db/id "answer-795d6440-8fe5-57dc-ae9c-d5da35732f54" :answer/id #uuid "795d6440-8fe5-57dc-ae9c-d5da35732f54" :answer/type :answer.type/math :answer/value "\\frac{4}{\\sqrt{{x}^{4}+1}}" :db/ensure [:answer/validate]} {:db/id "answer-a924941b-e8c9-5ed5-80b8-ad7a06f41304" :answer/id #uuid "a924941b-e8c9-5ed5-80b8-ad7a06f41304" :answer/type :answer.type/math :answer/value "\\frac{x}{\\sqrt{4{x}^{4}+1}}" :db/ensure [:answer/validate]} {:db/id "question-ca24054b-57db-5111-abb2-9a1c0e62e7da" :question/id #uuid "ca24054b-57db-5111-abb2-9a1c0e62e7da" :question/math-academy-id "q-95428" :question/problem "$$\n\nIf $y=6\\operatorname{arsinh}⁡(\\frac{x}{2}),$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(6\\operatorname{arsinh}⁡(\\frac{x}{2})) \\\\  & =6\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡(\\frac{x}{2})) \\\\  & =6\\cdot \\frac{1}{\\sqrt{{(\\frac{x}{2})}^{2}+1}}\\cdot {(\\frac{x}{2})}^{′} \\\\  & =6\\cdot \\frac{1}{\\sqrt{\\frac{{x}^{2}}{4}+1}}\\cdot \\frac{1}{2} \\\\  & =\\frac{6}{\\sqrt{{x}^{2}+4}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-71b3a12d-2d4a-5204-9a4e-bc2880e6dedc"] :db/ensure [:question/validate]} {:db/id "answer-field-71b3a12d-2d4a-5204-9a4e-bc2880e6dedc" :answer-field/id #uuid "71b3a12d-2d4a-5204-9a4e-bc2880e6dedc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16d48108-d2d6-587b-bfe3-2ffd1073736d" :answer-field/choices ["answer-5cf03bd5-254e-5534-bc31-f8df36341221" "answer-2606f266-1daa-5d7d-8ca5-771dec8b5b33" "answer-f6449119-7803-5c83-b8f8-f21cb84631f8" "answer-a54621c5-4d43-5cff-83c2-5c5c66d64ab5" "answer-16d48108-d2d6-587b-bfe3-2ffd1073736d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5cf03bd5-254e-5534-bc31-f8df36341221" :answer/id #uuid "5cf03bd5-254e-5534-bc31-f8df36341221" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt{{x}^{2}+4}}" :db/ensure [:answer/validate]} {:db/id "answer-2606f266-1daa-5d7d-8ca5-771dec8b5b33" :answer/id #uuid "2606f266-1daa-5d7d-8ca5-771dec8b5b33" :answer/type :answer.type/math :answer/value "\\frac{3x}{\\sqrt{{x}^{2}+4}}" :db/ensure [:answer/validate]} {:db/id "answer-f6449119-7803-5c83-b8f8-f21cb84631f8" :answer/id #uuid "f6449119-7803-5c83-b8f8-f21cb84631f8" :answer/type :answer.type/math :answer/value "\\frac{4}{\\sqrt{{x}^{2}+2}}" :db/ensure [:answer/validate]} {:db/id "answer-a54621c5-4d43-5cff-83c2-5c5c66d64ab5" :answer/id #uuid "a54621c5-4d43-5cff-83c2-5c5c66d64ab5" :answer/type :answer.type/math :answer/value "\\frac{6}{\\sqrt{{x}^{2}+1}}" :db/ensure [:answer/validate]} {:db/id "answer-16d48108-d2d6-587b-bfe3-2ffd1073736d" :answer/id #uuid "16d48108-d2d6-587b-bfe3-2ffd1073736d" :answer/type :answer.type/math :answer/value "\\frac{6}{\\sqrt{{x}^{2}+4}}" :db/ensure [:answer/validate]} {:db/id "question-a4eeca3f-6b34-52eb-84b0-9a3e73ae1349" :question/id #uuid "a4eeca3f-6b34-52eb-84b0-9a3e73ae1349" :question/math-academy-id "q-341812" :question/problem "$$\n\nIf $y=arsinh\\,(\\frac{x-3}{3}),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| $\\text{d}y$ | $=$ | $1$ |\n| --- | --- | --- |\n| $\\text{d}x$ |  | {{field-1}} |" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}\\,(arsinh\\,(\\frac{x-3}{3})) \\\\  & =\\frac{1}{\\sqrt{{(\\frac{x-3}{3})}^{2}+1}}\\cdot {(\\frac{x-3}{3})}^{′} \\\\  & =\\frac{1}{\\sqrt{\\frac{(x-3)^{2}}{9}+1}}\\cdot \\frac{1}{3} \\\\  & =\\frac{1}{3\\sqrt{\\frac{(x-3)^{2}+9}{9}}} \\\\  & =\\frac{1}{\\sqrt{(x-3)^{2}+9}} \\\\  & =\\frac{1}{\\sqrt{({x}^{2}-6x+9)+9}} \\\\  & =\\frac{1}{\\sqrt{{x}^{2}-6x+18}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5a6982d7-16d9-5cb0-8eec-9bbb54099cee"] :db/ensure [:question/validate]} {:db/id "answer-field-5a6982d7-16d9-5cb0-8eec-9bbb54099cee" :answer-field/id #uuid "5a6982d7-16d9-5cb0-8eec-9bbb54099cee" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ce1e87fa-a67e-5e2b-a4d6-91106614efde" :answer-field/choices ["answer-ce1e87fa-a67e-5e2b-a4d6-91106614efde"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce1e87fa-a67e-5e2b-a4d6-91106614efde" :answer/id #uuid "ce1e87fa-a67e-5e2b-a4d6-91106614efde" :answer/type :answer.type/math :answer/value "\\sqrt{{x}^{2}-6x+18}" :db/ensure [:answer/validate]} {:db/id "question-aa4e4da2-fcbb-5aa7-a6f1-72dee8a3b1b4" :question/id #uuid "aa4e4da2-fcbb-5aa7-a6f1-72dee8a3b1b4" :question/math-academy-id "q-341820" :question/problem "$$\n\nIf $y=3\\operatorname{arsinh}⁡(\\frac{2}{3}{x}^{4}),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n| $\\text{d}y$ | $=$ | $24{x}^{3}$ |\n| --- | --- | --- |\n| $\\text{d}x$ |  | {{field-1}} |" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{arsinh}⁡(\\frac{2}{3}{x}^{4})) \\\\  & =3\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡(\\frac{2}{3}{x}^{4})) \\\\  & =3\\cdot \\frac{1}{\\sqrt{{(\\frac{2}{3}{x}^{4})}^{2}+1}}\\cdot {(\\frac{2}{3}{x}^{4})}^{′} \\\\  & =3\\cdot \\frac{1}{\\sqrt{\\frac{4}{9}{x}^{8}+1}}\\cdot \\frac{8}{3}{x}^{3} \\\\  & =8\\cdot \\frac{{x}^{3}}{\\sqrt{\\frac{4{x}^{8}+9}{9}}} \\\\  & =\\frac{24{x}^{3}}{\\sqrt{4{x}^{8}+9}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6349b651-0355-5796-8a79-80d15ad9f15e"] :db/ensure [:question/validate]} {:db/id "answer-field-6349b651-0355-5796-8a79-80d15ad9f15e" :answer-field/id #uuid "6349b651-0355-5796-8a79-80d15ad9f15e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a559b83c-53ab-5a83-9edd-ae76985624bd" :answer-field/choices ["answer-a559b83c-53ab-5a83-9edd-ae76985624bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-a559b83c-53ab-5a83-9edd-ae76985624bd" :answer/id #uuid "a559b83c-53ab-5a83-9edd-ae76985624bd" :answer/type :answer.type/math :answer/value "\\sqrt{4x^8+9}" :db/ensure [:answer/validate]} {:db/id "question-02e5e578-2923-57b2-a053-9b7f26dd5f2f" :question/id #uuid "02e5e578-2923-57b2-a053-9b7f26dd5f2f" :question/math-academy-id "q-341798" :question/problem "$$\n\nIf $y=5\\operatorname{arsinh}⁡(3x),$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$\n\n$\\frac{\\text{d}y}{\\text{d}x}=$\n{{field-1}}" :question/worked-solution "$$\n\nThe formula for the derivative of the inverse hyperbolic sine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}+1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{arsinh}⁡(3x)) \\\\  & =5\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arsinh}⁡(3x)) \\\\  & =5\\cdot \\frac{1}{\\sqrt{(3x)^{2}+1}}\\cdot (3x)^{′} \\\\  & =5\\cdot \\frac{1}{\\sqrt{9{x}^{2}+1}}\\cdot 3 \\\\  & =\\frac{15}{\\sqrt{9{x}^{2}+1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4549f7e1-46e1-5da6-bdca-f119837ee94a"] :db/ensure [:question/validate]} {:db/id "answer-field-4549f7e1-46e1-5da6-bdca-f119837ee94a" :answer-field/id #uuid "4549f7e1-46e1-5da6-bdca-f119837ee94a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8a6c5edf-783c-518f-ae3c-3b3aa9ea7ef9" :answer-field/choices ["answer-8a6c5edf-783c-518f-ae3c-3b3aa9ea7ef9"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a6c5edf-783c-518f-ae3c-3b3aa9ea7ef9" :answer/id #uuid "8a6c5edf-783c-518f-ae3c-3b3aa9ea7ef9" :answer/type :answer.type/math :answer/value "\\frac{15}{\\sqrt{9x^2+1}}" :db/ensure [:answer/validate]} {:db/id "question-d4997d00-7652-5cc7-a200-60025211209a" :question/id #uuid "d4997d00-7652-5cc7-a200-60025211209a" :question/math-academy-id "q-95504" :question/problem "$$\n\nIf $y=\\frac{3}{2}\\operatorname{arcosh}⁡2{x}^{2},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic cosine function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{arcosh}⁡2{x}^{2}) \\\\  & =\\frac{3}{2}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡2{x}^{2}) \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{\\sqrt{{(2{x}^{2})}^{2}-1}}\\cdot {(2{x}^{2})}^{′} \\\\  & =\\frac{3}{2}\\cdot \\frac{1}{\\sqrt{4{x}^{4}-1}}\\cdot 4x \\\\  & =\\frac{6x}{\\sqrt{4{x}^{4}-1}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ae6ae2c8-5130-53cc-bb64-372c2f7de751"] :db/ensure [:question/validate]} {:db/id "answer-field-ae6ae2c8-5130-53cc-bb64-372c2f7de751" :answer-field/id #uuid "ae6ae2c8-5130-53cc-bb64-372c2f7de751" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c55de174-20a2-5857-a097-babc7925bbfa" :answer-field/choices ["answer-31172cf1-3a3e-5cb6-afa8-4b91537a5882" "answer-a35fde23-056b-5940-8d9a-cc873ac086d8" "answer-179a74a5-b3d8-5e7a-9c3e-5819837efef1" "answer-c55de174-20a2-5857-a097-babc7925bbfa" "answer-43ac0f87-1caa-5c8f-989a-102c5cc7de2c"] :db/ensure [:answer-field/validate]} {:db/id "answer-31172cf1-3a3e-5cb6-afa8-4b91537a5882" :answer/id #uuid "31172cf1-3a3e-5cb6-afa8-4b91537a5882" :answer/type :answer.type/math :answer/value "\\frac{2x}{\\sqrt{4{x}^{4}-1}}" :db/ensure [:answer/validate]} {:db/id "answer-a35fde23-056b-5940-8d9a-cc873ac086d8" :answer/id #uuid "a35fde23-056b-5940-8d9a-cc873ac086d8" :answer/type :answer.type/math :answer/value "\\frac{3x}{\\sqrt{2{x}^{2}-1}}" :db/ensure [:answer/validate]} {:db/id "answer-179a74a5-b3d8-5e7a-9c3e-5819837efef1" :answer/id #uuid "179a74a5-b3d8-5e7a-9c3e-5819837efef1" :answer/type :answer.type/math :answer/value "\\frac{6x}{\\sqrt{4{x}^{4}+1}}" :db/ensure [:answer/validate]} {:db/id "answer-c55de174-20a2-5857-a097-babc7925bbfa" :answer/id #uuid "c55de174-20a2-5857-a097-babc7925bbfa" :answer/type :answer.type/math :answer/value "\\frac{6x}{\\sqrt{4{x}^{4}-1}}" :db/ensure [:answer/validate]} {:db/id "answer-43ac0f87-1caa-5c8f-989a-102c5cc7de2c" :answer/id #uuid "43ac0f87-1caa-5c8f-989a-102c5cc7de2c" :answ