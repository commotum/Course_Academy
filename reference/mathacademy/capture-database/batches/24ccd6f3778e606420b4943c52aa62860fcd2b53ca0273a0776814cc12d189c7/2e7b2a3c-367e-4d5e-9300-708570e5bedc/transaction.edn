 [:step/validate]} {:db/id "step-591850ba-9970-5a8d-bf3a-764546c77c4d" :step/id #uuid "591850ba-9970-5a8d-bf3a-764546c77c4d" :step/content 17592186162348 :step/next "step-669edee2-ccb2-50da-8e3b-99ebbeee39b7" :db/ensure [:step/validate]} {:db/id "step-669edee2-ccb2-50da-8e3b-99ebbeee39b7" :step/id #uuid "669edee2-ccb2-50da-8e3b-99ebbeee39b7" :step/content 17592186371790 :step/next "step-4eba4deb-ed0f-515b-a345-779312604459" :db/ensure [:step/validate]} {:db/id "step-4eba4deb-ed0f-515b-a345-779312604459" :step/id #uuid "4eba4deb-ed0f-515b-a345-779312604459" :step/content 17592186420791 :step/next "step-ac1e0a61-7b66-5421-b09e-c861aaca5832" :db/ensure [:step/validate]} {:db/id "step-ac1e0a61-7b66-5421-b09e-c861aaca5832" :step/id #uuid "ac1e0a61-7b66-5421-b09e-c861aaca5832" :step/content 17592186420792 :db/ensure [:step/validate]} [:db/retract 17592186180010 :question/answer-fields 17592186177729] {:db/id 17592186059865 :knowledge-point/questions ["question-cd92c8db-d853-53b3-99d2-6ad9bcebe052" "question-a746a92c-9180-5bad-bfc6-5ca557baf9cb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cd92c8db-d853-53b3-99d2-6ad9bcebe052" :question/id #uuid "cd92c8db-d853-53b3-99d2-6ad9bcebe052" :question/math-academy-id "q-1861" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=-4+2{x}^{7}-12{x}^{2}+{x}^{5/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-4+2{x}^{7}-12{x}^{2}+{x}^{5/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-4)+\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})-\\frac{\\text{d}}{\\text{d}x}(12{x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{5/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-4)+2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{7})-12\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{5/4}) \\\\  & =0+2\\cdot 7{x}^{(7-1)}-12\\cdot 2{x}^{(2-1)}+\\frac{5}{4}\\cdot {x}^{(\\frac{5}{4}-1)} \\\\  & =14{x}^{6}-24x+\\frac{5}{4}{x}^{1/4} \\\\  & =14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ba01c00d-e4ab-58b9-976c-4280882e9d75"] :db/ensure [:question/validate]} {:db/id "answer-field-ba01c00d-e4ab-58b9-976c-4280882e9d75" :answer-field/id #uuid "ba01c00d-e4ab-58b9-976c-4280882e9d75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-215a3196-aa1e-53fe-ba9a-dd584d06fa02" :answer-field/choices ["answer-cc7fe356-6709-56ff-968f-0b948652e8e0" "answer-8e201c30-afed-5567-a27a-5f1d97078f77" "answer-e3f7bb4e-6f66-5b0b-ba5e-25005bb49ba2" "answer-215a3196-aa1e-53fe-ba9a-dd584d06fa02" "answer-29372cbb-de9f-5045-bc68-a6f3e039aa5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc7fe356-6709-56ff-968f-0b948652e8e0" :answer/id #uuid "cc7fe356-6709-56ff-968f-0b948652e8e0" :answer/type :answer.type/math :answer/value "14{x}^{6}+22x-\\frac{5{x}^{\\frac{1}{4}}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-8e201c30-afed-5567-a27a-5f1d97078f77" :answer/id #uuid "8e201c30-afed-5567-a27a-5f1d97078f77" :answer/type :answer.type/math :answer/value "14{x}^{6}+24x+\\frac{5{x}^{-\\frac{1}{4}}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-e3f7bb4e-6f66-5b0b-ba5e-25005bb49ba2" :answer/id #uuid "e3f7bb4e-6f66-5b0b-ba5e-25005bb49ba2" :answer/type :answer.type/math :answer/value "14{x}^{6}-12{x}^{2}+\\frac{5{x}^{\\frac{1}{2}}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-215a3196-aa1e-53fe-ba9a-dd584d06fa02" :answer/id #uuid "215a3196-aa1e-53fe-ba9a-dd584d06fa02" :answer/type :answer.type/math :answer/value "14{x}^{6}-24x+\\frac{5\\sqrt[4]{x}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-29372cbb-de9f-5045-bc68-a6f3e039aa5d" :answer/id #uuid "29372cbb-de9f-5045-bc68-a6f3e039aa5d" :answer/type :answer.type/math :answer/value "2{x}^{6}-24x+\\frac{5}{4\\sqrt[3]{x}}" :db/ensure [:answer/validate]} {:db/id "question-a746a92c-9180-5bad-bfc6-5ca557baf9cb" :question/id #uuid "a746a92c-9180-5bad-bfc6-5ca557baf9cb" :question/math-academy-id "q-10292" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=2{x}^{7}+\\frac{1}{{x}^{2}}+2x-2.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7}+\\frac{1}{{x}^{2}}+2x-2) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{7})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})+\\frac{\\text{d}}{\\text{d}x}(2x)-\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{7})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})+2\\cdot \\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(2) \\\\  & =2\\cdot 7{x}^{(7-1)}+(-2){x}^{(-2-1)}+2\\cdot 1-0 \\\\  & =14{x}^{6}-2{x}^{-3}+2 \\\\  & =14{x}^{6}-\\frac{2}{{x}^{3}}+2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4419ee0e-8651-52b9-9b46-c0466ee66f3c"] :db/ensure [:question/validate]} {:db/id "answer-field-4419ee0e-8651-52b9-9b46-c0466ee66f3c" :answer-field/id #uuid "4419ee0e-8651-52b9-9b46-c0466ee66f3c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cc1c08e7-f8dc-506c-9813-764d2dd4e5df" :answer-field/choices ["answer-3e200482-d133-5eb7-8136-1d3336aff1e2" "answer-a80acf4a-b6f9-58b9-ac0e-e6ed94b44fb3" "answer-cc1c08e7-f8dc-506c-9813-764d2dd4e5df" "answer-11aebb25-3c41-52e1-bf66-1dcd7ee2ce0c" "answer-a849b7f1-4748-5906-8130-819ebcc7baa6"] :db/ensure [:answer-field/validate]} {:db/id "answer-3e200482-d133-5eb7-8136-1d3336aff1e2" :answer/id #uuid "3e200482-d133-5eb7-8136-1d3336aff1e2" :answer/type :answer.type/math :answer/value "14{x}^{6}+\\frac{2}{{x}^{3}}+2" :db/ensure [:answer/validate]} {:db/id "answer-a80acf4a-b6f9-58b9-ac0e-e6ed94b44fb3" :answer/id #uuid "a80acf4a-b6f9-58b9-ac0e-e6ed94b44fb3" :answer/type :answer.type/math :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-cc1c08e7-f8dc-506c-9813-764d2dd4e5df" :answer/id #uuid "cc1c08e7-f8dc-506c-9813-764d2dd4e5df" :answer/type :answer.type/math :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/ensure [:answer/validate]} {:db/id "answer-11aebb25-3c41-52e1-bf66-1dcd7ee2ce0c" :answer/id #uuid "11aebb25-3c41-52e1-bf66-1dcd7ee2ce0c" :answer/type :answer.type/math :answer/value "14{x}^{6}-\\frac{2}{{x}^{3}}-2" :db/ensure [:answer/validate]} {:db/id "answer-a849b7f1-4748-5906-8130-819ebcc7baa6" :answer/id #uuid "a849b7f1-4748-5906-8130-819ebcc7baa6" :answer/type :answer.type/math :answer/value "7{x}^{6}-\\frac{2}{{x}^{3}}+2" :db/ensure [:answer/validate]} {:db/id 17592186059864 :knowledge-point/questions ["question-8a7a18a3-9c4b-5644-bbba-c016ec6ec070" "question-41b5b51f-ba4d-5684-ad06-c34aebd809fa"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8a7a18a3-9c4b-5644-bbba-c016ec6ec070" :question/id #uuid "8a7a18a3-9c4b-5644-bbba-c016ec6ec070" :question/math-academy-id "q-70507" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{8}-{x}^{3}+\\frac{1}{{x}^{2}}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{8}-{x}^{3}+\\frac{1}{{x}^{2}}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{8})-\\frac{\\text{d}}{\\text{d}x}({x}^{3})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2}) \\\\  & =8{x}^{(8-1)}-3{x}^{(3-1)}+(-2){x}^{-2-1} \\\\  & =8{x}^{7}-3{x}^{2}-2{x}^{-3} \\\\  & =8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-86ad7852-6087-5de6-850f-cd1888a6eb84"] :db/ensure [:question/validate]} {:db/id "answer-field-86ad7852-6087-5de6-850f-cd1888a6eb84" :answer-field/id #uuid "86ad7852-6087-5de6-850f-cd1888a6eb84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db9820bc-9141-5706-b4b9-696ff0f4d463" :answer-field/choices ["answer-cd3b37bf-ff7e-534a-a633-94c74472b5b9" "answer-fdc03597-2e55-5dbe-b2dc-cac7ff614227" "answer-1f7c7324-2c11-5c83-acfa-b2ee47b3214b" "answer-db9820bc-9141-5706-b4b9-696ff0f4d463" "answer-628bae58-14c7-519d-8c7b-b62c7c8633da"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd3b37bf-ff7e-534a-a633-94c74472b5b9" :answer/id #uuid "cd3b37bf-ff7e-534a-a633-94c74472b5b9" :answer/type :answer.type/math :answer/value "7{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-fdc03597-2e55-5dbe-b2dc-cac7ff614227" :answer/id #uuid "fdc03597-2e55-5dbe-b2dc-cac7ff614227" :answer/type :answer.type/math :answer/value "8{x}^{7}-2{x}^{2}-\\frac{2}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-1f7c7324-2c11-5c83-acfa-b2ee47b3214b" :answer/id #uuid "1f7c7324-2c11-5c83-acfa-b2ee47b3214b" :answer/type :answer.type/math :answer/value "8{x}^{7}-3{x}^{2}+\\frac{2}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-db9820bc-9141-5706-b4b9-696ff0f4d463" :answer/id #uuid "db9820bc-9141-5706-b4b9-696ff0f4d463" :answer/type :answer.type/math :answer/value "8{x}^{7}-3{x}^{2}-\\frac{2}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "answer-628bae58-14c7-519d-8c7b-b62c7c8633da" :answer/id #uuid "628bae58-14c7-519d-8c7b-b62c7c8633da" :answer/type :answer.type/math :answer/value "8{x}^{7}-3{x}^{2}-\\frac{3}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "question-41b5b51f-ba4d-5684-ad06-c34aebd809fa" :question/id #uuid "41b5b51f-ba4d-5684-ad06-c34aebd809fa" :question/math-academy-id "q-70510" :question/problem "Find ${f}^{′}(x)$ for  $f(x)={x}^{2}+\\sqrt{x}-\\frac{1}{x}.$" :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\sqrt{x}-\\frac{1}{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{1/2})-\\frac{\\text{d}}{\\text{d}x}({x}^{-1}) \\\\  & =2{x}^{(2-1)}+\\frac{1}{2}{x}^{1/2-1}-(-1){x}^{(-1-1)} \\\\  & =2x+\\frac{1}{2}{x}^{-1/2}+{x}^{-2} \\\\  & =2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-af40c564-a593-533d-9007-1735d6d363e5"] :db/ensure [:question/validate]} {:db/id "answer-field-af40c564-a593-533d-9007-1735d6d363e5" :answer-field/id #uuid "af40c564-a593-533d-9007-1735d6d363e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-87845c36-7288-53ed-a176-4fdc76ecaa99" :answer-field/choices ["answer-87845c36-7288-53ed-a176-4fdc76ecaa99" "answer-63aaf731-d747-572e-8b0f-86051724c920" "answer-79a69091-2708-57af-a95c-cea22cfae627" "answer-49ef83ba-2eda-583f-b227-7dc00e66db76" "answer-50a9d952-ca58-515d-b1b3-d5444dbbbd57"] :db/ensure [:answer-field/validate]} {:db/id "answer-87845c36-7288-53ed-a176-4fdc76ecaa99" :answer/id #uuid "87845c36-7288-53ed-a176-4fdc76ecaa99" :answer/type :answer.type/math :answer/value "2x+\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-63aaf731-d747-572e-8b0f-86051724c920" :answer/id #uuid "63aaf731-d747-572e-8b0f-86051724c920" :answer/type :answer.type/math :answer/value "2x+\\frac{1}{2\\sqrt{x}}-\\frac{1}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-79a69091-2708-57af-a95c-cea22cfae627" :answer/id #uuid "79a69091-2708-57af-a95c-cea22cfae627" :answer/type :answer.type/math :answer/value "2x+\\frac{1}{\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-49ef83ba-2eda-583f-b227-7dc00e66db76" :answer/id #uuid "49ef83ba-2eda-583f-b227-7dc00e66db76" :answer/type :answer.type/math :answer/value "2x+\\frac{1}{\\sqrt{x}}-\\frac{1}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-50a9d952-ca58-515d-b1b3-d5444dbbbd57" :answer/id #uuid "50a9d952-ca58-515d-b1b3-d5444dbbbd57" :answer/type :answer.type/math :answer/value "2x-\\frac{1}{2\\sqrt{x}}+\\frac{1}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "activity-009fb53a-6c15-5331-9b62-5e54cb035cf7" :activity/id #uuid "009fb53a-6c15-5331-9b62-5e54cb035cf7" :activity/title "The Sum and Constant Multiple Rules for Differentiation" :activity/type :activity.type/review :activity/scope 17592186048932 :activity/course 17592186046647 :activity/steps ["step-737e356a-65b8-553f-997b-0d69f97cecb2" "step-f660f8c9-d53b-5752-bc6d-8207382ee6a0" "step-86e0a8b7-a787-51e5-aa42-402c11774f72" "step-a7e099d1-ddb9-56ee-bd14-9204b7666fdc" "step-1ffd320b-d38b-57d0-b097-7c3039e0ec50"] :activity/first-step "step-737e356a-65b8-553f-997b-0d69f97cecb2" :db/ensure [:activity/validate]} {:db/id "step-737e356a-65b8-553f-997b-0d69f97cecb2" :step/id #uuid "737e356a-65b8-553f-997b-0d69f97cecb2" :step/content "question-cd92c8db-d853-53b3-99d2-6ad9bcebe052" :step/next "step-f660f8c9-d53b-5752-bc6d-8207382ee6a0" :db/ensure [:step/validate]} {:db/id "step-f660f8c9-d53b-5752-bc6d-8207382ee6a0" :step/id #uuid "f660f8c9-d53b-5752-bc6d-8207382ee6a0" :step/content "question-a746a92c-9180-5bad-bfc6-5ca557baf9cb" :step/next "step-86e0a8b7-a787-51e5-aa42-402c11774f72" :db/ensure [:step/validate]} {:db/id "step-86e0a8b7-a787-51e5-aa42-402c11774f72" :step/id #uuid "86e0a8b7-a787-51e5-aa42-402c11774f72" :step/content "question-8a7a18a3-9c4b-5644-bbba-c016ec6ec070" :step/next "step-a7e099d1-ddb9-56ee-bd14-9204b7666fdc" :db/ensure [:step/validate]} {:db/id "step-a7e099d1-ddb9-56ee-bd14-9204b7666fdc" :step/id #uuid "a7e099d1-ddb9-56ee-bd14-9204b7666fdc" :step/content "question-41b5b51f-ba4d-5684-ad06-c34aebd809fa" :step/next "step-1ffd320b-d38b-57d0-b097-7c3039e0ec50" :db/ensure [:step/validate]} {:db/id "step-1ffd320b-d38b-57d0-b097-7c3039e0ec50" :step/id #uuid "1ffd320b-d38b-57d0-b097-7c3039e0ec50" :step/content 17592186237874 :db/ensure [:step/validate]} {:db/id 17592186172139 :knowledge-point/questions ["question-5b6f1d07-c822-54bd-9a6b-61be77fdf562"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186171804 :question/problem "Reflect the figure shown below across the line $l.$ \n\n![](images/65/65fc37670764a572b0cfbbfd4dcd577bafc60e79ff68d5776b13ef54aa346f1e.png)" :question/worked-solution "To reflect a polygon across a line, we \n\n- reflect the vertices of the polygon, and then\n\n- draw the edges connecting the reflected vertices.\n\nTherefore, reflecting our polygon across the line $l$, we obtain the following result:\n\n![](images/1d/1dc3f898405c7b18b563711f0b0dcdbbcdd5d6c64e004ab3a754cf636abef0ca.png)" :db/ensure [:question/validate]} {:db/id 17592186172140 :knowledge-point/questions ["question-b9f087f3-735f-5a05-b67f-a26f82bae379" "question-2390f18e-0af9-5fcf-b59a-c441026530cc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186171805 :question/worked-solution "The line of reflection is the perpendicular bisector of the segments joining each point to its image. \n\nTherefore, the line of reflection is $x = \\dfrac{1}{2},$ as shown below.\n\n![](images/29/29eefc4587dbf48f003f351138d4ec2eaea36e2618c831348e4578ff32782ee8.png)" :db/ensure [:question/validate]} {:db/id 17592186172545 :question/problem "![](images/b6/b63748edb25f4bac64d3163203bf7dfbda3bc366f90bdd347cce4f001974da63.png)\n\nThe figure shown above is reflected across the line ${l}_{1}$ and then this resulting figure is reflected across the line ${l}_{2}.$ Which of the following diagrams shows the final figure?" :question/worked-solution "First, we reflect our figure in the line ${l}_{1}:$\n\n![](images/82/82b143f1adc5db52260fc0d6d100b434e6051d30b0910c7a182ec5874c4e06e6.png)\n\nNow, we reflect the resulting figure in the line ${l}_{2}:$ \n\n![](images/03/03a262178e98ff4dfa28a15977571ba5ee574b650f52afd9455c0786a588c6cf.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186170895 :answer-field/correct 17592186170896 :db/ensure [:answer-field/validate]} {:db/id "question-5b6f1d07-c822-54bd-9a6b-61be77fdf562" :question/id #uuid "5b6f1d07-c822-54bd-9a6b-61be77fdf562" :question/math-academy-id "q-102559" :question/problem "![](images/a7/a70514b3167a73ac906d0817d1dffda15617bc642bb0c1d0eaca50762b716063.png)\n\nThe figure shown above is reflected across the line ${l}_{1}$ and then this resulting figure is reflected across the line ${l}_{2}.$ Which of the following diagrams shows the final figure?" :question/worked-solution "First, we reflect our figure in the line ${l}_{1}:$\n\n![](images/2c/2cf56107823d9a67d27ce38bda91b815815767c8565cfce44f8a0f493127d1d8.png)\n\nNow, we reflect the resulting figure in the line ${l}_{2}:$ \n\n![](images/29/29b381def36ec661b0940d8f8f8a2f0633e983a9a70ea46bf2548a57d9f3f146.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1a54f304-f170-58ad-a200-ad9da5e15b5c"] :db/ensure [:question/validate]} {:db/id "answer-field-1a54f304-f170-58ad-a200-ad9da5e15b5c" :answer-field/id #uuid "1a54f304-f170-58ad-a200-ad9da5e15b5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0446b230-a9c5-58f6-b1b2-62e3e441305b" :answer-field/choices ["answer-96afccea-65c2-5770-b94f-5eec2b9e7525" "answer-0446b230-a9c5-58f6-b1b2-62e3e441305b" "answer-3bcd23ab-8a14-5af0-94cb-be8ce1492777" "answer-67012e70-0a5c-5e2a-a848-0ed5ca208053" "answer-30e063ca-d7d7-50ee-ad39-2d8f6ce01eb8"] :db/ensure [:answer-field/validate]} {:db/id "answer-96afccea-65c2-5770-b94f-5eec2b9e7525" :answer/id #uuid "96afccea-65c2-5770-b94f-5eec2b9e7525" :answer/type :answer.type/image :answer/value "images/1e/1e028a2f001d4cab7906604fa225a2ba1d9ea5ead1cf9df80477561e93341783.png" :db/ensure [:answer/validate]} {:db/id "answer-0446b230-a9c5-58f6-b1b2-62e3e441305b" :answer/id #uuid "0446b230-a9c5-58f6-b1b2-62e3e441305b" :answer/type :answer.type/image :answer/value "images/75/75876d6f0fc6d3bf75ccbd40eac0f90ae6a490f68b09ea4755500aba65932e1a.png" :db/ensure [:answer/validate]} {:db/id "answer-3bcd23ab-8a14-5af0-94cb-be8ce1492777" :answer/id #uuid "3bcd23ab-8a14-5af0-94cb-be8ce1492777" :answer/type :answer.type/image :answer/value "images/b7/b7bef7ad2f56d270e9d95cc4b8ae26e4241d9c5e739b2eff10c5c190553fb6b4.png" :db/ensure [:answer/validate]} {:db/id "answer-67012e70-0a5c-5e2a-a848-0ed5ca208053" :answer/id #uuid "67012e70-0a5c-5e2a-a848-0ed5ca208053" :answer/type :answer.type/image :answer/value "images/b8/b8955833c84e03a544c5dee42eca83ccaf6f5e9a39961aac3e8ddd2a314c6fd7.png" :db/ensure [:answer/validate]} {:db/id "answer-30e063ca-d7d7-50ee-ad39-2d8f6ce01eb8" :answer/id #uuid "30e063ca-d7d7-50ee-ad39-2d8f6ce01eb8" :answer/type :answer.type/image :answer/value "images/cd/cdcc25cb4aa981a9893538f60712b024c4170c75fecab858ff2a88a5d912aa83.png" :db/ensure [:answer/validate]} {:db/id "question-b9f087f3-735f-5a05-b67f-a26f82bae379" :question/id #uuid "b9f087f3-735f-5a05-b67f-a26f82bae379" :question/math-academy-id "q-102581" :question/problem "![](images/69/691ef4d815f6150b5940c323c5a2be09dc0f0ea1abdd3be36560d931fd1f5015.png)\n\nThe polygon $T$ is mapped to the polygon ${T}^{′}$ under the action of a reflection. What is the equation of the line of reflection?" :question/worked-solution "The line of reflection is the perpendicular bisector of the segments joining each point to its image. \n\nTherefore, the equation of the line of reflection is $y=x,$ as shown below.\n\n![](images/d1/d1278df44d05d0bb2169e72c1dce84650b0d4f269dd14d57c4d046f634e1ab7a.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c2cf83d1-1646-5b19-971c-0740486539a7"] :db/ensure [:question/validate]} {:db/id "answer-field-c2cf83d1-1646-5b19-971c-0740486539a7" :answer-field/id #uuid "c2cf83d1-1646-5b19-971c-0740486539a7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-724ab848-ba4a-5991-a624-661f573de837" :answer-field/choices ["answer-a6ec5f9d-ff29-5b38-9bb2-9911ed8a456f" "answer-145f377c-1d9a-52e6-87ba-9fe26091b1fc" "answer-a4526d50-025a-5859-8b2e-e1c1b340567d" "answer-724ab848-ba4a-5991-a624-661f573de837" "answer-ef247d23-3095-5919-b0cd-dddc43d2bfc5"] :db/ensure [:answer-field/validate]} {:db/id "answer-a6ec5f9d-ff29-5b38-9bb2-9911ed8a456f" :answer/id #uuid "a6ec5f9d-ff29-5b38-9bb2-9911ed8a456f" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "answer-145f377c-1d9a-52e6-87ba-9fe26091b1fc" :answer/id #uuid "145f377c-1d9a-52e6-87ba-9fe26091b1fc" :answer/type :answer.type/math :answer/value "y=-x" :db/ensure [:answer/validate]} {:db/id "answer-a4526d50-025a-5859-8b2e-e1c1b340567d" :answer/id #uuid "a4526d50-025a-5859-8b2e-e1c1b340567d" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "answer-724ab848-ba4a-5991-a624-661f573de837" :answer/id #uuid "724ab848-ba4a-5991-a624-661f573de837" :answer/type :answer.type/math :answer/value "y=x" :db/ensure [:answer/validate]} {:db/id "answer-ef247d23-3095-5919-b0cd-dddc43d2bfc5" :answer/id #uuid "ef247d23-3095-5919-b0cd-dddc43d2bfc5" :answer/type :answer.type/math :answer/value "y=x+1" :db/ensure [:answer/validate]} {:db/id "question-2390f18e-0af9-5fcf-b59a-c441026530cc" :question/id #uuid "2390f18e-0af9-5fcf-b59a-c441026530cc" :question/math-academy-id "q-102579" :question/problem "![](images/f6/f6ab47a6cf805bbae1e2b079239d716f0ffa94507df6c8c057547bc9b3848916.png)\n\nThe polygon $P$ is mapped to the polygon ${P}^{′}$ under the action of a reflection. What is the equation of the line of reflection?" :question/worked-solution "The line of reflection is the perpendicular bisector of the segments joining each point to its image. \n\nTherefore, the line of reflection is $y=1,$ as shown below.\n\n![](images/f8/f8abf0ecccfd5e1ead751263383f15d150e10d7ec4d972a88656512e0e09441f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1221d62-14fc-556b-b7f2-473fef6da38b"] :db/ensure [:question/validate]} {:db/id "answer-field-b1221d62-14fc-556b-b7f2-473fef6da38b" :answer-field/id #uuid "b1221d62-14fc-556b-b7f2-473fef6da38b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-34a9553c-a522-5f12-af7c-888308871d03" :answer-field/choices ["answer-d22e4f1f-6468-5492-aeac-332c104d7b34" "answer-34a9553c-a522-5f12-af7c-888308871d03" "answer-dda93096-20c0-5d45-9fad-0b9b82648488" "answer-7dcd0589-e04f-51f3-aa52-4fe10d9496f3" "answer-54c8511f-27f7-57b5-9e69-477a792960f0"] :db/ensure [:answer-field/validate]} {:db/id "answer-d22e4f1f-6468-5492-aeac-332c104d7b34" :answer/id #uuid "d22e4f1f-6468-5492-aeac-332c104d7b34" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "answer-34a9553c-a522-5f12-af7c-888308871d03" :answer/id #uuid "34a9553c-a522-5f12-af7c-888308871d03" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "answer-dda93096-20c0-5d45-9fad-0b9b82648488" :answer/id #uuid "dda93096-20c0-5d45-9fad-0b9b82648488" :answer/type :answer.type/math :answer/value "y=2" :db/ensure [:answer/validate]} {:db/id "answer-7dcd0589-e04f-51f3-aa52-4fe10d9496f3" :answer/id #uuid "7dcd0589-e04f-51f3-aa52-4fe10d9496f3" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-54c8511f-27f7-57b5-9e69-477a792960f0" :answer/id #uuid "54c8511f-27f7-57b5-9e69-477a792960f0" :answer/type :answer.type/math :answer/value "y=\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id 17592186173142 :tutorial/content "We can reflect an object in any line. Consider the diagram below. The two polygons are the mirror images of each other in the line $l.$\n\n![](images/1e/1e4dfb2939916df5d5018320819f14fcec261a1e77c171b551e9868a8c3bebc8.png)\n\nIf we want to reflect the quadrilateral $ABCD$ below in the line $l,$ we can reflect each vertex separately and then draw the segments between the resulting corresponding vertices.\n\n![](images/a4/a47c41b41ecae2bc4c281e1b90c843ae68fa907a0d2ff49c48454fd80e2977c7.png)\n\nLet's start by reflecting the point $A.$ To do this, we need to plot a new point $A'$ on the opposite side of $l$ at an equal distance away from $l$ as the original point $A.$\n\nThe original point $A$ is $4$ units to the left of $l,$ so we need to plot the new point $A'$ at a distance of $4$ units to the right of $l.$\n\n![](images/33/33bb82c9d0f20df13f46060b9aec21e8c4d1231766926c47b7718bf58e1c5e32.png)\n\nNow let's reflect other vertices of the quadrilateral in the same way:\n\n![](images/00/00ec763ccce462effa024486a6ff09a98b549c61179de18bb850470e835a7627.png)\n\nFinally, we draw segments between the reflected vertices.\n\n![](images/7f/7ffd0cfa45051d8376c46528370b34222a1ebb226987e7530d5081d69942bbde.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186173143 :tutorial/content "If we're given two points, we can find the line of reflection that maps one point onto another by finding the perpendicular bisector of the segment joining the two points.\n\nFor example, suppose that the line $l$ reflects the point $A$ onto $A'$ below. How can we find the equation of $l?$\n\n![](images/79/79ddc15badc704a9c9860207a5156c3a0505ab626572581bcf3146976338a015.png)\n\nThe line $l$ is the perpendicular bisector of the line segment $\\overline{AA'}.$ So, the line of reflection is $y=-1.$\n\n![](images/aa/aa240e562acf388bdf05751e680e917bc8465bad34300334f6b423df46a7d1f3.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186172207 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186078464 :knowledge-point/questions ["question-2a8b0250-b565-5cfb-a030-1477892ed03e" "question-a3ce8ce6-6748-574c-a1ce-f27315ba87e1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2a8b0250-b565-5cfb-a030-1477892ed03e" :question/id #uuid "2a8b0250-b565-5cfb-a030-1477892ed03e" :question/math-academy-id "q-100832" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-1$ and the second term is $-3.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are given the first term $f(1)=-1.$ Also, the common difference of the sequence can be found as\n\n$$\nd=-3-(-1)=-2.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-1+(n-1)(-2) \\\\  & =-1-2n+2 \\\\  & =1-2n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=1-2n.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3a89ed3a-0922-5e5e-b7bc-1abf0e252f66"] :db/ensure [:question/validate]} {:db/id "answer-field-3a89ed3a-0922-5e5e-b7bc-1abf0e252f66" :answer-field/id #uuid "3a89ed3a-0922-5e5e-b7bc-1abf0e252f66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7b33bb5e-aeab-5597-b3c0-9aeced82a379" :answer-field/choices ["answer-a98fd583-0615-5103-abe9-05473df6b6a1" "answer-eed3487f-5a9e-54ff-85a2-1310f6278051" "answer-0c2df398-80bb-51a4-b350-3b2e0296b3f0" "answer-7b33bb5e-aeab-5597-b3c0-9aeced82a379" "answer-fae6e728-13ce-5cb2-a8d9-0931f9782d37"] :db/ensure [:answer-field/validate]} {:db/id "answer-a98fd583-0615-5103-abe9-05473df6b6a1" :answer/id #uuid "a98fd583-0615-5103-abe9-05473df6b6a1" :answer/type :answer.type/math :answer/value "f(n)=-1+2n" :db/ensure [:answer/validate]} {:db/id "answer-eed3487f-5a9e-54ff-85a2-1310f6278051" :answer/id #uuid "eed3487f-5a9e-54ff-85a2-1310f6278051" :answer/type :answer.type/math :answer/value "f(n)=-1-2n" :db/ensure [:answer/validate]} {:db/id "answer-0c2df398-80bb-51a4-b350-3b2e0296b3f0" :answer/id #uuid "0c2df398-80bb-51a4-b350-3b2e0296b3f0" :answer/type :answer.type/math :answer/value "f(n)=1+2n" :db/ensure [:answer/validate]} {:db/id "answer-7b33bb5e-aeab-5597-b3c0-9aeced82a379" :answer/id #uuid "7b33bb5e-aeab-5597-b3c0-9aeced82a379" :answer/type :answer.type/math :answer/value "f(n)=1-2n" :db/ensure [:answer/validate]} {:db/id "answer-fae6e728-13ce-5cb2-a8d9-0931f9782d37" :answer/id #uuid "fae6e728-13ce-5cb2-a8d9-0931f9782d37" :answer/type :answer.type/math :answer/value "f(n)=2n" :db/ensure [:answer/validate]} {:db/id "question-a3ce8ce6-6748-574c-a1ce-f27315ba87e1" :question/id #uuid "a3ce8ce6-6748-574c-a1ce-f27315ba87e1" :question/math-academy-id "q-100834" :question/problem "Find the formula for the $n$th term of an arithmetic sequence if the first term is $-5$ and the common difference is $-1.$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence (in function notation) is\n\n$$\nf(n)=f(1)+(n-1)d.\n$$\n\nWe are told that the first term is $f(1)=-5$ and the common difference is $d=-1.$ So, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}f(n) & =f(1)+(n-1)d \\\\  & =-5+(n-1)(-1) \\\\  & =-5-n+1 \\\\  & =-4-n\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is $f(n)=-4-n.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-885b6fc5-35e5-5c62-b5d3-34dcc6e8b072"] :db/ensure [:question/validate]} {:db/id "answer-field-885b6fc5-35e5-5c62-b5d3-34dcc6e8b072" :answer-field/id #uuid "885b6fc5-35e5-5c62-b5d3-34dcc6e8b072" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db6d5fb0-094b-5c89-9c80-859ccdc9373f" :answer-field/choices ["answer-9b49282d-829d-5a5f-abfe-4892f5735307" "answer-95450a87-b3f3-5724-921d-8f93ba0f17ed" "answer-db6d5fb0-094b-5c89-9c80-859ccdc9373f" "answer-757b62cd-47f6-52e7-b8c7-87b24ef760d4" "answer-02bda01c-00ce-5dc4-afcd-031687d469c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b49282d-829d-5a5f-abfe-4892f5735307" :answer/id #uuid "9b49282d-829d-5a5f-abfe-4892f5735307" :answer/type :answer.type/math :answer/value "f(n)=-1-5n" :db/ensure [:answer/validate]} {:db/id "answer-95450a87-b3f3-5724-921d-8f93ba0f17ed" :answer/id #uuid "95450a87-b3f3-5724-921d-8f93ba0f17ed" :answer/type :answer.type/math :answer/value "f(n)=-4+n" :db/ensure [:answer/validate]} {:db/id "answer-db6d5fb0-094b-5c89-9c80-859ccdc9373f" :answer/id #uuid "db6d5fb0-094b-5c89-9c80-859ccdc9373f" :answer/type :answer.type/math :answer/value "f(n)=-4-n" :db/ensure [:answer/validate]} {:db/id "answer-757b62cd-47f6-52e7-b8c7-87b24ef760d4" :answer/id #uuid "757b62cd-47f6-52e7-b8c7-87b24ef760d4" :answer/type :answer.type/math :answer/value "f(n)=-5+n" :db/ensure [:answer/validate]} {:db/id "answer-02bda01c-00ce-5dc4-afcd-031687d469c0" :answer/id #uuid "02bda01c-00ce-5dc4-afcd-031687d469c0" :answer/type :answer.type/math :answer/value "f(n)=-5-n" :db/ensure [:answer/validate]} {:db/id 17592186078465 :knowledge-point/questions ["question-6e4f48de-276e-5a6a-aa00-d24142c4be2a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6e4f48de-276e-5a6a-aa00-d24142c4be2a" :question/id #uuid "6e4f48de-276e-5a6a-aa00-d24142c4be2a" :question/math-academy-id "q-100845" :question/problem "Find the $25$th term of the following arithmetic sequence. \n\n$$\n4,\\,8,\\,12,\\,16,\\,…\n$$" :question/worked-solution "The formula for the $n$th term of an arithmetic sequence is\n\n$$\n{a}_{n}={a}_{1}+(n-1)d.\n$$\n\nFirst, we will write the formula for the $n$th term of this sequence. From the first few terms\n\n$$\n4,\\,8,\\,12,\\,16,\\,…,\n$$\n\nwe see that the first term is ${a}_{1}=4$ and the common difference is \n\n$$\nd=8-4=4.\n$$\n\nSo, we substitute into the formula and simplify:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =4+(n-1)(4) \\\\  & =4+4n-4 \\\\  & =4n\\end{aligned}\n$$\n\nNow, we can use our formula to find the $25$th term. All we have to do is substitute $n=25:$\n\n$$\n\\begin{aligned}{a}_{n} & =4n \\\\ {a}_{25} & =4(25) \\\\  & =100\\end{aligned}\n$$\n\nTherefore, the $25$th term of the sequence is ${a}_{25}=100.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7ba50122-278d-5157-acaf-029a2378db5c"] :db/ensure [:question/validate]} {:db/id "answer-field-7ba50122-278d-5157-acaf-029a2378db5c" :answer-field/id #uuid "7ba50122-278d-5157-acaf-029a2378db5c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f05b8a0-9a98-5dee-a7d1-c5848081e29f" :answer-field/choices ["answer-7f05b8a0-9a98-5dee-a7d1-c5848081e29f" "answer-24dcbfc4-cc84-5f3a-b1cb-693ebed8dae5" "answer-38a4a997-9b98-51d1-8c53-e8d9e667a96a" "answer-baf4b0b7-e6e4-57e2-9251-32c818c8e409" "answer-e6e5068d-43ad-5e98-9f6e-018f2ee0916c"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f05b8a0-9a98-5dee-a7d1-c5848081e29f" :answer/id #uuid "7f05b8a0-9a98-5dee-a7d1-c5848081e29f" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-24dcbfc4-cc84-5f3a-b1cb-693ebed8dae5" :answer/id #uuid "24dcbfc4-cc84-5f3a-b1cb-693ebed8dae5" :answer/type :answer.type/math :answer/value "104" :db/ensure [:answer/validate]} {:db/id "answer-38a4a997-9b98-51d1-8c53-e8d9e667a96a" :answer/id #uuid "38a4a997-9b98-51d1-8c53-e8d9e667a96a" :answer/type :answer.type/math :answer/value "92" :db/ensure [:answer/validate]} {:db/id "answer-baf4b0b7-e6e4-57e2-9251-32c818c8e409" :answer/id #uuid "baf4b0b7-e6e4-57e2-9251-32c818c8e409" :answer/type :answer.type/math :answer/value "96" :db/ensure [:answer/validate]} {:db/id "answer-e6e5068d-43ad-5e98-9f6e-018f2ee0916c" :answer/id #uuid "e6e5068d-43ad-5e98-9f6e-018f2ee0916c" :answer/type :answer.type/math :answer/value "98" :db/ensure [:answer/validate]} {:db/id "activity-d673b246-6f75-5325-93c7-4d1a916755c3" :activity/id #uuid "d673b246-6f75-5325-93c7-4d1a916755c3" :activity/title "The Nth Term of an Arithmetic Sequence" :activity/type :activity.type/review :activity/scope 17592186050157 :activity/course 17592186046647 :activity/steps ["step-3ff9a4dd-1f62-5e61-be7b-a1740475e433" "step-09c7a56f-14c4-5bf0-b911-ecdd6881ed50" "step-80f2b9a6-d06f-59b4-bcbb-e30cb9858cb6"] :activity/first-step "step-3ff9a4dd-1f62-5e61-be7b-a1740475e433" :db/ensure [:activity/validate]} {:db/id "step-3ff9a4dd-1f62-5e61-be7b-a1740475e433" :step/id #uuid "3ff9a4dd-1f62-5e61-be7b-a1740475e433" :step/content "question-2a8b0250-b565-5cfb-a030-1477892ed03e" :step/next "step-09c7a56f-14c4-5bf0-b911-ecdd6881ed50" :db/ensure [:step/validate]} {:db/id "step-09c7a56f-14c4-5bf0-b911-ecdd6881ed50" :step/id #uuid "09c7a56f-14c4-5bf0-b911-ecdd6881ed50" :step/content "question-a3ce8ce6-6748-574c-a1ce-f27315ba87e1" :step/next "step-80f2b9a6-d06f-59b4-bcbb-e30cb9858cb6" :db/ensure [:step/validate]} {:db/id "step-80f2b9a6-d06f-59b4-bcbb-e30cb9858cb6" :step/id #uuid "80f2b9a6-d06f-59b4-bcbb-e30cb9858cb6" :step/content "question-6e4f48de-276e-5a6a-aa00-d24142c4be2a" :db/ensure [:step/validate]} {:db/id 17592186087801 :knowledge-point/questions ["question-bf998376-0b5d-5f0e-ac72-6bbc0864becd" "question-8855f85e-af22-5017-b471-837c5222e69b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087802 :knowledge-point/questions ["question-117d2bbe-700d-5500-84d8-cda2c172b75c" "question-4d316b19-46f8-547d-95ad-bbdabb50ffb3" "question-9466ac77-f4bf-5bd1-8cef-81367e73b3b6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087800 :knowledge-point/questions ["question-476be737-90ba-5bfe-8a20-c650319e8b3b" "question-5daa6476-7e34-5e5c-afc2-27c877b6a525"] :db/ensure [:knowledge-point/validate]} {:db/id "question-476be737-90ba-5bfe-8a20-c650319e8b3b" :question/id #uuid "476be737-90ba-5bfe-8a20-c650319e8b3b" :question/math-academy-id "q-106414" :question/problem "![](images/89/8934e5b6135b97b845dad9a6b87056d2c228fd2424d3a72141df694d46ccf7c0.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(0,0),$ and passes through the point $(-6,12).$\n\nThe parametric equations of a vertical parabola  that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(-6,12),$ we can substitute $x=-6$ and $y=12$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}-6=2pt \\\\ 12=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-6 & =2pt \\\\ -3 & =pt \\\\ t & =-\\frac{3}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}12 & =p{(-\\frac{3}{p})}^{2} \\\\ 12 & =p\\cdot \\frac{9}{{p}^{2}} \\\\ 12 & =\\frac{9}{p} \\\\ p & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(\\frac{3}{4})t,\\,y=(\\frac{3}{4}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=\\frac{3}{2}t,\\,y=\\frac{3}{4}{t}^{2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-709bb002-42ed-5076-9f07-4d7555384dbe"] :db/ensure [:question/validate]} {:db/id "answer-field-709bb002-42ed-5076-9f07-4d7555384dbe" :answer-field/id #uuid "709bb002-42ed-5076-9f07-4d7555384dbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2637c6d9-f699-5e24-af7a-329870be2fe3" :answer-field/choices ["answer-82e84ea1-476d-5fa4-8ca5-a30056317436" "answer-512a7ed1-b0bf-5dd9-9978-7ed2decafc3b" "answer-0b7ddbe0-edeb-5af4-acdc-0e8bdedd7785" "answer-2637c6d9-f699-5e24-af7a-329870be2fe3" "answer-369283f1-0003-5dfd-b8bf-780c8fe3b4e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-82e84ea1-476d-5fa4-8ca5-a30056317436" :answer/id #uuid "82e84ea1-476d-5fa4-8ca5-a30056317436" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{2}t,\\,\\,y=\\frac{3}{8}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-512a7ed1-b0bf-5dd9-9978-7ed2decafc3b" :answer/id #uuid "512a7ed1-b0bf-5dd9-9978-7ed2decafc3b" :answer/type :answer.type/math :answer/value "x=\\frac{3}{2}t,\\,\\,y=-\\frac{3}{2}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-0b7ddbe0-edeb-5af4-acdc-0e8bdedd7785" :answer/id #uuid "0b7ddbe0-edeb-5af4-acdc-0e8bdedd7785" :answer/type :answer.type/math :answer/value "x=\\frac{3}{2}t,\\,\\,y=-\\frac{3}{4}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2637c6d9-f699-5e24-af7a-329870be2fe3" :answer/id #uuid "2637c6d9-f699-5e24-af7a-329870be2fe3" :answer/type :answer.type/math :answer/value "x=\\frac{3}{2}t,\\,\\,y=\\frac{3}{4}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-369283f1-0003-5dfd-b8bf-780c8fe3b4e7" :answer/id #uuid "369283f1-0003-5dfd-b8bf-780c8fe3b4e7" :answer/type :answer.type/math :answer/value "x=\\frac{3}{4}t,\\,\\,y=\\frac{3}{2}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "question-5daa6476-7e34-5e5c-afc2-27c877b6a525" :question/id #uuid "5daa6476-7e34-5e5c-afc2-27c877b6a525" :question/math-academy-id "q-280220" :question/problem "Determine a set of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ that generate a vertical parabola that has its vertex at $(0,0)$ and which passes through the point $(-8,8).$ Express your answer in the form $x=2pt,y=p{t}^{2},$ where $p$ is a constant.\n\n$x=$\n{{field-1}},\n$\\,y=$\n{{field-2}}" :question/worked-solution "The parametric equations of a vertical parabola  that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(-8,8),$ we can substitute $x=-8$ and $y=8$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}-8=2pt \\\\ 8=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-8 & =2pt \\\\ t & =-\\frac{4}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}8 & =p{(-\\frac{4}{p})}^{2} \\\\ 8 & =p\\cdot \\frac{16}{{p}^{2}} \\\\ 8 & =\\frac{16}{p} \\\\ p & =2.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(2)t,\\,y=(2){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=4t,\\,y=2{t}^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-852f5335-7100-5af8-83e3-1bcac38ee757" "answer-field-f288405a-29b1-5b71-8025-b48b0179b10a"] :db/ensure [:question/validate]} {:db/id "answer-field-852f5335-7100-5af8-83e3-1bcac38ee757" :answer-field/id #uuid "852f5335-7100-5af8-83e3-1bcac38ee757" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-34dc9e34-88b2-585e-b8f0-9828d32d21e1" :answer-field/choices ["answer-34dc9e34-88b2-585e-b8f0-9828d32d21e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-34dc9e34-88b2-585e-b8f0-9828d32d21e1" :answer/id #uuid "34dc9e34-88b2-585e-b8f0-9828d32d21e1" :answer/type :answer.type/math :answer/value "4t" :db/ensure [:answer/validate]} {:db/id "answer-field-f288405a-29b1-5b71-8025-b48b0179b10a" :answer-field/id #uuid "f288405a-29b1-5b71-8025-b48b0179b10a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-792a7020-748e-5273-a5c8-4d48fd7db315" :answer-field/choices ["answer-792a7020-748e-5273-a5c8-4d48fd7db315"] :db/ensure [:answer-field/validate]} {:db/id "answer-792a7020-748e-5273-a5c8-4d48fd7db315" :answer/id #uuid "792a7020-748e-5273-a5c8-4d48fd7db315" :answer/type :answer.type/math :answer/value "2t^{2}" :db/ensure [:answer/validate]} {:db/id "question-bf998376-0b5d-5f0e-ac72-6bbc0864becd" :question/id #uuid "bf998376-0b5d-5f0e-ac72-6bbc0864becd" :question/math-academy-id "q-84714" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation ${y}^{2}=-10x?$" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =-10x \\\\ 4p & =-10 \\\\ p & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(-\\frac{5}{2}){t}^{2},\\,y=2(-\\frac{5}{2})t,\n$$\n\nwhich simplify to\n\n$$\nx=-\\frac{5}{2}{t}^{2},\\,y=-5t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3f25c337-6e13-59ee-b2b3-9226f27c88ac"] :db/ensure [:question/validate]} {:db/id "answer-field-3f25c337-6e13-59ee-b2b3-9226f27c88ac" :answer-field/id #uuid "3f25c337-6e13-59ee-b2b3-9226f27c88ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2771000a-6db8-5877-b7c6-5b7844a78fa4" :answer-field/choices ["answer-616c0775-e808-578f-831f-06059bc472d8" "answer-bed7ea9b-4c8f-5ee5-8da5-9881fef75d67" "answer-2771000a-6db8-5877-b7c6-5b7844a78fa4" "answer-b2849469-2ae6-5d77-81c9-093078f83f91" "answer-cf409848-806c-52aa-b07d-5b0b88efdbdf"] :db/ensure [:answer-field/validate]} {:db/id "answer-616c0775-e808-578f-831f-06059bc472d8" :answer/id #uuid "616c0775-e808-578f-831f-06059bc472d8" :answer/type :answer.type/math :answer/value "x=-5{t}^{2},\\,\\,y=-5t" :db/ensure [:answer/validate]} {:db/id "answer-bed7ea9b-4c8f-5ee5-8da5-9881fef75d67" :answer/id #uuid "bed7ea9b-4c8f-5ee5-8da5-9881fef75d67" :answer/type :answer.type/math :answer/value "x=-\\frac{2}{5}{t}^{2},\\,\\,y=-\\frac{4}{5}t" :db/ensure [:answer/validate]} {:db/id "answer-2771000a-6db8-5877-b7c6-5b7844a78fa4" :answer/id #uuid "2771000a-6db8-5877-b7c6-5b7844a78fa4" :answer/type :answer.type/math :answer/value "x=-\\frac{5}{2}{t}^{2},\\,\\,y=-5t" :db/ensure [:answer/validate]} {:db/id "answer-b2849469-2ae6-5d77-81c9-093078f83f91" :answer/id #uuid "b2849469-2ae6-5d77-81c9-093078f83f91" :answer/type :answer.type/math :answer/value "x=-\\frac{5}{2}{t}^{2},\\,\\,y=-\\frac{5}{2}t" :db/ensure [:answer/validate]} {:db/id "answer-cf409848-806c-52aa-b07d-5b0b88efdbdf" :answer/id #uuid "cf409848-806c-52aa-b07d-5b0b88efdbdf" :answer/type :answer.type/math :answer/value "x=-{t}^{2},\\,\\,y=-\\frac{5}{2}t" :db/ensure [:answer/validate]} {:db/id 17592186293948 :answer-field/correct "answer-88b60145-74d7-5125-9d2f-627fd47ed384" :answer-field/choices ["answer-88b60145-74d7-5125-9d2f-627fd47ed384"] :db/ensure [:answer-field/validate]} {:db/id "answer-88b60145-74d7-5125-9d2f-627fd47ed384" :answer/id #uuid "88b60145-74d7-5125-9d2f-627fd47ed384" :answer/type :answer.type/math :answer/value "8t^{2}" :db/ensure [:answer/validate]} {:db/id "question-8855f85e-af22-5017-b471-837c5222e69b" :question/id #uuid "8855f85e-af22-5017-b471-837c5222e69b" :question/math-academy-id "q-280225" :question/problem "Determine a set of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ that generate the horizontal parabola given by the Cartesian equation ${y}^{2}=-24x.$ Express your answer in the form $x=p{t}^{2},y=2pt,$ where $p$ is a constant.\n\n$x=$\n{{field-1}},\n$\\,y=$\n{{field-2}}" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =-24x \\\\ 4p & =-24 \\\\ p & =-6.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(-6){t}^{2},\\,y=2(-6)t,\n$$\n\nwhich simplify to\n\n$$\nx=-6{t}^{2},\\,y=-12t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-afa7d66b-3573-5d07-a0e0-9c784e111c46" "answer-field-e17e1296-2fea-5348-b461-c3962ef4a04f"] :db/ensure [:question/validate]} {:db/id "answer-field-afa7d66b-3573-5d07-a0e0-9c784e111c46" :answer-field/id #uuid "afa7d66b-3573-5d07-a0e0-9c784e111c46" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e6a52e9f-190c-5ab9-a11a-f768fda6293e" :answer-field/choices ["answer-e6a52e9f-190c-5ab9-a11a-f768fda6293e"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6a52e9f-190c-5ab9-a11a-f768fda6293e" :answer/id #uuid "e6a52e9f-190c-5ab9-a11a-f768fda6293e" :answer/type :answer.type/math :answer/value "-6t^{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-e17e1296-2fea-5348-b461-c3962ef4a04f" :answer-field/id #uuid "e17e1296-2fea-5348-b461-c3962ef4a04f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fa7375ba-60b0-59ae-8b9b-5dbd4e3f033d" :answer-field/choices ["answer-fa7375ba-60b0-59ae-8b9b-5dbd4e3f033d"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa7375ba-60b0-59ae-8b9b-5dbd4e3f033d" :answer/id #uuid "fa7375ba-60b0-59ae-8b9b-5dbd4e3f033d" :answer/type :answer.type/math :answer/value "-12t" :db/ensure [:answer/validate]} {:db/id "question-117d2bbe-700d-5500-84d8-cda2c172b75c" :question/id #uuid "117d2bbe-700d-5500-84d8-cda2c172b75c" :question/math-academy-id "q-280382" :question/problem "Consider the following parabola:\n\n$$\nx=15{t}^{2},\\,y=3t,\\,t\\in (-\\infty ,\\infty )\n$$\n\nThe Cartesian equation of the parabola is\n\n${y}^{2}=$\n{{field-1}}." :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{x}{15},\\,t=\\frac{y}{3}.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & =\\frac{{y}^{2}}{9}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=\\frac{x}{15}$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{9} & =\\frac{x}{15} \\\\ {y}^{2} & =\\frac{3}{5}x\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${y}^{2}=\\frac{3}{5}x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-23812876-0f00-5f63-a067-548a46195934"] :db/ensure [:question/validate]} {:db/id "answer-field-23812876-0f00-5f63-a067-548a46195934" :answer-field/id #uuid "23812876-0f00-5f63-a067-548a46195934" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-897301ec-b17d-5ec4-950b-678e2f9e2a61" :answer-field/choices ["answer-897301ec-b17d-5ec4-950b-678e2f9e2a61"] :db/ensure [:answer-field/validate]} {:db/id "answer-897301ec-b17d-5ec4-950b-678e2f9e2a61" :answer/id #uuid "897301ec-b17d-5ec4-950b-678e2f9e2a61" :answer/type :answer.type/math :answer/value "\\frac{3}{5}x" :db/ensure [:answer/validate]} {:db/id "question-4d316b19-46f8-547d-95ad-bbdabb50ffb3" :question/id #uuid "4d316b19-46f8-547d-95ad-bbdabb50ffb3" :question/math-academy-id "q-84735" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx=-\\frac{1}{2}{t}^{2},\\,y=-t,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =-2x,\\,t=-y.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & ={y}^{2}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-2x$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}{y}^{2} & =-2x\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${y}^{2}=-2x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2b5c3524-dbe9-508f-a227-002a3105ecbb"] :db/ensure [:question/validate]} {:db/id "answer-field-2b5c3524-dbe9-508f-a227-002a3105ecbb" :answer-field/id #uuid "2b5c3524-dbe9-508f-a227-002a3105ecbb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-41828207-3d09-56c9-a9ee-6957fc1cab42" :answer-field/choices ["answer-4b96b87b-afac-5cf9-a064-ad7eb9c9ef16" "answer-41828207-3d09-56c9-a9ee-6957fc1cab42" "answer-92966b0c-4feb-5a90-a55c-2c0fd4e3536c" "answer-1dd9ef0b-d572-528c-a599-00ba2e543438" "answer-74def176-8b40-5a47-a8d8-9b0849a0f8d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b96b87b-afac-5cf9-a064-ad7eb9c9ef16" :answer/id #uuid "4b96b87b-afac-5cf9-a064-ad7eb9c9ef16" :answer/type :answer.type/math :answer/value "{y}^{2}=-16x" :db/ensure [:answer/validate]} {:db/id "answer-41828207-3d09-56c9-a9ee-6957fc1cab42" :answer/id #uuid "41828207-3d09-56c9-a9ee-6957fc1cab42" :answer/type :answer.type/math :answer/value "{y}^{2}=-2x" :db/ensure [:answer/validate]} {:db/id "answer-92966b0c-4feb-5a90-a55c-2c0fd4e3536c" :answer/id #uuid "92966b0c-4feb-5a90-a55c-2c0fd4e3536c" :answer/type :answer.type/math :answer/value "{y}^{2}=-8x" :db/ensure [:answer/validate]} {:db/id "answer-1dd9ef0b-d572-528c-a599-00ba2e543438" :answer/id #uuid "1dd9ef0b-d572-528c-a599-00ba2e543438" :answer/type :answer.type/math :answer/value "{y}^{2}=2x" :db/ensure [:answer/validate]} {:db/id "answer-74def176-8b40-5a47-a8d8-9b0849a0f8d8" :answer/id #uuid "74def176-8b40-5a47-a8d8-9b0849a0f8d8" :answer/type :answer.type/math :answer/value "{y}^{2}=8x" :db/ensure [:answer/validate]} {:db/id "question-9466ac77-f4bf-5bd1-8cef-81367e73b3b6" :question/id #uuid "9466ac77-f4bf-5bd1-8cef-81367e73b3b6" :question/math-academy-id "q-106443" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx=-\\frac{1}{4}{t}^{2},\\,y=-\\frac{1}{6}t,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}{t}^{2} & =-4x,\\,t=-6y.\\end{aligned}\n$$\n\nSquaring both sides of the second equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & =36{y}^{2}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-4x$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}36{y}^{2} & =-4x \\\\ {y}^{2} & =-\\frac{1}{9}x\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${y}^{2}=-\\frac{1}{9}x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ed0ba07f-9ec1-55d7-ab0e-5b909c4fa1a0"] :db/ensure [:question/validate]} {:db/id "answer-field-ed0ba07f-9ec1-55d7-ab0e-5b909c4fa1a0" :answer-field/id #uuid "ed0ba07f-9ec1-55d7-ab0e-5b909c4fa1a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a3464f1b-c16b-5140-b363-184627cbe999" :answer-field/choices ["answer-a3464f1b-c16b-5140-b363-184627cbe999" "answer-040cac0d-ceb3-5aa4-b3ee-09a2f428db68" "answer-e0245b50-a16f-522a-94f9-37b20af9e5c4" "answer-8a1afc7d-7411-5523-bc97-b014798b52ab" "answer-b070a6db-e004-52b8-9c3d-4d905814e58b"] :db/ensure [:answer-field/validate]} {:db/id "answer-a3464f1b-c16b-5140-b363-184627cbe999" :answer/id #uuid "a3464f1b-c16b-5140-b363-184627cbe999" :answer/type :answer.type/math :answer/value "{y}^{2}=-\\frac{1}{9}x" :db/ensure [:answer/validate]} {:db/id "answer-040cac0d-ceb3-5aa4-b3ee-09a2f428db68" :answer/id #uuid "040cac0d-ceb3-5aa4-b3ee-09a2f428db68" :answer/type :answer.type/math :answer/value "{y}^{2}=-\\frac{2}{3}x" :db/ensure [:answer/validate]} {:db/id "answer-e0245b50-a16f-522a-94f9-37b20af9e5c4" :answer/id #uuid "e0245b50-a16f-522a-94f9-37b20af9e5c4" :answer/type :answer.type/math :answer/value "{y}^{2}=-\\frac{2}{9}x" :db/ensure [:answer/validate]} {:db/id "answer-8a1afc7d-7411-5523-bc97-b014798b52ab" :answer/id #uuid "8a1afc7d-7411-5523-bc97-b014798b52ab" :answer/type :answer.type/math :answer/value "{y}^{2}=9x" :db/ensure [:answer/validate]} {:db/id "answer-b070a6db-e004-52b8-9c3d-4d905814e58b" :answer/id #uuid "b070a6db-e004-52b8-9c3d-4d905814e58b" :answer/type :answer.type/math :answer/value "{y}^{2}=\\frac{3}{2}x" :db/ensure [:answer/validate]} {:db/id 17592186087940 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186083185 :knowledge-point/questions ["question-1b73902c-ad8b-52f6-bdea-d56e526c20d4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083894 :question/problem "Is the function $f(x)=\\frac{1}{{x}^{2}}$, for $x\\ne 0$, even, odd, or neither?" :question/worked-solution "Remember that\n\n- a function is even if $f(-x)=f(x)$ for all $x,$ while\n\n- a function is odd if $f(-x)=-f(x)$ for all $x.$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =\\frac{1}{(-x)^{2}} \\\\  & =\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nSince $f(-x)=f(x),$ the function is even.\n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(\\frac{1}{{x}^{2}}) \\\\  & =-\\frac{1}{{x}^{2}}.\\end{aligned}\n$$\n\nSince $f(-x)\\ne -f(x),$ the function is not odd.\n\nTherefore, the function is only even." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186082295 :answer-field/correct 17592186082297 :db/ensure [:answer-field/validate]} {:db/id 17592186083167 :knowledge-point/questions ["question-71f2cfbf-31cb-5074-ba4b-cb4c0df22324"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083675 :question/problem "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-23$ | $-15$ | $-7$ | $7$ | $15$ | $23$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $a+5$ | $-\\sqrt{2}$ | $b+1$ | $4$ | $-\\sqrt{2}$ | $6$ |" :question/worked-solution "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-23)=f(23),$ we obtain\n\n$$\n\\begin{aligned}f(-23) & =f(23) \\\\ a+5 & =6 \\\\ a & =1.\\end{aligned}\n$$\n\nUsing the fact that $f(-7)=f(7),$ we obtain\n\n$$\n\\begin{aligned}f(-7) & =f(7) \\\\ b+1 & =4 \\\\ b & =3.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=1+3=4.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186080981 :answer-field/correct 17592186080983 :db/ensure [:answer-field/validate]} {:db/id "question-1b73902c-ad8b-52f6-bdea-d56e526c20d4" :question/id #uuid "1b73902c-ad8b-52f6-bdea-d56e526c20d4" :question/math-academy-id "q-72131" :question/problem "Is the function $f(x)=6x$ even, odd, or neither?" :question/worked-solution "Recall that\n\n- a function is even if $f(-x)=f(x)$ for all $x$\n\n- a function is odd if $f(-x)=-f(x)$ for all $x$\n\nComputing $f(-x)$ for the given function and comparing it to $f(x),$ we have\n\n$$\n\\begin{aligned}f(-x) & =6(-x) \\\\  & =-6x\\end{aligned}\n$$\n\nSince $f(-x)\\ne f(x),$ the function is not even. \n\nLastly, we compute $-f(x)$ and get\n\n$$\n\\begin{aligned}-f(x) & =-(6x) \\\\  & =-6x\\end{aligned}\n$$\n\nSince $f(-x)=-f(x),$ the function is odd." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7744ee0a-5590-5bee-b223-157ef8ebf071"] :db/ensure [:question/validate]} {:db/id "answer-field-7744ee0a-5590-5bee-b223-157ef8ebf071" :answer-field/id #uuid "7744ee0a-5590-5bee-b223-157ef8ebf071" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-790f62a9-5b85-5ad8-99aa-12b309ae3d94" :answer-field/choices ["answer-0ba8a60b-baa6-5af0-9686-d3d8e8a4a09b" "answer-f9addbd9-40e1-582a-8e8e-69659487f294" "answer-f31eab5d-3671-5f28-812a-1245b40e2a75" "answer-781a4eaa-66ed-5f45-b66c-ceb488944744" "answer-790f62a9-5b85-5ad8-99aa-12b309ae3d94"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ba8a60b-baa6-5af0-9686-d3d8e8a4a09b" :answer/id #uuid "0ba8a60b-baa6-5af0-9686-d3d8e8a4a09b" :answer/type :answer.type/text :answer/value "Both even and odd" :db/ensure [:answer/validate]} {:db/id "answer-f9addbd9-40e1-582a-8e8e-69659487f294" :answer/id #uuid "f9addbd9-40e1-582a-8e8e-69659487f294" :answer/type :answer.type/text :answer/value "Even" :db/ensure [:answer/validate]} {:db/id "answer-f31eab5d-3671-5f28-812a-1245b40e2a75" :answer/id #uuid "f31eab5d-3671-5f28-812a-1245b40e2a75" :answer/type :answer.type/text :answer/value "It's not a function" :db/ensure [:answer/validate]} {:db/id "answer-781a4eaa-66ed-5f45-b66c-ceb488944744" :answer/id #uuid "781a4eaa-66ed-5f45-b66c-ceb488944744" :answer/type :answer.type/text :answer/value "Neither Even nor Odd" :db/ensure [:answer/validate]} {:db/id "answer-790f62a9-5b85-5ad8-99aa-12b309ae3d94" :answer/id #uuid "790f62a9-5b85-5ad8-99aa-12b309ae3d94" :answer/type :answer.type/text :answer/value "Odd" :db/ensure [:answer/validate]} {:db/id 17592186083166 :knowledge-point/questions ["question-f2ca34f0-80b3-509b-af1e-131cf84ebf9f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f2ca34f0-80b3-509b-af1e-131cf84ebf9f" :question/id #uuid "f2ca34f0-80b3-509b-af1e-131cf84ebf9f" :question/math-academy-id "q-72703" :question/problem "![](images/d4/d4cf4f9e1cc145154e5f542a5064b51d6385e7f81d12c7187dff436f5e7e10f9.png)\n\nWhich of the above could be graphs of odd functions?" :question/worked-solution "Recall that the graph of an odd function must have rotational symmetry of order $2$ about the origin.\n\n- Graphs II and III do not have rotational symmetry of order $2$ about the origin. So, they are **not** odd functions.\n\n- On the other hand, graphs I and IV do have rotational symmetry about the origin. If we rotate the graphs ${180}^{∘}$ around the origin, we get the same pictures. This means that graphs I and IV show odd functions.\n\n![](images/60/60a38abf4723f137ef0f824613ab15282c9ff5e3098fac13173630baef577e45.png)\n\nTherefore, the correct answer is \"I and IV only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bd416d50-8739-51d0-a2e4-b34b56fbb8eb"] :db/ensure [:question/validate]} {:db/id "answer-field-bd416d50-8739-51d0-a2e4-b34b56fbb8eb" :answer-field/id #uuid "bd416d50-8739-51d0-a2e4-b34b56fbb8eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a658323-9478-5cd3-bbe5-ee65e87c40c9" :answer-field/choices ["answer-6b569b29-0310-5803-aa5e-5c8b3097fb67" "answer-24bae23a-2b5c-5549-8d74-d4e7ed7715fd" "answer-9a658323-9478-5cd3-bbe5-ee65e87c40c9" "answer-a4de91ac-6edf-528c-8e95-7ba1adfbf5b0" "answer-4c5799db-521f-5c06-9242-e01b2fe426b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b569b29-0310-5803-aa5e-5c8b3097fb67" :answer/id #uuid "6b569b29-0310-5803-aa5e-5c8b3097fb67" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-24bae23a-2b5c-5549-8d74-d4e7ed7715fd" :answer/id #uuid "24bae23a-2b5c-5549-8d74-d4e7ed7715fd" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-9a658323-9478-5cd3-bbe5-ee65e87c40c9" :answer/id #uuid "9a658323-9478-5cd3-bbe5-ee65e87c40c9" :answer/type :answer.type/text :answer/value "I and IV only" :db/ensure [:answer/validate]} {:db/id "answer-a4de91ac-6edf-528c-8e95-7ba1adfbf5b0" :answer/id #uuid "a4de91ac-6edf-528c-8e95-7ba1adfbf5b0" :answer/type :answer.type/text :answer/value "II and IV only" :db/ensure [:answer/validate]} {:db/id "answer-4c5799db-521f-5c06-9242-e01b2fe426b4" :answer/id #uuid "4c5799db-521f-5c06-9242-e01b2fe426b4" :answer/type :answer.type/text :answer/value "III and IV only" :db/ensure [:answer/validate]} {:db/id "question-71f2cfbf-31cb-5074-ba4b-cb4c0df22324" :question/id #uuid "71f2cfbf-31cb-5074-ba4b-cb4c0df22324" :question/math-academy-id "q-110665" :question/problem "The table below defines the function $f(x).$ Given that $f(x)$ is an even function, find the value of $a+b.$\n\n| **$x$** | $-90$ | $-65$ | $-40$ | $40$ | $65$ | $90$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $16$ | $b-2$ | $-8$ | $-8$ | $-1$ | $a+6$ |" :question/worked-solution "Since $f(x)$ is an even function, we must have that $f(-x)=f(x).$ \n\nUsing the fact that $f(-90)=f(90),$ we obtain\n\n$$\n\\begin{aligned}f(-90) & =f(90) \\\\ 16 & =a+6 \\\\ a & =10.\\end{aligned}\n$$\n\nUsing the fact that $f(-65)=f(65),$ we obtain\n\n$$\n\\begin{aligned}f(-65) & =f(65) \\\\ b-2 & =-1 \\\\ b & =1.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b=10+1=11.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-987364e2-83c5-563b-a86c-5c9e8d2fcffd"] :db/ensure [:question/validate]} {:db/id "answer-field-987364e2-83c5-563b-a86c-5c9e8d2fcffd" :answer-field/id #uuid "987364e2-83c5-563b-a86c-5c9e8d2fcffd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ca604a35-1898-54ea-be79-3d86d2c26139" :answer-field/choices ["answer-7c2efd2b-f00a-593f-bb81-c9dd053ed073" "answer-e5951a84-f04c-5c6f-9a06-d5001b3dda61" "answer-ca604a35-1898-54ea-be79-3d86d2c26139" "answer-da8a3e87-40ac-5983-bfbe-cf585598fdf8" "answer-bb33137b-01b7-5b1b-99cc-1a5450ea9b72"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c2efd2b-f00a-593f-bb81-c9dd053ed073" :answer/id #uuid "7c2efd2b-f00a-593f-bb81-c9dd053ed073" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-e5951a84-f04c-5c6f-9a06-d5001b3dda61" :answer/id #uuid "e5951a84-f04c-5c6f-9a06-d5001b3dda61" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-ca604a35-1898-54ea-be79-3d86d2c26139" :answer/id #uuid "ca604a35-1898-54ea-be79-3d86d2c26139" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-da8a3e87-40ac-5983-bfbe-cf585598fdf8" :answer/id #uuid "da8a3e87-40ac-5983-bfbe-cf585598fdf8" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-bb33137b-01b7-5b1b-99cc-1a5450ea9b72" :answer/id #uuid "bb33137b-01b7-5b1b-99cc-1a5450ea9b72" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "activity-f7531106-8081-593d-b221-3db6da6b1b3b" :activity/id #uuid "f7531106-8081-593d-b221-3db6da6b1b3b" :activity/title "Even and Odd Functions" :activity/type :activity.type/review :activity/scope 17592186049873 :activity/course 17592186046647 :activity/steps ["step-d955d2cc-d916-5f24-af15-9912f4a42329" "step-dc6fbc89-df59-502f-a5d5-280777efba84" "step-f9fbce21-df1a-5096-ad2f-9cba5ddbace4" "step-ed0e6744-5277-5979-857b-90d5d86b76ba" "step-b7a0c930-adde-574d-8760-a44307f3040c"] :activity/first-step "step-d955d2cc-d916-5f24-af15-9912f4a42329" :db/ensure [:activity/validate]} {:db/id "step-d955d2cc-d916-5f24-af15-9912f4a42329" :step/id #uuid "d955d2cc-d916-5f24-af15-9912f4a42329" :step/content 17592186083894 :step/next "step-dc6fbc89-df59-502f-a5d5-280777efba84" :db/ensure [:step/validate]} {:db/id "step-dc6fbc89-df59-502f-a5d5-280777efba84" :step/id #uuid "dc6fbc89-df59-502f-a5d5-280777efba84" :step/content 17592186083675 :step/next "step-f9fbce21-df1a-5096-ad2f-9cba5ddbace4" :db/ensure [:step/validate]} {:db/id "step-f9fbce21-df1a-5096-ad2f-9cba5ddbace4" :step/id #uuid "f9fbce21-df1a-5096-ad2f-9cba5ddbace4" :step/content "question-1b73902c-ad8b-52f6-bdea-d56e526c20d4" :step/next "step-ed0e6744-5277-5979-857b-90d5d86b76ba" :db/ensure [:step/validate]} {:db/id "step-ed0e6744-5277-5979-857b-90d5d86b76ba" :step/id #uuid "ed0e6744-5277-5979-857b-90d5d86b76ba" :step/content "question-f2ca34f0-80b3-509b-af1e-131cf84ebf9f" :step/next "step-b7a0c930-adde-574d-8760-a44307f3040c" :db/ensure [:step/validate]} {:db/id "step-b7a0c930-adde-574d-8760-a44307f3040c" :step/id #uuid "b7a0c930-adde-574d-8760-a44307f3040c" :step/content "question-71f2cfbf-31cb-5074-ba4b-cb4c0df22324" :db/ensure [:step/validate]} [:db/retract 17592186095303 :answer-field/choices 17592186095304] [:db/retract 17592186095303 :answer-field/choices 17592186095305] [:db/retract 17592186095303 :answer-field/choices 17592186095306] [:db/retract 17592186095303 :answer-field/choices 17592186095307] [:db/retract 17592186095303 :answer-field/choices 17592186095308] [:db/retract 17592186095183 :answer-field/choices 17592186095184] [:db/retract 17592186095183 :answer-field/choices 17592186095185] [:db/retract 17592186095183 :answer-field/choices 17592186095186] [:db/retract 17592186095183 :answer-field/choices 17592186095187] [:db/retract 17592186095183 :answer-field/choices 17592186095188] {:db/id 17592186096764 :knowledge-point/questions ["question-923c9707-06d1-5031-b8df-221476502c14" "question-b5e827a7-4590-5f6c-9029-38608edd38d6" "question-bfc9867e-24b3-5baa-adb5-18feba56d583" "question-a2e19710-89b7-5129-86a4-6f0be5f110ca" "question-417976f8-e97d-5f88-9ef3-7e599b484745"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096569 :question/worked-solution "First, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/59/59041e6817cbf26f9de00de0ec864cea57f1a419877fe5c3203857c5488c7324.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=-2x,$ and\n\n- *leaves* though the outer curver $y=2x^2.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=2x^2.$\n\n![](images/07/0761073a5f7f417a07f35cb0b7c08dd0b4ea6bd84da71f3e474911ee036c546b.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{0}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}{[\\,(3)-(2{x}^{2})\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}{[3-2{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=-2x.$\n\n![](images/9e/9ea5e5dd50dcd623532557e5365118ae5c9b950be059ba8c0069c7b36071f2c3.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{0}{[\\,(\\text{upper})-(\\text{lower})\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}{[\\,(3)-(-2x)\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}{[3+2x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{0}{[3-2{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{-1}^{0}{[3+2x]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{0}({[3-2{x}^{2}]}^{2}-{[3+2x]}^{2})\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186096729 :knowledge-point/questions ["question-d651054f-0a78-573d-a5b9-95d84b459c37" "question-5d03566e-e00c-5038-a04e-9a446a86a195" "question-b034c5b9-fc9c-52d3-a856-d07f183d8ea8" "question-25934858-d636-5a89-8459-35c28b65815f"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096531 :question/problem "The region below enclosed by the curves $y=\\sqrt x$ and $y=x$ is rotated $2\\pi$ radians about the line $y=1.$ Find the volume of the resulting solid. \n\n![](images/36/362a92640ed68dfd5fa85f0338d95233003e9f8a1b059a5dffa2cda243a1411b.png)" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\eqalign{\n \t\tx & =\\sqrt x  \\[3pt]\n \t\tx-\\sqrt x & = 0 \\[3pt]\n \t\t\\sqrt x \\left(\\sqrt x - 1\\right) &= 0 \\[3pt]\n \t\t\tx& = 0, 1\n\t}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/54/5456bed18c03e823c8e9388571b5671f5f476f5caa1085793314b57080b2b07c.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=\\sqrt{x},$ and\n\n- *leaves* though the outer curver $y=x.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=x.$\n\n![](images/51/5136903876ed5ea811ebf28e0da905b5029b2c9311527fce9d0fed8e7bd1dd46.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(1)-(x)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1-x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=\\sqrt{x}.$\n\n![](images/c8/c850643bb1c315d0516eff55d6270078504c1c98687cfac40e0c9b4b2c771b7c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(1)-(\\sqrt{x})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1-\\sqrt{x}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\eqalign{\nV &= {\\color{blue}V_{\\text{outer}}} - {\\color{brown}V_{\\text{inner}}} \\[5pt]\n \t\t& = \\pi \\int_0^1 [1-x]^2 - \\pi \\int_0^1 [1-\\sqrt x]^2\\,\\textrm d x \\[5pt]\n \t\t& = \\pi \\int_0^1 \\left((1-x)^2 - (1-\\sqrt x)^2\\right) \\,\\textrm d x \\[5pt]\n \t\t& = \\pi \\int_0^1 (x^2-3x+2\\sqrt x) \\,\\,\\textrm d x \\[5pt]\n \t\t& = \\pi\\left. \\left( \\dfrac {1} 3 x^3 - \\dfrac{3}{2} x^2 + \\dfrac{4}{3} x^{3/2 } \\ \\right)\\right|_0^1\\[5pt] \n \t\t& =  \\pi \\left[\\left( \\dfrac {1}3 (1)^3 - \\dfrac{3}{2}(1)^2  + \\dfrac{4 }{3}(1)^{3/2 } \\right) - (0) \\right]\\[5pt]\n \t\t& =  \\pi \\left(\\dfrac{1}3 - \\dfrac{3}{2} +\\dfrac{4}{3} \\right)\\[5pt]\n \t\t& = \\dfrac {\\pi}{6} .\n \t\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186096765 :knowledge-point/questions ["question-0ad0e9c9-a63e-55c4-a91b-b9b32de9ed5c" "question-88a251ee-6143-5e86-bf44-46f8b33042cc" "question-dd731e5d-ee05-5b06-811e-7a9b6ae9709a" "question-6be7f528-8a2e-5e94-a08f-bb7c33bc8c26" "question-a2f8487e-855b-5e52-8eac-210ae0123755"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096570 :question/problem "The region enclosed by the curves $x=-y^2$ and $x = -y$ is rotated $360^\\circ$ about the line $x={1}.$ Find an integral that gives the volume of the resulting solid.\n\n![](images/64/6471c937fb79a2266188668ebdb698eb926655b6002f8f259410b96efcb15247.png)" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}-{y}^{2} & =-y \\\\ {y}^{2}-y & =0 \\\\ y(y-1) & =0 \\\\ y & =0,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y=1.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/4d/4da6108728a226e19cea708a09381c9054b129590d2a6d2c07fbfacdc30367a5.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=-{y}^2,$ and\n\n- *leaves* though the outer curve $x=-y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=-y.$\n\n![](images/02/02798e08e1eb8cae41e4754cfed267401298d454ce2ef856f47f2ae87a8543ee.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[\\,(1)-(-y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[1+y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=-{y}^2.$\n\n![](images/5c/5c5e2060b1321856349719987e43b3424d49b465255295b8777002d85cbe6792.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[\\,(1)-(-{y}^{2})\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[1+{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[1+y]}^{2}\\,\\text{d}y-\\pi {\\int }_{0}^{1}{[1+{y}^{2}]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({[1+y]}^{2}-{[1+{y}^{2}]}^{2})\\text{d}y.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186096730 :knowledge-point/questions ["question-db9dcd58-6ee1-5525-a1ac-d82114a9c0f2" "question-fc2bc671-1b50-5524-a44c-d196ad9a937f" "question-0c99954c-8e68-5e26-befe-7d930f5b079f" "question-92412be4-49e1-54ee-8609-445cb6da4a1d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186096532 :question/problem "The region enclosed by the curves $x=y^2$ and $x=2-y^2$ is rotated $2\\pi$ radians about the line $x=-1.$ Find the volume of the resulting solid.\n\n![](images/e8/e8f0f999521058f3213e11bd3df67a95a6ea8604e6853d06923ffbba6cf9d17c.png)" :question/worked-solution "First, to determine the limits of integration, we find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{y}^{2} & =2-{y}^{2} \\\\ 2{y}^{2} & =2 \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=-1$ to $y=1.$\n\nNext, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/c3/c3c9217600a26e11614752b2ca2ac8b3aa6c12b0df9f3a8c13d2b32c5b338107.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=y^2,$ and\n\n- *leaves* though the outer curve $x={2-y^2}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of outer and inner solids.\n\n- **Step I.** Figure out the volume generated by the outer curve $x={2-y^2}.$\n\n![](images/36/3696bac064f5157b5c4ab3aefe34128d2d126a0a6b586106eb1e439bc90e7df5.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[\\,(2-{y}^{2})-(-1)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[3-{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=y^2.$\n\n![](images/f5/f59ee5966f0cb9572d00e7f7278a7462841aef6b18f4865924303ad65b50738c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}[\\,({y}^{2})-(-1)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[{y}^{2}+1]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{1}{[3-{y}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{-1}^{1}{[{y}^{2}+1]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}({[3-{y}^{2}]}^{2}-{[{y}^{2}+1]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}(8-8{y}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {(8y-\\frac{8{y}^{3}}{3})|}_{-1}^{1} \\\\  & =\\pi [(8-\\frac{8}{3})-(-8+\\frac{8}{3})] \\\\  & =\\pi (\\frac{32}{3}) \\\\  & =\\frac{32\\pi }{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-923c9707-06d1-5031-b8df-221476502c14" :question/id #uuid "923c9707-06d1-5031-b8df-221476502c14" :question/math-academy-id "q-30045" :question/problem "![](images/43/43cff74165732892223841f6780e7aa22c024e3b3c173e60ce15d8d6841a5a08.png)\n\nThe region enclosed by the curves $y={x}^{2}-1$ and $y=-\\frac{3}{2}x$ for $x\\in [-2,\\frac{1}{2}]$ is rotated $2\\pi $ radians about the line $y=5.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "Let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/7a/7aad98fe0513514aa8827bea4e9ffbac5b70bcb8da7923effd789988c81e286f.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=-\\frac{3}{2}x,$ and\n\n- *leaves* through the outer curve $y={x}^{2}-1.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={x}^{2}-1.$\n\n![](images/62/623b59b7aca8b33c6149ac6b0916d1eeb425adc3f74568868383806cd9b03b12.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-2}^{1/2}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1/2}[\\,(5)-({x}^{2}-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1/2}{[6-{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=-\\frac{3}{2}x.$\n\n![](images/c0/c0467a3bf02287589f897586a1358e4abb02759134b6b58622125319dc7331da.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-2}^{1/2}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1/2}{[\\,(5)-(-\\frac{3}{2}x)\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1/2}{[5+\\frac{3}{2}x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-2}^{1/2}{[6-{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{-2}^{1/2}{[5+\\frac{3}{2}x]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{1/2}({[6-{x}^{2}]}^{2}-{[5+\\frac{3}{2}x]}^{2})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-279f0e25-70bd-5ea5-9539-e50f5ef9c3b7"] :db/ensure [:question/validate]} {:db/id "answer-field-279f0e25-70bd-5ea5-9539-e50f5ef9c3b7" :answer-field/id #uuid "279f0e25-70bd-5ea5-9539-e50f5ef9c3b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0e428057-03fb-5069-bc10-8f485b235085" :answer-field/choices ["answer-22a2ea8b-dab7-5699-8e84-0ecaba7bd180" "answer-de2ba3e0-ce17-5d40-841f-829521df6752" "answer-0e428057-03fb-5069-bc10-8f485b235085" "answer-b604d99c-c5fb-5b46-b2b9-bfe266992e0c" "answer-ba912d5b-c16a-5c98-8772-74fb6eb18f48"] :db/ensure [:answer-field/validate]} {:db/id "answer-22a2ea8b-dab7-5699-8e84-0ecaba7bd180" :answer/id #uuid "22a2ea8b-dab7-5699-8e84-0ecaba7bd180" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1/2}({[5+\\frac{3}{2}x]}^{2}-{[6-{x}^{2}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-de2ba3e0-ce17-5d40-841f-829521df6752" :answer/id #uuid "de2ba3e0-ce17-5d40-841f-829521df6752" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1/2}({[6-{x}^{2}]}^{2}+{5}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-0e428057-03fb-5069-bc10-8f485b235085" :answer/id #uuid "0e428057-03fb-5069-bc10-8f485b235085" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1/2}({[6-{x}^{2}]}^{2}-{[5+\\frac{3}{2}x]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b604d99c-c5fb-5b46-b2b9-bfe266992e0c" :answer/id #uuid "b604d99c-c5fb-5b46-b2b9-bfe266992e0c" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1/2}({[\\frac{3}{2}x]}^{2}-{[1-{x}^{2}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ba912d5b-c16a-5c98-8772-74fb6eb18f48" :answer/id #uuid "ba912d5b-c16a-5c98-8772-74fb6eb18f48" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{1/2}{[5+\\frac{3}{2}x]}^{2}\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-b5e827a7-4590-5f6c-9029-38608edd38d6" :question/id #uuid "b5e827a7-4590-5f6c-9029-38608edd38d6" :question/math-academy-id "q-124601" :question/problem "![](images/dc/dccfcb991a6c302c522ea73381544d2e6f93b7310f54040151a00832473596b8.png)\n\nThe region enclosed by the curves $y=8x$ and $y=-{x}^{4}$ for $x\\in [-2,0]$ is rotated $2\\pi $ radians about the line $y=1.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "Let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/33/335b300d66c7a51a37d595f5fb99a281c00ec6a5be62e1be12c2a3104cd54694.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=-{x}^{4},$ and\n\n- *leaves* through the outer curve $y=8x.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=8x.$\n\n![](images/aa/aae56ea01faa2c09f004fe2506c036f4d5e5b2e591e2e653f4794e4a3cecc309.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-2}^{0}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{0}[\\,(1)-(8x)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{0}{[1-8x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=-{x}^{4}.$\n\n![](images/63/635d3aabdc16fd90c2e2a06a042f98abe5dc16f1d7747394cd9083858023adee.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-2}^{0}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{0}[\\,(1)-(-{x}^{4})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{0}{[1+{x}^{4}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-2}^{0}{[1-8x]}^{2}\\,\\text{d}x-\\pi {\\int }_{-2}^{0}{[1+{x}^{4}]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-2}^{0}({[1-8x]}^{2}-{[1+{x}^{4}]}^{2})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2653d026-3ae7-59aa-9fa9-e9cc01abc497"] :db/ensure [:question/validate]} {:db/id "answer-field-2653d026-3ae7-59aa-9fa9-e9cc01abc497" :answer-field/id #uuid "2653d026-3ae7-59aa-9fa9-e9cc01abc497" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bd28678f-f932-5c98-b9b4-933262b0cff3" :answer-field/choices ["answer-bd28678f-f932-5c98-b9b4-933262b0cff3" "answer-4de03e91-0e5b-5d78-b5c9-5f081a9cc132" "answer-06fbe30c-ec79-58b6-8bee-4aaf26e7c91c" "answer-7fc93862-a6af-52a4-8d50-916919b94dd5" "answer-0bb28b7f-f876-58cc-9f27-8c5979268f26"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd28678f-f932-5c98-b9b4-933262b0cff3" :answer/id #uuid "bd28678f-f932-5c98-b9b4-933262b0cff3" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}({[1-8x]}^{2}-{[1+{x}^{4}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-4de03e91-0e5b-5d78-b5c9-5f081a9cc132" :answer/id #uuid "4de03e91-0e5b-5d78-b5c9-5f081a9cc132" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}({[8x+1]}^{2}-{[{x}^{4}+1]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-06fbe30c-ec79-58b6-8bee-4aaf26e7c91c" :answer/id #uuid "06fbe30c-ec79-58b6-8bee-4aaf26e7c91c" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}({[8x-{x}^{4}]}^{2}-1)\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-7fc93862-a6af-52a4-8d50-916919b94dd5" :answer/id #uuid "7fc93862-a6af-52a4-8d50-916919b94dd5" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}{(1+8x-{x}^{4})}^{2}\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-0bb28b7f-f876-58cc-9f27-8c5979268f26" :answer/id #uuid "0bb28b7f-f876-58cc-9f27-8c5979268f26" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}{({x}^{4}-8x)}^{2}\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-bfc9867e-24b3-5baa-adb5-18feba56d583" :question/id #uuid "bfc9867e-24b3-5baa-adb5-18feba56d583" :question/math-academy-id "q-30046" :question/problem "![](images/c2/c2a8da9dd6d088d30b0b023d50ebf2c23e2bcfda89cd390ec16779694ae5eb39.png)\n\nThe region enclosed by the curves $y={x}^{3}$ and $y=x$ in the first quadrant is rotated $2\\pi $ radians about the line $y=2.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{3} & =x \\\\ {x}^{3}-x & =0 \\\\ x({x}^{2}-1) & =0 \\\\ x & =-1,0,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/82/82783afd970ec3f0e90a8b97a12207b0ed8cbf82323e0512e9fe36b99a6fdc2f.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=x,$ and\n\n- *leaves* through the outer curve $y={x}^{3}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={x}^{3}.$\n\n![](images/4a/4a9a72a194226f73da234e03b93e4b255849315808ac948c0958d8dee52b4f73.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(2)-({x}^{3})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[2-{x}^{3}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=x.$\n\n![](images/4c/4c53b4b1ad169119cadf490636b12235b3fc225a08d57c11d4f8e26318797f25.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(2)-(x)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[2-x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[2-{x}^{3}]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[2-x]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[2-{x}^{3}]}^{2}-{[2-x]}^{2})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2b388436-18ed-5b93-906f-1dc37334a242"] :db/ensure [:question/validate]} {:db/id "answer-field-2b388436-18ed-5b93-906f-1dc37334a242" :answer-field/id #uuid "2b388436-18ed-5b93-906f-1dc37334a242" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-70798353-c69b-5617-a2cd-3fa3a1c92bdf" :answer-field/choices ["answer-8dfc17f0-061c-50c1-9e66-8930961ad9b4" "answer-f9a2ce51-d59b-5b33-9751-62df0da2f6b9" "answer-4143ee0b-f61f-5bed-8dea-57c109e9d3fd" "answer-70798353-c69b-5617-a2cd-3fa3a1c92bdf" "answer-5d1f436d-ae2c-50df-a1f4-1d944523dcf2"] :db/ensure [:answer-field/validate]} {:db/id "answer-8dfc17f0-061c-50c1-9e66-8930961ad9b4" :answer/id #uuid "8dfc17f0-061c-50c1-9e66-8930961ad9b4" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}({[2-x]}^{2}-{[2-{x}^{3}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-f9a2ce51-d59b-5b33-9751-62df0da2f6b9" :answer/id #uuid "f9a2ce51-d59b-5b33-9751-62df0da2f6b9" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{1}({x}^{3}-x)\\,\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-4143ee0b-f61f-5bed-8dea-57c109e9d3fd" :answer/id #uuid "4143ee0b-f61f-5bed-8dea-57c109e9d3fd" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}(x-{x}^{3})\\,\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-70798353-c69b-5617-a2cd-3fa3a1c92bdf" :answer/id #uuid "70798353-c69b-5617-a2cd-3fa3a1c92bdf" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}({[2-{x}^{3}]}^{2}-{[2-x]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-5d1f436d-ae2c-50df-a1f4-1d944523dcf2" :answer/id #uuid "5d1f436d-ae2c-50df-a1f4-1d944523dcf2" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{1}({[2-{x}^{3}]}^{2}-{x}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-a2e19710-89b7-5129-86a4-6f0be5f110ca" :question/id #uuid "a2e19710-89b7-5129-86a4-6f0be5f110ca" :question/math-academy-id "q-30047" :question/problem "![](images/cf/cf2c500974f9c88751b9dec98cc53b5d3616b736f3ab0504adae5879cac2001a.png)\n\nThe region enclosed by the curves $y=2{x}^{2}-2x$ and $y=3-3{x}^{2}$ for $x\\in [-\\frac{3}{5},1]$ is rotated $2\\pi $ radians about the line $y=5.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "Let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/d5/d5593e8c1e1d544acb8824d9428823d3d6cef3971a1cedd4b087a7902b0e2239.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=3-3{x}^{2},$ and\n\n- *leaves* through the outer curve $y=2{x}^{2}-2x.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=2{x}^{2}-2x.$\n\n![](images/bd/bddc78f683e28ec6e97fddb32f95dfdaaff27d3aafbdfc61f424857916f81a6c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-3/5}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3/5}^{1}[\\,(5)-(2{x}^{2}-2x)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3/5}^{1}{[5-2{x}^{2}+2x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=3-3{x}^{2}.$\n\n![](images/cc/cc049c46593baf1d96c04b95680d6b444ab9ceffc64d1f23f310f70e78684c14.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-3/5}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3/5}^{1}[\\,(5)-(3-3{x}^{2})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3/5}^{1}{[2+3{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-3/5}^{1}{[5-2{x}^{2}+2x]}^{2}\\,\\text{d}x-\\pi {\\int }_{-3/5}^{1}{[2+3{x}^{2}]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3/5}^{1}({[5-2{x}^{2}+2x]}^{2}-{[2+3{x}^{2}]}^{2})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-527a8b8b-3d1f-5a1f-9fab-9a12c4893e26"] :db/ensure [:question/validate]} {:db/id "answer-field-527a8b8b-3d1f-5a1f-9fab-9a12c4893e26" :answer-field/id #uuid "527a8b8b-3d1f-5a1f-9fab-9a12c4893e26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2c41717b-c907-5031-97ec-c6ceee1cef10" :answer-field/choices ["answer-662f9b8b-3b6f-5917-96ff-e6a29123f219" "answer-2c41717b-c907-5031-97ec-c6ceee1cef10" "answer-bd2b46ce-9749-5847-8d8e-c71feca07989" "answer-ef590c46-ffb7-51f4-b8a4-b0f49dc57c37" "answer-79083731-d85c-58a3-ad1e-660ad2fcee5f"] :db/ensure [:answer-field/validate]} {:db/id "answer-662f9b8b-3b6f-5917-96ff-e6a29123f219" :answer/id #uuid "662f9b8b-3b6f-5917-96ff-e6a29123f219" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-3/5}^{1}({[5+3{x}^{2}]}^{2}-{[7-2{x}^{2}+2x]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-2c41717b-c907-5031-97ec-c6ceee1cef10" :answer/id #uuid "2c41717b-c907-5031-97ec-c6ceee1cef10" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-3/5}^{1}({[5-2{x}^{2}+2x]}^{2}-{[2+3{x}^{2}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-bd2b46ce-9749-5847-8d8e-c71feca07989" :answer/id #uuid "bd2b46ce-9749-5847-8d8e-c71feca07989" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-3/5}^{1}({[7-2{x}^{2}+2x]}^{2}-{[5+3{x}^{2}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ef590c46-ffb7-51f4-b8a4-b0f49dc57c37" :answer/id #uuid "ef590c46-ffb7-51f4-b8a4-b0f49dc57c37" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{3/5}^{1}({[5-2{x}^{2}+2x]}^{2}+{[2+3{x}^{2}]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-79083731-d85c-58a3-ad1e-660ad2fcee5f" :answer/id #uuid "79083731-d85c-58a3-ad1e-660ad2fcee5f" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{3/5}^{1}({x}^{2}+2x-3)^{2}\\,\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-417976f8-e97d-5f88-9ef3-7e599b484745" :question/id #uuid "417976f8-e97d-5f88-9ef3-7e599b484745" :question/math-academy-id "q-124592" :question/problem "![](images/ae/ae4ec1bfc4bf15f8ae4d79492389dd6a3fb5e3c504b0d99a43466fc08bd4b63e.png)\n\nThe region enclosed by the curves $y={e}^{{x}^{2}}$ and $y={e}^{x+2}$ for $x\\in [-1,2]$ is rotated $2\\pi $ radians about the line $y=-2.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "Let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/74/742602117733f7e0f8fa89931ff11cdfa483c3d878a99445ec1408de6aea8f30.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y={e}^{{x}^{2}},$ and\n\n- *leaves* through the outer curve $y={e}^{x+2}.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={e}^{x+2}.$\n\n![](images/b6/b6d2a21d75b441ca5c7c76320aad11b4dded17052056f8828e5c93b068b9bad3.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{2}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}{[\\,({e}^{x+2})-(-2)\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}{[{e}^{x+2}+2]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y={e}^{{x}^{2}}.$\n\n![](images/1e/1e84714cd64d30cbb4f73c93fc6dfdfeb12f10422f0524d754906709a9a26ff6.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{2}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}{[\\,({e}^{{x}^{2}})-(-2)\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}{[{e}^{{x}^{2}}+2]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{2}{[{e}^{x+2}+2]}^{2}\\,\\text{d}x-\\pi {\\int }_{-1}^{2}{[{e}^{{x}^{2}}+2]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{2}({[{e}^{x+2}+2]}^{2}-{[{e}^{{x}^{2}}+2]}^{2})\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2049346e-586b-5a5e-af30-da5cacb1a93c"] :db/ensure [:question/validate]} {:db/id "answer-field-2049346e-586b-5a5e-af30-da5cacb1a93c" :answer-field/id #uuid "2049346e-586b-5a5e-af30-da5cacb1a93c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddc3e9da-e922-5c37-9179-45b1d4651dab" :answer-field/choices ["answer-572833d5-60e0-53a8-92f2-a28672879db5" "answer-ddc3e9da-e922-5c37-9179-45b1d4651dab" "answer-521c38e0-963d-5c0c-82f3-c666e0af9dec" "answer-81318686-d93c-58d7-b209-cc8733025493" "answer-97d82ed7-ae24-5b08-afed-504bead47649"] :db/ensure [:answer-field/validate]} {:db/id "answer-572833d5-60e0-53a8-92f2-a28672879db5" :answer/id #uuid "572833d5-60e0-53a8-92f2-a28672879db5" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}(({e}^{x+2}+2)-({e}^{{x}^{2}}+2))\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-ddc3e9da-e922-5c37-9179-45b1d4651dab" :answer/id #uuid "ddc3e9da-e922-5c37-9179-45b1d4651dab" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({[{e}^{x+2}+2]}^{2}-{[{e}^{{x}^{2}}+2]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-521c38e0-963d-5c0c-82f3-c666e0af9dec" :answer/id #uuid "521c38e0-963d-5c0c-82f3-c666e0af9dec" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}({[{e}^{{x}^{2}}+2]}^{2}-{[{e}^{x+2}+2]}^{2})\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-81318686-d93c-58d7-b209-cc8733025493" :answer/id #uuid "81318686-d93c-58d7-b209-cc8733025493" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}{({e}^{x+2}+2)}^{2}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-97d82ed7-ae24-5b08-afed-504bead47649" :answer/id #uuid "97d82ed7-ae24-5b08-afed-504bead47649" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{2}{({e}^{{x}^{2}}+2)}^{2}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "question-d651054f-0a78-573d-a5b9-95d84b459c37" :question/id #uuid "d651054f-0a78-573d-a5b9-95d84b459c37" :question/math-academy-id "q-361808" :question/problem "![](images/5a/5a242a5bec4be4cb58b77289ea2ccf49bf22a368c19ec18f10790a417bfbff72.png)\n\nThe region shown above enclosed by the curves $y=3-x$ and $y={x}^{2}$ for $x\\in [0,1]$ is rotated $2\\pi $ radians about the line $y=4.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/25/255abcfb1a9034df297dc4939d945d8c3b1c4bd717cebde2844aa2a229fd5258.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=3-x,$ and\n\n- *leaves* through the outer curve $y={x}^{2}.$\n\nNow, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={x}^{2}.$\n\n![](images/4b/4b480a3bb7312a59edcabb133100bee1ebd5777664ea490b58744171e05e3083.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(4)-({x}^{2})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[4-{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=3-x.$\n\n![](images/20/20de93738463a5b04c0c5c0884d1db7d8867503931122c99a27fc82493b64edb.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(4)-(3-x)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1+x]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[4-{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[1+x]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({(4-{x}^{2})}^{2}-{(1+x)}^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({x}^{4}-9{x}^{2}-2x+15)\\,\\,\\text{d}x \\\\  & =\\pi {(\\frac{1}{5}{x}^{5}-3{x}^{3}-{x}^{2}+15x)|}_{0}^{1} \\\\  & =\\pi [(\\frac{1}{5}(1)^{5}-3(1)^{3}-(1)^{2}+15(1))-0] \\\\  & =\\pi (\\frac{1}{5}-3-1+15) \\\\  & =\\pi (11+\\frac{1}{5}) \\\\  & =\\pi (\\frac{55}{5}+\\frac{1}{5}) \\\\  & =\\frac{56\\pi }{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-32684ee3-c288-58d9-93e1-88b30f665d28"] :db/ensure [:question/validate]} {:db/id "answer-field-32684ee3-c288-58d9-93e1-88b30f665d28" :answer-field/id #uuid "32684ee3-c288-58d9-93e1-88b30f665d28" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a4f9d099-d483-540e-9e95-fcbce5c20534" :answer-field/choices ["answer-a4f9d099-d483-540e-9e95-fcbce5c20534"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4f9d099-d483-540e-9e95-fcbce5c20534" :answer/id #uuid "a4f9d099-d483-540e-9e95-fcbce5c20534" :answer/type :answer.type/math :answer/value "\\frac{56\\pi}{5}" :db/ensure [:answer/validate]} {:db/id "question-5d03566e-e00c-5038-a04e-9a446a86a195" :question/id #uuid "5d03566e-e00c-5038-a04e-9a446a86a195" :question/math-academy-id "q-361829" :question/problem "![](images/77/778041d84c40044d6f047203a017bd64c0569bcfc9442afca9baa5160b494ae7.png)\n\nThe region shown above enclosed by the curves $y=\\sqrt{x}+1$ and $y=\\frac{x}{2}+1$ is rotated $2\\pi $ radians about the line $y=-1.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\sqrt{x}+1 & =\\frac{x}{2}+1 \\\\ \\sqrt{x} & =\\frac{x}{2} \\\\ 2\\sqrt{x} & =x \\\\ x & =0,4\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=4.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/7c/7ce02bca7667a9c32971b7840ff2ba4b96ef3a5c9b18aceaeb5b9b713cc7b36f.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=\\frac{x}{2}+1,$ and\n\n- *leaves* through the outer curve $y=\\sqrt{x}+1.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=\\sqrt{x}+1.$\n\n![](images/6c/6cb557a57a189a426b6cccacd599562332b05aace5bbbfc5d996b0d53fed3359.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{4}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}[\\,(\\sqrt{x}+1)-(-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}{[\\sqrt{x}+2]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=\\frac{x}{2}+1.$\n\n![](images/26/26886afd61251cae273c086dba59dcfa912665cdb788b0c3ef866bf61907efa2.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{4}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}[\\,(\\frac{x}{2}+1)-(-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}{[\\frac{x}{2}+2]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{4}{[\\sqrt{x}+2]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{4}{[\\frac{x}{2}+2]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}({(\\sqrt{x}+2)}^{2}-{(\\frac{x}{2}+2)}^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{4}(-\\frac{{x}^{2}}{4}-x+4\\sqrt{x})\\,\\,\\text{d}x \\\\  & =\\pi {(-\\frac{1}{12}\\,{x}^{3}-\\frac{1}{2}\\,{x}^{2}+\\frac{8}{3}\\,{x}^{3/2})|}_{0}^{4} \\\\  & =\\pi ((-\\frac{1}{12}\\,(4)^{3}-\\frac{1}{2}\\,(4)^{2}+\\frac{8}{3}\\,(4)^{3/2})-(0)) \\\\  & =\\pi (8) \\\\  & =8\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7cd8ab93-f2fe-5eea-85cd-ce5fd45592c9"] :db/ensure [:question/validate]} {:db/id "answer-field-7cd8ab93-f2fe-5eea-85cd-ce5fd45592c9" :answer-field/id #uuid "7cd8ab93-f2fe-5eea-85cd-ce5fd45592c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6c5a170f-7065-5de8-8d67-32ce20245ec0" :answer-field/choices ["answer-6c5a170f-7065-5de8-8d67-32ce20245ec0"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c5a170f-7065-5de8-8d67-32ce20245ec0" :answer/id #uuid "6c5a170f-7065-5de8-8d67-32ce20245ec0" :answer/type :answer.type/math :answer/value "8\\pi" :db/ensure [:answer/validate]} {:db/id "question-b034c5b9-fc9c-52d3-a856-d07f183d8ea8" :question/id #uuid "b034c5b9-fc9c-52d3-a856-d07f183d8ea8" :question/math-academy-id "q-350914" :question/problem "![](images/80/8063ba9fbe4c569519eea27e5a5cd69a8f0e708b03d153942fbf22e9345af96a.png)\n\nThe region above enclosed by the curves $y={x}^{2}+2$ and $y=20-{x}^{2}$ is rotated $2\\pi $ radians about the line $y=20.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{2}+2 & =20-{x}^{2} \\\\ 2{x}^{2} & =18 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=-3$ to $x=3.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/f1/f196ef4a3b29a9d62609b0a9290f34d2cb1ef1351baa4883441fd89e9345e4ed.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=20-{x}^{2},$ and\n\n- *leaves* through the outer curve $y={x}^{2}+2.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={x}^{2}+2.$\n\n![](images/c0/c006e66d82e0059b341520bebe983fa75ed144e3050ca8c4493a4b6df3e8f352.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-3}^{3}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}[\\,(20)-({x}^{2}+2)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}{[18-{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=20-{x}^{2}.$\n\n![](images/c9/c91a8e5ed0881ed0c8f34fa2ed6ccb5f95ff75a2f3b48e2d340f8a8856885e3a.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-3}^{3}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}[\\,(20)-(20-{x}^{2})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}{[{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-3}^{3}{[18-{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{-3}^{3}{[{x}^{2}]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}((18-{x}^{2})^{2}-({x}^{2})^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}(324-36{x}^{2}+{x}^{4}-{x}^{4})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{-3}^{3}(324-36{x}^{2})\\,\\,\\text{d}x \\\\  & =\\pi {(324x-12{x}^{3})|}_{-3}^{3} \\\\  & =\\pi ((324(3)-12(3)^{3})-(324(-3)-12(-3)^{3})) \\\\  & =\\pi ((972-324)-(-972+324)) \\\\  & =\\pi (648-(-648)) \\\\  & =1296\\pi .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a0bf9425-3265-53af-a7f4-242c609c9e7c"] :db/ensure [:question/validate]} {:db/id "answer-field-a0bf9425-3265-53af-a7f4-242c609c9e7c" :answer-field/id #uuid "a0bf9425-3265-53af-a7f4-242c609c9e7c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d0f95781-af63-5159-8189-bcf05ccc46f2" :answer-field/choices ["answer-d0f95781-af63-5159-8189-bcf05ccc46f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0f95781-af63-5159-8189-bcf05ccc46f2" :answer/id #uuid "d0f95781-af63-5159-8189-bcf05ccc46f2" :answer/type :answer.type/math :answer/value "1296\\pi" :db/ensure [:answer/validate]} {:db/id "question-25934858-d636-5a89-8459-35c28b65815f" :question/id #uuid "25934858-d636-5a89-8459-35c28b65815f" :question/math-academy-id "q-124728" :question/problem "![](images/ef/efe8084c2e5b9d5eff4f75dffc9acce77aa66ab0dc62c699589573d96f884d49.png)\n\nThe region above enclosed by the curves $y={x}^{2}-2$ and $y=-{x}^{2}$ is rotated $2\\pi $ radians about the line $y=-2.$ Find the volume of the resulting solid." :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{2}-2 & =-{x}^{2} \\\\ 2{x}^{2} & =2 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=-1$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/45/4514019be21deb238c92f557cc041aec9b5e6629bc9d7dcac133a7aa2aed89c7.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y={x}^{2}-2,$ and\n\n- *leaves* through the outer curve $y=-{x}^{2}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y=-{x}^{2}.$\n\n![](images/61/611d10f83c76467c69a1510809738611962dd5d1e1c22a10b0cb3081d2aa52cc.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}[\\,(-{x}^{2})-(-2)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}{[2-{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y={x}^{2}-2.$\n\n![](images/68/683244c0b5be598da85a8875708f459d4f87319677111f1072c997d911075d68.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}[\\,({x}^{2}-2)-(-2)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}{[{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{1}{[2-{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{-1}^{1}{[{x}^{2}]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}((2-{x}^{2})^{2}-({x}^{2})^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}(4-4{x}^{2}+{x}^{4}-{x}^{4})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{-1}^{1}(4-4{x}^{2})\\,\\,\\text{d}x \\\\  & =\\pi {(4x-\\frac{4{x}^{3}}{3})|}_{-1}^{1} \\\\  & =\\pi ((4(1)-\\frac{4(1)^{3}}{3})-(4(-1)-\\frac{4(-1)^{3}}{3})) \\\\  & =\\pi ((4-\\frac{4}{3})-(-4+\\frac{4}{3})) \\\\  & =\\pi (8-\\frac{8}{3}) \\\\  & =\\frac{16\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3d5160fe-ce43-5a25-8b6a-5f217be58058"] :db/ensure [:question/validate]} {:db/id "answer-field-3d5160fe-ce43-5a25-8b6a-5f217be58058" :answer-field/id #uuid "3d5160fe-ce43-5a25-8b6a-5f217be58058" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9d1eabee-f679-5494-9115-f00cebaa9bac" :answer-field/choices ["answer-9d1eabee-f679-5494-9115-f00cebaa9bac" "answer-e77f7513-a64c-53f2-b5d3-d5040243a753" "answer-3b5bcc35-60c7-54bb-b133-39f6fc654277" "answer-eb88f1de-5cdb-542c-9488-e6ab9bd38152" "answer-67e852b0-b9c4-54a2-b205-8a42f1866dcc"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d1eabee-f679-5494-9115-f00cebaa9bac" :answer/id #uuid "9d1eabee-f679-5494-9115-f00cebaa9bac" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-e77f7513-a64c-53f2-b5d3-d5040243a753" :answer/id #uuid "e77f7513-a64c-53f2-b5d3-d5040243a753" :answer/type :answer.type/math :answer/value "\\frac{32\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-3b5bcc35-60c7-54bb-b133-39f6fc654277" :answer/id #uuid "3b5bcc35-60c7-54bb-b133-39f6fc654277" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-eb88f1de-5cdb-542c-9488-e6ab9bd38152" :answer/id #uuid "eb88f1de-5cdb-542c-9488-e6ab9bd38152" :answer/type :answer.type/math :answer/value "\\frac{64\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-67e852b0-b9c4-54a2-b205-8a42f1866dcc" :answer/id #uuid "67e852b0-b9c4-54a2-b205-8a42f1866dcc" :answer/type :answer.type/math :answer/value "\\frac{8\\pi }{3}" :db/ensure [:answer/validate]} {:db/id 17592186097229 :question/problem "![](images/e8/e8d2665ab162ff21e358a80a6e42659b0385244a08d94f8de3ad5df12b434a9a.png)\n\nThe region above enclosed by the curves $y={x}^{2}$ and $y=\\sqrt{x}$ is rotated $2\\pi $ radians about the line $y=1.$ Find the volume of the resulting solid." :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{2} & =\\sqrt{x} \\\\ {x}^{2}-\\sqrt{x} & =0 \\\\ \\sqrt{x}({x}^{3/2}-1) & =0 \\\\ x & =0,\\,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/7a/7aaa03f21130529bdf5572acac29bfe7566724d8acacc99ca5fc0b035de0398b.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=\\sqrt{x},$ and\n\n- *leaves* through the outer curve $y={x}^{2}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $y={x}^{2}.$\n\n![](images/a7/a7bd5b7f8e61be991cb6a54e9b1277bd6df4fd874dbd72ec90802b4f957c31bd.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(1)-({x}^{2})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1-{x}^{2}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=\\sqrt{x}.$\n\n![](images/ee/ee93f00e178fa7fd7b8702538298a15a5c98d94205deeb71401a49d8dd891545.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(1)-(\\sqrt{x})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[1-\\sqrt{x}]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[1-{x}^{2}]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[1-\\sqrt{x}]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}((1-{x}^{2})^{2}-(1-\\sqrt{x})^{2})\\,\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({x}^{4}-2{x}^{2}-x+2\\sqrt{x})\\,\\,\\text{d}x \\\\  & =\\pi {(\\frac{1}{5}\\,{x}^{5}-\\frac{2}{3}\\,{x}^{3}-\\frac{1}{2}\\,{x}^{2}+\\frac{4}{3}\\,{x}^{3/2}\\text{ })|}_{0}^{1} \\\\  & =\\pi ((\\frac{1}{5}\\,(1)^{5}-\\frac{2}{3}\\,(1)^{3}-\\frac{1}{2}\\,(1)^{2}+\\frac{4}{3}\\,(1)^{3/2})-(0)) \\\\  & =\\pi (\\frac{11}{30}) \\\\  & =\\frac{11\\pi }{30}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186095303 :answer-field/correct "answer-89f357c1-9ec0-5f4e-843e-66f2637b7692" :answer-field/choices ["answer-89f357c1-9ec0-5f4e-843e-66f2637b7692" "answer-d59f02f9-9c54-5daa-ae2f-984c80444c68" "answer-d13c2ea6-e2b8-5f23-9a3b-c6edfff2ccc4" "answer-71023dc7-345b-555a-9dcd-8f0cc9edde60" "answer-d16d1940-8eb2-5e72-8e92-d1c1059e8cc3"] :db/ensure [:answer-field/validate]} {:db/id "answer-89f357c1-9ec0-5f4e-843e-66f2637b7692" :answer/id #uuid "89f357c1-9ec0-5f4e-843e-66f2637b7692" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{30}" :db/ensure [:answer/validate]} {:db/id "answer-d59f02f9-9c54-5daa-ae2f-984c80444c68" :answer/id #uuid "d59f02f9-9c54-5daa-ae2f-984c80444c68" :answer/type :answer.type/math :answer/value "\\frac{14\\pi }{19}" :db/ensure [:answer/validate]} {:db/id "answer-d13c2ea6-e2b8-5f23-9a3b-c6edfff2ccc4" :answer/id #uuid "d13c2ea6-e2b8-5f23-9a3b-c6edfff2ccc4" :answer/type :answer.type/math :answer/value "\\frac{18\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-71023dc7-345b-555a-9dcd-8f0cc9edde60" :answer/id #uuid "71023dc7-345b-555a-9dcd-8f0cc9edde60" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{10}" :db/ensure [:answer/validate]} {:db/id "answer-d16d1940-8eb2-5e72-8e92-d1c1059e8cc3" :answer/id #uuid "d16d1940-8eb2-5e72-8e92-d1c1059e8cc3" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{11}" :db/ensure [:answer/validate]} {:db/id "question-0ad0e9c9-a63e-55c4-a91b-b9b32de9ed5c" :question/id #uuid "0ad0e9c9-a63e-55c4-a91b-b9b32de9ed5c" :question/math-academy-id "q-50324" :question/problem "![](images/b0/b0e8cbe1a26b5a012f6098b67320070e882fa38783d8eda07dd0b76011a47b21.png)\n\nThe region enclosed by the curves $x=\\frac{1}{y}$ and $x=\\frac{5}{2}-y$ is rotated ${360}^{∘}$ about the line $x=-1.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\frac{1}{y} & =\\frac{5}{2}-y \\\\ 1 & =\\frac{5}{2}y-{y}^{2} \\\\ {y}^{2}-\\frac{5}{2}y+1 & =0 \\\\ 2{y}^{2}-5y+2 & =0 \\\\ (y-2)(2y-1) & =0 \\\\ y & =\\frac{1}{2},2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=\\frac{1}{2}$ to $y=2.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/d5/d5067706f9ff1abbdfd9dfce94711cb854f79c1156ddc0d81c1c35a5ed555f7a.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{1}{y},$ and\n\n- *leaves* through the outer curve $x=\\frac{5}{2}-y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=\\frac{5}{2}-y.$\n\n![](images/a9/a944979bc352b0e40afea73836b22c1fb1513fabbc727fb60d4c96793ee6fbb5.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{1/2}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\,(\\frac{5}{2}-y)-(-1)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\frac{7}{2}-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{1}{y}.$\n\n![](images/1e/1eb04cf2f3ae0669dd82106b064dd822da618e9ca31bb3b96e4e30c71b7c3193.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{1/2}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\,(\\frac{1}{y})-(-1)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\frac{1}{y}+1]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\frac{7}{2}-y]}^{2}\\,\\text{d}y-\\pi {\\int }_{1/2}^{2}{[\\frac{1}{y}+1]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7988a85f-c1d9-5415-bd21-c53e94524cdc"] :db/ensure [:question/validate]} {:db/id "answer-field-7988a85f-c1d9-5415-bd21-c53e94524cdc" :answer-field/id #uuid "7988a85f-c1d9-5415-bd21-c53e94524cdc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-60fcac8a-9636-51dd-b16e-559340914a75" :answer-field/choices ["answer-9907a464-6ae3-5500-b762-ac9746b04080" "answer-60fcac8a-9636-51dd-b16e-559340914a75" "answer-0f1ee210-e8c3-5b0b-b961-e2ea6bb04afc" "answer-378a3f70-b83c-543f-8230-8a9c470b7cdc" "answer-7e880303-2fe8-5c05-b664-1056f270eb21"] :db/ensure [:answer-field/validate]} {:db/id "answer-9907a464-6ae3-5500-b762-ac9746b04080" :answer/id #uuid "9907a464-6ae3-5500-b762-ac9746b04080" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-60fcac8a-9636-51dd-b16e-559340914a75" :answer/id #uuid "60fcac8a-9636-51dd-b16e-559340914a75" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1/2}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-0f1ee210-e8c3-5b0b-b961-e2ea6bb04afc" :answer/id #uuid "0f1ee210-e8c3-5b0b-b961-e2ea6bb04afc" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1/2}^{2}{[\\frac{7}{2}-y]}^{2}\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-378a3f70-b83c-543f-8230-8a9c470b7cdc" :answer/id #uuid "378a3f70-b83c-543f-8230-8a9c470b7cdc" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[\\frac{5}{2}-y]}^{2}-{[\\frac{1}{y}]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-7e880303-2fe8-5c05-b664-1056f270eb21" :answer/id #uuid "7e880303-2fe8-5c05-b664-1056f270eb21" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-88a251ee-6143-5e86-bf44-46f8b33042cc" :question/id #uuid "88a251ee-6143-5e86-bf44-46f8b33042cc" :question/math-academy-id "q-125555" :question/problem "![](images/ac/ac7f02919896aeb40859b1d78608ec7620c26ea77becc806a28d39ef8abacd12.png)\n\nThe region enclosed by the curves $x=y\\operatorname{ln}⁡y$ and $x=2\\operatorname{ln}⁡y$ for $y\\in [1,2]$ is rotated $2\\pi $ radians about the line $x=3.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/76/76196a70cdbc65d2f91b4ba500ea83083be5cfe10fe3f3bd09c035e3ea7bcfba.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=2\\operatorname{ln}⁡y,$ and\n\n- *leaves* through the outer curve $x=y\\operatorname{ln}⁡y.$\n\nNext, we can find the volume of our solid as a difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=y\\operatorname{ln}⁡y.$\n\n![](images/e5/e5d8affefbde216fed0bf6acd7d464e921c1cf04e2578050d12c928d6dee5bd0.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}[\\,(3)-(y\\operatorname{ln}⁡y)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[3-y\\operatorname{ln}⁡y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=2\\operatorname{ln}⁡y.$\n\n![](images/b4/b4002c7922eac8e7c97d402833eabc3621ed4da2d13799d07206a45cf0afd1f1.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{1}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}[\\,(3)-(2\\operatorname{ln}⁡y)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}{[3-2\\operatorname{ln}⁡y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{1}^{2}{[3-y\\operatorname{ln}⁡y]}^{2}\\,\\text{d}y-\\pi {\\int }_{1}^{2}{[3-2\\operatorname{ln}⁡y]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1}^{2}({[3-y\\operatorname{ln}⁡y]}^{2}-{[3-2\\operatorname{ln}⁡y]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ce1cd99e-e545-5f30-9775-38b6fad7af7f"] :db/ensure [:question/validate]} {:db/id "answer-field-ce1cd99e-e545-5f30-9775-38b6fad7af7f" :answer-field/id #uuid "ce1cd99e-e545-5f30-9775-38b6fad7af7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b6dc44a6-ce5e-5c08-a960-f7295a035378" :answer-field/choices ["answer-7703febf-5ebf-5006-8d19-7494902439a1" "answer-72635bb1-6cf3-55f9-b41a-e40454b6226a" "answer-5bf122b0-09c1-5956-8744-d8096ee07f2c" "answer-d05b1475-6c63-5ec8-b5a9-e873d5d9039f" "answer-b6dc44a6-ce5e-5c08-a960-f7295a035378"] :db/ensure [:answer-field/validate]} {:db/id "answer-7703febf-5ebf-5006-8d19-7494902439a1" :answer/id #uuid "7703febf-5ebf-5006-8d19-7494902439a1" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[3+2\\operatorname{ln}⁡y]}^{2}-{[3+y\\operatorname{ln}⁡y]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-72635bb1-6cf3-55f9-b41a-e40454b6226a" :answer/id #uuid "72635bb1-6cf3-55f9-b41a-e40454b6226a" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[3+y\\operatorname{ln}⁡y]}^{2}-{[3+2\\operatorname{ln}⁡y]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-5bf122b0-09c1-5956-8744-d8096ee07f2c" :answer/id #uuid "5bf122b0-09c1-5956-8744-d8096ee07f2c" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[3+y\\operatorname{ln}⁡y]}^{2}-{[3-2\\operatorname{ln}⁡y]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-d05b1475-6c63-5ec8-b5a9-e873d5d9039f" :answer/id #uuid "d05b1475-6c63-5ec8-b5a9-e873d5d9039f" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[3-2\\operatorname{ln}⁡y]}^{2}-{[3-y\\operatorname{ln}⁡y]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-b6dc44a6-ce5e-5c08-a960-f7295a035378" :answer/id #uuid "b6dc44a6-ce5e-5c08-a960-f7295a035378" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{1}^{2}({[3-y\\operatorname{ln}⁡y]}^{2}-{[3-2\\operatorname{ln}⁡y]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-dd731e5d-ee05-5b06-811e-7a9b6ae9709a" :question/id #uuid "dd731e5d-ee05-5b06-811e-7a9b6ae9709a" :question/math-academy-id "q-49945" :question/problem "![](images/1c/1c22369a6f1abc89437de1977135208ef5d0e762a4971df1c9ace14b6af932cd.png)\n\nThe region enclosed by the curves $x=\\frac{5y}{8}$ and $x=\\frac{{y}^{2}}{4}$ is rotated ${360}^{∘}$ about the line $x=-2.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{4} & =\\frac{5y}{8} \\\\ 2{y}^{2} & =5y \\\\ 2{y}^{2}-5y & =0 \\\\ y(2y-5) & =0 \\\\ y & =0,\\frac{5}{2}\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y=\\frac{5}{2}.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/50/504e204d73a1f87d72a321e7c0f58eadf01840ff3b8dbc5214f08e50fcbdcf9b.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{{y}^{2}}{4},$ and\n\n- *leaves* through the outer curve $x=\\frac{5}{8}y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=\\frac{5}{8}y.$\n\n![](images/0c/0c43a01a8548112d8dc1f30f9059c560ac7bec1e679a6c76394d83e4bfbea668.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{5/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\,(\\frac{5}{8}y)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\frac{5}{8}y+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{{y}^{2}}{4}.$\n\n![](images/d8/d8478ef13983e6529fa10147f9659171e31a5555cb799ec1fad13d1fe8b25191.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{5/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\,(\\frac{{y}^{2}}{4})-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\frac{{y}^{2}}{4}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\frac{5}{8}y+2]}^{2}\\,\\text{d}y-\\pi {\\int }_{0}^{5/2}{[\\frac{{y}^{2}}{4}+2]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}({[\\frac{5}{8}y+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a538906d-e42b-5de1-87a1-cf764b3258be"] :db/ensure [:question/validate]} {:db/id "answer-field-a538906d-e42b-5de1-87a1-cf764b3258be" :answer-field/id #uuid "a538906d-e42b-5de1-87a1-cf764b3258be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f48cd37-a024-5a0c-b78d-161e36a73060" :answer-field/choices ["answer-4f48cd37-a024-5a0c-b78d-161e36a73060" "answer-9a0443d6-5de1-5cf6-a9fa-57df36d5b4d1" "answer-c18caf2a-05e8-5f0e-acf6-74e8d8e57477" "answer-1b1973fe-fa48-5311-9b7e-e2acae1001af" "answer-13772a60-d9e6-519e-81ff-a87b69705c5c"] :db/ensure [:answer-field/validate]} {:db/id "answer-4f48cd37-a024-5a0c-b78d-161e36a73060" :answer/id #uuid "4f48cd37-a024-5a0c-b78d-161e36a73060" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{5/2}({[\\frac{5y}{8}+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-9a0443d6-5de1-5cf6-a9fa-57df36d5b4d1" :answer/id #uuid "9a0443d6-5de1-5cf6-a9fa-57df36d5b4d1" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{5/2}{[\\frac{5y}{8}+2]}^{2}\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-c18caf2a-05e8-5f0e-acf6-74e8d8e57477" :answer/id #uuid "c18caf2a-05e8-5f0e-acf6-74e8d8e57477" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{5}([\\frac{5y}{8}+2]-[\\frac{{y}^{2}}{4}+2])\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-1b1973fe-fa48-5311-9b7e-e2acae1001af" :answer/id #uuid "1b1973fe-fa48-5311-9b7e-e2acae1001af" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{0}^{5}({[\\frac{5y}{8}]}^{2}-{[\\frac{{y}^{2}}{4}]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-13772a60-d9e6-519e-81ff-a87b69705c5c" :answer/id #uuid "13772a60-d9e6-519e-81ff-a87b69705c5c" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{2}^{5}({[\\frac{5y}{8}+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-6be7f528-8a2e-5e94-a08f-bb7c33bc8c26" :question/id #uuid "6be7f528-8a2e-5e94-a08f-bb7c33bc8c26" :question/math-academy-id "q-125400" :question/problem "![](images/90/90980bb04eb7dd9906ec9a99ea3a1b7cfd9c00969bbd9b12c60fe0f80eb88840.png)\n\nThe region enclosed by the curves $x+2{y}^{2}=1$ and $x=2{sin}^{2}⁡(\\frac{\\pi y}{3})$ for $y\\in [-\\frac{1}{2},\\frac{1}{2}]$ is rotated $2\\pi $ radians about the line $x=1.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, since we are rotating about a vertical line, we need to solve the equation of our first curve for $x:$ \n\n$$\n\\begin{aligned}x+2{y}^{2} & =1\\,⟹\\,x=1-2{y}^{2}\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/16/16ca1c96786eb8e7ef12608f70d03b34b679e63d34ef41135b4fd6801bcccc27.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=1-2{y}^{2},$ and\n\n- *leaves* through the outer curve $x=2{sin}^{2}⁡(\\frac{\\pi y}{3}).$\n\nNext, we can find the volume of our solid as a difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=2{sin}^{2}⁡(\\frac{\\pi y}{3}).$\n\n![](images/27/276dea7b2d9f50e3fe171cceb64c1c7a12f84cfb18bdbe242102802ad9790f49.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1/2}^{1/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[\\,(1)-(2{sin}^{2}⁡(\\frac{\\pi y}{3}))\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[1-2{sin}^{2}⁡(\\frac{\\pi y}{3})]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[\\operatorname{cos}⁡(\\frac{2\\pi y}{3})]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=1-2{y}^{2}.$\n\n![](images/b6/b6c6fb140bb3eaf4c49cba76af157fb46a568bc2dc24e4763facede62720f844.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1/2}^{1/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[\\,(1)-(1-2{y}^{2})\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[2{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1/2}^{1/2}({(\\operatorname{cos}⁡(\\frac{2\\pi y}{3}))}^{2}-{(2{y}^{2})}^{2})\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-58834ca7-0094-5902-ba0d-d4e72392d1de"] :db/ensure [:question/validate]} {:db/id "answer-field-58834ca7-0094-5902-ba0d-d4e72392d1de" :answer-field/id #uuid "58834ca7-0094-5902-ba0d-d4e72392d1de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0538fe89-8dc3-52a1-ae06-27b01e1b4965" :answer-field/choices ["answer-fc85b5f0-dcd6-58f0-b09d-4cc19f8fcf5d" "answer-0538fe89-8dc3-52a1-ae06-27b01e1b4965" "answer-e2aca940-e7f6-56a7-a52f-f3fc13aea2b4" "answer-55d1530f-3fa2-5a08-8bcc-98aa2c0fd192" "answer-972bf55d-1dab-510d-9213-5a9e7ecde914"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc85b5f0-dcd6-58f0-b09d-4cc19f8fcf5d" :answer/id #uuid "fc85b5f0-dcd6-58f0-b09d-4cc19f8fcf5d" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-(1-2{y}^{2})^{2})\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-0538fe89-8dc3-52a1-ae06-27b01e1b4965" :answer/id #uuid "0538fe89-8dc3-52a1-ae06-27b01e1b4965" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-e2aca940-e7f6-56a7-a52f-f3fc13aea2b4" :answer/id #uuid "e2aca940-e7f6-56a7-a52f-f3fc13aea2b4" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{\\pi y}{3})-(1-2{y}^{2})^{2})\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-55d1530f-3fa2-5a08-8bcc-98aa2c0fd192" :answer/id #uuid "55d1530f-3fa2-5a08-8bcc-98aa2c0fd192" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1/2}^{1/2}({sin}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-972bf55d-1dab-510d-9213-5a9e7ecde914" :answer/id #uuid "972bf55d-1dab-510d-9213-5a9e7ecde914" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1/2}^{1/2}({sin}^{2}⁡(\\frac{\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-a2f8487e-855b-5e52-8eac-210ae0123755" :question/id #uuid "a2f8487e-855b-5e52-8eac-210ae0123755" :question/math-academy-id "q-125546" :question/problem "![](images/55/559548dc5f2570d1341760ab87a2619646ed6985fd6437cb29442dc58bc6fee4.png)\n\nThe region enclosed by the curves $x={y}^{2}+2y-1$ and $x=-1-{y}^{2}$ is rotated ${360}^{∘}$ about the line $x=-2.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{y}^{2}+2y-1 & =-1-{y}^{2} \\\\ 2{y}^{2}+2y & =0 \\\\ 2y(y+1) & =0 \\\\ y & =-1,0\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=-1$ to $y=0.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/8f/8f1bccafe64a6926bdb214410453cecafa7059f74a539b155a4a4e6cccd67d1a.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x={y}^{2}+2y-1,$ and\n\n- *leaves* through the outer curve $x=-1-{y}^{2}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=-1-{y}^{2}.$\n\n![](images/7d/7d1d1ed82fadf105997e00d39b99992cdeba1d41be13cf599db63b34902e149a.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{0}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}[\\,(-1-{y}^{2})-(-2)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}{[1-{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x={y}^{2}+2y-1.$\n\n![](images/04/040e0a87b4bb5c7121a27fd2cc94c520f76919afbb86a49cfed2ed0cf57c1561.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{0}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}{[\\,({y}^{2}+2y-1)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}{[{y}^{2}+2y-1]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}{[{y}^{2}+2y+1]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{0}{[1-{y}^{2}]}^{2}\\,\\text{d}y-\\pi {\\int }_{-1}^{0}{[{y}^{2}+2y+1]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}({[1-{y}^{2}]}^{2}-{[(y+1)^{2}]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{0}({(1-{y}^{2})}^{2}-(y+1)^{4})\\text{d}y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9935c7d0-33f5-5372-8a86-7122b4fba33c"] :db/ensure [:question/validate]} {:db/id "answer-field-9935c7d0-33f5-5372-8a86-7122b4fba33c" :answer-field/id #uuid "9935c7d0-33f5-5372-8a86-7122b4fba33c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c7d4c6ac-3f98-58f5-97d2-019d71e33c36" :answer-field/choices ["answer-c7d4c6ac-3f98-58f5-97d2-019d71e33c36" "answer-e8c4ac8d-b33d-560a-bbe6-e5a6e34bfe53" "answer-9144318b-29dd-55f5-a1c7-a01c036ef165" "answer-69f76a16-6d32-5498-a766-01193d404013" "answer-332e8fa1-bd6c-5b72-aab3-9a26d37f05ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7d4c6ac-3f98-58f5-97d2-019d71e33c36" :answer/id #uuid "c7d4c6ac-3f98-58f5-97d2-019d71e33c36" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{0}({(1-{y}^{2})}^{2}-(y+1)^{4})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-e8c4ac8d-b33d-560a-bbe6-e5a6e34bfe53" :answer/id #uuid "e8c4ac8d-b33d-560a-bbe6-e5a6e34bfe53" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{0}({(1-{y}^{2})}^{2}-({y}^{2}+1)^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-9144318b-29dd-55f5-a1c7-a01c036ef165" :answer/id #uuid "9144318b-29dd-55f5-a1c7-a01c036ef165" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-1}^{0}({({y}^{2}+1)}^{2}-(y+1)^{4})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-69f76a16-6d32-5498-a766-01193d404013" :answer/id #uuid "69f76a16-6d32-5498-a766-01193d404013" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}({(1-{y}^{2})}^{2}-({y}^{2}+2y-3)^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "answer-332e8fa1-bd6c-5b72-aab3-9a26d37f05ae" :answer/id #uuid "332e8fa1-bd6c-5b72-aab3-9a26d37f05ae" :answer/type :answer.type/math :answer/value "\\pi {\\int }_{-2}^{0}({({y}^{2}+1)}^{2}-({y}^{2}+2y)^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "question-db9dcd58-6ee1-5525-a1ac-d82114a9c0f2" :question/id #uuid "db9dcd58-6ee1-5525-a1ac-d82114a9c0f2" :question/math-academy-id "q-86194" :question/problem "![](images/6b/6ba207cd34725ec2e3995eb0f90e63bedc8573300335b2d31163457ef8ee9bad.png)\n\nThe region enclosed by the curves $x={y}^{2}+1$ and $x=2{y}^{2}$ is rotated $2\\pi $ radians about the line $x=-2.$ Find the volume of the resulting solid." :question/worked-solution "First, to determine the limits of integration, we find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}2{y}^{2} & ={y}^{2}+1 \\\\ {y}^{2} & =1 \\\\ y & =-1,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=-1$ to $y=1.$\n\nNext, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/41/41f8dff0676c5cf8952f46b174ff4f98deeb97eec272e417f145b4782770c156.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=2{y}^{2},$ and\n\n- *leaves* through the outer curve $x={y}^{2}+1.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x={y}^{2}+1.$\n\n![](images/b4/b4d3d75dfab4aa6382bf47f06a57036ec612a05c90d0764cd48fdc1f150f2453.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[\\,({y}^{2}+1)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[{y}^{2}+3]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=2{y}^{2}.$\n\n![](images/6f/6f79c95e2b2d3aaf71e6dfac5ca93fa20261f5f40e1660cefc4ac23af3e56cf8.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[\\,(2{y}^{2})-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}{[2{y}^{2}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1}^{1}({[{y}^{2}+3]}^{2}-{[2{y}^{2}+2]}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1}^{1}(-3{y}^{4}-2{y}^{2}+5)\\,\\,\\text{d}y \\\\  & =\\pi {(-\\frac{3{y}^{5}}{5}-\\frac{2{y}^{3}}{3}+5y)|}_{-1}^{1} \\\\  & =\\pi [(-\\frac{3\\cdot {1}^{5}}{5}-\\frac{2\\cdot {1}^{3}}{3}+5\\cdot 1)-(-\\frac{3\\cdot (-1)^{5}}{5}-\\frac{2\\cdot (-1)^{3}}{3}+5\\cdot (-1))] \\\\  & =\\frac{112\\pi }{15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-68f68768-c4e2-51d6-ae21-d67ca3a8019c"] :db/ensure [:question/validate]} {:db/id "answer-field-68f68768-c4e2-51d6-ae21-d67ca3a8019c" :answer-field/id #uuid "68f68768-c4e2-51d6-ae21-d67ca3a8019c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-09466455-4240-5580-81c8-13e20c58266d" :answer-field/choices ["answer-09466455-4240-5580-81c8-13e20c58266d" "answer-21bd23c7-f81d-5056-b97e-1aaed7cf5025" "answer-0769fe07-7b97-54d3-9da7-2e16745b3d12" "answer-d607b83b-6442-5533-98d0-d815d6fc8ab6" "answer-300fc692-4366-5f31-b23d-7017bcadb5d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-09466455-4240-5580-81c8-13e20c58266d" :answer/id #uuid "09466455-4240-5580-81c8-13e20c58266d" :answer/type :answer.type/math :answer/value "\\frac{112\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-21bd23c7-f81d-5056-b97e-1aaed7cf5025" :answer/id #uuid "21bd23c7-f81d-5056-b97e-1aaed7cf5025" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-0769fe07-7b97-54d3-9da7-2e16745b3d12" :answer/id #uuid "0769fe07-7b97-54d3-9da7-2e16745b3d12" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-d607b83b-6442-5533-98d0-d815d6fc8ab6" :answer/id #uuid "d607b83b-6442-5533-98d0-d815d6fc8ab6" :answer/type :answer.type/math :answer/value "\\frac{12\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-300fc692-4366-5f31-b23d-7017bcadb5d6" :answer/id #uuid "300fc692-4366-5f31-b23d-7017bcadb5d6" :answer/type :answer.type/math :answer/value "\\frac{12\\pi }{5}" :db/ensure [:answer/validate]} {:db/id 17592186097209 :question/problem "![](images/c6/c62793a0dc7ff37a4d6b7cf157239f21e6b0cdef8c3d428916f074584462598b.png)\n\nThe region enclosed by the curves $y={x}^{2}$ and $y=3x$ for $y\\in [0,9]$ is rotated $2\\pi $ radians about the line $x=5.$ Find the volume of the resulting solid." :question/worked-solution "First, since we are rotating about a vertical line, we need to solve the equations of our curves for $x:$ \n\n$$\n\\begin{aligned}y & ={x}^{2}\\,⟹\\,x=\\sqrt{y} \\\\ y & =3x\\,⟹\\,x=\\frac{1}{3}y\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/bd/bd75a7448cfda8237a403f4ea67a99c38e41788839f5c88b89487106e49547d3.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\sqrt{y},$ and\n\n- *leaves* through the outer curve $x=\\frac{1}{3}y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=\\frac{1}{3}y.$\n\n![](images/0e/0ec13c4447954916af6e3b72abffefb69a46a12671b7b8388a873835654ec921.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{9}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}{[\\,(5)-(\\frac{1}{3}y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}{[5-\\frac{1}{3}y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\sqrt{y}.$\n\n![](images/74/7404d889d1388540821bbd282f82322e3249534b8d4518a6236e9f4bf3164d2c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{9}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}[\\,(5)-(\\sqrt{y})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}[5-\\sqrt{y}]^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{9}({(5-\\frac{1}{3}y)}^{2}-{(5-\\sqrt{y})}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{9}(\\frac{1}{9}{y}^{2}-\\frac{13}{3}y+10\\sqrt{y})\\,\\,\\text{d}y \\\\  & =\\pi {(\\frac{20{y}^{3/2}}{3}+\\frac{{y}^{3}}{27}-\\frac{13{y}^{2}}{6})|}_{0}^{9} \\\\  & =\\pi [(\\frac{20\\cdot {9}^{3/2}}{3}+\\frac{{9}^{3}}{27}-\\frac{13\\cdot {9}^{2}}{6})-0] \\\\  & =\\frac{63\\pi }{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186095183 :answer-field/correct "answer-84a59b81-e90b-51c8-b019-cc66c59fb932" :answer-field/choices ["answer-35b86732-8c4d-5186-99cd-0728f2b353c4" "answer-2feedb22-02f6-5c03-b5c0-72b912429a55" "answer-84a59b81-e90b-51c8-b019-cc66c59fb932" "answer-638ef772-3dd4-513c-9881-1e7ac959700e" "answer-2230d1f1-b787-5319-b1e0-905614128e0b"] :db/ensure [:answer-field/validate]} {:db/id "answer-35b86732-8c4d-5186-99cd-0728f2b353c4" :answer/id #uuid "35b86732-8c4d-5186-99cd-0728f2b353c4" :answer/type :answer.type/math :answer/value "21\\pi " :db/ensure [:answer/validate]} {:db/id "answer-2feedb22-02f6-5c03-b5c0-72b912429a55" :answer/id #uuid "2feedb22-02f6-5c03-b5c0-72b912429a55" :answer/type :answer.type/math :answer/value "\\frac{21\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-84a59b81-e90b-51c8-b019-cc66c59fb932" :answer/id #uuid "84a59b81-e90b-51c8-b019-cc66c59fb932" :answer/type :answer.type/math :answer/value "\\frac{63\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-638ef772-3dd4-513c-9881-1e7ac959700e" :answer/id #uuid "638ef772-3dd4-513c-9881-1e7ac959700e" :answer/type :answer.type/math :answer/value "\\frac{63\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-2230d1f1-b787-5319-b1e0-905614128e0b" :answer/id #uuid "2230d1f1-b787-5319-b1e0-905614128e0b" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "question-fc2bc671-1b50-5524-a44c-d196ad9a937f" :question/id #uuid "fc2bc671-1b50-5524-a44c-d196ad9a937f" :question/math-academy-id "q-85687" :question/problem "![](images/b0/b0aa7d362596dcea976fead0467b9eb76c04b85c02c55dbd12e9a95652eda276.png)\n\nThe region enclosed by the curves $y=x$ and $y=\\sqrt{x}$ for $y\\in [0,1]$ is rotated $2\\pi $ radians about the line $x=3.$ Find the volume of the resulting solid." :question/worked-solution "First, since we are rotating about a vertical line, we need to solve the equations of our curves for $x:$ \n\n$$\n\\begin{aligned}y=x & \\,⟹\\,x=y \\\\ y=\\sqrt{x} & \\,⟹\\,x={y}^{2}\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/f1/f15165acc18f4cf828671e3f9085274b26598a643be9eeb97be617272d7008d7.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=y,$ and\n\n- *leaves* through the outer curve $x={y}^{2}.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x={y}^{2}.$\n\n![](images/54/54820b3b386c9a435de04e0b3f07d4e2221a3e026ba5ba93ca25fa6640aa0ab1.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[\\,(3)-({y}^{2})\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}{[3-{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=y.$\n\n![](images/3e/3e1a6067500f81cabeac8dc43c4c585da608ea655667dc5e00f29a6fad0dda60.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}[\\,(3)-(y)\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}[3-y]^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}({(3-{y}^{2})}^{2}-{(3-y)}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{1}({y}^{4}-7{y}^{2}+6y)\\,\\,\\text{d}y \\\\  & =\\pi {(\\frac{{y}^{5}}{5}-\\frac{7{y}^{3}}{3}+3{y}^{2})|}_{0}^{1} \\\\  & =\\pi [(\\frac{{1}^{5}}{5}-\\frac{7\\cdot {1}^{3}}{3}+3\\cdot {1}^{2})-0] \\\\  & =\\frac{13\\pi }{15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0f225294-fdb8-504b-93be-81ef45509833"] :db/ensure [:question/validate]} {:db/id "answer-field-0f225294-fdb8-504b-93be-81ef45509833" :answer-field/id #uuid "0f225294-fdb8-504b-93be-81ef45509833" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8bff95c5-eea5-547b-9c2a-215dee3b9aea" :answer-field/choices ["answer-fbe67cfc-1a30-5c73-9315-623a9704cafb" "answer-8bff95c5-eea5-547b-9c2a-215dee3b9aea" "answer-8af8d130-ce97-50dd-8f18-515090d74071" "answer-9ace08dc-6b71-5df3-a9ac-066f0a3dea8a" "answer-504eada9-0247-54fc-b6dc-cbc0f935842b"] :db/ensure [:answer-field/validate]} {:db/id "answer-fbe67cfc-1a30-5c73-9315-623a9704cafb" :answer/id #uuid "fbe67cfc-1a30-5c73-9315-623a9704cafb" :answer/type :answer.type/math :answer/value "\\frac{11\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-8bff95c5-eea5-547b-9c2a-215dee3b9aea" :answer/id #uuid "8bff95c5-eea5-547b-9c2a-215dee3b9aea" :answer/type :answer.type/math :answer/value "\\frac{13\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-8af8d130-ce97-50dd-8f18-515090d74071" :answer/id #uuid "8af8d130-ce97-50dd-8f18-515090d74071" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "answer-9ace08dc-6b71-5df3-a9ac-066f0a3dea8a" :answer/id #uuid "9ace08dc-6b71-5df3-a9ac-066f0a3dea8a" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{15}" :db/ensure [:answer/validate]} {:db/id "answer-504eada9-0247-54fc-b6dc-cbc0f935842b" :answer/id #uuid "504eada9-0247-54fc-b6dc-cbc0f935842b" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "question-0c99954c-8e68-5e26-befe-7d930f5b079f" :question/id #uuid "0c99954c-8e68-5e26-befe-7d930f5b079f" :question/math-academy-id "q-351346" :question/problem "![](images/64/64b0f84b62adc0db3385a75d8fdc6e6707eb6778084b9e21de863ca6954c4c1d.png)\n\nThe region enclosed by the curves $x+{y}^{2}=25$ and $x+5y=25$ for $y\\in [0,5]$ is rotated $2\\pi $ radians about the line $x=25.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, since we are rotating about a vertical line, we need to solve the equations of our curves for $x:$ \n\n$$\n\\begin{aligned}x+{y}^{2} & =25\\,⟹\\,x=25-{y}^{2} \\\\ x+5y & =25\\,⟹\\,x=25-5y\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/f5/f5b7cafc0ad6ab7624c1274451f16ba2c3c9a111ac9dad3abd90f082cc42d9b9.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=25-{y}^{2},$ and\n\n- *leaves* through the outer curve $x=25-5y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=25-5y.$\n\n![](images/16/166dbb3f75000dfc155abfc3452ff6874dab1542409edc7e4867c5a5ee73c0b0.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{5}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5}{[\\,(25)-(25-5y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5}{[5y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=25-{y}^{2}.$\n\n![](images/93/9322b6f4bc9a0e913670f8dcbc9657206c3ae6a30de2f26308054d75b67d0861.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{5}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5}[\\,(25)-(25-{y}^{2})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5}[{y}^{2}]^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{5}({(5y)}^{2}-{({y}^{2})}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5}(25{y}^{2}-{y}^{4})\\,\\,\\text{d}y \\\\  & =\\pi {(\\frac{25{y}^{3}}{3}-\\frac{{y}^{5}}{5})|}_{0}^{5} \\\\  & =\\pi [(\\frac{25(5)^{3}}{3}-\\frac{(5)^{5}}{5})-0] \\\\  & =\\pi (\\frac{3125}{3}-625) \\\\  & =\\frac{1250\\pi }{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-10353d36-c2a6-5baa-bc0e-12fb4776c147"] :db/ensure [:question/validate]} {:db/id "answer-field-10353d36-c2a6-5baa-bc0e-12fb4776c147" :answer-field/id #uuid "10353d36-c2a6-5baa-bc0e-12fb4776c147" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f83b0c08-5ea8-5827-be29-e60a8c51de64" :answer-field/choices ["answer-f83b0c08-5ea8-5827-be29-e60a8c51de64"] :db/ensure [:answer-field/validate]} {:db/id "answer-f83b0c08-5ea8-5827-be29-e60a8c51de64" :answer/id #uuid "f83b0c08-5ea8-5827-be29-e60a8c51de64" :answer/type :answer.type/math :answer/value "\\frac{1250\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "question-92412be4-49e1-54ee-8609-445cb6da4a1d" :question/id #uuid "92412be4-49e1-54ee-8609-445cb6da4a1d" :question/math-academy-id "q-348267" :question/problem "![](images/fc/fc70e0f7c7ac82e399e520faa39cf04d252501da46834e88c06d8eba2b8d192d.png)\n\nThe region enclosed by the curves $x+{y}^{2}=16$ and $x+4y=16$ for $y\\in [0,4]$ is rotated $2\\pi $ radians about the line $x=16.$ Find the volume $V$ of the resulting solid. Do not round the answer.\n\n$V=$\n{{field-1}}" :question/worked-solution "First, since we are rotating about a vertical line, we need to solve the equations of our curves for $x:$ \n\n$$\n\\begin{aligned}x+{y}^{2} & =16\\,⟹\\,x=16-{y}^{2} \\\\ x+4y & =16\\,⟹\\,x=16-4y\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/f3/f39f9f399ea4d0e65a499f34d41158ddbaf5319a02e057e097b4f80c8197ba9e.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=16-{y}^{2},$ and\n\n- *leaves* through the outer curve $x=16-4y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=16-4y.$\n\n![](images/47/47d985510b37b7a14e82dfc20bc136694e7ba2e17172b35be45ebde88d238677.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{4}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{4}{[\\,(16)-(16-4y)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{4}{[4y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=16-{y}^{2}.$\n\n![](images/3e/3e5494005010f3cfb8fb8b116c4b8ca91e8d3bf2712ad45c60f0766a2021b19a.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{4}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{4}[\\,(16)-(16-{y}^{2})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{4}[{y}^{2}]^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{4}({(4y)}^{2}-{({y}^{2})}^{2})\\,\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{4}(16{y}^{2}-{y}^{4})\\,\\,\\text{d}y \\\\  & =\\pi {(\\frac{16{y}^{3}}{3}-\\frac{{y}^{5}}{5})|}_{0}^{4} \\\\  & =\\pi [(\\frac{16(4)^{3}}{3}-\\frac{(4)^{5}}{5})-0] \\\\  & =\\pi (\\frac{1024}{3}-\\frac{1024}{5}) \\\\  & =\\frac{2048\\pi }{15}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9c6f2fe1-3336-5fe7-90da-fba93d12c56d"] :db/ensure [:question/validate]} {:db/id "answer-field-9c6f2fe1-3336-5fe7-90da-fba93d12c56d" :answer-field/id #uuid "9c6f2fe1-3336-5fe7-90da-fba93d12c56d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f9e9c0db-7f76-520c-aaea-771c467b95be" :answer-field/choices ["answer-f9e9c0db-7f76-520c-aaea-771c467b95be"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9e9c0db-7f76-520c-aaea-771c467b95be" :answer/id #uuid "f9e9c0db-7f76-520c-aaea-771c467b95be" :answer/type :answer.type/math :answer/value "\\frac{2048\\pi}{15}" :db/ensure [:answer/validate]} {:db/id 17592186097796 :tutorial/content "The region enclosed by the curves $y=x^4$ and $y=x$ is shown below. Suppose that this region is rotated $2\\pi$ radians about the horizontal line $y=-1,$ generating a solid of revolution. How can we write an integral expression that gives the volume of the solid?\n\n![](images/18/1880138e4a20cb5a47ba89cb3177d5dc6e74f998d7fdd428cdded7af38cadd02.png)\n\nFirst, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}{x}^{4} & =x \\\\ {x}^{4}-x & =0 \\\\ x({x}^{3}-1) & =0 \\\\ x & =0,1\\end{aligned}\n$$\n\nHence, our limits of integration are from $x=0$ to $x=1.$\n\nNow, let's draw our vertical arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/49/49da0885bbf23e586b488e2b2a9bcaa0d923d3591833c9b8beb31a611c1d8b43.png)\n\nThe vertical arrow \n\n- *enters* the region through the inner curve $y=x^4,$ and\n\n- *leaves* though the outer curve $y=x.$\n\nNow, we can express the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves, as follows:\n\n- **Step I.** Figure out the volume generated by the outer curve $y=x.$\n\n![](images/35/352ff26bb5dce0a923c102c4528bd89555b49203c212fb73a42cf31cdf8b226e.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}[\\,(x)-(-1)\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[x+1]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $y=x^4.$\n\n![](images/ee/ee0fa31b61acd4a1f2a9b6bb21dcd0e5eed3c529780fcb67096d40dccf90c20c.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{1}[\\,(\\text{upper})-(\\text{lower})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[\\,({x}^{4})-(-1)\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}{[{x}^{4}+1]}^{2}\\,\\text{d}x.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{1}{[x+1]}^{2}\\,\\text{d}x-\\pi {\\int }_{0}^{1}{[{x}^{4}+1]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{0}^{1}({[x+1]}^{2}-{[{x}^{4}+1]}^{2})\\text{d}x.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186097797 :tutorial/content "Now, suppose that the region enclosed by the curves $y=\\dfrac x2$ and $y=\\sqrt x$ is rotated $360^\\circ$ about the vertical line $x=-2.$ Let's find the volume of the resulting solid.\n\n![](images/78/7876211e2781a079ac2444436e671e2d61c28ec09774c0acad65e96fb537927a.png)\n\nFirst, since we are rotating about a vertical line, we need to solve the equations of our curves for $x\\mathbin{:}$\n\n$$\n\\begin{aligned}y=\\frac{x}{2} & \\,⟹\\,x=2y \\\\ y=\\sqrt{x} & \\,⟹\\,x={y}^{2}\\end{aligned}\n$$\n\nNow, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}2y & ={y}^{2} \\\\ {y}^{2}-2y & =0 \\\\ y(y-2) & =0 \\\\ y & =0,2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y={2}.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/c3/c3fd84335240208fb158da9b67aaffa07cf490c67f8a77bf28947df998180b76.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x={y^2},$ and\n\n- *leaves* though the outer curve $x=2y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=2y.$\n\n![](images/6a/6a075f9b5fb64923de7037b31ec6dd0408e88aa6d965ebb8b204b6c560e23ec1.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[\\,(2y)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[2y+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=y^2.$\n\n![](images/cc/cca4c498956a16cb374a8d0b3341a09e52844026593557710525d07be79a233a.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[\\,({y}^{2})-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}{[{y}^{2}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{2}{[2y+2]}^{2}\\,\\text{d}y-\\pi {\\int }_{0}^{2}{[{y}^{2}+2]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}({[2y+2]}^{2}-{[{y}^{2}+2]}^{2})\\text{d}y \\\\  & =\\pi {\\int }_{0}^{2}(-{y}^{4}+8y)\\,\\text{d}y \\\\  & =\\pi {(-\\frac{{y}^{5}}{5}+4{y}^{2})|}_{0}^{2} \\\\  & =\\pi [(-\\frac{32}{5}+16)-0] \\\\  & =\\frac{48\\pi }{5}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186096871 :activity/expected-seconds 1380.0 :db/ensure [:activity/validate]} {:db/id 17592186097608 :step/math-academy-id 638288 :db/ensure [:step/validate]} {:db/id 17592186097659 :step/math-academy-id 638289 :db/ensure [:step/validate]} {:db/id 17592186097609 :step/math-academy-id 638292 :db/ensure [:step/validate]} {:db/id 17592186097610 :step/math-academy-id 638295 :db/ensure [:step/validate]} {:db/id 17592186097660 :step/math-academy-id 638296 :db/ensure [:step/validate]} {:db/id 17592186097611 :step/math-academy-id 638299 :db/ensure [:step/validate]} {:db/id 17592186105923 :knowledge-point/questions ["question-21f7ba2a-9a0f-57d4-9aff-030342b38301"] :db/ensure [:knowledge-point/validate]} {:db/id "question-21f7ba2a-9a0f-57d4-9aff-030342b38301" :question/id #uuid "21f7ba2a-9a0f-57d4-9aff-030342b38301" :question/math-academy-id "q-86453" :question/problem "Evaluate ${\\int }_{-\\infty }^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x.$" :question/worked-solution "We break up the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x\\end{aligned}\n$$\n\nWe start by calculating the second of these integrals:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }\\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x\\end{aligned}\n$$\n\nWe calculate the antiderivative using a substitution. Let $u=1+{x}^{2}$,  then $\\text{d}u=2x\\text{d}x.$ Hence\n\n$$\n\\begin{aligned}\\int \\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & =\\int \\frac{2}{{u}^{3}}\\,\\text{d}u \\\\  & =-\\frac{1}{{u}^{2}}+C \\\\  & =-\\frac{1}{{(1+{x}^{2})}^{2}}+C.\\end{aligned}\n$$\n\nWe now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{0}^{\\infty }\\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{4x}{{(1+{x}^{2})}^{3}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }({-\\frac{1}{{(1+{x}^{2})}^{2}}|}_{0}^{a}) \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{{(1+{x}^{2})}^{2}}+\\frac{1}{(1+0)^{2}}) \\\\  & =-0+1 \\\\  & =1.\\end{aligned}\n$$\n\nNow, notice that the integrand $\\frac{4|x|}{{(1+{x}^{2})}^{3}}$ is an **even** function. This means that we can immediately deduce that \n\n$$\n{\\int }_{-\\infty }^{0}\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x=1.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{4|x|}{{(1+{x}^{2})}^{3}}\\,\\text{d}x \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-da97b470-1a5e-578a-80de-9d4315049c8f"] :db/ensure [:question/validate]} {:db/id "answer-field-da97b470-1a5e-578a-80de-9d4315049c8f" :answer-field/id #uuid "da97b470-1a5e-578a-80de-9d4315049c8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4bbbf7a3-60c8-55b3-8fe4-dad2f3bdc622" :answer-field/choices ["answer-ceb453c5-9589-5071-99e3-645a2efd0834" "answer-19e74ed4-4bf4-58a5-82f1-bb5ffa3a7eee" "answer-4bbbf7a3-60c8-55b3-8fe4-dad2f3bdc622" "answer-6899860b-81ea-5720-98fc-80926761f0f1" "answer-e03abd1a-722a-5b07-a324-580b73ea930e"] :db/ensure [:answer-field/validate]} {:db/id "answer-ceb453c5-9589-5071-99e3-645a2efd0834" :answer/id #uuid "ceb453c5-9589-5071-99e3-645a2efd0834" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-19e74ed4-4bf4-58a5-82f1-bb5ffa3a7eee" :answer/id #uuid "19e74ed4-4bf4-58a5-82f1-bb5ffa3a7eee" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-4bbbf7a3-60c8-55b3-8fe4-dad2f3bdc622" :answer/id #uuid "4bbbf7a3-60c8-55b3-8fe4-dad2f3bdc622" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-6899860b-81ea-5720-98fc-80926761f0f1" :answer/id #uuid "6899860b-81ea-5720-98fc-80926761f0f1" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e03abd1a-722a-5b07-a324-580b73ea930e" :answer/id #uuid "e03abd1a-722a-5b07-a324-580b73ea930e" :answer/type :answer.type/text :answer/value "The integral is divergent" :db/ensure [:answer/validate]} {:db/id 17592186320665 :answer-field/correct "answer-ba22ce2a-0962-5777-b986-98a5bafb7d11" :answer-field/choices ["answer-ba22ce2a-0962-5777-b986-98a5bafb7d11"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba22ce2a-0962-5777-b986-98a5bafb7d11" :answer/id #uuid "ba22ce2a-0962-5777-b986-98a5bafb7d11" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "activity-320827af-0236-5baf-ad26-fd203d4a3819" :activity/id #uuid "320827af-0236-5baf-ad26-fd203d4a3819" :activity/title "Improper Integrals Over the Real Line" :activity/type :activity.type/review :activity/scope 17592186048880 :activity/course 17592186046645 :activity/steps ["step-fd9a0382-9f34-5402-8fbe-b792883b94da" "step-cd28a652-1df4-5863-b66e-4a60f9e2ee7f" "step-6cb888af-c468-5ec7-990d-1e6270a76de3" "step-0727a7ae-2a4f-5a1a-b263-107fab74a519" "step-20ef6a64-43e5-569e-9232-97b79c35df56"] :activity/first-step "step-fd9a0382-9f34-5402-8fbe-b792883b94da" :db/ensure [:activity/validate]} {:db/id "step-fd9a0382-9f34-5402-8fbe-b792883b94da" :step/id #uuid "fd9a0382-9f34-5402-8fbe-b792883b94da" :step/content 17592186332946 :step/next "step-cd28a652-1df4-5863-b66e-4a60f9e2ee7f" :db/ensure [:step/validate]} {:db/id "step-cd28a652-1df4-5863-b66e-4a60f9e2ee7f" :step/id #uuid "cd28a652-1df4-5863-b66e-4a60f9e2ee7f" :step/content 17592186288012 :step/next "step-6cb888af-c468-5ec7-990d-1e6270a76de3" :db/ensure [:step/validate]} {:db/id "step-6cb888af-c468-5ec7-990d-1e6270a76de3" :step/id #uuid "6cb888af-c468-5ec7-990d-1e6270a76de3" :step/content "question-21f7ba2a-9a0f-57d4-9aff-030342b38301" :step/next "step-0727a7ae-2a4f-5a1a-b263-107fab74a519" :db/ensure [:step/validate]} {:db/id "step-0727a7ae-2a4f-5a1a-b263-107fab74a519" :step/id #uuid "0727a7ae-2a4f-5a1a-b263-107fab74a519" :step/content 17592186253506 :step/next "step-20ef6a64-43e5-569e-9232-97b79c35df56" :db/ensure [:step/validate]} {:db/id "step-20ef6a64-43e5-569e-9232-97b79c35df56" :step/id #uuid "20ef6a64-43e5-569e-9232-97b79c35df56" :step/content 17592186320880 :db/ensure [:step/validate]} {:db/id 17592186175936 :knowledge-point/questions ["question-dbf7f381-31f1-5a31-a806-20d912ae1de5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175937 :knowledge-point/questions ["question-cd62ff9e-af99-5108-83c4-43b98934fd5b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dbf7f381-31f1-5a31-a806-20d912ae1de5" :question/id #uuid "dbf7f381-31f1-5a31-a806-20d912ae1de5" :question/math-academy-id "q-149613" :question/problem "Consider the following data sets:\n\n$$\nx=\\{2,\\,14,\\,18,\\,6\\},\\,y=\\{-2,\\,-1,\\,-3,\\,2\\}\n$$\n\nYou're given that $\\overset{―}{x}=10$ and $\\overset{―}{y}=-1.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(2-10)(-2-(-1))+(14-10)(-1-(-1)) \\\\  & \\,\\,\\,+(18-10)(-3-(-1))+(6-10)(2-(-1))] \\\\  & =\\frac{1}{4}[(-8)(-1)+(4)(0)+(8)(-2)+(-4)(3)] \\\\  & =\\frac{1}{4}[8+0-16-12] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-62967384-1eed-5b2f-a746-bfc8a4e7ed4e"] :db/ensure [:question/validate]} {:db/id "answer-field-62967384-1eed-5b2f-a746-bfc8a4e7ed4e" :answer-field/id #uuid "62967384-1eed-5b2f-a746-bfc8a4e7ed4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-40793b04-54bc-5c4f-b662-c1ba29bba9a3" :answer-field/choices ["answer-09685f89-3b34-589d-9f7b-9e71b2bd4dc1" "answer-d73bda78-1c6a-55d2-8318-e3f169f24bd5" "answer-40793b04-54bc-5c4f-b662-c1ba29bba9a3" "answer-f4394c31-0057-5d0e-b2db-8d4628abc3a4" "answer-ff4bec2c-9d18-5e8b-bd39-33471226bab8"] :db/ensure [:answer-field/validate]} {:db/id "answer-09685f89-3b34-589d-9f7b-9e71b2bd4dc1" :answer/id #uuid "09685f89-3b34-589d-9f7b-9e71b2bd4dc1" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-d73bda78-1c6a-55d2-8318-e3f169f24bd5" :answer/id #uuid "d73bda78-1c6a-55d2-8318-e3f169f24bd5" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-40793b04-54bc-5c4f-b662-c1ba29bba9a3" :answer/id #uuid "40793b04-54bc-5c4f-b662-c1ba29bba9a3" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-f4394c31-0057-5d0e-b2db-8d4628abc3a4" :answer/id #uuid "f4394c31-0057-5d0e-b2db-8d4628abc3a4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-ff4bec2c-9d18-5e8b-bd39-33471226bab8" :answer/id #uuid "ff4bec2c-9d18-5e8b-bd39-33471226bab8" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-cd62ff9e-af99-5108-83c4-43b98934fd5b" :question/id #uuid "cd62ff9e-af99-5108-83c4-43b98934fd5b" :question/math-academy-id "q-134213" :question/problem "| **Price per Bag, in $$$ ($x$)** | $2$ | $3$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| **Number of Bags Sold ($y$)** | $28$ | $20$ | $24$ | $16$ |\n\nThe table above shows the results of a survey conducted in four fast food outlets. It shows data on the number of bags of onion rings sold daily and the price per bag. Calculate the covariance of the data sets." :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (2+3+3+4) \\\\  & =\\frac{1}{4}\\cdot 12 \\\\  & =3 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (28+20+24+16) \\\\  & =\\frac{1}{4}\\cdot 88 \\\\  & =22\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(2\\,-\\,3)(28\\,-\\,22)+(3\\,-\\,3)(20\\,-\\,22)+(3\\,-\\,3)(24\\,-\\,22)+(4\\,-\\,3)(16\\,-\\,22)] \\\\  & =\\frac{1}{4}[(-1)(6)+(0)(-2)+(0)(2)+(1)(-6)] \\\\  & =\\frac{1}{4}[-6+0+0+(-6)] \\\\  & =\\frac{1}{4}\\cdot (-12) \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4e06468b-f51b-5f50-8a9e-cebecddf0b0d"] :db/ensure [:question/validate]} {:db/id "answer-field-4e06468b-f51b-5f50-8a9e-cebecddf0b0d" :answer-field/id #uuid "4e06468b-f51b-5f50-8a9e-cebecddf0b0d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3aff7707-4559-54d1-861a-9dc37de66b36" :answer-field/choices ["answer-d3a1d307-f33c-5722-a2a2-c2b3d1c25a46" "answer-c9cdcc25-5ab4-5cf2-be28-58e0c1e32102" "answer-3aff7707-4559-54d1-861a-9dc37de66b36" "answer-948e8b7a-427b-55a9-ada9-f99540a5b834" "answer-e6e865c4-d26a-551c-8f3d-c07a0a7fc2bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3a1d307-f33c-5722-a2a2-c2b3d1c25a46" :answer/id #uuid "d3a1d307-f33c-5722-a2a2-c2b3d1c25a46" :answer/type :answer.type/math :answer/value "-1.5" :db/ensure [:answer/validate]} {:db/id "answer-c9cdcc25-5ab4-5cf2-be28-58e0c1e32102" :answer/id #uuid "c9cdcc25-5ab4-5cf2-be28-58e0c1e32102" :answer/type :answer.type/math :answer/value "-11.5" :db/ensure [:answer/validate]} {:db/id "answer-3aff7707-4559-54d1-861a-9dc37de66b36" :answer/id #uuid "3aff7707-4559-54d1-861a-9dc37de66b36" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-948e8b7a-427b-55a9-ada9-f99540a5b834" :answer/id #uuid "948e8b7a-427b-55a9-ada9-f99540a5b834" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-e6e865c4-d26a-551c-8f3d-c07a0a7fc2bd" :answer/id #uuid "e6e865c4-d26a-551c-8f3d-c07a0a7fc2bd" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} [:db/retract 17592186187566 :answer-field/choices 17592186187568] [:db/retract 17592186187566 :answer-field/choices 17592186187569] [:db/retract 17592186187566 :answer-field/choices 17592186187570] [:db/retract 17592186187566 :answer-field/choices 17592186187571] [:db/retract 17592186187566 :answer-field/choices 17592186187567] {:db/id 17592186188915 :question/problem "At each point $P$ on a particular curve, the derivative ${y}^{′}(x)$ is proportional to the distance from $P$ to the origin. What differential equation describes this curve?" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*At each point $P$ on a particular curve, the **derivative** ${y}^{′}(x)$ is **proportional** to the **distance from $P$ to the origin**.*\n\nWe note the following:\n\n- The *distance from $P(x,y)$ to the origin* is given by $\\sqrt{{x}^{2}+{y}^{2}}.$\n\n- Since the *derivative* is *proportional* to the distance from $P$ to the origin, we have \n\n$$\n{y}^{′}=k\\cdot \\sqrt{{x}^{2}+{y}^{2}},\n$$\n\nwhere $k$ is a constant.\n\nSo, our differential equation is\n\n$$\n{y}^{′}=k\\sqrt{{x}^{2}+{y}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186187566 :answer-field/correct "answer-7e897ffd-840e-5b35-92d6-f6d2bd060f6b" :answer-field/choices ["answer-00359f0d-5c3b-50c1-a12e-737bc41221da" "answer-7e897ffd-840e-5b35-92d6-f6d2bd060f6b" "answer-f7ffbb76-ca6f-595c-aa26-024793132497" "answer-3c96294f-e5cd-511a-981b-9f5670bd9a23" "answer-ec89e486-9020-5137-9ccb-884bab47d61f"] :db/ensure [:answer-field/validate]} {:db/id "answer-00359f0d-5c3b-50c1-a12e-737bc41221da" :answer/id #uuid "00359f0d-5c3b-50c1-a12e-737bc41221da" :answer/type :answer.type/math :answer/value "{y}^{′}(x)=k({x}^{2}+{y}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-7e897ffd-840e-5b35-92d6-f6d2bd060f6b" :answer/id #uuid "7e897ffd-840e-5b35-92d6-f6d2bd060f6b" :answer/type :answer.type/math :answer/value "{y}^{′}(x)=k\\sqrt{{x}^{2}+{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-f7ffbb76-ca6f-595c-aa26-024793132497" :answer/id #uuid "f7ffbb76-ca6f-595c-aa26-024793132497" :answer/type :answer.type/math :answer/value "{y}^{′}(x)=kxy" :db/ensure [:answer/validate]} {:db/id "answer-3c96294f-e5cd-511a-981b-9f5670bd9a23" :answer/id #uuid "3c96294f-e5cd-511a-981b-9f5670bd9a23" :answer/type :answer.type/math :answer/value "{y}^{′}(x)=k{x}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ec89e486-9020-5137-9ccb-884bab47d61f" :answer/id #uuid "ec89e486-9020-5137-9ccb-884bab47d61f" :answer/type :answer.type/math :answer/value "{y}^{′}(x)=k{x}^{2}{y}^{2}" :db/ensure [:answer/validate]} {:db/id 17592186188257 :knowledge-point/questions ["question-9d65b7da-354a-5fe6-8886-5852de4be621"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9d65b7da-354a-5fe6-8886-5852de4be621" :question/id #uuid "9d65b7da-354a-5fe6-8886-5852de4be621" :question/math-academy-id "q-80488" :question/problem "The area of a square increases at a rate that's inversely proportional to its perimeter. Write down a differential equation describing the rate of change of the side length, $s(t),$ in this process. Assume that $K>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **area** of a square **increases** at a **rate** that's **inversely proportional** to its **perimeter**.*\n\nWe note the following:\n\n- The question describes the *rate* at which the *area $A$ of a square* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}A}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}A}{\\text{d}t}$ *increases* at a rate that's *inversely proportional* to its *perimeter.* In other words,\n\n$$\n\\frac{\\text{d}A}{\\text{d}t}=\\frac{k}{4s}\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}s}{\\text{d}t}.$\n\nThe area of a square is given by \n\n$$\nA={s}^{2}.\n$$\n\n \n\nDifferentiating this equation with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({s}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =2s\\frac{\\text{d}s}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t}=\\frac{k}{4s} \\\\ 2s\\frac{\\text{d}s}{\\text{d}t}=\\frac{k}{4s} \\\\ \\frac{\\text{d}s}{\\text{d}t}=\\frac{(\\frac{k}{4s})}{2s} \\\\ \\frac{\\text{d}s}{\\text{d}t}=\\frac{k}{8{s}^{2}}.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{8}>0\n$$\n\n \n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ddc65ecf-2fc0-57a8-93c3-d6c4c4e692c3"] :db/ensure [:question/validate]} {:db/id "answer-field-ddc65ecf-2fc0-57a8-93c3-d6c4c4e692c3" :answer-field/id #uuid "ddc65ecf-2fc0-57a8-93c3-d6c4c4e692c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5ca4cfd4-07ce-53b0-ac05-7ef895c2e528" :answer-field/choices ["answer-c85ccc6a-9e93-5f3b-a97f-d6c05f64a53d" "answer-de7decf8-37f7-5b67-adfa-4152ced74e30" "answer-85d4c3b1-bd0d-5ede-ab88-6b4e89d39b8a" "answer-c0dfbcc4-c509-5a61-956d-8bd3f7248123" "answer-5ca4cfd4-07ce-53b0-ac05-7ef895c2e528"] :db/ensure [:answer-field/validate]} {:db/id "answer-c85ccc6a-9e93-5f3b-a97f-d6c05f64a53d" :answer/id #uuid "c85ccc6a-9e93-5f3b-a97f-d6c05f64a53d" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K" :db/ensure [:answer/validate]} {:db/id "answer-de7decf8-37f7-5b67-adfa-4152ced74e30" :answer/id #uuid "de7decf8-37f7-5b67-adfa-4152ced74e30" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}s}{\\text{d}t}=Ks" :db/ensure [:answer/validate]} {:db/id "answer-85d4c3b1-bd0d-5ede-ab88-6b4e89d39b8a" :answer/id #uuid "85d4c3b1-bd0d-5ede-ab88-6b4e89d39b8a" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K{s}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-c0dfbcc4-c509-5a61-956d-8bd3f7248123" :answer/id #uuid "c0dfbcc4-c509-5a61-956d-8bd3f7248123" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{s}" :db/ensure [:answer/validate]} {:db/id "answer-5ca4cfd4-07ce-53b0-ac05-7ef895c2e528" :answer/id #uuid "5ca4cfd4-07ce-53b0-ac05-7ef895c2e528" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}" :db/ensure [:answer/validate]} {:db/id 17592186188291 :knowledge-point/questions ["question-907d5b64-98c1-552d-a43d-a699db06e688"] :db/ensure [:knowledge-point/validate]} {:db/id "question-907d5b64-98c1-552d-a43d-a699db06e688" :question/id #uuid "907d5b64-98c1-552d-a43d-a699db06e688" :question/math-academy-id "q-119167" :question/problem "The volume of a sphere decreases at a rate that's proportional to its surface area. Write down a differential equation describing the rate of change of the radius, $r(t),$ in this process. Assume that $k>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*Its **volume decreases** at a **rate** that's **proportional** to its **surface area**.* \n\nWe note the following:\n\n- The question describes the *rate* at which the *volume $V$ of a sphere* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}V}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}V}{\\text{d}t}$ *decreases* at a rate that's *proportional to its surface area $S.$* Therefore,\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-kS,\n$$\n\nwhere $k>0.$ Now, using the fact that $S=4\\pi {r}^{2},$ we have\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-4\\pi k{r}^{2}.\n$$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}r}{\\text{d}t}.$\n\nThe volume $V$ of a sphere is given by\n\n$$\nV=\\frac{4}{3}\\pi {r}^{3}.\n$$\n\nDifferentiating this equation with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =4\\pi {r}^{2}\\frac{\\text{d}r}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =-4\\pi k{r}^{2} \\\\ 4\\pi {r}^{2}\\frac{\\text{d}r}{\\text{d}t} & =-4\\pi k{r}^{2} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-\\frac{4\\pi k{r}^{2}}{4\\pi {r}^{2}} \\\\ \\frac{\\text{d}r}{\\text{d}t} & =-k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-13b9af92-d428-5ecd-80c2-21192da8e8da"] :db/ensure [:question/validate]} {:db/id "answer-field-13b9af92-d428-5ecd-80c2-21192da8e8da" :answer-field/id #uuid "13b9af92-d428-5ecd-80c2-21192da8e8da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4eace44a-9542-5986-9bb4-4a121809282b" :answer-field/choices ["answer-5184e724-e665-5cf4-9d18-27d961cdc95d" "answer-71ee97c0-dcb3-5432-b6ad-3f697f647db0" "answer-4eace44a-9542-5986-9bb4-4a121809282b" "answer-537b4f55-d454-56dc-93a5-b86d06a5d655" "answer-a39bc14a-c886-535c-9199-d7ab15d57b18"] :db/ensure [:answer-field/validate]} {:db/id "answer-5184e724-e665-5cf4-9d18-27d961cdc95d" :answer/id #uuid "5184e724-e665-5cf4-9d18-27d961cdc95d" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-\\frac{k}{r}" :db/ensure [:answer/validate]} {:db/id "answer-71ee97c0-dcb3-5432-b6ad-3f697f647db0" :answer/id #uuid "71ee97c0-dcb3-5432-b6ad-3f697f647db0" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-\\frac{k}{{r}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-4eace44a-9542-5986-9bb4-4a121809282b" :answer/id #uuid "4eace44a-9542-5986-9bb4-4a121809282b" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-k" :db/ensure [:answer/validate]} {:db/id "answer-537b4f55-d454-56dc-93a5-b86d06a5d655" :answer/id #uuid "537b4f55-d454-56dc-93a5-b86d06a5d655" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-kr" :db/ensure [:answer/validate]} {:db/id "answer-a39bc14a-c886-535c-9199-d7ab15d57b18" :answer/id #uuid "a39bc14a-c886-535c-9199-d7ab15d57b18" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}r}{\\text{d}t}=-k{r}^{2}" :db/ensure [:answer/validate]} {:db/id "activity-f0450c29-614d-584c-bd9d-e5e05615fc5b" :activity/id #uuid "f0450c29-614d-584c-bd9d-e5e05615fc5b" :activity/title "Further Modeling With First-Order ODEs" :activity/type :activity.type/review :activity/scope 17592186049739 :activity/course 17592186046645 :activity/steps ["step-52e7e185-8a07-5891-8e9c-c1bf0de98ed5" "step-677b36df-44d3-546b-99e0-9f2b342dd41c" "step-b67684ce-1284-5a67-8a4d-2617a5d04b2f" "step-ee2e114c-cdf4-53db-b71c-1fd113ce8364" "step-17e24c4d-fbe4-5267-b369-1dc13301b94c"] :activity/first-step "step-52e7e185-8a07-5891-8e9c-c1bf0de98ed5" :db/ensure [:activity/validate]} {:db/id "step-52e7e185-8a07-5891-8e9c-c1bf0de98ed5" :step/id #uuid "52e7e185-8a07-5891-8e9c-c1bf0de98ed5" :step/content 17592186188915 :step/next "step-677b36df-44d3-546b-99e0-9f2b342dd41c" :db/ensure [:step/validate]} {:db/id "step-677b36df-44d3-546b-99e0-9f2b342dd41c" :step/id #uuid "677b36df-44d3-546b-99e0-9f2b342dd41c" :step/content "question-9d65b7da-354a-5fe6-8886-5852de4be621" :step/next "step-b67684ce-1284-5a67-8a4d-2617a5d04b2f" :db/ensure [:step/validate]} {:db/id "step-b67684ce-1284-5a67-8a4d-2617a5d04b2f" :step/id #uuid "b67684ce-1284-5a67-8a4d-2617a5d04b2f" :step/content "question-907d5b64-98c1-552d-a43d-a699db06e688" :step/next "step-ee2e114c-cdf4-53db-b71c-1fd113ce8364" :db/ensure [:step/validate]} {:db/id "step-ee2e114c-cdf4-53db-b71c-1fd113ce8364" :step/id #uuid "ee2e114c-cdf4-53db-b71c-1fd113ce8364" :step/content 17592186373799 :step/next "step-17e24c4d-fbe4-5267-b369-1dc13301b94c" :db/ensure [:step/validate]} {:db/id "step-17e24c4d-fbe4-5267-b369-1dc13301b94c" :step/id #uuid "17e24c4d-fbe4-5267-b369-1dc13301b94c" :step/content 17592186373834 :db/ensure [:step/validate]} {:db/id 17592186199484 :tutorial/content "Suppose we want to find the minimum and maximum values of the function\n\n$$\nf(x,y) = 2x^2+4y^2\n$$\n\nsubject to constraint $g(x,y) = x^2+y^2 \\leq 1.$ In other words, we wish to find the global extrema of $f(x,y)$ defined on the disc of radius $1$ centered at the origin, as shown below.\n\n![](images/5a/5ac34145b3911b19eb3775a915e8f0462c78502be6d6292e7682265c86eafce7.png)\n\n  \n\nTo find the extrema, we proceed as follows:\n\n- First, we find the critical points of $f$ inside the domain $x^2+y^2 < 1.$\n\n- Then, we find the extreme values of $f$ subject to the constraint $x^2+y^2=1$ using the method of Lagrange multipliers.\n\n- Finally, we determine the maximum and minimum values by evaluating $f$ at the candidate points.\n\nRecall that the critical points of a function $f(x,y)$ are the solutions to $\\boldsymbol f'(x,y) = \\mathbf 0^T.$ Now, since the derivative of $f$ is the transpose of its gradient $\\nabla f,$ the critical points are also given by the solutions to $\\nabla f = \\mathbf 0.$\n\nSo, we can find the critical points by solving $\\nabla f = \\mathbf 0,$ as follows:\n\n$$\n\\begin{aligned}⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =⟨0,0⟩ \\\\ ⟨4x,8y⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nThe above equation has the solution $(x,y)=(0,0).$ Note that this point belongs to our domain.\n\nNext, we need to find the maximum value of $f(x,y)$ subject to the constraint $g(x,y)= x^2 + y^2  = 1.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨4x,8y⟩ & =\\lambda ⟨2x,2y⟩\\end{aligned}\n$$\n\nTherefore, we have the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}4x=2\\lambda x \\\\ 8y=2\\lambda y\\end{aligned}\\,⇒\\,\\{\\begin{aligned}x(2-\\lambda )=0 \\\\ y(4-\\lambda )=0\\end{aligned}\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation, the constraint condition $x^2+y^2=1$ implies\n\n$$\n\\begin{aligned}{0}^{2}+{y}^{2} & =1\\,⇒\\,y=\\pm 1.\\end{aligned}\n$$\n\nThis gives the critical points $\\left(0,\\pm 1 \\right).$\n\n- Assuming $\\lambda =2$ in the first equation, the second equation of the system implies\n\n$$\n\\begin{aligned}y(4-2)=0\\,⇒\\,y=0.\\end{aligned}\n$$\n\nThen, the constraint condition $x^2+y^2=1$ implies\n\n$$\n\\begin{aligned}{x}^{2}+{0}^{2} & =1\\,⇒\\,x=\\pm 1.\\end{aligned}\n$$\n\nThis gives the critical point $\\left(\\pm 1, 0 \\right).$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(\\pm 1, 0), \\qquad (0, \\pm1), \\qquad (0,0).\n$$\n\nNote that we add the critical point $(0,0)$ to the list of the candidates above.\n\nFinally, we evaluate $f$ at these points: \n\n| $(x,y)$ | $(\\pm 1,0)$ | $(0, \\pm 1)$ | $(0, 0)$ |\n| --- | --- | --- | --- |\n| $f(x,y)$ | $2$ | $4$ | $0$ |\n\nTherefore, the function reaches a minimum of $0$ at the point $(0, 0)$ and a maximum of $4$ at the points $(0, \\pm 1).$" :db/ensure [:tutorial/validate]} {:db/id "activity-259db048-1a55-58f9-8b73-5acef3edbeaf" :activity/id #uuid "259db048-1a55-58f9-8b73-5acef3edbeaf" :activity/title "Outward-Pointing Unit Normal Vectors in 2D" :activity/type :activity.type/review :activity/scope 17592186050104 :activity/course 17592186046660 :activity/steps ["step-3dccba39-3b8d-5505-98cb-d31f375f766d" "step-3ca2cc69-4942-5fb5-9b30-e5ad1d2434e4" "step-8ebefd0e-d874-5b83-9768-c1a034db331b" "step-91c89fa2-6786-592c-acc2-2a4b9d5baaa5" "step-7e4c0550-e134-561a-97d0-d8c0a3c73e85"] :activity/first-step "step-3dccba39-3b8d-5505-98cb-d31f375f766d" :db/ensure [:activity/validate]} {:db/id "step-3dccba39-3b8d-5505-98cb-d31f375f766d" :step/id #uuid "3dccba39-3b8d-5505-98cb-d31f375f766d" :step/content 17592186387754 :step/next "step-3ca2cc69-4942-5fb5-9b30-e5ad1d2434e4" :db/ensure [:step/validate]} {:db/id "step-3ca2cc69-4942-5fb5-9b30-e5ad1d2434e4" :step/id #uuid "3ca2cc69-4942-5fb5-9b30-e5ad1d2434e4" :step/content 17592186420304 :step/next "step-8ebefd0e-d874-5b83-9768-c1a034db331b" :db/ensure [:step/validate]} {:db/id "step-8ebefd0e-d874-5b83-9768-c1a034db331b" :step/id #uuid "8ebefd0e-d874-5b83-9768-c1a034db331b" :step/content 17592186106043 :step/next "step-91c89fa2-6786-592c-acc2-2a4b9d5baaa5" :db/ensure [:step/validate]} {:db/id "step-91c89fa2-6786-592c-acc2-2a4b9d5baaa5" :step/id #uuid "91c89fa2-6786-592c-acc2-2a4b9d5baaa5" :step/content 17592186445292 :step/next "step-7e4c0550-e134-561a-97d0-d8c0a3c73e85" :db/ensure [:step/validate]} {:db/id "step-7e4c0550-e134-561a-97d0-d8c0a3c73e85" :step/id #uuid "7e4c0550-e134-561a-97d0-d8c0a3c73e85" :step/content 17592186275230 :db/ensure [:step/validate]} [:db/retract 17592186310914 :answer-field/choices 17592186310686] [:db/retract 17592186310889 :answer-field/choices 17592186310308] {:db/id 17592186229132 :knowledge-point/questions ["question-5cb555db-6a59-509d-947e-27c4f1a2a7e6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5cb555db-6a59-509d-947e-27c4f1a2a7e6" :question/id #uuid "5cb555db-6a59-509d-947e-27c4f1a2a7e6" :question/math-academy-id "q-335062" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=y(t)+1 \\\\ {y}^{′}(t)=-x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"120px\">$2\\operatorname{sin}⁡(t)$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]x(t)+g(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and $g(t)=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that \n\n$$\n{e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}].\n$$\n\nSince the initial conditions are given at $t={t}_{0}=0,$ we have\n\n$$\n\\begin{aligned}{e}^{A(t-{t}_{0})} & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(t) & \\operatorname{sin}⁡(t) \\\\ -\\operatorname{sin}⁡(t) & \\operatorname{cos}⁡(t)\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(t-s) & \\operatorname{sin}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s) & \\operatorname{cos}⁡(t-s)\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s)\\end{aligned}].\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s & ={\\int }_{0}^{t}[\\begin{aligned}\\operatorname{cos}⁡(t-s) \\\\ -\\operatorname{sin}⁡(t-s)\\end{aligned}]\\text{d}s \\\\  & ={[\\begin{aligned}-\\operatorname{sin}⁡(t-s) \\\\ \\operatorname{cos}⁡(t-s)\\end{aligned}]}_{s=0}^{s=t} \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)-1\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)\\end{aligned}]+[\\begin{aligned}\\operatorname{sin}⁡(t) \\\\ \\operatorname{cos}⁡(t)-1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡(t) \\\\ 2\\operatorname{cos}⁡(t)-1\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c0cddfae-ecf5-50fd-9bfc-04c2102bb55f"] :db/ensure [:question/validate]} {:db/id "answer-field-c0cddfae-ecf5-50fd-9bfc-04c2102bb55f" :answer-field/id #uuid "c0cddfae-ecf5-50fd-9bfc-04c2102bb55f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d4f64bf3-528b-508d-afe7-7fb41040696f" :answer-field/choices ["answer-d4f64bf3-528b-508d-afe7-7fb41040696f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4f64bf3-528b-508d-afe7-7fb41040696f" :answer/id #uuid "d4f64bf3-528b-508d-afe7-7fb41040696f" :answer/type :answer.type/math :answer/value "2\\cos(t)-1" :db/ensure [:answer/validate]} {:db/id 17592186229133 :knowledge-point/questions ["question-ace7005c-d6c8-5219-91cc-32f47feb4972"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186310914 :answer-field/correct 17592186310001 :db/ensure [:answer-field/validate]} {:db/id 17592186310889 :answer-field/correct 17592186308885 :db/ensure [:answer-field/validate]} {:db/id "question-ace7005c-d6c8-5219-91cc-32f47feb4972" :question/id #uuid "ace7005c-d6c8-5219-91cc-32f47feb4972" :question/math-academy-id "q-335403" :question/problem "Consider the inhomogeneous system  ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $x(t)$ passing through $x(0)$ is presented below.\n\n$\\text{L1}:\\,$ Let $y(t)={e}^{-At}x(t)$  \n\n$\\text{L2}:\\,$ ${y}^{′}(t)=-A{e}^{-At}x(t)+{e}^{-At}{x}^{′}(t)$  \n\n$\\text{L3}:\\,$ ${y}^{′}(t)={e}^{-At}g(t)$  \n\n$\\text{L4}:\\,$ $y(t)-y(0)={\\int }_{0}^{t}{e}^{-As}g(s)\\,\\text{d}s$\n\n$\\text{L5}:\\,$ $y(0)=x(0)$ \n\n$\\text{L6}:\\,$ $y(t)=x(0)+{\\int }_{0}^{t}{e}^{-As}g(s)\\,\\text{d}s$  \n\n$\\text{L7}:\\,$ ${e}^{At}y(t)={e}^{At}x(0)+{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\n$\\text{L8}:\\,$ ${e}^{At}y(t)=x(t)$\n\n$\\text{L9}:\\,$ $x(t)={e}^{At}x(0)+{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L5}$ follows from line $\\text{L1}$ by  \n{{field-2}}.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by  \n{{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Differentiating $y(t)={e}^{-At}x(t)$ and applying the product rule gives\n\n$$\n\\begin{aligned}{y}^{′}(t) & =({e}^{-At})^{′}x(t)+{e}^{-At}{x}^{′}(t) \\\\  & =(-A){e}^{-At}x(t)+{e}^{-At}{x}^{′}(t) \\\\  & =-A{e}^{-At}x(t)+{e}^{-At}{x}^{′}(t).\\end{aligned}\n$$\n\nThus, $\\text{L2}$ follows from $\\text{L1}$ by $\\text{differentiating and using the product rule}.$\n\n- Next, we consider lines $\\text{L1}$ and $\\text{L5}.$ Evaluating $y(t)={e}^{-At}x(t)$ at $t=0$ gives\n\n$$\ny(0)={e}^{-A\\cdot 0}x(0)=Ix(0)=x(0).\n$$\n\nTherefore, $\\text{L5}$ follows from $\\text{L1}$ by $\\text{evaluating at }t=0.$\n\n- Finally, we consider lines $\\text{L6}$ and $\\text{L7}.$ Multiplying both sides of\n\n$$\ny(t)=x(0)+{\\int }_{0}^{t}{e}^{-As}g(s)\\,ds\n$$\n\nfrom $\\text{L6}$ by ${e}^{At}$ gives\n\n$$\n\\begin{aligned}{e}^{At}y(t) & ={e}^{At}x(0)+{e}^{At}{\\int }_{0}^{t}{e}^{-As}g(s)\\,\\text{d}s \\\\  & ={e}^{At}x(0)+{\\int }_{0}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s.\\end{aligned}\n$$\n\nTherefore, $\\text{L7}$ follows from $\\text{L6}$ by $\\text{multiplying both sides by }{e}^{At}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f1dc9399-c403-56eb-8f48-08331960ca43" "answer-field-bdcdafbc-2a00-5bc3-a5dd-993258a4e62f" "answer-field-070b8c00-5b6b-5a44-a8d1-5e51fc41aa76"] :db/ensure [:question/validate]} {:db/id "answer-field-f1dc9399-c403-56eb-8f48-08331960ca43" :answer-field/id #uuid "f1dc9399-c403-56eb-8f48-08331960ca43" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-4be10430-59d1-599e-b689-c9308f9eceb6" :answer-field/choices ["answer-4c3b2da4-577b-58b9-8f03-aec6ff89a8b7" "answer-4be10430-59d1-599e-b689-c9308f9eceb6" "answer-eda14cbf-71c6-5101-91f3-6c716e888eef" "answer-8912a77d-a8a2-5b0f-90ee-99de77bd7394"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c3b2da4-577b-58b9-8f03-aec6ff89a8b7" :answer/id #uuid "4c3b2da4-577b-58b9-8f03-aec6ff89a8b7" :answer/type :answer.type/text :answer/value "applying a change of variables" :db/ensure [:answer/validate]} {:db/id "answer-4be10430-59d1-599e-b689-c9308f9eceb6" :answer/id #uuid "4be10430-59d1-599e-b689-c9308f9eceb6" :answer/type :answer.type/text :answer/value "differentiating and using the product rule" :db/ensure [:answer/validate]} {:db/id "answer-eda14cbf-71c6-5101-91f3-6c716e888eef" :answer/id #uuid "eda14cbf-71c6-5101-91f3-6c716e888eef" :answer/type :answer.type/text :answer/value "evaluating at $t=0$" :db/ensure [:answer/validate]} {:db/id "answer-8912a77d-a8a2-5b0f-90ee-99de77bd7394" :answer/id #uuid "8912a77d-a8a2-5b0f-90ee-99de77bd7394" :answer/type :answer.type/text :answer/value "substituting ${x}^{′}(t)=Ax(t)+g(t)$" :db/ensure [:answer/validate]} {:db/id "answer-field-bdcdafbc-2a00-5bc3-a5dd-993258a4e62f" :answer-field/id #uuid "bdcdafbc-2a00-5bc3-a5dd-993258a4e62f" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-55d4713b-294f-5d25-89d5-a2f64e40b04a" :answer-field/choices ["answer-864e8d51-dded-5420-af14-e1f984c4c0a7" "answer-68e03ce5-612b-5030-b312-5b4ab7a5ec29" "answer-55d4713b-294f-5d25-89d5-a2f64e40b04a" "answer-0a8dbdd8-8dfd-5db1-b4cd-9bab37d71d9b"] :db/ensure [:answer-field/validate]} {:db/id "answer-864e8d51-dded-5420-af14-e1f984c4c0a7" :answer/id #uuid "864e8d51-dded-5420-af14-e1f984c4c0a7" :answer/type :answer.type/text :answer/value "applying a change of variables" :db/ensure [:answer/validate]} {:db/id "answer-68e03ce5-612b-5030-b312-5b4ab7a5ec29" :answer/id #uuid "68e03ce5-612b-5030-b312-5b4ab7a5ec29" :answer/type :answer.type/text :answer/value "differentiating and using the sum rule" :db/ensure [:answer/validate]} {:db/id "answer-55d4713b-294f-5d25-89d5-a2f64e40b04a" :answer/id #uuid "55d4713b-294f-5d25-89d5-a2f64e40b04a" :answer/type :answer.type/text :answer/value "evaluating at $t=0$" :db/ensure [:answer/validate]} {:db/id "answer-0a8dbdd8-8dfd-5db1-b4cd-9bab37d71d9b" :answer/id #uuid "0a8dbdd8-8dfd-5db1-b4cd-9bab37d71d9b" :answer/type :answer.type/text :answer/value "multiplying both sides by ${e}^{At}$" :db/ensure [:answer/validate]} {:db/id "answer-field-070b8c00-5b6b-5a44-a8d1-5e51fc41aa76" :answer-field/id #uuid "070b8c00-5b6b-5a44-a8d1-5e51fc41aa76" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-42b3ed5c-fad2-5cc4-8d0b-6a6baccca373" :answer-field/choices ["answer-80c6f160-e91a-566a-bbbc-ef9f781ae2c6" "answer-c752c0eb-512f-538b-978e-3d7df287dd00" "answer-b43d995f-de71-5c35-a7e4-7783c88a1a2a" "answer-42b3ed5c-fad2-5cc4-8d0b-6a6baccca373"] :db/ensure [:answer-field/validate]} {:db/id "answer-80c6f160-e91a-566a-bbbc-ef9f781ae2c6" :answer/id #uuid "80c6f160-e91a-566a-bbbc-ef9f781ae2c6" :answer/type :answer.type/text :answer/value "applying a change of variables" :db/ensure [:answer/validate]} {:db/id "answer-c752c0eb-512f-538b-978e-3d7df287dd00" :answer/id #uuid "c752c0eb-512f-538b-978e-3d7df287dd00" :answer/type :answer.type/text :answer/value "evaluating at $t=0$" :db/ensure [:answer/validate]} {:db/id "answer-b43d995f-de71-5c35-a7e4-7783c88a1a2a" :answer/id #uuid "b43d995f-de71-5c35-a7e4-7783c88a1a2a" :answer/type :answer.type/text :answer/value "integrating both sides" :db/ensure [:answer/validate]} {:db/id "answer-42b3ed5c-fad2-5cc4-8d0b-6a6baccca373" :answer/id #uuid "42b3ed5c-fad2-5cc4-8d0b-6a6baccca373" :answer/type :answer.type/text :answer/value "multiplying both sides by ${e}^{At}$" :db/ensure [:answer/validate]} {:db/id "activity-12416417-305e-5bcf-9b75-2b27fd54eeed" :activity/id #uuid "12416417-305e-5bcf-9b75-2b27fd54eeed" :activity/title "Solving Inhomogeneous Systems of ODEs Using Matrix Methods" :activity/type :activity.type/review :activity/scope 17592186050707 :activity/course 17592186046645 :activity/steps ["step-1c1ad14e-74e6-51e6-a61f-0245fb4cfb09" "step-98ff146f-1e74-5987-92d5-7e14960c7748" "step-6904603d-53fd-531b-aed9-20fdeb45db7b" "step-f824fb6b-0584-52aa-83b5-662d7f07a788" "step-7a5de0ff-7990-5b8c-9f62-a36d2977e2f1"] :activity/first-step "step-1c1ad14e-74e6-51e6-a61f-0245fb4cfb09" :db/ensure [:activity/validate]} {:db/id "step-1c1ad14e-74e6-51e6-a61f-0245fb4cfb09" :step/id #uuid "1c1ad14e-74e6-51e6-a61f-0245fb4cfb09" :step/content 17592186308719 :step/next "step-98ff146f-1e74-5987-92d5-7e14960c7748" :db/ensure [:step/validate]} {:db/id "step-98ff146f-1e74-5987-92d5-7e14960c7748" :step/id #uuid "98ff146f-1e74-5987-92d5-7e14960c7748" :step/content "question-5cb555db-6a59-509d-947e-27c4f1a2a7e6" :step/next "step-6904603d-53fd-531b-aed9-20fdeb45db7b" :db/ensure [:step/validate]} {:db/id "step-6904603d-53fd-531b-aed9-20fdeb45db7b" :step/id #uuid "6904603d-53fd-531b-aed9-20fdeb45db7b" :step/content 17592186311584 :step/next "step-f824fb6b-0584-52aa-83b5-662d7f07a788" :db/ensure [:step/validate]} {:db/id "step-f824fb6b-0584-52aa-83b5-662d7f07a788" :step/id #uuid "f824fb6b-0584-52aa-83b5-662d7f07a788" :step/content "question-ace7005c-d6c8-5219-91cc-32f47feb4972" :step/next "step-7a5de0ff-7990-5b8c-9f62-a36d2977e2f1" :db/ensure [:step/validate]} {:db/id "step-7a5de0ff-7990-5b8c-9f62-a36d2977e2f1" :step/id #uuid "7a5de0ff-7990-5b8c-9f62-a36d2977e2f1" :step/content 17592186370330 :db/ensure [:step/validate]} {:db/id 17592186078517 :knowledge-point/questions ["question-5e9dde9d-e070-5830-aa05-46ebbed13863" "question-cac69546-49cc-507e-802a-92a175e045ac"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078367 :question/problem "Find the image of the point $(-5,2)$ under the action of a dilation with center $O$ and scale factor $-3?$" :question/worked-solution "A dilation with center at the origin and a scale factor of $-3$ can be represented by the function\n\n$$\n(x,y) \\mapsto (-3x,-3y).\n$$\n\nApplying this function to the point $(-5,2),$ we have\n\n$$\n(-5,2) \\mapsto \\big((-3) \\cdot (-5), \\: (-3) \\cdot 2 \\big) = (15,-6).\n$$\n\nTherefore, the resulting point is $(15,-6).$" :db/ensure [:question/validate]} {:db/id 17592186078518 :knowledge-point/questions ["question-a76fa1c3-fa48-5812-bf8b-fa26865dd75b" "question-d78079e7-2f05-54ed-bf64-8723ddffd37e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078368 :question/problem "![](images/83/83e7c4533710e42e16cbe883188f619321914815d905344547bd6c81d253a3ac.png)\n\nWhat is the image of the polygon shown above under a dilation that is centered at the origin and has a scale factor of $-2?$" :question/worked-solution "The dilation with center at the origin and a scale factor of $-2$ can be represented by the function\n\n$$\n(x,y) \\mapsto \\left(-2x,-2y\\right).\n$$\n\nApplying this function to the vertices $(2,1),$ $(3,1),$ $(3,3),$  $(1,3),$ $(1,2),$  and $(2,2),$ we have the following:\n\n$$\n\\begin{aligned}(2,1) & ↦(-2\\cdot 2,\\,-2\\cdot 1)=(-4,-2) \\\\ (3,1) & ↦(-2\\cdot 3,\\,-2\\cdot 1)=(-6,-2) \\\\ (3,3) & ↦(-2\\cdot 3,\\,-2\\cdot 3)=(-6,-6) \\\\ (1,3) & ↦(-2\\cdot 1,\\,-2\\cdot 3)=(-2,-6) \\\\ (1,2) & ↦(-2\\cdot 1,\\,-2\\cdot 2)=(-2,-4) \\\\ (2,2) & ↦(-2\\cdot 2,\\,-2\\cdot 2)=(-4,-4)\\end{aligned}\n$$\n\nTherefore, we get the following polygon.\n\n![](images/a3/a3ce2ccd16db3e9013947b475bbca5fec1d34ff5e10414eff426e8389271c219.png)" :db/ensure [:question/validate]} {:db/id 17592186078519 :knowledge-point/questions ["question-0b671036-c3a4-5237-8125-3af3f125754a" "question-527b9edb-ee7b-5004-b192-96e29f02e1cb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078369 :question/problem "![](images/cd/cd07f68993f7e151e2b24fe9305b726ce40b9bc5f56399d6616e46c83f90cc87.png)\n\n \n\nThe point $P'(-2,-4)$ is the image of the point $P(1,2)$ under a dilation with the center at the origin, as shown above. What is the scale factor of the transformation?" :question/worked-solution "A dilation with center at the origin and a factor of $k$ can be represented by the function \n\n$$\n(x,y) \\mapsto (kx,ky)\\,.\n$$\n\nApplying this function to the point $P$ and equating the result to $P',$ we get\n\n$$\n\\begin{aligned}(k\\cdot 1,k\\cdot 2)=(-2,-4)\\,⟹\\,\\{\\begin{aligned}k=-2 \\\\ 2k=-4.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $k=\\dfrac{(-4)}{2}=-2.$\n\n![](images/21/219980e6dee08094db21c153f37b107d6fd85709aa50cf8c546a5ba050aac567.png)" :db/ensure [:question/validate]} {:db/id 17592186078520 :knowledge-point/questions ["question-19060a1c-49c3-55db-84f0-fb34722058a7" "question-072c2798-6d16-5d14-9659-f337b6ce7515"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078373 :question/problem "![](images/94/94ff7096b1befc0ce2538efc345ff3f090c66ee28f98bf62b6162cfed9226137.png)\n\nA dilation with center $O$ is defined by the function $(x,y)  \\mapsto \\left(\\dfrac53x, \\dfrac53y\\right).$  What is the image of the line shown above under the action of this transformation?" :question/worked-solution "A dilation maps a line $l$ not passing through the center of the dilation onto a parallel line $l'.$ \n\nTo find the image of the line, we proceed as follows: \n\n- Take a point $B \\in l.$\n\n- Find the image $B'$ of $B$ under the dilation.\n\n- Find $l'$ as the line that passes through $B'$ and is parallel to $l.$\n\nNotice that $B(-3,0)$ lies on $l,$ as shown below. The image of this point under the dilation is\n\n$$\n\\begin{aligned}(\\frac{5}{3}\\cdot (-3),\\frac{5}{3}\\cdot 0) & =(-5,0).\\end{aligned}\n$$\n\nTherefore, we have the following image of $l\\mathbin{:}$\n\n![](images/7e/7eca5ac26e32d153f69f67076100c7c1ebc26efe26d5b1603ed459a9101f93db.png)" :db/ensure [:question/validate]} {:db/id "question-5e9dde9d-e070-5830-aa05-46ebbed13863" :question/id #uuid "5e9dde9d-e070-5830-aa05-46ebbed13863" :question/math-academy-id "q-125558" :question/problem "![](images/b8/b8730b1936d1ff9f0c8d3845a70327e351b23c7085f248bcb6e99e73f0cb8c9e.png)\n\nWhich of the following is the image of the point $(8,-4)$ under the action of a dilation with center $O$ and scale factor $\\frac{1}{2}?$" :question/worked-solution "A dilation with center at the origin and a scale factor of $\\frac{1}{2}$ can be represented by the function  \n\n$$\n(x,y)↦(\\frac{1}{2}x,\\frac{1}{2}y).\n$$\n\nApplying this function to the point $(8,-4),$ we have\n\n$$\n(8,-4)↦(\\frac{1}{2}\\cdot 8,\\,\\frac{1}{2}\\cdot (-4))=(4,-2).\n$$\n\nTherefore, the resulting point is $(4,-2).$\n\n![](images/c2/c2c00f1380ce776da3fe4e1ab2b30c969d5d7436966d907db7a0ceb5f0a13f33.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-00281969-c87d-5b23-a09d-d3467e250aad"] :db/ensure [:question/validate]} {:db/id "answer-field-00281969-c87d-5b23-a09d-d3467e250aad" :answer-field/id #uuid "00281969-c87d-5b23-a09d-d3467e250aad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddcee905-986e-51be-9e24-d58126a44580" :answer-field/choices ["answer-855a8c4a-da91-54ff-97cc-06728b6eaf2d" "answer-f9b70be3-592d-5923-9391-fcfd435fd44b" "answer-7329dedf-72c5-5967-ba9a-7094f5e60b60" "answer-ddcee905-986e-51be-9e24-d58126a44580" "answer-3386990f-4a12-5bfb-bca6-dc705891815e"] :db/ensure [:answer-field/validate]} {:db/id "answer-855a8c4a-da91-54ff-97cc-06728b6eaf2d" :answer/id #uuid "855a8c4a-da91-54ff-97cc-06728b6eaf2d" :answer/type :answer.type/image :answer/value "images/0a/0ab97722306686003c288a1dbf39038f0db6d28bedd6d92bb7626dbf18a637b2.png" :db/ensure [:answer/validate]} {:db/id "answer-f9b70be3-592d-5923-9391-fcfd435fd44b" :answer/id #uuid "f9b70be3-592d-5923-9391-fcfd435fd44b" :answer/type :answer.type/image :answer/value "images/8c/8cb47f7a93ce259ff03e04ecd848dd199edf26f357c8c82da29449302728187e.png" :db/ensure [:answer/validate]} {:db/id "answer-7329dedf-72c5-5967-ba9a-7094f5e60b60" :answer/id #uuid "7329dedf-72c5-5967-ba9a-7094f5e60b60" :answer/type :answer.type/image :answer/value "images/b8/b84aa56a8e238e80e673ebec28dc9de1463f32f07fe0163650905e56a9ec0765.png" :db/ensure [:answer/validate]} {:db/id "answer-ddcee905-986e-51be-9e24-d58126a44580" :answer/id #uuid "ddcee905-986e-51be-9e24-d58126a44580" :answer/type :answer.type/image :answer/value "images/cb/cbbf6d9ef8a860214bf8ec1ae867184f96f783ea39288c68483af7984c3e0b1b.png" :db/ensure [:answer/validate]} {:db/id "answer-3386990f-4a12-5bfb-bca6-dc705891815e" :answer/id #uuid "3386990f-4a12-5bfb-bca6-dc705891815e" :answer/type :answer.type/image :answer/value "images/f4/f4f6a383a5aced3a181ad9b910a5e3990ee9a2febe2af6a8f27bb53a32f07c32.png" :db/ensure [:answer/validate]} {:db/id "question-cac69546-49cc-507e-802a-92a175e045ac" :question/id #uuid "cac69546-49cc-507e-802a-92a175e045ac" :question/math-academy-id "q-125574" :question/problem "![](images/84/841dfcfabb27fe93002cb05c8d84ad9da2e0a9f6b810476e7964651e515e757c.png)\n\nWhich of the following is the image of the point $(8,-6)$ under the action of a dilation with center $O$ and scale factor $\\frac{1}{2}?$" :question/worked-solution "A dilation with center at the origin and a scale factor of $\\frac{1}{2}$ can be represented by the function\n\n$$\n(x,y)↦(\\frac{1}{2}x,\\frac{1}{2}y).\n$$\n\nApplying this function to the point $(8,-6),$ we have\n\n$$\n(8,-6)↦(\\frac{1}{2}\\cdot 8,\\,\\frac{1}{2}\\cdot (-6))=(4,-3).\n$$\n\nTherefore, the resulting point is $(4,-3).$\n\n![](images/53/53df2214415b81380c96af98b2d073e2a16480715386926603cd471eec66dec6.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-275fc850-3e33-59ce-9392-09c44d4021e2"] :db/ensure [:question/validate]} {:db/id "answer-field-275fc850-3e33-59ce-9392-09c44d4021e2" :answer-field/id #uuid "275fc850-3e33-59ce-9392-09c44d4021e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f24f992-4e40-57bc-8429-0ac08457c506" :answer-field/choices ["answer-d7270f80-e748-5db4-a204-f36a17d9bcea" "answer-3604c806-fdc9-5cbd-952d-ce15ba543740" "answer-2612f47d-0452-52a5-b697-b1b879af646c" "answer-8f24f992-4e40-57bc-8429-0ac08457c506" "answer-2e1b842b-03ba-5e9b-84c1-8c4e10efb822"] :db/ensure [:answer-field/validate]} {:db/id "answer-d7270f80-e748-5db4-a204-f36a17d9bcea" :answer/id #uuid "d7270f80-e748-5db4-a204-f36a17d9bcea" :answer/type :answer.type/image :answer/value "images/1b/1b6adf3c5a87eee1dc41b4b8bfe10303f8f11d9c84e992e71d51f62cb3cdd363.png" :db/ensure [:answer/validate]} {:db/id "answer-3604c806-fdc9-5cbd-952d-ce15ba543740" :answer/id #uuid "3604c806-fdc9-5cbd-952d-ce15ba543740" :answer/type :answer.type/image :answer/value "images/44/44e6342a13efb1aff9a223a48c5da9ba41d04a5a2944fdf4bdb08b3ff947c47f.png" :db/ensure [:answer/validate]} {:db/id "answer-2612f47d-0452-52a5-b697-b1b879af646c" :answer/id #uuid "2612f47d-0452-52a5-b697-b1b879af646c" :answer/type :answer.type/image :answer/value "images/d2/d238f021b9afd090dbc768cae0a6516969a0b281e88175889c5c616874739f10.png" :db/ensure [:answer/validate]} {:db/id "answer-8f24f992-4e40-57bc-8429-0ac08457c506" :answer/id #uuid "8f24f992-4e40-57bc-8429-0ac08457c506" :answer/type :answer.type/image :answer/value "images/d5/d535d5bb169ecd50b41de6900dca3fbaa3314f1b510145b0266b680e60f22179.png" :db/ensure [:answer/validate]} {:db/id "answer-2e1b842b-03ba-5e9b-84c1-8c4e10efb822" :answer/id #uuid "2e1b842b-03ba-5e9b-84c1-8c4e10efb822" :answer/type :answer.type/image :answer/value "images/d6/d6c03d6d7cf77a6cf53bef74f08b823c4c53e60fa500aabeeead4b9fe6aac6d9.png" :db/ensure [:answer/validate]} {:db/id "question-a76fa1c3-fa48-5812-bf8b-fa26865dd75b" :question/id #uuid "a76fa1c3-fa48-5812-bf8b-fa26865dd75b" :question/math-academy-id "q-125692" :question/problem "![](images/98/98e64a245737736bfc987fe9230b1ee3fc81eef4aedfea8c2e5e9bcf949f8203.png)\n\nWhat is the image of the polygon shown above under a dilation that is centered at the origin and has a scale factor of $-\\frac{2}{3}?$" :question/worked-solution "The dilation with center at the origin and a scale factor of $-\\frac{2}{3}$ can be represented by the function\n\n$$\n(x,y)↦(-\\frac{2}{3}x,-\\frac{2}{3}y).\n$$\n\nApplying this function to the vertices $(-3,-3),$ $(0,0),$  and $(-3,3),$ we have the following:\n\n$$\n\\begin{aligned}(-3,-3) & ↦(-\\frac{2}{3}\\cdot (-3),\\,-\\frac{2}{3}\\cdot (-3))=(2,2) \\\\ (0,0) & ↦(-\\frac{2}{3}\\cdot 0,\\,-\\frac{2}{3}\\cdot 0)=(0,0) \\\\ (-3,3) & ↦(-\\frac{2}{3}\\cdot (-3),\\,-\\frac{2}{3}\\cdot 3)=(2,-2)\\end{aligned}\n$$\n\nTherefore, we get the following polygon.\n\n![](images/29/2921272ffd1c38c082bf2123086d8c7b19a910c91d132810042b86728b820f8d.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aa59387b-3aeb-5780-923e-0243d4eb6960"] :db/ensure [:question/validate]} {:db/id "answer-field-aa59387b-3aeb-5780-923e-0243d4eb6960" :answer-field/id #uuid "aa59387b-3aeb-5780-923e-0243d4eb6960" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f91e2358-9481-5e26-8eb3-f2aff1529abc" :answer-field/choices ["answer-f91e2358-9481-5e26-8eb3-f2aff1529abc" "answer-c24f84de-5c00-518c-ab34-899bc789aed5" "answer-1a665b85-1226-5bdb-bb70-29b874a55538" "answer-cbef1f47-0b08-587d-9e20-b7fbcb525255" "answer-f3b6343b-0aab-5a56-b101-de38eae283b6"] :db/ensure [:answer-field/validate]} {:db/id "answer-f91e2358-9481-5e26-8eb3-f2aff1529abc" :answer/id #uuid "f91e2358-9481-5e26-8eb3-f2aff1529abc" :answer/type :answer.type/image :answer/value "images/1a/1aebfca6500abd5c7298492121f0c087c2c1861ee4bd770c27867d7e37fb631a.png" :db/ensure [:answer/validate]} {:db/id "answer-c24f84de-5c00-518c-ab34-899bc789aed5" :answer/id #uuid "c24f84de-5c00-518c-ab34-899bc789aed5" :answer/type :answer.type/image :answer/value "images/63/6390b39e47b76519fe13b4cb4ed8a666ec45ff81a3f26d5d737ba11e7b8a2fa1.png" :db/ensure [:answer/validate]} {:db/id "answer-1a665b85-1226-5bdb-bb70-29b874a55538" :answer/id #uuid "1a665b85-1226-5bdb-bb70-29b874a55538" :answer/type :answer.type/image :answer/value "images/70/70ab8c2fe67dbf76952995240d2bdcf102111c2ce8cfe91850886e9a439dcd45.png" :db/ensure [:answer/validate]} {:db/id "answer-cbef1f47-0b08-587d-9e20-b7fbcb525255" :answer/id #uuid "cbef1f47-0b08-587d-9e20-b7fbcb525255" :answer/type :answer.type/image :answer/value "images/90/904c2c513ad7899b0c031b469d4f0d3505cc95d5e365c9437408e6f9828906fa.png" :db/ensure [:answer/validate]} {:db/id "answer-f3b6343b-0aab-5a56-b101-de38eae283b6" :answer/id #uuid "f3b6343b-0aab-5a56-b101-de38eae283b6" :answer/type :answer.type/image :answer/value "images/c5/c5acbc87cedde74b975d86c528d66bd779dfc72778d178fc8eacca09c7ff9ad9.png" :db/ensure [:answer/validate]} {:db/id "question-d78079e7-2f05-54ed-bf64-8723ddffd37e" :question/id #uuid "d78079e7-2f05-54ed-bf64-8723ddffd37e" :question/math-academy-id "q-88115" :question/problem "![](images/3a/3a512ef7399ac46c611335a9f957bfae9a14e802ddd39e492f6184e0e149fb7e.png)\n\nWhat is the image of the segment $\\overset{―}{AB}$ under a dilation that is centered at the origin and has a scale factor of $\\frac{1}{3}?$" :question/worked-solution "A dilation with center at the origin and a scale factor of $\\frac{1}{3}$ can be represented by the function\n\n$$\n(x,y)↦(\\frac{1}{3}x,\\frac{1}{3}y).\n$$\n\nApplying this function to the endpoints $A(-6,-3)$ and $B(3,6),$ we have the following:\n\n$$\n\\begin{aligned}(-6,-3) & ↦(\\frac{1}{3}\\cdot (-6),\\frac{1}{3}\\cdot -3)=(-2,-1) \\\\ (3,6) & ↦(\\frac{1}{3}\\cdot (3),\\frac{1}{3}\\cdot 6)=(1,2)\\end{aligned}\n$$\n\nTherefore, the resulting points are ${A}^{′}(-2,-1)$ and ${B}^{′}(1,2).$\n\nFinally, we connect ${A}^{′}$ and ${B}^{′}$ using a segment, as shown below. \n\n![](images/ba/ba27f325ca104397544c7b5d19078d59cf63209a83d89de73cdeb752f5c0fc84.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cefe190e-880c-5995-8a4f-2586cdd0f966"] :db/ensure [:question/validate]} {:db/id "answer-field-cefe190e-880c-5995-8a4f-2586cdd0f966" :answer-field/id #uuid "cefe190e-880c-5995-8a4f-2586cdd0f966" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ba9abd05-e3b6-58c7-a525-78bff06276fa" :answer-field/choices ["answer-ffcdbe44-93f8-5fd0-b357-ad330a45faa2" "answer-ba9abd05-e3b6-58c7-a525-78bff06276fa" "answer-3fdd8d35-d9a7-5d19-b7a9-d4f954803563" "answer-29429d07-f776-589c-b450-b75891b15930" "answer-71ecab29-a47f-5134-9720-b57436f489c0"] :db/ensure [:answer-field/validate]} {:db/id "answer-ffcdbe44-93f8-5fd0-b357-ad330a45faa2" :answer/id #uuid "ffcdbe44-93f8-5fd0-b357-ad330a45faa2" :answer/type :answer.type/image :answer/value "images/3c/3c2790d0b0fe66da1c1eab58ccea08db6991c3245af4308b1dd2fcb1da06adb9.png" :db/ensure [:answer/validate]} {:db/id "answer-ba9abd05-e3b6-58c7-a525-78bff06276fa" :answer/id #uuid "ba9abd05-e3b6-58c7-a525-78bff06276fa" :answer/type :answer.type/image :answer/value "images/62/62b28c3c84e9cc5d4013eef8a75bb826e71fe63cacfc42d1ef96ccdad1dd1ab8.png" :db/ensure [:answer/validate]} {:db/id "answer-3fdd8d35-d9a7-5d19-b7a9-d4f954803563" :answer/id #uuid "3fdd8d35-d9a7-5d19-b7a9-d4f954803563" :answer/type :answer.type/image :answer/value "images/6a/6a60e312e154995129aa750878dc41b5dfdb10d95af629e2ce96ff0469ecc63e.png" :db/ensure [:answer/validate]} {:db/id "answer-29429d07-f776-589c-b450-b75891b15930" :answer/id #uuid "29429d07-f776-589c-b450-b75891b15930" :answer/type :answer.type/image :answer/value "images/8b/8be8f57344a57823633011369efda0559726af65bac3af2e88ac5323ef653ac6.png" :db/ensure [:answer/validate]} {:db/id "answer-71ecab29-a47f-5134-9720-b57436f489c0" :answer/id #uuid "71ecab29-a47f-5134-9720-b57436f489c0" :answer/type :answer.type/image :answer/value "images/9c/9c32a2847a8027942d8b8e275b470a63920bc05ace6866cbf60bfa4bdd3ef322.png" :db/ensure [:answer/validate]} {:db/id "question-0b671036-c3a4-5237-8125-3af3f125754a" :question/id #uuid "0b671036-c3a4-5237-8125-3af3f125754a" :question/math-academy-id "q-125779" :question/problem "![](images/14/14ca2d4167ff6950d5a9d7bb41cc856ecbc211a033518b8b366ac977953700b1.png)\n\nThe point ${P}^{′}(3,1.5)$ is the image of the point $P(-4,-2)$ under a dilation with the center at the origin, as shown above. What is the scale factor of the transformation?" :question/worked-solution "A dilation with center at the origin and a factor of $k$ can be represented by the function\n\n$$\n(x,y)↦(kx,ky)\\,.\n$$\n\nApplying this function to the point $P$ and equating the result to ${P}^{′},$ we get\n\n$$\n\\begin{aligned}(k\\cdot (-4),k\\cdot (-2)=(3,1.5)\\,⟹\\,\\{\\begin{aligned}-4k=3 \\\\ -2k=1.5.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, $k=\\frac{3}{-4}=\\frac{1.5}{-2}=-\\frac{3}{4}.$   \n\n![](images/d3/d3b818151bcfddd3fd4f642463ba4e06ba1844d4b772652dadde0d3049e441ee.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d8a55fbf-ed96-50fd-a31b-6db6c54e9cf1"] :db/ensure [:question/validate]} {:db/id "answer-field-d8a55fbf-ed96-50fd-a31b-6db6c54e9cf1" :answer-field/id #uuid "d8a55fbf-ed96-50fd-a31b-6db6c54e9cf1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac7ae81f-0d85-559d-8d81-82c0fa4336b8" :answer-field/choices ["answer-65f2d77a-2b81-5d83-98b3-76968aebd21b" "answer-c9fc64ad-4252-5b4b-bd30-9d46db806f36" "answer-ac7ae81f-0d85-559d-8d81-82c0fa4336b8" "answer-98f7f5ac-92f2-57d4-9f68-6f000ab5715b" "answer-e0d75dd9-891a-59ff-9bb8-4426ce367ae3"] :db/ensure [:answer-field/validate]} {:db/id "answer-65f2d77a-2b81-5d83-98b3-76968aebd21b" :answer/id #uuid "65f2d77a-2b81-5d83-98b3-76968aebd21b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c9fc64ad-4252-5b4b-bd30-9d46db806f36" :answer/id #uuid "c9fc64ad-4252-5b4b-bd30-9d46db806f36" :answer/type :answer.type/math :answer/value "-\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-ac7ae81f-0d85-559d-8d81-82c0fa4336b8" :answer/id #uuid "ac7ae81f-0d85-559d-8d81-82c0fa4336b8" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-98f7f5ac-92f2-57d4-9f68-6f000ab5715b" :answer/id #uuid "98f7f5ac-92f2-57d4-9f68-6f000ab5715b" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-e0d75dd9-891a-59ff-9bb8-4426ce367ae3" :answer/id #uuid "e0d75dd9-891a-59ff-9bb8-4426ce367ae3" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "question-527b9edb-ee7b-5004-b192-96e29f02e1cb" :question/id #uuid "527b9edb-ee7b-5004-b192-96e29f02e1cb" :question/math-academy-id "q-125795" :question/problem "![](images/bf/bfcd52f31f825e6445700e8495f7acbfce46139144f8bb61e977b2971e01d877.png)\n\nThe larger polygon shown above is the image of the smaller one under the action of a dilation. Find the center of the dilation and its scale factor $k.$" :question/worked-solution "The center of a dilation lies on any line which passes through a point and its image.\n\nTherefore, we can find the center of our dilation as, for example, the point of intersection of the lines $\\overset{⟷}{B{B}^{′}}$ and $\\overset{⟷}{C{C}^{′}},$ as shown below.  \n\n![](images/d7/d7215165822a95ce9689e3666ff6ea9454048a936c372b07a6224d199b8d0ed7.png)\n\nFrom the diagram above, where we have that \n\n$$\n\\frac{{B}^{′}{C}^{′}}{BC}=\\frac{6}{2}=3,\n$$\n\nand the same proportion holds for the other corresponding sides too. As a result, the absolute value of the scale factor is \n\n$$\n|k|=3.\n$$\n\n \n\nFinally, notice that our figures have different orientations, which means that the scale factor of the dilation is negative.\n\nTherefore, the scale factor is $k=-3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-43599aae-3923-57f9-9d7f-5a5e257af57c"] :db/ensure [:question/validate]} {:db/id "answer-field-43599aae-3923-57f9-9d7f-5a5e257af57c" :answer-field/id #uuid "43599aae-3923-57f9-9d7f-5a5e257af57c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dbf86178-cb6d-5845-8045-a92fc476055e" :answer-field/choices ["answer-1e312727-bada-52b7-812c-8e09bc0642fa" "answer-4d5909d8-e636-596d-bf60-0dffd5c4f965" "answer-4f9a4d27-439e-5b3c-aa98-588adc4b66e2" "answer-ccd6096f-fbbc-553e-a9fe-bc9586b939ea" "answer-dbf86178-cb6d-5845-8045-a92fc476055e"] :db/ensure [:answer-field/validate]} {:db/id "answer-1e312727-bada-52b7-812c-8e09bc0642fa" :answer/id #uuid "1e312727-bada-52b7-812c-8e09bc0642fa" :answer/type :answer.type/math :answer/value "(-1,0),\\,\\,k=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4d5909d8-e636-596d-bf60-0dffd5c4f965" :answer/id #uuid "4d5909d8-e636-596d-bf60-0dffd5c4f965" :answer/type :answer.type/math :answer/value "(-1,2),\\,\\,k=-2" :db/ensure [:answer/validate]} {:db/id "answer-4f9a4d27-439e-5b3c-aa98-588adc4b66e2" :answer/id #uuid "4f9a4d27-439e-5b3c-aa98-588adc4b66e2" :answer/type :answer.type/math :answer/value "(0,0),\\,\\,k=\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-ccd6096f-fbbc-553e-a9fe-bc9586b939ea" :answer/id #uuid "ccd6096f-fbbc-553e-a9fe-bc9586b939ea" :answer/type :answer.type/math :answer/value "(0,1),\\,\\,k=-2" :db/ensure [:answer/validate]} {:db/id "answer-dbf86178-cb6d-5845-8045-a92fc476055e" :answer/id #uuid "dbf86178-cb6d-5845-8045-a92fc476055e" :answer/type :answer.type/math :answer/value "(0,2),\\,\\,k=-3" :db/ensure [:answer/validate]} {:db/id "question-19060a1c-49c3-55db-84f0-fb34722058a7" :question/id #uuid "19060a1c-49c3-55db-84f0-fb34722058a7" :question/math-academy-id "q-89713" :question/problem "![](images/4c/4c3e53db0b578b306a12711c4e69a0d75b850cb1eecc8d5b0e6df79acc494d7a.png)\n\nA dilation with center $O$ is defined by the function $(x,y)↦(0.2x,0.2y).$  What is the image of the line shown above under the action of this transformation?" :question/worked-solution "A dilation leaves a line passing through the center of the dilation unchanged.\n\nTherefore, the image ${l}^{′}$ of the line $l$ under the dilation  $(x,y)↦(0.2x,0.2y)$ is the line $l$ itself, as shown below. \n\n![](images/1a/1ab7188d164a491720d4d9d361abd4c2c76ea2cb09f6edbea3b0790a6281a785.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-634e8bd6-02be-52c8-9cbc-dcd8b0febd04"] :db/ensure [:question/validate]} {:db/id "answer-field-634e8bd6-02be-52c8-9cbc-dcd8b0febd04" :answer-field/id #uuid "634e8bd6-02be-52c8-9cbc-dcd8b0febd04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b0c3925a-ff93-5ff6-9579-e89f60e4c383" :answer-field/choices ["answer-b0c3925a-ff93-5ff6-9579-e89f60e4c383" "answer-63057f8d-acc1-5c02-9c3d-35b87b2aa8e4" "answer-bea75270-7e93-5ea0-a4d7-4acdfe542a9a" "answer-32dc054f-2980-5bb1-b264-e8fa82722b0f" "answer-596b245e-15d7-5d45-9065-b70aba8d4afd"] :db/ensure [:answer-field/validate]} {:db/id "answer-b0c3925a-ff93-5ff6-9579-e89f60e4c383" :answer/id #uuid "b0c3925a-ff93-5ff6-9579-e89f60e4c383" :answer/type :answer.type/image :answer/value "images/1a/1ab7188d164a491720d4d9d361abd4c2c76ea2cb09f6edbea3b0790a6281a785.png" :db/ensure [:answer/validate]} {:db/id "answer-63057f8d-acc1-5c02-9c3d-35b87b2aa8e4" :answer/id #uuid "63057f8d-acc1-5c02-9c3d-35b87b2aa8e4" :answer/type :answer.type/image :answer/value "images/1c/1c9d1aac1d969ec9f573a5d11f547f564648c93573524fafcb20f6f5dc385b33.png" :db/ensure [:answer/validate]} {:db/id "answer-bea75270-7e93-5ea0-a4d7-4acdfe542a9a" :answer/id #uuid "bea75270-7e93-5ea0-a4d7-4acdfe542a9a" :answer/type :answer.type/image :answer/value "images/45/459338ee2015385d68c149997a06e8789c55cd604f465d32bf3ec3ffaec2b940.png" :db/ensure [:answer/validate]} {:db/id "answer-32dc054f-2980-5bb1-b264-e8fa82722b0f" :answer/id #uuid "32dc054f-2980-5bb1-b264-e8fa82722b0f" :answer/type :answer.type/image :answer/value "images/7f/7ffb2de45c233357c4304386595a2a74927e6b916ab45b3e3ffdc0174c2ed720.png" :db/ensure [:answer/validate]} {:db/id "answer-596b245e-15d7-5d45-9065-b70aba8d4afd" :answer/id #uuid "596b245e-15d7-5d45-9065-b70aba8d4afd" :answer/type :answer.type/image :answer/value "images/a4/a4f2c5660320dd58ee2fdfa6d5c9599c5d5980a4fdbea45f716261bcd48171fa.png" :db/ensure [:answer/validate]} {:db/id "question-072c2798-6d16-5d14-9659-f337b6ce7515" :question/id #uuid "072c2798-6d16-5d14-9659-f337b6ce7515" :question/math-academy-id "q-125817" :question/problem "![](images/3c/3c90c2114f36f77c9bb06c47398f4f5a4ce3b8fc6aadf2a77d28c447a8e424c7.png)\n\nA dilation with center $O$ is defined by the function $(x,y)↦(1.5x,1.5y).$  What is the image of the line shown above under the action of this transformation?" :question/worked-solution "A dilation leaves a line passing through the center of the dilation unchanged.\n\nTherefore, the image ${l}^{′}$ of the line $l$ under the dilation  $(x,y)↦(1.5x,1.5y)$ is the line $l$ itself, as shown below. \n\n![](images/b4/b48fecb9d9286ac4df6a9bfbf151fd78a98d223f7375e5251cda1119f8f66611.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6774d78d-cf72-59c0-be71-b2e0814c570a"] :db/ensure [:question/validate]} {:db/id "answer-field-6774d78d-cf72-59c0-be71-b2e0814c570a" :answer-field/id #uuid "6774d78d-cf72-59c0-be71-b2e0814c570a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bfede5e5-f812-5503-97cf-36f17813e91c" :answer-field/choices ["answer-bfede5e5-f812-5503-97cf-36f17813e91c" "answer-8db2ffcf-78a1-5f3d-b155-917a047be811" "answer-a4eff6f3-1f4d-5089-a800-4d9d29a522f9" "answer-7c8e3ce8-668b-5227-b128-873575aa7bd8" "answer-0b33e64c-d85c-5034-8e80-bf428c69c247"] :db/ensure [:answer-field/validate]} {:db/id "answer-bfede5e5-f812-5503-97cf-36f17813e91c" :answer/id #uuid "bfede5e5-f812-5503-97cf-36f17813e91c" :answer/type :answer.type/image :answer/value "images/11/11ecad2a9413eecf0f04bffedf12d94f80e3e6a5eb45c91743e209398be28f30.png" :db/ensure [:answer/validate]} {:db/id "answer-8db2ffcf-78a1-5f3d-b155-917a047be811" :answer/id #uuid "8db2ffcf-78a1-5f3d-b155-917a047be811" :answer/type :answer.type/image :answer/value "images/70/70e14f919d998a99c0783764952aec683074d62f842bafda05f46176079b9918.png" :db/ensure [:answer/validate]} {:db/id "answer-a4eff6f3-1f4d-5089-a800-4d9d29a522f9" :answer/id #uuid "a4eff6f3-1f4d-5089-a800-4d9d29a522f9" :answer/type :answer.type/image :answer/value "images/83/8380f0c8ef4c74cde183520cbe66be12fac04498ed5ea9804d36564e22f7fa61.png" :db/ensure [:answer/validate]} {:db/id "answer-7c8e3ce8-668b-5227-b128-873575aa7bd8" :answer/id #uuid "7c8e3ce8-668b-5227-b128-873575aa7bd8" :answer/type :answer.type/image :answer/value "images/be/beb0987ba8ae5b8c2aec03fbf8a3f115beec6b2c4243944d61855c2b209ce3bc.png" :db/ensure [:answer/validate]} {:db/id "answer-0b33e64c-d85c-5034-8e80-bf428c69c247" :answer/id #uuid "0b33e64c-d85c-5034-8e80-bf428c69c247" :answer/type :answer.type/image :answer/value "images/fe/fe097fd7a569e551491d6d1ee4959af9d8d6d98e4b0bf78342f3e65c2be2e08a.png" :db/ensure [:answer/validate]} {:db/id 17592186079678 :tutorial/content "In the coordinate plane, dilations are typically centered at the origin. When a dilation is centered at the origin, it can be represented by a function\n\n$$\n(x,y) \\mapsto (kx, ky)\n$$\n\nwhere $k$ is the scale factor of the dilation.\n\nFor example, let's compute the image of the point $(3,2)$ (shown below) under the action of a dilation with center $O$ and scale factor $3.$ \n\n![](images/2d/2da731925da5705e15cb58abd632e52c04139e8052772eeaa3ca2862fd6d3d02.png)\n\nA dilation with center at the origin and a scale factor of $3$ can be represented by the function\n\n$$\n(x,y) \\mapsto \\left(3x,3y\\right).\n$$\n\nApplying this function to the point $(3,2),$ we have\n\n$$\n(3,2) \\mapsto \\left(3\\cdot 3, \\:3 \\cdot 2 \\right) = (9,6).\n$$\n\nTherefore, the resulting point is $(9,6).$\n\n![](images/94/9410030b5b309d512c937741e9fdb85abad0aacdd712f81ee0b50897523952cc.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186079703 :tutorial/content "Let's discuss how to find a center of a dilation\n\nThe center of a dilation lies on any line that passes through corresponding points on a figure and its image. Therefore, we can find a center of dilation as the intersection of any two of these lines. \n\nLet's look at some examples:\n\n- Consider the rectangle $ABCD$ and its image $A'B'C'D'$ under the action of a dilation, shown below.\n\n![](images/91/9115c6a43d20f58e8c2e4b9a77337edd18688dd831168405062c6e0fbe207bb0.png)\n\nWe can find the center of dilation $O$ by connecting two corresponding points with a straight line and finding their intersection. \n\nFor example, if we draw the lines $\\overset{\\longleftrightarrow}{AA'}$ and $\\overset{\\longleftrightarrow}{BB'}$ and find their intersection, we get the center of dilation $O$ shown below.\n\n![](images/4a/4a3b1ac04e7d549aafdcf50ea55e172f385fbb7a71bd061c74581ca50f94535a.png)\n\n- Sometimes, a figure and its image lie on opposite sides of the center of dilation. \n\nFor example, consider the rectangle $ABCD$ and its image $A'B'C'D'$ shown below. \n\n![](images/a8/a8918779d1b5152e7071bdb7ba7d349978b166ff613ec2c8b918f9c2ea5b0b92.png)\n\nIf we draw the lines $\\overset{\\longleftrightarrow}{AA'}$ and $\\overset{\\longleftrightarrow}{BB'},$ we find that the center of dilation $O$ lies between the two shapes.\n\n![](images/14/14c6bc0bd148d2ac61c42d4e1636c4301a7af77e773338358e51e4a297f40a48.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186079679 :tutorial/content "If $l$ is a line passing through the center of dilation, then the image $l'$ under the dilation is the same as the original line. \n\n![](images/eb/eb208ea1b492a1d471e0ffb6b3f23fa80a4747f3b5f6da1ad126c30716e52743.png)\n\nHowever, if $k$ is a line that does not pass through the center of dilation, then the image $k'$ is parallel to the original line.\n\n![](images/09/09a11211bde36f85dfe48e4a769314d084edc99c523b869ed3f9a518784fb9a6.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186078625 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} [:db/retract 17592186094867 :answer-field/choices 17592186094868] [:db/retract 17592186094867 :answer-field/choices 17592186094869] [:db/retract 17592186094867 :answer-field/choices 17592186094870] [:db/retract 17592186094867 :answer-field/choices 17592186094871] [:db/retract 17592186094867 :answer-field/choices 17592186094872] {:db/id 17592186096784 :knowledge-point/questions ["question-c4ed7da6-2468-5aec-962f-cfbcbb62e8fe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c4ed7da6-2468-5aec-962f-cfbcbb62e8fe" :question/id #uuid "c4ed7da6-2468-5aec-962f-cfbcbb62e8fe" :question/math-academy-id "q-18697" :question/problem "Let $(x,y)$ be the solution of the following system. What is the value of $x-y?$\n\n$$\n\\{\\begin{aligned}0.04x-0.08y-4=0 \\\\ 2x-3y=4\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the top equation by $100,$ as follows:\n\n$$\n\\{\\begin{aligned}0.04x-0.08y-4=0 & |\\,\\times 100 \\\\ 2x-3y=4 & \\end{aligned}\\,⟹\\,\\{\\begin{aligned}4x-8y-400=0 \\\\ 2x-3y=4\\end{aligned}\n$$\n\nNotice that if we multiply the second equation by $-2,$ we will get a $-4x$ term in the second equation that can cancel with the $4x$ term in the first equation:\n\n$$\n\\{\\begin{aligned}4x-8y-400=0 &  \\\\ 2x-3y=4 & |\\,\\times (-2)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}4x-8y-400=0 \\\\ -4x+6y=-8\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\cancel{4x}-8y-400 & =0 \\\\ -\\cancel{4x}+6y & =-8 \\\\ (-8y+6y)-400 & =-8 \\\\ -2y & =392 \\\\ y & =-196\\end{aligned}\n$$\n\nFinally, we can substitute $y=-196$ into the equation $2x-3y=4$ to solve for $x:$\n\n$$\n\\begin{aligned}2x-3y & =4 \\\\ 2x-3(-196) & =4 \\\\ 2x+588 & =4 \\\\ 2x & =-584 \\\\ x & =-292\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=-292$ and $y=-196.$ So, \n\n$$\nx-y=-292-(-196)=-292+196=-96.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7c91a14a-bb0b-5009-a73f-c0026c98e31c"] :db/ensure [:question/validate]} {:db/id "answer-field-7c91a14a-bb0b-5009-a73f-c0026c98e31c" :answer-field/id #uuid "7c91a14a-bb0b-5009-a73f-c0026c98e31c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-568f958f-3170-5ebb-9dbd-ad93f7c5fe07" :answer-field/choices ["answer-a1b59232-9050-5b0c-8245-2c74284bbb90" "answer-568f958f-3170-5ebb-9dbd-ad93f7c5fe07" "answer-227a8863-645d-5b6a-927f-2a72b437610f" "answer-eb27dbfa-ca02-5d9c-abad-838dbe761243" "answer-0e595558-a7b5-5d7e-a16f-ecdb52280ea7"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1b59232-9050-5b0c-8245-2c74284bbb90" :answer/id #uuid "a1b59232-9050-5b0c-8245-2c74284bbb90" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-568f958f-3170-5ebb-9dbd-ad93f7c5fe07" :answer/id #uuid "568f958f-3170-5ebb-9dbd-ad93f7c5fe07" :answer/type :answer.type/math :answer/value "-96" :db/ensure [:answer/validate]} {:db/id "answer-227a8863-645d-5b6a-927f-2a72b437610f" :answer/id #uuid "227a8863-645d-5b6a-927f-2a72b437610f" :answer/type :answer.type/math :answer/value "192" :db/ensure [:answer/validate]} {:db/id "answer-eb27dbfa-ca02-5d9c-abad-838dbe761243" :answer/id #uuid "eb27dbfa-ca02-5d9c-abad-838dbe761243" :answer/type :answer.type/math :answer/value "196" :db/ensure [:answer/validate]} {:db/id "answer-0e595558-a7b5-5d7e-a16f-ecdb52280ea7" :answer/id #uuid "0e595558-a7b5-5d7e-a16f-ecdb52280ea7" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id 17592186096785 :knowledge-point/questions ["question-dd60924f-af00-5e97-9e77-c29eb2bc8035"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186097149 :question/problem "Find the solution of the following system:\n\n$$\n\\{\\begin{aligned}0.2p+0.3q=0.6 \\\\ 0.2p-0.1q=0.4\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply both equations by $10,$ as follows:\n\n$$\n\\{\\begin{aligned}0.2p+0.3q=0.6 & |\\times 10 \\\\ 0.2p-0.1q=0.4 & |\\times 10\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2p+3q=6 \\\\ 2p-q=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $-1,$ then we will get a $-2p$ term that can cancel with the $2p$ term in the first equation:\n\n$$\n\\{\\begin{aligned}2p+3q=6 &  \\\\ 2p-q=4 & |\\,\\times (-1)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}2p+3q=6 \\\\ -2p+q=-4\\end{aligned}\n$$\n\nAdding the two equations eliminates the $p$-variable and allows us to solve for $q:$\n\n$$\n\\begin{aligned}\\cancel{2p}+3q & =6 \\\\ -\\cancel{2p}+q & =-4 \\\\ (3q+q) & =(6-4) \\\\ 4q & =2 \\\\ q & =\\frac{2}{4} \\\\ q & =0.5\\end{aligned}\n$$\n\nFinally, we can substitute $q=0.5$ into the equation $2p-q=4$ to solve for $p:$\n\n$$\n\\begin{aligned}2p-q & =4 \\\\ 2p-0.5 & =4 \\\\ 2p & =4.5 \\\\ p & =\\frac{4.5}{2} \\\\ p & =2.25\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=2.25,\\,q=0.5.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186094867 :answer-field/correct "answer-21d7b079-5b50-5b5d-a77e-c9a71268f693" :answer-field/choices ["answer-4eb64a1d-8845-5aea-9803-8f15099d25a3" "answer-21d7b079-5b50-5b5d-a77e-c9a71268f693" "answer-77264515-b435-5964-ac00-91f1b1107f1d" "answer-4fbd9059-e12a-555b-8cce-f4bef805bb62" "answer-65c25a18-a5c0-51c1-96fe-a97b57c8f7e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-4eb64a1d-8845-5aea-9803-8f15099d25a3" :answer/id #uuid "4eb64a1d-8845-5aea-9803-8f15099d25a3" :answer/type :answer.type/math :answer/value "p=1.25,\\,q=-16" :db/ensure [:answer/validate]} {:db/id "answer-21d7b079-5b50-5b5d-a77e-c9a71268f693" :answer/id #uuid "21d7b079-5b50-5b5d-a77e-c9a71268f693" :answer/type :answer.type/math :answer/value "p=2.25,\\,q=0.5" :db/ensure [:answer/validate]} {:db/id "answer-77264515-b435-5964-ac00-91f1b1107f1d" :answer/id #uuid "77264515-b435-5964-ac00-91f1b1107f1d" :answer/type :answer.type/math :answer/value "p=3.5,\\,q=3" :db/ensure [:answer/validate]} {:db/id "answer-4fbd9059-e12a-555b-8cce-f4bef805bb62" :answer/id #uuid "4fbd9059-e12a-555b-8cce-f4bef805bb62" :answer/type :answer.type/math :answer/value "p=4.75,\\,q=5.5" :db/ensure [:answer/validate]} {:db/id "answer-65c25a18-a5c0-51c1-96fe-a97b57c8f7e1" :answer/id #uuid "65c25a18-a5c0-51c1-96fe-a97b57c8f7e1" :answer/type :answer.type/math :answer/value "p=6.5,\\,q=9" :db/ensure [:answer/validate]} {:db/id "question-dd60924f-af00-5e97-9e77-c29eb2bc8035" :question/id #uuid "dd60924f-af00-5e97-9e77-c29eb2bc8035" :question/math-academy-id "q-18855" :question/problem "Let $(x,y)$ be the solution of the following system. What is the value of $x+y?$\n\n$$\n\\{\\begin{aligned}0.05x-0.03y=0.04 \\\\ 0.4x+0.2y=0.1\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the first equations by $100$ and the second equation by $10,$ as follows:\n\n$$\n\\{\\begin{aligned}0.05x-0.03y=0.04 & |\\times 100 \\\\ 0.4x+0.2y=0.1 & |\\times 10\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5x-3y=4 \\\\ 4x+2y=1\\end{aligned}\n$$\n\nNotice that if we multiply the first equation by $2$ and the second equation by $3,$ we will get a $-6y$ term in the first equation that can cancel with the $6y$ term in the second equation:\n\n$$\n\\{\\begin{aligned}5x-3y=4 & |\\,\\times (2) \\\\ 4x+2y=1 & |\\,\\times (3)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}10x-6y=8 \\\\ 12x+6y=3\\end{aligned}\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x:$\n\n$$\n\\begin{aligned}10x-\\cancel{6y} & =8 \\\\ 12x+\\cancel{6y} & =3 \\\\ (10x+12x) & =(8+3) \\\\ 22x & =11 \\\\ x & =\\frac{11}{22} \\\\ x & =0.5\\end{aligned}\n$$\n\nFinally, we can substitute $x=0.5$ into the equation $4x+2y=1$ to solve for $y:$\n\n$$\n\\begin{aligned}4x+2y & =1 \\\\ 4(0.5)+2y & =1 \\\\ 2+2y & =1 \\\\ 2y & =-1 \\\\ y & =-\\frac{1}{2} \\\\ y & =-0.5\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=0.5$ and $y=-0.5.$ So, \n\n$$\nx+y=0.5+(-0.5)=0.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9e101cd2-0992-5de6-9b2d-4f35a8656511"] :db/ensure [:question/validate]} {:db/id "answer-field-9e101cd2-0992-5de6-9b2d-4f35a8656511" :answer-field/id #uuid "9e101cd2-0992-5de6-9b2d-4f35a8656511" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84d0281f-81cf-5464-888b-3fb42539c91d" :answer-field/choices ["answer-84d0281f-81cf-5464-888b-3fb42539c91d" "answer-ffe0850c-bd3b-535d-bfb0-aada34fa3333" "answer-2728a05c-b733-5d7a-a3ee-efdd536081bc" "answer-d216a963-8190-5dc8-93bb-49be306033dd" "answer-f89943d7-a9b6-59a5-95a6-1c63bacee9df"] :db/ensure [:answer-field/validate]} {:db/id "answer-84d0281f-81cf-5464-888b-3fb42539c91d" :answer/id #uuid "84d0281f-81cf-5464-888b-3fb42539c91d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-ffe0850c-bd3b-535d-bfb0-aada34fa3333" :answer/id #uuid "ffe0850c-bd3b-535d-bfb0-aada34fa3333" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "answer-2728a05c-b733-5d7a-a3ee-efdd536081bc" :answer/id #uuid "2728a05c-b733-5d7a-a3ee-efdd536081bc" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-d216a963-8190-5dc8-93bb-49be306033dd" :answer/id #uuid "d216a963-8190-5dc8-93bb-49be306033dd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-f89943d7-a9b6-59a5-95a6-1c63bacee9df" :answer/id #uuid "f89943d7-a9b6-59a5-95a6-1c63bacee9df" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id 17592186097810 :tutorial/content "Sometimes, we might have a system of equations with decimal coefficients, such as the following:\n\n$$\n\\{\\begin{aligned}0.2x+y=1 \\\\ 0.15x-0.04y=0.2\\end{aligned}\n$$\n\nTo make the system easier to solve, we turn it into a system involving integer coefficients only.\n\nIn general, we multiply each equation by $10,$ or $100,$ or $1000,$ etc. depending on how many decimal places we need to eliminate. In this particular instance:\n\n- We need to eliminate one decimal place in the top equation, so we multiply by $10.$\n\n- We need to eliminate two decimal places in the bottom equation, so we multiply by $100.$\n\nSo, we multiply the first equation by $10$ and the second equation by $100,$ as follows:\n\n![](images/1d/1de5984af7b8bde9abed0d10214c8dab9e954d40576971b5f79505dc4e2f6e71.svg)\n\nFrom here, we can solve the system of equations using either substitution or elimination." :db/ensure [:tutorial/validate]} {:db/id 17592186096870 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id 17592186179728 :knowledge-point/questions ["question-1c089741-5544-5275-8ceb-bbd95cf5e4fe" "question-e6367608-0b6c-56a6-854c-a12592ac7a14"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1c089741-5544-5275-8ceb-bbd95cf5e4fe" :question/id #uuid "1c089741-5544-5275-8ceb-bbd95cf5e4fe" :question/math-academy-id "q-124659" :question/problem "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(1,3)$ to the point $N(3,-1),$ then ${\\int }_{C}{e}^{x-y}\\,dx+{e}^{x-y}\\,dy=$" :question/worked-solution "The position vectors of the endpoints of our line segment are $a=i+3\\,j$ and $b=3\\,i-j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+3\\,j+t(3\\,i-j-(i+3\\,j)) \\\\  & =i+3\\,j+t(2\\,i-4\\,j) \\\\  & =(2t+1)\\,i+(3-4t)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t+1$ and $y(t)=3-4t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i-4\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x-y}\\,dx+{e}^{x-y}\\,dy & ={\\int }_{0}^{1}{e}^{x-y}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+{e}^{x-y}\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}{e}^{x-y}(\\frac{\\text{d}x}{\\text{d}t}+\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t+1-(3-4t)}(2+(-4))\\,\\text{d}t \\\\  & =-2{\\int }_{0}^{1}{e}^{6t-2}\\,\\text{d}t \\\\  & =-\\frac{1}{3}{e}^{6t-2}\\,{|}_{0}^{1} \\\\  & =-\\frac{1}{3}[{e}^{6(1)-2}-{e}^{6(0)-2}] \\\\  & =-\\frac{1}{3}[{e}^{4}-\\frac{1}{{e}^{2}}] \\\\  & =\\frac{1-{e}^{6}}{3{e}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4daaebdb-5eac-5f4d-bcbe-069ee00fd432"] :db/ensure [:question/validate]} {:db/id "answer-field-4daaebdb-5eac-5f4d-bcbe-069ee00fd432" :answer-field/id #uuid "4daaebdb-5eac-5f4d-bcbe-069ee00fd432" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-50bbae27-58bd-5797-8bfa-c17fe6627c78" :answer-field/choices ["answer-50bbae27-58bd-5797-8bfa-c17fe6627c78" "answer-ea10fa2d-ab40-54c3-a266-d1a7f2cd6885" "answer-7c336942-42ac-5381-b315-51098c5b5b35" "answer-9944fc8f-2117-5170-b12f-702d4177c803" "answer-1ed12692-e337-5916-a234-aaa8ffd8cb1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-50bbae27-58bd-5797-8bfa-c17fe6627c78" :answer/id #uuid "50bbae27-58bd-5797-8bfa-c17fe6627c78" :answer/type :answer.type/math :answer/value "\\frac{1-{e}^{6}}{3{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-ea10fa2d-ab40-54c3-a266-d1a7f2cd6885" :answer/id #uuid "ea10fa2d-ab40-54c3-a266-d1a7f2cd6885" :answer/type :answer.type/math :answer/value "\\frac{2-{e}^{4}}{3{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-7c336942-42ac-5381-b315-51098c5b5b35" :answer/id #uuid "7c336942-42ac-5381-b315-51098c5b5b35" :answer/type :answer.type/math :answer/value "\\frac{3-2{e}^{6}}{2{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-9944fc8f-2117-5170-b12f-702d4177c803" :answer/id #uuid "9944fc8f-2117-5170-b12f-702d4177c803" :answer/type :answer.type/math :answer/value "\\frac{3e-{e}^{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-1ed12692-e337-5916-a234-aaa8ffd8cb1a" :answer/id #uuid "1ed12692-e337-5916-a234-aaa8ffd8cb1a" :answer/type :answer.type/math :answer/value "\\frac{e-{e}^{3}}{3}" :db/ensure [:answer/validate]} {:db/id "question-e6367608-0b6c-56a6-854c-a12592ac7a14" :question/id #uuid "e6367608-0b6c-56a6-854c-a12592ac7a14" :question/math-academy-id "q-124662" :question/problem "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(1,1)$ to the point $N(3,3),$ then ${\\int }_{C}\\frac{1}{y}\\,dx+\\frac{1}{{x}^{2}}\\,dy=$" :question/worked-solution "The position vectors of the endpoints of our line segment are $a=i+j$ and $b=3\\,i+3\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =i+j+t(3\\,i+3\\,j-(i+j)) \\\\  & =i+j+t(2\\,i+2\\,j) \\\\  & =(2t+1)\\,i+(2t+1)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t+1$ and $y(t)=2t+1$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i+2\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{1}{y}\\,dx+\\frac{1}{{x}^{2}}\\,dy & ={\\int }_{0}^{1}\\frac{1}{y}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+\\frac{1}{{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(\\frac{1}{y}\\,\\frac{\\text{d}x}{\\text{d}t}+\\frac{1}{{x}^{2}}\\,\\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}\\frac{1}{2t+1}\\cdot 2+\\frac{1}{(2t+1)^{2}}\\cdot 2\\,dt \\\\  & ={[\\operatorname{ln}⁡(2t+1)-\\frac{1}{2t+1}]}_{0}^{1} \\\\  & =[\\operatorname{ln}⁡(2\\cdot 1+1)-\\frac{1}{2\\cdot 1+1}]-[\\operatorname{ln}⁡(2\\cdot 0+1)-\\frac{1}{2\\cdot 0+1}] \\\\  & =\\operatorname{ln}⁡3-\\frac{1}{3}+1 \\\\  & =\\operatorname{ln}⁡3+\\frac{2}{3} \\\\  & =\\frac{3\\operatorname{ln}⁡3+2}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cee9f237-ef40-55b1-b748-bc0ff7960913"] :db/ensure [:question/validate]} {:db/id "answer-field-cee9f237-ef40-55b1-b748-bc0ff7960913" :answer-field/id #uuid "cee9f237-ef40-55b1-b748-bc0ff7960913" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-57595cac-95b5-5f6d-b989-b8d5bdf94881" :answer-field/choices ["answer-54aca898-1a55-5bcb-8d3f-340b7f07bc20" "answer-57595cac-95b5-5f6d-b989-b8d5bdf94881" "answer-01fd21d2-40f2-5b58-913c-e84aa062ff61" "answer-c512d8f7-5585-5111-bc8a-cb18cd5fde29" "answer-37db0990-fced-5795-aeb4-f498e0afce12"] :db/ensure [:answer-field/validate]} {:db/id "answer-54aca898-1a55-5bcb-8d3f-340b7f07bc20" :answer/id #uuid "54aca898-1a55-5bcb-8d3f-340b7f07bc20" :answer/type :answer.type/math :answer/value "\\frac{2\\operatorname{ln}⁡2+3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-57595cac-95b5-5f6d-b989-b8d5bdf94881" :answer/id #uuid "57595cac-95b5-5f6d-b989-b8d5bdf94881" :answer/type :answer.type/math :answer/value "\\frac{3\\operatorname{ln}⁡3+2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-01fd21d2-40f2-5b58-913c-e84aa062ff61" :answer/id #uuid "01fd21d2-40f2-5b58-913c-e84aa062ff61" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2+2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c512d8f7-5585-5111-bc8a-cb18cd5fde29" :answer/id #uuid "c512d8f7-5585-5111-bc8a-cb18cd5fde29" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2+3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-37db0990-fced-5795-aeb4-f498e0afce12" :answer/id #uuid "37db0990-fced-5795-aeb4-f498e0afce12" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡3+1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186105721 :knowledge-point/questions ["question-2e5afc97-cdbf-5609-994c-66b16cc595b4" "question-7984804e-ee09-5ab8-9ea3-cfb9bf84394d" "question-18df9f2e-656d-5486-9ae1-27119d2f448d" "question-0fbb26d4-3faf-5389-98e4-54735a0cfc0b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105577 :question/problem "Estimate the area under the curve $y=(2x-4)^2+2$ over the interval $[0,2]$ using a right Riemann sum with step size $\\Delta x=0.5.$" :question/worked-solution "Let's sketch our situation.\n\n![](images/94/94618262fb303035cd03ccf0274694d7083d9cd3a23d4231e3a8fccde8ac4fe1.png)\n\n \n\nThe area $\\mathcal{A}$ can be approximated using the formula\n\n$$\n\\mathcal A\\approx(\\overbrace{{\\color{red}{f(0.5)}}+{\\color{red}{f(1)}}+{\\color{red}{f(1.5)}}+{\\color{red}{f(2)}}}^{\\color{red}{\\large\\text{heights}}})\\cdot \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}{\\large\\text{width}}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.5$ | $1$ | $1.5$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $11$ | $6$ | $3$ | $2$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(11+6+3+2)\\cdot 0.5 \\\\  & =22\\cdot 0.5 \\\\  & =11\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105814 :knowledge-point/questions ["question-86b94149-e5f8-5f16-b1b9-921b18ee69eb" "question-295aa24d-cc18-5ddf-b640-8d50f96f1e1a" "question-fbb4c94f-2803-5b7e-b57a-776b92b59056" "question-8de05636-df00-52b0-a8f6-5c5d3db73b2e" "question-d36beb24-ba8a-5d0f-80e1-d03ab3463ddd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105648 :question/problem "The table below gives some values of a continuous function $f(x)$ on the closed interval $[-4,2].$ The right Riemann sum approximation to the area under the curve $y=f(x)$ with $3$ equal subintervals has a value of $12.$ What must be the value of $k?$\n\n| $x$ | $-4$ | $-2$ | $0$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $5$ | $3$ | $k$ | $2$ |" :question/worked-solution "The area $\\mathcal{A}$ under the graph can be approximated using the formula for the right Riemann sum:\n\n$$\n\\mathcal A\\approx(\\overbrace{{\\color{red}{f(-2)}}+{\\color{red}{f(0)}}+{\\color{red}{f(2)}}}^{\\color{red}{\\large\\text{heights}}})\\cdot \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}{\\large\\text{width}}}\n$$\n\nSo, we set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $-2$ | $0$ | $2$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $3$ | $k$ | $2$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(3+k+2)\\cdot 2 \\\\  & =(k+5)\\cdot 2 \\\\  & =2k+10\\end{aligned}\n$$\n\nSince we are given that $\\mathcal A$ must be $12,$ we obtain\n\n$$\n\\eqalign{\n2k+10 & =12\\[5pt]\n      2k &= 12-10\\[5pt]\n        k &= \\dfrac{2}{2}\\[5pt]\n         k  &= 1.\n}\n$$" :db/ensure [:question/validate]} {:db/id 17592186105815 :knowledge-point/questions ["question-b7189171-aff4-5525-9ffc-edd7b878fae4" "question-10bc8e6f-4c2c-5a63-aa64-53c9dbd12a9a" "question-9e633987-af32-5b5c-bd64-b66c42ee580f" "question-f185512a-6bdc-56ba-b826-59b4b54f5782"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105649 :question/problem "Estimate the area under the curve $y=(2x-4)^2+2$ over the interval $[0,2]$ using a right Riemann sum with step size $\\Delta x=0.5.$ Is this an overestimate or an underestimate?" :question/worked-solution "Let's sketch our situation.\n\n![](images/94/94618262fb303035cd03ccf0274694d7083d9cd3a23d4231e3a8fccde8ac4fe1.png)\n\n \n\nThe area $\\mathcal{A}$ can be approximated using the formula\n\n$$\n\\mathcal A\\approx(\\overbrace{{\\color{red}{f(0.5)}}+{\\color{red}{f(1)}}+{\\color{red}{f(1.5)}}+{\\color{red}{f(2)}}}^{\\color{red}{\\large\\text{heights}}})\\cdot \\underbrace{\\color{blue}\\Delta x}_{\\color{blue}{\\large\\text{width}}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.5$ | $1$ | $1.5$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $11$ | $6$ | $3$ | $2$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(11+6+3+2)\\cdot 0.5 \\\\  & =22\\cdot 0.5 \\\\  & =11\\end{aligned}\n$$\n\nBecause the function is *strictly decreasing* over the interval $[0,2],$ the rectangles reach *below* the function, which means our approximation is an *underestimate* of the correct area." :db/ensure [:question/validate]} {:db/id 17592186105722 :knowledge-point/questions ["question-6772ccf8-308a-5e57-b20e-bbe6b51388bc" "question-ae6e559e-361b-5b37-89a9-1d035fa07b1f" "question-16561015-1e48-5ef8-9194-b46c8f058fda" "question-7b623f34-55bd-5cf9-90b7-bc3a51b954e0"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186105578 :question/problem "The following table shows the values of a continuous function $f(x)$ over the interval $[1,4].$\n\n| $x$ | $1$ | $2$ | $3$ | $3.5$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $0$ | $4$ | $8.5$ | $10$ | $8$ |\n\nUse the right Riemann sum, with the four subintervals indicated by the data, to approximate the area under the curve $y=f(x)$ over the interval $[1,4].$" :question/worked-solution "In this case, we have $n=4$ rectangles. Using the right Riemann sum, the area is computed as \n\n$$\n\\mathcal{A}\t\\approx\tf(2)\\Delta x_1+f(3)\\Delta x_2+f(3.5)\\Delta x_3+f(4)\\Delta x_4,\n$$\n\nwhere each $\\Delta x_i$ is calculated by considering the step between a particular $x$-value and the previous one, i.e.,\n\n$$\n\\Delta x_i = x_{i}-x_{i-1}.\n$$\n\nWe set up a table of values that include the $\\Delta x$'s.\n\n| $x$ | $1$ | $2$ | $3$ | $3.5$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\Delta x$ | $-$ | $1$ | $1$ | $0.5$ | $0.5$ |\n| $f(x)$ | $-$ | $4$ | $8.5$ | $10$ | $8$ |\n\nFinally, we plug in the numbers to approximate the area under the curve, and get\n\n$$\n\\begin{aligned}A & ≈4\\cdot 1+8.5\\cdot 1+10\\cdot 0.5+8\\cdot 0.5 \\\\  & =4+8.5+5+4 \\\\  & =21.5.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-2e5afc97-cdbf-5609-994c-66b16cc595b4" :question/id #uuid "2e5afc97-cdbf-5609-994c-66b16cc595b4" :question/math-academy-id "q-346101" :question/problem "The following table shows the fuel consumption rate, $F(t),$ of a generator (in liters per hour) over a period of $8$ hours.\n\n| $t\\,\\text{(hours)}$ | $0$ | $2$ | $4$ | $6$ | $8$ |\n| --- | --- | --- | --- | --- | --- |\n| $F\\,\\text{(liters/hour)}$ | $4$ | $3$ | $5$ | $2$ | $6$ |\n\nUse the right Riemann sum for $F(t)$ over the interval $[0,8]$ with four subintervals to approximate the total amount of fuel used.\n\nThe total amount of fuel is \n{{field-1}} liters." :question/worked-solution "First, let's compute the step size $Δt,$ which is just the width of each rectangle. In this case, the endpoints of our interval are $a=0$ and $b=8,$ and there are $n=4$ rectangles, so the step size is\n\n$$\nΔt=\\frac{b-a}{n}=\\frac{8-0}{4}=2.\n$$\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{F(2)+F(4)+F(6)+F(8)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $F(t)$ at each point:\n\n| $t$ | $2$ | $4$ | $6$ | $8$ |\n| --- | --- | --- | --- | --- |\n| $F(t)$ | $3$ | $5$ | $2$ | $6$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(3+5+2+6)\\cdot 2 \\\\  & =16\\cdot 2 \\\\  & =32\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total amount of fuel used over a period of $8$ hours. So, the total amount of fuel is $32$ liters." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-53ef4dc0-4c26-5272-80ba-0abca0bed270"] :db/ensure [:question/validate]} {:db/id "answer-field-53ef4dc0-4c26-5272-80ba-0abca0bed270" :answer-field/id #uuid "53ef4dc0-4c26-5272-80ba-0abca0bed270" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7196d172-1722-59c9-8d40-bba7f5842eaf" :answer-field/choices ["answer-7196d172-1722-59c9-8d40-bba7f5842eaf"] :db/ensure [:answer-field/validate]} {:db/id "answer-7196d172-1722-59c9-8d40-bba7f5842eaf" :answer/id #uuid "7196d172-1722-59c9-8d40-bba7f5842eaf" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "question-7984804e-ee09-5ab8-9ea3-cfb9bf84394d" :question/id #uuid "7984804e-ee09-5ab8-9ea3-cfb9bf84394d" :question/math-academy-id "q-115745" :question/problem "The following table shows the rate $r(t)$, in flour bags per minute, at which a machine makes flour over a period of $75$ minutes.\n\n| $t\\,\\text{(minutes)}$ | $0$ | $15$ | $30$ | $45$ | $60$ | $75$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $r\\,\\text{(flour bags/minute)}$ | $30$ | $25$ | $35$ | $40$ | $35$ | $25$ |\n\nUse the right Riemann sum for $r(t)$ over the interval $[0,75]$, with five subintervals, to approximate the number of flour bags made by the machine in $75$ minutes." :question/worked-solution "First, let's compute the step size $Δt,$ which is just the width of each rectangle. In this case, the endpoints of our interval are $a=0$ and $b=75,$ and there are $n=5$ rectangles, so the step size is\n\n$$\nΔt=\\frac{b-a}{n}=\\frac{75-0}{5}=15.\n$$\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{r(15)+r(30)+r(45)+r(60)+r(75)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $r(t)$ at each point:\n\n| $t$ | $15$ | $30$ | $45$ | $60$ | $75$ |\n| --- | --- | --- | --- | --- | --- |\n| $r(t)$ | $25$ | $35$ | $40$ | $35$ | $25$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(25+35+40+35+25)\\cdot 15 \\\\  & =160\\cdot 15 \\\\  & =2\\,400\\end{aligned}\n$$\n\n \n\nFinally, in the given context, the area under the curve represents the total number of flour bags made by the machine in $75$ minutes.  So, the number of flour bags is approximately $2\\,400.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-60b2584c-7157-5847-8956-d79d5f653369"] :db/ensure [:question/validate]} {:db/id "answer-field-60b2584c-7157-5847-8956-d79d5f653369" :answer-field/id #uuid "60b2584c-7157-5847-8956-d79d5f653369" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-80f4d759-7dd2-58ba-b661-c508f8284e2a" :answer-field/choices ["answer-f66356a1-a60a-5a2c-9291-629272352032" "answer-40d7d78b-066c-592b-9585-d48edeb29892" "answer-d17f65ac-d738-5edc-866a-4144aae04c51" "answer-01050c59-9553-589f-9c48-f5d7d72b8958" "answer-80f4d759-7dd2-58ba-b661-c508f8284e2a"] :db/ensure [:answer-field/validate]} {:db/id "answer-f66356a1-a60a-5a2c-9291-629272352032" :answer/id #uuid "f66356a1-a60a-5a2c-9291-629272352032" :answer/type :answer.type/text :answer/value "$1\\,600$ flour bags" :db/ensure [:answer/validate]} {:db/id "answer-40d7d78b-066c-592b-9585-d48edeb29892" :answer/id #uuid "40d7d78b-066c-592b-9585-d48edeb29892" :answer/type :answer.type/text :answer/value "$1\\,920$ flour bags" :db/ensure [:answer/validate]} {:db/id "answer-d17f65ac-d738-5edc-866a-4144aae04c51" :answer/id #uuid "d17f65ac-d738-5edc-866a-4144aae04c51" :answer/type :answer.type/text :answer/value "$2\\,100$ flour bags" :db/ensure [:answer/validate]} {:db/id "answer-01050c59-9553-589f-9c48-f5d7d72b8958" :answer/id #uuid "01050c59-9553-589f-9c48-f5d7d72b8958" :answer/type :answer.type/text :answer/value "$2\\,220$ flour bags" :db/ensure [:answer/validate]} {:db/id "answer-80f4d759-7dd2-58ba-b661-c508f8284e2a" :answer/id #uuid "80f4d759-7dd2-58ba-b661-c508f8284e2a" :answer/type :answer.type/text :answer/value "$2\\,400$ flour bags" :db/ensure [:answer/validate]} {:db/id "question-18df9f2e-656d-5486-9ae1-27119d2f448d" :question/id #uuid "18df9f2e-656d-5486-9ae1-27119d2f448d" :question/math-academy-id "q-316517" :question/problem "The following table shows the water flow rate, $R(t),$ through a pipe (in liters per minute) over a period of $40$ minutes.\n\n| $t\\,\\text{(minutes)}$ | $0$ | $10$ | $20$ | $30$ | $40$ |\n| --- | --- | --- | --- | --- | --- |\n| $R\\,\\text{(liters/minute)}$ | $12$ | $15$ | $17$ | $16$ | $14$ |\n\nUse the right Riemann sum for $R(t)$ over the interval $[0,40]$ with four subintervals to approximate the total volume of water pumped.\n\nThe total volume is \n{{field-1}} liters." :question/worked-solution "First, let's compute the step size $Δt,$ which is just the width of each rectangle. In this case, the endpoints of our interval are $a=0$ and $b=40,$ and there are $n=4$ rectangles, so the step size is\n\n$$\nΔt=\\frac{b-a}{n}=\\frac{40-0}{4}=10.\n$$\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{R(10)+R(20)+R(30)+R(40)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $R(t)$ at each point:\n\n| $t$ | $10$ | $20$ | $30$ | $40$ |\n| --- | --- | --- | --- | --- |\n| $R(t)$ | $15$ | $17$ | $16$ | $14$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(15+17+16+14)\\cdot 10 \\\\  & =62\\cdot 10 \\\\  & =620\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total volume of water pumped over a period of $40$ minutes. So, the total volume is $620$ liters." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-14d74c82-2922-5d9b-8164-dac9534530d8"] :db/ensure [:question/validate]} {:db/id "answer-field-14d74c82-2922-5d9b-8164-dac9534530d8" :answer-field/id #uuid "14d74c82-2922-5d9b-8164-dac9534530d8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b60d1c76-997e-5fea-b00b-ccb5d53f5fa6" :answer-field/choices ["answer-b60d1c76-997e-5fea-b00b-ccb5d53f5fa6"] :db/ensure [:answer-field/validate]} {:db/id "answer-b60d1c76-997e-5fea-b00b-ccb5d53f5fa6" :answer/id #uuid "b60d1c76-997e-5fea-b00b-ccb5d53f5fa6" :answer/type :answer.type/math :answer/value "620" :db/ensure [:answer/validate]} {:db/id "question-0fbb26d4-3faf-5389-98e4-54735a0cfc0b" :question/id #uuid "0fbb26d4-3faf-5389-98e4-54735a0cfc0b" :question/math-academy-id "q-115697" :question/problem "Estimate the area under the curve $y=-{x}^{2}+2x$ over the interval $[0,2]$ using a right Riemann sum with step size $Δx=0.5.$" :question/worked-solution "Let's sketch our situation.\n\n![](images/0b/0b9dd2388a7b60866eb15d336d51d181853fe5ac0e52dcd3e02f53fdd4848532.png)\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(0.5)+f(1)+f(1.5)+f(2)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.5$ | $1$ | $1.5$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $0.75$ | $1$ | $0.75$ | $0$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(0.75+1+0.75+0)\\cdot 0.5 \\\\  & =2.5\\cdot 0.5 \\\\  & =1.25\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b2488740-ed19-518a-aec2-7d83e9f3a9a5"] :db/ensure [:question/validate]} {:db/id "answer-field-b2488740-ed19-518a-aec2-7d83e9f3a9a5" :answer-field/id #uuid "b2488740-ed19-518a-aec2-7d83e9f3a9a5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-878774eb-c7dd-5a87-917e-76cf95c77c8a" :answer-field/choices ["answer-d1153c2a-51a4-5211-961e-435b0d35c3ea" "answer-d228caf4-6c0e-5539-84ab-bf4720527798" "answer-878774eb-c7dd-5a87-917e-76cf95c77c8a" "answer-d6ba9520-4205-5f57-8874-c6ed0a363e74" "answer-afa5e8c5-9f06-528f-8ca9-ee3e619e89fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-d1153c2a-51a4-5211-961e-435b0d35c3ea" :answer/id #uuid "d1153c2a-51a4-5211-961e-435b0d35c3ea" :answer/type :answer.type/math :answer/value "0.75" :db/ensure [:answer/validate]} {:db/id "answer-d228caf4-6c0e-5539-84ab-bf4720527798" :answer/id #uuid "d228caf4-6c0e-5539-84ab-bf4720527798" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-878774eb-c7dd-5a87-917e-76cf95c77c8a" :answer/id #uuid "878774eb-c7dd-5a87-917e-76cf95c77c8a" :answer/type :answer.type/math :answer/value "1.25" :db/ensure [:answer/validate]} {:db/id "answer-d6ba9520-4205-5f57-8874-c6ed0a363e74" :answer/id #uuid "d6ba9520-4205-5f57-8874-c6ed0a363e74" :answer/type :answer.type/math :answer/value "1.5" :db/ensure [:answer/validate]} {:db/id "answer-afa5e8c5-9f06-528f-8ca9-ee3e619e89fb" :answer/id #uuid "afa5e8c5-9f06-528f-8ca9-ee3e619e89fb" :answer/type :answer.type/math :answer/value "1.75" :db/ensure [:answer/validate]} {:db/id 17592186106485 :question/problem "Estimate the area under the curve $y=4-2x$ over the interval $[0,1]$ using a right Riemann sum with step size $Δx=0.25.$" :question/worked-solution "Let's sketch our situation.\n\n![](images/c4/c478dd4988aaf23348c2453e1f9fca137ddd33284cde7cb7eae1775982bd4b2e.png)\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(0.25)+f(0.5)+f(0.75)+f(1)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.25$ | $0.5$ | $0.75$ | $1$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $3.5$ | $3$ | $2.5$ | $2$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(3.5+3+2.5+2)\\cdot 0.25 \\\\  & =11\\cdot 0.25 \\\\  & =2.75\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186105058 :answer-field/correct 17592186105059 :db/ensure [:answer-field/validate]} {:db/id "question-86b94149-e5f8-5f16-b1b9-921b18ee69eb" :question/id #uuid "86b94149-e5f8-5f16-b1b9-921b18ee69eb" :question/math-academy-id "q-86344" :question/problem "The following table gives the speed of a minivan measured during a $4$-second interval.\n\n| $t\\,(\\text{seconds})$ | $0$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- | --- |\n| $v(t)\\,(\\text{meters/second})$ | $17$ | $18$ | $k$ | $25$ | $27$ |\n\n If the right Riemann sum approximation of the total distance that the minivan traveled during the $4$-second interval has a value of $85$ meters, what is the value of $k?$\n\n*Hint: The distance traveled is given by the area under the speed-time graph.*" :question/worked-solution "The area $A$ under the curve $y=v(t)$ can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{v(1)+v(2)+v(3)+v(4)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $v(t)$ at each point:\n\n| $t$ | $1$ | $2$ | $3$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $v(t)$ | $18$ | $k$ | $25$ | $27$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(18+k+25+27)\\cdot 1 \\\\  & =70+k\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total distance that the minivan traveled. Since we are given that the right Riemann sum approximation of the total distance is $85$ meters,  we obtain\n\n$$\n\\begin{aligned}70+k & =85 \\\\ k & =15.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7f5bea90-ec71-5ac4-a16e-8e74f85dff8c"] :db/ensure [:question/validate]} {:db/id "answer-field-7f5bea90-ec71-5ac4-a16e-8e74f85dff8c" :answer-field/id #uuid "7f5bea90-ec71-5ac4-a16e-8e74f85dff8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0d8c4dd0-b4fb-5f1d-970c-93e234d6c211" :answer-field/choices ["answer-0d8c4dd0-b4fb-5f1d-970c-93e234d6c211" "answer-515a0644-5d83-50b2-b738-12e33dae1bc6" "answer-11aa1a77-5ad4-5bbc-8d24-035cfb0fffc1" "answer-a0746224-bc7e-5b08-b957-2482f2935120" "answer-d73cdc93-d689-5be0-b050-c70c2fe6ce12"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d8c4dd0-b4fb-5f1d-970c-93e234d6c211" :answer/id #uuid "0d8c4dd0-b4fb-5f1d-970c-93e234d6c211" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-515a0644-5d83-50b2-b738-12e33dae1bc6" :answer/id #uuid "515a0644-5d83-50b2-b738-12e33dae1bc6" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-11aa1a77-5ad4-5bbc-8d24-035cfb0fffc1" :answer/id #uuid "11aa1a77-5ad4-5bbc-8d24-035cfb0fffc1" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "answer-a0746224-bc7e-5b08-b957-2482f2935120" :answer/id #uuid "a0746224-bc7e-5b08-b957-2482f2935120" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "answer-d73cdc93-d689-5be0-b050-c70c2fe6ce12" :answer/id #uuid "d73cdc93-d689-5be0-b050-c70c2fe6ce12" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "question-295aa24d-cc18-5ddf-b640-8d50f96f1e1a" :question/id #uuid "295aa24d-cc18-5ddf-b640-8d50f96f1e1a" :question/math-academy-id "q-346446" :question/problem "The following table shows the cooling rate of a walk-in freezer over a period of $10$ hours, starting at $9\\,\\text{a.m}.$\n\n| $t\\,(\\text{hours})$ | $9$ | $11$ | $13$ | $15$ | $17$ | $19$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $R(t)\\,(\\text{kilojoules/hour})$ | $5$ | $4$ | $3$ | $2$ | $4$ | $k$ |\n\n If the right Riemann sum approximation of the total energy removed from $9\\,\\text{a.m}$ to $7\\,\\text{p.m.}$ has a value of $40$ kilojoules, then what is the value of $k?$ \n\n$k=$\n{{field-1}}" :question/worked-solution "The area $A$ under the curve (rate vs. time) can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{R(11)+R(13)+R(15)+R(17)+R(19)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of the rate at each point:\n\n| $t$ | $11$ | $13$ | $15$ | $17$ | $19$ |\n| --- | --- | --- | --- | --- | --- |\n| $R(t)$ | $4$ | $3$ | $2$ | $4$ | $k$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(4+3+2+4+k)\\cdot 2 \\\\  & =2(k+13) \\\\  & =2k+26\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total energy removed from $9\\,\\text{a.m}$ to $7\\,\\text{p.m}.$ Since we are given that the right Riemann sum approximation of the total energy removed is $40$ kilojoules, we obtain\n\n$$\n\\begin{aligned}2k+26 & =40 \\\\ 2k & =40-26 \\\\ k & =\\frac{14}{2} \\\\ k & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d3ccd5f4-a37a-56a2-9400-43d3c5f9830f"] :db/ensure [:question/validate]} {:db/id "answer-field-d3ccd5f4-a37a-56a2-9400-43d3c5f9830f" :answer-field/id #uuid "d3ccd5f4-a37a-56a2-9400-43d3c5f9830f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0dcef793-e9bd-548e-8171-f1c2694d465b" :answer-field/choices ["answer-0dcef793-e9bd-548e-8171-f1c2694d465b"] :db/ensure [:answer-field/validate]} {:db/id "answer-0dcef793-e9bd-548e-8171-f1c2694d465b" :answer/id #uuid "0dcef793-e9bd-548e-8171-f1c2694d465b" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-fbb4c94f-2803-5b7e-b57a-776b92b59056" :question/id #uuid "fbb4c94f-2803-5b7e-b57a-776b92b59056" :question/math-academy-id "q-86372" :question/problem "The table below gives some values of a continuous function $f(t)$ on the closed interval $[10,40].$ The right Riemann sum approximation to the area under the curve $y=f(t)$ with $3$ equal subintervals has a value of $480.$ What must be the value of $k?$\n\n| $t$ | $10$ | $20$ | $30$ | $40$ |\n| --- | --- | --- | --- | --- |\n| $f(t)$ | $18$ | $12$ | $k$ | $16$ |" :question/worked-solution "The area $A$ can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(20)+f(30)+f(40)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $f(t)$ at each point:\n\n| $t$ | $20$ | $30$ | $40$ |\n| --- | --- | --- | --- |\n| $f(t)$ | $12$ | $k$ | $16$ |\n\nSo, we obtain the following approximation to the area:\n\n$$\n\\begin{aligned}A & ≈(12+k+16)\\cdot 10 \\\\  & =(28+k)\\cdot 10\\end{aligned}\n$$\n\nSince we are given that $A$ must be $480$, we obtain\n\n$$\n\\begin{aligned}(28+k)\\cdot 10 & =480 \\\\ 28+k & =48 \\\\ k & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7023ddcf-d3c1-52ff-bd11-0bc5ea2c28b6"] :db/ensure [:question/validate]} {:db/id "answer-field-7023ddcf-d3c1-52ff-bd11-0bc5ea2c28b6" :answer-field/id #uuid "7023ddcf-d3c1-52ff-bd11-0bc5ea2c28b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-57bfefc1-dc04-51d9-be61-49334d95d8ad" :answer-field/choices ["answer-240701c7-693d-5227-90b8-2a6284ad88fb" "answer-8cec8f0e-46be-5259-81e8-bcdb5a4a53a8" "answer-d8fcc852-79de-51f7-9ec6-886cb9fb714d" "answer-57bfefc1-dc04-51d9-be61-49334d95d8ad" "answer-ea2ae6d8-8214-5546-b570-caa5929f2b72"] :db/ensure [:answer-field/validate]} {:db/id "answer-240701c7-693d-5227-90b8-2a6284ad88fb" :answer/id #uuid "240701c7-693d-5227-90b8-2a6284ad88fb" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-8cec8f0e-46be-5259-81e8-bcdb5a4a53a8" :answer/id #uuid "8cec8f0e-46be-5259-81e8-bcdb5a4a53a8" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-d8fcc852-79de-51f7-9ec6-886cb9fb714d" :answer/id #uuid "d8fcc852-79de-51f7-9ec6-886cb9fb714d" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-57bfefc1-dc04-51d9-be61-49334d95d8ad" :answer/id #uuid "57bfefc1-dc04-51d9-be61-49334d95d8ad" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "answer-ea2ae6d8-8214-5546-b570-caa5929f2b72" :answer/id #uuid "ea2ae6d8-8214-5546-b570-caa5929f2b72" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "question-8de05636-df00-52b0-a8f6-5c5d3db73b2e" :question/id #uuid "8de05636-df00-52b0-a8f6-5c5d3db73b2e" :question/math-academy-id "q-346443" :question/problem "The following table shows the water drainage rate of a reservoir over a period of $8$ hours, starting at $2\\,\\text{p.m}.$\n\n| $t\\,(\\text{hours})$ | $2$ | $4$ | $6$ | $8$ | $10$ |\n| --- | --- | --- | --- | --- | --- |\n| $R(t)\\,(\\text{gallons/hour})$ | $2$ | $k$ | $5$ | $4$ | $3$ |\n\nIf the right Riemann sum approximation of the total water drained from $2\\,\\text{p.m}$ to $10\\,\\text{p.m.}$ has a value of $30$ gallons, then what is the value of $k?$ \n\n$k=$\n{{field-1}}" :question/worked-solution "The area $A$ under the curve (rate vs. time) can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{R(4)+R(6)+R(8)+R(10)}})\\cdot {{Δt}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of the rate at each point:\n\n| $t$ | $4$ | $6$ | $8$ | $10$ |\n| --- | --- | --- | --- | --- |\n| $R(t)$ | $k$ | $5$ | $4$ | $3$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(k+5+4+3)\\cdot 2 \\\\  & =2(k+12) \\\\  & =2k+24\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total water drained from $2\\,\\text{p.m}$ to $10\\,\\text{p.m}.$ Since we are given that the right Riemann sum approximation of the total drainage is $30$ gallons, we obtain\n\n$$\n\\begin{aligned}2k+24 & =30 \\\\ 2k & =30-24 \\\\ k & =\\frac{6}{2} \\\\ k & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-438cb7c6-cefd-5543-b39d-e0a02ae170e4"] :db/ensure [:question/validate]} {:db/id "answer-field-438cb7c6-cefd-5543-b39d-e0a02ae170e4" :answer-field/id #uuid "438cb7c6-cefd-5543-b39d-e0a02ae170e4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3a4bda3f-13a2-588d-8d36-9540552bfd8c" :answer-field/choices ["answer-3a4bda3f-13a2-588d-8d36-9540552bfd8c"] :db/ensure [:answer-field/validate]} {:db/id "answer-3a4bda3f-13a2-588d-8d36-9540552bfd8c" :answer/id #uuid "3a4bda3f-13a2-588d-8d36-9540552bfd8c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-d36beb24-ba8a-5d0f-80e1-d03ab3463ddd" :question/id #uuid "d36beb24-ba8a-5d0f-80e1-d03ab3463ddd" :question/math-academy-id "q-49092" :question/problem "The table below gives the values of a continuous function $f(x)$ on the closed interval $[0,15]$ with a regular step size. If the right Riemann sum approximation to the area under the curve $y=f(x)$ with $3$ subintervals defined by the given points has a value of $60$, then what must be the value of $k?$\n\n| $x$ | $0$ | $5$ | $10$ | $15$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $2$ | $3$ | $4$ | $k$ |" :question/worked-solution "The area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(5)+f(10)+f(15)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $5$ | $10$ | $15$ |\n| --- | --- | --- | --- |\n| $f(x)$ | $3$ | $4$ | $k$ |\n\nNow, we obtain the following approximation for the area:\n\n$$\n\\begin{aligned}A & ≈(3+4+k)\\cdot 5 \\\\  & =(7+k)\\cdot 5 \\\\  & =5k+35\\end{aligned}\n$$\n\nFinally, since we are given that $A$ must be  $60,$ we obtain\n\n$$\n\\begin{aligned}5k+35 & =60 \\\\ 5k & =60-35 \\\\ k & =\\frac{25}{5} \\\\ k & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b3c699ed-502d-50f7-85eb-b0f04825f3f6"] :db/ensure [:question/validate]} {:db/id "answer-field-b3c699ed-502d-50f7-85eb-b0f04825f3f6" :answer-field/id #uuid "b3c699ed-502d-50f7-85eb-b0f04825f3f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-07357d7a-2f83-5eb7-92b8-b510a24224cf" :answer-field/choices ["answer-41113075-3263-5183-b6a6-417bd1862926" "answer-34734b2d-4a62-530e-a6bd-694b62c062aa" "answer-1894293b-2266-5249-81b6-4ceec74dc5e5" "answer-b72a414b-c009-5184-b3b0-8ca0bca96051" "answer-07357d7a-2f83-5eb7-92b8-b510a24224cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-41113075-3263-5183-b6a6-417bd1862926" :answer/id #uuid "41113075-3263-5183-b6a6-417bd1862926" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-34734b2d-4a62-530e-a6bd-694b62c062aa" :answer/id #uuid "34734b2d-4a62-530e-a6bd-694b62c062aa" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-1894293b-2266-5249-81b6-4ceec74dc5e5" :answer/id #uuid "1894293b-2266-5249-81b6-4ceec74dc5e5" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-b72a414b-c009-5184-b3b0-8ca0bca96051" :answer/id #uuid "b72a414b-c009-5184-b3b0-8ca0bca96051" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-07357d7a-2f83-5eb7-92b8-b510a24224cf" :answer/id #uuid "07357d7a-2f83-5eb7-92b8-b510a24224cf" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-b7189171-aff4-5525-9ffc-edd7b878fae4" :question/id #uuid "b7189171-aff4-5525-9ffc-edd7b878fae4" :question/math-academy-id "q-49115" :question/problem "A right Riemann sum is used to approximate the area under the curve $y=f(x)$ between $x=-2$ and $x=1$ for each of the functions below. For which function does the Riemann sum give an *underestimate* of the area?" :question/worked-solution "The right Riemann sum underestimates the area under the respective curve if the function is decreasing over the given interval. \n\nOf the given options, the only function that is decreasing over $x\\in [-2,1]$ is as follows.\n\n![](images/12/1287968881b822c475474e0a1e89ed589473d24f7cdf278c6d9fbd18b960344b.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a6eace52-de2d-55a8-a63f-a445d7ee7371"] :db/ensure [:question/validate]} {:db/id "answer-field-a6eace52-de2d-55a8-a63f-a445d7ee7371" :answer-field/id #uuid "a6eace52-de2d-55a8-a63f-a445d7ee7371" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e86fcf6c-4ab9-51fd-a963-8f76ec79c9eb" :answer-field/choices ["answer-e86fcf6c-4ab9-51fd-a963-8f76ec79c9eb" "answer-a7aa5f8f-adeb-576e-88ec-7221029a3ed4" "answer-f0e422a3-30ab-534f-8904-0b31f55ffbf4" "answer-483b31fe-308f-54cf-b9da-7c12fd2b107c" "answer-aca90562-2290-57cf-b1b1-d39efed6d256"] :db/ensure [:answer-field/validate]} {:db/id "answer-e86fcf6c-4ab9-51fd-a963-8f76ec79c9eb" :answer/id #uuid "e86fcf6c-4ab9-51fd-a963-8f76ec79c9eb" :answer/type :answer.type/image :answer/value "images/12/1287968881b822c475474e0a1e89ed589473d24f7cdf278c6d9fbd18b960344b.png" :db/ensure [:answer/validate]} {:db/id "answer-a7aa5f8f-adeb-576e-88ec-7221029a3ed4" :answer/id #uuid "a7aa5f8f-adeb-576e-88ec-7221029a3ed4" :answer/type :answer.type/image :answer/value "images/28/2878610f5f3ffba093918f49277648d9a72860cc7d2ca6f3f6d51b57149a04a0.png" :db/ensure [:answer/validate]} {:db/id "answer-f0e422a3-30ab-534f-8904-0b31f55ffbf4" :answer/id #uuid "f0e422a3-30ab-534f-8904-0b31f55ffbf4" :answer/type :answer.type/image :answer/value "images/98/98536b689340c85721e38b82c34abdbe060c851014493127fa2c67c600228dfc.png" :db/ensure [:answer/validate]} {:db/id "answer-483b31fe-308f-54cf-b9da-7c12fd2b107c" :answer/id #uuid "483b31fe-308f-54cf-b9da-7c12fd2b107c" :answer/type :answer.type/image :answer/value "images/af/af940537c48dd51fd8b30ea6123bf0a5feaba3b0e18cb1689e39cb4c6e6e3f08.png" :db/ensure [:answer/validate]} {:db/id "answer-aca90562-2290-57cf-b1b1-d39efed6d256" :answer/id #uuid "aca90562-2290-57cf-b1b1-d39efed6d256" :answer/type :answer.type/image :answer/value "images/b2/b28645afdc7194c6cc90c74cb2cd424379aba3ea1a63d42c1431c6924aa08c3d.png" :db/ensure [:answer/validate]} {:db/id 17592186106369 :question/problem "A right Riemann sum is used to approximate the area under the curve $y=f(x)$ between $x=-3$ and $x=-1$ for each of the functions below. For which function does the Riemann sum give an *overestimate* of the area?" :question/worked-solution "The right Riemann sum overestimates the area under the respective curve if the function is increasing over the given interval. \n\nOf the given options, the only function that is increasing over $x\\in [-3,-1]$ is as follows.\n\n![](images/4d/4d4e96c9dc96dcfc8ef6c2fe984a915ff047531ce33706dd781a9d159ca82950.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186104362 :answer-field/correct 17592186104364 :db/ensure [:answer-field/validate]} {:db/id "question-10bc8e6f-4c2c-5a63-aa64-53c9dbd12a9a" :question/id #uuid "10bc8e6f-4c2c-5a63-aa64-53c9dbd12a9a" :question/math-academy-id "q-20794" :question/problem "Estimate the area under the curve $y=4-{x}^{2}$ over the interval $[0,2]$ using a right Riemann sum with step size $Δx=0.5.$ Is this an overestimate or an underestimate?" :question/worked-solution "Let's sketch our situation.\n\n![](images/5c/5c52bbe248df0e5a595298d978276023bcb681daa904f37e2818013687aab52e.png)\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(0.5)+f(1)+f(1.5)+f(2)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $0.5$ | $1$ | $1.5$ | $2$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $3.75$ | $3$ | $1.75$ | $0$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(3.75+3+1.75+0)\\cdot 0.5 \\\\  & =8.50\\cdot 0.5 \\\\  & =4.25\\end{aligned}\n$$\n\nBecause the function is *strictly decreasing* over the interval $[0,2],$ the rectangles reach *below* the function, which means our approximation is an *underestimate* of the correct area." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ef28899d-b306-5e8e-a4d3-bef109a6e779"] :db/ensure [:question/validate]} {:db/id "answer-field-ef28899d-b306-5e8e-a4d3-bef109a6e779" :answer-field/id #uuid "ef28899d-b306-5e8e-a4d3-bef109a6e779" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ee374620-40ba-583d-8548-625378a12bdb" :answer-field/choices ["answer-e21421ad-d404-568a-b6ff-34207debc096" "answer-ee374620-40ba-583d-8548-625378a12bdb" "answer-17e7ee46-c0a0-5388-b5c3-f743c9eeeff3" "answer-8491a6b6-27ba-5890-9894-2dbd35131e9e" "answer-bae36594-f50c-5335-98b1-7ed2a0ea25e7"] :db/ensure [:answer-field/validate]} {:db/id "answer-e21421ad-d404-568a-b6ff-34207debc096" :answer/id #uuid "e21421ad-d404-568a-b6ff-34207debc096" :answer/type :answer.type/text :answer/value "$4.25,$ overestimate" :db/ensure [:answer/validate]} {:db/id "answer-ee374620-40ba-583d-8548-625378a12bdb" :answer/id #uuid "ee374620-40ba-583d-8548-625378a12bdb" :answer/type :answer.type/text :answer/value "$4.25,$ underestimate" :db/ensure [:answer/validate]} {:db/id "answer-17e7ee46-c0a0-5388-b5c3-f743c9eeeff3" :answer/id #uuid "17e7ee46-c0a0-5388-b5c3-f743c9eeeff3" :answer/type :answer.type/text :answer/value "$5.25,$ overestimate" :db/ensure [:answer/validate]} {:db/id "answer-8491a6b6-27ba-5890-9894-2dbd35131e9e" :answer/id #uuid "8491a6b6-27ba-5890-9894-2dbd35131e9e" :answer/type :answer.type/text :answer/value "$5.25,$ underestimate" :db/ensure [:answer/validate]} {:db/id "answer-bae36594-f50c-5335-98b1-7ed2a0ea25e7" :answer/id #uuid "bae36594-f50c-5335-98b1-7ed2a0ea25e7" :answer/type :answer.type/text :answer/value "$5.50,$ underestimate" :db/ensure [:answer/validate]} {:db/id "question-9e633987-af32-5b5c-bd64-b66c42ee580f" :question/id #uuid "9e633987-af32-5b5c-bd64-b66c42ee580f" :question/math-academy-id "q-74337" :question/problem "Estimate the area under the curve $y=2x+3$ over the interval $[-1,1]$ using a right Riemann sum with step size $Δx=0.5.$ Is this an overestimate or an underestimate?" :question/worked-solution "Let's sketch our situation.\n\n![](images/be/be5f6207531c18acecdb6a7ba3890e23913de4a78546db620f2986dd0467fa6d.png)\n\nThe area $A$ under the graph can be approximated using the formula\n\n$$\nA≈(\\overset{\\text{heights}}{\\overset{⏞}{f(-0.5)+f(0)+f(0.5)+f(1)}})\\cdot {{Δx}_{⏟}}_{\\text{width}}.\n$$\n\nSo, we now set up a table with the values of $f(x)$ at each point:\n\n| $x$ | $-0.5$ | $0$ | $0.5$ | $1$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $2$ | $3$ | $4$ | $5$ |\n\nFinally, we obtain the following approximation for our area:\n\n$$\n\\begin{aligned}A & ≈(2+3+4+5)\\cdot 0.5 \\\\  & =14\\cdot 0.5 \\\\  & =7\\end{aligned}\n$$\n\nBecause the function is *strictly increasing* over the interval $[-1,1],$ the rectangles reach *above* the function, which means our approximation is an *overestimate* of the correct area." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-58ee3ca7-e743-5c98-a18c-ba847bc17d29"] :db/ensure [:question/validate]} {:db/id "answer-field-58ee3ca7-e743-5c98-a18c-ba847bc17d29" :answer-field/id #uuid "58ee3ca7-e743-5c98-a18c-ba847bc17d29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-002a6a31-b58c-5580-9148-3001495a4d7a" :answer-field/choices ["answer-6ebf40b5-4be5-5ebe-9a26-6c0c7cbdff35" "answer-e5aa91ea-a144-5bc9-bee2-f4c14cf6d192" "answer-002a6a31-b58c-5580-9148-3001495a4d7a" "answer-7d68cf48-ca72-5f17-9243-c2b8260ae54c" "answer-42e96206-5932-5b4b-b71e-f61b37f74d76"] :db/ensure [:answer-field/validate]} {:db/id "answer-6ebf40b5-4be5-5ebe-9a26-6c0c7cbdff35" :answer/id #uuid "6ebf40b5-4be5-5ebe-9a26-6c0c7cbdff35" :answer/type :answer.type/text :answer/value "$6.5,$ overestimate" :db/ensure [:answer/validate]} {:db/id "answer-e5aa91ea-a144-5bc9-bee2-f4c14cf6d192" :answer/id #uuid "e5aa91ea-a144-5bc9-bee2-f4c14cf6d192" :answer/type :answer.type/text :answer/value "$6.5,$ underestimate" :db/ensure [:answer/validate]} {:db/id "answer-002a6a31-b58c-5580-9148-3001495a4d7a" :answer/id #uuid "002a6a31-b58c-5580-9148-3001495a4d7a" :answer/type :answer.type/text :answer/value "$7,$ overestimate" :db/ensure [:answer/validate]} {:db/id "answer-7d68cf48-ca72-5f17-9243-c2b8260ae54c" :answer/id #uuid "7d68cf48-ca72-5f17-9243-c2b8260ae54c" :answer/type :answer.type/text :answer/value "$7,$ underestimate" :db/ensure [:answer/validate]} {:db/id "answer-42e96206-5932-5b4b-b71e-f61b37f74d76" :answer/id #uuid "42e96206-5932-5b4b-b71e-f61b37f74d76" :answer/type :answer.type/text :answer/value "$8,$ overestimate" :db/ensure [:answer/validate]} {:db/id "question-f185512a-6bdc-56ba-b826-59b4b54f5782" :question/id #uuid "f185512a-6bdc-56ba-b826-59b4b54f5782" :question/math-academy-id "q-115700" :question/problem "A right Riemann sum is used to approximate the area under the curve $y=f(x)$ between $x=-2$ and $x=0$ for each of the functions below. For which function does the Riemann sum give an *underestimate* of the area?" :question/worked-solution "The right Riemann sum underestimates the area under the respective curve if the function is decreasing over the given interval. \n\nOf the given options, the only function that is decreasing over $x\\in [-2,0]$ is as follows.\n\n![](images/54/54da2c81b258a8b4768ff8550e261c1f8997c64df40e83160e674d9d223c601e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b61e2068-20db-58c0-8c08-999445737816"] :db/ensure [:question/validate]} {:db/id "answer-field-b61e2068-20db-58c0-8c08-999445737816" :answer-field/id #uuid "b61e2068-20db-58c0-8c08-999445737816" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2282f659-8ccb-5cd3-9e78-6fa526890b16" :answer-field/choices ["answer-2282f659-8ccb-5cd3-9e78-6fa526890b16" "answer-16319f99-8be9-5064-9c7f-efbb6a452fa4" "answer-29f7df40-eeb1-51c2-8680-69cf3b624d27" "answer-d08f46eb-c4d7-5a3d-86b5-5fbdff207392" "answer-9e4c7bdc-943f-55e4-89c6-49531cc23512"] :db/ensure [:answer-field/validate]} {:db/id "answer-2282f659-8ccb-5cd3-9e78-6fa526890b16" :answer/id #uuid "2282f659-8ccb-5cd3-9e78-6fa526890b16" :answer/type :answer.type/image :answer/value "images/54/54da2c81b258a8b4768ff8550e261c1f8997c64df40e83160e674d9d223c601e.png" :db/ensure [:answer/validate]} {:db/id "answer-16319f99-8be9-5064-9c7f-efbb6a452fa4" :answer/id #uuid "16319f99-8be9-5064-9c7f-efbb6a452fa4" :answer/type :answer.type/image :answer/value "images/55/5515a9fc4b43abb4cead1ebb3d6510e1476659b60ea62bc5088ffb6033f03efd.png" :db/ensure [:answer/validate]} {:db/id "answer-29f7df40-eeb1-51c2-8680-69cf3b624d27" :answer/id #uuid "29f7df40-eeb1-51c2-8680-69cf3b624d27" :answer/type :answer.type/image :answer/value "images/c8/c8cca0bc83b39fe234e7c03bd55514fd6509e29810ad3641fd7d883d0758543c.png" :db/ensure [:answer/validate]} {:db/id "answer-d08f46eb-c4d7-5a3d-86b5-5fbdff207392" :answer/id #uuid "d08f46eb-c4d7-5a3d-86b5-5fbdff207392" :answer/type :answer.type/image :answer/value "images/e7/e7c9f3684c8afaf638e130dee31be8375ffafb271cc2b0e8a0e74c87578ac3aa.png" :db/ensure [:answer/validate]} {:db/id "answer-9e4c7bdc-943f-55e4-89c6-49531cc23512" :answer/id #uuid "9e4c7bdc-943f-55e4-89c6-49531cc23512" :answer/type :answer.type/image :answer/value "images/f3/f302cc1e806f082574c0f4929d2963d90f349c267d7421ad3853842f789fa8a3.png" :db/ensure [:answer/validate]} {:db/id "question-6772ccf8-308a-5e57-b20e-bbe6b51388bc" :question/id #uuid "6772ccf8-308a-5e57-b20e-bbe6b51388bc" :question/math-academy-id "q-20315" :question/problem "A drone has positive velocity $v(t)$ after being flown upward from an initial height of $0$ feet at time  $t=0$ seconds. The velocity of the drone is recorded for selected values of $t$ over the interval $0\\le t\\le 40$ seconds, as shown in the table below. \n\n| $t\\,\\text{(seconds)}$ | $0$ | $7$ | $15$ | $25$ | $32$ | $40$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $v\\,\\text{(feet/second)}$ | $3$ | $10$ | $25$ | $40$ | $46$ | $49$ |\n\nUse the right Riemann sum over $[0,40]$ with five subintervals to approximate the total distance covered by the drone.\n\n*Hint: The distance traveled is given by the area under the velocity-time graph.*" :question/worked-solution "Let $A$ denote the area under the curve $y=v(t)$ over $[0,40].$ \nIn this case, we have $n=3$ rectangles. Using the right Riemann sum, the total distance can be approximated as \n\n$$\nA≈v(7)Δ{t}_{1}+v(15)Δ{t}_{2}+v(25)Δ{t}_{3}+v(32)Δ{t}_{4}+v(40)Δ{t}_{5},\n$$\n\nwhere each $Δ{t}_{i}$ is calculated by considering the step between a particular $t$-value and the previous one, i.e.,\n\n$$\nΔ{t}_{i}={t}_{i}-{t}_{i-1}.\n$$\n\nWe set up a value table that includes the $Δt$'s.\n\n| $t$ | $0$ | $7$ | $15$ | $25$ | $32$ | $40$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $Δt$ | $-$ | $7$ | $8$ | $10$ | $7$ | $8$ |\n| $v(t)$ | $-$ | $10$ | $25$ | $40$ | $46$ | $49$ |\n\nWe plug in the numbers to approximate the number of liters and get\n\n$$\n\\begin{aligned}A & ≈10\\cdot 7+25\\cdot 8+40\\cdot 10+46\\cdot 7+49\\cdot 8 \\\\  & =70+200+400+322+392 \\\\  & =1\\,384.\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total distance covered by the drone. So, the distance is approximately $1\\,384$ feet." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4897e11e-46e1-5d7f-9ea0-0508e0dce0ae"] :db/ensure [:question/validate]} {:db/id "answer-field-4897e11e-46e1-5d7f-9ea0-0508e0dce0ae" :answer-field/id #uuid "4897e11e-46e1-5d7f-9ea0-0508e0dce0ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f2e1c334-289e-56bd-8da7-42c0271dacf0" :answer-field/choices ["answer-fd87f624-d66a-5360-92e5-fbca297f8972" "answer-52322dcb-1905-5fca-972d-928776fd905b" "answer-5feeab5a-e0af-5745-817b-3debbe2734b1" "answer-f2e1c334-289e-56bd-8da7-42c0271dacf0" "answer-64f4abe0-1e42-5107-8805-9c199b4747bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd87f624-d66a-5360-92e5-fbca297f8972" :answer/id #uuid "fd87f624-d66a-5360-92e5-fbca297f8972" :answer/type :answer.type/text :answer/value "$1\\,184$ feet" :db/ensure [:answer/validate]} {:db/id "answer-52322dcb-1905-5fca-972d-928776fd905b" :answer/id #uuid "52322dcb-1905-5fca-972d-928776fd905b" :answer/type :answer.type/text :answer/value "$1\\,254$ feet" :db/ensure [:answer/validate]} {:db/id "answer-5feeab5a-e0af-5745-817b-3debbe2734b1" :answer/id #uuid "5feeab5a-e0af-5745-817b-3debbe2734b1" :answer/type :answer.type/text :answer/value "$1\\,314$ feet" :db/ensure [:answer/validate]} {:db/id "answer-f2e1c334-289e-56bd-8da7-42c0271dacf0" :answer/id #uuid "f2e1c334-289e-56bd-8da7-42c0271dacf0" :answer/type :answer.type/text :answer/value "$1\\,384$ feet" :db/ensure [:answer/validate]} {:db/id "answer-64f4abe0-1e42-5107-8805-9c199b4747bc" :answer/id #uuid "64f4abe0-1e42-5107-8805-9c199b4747bc" :answer/type :answer.type/text :answer/value "$1\\,442$ feet" :db/ensure [:answer/validate]} {:db/id "question-ae6e559e-361b-5b37-89a9-1d035fa07b1f" :question/id #uuid "ae6e559e-361b-5b37-89a9-1d035fa07b1f" :question/math-academy-id "q-74350" :question/problem "The following table shows the values of a continuous function $f(x)$ over the interval $[2,6].$\n\n| $x$ | $2$ | $3.5$ | $4$ | $6$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $2$ | $3.5$ | $8$ |\n\nUse the right Riemann sum, with the three subintervals indicated by the data, to approximate the area under the curve $y=f(x)$ over the interval $[2,6].$" :question/worked-solution "In this case, we have $n=3$ rectangles. Using the right Riemann sum, the area is approximated as \n\n$$\nA≈f(3.5)Δ{x}_{1}+f(4)Δ{x}_{2}+f(6)Δ{x}_{3},\n$$\n\nwhere each $Δ{x}_{i}$ is calculated by considering the step between a particular $x$-value and the previous one, i.e.,\n\n$$\nΔ{x}_{i}={x}_{i}-{x}_{i-1}.\n$$\n\nWe set up a value table that includes the $Δx$'s.\n\n| $x$ | $2$ | $3.5$ | $4$ | $6$ |\n| --- | --- | --- | --- | --- |\n| $Δx$ | $-$ | $1.5$ | $0.5$ | $2$ |\n| $f(x)$ | $-$ | $2$ | $3.5$ | $8$ |\n\nFinally, we plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & ≈2\\cdot 1.5+3.5\\cdot 0.5+8\\cdot 2 \\\\  & =3+1.75+16 \\\\  & =20.75.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c465fa60-6711-58fc-9089-6170878ac599"] :db/ensure [:question/validate]} {:db/id "answer-field-c465fa60-6711-58fc-9089-6170878ac599" :answer-field/id #uuid "c465fa60-6711-58fc-9089-6170878ac599" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d833ab3-a2d7-56c6-b9a4-76279b982fd9" :answer-field/choices ["answer-fc4f37bd-b672-575b-9376-0431108bd573" "answer-2d833ab3-a2d7-56c6-b9a4-76279b982fd9" "answer-e089c53a-d6d4-5d12-a806-355ad6596021" "answer-3955f388-dc66-59c7-b098-71ac23637885" "answer-b73287af-ab26-51ab-b425-1e0dc0ef802c"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc4f37bd-b672-575b-9376-0431108bd573" :answer/id #uuid "fc4f37bd-b672-575b-9376-0431108bd573" :answer/type :answer.type/math :answer/value "19.25" :db/ensure [:answer/validate]} {:db/id "answer-2d833ab3-a2d7-56c6-b9a4-76279b982fd9" :answer/id #uuid "2d833ab3-a2d7-56c6-b9a4-76279b982fd9" :answer/type :answer.type/math :answer/value "20.75" :db/ensure [:answer/validate]} {:db/id "answer-e089c53a-d6d4-5d12-a806-355ad6596021" :answer/id #uuid "e089c53a-d6d4-5d12-a806-355ad6596021" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-3955f388-dc66-59c7-b098-71ac23637885" :answer/id #uuid "3955f388-dc66-59c7-b098-71ac23637885" :answer/type :answer.type/math :answer/value "21.5" :db/ensure [:answer/validate]} {:db/id "answer-b73287af-ab26-51ab-b425-1e0dc0ef802c" :answer/id #uuid "b73287af-ab26-51ab-b425-1e0dc0ef802c" :answer/type :answer.type/math :answer/value "22.75" :db/ensure [:answer/validate]} {:db/id "question-16561015-1e48-5ef8-9194-b46c8f058fda" :question/id #uuid "16561015-1e48-5ef8-9194-b46c8f058fda" :question/math-academy-id "q-74351" :question/problem "The following table shows the values of a continuous function $f(x)$ over the interval $[1,7].$\n\n| $x$ | $1$ | $2.5$ | $5$ | $7$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $5$ | $8.5$ | $9$ |\n\nUse the right Riemann sum, with the three subintervals indicated by the data, to approximate the area under the curve $y=f(x)$ over the interval $[1,7].$" :question/worked-solution "In this case, we have $n=3$ rectangles. Using the right Riemann sum, the area is approximated as \n\n$$\nA≈f(2.5)Δ{x}_{1}+f(5)Δ{x}_{2}+f(7)Δ{x}_{3},\n$$\n\nwhere each $Δ{x}_{i}$ is calculated by considering the step between a particular $x$-value and the previous one, i.e.,\n\n$$\nΔ{x}_{i}={x}_{i}-{x}_{i-1}.\n$$\n\nWe set up a value table that includes the $Δx$'s.\n\n| $x$ | $1$ | $2.5$ | $5$ | $7$ |\n| --- | --- | --- | --- | --- |\n| $Δx$ | $-$ | $1.5$ | $2.5$ | $2$ |\n| $f(x)$ | $-$ | $5$ | $8.5$ | $9$ |\n\nFinally, we plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & ≈5\\cdot 1.5+8.5\\cdot 2.5+9\\cdot 2 \\\\  & =7.5+21.25+18 \\\\  & =46.75.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8c8ae8ea-1630-59da-a400-3740079028cf"] :db/ensure [:question/validate]} {:db/id "answer-field-8c8ae8ea-1630-59da-a400-3740079028cf" :answer-field/id #uuid "8c8ae8ea-1630-59da-a400-3740079028cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f49d01a-1356-56f8-a283-b3d4f4a0d947" :answer-field/choices ["answer-5f512ef4-db13-54a0-9ad5-4aa3f26a6f1d" "answer-7e286349-c3c1-55a1-8853-0b796282bc67" "answer-3f49d01a-1356-56f8-a283-b3d4f4a0d947" "answer-79d0dca6-5d5f-58d5-a25e-55114ac39c15" "answer-93b84c32-fa45-5736-abc6-07c50d96d933"] :db/ensure [:answer-field/validate]} {:db/id "answer-5f512ef4-db13-54a0-9ad5-4aa3f26a6f1d" :answer/id #uuid "5f512ef4-db13-54a0-9ad5-4aa3f26a6f1d" :answer/type :answer.type/math :answer/value "39.75" :db/ensure [:answer/validate]} {:db/id "answer-7e286349-c3c1-55a1-8853-0b796282bc67" :answer/id #uuid "7e286349-c3c1-55a1-8853-0b796282bc67" :answer/type :answer.type/math :answer/value "45.5" :db/ensure [:answer/validate]} {:db/id "answer-3f49d01a-1356-56f8-a283-b3d4f4a0d947" :answer/id #uuid "3f49d01a-1356-56f8-a283-b3d4f4a0d947" :answer/type :answer.type/math :answer/value "46.75" :db/ensure [:answer/validate]} {:db/id "answer-79d0dca6-5d5f-58d5-a25e-55114ac39c15" :answer/id #uuid "79d0dca6-5d5f-58d5-a25e-55114ac39c15" :answer/type :answer.type/math :answer/value "49.25" :db/ensure [:answer/validate]} {:db/id "answer-93b84c32-fa45-5736-abc6-07c50d96d933" :answer/id #uuid "93b84c32-fa45-5736-abc6-07c50d96d933" :answer/type :answer.type/math :answer/value "50.5" :db/ensure [:answer/validate]} {:db/id "question-7b623f34-55bd-5cf9-90b7-bc3a51b954e0" :question/id #uuid "7b623f34-55bd-5cf9-90b7-bc3a51b954e0" :question/math-academy-id "q-346462" :question/problem "The table below gives the medication infusion rate $r(t)$, in milligrams per minute, for a patient.\n\n| $t\\,\\text{(minutes)}$ | $0$ | $4$ | $7$ | $10$ | $13$ | $18$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $r(t)\\,\\text{(mg/min)}$ | $6$ | $5$ | $3$ | $4$ | $2$ | $1$ |\n\nUse the right Riemann sum over $[0,18]$ with five subintervals to approximate the total medication delivered (in milligrams).\n\nThe total medication delivered is\n{{field-1}} milligrams." :question/worked-solution "Let $A$ denote the area under the curve $y=r(t)$ over $[0,18].$ In this case, we have $n=5$ rectangles. Using the right Riemann sum, the area is computed as \n\n$$\nA≈r(4)Δ{t}_{1}+r(7)Δ{t}_{2}+r(10)Δ{t}_{3}+r(13)Δ{t}_{4}+r(18)Δ{t}_{5},\n$$\n\nwhere each $Δ{t}_{i}$ is calculated by considering the step between a particular $t$-value and the previous one, i.e.,\n\n$$\nΔ{t}_{i}={t}_{i}-{t}_{i-1}.\n$$\n\nWe set up a value table that includes the $Δt$'s.\n\n| $t$ | $0$ | $4$ | $7$ | $10$ | $13$ | $18$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $Δt$ | $-$ | $4$ | $3$ | $3$ | $3$ | $5$ |\n| $r(t)$ | $-$ | $5$ | $3$ | $4$ | $2$ | $1$ |\n\nWe plug in the numbers to approximate the area under the curve and get\n\n$$\n\\begin{aligned}A & ≈5\\cdot 4+3\\cdot 3+4\\cdot 3+2\\cdot 3+1\\cdot 5 \\\\  & =20+9+12+6+5 \\\\  & =52.\\end{aligned}\n$$\n\nFinally, in the given context, the area under the curve represents the total accumulation of medication. So, the total medication delivered is $52$ milligrams." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-af709f83-13b1-5d97-bf30-3739018c740d"] :db/ensure [:question/validate]} {:db/id "answer-field-af709f83-13b1-5d97-bf30-3739018c740d" :answer-field/id #uuid "af709f83-13b1-5d97-bf30-3739018c740d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ce97e8ae-fc3e-5356-86d9-e5bc39af2fa3" :answer-field/choices ["answer-ce97e8ae-fc3e-5356-86d9-e5bc39af2fa3"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce97e8ae-fc3e-5356-86d9-e5bc39af2fa3" :answer/id #uuid "ce97e8ae-fc3e-5356-86d9-e5bc39af2fa3" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id 17592186107150 :tutorial/content "Suppose that we wish to find the area $\\mathcal{A}$ under the curve $y=x^2$ between the $x$-values $x=1$ and $x=4,$ as shown below.\n\n![](images/35/3538fb94de9aac062e7ed65b9496085d478be911e5da2bf8480b260cec70ae4f.png)\n\n \n\nWe can approximate the area using, for instance, the area of three rectangles, each with a width equal to $1.$\n\n![](images/cb/cbb7b5af27aa5ebd3b5bbb51026017454999682dcf7e172411df79278564a5ae.png)\n\nSo, we find the area of each rectangle and then add them all together.\n\n$$\n\\begin{aligned}A & ≈\\overset{\\text{[math]1[/math]st rectangle}}{\\overset{⏞}{[\\,\\overset{\\text{height}}{\\overset{⏞}{f(2)}}\\,\\cdot \\,{{1}_{⏟}}_{\\text{base}}\\,]}}+\\overset{\\text{[math]2[/math]nd rectangle}}{\\overset{⏞}{[\\,\\overset{\\text{height}}{\\overset{⏞}{f(3)}}\\,\\cdot \\,{{1}_{⏟}}_{\\text{base}}\\,]}}+\\overset{\\text{[math]3[/math]rd rectangle}}{\\overset{⏞}{[\\,\\overset{\\text{height}}{\\overset{⏞}{f(4)}}\\,\\cdot \\,{{1}_{⏟}}_{\\text{base}}\\,]}} \\\\  & =[{2}^{2}\\cdot 1]+[{3}^{2}\\cdot 1]+[{4}^{2}\\cdot 1] \\\\  & =4+9+16 \\\\  & =29\\end{aligned}\n$$\n\n \n\nHere, we approximated the area using a **right Riemann sum**, which means that the top-*right* corner of each rectangle touches the curve.\n\nBecause the function is *strictly increasing* over the interval $[1,4],$ the rectangles reach *above* the function, which means our approximation is an *overestimate* of the actual area (see the picture above)." :db/ensure [:tutorial/validate]} {:db/id 17592186107151 :tutorial/content "In general, the area $\\mathcal{A}$ under the curve $y=f(x)$ over the interval $[a,b]$ can be approximated using a right Riemann sum by calculating the area of each rectangle and adding them together. \n\n![](images/6a/6aa3fd6dca84719aa7d34fdf75586a33005dd34c416d4456662f9d1876679f61.png)\n\nIn the image, we assume that $x_0=a$ and $x_n=b.$  \n\nThe resulting area can be calculated as\n\n$$\n\\mathcal{A}\t\\approx f(x_1)\\Delta x+f(x_2)\\Delta x+f(x_3)\\Delta x+ \\cdots + f(x_n) \\Delta x,\n$$\n\nwhere $n$ is the number of rectangles and the step size $\\Delta x$ is given by\n\n$$\n\\Delta x=\\dfrac{b-a}{n}.\n$$\n\nWe can simplify by factoring out the $\\Delta x,$ which gives the following general formula:\n\n![](images/85/8570545c3437ee862deba766b58f5746629452459505488a4c59ca17869aa95c.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186107100 :tutorial/content "Whether the right Riemann sum underestimates or overestimates the actual area under a function depends on whether the function is increasing or decreasing.\n\n- If the function $f(x)$ is increasing, then the rectangles reach *above* the function, which means the right Riemann sum gives an *overestimate* of the actual area under the curve $y=f(x).$\n\n![](images/71/71bc3147a2d7ee5867740e67f55d2a257065f0f225b62b4af3b5f5990c0d4ffc.png)\n\n- If the function $f(x)$ is decreasing, then  the rectangles fall *below* the function, which means the right Riemann sum gives an *underestimate* of the actual area under the curve $y=f(x).$\n\n![](images/0b/0bc5bc2d5daa2b42e640d31b998707af503b4c4489531ef7ddd41f4374405ef7.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186107152 :tutorial/content "In the last few examples, the step size $\\Delta{x}$ was the same for each of the rectangles. In these cases, we say that the step size is **regular**.\n\nThere are situations where the step size can vary, which we call an **irregular step size**. But we can still use a right Riemann sum to approximate the area.\n\nFor example, let's use a right Riemann sum to approximate the area under the curve of the continuous function $y=f(x)$ whose data is given in the table below.\n\n| $x$ | $1$ | $1.5$ | $2.5$ | $4$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $2$ | $6$ | $8$ |\n\nThe first thing we note is that the domain of the function $y=f(x)$ is *partitioned* as \n\n$$\n\\eqalign{\n [1,4] &= [1, 1.5] \\cup [1.5, 2.5] \\cup [2.5, 4].\n}\n$$\n\n \n\nLet's plot what this function might look like, using the values given in the table.\n\n![](images/60/60c0bfba52fe087b4d8aaeceee367798e24079dc385afff3e83bca60405d4d2b.png)\n\n  \n\nWe've drawn some rectangles to help us calculate our right Riemann sum, and we have chosen the heights of each rectangle to be calculated using the right endpoint of each interval.\n\nBy calculating the area of each rectangle, we obtain the following approximation for our area:\n\n![](images/14/142608196dc9a4498e79c7b5b15850401489b08e0ba658316d14ccf05b47728a.svg)\n\nPlugging our numbers into the above, we find\n\n$$\n\\eqalign{\n\\mathcal{A}\t&\\approx\t{\\color{red}2} \\cdot ({\\color{blue}1.5-1})\n\t\t\t\t\t\t+ {\\color{red}6} \\cdot ({\\color{blue}2.5-1.5})\n\t\t\t\t\t\t+ {\\color{red}8} \\cdot ({\\color{blue}4-2.5}) \\ \n\t\t\t&= {\\color{red}2} \\cdot {\\color{blue}0.5} +{\\color{red}6} \\cdot {\\color{blue}1}+ {\\color{red}8} \\cdot {\\color{blue}1.5}  \\\n\t\t\t&=1+6+12\\\n\t\t\t&= 19.\n}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186105959 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186106598 :step/math-academy-id 646701 :db/ensure [:step/validate]} {:db/id 17592186106600 :step/math-academy-id 646702 :db/ensure [:step/validate]} {:db/id 17592186106599 :step/math-academy-id 646703 :db/ensure [:step/validate]} {:db/id 17592186106753 :step/math-academy-id 646706 :db/ensure [:step/validate]} {:db/id 17592186106754 :step/math-academy-id 646709 :db/ensure [:step/validate]} {:db/id 17592186106755 :step/math-academy-id 646710 :db/ensure [:step/validate]} {:db/id 17592186106601 :step/math-academy-id 646713 :db/ensure [:step/validate]} {:db/id 17592186106602 :step/math-academy-id 646714 :db/ensure [:step/validate]}]
