3fbce6e-87bb-5e0c-a0c3-6b6e1a2ba629" :answer/id #uuid "83fbce6e-87bb-5e0c-a0c3-6b6e1a2ba629" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-972195d4-2903-51a7-83ec-a9b9e22afa04" :answer/id #uuid "972195d4-2903-51a7-83ec-a9b9e22afa04" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-f9d08d61-2fdd-54ec-b10c-73a52d207beb" :answer/id #uuid "f9d08d61-2fdd-54ec-b10c-73a52d207beb" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-655e9f8a-99c6-542e-bec2-084d448a9418" :answer/id #uuid "655e9f8a-99c6-542e-bec2-084d448a9418" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-f5c54a6b-f8fc-5a8d-915e-56317c3cbc76" :answer/id #uuid "f5c54a6b-f8fc-5a8d-915e-56317c3cbc76" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "question-c6b5a56c-98c8-5d43-970c-b65710fedbd3" :question/id #uuid "c6b5a56c-98c8-5d43-970c-b65710fedbd3" :question/math-academy-id "q-110892" :question/problem "Evaluate $\\sqrt[3]{7r+1}$ at $r=9.$" :question/worked-solution "We replace $r$ with $9$ in the given expression, and simplify as much as possible:\n\n$$\n\\begin{aligned}\\sqrt[3]{7r+1} & = \\\\ \\sqrt[3]{7(9)+1} & = \\\\ \\sqrt[3]{63+1} & = \\\\ \\sqrt[3]{64} & = \\\\ \\sqrt[3]{{4}^{3}} & = \\\\ 4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eb373ce3-e8bd-579b-8051-9b912f1cd1ff"] :db/ensure [:question/validate]} {:db/id "answer-field-eb373ce3-e8bd-579b-8051-9b912f1cd1ff" :answer-field/id #uuid "eb373ce3-e8bd-579b-8051-9b912f1cd1ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e8abba6-8d33-582a-b745-99b175925a46" :answer-field/choices ["answer-1d6bcdc9-14f9-5f71-9835-f562c6809b64" "answer-d1987438-6c46