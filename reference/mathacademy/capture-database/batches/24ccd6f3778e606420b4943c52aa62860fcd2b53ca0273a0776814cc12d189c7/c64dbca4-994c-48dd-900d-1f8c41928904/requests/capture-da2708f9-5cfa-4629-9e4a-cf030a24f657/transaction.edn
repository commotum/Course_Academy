3826799"] :db/ensure [:question/validate]} {:db/id "answer-field-efcc6311-10df-54dc-8651-e542d3826799" :answer-field/id #uuid "efcc6311-10df-54dc-8651-e542d3826799" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-65a76ca0-a971-5ccc-9072-317cbcb2d2cd" :answer-field/choices ["answer-77f7dfd0-c683-503c-a061-2194c35d18f3" "answer-65a76ca0-a971-5ccc-9072-317cbcb2d2cd" "answer-96b27cfd-6d8e-5899-9a88-3b5a2523f0a4" "answer-6b684ac9-5ff6-51e6-b5d1-d22a7dc5e7bb" "answer-32839700-f504-5e42-9637-e60abf31b6ed"] :db/ensure [:answer-field/validate]} {:db/id "answer-77f7dfd0-c683-503c-a061-2194c35d18f3" :answer/id #uuid "77f7dfd0-c683-503c-a061-2194c35d18f3" :answer/type :answer.type/math :answer/value "N(-2,24)" :db/ensure [:answer/validate]} {:db/id "answer-65a76ca0-a971-5ccc-9072-317cbcb2d2cd" :answer/id #uuid "65a76ca0-a971-5ccc-9072-317cbcb2d2cd" :answer/type :answer.type/math :answer/value "N(-2,88)" :db/ensure [:answer/validate]} {:db/id "answer-96b27cfd-6d8e-5899-9a88-3b5a2523f0a4" :answer/id #uuid "96b27cfd-6d8e-5899-9a88-3b5a2523f0a4" :answer/type :answer.type/math :answer/value "N(-2,92)" :db/ensure [:answer/validate]} {:db/id "answer-6b684ac9-5ff6-51e6-b5d1-d22a7dc5e7bb" :answer/id #uuid "6b684ac9-5ff6-51e6-b5d1-d22a7dc5e7bb" :answer/type :answer.type/math :answer/value "N(-6,24)" :db/ensure [:answer/validate]} {:db/id "answer-32839700-f504-5e42-9637-e60abf31b6ed" :answer/id #uuid "32839700-f504-5e42-9637-e60abf31b6ed" :answer/type :answer.type/text :answer/value "Not enough information to determine the answer" :db/ensure [:answer/validate]} {:db/id "question-e193207c-9362-5624-9544-44b526952e2a" :question/id #uuid "e193207c-9362-5624-9544-44b526952e2a" :question/math-academy-id "q-109726" :question/problem "If ${X}_{1}∼N(-14,{20}^{2})$ and ${X}_{2}∼N(-6,{15}^{2})$ are independent and $Y={X}_{1}+{X}_{2},$ calculate $P(-28<Y\\le 12).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.3\\,$</th><td align=\"center\"> $\\,0.3821\\,$ </td><td align=\"center\"> $\\,0.3783\\,$ </td><td align=\"center\"> $\\,0.3745\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th><td align=\"center\"> $\\,0.4207\\,$ </td><td align=\"center\"> $\\,0.4168\\,$ </td><td align=\"center\"> $\\,0.4129\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th><td align=\"center\"> $\\,0.4602\\,$ </td><td align=\"center\"> $\\,0.4562\\,$ </td><td align=\"center\"> $\\,0.4522\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.2\\,$</th><td align=\"center\"> $\\,0.8962\\,$ </td><td align=\"center\"> $\\,0.8980\\,$ </td><td align=\"center\"> $\\,0.8997\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.3\\,$</th><td align=\"center\"> $\\,0.9131\\,$ </td><td align=\"center\"> $\\,0.9147\\,$ </td><td align=\"center\"> $\\,0.9162\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,1.4\\,$</th><td align=\"center\"> $\\,0.9279\\,$ </td><td align=\"center\"> $\\,0.9292\\,$ </td><td align=\"center\"> $\\,0.9306\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$ and $a$ and $b$ are constants, then \n\n$$\na{X}_{1}+b{X}_{2}∼N(a{\\mu }_{1}+b{\\mu }_{2},{a}^{2}{\\sigma }_{1}^{2}+{b}^{2}{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2} & ∼N({\\mu }_{1}+{\\mu }_{2},{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}) \\\\  & ∼N(-14-6,400+225) \\\\  & ∼N(-20,625).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu =-20$ and standard deviation $\\sigma =\\sqrt{625}=25.$ \n\nWe want to find $P(-28<Y\\le 12).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(-28<Y\\le 12) & =P(\\frac{-28+20}{25}<Z\\le \\frac{12+20}{25}) \\\\  & =P(-0.32\\le Z\\le 1.28) \\\\  & =P(Z<1.28)-P(Z<-0.32) \\\\  & =Φ(1.28)-Φ(-0.32)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(-0.32) & ≈0.3745 \\\\ Φ(1.28) & ≈0.8997.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(-28<Y\\le 12) & =Φ(1.28)-Φ(-0.32) \\\\  & ≈0.8997-0.3745 \\\\  & ≈0.53.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d625ba35-2bd7-5f82-badd-daf45f13bceb"] :db/ensure [:question/validate]} {:db/id "answer-field-d625ba35-2bd7-5f82-badd-daf45f13bceb" :answer-field/id #uuid "d625ba35-2bd7-5f82-badd-daf45f13bceb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c145152d-0394-5455-96ae-64a0c2183c91" :answer-field/choices ["answer-82f2592b-71b1-5b3d-9652-be585fa3017f" "answer-c145152d-0394-5455-96ae-64a0c2183c91" "answer-94e4ccc1-de28-5a71-ba16-9e0997ac651b" "answer-85d59656-3537-5457-8d1c-dc85f60