:answer-field.type/radio :answer-field/correct "answer-86a95d46-89a3-5b06-8221-b59e68bab013" :answer-field/choices ["answer-f9eecf5b-4431-5988-ac24-8ec51e2c687c" "answer-bfd1647f-a339-5240-b787-f6c0d05abdbb" "answer-f9adebf3-6330-575d-845f-896e038bb897" "answer-e273f529-d3a2-5eba-a46e-b61afe82fb5a" "answer-86a95d46-89a3-5b06-8221-b59e68bab013"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9eecf5b-4431-5988-ac24-8ec51e2c687c" :answer/id #uuid "f9eecf5b-4431-5988-ac24-8ec51e2c687c" :answer/type :answer.type/math :answer/value "h=-1" :db/ensure [:answer/validate]} {:db/id "answer-bfd1647f-a339-5240-b787-f6c0d05abdbb" :answer/id #uuid "bfd1647f-a339-5240-b787-f6c0d05abdbb" :answer/type :answer.type/math :answer/value "h=-\\frac{7}{5}" :db/ensure [:answer/validate]} {:db/id "answer-f9adebf3-6330-575d-845f-896e038bb897" :answer/id #uuid "f9adebf3-6330-575d-845f-896e038bb897" :answer/type :answer.type/math :answer/value "h=2" :db/ensure [:answer/validate]} {:db/id "answer-e273f529-d3a2-5eba-a46e-b61afe82fb5a" :answer/id #uuid "e273f529-d3a2-5eba-a46e-b61afe82fb5a" :answer/type :answer.type/math :answer/value "h=\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "answer-86a95d46-89a3-5b06-8221-b59e68bab013" :answer/id #uuid "86a95d46-89a3-5b06-8221-b59e68bab013" :answer/type :answer.type/math :answer/value "h=\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id 17592186078580 :knowledge-point/questions ["question-470fa283-2b00-51e0-9a35-7c42b40fff42"] :db/ensure [:knowledge-point/validate]} {:db/id "question-470fa283-2b00-51e0-9a35-7c42b40fff42" :question/id #uuid "470fa283-2b00-51e0-9a35-7c42b40fff42" :question/math-academy-id "q-171600" :question/problem "If $\\frac{3k-2}{6}=-(k+2),$ then $k=${{field-1}}." :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $6$:\n\n$$\n\\begin{aligned}\\frac{3k-2}{6} & =-(k+2) \\\\ 6\\cdot (\\frac{3k-2}{6}) & =6\\cdot (-(k+2)) \\\\ \\cancel{6}\\cdot (\\frac{3k-2}{\\cancel{6}}) & =-6(k+2) \\\\ 3k-2 & =-6k-12\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3k-2 & =-6k-12 \\\\ 3k-2+6k & =-6k-12+6k \\\\ 9k-2 & =-12 \\\\ 9k-2+2 & =-12+2 \\\\ 9k & =-10 \\\\ \\frac{9k}{9} & =\\frac{-10}{9} \\\\ k & =-\\frac{10}{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-28157b7f-c2b1-5be6-a604-5bd03e2ba7ef"] :db/ensure [:question/validate]} {:db/id "answer-field-28157b7f-c2b1-5be6-a604-5bd03e2ba7ef" :answer-field/id #uuid "28157b7f-c2b1-5be6-a604-5bd03e2ba7ef" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2188e8eb-24f6-567f-b4a0-82bd8c14ebf9" :answer-field/choices ["answer-2188e8eb-24f6-567f-b4a0-82bd8c14ebf9"] :db/ensure [:answer-field/validate]} {:db/id "answer-2188e8eb-24f6-567f-b4a0-82bd8c14ebf9" :answer/id #uuid "2188e8eb-24f6-567f-b4a0-82bd8c14ebf9" :answer/type :answer.type/math :answer/value "-\\frac{10}{9}" :db/ensure [:answer/validate]} {:db/id "activity-d553d002-0e4d-5513-9db5-e6d5e807e0c2" :activity/id #uuid "d553d002-0e4d-5513-9db5-e6d5e807e0c2" :activity/title "Solving Linear Equations by Clearing a Rational Expression" :activity/type :activity.type/review :activity/scope 17592186048760 :activity/course 17592186046648 :activity/steps ["step-799a2f4f-2697-5ff1-b785-172536801285" "step-6028f492-ba55-501f-87da-d15709c17c82" "step-aff5c2ca-053d-5601-be33-a76726d11b9c" "step-7206ffec-4e93-51d5-9045-454b39491a19" "step-ebdfcf53-3aab-5152-8a64-f64e55ec050a"] :activity/first-step "step-799a2f4f-2697-5ff1-b785-172536801285" :db/ensure [:activity/validate]} {:db/id "step-799a2f4f-2697-5ff1-b785-172536801285" :step/id #uuid "799a2f4f-2697-5ff1-b785-172536801285" :step/content "question-7e49ab95-b651-5531-ac5c-90e4392b7705" :step/next "step-6028f492-ba55-501f-87da-d15709c17c82" :db/ensure [:step/validate]} {:db/id "step-6028f492-ba55-501f-87da-d15709c17c82" :step/id #uuid "6028f492-ba55-501f-87da-d15709c17c82" :step/content 17592186078918 :step/next "step-aff5c2ca-053d-5601-be33-a76726d11b9c" :db/ensure [:step/validate]} {:db/id "step-aff5c2ca-053d-5601-be33-a76726d11b9c" :step/id #uuid "aff5c2ca-053d-5601-be33-a76726d11b9c" :step/content "question-fcf291ca-08c9-536b-b233-ba6182878dc7" :step/next "step-7206ffec-4e93-51d5-9045-454b39491a19" :db/ensure [:step/validate]} {:db/id "step-7206ffec-4e93-51d5-9045-454b39491a19" :step/id #uuid "7206ffec-4e93-51d5-9045-454b39491a19" :step/content "question-6bdf897b-5216-5fe0-b918-3faeb980f813" :step/next "step-ebdfcf53-3aab-5152-8a64-f64e55ec050a" :db/ensure [:step/validate]} {:db/id "step-ebdfcf53-3aab-5152-8a64-f64e55ec050a" :step/id #uuid "ebdfcf53-3aab-5152-8a64-f64e55ec050a" :step/content "question-470fa283-2b00-51e0-9a35-7c42b40fff42" :db/ensure [:step/validate]} {:db/id 17592186138440 :knowledge-point/questions ["question-4a867d1e-d4d9-50bf-b40e-5286a48f1d65" "question-321dc173-e020-511b-8049-7dba8d5ea21d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138313 :question/worked-solution "We *measure the change* of the volume as *we change* the amount of time. Consequently, any appropriate unit for measuring the rate of change of water volume in the tank must take the form\n\n$$\n\\dfrac{\\textrm{unit of volume}}{\\textrm{unit of time}}.\n$$\n\nSome examples of appropriate units include $\\dfrac{\\textrm{liters}}{\\textrm{hour}},$ $\\dfrac{\\textrm{m}^3}{\\textrm{min}},$ and $\\dfrac{\\textrm{cm}^3}{\\textrm{s}}.$" :db/ensure [:question/validate]} {:db/id 17592186138458 :knowledge-point/questions ["question-7eeb94bb-3ad7-577d-9be8-4467334dced4" "question-84dd0eb1-204d-5088-96b6-0cbdfd5aaddf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186138211 :question/worked-solution "We *measure the change* in the mass, as *we change* the volume. Consequently, any appropriate unit must take the form\n\n$$\n\\dfrac{\\textrm{unit of mass}}{\\textrm{unit of volume}}.\n$$\n\nThe base unit for mass is $\\textrm{kg},$ and the base unit for volume is $\\textrm{m}^3.$ Therefore, the units of density are\n\n$$\n\\dfrac{\\textrm{kg}}{\\textrm{m}^3},\n$$\n\nor, kilograms per cubic meter." :db/ensure [:question/validate]} {:db/id "question-4a867d1e-d4d9-50bf-b40e-5286a48f1d65" :question/id #uuid "4a867d1e-d4d9-50bf-b40e-5286a48f1d65" :question/math-academy-id "q-46278" :question/problem "Mr. Smith owns a factory where pants are made. To make these pants, the factory has several sewing machines. Mr. Smith wishes to determine the rate at which the number of pants increases with the number of sewing machines. What is an appropriate unit for Mr. Smith's purpose?" :question/worked-solution "We *measure the change* in the number of pants, as *we change* the number of sewing machines. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of pants}}{\\text{unit of sewing machines}}.\n$$\n\nTherefore, among the given options, the only correct one is \"pants per sewing machine.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fd72d8dd-ed46-535b-82ea-bbaa1272b985"] :db/ensure [:question/validate]} {:db/id "answer-field-fd72d8dd-ed46-535b-82ea-bbaa1272b985" :answer-field/id #uuid "fd72d8dd-ed46-535b-82ea-bbaa1272b985" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1db72ead-e219-506e-a05e-8d12d99ca06d" :answer-field/choices ["answer-1db72ead-e219-506e-a05e-8d12d99ca06d" "answer-2bc1cc65-cce6-5aab-a972-6c9fe588281f" "answer-6674b986-b342-55f0-8b67-c723d4e8fe35" "answer-60df7dfc-bcf9-5f26-87e5-641220cc035f" "answer-d6b9893d-0e95-5cf7-b7ac-fb186460a81c"] :db/ensure [:answer-field/validate]} {:db/id "answer-1db72ead-e219-506e-a05e-8d12d99ca06d" :answer/id #uuid "1db72ead-e219-506e-a05e-8d12d99ca06d" :answer/type :answer.type/text :answer/value "Pants per sewing machine" :db/ensure [:answer/validate]} {:db/id "answer-2bc1cc65-cce6-5aab-a972-6c9fe588281f" :answer/id #uuid "2bc1cc65-cce6-5aab-a972-6c9fe588281f" :answer/type :answer.type/text :answer/value "Sewing machines" :db/ensure [:answer/validate]} {:db/id "answer-6674b986-b342-55f0-8b67-c723d4e8fe35" :answer/id #uuid "6674b986-b342-55f0-8b67-c723d4e8fe35" :answer/type :answer.type/text :answer/value "Sewing machines per pant" :db/ensure [:answer/validate]} {:db/id "answer-60df7dfc-bcf9-5f26-87e5-641220cc035f" :answer/id #uuid "60df7dfc-bcf9-5f26-87e5-641220cc035f" :answer/type :answer.type/text :answer/value "Square pants" :db/ensure [:answer/validate]} {:db/id "answer-d6b9893d-0e95-5cf7-b7ac-fb186460a81c" :answer/id #uuid "d6b9893d-0e95-5cf7-b7ac-fb186460a81c" :answer/type :answer.type/text :answer/value "Square pants per sewing machine" :db/ensure [:answer/validate]} {:db/id "question-321dc173-e020-511b-8049-7dba8d5ea21d" :question/id #uuid "321dc173-e020-511b-8049-7dba8d5ea21d" :question/math-academy-id "q-59700" :question/problem "Kevin, a farmer, prepares fodder annually for his cows. He wants to determine how the weight of fodder changes as the number of cows changes. What is an appropriate unit for Kevin's purpose?" :question/worked-solution "We *measure the change* in the weight of fodder, as *we change* the number of cows. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of weight}}{\\text{number of cows}}.\n$$\n\nTherefore, among the given options, the only correct one is $\\frac{\\text{kg}}{\\text{cow}}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-17602a23-65c4-5b79-88c2-cd9e187b01af"] :db/ensure [:question/validate]} {:db/id "answer-field-17602a23-65c4-5b79-88c2-cd9e187b01af" :answer-field/id #uuid "17602a23-65c4-5b79-88c2-cd9e187b01af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-87a9fb87-3f7f-5f15-90f0-fc1b135e29be" :answer-field/choices ["answer-8abcc84d-1cac-523c-8298-c07ee544a799" "answer-37557c6c-406f-5373-8d54-ed5c649b8b5e" "answer-87a9fb87-3f7f-5f15-90f0-fc1b135e29be" "answer-0d10ee8f-e8d6-56f3-a936-711052259f70" "answer-e79be69d-008b-5dcb-a000-d63598d95025"] :db/ensure [:answer-field/validate]} {:db/id "answer-8abcc84d-1cac-523c-8298-c07ee544a799" :answer/id #uuid "8abcc84d-1cac-523c-8298-c07ee544a799" :answer/type :answer.type/math :answer/value "\\frac{\\text{cow}}{\\text{kg}}" :db/ensure [:answer/validate]} {:db/id "answer-37557c6c-406f-5373-8d54-ed5c649b8b5e" :answer/id #uuid "37557c6c-406f-5373-8d54-ed5c649b8b5e" :answer/type :answer.type/math :answer/value "\\frac{\\text{cow}}{{\\text{kg}}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-87a9fb87-3f7f-5f15-90f0-fc1b135e29be" :answer/id #uuid "87a9fb87-3f7f-5f15-90f0-fc1b135e29be" :answer/type :answer.type/math :answer/value "\\frac{\\text{kg}}{\\text{cow}}" :db/ensure [:answer/validate]} {:db/id "answer-0d10ee8f-e8d6-56f3-a936-711052259f70" :answer/id #uuid "0d10ee8f-e8d6-56f3-a936-711052259f70" :answer/type :answer.type/math :answer/value "\\frac{\\text{kg}}{{\\text{cow}}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-e79be69d-008b-5dcb-a000-d63598d95025" :answer/id #uuid "e79be69d-008b-5dcb-a000-d63598d95025" :answer/type :answer.type/math :answer/value "\\text{kg}\\cdot \\text{cow}" :db/ensure [:answer/validate]} {:db/id "question-7eeb94bb-3ad7-577d-9be8-4467334dced4" :question/id #uuid "7eeb94bb-3ad7-577d-9be8-4467334dced4" :question/math-academy-id "q-103386" :question/problem "Mark is mowing the lawn. He wants to determine how much area he can mow as time goes on. What are appropriate units for Mark's purpose, in terms of base units?" :question/worked-solution "We *measure the change* in the area, as *we change* the time. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of area}}{\\text{unit of time}}.\n$$\n\nThe base unit for area is ${\\text{m}}^{2},$ and the base unit for time is $\\text{s}.$ Therefore, the appropriate units are\n\n$$\n\\frac{{\\text{m}}^{2}}{\\text{s}},\n$$\n\nor, square meters per second." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-85ecd063-0c30-5774-8d10-b2e4acbf4358"] :db/ensure [:question/validate]} {:db/id "answer-field-85ecd063-0c30-5774-8d10-b2e4acbf4358" :answer-field/id #uuid "85ecd063-0c30-5774-8d10-b2e4acbf4358" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ee35cffa-97d2-5c8d-8c26-3cb5445b1373" :answer-field/choices ["answer-d31e5a96-a611-5ddc-a644-f01de074be5a" "answer-d188753b-06ec-5280-9668-288f19cdb913" "answer-a7ccc9c8-0453-51f3-a066-d4f32b5bb75d" "answer-ee35cffa-97d2-5c8d-8c26-3cb5445b1373" "answer-00b2500b-de4f-55ca-a5fe-606c9cc41191"] :db/ensure [:answer-field/validate]} {:db/id "answer-d31e5a96-a611-5ddc-a644-f01de074be5a" :answer/id #uuid "d31e5a96-a611-5ddc-a644-f01de074be5a" :answer/type :answer.type/math :answer/value "\\frac{\\text{ft}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-d188753b-06ec-5280-9668-288f19cdb913" :answer/id #uuid "d188753b-06ec-5280-9668-288f19cdb913" :answer/type :answer.type/math :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-a7ccc9c8-0453-51f3-a066-d4f32b5bb75d" :answer/id #uuid "a7ccc9c8-0453-51f3-a066-d4f32b5bb75d" :answer/type :answer.type/math :answer/value "\\frac{{\\text{in}}^{3}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-ee35cffa-97d2-5c8d-8c26-3cb5445b1373" :answer/id #uuid "ee35cffa-97d2-5c8d-8c26-3cb5445b1373" :answer/type :answer.type/math :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-00b2500b-de4f-55ca-a5fe-606c9cc41191" :answer/id #uuid "00b2500b-de4f-55ca-a5fe-606c9cc41191" :answer/type :answer.type/math :answer/value "\\frac{{\\text{m}}^{2}}{{\\text{s}}^{2}}" :db/ensure [:answer/validate]} {:db/id "question-84dd0eb1-204d-5088-96b6-0cbdfd5aaddf" :question/id #uuid "84dd0eb1-204d-5088-96b6-0cbdfd5aaddf" :question/math-academy-id "q-103391" :question/problem "John is traveling in the subway and wants to determine how the subway speed changes as time goes on. What are appropriate units for the rate of change of the speed, in terms of base units?" :question/worked-solution "We *measure the change* in the speed, as *we change* the time. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of speed}}{\\text{unit of time}}.\n$$\n\nIn terms of meters and seconds, the unit for speed is $\\frac{\\text{m}}{\\text{s}},$ and the unit for time is $\\text{s}.$ Therefore, the appropriate unit for the rate of change of speed is\n\n$$\n\\frac{(\\frac{\\text{m}}{\\text{s}})}{\\text{s}}=\\frac{\\text{m}}{{\\text{s}}^{2}}.\n$$\n\nor, meters per square second." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5165db33-f994-5bf2-a4e5-e80f00f1780e"] :db/ensure [:question/validate]} {:db/id "answer-field-5165db33-f994-5bf2-a4e5-e80f00f1780e" :answer-field/id #uuid "5165db33-f994-5bf2-a4e5-e80f00f1780e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-70cfc503-22ee-55c2-836b-3453b0c8c7f2" :answer-field/choices ["answer-0a31c016-7581-51c5-822b-4a571829ce10" "answer-f747453d-9a93-50ac-912e-3072a4460dcd" "answer-a785465d-4be2-52e9-bd6a-046a7ecc4c55" "answer-70cfc503-22ee-55c2-836b-3453b0c8c7f2" "answer-92f01d15-91dc-5198-9880-f2fea86ce575"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a31c016-7581-51c5-822b-4a571829ce10" :answer/id #uuid "0a31c016-7581-51c5-822b-4a571829ce10" :answer/type :answer.type/math :answer/value "\\frac{\\text{in}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-f747453d-9a93-50ac-912e-3072a4460dcd" :answer/id #uuid "f747453d-9a93-50ac-912e-3072a4460dcd" :answer/type :answer.type/math :answer/value "\\frac{\\text{in}}{{\\text{s}}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-a785465d-4be2-52e9-bd6a-046a7ecc4c55" :answer/id #uuid "a785465d-4be2-52e9-bd6a-046a7ecc4c55" :answer/type :answer.type/math :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-70cfc503-22ee-55c2-836b-3453b0c8c7f2" :answer/id #uuid "70cfc503-22ee-55c2-836b-3453b0c8c7f2" :answer/type :answer.type/math :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-92f01d15-91dc-5198-9880-f2fea86ce575" :answer/id #uuid "92f01d15-91dc-5198-9880-f2fea86ce575" :answer/type :answer.type/math :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id 17592186139598 :tutorial/content "Sometimes, when we are choosing an appropriate unit, we are not given any formula to use. \n\nThis often occurs when we measure the **rate of change** of something. A rate of change measures how much something changes as we change something else.\n\nIn such cases, we can use a quotient to work out an appropriate unit. The numerator is what we measure the change of, and the denominator is what we change:\n\n$$\n\\dfrac{\\color{blue}\\textrm{what we measure the change of}}{\\color{red}\\textrm{what we change}}\n$$\n\nFor instance, suppose that a newly opened store wants to measure the rate at which the number of customers increases each day.\n\nWe *measure the change* of the number of customers, as *we change* the number of days, so the most appropriate unit is\n\n$$\n\\dfrac{\\color{blue}\\textrm{customers}}{\\color{red}\\textrm{day}},\n$$\n\nor, customers per day." :db/ensure [:tutorial/validate]} {:db/id 17592186138591 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186054641 :knowledge-point/questions ["question-d207a2f4-0aa5-5660-b685-cd64ab113d8c" "question-86cefea1-4583-5e59-84d3-54626f201af0" "question-20409d3d-4f9a-55b3-ae07-39d336721810"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054365 :question/problem "Consider the following statement:\n\n$14$ is divisible by $4$ **or** $\\sqrt{3}$ is a rational number.\n\nWrite this statement in symbolic form using the following notations:\n\n- ![](images/64/64c5006a1d5f6b515ebfb603e5da3d10b44616960afd0dbbcabb32a5a23aed26.svg)\n\n- ![](images/b2/b2d623c77373a42771d812e0242d4545884a79107c1e97769d0f4bb8bb7a7a06.svg)" :db/ensure [:question/validate]} {:db/id 17592186054642 :knowledge-point/questions ["question-2491e070-37d1-586f-b67e-4103f90ed72e" "question-6a09aec4-5239-540b-baf9-5ce099cfcf55" "question-7d328347-cdbe-5da0-b048-5a26fc979b28" "question-02eac488-c624-58c9-8e5f-2f3e12e226ab" "question-717ad532-4709-5a63-b627-09752527f241"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054366 :question/problem "$7$ is odd **or** a multiple of $3$, **and** $3$ is less than $7$.\n\nExpress the compound statement above in symbolic form given the following notations:\n\n- ![](images/c9/c99c7535c3d2d6c854aea2e3408d15f2c0ff6423c4010ad211dbb6d576fe6928.svg)\n\n- ![](images/3f/3fca3aace2f71ead6ca860e93e9138abb40559e0eb9434ca068b563380b12912.svg)\n\n- ![](images/76/768f38af5ffc9fc48817db2f054dc9da251a26469a644c0e7eb7141fef54284b.svg)" :db/ensure [:question/validate]} {:db/id 17592186054643 :knowledge-point/questions ["question-e6fd19f6-d3a7-5978-9314-7283447a9c4c" "question-c586014f-8b0b-5087-a740-57029ea9f0d3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054644 :knowledge-point/questions ["question-e7eb8fb9-95e2-5b65-af61-0f6fe58c75b8" "question-bbfbaab7-10b5-57a8-a26d-3c15f79b1087" "question-5f1de2e0-3e98-599c-9d88-57f6ce468e91"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d207a2f4-0aa5-5660-b685-cd64ab113d8c" :question/id #uuid "d207a2f4-0aa5-5660-b685-cd64ab113d8c" :question/math-academy-id "q-175527" :question/problem "$2$ is odd **and** $3$ is prime.\n\nConsider the compound statement above and the following notations:\n\n- $P:2\\text{ is odd}$\n\n- $Q:3\\text{ is prime}$\n\nExpressed in symbolic form, our statement can be written as\n{{field-1}}{{field-2}}{{field-3}}." :question/worked-solution "The word \"and\" is represented by the symbol \"$∧$\".\n\nSo, the sentence reads\n\n$$\n{{2\\text{ is odd}}_{⏟}}_{P}\\,{{\\text{and}}_{⏟}}_{∧}\\,{{3\\text{ is prime}}_{⏟}}_{Q},\n$$\n\nthat is, $P∧Q.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2c15a5ea-6fbb-5554-b167-3feb951f48f5" "answer-field-d713043e-a84c-5e43-8ac1-2406fa552b95" "answer-field-65e86f13-cfaa-54d2-a88c-7dbfbad93e7b"] :db/ensure [:question/validate]} {:db/id "answer-field-2c15a5ea-6fbb-5554-b167-3feb951f48f5" :answer-field/id #uuid "2c15a5ea-6fbb-5554-b167-3feb951f48f5" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-88911721-9caf-5241-b5ba-5af57e949852" :answer-field/choices ["answer-88911721-9caf-5241-b5ba-5af57e949852" "answer-901c3b3b-9f68-5e41-9761-d7d73ac85dfb" "answer-dd760021-393c-59e1-b51e-32da763bff33"] :db/ensure [:answer-field/validate]} {:db/id "answer-88911721-9caf-5241-b5ba-5af57e949852" :answer/id #uuid "88911721-9caf-5241-b5ba-5af57e949852" :answer/type :answer.type/math :answer/value "P" :db/ensure [:answer/validate]} {:db/id "answer-901c3b3b-9f68-5e41-9761-d7d73ac85dfb" :answer/id #uuid "901c3b3b-9f68-5e41-9761-d7d73ac85dfb" :answer/type :answer.type/math :answer/value "∧" :db/ensure [:answer/validate]} {:db/id "answer-dd760021-393c-59e1-b51e-32da763bff33" :answer/id #uuid "dd760021-393c-59e1-b51e-32da763bff33" :answer/type :answer.type/math :answer/value "∨" :db/ensure [:answer/validate]} {:db/id "answer-field-d713043e-a84c-5e43-8ac1-2406fa552b95" :answer-field/id #uuid "d713043e-a84c-5e43-8ac1-2406fa552b95" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-e8cb8efd-9eb2-5007-a571-6411296a27e7" :answer-field/choices ["answer-2ba18c82-4fca-5d74-9c39-649a58246820" "answer-b9c2b74e-f283-5621-823f-7ea07e5f1f6a" "answer-e8cb8efd-9eb2-5007-a571-6411296a27e7" "answer-c13b8279-5235-52d4-8183-9eead02e882a"] :db/ensure [:answ