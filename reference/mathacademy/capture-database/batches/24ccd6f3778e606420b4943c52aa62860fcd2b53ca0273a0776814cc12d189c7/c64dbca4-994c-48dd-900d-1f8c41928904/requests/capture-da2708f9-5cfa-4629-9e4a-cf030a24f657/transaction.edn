8e7d-d90b7f0e3f2a" :db/ensure [:step/validate]} {:db/id "step-ad6c90b7-0c2b-5201-8e7d-d90b7f0e3f2a" :step/id #uuid "ad6c90b7-0c2b-5201-8e7d-d90b7f0e3f2a" :step/content "question-7e27eddd-1b20-5f57-9534-d5e05a5f064b" :step/next "step-fa7076ba-9b61-52c4-ac56-c8c93c105064" :db/ensure [:step/validate]} {:db/id "step-fa7076ba-9b61-52c4-ac56-c8c93c105064" :step/id #uuid "fa7076ba-9b61-52c4-ac56-c8c93c105064" :step/content "question-bbba28e1-c797-5200-af1b-5dd4807a9f53" :step/next "step-9521dc72-95fd-5b99-9ee6-2cc815dfa07f" :db/ensure [:step/validate]} {:db/id "step-9521dc72-95fd-5b99-9ee6-2cc815dfa07f" :step/id #uuid "9521dc72-95fd-5b99-9ee6-2cc815dfa07f" :step/content "question-a33bcbcb-8c75-50ac-adb2-e56b319ae036" :step/next "step-d3ae019d-3691-5b62-babc-9366ec2c3c50" :db/ensure [:step/validate]} {:db/id "step-d3ae019d-3691-5b62-babc-9366ec2c3c50" :step/id #uuid "d3ae019d-3691-5b62-babc-9366ec2c3c50" :step/content "question-c6b5a56c-98c8-5d43-970c-b65710fedbd3" :db/ensure [:step/validate]} {:db/id 17592186073746 :knowledge-point/questions ["question-e5110c54-de9e-5958-ac4d-933027f79b9c" "question-919eb3c8-9df3-5268-99a8-1eece100daa7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e5110c54-de9e-5958-ac4d-933027f79b9c" :question/id #uuid "e5110c54-de9e-5958-ac4d-933027f79b9c" :question/math-academy-id "q-3977" :question/problem "If ${z}^{3}-5{z}^{2}=-2{z}^{3}+4{z}^{2}+30z$, then $z=$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(z)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}{z}^{3}-5{z}^{2} & =-2{z}^{3}+4{z}^{2}+30z \\\\ 3{z}^{3}-5{z}^{2} & =4{z}^{2}+30z \\\\ 3{z}^{3}-9{z}^{2} & =30z \\\\ 3{z}^{3}-9{z}^{2}-30z & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $3z.$ We can factor out the $3z$ as follows:\n\n$$\n\\begin{aligned}3{z}^{3}-9{z}^{2}-30z & =0 \\\\ 3z({z}^{2}-3z-10) & =0\\end{aligned}\n$$\n\nNow, we factor the expression ${z}^{2}-3z-10$ as follows:\n\n$$\n\\begin{aligned}3z({z}^{2}-3z-10) & =0 \\\\ 3z(z-5)(z+2) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $z=0,$ $z=5,$ and $z=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-498bf339-9275-5f3a-b0a2-353256e90566"] :db/ensure [:question/validate]} {:db/id "answer-field-498bf339-9275-5f3a-b0a2-353256e90566" :answer-field/id #uuid "498bf339-9275-5f3a-b0a2-353256e90566" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4658aaeb-11d9-5b92-a7a2-aea2864fd98a" :answer-field/choices ["answer-296694e3-5319-547a-8c8f-0fc26e3a8b01" "answer-de7814e7-b746-525b-9bf4-f606ff9e5397" "answer-4658aaeb-11d9-5b92-a7a2-aea2864fd98a" "answer-ab32c019-df2f-511a-adec-83c31e26c5c2" "answer-4a808032-3416-51f3-bad1-93a62d09b580"] :db/ensure [:answer-field/validate]} {:db/id "answer-296694e3-5319-547a-8c8f-0fc26e3a8b01" :answer/id #uuid "296694e3-5319-547a-8c8f-0fc26e3a8b01" :answer/type :answer.type/math :answer/value "z=-2,\\,-3,\\,5" :db/ensure [:answer/validate]} {:db/id "answer-de7814e7-b746-525b-9bf4-f606ff9e5397" :answer/id #uuid "de7814e7-b746-525b-9bf4-f606ff9e5397" :answer/type :answer.type/math :answer/value "z=-2,\\,0,\\,3" :db/ensure [:answer/validate]} {:db/id "answer-4658aaeb-11d9-5b92-a7a2-aea2864fd98a" :answer/id #uuid "4658aaeb-11d9-5b92-a7a2-aea2864fd98a" :answer/type :answer.type/math :answer/value "z=-2,\\,0,\\,5" :db/ensure [:answer/validate]} {:db/id "answer-ab32c019-df2f-511a-adec-83c31e26c5c2" :answer/id #uuid "ab32c019-df2f-511a-adec-83c31e26c5c2" :answer/type :answer.type/math :answer/value "z=-3,\\,0,\\,2" :db/ensure [:answer/validate]} {:db/id "answer-4a808032-3416-51f3-bad1-93a62d09b580" :answer/id #uuid "4a808032-3416-51f3-bad1-93a62d09b580" :answer/type :answer.type/math :answer/value "z=-3,\\,0,\\,5" :db/ensure [:answer/validate]} {:db/id "question-919eb3c8-9df3-5268-99a8-1eece100daa7" :question/id #uuid "919eb3c8-9df3-5268-99a8-1eece100daa7" :question/math-academy-id "q-3986" :question/problem "If $6{y}^{3}+50{y}^{2}+100y=5{y}^{2}+25y$, then $y=$" :question/worked-solution "First, let's rewrite the polynomial equation in the form ${P}_{n}(y)=0.$ To do this, we subtract all the terms from the right-hand side so that the right-hand side becomes $0:$\n\n$$\n\\begin{aligned}6{y}^{3}+50{y}^{2}+100y & =5{y}^{2}+25y \\\\ 6{y}^{3}+45{y}^{2}+100y & =25y \\\\ 6{y}^{3}+45{y}^{2}+75y & =0\\end{aligned}\n$$\n\nNext, notice that all of the terms of the polynomial have a common factor of $3y.$ We can factor out the $3y$ as follows:\n\n$$\n\\begin{aligned}6{y}^{3}+45{y}^{2}+75y & =0 \\\\ 3y(2{y}^{2}+15y+25) & =0\\end{aligned}\n$$\n\nNow, we factor the expression $2{y}^{2}+15y+25$ as follows:\n\n$$\n\\begin{aligned}3y(2{y}^{2}+15y+25) & =0 \\\\ 3y(2y+5)(y+5) & =0\\end{aligned}\n$$\n\nFinally, by applying the zero product rule, the solutions are $y=0,$ $y=-\\frac{5}{2},$ and $y=-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ed6705e1-a953-5bdb-83a1-993a5e062818"] :db/ensure [:question/validate]} {:db/id "answer-field-ed6705e1-a953-5bdb-83a1-993a5e062818" :answer-field/id #uuid "ed6705e1-a953-5bdb-83a1-993a5e062818" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ccc7a4ca-8f50-5800-bd17-58acdabf0fcf" :answer-field/choices ["answer-ccc7a4ca-8f50-5800-bd17-58acdabf0fcf" "answer-22b079b3-82fd-53cc-967c-e6d943626c96" "answer-cf00f047-8ff7-5a2b-acc0-0fb93efa3755" "answer-f58c1047-ff2f-539e-a8e7-b10b9832472f" "answer-5f175bd8-a787-50aa-9e06-2936f24358df"] :db/ensure [:answer-field/validate]} {:db/id "answer-ccc7a4ca-8f50-5800-bd17-58acdabf0fcf" :answer/id #uuid "ccc7a4ca-8f50-5800-bd17-58acdabf0fcf" :answer/type :answer.type/math :answer/value "y=-5,\\,-\\frac{5}{2},\\,0" :db/ensure [:answer/validate]} {:db/id "answer-22b079