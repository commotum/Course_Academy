\"40px\">\n       $0$\n      </td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr height=\"35px\">\n<td align=\"center\"></td>\n<td align=\"center\">\n       $0$\n      </td>\n<td align=\"center\">\n        {{field-2}}\n      </td>\n<td align=\"center\">\n        {{field-3}}\n      </td>\n<td align=\"center\">\n        $0$\n      </td>\n<td align=\"center\"></td>\n</tr>\n<tr height=\"35px\">\n<td align=\"center\"></td>\n<td align=\"center\">\n        $0$\n      </td>\n<td align=\"center\">\n        {{field-4}}\n      </td>\n<td align=\"center\">\n        $0$\n      </td>\n<td align=\"center\">\n        $0$\n      </td>\n<td align=\"center\"></td>\n</tr>\n<tr height=\"35px\">\n<td align=\"center\"></td>\n<td align=\"center\">\n       $0$\n      </td>\n<td align=\"center\">\n        $0$\n      </td>\n<td align=\"center\">\n        $0$\n      </td>\n<td align=\"center\">$1$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody>\n</table>" :db/ensure [:question/validate]} {:db/id "activity-84e6bff6-0220-5548-a317-881317a40fcc" :activity/id #uuid "84e6bff6-0220-5548-a317-881317a40fcc" :activity/title "Finding the Inverse of an NxN Square Matrix Using Row Operations" :activity/type :activity.type/review :activity/scope 17592186050900 :activity/course 17592186046659 :activity/steps ["step-5bf3c18a-521f-5fb6-8509-5ed74fe30796" "step-7b0ebcb2-77f3-5b46-b3f1-7dd2e5ca5c52" "step-8c5251e3-22c3-5014-9451-c03d0e992631" "step-a462d10f-4b9c-548c-8cff-4598c754a4f3" "step-9d169b04-bfd3-52d1-96b3-3ed64d1ca562"] :activity/first-step "step-5bf3c18a-521f-5fb6-8509-5ed74fe30796" :db/ensure [:activity/validate]} {:db/id "step-5bf3c18a-521f-5fb6-8509-5ed74fe30796" :step/id #uuid "5bf3c18a-521f-5fb6-8509-5ed74fe30796" :step/content "question-c001f3d3-aa4e-51e3-be59-c6e92e063349" :step/next "step-7b0ebcb2-77f3-5b46-b3f1-7dd2e5ca5c52" :db/ensure [:step/validate]} {:db/id "step-7b0ebcb2-77f3-5b46-b3f1-7dd2e5ca5c52" :step/id #uuid "7b0ebcb2-77f3-5b46-b3f1-7dd2e5ca5c52" :step/content 17592186269213 :step/next "step-8c5251e3-22c3-5014-9451-c03d0e992631" :db/ensure [:step/validate]} {:db/id "step-8c5251e3-22c3-5014-9451-c03d0e992631" :step/id #uuid "8c5251e3-22c3-5014-9451-c03d0e992631" :step/content 17592186115502 :step/next "step-a462d10f-4b9c-548c-8cff-4598c754a4f3" :db/ensure [:step/validate]} {:db/id "step-a462d10f-4b9c-548c-8cff-4598c754a4f3" :step/id #uuid "a462d10f-4b9c-548c-8cff-4598c754a4f3" :step/content "question-ab4f005c-1d1d-5d63-9ebe-79c504cfd32e" :step/next "step-9d169b04-bfd3-52d1-96b3-3ed64d1ca562" :db/ensure [:step/validate]} {:db/id "step-9d169b04-bfd3-52d1-96b3-3ed64d1ca562" :step/id #uuid "9d169b04-bfd3-52d1-96b3-3ed64d1ca562" :step/content 17592186323836 :db/ensure [:step/validate]} [:db/retract 17592186158936 :answer-field/choices 17592186158937] [:db/retract 17592186158936 :answer-field/choices 17592186158938] [:db/retract 17592186158936 :answer-field/choices 17592186158940] [:db/retract 17592186158936 :answer-field/choices 17592186158941] [:db/retract 17592186158768 :answer-field/choices 17592186158769] [:db/retract 17592186158768 :answer-field/choices 17592186158770] [:db/retract 17592186158768 :answer-field/choices 17592186158772] [:db/retract 17592186158768 :answer-field/choices 17592186158773] {:db/id 17592186162055 :knowledge-point/questions ["question-90934eb8-cbb7-5339-bda4-6344e0c742e6" "question-eb127e88-57e6-5641-837e-22d6b55ce8da" "question-5a0d2344-860b-5e90-a188-b68252dd0262" "question-5cd38ce0-916c-531b-b472-b1dea997c072"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161855 :question/problem "If $X_1\\sim N(2,5)$ and $X_2\\sim  N(-2, 2)$ are independent, then what is the distribution of $Y = X_1+X_2?$" :question/worked-solution "Recall that if $X_1$ and $X_2$ are independent random variables, where $X_1\\sim N(\\mu_1,\\sigma^2_1)$ and $X_2\\sim N(\\mu_2,\\sigma^2_2),$ then \n\n$$\nY = X_1+X_2\\sim N(\\mu_1+\\mu_2, \\sigma^2_1+\\sigma^2_2).\n$$\n\nSince $X_1$ and $X_2$ are independent, we have \n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2} & ∼N(2+(-2),5+2) \\\\  & ∼N(0,7).\\end{aligned}\n$$\n\nTherefore, $Y\\sim N(0, 7).$" :db/ensure [:question/validate]} {:db/id 17592186162059 :knowledge-point/questions ["question-00d2e780-6ff9-5f4c-863c-7e7274f9ff9d" "question-4ad84c9b-528f-52d5-bcd2-180abda6b74b" "question-0705c6e0-425c-53a2-92bd-305a48e1d4f1" "question-9dded8e6-b142-54fa-9bb0-5b65450d8c51"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161859 :question/problem "Suppose that $X$ and $Y$ are independent random variables such that $X \\sim N(2,7)$ and $Y \\sim  N(5, 4).$ Find the distribution of the random variable $W = 2X-Y.$" :question/worked-solution "Recall that if $X_1$ and $X_2$ are independent random variables, where $X_1\\sim N(\\mu_1,\\sigma^2_1)$ and $X_2\\sim N(\\mu_2,\\sigma^2_2),$ and $a$ and $b$ are constants, then \n\n$$\naX_1+bX_2\\sim N(a\\mu_1+b\\mu_2, a^2\\sigma^2_1+b^2\\sigma^2_2).\n$$\n\nSince $X$ and $Y$ are independent, we have \n\n$$\n\\begin{aligned}W=2X-Y & ∼N(2\\cdot 2+(-1)\\cdot 5,{2}^{2}\\cdot 7+(-1)^{2}\\cdot 4) \\\\  & ∼N(-1,32).\\end{aligned}\n$$\n\nTherefore, $Y\\sim N(-1, 32).$" :db/ensure [:question/validate]} {:db/id 17592186162060 :knowledge-point/questions ["question-e193207c-9362-5624-9544-44b526952e2a" "question-65c490f4-ee79-5c66-84d0-39f33e6e9ec0" "question-f962dd14-3b46-5fda-bac4-2a4b37326612" "question-7e624f6f-227d-5bbb-b9ec-897830d915af"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161860 :question/problem "If $X_1\\sim N(10,3^2)$ and $X_2\\sim N(20,5^2)$ are independent and $Y=5X_1-4X_2,$ calculate $P(3 \\lt Y \\lt  40 ).$ Round your final answer to two decimal places.\n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$0.01$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$0.02$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$0.03$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\, 1.2 \\,$</th><td align=\"center\"> $0.8869$ </td><td align=\"center\"> $0.8888$ </td><td align=\"center\"> $0.8907$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\, 1.3 \\,$</th><td align=\"center\"> $0.9049$ </td><td align=\"center\"> $0.9066$ </td><td align=\"center\"> $0.9082$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\, 1.4 \\,$</th><td align=\"center\"> $0.9207$ </td><td align=\"center\"> $0.9222$ </td><td align=\"center\"> $0.9236$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$0.00$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$0.01$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$0.02$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\, 2.7 \\,$</th><td align=\"center\"> $0.9965$ </td><td align=\"center\"> $0.9966$ </td><td align=\"center\"> $0.9967$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\, 2.8 \\,$</th><td align=\"center\"> $0.9974$ </td><td align=\"center\"> $0.9975$ </td><td align=\"center\"> $0.9976$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\, 2.9 \\,$</th><td align=\"center\"> $0.9981$ </td><td align=\"center\"> $0.9982$ </td><td align=\"center\"> $0.9982$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Recall that if $X_1$ and $X_2$ are independent random variables, where $X_1\\sim N(\\mu_1,\\sigma^2_1)$ and $X_2\\sim N(\\mu_2,\\sigma^2_2),$ and $a$ and $b$ are constants, then \n\n$$\naX_1+bX_2\\sim N(a\\mu_1+b\\mu_2, a^2\\sigma^2_1+b^2\\sigma^2_2).\n$$\n\nSince $X_1$ and $X_2$ are independent, the distribution of $Y$ is given by\n\n$$\n\\begin{aligned}Y=5{X}_{1}-4{X}_{2} & ∼N(5{\\mu }_{1}-4{\\mu }_{2},{5}^{2}\\cdot {\\sigma }_{1}^{2}+{4}^{2}\\cdot {\\sigma }_{2}^{2}) \\\\  & ∼N(5{\\mu }_{1}-4{\\mu }_{2},25{\\sigma }_{1}^{2}+16{\\sigma }_{2}^{2}) \\\\  & ∼N(5\\cdot 10+(-4)\\cdot 20,25\\cdot {3}^{2}+16\\cdot {5}^{2}) \\\\  & ∼N(-30,625).\\end{aligned}\n$$\n\nTherefore, $Y$ is normally distributed with mean $\\mu = -30$ and standard deviation $\\sigma = \\sqrt{625} = 25.$ \n\nWe want to find $P(3 \\lt Y \\lt  40).$ Thus, we convert $Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(3<Y<40) & =P(\\frac{3-(-30)}{25}<Z<\\frac{40-(-30)}{25}) \\\\  & =P(1.32<Z<2.8) \\\\  & =P(Z<2.8)-P(Z<1.32) \\\\  & =Φ(2.8)-Φ(1.32)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\begin{aligned}Φ(1.32) & ≈0.9066 \\\\ Φ(2.8) & ≈0.9974.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3<Y<40) & =Φ(2.8)-Φ(1.32) \\\\  & ≈0.9974-0.9066 \\\\  & ≈0.09.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186162061 :knowledge-point/questions ["question-6718d3e2-fbcd-51c5-808c-744242ca4d81" "question-e7f40d31-3891-595e-9dc0-80e5713161b9" "question-bb6e266d-fd9f-5c8c-82b7-fde74e3fe145" "question-0c9343e5-40f1-5766-8346-83637c7ee445"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186161861 :question/problem "The math test results of a group of students are normally distributed with a mean of $67$ and a standard deviation of $12.$ The results of the same group on a history test are normally distributed with a mean of $73$ and a standard deviation of $9.$ If one student is randomly selected, what is the probability their combined score from both tests is more than $150?$ You may assume that the student's scores on both tests are independent. \n\n*Hint: A table of values of $\\Phi(z)$ for different values of $z$ is given below, where $\\Phi(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\, 0.05 \\,$ | $\\, 0.06 \\,$ | $\\, 0.07 \\,$ | $\\, 0.08 \\,$ | $\\, 0.09 \\,$ |\n| --- | --- | --- | --- | --- | --- |\n| $\\, 0.5 \\,$ | $\\, 0.7088 \\,$ | $\\, 0.7123 \\,$ | $\\, 0.7157 \\,$ | $\\, 0.7190 \\,$ | $\\, 0.7224 \\,$ |\n| $\\, 0.6 \\,$ | $\\, 0.7422 \\,$ | $\\, 0.7454 \\,$ | $\\, 0.7486 \\,$ | $\\, 0.7517 \\,$ | $\\, 0.7549 \\,$ |\n| $\\, 0.7 \\,$ | $\\, 0.7734 \\,$ | $\\, 0.7764 \\,$ | $\\, 0.7794 \\,$ | $\\, 0.7823 \\,$ | $\\, 0.7852 \\,$ |" :question/worked-solution "Let $X$ denote the student's math test result, and let $Y$ denote the student's history test result. We want to find \n\n$$\nP( X+Y > 150).\n$$\n\nSince $X$ and $Y$ are  independent random variables such that $X\\sim N(67,12^2)$ and $Y\\sim N(73,9^2),$ then \n\n$$\n\\begin{aligned}X+Y & ∼N(67+73,{12}^{2}+{9}^{2}) \\\\  & ∼N(140,225).\\end{aligned}\n$$\n\n \nSo, the variable $X+Y$ is normally distributed with mean $\\mu = 140$ and standard deviation $\\sigma = \\sqrt{225} = 15.$\n\nIn order to find $P(X+Y > 150),$ we convert $X+Y$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X+Y>150) & =P(Z>\\frac{150-140}{15}) \\\\  & ≈P(Z>0.67) \\\\  & =1-P(Z\\le 0.67) \\\\  & =1-Φ(0.67)\\end{aligned}\n$$\n\nUsing the $z$-table, we see that\n\n$$\n\\Phi(0.67 )\\approx 0.7486.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X+Y>150) & ≈1-Φ(0.67) \\\\  & ≈1-0.7486 \\\\  & =0.2514.\\end{aligned}\n$$\n\nSo, we conclude that the probability that the combined score is more than $150$ is $0.2514.$" :db/ensure [:question/validate]} {:db/id "question-90934eb8-cbb7-5339-bda4-6344e0c742e6" :question/id #uuid "90934eb8-cbb7-5339-bda4-6344e0c742e6" :question/math-academy-id "q-109665" :question/problem "If ${X}_{1}∼N(5,2)$ and ${X}_{2}∼N(-3,1),$ then what is the distribution of $Y={X}_{1}-{X}_{2}?$" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$  then \n\n$$\n{X}_{1}-{X}_{2}∼N({\\mu }_{1}-{\\mu }_{2},{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}).\n$$\n\nHowever, in this case, we don't know whether ${X}_{1}$ and ${X}_{2}$ are independent. Therefore, we do not have enough information to determine the answer." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-dd2c0ad4-1e0f-5cbd-b6a5-6c4830e415f5"] :db/ensure [:question/validate]} {:db/id "answer-field-dd2c0ad4-1e0f-5cbd-b6a5-6c4830e415f5" :answer-field/id #uuid "dd2c0ad4-1e0f-5cbd-b6a5-6c4830e415f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a9413a8d-e556-5c15-b263-6120fbb190a3" :answer-field/choices ["answer-b153f443-3c37-5e66-a40c-0aaa929873ed" "answer-0a8b4c31-7756-582a-92fe-208bb81d3ab0" "answer-53ec63a3-dff5-5725-a8ff-302bc5145296" "answer-b3a7faf2-5f10-55a5-80c6-0ecc491ca7c3" "answer-a9413a8d-e556-5c15-b263-6120fbb190a3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b153f443-3c37-5e66-a40c-0aaa929873ed" :answer/id #uuid "b153f443-3c37-5e66-a40c-0aaa929873ed" :answer/type :answer.type/math :answer/value "N(2,1)" :db/ensure [:answer/validate]} {:db/id "answer-0a8b4c31-7756-582a-92fe-208bb81d3ab0" :answer/id #uuid "0a8b4c31-7756-582a-92fe-208bb81d3ab0" :answer/type :answer.type/math :answer/value "N(2,3)" :db/ensure [:answer/validate]} {:db/id "answer-53ec63a3-dff5-5725-a8ff-302bc5145296" :answer/id #uuid "53ec63a3-dff5-5725-a8ff-302bc5145296" :answer/type :answer.type/math :answer/value "N(8,1)" :db/ensure [:answer/validate]} {:db/id "answer-b3a7faf2-5f10-55a5-80c6-0ecc491ca7c3" :answer/id #uuid "b3a7faf2-5f10-55a5-80c6-0ecc491ca7c3" :answer/type :answer.type/math :answer/value "N(8,3)" :db/ensure [:answer/validate]} {:db/id "answer-a9413a8d-e556-5c15-b263-6120fbb190a3" :answer/id #uuid "a9413a8d-e556-5c15-b263-6120fbb190a3" :answer/type :answer.type/text :answer/value "Not enough information to determine the answer" :db/ensure [:answer/validate]} {:db/id 17592186162289 :question/problem "If ${X}_{1}∼N(12,9)$ and ${X}_{2}∼N(9,3)$ are independent, then what is the distribution of $Y={X}_{1}+{X}_{2}?$" :question/worked-solution "Recall that if ${X}_{1}$ and ${X}_{2}$ are independent random variables, where ${X}_{1}∼N({\\mu }_{1},{\\sigma }_{1}^{2})$ and ${X}_{2}∼N({\\mu }_{2},{\\sigma }_{2}^{2}),$ then \n\n$$\nY={X}_{1}+{X}_{2}∼N({\\mu }_{1}+{\\mu }_{2},{\\sigma }_{1}^{2}+{\\sigma }_{2}^{2}).\n$$\n\nSince ${X}_{1}$ and ${X}_{2}$ are independent, we have \n\n$$\n\\begin{aligned}Y={X}_{1}+{X}_{2} & ∼N(12+9,9+3) \\\\  & ∼N(21,12).\\end{aligned}\n$$\n\n \n\nTherefore, $Y∼N(21,12).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186158936 :answer-field/correct "answer-adf50c19-419a-5069-aa55-bcfda4b6231f" :answer-field/choices ["answer-8d011fd5-024d-5731-89c2-345940d33063" "answer-bcc90f9b-7930-5d2b-8c50-47b3870a7594" "answer-adf50c19-419a-5069-aa55-bcfda4b6231f" "answer-48acf9ec-ef99-5492-aeb0-fc20b099b754"] :db/ensure [:answer-field/validate]} {:db/id "answer-8d011fd5-024d-5731-89c2-345940d33063" :answer/id #uuid "8d011fd5-024d-5731-89c2-345940d33063" :answer/type :answer.type/math :answer/value "N(108,12)" :db/ensure [:answer/validate]} {:db/id "answer-bcc90f9b-7930-5d2b-8c50-47b3870a7594" :answer/id #uuid "bcc90f9b-7930-5d2b-8c50-47b3870a7594" :answer/type :answer.type/math :answer/value "N(108,90)" :db/ensure [:answer/validate]} {:db/id "answer-adf50c19-419a-5069-aa55-bcfda4b6231f" :answer/id #uuid "adf50c19-419a-5069-aa55-bcfda4b6231f" :answer/type :answer.type/math :answer/value "N(21,12)" :db/ensure [:answer/validate]} {:db/id "answer-48acf9ec-ef99-5492-aeb0-fc20b099b754" :answer/id #uuid "48acf9ec-ef99-5492-aeb0-fc20b099b754" :answer/type :answer.type/math :answer/value "N(21,90)" :db/ensure [:answer/validate]} {:db/id "question-eb127e88-57e6-5641-837e-22d6b55ce8da" :question/id #uuid "eb127e88-57e6-5641-837e-22d6b55ce8da" :question/math-academy-id "q-109648" :qu