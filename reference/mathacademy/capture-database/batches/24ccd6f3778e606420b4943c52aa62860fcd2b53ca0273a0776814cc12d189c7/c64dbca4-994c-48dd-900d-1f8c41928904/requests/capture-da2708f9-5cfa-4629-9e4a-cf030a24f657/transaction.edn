a877-6320-59fa-87b4-66c1735e4266" :step/content "question-3a2c219c-ccba-5ebb-bb19-2884f7df2aa0" :step/next "step-33f7ee40-34fa-5548-8ce8-002f6236503b" :db/ensure [:step/validate]} {:db/id "step-33f7ee40-34fa-5548-8ce8-002f6236503b" :step/id #uuid "33f7ee40-34fa-5548-8ce8-002f6236503b" :step/content "question-cb98fa7b-b950-5181-aa33-ef959985aa54" :step/next "step-bb6f0075-20ba-517a-b001-600e3aec1da8" :db/ensure [:step/validate]} {:db/id "step-bb6f0075-20ba-517a-b001-600e3aec1da8" :step/id #uuid "bb6f0075-20ba-517a-b001-600e3aec1da8" :step/content "question-3ee32b00-5c8a-53d2-a621-006bbc7ec2f3" :step/next "step-1fc66cc0-0ba2-5441-b1ec-20054c281e0b" :db/ensure [:step/validate]} {:db/id "step-1fc66cc0-0ba2-5441-b1ec-20054c281e0b" :step/id #uuid "1fc66cc0-0ba2-5441-b1ec-20054c281e0b" :step/content "question-67c34d9e-6885-5f7c-abc2-3a7d77eaaea5" :db/ensure [:step/validate]} [:db/retract 17592186076286 :answer-field/choices 17592186076288] [:db/retract 17592186076286 :answer-field/choices 17592186076289] [:db/retract 17592186076286 :answer-field/choices 17592186076290] [:db/retract 17592186076286 :answer-field/choices 17592186076291] [:db/retract 17592186076286 :answer-field/choices 17592186076287] {:db/id 17592186078579 :knowledge-point/questions ["question-7e49ab95-b651-5531-ac5c-90e4392b7705" "question-6bdf897b-5216-5fe0-b918-3faeb980f813"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7e49ab95-b651-5531-ac5c-90e4392b7705" :question/id #uuid "7e49ab95-b651-5531-ac5c-90e4392b7705" :question/math-academy-id "q-31686" :question/problem "Solve for $x$ where $\\frac{5-x}{3}=7x-15.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $7$:\n\n$$\n\\begin{aligned}\\frac{5-x}{3} & =7x-15 \\\\ 3(\\frac{5-x}{3}) & =3(7x-15) \\\\ \\cancel{3}(\\frac{5-x}{\\cancel{3}}) & =21x-45 \\\\ 5-x & =21x-45\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}5-x & =21x-45 \\\\ 5-x+x & =21x-45+x \\\\ 5 & =22x-45 \\\\ 5+45 & =22x-45+45 \\\\ 50 & =22x \\\\ \\frac{50}{22} & =\\frac{22x}{22} \\\\ \\frac{25}{11} & =\\frac{\\cancel{22}x}{\\cancel{22}} \\\\ x & =\\frac{25}{11}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e82146a9-b8b1-5e83-aeec-05796f3d090e"] :db/ensure [:question/validate]} {:db/id "answer-field-e82146a9-b8b1-5e83-aeec-05796f3d090e" :answer-field/id #uuid "e82146a9-b8b1-5e83-aeec-05796f3d090e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aaf85b04-9f5b-52ba-8d31-f3f78566da82" :answer-field/choices ["answer-290bfc84-e444-5079-8d18-8f0f58f4d969" "answer-37c0081c-72ea-53b5-830f-01d721471189" "answer-aaf85b04-9f5b-52ba-8d31-f3f78566da82" "answer-95839550-f140-5f9e-a1e5-8aa2c82702bc" "answer-b62f4a13-9b15-5386-ab05-2a22a1b14183"] :db/ensure [:answer-field/validate]} {:db/id "answer-290bfc84-e444-5079-8d18-8f0f58f4d969" :answer/id #uuid "290bfc84-e444-5079-8d18-8f0f58f4d969" :answer/type :answer.type/math :answer/value "x=\\frac{11}{25}" :db/ensure [:answer/validate]} {:db/id "answer-37c0081c-72ea-53b5-830f-01d721471189" :answer/id #uuid "37c0081c-72ea-53b5-830f-01d721471189" :answer/type :answer.type/math :answer/value "x=\\frac{22}{45}" :db/ensure [:answer/validate]} {:db/id "answer-aaf85b04-9f5b-52ba-8d31-f3f78566da82" :answer/id #uuid "aaf85b04-9f5b-52ba-8d31-f3f78566da82" :answer/type :answer.type/math :answer/value "x=\\frac{25}{11}" :db/ensure [:answer/validate]} {:db/id "answer-95839550-f140-5f9e-a1e5-8aa2c82702bc" :answer/id #uuid "95839550-f140-5f9e-a1e5-8aa2c82702bc" :answer/type :answer.type/math :answer/value "x=\\frac{45}{11}" :db/ensure [:answer/validate]} {:db/id "answer-b62f4a13-9b15-5386-ab05-2a22a1b14183" :answer/id #uuid "b62f4a13-9b15-5386-ab05-2a22a1b14183" :answer/type :answer.type/math :answer/value "x=\\frac{45}{22}" :db/ensure [:answer/validate]} {:db/id 17592186078578 :knowledge-point/questions ["question-fcf291ca-08c9-536b-b233-ba6182878dc7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078918 :question/problem "Solve the equation $\\frac{8y+5}{3}=6y.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $3$:\n\n$$\n\\begin{aligned}\\frac{8y+5}{3} & =6y \\\\ 3(\\frac{8y+5}{3}) & =3\\cdot 6y \\\\ \\cancel{3}\\cdot (\\frac{8y+5}{\\cancel{3}}) & =18y \\\\ 8y+5 & =18y\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}8y+5 & =18y \\\\ 8y+5-8y & =18y-8y \\\\ 5 & =10y \\\\ \\frac{5}{10} & =\\frac{10y}{10} \\\\ \\frac{1}{2} & =y\\end{aligned}\n$$\n\nThus, $y=\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186076286 :answer-field/correct "answer-ed96295d-5ba0-5de6-8e42-1e7af9fedd21" :answer-field/choices ["answer-5c693399-2537-5d16-bc08-d75a0b068d68" "answer-53f63b04-ee5f-56b2-8bfc-7edc1aa13c63" "answer-ed96295d-5ba0-5de6-8e42-1e7af9fedd21" "answer-3d10803c-dc1c-51df-b6d9-3387aaeb47cd" "answer-698c317a-d46e-576c-8db8-e08affaa9755"] :db/ensure [:answer-field/validate]} {:db/id "answer-5c693399-2537-5d16-bc08-d75a0b068d68" :answer/id #uuid "5c693399-2537-5d16-bc08-d75a0b068d68" :answer/type :answer.type/math :answer/value "y=2" :db/ensure [:answer/validate]} {:db/id "answer-53f63b04-ee5f-56b2-8bfc-7edc1aa13c63" :answer/id #uuid "53f63b04-ee5f-56b2-8bfc-7edc1aa13c63" :answer/type :answer.type/math :answer/value "y=5" :db/ensure [:answer/validate]} {:db/id "answer-ed96295d-5ba0-5de6-8e42-1e7af9fedd21" :answer/id #uuid "ed96295d-5ba0-5de6-8e42-1e7af9fedd21" :answer/type :answer.type/math :answer/value "y=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-3d10803c-dc1c-51df-b6d9-3387aaeb47cd" :answer/id #uuid "3d10803c-dc1c-51df-b6d9-3387aaeb47cd" :answer/type :answer.type/math :answer/value "y=\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-698c317a-d46e-576c-8db8-e08affaa9755" :answer/id #uuid "698c317a-d46e-576c-8db8-e08affaa9755" :answer/type :answer.type/math :answer/value "y=\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "question-fcf291ca-08c9-536b-b233-ba6182878dc7" :question/id #uuid "fcf291ca-08c9-536b-b233-ba6182878dc7" :question/math-academy-id "q-44329" :question/problem "Solve for $t$ where $-2t=\\frac{4-6t}{9}.$" :question/worked-solution "First, we clear the rational expression by multiplying the equation through by $9$:\n\n$$\n\\begin{aligned}-2t & =\\frac{4-6t}{9} \\\\ \\frac{4-6t}{9} & =-2t \\\\ 9(\\frac{4-6t}{9}) & =9(-2t) \\\\ \\cancel{9}(\\frac{4-6t}{\\cancel{9}}) & =-18t \\\\ 4-6t & =-18t\\end{aligned}\n$$\n\nThen, we solve the remaining equation using the addition and multiplication principles:\n\n$$\n\\begin{aligned}4-6t & =-18t \\\\ 4-6t+6t & =-18t+6t \\\\ 4 & =-12t \\\\ -12t & =4 \\\\ \\frac{-12t}{-12} & =\\frac{4}{-12} \\\\ \\frac{\\cancel{-12}t}{\\cancel{-12}} & =-\\frac{1}{3} \\\\ t & =-\\frac{1}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3de57bae-a1f3-5ae4-b2cb-ef29b2469101"] :db/ensure [:question/validate]} {:db/id "answer-field-3de57bae-a1f3-5ae4-b2cb-ef29b2469101" :answer-field/id #uuid "3de57bae-a1f3-5ae4-b2cb-ef29b2469101" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ee350b8-cb7d-5d53-877e-b380e44154a4" :answer-field/choices ["answer-0fb757b8-2149-526a-af68-c96954680eb4" "answer-9ee350b8-cb7d-5d53-877e-b380e44154a4" "answer-a4d94021-52b3-52e5-909c-4f0d63cad22c" "answer-7d66aa7f-6693-5615-970b-c7da91b05cd5" "answer-9c952b49-23cd-5299-ab3b-0fd0ba05087c"] :db/ensure [:answer-field/validate]} {:db/id "answer-0fb757b8-2149-526a-af68-c96954680eb4" :answer/id #uuid "0fb757b8-2149-526a-af68-c96954680eb4" :answer/type :answer.type/math :answer/value "t=-3" :db/ensure [:answer/validate]} {:db/id "answer-9ee350b8-cb