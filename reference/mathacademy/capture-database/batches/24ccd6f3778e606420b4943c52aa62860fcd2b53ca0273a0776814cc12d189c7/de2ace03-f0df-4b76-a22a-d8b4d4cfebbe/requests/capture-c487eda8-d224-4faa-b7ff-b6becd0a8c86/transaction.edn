d-580e-a3a3-9f5f5dbbcb12" :step/id #uuid "f185e663-04ed-580e-a3a3-9f5f5dbbcb12" :step/content 17592186360468 :step/next "step-fc96510b-0ed6-52fe-9312-00ff093a85b6" :db/ensure [:step/validate]} {:db/id "step-fc96510b-0ed6-52fe-9312-00ff093a85b6" :step/id #uuid "fc96510b-0ed6-52fe-9312-00ff093a85b6" :step/content 17592186244025 :db/ensure [:step/validate]} {:db/id "activity-1a6e8abe-f458-5f9e-be48-4dd594b1e0e4" :activity/id #uuid "1a6e8abe-f458-5f9e-be48-4dd594b1e0e4" :activity/title "Invertible Functions" :activity/type :activity.type/review :activity/scope 17592186049731 :activity/course 17592186046647 :activity/steps ["step-51114073-60cf-523a-978f-1aa6471e7316" "step-e51b8e10-e997-539f-b84d-64f26a00ff50" "step-05667c2e-8371-5d18-b8f4-28e387601b58"] :activity/first-step "step-51114073-60cf-523a-978f-1aa6471e7316" :db/ensure [:activity/validate]} {:db/id "step-51114073-60cf-523a-978f-1aa6471e7316" :step/id #uuid "51114073-60cf-523a-978f-1aa6471e7316" :step/content 17592186124951 :step/next "step-e51b8e10-e997-539f-b84d-64f26a00ff50" :db/ensure [:step/validate]} {:db/id "step-e51b8e10-e997-539f-b84d-64f26a00ff50" :step/id #uuid "e51b8e10-e997-539f-b84d-64f26a00ff50" :step/content 17592186323749 :step/next "step-05667c2e-8371-5d18-b8f4-28e387601b58" :db/ensure [:step/validate]} {:db/id "step-05667c2e-8371-5d18-b8f4-28e387601b58" :step/id #uuid "05667c2e-8371-5d18-b8f4-28e387601b58" :step/content 17592186125195 :db/ensure [:step/validate]} {:db/id 17592186133895 :knowledge-point/questions ["question-f892a9d1-561b-51b8-a283-3b892f8dc787" "question-f61d70b2-c968-54d9-b087-2ae80ef01b89" "question-7d76f5fb-ba28-5b32-904d-cbb78731c152" "question-2d6a46ea-e810-5ed6-9d15-12e3845c1e76"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f892a9d1-561b-51b8-a283-3b892f8dc787" :question/id #uuid "f892a9d1-561b-51b8-a283-3b892f8dc787" :question/math-academy-id "q-126559" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)=y$ and $Q(x,y)=x$\n\nII. $P(x,y)=-y$ and $Q(x,y)=0$\n\nIII. $P(x,y)=y+{e}^{x}$ and $Q(x,y)=\\frac{y}{3}$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0\\ne 1.\n$$\n\n- Pair II gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Pair III does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-1\\ne 1.\n$$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5bca7dbd-ffdc-5cb7-822a-009c4eccd416"] :db/ensure [:question/validate]} {:db/id "answer-field-5bca7dbd-ffdc-5cb7-822a-009c4eccd416" :answer-field/id #uuid "5bca7dbd-ffdc-5cb7-822a-009c4eccd416" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-629d2292-4c54-5f88-aab2-977463ff11a9" :answer-field/choices ["answer-58122a63-9d7f-591f-b933-aa93158e184f" "answer-57095cd5-869a-52ea-98e5-ae49745a6cf3" "answer-536431fa-077c-5c63-8e52-e720d5f25ad5" "answer-629d2292-4c54-5f88-aab2-977463ff11a9" "answer-88b89e38-2d3c-57a2-ad5a-0be2309918a1"] :db/ensure [:answer-field/validate]} {:db/id "answer-58122a63-9d7f-591f-b933-aa93158e184f" :answer/id #uuid "58122a63-9d7f-591f-b933-aa93158e184f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-57095cd5-869a-52ea-98e5-ae49745a6cf3" :answer/id #uuid "57095cd5-869a-52ea-98e5-ae49745a6cf3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-536431fa-077c-5c63-8e52-e720d5f25ad5" :answer/id #uuid "536431fa-077c-5c63-8e52-e720d5f25ad5" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-629d2292-4c54-5f88-aab2-977463ff11a9" :answer/id #uuid "629d2292-4c54-5f88-aab2-977463ff11a9" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-88b89e38-2d3c-57a2-ad5a-0be2309918a1" :answer/id #uuid "88b89e38-2d3c-57a2-ad5a-0be2309918a1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-f61d70b2-c968-54d9-b087-2ae80ef01b89" :question/id #uuid "f61d70b2-c968-54d9-b087-2ae80ef01b89" :question/math-academy-id "q-126561" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)={e}^{y}$ and $Q(x,y)={e}^{x}$\n\nII. $P(x,y)=\\operatorname{arctan}⁡y$ and $Q(x,y)=y$\n\nIII. $P(x,y)=-y$ and $Q(x,y)=y$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}={e}^{y}$\nand\n$\\frac{∂Q}{∂x}={e}^{x},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}={e}^{x}-{e}^{y}\\ne 1.\n$$\n\n- Pair II does *not* give the required area.  Notice that \n$\\frac{∂P}{∂y}=\\frac{1}{1+{y}^{2}}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-\\frac{1}{1+{y}^{2}}\\ne 1.\n$$\n\n- Pair III gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-041132e8-077c-5837-a79f-29852017427b"] :db/ensure [:question/validate]} {:db/id "answer-field-041132e8-077c-5837-a79f-29852017427b" :answer-field/id #uuid "041132e8-077c-5837-a79f-29852017427b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ccdd078-e1bf-5bbc-be52-fd411e22349d" :answer-field/choices ["answer-5caa2745-f258-5524-bce2-0cee34f7a871" "answer-81e94b1a-bd75-573d-86e7-53f24a85af34" "answer-fbcde265-3bb2-5d78-a137-ab8cf1e73dcd" "answer-7484861d-d825-59f3-b995-2fbd5e8a6934" "answer-8ccdd078-e1bf-5bbc-be52-fd411e22349d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5caa2745-f258-5524-bce2-0cee34f7a871" :answer/id #uuid "5caa2745-f258-5524-bce2-0cee34f7a871" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-81e94b1a-bd75-573d-86e7-53f24a85af34" :answer/id #uuid "81e94b1a-bd75-573d-86e7-53f24a85af34" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-fbcde265-3bb2-5d78-a137-ab8cf1e73dcd" :answer/id #uuid "fbcde265-3bb2-5d78-a137-ab8cf1e73dcd" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-7484861d-d825-59f3-b995-2fbd5e8a6934" :answer/id #uuid "7484861d-d825-59f3-b995-2fbd5e8a6934" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-8ccdd078-e1bf-5bbc-be52-fd411e22349d" :answer/id #uuid "8ccdd078-e1bf-5bbc-be52-fd411e22349d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-7d76f5fb-ba28-5b32-904d-cbb78731c152" :question/id #uuid "7d76f5fb-ba28-5b32-904d-cbb78731c152" :question/math-academy-id "q-126570" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nI. $P(x,y)=-\\frac{y}{3}$ and $Q(x,y)=\\frac{x}{3}$\n\nII. $P(x,y)=y\\operatorname{sin}⁡x$ and $Q(x,y)=x-\\operatorname{cos}⁡x$\n\nIII. $P(x,y)={y}^{2}$ and $Q(x,y)={x}^{2}$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=-\\frac{1}{3}$\nand\n$\\frac{∂Q}{∂x}=\\frac{1}{3},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=\\frac{2}{3}\\ne 1.\n$$\n\n- Pair II gives the required area. Notice that\n$\\frac{∂P}{∂y}=\\operatorname{sin}⁡x$\nand\n$\\frac{∂Q}{∂x}=1+\\operatorname{sin}⁡x$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Pair III does *not* give the required area. Notice that \n$\\frac{∂P}{∂y}=2y$\nand\n$\\frac{∂Q}{∂x}=2x,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2x-2y\\ne 1.\n$$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8b9b5f42-303d-5796-888d-e11c20c8cac2"] :db/ensure [:question/validate]} {:db/id "answer-field-8b9b5f42-303d-5796-888d-e11c20c8cac2" :answer-field/id #uuid "8b9b5f42-303d-5796-888d-e11c20c8cac2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-48d9075b-21bf-518c-85e4-b52a39ca48c3" :answer-field/choices ["answer-18fdc301-b9e6-5380-b576-f756ad837d6e" "answer-79fb9fa0-3c09-5639-8f51-38fc29793534" "answer-aee8fb2f-93bf-5e56-b3ef-5f91d5ed3421" "answer-48d9075b-21bf-518c-85e4-b52a39ca48c3" "answer-71000db5-1bfa-5f19-88d0-bfac331f25f7"] :db/ensure [:answer-field/validate]} {:db/id "answer-18fdc301-b9e6-5380-b576-f756ad837d6e" :answer/id #uuid "18fdc301-b9e6-5380-b576-f756ad837d6e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-79fb9fa0-3c09-5639-8f51-38fc29793534" :answer/id #uuid "79fb9fa0-3c09-5639-8f51-38fc29793534" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-aee8fb2f-93bf-5e56-b3ef-5f91d5ed3421" :answer/id #uuid "aee8fb2f-93bf-5e56-b3ef-5f91d5ed3421" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-48d9075b-21bf-518c-85e4-b52a39ca48c3" :answer/id #uuid "48d9075b-21bf-518c-85e4-b52a39ca48c3" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-71000db5-1bfa-5f19-88d0-bfac331f25f7" :answer/id #uuid "71000db5-1bfa-5f19-88d0-bfac331f25f7" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-2d6a46ea-e810-5ed6-9d15-12e3845c1e76" :question/id #uuid "2d6a46ea-e810-5ed6-9d15-12e3845c1e76" :question/math-academy-id "q-126572" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}F\\cdot \\text{d}r\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the vector field $F(x,y)?$\n\nI. $F(x,y)=⟨{e}^{y}-y,\\,x{e}^{y}⟩$\n\nII. $F(x,y)=⟨{e}^{y},\\,0⟩$\n\nIII. $F(x,y)=⟨-\\frac{y}{5}+{x}^{7},\\,\\frac{6x}{5}⟩$" :question/worked-solution "According to Green's theorem, if $F(x,y)=⟨P(x,y),\\,Q(x,y)⟩,$ where\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y \\\\  & ={∮}_{C}F\\cdot \\text{d}r\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Vector field I give the required area. In this case,\n$\\frac{∂P}{∂y}={e}^{y}-1$\nand\n$\\frac{∂Q}{∂x}={e}^{y},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Vector field II does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-{e}^{y}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}={e}^{y}\\ne 1.\n$$\n\n- Vector field III does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-\\frac{1}{5}$\nand\n$\\frac{∂Q}{∂x}=\\frac{6}{5},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=\\frac{7}{5}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ea3760f2-d10c-5617-a3f3-b8335b0f89d2"] :db/ensure [:question/validate]} {:db/id "answer-field-ea3760f2-d10c-5617-a3f3-b8335b0f89d2" :answer-field/id #uuid "ea3760f2-d10c-5617-a3f3-b8335b0f89d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2cd6483d-ff42-5dc9-bf60-d49b491388dd" :answer-field/choices ["answer-be4e7b49-1ac4-5e2f-92d1-d5c217fc797f" "answer-2cd6483d-ff42-5dc9-bf60-d49b491388dd" "answer-dd5e01ff-4835-5778-92d5-2ea89a8203bd" "answer-683ef1d0-3a45-5daf-a0c7-cf2a0f6be250" "answer-5000cc2e-e84a-572e-94b0-98de14def1b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-be4e7b49-1ac4-5e2f-92d1-d5c217fc797f" :answer/id #uuid "be4e7b49-1ac4-5e2f-92d1-d5c217fc797f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-2cd6483d-ff42-5dc9-bf60-d49b491388dd" :answer/id #uuid "2cd6483d-ff42-5dc9-bf60-d49b491388dd" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-dd5e01ff-4835-5778-92d5-2ea89a8203bd" :answer/id #uuid "dd5e01ff-4835-5778-92d5-2ea89a8203bd" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-683ef1d0-3a45-5daf-a0c7-cf2a0f6be250" :answer/id #uuid "683ef1d0-3a45-5daf-a0c7-cf2a0f6be250" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-5000cc2e-e84a-572e-94b0-98de14def1b1" :answer/id #uuid "5000cc2e-e84a-572e-94b0-98de14def1b1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186133897 :knowledge-point/questions ["question-8d510a6d-f96b-598f-8f2e-31efe6a6d012"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8d510a6d-f96b-598f-8f2e-31efe6a6d012" :question/id #uuid "8d510a6d-f96b-598f-8f2e-31efe6a6d012" :question/math-academy-id "q-126869" :question/problem "![](images/c5/c5eb703c2812d82848bb5a1639c2840c4abf9318b988087e2216d9881137da72.png)\n\nConsider the region $D$ enclosed by the curve $C={C}_{1}\\cup {C}_{2},$ where \n\n- ${C}_{1}$ is parametrized by ${r}_{1}(t)={t}^{4}\\,i+{t}^{3}\\,j$ for $t\\in [-1,1],$ and\n\n- ${C}_{2}$ is parametrized by ${r}_{2}(t)=\\,i-t\\,j$ for $t\\in [-1,1].$\n\nUse Green's theorem to find the area of the region." :question/worked-solution "First, let $P(x,y)=-y$ and $Q(x,y)=0.$ \n\nOur simple, piecewise-smooth, closed path $C$ is negatively oriented, and   \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=0-(-1)=1.\n$$\n\nSo, according to Green's theorem, we can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & =-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nNotice that we have to take the line integral with a minus sign since our path is negatively oriented.\n\nSubstituting $P(x,y)=-y$ and $Q(x,y)=0,$ we get\n\n$$\n-{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y={∮}_{C}y\\,\\text{d}x.\n$$\n\n \n\nThe derivatives of ${r}_{1}(t)$ and ${r}_{2}(t)$ are as follows:\n\n$$\n\\begin{aligned}{C}_{1}:\\, & {r}_{1}^{′}(t)=4{t}^{3}\\,i+3{t}^{2}\\,j \\\\ {C}_{2}:\\, & {r}_{2}^{′}(t)=-j\\end{aligned}\n$$\n\nTherefore, we can write our line integral as\n\n$$\n\\begin{aligned}{∮}_{C}y\\,\\text{d}x & ={∮}_{{C}_{1}\\cup {C}_{2}}y\\,dx \\\\  & ={∮}_{{C}_{1}}y\\,dx+{∮}_{{C}_{2}}y\\,dx \\\\  & ={\\int }_{-1}^{1}{t}^{3}\\cdot 4{t}^{3}\\,\\text{d}t+{\\int }_{-1}^{1}(-t)\\cdot 0\\,\\text{d}t \\\\  & =4{\\int }_{-1}^{1}{t}^{6}\\,\\text{d}t-0 \\\\  & =4[\\frac{{t}^{7}}{7}]_{-1}^{1} \\\\  & =4\\cdot \\frac{2}{7} \\\\  & =\\frac{8}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-75e5af1d-ea30-5a37-83f7-6f329a1a3e3b"] :db/ensure [:question/validate]} {:db/id "answer-field-75e5af1d-ea30-5a37-83f7-6f329a1a3e3b" :answer-field/id #uuid "75e5af1d-ea30-5a37-83f7-6f329a1a3e3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4d3daaf-a309-5e5e-a768-d106755411ae" :answer-field/choices ["answer-39c3f228-f440-590e-ba1b-1c90c3c03432" "answer-9ca6978e-a4e1-5484-ba5d-364891771b9a" "answer-3670e0fc-6d65-5c69-a28a-c92456932444" "answer-7521cafa-fe34-5822-be40-921e53636206" "answer-b4d3daaf-a309-5e5e-a768-d106755411ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-39c3f228-f440-590e-ba1b-1c90c3c03432" :answer/id #uuid "39c3f228-f440-590e-ba1b-1c90c3c03432" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-9ca6978e-a4e1-5484-ba5d-364891771b9a" :answer/id #uuid "9ca6978e-a4e1-5484-ba5d-364891771b9a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-3670e0fc-6d65-5c69-a28a-c92456932444" :answer/id #uuid "3670e0fc-6d65-5c69-a28a-c92456932444" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-7521cafa-fe34-5822-be40-921e53636206" :answer/id #uuid "7521cafa-fe34-5822-be40-921e53636206" :answer/type :answer.type/math :answer/value "\\frac{4\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-b4d3daaf-a309-5e5e-a768-d106755411ae" :answer/id #uuid "b4d3daaf-a309-5e5e-a768-d106755411ae" :answer/type :answer.type/math :answer/value "\\frac{8}{7}" :db/ensure [:answer/validate]} {:db/id "activity-12a6cff2-46b1-567e-9f11-e66243bf7f66" :activity/id #uuid "12a6cff2-46b1-567e-9f11-e66243bf7f66" :activity/title "Using Green's Theorem to Calculate Area" :activity/type :activity.type/review :activity/scope 17592186050567 :activity/course 17592186046669 :activity/steps ["step-dfd8a0a5-40c9-5766-af65-8e056002dbdd" "step-5743bec9-9fc8-52ec-8926-6eb7cdd3fcc1" "step-0413025a-a6cd-5d63-8b51-14b775eb02ec" "step-badd52ef-742f-5ca8-9362-960bb5d0223a" "step-69e681a0-9b8e-5a97-98d5-a5c36baee9a4"] :activity/first-step "step-dfd8a0a5-40c9-5766-af65-8e056002dbdd" :db/ensure [:activity/validate]} {:db/id "step-dfd8a0a5-40c9-5766-af65-8e056002dbdd" :step/id #uuid "dfd8a0a5-40c9-5766-af65-8e056002dbdd" :step/content "question-f892a9d1-561b-51b8-a283-3b892f8dc787" :step/next "step-5743bec9-9fc8-52ec-8926-6eb7cdd3fcc1" :db/ensure [:step/validate]} {:db/id "step-5743bec9-9fc8-52ec-8926-6eb7cdd3fcc1" :step/id #uuid "5743bec9-9fc8-52ec-8926-6eb7cdd3fcc1" :step/content "question-f61d70b2-c968-54d9-b087-2ae80ef01b89" :step/next "step-0413025a-a6cd-5d63-8b51-14b775eb02ec" :db/ensure [:step/validate]} {:db/id "step-0413025a-a6cd-5d63-8b51-14b775eb02ec" :step/id #uuid "0413025a-a6cd-5d63-8b51-14b775eb02ec" :step/content "question-7d76f5fb-ba28-5b32-904d-cbb78731c152" :step/next "step-badd52ef-742f-5ca8-9362-960bb5d0223a" :db/ensure [:step/validate]} {:db/id "step-badd52ef-742f-5ca8-9362-960bb5d0223a" :step/id #uuid "badd52ef-742f-5ca8-9362-960bb5d0223a" :step/content "question-2d6a46ea-e810-5ed6-9d15-12e3845c1e76" :step/next "step-69e681a0-9b8e-5a97-98d5-a5c36baee9a4" :db/ensure [:step/validate]} {:db/id "step-69e681a0-9b8e-5a97-98d5-a5c36baee9a4" :step/id #uuid "69e681a0-9b8e-5a97-98d5-a5c36baee9a4" :step/content "question-8d510a6d-f96b-598f-8f2e-31efe6a6d012" :db/ensure [:step/validate]} {:db/id 17592186124635 :knowledge-point/questions ["question-37a7cf0c-c997-508e-b401-3de9aab0cfc4" "question-5b96b52d-bf1b-5917-8deb-641e04d4e427"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124634 :knowledge-point/questions ["question-4b9e706a-7ed7-5d91-bf85-9f21697ce716"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124641 :knowledge-point/questions ["question-9d9ea65f-7a2f-51be-a1e0-0db423dddcbc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124642 :knowledge-point/questions ["question-bb3ee0d5-b81d-5d00-99b5-5160f6c70200"] :db/ensure [:knowledge-point/validate]} {:db/id "question-37a7cf0c-c997-508e-b401-3de9aab0cfc4" :question/id #uuid "37a7cf0c-c997-508e-b401-3de9aab0cfc4" :question/math-academy-id "q-159255" :question/problem "![](images/8a/8a50bd2b35b22d2ee71094467f1310f9c6c1510323e8106c13cf6fc45f2cbb9f.png)\n\nConsider the set $M=[1,3]\\cup [4,6]$ and the points $A,$ $B,$ and $C,$ shown above. Which of the following statements are true?\n\nI. $A$ is an interior point of the set $M$\n\nII. $B$ is a boundary point of the set $M$\n\nIII. $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}\\in R$ is the set of points whose distance from ${x}_{0}$ is *smaller than* $\\delta :$ \n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nA neighborhood of ${x}_{0}$ is given by the open interval $({x}_{0}-\\delta ,{x}_{0}+\\delta ),$ shown below.\n\n![](images/f8/f889352f25e7936d0e5ea76585a979efbb301da61f7e99a937e979af93ee0664.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is false. The point $A$ is *not* an interior point of $M$ since any neighborhood of $A$ contains at least one point *outside* the set.\n\n![](images/0a/0a438012465859bc6406bb52a6bebeb13803760b429996fc7e4963b415c8f23d.png)\n\n- Statement II is true. The point $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$\n\n![](images/bb/bb374c99d9da28e40ad87dda6bf86dc6ca273a491e4faccb7dee043a104d0eba.png)\n\n- Statement III is false. The point $C$ is *not* an interior point of $M$ since any neighborhood of $C$ contains at least one point *outside* the set.\n\n![](images/a5/a58fac3f854cd89429090b7fd10140d26d2097372586cd5f130353bff338b97c.png)\n\nTherefore, the correct answer is 'II only.'" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-710f49fa-4048-565e-bf85-ef63e229f768"] :db/ensure [:question/validate]} {:db/id "answer-field-710f49fa-4048-565e-bf85-ef63e229f768" :answer-field/id #uuid "710f49fa-4048-565e-bf85-ef63e229f768" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c641877a-fed0-5681-9ab6-c88e09b14311" :answer-field/choices ["answer-a07e75f8-1749-5ef7-a7ad-3f9a237b7f12" "answer-294aa78c-5727-5350-8592-0c1b6971026c" "answer-1761a7c3-ecef-5d09-a98b-e38fb750a0ca" "answer-14858488-0968-53ee-a271-6b2c706d24f6" "answer-c641877a-fed0-5681-9ab6-c88e09b14311"] :db/ensure [:answer-field/validate]} {:db/id "answer-a07e75f8-1749-5ef7-a7ad-3f9a237b7f12" :answer/id #uuid "a07e75f8-1749-5ef7-a7ad-3f9a237b7f12" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-294aa78c-5727-5350-8592-0c1b6971026c" :answer/id #uuid "294aa78c-5727-5350-8592-0c1b6971026c" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-1761a7c3-ecef-5d09-a98b-e38fb750a0ca" :answer/id #uuid "1761a7c3-ecef-5d09-a98b-e38fb750a0ca" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-14858488-0968-53ee-a271-6b2c706d24f6" :answer/id #uuid "14858488-0968-53ee-a271-6b2c706d24f6" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-c641877a-fed0-5681-9ab6-c88e09b14311" :answer/id #uuid "c641877a-fed0-5681-9ab6-c88e09b14311" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "question-5b96b52d-bf1b-5917-8deb-641e04d4e427" :question/id #uuid "5b96b52d-bf1b-5917-8deb-641e04d4e427" :question/math-academy-id "q-159273" :question/problem "![](images/d6/d60800fb2b986aac396a278599651b9ee116339d4b5bbab9a7a6ae5e16f6a3b2.png)\n\nConsider the set $M=(-2,0)\\cup \\{1\\}$ and the points $A,$ $B,$ and $C,$ shown above. Which of the following statements are true?\n\nI. $A$ is a boundary  point of the set $M$\n\nII. $B$ is an interior point of the set $M$\n\nIII. $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}\\in R$ is the set of points whose distance from ${x}_{0}$ is *smaller than* $\\delta :$ \n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nA neighborhood of ${x}_{0}$ is given by the open interval $({x}_{0}-\\delta ,{x}_{0}+\\delta ),$ shown below.\n\n![](images/f8/f889352f25e7936d0e5ea76585a979efbb301da61f7e99a937e979af93ee0664.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. The point $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n![](images/b5/b57ab5bfd2f0d685e2918c2f62601b9439475e7f29e2fbdabb912c43411a829f.png)\n\n- Statement II is false. The point $B$ is *not* an interior point of $M$ since any neighborhood of $B$ contains at least one point *outside* the set.\n\n![](images/f5/f5a2dc9c52c0c24b2f611cfd3b5aa23fb068249780fd66d80039b7d548c6151a.png)\n\n- Statement III is false. The point $C$ is *not* an interior point because every open neighborhood of $C$ contains points that belong to $M$ and points that do not belong to $M.$\n\n![](images/3b/3b47e92adb22c8d68cf94f947870d185ef907f9ca17c7427843e03fbcdab21cc.png)\n\nTherefore, the correct answer is 'I only.'" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ebcf0a61-7a0a-54a8-a956-1b1805e9c49e"] :db/ensure [:question/validate]} {:db/id "answer-field-ebcf0a61-7a0a-54a8-a956-1b1805e9c49e" :answer-field/id #uuid "ebcf0a61-7a0a-54a8-a956-1b1805e9c49e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d1bf783b-f62d-5544-9b6f-a82c84002604" :answer-field/choices ["answer-09cb1613-161a-586b-b39d-fa7423b2674b" "answer-e3286edb-fba7-50de-891f-e39e3ed3ca07" "answer-d1bf783b-f62d-5544-9b6f-a82c84002604" "answer-c478305f-33cc-5b5e-b111-aa60762b3eda" "answer-df46c36c-d040-5e4b-9960-bbaee7fd9b73"] :db/ensure [:answer-field/validate]} {:db/id "answer-09cb1613-161a-586b-b39d-fa7423b2674b" :answer/id #uuid "09cb1613-161a-586b-b39d-fa7423b2674b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-e3286edb-fba7-50de-891f-e39e3ed3ca07" :answer/id #uuid "e3286edb-fba7-50de-891f-e39e3ed3ca07" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-d1bf783b-f62d-5544-9b6f-a82c84002604" :answer/id #uuid "d1bf783b-f62d-5544-9b6f-a82c84002604" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-c478305f-33cc-5b5e-b111-aa60762b3eda" :answer/id #uuid "c478305f-33cc-5b5e-b111-aa60762b3eda" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-df46c36c-d040-5e4b-9960-bbaee7fd9b73" :answer/id #uuid "df46c36c-d040-5e4b-9960-bbaee7fd9b73" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-4b9e706a-7ed7-5d91-bf85-9f21697ce716" :question/id #uuid "4b9e706a-7ed7-5d91-bf85-9f21697ce716" :question/math-academy-id "q-64996" :question/problem "![](images/74/74bbb3351cf6720121c6ce0fbe8f99fa1c65560edbe5e547ecfd007835a50b89.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\nI. $A$ is a boundary point of the set $M$\n\nII. $B$ is a boundary point of the set $M$\n\nIII. $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/17/173a69de844fac6141fe2fb3c695d070750b9df29b91364f66a0c1da28998428.png)\n\n$$\n\n$$\n\n- Statement I is true. The point $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement II is true. The point $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement III is true. Indeed, $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is 'I, II, and III'." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b40b396f-afbe-53ce-beb3-0c52eeeedd6c"] :db/ensure [:question/validate]} {:db/id "answer-field-b40b396f-afbe-53ce-beb3-0c52eeeedd6c" :answer-field/id #uuid "b40b396f-afbe-53ce-beb3-0c52eeeedd6c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-75523642-a8e9-5c20-af07-5cbd062f55b0" :answer-field/choices ["answer-d56409a1-dd3e-5129-b768-c2b620b4e283" "answer-f5e84243-54fd-5434-a031-9ceaa4099bad" "answer-75523642-a8e9-5c20-af07-5cbd062f55b0" "answer-13cc753c-b562-5cf3-bdc0-1f0bef4bdf5b" "answer-1fe93c47-e51a-5c46-96e7-9cb51c84cb58"] :db/ensure [:answer-field/validate]} {:db/id "answer-d56409a1-dd3e-5129-b768-c2b620b4e283" :answer/id #uuid "d56409a1-dd3e-5129-b768-c2b620b4e283" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f5e84243-54fd-5434-a031-9ceaa4099bad" :answer/id #uuid "f5e84243-54fd-5434-a031-9ceaa4099bad" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-75523642-a8e9-5c20-af07-5cbd062f55b0" :answer/id #uuid "75523642-a8e9-5c20-af07-5cbd062f55b0" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-13cc753c-b562-5cf3-bdc0-1f0bef4bdf5b" :answer/id #uuid "13cc753c-b562-5cf3-bdc0-1f0bef4bdf5b" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-1fe93c47-e51a-5c46-96e7-9cb51c84cb58" :answer/id #uuid "1fe93c47-e51a-5c46-96e7-9cb51c84cb58" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-9d9ea65f-7a2f-51be-a1e0-0db423dddcbc" :question/id #uuid "9d9ea65f-7a2f-51be-a1e0-0db423dddcbc" :question/math-academy-id "q-158557" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA=\\{(x,y)\\in {R}^{2}:y\\le 2-x\\},\\,∂A=\\{(x,y)\\in {R}^{2}:y=2-x\\}.\n$$\n\nWhich of the following statements are true?\n\nI. The point $P(0,2)$ lies on the boundary of $A$\n\nII. The point $P(0,2)$ belongs to $A$\n\nIII. The point $Q(2,1)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie on or below the line $y=2-x.$ A sketch of this region is shown below:\n\n![](images/ab/ab319d348d61ba7d247b21553de0625f8c4f9906800102a6f8e11264472cab13.png)\n\nLet's add the points $P(0,2)$ and $Q(2,1)$ and some neighborhoods of these points to our diagram.\n\n![](images/9e/9ebf116e1093aa4861de907ed9256ec52e4a5b3e0765a6ab66cc8ee0b40e1769.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(0,2)$ satisfy the equation $y=2-x.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. The coordinates of $P(0,2)$ satisfy the inequality $y\\le 2-x.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I and II only.'" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7274d4e1-605f-55f2-a572-987750313a00"] :db/ensure [:question/validate]} {:db/id "answer-field-7274d4e1-605f-55f2-a572-987750313a00" :answer-field/id #uuid "7274d4e1-605f-55f2-a572-987750313a00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7c7d6717-571c-5bc0-bcde-f66a2294e7d7" :answer-field/choices ["answer-7c7d6717-571c-5bc0-bcde-f66a2294e7d7" "answer-758ca936-3175-5b9a-a7f2-59300deea008" "answer-8b448c1a-f75e-567b-bba2-0c1b4f290c15" "answer-4a2b1785-6973-5d01-9c9d-ae0b2c5f9ef6" "answer-7933ca3c-2fce-5e9a-b5e4-ac56a04b4c95"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c7d6717-571c-5bc0-bcde-f66a2294e7d7" :answer/id #uuid "7c7d6717-571c-5bc0-bcde-f66a2294e7d7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-758ca936-3175-5b9a-a7f2-59300deea008" :answer/id #uuid "758ca936-3175-5b9a-a7f2-59300deea008" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-8b448c1a-f75e-567b-bba2-0c1b4f290c15" :answer/id #uuid "8b448c1a-f75e-567b-bba2-0c1b4f290c15" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-4a2b1785-6973-5d01-9c9d-ae0b2c5f9ef6" :answer/id #uuid "4a2b1785-6973-5d01-9c9d-ae0b2c5f9ef6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-7933ca3c-2fce-5e9a-b5e4-ac56a04b4c95" :answer/id #uuid "7933ca3c-2fce-5e9a-b5e4-ac56a04b4c95" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186125216 :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA=\\{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{2}\\le 1\\},\\,∂A=\\{(x,y)\\in {R}^{2}:\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{2}=1\\}.\n$$\n\nWhich of the following statements are true?\n\nI. The point $Q(-1,\\frac{2}{\\sqrt{3}})$ lies on the boundary of $A$\n\nII. The point $P(0.5,0.5)$ belongs to $A$\n\nIII. The point $Q(-1,\\frac{2}{\\sqrt{3}})$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$ \n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie on or inside the ellipse $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{2}\\le 1.$ A sketch of this region is shown below:\n\n![](images/04/0485539c238417b1b93904f9a0e889198c64ff29a4629636094d33048d0bdd32.png)\n\nLet's add the points $P(0.5,0.5)$ and $Q(-1,\\frac{2}{\\sqrt{3}})$ and some neighborhoods of these points to our diagram.\n\n![](images/04/0485539c238417b1b93904f9a0e889198c64ff29a4629636094d33048d0bdd32.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $Q(-1,\\frac{2}{\\sqrt{3}})$ satisfy the equation $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{2}=1.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. The coordinates of $P(0.5,0.5)$  satisfy the inequality $\\frac{{x}^{2}}{3}+\\frac{{y}^{2}}{2}\\le 1.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. Every open neighborhood of $Q$ contains points that belong to $A$ and points that do not belong to $A.$ The point $Q$ is a boundary point for the given set.\n\nTherefore, the correct answer is 'I and II only.'" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186123896 :answer-field/correct 17592186123901 :db/ensure [:answer-field/validate]} {:db/id "question-bb3ee0d5-b81d-5d00-99b5-5160f6c70200" :question/id #uuid "bb3ee0d5-b81d-5d00-99b5-5160f6c70200" :question/math-academy-id "q-158732" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA=\\{(x,y)\\in {R}^{2}:y>\\frac{1}{3}{x}^{2}\\},\\,∂A=\\{(x,y)\\in {R}^{2}:y=\\frac{1}{3}{x}^{2}\\}.\n$$\n\nWhich of the following statements are true?\n\nI. The point $P(0,1)$ lies on the boundary of $A$\n\nII. The point $P(0,1)$ belongs to $A$\n\nIII. The point $Q(2,\\frac{4}{3})$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nThe set $A$ consists of all points that lie to the left of the parabola ${y}^{2}=4x.$ A sketch of this region is shown below:\n\n![](images/8f/8f182873a8384097b56152284e67189e36f0a79a0b2bbda8926a2f8279db7ddd.png)\n\nLet's add the points $P(0,1)$ and $Q(2,\\frac{4}{3})$ and some neighborhoods of these points to our diagram.\n\n![](images/66/66c8cb59cceadd43e3c4316925f1dd624c2e77a6ec547c9f9a1a02846bb537fb.png)\n\nLet's examine the statements in turn.\n\n- Statement I is false. The coordinates of $P(0,1)$ do not satisfy the equation $y=\\frac{1}{3}{x}^{2}.$ Hence, $P$ does not lie on the boundary of the set.\n\n- Statement II is true. The coordinates of $P(0,1)$ satisfy the inequality $y>\\frac{1}{3}{x}^{2}.$ Hence, $P$ lies in the set $A.$\n\n- Statement III is false. Every open neighborhood of $Q$ contains points that belong to $A$ and points that do not belong to $A.$ The point $Q$ is a boundary point for the given set.\n\nTherefore, the correct answer is 'II only.'" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-374832d9-2085-56d7-b8ec-ffec23c86eb2"] :db/ensure [:question/validate]} {:db/id "answer-field-374832d9-2085-56d7-b8ec-ffec23c86eb2" :answer-field/id #uuid "374832d9-2085-56d7-b8ec-ffec23c86eb2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bfee3041-1ea5-5d62-91c3-245076039872" :answer-field/choices ["answer-98623bac-9b60-5778-9acc-c9d6970dc0f0" "answer-e6644f14-7427-5268-94b7-90f4b0379b06" "answer-3c23e6dc-98f3-56bf-9dec-3f31245a5e57" "answer-bfee3041-1ea5-5d62-91c3-245076039872" "answer-1db30fee-97ef-5c82-b9f7-e59f87e2d6b4"] :db/ensure [:answer-field/validate]} {:db/id "answer-98623bac-9b60-5778-9acc-c9d6970dc0f0" :answer/id #uuid "98623bac-9b60-5778-9acc-c9d6970dc0f0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-e6644f14-7427-5268-94b7-90f4b0379b06" :answer/id #uuid "e6644f14-7427-5268-94b7-90f4b0379b06" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-3c23e6dc-98f3-56bf-9dec-3f31245a5e57" :answer/id #uuid "3c23e6dc-98f3-56bf-9dec-3f31245a5e57" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-bfee3041-1ea5-5d62-91c3-245076039872" :answer/id #uuid "bfee3041-1ea5-5d62-91c3-245076039872" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-1db30fee-97ef-5c82-b9f7-e59f87e2d6b4" :answer/id #uuid "1db30fee-97ef-5c82-b9f7-e59f87e2d6b4" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186179730 :knowledge-point/questions ["question-a8478761-1f4e-5c9d-a634-3425df7889e5"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179592 :question/problem "Which of the following is equivalent to $(k+1)!$ for any $k \\geq 2?$\n\nI. $(k+1) \\cdot k \\cdot (k-1)$\n\nII. $(k+1) \\cdot k \\cdot (k-1)!$\n\nIII. $(k+1) \\cdot k$" :db/ensure [:question/validate]} {:db/id 17592186179659 :knowledge-point/questions ["question-14a5adf6-2b28-57e0-9971-452cd7b77a19" "question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186179660 :knowledge-point/questions ["question-8948ecd0-03b4-5bf8-9bc2-1467d2b61321"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a8478761-1f4e-5c9d-a634-3425df7889e5" :question/id #uuid "a8478761-1f4e-5c9d-a634-3425df7889e5" :question/math-academy-id "q-124490" :question/problem "Which of the following is equivalent to $(k-1)!$ for any $k\\ge 4?$" :question/worked-solution "Using the definition of factorial, we have \n\n$$\n(k-1)!=(k-1)\\cdot (k-2)\\cdot (k-3)\\cdot (k-4)\\cdot \\,⋯\\,\\cdot 2\\cdot 1.\n$$\n\nNow, applying the factorial definition to all but the first two factors, we get\n\n$$\n\\begin{aligned}(k-1)! & =(k-1)\\cdot (k-2)\\cdot \\overset{(k-3)!}{\\overset{⏞}{(k-3)\\cdot (k-4)\\cdot \\,⋯\\,\\cdot 2\\cdot 1}} \\\\  & =(k-1)\\cdot (k-2)\\cdot (k-3)!\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fc7e4408-fbc9-5f18-bf91-1f672892b184"] :db/ensure [:question/validate]} {:db/id "answer-field-fc7e4408-fbc9-5f18-bf91-1f672892b184" :answer-field/id #uuid "fc7e4408-fbc9-5f18-bf91-1f672892b184" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7e8a9640-d5a2-5af9-85c3-9df541069e3f" :answer-field/choices ["answer-f0444fa0-516b-5c9b-82d3-af49b3feedc9" "answer-8408d7f7-986c-53a7-8060-d0e712a043fb" "answer-7e8a9640-d5a2-5af9-85c3-9df541069e3f" "answer-ea8b46c1-8a21-5eb2-9692-195052a1df74" "answer-ac845e78-dfdf-51a2-9552-e2548a59f300"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0444fa0-516b-5c9b-82d3-af49b3feedc9" :answer/id #uuid "f0444fa0-516b-5c9b-82d3-af49b3feedc9" :answer/type :answer.type/math :answer/value "(k-1)\\cdot (k-2)" :db/ensure [:answer/validate]} {:db/id "answer-8408d7f7-986c-53a7-8060-d0e712a043fb" :answer/id #uuid "8408d7f7-986c-53a7-8060-d0e712a043fb" :answer/type :answer.type/math :answer/value "(k-1)\\cdot (k-2)\\cdot (k-3)" :db/ensure [:answer/validate]} {:db/id "answer-7e8a9640-d5a2-5af9-85c3-9df541069e3f" :answer/id #uuid "7e8a9640-d5a2-5af9-85c3-9df541069e3f" :answer/type :answer.type/math :answer/value "(k-1)\\cdot (k-2)\\cdot (k-3)!" :db/ensure [:answer/validate]} {:db/id "answer-ea8b46c1-8a21-5eb2-9692-195052a1df74" :answer/id #uuid "ea8b46c1-8a21-5eb2-9692-195052a1df74" :answer/type :answer.type/math :answer/value "(k-1)\\cdot (k-2)\\cdot \\,⋯\\,\\cdot 4" :db/ensure [:answer/validate]} {:db/id "answer-ac845e78-dfdf-51a2-9552-e2548a59f300" :answer/id #uuid "ac845e78-dfdf-51a2-9552-e2548a59f300" :answer/type :answer.type/math :answer/value "(k-1)\\cdot (k-3)!" :db/ensure [:answer/validate]} {:db/id "question-14a5adf6-2b28-57e0-9971-452cd7b77a19" :question/id #uuid "14a5adf6-2b28-57e0-9971-452cd7b77a19" :question/math-academy-id "q-122060" :question/problem "Given that $n\\ge 2$ is an integer, simplify $\\frac{(n-2)!(n+1)!}{(n!)^{2}}.$" :question/worked-solution "First, notice the following:\n\n$$\n\\begin{aligned}n! & =n\\cdot (n-1)\\cdot (n-2)! \\\\ (n+1)! & =(n+1)\\cdot n!\\end{aligned}\n$$\n\nThen, we cancel the $(n-2)!$ and $n!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-2)!(n+1)!}{(n!)^{2}} & =\\frac{(n-2)!(n+1)!}{n!\\cdot n!} \\\\  & =\\frac{(n-2)!\\cdot (n+1)\\cdot n!}{n!\\cdot n\\cdot (n-1)\\cdot (n-2)!} \\\\  & =\\frac{\\cancel{(n-2)!}\\cdot (n+1)\\cdot \\cancel{n!}}{\\cancel{n!}\\cdot n\\cdot (n-1)\\cdot \\cancel{(n-2)!}} \\\\  & =\\frac{n+1}{n(n-1)}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8bebaea8-1ea1-5395-8e7f-1a00a59795e8"] :db/ensure [:question/validate]} {:db/id "answer-field-8bebaea8-1ea1-5395-8e7f-1a00a59795e8" :answer-field/id #uuid "8bebaea8-1ea1-5395-8e7f-1a00a59795e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-46ff1943-a30d-5d55-b989-75cc58c7e295" :answer-field/choices ["answer-b209c69e-bcd5-5443-a258-9983e0b3b3ad" "answer-1b2bd303-a67e-5430-8fae-4d34f010ab2f" "answer-723c2e65-97d9-5e30-8f62-7d0b9ac25429" "answer-46ff1943-a30d-5d55-b989-75cc58c7e295" "answer-90c4d29d-6f34-5c61-80e8-b426e05a3941"] :db/ensure [:answer-field/validate]} {:db/id "answer-b209c69e-bcd5-5443-a258-9983e0b3b3ad" :answer/id #uuid "b209c69e-bcd5-5443-a258-9983e0b3b3ad" :answer/type :answer.type/math :answer/value "\\frac{1}{n(n+1)}" :db/ensure [:answer/validate]} {:db/id "answer-1b2bd303-a67e-5430-8fae-4d34f010ab2f" :answer/id #uuid "1b2bd303-a67e-5430-8fae-4d34f010ab2f" :answer/type :answer.type/math :answer/value "\\frac{1}{n(n-1)}" :db/ensure [:answer/validate]} {:db/id "answer-723c2e65-97d9-5e30-8f62-7d0b9ac25429" :answer/id #uuid "723c2e65-97d9-5e30-8f62-7d0b9ac25429" :answer/type :answer.type/math :answer/value "\\frac{n(n+1)}{n-1}" :db/ensure [:answer/validate]} {:db/id "answer-46ff1943-a30d-5d55-b989-75cc58c7e295" :answer/id #uuid "46ff1943-a30d-5d55-b989-75cc58c7e295" :answer/type :answer.type/math :answer/value "\\frac{n+1}{n(n-1)}" :db/ensure [:answer/validate]} {:db/id "answer-90c4d29d-6f34-5c61-80e8-b426e05a3941" :answer/id #uuid "90c4d29d-6f34-5c61-80e8-b426e05a3941" :answer/type :answer.type/math :answer/value "\\frac{{n}^{2}-1}{n}" :db/ensure [:answer/validate]} {:db/id "question-c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/id #uuid "c9507815-c165-5ef4-b7fc-1303dcd3fdc4" :question/math-academy-id "q-122049" :question/problem "Given that $n\\ge 0$ is an integer, simplify $\\frac{(n+3)!}{n!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+3)!=(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot n!\n$$\n\nThen, we cancel the $n!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+3)!}{n!} & =\\frac{(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot n!}{n!} \\\\  & =\\frac{(n+3)\\cdot (n+2)\\cdot (n+1)\\cdot \\cancel{n!}}{\\cancel{n!}} \\\\  & =(n+1)(n+2)(n+3)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-96838955-c6ff-5947-a190-f1ef251ea9e1"] :db/ensure [:question/validate]} {:db/id "answer-field-96838955-c6ff-5947-a190-f1ef251ea9e1" :answer-field/id #uuid "96838955-c6ff-5947-a190-f1ef251ea9e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c6e71356-751a-5b88-bb29-4ab075926417" :answer-field/choices ["answer-5263ce43-a391-52ed-a678-006a7cae38af" "answer-c6e71356-751a-5b88-bb29-4ab075926417" "answer-e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7" "answer-ed427fb4-d7c8-5799-866d-63deafd02049" "answer-c58cfce8-e369-5afc-b6e2-87bc6a2d0b7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-5263ce43-a391-52ed-a678-006a7cae38af" :answer/id #uuid "5263ce43-a391-52ed-a678-006a7cae38af" :answer/type :answer.type/math :answer/value "(n+1)(n+2)" :db/ensure [:answer/validate]} {:db/id "answer-c6e71356-751a-5b88-bb29-4ab075926417" :answer/id #uuid "c6e71356-751a-5b88-bb29-4ab075926417" :answer/type :answer.type/math :answer/value "(n+1)(n+2)(n+3)" :db/ensure [:answer/validate]} {:db/id "answer-e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7" :answer/id #uuid "e76e9a1a-cb09-51eb-bef3-1b4f0aeb11c7" :answer/type :answer.type/math :answer/value "(n+2)(n+3)" :db/ensure [:answer/validate]} {:db/id "answer-ed427fb4-d7c8-5799-866d-63deafd02049" :answer/id #uuid "ed427fb4-d7c8-5799-866d-63deafd02049" :answer/type :answer.type/math :answer/value "\\frac{1}{(n+1)(n+2)(n+3)}" :db/ensure [:answer/validate]} {:db/id "answer-c58cfce8-e369-5afc-b6e2-87bc6a2d0b7d" :answer/id #uuid "c58cfce8-e369-5afc-b6e2-87bc6a2d0b7d" :answer/type :answer.type/math :answer/value "n(n+2)(n+3)" :db/ensure [:answer/validate]} {:db/id "question-8948ecd0-03b4-5bf8-9bc2-1467d2b61321" :question/id #uuid "8948ecd0-03b4-5bf8-9bc2-1467d2b61321" :question/math-academy-id "q-79305" :question/problem "Given that $m\\ge 1$ is an integer, simplify $\\frac{(m+2)!}{(m+2)\\text{ }(m-1)!}=$" :question/worked-solution "First, we notice that\n\n$$\n(m+2)!=(m+2)(m+1)(m)(m-1)!\n$$\n\nThen, we can cancel the $(m+2)$ and $(m-1)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(m+2)!}{(m+2)\\text{ }(m-1)!} & =\\frac{(m+2)\\cdot (m+1)\\cdot m\\cdot (m-1)!}{(m+2)\\cdot (m-1)!} \\\\  & =\\frac{\\cancel{(m+2)}\\cdot (m+1)\\cdot m\\cdot \\cancel{(m-1)!}}{\\cancel{(m+2)}\\cdot \\cancel{(m-1)!}} \\\\  & =(m+1)\\cdot m \\\\  & ={m}^{2}+m\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3466d9a9-8d93-5dce-a113-2a97b5048512"] :db/ensure [:question/validate]} {:db/id "answer-field-3466d9a9-8d93-5dce-a113-2a97b5048512" :answer-field/id #uuid "3466d9a9-8d93-5dce-a113-2a97b5048512" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5fef2f0c-7256-578e-b6f0-95a297ff2ae3" :answer-field/choices ["answer-1584deb7-4764-5143-864e-22d0f7584563" "answer-ea990394-d45f-5925-aedd-845ccc8ee565" "answer-59ec1f07-6b74-59a0-bd26-0c900add0f71" "answer-5fef2f0c-7256-578e-b6f0-95a297ff2ae3" "answer-6b2ad49e-66ce-572e-83ee-22eb483326c7"] :db/ensure [:answer-field/validate]} {:db/id "answer-1584deb7-4764-5143-864e-22d0f7584563" :answer/id #uuid "1584deb7-4764-5143-864e-22d0f7584563" :answer/type :answer.type/math :answer/value "\\frac{m+1}{m}" :db/ensure [:answer/validate]} {:db/id "answer-ea990394-d45f-5925-aedd-845ccc8ee565" :answer/id #uuid "ea990394-d45f-5925-aedd-845ccc8ee565" :answer/type :answer.type/math :answer/value "\\frac{m}{m+1}" :db/ensure [:answer/validate]} {:db/id "answer-59ec1f07-6b74-59a0-bd26-0c900add0f71" :answer/id #uuid "59ec1f07-6b74-59a0-bd26-0c900add0f71" :answer/type :answer.type/math :answer/value "{m}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-5fef2f0c-7256-578e-b6f0-95a297ff2ae3" :answer/id #uuid "5fef2f0c-7256-578e-b6f0-95a297ff2ae3" :answer/type :answer.type/math :answer/value "{m}^{2}+m" :db/ensure [:answer/validate]} {:db/id "answer-6b2ad49e-66ce-572e-83ee-22eb483326c7" :answer/id #uuid "6b2ad49e-66ce-572e-83ee-22eb483326c7" :answer/type :answer.type/math :answer/value "{m}^{2}+m+1" :db/ensure [:answer/validate]} {:db/id 17592186179863 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186133934 :knowledge-point/questions ["question-2e69b893-dca1-5a00-a0a1-d673b040380f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2e69b893-dca1-5a00-a0a1-d673b040380f" :question/id #uuid "2e69b893-dca1-5a00-a0a1-d673b040380f" :question/math-academy-id "q-44983" :question/problem "What is the explicit formula for the $n$th term of the geometric sequence given by\n\n$$\n{a}_{n+1}=-\\frac{3{a}_{n}}{5},\\,\\,{a}_{1}=\\frac{10}{3},\\,\\,n\\ge 1?\n$$" :question/worked-solution "The explicit formula for the $n$th term of a geometric sequence is\n\n$$\n{a}_{n}={a}_{1}\\cdot {r}^{n-1},\\,n\\ge 1.\n$$\n\nSo, we must determine the first term ${a}_{1}$ and the common ratio $r.$\n\nWe are given that the first term is ${a}_{1}=\\frac{10}{3}.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\n{a}_{n+1}=r\\cdot {a}_{n}\n$$\n\n \n\nFrom the above, we see that $r=-\\frac{3}{5}.$\n\nSubstituting ${a}_{1}=\\frac{10}{3}$ and $r=-\\frac{3}{5}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =\\frac{10}{3}\\cdot {(-\\frac{3}{5})}^{n-1}.\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{10}{3}\\cdot {(-\\frac{3}{5})}^{n-1} \\\\  & =\\frac{10}{3}\\cdot {(-\\frac{3}{5})}^{-1}\\cdot {(-\\frac{3}{5})}^{n} \\\\  & =\\frac{10}{3}\\cdot (-\\frac{5}{3})\\cdot {(-\\frac{3}{5})}^{n} \\\\  & =-\\frac{10\\cdot 5}{3\\cdot 3}\\cdot {(-\\frac{3}{5})}^{n} \\\\  & =-\\frac{50}{9}\\cdot {(-\\frac{3}{5})}^{n}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\n{a}_{n}=-\\frac{50}{9}\\cdot {(-\\frac{3}{5})}^{n},\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7ee0f6b8-65be-5837-90b0-536ef0f796f6"] :db/ensure [:question/validate]} {:db/id "answer-field-7ee0f6b8-65be-5837-90b0-536ef0f796f6" :answer-field/id #uuid "7ee0f6b8-65be-5837-90b0-536ef0f796f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-89d2e657-a6a8-59f6-8532-79d2b8c65bf3" :answer-field/choices ["answer-897b3115-f689-53ea-8b8f-579dc209df81" "answer-039ad15f-aa14-5833-b492-297d15ec8481" "answer-89d2e657-a6a8-59f6-8532-79d2b8c65bf3" "answer-af390c1b-5127-52ed-92c3-72c04d0ab64c" "answer-6cb8b6d5-6d81-50d2-85a0-0755a8afe296"] :db/ensure [:answer-field/validate]} {:db/id "answer-897b3115-f689-53ea-8b8f-579dc209df81" :answer/id #uuid "897b3115-f689-53ea-8b8f-579dc209df81" :answer/type :answer.type/math :answer/value "{a}_{n}=-2\\cdot {(-\\frac{3}{5})}^{n},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-039ad15f-aa14-5833-b492-297d15ec8481" :answer/id #uuid "039ad15f-aa14-5833-b492-297d15ec8481" :answer/type :answer.type/math :answer/value "{a}_{n}=-\\frac{10}{3}\\cdot {(-\\frac{3}{5})}^{n},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-89d2e657-a6a8-59f6-8532-79d2b8c65bf3" :answer/id #uuid "89d2e657-a6a8-59f6-8532-79d2b8c65bf3" :answer/type :answer.type/math :answer/value "{a}_{n}=-\\frac{50}{9}\\cdot {(-\\frac{3}{5})}^{n},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-af390c1b-5127-52ed-92c3-72c04d0ab64c" :answer/id #uuid "af390c1b-5127-52ed-92c3-72c04d0ab64c" :answer/type :answer.type/math :answer/value "{a}_{n}=2\\cdot {(-\\frac{3}{5})}^{n},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-6cb8b6d5-6d81-50d2-85a0-0755a8afe296" :answer/id #uuid "6cb8b6d5-6d81-50d2-85a0-0755a8afe296" :answer/type :answer.type/math :answer/value "{a}_{n}=\\frac{10}{3}\\cdot {(-\\frac{3}{5})}^{n},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id 17592186133935 :knowledge-point/questions ["question-072376b1-6413-51af-98f6-95587e3acbf3"] :db/ensure [:knowledge-point/validate]} {:db/id "question-072376b1-6413-51af-98f6-95587e3acbf3" :question/id #uuid "072376b1-6413-51af-98f6-95587e3acbf3" :question/math-academy-id "q-44986" :question/problem "What is the explicit formula for the $n$th term of the geometric sequence given by\n\n$$\nf(n+1)=\\frac{f(n)}{2},\\,\\,f(1)=\\frac{1}{2},\\,\\,n\\ge 1?\n$$" :question/worked-solution "First, let's rewrite our recursive formula, as follows:\n\n$$\n\\begin{aligned}f(n+1)=\\frac{f(n)}{2}=\\frac{1}{2}f(n)\\end{aligned}\n$$\n\nThe explicit formula for the $n$th term of a geometric sequence is\n\n$$\nf(n)=f(1)\\cdot {r}^{n-1},\\,n\\ge 1.\n$$\n\nSo, we must determine the first term $f(1)$ and the common ratio $r.$\n\nWe are given that the first term is $f(1)=\\frac{1}{2}.$ To find the common ratio, we compare the given sequence with the general recursive formula for a geometric sequence:\n\n$$\nf(n+1)=r\\cdot f(n)\n$$\n\n \n\nFrom the above, we see that $r=\\frac{1}{2}.$\n\nSubstituting $f(1)=\\frac{1}{2}$ and $r=\\frac{1}{2}$ into the formula for the $n$th term, we obtain\n\n$$\n\\begin{aligned}f(n) & =f(1)\\cdot {r}^{n-1} \\\\  & =\\frac{1}{2}\\cdot {(\\frac{1}{2})}^{n-1}.\\end{aligned}\n$$\n\nWe can simplify further by manipulating the exponents as follows:\n\n$$\n\\begin{aligned}f(n) & =\\frac{1}{2}\\cdot {(\\frac{1}{2})}^{n-1} \\\\  & =\\frac{1}{2}\\cdot {(\\frac{1}{2})}^{-1}\\cdot {(\\frac{1}{2})}^{n} \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{1}\\cdot {(\\frac{1}{2})}^{n} \\\\  & =\\frac{1}{{2}^{n}}\\end{aligned}\n$$\n\nTherefore, the formula for the $n$th term is\n\n$$\nf(n)=\\frac{1}{{2}^{n}},\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9947e7a8-c30a-59fb-977d-989052168899"] :db/ensure [:question/validate]} {:db/id "answer-field-9947e7a8-c30a-59fb-977d-989052168899" :answer-field/id #uuid "9947e7a8-c30a-59fb-977d-989052168899" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ca374ed-64c4-537e-9df7-38e602f55fd2" :answer-field/choices ["answer-955d3208-98c9-5cd1-a334-320a252d84ee" "answer-2ca374ed-64c4-537e-9df7-38e602f55fd2" "answer-679a841f-b122-5f85-a654-2b11ecc33553" "answer-4a4e66bc-7a14-5aba-9a6a-a17f030fcf54" "answer-4301ea6f-1c49-5f63-a937-a2c2069919c4"] :db/ensure [:answer-field/validate]} {:db/id "answer-955d3208-98c9-5cd1-a334-320a252d84ee" :answer/id #uuid "955d3208-98c9-5cd1-a334-320a252d84ee" :answer/type :answer.type/math :answer/value "f(n)=\\frac{1}{{2}^{n-1}},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-2ca374ed-64c4-537e-9df7-38e602f55fd2" :answer/id #uuid "2ca374ed-64c4-537e-9df7-38e602f55fd2" :answer/type :answer.type/math :answer/value "f(n)=\\frac{1}{{2}^{n}},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-679a841f-b122-5f85-a654-2b11ecc33553" :answer/id #uuid "679a841f-b122-5f85-a654-2b11ecc33553" :answer/type :answer.type/math :answer/value "f(n)=\\frac{1}{{4}^{n}},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-4a4e66bc-7a14-5aba-9a6a-a17f030fcf54" :answer/id #uuid "4a4e66bc-7a14-5aba-9a6a-a17f030fcf54" :answer/type :answer.type/math :answer/value "f(n)={2}^{n-1},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-4301ea6f-1c49-5f63-a937-a2c2069919c4" :answer/id #uuid "4301ea6f-1c49-5f63-a937-a2c2069919c4" :answer/type :answer.type/math :answer/value "f(n)={2}^{n},\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id 17592186133933 :knowledge-point/questions ["question-715d8ed0-87e8-5b42-a40f-879649ce1b0d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-715d8ed0-87e8-5b42-a40f-879649ce1b0d" :question/id #uuid "715d8ed0-87e8-5b42-a40f-879649ce1b0d" :question/math-academy-id "q-44995" :question/problem "The formula for the $n$th term of a geometric sequence is $f(n)=3\\cdot {2}^{n+1}$ for $n\\ge 1.$  What is the recursive formula for this sequence?" :question/worked-solution "The recursive formula for a geometric sequence is\n\n$$\nf(n+1)=r\\cdot f(n).\n$$\n\nTo complete the formula, we must determine the common ratio $r$ and state the first term ${a}_{1}.$ The first two terms are\n\n$$\n\\begin{aligned}f(1) & =3\\cdot {2}^{1+1}=3\\cdot 4=12, \\\\ f(2) & =3\\cdot {2}^{2+1}=3\\cdot 8=24.\\end{aligned}\n$$\n\nHence, the common ratio is\n\n$$\n\\begin{aligned}r & =\\frac{f(2)}{f(1)}=\\frac{24}{12}=2.\\end{aligned}\n$$\n\nTherefore, the recursive formula for the geometric  sequence is\n\n$$\nf(n+1)=2f(n),\\,f(1)=12,\\,n\\ge 1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-66bae46d-9a2a-5dcb-a638-46a59f8b52be"] :db/ensure [:question/validate]} {:db/id "answer-field-66bae46d-9a2a-5dcb-a638-46a59f8b52be" :answer-field/id #uuid "66bae46d-9a2a-5dcb-a638-46a59f8b52be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2b933277-b836-55ae-9b21-a1a99505fdc8" :answer-field/choices ["answer-2b933277-b836-55ae-9b21-a1a99505fdc8" "answer-9c6698c3-0e55-55e1-a6c5-bc756af04932" "answer-71f17afc-b6a1-50e6-8314-cf085641ebf2" "answer-227897ea-9dd1-5b96-9c06-008a8a2d99f1" "answer-3a562547-fbeb-5f3b-853f-ddbd84961e5d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b933277-b836-55ae-9b21-a1a99505fdc8" :answer/id #uuid "2b933277-b836-55ae-9b21-a1a99505fdc8" :answer/type :answer.type/math :answer/value "f(n+1)=2f(n),\\,f(1)=12,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-9c6698c3-0e55-55e1-a6c5-bc756af04932" :answer/id #uuid "9c6698c3-0e55-55e1-a6c5-bc756af04932" :answer/type :answer.type/math :answer/value "f(n+1)=2f(n),\\,f(1)=3,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-71f17afc-b6a1-50e6-8314-cf085641ebf2" :answer/id #uuid "71f17afc-b6a1-50e6-8314-cf085641ebf2" :answer/type :answer.type/math :answer/value "f(n+1)=2f(n),\\,f(1)=6,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-227897ea-9dd1-5b96-9c06-008a8a2d99f1" :answer/id #uuid "227897ea-9dd1-5b96-9c06-008a8a2d99f1" :answer/type :answer.type/math :answer/value "f(n+1)=6f(n),\\,f(1)=12,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "answer-3a562547-fbeb-5f3b-853f-ddbd84961e5d" :answer/id #uuid "3a562547-fbeb-5f3b-853f-ddbd84961e5d" :answer/type :answer.type/math :answer/value "f(n+1)=6f(n),\\,f(1)=2,\\,n\\ge 1" :db/ensure [:answer/validate]} {:db/id "activity-db102532-087a-5b88-8ea6-b910df7d8715" :activity/id #uuid "db102532-087a-5b88-8ea6-b910df7d8715" :activity/title "Translating Between Explicit and Recursive Formulas for Geometric Sequences" :activity/type :activity.type/review :activity/scope 17592186048142 :activity/course 17592186046647 :activity/steps ["step-8636cc73-2e13-568c-ad29-370477db4596" "step-c5c7edc3-8b0c-53c9-8c90-bfaf896e93bf" "step-b4bbf74d-c726-5214-968d-de225c1af191"] :activity/first-step "step-8636cc73-2e13-568c-ad29-370477db4596" :db/ensure [:activity/validate]} {:db/id "step-8636cc73-2e13-568c-ad29-370477db4596" :step/id #uuid "8636cc73-2e13-568c-ad29-370477db4596" :step/content "question-2e69b893-dca1-5a00-a0a1-d673b040380f" :step/next "step-c5c7edc3-8b0c-53c9-8c90-bfaf896e93bf" :db/ensure [:step/validate]} {:db/id "step-c5c7edc3-8b0c-53c9-8c90-bfaf896e93bf" :step/id #uuid "c5c7edc3-8b0c-53c9-8c90-bfaf896e93bf" :step/content "question-072376b1-6413-51af-98f6-95587e3acbf3" :step/next "step-b4bbf74d-c726-5214-968d-de225c1af191" :db/ensure [:step/validate]} {:db/id "step-b4bbf74d-c726-5214-968d-de225c1af191" :step/id #uuid "b4bbf74d-c726-5214-968d-de225c1af191" :step/content "question-715d8ed0-87e8-5b42-a40f-879649ce1b0d" :db/ensure [:step/validate]} {:db/id "activity-0ac10cd6-87b4-5be4-8d2a-8b946ef63557" :activity/id #uuid "0ac10cd6-87b4-5be4-8d2a-8b946ef63557" :activity/title "The Shortest Distance Between a Point and a Line" :activity/type :activity.type/review :activity/scope 17592186050409 :activity/course 17592186046647 :activity/steps ["step-b8b9a1c0-92da-5136-9409-0bd8db22ebdf" "step-581eac97-d55b-546b-8351-221450ce3692" "step-d242eb63-36df-5068-8499-2c2f42772c0c"] :activity/first-step "step-b8b9a1c0-92da-5136-9409-0bd8db22ebdf" :db/ensure [:activity/validate]} {:db/id "step-b8b9a1c0-92da-5136-9409-0bd8db22ebdf" :step/id #uuid "b8b9a1c0-92da-5136-9409-0bd8db22ebdf" :step/content 17592186342209 :step/next "step-581eac97-d55b-546b-8351-221450ce3692" :db/ensure [:step/validate]} {:db/id "step-581eac97-d55b-546b-8351-221450ce3692" :step/id #uuid "581eac97-d55b-546b-8351-221450ce3692" :step/content 17592186342211 :step/next "step-d242eb63-36df-5068-8499-2c2f42772c0c" :db/ensure [:step/validate]} {:db/id "step-d242eb63-36df-5068-8499-2c2f42772c0c" :step/id #uuid "d242eb63-36df-5068-8499-2c2f42772c0c" :step/content 17592186342212 :db/ensure [:step/validate]} [:db/retract 17592186167282 :question/answer-fields 17592186164913] [:db/retract 17592186167282 :question/answer-fields 17592186164900] {:db/id 17592186166964 :knowledge-point/questions ["question-cf16f70d-fe20-5e04-9e8c-d37751162e97"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186166963 :knowledge-point/questions ["question-31cb2aad-4101-56c2-adfa-13a34142aa32"] :db/ensure [:knowledge-point/validate]} {:db/id "question-31cb2aad-4101-56c2-adfa-13a34142aa32" :question/id #uuid "31cb2aad-4101-56c2-adfa-13a34142aa32" :question/math-academy-id "q-340530" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [-\\pi ,\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(7x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=\\operatorname{sin}⁡(7x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(4x)\\operatorname{sin}⁡(7x)=\\frac{1}{2}(\\operatorname{cos}⁡(3x)-\\operatorname{cos}⁡(11x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(7x)⟩ & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡(4x)\\operatorname{sin}⁡(7x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}\\operatorname{cos}⁡(3x)-\\frac{1}{2}\\operatorname{cos}⁡(11x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)-\\frac{1}{22}\\operatorname{sin}⁡(11x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))-\\frac{1}{22}(\\operatorname{sin}⁡(11\\pi )-\\operatorname{sin}⁡(-11\\pi )) \\\\  & =\\frac{1}{6}(0-0)-\\frac{1}{22}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(4x)$ and $g(x)=\\operatorname{sin}⁡(7x)$ \n$\\text{are orthogonal}$ with respect to the inner product." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-a93c54f2-4edf-5990-a1a6-6112ce35e742" "answer-field-d4b06de8-f439-591e-a69d-d8f31e9bf9a8"] :db/ensure [:question/validate]} {:db/id "answer-field-a93c54f2-4edf-5990-a1a6-6112ce35e742" :answer-field/id #uuid "a93c54f2-4edf-5990-a1a6-6112ce35e742" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-725d1c02-12f5-5f02-85e7-82273cab47b0" :answer-field/choices ["answer-def61838-0d97-5c99-a6a2-029dbf9530cf" "answer-725d1c02-12f5-5f02-85e7-82273cab47b0" "answer-28c4a6e3-5da0-58a8-98e1-f77482614d3c" "answer-cbd85793-6947-508a-a2bc-51a8f84903cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-def61838-0d97-5c99-a6a2-029dbf9530cf" :answer/id #uuid "def61838-0d97-5c99-a6a2-029dbf9530cf" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-725d1c02-12f5-5f02-85e7-82273cab47b0" :answer/id #uuid "725d1c02-12f5-5f02-85e7-82273cab47b0" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-28c4a6e3-5da0-58a8-98e1-f77482614d3c" :answer/id #uuid "28c4a6e3-5da0-58a8-98e1-f77482614d3c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-cbd85793-6947-508a-a2bc-51a8f84903cd" :answer/id #uuid "cbd85793-6947-508a-a2bc-51a8f84903cd" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "answer-field-d4b06de8-f439-591e-a69d-d8f31e9bf9a8" :answer-field/id #uuid "d4b06de8-f439-591e-a69d-d8f31e9bf9a8" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-f2c187c8-63e1-5c83-9092-edcee77f622b" :answer-field/choices ["answer-e6d2f72f-505b-52a6-90d0-77735f112651" "answer-f2c187c8-63e1-5c83-9092-edcee77f622b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6d2f72f-505b-52a6-90d0-77735f112651" :answer/id #uuid "e6d2f72f-505b-52a6-90d0-77735f112651" :answer/type :answer.type/text :answer/value "are not orthogonal" :db/ensure [:answer/validate]} {:db/id "answer-f2c187c8-63e1-5c83-9092-edcee77f622b" :answer/id #uuid "f2c187c8-63e1-5c83-9092-edcee77f622b" :answer/type :answer.type/text :answer/value "are orthogonal" :db/ensure [:answer/validate]} {:db/id "question-cf16f70d-fe20-5e04-9e8c-d37751162e97" :question/id #uuid "cf16f70d-fe20-5e04-9e8c-d37751162e97" :question/math-academy-id "q-340637" :question/problem "Let $F(x)=3x-4$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{7}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{7} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that is piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(7x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(7x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(7x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(7x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(7x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(7x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{7}⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩ & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡(7x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(14x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{28}\\operatorname{sin}⁡(14x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)-\\frac{1}{28}(\\operatorname{sin}⁡(28\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(7x)⟩ & ={a}_{7}⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩ \\\\ {a}_{7} & =\\frac{⟨f(x),\\operatorname{cos}⁡(7x)⟩}{⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩} \\\\ {a}_{7} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6e0193b9-6155-5584-9bd2-1442c921f71c" "answer-field-52ed6280-fb1c-5efd-92cf-f0fa0ff719a2" "answer-field-348d6e77-d6f5-5569-b7f3-7f014d07ae33"] :db/ensure [:question/validate]} {:db/id "answer-field-6e0193b9-6155-5584-9bd2-1442c921f71c" :answer-field/id #uuid "6e0193b9-6155-5584-9bd2-1442c921f71c" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-ac98a90c-ced6-5f67-a7f0-29cf297dabc0" :answer-field/choices ["answer-80d1c28b-e18c-5913-acde-187852b1e23b" "answer-20144083-961b-5054-ad1d-a5de281d1d18" "answer-ac98a90c-ced6-5f67-a7f0-29cf297dabc0" "answer-beb7e7f4-faf0-5ad6-870f-155a809a5272" "answer-6f45090e-5cbf-5b0f-abce-8d3156c3f296"] :db/ensure [:answer-field/validate]} {:db/id "answer-80d1c28b-e18c-5913-acde-187852b1e23b" :answer/id #uuid "80d1c28b-e18c-5913-acde-187852b1e23b" :answer/type :answer.type/math :answer/value "\\frac{⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩}{⟨f(x),\\operatorname{cos}⁡(7x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-20144083-961b-5054-ad1d-a5de281d1d18" :answer/id #uuid "20144083-961b-5054-ad1d-a5de281d1d18" :answer/type :answer.type/math :answer/value "\\frac{⟨\\operatorname{sin}⁡(7x),\\operatorname{sin}⁡(7x)⟩}{⟨f(x),\\operatorname{cos}⁡(7x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-ac98a90c-ced6-5f67-a7f0-29cf297dabc0" :answer/id #uuid "ac98a90c-ced6-5f67-a7f0-29cf297dabc0" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(7x)⟩}{⟨\\operatorname{cos}⁡(7x),\\operatorname{cos}⁡(7x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-beb7e7f4-faf0-5ad6-870f-155a809a5272" :answer/id #uuid "beb7e7f4-faf0-5ad6-870f-155a809a5272" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(7x)⟩}{⟨\\operatorname{sin}⁡(7x),\\operatorname{sin}⁡(7x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-6f45090e-5cbf-5b0f-abce-8d3156c3f296" :answer/id #uuid "6f45090e-5cbf-5b0f-abce-8d3156c3f296" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(7x)⟩}{⟨\\operatorname{sin}⁡(7x),\\operatorname{sin}⁡(7x)⟩}" :db/ensure [:answer/validate]} {:db/id "answer-field-52ed6280-fb1c-5efd-92cf-f0fa0ff719a2" :answer-field/id #uuid "52ed6280-fb1c-5efd-92cf-f0fa0ff719a2" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-2d4b053e-12c3-5e45-ae4f-2a0387470acd" :answer-field/choices ["answer-4c0c3a79-3121-56ca-bf4b-72af6e8e9456" "answer-8ec92375-06a3-5bc9-b262-125ff5792a17" "answer-2d4b053e-12c3-5e45-ae4f-2a0387470acd" "answer-db68e230-d768-52c1-9c2e-fd83dd64a3eb" "answer-50727257-50da-5481-b2ee-3b34f40e4f3f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4c0c3a79-3121-56ca-bf4b-72af6e8e9456" :answer/id #uuid "4c0c3a79-3121-56ca-bf4b-72af6e8e9456" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-8ec92375-06a3-5bc9-b262-125ff5792a17" :answer/id #uuid "8ec92375-06a3-5bc9-b262-125ff5792a17" :answer/type :answer.type/math :answer/value "\\frac{1}{7}" :db/ensure [:answer/validate]} {:db/id "answer-2d4b053e-12c3-5e45-ae4f-2a0387470acd" :answer/id #uuid "2d4b053e-12c3-5e45-ae4f-2a0387470acd" :answer/type :answer.type/math :answer/value "\\frac{1}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-db68e230-d768-52c1-9c2e-fd83dd64a3eb" :answer/id #uuid "db68e230-d768-52c1-9c2e-fd83dd64a3eb" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-50727257-50da-5481-b2ee-3b34f40e4f3f" :answer/id #uuid "50727257-50da-5481-b2ee-3b34f40e4f3f" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{7}" :db/ensure [:answer/validate]} {:db/id "answer-field-348d6e77-d6f5-5569-b7f3-7f014d07ae33" :answer-field/id #uuid "348d6e77-d6f5-5569-b7f3-7f014d07ae33" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-d60aa3ac-c858-5bd4-846e-6e412ce0854c" :answer-field/choices ["answer-5dc6d044-465e-59bd-9043-3e7128925241" "answer-85455903-4384-59bb-81d1-d48fab31a874" "answer-d60aa3ac-c858-5bd4-846e-6e412ce0854c" "answer-323dbbe1-3082-574e-a141-37fe7a4c73f5" "answer-b0567346-ea67-5cbd-8a39-1edf72d23033" "answer-b491bbd6-91a8-541b-af25-681e01942fd5"] :db/ensure [:answer-field/validate]} {:db/id "answer-5dc6d044-465e-59bd-9043-3e7128925241" :answer/id #uuid "5dc6d044-465e-59bd-9043-3e7128925241" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-85455903-4384-59bb-81d1-d48fab31a874" :answer/id #uuid "85455903-4384-59bb-81d1-d48fab31a874" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-d60aa3ac-c858-5bd4-846e-6e412ce0854c" :answer/id #uuid "d60aa3ac-c858-5bd4-846e-6e412ce0854c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-323dbbe1-3082-574e-a141-37fe7a4c73f5" :answer/id #uuid "323dbbe1-3082-574e-a141-37fe7a4c73f5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b0567346-ea67-5cbd-8a39-1edf72d23033" :answer/id #uuid "b0567346-ea67-5cbd-8a39-1edf72d23033" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }(3x-4)\\operatorname{cos}⁡(7x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "answer-b491bbd6-91a8-541b-af25-681e01942fd5" :answer/id #uuid "b491bbd6-91a8-541b-af25-681e01942fd5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }(3x-4)\\operatorname{sin}⁡(7x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id 17592186166962 :knowledge-point/questions ["question-e89138a9-d6b8-5061-b7fa-8f7c0010f6f0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e89138a9-d6b8-5061-b7fa-8f7c0010f6f0" :question/id #uuid "e89138a9-d6b8-5061-b7fa-8f7c0010f6f0" :question/math-academy-id "q-341218" :question/problem "Let $F(x)=\\operatorname{cos}⁡(3x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{3}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{3})$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x+\\frac{\\pi }{3})=f(x)$ for all $x\\in R$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+\\frac{\\pi }{6})=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $\\frac{\\pi }{3}$-periodic extension of $F,$ we have  \n\n- $f(x+\\frac{\\pi }{3})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0\\frac{\\pi }{3}).$\n\nWith that in mind, we examine each statement in turn.\n\n- Statement I is true. This is exactly the definition of $\\pi /3$-periodicity:\n\n$$\nf(x+\\frac{\\pi }{3})=f(x)\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=\\frac{\\pi }{3}.$ Then,\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{3})=f(0+\\frac{\\pi }{3})=f(0)=F(0)=\\operatorname{cos}⁡(0)=1,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}F(\\frac{\\pi }{3})=\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{3})=\\operatorname{cos}⁡(\\pi )=-1.\\end{aligned}\n$$\n\nHence, $f(x)\\ne F(x)$ for $x=\\frac{\\pi }{3}.$\n\n- Statement III is false. For example, take $x=0.$ Then,\n\n$$\n\\begin{aligned}f(x+\\frac{\\pi }{6})=f(0+\\frac{\\pi }{6})=f(\\frac{\\pi }{6})=F(\\frac{\\pi }{6})=\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{6})=\\operatorname{cos}⁡(\\frac{\\pi }{2})=0,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}f(x)=f(0)=1.\\end{aligned}\n$$\n\nHence, $f(x+\\frac{\\pi }{6})\\ne f(x)$ for $x=0.$\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8f775890-b185-5534-961a-edb8b2135025"] :db/ensure [:question/validate]} {:db/id "answer-field-8f775890-b185-5534-961a-edb8b2135025" :answer-field/id #uuid "8f775890-b185-5534-961a-edb8b2135025" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d99e13f9-a196-576c-9387-f6d7991d38e4" :answer-field/choices ["answer-65fc6d60-ff84-513b-be77-831a85519a67" "answer-d99e13f9-a196-576c-9387-f6d7991d38e4" "answer-480c4aef-5346-56fa-b6d8-38a9e3d58c5d" "answer-9b81d004-13c7-55f1-aef5-1fbc7d19388a" "answer-2a5b03d8-7fa4-5401-9f31-c0c170006fd6"] :db/ensure [:answer-field/validate]} {:db/id "answer-65fc6d60-ff84-513b-be77-831a85519a67" :answer/id #uuid "65fc6d60-ff84-513b-be77-831a85519a67" :answer/type :answer.type/text :answer/value "I and II  only" :db/ensure [:answer/validate]} {:db/id "answer-d99e13f9-a196-576c-9387-f6d7991d38e4" :answer/id #uuid "d99e13f9-a196-576c-9387-f6d7991d38e4" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-480c4aef-5346-56fa-b6d8-38a9e3d58c5d" :answer/id #uuid "480c4aef-5346-56fa-b6d8-38a9e3d58c5d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-9b81d004-13c7-55f1-aef5-1fbc7d19388a" :answer/id #uuid "9b81d004-13c7-55f1-aef5-1fbc7d19388a" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-2a5b03d8-7fa4-5401-9f31-c0c170006fd6" :answer/id #uuid "2a5b03d8-7fa4-5401-9f31-c0c170006fd6" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-3fc34682-2788-5d35-a598-6c561e7bf54f" :activity/id #uuid "3fc34682-2788-5d35-a598-6c561e7bf54f" :activity/title "Introduction to Fourier Series" :activity/type :activity.type/review :activity/scope 17592186049306 :activity/course 17592186046669 :activity/steps ["step-cce0c6d6-2f7a-5100-bbb3-4f7a6f21298b" "step-43c884c8-fa1e-5751-bf45-58abee1b87ae" "step-9aa4ea8f-14c6-5c72-8dd1-c9ce0d451eed" "step-b9b5ba93-4bff-5cc8-b592-e21aafc5699c" "step-71d08261-f990-5825-b224-1a3b072f84e8"] :activity/first-step "step-cce0c6d6-2f7a-5100-bbb3-4f7a6f21298b" :db/ensure [:activity/validate]} {:db/id "step-cce0c6d6-2f7a-5100-bbb3-4f7a6f21298b" :step/id #uuid "cce0c6d6-2f7a-5100-bbb3-4f7a6f21298b" :step/content 17592186167282 :step/next "step-43c884c8-fa1e-5751-bf45-58abee1b87ae" :db/ensure [:step/validate]} {:db/id "step-43c884c8-fa1e-5751-bf45-58abee1b87ae" :step/id #uuid "43c884c8-fa1e-5751-bf45-58abee1b87ae" :step/content "question-31cb2aad-4101-56c2-adfa-13a34142aa32" :step/next "step-9aa4ea8f-14c6-5c72-8dd1-c9ce0d451eed" :db/ensure [:step/validate]} {:db/id "step-9aa4ea8f-14c6-5c72-8dd1-c9ce0d451eed" :step/id #uuid "9aa4ea8f-14c6-5c72-8dd1-c9ce0d451eed" :step/content "question-cf16f70d-fe20-5e04-9e8c-d37751162e97" :step/next "step-b9b5ba93-4bff-5cc8-b592-e21aafc5699c" :db/ensure [:step/validate]} {:db/id "step-b9b5ba93-4bff-5cc8-b592-e21aafc5699c" :step/id #uuid "b9b5ba93-4bff-5cc8-b592-e21aafc5699c" :step/content "question-e89138a9-d6b8-5061-b7fa-8f7c0010f6f0" :step/next "step-71d08261-f990-5825-b224-1a3b072f84e8" :db/ensure [:step/validate]} {:db/id "step-71d08261-f990-5825-b224-1a3b072f84e8" :step/id #uuid "71d08261-f990-5825-b224-1a3b072f84e8" :step/content 17592186315084 :db/ensure [:step/validate]} {:db/id 17592186083186 :knowledge-point/questions ["question-89d5541c-c810-5b48-ae7e-160f63479682" "question-ff16fd72-aa33-5ed0-9859-414065a202fe" "question-7a249418-3166-5952-aa2e-ffdd779176d1" "question-3f0e7d2f-2da0-5cf5-aa62-0f9950fe080c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083187 :knowledge-point/questions ["question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" "question-621c054c-a8ee-5e21-b7c5-55a43d66b230" "question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" "question-b4514a54-7bd5-5a89-8cc0-e28359cd784d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083188 :knowledge-point/questions ["question-8a434264-115c-5e23-9940-79d2727ed021" "question-2ea1e232-4156-584c-babd-20b14e2a349e" "question-8de5ec05-717f-57d0-aca0-bdf66baf299d" "question-7198fc6e-53bf-58ce-9c21-b096160c3a27"] :db/ensure [:knowledge-point/validate]} {:db/id "question-89d5541c-c810-5b48-ae7e-160f63479682" :question/id #uuid "89d5541c-c810-5b48-ae7e-160f63479682" :question/math-academy-id "q-106536" :question/problem "Find the axis of symmetry for the parabola $y={x}^{2}-4x-7.$" :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=1$ and $b=-4$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{(-4)}{2(1)} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b8715ddf-30dc-5432-a1c8-2e10c7592a01"] :db/ensure [:question/validate]} {:db/id "answer-field-b8715ddf-30dc-5432-a1c8-2e10c7592a01" :answer-field/id #uuid "b8715ddf-30dc-5432-a1c8-2e10c7592a01" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0daa7f1-cb33-52de-945c-35ad2167e1bf" :answer-field/choices ["answer-76d2dbf4-b89b-5c6a-a455-711686772052" "answer-ebedb26e-db16-51dd-97c1-c3b3ae7d081d" "answer-f0daa7f1-cb33-52de-945c-35ad2167e1bf" "answer-047eec8e-f012-55e2-ac80-1810d95bc41d" "answer-12dd1ab4-1788-5577-a5e5-6ac8740fa1a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-76d2dbf4-b89b-5c6a-a455-711686772052" :answer/id #uuid "76d2dbf4-b89b-5c6a-a455-711686772052" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-ebedb26e-db16-51dd-97c1-c3b3ae7d081d" :answer/id #uuid "ebedb26e-db16-51dd-97c1-c3b3ae7d081d" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-f0daa7f1-cb33-52de-945c-35ad2167e1bf" :answer/id #uuid "f0daa7f1-cb33-52de-945c-35ad2167e1bf" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-047eec8e-f012-55e2-ac80-1810d95bc41d" :answer/id #uuid "047eec8e-f012-55e2-ac80-1810d95bc41d" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-12dd1ab4-1788-5577-a5e5-6ac8740fa1a6" :answer/id #uuid "12dd1ab4-1788-5577-a5e5-6ac8740fa1a6" :answer/type :answer.type/math :answer/value "x=\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-ff16fd72-aa33-5ed0-9859-414065a202fe" :question/id #uuid "ff16fd72-aa33-5ed0-9859-414065a202fe" :question/math-academy-id "q-222076" :question/problem "The axis of symmetry of the parabola $y=4{x}^{2}+3x+2$ is $x=${{field-1}}." :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=4$ and $b=3$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{3}{2(4)} \\\\  & =-\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-\\frac{3}{8}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0ac0919c-bc03-5eb1-b683-8e74321045e2"] :db/ensure [:question/validate]} {:db/id "answer-field-0ac0919c-bc03-5eb1-b683-8e74321045e2" :answer-field/id #uuid "0ac0919c-bc03-5eb1-b683-8e74321045e2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4295ee61-6048-53f9-9797-3fb92b43b5bd" :answer-field/choices ["answer-4295ee61-6048-53f9-9797-3fb92b43b5bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-4295ee61-6048-53f9-9797-3fb92b43b5bd" :answer/id #uuid "4295ee61-6048-53f9-9797-3fb92b43b5bd" :answer/type :answer.type/math :answer/value "-\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "question-7a249418-3166-5952-aa2e-ffdd779176d1" :question/id #uuid "7a249418-3166-5952-aa2e-ffdd779176d1" :question/math-academy-id "q-106539" :question/problem "Find the axis of symmetry for the parabola $y=2{x}^{2}+8x-3.$" :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=2$ and $b=8$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{8}{2(2)} \\\\  & =-\\frac{8}{4} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-58080bed-1ac2-5652-ab76-b460fa71e917"] :db/ensure [:question/validate]} {:db/id "answer-field-58080bed-1ac2-5652-ab76-b460fa71e917" :answer-field/id #uuid "58080bed-1ac2-5652-ab76-b460fa71e917" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-df7c299f-a11e-5927-ad5b-bcd08a02bd4e" :answer-field/choices ["answer-df7c299f-a11e-5927-ad5b-bcd08a02bd4e" "answer-dace083e-ae80-5311-9205-e754e34dc1f4" "answer-b1fbd0b0-1be4-52eb-a17b-70d994f0ef95" "answer-366f61ee-82b5-511f-9834-78fe121c414a" "answer-404b7834-6467-595c-8689-798a9dd0ba2b"] :db/ensure [:answer-field/validate]} {:db/id "answer-df7c299f-a11e-5927-ad5b-bcd08a02bd4e" :answer/id #uuid "df7c299f-a11e-5927-ad5b-bcd08a02bd4e" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-dace083e-ae80-5311-9205-e754e34dc1f4" :answer/id #uuid "dace083e-ae80-5311-9205-e754e34dc1f4" :answer/type :answer.type/math :answer/value "x=-4" :db/ensure [:answer/validate]} {:db/id "answer-b1fbd0b0-1be4-52eb-a17b-70d994f0ef95" :answer/id #uuid "b1fbd0b0-1be4-52eb-a17b-70d994f0ef95" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-366f61ee-82b5-511f-9834-78fe121c414a" :answer/id #uuid "366f61ee-82b5-511f-9834-78fe121c414a" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "answer-404b7834-6467-595c-8689-798a9dd0ba2b" :answer/id #uuid "404b7834-6467-595c-8689-798a9dd0ba2b" :answer/type :answer.type/math :answer/value "x=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "question-3f0e7d2f-2da0-5cf5-aa62-0f9950fe080c" :question/id #uuid "3f0e7d2f-2da0-5cf5-aa62-0f9950fe080c" :question/math-academy-id "q-106541" :question/problem "Find the axis of symmetry for the parabola $y=-3{x}^{2}-18x+7.$" :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=-3$ and $b=-18$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{(-18)}{2(-3)} \\\\  & =-\\frac{(-18)}{(-6)} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-367bd5f7-e5a7-580c-976d-0f5f94cccf47"] :db/ensure [:question/validate]} {:db/id "answer-field-367bd5f7-e5a7-580c-976d-0f5f94cccf47" :answer-field/id #uuid "367bd5f7-e5a7-580c-976d-0f5f94cccf47" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b38332e4-d6a6-57fc-ab73-bece0af7380c" :answer-field/choices ["answer-037caabe-2f41-51bc-8802-582169729c0f" "answer-b38332e4-d6a6-57fc-ab73-bece0af7380c" "answer-b6f6c486-0a93-53b2-b1e7-f096d03aa4fe" "answer-6c7d6dad-f969-5f91-a45e-3d713c825d49" "answer-0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269"] :db/ensure [:answer-field/validate]} {:db/id "answer-037caabe-2f41-51bc-8802-582169729c0f" :answer/id #uuid "037caabe-2f41-51bc-8802-582169729c0f" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-b38332e4-d6a6-57fc-ab73-bece0af7380c" :answer/id #uuid "b38332e4-d6a6-57fc-ab73-bece0af7380c" :answer/type :answer.type/math :answer/value "x=-3" :db/ensure [:answer/validate]} {:db/id "answer-b6f6c486-0a93-53b2-b1e7-f096d03aa4fe" :answer/id #uuid "b6f6c486-0a93-53b2-b1e7-f096d03aa4fe" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-6c7d6dad-f969-5f91-a45e-3d713c825d49" :answer/id #uuid "6c7d6dad-f969-5f91-a45e-3d713c825d49" :answer/type :answer.type/math :answer/value "x=6" :db/ensure [:answer/validate]} {:db/id "answer-0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269" :answer/id #uuid "0c3f92cf-9ad6-5ac6-bcf8-367dd8ea8269" :answer/type :answer.type/math :answer/value "x=\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "question-0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/id #uuid "0b6f37ac-511e-531f-9fd9-0e1aa3bfef93" :question/math-academy-id "q-106543" :question/problem "Find the coordinates of the vertex of the parabola $y={x}^{2}+4x-11.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=1$ and $b=4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{4}{2(1)} \\\\  & =-\\frac{4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-2.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-2$ into the original equation:\n\n$$\n\\begin{aligned}y & ={x}^{2}+4x-11 \\\\  & =(-2)^{2}+4(-2)-11 \\\\  & =4-8-11 \\\\  & =-15\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-2,-15).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-dca6600a-f1ed-5820-b07a-a9d181dedbc7"] :db/ensure [:question/validate]} {:db/id "answer-field-dca6600a-f1ed-5820-b07a-a9d181dedbc7" :answer-field/id #uuid "dca6600a-f1ed-5820-b07a-a9d181dedbc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer-field/choices ["answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" "answer-682195de-3e85-5753-851c-879da28ac8bb" "answer-1e4b65c0-3183-57d2-a3ff-e8e9a1c3a05f" "answer-5fab28f4-6451-5564-a2e7-ae3bed8d311e" "answer-01b71aec-b8b3-5037-8deb-926f506792fc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer/id #uuid "c93d9d5d-d91f-5a40-a5af-007efceb3232" :answer/type :answer.type/math :answer/value "(-2,-15)" :db/ensure [:answer/validate]} {:db/id "answer-682195de-3e85-5753-851c-879da28ac8bb" :answer/id #uuid "682195de-3e85-5753-851c-879da28ac8bb" :answer/type :answer.type/math :answer/value "(-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-1e4b65c0-3183-57d2-a3ff-e8e9a1c3a05f" :answer/id #uuid "1e4b65c0-3183-57d2-a3ff-e8e9a1c3a05f" :answer/type :answer.type/math :answer/value "(-4,-11)" :db/ensure [:answer/validate]} {:db/id "answer-5fab28f4-6451-5564-a2e7-ae3bed8d311e" :answer/id #uuid "5fab28f4-6451-5564-a2e7-ae3bed8d311e" :answer/type :answer.type/math :answer/value "(2,1)" :db/ensure [:answer/validate]} {:db/id "answer-01b71aec-b8b3-5037-8deb-926f506792fc" :answer/id #uuid "01b71aec-b8b3-5037-8deb-926f506792fc" :answer/type :answer.type/math :answer/value "(2,15)" :db/ensure [:answer/validate]} {:db/id "question-621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/id #uuid "621c054c-a8ee-5e21-b7c5-55a43d66b230" :question/math-academy-id "q-222082" :question/problem "What are the coordinates of the vertex of the parabola $y={x}^{2}-6x+7?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=1$ and $b=-6$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-6)}{2(1)} \\\\  & =-\\frac{(-6)}{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x+7 \\\\  & ={3}^{2}-6(3)+7 \\\\  & =9-18+7 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,-2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" "answer-field-cab4b1dd-416a-506b-9085-7936c937e72b"] :db/ensure [:question/validate]} {:db/id "answer-field-bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/id #uuid "bca17f37-d098-5fee-a7b9-8d476bb24f52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer-field/choices ["answer-980f0782-9bf6-5d75-917f-90617c2af852"] :db/ensure [:answer-field/validate]} {:db/id "answer-980f0782-9bf6-5d75-917f-90617c2af852" :answer/id #uuid "980f0782-9bf6-5d75-917f-90617c2af852" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-field-cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/id #uuid "cab4b1dd-416a-506b-9085-7936c937e72b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer-field/choices ["answer-d25cb9d3-ae1c-5d4b-aad5-470049340353"] :db/ensure [:answer-field/validate]} {:db/id "answer-d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/id #uuid "d25cb9d3-ae1c-5d4b-aad5-470049340353" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "question-9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/id #uuid "9df948ff-fcd8-5687-95bb-a0bdf3f05629" :question/math-academy-id "q-13386" :question/problem "Find the coordinates of the vertex of the parabola $y=3{x}^{2}+36x+6.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=36$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{36}{2(3)} \\\\  & =-\\frac{36}{6} \\\\  & =-6.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-6.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-6$ into the original equation:\n\n$$\n\\begin{aligned}y & =3{x}^{2}+36x+6 \\\\  & =3(-6)^{2}+36(-6)+6 \\\\  & =108-216+6 \\\\  & =-102\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-6,-102).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b"] :db/ensure [:question/validate]} {:db/id "answer-field-2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/id #uuid "2aca8f67-fa9a-544b-9a5d-d25691fbc92b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer-field/choices ["answer-62899510-a87d-5d7f-9a3f-4c33314df94a" "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" "answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" "answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" "answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5"] :db/ensure [:answer-field/validate]} {:db/id "answer-62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/id #uuid "62899510-a87d-5d7f-9a3f-4c33314df94a" :answer/type :answer.type/math :answer/value "(-3,-75)" :db/ensure [:answer/validate]} {:db/id "answer-f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/id #uuid "f256a5f1-0204-5b93-af96-9f80b697b4bd" :answer/type :answer.type/math :answer/value "(-6,-102)" :db/ensure [:answer/validate]} {:db/id "answer-30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/id #uuid "30b8d0fd-6c5a-5866-938e-4356bd69904e" :answer/type :answer.type/math :answer/value "(-6,54)" :db/ensure [:answer/validate]} {:db/id "answer-85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/id #uuid "85daedbc-1998-5aa5-95d2-c689b6aecb21" :answer/type :answer.type/math :answer/value "(3,50)" :db/ensure [:answer/validate]} {:db/id "answer-5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/id #uuid "5f89c0ba-747e-5424-b392-8ae56dd31ab5" :answer/type :answer.type/math :answer/value "(6,48)" :db/ensure [:answer/validate]} {:db/id "question-b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/id #uuid "b4514a54-7bd5-5a89-8cc0-e28359cd784d" :question/math-academy-id "q-10324" :question/problem "Find the coordinates of the vertex of the parabola $y=-5{x}^{2}+30x+2.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-5$ and $b=30$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{30}{2(-5)} \\\\  & =-\\frac{30}{(-10)} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & =-5{x}^{2}+30x+2 \\\\  & =-5(3)^{2}+30(3)+2 \\\\  & =-45+90+2 \\\\  & =47\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,47).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a"] :db/ensure [:question/validate]} {:db/id "answer-field-1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/id #uuid "1b5e1f01-10ee-5e1a-99dc-d1ce7db0a46a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer-field/choices ["answer-cf7569b9-f881-53b5-8879-4445f0b56f86" "answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" "answer-bfe77f59-59d1-5211-8384-6829442bb7a3" "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" "answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/id #uuid "cf7569b9-f881-53b5-8879-4445f0b56f86" :answer/type :answer.type/math :answer/value "(-3,-133)" :db/ensure [:answer/validate]} {:db/id "answer-0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/id #uuid "0b7f23c9-0bd5-5ec8-8fd7-e875fc1806da" :answer/type :answer.type/math :answer/value "(-3,47)" :db/ensure [:answer/validate]} {:db/id "answer-bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/id #uuid "bfe77f59-59d1-5211-8384-6829442bb7a3" :answer/type :answer.type/math :answer/value "(1,27)" :db/ensure [:answer/validate]} {:db/id "answer-6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/id #uuid "6e9465f1-3630-5899-98a2-9ffd8b1c2a56" :answer/type :answer.type/math :answer/value "(3,47)" :db/ensure [:answer/validate]} {:db/id "answer-317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/id #uuid "317b6ffc-ad6b-5f25-a9ae-7a7a14382ea6" :answer/type :answer.type/math :answer/value "(3,54)" :db/ensure [:answer/validate]} {:db/id "question-8a434264-115c-5e23-9940-79d2727ed021" :question/id #uuid "8a434264-115c-5e23-9940-79d2727ed021" :question/math-academy-id "q-52326" :question/problem "The axis of symmetry of the parabola $y=4{x}^{2}+kx-2$ is $x=-1.$ Find the value of $k.$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $-1.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=4$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(4)} \\\\  & =-\\frac{k}{8}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-1,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{8} & =-1 \\\\ -k & =-8 \\\\ k & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74"] :db/ensure [:question/validate]} {:db/id "answer-field-0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/id #uuid "0f668b4d-53cc-57b3-995b-4df60daafa74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer-field/choices ["answer-a1424b21-9207-5fc2-931a-208860cb0e04" "answer-3bb42019-06df-5498-9d29-49a2aeb6de50" "answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" "answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" "answer-8af2d063-d5b4-5386-9515-7976cb518a55"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1424b21-9207-5fc2-931a-208860cb0e04" :answer/id #uuid "a1424b21-9207-5fc2-931a-208860cb0e04" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/id #uuid "3bb42019-06df-5498-9d29-49a2aeb6de50" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/id #uuid "2c78fe61-cf74-5dcb-97a3-cd26f9cf105f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/id #uuid "0d47cbe0-a293-5059-81ae-ce84f00371dd" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-8af2d063-d5b4-5386-9515-7976cb518a55" :answer/id #uuid "8af2d063-d5b4-5386-9515-7976cb518a55" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-2ea1e232-4156-584c-babd-20b14e2a349e" :question/id #uuid "2ea1e232-4156-584c-babd-20b14e2a349e" :question/math-academy-id "q-52329" :question/problem "![](images/5f/5f76e31fbf6e2d7b1398eaafc97e634e955b3314697d650d5f645555c1df289e.png)\n\nFind the value of $k$ for the parabola $y=3{x}^{2}+kx+2$ shown above." :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=2,$ we will set our result equal to $2.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(3)} \\\\  & =-\\frac{k}{6}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=2,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{6} & =2 \\\\ k & =-12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d"] :db/ensure [:question/validate]} {:db/id "answer-field-a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d" :answer-field/id #uuid "a4d9a73c-49d9-5fa1-8da6-76c9d8ecc11d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-341d0c0d-a5c9-573a-a052-820eab9de3db" :answer-field/choices ["answer-341d0c0d-a5c9-573a-a052-820eab9de3db" "answer-f1eca14e-bba3-56a3-8702-d07045257425" "answer-351bc5d9-a80f-513f-9a55-d9d78db6d7ed" "answer-1a137401-bd57-566e-9d85-d212c9ba2e04" "answer-16b90e9b-90ed-511a-9ae3-962fa6391abf"] :db/ensure [:answer-field/validate]} {:db/id "answer-341d0c0d-a5c9-573a-a052-820eab9de3db" :answer/id #uuid "341d0c0d-a5c9-573a-a052-820eab9de3db" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-f1eca14e-bba3-56a3-8702-d07045257425" :answer/id #uuid "f1eca14e-bba3-56a3-8702-d07045257425" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-351bc5d9-a80f-513f-9a55-d9d78db6d7ed" :answer/id #uuid "351bc5d9-a80f-513f-9a55-d9d78db6d7ed" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-1a137401-bd57-566e-9d85-d212c9ba2e04" :answer/id #uuid "1a137401-bd57-566e-9d85-d212c9ba2e04" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-16b90e9b-90ed-511a-9ae3-962fa6391abf" :answer/id #uuid "16b90e9b-90ed-511a-9ae3-962fa6391abf" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/id #uuid "8de5ec05-717f-57d0-aca0-bdf66baf299d" :question/math-academy-id "q-52259" :question/problem "![](images/5c/5cb63eb200d809aa94800fc7990c9a621ad2aca32d86cb1aeb39c844eb9c8205.png)\n\nFind the value of $k$ for the parabola $y=k{x}^{2}+12x-6,$ shown above." :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=-3,$ we will set our result equal to $-3.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=k$ and $b=12$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{12}{2(k)} \\\\  & =-\\frac{12}{2k} \\\\  & =-\\frac{6}{k}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-3,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{6}{k} & =-3 \\\\ -6 & =-3k \\\\ k & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-08b63179-28da-5781-a56a-19cfea55072a"] :db/ensure [:question/validate]} {:db/id "answer-field-08b63179-28da-5781-a56a-19cfea55072a" :answer-field/id #uuid "08b63179-28da-5781-a56a-19cfea55072a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e0fa109-40a5-55a1-a241-29a6e4d80bf6" :answer-field/choices ["answer-98059165-843e-5163-a0dc-8950574baeac" "answer-2eda800c-a21d-570a-852b-6e5077b553c3" "answer-18f71e53-c48d-56dc-a20a-a4556c068cbf" "answer-9e0fa109-40a5-55a1-a241-29a6e4d80bf6" "answer-27af2033-5338-514c-8e18-34428ecb9d3c"] :db/ensure [:answer-field/validate]} {:db/id "answer-98059165-843e-5163-a0dc-8950574baeac" :answer/id #uuid "98059165-843e-5163-a0dc-8950574baeac" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-2eda800c-a21d-570a-852b-6e5077b553c3" :answer/id #uuid "2eda800c-a21d-570a-852b-6e5077b553c3" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-18f71e53-c48d-56dc-a20a-a4556c068cbf" :answer/id #uuid "18f71e53-c48d-56dc-a20a-a4556c068cbf" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-9e0fa109-40a5-55a1-a241-29a6e4d80bf6" :answer/id #uuid "9e0fa109-40a5-55a1-a241-29a6e4d80bf6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-27af2033-5338-514c-8e18-34428ecb9d3c" :answer/id #uuid "27af2033-5338-514c-8e18-34428ecb9d3c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-7198fc6e-53bf-58ce-9c21-b096160c3a27" :question/id #uuid "7198fc6e-53bf-58ce-9c21-b096160c3a27" :question/math-academy-id "q-106550" :question/problem "![](images/9f/9fd54a6b5f5c5c4a711dbdc7de7fcea84177454d6f4a04a1fd647e6a9d93b904.png)\n\nFind the value of $k$ for the parabola $y=-3{x}^{2}+kx+5,$ shown above." :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=-1,$ we will set our result equal to $-1.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-3$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(-3)} \\\\  & =-\\frac{k}{(-6)} \\\\  & =\\frac{k}{6}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-1,$ so we must have\n\n$$\n\\begin{aligned}\\frac{k}{6} & =-1 \\\\ k & =-6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5bdc9abc-9fd1-5916-ba55-1902c71afb99"] :db/ensure [:question/validate]} {:db/id "answer-field-5bdc9abc-9fd1-5916-ba55-1902c71afb99" :answer-field/id #uuid "5bdc9abc-9fd1-5916-ba55-1902c71afb99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-06f09f49-4c97-528f-b8de-3a1879e200e8" :answer-field/choices ["answer-74a39713-92e5-576b-b789-33314d80ed36" "answer-176dee66-a05c-595a-9ab2-46aeebf6b277" "answer-06f09f49-4c97-528f-b8de-3a1879e200e8" "answer-428b9f8a-7e89-5114-a895-5026faee9650" "answer-09fcecc3-19a8-57de-9b01-ad29d32f9d14"] :db/ensure [:answer-field/validate]} {:db/id "answer-74a39713-92e5-576b-b789-33314d80ed36" :answer/id #uuid "74a39713-92e5-576b-b789-33314d80ed36" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-176dee66-a05c-595a-9ab2-46aeebf6b277" :answer/id #uuid "176dee66-a05c-595a-9ab2-46aeebf6b277" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-06f09f49-4c97-528f-b8de-3a1879e200e8" :answer/id #uuid "06f09f49-4c97-528f-b8de-3a1879e200e8" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-428b9f8a-7e89-5114-a895-5026faee9650" :answer/id #uuid "428b9f8a-7e89-5114-a895-5026faee9650" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-09fcecc3-19a8-57de-9b01-ad29d32f9d14" :answer/id #uuid "09fcecc3-19a8-57de-9b01-ad29d32f9d14" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186124659 :knowledge-point/questions ["question-1ffbeb0a-9779-5c35-a530-341343c5a9f9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1ffbeb0a-9779-5c35-a530-341343c5a9f9" :question/id #uuid "1ffbeb0a-9779-5c35-a530-341343c5a9f9" :question/math-academy-id "q-90970" :question/problem "What is the range of the function $f(x)=-{x}^{2}-8x-4?$" :question/worked-solution "The given parabola is written in standard form,\n\n$$\ny=a{x}^{2}+bx+c,\n$$\n\nwith $a=-1<0,$ $b=-8,$ and $c=-4.$\n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe $x$-coordinate of the vertex is given by\n\n$$\nx=-\\frac{b}{2a}=-\\frac{(-8)}{2\\cdot (-1)}=-4.\n$$\n\nNow, we substitute $x=-4$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-{x}^{2}-8x-4 \\\\  & =-(-4)^{2}-8(-4)-4 \\\\  & =-16+32-4 \\\\  & =12\\end{aligned}\n$$\n\nTherefore, the vertex is $(-4,12),$ and the range of the function is $(-\\infty ,12].$\n\n![](images/52/52d836e66719861c2fff226f5ae8d38485d3874b51365dddf8e3d3e99088972c.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ddf9e1a-4d8f-52d7-a6b4-217f0d19f0e6"] :db/ensure [:question/validate]} {:db/id "answer-field-1ddf9e1a-4d8f-52d7-a6b4-217f0d19f0e6" :answer-field/id #uuid "1ddf9e1a-4d8f-52d7-a6b4-217f0d19f0e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a63d5147-8df3-58cb-814c-76bc9d5b75c3" :answer-field/choices ["answer-6afc1ce6-29e6-52f3-a10c-5b118b05a8ec" "answer-4af5a9b7-e5a9-5f98-ab91-fd32e53abb91" "answer-a63d5147-8df3-58cb-814c-76bc9d5b75c3" "answer-c627679c-f4b5-5c2f-a981-1b2c19fcb88e" "answer-12e9b9ea-0207-5775-8719-53fb983a237d"] :db/ensure [:answer-field/validate]} {:db/id "answer-6afc1ce6-29e6-52f3-a10c-5b118b05a8ec" :answer/id #uuid "6afc1ce6-29e6-52f3-a10c-5b118b05a8ec" :answer/type :answer.type/math :answer/value "(-\\infty ,-12]" :db/ensure [:answer/validate]} {:db/id "answer-4af5a9b7-e5a9-5f98-ab91-fd32e53abb91" :answer/id #uuid "4af5a9b7-e5a9-5f98-ab91-fd32e53abb91" :answer/type :answer.type/math :answer/value "(-\\infty ,-4]" :db/ensure [:answer/validate]} {:db/id "answer-a63d5147-8df3-58cb-814c-76bc9d5b75c3" :answer/id #uuid "a63d5147-8df3-58cb-814c-76bc9d5b75c3" :answer/type :answer.type/math :answer/value "(-\\infty ,12]" :db/ensure [:answer/validate]} {:db/id "answer-c627679c-f4b5-5c2f-a981-1b2c19fcb88e" :answer/id #uuid "c627679c-f4b5-5c2f-a981-1b2c19fcb88e" :answer/type :answer.type/math :answer/value "(-\\infty ,4]" :db/ensure [:answer/validate]} {:db/id "answer-12e9b9ea-0207-5775-8719-53fb983a237d" :answer/id #uuid "12e9b9ea-0207-5775-8719-53fb983a237d" :answer/type :answer.type/math :answer/value "[-4,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186124660 :knowledge-point/questions ["question-723435c8-f6c2-5011-8005-6ac70ede7884"] :db/ensure [:knowledge-point/validate]} {:db/id "question-723435c8-f6c2-5011-8005-6ac70ede7884" :question/id #uuid "723435c8-f6c2-5011-8005-6ac70ede7884" :question/math-academy-id "q-90983" :question/problem "What is the range of the function $f(x)=-5(x-1)(x-2)?$" :question/worked-solution "The given parabola is written in factored form,\n\n$$\ny=a(x-{x}_{1})(x-{x}_{2}),\n$$\n\nwith $a=-5<0.$ \n\nBecause the leading coefficient is negative, the parabola opens downward. Consequently, there is no minimum output, and the vertex corresponds to the maximum output.\n\nThe two roots of the parabola are ${x}_{1}=1$ and ${x}_{2}=2,$ and we can find the $x$-coordinate of the vertex by taking the average of the roots:\n\n$$\n\\begin{aligned}x & =\\frac{{x}_{1}+{x}_{2}}{2}=\\frac{1+2}{2}=\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{3}{2}$ back into the function to find the $y$-value of the vertex:\n\n$$\n\\begin{aligned}y & =-5(x-1)(x-2) \\\\  & =-5(\\frac{3}{2}-1)(\\frac{3}{2}-2) \\\\  & =-5\\cdot \\frac{1}{2}\\cdot (-\\frac{1}{2}) \\\\  & =\\frac{5}{4}\\end{aligned}\n$$\n\nTherefore, the vertex is $(\\frac{3}{2},\\frac{5}{4}),$ and the range of the function is $(-\\infty ,\\frac{5}{4}].$\n\n![](images/42/426a8277921ca2c8282567eeb076c3dcf1f0f1c729c4ebd2e5d624f51b78d61e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83"] :db/ensure [:question/validate]} {:db/id "answer-field-9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/id #uuid "9e3ba704-088a-57fb-bc54-70440ac77e83" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer-field/choices ["answer-9bbe7726-805f-5ecb-9261-1dd23f6ff79a" "answer-7014d6a2-28c0-585c-9c3a-7254efaca4ea" "answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6" "answer-c24bd33a-9854-52b8-8040-811faade6cfe" "answer-332e1d80-7be9-5c06-af32-c685cf22b488"] :db/ensure [:answer-field/validate]} {:db/id "answer-9bbe7726-805f-5ecb-9261-1dd23f6ff79a" :answer/id #uuid "9bbe7726-805f-5ecb-9261-1dd23f6ff79a" :answer/type :answer.type/math :answer/value "(-\\infty ,1]" :db/ensure [:answer/validate]} {:db/id "answer-7014d6a2-28c0-585c-9c3a-7254efaca4ea" :answer/id #uuid "7014d6a2-28c0-585c-9c3a-7254efaca4ea" :answer/type :answer.type/math :answer/value "(-\\infty ,2]" :db/ensure [:answer/validate]} {:db/id "answer-66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/id #uuid "66edb060-6c48-5d86-bc94-ca07b3f6eff6" :answer/type :answer.type/math :answer/value "(-\\infty ,\\frac{5}{4}]" :db/ensure [:answer/validate]} {:db/id "answer-c24bd33a-9854-52b8-8040-811faade6cfe" :answer/id #uuid "c24bd33a-9854-52b8-8040-811faade6cfe" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-332e1d80-7be9-5c06-af32-c685cf22b488" :answer/id #uuid "332e1d80-7be9-5c06-af32-c685cf22b488" :answer/type :answer.type/math :answer/value "[2,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186124584 :knowledge-point/questions ["question-baf92e1a-9022-5719-8869-44081e0988df"] :db/ensure [:knowledge-point/validate]} {:db/id "question-baf92e1a-9022-5719-8869-44081e0988df" :question/id #uuid "baf92e1a-9022-5719-8869-44081e0988df" :question/math-academy-id "q-250613" :question/problem "Find the range of the function $f(x)=-(x+6)^{2}-10.$\n\n{{field-1}}\n$<f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-6$ and $k=-10,$ the vertex is $(-6,-10).$\n\n- Since $a=-1<0,$ the parabola opens downwards.\n\nBecause the parabola opens downwards, there is no minimum output, and the vertex corresponds to the maximum output.\n\nTherefore, the range is $(-\\infty ,-10],$ i.e. $-\\infty <f(x)\\le -10.$\n\nThe corresponding diagram is shown below.\n\n![](images/7a/7aa50770fd1c24866ca5d5a8df1b04dc7260b4a5b346f8296757c59d33ba545b.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e8c25361-0058-5188-b424-05769d00535f" "answer-field-20d40415-4aca-5a00-a88c-3b8ead6018b7" "answer-field-1c74505d-9ba7-507a-b46d-ccacd493ae26"] :db/ensure [:question/validate]} {:db/id "answer-field-e8c25361-0058-5188-b424-05769d00535f" :answer-field/id #uuid "e8c25361-0058-5188-b424-05769d00535f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-82d46fe3-a01c-51f2-bb08-72a3443e001a" :answer-field/choices ["answer-82d46fe3-a01c-51f2-bb08-72a3443e001a"] :db/ensure [:answer-field/validate]} {:db/id "answer-82d46fe3-a01c-51f2-bb08-72a3443e001a" :answer/id #uuid "82d46fe3-a01c-51f2-bb08-72a3443e001a" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id "answer-field-20d40415-4aca-5a00-a88c-3b8ead6018b7" :answer-field/id #uuid "20d40415-4aca-5a00-a88c-3b8ead6018b7" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-51afc4aa-5aa7-5db1-9827-415340924584" :answer-field/choices ["answer-51afc4aa-5aa7-5db1-9827-415340924584"] :db/ensure [:answer-field/validate]} {:db/id "answer-51afc4aa-5aa7-5db1-9827-415340924584" :answer/id #uuid "51afc4aa-5aa7-5db1-9827-415340924584" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id "answer-field-1c74505d-9ba7-507a-b46d-ccacd493ae26" :answer-field/id #uuid "1c74505d-9ba7-507a-b46d-ccacd493ae26" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4876c102-2429-5e92-adbc-25362d13d71f" :answer-field/choices ["answer-4876c102-2429-5e92-adbc-25362d13d71f"] :db/ensure [:answer-field/validate]} {:db/id "answer-4876c102-2429-5e92-adbc-25362d13d71f" :answer/id #uuid "4876c102-2429-5e92-adbc-25362d13d71f" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "activity-cd1774d0-cc54-52b2-8fb3-b23040b59b85" :activity/id #uuid "cd1774d0-cc54-52b2-8fb3-b23040b59b85" :activity/title "Domain and Range of Quadratic Functions" :activity/type :activity.type/review :activity/scope 17592186049828 :activity/course 17592186046647 :activity/steps ["step-294ef667-0d61-5f95-93c6-77309e10d176" "step-459a4996-3ca0-5e5e-9a1f-8d2cd29c20c6" "step-97fce570-7fc4-5f25-8fc4-16001b69205d"] :activity/first-step "step-294ef667-0d61-5f95-93c6-77309e10d176" :db/ensure [:activity/validate]} {:db/id "step-294ef667-0d61-5f95-93c6-77309e10d176" :step/id #uuid "294ef667-0d61-5f95-93c6-77309e10d176" :step/content "question-1ffbeb0a-9779-5c35-a530-341343c5a9f9" :step/next "step-459a4996-3ca0-5e5e-9a1f-8d2cd29c20c6" :db/ensure [:step/validate]} {:db/id "step-459a4996-3ca0-5e5e-9a1f-8d2cd29c20c6" :step/id #uuid "459a4996-3ca0-5e5e-9a1f-8d2cd29c20c6" :step/content "question-723435c8-f6c2-5011-8005-6ac70ede7884" :step/next "step-97fce570-7fc4-5f25-8fc4-16001b69205d" :db/ensure [:step/validate]} {:db/id "step-97fce570-7fc4-5f25-8fc4-16001b69205d" :step/id #uuid "97fce570-7fc4-5f25-8fc4-16001b69205d" :step/content "question-baf92e1a-9022-5719-8869-44081e0988df" :db/ensure [:step/validate]} {:db/id 17592186078468 :knowledge-point/questions ["question-1e26006d-428f-5619-b63c-23ae2341e3ff" "question-d21880a1-bb7c-5dc9-b52f-58f2578ecf10" "question-86d5fb73-7ead-50e4-a1b1-3981ab0d7b12"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078187 :question/problem "What is the index of the term $42$ in the following arithmetic sequence?\n\n$$\n-10, \\: -6, \\: -2, \\: \\ldots\n$$" :question/worked-solution "Since $a_1=-10$ and \n\n$$\nd=-6-(-10)=4,\n$$\n\nwe can construct the formula for the $n$th term as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-10+(n-1)(4) \\\\  & =-10+4n-4 \\\\  & =4n-14\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ that gives $a_n=42,$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =4n-14 \\\\ 42 & =4n-14 \\\\ 56 & =4n \\\\ 14 & =n\\end{aligned}\n$$\n\nTherefore, $42$ is the $14$th term of the sequence." :db/ensure [:question/validate]} {:db/id 17592186078469 :knowledge-point/questions ["question-20db0785-68d0-5682-b7db-691770b91085"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078188 :question/problem "Given the arithmetic sequence\n\n$$\na_{n+1} = a_n + 12, \\quad a_1 = 3,\\quad n\\geq 1,\n$$\n\nwhat is the index of the term $255?$" :question/worked-solution "We will convert the recursive formula to an explicit formula and then solve for the value of $n$ such that $a_n=255.$\n\nThe recursive rule for an arithmetic sequence takes the form\n\n$$\na_{n+1} = a_n +{\\color{black}d}.\n$$\n\nIn the given formula, we have $d={\\color{black}12}.$ We are also told that $a_1={\\color{black}3},$ so we can write the explicit formula as follows:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =3+(n-1)(12) \\\\  & =3+12n-12 \\\\  & =12n-9\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ such that $a_n=255\\mathbin{:}$\n\n$$\n\\begin{aligned}{a}_{n} & =12n-9 \\\\ 255 & =12n-9 \\\\ 264 & =12n \\\\ \\frac{264}{12} & =n \\\\ 22 & =n\\end{aligned}\n$$\n\nTherefore, $255$ is the $22$nd term of the sequence." :db/ensure [:question/validate]} {:db/id 17592186078470 :knowledge-point/questions ["question-d33dfdeb-3e95-57f8-81f1-41fd9826c2ae" "question-293ef266-e6e1-5fbe-bca3-98219ac748f8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078189 :question/problem "Given an arithmetic sequence that has $a_4=5$ and common difference $d=3$, what is the index of the term $95?$" :question/worked-solution "Since $a_4=5$ is $3$ jumps after $a_1,$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{4} & ={a}_{1}+3d \\\\ 5 & ={a}_{1}+3(3) \\\\ 5 & ={a}_{1}+9 \\\\ -4 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =-4+(n-1)(3) \\\\  & =-4+3n-3 \\\\  & =3n-7\\end{aligned}\n$$\n\nNow, we solve for the value of $n$ that gives $a_n=95,$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =3n-7 \\\\ 95 & =3n-7 \\\\ 102 & =3n \\\\ \\frac{102}{3} & =n \\\\ 34 & =n\\end{aligned}\n$$\n\nTherefore, $95$ is the $34$th term of the sequence." :db/ensure [:question/validate]} {:db/id 17592186078471 :knowledge-point/questions ["question-ac73e898-ca6f-5e3a-89ae-5ca15d1dd5de" "question-dad34bda-f28d-5c77-9c70-fca30120b836"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078191 :question/problem "Given an arithmetic sequence that has $a_2=12$ and $a_{4} = 10$, what is the index of the term $-12?$" :question/worked-solution "To construct the formula for the sequence, we need to know the common difference $d$ and the first term $a_1.$\n\nSince we are given $a_2=12$ and $a_4=10,$ we can find the common difference by dividing the total difference by the number of jumps:\n\n$$\n\\begin{aligned}d & =\\frac{{a}_{4}-{a}_{2}}{4-2} \\\\  & =\\frac{10-12}{4-2} \\\\  & =\\frac{-2}{2} \\\\  & =-1\\end{aligned}\n$$\n\nNow, since $a_2=12$ is $1$ jump after $a_1,$ we can determine the first term of the sequence:\n\n$$\n\\begin{aligned}{a}_{2} & ={a}_{1}+d \\\\ 12 & ={a}_{1}-1 \\\\ 13 & ={a}_{1}\\end{aligned}\n$$\n\nSo, the formula for the $n$th term is:\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)d \\\\  & =13+(n-1)(-1) \\\\  & =14-n\\end{aligned}\n$$\n\nNow we solve for the value of $n$ that gives $a_n=-12,$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =14-n \\\\ -12 & =14-n \\\\ -26 & =-n \\\\ 26 & =n\\end{aligned}\n$$\n\nTherefore, $-12$ is the $26$th term of the sequence." :db/ensure [:question/validate]} {:db/id "question-1e26006d-428f-5619-b63c-23ae2341e3ff" :question/id #uuid "1e26006d-428f-5619-b63c-23ae2341e3ff" :question/math-academy-id "q-236399" :question/problem "Given the arithmetic sequence ${a}_{n}=100-8n$ for $n\\ge 1,$ the index of the term $-620$ is\n\n$n=$\n{{field-1}}." :question/worked-solution "Using the formula for the $n$th term of an arithmetic sequence, we solve for the value of $n$ that gives ${a}_{n}=-620$, as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =100-8n \\\\ -620 & =100-8n \\\\ 8n & =720 \\\\ n & =90\\end{aligned}\n$$\n\nTherefore, $-620$ is the $90$th term of the sequence." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bf63bf8f-0363-542c-979e-31d561484307"] :db/ensure [:question/validate]} {:db/id "answer-field-bf63bf8f-0363-542c-979e-31d561484307" :answer-field/id #uuid "bf63bf8f-0363-542c-979e-31d561484307" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-97ce1c4d-1ed0-52c4-a1e7-0c3b7ba3d2d9" :answer-field/choices ["answer-97ce1c4d-1ed0-52c4-a1e7-0c3b7ba3d2d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-97ce1c4d-1ed0-52c4-a1e7-0c3b7ba3d2d9" :answer/id #uuid "97ce1c4d-1ed0-52c4-a1e7-0c3b7ba3d2d9" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "question-d21880a1-bb7c-5dc9-b52f-58f2578ecf10" :question/id #uuid "d21880a1-bb7c-5dc9-b52f-58f2578ecf10" :question/math-academy-id "q-51860" :question/problem "Given the arithmetic sequence $f(n)=2n-5$ for $n\\ge 1,$what is the index of the term $41?$" :question/worked-solution "Using the formula for the $n$th term of an arithmetic sequence, we solve for the value of $n$ that gives $f(n)=41$, as follows:\n\n$$\n\\begin{aligned}f(n) & =2n-5 \\\\ 41 & =2n-5 \\\\ 46 & =2n \\\\ n & =23\\end{aligned}\n$$\n\nTherefore, $41$ is the $23$rd term of the sequence." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-47e54f65-1c66-57bb-9be2-d1f8e1c2752f"] :db/ensure [:question/validate]} {:db/id "answer-field-47e54f65-1c66-57bb-9be2-d1f8e1c2752f" :answer-field/id #uuid "47e54f65-1c66-57bb-9be2-d1f8e1c2752f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e675d5e6-6517-53b9-9ccf-ccab622056a1" :answer-field/choices ["answer-aa5b8fef-1b13-51b2-a03c-72cd58df636e" "answer-22df1e8f-0e2a-5fab-aa0b-9c1e92c70910" "answer-e675d5e6-6517-53b9-9ccf-ccab622056a1" "answer-0503b0d3-7253-51fa-aab8-783b239ef61f" "answer-eee5ed79-f0b2-5d1a-a548-0aa6036f9d5c"] :db/ensure [:answer-field/validate]} {:db/id "answer-aa5b8fef-1b13-51b2-a03c-72cd58df636e" :answer/id #uuid "aa5b8fef-1b13-51b2-a03c-72cd58df636e" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "answer-22df1e8f-0e2a-5fab-aa0b-9c1e92c70910" :answer/id #uuid "22df1e8f-0e2a-5fab-aa0b-9c1e92c70910" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "answer-e675d5e6-6517-53b9-9ccf-ccab622