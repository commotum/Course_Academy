{16}{8}\\times 5\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a86b4383-0a44-5dbf-9bab-9a767c939096"] :db/ensure [:question/validate]} {:db/id "answer-field-a86b4383-0a44-5dbf-9bab-9a767c939096" :answer-field/id #uuid "a86b4383-0a44-5dbf-9bab-9a767c939096" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d0c45124-d30f-5ddf-a2e8-0de275bdcdb4" :answer-field/choices ["answer-6b7ca6a9-afa3-5418-b51a-aa29f33559ed" "answer-d0c45124-d30f-5ddf-a2e8-0de275bdcdb4" "answer-68fc39bd-b94b-58ac-81dd-4d805d1f0c11" "answer-7c70ae3f-5ff5-5786-be3c-12a9fd034015" "answer-71fe5d93-c8e1-5cc2-8672-876f61407444"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b7ca6a9-afa3-5418-b51a-aa29f33559ed" :answer/id #uuid "6b7ca6a9-afa3-5418-b51a-aa29f33559ed" :answer/type :answer.type/math :answer/value "\\frac{16}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d0c45124-d30f-5ddf-a2e8-0de275bdcdb4" :answer/id #uuid "d0c45124-d30f-5ddf-a2e8-0de275bdcdb4" :answer/type :answer.type/math :answer/value "\\frac{16}{8}" :db/ensure [:answer/validate]} {:db/id "answer-68fc39bd-b94b-58ac-81dd-4d805d1f0c11" :answer/id #uuid "68fc39bd-b94b-58ac-81dd-4d805d1f0c11" :answer/type :answer.type/math :answer/value "\\frac{5}{16}" :db/ensure [:answer/validate]} {:db/id "answer-7c70ae3f-5ff5-5786-be3c-12a9fd034015" :answer/id #uuid "7c70ae3f-5ff5-5786-be3c-12a9fd034015" :answer/type :answer.type/math :answer/value "\\frac{8}{16}" :db/ensure [:answer/validate]} {:db/id "answer-71fe5d93-c8e1-5cc2-8672-876f61407444" :answer/id #uuid "71fe5d93-c8e1-5cc2-8672-876f61407444" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id 17592186073902 :knowledge-point/questions ["question-594339a7-9976-5ba0-b28f-d33a28c1ef05"] :db/ensure [:knowledge-point/validate]} {:db/id "question-594339a7-9976-5ba0-b28f-d33a28c1ef05" :question/id #uuid "594339a7-9976-5ba0-b28f-d33a28c1ef05