te]} {:db/id "step-58faa96e-dfec-57d8-91b9-fd2fd0bd774a" :step/id #uuid "58faa96e-dfec-57d8-91b9-fd2fd0bd774a" :step/content "question-c07b8d08-df25-5edc-8755-7d7271698aeb" :db/ensure [:step/validate]} {:db/id 17592186188243 :knowledge-point/questions ["question-058289bf-85a4-559b-857c-03cbd5cec8bd" "question-6c39888c-26fe-5434-a6f8-f7931c732ee1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188179 :question/problem "What is $0.2 \\,\\textrm{kg}$ expressed in $\\textrm g?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm g$ per $\\textrm{kg},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm g}{\\textrm{kg}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $0.2\\,\\textrm{kg}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}0.2\\,\\text{kg} & =0.2\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}} \\\\  & =0.2\\,\\cancel{\\text{kg}}\\cdot \\frac{1\\,000\\,\\text{g}}{\\cancel{\\text{kg}}} \\\\  & =0.2\\cdot 1\\,000\\,\\text{g} \\\\  & =200\\,\\text{g}.\\end{aligned}\n$$\n\nTherefore, $0.2\\,\\textrm{kg}$ is equivalent to $200 \\,\\text{g}.$" :db/ensure [:question/validate]} {:db/id 17592186188244 :knowledge-point/questions ["question-6ef2597c-1ce8-509f-a9ab-036304f6968d" "question-706f7978-b984-597c-b5ee-5c4df365adea"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188180 :question/problem "What is $2.25 \\,\\textrm{g}$ expressed in $\\textrm{mg}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm {mg}$ per $\\textrm{g},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm{mg}}{\\textrm{g}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $2.25 \\,\\textrm{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}2.25\\,\\text{g} & =2.25\\,\\text{g}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\text{g}} \\\\  & =2.25\\,\\cancel{\\text{g}}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\cancel{\\text{g}}} \\\\  & =2.25\\cdot 1\\,000\\,\\text{mg} \\\\  & =2\\,250\\,\\text{mg}.\\end{aligned}\n$$\n\nTherefore, $2.25 \\,\\textrm{g}$ is equivalent to $2\\,250\\,\\text{mg}.$" :db/ensure [:question/validate]} {:db/id 17592186188245 :knowledge-point/questions ["question-c39561ec-a1cc-5663-9505-34bb8c6d7da3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186188182 :question/problem "What is $1\\,300 \\,\\textrm{g}$ expressed in $\\textrm{kg}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm g$ per $\\textrm{kg},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm g}{\\textrm{kg}}\n$$\n\nHowever, since we're converting from a smaller unit of mass $(\\textrm g)$ to a larger one $(\\textrm{kg}),$ we need to multiply  $1\\,300 \\,\\textrm{g}$ by the reciprocal of the above:\n\n$$\n\\dfrac{\\textrm{kg}}{1000\\,\\textrm g}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $1\\,300 \\,\\textrm{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}1\\,300\\,\\text{g} & =1\\,300\\,\\text{g}\\cdot \\frac{\\text{kg}}{1000\\,\\text{g}} \\\\  & =1\\,300\\,\\cancel{\\text{g}}\\cdot \\frac{\\text{kg}}{1000\\,\\cancel{\\text{g}}} \\\\  & =1\\,300\\cdot \\frac{\\text{kg}}{1000} \\\\  & =\\frac{1\\,300}{1\\,000}\\,\\text{kg} \\\\  & =1.3\\,\\text{kg}\\end{aligned}\n$$\n\nTherefore, $1\\,300 \\,\\textrm{g}$ is equivalent to $1.3 \\,\\text{kg}.$" :db/ensure [:question/validate]} {:db/id "question-058289bf-85a4-559b-857c-03cbd5cec8bd" :question/id #uuid "058289bf-85a4-559b-857c-03cbd5cec8bd" :question/math-academy-id "q-214997" :question/problem "What is $73\\,\\text{kg}$ expressed in $\\text{g}?$ Write your answer as a whole number.\n\n$73\\,\\text{kg}=$\n{{field-1}}$\\text{g}$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\text{kg}$ | $1\\,\\text{kg}=1\\,000\\,\\text{g}$ |\n| Gram | $\\text{g}$ | Base Unit |\n| Milligram | $\\text{mg}$ | $1\\,000\\,\\text{mg}=1\\,\\text{g}$ |\n\n$$\n\n$$\n\nThere are $1000\\,\\text{g}$ per $\\text{kg},$ which we can write as follows:\n\n$$\n\\frac{1000\\,\\text{g}}{\\text{kg}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $73\\,\\text{kg}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}73\\,\\text{kg} & =73\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}} \\\\  & =73\\,\\cancel{\\text{kg}}\\cdot \\frac{1\\,000\\,\\text{g}}{\\cancel{\\text{kg}}} \\\\  & =73\\cdot 1\\,000\\,\\text{g} \\\\  & =73\\,000\\,\\text{g}.\\end{aligned}\n$$\n\nTherefore, $73\\,\\text{kg}$ is equivalent to $73\\,000\\,\\text{g}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-41b116a0-fde6-5c43-adca-a754f56a122c"] :db/ensure [:question/validate]} {:db/id "answer-field-41b116a0-fde6-5c43-adca-a754f56a122c" :answer-field/id #uuid "41b116a0-fde6-5c43-adca-a754f56a122c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6ecebfaa-1179-579a-8aab-b71ed10eea1b" :answer-field/choices ["answer-6ecebfaa-1179-579a-8aab-b71ed10eea1b"] :db/ensure [:answer-field/validate]} {:db/id