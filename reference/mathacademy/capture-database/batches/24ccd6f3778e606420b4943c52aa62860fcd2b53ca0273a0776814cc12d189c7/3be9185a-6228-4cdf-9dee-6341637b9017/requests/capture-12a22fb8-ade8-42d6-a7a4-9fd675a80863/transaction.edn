,000\\,\\text{mg}}{\\text{g}} \\\\  & =4\\,\\cancel{\\text{g}}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\cancel{\\text{g}}} \\\\  & =4\\cdot 1\\,000\\,\\text{mg} \\\\  & =4\\,000\\,\\text{mg}.\\end{aligned}\n$$\n\nTherefore, $4\\,\\text{g}$ is equivalent to $4\\,000\\,\\text{mg}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-714d66f5-880a-57a3-8906-c7225e602a0d"] :db/ensure [:question/validate]} {:db/id "answer-field-714d66f5-880a-57a3-8906-c7225e602a0d" :answer-field/id #uuid "714d66f5-880a-57a3-8906-c7225e602a0d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-89eb14c7-3396-57cc-8125-3582ba70871e" :answer-field/choices ["answer-89eb14c7-3396-57cc-8125-3582ba70871e"] :db/ensure [:answer-field/validate]} {:db/id "answer-89eb14c7-3396-57cc-8125-3582ba70871e" :answer/id #uuid "89eb14c7-3396-57cc-8125-3582ba70871e" :answer/type :answer.type/math :answer/value "4000" :db/ensure [:answer/validate]} {:db/id "question-706f7978-b984-597c-b5ee-5c4df365adea" :question/id #uuid "706f7978-b984-597c-b5ee-5c4df365adea" :question/math-academy-id "q-143932" :question/problem "What is $1.2\\,\\text{g}$ expressed in $\\text{mg}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\text{kg}$ | $1\\,\\text{kg}=1\\,000\\,\\text{g}$ |\n| Gram | $\\text{g}$ | Base Unit |\n| Milligram | $\\text{mg}$ | $1\\,000\\,\\text{mg}=1\\,\\text{g}$ |\n\n$$\n\n$$\n\nThere are $1000\\,\\text{mg}$ per $\\text{g},$ which we can write as follows:\n\n$$\n\\frac{1000\\,\\text{mg}}{\\text{g}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $1.2\\,\\text{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}1.2\\,\\text{g} & =1.2\\,\\text{g}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\text{g}} \\\\  & =1.2\\,\\cancel{\\text{g}}\\cdot \\frac{1\\,000\\,\\text{mg}}{\\cancel{\\text{g}}} \\\\  & =1.2\\cdot 1\\,000\\,\\text{mg} \\\\  & =1\\,200\\,\\text{mg}.\\end{aligned}\n$$\n\nTherefore, $1.2\\,\\text{g}$ is equivalent to $1\\,200\\,\\text{mg}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f0a01842-e2fe-5801-9d9d-0aa4136c36e7"] :db/ensure [:question/validate]} {:db/id "answer-field-f0a01842-e2fe-5801-9d9d-0aa4136c36e7" :answer-field/id #uuid "f0a01842-e2fe-5801-9d9d-0aa4136c36e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1eebb549-c8b6-5a56-864b-c66e34c6003b" :answer-field/choices ["answer-de1249bf-0108-55a7-8241-4de49f5be6a8" "answer-4619eae4-0b7a-5046-abf3-851ad72a223f" "answer-c688ee7a-5379-5305-9ac3-2746bd64998a" "answer-2cad8974-2411-59a1-8dec-b752ba429ba3" "answer-1eebb549-c8b6-5a56-864b-c66e34c6003b"] :db/ensure [:answer-field/validate]} {:db/id "answer-de1249bf-0108-55a7-8241-4de49f5be6a8" :answer/id #uuid "de1249bf-0108-55a7-8241-4de49f5be6a8" :answer/type :answer.type/math :answer/value "0.12\\,\\text{mg}" :db/ensure [:answer/validate]} {:db/id "answer-4619eae4-0b7a-5046-abf3-851ad72a223f" :answer/id #uuid "4619eae4-0b7a-5046-abf3-851ad72a223f" :answer/type :answer.type/math :answer/value "120\\,\\text{mg}" :db/ensure [:answer/validate]} {:db/id "answer-c688ee7a-5379-5305-9ac3-2746bd64998a" :answer/id #uuid "c688ee7a-5379-5305-9ac3-2746bd64998a" :answer/type :answer.type/math :answer/value "12\\,000\\,\\text{mg}" :db/ensure [:answer/validate]} {:db/id "answer-2cad8974-2411-59a1-8dec-b752ba429ba3" :answer/id #uuid "2cad8974-2411-59a1-8dec-b752ba429ba3" :answer/type :answer.type/math :answer/value "12\\,\\text{mg}" :db/ensure [:answer/validate]} {:db/id "answer-1eebb549-c8b6-5a56-864b-c66e34c6003b" :answer/id #uuid "1eebb549-c8b6-5a56-864b-c66e34c6003b" :answer/type :answer.type/math :answer/value "1\\,200\\,\\text{mg}" :db/ensure [:answer/validate]} {:db/id "question-c39561ec-a1cc-5663-9505-34bb8c6d7da3" :question/id #uuid "c39561ec-a1cc-5663-9505-34bb8c6d7da3" :question/math-academy-id "q-144483" :question/problem "What is $4\\,250\\,\\text{g}$ expressed in $\\text{kg}?$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\text{kg}$ | $1\\,\\text{kg}=1\\,000\\,\\text{g}$ |\n| Gram | $\\text{g}$ | Base Unit |\n| Milligram | $\\text{mg}$ | $1\\,000\\,\\text{mg}=1\\,\\text{g}$ |\n\n$$\n\n$$\n\nThere are $1000\\,\\text{g}$ per $\\text{kg},$ which we can write as follows:\n\n$$\n\\frac{1000\\,\\text{g}}{\\text{kg}}\n$$\n\nHowever, since we're converting from a smaller unit of mass $(\\text{g})$ to a larger one $(\\text{kg}),$ we need to multiply $4\\,250\\,\\text{g}$ by the reciprocal of the above:\n\n$$\n\\frac{\\text{kg}}{1000\\,\\text{g}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $4\\,250\\,\\text{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}4\\,250\\,\\text{g} & =4\\,250\\,\\text{g}\\cdot \\frac{\\text{kg}}{1000\\,\\text{g}} \\\\  & =4\\,250\\,\\cancel{\\text{g}}\\cdot \\frac{\\text{kg}}{1000\\,\\cancel{\\text{g}}} \\\\  & =4\\,250\\cdot \\frac{\\text{kg}}{1000} \\\\  & =\\frac{4\\,250}{1\\,000}\\,\\text{kg} \\\\  & =4.25\\,\\text{kg}\\end{aligned}\n$$\n\nTherefore, $4\\,250\\,\\text{g}$ is equivalent to $4.25\\,\\text{kg}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-12d6fe8f-f9ec-5a5a-8522-1a53ad493d89"] :db/ensure [:question/validate]} {:db/id "answer-field-12d6fe8f-f9ec-5a5a-8522-1a53ad493d89" :answer-field/id #uuid "12d6fe8f-f9ec-5a5a-8522-1a53ad493d89" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d7f626a1-cdc2-5016-ab34-7e51c45dfed4" :answer-field/choices ["answer-eb3426a9-b633-5756-85d2-c2713d97acdf" "answer-d7f626a1-cdc2-5016-ab34-7e51c45dfed4" "answer-cd4cebad-e119-5024-82cc-6b14a701f646" "answer-cd41eb99-db53-56e4-95f4-95871d96a14d" "answer-7fd155fc-13e6-5e43-809a-576916af60f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb3426a9-b633-5756-85d2-c2713d97acdf" :answer/id #uuid "eb3426a9-b633-5756-85d2-c2713d97acdf" :answer/type :answer.type/math :answer/value "0.425\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-d7f626a1-cdc2-5016-ab34-7e51c45dfed4" :answer/id #uuid "d7f626a1-cdc2-5016-ab34-7e51c45dfed4" :answer/type :answer.type/math :answer/value "4.25\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-cd4cebad-e119-5024-82cc-6b14a701f646" :answer/id #uuid "cd4cebad-e119-5024-82cc-6b14a701f646" :answer/type :answer.type/math :answer/value "42.5\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-cd41eb99-db53-56e4-95f4-95871d96a14d" :answer/id #uuid "cd41eb99-db53-56e4-95f4-95871d96a14d" :answer/type :answer.type/math :answer/value "425\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-7fd155fc-13e6-5e43-809a-576916af60f9" :answer/id #uuid "7fd155fc-13e6-5e43-809a-576916af60f9" :answer/type :answer.type/math :answer/value "42\\,500\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id 17592186188876 :question/problem "What is $750\\,\\text{g}$ expressed in $\\text{kg}?$ Write your answer as a decimal in its simplest form.\n\n$750\\,\\text{g}=$\n{{field-1}}$\\text{kg}$" :question/worked-solution "We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\text{kg}$ | $1\\,\\text{kg}=1\\,000\\,\\text{g}$ |\n| Gram | $\\text{g}$ | Base Unit |\n| Milligram | $\\text{mg}$ | $1\\,000\\,\\text{mg}=1\\,\\text{g}$ |\n\n$$\n\n$$\n\nThere are $1000\\,\\text{g}$ per $\\text{kg},$ which we can write as follows:\n\n$$\n\\frac{1000\\,\\text{g}}{\\text{kg}}\n$$\n\nHowever, since we're converting from a smaller unit of mass $(\\text{g})$ to a larger one $(\\text{kg}),$ we need to multiply $750\\,\\text{g}$ by the reciprocal of the above:\n\n$$\n\\frac{\\text{kg}}{1000\\,\\text{g}}\n$$\n\nThis is our conversion factor.\n\nNow, multiplying $750\\,\\text{g}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}750\\,\\text{g} & =750\\,\\text{g}\\cdot \\frac{\\text{kg}}{1000\\,\\text{g}} \\\\  & =750\\,\\cancel{\\text{g}}\\cdot \\frac{\\text{kg}}{1000\\,\\cancel{\\text{g}}} \\\\  & =750\\cdot \\frac{\\text{kg}}{1000} \\\\  & =\\frac{750}{1\\,000}\\,\\text{kg} \\\\  & =0.75\\,\\text{kg}\\end{aligned}\n$$\n\nTherefore, $750\\,\\text{g}$ is equivalent to $0.75\\,\\text{kg}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186187421 :answer-field/correct "answer-a1481667-9cab-55a6-b3e0-73e6b6d01b50" :answer-field/choices ["answer-a1481667-9cab-55a6-b3e0-73e6b6d01b50"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1481667-9cab-55a6-b3e0-73e6b6d01b50" :answer/id #uuid "a1481667-9cab-55a6-b3e0-73e6b6d01b50" :answer/type :answer.type/math :answer/value "0.75" :db/ensure [:answer/validate]} {:db/id 17592186189493 :tutorial/content "We can manipulate units the same way as variables, which often provides a convenient way to solve problems. One type of problem where units can help is converting between different units of measurement. \n\nFor example, let's use units to convert $0.03\\,\\textrm{kg}$ into grams. We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nSince we're converting from kilograms to grams, we need a conversion between these two units. According to our table, there are $1000\\,\\textrm g$ per $\\textrm{kg}.$ We can write this ratio as a fraction, as follows:\n\n$$\n\\dfrac{1000\\,\\textrm g}{\\textrm{kg}}\n$$\n\nThis is our **conversion factor.** It's important to write the conversion factor with the units included.\n\nTo convert $0.03 \\,\\textrm{kg}$ to grams, we multiply this quantity by our conversion factor as follows:\n\n$$\n\\begin{aligned}0.03\\,\\text{kg} & =0.03\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}}\\end{aligned}\n$$\n\nNotice that the kilogram units $(\\textrm{kg})$ cancel, leaving only gram units $(\\textrm{g}).$ Consequently, our expression can be simplified as follows:\n\n$$\n\\begin{aligned}0.03\\,\\text{kg} & =0.03\\,\\text{kg}\\cdot \\frac{1\\,000\\,\\text{g}}{\\text{kg}} \\\\  & =0.03\\,\\cancel{\\text{kg}}\\cdot \\frac{1\\,000\\,\\text{g}}{\\cancel{\\text{kg}}} \\\\  & =0.03\\cdot 1\\,000\\,\\text{g} \\\\  & =30\\,\\text{g}\\end{aligned}\n$$\n\nTherefore, $0.03 \\,\\textrm{kg}$ is equivalent to $30 \\,\\text{g}.$\n\nNote the following:\n\n- When multiplying by the conversion factor, the units we want to remove should *always* cancel, and the units we wish to keep should *always* remain. If this isn't the case, we've made a mistake somewhere.\n\n- We can think of the conversion factor as equivalent to the number $1,$ and multiplying a quantity by $1$ doesn't change it. Therefore, multiplying $0.03\\,\\textrm{kg}$ by the conversion factor doesn't change the *size* of the quantity, though it does change the units.\n\nFinally, notice that, in this example, we've converted from a \"larger\" unit of mass $(\\textrm{kg})$ to a smaller one $(\\textrm{g}).$ We'll see how to use units to convert from smaller units of mass to larger units later in this lesson." :db/ensure [:tutorial/validate]} {:db/id 17592186189495 :tutorial/content "We've seen how to use units to convert from larger units of mass to smaller ones. Let's now learn how to convert from smaller units to larger ones.\n\nFor example, suppose we want to convert $600\\,\\textrm{mg}$ to grams. We start by recalling the conversion table for mass units. \n\n| Name | Symbol | Conversion |\n| --- | --- | --- |\n| Kilogram | $\\textrm{kg}$ | $1\\,\\textrm{kg} = 1\\,000\\,\\textrm{g}$ |\n| Gram | $\\textrm{g}$ | Base Unit |\n| Milligram | $\\textrm{mg}$ | $1\\,000\\,\\textrm{mg} = 1\\,\\textrm{g}$ |\n\nThere are $1000\\,\\textrm {mg}$ per $\\textrm{g},$ which we can write as follows:\n\n$$\n\\dfrac{1000\\,\\textrm{mg}}{\\textrm{g}}\n$$\n\nHowever, since we're converting from a smaller unit of mass $(\\textrm{mg})$ to a larger one $(\\textrm{g}),$ we construct our conversion factor by taking the *reciprocal* of the above:\n\n$$\n\\dfrac{\\textrm{g}}{1000\\,\\textrm{mg}}\n$$\n\nNow, multiplying $600 \\,\\textrm{mg}$ by our conversion factor, we get\n\n$$\n\\begin{aligned}600\\,\\text{mg} & =600\\,\\text{mg}\\cdot \\frac{\\text{g}}{1\\,000\\,\\text{mg}} \\\\  & =600\\,\\cancel{\\text{mg}}\\cdot \\frac{\\text{g}}{1\\,000\\,\\cancel{\\text{mg}}} \\\\  & =600\\cdot \\frac{\\text{g}}{1\\,000} \\\\  & =\\frac{600}{1000}\\,\\text{g} \\\\  & =0.6\\,\\text{g}\\end{aligned}\n$$\n\nTherefore, $600 \\,\\textrm{mg}$ is equivalent to $0.6\\,\\text{g}.$\n\nNote the following: \n\n- When we say that grams are a \"larger unit of mass\" than milligrams, this simply means that $1\\,\\textrm g$ is a larger mass than $1\\,\\textrm{mg}.$\n\n- If you forget to take the reciprocal to find the conversion factor, the units will not cancel when you multiply. This indicates that a mistake has occurred. In such cases, it's best to double-check that you're using the correct conversion factor." :db/ensure [:tutorial/validate]} {:db/id 17592186188462 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186122468 :answer-field/choices 17592186122469] [:db/retract 17592186122468 :answer-field/choices 17592186122470] [:db/retract 17592186122468 :answer-field/choices 17592186122471] [:db/retract 17592186122468 :answer-field/choices 17592186122472] [:db/retract 17592186122468 :answer-field/choices 17592186122473] [:db/retract 17592186122414 :answer-field/choices 17592186122416] [:db/retract 17592186122414 :answer-field/choices 17592186122419] {:db/id 17592186124464 :knowledge-point/questions ["question-726c12fc-e2ed-50f3-8cd6-76ed12fb7e44" "question-056dc885-9ad1-5245-b1aa-85becac66885"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124978 :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=2x+4y+5xy$ that passes through the point where $(x,y)=(2,1).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(2,1)$, can be found by computing $∇f(2,1).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(2,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(2x+4y+5xy)\\text{ }i+\\frac{∂}{∂y}(2x+4y+5xy)\\text{ }j \\\\  & =(5y+2)\\text{ }i+(5x+4)\\text{ }j \\\\ ∇f(2,1) & =(5\\cdot 1+2)\\text{ }i+(5\\cdot 2+4)\\text{ }j \\\\  & =7i+14j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(2,1):$\n\n$$\n\\begin{aligned}\\frac{∇f(2,1)}{‖∇f(2,1)‖} & =\\frac{7i+14j}{\\sqrt{{7}^{2}+(14)^{2}}} \\\\  & =\\frac{7i+14j}{7\\sqrt{5}} \\\\  & =\\frac{\\sqrt{5}}{5}(i+2\\,j)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186122468 :answer-field/correct "answer-cef8e14b-ece7-51a1-921e-23d70f9d2c98" :answer-field/choices ["answer-3c60959a-01b7-53b2-91be-83d1b906ea40" "answer-144e5910-b093-5cd4-abe0-394d07cded53" "answer-91e9dfc1-cddb-5022-b3ab-97f0a0267baa" "answer-cef8e14b-ece7-51a1-921e-23d70f9d2c98" "answer-812ac18a-9cbd-56eb-aadd-016577600a1e"] :db/ensure [:answer-field/validate]} {:db/id "answer-3c60959a-01b7-53b2-91be-83d1b906ea40" :answer/id #uuid "3c60959a-01b7-53b2-91be-83d1b906ea40" :answer/type :answer.type/math :answer/value "7\\,i+7\\,j" :db/ensure [:answer/validate]} {:db/id "answer-144e5910-b093-5cd4-abe0-394d07cded53" :answer/id #uuid "144e5910-b093-5cd4-abe0-394d07cded53" :answer/type :answer.type/math :answer/value "7\\,i-12\\,j" :db/ensure [:answer/validate]} {:db/id "answer-91e9dfc1-cddb-5022-b3ab-97f0a0267baa" :answer/id #uuid "91e9dfc1-cddb-5022-b3ab-97f0a0267baa" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}(2\\,i+j)" :db/ensure [:answer/validate]} {:db/id "answer-cef8e14b-ece7-51a1-921e-23d70f9d2c98" :answer/id #uuid "cef8e14b-ece7-51a1-921e-23d70f9d2c98" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}(i+2\\,j)" :db/ensure [:answer/validate]} {:db/id "answer-812ac18a-9cbd-56eb-aadd-016577600a1e" :answer/id #uuid "812ac18a-9cbd-56eb-aadd-016577600a1e" :answer/type :answer.type/math :answer/value "i-4j" :db/ensure [:answer/validate]} {:db/id 17592186124969 :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=2{x}^{2}+2{y}^{2}-y$ that passes through the point where $(x,y)=(0,1).$" :question/worked-solution "A normal vector to the level curve that passes through the point $(x,y)=(0,1)$ can be found by computing $∇f(0,1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y)=(0,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2{x}^{2}+2{y}^{2}-y)\\,i+\\frac{∂}{∂y}(2{x}^{2}+2{y}^{2}-y)\\,j \\\\  & =(4x+0-0)\\,i+(0+4y-1)\\,j \\\\  & =4x\\,i+(4y-1)\\,j \\\\ ∇f(0,1) & =4(0)\\,i+(4(1)-1)\\,j \\\\  & =3\\,j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(0,1):$\n\n$$\n\\frac{∇f(0,1)}{‖∇f(0,1)‖}=\\frac{3\\,j}{3}=j\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186122414 :answer-field/correct 17592186122417 :answer-field/choices ["answer-f9c75248-f110-5d02-9855-a77023469031" "answer-1c93b689-6924-505a-914c-f48d03994cf6"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9c75248-f110-5d02-9855-a77023469031" :answer/id #uuid "f9c75248-f110-5d02-9855-a77023469031" :answer/type :answer.type/math :answer/value "-i-j" :db/ensure [:answer/validate]} {:db/id "answer-1c93b689-6924-505a-914c-f48d03994cf6" :answer/id #uuid "1c93b689-6924-505a-914c-f48d03994cf6" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}i+\\frac{1}{\\sqrt{2}}j" :db/ensure [:answer/validate]} {:db/id "question-726c12fc-e2ed-50f3-8cd6-76ed12fb7e44" :question/id #uuid "726c12fc-e2ed-50f3-8cd6-76ed12fb7e44" :question/math-academy-id "q-37231" :question/problem "Find parametric equations for the normal line to the surface $\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})=1$ at the point $(0,0,\\sqrt{e}).$" :question/worked-solution "Let's set $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}).$ Then,  our surface can be viewed as the level surface $f(x,y,z)=1.$ \n\nA normal vector to the level surface that passes through the point $(0,0,\\sqrt{e})$ can be found by computing $∇f(0,0,\\sqrt{e}).$  \n\nSo, we find the gradient and evaluate it at $(0,0,\\sqrt{e}):$ \n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}))i+\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}))j+\\frac{∂}{∂z}(\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}))k \\\\  & =\\frac{2x}{{x}^{2}+{y}^{2}+{z}^{2}}\\text{ }i+\\frac{2y}{{x}^{2}+{y}^{2}+{z}^{2}}\\text{ }j+\\frac{2z}{{x}^{2}+{y}^{2}+{z}^{2}}\\text{ }k \\\\ ∇f(0,0,\\sqrt{e}) & =\\frac{2(0)}{(0)^{2}+(0)^{2}+(\\sqrt{e})^{2}}\\text{ }i+\\frac{2(0)}{(0)^{2}+(0)^{2}+(\\sqrt{e})^{2}}\\text{ }j+\\frac{2\\sqrt{e}}{(0)^{2}+(0)^{2}+(\\sqrt{e})^{2}}\\text{ }k \\\\  & =\\frac{2\\sqrt{e}}{e}k\\end{aligned}\n$$\n\nThe parametric equations for the normal line to $f(x,y,z)$ at a point $({x}_{0},{y}_{0},{z}_{0})$ are given by \n\n$$\n\\begin{aligned}x & ={x}_{0}+{f}_{x}({x}_{0},{y}_{0},{z}_{0})t, \\\\ y & ={y}_{0}+{f}_{y}({x}_{0},{y}_{0},{z}_{0})t, \\\\ z & ={z}_{0}+{f}_{z}({x}_{0},{y}_{0},{z}_{0})t.\\end{aligned}\n$$\n\nTherefore, the parametic equations  for the normal line to our surface that  passes through the point $(0,0,\\sqrt{e})$ can be written as \n \n\n$$\nx=0,\\,y=0,\\,z=\\sqrt{e}+\\frac{2t\\sqrt{e}}{e}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c615bb4c-1597-5b7b-a91f-2e2776baf55b"] :db/ensure [:question/validate]} {:db/id "answer-field-c615bb4c-1597-5b7b-a91f-2e2776baf55b" :answer-field/id #uuid "c615bb4c-1597-5b7b-a91f-2e2776baf55b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1711e24-9959-5e3d-beef-58d26c1f41b2" :answer-field/choices ["answer-84d505d2-2d10-57ad-9f74-f1753c66adec" "answer-f1711e24-9959-5e3d-beef-58d26c1f41b2" "answer-f43507f5-6454-586e-8980-28bd1f31c21d" "answer-ad368c2c-26d6-548c-b643-eedd79a18a15" "answer-7aae3ac3-02f2-5d2e-bd85-9eee8e2b917d"] :db/ensure [:answer-field/validate]} {:db/id "answer-84d505d2-2d10-57ad-9f74-f1753c66adec" :answer/id #uuid "84d505d2-2d10-57ad-9f74-f1753c66adec" :answer/type :answer.type/math :answer/value "x=-t,\\text{ }y=0,\\text{ }z=\\sqrt{e}+\\frac{t\\sqrt{e}}{e}" :db/ensure [:answer/validate]} {:db/id "answer-f1711e24-9959-5e3d-beef-58d26c1f41b2" :answer/id #uuid "f1711e24-9959-5e3d-beef-58d26c1f41b2" :answer/type :answer.type/math :answer/value "x=0,\\text{ }y=0,\\text{ }z=\\sqrt{e}+\\frac{2t\\sqrt{e}}{e}" :db/ensure [:answer/validate]} {:db/id "answer-f43507f5-6454-586e-8980-28bd1f31c21d" :answer/id #uuid "f43507f5-6454-586e-8980-28bd1f31c21d" :answer/type :answer.type/math :answer/value "x=0,\\text{ }y=t,\\text{ }z=\\sqrt{e}+2t\\sqrt{e}" :db/ensure [:answer/validate]} {:db/id "answer-ad368c2c-26d6-548c-b643-eedd79a18a15" :answer/id #uuid "ad368c2c-26d6-548c-b643-eedd79a18a15" :answer/type :answer.type/math :answer/value "x=t,\\text{ }y=0,\\text{ }z=\\sqrt{e}+\\frac{t\\sqrt{e}}{e}" :db/ensure [:answer/validate]} {:db/id "answer-7aae3ac3-02f2-5d2e-bd85-9eee8e2b917d" :answer/id #uuid "7aae3ac3-02f2-5d2e-bd85-9eee8e2b917d" :answer/type :answer.type/math :answer/value "x=t,\\text{ }y=t,\\text{ }z=\\frac{2t\\sqrt{e}}{e}" :db/ensure [:answer/validate]} {:db/id "question-056dc885-9ad1-5245-b1aa-85becac66885" :question/id #uuid "056dc885-9ad1-5245-b1aa-85becac66885" :question/math-academy-id "q-131125" :question/problem "Find a vector equation of the normal line to the surface ${x}^{2}-{y}^{2}=4-4z$ at the point $(0,2,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =4-4z \\\\ {x}^{2}-{y}^{2}+4z & =4\\end{aligned}\n$$\n\nIf we set $f(x,y,z)={x}^{2}-{y}^{2}+4z$, our surface can be viewed as the level surface $f(x,y,z)=4.$ \n\nA normal vector to the level surface that passes through the point $(0,2,2)$ can be found by computing $∇f(0,2,2).$ \n\nSo, we find the gradient and evaluate it at $(0,2,2):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{2}-{y}^{2}+4z)i+\\frac{∂}{∂y}({x}^{2}-{y}^{2}+4z)j+\\frac{∂}{∂z}({x}^{2}-{y}^{2}+4z)k \\\\  & =2x\\,i-2y\\,j+4\\,k \\\\ ∇f(0,2,2) & =2(0)\\,i-2(2)\\text{ }j+4\\,k \\\\  & =-4\\,j+4\\,k \\\\  & =⟨0,-4,4⟩\\end{aligned}\n$$\n\nFinally, the vector equation of the line that is parallel to $∇f(0,2,2)$ and passes through the point $(0,2,2)$ can be written as\n\n$$\n\\begin{aligned}r & =⟨0,2,2⟩+t\\,∇f(0,2,2)=⟨0,2,2⟩+t\\,⟨0,-4,4⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5dba8cbc-5d08-5d14-930e-b1a41b746cb3"] :db/ensure [:question/validate]} {:db/id "answer-field-5dba8cbc-5d08-5d14-930e-b1a41b746cb3" :answer-field/id #uuid "5dba8cbc-5d08-5d14-930e-b1a41b746cb3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77d647a0-cba4-5590-a1d5-ae95a15b5f05" :answer-field/choices ["answer-3b3d1a48-5c55-52da-b7e7-fd31db815995" "answer-af75210d-d1a7-57de-a250-0369260017a5" "answer-77d647a0-cba4-5590-a1d5-ae95a15b5f05" "answer-63801628-2a57-5777-861f-90cd5a83b242" "answer-161e6fd0-e925-55fa-8d09-6a65d107f751"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b3d1a48-5c55-52da-b7e7-fd31db815995" :answer/id #uuid "3b3d1a48-5c55-52da-b7e7-fd31db815995" :answer/type :answer.type/math :answer/value "⟨0,-4,-4⟩+t\\,⟨0,2,2⟩,\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-af75210d-d1a7-57de-a250-0369260017a5" :answer/id #uuid "af75210d-d1a7-57de-a250-0369260017a5" :answer/type :answer.type/math :answer/value "⟨0,-4,-4⟩+t\\,⟨2,2,0⟩,\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-77d647a0-cba4-5590-a1d5-ae95a15b5f05" :answer/id #uuid "77d647a0-cba4-5590-a1d5-ae95a15b5f05" :answer/type :answer.type/math :answer/value "⟨0,2,2⟩+t\\,⟨0,-4,4⟩,\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-63801628-2a57-5777-861f-90cd5a83b242" :answer/id #uuid "63801628-2a57-5777-861f-90cd5a83b242" :answer/type :answer.type/math :answer/value "⟨0,2,2⟩+t\\,⟨2,-4,4⟩,\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-161e6fd0-e925-55fa-8d09-6a65d107f751" :answer/id #uuid "161e6fd0-e925-55fa-8d09-6a65d107f751" :answer/type :answer.type/math :answer/value "⟨0,2,2⟩+t\\,⟨2,4,4⟩,\\,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186125735 :tutorial/content "Given a function $z=f(x,y)$, if both partial derivatives $f_x,$ $f_y$ exist and are continuous in a neighborhood of a point $P(x_0,y_0)$ in the domain of the function, and if $\\nabla \\! f(x_0,y_0) \\neq \\mathbf 0,$ then we have the following result:\n\n*$\\nabla \\! f(x_0,y_0)$ is a normal vector to the level curve $C$ that passes through the point $P.$ *\n\nThis property is one of the most important facts in multivariable calculus since it gives a fundamental  link between\ncalculus and geometry!\n\nLet's illustrate this property with a concrete example. Consider the paraboloid $z = f (x, y)=  x^2 + y^2$ and the level curve $\\color{red}C$ of $f(x,y)$ corresponding to the point $P(1,-1).$  It is easy to see that  $\\color{red}C$ is a circle of radius $\\sqrt{2}$ with equation $x^2+y^2 = 2.$ \n\n![](images/f2/f2461dbfcde2403e6ed7de9d6288d33a4deb52319d35b7036628c3fa8b3789dc.png)\n\nIn this particular instance, the property says that\n\n*$\\nabla \\! f(1,-1)$ is a normal vector to the level curve $\\color{red}C$ that passes through the point $P(1,-1).$ *\n\n![](images/48/481b68af522b9144e232d9c775f734cd998b31a21571cbfd983c23d0f68c3688.png)\n\nLooking at the situation in the $xy$-plane, we see the following:\n\n![](images/ce/ceb353d5164d6aa089a37e77c9469d747ef4430e363e42f9d35ee6d769d9a4e4.png)\n\nLet's verify that $\\nabla f(1,-1)$ is a normal line to the level curve $C$ at the point $P(1,-1).$\n\n- First, computing the gradient, we find that $\\nabla f = \\langle 2x, 2y \\rangle.$ Therefore, \n\n$$\n\\nabla f(1,-1) = \\langle 2, -2 \\rangle.\n$$\n\n- Then, using elementary calculus, we can show that the equation of the tangent to $C$ at $P$ is $y=x-2.$ Since this line has slope $m=1,$ it follows that the vector $\\langle 1,1 \\rangle$  is parallel to the level curve.\n\n- Finally, taking the dot product between the gradient and the tangent vector, we obtain\n\n$$\n\\nabla f(1,-1)\\cdot  \\langle 1,1 \\rangle = \\langle 2, -2\\rangle \\cdot \\langle 1,1 \\rangle = 0.\n$$\n\nThis means that $\\nabla f(1,-1)$ is *perpendicular* to the tangent line to $C$ at $(1,-1).$" :db/ensure [:tutorial/validate]} {:db/id 17592186125740 :tutorial/content "The same property holds true in the case of three or more variables. In general, if $f$ is a differentiable real-valued function of $n$ variables, $\\mathbf y$ is a point in the domain of $f,$ and if  the  gradient vector is nonzero, i.e., \n\n$$\n\\nabla f (\\mathbf y)= \\left \\langle f_{x_1}(\\mathbf y), f_{x_2}(\\mathbf y), \\cdots, f_{x_n}(\\mathbf y)\\right \\rangle \\neq \\mathbf 0,\n$$\n\nthen we have the following result:\n\n*$\\nabla f (\\mathbf y)$ is a normal vector to the level surface $f(x_1,x_2, \\cdots, x_n) =f(\\mathbf y)$ at $\\mathbf y.$*\n\nTo illustrate, let's consider the function  \n\n$$\nw = f (x, y, z)= \\dfrac 1 2\\left(x^2 + y^2 + z^2-1\\right).\n$$\n\n \n\nThe level surface corresponding to $w=0$ is the sphere $\\mathcal S$ with equation $x^2 + y^2 +z^2 =1.$ \n\nThe point $P(0,0,1)$ lies on $\\mathcal S.$ Computing $\\nabla f(0,0,1),$ we get\n\n$$\n\\eqalign{\n\\nabla f(x,y,z) &= \\langle f_x, \\: f_y, \\:f_z\\rangle \\[5pt]\n&= \\dfrac12\\langle2x, \\: 2y, \\: 2z\\rangle\\[5pt]\n&= \\langle x, \\: y, \\: z\\rangle\\[10pt]\n\n\\nabla f(0,0,1) &= \\langle 0,\\: 0,\\: 1 \\rangle.\n}\n$$\n\nNow clearly, $\\nabla f (0,0, 1)$ is perpendicular to $\\mathcal S$ at the point $(0,0,1).$\n\n![](images/88/88bf25de31ae3318379865cdf2590c15216cb984cbf3948f975caa47317be664.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186124731 :activity/expected-seconds 1260.0 :db/ensure [:activity/validate]} [:db/retract 17592186098995 :answer-field/choices 17592186098996] [:db/retract 17592186098995 :answer-field/choices 17592186098997] [:db/retract 17592186098995 :answer-field/choices 17592186098998] [:db/retract 17592186098995 :answer-field/choices 17592186098999] [:db/retract 17592186098995 :answer-field/choices 17592186099000] [:db/retract 17592186098983 :answer-field/choices 17592186098984] [:db/retract 17592186098983 :answer-field/choices 17592186098985] [:db/retract 17592186098983 :answer-field/choices 17592186098986] [:db/retract 17592186098983 :answer-field/choices 17592186098987] [:db/retract 17592186098983 :answer-field/choices 17592186098988] [:db/retract 17592186098989 :answer-field/choices 17592186098992] [:db/retract 17592186098989 :answer-field/choices 17592186098993] [:db/retract 17592186098989 :answer-field/choices 17592186098994] [:db/retract 17592186098989 :answer-field/choices 17592186098990] [:db/retract 17592186098989 :answer-field/choices 17592186098991] {:db/id 17592186100840 :knowledge-point/questions ["question-9c0fb2ee-81ac-5d75-ab41-5ee64f815cef" "question-ac9bf5e8-0b9b-5a4e-90d8-e2b158eca7f5" "question-c7823091-db8e-5d0b-aebf-c2f82fe402a4" "question-edfe2065-c6c9-560e-b435-e28eacd51b92"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100650 :question/problem "We wish to construct a cylindrical can with a base but no lid. Our cylinder must have an exact volume of $27\\pi\\, \\textrm{in}^3.$ What is the radius of the cylinder that gives the smallest surface area?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/ad/adb9c56132e8f346a07a9a644cd364c2347ad8c551a3c9bd4842b7067eb1d050.png)\n\nWe wish to minimize the surface area\n\n$$\nS= 2\\pi r h + \\pi r^2.\n$$\n\nWe know that the volume is fixed at $27\\pi \\, \\textrm{in}^3,$ so we also have the constraint condition\n\n$$\n27\\pi = \\pi r^2 h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh = \\dfrac{27}{ r^2}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\eqalign{\nS(r)& = 2\\pi r \\left(\\dfrac{27}{ r^2}\\right) + \\pi r^2\\\n & = \\dfrac{54\\pi}{r} +  \\pi r^2.}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\nS'(r) = -\\dfrac{54\\pi}{r^2} + 2\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{54\\pi }{{r}^{2}}+2\\pi r & =0 \\\\ 2\\pi r & =\\frac{54\\pi }{{r}^{2}} \\\\ 2\\pi {r}^{3} & =54\\pi  \\\\ {r}^{3} & =27 \\\\ r & =\\sqrt[3]{27} \\\\ r & =3\\,\\text{in}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r <   3$ then $S'(r) <         0,$ and if $r > 3$ then $S'(r) > 0,$ which means that the stationary point $r=3$ is indeed a minimum of $S(r).$\n\nTherefore, the cylinder with the smallest surface area has radius $r =3\\,\\textrm{in}.$" :db/ensure [:question/validate]} {:db/id 17592186100841 :knowledge-point/questions ["question-2c38e997-645f-5cbf-9057-08f6bff2619b" "question-c69ae447-8c86-5d03-83d6-e7f16c525735" "question-6f844afb-5020-5b9d-a059-ebc3dcd000de"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100651 :question/problem "We need to create a cylindrical tin with no lid using $25\\pi\\,\\mathrm{cm^2}$ of sheet metal. What is the radius $r$ of the cylinder that has the largest volume? \n\n![](images/a2/a2916167b3c8d4169339280fe67a0018b5d09a9784260cf6488cd6825753b2b9.png)" :question/worked-solution "First, let $r$ be the radius and $h$ be the height of the cylinder.\n\nWe wish to maximize the volume\n\n$$\nV = \\pi r^2 h.\n$$\n\nWe know that the surface area is fixed at $25\\pi\\,\\mathrm{cm^2},$ so we also have the constraint equation\n\n$$\n2\\pi r h + \\pi r^2 = 25\\pi.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that \n\n$$\n\\begin{aligned}2\\pi rh & =25\\pi -\\pi {r}^{2} \\\\ h & =\\frac{25\\pi -\\pi {r}^{2}}{2\\pi r} \\\\ h & =\\frac{25-{r}^{2}}{2r}.\\end{aligned}\n$$\n\nPlugging the above into our expression for $V,$ we obtain\n\n$$\n\\begin{aligned}V(r) & =\\pi {r}^{2}\\times \\frac{25-{r}^{2}}{2r} \\\\ V(r) & =\\frac{(25r-{r}^{3})\\pi }{2}.\\end{aligned}\n$$\n\nWe want to maximize $V,$ so we need to differentiate $V$ and set the derivative equal to zero. The derivative is\n \n\n$$\nV'(r) = \\frac{(25 - 3 r^2)\\pi}{2}.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{V}^{′}(r) & =0 \\\\ \\frac{(25-3{r}^{2})\\pi }{2} & =0 \\\\ 25 & =3{r}^{2} \\\\ {r}^{2} & =\\frac{25}{3} \\\\ r & =\\frac{5\\sqrt{3}}{3}\\,\\text{cm}\\end{aligned}\n$$\n\nNote that we only considered the positive root in the last step because the radius $r$ must be positive.\n\nFinally, we confirm that $r   = \\dfrac{5\\sqrt{3}}{3}$  is a maximum using the second derivative test. The second derivative is\n\n$$\nV''(r) = -3\\pi r,\n$$\n\nand we can see that $V''\\left( \\dfrac{5\\sqrt{3}}{3} \\right) < 0.$ So, the stationary point $r=\\dfrac{5\\sqrt{3}}{3}$ is indeed a maximum of $V(r).$\n\nTherefore, the cylinder with the largest volume has a radius of $r=\\dfrac{5\\sqrt{3}}{3} \\, \\textrm{cm}.$" :db/ensure [:question/validate]} {:db/id 17592186100945 :knowledge-point/questions ["question-e97a779e-762a-58e2-bd98-1b5dcb7b5e80" "question-ebb08e7a-2131-5a36-9f64-7c4d80a5d168" "question-904e690d-cf3b-5b36-80f3-f72dec8825a7" "question-f9befb55-60b4-591d-bab5-6cd215964711" "question-dcb7a44b-6317-5e52-8a59-4cac3f8ca2cd"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186100783 :question/problem "A manufacturer wishes to build a cylindrical tank with a base and a lid. The tank must have an exact volume of $18\\pi\\,\\mathrm{m}^3.$\nTo make the tank, the manufacturer uses two materials:\n\n- a metal sheet that costs $\\[math]1.50$ per $\\mathrm{m}^2$ for the lateral surface,\n\n- a metal sheet that costs $\\[/math]0.50$ per $\\mathrm{m}^2$ for the base and lid.\n\nWhat is the radius of the tank that gives the smallest possible manufacturing cost?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/d7/d72b9a87e460f841bbd135fd16806607c16aa0b37b2279727bd7d9eeeb9c6982.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h,$ as follows:\n\n$$\n\\begin{aligned}C & =2\\pi rh\\cdot 1.5+2\\pi {r}^{2}\\cdot 0.5 \\\\  & =3\\pi rh+\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe know that the volume is fixed at $18\\pi\\,\\textrm{m}^3,$ so we also have the constraint condition\n\n$$\n18\\pi = \\pi r^2 h.\n$$\n\nNow, by making $h$ the subject of the constant equation, we have that\n\n$$\nh = \\dfrac{18}{r^2}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =3\\pi r(\\frac{18}{{r}^{2}})+\\pi {r}^{2} \\\\  & =\\frac{54\\pi }{r}+\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\nC'(r) = -\\dfrac{54\\pi}{r^2} + 2\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{54\\pi }{{r}^{2}}+2\\pi r & =0 \\\\ 2\\pi r & =\\frac{54\\pi }{{r}^{2}} \\\\ 2\\pi {r}^{3} & =54\\pi  \\\\ {r}^{3} & =27 \\\\ r & =\\sqrt[3]{27} \\\\ r & =3\\,\\text{m}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r < 3$ then $C'(r) <    0,$ and if $r > 3$ then $C'(r) > 0,$ which means that the stationary point $r = 3$ is indeed a minimum of $C(r).$\n\nTherefore, the tank with the smallest manufacturing cost has radius $r = 3\\,\\textrm{m}.$" :db/ensure [:question/validate]} {:db/id "question-9c0fb2ee-81ac-5d75-ab41-5ee64f815cef" :question/id #uuid "9c0fb2ee-81ac-5d75-ab41-5ee64f815cef" :question/math-academy-id "q-117348" :question/problem "We wish to construct a cylindrical can with a base and a lid. Our cylinder must have an exact volume of $2\\,000\\pi \\,{\\text{cm}}^{3}.$ What is the radius of the cylinder that gives the smallest surface area?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/33/33c90b487d2b3036068acf4b771d2ca6ae95e8e8446b706b85fed058dc12a0bf.png)\n\nWe wish to minimize the surface area\n\n$$\nS=2\\pi rh+2\\pi {r}^{2}.\n$$\n\nWe know that the volume is fixed at $2\\,000\\pi \\,{\\text{cm}}^{3},$ so we also have the constraint condition\n\n$$\n2\\,000\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{2\\,000}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\begin{aligned}S(r) & =2\\pi r(\\frac{2\\,000}{{r}^{2}})+2\\pi {r}^{2} \\\\  & =\\frac{4\\,000\\pi }{r}+2\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\n{S}^{′}(r)=-\\frac{4\\,000\\pi }{{r}^{2}}+4\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{4\\,000\\pi }{{r}^{2}}+4\\pi r & =0 \\\\ 4\\pi r & =\\frac{4\\,000\\pi }{{r}^{2}} \\\\ 4\\pi {r}^{3} & =4\\,000\\pi  \\\\ {r}^{3} & =1\\,000 \\\\ r & =\\sqrt[3]{1\\,000} \\\\ r & =10\\,\\text{cm}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<10$ then ${S}^{′}(r)<0,$ and if $r>10$ then ${S}^{′}(r)>0,$ which means that the stationary point $r=10$ is indeed a minimum of $S(r).$\n\nTherefore, the cylinder with the smallest surface area has radius $r=10\\,\\text{cm}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c7e8ebb0-e3d6-56f0-bb35-2dd8e698b8c6"] :db/ensure [:question/validate]} {:db/id "answer-field-c7e8ebb0-e3d6-56f0-bb35-2dd8e698b8c6" :answer-field/id #uuid "c7e8ebb0-e3d6-56f0-bb35-2dd8e698b8c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f62f9599-77a5-5414-840d-7de4098038df" :answer-field/choices ["answer-f62f9599-77a5-5414-840d-7de4098038df" "answer-c4704d4c-6962-5e51-9c39-966e80ebd0ce" "answer-1b4a6c19-602c-54ee-8152-81351ed0e7e3" "answer-d1cdea9b-fce1-5271-9532-93edde53a638" "answer-d7cff4ee-3f14-55d3-aab1-becaa9d5c30e"] :db/ensure [:answer-field/validate]} {:db/id "answer-f62f9599-77a5-5414-840d-7de4098038df" :answer/id #uuid "f62f9599-77a5-5414-840d-7de4098038df" :answer/type :answer.type/math :answer/value "10\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-c4704d4c-6962-5e51-9c39-966e80ebd0ce" :answer/id #uuid "c4704d4c-6962-5e51-9c39-966e80ebd0ce" :answer/type :answer.type/math :answer/value "13\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-1b4a6c19-602c-54ee-8152-81351ed0e7e3" :answer/id #uuid "1b4a6c19-602c-54ee-8152-81351ed0e7e3" :answer/type :answer.type/math :answer/value "20\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-d1cdea9b-fce1-5271-9532-93edde53a638" :answer/id #uuid "d1cdea9b-fce1-5271-9532-93edde53a638" :answer/type :answer.type/math :answer/value "26\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-d7cff4ee-3f14-55d3-aab1-becaa9d5c30e" :answer/id #uuid "d7cff4ee-3f14-55d3-aab1-becaa9d5c30e" :answer/type :answer.type/math :answer/value "5\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id 17592186101279 :question/problem "We wish to construct a cylindrical can with a base but no lid. Our cylinder must have an exact volume of $64\\pi \\,{mm}^{3}.$ What is the smallest possible surface area of the cylinder?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/ce/cec96bdd2335ff5635d11c4ea6016257b35bd5450778a70ecc1f5e0156ccfe9e.png)\n\nWe wish to minimize the surface area\n\n$$\nS=2\\pi rh+\\pi {r}^{2}.\n$$\n\nWe know that the volume is fixed at $64\\pi \\,{mm}^{3},$ so we also have the constraint condition\n\n$$\n64\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{64}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\begin{aligned}S(r) & =2\\pi r(\\frac{64}{{r}^{2}})+\\pi {r}^{2} \\\\  & =\\frac{128\\pi }{r}+\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\n{S}^{′}(r)=-\\frac{128\\pi }{{r}^{2}}+2\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{128\\pi }{{r}^{2}}+2\\pi r & =0 \\\\ 2\\pi r & =\\frac{128\\pi }{{r}^{2}} \\\\ 2\\pi {r}^{3} & =128\\pi  \\\\ {r}^{3} & =64 \\\\ r & =\\sqrt[3]{64} \\\\ r & =4\\,\\text{mm}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<4$ then ${S}^{′}(r)<0,$ and if $r>4$ then ${S}^{′}(r)>0,$ which means that the stationary point $r=4$ is indeed a minimum of $S(r).$\n\nSo the cylinder with the smallest surface area has radius $r=4\\,\\text{mm}.$\n\nFinally, to find the smallest surface area, we substitute $r=4\\,\\text{mm}$ into the equation for the surface area $S:$\n\n$$\n\\begin{aligned}S(4) & =\\frac{128\\pi }{4}+\\pi (4)^{2} \\\\  & =32\\pi +16\\pi  \\\\  & =48\\pi \\,{\\text{mm}}^{2}\\end{aligned}\n$$\n\nTherefore, the smallest possible surface area of the cylinder is $S=48\\pi \\,{\\text{mm}}^{2}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186098995 :answer-field/correct "answer-1812698a-baa5-5c04-bbe5-0eaab253aef4" :answer-field/choices ["answer-39604b6a-d37e-5b93-b3dd-8a6382ccd526" "answer-b4088f69-4254-5878-a7c1-d3dc65b31298" "answer-f9db4585-c2cb-517d-a138-24946d17f8e5" "answer-1812698a-baa5-5c04-bbe5-0eaab253aef4" "answer-3f3c1da7-84f5-5398-886d-21fd3f98354d"] :db/ensure [:answer-field/validate]} {:db/id "answer-39604b6a-d37e-5b93-b3dd-8a6382ccd526" :answer/id #uuid "39604b6a-d37e-5b93-b3dd-8a6382ccd526" :answer/type :answer.type/math :answer/value "36\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-b4088f69-4254-5878-a7c1-d3dc65b31298" :answer/id #uuid "b4088f69-4254-5878-a7c1-d3dc65b31298" :answer/type :answer.type/math :answer/value "44\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f9db4585-c2cb-517d-a138-24946d17f8e5" :answer/id #uuid "f9db4585-c2cb-517d-a138-24946d17f8e5" :answer/type :answer.type/math :answer/value "45\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-1812698a-baa5-5c04-bbe5-0eaab253aef4" :answer/id #uuid "1812698a-baa5-5c04-bbe5-0eaab253aef4" :answer/type :answer.type/math :answer/value "48\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-3f3c1da7-84f5-5398-886d-21fd3f98354d" :answer/id #uuid "3f3c1da7-84f5-5398-886d-21fd3f98354d" :answer/type :answer.type/math :answer/value "49\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "question-ac9bf5e8-0b9b-5a4e-90d8-e2b158eca7f5" :question/id #uuid "ac9bf5e8-0b9b-5a4e-90d8-e2b158eca7f5" :question/math-academy-id "q-345153" :question/problem "We wish to construct a cylindrical can with a base but no lid. Our cylinder must have an exact volume of $8\\pi \\,{in}^{3}.$ What is the smallest possible surface area ${S}_{\\text{min}}$ of the cylinder? Do not round the answer.\n\n${S}_{\\text{min}}=$\n{{field-1}} ${\\text{in}}^{2}$" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/7f/7fe5dad64f7c065e693ed407e0f291ec995b4823a0356e11055d20a0ca89a53b.png)\n\nWe wish to minimize the surface area\n\n$$\nS=2\\pi rh+\\pi {r}^{2}.\n$$\n\nWe know that the volume is fixed at $8\\pi \\,{in}^{3},$ so we also have the constraint condition\n\n$$\n8\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{8}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\begin{aligned}S(r) & =2\\pi r(\\frac{8}{{r}^{2}})+\\pi {r}^{2} \\\\  & =\\frac{16\\pi }{r}+\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\n{S}^{′}(r)=-\\frac{16\\pi }{{r}^{2}}+2\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{16\\pi }{{r}^{2}}+2\\pi r & =0 \\\\ 2\\pi r & =\\frac{16\\pi }{{r}^{2}} \\\\ 2\\pi {r}^{3} & =16\\pi  \\\\ {r}^{3} & =8 \\\\ r & =\\sqrt[3]{8} \\\\ r & =2\\,\\text{in}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<2$ then ${S}^{′}(r)<0,$ and if $r>2$ then ${S}^{′}(r)>0,$ which means that the stationary point $r=2$ is indeed a minimum of $S(r).$\n\nFinally, to find the smallest surface area ${S}_{\\text{min}},$ we substitute $r=2\\,\\text{in}$ into the equation for the surface area $S:$\n\n$$\n\\begin{aligned}{S}_{\\text{min}}=S(2) & =\\frac{16\\pi }{2}+\\pi (2)^{2} \\\\  & =8\\pi +4\\pi  \\\\  & =12\\pi \\,{\\text{in}}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-329ea85a-eb09-5964-bdf1-0a1e6d289646"] :db/ensure [:question/validate]} {:db/id "answer-field-329ea85a-eb09-5964-bdf1-0a1e6d289646" :answer-field/id #uuid "329ea85a-eb09-5964-bdf1-0a1e6d289646" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b4e759ae-9980-5d3f-9810-8593734c7be3" :answer-field/choices ["answer-b4e759ae-9980-5d3f-9810-8593734c7be3"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4e759ae-9980-5d3f-9810-8593734c7be3" :answer/id #uuid "b4e759ae-9980-5d3f-9810-8593734c7be3" :answer/type :answer.type/math :answer/value "12\\pi" :db/ensure [:answer/validate]} {:db/id "question-c7823091-db8e-5d0b-aebf-c2f82fe402a4" :question/id #uuid "c7823091-db8e-5d0b-aebf-c2f82fe402a4" :question/math-academy-id "q-362573" :question/problem "We wish to construct a cylindrical can with a base and a lid. Our cylinder must have an exact volume of $128\\pi \\,{\\text{ft}}^{3}.$ What is the smallest surface area we can get? Round your answer to the nearest integer.\n\n$S=$\n{{field-1}} ${\\text{ft}}^{2}$" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/bb/bb9c356aadbb184aaa49c1fa1867da82d64ef40db9048c752c2a91d20704392a.png)\n\nWe wish to minimize the surface area\n\n$$\nS=2\\pi rh+2\\pi {r}^{2}.\n$$\n\nWe know that the volume is fixed at $128\\pi \\,{\\text{ft}}^{3},$ so we also have the constraint condition\n\n$$\n128\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{128}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\begin{aligned}S(r) & =2\\pi r(\\frac{128}{{r}^{2}})+2\\pi {r}^{2} \\\\  & =\\frac{256\\pi }{r}+2\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\n{S}^{′}(r)=-\\frac{256\\pi }{{r}^{2}}+4\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{256\\pi }{{r}^{2}}+4\\pi r & =0 \\\\ 4\\pi r & =\\frac{256\\pi }{{r}^{2}} \\\\ 4\\pi {r}^{3} & =256\\pi  \\\\ {r}^{3} & =64 \\\\ r & =\\sqrt[3]{64} \\\\  & =4\\,\\text{ft}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<4$ then ${S}^{′}(r)<0,$ and if $r>4$ then ${S}^{′}(r)>0,$ which means that the stationary point $r=4$ is indeed a minimum of $S(r).$\n\nFinally, to find the smallest surface area, we substitute $r=4\\,\\text{ft}$ into the equation for the surface area $S:$\n\n$$\n\\begin{aligned}S(4) & =\\frac{256\\pi }{4}+2\\pi (4)^{2} \\\\  & =301.592… \\\\  & ≈302\\,{\\text{ft}}^{2},\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nTherefore, the smallest possible surface area of the cylinder is $S=302\\,{\\text{ft}}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e9f0d32e-11c5-5d16-b8fb-323736868b33"] :db/ensure [:question/validate]} {:db/id "answer-field-e9f0d32e-11c5-5d16-b8fb-323736868b33" :answer-field/id #uuid "e9f0d32e-11c5-5d16-b8fb-323736868b33" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cc4354de-3fdb-5904-a007-8872deb32b34" :answer-field/choices ["answer-cc4354de-3fdb-5904-a007-8872deb32b34"] :db/ensure [:answer-field/validate]} {:db/id "answer-cc4354de-3fdb-5904-a007-8872deb32b34" :answer/id #uuid "cc4354de-3fdb-5904-a007-8872deb32b34" :answer/type :answer.type/math :answer/value "302" :db/ensure [:answer/validate]} {:db/id "question-edfe2065-c6c9-560e-b435-e28eacd51b92" :question/id #uuid "edfe2065-c6c9-560e-b435-e28eacd51b92" :question/math-academy-id "q-18451" :question/problem "We wish to construct a cylindrical can with a base and a lid. Our cylinder must have an exact volume of $686\\pi \\,{\\text{mm}}^{3}.$ What is the smallest surface we can get?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/ce/cec96bdd2335ff5635d11c4ea6016257b35bd5450778a70ecc1f5e0156ccfe9e.png)\n\nWe wish to minimize the surface area\n\n$$\nS=2\\pi rh+2\\pi {r}^{2}.\n$$\n\nWe know that the volume is fixed at $686\\pi \\,{\\text{mm}}^{3},$ so we also have the constraint condition\n\n$$\n686\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{686}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $S,$ we obtain\n\n$$\n\\begin{aligned}S(r) & =2\\pi r(\\frac{686}{{r}^{2}})+2\\pi {r}^{2} \\\\  & =\\frac{1\\,372\\pi }{r}+2\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $S,$ so we need to differentiate $S$ and set the derivative equal to zero. The derivative is \n\n$$\n{S}^{′}(r)=-\\frac{1\\,372\\pi }{{r}^{2}}+4\\pi r.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{S}^{′}(r) & =0 \\\\ -\\frac{1\\,372\\pi }{{r}^{2}}+4\\pi r & =0 \\\\ 4\\pi r & =\\frac{1\\,372\\pi }{{r}^{2}} \\\\ 4\\pi {r}^{3} & =1\\,372\\pi  \\\\ {r}^{3} & =343 \\\\ r & =\\sqrt[3]{343} \\\\  & =7\\,\\text{mm}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<7$ then ${S}^{′}(r)<0,$ and if $r>7$ then ${S}^{′}(r)>0,$ which means that the stationary point $r=7$ is indeed a minimum of $S(r).$\n\nTherefore, the cylinder with the smallest surface area has radius $r=7\\,\\text{mm}.$\n\nFinally, to find the smallest surface area, we substitute $r=7\\,\\text{mm}$ into the equation for the surface area $S:$\n\n$$\n\\begin{aligned}S(7) & =\\frac{1\\,372\\pi }{7}+2\\pi (7)^{2} \\\\  & =294\\pi \\,{\\text{mm}}^{2}.\\end{aligned}\n$$\n\nWe conclude that the smallest possible surface area of the cylinder is $S=294\\pi \\,{\\text{mm}}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-99d98916-c136-5f7e-898c-502b466106fa"] :db/ensure [:question/validate]} {:db/id "answer-field-99d98916-c136-5f7e-898c-502b466106fa" :answer-field/id #uuid "99d98916-c136-5f7e-898c-502b466106fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3aa62b7e-897f-5805-9918-dddd9fd86aee" :answer-field/choices ["answer-2bfc9292-582a-5130-b5d1-81e60b9f908c" "answer-3aa62b7e-897f-5805-9918-dddd9fd86aee" "answer-febe6f3b-813e-5306-859b-3fbeaedf67f1" "answer-d9abe97b-7da5-5c8a-875a-77732d84b70b" "answer-b20f290b-3e64-5a30-80ba-4390b357a9ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-2bfc9292-582a-5130-b5d1-81e60b9f908c" :answer/id #uuid "2bfc9292-582a-5130-b5d1-81e60b9f908c" :answer/type :answer.type/math :answer/value "286\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-3aa62b7e-897f-5805-9918-dddd9fd86aee" :answer/id #uuid "3aa62b7e-897f-5805-9918-dddd9fd86aee" :answer/type :answer.type/math :answer/value "294\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-febe6f3b-813e-5306-859b-3fbeaedf67f1" :answer/id #uuid "febe6f3b-813e-5306-859b-3fbeaedf67f1" :answer/type :answer.type/math :answer/value "306\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-d9abe97b-7da5-5c8a-875a-77732d84b70b" :answer/id #uuid "d9abe97b-7da5-5c8a-875a-77732d84b70b" :answer/type :answer.type/math :answer/value "324\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-b20f290b-3e64-5a30-80ba-4390b357a9ea" :answer/id #uuid "b20f290b-3e64-5a30-80ba-4390b357a9ea" :answer/type :answer.type/math :answer/value "424\\pi \\,{mm}^{2}" :db/ensure [:answer/validate]} {:db/id "question-2c38e997-645f-5cbf-9057-08f6bff2619b" :question/id #uuid "2c38e997-645f-5cbf-9057-08f6bff2619b" :question/math-academy-id "q-86214" :question/problem "![](images/ae/aefac5e84b9ea13ce039e4e2e04fda830be9ab9c17a62665ba5e5d3a7b7f6f68.png)\n\nWe need to create a cylindrical tin with no lid using $108\\pi \\,{cm}^{2}$ of a metal sheet. What is the radius $r$ of the cylinder that has the largest volume?" :question/worked-solution "First, let $r$ be the radius and $h$ be the height of the cylinder.\n\nWe wish to maximize the volume\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nWe know that the surface area is fixed at $108\\pi \\,{cm}^{2},$ so we also have the constraint equation\n\n$$\n2\\pi rh+\\pi {r}^{2}=108\\pi .\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\n\\begin{aligned}2\\pi rh & =108\\pi -\\pi {r}^{2} \\\\ h & =\\frac{108\\pi -\\pi {r}^{2}}{2\\pi r} \\\\ h & =\\frac{108-{r}^{2}}{2r}.\\end{aligned}\n$$\n\nPlugging the above into our expression for $V,$ we obtain\n\n$$\n\\begin{aligned}V(r) & =\\pi {r}^{2}\\times \\frac{108-{r}^{2}}{2r} \\\\ V(r) & =\\frac{(108r-{r}^{3})\\pi }{2}.\\end{aligned}\n$$\n\nWe want to maximize $V,$ so we need to differentiate $V$ and set the derivative equal to zero. The derivative is \n\n$$\n{V}^{′}(r)=\\frac{(108-3{r}^{2})\\pi }{2}.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{V}^{′}(r) & =0 \\\\ \\frac{(108-3{r}^{2})\\pi }{2} & =0 \\\\ 108 & =3{r}^{2} \\\\ {r}^{2} & =36 \\\\ r & =6\\,\\text{cm}\\end{aligned}\n$$\n\nNote that, in the last step, we only considered the positive root because the radius $r$ must be positive.\n\nFinally, we confirm that $r=6$ is a maximum using the second derivative test. The second derivative ${V}^{″}(r)$ is\n\n$$\n{V}^{″}(r)=\\frac{-6\\pi r}{2}=-3\\pi r,\n$$\n\nand we can see that ${V}^{″}(6)<0.$ So, the stationary point $r=6$ is indeed a maximum of $V(r).$\n\nTherefore, the cylinder with the largest volume has a radius of $r=6\\,\\text{cm}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-54b8aa91-91b7-5693-ae56-dd9da1291bd2"] :db/ensure [:question/validate]} {:db/id "answer-field-54b8aa91-91b7-5693-ae56-dd9da1291bd2" :answer-field/id #uuid "54b8aa91-91b7-5693-ae56-dd9da1291bd2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e91eb110-0036-519e-961d-9bf3cbe43d1b" :answer-field/choices ["answer-1af90d32-167e-5dde-80d0-f28ac27d5b95" "answer-6499d744-86b6-5872-9564-ad470372e5cf" "answer-e91eb110-0036-519e-961d-9bf3cbe43d1b" "answer-6b30217d-8f98-5d80-acc4-6367a9a59089" "answer-e89826da-5376-54ed-8486-970425f19ba4"] :db/ensure [:answer-field/validate]} {:db/id "answer-1af90d32-167e-5dde-80d0-f28ac27d5b95" :answer/id #uuid "1af90d32-167e-5dde-80d0-f28ac27d5b95" :answer/type :answer.type/math :answer/value "3\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-6499d744-86b6-5872-9564-ad470372e5cf" :answer/id #uuid "6499d744-86b6-5872-9564-ad470372e5cf" :answer/type :answer.type/math :answer/value "3\\sqrt{6}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-e91eb110-0036-519e-961d-9bf3cbe43d1b" :answer/id #uuid "e91eb110-0036-519e-961d-9bf3cbe43d1b" :answer/type :answer.type/math :answer/value "6\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-6b30217d-8f98-5d80-acc4-6367a9a59089" :answer/id #uuid "6b30217d-8f98-5d80-acc4-6367a9a59089" :answer/type :answer.type/math :answer/value "6\\sqrt{3}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-e89826da-5376-54ed-8486-970425f19ba4" :answer/id #uuid "e89826da-5376-54ed-8486-970425f19ba4" :answer/type :answer.type/math :answer/value "9\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id 17592186101277 :question/problem "![](images/50/50853fcaa44ff9b7d80e708e546275286541afc0b6ed05c4ca87ea3175364c09.png)\n\nWe need to create a cylindrical tin with no lid using $48\\pi \\,{cm}^{2}$ of sheet metal. What is the largest possible volume of the cylinder?" :question/worked-solution "First, let $r$ be the radius and $h$ be the height of the cylinder.\n\nWe wish to maximize the volume\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nWe know that the surface area is fixed at $48\\pi \\,{cm}^{2},$ so we also have the constraint equation\n\n$$\n2\\pi rh+\\pi {r}^{2}=48\\pi .\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\n\\begin{aligned}2\\pi rh & =48\\pi -\\pi {r}^{2} \\\\ h & =\\frac{48\\pi -\\pi {r}^{2}}{2\\pi r} \\\\ h & =\\frac{48-{r}^{2}}{2r}.\\end{aligned}\n$$\n\nPlugging the above into our expression for $V,$ we obtain\n\n$$\n\\begin{aligned}V(r) & =\\pi {r}^{2}\\times \\frac{48-{r}^{2}}{2r} \\\\ V(r) & =\\frac{(48r-{r}^{3})\\pi }{2}.\\end{aligned}\n$$\n\nWe want to maximize $V,$ so we need to differentiate $V$ and set the derivative equal to zero. The derivative is \n\n$$\n{V}^{′}(r)=\\frac{(48-3{r}^{2})\\pi }{2}.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{V}^{′}(r) & =0 \\\\ \\frac{(48-3{r}^{2})\\pi }{2} & =0 \\\\ 48 & =3{r}^{2} \\\\ {r}^{2} & =16 \\\\ r & =4\\,\\text{cm}\\end{aligned}\n$$\n\nNote that, in the last step, we only considered the positive root because the radius $r$ must be positive.\n\nFinally, we confirm that $r=4$ is a maximum using the second derivative test. The second derivative ${V}^{″}(r)$ is\n\n$$\n{V}^{″}(r)=\\frac{-6\\pi r}{2}=-3\\pi r,\n$$\n\nand we can see that ${V}^{″}(4)<0.$ So, the stationary point $r=4$ is indeed a maximum of $V(r).$\n\nSo the cylinder with the largest volume has a radius of $r=4\\,\\text{cm}.$\n\nFinally, to find the largest volume, we substitute $r=4\\,\\text{cm}$ into the equation for the volume $V:$\n\n$$\n\\begin{aligned}V(4) & =\\frac{(48(4)-(4)^{3})\\pi }{2} \\\\  & =\\frac{(192-64)\\pi }{2} \\\\  & =\\frac{128\\pi }{2} \\\\  & =64\\pi \\end{aligned}\n$$\n\nTherefore, the largest possible volume of the cylinder is $V=64\\pi \\,{\\text{cm}}^{3}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186098983 :answer-field/correct "answer-37d90ecc-799c-5966-9485-4403e472a148" :answer-field/choices ["answer-9a21a290-1231-5251-ae15-843e314d1d5a" "answer-a0205964-c271-505f-ba22-0f2acac8f600" "answer-37d90ecc-799c-5966-9485-4403e472a148" "answer-961c2b95-dc93-5b57-bf9b-e581d63cdc5b" "answer-9fcdc104-93f0-5be0-ac43-65beeb6f88d2"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a21a290-1231-5251-ae15-843e314d1d5a" :answer/id #uuid "9a21a290-1231-5251-ae15-843e314d1d5a" :answer/type :answer.type/math :answer/value "46\\pi \\,{cm}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-a0205964-c271-505f-ba22-0f2acac8f600" :answer/id #uuid "a0205964-c271-505f-ba22-0f2acac8f600" :answer/type :answer.type/math :answer/value "58\\pi \\,{cm}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-37d90ecc-799c-5966-9485-4403e472a148" :answer/id #uuid "37d90ecc-799c-5966-9485-4403e472a148" :answer/type :answer.type/math :answer/value "64\\pi \\,{cm}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-961c2b95-dc93-5b57-bf9b-e581d63cdc5b" :answer/id #uuid "961c2b95-dc93-5b57-bf9b-e581d63cdc5b" :answer/type :answer.type/math :answer/value "72\\pi \\,{cm}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-9fcdc104-93f0-5be0-ac43-65beeb6f88d2" :answer/id #uuid "9fcdc104-93f0-5be0-ac43-65beeb6f88d2" :answer/type :answer.type/math :answer/value "81\\pi \\,{cm}^{3}" :db/ensure [:answer/validate]} {:db/id 17592186101278 :question/problem "![](images/38/38883c7cc4bfe8c9ecccadfcc2d0c75ff66f79b19ff697c15ddbe53f4c63dbab.png)\n\nWe need to create a cylindrical tin with a lid using $216\\pi \\,{cm}^{2}$ of sheet metal. What is the radius $r$ of the cylinder that has the largest volume?" :question/worked-solution "First, let $r$ be the radius and $h$ be the height of the cylinder.\n\nWe wish to maximize the volume\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nWe know that the surface area is fixed at $216\\pi \\,{cm}^{2},$ so we also have the constraint equation\n\n$$\n2\\pi rh+2\\pi {r}^{2}=216\\pi .\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\n\\begin{aligned}2\\pi rh & =216\\pi -2\\pi {r}^{2} \\\\ h & =\\frac{216\\pi -2\\pi {r}^{2}}{2\\pi r} \\\\ h & =\\frac{108-{r}^{2}}{r}.\\end{aligned}\n$$\n\nPlugging the above into our expression for $V,$ we obtain\n\n$$\n\\begin{aligned}V(r) & =\\pi {r}^{2}\\times \\frac{108-{r}^{2}}{r} \\\\ V(r) & =(108r-{r}^{3})\\pi .\\end{aligned}\n$$\n\nWe want to maximize $V,$ so we need to differentiate $V$ and set the derivative equal to zero. The derivative is \n\n$$\n{V}^{′}(r)=(108-3{r}^{2})\\pi .\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{V}^{′}(r) & =0 \\\\ (108-3{r}^{2})\\pi  & =0 \\\\ 108 & =3{r}^{2} \\\\ {r}^{2} & =36 \\\\ r & =6\\,\\text{cm}\\end{aligned}\n$$\n\nNote that, in the last step, we only considered the positive root because the radius $r$ must be positive.\n\nFinally, we confirm that $r=6$ is a maximum using the second derivative test. The second derivative ${V}^{″}(r)$ is\n\n$$\n{V}^{″}(r)=-6\\pi r,\n$$\n\nand we can see that ${V}^{″}(6)<0.$ So, the stationary point $r=6$ is indeed a maximum of $V(r).$\n\nTherefore, the cylinder with the largest volume has a radius of $r=6\\,\\text{cm}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186098989 :answer-field/correct "answer-5ef92129-ea31-5154-9c96-9f0c523bf5b4" :answer-field/choices ["answer-355100b8-e40f-5a0c-b5ea-ca6b62af8d72" "answer-e1698f51-ddd7-52d0-a197-1eac20e0fb64" "answer-e892c93e-e0a8-5845-a04d-6f979c4c9224" "answer-5ef92129-ea31-5154-9c96-9f0c523bf5b4" "answer-9f956854-f677-5cc1-9e81-5366dfda3bfe"] :db/ensure [:answer-field/validate]} {:db/id "answer-355100b8-e40f-5a0c-b5ea-ca6b62af8d72" :answer/id #uuid "355100b8-e40f-5a0c-b5ea-ca6b62af8d72" :answer/type :answer.type/math :answer/value "12\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-e1698f51-ddd7-52d0-a197-1eac20e0fb64" :answer/id #uuid "e1698f51-ddd7-52d0-a197-1eac20e0fb64" :answer/type :answer.type/math :answer/value "13\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-e892c93e-e0a8-5845-a04d-6f979c4c9224" :answer/id #uuid "e892c93e-e0a8-5845-a04d-6f979c4c9224" :answer/type :answer.type/math :answer/value "14\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-5ef92129-ea31-5154-9c96-9f0c523bf5b4" :answer/id #uuid "5ef92129-ea31-5154-9c96-9f0c523bf5b4" :answer/type :answer.type/math :answer/value "6\\,cm" :db/ensure [:answer/validate]} {:db/id "answer-9f956854-f677-5cc1-9e81-5366dfda3bfe" :answer/id #uuid "9f956854-f677-5cc1-9e81-5366dfda3bfe" :answer/type :answer.type/math :answer/value "7\\,cm" :db/ensure [:answer/validate]} {:db/id "question-c69ae447-8c86-5d03-83d6-e7f16c525735" :question/id #uuid "c69ae447-8c86-5d03-83d6-e7f16c525735" :question/math-academy-id "q-16231" :question/problem "![](images/86/8689a80bf3fddc055072d11837cd5bf2a6b4e966d935816fa1e8b68454774d24.png)\n\nWe need to create a cylindrical tin with no lid using $64\\pi \\,{cm}^{2}$ of a metal sheet. What is the radius $r$ of the cylinder that has the largest volume?" :question/worked-solution "First, let $r$ be the radius and $h$ be the height of the cylinder.\n\nWe wish to maximize the volume\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nWe know that the surface area is fixed at $64\\pi \\,{cm}^{2},$ so we also have the constraint equation\n\n$$\n2\\pi rh+\\pi {r}^{2}=64\\pi .\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\n\\begin{aligned}2\\pi rh & =64\\pi -\\pi {r}^{2} \\\\ h & =\\frac{64\\pi -\\pi {r}^{2}}{2\\pi r} \\\\ h & =\\frac{64-{r}^{2}}{2r}.\\end{aligned}\n$$\n\nPlugging the above into our expression for $V,$ we obtain\n\n$$\n\\begin{aligned}V(r) & =\\pi {r}^{2}\\times \\frac{64-{r}^{2}}{2r} \\\\ V(r) & =\\frac{(64r-{r}^{3})\\pi }{2}.\\end{aligned}\n$$\n\nWe want to maximize $V,$ so we need to differentiate $V$ and set the derivative equal to zero. The derivative is \n\n$$\n{V}^{′}(r)=\\frac{(64-3{r}^{2})\\pi }{2}.\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{V}^{′}(r) & =0 \\\\ \\frac{(64-3{r}^{2})\\pi }{2} & =0 \\\\ 64 & =3{r}^{2} \\\\ {r}^{2} & =\\frac{64}{3} \\\\ r & =\\frac{8\\sqrt{3}}{3}\\,\\text{cm}\\end{aligned}\n$$\n\nNote that, in the last step, we only considered the positive root because the radius $r$ must be positive.\n\nFinally, we confirm that $r=\\frac{8\\sqrt{3}}{3}$ is a maximum using the second derivative test. The second derivative ${V}^{″}(r)$ is\n\n$$\n{V}^{″}(r)=\\frac{-6\\pi r}{2}=-3\\pi r,\n$$\n\nand we can see that ${V}^{″}(\\frac{8\\sqrt{3}}{3})<0.$ So, the stationary point $r=\\frac{8\\sqrt{3}}{3}$ is indeed a maximum of $V(r).$\n\nTherefore, the cylinder with the largest volume has a radius of $r=\\frac{8\\sqrt{3}}{3}\\,\\text{cm}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9f669200-1574-50fb-be9a-48d96ef7fd94"] :db/ensure [:question/validate]} {:db/id "answer-field-9f669200-1574-50fb-be9a-48d96ef7fd94" :answer-field/id #uuid "9f669200-1574-50fb-be9a-48d96ef7fd94" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-89e398d3-c766-5417-baa4-109f6c2e3d4c" :answer-field/choices ["answer-735a2653-a0e7-558e-8ab6-95a5bb2ed37e" "answer-d6da261c-3a8c-54a5-8d8c-d5b40017cbd9" "answer-6fc53d03-6d9e-5293-ba20-93007fa4827a" "answer-4e139e6d-04b2-50d6-80c2-c3eaf743883f" "answer-89e398d3-c766-5417-baa4-109f6c2e3d4c"] :db/ensure [:answer-field/validate]} {:db/id "answer-735a2653-a0e7-558e-8ab6-95a5bb2ed37e" :answer/id #uuid "735a2653-a0e7-558e-8ab6-95a5bb2ed37e" :answer/type :answer.type/math :answer/value "4\\sqrt{3}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-d6da261c-3a8c-54a5-8d8c-d5b40017cbd9" :answer/id #uuid "d6da261c-3a8c-54a5-8d8c-d5b40017cbd9" :answer/type :answer.type/math :answer/value "6\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-6fc53d03-6d9e-5293-ba20-93007fa4827a" :answer/id #uuid "6fc53d03-6d9e-5293-ba20-93007fa4827a" :answer/type :answer.type/math :answer/value "9\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-4e139e6d-04b2-50d6-80c2-c3eaf743883f" :answer/id #uuid "4e139e6d-04b2-50d6-80c2-c3eaf743883f" :answer/type :answer.type/math :answer/value "\\frac{7\\sqrt{3}}{2}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-89e398d3-c766-5417-baa4-109f6c2e3d4c" :answer/id #uuid "89e398d3-c766-5417-baa4-109f6c2e3d4c" :answer/type :answer.type/math :answer/value "\\frac{8\\sqrt{3}}{3}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "question-6f844afb-5020-5b9d-a059-ebc3dcd000de" :question/id #uuid "6f844afb-5020-5b9d-a059-ebc3dcd000de" :question/math-academy-id "q-117360" :question/problem "![](images/08/08f6351b8b95c87386d07466b6e876d72f33bc00034e83b360d03d23633d363d.png)\n\nWe need to create a cylindrical tin with a lid using $6\\pi \\,{ft}^{2}$ of sheet metal. What is the radius $r$ of the cylinder that has the largest volume?" :question/worked-solution "First, let $r$ be the radius and $h$ be the height of the cylinder.\n\nWe wish to maximize the volume\n\n$$\nV=\\pi {r}^{2}h.\n$$\n\nWe know that the surface area is fixed at $6\\pi \\,{cm}^{2},$ so we also have the constraint equation\n\n$$\n2\\pi rh+2\\pi {r}^{2}=6\\pi .\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\n\\begin{aligned}2\\pi rh & =6\\pi -2\\pi {r}^{2} \\\\ h & =\\frac{6\\pi -2\\pi {r}^{2}}{2\\pi r} \\\\ h & =\\frac{3-{r}^{2}}{r}.\\end{aligned}\n$$\n\nPlugging the above into our expression for $V,$ we obtain\n\n$$\n\\begin{aligned}V(r) & =\\pi {r}^{2}(\\frac{3-{r}^{2}}{r}) \\\\ V(r) & =(3r-{r}^{3})\\pi .\\end{aligned}\n$$\n\nWe want to maximize $V,$ so we need to differentiate $V$ and set the derivative equal to zero. The derivative is \n\n$$\n{V}^{′}(r)=(3-3{r}^{2})\\pi .\n$$\n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{V}^{′}(r) & =0 \\\\ (3-3{r}^{2})\\pi  & =0 \\\\ 3 & =3{r}^{2} \\\\ {r}^{2} & =1 \\\\ r & =1\\,\\text{ft}\\end{aligned}\n$$\n\nNote that, in the last step, we only considered the positive root because the radius $r$ must be positive.\n\nFinally, we confirm that $r=1$ is a maximum using the second derivative test. The second derivative ${V}^{″}(r)$ is\n\n$$\n{V}^{″}(r)=-6\\pi r,\n$$\n\nand we can see that ${V}^{″}(1)<0.$ So, the stationary point $r=1$ is indeed a maximum of $V(r).$\n\nTherefore, the cylinder with the largest volume has a radius of $r=1\\,\\text{ft}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a9d445ab-f7a7-5bd0-ba53-a5e0545e4523"] :db/ensure [:question/validate]} {:db/id "answer-field-a9d445ab-f7a7-5bd0-ba53-a5e0545e4523" :answer-field/id #uuid "a9d445ab-f7a7-5bd0-ba53-a5e0545e4523" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c59ab5af-5a91-5ef6-bd69-64c38848927c" :answer-field/choices ["answer-9c7dbb34-59dd-5e81-a863-a5c9d70d0ded" "answer-c59ab5af-5a91-5ef6-bd69-64c38848927c" "answer-a417d5b7-1f44-5776-946d-4b89b7864438" "answer-c5953b51-f0b1-5657-955a-863eedbda8b7" "answer-a7c2e494-cb43-5ca0-8464-d42be445ccc0"] :db/ensure [:answer-field/validate]} {:db/id "answer-9c7dbb34-59dd-5e81-a863-a5c9d70d0ded" :answer/id #uuid "9c7dbb34-59dd-5e81-a863-a5c9d70d0ded" :answer/type :answer.type/math :answer/value "10\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-c59ab5af-5a91-5ef6-bd69-64c38848927c" :answer/id #uuid "c59ab5af-5a91-5ef6-bd69-64c38848927c" :answer/type :answer.type/math :answer/value "1\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-a417d5b7-1f44-5776-946d-4b89b7864438" :answer/id #uuid "a417d5b7-1f44-5776-946d-4b89b7864438" :answer/type :answer.type/math :answer/value "2\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-c5953b51-f0b1-5657-955a-863eedbda8b7" :answer/id #uuid "c5953b51-f0b1-5657-955a-863eedbda8b7" :answer/type :answer.type/math :answer/value "3\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-a7c2e494-cb43-5ca0-8464-d42be445ccc0" :answer/id #uuid "a7c2e494-cb43-5ca0-8464-d42be445ccc0" :answer/type :answer.type/math :answer/value "6\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "question-e97a779e-762a-58e2-bd98-1b5dcb7b5e80" :question/id #uuid "e97a779e-762a-58e2-bd98-1b5dcb7b5e80" :question/math-academy-id "q-345215" :question/problem "A manufacturer wishes to build a cylindrical container with a base but no lid. The container must have an exact volume of $\\frac{125}{3}\\pi \\,{yd}^{3}.$\nTo make the container, the manufacturer uses two materials:\n\n- a plastic sheet that costs $$7.50$ per ${yd}^{2}$ for the lateral surface,\n\n- a plastic sheet that costs $$2.50$ per ${yd}^{2}$ for the base.\n\nWhat is the radius $r$ of the container that gives the smallest manufacturing cost? Do not round the answer.\n\n$r=$\n{{field-1}} $\\text{yd}$" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/55/55de2c06ea57724513e450cbf49a0477d63cd75bac601d5d95f0ba7e366852ff.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h$ as follows:\n\n$$\n\\begin{aligned}C & =2\\pi rh\\cdot 7.50+\\pi {r}^{2}\\cdot 2.50 \\\\  & =15\\pi rh+2.5\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe know that the volume is fixed at $\\frac{125}{3}\\pi \\,{\\text{yd}}^{3},$ so we also have the constraint condition\n\n$$\n\\frac{125}{3}\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{125}{3{r}^{2}}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =15\\pi r(\\frac{125}{3{r}^{2}})+2.5\\pi {r}^{2} \\\\  & =\\frac{625\\pi }{r}+2.5\\pi {r}^{2}\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\n{C}^{′}(r)=-\\frac{625\\pi }{{r}^{2}}+5\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{625\\pi }{{r}^{2}}+5\\pi r & =0 \\\\ 5\\pi r & =\\frac{625\\pi }{{r}^{2}} \\\\ 5\\pi {r}^{3} & =625\\pi  \\\\ {r}^{3} & =125 \\\\ r & =\\sqrt[3]{125} \\\\  & =5\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<5$ then ${C}^{′}(r)<0,$ and if $r>5$ then ${C}^{′}(r)>0,$ which means that the stationary point $r=5$ is indeed a minimum of $C(r).$\n\nTherefore, the container with the smallest manufacturing cost has radius $r=5\\,\\text{yd}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9dc3b0ba-69af-5706-afb5-6c4ce41ddf74"] :db/ensure [:question/validate]} {:db/id "answer-field-9dc3b0ba-69af-5706-afb5-6c4ce41ddf74" :answer-field/id #uuid "9dc3b0ba-69af-5706-afb5-6c4ce41ddf74" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-217e50a3-d416-5fd8-8e38-c8d5e7424bf9" :answer-field/choices ["answer-217e50a3-d416-5fd8-8e38-c8d5e7424bf9"] :db/ensure [:answer-field/validate]} {:db/id "answer-217e50a3-d416-5fd8-8e38-c8d5e7424bf9" :answer/id #uuid "217e50a3-d416-5fd8-8e38-c8d5e7424bf9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-ebb08e7a-2131-5a36-9f64-7c4d80a5d168" :question/id #uuid "ebb08e7a-2131-5a36-9f64-7c4d80a5d168" :question/math-academy-id "q-85731" :question/problem "A manufacturer wishes to build a cylindrical tank with a base but no lid. The tank must have an exact volume of $100\\pi \\,{m}^{3}.$\nTo make the tank, the manufacturer uses two materials:\n\n- a plastic sheet that costs $$2.5$ per ${m}^{2}$ for the lateral surface,\n\n- a plastic sheet that costs $$2$ per ${m}^{2}$ for the base.\n\nWhat is the radius of the tank that gives the smallest manufacturing cost?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/67/67c54d0a678e9ea9d02919abacf9b048778de19e3d0367669455439583b7a767.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h$ as follows:\n\n$$\n\\begin{aligned}C & =2\\pi rh\\cdot 2.5+\\pi {r}^{2}\\cdot 2 \\\\  & =5\\pi rh+2\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe know that the volume is fixed at $100\\pi \\,{\\text{m}}^{3},$ so we also have the constraint condition\n\n$$\n100\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constant equation, we have that\n\n$$\nh=\\frac{100}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =5\\pi r(\\frac{100}{{r}^{2}})+2\\pi {r}^{2} \\\\  & =\\frac{500\\pi }{r}+2\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\n{C}^{′}(r)=-\\frac{500\\pi }{{r}^{2}}+4\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{500\\pi }{{r}^{2}}+4\\pi r & =0 \\\\ 4\\pi r & =\\frac{500\\pi }{{r}^{2}} \\\\ 4\\pi {r}^{3} & =500\\pi  \\\\ {r}^{3} & =125 \\\\ r & =\\sqrt[3]{125} \\\\ r & =5\\,\\text{m}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<5$ then ${C}^{′}(r)<0,$ and if $r>5$ then ${C}^{′}(r)>0,$ which means that the stationary point $r=5$ is indeed a minimum of $C(r).$\n\nTherefore, the container with the smallest manufacturing cost has radius $r=5\\,\\text{m}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-34501908-abbd-572a-a01d-25d855b9ad7f"] :db/ensure [:question/validate]} {:db/id "answer-field-34501908-abbd-572a-a01d-25d855b9ad7f" :answer-field/id #uuid "34501908-abbd-572a-a01d-25d855b9ad7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5db31cea-417d-52b7-9fbf-ffb47cd2996b" :answer-field/choices ["answer-352d0b77-d507-5fa8-9984-728f0f7b7643" "answer-1c46be2e-d5f1-5ef8-a289-7d723f2d3602" "answer-5db31cea-417d-52b7-9fbf-ffb47cd2996b" "answer-89374edb-8117-5e96-8a69-ceaff369f502" "answer-4b86d54b-8785-555f-8b97-1ffd9f11afa6"] :db/ensure [:answer-field/validate]} {:db/id "answer-352d0b77-d507-5fa8-9984-728f0f7b7643" :answer/id #uuid "352d0b77-d507-5fa8-9984-728f0f7b7643" :answer/type :answer.type/math :answer/value "12\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-1c46be2e-d5f1-5ef8-a289-7d723f2d3602" :answer/id #uuid "1c46be2e-d5f1-5ef8-a289-7d723f2d3602" :answer/type :answer.type/math :answer/value "3\\sqrt[3]{2}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-5db31cea-417d-52b7-9fbf-ffb47cd2996b" :answer/id #uuid "5db31cea-417d-52b7-9fbf-ffb47cd2996b" :answer/type :answer.type/math :answer/value "5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-89374edb-8117-5e96-8a69-ceaff369f502" :answer/id #uuid "89374edb-8117-5e96-8a69-ceaff369f502" :answer/type :answer.type/math :answer/value "6\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-4b86d54b-8785-555f-8b97-1ffd9f11afa6" :answer/id #uuid "4b86d54b-8785-555f-8b97-1ffd9f11afa6" :answer/type :answer.type/math :answer/value "\\sqrt[3]{5}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "question-904e690d-cf3b-5b36-80f3-f72dec8825a7" :question/id #uuid "904e690d-cf3b-5b36-80f3-f72dec8825a7" :question/math-academy-id "q-86220" :question/problem "A manufacturer wishes to build a cylindrical container with a base but no lid. The container must have an exact volume of $72\\pi \\,{ft}^{3}.$\nTo make the container, the manufacturer uses two materials:\n\n- a plastic sheet that costs $$1.5$ per ${ft}^{2}$ for the lateral surface,\n\n- a plastic sheet that costs $$0.5$ per ${ft}^{2}$ for the base.\n\nWhat is the radius of the container that gives the smallest manufacturing cost?" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/95/959050ee306a96db3745f84bc7095d4e83a23ceadd819f0b749c04b20d5778d2.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h$ as follows:\n\n$$\n\\begin{aligned}C & =2\\pi rh\\cdot 1.5+\\pi {r}^{2}\\cdot 0.5 \\\\  & =3\\pi rh+0.5\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe know that the volume is fixed at $72\\pi \\,{\\text{ft}}^{3},$ so we also have the constraint condition\n\n$$\n72\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constant equation, we have that\n\n$$\nh=\\frac{72}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =3\\pi r(\\frac{72}{{r}^{2}})+0.5\\pi {r}^{2} \\\\  & =\\frac{216\\pi }{r}+0.5\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\n{C}^{′}(r)=-\\frac{216\\pi }{{r}^{2}}+\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{216\\pi }{{r}^{2}}+\\pi r & =0 \\\\ \\pi r & =\\frac{216\\pi }{{r}^{2}} \\\\ \\pi {r}^{3} & =216\\pi  \\\\ {r}^{3} & =216 \\\\ r & =\\sqrt[3]{216} \\\\ r & =6\\,\\text{ft}\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<6$ then ${C}^{′}(r)<0,$ and if $r>6$ then ${C}^{′}(r)>0,$ which means that the stationary point $r=6$ is indeed a minimum of $C(r).$\n\nTherefore, the container with the smallest manufacturing cost has radius $r=6\\,\\text{ft}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5ef94707-58e0-523c-a81d-81716ae5304a"] :db/ensure [:question/validate]} {:db/id "answer-field-5ef94707-58e0-523c-a81d-81716ae5304a" :answer-field/id #uuid "5ef94707-58e0-523c-a81d-81716ae5304a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-986be587-2ecf-570e-a688-8d2405f238d5" :answer-field/choices ["answer-dadc21a4-2efd-53e9-80c6-696e78b43e82" "answer-fd82aff3-659c-5501-969a-3e3bd0a5021f" "answer-986be587-2ecf-570e-a688-8d2405f238d5" "answer-0abcfa87-c2d8-55b9-8b6c-f6e6dc2c2e01" "answer-185a6029-68c4-5828-8b11-ace521807408"] :db/ensure [:answer-field/validate]} {:db/id "answer-dadc21a4-2efd-53e9-80c6-696e78b43e82" :answer/id #uuid "dadc21a4-2efd-53e9-80c6-696e78b43e82" :answer/type :answer.type/math :answer/value "2\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-fd82aff3-659c-5501-969a-3e3bd0a5021f" :answer/id #uuid "fd82aff3-659c-5501-969a-3e3bd0a5021f" :answer/type :answer.type/math :answer/value "3\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-986be587-2ecf-570e-a688-8d2405f238d5" :answer/id #uuid "986be587-2ecf-570e-a688-8d2405f238d5" :answer/type :answer.type/math :answer/value "6\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-0abcfa87-c2d8-55b9-8b6c-f6e6dc2c2e01" :answer/id #uuid "0abcfa87-c2d8-55b9-8b6c-f6e6dc2c2e01" :answer/type :answer.type/math :answer/value "7\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "answer-185a6029-68c4-5828-8b11-ace521807408" :answer/id #uuid "185a6029-68c4-5828-8b11-ace521807408" :answer/type :answer.type/math :answer/value "9\\,\\text{ft}" :db/ensure [:answer/validate]} {:db/id "question-f9befb55-60b4-591d-bab5-6cd215964711" :question/id #uuid "f9befb55-60b4-591d-bab5-6cd215964711" :question/math-academy-id "q-315673" :question/problem "A manufacturer wishes to build a cylindrical container with a base but no lid. The container must have an exact volume of $9\\pi \\,{ft}^{3}.$\nTo make the container, the manufacturer uses two materials:\n\n- a plastic sheet that costs $$4.50$ per ${ft}^{2}$ for the lateral surface,\n\n- a plastic sheet that costs $$1.50$ per ${ft}^{2}$ for the base.\n\nWhat is the radius $r$ of the container that gives the smallest manufacturing cost? Do not round the answer.\n\n$r=$\n{{field-1}} $\\text{ft}$" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/63/6393c2cbff5d727841ca78ac067ff7067114d6db8754454a30584f38e4a4ea87.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h$ as follows:\n\n$$\n\\begin{aligned}C & =2\\pi rh\\cdot 4.50+\\pi {r}^{2}\\cdot 1.50 \\\\  & =9\\pi rh+1.5\\pi {r}^{2}\\end{aligned}\n$$\n\nWe know that the volume is fixed at $9\\pi \\,{\\text{ft}}^{3},$ so we also have the constraint condition\n\n$$\n9\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{9}{{r}^{2}}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =9\\pi r(\\frac{9}{{r}^{2}})+1.5\\pi {r}^{2} \\\\  & =\\frac{81\\pi }{r}+1.5\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\n{C}^{′}(r)=-\\frac{81\\pi }{{r}^{2}}+3\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{81\\pi }{{r}^{2}}+3\\pi r & =0 \\\\ 3\\pi r & =\\frac{81\\pi }{{r}^{2}} \\\\ 3\\pi {r}^{3} & =81\\pi  \\\\ {r}^{3} & =27 \\\\ r & =\\sqrt[3]{27} \\\\  & =3\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<3$ then ${C}^{′}(r)<0,$ and if $r>3$ then ${C}^{′}(r)>0,$ which means that the stationary point $r=3$ is indeed a minimum of $C(r).$\n\nTherefore, the container with the smallest manufacturing cost has radius $r=3\\,\\text{ft}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-926323cc-4935-53fe-b3b6-46d63fc874f8"] :db/ensure [:question/validate]} {:db/id "answer-field-926323cc-4935-53fe-b3b6-46d63fc874f8" :answer-field/id #uuid "926323cc-4935-53fe-b3b6-46d63fc874f8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9596c44c-aa01-5bd0-a490-4163ead1bd61" :answer-field/choices ["answer-9596c44c-aa01-5bd0-a490-4163ead1bd61"] :db/ensure [:answer-field/validate]} {:db/id "answer-9596c44c-aa01-5bd0-a490-4163ead1bd61" :answer/id #uuid "9596c44c-aa01-5bd0-a490-4163ead1bd61" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-dcb7a44b-6317-5e52-8a59-4cac3f8ca2cd" :question/id #uuid "dcb7a44b-6317-5e52-8a59-4cac3f8ca2cd" :question/math-academy-id "q-345211" :question/problem "A manufacturer wishes to build a cylindrical container with a base but no lid. The container must have an exact volume of $\\frac{27}{4}\\pi \\,{in}^{3}.$\nTo make the container, the manufacturer uses two materials:\n\n- a plastic sheet that costs $$6$ per ${in}^{2}$ for the lateral surface,\n\n- a plastic sheet that costs $$1.50$ per ${in}^{2}$ for the base.\n\nWhat is the radius $r$ of the container that gives the smallest manufacturing cost? Do not round the answer.\n\n$r=$\n{{field-1}} $\\text{in}$" :question/worked-solution "First, let's draw a picture of a cylinder. Let $r$ be the radius, and $h$ the height.\n\n![](images/f3/f32cf2ca384f0f1b676e77e74dd4f02484f2ba585710fee88df6951607081a42.png)\n\nWe wish to minimize the manufacturing cost. We can express the manufacturing cost $C$ in terms of $r$ and $h$ as follows:\n\n$$\n\\begin{aligned}C & =2\\pi rh\\cdot 6+\\pi {r}^{2}\\cdot 1.50 \\\\  & =12\\pi rh+1.5\\pi {r}^{2}\\end{aligned}\n$$\n\nWe know that the volume is fixed at $\\frac{27}{4}\\pi \\,{\\text{in}}^{3},$ so we also have the constraint condition\n\n$$\n\\frac{27}{4}\\pi =\\pi {r}^{2}h.\n$$\n\nNow, by making $h$ the subject of the constraint equation, we have that\n\n$$\nh=\\frac{27}{4{r}^{2}}.\n$$\n\nPlugging the above into our expression for $C,$ we obtain\n\n$$\n\\begin{aligned}C(r) & =12\\pi r(\\frac{27}{4{r}^{2}})+1.5\\pi {r}^{2} \\\\  & =\\frac{81\\pi }{r}+1.5\\pi {r}^{2}.\\end{aligned}\n$$\n\nWe want to minimize $C,$ so we need to differentiate $C$ and set the derivative equal to zero. The derivative is \n\n$$\n{C}^{′}(r)=-\\frac{81\\pi }{{r}^{2}}+3\\pi r.\n$$\n\n \n\nSetting the derivative equal to zero and solving for $r$ gives a stationary point, as follows:\n\n$$\n\\begin{aligned}{C}^{′}(r) & =0 \\\\ -\\frac{81\\pi }{{r}^{2}}+3\\pi r & =0 \\\\ 3\\pi r & =\\frac{81\\pi }{{r}^{2}} \\\\ 3\\pi {r}^{3} & =81\\pi  \\\\ {r}^{3} & =27 \\\\ r & =\\sqrt[3]{27} \\\\  & =3\\end{aligned}\n$$\n\nUsing a calculator, we can verify that if $r<3$ then ${C}^{′}(r)<0,$ and if $r>3$ then ${C}^{′}(r)>0,$ which means that the stationary point $r=3$ is indeed a minimum of $C(r).$\n\nTherefore, the container with the smallest manufacturing cost has radius $r=3\\,\\text{in}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2fd7852a-49d4-5728-a9f3-6239cb8db233"] :db/ensure [:question/validate]} {:db/id "answer-field-2fd7852a-49d4-5728-a9f3-6239cb8db233" :answer-field/id #uuid "2fd7852a-49d4-5728-a9f3-6239cb8db233" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a58aaf0f-44ae-5462-9b2b-e39f22326505" :answer-field/choices ["answer-a58aaf0f-44ae-5462-9b2b-e39f22326505"] :db/ensure [:answer-field/validate]} {:db/id "answer-a58aaf0f-44ae-5462-9b2b-e39f22326505" :answer/id #uuid "a58aaf0f-44ae-5462-9b2b-e39f22326505" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186102011 :tutorial/content "Suppose we want to construct a cylindrical container with a fixed volume, yet we wish to use as little material as possible to minimize our production costs. \n\n![](images/33/339a377a68f93c78cf99b0f58333ab26c24bff91509dd707d22981d773ef077c.png)\n\nThis is yet another type of optimization problem. Let's remind ourselves of the general strategy for optimization problems.\n\n1\\. Draw a diagram of the situation, introducing variables where necessary.\n\n2\\. Write down the equation of the quantity that you're trying to maximize or minimize. This is the objective function, and it might include more than one variable.\n\n3\\. Write down the constraint equation.\n\n4\\. Use the constraint equation to write the objective function in terms of a single variable only.\n\n5\\. Differentiate the objective function, set it equal to zero, and solve for the stationary points.\n\n6\\. Test each stationary point using the second derivative test. Or you can use the first derivative test if it's easier.\n\nIn the following examples, we'll need to use the formulas for a cylindrical can's volume $V$ and surface area $S.$ For a cylinder with radius $r$ and height $h,$ its volume is given by the formula\n\n$$\nV = \\pi r^2 h.\n$$\n\nIf the cylinder is closed at both ends, its surface area $S$ is given by\n\n$$\n\\begin{aligned}S=2\\pi rh+2\\pi {r}^{2}.\\end{aligned}\n$$\n\nIf the cylinder is closed at only one end, its surface area $S$ is\n\n$$\n\\begin{aligned}S=2\\pi rh+\\pi {r}^{2}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186101069 :activity/expected-seconds 1380.0 :db/ensure [:activity/validate]} {:db/id 17592186101627 :step/math-academy-id 641455 :db/ensure [:step/validate]} {:db/id 17592186101628 :step/math-academy-id 641456 :db/ensure [:step/validate]} {:db/id 17592186101629 :step/math-academy-id 641460 :db/ensure [:step/validate]} {:db/id 17592186101788 :step/math-academy-id 641465 :db/ensure [:step/validate]} {:db/id 17592186064237 :knowledge-point/questions ["question-d7abcd6f-c9ce-5a9a-8667-2f8c0c4481fa" "question-0629bbb0-2921-5d85-ab43-d50c29c16b81"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063973 :question/problem "Find the values of $x$ that satisfy $2x - 5 \\leq 1$ and $7x +11 < -3.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection. \n\n- We start by solving $2x - 5 \\leq 1$:\n\n$$\n\\begin{aligned}2x-5 & \\le 1 \\\\ 2x-5+5 & \\le 1+5 \\\\ 2x & \\le 6 \\\\ \\frac{2x}{2} & \\le \\frac{6}{2} \\\\ x & \\le 3\\end{aligned}\n$$\n\n![](images/60/600e2c9a8560e61697b480de35a3d077d13624ba616514a060c4bcf4fa3f47e4.png)\n\n- Then, we solve $7x +11 < -3$:\n\n$$\n\\begin{aligned}7x+11 & <-3 \\\\ 7x+11-11 & <-3-11 \\\\ 7x & <-14 \\\\ \\frac{7x}{7} & <\\frac{-14}{7} \\\\ x & <-2\\end{aligned}\n$$\n\n![](images/b6/b6014786331de7693c3a1e0d502ea79fb049252fe9f3ecfcd49a873d996896fe.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/2e/2e5425630ece3ab7006378a7930aae0452c3d5261e7bfb579c97daf572b71d22.png)\n\nThus, the final solution is $x < -2.$" :db/ensure [:question/validate]} {:db/id 17592186064238 :knowledge-point/questions ["question-a6038f4d-7120-5131-9e5c-91d2792ec538" "question-8d7733a1-40a4-58cd-b679-edcbbad7631c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063975 :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}5x-35\\ge 0 \\\\ 7x>21\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $x$ that satisfy both $5x-35 \\geq 0$ and $7x > 21$ simultaneously.\n\n- First, we solve $5x-35 \\geq 0\\mathbin{:}$\n\n$$\n\\begin{aligned}5x-35 & \\ge 0 \\\\ 5x-35+35 & \\ge 0+35 \\\\ 5x & \\ge 35 \\\\ \\frac{5x}{5} & \\ge \\frac{35}{5} \\\\ x & \\ge 7\\end{aligned}\n$$\n\n![](images/48/4875553156dc3e4ec15ecdb6c848fd43d519941123d0d9763d209e9f1d6a52f6.png)\n\n- Then, we solve $7x > 21\\mathbin{:}$\n\n$$\n\\begin{aligned}7x & >21 \\\\ \\frac{7x}{7} & >\\frac{21}{7} \\\\ x & >3\\end{aligned}\n$$\n\n![](images/f7/f7a68da2d31f0bfe038252ac0dc9151d81bf854a7d33da591cbaef05f52bda28.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/27/27fbd7222a4a02d4a14c17c4043b55a2828e66c2d4dcb019598ea5efef2089e6.png)\n\nThus, the final solution is $x \\geq 7.$" :db/ensure [:question/validate]} {:db/id 17592186064239 :knowledge-point/questions ["question-e87205b7-fd26-557d-b1a6-8478d490d3c4" "question-ae0becce-68fd-5837-9300-0c55dedc4632"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063978 :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}2-7x\\ge 2 \\\\ 10x-3\\ge 7\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $x$ that satisfy both $2-7x \\geq 2$ and $10x-3 \\geq 7$ simultaneously. \n\n- First, we solve $2-7x \\geq 2\\mathbin{:}$ \n\n$$\n\\begin{aligned}2-7x & \\ge 2 \\\\ 2-7x-2 & \\ge 2-2 \\\\ -7x & \\ge 0 \\\\ (-1)\\cdot (-7x) & \\le (-1)\\cdot 0 \\\\ 7x & \\le 0 \\\\ \\frac{7x}{7} & \\le \\frac{0}{7} \\\\ x & \\le 0\\end{aligned}\n$$\n\n![](images/96/96957d6e6c105fd3734dbe478850287c1c8771873b94fedc4ee0ed5cebf41c40.png)\n\n- Then, we solve $10x-3 \\geq 7\\mathbin{:}$\n\n$$\n\\begin{aligned}10x-3 & \\ge 7 \\\\ 10x-3+3 & \\ge 7+3 \\\\ 10x & \\ge 10 \\\\ \\frac{10x}{10} & \\ge \\frac{10}{10} \\\\ x & \\ge 1\\end{aligned}\n$$\n\n![](images/9d/9d2d2e7b05bd4bcaf964353266e35bb12f406372ade7255accf6dc3503046f5c.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/98/98654d9ff727e680d0e1ba1ff88b9202248aba6a75a5002a01cd9d628cb6c5b3.png)\n\nIt turns out that the solutions do not overlap at all. Therefore, no values of $x$ satisfy both inequalities simultaneously. So, there is no solution." :db/ensure [:question/validate]} {:db/id 17592186064240 :knowledge-point/questions ["question-a0a0618e-ff8d-55ba-915b-f7de9b4bbbc9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063979 :question/problem "Find the set of values of $x$ that satisfy $1 \\lt 3x-2 \\leq 7$ and $2-3x \\leq -4.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $1 \\lt 3x-2 \\leq 7 \\,\\mathbin{:}$\n\n$$\n\\begin{aligned}1 & <3x-2\\le 7 \\\\ 1+2 & <3x-2+2\\le 7+2 \\\\ 3 & <3x\\le 9 \\\\ \\frac{3}{3} & <\\frac{3x}{3}\\le \\frac{9}{3} \\\\ 1 & <x\\le 3\\end{aligned}\n$$\n\n![](images/34/341633f5e132e1ab07af8969161c20443d65aec7e89ce0bc600868504dd19f9b.png)\n\n- Then, we solve  $2-3x \\leq -4 \\,\\mathbin{:}$\n\n$$\n\\begin{aligned}2-3x & \\le -4 \\\\ 2-3x-2 & \\le -4-2 \\\\ -3x & \\le -6 \\\\ (-1)\\cdot (-3x) & \\ge (-1)\\cdot (-6) \\\\ 3x & \\ge 6 \\\\ \\frac{3x}{3} & \\ge \\frac{6}{3} \\\\ x & \\ge 2\\end{aligned}\n$$\n\n![](images/06/06dafae801f6ed3900474c72437eb5a40376ed06bebf3c6eb568e6237c2d930d.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/9b/9b3bd118d0940d6336a32c25b8556dccb3c4085f75da7d3d8628725cf9105071.png)\n\n   \n\nThus, the final solution is $x \\in [2,3].$" :db/ensure [:question/validate]} {:db/id "question-d7abcd6f-c9ce-5a9a-8667-2f8c0c4481fa" :question/id #uuid "d7abcd6f-c9ce-5a9a-8667-2f8c0c4481fa" :question/math-academy-id "q-25599" :question/problem "Which number line shows the values of $x$ that satisfy $2x-7<5$ and $3x+3\\ge -3?$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection. \n\n- First, we solve $2x-7<5\\,:$ \n\n$$\n\\begin{aligned}2x-7 & <5 \\\\ 2x-7+7 & <5+7 \\\\ 2x & <12 \\\\ \\frac{2x}{2} & <\\frac{12}{2} \\\\ x & <6\\end{aligned}\n$$\n\n![](images/c3/c3f9a8f8d42c4e029fd7d5ce26ef05d9834f6bf443aa61c1e3a89d228e79efc5.png)\n\n$$\n\n$$\n\n- Then, we solve $3x+3\\ge -3\\,:$ \n\n$$\n\\begin{aligned}3x+3 & \\ge -3 \\\\ 3x+3-3 & \\ge -3-3 \\\\ 3x & \\ge -6 \\\\ \\frac{3x}{3} & \\ge \\frac{-6}{3} \\\\ x & \\ge -2\\end{aligned}\n$$\n\n![](images/62/6281ea0ab80bf4a785d92026a5ccd0929659851e177e8cc7d6f41a7994a29791.png)\n\n$$\n\n$$\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/1d/1da1439e3fff4e39a6b891d8b295eada7e67b49763bca0b080a076c833242d7e.png)\n\nThus, the final solution is $-2\\le x<6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-841ef974-3800-52e9-afb8-592ab264e005"] :db/ensure [:question/validate]} {:db/id "answer-field-841ef974-3800-52e9-afb8-592ab264e005" :answer-field/id #uuid "841ef974-3800-52e9-afb8-592ab264e005" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-60fb93e9-ddcc-5501-af28-4f45463dfb7d" :answer-field/choices ["answer-60fb93e9-ddcc-5501-af28-4f45463dfb7d" "answer-49110c8e-ecd1-5c0f-9b5f-3032782e305f" "answer-5be1f5c8-81c4-539d-9fe0-466cb70fe3a8" "answer-2d3a352e-0026-5fd0-b57a-2ee4ded5fa12" "answer-4d4d506c-989c-5ce8-a47e-9fd16c899779"] :db/ensure [:answer-field/validate]} {:db/id "answer-60fb93e9-ddcc-5501-af28-4f45463dfb7d" :answer/id #uuid "60fb93e9-ddcc-5501-af28-4f45463dfb7d" :answer/type :answer.type/image :answer/value "images/0d/0dd8dc2d8580100a728ef0406bf953670aee7787bb2d0e2c2a21ca454725d294.png" :db/ensure [:answer/validate]} {:db/id "answer-49110c8e-ecd1-5c0f-9b5f-3032782e305f" :answer/id #uuid "49110c8e-ecd1-5c0f-9b5f-3032782e305f" :answer/type :answer.type/image :answer/value "images/62/6281ea0ab80bf4a785d92026a5ccd0929659851e177e8cc7d6f41a7994a29791.png" :db/ensure [:answer/validate]} {:db/id "answer-5be1f5c8-81c4-539d-9fe0-466cb70fe3a8" :answer/id #uuid "5be1f5c8-81c4-539d-9fe0-466cb70fe3a8" :answer/type :answer.type/image :answer/value "images/85/857598f76c6c06c3d4dd345700bd46e63c855ea3af2d48b5b52b3473fccabdce.png" :db/ensure [:answer/validate]} {:db/id "answer-2d3a352e-0026-5fd0-b57a-2ee4ded5fa12" :answer/id #uuid "2d3a352e-0026-5fd0-b57a-2ee4ded5fa12" :answer/type :answer.type/image :answer/value "images/8b/8bc178b6dcfbc7dd36af32813847de4ecc85894c95eb7a6c53218a5ddf926e05.png" :db/ensure [:answer/validate]} {:db/id "answer-4d4d506c-989c-5ce8-a47e-9fd16c899779" :answer/id #uuid "4d4d506c-989c-5ce8-a47e-9fd16c899779" :answer/type :answer.type/text :answer/value "No solutions" :db/ensure [:answer/validate]} {:db/id "question-0629bbb0-2921-5d85-ab43-d50c29c16b81" :question/id #uuid "0629bbb0-2921-5d85-ab43-d50c29c16b81" :question/math-academy-id "q-51741" :question/problem "Find the values of $x$ that satisfy $7x>-7$ and $3x<3.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection. \n\n- First, we solve $7x>-7\\,:$ \n\n$$\n\\begin{aligned}7x & >-7 \\\\ \\frac{7x}{7} & >\\frac{-7}{7} \\\\ x & >-1\\end{aligned}\n$$\n\n![](images/9b/9b902e22e6808cf01993494e199b9fcbd184d084e385ef94cb9a1953c00abb7c.png)\n\n- Then, we solve $3x<3\\,:$\n\n$$\n\\begin{aligned}3x & <3 \\\\ \\frac{3x}{3} & >\\frac{3}{3} \\\\ x & <1\\end{aligned}\n$$\n\n![](images/ca/ca26af3420f15a115c44ddb234afe4226e850799b5f91625faaee4c4fad37a4a.png)\n\n$$\n\n$$\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/12/12b3a4dedd88b66e7c06812b83c3195e889bdf22d40e45432e8569aaf5764047.png)\n\n$$\n\n$$\n\nThus, the final solution is $-1<x<1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8807da01-297f-5334-a2ec-d198f503b63f"] :db/ensure [:question/validate]} {:db/id "answer-field-8807da01-297f-5334-a2ec-d198f503b63f" :answer-field/id #uuid "8807da01-297f-5334-a2ec-d198f503b63f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9c14257-676a-5895-b3f4-45d10dc5348c" :answer-field/choices ["answer-c9c14257-676a-5895-b3f4-45d10dc5348c" "answer-5607bd9f-094b-52df-9b8f-b5360356f13c" "answer-5c190c3b-2061-54ec-a536-390502430e73" "answer-709243d9-405b-5d1e-9eca-058aca83cabe" "answer-a563c648-2b23-5eee-ab23-59a4ebc2ed85"] :db/ensure [:answer-field/validate]} {:db/id "answer-c9c14257-676a-5895-b3f4-45d10dc5348c" :answer/id #uuid "c9c14257-676a-5895-b3f4-45d10dc5348c" :answer/type :answer.type/math :answer/value "-1<x<1" :db/ensure [:answer/validate]} {:db/id "answer-5607bd9f-094b-52df-9b8f-b5360356f13c" :answer/id #uuid "5607bd9f-094b-52df-9b8f-b5360356f13c" :answer/type :answer.type/math :answer/value "-1<x<3" :db/ensure [:answer/validate]} {:db/id "answer-5c190c3b-2061-54ec-a536-390502430e73" :answer/id #uuid "5c190c3b-2061-54ec-a536-390502430e73" :answer/type :answer.type/math :answer/value "-3<x<1" :db/ensure [:answer/validate]} {:db/id "answer-709243d9-405b-5d1e-9eca-058aca83cabe" :answer/id #uuid "709243d9-405b-5d1e-9eca-058aca83cabe" :answer/type :answer.type/math :answer/value "x<0" :db/ensure [:answer/validate]} {:db/id "answer-a563c648-2b23-5eee-ab23-59a4ebc2ed85" :answer/id #uuid "a563c648-2b23-5eee-ab23-59a4ebc2ed85" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id "question-a6038f4d-7120-5131-9e5c-91d2792ec538" :question/id #uuid "a6038f4d-7120-5131-9e5c-91d2792ec538" :question/math-academy-id "q-76000" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}4x-2>6 \\\\ 2x-9\\le 5\\end{aligned}\n$$" :question/worked-solution "To solve the system, we need to find the values of $x$ that satisfy both $4x-2>6$ and $2x-9\\le 5$ simultaneously.\n\n- First, we solve $4x-2>6\\,:$\n\n$$\n\\begin{aligned}4x-2 & >6 \\\\ 4x-2+2 & >6+2 \\\\ 4x & >8 \\\\ \\frac{4x}{4} & >\\frac{8}{4} \\\\ x & >2\\end{aligned}\n$$\n\n![](images/59/59523e51144ef776295ec43032def1bc0192351deb6294fbb2d56acd87bb2cac.png)\n\n- Then, we solve $2x-9\\le 5\\,:$\n\n$$\n\\begin{aligned}2x-9 & \\le 5 \\\\ 2x-9+9 & \\le 5 \\\\ 2x & \\le 14 \\\\ \\frac{2x}{2} & \\le \\frac{14}{2} \\\\ x & \\le 7\\end{aligned}\n$$\n\n![](images/b0/b0107bec7ccb2c56036de405a29870e8cfcc166cc6405f425fc3296ec8f1be2b.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/f9/f9ace3f6dd9d93b960c61bb31ca3858aefbb0e8d43f2392a643c078ae6111a0d.png)\n\nThus, the final solution is $2<x\\le 7.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-104238e8-9c93-53a1-911b-7297525db4c6"] :db/ensure [:question/validate]} {:db/id "answer-field-104238e8-9c93-53a1-911b-7297525db4c6" :answer-field/id #uuid "104238e8-9c93-53a1-911b-7297525db4c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-01e27701-894d-5377-af37-c37f1f254842" :answer-field/choices ["answer-b4f67fdb-16f0-5e5b-8a9c-e41c37a3fd25" "answer-ec7071aa-4a9c-591d-87df-d455d836a762" "answer-8d320ee1-75ce-5deb-9ea2-410b499994b3" "answer-01e27701-894d-5377-af37-c37f1f254842" "answer-e5497ec0-c287-5185-8021-dcc987cc188e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b4f67fdb-16f0-5e5b-8a9c-e41c37a3fd25" :answer/id #uuid "b4f67fdb-16f0-5e5b-8a9c-e41c37a3fd25" :answer/type :answer.type/math :answer/value "-2<x\\le 7" :db/ensure [:answer/validate]} {:db/id "answer-ec7071aa-4a9c-591d-87df-d455d836a762" :answer/id #uuid "ec7071aa-4a9c-591d-87df-d455d836a762" :answer/type :answer.type/math :answer/value "-7<x\\le 2" :db/ensure [:answer/validate]} {:db/id "answer-8d320ee1-75ce-5deb-9ea2-410b499994b3" :answer/id #uuid "8d320ee1-75ce-5deb-9ea2-410b499994b3" :answer/type :answer.type/math :answer/value "-7\\le x<-2" :db/ensure [:answer/validate]} {:db/id "answer-01e27701-894d-5377-af37-c37f1f254842" :answer/id #uuid "01e27701-894d-5377-af37-c37f1f254842" :answer/type :answer.type/math :answer/value "2<x\\le 7" :db/ensure [:answer/validate]} {:db/id "answer-e5497ec0-c287-5185-8021-dcc987cc188e" :answer/id #uuid "e5497ec0-c287-5185-8021-dcc987cc188e" :answer/type :answer.type/math :answer/value "2\\le x<7" :db/ensure [:answer/validate]} {:db/id "question-8d7733a1-40a4-58cd-b679-edcbbad7631c" :question/id #uuid "8d7733a1-40a4-58cd-b679-edcbbad7631c" :question/math-academy-id "q-218745" :question/problem "What is the solution to the following system of inequalities?\n\n$$\n\\{\\begin{aligned}3t-2<-8 \\\\ t+1<-2\\end{aligned}\n$$\n\nThe solution is\n$t$\n{{field-1}}{{field-2}}." :question/worked-solution "To solve the system, we need to find the values of $t$ that satisfy both $3t-2<-8$ and $t+1<-2$ simultaneously.\n\n- First, we solve $3t-2<-8\\,:$\n\n$$\n\\begin{aligned}3t-2 & <-8 \\\\ 3t-2+2 & <-8+2 \\\\ 3t & <-6 \\\\ \\frac{3t}{3} & <\\frac{-6}{3} \\\\ t & <-2\\end{aligned}\n$$\n\n![](images/b9/b97b78ec613e826f7f8beb7336d3c2f285fc58d9bbf0c0f9d59921f41de2b3b6.png)\n\n$$\n\n$$\n\n- Then, we solve $t+1<-2\\,:$\n\n$$\n\\begin{aligned}t+1 & <-2 \\\\ t+1-1 & <-2-1 \\\\ t & <-3\\end{aligned}\n$$\n\n![](images/cf/cfb26921afb706908f771e1934cf27c0ca6e248e9e3aca54f499af685393fa86.png)\n\n$$\n\n$$\n\nTo find the values of $t$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/6d/6d488376420476cf34798aeb3fced46770a177288b550f2e887348c582741321.png)\n\n \n\n$$\n\n$$\n\nThus, the final solution is $t<-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-cba0ab0d-68b9-5046-ba94-e69610135996" "answer-field-d4d2988b-6e70-5912-83af-e0291bc3bbdd"] :db/ensure [:question/validate]} {:db/id "answer-field-cba0ab0d-68b9-5046-ba94-e69610135996" :answer-field/id #uuid "cba0ab0d-68b9-5046-ba94-e69610135996" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-168b9cb9-0b5a-5321-bc25-0ee1691fa73d" :answer-field/choices ["answer-168b9cb9-0b5a-5321-bc25-0ee1691fa73d"] :db/ensure [:answer-field/validate]} {:db/id "answer-168b9cb9-0b5a-5321-bc25-0ee1691fa73d" :answer/id #uuid "168b9cb9-0b5a-5321-bc25-0ee1691fa73d" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-d4d2988b-6e70-5912-83af-e0291bc3bbdd" :answer-field/id #uuid "d4d2988b-6e70-5912-83af-e0291bc3bbdd" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7e2be036-b7d4-513b-97ca-fbb936d6cff0" :answer-field/choices ["answer-7e2be036-b7d4-513b-97ca-fbb936d6cff0"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e2be036-b7d4-513b-97ca-fbb936d6cff0" :answer/id #uuid "7e2be036-b7d4-513b-97ca-fbb936d6cff0" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "question-e87205b7-fd26-557d-b1a6-8478d490d3c4" :question/id #uuid "e87205b7-fd26-557d-b1a6-8478d490d3c4" :question/math-academy-id "q-156118" :question/problem "Find the set of values of $z$ that satisfy $1-z>3$ and $2z+1>5.$" :question/worked-solution "To solve the system, we solve each inequality separately and then find their intersection.\n\n- First, we solve $1-z>3:$ \n\n$$\n\\begin{aligned}1-z & >3 \\\\ 1-z-1 & >3-1 \\\\ -z & >2 \\\\ (-1)\\cdot (-z) & <(-1)\\cdot 2 \\\\ z & <-2\\end{aligned}\n$$\n\n![](images/72/72d4febdc48282faebade8f8a4b827a72b82433b054c6409752f892cb718ec85.png)\n\n- Then, we solve $2z+1>5:$\n\n$$\n\\begin{aligned}2z+1 & >5 \\\\ 2z+1-1 & >5-1 \\\\ 2z & >4 \\\\ \\frac{2z}{2} & >\\frac{4}{2} \\\\ z & >2\\end{aligned}\n$$\n\n![](images/84/84893a305567a0aaaafb6fd2393c62f05086780ce8c8a55b91ba68676ba309ce.png)\n\nTo find the values of $z$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/04/04b20be3eaf236e70aa5bdf8cf6e25b6838b3bb823fe16f926112fb1f5e02d6f.png)\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $z$ that satisfy both inequalities simultaneously. So, there is no solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-90ea46a7-9a19-5126-a84e-30034c4d5c82"] :db/ensure [:question/validate]} {:db/id "answer-field-90ea46a7-9a19-5126-a84e-30034c4d5c82" :answer-field/id #uuid "90ea46a7-9a19-5126-a84e-30034c4d5c82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-77d904be-ba18-55a6-9fa8-867bba7af7be" :answer-field/choices ["answer-f7766785-2d36-5b9e-b060-84124f5c69bc" "answer-cf0530c3-335a-560c-9890-ec8fda500e5c" "answer-182b0266-a773-5415-8347-595d6e1d47b1" "answer-583f1205-51d8-5889-ae9f-97360c8da465" "answer-77d904be-ba18-55a6-9fa8-867bba7af7be"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7766785-2d36-5b9e-b060-84124f5c69bc" :answer/id #uuid "f7766785-2d36-5b9e-b060-84124f5c69bc" :answer/type :answer.type/math :answer/value "z\\in (-1,2)" :db/ensure [:answer/validate]} {:db/id "answer-cf0530c3-335a-560c-9890-ec8fda500e5c" :answer/id #uuid "cf0530c3-335a-560c-9890-ec8fda500e5c" :answer/type :answer.type/math :answer/value "z\\in (-2,1)" :db/ensure [:answer/validate]} {:db/id "answer-182b0266-a773-5415-8347-595d6e1d47b1" :answer/id #uuid "182b0266-a773-5415-8347-595d6e1d47b1" :answer/type :answer.type/math :answer/value "z\\in (-2,2)" :db/ensure [:answer/validate]} {:db/id "answer-583f1205-51d8-5889-ae9f-97360c8da465" :answer/id #uuid "583f1205-51d8-5889-ae9f-97360c8da465" :answer/type :answer.type/math :answer/value "z\\in (-\\infty ,2)" :db/ensure [:answer/validate]} {:db/id "answer-77d904be-ba18-55a6-9fa8-867bba7af7be" :answer/id #uuid "77d904be-ba18-55a6-9fa8-867bba7af7be" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id "question-ae0becce-68fd-5837-9300-0c55dedc4632" :question/id #uuid "ae0becce-68fd-5837-9300-0c55dedc4632" :question/math-academy-id "q-76004" :question/problem "Find the set of values of $x$ that satisfy $4x+9\\ge 1$ and $1-3x>7.$" :question/worked-solution "To solve the system, we solve each inequality separately and then find their intersection.\n\n- First, we solve $4x+9\\ge 1\\,:$\n\n$$\n\\begin{aligned}4x+9 & \\ge 1 \\\\ 4x+9-9 & \\ge 1-9 \\\\ 4x & \\ge -8 \\\\ \\frac{4x}{4} & \\ge \\frac{-8}{4} \\\\ x & \\ge -2\\end{aligned}\n$$\n\n![](images/16/1673c69df6497fd90ddab9c51c208ca5110f0e3c5a03a101e3b46723e04081fe.png)\n\n$$\n\n$$\n\n- Then, we solve $1-3x>7\\,:$\n\n$$\n\\begin{aligned}1-3x & >7 \\\\ 1-3x-1 & >7-1 \\\\ -3x & >6 \\\\ (-1)\\cdot (-3x) & <(-1)\\cdot 6 \\\\ 3x & <-6 \\\\ \\frac{3x}{3} & <\\frac{-6}{3} \\\\ x & <-2\\end{aligned}\n$$\n\n![](images/b9/b97b78ec613e826f7f8beb7336d3c2f285fc58d9bbf0c0f9d59921f41de2b3b6.png)\n\n$$\n\n$$\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/54/544d23551ed218c0d7e373ba0d04dbe1ad51d587c452b875c1a45df2e896cd87.png)\n\n$$\n\n$$\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $x$ that satisfy both inequalities simultaneously. So, there is no solution." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-2be5b73b-52ea-5b0e-85cd-1bd1f22b7b52"] :db/ensure [:question/validate]} {:db/id "answer-field-2be5b73b-52ea-5b0e-85cd-1bd1f22b7b52" :answer-field/id #uuid "2be5b73b-52ea-5b0e-85cd-1bd1f22b7b52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-89fb18e0-e809-5f6e-87f3-671a7008175e" :answer-field/choices ["answer-748d9863-150c-5850-9738-ed30a65b54cf" "answer-359641cf-22bc-507d-af66-eb57e6b8acb9" "answer-a2d271bf-fcb0-5786-9bf4-9a7e39ea439d" "answer-fa5b9543-e03b-5065-9082-1691603a581e" "answer-89fb18e0-e809-5f6e-87f3-671a7008175e"] :db/ensure [:answer-field/validate]} {:db/id "answer-748d9863-150c-5850-9738-ed30a65b54cf" :answer/id #uuid "748d9863-150c-5850-9738-ed30a65b54cf" :answer/type :answer.type/math :answer/value "x\\in (-2,2]" :db/ensure [:answer/validate]} {:db/id "answer-359641cf-22bc-507d-af66-eb57e6b8acb9" :answer/id #uuid "359641cf-22bc-507d-af66-eb57e6b8acb9" :answer/type :answer.type/math :answer/value "x\\in (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a2d271bf-fcb0-5786-9bf4-9a7e39ea439d" :answer/id #uuid "a2d271bf-fcb0-5786-9bf4-9a7e39ea439d" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,2]" :db/ensure [:answer/validate]} {:db/id "answer-fa5b9543-e03b-5065-9082-1691603a581e" :answer/id #uuid "fa5b9543-e03b-5065-9082-1691603a581e" :answer/type :answer.type/math :answer/value "x\\in [-2,2)" :db/ensure [:answer/validate]} {:db/id "answer-89fb18e0-e809-5f6e-87f3-671a7008175e" :answer/id #uuid "89fb18e0-e809-5f6e-87f3-671a7008175e" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id "question-a0a0618e-ff8d-55ba-915b-f7de9b4bbbc9" :question/id #uuid "a0a0618e-ff8d-55ba-915b-f7de9b4bbbc9" :question/math-academy-id "q-76010" :question/problem "Find the set of values of $x$ that satisfy $-1<2x-3\\le 1$ and $3x>9.$" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $-1<2x-3\\le 1\\,:$\n\n$$\n\\begin{aligned}-1 & <2x-3\\le 1 \\\\ -1+3 & <2x-3+3\\le 1+3 \\\\ 2 & <2x\\le 4 \\\\ \\frac{2}{2} & <\\frac{2x}{2}\\le \\frac{4}{2} \\\\ 1 & <x\\le 2\\end{aligned}\n$$\n\n![](images/7f/7f940af7e7480f83d89f47b53ec1f9b9d9d23e93d8419464055ada7b77c22be1.png)\n\n- Then, we solve  $3x>9\\,:$\n\n$$\n\\begin{aligned}3x & >9 \\\\ \\frac{3x}{3} & >\\frac{9}{3} \\\\ x & >3\\end{aligned}\n$$\n\n![](images/08/0883c587c9c164cc35fdf17b07f0d0bd3767c715c8c537e3c1013239194f22bc.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/5d/5d31a9ebff15e2eb52faf5e3768576cf2de60205882fc130efb57f77ffad0b96.png)\n\n$$\n\n$$\n\nIt turns out that the solutions do not overlap at all. Therefore, there are no values of $x$ that satisfy both inequalities simultaneously. So, there is no solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fa640ad7-cabb-5499-80c5-a48dcfe57f99"] :db/ensure [:question/validate]} {:db/id "answer-field-fa640ad7-cabb-5499-80c5-a48dcfe57f99" :answer-field/id #uuid "fa640ad7-cabb-5499-80c5-a48dcfe57f99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ce9ff232-8ba8-5c0c-baca-726f324f8f30" :answer-field/choices ["answer-d5f76f38-964b-5b3e-933f-7a5896b7eabe" "answer-23a3f9fe-829f-5f5d-8b8d-0e61573b6c63" "answer-82c7c6aa-4d8a-5782-a1fb-132c9e204e1c" "answer-2132bf72-52a3-5430-9d30-39b5d22fafc0" "answer-ce9ff232-8ba8-5c0c-baca-726f324f8f30"] :db/ensure [:answer-field/validate]} {:db/id "answer-d5f76f38-964b-5b3e-933f-7a5896b7eabe" :answer/id #uuid "d5f76f38-964b-5b3e-933f-7a5896b7eabe" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2)\\cup (-2,3]" :db/ensure [:answer/validate]} {:db/id "answer-23a3f9fe-829f-5f5d-8b8d-0e61573b6c63" :answer/id #uuid "23a3f9fe-829f-5f5d-8b8d-0e61573b6c63" :answer/type :answer.type/math :answer/value "x\\in (2,3]" :db/ensure [:answer/validate]} {:db/id "answer-82c7c6aa-4d8a-5782-a1fb-132c9e204e1c" :answer/id #uuid "82c7c6aa-4d8a-5782-a1fb-132c9e204e1c" :answer/type :answer.type/math :answer/value "x\\in [-1,3)" :db/ensure [:answer/validate]} {:db/id "answer-2132bf72-52a3-5430-9d30-39b5d22fafc0" :answer/id #uuid "2132bf72-52a3-5430-9d30-39b5d22fafc0" :answer/type :answer.type/math :answer/value "x\\in [1,3)" :db/ensure [:answer/validate]} {:db/id "answer-ce9ff232-8ba8-5c0c-baca-726f324f8f30" :answer/id #uuid "ce9ff232-8ba8-5c0c-baca-726f324f8f30" :answer/type :answer.type/text :answer/value "There is no solution" :db/ensure [:answer/validate]} {:db/id 17592186064605 :question/problem "Find the set of values of $x$ that satisfy $-1\\le 2-x\\le 3$ and $2x+1\\ge 5.$\n\n{{field-1}}\n$\\le x$\n{{field-2}}{{field-3}}" :question/worked-solution "To solve compound \"and\" inequalities, we solve each inequality separately and then find their intersection.\n\n- First, we solve $-1\\le 2-x\\le 3\\,:$\n\n$$\n\\begin{aligned}-1 & \\le 2-x\\le 3 \\\\ -1-2 & \\le 2-x-2\\le 3-2 \\\\ -3 & \\le -x\\le 1 \\\\ (-1)\\cdot (-3) & \\ge (-1)\\cdot (-x)\\ge (-1)\\cdot 1 \\\\ 3 & \\ge x\\ge -1 \\\\ -1 & \\le x\\le 3\\end{aligned}\n$$\n\n![](images/8f/8fe1b22970eac80550ae9cc8d2da4b34df6a853c717a7dd402b164dfd99356ce.png)\n\n- Then, we solve $2x+1\\ge 5\\,:$\n\n$$\n\\begin{aligned}2x+1 & \\ge 5 \\\\ 2x+1-1 & \\ge 5-1 \\\\ 2x & \\ge 4 \\\\ \\frac{2x}{2} & \\ge \\frac{4}{2} \\\\ x & \\ge 2\\end{aligned}\n$$\n\n![](images/eb/ebcff9656b5f2a1fd80624639cb91baa0a28b696aa261b555cf449f1c62894d1.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/77/7731bef503cf45a465945f81e0e2512f65c3e109a38d6d06afe74e17269f8c36.png)\n\nThus, the final solution is $2\\le x\\le 3.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186061711 :answer-field/correct "answer-4bc2e4ef-81ec-5874-8cf2-75ca5d7c1420" :answer-field/choices ["answer-4bc2e4ef-81ec-5874-8cf2-75ca5d7c1420"] :db/ensure [:answer-field/validate]} {:db/id "answer-4bc2e4ef-81ec-5874-8cf2-75ca5d7c1420" :answer/id #uuid "4bc2e4ef-81ec-5874-8cf2-75ca5d7c1420" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186061710 :answer-field/correct "answer-5b3b7fb3-6a14-5e6a-b22d-91c141148260" :answer-field/choices ["answer-5b3b7fb3-6a14-5e6a-b22d-91c141148260"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b3b7fb3-6a14-5e6a-b22d-91c141148260" :answer/id #uuid "5b3b7fb3-6a14-5e6a-b22d-91c141148260" :answer/type :answer.type/math :answer/value "\\le" :db/ensure [:answer/validate]} {:db/id 17592186061712 :answer-field/correct "answer-7e880375-4c34-5d43-a662-388a73c5b705" :answer-field/choices ["answer-7e880375-4c34-5d43-a662-388a73c5b705"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e880375-4c34-5d43-a662-388a73c5b705" :answer/id #uuid "7e880375-4c34-5d43-a662-388a73c5b705" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186065437 :tutorial/content "Suppose we want to find all of the values of $x$ that satisfy *both* $3x+9 \\geq 0$ *and* $2x \\leq -2$ simultaneously. \n\nTo do this, we solve each inequality individually and then compute the intersection of the two solutions.\n\n- We start by solving $3x + 9 \\geq 0\\mathbin{:}$\n\n$$\n\\begin{aligned}3x+9 & \\ge 0 \\\\ 3x+9-9 & \\ge 0-9 \\\\ 3x & \\ge -9 \\\\ \\frac{3x}{3} & \\ge \\frac{-9}{3} \\\\ x & \\ge -3\\end{aligned}\n$$\n\nThe solution to this inequality is shown on the number line below.\n\n![](images/51/5127629c09f32bb8ed7872b476322d6973e44e82be7977492c8dd0967d3cb0ec.png)\n\n- Then, we solve $2x \\leq -2\\mathbin{:}$\n\n$$\n\\begin{aligned}2x & \\le -2 \\\\ \\frac{2x}{2} & \\le \\frac{-2}{2} \\\\ x & \\le -1\\end{aligned}\n$$\n\nThe solution to this inequality is shown on the number line below.\n\n![](images/35/35e30bc9c45b08793d847c8750698f7d9dab781438405239ed4483ce82f2dcfb.png)\n\nTo find the values of $x$ that satisfy both inequalities, we find where the two solutions overlap:\n\n![](images/fe/fe4c223767cb06d9d620d32f5e668c7305688b3870bf0317304c56b11053e19f.png)\n\nThus, the final solution is $\\color{blue}-3 \\leq x \\leq -1.$" :db/ensure [:tutorial/validate]} {:db/id 17592186064440 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186198354 :knowledge-point/questions ["question-4aa33ace-7f3a-5239-9095-80fa2dcc03c8" "question-79a93a5e-93ce-572a-a9b2-6cc224e62f04"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4aa33ace-7f3a-5239-9095-80fa2dcc03c8" :question/id #uuid "4aa33ace-7f3a-5239-9095-80fa2dcc03c8" :question/math-academy-id "q-35493" :question/problem "Find the projection of the intersection between the hyperboloid of two sheets \n$\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{(z+2)^{2}}{3}=-1$\nand the plane $3y+z=-2$  onto the\n$xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n3y+z=-2\\,⟹\\,z=-2-3y\n$$\n\nSubstituting the expression for $z$ into the equation of the hyperboloid, we obtain: \n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}+{y}^{2}-\\frac{((-2-3y)+2)^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}+{y}^{2}-\\frac{9{y}^{2}}{3} & =-1 \\\\ \\frac{{x}^{2}}{2}-2{y}^{2} & =-1 \\\\ {x}^{2}-4{y}^{2} & =-2\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the hyperbola ${x}^{2}-4{y}^{2}=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d9278757-a57e-52ac-9515-43ca861ad9fc"] :db/ensure [:question/validate]} {:db/id "answer-field-d9278757-a57e-52ac-9515-43ca861ad9fc" :answer-field/id #uuid "d9278757-a57e-52ac-9515-43ca861ad9fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-01030459-2127-5845-a022-909ed458b20a" :answer-field/choices ["answer-fb60e82e-e2d6-5601-ad2a-ed678e54b305" "answer-203cf6b6-970b-533e-8eff-91d74ba85161" "answer-143f96a1-49b9-5c94-8498-9b59fb558656" "answer-01030459-2127-5845-a022-909ed458b20a" "answer-077958e9-019b-52b4-a194-2e3d1e6e8a31"] :db/ensure [:answer-field/validate]} {:db/id "answer-fb60e82e-e2d6-5601-ad2a-ed678e54b305" :answer/id #uuid "fb60e82e-e2d6-5601-ad2a-ed678e54b305" :answer/type :answer.type/math :answer/value "{x}^{2}+2{y}^{2}=-1" :db/ensure [:answer/validate]} {:db/id "answer-203cf6b6-970b-533e-8eff-91d74ba85161" :answer/id #uuid "203cf6b6-970b-533e-8eff-91d74ba85161" :answer/type :answer.type/math :answer/value "{x}^{2}-2{y}^{2}=-2" :db/ensure [:answer/validate]} {:db/id "answer-143f96a1-49b9-5c94-8498-9b59fb558656" :answer/id #uuid "143f96a1-49b9-5c94-8498-9b59fb558656" :answer/type :answer.type/math :answer/value "{x}^{2}-2{y}^{2}=1" :db/ensure [:answer/validate]} {:db/id "answer-01030459-2127-5845-a022-909ed458b20a" :answer/id #uuid "01030459-2127-5845-a022-909ed458b20a" :answer/type :answer.type/math :answer/value "{x}^{2}-4{y}^{2}=-2" :db/ensure [:answer/validate]} {:db/id "answer-077958e9-019b-52b4-a194-2e3d1e6e8a31" :answer/id #uuid "077958e9-019b-52b4-a194-2e3d1e6e8a31" :answer/type :answer.type/math :answer/value "{x}^{2}-4{y}^{2}=2" :db/ensure [:answer/validate]} {:db/id 17592186198433 :knowledge-point/questions ["question-2fc9ea0f-3211-5796-852b-f82127f7f8bc" "question-79e25129-bb03-5263-b94d-378f30c636ff"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2fc9ea0f-3211-5796-852b-f82127f7f8bc" :question/id #uuid "2fc9ea0f-3211-5796-852b-f82127f7f8bc" :question/math-academy-id "q-70492" :question/problem "Find the point(s) of the intersection of the sphere ${x}^{2}+(y+4)^{2}+(z-2)^{2}=9$ and the line $x=y+1=\\frac{z-2}{2}.$" :question/worked-solution "First, we write the equation of our line in parametric form:\n\n$$\n\\frac{x}{1}=\\frac{y+1}{1}=\\frac{z-2}{2}=t\\,⟹\\,\\{\\begin{aligned}x=t \\\\ y=t-1 \\\\ z=2t+2,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x$, $y$, and $z$ into the equation of the sphere, we obtain:\n\n$$\n\\begin{aligned}{x}^{2}+(y+4)^{2}+(z-2)^{2} & =9 \\\\ (t)^{2}+((t-1)+4)^{2}+((2t+2)-2)^{2} & =9 \\\\ (t)^{2}+(t+3)^{2}+(2t)^{2} & =9 \\\\ {t}^{2}+({t}^{2}+6t+9)+4{t}^{2} & =9 \\\\ 6{t}^{2}+6t+9 & =9 \\\\ 6{t}^{2}+6t & =0 \\\\ t(t+1) & =0\\end{aligned}\n$$\n\nHence, we get the solutions $t=0$ and $t=-1.$ \n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=0$, we have\n\n$$\n\\{\\begin{aligned}x=(0)=0 \\\\ y=(0)-1=-1 \\\\ z=2(0)+2=2,\\end{aligned}\n$$\n\nso the first point is $(0,-1,2).$\n\n- For $t=-1$, we have\n\n$$\n\\{\\begin{aligned}x=(-1)=-1 \\\\ y=(-1)-1=-2 \\\\ z=2(-1)+2=0,\\end{aligned}\n$$\n\nso the second point is $(-1,-2,0).$\n\nTherefore, the points of intersection are $(0,-1,2)$ and $(-1,-2,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6a536d68-bf2d-5dad-99bc-e23331bfdfe7"] :db/ensure [:question/validate]} {:db/id "answer-field-6a536d68-bf2d-5dad-99bc-e23331bfdfe7" :answer-field/id #uuid "6a536d68-bf2d-5dad-99bc-e23331bfdfe7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer-field/choices ["answer-49d7a3f7-5a7c-529b-8365-112a6e047f3c" "answer-a7ffed4d-2482-5099-8b82-bd20e8d364c7" "answer-dc3d4c3e-b241-54c6-acec-d0f88c27e4bd" "answer-58893bd2-e6a6-54b6-a356-759f3915936a" "answer-4b015270-c477-5154-96e4-6cc157ae07cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-49d7a3f7-5a7c-529b-8365-112a6e047f3c" :answer/id #uuid "49d7a3f7-5a7c-529b-8365-112a6e047f3c" :answer/type :answer.type/text :answer/value "$(-1,-1,2)$ only" :db/ensure [:answer/validate]} {:db/id "answer-a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/id #uuid "a7ffed4d-2482-5099-8b82-bd20e8d364c7" :answer/type :answer.type/text :answer/value "$(0,-1,2)$ and $(-1,-2,0)$" :db/ensure [:answer/validate]} {:db/id "answer-dc3d4c3e-b241-54c6-acec-d0f88c27e4bd" :answer/id #uuid "dc3d4c3e-b241-54c6-acec-d0f88c27e4bd" :answer/type :answer.type/text :answer/value "$(0,-1,2)$ only" :db/ensure [:answer/validate]} {:db/id "answer-58893bd2-e6a6-54b6-a356-759f3915936a" :answer/id #uuid "58893bd2-e6a6-54b6-a356-759f3915936a" :answer/type :answer.type/text :answer/value "$(1,-2,1)$ and $(-1,-1,2)$" :db/ensure [:answer/validate]} {:db/id "answer-4b015270-c477-5154-96e4-6cc157ae07cf" :answer/id #uuid "4b015270-c477-5154-96e4-6cc157ae07cf" :answer/type :answer.type/text :answer/value "No points of intersection" :db/ensure [:answer/validate]} {:db/id "question-79a93a5e-93ce-572a-a9b2-6cc224e62f04" :question/id #uuid "79a93a5e-93ce-572a-a9b2-6cc224e62f04" :question/math-academy-id "q-71144" :question/problem "Find the projection of the intersection between the ellipsoid $\\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{{z}^{2}}{3}=1$ and the plane $2x-z=8$ onto the $xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n\\begin{aligned}2x-z & =8\\,⟹\\,z=2x-8\\end{aligned}\n$$\n\nSubstituting the expression for $z$ into the equation of the ellipsoid, we obtain:\n\n$$\n\\begin{aligned}\\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{(2x-8)^{2}}{3} & =1 \\\\ \\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{(2(x-4))^{2}}{3} & =1 \\\\ \\frac{2(x-4)^{2}}{3}+\\frac{(y-2)^{2}}{9}+\\frac{4(x-4)^{2}}{3} & =1 \\\\ 2(x-4)^{2}+\\frac{(y-2)^{2}}{9} & =1 \\\\ \\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9} & =1\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the ellipse $\\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9}=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-57bc7b16-076a-5d7f-9700-faa7bbcaa22a"] :db/ensure [:question/validate]} {:db/id "answer-field-57bc7b16-076a-5d7f-9700-faa7bbcaa22a" :answer-field/id #uuid "57bc7b16-076a-5d7f-9700-faa7bbcaa22a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a8a7513d-02fd-5ce8-a27d-be0b1651e1a5" :answer-field/choices ["answer-78a92225-282a-5fa9-927d-dd473156f003" "answer-a8a7513d-02fd-5ce8-a27d-be0b1651e1a5" "answer-22ebb37c-8c26-51e9-9c62-0f2d00524ac9" "answer-172f9044-b08d-597e-a42f-5e850c62dc68" "answer-bbef375e-e5f8-5e13-bf7c-2fbf0dbcd8ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-78a92225-282a-5fa9-927d-dd473156f003" :answer/id #uuid "78a92225-282a-5fa9-927d-dd473156f003" :answer/type :answer.type/math :answer/value "(x-2)^{2}+\\frac{(y-2)^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "answer-a8a7513d-02fd-5ce8-a27d-be0b1651e1a5" :answer/id #uuid "a8a7513d-02fd-5ce8-a27d-be0b1651e1a5" :answer/type :answer.type/math :answer/value "\\frac{(x-4)^{2}}{1/2}+\\frac{(y-2)^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "answer-22ebb37c-8c26-51e9-9c62-0f2d00524ac9" :answer/id #uuid "22ebb37c-8c26-51e9-9c62-0f2d00524ac9" :answer/type :answer.type/math :answer/value "\\frac{(x-4)^{2}}{2/3}+\\frac{(y-2)^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "answer-172f9044-b08d-597e-a42f-5e850c62dc68" :answer/id #uuid "172f9044-b08d-597e-a42f-5e850c62dc68" :answer/type :answer.type/math :answer/value "\\frac{(x-8)^{2}}{1/3}+\\frac{(y-2)^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "answer-bbef375e-e5f8-5e13-bf7c-2fbf0dbcd8ca" :answer/id #uuid "bbef375e-e5f8-5e13-bf7c-2fbf0dbcd8ca" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}+\\frac{(y-2)^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "question-79e25129-bb03-5263-b94d-378f30c636ff" :question/id #uuid "79e25129-bb03-5263-b94d-378f30c636ff" :question/math-academy-id "q-94778" :question/problem "Find the points of the intersection of the elliptic cone ${x}^{2}+3{y}^{2}=4{z}^{2}$ and the line $\\frac{x+1}{2}=y=z+2.$" :question/worked-solution "First, we write the equation of our line in the parametric form:\n\n$$\n\\frac{x+1}{2}=y=z+2=t\\,⟹\\,\\{\\begin{aligned}x=2t-1 \\\\ y=t \\\\ z=t-2,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nSubstituting the above expressions for $x,$ $y,$ and $z$ into the equation of the elliptic cone, we obtain\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2} & =4{z}^{2} \\\\ (2t-1)^{2}+3{t}^{2} & =4(t-2)^{2} \\\\ 4{t}^{2}-4t+1+3{t}^{2} & =4({t}^{2}-4t+4) \\\\ 4{t}^{2}-4t+1+3{t}^{2} & =4{t}^{2}-16t+16 \\\\ 3{t}^{2}+12t-15 & =0 \\\\ 3({t}^{2}+4t-5) & =0 \\\\ 3(t+5)(t-1) & =0 \\\\ t & =-5,1.\\end{aligned}\n$$\n\nNow, we substitute our solutions back into the equations of the line.\n\n- For $t=-5,$ we have\n\n$$\n\\{\\begin{aligned}x=2(-5)-1=-11 \\\\ y=-5 \\\\ z=-5-2=-7,\\end{aligned}\n$$\n\nso the first point is $(-11,-5,-7).$\n\n- For $t=1,$ we have\n\n$$\n\\{\\begin{aligned}x=2(1)-1=1 \\\\ y=1 \\\\ z=1-2=-1,\\end{aligned}\n$$\n\nso the second point is $(1,1,-1).$\n\nTherefore, the points of intersection are $(-11,-5,-7)$ and $(1,1,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-264de4f5-8c74-5910-abc7-434d194ea07f"] :db/ensure [:question/validate]} {:db/id "answer-field-264de4f5-8c74-5910-abc7-434d194ea07f" :answer-field/id #uuid "264de4f5-8c74-5910-abc7-434d194ea07f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-023e9917-3ef8-5f06-9f86-33a31fac22e3" :answer-field/choices ["answer-023e9917-3ef8-5f06-9f86-33a31fac22e3" "answer-8a82b00a-4358-523b-a223-90c195948106" "answer-77a523c2-195a-5b93-b4f7-8f2f2ba7c2a6" "answer-81c8c0cf-32fa-5ec8-ae30-58c2cefd375c" "answer-620ccc76-b273-5913-9295-a74568d6b881"] :db/ensure [:answer-field/validate]} {:db/id "answer-023e9917-3ef8-5f06-9f86-33a31fac22e3" :answer/id #uuid "023e9917-3ef8-5f06-9f86-33a31fac22e3" :answer/type :answer.type/text :answer/value "$(-11,-5,-7)$ and $(1,1,-1)$" :db/ensure [:answer/validate]} {:db/id "answer-8a82b00a-4358-523b-a223-90c195948106" :answer/id #uuid "8a82b00a-4358-523b-a223-90c195948106" :answer/type :answer.type/text :answer/value "$(-11,-5,-7)$ only" :db/ensure [:answer/validate]} {:db/id "answer-77a523c2-195a-5b93-b4f7-8f2f2ba7c2a6" :answer/id #uuid "77a523c2-195a-5b93-b4f7-8f2f2ba7c2a6" :answer/type :answer.type/text :answer/value "$(-3,-1,-3)$ and $(9,5,3)$" :db/ensure [:answer/validate]} {:db/id "answer-81c8c0cf-32fa-5ec8-ae30-58c2cefd375c" :answer/id #uuid "81c8c0cf-32fa-5ec8-ae30-58c2cefd375c" :answer/type :answer.type/text :answer/value "$(-7,-3,-5)$ and $(-3,-1,-3)$" :db/ensure [:answer/validate]} {:db/id "answer-620ccc76-b273-5913-9295-a74568d6b881" :answer/id #uuid "620ccc76-b273-5913-9295-a74568d6b881" :answer/type :answer.type/text :answer/value "$(1,1,-1)$ only" :db/ensure [:answer/validate]} {:db/id "activity-6c80042f-f7cd-5e07-8f32-4eebe739d487" :activity/id #uuid "6c80042f-f7cd-5e07-8f32-4eebe739d487" :activity/title "Intersections of Lines and Planes With Surfaces" :activity/type :activity.type/review :activity/scope 17592186050851 :activity/course 17592186046644 :activity/steps ["step-e330baa0-4535-5227-ae2f-5e7087691796" "step-f9fa29ad-e929-5ec2-a636-229382ae0cca" "step-cb05386a-05eb-5248-b754-a8d8d5a583d5" "step-07630e9e-6eaa-5c9c-8cca-3f82529d648d" "step-8cafab22-633e-567a-b060-34f181932e1e"] :activity/first-step "step-e330baa0-4535-5227-ae2f-5e7087691796" :db/ensure [:activity/validate]} {:db/id "step-e330baa0-4535-5227-ae2f-5e7087691796" :step/id #uuid "e330baa0-4535-5227-ae2f-5e7087691796" :step/content "question-4aa33ace-7f3a-5239-9095-80fa2dcc03c8" :step/next "step-f9fa29ad-e929-5ec2-a636-229382ae0cca" :db/ensure [:step/validate]} {:db/id "step-f9fa29ad-e929-5ec2-a636-229382ae0cca" :step/id #uuid "f9fa29ad-e929-5ec2-a636-229382ae0cca" :step/content 17592186496282 :step/next "step-cb05386a-05eb-5248-b754-a8d8d5a583d5" :db/ensure [:step/validate]} {:db/id "step-cb05386a-05eb-5248-b754-a8d8d5a583d5" :step/id #uuid "cb05386a-05eb-5248-b754-a8d8d5a583d5" :step/content "question-2fc9ea0f-3211-5796-852b-f82127f7f8bc" :step/next "step-07630e9e-6eaa-5c9c-8cca-3f82529d648d" :db/ensure [:step/validate]} {:db/id "step-07630e9e-6eaa-5c9c-8cca-3f82529d648d" :step/id #uuid "07630e9e-6eaa-5c9c-8cca-3f82529d648d" :step/content "question-79a93a5e-93ce-572a-a9b2-6cc224e62f04" :step/next "step-8cafab22-633e-567a-b060-34f181932e1e" :db/ensure [:step/validate]} {:db/id "step-8cafab22-633e-567a-b060-34f181932e1e" :step/id #uuid "8cafab22-633e-567a-b060-34f181932e1e" :step/content "question-79e25129-bb03-5263-b94d-378f30c636ff" :db/ensure [:step/validate]} {:db/id 17592186129271 :knowledge-point/questions ["question-30a2be53-ad1e-54e7-8cc2-2924faaf8e17" "question-db419926-6089-5205-b99f-0938320c28f8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-30a2be53-ad1e-54e7-8cc2-2924faaf8e17" :question/id #uuid "30a2be53-ad1e-54e7-8cc2-2924faaf8e17" :question/math-academy-id "q-161795" :question/problem "Find the Jacobian determinant of the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u+\\operatorname{cos}⁡w \\\\ v \\\\ \\operatorname{cos}⁡u+w\\end{aligned}].\n$$" :question/worked-solution "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+\\operatorname{cos}⁡w,\\,y(u,v,w)=v,\\,z(u,v,w)=\\operatorname{cos}⁡u+w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =-\\operatorname{sin}⁡w \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =1 & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =-\\operatorname{sin}⁡u & \\,\\frac{∂z}{∂v} & =0, & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & 0 & -\\operatorname{sin}⁡w \\\\ 0 & 1 & 0 \\\\ -\\operatorname{sin}⁡u & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{2+2}|\\begin{aligned}1 & -\\operatorname{sin}⁡w \\\\ -\\operatorname{sin}⁡u & 1\\end{aligned}| \\\\  & =1-\\operatorname{sin}⁡u\\,\\operatorname{sin}⁡w.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2d0df2e4-d380-5912-bac6-465760a259a6"] :db/ensure [:question/validate]} {:db/id "answer-field-2d0df2e4-d380-5912-bac6-465760a259a6" :answer-field/id #uuid "2d0df2e4-d380-5912-bac6-465760a259a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-87f9ca78-e7eb-5c39-bc73-ffb1b08282b8" :answer-field/choices ["answer-30cff47c-46a9-5910-9362-18ed14cc8d58" "answer-47299991-0c88-52f8-adac-83f8c4229c9c" "answer-b1a8b398-e764-5a3f-9020-8353ddf15a9a" "answer-87f9ca78-e7eb-5c39-bc73-ffb1b08282b8" "answer-01f1e83f-e91e-5090-bc9c-c0d8a5b24dec"] :db/ensure [:answer-field/validate]} {:db/id "answer-30cff47c-46a9-5910-9362-18ed14cc8d58" :answer/id #uuid "30cff47c-46a9-5910-9362-18ed14cc8d58" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡u" :db/ensure [:answer/validate]} {:db/id "answer-47299991-0c88-52f8-adac-83f8c4229c9c" :answer/id #uuid "47299991-0c88-52f8-adac-83f8c4229c9c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b1a8b398-e764-5a3f-9020-8353ddf15a9a" :answer/id #uuid "b1a8b398-e764-5a3f-9020-8353ddf15a9a" :answer/type :answer.type/math :answer/value "1+{sin}^{2}⁡u" :db/ensure [:answer/validate]} {:db/id "answer-87f9ca78-e7eb-5c39-bc73-ffb1b08282b8" :answer/id #uuid "87f9ca78-e7eb-5c39-bc73-ffb1b08282b8" :answer/type :answer.type/math :answer/value "1-\\operatorname{sin}⁡u\\,\\operatorname{sin}⁡w" :db/ensure [:answer/validate]} {:db/id "answer-01f1e83f-e91e-5090-bc9c-c0d8a5b24dec" :answer/id #uuid "01f1e83f-e91e-5090-bc9c-c0d8a5b24dec" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡u+\\operatorname{sin}⁡w" :db/ensure [:answer/validate]} {:db/id "question-db419926-6089-5205-b99f-0938320c28f8" :question/id #uuid "db419926-6089-5205-b99f-0938320c28f8" :question/math-academy-id "q-161799" :question/problem "Find the Jacobian determinant of the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}u+v\\operatorname{cos}⁡\\theta +w\\operatorname{sin}⁡\\theta  \\\\ 3v \\\\ u\\operatorname{sin}⁡\\theta +w\\end{aligned}].\n$$\n\nYou may assume that $\\theta $ is a fixed constant." :question/worked-solution "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)=u+v\\operatorname{cos}⁡\\theta +w\\operatorname{sin}⁡\\theta ,\\,y(u,v,w)=3v,\\,z(u,v,w)=u\\operatorname{sin}⁡\\theta +w.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =1 & \\,\\frac{∂x}{∂v} & =\\operatorname{cos}⁡\\theta  & \\,\\frac{∂x}{∂w} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{∂y}{∂u} & =0 & \\,\\frac{∂y}{∂v} & =3 & \\,\\frac{∂y}{∂w} & =0 \\\\ \\frac{∂z}{∂u} & =\\operatorname{sin}⁡\\theta  & \\,\\frac{∂z}{∂v} & =0, & \\,\\frac{∂z}{∂w} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}1 & \\operatorname{cos}⁡\\theta  & \\operatorname{sin}⁡\\theta  \\\\ 0 & 3 & 0 \\\\ \\operatorname{sin}⁡\\theta  & 0 & 1\\end{aligned}| \\\\  & =3(-1)^{2+2}|\\begin{aligned}1 & \\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & 1\\end{aligned}| \\\\  & =3(1-{sin}^{2}⁡\\theta ) \\\\  & =3{cos}^{2}⁡\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff"] :db/ensure [:question/validate]} {:db/id "answer-field-7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/id #uuid "7d304d66-3b35-5b7a-a10d-e4c98f3bf8ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-65eac0db-4498-5219-a599-16571ff5b0ff" :answer-field/choices ["answer-d9ee05e3-c0ef-572d-b71a-0521af7c7c51" "answer-e13473ff-e770-5bc2-84cc-d2f5a63a463b" "answer-65eac0db-4498-5219-a599-16571ff5b0ff" "answer-f40d8dc6-4b68-5931-af1a-b12969faf5dd" "answer-ec060073-eee0-5eb4-a23b-64f1baba3d7d"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9ee05e3-c0ef-572d-b71a-0521af7c7c51" :answer/id #uuid "d9ee05e3-c0ef-572d-b71a-0521af7c7c51" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-e13473ff-e770-5bc2-84cc-d2f5a63a463b" :answer/id #uuid "e13473ff-e770-5bc2-84cc-d2f5a63a463b" :answer/type :answer.type/math :answer/value "3\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-65eac0db-4498-5219-a599-16571ff5b0ff" :answer/id #uuid "65eac0db-4498-5219-a599-16571ff5b0ff" :answer/type :answer.type/math :answer/value "3{cos}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-f40d8dc6-4b68-5931-af1a-b12969faf5dd" :answer/id #uuid "f40d8dc6-4b68-5931-af1a-b12969faf5dd" :answer/type :answer.type/math :answer/value "3{sin}^{2}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "answer-ec060073-eee0-5eb4-a23b-64f1baba3d7d" :answer/id #uuid "ec060073-eee0-5eb4-a23b-64f1baba3d7d" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id 17592186115322 :knowledge-point/questions ["question-89c9046d-3e0b-5226-98f7-31a9c44e0e5c" "question-9ea10a00-dd11-5690-aa60-169c6a36b74a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115154 :question/problem "Find the set of values of $x$ that satisfy $6x-1 \\leq 2$ or $5x-1 > 9.$ Express your answer in interval notation." :question/worked-solution "We start by solving $6x-1 \\leq 2\\mathbin{:}$\n\n$$\n\\begin{aligned}6x-1 & \\le 2 \\\\ 6x & \\le 3 \\\\ x & \\le \\frac{3}{6} \\\\ x & \\le \\frac{1}{2}\\end{aligned}\n$$\n\n![](images/dd/dd2c101e02e14a147371bc1b822f3bc86081dd0059ac50ae1f9131909e73e3ad.png)\n\nThen, we solve $5x -1 > 9\\mathbin{:}$\n\n$$\n\\begin{aligned}5x-1 & >9 \\\\ 5x & >10 \\\\ x & >2\\end{aligned}\n$$\n\n![](images/8b/8b252e1c42dcac87072a33b33460a887b6ec3bfa0d1511f05a004935df1911ca.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/ac/ac44f335b135463820ec0db9bc04470769fee7aabc8717edcc351893b6d8de47.png)\n\nTherefore, the final solution is $x \\leq \\dfrac{1}{2}$ or $x >2.$ We can write this using interval notation as\n\n$$\n\\begin{aligned}(-\\infty ,\\frac{1}{2}]\\cup (2,\\infty ).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186115321 :knowledge-point/questions ["question-4351a80f-5497-5bde-b1ce-3fcb89da7609"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115153 :question/problem "Find all the values of $x$ that satisfy $12x+8 > 44$ or $5x+3 \\leq 28.$" :question/worked-solution "We start by solving $12x+8 > 44\\mathbin{:}$\n\n$$\n\\begin{aligned}12x+8 & >44 \\\\ 12x & >36 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/e9/e9eec85ca2dd2a9fd01db97a5f281d16fd958e143e048f7ff3c5e7a87dd33f0a.png)\n\nThen, we solve $5x+3 \\leq 28\\mathbin{:}$\n\n$$\n\\begin{aligned}5x+3 & \\le 28 \\\\ 5x & \\le 25 \\\\ x & \\le 5\\end{aligned}\n$$\n\n![](images/c9/c9cec5cfc0e476fffe4f89f89ff0585992855e8e36fe09778029d5accd2bdc6b.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/dd/dd1330c9f2d9dc2140a3e3a4dc37ac269d134c5e367f59c9985ce04d4acd6304.png)\n\nTherefore, the final solution is $-\\infty < x < \\infty.$ We can write this using interval notation as $(-\\infty,\\infty).$" :db/ensure [:question/validate]} {:db/id 17592186115323 :knowledge-point/questions ["question-7d1dc12b-037c-55bd-92e4-67849dd74463" "question-83a6d940-fad6-59a8-acb5-f275a8b09b93"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115155 :question/problem "Find the set of values of $x$ that satisfy $1 < 5x+6 \\leq 11$ or $5x-7 > 8.$" :question/worked-solution "We start by solving $1 < 5x+6 \\leq 11\\mathbin{:}$\n\n$$\n\\begin{aligned}1 & <5x+6\\le 11 \\\\ -5 & <5x\\le 5 \\\\ -1 & <x\\le 1\\end{aligned}\n$$\n\n![](images/69/69948e87bc893a2461ec6e8bb77dd72e77e6d496970e31df899400c42238cd01.png)\n\nThen, we solve $5x-7 > 8\\mathbin{:}$\n\n$$\n\\begin{aligned}5x-7 & >8 \\\\ 5x & >15 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/10/10bb9a3bcc0b13b015649e2dae70a3ff3dcd361f46e6c545182031d6e095ad16.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/84/84a05cd47818c9609609c2f02bd026ccadfa77c6641dff82936630bf04fbe77e.png)\n\nThus, the final solution is $-1 <  x \\leq 1$ or $x > 3.$ We can write this using interval notation as\n\n$$\n(-1,1] \\cup (3,\\infty).\n$$" :db/ensure [:question/validate]} {:db/id "question-89c9046d-3e0b-5226-98f7-31a9c44e0e5c" :question/id #uuid "89c9046d-3e0b-5226-98f7-31a9c44e0e5c" :question/math-academy-id "q-51768" :question/problem "Find the set of values of $w$ that satisfy $w-3\\le -1$ or $5w>25.$ Express your answer in interval notation." :question/worked-solution "We start by solving $w-3\\le -1:$\n\n$$\n\\begin{aligned}w-3+3 & \\le -1+3 \\\\ w & \\le 2\\end{aligned}\n$$\n\n![](images/41/41894afbf397505568367e80d14e34fe2b04a2acdfd5398bd8ba41727b8c67c6.png)\n\nThen, we solve $5w>25:$ \n\n$$\n\\begin{aligned}\\frac{5w}{5} & >\\frac{25}{5} \\\\ w & >5\\end{aligned}\n$$\n\n![](images/26/262a3e683cb8c8a67cdd58c0f138e44466c346092c7f74ec03ec1483a385056a.png)\n\nTo graph the values of $w$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/95/95d67331522c16093207de451a33bb713b42e1418d1f4c1a7aa1ef6369a51e4b.png)\n\nTherefore, the final solution is $w\\le 2$ or $w>5.$ We can write this using interval notation as\n\n$$\n(-\\infty ,2]\\cup (5,\\infty ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4a64adf4-89bb-5bcd-a5d3-aeb6554ac2a4"] :db/ensure [:question/validate]} {:db/id "answer-field-4a64adf4-89bb-5bcd-a5d3-aeb6554ac2a4" :answer-field/id #uuid "4a64adf4-89bb-5bcd-a5d3-aeb6554ac2a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c0a897f-4ef6-57d6-9980-9e293186af3f" :answer-field/choices ["answer-f488b71a-7a5a-591e-aefc-dfc045886d0f" "answer-69cbea69-6868-5ccb-858f-b44009caa759" "answer-6c0a897f-4ef6-57d6-9980-9e293186af3f" "answer-dbd7961f-1cd9-5059-bc70-26ad3c31e036" "answer-9e778703-e474-5e5f-a85c-446ac10186dc"] :db/ensure [:answer-field/validate]} {:db/id "answer-f488b71a-7a5a-591e-aefc-dfc045886d0f" :answer/id #uuid "f488b71a-7a5a-591e-aefc-dfc045886d0f" :answer/type :answer.type/math :answer/value "(-\\infty ,-3)\\cup [-1,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-69cbea69-6868-5ccb-858f-b44009caa759" :answer/id #uuid "69cbea69-6868-5ccb-858f-b44009caa759" :answer/type :answer.type/math :answer/value "(-\\infty ,2)\\cup [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-6c0a897f-4ef6-57d6-9980-9e293186af3f" :answer/id #uuid "6c0a897f-4ef6-57d6-9980-9e293186af3f" :answer/type :answer.type/math :answer/value "(-\\infty ,2]\\cup (5,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-dbd7961f-1cd9-5059-bc70-26ad3c31e036" :answer/id #uuid "dbd7961f-1cd9-5059-bc70-26ad3c31e036" :answer/type :answer.type/math :answer/value "(5,25]" :db/ensure [:answer/validate]} {:db/id "answer-9e778703-e474-5e5f-a85c-446ac10186dc" :answer/id #uuid "9e778703-e474-5e5f-a85c-446ac10186dc" :answer/type :answer.type/math :answer/value "[2,5)" :db/ensure [:answer/validate]} {:db/id "question-9ea10a00-dd11-5690-aa60-169c6a36b74a" :question/id #uuid "9ea10a00-dd11-5690-aa60-169c6a36b74a" :question/math-academy-id "q-28961" :question/problem "Find the set of values of $x$ that satisfy $3x+5>14$ or $2x-3\\le 1.$ Express your answer in interval notation." :question/worked-solution "We start by solving $3x+5>14:$\n\n$$\n\\begin{aligned}3x+5 & >14 \\\\ 3x & >9 \\\\ x & >3\\end{aligned}\n$$\n\n![](images/5d/5dca213f8266a9bd001380b30368e5996b24fa2ddb6d3aef5670befde451e77d.png)\n\nThen, we solve $2x-3\\le 1:$ \n\n$$\n\\begin{aligned}2x-3 & \\le 1 \\\\ 2x & \\le 4 \\\\ x & \\le 2\\end{aligned}\n$$\n\n![](images/45/454e1de1e32bb5e3fb03dc280076414493d9e4a9c042246be565d8550c2012f2.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/53/531c59b67623a10db6af4236187e7d50315e7068585d6a5e6882db0d1997bdce.png)\n\nTherefore, the final solution is $x\\le 2$ or $x>3.$ We can write this using interval notation as\n\n$$\n(-\\infty ,2]\\cup (3,\\infty ).\\,\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-66fe9ad0-b164-5fc3-a63f-e6ebefcc66a3"] :db/ensure [:question/validate]} {:db/id "answer-field-66fe9ad0-b164-5fc3-a63f-e6ebefcc66a3" :answer-field/id #uuid "66fe9ad0-b164-5fc3-a63f-e6ebefcc66a3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7353cd84-2e2e-5e4a-96d3-14bfcec424f4" :answer-field/choices ["answer-938f28b1-c360-5ccd-b701-56e4b8b4fd3d" "answer-7353cd84-2e2e-5e4a-96d3-14bfcec424f4" "answer-a5a86e05-1a21-59c0-84ef-df8a50afc8e7" "answer-c8a9a619-1500-5c95-b104-a810b516b82f" "answer-1222ea73-7e26-5f9b-93f4-9aa59eaf76cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-938f28b1-c360-5ccd-b701-56e4b8b4fd3d" :answer/id #uuid "938f28b1-c360-5ccd-b701-56e4b8b4fd3d" :answer/type :answer.type/math :answer/value "(-\\infty ,2)\\cup [3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-7353cd84-2e2e-5e4a-96d3-14bfcec424f4" :answer/id #uuid "7353cd84-2e2e-5e4a-96d3-14bfcec424f4" :answer/type :answer.type/math :answer/value "(-\\infty ,2]\\cup (3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a5a86e05-1a21-59c0-84ef-df8a50afc8e7" :answer/id #uuid "a5a86e05-1a21-59c0-84ef-df8a50afc8e7" :answer/type :answer.type/math :answer/value "(-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-c8a9a619-1500-5c95-b104-a810b516b82f" :answer/id #uuid "c8a9a619-1500-5c95-b104-a810b516b82f" :answer/type :answer.type/math :answer/value "[2,3)" :db/ensure [:answer/validate]} {:db/id "answer-1222ea73-7e26-5f9b-93f4-9aa59eaf76cb" :answer/id #uuid "1222ea73-7e26-5f9b-93f4-9aa59eaf76cb" :answer/type :answer.type/math :answer/value "[3,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-4351a80f-5497-5bde-b1ce-3fcb89da7609" :question/id #uuid "4351a80f-5497-5bde-b1ce-3fcb89da7609" :question/math-academy-id "q-25591" :question/problem "Which of the following number lines represents the values of $x$ that satisfy $7x+5>47$ or $3x-3\\le 30?$" :question/worked-solution "We start by solving $7x+5>47:$ \n\n$$\n\\begin{aligned}7x+5 & >47 \\\\ 7x & >47-5 \\\\ 7x & >42 \\\\ x & >\\frac{42}{7} \\\\ x & >6\\end{aligned}\n$$\n\n![](images/b2/b2b7aad327466abf2472e9058317e8f5521eba35a944482e2cc3cc12cf51095b.png)\n\nThen, we solve $3x-3\\le 30:$ \n\n$$\n\\begin{aligned}3x-3 & \\le 30 \\\\ 3x & \\le 30+3 \\\\ 3x & \\le 33 \\\\ x & \\le \\frac{33}{3} \\\\ x & \\le 11\\end{aligned}\n$$\n\n![](images/31/312b09109c1cb34d5820616c9aca887c6e48507be2c5045b128f9fa8c4cb0791.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/66/6681d256a848077367d83e215b4cb45edea86c49929c9c85c2aa32d8caaa2de7.png)\n\nTherefore, the final solution is $-\\infty <x<\\infty .$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-41293c54-1759-5e11-8b8c-9e3094059bbe"] :db/ensure [:question/validate]} {:db/id "answer-field-41293c54-1759-5e11-8b8c-9e3094059bbe" :answer-field/id #uuid "41293c54-1759-5e11-8b8c-9e3094059bbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f0bb42e-c190-5229-bb2a-774c46c2ed0d" :answer-field/choices ["answer-c3cf020d-1363-526d-838a-54966d7c8d0d" "answer-18a48c20-6697-5de3-bfb1-aa373a9d1cef" "answer-3f0bb42e-c190-5229-bb2a-774c46c2ed0d" "answer-971a3595-9f9d-5d9b-ba15-4f12ff874cf5" "answer-fa38eaa9-fde9-5ac1-8936-620024312893"] :db/ensure [:answer-field/validate]} {:db/id "answer-c3cf020d-1363-526d-838a-54966d7c8d0d" :answer/id #uuid "c3cf020d-1363-526d-838a-54966d7c8d0d" :answer/type :answer.type/image :answer/value "images/0b/0b9f413bd97b2b411b8a134441e6a6fdad5052df71ba33c33280f2c6850eb7ae.png" :db/ensure [:answer/validate]} {:db/id "answer-18a48c20-6697-5de3-bfb1-aa373a9d1cef" :answer/id #uuid "18a48c20-6697-5de3-bfb1-aa373a9d1cef" :answer/type :answer.type/image :answer/value "images/31/312b09109c1cb34d5820616c9aca887c6e48507be2c5045b128f9fa8c4cb0791.png" :db/ensure [:answer/validate]} {:db/id "answer-3f0bb42e-c190-5229-bb2a-774c46c2ed0d" :answer/id #uuid "3f0bb42e-c190-5229-bb2a-774c46c2ed0d" :answer/type :answer.type/image :answer/value "images/66/6681d256a848077367d83e215b4cb45edea86c49929c9c85c2aa32d8caaa2de7.png" :db/ensure [:answer/validate]} {:db/id "answer-971a3595-9f9d-5d9b-ba15-4f12ff874cf5" :answer/id #uuid "971a3595-9f9d-5d9b-ba15-4f12ff874cf5" :answer/type :answer.type/image :answer/value "images/b2/b2b7aad327466abf2472e9058317e8f5521eba35a944482e2cc3cc12cf51095b.png" :db/ensure [:answer/validate]} {:db/id "answer-fa38eaa9-fde9-5ac1-8936-620024312893" :answer/id #uuid "fa38eaa9-fde9-5ac1-8936-620024312893" :answer/type :answer.type/text :answer/value "No real solution" :db/ensure [:answer/validate]} {:db/id 17592186115903 :question/problem "Which of the following number lines represents the values of $x$ that satisfy $2x\\le 8$ or $3x+4\\ge 7?$" :question/worked-solution "We start by solving $2x\\le 8:$ \n\n$$\n\\begin{aligned}2x & \\le 8 \\\\ x & \\le 4\\end{aligned}\n$$\n\n![](images/f3/f3c81896babacce5e34f1cbb9f179f6843ae46fa45b8b4399b8f7f8eb11284c8.png)\n\nThen, we solve $3x+4\\ge 7:$ \n\n$$\n\\begin{aligned}3x+4 & \\ge 7 \\\\ 3x & \\ge 3 \\\\ x & \\ge 1\\end{aligned}\n$$\n\n![](images/c9/c9f85fc4864f321722a7cb0b017eab1979aa6a84cd07d08b150b625a1720f25a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/9c/9c045011d942bd93712aa87307994f00d9be9613c6dd547476f4fe7bd1622e19.png)\n\nTherefore, the final solution is $-\\infty <x<\\infty .$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186114355 :answer-field/correct 17592186114359 :db/ensure [:answer-field/validate]} {:db/id "question-7d1dc12b-037c-55bd-92e4-67849dd74463" :question/id #uuid "7d1dc12b-037c-55bd-92e4-67849dd74463" :question/math-academy-id "q-25489" :question/problem "Find the set of values of $x$ that satisfy $4x-5>9$ or $3<10x+8<16.$" :question/worked-solution "We start by solving $4x-5>9:$\n\n$$\n\\begin{aligned}4x-5 & >9 \\\\ 4x & >14 \\\\ x & >\\frac{14}{4} \\\\ x & >\\frac{7}{2}\\end{aligned}\n$$\n\n![](images/e3/e39459442837c3de83da860526c5f39b048d02b33b6ea0a3340efd599bb880d3.png)\n\nThen, we solve $3<10x+8<16:$\n\n$$\n\\begin{aligned}3 & <10x+8<16 \\\\ 3-8 & <10x<16-8 \\\\ -5 & <10x<8 \\\\ -\\frac{5}{10} & <x<\\frac{8}{10} \\\\ -\\frac{1}{2} & <x<\\frac{4}{5}\\end{aligned}\n$$\n\n![](images/61/611944fd64cf3638f0cfd4ae8f8a658496af927adc7b91f68e7aafdd36817272.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/11/112f50397f85c79e51650d88d2d4125cdb5479e60af579836bc3c8cd4eb22276.png)\n\nTherefore, the final solution is $x>\\frac{7}{2}$ or $-\\frac{1}{2}<x<\\frac{4}{5}.$ We can write this using interval notation as\n\n$$\n(-\\frac{1}{2},\\frac{4}{5})\\cup (\\frac{7}{2},\\infty ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-dbac6049-90c6-5602-a97a-d27179f99520"] :db/ensure [:question/validate]} {:db/id "answer-field-dbac6049-90c6-5602-a97a-d27179f99520" :answer-field/id #uuid "dbac6049-90c6-5602-a97a-d27179f99520" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1d0acf1f-a695-5686-a3d8-ca71b52cb1a4" :answer-field/choices ["answer-ca402586-983d-5d04-8c66-0efb1ad988e4" "answer-6edda186-30b5-5a11-8092-91ddd1baad9e" "answer-1d0acf1f-a695-5686-a3d8-ca71b52cb1a4" "answer-9ef9de4b-be83-5f15-bc32-f9912d585882" "answer-7a942b8e-874e-5ef9-8924-ccec67882267"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca402586-983d-5d04-8c66-0efb1ad988e4" :answer/id #uuid "ca402586-983d-5d04-8c66-0efb1ad988e4" :answer/type :answer.type/math :answer/value "(-4,5)" :db/ensure [:answer/validate]} {:db/id "answer-6edda186-30b5-5a11-8092-91ddd1baad9e" :answer/id #uuid "6edda186-30b5-5a11-8092-91ddd1baad9e" :answer/type :answer.type/math :answer/value "(-\\frac{1}{2},\\frac{4}{5})\\cup (\\frac{4}{5},\\frac{7}{2})" :db/ensure [:answer/validate]} {:db/id "answer-1d0acf1f-a695-5686-a3d8-ca71b52cb1a4" :answer/id #uuid "1d0acf1f-a695-5686-a3d8-ca71b52cb1a4" :answer/type :answer.type/math :answer/value "(-\\frac{1}{2},\\frac{4}{5})\\cup (\\frac{7}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-9ef9de4b-be83-5f15-bc32-f9912d585882" :answer/id #uuid "9ef9de4b-be83-5f15-bc32-f9912d585882" :answer/type :answer.type/math :answer/value "(-\\frac{1}{2},\\frac{7}{2})" :db/ensure [:answer/validate]} {:db/id "answer-7a942b8e-874e-5ef9-8924-ccec67882267" :answer/id #uuid "7a942b8e-874e-5ef9-8924-ccec67882267" :answer/type :answer.type/math :answer/value "(-\\frac{7}{2},\\frac{4}{5})\\cup (\\frac{7}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-83a6d940-fad6-59a8-acb5-f275a8b09b93" :question/id #uuid "83a6d940-fad6-59a8-acb5-f275a8b09b93" :question/math-academy-id "q-28988" :question/problem "Find the set of values of $x$ that satisfy $2<4x-3<3$ or $4x-3\\ge 4.$" :question/worked-solution "We start by solving $2<4x-3<3:$\n\n$$\n\\begin{aligned}2 & <4x-3<3 \\\\ 5 & <4x<6 \\\\ \\frac{5}{4} & <x<\\frac{6}{4} \\\\ \\frac{5}{4} & <x<\\frac{3}{2}\\end{aligned}\n$$\n\n![](images/ba/bac195a89ad5d09fa7753fe32bc5f4633453d37816c53330321e000579a8cb85.png)\n\nThen, we solve $4x-3\\ge 4:$\n\n$$\n\\begin{aligned}4x-3 & \\ge 4 \\\\ 4x & \\ge 7 \\\\ x & \\ge \\frac{7}{4}\\end{aligned}\n$$\n\n![](images/09/09fd2be8420b15d39149183d5b802fdcdbd20739ab7364663e0592e61aaf12df.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/6a/6ac5a412c535841b9872b1cbe4edee815e173dd43f3bb757616b7ca9a68200b8.png)\n\nTherefore, the final solution is $\\frac{5}{4}<x<\\frac{3}{2}$ or $x\\ge \\frac{7}{4}.$ We can write this using interval notation as\n\n$$\n(\\frac{5}{4},\\frac{3}{2})\\cup [\\frac{7}{4},\\infty ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3dd10fbd-61f3-54a4-a711-5930036f3a9c"] :db/ensure [:question/validate]} {:db/id "answer-field-3dd10fbd-61f3-54a4-a711-5930036f3a9c" :answer-field/id #uuid "3dd10fbd-61f3-54a4-a711-5930036f3a9c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7195a570-e270-5793-802f-906d24f44063" :answer-field/choices ["answer-b17e291b-b445-5794-8977-135119a3a0ff" "answer-6dc360a4-3724-5f32-8d03-0c02d7c587f9" "answer-a825b680-9363-5985-8b72-a7133059db3c" "answer-7195a570-e270-5793-802f-906d24f44063" "answer-e3f18e78-6255-505a-b02a-60b50e82717b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b17e291b-b445-5794-8977-135119a3a0ff" :answer/id #uuid "b17e291b-b445-5794-8977-135119a3a0ff" :answer/type :answer.type/math :answer/value "(-\\frac{1}{4},0)\\cup [\\frac{1}{4},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-6dc360a4-3724-5f32-8d03-0c02d7c587f9" :answer/id #uuid "6dc360a4-3724-5f32-8d03-0c02d7c587f9" :answer/type :answer.type/math :answer/value "(-\\frac{1}{4},0)\\cup [\\frac{7}{4},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a825b680-9363-5985-8b72-a7133059db3c" :answer/id #uuid "a825b680-9363-5985-8b72-a7133059db3c" :answer/type :answer.type/math :answer/value "(-\\frac{3}{2},\\frac{7}{4})" :db/ensure [:answer/validate]} {:db/id "answer-7195a570-e270-5793-802f-906d24f44063" :answer/id #uuid "7195a570-e270-5793-802f-906d24f44063" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},\\frac{3}{2})\\cup [\\frac{7}{4},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-e3f18e78-6255-505a-b02a-60b50e82717b" :answer/id #uuid "e3f18e78-6255-505a-b02a-60b50e82717b" :answer/type :answer.type/math :answer/value "[2,3)\\cup [4,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186115576 :question/problem "What is the set of values of $x$ that satisfy $2\\le 2x+6\\le 10$ or $8x+7\\le -9?$" :question/worked-solution "We start by solving $2\\le 2x+6\\le 10:$\n\n$$\n\\begin{aligned}2 & \\le 2x+6\\le 10 \\\\ -4 & \\le 2x\\le 4 \\\\ -2 & \\le x\\le 2\\end{aligned}\n$$\n\n![](images/1a/1ad54d12cf04e7142b0bcdd78484d9098fd9ca689f464fc5c03f1dbb0671569f.png)\n\nThen, we solve $8x+7\\le -9:$\n\n$$\n\\begin{aligned}8x+7 & \\le -9 \\\\ 8x & \\le -16 \\\\ x & \\le -2\\end{aligned}\n$$\n\n![](images/12/12c34a5af230afb788ddd8c689ef0e9b29c5c5adaf35a1e81099453436cf7f3f.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/bc/bc365364192f3784c565ebcb819a5f37885830f93510029647d39883217987cb.png)\n\nTherefore, the final solution is $x\\le 2.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186112434 :answer-field/correct 17592186112435 :db/ensure [:answer-field/validate]} {:db/id 17592186116417 :tutorial/content "Suppose we want to find all of the values of $x$ that satisfy *either* $4x+2 < 6$ *or* $2x \\geq 8.$\n\nTo do this, we solve each inequality individually and then compute the union of the two solutions.\n\nWe start by solving $4x+2 < 6\\mathbin{:}$\n\n$$\n\\begin{aligned}4x+2 & <6 \\\\ 4x & <4 \\\\ x & <1\\end{aligned}\n$$\n\n![](images/0d/0d36b8e68d9fd0b33b255502860481eeb525b60382029b17434bfb072cc39da2.png)\n\nThen, we solve $2x \\geq 8\\mathbin{:}$\n\n$$\n\\begin{aligned}2x & \\ge 8 \\\\ x & \\ge 4\\end{aligned}\n$$\n\n![](images/ed/edf5665b7cab7f51e3f252601a96d43c6f0cbfc64e5c9b8da81f0ef09d7b2f5a.png)\n\nTo graph the values of $x$ that satisfy either inequality, we overlay the two graphs on the same number line:\n\n![](images/5c/5c60839a626f2ba8a0fe4a24f4011af0fa52c00d79fbf80039bcfdbdf0a612c7.png)\n\nThus, the final solution is $x < 1$ or $x \\geq 4.$ We can write this using interval notation as\n\n$$\n(-\\infty, 1) \\cup [4,\\infty).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186115415 :activity/expected-seconds 720.0 :db/ensure [:activity/validate]} {:db/id 17592186172106 :knowledge-point/questions ["question-7f9f9f92-90ae-5c14-9ede-c5718a2ba70e" "question-33a01272-f3c9-5c47-b349-cebcb033572c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7f9f9f92-90ae-5c14-9ede-c5718a2ba70e" :question/id #uuid "7f9f9f92-90ae-5c14-9ede-c5718a2ba70e" :question/math-academy-id "q-159628" :question/problem "Consider a sample of size ${n}_{1}=54$ from a population with standard deviation ${\\sigma }_{1}=3.7$ and a sample of size ${n}_{2}=77$ from a population with standard deviation ${\\sigma }_{2}=1.2.$ Given that the samples are independent and the sample means are ${\\overset{―}{x}}_{1}=23$ and  ${\\overset{―}{x}}_{2}=12,$ find a $99%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means.\n\n*Hint: Use the fact that $P(Z>2.576)=0.005,$ where $Z∼N(0,1).$*" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=23-12=11\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $99%$ confidence interval, we have \n\n$$\n\\alpha =1-0.99=0.01\\,⟹\\,\\frac{\\alpha }{2}=0.005.\n$$\n\nWe are given that $P(Z>2.576)=0.005.$ As a result, \n\n$$\n{z}_{\\alpha /2}={z}_{0.005}=2.576.\n$$\n\nNow, we can compute the margin of error:\n\n$$\nE=2.576\\cdot \\sqrt{\\frac{{3.7}^{2}}{54}+\\frac{{1.2}^{2}}{77}}≈1.344\n$$\n\n- **Step 3.** Construct the $99%$ confidence interval for the difference between the population means:\n\n$$\n\\begin{aligned} & 11\\pm 1.344\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-05a48ccb-a74e-541e-97fa-2294603b02e6"] :db/ensure [:question/validate]} {:db/id "answer-field-05a48ccb-a74e-541e-97fa-2294603b02e6" :answer-field/id #uuid "05a48ccb-a74e-541e-97fa-2294603b02e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-37885ebf-04e6-5d47-8e02-92e0f6c71755" :answer-field/choices ["answer-016ded86-d025-503c-b985-6d6426861714" "answer-068bb060-b53b-584e-bc05-e9b1925f5bf9" "answer-37885ebf-04e6-5d47-8e02-92e0f6c71755" "answer-e7086e67-8297-5052-9066-130384411f8b" "answer-b5897ae1-26f4-5f76-a208-ed3f569c0dfa"] :db/ensure [:answer-field/validate]} {:db/id "answer-016ded86-d025-503c-b985-6d6426861714" :answer/id #uuid "016ded86-d025-503c-b985-6d6426861714" :answer/type :answer.type/math :answer/value "11\\pm 0.701" :db/ensure [:answer/validate]} {:db/id "answer-068bb060-b53b-584e-bc05-e9b1925f5bf9" :answer/id #uuid "068bb060-b53b-584e-bc05-e9b1925f5bf9" :answer/type :answer.type/math :answer/value "11\\pm 0.747" :db/ensure [:answer/validate]} {:db/id "answer-37885ebf-04e6-5d47-8e02-92e0f6c71755" :answer/id #uuid "37885ebf-04e6-5d47-8e02-92e0f6c71755" :answer/type :answer.type/math :answer/value "11\\pm 1.344" :db/ensure [:answer/validate]} {:db/id "answer-e7086e67-8297-5052-9066-130384411f8b" :answer/id #uuid "e7086e67-8297-5052-9066-130384411f8b" :answer/type :answer.type/math :answer/value "11\\pm 1.433" :db/ensure [:answer/validate]} {:db/id "answer-b5897ae1-26f4-5f76-a208-ed3f569c0dfa" :answer/id #uuid "b5897ae1-26f4-5f76-a208-ed3f569c0dfa" :answer/type :answer.type/math :answer/value "11\\pm 1.649" :db/ensure [:answer/validate]} {:db/id "question-33a01272-f3c9-5c47-b349-cebcb033572c" :question/id #uuid "33a01272-f3c9-5c47-b349-cebcb033572c" :question/math-academy-id "q-159630" :question/problem "Consider a sample of size ${n}_{1}=82$ from a population with standard deviation ${\\sigma }_{1}=4.6$ and a sample of size ${n}_{2}=73$ from a population with standard deviation ${\\sigma }_{2}=5.2.$ Given that the samples are independent and the sample means are ${\\overset{―}{x}}_{1}=33$ and  ${\\overset{―}{x}}_{2}=26,$ find a $90%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means.\n\n*Hint: Use the fact that $P(Z>1.645)=0.05,$ where $Z∼N(0,1).$*" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=33-26=7\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $90%$ confidence interval, we have \n\n$$\n\\alpha =1-0.9=0.1\\,⟹\\,\\frac{\\alpha }{2}=0.05.\n$$\n\nWe are given that $P(Z>1.645)=0.05.$ As a result, \n\n$$\n{z}_{\\alpha /2}={z}_{0.05}=1.645.\n$$\n\nNow, we can compute the margin of error:\n\n$$\nE=1.645\\cdot \\sqrt{\\frac{{4.6}^{2}}{82}+\\frac{{5.2}^{2}}{73}}≈1.304\n$$\n\n- **Step 3.** Construct the $90%$ confidence interval for the difference between the population means:\n\n$$\n\\begin{aligned} & 7\\pm 1.304\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5e4d1d6d-2c26-56bc-a27d-991d70114cf3"] :db/ensure [:question/validate]} {:db/id "answer-field-5e4d1d6d-2c26-56bc-a27d-991d70114cf3" :answer-field/id #uuid "5e4d1d6d-2c26-56bc-a27d-991d70114cf3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-61672d44-76c1-5941-96f9-b547c24560e4" :answer-field/choices ["answer-f8b14202-3b4b-5788-bb0b-55e0f3678b90" "answer-b148fa07-0393-5190-a3cf-99f1bae95ad4" "answer-61672d44-76c1-5941-96f9-b547c24560e4" "answer-4ff10644-8d80-59d2-847c-acdc62e1d31c" "answer-5737153b-7255-54c5-9ed1-76b4f29f597d"] :db/ensure [:answer-field/validate]} {:db/id "answer-f8b14202-3b4b-5788-bb0b-55e0f3678b90" :answer/id #uuid "f8b14202-3b4b-5788-bb0b-55e0f3678b90" :answer/type :answer.type/math :answer/value "7\\pm 0.587" :db/ensure [:answer/validate]} {:db/id "answer-b148fa07-0393-5190-a3cf-99f1bae95ad4" :answer/id #uuid "b148fa07-0393-5190-a3cf-99f1bae95ad4" :answer/type :answer.type/math :answer/value "7\\pm 1.034" :db/ensure [:answer/validate]} {:db/id "answer-61672d44-76c1-5941-96f9-b547c24560e4" :answer/id #uuid "61672d44-76c1-5941-96f9-b547c24560e4" :answer/type :answer.type/math :answer/value "7\\pm 1.304" :db/ensure [:answer/validate]} {:db/id "answer-4ff10644-8d80-59d2-847c-acdc62e1d31c" :answer/id #uuid "4ff10644-8d80-59d2-847c-acdc62e1d31c" :answer/type :answer.type/math :answer/value "7\\pm 1.403" :db/ensure [:answer/validate]} {:db/id "answer-5737153b-7255-54c5-9ed1-76b4f29f597d" :answer/id #uuid "5737153b-7255-54c5-9ed1-76b4f29f597d" :answer/type :answer.type/math :answer/value "7\\pm 1.837" :db/ensure [:answer/validate]} {:db/id 17592186172129 :knowledge-point/questions ["question-a0faeac4-bc51-5e0f-965c-b834d48291a3" "question-5acbf13f-ff67-5449-9947-a8679cb075b9" "question-5b6883ab-506f-535a-b78d-aa1454cc2ffc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a0faeac4-bc51-5e0f-965c-b834d48291a3" :question/id #uuid "a0faeac4-bc51-5e0f-965c-b834d48291a3" :question/math-academy-id "q-159636" :question/problem "The lengths of traditional baguettes and brown baguettes made at a particular French bakery have standard deviations of $4\\,\\text{cm}$ and $3\\,\\text{cm},$ respectively. The baker wants to determine whether the population mean ${\\mu }_{x}$ of the lengths of traditional baguettes is larger than the population mean ${\\mu }_{y}$ of the lengths of brown baguettes. He constructs a $90%$ confidence interval for the difference between the population means.\n\nGiven that the baker sampled $50$ traditional baguettes and $40$ brown baguettes and found that their mean lengths were $65\\,\\text{cm}$ and $63.5\\,\\text{cm},$ respectively, which of the following statements are true?\n\nI. The end-points of the $90%$ confidence interval for the difference between the population means are approximately $1.5\\pm 1.421.$\n\nII. All values contained within the $90%$ confidence interval are positive.\n\nIII. The confidence interval data suggests that ${\\mu }_{x}>{\\mu }_{y}.$\n\n*Hint: Given a random variable $Z∼N(0,1),$ the table below shows the $z$-scores ${z}_{p}$ such that $P(Z>{z}_{p})=p$ for some particular values of $p.$*\n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=65-63.5=1.5\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $90%$ confidence interval, we have \n\n$$\n\\alpha =1-0.90=0.1\\,⟹\\,\\frac{\\alpha }{2}=0.05.\n$$\n\nWe also need to find the $z$-score value ${z}_{0.05}$ such that $P(Z>{z}_{0.05})=0.05,$ where $Z∼N(0,1).$\nFrom the percentage points table of the normal distribution, we obtain that ${z}_{0.05}=1.645:$  \n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |\n\n \n\nNow, we can compute the margin of error:\n\n$$\nE=1.645\\cdot \\sqrt{\\frac{{4}^{2}}{50}+\\frac{{3}^{2}}{40}}≈1.214\n$$\n\n- **Step 3.** Construct the confidence interval:\n\n$$\n\\begin{aligned} & 1.5\\pm 1.214\\end{aligned}\n$$\n\nLet's now examine our statements.\n\n- Statement I is false. The end-points of our confidence interval are $1.5\\pm 1.214.$\n\n- Statement II is true. All values within the confidence interval are positive:\n\n$$\n(1.5-1.214,\\,1.5+1.214)=(0.286,\\,2.714)\n$$\n\n- Statement III is true. Since all values within the confidence interval are positive, this suggests that ${\\mu }_{x}>{\\mu }_{y}.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5eb63ba3-c644-5698-927f-01d281fe6523"] :db/ensure [:question/validate]} {:db/id "answer-field-5eb63ba3-c644-5698-927f-01d281fe6523" :answer-field/id #uuid "5eb63ba3-c644-5698-927f-01d281fe6523" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-191026ef-026f-56e1-aed9-51375e82a905" :answer-field/choices ["answer-39af70a3-b7c9-5157-a843-61baeb776152" "answer-86b3b730-b022-5e9e-ae72-0ac285e66745" "answer-191026ef-026f-56e1-aed9-51375e82a905" "answer-e2f6975c-69e9-5183-8d49-09c3be9f6789" "answer-adadc4f6-e872-59e0-a4f8-ce8c2ef02108"] :db/ensure [:answer-field/validate]} {:db/id "answer-39af70a3-b7c9-5157-a843-61baeb776152" :answer/id #uuid "39af70a3-b7c9-5157-a843-61baeb776152" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-86b3b730-b022-5e9e-ae72-0ac285e66745" :answer/id #uuid "86b3b730-b022-5e9e-ae72-0ac285e66745" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-191026ef-026f-56e1-aed9-51375e82a905" :answer/id #uuid "191026ef-026f-56e1-aed9-51375e82a905" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-e2f6975c-69e9-5183-8d49-09c3be9f6789" :answer/id #uuid "e2f6975c-69e9-5183-8d49-09c3be9f6789" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-adadc4f6-e872-59e0-a4f8-ce8c2ef02108" :answer/id #uuid "adadc4f6-e872-59e0-a4f8-ce8c2ef02108" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-5acbf13f-ff67-5449-9947-a8679cb075b9" :question/id #uuid "5acbf13f-ff67-5449-9947-a8679cb075b9" :question/math-academy-id "q-159664" :question/problem "The scores of girls and boys on a national post-high school exam have standard deviations of $3$ points and $4$ points, respectively. The authorities want to determine whether the population mean ${\\mu }_{x}$ of the girls' scores is the same as the population mean ${\\mu }_{y}$ of the boys' scores. They construct a $95$ confidence interval for the difference between the population means.\n\nOfficials sampled $111$ girls and $115$ boys and found that their mean scores on the test were $74$ points and $73.4$ points, respectively. Which of the following statements are true?\n\nI. The end-points of the $95%$ confidence interval for the difference between the population means are approximately $0.6\\pm 0.92.$\n\nII. All values contained within the $95%$ confidence interval are positive.\n\nIII. The confidence interval data suggests that ${\\mu }_{x}>{\\mu }_{y}.$\n\n*Hint: Given a random variable $Z∼N(0,1),$ the table below shows the $z$-scores ${z}_{p}$ such that $P(Z>{z}_{p})=p$ for some particular values of $p.$*\n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=74-73.6=0.6\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $95%$ confidence interval, we have \n\n$$\n\\alpha =1-0.95=0.05\\,⟹\\,\\frac{\\alpha }{2}=0.025.\n$$\n\nWe also need to find the $z$-score value ${z}_{0.025}$ such that $P(Z>{z}_{0.025})=0.025,$ where $Z∼N(0,1).$\nFrom the percentage points table of the normal distribution, we obtain that ${z}_{0.025}=1.960:$ \n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |\n\n \n\nNow, we can compute the margin of error:\n\n$$\nE=1.960\\cdot \\sqrt{\\frac{{3}^{2}}{111}+\\frac{{4}^{2}}{115}}≈0.920\n$$\n\n- **Step 3.** Construct the confidence interval:\n\n$$\n\\begin{aligned} & 0.6\\pm 0.920\\end{aligned}\n$$\n\nLet's now examine our statements.\n\n- Statement I is true. The end-points of our confidence interval are $0.6\\pm 0.920.$\n\n- Statement II is false. The confidence interval contains $0:$\n\n$$\n(0.6-0.92,\\,0.6+0.92)=(-0.32,\\,1.52)\n$$\n\n- Statement III is false. Since the confidence interval contains zero, it remains possible that ${\\mu }_{x}={\\mu }_{y}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bcbeeea1-2823-5cdd-8385-469893fd88bb"] :db/ensure [:question/validate]} {:db/id "answer-field-bcbeeea1-2823-5cdd-8385-469893fd88bb" :answer-field/id #uuid "bcbeeea1-2823-5cdd-8385-469893fd88bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-91ed605b-90ba-53ea-9dfb-1121054ab8be" :answer-field/choices ["answer-0fea37df-e66f-522e-b62b-c4201b1b4816" "answer-91ed605b-90ba-53ea-9dfb-1121054ab8be" "answer-62f9b791-9810-563a-bab9-7a82307110c7" "answer-dd43de8d-951e-5173-a7ee-0e8b7890925f" "answer-23e3d9b1-9b71-54ad-a4bf-163a871b7d0f"] :db/ensure [:answer-field/validate]} {:db/id "answer-0fea37df-e66f-522e-b62b-c4201b1b4816" :answer/id #uuid "0fea37df-e66f-522e-b62b-c4201b1b4816" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-91ed605b-90ba-53ea-9dfb-1121054ab8be" :answer/id #uuid "91ed605b-90ba-53ea-9dfb-1121054ab8be" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-62f9b791-9810-563a-bab9-7a82307110c7" :answer/id #uuid "62f9b791-9810-563a-bab9-7a82307110c7" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-dd43de8d-951e-5173-a7ee-0e8b7890925f" :answer/id #uuid "dd43de8d-951e-5173-a7ee-0e8b7890925f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-23e3d9b1-9b71-54ad-a4bf-163a871b7d0f" :answer/id #uuid "23e3d9b1-9b71-54ad-a4bf-163a871b7d0f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-5b6883ab-506f-535a-b78d-aa1454cc2ffc" :question/id #uuid "5b6883ab-506f-535a-b78d-aa1454cc2ffc" :question/math-academy-id "q-159667" :question/problem "A study of body weight conducted on two age groups of women, X and Y, yields standard deviations of ${\\sigma }_{x}=8\\,\\text{lb}$ and ${\\sigma }_{y}=10\\,\\text{lb},$ respectively.\nA researcher wants to determine whether the population mean ${\\mu }_{x}$ of the weights of group X is smaller than the population mean ${\\mu }_{y}$ of the weights of group Y. She decides to construct a $90%$ confidence interval for the difference between the population means.\n\nThe researcher sampled $50$ women from group X and $55$ from group Y, finding that their mean weights are $58\\,lb$ and $64\\,lb,$  respectively. Which of the following statements are true?  \n\nI. The end-points of the $90%$ confidence interval for the difference between the population means are approximately $-6\\pm 2.895.$\n\nII. All values contained within the $90%$ confidence interval are negative.\n\nIII. The confidence interval data suggests that ${\\mu }_{x}<{\\mu }_{y}.$\n\n*Hint: Given a random variable $Z∼N(0,1),$ the table below shows the $z$-scores ${z}_{p}$ such that $P(Z>{z}_{p})=p$ for some particular values of $p.$*\n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=58-64=-6\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $90%$ confidence interval, we have \n\n$$\n\\alpha =1-0.90=0.1\\,⟹\\,\\frac{\\alpha }{2}=0.05.\n$$\n\nWe also need to find the $z$-score value ${z}_{0.05}$ such that $P(Z>{z}_{0.05})=0.05,$ where $Z∼N(0,1).$\nFrom the percentage points table of the normal distribution, we obtain that ${z}_{0.05}=1.645:$  \n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |\n\n \n\nNow, we can compute the margin of error:\n\n$$\nE=1.645\\cdot \\sqrt{\\frac{{8}^{2}}{50}+\\frac{{10}^{2}}{55}}≈2.895\n$$\n\n- **Step 3.** Construct the confidence interval:\n\n$$\n\\begin{aligned} & -6\\pm 2.895\\end{aligned}\n$$\n\nLet's now examine our statements.\n\n- Statement I is true. The end-points of our confidence interval are $-6\\pm 2.895.$\n\n- Statement II is true. All values within the confidence interval are negative:\n\n$$\n(-6-2.895,\\,-6+2.895)=(-8.895,\\,-3.105)\n$$\n\n- Statement III is true. Since all values within the confidence interval are negative, this suggests that ${\\mu }_{x}<{\\mu }_{y}.$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-63a3ec7b-79e1-5862-a616-14f2961b8754"] :db/ensure [:question/validate]} {:db/id "answer-field-63a3ec7b-79e1-5862-a616-14f2961b8754" :answer-field/id #uuid "63a3ec7b-79e1-5862-a616-14f2961b8754" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-341e9984-edd6-50e2-bcfc-5f3f669d286d" :answer-field/choices ["answer-bda6715a-bd7f-5810-9508-0c32ee7cc877" "answer-341e9984-edd6-50e2-bcfc-5f3f669d286d" "answer-a7a8c787-0565-563f-b6ab-1b60b46da41c" "answer-f5bc53a9-6a52-56d2-9347-e34017750f74" "answer-41f44e83-0d9c-596d-b75d-78d997dc828e"] :db/ensure [:answer-field/validate]} {:db/id "answer-bda6715a-bd7f-5810-9508-0c32ee7cc877" :answer/id #uuid "bda6715a-bd7f-5810-9508-0c32ee7cc877" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-341e9984-edd6-50e2-bcfc-5f3f669d286d" :answer/id #uuid "341e9984-edd6-50e2-bcfc-5f3f669d286d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-a7a8c787-0565-563f-b6ab-1b60b46da41c" :answer/id #uuid "a7a8c787-0565-563f-b6ab-1b60b46da41c" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-f5bc53a9-6a52-56d2-9347-e34017750f74" :answer/id #uuid "f5bc53a9-6a52-56d2-9347-e34017750f74" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-41f44e83-0d9c-596d-b75d-78d997dc828e" :answer/id #uuid "41f44e83-0d9c-596d-b75d-78d997dc828e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-edcee70a-6434-5e86-b8e7-971648d37f3e" :activity/id #uuid "edcee70a-6434-5e86-b8e7-971648d37f3e" :activity/title "Confidence Intervals for Two Means: Known and Unequal Population Variances" :activity/type :activity.type/review :activity/scope 17592186049866 :activity/course 17592186046658 :activity/steps ["step-5207b2ac-ba48-5823-9d3d-fc02b606d266" "step-f9b44149-b78f-586f-aef5-56e50d096b88" "step-a2ed7b82-21f1-5f47-b31c-6616cabb005c" "step-517bedd8-acc9-5598-9606-561a1e7bcb04" "step-eeaf510f-334c-5379-92ee-488a7974c6bf"] :activity/first-step "step-5207b2ac-ba48-5823-9d3d-fc02b606d266" :db/ensure [:activity/validate]} {:db/id "step-5207b2ac-ba48-5823-9d3d-fc02b606d266" :step/id #uuid "5207b2ac-ba48-5823-9d3d-fc02b606d266" :step/content "question-7f9f9f92-90ae-5c14-9ede-c5718a2ba70e" :step/next "step-f9b44149-b78f-586f-aef5-56e50d096b88" :db/ensure [:step/validate]} {:db/id "step-f9b44149-b78f-586f-aef5-56e50d096b88" :step/id #uuid "f9b44149-b78f-586f-aef5-56e50d096b88" :step/content "question-33a01272-f3c9-5c47-b349-cebcb033572c" :step/next "step-a2ed7b82-21f1-5f47-b31c-6616cabb005c" :db/ensure [:step/validate]} {:db/id "step-a2ed7b82-21f1-5f47-b31c-6616cabb005c" :step/id #uuid "a2ed7b82-21f1-5f47-b31c-6616cabb005c" :step/content "question-a0faeac4-bc51-5e0f-965c-b834d48291a3" :step/next "step-517bedd8-acc9-5598-9606-561a1e7bcb04" :db/ensure [:step/validate]} {:db/id "step-517bedd8-acc9-5598-9606-561a1e7bcb04" :step/id #uuid "517bedd8-acc9-5598-9606-561a1e7bcb04" :step/content "question-5acbf13f-ff67-5449-9947-a8679cb075b9" :step/next "step-eeaf510f-334c-5379-92ee-488a7974c6bf" :db/ensure [:step/validate]} {:db/id "step-eeaf510f-334c-5379-92ee-488a7974c6bf" :step/id #uuid "eeaf510f-334c-5379-92ee-488a7974c6bf" :step/content "question-5b6883ab-506f-535a-b78d-aa1454cc2ffc" :db/ensure [:step/validate]} {:db/id 17592186344834 :answer-field/correct 17592186343227 :db/ensure [:answer-field/validate]} {:db/id 17592186262664 :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4t-{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3})⟩ \\\\  & =⟨4-2t,3{t}^{2}⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $⟨0\\,,\\,1\\,,\\,3⟩$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that ${r}^{′}({t}_{0})=c⟨2,1⟩.$ So, we have\n\n$$\n\\begin{aligned}{r}^{′}(t) & =c⟨2,1⟩ \\\\ ⟨4-2t,3{t}^{2}⟩ & =c⟨2,1⟩ \\\\ ⟨4-2t,3{t}^{2}⟩ & =⟨2c,c⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n\\{\\begin{aligned}4-2t=2c \\\\ 3{t}^{2}=c\\end{aligned}\n$$\n\nFrom the first equation, we obtain that $c=2-t.$ Substituting in the second equation, we get\n\n$$\n\\begin{aligned}3{t}^{2} & =2-t \\\\ 3{t}^{2}+t-2 & =0 \\\\ (3t-2)(t+1) & =0.\\end{aligned}\n$$\n\nTherefore, $⟨2,1⟩$ and ${r}^{′}$ are parallel only at the points corresponding to $t=-1,\\frac{2}{3}.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(-1) & =⟨4(-1)-(-1)^{2},(-1)^{3}⟩=⟨-5,-1⟩ \\\\ r(\\frac{2}{3}) & =⟨4(\\frac{2}{3})-{(\\frac{2}{3})}^{2},{(\\frac{2}{3})}^{3}⟩=⟨\\frac{20}{9},\\frac{8}{27}⟩\\end{aligned}\n$$\n\nwe conclude that $⟨2,1⟩$ and ${r}^{′}(t)$ are parallel at the points $(-5,-1)$ and $(\\frac{20}{9},\\frac{8}{27}).$" :db/ensure [:question/validate]} {:db/id "activity-4ac98174-23fb-56c7-aa42-87bd53136ffc" :activity/id #uuid "4ac98174-23fb-56c7-aa42-87bd53136ffc" :activity/title "Tangent Vectors and Tangent Lines to Curves" :activity/type :activity.type/review :activity/scope 17592186048377 :activity/course 17592186046658 :activity/steps ["step-ccf8c39a-29e3-592d-8a48-1ca1d41e9f28" "step-9feee794-e3e7-5c76-b0a7-b75fa9c75d71" "step-3ffa00d6-c195-5c51-ba40-87eda1859e72" "step-9a79291f-1a57-5bc2-94db-68fc1780e073" "step-feabdf5c-4763-5d3a-872a-568b04e425bd"] :activity/first-step "step-ccf8c39a-29e3-592d-8a48-1ca1d41e9f28" :db/ensure [:activity/validate]} {:db/id "step-ccf8c39a-29e3-592d-8a48-1ca1d41e9f28" :step/id #uuid "ccf8c39a-29e3-592d-8a48-1ca1d41e9f28" :step/content 17592186405125 :step/next "step-9feee794-e3e7-5c76-b0a7-b75fa9c75d71" :db/ensure [:step/validate]} {:db/id "step-9feee794-e3e7-5c76-b0a7-b75fa9c75d71" :step/id #uuid "9feee794-e3e7-5c76-b0a7-b75fa9c75d71" :step/content 17592186345102 :step/next "step-3ffa00d6-c195-5c51-ba40-87eda1859e72" :db/ensure [:step/validate]} {:db/id "step-3ffa00d6-c195-5c51-ba40-87eda1859e72" :step/id #uuid "3ffa00d6-c195-5c51-ba40-87eda1859e72" :step/content 17592186262656 :step/next "step-9a79291f-1a57-5bc2-94db-68fc1780e073" :db/ensure [:step/validate]} {:db/id "step-9a79291f-1a57-5bc2-94db-68fc1780e073" :step/id #uuid "9a79291f-1a57-5bc2-94db-68fc1780e073" :step/content 17592186262664 :step/next "step-feabdf5c-4763-5d3a-872a-568b04e425bd" :db/ensure [:step/validate]} {:db/id "step-feabdf5c-4763-5d3a-872a-568b04e425bd" :step/id #uuid "feabdf5c-4763-5d3a-872a-568b04e425bd" :step/content 17592186284535 :db/ensure [:step/validate]} {:db/id "activity-a9dac04c-1648-5b4e-86d3-1205da88a030" :activity/id #uuid "a9dac04c-1648-5b4e-86d3-1205da88a030" :activity/title "Singular Value Decomposition of 2x2 Matrices With Zero or Repeated Eigenvalues" :activity/type :activity.type/review :activity/scope 17592186050770 :activity/course 17592186046658 :activity/steps ["step-62827d70-413e-5244-ac1a-99e969a0d735" "step-30f716b9-bac1-5987-8616-3739a53ab992" "step-6b88169e-88b9-5707-adbe-e09b5dd00f13" "step-ba354e78-94fe-57d1-92f9-2c3ad8777fed" "step-eaab7ae9-7383-51d8-a5f1-02932bc4ec4b"] :activity/first-step "step-62827d70-413e-5244-ac1a-99e969a0d735" :db/ensure [:activity/validate]} {:db/id "step-62827d70-413e-5244-ac1a-99e969a0d735" :step/id #uuid "62827d70-413e-5244-ac1a-99e969a0d735" :step/content 17592186371353 :step/next "step-30f716b9-bac1-5987-8616-3739a53ab992" :db/ensure [:step/validate]} {:db/id "step-30f716b9-bac1-5987-8616-3739a53ab992" :step/id #uuid "30f716b9-bac1-5987-8616-3739a53ab992" :step/content 17592186385886 :step/next "step-6b88169e-88b9-5707-adbe-e09b5dd00f13" :db/ensure [:step/validate]} {:db/id "step-6b88169e-88b9-5707-adbe-e09b5dd00f13" :step/id #uuid "6b88169e-88b9-5707-adbe-e09b5dd00f13" :step/content 17592186404905 :step/next "step-ba354e78-94fe-57d1-92f9-2c3ad8777fed" :db/ensure [:step/validate]} {:db/id "step-ba354e78-94fe-57d1-92f9-2c3ad8777fed" :step/id #uuid "ba354e78-94fe-57d1-92f9-2c3ad8777fed" :step/content 17592186383452 :step/next "step-eaab7ae9-7383-51d8-a5f1-02932bc4ec4b" :db/ensure [:step/validate]} {:db/id "step-eaab7ae9-7383-51d8-a5f1-02932bc4ec4b" :step/id #uuid "eaab7ae9-7383-51d8-a5f1-02932bc4ec4b" :step/content 17592186369811 :db/ensure [:step/validate]} [:db/retract 17592186316710 :answer-field/choices 17592186315238] [:db/retract 17592186316623 :answer-field/choices 17592186316162] [:db/retract 17592186317091 :answer-field/choices 17592186315376] [:db/retract 17592186316890 :answer-field/choices 17592186315635] {:db/id 17592186221450 :knowledge-point/questions ["question-1d451e41-c662-5263-b3f7-8483ecaa8976"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1d451e41-c662-5263-b3f7-8483ecaa8976" :question/id #uuid "1d451e41-c662-5263-b3f7-8483ecaa8976" :question/math-academy-id "q-342964" :question/problem "Let $f(x)$ be the $6$-periodic extension of the function $F(x)=-2{x}^{2}+4$ defined on $[-3,3).$  Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $6$-periodic extension of $G(x)=-4x$ from the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n-2{x}^{2}+4∼-2+{\\sum }_{n=1}^{\\infty }\\frac{72(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n-4x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :question/worked-solution "First, notice that $F(x)$ is an even function. So, the Fourier series of its $2L$-periodic extension has the form\n\n$$\n\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{L}).\n$$\n\nIn our case, $L=3$ and we are already given the coefficients ${a}_{0}$ and ${a}_{n}$ for $n\\ge 1.$ Thus, the Fourier series of $f(x)$ is given by\n\n$$\nf(x)∼-2+{\\sum }_{n=1}^{\\infty }\\frac{72(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, notice that \n\n- the function $F$ is continuously differentiable on $(-3,3),$\n\n- continuous on $[-3,3),$ and\n\n- satisfies $F(-3)=F(3),$ if we extend the value at $x=3$ using the formula $F(x)=-2{x}^{2}+4.$\n\nTherefore, the $6$-periodic extension $f$ is $\\text{continuous}$ and $\\text{piecewise smooth}$ on $R,$ so we may differentiate its Fourier series term-by-term:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(-2{x}^{2}+4) & ∼\\frac{\\text{d}}{\\text{d}x}(-2)+{\\sum }_{n=1}^{\\infty }\\frac{\\text{d}}{\\text{d}x}(\\frac{72(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\ -4x & ∼0+{\\sum }_{n=1}^{\\infty }\\frac{72(-1)^{n+1}}{{n}^{2}{\\pi }^{2}}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\ -4x & ∼{\\sum }_{n=1}^{\\infty }\\frac{-24(-1)^{n+1}}{n\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\ -4x & ∼{\\sum }_{n=1}^{\\infty }\\,\\frac{24(-1)^{n}}{n\\pi }\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d46cd0be-3da6-58f1-a00a-a7431aa0897f" "answer-field-27e37b0e-023f-593f-895d-83527e86a1fb" "answer-field-1e0133f6-9cb4-56e2-8482-259ab0e11ec2" "answer-field-f6e028ab-a36c-5469-ba63-ab22fef00ac7" "answer-field-d9a5ddff-f037-5246-a150-e944038eee10"] :db/ensure [:question/validate]} {:db/id "answer-field-d46cd0be-3da6-58f1-a00a-a7431aa0897f" :answer-field/id #uuid "d46cd0be-3da6-58f1-a00a-a7431aa0897f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-be5da26b-6371-53a4-9ac5-17f64b40bfc8" :answer-field/choices ["answer-c7412e64-4513-5280-aa0d-2cc6735ca7f7" "answer-be5da26b-6371-53a4-9ac5-17f64b40bfc8" "answer-2da9d709-0215-57a2-8672-e6206c6adafe" "answer-7f765ddc-fd83-5d86-95d4-4600a92c5521" "answer-21514797-0014-5421-a36e-31ccffff9657" "answer-d5c4c7a7-3555-51c9-990c-07a246dd3fc1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c7412e64-4513-5280-aa0d-2cc6735ca7f7" :answer/id #uuid "c7412e64-4513-5280-aa0d-2cc6735ca7f7" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(3n\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-be5da26b-6371-53a4-9ac5-17f64b40bfc8" :answer/id #uuid "be5da26b-6371-53a4-9ac5-17f64b40bfc8" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{3})" :db/ensure [:answer/validate]} {:db/id "answer-2da9d709-0215-57a2-8672-e6206c6adafe" :answer/id #uuid "2da9d709-0215-57a2-8672-e6206c6adafe" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "answer-7f765ddc-fd83-5d86-95d4-4600a92c5521" :answer/id #uuid "7f765ddc-fd83-5d86-95d4-4600a92c5521" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(3n\\pi x)" :db/ensure [:answer/validate]} {:db/id "answer-21514797-0014-5421-a36e-31ccffff9657" :answer/id #uuid "21514797-0014-5421-a36e-31ccffff9657" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{3})" :db/ensure [:answer/validate]} {:db/id "answer-d5c4c7a7-3555-51c9-990c-07a246dd3fc1" :answer/id #uuid "d5c4c7a7-3555-51c9-990c-07a246dd3fc1" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "answer-field-27e37b0e-023f-593f-895d-83527e86a1fb" :answer-field/id #uuid "27e37b0e-023f-593f-895d-83527e86a1fb" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-7139a1ad-a9b4-56d8-916d-d4d2141976f4" :answer-field/choices ["answer-7139a1ad-a9b4-56d8-916d-d4d2141976f4" "answer-cad31426-8cc5-5aae-bd55-9de7be1534e1" "answer-ae0297c1-338b-5757-a155-71554421e62f"] :db/ensure [:answer-field/validate]} {:db/id "answer-7139a1ad-a9b4-56d8-916d-d4d2141976f4" :answer/id #uuid "7139a1ad-a9b4-56d8-916d-d4d2141976f4" :answer/type :answer.type/text :answer/value "continuous" :db/ensure [:answer/validate]} {:db/id "answer-cad31426-8cc5-5aae-bd55-9de7be1534e1" :answer/id #uuid "cad31426-8cc5-5aae-bd55-9de7be1534e1" :answer/type :answer.type/text :answer/value "even" :db/ensure [:answer/validate]} {:db/id "answer-ae0297c1-