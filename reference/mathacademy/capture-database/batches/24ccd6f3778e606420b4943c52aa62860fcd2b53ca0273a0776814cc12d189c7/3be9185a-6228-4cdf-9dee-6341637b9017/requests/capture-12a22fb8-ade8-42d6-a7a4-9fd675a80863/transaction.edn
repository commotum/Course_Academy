5ba0-b28f-d33a28c1ef05" :step/next "step-86ca3dbd-2f97-5188-a8f9-631428edda38" :db/ensure [:step/validate]} {:db/id "step-86ca3dbd-2f97-5188-a8f9-631428edda38" :step/id #uuid "86ca3dbd-2f97-5188-a8f9-631428edda38" :step/content "question-a3e34c03-c5d1-5308-b87f-8c0345829c50" :step/next "step-d7f58127-d52a-5777-9d96-fc2b0624caf3" :db/ensure [:step/validate]} {:db/id "step-d7f58127-d52a-5777-9d96-fc2b0624caf3" :step/id #uuid "d7f58127-d52a-5777-9d96-fc2b0624caf3" :step/content "question-4ffb5f5e-d005-5651-a067-5254cbe8580f" :step/next "step-c648d137-022b-534c-a353-55c4d167b7fb" :db/ensure [:step/validate]} {:db/id "step-c648d137-022b-534c-a353-55c4d167b7fb" :step/id #uuid "c648d137-022b-534c-a353-55c4d167b7fb" :step/content "question-da75b2dd-3237-5ce6-9291-2b2e45f7ef20" :step/next "step-48cc0a46-d7c1-5da9-bc93-3faa6f6fc0b4" :db/ensure [:step/validate]} {:db/id "step-48cc0a46-d7c1-5da9-bc93-3faa6f6fc0b4" :step/id #uuid "48cc0a46-d7c1-5da9-bc93-3faa6f6fc0b4" :step/content 17592186143194 :step/next "step-78c00e67-9e06-5c3d-95eb-ca5ad486f7a1" :db/ensure [:step/validate]} {:db/id "step-78c00e67-9e06-5c3d-95eb-ca5ad486f7a1" :step/id #uuid "78c00e67-9e06-5c3d-95eb-ca5ad486f7a1" :step/content "question-7d6b5a99-b4f7-505b-8d4c-543bc5253331" :step/next "step-e5cb3772-a6c9-58ba-ad1b-cf1de878a32e" :db/ensure [:step/validate]} {:db/id "step-e5cb3772-a6c9-58ba-ad1b-cf1de878a32e" :step/id #uuid "e5cb3772-a6c9-58ba-ad1b-cf1de878a32e" :step/content "question-1ca8d09c-3b66-59cf-8927-0d3c487f55e4" :db/ensure [:step/validate]} {:db/id 17592186192797 :knowledge-point/questions ["question-4a460e59-a60e-5c01-b0d6-ac09a000a8e4" "question-7231eacb-7b8d-5da7-a852-73cf2a0b08b9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4a460e59-a60e-5c01-b0d6-ac09a000a8e4" :question/id #uuid "4a460e59-a60e-5c01-b0d6-ac09a000a8e4" :question/math-academy-id "q-159874" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{5}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ For a particular sample ${x}_{1},{x}_{2},…,{x}_{5},$ you're given that \n\n$$\n{\\sum }_{i=1}^{5}{x}_{i}=4.5.\n$$\n\nFind the likelihood function of the sample.\n\n*Hint: The probability density function for an exponential random variable is given by* \n\n$$\nf(x;\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=5$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}\\theta {e}^{-\\theta {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-\\theta \\sum {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-S\\theta }\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$ \n\nWe are told that $S={\\sum }_{i=1}^{n}{x}_{i}=4.5$ and $n=5.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & ={\\theta }^{5}\\,{e}^{-4.5\\theta }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-afa1de34-af75-5f8e-b326-c843f5d31eb8"] :db/ensure [:question/validate]} {:db/id "answer-field-afa1de34-af75-5f8e-b326-c843f5d31eb8" :answer-field/id #uuid "afa1de34-af75-5f8e-b326-c843f5d31eb8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2332428c-0956-5edc-8fe6-022460583d2e" :answer-field/choices ["answer-5e998d67-7741-5d32-adff-5aad49d3a8ff" "answer-4099daa4-c8e4-54d9-9751-3571d0836455" "answer-d5d4114d-abec-5620-b7d3-44264b2a1f94" "answer-7ecdaf55-77a9-5b17-80ef-8da0aeac0d0b" "answer-2332428c-0956-5edc-8fe6-022460583d2e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e998d67-7741-5d32-adff-5aad49d3a8ff" :answer/id #uuid "5e998d67-7741-5d32-adff-5aad49d3a8ff" :answer/type :answer.type/math :answer/value "\\theta \\,{e}^{-4.5\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-4099daa4-c8e4-54d9-9751-3571d0836455" :answer/id #uuid "4099daa4-c8e4-54d9-9751-3571d0836455" :answer/type :answer.type/math :answer/value "\\theta \\,{e}^{5\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-d5d4114d-abec-5620-b7d3-44264b2a1f94" :answer/id #uuid "d5d4114d-abec-5620-b7d3-44264b2a1f94" :answer/type :answer.type/math :answer/value "{\\theta }^{-5}\\,{e}^{4.5\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-7ecdaf55-77a9-5b17-80ef-8da0aeac0d0b" :answer/id #uuid "7ecdaf55-77a9-5b17-80ef-8da0aeac0d0b" :answer/type :answer.type/math :answer/value "{\\theta }^{4.5}\\,{e}^{-5\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-2332428c-0956-5edc-8fe6-022460583d2e" :answer/id #uuid "2332428c-0956-5edc-8fe6-022460583d2e" :answer/type :answer.type/math :answer/value "{\\theta }^{5}\\,{e}^{-4.5\\theta }" :db/ensure [:answer/validate]} {:db/id "question-7231eacb-7b8d-5da7-a852-73cf2a0b08b9" :question/id #uuid "7231eacb-7b8d-5da7-a852-73cf2a0b08b9" :question/math-academy-id "q-159875" :question/problem "Suppose ${X}_{1},{X}_{2},…,{X}_{11}$ is an I.I.D random sample with ${X}_{i}∼\\text{Exp}(\\theta )$ and unknown rate parameter $\\theta .$ For a particular sample ${x}_{1},{x}_{2},…,{x}_{11},$ you're given that \n\n$$\n{\\sum }_{i=1}^{11}{x}_{i}=8.8.\n$$\n\nFind the likelihood function of the sample.\n\n*Hint: The probability density function for an exponential random variable is given by* \n\n$$\nf(x;\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=11$ independent exponential random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\theta {e}^{-\\theta x},\\,x\\ge 0.\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}\\theta {e}^{-\\theta {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-\\theta \\sum {x}_{i}} \\\\  & ={\\theta }^{n}\\,{e}^{-S\\theta }\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}.$ \n\nWe are told that $S={\\sum }_{i=1}^{n}{x}_{i}=8.8$ and $n=11.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & ={\\theta }^{11}\\,{e}^{-8.8\\theta }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2f28c710-ad63-5f90-ab4c-dca1c9762afd"] :db/ensure [:question/validate]} {:db/id "answer-field-2f28c710-ad63-5f90-ab4c-dca1c9762afd" :answer-field/id #uuid "2f28c710-ad63-5f90-ab4c-dca1c9762afd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f431101-4c6d-5bf2-ba99-85b859abf503" :answer-field/choices ["answer-7d59090d-226b-567f-b107-8cc219edf98e" "answer-cb96d045-9d55-5deb-9924-204c6531a1bb" "answer-4f431101-4c6d-5bf2-ba99-85b859abf503" "answer-7f080b35-a5ae-5e2b-bd64-31274fadcc37" "answer-534b0bea-259c-590f-b217-8d6213f5b072"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d59090d-226b-567f-b107-8cc219edf98e" :answer/id #uuid "7d59090d-226b-567f-b107-8cc219edf98e" :answer/type :answer.type/math :answer/value "{\\theta }^{-11}\\,{e}^{8.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-cb96d045-9d55-5deb-9924-204c6531a1bb" :answer/id #uuid "cb96d045-9d55-5deb-9924-204c6531a1bb" :answer/type :answer.type/math :answer/value "{\\theta }^{-8.8}\\,{e}^{11\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-4f431101-4c6d-5bf2-ba99-85b859abf503" :answer/id #uuid "4f431101-4c6d-5bf2-ba99-85b859abf503" :answer/type :answer.type/math :answer/value "{\\theta }^{11}\\,{e}^{-8.8\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-7f080b35-a5ae-5e2b-bd64-31274fadcc37" :answer/id #uuid "7f080b35-a5ae-5e2b-bd64-31274fadcc37" :answer/type :answer.type/math :answer/value "{\\theta }^{11}\\,{e}^{-\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-534b0bea-259c-590f-b217-8d6213f5b072" :answer/id #uuid "534b0bea-259c-590f-b217-8d6213f5b072" :answer/type :answer.type/math :answer/value "{\\theta }^{8.8}\\,{e}^{-11\\theta }" :db/ensure [:answer/validate]} {:db/id 17592186192799 :knowledge-point/questions ["question-67f027bd-5627-5870-ad62-8c955e4cf931"] :db/ensure [:knowledge-point/validate]} {:db/id "question-67f027bd-5627-5870-ad62-8c955e4cf931" :question/id #uuid "67f027bd-5627-5870-ad62-8c955e4cf931" :question/math-academy-id "q-159919" :question/problem "Let ${X}_{1},{X}_{2},{X}_{3}$ be I.I.D. random variables with probability density function\n\n$$\nf(x;\\theta )=\\theta {x}^{-\\theta -1},\\,x\\ge 1,\n$$\n\nwhere $\\theta $ is an unknown parameter. Find the likelihood function of the sample $4.1,\\,2.5,\\,2.8.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=3$ independent random variables with unknown parameter $\\theta ,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\theta {x}^{-\\theta -1},\\,x\\ge 1.\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\theta {x}_{i}^{-\\theta -1}) \\\\  & ={\\theta }^{n}\\cdot {\\prod }_{i=1}^{n}{x}_{i}^{-\\theta -1} \\\\  & ={\\theta }^{n}({\\prod }_{i=1}^{n}{x}_{i})^{-\\theta -1}\\end{aligned}\n$$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i} & =4.1\\cdot 2.5\\cdot 2.8=28.7\\end{aligned}\n$$\n\nand $n=3.$ Therefore, \n\n$$\nL(\\theta )={\\theta }^{3}(28.7)^{-\\theta -1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a0a24af9-2c20-5bcb-882d-da71398e4661"] :db/ensure [:question/validate]} {:db/id "answer-field-a0a24af9-2c20-5bcb-882d-da71398e4661" :answer-field/id #uuid "a0a24af9-2c20-5bcb-882d-da71398e4661" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-13a5d853-1f1e-50a0-8e00-2fa1064e40e5" :answer-field/choices ["answer-eba3b892-df42-5754-afb3-26d55a0f358f" "answer-b2a34928-e7d0-5f70-87a4-51288f7f7d34" "answer-def5dc94-633d-576b-941d-07e8b9c94d61" "answer-13a5d853-1f1e-50a0-8e00-2fa1064e40e5" "answer-2146d1c2-145c-5e19-be13-24bf25afba4b"] :db/ensure [:answer-field/validate]} {:db/id "answer-eba3b892-df42-5754-afb3-26d55a0f358f" :answer/id #uuid "eba3b892-df42-5754-afb3-26d55a0f358f" :answer/type :answer.type/math :answer/value "\\theta (28.7)^{-\\theta -1}" :db/ensure [:answer/validate]} {:db/id "answer-b2a34928-e7d0-5f70-87a4-51288f7f7d34" :answer/id #uuid "b2a34928-e7d0-5f70-87a4-51288f7f7d34" :answer/type :answer.type/math :answer/value "{\\theta }^{28.7}(3)^{-\\theta -1}" :db/ensure [:answer/validate]} {:db/id "answer-def5dc94-633d-576b-941d-07e8b9c94d61" :answer/id #uuid "def5dc94-633d-576b-941d-07e8b9c94d61" :answer/type :answer.type/math :answer/value "{\\theta }^{2}(28.7)^{-\\theta }" :db/ensure [:answer/validate]} {:db/id "answer-13a5d853-1f1e-50a0-8e00-2fa1064e40e5" :answer/id #uuid "13a5d853-1f1e-50a0-8e00-2fa1064e40e5" :answer/type :answer.type/math :answer/value "{\\theta }^{3}(28.7)^{-\\theta -1}" :db/ensure [:answer/validate]} {:db/id "answer-2146d1c2-145c-5e19-be13-24bf25afba4b" :answer/id #uuid "2146d1c2-145c-5e19-be13-24bf25afba4b" :answer/type :answer.type/math :answer/value "{\\theta }^{4}(28.7)^{-\\theta }" :db/ensure [:answer/validate]} {:db/id 17592186192684 :knowledge-point/questions ["question-3a232b81-c933-5282-aa6a-6ac51618b1b6" "question-67f89f72-de60-5983-9ba7-f68316fa9c35"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3a232b81-c933-5282-aa6a-6ac51618b1b6" :question/id #uuid "3a232b81-c933-5282-aa6a-6ac51618b1b6" :question/math-academy-id "q-159951" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,1),$  where $\\theta $ is an unknown mean. For a particular sample ${x}_{1},{x}_{2},{x}_{3},{x}_{4},$ you're given that \n\n$$\n{\\sum }_{i=1}^{4}{x}_{i}=8.98,\\,{\\sum }_{i=1}^{4}{x}_{i}^{2}=29.4.\n$$\n\nGiven that the likelihood function of the sample is\n\n$$\nL(\\theta )=\\frac{1}{4{\\pi }^{2}}\\,{e}^{\\,g(\\theta )},\n$$\n\nwhat is the expression for $g(\\theta )?$\n\n*Hint: The probability density function for a normal random variable with mean $\\theta $ and variance $1$ is given by* \n\n$$\nf(x;\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=4$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\frac{1}{\\sqrt{2\\pi }}{e}^{-({x}_{i}-\\theta )^{2}/2}) \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-\\sum ({x}_{i}-\\theta )^{2}/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(\\sum {x}_{i}^{2}-2\\theta \\sum {x}_{i}+n{\\theta }^{2})/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(C-2S\\theta +n{\\theta }^{2})/2}\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}$ and $C={\\sum }_{i=1}^{n}{x}_{i}^{2}.$\n\nWe are told that $S={\\sum }_{i=1}^{n}{x}_{i}=8.98,$ $C={\\sum }_{i=1}^{n}{x}_{i}^{2}=29.4,$ and $n=4.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & =(2\\pi )^{-4/2}\\,{e}^{-(29.4-2(8.98)\\theta +4{\\theta }^{2})/2} \\\\  & =\\frac{1}{4{\\pi }^{2}}\\,{e}^{\\,-14.7\\,+\\,8.98\\theta \\,-\\,2{\\theta }^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(\\theta )=-14.7+8.98\\theta -2{\\theta }^{2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e9645430-c3dd-5a0d-a5c2-2b90bb8a3076"] :db/ensure [:question/validate]} {:db/id "answer-field-e9645430-c3dd-5a0d-a5c2-2b90bb8a3076" :answer-field/id #uuid "e9645430-c3dd-5a0d-a5c2-2b90bb8a3076" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0783fcb-15c0-52e8-a012-1b2d6692109d" :answer-field/choices ["answer-f0783fcb-15c0-52e8-a012-1b2d6692109d" "answer-36bfab97-2213-5db0-bc57-64be646f86f8" "answer-2ee6b5b6-79d8-5f3b-a3b5-ea4295831ec4" "answer-faf6b123-23f4-5859-a6a3-7c67537a6a69" "answer-f801fc62-3fdd-5360-808c-c7be45810737"] :db/ensure [:answer-field/validate]} {:db/id "answer-f0783fcb-15c0-52e8-a012-1b2d6692109d" :answer/id #uuid "f0783fcb-15c0-52e8-a012-1b2d6692109d" :answer/type :answer.type/math :answer/value "-14.7+8.98\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-36bfab97-2213-5db0-bc57-64be646f86f8" :answer/id #uuid "36bfab97-2213-5db0-bc57-64be646f86f8" :answer/type :answer.type/math :answer/value "-29.4+4.49\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-2ee6b5b6-79d8-5f3b-a3b5-ea4295831ec4" :answer/id #uuid "2ee6b5b6-79d8-5f3b-a3b5-ea4295831ec4" :answer/type :answer.type/math :answer/value "-29.4+8.98\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-faf6b123-23f4-5859-a6a3-7c67537a6a69" :answer/id #uuid "faf6b123-23f4-5859-a6a3-7c67537a6a69" :answer/type :answer.type/math :answer/value "-4.49+29.4\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f801fc62-3fdd-5360-808c-c7be45810737" :answer/id #uuid "f801fc62-3fdd-5360-808c-c7be45810737" :answer/type :answer.type/math :answer/value "-8.98+14.7\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "question-67f89f72-de60-5983-9ba7-f68316fa9c35" :question/id #uuid "67f89f72-de60-5983-9ba7-f68316fa9c35" :question/math-academy-id "q-159972" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,1),$  where $\\theta $ is an unknown mean.  Given that the likelihood function of the sample $0.3,\\,1.2,\\,-2.6,\\,0.4$ is\n\n$$\nL(\\theta )=\\frac{1}{4{\\pi }^{2}}\\,{e}^{\\,g(\\theta )},\n$$\n\nwhat is the expression for $g(\\theta )?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=4$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\frac{1}{\\sqrt{2\\pi }}{e}^{-({x}_{i}-\\theta )^{2}/2}) \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-\\sum ({x}_{i}-\\theta )^{2}/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(\\sum {x}_{i}^{2}-2\\theta \\sum {x}_{i}+n{\\theta }^{2})/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(C-2S\\theta +n{\\theta }^{2})/2}\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}$ and $C={\\sum }_{i=1}^{n}{x}_{i}^{2}.$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =0.3+1.2+(-2.6)+0.4 \\\\  & =-0.7 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(0.3)^{2}+(1.2)^{2}+(-2.6)^{2}+(0.4)^{2} \\\\  & =8.45\\end{aligned}\n$$\n\nand $n=4.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & =(2\\pi )^{-4/2}\\,{e}^{-(8.45-2(-0.7)\\theta +4{\\theta }^{2})/2} \\\\  & =\\frac{1}{4{\\pi }^{2}}\\,{e}^{\\,-4.225\\,-\\,0.7\\theta \\,-\\,2{\\theta }^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(\\theta )=-4.225-0.7\\theta -2{\\theta }^{2}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5f8fd110-202a-5667-bf26-f7d318d06cc6"] :db/ensure [:question/validate]} {:db/id "answer-field-5f8fd110-202a-5667-bf26-f7d318d06cc6" :answer-field/id #uuid "5f8fd110-202a-5667-bf26-f7d318d06cc6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-811cdd6d-776a-59e7-8f58-71af09a1c53a" :answer-field/choices ["answer-09c1d491-402e-555e-a666-7f7c4e87d6ba" "answer-811cdd6d-776a-59e7-8f58-71af09a1c53a" "answer-ff1fb752-a169-5228-a97e-05992483d175" "answer-8f42f131-75fe-5641-ab8b-d247827641d2" "answer-78a7b057-e13c-59a5-9c17-b9e7479f7400"] :db/ensure [:answer-field/validate]} {:db/id "answer-09c1d491-402e-555e-a666-7f7c4e87d6ba" :answer/id #uuid "09c1d491-402e-555e-a666-7f7c4e87d6ba" :answer/type :answer.type/math :answer/value "-4.225-0.35\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-811cdd6d-776a-59e7-8f58-71af09a1c53a" :answer/id #uuid "811cdd6d-776a-59e7-8f58-71af09a1c53a" :answer/type :answer.type/math :answer/value "-4.225-0.7\\theta -2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-ff1fb752-a169-5228-a97e-05992483d175" :answer/id #uuid "ff1fb752-a169-5228-a97e-05992483d175" :answer/type :answer.type/math :answer/value "-8.45-0.7\\theta -4{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-8f42f131-75fe-5641-ab8b-d247827641d2" :answer/id #uuid "8f42f131-75fe-5641-ab8b-d247827641d2" :answer/type :answer.type/math :answer/value "4.225+0.35\\theta +2{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "answer-78a7b057-e13c-59a5-9c17-b9e7479f7400" :answer/id #uuid "78a7b057-e13c-59a5-9c17-b9e7479f7400" :answer/type :answer.type/math :answer/value "8.45+0.7\\theta +4{\\theta }^{2}" :db/ensure [:answer/validate]} {:db/id "activity-7eb5815e-ec1b-5309-9ada-af8c6f2e1f20" :activity/id #uuid "7eb5815e-ec1b-5309-9ada-af8c6f2e1f20" :activity/title "Likelihood Functions for Continuous Probability Distributions" :activity/type :activity.type/review :activity/scope 17592186049217 :activity/course 17592186046658 :activity/steps ["step-123ec72f-798d-521a-b71f-a350724a6d80" "step-758ec95c-458e-58ad-b910-88dba5d83555" "step-581d75e5-f869-52ac-9527-20195bb5d14d" "step-ae0bb4af-619e-5c31-bd50-96b13e3c5a74" "step-9adaeb98-58da-5087-9e4e-fb6fed2b0b66"] :activity/first-step "step-123ec72f-798d-521a-b71f-a350724a6d80" :db/ensure [:activity/validate]} {:db/id "step-123ec72f-798d-521a-b71f-a350724a6d80" :step/id #uuid "123ec72f-798d-521a-b71f-a350724a6d80" :step/content "question-4a460e59-a60e-5c01-b0d6-ac09a000a8e4" :step/