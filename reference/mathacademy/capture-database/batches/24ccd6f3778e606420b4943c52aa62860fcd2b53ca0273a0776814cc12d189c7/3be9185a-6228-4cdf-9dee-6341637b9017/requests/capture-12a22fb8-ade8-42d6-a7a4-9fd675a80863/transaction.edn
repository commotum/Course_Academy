\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n-\\frac{3}{2}x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186316710 :answer-field/correct 17592186315392 :db/ensure [:answer-field/validate]} {:db/id 17592186316623 :answer-field/correct 17592186316209 :db/ensure [:answer-field/validate]} {:db/id 17592186317374 :question/problem "Let $f(x)$ be the $6$-periodic extension of the function $F(x)=6{x}^{2}-2$ defined on $[-3,3).$ Select the correct options in the reasoning below, showing the derivation of the Fourier series of the $6$-periodic extension of $G(x)=12x$ from the corresponding Fourier series of $f(x).$\n\nThe Fourier series of $f(x)$ is given by\n\n$$\n6{x}^{2}-2∼16+{\\sum }_{n=1}^{\\infty }\\frac{216(-1)^{n}}{{n}^{2}{\\pi }^{2}}{{field-1}}.\n$$\n\nSince $f$ is \n{{field-2}}\nand\n{{field-3}}\non $R,$ we may differentiate its Fourier series term-by-term to get\n\n$$\n12x∼{\\sum }_{n=1}^{\\infty }{{field-4}}\\cdot {{field-5}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186317091 :answer-field/correct 17592186315731 :db/ensure [:answer-field/validate]} {:db/id 17592186316890 :answer-field/correct 17592186316390 :db/ensure [:answer-field/validate]} {:db/id "activity-aec5d3d7-4920-56c6-9fdc-9595e4ce8b2e" :activity/id #uuid "aec5d3d7-4920-56c6-9fdc-9595e4ce8b2e" :activity/title "Differentiating and Integrating Fourier Series" :activity/type :activity.type/review :activity/scope 17592186050010 :activity/course 17592186046644 :activity/steps ["step-352caae4-676a-57d5-bd9d-c7587793e13c" "step-410fa0b4-3fcf-58af-9022-5120be85b47f" "step-f22acf91-843d-568d-9445-425b3e5be0ac"] :activity/first-step "step-352caae4-676a-57d5-bd9d-c7587793e13c" :db/ensure [:activity/validate]} {:db/id "step-352caae4-676a-57d5-bd9d-c7587793e13c" :step/id #uuid "352caae4-676a-57d5-bd9d-c7587793e13c" :step/content "question-1d451e41-c662-5263-b3f7-8483ecaa8976" :step/next "step-410fa0b4-3fcf-58af-9022-5120be85b47f" :db/ensure [:step/validate]} {:db/id "step-410fa0b4-3fcf-58af-9022-5120be85b47f" :step/id #uuid "410fa0b4-3fcf-58af-9022-5120be85b47f" :step/content 17592186317373 :step/next "step-f22acf91-843d-568d-9445-425b3e5be0ac" :db/ensure [:step/validate]} {:db/id "step-f22acf91-843d-568d-9445-425b3e5be0ac" :step/id #uuid "f22acf91-843d-568d-9445-425b3e5be0ac" :step/content 17592186317374 :db/ensure [:step/validate]} {:db/id 17592186054807 :knowledge-point/questions ["question-7a1c9a9e-192b-564f-9f04-0763b9d472b4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7a1c9a9e-192b-564f-9f04-0763b9d472b4" :question/id #uuid "7a1c9a9e-192b-564f-9f04-0763b9d472b4" :question/math-academy-id "q-5747" :question/problem "![](images/6e/6e4cf483b68db33f213470f247ee118cad452c269e8420431730f457f5b5ca89.png)\n\nWhat are the $xy$-coordinates of the point shown in the axes above?" :question/worked-solution "To find the coordinates of the point, we inspect its position along the $x$ and $y$ axes.\n\nThe point is $4$ units to the *left* of the origin, in the *negative* direction of the $x$-axis. So, the point has an $x$-coordinate of $-4.$\n\nAdditionally, the point is $8$ units *below* the origin, in the *negative* direction of the $y$-axis. So, the point has a $y$-coordinate of $-8.$\n\nThe point has an $x$-coordinate of $-4$ and a $y$-coordinate of $-8,$ so its coordinates are $(-4,-8).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-939cc08d-b6c1-54a1-985c-4e6d4655de28"] :db/ensure [:question/validate]} {:db/id "answer-field-939cc08d-b6c1-54a1-985c-4e6d4655de28" :answer-field/id #uuid "939cc08d-b6c1-54a1-985c-4e6d4655de28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d0dde1b-0500-59ae-ae3d-9eb21c7ed9ad" :answer-field/choices ["answer-2d0dde1b-0500-59ae-ae3d-9eb21c7ed9ad" "answer-4df4275b-dc8c-5a91-a8ee-855c4c10d909" "answer-df7f503d-839e-5332-93e5-ab30280946fe" "answer-88ee5f6c-389b-50c5-868c-45ab4a3fd084" "answer-75847f36-bc92-5923-a944-aaaabe892afb"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d0dde1b-0500-59ae-ae3d-9eb21c7ed9ad" :answer/id #uuid "2d0dde1b-0500-59ae-ae3d-9eb21c7ed9ad" :answer/type :answer.type/math :answer/value "(-4,-8)" :db/ensure [:answer/validate]} {:db/id "answer-4df4275b-dc8c-5a91-a8ee-855c4c10d909" :answer/id #uuid "4df4275b-dc8c-5a91-a8ee-855c4c10d909" :answer/type :answer.type/math :answer/value "(-8,-4)" :db/ensure [:answer/validate]} {:db/id "answer-df7f503d-839e-5332-93e5-ab30280946fe" :answer/id #uuid "df7f503d-839e-5332-93e5-ab30280946fe" :answer/type :answer.type/math :answer/value "(-8,4)" :db/ensure [:answer/validate]} {:db/id "answer-88ee5f6c-389b-50c5-868c-45ab4a3fd084" :answer/id #uuid "88ee5f6c-389b-50c5-868c-45ab4a3fd084" :answer/type :answer.type/math :answer/value "(4,-8)" :db/ensure [:answer/validate]} {:db/id "answer-75847f36-bc92-5923-a944-aaaabe892afb" :answer/id #uuid "75847f36-bc92-5923-a944-aaaabe892afb" :answer/type :answer.type/math :answer/value "(8,4)" :db/ensure [:answer/validate]} {:db/id 17592186073686 :knowledge-point/questions ["question-b577ef62-3bc6-5dd8-a240-3b3950135891"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b577ef62-3bc6-5dd8-a240-3b3950135891" :question/id #uuid "b577ef62-3bc6-5dd8-a240-3b3950135891" :question/math-academy-id "q-91969" :question/problem "![](images/c7/c7e2d2b4be3fbfe1cb0944dec21c0779fc197d1282eef5a56e806f9ce56a4962.png)\n\nWhat picture is missing from the multiplication model above?" :question/worked-solution "In the model, we have $\\frac{2}{5}$ on the left.\n\nSince we need to multiply by $\\frac{1}{3}$, we split the whole into $3$ equal parts horizontally.\n\n![](images/4e/4e6aa019748eccb9faeb9cb87632e4545d74f4960bdfab3b7a50aa4065069c48.png)\n\nFrom the picture on the right, we obtain that the shaded part represents $\\frac{2}{15}$ of the whole.\n\nThe missing picture is:\n\n![](images/32/32e9dd52864c9183df7b617cb60152e57d8b2635ea46e639d82d029288faa269.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ee5fb33-119f-57fb-80f8-4484325ed734"] :db/ensure [:question/validate]} {:db/id "answer-field-1ee5fb33-119f-57fb-80f8-4484325ed734" :answer-field/id #uuid "1ee5fb33-119f-57fb-80f8-4484325ed734" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cb68c700-d919-5d8c-a997-8c8007d6801b" :answer-field/choices ["answer-8419e766-8f52-55d6-a218-5e669e1bd46f" "answer-7edc2d03-1155-5ea0-b594-3f34638f7738" "answer-cb68c700-d919-5d8c-a997-8c8007d6801b" "answer-fb0d91b2-ad9d-5143-aa14-8c9b89b807d5" "answer-1714b17f-fc95-5755-854b-7d94cf28dba0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8419e766-8f52-55d6-a218-5e669e1bd46f" :answer/id #uuid "8419e766-8f52-55d6-a218-5e669e1bd46f" :answer/type :answer.type/image :answer/value "images/1f/1f93d346ca47a2bc1a877616d5e92bea56296cdbdaf7e9ad328506f2bce209f5.png" :db/ensure [:answer/validate]} {:db/id "answer-7edc2d03-1155-5ea0-b594-3f34638f7738" :answer/id #uuid "7edc2d03-1155-5ea0-b594-3f34638f7738" :answer/type :answer.type/image :answer/value "images/27/277ef36d7539145f143bed86e32f13001a07b8742dcac596a196dbbd41461083.png" :db/ensure [:answer/validate]} {:db/id "answer-cb68c700-d919-5d8c-a997-8c8007d6801b" :answer/id #uuid "cb68c700-d919-5d8c-a997-8c8007d6801b" :answer/type :answer.type/image :answer/value "images/32/32e9dd52864c9183df7b617cb60152e57d8b2635ea46e639d82d029288faa269.png" :db/ensure [:answer/validate]} {:db/id "answer-fb0d91b2-ad9d-5143-aa14-8c9b89b807d5" :answer/id #uuid "fb0d91b2-ad9d-5143-aa14-8c9b89b807d5" :answer/type :answer.type/image :answer/value "images/47/47dc58b56980429deadfd19b118a599a9c7cd0f9786e3c8e40b0bde8a145e201.png" :db/ensure [:answer/validate]} {:db/id "answer-1714b17f-fc95-5755-854b-7d94cf28dba0" :answer/id #uuid "1714b17f-fc95-5755-854b-7d94cf28dba0" :answer/type :answer.type/image :answer/value "images/de/dee27c000367a675db40ba8ff065ed3db28f957658ef06bf75d3d304a0563ed8.png" :db/ensure [:answer/validate]} {:db/id 17592186073722 :knowledge-point/questions ["question-cf8a9fa4-0c6b-5d86-8b4f-17e214ee6603" "question-a2e8b668-df51-5edf-a673-01b58575b2f0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cf8a9fa4-0c6b-5d86-8b4f-17e214ee6603" :question/id #uuid "cf8a9fa4-0c6b-5d86-8b4f-17e214ee6603" :question/math-academy-id "q-59838" :question/problem "![](images/23/23196761364659fb01eb42ffd37c898331a654bf52e3ec1ebe79316f986a6d7e.png)\n\nEach of the two shapes in the model above represents one whole. From left to right, what numbers are missing from the division problem below?\n\n$$\n\\boxed{\\,\\,}÷\\frac{1}{3}=\\boxed{\\,\\,}\n$$" :question/worked-solution "In the model, there are $2$ shapes. Each shape consists of $3$ pieces that each represent $\\frac{1}{3}$ of a whole. There are $6$ pieces in total.\n\nThe model tells us that when we divide $2$ wholes into thirds, we will be left with $6$ pieces.\n\nHence, the division problem is:\n\n$$\n\\boxed{\\,2\\,}÷\\frac{1}{3}=\\boxed{\\,6\\,}\n$$\n\nTherefore, the missing numbers are $2$ and $6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-375aea6f-f5c8-5740-8c1d-0b529d16360a"] :db/ensure [:question/validate]} {:db/id "answer-field-375aea6f-f5c8-5740-8c1d-0b529d16360a" :answer-field/id #uuid "375aea6f-f5c8-5740-8c1d-0b529d16360a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8195fd74-5e17-5be8-b759-2050b74a8f66" :answer-field/choices ["answer-f9966e5f-fbc1-5b55-a295-1a20de673201" "answer-8195fd74-5e17-5be8-b759-2050b74a8f66" "answer-1bc42286-a83d-5b57-a46a-fe1281e95763" "answer-66d9767a-62ae-5f17-9185-c0baa86c13f6" "answer-0066f6b9-1f10-53cc-86f7-a00a8a9eff8f"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9966e5f-fbc1-5b55-a295-1a20de673