95e" "answer-2701a568-7b51-5ee3-bdfe-cf300d253cdd" "answer-440961ef-7018-5985-aa9f-2b72b868ad3d" "answer-efc7e933-0aaa-5e03-b174-d2fedd705768" "answer-d7efecac-de95-5f99-84b2-c5509aa3264e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b004acfc-1115-58e9-8ed3-d963f269395e" :answer/id #uuid "b004acfc-1115-58e9-8ed3-d963f269395e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-2701a568-7b51-5ee3-bdfe-cf300d253cdd" :answer/id #uuid "2701a568-7b51-5ee3-bdfe-cf300d253cdd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-440961ef-7018-5985-aa9f-2b72b868ad3d" :answer/id #uuid "440961ef-7018-5985-aa9f-2b72b868ad3d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-efc7e933-0aaa-5e03-b174-d2fedd705768" :answer/id #uuid "efc7e933-0aaa-5e03-b174-d2fedd705768" :answer/type :answer.type/math :answer/value "\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "answer-d7efecac-de95-5f99-84b2-c5509aa3264e" :answer/id #uuid "d7efecac-de95-5f99-84b2-c5509aa3264e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id 17592186142775 :knowledge-point/questions ["question-482bced9-3212-5918-a8c9-a1d576cd678a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-482bced9-3212-5918-a8c9-a1d576cd678a" :question/id #uuid "482bced9-3212-5918-a8c9-a1d576cd678a" :question/math-academy-id "q-70169" :question/problem "$\\frac{5}{12}\\times 8=$" :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{5\\times 8}{12}=\\frac{40}{12}\n$$\n\nWe then simplify:\n\n$$\n\\frac{40}{12}=\\frac{40÷4}{12÷4}=\\frac{10}{3}\n$$\n\nFinally, we then convert $\\frac{10}{3}$ to a mixed number:\n\n$$\n10÷3=3\\,\\text{R}1=3\\,\\frac{1}{3}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4bfc692b-2350-57db-b02c-fe993e24627e"] :db/ensure [:question/validate]} {:db/id "answer-field-4bfc692b-2350-57db-b02c-fe993e24627e" :answer-field/id #uuid "4bfc692b-2350-57db-b02c-fe993e24627e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d68b516-9901-561b-9284-284a39ac9db3" :answer-field/choices ["answer-d59076de-8e00-5557-b8ef-6aad547d73e4" "answer-4d68b516-9901-561b-9284-284a39ac9db3" "answer-598b4d6b-45a5-5d71-bce7-4f8b0f8e22a7" "answer-4fcaa2b8-b53e-57c5-bb30-a9e4289aa081" "answer-728aa58f-57cb-5136-9754-148669dae9b7"] :db/ensure [:answer-field/validate]} {:db/id "answer-d59076de-8e00-5557-b8ef-6aad547d73e4" :answer/id #uuid "d59076de-8e00-5557-b8ef-6aad547d73e4" :answer/type :answer.type/math :answer/value "2\\,\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4d68b516-9901-561b-9284-284a39ac9db3" :answer/id #uuid "4d68b516-9901-561b-9284-284a39ac9db3" :answer/type :answer.type/math :answer/value "3\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-598b4d6b-45a5-5d71-bce7-4f8b0f8e22a7" :answer/id #uuid "598b4d6b-45a5-5d71-bce7-4f8b0f8e22a7" :answer/type :answer.type/math :answer/value "3\\,\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4fcaa2b8-b53e-57c5-bb30-a9e4289aa081" :answer/id #uuid "4fcaa2b8-b53e-57c5-bb30-a9e4289aa081" :answer/type :answer.type/math :answer/value "4\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-728aa58f-57cb-5136-9754-148669dae9b7" :answer/id #uuid "728aa58f-57cb-5136-9754-148669dae9b7" :answer/type :answer.type/math :answer/value "4\\,\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id 17592186142774 :knowledge-point/questions ["question-ed7855b2-e0c4-5d43-a793-86601ef49531"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ed7855b2-e0c4-5d43-a793-86601ef49531" :question/id #uuid "ed7855b2-e0c4-5d43-a793-86601ef49531" :question/math-academy-id "q-172835" :question/problem "Expressed as a fraction in its lowest terms, $\\frac{2}{9}\\times 3=${{field-1}}." :question/worked-solution "To multiply a fraction by a whole number, we multiply the fraction's numerator by the whole number and keep the denominator the same:\n\n$$\n\\frac{2\\times 3}{9}=\\frac{6}{9}\n$$\n\nWe then reduce this fraction to its lowest terms:\n\n$$\n\\frac{6}{9}=\\frac{6÷3}{9÷3}=\\frac{2}{3}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-99f9767b-d358-50e5-b8c1-d0f2290a8e76"] :db/ensure [:question/validate]} {:db/id "answer-field-99f9767b-d358-50e5-b8c1-d0f2290a8e76" :answer-field/id #uuid "99f9767b-d358-50e5-b8c1-d0f2290a8e76" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-55cee1b2-fc14-5406-a50c-ee1bef2c1a97" :answer-field/choices ["answer-55cee1b2-fc14-5406-a50c-ee1bef2c1a97"] :db/ensure [:answer-field/validate]} {:db/id "answer-55cee1b2-fc14-5406-a50c-ee1bef2c1a97" :answer/id #uuid "55cee1b2-fc14-5406-a50c-ee1bef2c1a97" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "activity-34478af7-016b-50ef-8d17-1e3de9d584b8" :activity/id #uuid "34478af7-016b-50ef-8d17-1e3de9d584b8" :activity/title "Multiplying Fractions by Whole Numbers" :activity/type :activity.type/review :activity/scope 17592186050599 :activity/course 17592186046648 :activity/steps ["step-32fe809e-be15-5879-9ca6-f696ed248dbe" "step-ce2e5790-1b2c-55cb-9978-7f2ea8c71e01" "step-2b15e500-4d9d-5d95-8183-8b0548be87ce"] :activity/first-step "step-32fe809e-be15-5879-9ca6-f696ed248dbe" :db/ensure [:activity/validate]} {:db/id "step-32fe809e-be15-5879-9ca6-f696ed248dbe" :step/id #uuid "32fe809e-be15-5879-9ca6-f696ed248dbe" :step/content "question-3ef9ce40-b102-5a3a-80df-f4d65ee91715" :step/next "step-ce2e5790-1b2c-55cb-9978-7f2ea8c71e01" :db/ensure [:step/validate]} {:db/id "step-ce2e5790-1b2c-55cb-9978-7f2ea8c71e01" :step/id #uuid "ce2e5790-1b2c-55cb-9978-7f2ea8c71e01" :step/content "question-482bced9-3212-5918-a8c9-a1d576cd678a" :step/next "step-2b15e500-4d9d-5d95-8183-8b0548be87ce" :db/ensure [:step/validate]} {:db/id "step-2b15e500-4d9d-5d95-8183-8b0548be87ce" :step/id #uuid "2b15e500-4d9d-5d95-8183-8b0548be87ce" :step/content "question-ed7855b2-e0c4-5d43-a793-86601ef49531" :db/ensure [:step/validate]} {:db/id 17592186192702 :knowledge-point/questions ["question-597bb006-761e-5b6e-a002-be65431d8129"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186193027 :question/problem "Let $f(x)$ be positive and strictly increasing for $x\\in [1,4],$ and differentiable for $x\\in (1,4).$ Suppose we approximate the area under the curve $y=g(x)=x\\cdot f(x)$ over the interval $[1,4]$ using a left Riemann sum. Given that $g(x)>0,$ which of the following statements must be true?\n\nI. ${f}^{′}(x)>0$\n\nII. ${g}^{′}(x)>0$\n\nIII. The Riemann sum underestimates the true area." :question/worked-solution "We're given that $g(x)=x\\cdot f(x)>0.$ Now, recall the following:\n\n- If $g(x)$ is strictly increasing, the left Riemann sum gives an *underestimate* of the area under the curve $y=g(x).$\n\n- If $g(x)$ is strictly decreasing, the left Riemann sum gives an *overestimate* of the area under the curve $y=g(x).$\n\nLet's now consider each statement in turn:\n\n- Statement I is true. Since $f(x)$ is strictly increasing, we have ${f}^{′}(x)>0.$\n\n- Statement II is true. Differentiating $g(x)=x\\cdot f(x),$ we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =(x)^{′}\\cdot f(x)+x\\cdot {f}^{′}(x) \\\\  & =f(x)+x\\cdot {f}^{′}(x).\\end{aligned}\n$$\n\nNow, since $f(x)$ is positive and strictly increasing over the interval $(1,4),$ we have \n\n$$\nx>0,\\,f(x)>0,\\,{f}^{′}(x)>0.\n$$\n\nHence, we obtain\n\n$$\n{g}^{′}(x)={{f(x)}_{⏟}}_{>0}+{{x}_{⏟}}_{>0}\\cdot {{{f}^{′}(x)}_{⏟}}_{>0}={{f(x)}_{⏟}}_{>0}+{{x\\cdot {f}^{′}(x)}_{⏟}}_{>0}>0.\n$$\n\n- Statement III is true. Since ${g}^{′}(x)>0,$ the function $g(x)$ is strictly increasing. Therefore, the left Riemann sum gives an *underestimate* of the area under the curve $y=x\\cdot f(x).$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186190048 :answer-field/correct 17592186190053 :db/ensure [:answer-field/validate]} {:db/id 17592186192712 :knowledge-point/questions ["question-95ecf8d2-2252-5516-85e1-ebd3d6544d2a" "question-3dca0c4b-ab3e-5cab-b892-e8bf877045ac"] :db/ensure [:knowledge-point/validate]} {:db/id "question-95ecf8d2-2252-5516-85e1-ebd3d6544d2a" :question/id #uuid "95ecf8d2-2252-5516-85e1-ebd3d6544d2a" :question/math-academy-id "q-149419" :question/problem "The table below gives the values of a positive, continuous function $f(x)$ over the closed interval $[0,15].$ \nUsing a right Riemann sum with $5$ equal subintervals, estimate the volume of the solid generated when the region bounded by the curve $y=f(x),$ the $x$-axis, and the vertical lines $x=0$ and $x=15$ is rotated $2\\pi $ radians about the $x$-axis.\n\n| $x$ | $0$ | $3$ | $6$ | $9$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $2$ | $\\sqrt{3}$ | $0$ | $2\\sqrt{2}$ | $1$ |\n\n*Hint: The volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=a$ and $x=b$ is rotated $2\\pi $ radians about the $x$-axis is given by*\n\n$$\nV=\\pi {\\int }_{a}^{b}[f(x)]^{2}\\,\\text{d}x.\n$$" :question/worked-solution "Using the hint, the volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=0$ and $x=15$ is rotated $2\\pi $ radians about the $x$-axis is given by\n\n$$\nV=\\pi {\\int }_{0}^{15}[f(x)]^{2}\\,\\text{d}x.\n$$\n\nLet $g(x)={(f(x))}^{2}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{15-0}{5}=3.\n$$\n\nWe can approximate the integral above using a *right* Riemann sum with $5$ equal subintervals and step size $Δx$ as follows:\n\n$$\n\\pi {\\int }_{0}^{15}g(x)\\,\\text{d}x≈\\pi \\cdot (g(3)+g(6)+g(9)+g(12)+g(15))\\cdot Δx\n$$\n\nWe set up a table with values of $g(x)$ at each point:\n\n| $x$ | $0$ | $3$ | $6$ | $9$ | $12$ | $15$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $3$ | $2$ | $\\sqrt{3}$ | $0$ | $2\\sqrt{2}$ | $1$ |\n| $g(x)={(f(x))}^{2}$ | $9$ | $4$ | $3$ | $0$ | $8$ | $1$ |\n\nFinally, we obtain the following approximation for our volume:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{0}^{15}g(x)\\,\\text{d}x \\\\  & ≈\\pi \\cdot (g(3)+g(6)+g(9)+g(12)+g(15))\\cdot Δx \\\\  & =\\pi \\cdot (4+3+0+8+1)\\cdot 3 \\\\  & =\\pi \\cdot 16\\cdot 3 \\\\  & =48\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6a53dba6-93aa-5232-bd89-2d7c6d8b683b"] :db/ensure [:question/validate]} {:db/id "answer-field-6a53dba6-93aa-5232-bd89-2d7c6d8b683b" :answer-field/id #uuid "6a53dba6-93aa-5232-bd89-2d7c6d8b683b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-14818b9f-c464-5b94-bee6-e801c16f016a" :answer-field/choices ["answer-55d254e1-55ef-55c0-a7d5-3dadc286794f" "answer-657b83be-229f-5a37-a103-a6cbf918ce96" "answer-fa4c20a8-cc6f-5131-826d-a35ace3db5e0" "answer-14818b9f-c464-5b94-bee6-e801c16f016a" "answer-4b983bb9-6a3a-5849-8009-b5191583e3f6"] :db/ensure [:answer-field/validate]} {:db/id "answer-55d254e1-55ef-55c0-a7d5-3dadc286794f" :answer/id #uuid "55d254e1-55ef-55c0-a7d5-3dadc286794f" :answer/type :answer.type/math :answer/value "24\\pi " :db/ensure [:answer/validate]} {:db/id "answer-657b83be-229f-5a37-a103-a6cbf918ce96" :answer/id #uuid "657b83be-229f-5a37-a103-a6cbf918ce96" :answer/type :answer.type/math :answer/value "32\\pi " :db/ensure [:answer/validate]} {:db/id "answer-fa4c20a8-cc6f-5131-826d-a35ace3db5e0" :answer/id #uuid "fa4c20a8-cc6f-5131-826d-a35ace3db5e0" :answer/type :answer.type/math :answer/value "36\\pi " :db/ensure [:answer/validate]} {:db/id "answer-14818b9f-c464-5b94-bee6-e801c16f016a" :answer/id #uuid "14818b9f-c464-5b94-bee6-e801c16f016a" :answer/type :answer.type/math :answer/value "48\\pi " :db/ensure [:answer/validate]} {:db/id "answer-4b983bb9-6a3a-5849-8009-b5191583e3f6" :answer/id #uuid "4b983bb9-6a3a-5849-8009-b5191583e3f6" :answer/type :answer.type/math :answer/value "64\\pi " :db/ensure [:answer/validate]} {:db/id "question-3dca0c4b-ab3e-5cab-b892-e8bf877045ac" :question/id #uuid "3dca0c4b-ab3e-5cab-b892-e8bf877045ac" :question/math-academy-id "q-149431" :question/problem "The table below gives the values of a positive, continuous function $f(x)$ over the closed interval $[1,11].$ \nUsing a left Riemann sum with $5$ equal subintervals, estimate the volume of the solid generated when the region bounded by the curve $y=f(x),$ the $x$-axis, and the vertical lines $x=1$ and $x=11$ is rotated $2\\pi $ radians about the $x$-axis.\n\n| $x$ | $1$ | $3$ | $5$ | $7$ | $9$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $\\sqrt{2}$ | $0$ | $1$ | $3$ | $2$ |\n\n*Hint: The volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=a$ and $x=b$ is rotated $2\\pi $ radians about the $x$-axis is given by*\n\n$$\nV=\\pi {\\int }_{a}^{b}[f(x)]^{2}\\,\\text{d}x.\n$$" :question/worked-solution "Using the hint, the volume of the solid generated when the region bounded by a curve $y=f(x),$ the $x$-axis, and the vertical lines $x=1$ and $x=11$ is rotated $2\\pi $ radians about the $x$-axis is given by\n\n$$\nV=\\pi {\\int }_{1}^{11}[f(x)]^{2}\\,\\text{d}x.\n$$\n\nLet $g(x)={(f(x))}^{2}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{11-1}{5}=2.\n$$\n\nWe can approximate the integral above using a *left* Riemann sum with $5$ equal subintervals and step size $Δx$ as follows:\n\n$$\n\\pi {\\int }_{1}^{11}g(x)\\,\\text{d}x≈\\pi \\cdot (g(1)+g(3)+g(5)+g(7)+g(9))\\cdot Δx\n$$\n\nWe set up a table with values of $g(x)$ at each point:\n\n| $x$ | $1$ | $3$ | $5$ | $7$ | $9$ | $11$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $\\sqrt{2}$ | $0$ | $1$ | $3$ | $2$ |\n| $g(x)={(f(x))}^{2}$ | $1$ | $2$ | $0$ | $1$ | $9$ | $4$ |\n\nFinally, we obtain the following approximation for our volume:\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{1}^{11}g(x)\\,\\text{d}x \\\\  & ≈\\pi \\cdot (g(1)+g(3)+g(5)+g(7)+g(9))\\cdot Δx \\\\  & =\\pi \\cdot (1+2+0+1+9)\\cdot 2 \\\\  & =\\pi \\cdot 13\\cdot 2 \\\\  & =26\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-33c03e2d-ce2c-5b64-ac1b-19f84d3a3eea"] :db/ensure [:question/validate]} {:db/id "answer-field-33c03e2d-ce2c-5b64-ac1b-19f84d3a3eea" :answer-field/id #uuid "33c03e2d-ce2c-5b64-ac1b-19f84d3a3eea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-47c3c1ea-fcc8-5769-88c3-88f5edad13d1" :answer-field/choices ["answer-dbc2a1ce-cc77-5a90-ac10-c6984f36162e" "answer-7b63efd9-e678-5ae5-857b-96e377f6cb45" "answer-47c3c1ea-fcc8-5769-88c3-88f5edad13d1" "answer-89ea1e4b-2079-5ebf-8dbe-75e0c65f0d9c" "answer-a41399a1-ef8a-537a-8f60-936cf9a829ac"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbc2a1ce-cc77-5a90-ac10-c6984f36162e" :answer/id #uuid "dbc2a1ce-cc77-5a90-ac10-c6984f36162e" :answer/type :answer.type/math :answer/value "13\\pi " :db/ensure [:answer/validate]} {:db/id "answer-7b63efd9-e678-5ae5-857b-96e377f6cb45" :answer/id #uuid "7b63efd9-e678-5ae5-857b-96e377f6cb45" :answer/type :answer.type/math :answer/value "16\\pi " :db/ensure [:answer/validate]} {:db/id "answer-47c3c1ea-fcc8-5769-88c3-88f5edad13d1" :answer/id #uuid "47c3c1ea-fcc8-5769-88c3-88f5edad13d1" :answer/type :answer.type/math :answer/value "26\\pi " :db/ensure [:answer/validate]} {:db/id "answer-89ea1e4b-2079-5ebf-8dbe-75e0c65f0d9c" :answer/id #uuid "89ea1e4b-2079-5ebf-8dbe-75e0c65f0d9c" :answer/type :answer.type/math :answer/value "29\\pi " :db/ensure [:answer/validate]} {:db/id "answer-a41399a1-ef8a-537a-8f60-936cf9a829ac" :answer/id #uuid "a41399a1-ef8a-537a-8f60-936cf9a829ac" :answer/type :answer.type/math :answer/value "9\\pi " :db/ensure [:answer/validate]} {:db/id 17592186192701 :knowledge-point/questions ["question-8b473789-e487-5a61-80e6-ac184764ee91"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8b473789-e487-5a61-80e6-ac184764ee91" :question/id #uuid "8b473789-e487-5a61-80e6-ac184764ee91" :question/math-academy-id "q-149458" :question/problem "The table below gives the values of a positive, continuous function $f(x)$ and its derivative ${f}^{′}(x)$ over the closed interval $[0,9].$\nUsing a left Riemann sum with $3$ equal subintervals, estimate the arc length of the curve $y=f(x)$ between $x=0$ and $x=9.$\n\n| $x$ | $0$ | $3$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- |\n| $f(x)$ | $1$ | $2$ | $7$ | $10$ |\n| ${f}^{′}(x)$ | $2\\sqrt{2}$ | $0$ | $4\\sqrt{3}$ | $\\sqrt{3}$ |\n\n*Hint: The arc length of a smooth curve $y=f(x)$ between $x=a$ and $x=b$ is given by*\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "Using the hint, we have that the arc length of a curve $y=f(x)$ between $x=0$ and $x=9$ is given by\n\n$$\nL={\\int }_{0}^{9}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nLet $g(x)=\\sqrt{1+[{f}^{′}(x)]^{2}}.$ The (regular) step size $Δx$ is given by \n\n$$\nΔx=\\frac{9-0}{3}=3.\n$$\n\nWe can approximate the integral above using a *left* Riemann sum with $3$ equal subintervals and step size $Δx$ as follows:\n\n$$\n{\\int }_{0}^{9}g(x)\\,\\text{d}x≈(g(0)+g(3)+g(6)\\cdot Δx\n$$\n\nNow, we set up a table with values of $g(x)$ at each point:\n\n| $x$ | $0$ | $3$ | $6$ | $9$ |\n| --- | --- | --- | --- | --- |\n| ${f}^{′}(x)$ | $2\\sqrt{2}$ | $0$ | $4\\sqrt{3}$ | $\\sqrt{3}$ |\n| $g(x)=\\sqrt{1+[{f}^{′}(x)]^{2}}$ | $3$ | $1$ | $7$ | $2$ |\n\nFinally, we obtain the following approximation for our arc length:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{9}g(x)\\,\\text{d}x \\\\  & ≈(g(0)+g(3)+g(6))\\cdot Δx \\\\  & =(3+1+7)\\cdot 3 \\\\  & =11\\cdot 3 \\\\  & =33\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-58e46613-c481-5ec5-9c32-4604b2d18598"] :db/ensure [:question/validate]} {:db/id "answer-field-58e46613-c481-5ec5-9c32-4604b2d18598" :answer-field/id #uuid "58e46613-c481-5ec5-9c32-4604b2d18598" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b03ae649-783b-5d86-bc42-cc709124145e" :answer-field/choices ["answer-0f63c264-1a0f-552a-b8ad-9620bc2188c1" "answer-2455d6e0-88be-53fd-885e-23c520269d1f" "answer-13fe11c3-e0ca-520e-8103-0b01e9b72896" "answer-6581ba71-13b3-56cf-9b15-c01f14e38113" "answer-b03ae649-783b-5d86-bc42-cc709124145e"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f63c264-1a0f-552a-b8ad-9620bc2188c1" :answer/id #uuid "0f63c264-1a0f-552a-b8ad-9620bc2188c1" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-2455d6e0-88be-53fd-885e-23c520269d1f" :answer/id #uuid "2455d6e0-88be-53fd-885e-23c520269d1f" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-13fe11c3-e0ca-520e-8103-0b01e9b72896" :answer/id #uuid "13fe11c3-e0ca-520e-8103-0b01e9b72896" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-6581ba71-13b3-56cf-9b15-c01f14e38113" :answer/id #uuid "6581ba71-13b3-56cf-9b15-c01f14e38113" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-b03ae649-783b-5d86-bc42-cc709124145e" :answer/id #uuid "b03ae649-783b-5d86-bc42-cc709124145e" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "question-597bb006-761e-5b6e-a002-be65431d8129" :question/id #uuid "597bb006-761e-5b6e-a002-be65431d8129" :question/math-academy-id "q-149505" :question/problem "Let $f(x)$ be negative and strictly increasing for $x\\in [0,1],$ and differentiable for $x\\in (0,1).$ Suppose we approximate the area under the curve $y=g(x)=({x}^{2}-2)\\cdot f(x)$ over the interval $[0,1]$ using a right Riemann sum. Given that $g(x)>0,$ which of the following statements must be true?\n\nI. ${f}^{′}(x)>0$\n\nII. ${g}^{′}(x)>0$\n\nIII. The Riemann sum underestimates the true area." :question/worked-solution "We're given that $g(x)=({x}^{2}-2)\\cdot f(x)>0.$ Now, recall the following:\n\n- If $g(x)$ is strictly increasing, the right Riemann sum gives an *overestimate* of the area under the curve $y=g(x).$\n\n- If $g(x)$ is strictly decreasing, the right Riemann sum gives an *underestimate* of the area under the curve $y=g(x).$\n\nLet's now consider each statement in turn:\n\n- Statement I is true. Since $f(x)$ is strictly increasing, we have ${f}^{′}(x)>0.$\n\n- Statement II is false. Differentiating $g(x)=({x}^{2}-2)\\cdot f(x),$ we get\n\n$$\n\\begin{aligned}{g}^{′}(x) & =({x}^{2}-2)^{′}\\cdot f(x)+({x}^{2}-2)\\cdot {f}^{′}(x) \\\\  & =2x\\cdot f(x)+({x}^{2}-2)\\cdot {f}^{′}(x).\\end{aligned}\n$$\n\nNow, since $f(x)$ is negative and strictly increasing over the interval $(0,1),$ we have \n\n$$\n2x>0,\\,f(x)<0,\\,{x}^{2}-2<0,\\,{f}^{′}(x)>0.\n$$\n\nHence, we obtain\n\n$$\n{g}^{′}(x)={{2x}_{⏟}}_{>0}\\cdot {{f(x)}_{⏟}}_{<0}+{{({x}^{2}-2)}_{⏟}}_{<0}\\cdot {{{f}^{′}(x)}_{⏟}}_{>0}={{2x\\cdot f(x)}_{⏟}}_{<0}+\\,{{{x}^{2}\\cdot {f}^{′}(x)}_{⏟}}_{<0}<0.\n$$\n\n- Statement III is true. Since ${g}^{′}(x)<0,$ the function $g(x)$ is strictly decreasing. Therefore, the right Riemann sum gives an *underestimate* of the area under the curve $y=({x}^{2}-2)\\cdot f(x).$\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bda027a4-fbea-5ab2-9b7c-09170115f2b8"] :db/ensure [:question/validate]} {:db/id "answer-field-bda027a4-fbea-5ab2-9b7c-09170115f2b8" :answer-field/id #uuid "bda027a4-fbea-5ab2-9b7c-09170115f2b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ff2cf17-07cf-5a9d-b5df-c3c58e89ffd3" :answer-field/choices ["answer-d0bd2120-8fb6-53d0-90aa-f72e30d237ae" "answer-9ff2cf17-07cf-5a9d-b5df-c3c58e89ffd3" "answer-cd101352-2412-5c2e-9e18-8982229905ae" "answer-190b0318-472c-530a-9953-285c1d80e520" "answer-e99d7e0b-5dd6-505c-adc8-246fea845a95"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0bd2120-8fb6-53d0-90aa-f72e30d237ae" :answer/id #uuid "d0bd2120-8fb6-53d0-90aa-f72e30d237ae" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-9ff2cf17-07cf-5a9d-b5df-c3c58e89ffd3" :answer/id #uuid "9ff2cf17-07cf-5a9d-b5df-c3c58e89ffd3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-cd101352-2412-5c2e-9e18-8982229905ae" :answer/id #uuid "cd101352-2412-5c2e-9e18-8982229905ae" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-190b0318-472c-530a-9953-285c1d80e520" :answer/id #uuid "190b0318-472c-530a-9953-285c1d80e520" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-e99d7e0b-5dd6-505c-adc8-246fea845a95" :answer/id #uuid "e99d7e0b-5dd6-505c-adc8-246fea845a95" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-b6c8f1ee-bd3b-5b8f-a3ec-29aa9a0902db" :activity/id #uuid "b6c8f1ee-bd3b-5b8f-a3ec-29aa9a0902db" :activity/title "Approximating Areas Under Graphs of Composite Functions" :activity/type :activity.type/review :activity/scope 17592186048304 :activity/course 17592186046644 :activity/steps ["step-6c9c828f-44ee-5495-86d5-5bda67c8798d" "step-c0e73eb7-4739-5f4b-84a0-6fccb98ec129" "step-32d2ec1a-d6ed-5482-879e-744367b94dca" "step-e5bc175d-e11b-55ff-aaea-33f654704c94" "step-694eb003-d786-5734-a959-cc83c41aa69e"] :activity/first-step "step-6c9c828f-44ee-5495-86d5-5bda67c8798d" :db/ensu