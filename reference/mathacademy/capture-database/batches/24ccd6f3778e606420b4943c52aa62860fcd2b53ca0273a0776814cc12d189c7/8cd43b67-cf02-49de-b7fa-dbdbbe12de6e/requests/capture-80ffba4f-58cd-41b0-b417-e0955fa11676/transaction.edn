6bc310b7771" "answer-43c4138e-95e0-5f6a-96b8-c5fcde86c58e"] :db/ensure [:answer-field/validate]} {:db/id "answer-8c7dbd98-2001-5aba-97d8-c2bb25e4ec55" :answer/id #uuid "8c7dbd98-2001-5aba-97d8-c2bb25e4ec55" :answer/type :answer.type/image :answer/value "images/1f/1fd285fb62f69d6cfe7b102bfef1a7a14d0f9d0fc397e97134552b023b072530.png" :db/ensure [:answer/validate]} {:db/id "answer-9dbaf74d-fae0-5c6a-be62-337051e9f97a" :answer/id #uuid "9dbaf74d-fae0-5c6a-be62-337051e9f97a" :answer/type :answer.type/image :answer/value "images/23/2342e2d4d1445105c81d8c9fd83a013b3b0246c318beecbaf09289c330ee9c7a.png" :db/ensure [:answer/validate]} {:db/id "answer-b835b540-e895-585a-a2e9-7f241a5a1bc8" :answer/id #uuid "b835b540-e895-585a-a2e9-7f241a5a1bc8" :answer/type :answer.type/image :answer/value "images/bb/bbd1fe6b584e19012c39d64a18a2d50a42a83950707cddd340b93a8806672485.png" :db/ensure [:answer/validate]} {:db/id "answer-3a3080db-98e7-5f2d-99b6-f6bc310b7771" :answer/id #uuid "3a3080db-98e7-5f2d-99b6-f6bc310b7771" :answer/type :answer.type/image :answer/value "images/cf/cf9625763f6b1742bb021bd845d21ff82d1c2030e4cb6abe8d21180c47b48091.png" :db/ensure [:answer/validate]} {:db/id "answer-43c4138e-95e0-5f6a-96b8-c5fcde86c58e" :answer/id #uuid "43c4138e-95e0-5f6a-96b8-c5fcde86c58e" :answer/type :answer.type/image :answer/value "images/df/df524bffba573f1e8ca26c51ad0a34a676de5cbfed08b9055f8f67ce37d8297f.png" :db/ensure [:answer/validate]} {:db/id "question-29065405-ccc0-5f24-b571-a168ed04c45b" :question/id #uuid "29065405-ccc0-5f24-b571-a168ed04c45b" :question/math-academy-id "q-324300" :question/problem "Scores on a certain standardized exam are normally distributed with a mean of $75$ and a standard deviation of $8.$ What is the probability that a randomly selected student scores less than $68?$ **Round your answer to two decimal places.**\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- |\n| $\\,-0.9\\,$ | $\\,0.1660\\,$ | $\\,0.1635\\,$ | $\\,0.1611\\,$ |\n| $\\,-0.8\\,$ | $\\,0.1922\\,$ | $\\,0.1894\\,$ | $\\,0.1867\\,$ |\n| $\\,-0.7\\,$ | $\\,0.2206\\,$ | $\\,0.2177\\,$ | $\\,0.2148\\,$ |\n\nThe probability that a randomly selected student scores less than $68$ is approximately\n{{field-1}}." :question/worked-solution "Let $X$ represent the exam score. Then we have $X∼N(75,{8}^{2}).$\n\nWe want to find $P(X<68).$ First, we write this as a cumulative probability:\n\n$$\nP(X<68)=P(X\\le 68)\n$$\n\nThen, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X\\le 68) & =P(Z\\le \\frac{68-75}{8}) \\\\  & ≈P(Z\\le -0.88) \\\\  & =Φ(-0.88)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\nΦ(-0.88)=0.1894≈0.19.\n$$\n\nTherefore, the probability that a randomly selected student scores less than $68$ is approximately $0.19.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-07bafdfe-77c0-5c1b-9c62-90a031acb268"] :db/ensure [:question/validate]} {:db/id "answer-field-07bafdfe-77c0-5c1b-9c62-90a031acb268" :answer-field/id #uuid "07bafdfe-77c0-5c1b-9c62-90a031acb268" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2c059257-dee3-5562-812a-d0dc9d6f5f02" :answer-field/choices ["answer-2c059257-dee3-5562-812a-d0dc9d6f5f02"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c059257-dee3-5562-812a-d0dc9d6f5f02" :answer/id #uuid "2c059257-dee3-5562-812a-d0dc9d6f5f02" :answer/type :answer.type/math :answer/value "0.19" :db/ensure [:answer/validate]} {:db/id "question-e312f711-a596-58e6-bba4-4f3bc71c5f9f" :question/id #uuid "e312f711-a596-58e6-bba4-4f3bc71c5f9f" :question/math-academy-id "q-132434" :question/problem "The volume of soda in cans filled at a particular factory is normally distributed with a mean of $12$ ounces and a standard deviation of $0.1$ ounces. What is the probability that a randomly selected soda can contains more than $12.2$ ounces? Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,2.0\\,$ | $\\,0.9772\\,$ | $\\,0.9778\\,$ | $\\,0.9783\\,$ |\n| $\\,2.1\\,$ | $\\,0.9821\\,$ | $\\,0.9826\\,$ | $\\,0.9830\\,$ |\n| $\\,2.2\\,$ | $\\,0.9861\\,$ | $\\,0.9864\\,$ | $\\,0.9868\\,$ |" :question/worked-solution "Let $X$ represent the volume (in ounces) of soda in a randomly selected can. Then we have $X∼N(12,{0.1}^{2}).$\n\nWe want to find $P(X>12.2).$ Thus, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(X>12.2) & =P(Z>\\frac{12.2-12}{0.1}) \\\\  & =P(Z>2) \\\\  & =1-P(Z\\le 2) \\\\  & =1-Φ(2)\\end{aligned}\n$$\n\nFrom the $z$-table, we see that\n\n$$\n1-Φ(2)=1-0.9772≈0.02.\n$$\n\nTherefore, the probability that a randomly selected soda can contains more than $12.2$ ounces is approximately $0.02.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c5d04840-0a76-5834-bd32-257991f12cc2"] :db/ensure [:question/validate]} {:db/id "answer-field-c5d04840-0a76-5834-bd32-257991f12cc2" :answer-field/id #uuid "c5d04840-0a76-5834-bd32-257991f12cc2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ad72aa07-660d-51b0-afc8-b41ca13de413" :answer-field/choices ["answer-b79552a7-3376-5da8-91ca-17bece0d388e" "answer-7f62054b-c721-5065-baa7-a2e088063d8b" "answer-ad72aa07-660d-51b0-afc8-b41ca13de413" "answer-ae4692a1-b2be-56d2-9388-d0e19d2609ff" "answer-7836d0df-6d0e-53c1-9b87-066f993123a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-b79552a7-3376-5da8-91ca-17bece0d388e" :answer/id #uuid "b79552a7-3376-5da8-91ca-17bece0d388e" :answer/type :answer.type/math :answer/value "0.00" :db/ensure [:answer/validate]} {:db/id "answer-7f62054b-c721-5065-baa7-a2e088063d8b" :answer/id #uuid "7f62054b-c721-5065-baa7-a2e088063d8b" :answer/type :answer.type/math :answer/value "0.01" :db/ensure [:answer/validate]} {:db/id "answer-ad72aa07-660d-51b0-afc8-b41ca13de413" :answer/id #uuid "ad72aa07-660d-51b0-afc8-b41ca13de413" :answer/type :answer.type/math :answer/value "0.02" :db/ensure [:answer/validate]} {:db/id "answer-ae4692a1-b2be-56d2-9388-d0e19d2609ff" :answer/id #uuid "ae4692a1-b2be-56d2-9388-d0e19d2609ff" :answer/type :answer.type/math :answer/value "0.03" :db/ensure [:answer/validate]} {:db/id "answer-7836d0df-6d0e-53c1-9b87-066f993123a0" :answer/id #uuid "7836d0df-6d0e-53c1-9b87-066f993123a0" :answer/type :answer.type/math :answer/value "0.04" :db/ensure [:answer/validate]} {:db/id 17592186302160 :question/problem "The durations of direct flights on a certain route are normally distributed with a mean of $180$ minutes and a standard deviation of $20$ minutes. What is the probability that a randomly selected flight lasts more than $178$ minutes but less than $188$ minutes? **Round your answer to two decimal places**.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.2\\,$</th>\n<td align=\"center\"> $\\,0.4207\\,$ </td>\n<td align=\"center\"> $\\,0.4168\\,$ </td>\n<td align=\"center\"> $\\,0.4129\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th>\n<td align=\"center\"> $\\,0.4602\\,$ </td>\n<td align=\"center\"> $\\,0.4562\\,$ </td>\n<td align=\"center\"> $\\,0.4522\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.0\\,$</th>\n<td align=\"center\"> $\\,0.5000\\,$ </td>\n<td align=\"center\"> $\\,0.4960\\,$ </td>\n<td align=\"center\"> $\\,0.4920\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.00\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.01\\,$</th>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.02\\,$</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.2\\,$</th>\n<td align=\"center\"> $\\,0.5793\\,$ </td>\n<td align=\"center\"> $\\,0.5832\\,$ </td>\n<td align=\"center\"> $\\,0.5871\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.3\\,$</th>\n<td align=\"center\"> $\\,0.6179\\,$ </td>\n<td align=\"center\"> $\\,0.6217\\,$ </td>\n<td align=\"center\"> $\\,0.6255\\,$ </td>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.4\\,$</th>\n<td align=\"center\"> $\\,0.6554\\,$ </td>\n<td align=\"center\"> $\\,0.6591\\,$ </td>\n<td align=\"center\"> $\\,0.6628\\,$ </td>\n</tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>\n\nThe probability that a randomly selected flight lasts more than $178$ minutes but less than $188$ minutes is approximately\n{{field-1}}." :db/ensure [:question/validate]} {:db/id "question-865ccf64-fc88-5f41-a8ec-576978864deb" :question/id #uuid "865ccf64-fc88-5f41-a8ec-576978864deb" :question/math-academy-id "q-94978" :question/problem "The diastolic blood pressure of a group of people is normally distributed with a mean of $85\\,\\text{mm}\\,\\text{Hg}$ and a standard deviation of $14\\,\\text{mm}\\,\\text{Hg}.$ What is the probability that a randomly selected person from the group has a diastolic blood pressure greater than $77\\,\\text{mm}\\,\\text{Hg}$ and less than $86\\,\\text{mm}\\,\\text{Hg}?$ Round your answer to $2$ decimal places.\n\n*Hint: A table of values of $Φ(z)$ for different values of $z$ is given below, where $Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n<table align=\"center\">\n<tbody><tr>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.6\\,$</th><td align=\"center\"> $\\,0.2546\\,$ </td><td align=\"center\"> $\\,0.2514\\,$ </td><td align=\"center\"> $\\,0.2483\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.5\\,$</th><td align=\"center\"> $\\,0.2877\\,$ </td><td align=\"center\"> $\\,0.2843\\,$ </td><td align=\"center\"> $\\,0.2810\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.4\\,$</th><td align=\"center\"> $\\,0.3228\\,$ </td><td align=\"center\"> $\\,0.3192\\,$ </td><td align=\"center\"> $\\,0.3156\\,$ </td></tr>\n</tbody></table>\n</th>\n<th width=\"5%\"></th>\n<th>\n<table align=\"center\" cellpadding=\"5\" rules=\"all\">\n<tbody><tr> <th align=\"center\" bgcolor=\"#D6EAF8\" width=\"25%\">$z$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.06\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.07\\,$</th><th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.08\\,$</th>\n</tr><tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,-0.1\\,$</th><td align=\"center\"> $\\,0.4364\\,$ </td><td align=\"center\"> $\\,0.4325\\,$ </td><td align=\"center\"> $\\,0.4286\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.0\\,$</th><td align=\"center\"> $\\,0.5239\\,$ </td><td align=\"center\"> $\\,0.5279\\,$ </td><td align=\"center\"> $\\,0.5319\\,$ </td></tr>\n<tr> <th align=\"center\" bgcolor=\"#D6EAF8\">$\\,0.1\\,$</th><td align=\"center\"> $\\,0.5636\\,$ </td><td align=\"center\"> $\\,0.5675\\,$ </td><td align=\"center\"> $\\,0.5714\\,$ </td></tr>\n</tbody></table>\n</th>\n</tr>\n</tbody></table>" :question/worked-solution "Let $X$ represent the diastolic blood pressure of the selected person. Then we have $X∼N(85,{14}^{2}).$\n\nWe want to find $P(77<X<86).$ First, we convert $X$ to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(77<X<86) & =P(\\frac{77-85}{14}<Z<\\frac{86-85}{14}) \\\\  & =P(-0.57<Z<0.07)\\end{aligned}\n$$\n\nNow, we express the required probability in terms of $Φ(z):$\n\n$$\n\\begin{aligned}P(-0.57<Z<0.07) & =P(Z<0.07)-P(Z\\le -0.57) \\\\  & =P(Z\\le 0.07)-P(Z\\le -0.57) \\\\  & =Φ(0.07)-Φ(-0.57)\\end{aligned}\n$$\n\nFrom the table, we have the following:\n\n$$\n\\begin{aligned}Φ(0.07) & =0.5279 \\\\ Φ(-0.57) & =0.2843\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(-0.57<Z<0.07) & =Φ(0.07)-Φ(-0.57) \\\\  & =0.5279-0.2843 \\\\  & =0.2436.\\end{aligned}\n$$\n\nTherefore, the probability that the randomly selected person from the group has a diastolic blood pressure greater than $77\\,\\text{mm}\\,\\text{Hg}$ and less than $86\\,\\text{mm}\\,\\text{Hg}$ is approximately $0.24.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-044df1b7-c311-5b38-a151-6ea7331c7eee"] :db/ensure [:question/validate]} {:db/id "answer-field-044df1b7-c311-5b38-a151-6ea7331c7eee" :answer-field/id #uuid "044df1b7-c311-5b38-a151-6ea7331c7eee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-aed00733-48dd-5a2a-9f46-ede060604a30" :answer-field/choices ["answer-8fda6180-a0df-5a37-bce4-0c0c1f2770b9" "answer-7ca77ecc-c1a9-5d9e-bb7f-432fe7a73841" "answer-aed00733-48dd-5a2a-9f46-ede060604a30" "answer-b93831bc-3eb1-57b6-a625-ff14ad98c1fb" "answer-9c1602bd-bf20-5b35-8c8b-08a20f5fd4ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-8fda6180-a0df-5a37-bce4-0c0c1f2770b9" :answer/id #uuid "8fda6180-a0df-5a37-bce4-0c0c1f2770b9" :answer/type :answer.type/math :answer/value "0.19" :db/ensure [:answer/validate]} {:db/id "answer-7ca77ecc-c1a9-5d9e-bb7f-432fe7a73841" :answer/id #uuid "7ca77ecc-c1a9-5d9e-bb7f-432fe7a73841" :answer/type :answer.type/math :answer/value "0.21" :db/ensure [:answer/validate]} {:db/id "answer-aed00733-48dd-5a2a-9f46-ede060604a30" :answer/id #uuid "aed00733-48dd-5a2a-9f46-ede060604a30" :answer/type :answer.type/math :answer/value "0.24" :db/ensure [:answer/validate]} {:db/id "answer-b93831bc-3eb1-57b6-a625-ff14ad98c1fb" :answer/id #uuid "b93831bc-3eb1-57b6-a625-ff14ad98c1fb" :answer/type :answer.type/math :answer/value "0.29" :db/ensure [:answer/validate]} {:db/id "answer-9c1602bd-bf20-5b35-8c8b-08a20f5fd4ca" :answer/id #uuid "9c1602bd-bf20-5b35-8c8b-08a20f5fd4ca" :answer/type :answer.type/math :answer/value "0.32" :db/ensure [:answer/validate]} {:db/id 17592186083973 :question/problem "In a factory, soda cans are filled with a mean volume of $12$ ounces of soda. However, $1%$ of cans contain no more than $11.5$ ounces of soda. Assuming that the volume of soda in each can is normally distributed, find the standard deviation of the volume of soda in a can, rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |" :question/worked-solution "Let $X$ represent the volume (in ounces) of soda in a can. Then we have $X∼N(12,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 11.5)=0.01.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 11.5) & =0.01 \\\\ P(Z\\le \\frac{11.5-12}{\\sigma }) & =0.01 \\\\ Φ(-\\frac{0.5}{\\sigma }) & =0.01 \\\\ -\\frac{0.5}{\\sigma } & ={Φ}^{-1}(0.01).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.99)=2.3263,\n$$\n\nand therefore by symmetry, we have\n\n$$\n{Φ}^{-1}(1-0.99)={Φ}^{-1}(0.01)=-2.3263.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{0.5}{\\sigma } & =-2.3263 \\\\ \\frac{1}{\\sigma } & =4.6524 \\\\ \\sigma  & =\\frac{1}{4.6524} \\\\  & ≈0.21.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186082769 :answer-field/correct 17592186082773 :db/ensure [:answer-field/validate]} {:db/id "question-d916a01a-c116-520b-be92-bf93eddd6997" :question/id #uuid "d916a01a-c116-520b-be92-bf93eddd6997" :question/math-academy-id "q-95126" :question/problem "The lengths of babies at birth in a given population are normally distributed with a mean of $\\mu \\,\\text{cm}$ and a standard deviation of $6\\,\\text{cm}.$ Additionally, the length of $60%$ of the newborns falls between $0.9\\mu \\,\\text{cm}$ and $1.1\\mu \\,\\text{cm}.$ Find the mean $\\mu $ rounded to $2$ decimal places.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ | $\\,0.97\\,$ | $\\,0.99\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.8808\\,$ | $\\,2.3263\\,$ |" :question/worked-solution "Let $X$ represent the length of a randomly selected newborn. Then we have $X∼N(\\mu ,{6}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(0.9\\mu <X<1.1\\mu )=0.6.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.9\\mu <X<1.1\\mu ) & =0.6 \\\\ 2P(\\mu <X<1.1\\mu ) & =0.6 \\\\ P(\\mu <X<1.1\\mu ) & =0.3 \\\\ P(X<\\mu )+P(\\mu <X<1.1\\mu ) & =0.5+0.3 \\\\ P(X<1.1\\mu ) & =0.8\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<1.1\\mu ) & =0.8 \\\\ P(Z<\\frac{0.1\\mu }{6}) & =0.8 \\\\ Φ(\\frac{0.1\\mu }{6}) & =0.8 \\\\ \\frac{0.1\\mu }{6} & ={Φ}^{-1}(0.8)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.8)≈0.8416.\n$$\n\nFinally then,\n\n$$\n\\begin{aligned}\\frac{0.1\\mu }{6} & =0.8416 \\\\ 0.1\\mu  & =5.0496 \\\\ \\mu  & =\\frac{5.0496}{0.1} \\\\  & ≈50.50\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7782954d-0945-5a09-a4ad-d4eaf2acb6cc"] :db/ensure [:question/validate]} {:db/id "answer-field-7782954d-0945-5a09-a4ad-d4eaf2acb6cc" :answer-field/id #uuid "7782954d-0945-5a09-a4ad-d4eaf2acb6cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-975eb98b-4ab0-5014-8bea-9fcf9cfaaba5" :answer-field/choices ["answer-73143a86-4466-59b0-9d13-697c03f90f7c" "answer-ff5d72e2-1423-5d98-a00f-6cea45e898da" "answer-975eb98b-4ab0-5014-8bea-9fcf9cfaaba5" "answer-ec6926a3-0298-524c-9ffa-d17531745d04" "answer-264f5867-7c47-5f07-9b9c-b3815c6cd840"] :db/ensure [:answer-field/validate]} {:db/id "answer-73143a86-4466-59b0-9d13-697c03f90f7c" :answer/id #uuid "73143a86-4466-59b0-9d13-697c03f90f7c" :answer/type :answer.type/math :answer/value "40.50\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-ff5d72e2-1423-5d98-a00f-6cea45e898da" :answer/id #uuid "ff5d72e2-1423-5d98-a00f-6cea45e898da" :answer/type :answer.type/math :answer/value "48.05\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-975eb98b-4ab0-5014-8bea-9fcf9cfaaba5" :answer/id #uuid "975eb98b-4ab0-5014-8bea-9fcf9cfaaba5" :answer/type :answer.type/math :answer/value "50.50\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-ec6926a3-0298-524c-9ffa-d17531745d04" :answer/id #uuid "ec6926a3-0298-524c-9ffa-d17531745d04" :answer/type :answer.type/math :answer/value "52.15\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "answer-264f5867-7c47-5f07-9b9c-b3815c6cd840" :answer/id #uuid "264f5867-7c47-5f07-9b9c-b3815c6cd840" :answer/type :answer.type/math :answer/value "53.10\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "question-e22ccace-d75b-5bc7-acc2-7090937bcda1" :question/id #uuid "e22ccace-d75b-5bc7-acc2-7090937bcda1" :question/math-academy-id "q-324457" :question/problem "In a distribution center, the average weight of shipped packages is $2.5$ kilograms. However, $20%$ of packages weigh no more than $2.3$ kilograms. Assuming that package weights are normally distributed, find the standard deviation, $\\sigma ,$ of the package weights, **rounded to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n$\\sigma ≈$\n{{field-1}}\n$kg$" :question/worked-solution "Let $X$ represent the package weight (in kilograms). Then we have $X∼N(2.5,{\\sigma }^{2}),$ and we want to find the standard deviation $\\sigma .$ \n\nWe know that $P(X\\le 2.3)=0.20.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X\\le 2.3) & =0.20 \\\\ P(Z\\le \\frac{2.3-2.5}{\\sigma }) & =0.20 \\\\ Φ(-\\frac{0.2}{\\sigma }) & =0.20 \\\\ -\\frac{0.2}{\\sigma } & ={Φ}^{-1}(0.20).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.20)=-0.8416.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}-\\frac{0.2}{\\sigma } & =-0.8416 \\\\ \\frac{0.2}{\\sigma } & =0.8416 \\\\ \\sigma  & =\\frac{0.2}{0.8416} \\\\  & ≈0.24\\,\\text{kg}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-97f65a01-cb5a-533f-b4b2-586e85f00033"] :db/ensure [:question/validate]} {:db/id "answer-field-97f65a01-cb5a-533f-b4b2-586e85f00033" :answer-field/id #uuid "97f65a01-cb5a-533f-b4b2-586e85f00033" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-63e7cc4a-4887-5d31-b8e4-aff9bc110c7a" :answer-field/choices ["answer-63e7cc4a-4887-5d31-b8e4-aff9bc110c7a"] :db/ensure [:answer-field/validate]} {:db/id "answer-63e7cc4a-4887-5d31-b8e4-aff9bc110c7a" :answer/id #uuid "63e7cc4a-4887-5d31-b8e4-aff9bc110c7a" :answer/type :answer.type/math :answer/value "0.24" :db/ensure [:answer/validate]} {:db/id 17592186083977 :question/problem "The duration of feline pregnancies is normally distributed with a mean of $\\mu $ days and a standard deviation of $5$ days. Additionally, $20%$ of the pregnancies have a duration lower than $59$ days. Find the mean $\\mu $, rounded to the nearest day.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |" :question/worked-solution "Let $X$ represent the duration of a randomly selected pregnancy. Then we have $X∼N(\\mu ,{5}^{2}),$ and we want to find the mean $\\mu .$ \n\nWe know that $P(X<59)=0.20.$ Converting $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<59) & =0.20 \\\\ P(Z\\le \\frac{59-\\mu }{5}) & =0.20 \\\\ Φ(\\frac{59-\\mu }{5}) & =0.20 \\\\ \\frac{59-\\mu }{5} & ={Φ}^{-1}(0.20).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.20)=-0.8416.\n$$\n\nFinally then, \n\n$$\n\\begin{aligned}\\frac{59-\\mu }{5} & =-0.8416 \\\\ 59-\\mu  & =-4.208 \\\\ \\mu  & ≈63\\,\\text{days.}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186082793 :answer-field/correct 17592186082795 :db/ensure [:answer-field/validate]} {:db/id "question-1e826c15-fd0c-50c0-b8b3-b16460ce62c6" :question/id #uuid "1e826c15-fd0c-50c0-b8b3-b16460ce62c6" :question/math-academy-id "q-95073" :question/problem "A group of students took a test and got an average score of $81.$ Additionally, $5%$ of the students scored greater than $91.$ Assuming that the students' scores are normally distributed, find the percent of students with a score lower than $70,$ rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.9\\,$ | $\\,0.0287\\,$ | $\\,0.0281\\,$ | $\\,0.0274\\,$ |\n| $\\,-1.8\\,$ | $\\,0.0359\\,$ | $\\,0.0351\\,$ | $\\,0.0344\\,$ |\n| $\\,-1.7\\,$ | $\\,0.0446\\,$ | $\\,0.0436\\,$ | $\\,0.0427\\,$ |" :question/worked-solution "Let $X$ represent the grade obtained by a student. Then we have $X∼N(81,{\\sigma }^{2}),$ and we want to find $P(X<70).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>91)=0.05.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 91) & =1-P(X>91) \\\\  & =1-0.05 \\\\  & =0.95\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 91) & =0.95 \\\\ P(Z\\le \\frac{91-81}{\\sigma }) & =0.95 \\\\ Φ(\\frac{10}{\\sigma }) & =0.95 \\\\ \\frac{10}{\\sigma } & ={Φ}^{-1}(0.95)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.95)≈1.6449.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{10}{\\sigma } & =1.6449 \\\\ \\frac{1}{\\sigma } & =0.16449 \\\\ \\sigma  & =\\frac{1}{0.16449} \\\\  & ≈6.0794.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<70)$ as follows:\n\n$$\n\\begin{aligned}P(X<70) & =P(X\\le 70) \\\\  & =P(Z\\le \\frac{70-81}{6.0794}) \\\\  & ≈P(Z\\le -1.81) \\\\  & =Φ(-1.81) \\\\  & =0.0351 \\\\  & ≈3.5%\\end{aligned}\n$$\n\nTherefore, approximately $3.5%$ of the students scored lower than $70.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cc6a12d1-cfbc-5af0-9418-2c899316c53c"] :db/ensure [:question/validate]} {:db/id "answer-field-cc6a12d1-cfbc-5af0-9418-2c899316c53c" :answer-field/id #uuid "cc6a12d1-cfbc-5af0-9418-2c899316c53c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2f0e3978-3b5e-5638-9311-f13888ad9b43" :answer-field/choices ["answer-ea700cff-a6a3-5424-8a11-9d55e191fcfe" "answer-2f0e3978-3b5e-5638-9311-f13888ad9b43" "answer-acddec27-a38b-590b-a933-a99f67c9b55a" "answer-87afa8e3-be2d-5fe5-9004-6f754bddfb6f" "answer-9ee59e46-909a-577c-8aa1-de2ccae7ced6"] :db/ensure [:answer-field/validate]} {:db/id "answer-ea700cff-a6a3-5424-8a11-9d55e191fcfe" :answer/id #uuid "ea700cff-a6a3-5424-8a11-9d55e191fcfe" :answer/type :answer.type/math :answer/value "2.9%" :db/ensure [:answer/validate]} {:db/id "answer-2f0e3978-3b5e-5638-9311-f13888ad9b43" :answer/id #uuid "2f0e3978-3b5e-5638-9311-f13888ad9b43" :answer/type :answer.type/math :answer/value "3.5%" :db/ensure [:answer/validate]} {:db/id "answer-acddec27-a38b-590b-a933-a99f67c9b55a" :answer/id #uuid "acddec27-a38b-590b-a933-a99f67c9b55a" :answer/type :answer.type/math :answer/value "4.3%" :db/ensure [:answer/validate]} {:db/id "answer-87afa8e3-be2d-5fe5-9004-6f754bddfb6f" :answer/id #uuid "87afa8e3-be2d-5fe5-9004-6f754bddfb6f" :answer/type :answer.type/math :answer/value "5.0%" :db/ensure [:answer/validate]} {:db/id "answer-9ee59e46-909a-577c-8aa1-de2ccae7ced6" :answer/id #uuid "9ee59e46-909a-577c-8aa1-de2ccae7ced6" :answer/type :answer.type/math :answer/value "5.8%" :db/ensure [:answer/validate]} {:db/id "question-4286abc9-bbfc-5418-a3f8-c44338b9b405" :question/id #uuid "4286abc9-bbfc-5418-a3f8-c44338b9b405" :question/math-academy-id "q-133055" :question/problem "The output voltage of a particular model of laptop AC adapters is $19$ volts on average. However, $1%$ of adapters have a voltage greater than $20$ volts. Assuming that the output voltage is normally distributed, find the percent of AC adapters with a voltage greater than $19.3$ volts, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.900\\,$ | $\\,0.950\\,$ | $\\,0.975\\,$ | $\\,0.990\\,$ | $\\,0.995\\,$ | $\\,0.999\\,$ | $\\,0.9995\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ | $\\,1.9600\\,$ | $\\,2.3263\\,$ | $\\,2.5758\\,$ | $\\,3.0902\\,$ | $\\,3.2905\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.00\\,$ | $\\,0.01\\,$ | $\\,0.02\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.6\\,$ | $\\,0.7257\\,$ | $\\,0.7291\\,$ | $\\,0.7324\\,$ |\n| $\\,0.7\\,$ | $\\,0.7580\\,$ | $\\,0.7611\\,$ | $\\,0.7642\\,$ |\n| $\\,0.8\\,$ | $\\,0.7881\\,$ | $\\,0.7910\\,$ | $\\,0.7939\\,$ |" :question/worked-solution "Let $X$ represent the output voltage of a randomly selected AC adapter. Then we have $X∼N(19,{\\sigma }^{2}),$ and we want to find $P(X>19.3).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X>20)=0.01.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(X\\le 20) & =1-P(X>20) \\\\  & =1-0.01 \\\\  & =0.99\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X\\le 20) & =0.99 \\\\ P(Z\\le \\frac{20-19}{\\sigma }) & =0.99 \\\\ Φ(\\frac{1}{\\sigma }) & =0.99 \\\\ \\frac{1}{\\sigma } & ={Φ}^{-1}(0.99)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.99)≈2.3263.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{1}{\\sigma } & =2.3263 \\\\ \\sigma  & =\\frac{1}{2.32639} \\\\  & ≈0.42985.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X>19.3)$ as follows:\n\n$$\n\\begin{aligned}P(X>19.3) & =1-P(X\\le 19.3) \\\\  & =1-P(Z\\le \\frac{19.3-19}{0.42985}) \\\\  & ≈1-P(Z\\le 0.70) \\\\  & =1-Φ(0.70) \\\\  & =1-0.7580 \\\\  & ≈24.2%\\end{aligned}\n$$\n\nTherefore, approximately $24.2%$ of AC adapters have a voltage greater than $19.3$ volts." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-553ac2e3-4992-5bf9-a927-8dd39d781081"] :db/ensure [:question/validate]} {:db/id "answer-field-553ac2e3-4992-5bf9-a927-8dd39d781081" :answer-field/id #uuid "553ac2e3-4992-5bf9-a927-8dd39d781081" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04822258-26f6-53c8-944e-465c474e11aa" :answer-field/choices ["answer-55290d0d-b20c-5db9-a359-89cdf3c54ecf" "answer-3c7dcc06-7bd8-5a37-9726-5c0772337fd6" "answer-04822258-26f6-53c8-944e-465c474e11aa" "answer-3da7662f-51f3-5819-88a6-da0d21cda61b" "answer-8afaceac-1ebe-56aa-94bf-2f83f4de4163"] :db/ensure [:answer-field/validate]} {:db/id "answer-55290d0d-b20c-5db9-a359-89cdf3c54ecf" :answer/id #uuid "55290d0d-b20c-5db9-a359-89cdf3c54ecf" :answer/type :answer.type/math :answer/value "20.6%" :db/ensure [:answer/validate]} {:db/id "answer-3c7dcc06-7bd8-5a37-9726-5c0772337fd6" :answer/id #uuid "3c7dcc06-7bd8-5a37-9726-5c0772337fd6" :answer/type :answer.type/math :answer/value "23.9%" :db/ensure [:answer/validate]} {:db/id "answer-04822258-26f6-53c8-944e-465c474e11aa" :answer/id #uuid "04822258-26f6-53c8-944e-465c474e11aa" :answer/type :answer.type/math :answer/value "24.2%" :db/ensure [:answer/validate]} {:db/id "answer-3da7662f-51f3-5819-88a6-da0d21cda61b" :answer/id #uuid "3da7662f-51f3-5819-88a6-da0d21cda61b" :answer/type :answer.type/math :answer/value "26.9%" :db/ensure [:answer/validate]} {:db/id "answer-8afaceac-1ebe-56aa-94bf-2f83f4de4163" :answer/id #uuid "8afaceac-1ebe-56aa-94bf-2f83f4de4163" :answer/type :answer.type/math :answer/value "27.1%" :db/ensure [:answer/validate]} {:db/id "question-1b9f0001-1223-5b0c-bd32-5cd32bc54dbc" :question/id #uuid "1b9f0001-1223-5b0c-bd32-5cd32bc54dbc" :question/math-academy-id "q-325131" :question/problem "The weekly exercise time for a community is normally distributed with a mean of $\\mu $ minutes and a standard deviation of $30$ minutes. Additionally, $60%$ of people exercise between $0.9\\mu $ minutes and $1.1\\mu $ minutes each week. Find the percentage of people who exercise less than $220$ minutes per week. **Round your answer to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.75\\,$ | $\\,0.80\\,$ | $\\,0.85\\,$ | $\\,0.90\\,$ | $\\,0.95\\,$ |\n| --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,0.6745\\,$ | $\\,0.8416\\,$ | $\\,1.0364\\,$ | $\\,1.2816\\,$ | $\\,1.6449\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.07\\,$ | $\\,0.08\\,$ | $\\,0.09\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.2\\,$ | $\\,0.1020\\,$ | $\\,0.1003\\,$ | $\\,0.0985\\,$ |\n| $\\,-1.1\\,$ | $\\,0.1210\\,$ | $\\,0.1190\\,$ | $\\,0.1170\\,$ |\n| $\\,-1.0\\,$ | $\\,0.1423\\,$ | $\\,0.1401\\,$ | $\\,0.1379\\,$ |\n\nApproximately\n{{field-1}}$%$ of the people exercise less than $220$ minutes per week." :question/worked-solution "Let $X$ represent the weekly exercise time of a randomly selected person. Then we have $X∼N(\\mu ,{30}^{2}),$ and we want to find $P(X<220).$ But first, we need to find the mean $\\mu .$ \n\nWe know that $P(0.9\\mu <X<1.1\\mu )=0.60.$ First, we convert this to a cumulative probability:\n\n$$\n\\begin{aligned}P(0.9\\mu <X<1.1\\mu ) & =0.60 \\\\ 2P(\\mu <X<1.1\\mu ) & =0.60 \\\\ P(\\mu <X<1.1\\mu ) & =0.30 \\\\ P(X<\\mu )+P(\\mu <X<1.1\\mu ) & =0.5+0.30 \\\\ P(X<1.1\\mu ) & =0.80\\end{aligned}\n$$\n\nNext, we convert $X$ to a standard normal random variable by $z$-scoring. We get\n\n$$\n\\begin{aligned}P(X<1.1\\mu ) & =0.80 \\\\ P(Z<\\frac{0.1\\mu }{30}) & =0.80 \\\\ Φ(\\frac{0.1\\mu }{30}) & =0.80 \\\\ \\frac{0.1\\mu }{30} & ={Φ}^{-1}(0.80).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.80)=0.8416.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{0.1\\mu }{30} & =0.8416 \\\\ 0.1\\mu  & =25.248 \\\\ \\mu  & =\\frac{25.248}{0.1} \\\\  & ≈252.48.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<220)$ as follows:\n\n$$\n\\begin{aligned}P(X<220) & =P(Z<\\frac{220-252.48}{30}) \\\\  & ≈P(Z<-1.08) \\\\  & =Φ(-1.08) \\\\  & =0.1401 \\\\  & ≈14.01%\\end{aligned}\n$$\n\nTherefore, approximately $14.01%$ of the people exercise less than $220$ minutes per week." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8c01aeff-128f-59ee-875c-e17680c52732"] :db/ensure [:question/validate]} {:db/id "answer-field-8c01aeff-128f-59ee-875c-e17680c52732" :answer-field/id #uuid "8c01aeff-128f-59ee-875c-e17680c52732" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f57cbe6e-ad50-582d-89c2-10cdef51ceda" :answer-field/choices ["answer-f57cbe6e-ad50-582d-89c2-10cdef51ceda"] :db/ensure [:answer-field/validate]} {:db/id "answer-f57cbe6e-ad50-582d-89c2-10cdef51ceda" :answer/id #uuid "f57cbe6e-ad50-582d-89c2-10cdef51ceda" :answer/type :answer.type/math :answer/value "14.01" :db/ensure [:answer/validate]} {:db/id "question-fe644563-13d6-5255-adb7-59462252c8b9" :question/id #uuid "fe644563-13d6-5255-adb7-59462252c8b9" :question/math-academy-id "q-325123" :question/problem "The average amount of coffee dispensed into medium cups is $10$ ounces. Additionally, in $15%$ of cups, the coffee amount is less than $9.1$ ounces. Assuming the amount dispensed is normally distributed, find the percentage of cups containing less than $8.5$ ounces of coffee. **Round your answer to two decimal places.**\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution.*\n\n| $\\,p\\,$ | $0.01$ | $0.03$ | $0.05$ | $0.10$ | $0.15$ | $0.20$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z).$*\n\n| $z$ | $\\,0.02\\,$ | $\\,0.03\\,$ | $\\,0.04\\,$ |\n| --- | --- | --- | --- |\n| $\\,-1.8\\,$ | $\\,0.0344\\,$ | $\\,0.0336\\,$ | $\\,0.0329\\,$ |\n| $\\,-1.7\\,$ | $\\,0.0427\\,$ | $\\,0.0418\\,$ | $\\,0.0409\\,$ |\n| $\\,-1.6\\,$ | $\\,0.0526\\,$ | $\\,0.0516\\,$ | $\\,0.0505\\,$ |\n\nApprximately\n{{field-1}}$%$ of cups contain less than $8.5$ ounces of coffee." :question/worked-solution "Let $X$ represent the amount of coffee in a randomly selected cup. Then we have $X∼N(10,{\\sigma }^{2}),$ and we want to find $P(X<8.5).$ But first, we need to find the standard deviation $\\sigma .$\n\nWe know that $P(X<9.1)=0.15.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<9.1) & =0.15 \\\\ P(Z\\le \\frac{9.1-10}{\\sigma }) & =0.15 \\\\ Φ(\\frac{-0.9}{\\sigma }) & =0.15 \\\\ \\frac{-0.9}{\\sigma } & ={Φ}^{-1}(0.15).\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.15)=-1.0364.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{-0.9}{\\sigma } & =-1.0364 \\\\ \\frac{0.9}{\\sigma } & =1.0364 \\\\ \\sigma  & =\\frac{0.9}{1.0364} \\\\ \\sigma  & ≈0.8684.\\end{aligned}\n$$\n\nFinally, we can solve for $P(X<8.5)$ as follows:\n\n$$\n\\begin{aligned}P(X<8.5) & =P(X\\le 8.5) \\\\  & =P(Z\\le \\frac{8.5-10}{0.8684}) \\\\  & ≈P(Z\\le -1.73) \\\\  & =Φ(-1.73) \\\\  & =0.0418 \\\\  & ≈4.18%.\\end{aligned}\n$$\n\nTherefore, approximately $4.18%$ of coffee cups contain less than $8.5$ ounces of coffee." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bee0cd22-295e-5274-8db9-3430efc1f645"] :db/ensure [:question/validate]} {:db/id "answer-field-bee0cd22-295e-5274-8db9-3430efc1f645" :answer-field/id #uuid "bee0cd22-295e-5274-8db9-3430efc1f645" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f4f2613b-7acb-5604-981e-e17f2565df89" :answer-field/choices ["answer-f4f2613b-7acb-5604-981e-e17f2565df89"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4f2613b-7acb-5604-981e-e17f2565df89" :answer/id #uuid "f4f2613b-7acb-5604-981e-e17f2565df89" :answer/type :answer.type/math :answer/value "4.18" :db/ensure [:answer/validate]} {:db/id 17592186083976 :question/problem "A cellphone battery's average time from full to empty is $26$ hours. Additionally, $20%$ of the time, the battery lasts less than $20$ hours. Assuming that the duration of the battery is normally distributed, find the percentage of the times that a full charge lasts more than $30$ hours, rounded to $1$ decimal place.\n\n*Hint: A table of values of ${Φ}^{-1}(p)$ for different values of $p$ is given below, where $p=Φ(z)$ is the cumulative distribution function for the standard normal distribution. *\n\n| $p$ | $\\,0.01\\,$ | $\\,0.03\\,$ | $\\,0.05\\,$ | $\\,0.10\\,$ | $\\,0.15\\,$ | $\\,0.20\\,$ | $\\,0.25\\,$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| ${Φ}^{-1}(p)$ | $\\,-2.3263\\,$ | $\\,-1.8808\\,$ | $\\,-1.6449\\,$ | $\\,-1.2816\\,$ | $\\,-1.0364\\,$ | $\\,-0.8416\\,$ | $\\,-0.6745\\,$ |\n\n$$\n\n$$\n\n*In addition, you're given the following table of values for $p=Φ(z)$*.\n\n| $z$ | $\\,0.05\\,$ | $\\,0.06\\,$ | $\\,0.07\\,$ |\n| --- | --- | --- | --- |\n| $\\,0.4\\,$ | $\\,0.6736\\,$ | $\\,0.6772\\,$ | $\\,0.6808\\,$ |\n| $\\,0.5\\,$ | $\\,0.7088\\,$ | $\\,0.7123\\,$ | $\\,0.7157\\,$ |\n| $\\,0.6\\,$ | $\\,0.7422\\,$ | $\\,0.7454\\,$ | $\\,0.7486\\,$ |" :question/worked-solution "Let $X$ represent the time a full charge lasts. Then we have $X∼N(26,{\\sigma }^{2}),$ and we want to find $P(X>30).$ But first, we need to find the standard deviation $\\sigma .$ \n\nWe know that $P(X<20)=0.20.$ First, we convert $X$ to a standard normal random variable by $z$-scoring, we get\n\n$$\n\\begin{aligned}P(X<20) & =0.20 \\\\ P(Z\\le \\frac{20-26}{\\sigma }) & =0.20 \\\\ Φ(\\frac{-6}{\\sigma }) & =0.20 \\\\ \\frac{-6}{\\sigma } & ={Φ}^{-1}(0.20)\\end{aligned}\n$$\n\nFrom the table, \n\n$$\n{Φ}^{-1}(0.20)≈-0.8416.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{-6}{\\sigma } & =-0.8416 \\\\ \\frac{1}{\\sigma } & =0.14027 \\\\ \\sigma  & =\\frac{1}{0.14027} \\\\  & ≈7.1291.\\end{aligned}\n$$\n\nFinally, we can solve for $P(30<X)$ as follows:\n\n$$\n\\begin{aligned}P(X>30) & =P(Z>\\frac{30-26}{7.1291}) \\\\  & ≈P(Z>0.56) \\\\  & =1-P(Z\\le 0.56) \\\\  & =1-Φ(0.56) \\\\  & =1-0.7123 \\\\  & ≈28.8%\\end{aligned}\n$$\n\nTherefore, approximately $28.8%$ of the times the battery lasts more than $30$ hours." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186082787 :answer-field/correct 17592186082792 :db/ensure [:answer-field/validate]} {:db/id 17592186083466 :activity/expected-seconds 1380.0 :db/ensure [:activity/validate]} {:db/id 17592186166848 :knowledge-point/questions ["question-39f657eb-aa97-5394-b0e6-ecba3bf80018" "question-deb0627a-b1f4-5ecd-95e2-372ffa642f2c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167117 :question/problem "The students in a particular school are split among three classes, class $1,$ class $2,$ and class $3.$\n\n- Class $1$ contains $25%$ of the students in the school, and $55%$ of those students take biology.\n\n- Class $2$ contains $35%$ of the students in the school, and $40%$ of those students take biology.\n\n- Class $3$ contains $40%$ of the students in the school.\n\nIf $45%$ of students in the entire school are female, $80%$ of female students take biology, and $70%$ of biology students are female, what is the probability that a randomly selected student from class $3$ takes biology? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a student is female, $B$ be the event that a student takes biology, and ${C}_{1},{C}_{2},{C}_{3}$ be the event that a student is in class $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({C}_{1})=0.25 &  & P(B|{C}_{1})=0.55 \\\\  & P({C}_{2})=0.35 &  & P(B|{C}_{2})=0.4 \\\\  & P({C}_{3})=0.4\\end{aligned}\n$$\n\nThe disjoint union ${C}_{1}⊔{C}_{2}⊔{C}_{3}$ covers the entire sample space, and we have\n\n$$\nP({C}_{1})+P({C}_{2})+P({C}_{3})=0.25+0.35+0.4=1.\n$$\n\n- Since $45%$ of students in the entire school are female, we have\n\n$$\nP(F)=0.45.\n$$\n\n- Since $80%$ of females take biology, we have\n\n$$\nP(B|F)=0.8.\n$$\n\n- Since $70%$ of biology students are female, we have\n\n$$\nP(F|B)=0.7.\n$$\n\nWe want to find the probability that a randomly chosen student from class $3$ takes biology, which is represented as $P(B|{C}_{3}).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|B) & =\\frac{P(B|F)P(F)}{P(B)} \\\\ P(F|B) & =\\frac{P(B|F)P(F)}{P(B|{C}_{1})P({C}_{1})+P(B|{C}_{2})P({C}_{2})+P(B|{C}_{3})P({C}_{3})} \\\\ 0.7 & =\\frac{(0.8)(0.45)}{(0.55)(0.25)+(0.4)(0.35)+P(B|{C}_{3})(0.4)} \\\\ 0.7 & =\\frac{0.36}{0.2775+0.4P(B|{C}_{3})}.\\end{aligned}\n$$\n\nSolving this equation for $P(B|{C}_{3}),$ we have\n\n$$\n\\begin{aligned}0.7(0.2775+0.4P(B|{C}_{3})) & =0.36 \\\\ 0.2775+0.4P(B|{C}_{3}) & =\\frac{0.36}{0.7} \\\\ 0.2775+0.4P(B|{C}_{3}) & =\\frac{18}{35} \\\\ 0.4P(B|{C}_{3}) & =\\frac{18}{35}-0.2775 \\\\ P(B|{C}_{3}) & =\\frac{1}{0.4}(\\frac{18}{35}-0.2775) \\\\ P(B|{C}_{3}) & ≈0.592\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186163780 :answer-field/correct 17592186163785 :db/ensure [:answer-field/validate]} {:db/id "question-39f657eb-aa97-5394-b0e6-ecba3bf80018" :question/id #uuid "39f657eb-aa97-5394-b0e6-ecba3bf80018" :question/math-academy-id "q-148666" :question/problem "A manufacturing company has three sites, factory $1,$ factory $2,$ and factory $3.$ They all produce two types of light bulbs: A and B.\n\n- Factory $1$ produces $45%$ of the entire production, and $5%$ of those bulbs are defective.\n\n- Factory $2$ produces $45%$ of the entire production.\n\n- Factory $3$ produces $10%$ of the entire production, and $1%$ of those bulbs are defective.\n\nIf $57%$ of all light bulbs are of type A, $3%$ of type A light bulbs are defective, and $41%$ of defective light bulbs are of type A, what is the probability that a randomly chosen light bulb from factory $2$ is defective? Round your answer to $3$ decimal places." :question/worked-solution "Let $A$ be the event that a light bulb is of type A, $D$ be the event that a light bulb is defective, and ${F}_{1},{F}_{2},{F}_{3}$ be the event that a light bulb is produced in factory $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({F}_{1})=0.45 &  & P(D|{F}_{1})=0.05 \\\\  & P({F}_{2})=0.45 \\\\  & P({F}_{3})=0.1 &  & P(D|{F}_{3})=0.01\\end{aligned}\n$$\n\nThe disjoint union ${F}_{1}⊔{F}_{2}⊔{F}_{3}$ covers the entire sample space, and we have\n\n$$\nP({F}_{1})+P({F}_{2})+P({F}_{3})=0.45+0.45+0.1=1.\n$$\n\n- Since $57%$ of all light bulbs are of type A, we have\n\n$$\nP(A)=0.57.\n$$\n\n- Since $3%$ of type A light bulbs are defective, we have\n\n$$\nP(D|A)=0.03.\n$$\n\n- Since $41%$ of defective light bulbs are of type A, we have\n\n$$\nP(A|D)=0.41\n$$\n\nWe want to find the probability that a randomly chosen light bulb from factory $2$ is defective, which is represented as $P(D|{F}_{2}).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(A|D) & =\\frac{P(D|A)P(A)}{P(D)} \\\\ P(A|D) & =\\frac{P(D|A)P(A)}{P(D|{F}_{1})P({F}_{1})+P(D|{F}_{2})P({F}_{2})+P(D|{F}_{3})P({F}_{3})} \\\\ 0.41 & =\\frac{(0.03)(0.57)}{(0.05)(0.45)+P(D|{F}_{2})(0.45)+(0.01)(0.1)} \\\\ 0.41 & =\\frac{0.0171}{0.0235+0.45P(D|{F}_{2})}\\end{aligned}\n$$\n\nSolving this equation for $P(D|{F}_{2}),$ we have\n\n$$\n\\begin{aligned}0.41(0.0235+0.45P(D|{F}_{2})) & =0.0171 \\\\ 0.0235+0.45P(D|{F}_{2}) & =\\frac{0.0171}{0.41} \\\\ 0.0235+0.45P(D|{F}_{2}) & =\\frac{171}{4100} \\\\ 0.45P(D|{F}_{2}) & =\\frac{171}{4100}-0.0235 \\\\ P(D|{F}_{2}) & =\\frac{1}{0.45}(\\frac{171}{4100}-0.0235) \\\\ P(D|{F}_{2}) & ≈0.040\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f3f4b001-3f5d-563e-a82a-efaf92b09aad"] :db/ensure [:question/validate]} {:db/id "answer-field-f3f4b001-3f5d-563e-a82a-efaf92b09aad" :answer-field/id #uuid "f3f4b001-3f5d-563e-a82a-efaf92b09aad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e67f42bf-f74e-5283-955d-76c3d0573b19" :answer-field/choices ["answer-2315c5ef-ec06-536c-af7c-d82e621541c3" "answer-75ac382e-a141-5c83-ade6-7dc3a4ffc925" "answer-e67f42bf-f74e-5283-955d-76c3d0573b19" "answer-68e491ab-da9f-5329-9aaa-a11a1bebb3d6" "answer-08123d50-e1d2-5e75-87c8-dc4ecec898fa"] :db/ensure [:answer-field/validate]} {:db/id "answer-2315c5ef-ec06-536c-af7c-d82e621541c3" :answer/id #uuid "2315c5ef-ec06-536c-af7c-d82e621541c3" :answer/type :answer.type/math :answer/value "0.03" :db/ensure [:answer/validate]} {:db/id "answer-75ac382e-a141-5c83-ade6-7dc3a4ffc925" :answer/id #uuid "75ac382e-a141-5c83-ade6-7dc3a4ffc925" :answer/type :answer.type/math :answer/value "0.035" :db/ensure [:answer/validate]} {:db/id "answer-e67f42bf-f74e-5283-955d-76c3d0573b19" :answer/id #uuid "e67f42bf-f74e-5283-955d-76c3d0573b19" :answer/type :answer.type/math :answer/value "0.040" :db/ensure [:answer/validate]} {:db/id "answer-68e491ab-da9f-5329-9aaa-a11a1bebb3d6" :answer/id #uuid "68e491ab-da9f-5329-9aaa-a11a1bebb3d6" :answer/type :answer.type/math :answer/value "0.047" :db/ensure [:answer/validate]} {:db/id "answer-08123d50-e1d2-5e75-87c8-dc4ecec898fa" :answer/id #uuid "08123d50-e1d2-5e75-87c8-dc4ecec898fa" :answer/type :answer.type/math :answer/value "0.05" :db/ensure [:answer/validate]} {:db/id 17592186166877 :knowledge-point/questions ["question-2ad5265b-a872-53d0-b3f1-65585e111dd6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167118 :question/problem "Arthur and Sara are finding the best recipe for chocolate muffins, and they test three different oven cooking modes, mode $1,$ mode $2,$ and mode $3.$ They also try two types of yeast, A and B.\n\n- They use mode $1$ to cook the $30%$ of their muffins, and $90%$ of those muffins turn out well.\n\n- They use mode $2$ to cook the $40%$ of their muffins, and $85%$ of those muffins turn out well.\n\n- They use mode $3$ to cook the $30%$ of their muffins, and $88%$ of those muffins turn out well.\n\nIf $20%$ of all muffins was prepared with yeast A, and $87%$ of yeast A muffins turn out well, what is the probability that a randomly chosen good muffin is done with yeast A? Round your answer to $3$ decimal places." :question/worked-solution "Let $A$ be the event that a muffin is made with yeast A, $G$ be the event that a muffin turns out well, and ${M}_{1},{M}_{2},{M}_{3}$ be the event that a muffin is cooked with mode $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({M}_{1})=0.3 &  & P(G|{M}_{1})=0.9 \\\\  & P({M}_{2})=0.4 &  & P(G|{M}_{2})=0.85 \\\\  & P({M}_{3})=0.3 &  & P(G|{M}_{3})=0.88\\end{aligned}\n$$\n\nThe disjoint union ${M}_{1}⊔{M}_{2}⊔{M}_{3}$ covers the entire sample space, and we have\n\n$$\nP({M}_{1})+P({M}_{2})+P({M}_{3})=0.3+0.4+0.3=1.\n$$\n\n- Since $20%$ of muffins are made with yeast A, we have\n\n$$\nP(A)=0.2.\n$$\n\n- Since $87%$ of muffins made with yeast A turn out well, we have\n\n$$\nP(G|A)=0.87.\n$$\n\nWe want to find the probability that a randomly chosen good muffin is made with yeast A, which is represented as $P(A|G).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(A|G) & =\\frac{P(G|A)P(A)}{P(G)} \\\\  & =\\frac{P(G|A)P(A)}{P(G|{M}_{1})P({M}_{1})+P(G|{M}_{2})P({M}_{2})+P(G|{M}_{3})P({M}_{3})} \\\\  & =\\frac{(0.87)(0.2)}{(0.9)(0.3)+(0.85)(0.4)+(0.88)(0.3)} \\\\  & =\\frac{0.174}{0.874} \\\\  & ≈0.199,\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186163786 :answer-field/correct 17592186163788 :db/ensure [:answer-field/validate]} {:db/id "question-deb0627a-b1f4-5ecd-95e2-372ffa642f2c" :question/id #uuid "deb0627a-b1f4-5ecd-95e2-372ffa642f2c" :question/math-academy-id "q-149493" :question/problem "A volleyball school for children splits the players into three teams, team $1$, team $2,$ and team $3.$ \n\n- $44%$ of children are in team $1,$ and $23%$ of children in this team have been playing for over two years.\n\n- $32%$ of children are in team $2,$ and $26%$ of children in this team have been playing for over two years.\n\n- $24%$ of children are in team $3.$\n\nIf $7%$ of all children can play in the blocker position, $40%$ of children who can play as blockers have been playing for over two years, and $10%$ of children who have been playing for over two years can play as blockers, what is the probability that a randomly chosen child in team $3$ has been playing for over two years? Round your answer to $3$ decimal places." :question/worked-solution "Let $B$ be the event that a child can play in the blocker position, $I$ be the event that a child has been playing for over two years, and ${T}_{1},{T}_{2},{T}_{3}$ be the events that a child is in team $1,$ $2,$ or $3,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P({T}_{1})=0.44 &  & P(I|{T}_{1})=0.23 \\\\  & P({T}_{2})=0.32 &  & P(I|{T}_{2})=0.26 \\\\  & P({T}_{3})=0.24\\end{aligned}\n$$\n\nThe disjoint union ${T}_{1}⊔{T}_{2}⊔{T}_{3}$ covers the entire sample space, and we have\n\n$$\nP({T}_{1})+P({T}_{2})+P({T}_{3})=0.44+0.32+0.24=1.\n$$\n\n- Since $7%$ of children can play in the blocker position, we have\n\n$$\nP(B)=0.07.\n$$\n\n- Since $40%$ of children who can play as blockers have been playing for over two years, we have\n\n$$\nP(I|B)=0.4.\n$$\n\n- Since $10%$ of children who have been playing for over two years can play as blockers, we have\n\n$$\nP(B|I)=0.1.\n$$\n\nWe want to find the probability that a randomly chosen child in team 3 has been playing for over two years, which is represented as $P(I|{T}_{3}).$\n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(B|I) & =\\frac{P(I|B)P(B)}{P(I)} \\\\ P(B|I) & =\\frac{P(I|B)P(B)}{P(I|{T}_{1})P({T}_{1})+P(I|{T}_{2})P({T}_{2})+P(I|{T}_{3})P({T}_{3})} \\\\ 0.1 & =\\frac{(0.4)(0.07)}{(0.23)(0.44)+(0.26)(0.32)+P(I|{T}_{3})(0.24)} \\\\ 0.1 & =\\frac{0.028}{0.1844+0.24P(I|{T}_{3})}.\\end{aligned}\n$$\n\nSolving this equation for $P(I|{T}_{3}),$ we have\n\n$$\n\\begin{aligned}0.1(0.1844+0.24P(I|{T}_{3})) & =0.028 \\\\ 0.1844+0.24P(I|{T}_{3}) & =\\frac{0.028}{0.1} \\\\ 0.1844+0.24P(I|{T}_{3}) & =\\frac{7}{25} \\\\ 0.24P(I|{T}_{3}) & =\\frac{7}{25}-0.1844 \\\\ P(I|{T}_{3}) & =\\frac{1}{0.24}(\\frac{7}{25}-0.1844) \\\\ P(I|{T}_{3}) & ≈0.398\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-b2b5eda7-fc54-5354-9c43-01751b2546c8"] :db/ensure [:question/validate]} {:db/id "answer-field-b2b5eda7-fc54-5354-9c43-01751b2546c8" :answer-field/id #uuid "b2b5eda7-fc54-5354-9c43-01751b2546c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e44bfd71-59f5-5456-8e29-b331fc4b994f" :answer-field/choices ["answer-db3514aa-7da2-58cd-a765-4883b4c73d8a" "answer-e5ca70ca-440e-5d09-bd91-1a12c84d2bf9" "answer-aad9a2ec-8c38-50c5-a148-e148cf1a201f" "answer-e44bfd71-59f5-5456-8e29-b331fc4b994f" "answer-cb08ac4c-bcdb-5bf3-803d-48abd3c44b23"] :db/ensure [:answer-field/validate]} {:db/id "answer-db3514aa-7da2-58cd-a765-4883b4c73d8a" :answer/id #uuid "db3514aa-7da2-58cd-a765-4883b4c73d8a" :answer/type :answer.type/math :answer/value "0.135" :db/ensure [:answer/validate]} {:db/id "answer-e5ca70ca-440e-5d09-bd91-1a12c84d2bf9" :answer/id #uuid "e5ca70ca-440e-5d09-bd91-1a12c84d2bf9" :answer/type :answer.type/math :answer/value "0.252" :db/ensure [:answer/validate]} {:db/id "answer-aad9a2ec-8c38-50c5-a148-e148cf1a201f" :answer/id #uuid "aad9a2ec-8c38-50c5-a148-e148cf1a201f" :answer/type :answer.type/math :answer/value "0.307" :db/ensure [:answer/validate]} {:db/id "answer-e44bfd71-59f5-5456-8e29-b331fc4b994f" :answer/id #uuid "e44bfd71-59f5-5456-8e29-b331fc4b994f" :answer/type :answer.type/math :answer/value "0.398" :db/ensure [:answer/validate]} {:db/id "answer-cb08ac4c-bcdb-5bf3-803d-48abd3c44b23" :answer/id #uuid "cb08ac4c-bcdb-5bf3-803d-48abd3c44b23" :answer/type :answer.type/math :answer/value "0.546" :db/ensure [:answer/validate]} {:db/id "question-2ad5265b-a872-53d0-b3f1-65585e111dd6" :question/id #uuid "2ad5265b-a872-53d0-b3f1-65585e111dd6" :question/math-academy-id "q-149494" :question/problem "In a nature park, there are $4$ species of squirrels, each with the same population.\n\n- Among the squirrels of species $1,$ $12%$ are born in captivity.\n\n- Among the squirrels of species $2,$ $5%$ are born in captivity.\n\n- Among the squirrels of species $3,$ $6%$ are born in captivity.\n\n- Among the squirrels of species $4,$ $3%$ are born in captivity.\n\nIf $35%$ of the squirrels are adult females, and $8%$ of the adult female squirrels are born in captivity, what is the probability that a randomly chosen squirrel born in captivity is an adult female? Round your answer to $3$ decimal places." :question/worked-solution "Let $F$ be the event that a squirrel is an adult female, $C$ be the event that a squirrel is born in captivity, and ${S}_{1},{S}_{2},{S}_{3},{S}_{4}$ be the event that a squirrel is of species $1,$ $2,$ $3,$ or $4,$ respectively. \n\nLet's break down the information given in the problem statement:\n\n- Each species has the same number of squirrels, so we have the following information:\n\n$$\n\\begin{aligned}P({S}_{1})=P({S}_{2})=P({S}_{3})=P({S}_{4})=0.25\\end{aligned}\n$$\n\n- From the bullet points, we have the following information:\n\n$$\n\\begin{aligned} & P(C|{S}_{1})=0.12 \\\\  & P(C|{S}_{2})=0.05 \\\\  & P(C|{S}_{3})=0.06 \\\\  & P(C|{S}_{4})=0.03\\end{aligned}\n$$\n\nThe disjoint union ${S}_{1}⊔{S}_{2}⊔{S}_{3}⊔{S}_{4}$ covers the entire sample space, and we have\n\n$$\nP({S}_{1})+P({S}_{2})+P({S}_{3})+P({S}_{4})=0.25+0.25+0.25+0.25=1.\n$$\n\n- Since $35%$ of the squirrels are adult females, we have\n\n$$\nP(F)=0.35.\n$$\n\n- Since $8%$ of adult females are born in captivity, we have\n\n$$\nP(C|F)=0.08.\n$$\n\nWe want to find the probability that a randomly chosen squirrel born in captivity is an adult female, which is represented as $P(F|C).$ \n\nUsing Bayes' theorem combined with the law of total probability, we have\n\n$$\n\\begin{aligned}P(F|C) & =\\frac{P(C|F)P(F)}{P(C)} \\\\  & =\\frac{P(C|F)P(F)}{P(C|{S}_{1})P({S}_{1})+P(C|{S}_{2})P({S}_{2})+P(C|{S}_{3})P({S}_{3})+P(C|{S}_{3})P({S}_{3})} \\\\  & =\\frac{(0.08)(0.35)}{(0.12)(0.25)+(0.05)(0.25)+(0.06)(0.25)+(0.03)(0.25)} \\\\  & =\\frac{0.028}{0.065} \\\\  & ≈0.431,\\end{aligned}\n$$\n\nrounded to $3$ decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ae7e24b9-313e-560b-9e0c-e4316aa55761"] :db/ensure [:question/validate]} {:db/id "answer-field-ae7e24b9-313e-560b-9e0c-e4316aa55761" :answer-field/id #uuid "ae7e24b9-313e-560b-9e0c-e4316aa55761" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9664ae4b-b407-5bfc-92af-7d685fbf9717" :answer-field/choices ["answer-0efdb1e8-9c52-52d4-b930-051a0d37a2ac" "answer-bd528e4f-8665-5726-9e95-265f3f2fbb42" "answer-e4fb6fc7-b587-569b-b74c-57c52fc7da96" "answer-0fd36a06-2c0d-5867-b8fb-b56a3f2b9dcd" "answer-9664ae4b-b407-5bfc-92af-7d685fbf9717"] :db/ensure [:answer-field/validate]} {:db/id "answer-0efdb1e8-9c52-52d4-b930-051a0d37a2ac" :answer/id #uuid "0efdb1e8-9c52-52d4-b930-051a0d37a2ac" :answer/type :answer.type/math :answer/value "0.08" :db/ensure [:answer/validate]} {:db/id "answer-bd528e4f-8665-5726-9e95-265f3f2fbb42" :answer/id #uuid "bd528e4f-8665-5726-9e95-265f3f2fbb42" :answer/type :answer.type/math :answer/value "0.235" :db/ensure [:answer/validate]} {:db/id "answer-e4fb6fc7-b587-569b-b74c-57c52fc7da96" :answer/id #uuid "e4fb6fc7-b587-569b-b74c-57c52fc7da96" :answer/type :answer.type/math :answer/value "0.35" :db/ensure [:answer/validate]} {:db/id "answer-0fd36a06-2c0d-5867-b8fb-b56a3f2b9dcd" :answer/id #uuid "0fd36a06-2c0d-5867-b8fb-b56a3f2b9dcd" :answer/type :answer.type/math :answer/value "0.369" :db/ensure [:answer/validate]} {:db/id "answer-9664ae4b-b407-5bfc-92af-7d685fbf9717" :answer/id #uuid "9664ae4b-b407-5bfc-92af-7d685fbf9717" :answer/type :answer.type/math :answer/value "0.431" :db/ensure [:answer/validate]} {:db/id "activity-cebad3dd-e992-52ed-b284-8c84be80cca2" :activity/id #uuid "cebad3dd-e992-52ed-b284-8c84be80cca2" :activity/title "Extending Bayes' Theorem" :activity/type :activity.type/review :activity/scope 17592186048270 :activity/course 17592186046659 :activity/steps ["step-84fa05d5-af97-59d8-b33c-dd583737eabb" "step-e03d6f33-2586-5d57-a7b2-26ad674790fd" "step-444842eb-2ff5-586c-acce-f30990803c2c" "step-f74c9cc2-11d5-584d-b43f-9184a7e00330" "step-b32c5a3a-fa6d-50eb-94d9-f684a00e861d"] :activity/first-step "step-84fa05d5-af97-59d8-b33c-dd583737eabb" :db/ensure [:activity/validate]} {:db/id "step-84fa05d5-af97-59d8-b33c-dd583737eabb" :step/id #uuid "84fa05d5-af97-59d8-b33c-dd583737eabb" :step/content 17592186167117 :step/next "step-e03d6f33-2586-5d57-a7b2-26ad674790fd" :db/ensure [:step/validate]} {:db/id "step-e03d6f33-2586-5d57-a7b2-26ad674790fd" :step/id #uuid "e03d6f33-2586-5d57-a7b2-26ad674790fd" :step/content "question-39f657eb-aa97-5394-b0e6-ecba3bf80018" :step/next "step-444842eb-2ff5-586c-acce-f30990803c2c" :db/ensure [:step/validate]} {:db/id "step-444842eb-2ff5-586c-acce-f30990803c2c" :step/id #uuid "444842eb-2ff5-586c-acce-f30990803c2c" :step/content 17592186167118 :step/next "step-f74c9cc2-11d5-584d-b43f-9184a7e00330" :db/ensure [:step/validate]} {:db/id "step-f74c9cc2-11d5-584d-b43f-9184a7e00330" :step/id #uuid "f74c9cc2-11d5-584d-b43f-9184a7e00330" :step/content "question-deb0627a-b1f4-5ecd-95e2-372ffa642f2c" :step/next "step-b32c5a3a-fa6d-50eb-94d9-f684a00e861d" :db/ensure [:step/validate]} {:db/id "step-b32c5a3a-fa6d-50eb-94d9-f684a00e861d" :step/id #uuid "b32c5a3a-fa6d-50eb-94d9-f684a00e861d" :step/content "question-2ad5265b-a872-53d0-b3f1-65585e111dd6" :db/ensure [:step/validate]} [:db/retract 17592186081071 :answer-field/choices 17592186081073] [:db/retract 17592186081071 :answer-field/choices 17592186081074] [:db/retract 17592186081071 :answer-field/choices 17592186081076] {:db/id 17592186083330 :knowledge-point/questions ["question-4852fb33-01b5-53c1-bda9-9f68b5cdfa3b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083132 :question/problem "Calculate $\\textrm{LCM}(120, 90).$" :question/worked-solution "To find the lowest common multiple of two numbers, we first find the prime factorization of both numbers. \n\n- We start by finding the prime factorization of $120\\mathbin{:}$ \n\n![](images/fb/fb213f6ac09abbf31aacfdbfbd08b76dbea4199528abeb1c8041a73f0d7780ed.png)\n\nTherefore, $120 = 2^3 \\cdot 3 \\cdot 5.$\n\n- Next, we find the prime factorization of $90\\mathbin{:}$\n\n![](images/03/034b3fe25edb2741abb035b8ca71a3c499fe6fae1a5975b4241d6379b819f19e.png)\n\nTherefore, $90 = 2 \\cdot 3^2 \\cdot 5.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}120 & ={2}^{3}\\cdot 3\\cdot 5 \\\\ 90 & =2\\cdot {3}^{2}\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $3$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common multiple of $120$ and $90$ is \n\n$$\n\\textrm{LCM}(120, 90) = 2^3 \\cdot 3^2 \\cdot 5  = 360.\n$$" :db/ensure [:question/validate]} {:db/id 17592186083332 :knowledge-point/questions ["question-4dbbbcc8-62df-5e8e-bfa9-1313bcce5620" "question-ca4901aa-e3e7-56b2-8843-d65effed5ee5" "question-42ddf56f-a8d0-56db-815a-a130a857fd56" "question-02c3ac78-aa7f-5ad9-a0fe-7e15cb1f374c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083134 :question/problem "Calculate $\\textrm{LCM}(30, 33, 20).$" :question/worked-solution "To find the lowest common multiple of three numbers, we first find their prime factorizations. \n\n- We start by finding the prime factorization of $30\\mathbin{:}$\n\n![](images/31/312d8c33355fb36260cce172ab20bf907637528d0a5d04dc4dd1eceb59d765dd.png)\n\nTherefore, $30 = 2 \\cdot 3 \\cdot 5.$\n\n- Next, we find the prime factorization of $33.$ We easily deduce that $33 = 3 \\cdot 11.$\n\n- Then, we find the prime factorization of $20{:}$\n\n![](images/7e/7e03a139fc3afa7df4d7f32ecf42f8f30d19bfe0415725f47fe5be63301899b5.png)\n\nTherefore, $20=2^2 \\cdot 5 .$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}30 & =2\\cdot 3\\cdot 5 \\\\ 33 & =3\\cdot 11 \\\\ 20 & ={2}^{2}\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in any of the factorizations:\n\n- the highest power of $2$ is $2$\n\n- the highest power of $3$ is $1$\n\n- the highest power of $5$ is $1$\n\n- the highest power of $11$ is $1$\n\nTherefore, the lowest  common multiple of $30$, $33,$ and $20$ is \n\n$$\n\\textrm{LCM}(30,  33, 20) = 2^2 \\cdot 3 \\cdot 5 \\cdot 11  = 660.\n$$" :db/ensure [:question/validate]} {:db/id 17592186083331 :knowledge-point/questions ["question-dc2e2da4-0526-5cbb-b99c-ff4e18d482b4" "question-2e11aa68-986c-58e0-bcdf-2852036febc7"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186083133 :question/problem "Find the lowest common denominator of $\\dfrac{4}{45}$ and $\\dfrac{7}{48}.$" :question/worked-solution "The lowest common denominator of two fractions is the least common multiple of the denominators.\n\nSo, to find the lowest common denominator of two fractions, we first find the prime factorization of both denominators.\n\n- We start by finding the prime factorization of $45\\mathbin{:}$\n\n![](images/5e/5e53857c25c4b7fd8dd1897dcd1b0608e48512d5a61a200a11a3f8a0ca92fcd2.png)\n\nTherefore, $45= 3^2 \\cdot 5.$\n\n- Next, we find the prime factorization of $48{:}$\n\n![](images/e2/e21d5cf36f2f08fbbb46e1d923d84e0b02f10531c42c590ab7d3a813f34009dc.png)\n\nTherefore, $48 = 2^4 \\cdot 3.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}45 & ={3}^{2}\\cdot 5 \\\\ 48 & ={2}^{4}\\cdot 3\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $4$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common denominator is $2^4\\cdot 3^2 \\cdot 5 = 720.$" :db/ensure [:question/validate]} {:db/id 17592186083690 :question/problem "$\\text{LCM}(98,175)=$" :question/worked-solution "To find the lowest common multiple of two numbers, we first find the prime factorization of both numbers. \n\n- We start by finding the prime factorization of $98:$ \n\n![](images/c7/c74979d4af6e34328dca1fab75fbf07c138c28ec8b93d5462d889f08ac6ea6c0.png)\n\nTherefore, $98=2\\cdot {7}^{2}.$\n\n- Next, we find the prime factorization of $175:$\n\n![](images/56/56e885903dd09097a256b6740f7f6307ba2af3c0e43f32bb6456745acfb3e777.png)\n\n \nTherefore, $175=7\\cdot {5}^{2}.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}98 & =2\\cdot {7}^{2} \\\\ 175 & =7\\cdot {5}^{2}\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $1$\n\n- the highest power of $7$ is $2$\n\n- the highest power of $5$ is $2$\n\nTherefore, the lowest common multiple of $98$ and $175$ is \n\n$$\n\\text{LCM}(98,175)=2\\cdot {5}^{2}\\cdot {7}^{2}=2\\,450.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186081071 :answer-field/correct "answer-e24b5eac-3f91-5144-8391-b6b9afa76ce7" :answer-field/choices ["answer-27b02112-73bf-53d0-a6f3-e65099f6f3b0" "answer-e24b5eac-3f91-5144-8391-b6b9afa76ce7" "answer-8bcce3aa-fa33-5496-98f8-707499c7ea27"] :db/ensure [:answer-field/validate]} {:db/id "answer-27b02112-73bf-53d0-a6f3-e65099f6f3b0" :answer/id #uuid "27b02112-73bf-53d0-a6f3-e65099f6f3b0" :answer/type :answer.type/math :answer/value "17\\,150" :db/ensure [:answer/validate]} {:db/id "answer-e24b5eac-3f91-5144-8391-b6b9afa76ce7" :answer/id #uuid "e24b5eac-3f91-5144-8391-b6b9afa76ce7" :answer/type :answer.type/math :answer/value "2\\,450" :db/ensure [:answer/validate]} {:db/id "answer-8bcce3aa-fa33-5496-98f8-707499c7ea27" :answer/id #uuid "8bcce3aa-fa33-5496-98f8-707499c7ea27" :answer/type :answer.type/math :answer/value "3\\,430" :db/ensure [:answer/validate]} {:db/id "question-4852fb33-01b5-53c1-bda9-9f68b5cdfa3b" :question/id #uuid "4852fb33-01b5-53c1-bda9-9f68b5cdfa3b" :question/math-academy-id "q-7552" :question/problem "Find $\\text{LCM}(7,19).$" :question/worked-solution "To find the lowest common multiple of two numbers, we first find the prime factorization of both numbers. Since the numbers $7$ and $19$ are prime numbers, they are already each their respective prime factorizations. \n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $7$ is $1$\n\n- the highest power of $19$ is $1$\n\nTherefore, the lowest common multiple of $7$ and $19$ is \n\n$$\n\\text{LCM}(7,19)={7}^{1}\\cdot {19}^{1}=133.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-edc669d6-a463-5d7f-9ce0-46adbba25422"] :db/ensure [:question/validate]} {:db/id "answer-field-edc669d6-a463-5d7f-9ce0-46adbba25422" :answer-field/id #uuid "edc669d6-a463-5d7f-9ce0-46adbba25422" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0ed9cd57-4b02-5908-8d06-8ffc9f86333b" :answer-field/choices ["answer-c8f508c8-2623-5426-b449-8c9f9803caaf" "answer-0ed9cd57-4b02-5908-8d06-8ffc9f86333b" "answer-0846cba1-214f-563e-8599-5c89551c8b0c" "answer-0a872d5e-744c-5b09-8f5b-a437fac96cbd" "answer-e7c0e6ae-fd29-509e-9ab4-335ce87e85cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8f508c8-2623-5426-b449-8c9f9803caaf" :answer/id #uuid "c8f508c8-2623-5426-b449-8c9f9803caaf" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-0ed9cd57-4b02-5908-8d06-8ffc9f86333b" :answer/id #uuid "0ed9cd57-4b02-5908-8d06-8ffc9f86333b" :answer/type :answer.type/math :answer/value "133" :db/ensure [:answer/validate]} {:db/id "answer-0846cba1-214f-563e-8599-5c89551c8b0c" :answer/id #uuid "0846cba1-214f-563e-8599-5c89551c8b0c" :answer/type :answer.type/math :answer/value "19" :db/ensure [:answer/validate]} {:db/id "answer-0a872d5e-744c-5b09-8f5b-a437fac96cbd" :answer/id #uuid "0a872d5e-744c-5b09-8f5b-a437fac96cbd" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "answer-e7c0e6ae-fd29-509e-9ab4-335ce87e85cc" :answer/id #uuid "e7c0e6ae-fd29-509e-9ab4-335ce87e85cc" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-4dbbbcc8-62df-5e8e-bfa9-1313bcce5620" :question/id #uuid "4dbbbcc8-62df-5e8e-bfa9-1313bcce5620" :question/math-academy-id "q-43578" :question/problem "Find $\\text{LCM}(14,18,63).$" :question/worked-solution "To find the lowest common multiple of three numbers, we first find their prime factorizations. \n\n- We start by finding the prime factorization of $14.$ We easily deduce that $14=2\\cdot 7.$\n\n- Next, we find the prime factorization of $18:$\n\n![](images/9e/9e7bddde8a287f6224b3e79f9fdacc3ac22d6db5a021b85df287e5e5fa321932.png)\n\nTherefore, $18=2\\cdot {3}^{2}.$\n\n- Then, we find the prime factorization of $63:$\n\n![](images/93/936a74a3795c2a8ace97dfddd7d4f2f359acf8968ea4404c2711abb96d6a708d.png)\n\nTherefore, $63={3}^{2}\\cdot 7.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}14 & =2\\cdot 7 \\\\ 18 & =2\\cdot {3}^{2} \\\\ 63 & ={3}^{2}\\cdot 7\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in any of the factorizations:\n\n- the highest power of $2$ is $1$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $7$ is $1$\n\nTherefore, the lowest  common multiple of $14$, $18$  and $63$ is \n\n$$\n\\text{LCM}(14,18,63)=2\\cdot {3}^{2}\\cdot 7=126.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9aaee9a9-a0c6-5744-af19-527966bede62"] :db/ensure [:question/validate]} {:db/id "answer-field-9aaee9a9-a0c6-5744-af19-527966bede62" :answer-field/id #uuid "9aaee9a9-a0c6-5744-af19-527966bede62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-45483506-27c3-5ae9-8704-9dc0742e2cc6" :answer-field/choices ["answer-b2f292a0-88e2-51db-95f0-221bcd492aa8" "answer-45483506-27c3-5ae9-8704-9dc0742e2cc6" "answer-b849f137-a327-5c14-b839-abf99bfd6ca0" "answer-1ba87deb-540d-521e-8013-35015385eaef" "answer-fb695631-d174-5692-b860-0ed0a35a3232"] :db/ensure [:answer-field/validate]} {:db/id "answer-b2f292a0-88e2-51db-95f0-221bcd492aa8" :answer/id #uuid "b2f292a0-88e2-51db-95f0-221bcd492aa8" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "answer-45483506-27c3-5ae9-8704-9dc0742e2cc6" :answer/id #uuid "45483506-27c3-5ae9-8704-9dc0742e2cc6" :answer/type :answer.type/math :answer/value "126" :db/ensure [:answer/validate]} {:db/id "answer-b849f137-a327-5c14-b839-abf99bfd6ca0" :answer/id #uuid "b849f137-a327-5c14-b839-abf99bfd6ca0" :answer/type :answer.type/math :answer/value "15\\,876" :db/ensure [:answer/validate]} {:db/id "answer-1ba87deb-540d-521e-8013-35015385eaef" :answer/id #uuid "1ba87deb-540d-521e-8013-35015385eaef" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-fb695631-d174-5692-b860-0ed0a35a3232" :answer/id #uuid "fb695631-d174-5692-b860-0ed0a35a3232" :answer/type :answer.type/math :answer/value "5\\,292" :db/ensure [:answer/validate]} {:db/id "question-ca4901aa-e3e7-56b2-8843-d65effed5ee5" :question/id #uuid "ca4901aa-e3e7-56b2-8843-d65effed5ee5" :question/math-academy-id "q-103752" :question/problem "$\\text{LCM}(10,24,18)=$" :question/worked-solution "To find the lowest common multiple of three numbers, we first find their prime factorizations. \n\n- We start by finding the prime factorization of $10.$ We easily deduce that $10=2\\cdot 5.$\n\n- Next, we find the prime factorization of $24:$\n\n![](images/cb/cbf192e5a1a1b1ac9db41bb9c8427ff8cdebeb697bcb618da87689a628b8f3af.png)\n\nTherefore, $24={2}^{3}\\cdot 3.$\n\n- Then, we find the prime factorization of $18:$\n\n![](images/9e/9e7bddde8a287f6224b3e79f9fdacc3ac22d6db5a021b85df287e5e5fa321932.png)\n\nTherefore, $18=2\\cdot {3}^{2}.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}10 & =2\\cdot 5 \\\\ 24 & ={2}^{3}\\cdot 3 \\\\ 18 & =2\\cdot {3}^{2}\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in any of the factorizations:\n\n- the highest power of $2$ is $3$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest  common multiple of $10$, $24$  and $18$ is \n\n$$\n\\text{LCM}(10,24,18)={2}^{3}\\cdot {3}^{2}\\cdot 5=360.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-6780f3c1-8bb2-5d48-8249-7e065b893a9a"] :db/ensure [:question/validate]} {:db/id "answer-field-6780f3c1-8bb2-5d48-8249-7e065b893a9a" :answer-field/id #uuid "6780f3c1-8bb2-5d48-8249-7e065b893a9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a322ca59-ae9a-5cf6-b2dc-d28a1cafe22a" :answer-field/choices ["answer-101e44af-5ace-574c-a1d0-fa42e082d523" "answer-94911273-8765-5693-81d8-1a95eca7aa49" "answer-a322ca59-ae9a-5cf6-b2dc-d28a1cafe22a" "answer-153825bb-db72-51ad-90ce-00c1c61b6419" "answer-be216a86-6160-59dd-979a-0c2885d7a008"] :db/ensure [:answer-field/validate]} {:db/id "answer-101e44af-5ace-574c-a1d0-fa42e082d523" :answer/id #uuid "101e44af-5ace-574c-a1d0-fa42e082d523" :answer/type :answer.type/math :answer/value "180" :db/ensure [:answer/validate]} {:db/id "answer-94911273-8765-5693-81d8-1a95eca7aa49" :answer/id #uuid "94911273-8765-5693-81d8-1a95eca7aa49" :answer/type :answer.type/math :answer/value "240" :db/ensure [:answer/validate]} {:db/id "answer-a322ca59-ae9a-5cf6-b2dc-d28a1cafe22a" :answer/id #uuid "a322ca59-ae9a-5cf6-b2dc-d28a1cafe22a" :answer/type :answer.type/math :answer/value "360" :db/ensure [:answer/validate]} {:db/id "answer-153825bb-db72-51ad-90ce-00c1c61b6419" :answer/id #uuid "153825bb-db72-51ad-90ce-00c1c61b6419" :answer/type :answer.type/math :answer/value "520" :db/ensure [:answer/validate]} {:db/id "answer-be216a86-6160-59dd-979a-0c2885d7a008" :answer/id #uuid "be216a86-6160-59dd-979a-0c2885d7a008" :answer/type :answer.type/math :answer/value "720" :db/ensure [:answer/validate]} {:db/id "question-42ddf56f-a8d0-56db-815a-a130a857fd56" :question/id #uuid "42ddf56f-a8d0-56db-815a-a130a857fd56" :question/math-academy-id "q-171159" :question/problem "$\\text{LCM}(9,15,2)=${{field-1}}" :question/worked-solution "To find the lowest common multiple of three numbers, we first find their prime factorizations. \n\n- First, we find the prime factorization of $9.$ We easily deduce that $9={3}^{2}.$\n\n- Next, we find the prime factorization of $15.$ We easily deduce that $15=3\\times 5.$\n\n- Then, we notice that $2$ is a prime number.\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}9 & ={3}^{2} \\\\ 15 & =3\\times 5 \\\\ 2 & =2\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in any of the factorizations:\n\n- the highest power of $2$ is $1$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common multiple of $9$, $15,$ and $2$ is \n\n$$\n\\text{LCM}(9,15,2)=2\\cdot {3}^{2}\\cdot 5=90.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-962cde6c-5ec7-5c5b-8f76-f152a51a0365"] :db/ensure [:question/validate]} {:db/id "answer-field-962cde6c-5ec7-5c5b-8f76-f152a51a0365" :answer-field/id #uuid "962cde6c-5ec7-5c5b-8f76-f152a51a0365" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d3059e99-3f5b-5844-8f15-e388da08df46" :answer-field/choices ["answer-d3059e99-3f5b-5844-8f15-e388da08df46"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3059e99-3f5b-5844-8f15-e388da08df46" :answer/id #uuid "d3059e99-3f5b-5844-8f15-e388da08df46" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "question-02c3ac78-aa7f-5ad9-a0fe-7e15cb1f374c" :question/id #uuid "02c3ac78-aa7f-5ad9-a0fe-7e15cb1f374c" :question/math-academy-id "q-103757" :question/problem "Find $\\text{LCM}(21,28,24).$" :question/worked-solution "To find the lowest common multiple of three numbers, we first find their prime factorizations. \n\n- We start by finding the prime factorization of $21.$ We easily deduce that $21=3\\cdot 7.$\n\n- Next, we find the prime factorization of $28:$\n\n![](images/50/502509ed3e4392c8c4e3e8fa0b0e579c096f0b04108091f4d18a6f0e5a879e2a.png)\n\nTherefore, $28={2}^{2}\\cdot 7.$\n\n- Then, we find the prime factorization of $24:$\n\n![](images/cb/cbf192e5a1a1b1ac9db41bb9c8427ff8cdebeb697bcb618da87689a628b8f3af.png)\n\nTherefore, $24={2}^{3}\\cdot 3.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}21 & =3\\cdot 7 \\\\ 28 & ={2}^{2}\\cdot 7 \\\\ 24 & ={2}^{3}\\cdot 3\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in any of the factorizations:\n\n- the highest power of $2$ is $3$\n\n- the highest power of $3$ is $1$\n\n- the highest power of $7$ is $1$\n\nTherefore, the lowest  common multiple of $21$, $28$  and $24$ is \n\n$$\n\\text{LCM}(21,28,24)={2}^{3}\\cdot 3\\cdot 7=168.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-18e368ac-fe03-5c17-807d-d222cefea5d0"] :db/ensure [:question/validate]} {:db/id "answer-field-18e368ac-fe03-5c17-807d-d222cefea5d0" :answer-field/id #uuid "18e368ac-fe03-5c17-807d-d222cefea5d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e1a3665-6da0-5251-8b45-125c7b0fd9de" :answer-field/choices ["answer-9e1a3665-6da0-5251-8b45-125c7b0fd9de" "answer-29920851-d467-5ee4-9754-7b67397f2e1e" "answer-7ded99be-3eaf-5777-87dd-8069bd8425e6" "answer-7c2c2270-7339-5263-a54c-414a758d0150" "answer-5c8eb52c-546b-53cb-8238-568688e02eef"] :db/ensure [:answer-field/validate]} {:db/id "answer-9e1a3665-6da0-5251-8b45-125c7b0fd9de" :answer/id #uuid "9e1a3665-6da0-5251-8b45-125c7b0fd9de" :answer/type :answer.type/math :answer/value "168" :db/ensure [:answer/validate]} {:db/id "answer-29920851-d467-5ee4-9754-7b67397f2e1e" :answer/id #uuid "29920851-d467-5ee4-9754-7b67397f2e1e" :answer/type :answer.type/math :answer/value "252" :db/ensure [:answer/validate]} {:db/id "answer-7ded99be-3eaf-5777-87dd-8069bd8425e6" :answer/id #uuid "7ded99be-3eaf-5777-87dd-8069bd8425e6" :answer/type :answer.type/math :answer/value "504" :db/ensure [:answer/validate]} {:db/id "answer-7c2c2270-7339-5263-a54c-414a758d0150" :answer/id #uuid "7c2c2270-7339-5263-a54c-414a758d0150" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "answer-5c8eb52c-546b-53cb-8238-568688e02eef" :answer/id #uuid "5c8eb52c-546b-53cb-8238-568688e02eef" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "question-dc2e2da4-0526-5cbb-b99c-ff4e18d482b4" :question/id #uuid "dc2e2da4-0526-5cbb-b99c-ff4e18d482b4" :question/math-academy-id "q-7554" :question/problem "Find the lowest common denominator of $\\frac{2}{5}$ and $\\frac{8}{11}.$" :question/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators. \n\nSince the denominators $5$ and $11$ are prime numbers, they are already represented by their respective prime factorizations. \n\nNow, we write down each prime factor, and we raise each factor to the highest power given in either factorization:\n\n- the highest power of $5$ is $1$\n\n- the highest power of $11$ is also $1$\n\nTherefore, the lowest common denominator is ${5}^{1}\\cdot {11}^{1}=55.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4a56c089-3496-5ced-98ed-177d54b87aa0"] :db/ensure [:question/validate]} {:db/id "answer-field-4a56c089-3496-5ced-98ed-177d54b87aa0" :answer-field/id #uuid "4a56c089-3496-5ced-98ed-177d54b87aa0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-70785a40-9f68-59a0-a962-71a1ac609b06" :answer-field/choices ["answer-be32ecf2-6799-5674-a380-2b7c08c1f88e" "answer-0fe71c82-b6c4-51cf-b985-aa0b95b275ef" "answer-961c6f7b-ffd8-5b18-9ce1-53f8a971ffd7" "answer-70785a40-9f68-59a0-a962-71a1ac609b06" "answer-88d14389-f858-5c64-8688-9b858b1bb194"] :db/ensure [:answer-field/validate]} {:db/id "answer-be32ecf2-6799-5674-a380-2b7c08c1f88e" :answer/id #uuid "be32ecf2-6799-5674-a380-2b7c08c1f88e" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-0fe71c82-b6c4-51cf-b985-aa0b95b275ef" :answer/id #uuid "0fe71c82-b6c4-51cf-b985-aa0b95b275ef" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-961c6f7b-ffd8-5b18-9ce1-53f8a971ffd7" :answer/id #uuid "961c6f7b-ffd8-5b18-9ce1-53f8a971ffd7" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-70785a40-9f68-59a0-a962-71a1ac609b06" :answer/id #uuid "70785a40-9f68-59a0-a962-71a1ac609b06" :answer/type :answer.type/math :answer/value "55" :db/ensure [:answer/validate]} {:db/id "answer-88d14389-f858-5c64-8688-9b858b1bb194" :answer/id #uuid "88d14389-f858-5c64-8688-9b858b1bb194" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-2e11aa68-986c-58e0-bcdf-2852036febc7" :question/id #uuid "2e11aa68-986c-58e0-bcdf-2852036febc7" :question/math-academy-id "q-7317" :question/problem "Find the lowest common denominator of $\\frac{11}{30}$ and $\\frac{19}{64}.$" :question/worked-solution "To find the lowest common denominator of two fractions, we first find the prime factorization of both denominators.\n\n- We start by finding the prime factorization of $30:$\n\n![](images/31/312d8c33355fb36260cce172ab20bf907637528d0a5d04dc4dd1eceb59d765dd.png)\n\nTherefore, $30=2\\cdot 3\\cdot 5.$\n\n- Next, we find the prime factorization of $64:$\n\n![](images/44/447dca25b6cd3e19abd115869dac18c66b6066a37ef6181b4ac68e478aafb0b8.png)\n\nTherefore, $64={2}^{6}.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}30 & =2\\cdot 3\\cdot 5 \\\\ 64 & ={2}^{6}\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $6$\n\n- the highest power of $3$ is $1$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common denominator is ${2}^{6}\\cdot 3\\cdot 5=960.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-727d9f99-59b5-57e0-acfe-f77120569223"] :db/ensure [:question/validate]} {:db/id "answer-field-727d9f99-59b5-57e0-acfe-f77120569223" :answer-field/id #uuid "727d9f99-59b5-57e0-acfe-f77120569223" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac29b778-5c98-56c7-b58e-e5939e06fb60" :answer-field/choices ["answer-56a59234-02a6-5ffb-861d-20a6d3123bb4" "answer-849c6e56-e751-5252-952f-3302adb354ba" "answer-499c5d09-2f7f-51d6-82b6-ddaf516d1430" "answer-db9cc569-ed07-58d2-a31c-6b23e8a5cefd" "answer-ac29b778-5c98-56c7-b58e-e5939e06fb60"] :db/ensure [:answer-field/validate]} {:db/id "answer-56a59234-02a6-5ffb-861d-20a6d3123bb4" :answer/id #uuid "56a59234-02a6-5ffb-861d-20a6d3123bb4" :answer/type :answer.type/math :answer/value "128" :db/ensure [:answer/validate]} {:db/id "answer-849c6e56-e751-5252-952f-3302adb354ba" :answer/id #uuid "849c6e56-e751-5252-952f-3302adb354ba" :answer/type :answer.type/math :answer/value "1\\,920" :db/ensure [:answer/validate]} {:db/id "answer-499c5d09-2f7f-51d6-82b6-ddaf516d1430" :answer/id #uuid "499c5d09-2f7f-51d6-82b6-ddaf516d1430" :answer/type :answer.type/math :answer/value "580" :db/ensure [:answer/validate]} {:db/id "answer-db9cc569-ed07-58d2-a31c-6b23e8a5cefd" :answer/id #uuid "db9cc569-ed07-58d2-a31c-6b23e8a5cefd" :answer/type :answer.type/math :answer/value "640" :db/ensure [:answer/validate]} {:db/id "answer-ac29b778-5c98-56c7-b58e-e5939e06fb60" :answer/id #uuid "ac29b778-5c98-56c7-b58e-e5939e06fb60" :answer/type :answer.type/math :answer/value "960" :db/ensure [:answer/validate]} {:db/id 17592186084484 :tutorial/content "The **lowest common multiple** (or $\\textrm{LCM}$) of two integers is the smallest multiple that's common to both numbers.\n\nTo find the lowest common multiple of two small numbers, we can list all multiples of the two numbers and identify the smallest multiple that they have in common.\n\nFor example, let's find the lowest common multiple of $4$ and $6.$ We start by listing all multiples of $4$ and $6\\mathbin{:}$\n\n$$\n\\begin{aligned}4 & \\,\\to \\,4,\\,8,\\,\\boxed{\\text{[math]12[/math]}},\\,16,\\,20,\\,24,\\,… \\\\ 6 & \\,\\to \\,6,\\,\\boxed{\\text{[math]12[/math]}},\\,18,\\,24,\\,30,\\,36,\\,…\\end{aligned}\n$$\n\nThe smallest multiple in both lists is ![](images/92/9285d37c7b455395acb42a54f78348bedfd8c9a72ad63d6e6ab7c2426148ea0d.svg) So $12$ is our answer, and we can write\n\n$$\n\\textrm{LCM}(4,6)= 12.\n$$\n\n**Note:** The lowest common multiple is also sometimes called the *least* common multiple." :db/ensure [:tutorial/validate]} {:db/id 17592186084485 :tutorial/content "Now suppose that we want to find the lowest common multiple of two larger numbers. It would take a while to make long lists of multiples. Luckily, there is a faster method. \n\nLet's demonstrate by finding $\\textrm{LCM}(10,12).$ We start by writing the prime factorization of $10$ and $12$, writing any repeating factors as powers:\n\n$$\n\\begin{aligned}10 & =2\\cdot 5={2}^{1}\\cdot {5}^{1} \\\\ 12 & =2\\cdot 2\\cdot 3={2}^{2}\\cdot {3}^{1}\\end{aligned}\n$$\n\nThen, we write down each unique prime factor that appears in either of our decompositions. In our case, the unique prime factors are \n\n$$\n{\\color{red}2}, \\qquad {\\color{red}3}, \\qquad {\\color{red}5}.\n$$\n\nNow, for each number in our list, we look at *both* prime factorizations and we take the *largest* power shown for each prime factor:\n\n- The factors corresponding to ${\\color{red}2}$ are ${\\color{red}2}^{\\color{blue}1}$ and ${\\color{red}2}^{\\color{blue}2}.$ Of these, the larger power is ${\\color{red}2}^{\\color{blue}2}.$\n\n- There is only one factor corresponding to ${\\color{red}3}.$ It is ${\\color{red}3}^{\\color{blue}1}.$\n\n- There is only one factor corresponding to ${\\color{red}5}.$ It is ${\\color{red}5}^{\\color{blue}1}.$\n\nFinally, we multiply the largest powers of each factor together, and we get\n\n$$\n\\begin{aligned}\\text{LCM}(10,12) & ={2}^{2}\\cdot {3}^{1}\\cdot {5}^{1} \\\\  & =4\\cdot 3\\cdot 5 \\\\  & =60.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186083445 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]}]
