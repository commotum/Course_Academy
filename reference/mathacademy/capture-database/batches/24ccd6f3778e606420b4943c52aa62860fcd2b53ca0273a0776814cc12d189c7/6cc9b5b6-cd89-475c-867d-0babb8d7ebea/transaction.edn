-field/validate]} {:db/id "answer-58805847-e5ac-5345-89bb-b21c27b57781" :answer/id #uuid "58805847-e5ac-5345-89bb-b21c27b57781" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-0ac1c35a-bafe-5ad3-b28d-d8b0ce41d37e" :answer/id #uuid "0ac1c35a-bafe-5ad3-b28d-d8b0ce41d37e" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-4a2b7bc8-41fc-550c-b56c-d1d9568a0eb7" :answer/id #uuid "4a2b7bc8-41fc-550c-b56c-d1d9568a0eb7" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-7e1bf146-5664-5571-a9a3-eb3c65161d88" :answer/id #uuid "7e1bf146-5664-5571-a9a3-eb3c65161d88" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-627534d8-9259-57c6-8e45-94a1948f847d" :answer/id #uuid "627534d8-9259-57c6-8e45-94a1948f847d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/id #uuid "6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" :question/math-academy-id "q-85131" :question/problem "Find the maximum value of the parabola $y=-4(x+5)^{2}-3.$" :question/worked-solution "The maximum value of the parabola is the $y$-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n$$\ny=a(x-h)^{2}+k\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-4(x+5)^{2}-3\n$$\n\nis written in vertex form with $h=-5$ and $k=-3.$ Therefore, the vertex of the parabola is at $(-5,-3),$ and its maximum value is $-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-215a268f-4f2f-5250-bcca-1acc469f1269"] :db/ensure [:question/validate]} {:db/id "answer-field-215a268f-4f2f-5250-bcca-1acc469f1269" :answer-field/id #uuid "215a268f-4f2f-5250-bcca-1acc469f1269" :answer-field/key "selection" :answer-field/type :answer-field.type/r