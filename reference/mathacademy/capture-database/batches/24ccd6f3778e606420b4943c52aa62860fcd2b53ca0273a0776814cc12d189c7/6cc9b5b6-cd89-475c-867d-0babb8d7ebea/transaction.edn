4cc-dafd-5f8b-8aa0-2030bb110523" :db/ensure [:step/validate]} {:db/id "step-668b84cc-dafd-5f8b-8aa0-2030bb110523" :step/id #uuid "668b84cc-dafd-5f8b-8aa0-2030bb110523" :step/content 17592186345238 :step/next "step-c6c7fb69-3617-59d6-9f6f-a15065e9e0d0" :db/ensure [:step/validate]} {:db/id "step-c6c7fb69-3617-59d6-9f6f-a15065e9e0d0" :step/id #uuid "c6c7fb69-3617-59d6-9f6f-a15065e9e0d0" :step/content 17592186345246 :step/next "step-4e2e4bc0-1e8a-5113-b6e3-7585d391d8f4" :db/ensure [:step/validate]} {:db/id "step-4e2e4bc0-1e8a-5113-b6e3-7585d391d8f4" :step/id #uuid "4e2e4bc0-1e8a-5113-b6e3-7585d391d8f4" :step/content 17592186345253 :step/next "step-f2218919-fc6a-5a1a-8a3c-12c86b990a4d" :db/ensure [:step/validate]} {:db/id "step-f2218919-fc6a-5a1a-8a3c-12c86b990a4d" :step/id #uuid "f2218919-fc6a-5a1a-8a3c-12c86b990a4d" :step/content 17592186284544 :db/ensure [:step/validate]} {:db/id 17592186092261 :knowledge-point/questions ["question-0876dfcc-e11e-5c1c-a9e0-0c7b6f68915a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0876dfcc-e11e-5c1c-a9e0-0c7b6f68915a" :question/id #uuid "0876dfcc-e11e-5c1c-a9e0-0c7b6f68915a" :question/math-academy-id "q-1951" :question/problem "If $f(x)={4}^{7x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={4}^{u},\\,u=7x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={4}^{u}\\operatorname{ln}⁡4,\\,\\frac{\\text{d}u}{\\text{d}x}=7.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =7\\cdot {4}^{u}\\operatorname{ln}⁡4 \\\\  & =7\\operatorname{ln}⁡4\\cdot {4}^{u} \\\\  & =7\\operatorname{ln}⁡4\\cdot {4}^{7x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-bc0be4a0-ce70-5992-8eed-814e9a761b79"] :db/ensure [:question/validate]} {:db/id "answer-field-bc0be4a0-ce70-5992-8eed-814e9a761b79" :answer-field/id #uuid "bc0be4a0-ce70-5992-8eed-814e9a761b79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" :answer-field/choices ["answer-38229b23-2b39-59e5-9abd-c6c07d94e182" "answer-b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" "answer-78c9ae9f-b6bd-5e2b-a491-13f9286f6a11" "answer-799b33bd-f993-5922-93a7-8e0d15933029" "answer-7ccc347a-a561-5923-a18e-8613311aa3f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-38229b23-2b39-59e5-9abd-c6c07d94e182" :answer/id #uuid "38229b23-2b39-59e5-9abd-c6c07d94e182" :answer/type :answer.type/math :answer/value "7\\cdot {4}^{7x}" :db/ensure [:answer/validate]} {:db/id "answer-b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" :answer/id #uuid "b13acdb7-c3c6-501a-bb40-9e3bfb33ea7a" :answer/type :answer.type/math :answer/value "7\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/ensure [:answer/validate]} {:db/id "answer-78c9ae9f-b6bd-5e2b-a491-13f9286f6a11" :answer/id #uuid "78c9ae9f-b6bd-5e2b-a491-13f9286f6a11" :answer/type :answer.type/math :answer/value "7x" :db/ensure [:answer/validate]} {:db/id "answer-799b33bd-f993-5922-93a7-8e0d15933029" :answer/id #uuid "799b33bd-f993-5922-93a7-8e0d15933029" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡4\\cdot {4}^{7x}" :db/ensure [:answer/validate]} {:db/id "answer-7ccc347a-a561-5923-a18e-8613311aa3f2" :answer/id #uuid "7ccc347a-a561-5923-a18e-8613311aa3f2" :answer/type :answer.type/math :answer/value "{4}^{7x}" :db/ensure [:answer/validate]} {:db/id 17592186092263 :knowledge-point/questions ["question-2f55f57b-ca3e-54c4-9349-d3c4559745cd"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2f55f57b-ca3e-54c4-9349-d3c4559745cd" :question/id #uuid "2f55f57b-ca3e-54c4-9349-d3c4559745cd" :question/math-academy-id "q-71877" :question/problem "Find ${f}^{′}(x)$ for $f(x)={e}^{2{x}^{4}+3}.$" :question/worked-solution "First we express $f(x)$ as the composite function\n\n$$\nf={e}^{u},\\,u=2{x}^{4}+3.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=8{x}^{3}.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (8{x}^{3}) \\\\  & =8{x}^{3}{e}^{u} \\\\  & =8{x}^{3}{e}^{2{x}^{4}+3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-018265d8-4b38-5450-a523-ac3f8812815c"] :db/ensure [:question/validate]} {:db/id "answer-field-018265d8-4b38-5450-a523-ac3f8812815c" :answer-field/id #uuid "018265d8-4b38-5450-a523-ac3f8812815c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-699ef952-cd7a-5cde-b182-3f4d9a8b1d58" :answer-field/choices ["answer-ca809957-cb8d-5918-bf34-5e74f50b4780" "answer-7b4af48c-3147-5fd2-ba59-b1551123c8c3" "answer-f16911d4-15e8-5cbf-a535-476b2410db5b" "answer-699ef952-cd7a-5cde-b182-3f4d9a8b1d58" "answer-2dbe0539-4fe2-5131-9a91-4a158b45aa23"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca809957-cb8d-5918-bf34-5e74f50b4780" :answer/id #uuid "ca809957-cb8d-5918-bf34-5e74f50b4780" :answer/type :answer.type/math :answer/value "5{x}^{2}{e}^{2{x}^{4}+5}" :db/ensure [:answer/validate]} {:db/id "answer-7b4af48c-3147-5fd2-ba59-b1551123c8c3" :answer/id #uuid "7b4af48c-3147-5fd2-ba59-b1551123c8c3" :answer/type :answer.type/math :answer/value "8x{e}^{2x+3}" :db/ensure [:answer/validate]} {:db/id "answer-f16911d4-15e8-5cbf-a535-476b2410db5b" :answer/id #uuid "f16911d4-15e8-5cbf-a535-476b2410db5b" :answer/type :answer.type/math :answer/value "8x{e}^{6{x}^{4}+1}" :db/ensure [:answer/validate]} {:db/id "answer-699ef952-cd7a-5cde-b182-3f4d9a8b1d58" :answer/id #uuid "699ef952-cd7a-5cde-b182-3f4d9a8b1d58" :answer/type :answer.type/math :answer/value "8{x}^{3}{e}^{2{x}^{4}+3}" :db/ensure [:answer/validate]} {:db/id "answer-2dbe0539-4fe2-5131-9a91-4a158b45aa23" :answer/id #uuid "2dbe0539-4fe2-5131-9a91-4a158b45aa23" :answer/type :answer.type/math :answer/value "x{e}^{{x}^{4}+3}" :db/ensure [:answer/validate]} {:db/id "activity-d99ecb5e-abe9-5c9f-a181-aa603fce82c4" :activity/id #uuid "d99ecb5e-abe9-5c9f-a181-aa603fce82c4" :activity/title "The Chain Rule With Exponential Functions" :activity/type :activity.type/review :activity/scope 17592186050271 :activity/course 17592186046647 :activity/steps ["step-d84d7d23-dca4-52c0-a782-75952a8d43b2" "step-01785848-3535-566c-8ed3-1625e925070f" "step-734de382-5fea-5f07-968d-7e70fd7866b9"] :activity/first-step "step-d84d7d23-dca4-52c0-a782-75952a8d43b2" :db/ensure [:activity/validate]} {:db/id "step-d84d7d23-dca4-52c0-a782-75952a8d43b2" :step/id #uuid "d84d7d23-dca4-52c0-a782-75952a8d43b2" :step/content "question-0876dfcc-e11e-5c1c-a9e0-0c7b6f68915a" :step/next "step-01785848-3535-566c-8ed3-1625e925070f" :db/ensure [:step/validate]} {:db/id "step-01785848-3535-566c-8ed3-1625e925070f" :step/id #uuid "01785848-3535-566c-8ed3-1625e925070f" :step/content 17592186092618 :step/next "step-734de382-5fea-5f07-968d-7e70fd7866b9" :db/ensure [:step/validate]} {:db/id "step-734de382-5fea-5f07-968d-7e70fd7866b9" :step/id #uuid "734de382-5fea-5f07-968d-7e70fd7866b9" :step/content "question-2f55f57b-ca3e-54c4-9349-d3c4559745cd" :db/ensure [:step/validate]} {:db/id 17592186138412 :knowledge-point/questions ["question-83badc2b-8d5f-5e16-ac2d-99f08799fac8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-83badc2b-8d5f-5e16-ac2d-99f08799fac8" :question/id #uuid "83badc2b-8d5f-5e16-ac2d-99f08799fac8" :question/math-academy-id "q-36118" :question/problem "Given that $6{x}^{6}-13{x}^{3}-8=(a{x}^{3}-8)(2{x}^{3}+b)$ where $a$ and $b$ are integers, find the value of $a+b.$" :question/worked-solution "We can introduce a new variable $z={x}^{3}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}6{x}^{6}-13{x}^{3}-8 & =6{({x}^{3})}^{2}-13({x}^{3})-8 \\\\  & =6{z}^{2}-13z-8\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $x:$\n\n$$\n\\begin{aligned}6{z}^{2}-13z-8 & =(3z-8)(2z+1) \\\\  & =(3{x}^{3}-8)(2{x}^{3}+1)\\end{aligned}\n$$\n\nSo, $a=3$, $b=1$ and $a+b=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e17d9c1f-8ee5-537e-b3b1-d2c3901fe469"] :db/ensure [:question/validate]} {:db/id "answer-field-e17d9c1f-8ee5-537e-b3b1-d2c3901fe469" :answer-field/id #uuid "e17d9c1f-8ee5-537e-b3b1-d2c3901fe469" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6104ac45-813f-58b4-ac8f-d09dee3b3225" :answer-field/choices ["answer-4e0b825f-4a74-5e95-93f5-65c968e0712c" "answer-ba648939-1b79-5eeb-a828-f3f413cc4458" "answer-6104ac45-813f-58b4-ac8f-d09dee3b3225" "answer-ce32916b-b0a6-5ccf-b2f8-98b980dc5c9b" "answer-7687c68f-49a8-5e6e-a462-3f65463165d9"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e0b825f-4a74-5e95-93f5-65c968e0712c" :answer/id #uuid "4e0b825f-4a74-5e95-93f5-65c968e0712c" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-ba648939-1b79-5eeb-a828-f3f413cc4458" :answer/id #uuid "ba648939-1b79-5eeb-a828-f3f413cc4458" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-6104ac45-813f-58b4-ac8f-d09dee3b3225" :answer/id #uuid "6104ac45-813f-58b4-ac8f-d09dee3b3225" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-ce32916b-b0a6-5ccf-b2f8-98b980dc5c9b" :answer/id #uuid "ce32916b-b0a6-5ccf-b2f8-98b980dc5c9b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-7687c68f-49a8-5e6e-a462-3f65463165d9" :answer/id #uuid "7687c68f-49a8-5e6e-a462-3f65463165d9" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id 17592186138411 :knowledge-point/questions ["question-64406c7a-8c8e-5992-a943-fe107c40272e" "question-b42f766f-91bf-5b16-b807-3079a315696b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-64406c7a-8c8e-5992-a943-fe107c40272e" :question/id #uuid "64406c7a-8c8e-5992-a943-fe107c40272e" :question/math-academy-id "q-44522" :question/problem "The trinomial ${p}^{4}+2{p}^{2}-15$ is equivalent to" :question/worked-solution "We can introduce a new variable $z={p}^{2}$ and then rewrite the trinomial as a quadratic in terms of $z:$\n\n$$\n\\begin{aligned}{p}^{4}+2{p}^{2}-15 & ={({p}^{2})}^{2}+2({p}^{2})-15 \\\\  & ={z}^{2}+2z-15\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $p:$\n\n$$\n\\begin{aligned}{z}^{2}+2z-15 & =(z-3)(z+5) \\\\  & =({p}^{2}-3)({p}^{2}+5)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1d0755e9-d2fb-51ff-9dfa-673f50f7bb0e"] :db/ensure [:question/validate]} {:db/id "answer-field-1d0755e9-d2fb-51ff-9dfa-673f50f7bb0e" :answer-field/id #uuid "1d0755e9-d2fb-51ff-9dfa-673f50f7bb0e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-44181e52-200e-59de-aaf9-e866eb6eb780" :answer-field/choices ["answer-648b3d26-e8d1-59d8-b354-1d025dedb54b" "answer-08b4bb42-2f07-5f22-b119-aaf61adfbab7" "answer-1c6d8972-4d89-5edb-aec9-dff3eb9542b9" "answer-44181e52-200e-59de-aaf9-e866eb6eb780" "answer-734627e7-449d-5d5e-926c-25142aeb544c"] :db/ensure [:answer-field/validate]} {:db/id "answer-648b3d26-e8d1-59d8-b354-1d025dedb54b" :answer/id #uuid "648b3d26-e8d1-59d8-b354-1d025dedb54b" :answer/type :answer.type/math :answer/value "(p-3){(p+5)}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-08b4bb42-2f07-5f22-b119-aaf61adfbab7" :answer/id #uuid "08b4bb42-2f07-5f22-b119-aaf61adfbab7" :answer/type :answer.type/math :answer/value "({p}^{2}+3)({p}^{2}-5)" :db/ensure [:answer/validate]} {:db/id "answer-1c6d8972-4d89-5edb-aec9-dff3eb9542b9" :answer/id #uuid "1c6d8972-4d89-5edb-aec9-dff3eb9542b9" :answer/type :answer.type/math :answer/value "({p}^{2}-10)({p}^{2}+5)" :db/ensure [:answer/validate]} {:db/id "answer-44181e52-200e-59de-aaf9-e866eb6eb780" :answer/id #uuid "44181e52-200e-59de-aaf9-e866eb6eb780" :answer/type :answer.type/math :answer/value "({p}^{2}-3)({p}^{2}+5)" :db/ensure [:answer/validate]} {:db/id "answer-734627e7-449d-5d5e-926c-25142aeb544c" :answer/id #uuid "734627e7-449d-5d5e-926c-25142aeb544c" :answer/type :answer.type/math :answer/value "{({p}^{2}+5)}^{2}" :db/ensure [:answer/validate]} {:db/id "question-b42f766f-91bf-5b16-b807-3079a315696b" :question/id #uuid "b42f766f-91bf-5b16-b807-3079a315696b" :question/math-academy-id "q-79490" :question/problem "Factor ${s}^{4}-{s}^{2}-12.$" :question/worked-solution "We can introduce a new variable $t={s}^{2}$ and then rewrite the trinomial as a quadratic in terms of $t:$\n\n$$\n\\begin{aligned}{s}^{4}-{s}^{2}-12 & ={({s}^{2})}^{2}-({s}^{2})-12 \\\\  & ={t}^{2}-t-12\\end{aligned}\n$$\n\nNow, we can factor the quadratic, and then rewrite the final expression in terms of $s:$\n\n$$\n\\begin{aligned}{t}^{2}-t-12 & =(t+3)(t-4) \\\\  & =({s}^{2}+3)({s}^{2}-4)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e4723b73-531b-5f98-acb4-18f8a476a36e"] :db/ensure [:question/validate]} {:db/id "answer-field-e4723b73-531b-5f98-acb4-18f8a476a36e" :answer-field/id #uuid "e4723b73-531b-5f98-acb4-18f8a476a36e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6fade646-27e9-5be0-ac21-3eaf8e4bd6f9" :answer-field/choices ["answer-55c7b825-4af3-56a2-afd0-44f6f67a9f69" "answer-7e0bd50e-ed81-5465-824f-8ba7bf5d2ca8" "answer-6fade646-27e9-5be0-ac21-3eaf8e4bd6f9" "answer-3ea46336-cd01-5b2c-b46f-fe60cc120d35" "answer-606f2be5-014b-5b28-bf23-19c63452c1ff"] :db/ensure [:answer-field/validate]} {:db/id "answer-55c7b825-4af3-56a2-afd0-44f6f67a9f69" :answer/id #uuid "55c7b825-4af3-56a2-afd0-44f