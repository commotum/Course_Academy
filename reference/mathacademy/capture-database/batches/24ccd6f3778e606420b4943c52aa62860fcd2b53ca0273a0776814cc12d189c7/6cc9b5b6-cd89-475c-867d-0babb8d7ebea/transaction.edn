673b73" :answer-field/id #uuid "31585cc3-c8a8-5d1a-b60d-72ee74673b73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-495e48c1-6950-556c-8281-4a67734449a2" :answer-field/choices ["answer-ba5c8a8b-cbde-534e-9ea3-176b5d4ad019" "answer-495e48c1-6950-556c-8281-4a67734449a2" "answer-38fc099c-e039-58f8-895c-1d8133c2ca8a" "answer-7d12d4cd-fcdc-53fc-bfc0-f0337c4ca438" "answer-70b07e97-42ce-5dd2-877a-991c6029d372"] :db/ensure [:answer-field/validate]} {:db/id "answer-ba5c8a8b-cbde-534e-9ea3-176b5d4ad019" :answer/id #uuid "ba5c8a8b-cbde-534e-9ea3-176b5d4ad019" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=5$" :db/ensure [:answer/validate]} {:db/id "answer-495e48c1-6950-556c-8281-4a67734449a2" :answer/id #uuid "495e48c1-6950-556c-8281-4a67734449a2" :answer/type :answer.type/text :answer/value "$x=-5$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-38fc099c-e039-58f8-895c-1d8133c2ca8a" :answer/id #uuid "38fc099c-e039-58f8-895c-1d8133c2ca8a" :answer/type :answer.type/text :answer/value "$x=-6$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "answer-7d12d4cd-fcdc-53fc-bfc0-f0337c4ca438" :answer/id #uuid "7d12d4cd-fcdc-53fc-bfc0-f0337c4ca438" :answer/type :answer.type/text :answer/value "$x=2$ and $x=5$" :db/ensure [:answer/validate]} {:db/id "answer-70b07e97-42ce-5dd2-877a-991c6029d372" :answer/id #uuid "70b07e97-42ce-5dd2-877a-991c6029d372" :answer/type :answer.type/text :answer/value "$x=5$ and $x=2$" :db/ensure [:answer/validate]} {:db/id "question-7984db9b-dab8-5221-ba35-8d0a5e549cba" :question/id #uuid "7984db9b-dab8-5221-ba35-8d0a5e549cba" :question/math-academy-id "q-106059" :question/problem "Which of the following shows the graph of $y={x}^{2}-x-6?$" :question/worked-solution "Let's construct a table of values for the function $y={x}^{2}-x-6.$ We fill the first row with the $x$-values $x=-2,-1,0,1,2,3$ and then use the formula $y={x}^{2}-x-6$ to compute the corresponding $y$-values in the second row. \n\n| $\\,\\,x\\,\\,$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $\\,\\,y\\,\\,$ | $0$ | $-4$ | $-6$ | $-6$ | $-4$ | $0$ |\n\nIf we plot those points on a graph, we can start to see the shape of a parabola:\n\n![](images/4f/4fbf87172434c03bbdff6967d03eae3146f016dcdbb9422e89d2d94ab7693cd5.png)\n\nWe fill out the graph by drawing the parabola through the plotted points:\n\n![](images/00/007a6abdf7787cc14e40c3d92996d5224904a656f8fa6ef42a9911ce97bc24a6.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-758cf8be-30e9-58cb-b2f3-197f61860574"] :db/ensure [:question/validate]} {:db/id "answer-field-758cf8be-30e9-58cb-b2f3-197f61860574" :answer-field/id #uuid "758cf8be-30e9-58cb-b2f3-197f61860574" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21653903-a8ae-5843-86a3-6e201dd68978" :answer-field/choices ["answer-21653903-a8ae-5843-86a3-6e201dd68978" "answer-a0ac50e9-41c5-5f35-8129-bb0c31f3b0ee" "answer-0a7677ae-e62e-5829-91f7-2020875a297a" "answer-496c5471-4221-5e19-a1ab-408227761210" "answer-ea3011dc-818d-5565-8b19-02f93ab49957"] :db/ensure [:answer-field/validate]} {:db/id "answer-21653903-a8ae-5843-86a3-6e201dd68978" :answer/id #uuid "21653903-a8ae-5843-86a3-6e201dd68978" :answer/type :answer.type/image :answer/value "images/00/007a6abdf7787cc14e40c3d92996d5224904a656f8fa6ef42a9911ce97bc24a6.png" :db/ensure [:answer/validate]} {:db/id "answer-a0ac50e9-41c5-5f35-8129-bb0c31f3b0ee" :answer/id #uuid "a0ac50e9-41c5-5f35-8129-bb0c31f3b0ee" :answer/type :answer.type/image :answer/value "images/ae/ae303cc7bd52ab5c6c5eb19f0ed3abe6286f560d58b6c21c78bac4758e978774.png" :db/ensure [:answer/validate]} {:db/id "answer-0a7677ae-e62e-5829-91f7-2020875a297a" :answer/id #uuid "0a7677ae-e62e-5829-91f7-2020875a297a" :answer/type :answer.type/image :answer/value "images/ba/ba70051173652d8783cc8ebd9f200b5dcdf37cda8d81a772c0160e01c31cbf32.png" :db/ensure [:answer/validate]} {:db/id "answer-496c5471-4221-5e19-a1ab-408227761210" :answer/id #uuid "496c5471-4221-5e19-a1ab-408227761210" :answer/type :answer.type/image :answer/value "images/c3/c34cebb49b0482f02872a1ba68f73f8e931d8fb6583daf653560fc17f5b4831d.png" :db/ensure [:answer/validate]} {:db/id "answer-ea3011dc-818d-5565-8b19-02f93ab49957" :answer/id #uuid "ea3011dc-818d-5565-8b19-02f93ab49957" :answer/type :answer.type/image :answer/value "images/cf/cfd42d5e800218639a82bbe46a0749bc3788c616fedc43cb704ebea9448a5867.png" :db/ensure [:answer/validate]} {:db/id "activity-62106853-4525-5739-82c5-41ae5f174363" :activity/id #uuid "62106853-4525-5739-82c5-41ae5f174363" :activity/title "Graphs of General Quadratic Functions" :activity/type :activity.type/review :activity/scope 17592186049919 :activity/course 17592186046647 :activity/steps ["step-4cb68559-b2a9-5c4e-b09f-43ad55b721fe" "step-66993876-9b60-533e-8ab6-877b05f33c90" "step-58f8528b-3855-50bb-b7e5-2d8a123cbd37" "step-cc087953-4c06-57cb-9fb5-54f19a275ac7" "step-eabe0eed-285b-5b48-981b-8b06bc81b02c"] :activity/first-step "step-4cb68559-b2a9-5c4e-b09f-43ad55b721fe" :db/ensure [:activity/validate]} {:db/id "step-4cb68559-b2a9-5c4e-b09f-43ad55b721fe" :step/id #uuid "4cb68559-b2a9-5c4e-b09f-43ad55b721fe" :step/content "question-c5c3534c-ace7-5657-a9dc-80aa55f51084" :step/next "step-66993876-9b60-533e-8ab6-877b05f33c90" :db/ensure [:step/validate]} {:db/id "step-66993876-9b60-533e-8ab6-877b05f33c90" :step/id #uuid "66993876-9b60-533e-8ab6-877b05f33c90" :step/content "question-3d69fa39-1eb4-5e90-8609-317c0513eaff" :step/next "step-58f8528b-3855-50bb-b7e5-2d8a123cbd37" :db/ensure [:step/validate]} {:db/id "step-58f8528b-3855-50bb-b7e5-2d8a123cbd37" :step/id #uuid "58f8528b-3855-50bb-b7e5-2d8a123cbd37" :step/content "question-dcd95f6f-d031-5291-b596-6c28f4bcefd5" :step/next "step-cc087953-4c06-57cb-9fb5-54f19a275ac7" :db/ensure [:step/validate]} {:db/id "step-cc087953-4c06-57cb-9fb5-54f19a275ac7" :step/id #uuid "cc087953-4c06-57cb-9fb5-54f19a275ac7" :step/content "question-01c1b80a-b0c5-5bb0-af0e-20dd6de4f28c" :step/next "step-eabe0eed-285b-5b48-981b-8b06bc81b02c" :db/ensure [:step/validate]} {:db/id "step-eabe0eed-285b-5b48-981b-8b06bc81b02c" :step/id #uuid "eabe0eed-285b-5b48-981b-8b06bc81b02c" :step/content "question-7984db9b-dab8-5221-ba35-8d0a5e549cba" :db/ensure [:step/validate]} [:db/retract 17592186052301 :answer-field/choices 17592186052304] [:db/retract 17592186052301 :answer-field/choices 17592186052305] [:db/retract 17592186052301 :answer-field/choices 17592186052306] [:db/retract 17592186052301 :answer-field/choices 17592186052302] [:db/retract 17592186052301 :answer-field/choices 17592186052303] {:db/id 17592186055162 :question/problem "Find the roots of $g(z)=\\frac{{z}^{3}+5{z}^{2}-z-5}{{z}^{3}+6{z}^{2}+5z}.$" :question/worked-solution "The roots of $g(z)$ are the solutions to the equation $g(z)=0.$ In our case, we have\n\n$$\n\\frac{{z}^{3}+5{z}^{2}-z-5}{{z}^{3}+6{z}^{2}+5z}=0.\n$$\n\nFirst, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}g(z) & =\\frac{{z}^{3}+5{z}^{2}-z-5}{{z}^{3}+6{z}^{2}+5z} \\\\  & =\\frac{{z}^{2}(z+5)-(z+5)}{z({z}^{2}+6z+5)} \\\\  & =\\frac{({z}^{2}-1)(z+5)}{z(z+1)(z+5)} \\\\  & =\\frac{(z+1)(z-1)(z+5)}{z(z+1)(z+5)} \\\\  & =\\frac{(z-1)\\cancel{(z+1)(z+5)}}{z\\cancel{(z+1)(z+5)}} &  \\\\  & =\\frac{z-1}{z}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $z:$\n\n$$\n\\begin{aligned}z-1=0\\,⟹\\,z=1\\end{aligned}\n$$\n\nTherefore, the solution to $g(z)=0$ is $z=1.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186052301 :answer-field/correct "answer-7395031c-ba77-5eee-a64a-3480f58187a6" :answer-field/choices ["answer-2fa3dcff-2a62-52aa-8643-c454d9cae8b0" "answer-23680efc-ed62-58c3-81ad-6db5b3887072" "answer-73a6bbee-d501-5ef4-858c-ab3bff68963d" "answer-1bfe5796-8d7c-5939-bfd7-7630045898fc" "answer-7395031c-ba77-5eee-a64a-3480f58187a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-2fa3dcff-2a62-52aa-8643-c454d9cae8b0" :answer/id #uuid "2fa3dcff-2a62-52aa-8643-c454d9cae8b0" :answer/type :answer.type/math :answer/value "z=-2" :db/ensure [:answer/validate]} {:db/id "answer-23680efc-ed62-58c3-81ad-6db5b3887072" :answer/id #uuid "23680efc-ed62-58c3-81ad-6db5b3887072" :answer/type :answer.type/math :answer/value "z=-2,-1" :db/ensure [:answer/validate]} {:db/id "answer-73a6bbee-d501-5ef4-858c-ab3bff68963d" :answer/id #uuid "73a6bbee-d501-5ef4-858c-ab3bff68963d" :answer/type :answer.type/math :answer/value "z=-5" :db/ensure [:answer/validate]} {:db/id "answer-1bfe5796-8d7c-5939-bfd7-7630045898fc" :answer/id #uuid "1bfe5796-8d7c-5939-bfd7-7630045898fc" :answer/type :answer.type/math :answer/value "z=-5,1" :db/ensure [:answer/validate]} {:db/id "answer-7395031c-ba77-5eee-a64a-3480f58187a6" :answer/id #uuid "7395031c-ba77-5eee-a64a-3480f58187a6" :answer/type :answer.type/math :answer/value "z=1" :db/ensure [:answer/validate]} {:db/id 17592186054741 :knowledge-point/questions ["question-bdc209cb-0420-5821-949d-4d1c662e04c2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-bdc209cb-0420-5821-949d-4d1c662e04c2" :question/id #uuid "bdc209cb-0420-5821-949d-4d1c662e04c2" :question/math-academy-id "q-24751" :question/problem "Solve $f(u)=0$ where $f(u)=\\frac{6{u}^{2}+6u-36}{3{u}^{2}+9u}.$" :question/worked-solution "First, we factor the numerator and denominator and cancel any common factors, as follows:\n\n$$\n\\begin{aligned}f(u) & =\\frac{6{u}^{2}+6u-36}{3{u}^{2}+9u} \\\\  & =\\frac{6({u}^{2}+u-6)}{3u(u+3)} \\\\  & =\\frac{6(u+3)(u-2)}{3u(u+3)} \\\\  & =\\frac{2\\cdot \\cancel{3(u+3)}(u-2)}{u\\cdot \\cancel{3(u+3)}} \\\\  & =\\frac{2(u-2)}{u}\\end{aligned}\n$$\n\nNow, we set the numerator equal to zero and solve for $u:$\n\n$$\n\\begin{aligned}2(u-2) & =0\\,⟹\\,u=2\\end{aligned}\n$$\n\nTherefore, the solution to $f(u)=0$ is $u=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-79108aad-c42b-57e7-8cd3-4a21d370addc"] :db/ensure [:question/validate]} {:db/id "answer-field-79108aad-c42b-57e7-8cd3-4a21d370addc" :answer-field/id #uuid "79108aad-c42b-57e7-8cd3-4a21d370addc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-03edd520-2d8a-5304-bab2-d26ecd618e4a" :answer-field/choices ["answer-9d930647-e99f-599d-83de-1dfa90c26c77" "answer-306a0eb7-d657-5734-a843-ce10d5c8d558" "answer-2fb68bc0-1d7a-5f48-89b9-cc0d4de995b7" "answer-80801ef1-0330-5778-8494-9cc535ea3566" "answer-03edd520-2d8a-5304-bab2-d26ecd618e4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-9d930647-e99f-599d-83de-1dfa90c26c77" :answer/id #uuid "9d930647-e99f-599d-83de-1dfa90c26c77" :answer/type :answer.type/math :answer/value "u=-3" :db/ensure [:answer/validate]} {:db/id "answer-306a0eb7-d657-5734-a843-ce10d5c8d558" :answer/id #uuid "306a0eb7-d657-5734-a843-ce10d5c8d558" :answer/type :answer.type/math :answer/value "u=-3,-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2fb68bc0-1d7a-5f48-89b9-cc0d4de995b7" :answer/id #uuid "2fb68bc0-1d7a-5f48-89b9-cc0d4de995b7" :answer/type :answer.type/math :answer/value "u=-3,2" :db/ensure [:answer/validate]} {:db/id "answer-80801ef1-0330-5778-8494-9cc535ea3566" :answer/id #uuid "80801ef1-0330-5778-8494-9cc535ea3566" :answer/type :answer.type/math :answer/value "u=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-03edd520-2d8a-5304-bab2-d26ecd618e4a" :answer/id #uuid "03edd520-2d8a-5304-bab2-d26ecd618e4a" :answer/type :answer.type/math :answer/value "u=2" :db/ensure [:answer/validate]} {:db/id 17592186054740 :knowledge-point/questions ["question-717167d3-5022-5ef5-94d0-b4fbd3628130"] :db/ensure [:knowledge-point/validate]} {:db/id "question-717167d3-5022-5ef5-94d0-b4fbd3628130" :question/id #uuid "717167d3-5022-5ef5-94d0-b4fbd3628130" :question/math-academy-id "q-25305" :question/problem "Find the roots of $f(h)=\\frac{3{h}^{2}+18}{{h}^{2}+10h+25}.$" :question/worked-solution "The roots of $f(h)$ are the solutions to the equation $f(h)=0.$ In our case, we have\n\n$$\n\\frac{3{h}^{2}+18}{{h}^{2}+10h+25}=0.\n$$\n\nFirst, we factor $f(h),$ as follows:\n\n$$\n\\begin{aligned}f(h) & =\\frac{3{h}^{2}+18}{{h}^{2}+10h+25} \\\\  & =\\frac{3({h}^{2}+6)}{(h+5)^{2}}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the numerator equal to zero and solve for $h:$\n\n$$\n3({h}^{2}+6)=0\n$$\n\nSince ${h}^{2}+6>0$ for all $h,$ there is no real solution to $f(h)=0.$ Therefore, $f(h)$ has no real roots." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ae519442-efbc-59f7-9c86-1ccd80d4bcda"] :db/ensure [:question/validate]} {:db/id "answer-field-ae519442-efbc-59f7-9c86-1ccd80d4bcda" :answer-field/id #uuid "ae519442-efbc-59f7-9c86-1ccd80d4bcda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-98f87aaa-f0ac-5dbe-9bbb-7debc8206252" :answer-field/choices ["answer-85e2edb2-a2b9-5f19-a907-276b2ad76eca" "answer-d1eae01a-a822-543e-b070-de653252b491" "answer-5b5cd153-42b8-5bd6-a18f-8582a64b496a" "answer-a092c7e6-c899-5761-8a60-1ef5cb6c18ae" "answer-98f87aaa-f0ac-5dbe-9bbb-7debc8206252"] :db/ensure [:answer-field/validate]} {:db/id "answer-85e2edb2-a2b9-5f19-a907-276b2ad76eca" :answer/id #uuid "85e2edb2-a2b9-5f19-a907-276b2ad76eca" :answer/type :answer.type/math :answer/value "h=-3,\\,0" :db/ensure [:answer/validate]} {:db/id "answer-d1eae01a-a822-543e-b070-de653252b491" :answer/id #uuid "d1eae01a-a822-543e-b070-de653252b491" :answer/type :answer.type/math :answer/value "h=-5" :db/ensure [:answer/validate]} {:db/id "answer-5b5cd153-42b8-5bd6-a18f-8582a64b496a" :answer/id #uuid "5b5cd153-42b8-5bd6-a18f-8582a64b496a" :answer/type :answer.type/math :answer/value "h=-6" :db/ensure [:answer/validate]} {:db/id "answer-a092c7e6-c899-5761-8a60-1ef5cb6c18ae" :answer/id #uuid "a092c7e6-c899-5761-8a60-1ef5cb6c18ae" :answer/type :answer.type/math :answer/value "h=1,2" :db/ensure [:answer/validate]} {:db/id "answer-98f87aaa-f0ac-5dbe-9bbb-7debc8206252" :answer/id #uuid "98f87aaa-f0ac-5dbe-9bbb-7debc8206252" :answer/type :answer.type/text :answer/value "No real roots" :db/ensure [:answer/validate]} {:db/id "activity-160751ec-aa7e-5a05-957b-e3cae6283690" :activity/id #uuid "160751ec-aa7e-5a05-957b-e3cae6283690" :activity/title "Roots of Rational Functions" :activity/type :activity.type/review :activity/scope 17592186049931 :activity/course 17592186046647 :activity/steps ["step-bb3b734c-c58b-56b8-b550-f52bad4497fe" "step-8225f958-6907-55a2-87a7-beaf1d7a5cd5" "step-fda652b0-dc8e-5347-a849-96c8bb6a4121"] :activity/first-step "step-bb3b734c-c58b-56b8-b550-f52bad4497fe" :db/ensure [:activity/validate]} {:db/id "step-bb3b734c-c58b-56b8-b550-f52bad4497fe" :step/id #uuid "bb3b734c-c58b-56b8-b550-f52bad4497fe" :step/content 17592186055162 :step/next "step-8225f958-6907-55a2-87a7-beaf1d7a5cd5" :db/ensure [:step/validate]} {:db/id "step-8225f958-6907-55a2-87a7-beaf1d7a5cd5" :step/id #uuid "8225f958-6907-55a2-87a7-beaf1d7a5cd5" :step/content "question-bdc209cb-0420-5821-949d-4d1c662e04c2" :step/next "step-fda652b0-dc8e-5347-a849-96c8bb6a4121" :db/ensure [:step/validate]} {:db/id "step-fda652b0-dc8e-5347-a849-96c8bb6a4121" :step/id #uuid "fda652b0-dc8e-5347-a849-96c8bb6a4121" :step/content "question-717167d3-5022-5ef5-94d0-b4fbd3628130" :db/ensure [:step/validate]} {:db/id 17592186105745 :knowledge-point/questions ["question-125421bb-697b-5db0-9420-c14f51cbf8ed"] :db/ensure [:knowledge-point/validate]} {:db/id "question-125421bb-697b-5db0-9420-c14f51cbf8ed" :question/id #uuid "125421bb-697b-5db0-9420-c14f51cbf8ed" :question/math-academy-id "q-20959" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is \n\n$$\n\\{\\begin{aligned}x-3y=2 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-3y=2.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=2+3y,$ and the general solution is\n\n$$\n\\{\\begin{aligned}x=2+3y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2+3y \\\\ y\\end{aligned}]=⟨2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9bddf8b0-a60d-5d3f-b177-ef56758827de"] :db/ensure [:question/validate]} {:db/id "answer-field-9bddf8b0-a60d-5d3f-b177-ef56758827de" :answer-field/id #uuid "9bddf8b0-a60d-5d3f-b177-ef56758827de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-15e6ec91-c1bf-5fd4-b22a-68eae1a331c2" :answer-field/choices ["answer-7d1e9298-04d9-5141-818c-3600950452a4" "answer-adbb2e17-3aaa-5c1e-9d3b-42764e417a7c" "answer-15e6ec91-c1bf-5fd4-b22a-68eae1a331c2" "answer-a15c2e45-6e4f-5f3f-a77c-905430031175" "answer-3ea4d3db-3e0f-5246-9e9e-4b07b0cfdfa3"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d1e9298-04d9-5141-818c-3600950452a4" :answer/id #uuid "7d1e9298-04d9-5141-818c-3600950452a4" :answer/type :answer.type/math :answer/value "⟨-2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-adbb2e17-3aaa-5c1e-9d3b-42764e417a7c" :answer/id #uuid "adbb2e17-3aaa-5c1e-9d3b-42764e417a7c" :answer/type :answer.type/math :answer/value "⟨-2-3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-15e6ec91-c1bf-5fd4-b22a-68eae1a331c2" :answer/id #uuid "15e6ec91-c1bf-5fd4-b22a-68eae1a331c2" :answer/type :answer.type/math :answer/value "⟨2+3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-a15c2e45-6e4f-5f3f-a77c-905430031175" :answer/id #uuid "a15c2e45-6e4f-5f3f-a77c-905430031175" :answer/type :answer.type/math :answer/value "⟨2-3y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-3ea4d3db-3e0f-5246-9e9e-4b07b0cfdfa3" :answer/id #uuid "3ea4d3db-3e0f-5246-9e9e-4b07b0cfdfa3" :answer/type :answer.type/math :answer/value "⟨3+2y,\\,y⟩,\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186105746 :knowledge-point/questions ["question-897c434c-2b3e-570b-8210-f27b51719e55"] :db/ensure [:knowledge-point/validate]} {:db/id "question-897c434c-2b3e-570b-8210-f27b51719e55" :question/id #uuid "897c434c-2b3e-570b-8210-f27b51719e55" :question/math-academy-id "q-20964" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned}x-5y=0 \\\\ 2x-10y=3.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." :question/worked-solution "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}1 & -5 & 0 \\\\ 2 & -10 & 3\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -5 & 0 \\\\ 2 & -10 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -5 & 0 \\\\ 0 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\{\\begin{aligned}x-5y=0 \\\\ 0x+0y=3.\\end{aligned}\n$$\n\nHowever, the final equation $0x+0y=3$ has no solution. It simplifies to $0=3,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8e2c1a1e-5d57-5327-abb7-fcc53ab8ec5f"] :db/ensure [:question/validate]} {:db/id "answer-field-8e2c1a1e-5d57-5327-abb7-fcc53ab8ec5f" :answer-field/id #uuid "8e2c1a1e-5d57-5327-abb7-fcc53ab8ec5f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9ed7e74-cd82-5c17-8e1e-7e850dab4062" :answer-field/choices ["answer-b5ac4430-b766-5ef0-94db-838c49da75cf" "answer-75926ae1-f71f-5fca-920d-fc96549abf2a" "answer-e6c2949c-d93d-5056-afd3-68aaf8051b1c" "answer-202e7707-594c-5dc6-b642-d0f2a066b531" "answer-c9ed7e74-cd82-5c17-8e1e-7e850dab4062"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5ac4430-b766-5ef0-94db-838c49da75cf" :answer/id #uuid "b5ac4430-b766-5ef0-94db-838c49da75cf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-5y \\\\ 3\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-75926ae1-f71f-5fca-920d-fc96549abf2a" :answer/id #uuid "75926ae1-f71f-5fca-920d-fc96549abf2a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-5y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-e6c2949c-d93d-5056-afd3-68aaf8051b1c" :answer/id #uuid "e6c2949c-d93d-5056-afd3-68aaf8051b1c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5y \\\\ 3\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-202e7707-594c-5dc6-b642-d0f2a066b531" :answer/id #uuid "202e7707-594c-5dc6-b642-d0f2a066b531" :answer/type :answer.type/math :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}5y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-c9ed7e74-cd82-5c17-8e1e-7e850dab4062" :answer/id #uuid "c9ed7e74-cd82-5c17-8e1e-7e850dab4062" :answer/type :answer.type/text :answer/value "No solution" :db/ensure [:answer/validate]} {:db/id 17592186107080 :tutorial/content "Let's consider a system of linear equations where the corresponding coefficient matrix is singular. For example, consider the following system and its associated augmented matrix:\n![](images/6a/6a69daf7712312876b0ec97c540bbc472e46a7938beb8a59e694a04ad0b1d8c6.svg)\n\nTo solve the system, we can reduce $M$ to row echelon form using Gaussian elimination, as usual. We have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -2 & -5 \\\\ -3 & 6 & 15\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -5 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n![](images/a8/a8bfe3f6b27247ee9b27db8346fd94fb9068c85dec6f4a71517a821dee48dbf3.svg)\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y = 0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx - 2y = -5.\n$$\n\nFinally, we describe the **general solution** of our system.\n\n- The first variable in our equation, $x,$ is called a **basic variable**.\n\n- The second variable in our equation, $y,$ is called a **free variable**.\n\nSolving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x = -5+2y.$ So the general solution of the system is\n![](images/0b/0ba4a232f29dd6fce2a8f6d7cda39b4f5b192c20fc91fe4403dfe648231382c5.svg)\nwhere the free variable $y$ is any number.\n\nIn vector form, this solution is written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-5+2y \\\\ y\\end{aligned}]=[\\begin{aligned}-5 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nNotice that this is the equation of a straight line on a plane. Any point on this line satisfies our system of equations.\n\nIf we want to find some **particular solution** of the system, we simply choose some particular value of $y$ and find the corresponding value of $x$ on the line. For example, if we choose $y=0,$ then the corresponding value is $x=-5$ and the particular solution is $x=-5,$ $y=0.$" :db/ensure [:tutorial/validate]} {:db/id 17592186107097 :tutorial/content "Sometimes, a system of equations might not have any solutions. For example, consider the following augmented matrix:\n\n$$\n\\begin{aligned}M=[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 0 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding system is\n![](images/e8/e8c64d8be247afd3e8ab02abc69e33635ef0234dbcbbc60f42379021a39a58a2.svg)\n\nThe final equation, $0x+0y=10,$ has no solution. It simplifies to $0=10,$ which is a false statement.\n\nSo, there is no pair $x,y$ that satisfies both equations in the system. Consequently, the overall system has no solution." :db/ensure [:tutorial/validate]} [:db/retract 17592186112692 :answer-field/choices 17592186112695] [:db/retract 17592186112692 :answer-field/choices 17592186112696] {:db/id 17592186115274 :knowledge-point/questions ["question-629c55e3-c442-5e2d-bc74-813be7f9da46"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115621 :question/problem "The point $P$ with coordinates $(1,-1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x+2)-2?$" :question/worked-solution "The graph of $y=f(x+2)-2$  is a translation of the graph of $y=f(x)$ by $2$ units to the *left* and $2$ units down. So the $y$-coordinate decreases by $2$ and the $x$-coordinate decreases by $2.$\n\nWe know that the point $(1,-1)$ lies on $y=f(x).$ Therefore, the point $(1-2,-1-2)=(-1,-3)$ must lie on $y=f(x+2)-2.$\n\n![](images/89/89f839666dc5471bfe43064d01c9c4f5c60a9ac4bfc8abe8cf83ac6d6592bf42.png)" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186112692 :answer-field/correct 17592186112697 :answer-field/choices ["answer-a8df0157-21f6-5dc0-8a63-11b23288264d" "answer-9a26e55d-9303-56e0-8288-9b23893be1a4"] :db/ensure [:answer-field/validate]} {:db/id "answer-a8df0157-21f6-5dc0-8a63-11b23288264d" :answer/id #uuid "a8df0157-21f6-5dc0-8a63-11b23288264d" :answer/type :answer.type/math :answer/value "(-1,1)" :db/ensure [:answer/validate]} {:db/id "answer-9a26e55d-9303-56e0-8288-9b23893be1a4" :answer/id #uuid "9a26e55d-9303-56e0-8288-9b23893be1a4" :answer/type :answer.type/math :answer/value "(3,1)" :db/ensure [:answer/validate]} {:db/id "question-629c55e3-c442-5e2d-bc74-813be7f9da46" :question/id #uuid "629c55e3-c442-5e2d-bc74-813be7f9da46" :question/math-academy-id "q-70449" :question/problem "The point $P$ with coordinates $(1,3)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(x-4)+4?$" :question/worked-solution "The graph of $y=f(x-4)+4$  is a translation of the graph of $y=f(x)$ by $4$ units to the *right* and $4$ units up. So the $y$-coordinate increases by $4$ and the $x$-coordinate increases by $4.$\n\nWe know that the point $P(1,3)$ lies on $y=f(x).$ Therefore, the point $(1+4,3+4)=(5,7)$ must lie on $y=f(x-4)+4.$\n\n![](images/d3/d3779750f7ecf13b1f24eb10f7c0e694d784a079710771e70eb793327a6e9411.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-498ea766-5b7c-5a0e-8fa8-8e209932d275"] :db/ensure [:question/validate]} {:db/id "answer-field-498ea766-5b7c-5a0e-8fa8-8e209932d275" :answer-field/id #uuid "498ea766-5b7c-5a0e-8fa8-8e209932d275" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3e6e7b2e-b39e-5b4b-8716-7cb1355b03aa" :answer-field/choices ["answer-068de661-d540-5f22-87b3-55fc48d91411" "answer-b4a411ae-b69e-55fa-bddb-288f2de2db05" "answer-01918d4d-fe77-5a05-8182-1ca73078a2eb" "answer-3e6e7b2e-b39e-5b4b-8716-7cb1355b03aa" "answer-3ce77541-fe64-5c39-9a3f-a8e633031c81"] :db/ensure [:answer-field/validate]} {:db/id "answer-068de661-d540-5f22-87b3-55fc48d91411" :answer/id #uuid "068de661-d540-5f22-87b3-55fc48d91411" :answer/type :answer.type/math :answer/value "(-3,-1)" :db/ensure [:answer/validate]} {:db/id "answer-b4a411ae-b69e-55fa-bddb-288f2de2db05" :answer/id #uuid "b4a411ae-b69e-55fa-bddb-288f2de2db05" :answer/type :answer.type/math :answer/value "(-4,-1)" :db/ensure [:answer/validate]} {:db/id "answer-01918d4d-fe77-5a05-8182-1ca73078a2eb" :answer/id #uuid "01918d4d-fe77-5a05-8182-1ca73078a2eb" :answer/type :answer.type/math :answer/value "(5,6)" :db/ensure [:answer/validate]} {:db/id "answer-3e6e7b2e-b39e-5b4b-8716-7cb1355b03aa" :answer/id #uuid "3e6e7b2e-b39e-5b4b-8716-7cb1355b03aa" :answer/type :answer.type/math :answer/value "(5,7)" :db/ensure [:answer/validate]} {:db/id "answer-3ce77541-fe64-5c39-9a3f-a8e633031c81" :answer/id #uuid "3ce77541-fe64-5c39-9a3f-a8e633031c81" :answer/type :answer.type/math :answer/value "(6,8)" :db/ensure [:answer/validate]} {:db/id 17592186115261 :knowledge-point/questions ["question-cd39d09c-a0fc-599a-b531-076d3a407865"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cd39d09c-a0fc-599a-b531-076d3a407865" :question/id #uuid "cd39d09c-a0fc-599a-b531-076d3a407865" :question/math-academy-id "q-72291" :question/problem "![](images/30/3083c6f4c7998d69857eb7d3a74d905265edd437b5bf73003e55868083993d5a.png)\n\nThe diagram above shows the graphs of $y=f(x)$ and $y=g(x)$, where $g(x)=f(x+a)+b.$ What are the values of $a$ and $b?$" :question/worked-solution "Notice that every point on the graph $y=g(x)$ is three units *to the left * and two units *down* of the corresponding point on the graph of $y=f(x).$ \n\nSo, we conclude that $g(x)=f(x+3)-2,$ and therefore $a=3$ and $b=-2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d9c953d2-beee-51b7-9873-9316ffb11e9a"] :db/ensure [:question/validate]} {:db/id "answer-field-d9c953d2-beee-51b7-9873-9316ffb11e9a" :answer-field/id #uuid "d9c953d2-beee-51b7-9873-9316ffb11e9a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4556a0a8-e5ac-54c9-93aa-1d55f2fcd0fe" :answer-field/choices ["answer-f41d13fd-3390-5bfa-8b53-7626ff405aa9" "answer-0d888797-a845-5d16-b6cc-44af8297c7a3" "answer-a1d8c6dd-5055-5751-bf41-1186eeb77f49" "answer-4556a0a8-e5ac-54c9-93aa-1d55f2fcd0fe" "answer-8e3e26d7-2dfd-56b5-aed1-8a6b847e743c"] :db/ensure [:answer-field/validate]} {:db/id "answer-f41d13fd-3390-5bfa-8b53-7626ff405aa9" :answer/id #uuid "f41d13fd-3390-5bfa-8b53-7626ff405aa9" :answer/type :answer.type/math :answer/value "a=-2,\\,b=3" :db/ensure [:answer/validate]} {:db/id "answer-0d888797-a845-5d16-b6cc-44af8297c7a3" :answer/id #uuid "0d888797-a845-5d16-b6cc-44af8297c7a3" :answer/type :answer.type/math :answer/value "a=-3,\\,b=-2" :db/ensure [:answer/validate]} {:db/id "answer-a1d8c6dd-5055-5751-bf41-1186eeb77f49" :answer/id #uuid "a1d8c6dd-5055-5751-bf41-1186eeb77f49" :answer/type :answer.type/math :answer/value "a=2,\\,b=-3" :db/ensure [:answer/validate]} {:db/id "answer-4556a0a8-e5ac-54c9-93aa-1d55f2fcd0fe" :answer/id #uuid "4556a0a8-e5ac-54c9-93aa-1d55f2fcd0fe" :answer/type :answer.type/math :answer/value "a=3,\\,b=-2" :db/ensure [:answer/validate]} {:db/id "answer-8e3e26d7-2dfd-56b5-aed1-8a6b847e743c" :answer/id #uuid "8e3e26d7-2dfd-56b5-aed1-8a6b847e743c" :answer/type :answer.type/math :answer/value "a=3,\\,b=2" :db/ensure [:answer/validate]} {:db/id "activity-671a442e-3353-514f-82e6-53a9f41377fa" :activity/id #uuid "671a442e-3353-514f-82e6-53a9f41377fa" :activity/title "Horizontal Translations of Functions" :activity/type :activity.type/review :activity/scope 17592186048419 :activity/course 17592186046647 :activity/steps ["step-55eedf2c-a6b5-527b-9e80-c0ec10939cca" "step-994948ff-fd15-52e1-a5f8-7d45cf1887c3" "step-33f252d9-ab1e-5335-94f6-be1606d29cfa"] :activity/first-step "step-55eedf2c-a6b5-527b-9e80-c0ec10939cca" :db/ensure [:activity/validate]} {:db/id "step-55eedf2c-a6b5-527b-9e80-c0ec10939cca" :step/id #uuid "55eedf2c-a6b5-527b-9e80-c0ec10939cca" :step/content 17592186115621 :step/next "step-994948ff-fd15-52e1-a5f8-7d45cf1887c3" :db/ensure [:step/validate]} {:db/id "step-994948ff-fd15-52e1-a5f8-7d45cf1887c3" :step/id #uuid "994948ff-fd15-52e1-a5f8-7d45cf1887c3" :step/content "question-629c55e3-c442-5e2d-bc74-813be7f9da46" :step/next "step-33f252d9-ab1e-5335-94f6-be1606d29cfa" :db/ensure [:step/validate]} {:db/id "step-33f252d9-ab1e-5335-94f6-be1606d29cfa" :step/id #uuid "33f252d9-ab1e-5335-94f6-be1606d29cfa" :step/content "question-cd39d09c-a0fc-599a-b531-076d3a407865" :db/ensure [:step/validate]} {:db/id 17592186152219 :knowledge-point/questions ["question-fa31176f-d01d-551f-8a93-0788b21bb0df" "question-30efcbe6-dda5-5a19-8bde-8531afb9c0c2" "question-30dcac50-046c-59c3-a80d-0b2281d525fa"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186152222 :knowledge-point/questions ["question-7efa12c8-5625-54e7-8464-2de1d85a3ba0" "question-43503f70-a039-563c-bedc-d1b2782aedca" "question-2ca0b310-c54f-553d-a3d3-7e3881bc581e" "question-9ec0dc53-4341-5ee6-84a6-d12231a31e63"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186152221 :knowledge-point/questions ["question-ae384128-da5c-5a65-8194-114971516a6c" "question-df717d4d-32a8-529f-8ad7-781f9e19e4d5" "question-317a01e3-d69d-5965-940a-bd52e056d6a6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fa31176f-d01d-551f-8a93-0788b21bb0df" :question/id #uuid "fa31176f-d01d-551f-8a93-0788b21bb0df" :question/math-academy-id "q-106870" :question/problem "What is the dimension of ${R}_{13}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $13?$" :question/worked-solution "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{13}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{13}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{13}[t])=13+1=14.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ecd3bf12-b1f6-5c4e-9bad-9599ba17393a"] :db/ensure [:question/validate]} {:db/id "answer-field-ecd3bf12-b1f6-5c4e-9bad-9599ba17393a" :answer-field/id #uuid "ecd3bf12-b1f6-5c4e-9bad-9599ba17393a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1edeb7da-5493-544c-87e7-d2e7db00b8ab" :answer-field/choices ["answer-a7657467-0037-5ac7-a3db-1430713499d4" "answer-7d3c4f5a-d312-52c5-9d3b-d9a1692c2a6c" "answer-1edeb7da-5493-544c-87e7-d2e7db00b8ab" "answer-86bd66e0-30c4-510e-b030-d1eb20be4d9d" "answer-017dfaf7-4ac9-510d-9d61-b37c8e931dad"] :db/ensure [:answer-field/validate]} {:db/id "answer-a7657467-0037-5ac7-a3db-1430713499d4" :answer/id #uuid "a7657467-0037-5ac7-a3db-1430713499d4" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-7d3c4f5a-d312-52c5-9d3b-d9a1692c2a6c" :answer/id #uuid "7d3c4f5a-d312-52c5-9d3b-d9a1692c2a6c" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-1edeb7da-5493-544c-87e7-d2e7db00b8ab" :answer/id #uuid "1edeb7da-5493-544c-87e7-d2e7db00b8ab" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-86bd66e0-30c4-510e-b030-d1eb20be4d9d" :answer/id #uuid "86bd66e0-30c4-510e-b030-d1eb20be4d9d" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-017dfaf7-4ac9-510d-9d61-b37c8e931dad" :answer/id #uuid "017dfaf7-4ac9-510d-9d61-b37c8e931dad" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "question-30efcbe6-dda5-5a19-8bde-8531afb9c0c2" :question/id #uuid "30efcbe6-dda5-5a19-8bde-8531afb9c0c2" :question/math-academy-id "q-36479" :question/problem "What is the dimension of ${R}_{8}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $8?$" :question/worked-solution "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{8}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{8}\\}.\n$$\n\nTherefore, we have that\n\n$$\n\\text{dim}({R}_{8}[t])=8+1=9.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2334e2ca-e972-51d4-a0dc-86a2cf81b8c0"] :db/ensure [:question/validate]} {:db/id "answer-field-2334e2ca-e972-51d4-a0dc-86a2cf81b8c0" :answer-field/id #uuid "2334e2ca-e972-51d4-a0dc-86a2cf81b8c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cefa2845-8d96-5d5c-9980-430390ea2c90" :answer-field/choices ["answer-58e6450d-c774-5ea8-9bf3-16d7ec9f531f" "answer-43942a52-bb00-5c25-8a66-6b236060584b" "answer-4a966cdf-1217-52d0-b10d-01a030f8bcf7" "answer-1973d90e-d739-5e54-ab68-75b6c1f7b724" "answer-cefa2845-8d96-5d5c-9980-430390ea2c90"] :db/ensure [:answer-field/validate]} {:db/id "answer-58e6450d-c774-5ea8-9bf3-16d7ec9f531f" :answer/id #uuid "58e6450d-c774-5ea8-9bf3-16d7ec9f531f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-43942a52-bb00-5c25-8a66-6b236060584b" :answer/id #uuid "43942a52-bb00-5c25-8a66-6b236060584b" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-4a966cdf-1217-52d0-b10d-01a030f8bcf7" :answer/id #uuid "4a966cdf-1217-52d0-b10d-01a030f8bcf7" :answer/type :answer.type/math :answer/value "64" :db/ensure [:answer/validate]} {:db/id "answer-1973d90e-d739-5e54-ab68-75b6c1f7b724" :answer/id #uuid "1973d90e-d739-5e54-ab68-75b6c1f7b724" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-cefa2845-8d96-5d5c-9980-430390ea2c90" :answer/id #uuid "cefa2845-8d96-5d5c-9980-430390ea2c90" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-30dcac50-046c-59c3-a80d-0b2281d525fa" :question/id #uuid "30dcac50-046c-59c3-a80d-0b2281d525fa" :question/math-academy-id "q-106869" :question/problem "What is the dimension of ${R}_{100}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $100?$" :question/worked-solution "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{100}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{100}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{100}[t])=100+1=101.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b6955435-8c1d-5b23-b144-5d24b738ba8e"] :db/ensure [:question/validate]} {:db/id "answer-field-b6955435-8c1d-5b23-b144-5d24b738ba8e" :answer-field/id #uuid "b6955435-8c1d-5b23-b144-5d24b738ba8e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-604037be-72ef-5fa3-ba31-d788ae37824b" :answer-field/choices ["answer-7da878d2-3696-5918-b610-27eeb9d0cf7b" "answer-604037be-72ef-5fa3-ba31-d788ae37824b" "answer-7d9e6326-622e-5a4f-a47e-92f7db0b716d" "answer-2a44e5c7-3b56-530a-b990-d595938a4ee6" "answer-1a1ce7cc-733e-5b7c-8053-12ebbb0a908e"] :db/ensure [:answer-field/validate]} {:db/id "answer-7da878d2-3696-5918-b610-27eeb9d0cf7b" :answer/id #uuid "7da878d2-3696-5918-b610-27eeb9d0cf7b" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-604037be-72ef-5fa3-ba31-d788ae37824b" :answer/id #uuid "604037be-72ef-5fa3-ba31-d788ae37824b" :answer/type :answer.type/math :answer/value "101" :db/ensure [:answer/validate]} {:db/id "answer-7d9e6326-622e-5a4f-a47e-92f7db0b716d" :answer/id #uuid "7d9e6326-622e-5a4f-a47e-92f7db0b716d" :answer/type :answer.type/math :answer/value "200" :db/ensure [:answer/validate]} {:db/id "answer-2a44e5c7-3b56-530a-b990-d595938a4ee6" :answer/id #uuid "2a44e5c7-3b56-530a-b990-d595938a4ee6" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "answer-1a1ce7cc-733e-5b7c-8053-12ebbb0a908e" :answer/id #uuid "1a1ce7cc-733e-5b7c-8053-12ebbb0a908e" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id 17592186397863 :question/worked-solution "The standard basis of ${R}_{n}[t]$ is\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{n}\\}.\n$$\n\nSo, the standard basis of ${R}_{20}[t]$ is \n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,\\,{t}^{20}\\}.\n$$\n\nTherefore, we have that \n\n$$\n\\text{dim}({R}_{20}[t])=20+1=21.\n$$\n\nIn general,\n\n$$\n\\text{dim}({R}_{n}[t])=n+1.\n$$" :db/ensure [:question/validate]} {:db/id "question-7efa12c8-5625-54e7-8464-2de1d85a3ba0" :question/id #uuid "7efa12c8-5625-54e7-8464-2de1d85a3ba0" :question/math-academy-id "q-95218" :question/problem "What is the dimension of ${\\text{M}}_{7}(R),$ the vector space of all $7\\times 7$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n}(R)$ contains a total of ${n}^{2}$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{2}(R)$ contains ${2}^{2}=4$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{7}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{7}(R))={7}^{2}=49.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a69d9c07-c486-5d96-be8f-04bbd335d396"] :db/ensure [:question/validate]} {:db/id "answer-field-a69d9c07-c486-5d96-be8f-04bbd335d396" :answer-field/id #uuid "a69d9c07-c486-5d96-be8f-04bbd335d396" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f1a757e4-19f6-50f1-9887-1b2bae99eff0" :answer-field/choices ["answer-b27b7ca7-3a76-56c0-845b-41bdb8aea4a7" "answer-a8d7e4db-ae01-5275-b4c8-0fd8386be685" "answer-f1a757e4-19f6-50f1-9887-1b2bae99eff0" "answer-ddf83f83-0973-5661-b724-fbd23032d35f" "answer-645b2e7b-ed0a-5176-a522-b400791972fb"] :db/ensure [:answer-field/validate]} {:db/id "answer-b27b7ca7-3a76-56c0-845b-41bdb8aea4a7" :answer/id #uuid "b27b7ca7-3a76-56c0-845b-41bdb8aea4a7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-a8d7e4db-ae01-5275-b4c8-0fd8386be685" :answer/id #uuid "a8d7e4db-ae01-5275-b4c8-0fd8386be685" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-f1a757e4-19f6-50f1-9887-1b2bae99eff0" :answer/id #uuid "f1a757e4-19f6-50f1-9887-1b2bae99eff0" :answer/type :answer.type/math :answer/value "49" :db/ensure [:answer/validate]} {:db/id "answer-ddf83f83-0973-5661-b724-fbd23032d35f" :answer/id #uuid "ddf83f83-0973-5661-b724-fbd23032d35f" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-645b2e7b-ed0a-5176-a522-b400791972fb" :answer/id #uuid "645b2e7b-ed0a-5176-a522-b400791972fb" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-43503f70-a039-563c-bedc-d1b2782aedca" :question/id #uuid "43503f70-a039-563c-bedc-d1b2782aedca" :question/math-academy-id "q-106884" :question/problem "What is the dimension of ${\\text{M}}_{4\\times 9}(R),$ the vector space of all $4\\times 9$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{4\\times 9}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{4\\times 9}(R))=4\\cdot 9=36.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fd01ea1f-a466-5fd9-8311-a2132252bc1b"] :db/ensure [:question/validate]} {:db/id "answer-field-fd01ea1f-a466-5fd9-8311-a2132252bc1b" :answer-field/id #uuid "fd01ea1f-a466-5fd9-8311-a2132252bc1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-eccebf2d-98a8-5ea0-a876-f56acb406b2d" :answer-field/choices ["answer-b7e18e7f-729e-5ce5-b8db-386712a47470" "answer-1eea31bf-e3b1-5614-bfbd-d7f54109fa12" "answer-8dc27688-e270-59b6-bbc0-9254bca9da7e" "answer-07714214-c4d9-5b08-a2c8-6c1f7e8ec203" "answer-eccebf2d-98a8-5ea0-a876-f56acb406b2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7e18e7f-729e-5ce5-b8db-386712a47470" :answer/id #uuid "b7e18e7f-729e-5ce5-b8db-386712a47470" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-1eea31bf-e3b1-5614-bfbd-d7f54109fa12" :answer/id #uuid "1eea31bf-e3b1-5614-bfbd-d7f54109fa12" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-8dc27688-e270-59b6-bbc0-9254bca9da7e" :answer/id #uuid "8dc27688-e270-59b6-bbc0-9254bca9da7e" :answer/type :answer.type/math :answer/value "22" :db/ensure [:answer/validate]} {:db/id "answer-07714214-c4d9-5b08-a2c8-6c1f7e8ec203" :answer/id #uuid "07714214-c4d9-5b08-a2c8-6c1f7e8ec203" :answer/type :answer.type/math :answer/value "34" :db/ensure [:answer/validate]} {:db/id "answer-eccebf2d-98a8-5ea0-a876-f56acb406b2d" :answer/id #uuid "eccebf2d-98a8-5ea0-a876-f56acb406b2d" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "question-2ca0b310-c54f-553d-a3d3-7e3881bc581e" :question/id #uuid "2ca0b310-c54f-553d-a3d3-7e3881bc581e" :question/math-academy-id "q-95215" :question/problem "What is the dimension of ${\\text{M}}_{3\\times 9}(R),$ the vector space of all $3\\times 9$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{3\\times 2}(R)$ contains $3\\cdot 2=6$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 0 & 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{3\\times 9}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{3\\times 9}(R))=3\\cdot 9=27.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3aaf5f5a-9372-5c9a-b844-dc81456ba76a"] :db/ensure [:question/validate]} {:db/id "answer-field-3aaf5f5a-9372-5c9a-b844-dc81456ba76a" :answer-field/id #uuid "3aaf5f5a-9372-5c9a-b844-dc81456ba76a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-44c5ae1a-9e7a-5d8b-ab09-dd7199e67922" :answer-field/choices ["answer-f454b9f0-465f-5b23-8ad6-a4f87f6b3abf" "answer-9af8d20b-17c6-5858-b1f2-709c110bbb7f" "answer-44c5ae1a-9e7a-5d8b-ab09-dd7199e67922" "answer-71c1cca6-df0f-5b2c-a21a-33d4064bd36c" "answer-8b3cea84-cf2c-5de8-8b3e-ec044d0938a9"] :db/ensure [:answer-field/validate]} {:db/id "answer-f454b9f0-465f-5b23-8ad6-a4f87f6b3abf" :answer/id #uuid "f454b9f0-465f-5b23-8ad6-a4f87f6b3abf" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-9af8d20b-17c6-5858-b1f2-709c110bbb7f" :answer/id #uuid "9af8d20b-17c6-5858-b1f2-709c110bbb7f" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-44c5ae1a-9e7a-5d8b-ab09-dd7199e67922" :answer/id #uuid "44c5ae1a-9e7a-5d8b-ab09-dd7199e67922" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "answer-71c1cca6-df0f-5b2c-a21a-33d4064bd36c" :answer/id #uuid "71c1cca6-df0f-5b2c-a21a-33d4064bd36c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-8b3cea84-cf2c-5de8-8b3e-ec044d0938a9" :answer/id #uuid "8b3cea84-cf2c-5de8-8b3e-ec044d0938a9" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-9ec0dc53-4341-5ee6-84a6-d12231a31e63" :question/id #uuid "9ec0dc53-4341-5ee6-84a6-d12231a31e63" :question/math-academy-id "q-106875" :question/problem "What is the dimension of ${\\text{M}}_{5\\times 1}(R),$ the vector space of all $5\\times 1$ matrices over $R?$" :question/worked-solution "The standard basis of ${\\text{M}}_{n\\times m}(R)$ contains a total of $n\\cdot m$ matrices, each with one nonzero entry that is equal to $1.$ \n\nThus, the standard basis of ${\\text{M}}_{5\\times 1}(R)$ contains $5\\cdot 1=5$ elements, and is given by\n\n$$\n\\{[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]\\}.\n$$\n\nTherefore, for ${\\text{M}}_{5\\times 1}(R),$ we have, indeed, \n\n$$\n\\text{dim}({\\text{M}}_{5\\times 1}(R))=5\\cdot 1=5.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fee18a9e-3a2d-5f93-9c78-89a367b51148"] :db/ensure [:question/validate]} {:db/id "answer-field-fee18a9e-3a2d-5f93-9c78-89a367b51148" :answer-field/id #uuid "fee18a9e-3a2d-5f93-9c78-89a367b51148" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e7eef5a1-6369-528c-8470-5e884104b19a" :answer-field/choices ["answer-f989d214-29fe-5513-93bb-4bb8188098f2" "answer-704ca1d5-8fbc-545a-a7fc-7fef0adaebcd" "answer-e7eef5a1-6369-528c-8470-5e884104b19a" "answer-48724e40-2537-5993-a9ac-f90136d4706d" "answer-ac081ada-e903-5cd6-86dc-983aac36c0ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-f989d214-29fe-5513-93bb-4bb8188098f2" :answer/id #uuid "f989d214-29fe-5513-93bb-4bb8188098f2" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-704ca1d5-8fbc-545a-a7fc-7fef0adaebcd" :answer/id #uuid "704ca1d5-8fbc-545a-a7fc-7fef0adaebcd" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "answer-e7eef5a1-6369-528c-8470-5e884104b19a" :answer/id #uuid "e7eef5a1-6369-528c-8470-5e884104b19a" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-48724e40-2537-5993-a9ac-f90136d4706d" :answer/id #uuid "48724e40-2537-5993-a9ac-f90136d4706d" :answer/type :answer.type/math :answer/value "51" :db/ensure [:answer/validate]} {:db/id "answer-ac081ada-e903-5cd6-86dc-983aac36c0ad" :answer/id #uuid "ac081ada-e903-5cd6-86dc-983aac36c0ad" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-ae384128-da5c-5a65-8194-114971516a6c" :question/id #uuid "ae384128-da5c-5a65-8194-114971516a6c" :question/math-academy-id "q-106909" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${ℓ}^{2},$ the vector space of infinite real sequences where the sum of the squares of the terms are finite\n\nII. ${R}_{200}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $200$\n\nIII. ${\\text{M}}_{400}(R),$ the vector space of all $400\\times 400$ matrices over $R$" :question/worked-solution "Let's examine our vector spaces.\n\n- ${ℓ}^{2}$ is *not* finite-dimensional. To understand why, we first note that the following subset of ${ℓ}^{2}$ is linearly independent: \n\n$$\n\\{{e}_{1},\\,{e}_{2},\\,…,{e}_{n}\\},\\,n\\in N\n$$\n\nwhere, for each $j\\in \\{1,2,…,n\\},$\n\n$$\n{e}_{j}=(0,…,0,\\,\\,\\,\\,\\,\\,\\,\\,\\,{1,}_{{↑}_{{j}^{\\text{th}}\\text{ position}}}\\,\\,\\,\\,\\,\\,\\,\\,0,…).\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{e}_{i}=0\n$$\n\nif and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${ℓ}^{2}$ of size $n,$ which imples that  ${ℓ}^{2}$ cannot have finite dimension.\n\n- ${R}_{200}[t]$ and ${\\text{M}}_{400}(R)$ are finite-dimensional. Indeed,\n\n$$\n\\text{dim}({R}_{200}[t])=200+1=201,\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{400}(R))=400\\cdot 400=160\\,000\n$$\n\n \nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-05ae62a1-afd4-5a8a-9171-ff9d830fc106"] :db/ensure [:question/validate]} {:db/id "answer-field-05ae62a1-afd4-5a8a-9171-ff9d830fc106" :answer-field/id #uuid "05ae62a1-afd4-5a8a-9171-ff9d830fc106" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-594364b2-4a97-5cb8-8885-eb54b077d39d" :answer-field/choices ["answer-00d5d53b-9cf4-514c-9b8a-86262156b32c" "answer-a41a0e66-d5c5-5bf7-bd1f-361b76eac535" "answer-cb655fa3-bc47-5d6a-a78a-558e30d1c629" "answer-594364b2-4a97-5cb8-8885-eb54b077d39d" "answer-fb3eec37-697c-58aa-a969-a676ed98da94"] :db/ensure [:answer-field/validate]} {:db/id "answer-00d5d53b-9cf4-514c-9b8a-86262156b32c" :answer/id #uuid "00d5d53b-9cf4-514c-9b8a-86262156b32c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-a41a0e66-d5c5-5bf7-bd1f-361b76eac535" :answer/id #uuid "a41a0e66-d5c5-5bf7-bd1f-361b76eac535" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-cb655fa3-bc47-5d6a-a78a-558e30d1c629" :answer/id #uuid "cb655fa3-bc47-5d6a-a78a-558e30d1c629" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-594364b2-4a97-5cb8-8885-eb54b077d39d" :answer/id #uuid "594364b2-4a97-5cb8-8885-eb54b077d39d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-fb3eec37-697c-58aa-a969-a676ed98da94" :answer/id #uuid "fb3eec37-697c-58aa-a969-a676ed98da94" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-df717d4d-32a8-529f-8ad7-781f9e19e4d5" :question/id #uuid "df717d4d-32a8-529f-8ad7-781f9e19e4d5" :question/math-academy-id "q-95387" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${\\text{M}}_{200\\times 800}(R),$ the vector space of all $200\\times 800$ matrices over $R$\n\nII. ${R}_{500}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $500$\n\nIII. ${L}^{1}([-1,1]),$ the vector space of all functions  $f:[-1,1]\\to R$ such that ${\\int }_{-1}^{1}|f(x)|\\,\\text{d}x<\\infty $" :question/worked-solution "Let's examine our vector spaces.\n\n- ${\\text{M}}_{200\\times 800}(R)$ and ${R}_{500}[t]$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{200\\times 800}(R))=200\\cdot 800=160\\,000\n$$\n\n \nand\n\n$$\n\\text{dim}({R}_{500}[t])=500+1=501,\n$$\n\nare both finite numbers.\n\n- ${L}^{1}([-1,1])$ is *not* finite-dimensional. To understand why, we first note that the following set of functions in ${L}^{1}([-1,1])$ is linearly independent: \n\n$$\n\\{1,\\,x,\\,{x}^{2},\\,…,{x}^{n}\\},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=1}^{n}{a}_{i}{x}^{i}=0\n$$\n\nfor all $x\\in [-1,1]$ if and only if ${a}_{i}=0$ for all $i=1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${L}^{1}([-1,1])$ of size $n,$ which imples that ${L}^{1}([-1,1])$ cannot have finite dimension.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-669252e0-c0d4-531b-90be-c655fcf428ed"] :db/ensure [:question/validate]} {:db/id "answer-field-669252e0-c0d4-531b-90be-c655fcf428ed" :answer-field/id #uuid "669252e0-c0d4-531b-90be-c655fcf428ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-421e0432-70af-50a9-82b2-f19fe9112141" :answer-field/choices ["answer-421e0432-70af-50a9-82b2-f19fe9112141" "answer-688dc251-c0d0-5865-9d76-ab3397fd5d9c" "answer-502d648a-8a08-58b8-9013-488b7bec9551" "answer-b0f8436b-d8f9-5750-be2a-bffca858b1ba" "answer-57f07402-e044-5281-893f-cc74f864e4c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-421e0432-70af-50a9-82b2-f19fe9112141" :answer/id #uuid "421e0432-70af-50a9-82b2-f19fe9112141" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-688dc251-c0d0-5865-9d76-ab3397fd5d9c" :answer/id #uuid "688dc251-c0d0-5865-9d76-ab3397fd5d9c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-502d648a-8a08-58b8-9013-488b7bec9551" :answer/id #uuid "502d648a-8a08-58b8-9013-488b7bec9551" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-b0f8436b-d8f9-5750-be2a-bffca858b1ba" :answer/id #uuid "b0f8436b-d8f9-5750-be2a-bffca858b1ba" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-57f07402-e044-5281-893f-cc74f864e4c9" :answer/id #uuid "57f07402-e044-5281-893f-cc74f864e4c9" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-317a01e3-d69d-5965-940a-bd52e056d6a6" :question/id #uuid "317a01e3-d69d-5965-940a-bd52e056d6a6" :question/math-academy-id "q-106906" :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${\\text{M}}_{500}(R),$ the vector space of all $500\\times 500$ matrices over $R$\n\nII. $C[0,1],$ the vector space of all continuous functions $f:[0,1]\\to R$\n\nIII. ${R}^{1500}$" :question/worked-solution "Let's examine our vector spaces.\n\n- ${\\text{M}}_{500}(R)$ and ${R}^{1500}$  are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{500}(R))={500}^{2}=250\\,000,\n$$\n\n \nand\n\n$$\n\\text{dim}({R}^{1500})=1\\,500\n$$\n\nare both finite numbers.\n\n- $C[0,1]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n\\{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}\\},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in [0,1]$ if and only if ${x}_{i}=0$ for all $i=0,1,2,…n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $C[0,1]$ of size $n,$ which imples that $C[0,1]$ cannot have finite dimension.\n\nTherefore, the correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d1e5ad85-7ea2-5e0e-ae4a-daf2ef96b515"] :db/ensure [:question/validate]} {:db/id "answer-field-d1e5ad85-7ea2-5e0e-ae4a-daf2ef96b515" :answer-field/id #uuid "d1e5ad85-7ea2-5e0e-ae4a-daf2ef96b515" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e64e39b4-5532-5b56-8d2b-5ff637bec572" :answer-field/choices ["answer-8188b47d-292e-5107-a0dc-807a7df0316b" "answer-e64e39b4-5532-5b56-8d2b-5ff637bec572" "answer-81d0a7c9-6149-530d-b21f-31487647862e" "answer-4518c433-5ce5-53b9-818b-7949053001bd" "answer-3352e7cc-48c1-5ba2-8c43-5a9a559c7959"] :db/ensure [:answer-field/validate]} {:db/id "answer-8188b47d-292e-5107-a0dc-807a7df0316b" :answer/id #uuid "8188b47d-292e-5107-a0dc-807a7df0316b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-e64e39b4-5532-5b56-8d2b-5ff637bec572" :answer/id #uuid "e64e39b4-5532-5b56-8d2b-5ff637bec572" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-81d0a7c9-6149-530d-b21f-31487647862e" :answer/id #uuid "81d0a7c9-6149-530d-b21f-31487647862e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-4518c433-5ce5-53b9-818b-7949053001bd" :answer/id #uuid "4518c433-5ce5-53b9-818b-7949053001bd" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-3352e7cc-48c1-5ba2-8c43-5a9a559c7959" :answer/id #uuid "3352e7cc-48c1-5ba2-8c43-5a9a559c7959" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186152876 :question/problem "Which of the following vector spaces are finite-dimensional?\n\nI. ${ℓ}^{2},$ the vector space of infinite real sequences where the sum of the squares of the terms are finite\n\nII. ${R}_{2}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $2$\n\nIII. ${\\text{M}}_{100\\times 1000}(R),$ the vector space of all $100\\times 1\\,000$ matrices over $R$" :question/worked-solution "Let's examine our vector spaces.\n\n- ${ℓ}^{2}$ is *not* finite-dimensional. To understand why, we first note that the following subset of ${ℓ}^{2}$ is linearly independent: \n\n$$\n\\{{e}_{1},\\,{e}_{2},\\,…,{e}_{n}\\},\\,n\\in N\n$$\n\nwhere, for each $j\\in \\{1,2,…,n\\},$\n\n$$\n{e}_{j}=(0,…,0,\\,\\,\\,\\,\\,\\,\\,\\,\\,{1,}_{{↑}_{{j}^{\\text{th}}\\text{ position}}}\\,\\,\\,\\,\\,\\,\\,\\,0,…).\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{x}_{i}{e}_{i}=0\n$$\n\nif and only if ${x}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of ${ℓ}^{2}$ of size $n,$ which imples that  ${ℓ}^{2}$ cannot have finite dimension.\n\n- ${R}_{2}[t]$ and ${\\text{M}}_{100\\times 1000}(R)$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}_{2}[t])=2+1=3,\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{100\\times 1000}(R))=100\\cdot 1\\,000=100\\,000\n$$\n\n \nare both finite numbers.\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186151763 :answer-field/correct 17592186151764 :db/ensure [:answer-field/validate]}]
