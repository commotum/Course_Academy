#uuid "7a06b367-5eab-5065-8142-84cad78fcfbd" :answer/type :answer.type/image :answer/value "images/2d/2dc7eb6d95c2bba3a4465a4631a0443addabf3ae728a7c99839a924fdf194eea.png" :db/ensure [:answer/validate]} {:db/id "answer-6fd30783-348c-5942-a986-7b78f40ac44d" :answer/id #uuid "6fd30783-348c-5942-a986-7b78f40ac44d" :answer/type :answer.type/image :answer/value "images/6c/6c7b719326bfa1a4b53fdf2bce3f6e7f1dafe5de2c994ffb4951a6d79af78707.png" :db/ensure [:answer/validate]} {:db/id "answer-ea9a6949-fbd4-547e-90dc-a32dfb549a7a" :answer/id #uuid "ea9a6949-fbd4-547e-90dc-a32dfb549a7a" :answer/type :answer.type/image :answer/value "images/d7/d79bee1dd235ec65dd14b1c99702b078f91654465dbc68b62237b09636ea8fa3.png" :db/ensure [:answer/validate]} {:db/id "answer-3901636e-8711-59fa-95da-dbb2e05a6300" :answer/id #uuid "3901636e-8711-59fa-95da-dbb2e05a6300" :answer/type :answer.type/image :answer/value "images/ef/ef27614aef03b1f1396a346e2b76eb17b65a3d07ed43ecc2a4c47fb4fdd02894.png" :db/ensure [:answer/validate]} {:db/id "question-b38c16c9-634c-5bda-ac99-e07bc23505a3" :question/id #uuid "b38c16c9-634c-5bda-ac99-e07bc23505a3" :question/math-academy-id "q-113334" :question/problem "Which of the following is the graph of $y=-\\frac{5}{x}?$" :question/worked-solution "To plot $y=-\\frac{5}{x},$ we apply the following steps:\n\n- Take the curve $y=-\\frac{1}{x}.$\n\n![](images/d5/d5d93e12275c683e0a56f0ec9a0c99540a7774879cd0f8fa69151ddba68a44fa.png)\n\n- Stretch the result by a scale factor of $5$ parallel to the $y$-axis to get the graph of $y=-\\frac{5}{x}.$\n\n![](images/7c/7ce9a42f05beeebb422c49e34670513a65a7183a51bd49fb2354e72f0942513e.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3cf5df72-e286-51fa-b6b6-9ce9d54e2f6e"] :db/ensure [:question/validate]} {:db/id "answer-field-3cf5df72-e286-51fa-b6b6-9ce9d54e2f6e" :answer-field/id #uuid "3cf5df72-e286-51fa-b6b6-9ce9d54e2f6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-50263177-969a-554f-955c-1d4b670a6267" :answer-field/choices ["answer-50263177-969a-554f-955c-1d4b670a6267" "answer-145e240d-ec0d-58e4-bdf4-04a11c1ea4dd" "answer-e02ca879-2052-5d4c-84fc-0627f3e13907" "answer-78921e95-9093-5ecf-823b-3e067f4f7685" "answer-d42145aa-6706-540b-bc60-a73e3f4fa6eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-50263177-969a-554f-955c-1d4b670a6267" :answer/id #uuid "50263177-969a-554f-955c-1d4b670a6267" :answer/type :answer.type/image :answer/value "images/4a/4abc3f445c414e77fd52c09725ec1b14ecf37eb8fff961e83c20c7f9806731ee.png" :db/ensure [:answer/validate]} {:db/id "answer-145e240d-ec0d-58e4-bdf4-04a11c1ea4dd" :answer/id #uuid "145e240d-ec0d-58e4-bdf4-04a11c1ea4dd" :answer/type :answer.type/image :answer/value "images/8a/8a669e6d3bf5233aaf59eff15f9af36a011c8a27b8d0f48bdf24bb7930725bd5.png" :db/ensure [:answer/validate]} {:db/id "answer-e02ca879-2052-5d4c-84fc-0627f3e13907" :answer/id #uuid "e02ca879-2052-5d4c-84fc-0627f3e13907" :answer/type :answer.type/image :answer/value "images/93/934e658f9d8f0b5ab34706397fd8e7bf4d2a34a5ce04f8faa7403810bb9e5b79.png" :db/ensure [:answer/validate]} {:db/id "answer-78921e95-9093-5ecf-823b-3e067f4f7685" :answer/id #uuid "78921e95-9093-5ecf-823b-3e067f4f7685" :answer/type :answer.type/image :answer/value "images/ba/bad3df07757e6183f94a84168823975702946c6b9726c95fb1e76d7065b51eaf.png" :db/ensure [:answer/validate]} {:db/id "answer-d42145aa-6706-540b-bc60-a73e3f4fa6eb" :answer/id #uuid "d42145aa-6706-540b-bc60-a73e3f4fa6eb" :answer/type :answer.type/image :answer/value "images/d5/d5d93e12275c683e0a56f0ec9a0c99540a7774879cd0f8fa69151ddba68a44fa.png" :db/ensure [:answer/validate]} {:db/id "question-3ce08e84-b291-5c5a-ac58-9e142f6fb8a7" :question/id #uuid "3ce08e84-b291-5c5a-ac58-9e142f6fb8a7" :question/math-academy-id "q-270753" :question/problem "![](images/84/84c4df89c98cd103049ac6161c5d3e4eec258d3ecb3c1af94bf7d300f9342d22.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What are the values of $a,$ $b,$ and $k?$\n\n$a=$\n{{field-1}},$\\,b=$\n{{field-2}},$\\,k=$\n{{field-3}}" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=1.5,$ while the vertical asymptote is $x=-1.$ This means that $k=1.5$ and $b=-1,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-(-1)}+1.5=\\frac{a}{x+1}+1.5.\n$$\n\nAlso, we are given that the point $(1,3.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x+1}+1.5 \\\\ 3.5 & =\\frac{a}{1+1}+1.5 \\\\ 2 & =\\frac{a}{2} \\\\ a & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-4f66befd-be45-5c10-a46a-921be5c7d226" "answer-field-887368ab-3a85-523d-a904-ef84af68ef2e" "answer-field-40d7c4e5-3f33-5e32-a43f-784a1408b1a6"] :db/ensure [:question/validate]} {:db/id "answer-field-4f66befd-be45-5c10-a46a-921be5c7d226" :answer-field/id #uuid "4f66befd-be45-5c10-a46a-921be5c7d226" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-447610bd-011b-5941-900a-08f48f1ec880" :answer-field/choices ["answer-447610bd-011b-5941-900a-08f48f1ec880"] :db/ensure [:answer-field/validate]} {:db/id "answer-447610bd-011b-5941-900a-08f48f1ec880" :answer/id #uuid "447610bd-011b-5941-900a-08f48f1ec880" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-887368ab-3a85-523d-a904-ef84af68ef2e" :answer-field/id #uuid "887368ab-3a85-523d-a904-ef84af68ef2e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-153166f5-8ea1-5f50-8ca0-0ac7dbf239d6" :answer-field/choices ["answer-153166f5-8ea1-5f50-8ca0-0ac7dbf239d6"] :db/ensure [:answer-field/validate]} {:db/id "answer-153166f5-8ea1-5f50-8ca0-0ac7dbf239d6" :answer/id #uuid "153166f5-8ea1-5f50-8ca0-0ac7dbf239d6" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-field-40d7c4e5-3f33-5e32-a43f-784a1408b1a6" :answer-field/id #uuid "40d7c4e5-3f33-5e32-a43f-784a1408b1a6" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-85a7519b-236e-5167-bf36-7acc2fbd12a6" :answer-field/choices ["answer-85a7519b-236e-5167-bf36-7acc2fbd12a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-85a7519b-236e-5167-bf36-7acc2fbd12a6" :answer/id #uuid "85a7519b-236e-5167-bf36-7acc2fbd12a6" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "question-0afab3eb-630e-58a0-8be5-5f624db42ba7" :question/id #uuid "0afab3eb-630e-58a0-8be5-5f624db42ba7" :question/math-academy-id "q-113475" :question/problem "![](images/fc/fc0ad365fca91e61da2e7f09197299ea6130018d7490873d3568231be360b481.png)\n\nThe diagram above shows the graph of $y=\\frac{a}{x}.$ What is the value of $a?$" :question/worked-solution "Notice that the point $(3,-1)$ lies on the graph.\n\nSubstituting its coordinates into the equation $y=\\frac{a}{x},$ we obtain \n\n$$\n\\begin{aligned}-1=\\frac{a}{3}\\,⟹\\,a=-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1915a924-8b95-58f0-84a6-218999796b6c"] :db/ensure [:question/validate]} {:db/id "answer-field-1915a924-8b95-58f0-84a6-218999796b6c" :answer-field/id #uuid "1915a924-8b95-58f0-84a6-218999796b6c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b7a03d0f-dc32-5657-be13-40db2364f8ad" :answer-field/choices ["answer-b7a03d0f-dc32-5657-be13-40db2364f8ad" "answer-b825340d-a071-5920-ba75-a41a15299a12" "answer-24d40f9b-0372-5ede-9fdd-abafcda394fd" "answer-61bb5b4e-5071-54e6-9b66-6c673dd707e4" "answer-40d40356-40b7-5340-9313-8f98a64c0983"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7a03d0f-dc32-5657-be13-40db2364f8ad" :answer/id #uuid "b7a03d0f-dc32-5657-be13-40db2364f8ad" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-b825340d-a071-5920-ba75-a41a15299a12" :answer/id #uuid "b825340d-a071-5920-ba75-a41a15299a12" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-24d40f9b-0372-5ede-9fdd-abafcda394fd" :answer/id #uuid "24d40f9b-0372-5ede-9fdd-abafcda394fd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-61bb5b4e-5071-54e6-9b66-6c673dd707e4" :answer/id #uuid "61bb5b4e-5071-54e6-9b66-6c673dd707e4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-40d40356-40b7-5340-9313-8f98a64c0983" :answer/id #uuid "40d40356-40b7-5340-9313-8f98a64c0983" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186068982 :activity/expected-seconds 540.0 :db/ensure [:activity/validate]} {:db/id 17592186087831 :knowledge-point/questions ["question-c582f0f1-f871-50b8-b88f-03165acfd197" "question-00a59ef1-c144-5d9f-b94c-7d377a8424ae" "question-23728b9f-173c-56ba-ae78-f4addd3b788e" "question-1ef76044-e494-5a9c-b8eb-8a5d68b12c3b" "question-e7468eec-835f-58ac-adfb-8c025bf94873"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087436 :question/problem "What are the coordinates of the vertex of the parabola $y=-3(x+5)^2-4?$" :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^2 + k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-3(x+5)^2-4\n$$\n\nis written in vertex form with $h=-5$ and $k=-4.$ To see this clearly, note that we can write the parabola as follows:\n\n$$\ny=-3(x-(-5))^2-4\n$$\n\nTherefore, the vertex of the parabola is at $(-5,-4).$" :db/ensure [:question/validate]} {:db/id 17592186087885 :knowledge-point/questions ["question-791380d3-6e81-592a-9d95-9f0a6153a5e2" "question-4df53049-83f0-5413-984e-828686fce8c5" "question-29b03696-3c9f-5636-9c19-2a6a7c7c486b" "question-0632da5c-9a68-5b87-b79c-de6c52b69ed8" "question-8594afb6-5972-53f6-b33b-4159f91dec13"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087445 :question/problem "What is the axis of symmetry of the parabola $y=4(x-3)^2+2?$" :question/worked-solution "The axis of symmetry of the parabola is the vertical line that passes through the vertex of the parabola. To find the axis of symmetry, we need to compute the $x$-coordinate of the vertex of the parabola.\n\nRemember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^2 + k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=4(x-3)^2+2\n$$\n\nis written in vertex form with $h=3$ and $k=2.$ Therefore, the vertex of the parabola is at $(3,2),$ and the axis of symmetry is $x=3.$" :db/ensure [:question/validate]} {:db/id 17592186087803 :knowledge-point/questions ["question-44eed42c-2275-58db-b76f-79ce8ef867da" "question-6d0de4b8-6fc5-5dcf-a220-ce0c3dea2116" "question-ecb40e2d-67b0-50de-be66-e4bed789b5a0" "question-b8aee55c-aa76-53a1-afb7-e8a42dc37dcd" "question-3968dfc0-a6cb-5c0d-a0d8-393a6ade59fc"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186087631 :question/problem "Find the minimum value of the parabola ![](images/d3/d30006cd23eb5bc4fab41b442fa7559a396842e82c35c3a481533208827abe28.svg) sketched below.\n\n![](images/1a/1af23738cbe57195d1bf4dc223c37fab61cb89058388445a67eadeaab88a14bd.png)" :question/worked-solution "The minimum value of the parabola is the ![](images/1d/1d9b846cface9f9348e4081a0dd87dd254bf26663c12aa0d1a15aa24d2393261.svg)-coordinate of the vertex of the parabola. \n\nRemember that the vertex form of a parabola is\n\n![](images/c5/c53ff35f8ae40bcb44f4cf26ad7f0d1bed0dabc73298562d7041cc90a0b1de3c.svg)\n\nwhere ![](images/3a/3a6333dccc007be0992f95974a58ce3d652e5ecafcaaa865a24ff8b42bcfc37a.svg) are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n![](images/21/211afc137cc4072f18eb008836b3f2d8c231aa5ae017476147b0b50014525f39.svg)\n\nis written in vertex form with ![](images/03/033a93fcdc4a0358a5de03cbdda9860a8ac6aa6a735f3681a6477c3a3e52ea55.svg) and ![](images/10/1027d08706beef7b1afa836932edaac3ebad0885bb8a2be54860dc768d431ff9.svg) Therefore, the vertex of the parabola is at ![](images/79/795920c332cb28b6b824a8b84b1226b6d1e5b5f890e16ecd6752ce6fd619e37e.svg) and its minimum value is ![](images/d4/d44d7e189fa83441142c19838f09553ff4b73fba09689c5a04d1a6eaf5fef088.svg)" :db/ensure [:question/validate]} {:db/id "question-c582f0f1-f871-50b8-b88f-03165acfd197" :question/id #uuid "c582f0f1-f871-50b8-b88f-03165acfd197" :question/math-academy-id "q-46174" :question/problem "What are the coordinates of the vertex of the parabola $y=-(x+2)^{2}+3?$" :question/worked-solution "Remember that the vertex form of a parabola is \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $(h,k)$ are the coordinates of the vertex of the parabola.\n\nThe given parabola\n\n$$\ny=-(x+2)^{2}+3\n$$\n\nis written in vertex form with $h=-2$ and $k=3.$ To see this clearly, note that we can write the parabola as follows:\n\n$$\ny=-(x-(-2))^{2}+3\n$$\n\nTherefore, the vertex of the parabola is at $(-2,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4c32a66a-9074-5966-b6db-d71011681b35"] :db/ensure [:question/validate]} {:db/id "answer-field-4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/id #uuid "4c32a66a-9074-5966-b6db-d71011681b35" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" :answer-field/choices ["answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" "answer-04e8a8a8-3706-59fe-a287-2a770b8419fa" "answer-002bd208-8560-5adc-9a07-c761d0d84b1e" "answer-10cee7e7-895a-5600-9a5e-f6a9b7a42e32" "answer-4499f164-f227-50e5-9214-5ca31d20414f"] :db/ensure [:answer-field/validate]} {:db/id "answer-1eff41e0-f9b3-51c5-a29a-c4ce22da8c59" :answer/id #uuid "1eff41e0-f9b3-51c5-a29a-c