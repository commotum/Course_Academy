0 & 0\\end{aligned}].\n$$\n\nThe other options will not give us a matrix in row echelon form." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-de4fc53f-c634-517f-a9b7-42dd47f2728a"] :db/ensure [:question/validate]} {:db/id "answer-field-de4fc53f-c634-517f-a9b7-42dd47f2728a" :answer-field/id #uuid "de4fc53f-c634-517f-a9b7-42dd47f2728a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-08d1fbc2-6117-52d5-8883-b20223ce70dc" :answer-field/choices ["answer-82a81ba6-608a-5bfc-9694-f732ba6a3899" "answer-f7f7a5af-493f-5609-ab37-94f3a13073ad" "answer-08d1fbc2-6117-52d5-8883-b20223ce70dc" "answer-d958ba51-de3f-5ad7-8df6-f295b9861b5f" "answer-2d728ed9-041b-593d-be9f-38c92dad943c"] :db/ensure [:answer-field/validate]} {:db/id "answer-82a81ba6-608a-5bfc-9694-f732ba6a3899" :answer/id #uuid "82a81ba6-608a-5bfc-9694-f732ba6a3899" :answer/type :answer.type/text :answer/value "${a}_{32}$ and ${a}_{41}$ only" :db/ensure [:answer/validate]} {:db/id "answer-f7f7a5af-493f-5609-ab37-94f3a13073ad" :answer/id #uuid "f7f7a5af-493f-5609-ab37-94f3a13073ad" :answer/type :answer.type/text :answer/value "${a}_{32}$ and ${a}_{43}$ only" :db/ensure [:answer/validate]} {:db/id "answer-08d1fbc2-6117-52d5-8883-b20223ce70dc" :answer/id #uuid "08d1fbc2-6117-52d5-8883-b20223ce70dc" :answer/type :answer.type/text :answer/value "${a}_{32},$ ${a}_{41},$ and ${a}_{43}$ only" :db/ensure [:answer/validate]} {:db/id "answer-d958ba51-de3f-5ad7-8df6-f295b9861b5f" :answer/id #uuid "d958ba51-de3f-5ad7-8df6-f295b9861b5f" :answer/type :answer.type/text :answer/value "${a}_{41}$ and ${a}_{43}$ only" :db/ensure [:answer/validate]} {:db/id "answer-2d728ed9-041b-593d-be9f-38c92dad943c" :answer/id #uuid "2d728ed9-041b-593d-be9f-38c92dad943c" :answer/type :answer.type/text :answer/value "${a}_{41}$ only" :db/ensure [:answer/validate]} {:db/id "question-9819b3cb-3630-5a45-9bc0-6e0504ec0eb9" :question/id #uuid "9819b3cb-3630-5a45-9bc0-6e0504ec0eb9" :question/math-academy-id "q-73150" :question/problem "Consider the matrix $A$ given below.\nWhich entries of $A$ could be replaced by $0$ in order to get a matrix in row echelon form?\n\n$$\nA=[\\begin{aligned}0 & 4 & 2 & 1 \\\\ 3 & 0 & 2 & 0 \\\\ 1 & 0 & 0 & -3 \\\\ 0 & -2 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Notice that by replacing ${a}_{21},$ ${a}_{31},$ and ${a}_{42}$ with $0$, we get a matrix in row echelon form:\n\n$$\nA=[\\begin{aligned}0 & 4 & 2 & 1 \\\\ 3 & 0 & 2 & 0 \\\\ 1 & 0 & 0 & -3 \\\\ 0 & -2 & 0 & 0\\end{aligned}]\\,⟶\\,[\\begin{aligned}0 & 4 & 2 & 1 \\\\ 0 & 0 & 2 & 0 \\\\ 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$\n\nThe other options will not give us a matrix in row echelon form." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9f58c044-7102-5f1c-8521-3340f455b815"] :db/ensure [:question/validate]} {:db/id "answer-field-9f58c044-7102-5f1c-8521-3340f455b815" :answer-field/id #uuid "9f58c044-7102-5f1c-8521-3340f455b815" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-154a3b69-8d33-55f3-80a2-1c717e20183d" :answer-field/choices ["answer-d118477c-7302-5af0-b802-c432c9686acc" "answer-013fbc5e-337f-5b35-8b41-4fcf05372c6c" "answer-8a76ddb7-f9f0-5c13-91e1-6b980ea5642c" "answer-154a3b69-8d33-55f3-80a2-1c717e20183d" "answer-17e3e547-83cd-521d-98f0-bae284124909"] :db/ensure [:answer-field/validate]} {:db/id "answer-d118477c-7302-5af0-b802-c432c9686acc" :answer/id #uuid "d118477c-7302-5af0-b802-c432c9686acc" :answer/type :answer.type/text :answer/value "${a}_{21}$ and ${a}_{31}$ only" :db/ensure [:answer/validate]} {:db/id "answer-013fbc5e-337f-5b35-8b41-4fcf05372c6c" :answer/id #uuid "013fbc5e-337f-5b35-8b41-4fcf05372c6c" :answer/type :answer.type/text :answer/value "${a}_{21}$ and ${a}_{42}$ only" :db/ensure [:answer/validate]} {:db/id "answer-8a76ddb7-f9f0-5c13-91e1-6b980ea5642c" :answer/id #uuid "8a76ddb7-f9f0-5c13-91e1-6b980ea5642c" :answer/type :answer.type/text :answer/value "${a}_{21},$ ${a}_{23},$ and ${a}_{42}$ only" :db/ensure [:answer/validate]} {:db/id "answer-154a3b69-8d33-55f3-80a2-1c717e20183d" :answer/id #uuid "154a3b69-8d33-55f3-80a2-1c717e20183d" :answer/type :answer.type/text :answer/value "${a}_{21},$ ${a}_{31},$ and ${a}_{42}$ only" :db/ensure [:answer/validate]} {:db/id "answer-17e3e547-83cd-521d-98f0-bae284124909" :answer/id #uuid "17e3e547-83cd-521d-98f0-bae284124909" :answer/type :answer.type/text :answer/value "${a}_{31}$ and ${a}_{42}$ only" :db/ensure [:answer/validate]} {:db/id 17592186130339 :tutorial/content "Consider the following matrices:\n![](images/10/1074870d255109821b5f36eb517f22531efbd8f5069f05c3de3f111b38befd02.svg)\n\nThe first non-zero entry on each row (from left to right) is called the **leading entry** of that row.\n\n- In the matrix $A,$ the leading entries are $a_{11}=2,$ $a_{22}=3,$ $a_{32}=1,$ and $a_{43}=5.$\n\n- In the matrix $B,$ the leading entries are $b_{11}=1,$ $b_{22}=3,$ $b_{33}=-2,$ and $b_{44}=2.$ The $5$th row has no leading entry.\n\nThe leading entries are highlighted below.\n\n![](images/6b/6b1d99269c847f7c6bc0558da347fb300dba5fa6caf373cd1ed5cc5ebacb1649.svg)" :db/ensure [:tutorial/validate]} {:db/id 17592186130380 :tutorial/content "Let's consider our matrices $A$ and $B$ once more, with the leading entries highlighted.\n\n![](images/af/af61f32297e248ab9989ba59ea6c9bda2f99efe19d25df525fef916617843a32.svg)\n\nWe say that a matrix is in **row echelon form** if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nHere, $B$ is in row echelon form since both conditions are satisfied. However, $A$ is not in row echelon form since condition II is violated: the leading entry of the third row $(a_{32}={\\color{red}1})$ is placed just below the leading entry of the second row $(a_{22}=3).$\n\nGenerally speaking, row echelon form means that we have *stairs* where each step (represented by a leading entry $\\bbox[lightgray, 3pt]{\\large\\ast}$) has a height of $1.$\n\n![](images/67/67f83c454e59d16ae80cf67a19b19f968182251a2e5d1b405e2c422e0313d5b7.png)\n\nFinally, an *augmented* matrix is in row echelon form if the coefficient matrix (i.e., the part that is to the left of the vertical bar) is in row echelon form." :db/ensure [:tutorial/validate]} {:db/id "activity-3ac737cb-b32d-58dc-ba42-b833532d93f2" :activity/id #uuid "3ac737cb-b32d-58dc-ba42-b833532d93f2" :activity/title "Surface Integrals Over Cartesian Surfaces" :activity/type :activity.type/review :activity/scope 17592186049883 :activity/course 17592186046669 :activity/steps ["step-5fb58ad1-daad-579d-a191-cd0292817ee4" "step-d5d2810c-5c56-5d95-a7e4-0edf466646f6" "step-784b7a95-1f46-5188-b188-bf78d31f758a" "step-3f225278-6b20-57ac-a9cd-9df424ded6b7" "step-27963efa-77a1-57bc-b124-d998a9e3d683"] :activity/first-step "step-5fb58ad1-daad-579d-a191-cd0292817ee4" :db/ensure [:activity/validate]} {:db/id "step-5fb58ad1-daad-579d-a191-cd0292817ee4" :step/id #uuid "5fb58ad1-daad-579d-a191-cd0292817ee4" :step/content 17592186106057 :step/next "step-d5d2810c-5c56-5d95-a7e4-0edf466646f6" :db/ensure [:step/validate]} {:db/id "step-d5d2810c-5c56-5d95-a7e4-0edf466646f6" :step/id #uuid "d5d2810c-5c56-5d95-a7e4-0edf466646f6" :step/content 17592186106062 :step/next "step-784b7a95-1f46-5188-b188-bf78d31f758a" :db/ensure [:step/validate]} {:db/id "step-784b7a95-1f46-5188-b188-bf78d31f758a" :step/id #uuid "784b7a95-1f46-5188-b188-bf78d31f758a" :step/content 17592186534983 :step/next "step-3f225278-6b20-57ac-a9cd-9df424ded6b7" :db/ensure [:step/validate]} {:db/id "step-3f225278-6b20-57ac-a9cd-9df424ded6b7" :step/id #uuid "3f225278-6b20-57ac-a9cd-9df424ded6b7" :step/content 17592186535075 :step/next "step-27963efa-77a1-57bc-b124-d998a9e3d683" :db/ensure [:step/validate]} {:db/id "step-27963efa-77a1-57bc-b124-d998a9e3d683" :step/id #uuid "27963efa-77a1-57bc-b124-d998a9e3d683" :step/content 17592186535047 :db/ensure [:step/validate]} {:db/id 17592186087844 :knowledge-point/questions ["question-4c74e25d-895a-5838-9281-315f3c190014"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4c74e25d-895a-5838-9281-315f3c190014" :question/id #uuid "4c74e25d-895a-5838-9281-315f3c190014" :question/math-academy-id "q-80678" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{x-1}{{x}^{3}-2{x}^{2}+3x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-1}{{x}^{3}-2{x}^{2}+3x} \\\\  & =\\frac{x-1}{x({x}^{2}-2x+3)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx({x}^{2}-2x+3)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x=0$ gives the solution $x=0.$\n\n- The equation ${x}^{2}-2x+3=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-2)^{2}-4(1)(3) \\\\  & =4-12 \\\\  & =-8\\end{aligned}\n$$\n\nTherefore, the only vertical asymptote is $x=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-92a7d330-f172-52c6-b231-05809763df8c"] :db/ensure [:question/validate]} {:db/id "answer-field-92a7d330-f172-52c6-b231-05809763df8c" :answer-field/id #uuid "92a7d330-f172-52c6-b231-05809763df8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9a525491-4e0c-5dc0-b10d-ff5b7fcb4ad5" :answer-field/choices ["answer-35c729a0-c7ea-5011-a804-71e03289e149" "answer-3090ddd4-ba21-512c-990d-47