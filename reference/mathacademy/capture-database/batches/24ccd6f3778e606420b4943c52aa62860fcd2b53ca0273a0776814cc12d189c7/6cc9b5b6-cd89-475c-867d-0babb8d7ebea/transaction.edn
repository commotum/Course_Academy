r-field/correct "answer-9fa5cf22-9fbc-5faa-a78b-7a79de5312d4" :answer-field/choices ["answer-2295c34e-a5a6-5064-ae4f-207dc76752bd" "answer-1ff1a342-4d50-5ec8-8116-f8352d78a1a2" "answer-fd2249eb-aa40-543d-acda-2311030e2556" "answer-c0c69163-b00f-58d2-9ead-f4267caae5a1" "answer-9fa5cf22-9fbc-5faa-a78b-7a79de5312d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-2295c34e-a5a6-5064-ae4f-207dc76752bd" :answer/id #uuid "2295c34e-a5a6-5064-ae4f-207dc76752bd" :answer/type :answer.type/math :answer/value "x\\in (-1,3)" :db/ensure [:answer/validate]} {:db/id "answer-1ff1a342-4d50-5ec8-8116-f8352d78a1a2" :answer/id #uuid "1ff1a342-4d50-5ec8-8116-f8352d78a1a2" :answer/type :answer.type/math :answer/value "x\\in (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-fd2249eb-aa40-543d-acda-2311030e2556" :answer/id #uuid "fd2249eb-aa40-543d-acda-2311030e2556" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-1)\\cup (3,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-c0c69163-b00f-58d2-9ead-f4267caae5a1" :answer/id #uuid "c0c69163-b00f-58d2-9ead-f4267caae5a1" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2)" :db/ensure [:answer/validate]} {:db/id "answer-9fa5cf22-9fbc-5faa-a78b-7a79de5312d4" :answer/id #uuid "9fa5cf22-9fbc-5faa-a78b-7a79de5312d4" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-ae8713d7-4691-5e08-870e-3fc604e3a336" :question/id #uuid "ae8713d7-4691-5e08-870e-3fc604e3a336" :question/math-academy-id "q-250599" :question/problem "Find the range of the function $f(x)=5(x+1)^{2}+8.$\n\n{{field-1}}\n$\\le f(x)$\n{{field-2}}{{field-3}}" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex.\n\n- Since $h=-1$ and $k=8,$ the vertex is $(-1,8).$\n\n- Since $a=5>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output.\n\nTherefore, the range is $[8,\\infty ),$ i.e. $8\\le f(x)<\\infty .$\n\nThe corresponding diagram is shown below.\n\n![](images/7f/7ff6f49b63c4ad55324bbb406558781c9f3e5af3a98d34b285c65f88746bddab.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-14dd9f6b-b90d-536d-a13a-6a8b2fd1a148" "answer-field-88ae973c-62f9-56f2-a4a1-2371757dfc39" "answer-field-2d759167-da63-50ff-b449-46e9207401d6"] :db/ensure [:question/validate]} {:db/id "answer-field-14dd9f6b-b90d-536d-a13a-6a8b2fd1a148" :answer-field/id #uuid "14dd9f6b-b90d-536d-a13a-6a8b2fd1a148" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b0550c3e-d926-5110-81d5-70fdbb769ee0" :answer-field/choices ["answer-b0550c3e-d926-5110-81d5-70fdbb769ee0"] :db/ensure [:answer-field/validate]} {:db/id "answer-b0550c3e-d926-5110-81d5-70fdbb769ee0" :answer/id #uuid "b0550c3e-d926-5110-81d5-70fdbb769ee0" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-field-88ae973c-62f9-56f2-a4a1-2371757dfc39" :answer-field/id #uuid "88ae973c-62f9-56f2-a4a1-2371757dfc39" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3b03abe2-8172-576d-97e4-0f4f7c428220" :answer-field/choices ["answer-3b03abe2-8172-576d-97e4-0f4f7c428220"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b03abe2-8172-576d-97e4-0f4f7c428220" :answer/id #uuid "3b03abe2-8172-576d-97e4-0f4f7c428220" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "answer-field-2d759167-da63-50ff-b449-46e9207401d6" :answer-field/id #uuid "2d759167-da63-50ff-b449-46e9207401d6" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2cf36b9c-d2df-5984-9e40-401bf59336ca" :answer-field/choices ["answer-2cf36b9c-d2df-5984-9e40-401bf59336ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cf36b9c-d2df-5984-9e40-401bf59336ca" :answer/id #uuid "2cf36b9c-d2df-5984-9e40-401bf59336ca" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id 17592186124866 :question/problem "What is the range of the function $f(x)={(x+\\frac{5}{6})}^{2}-\\frac{1}{2}?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-\\frac{5}{6}$ and $k=-\\frac{1}{2},$ the vertex is $(-\\frac{5}{6},-\\frac{1}{2}).$\n\n- Since $a=1>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output.\n\nTherefore, the range is $[-\\frac{1}{2},\\infty ).$ \n\n![](images/54/54e0b0ea5dd498a36fc854781dc5120ce1de9bee0c333eecc6d895ce09b72424.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186121796 :answer-field/correct "answer-a19b54fd-b859-58ec-9f48-c6622db47056" :answer-field/choices ["answer-b8a8d8b1-1116-562c-9eac-92b96751313a" "answer-4e47ff5f-6b08-5d07-a62a-c241fb59bdf0" "answer-25995585-8181-58ec-9ca2-df6919080cd3" "answer-a19b54fd-b859-58ec-9f48-c6622db47056" "answer-e364e522-0636-5c3f-b534-a21b5528a7bf"] :db/ensure [:answer-field/validate]} {:db/id "answer-b8a8d8b1-1116-562c-9eac-92b96751313a" :answer/id #uuid "b8a8d8b1-1116-562c-9eac-92b96751313a" :answer/type :answer.type/math :answer/value "(-\\frac{1}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-4e47ff5f-6b08-5d07-a62a-c241fb59bdf0" :answer/id #uuid "4e47ff5f-6b08-5d07-a62a-c241fb59bdf0" :answer/type :answer.type/math :answer/value "(-\\infty ,-\\frac{1}{2}]" :db/ensure [:answer/validate]} {:db/id "answer-25995585-8181-58ec-9ca2-df6919080cd3" :answer/id #uuid "25995585-8181-58ec-9ca2-df6919080cd3" :answer/type :answer.type/math :answer/value "(-\\infty ,\\frac{5}{6}]" :db/ensure [:answer/validate]} {:db/id "answer-a19b54fd-b859-58ec-9f48-c6622db47056" :answer/id #uuid "a19b54fd-b859-58ec-9f48-c6622db47056" :answer/type :answer.type/math :answer/value "[-\\frac{1}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-e364e522-0636-5c3f-b534-a21b5528a7bf" :answer/id #uuid "e364e522-0636-5c3f-b534-a21b5528a7bf" :answer/type :answer.type/math :answer/value "[-\\frac{5}{6},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-a24bba0b-6082-5434-98a9-2578424db732" :question/id #uuid "a24bba0b-6082-5434-98a9-2578424db732" :question/math-academy-id "q-106279" :question/problem "What is the range of the function $f(x)=\\frac{1}{2}(x-8)^{2}-18?$" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=8$ and $k=-18,$ the vertex is $(8,-18).$\n\n- Since $a=\\frac{1}{2}>0,$ the parabola opens upwards.\n\nBecause the parabola opens upwards, there is no maximum output, and the vertex corresponds to the minimum output. \n\nTherefore, the range is $[-18,\\infty ).$\n\nThe corresponding diagram is shown below.\n\n![](images/a1/a115822cf26b79f0b25ed5493f5951c71c02c6ef5a4d576d101b4bc580d5da9f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c7d9884e-0ead-53ae-8a5b-cde350ebf44a"] :db/ensure [:question/validate]} {:db/id "answer-field-c7d9884e-0ead-53ae-8a5b-cde350ebf44a" :answer-field/id #uuid "c7d9884e-0ead-53ae-8a5b-cde350ebf44a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3a31478e-4c7c-5de1-8fad-3638ee4a8f27" :answer-field/choices ["answer-3a31478e-4c7c-5de1-8fad-3638ee4a8f27" "answer-8a2b0a49-4051-52d2-805a-b79331b4101a" "answer-d9c83282-9161-5639-be3f-86063ce871cd" "answer-8d0e44e7-7189-5fcd-aa1a-51e9e932ef54" "answer-20198d03-e820-5496-9e93-29432b8ff469"] :db/ensure [:answer-field/validate]} {:db/id "answer-3a31478e-4c7c-5de1-8fad-3638ee4a8f27" :answer/id #uuid "3a31478e-4c7c-5de1-8fad-3638ee4a8f27" :answer/type :answer.type/math :answer/value "[-18,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-8a2b0a49-4051-52d2-805a-b79331b4101a" :answer/id #uuid "8a2b0a49-4051-52d2-805a-b79331b4101a" :answer/type :answer.type/math :answer/value "[-8,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-d9c83282-9161-5639-be3f-86063ce871cd" :answer/id #uuid "d9c83282-9161-5639-be3f-86063ce871cd" :answer/type :answer.type/math :answer/value "[-9,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-8d0e44e7-7189-5fcd-aa1a-51e9e932ef54" :answer/id #uuid "8d0e44e7-7189-5fcd-aa1a-51e9e932ef54" :answer/type :answer.type/math :answer/value "[4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-20198d03-e820-5496-9e93-29432b8ff469" :answer/id #uuid "20198d03-e820-5496-9e93-29432b8ff469" :answer/type :answer.type/math :answer/value "[8,\\infty )" :db/ensure [:answer/validate]} {:db/id "question-2002fa84-a05e-5e54-ad18-933be8248d10" :question/id #uuid "2002fa84-a05e-5e54-ad18-933be8248d10" :question/math-academy-id "q-250607" :question/problem "Find the range of the function $f(x)=-3(x+5)^{2}+7.$\n\n{{field-1}}{{field-2}}\n$f(x)\\le $\n{{field-3}}" :question/worked-solution "The parabola is written in vertex form, \n\n$$\ny=a(x-h)^{2}+k,\n$$\n\nwhere $a$ is the leading coefficient and $(h,k)$ is the vertex. \n\n- Since $h=-5$ and $k=7,$ the vertex is $(-5,7).$\n\n- Since $a=-3<0,$ the parabola opens downwards.\n\nBecause the parabola opens downwards, there is no minimum output, and the vertex corresponds to the maximum output.\n\nTherefore, the range is $(-\\infty ,7],$ i.e. $-\\infty <f(x)\\le 7.$\n\nThe corresponding diagram is shown below.\n\n![](images/25/252a3c0475f838b1835f2da9c3c818a938c916b781c5abaa1f12ed09c52c56f6.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-56f50417-a8db-5569-b297-00307ac7e3ed" "answer-field-e90fc8d9-ab85-53eb-b3c7-