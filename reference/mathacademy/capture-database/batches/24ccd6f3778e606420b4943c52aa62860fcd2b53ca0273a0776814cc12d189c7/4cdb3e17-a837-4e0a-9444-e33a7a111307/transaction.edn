8a6"] :db/ensure [:question/validate]} {:db/id "answer-field-e29f424f-71fa-5ce6-a697-ab8b93c418a6" :answer-field/id #uuid "e29f424f-71fa-5ce6-a697-ab8b93c418a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-73a723a3-8cff-5a15-b741-6f6044bdef48" :answer-field/choices ["answer-73a723a3-8cff-5a15-b741-6f6044bdef48" "answer-2d021253-7df2-5464-9178-35a626b44f93" "answer-4dc863c8-ca1c-5f30-ab79-a7a81a707dd5" "answer-c4d53989-5718-5924-bfd9-3c8e58a253e5" "answer-9cba564e-a6ed-532c-983c-2eea1eb2a4db"] :db/ensure [:answer-field/validate]} {:db/id "answer-73a723a3-8cff-5a15-b741-6f6044bdef48" :answer/id #uuid "73a723a3-8cff-5a15-b741-6f6044bdef48" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt[3]{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2d021253-7df2-5464-9178-35a626b44f93" :answer/id #uuid "2d021253-7df2-5464-9178-35a626b44f93" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt[3]{2}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4dc863c8-ca1c-5f30-ab79-a7a81a707dd5" :answer/id #uuid "4dc863c8-ca1c-5f30-ab79-a7a81a707dd5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt[3]{4}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c4d53989-5718-5924-bfd9-3c8e58a253e5" :answer/id #uuid "c4d53989-5718-5924-bfd9-3c8e58a253e5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-9cba564e-a6ed-532c-983c-2eea1eb2a4db" :answer/id #uuid "9cba564e-a6ed-532c-983c-2eea1eb2a4db" :answer/type :answer.type/math :answer/value "\\sqrt[3]{2}" :db/ensure [:answer/validate]} {:db/id "question-a6d47759-e842-511b-a810-c9880823e33f" :question/id #uuid "a6d47759-e842-511b-a810-c9880823e33f" :question/math-academy-id "q-94643" :question/problem "Find the median of the random variable $X$ if the probability density function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}0,\\, & x<1, \\\\ \\frac{6}{{x}^{7}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "The median of a random variable $X$ is the number $m$ such that\n\n$$\nP(X\\le m)=\\frac{1}{2}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}P(X\\le m) & ={\\int }_{1}^{m}\\frac{6}{{x}^{7}}\\,\\text{d}x \\\\  & ={-\\frac{1}{{x}^{6}}|}_{1}^{m} \\\\  & =1-\\frac{1}{{m}^{6}}\\end{aligned}\n$$\n\nTherefore, the median is given by\n\n$$\n\\begin{aligned}1-\\frac{1}{{m}^{6}} & =\\frac{1}{2} \\\\ \\frac{1}{{m}^{6}} & =\\frac{1}{2} \\\\ m & =\\sqrt[6]{2}.\\end{aligned}\n$$\n\nNote that we took the positive root because $m\\ge 1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b8a4324b-f75b-536e-a236-773728d8dd8c"] :db/ensure [:question/validate]} {:db/id "answer-field-b8a4324b-f75b-536e-a236-773728d8dd8c" :answer-field/id #uuid "b8a4324b-f75b-536e-a236-773728d8dd8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-363228b0-4656-5329-a192-45892c7d79d9" :answer-field/choices ["answer-96e7c5e2-f3f8-5e51-b430-7a56684e572f" "answer-5aeaf22f-9630-5a12-b24d-c6bcd8eefbd3" "answer-363228b0-4656-5329-a192-45892c7d79d9" "answer-24d9537c-4c6a-5bea-9084-7453673af462" "answer-9e404460-a0c2-5106-8aa8-4891726e0ffc"] :db/ensure [:answer-field/validate]} {:db/id "answer-96e7c5e2-f3f8-5e51-b430-7a56684e572f" :answer/id #uuid "96e7c5e2-f3f8-5e51-b430-7a56684e572f" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt[6]{2}}" :db/ensure [:answer/validate]} {:db/id "answer-5aeaf22f-9630-5a12-b24d-c6bcd8eefbd3" :answer/id #uuid "5aeaf22f-9630-5a12-b24d-c6bcd8eefbd3" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt[6]{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-363228b0-4656-5329-a192-45892c7d79d9" :answer/id #uuid "363228b0-4656-5329-a192-45892c7d79d9" :answer/type :answer.type/math :answer/value "\\sqrt[6]{2}" :db/ensure [:answer/validate]} {:db/id "answer-24d9537c-4c6a-5bea-9084-7453673af462" :answer/id #uuid "24d9537c-4c6a-5bea-9084-7453673af462" :answer/type :answer.type/math :answer/value "\\sqrt[6]{2}+1" :db/ensure [:answer/validate]} {:db/id "answer-9e404460-a0c2-5106-8aa8-4891726e0ffc" :answer/id #uuid "9e404460-a0c2-5106-8aa8-4891726e0ffc" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "question-714df0ea-5d53-53df-b0aa-14ba037b9bde" :question/id #uuid "714df0ea-5d53-53df-b0aa-14ba037b9bde" :question/math-academy-id "q-94628" :question/problem "Find the median of the random variable $X$ if the probability density function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}0,\\, & x<1, \\\\ \\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "The median of a random variable $X$ is the number $m$ such that\n\n$$\nP(X\\le m)=\\frac{1}{2}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}P(X\\le m) & ={\\int }_{1}^{m}\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{m}\\frac{1}{2}{x}^{-3/2}\\,\\text{d}x \\\\  & =-{x}^{-1/2}{|}_{1}^{m} \\\\  & =1-\\frac{1}{\\sqrt{m}}\\end{aligned}\n$$\n\nTherefore, the median is given by\n\n$$\n\\begin{aligned}1-\\frac{1}{\\sqrt{m}} & =\\frac{1}{2} \\\\ \\frac{1}{\\sqrt{m}} & =\\frac{1}{2} \\\\ \\sqrt{m} & =2 \\\\ m & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-188532e0-67bb-558a-be7e-da0adb86d8b6"] :db/ensure [:question/validate]} {:db/id "answer-field-188532e0-67bb-558a-be7e-da0adb86d8b6" :answer-field/id #uuid "188532e0-67bb-558a-be7e-da0adb86d8b6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-12b5e394-80fe-57dd-9cb9-ba6e9edd273b" :answer-field/choices ["answer-bd99344b-9ee9-5c83-8690-084c2fcd7f3f" "answer-1befb3a2-1a61-55a8-b311-dd29e1df21d0" "answer-12b5e394-80fe-57dd-9cb9-ba6e9edd273b" "answer-36753d1f-fd75-589a-8fb3-f329088220f1" "answer-2c6f4537-9695-5450-99bf-8967143319f9"] :db/ensure [:answer-field/validate]} {:db/id "answer-bd99344b-9ee9-5c83-8690-084c2fcd7f3f" :answer/id #uuid "bd99344b-9ee9-5c83-8690-084c2fcd7f3f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-1befb3a2-1a61-55a8-b311-dd29e1df21d0" :answer/id #uuid "1befb3a2-1a61-55a8-b311-dd29e1df21d0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-12b5e394-80fe-57dd-9cb9-ba6e9edd273b" :answer/id #uuid "12b5e394-80fe-57dd-9cb9-ba6e9edd273b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-36753d1f-fd75-589a-8fb3-f329088220f1" :answer/id #uuid "36753d1f-fd75-589a-8fb3-f329088220f1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2c6f4537-9695-5450-99bf-8967143319f9" :answer/id #uuid "2c6f4537-9695-5450-99bf-8967143319f9" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "question-a4e71952-c18f-5e5a-8bbb-dfd0f7ad678f" :question/id #uuid "a4e71952-c18f-5e5a-8bbb-dfd0f7ad678f" :question/math-academy-id "q-125714" :question/problem "Find, to three decimal places, the interquartile range of the random variable $X$ if the cumulative distribution function of $X$ is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<1, \\\\ \\frac{{x}^{2}-1}{8}, & 1\\le x\\le 3, \\\\ 1, & x>3.\\end{aligned}\n$$" :question/worked-solution "To find the interquartile range, we first need to find the lower quartile and the upper quartile.\n\nThe lower quartile of a random variable $X$ is the number ${q}_{1}$ such that\n\n$$\nP(X\\le {q}_{1})=\\frac{1}{4},\n$$\n\nand the upper quartile is the number ${q}_{3}$ such that\n\n$$\nP(X\\le {q}_{3})=\\frac{3}{4}.\n$$\n\nFirst, we find the lower quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{1}) & =\\frac{1}{4} \\\\ F({q}_{1}) & =\\frac{1}{4} \\\\ \\frac{{q}_{1}^{2}-1}{8} & =\\frac{1}{4} \\\\ {q}_{1}^{2}-1 & =2 \\\\ {q}_{1}^{2} & =3 \\\\ {q}_{1} & =\\sqrt{3}\\end{aligned}\n$$\n\nNote that we take the root ${q}_{1}=\\sqrt{3}$ because $1\\le {q}_{1}\\le 3.$\n\nThen, we find the upper quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{3}) & =\\frac{3}{4} \\\\ F({q}_{3}) & =\\frac{3}{4} \\\\ \\frac{{q}_{3}^{2}-1}{8} & =\\frac{3}{4} \\\\ {q}_{3}^{2}-1 & =6 \\\\ {q}_{3}^{2} & =7 \\\\ {q}_{3} & =\\sqrt{7}\\end{aligned}\n$$\n\nNote that we take the root ${q}_{3}=\\sqrt{7}$ because $1\\le {q}_{3}\\le 3.$\n\nTherefore, the interquartile range is\n\n$$\n\\begin{aligned}IQR & ={q}_{3}-{q}_{1} \\\\  & =\\sqrt{7}-\\sqrt{3} \\\\  & ≈0.914\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b9ae13b6-0cd2-543d-bcb7-22657b86dffb"] :db/ensure [:question/validate]} {:db/id "answer-field-b9ae13b6-0cd2-543d-bcb7-22657b86dffb" :answer-field/id #uuid "b9ae13b6-0cd2-543d-bcb7-22657b86dffb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-46b4ec8e-c3e5-5ae6-b5f1-963f8b25be11" :answer-field/choices ["answer-46b4ec8e-c3e5-5ae6-b5f1-963f8b25be11" "answer-498a13e5-8c2e-5df6-a277-b267feb9d7dd" "answer-f0867a0c-eac5-5b6a-a170-f2f1b279db70" "answer-eea8253c-9a91-5eee-8af4-be3818d42829" "answer-fa202739-d377-52d8-acd5-26cb18c3a306"] :db/ensure [:answer-field/validate]} {:db/id "answer-46b4ec8e-c3e5-5ae6-b5f1-963f8b25be11" :answer/id #uuid "46b4ec8e-c3e5-5ae6-b5f1-963f8b25be11" :answer/type :answer.type/math :answer/value "0.914" :db/ensure [:answer/validate]} {:db/id "answer-498a13e5-8c2e-5df6-a277-b267feb9d7dd" :answer/id #uuid "498a13e5-8c2e-5df6-a277-b267feb9d7dd" :answer/type :answer.type/math :answer/value "1.732" :db/ensure [:answer/validate]} {:db/id "answer-f0867a0c-eac5-5b6a-a170-f2f1b279db70" :answer/id #uuid "f0867a0c-eac5-5b6a-a170-f2f1b279db70" :answer/type :answer.type/math :answer/value "1.914" :db/ensure [:answer/validate]} {:db/id "answer-eea8253c-9a91-5eee-8af4-be3818d42829" :answer/id #uuid "eea8253c-9a91-5eee-8af4-be3818d42829" :answer/type :answer.type/math :answer/value "2.646" :db/ensure [:answer/validate]} {:db/id "answer-fa202739-d377-52d8-acd5-26cb18c3a306" :answer/id #uuid "fa202739-d377-52d8-acd5-26cb18c3a306" :answer/type :answer.type/math :answer/value "2.914" :db/ensure [:answer/validate]} {:db/id 17592186162641 :question/problem "Find the interquartile range of the random variable $X$ if the cumulative distribution function of $X$ is given by\n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<1, \\\\ 1-{e}^{1-x},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "To find the interquartile range, we first need to find the lower quartile and the upper quartile.\n\nThe lower quartile of a random variable $X$ is the number ${q}_{1}$ such that\n\n$$\nP(X\\le {q}_{1})=\\frac{1}{4},\n$$\n\nand the upper quartile is the number ${q}_{3}$ such that\n\n$$\nP(X\\le {q}_{3})=\\frac{3}{4}.\n$$\n\nFirst, we find the lower quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{1}) & =\\frac{1}{4} \\\\ F({q}_{1}) & =\\frac{1}{4} \\\\ 1-{e}^{1-{q}_{1}} & =\\frac{1}{4} \\\\ {e}^{1-{q}_{1}} & =\\frac{3}{4} \\\\ 1-{q}_{1} & =\\operatorname{ln}⁡(\\frac{3}{4}) \\\\ {q}_{1} & =1-\\operatorname{ln}⁡(\\frac{3}{4})\\end{aligned}\n$$\n\nThen, we find the upper quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{3}) & =\\frac{3}{4} \\\\ F({q}_{3}) & =\\frac{3}{4} \\\\ 1-{e}^{1-{q}_{3}} & =\\frac{3}{4} \\\\ {e}^{1-{q}_{3}} & =\\frac{1}{4} \\\\ 1-{q}_{3} & =\\operatorname{ln}⁡(\\frac{1}{4}) \\\\ {q}_{3} & =1-\\operatorname{ln}⁡(\\frac{1}{4})\\end{aligned}\n$$\n\nTherefore, the interquartile range is\n\n$$\n\\begin{aligned}IQR & ={q}_{3}-{q}_{1} \\\\  & =1-\\operatorname{ln}⁡(\\frac{1}{4})-(1-\\operatorname{ln}⁡(\\frac{3}{4})) \\\\  & =\\operatorname{ln}⁡(\\frac{3}{4})-\\operatorname{ln}⁡(\\frac{1}{4}) \\\\  & =\\operatorname{ln}⁡(3).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186161138 :answer-field/correct "answer-4dcdd795-b4e2-5697-a229-4d5c328622b1" :answer-field/choices ["answer-8a57ef84-dc66-5261-bb34-5e50fd7f3719" "answer-4dcdd795-b4e2-5697-a229-4d5c328622b1" "answer-28f8e7b0-163f-5d34-82c2-5019a5d8f120" "answer-ee44477a-a24b-5936-8441-328751567d0c" "answer-03758742-4e66-5fc5-b8d2-c064330220a0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8a57ef84-dc66-5261-bb34-5e50fd7f3719" :answer/id #uuid "8a57ef84-dc66-5261-bb34-5e50fd7f3719" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(2)" :db/ensure [:answer/validate]} {:db/id "answer-4dcdd795-b4e2-5697-a229-4d5c328622b1" :answer/id #uuid "4dcdd795-b4e2-5697-a229-4d5c328622b1" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "answer-28f8e7b0-163f-5d34-82c2-5019a5d8f120" :answer/id #uuid "28f8e7b0-163f-5d34-82c2-5019a5d8f120" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3)-\\operatorname{ln}⁡(4)" :db/ensure [:answer/validate]} {:db/id "answer-ee44477a-a24b-5936-8441-328751567d0c" :answer/id #uuid "ee44477a-a24b-5936-8441-328751567d0c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(4)" :db/ensure [:answer/validate]} {:db/id "answer-03758742-4e66-5fc5-b8d2-c064330220a0" :answer/id #uuid "03758742-4e66-5fc5-b8d2-c064330220a0" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(4)-\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "question-dfe1ae13-0566-5996-84a0-b50d07468365" :question/id #uuid "dfe1ae13-0566-5996-84a0-b50d07468365" :question/math-academy-id "q-94665" :question/problem "Find, to three decimal places, the interquartile range of the random variable $X$ if the cumulative distribution function of $X$ is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<1, \\\\ 1-\\frac{1}{{x}^{2}}, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "To find the interquartile range, we first need to find the lower quartile and the upper quartile.\n\nThe lower quartile of a random variable $X$ is the number ${q}_{1}$ such that\n\n$$\nP(X\\le {q}_{1})=\\frac{1}{4},\n$$\n\nand the upper quartile is the number ${q}_{3}$ such that\n\n$$\nP(X\\le {q}_{3})=\\frac{3}{4}.\n$$\n\nFirst, we find the lower quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{1}) & =\\frac{1}{4} \\\\ F({q}_{1}) & =\\frac{1}{4} \\\\ 1-\\frac{1}{{{q}_{1}}^{2}} & =\\frac{1}{4} \\\\ \\frac{1}{{{q}_{1}}^{2}} & =\\frac{3}{4} \\\\ {q}_{1} & =\\frac{2}{\\sqrt{3}}\\end{aligned}\n$$\n\nThen, we find the upper quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{3}) & =\\frac{3}{4} \\\\ F({q}_{3}) & =\\frac{3}{4} \\\\ 1-\\frac{1}{{{q}_{3}}^{2}} & =\\frac{3}{4} \\\\ \\frac{1}{{{q}_{3}}^{2}} & =\\frac{1}{4} \\\\ {q}_{3} & =2\\end{aligned}\n$$\n\nTherefore, the interquartile range is\n\n$$\nIQR={q}_{3}-{q}_{1}=2-\\frac{2}{\\sqrt{3}}≈0.845\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-21dc5a83-34c9-5825-801d-d29b40f9fa03"] :db/ensure [:question/validate]} {:db/id "answer-field-21dc5a83-34c9-5825-801d-d29b40f9fa03" :answer-field/id #uuid "21dc5a83-34c9-5825-801d-d29b40f9fa03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b64a068-c831-5808-ab82-de97a974bd21" :answer-field/choices ["answer-6b64a068-c831-5808-ab82-de97a974bd21" "answer-e6e51d8b-3554-5198-9a2b-299876c96962" "answer-9b54931e-4f66-558e-ac52-6088a647f3b4" "answer-039f35c0-9f74-51e8-b87c-18c9a10f1560" "answer-b12e960b-3cf9-57eb-a9a7-8546ad220ea8"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b64a068-c831-5808-ab82-de97a974bd21" :answer/id #uuid "6b64a068-c831-5808-ab82-de97a974bd21" :answer/type :answer.type/math :answer/value "0.845" :db/ensure [:answer/validate]} {:db/id "answer-e6e51d8b-3554-5198-9a2b-299876c96962" :answer/id #uuid "e6e51d8b-3554-5198-9a2b-299876c96962" :answer/type :answer.type/math :answer/value "0.854" :db/ensure [:answer/validate]} {:db/id "answer-9b54931e-4f66-558e-ac52-6088a647f3b4" :answer/id #uuid "9b54931e-4f66-558e-ac52-6088a647f3b4" :answer/type :answer.type/math :answer/value "1.485" :db/ensure [:answer/validate]} {:db/id "answer-039f35c0-9f74-51e8-b87c-18c9a10f1560" :answer/id #uuid "039f35c0-9f74-51e8-b87c-18c9a10f1560" :answer/type :answer.type/math :answer/value "1.855" :db/ensure [:answer/validate]} {:db/id "answer-b12e960b-3cf9-57eb-a9a7-8546ad220ea8" :answer/id #uuid "b12e960b-3cf9-57eb-a9a7-8546ad220ea8" :answer/type :answer.type/math :answer/value "3.885" :db/ensure [:answer/validate]} {:db/id "question-7e41b2e9-6ace-571f-a3ef-6f43b41df0ec" :question/id #uuid "7e41b2e9-6ace-571f-a3ef-6f43b41df0ec" :question/math-academy-id "q-125712" :question/problem "Find, to three decimal places, the interquartile range of the random variable $X$ if the cumulative distribution function of $X$ is given by\n\n$$\nF(x)=\\{\\begin{aligned}0,\\, & x<0, \\\\ {x}^{2},\\, & 0\\le x\\le 1, \\\\ 1,\\, & x>1.\\end{aligned}\n$$" :question/worked-solution "To find the interquartile range, we first need to find the lower quartile and the upper quartile.\n\nThe lower quartile of a random variable $X$ is the number ${q}_{1}$ such that\n\n$$\nP(X\\le {q}_{1})=\\frac{1}{4},\n$$\n\nand the upper quartile is the number ${q}_{3}$ such that\n\n$$\nP(X\\le {q}_{3})=\\frac{3}{4}.\n$$\n\nFirst, we find the lower quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{1}) & =\\frac{1}{4} \\\\ F({q}_{1}) & =\\frac{1}{4} \\\\ {q}_{1}^{2} & =\\frac{1}{4} \\\\ {q}_{1} & =\\frac{1}{2}\\end{aligned}\n$$\n\nNote that we take the root ${q}_{1}=\\frac{1}{2}$ because $0\\le {q}_{1}\\le 1.$\n\nThen, we find the upper quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{3}) & =\\frac{3}{4} \\\\ F({q}_{3}) & =\\frac{3}{4} \\\\ {q}_{3}^{2} & =\\frac{3}{4} \\\\ {q}_{3} & =\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nNote that we take the root ${q}_{3}=\\frac{\\sqrt{3}}{2}$ because $0\\le {q}_{3}\\le 1.$\n\nTherefore, the interquartile range is\n\n$$\n\\begin{aligned}IQR & ={q}_{3}-{q}_{1} \\\\  & =\\frac{\\sqrt{3}}{2}-\\frac{1}{2} \\\\  & =\\frac{\\sqrt{3}-1}{2} \\\\  & ≈0.366\\end{aligned}\n$$\n\nrounded to three decimal places." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e78defba-5c7e-59d1-ab03-e4daad3cbc4a"] :db/ensure [:question/validate]} {:db/id "answer-field-e78defba-5c7e-59d1-ab03-e4daad3cbc4a" :answer-field/id #uuid "e78defba-5c7e-59d1-ab03-e4daad3cbc4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-211a57e2-d8aa-54b1-beea-511b212443ba" :answer-field/choices ["answer-63d5bd69-c3d3-5125-9e45-bc46319d3648" "answer-211a57e2-d8aa-54b1-beea-511b212443ba" "answer-a2ccde35-6145-571f-8819-7dd62e2850da" "answer-eb32e82a-d0cc-5c35-890f-63bb77ee3f7a" "answer-59225a5a-4de1-5b47-a565-1141167812b3"] :db/ensure [:answer-field/validate]} {:db/id "answer-63d5bd69-c3d3-5125-9e45-bc46319d3648" :answer/id #uuid "63d5bd69-c3d3-5125-9e45-bc46319d3648" :answer/type :answer.type/math :answer/value "0.352" :db/ensure [:answer/validate]} {:db/id "answer-211a57e2-d8aa-54b1-beea-511b212443ba" :answer/id #uuid "211a57e2-d8aa-54b1-beea-511b212443ba" :answer/type :answer.type/math :answer/value "0.366" :db/ensure [:answer/validate]} {:db/id "answer-a2ccde35-6145-571f-8819-7dd62e2850da" :answer/id #uuid "a2ccde35-6145-571f-8819-7dd62e2850da" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "answer-eb32e82a-d0cc-5c35-890f-63bb77ee3f7a" :answer/id #uuid "eb32e82a-d0cc-5c35-890f-63bb77ee3f7a" :answer/type :answer.type/math :answer/value "0.636" :db/ensure [:answer/validate]} {:db/id "answer-59225a5a-4de1-5b47-a565-1141167812b3" :answer/id #uuid "59225a5a-4de1-5b47-a565-1141167812b3" :answer/type :answer.type/math :answer/value "0.666" :db/ensure [:answer/validate]} {:db/id "question-3ca6810e-a219-54cd-a8c8-f575cfccdc55" :question/id #uuid "3ca6810e-a219-54cd-a8c8-f575cfccdc55" :question/math-academy-id "q-125734" :question/problem "Find the interquartile range of the random variable $X$ if the cumulative distribution function of $X$ is given by\n\n$$\nF(x)=\\{\\begin{aligned}0, & x<4, \\\\ 1-\\frac{16}{{x}^{2}}, & x\\ge 4.\\end{aligned}\n$$" :question/worked-solution "To find the interquartile range, we first need to find the lower quartile and the upper quartile.\n\nThe lower quartile of a random variable $X$ is the number ${q}_{1}$ such that\n\n$$\nP(X\\le {q}_{1})=\\frac{1}{4},\n$$\n\nand the upper quartile is the number ${q}_{3}$ such that\n\n$$\nP(X\\le {q}_{3})=\\frac{3}{4}.\n$$\n\nFirst, we find the lower quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{1}) & =\\frac{1}{4} \\\\ F({q}_{1}) & =\\frac{1}{4} \\\\ 1-\\frac{16}{{q}_{1}^{2}} & =\\frac{1}{4} \\\\ \\frac{16}{{q}_{1}^{2}} & =\\frac{3}{4} \\\\ {q}_{1} & =\\frac{8\\sqrt{3}}{3}\\end{aligned}\n$$\n\nThen, we find the upper quartile:\n\n$$\n\\begin{aligned}P(X\\le {q}_{3}) & =\\frac{3}{4} \\\\ F({q}_{3}) & =\\frac{3}{4} \\\\ 1-\\frac{16}{{q}_{3}^{2}} & =\\frac{3}{4} \\\\ \\frac{16}{{q}_{3}^{2}} & =\\frac{1}{4} \\\\ {q}_{3} & =8\\end{aligned}\n$$\n\nTherefore, the interquartile range is\n\n$$\nIQR={q}_{3}-{q}_{1}=8-\\frac{8\\sqrt{3}}{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-27de064b-78af-5768-96b1-07df8a910cb1"] :db/ensure [:question/validate]} {:db/id "answer-field-27de064b-78af-5768-96b1-07df8a910cb1" :answer-field/id #uuid "27de064b-78af-5768-96b1-07df8a910cb1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c843aa7c-b566-56a4-85c9-ca8a883dcd9d" :answer-field/choices ["answer-26b1582a-fe2a-5af4-bba0-1ac6960815b1" "answer-c843aa7c-b566-56a4-85c9-ca8a883dcd9d" "answer-4485f3aa-42b6-5b6c-aa2f-0f673aee9fae" "answer-955ec2a1-769b-5ec3-89e8-df042128fed6" "answer-c16c04c9-0dbf-58fd-b26e-3de9324026c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-26b1582a-fe2a-5af4-bba0-1ac6960815b1" :answer/id #uuid "26b1582a-fe2a-5af4-bba0-1ac6960815b1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-c843aa7c-b566-56a4-85c9-ca8a883dcd9d" :answer/id #uuid "c843aa7c-b566-56a4-85c9-ca8a883dcd9d" :answer/type :answer.type/math :answer/value "8-\\frac{8\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4485f3aa-42b6-5b6c-aa2f-0f673aee9fae" :answer/id #uuid "4485f3aa-42b6-5b6c-aa2f-0f673aee9fae" :answer/type :answer.type/math :answer/value "8-\\frac{\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-955ec2a1-769b-5ec3-89e8-df042128fed6" :answer/id #uuid "955ec2a1-769b-5ec3-89e8-df042128fed6" :answer/type :answer.type/math :answer/value "\\frac{8\\sqrt{3}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-c16c04c9-0dbf-58fd-b26e-3de9324026c8" :answer/id #uuid "c16c04c9-0dbf-58fd-b26e-3de9324026c8" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "question-2f4c7c35-e12b-53f3-8c46-ab140e4e9992" :question/id #uuid "2f4c7c35-e12b-53f3-8c46-ab140e4e9992" :question/math-academy-id "q-125522" :question/problem "Find the $25$th percentile of the random variable $X$ if the probability distribution function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{x}{2}-1,\\, & 2<x<4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The $100p$th percentile of a random variable $X$ is the number ${x}_{p}$ such that\n\n$$\nP(X\\le {x}_{p})=p.\n$$\n\nIn our case, we want to find the $25$th percentile, which corresponds to the decimal $p=0.25.$ We have\n\n$$\n\\begin{aligned}P(X\\le {x}_{0.25}) & ={\\int }_{2}^{{x}_{0.25}}(\\frac{x}{2}-1)\\,\\text{d}x \\\\  & ={(\\frac{{x}^{2}}{4}-x)|}_{2}^{{x}_{0.25}} \\\\  & =\\frac{{x}_{0.25}^{2}}{4}-{x}_{0.25}-(\\frac{(2)^{2}}{4}-2) \\\\  & =\\frac{{x}_{0.25}^{2}}{4}-{x}_{0.25}+1.\\end{aligned}\n$$\n\nTherefore, the $25$th percentile is given by\n\n$$\n\\begin{aligned}\\frac{{x}_{0.25}^{2}}{4}-{x}_{0.25}+1 & =0.25 \\\\ {x}_{0.25}^{2}-4{x}_{0.25}+3 & =0 \\\\ ({x}_{0.25}-3)({x}_{0.25}-1) & =0 \\\\ {x}_{0.25}=1,\\,3.\\end{aligned}\n$$\n\nNote that we take the root ${x}_{0.25}=3$ because $2<{x}_{0.25}<4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b10b6ffb-517f-5a7d-bbbf-4ef4514dfdb7"] :db/ensure [:question/validate]} {:db/id "answer-field-b10b6ffb-517f-5a7d-bbbf-4ef4514dfdb7" :answer-field/id #uuid "b10b6ffb-517f-5a7d-bbbf-4ef4514dfdb7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84c31569-5f15-5e6c-9553-68211785d8f4" :answer-field/choices ["answer-c2733038-517d-5d08-9a0f-39b2b10dae78" "answer-c753b103-766c-5196-b73c-9776711e2c3f" "answer-0e85e52c-8e08-56c8-8b37-5f17ff7f2785" "answer-13548f7f-10aa-5faa-8652-5d6f71f80b0b" "answer-84c31569-5f15-5e6c-9553-68211785d8f4"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2733038-517d-5d08-9a0f-39b2b10dae78" :answer/id #uuid "c2733038-517d-5d08-9a0f-39b2b10dae78" :answer/type :answer.type/math :answer/value "1+\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-c753b103-766c-5196-b73c-9776711e2c3f" :answer/id #uuid "c753b103-766c-5196-b73c-9776711e2c3f" :answer/type :answer.type/math :answer/value "1-\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-0e85e52c-8e08-56c8-8b37-5f17ff7f2785" :answer/id #uuid "0e85e52c-8e08-56c8-8b37-5f17ff7f2785" :answer/type :answer.type/math :answer/value "2-\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-13548f7f-10aa-5faa-8652-5d6f71f80b0b" :answer/id #uuid "13548f7f-10aa-5faa-8652-5d6f71f80b0b" :answer/type :answer.type/math :answer/value "2\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "answer-84c31569-5f15-5e6c-9553-68211785d8f4" :answer/id #uuid "84c31569-5f15-5e6c-9553-68211785d8f4" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186162644 :question/problem "Find the $30$th percentile of the random variable $Y$ if the probability distribution function of $Y$ is given by\n\n$$\nf(y)=\\{\\begin{aligned}{e}^{-y},\\, & y\\ge 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The $100p$th percentile of a random variable $Y$ is the number ${y}_{p}$ such that\n\n$$\nP(Y\\le {y}_{p})=p.\n$$\n\nIn our case, we want to find the $30$th percentile, which corresponds to the decimal $p=0.3.$ We have\n\n$$\n\\begin{aligned}P(Y\\le {y}_{0.3}) & ={\\int }_{0}^{{y}_{0.3}}{e}^{-y}\\,\\text{d}y \\\\  & =-{e}^{-y}{|}_{0}^{{y}_{0.3}} \\\\  & =1-{e}^{-{y}_{0.3}}.\\end{aligned}\n$$\n\nTherefore, the $30$th percentile is given by\n\n$$\n\\begin{aligned}1-{e}^{-{y}_{0.3}} & =0.3 \\\\ {e}^{-{y}_{0.3}} & =0.7 \\\\ {e}^{-{y}_{0.3}} & =\\frac{7}{10} \\\\ -{y}_{0.3} & =\\operatorname{ln}⁡(\\frac{7}{10}) \\\\ {y}_{0.3} & =\\operatorname{ln}⁡(\\frac{10}{7}) \\\\ {y}_{0.3} & =\\operatorname{ln}⁡(10)-\\operatorname{ln}⁡(7).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186161156 :answer-field/correct "answer-fc18e48a-eca0-55b3-8692-d7cfbe38ebd3" :answer-field/choices ["answer-3dd3667f-22b1-5593-a711-58ec7a41392e" "answer-fc18e48a-eca0-55b3-8692-d7cfbe38ebd3" "answer-29a3ec05-1796-5998-8e30-938d46d50a1c" "answer-a0567618-3fff-5bf8-8a81-37e04f3d33bf" "answer-39494504-cec8-5020-9908-1c5cb6914a17"] :db/ensure [:answer-field/validate]} {:db/id "answer-3dd3667f-22b1-5593-a711-58ec7a41392e" :answer/id #uuid "3dd3667f-22b1-5593-a711-58ec7a41392e" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(10)-\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "answer-fc18e48a-eca0-55b3-8692-d7cfbe38ebd3" :answer/id #uuid "fc18e48a-eca0-55b3-8692-d7cfbe38ebd3" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(10)-\\operatorname{ln}⁡(7)" :db/ensure [:answer/validate]} {:db/id "answer-29a3ec05-1796-5998-8e30-938d46d50a1c" :answer/id #uuid "29a3ec05-1796-5998-8e30-938d46d50a1c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3)-\\operatorname{ln}⁡(10)" :db/ensure [:answer/validate]} {:db/id "answer-a0567618-3fff-5bf8-8a81-37e04f3d33bf" :answer/id #uuid "a0567618-3fff-5bf8-8a81-37e04f3d33bf" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(7)-\\operatorname{ln}⁡(10)" :db/ensure [:answer/validate]} {:db/id "answer-39494504-cec8-5020-9908-1c5cb6914a17" :answer/id #uuid "39494504-cec8-5020-9908-1c5cb6914a17" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(7)-\\operatorname{ln}⁡(3)" :db/ensure [:answer/validate]} {:db/id "question-537b608f-d718-5a66-8b0b-7dabfac0375b" :question/id #uuid "537b608f-d718-5a66-8b0b-7dabfac0375b" :question/math-academy-id "q-94670" :question/problem "Find the $21$st percentile of the random variable $X$ if the probability distribution function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2}{21}x,\\, & 2\\le x\\le 5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The $100p$th percentile of a random variable $X$ is the number ${x}_{p}$ such that\n\n$$\nP(X\\le {x}_{p})=p.\n$$\n\nIn our case, we want to find the $21$st percentile, which corresponds to the decimal $p=0.21.$ We have\n\n$$\n\\begin{aligned}P(X\\le {x}_{0.21}) & ={\\int }_{2}^{{x}_{0.21}}\\frac{2}{21}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{21}|}_{2}^{{x}_{0.21}} \\\\  & =\\frac{{x}_{0.21}^{2}}{21}-\\frac{4}{21}.\\end{aligned}\n$$\n\nTherefore, the $21$st percentile is given by\n\n$$\n\\begin{aligned}\\frac{{x}_{0.21}^{2}}{21}-\\frac{4}{21} & =0.21 \\\\ {x}_{0.21}^{2} & =(0.21)(21)+4 \\\\ {x}_{0.21} & =2.9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d2022eed-c29f-583a-a37e-b2d67f6aca04"] :db/ensure [:question/validate]} {:db/id "answer-field-d2022eed-c29f-583a-a37e-b2d67f6aca04" :answer-field/id #uuid "d2022eed-c29f-583a-a37e-b2d67f6aca04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab4badf2-b2ff-5742-aa22-d9ace53e7565" :answer-field/choices ["answer-857e38d3-3ddd-52a6-8559-6963c78e3a81" "answer-5b668401-eb08-5c42-9289-5f7254bda777" "answer-3bd0b664-7cd0-5225-8077-d578f99f8c04" "answer-ab4badf2-b2ff-5742-aa22-d9ace53e7565" "answer-93c6c840-9631-578b-8363-f6b9352ca751"] :db/ensure [:answer-field/validate]} {:db/id "answer-857e38d3-3ddd-52a6-8559-6963c78e3a81" :answer/id #uuid "857e38d3-3ddd-52a6-8559-6963c78e3a81" :answer/type :answer.type/math :answer/value "1.2" :db/ensure [:answer/validate]} {:db/id "answer-5b668401-eb08-5c42-9289-5f7254bda777" :answer/id #uuid "5b668401-eb08-5c42-9289-5f7254bda777" :answer/type :answer.type/math :answer/value "1.7" :db/ensure [:answer/validate]} {:db/id "answer-3bd0b664-7cd0-5225-8077-d578f99f8c04" :answer/id #uuid "3bd0b664-7cd0-5225-8077-d578f99f8c04" :answer/type :answer.type/math :answer/value "2.6" :db/ensure [:answer/validate]} {:db/id "answer-ab4badf2-b2ff-5742-aa22-d9ace53e7565" :answer/id #uuid "ab4badf2-b2ff-5742-aa22-d9ace53e7565" :answer/type :answer.type/math :answer/value "2.9" :db/ensure [:answer/validate]} {:db/id "answer-93c6c840-9631-578b-8363-f6b9352ca751" :answer/id #uuid "93c6c840-9631-578b-8363-f6b9352ca751" :answer/type :answer.type/math :answer/value "3.1" :db/ensure [:answer/validate]} {:db/id "question-36945eec-4c74-5f74-8f42-dd9a1f9a922a" :question/id #uuid "36945eec-4c74-5f74-8f42-dd9a1f9a922a" :question/math-academy-id "q-125520" :question/problem "Find the $51.2$th percentile of the random variable $X$ if the probability distribution function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{2}\\sqrt{x},\\, & 0\\le x\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The $100p$th percentile of a random variable $X$ is the number ${x}_{p}$ such that\n\n$$\nP(X\\le {x}_{p})=p.\n$$\n\nIn our case, we want to find the $51.2$th percentile, which corresponds to the decimal $p=0.512.$ We have\n\n$$\n\\begin{aligned}P(X\\le {x}_{0.512}) & ={\\int }_{0}^{{x}_{0.512}}\\frac{3}{2}\\sqrt{x}\\,\\text{d}x \\\\  & ={{x}^{\\frac{3}{2}}|}_{0}^{{x}_{0.512}} \\\\  & ={x}_{0.512}^{\\frac{3}{2}}.\\end{aligned}\n$$\n\nTherefore, the $51.2$th percentile is given by\n\n$$\n\\begin{aligned}{x}_{0.512}^{\\frac{3}{2}} & =0.512 \\\\ {x}_{0.512}^{\\frac{1}{2}} & =\\sqrt[3]{0.512} \\\\ {x}_{0.512}^{\\frac{1}{2}} & =0.8 \\\\ {x}_{0.512} & =(0.8)^{2} \\\\ {x}_{0.512} & =0.64.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-21cbc6ee-ce3d-5b0e-a165-e71872b21032"] :db/ensure [:question/validate]} {:db/id "answer-field-21cbc6ee-ce3d-5b0e-a165-e71872b21032" :answer-field/id #uuid "21cbc6ee-ce3d-5b0e-a165-e71872b21032" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b4cd0f4f-3e7c-5169-b1c0-6d7b3ad093ca" :answer-field/choices ["answer-8b123b93-545f-51fb-8532-62a1a090adcc" "answer-0ab03d75-993a-5e56-a3b5-e9a96b0abe16" "answer-b8cf6423-b887-5ec3-83c1-58b408697ebe" "answer-b4cd0f4f-3e7c-5169-b1c0-6d7b3ad093ca" "answer-37007c7d-15c3-514b-a461-702523f7b376"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b123b93-545f-51fb-8532-62a1a090adcc" :answer/id #uuid "8b123b93-545f-51fb-8532-62a1a090adcc" :answer/type :answer.type/math :answer/value "0.36" :db/ensure [:answer/validate]} {:db/id "answer-0ab03d75-993a-5e56-a3b5-e9a96b0abe16" :answer/id #uuid "0ab03d75-993a-5e56-a3b5-e9a96b0abe16" :answer/type :answer.type/math :answer/value "0.49" :db/ensure [:answer/validate]} {:db/id "answer-b8cf6423-b887-5ec3-83c1-58b408697ebe" :answer/id #uuid "b8cf6423-b887-5ec3-83c1-58b408697ebe" :answer/type :answer.type/math :answer/value "0.52" :db/ensure [:answer/validate]} {:db/id "answer-b4cd0f4f-3e7c-5169-b1c0-6d7b3ad093ca" :answer/id #uuid "b4cd0f4f-3e7c-5169-b1c0-6d7b3ad093ca" :answer/type :answer.type/math :answer/value "0.64" :db/ensure [:answer/validate]} {:db/id "answer-37007c7d-15c3-514b-a461-702523f7b376" :answer/id #uuid "37007c7d-15c3-514b-a461-702523f7b376" :answer/type :answer.type/math :answer/value "0.72" :db/ensure [:answer/validate]} {:db/id "question-049efa61-2f95-573c-8d4c-3a15cf157276" :question/id #uuid "049efa61-2f95-573c-8d4c-3a15cf157276" :question/math-academy-id "q-94705" :question/problem "Find the $90$th percentile of the random variable $X$ if the probability distribution function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The $100p$th percentile of a random variable $X$ is the number ${x}_{p}$ such that\n\n$$\nP(X\\le {x}_{p})=p.\n$$\n\nIn our case, we want to find the $90$th percentile, which corresponds to the decimal $p=0.9.$ We have\n\n$$\n\\begin{aligned}P(X\\le {x}_{0.9}) & ={\\int }_{1}^{{x}_{0.9}}\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{{x}_{0.9}}\\frac{1}{2}{x}^{-3/2}\\,\\text{d}x \\\\  & =-{x}^{-1/2}{|}_{1}^{{x}_{0.9}} \\\\  & =1-\\frac{1}{\\sqrt{{x}_{0.9}}}.\\end{aligned}\n$$\n\nTherefore, the $90$th percentile is given by\n\n$$\n\\begin{aligned}1-\\frac{1}{\\sqrt{{x}_{0.9}}} & =0.9 \\\\ \\frac{1}{\\sqrt{{x}_{0.9}}} & =0.1 \\\\ \\sqrt{{x}_{0.9}} & =10 \\\\ {x}_{0.9} & =100.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-01c59423-879c-5dcd-b08a-e948d0a753d0"] :db/ensure [:question/validate]} {:db/id "answer-field-01c59423-879c-5dcd-b08a-e948d0a753d0" :answer-field/id #uuid "01c59423-879c-5dcd-b08a-e948d0a753d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-db1bad53-8bf1-579a-bb9d-17ae6d5f1113" :answer-field/choices ["answer-b36d7f94-7250-5b44-b690-333886d417f0" "answer-db1bad53-8bf1-579a-bb9d-17ae6d5f1113" "answer-dba1842e-1014-5223-9a45-ba19604b7a85" "answer-89772cdb-fd83-51ae-aa1e-fed0f838a7b5" "answer-44247718-8f4f-58e6-895b-9f3dc89798eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-b36d7f94-7250-5b44-b690-333886d417f0" :answer/id #uuid "b36d7f94-7250-5b44-b690-333886d417f0" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-db1bad53-8bf1-579a-bb9d-17ae6d5f1113" :answer/id #uuid "db1bad53-8bf1-579a-bb9d-17ae6d5f1113" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "answer-dba1842e-1014-5223-9a45-ba19604b7a85" :answer/id #uuid "dba1842e-1014-5223-9a45-ba19604b7a85" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-89772cdb-fd83-51ae-aa1e-fed0f838a7b5" :answer/id #uuid "89772cdb-fd83-51ae-aa1e-fed0f838a7b5" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-44247718-8f4f-58e6-895b-9f3dc89798eb" :answer/id #uuid "44247718-8f4f-58e6-895b-9f3dc89798eb" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id 17592186163239 :tutorial/content "If $X$ is a continuous random variable and $0 \\leq p \\leq 1,$ then the $100p$th **percentile** is a number $x_p$ such that\n\n$$\nP(X \\leq x_p) = p.\n$$\n\n- In terms of CDF, the *cumulative distribution function* $F(x)$ of $X,$ the $100p$th percentile $x_p$ is a number on the $x$-axis such that\n\n$$\nF(x_p) = p.\n$$\n\n- In terms of PDF, the *probability density function* $f(x)$ of $X,$ the $100p$th percentile $x_p$ is a number on the $x$-axis such that the area under the graph of $y=f(x)$ to the left of $x$ is equal to $p \\mathbin{:}$\n\n$$\n\\int_{-\\infty}^{x_p} f(x) \\, \\text{d}x = p.\n$$\n\nFor example, let's find the $4$th percentile of the random variable $X$ if the probability density function of $X$ is given by\n\n![](images/69/69a9f969e3caaa3cc3d896b5a8b6ed566cff3517743519f0c1088e588c3967e7.svg)\n\nThe $4$th percentile corresponds to the decimal $p={\\color{red}0.04}$ since $100 \\cdot 0.04 = 4.$ So, we have\n\n$$\n\\begin{aligned}P(X\\le {x}_{0.04}) & ={\\int }_{0}^{{x}_{0.04}}\\frac{1}{2}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{4}|}_{0}^{{x}_{0.04}} \\\\  & =\\frac{{{x}_{0.04}}^{2}}{4}.\\end{aligned}\n$$\n\nTherefore, the $4$th percentile is given by\n\n$$\n\\begin{aligned}\\frac{{{x}_{0.04}}^{2}}{4} & =0.04 \\\\ {{x}_{0.04}}^{2} & =0.16 \\\\ {x}_{0.04} & =0.4.\\end{aligned}\n$$\n\nNote that we took the positive root because $0 \\leq x_{0.04} \\leq 2.$\n\nThere are a few special percentiles:\n\n- the $25$th percentile is called the **lower quartile**. This is the number $q_1$ such that\n\n$$\nP(X \\leq q_1) = 0.25.\n$$\n\n- the $50$th percentile is called the **median**. This is the number $m$ such that\n\n$$\nP(X \\leq m) = 0.5.\n$$\n\n- the $75$th percentile is called the **upper quartile**. This is the number $q_3$ such that\n\n$$\nP(X \\leq q_3) = 0.75.\n$$\n\n- the **interquartile range** is the difference between the upper and lower quartiles, that is,\n\n$$\nIQR = q_3 - q_1.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186162178 :activity/expected-seconds 840.0 :db/ensure [:activity/validate]} {:db/id 17592186064232 :knowledge-point/questions ["question-ae2cfcdb-b465-5141-b188-02dc5998e9f5" "question-4b635fc4-723b-5734-9d78-9acb6ad51368"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063991 :question/problem "Expand $(4+3y)^2.$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^2 = a^2 + 2ab + b^2\n$$\n\nSubstituting $a=4$ and $b=3y,$ we have\n\n$$\n\\eqalign{\n\t\t(4 + 3y)^2 &= \\\n\t\t(4)^2 + 2(4) ( 3y) + (3y)^2 &= \\\n\t\t16 + 24y + 9y^2.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064233 :knowledge-point/questions ["question-cd828af1-4191-51f3-be77-cb7614ed0a33" "question-e5bdd830-1ec1-554e-a24b-2d538b13172e" "question-2d137423-8c38-5c63-aa2d-733719761261" "question-6624a980-6efe-5c9a-82eb-5aebfbc29594"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063992 :question/problem "Expand $(2n^2 + 3)^2.$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^2 = a^2 + 2ab + b^2\n$$\n\nSubstituting $a=2n^2$ and $b=3,$ we have\n\n$$\n\\eqalign{\n\t\t(2n^2 + 3)^2 &= \\[2pt]\n\t\t(2n^2)^2 + 2(2n^2) ( 3) + (3)^2 &= \\[2pt]\n\t\t2^2\\cdot (n^2)^2 + 2(2n^2) (3) + (3)^2 &= \\[2pt]\n\t\t4n^4 + 12n^2 + 9.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186064234 :knowledge-point/questions ["question-cff0df09-cba2-54ca-961e-ef5673e7180f" "question-7c0de6db-459c-5036-9e1c-862780d7a093"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186063993 :question/problem "Expand $(3p - 5)^2.$" :question/worked-solution "We will use the following formula:\n\n$$\n(a-b)^2 = a^2 - 2ab + b^2\n$$\n\nSubstituting $a=3p$ and $b=5,$ we have\n\n$$\n\\eqalign{\n\t\t(3p - 5)^2 &= \\\n\t\t(3p)^2 - 2(3p)(5) + 5^2 &= \\\n\t\t9p^2 - 30p + 25.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id "question-ae2cfcdb-b465-5141-b188-02dc5998e9f5" :question/id #uuid "ae2cfcdb-b465-5141-b188-02dc5998e9f5" :question/math-academy-id "q-33092" :question/problem "${(\\frac{p}{2}+\\frac{3}{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=\\frac{p}{2}$ and $b=\\frac{3}{2},$ we have\n\n$$\n\\begin{aligned}{(\\frac{p}{2}+\\frac{3}{2})}^{2} & = \\\\ {(\\frac{p}{2})}^{2}+2(\\frac{p}{2})(\\frac{3}{2})+{(\\frac{3}{2})}^{2} & = \\\\ \\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bd6480f1-db17-5206-8b50-adeb65376df5"] :db/ensure [:question/validate]} {:db/id "answer-field-bd6480f1-db17-5206-8b50-adeb65376df5" :answer-field/id #uuid "bd6480f1-db17-5206-8b50-adeb65376df5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer-field/choices ["answer-53a9e444-9bb4-5607-8e5c-dff301ba180a" "answer-04417ca8-5b44-5f47-8588-203cc9670c83" "answer-c668be38-d1ab-5b18-93b6-f9c30310d732" "answer-f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" "answer-3b77de52-656a-5d60-a77d-89b9ba362ce9"] :db/ensure [:answer-field/validate]} {:db/id "answer-53a9e444-9bb4-5607-8e5c-dff301ba180a" :answer/id #uuid "53a9e444-9bb4-5607-8e5c-dff301ba180a" :answer/type :answer.type/math :answer/value "\\frac{{p}^{2}}{2}+3p+\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "answer-04417ca8-5b44-5f47-8588-203cc9670c83" :answer/id #uuid "04417ca8-5b44-5f47-8588-203cc9670c83" :answer/type :answer.type/math :answer/value "\\frac{{p}^{2}}{2}+\\frac{3}{4}p+\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-c668be38-d1ab-5b18-93b6-f9c30310d732" :answer/id #uuid "c668be38-d1ab-5b18-93b6-f9c30310d732" :answer/type :answer.type/math :answer/value "\\frac{{p}^{2}}{2}+\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer/id #uuid "f6ec47ef-9394-5b6f-bf61-3e7cfa86d762" :answer/type :answer.type/math :answer/value "\\frac{{p}^{2}}{4}+\\frac{3}{2}p+\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "answer-3b77de52-656a-5d60-a77d-89b9ba362ce9" :answer/id #uuid "3b77de52-656a-5d60-a77d-89b9ba362ce9" :answer/type :answer.type/math :answer/value "\\frac{{p}^{2}}{4}+\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "question-4b635fc4-723b-5734-9d78-9acb6ad51368" :question/id #uuid "4b635fc4-723b-5734-9d78-9acb6ad51368" :question/math-academy-id "q-111370" :question/problem "${(3w+2v)}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=3w$ and $b=2v,$ we have\n\n$$\n\\begin{aligned}{(3w+2v)}^{2} & = \\\\ {(3w)}^{2}+2(3w)(2v)+{(2v)}^{2} & = \\\\ 9{w}^{2}+12vw+4{v}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f9264828-72bc-5feb-b279-b58d31b33327"] :db/ensure [:question/validate]} {:db/id "answer-field-f9264828-72bc-5feb-b279-b58d31b33327" :answer-field/id #uuid "f9264828-72bc-5feb-b279-b58d31b33327" :a