simplify the given expression, we use PEMDAS. In terms of the order of operations: \n\n- expressions underneath radicals are treated the same as parentheses\n\n- radicals themselves are treated as exponents\n\nTherefore, following the order of operations, we obtain:\n\n$$\n\\begin{aligned}2\\sqrt{({5}^{2}+3)÷2} & = \\\\ 2\\sqrt{(25+3)÷2} & = \\\\ 2\\sqrt{28÷2} & = \\\\ 2\\sqrt{14}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2d74b39f-54e1-52f0-bc2e-caa9fffbb46f"] :db/ensure [:question/validate]} {:db/id "answer-field-2d74b39f-54e1-52f0-bc2e-caa9fffbb46f" :answer-field/id #uuid "2d74b39f-54e1-52f0-bc2e-caa9fffbb46f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a0702d12-6de9-5329-b3a1-37f176ac8ae9" :answer-field/choices ["answer-d0fb3491-5760-52ac-99e8-5370f4b61304" "answer-39580d17-ecb3-5c7b-990f-951750e37aa1" "answer-8c505423-2a64-5491-a7df-872452ba1bd4" "answer-a0702d12-6de9-5329-b3a1-37f176ac8ae9" "answer-7d1a8f8a-d275-59af-abf9-29bfed39be8e"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0fb3491-5760-52ac-99e8-5370f4b61304" :answer/id #uuid "d0fb3491-5760-52ac-99e8-5370f4b61304" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-39580d17-ecb3-5c7b-990f-951750e37aa1" :answer/id #uuid "39580d17-ecb3-5c7b-990f-951750e37aa1" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "answer-8c505423-2a64-5491-a7df-872452ba1bd4" :answer/id #uuid "8c505423-2a64-5491-a7df-872452ba1bd4" :answer/type :answer.type/math :answer/value "2\\sqrt{12}" :db/ensure [:answer/validate]} {:db/id "answer-a0702d12-6de9-5329-b3a1-37f176ac8ae9" :answer/id #uuid "a0702d12-6de9-5329-b3a1-37f176ac8ae9" :answer/type :answer.type/math :answer/value "2\\sqrt{14}" :db/ensure [:answer/validate]} {:db/id "answer-7d1a8f8a-d275-59af-abf9-29bfed39be8e" :answer/id #uuid "7d1a8f8a-d275-59af-abf9-29