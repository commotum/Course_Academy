ield/id #uuid "04eacb23-5651-500e-987d-0658add645b9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3eb2dba4-a755-55b2-ae4f-bd6ef2d55129" :answer-field/choices ["answer-5174e0ad-df19-5c17-a6e0-b9f1789a64e0" "answer-433bcb79-f2e0-5f59-8bbf-c8a6fe6679ea" "answer-3eb2dba4-a755-55b2-ae4f-bd6ef2d55129" "answer-7fc44424-4113-54de-a1c7-c3453bbbd004" "answer-346a0350-155f-58bb-8439-0fb1c2e166bc"] :db/ensure [:answer-field/validate]} {:db/id "answer-5174e0ad-df19-5c17-a6e0-b9f1789a64e0" :answer/id #uuid "5174e0ad-df19-5c17-a6e0-b9f1789a64e0" :answer/type :answer.type/math :answer/value "2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "answer-433bcb79-f2e0-5f59-8bbf-c8a6fe6679ea" :answer/id #uuid "433bcb79-f2e0-5f59-8bbf-c8a6fe6679ea" :answer/type :answer.type/math :answer/value "3\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-3eb2dba4-a755-55b2-ae4f-bd6ef2d55129" :answer/id #uuid "3eb2dba4-a755-55b2-ae4f-bd6ef2d55129" :answer/type :answer.type/math :answer/value "6\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-7fc44424-4113-54de-a1c7-c3453bbbd004" :answer/id #uuid "7fc44424-4113-54de-a1c7-c3453bbbd004" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{12}" :db/ensure [:answer/validate]} {:db/id "answer-346a0350-155f-58bb-8439-0fb1c2e166bc" :answer/id #uuid "346a0350-155f-58bb-8439-0fb1c2e166bc" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "question-2b515338-9a49-5088-8d83-3ec16988abce" :question/id #uuid "2b515338-9a49-5088-8d83-3ec16988abce" :question/math-academy-id "q-94641" :question/problem "Find the median of the random variable $Y$ if the probability density function of $Y$ is given by\n\n$$\nf(y)=\\{\\begin{aligned}6{e}^{-6y},\\, & y\\ge 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The median of a random variable $Y$ is the number $m$ such that\n\n$$\nP(Y\\le m)=\\frac{1}{2}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}P(Y\\le m) & ={\\int }_{0}^{m}6{e}^{-6y}\\,\\text{d}y \\\\  & =-{e}^{-6y}{|}_{0}^{m} \\\\  & =1-{e}^{-6m}\\end{aligned}\n$$\n\nTherefore, the median is given by\n\n$$\n\\begin{aligned}1-{e}^{-6m} & =\\frac{1}{2} \\\\ {e}^{-6m} & =\\frac{1}{2} \\\\ -6m & =\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ -6m & =-\\operatorname{ln}⁡2 \\\\ m & =\\frac{\\operatorname{ln}⁡2}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9860bd94-686f-562b-93e2-7506456e5e9b"] :db/ensure [:question/validate]} {:db/id "answer-field-9860bd94-686f-562b-93e2-7506456e5e9b" :answer-field/id #uuid "9860bd94-686f-562b-93e2-7506456e5e9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-793af677-077b-5623-8d55-c294d9651a32" :answer-field/choices ["answer-78eefeb0-a4ae-5e62-bcd9-4a983105c3d4" "answer-2c4d79bc-915f-5faf-978f-4d42e48a1002" "answer-e345bb2f-b85f-50d4-b376-0cd925292cbb" "answer-793af677-077b-5623-8d55-c294d9651a32" "answer-55c24ac5-9fd4-503b-ba36-10fa741c0864"] :db/ensure [:answer-field/validate]} {:db/id "answer-78eefeb0-a4ae-5e62-bcd9-4a983105c3d4" :answer/id #uuid "78eefeb0-a4ae-5e62-bcd9-4a983105c3d4" :answer/type :answer.type/math :answer/value "6\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-2c4d79bc-915f-5faf-978f-4d42e48a1002" :answer/id #uuid "2c4d79bc-915f-5faf-978f-4d42e48a1002" :answer/type :answer.type/math :answer/value "\\frac{1}{6\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "answer-e345bb2f-b85f-50d4-b376-0cd925292cbb" :answer/id #uuid "e345bb2f-b85f-50d4-b376-0cd925292cbb" :answer/type :answer.type/math :answer/value "\\frac{6}{\\operatorname{ln}⁡2}" :db/ensure [:answer/validate]} {:db/id "answer-793af677-077b-5623-8d55-c294d9651a32" :answer/id #uuid "793af677-077b-5623-8d55-c294d9651a32" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡2}{6}" :db/ensure [:answer/validate]} {:db/id "answer-55c24ac5-9fd4-503b-ba36-10fa741c0864" :answer/id #uuid "55c24ac5-9fd4-503b-ba36-10fa741c0864" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡6}{2}" :db/ensure [:answer/validate]} {:db/id "question-8d19c0b1-13a1-5100-8957-4c982f273723" :question/id #uuid "8d19c0b1-13a1-5100-8957-4c982f273723" :question/math-academy-id "q-125773" :question/problem "Find the median of the random variable $X$ if the probability density function of $X$ is given by\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{98}{{x}^{3}},\\, & x\\ge 7, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "The median of a random variable $X$ is the number $m$ such that\n\n$$\nP(X\\le m)=\\frac{1}{2}.\n$$\n\nIn our case, we have\n\n$$\n\\begin{aligned}P(X\\le m) & ={\\int }_{7}^{m}\\frac{98}{{x}^{3}}\\,\\text{d}x \\\\  & ={-\\frac{49}{{x}^{2}}|}_{7}^{m} \\\\  & =1-\\frac{49}{{m}^{2}}.\\end{aligned}\n$$\n\nTherefore, the median is given by\n\n$$\n\\begin{aligned}1-\\frac{49}{{m}^{2}} & =\\frac{1}{2} \\\\ \\frac{49}{{m}^{2}} & =\\frac{1}{2} \\\\ m & =7\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we took the positive root because $m>7.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-14f5578f-6447-52d0-b254-195bbd51df0b"] :db/ensure [:question/validate]} {:db/id "answer-field-14f5578f-6447-52d0-b254-195bbd51df0b" :answer-field/id #uuid "14f5578f-6447-52d0-b254-195bbd51df0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fd4067de-8e2f-50d3-a556-414aacb24659" :answer-field/choices ["answer-fd4067de-8e2f-50d3-a556-414aacb24659" "answer-6ea8ecb1-b36f-55c1-97dd-23b6b06f366c" "answer-1ccc100a-0804-57d3-934a-8576b15919de" "answer-8d19a9c9-2f00-503d-a0ac-b3697e0af0c6" "answer-5056f157-e7ac-5e18-b665-34631b5fa810"] :db/ensure [:answer-field/validate]} {:db/id "answer-fd4067de-8e2f-50d3-a556-414aacb24659" :answer/id #uuid "fd4067de-8e2f-50d3-a556-414aacb