" :answer/id #uuid "d9f67e05-cb2a-5935-9b20-22131047e3c8" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "answer-field-b1d4a91f-685b-5256-940d-9721b675dc30" :answer-field/id #uuid "b1d4a91f-685b-5256-940d-9721b675dc30" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8b4f3577-ea48-51d4-9617-02afb3d566b0" :answer-field/choices ["answer-8b4f3577-ea48-51d4-9617-02afb3d566b0"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b4f3577-ea48-51d4-9617-02afb3d566b0" :answer/id #uuid "8b4f3577-ea48-51d4-9617-02afb3d566b0" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "question-cff0df09-cba2-54ca-961e-ef5673e7180f" :question/id #uuid "cff0df09-cba2-54ca-961e-ef5673e7180f" :question/math-academy-id "q-31200" :question/problem "${({y}^{3}-2)}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a-b)^{2}={a}^{2}-2ab+{b}^{2}\n$$\n\nSubstituting $a={y}^{3}$ and $b=2,$ we have\n\n$$\n\\begin{aligned}({y}^{3}-2)^{2} & = \\\\ {({y}^{3})}^{2}-2({y}^{3})(2)+{2}^{2} & = \\\\ {y}^{6}-4{y}^{3}+4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8ec44591-abfc-5bd6-a795-2de05dba12c6"] :db/ensure [:question/validate]} {:db/id "answer-field-8ec44591-abfc-5bd6-a795-2de05dba12c6" :answer-field/id #uuid "8ec44591-abfc-5bd6-a795-2de05dba12c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c43d70c1-d6a4-5250-a30d-6b0121a7ed9a" :answer-field/choices ["answer-eab6d2b9-047b-5248-a6ae-4beced7d6d66" "answer-9524d886-c1c8-5447-89fb-648011d30a8e" "answer-1d6ee479-da20-5b17-8742-1e98397de564" "answer-3bca42ad-19ea-59ec-89e1-8640547b543b" "answer-c43d70c1-d6a4-5250-a30d-6b0121a7ed9a"] :db/ensure [:answer-field/validate]} {:db/id "answer-eab6d2b9-047b-5248-a6ae-4beced7d6d66" :answer/id #uuid "eab6d2b9-047b-5248-a6ae-4beced7d6d66" :answer/type :answer.type/math :answer/value "{y}^{5}-4{y}^{3}+4" :db/ensure [:answer/validate]} {:db/id "answer-9524d886-c1c8-5447-89fb-648011d30a8e" :answer/id #uuid "9524d886-c1c8-5447-89fb-648011d30a8e" :answer/type :answer.type/math :answer/value "{y}^{6}+4" :db/ensure [:answer/validate]} {:db/id "answer-1d6ee479-da20-5b17-8742-1e98397de564" :answer/id #uuid "1d6ee479-da20-5b17-8742-1e98397de564" :answer/type :answer.type/math :answer/value "{y}^{6}-2{y}^{3}+2" :db/ensure [:answer/validate]} {:db/id "answer-3bca42ad-19ea-59ec-89e1-8640547b543b" :answer/id #uuid "3bca42ad-19ea-59ec-89e1-8640547b543b" :answer/type :answer.type/math :answer/value "{y}^{6}-2{y}^{3}-4" :db/ensure [:answer/validate]} {:db/id "answer-c43d70c1-d6a4-5250-a30d-6b0121a7ed9a" :answer/id #uuid "c43d70c1-d6a4-5250-a30d-6b0121a7ed9a" :answer/type :answer.type/math :answer/value "{y}^{6}-4{y}^{3}+4" :db/ensure [:answer/validate]} {:db/id "question-7c0de6db-459c-5036-9e1c-862780d7a093" :question/id #uuid "7c0de6db-459c-5036-9e1c-862780d7a093" :question/math-academy-id "q-216524" :question/problem "${(4m-3{n}^{2})}^{2}=${{field-1}}${m}^{2}\\,\\,-$\n{{field-2}}$m{n}^{2}\\,\\,+$\n{{field-3}}${n}^{4}$" :question/worked-solution "We will use the following formula:\n\n$$\n(a-b)^{2}={a}^{2}-2ab+{b}^{2}\n$$\n\nSubstituting $a=4m$ and $b=3{n}^{2},$ we have\n\n$$\n\\begin{aligned}{(4m-3{n}^{2})}^{2} & = \\\\ {(4m)}^{2}-2(4m)(3{n}^{2})+{(3{n}^{2})}^{2} & = \\\\ 16{m}^{2}-24m{n}^{2}+9{n}^{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4f1eaed5-4a6d-5139-bf16-030242072598" "answer-field-4e03e9d5-46dd-5435-ad4e-524f0f40d754" "answer-field-620ab4d8-1b80-5eff-b885-8b9c93c53506"] :db/ensure [:question/validate]} {:db/id "answer-field-4f1eaed5-4a6d-5139-bf16-030242072598" :answer-field/id #uuid "4f1eaed5-4a6d-5139-bf16-030242072598" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b45d60bf-fb9c-539a-8332-acb5a4e3248e" :answer-field/choices ["answer-b45d60bf-fb9c-539a-8332-acb5a4e3248e"] :db/ensure [:answer-field/validate]} {:db/id "answer-b45d60bf-fb9c-539a-8332-acb5a4e3248e" :answer/id #uuid "b45d60bf-fb9c-539a-8332-acb5a4e3248e" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-field-4e03e9d5-46dd-5435-ad4e-524f0f40d754" :answer-field/id #uuid "4e03e9d5-46dd-5435-ad4e-524f0f40d754" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ac732971-e0c2-5624-855b-5d774a53c77c" :answer-field/choices ["answer-ac732971-e0c2-5624-855b-5d774a53c77c"] :db/ensure [:answer-field/validate]} {:db/id "answer-ac732971-e0c2-5624-855b-5d774a53c77c" :answer/id #uuid "ac732971-e0c2-5624-855b-5d774a53c77c" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-field-620ab4d8-1b80-5eff-b885-8b9c93c53506" :answer-field/id #uuid "620ab4d8-1b80-5eff-b885-8b9c93c53506" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-65286bcd-f07b-5cf9-bef3-433210e31692" :answer-field/choices ["answer-65286bcd-f07b-5cf9-bef3-433210e31692"] :db/ensure [:answer-field/validate]} {:db/id "answer-65286bcd-f07b-5cf9-bef3-433210e31692" :answer/id #uuid "65286bcd-f07b-5cf9-bef3-433210e31692" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id 17592186065441 :tutorial/content "When we want to calculate the **square of a binomial**, like\n\n$$\n(a+b)^2,\n$$\n\nthere's a formula that we can use instead of working out the product $(a+b)(a+b)$ manually. The formula is\n\n$$\n(a + b)^2 = a^2 + 2ab + b^2.\n$$\n\nIt might be helpful to remember this as *\"the square of the first term, plus the square of the second term, plus twice the product.\"*\n\nSuppose we need to calculate the square $(x+3)^2.$ In this case, we have $a= x$ and $b=3.$ We substitute into the formula and simplify:\n\n$$\n\\begin{aligned}(x+3)^{2} & = \\\\ (x)^{2}+2(x)(3)+(3)^{2} & = \\\\ {x}^{2}+6x+9 & \\end{aligned}\n$$\n\nWe can check that the formula gives the correct result by working out the multiplication manually:\n\n$$\n\\eqalign{\n\t\t(x + 3)^2 &= \\[3pt]\n\t\t(x + 3)(x + 3) &= \\[3pt]\n\t\tx(x + 3) + 3(x + 3) &= \\[3pt]\n\t\tx^2 + 3x + 3x + 9 &= \\[3pt]\n\t\tx^2 + 6x + 9 &\\, {\\color{green}{\\checkmark}}\n\t}\n$$\n\nSo we get the same result! But by using the formula, we save a lot of time and effort." :db/ensure [:tutorial/validate]} {:db/id 17592186065442 :tutorial/content "So far, we've been using the formula for the square of a binomial involving addition:\n\n$$\n(a + b)^2 = a^2 + 2ab + b^2\n$$\n\nThere is also a similar formula that we can use to compute the square of a binomial involving subtraction. The formula is\n\n$$\n(a - b)^2 = a^2 - 2ab + b^2.\n$$\n\nFor example, to compute the square $(x-3)^2,$ we can substitute $a=x$ and $b=3$ into the formula and simplify:\n\n$$\n\\begin{aligned}(x-3)^{2} & = \\\\ (x)^{2}-2(x)(3)+(3)^{2} & = \\\\ {x}^{2}-6x+9 & \\end{aligned}\n$$\n\nWe can check that the formula gives the correct result by working out the multiplication manually:\n\n$$\n\\eqalign{\n\t\t(x - 3)^2 &= \\\n\t\t(x - 3)(x - 3) &= \\\n\t\tx(x - 3) - 3(x - 3) &= \\\n\t\tx^2 - 3x - 3x + 9 &= \\\n\t\tx^2 - 6x + 9 &\\, {\\color{green}{\\checkmark}}\n\t}\n$$\n\nAgain, we get the same result." :db/ensure [:tutorial/validate]} {:db/id 17592186064447 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186078614 :knowledge-point/questions ["question-04e6642c-b46c-5677-a772-7f923b6e600b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-04e6642c-b46c-5677-a772-7f923b6e600b" :question/id #uuid "04e6642c-b46c-5677-a772-7f923b6e600b" :question/math-academy-id "q-67051" :question/problem "What is the third term of the expression $-3k+2l-7m+\\frac{2}{3}n?$" :question/worked-solution "We put an addition symbol $(+)$ between each part and separate using parentheses:\n\n$$\n(-3k)+(2l)+(-7m)+(\\frac{2}{3}n)\n$$\n\nCounting off the terms:\n\n- the first term is $-3k,$\n\n- the second term is $2l,$\n\n- the third term is $-7m,$ and\n\n- the fourth term is $\\frac{2}{3}n.$\n\nIn particular, we are interested in the third term. The third term is $-7m.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-033a56c7-e349-5192-bd8c-494f5d89f042"] :db/ensure [:question/validate]} {:db/id "answer-field-033a56c7-e349-5192-bd8c-494f5d89f042" :answer-field/id #uuid "033a56c7-e349-5192-bd8c-494f5d89f042" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9c5a9783-1695-5fd0-8b73-7833bcd112bc" :answer-field/choices ["answer-2cd13d57-925a-5982-ab14-c93eb0419f35" "answer-9c5a9783-1695-5fd0-8b73-7833bcd112bc" "answer-fb51dbe3-7f5a-5148-baff-d67f34e4cffd" "answer-83cba7a8-76fc-56db-aaf8-c3de0de6e5d4" "answer-99163600-3de1-51e9-8a72-aff574118385"] :db/ensure [:answer-field/validate]} {:db/id "answer-2cd13d57-925a-5982-ab14-c93eb0419f35" :answer/id #uuid "2cd13d57-925a-5982-ab14-c93eb0419f35" :answer/type :answer.type/math :answer/value "-3k" :db/ensure [:answer/validate]} {:db/id "answer-9c5a9783-1695-5fd0-8b73-7833bcd112bc" :answer/id #uuid "9c5a9783-1695-5fd0-8b73-7833bcd112bc" :answer/type :answer.type/math :answer/value "-7m" :db/ensure [:answer/validate]} {:db/id "answer-fb51dbe3-7f5a-5148-baff-d67f34e4cffd" :answer/id #uuid "fb51dbe3-7f5a-5148-baff-d67f34e4cffd" :answer/type :answer.type/math :answer/value "7m" :db/ensure [:answer/validate]} {:db/id "answer-83cba7a8-76fc-56db-aaf8-c3de0de6e5d4" :answer/id #uuid "83cba7a8-76fc-56db-aaf8-c3de0de6e5d4" :answer/type :answer.type/math :answer/value "\\frac{2}{3}n" :db/ensure [:answer/validate]} {:db/id "answer-99163600-3de1-51e9-8a72-aff574118385" :answer/id #uuid "99163600-3de1-51e9-8a72-aff574118385" :answer/type :answer.type/math :answer/value "\\sqrt{2}l" :db/ensure [:answer/validate]} {:db/id 17592186078615 :knowledge-point/questions ["question-eb6d88d8-f577-5f53-98e7-edda212d8c82" "question-8350b8fc-cebc-5d70-a81a-fd2cc02c4b2c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-eb6d88d8-f577-5f53-98e7-edda212d8c82" :question/id #uuid "eb6d88d8-f577-5f53-98e7-edda212d8c82" :question/math-academy-id "q-101231" :question/problem "Which of the following is equivalent to the expression $5b-5+t?$" :question/worked-solution "The expression $5b-5+t$ has three terms:  $5b$, $-5$, and $t.$ \n\nThe order in which we combine the terms doesn't matter. Therefore, we can also write this expression as \n\n$$\nt-5+5b.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ac543dcf-e81f-50e7-95c6-f0e748a3d311"] :db/ensure [:question/validate]} {:db/id "answer-field-ac543dcf-e81f-50e7-95c6-f0e748a3d311" :answer-field/id #uuid "ac543dcf-e81f-50e7-95c6-f0e748a3d311" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac1f5891-3798-54aa-996d-4c2a95213fb3" :answer-field/choices ["answer-771ee901-1425-5463-ba2b-f88c8bbf2f2b" "answer-a2f9a64a-a6b7-51e5-83d8-71349f2789d7" "answer-b17687ec-6014-5b71-94d7-ab70a418a6e1" "answer-ac1f5891-3798-54aa-996d-4c2a95213fb3" "answer-4d4920b8-a0b3-52d7-b949-f47b2a45a0a7"] :db/ensure [:answer-field/validate]} {:db/id "answer-771ee901-1425-5463-ba2b-f88c8bbf2f2b" :answer/id #uuid "771ee901-1425-5463-ba2b-f88c8bbf2f2b" :answer/type :answer.type/math :answer/value "5t+5b+1" :db/ensure [:answer/validate]} {:db/id "answer-a2f9a64a-a6b7-51e5-83d8-71349f2789d7" :answer/id #uuid "a2f9a64a-a6b7-51e5-83d8-71349f2789d7" :answer/type :answer.type/math :answer/value "5t-5b+1" :db/ensure [:answer/validate]} {:db/id "answer-b17687ec-6014-5b71-94d7-ab70a418a6e1" :answer/id #uuid "b17687ec-6014-5b71-94d7-ab70a418a6e1" :answer/type :answer.type/math :answer/value "t+5b+5" :db/ensure [:answer/validate]} {:db/id "answer-ac1f5891-3798-54aa-996d-4c2a95213f