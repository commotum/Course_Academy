i }{2}\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\sqrt{({x}^{2}+{y}^{2}+{z}^{2})^{3}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\sqrt{{({\\rho }^{2})}^{3}} \\\\  & ={\\rho }^{3}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{({x}^{2}+{y}^{2}+{z}^{2})^{3}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{3}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2}{\\rho }^{5}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-221b87fc-98b3-5ef3-aaac-2b6fd8ff9912"] :db/ensure [:question/validate]} {:db/id "answer-field-221b87fc-98b3-5ef3-aaac-2b6fd8ff9912" :answer-field/id #uuid "221b87fc-98b3-5ef3-aaac-2b6fd8ff9912" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8e374f7e-899e-55ec-987a-a788de643c94" :answer-field/choices ["answer-01b05cd1-c572-589c-9a36-f9ee48ab1cb8" "answer-693c273c-0e2d-58db-9f8b-dddf5b19b420" "answer-bf406e20-6fd6-5a5e-9f17-e0662a90b3bc" "answer-8e374f7e-899e-55ec-987a-a788de643c94" "answer-d29ad024-3d69-560b-a1b9-aff53f30896a"] :db/ensure [:answer-field/validate]} {:db/id "answer-01b05cd1-c572-589c-9a36-f9ee48ab1cb8" :answer/id #uuid "01b05cd1-c572-589c-9a36-f9ee48ab1cb8" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}{\\rho }^{4}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-693c273c-0e2d-58db-9f8b-dddf5b19b420" :answer/id #uuid "693c273c-0e2d-58db-9f8b-dddf5b19b420" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}{\\rho }^{5}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-bf406e20-6fd6-5a5e-9f17-e0662a90b3bc" :answer/id #uuid "bf406e20-6fd6-5a5e-9f17-e0662a90b3bc" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2}{\\rho }^{4}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-8e374f7e-899e-55ec-987a-a788de643c94" :answer/id #uuid "8e374f7e-899e-55ec-987a-a788de643c94" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2}{\\rho }^{5}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-d29ad024-3d69-560b-a1b9-aff53f30896a" :answer/id #uuid "d29ad024-3d69-560b-a1b9-aff53f30896a" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2}{\\rho }^{5}{cos}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "question-164ec461-433f-5d34-8b46-e1e7c87d7fe4" :question/id #uuid "164ec461-433f-5d34-8b46-e1e7c87d7fe4" :question/math-academy-id "q-161759" :question/problem "The region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=5$ for $y\\ge 0.$\nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $\\sqrt{5}$ centered at the origin.\n\n![](images/9c/9ca3a428d54a15b11c4c5bd95039df6a0b2d9f4363dba7034c51edb2b6f8fd27.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{5},\\,0\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\sqrt{{\\rho }^{2}} \\\\  & =\\rho \\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\rho \\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{5}}{\\rho }^{3}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f5006c5b-f6bb-5a8a-aaf0-fd1de2ee6fd8"] :db/ensure [:question/validate]} {:db/id "answer-field-f5006c5b-f6bb-5a8a-aaf0-fd1de2ee6fd8" :answer-field/id #uuid "f5006c5b-f6bb-5a8a-aaf0-fd1de2ee6fd8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d15b9998-a3ed-5988-94b3-187b51bcaaf8" :answer-field/choices ["answer-e1a34ba4-abfa-588c-b7fc-f914b37315db" "answer-d15b9998-a3ed-5988-94b3-187b51bcaaf8" "answer-cf984d5e-328d-5fdf-9485-6ea476edb15c" "answer-997368c7-8041-54a5-9634-9162760a7035" "answer-90f39cac-c247-53b7-96d9-91a82df2b441"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1a34ba4-abfa-588c-b7fc-f914b37315db" :answer/id #uuid "e1a34ba4-abfa-588c-b7fc-f914b37315db" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{\\sqrt{5}}{\\rho }^{3}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-d15b9998-a3ed-5988-94b3-187b51bcaaf8" :answer/id #uuid "d15b9998-a3ed-5988-94b3-187b51bcaaf8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{5}}{\\rho }^{3}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-cf984d5e-328d-5fdf-9485-6ea476edb15c" :answer/id #uuid "cf984d5e-328d-5fdf-9485-6ea476edb15c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi }{\\int }_{0}^{\\sqrt{5}}{\\rho }^{4}{cos}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-997368c7-8041-54a5-9634-9162760a7035" :answer/id #uuid "997368c7-8041-54a5-9634-9162760a7035" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\rho }^{3}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-90f39cac-c247-53b7-96d9-91a82df2b441" :answer/id #uuid "90f39cac-c247-53b7-96d9-91a82df2b441" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\rho }^{3}{cos}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "question-75e6fbad-2ffa-554a-b73e-206d1de35163" :question/id #uuid "75e6fbad-2ffa-554a-b73e-206d1de35163" :question/math-academy-id "q-161921" :question/problem "![](images/54/54ff64195ccfadddfe2b3ca0bb9e193147fedae20d8dae6a53a5ecddc3c26f5d.png)\n\nThe region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=-16y$ for $x\\le 0$ and $z\\ge 0,$ shown above. \nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$  represents one-quarter of the sphere of radius $8$ centered at $(0,-8,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=-16y$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =-16y \\\\ {\\rho }^{2} & =-16\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho +16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/86/868214a1c2b30da5b16b7f0c307b369bdc9f2d2201ee0ad5a3f5da2a8bdc6f49.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le \\frac{3\\pi }{2},\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\sqrt{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\sqrt{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}+(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}} \\\\  & =\\sqrt{{\\rho }^{2}{cos}^{2}⁡\\theta {sin}^{2}⁡ϕ+{\\rho }^{2}{sin}^{2}⁡\\theta {sin}^{2}⁡ϕ} \\\\  & =\\sqrt{{\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{\\rho }^{2}{sin}^{2}⁡ϕ} \\\\  & =\\rho \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}=\\rho \\operatorname{sin}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{3}{sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-3d8e45e3-b187-55ef-8895-829cbde8baad"] :db/ensure [:question/validate]} {:db/id "answer-field-3d8e45e3-b187-55ef-8895-829cbde8baad" :answer-field/id #uuid "3d8e45e3-b187-55ef-8895-829cbde8baad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bef84112-3ae3-59b4-8acd-c836d7e8a7af" :answer-field/choices ["answer-b744b3f7-8807-53b3-a991-de88c0855263" "answer-e5d548e7-7e33-5671-81f5-4f4350c23585" "answer-ba023976-39af-52af-8116-b3398085ad4d" "answer-bef84112-3ae3-59b4-8acd-c836d7e8a7af" "answer-92943d53-64ab-5eb3-b983-45be687c3731"] :db/ensure [:answer-field/validate]} {:db/id "answer-b744b3f7-8807-53b3-a991-de88c0855263" :answer/id #uuid "b744b3f7-8807-53b3-a991-de88c0855263" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-e5d548e7-7e33-5671-81f5-4f4350c23585" :answer/id #uuid "e5d548e7-7e33-5671-81f5-4f4350c23585" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-8\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{3}{sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-ba023976-39af-52af-8116-b3398085ad4d" :answer/id #uuid "ba023976-39af-52af-8116-b3398085ad4d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-bef84112-3ae3-59b4-8acd-c836d7e8a7af" :answer/id #uuid "bef84112-3ae3-59b4-8acd-c836d7e8a7af" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-16\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{3}{sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-92943d53-64ab-5eb3-b983-45be687c3731" :answer/id #uuid "92943d53-64ab-5eb3-b983-45be687c3731" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-8\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "question-ba16213a-d9f2-5675-b515-f66161bd7267" :question/id #uuid "ba16213a-d9f2-5675-b515-f66161bd7267" :question/math-academy-id "q-161922" :question/problem "![](images/cf/cf44412afd6f2a8eaab468676b4f6a9828f5000eec287234f9834a41e6816d5a.png)\n\nThe region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=20x$ for $z\\le 0,$ shown above.\nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$  represents one-quarter of the sphere of radius $10$ centered at $(10,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=20x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =20x \\\\ {\\rho }^{2} & =20\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/16/165ed50d8f94f3b896f4d19647fb514f544221872a6df241a6ab6c3797bbd698.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{y}{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}+{(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}} \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{{\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-46a73c28-db4d-5b08-9210-44c3f3e37fcd"] :db/ensure [:question/validate]} {:db/id "answer-field-46a73c28-db4d-5b08-9210-44c3f3e37fcd" :answer-field/id #uuid "46a73c28-db4d-5b08-9210-44c3f3e37fcd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9edf5219-4946-5276-ac39-fe2b2d568af2" :answer-field/choices ["answer-6bbc2c65-9f4e-5d10-88b8-a6de92a9ed7d" "answer-3434e6cd-ecc2-5e44-a0a7-04b070694a96" "answer-9edf5219-4946-5276-ac39-fe2b2d568af2" "answer-d4a1f2b2-3392-5a63-814e-8db5a857c76a" "answer-5bc19d2a-7bec-50b3-8ef7-793fd45f87b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-6bbc2c65-9f4e-5d10-88b8-a6de92a9ed7d" :answer/id #uuid "6bbc2c65-9f4e-5d10-88b8-a6de92a9ed7d" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{10\\operatorname{cos}⁡ϕ}\\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-3434e6cd-ecc2-5e44-a0a7-04b070694a96" :answer/id #uuid "3434e6cd-ecc2-5e44-a0a7-04b070694a96" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\frac{\\operatorname{sin}⁡\\theta }{\\rho \\operatorname{sin}⁡ϕ}\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-9edf5219-4946-5276-ac39-fe2b2d568af2" :answer/id #uuid "9edf5219-4946-5276-ac39-fe2b2d568af2" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{20\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-d4a1f2b2-3392-5a63-814e-8db5a857c76a" :answer/id #uuid "d4a1f2b2-3392-5a63-814e-8db5a857c76a" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi }{\\int }_{0}^{10\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-5bc19d2a-7bec-50b3-8ef7-793fd45f87b5" :answer/id #uuid "5bc19d2a-7bec-50b3-8ef7-793fd45f87b5" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\pi /2}^{\\pi }{\\int }_{0}^{20\\operatorname{cos}⁡ϕ}\\rho \\operatorname{sin}⁡\\theta \\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "question-e9ac6b1f-2b21-59f9-9ae8-01d7811a1b26" :question/id #uuid "e9ac6b1f-2b21-59f9-9ae8-01d7811a1b26" :question/math-academy-id "q-161861" :question/problem "![](images/75/759ebc78c794f433bba8c1f555bc68b2da52de62741711f13bd9c9156e3c485e.png)\n\nThe region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=-2x,$ shown above. \nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}\\frac{1}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $1$ centered at $(-1,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=-2x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =-2x \\\\ {\\rho }^{2} & =-2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho +2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/43/43e3c386086d30431405bb3fe2ca2835595641041dd7e098f9234cab8e7b225d.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2},\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{1}{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{1}{{\\rho }^{2}}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{{\\rho }^{2}}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-470c2112-2e6b-5e03-b248-67e3dc557d2a"] :db/ensure [:question/validate]} {:db/id "answer-field-470c2112-2e6b-5e03-b248-67e3dc557d2a" :answer-field/id #uuid "470c2112-2e6b-5e03-b248-67e3dc557d2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18118a21-1866-517c-91ba-cd81ae45480c" :answer-field/choices ["answer-7dc97b19-111a-5ad2-a4fb-29483eb7233d" "answer-a80003c0-4cdc-55a5-87ae-6fbce654a98c" "answer-18118a21-1866-517c-91ba-cd81ae45480c" "answer-e5fd412f-7ab2-5dd9-8224-48453f73cecf" "answer-b62e281d-a25c-55fe-89b2-4c80a8cd2941"] :db/ensure [:answer-field/validate]} {:db/id "answer-7dc97b19-111a-5ad2-a4fb-29483eb7233d" :answer/id #uuid "7dc97b19-111a-5ad2-a4fb-29483eb7233d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{3\\pi /2}{\\int }_{0}^{-\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\frac{1}{{\\rho }^{2}}\\,d\\rho \\,d\\theta \\,dϕ." :db/ensure [:answer/validate]} {:db/id "answer-a80003c0-4cdc-55a5-87ae-6fbce654a98c" :answer/id #uuid "a80003c0-4cdc-55a5-87ae-6fbce654a98c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\frac{1}{{\\rho }^{2}}\\,d\\rho \\,d\\theta \\,dϕ." :db/ensure [:answer/validate]} {:db/id "answer-18118a21-1866-517c-91ba-cd81ae45480c" :answer/id #uuid "18118a21-1866-517c-91ba-cd81ae45480c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ." :db/ensure [:answer/validate]} {:db/id "answer-e5fd412f-7ab2-5dd9-8224-48453f73cecf" :answer/id #uuid "e5fd412f-7ab2-5dd9-8224-48453f73cecf" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ." :db/ensure [:answer/validate]} {:db/id "answer-b62e281d-a25c-55fe-89b2-4c80a8cd2941" :answer/id #uuid "b62e281d-a25c-55fe-89b2-4c80a8cd2941" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{-\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ." :db/ensure [:answer/validate]} {:db/id "question-934f832d-975f-5cb5-827f-5f4ce2444543" :question/id #uuid "934f832d-975f-5cb5-827f-5f4ce2444543" :question/math-academy-id "q-161918" :question/problem "![](images/11/110e46158875a0aeb3b3aa898b886ee03b8c4cf945e9853a4962e839c5b1f0f6.png)\n\nThe region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=-10y,$ shown above. \nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}\\frac{z}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $5$ centered at $(0,-5,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=-10y$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =-10y \\\\ {\\rho }^{2} & =-10\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho +10\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-10\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/8f/8f2c3d4810b8364e17ad82a0d271d9affe2714938bd7cccbc69c6174e1f03ec4.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -10\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{z}{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{cos}⁡ϕ}{{\\rho }^{2}} \\\\  & =\\frac{\\operatorname{cos}⁡ϕ}{\\rho }\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{z}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{\\operatorname{cos}⁡ϕ}{\\rho }\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-10\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9309a6d6-1107-5ddf-8990-2d51ab631984"] :db/ensure [:question/validate]} {:db/id "answer-field-9309a6d6-1107-5ddf-8990-2d51ab631984" :answer-field/id #uuid "9309a6d6-1107-5ddf-8990-2d51ab631984" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f079615d-8ce4-54e3-9b4b-f0ba2b715d39" :answer-field/choices ["answer-0665b1d0-a710-54a2-a4eb-08117d1dd2e4" "answer-36fa9e66-7b0e-5d65-89fe-3a6842cd4dc6" "answer-f079615d-8ce4-54e3-9b4b-f0ba2b715d39" "answer-46e437e9-d54d-54d2-aa05-489e40bfc276" "answer-4dfee53d-1601-5c68-85ae-29e747072a2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-0665b1d0-a710-54a2-a4eb-08117d1dd2e4" :answer/id #uuid "0665b1d0-a710-54a2-a4eb-08117d1dd2e4" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{-10\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\frac{\\operatorname{cos}⁡ϕ}{\\rho }\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-36fa9e66-7b0e-5d65-89fe-3a6842cd4dc6" :answer/id #uuid "36fa9e66-7b0e-5d65-89fe-3a6842cd4dc6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{-5\\operatorname{cos}⁡ϕ}\\rho \\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-f079615d-8ce4-54e3-9b4b-f0ba2b715d39" :answer/id #uuid "f079615d-8ce4-54e3-9b4b-f0ba2b715d39" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-10\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\rho \\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-46e437e9-d54d-54d2-aa05-489e40bfc276" :answer/id #uuid "46e437e9-d54d-54d2-aa05-489e40bfc276" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-5\\operatorname{cos}⁡\\theta }\\frac{\\operatorname{cos}⁡ϕ}{\\rho }\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-4dfee53d-1601-5c68-85ae-29e747072a2d" :answer/id #uuid "4dfee53d-1601-5c68-85ae-29e747072a2d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-5\\operatorname{cos}⁡ϕ}\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id 17592186129758 :question/problem "![](images/22/2206a1bc02acb9ddccc5991a4c8d36c9e5d3255e72239e8f7e81908e10faab48.png)\n\nThe region $R$ is enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=18y$ for $x\\ge 0$ and $z\\ge 0,$ shown above. \nExpress the following triple integral in spherical polar coordinates. \n\n$$\n{∭}_{R}xy\\,\\text{d}V\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-quarter of the sphere of radius $3$ centered at $(0,3,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=18y$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =18y \\\\ {\\rho }^{2} & =18\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -18\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =18\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/57/578c7f81a0dae8339772dec9a9407fb380866e5dde5fdd18fee04feb6afe5749.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 18\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=xy:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}xy\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{18\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{4}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186128029 :answer-field/correct "answer-89d7f971-7086-5fea-903e-93de814adaa3" :answer-field/choices ["answer-0cf20c60-05f2-5708-980b-fd1527c75409" "answer-79c2061c-f9aa-5de0-aba6-c75d63373665" "answer-a99f008d-ff7c-53f6-9542-fcd0523c8372" "answer-89d7f971-7086-5fea-903e-93de814adaa3" "answer-1ebc1e7a-b1a7-5e33-ad02-11d00e19214e"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cf20c60-05f2-5708-980b-fd1527c75409" :answer/id #uuid "0cf20c60-05f2-5708-980b-fd1527c75409" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\pi /2}{\\int }_{0}^{9\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{4}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-79c2061c-f9aa-5de0-aba6-c75d63373665" :answer/id #uuid "79c2061c-f9aa-5de0-aba6-c75d63373665" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{18\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-a99f008d-ff7c-53f6-9542-fcd0523c8372" :answer/id #uuid "a99f008d-ff7c-53f6-9542-fcd0523c8372" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{18\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-89d7f971-7086-5fea-903e-93de814adaa3" :answer/id #uuid "89d7f971-7086-5fea-903e-93de814adaa3" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{18\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{4}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {sin}^{3}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id "answer-1ebc1e7a-b1a7-5e33-ad02-11d00e19214e" :answer/id #uuid "1ebc1e7a-b1a7-5e33-ad02-11d00e19214e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi /2}{\\int }_{0}^{9\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ" :db/ensure [:answer/validate]} {:db/id 17592186129761 :question/problem "Evaluate the triple integral\n\n$$\n{∭}_{R}\\frac{2}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=1.$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $1$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 1,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{2}{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{2}{{\\rho }^{2}}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{2}{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{2}{{\\rho }^{2}}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}2\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & =2{\\int }_{0}^{\\pi }\\operatorname{sin}⁡ϕ\\,dϕ\\cdot {\\int }_{0}^{2\\pi }d\\theta \\cdot {\\int }_{0}^{1}d\\rho  \\\\  & =2[-\\operatorname{cos}⁡ϕ]_{ϕ=0}^{ϕ=\\pi }\\cdot [\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot [\\rho ]_{\\rho =0}^{\\rho =1} \\\\  & =-2(-1-1)\\cdot (2\\pi -0)\\cdot (1-0) \\\\  & =8\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186128047 :answer-field/correct "answer-2ba2f8bc-07b7-555b-abce-2dbd526387b8" :answer-field/choices ["answer-70c5bbdd-a425-59db-9485-4faa31a3b688" "answer-77a30a35-8585-5967-8315-37366fe40e4e" "answer-2ba2f8bc-07b7-555b-abce-2dbd526387b8" "answer-8f37f742-d997-54de-b9c5-8167d0c0fb92" "answer-ccae1240-5ff0-5901-882e-959174fe23e9"] :db/ensure [:answer-field/validate]} {:db/id "answer-70c5bbdd-a425-59db-9485-4faa31a3b688" :answer/id #uuid "70c5bbdd-a425-59db-9485-4faa31a3b688" :answer/type :answer.type/math :answer/value "2\\pi \\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "answer-77a30a35-8585-5967-8315-37366fe40e4e" :answer/id #uuid "77a30a35-8585-5967-8315-37366fe40e4e" :answer/type :answer.type/math :answer/value "4\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-2ba2f8bc-07b7-555b-abce-2dbd526387b8" :answer/id #uuid "2ba2f8bc-07b7-555b-abce-2dbd526387b8" :answer/type :answer.type/math :answer/value "8\\pi " :db/ensure [:answer/validate]} {:db/id "answer-8f37f742-d997-54de-b9c5-8167d0c0fb92" :answer/id #uuid "8f37f742-d997-54de-b9c5-8167d0c0fb92" :answer/type :answer.type/math :answer/value "\\frac{12}{\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-ccae1240-5ff0-5901-882e-959174fe23e9" :answer/id #uuid "ccae1240-5ff0-5901-882e-959174fe23e9" :answer/type :answer.type/math :answer/value "\\frac{2}{{\\pi }^{2}}" :db/ensure [:answer/validate]} {:db/id "question-0136e908-03ab-5353-9218-7031e36c58ca" :question/id #uuid "0136e908-03ab-5353-9218-7031e36c58ca" :question/math-academy-id "q-161787" :question/problem "![](images/61/61bd212879bc2f37dba7637bb3b126e33c5f7b0fbebd5a676874d9b3f6bc38da.png)\n\nEvaluate the triple integral\n\n$$\n{∭}_{R}\\frac{1}{{x}^{2}+{y}^{2}}\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=6y$ for $x\\ge 0,$ shown above." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $3$ centered at $(0,3,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=6y$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =6y \\\\ {\\rho }^{2} & =6\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -6\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =6\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/f5/f52fe1c2e73dcbe972d72d263a5a43f2c99dbd573395fbf6e3a3b78b46e1f461.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 6\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{1}{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{1}{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}+(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}} \\\\  & =\\frac{1}{{\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\frac{1}{{\\rho }^{2}{sin}^{2}⁡ϕ}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{{\\rho }^{2}{sin}^{2}⁡ϕ}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi /2}{\\int }_{0}^{6\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\frac{1}{\\operatorname{sin}⁡ϕ}\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡ϕ}[\\rho ]_{\\rho =0}^{\\rho =6\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ}\\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡ϕ}(6\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ-0)\\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{\\pi /2}6\\operatorname{sin}⁡\\theta \\,d\\theta \\,dϕ \\\\  & =6{\\int }_{0}^{\\pi }dϕ\\cdot {\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta \\,d\\theta  \\\\  & =6[ϕ]_{ϕ=0}^{ϕ=\\pi }\\cdot [-\\operatorname{cos}⁡\\theta ]_{\\theta =0}^{\\theta =\\pi /2} \\\\  & =6(\\pi -0)\\cdot (-0+1) \\\\  & =6\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-453a80d3-4572-568f-a182-685985b15243"] :db/ensure [:question/validate]} {:db/id "answer-field-453a80d3-4572-568f-a182-685985b15243" :answer-field/id #uuid "453a80d3-4572-568f-a182-685985b15243" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-109a83cd-781d-5694-9781-188bd9aaeeb3" :answer-field/choices ["answer-4a6483cc-ffc1-5e9c-84c3-e71f0a0fde29" "answer-89405e80-2f4a-52b4-8de1-3252e9336dd9" "answer-109a83cd-781d-5694-9781-188bd9aaeeb3" "answer-50912d13-7637-55d7-a096-19d196f870ed" "answer-127f15fb-77a4-5f53-a36b-526f40d40b1b"] :db/ensure [:answer-field/validate]} {:db/id "answer-4a6483cc-ffc1-5e9c-84c3-e71f0a0fde29" :answer/id #uuid "4a6483cc-ffc1-5e9c-84c3-e71f0a0fde29" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-89405e80-2f4a-52b4-8de1-3252e9336dd9" :answer/id #uuid "89405e80-2f4a-52b4-8de1-3252e9336dd9" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-109a83cd-781d-5694-9781-188bd9aaeeb3" :answer/id #uuid "109a83cd-781d-5694-9781-188bd9aaeeb3" :answer/type :answer.type/math :answer/value "6\\pi " :db/ensure [:answer/validate]} {:db/id "answer-50912d13-7637-55d7-a096-19d196f870ed" :answer/id #uuid "50912d13-7637-55d7-a096-19d196f870ed" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-127f15fb-77a4-5f53-a36b-526f40d40b1b" :answer/id #uuid "127f15fb-77a4-5f53-a36b-526f40d40b1b" :answer/type :answer.type/math :answer/value "\\frac{7\\pi }{4}" :db/ensure [:answer/validate]} {:db/id 17592186371961 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $1$ centered at $(1,0,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=2x$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =2x \\\\ {\\rho }^{2} & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\rho (\\rho -2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](images/31/31a18ebb9608ff60a4a5ecbcfa8defcb6a64337b126cb5859cb042f1019b1194.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{3z}{\\sqrt{({x}^{2}+{y}^{2}+{z}^{2})^{3}}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{3\\rho \\operatorname{cos}⁡ϕ}{\\sqrt{({\\rho }^{2})^{3}}} \\\\  & =\\frac{3\\operatorname{cos}⁡ϕ}{{\\rho }^{2}}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{3z}{\\sqrt{({x}^{2}+{y}^{2}+{z}^{2})^{3}}}\\,\\text{d}V & ={∭}_{Δ}\\frac{3\\operatorname{cos}⁡ϕ}{{\\rho }^{2}}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}3\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{-\\pi /2}^{\\pi /2}3\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ[\\rho ]_{\\rho =0}^{\\rho =2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ}\\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{-\\pi /2}^{\\pi /2}3\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ(2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ-0)\\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{-\\pi /2}^{\\pi /2}6\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ{sin}^{2}⁡ϕ\\,d\\theta \\,dϕ \\\\  & =2\\cdot {\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡ϕ{sin}^{2}⁡ϕ\\,dϕ\\cdot {\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡\\theta \\,d\\theta  \\\\  & =2\\cdot [-{sin}^{3}⁡ϕ]_{ϕ=0}^{ϕ=\\pi /2}\\cdot [-\\operatorname{sin}⁡\\theta ]_{\\theta =-\\pi /2}^{\\theta =\\pi /2} \\\\  & =2\\cdot [{sin}^{3}⁡ϕ]_{ϕ=0}^{ϕ=\\pi /2}\\cdot [\\operatorname{sin}⁡\\theta ]_{\\theta =-\\pi /2}^{\\theta =\\pi /2} \\\\  & =2\\cdot (1-0)\\cdot (1-(-1)) \\\\  & =4\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-4913e4d1-197e-5ba9-a574-72530dddbf74" :question/id #uuid "4913e4d1-197e-5ba9-a574-72530dddbf74" :question/math-academy-id "q-161789" :question/problem "![](images/08/085e28508da725e445c410fedc08a1992dccc5e0a7b99b3248182f58ffae2c07.png)\n\nEvaluate the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=4z,$ shown above." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $2$ centered at $(0,0,2).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}=4z$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =4z \\\\ {\\rho }^{2} & =4\\rho \\operatorname{cos}⁡ϕ \\\\ \\rho (\\rho -4\\operatorname{cos}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =4\\operatorname{cos}⁡ϕ.$\n\n![](images/8a/8a730a72fe9f3f69878ef647215e8ed05e913f23bf8e0fab01bad6271e860335.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{1}{\\sqrt{{\\rho }^{2}}} \\\\  & =\\frac{1}{\\rho }\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\rho }\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\pi }{\\int }_{0}^{4\\operatorname{cos}⁡ϕ}\\rho \\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡ϕ{[\\frac{1}{2}{\\rho }^{2}]}_{\\rho =0}^{\\rho =4\\operatorname{cos}⁡ϕ}\\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\pi }8\\operatorname{sin}⁡ϕ{cos}^{2}⁡ϕ\\,d\\theta \\,dϕ \\\\  & =8{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡ϕ{cos}^{2}⁡ϕ\\,dϕ\\cdot {\\int }_{0}^{2\\pi }d\\theta  \\\\  & =8{[-\\frac{1}{3}{cos}^{3}⁡ϕ]}_{ϕ=0}^{ϕ=\\pi /2}\\cdot [\\theta ]_{\\theta =0}^{\\theta =2\\pi } \\\\  & =-\\frac{8}{3}(0-1)\\cdot (2\\pi -0) \\\\  & =\\frac{16\\pi }{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-27ef04a2-40cf-5a45-9600-60f9cd13b11c"] :db/ensure [:question/validate]} {:db/id "answer-field-27ef04a2-40cf-5a45-9600-60f9cd13b11c" :answer-field/id #uuid "27ef04a2-40cf-5a45-9600-60f9cd13b11c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e2f7ffd3-d593-5a78-9afb-ab0de4615675" :answer-field/choices ["answer-71daa61c-f673-5487-82fd-dfae267f950a" "answer-af8ed3a1-6f17-5628-a41f-6b72eaa00e2b" "answer-e76d4b36-6b12-5f00-85a3-5cc9eafa0940" "answer-e2f7ffd3-d593-5a78-9afb-ab0de4615675" "answer-84aa3c04-cf41-557b-8aea-45aea8b80596"] :db/ensure [:answer-field/validate]} {:db/id "answer-71daa61c-f673-5487-82fd-dfae267f950a" :answer/id #uuid "71daa61c-f673-5487-82fd-dfae267f950a" :answer/type :answer.type/math :answer/value "12\\pi " :db/ensure [:answer/validate]} {:db/id "answer-af8ed3a1-6f17-5628-a41f-6b72eaa00e2b" :answer/id #uuid "af8ed3a1-6f17-5628-a41f-6b72eaa00e2b" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e76d4b36-6b12-5f00-85a3-5cc9eafa0940" :answer/id #uuid "e76d4b36-6b12-5f00-85a3-5cc9eafa0940" :answer/type :answer.type/math :answer/value "8\\pi " :db/ensure [:answer/validate]} {:db/id "answer-e2f7ffd3-d593-5a78-9afb-ab0de4615675" :answer/id #uuid "e2f7ffd3-d593-5a78-9afb-ab0de4615675" :answer/type :answer.type/math :answer/value "\\frac{16\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "answer-84aa3c04-cf41-557b-8aea-45aea8b80596" :answer/id #uuid "84aa3c04-cf41-557b-8aea-45aea8b80596" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "question-ddc59e97-e243-5e27-9d57-5e0f9b714882" :question/id #uuid "ddc59e97-e243-5e27-9d57-5e0f9b714882" :question/math-academy-id "q-161777" :question/problem "![](images/90/90d5e9115d216f2a7f8fba49295a36b95cd932c4df7f8bace1b45e3542e9ae11.png)\n\nEvaluate the triple integral\n\n$$\n{∭}_{R}{({x}^{2}+{y}^{2}+{z}^{2})}^{3}\\,\\text{d}V\n$$\n\nover the region $R$ enclosed inside the sphere ${x}^{2}+{y}^{2}+{z}^{2}=1$ for $x\\ge 0$ and $z\\ge 0,$ shown above." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-quarter of the sphere of radius $1$ centered at the origin.\n\n![](images/ec/ec2f6c67eee7f836cc71efec2b17c2276aa8a9d397c632b3c499a46a75f7b95c.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 1,\\,-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2},\\,0\\le ϕ\\le \\frac{\\pi }{2}\\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)={({x}^{2}+{y}^{2}+{z}^{2})}^{3}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & ={({\\rho }^{2})}^{3} \\\\  & ={\\rho }^{6}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}{({x}^{2}+{y}^{2}+{z}^{2})}^{3}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{6}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{1}{\\rho }^{8}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡ϕ\\,dϕ\\cdot {\\int }_{-\\pi /2}^{\\pi /2}d\\theta \\cdot {\\int }_{0}^{1}{\\rho }^{8}\\,d\\rho  \\\\  & =[-\\operatorname{cos}⁡ϕ]_{ϕ=0}^{ϕ=\\pi /2}\\cdot [\\theta ]_{\\theta =-\\pi /2}^{\\theta =\\pi /2}\\cdot {[\\frac{1}{9}{\\rho }^{9}]}_{\\rho =0}^{\\rho =1} \\\\  & =-(0-1)\\cdot (\\frac{\\pi }{2}-(-\\frac{\\pi }{2}))\\cdot \\frac{1}{9}(1-0) \\\\  & =1\\cdot \\pi \\cdot \\frac{1}{9} \\\\  & =\\frac{\\pi }{9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-748331ec-5745-5dc8-9854-65c69f6cb19e"] :db/ensure [:question/validate]} {:db/id "answer-field-748331ec-5745-5dc8-9854-65c69f6cb19e" :answer-field/id #uuid "748331ec-5745-5dc8-9854-65c69f6cb19e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1508999f-583d-5409-a945-a2774f7b6030" :answer-field/choices ["answer-fdb401e4-0e59-57f0-b798-ca38f29d946f" "answer-1e78963c-6d08-52e4-886b-c299ac1eab3b" "answer-a5dfe954-7d04-5a12-8506-1f9267e2a525" "answer-1508999f-583d-5409-a945-a2774f7b6030" "answer-107bc90b-168a-5ae7-9c1e-5151de594035"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdb401e4-0e59-57f0-b798-ca38f29d946f" :answer/id #uuid "fdb401e4-0e59-57f0-b798-ca38f29d946f" :answer/type :answer.type/math :answer/value "3\\pi " :db/ensure [:answer/validate]} {:db/id "answer-1e78963c-6d08-52e4-886b-c299ac1eab3b" :answer/id #uuid "1e78963c-6d08-52e4-886b-c299ac1eab3b" :answer/type :answer.type/math :answer/value "\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-a5dfe954-7d04-5a12-8506-1f9267e2a525" :answer/id #uuid "a5dfe954-7d04-5a12-8506-1f9267e2a525" :answer/type :answer.type/math :answer/value "\\frac{5\\pi }{8}" :db/ensure [:answer/validate]} {:db/id "answer-1508999f-583d-5409-a945-a2774f7b6030" :answer/id #uuid "1508999f-583d-5409-a945-a2774f7b6030" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{9}" :db/ensure [:answer/validate]} {:db/id "answer-107bc90b-168a-5ae7-9c1e-5151de594035" :answer/id #uuid "107bc90b-168a-5ae7-9c1e-5151de594035" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id 17592186130455 :tutorial/content "When evaluating triple integrals, it's sometimes easier to change the variables from Cartesian coordinates to spherical polar coordinates.\n\nFor example, suppose we want to evaluate the triple integral\n\n$$\n\\displaystyle \\iiint\\limits_R \\left(x^2 + y^2 + z^2\\right)^{3/2} \\: \\textrm{d}V\n$$\n\nwhere $R$ is the region enclosed by the sphere of radius $1$ centered at $O,$ as shown below.\n\n![](images/08/0809a74f0aca2b3042b7f8db6783f9d6a13bc84bfc75ddcbb4d3076dbf0a2efd.png)\n\nThis integral seems too challenging when written in Cartesian coordinates. However, we should recognize that the problem lends itself to spherical polar coordinates because\n\n- the domain $R$ has a simple spherical polar representation, and\n\n- the integrand $f(x,y,z)=\\left(x^2+y^2+z^2\\right)^{3/2}$ can also be expressed simply in spherical polar coordinates.\n\nSo, let's transform the entire problem to spherical polar coordinates using the transformation $\\mathbf{T},$ defined by\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad\n\ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \n\nz = \\rho\\cos\\phi.\n$$\n\nThe preimage of $R$ under the action of $\\mathbf{T}$ is the rectangular region $\\Delta,$ given by\n\n$$\n\\Delta = \\left\\{ (\\rho, \\theta, \\phi) \\, : \\, 0 \\leq \\rho \\leq 1, \\: 0 \\leq \\theta \\lt 2\\pi, \\: 0 \\leq \\phi \\leq \\pi \\right\\},\n$$\n\nas shown below.\n\n![](images/c2/c2ed8a57c5e66687428a524eb148f96672f3a1ace7fbd28d426de065b2fb5f1f.png)\n\nTo express our integral in terms of spherical polar coordinates, we will use the change of variables formula\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, \\mathrm{d}V = \n\n\\iiint\\limits_{\\Delta} \\, f(\\rho\\cos\\theta\\sin\\phi, \\rho\\sin\\theta\\sin\\phi, \\rho\\cos\\phi) \\: \\left| \\dfrac{\\partial (x,y,z)}{\\partial (\\rho, \\theta, \\phi)} \\right| \\: \\mathrm{d}\\rho \\, \\mathrm{d}\\theta \\, \\mathrm{d}\\phi.\n$$\n\nIt can be shown that the absolute value of the Jacobian determinant for a spherical change of variables is\n\n$$\n\\left| \\dfrac{\\partial (x,y,z)}{\\partial (\\rho, \\theta, \\phi)} \\right| = \\rho^2\\sin\\phi.\n$$\n\nTherefore, the change of variables formula is\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, \\mathrm{d}V = \n\n\\iiint\\limits_{\\Delta} \\, f(\\rho\\cos\\theta\\sin\\phi, \\rho\\sin\\theta\\sin\\phi, \\rho\\cos\\phi) \\:  \\rho^2\\sin\\phi \\: \\mathrm{d}\\rho \\, \\mathrm{d}\\theta \\, \\mathrm{d}\\phi.\n$$\n\nNow, let's write our function $f(x,y,z) = \\left(x^2 + y^2 + z^2\\right)^{3/2}$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & ={({\\rho }^{2})}^{3/2} \\\\  & ={\\rho }^{3}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}{({x}^{2}+{y}^{2}+{z}^{2})}^{3/2}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{3}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{1}{\\rho }^{5}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡ϕ\\,dϕ\\cdot {\\int }_{0}^{2\\pi }d\\theta \\cdot {\\int }_{0}^{1}{\\rho }^{5}\\,d\\rho  \\\\  & =[-\\operatorname{cos}⁡ϕ]_{ϕ=0}^{ϕ=\\pi }\\cdot [\\theta ]_{\\theta =0}^{\\theta =2\\pi }\\cdot {[\\frac{1}{6}{\\rho }^{6}]}_{\\rho =0}^{\\rho =1}\\,d\\rho  \\\\  & =-(-1-1)\\cdot (2\\pi -0)\\cdot \\frac{1}{6}(1-0) \\\\  & =2\\cdot 2\\pi \\cdot \\frac{1}{6} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186130468 :tutorial/content "Throughout this lesson, we've used the fact that \n\n$$\n\\left| \\dfrac{\\partial (x, y, z)}{\\partial (\\rho, \\theta, \\phi)} \\right| = \\rho^2 \\sin{\\phi}.\n$$\n\nLet's now prove this result.\n\nGiven the spherical coordinate transformations\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad\n\ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \n\nz = \\rho\\cos\\phi,\n$$\n\nwe first  calculate the required partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂\\rho } & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂x}{∂\\theta } & =-\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂x}{∂ϕ} & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\frac{∂y}{∂\\rho } & =\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂y}{∂\\theta } & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\,\\frac{∂y}{∂ϕ} & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\frac{∂z}{∂\\rho } & =\\operatorname{cos}⁡ϕ & \\,\\frac{∂z}{∂\\theta } & =0 & \\,\\frac{∂z}{∂ϕ} & =-\\rho \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(\\rho ,\\theta ,ϕ)} & =|\\begin{aligned}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & -\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\operatorname{cos}⁡ϕ & 0 & -\\rho \\operatorname{sin}⁡ϕ\\end{aligned}| \\\\  & =\\operatorname{cos}⁡ϕ|\\begin{aligned}-\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ \\\\ \\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ\\end{aligned}|-\\rho \\operatorname{sin}⁡ϕ|\\begin{aligned}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ & -\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\ \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & \\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ\\end{aligned}| \\\\  & =\\operatorname{cos}⁡ϕ\\cdot (-{\\rho }^{2}\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta ))-\\rho \\operatorname{sin}⁡ϕ\\cdot \\rho {sin}^{2}⁡ϕ\\cdot ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) \\\\  & =-{\\rho }^{2}\\operatorname{sin}⁡ϕ{cos}^{2}⁡ϕ-{\\rho }^{2}\\operatorname{sin}⁡ϕ{sin}^{2}⁡ϕ \\\\  & =-{\\rho }^{2}\\operatorname{sin}⁡ϕ({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) \\\\  & =-{\\rho }^{2}\\operatorname{sin}⁡ϕ.\\end{aligned}\n$$\n\nFinally, we conclude that\n\n$$\n\\left| \\dfrac{\\partial (x, y, z)}{\\partial (\\rho, \\theta, \\phi)} \\right| = \\rho^2 \\sin{\\phi}.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186130469 :tutorial/content "We can also derive the change of variables formula for spherical polar coordinates using geometry.\n\nConsider a bounded spherical box $R,$ given by\n\n$$\nR = \\big\\{ (\\rho,\\theta,\\phi) \\: | \\: a \\leq \\rho \\leq b, \\:\\: \\alpha \\leq \\theta \\leq \\beta, \\:\\: \\gamma \\leq \\phi \\leq \\psi \\big\\}.\n$$\n\nWe can divide each interval into $l,m,$ and $n$ subdivisions such that \n\n$$\n\\Delta\\rho = \\dfrac{b-a}{l},\\qquad \\Delta\\theta = \\dfrac{\\beta-\\alpha}{m},\\qquad \\Delta\\phi = \\dfrac{\\psi-\\gamma}{n}.\n$$\n\nThis splits the region into \"spherical wedges,\" as shown in the following diagram.\n\n![](images/88/88be4c6a09062321d20ac7f48dfbb6be796cdd6b5bb1b7f6adc49a6ae1da609b.png)\n\nZooming in on one of these wedges, we obtain a shape resembling a rectangular solid.\n\n![](images/5e/5e5f7acb4d057e856c66e9d5626f81178ca26c0b7ce83cdf7290b1f4c64b1852.png)\n\nLet's note the volume of this solid as $\\Delta V.$ To approximate the value of $\\Delta V,$ we use the formula for the volume of a rectangular solid:\n\n$$\n\\Delta V \\approx lwh\n$$\n\nClearly, the height of the rectangular solid is $h = \\Delta \\rho.$ We can find the remaining dimensions using simple geometry. \n\nFirst, we need to find the length of the radius $r$ in the $xy$-plane. Using the following triangle and a side-on view of the wedge, we conclude that $r=\\rho\\sin\\phi.$\n\n![](images/01/0122c6c3b813bbe2821dbede794b6027cd69002dd1828925811211045a0d67e8.png)\n\nLet's add this to our diagram.\n\n![](images/d4/d41b538e9bb3add9bae1e3a24c9f87ae282a8b969f0c0dc4acd374ad777de74a.png)\n\nFinally, we can use the arc length formula $s = r \\cdot \\theta$ to find the length $l$ and width $w.$\n\n![](images/88/882b9243d1189c098aaf6e1e45ca7ec97d480b1f2c3a8fe23d5e39a6c2313ed2.png)\n\nThe length of our wedge is \n\n$$\nl = \\rho \\cdot \\Delta\\phi = \\rho\\Delta\\phi\n$$\n\n and the width is \n\n$$\nw = \\rho\\sin\\phi \\cdot \\Delta\\theta = \\rho\\sin\\phi\\Delta\\theta.\n$$\n\nCalculating the volume as a rectangular solid, we obtain\n\n$$\n\\begin{aligned}ΔV & ≈lwh \\\\  & =(\\rho Δϕ)\\cdot (\\rho \\operatorname{sin}⁡ϕΔ\\theta )\\cdot (Δ\\rho ) \\\\  & ={\\rho }^{2}\\operatorname{sin}⁡ϕ\\,Δϕ\\,Δ\\theta \\,Δ\\rho .\\end{aligned}\n$$\n\nAs a result, we define the triple integral in spherical coordinates as the limit of a triple Riemann sum, where $(\\rho_{ijk},\\theta_{ijk},\\phi_{ijk})$ being any sample point in the spherical subregion $B{ijk}{:}$\n\n$$\n\\lim\\limits_{l,m,n \\to \\infty} \\sum\\limits_{i=1}^{l} \\sum\\limits_{j=1}^{m} \\sum\\limits_{k=1}^{n} f(\\rho_{ijk},\\theta_{ijk},\\phi_{ijk}) (\\rho_{ijk})^2 \\sin \\phi_{ijk} \\:\\Delta\\rho\\:\\Delta\\theta\\:\\Delta\\phi\n$$\n\nAs we increase the number of subregions, the size of $\\Delta\\rho,$ $\\Delta\\theta,$ and $\\Delta\\phi$ all goes to zero, and the volume of $R$ is more accurately approximated, giving\n\n$$\n\\textrm{d}V = \\rho^2 \\sin\\phi \\:\\textrm{d}\\rho\\:\\textrm{d}\\theta\\:\\textrm{d}\\phi.\n$$\n\nTherefore, we conclude that if $f(\\rho,\\theta,\\phi)$ is continuous on a spherical box $R = [a,b] \\times [\\alpha,\\beta] \\times [\\gamma, \\psi],$ then\n\n$$\n\\iiint\\limits_{R} f(\\rho,\\theta,\\phi) \\:\\textrm{d}V\n=\n\\iiint\\limits_{R} f(\\rho,\\theta,\\phi) \\rho^2 \\sin\\phi \\:\\textrm{d}\\rho\\:\\textrm{d}\\theta\\:\\textrm{d}\\phi\n=\n\\int_{\\gamma}^{\\psi}\\int_{\\alpha}^{\\beta}\\int_{a}^{b} f(\\rho,\\theta,\\phi) \\rho^2 \\sin\\phi \\:\\textrm{d}\\rho\\:\\textrm{d}\\theta\\:\\textrm{d}\\phi.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186129390 :activity/expected-seconds 1200.0 :db/ensure [:activity/validate]}]
