}^{4}n+25{n}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9273e604-ce32-5385-8c2c-18948b45297b" "answer-field-69007d20-699a-5e7e-9900-ff3d794b6109" "answer-field-4d7bcf5e-4789-5daa-907e-2a091cad4ed2"] :db/ensure [:question/validate]} {:db/id "answer-field-9273e604-ce32-5385-8c2c-18948b45297b" :answer-field/id #uuid "9273e604-ce32-5385-8c2c-18948b45297b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-766e3030-1293-59b8-ae62-3fb6e47e2922" :answer-field/choices ["answer-766e3030-1293-59b8-ae62-3fb6e47e2922"] :db/ensure [:answer-field/validate]} {:db/id "answer-766e3030-1293-59b8-ae62-3fb6e47e2922" :answer/id #uuid "766e3030-1293-59b8-ae62-3fb6e47e2922" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-field-69007d20-699a-5e7e-9900-ff3d794b6109" :answer-field/id #uuid "69007d20-699a-5e7e-9900-ff3d794b6109" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-66b4ddc4-84c4-51a3-93e6-e9af258a4881" :answer-field/choices ["answer-66b4ddc4-84c4-51a3-93e6-e9af258a4881"] :db/ensure [:answer-field/validate]} {:db/id "answer-66b4ddc4-84c4-51a3-93e6-e9af258a4881" :answer/id #uuid "66b4ddc4-84c4-51a3-93e6-e9af258a4881" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-field-4d7bcf5e-4789-5daa-907e-2a091cad4ed2" :answer-field/id #uuid "4d7bcf5e-4789-5daa-907e-2a091cad4ed2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-3599e74f-c54e-5efd-9ec4-df49635850c1" :answer-field/choices ["answer-3599e74f-c54e-5efd-9ec4-df49635850c1"] :db/ensure [:answer-field/validate]} {:db/id "answer-3599e74f-c54e-5efd-9ec4-df49635850c1" :answer/id #uuid "3599e74f-c54e-5efd-9ec4-df49635850c1" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "question-e5bdd830-1ec1-554e-a24b-2d538b13172e" :question/id #uuid "e5bdd830-1ec1-554e-a24b-2d538b13172e" :question/math-academy-id "q-78931" :question/problem "${({x}^{4}+2{c}^{2})}^{2}=$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a={x}^{4}$ and $b=2{c}^{2},$ we have\n\n$$\n\\begin{aligned}({x}^{4}+2{c}^{2})^{2} & = \\\\ {({x}^{4})}^{2}+2({x}^{4})(2{c}^{2})+(2{c}^{2})^{2} & = \\\\ {x}^{8}+4{x}^{4}{c}^{2}+4{c}^{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-aaa8c9ec-8ced-5a47-b6bc-575605ba1b5b"] :db/ensure [:question/validate]} {:db/id "answer-field-aaa8c9ec-8ced-5a47-b6bc-575605ba1b5b" :answer-field/id #uuid "aaa8c9ec-8ced-5a47-b6bc-575605ba1b5b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f787c0c-03cb-51f9-8e40-745ec4e996ab" :answer-field/choices ["answer-f2923cd2-3693-5a8f-a77b-6ef018432274" "answer-50af92f8-3be6-5f37-a95a-564cc2728cb3" "answer-f644fa7e-46be-54d1-96a3-0962b9eead92" "answer-6388eb7c-5120-53e8-8fa8-8aaf0a0ed2df" "answer-1f787c0c-03cb-51f9-8e40-745ec4e996ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-f2923cd2-3693-5a8f-a77b-6ef018432274" :answer/id #uuid "f2923cd2-3693-5a8f-a77b-6ef018432274" :answer/type :answer.type/math :answer/value "2{x}^{4}+4{c}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-50af92f8-3be6-5f37-a95a-564cc2728cb3" :answer/id #uuid "50af92f8-3be6-5f37-a95a-564cc2728cb3" :answer/type :answer.type/math :answer/value "{x}^{4}+2{x}^{2}c+4{c}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-f644fa7e-46be-54d1-96a3-0962b9eead92" :answer/id #uuid "f644fa7e-46be-54d1-96a3-0962b9eead92" :answer/type :answer.type/math :answer/value "{x}^{8}+2{x}^{4}{c}^{2}+4{c}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-6388eb7c-5120-53e8-8fa8-8aaf0a0ed2df" :answer/id #uuid "6388eb7c-5120-53e8-8fa8-8aaf0a0ed2df" :answer/type :answer.type/math :answer/value "{x}^{8}+4{c}^{4}" :db/ensure [:answer/validate]} {:db/id "answer-1f787c0c-03cb-51f9-8e40-745ec4e996ab" :answer/id #uuid "1f787c0c-03cb-51f9-8e40-745ec4e996ab" :answer/type :answer.type/math :answer/value "{x}^{8}+4{x}^{4}{c}^{2}+4{c}^{4}" :db/ensure [:answer/validate]} {:db/id "question-2d137423-8c38-5c63-aa2d-733719761261" :question/id #uuid "2d137423-8c38-5c63-aa2d-733719761261" :question/math-academy-id "q-216488" :question/problem "${(2{x}^{2}+3)}^{2}\\,\\,=\\,\\,${{field-1}}${x}^{4}\\,\\,+$\n{{field-2}}${x}^{2}\\,\\,+9$" :question/worked-solution "We will use the following formula:\n\n$$\n(a+b)^{2}={a}^{2}+2ab+{b}^{2}\n$$\n\nSubstituting $a=2{x}^{2}$ and $b=3,$ we have\n\n$$\n\\begin{aligned}{(2{x}^{2}+3)}^{2} & = \\\\ {(2{x}^{2})}^{2}+2(2{x}^{2})(3)+{3}^{2} & = \\\\ 4{x}^{4}+12{x}^{2}+9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f0a2a356-681d-59da-b7f5-816fe79f7dc4" "answer-field-04f7fdd5-6526-50c1-bd2d-3e03d282d11e"] :db/ensure [:question/validate]} {:db/id "answer-field-f0a2a356-681d-59da-b7f5-816fe79f7dc4" :answer-field/id #uuid "f0a2a356-681d-59da-b7f5-816fe79f7dc4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-43231816-88c3-5bce-9682-f610fb3f3fd4" :answer-field/choices ["answer-43231816-88c3-5bce-9682-f610fb3f3fd4"] :db/ensure [:answer-field/validate]} {:db/id "answer-43231816-88c3-5bce-9682-f610fb3f3fd4" :answer/id #uuid "43231816-88c3-5bce-9682-f610fb3f3fd4" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-04f7fdd5-6526-50c1-bd2d-3e03d282d11e" :answer-field/id #uuid "04f7fdd5-6526-50c1-bd2d-3e03d282d11e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ceeec55a-62de-5adb-8c13-58418f561ead" :answer-field/choices ["answer-ceeec55a-62de-5adb-8c13-58418f561ead"] :db/ensure [:answer-field/validate]} {:db/id "answer-c