}\\end{aligned}| \\\\  & =|\\begin{aligned}2x & 1 & 0 \\\\ 1 & 0 & 1 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1(-1)^{3+3}|\\begin{aligned}2x & 1 \\\\ 1 & 0\\end{aligned}| \\\\  & =0-1 \\\\  & =-1.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-1.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}(x+z)\\operatorname{cos}⁡({x}^{2}+y)\\,dV & ={∭}_{Δ}v\\operatorname{cos}⁡u\\cdot |-1|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}v\\operatorname{cos}⁡u\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}{\\int }_{0}^{2}{\\int }_{-1}^{1}v\\operatorname{cos}⁡u\\,dw\\,dv\\,du \\\\  & ={\\int }_{\\pi /6}^{\\pi /2}\\operatorname{cos}⁡u\\,du\\cdot {\\int }_{0}^{2}v\\,dv\\cdot {\\int }_{-1}^{1}dw \\\\  & =[\\operatorname{sin}⁡u]_{u=\\pi /6}^{u=\\pi /2}\\cdot {[\\frac{{v}^{2}}{2}]}_{v=0}^{v=2}\\cdot [w]_{w=-1}^{w=1} \\\\  & =(1-\\frac{1}{2})\\cdot (\\frac{{2}^{2}}{2}-0)\\cdot (1-(-1)) \\\\  & =2\\end{aligned}\n$$" 13194139535226 17592186045417 true] [17592186198965 1070 #edb/ref 17592186045486 13194139535226 17592186045417 true] [17592186198965 1071 "Find the volume bounded by the region $R$, given by\n$R = {(x, y, z): 1 \\le y \\le 2, 1 \\le \\sqrt{y} + x \\le 2, 1 \\le \\frac{1}{z + 1} \\le 5}$." 13194139535226 17592186045417 false] [17592186198965 1071 "Find the volume bounded by the region $R,$ given by\n\n$$\nR=\\{(x,y,z)\\,:\\,1\\le y\\le 2,\\,1\\le \\sqrt{y}+x\\le 2,\\,1\\le \\frac{1}{z+1}\\le 5\\}.\n$$" 13194139535226 17592186045417 true] [17592186198965 1074 "Recall that the volume of $R$ can be found as \n\n$$\nV={∭}_{R}\\text{d}V.\n$$\n\nLet's define a transformation $T$ as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f