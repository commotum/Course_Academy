:knowledge-point/validate]} {:db/id "question-e6548717-af2d-5bfc-9298-8a16a46973b2" :question/id #uuid "e6548717-af2d-5bfc-9298-8a16a46973b2" :question/math-academy-id "q-71858" :question/problem "Given the hyperboloid of one sheet $\\frac{(x-2)^{2}}{4}+\\frac{(y-2)^{2}}{4}-\\frac{(z-3)^{2}}{9}=1$, find its $y$-intercepts." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{4}+\\frac{(y-2)^{2}}{4}-\\frac{(0-3)^{2}}{9} & =1 \\\\ 1+\\frac{(y-2)^{2}}{4}-1 & =1 \\\\ \\frac{(y-2)^{2}}{4} & =1 \\\\ (y-2)^{2} & =4 \\\\ y-2 & =\\pm \\sqrt{4} \\\\ y & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $y=0$ and $y=4.$\n\nTherefore, the intercepts with the $y$-axis are $(0,0,0)$ and $(0,4,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da"] :db/ensure [:question/validate]} {:db/id "answer-field-d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/id #uuid "d7d6da6e-d2bc-559d-a654-e2becdcb61da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9dd75581-e364-58bb-8ecc-8010b1071f10" :answer-field/choices ["answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" "answer-e636de43-6150-50b8-95ab-2fe05095f1c9" "answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" "answer-5726b996-61c1-520e-b808-c1131fdf41b0" "answer-9dd75581-e364-58bb-8ecc-8010b1071f10"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/id #uuid "0b05d521-7d63-5960-a052-63edd7b8a9ff" :answer/type :answer.type/text :answer/value "$(0,-1,0)$ and $(0,3,0)$" :db/ensure [:answer/validate]} {:db/id "answer-e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/id #uuid "e636de43-6150-50b8-95ab-2fe05095f1c9" :answer/type :answer.type/text :answer/value "$(0,-2,0)$ and $(0,2,0)$" :db/ensure [:answer/validate]} {:db/id "answer-a8ecfd2c-d21c-5bab-9bca-e9ac877257e6" :answer/id #u