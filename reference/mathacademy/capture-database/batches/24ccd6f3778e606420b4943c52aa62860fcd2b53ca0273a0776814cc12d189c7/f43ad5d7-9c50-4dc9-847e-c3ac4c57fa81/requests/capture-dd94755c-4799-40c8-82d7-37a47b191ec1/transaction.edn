00-bfbe08e037e4" "answer-544b3c82-fcc6-5bf8-a3c9-e3fac20c5cae" "answer-6e3ebcfb-bb47-5df6-bc10-d608c9888a86" "answer-81afa30f-69f6-52fc-a038-b1524a3d266e"] :db/ensure [:answer-field/validate]} {:db/id "answer-90ab5b45-7486-543d-97b1-79c5a6eb92c9" :answer/id #uuid "90ab5b45-7486-543d-97b1-79c5a6eb92c9" :answer/type :answer.type/image :answer/value "images/81/8125a77e3492219f56421cd2538294de915c6c6ae8a98a662df4b665bc0fbb50.png" :db/ensure [:answer/validate]} {:db/id "answer-b1883042-e60b-5796-9300-bfbe08e037e4" :answer/id #uuid "b1883042-e60b-5796-9300-bfbe08e037e4" :answer/type :answer.type/image :answer/value "images/ba/ba6101874c3630a7a65c4f783d4a6d35034972c1f6254720b88db75664cc66ce.png" :db/ensure [:answer/validate]} {:db/id "answer-544b3c82-fcc6-5bf8-a3c9-e3fac20c5cae" :answer/id #uuid "544b3c82-fcc6-5bf8-a3c9-e3fac20c5cae" :answer/type :answer.type/image :answer/value "images/c3/c35316b772366403fca0d0ba030866a82ef0d7c411c2817aa7e1feffa894c96e.png" :db/ensure [:answer/validate]} {:db/id "answer-6e3ebcfb-bb47-5df6-bc10-d608c9888a86" :answer/id #uuid "6e3ebcfb-bb47-5df6-bc10-d608c9888a86" :answer/type :answer.type/image :answer/value "images/d3/d361d793e28a54dd53e2ca7453ee42396cc4eaa11a91e9d16aedb2e91f2c62da.png" :db/ensure [:answer/validate]} {:db/id "answer-81afa30f-69f6-52fc-a038-b1524a3d266e" :answer/id #uuid "81afa30f-69f6-52fc-a038-b1524a3d266e" :answer/type :answer.type/image :answer/value "images/ea/ea8d306bac8ad71b1854a7a4f13497f124d7016ee8eabced1fae741ae4dd3dbf.png" :db/ensure [:answer/validate]} {:db/id 17592186147930 :question/worked-solution "Let's sketch the nets of each solid.\n\n![](images/e9/e9168bf41b10db4e0d353aa09682a7fe048216a0ccf28fd196daaf5bf7fd3fff.png)\n\n \n\nAs we can see, the correct answer is:\n\n$\\,$ *\"The net of III consists of $1$ rectangle and $4$ triangles.\"*\n\nOther statements are false. \n\n- *\"The net of II consists of triangles only\"* is false since the net of II has $3$ rectangles (the side faces).\n\n- *\"The net of I has one triangle\"* is not true because the net of I contains only squares.\n\n- *\"The net of III consists of $4$ triangles and $2$ rectangles\"* is false since the net of III only has $1$ rectangle (the base of the solid).\n\n- *\"The net of I consists of exactly $8$ squares\"* is not true because the net of I only has $6$ squares." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186145334 :answer-field/correct 17592186145336 :db/ensure [:answer-field/validate]} {:db/id "question-776cd40d-1c79-55ee-9771-1ee0329ddc24" :question/id #uuid "776cd40d-1c79-55ee-9771-1ee0329ddc24" :question/math-academy-id "q-61779" :question/problem "![](images/56/5683cb4560a5715654c795d94f4123c79a758e281ef40b92cccb379482506c2c.png)\n\nWhich of the statements is true about the solids depicted above?" :question/worked-solution "Let's sketch the nets of each solid.\n\n![](images/27/277d5aa8a8116d230bf000ef7d8e94a071acbf499a49b9d8b911a4e89cfaf18a.png)\n\n \n\nAs we can see, the correct answer is:\n\n$\\,$ *\"The net of II consists of triangles only\"*\n\nOther statements are false. \n\n- *\"The net of III consists of triangles only\"* is false since the net of III has one rectangle (the base of the solid).\n\n- *\"The net of I consists of $3$ triangles and $3$ rectangles\"* is not true because the net of I contains only $2$ triangles (the base and the top of the solid).\n\n- *\"The net of III consists of $3$ triangles and $1$ rectangle\"* is false since the net of III has $4$ triangles (the side faces).\n\n- *\"The net of II consists of $3$ triangles and $1$ rectangle\"* is not true because the net of II does not contain rectangles." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-86416a88-fdc4-572d-9486-d8ebc941a794"] :db/ensure [:question/validate]} {:db/id "answer-field-86416a88-fdc4-572d-9486-d8ebc941a794" :answer-field/id #uuid "86416a88-fdc4-572d-9486-d8ebc941a794" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8f54a780-f831-5e78-92bd-ab9e1d509ecc" :answer-field/choices ["answer-0846f24f-af1c-550d-846b-c843285d05d0" "answer-5b4cd130-6656-5a33-82ce-e42176017efc" "answer-8f54a780-f831-5e78-92bd-ab9e1d509ecc" "answer-0614df50-30ff-5203-8a01-abadfaa57f44" "answer-17a62515-2813-570a-b292-f8afb7187b49"] :db/ensure [:answer-field/validate]} {:db/id "answer-0846f24f-af1c-550d-846b-c843285d05d0" :answer/id #uuid "0846f24f-af1c-550d-846b-c843285d05d0" :answer/type :answer.type/text :answer/value "The net of I consists of $3$ triangles and $3$ rectangles" :db/ensure [:answer/validate]} {:db/id "answer-5b4cd130-6656-5a33-82ce-e42176017efc" :answer/id #uuid "5b4cd130-6656-5a33-82ce-e42176017efc" :answer/type :answer.type/text :answer/value "The net of II consists of $3$ triangles and $1$ rectangle" :db/ensure [:answer/validate]} {:db/id "answer-8f54a780-f831-5e78-92bd-ab9e1d509ecc" :answer/id #uuid "8f54a780-f831-5e78-92bd-ab9e1d509ecc" :answer/type :answer.type/text :answer/value "The net of II consists of triangles only" :db/ensure [:answer/validate]} {:db/id "answer-0614df50-30ff-5203-8a01-abadfaa57f44" :answer/id #uuid "0614df50-30ff-5203-8a01-abadfaa57f44" :answer/type :answer.type/text :answer/value "The net of III consists of $3$ triangles and $1$ rectangle" :db/ensure [:answer/validate]} {:db/id "answer-17a62515-2813-570a-b292-f8afb7187b49" :answer/id #uuid "17a62515-2813-570a-b292-f8afb7187b49" :answer/type :answer.type/text :answer/value "The net of III consists of triangles only" :db/ensure [:answer/validate]} {:db/id 17592186147668 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-09f63cf7-87d6-50ff-b17a-338839a04aa8" :activity/id #uuid "09f63cf7-87d6-50ff-b17a-338839a04aa8" :activity/title "The Multivariable Chain Rule" :activity/type :activity.type/review :activity/scope 17592186050031 :activity/course 17592186046668 :activity/steps ["step-f669bc29-28f8-5173-b17e-1d