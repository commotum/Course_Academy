te]} {:db/id "question-606d371f-fe47-59ac-b0e1-18679ee51770" :question/id #uuid "606d371f-fe47-59ac-b0e1-18679ee51770" :question/math-academy-id "q-164268" :question/problem "Given the elliptic paraboloid $z+8=\\frac{(x+2)^{2}}{2}+\\frac{(y+1)^{2}}{6}$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ into the equation of the paraboloid and solve for $y:$\n\n$$\n\\begin{aligned}0+8 & =\\frac{(0+2)^{2}}{2}+\\frac{(y+1)^{2}}{6} \\\\ 8 & =\\frac{4}{2}+\\frac{(y+1)^{2}}{6} \\\\ 8 & =2+\\frac{(y+1)^{2}}{6} \\\\ \\frac{(y+1)^{2}}{6} & =6 \\\\ (y+1)^{2} & =36 \\\\ y+1 & =\\pm 6\\end{aligned}\n$$\n\nThis gives the solutions $y=-7,5.$ \n\nTherefore, the intercepts with the $y$-axis are $(0,-7,0)$ and $(0,5,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-487ea996-8321-5872-9dc6-dad9047db3c9"] :db/ensure [:question/validate]} {:db/id "answer-field-487ea996-8321-5872-9dc6-dad9047db3c9" :answer-field/id #uuid "487ea996-8321-5872-9dc6-dad9047db3c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1c848420-124b-5ced-bc66-13ba49cde3e5" :answer-field/choices ["answer-a26c92a2-2d4c-557a-9662-9d75bd7b51b4" "answer-e7cfa56b-095c-5dc9-b696-49cd5f0aa634" "answer-1c848420-124b-5ced-bc66-13ba49cde3e5" "answer-db7eebcf-b898-5d82-a707-884c4a68bbb3" "answer-64261810-9bdf-58ff-a125-b6466762508a"] :db/ensure [:answer-field/validate]} {:db/id "answer-a26c92a2-2d4c-557a-9662-9d75bd7b51b4" :answer/id #uuid "a26c92a2-2d4c-557a-9662-9d75bd7b51b4" :answer/type :answer.type/text :answer/value "$(0,-1,0)$ only" :db/ensure [:answer/validate]} {:db/id "answer-e7cfa56b-095c-5dc9-b696-49cd5f0aa634" :answer/id #uuid "e7cfa56b-095c-5dc9-b696-49cd5f0aa634" :answer/type :answer.type/text :answer/value "$(0,-7,0)$ and $(0,-1,0)$" :db/ensure [:answer/validate]} {:db/id "answer-1c848420-124b-5ced-bc66-13ba49cde3e5" :answer/id #uuid "1c848420-124b-5ced-bc66-13ba49cde3e5" :answer/type :answer.type/text :answer/value "$(0,-7,0)$ and $(0,5,0)$" :db/ensure [:answer/validate]} {:db/id "answer-db7eebcf-b898-5d82-a707-884c4a68bbb3" :answer/id #uuid "db7eebcf-b898-5d82-a707-884c4a68bbb3" :answer/type :answer.type/text :answer/value "$(0,5,0)$ and $(0,6,0).$" :db/ensure [:answer/validate]} {:db/id "answer-64261810-9bdf-58ff-a125-b6466762508a" :answer/id #uuid "64261810-9bdf-58ff-a125-b6466762508a" :answer/type :answer.type/text :answer/value "$(0,6,0)$ only" :db/ensure [:answer/validate]} {:db/id 17592186124898 :question/problem "Given the hyperbolic paraboloid $(x-5)^{2}-8(y+2)^{2}=z+4$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ in the equation of the paraboloid:\n\n$$\n\\begin{aligned}(x-5)^{2}-8(0+2)^{2} & =0+4 \\\\ (x-5)^{2}-32 & =4 \\\\ (x-5)^{2} & =36 \\\\ x-5 & =\\pm 6 \\\\ x & =5\\pm 6\\end{aligned}\n$$\n\nThis gives the solutions $x=-1$ and $x=11.$\n\nTherefore, the intercepts with the $x$-axis are $(-1,0,0)$ and $(11,0,0).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186121988 :answer-field/correct "answer-21ac4178-0af0-52ae-b0ea-c5a2434eefcd" :answer-field/choices ["answer-cf27980c-2d2c-5e58-9b82-ec398191c5a3" "answer-21ac4178-0af0-52ae-b0ea-c5a2434eefcd" "answer-b5e0d084-0bb9-5301-abba-83230a8b2091" "answer-776101fa-7db9-56ce-93d8-656ddcfa5d26" "answer-137d4682-9507-54ad-8fc0-20d0123b99c3"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf27980c-2d2c-5e58-9b82-ec398191c5a3" :answer/id #uuid "cf27980c-2d2c-5e58-9b82-ec398191c5a3" :answer/type :answer.type/math :answer/value "(0,0,0)" :db/ensure [:answer/validate]} {:db/id "answer-21ac4178-0af0-52ae-b0ea-c5a2434eefcd" :answer/id #uuid "21ac4178-0af0-52ae-b0ea-c5a2434eefcd" :answer/type :answer.type/text :answer/value "$(-1,0,0)$ and $(11,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-b5e0d084-0bb9-5301-abba-83230a8b2091" :answer/id #uuid "b5e0d084-0bb9-5301-abba-83230a8b2091" :answer/type :answer.type/text :answer/value "$(-6,0,0)$ and $(6,0,0)$" :db/ensure [:answer/validate]} {:db/id "answer-776101fa-7db9-56ce-93d8-656ddcfa5d26" :answer/id #uuid "776101fa-7db9-56ce-93d8-656ddcfa5d26" :answer/type :answer.type/text :answer/value "$(-6,0,0)$ only" :db/ensure [:answer/validate]} {:db/id "answer-137d4682-9507-54ad-8fc0-20d0123b99c3" :answer/id #uuid "137d4682-9507-54ad-8fc0-20d0123b99c3" :answer/type :answer.type/text :answer/value "$(0,0,0)$ and $(4,0,0)$" :db/ensure [:answer/validate]} {:db/id "question-0fd51843-9d70-54e0-8843-df58c7a06dd7" :question/id #uuid "0fd51843-9d70-54e0-8843-df58c7a06dd7" :question/math-academy-id "q-35517" :question/problem "What is the trace in the $xz$-plane of the elliptic paraboloid $z=\\frac{{x}^{2}}{4}+\\frac{(y+1)^{2}}{8}?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z & =\\frac{{x}^{2}}{4}+\\frac{(0+1)^{2}}{8} \\\\ z & =\\frac{{x}^{2}}{4}+\\frac{1}{8} \\\\ z-\\frac{1}{8} & =\\frac{{x}^{2}}{4} \\\\ {x}^{2} & =4z-\\frac{1}{2}\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $xz$-plane." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-689f8fa2-4c6d-55d5-ace6-b3784c1ca904"] :db/ensure [:question/validate]} {:db/id "answer-field-689f8fa2-4c6d-55d5-ace6-b3784c1ca904" :answer-field/id #uuid "689f8fa2-4c6d-55d5-ace6-b3784c1ca904" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-16dc139f-742f-5b30-91b6-63baf7b89d5b" :answer-field/choices ["answer-367d26f1-d68f-5eb6-826f-ca31b2acbcbb" "answer-91b289bc-6b4e-5b13-a90e-bc6e215a8e0f" "answer-16dc139f-742f-5b30-91b6-63baf7b89d5b" "answer-7b7af4f2-2e27-5210-9728-60dc5fa5cf03" "answer-daa69a1f-29b1-5d6b-9804-315f66589560"] :db/ensure [:answer-field/validate]} {:db/id "answer-367d26f1-d68f-5eb6-826f-ca31b2acbcbb" :answer/id #uuid "367d26f1-d68f-5eb6-826f-ca31b2acbcbb" :answer/type :answer.type/text :answer/value "A hyperbola: $2{x}^{2}-4{y}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "answer-91b289bc-6b4e-5b13-a90e-bc6e215a8e0f" :answer/id #uuid "91b289bc-6b4e-5b13-a90e-bc6e215a8e0f" :answer/type :answer.type/text :answer/value "A parabola: ${x}^{2}=4z+\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-16dc139f-742f-5b30-91b6-63baf7b89d5b" :answer/id #uuid "16dc139f-742f-5b30-91b6-63baf7b89d5b" :answer/type :answer.type/text :answer/value "A parabola: ${x}^{2}=4z-\\frac{1}{2}$" :db/ensure [:answer/validate]} {:db/id "answer-7b7af4f2-2e27-5210-9728-60dc5fa5cf03" :answer/id #uuid "7b7af4f2-2e27-5210-9728-60dc5fa5cf03" :answer/type :answer.type/text :answer/value "Two intersecting lines: $y=\\pm 4(x-\\frac{1}{2})$" :db/ensure [:answer/validate]} {:db/id "answer-daa69a1f-29b1-5d6b-9804-315f66589560" :answer/id #uuid "daa69a1f-29b1-5d6b-9804-315f66589560" :answer/type :answer.type/text :answer/value "Two parallel lines: $x=4(y\\pm 5)$" :db/ensure [:answer/validate]}]
