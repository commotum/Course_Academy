-f76c-5c34-9764-841fff0c157d" :db/ensure [:activity/validate]} {:db/id "step-df22a5ba-f76c-5c34-9764-841fff0c157d" :step/id #uuid "df22a5ba-f76c-5c34-9764-841fff0c157d" :step/content "question-09a2f783-f81f-5ba2-8e8b-78ad6330c2dd" :step/next "step-c2970b7a-793f-5b1c-9e78-4dd00bd3e750" :db/ensure [:step/validate]} {:db/id "step-c2970b7a-793f-5b1c-9e78-4dd00bd3e750" :step/id #uuid "c2970b7a-793f-5b1c-9e78-4dd00bd3e750" :step/content "question-5c6f292d-8813-58fc-b4b8-7f51b18fc102" :step/next "step-5217ad06-79dc-5267-a1fc-7ac92196ff07" :db/ensure [:step/validate]} {:db/id "step-5217ad06-79dc-5267-a1fc-7ac92196ff07" :step/id #uuid "5217ad06-79dc-5267-a1fc-7ac92196ff07" :step/content "question-92938c74-0d42-5181-8d49-61141e646c18" :db/ensure [:step/validate]} {:db/id 17592186129302 :knowledge-point/questions ["question-29510dc5-be54-5010-a9b8-7e994b64e473"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186294028 :answer-field/correct "answer-2e4d705f-0096-5ad1-b3ec-5e6964725392" :answer-field/choices ["answer-2e4d705f-0096-5ad1-b3ec-5e6964725392"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e4d705f-0096-5ad1-b3ec-5e6964725392" :answer/id #uuid "2e4d705f-0096-5ad1-b3ec-5e6964725392" :answer/type :answer.type/math :answer/value "\\infty" :db/ensure [:answer/validate]} {:db/id "question-29510dc5-be54-5010-a9b8-7e994b64e473" :question/id #uuid "29510dc5-be54-5010-a9b8-7e994b64e473" :question/math-academy-id "q-40012" :question/problem "What is the domain of the function $f(x)=-\\frac{3}{4x-2}?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}4x-2 & =0 \\\\ 4x & =2 \\\\ x & =\\frac{2}{4} \\\\ x & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{1}{2})\\cup (\\frac{1}{2},\\infty ).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-e1cc2dc1-18fb-52fa-8e67-8e8e0b36e205"] :db/ensure [:question/validate]} {:db/id "answer-field-e1cc2dc1-18fb-52fa-8e67-8e8e0b36e205" :answer-field/id #uuid "e1cc2dc1-18fb-52fa-8e67-8e8e0b36e205" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1a94b6e6-c74e-520f-ae8d-73a46e554999" :answer-field/choices ["answer-98712a50-8a01-56bf-b370-98559bfe5794" "answer-b6071168-7def-5769-b7ee-41381140092c" "answer-509c8237-e2bb-5759-8728-da4096bca8f4" "answer-1a94b6e6-c74e-520f-ae8d-73a46e554999" "answer-0ccaddae-969a-5bb6-97a9-8d0e0b772e0b"] :db/ensure [:answer-field/validate]} {:db/id "answer-98712a50-8a01-56bf-b370-98559bfe5794" :answer/id #uuid "98712a50-8a01-56bf-b370-98559bfe5794" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-b6071168-7def-5769-b7ee-41381140092c" :answer/id #uuid "b6071168-7def-5769-b7ee-41381140092c" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,-\\frac{3}{2})\\cup (-\\frac{3}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-509c8237-e2bb-5759-8728-da4096bca8f4" :answer/id #uuid "509c8237-e2bb-5759-8728-da4096bca8f4" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,4)\\cup (4,\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-1a94b6e6-c74e-520f-ae8d-73a46e554999" :answer/id #uuid "1a94b6e6-c74e-520f-ae8d-73a46e554999" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\frac{1}{2})\\cup (\\frac{1}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-0ccaddae-969a-5bb6-97a9-8d0e0b772e0b" :answer/id #uuid "0ccaddae-969a-5bb6-97a9-8d0e0b772e0b" :answer/type :answer.type/math :answer/value "x\\in (-\\infty ,\\frac{3}{2})\\cup (\\frac{3}{2},\\infty )" :db/ensure [:answer/validate]} {:db/id 17592186293941 :answer-field/correct "answer-cf68a7eb-6b63-59c3-94da-038b463dfbf5" :answer-field/choices ["answer-cf68a7eb-6b63-59c3-94da-038b463dfbf5"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf68a7eb-6b63-59c3-94da-038b463dfbf5" :answer/id #uuid "cf68a7eb-6b63-59c3-94da-038b463dfbf5" :answer/type :answer.type/math :answer/value "-\\infty" :db/ensure [:answer/validate]} {:db/id 17592186129394 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186175936 :knowledge-point/questions ["question-64eb2650-1408-5539-acdf-62ad07765696"] :db/ensure [:knowledge-point/validate]} {:db/id "question-64eb2650-1408-5539-acdf-62ad07765696" :question/id #uuid "64eb2650-1408-5539-acdf-62ad07765696" :question/math-academy-id "q-134161" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx=\\{4,\\,4,\\,-4,\\,4\\},\\,y=\\{-1,\\,-2,\\,7,\\,4\\}\n$$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+4+(-4)+4) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-1)+(-2)+7+4) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-1-2)+(4-2)(-2-2)+(-4-2)(7-2)+(4-2)(4-2)] \\\\  & =\\frac{1}{4}[(2)(-3)+(2)(-4)+(-6)(5)+(2)(2)] \\\\  & =\\frac{1}{4}[-6-8-30+4] \\\\  & =\\frac{1}{4}\\cdot (-40) \\\\  & =-10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b3bb762e-f253-556e-b239-591405629ea7"] :db/ensure [:question/validate]} {:db/id "answer-field-b3bb762e-f253-556e-b239-591405629ea7" :answer-field/id #uuid "b3bb762e-f253-556e-b239-591405629ea7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dc079189-f549-5385-8ccd-d06d3585f132" :answer-field/choices ["answer-7d8c39eb-cc31-5a79-a9bd-500afe12c950" "answer-dc079189-f549-5385-8ccd-d06d3585f132" "answer-f0431254-6c69-543d-b05b-52b952950087" "answer-7c9e72d7-60a7-512f-af6c-41536483d13a" "answer-fe2cb0ca-1fb3-54af-9579-b241fc473f92"] :db/ensure [:answer-field/validate]} {:db/id "answer-7d8c39eb-cc31-5a79-a9bd-500afe12c950" :answer/id #uuid "7d8c39eb-cc31-5a79-a9bd-500afe12c950" :answer/type :answer.type/math :answer/value "-0.5" :db/ensure [:answer/validate]} {:db/id "answer-dc079189-f549-5385-8ccd-d06d3585f132" :answer/id #uuid "dc079189-f549-5385-8ccd-d06d3585f132" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "answer-f0431254-6c69-543d-b05b-52b952950087" :answer/id #uuid "f0431254-6c69-543d-b05b-52b952950087" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "answer-7c9e72d7-60a7-512f-af6c-41536483d13a" :answer/id #uuid "7c9e72d7-60a7-512f-af6c-41536483d13a" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-fe2cb0ca-1fb3-54af-9579-b241fc473f92" :answer/id #uuid "fe2cb0ca-1fb3-54af-9579-b241fc473f92" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id 17592186268978 :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx=\\{-4,\\,2,\\,6,\\,8\\},\\,y=\\{2,\\,-9,\\,3,\\,12\\}\n$$" :question/worked-solution "The (population) covariance of the data sets $x=\\{{x}_{1},{x}_{2},…,{x}_{n}\\}$ and $y=\\{{y}_{1},{y}_{2},…,{y}_{n}\\}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-4)+2+6+8) \\\\  & =\\frac{1}{4}\\cdot 12 \\\\  & =3 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (2+(-9)+3+12) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-4-3)(2-2)+(2-3)(-9-2)+(6-3)(3-2)+(8-3)(12-2)] \\\\  & =\\frac{1}{4}[(-7)(0)+(-1)(-11)+(3)(1)+(5)(10)] \\\\  & =\\frac{1}{4}[0+11+3+50] \\\\  & =\\frac{1}{4}\\cdot 64 \\\\  & =16.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-b71da19e-d859-5f56-b0d6-c095ea38a156" :activity/id #uuid "b71da19e-d859-5f56-b0d6-c095ea38a156" :activity/title "Covariance" :activity/type :activity.type/review :activity/scope 17592186049126 :activity/course 17592186046647 :activity/steps ["step-96cf8720-bbba-5c5c-9ffc-98b6e94d3c0b" "step-9360c9ad-0d01-58c3-bea9-ccb29100787e" "step-6dca6571-a5ec-5352-8411-48e22666e7db"] :activity/first-step "step-96cf8720-bbba-5c5c-9ffc-98b6e94d3c0b" :db/ensure [:activity/validate]} {:db/id "step-96cf8720-bbba-5c5c-9ffc-98b6e94d3c0b" :step/id #uuid "96cf8720-bbba-5c5c-9ffc-98b6e94d3c0b" :step/content "question-64eb2650-1408-5539-acdf-62ad07765696" :step/next "step-9360c9ad-0d01-58c3-bea9-ccb29100787e" :db/ensure [:step/validate]} {:db/id "step-9360c9ad-0d01-58c3-bea9-ccb29100787e" :step/id #uuid "9360c9ad-0d01-58c3-bea9-ccb29100787e" :step/content 17592186268978 :step/next "step-6dca6571-a5ec-5352-8411-48e22666e7db" :db/ensure [:step/validate]} {:db/id "step-6dca6571-a5ec-5352-8411-48e22666e7db" :step/id #uuid "6dca6571-a5ec-5352-8411-48e22666e7db" :step/content 17592186268981 :db/ensure [:step/validate]} {:db/id 17592186068764 :knowledge-point/questions ["question-7688caa9-079d-576d-afcf-e01cab97b9fe"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7688caa9-079d-576d-afcf-e01cab97b9fe" :question/id #uuid "7688caa9-079d-576d-afcf-e01cab97b9fe" :question/math-academy-id "q-14467" :question/problem "$\\frac{9{v}^{2}+3v}{v+9}÷(3v+1)=$" :question/worked-solution "To compute\n\n$$\n\\frac{9{v}^{2}+3v}{v+9}÷(3v+1),\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{9{v}^{2}+3v}{v+9}÷(3v+1) & = \\\\ \\frac{9{v}^{2}+3v}{v+9}\\cdot \\frac{1}{(3v+1)} & = \\\\ \\frac{3v(3v+1)}{v+9}\\cdot \\frac{1}{(3v+1)} & = \\\\ \\frac{3v\\cancel{(3v+1)}}{(v+9)}\\cdot \\frac{1}{\\cancel{(3v+1)}} & = \\\\ \\frac{3v}{v+9}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-88dbefa0-da08-5591-8494-05b870a9513b"] :db/ensure [:question/validate]} {:db/id "answer-field-88dbefa0-da08-5591-8494-05b870a9513b" :answer-field/id #uuid "88dbefa0-da08-5591-8494-05b870a9513b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8c019a7-2cb9-5d61-898a-4e58c10a6b87" :answer-field/choices ["answer-8b898f83-508a-5c71-a91c-9734fa02e059" "answer-895d9ffc-006a-5e14-8d3d-a031c859cb98" "answer-f8c019a7-2cb9-5d61-898a-4e58c10a6b87" "answer-c7b0a4d1-23a0-5efc-ad6b-fdcb29f179bf" "answer-f0190a87-fbf5-57b6-9650-b6eac82f4005"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b898f83-508a-5c71-a91c-9734fa02e059" :answer/id #uuid "8b898f83-508a-5c71-a91c-9734fa02e059" :answer/type :answer.type/math :answer/value "\\frac{3v+1}{3v}" :db/ensure [:answer/validate]} {:db/id "answer-895d9ffc-006a-5e14-8d3d-a031c859cb98" :answer/id #uuid