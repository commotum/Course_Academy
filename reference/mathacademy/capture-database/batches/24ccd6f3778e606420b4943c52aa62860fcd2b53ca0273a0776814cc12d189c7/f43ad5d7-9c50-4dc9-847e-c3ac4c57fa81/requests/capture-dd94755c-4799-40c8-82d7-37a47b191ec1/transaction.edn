8-debeb68ff5b2" "answer-b15b01c1-60d3-5417-887c-9a621f4562d7" "answer-e1bb84ea-40f8-5e22-bcd6-49f3c09b85e6" "answer-a9143ba9-c209-51a8-a25f-6540f99e1eba"] :db/ensure [:answer-field/validate]} {:db/id "answer-471f28dc-0f25-5e27-bb55-f4f252a3ded6" :answer/id #uuid "471f28dc-0f25-5e27-bb55-f4f252a3ded6" :answer/type :answer.type/text :answer/value "$1$st, $2$nd, $3$rd and $5$th only" :db/ensure [:answer/validate]} {:db/id "answer-daa29215-92c3-5dd2-8358-debeb68ff5b2" :answer/id #uuid "daa29215-92c3-5dd2-8358-debeb68ff5b2" :answer/type :answer.type/text :answer/value "$1$st, $2$nd, and $3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-b15b01c1-60d3-5417-887c-9a621f4562d7" :answer/id #uuid "b15b01c1-60d3-5417-887c-9a621f4562d7" :answer/type :answer.type/text :answer/value "$1$st, $3$rd, and $5$th only" :db/ensure [:answer/validate]} {:db/id "answer-e1bb84ea-40f8-5e22-bcd6-49f3c09b85e6" :answer/id #uuid "e1bb84ea-40f8-5e22-bcd6-49f3c09b85e6" :answer/type :answer.type/text :answer/value "$3$rd and $5$th only" :db/ensure [:answer/validate]} {:db/id "answer-a9143ba9-c209-51a8-a25f-6540f99e1eba" :answer/id #uuid "a9143ba9-c209-51a8-a25f-6540f99e1eba" :answer/type :answer.type/text :answer/value "All the columns are pivot" :db/ensure [:answer/validate]} {:db/id "question-75f69126-c110-5545-9efd-4ceeba235a0c" :question/id #uuid "75f69126-c110-5545-9efd-4ceeba235a0c" :question/math-academy-id "q-73615" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9e5f4d81-f91b-55ef-9252-1ab82323e853"] :db/ensure [:question/validate]} {:db/id "answer-field-9e5f4d81-f91b-55ef-9252-1ab82323e853" :answer-field/id #uuid "9e5f4d81-f91b-55ef-9252-1ab82323e853" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer-field/choices ["answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" "answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" "answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" "answer-384525a8-6bc7-511c-89ba-ed88a8ddda66" "answer-0b45315b-a5c2-53a7-b6d0-069454aca98b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/id #uuid "e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/type :answer.type/text :answer/value "$2$nd and $3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/id #uuid "68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/type :answer.type/text :answer/value "$2$nd only" :db/ensure [:answer/validate]} {:db/id "answer-4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/id #uuid "4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/type :answer.type/text :answer/value "$3$rd and $4$th only" :db/ensure [:answer/validate]} {:db/id "answer-384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer/id #uuid "384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer/type :answer.type/text :answer/value "$3$rd only" :db/ensure [:answer/validate]} {:db/id "answer-0b45315b-a5c2-53a7-b6d0-069454aca98b" :answer/id #uuid "0b45315b-a5c2-53a7-b6d0-069454aca98b" :answer/type :answer.type/text :answer/value "$4$th only" :db/ensure [:answer/validate]} {:db/id 17592186124885 :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+(\\frac{1}{2}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{aligned}] & {R}_{4} & :={R}_{4}+(\\frac{2}{7}){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $5$ pivots, and therefore the number of pivot columns is $5.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186121910 :answer-field/correct 17592186121911 :db/ensure [:answer-field/validate]} {:db/id 17592186192790 :knowledge-point/questions ["question-4d7ebf34-a035-5c2e-ad76-841acaa3c221"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4d7ebf34-a035-5c2e-ad76-841acaa3c221" :question/id #uuid "4d7ebf34-a035-5c2e-ad76-841acaa3c221" :question/math-academy-id "q-168886" :question/problem "$\\frac{∂f}{∂x}\\,=${{field-1}}" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants. \n\nFirst, we use the sum rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(2{x}^{4}+8{x}^{2}{y}^{2}-8{x}^{2}+6{y}^{2}-1) \\\\  & =\\frac{∂}{∂x}(2{x}^{4})+\\frac{∂}{∂x}(8{x}^{2}{y}^{2})-\\frac{∂}{∂x}(8{x}^{2})+\\frac{∂}{∂x}(6{y}^{2})-\\frac{∂}{∂x}(1) \\\\  & =\\frac{∂}{∂x}(2{x}^{4})+\\frac{∂}{∂x}(8{x}^{2}{y}^{2})-\\frac{∂}{∂x}(8{x}^{2})\\end{aligned}\n$$\n\nNow, we use the constant multiple rule for differentiation:\n\n$$\n\\begin{aligned}\\frac{∂}{∂x}(2{x}^{4})+\\frac{∂}{∂x}(8{x}^{2}{y}^{2})-\\frac{∂}{∂x}(8{x}^{2}) & =2\\cdot \\frac{∂}{∂x}({x}^{4})+8{y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2})-8\\cdot \\frac{∂}{∂x}({x}^{2}) \\\\  & =2\\cdot 4{x}^{3}+8{y}^{2}\\cdot 2x-8\\cdot 2x \\\\  & =8{x}^{3}+16x{y}^{2}-16x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5406b9c4-8f08-5b5f-8ea0-96705a9a7215"] :db/ensure [:question/validate]} {:db/id "answer-field-5406b9c4-8f08-5b5f-8ea0-96705a9a7215" :answer-field/id #uuid "5406b9c4-8f08-5b5f-8ea0-96705a9a7215" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9a507ce6-22ce-56f0-ba53-527362e98081" :answer-field/choices ["answer-9a507ce6-22ce-56f0-ba53-527362e98081"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a507ce6-22ce-56f0-ba53-527362e98081" :answer/id #uuid "9a507ce6-22ce-56f0-ba53-527362e98081" :answer/type :answer.type/math :answer/value "8x^{3}+16xy^{2}-16x" :db/ensure [:answer/validate]} {:db/id 17592186198411 :knowledge-point/questions ["question-c7c3402d-fbe9-5875-8d06-b63e54fe220e"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c7c3402d-fbe9-5875-8d06-b63e54fe220e" :question/id #uuid "c7c3402d-fbe9-5875-8d06-b63e54fe220e" :question/math-academy-id "q-168887" :question/problem "${f}^{′}(x)=$$[\\,8{x}^{3}+16x{y}^{2}-16x$ \n{{field-1}}\n$]$" :question/worked-solution "For our scalar function, we have that\n\n$$\n{f}^{′}(x)={(∇f)}^{T}=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}].\n$$\n\nEarlier, we found that \n\n$$\n\\frac{∂f}{∂x}=8{x}^{3}+16x{y}^{2}-16x.\n$$\n\nThe partial derivative of $f$ with respect to $y$ is\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(2{x}^{4}+8{x}^{2}{y}^{2}-8{x}^{2}+6{y}^{2}-1)=16{x}^{2}y+12y.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\,8{x}^{3}+16x{y}^{2}-16x\\, & \\,16{x}^{2}y+12y\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-01c5dfcb-2472-5349-af19-428547c6b2a5"] :db/ensure [:question/validate]} {:db/id "answer-field-01c5dfcb-2472-5349-af19-428547c6b2a5" :answer-field/id #uuid "01c5dfcb-2472-5349-af19-428547c6b2a5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c6c2d85b-0791-5631-9a96-b310c9e733e5" :answer-field/choices ["answer-c6c2d85b-0791-5631-9a96-b310c9e733e5"] :db/ensure [:answer-field/validate]} {:db/id "answer-c6c2d85b-0791-5631-9a96-b310c9e733e5" :answer/id #uuid "c6c2d85b-0791-5631-9a96-b310c9e733e5" :answer/type :answer.type/math :answer/value "16x^{2}y+12y" :db/ensure [:answer/validate]} {:db/id 17592186124647 :knowledge-point/questions ["question-187224fe-1282-5974-b5d9-f692bdbb4202"] :db/ensure [:knowledge-point/validate]} {:db/id "question-187224fe-1282-5974-b5d9-f692bdbb4202" :question/id #uuid "187224fe-1282-5974-b5d9-f692bdbb4202" :question/math-academy-id "q-168888" :question/problem "![](images/1d/1d2132be4de3f505e5052ae3083b75ac8aceceed9f64bf62d128746a37a59a23.png)\n\nGiven a sketch of the graph of $z=f(x)$ above, which of the points ($A,$ $B,$ or $C$) is a local minimum of the function?\n\nA local minimum is the point \n{{field-1}}." :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nAmong the given options, such neighborhoods exist for the point $C.$ Hence, $C$ is a local minimum.\n\n![](images/a3/a389560d6217e86b82384443c5730168483a75a1759788ddde31ef64ad368adc.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3d9a9cef-2038-557f-85dd-5cc5297a49b6"] :db/ensure [:question/validate]} {:db/id "answer-field-3d9a9cef-2038-557f-85dd-5cc5297a49b6" :answer-field/id #uuid "3d9a9cef-2038-557f-85dd-5cc5297a49b6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-da8d5be4-4fd2-5cf8-ba70-65f748d32b36" :answer-field/choices ["answer-da8d5be4-4fd2-5cf8-ba70-65f748d32b36"] :db/ensure [:answer-field/validate]} {:db/id "answer-da8d5be4-4fd2-5cf8-ba70-65f748d32b36" :answer/id #uuid "da8d5be4-4fd2-5cf8-ba70-65f748d32b36" :answer/type :answer.type/text :answer/value "C" :db/ensure [:answer/validate]} {:db/id 17592186124653 :knowledge-point/questions ["question-2ed0a30c-70d1-57fa-8ba9-ce180a14b5a1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2ed0a30c-70d1-57fa-8ba9-ce180a14b5a1" :question/id #uuid "2ed0a30c-70d1-57fa-8ba9-ce180a14b5a1" :question/math-academy-id "q-168889" :question/problem "The critical points of $f$ are$\\,$$(\\pm $ \n{{field-1}}\n$,$ \n{{field-2}}\n$)$ and $(0,$ \n{{field-3}}\n$).$" :question/worked-solution "The critical points of a multivariable function $f$ are the points $a$ in the domain of $f$ such that ${f}^{′}(a)={0}^{T}$ or ${f}^{′}(a)$ does not exist, where\n\n$$\n{f}^{′}(a)={[\\begin{aligned}\\frac{∂f}{∂{x}_{1}} & \\frac{∂f}{∂{x}_{2}} & ⋯ & \\frac{∂f}{∂{x}_{n}}\\end{aligned}]|}_{x=a}.\n$$\n\nIn this case, the domain of $f$ is ${R}^{2},$ and the first derivative of $f$ is\n\n$$\n{f}^{′}(x)=[\\begin{aligned}8{x}^{3}+16x{y}^{2}-16x & \\,16{x}^{2}y+12y\\end{aligned}].\n$$\n\nTo find the critical points, we need to find the points $(x,y)\\in {R}^{2}$ such that ${f}^{′}(x,y)={0}^{T}$ or ${f}^{′}(x,y)$ does not exist. Note that, in our case, ${f}^{′}(x,y)$ exists everywhere, so we just need to find the points where ${f}^{′}(x,y)={0}^{T}.$\n\nSetting ${f}^{′}(x,y)={0}^{T},$ we have the following system:\n\n$$\n\\{\\begin{aligned}\\frac{∂f}{∂x}=0 \\\\ \\frac{∂f}{∂y}=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}8{x}^{3}+16x{y}^{2}-16x=0 \\\\ 16{x}^{2}y+12y=0\\end{aligned}\\,⟹\\,\\{\\begin{aligned}8x({x}^{2}+2{y}^{2}-2)=0 \\\\ 4y(4{x}^{2}+3)=0\\end{aligned}\n$$\n\nSince $4{x}^{2}+3\\ne 0,$ from the second equation of the system, we obtain that\n\n$$\ny=0.\n$$\n\nSubstituting this into the first equation, we have\n\n$$\n\\begin{aligned}8x({x}^{2}+2{y}^{2}-2) & =0 \\\\ 8x({x}^{2}+{0}^{2}-2) & =0 \\\\ 8x({x}^{2}-2) & =0 \\\\ x & =0,\\pm \\sqrt{2}\\end{aligned}\n$$\n\nThis gives the critical points $(\\pm \\sqrt{2},0)$ and $(0,0).$\n\nNote that since ${f}^{′}(x)={0}^{T}$ at these points, they are also stationary points." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-759d25c6-2087-5621-820c-1d640ea38f01" "answer-field-7f97737c-ae6c-590f-a770-d33c927a54f7" "answer-field-aa6b1fc8-4a0e-5fee-a4ba-3951cd3851a0"] :db/ensure [:question/validate]} {:db/id "answer-field-759d25c6-2087-5621-820c-1d640ea38f01" :answer-field/id #uuid "759d25c6-2087-5621-820c-1d640ea38f01" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7500e34d-8118-54e7-bd9f-4a712248dfb5" :answer-field/choices ["answer-7500e34d-8118-54e7-bd9f-4a712248dfb5"] :db/ensure [:answer-field/validate]} {:db/id "answer-7500e34d-8118-54e7-bd9f-4a712248dfb5" :answer/id #uuid "7500e34d-8118-54e7-bd9f-4a712248dfb5" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-field-7f97737c-ae6c-590f-a770-d33c927a54f7" :answer-field/id #uuid "7f97737c-ae6c-590f-a770-d33c927a54f7" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0a435757-c811-58a0-a8a9-6e8c5f74e36c" :answer-field/choices ["answer-0a435757-c811-58a0-a8a9-6e8c5f74e36c"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a435757-c811-58a0-a8a9-6e8c5f74e36c" :answer/id #uuid "0a435757-c811-58a0-a8a9-6e8c5f74e36c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-aa6b1fc8-4a0e-5fee-a4ba-3951cd3851a0" :answer-field/id #uuid "aa6b1fc8-4a0e-5fee-a4ba-3951cd3851a0" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-55f70a89-bcfe-5aed-b870-1901d78733aa" :answer-field/choices ["answer-55f70a89-bcfe-5aed-b870-1901d78733aa"] :db/ensure [:answer-field/validate]} {:db/id "answer-55f70a89-bcfe-5aed-b870-1901d78733aa" :answer/id #uuid "55f70a89-bcfe-5aed-b870-1901d78733aa" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id 17592186124440 :knowledge-point/questions ["question-ed3eb4a9-71c7-55f2-a5c3-dcaf4e7245dc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ed3eb4a9-71c7-55f2-a5c3-dcaf4e7245dc" :question/id #uuid "ed3eb4a9-71c7-55f2-a5c3-dcaf4e7245dc" :question/math-academy-id "q-168890" :question/problem "Find the second partial derivatives of $f.$\n\n$\\frac{{∂}^{2}f}{∂{x}^{2}}\\,=$\n{{field-1}}\n\n$\\frac{{∂}^{2}f}{∂{y}^{2}}\\,=$\n{{field-2}}\n\n$\\frac{{∂}^{2}f}{∂x∂y}=\\frac{{∂}^{2}f}{∂y∂x}\\,=$\n{{field-3}}" :question/worked-solution "Previously, we found that\n\n$$\n\\frac{∂f}{∂x}=8{x}^{3}+16x{y}^{2}-16x,\\,\\frac{∂f}{∂y}=16{x}^{2}y+12y.\n$$\n\nComputing the second partial derivatives, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(8{x}^{3}+16x{y}^{2}-16x)=24{x}^{2}+16{y}^{2}-16 \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(16{x}^{2}y+12y)=32xy \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(16{x}^{2}y+12y)=16{x}^{2}+12\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b213367d-7142-5c18-b5f3-48ff7c0e4e22" "answer-field-a16bd320-c248-529b-b304-32eb2f00d3aa" "answer-field-ac878e84-17ed-5ef9-87fa-14cf1f5f5446"] :db/ensure [:question/validate]} {:db/id "answer-field-b213367d-7142-5c18-b5f3-48ff7c0e4e22" :answer-field/id #uuid "b213367d-7142-5c18-b5f3-48ff7c0e4e22" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4e172652-5fd0-5837-bbec-c3a968179703" :answer-field/choices ["answer-4e172652-5fd0-5837-bbec-c3a968179703"] :db/ensure [:answer-field/validate]} {:db/id "answer-4e172652-5fd0-5837-bbec-c3a968179703" :answer/id #uuid "4e172652-5fd0-5837-bbec-c3a968179703" :answer/type :answer.type/math :answer/value "24x^{2}+16y^{2}-16" :db/ensure [:answer/validate]} {:db/id "answer-field-a16bd320-c248-529b-b304-32eb2f00d3aa" :answer-field/id #uuid "a16bd320-c248-529b-b304-32eb2f00d3aa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0f25c240-f37d-534e-b187-1a4f8baf5379" :answer-field/choices ["answer-0f25c240-f37d-534e-b187-1a4f8baf5379"] :db/ensure [:answer-field/validate]} {:db/id "answer-0f25c240-f37d-534e-b187-1a4f8baf5379" :answer/id #uuid "0f25c240-f37d-534e-b187-1a4f8baf5379" :answer/type :answer.type/math :answer/value "16x^{2}+12" :db/ensure [:answer/validate]} {:db/id "answer-field-ac878e84-17ed-5ef9-87fa-14cf1f5f5446" :answer-field/id #uuid "ac878e84-17ed-5ef9-87fa-14cf1f5f5446" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5410d817-daa4-5eb6-be7e-73949185627c" :answer-field/choices ["answer-5410d817-daa4-5eb6-be7e-73949185627c"] :db/ensure [:answer-field/validate]} {:db/id "answer-5410d817-daa4-5eb6-be7e-73949185627c" :answer/id #uuid "5410d817-daa4-5eb6-be7e-73949185627c" :answer/type :answer.type/math :answer/value "32xy" :db/ensure [:answer/validate]} {:db/id 17592186157424 :knowledge-point/questions ["question-12e17457-b92e-5bbd-b375-4d92edbd2785"] :db/ensure [:knowledge-point/validate]} {:db/id "question-12e17457-b92e-5bbd-b375-4d92edbd2785" :question/id #uuid "12e17457-b92e-5bbd-b375-4d92edbd2785" :question/math-academy-id "q-168891" :question/problem "Evaluate the Hessian determinant of $f$ at $(\\pm \\sqrt{2},0)$ and $(0,0).$\n\n$H(\\pm \\sqrt{2},0)\\,=$ \n{{field-1}}\n\n$\\,H(0,0)\\,=$ \n{{field-2}}" :question/worked-solution "We computed the second partial derivatives in part 5. So, the second derivative of $f$ is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}24{x}^{2}+16{y}^{2}-16 & 32xy \\\\ 32xy & 16{x}^{2}+12\\end{aligned}].\\end{aligned}\n$$\n\n \n\n* Evaluating the second derivative at $(\\pm \\sqrt{2},0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(\\pm \\sqrt{2},0)=[\\begin{aligned}32 & 0 \\\\ 0 & 44\\end{aligned}].\\end{aligned}\n$$\n\nAs a result, we have\n\n$$\nH(\\pm \\sqrt{2},0)=32\\cdot 44-0\\cdot 0=1\\,408.\n$$\n\n* Evaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=[\\begin{aligned}-16 & 0 \\\\ 0 & 12\\end{aligned}].\\end{aligned}\n$$\n\nAs a result, we have\n\n$$\nH(0,0)=-16\\cdot 12-0\\cdot 0=-192.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-02a238bb-fadd-5461-8325-d873d6a724ae" "answer-field-0189ae91-6ed6-5d12-a32f-c03fa82da30e"] :db/ensure [:question/validate]} {:db/id "answer-field-02a238bb-fadd-5461-8325-d873d6a724ae" :answer-field/id #uuid "02a238bb-fadd-5461-8325-d873d6a724ae" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b7d19913-62b2-5223-b8ec-7ca4b1fb9c97" :answer-field/choices ["answer-b7d19913-62b2-5223-b8ec-7ca4b1fb9c97"] :db/ensure [:answer-field/validate]} {:db/id "answer-b7d19913-62b2-5223-b8ec-7ca4b1fb9c97" :answer/id #uuid "b7d19913-62b2-5223-b8ec-7ca4b1fb9c97" :answer/type :answer.type/math :answer/value "1408" :db/ensure [:answer/validate]} {:db/id "answer-field-0189ae91-6ed6-5d12-a32f-c03fa82da30e" :answer-field/id #uuid "0189ae91-6ed6-5d12-a32f-c03fa82da30e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2d6a5a41-e723-5f75-9166-621c4c0b5fea" :answer-field/choices ["answer-2d6a5a41-e723-5f75-9166-621c4c0b5fea"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d6a5a41-e723-5f75-9166-621c4c0b5fea" :answer/id #uuid "2d6a5a41-e723-5f75-9166-621c4c0b5fea" :answer/type :answer.type/math :answer/value "-192" :db/ensure [:answer/validate]} {:db/id 17592186124654 :knowledge-point/questions ["question-75a986c0-75fe-5567-a170-fed953f3d35d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-75a986c0-75fe-5567-a170-fed953f3d35d" :question/id #uuid "75a986c0-75fe-5567-a170-fed953f3d35d" :question/math-academy-id "q-168892" :question/problem "Classify the critical points using the second partial derivatives test.\n\n$(\\pm \\sqrt{2},0)$ are local minima since $\\,H(\\pm \\sqrt{2},0)$\n{{field-1}}\n$0\\,\\,$ and $\\,\\,\\frac{{∂}^{2}f}{∂{x}^{2}}(\\pm \\sqrt{2},0)$\n{{field-2}}\n$0$\n\n$(0,0)$ is a saddle point since $\\,\\,H(0,0)$\n{{field-3}}\n$0$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n* If $H(a)>0,$ then:\n\n  * if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$ \n\n  * if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n* If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n* If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nIn part 4, we found the critical points $(\\pm \\sqrt{2},0)$ and $(0,0).$ Their corresponding Hessian determinants and the second partial derivatives at these points were computed in part 6.\n\nWith that in mind, let's classify our critical points:\n\n* $(\\pm \\sqrt{2},0)$ are local minima of $f$ since $H(\\pm \\sqrt{2},0)=1\\,408>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(\\pm \\sqrt{3},0)=32>0.$\n\n* $(0,0)$ is a saddle point since $H(0,0)=-192<0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c6453212-afd5-5de3-8be7-5d403d904e1f" "answer-field-20dd0839-d52e-5270-a193-0c36a7580e1d" "answer-field-ee637896-1be0-5705-861b-4b0376c0f76f"] :db/ensure [:question/validate]} {:db/id "answer-field-c6453212-afd5-5de3-8be7-5d403d904e1f" :answer-field/id #uuid "c6453212-afd5-5de3-8be7-5d403d904e1f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7621c0a7-630f-5c98-b4b9-5bd1e81050ad" :answer-field/choices ["answer-7621c0a7-630f-5c98-b4b9-5bd1e81050ad"] :db/ensure [:answer-field/validate]} {:db/id "answer-7621c0a7-630f-5c98-b4b9-5bd1e81050ad" :answer/id #uuid "7621c0a7-630f-5c98-b4b9-5bd1e81050ad" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "answer-field-20dd0839-d52e-5270-a193-0c36a7580e1d" :answer-field/id #uuid "20dd0839-d52e-5270-a193-0c36a7580e1d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a990f136-6c72-5666-8278-bf851d95e098" :answer-field/choices ["answer-a990f136-6c72-5666-8278-bf851d95e098"] :db/ensure [:answer-field/validate]} {:db/id "answer-a990f136-6c72-5666-8278-bf851d95e098" :answer/id #uuid "a990f136-6c72-5666-8278-bf851d95e098" :answer/type :answer.type/math :answer/value ">" :db/ensure [:answer/validate]} {:db/id "answer-field-ee637896-1be0-5705-861b-4b0376c0f76f" :answer-field/id #uuid "ee637896-1be0-5705-861b-4b0376c0f76f" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a467ab84-a2e1-51f1-bdc6-7daaba2f65af" :answer-field/choices ["answer-a467ab84-a2e1-51f1-bdc6-7daaba2f65af"] :db/ensure [:answer-field/validate]} {:db/id "answer-a467ab84-a2e1-51f1-bdc6-7daaba2f65af" :answer/id #uuid "a467ab84-a2e1-51f1-bdc6-7daaba2f65af" :answer/type :answer.type/math :answer/value "<" :db/ensure [:answer/validate]} {:db/id "multistep-d9a60175-ea7e-5ff5-a696-1e759f0e8e78" :multistep/id #uuid "d9a60175-ea7e-5ff5-a696-1e759f0e8e78" :multistep/context "A company produces two types of products, type A and type B. The revenue function of the company, in thousands of dollars, is given by $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=2{x}^{4}+8{x}^{2}{y}^{2}-8{x}^{2}+6{y}^{2}-1,\n$$\n\nwhere $x={[\\begin{aligned}\\,x & y\\,\\end{aligned}]}^{T},$ $x$ is the price (in thousands of dollars) per unit of product A, and $y$ is the price (in thousands of dollars) per unit of product B. The company can adjust the prices per unit for both types of products by adding or removing certain features." :multistep/steps ["step-0f155874-d644-5c6d-a1bc-950a7f264867" "step-4f476aaa-d1ae-51b7-98e7-b3b01846bd0c" "step-58d0d71f-5f0f-5b59-82c6-8d354187fa5e" "step-cf2d38a4-9d2e-5fec-bb09-7a2b9a06d2f1" "step-11cf8195-97e7-51c0-b62c-f526c31dc712" "step-90fd6369-1814-5dfa-84f9-2c77827013fe" "step-9d2d618e-ac00-5aeb-ab8a-e66a6a636fdc"] :multistep/first-step "step-0f155874-d644-5c6d-a1bc-950a7f264867" :db/ensure [:multistep/validate]} {:db/id "step-0f155874-d644-5c6d-a1bc-950a7f264867" :step/id #uuid "0f155874-d644-5c6d-a1bc-950a7f264867" :step/content "question-4d7ebf34-a035-5c2e-ad76-841acaa3c221" :step/next "step-4f476aaa-d1ae-51b7-98e7-b3b01846bd0c" :db/ensure [:step/validate]} {:db/id "step-4f476aaa-d1ae-51b7-98e7-b3b01846bd0c" :step/id #uuid "4f476aaa-d1ae-51b7-98e7-b3b01846bd0c" :step/content "question-c7c3402d-fbe9-5875-8d06-b63e54fe220e" :step/next "step-58d0d71f-5f0f-5b59-82c6-8d354187fa5e" :db/ensure [:step/validate]} {:db/id "step-58d0d71f-5f0f-5b59-82c6-8d354187fa5e" :step/id #uuid "58d0d71f-5f0f-5b59-82c6-8d354187fa5e" :step/content "question-187224fe-1282-5974-b5d9-f692bdbb4202" :step/next "step-cf2d38a4-9d2e-5fec-bb09-7a2b9a06d2f1" :db/ensure [:step/validate]} {:db/id "step-cf2d38a4-9d2e-5fec-bb09-7a2b9a06d2f1" :step/id #uuid "cf2d38a4-9d2e-5fec-bb09-7a2b9a06d2f1" :step/content "question-2ed0a30c-70d1-57fa-8ba9-ce180a14b5a1" :step/next "step-11cf8195-97e7-51c0-b62c-f526c31dc712" :db/ensure [:step/validate]} {:db/id "step-11cf8195-97e7-51c0-b62c-f526c31dc712" :step/id #uuid "11cf8195-97e7-51c0-b62c-f526c31dc712" :step/content "question-ed3eb4a9-71c7-55f2-a5c3-dcaf4e7245dc" :step/next "step-90fd6369-1814-5dfa-84f9-2c77827013fe" :db/ensure [:step/validate]} {:db/id "step-90fd6369-1814-5dfa-84f9-2c77827013fe" :step/id #uuid "90fd6369-1814-5dfa-84f9-2c77827013fe" :step/content "question-12e17457-b92e-5bbd-b375-4d92edbd2785" :step/next "step-9d2d618e-ac00-5aeb-ab8a-e66a6a636fdc" :db/ensure [:step/validate]} {:db/id "step-9d2d618e-ac00-5aeb-ab8a-e66a6a636fdc" :step/id #uuid "9d2d618e-ac00-5aeb-ab8a-e66a6a636fdc" :step/content "question-75a986c0-75fe-5567-a170-fed953f3d35d" :db/ensure [:step/validate]} {:db/id "assigned-problem-d6d905f9-2c23-5d31-aad4-69e916e7bfd7" :assigned-problem/id #uuid "d6d905f9-2c23-5d31-aad4-69e916e7bfd7" :assigned-problem/content "multistep-d9a60175-ea7e-5ff5-a696-1e759f0e8e78" :assigned-problem/topic-coverage [17592186048630 17592186049962 17592186049676 17592186051048 17592186048781 17592186048859] :db/ensure [:assigned-problem/validate]} {:db/id "activity-2e158a7f-51b3-581a-b996-045e00f882e4" :activity/id #uuid "2e158a7f-51b3-581a-b996-045e00f882e4" :activity/title "Optimizing Multivariable Revenue Functions" :activity/type :activity.type/assignment :activity/steps ["step-ffbdad88-6e01-50af-bb44-de024d401ded"] :activity/first-step "step-ffbdad88-6e01-50af-bb44-de024d401ded" :db/ensure [:activity/validate]} {:db/id "step-ffbdad88-6e01-50af-bb44-de024d401ded" :step/id #uuid "ffbdad88-6e01-50af-bb44-de024d401ded" :step/content "assigned-problem-d6d905f9-2c23-5d31-aad4-69e916e7bfd7" :db/ensure [:step/validate]} {:db/id 17592186059870 :knowledge-point/questions ["question-09a2f783-f81f-5ba2-8e8b-78ad6330c2dd" "question-5c6f292d-8813-58fc-b4b8-7f51b18fc102"] :db/ensure [:knowledge-point/validate]} {:db/id "question-09a2f783-f81f-5ba2-8e8b-78ad6330c2dd" :question/id #uuid "09a2f783-f81f-5ba2-8e8b-78ad6330c2dd" :question/math-academy-id "q-61687" :question/problem "A radioactive substance decays exponentially such that its mass reduces by $\\frac{1}{4}$ every hour. If the mass of the substance was initially $2\\,\\text{kg},$ what is the mass of the substance after $9$ hours?" :question/worked-solution "If the mass reduces by $\\frac{1}{4},$ then $\\frac{3}{4}$ of its mass remains every hour.\n\nTherefore:\n\n- After $1$ hour, the mass is $2\\cdot (\\frac{3}{4}).$\n\n- After $2$ hours, the mass is $2\\cdot {(\\frac{3}{4})}^{2}.$\n\n- After $3$ hours, the mass is $2\\cdot {(\\frac{3}{4})}^{3}.$\n\n- $…$\n\nRepeating this pattern, we see that the mass after $9$ hours is $2\\cdot {(\\frac{3}{4})}^{9}\\,\\text{kg}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3d943c3b-30bf-5f50-9d21-212a996b1fd0"] :db/ensure [:question/validate]} {:db/id "answer-field-3d943c3b-30bf-5f50-9d21-212a996b1fd0" :answer-field/id #uuid "3d943c3b-30bf-5f50-9d21-212a996b1fd0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b7594013-bebf-56a0-a402-a6f6ee3a5b22" :answer-field/choices ["answer-6e47a032-29fd-5008-bafe-e0cc57a28e71" "answer-1ec9087c-76ac-5207-b1f9-ec6fe4b81431" "answer-b7594013-bebf-56a0-a402-a6f6ee3a5b22" "answer-36010bc1-90bd-5d59-bf60-398650da4041" "answer-b130822a-20ed-52e4-9477-4de7e3cf757a"] :db/ensure [:answer-field/validate]} {:db/id "answer-6e47a032-29fd-5008-bafe-e0cc57a28e71" :answer/id #uuid "6e47a032-29fd-5008-bafe-e0cc57a28e71" :answer/type :answer.type/math :answer/value "2\\cdot (\\frac{3}{4})\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-1ec9087c-76ac-5207-b1f9-ec6fe4b81431" :answer/id #uuid "1ec9087c-76ac-5207-b1f9-ec6fe4b81431" :answer/type :answer.type/math :answer/value "2\\cdot {(\\frac{1}{4})}^{9}\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-b7594013-bebf-56a0-a402-a6f6ee3a5b22" :answer/id #uuid "b7594013-bebf-56a0-a402-a6f6ee3a5b22" :answer/type :answer.type/math :answer/value "2\\cdot {(\\frac{3}{4})}^{9}\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-36010bc1-90bd-5d59-bf60-398650da4041" :answer/id #uuid "36010bc1-90bd-5d59-bf60-398650da4041" :answer/type :answer.type/math :answer/value "{2}^{9}\\cdot (\\frac{1}{4})\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "answer-b130822a-20ed-52e4-9477-4de7e3cf757a" :answer/id #uuid "b130822a-20ed-52e4-9477-4de7e3cf757a" :answer/type :answer.type/math :answer/value "{2}^{9}\\cdot (\\frac{3}{4})\\,\\text{kg}" :db/ensure [:answer/validate]} {:db/id "question-5c6f292d-8813-58fc-b4b8-7f51b18fc102" :question/id #uuid "5c6f292d-8813-58fc-b4b8-7f51b18fc102" :question/math-academy-id "q-61703" :question/problem "A soccer club started with $120$ members. The number of members in the club then decreased by $\\frac{1}{5}$ every year. Which expression gives approximately the number of members after $3$ years?" :question/worked-solution "If the number of members reduced by $\\frac{1}{5}$ every year, it means that $\\frac{4}{5}$ of members remained every year.\n\nTherefore:\n\n- After $1$ year, there were $120\\cdot (\\frac{4}{5})$ members.\n\n- After $2$ years, there were approximately $120\\cdot {(\\frac{4}{5})}^{2}$ members.\n\n- After $3$ years, there were approximately $120\\cdot {(\\frac{4}{5})}^{3}$ members." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fc24bef0-f8cf-5321-9a6d-d5127a9ed564"] :db/ensure [:question/validate]} {:db/id "answer-field-fc24bef0-f8cf-5321-9a6d-d5127a9ed564" :answer-field/id #uuid "fc24bef0-f8cf-5321-9a6d-d5127a9ed564" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ed2ae62b-708a-58b6-93f0-dc688cfbb87b" :answer-field/choices ["answer-56025d08-3daa-57d3-a124-01b79cf0d75e" "answer-ed2ae62b-708a-58b6-93f0-dc688cfbb87b" "answer-d0507e43-149d-5743-8d36-f39796b33425" "answer-bed9968c-838f-5361-8f39-c03feaab5e2f" "answer-db5a9956-eda8-532e-a69a-92488632bfd1"] :db/ensure [:answer-field/validate]} {:db/id "answer-56025d08-3daa-57d3-a124-01b79cf0d75e" :answer/id #uuid "56025d08-3daa-57d3-a124-01b79cf0d75e" :answer/type :answer.type/math :answer/value "120\\cdot {(\\frac{1}{5})}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-ed2ae62b-708a-58b6-93f0-dc688cfbb87b" :answer/id #uuid "ed2ae62b-708a-58