bf1d4" :db/ensure [:step/validate]} {:db/id "step-6372c740-c40b-54b4-b2d8-d67db30bf1d4" :step/id #uuid "6372c740-c40b-54b4-b2d8-d67db30bf1d4" :step/content 17592186365673 :step/next "step-231eb329-513b-5dfb-85da-6e0f13afe8fd" :db/ensure [:step/validate]} {:db/id "step-231eb329-513b-5dfb-85da-6e0f13afe8fd" :step/id #uuid "231eb329-513b-5dfb-85da-6e0f13afe8fd" :step/content "question-20281150-3bf1-5302-a5be-765695a3b8d8" :db/ensure [:step/validate]} {:db/id 17592186064310 :knowledge-point/questions ["question-deb7ada4-14d9-5457-acd5-ef77477a4e36" "question-f3859b1c-a23b-517a-bfe5-a836f749be10" "question-88fe2774-53cf-5c90-a007-5fb6a5d78b33"] :db/ensure [:knowledge-point/validate]} {:db/id "question-deb7ada4-14d9-5457-acd5-ef77477a4e36" :question/id #uuid "deb7ada4-14d9-5457-acd5-ef77477a4e36" :question/math-academy-id "q-138832" :question/problem "Consider the function $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.$  The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{4}+2x}g(x)}{(x+8)^{7}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{4}+2x})-\\operatorname{ln}⁡((x+8)^{6}) \\\\ \\operatorname{ln}⁡y & ={x}^{4}+2x-6\\operatorname{ln}⁡(x+8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+2x-6\\operatorname{ln}⁡(x+8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4{x}^{3}+2-6\\cdot \\frac{1}{x+8} \\\\ \\frac{{y}^{′}}{y} & =4{x}^{3}+2-\\frac{6}{x+8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(4{x}^{3}+2-\\frac{6}{x+8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(4{x}^{3}+2-\\frac{6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(\\frac{(4{x}^{3}+2)(x+8)-6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}((4{x}^{3}+2)(x+8)-6) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}(4{x}^{4}+32{x}^{3}+2x+16-6) \\\\  & =\\frac{2{e}^{{x}^{4}+2x}(2{x}^{4}+16{x}^{3}+x+5)}{(x+8)^{7}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2{x}^{4}+16{x}^{3}+x+5.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-0d94c7c1-de0e-5fb5-af87-71126c21e380"] :db/ensure [:question/validate]} {:db/id "answer-field-0d94c7c1-de0e-5fb5-af87-71126c21e380" :answer-field/id #uuid "0d94c7c1-de0e-5fb5-af87-71126c21e380" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer-field/choices ["answer-b35826d5-c07d-51fb-931e-4b0d6ab4dd47" "answer-67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" "answer-2f947482-c2c6-568d-82f0-29af6bfba254" "answer-89588797-26b1-5b42-8b21-2029da27dbba" "answer-3e350aae-2cd2-5f81-8e5d-74dec200744b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b35826d5-c07d-51fb-931e-4b0d6ab4dd47" :answer/id #uuid "b35826d5-c07d-51fb-931e-4b0d6ab4dd47" :answer/type :answer.type/math :answer/value "2{x}^{4}+16{x}^{3}+2x+8" :db/ensure [:answer/validate]} {:db/id "answer-67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type :answer.type/math :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/ensure [:answer/validate]} {:db/id "answer-2f947482-c2c6-568d-82f0-29af6bfba254" :answer/id #uuid "2f947482-c2c6-568d-82f0-29af6bfba254" :answer/type :answer.type/math :answer/value "2{x}^{4}+8{x}^{3}+x+5" :db/ensure [:answer/validate]} {:db/id "answer-89588797-26b1-5b42-8b21-2029da27dbba" :answer/id #uuid "89588797-26b1-5b42-8b21-2029da27dbba" :answer/type :answer.type/math :answer/value "{x}^{4}+16{x}^{3}+2x+8" :db/ensure [:answer/validate]} {:db/id "answer-3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/id #uuid "3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/type :answer.type/math :answer/value "{x}^{4}+8{x}^{3}+x+5" :db/ensure [:answer/validate]} {:db/id "question-f3859b1c-a23b-517a-bfe5-a836f749be10" :question/id #uuid "f3859b1c-a23b-517a-bfe5-a836f749be10" :question/math-academy-id "q-138834" :question/problem "Consider the function $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}g(x)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{x})-\\operatorname{ln}⁡((1-3x)^{5}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{ln}⁡({x}^{2}+1)+x\\cdot \\frac{1}{{x}^{2}+1}\\cdot (2x)-5\\cdot \\frac{1}{1-3x}\\cdot (-3) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}(1-3x)+15({x}^{2}+1)}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{17{x}^{2}-6{x}^{3}+15}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}(17{x}^{2}-6{x}^{3}+15)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(x)=17{x}^{2}-6{x}^{3}+15.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f81d8766-b273-5742-81e1-135f6f4971d0"] :db/ensure [:question/validate]} {:db/id "answer-field-f81d8766-b273-5742-81e1-135f6f4971d0" :answer-field/id #uuid "f81d8766-b273-5742-81e1-135f6f4971d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer-field/choices ["answer-949b2307-7470-54c1-a231-4a7923ae08c1" "answer-84e65e07-d407-5744-b09c-1d7419c5f733" "answer-9f5538e4-cb5c-53d2-8282-324285197339" "answer-42e00fa1-2d53-53c2-91c2-dbaf97414222" "answer-cffa59f6-f8b3-5069-84a6-83cd2e84beae"] :db/ensure [:answer-field/validate]} {:db/id "answer-949b2307-7470-54c1-a231-4a7923ae08c1" :answer/id #uuid "949b2307-7470-54c1-a231-4a7923ae08c1" :answer/type :answer.type/math :answer/value "15{x}^{2}+3{x}^{3}+15" :db/ensure [:answer/validate]} {:db/id "answer-84e65e07-d407-5744-b09c-1d7419c5f733" :answer/id #uuid "84e65e07-d407-5744-b09c-1d7419c5f733" :answer/type :answer.type/math :answer/value "15{x}^{2}-3{x}^{3}+15" :db/ensure [:answer/validate]} {:db/id "answer-9f5538e4-cb5c-53d2-8282-324285197339" :answer/id #uuid "9f5538e4-cb5c-53d2-8282-324285197339" :answer/type :answer.type/math :answer/value "17{x}^{2}+3{x}^{3}+15" :db/ensure [:answer/validate]} {:db/id "answer-42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type :answer.type/math :answer/value "17{x}^{2}-6{x}^{3}+15" :db/ensure [:answer/validate]} {:db/id "answer-cffa59f6-f8b3-5069-84a6-83cd2e84beae" :answer/id #uuid "cffa59f6-f8b3-5069-84a6-83cd2e84beae" :answer/type :answer.type/math :answer/value "5{x}^{2}-6{x}^{3}+15" :db/ensure [:answer/validate]} {:db/id 17592186064311 :knowledge-point/questions ["question-cc13fb5c-5303-5c81-bafe-333779ced9ca"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cc13fb5c-5303-5c81-bafe-333779ced9ca" :question/id #uuid "cc13fb5c-5303-5c81-bafe-333779ced9ca" :question/math-academy-id "q-138854" :question/problem "Consider the function $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{1}{2}(g(x)-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}} \\\\  & =\\frac{\\sqrt{({x}^{2}+4)^{3}}}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{3/2})-\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+4}\\cdot 2x-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}) \\\\  & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2({x}^{2}+4)}) \\\\  & =\\sqrt{\\frac{{x}^{2}+4}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2}) \\\\  & =\\frac{1}{2}(6x-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=6x.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-52f2bc75-08e1-5592-986f-bf5ac47ce09a"] :db/ensure [:question/validate]} {:db/id "answer-field-52f2bc75-08e1-5592-986f-bf5ac47ce09a" :answer-field/id #uuid "52f2bc75-08e1-5592-986f-bf5ac47ce09a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer-field/choices ["answer-1c61cfcf-a787-550b-810a-38a9ae04f7fe" "answer-9411358e-dbc0-567a-a1c3-e8fae0dff5ca" "answer-d6c60272-837e-5905-b5bf-1a14841fc162" "answer-96e9100a-3748-5dd5-ad4e-9a90375f9d8f" "answer-c744d1de-7757-5a26-ac48-bc584e98ec52"] :db/ensure [:answer-field/validate]} {:db/id "answer-1c61cfcf-a787-550b-810a-38a9ae04f7fe" :answer/id #uuid "1c61cfcf-a787-550b-810a-38a9ae04f7fe" :answer/type :answer.type/math :answer/value "2x-6" :db/ensure [:answer/validate]} {:db/id "answer-9411358e-dbc0-567a-a1c3-e8fae0dff5ca" :answer/id #uuid "9411358e-dbc0-567a-a1c3-e8fae0dff5ca" :answer/type :answer.type/math :answer/value "3x" :db/ensure [:answer/validate]} {:db/id "answer-d6c60272-837e-5905-b5bf-1a14841fc162" :answer/id #uuid "d6c60272-837e-5905-b5bf-1a14841fc162" :answer/type :answer.type/math :answer/value "3x-3" :db/ensure [:answer/validate]} {:db/id "answer-96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type :answer.type/math :answer/value "6x" :db/ensure [:answer/validate]} {:db/id "answer-c744d1de-7757-5a26-ac48-bc584e98ec52" :answer/id #uuid "c744d1de-7757-5a26-ac48-bc584e98ec52" :answer/type :answer.type/math :answer/value "6x+6" :db/ensure [:answer/validate]} {:db/id "question-88fe2774-53cf-5c90-a007-5fb6a5d78b33" :question/id #uuid "88fe2774-53cf-5c90-a007-5fb6a5d78b33" :question/math-academy-id "q-343529" :question/problem "Given that $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}},$ find ${y}^{′}.$\n\n${y}^{′}=\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[$\n{{field-1}}$]$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x-2)^{5})-\\operatorname{ln}⁡({e}^{{x}^{2}+3x}) \\\\ \\operatorname{ln}⁡y & =5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\frac{1}{x-2}-(2x+3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{5}{x-2}-(2x+3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[\\frac{5}{x-2}-(2x+3)]\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5}{x-2}-(2x+3)] \\\\  & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5-(x-2)(2x+3)}{x-2}] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(x-2)(2x+3)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(2{x}^{2}-x-6)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[11+x-2{x}^{2}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8d713dab-487c-57b4-848a-8f859a772276"] :db/ensure [:question/validate]} {:db/id "answer-field-8d713dab-487c-57b4-848a-8f859a772276" :answer-field/id #uuid "8d713dab-487c-57b4-848a-8f859a772276" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer-field/choices ["answer-6c406db1-ac6c-5309-b97f-14fd566c17b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer/id #uuid "6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer/type :answer.type/math :answer/value "-2x^{2}+x+11" :db/ensure [:answer/validate]} {:db/id 17592186166919 :knowledge-point/questions ["question-6296be80-55c8-5a2e-8b17-a0c84de2ed61"] :db/ensure [:knowledge-point/validate]} {:db/id "question-6296be80-55c8-5a2e-8b17-a0c84de2ed61" :question/id #uuid "6296be80-55c8-5a2e-8b17-a0c84de2ed61" :question/math-academy-id "q-333296" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-6x(t) \\\\ {y}^{′}(t)=-6y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-6 & 0 \\\\ 0 & -6\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvalues are ${\\lambda }_{1}={\\lambda }_{2}=-6$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{-6t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{-6t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]={e}^{-6t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNotice that for each vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}],$ we get the straight-line solutions of the form\n${e}^{-6t}[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}]$\nthat represent the line passing through the origin and parallel to the vector $[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].$\n\nSince ${e}^{-6t}\\to 0$ as $t\\to \\infty ,$ these solutions approach the origin as $t\\to \\infty .$ \n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/ff/ff337e0120343c7c956afa5e49ea3b482fbd79fe363783a018842d1bfeb340d6.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f19bbfd2-a4f0-5fac-92d7-e5b144aac77f"] :db/ensure [:question/validate]} {:db/id "answer-field-f19bbfd2-a4f0-5fac-92d7-e5b144aac77f" :answer-field/id #uuid "f19bbfd2-a4f0-5fac-92d7-e5b144aac77f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-230537c8-69a6-557d-91bb-f030f6bb01c6" :answer-field/choices ["answer-335d5523-771d-554d-9156-9e4fbbf3eece" "answer-7110c95e-51b1-5868-be7a-c34f3b9a9768" "answer-dc4b1aa4-b78d-5e39-ae30-f82d43e13af7" "answer-67d912e0-e47b-5590-9c31-8a1b3ebc0a70" "answer-230537c8-69a6-557d-91bb-f030f6bb01c6"] :db/ensure [:answer-field/validate]} {:db/id "answer-335d5523-771d-554d-9156-9e4fbbf3eece" :answer/id #uuid "335d5523-771d-554d-9156-9e4fbbf3eece" :answer/type :answer.type/image :answer/value "images/40/404c1f68f360e2916a6281033c8a7e9771b648c61156da903ce2f66b931b924e.png" :db/ensure [:answer/validate]} {:db/id "answer-7110c95e-51b1-5868-be7a-c34f3b9a9768" :answer/id #uuid "7110c95e-51b1-5868-be7a-c34f3b9a9768" :answer/type :answer.type/image :answer/value "images/54/54eba0116ac434bdadbc878e8bd173b6174a42642cfcfe6825a8bdb178a3282c.png" :db/ensure [:answer/validate]} {:db/id "answer-dc4b1aa4-b78d-5e39-ae30-f82d43e13af7" :answer/id #uuid "dc4b1aa4-b78d-5e39-ae30-f82d43e13af7" :answer/type :answer.type/image :answer/value "images/7e/7e48266d30ae7c204b25e6eddca968d1b4ce9cd8e1c7b19cd20247fa66070f0b.png" :db/ensure [:answer/validate]} {:db/id "answer-67d912e0-e47b-5590-9c31-8a1b3ebc0a70" :answer/id #uuid "67d912e0-e47b-5590-9c31-8a1b3ebc0a70" :answer/type :answer.type/image :answer/value "images/eb/eba955015a4b919c65dc24facb0baa6e745df134feac32feeae07c99d40ff4ec.png" :db/ensure [:answer/validate]} {:db/id "answer-230537c8-69a6-557d-91bb-f030f6bb01c6" :answer/id #uuid "230537c8-69a6-557d-91bb-f030f6bb01c6" :answer/type :answer.type/image :answer/value "images/ff/ff337e0120343c7c956afa5e49ea3b482fbd79fe363783a018842d1bfeb340d6.png" :db/ensure [:answer/validate]} {:db/id 17592186166920 :knowledge-point/questions ["question-d04cdee5-5005-58d2-afad-7aaebd536510"] :db/ensure [:knowledge-point/validate]} {:db/id "question-d04cdee5-5005-58d2-afad-7aaebd536510" :question/id #uuid "d04cdee5-5005-58d2-afad-7aaebd536510" :question/math-academy-id "q-333601" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=-x(t)+y(t) \\\\ {y}^{′}(t)=-x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector $v=[1,\\text{ }-1]^{T}$ corresponds to the repeated eigenvalue $\\lambda =-2$ of the system's matrix $A.$ The vector $w=[0,\\text{ }1]^{T}$ is such that $(A-\\lambda I)w=v.$ Select the correct options in the reasoning below.\n\nThe general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-2t}+{c}_{2}([\\begin{aligned}1 \\\\ -1\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{{field-1}}) \\\\  & ={c}_{1}{e}^{-2t}{{field-2}}+{c}_{2}{e}^{-2t}[\\begin{aligned}t \\\\ -t+1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $v=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-2t}\\to $ \n{{field-4}} \nas $t\\to \\infty ,$ these solutions approach \n{{field-5}}  \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/45/4522e4e6ed382e821aaa47d40a191135161f95eef276b6e8ba3a8514e6bfdfd8.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{-2t}[\\begin{aligned}t \\\\ -t+1\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x={{field-6}} \\\\ y=(-t+1){e}^{-2t}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-7}} | $0$ | $0.18$ |\n| $y$ | {{field-8}} | $1$ | $0.18$ |\n\nLet's add the solutions to the phase space.\n\n![](images/db/dbf5a13ecd5e81c399204fd29d235e410fcb62274555cf3e5b32a383c1078d24.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/a6/a680b8c9319290df3beb20d7db964f385b368b01ead33961e2c10d22b19db4eb.png)" :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =-2$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =-2,\\,v=[\\begin{aligned}1 \\\\ -1\\end{aligned}],\\,w=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-2t}+{c}_{2}([\\begin{aligned}1 \\\\ -1\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t}) \\\\  & ={c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]+{c}_{2}{e}^{-2t}[\\begin{aligned}t \\\\ -t+1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $v=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ has the equation \n\n$$\ny=-x\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-2t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](images/45/4522e4e6ed382e821aaa47d40a191135161f95eef276b6e8ba3a8514e6bfdfd8.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{-2t}[\\begin{aligned}t \\\\ -t+1\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{-2t} \\\\ y=(-t+1){e}^{-2t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-1.36$ | $0$ | $0.18$ |\n| $y$ | $4.08$ | $1$ | $0.18$ |\n\nLet's add the solutions to the phase space.\n\n![](images/db/dbf5a13ecd5e81c399204fd29d235e410fcb62274555cf3e5b32a383c1078d24.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/13/13a57f14ea65118473c24c6eb1dbf50a0461060201ced051bb2eb6776f5daf64.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fc4487a4-144f-5b03-86d5-0ad215d73311" "answer-field-a1400a3e-ea49-502b-b598-b16c0c1269be" "ans