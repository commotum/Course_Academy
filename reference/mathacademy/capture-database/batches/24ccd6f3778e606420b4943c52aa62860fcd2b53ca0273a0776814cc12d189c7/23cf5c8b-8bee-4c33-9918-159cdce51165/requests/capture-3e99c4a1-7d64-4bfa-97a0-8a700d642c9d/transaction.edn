/math :answer/value "Φ" :db/ensure [:answer/validate]} {:db/id "answer-field-99e500e9-2419-5436-86f7-bd0983f12961" :answer-field/id #uuid "99e500e9-2419-5436-86f7-bd0983f12961" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "answer-e959566f-e723-58b3-9ab2-a51a923ed3cc" :answer-field/choices ["answer-e959566f-e723-58b3-9ab2-a51a923ed3cc" "answer-cfe5eb6f-4d7a-5247-87cc-a29690e1564d" "answer-c9a4e473-005c-5bad-b050-c349b4619ab7" "answer-0fa5012c-8bff-5182-bdc1-c3192d2fa42b"] :db/ensure [:answer-field/validate]} {:db/id "answer-e959566f-e723-58b3-9ab2-a51a923ed3cc" :answer/id #uuid "e959566f-e723-58b3-9ab2-a51a923ed3cc" :answer/type :answer.type/text :answer/value "definition of a fundamental matrix" :db/ensure [:answer/validate]} {:db/id "answer-cfe5eb6f-4d7a-5247-87cc-a29690e1564d" :answer/id #uuid "cfe5eb6f-4d7a-5247-87cc-a29690e1564d" :answer/type :answer.type/text :answer/value "definition of matrix multiplication" :db/ensure [:answer/validate]} {:db/id "answer-c9a4e473-005c-5bad-b050-c349b4619ab7" :answer/id #uuid "c9a4e473-005c-5bad-b050-c349b4619ab7" :answer/type :answer.type/text :answer/value "integrating the given system" :db/ensure [:answer/validate]} {:db/id "answer-0fa5012c-8bff-5182-bdc1-c3192d2fa42b" :answer/id #uuid "0fa5012c-8bff-5182-bdc1-c3192d2fa42b" :answer/type :answer.type/text :answer/value "properties of diagonalizable matrices" :db/ensure [:answer/validate]} {:db/id "answer-field-047d2299-ba3b-5217-bd76-392b196edadf" :answer-field/id #uuid "047d2299-ba3b-5217-bd76-392b196edadf" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "answer-806ffe8b-ec3d-5752-b9c6-7e479c231b96" :answer-field/choices ["answer-bf7ddf96-482e-5261-9f56-9cabb5f0cd3e" "answer-806ffe8b-ec3d-5752-b9c6-7e479c231b96" "answer-d4ac113d-a092-55a0-828c-3cce578364b2" "answer-21f04a48-e3d9-5285-9be6-a47bfb7a3162"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf7ddf96-482e-5261-9f56