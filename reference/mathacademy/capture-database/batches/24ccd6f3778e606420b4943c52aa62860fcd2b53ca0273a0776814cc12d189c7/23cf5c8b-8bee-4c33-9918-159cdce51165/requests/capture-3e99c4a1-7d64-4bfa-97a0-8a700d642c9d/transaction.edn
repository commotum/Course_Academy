\\frac{1}{4})] \\\\ {s}_{4} & =\\frac{1}{4}[(\\frac{1}{2}-\\cancel{\\frac{1}{3}})+(\\cancel{\\frac{1}{3}}-\\cancel{\\frac{1}{4}})+(\\cancel{\\frac{1}{4}}-\\frac{1}{5})] \\\\ {s}_{5} & =\\frac{1}{4}[(\\frac{1}{2}-\\cancel{\\frac{1}{3}})+(\\cancel{\\frac{1}{3}}-\\cancel{\\frac{1}{4}})+(\\cancel{\\frac{1}{4}}-\\cancel{\\frac{1}{5}})+(\\cancel{\\frac{1}{5}}-\\frac{1}{6})].\\end{aligned}\n$$\n\nNotice that for each partial sum, we always end up canceling all terms with the exception of the first and last terms. Therefore, the $N$th partial sum is\n\n$$\n{s}_{N}=\\frac{1}{4}[\\frac{1}{2}-\\frac{1}{N+1}].\n$$\n\nFinally, we can determine the sum of the series by taking the limit of ${s}_{N}:$\n\n$$\n\\begin{aligned}{\\sum }_{n=2}^{\\infty }\\frac{1}{4n(n+1)} & ={lim}_{N\\to \\infty }{s}_{N} \\\\  & ={lim}_{N\\to \\infty }\\frac{1}{4}[\\frac{1}{2}-\\frac{1}{N+1}] \\\\  & =\\frac{1}{4}[\\frac{1}{2}-0] \\\\  & =\\frac{1}{8}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1e3e455b-3884-5fa2-8367-4a5e460807e8"] :db/ensure [:question/validate]} {:db/id "answer-field-1e3e455b-3884-5fa2-8367-4a5e460807e8" :answer-field/id #uuid "1e3e455b-3884-5fa2-8367-4a5e460807e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21ed06dc-2f9a-5035-a365-b516f3b8e9e5" :answer-field/choices ["answer-259e7b4a-5f58-58e8-8b7a-8f410ab7a386" "answer-69072445-1f57-5024-9393-cfc93ecae8b2" "answer-fd07bb2b-6017-5248-9910-9934f944779b" "answer-bb54fb5e-2252-54b2-bb7e-6c64d9abb972" "answer-21ed06dc-2f9a-5035-a365-b516f3b8e9e5"] :db/ensure [:answer-field/validate]} {:db/id "answer-259e7b4a-5f58-58e8-8b7a-8f410ab7a386" :answer/id #uuid "259e7b4a-5f58-58e8-8b7a-8f410ab7a386" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-69072445-1f57-5024-9393-cfc93ecae8b2" :answer/id #uuid "69072445-1f57-5024-9393-cfc93ecae8b2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-fd07bb2b-6017-5248-9910-9934f944779b" :answer/id #uuid "fd07bb2b-6017-5248-9910-9934f944779b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-bb54fb5e-2252-54b2-bb7e-6c64d9abb972" :answer/id #uuid "bb54fb5e-2252-54b2-bb7e-6c64d9abb972" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-21ed06dc-2f9a-5035-a365-b516f3b8e9e5" :answer/id #uuid "21ed06dc-2f9a-5035-a365-b516f3b8e9e5" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "question-183b979f-8612-5577-8e86-5be342266cb9" :question/id #uuid "183b979f-8612-5577-8e86-5be342266cb9" :question/math-academy-id "q-124095" :question/problem "${\\sum }_{n=5}^{\\infty }\\frac{4}{3n(n+1)}=$" :question/worked-solution "First, note that the series can be written as\n\n$$\n\\frac{4}{3}{\\sum }_{n=5}^{\\infty }\\frac{1}{n(n+1)}.\n$$\n\nUsing partial fractions we can write the series as\n\n$$\n\\frac{4}{3}{\\sum }_{n=5}^{\\infty }(\\frac{1}{n}-\\frac{1}{n+1}).\n$$\n\nComputing the first few partial sums, starting with $n=5,$ gives\n\n$$\n\n$$\n\\begin{aligned}{s}_{5} & =\\frac{4}{3}[(\\frac{1}{5}-\\frac{1}{6})] \\\\ {s}_{6} & =\\frac{4}{3}[(\\frac{1}{5}-\\cancel{\\frac{1}{6}})+(\\cancel{\\frac{1}{6}}-\\frac{1}{7})] \\\\ {s}_{7} & =\\frac{4}{3}[(\\frac{1}{5}-\\cancel{\\frac{1}{6}})+(\\cancel{\\frac{1}{6}}-\\cancel{\\frac{1}{7}})+(\\cancel{\\frac{1}{7}}-\\frac{1}{8})] \\\\ {s}_{8} & =\\frac{4}{3}[(\\frac{1}{5}-\\cancel{\\frac{1}{6}})+(\\cancel{\\frac{1}{6}}-\\cancel{\\frac{1}{7}})+(\\cancel{\\frac{1}{7}}-\\cancel{\\frac{1}{8}})+(\\cancel{\\frac{1}{8}}-\\frac{1}{9})].\\end{aligned}\n$$\n\nNotice that for each partial sum, we always end up canceling all terms with the exception of the first and last terms. Therefore, the $N$th partial sum is\n\n$$\n{s}_{N}=\\frac{4}{3}[\\frac{1}{5}-\\frac{1}{N+1}].\n$$\n\nFinally, we can determine the sum of the series by taking the limit of ${s}_{N}:$\n\n$$\n\\begin{aligned}{\\sum }_{n=5}^{\\infty }\\frac{4}{3n(n+1)} & ={lim}_{N\\to \\infty }{s}_{N} \\\\  & ={lim}_{N\\to \\infty }\\frac{4}{3}[\\frac{1}{5}-\\frac{1}{N+1}] \\\\  & =\\frac{4}{3}[\\frac{1}{5}-0] \\\\  & =\\frac{4}{15}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c348c4bc-8b15-5dd5-b4d0-523208e399b4"] :db/ensure [:question/validate]} {:db/id "answer-field-c348c4bc-8b15-5dd5-b4d0-523208e399b4" :answer-field/id #uuid "c348c4bc-8b15-5dd5-b4d0-523208e399b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8ef73664-6e2f-5f41-9398-933a2d2b8caa" :answer-field/choices ["answer-fc1f4274-da86-5d85-a809-c1f4774f4fdf" "answer-8d04003e-535b-59c1-a8b2-ef10384c39de" "answer-8ef73664-6e2f-5f41-9398-933a2d2b8caa" "answer-790c06ab-8a7e-52b6-9261-e6a69ddee1d0" "answer-ea685e28-a2a8-5e51-99d4-dd09baa896c5"] :db/ensure [:answer-field/validate]} {:db/id "answer-fc1f4274-da86-5d85-a809-c1f4774f4fdf" :answer/id #uuid "fc1f4274-da86-5d85-a809-c1f4774f4fdf" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-8d04003e-535b-59c1-a8b2-ef10384c39de" :answer/id #uuid "8d04003e-535b-59c1-a8b2-ef10384c39de" :answer/type :answer.type/math :answer/value "\\frac{20}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8ef73664-6e2f-5f41-9398-933a2d2b8caa" :answer/id #uuid "8ef73664-6e2f-5f41-9398-933a2d2b8caa" :answer/type :answer.type/math :answer/value "\\frac{4}{15}" :db/ensure [:answer/validate]} {:db/id "answer-790c06ab-8a7e-52b6-9261-e6a69ddee1d0" :answer/id #uuid "790c06ab-8a7e-52b6-9261-e6a69ddee1d0" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-ea685e28-a2a8-5e51-99d4-dd09baa896c5" :answer/id #uuid "ea685e28-a2a8-5e51-99d4-dd09baa896c5" :answer/type :answer.type/math :answer/value "\\frac{8}{21}" :db/ensure [:answer/validate]} {:db/id "question-845a7208-7bb2-5626-b631-2ac2830e5096" :question/id #uuid "845a7208-7bb2-5626-b631-2ac2830e5096" :question/math-academy-id "q-124194" :question/problem "${\\sum }_{n=8}^{\\infty }\\frac{4}{n(n+1)}=$" :question/worked-solution "First, note that the series can be written as\n\n$$\n4\\cdot {\\sum }_{n=8}^{\\infty }\\frac{1}{n(n+1)}.\n$$\n\nUsing partial fractions we can write the series as\n\n$$\n4\\cdot {\\sum }_{n=8}^{\\infty }(\\frac{1}{n}-\\frac{1}{n+1}).\n$$\n\nComputing the first few partial sums, starting with $n=8,$ gives\n\n$$\n\\begin{aligned}{s}_{8} & =4\\cdot [(\\frac{1}{8}-\\frac{1}{9})] \\\\ {s}_{9} & =4\\cdot [(\\frac{1}{8}-\\cancel{\\frac{1}{9}})+(\\cancel{\\frac{1}{9}}-\\frac{1}{10})] \\\\ {s}_{10} & =4\\cdot [(\\frac{1}{8}-\\cancel{\\frac{1}{9}})+(\\cancel{\\frac{1}{9}}-\\cancel{\\frac{1}{10}})+(\\cancel{\\frac{1}{10}}-\\frac{1}{11})] \\\\ {s}_{11} & =4\\cdot [(\\frac{1}{8}-\\cancel{\\frac{1}{9}})+(\\cancel{\\frac{1}{9}}-\\cancel{\\frac{1}{10}})+(\\cancel{\\frac{1}{10}}-\\cancel{\\frac{1}{11}})+(\\cancel{\\frac{1}{11}}-\\frac{1}{12})].\\end{aligned}\n$$\n\nNotice that for each partial sum, we always end up canceling all terms with the exception of the first and last terms. Therefore, the $N$th partial sum is\n\n$$\n{s}_{N}=4\\cdot [\\frac{1}{8}-\\frac{1}{N+1}].\n$$\n\nFinally, we can determine the sum of the series by taking the limit of ${s}_{N}:$\n\n$$\n\\begin{aligned}{\\sum }_{n=8}^{\\infty }\\frac{4}{n(n+1)} & ={lim}_{N\\to \\infty }{s}_{N} \\\\  & ={lim}_{N\\to \\infty }4\\cdot [\\frac{1}{8}-\\frac{1}{N+1}] \\\\  & =4\\cdot [\\frac{1}{8}-0] \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2abb9533-171a-54ef-95c0-b9dcb2730be9"] :db/ensure [:question/validate]} {:db/id "answer-field-2abb9533-171a-54ef-95c0-b9dcb2730be9" :answer-field/id #uuid "2abb9533-171a-54ef-95c0-b9dcb2730be9" :answer-field/key "selection" 