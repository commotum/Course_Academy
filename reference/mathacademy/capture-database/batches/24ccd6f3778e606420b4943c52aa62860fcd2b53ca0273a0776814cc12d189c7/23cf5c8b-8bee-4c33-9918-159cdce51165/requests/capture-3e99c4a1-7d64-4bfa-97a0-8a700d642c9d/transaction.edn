-0e88-581e-83f0-4e610ace94c7" :answer/type :answer.type/math :answer/value "2.72" :db/ensure [:answer/validate]} {:db/id "answer-5d1b62c3-0289-5288-a293-4b938fe71832" :answer/id #uuid "5d1b62c3-0289-5288-a293-4b938fe71832" :answer/type :answer.type/math :answer/value "4.08" :db/ensure [:answer/validate]} {:db/id 17592186166921 :knowledge-point/questions ["question-130e77e3-e68d-5bfc-a672-f433d0d78798"] :db/ensure [:knowledge-point/validate]} {:db/id "question-130e77e3-e68d-5bfc-a672-f433d0d78798" :question/id #uuid "130e77e3-e68d-5bfc-a672-f433d0d78798" :question/math-academy-id "q-333626" :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=4x(t)+y(t) \\\\ {y}^{′}(t)=4y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above, where the system's matrix has only one eigenvalue. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :question/worked-solution "The matrix of our system is\n\n$$\nA=[\\begin{aligned}4 & 1 \\\\ 0 & 4\\end{aligned}].\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is $\\lambda =4$ and it's positive, we have a $\\text{unstable}$ node.\n\n- Since $A$ is not diagonal and has a repeated eigenvalue, there is only one linearly independent eigenvector. So, we have a $\\text{degenerate}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/f6/f67469d62d6a0eb61397927924e55868437ad09f405c3b2a9d73567af00c4620.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-40c5a737-0591-5fd5-8df7-bba8f7661150" "answer-field-563869eb-e9b6-592a-b3a5-fad42529fb9f"] :db/ensure [:question/validate]} {:db/id "answer-field-40c5a737-0591-5fd5-8df7-bba8f7661150" :answer-field/id #uuid "40c5a737-0591-5fd5-8df7-bba8f7661150" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-65ac0981-1b1d-5c23-9cc0-fc444715eee5" :answer-field/choices ["answer-bf9a387f-3c17-5e04-b07f-ec5133f1dfe1" "answer-65ac0981-1b1d-5c23-9cc0-fc444715eee5"] :db/ensure [:answer-field/validate]} {:db/id "answer-bf9a387f-3c17-5e04-b07f-ec5133f1dfe1" :answer/id #uuid "bf9a387f-3c17-5e04-b07f-ec5133f1dfe1" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "answer-65ac0981-1b1d-5c23-9cc0-fc444715eee5" :answer/id #uuid "65ac0981-1b1d-5c23-9cc0-fc444715eee5" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "answer-field-563869eb-e9b6-592a-b3a5-fad42529fb9f" :answer-field/id #uuid "563869eb-e9b6-592a-b3a5-fad42529fb9f" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "answer-70dfdf1e-bde5-58a0-8f24-d392080fc911" :answer-field/choices ["answer-70dfdf1e-bde5-58a0-8f24-d392080fc911" "answer-a6dff475-5ce9-583a-91b1-fe2ebf698ee4"] :db/ensure [:answer-field/validate]} {:db/id "answer-70dfdf1e-bde5-58a0-8f24-d392080fc911" :answer/id #uuid "70dfdf1e-bde5-58a0-8f24-d392080fc911" :answer/type :answer.type/text :answer/value "degenerate" :db/ensure [:answer/validate]} {:db/id "answer-a6dff475-5ce9-583a-91b1-fe2ebf698ee4" :answer/id #uuid "a6dff475-5ce9-583a-91b1-fe2ebf698ee4" :answer/type :answer.type/text :answer/value "star" :db/ensure [:answer/validate]} {:db/id 17592186167221 :question/problem "$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t)+4y(t) \\\\ {y}^{′}(t)=-x(t)-3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above, where the system's matrix has repeated eigenvalue $\\lambda =-1$ of multiplicity two. Select the correct options below regarding the given system.\n\n$\\,$ The equilibrium point (origin) is a \n{{field-1}}{{field-2}}\nnode." :question/worked-solution "The matrix of our system is\n\n$$\nA=[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}].\n$$\n\nNotice that:\n\n- Since the only (repeated) eigenvalue of $A$ is negative, we have a $\\text{stable}$ node.\n\n- Since $A$ is not diagonal and has a repeated eigenvalue, there is only one linearly independent eigenvector. So, we have a $\\text{degenerate}$ node.\n\n**Note:** The phase portrait of the system looks as follows:\n\n![](images/1f/1fe96278d09a5875c2f1e7c8762a808fd9549b37508f70b129b20e311b166308.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164384 :answer-field/correct 17592186164386 :db/ensure [:answer-field/validate]} {:db/id 17592186164381 :answer-field/correct 17592186164383 :db/ensure [:answer-field/validate]} {:db/id 17592186168005 :tutorial/content "Let's sketch the phase portrait of the following linear system:\n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=2y(t)\\end{aligned}\n$$\n\nWriting our system in matrix form, we have\n![](images/f5/f58fb57caaba8c5f6a110c72565c24803ac233f41b8eb2db0c5221bcf12d7fe2.svg)\nwhere ![](images/65/65298928a44147868c82da753a731e35c3aa0ad5e4b3400819d9d9f16f546a34.svg)\n\nSince our system is decoupled, its eigenvalues are $\\lambda_1=\\lambda_2=2$ with the corresponding eigenvectors $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ and ![](images/69/694a89326f61bbbba7e91db5dcb607a74f99881ce16059450dbe1bbac7ee797e.svg)\n\nThe general solution of the system is\n![](images/ab/abd4dbe3156abbcd645e670fb893f93cc8765cba4b1da9bde11075e211f1eeaa.svg)\n\nNotice that for each vector ![](images/9d/9df6cb20bf3163f53850730242138ec62412ccc8af23098130d71228cac4b82a.svg) we get the straight-line solutions of the form\n![](images/71/7166c456c7912bf31d4ff2d98f4e4206537f8d01aca086fdba3c15b394db4b81.svg)\nthat represent the line passing through the origin and parallel to the vector ![](images/23/23074d10911b113811cc92bdc88a61a6758dbd8772c21425159c5e95d30b1075.svg)\n\nSince $e^{2t} \\to \\infty$ as $t \\to \\infty,$ these solutions move away from the origin as $t \\to \\infty,$ so the origin is an unstable node.\n\nThe phase portrait satisfying these conditions is the following:\n\n![](images/b3/b32b5666c0138f5c17ff1622cef9bca6fb019375f6748b6422c11a547cfad282.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186168006 :tutorial/content "Consider the following system of linear differential equations: \n\n$$\n\\{\\begin{aligned}{x}^{′}(t)=x(t)+y(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}\n$$\n\nThe eigenvector corresponding to the only eigenvalue of the system's matrix $A$ is ![](images/23/23616d197363a3fd8ad4689a0b1e547c7b1044e0929cfd96add65a26e940731f.svg) The vector ![](images/3e/3e434cc0b5ca5d288695abb58500e8f4ca6be0c0cf2ecb5200d03f5fbcf522c2.svg) is such that $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$ \n\nLet's sketch the phase portrait of the system.\n\nSince we have a repeated eigenvalue $\\lambda=1$ (of multiplicity two) and only one corresponding eigenvector $\\mathbf{v},$ the solution of the system is given by\n\n$$\n\\mathbf{x}(t) = c_1\\mathbf{v} e^{\\lambda t}  + c_2 (\\mathbf{v}  te^{\\lambda t}  +  \\mathbf{w}e^{\\lambda t} \\, ),\n$$\n\nwhere $\\mathbf{w}$ is a solution to the equation $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$\n\nIn our case, \n![](images/0f/0f7c56980abff1ad84ca69aa98730bca2988cf5430f181f69d191f1e3c28eff0.svg) \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t}) \\\\  & ={c}_{1}{e}^{t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{t}[\\begin{aligned}t \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe straight-line solutions of the form\n![](images/c9/c9d65d3792c7cced40b86834fbd66769daa714ed58ffcde025cb956763c2c670.svg)\nlie on the $x$-axis. Since $e^{t} \\to \\infty$ as $t \\to \\infty,$ these solutions move toward infinity in the phase plane as $t \\to \\infty.$\n\nLet's add the solutions to the phase space.\n\n![](images/98/98fc60d566b520f3d943e42ee8f4e07aa0bdd33b53fbb04981c2e8f4001210fd.png)\n\nNow, consider solutions of the form\n![](images/61/6170eec4537e26afef2a794426b4f5231b0f4366c21b8860c332f1ec7573b96a.svg)\nWhen $c_2=1,$ we get the following curve:\n\n$$\n\\{\\begin{aligned}x=t{e}^{t} \\\\ y={e}^{t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $1.2$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.30$ | $0$ | $3.98$ |\n| $y$ | $0.61$ | $1$ | $3.32$ |\n\nLet's add the solutions to the phase space.\n\n![](images/4f/4fbc1650377d580d7129701d745dc8cad89d2d1d061b8f6dca8127f0ce062dc8.png)\n\nThe phase portrait of our system looks as follows:\n\n![](images/49/499391b5bc015bd96bbe85d72e3937e87a5e89081951aaad0a752582cb87f15f.png)" :db/ensure [:tutorial/validate]} [:db/retract 17592186230997 :answer-field/choices 17592186230998] [:db/retract 17592186230997 :answer-field/choices 17592186230999] [:db/retract 17592186230997 :answer-field/choices 17592186231000] [:db/retract 17592186230997 :answer-field/choices 17592186231001] [:db/retract 17592186230997 :answer-field/choices 17592186231002] {:db/id 17592186231450 :knowledge-point/questions ["question-70f30638-2aaa-5352-bc26-9df3570b67f9" "question-bcdc2275-c8f5-5708-9f40-dd5af1bab702" "question-dae35b84-ab79-5551-9374-7336192ddee8" "question-c1599c17-000c-53e6-a6c2-601e2c06fa87"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186231376 :question/problem "Let $S=\\{-1,0,2,4\\}$ and suppose\n\n$$\nf(-1)=3,\\qquad f(0)=-2,\\qquad f(2)=5,\\qquad f(4)=1.\n$$\n\nCompute the following:\n\n$$\n\\max_{x \\in S} f(x),\\qquad \\arg\\max_{x \\in S} f(x),\\qquad \\min_{x \\in S} f(x),\\qquad \\arg\\min_{x \\in S} f(x).\n$$" :question/worked-solution "Recall that \n\n- $\\max\\limits_{x \\in S} f(x)$ is the largest output value, while\n\n- $\\arg\\max\\limits_{x \\in S} f(x)$ is an input in $S$ where that largest output occurs.\n\nOn the other hand,\n\n- $\\min\\limits_{x \\in S} f(x)$ is the smallest output value, while\n\n- $\\arg\\min\\limits_{x \\in S} f(x)$ is an input in $S$ where that smallest output occurs.\n\nThe outputs of $f$ on $S$ are\n\n$$\n3,\\qquad -2,\\qquad 5,\\qquad 1.\n$$\n\nThe largest output is $5,$ and it occurs at $x=2.$ Therefore,\n\n$$\n\\max_{x \\in S} f(x)=5,\n\\qquad\n\\arg\\max_{x \\in S} f(x)=2.\n$$\n\nSimilarly, the smallest output is $-2,$ and it occurs at $x=0.$ Therefore,\n\n$$\n\\min_{x \\in S} f(x)=-2,\n\\qquad\n\\arg\\min_{x \\in S} f(x)=0.\n$$" :db/ensure [:question/validate]} {:db/id 17592186231451 :knowledge-point/questions ["question-d67215f0-5168-5f34-aa11-965cede50421" "question-c31456f2-6f7b-5c43-b2d6-d63a185e088a" "question-6b85f086-3ff0-5996-862a-13fba81da102" "question-53479689-99f5-53fc-9bbf-170474b20c8c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186231377 :question/problem "Let $S=\\{-1,0,2,3\\}$ and suppose\n\n$$\nf(-1)=4,\\qquad f(0)=1,\\qquad f(2)=4,\\qquad f(3)=2.\n$$\n\nCompute $\\max_{x \\in S} f(x)$ and $\\arg\\max_{x \\in S} f(x).$" :question/worked-solution "Recall that \n\n- $\\max\\limits_{x \\in S} f(x)$ is the largest output value, while\n\n- $\\arg\\max\\limits_{x \\in S} f(x)$ is an input in $S$ where that largest output occurs.\n\nThe output values are $4,1,4,$ and $2.$ The maximum output value is $4.$\n\nThis maximum occurs at both $x=-1$ and $x=2.$ Therefore,\n\n$$\n\\max_{x \\in S} f(x)=\\bbox[4pt,border: 1px solid lightgray]{4}\n\\qquad \\textrm{and} \\qquad\n\\arg\\max_{x \\in S} f(x)=\\bbox[4pt,border: 1px solid lightgray]{\\{-1,2\\}}.\n$$" :db/ensure [:question/validate]} {:db/id 17592186231452 :knowledge-point/questions ["question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" "question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" "question-00fdbc42-937e-5a35-be79-3ffa566504b0" "question-f072186e-d0b3-5257-aa50-624c55328198" "question-0e94aa36-f8ac-5d68-8a85-88c135136bde"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186231378 :question/problem "Let $S$ be a set and let $f$ be a real-valued function on $S.$ Consider the expression\n\n$$\nx^*=\\arg\\max_{x \\in S} f(x).\n$$\n\nWhat does this statement mean in words? Also, what does $\\max_{x \\in S} f(x)$ represent?" :question/worked-solution "The expression $x^*=\\arg\\max_{x \\in S} f(x)$ means that:\n\n- $x^*$ is an input value in $S.$\n\n- Among all $x \\in S,$ the value $f(x^*)$ is as large as possible.\n\nIn other words, $x^*$ is a choice of input where $f$ attains its largest value on $S.$\n\nBy contrast, $\\max_{x \\in S} f(x)$ is not an input. It is the largest *function value* that $f$ attains on $S.$" :db/ensure [:question/validate]} {:db/id "question-70f30638-2aaa-5352-bc26-9df3570b67f9" :question/id #uuid "70f30638-2aaa-5352-bc26-9df3570b67f9" :question/math-academy-id "q-355268" :question/problem "Let $S=\\{-2,0,1,4\\}$ and suppose\n\n$$\nh(-2)=3,\\,h(0)=7,\\,h(1)=-5,\\,h(4)=2.\n$$\n\nCompute the following:\n\n${max}_{x\\in S}h(x)=$\n{{field-1}}\n\n$\\operatorname{arg}⁡{max}_{x\\in S}h(x)=$\n{{field-2}}\n\n${min}_{x\\in S}h(x)=$\n{{field-3}}\n\n$\\operatorname{arg}⁡{min}_{x\\in S}h(x)=$\n{{field-4}}" :question/worked-solution "Recall that \n\n- ${max}_{x\\in S}h(x)$ is the largest output value, while\n\n- $\\operatorname{arg}⁡{max}_{x\\in S}h(x)$ is an input in $S$ where that largest output occurs.\n\nOn the other hand,\n\n- ${min}_{x\\in S}h(x)$ is the smallest output value, while\n\n- $\\operatorname{arg}⁡{min}_{x\\in S}h(x)$ is an input in $S$ where that smallest output occurs.\n\nHere, the outputs are $3,7,-5,$ and $2.$ \n\n- The largest output is $7,$ and it occurs at $x=0.$\n\n- The smallest output is $-5,$ and it occurs at $x=1.$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}{max}_{x\\in S}h(x) & =7 \\\\ \\operatorname{arg}⁡{max}_{x\\in S}h(x) & =0 \\\\ {min}_{x\\in S}h(x) & =-5 \\\\ \\operatorname{arg}⁡{min}_{x\\in S}h(x) & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1ee30075-ef1d-5646-bf59-1a1cf206b83f" "answer-field-45974829-4fca-57ca-9073-a7dd2f9bde6c" "answer-field-081ebd9b-ca0f-5b1c-89d9-c6f0062cfe66" "answer-field-7eb194c3-5312-5415-a2f8-09fa9542b93e"] :db/ensure [:question/validate]} {:db/id "answer-field-1ee30075-ef1d-5646-bf59-1a1cf206b83f" :answer-field/id #uuid "1ee30075-ef1d-5646-bf59-1a1cf206b83f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-44861867-4f69-5756-847f-d2aa71df7223" :answer-field/choices ["answer-44861867-4f69-5756-847f-d2aa71df7223"] :db/ensure [:answer-field/validate]} {:db/id "answer-44861867-4f69-5756-847f-d2aa71df7223" :answer/id #uuid "44861867-4f69-5756-847f-d2aa71df7223" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-45974829-4fca-57ca-9073-a7dd2f9bde6c" :answer-field/id #uuid "45974829-4fca-57ca-9073-a7dd2f9bde6c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ca040f2a-3108-5cde-a403-58ca2d097882" :answer-field/choices ["answer-ca040f2a-3108-5cde-a403-58ca2d097882"] :db/ensure [:answer-field/validate]} {:db/id "answer-ca040f2a-3108-5cde-a403-58ca2d097882" :answer/id #uuid "ca040f2a-3108-5cde-a403-58ca2d097882" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-081ebd9b-ca0f-5b1c-89d9-c6f0062cfe66" :answer-field/id #uuid "081ebd9b-ca0f-5b1c-89d9-c6f0062cfe66" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d8796a66-f435-5714-9bbb-c1cb237fd64f" :answer-field/choices ["answer-d8796a66-f435-5714-9bbb-c1cb237fd64f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d8796a66-f435-5714-9bbb-c1cb237fd64f" :answer/id #uuid "d8796a66-f435-5714-9bbb-c1cb237fd64f" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-field-7eb194c3-5312-5415-a2f8-09fa9542b93e" :answer-field/id #uuid "7eb194c3-5312-5415-a2f8-