1-d183-51ce-9cf9-635adf6fa5e3" :answer/type :answer.type/math :answer/value "\\{-2\\}" :db/ensure [:answer/validate]} {:db/id "answer-2816e8f2-85f0-5744-ac9e-bd675a29c2f5" :answer/id #uuid "2816e8f2-85f0-5744-ac9e-bd675a29c2f5" :answer/type :answer.type/math :answer/value "\\{-4,0\\}" :db/ensure [:answer/validate]} {:db/id "answer-7842d38e-55bb-5a67-9ff8-b04dea78e691" :answer/id #uuid "7842d38e-55bb-5a67-9ff8-b04dea78e691" :answer/type :answer.type/math :answer/value "\\{0\\}" :db/ensure [:answer/validate]} {:db/id "answer-aa82b804-ae48-5345-8c7f-1e5fb38d03cf" :answer/id #uuid "aa82b804-ae48-5345-8c7f-1e5fb38d03cf" :answer/type :answer.type/math :answer/value "\\{3\\}" :db/ensure [:answer/validate]} {:db/id "question-b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/id #uuid "b99f27b6-bb0f-5afc-b357-d0b316cf7a24" :question/math-academy-id "q-355392" :question/problem "Which of the following best describes $\\operatorname{arg}⁡{max}_{\\theta \\in [0,2\\pi ]}f(\\theta )?$" :question/worked-solution "By definition, $\\operatorname{arg}⁡max$ returns an input value where the function achieves its maximum value. \n\nTherefore, $\\operatorname{arg}⁡{max}_{\\theta \\in [0,2\\pi ]}f(\\theta )$ is the value of $\\theta $ in $[0,2\\pi ]$ where $f(\\theta )$ is largest." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5"] :db/ensure [:question/validate]} {:db/id "answer-field-0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/id #uuid "0834d9ef-3a48-5a32-a4fd-6b4392e97da5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd" :answer-field/choices ["answer-97bf954f-753a-55e5-a496-69bf543f8ca2" "answer-36b15808-5d17-588e-96b0-4bafa73d3a87" "answer-03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0" "answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd" "answer-109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9"] :db/ensure [:answer-field/validate]} {:db/id "answer-97bf954f-753a-55e5-a496-69bf543f8ca2" :answer/id #uuid "97bf954f-753a-55e5-a496-69bf543f8ca2" :answer/type :answer.type/text :answer/value "The average value of $f(\\theta )$ on $[0,2\\pi ].$" :db/ensure [:answer/validate]} {:db/id "answer-36b15808-5d17-588e-96b0-4bafa73d3a87" :answer/id #uuid "36b15808-5d17-588e-96b0-4bafa73d3a87" :answer/type :answer.type/text :answer/value "The largest value of $f(\\theta )$ on $[0,2\\pi ].$" :db/ensure [:answer/validate]} {:db/id "answer-03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0" :answer/id #uuid "03cc3ad8-5803-5027-8ae1-b9ab3dc36bf0" :answer/type :answer.type/text :answer/value "The smallest value of $f(\\theta )$ on $[0,2\\pi ].$" :db/ensure [:answer/validate]} {:db/id "answer-f76c7c1f-2951-5978-a2f9-0a0b65916cfd" :answer/id #uuid "f76c7c1f-2951-5978-a2f9-0a0b65916cfd" :answer/type :answer.type/text :answer/value "The value of $\\theta $ in $[0,2\\pi ]$ where $f(\\theta )$ is largest." :db/ensure [:answer/validate]} {:db/id "answer-109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9" :answer/id #uuid "109bb7e4-12e9-5e6e-a2c9-4a3ea3215fc9" :answer/type :answer.type/text :answer/value "The value of $\\theta $ in $[0,2\\pi ]$ where $f(\\theta )$ is smallest." :db/ensure [:answer/validate]} {:db/id "question-f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/id #uuid "f7168caf-99d8-56ba-8b1b-f286cb0133ec" :question/math-academy-id "q-355394" :question/problem "Let $g(y)$ be a profit for product $y,$ where $y\\in \\{3,7,11,15\\}.$ We want to write the best product $\\overset{^}{y}$ as \"the value of $y$ that makes $g(y)$ as large as possible.\"\n\nWhich of the following correctly defines $\\overset{^}{y}?$" :question/worked-solution "We want $\\overset{^}{y}$ to be an *input value* $y$ where the profit $g(y)$ is as large as possible. \n\nThat is exactly what $\\operatorname{arg}⁡max$ returns.\nTherefore,\n\n$$\n\\overset{^}{y}=\\operatorname{arg}⁡{max}_{y\\in \\{3,7,11,15\\}}g(y).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bba509ec-a193-5a29-9ee6-8dfb74ce1d8f"] :db/ensure [:question/validate]} {:db/id "answer-field-bba509ec-a193-5a29-9ee6-8dfb74ce1d8f" :answer-field/id #uuid "bba509ec-a193-5a29-9ee6-8dfb74ce1d8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd1c8e6c-c2cc-567c-b331-4c30a5590e84" :answer-field/choices ["answer-cd1c8e6c-c2cc-567c-b331-4c30a5590e84" "answer-aefadc2d-31ef-5613-926b-0f541f57d23f" "answer-4e419701-4ca0-5634-aac0-e3a2e78a3ba0" "answer-3613e1aa-20ff-553e-86bf-6acd4c4e754b" "answer-70459e85-62ef-5e1c-8027-39db3fe41145"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd1c8e6c-c2cc-567c-b331-4c30a5590e84" :answer/id #uuid "cd1c8e6c-c2cc-567c-b331-4c30a5590e84" :answer/type :answer.type/math :answer/value "\\overset{^}{y}=\\operatorname{arg}⁡{max}_{y\\in \\{3,7,11,15\\}}g(y)" :db/ensure [:answer/validate]} {:db/id "answer-aefadc2d-31ef-5613-926b-0f541f57d23f" :answer/id #uuid "aefadc2d-31ef-5613-926b-0f541f57d23f" :answer/type :answer.type/math :answer/value "\\overset{^}{y}=\\operatorname{arg}⁡{min}_{y\\in \\{3,7,11,15\\}}g(y)" :db/ensure [:answer/validate]} {:db/id "answer-4e419701-4ca0-5634-aac0-e3a2e78a3ba0" :answer/id #uuid "4e419701-4ca0-5634-aac0-e3a2e78a3ba0" :answer/type :answer.type/math :answer/value "\\overset{^}{y}=\\operatorname{arg}⁡{min}_{y\\in g(y)}\\{3,7,11,15\\}" :db/ensure [:answer/validate]} {:db/id "answer-3613e1aa-20ff-553e-86bf-6acd4c4e754b" :answer/id #uuid "3613e1aa-20ff-553e-86bf-6acd4c4e754b" :answer/type :answer.type/math :answer/value "\\overset{^}{y}={max}_{y\\in \\{3,7,11,15\\}}g(y)" :db/ensure [:answer/validate]} {:db/id "answer-70459e85-62ef-5e1c-8027-39db3fe41145" :answer/id #uuid "70459e85-62ef-5e1c-8027-39db3fe41145" :answer/type :answer.type/math :answer/value "\\overset{^}{y}={min}_{y\\in \\{3,7,11,15\\}}g(y)" :db/ensure [:answer/validate]} {:db/id "question-00fdbc42-937e-5a35-be79-3ffa566504b0" :question/id #uuid "00fdbc42-937e-5a35-be79-3ffa566504b0" :question/math-academy-id "q-355398" :question/problem "Let $c(n)$ be a cost for option $n,$ where $n\\in \\{3,5,7,9\\}.$ We want to write the optimal option $\\overset{^}{n}$ as \"the value of $n$ that makes $c(n)$ as small as possible.\"\n\nWhich of the following correctly defines $\\overset{^}{n}?$" :question/worked-solution "We want $\\overset{^}{n}$ to be an *input value* $n$ where the cost $c(n)$ is as small as possible. \n\nThat is exactly what $\\operatorname{arg}⁡min$ returns.\nTherefore,\n\n$$\n\\overset{^}{n}=\\operatorname{arg}⁡{min}_{n\\in \\{3,5,7,9\\}}c(n).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-fe7e58b2-6cf5-5dc0-a908-c4dfec9a9926"] :db/ensure [:question/validate]} {:db/id "answer-field-fe7e58b2-6cf5-5dc0-a908-c4dfec9a9926" :answer-field/id #uuid "fe7e58b2-6cf5-5dc0-a908-c4dfec9a9926" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7ed4b9d4-3874-51d6-9f79-7bcc2fe66aae" :answer-field/choices ["answer-6cf15706-6c17-5503-a77a-8bf5a0786d70" "answer-711ef5c5-455c-5d83-901c-33b80c3e7152" "answer-7ed4b9d4-3874-51d6-9f79-7bcc2fe66aae" "answer-0cdf484b-66eb-5a9f-96fb-2be6f97d6737" "answer-1ebe1402-cc23-504b-bb1f-600375c70556"] :db/ensure [:answer-field/validate]} {:db/id "answer-6cf15706-6c17-5503-a77a-8bf5a0786d70" :answer/id #uuid "6cf15706-6c17-5503-a77a-8bf5a0786d70" :answer/type :answer.type/math :answer/value "\\overset{^}{n}=\\operatorname{arg}⁡{max}_{n\\in \\{3,5,7,9\\}}c(n)" :db/ensure [:answer/validate]} {:db/id "answer-711ef5c5-455c-5d83-901c-33b80c3e7152" :answer/id #uuid "711ef5c5-455c-5d83-901c-33b80c3e7152" :answer/type :answer.type/math :answer/value "\\overset{^}{n}=\\operatorname{arg}⁡{max}_{n\\in c(n)}\\{3,5,7,9\\}" :db/ensure [:answer/validate]} {:db/id "answer-7ed4b9d4-3874-51d6-9f79-7bcc2fe66aae" :answer/id #uuid "7ed4b9d4-3874-51d6-9f79-7bcc2fe66aae" :answer/type :answer.type/math :answer/value "\\overset{^}