\\\\ \\operatorname{arg}⁡{max}_{x\\in S}f(x) & =0 \\\\ {min}_{x\\in S}f(x) & =-12 \\\\ \\operatorname{arg}⁡{min}_{x\\in S}f(x) & =-3\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-745e8559-3502-5e71-818c-397d914d5c1c" "answer-field-a9fab6ab-b04b-5532-86d2-6ca6a8c24740" "answer-field-fac1717d-e725-5afe-bfdb-610390f769b2" "answer-field-6da1e1f1-107c-5dd2-8cef-c1812fbbbc7f"] :db/ensure [:question/validate]} {:db/id "answer-field-745e8559-3502-5e71-818c-397d914d5c1c" :answer-field/id #uuid "745e8559-3502-5e71-818c-397d914d5c1c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-14f2b348-b686-5c07-86c7-7171577ae800" :answer-field/choices ["answer-14f2b348-b686-5c07-86c7-7171577ae800"] :db/ensure [:answer-field/validate]} {:db/id "answer-14f2b348-b686-5c07-86c7-7171577ae800" :answer/id #uuid "14f2b348-b686-5c07-86c7-7171577ae800" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "answer-field-a9fab6ab-b04b-5532-86d2-6ca6a8c24740" :answer-field/id #uuid "a9fab6ab-b04b-5532-86d2-6ca6a8c24740" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e2993508-e54a-56f6-ad1c-c746b96acdb7" :answer-field/choices ["answer-e2993508-e54a-56f6-ad1c-c746b96acdb7"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2993508-e54a-56f6-ad1c-c746b96acdb7" :answer/id #uuid "e2993508-e54a-56f6-ad1c-c746b96acdb7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-fac1717d-e725-5afe-bfdb-610390f769b2" :answer-field/id #uuid "fac1717d-e725-5afe-bfdb-610390f769b2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-eae68778-32c0-5284-b397-37c0bd12cb15" :answer-field/choices ["answer-eae68778-32c0-5284-b397-37c0bd12cb15"] :db/ensure [:answer-field/validate]} {:db/id "answer-eae68778-32c0-5284-b397-37c0bd