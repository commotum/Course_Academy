y/easy :question/answer-fields ["answer-field-868907ed-371e-58bf-ba87-262f027567a6"] :db/ensure [:question/validate]} {:db/id "answer-field-868907ed-371e-58bf-ba87-262f027567a6" :answer-field/id #uuid "868907ed-371e-58bf-ba87-262f027567a6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-983dda4e-6514-5175-bc14-90521fd35347" :answer-field/choices ["answer-983dda4e-6514-5175-bc14-90521fd35347"] :db/ensure [:answer-field/validate]} {:db/id "answer-983dda4e-6514-5175-bc14-90521fd35347" :answer/id #uuid "983dda4e-6514-5175-bc14-90521fd35347" :answer/type :answer.type/math :answer/value "x^3+6" :db/ensure [:answer/validate]} {:db/id "question-d3b4690a-a388-56c8-b51f-66b065fce082" :question/id #uuid "d3b4690a-a388-56c8-b51f-66b065fce082" :question/math-academy-id "q-18336" :question/problem "![](images/04/04cb5fcb2ea4013f64d76439a882730455f77908c9e885f52f262efce7bccb58.png)\n\nWhat's the equation of the above curve?" :question/worked-solution "This is the curve $y={x}^{3}$ that's been translated $1$ unit *down*.\n\n![](images/18/1827cffb455aeea03512c208f1cd2914ce669abc62a27dd56cb52c29bf8094c4.png)\n\n  \n\nTherefore, the correct answer is $y={x}^{3}\\,-\\,1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ac670fba-dba7-56ca-886b-c347dd341b10"] :db/ensure [:question/validate]} {:db/id "answer-field-ac670fba-dba7-56ca-886b-c347dd341b10" :answer-field/id #uuid "ac670fba-dba7-56ca-886b-c347dd341b10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84aaa720-7c42-558d-afb2-80d78b9c937b" :answer-field/choices ["answer-02787bb6-13ec-5ee4-8136-0d2743da1062" "answer-49fca1c1-6a50-548c-9dd1-b7e2aa7647f0" "answer-fdf60cbe-5d6b-51c3-92ad-654e5175b298" "answer-1e9cd00e-409e-50b0-8cdc-fad4ad3f0443" "answer-84aaa720-7c42-558d-afb2-80d78b9c937b"] :db/ensure [:answer-field/validate]} {:db/id "answer-02787bb6-13ec-5ee4-8136-0d2743da1062" :answer