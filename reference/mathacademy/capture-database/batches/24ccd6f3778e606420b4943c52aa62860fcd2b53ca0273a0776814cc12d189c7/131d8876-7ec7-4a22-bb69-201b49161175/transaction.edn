^{2})^{2}+{q}^{2}\\cdot 3d+(3d)^{2}) \\\\  & =({q}^{2}-3d)({q}^{4}+3d{q}^{2}+9{d}^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0bf50773-cb5a-5ead-acf4-696f7fdbc82d"] :db/ensure [:question/validate]} {:db/id "answer-field-0bf50773-cb5a-5ead-acf4-696f7fdbc82d" :answer-field/id #uuid "0bf50773-cb5a-5ead-acf4-696f7fdbc82d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5bd39f00-76e2-5b63-9319-2c2b865a5332" :answer-field/choices ["answer-e7745848-fe8b-56b8-85f5-71f52b80e1bf" "answer-e3d60daf-5109-5e14-8dae-ef03258f17e3" "answer-bb780b17-ffd1-53b6-a8c8-ff494ba6cf99" "answer-dc3d9974-95c1-5f13-95a5-908d08c97f9a" "answer-5bd39f00-76e2-5b63-9319-2c2b865a5332"] :db/ensure [:answer-field/validate]} {:db/id "answer-e7745848-fe8b-56b8-85f5-71f52b80e1bf" :answer/id #uuid "e7745848-fe8b-56b8-85f5-71f52b80e1bf" :answer/type :answer.type/math :answer/value "(q+d)({q}^{4}-d{q}^{2}+9{d}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-e3d60daf-5109-5e14-8dae-ef03258f17e3" :answer/id #uuid "e3d60daf-5109-5e14-8dae-ef03258f17e3" :answer/type :answer.type/math :answer/value "(q-3d)({q}^{4}-3d{q}^{2}+3{d}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-bb780b17-ffd1-53b6-a8c8-ff494ba6cf99" :answer/id #uuid "bb780b17-ffd1-53b6-a8c8-ff494ba6cf99" :answer/type :answer.type/math :answer/value "(q-d)({q}^{4}-3d{q}^{2}+9{d}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-dc3d9974-95c1-5f13-95a5-908d08c97f9a" :answer/id #uuid "dc3d9974-95c1-5f13-95a5-908d08c97f9a" :answer/type :answer.type/math :answer/value "({q}^{2}+3d)({q}^{4}+d{q}^{2}+3d)" :db/ensure [:answer/validate]} {:db/id "answer-5bd39f00-76e2-5b63-9319-2c2b865a5332" :answer/id #uuid "5bd39f00-76e2-5b63-9319-2c2b865a5332" :answer/type :answer.type/math :answer/value "({q}^{2}-3d)({q}^{4}+3d{q}^{2}+9{d}^{2})" :db/ensure [:answer/validate]} {:db/id "question-36ce6c6d-22d9-5124-bf0e-5ddb030e27ef" :question/id #uuid "36ce6c6d-22d9-5124-bf0e-5ddb030e27ef" :question/math-academy-id "q-3529" :question/problem "Factor $27{c}^{3}+1.$" :question/worked-solution "The sum of cubes formula is given by\n\n$$\n{a}^{3}+{b}^{3}=(a+b)({a}^{2}-ab+{b}^{2}).\n$$\n\nNotice that we can write our expression as a sum of cubes, as follows:\n\n$$\n27{c}^{3}+1=(3c)^{3}+{1}^{3}\n$$\n\nNow, we factor our expression using the sum of cubes formula:\n\n$$\n\\begin{aligned}27{c}^{3}+1 & =(3c)^{3}+{1}^{3} \\\\  & =(3c+1)((3c)^{2}-3c\\cdot 1+{1}^{2}) \\\\  & =(3c+1)(9{c}^{2}-3c+1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b82f98b3-134a-5016-a690-2444e589ae9f"] :db/ensure [:question/validate]} {:db/id "answer-field-b82f98b3-134a-5016-a690-2444e589ae9f" :answer-field/id #uuid "b82f98b3-134a-5016-a690-2444e589ae9f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab7be4de-9f6f-5921-8366-868072ddb0e3" :answer-field/choices ["answer-b401fc5a-ef1e-5508-b2ca-a12d82139026" "answer-ab7be4de-9f6f-5921-8366-868072ddb0e3" "answer-49da2ae2-c4f6-5cd4-908d-593b0bd93d82" "answer-c8654cba-2f22-5d95-9767-ee02d487e0c0" "answer-5d996585-aedb-5cb1-a731-8c97295471b7"] :db/ensure [:answer-field/validate]} {:db/id "answer-b401fc5a-ef1e-5508-b2ca-a12d82139026" :answer/id #uuid "b401fc5a-ef1e-5508-b2ca-a12d82139026" :answer/type :answer.type/math :answer/value "(3c+1)(3{c}^{2}+3c+1)" :db/ensure [:answer/validate]} {:db/id "answer-ab7be4de-9f6f-5921-8366-868072ddb0e3" :answer/id #uuid "ab7be4de-9f6f-5921-8366-868072ddb0e3" :answer/type :answer.type/math :answer/value "(3c+1)(9{c}^{2}-3c+1)" :db/ensure [:answer/validate]} {:db/id "answer-49da2ae2-c4f6-5cd4-908d-593b0bd93d82" :answer/id #uuid "49da2ae2-c4f6-5cd4-908d-593b0bd93d82" :answer/type :answer.type/math :answer/value "(3c+1)(9{c}^{2}-6c+1)" :db/ensure [:answer/validate]} {:db/id "answer-c8654cba-2f22-5d95-9767-ee02d487e0c0" :answer/id #uuid "c8654cb