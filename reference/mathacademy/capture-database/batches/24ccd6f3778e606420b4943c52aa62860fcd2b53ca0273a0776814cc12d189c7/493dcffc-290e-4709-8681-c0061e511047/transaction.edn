438" "answer-fe51260f-46d8-5ca8-b8f1-da146198de22" "answer-909ad696-6a61-5ef7-b5c2-c1a7a25bf649" "answer-d8213613-42a0-5773-bb7f-75be16e08bec"] :db/ensure [:answer-field/validate]} {:db/id "answer-310ef4de-eb23-5d04-80bc-bd56d0cdf937" :answer/id #uuid "310ef4de-eb23-5d04-80bc-bd56d0cdf937" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ -2 \\\\ 3 \\\\ 4 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-9d7b107e-1406-566b-abbc-1f4b398b1438" :answer/id #uuid "9d7b107e-1406-566b-abbc-1f4b398b1438" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-4 \\\\ -8 \\\\ 12 \\\\ 16 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-fe51260f-46d8-5ca8-b8f1-da146198de22" :answer/id #uuid "fe51260f-46d8-5ca8-b8f1-da146198de22" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 3 \\\\ -4 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-909ad696-6a61-5ef7-b5c2-c1a7a25bf649" :answer/id #uuid "909ad696-6a61-5ef7-b5c2-c1a7a25bf649" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ -3 \\\\ -4 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-d8213613-42a0-5773-bb7f-75be16e08bec" :answer/id #uuid "d8213613-42a0-5773-bb7f-75be16e08bec" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 \\\\ 8 \\\\ -12 \\\\ -16 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-34bb1a50-1857-5b83-b60b-483ccca13301" :question/id #uuid "34bb1a50-1857-5b83-b60b-483ccca13301" :question/math-academy-id "q-105094" :question/problem "Let $a=[\\begin{aligned}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{aligned}].$ Find $2a.$" :question/worked-solution "Multiplying each component of $a$ by $2,$ we get\n\n$$\n\\begin{aligned}2a & =2[\\begin{aligned}-7 \\\\ 2 \\\\ 2 \\\\ -3 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (-7) \\\\ 2\\cdot 2 \\\\ 2\\cdot 2 \\\\ 2\\cdot (-3) \\\\ 2\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}-14 \\\\ 4 \\\\ 4 \\\\ -6 \\\\ 12\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-28f47cec-9de4-5246-8252-aa339c84f9fe"] :db/ensure [:question/validate]} {:db/id "answer-field-28f47cec-9de4-5246-8252-aa339c84f9fe" :answer-field/id #uuid "28f47cec-9de4-5246-8252-aa339c84f9fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1772239e-41ef-5636-b217-2e55d9d689ba" :answer-field/choices ["answer-ab711d0b-2ed8-5531-a45c-f1e9cf625329" "answer-1772239e-41ef-5636-b217-2e55d9d689ba" "answer-0af075c6-816b-5030-aec2-5a8592e9c4b7" "answer-e904fb43-dd3b-5d20-a22e-d3816222b8a0" "answer-f41bda34-81df-5737-b9a6-fdcf9e4d8d1f"] :db/ensure [:answer-field/validate]} {:db/id "answer-ab711d0b-2ed8-5531-a45c-f1e9cf625329" :answer/id #uuid "ab711d0b-2ed8-5531-a45c-f1e9cf625329" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-14 \\\\ 1 \\\\ 4 \\\\ -3 \\\\ 12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-1772239e-41ef-5636-b217-2e55d9d689ba" :answer/id #uuid "1772239e-41ef-5636-b217-2e55d9d689ba" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-14 \\\\ 4 \\\\ 4 \\\\ -6 \\\\ 12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-0af075c6-816b-5030-aec2-5a8592e9c4b7" :answer/id #uuid "0af075c6-816b-5030-aec2-5a8592e9c4b7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 \\\\ 1 \\\\ 1 \\\\ -6 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-e904fb43-dd3b-5d20-a22e-d3816222b8a0" :answer/id #uuid "e904fb43-dd3b-5d20-a22e-d3816222b8a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 \\\\ 4 \\\\ 4 \\\\ -1 \\\\ 8\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-f41bda34-81df-5737-b9a6-fdcf9e4d8d1f" :answer/id #uuid "f41bda34-81df-5737-b9a6-fdcf9e4d8d1f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-7 \\\\ 1 \\\\ 1 \\\\ -3 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-ceec6370-9876-5337-a51f-c0a5305aac98" :question/id #uuid "ceec6370-9876-5337-a51f-c0a5305aac98" :question/math-academy-id "q-105096" :question/problem "Let $c=[\\begin{aligned}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{aligned}].$ Find $\\frac{1}{4}c.$" :question/worked-solution "Multiplying each component of $c$ by $\\frac{1}{4},$ we get\n\n$$\n\\begin{aligned}\\frac{1}{4}c & =\\frac{1}{4}[\\begin{aligned}4 \\\\ 20 \\\\ -4 \\\\ -8 \\\\ 7\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{4}\\cdot 4 \\\\ \\frac{1}{4}\\cdot 20 \\\\ \\frac{1}{4}\\cdot (-4) \\\\ \\frac{1}{4}\\cdot (-8) \\\\ \\frac{1}{4}\\cdot 7\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-360b9fe1-9be0-5829-b7cd-57e2970bd9d7"] :db/ensure [:question/validate]} {:db/id "answer-field-360b9fe1-9be0-5829-b7cd-57e2970bd9d7" :answer-field/id #uuid "360b9fe1-9be0-5829-b7cd-57e2970bd9d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b019efb6-b916-50ad-aaf8-52d4c8ee6f59" :answer-field/choices ["answer-85018547-f459-5314-95f3-408a73004778" "answer-b019efb6-b916-50ad-aaf8-52d4c8ee6f59" "answer-d10ec09d-e685-5785-9818-6e5d4852a901" "answer-9b039e4d-192d-5c02-88f8-0c63bb86dc7b" "answer-a30a6cf6-303c-5440-8970-2afb4640b719"] :db/ensure [:answer-field/validate]} {:db/id "answer-85018547-f459-5314-95f3-408a73004778" :answer/id #uuid "85018547-f459-5314-95f3-408a73004778" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ 7\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-b019efb6-b916-50ad-aaf8-52d4c8ee6f59" :answer/id #uuid "b019efb6-b916-50ad-aaf8-52d4c8ee6f59" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 5 \\\\ -1 \\\\ -2 \\\\ \\frac{7}{4}\\end{aligned