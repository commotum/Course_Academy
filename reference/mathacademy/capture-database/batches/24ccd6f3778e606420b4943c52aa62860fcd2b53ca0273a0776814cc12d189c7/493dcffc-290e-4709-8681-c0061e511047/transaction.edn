 :answer/id #uuid "28af8068-389d-58ea-af5e-aa10b40c5b88" :answer/type :answer.type/text :answer/value "True" :db/ensure [:answer/validate]} {:db/id "question-0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/id #uuid "0f8c15c2-cbc4-5d0f-bd4c-5f44e2f7b150" :question/math-academy-id "q-174324" :question/problem "Which of the following statements are true?\n\n- $P:$ A square has exactly four sides.\n\n- $Q:$ $7+2\\ge 10$\n\n- $R:$ $9$ is a prime number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's evaluate the truth value of each statement:\n\n- Statement $P$ is *true.* Indeed, A square has exactly four sides.\n\n- Statement $Q$ is *false* because $7+2=9≱10.$\n\n- Statement $R$ is *false* because $9$ is not a prime number (it is a composite number).\n\nTherefore, the correct answer is \"$P$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7"] :db/ensure [:question/validate]} {:db/id "answer-field-2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/id #uuid "2855aecd-cdcb-5b2b-9367-17297e8e7af7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer-field/choices ["answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" "answer-2c84984b-426d-55e9-965e-6859fe00462e" "answer-262c834d-68ad-51fd-b503-042b9d04a191" "answer-d7ef0b8f-578e-52f9-a537-71e171a1897b" "answer-1c28ed79-d73d-5ea6-bdb8-34895002fb98"] :db/ensure [:answer-field/validate]} {:db/id "answer-e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/id #uuid "e896aaa9-bb20-52d4-a2ad-2609106f4753" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "answer-2c84984b-426d-55e9-965e-6859fe00462e" :answer/id #uuid "2c84984b-426d-55e9-965e-6859fe00462e" :answer/type :answer.type/text :answer/value "$P$ only" :db