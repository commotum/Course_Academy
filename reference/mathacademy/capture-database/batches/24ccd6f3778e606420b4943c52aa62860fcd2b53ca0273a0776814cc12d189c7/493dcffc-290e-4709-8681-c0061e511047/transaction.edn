uestion/validate]} {:db/id 17592186145256 :answer-field/correct 17592186145257 :db/ensure [:answer-field/validate]} {:db/id "question-45ea6d18-f63f-5746-8a3b-c9999a01036d" :question/id #uuid "45ea6d18-f63f-5746-8a3b-c9999a01036d" :question/math-academy-id "q-117723" :question/problem "![](images/1e/1e6e5574bf3b15bd9d0c7592c24f20de7fae4d9d8110763383d7febb5582d166.png)\n\nHow many faces does the rectangular prism shown above have?" :question/worked-solution "The rectangular prism has $6$ rectangular faces in total." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5ff1b723-0fd2-5e4b-a030-e7c787fb64b2"] :db/ensure [:question/validate]} {:db/id "answer-field-5ff1b723-0fd2-5e4b-a030-e7c787fb64b2" :answer-field/id #uuid "5ff1b723-0fd2-5e4b-a030-e7c787fb64b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9bfbbcbb-ddf4-5228-96ed-d3405fd7ec2f" :answer-field/choices ["answer-b996fcf6-5b39-5732-8f71-393da7d53ef9" "answer-2e1346ca-d328-5581-8ddd-381cbfe55a1a" "answer-9bfbbcbb-ddf4-5228-96ed-d3405fd7ec2f" "answer-b1d6c8d0-56a9-5622-9f04-bf3e16a45730" "answer-65db7672-61c0-5d9c-b94d-7e68b0c1cf0b"] :db/ensure [:answer-field/validate]} {:db/id "answer-b996fcf6-5b39-5732-8f71-393da7d53ef9" :answer/id #uuid "b996fcf6-5b39-5732-8f71-393da7d53ef9" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "answer-2e1346ca-d328-5581-8ddd-381cbfe55a1a" :answer/id #uuid "2e1346ca-d328-5581-8ddd-381cbfe55a1a" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-9bfbbcbb-ddf4-5228-96ed-d3405fd7ec2f" :answer/id #uuid "9bfbbcbb-ddf4-5228-96ed-d3405fd7ec2f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-b1d6c8d0-56a9-5622-9f04-bf3e16a45730" :answer/id #uuid "b1d6c8d0-56a9-5622-9f04-bf3e16a45730" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-65db7672-61c0-5d9c-b94d-7e68b0c1cf0b" :answer/id #uuid "65db7672-61c0-5d9c-b94d-7e68b0c1cf0b" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-ae8fc30f-28c7-5b20-9ff5-bcddd8703aac" :question/id #uuid "ae8fc30f-28c7-5b20-9ff5-bcddd8703aac" :question/math-academy-id "q-61801" :question/problem "![](images/a9/a9ed0df71b7e3948f6cd37610b1a0d09bf6efcc4561aa0b028a1e48ca8fc7a0a.png)\n\nHow many vertices does the hexagonal prism shown above have?" :question/worked-solution "The vertices of a polyhedron are the corners where edges meet.\n\nThe rectangular prism has $12$ vertices in total, as shown below. \n\n![](images/64/640e513f88583e384d7bd38add70f8df25042db1b1dcc14184d89cb02bc811c3.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c26768ee-ecf5-5e2c-ab17-513629d7877f"] :db/ensure [:question/validate]} {:db/id "answer-field-c26768ee-ecf5-5e2c-ab17-513629d7877f" :answer-field/id #uuid "c26768ee-ecf5-5e2c-ab17-513629d7877f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8ed1eb9-4b26-547f-b259-daf6da7c0567" :answer-field/choices ["answer-c8ed1eb9-4b26-547f-b259-daf6da7c0567" "answer-f3d65ab6-9aa6-5537-9b71-f03b6f89cadd" "answer-578f029b-ea14-5d71-a459-d22f6434f4d0" "answer-f38bd1a6-b85a-5f1f-a4f0-3e9ab2f4d19c" "answer-309c112d-3a7f-5d7e-ae36-748bd1191d13"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8ed1eb9-4b26-547f-b259-daf6da7c0567" :answer/id #uuid "c8ed1eb9-4b26-547f-b259-daf6da7c0567" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-f3d65ab6-9aa6-5537-9b71-f03b6f89cadd" :answer/id #uuid "f3d65ab6-9aa6-5537-9b71-f03b6f89cadd" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-578f029b-ea14-5d71-a459-d22f6434f4d0" :answer/id #uuid "578f029b-ea14-5d71-a459-d22f6434f4d0" :answer/type :answer.type/math :answer/va