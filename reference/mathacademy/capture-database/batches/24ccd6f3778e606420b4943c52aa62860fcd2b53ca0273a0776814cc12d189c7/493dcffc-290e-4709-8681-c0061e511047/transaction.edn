ield/choices 17592186337698] [:db/retract 17592186338495 :answer-field/choices 17592186337476] [:db/retract 17592186338495 :answer-field/choices 17592186337416] [:db/retract 17592186338495 :answer-field/choices 17592186337337] [:db/retract 17592186338495 :answer-field/choices 17592186336555] {:db/id 17592186124465 :knowledge-point/questions ["question-6a7e0438-dfaf-58ac-9ade-c318de994348" "question-93b5347d-fa82-5e5e-b9aa-42f525c17d43"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124557 :knowledge-point/questions ["question-88858de7-2fd7-5431-aec4-cee489f567e8"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124466 :knowledge-point/questions ["question-1ddf04e4-d463-5268-9d26-58b4ea7da263" "question-73a5b476-e534-54e3-9da7-2de0545b138d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186382186 :question/worked-solution "First, notice that $f(x,y)$ is defined only when \n\n$$\n\\begin{aligned}x+y & \\ge 0\\,\\text{and}\\,y\\ne 0.\\end{aligned}\n$$\n\nSo, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y\\ge 0\\}.\n$$\n\nNow, we compute the partial derivative of $f(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{\\sqrt{x+y}}{y}) \\\\  & =\\frac{y\\cdot \\frac{1}{2\\sqrt{x+y}}-\\sqrt{x+y}}{{y}^{2}} \\\\  & =\\frac{y-2x-2y}{2{y}^{2}\\sqrt{x+y}} \\\\  & =\\frac{-2x-y}{2{y}^{2}\\sqrt{x+y}}\\end{aligned}\n$$\n\nThe function ${f}_{y}(x,y)$ is defined only for \n\n$$\n\\begin{aligned}y\\ne 0\\,\\text{and}\\,x+y>0.\\end{aligned}\n$$\n\n So, the domain of ${f}_{y}$ is\n\n$$\n{D}_{{f}_{y}}=\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y>0\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $y$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{y}} & =\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y\\ge 0\\}\\cap \\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y>0\\} \\\\  & =\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y>0\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186382187 :answer-field/correct "answer-b0492aba-dbff-56e3-abcb-5c0c52db1196" :answer-field/choices ["answer-7be4488a-cd3f-50bb-9afc-fa094c75e607" "answer-b0492aba-dbff-56e3-abcb-5c0c52db1196" "answer-3a8771b6-55f7-537e-b0a2-1396634fe7c3" "answer-18320f2a-b614-5878-a30c-a6927276e203"] :db/ensure [:answer-field/validate]} {:db/id "answer-7be4488a-cd3f-50bb-9afc-fa094c75e607" :answer/id #uuid "7be4488a-cd3f-50bb-9afc-fa094c75e607" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,x+y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-b0492aba-dbff-56e3-abcb-5c0c52db1196" :answer/id #uuid "b0492aba-dbff-56e3-abcb-5c0c52db1196" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-3a8771b6-55f7-537e-b0a2-1396634fe7c3" :answer/id #uuid "3a8771b6-55f7-537e-b0a2-1396634fe7c3" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x+y\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-18320f2a-b614-5878-a30c-a6927276e203" :answer/id #uuid "18320f2a-b614-5878-a30c-a6927276e203" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ne 0\\,\\text{and}\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "question-6a7e0438-dfaf-58ac-9ade-c318de994348" :question/id #uuid "6a7e0438-dfaf-58ac-9ade-c318de994348" :question/math-academy-id "q-132637" :question/problem "Given that $f(x,y,z)=\\frac{x}{y+z},$ find the set of values $(x,y,z)$ on which $\\frac{∂f}{∂y}$ exists." :question/worked-solution "First, notice that $f(x,y,z)$ is defined only when $y+z\\ne 0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y,z)\\,:\\,y+z\\ne 0\\}.\n$$\n\nNow, we compute the partial derivative of $f(x,y,z)$ with respect to $z:$\n\n$$\n\\begin{aligned}{f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\frac{x}{y+z}) \\\\  & =-\\frac{x}{(y+z)^{2}}\\end{aligned}\n$$\n\nThe function ${f}_{y}(x,y,z)$ is defined only for \n\n$$\n\\begin{aligned}(y+z)^{2} & \\ne 0 \\\\ y+z & \\ne 0.\\end{aligned}\n$$\n\nSo, the domain of ${f}_{y}$ is\n\n$$\n{D}_{{f}_{y}}=\\{(x,y,z)\\,:\\,y+z\\ne 0\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $y$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{y}} & =\\{(x,y,z)\\,:\\,y+z\\ne 0\\}\\cap \\{(x,y,z)\\,:\\,y+z\\ne 0\\} \\\\  & =\\{(x,y,z)\\,:\\,y+z\\ne 0\\}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-115a4c5e-8438-57e0-8218-a23a116369b2"] :db/ensure [:question/validate]} {:db/id "answer-field-115a4c5e-8438-57e0-8218-a23a116369b2" :answer-field/id #uuid "115a4c5e-8438-57e0-8218-a23a116369b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-93c1ef46-0b11-5266-8f41-56facaa40905" :answer-field/choices ["answer-bdb1c6fb-2082-5cdc-b6d2-731c9c2a61b8" "answer-365f8bbd-ce03-569d-aa3f-4ca177bcd8ce" "answer-7240289b-9821-502d-a55b-8731f37e7d59" "answer-3d2420ba-4165-5c8f-9927-4bbc2b816817" "answer-93c1ef46-0b11-5266-8f41-56facaa40905"] :db/ensure [:answer-field/validate]} {:db/id "answer-bdb1c6fb-2082-5cdc-b6d2-731c9c2a61b8" :answer/id #uuid "bdb1c6fb-2082-5cdc-b6d2-731c9c2a61b8" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,y+z<0\\}" :db/ensure [:answer/validate]} {:db/id "answer-365f8bbd-ce03-569d-aa3f-4ca177bcd8ce" :answer/id #uuid "365f8bbd-ce03-569d-aa3f-4ca177bcd8ce" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,y+z>0\\,\\text{and}\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-7240289b-9821-502d-a55b-8731f37e7d59" :answer/id #uuid "7240289b-9821-502d-a55b-8731f37e7d59" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,y+z>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-3d2420ba-4165-5c8f-9927-4bbc2b816817" :answer/id #uuid "3d2420ba-4165-5c8f-9927-4bbc2b816817" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,y+z\\ne 0\\,\\text{and}\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-93c1ef46-0b11-5266-8f41-56facaa40905" :answer/id #uuid "93c1ef46-0b11-5266-8f41-56facaa40905" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,y+z\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "question-93b5347d-fa82-5e5e-b9aa-42f525c17d43" :question/id #uuid "93b5347d-fa82-5e5e-b9aa-42f525c17d43" :question/math-academy-id "q-36525" :question/problem "Given that $f(x,y)=\\frac{1}{\\sqrt{y-{x}^{2}}},$ find the set of values $(x,y)$ on which $\\frac{∂f}{∂x}$ exists." :question/worked-solution "First, notice that $f(x,y)$ is defined only when \n\n$$\n\\begin{aligned}y-{x}^{2} & >0 \\\\ y & >{x}^{2}.\\end{aligned}\n$$\n\nSo, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,y>{x}^{2}\\}.\n$$\n\nNow, we compute the partial derivative of $f(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{1}{\\sqrt{y-{x}^{2}}}) \\\\  & =-\\frac{-2x}{2(y-{x}^{2})^{3/2}} \\\\  & =\\frac{x}{(y-{x}^{2})^{3/2}}\\end{aligned}\n$$\n\nThe function ${f}_{x}(x,y)$ is defined only for \n\n$$\n\\begin{aligned}y-{x}^{2} & >0 \\\\ y & >{x}^{2}.\\end{aligned}\n$$\n\nSo, the domain of ${f}_{x}$ is\n\n$$\n{D}_{{f}_{x}}=\\{(x,y)\\,:\\,y>{x}^{2}\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $x$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}} & =\\{(x,y)\\,:\\,y>{x}^{2}\\}\\cap \\{(x,y)\\,:\\,y>{x}^{2}\\} \\\\  & =\\{(x,y)\\,:\\,y>{x}^{2}\\}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d731db7f-90f6-50ca-af14-f65d325828c8"] :db/ensure [:question/validate]} {:db/id "answer-field-d731db7f-90f6-50ca-af14-f65d325828c8" :answer-field/id #uuid "d731db7f-90f6-50ca-af14-f65d325828c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-14b28e62-5e5c-5fa4-828d-8176c468f073" :answer-field/choices ["answer-14b28e62-5e5c-5fa4-828d-8176c468f073" "answer-f1bbb24c-f728-542a-b6fd-83644bef18b4" "answer-94fa791e-d489-52b8-9318-5172cd32b632" "answer-f3c96cca-e498-5185-8483-99a97501e744" "answer-ac2ab564-0469-5d5f-bd5b-92ae71f9cfcb"] :db/ensure [:answer-field/validate]} {:db/id "answer-14b28e62-5e5c-5fa4-828d-8176c468f073" :answer/id #uuid "14b28e62-5e5c-5fa4-828d-8176c468f073" :answer/type :answer.type/math :answer/value "\\{(x,y):y>{x}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-f1bbb24c-f728-542a-b6fd-83644bef18b4" :answer/id #uuid "f1bbb24c-f728-542a-b6fd-83644bef18b4" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y<{x}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-94fa791e-d489-52b8-9318-5172cd32b632" :answer/id #uuid "94fa791e-d489-52b8-9318-5172cd32b632" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\ge {x}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-f3c96cca-e498-5185-8483-99a97501e744" :answer/id #uuid "f3c96cca-e498-5185-8483-99a97501e744" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,y\\le {x}^{2}\\}" :db/ensure [:answer/validate]} {:db/id "answer-ac2ab564-0469-5d5f-bd5b-92ae71f9cfcb" :answer/id #uuid "ac2ab564-0469-5d5f-bd5b-92ae71f9cfcb" :answer/type :answer.type/text :answer/value "${f}_{x}$ exists everywhere on the $xy$-plane" :db/ensure [:answer/validate]} {:db/id 17592186382200 :question/worked-solution "First, notice that $f(x,y)$ is defined when $-1\\le xy\\le 1.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y)\\,:\\,-1\\le xy\\le 1\\}.\n$$\n\nNow, we compute the partial derivatives of $f(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{arcsin}⁡(xy)) \\\\  & =\\frac{1}{\\sqrt{1-(xy)^{2}}}\\cdot x \\\\  & =\\frac{x}{\\sqrt{1-{x}^{2}{y}^{2}}}\\end{aligned}\n$$\n\nThe function ${f}_{y}(x,y)$ is defined only for \n\n$$\n\\begin{aligned}1-{x}^{2}{y}^{2} & >0 \\\\ {x}^{2}{y}^{2} & <1 \\\\ -1<xy & <1.\\end{aligned}\n$$\n\n So, the domain of ${f}_{y}$ is\n\n$$\n{D}_{{f}_{y}}=\\{(x,y)\\,:\\,-1<xy<1\\}.\n$$\n\nFinally, we conclude that the partial derivative of $f$ with respect to $y$ exists on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{y}} & =\\{(x,y)\\,:\\,-1\\le xy\\le 1\\}\\cap \\{(x,y)\\,:\\,-1<xy<1\\} \\\\  & =\\{(x,y)\\,:\\,-1<xy<1\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186382201 :answer-field/correct "answer-e48eb178-d3ae-5b7a-9e32-6647d4f89008" :answer-field/choices ["answer-e48eb178-d3ae-5b7a-9e32-6647d4f89008" "answer-564c0717-2ab8-59c0-a054-e88b4b250ec9" "answer-6e63fc50-7cc5-5095-bd95-f14db7b98d09" "answer-79221a8e-d0bd-56c1-92e8-362d0c95c652" "answer-856a2403-496c-5b21-9944-c9e1b1c13646"] :db/ensure [:answer-field/validate]} {:db/id "answer-e48eb178-d3ae-5b7a-9e32-6647d4f89008" :answer/id #uuid "e48eb178-d3ae-5b7a-9e32-6647d4f89008" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,-1<xy<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-564c0717-2ab8-59c0-a054-e88b4b250ec9" :answer/id #uuid "564c0717-2ab8-59c0-a054-e88b4b250ec9" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,-1\\le xy\\le 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-6e63fc50-7cc5-5095-bd95-f14db7b98d09" :answer/id #uuid "6e63fc50-7cc5-5095-bd95-f14db7b98d09" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,xy<1\\}" :db/ensure [:answer/validate]} {:db/id "answer-79221a8e-d0bd-56c1-92e8-362d0c95c652" :answer/id #uuid "79221a8e-d0bd-56c1-92e8-362d0c95c652" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,xy>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-856a2403-496c-5b21-9944-c9e1b1c13646" :answer/id #uuid "856a2403-496c-5b21-9944-c9e1b1c13646" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,xy\\ne 1\\}" :db/ensure [:answer/validate]} {:db/id 17592186339046 :question/worked-solution "First, notice that $f(x,y,z)=\\operatorname{arctan}⁡(x+y+z)$ is defined for any $x$, $y$, and $z.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${f}_{x}=\\frac{1}{1+(x+y+z)^{2}}$ is defined for any $x$, $y$, and $z.$ So, the domain of ${f}_{x}$ is \n\n$$\n{D}_{{f}_{x}}=\\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\}.\n$$\n\n- Similarly, the domains of ${f}_{y}$ and ${f}_{z}$ are\n\n$$\n{D}_{{f}_{y}}={D}_{{f}_{z}}=\\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\}.\n$$\n\nTherefore, we conclude that the partial derivatives of $f$ exist on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}}\\cap {D}_{{f}_{y}}\\cap {D}_{{f}_{z}} & ={D}_{f}\\cap {D}_{{f}_{x}} \\\\  & =\\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\}\\cap \\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\} \\\\  & =\\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186338583 :answer-field/correct "answer-56dbc98e-986f-5c73-aa5f-cac881ecfa04" :answer-field/choices ["answer-d0ae369d-fbce-5a92-b83c-fdb84536b23d" "answer-c7f3adcf-6cdf-592b-b898-6f8526012b19" "answer-cdbf817f-a650-51de-829b-812fa24d59e2" "answer-42768df1-45c5-5a14-8236-adb8b26820e4" "answer-56dbc98e-986f-5c73-aa5f-cac881ecfa04"] :db/ensure [:answer-field/validate]} {:db/id "answer-d0ae369d-fbce-5a92-b83c-fdb84536b23d" :answer/id #uuid "d0ae369d-fbce-5a92-b83c-fdb84536b23d" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,(x+y+z)^{2}>1\\}" :db/ensure [:answer/validate]} {:db/id "answer-c7f3adcf-6cdf-592b-b898-6f8526012b19" :answer/id #uuid "c7f3adcf-6cdf-592b-b898-6f8526012b19" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,x+y+z>-1\\}" :db/ensure [:answer/validate]} {:db/id "answer-cdbf817f-a650-51de-829b-812fa24d59e2" :answer/id #uuid "cdbf817f-a650-51de-829b-812fa24d59e2" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,x+y+z\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-42768df1-45c5-5a14-8236-adb8b26820e4" :answer/id #uuid "42768df1-45c5-5a14-8236-adb8b26820e4" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,x+y+z\\ne 1\\}" :db/ensure [:answer/validate]} {:db/id "answer-56dbc98e-986f-5c73-aa5f-cac881ecfa04" :answer/id #uuid "56dbc98e-986f-5c73-aa5f-cac881ecfa04" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,x,y,z\\in (-\\infty ,\\infty )\\}" :db/ensure [:answer/validate]} {:db/id "question-88858de7-2fd7-5431-aec4-cee489f567e8" :question/id #uuid "88858de7-2fd7-5431-aec4-cee489f567e8" :question/math-academy-id "q-72028" :question/problem "Given that $h(x,y,z)=\\operatorname{ln}⁡(\\frac{xz}{{y}^{2}})$ and\n\n$$\n\\frac{∂h}{∂x}=\\frac{1}{x},\\,\\frac{∂h}{∂y}=-\\frac{2}{y},\\,\\frac{∂h}{∂z}=\\frac{1}{z},\n$$\n\nfind the set of values $(x,y,z)$ on which all partial derivatives of $h$ exist." :question/worked-solution "First, notice that $h(x,y,z)=\\operatorname{ln}⁡(\\frac{xz}{{y}^{2}})$ is defined only when $xz>0$ and $y\\ne 0.$ So, the domain of $h$ is \n\n$$\n{D}_{h}=\\{(x,y,z)\\,:\\,xz>0\\,\\text{and}\\,y\\ne 0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${h}_{x}=\\frac{1}{x}$ is defined only when $x\\ne 0.$ So, the domain of ${h}_{x}$ is \n\n$$\n{D}_{{h}_{x}}=\\{(x,y,z)\\,:\\,x\\ne 0\\}.\n$$\n\n- The function ${h}_{y}=-\\frac{2}{y}$ is defined only when $y\\ne 0.$ So, the domain of ${h}_{y}$ is \n\n$$\n{D}_{{h}_{y}}=\\{(x,y,z)\\,:\\,y\\ne 0\\}.\n$$\n\n- The function ${h}_{z}=\\frac{1}{z}$ is defined only when $z\\ne 0.$ So, the domain of ${h}_{z}$ is\n\n$$\n{D}_{{h}_{z}}=\\{(x,y,z)\\,:\\,z\\ne 0\\}.\n$$\n\nFinally, we conclude that the partials of $h$ exist on the set\n\n$$\n\\begin{aligned}{D}_{h}\\cap {D}_{{h}_{x}}\\cap {D}_{{h}_{y}}\\cap {D}_{{h}_{z}} & =\\{(x,y,z)\\,:\\,xz>0\\,\\text{and}\\,y\\ne 0\\}\\cap \\{(x,y,z)\\,:\\,x\\ne 0\\} \\\\  & \\,\\,\\,\\,\\,\\cap \\,\\{(x,y,z)\\,:\\,y\\ne 0\\}\\cap \\{(x,y,z)\\,:\\,z\\ne 0\\} \\\\  & =\\{(x,y,z)\\,:\\,xz>0\\,\\text{and}\\,y\\ne 0\\}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-13e96fd7-067f-5c7e-8c81-eec0b11e5b02"] :db/ensure [:question/validate]} {:db/id "answer-field-13e96fd7-067f-5c7e-8c81-eec0b11e5b02" :answer-field/id #uuid "13e96fd7-067f-5c7e-8c81-eec0b11e5b02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c9035321-67de-5d87-8802-b231710205c2" :answer-field/choices ["answer-c9035321-67de-5d87-8802-b231710205c2" "answer-6ae0216e-3dda-5b86-bf9a-7a2f1941c30d" "answer-928531e1-339e-5d41-9d09-292c01dfe676" "answer-a464505c-7c18-5824-af43-db6d78d3830b" "answer-2ec0f707-e54c-51dd-acbe-ce56f922c04b"] :db/ensure [:answer-field/validate]} {:db/id "answer-c9035321-67de-5d87-8802-b231710205c2" :answer/id #uuid "c9035321-67de-5d87-8802-b231710205c2" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,xz>0\\,\\text{and}\\,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-6ae0216e-3dda-5b86-bf9a-7a2f1941c30d" :answer/id #uuid "6ae0216e-3dda-5b86-bf9a-7a2f1941c30d" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,xz\\ge 0\\,\\text{and}\\,x\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-928531e1-339e-5d41-9d09-292c01dfe676" :answer/id #uuid "928531e1-339e-5d41-9d09-292c01dfe676" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,xz\\le 0\\,\\text{and}\\,y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-a464505c-7c18-5824-af43-db6d78d3830b" :answer/id #uuid "a464505c-7c18-5824-af43-db6d78d3830b" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-2ec0f707-e54c-51dd-acbe-ce56f922c04b" :answer/id #uuid "2ec0f707-e54c-51dd-acbe-ce56f922c04b" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,z\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id 17592186339047 :question/worked-solution "First, notice that $f(x,y,z)=\\frac{z}{\\sqrt{1+y-{x}^{2}}}$ is defined only when $1+y-{x}^{2}>0.$ So, the domain of $f$ is \n\n$$\n{D}_{f}=\\{(x,y,z)\\,:\\,{x}^{2}<y+1\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${f}_{x}=\\frac{xz}{\\sqrt{(1+y-{x}^{2})^{3}}}$ is defined only when $1+y-{x}^{2}>0.$ So, the domain of ${f}_{x}$ is \n\n$$\n{D}_{{f}_{x}}=\\{(x,y,z)\\,:\\,{x}^{2}<y+1\\}.\n$$\n\n- Similarly, the domain of ${f}_{y}$ and ${f}_{z}$ are the same\n\n$$\n{D}_{{f}_{y}}={D}_{{f}_{z}}=\\{(x,y,z)\\,:\\,{x}^{2}<y+1\\}.\n$$\n\nFinally, we conclude that the partials of $f$ exist on the set\n\n$$\n\\begin{aligned}{D}_{f}\\cap {D}_{{f}_{x}}\\cap {D}_{{f}_{y}}\\cap {D}_{{f}_{z}} & ={D}_{f}\\cap {D}_{{f}_{x}} \\\\  & =\\{(x,y,z)\\,:\\,{x}^{2}<y+1\\}\\cap \\{(x,y,z)\\,:\\,{x}^{2}<y+1\\} \\\\  & =\\{(x,y,z)\\,:\\,{x}^{2}<y+1\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186338720 :answer-field/correct "answer-58af975c-c2a1-526c-8913-b54cae912604" :answer-field/choices ["answer-58af975c-c2a1-526c-8913-b54cae912604" "answer-8325a7fb-2d1d-57b2-90c3-eb44f3fb67db" "answer-41ff0dd7-d72c-5277-8d4d-17134cb43aa4" "answer-fcadf2f9-91d3-553d-9019-a4aa4c81b373" "answer-6c293847-d86d-5648-bc3a-b4c65524ca2d"] :db/ensure [:answer-field/validate]} {:db/id "answer-58af975c-c2a1-526c-8913-b54cae912604" :answer/id #uuid "58af975c-c2a1-526c-8913-b54cae912604" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,{x}^{2}<y+1\\}" :db/ensure [:answer/validate]} {:db/id "answer-8325a7fb-2d1d-57b2-90c3-eb44f3fb67db" :answer/id #uuid "8325a7fb-2d1d-57b2-90c3-eb44f3fb67db" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,{x}^{2}>y+1\\}" :db/ensure [:answer/validate]} {:db/id "answer-41ff0dd7-d72c-5277-8d4d-17134cb43aa4" :answer/id #uuid "41ff0dd7-d72c-5277-8d4d-17134cb43aa4" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,{x}^{2}\\ge y+1\\}" :db/ensure [:answer/validate]} {:db/id "answer-fcadf2f9-91d3-553d-9019-a4aa4c81b373" :answer/id #uuid "fcadf2f9-91d3-553d-9019-a4aa4c81b373" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,{x}^{2}\\le y+1\\}" :db/ensure [:answer/validate]} {:db/id "answer-6c293847-d86d-5648-bc3a-b4c65524ca2d" :answer/id #uuid "6c293847-d86d-5648-bc3a-b4c65524ca2d" :answer/type :answer.type/math :answer/value "\\{(x,y,z)\\,:\\,{x}^{2}\\ne y+1\\}" :db/ensure [:answer/validate]} {:db/id 17592186339043 :question/worked-solution "First, notice that $g(x,y)=x\\operatorname{ln}⁡({x}^{2}+{y}^{2})$ is defined only when ${x}^{2}+{y}^{2}>0.$ So, the domain of $g$ is \n\n$$\n{D}_{g}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${g}_{x}(x,y)=\\frac{2{x}^{2}}{{x}^{2}+{y}^{2}}+\\operatorname{ln}⁡({x}^{2}+{y}^{2})$ is defined only when ${x}^{2}+{y}^{2}>0.$ So, the domain of ${g}_{x}$ is \n\n$$\n{D}_{{g}_{x}}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>0\\}.\n$$\n\n- The function ${g}_{y}(x,y)=\\frac{2xy}{{x}^{2}+{y}^{2}}$ is defined only when ${x}^{2}+{y}^{2}\\ne 0.$ So, the domain of ${g}_{y}$ is \n\n$$\n{D}_{{g}_{y}}=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ne 0\\}.\n$$\n\nFinally, we conclude that the partials of $g$ exist on the set\n\n$$\n\\begin{aligned}{D}_{g}\\cap {D}_{{g}_{x}}\\cap {D}_{{g}_{y}} & =\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>0\\}\\cap \\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>0\\}\\cap \\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>0\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186338315 :answer-field/correct "answer-3d4cb978-08f2-56c9-a2ea-886a3b926325" :answer-field/choices ["answer-783fd4c1-fb89-5517-bc35-b883098e9f40" "answer-6e834be1-c403-5b49-87e3-229d8e48f719" "answer-3d4cb978-08f2-56c9-a2ea-886a3b926325" "answer-e4c394bb-40ee-5d34-8bd0-d21a98e21ea0" "answer-00e7e3fe-8aa5-5dbe-b351-f8ab041da26a"] :db/ensure [:answer-field/validate]} {:db/id "answer-783fd4c1-fb89-5517-bc35-b883098e9f40" :answer/id #uuid "783fd4c1-fb89-5517-bc35-b883098e9f40" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}<0\\}" :db/ensure [:answer/validate]} {:db/id "answer-6e834be1-c403-5b49-87e3-229d8e48f719" :answer/id #uuid "6e834be1-c403-5b49-87e3-229d8e48f719" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}=0\\}" :db/ensure [:answer/validate]} {:db/id "answer-3d4cb978-08f2-56c9-a2ea-886a3b926325" :answer/id #uuid "3d4cb978-08f2-56c9-a2ea-886a3b926325" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-e4c394bb-40ee-5d34-8bd0-d21a98e21ea0" :answer/id #uuid "e4c394bb-40ee-5d34-8bd0-d21a98e21ea0" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ge 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-00e7e3fe-8aa5-5dbe-b351-f8ab041da26a" :answer/id #uuid "00e7e3fe-8aa5-5dbe-b351-f8ab041da26a" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id 17592186339044 :question/worked-solution "First, notice that $g(x,y)=\\sqrt{x}\\,{e}^{x/y}$ is defined only when $x\\ge 0$ and $y\\ne 0.$ So, the domain of $g$ is \n\n$$\n{D}_{g}=\\{(x,y)\\,:\\,x\\ge 0,y\\ne 0\\}.\n$$\n\nAs for the partial derivatives, we have the following.\n\n- The function ${g}_{x}(x,y)=\\frac{(2x+y){e}^{x/y}}{2y\\sqrt{x}}$ is defined only when $x>0$ and $y\\ne 0.$ So, the domain of ${g}_{x}$ is \n\n$$\n{D}_{{g}_{x}}=\\{(x,y)\\,:\\,x>0,y\\ne 0\\}.\n$$\n\n- The function ${g}_{y}(x,y)=-\\frac{\\sqrt{{x}^{3}}{e}^{x/y}}{{y}^{2}}$ is defined only when $x\\ge 0$ and $y\\ne 0.$ So, the domain of ${g}_{x}$ is \n\n$$\n{D}_{{g}_{y}}=\\{(x,y)\\,:\\,x\\ge 0,y\\ne 0\\}.\n$$\n\nFinally, we conclude that the partials of $g$ exist on the set\n\n$$\n\\begin{aligned}{D}_{g}\\cap {D}_{{g}_{x}}\\cap {D}_{{g}_{y}} & =\\{(x,y)\\,:\\,x\\ge 0,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,x>0,y\\ne 0\\}\\cap \\{(x,y)\\,:\\,x\\ge 0,y\\ne 0\\} \\\\  & =\\{(x,y)\\,:\\,x>0,y\\ne 0\\}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186338495 :answer-field/correct "answer-68c920e8-acc6-5f92-901b-f110118b4e1e" :answer-field/choices ["answer-902fe96c-5b07-5372-abe9-ae12860196a2" "answer-5a32d06b-cf7c-5422-99a6-39dd7a840412" "answer-68c920e8-acc6-5f92-901b-f110118b4e1e" "answer-92d41990-0f98-5af9-a312-0df1d3c12535" "answer-b712b312-6703-550f-a665-341165a0b1ea"] :db/ensure [:answer-field/validate]} {:db/id "answer-902fe96c-5b07-5372-abe9-ae12860196a2" :answer/id #uuid "902fe96c-5b07-5372-abe9-ae12860196a2" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,x=0,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-5a32d06b-cf7c-5422-99a6-39dd7a840412" :answer/id #uuid "5a32d06b-cf7c-5422-99a6-39dd7a840412" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,x>0,y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-68c920e8-acc6-5f92-901b-f110118b4e1e" :answer/id #uuid "68c920e8-acc6-5f92-901b-f110118b4e1e" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,x>0,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "answer-92d41990-0f98-5af9-a312-0df1d3c12535" :answer/id #uuid "92d41990-0f98-5af9-a312-0df1d3c12535" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,x\\ge 0,y>0\\}" :db/ensure [:answer/validate]} {:db/id "answer-b712b312-6703-550f-a665-341165a0b1ea" :answer/id #uuid "b712b312-6703-550f-a665-341165a0b1ea" :answer/type :answer.type/math :answer/value "\\{(x,y)\\,:\\,x\\ge 0,y\\ne 0\\}" :db/ensure [:answer/validate]} {:db/id "question-1ddf04e4-d463-5268-9d26-58b4ea7da263" :question/id #uuid "1ddf04e4-d463-5268-9d26-58b4ea7da263" :question/math-academy-id "q-72015" :question/problem "Which of the following statements are true about the function $f(x,y)=\\operatorname{ln}⁡(x-y)?$\n\nI. Both partial derivatives exist at the point $(0,-1)$\n\nII. ${f}_{x}(0,1)$ is defined\n\nIII. ${f}_{y}(1,1)$ is defined" :question/worked-solution "First, we compute the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x-y)) \\\\  & =\\frac{1}{x-y}\\cdot 1 \\\\  & =\\frac{1}{x-y} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x-y)) \\\\  & =\\frac{1}{x-y}\\cdot (-1) \\\\  & =-\\frac{1}{x-y}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one. \n\n- Statement I is true. Indeed, the function $f$ is defined at $(0,-1)$, where we have \n\n$$\nf(0,-1)=\\operatorname{ln}⁡(0-(-1))=\\operatorname{ln}⁡(1)=0,\n$$\n\nand both partial derivatives are also defined at $(0,-1):$\n\n$$\n\\begin{aligned}{f}_{x}(0,-1) & =\\frac{1}{0-(-1)}=\\frac{1}{1}=1 \\\\ {f}_{y}(0,-1) & =-\\frac{1}{0-(-1)}=-\\frac{1}{1}=-1\\end{aligned}\n$$\n\n- Statement II is false. If we substitute $(0,1)$ into $f$, we get\n\n$$\nf(0,1)=\\operatorname{ln}⁡(0-1)=\\operatorname{ln}⁡(-1),\n$$\n\nwhich is undefined. Since the function is not defined at the point, the derivative is also undefined.\n\n- Statement III is false. If we substitute $(0,1)$ into $f$, we get\n\n$$\nf(1,1)=\\operatorname{ln}⁡(1-1)=\\operatorname{ln}⁡(0).\n$$\n\nwhich is also undefined. Since the function is not defined at the point, the derivative is also undefined.\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7baa4b68-d188-53a1-8a4e-8080f4629446"] :db/ensure [:question/validate]} {:db/id "answer-field-7baa4b68-d188-53a1-8a4e-8080f4629446" :answer-field/id #uuid "7baa4b68-d188-53a1-8a4e-8080f4629446" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f484384-2944-5aa5-be6d-f85e77de604a" :answer-field/choices ["answer-e93c9a34-c0f4-5a44-8207-573fd788bf6b" "answer-1f484384-2944-5aa5-be6d-f85e77de604a" "answer-895a6aba-7fbc-5c6f-b46f-27ec0e197bc2" "answer-95fe521c-d73c-5a83-b40d-7b1ab28589f0" "answer-8b5eecf6-bced-54a8-8975-13e55e4eb747"] :db/ensure [:answer-field/validate]} {:db/id "answer-e93c9a34-c0f4-5a44-8207-573fd788bf6b" :answer/id #uuid "e93c9a34-c0f4-5a44-8207-573fd788bf6b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-1f484384-2944-5aa5-be6d-f85e77de604a" :answer/id #uuid "1f484384-2944-5aa5-be6d-f85e77de604a" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-895a6aba-7fbc-5c6f-b46f-27ec0e197bc2" :answer/id #uuid "895a6aba-7fbc-5c6f-b46f-27ec0e197bc2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-95fe521c-d73c-5a83-b40d-7b1ab28589f0" :answer/id #uuid "95fe521c-d73c-5a83-b40d-7b1ab28589f0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-8b5eecf6-bced-54a8-8975-13e55e4eb747" :answer/id #uuid "8b5eecf6-bced-54a8-8975-13e55e4eb747" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-73a5b476-e534-54e3-9da7-2de0545b138d" :question/id #uuid "73a5b476-e534-54e3-9da7-2de0545b138d" :question/math-academy-id "q-72017" :question/problem "Which of the following statements are true about the function $f(x,y)=\\frac{x}{y}?$\n\nI. Both partial derivatives exist at the point $(2,-1)$\n\nII. ${f}_{x}(1,0)$ is defined\n\nIII. ${f}_{y}(0,1)$ is defined" :question/worked-solution "First, we compute the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{x}{y}) \\\\  & =\\frac{1}{y} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{x}{y}) \\\\  & =-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one. \n\n- Statement I is true. Indeed, the function $f$ is defined at $(2,-1)$, where we have \n\n$$\nf(2,-1)=\\frac{2}{(-1)}=-2,\n$$\n\nand both partial derivatives are also defined at $(2,-1):$\n\n$$\n\\begin{aligned}{f}_{x}(2,-1) & =\\frac{1}{-1}=-1 \\\\ {f}_{y}(2,-1) & =-\\frac{2}{(-1)^{2}}=-2\\end{aligned}\n$$\n\n- Statement II is false. If we substitute $(1,0)$ into $f$, we get\n\n$$\nf(1,0)=\\frac{1}{0}\n$$\n\nwhich is undefined since we have division by zero. Since the function is not defined at the point, the derivative is also undefined.\n\n- Statement III is true. If we substitute $(0,1)$ into $f$, we get\n\n$$\nf(0,1)=\\frac{0}{1}=0,\n$$\n\n  and  ${f}_{y}$ is also defined at $(0,1):$\n\n$$\n{f}_{y}(0,1)=\\frac{-0}{{1}^{2}}=0\n$$\n\nTherefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-68e03a66-dcc9-5dc9-9fd3-bdca1b4cd4cd"] :db/ensure [:question/validate]} {:db/id "answer-field-68e03a66-dcc9-5dc9-9fd3-bdca1b4cd4cd" :answer-field/id #uuid "68e03a66-dcc9-5dc9-9fd3-bdca1b4cd4cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-edfadd89-b8d6-5bb0-9938-41414b42c7a0" :answer-field/choices ["answer-edfadd89-b8d6-5bb0-9938-41414b42c7a0" "answer-2641419a-4016-5b04-ae0d-2222660b4187" "answer-198bc42c-d3a2-5588-8d98-878c5a5390fe" "answer-576eba6e-2ba8-56c8-a2cb-7dfa5b572111" "answer-51e3c066-4569-5d03-9a91-b2ea8579daae"] :db/ensure [:answer-field/validate]} {:db/id "answer-edfadd89-b8d6-5bb0-9938-41414b42c7a0" :answer/id #uuid "edfadd89-b8d6-5bb0-9938-41414b42c7a0" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-2641419a-4016-5b04-ae0d-2222660b4187" :answer/id #uuid "2641419a-4016-5b04-ae0d-2222660b4187" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-198bc42c-d3a2-5588-8d98-878c5a5390fe" :answer/id #uuid "198bc42c-d3a2-5588-8d98-878c5a5390fe" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-576eba6e-2ba8-56c8-a2cb-7dfa5b572111" :answer/id #uuid "576eba6e-2ba8-56c8-a2cb-7dfa5b572111" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-51e3c066-4569-5d03-9a91-b2ea8579daae" :answer/id #uuid "51e3c066-4569-5d03-9a91-b2ea8579daae" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} [:db/retract 17592186165051 :answer-field/choices 17592186165056] [:db/retract 17592186165051 :answer-field/choices 17592186165052] [:db/retract 17592186165051 :answer-field/choices 17592186165053] [:db/retract 17592186165051 :answer-field/choices 17592186165054] [:db/retract 17592186165051 :answer-field/choices 17592186165055] {:db/id 17592186166751 :knowledge-point/questions ["question-ee947d80-6aa8-5dc4-9785-d937ced374de" "question-71981b01-d421-5e25-8cb2-44a17e6d5470"] :db/ensure [:knowledge-point/validate]} {:db/id "question-ee947d80-6aa8-5dc4-9785-d937ced374de" :question/id #uuid "ee947d80-6aa8-5dc4-9785-d937ced374de" :question/math-academy-id "q-95010" :question/problem "$$\n{A}_{1}=[\\begin{aligned}1 & -1 \\\\ 0 & 3\\end{aligned}],\\,{A}_{2}=[\\begin{aligned}9 & 4 \\\\ -5 & 3\\end{aligned}]\n$$\n\nConsider the matrices shown above. Find the matrix $C$ given that $B=\\{{A}_{1},{A}_{2}\\}$ is a basis of $\\text{Span}\\{{A}_{1},{A}_{2}\\},$ and the coordinates of the matrix $C$ relative to $B$ are $[C]_{B}=[\\begin{aligned}4 \\\\ -1\\end{aligned}].$" :question/worked-solution "Any vector in $\\text{Span}\\{{A}_{1},{A}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{A}_{1}+{x}_{2}{A}_{2}.\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[C]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}4 \\\\ -1\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}C & =4\\cdot [\\begin{aligned}1 & -1 \\\\ 0 & 3\\end{aligned}]+(-1)\\cdot [\\begin{aligned}9 & 4 \\\\ -5 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -4 \\\\ 0 & 12\\end{aligned}]+[\\begin{aligned}-9 & -4 \\\\ 5 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}-5 & -8 \\\\ 5 & 9\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-316ad55a-5e8d-586a-bd40-47b77c935abd"] :db/ensure [:question/validate]} {:db/id "answer-field-316ad55a-5e8d-586a-bd40-47b77c935abd" :answer-field/id #uuid "316ad55a-5e8d-586a-bd40-47b77c935abd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6151d1c3-f034-57e2-83b8-50371e7ef248" :answer-field/choices ["answer-d9635e7a-2f1c-5ad8-bec3-9492822808ee" "answer-42ab0ff2-ab0b-5d3f-9e26-734149456094" "answer-6151d1c3-f034-57e2-83b8-50371e7ef248" "answer-ea265705-2964-5a34-9bb4-7e9db4a9c61a" "answer-6f5c3abb-ee4d-5e86-90b9-f8fa0cd89cfa"] :db/ensure [:answer-field/validate]} {:db/id "answer-d9635e7a-2f1c-5ad8-bec3-9492822808ee" :answer/id #uuid "d9635e7a-2f1c-5ad8-bec3-9492822808ee" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-13 & -8 \\\\ 5 & -15\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-42ab0ff2-ab0b-5d3f-9e26-734149456094" :answer/id #uuid "42ab0ff2-ab0b-5d3f-9e26-734149456094" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-5 & -8 \\\\ -5 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6151d1c3-f034-57e2-83b8-50371e7ef248" :answer/id #uuid "6151d1c3-f034-57e2-83b8-50371e7ef248" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-5 & -8 \\\\ 5 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-ea265705-2964-5a34-9bb4-7e9db4a9c61a" :answer/id #uuid "ea265705-2964-5a34-9bb4-7e9db4a9c61a" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-5 & 0 \\\\ -5 & 15\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-6f5c3abb-ee4d-5e86-90b9-f8fa0cd89cfa" :answer/id #uuid "6f5c3abb-ee4d-5e86-90b9-f8fa0cd89cfa" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}5 & 0 \\\\ 5 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id 17592186167307 :question/problem "$$\n{A}_{1}=[\\begin{aligned}1 & 0 \\\\ 2 & -3\\end{aligned}],\\,{A}_{2}=[\\begin{aligned}0 & 1 \\\\ 5 & 0\\end{aligned}]\n$$\n\nConsider the matrices shown above. Find the matrix $C$ given that $B=\\{{A}_{1},{A}_{2}\\}$ is a basis of $\\text{Span}\\{{A}_{1},{A}_{2}\\},$ and the coordinates of the matrix $C$ relative to $B$ are $[C]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}].$" :question/worked-solution "Any vector in $\\text{Span}\\{{A}_{1},{A}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{A}_{1}+{x}_{2}{A}_{2}.\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[C]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 \\\\ -3\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}C & =2\\cdot [\\begin{aligned}1 & 0 \\\\ 2 & -3\\end{aligned}]+(-3)\\cdot [\\begin{aligned}0 & 1 \\\\ 5 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ 4 & -6\\end{aligned}]+[\\begin{aligned}0 & -3 \\\\ -15 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -3 \\\\ -11 & -6\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186165051 :answer-field/correct "answer-446dabe3-49c3-5c19-a0ad-07eb84517536" :answer-field/choices ["answer-7c777f84-b77f-5d85-8be5-0a060c689b19" "answer-de8035ce-93fa-59c6-ab22-ecbea61f3db0" "answer-aa2453f1-9942-5ee6-8a23-474c9f7c5cdb" "answer-446dabe3-49c3-5c19-a0ad-07eb84517536" "answer-946cf36a-cac6-5744-bff7-9916b58a2886"] :db/ensure [:answer-field/validate]} {:db/id "answer-7c777f84-b77f-5d85-8be5-0a060c689b19" :answer/id #uuid "7c777f84-b77f-5d85-8be5-0a060c689b19" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-3 & -4 \\\\ -9 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-de8035ce-93fa-59c6-ab22-ecbea61f3db0" :answer/id #uuid "de8035ce-93fa-59c6-ab22-ecbea61f3db0" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-3 & 2 \\\\ 4 & 9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-aa2453f1-9942-5ee6-8a23-474c9f7c5cdb" :answer/id #uuid "aa2453f1-9942-5ee6-8a23-474c9f7c5cdb" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}-5 & -6 \\\\ -11 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-446dabe3-49c3-5c19-a0ad-07eb84517536" :answer/id #uuid "446dabe3-49c3-5c19-a0ad-07eb84517536" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}2 & -3 \\\\ -11 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-946cf36a-cac6-5744-bff7-9916b58a2886" :answer/id #uuid "946cf36a-cac6-5744-bff7-9916b58a2886" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}2 & -3 \\\\ 6 & -11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "question-71981b01-d421-5e25-8cb2-44a17e6d5470" :question/id #uuid "71981b01-d421-5e25-8cb2-44a17e6d5470" :question/math-academy-id "q-95007" :question/problem "Consider the polynomials ${p}_{1}(t)$ and ${p}_{2}(t),$ given by\n\n$$\n{p}_{1}(t)=t-{t}^{3},\\,{p}_{2}(t)=2{t}^{2}+5{t}^{3}.\n$$\n\nFind $p(t)$ given that $B=\\{{p}_{1}(t),{p}_{2}(t)\\}$ is a basis of $\\text{Span}\\{{p}_{1},{p}_{2}\\},$ and the coordinates of $p(t)$ relative to $B$ are $[p(t)]_{B}=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].$" :question/worked-solution "Any vector in  $\\text{Span}\\{{p}_{1},{p}_{2}\\}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t).\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[p(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}-3 \\\\ 1\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}p(t) & =(-3)\\cdot (t-{t}^{3})+1\\cdot (2{t}^{2}+5{t}^{3}) \\\\  & =-3t+3{t}^{3}+2{t}^{2}+5{t}^{3} \\\\  & =-3t+2{t}^{2}+8{t}^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4a136902-a15d-512f-845b-8a048ae1d4bf"] :db/ensure [:question/validate]} {:db/id "answer-field-4a136902-a15d-512f-845b-8a048ae1d4bf" :answer-field/id #uuid "4a136902-a15d-512f-845b-8a048ae1d4bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b7001e9-0338-5f47-b94a-debd241ffea1" :answer-field/choices ["answer-4b7001e9-0338-5f47-b94a-debd241ffea1" "answer-22e3dfdc-803c-530b-828e-1f04c545062b" "answer-47a215b1-2b3a-5000-bc50-233d09b9d4d8" "answer-983d6858-aa25-5104-bc4a-bb5df7575f3f" "answer-8a74fc7a-d723-5249-bfd0-48d9b771d88b"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b7001e9-0338-5f47-b94a-debd241ffea1" :answer/id #uuid "4b7001e9-0338-5f47-b94a-debd241ffea1" :answer/type :answer.type/math :answer/value "p(t)=-3t+2{t}^{2}+8{t}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-22e3dfdc-803c-530b-828e-1f04c545062b" :answer/id #uuid "22e3dfdc-803c-530b-828e-1f04c545062b" :answer/type :answer.type/math :answer/value "p(t)=-3t+2{t}^{2}-2{t}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-47a215b1-2b3a-5000-bc50-233d09b9d4d8" :answer/id #uuid "47a215b1-2b3a-5000-bc50-233d09b9d4d8" :answer/type :answer.type/math :answer/value "p(t)=-{t}^{2}+4{t}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-983d6858-aa25-5104-bc4a-bb5df7575f3f" :answer/id #uuid "983d6858-aa25-5104-bc4a-bb5df7575f3f" :answer/type :answer.type/math :answer/value "p(t)=3t+2{t}^{2}-2{t}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-8a74fc7a-d723-5249-bfd0-48d9b771d88b" :answer/id #uuid "8a74fc7a-d723-5249-bfd0-48d9b771d88b" :answer/type :answer.type/math :answer/value "p(t)=3t+6{t}^{3}" :db/ensure [:answer/validate]} {:db/id 17592186166752 :knowledge-point/questions ["question-2ade0c9c-871d-5f78-8adc-bcd701d0727a" "question-df9025d6-fcec-59a9-b2fb-091fd502413d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-2ade0c9c-871d-5f78-8adc-bcd701d0727a" :question/id #uuid "2ade0c9c-871d-5f78-8adc-bcd701d0727a" :question/math-academy-id "q-106750" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}-1 & 2 \\\\ 0 & 3\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}2 & 1 \\\\ 0 & -1\\end{aligned}],\\,A=[\\begin{aligned}-10 & 0 \\\\ 0 & 10\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}-1 & 2 \\\\ 0 & 3\\end{aligned}]+{x}_{2}[\\begin{aligned}2 & 1 \\\\ 0 & -1\\end{aligned}] & =[\\begin{aligned}-10 & 0 \\\\ 0 & 10\\end{aligned}] \\\\ [\\begin{aligned}-{x}_{1}+2{x}_{2} & 2{x}_{1}+{x}_{2} \\\\ 0 & 3{x}_{1}-{x}_{2}\\end{aligned}] & =[\\begin{aligned}-10 & 0 \\\\ 0 & 10\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}-{x}_{1}+2{x}_{2}=-10 \\\\ 2{x}_{1}+{x}_{2}=0 \\\\ 3{x}_{1}-{x}_{2}=10.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}-1 & 2 & -10 \\\\ 2 & 1 & 0 \\\\ 3 & -1 & 10\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 2 & -10 \\\\ 2 & 1 & 0 \\\\ 3 & -1 & 10\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+3{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}-1 & 2 & -10 \\\\ 0 & 5 & -20 \\\\ 0 & 5 & -20\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}+2{x}_{2}=-10 \\\\ 5{x}_{2}=-20\\end{aligned}\n$$\n\nFrom the second  equation, we get ${x}_{2}=-4.$ From the first equation, we get \n\n$$\n\\begin{aligned}-{x}_{1}+2(-4) & =-10 \\\\ -{x}_{1} & =-2 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}2 \\\\ -4\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=2+(-4)=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8dd1c54a-c831-5cbe-8eef-ef06db6fc42c"] :db/ensure [:question/validate]} {:db/id "answer-field-8dd1c54a-c831-5cbe-8eef-ef06db6fc42c" :answer-field/id #uuid "8dd1c54a-c831-5cbe-8eef-ef06db6fc42c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c2dcc144-7c34-56a2-8495-45807a3fe82c" :answer-field/choices ["answer-9580e7d9-2197-512f-98b3-2771aef78be8" "answer-c2dcc144-7c34-56a2-8495-45807a3fe82c" "answer-9baad326-2a3f-5a1a-891d-cfc23346b6ad" "answer-933e3d56-7dd8-5f4b-8baf-cfed5b9e1537" "answer-6b7570ab-fd63-531d-8e02-29bf746ab1db"] :db/ensure [:answer-field/validate]} {:db/id "answer-9580e7d9-2197-512f-98b3-2771aef78be8" :answer/id #uuid "9580e7d9-2197-512f-98b3-2771aef78be8" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-c2dcc144-7c34-56a2-8495-45807a3fe82c" :answer/id #uuid "c2dcc144-7c34-56a2-8495-45807a3fe82c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-9baad326-2a3f-5a1a-891d-cfc23346b6ad" :answer/id #uuid "9baad326-2a3f-5a1a-891d-cfc23346b6ad" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-933e3d56-7dd8-5f4b-8baf-cfed5b9e1537" :answer/id #uuid "933e3d56-7dd8-5f4b-8baf-cfed5b9e1537" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-6b7570ab-fd63-531d-8e02-29bf746ab1db" :answer/id #uuid "6b7570ab-fd63-531d-8e02-29bf746ab1db" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-df9025d6-fcec-59a9-b2fb-091fd502413d" :question/id #uuid "df9025d6-fcec-59a9-b2fb-091fd502413d" :question/math-academy-id "q-95014" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}2 & 1 \\\\ 0 & -3\\end{aligned}],\\,A=[\\begin{aligned}-2 & -6 \\\\ 0 & 12\\end{aligned}]\n$$\n\nIf $B=\\{{B}_{1},{B}_{2}\\}$ is a basis of $\\text{Span}\\{{B}_{1},{B}_{2}\\},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 & -2 \\\\ 0 & 3\\end{aligned}]+{x}_{2}[\\begin{aligned}2 & 1 \\\\ 0 & -3\\end{aligned}] & =[\\begin{aligned}-2 & -6 \\\\ 0 & 12\\end{aligned}] \\\\ [\\begin{aligned}{x}_{1}+2{x}_{2} & -2{x}_{1}+{x}_{2} \\\\ 0 & 3{x}_{1}-3{x}_{2}\\end{aligned}] & =[\\begin{aligned}-2 & -6 \\\\ 0 & 12\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=-2 \\\\ -2{x}_{1}+{x}_{2}=-6 \\\\ 3{x}_{1}-3{x}_{2}=12.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & -2 \\\\ -2 & 1 & -6 \\\\ 3 & -3 & 12\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 2 & -2 \\\\ -2 & 1 & -6 \\\\ 3 & -3 & 12\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+2{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-3){R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}1 & 2 & -2 \\\\ 0 & 5 & -10 \\\\ 0 & -9 & 18\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=-2 \\\\ 5{x}_{2}=-10 \\\\ -9{x}_{2}=18.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=-2.$ From the first equation, we get \n\n$$\n\\begin{aligned}{x}_{1}+2(-2) & =-2 \\\\ {x}_{1} & =2.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}2 \\\\ -2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=2+(-2)=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-53149fa6-8149-5883-9704-72bc13881279"] :db/ensure [:question/validate]} {:db/id "answer-field-53149fa6-8149-5883-9704-72bc13881279" :answer-field/id #uuid "53149fa6-8149-5883-9704-72bc13881279" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-52f2bc5c-22ee-5401-83b8-a58e522c085f" :answer-field/choices ["answer-c40d1049-9690-549c-a325-1983d41ce8ca" "answer-d505d171-6c9a-575c-8afc-95dad6d378eb" "answer-52f2bc5c-22ee-5401-83b8-a58e522c085f" "answer-b9edf9cb-75a6-5e66-9a24-af4447fd7019" "answer-767b5f1b-c79a-561a-9e70-43852522b78d"] :db/ensure [:answer-field/validate]} {:db/id "answer-c40d1049-9690-549c-a325-1983d41ce8ca" :answer/id #uuid "c40d1049-9690-549c-a325-1983d41ce8ca" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-d505d171-6c9a-575c-8afc-95dad6d378eb" :answer/id #uuid "d505d171-6c9a-575c-8afc-95dad6d378eb" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-52f2bc5c-22ee-5401-83b8-a58e522c085f" :answer/id #uuid "52f2bc5c-22ee-5401-83b8-a58e522c085f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-b9edf9cb-75a6-5e66-9a24-af4447fd7019" :answer/id #uuid "b9edf9cb-75a6-5e66-9a24-af4447fd7019" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-767b5f1b-c79a-561a-9e70-43852522b78d" :answer/id #uuid "767b5f1b-c79a-561a-9e70-43852522b78d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186168064 :tutorial/content "We've already seen how to write the coordinates of a vector $\\mathbf v\\in \\mathbb R^n$ relative some general basis $\\mathcal B$ of $\\mathbb R^n.$ In this lesson, we will generalize this concept to abstract vector spaces.\n\nAs an example, consider the matrices $A_1$ and $A_2,$ given by\n\n![](images/28/2828c037a750f078b4d98b93248e800ec05d4899d7eb390dd135326314c44e70.svg)\n\nThe set $\\mathcal{B}=\\big\\{ A_1, A_2 \\big\\}$ is a basis of the vector space $V = \\textrm{Span}\\big\\{ A_1, A_2 \\big\\}.$ Now, suppose that the coordinates of the matrix $C$ relative to $\\mathcal{B}$ are \n\n![](images/2d/2db3ab1e4452eff2f19151cc87a805452433c7f305a80e5480c25241cba42c38.svg)\n\nLet's find the matrix $C$ using this information. \n\nAs usual, any vector in $\\textrm{Span}\\big\\{ A_1, A_2 \\big\\}$ can be written as\n\n$$\nx_1 A_1  + x_2 A_2,\n$$\n\nwhere $x_1,x_2$ are the coordinates of the vector relative to the basis. \n\nIn our case, we have \n\n![](images/64/6489e130a9237881664e1649cc5408cdff87cfb12dcf44c0342b9961cdf7bc81.svg)\n\nTherefore, \n\n$$\n\\begin{aligned}C & =2\\cdot [\\begin{aligned}3 & -1 \\\\ 0 & 5\\end{aligned}]+4\\cdot [\\begin{aligned}0 & 3 \\\\ 2 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & -2 \\\\ 0 & 10\\end{aligned}]+[\\begin{aligned}0 & 12 \\\\ 8 & -8\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 10 \\\\ 8 & 2\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186083171 :knowledge-point/questions ["question-e48aeb5c-60a2-50ba-8aad-37ecd4e919eb" "question-a91b43fb-d787-5c95-8cec-baa3db0b3a5b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e48aeb5c-60a2-50ba-8aad-37ecd4e919eb" :question/id #uuid "e48aeb5c-60a2-50ba-8aad-37ecd4e919eb" :question/math-academy-id "q-170020" :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned}5t+2v=13 \\\\ 2t+v=5\\end{aligned}\n$$\n\nThe variable $v$ can be eliminated from the system using the following two steps:\n\n1\\. Multiply the second equation by $-2$ and obtain\n\n  $$\n  \\begin{aligned}-4t-2v=-10.\\end{aligned}\n  $$\n\n2\\. Add the multiplied equation to the first equation to get\n\n  $$\n  \\begin{aligned}⋯\\,\\,?\\,\\,⋯\\,\\,=3.\\end{aligned}\n  $$\n\nFind the missing expression, and hence find the solution $(t,v)$ of the system." :question/worked-solution "Let's follow the steps provided:\n\n**Step 1**: Multiplying the second equation by $-2$ yields the following equivalent system:\n\n$$\n\\{\\begin{aligned}5t+2v=13 \\\\ (\\,2t+v=5\\,)\\,\\times (-2)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}5t+2v=13 \\\\ -4t-2v=-10\\end{aligned}\n$$\n\n**Step 2**: Next, we add these two equations together, *eliminate* the variable $v,$ and solve the resulting equation for $t:$\n\n$$\n\\begin{aligned}5t+\\cancel{2v} & =13 \\\\ -4t-\\cancel{2v} & =-10 \\\\ (5t-4t) & =(13-10) \\\\ t & =3\\end{aligned}\n$$\n\nSo, the solution must have $t=3.$ However, we still need to find $v.$ To do this, we substitute $t=3$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}2t+v & =5 \\\\ 2(3)+v & =5 \\\\ 6+v & =5 \\\\ v & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $t=3,\\,v=-1,$ which can be expressed as $(3,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b1cd66a4-4798-5107-a762-4b88b1221841"] :db/ensure [:question/validate]} {:db/id "answer-field-b1cd66a4-4798-5107-a762-4b88b1221841" :answer-field/id #uuid "b1cd66a4-4798-5107-a762-4b88b1221841" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-79e9ed81-8adc-5412-8b2e-0655de8c1d6f" :answer-field/choices ["answer-801bd6ee-55fe-555a-a5a1-7e40518e7c8c" "answer-a20dfd08-1474-5e67-86b1-3cce1d26279a" "answer-f76338d9-5322-5de7-be10-ca730f0460ce" "answer-79e9ed81-8adc-5412-8b2e-0655de8c1d6f" "answer-d924bb24-e255-5e91-950b-1728e67a3a03"] :db/ensure [:answer-field/validate]} {:db/id "answer-801bd6ee-55fe-555a-a5a1-7e40518e7c8c" :answer/id #uuid "801bd6ee-55fe-555a-a5a1-7e40518e7c8c" :answer/type :answer.type/math :answer/value "(-1,7)" :db/ensure [:answer/validate]} {:db/id "answer-a20dfd08-1474-5e67-86b1-3cce1d26279a" :answer/id #uuid "a20dfd08-1474-5e67-86b1-3cce1d26279a" :answer/type :answer.type/math :answer/value "(-1,9)" :db/ensure [:answer/validate]} {:db/id "answer-f76338d9-5322-5de7-be10-ca730f0460ce" :answer/id #uuid "f76338d9-5322-5de7-be10-ca730f0460ce" :answer/type :answer.type/math :answer/value "(1,3)" :db/ensure [:answer/validate]} {:db/id "answer-79e9ed81-8adc-5412-8b2e-0655de8c1d6f" :answer/id #uuid "79e9ed81-8adc-5412-8b2e-0655de8c1d6f" :answer/type :answer.type/math :answer/value "(3,-1)" :db/ensure [:answer/validate]} {:db/id "answer-d924bb24-e255-5e91-950b-1728e67a3a03" :answer/id #uuid "d924bb24-e255-5e91-950b-1728e67a3a03" :answer/type :answer.type/math :answer/value "(3,2)" :db/ensure [:answer/validate]} {:db/id "question-a91b43fb-d787-5c95-8cec-baa3db0b3a5b" :question/id #uuid "a91b43fb-d787-5c95-8cec-baa3db0b3a5b" :question/math-academy-id "q-208822" :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned}-3x+5y=9 \\\\ 2x-y=1\\end{aligned}\n$$\n\nThe variable $y$ can be eliminated from the system using the following two steps:\n\n1\\. Multiply the second equation by $5$ and obtain\n\n  $$\n  \\begin{aligned}10x-5y=5.\\end{aligned}\n  $$\n\n2\\. Add the multiplied equation to the first equation to get\n\n$\\,$\n{{field-1}}$=14.$\n\n$\\,$\nHence, the solution to the system of equations is $($\n{{field-2}}$\\,,$\n{{field-3}}\n$).$" :question/worked-solution "Let's follow the steps provided:\n\n**Step 1**: Multiplying the second equation by $5$ yields the following equivalent system:\n\n$$\n\\{\\begin{aligned}-3x+5y=9 \\\\ (\\,2x-y=1\\,)\\,\\times (5)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-3x+5y=9 \\\\ 10x-5y=5\\end{aligned}\n$$\n\n**Step 2**: Next, we add these two equations together, *eliminate* the variable $y,$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}-3x+\\cancel{5y} & =9 \\\\ 10x-\\cancel{5y} & =5 \\\\ (-3x+10x) & =(9+5) \\\\ 7x & =14\\end{aligned}\n$$\n\nSo, the solution must have $x=2.$ However, we still need to find $y.$ To do this, we substitute $x=2$ back into one of the equations. Let's choose the second equation:\n\n$$\n\\begin{aligned}2x-y & =1 \\\\ 2(2)-y & =1 \\\\ 4-y & =1 \\\\ -y & =-3 \\\\ y & =3\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=2,\\,y=3,$ which can be expressed as $(\\,2,3\\,).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-92216407-d4a0-5405-80ce-75bdb22713b8" "answer-field-cfc01578-2ddc-5e45-a0ad-a9e131bb6c30" "answer-field-61df3c66-7c8a-518e-88c5-f9c95caa3752"] :db/ensure [:question/validate]} {:db/id "answer-field-92216407-d4a0-5405-80ce-75bdb22713b8" :answer-field/id #uuid "92216407-d4a0-5405-80ce-75bdb22713b8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f6432dec-a821-5a8f-91c0-bc8eb104b4db" :answer-field/choices ["answer-f6432dec-a821-5a8f-91c0-bc8eb104b4db"] :db/ensure [:answer-field/validate]} {:db/id "answer-f6432dec-a821-5a8f-91c0-bc8eb104b4db" :answer/id #uuid "f6432dec-a821-5a8f-91c0-bc8eb104b4db" :answer/type :answer.type/math :answer/value "7x" :db/ensure [:answer/validate]} {:db/id "answer-field-cfc01578-2ddc-5e45-a0ad-a9e131bb6c30" :answer-field/id #uuid "cfc01578-2ddc-5e45-a0ad-a9e131bb6c30" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1d011b84-399d-5ccd-8fd8-17c37c9d5011" :answer-field/choices ["answer-1d011b84-399d-5ccd-8fd8-17c37c9d5011"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d011b84-399d-5ccd-8fd8-17c37c9d5011" :answer/id #uuid "1d011b84-399d-5ccd-8fd8-17c37c9d5011" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-field-61df3c66-7c8a-518e-88c5-f9c95caa3752" :answer-field/id #uuid "61df3c66-7c8a-518e-88c5-f9c95caa3752" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d16b812f-c6b5-520d-969e-18bfaa8a836f" :answer-field/choices ["answer-d16b812f-c6b5-520d-969e-18bfaa8a836f"] :db/ensure [:answer-field/validate]} {:db/id "answer-d16b812f-c6b5-520d-969e-18bfaa8a836f" :answer/id #uuid "d16b812f-c6b5-520d-969e-18bfaa8a836f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186083169 :knowledge-point/questions ["question-cd2697ea-50eb-59a5-a69d-76e0004cb7aa" "question-7d0d1a49-c8c0-5ac4-a633-472aeac1d8a8"] :db/ensure [:knowledge-point/validate]} {:db/id "question-cd2697ea-50eb-59a5-a69d-76e0004cb7aa" :question/id #uuid "cd2697ea-50eb-59a5-a69d-76e0004cb7aa" :question/math-academy-id "q-214764" :question/problem "Using the elimination method, eliminate the variable $x$ and find the solution $(x,y)$ to the following system of equations:\n\n$$\n\\{\\begin{aligned}5x+2y=45 \\\\ -5x-7y=-70\\end{aligned}\n$$\n\nThe solution is $($\n{{field-1}}$\\,,$\n{{field-2}}\n$).$" :question/worked-solution "Notice that the coefficient of $x$ in the first equation is $5,$ and the coefficient of $x$ in the second equation is $-5.$ \n\nSince these numbers add to zero, we can add the two equations, *eliminate* the variable $x,$ and solve the resulting equation for $y:$\n\n$$\n\\begin{aligned}\\cancel{5x}+2y & =45 \\\\ -\\cancel{5x}-7y & =-70 \\\\ (2y-7y) & =(45-70) \\\\ -5y & =-25 \\\\ y & =5\\end{aligned}\n$$\n\nSo, the solution must have $y=5.$ However, we still need to find $x.$ To do this, we substitute $y=5$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}5x+2y & =45 \\\\ 5x+2(5) & =45 \\\\ 5x+10 & =45 \\\\ 5x & =35 \\\\ x & =7\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=7,\\,y=5,$ which can be expressed as $(\\,7,5\\,).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-6922ba3e-81d0-5c06-979c-0240b56ed179" "answer-field-702844cc-350c-5557-8e47-27b87222f0d3"] :db/ensure [:question/validate]} {:db/id "answer-field-6922ba3e-81d0-5c06-979c-0240b56ed179" :answer-field/id #uuid "6922ba3e-81d0-5c06-979c-0240b56ed179" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7dfaf16c-d8c2-5fee-b8aa-4c4defa51d4a" :answer-field/choices ["answer-7dfaf16c-d8c2-5fee-b8aa-4c4defa51d4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-7dfaf16c-d8c2-5fee-b8aa-4c4defa51d4a" :answer/id #uuid "7dfaf16c-d8c2-5fee-b8aa-4c4defa51d4a" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "answer-field-702844cc-350c-5557-8e47-27b87222f0d3" :answer-field/id #uuid "702844cc-350c-5557-8e47-27b87222f0d3" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-7611515b-eb94-5d0e-a6cc-97bdcad28000" :answer-field/choices ["answer-7611515b-eb94-5d0e-a6cc-97bdcad28000"] :db/ensure [:answer-field/validate]} {:db/id "answer-7611515b-eb94-5d0e-a6cc-97bdcad28000" :answer/id #uuid "7611515b-eb94-5d0e-a6cc-97bdcad28000" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "question-7d0d1a49-c8c0-5ac4-a633-472aeac1d8a8" :question/id #uuid "7d0d1a49-c8c0-5ac4-a633-472aeac1d8a8" :question/math-academy-id "q-214839" :question/problem "Using the elimination method, eliminate the variable $p$ and find the solution $(p,q)$ to the following system of equations:\n\n$$\n\\{\\begin{aligned}4p+q=-24 \\\\ -4p+7q=24\\end{aligned}\n$$\n\nThe solution is $($\n{{field-1}}$\\,,$\n{{field-2}}\n$).$" :question/worked-solution "Notice that the coefficient of $p$ in the first equation is $4,$ and the coefficient of $p$ in the second equation is $-4.$ \n\nSince these numbers add to zero, we can add the two equations, *eliminate* the variable $p,$ and solve the resulting equation for $q:$\n\n$$\n\\begin{aligned}\\cancel{4p}+q & =-24 \\\\ -\\cancel{4p}+7q & =24 \\\\ (q+7q) & =(-24+24) \\\\ 8q & =0 \\\\ q & =0\\end{aligned}\n$$\n\nSo, the solution must have $q=0.$ However, we still need to find $p.$ To do this, we substitute $q=0$ back into one of the equations. Let's choose the first equation:\n\n$$\n\\begin{aligned}4p+q & =-24 \\\\ 4p+(0) & =-24 \\\\ 4p & =-24 \\\\ p & =-6\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=-6,\\,q=0,$ which can be expressed as $(\\,-\\,6,0\\,).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-acfdc83e-36c8-5bab-b817-c6b95dba314d" "answer-field-e4124ec5-3e6f-5d7a-9254-21f518b1c2eb"] :db/ensure [:question/validate]} {:db/id "answer-field-acfdc83e-36c8-5bab-b817-c6b95dba314d" :answer-field/id #uuid "acfdc83e-36c8-5bab-b817-c6b95dba314d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-05e5070a-60a7-51db-a7a0-ecbd3b937e38" :answer-field/choices ["answer-05e5070a-60a7-51db-a7a0-ecbd3b937e38"] :db/ensure [:answer-field/validate]} {:db/id "answer-05e5070a-60a7-51db-a7a0-ecbd3b937e38" :answer/id #uuid "05e5070a-60a7-51db-a7a0-ecbd3b937e38" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "answer-field-e4124ec5-3e6f-5d7a-9254-21f518b1c2eb" :answer-field/id #uuid "e4124ec5-3e6f-5d7a-9254-21f518b1c2eb" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b788af03-66b4-5f39-9af4-1a154adb18e4" :answer-field/choices ["answer-b788af03-66b4-5f39-9af4-1a154adb18e4"] :db/ensure [:answer-field/validate]} {:db/id "answer-b788af03-66b4-5f39-9af4-1a154adb18e4" :answer/id #uuid "b788af03-66b4-5f39-9af4-1a154adb18e4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "activity-397850c6-acc7-5579-8f02-292fa0842dbf" :activity/id #uuid "397850c6-acc7-5579-8f02-292fa0842dbf" :activity/title "Introduction to the Elimination Method" :activity/type :activity.type/review :activity/scope 17592186049060 :activity/course 17592186046647 :activity/steps ["step-7e438f98-2e65-5923-a09a-5e8be95eb6f5" "step-810b9fa4-db24-548c-ad22-6936f48bccc2" "step-b651d884-2534-5e34-b6eb-6c5d837c21b3" "step-48662e2a-320d-5b65-83c0-53722452ce12"] :activity/first-step "step-7e438f98-2e65-5923-a09a-5e8be95eb6f5" :db/ensure [:activity/validate]} {:db/id "step-7e438f98-2e65-5923-a09a-5e8be95eb6f5" :step/id #uuid "7e438f98-2e65-5923-a09a-5e8be95eb6f5" :step/content "question-e48aeb5c-60a2-50ba-8aad-37ecd4e919eb" :step/next "step-810b9fa4-db24-548c-ad22-6936f48bccc2" :db/ensure [:step/validate]} {:db/id "step-810b9fa4-db24-548c-ad22-6936f48bccc2" :step/id #uuid "810b9fa4-db24-548c-ad22-6936f48bccc2" :step/content "question-a91b43fb-d787-5c95-8cec-baa3db0b3a5b" :step/next "step-b651d884-2534-5e34-b6eb-6c5d837c21b3" :db/ensure [:step/validate]} {:db/id "step-b651d884-2534-5e34-b6eb-6c5d837c21b3" :step/id #uuid "b651d884-2534-5e34-b6eb-6c5d837c21b3" :step/content "question-cd2697ea-50eb-59a5-a69d-76e0004cb7aa" :step/next "step-48662e2a-320d-5b65-83c0-53722452ce12" :db/ensure [:step/validate]} {:db/id "step-48662e2a-320d-5b65-83c0-53722452ce12" :step/id #uuid "48662e2a-320d-5b65-83c0-53722452ce12" :step/content "question-7d0d1a49-c8c0-5ac4-a633-472aeac1d8a8" :db/ensure [:step/validate]} {:db/id 17592186152052 :knowledge-point/questions ["question-9c84d136-aecb-53d5-b6db-0a2d449203b9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9c84d136-aecb-53d5-b6db-0a2d449203b9" :question/id #uuid "9c84d136-aecb-53d5-b6db-0a2d449203b9" :question/math-academy-id "q-81404" :question/problem "$11$ is **not** a prime number, or $15$ is **not** divisible by $5.$\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:11\\text{ is a prime number}$\n\n- $Q:15\\text{ is divisible by }5$" :question/worked-solution "The sentence\n\n$11$ is **not** a prime number \n\ncan be expressed symbolically as $¬P.$ \n\nThe sentence\n\n$15$ is **not** divisible by $5$ \n\ncan be expressed symbolically as $¬Q.$\n\nTherefore, the sentence\n\n$11$ is **not** a prime number, or $15$ is **not** divisible by $5$\n\ncan be expressed symbolically as $¬P∨¬Q.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f6bcc4cc-5b75-5cd8-9b55-f2a484187c8d"] :db/ensure [:question/validate]} {:db/id "answer-field-f6bcc4cc-5b75-5cd8-9b55-f2a484187c8d" :answer-field/id #uuid "f6bcc4cc-5b75-5cd8-9b55-f2a484187c8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f04e12cb-b592-5bd5-9f5b-828bec2a7c74" :answer-field/choices ["answer-1ac703f8-25cf-5379-a51f-d36c3837b8c6" "answer-cd78f341-7710-550c-a74e-9a718bae813a" "answer-01b410b0-6edf-592e-a0c2-df96c4f1275e" "answer-59305c28-a58c-5c70-b6bd-b8f2c73c98fc" "answer-f04e12cb-b592-5bd5-9f5b-828bec2a7c74"] :db/ensure [:answer-field/validate]} {:db/id "answer-1ac703f8-25cf-5379-a51f-d36c3837b8c6" :answer/id #uuid "1ac703f8-25cf-5379-a51f-d36c3837b8c6" :answer/type :answer.type/math :answer/value "¬(P∨Q)" :db/ensure [:answer/validate]} {:db/id "answer-cd78f341-7710-550c-a74e-9a718bae813a" :answer/id #uuid "cd78f341-7710-550c-a74e-9a718bae813a" :answer/type :answer.type/math :answer/value "¬(¬P∧Q)" :db/ensure [:answer/validate]} {:db/id "answer-01b410b0-6edf-592e-a0c2-df96c4f1275e" :answer/id #uuid "01b410b0-6edf-592e-a0c2-df96c4f1275e" :answer/type :answer.type/math :answer/value "¬P∧¬Q" :db/ensure [:answer/validate]} {:db/id "answer-59305c28-a58c-5c70-b6bd-b8f2c73c98fc" :answer/id #uuid "59305c28-a58c-5c70-b6bd-b8f2c73c98fc" :answer/type :answer.type/math :answer/value "¬P∨Q" :db/ensure [:answer/validate]} {:db/id "answer-f04e12cb-b592-5bd5-9f5b-828bec2a7c74" :answer/id #uuid "f04e12cb-b592-5bd5-9f5b-828bec2a7c74" :answer/type :answer.type/math :answer/value "¬P∨¬Q" :db/ensure [:answer/validate]} {:db/id 17592186152054 :knowledge-point/questions ["question-7d9b9daf-a686-5f9d-9e9b-43c577599d8d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7d9b9daf-a686-5f9d-9e9b-43c577599d8d" :question/id #uuid "7d9b9daf-a686-5f9d-9e9b-43c577599d8d" :question/math-academy-id "q-176872" :question/problem "Simplify the statement $¬[¬(¬(¬C)∧D)].$" :question/worked-solution "Two negations in a row cancel each other out. So, we can simplify $¬(¬C)$ to $C.$ \n\nAs a result of this, the statement simplifes to \n\n$$\n¬[¬(C∧D)].\n$$\n\nThen, we can simplify $¬[¬(C∧D)]]$ to $C∧D.$\n\nTherefore, the given statement can be simplified to \n\n$$\nC∧D.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d09dc30c-edd9-55fe-a325-e95e5732ee2c"] :db/ensure [:question/validate]} {:db/id "answer-field-d09dc30c-edd9-55fe-a325-e95e5732ee2c" :answer-field/id #uuid "d09dc30c-edd9-55fe-a325-e95e5732ee2c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8457e32-4ea1-538b-8fec-08974b2f73aa" :answer-field/choices ["answer-c8457e32-4ea1-538b-8fec-08974b2f73aa" "answer-8b73bda6-1aa7-5aab-9f40-3b0306647e7f" "answer-7d48af0e-1847-5050-88d7-d15aeacb37df" "answer-da880646-a80a-5029-b390-32aa365c9e96" "answer-65e0597d-70c4-58e1-8e7e-e21efcc693cc"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8457e32-4ea1-538b-8fec-08974b2f73aa" :answer/id #uuid "c8457e32-4ea1-538b-8fec-08974b2f73aa" :answer/type :answer.type/math :answer/value "C∧D" :db/ensure [:answer/validate]} {:db/id "answer-8b73bda6-1aa7-5aab-9f40-3b0306647e7f" :answer/id #uuid "8b73bda6-1aa7-5aab-9f40-3b0306647e7f" :answer/type :answer.type/math :answer/value "¬(C∧D)" :db/ensure [:answer/validate]} {:db/id "answer-7d48af0e-1847-5050-88d7-d15aeacb37df" :answer/id #uuid "7d48af0e-1847-5050-88d7-d15aeacb37df" :answer/type :answer.type/math :answer/value "¬(¬C∧D)" :db/ensure [:answer/validate]} {:db/id "answer-da880646-a80a-5029-b390-32aa365c9e96" :answer/id #uuid "da880646-a80a-5029-b390-32aa365c9e96" :answer/type :answer.type/math :answer/value "¬C∧D" :db/ensure [:answer/validate]} {:db/id "answer-65e0597d-70c4-58e1-8e7e-e21efcc693cc" :answer/id #uuid "65e0597d-70c4-58e1-8e7e-e21efcc693cc" :answer/type :answer.type/math :answer/value "¬C∧¬D" :db/ensure [:answer/validate]} {:db/id "activity-4cf2d4b9-fb00-5f84-b57a-a90dd47f48ca" :activity/id #uuid "4cf2d4b9-fb00-5f84-b57a-a90dd47f48ca" :activity/title "The \"Not\" Connective" :activity/type :activity.type/review :activity/scope 17592186048349 :activity/course 17592186046658 :activity/steps ["step-35924b33-e48f-588b-bac7-605ec71e4cdb" "step-b97e62d1-668c-52b0-8c30-69e44c46ee66" "step-ad8f3813-98ab-572f-81f