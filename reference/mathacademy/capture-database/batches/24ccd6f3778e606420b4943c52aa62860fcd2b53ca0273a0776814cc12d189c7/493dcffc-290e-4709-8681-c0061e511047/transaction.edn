answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-bc033ecd-ecb6-591e-9fff-0831c318f04f" :answer/id #uuid "bc033ecd-ecb6-591e-9fff-0831c318f04f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-b35955c4-aa46-5026-846f-ac6aeb774f47" :answer/id #uuid "b35955c4-aa46-5026-846f-ac6aeb774f47" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-bde1013e-73da-544d-9134-00b1837b44a6" :answer/id #uuid "bde1013e-73da-544d-9134-00b1837b44a6" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-9184a58a-ba3f-54e5-a4d1-d4f95b399278" :question/id #uuid "9184a58a-ba3f-54e5-a4d1-d4f95b399278" :question/math-academy-id "q-93184" :question/problem "![](images/08/08824dd380c2db6f76064b6602604fc20a60cf7a07525c830eb6473eb08fe1dd.png)\n\nHow many edges does the heptagonal pyramid shown above have?" :question/worked-solution "Edges are straight line segments that connect the vertices of a polyhedron. \n\nThe heptagonal pyramid has $14$ edges in total, as shown below.\n\n![](images/9b/9b5ee9ae6a6d1e83bd71d483956a9b713bce6a731f42b9b878d7c11e6014cdef.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f0b24892-ada9-52e3-9aa9-90cb440b68f8"] :db/ensure [:question/validate]} {:db/id "answer-field-f0b24892-ada9-52e3-9aa9-90cb440b68f8" :answer-field/id #uuid "f0b24892-ada9-52e3-9aa9-90cb440b68f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3c96f9f0-538c-5190-892a-218ec9ec33ea" :answer-field/choices ["answer-61ea79f5-99d5-5700-ac04-64c0f77162d6" "answer-ceb4174e-871f-5b67-b975-ef125ddae29a" "answer-3c96f9f0-538c-5190-892a-218ec9ec33ea" "answer-c0a9bcca-e840-586c-a5fe-881ceec1324b" "answer-64059b3f-de0c-581e-88d4-d32d98664020"] :db/ensure [:answer-field/validate]} {:db/id "answer-61ea79f5-99d5-5700-ac04-64c0f77162d6" :answer/id #uuid "61ea79f5-99d5-5700-ac04-64c0f77162d6" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-ceb4174e-871f-5b67-b975-ef125ddae29a" :answer/id #uuid "ceb4174e-871f-5b67-b975-ef125ddae29a" :answer/type :answer.type/math :answer/value "13" :db/ensure [:answer/validate]} {:db/id "answer-3c96f9f0-538c-5190-892a-218ec9ec33ea" :answer/id #uuid "3c96f9f0-538c-5190-892a-218ec9ec33ea" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "answer-c0a9bcca-e840-586c-a5fe-881ceec1324b" :answer/id #uuid "c0a9bcca-e840-586c-a5fe-881ceec1324b" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "answer-64059b3f-de0c-581e-88d4-d32d98664020" :answer/id #uuid "64059b3f-de0c-581e-88d4-d32d98664020" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} [:db/retract 17592186150503 :answer-field/choices 17592186150504] [:db/retract 17592186150503 :answer-field/choices 17592186150505] [:db/retract 17592186150503 :answer-field/choices 17592186150506] [:db/retract 17592186150503 :answer-field/choices 17592186150507] [:db/retract 17592186150503 :answer-field/choices 17592186150508] {:db/id 17592186152666 :question/problem "Jordan wants to paint the outside of his home. Using $2$ gallons of paint, he was able to paint $450$ square feet of the surface. There is a proportional relationship between the volume of paint $x$ (in gallons) that Jordan uses and the area $y$ (in square feet) he paints. What is the equation that represents the relationship between $x$ and $y?$" :question/worked-solution "Every proportional relationship takes the form $y=kx,$ where $k$ is the constant of proportionality.\n\nWe are told that Jordan painted $y=450$ square feet using $x=2$ gallons of paint.\n\nWe can find the constant of proportionality by computing the ratio of the $y$-value to the $x$-value, as follows:\n\n$$\nk=\\frac{y}{x}=\\frac{450}{2}=225\n$$\n\nTherefore, the equation is\n\n$$\ny=225x.\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186150503 :answer-field/correct "answer-7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" :answer-field/choices ["answer-7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" "answer-6f2f078c-1c25-5c7c-888a-0e00bc4cb766" "answer-103709a2-22c6-5949-b0cd-dcd0a6b21cb1" "answer-28206bbb-1d0c-5761-98a7-04bf422d3d59" "answer-43b4ca6f-6da3-5d02-ad82-9a4ba6031881"] :db/ensure [:answer-field/validate]} {:db/id "answer-7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" :answer/id #uuid "7f6e8d8b-8c88-56a9-9d7a-dfc845a80f68" :answer/type :answer.type/math :answer/value "y=225x" :db/ensure [:answer/validate]} {:db/id "answer-6f2f078c-1c25-5c7c-888a-0e00bc4cb766" :answer/id #uuid "6f2f078c-1c25-5c7c-888a-0e00bc4cb766" :answer/type :answer.type/math :answer/value "y=450x" :db/ensure [:answer/validate]} {:db/id "answer-103709a2-22c6-5949-b0cd-dcd0a6b21cb1" :answer/id #uuid "103709a2-22c6-5949-b0cd-dcd0a6b21cb1" :answer/type :answer.type/math :answer/value "y=900x" :db/ensure [:answer/validate]} {:db/id "answer-28206bbb-1d0c-5761-98a7-04bf422d3d59" :answer/id #uuid "28206bbb-1d0c-5761-98a7-04bf422d3d59" :answer/type :answer.type/math :answer/value "y=\\frac{225}{x}" :db/ensure [:answer/validate]} {:db/id "answer-43b4ca6f-6da3-5d02-ad82-9a4ba6031881" :answer/id #uuid "43b4ca6f-6da3-5d02-ad82-9a4ba6031881" :answer/type :answer.type/math :answer/value "y=\\frac{x}{225}" :db/ensure [:answer/validate]} {:db/id 17592186152272 :knowledge-point/questions ["question-5ce15c8c-b8c7-513a-aedc-297e6604d6a3" "question-b590fcf1-ec20-533b-be69-95e4b245f98f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5ce15c8c-b8c7-513a-aedc-297e6604d6a3" :question/id #uuid "5ce15c8c-b8c7-513a-aedc-297e6604d6a3" :question/math-academy-id "q-115600" :question/problem "Let $b$ be directly proportional to $g.$ Given that $b=98$ when $g=-7$, find the value of $b$ when $g=\\frac{31}{7}.$" :question/worked-solution "Since $b$ varies directly with $g,$ we use the equation\n\n$$\nb=kg.\n$$\n\nWe are told that $b=98$ when $g=-7.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}98 & =k\\cdot (-7) \\\\ \\frac{98}{(-7)} & =k \\\\ -14 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nb=-14g.\n$$\n\nFinally, substituting the value of $g=\\frac{31}{7}$ into this equation gives\n\n$$\n\\begin{aligned}b & =-14\\cdot \\frac{31}{7} \\\\  & =-2\\cdot 31 \\\\  & =-62.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7219bea5-8ca7-51f2-9ec4-6aea1bd10dc8"] :db/ensure [:question/validate]} {:db/id "answer-field-7219bea5-8ca7-51f2-9ec4-6aea1bd10dc8" :answer-field/id #uuid "7219bea5-8ca7-51f2-9ec4-6aea1bd10dc8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f0abb498-6f9d-58b7-99be-b0bcc10995cc" :answer-field/choices ["answer-52dc2da6-2a46-5aa0-a09e-218bf0c62453" "answer-084c23f6-d996-50e5-a433-1f7029a87dd6" "answer-f0abb498-6f9d-58b7-99be-b0bcc10995cc" "answer-139bd3a5-a604-5f9b-9ae1-5ed234a6ade6" "answer-b784a9d6-44a1-5356-9039-0276f2c60082"] :db/ensure [:answer-field/validate]} {:db/id "answer-52dc2da6-2a46-5aa0-a09e-218bf0c62453" :answer/id #uuid "52dc2da6-2a46-5aa0-a09e-218bf0c62453" :answer/type :answer.type/math :answer/value "-21" :db/ensure [:answer/validate]} {:db/id "answer-084c23f6-d996-50e5-a433-1f7029a87dd6" :answer/id #uuid "084c23f6-d996-50e5-a433-1f7029a87dd6" :answer/type :answer.type/math :answer/value "-31" :db/ensure [:answer/validate]} {:db/id "answer-f0abb498-6f9d-58b7-99be-b0bcc10995cc" :answer/id #uuid "f0abb498-6f9d-58b7-99be-b0bcc10995cc" :answer/type :answer.type/math :answer/value "-62" :db/ensure [:answer/validate]} {:db/id "answer-139bd3a5-a604-5f9b-9ae1-5ed234a6ade6" :answer/id #uuid "139bd3a5-a604-5f9b-9ae1-5ed234a6ade6" :answer/type :answer.type/math :answer/value "31" :db/ensure [:answer/validate]} {:db/id "answer-b784a9d6-44a1-5356-9039-0276f2c60082" :answer/id #uuid "b784a9d6-44a1-5356-9039-0276f2c60082" :answer/type :answer.type/math :answer/value "62" :db/ensure [:answer/validate]} {:db/id "question-b590fcf1-ec20-533b-be69-95e4b245f98f" :question/id #uuid "b590fcf1-ec20-533b-be69-95e4b245f98f" :question/math-academy-id "q-170877" :question/problem "Suppose $v$ is directly proportional to $u.$ Given that $v=-12$ when $u=3$, find the value of $v$ when $u=5.${{field-1}}." :question/worked-solution "Since $v$ varies directly with $u,$ we use the equation\n\n$$\nv=ku.\n$$\n\nWe are told that $v=-12$ when $u=3.$ We substitute this data into the equation to find $k:$\n\n$$\n\\begin{aligned}-12 & =k\\cdot 3 \\\\ \\frac{(-12)}{3} & =k \\\\ -4 & =k\\end{aligned}\n$$\n\nSo, the direct variation equation is given by\n\n$$\nv=-4u.\n$$\n\nFinally, substituting the value of $u=5$ into this equation gives\n\n$$\n\\begin{aligned}v & =-4\\cdot 5=-20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-0bac2356-e89d-5b9a-9d4b-f566c2759495"] :db/ensure [:question/validate]} {:db/id "answer-field-0bac2356-e89d-5b9a-9d4b-f566c2759495" :answer-field/id #uuid "0bac2356-e89d-5b9a-9d4b-f566c2759495" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9625a562-0617-5d9b-abc5-16cb402a5d88" :answer-field/choices ["answer-9625a562-0617-5d9b-abc5-16cb402a5d88"] :db/ensure [:answer-field/validate]} {:db/id "answer-9625a562-0617-5d9b-abc5-16cb402a5d88" :answer/id #uuid "9625a562-0617-5d9b-abc5-16cb402a5d88" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "activity-a6fc1838-76b5-5520-9919-4902b4fe7101" :activity/id #uuid "a6fc1838-76b5-5520-9919-4902b4fe7101" :activity/title "Understanding Proportional Relationships From Descriptions" :activity/type :activity.type/review :activity/scope 17592186049141 :activity/course 17592186046647 :activity/steps ["step-47b80ac9-74af-5bd8-9d8e-2a4389248412" "step-c8307780-4519-5f2b-8645-dac88fec372c" "step-5272e248-00bc-5399-9b74-6540dfa2cf52"] :activity/first-step "step-47b80ac9-74af-5bd8-9d8e-2a4389248412" :db/ensure [:activity/validate]} {:db/id "step-47b80ac9-74af-5bd8-9d8e-2a4389248412" :step/id #uuid "47b80ac9-74af-5bd8-9d8e-2a4389248412" :step/content 17592186152666 :step/next "step-c8307780-4519-5f2b-8645-dac88fec372c" :db/ensure [:step/validate]} {:db/id "step-c8307780-4519-5f2b-8645-dac88fec372c" :step/id #uuid "c8307780-4519-5f2b-8645-dac88fec372c" :step/content "question-5ce15c8c-b8c7-513a-aedc-297e6604d6a3" :step/next "step-5272e248-00bc-5399-9b74-6540dfa2cf52" :db/ensure [:step/validate]} {:db/id "step-5272e248-00bc-5399-9b74-6540dfa2cf52" :step/id #uuid "5272e248-00bc-5399-9b74-6540dfa2cf52" :step/content "question-b590fcf1-ec20-533b-be69-95e4b245f98f" :db/ensure [:step/validate]} [:db/retract 17592186146924 :answer-field/choices 17592186146928] [:db/retract 17592186146924 :answer-field/choices 17592186146925] [:db/retract 17592186146924 :answer-field/choices 17592186146927] {:db/id 17592186147425 :knowledge-point/questions ["question-0174198f-a0ad-5395-9af8-f36d4c14897b" "question-fad299b6-2750-5729-9622-52ccf21ff85a"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147427 :knowledge-point/questions ["question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147343 :question/problem "Given the two planes $4x-2y=0$ and $-2x+y+1=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $\\mathbf{0}.$\n\nII. The planes are parallel but not coincident.\n\nIII. The planes intersect on a straight line." :db/ensure [:question/validate]} {:db/id 17592186148195 :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n\\{\\begin{aligned}x+2y-5=0 \\\\ 2x-y+z+1=0\\end{aligned}\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $x+2y-5=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,0⟩.$\n\n- For the plane $2x-y+z+1=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨1,2,0⟩\\times ⟨2,-1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 0 \\\\ 2 & -1 & 1\\end{aligned}\\right| \\\\  & =2i-j-5k \\\\  & =⟨2,-1,-5⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186146924 :answer-field/correct 17592186146926 :answer-field/choices ["answer-251ddf2f-7d06-501e-bde5-438da0173d51" "answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" "answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60"] :db/ensure [:answer-field/validate]} {:db/id "answer-251ddf2f-7d06-501e-bde5-438da0173d51" :answer/id #uuid "251ddf2f-7d06-501e-bde5-438da0173d51" :answer/type :answer.type/math :answer/value "⟨1,2,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/id #uuid "6bfb1a2f-76c3-5220-b5fb-9dadb44d9e5d" :answer/type :answer.type/math :answer/value "⟨1,2,0⟩" :db/ensure [:answer/validate]} {:db/id "answer-5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/id #uuid "5c4bd33c-8bb2-56f3-a03d-83062a02bb60" :answer/type :answer.type/math :answer/value "⟨2,-1,1⟩" :db/ensure [:answer/validate]} {:db/id "question-0174198f-a0ad-5395-9af8-f36d4c14897b" :question/id #uuid "0174198f-a0ad-5395-9af8-f36d4c14897b" :question/math-academy-id "q-71392" :question/problem "The intersection of the planes $-x+z-1=0$ and $y+z+5=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+0-1=0\\,⟹\\,x=-1,\n$$\n\nand substituting $z=0$ into the second equation gives\n\n$$\ny+0+5=0\\,⟹\\,y=-5.\n$$\n\nTherefore, $a=⟨-1,-5,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+z-1=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,0,1⟩.$\n\n- For the plane $y+z+5=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨-1,0,1⟩\\times ⟨0,1,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}\\right| \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩\\end{aligned}\n$$\n\nThus, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-5,0⟩+t⟨-1,1,-1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1+(-5)=-6,$ and $b=⟨-1,1,-1⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36"] :db/ensure [:question/validate]} {:db/id "answer-field-b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/id #uuid "b9c0353c-be95-5a9c-955e-2c015a02fd36" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer-field/choices ["answer-22825761-3cc9-54a0-9fb4-b992332a08ec" "answer-f182158c-1a39-52d9-93a0-587908c41e2d" "answer-82e54d6b-a318-5bff-8d8f-60506bb19284" "answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" "answer-8836d71d-2734-54f0-91d8-699ef75e1c78"] :db/ensure [:answer-field/validate]} {:db/id "answer-22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/id #uuid "22825761-3cc9-54a0-9fb4-b992332a08ec" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨-1,-1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-f182158c-1a39-52d9-93a0-587908c41e2d" :answer/id #uuid "f182158c-1a39-52d9-93a0-587908c41e2d" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-4,\\,b=⟨1,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/id #uuid "82e54d6b-a318-5bff-8d8f-60506bb19284" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-6,\\,b=⟨-1,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "answer-bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/id #uuid "bbe216cb-a5f0-5c32-89c9-5b3529ecb0d0" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨-1,1,1⟩" :db/ensure [:answer/validate]} {:db/id "answer-8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/id #uuid "8836d71d-2734-54f0-91d8-699ef75e1c78" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=6,\\,b=⟨1,1,-1⟩" :db/ensure [:answer/validate]} {:db/id "question-fad299b6-2750-5729-9622-52ccf21ff85a" :question/id #uuid "fad299b6-2750-5729-9622-52ccf21ff85a" :question/math-academy-id "q-71414" :question/problem "The intersection of the planes $x+2y+2z=0$ and $4x-2y+4z+8=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this into the first equation gives \n\n$$\nx+2(0)+2z=0\\,⟹\\,x=-2z,\n$$\n\nand substituting $y=0$ and $x=-2z$ into the second equation gives\n\n$$\n\\begin{aligned}4x-2y+4z+8 & =0 \\\\ 4(-2z)-2(0)+4z+8 & =0 \\\\ -4z & =-8 \\\\ z & =2.\\end{aligned}\n$$\n\nTherefore, $x=-2z=-4$ and $a=⟨-4,0,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+2z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,2⟩.$\n\n- For the plane $4x-2y+4z+8=0,$ a normal vector to the plane is ${n}_{2}=⟨4,-2,4⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,2⟩\\times ⟨4,-2,4⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 2 \\\\ 4 & -2 & 4\\end{aligned}\\right| \\\\  & =12i+4j-10k \\\\  & =⟨12,4,-10⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{2}({n}_{1}\\times {n}_{2})=⟨6,2,-5⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-4,0,2⟩+t⟨6,2,-5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{3}=-4+2=-2,$ and $b=⟨6,2,-5⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-55c226f4-65ae-55eb-8831-38644f8ba978"] :db/ensure [:question/validate]} {:db/id "answer-field-55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/id #uuid "55c226f4-65ae-55eb-8831-38644f8ba978" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer-field/choices ["answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" "answer-f462a311-ea89-555c-9281-1e9601a16c66" "answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" "answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" "answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8"] :db/ensure [:answer-field/validate]} {:db/id "answer-908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/id #uuid "908a5ab3-8788-5615-82bc-44ddb7d0ef8d" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=-1,\\,b=⟨6,4,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-f462a311-ea89-555c-9281-1e9601a16c66" :answer/id #uuid "f462a311-ea89-555c-9281-1e9601a16c66" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=-2,\\,b=⟨6,2,-5⟩" :db/ensure [:answer/validate]} {:db/id "answer-a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/id #uuid "a898a62f-1ba9-595b-99f1-d28e38c134b3" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=-4,\\,b=⟨6,2,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/id #uuid "3a7df74d-f1a4-5ac2-993c-3eae86fd0451" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=1,\\,b=⟨6,2,5⟩" :db/ensure [:answer/validate]} {:db/id "answer-f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/id #uuid "f66ecaf3-9ca2-57cf-a1ac-6666ad1e34d8" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{3}=2,\\,b=⟨6,-2,-5⟩" :db/ensure [:answer/validate]} {:db/id "question-e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/id #uuid "e8cdac5c-1e47-510f-8a9c-c4df54b69f10" :question/math-academy-id "q-71467" :question/problem "Given the two planes $3x-6y+1=0$ and $-x+2y=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $0.$\n\nII. The planes are parallel but not coincident.\n\nIII. The planes intersect in a straight line." :question/worked-solution "First, notice that:  \n\n- For the plane $3x-6y+1=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-6,0⟩.$\n\n- For the plane $-x+2y=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,2,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨3,-6,0⟩\\times ⟨-1,2,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -6 & 0 \\\\ -1 & 2 & 0\\end{aligned}\\right| \\\\  & =0i+0j+0k \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}=0$, the vectors ${n}_{1}$ and ${n}_{2}$ are parallel. However,  the second plane passes through the origin  $O(0,0,0)$ but the first plane doesn't: \n\n$$\n3(0)-6(0)+1=1\\ne 0\n$$\n\n So, the planes are parallel but not coincident.\n\n- Statement III is false. Since planes are parallel but not coincident, they cannot intersect.\n\nTherefore, only statements I and II are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99"] :db/ensure [:question/validate]} {:db/id "answer-field-2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/id #uuid "2364b0d7-2e01-5066-ae19-026ea99bfd99" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer-field/choices ["answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" "answer-df0cddb8-e92c-55c7-aa50-0c028229c858" "answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" "answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" "answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/id #uuid "0cd4e332-b156-59b1-ae2a-6ee0a08db8ae" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/id #uuid "df0cddb8-e92c-55c7-aa50-0c028229c858" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/id #uuid "b421ec28-5bd3-59b4-af01-a5ba41d5c3ce" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/id #uuid "9cd38e05-67b8-5a94-8742-6e3af398c4d8" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/id #uuid "41b5d577-0fb3-59f4-8ba7-b4b1fb1a2178" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} [:db/retract 17592186176252 :question/answer-fields 17592186173770] {:db/id 17592186175946 :knowledge-point/questions ["question-e1e17bba-2392-58cc-bb67-1a8adce57d23"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186176567 :question/problem "Suppose that a matrix $A$ has characteristic polynomial $p(\\lambda )={\\lambda }^{2}(3-\\lambda )^{4}(5+\\lambda )^{6},$ and for the eigenvalue $\\lambda =-5,$ there are exactly $2$ eigenvectors. If a basis of ${R}^{12}$ consists of linearly independent generalized eigenvectors of $A$, how many of these generalized eigenvectors of rank greater than $1$ correspond to the eigenvalue $\\lambda =-5?$" :question/worked-solution "The number of generalized eigenvectors of rank greater than $1$ that correspond to an eigenvalue $\\lambda $ is equal to the difference between the algebraic multiplicity and the geometric multiplicity of $\\lambda .$\n\nIn the characteristic polynomial\n\n$$\np(\\lambda )={\\lambda }^{2}(3-\\lambda )^{4}(5+\\lambda )^{6},\n$$\n\nwe see that the root $\\lambda =-5$ has multiplicity $6.$ So the algebraic multiplicity of the eigenvalue $\\lambda =-5$ is $6.$\n\nHowever, there are only $2$ eigenvectors corresponding to  the eigenvalue $\\lambda =-5,$ so the geometric multiplicity of the eigenvalue $\\lambda =-5$ is $2.$\n\nTherefore, the number of generalized eigenvectors of rank greater than $1$ corresponding to $\\lambda =-5$ is $6-2=4.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186175540 :answer-field/correct 17592186175544 :db/ensure [:answer-field/validate]} {:db/id "question-e1e17bba-2392-58cc-bb67-1a8adce57d23" :question/id #uuid "e1e17bba-2392-58cc-bb67-1a8adce57d23" :question/math-academy-id "q-109927" :question/problem "Suppose that a matrix $D$ has characteristic polynomial $p(\\lambda )=(\\lambda -7)^{3}(\\lambda +4)^{2}(\\lambda -9)^{9},$ the rank of $(D-9I)^{2}$ equals $11,$ and the rank of $(D-9I)^{3}$ equals $8.$ If a basis of ${R}^{14}$ consists of linearly independent generalized eigenvectors of $D$, how many of these are generalized eigenvectors of rank $3$ corresponding to the eigenvalue $\\lambda =9?$" :question/worked-solution "For the given matrix $D$ with eigenvalue $\\lambda =9,$ a generalized eigenvector of rank $3$ is a vector $v$ such that \n\n$$\n(D-9I)^{3}v=0\\,\\text{and}\\,(D-9I)^{2}v\\ne 0.\n$$\n\nNotice that $D$ must be a $14\\times 14$ matrix.\n\n- Since the rank of $(D-9I)^{2}$ equals $11,$ then by the rank-nullity theorem, we have that\n\n$$\n\\text{nullity}(D-9I)^{2}=14-11=3.\n$$\n\nSo, the solutions to $(D-9I)^{2}v=0$ form a subspace $\\text{Null}(D-9I)^{2}$ of dimension $3$ in ${R}^{14}.$\n\n- Since the rank of $(D-9I)^{3}$ equals $8,$  then by the rank-nullity theorem, we have that\n\n$$\n\\text{nullity}(D-9I)^{3}=14-8=6.\n$$\n\nSo, the solutions to $(D-9I)^{3}v=0$ form a subspace $\\text{Null}(D-9I)^{3}$ of dimension $6$ in ${R}^{14}.$\n\nSince $\\text{Null}(D-9I)^{2}$ is a subspace of dimension $3$ in $\\text{Null}(D-9I)^{3}$, which is a subspace of dimension $6,$ our basis can contain only $3$ vectors that lie in $\\text{Null}(D-9I)^{3}$ but does not lie in $\\text{Null}(D-9I)^{2}.$\n\nTherefore, there will be \n\n$$\n\\text{nullity}(D-9I)^{3}-\\text{nullity}(D-9I)^{2}=6-3=3\n$$\n\n generalized eigenvectors of rank $3$ corresponding to the eigenvalue $\\lambda =9.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f4be26dd-2c06-59f0-a37a-9169047bccde"] :db/ensure [:question/validate]} {:db/id "answer-field-f4be26dd-2c06-59f0-a37a-9169047bccde" :answer-field/id #uuid "f4be26dd-2c06-59f0-a37a-9169047bccde" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-169df782-f22f-53ee-888a-ef5dd9042bbf" :answer-field/choices ["answer-dbcd5536-0adc-5f39-92ab-7c7a8048c753" "answer-2155da94-081e-506a-911b-03855a5f2cbc" "answer-d0e04b3f-f522-5411-be37-966761ea2f01" "answer-169df782-f22f-53ee-888a-ef5dd9042bbf" "answer-e8356a21-b88d-5892-a5fb-1e440a90d6f3"] :db/ensure [:answer-field/validate]} {:db/id "answer-dbcd5536-0adc-5f39-92ab-7c7a8048c753" :answer/id #uuid "dbcd5536-0adc-5f39-92ab-7c7a8048c753" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-2155da94-081e-506a-911b-03855a5f2cbc" :answer/id #uuid "2155da94-081e-506a-911b-03855a5f2cbc" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-d0e04b3f-f522-5411-be37-966761ea2f01" :answer/id #uuid "d0e04b3f-f522-5411-be37-966761ea2f01" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-169df782-f22f-53ee-888a-ef5dd9042bbf" :answer/id #uuid "169df782-f22f-53ee-888a-ef5dd9042bbf" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-e8356a21-b88d-5892-a5fb-1e440a90d6f3" :answer/id #uuid "e8356a21-b88d-5892-a5fb-1e440a90d6f3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186176994 :tutorial/content "For some $n\\times n$ matrices, it's possible to construct a basis of $\\mathbb{R}^n$ consisting entirely of linearly independent eigenvectors of the matrix.\n\nFor example, the matrix\n\n$$\n[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & 5\\end{aligned}]\n$$\n\nhas eigenvalues $\\lambda_1 = 5, \\lambda_2 = 4,$ and $\\lambda_3 = 2,$ with corresponding linearly independent eigenvectors \n\n![](images/45/451c66729d04278ec42f1ffcc558245b5cd2ef14b0c3d14dbd35447702b7b873.svg)\nThese eigenvectors form a basis of $\\mathbb R^3.$\n\nHowever, there exist $n\\times n$ matrices whose eigenvectors do *not* form a basis of $\\mathbb R^n.$ \n\nFor example, the matrix\n\n![](images/65/653166c6712102e8afacb5e2a73de617a3777e6812d9abbeb760f72b664525b3.svg)\n\nhas the single eigenvalue ${\\color{black}\\lambda=4}$ of algebraic multiplicity $3.$ However, there are only two linearly independent eigenvectors corresponding to this eigenvalue, namely\n\n![](images/50/5007b5e49662ccb6aad508b233f4d107bdb89afc2607eee76280a16ec02d6f90.svg)\n\nSince there are only two linearly independent eigenvectors corresponding to this eigenvalue, we say that the **geometric multiplicity** of ${\\color{black}\\lambda=4}$ equals  $2.$" :db/ensure [:tutorial/validate]} {:db/id 17592186177053 :tutorial/content "So, not every $n\\times n$ matrix has the property that its eigenvectors form a basis of $\\mathbb R^n.$\n\nDespite this, we have the following theorem:\n\n*For any real $n \\times n$ matrix, there is a basis of $\\mathbb{R}^n$ consisting of generalized eigenvectors of the matrix.*\n\nTo illustrate, let's go back to our matrix \n![](images/d0/d09805a20bbc23954fdec5a893e05ec0bad45a6503e27354df60b4d71952f990.svg)\n\nwhere the eigenvectors corresponding to the single eigenvalue $\\lambda = 4$ are\n\n![](images/e6/e6053d03e5e0f4bc843856d88dbc9e8e14252200a5d7280a4a05872b19bd4d56.svg)\n\nRemember that $\\lambda = 4$ has *algebraic* multiplicity $3$ and *geometric* multiplicity $2.$\n\nNow, it's easy to show that $A$ has a generalized eigenvector of rank $2$ given by\n\n![](images/89/890d3b69aa88f0f442760d03afc7333d2e918b5b3401a33b167cfa40321a5f4c.svg)\nand our generalized eigenvectors form the following chains:\n\n$$\n\\begin{aligned}{{[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{w}\\overset{A-4I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]}_{⏟}}_{v}\\overset{A-4I\\,}{\\to }0 &  \\\\ {{[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{u}\\overset{A-4I\\,}{\\to }0\\end{aligned}\n$$\n\nClearly, ${\\color{blue}{\\mathbf{u}}}, {\\color{blue}{\\mathbf{v}}},$ and $\\color{red}\\mathbf{w}$ form a basis of $\\mathbb R^3.$ In particular, our basis consists of\n\n- two eigenvectors ($\\color{blue}\\mathbf{u}$ and $\\color{blue}\\mathbf{v}$), and\n\n- one generalized eigenvector whose rank is greater than one ($\\color{red}\\mathbf{w}$).\n\nNotice that the number of generalized eigenvectors of rank greater than $1$ equals\n\n$$\n\\begin{aligned}\\text{algebraic multiplicity}-\\text{geometric multiplicity} & =3-2=1.\\end{aligned}\n$$\n\nThis is no coincidence. In general, we have the following theorem:\n\n*The number of generalized eigenvectors of rank greater than $1$ that correspond to an eigenvalue $\\lambda$ equals the difference between the algebraic multiplicity and the geometric multiplicity of $\\lambda.$*" :db/ensure [:tutorial/validate]} {:db/id 17592186054662 :knowledge-point/questions ["question-e4bda52d-6631-58b0-bd68-5066bd3ff243" "question-e30d37ae-3013-5226-8257-f893cef40757"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054552 :question/problem "Anna surveys some students in a school, asking them what pets out of cats or dogs they have at home. Her findings are summarized in the two-way frequency table below. \n\n|  | Has a dog | Doesn't have a dog | Totals |\n| --- | --- | --- | --- |\n| Has a cat | $30$ | $56$ | $86$ |\n| Doesn't have a cat | $60$ | $54$ | $114$ |\n| Totals | $90$ | $110$ | $200$ |\n\nLet $C$ be the event that a randomly selected student in the school **\"Has a cat\"**, and $D$ be the event that a randomly selected student in the school **\"Has a dog\"**. Estimate $P(C \\cap D).$" :question/worked-solution "The event $C \\cap D$ is the event that a randomly selected student in the school has both a cat and a dog.\n\nTo estimate the probability of $C \\cap D,$ we need to \n\n- find the number at the intersection of the row **\"Has a cat\"** and the column **\"Has a dog\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe number at the intersection of the row **\"Has a cat\"** and the column **\"Has a dog\"** is highlighted in the table below.\n\n|  | Has a dog | Doesn't have a dog | Totals |\n| --- | --- | --- | --- |\n| Has a cat | $\\color{blue}30$ | $56$ | $86$ |\n| Doesn't have a cat | $60$ | $54$ | $114$ |\n| Totals | $90$ | $110$ | $200$ |\n\nDividing by the total number of data points in the table $(200),$ we get\n\n$$\nP(C \\cap D) = \\dfrac{30}{200} = 0.15.\n$$" :db/ensure [:question/validate]} {:db/id 17592186054661 :knowledge-point/questions ["question-9952b961-280f-5d1f-a0eb-bf2ca705ef14" "question-5c991f61-1cd6-5a73-ae3c-f2cc1cf3d784"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054551 :question/problem "In a class, each student selected one course among the two possible options, math or physics. The results are given in the two-way frequency table below.\n\n|  | Math | Physics | Totals |\n| --- | --- | --- | --- |\n| Female | $12$ | $12$ | $24$ |\n| Male | $20$ | $6$ | $26$ |\n| Totals | $32$ | $18$ | $50$ |\n\nEstimate the probability that a randomly chosen student selected physics or is male (or both)." :question/worked-solution "To estimate the probability that a randomly chosen student selected physics or is male, we\n\n- add up the numbers that are in the column **\"Physics\"** or the row **\"Male\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe numbers in the column **\"Physics\"** or the row **\"Male\"** are highlighted in the table below.\n\n|  | Math | Physics | Totals |\n| --- | --- | --- | --- |\n| Female | $12$ | $\\color{blue}12$ | $24$ |\n| Male | $\\color{blue}20$ | $\\color{blue}6$ | $26$ |\n| Totals | $32$ | $18$ | $50$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(50),$ we get\n\n$$\np =\\dfrac{12+20+6}{50} = \\dfrac{38}{50} =0.76.\n$$" :db/ensure [:question/validate]} {:db/id 17592186054663 :knowledge-point/questions ["question-7775a984-c5ac-5540-8a1b-b2aae6fb0655" "question-d65fd340-5d3c-5485-87ce-64ffa546bd48"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186054553 :question/problem "There are $250$ boys and $250$ girls in a school. Of them, $40$ boys and $40$ girls were randomly selected and asked which sport they prefer between volleyball, basketball, football, or soccer. The results of the survey are given in the two-way frequency table below.\n\n|  | Volleyball | Basketball | Football | Soccer | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girl | $14$ | $10$ | $2$ | $14$ | $40$ |\n| Boy | $8$ | $12$ | $11$ | $9$ | $40$ |\n| Totals | $22$ | $22$ | $13$ | $23$ | $80$ |\n\nEstimate the probability that a randomly selected student in the survey is a boy who prefers football or soccer, and then use this to estimate the number of students in the entire school who are boys that prefer football or soccer." :question/worked-solution "To estimate the probability that a randomly selected student is a boy who prefers football or soccer, we\n\n- add up the numbers at the intersection of the row **\"Boy\"** and the columns **\"Football\"** and **\"Soccer\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe numbers at the intersection of the row **\"Boy\"** and the columns **\"Football\"** and **\"Soccer\"** are highlighted in the table below.\n\n|  | Volleyball | Basketball | Football | Soccer | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girl | $14$ | $10$ | $2$ | $14$ | $40$ |\n| Boy | $8$ | $12$ | $\\color{blue}11$ | $\\color{blue}9$ | $40$ |\n| Totals | $22$ | $22$ | $13$ | $23$ | $80$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(80),$ we get\n\n$$\np = \\dfrac{11+9}{80} = \\dfrac{20}{80} = 0.25.\n$$\n\nThis represents the estimated probability that a randomly selected student is a boy who prefers football or soccer.\n\nFinally, to estimate the number of students in the entire school who are boys that prefer football or soccer, we multiply the total number of students in the school $(500)$ by the probability above:\n\n$$\n\\begin{aligned}n & =500\\cdot p \\\\  & =500\\cdot 0.25 \\\\  & =125\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-e4bda52d-6631-58b0-bd68-5066bd3ff243" :question/id #uuid "e4bda52d-6631-58b0-bd68-5066bd3ff243" :question/math-academy-id "q-120213" :question/problem "A survey asks a group of students about their eye color. The findings are summarized in the two-way frequency table below.\n\n|  | Green | Blue | Brown | Black | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $10$ | $12$ | $8$ | $10$ | $40$ |\n| Boys | $13$ | $12$ | $15$ | $20$ | $60$ |\n| Totals | $23$ | $24$ | $23$ | $30$ | $100$ |\n\nLet $B$ be the event that a randomly selected student is a **\"Boy\"**, and $C$ be the event that a randomly selected student has **\"Brown\"** eyes. Estimate $P(B\\cap C).$" :question/worked-solution "First, note that $B\\cap C$ is the event that a randomly selected student is a boy and has brown eyes. \n\nTo estimate the probability of $B\\cap C,$ we\n\n- find the number at the intersection of the row **\"Boys\"** and the column **\"Brown\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe number at the intersection of the row **\"Boys\"** and the column **\"Brown\"** is highlighted in the table below.\n\n|  | Green | Blue | Brown | Black | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $10$ | $12$ | $8$ | $10$ | $40$ |\n| Boys | $13$ | $12$ | $15$ | $20$ | $60$ |\n| Totals | $23$ | $24$ | $23$ | $30$ | $100$ |\n\nDividing by the total number of data points in the table $(100),$ we get\n\n$$\nP(B\\cap C)=\\frac{15}{100}=\\frac{3}{20}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9973b090-3528-53c7-bd3d-78df1d7984eb"] :db/ensure [:question/validate]} {:db/id "answer-field-9973b090-3528-53c7-bd3d-78df1d7984eb" :answer-field/id #uuid "9973b090-3528-53c7-bd3d-78df1d7984eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-190d1822-15e6-544f-9385-1f1a371a7f4a" :answer-field/choices ["answer-80f1cd68-0360-542c-a764-5f25fc1ae4fe" "answer-bfb6c481-65fa-5471-b76a-3501659d2594" "answer-29d873cd-bd5d-5487-a5cc-6d16874747e4" "answer-a69a67f1-d67f-55f6-bc86-fe6931a33ab2" "answer-190d1822-15e6-544f-9385-1f1a371a7f4a"] :db/ensure [:answer-field/validate]} {:db/id "answer-80f1cd68-0360-542c-a764-5f25fc1ae4fe" :answer/id #uuid "80f1cd68-0360-542c-a764-5f25fc1ae4fe" :answer/type :answer.type/math :answer/value "\\frac{11}{100}" :db/ensure [:answer/validate]} {:db/id "answer-bfb6c481-65fa-5471-b76a-3501659d2594" :answer/id #uuid "bfb6c481-65fa-5471-b76a-3501659d2594" :answer/type :answer.type/math :answer/value "\\frac{13}{100}" :db/ensure [:answer/validate]} {:db/id "answer-29d873cd-bd5d-5487-a5cc-6d16874747e4" :answer/id #uuid "29d873cd-bd5d-5487-a5cc-6d16874747e4" :answer/type :answer.type/math :answer/value "\\frac{1}{50}" :db/ensure [:answer/validate]} {:db/id "answer-a69a67f1-d67f-55f6-bc86-fe6931a33ab2" :answer/id #uuid "a69a67f1-d67f-55f6-bc86-fe6931a33ab2" :answer/type :answer.type/math :answer/value "\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "answer-190d1822-15e6-544f-9385-1f1a371a7f4a" :answer/id #uuid "190d1822-15e6-544f-9385-1f1a371a7f4a" :answer/type :answer.type/math :answer/value "\\frac{3}{20}" :db/ensure [:answer/validate]} {:db/id "question-e30d37ae-3013-5226-8257-f893cef40757" :question/id #uuid "e30d37ae-3013-5226-8257-f893cef40757" :question/math-academy-id "q-74424" :question/problem "Dana surveys $72$ randomly chosen students at her school, asking them if they have gerbils or rabbits at home. Her findings are summarized in the two-way frequency table below.\n\n|  | Has a rabbit | Doesn't have a rabbit | Totals |\n| --- | --- | --- | --- |\n| Has a gerbil | $18$ | $12$ | $30$ |\n| Doesn't have a gerbil | $6$ | $36$ | $42$ |\n| Totals | $24$ | $48$ | $72$ |\n\nEstimate the probability that a randomly chosen student at the school has a gerbil and also has a rabbit." :question/worked-solution "To estimate the probability that a randomly chosen student at the school has a gerbil and also has a rabbit, we\n\n- find the number at the intersection of the row **\"Has a gerbil\"** and the column **\"Has a rabbit\"**, and then\n\n- divide by the total number of data points in the table.\n\nThe number at the intersection of the row **\"Has a gerbil\"** and the column **\"Has a rabbit\"** is highlighted in the table below.\n\n|  | Has a rabbit | Doesn't have a rabbit | Totals |\n| --- | --- | --- | --- |\n| Has a gerbil | $18$ | $12$ | $30$ |\n| Doesn't have a gerbil | $6$ | $36$ | $42$ |\n| Totals | $24$ | $48$ | $72$ |\n\nDividing by the total number of data points in the table $(72),$ we get\n\n$$\np=\\frac{18}{72}=0.25.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0433ce33-a4a9-5267-807e-305c8929c939"] :db/ensure [:question/validate]} {:db/id "answer-field-0433ce33-a4a9-5267-807e-305c8929c939" :answer-field/id #uuid "0433ce33-a4a9-5267-807e-305c8929c939" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-57a0e54d-4f68-52ef-bcd6-35fdedddd325" :answer-field/choices ["answer-66c02dd9-17da-5354-94ef-38cd224eab8c" "answer-66fed658-14bf-5a34-8fa4-66c8e5cd9b96" "answer-57a0e54d-4f68-52ef-bcd6-35fdedddd325" "answer-e01bbae9-b081-583d-8d6f-1fd6591bc0fb" "answer-d026f55c-173b-52ab-8488-49e2ea0ff410"] :db/ensure [:answer-field/validate]} {:db/id "answer-66c02dd9-17da-5354-94ef-38cd224eab8c" :answer/id #uuid "66c02dd9-17da-5354-94ef-38cd224eab8c" :answer/type :answer.type/math :answer/value "0.08" :db/ensure [:answer/validate]} {:db/id "answer-66fed658-14bf-5a34-8fa4-66c8e5cd9b96" :answer/id #uuid "66fed658-14bf-5a34-8fa4-66c8e5cd9b96" :answer/type :answer.type/math :answer/value "0.17" :db/ensure [:answer/validate]} {:db/id "answer-57a0e54d-4f68-52ef-bcd6-35fdedddd325" :answer/id #uuid "57a0e54d-4f68-52ef-bcd6-35fdedddd325" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "answer-e01bbae9-b081-583d-8d6f-1fd6591bc0fb" :answer/id #uuid "e01bbae9-b081-583d-8d6f-1fd6591bc0fb" :answer/type :answer.type/math :answer/value "0.42" :db/ensure [:answer/validate]} {:db/id "answer-d026f55c-173b-52ab-8488-49e2ea0ff410" :answer/id #uuid "d026f55c-173b-52ab-8488-49e2ea0ff410" :answer/type :answer.type/math :answer/value "0.50" :db/ensure [:answer/validate]} {:db/id 17592186234062 :question/answer-fields ["answer-field-22e13ec8-77ce-5832-bf60-b058ef11f3f6"] :db/ensure [:question/validate]} {:db/id "answer-field-22e13ec8-77ce-5832-bf60-b058ef11f3f6" :answer-field/id #uuid "22e13ec8-77ce-5832-bf60-b058ef11f3f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-07424aae-1a8f-5e91-8cc7-dc60fa630f7e" :answer-field/choices ["answer-07424aae-1a8f-5e91-8cc7-dc60fa630f7e" "answer-8153d023-9387-553c-9617-5934a186fac9" "answer-dafcf6b4-a9e9-55f2-97fa-90ca94c757ec" "answer-f40875d7-a2ed-54b4-a8e6-34d0984f8575" "answer-37304a72-8df6-5b71-9b1f-3f7ac729e3cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-07424aae-1a8f-5e91-8cc7-dc60fa630f7e" :answer/id #uuid "07424aae-1a8f-5e91-8cc7-dc60fa630f7e" :answer/type :answer.type/math :answer/value "\\frac{19}{32}" :db/ensure [:answer/validate]} {:db/id "answer-8153d023-9387-553c-9617-5934a186fac9" :answer/id #uuid "8153d023-9387-553c-9617-5934a186fac9" :answer/type :answer.type/math :answer/value "\\frac{1}{19}" :db/ensure [:answer/validate]} {:db/id "answer-dafcf6b4-a9e9-55f2-97fa-90ca94c757ec" :answer/id #uuid "dafcf6b4-a9e9-55f2-97fa-90ca94c757ec" :answer/type :answer.type/math :answer/value "\\frac{1}{32}" :db/ensure [:answer/validate]} {:db/id "answer-f40875d7-a2ed-54b4-a8e6-34d0984f8575" :answer/id #uuid "f40875d7-a2ed-54b4-a8e6-34d0984f8575" :answer/type :answer.type/math :answer/value "\\frac{29}{32}" :db/ensure [:answer/validate]} {:db/id "answer-37304a72-8df6-5b71-9b1f-3f7ac729e3cb" :answer/id #uuid "37304a72-8df6-5b71-9b1f-3f7ac729e3cb" :answer/type :answer.type/math :answer/value "\\frac{5}{19}" :db/ensure [:answer/validate]} {:db/id "question-9952b961-280f-5d1f-a0eb-bf2ca705ef14" :question/id #uuid "9952b961-280f-5d1f-a0eb-bf2ca705ef14" :question/math-academy-id "q-47137" :question/problem "A randomly selected group of students from a high school were asked about their favorite sport between baseball, football, basketball, or soccer. The results of the survey are summarized in the two-way frequency table below.\n\n|  | Baseball | Football | Basketball | Soccer | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $10$ | $19$ | $10$ | $12$ | $51$ |\n| Boys | $10$ | $13$ | $20$ | $6$ | $49$ |\n| Totals | $20$ | $32$ | $30$ | $18$ | $100$ |\n\nLet $F$ be the event that a randomly selected student in the high school is a **\"Girl\"** whose favorite sport is **\"Football\"**, and $S$ be the event that a randomly selected student in the high school is a **\"Girl\"** whose favorite sport is **\"Soccer\"**. Estimate $P(F\\cup S).$" :question/worked-solution "First, note that $F\\cup S$ is the event that a randomly selected student in the high school is a girl whose favorite sport is football or a girl whose favorite sport is soccer. \n\nTo estimate the probability of $F\\cup S,$ we\n\n- add up the numbers in the columns **\"Football\"** or **\"Soccer\"** and the row **\"Girls\"**, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the columns **\"Football\"** or **\"Soccer\"** and the row **\"Girls\"** are highlighted below.\n\n|  | Baseball | Football | Basketball | Soccer | Totals |\n| --- | --- | --- | --- | --- | --- |\n| Girls | $10$ | $19$ | $10$ | $12$ | $51$ |\n| Boys | $10$ | $13$ | $20$ | $6$ | $49$ |\n| Totals | $20$ | $32$ | $30$ | $18$ | $100$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(100),$ we get\n\n$$\nP(F\\cup S)=\\frac{19+12}{100}=\\frac{31}{100}=0.31.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-84661f42-becc-5c57-a165-fc16451678cc"] :db/ensure [:question/validate]} {:db/id "answer-field-84661f42-becc-5c57-a165-fc16451678cc" :answer-field/id #uuid "84661f42-becc-5c57-a165-fc16451678cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-21106799-78c1-5b12-97b2-81a10265b2ac" :answer-field/choices ["answer-21106799-78c1-5b12-97b2-81a10265b2ac" "answer-0f5bd6d2-d38a-5a10-8544-11a2462b35d7" "answer-d9548fc2-50fc-5324-992f-44af5d618220" "answer-877aa175-6eda-5e56-a7fa-927dab2bcc2e" "answer-621d3fb4-01e5-586d-9831-a425cefbd44b"] :db/ensure [:answer-field/validate]} {:db/id "answer-21106799-78c1-5b12-97b2-81a10265b2ac" :answer/id #uuid "21106799-78c1-5b12-97b2-81a10265b2ac" :answer/type :answer.type/math :answer/value "0.31" :db/ensure [:answer/validate]} {:db/id "answer-0f5bd6d2-d38a-5a10-8544-11a2462b35d7" :answer/id #uuid "0f5bd6d2-d38a-5a10-8544-11a2462b35d7" :answer/type :answer.type/math :answer/value "0.41" :db/ensure [:answer/validate]} {:db/id "answer-d9548fc2-50fc-5324-992f-44af5d618220" :answer/id #uuid "d9548fc2-50fc-5324-992f-44af5d618220" :answer/type :answer.type/math :answer/value "0.51" :db/ensure [:answer/validate]} {:db/id "answer-877aa175-6eda-5e56-a7fa-927dab2bcc2e" :answer/id #uuid "877aa175-6eda-5e56-a7fa-927dab2bcc2e" :answer/type :answer.type/math :answer/value "0.59" :db/ensure [:answer/validate]} {:db/id "answer-621d3fb4-01e5-586d-9831-a425cefbd44b" :answer/id #uuid "621d3fb4-01e5-586d-9831-a425cefbd44b" :answer/type :answer.type/math :answer/value "0.79" :db/ensure [:answer/validate]} {:db/id 17592186055331 :question/problem "In a high school, a group of students was asked about whether they prefer apples, oranges, or bananas. The results are given in the two-way frequency table below.\n\n|  | Apple | Orange | Banana | Totals |\n| --- | --- | --- | --- | --- |\n| Girls | $11$ | $8$ | $7$ | $26$ |\n| Boys | $12$ | $6$ | $6$ | $24$ |\n| Totals | $23$ | $14$ | $13$ | $50$ |\n\nEstimate the probability that a randomly chosen student in the group preferred apples or bananas or is a girl." :question/worked-solution "To estimate the probability that a randomly chosen student preferred apples or bananas or is a girl, we\n\n- add up the numbers in the columns **\"Apple\"** or **\"Banana\"** or the row **\"Girls\"**, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the columns **\"Apple\"** or **\"Banana\"** or the row **\"Girls\"** are highlighted below.\n\n|  | Apple | Orange | Banana | Totals |\n| --- | --- | --- | --- | --- |\n| Girls | $11$ | $8$ | $7$ | $26$ |\n| Boys | $12$ | $6$ | $6$ | $24$ |\n| Totals | $23$ | $14$ | $13$ | $50$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(50),$ we get\n\n$$\np=\\frac{11+12+8+7+6}{50}=\\frac{44}{50}=0.88.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186053223 :answer-field/correct 17592186053226 :db/ensure [:answer-field/validate]} {:db/id "question-5c991f61-1cd6-5a73-ae3c-f2cc1cf3d784" :question/id #uuid "5c991f61-1cd6-5a73-ae3c-f2cc1cf3d784" :question/math-academy-id "q-120355" :question/problem "Some customers in a pizzeria were asked about the type of pizza they prefer between spicy pizza and vegetarian pizza. The results of the survey are summarized in the two-way frequency table below.\n\n|  | Prefers Spicy | Prefers  Vegetarian | Totals |\n| --- | --- | --- | --- |\n| Children | $10$ | $22$ | $32$ |\n| Adults | $41$ | $27$ | $68$ |\n| Totals | $51$ | $49$ | $100$ |\n\nEstimate the probability that a randomly chosen person is an adult or prefers spicy pizza (or both)." :question/worked-solution "To estimate the probability that a randomly chosen person is an adult or prefers spicy pizza, we\n\n- add up the numbers in the row **\"Adults\"** or the column **\"Prefers Spicy\"**, and\n\n- divide by the total number of data points in the table.\n\nThe numbers in the row **\"Adults\"** or the column **\"Prefers Spicy\"** are highlighted below.\n\n|  | Prefers Spicy | Prefers Vegetarian | Totals |\n| --- | --- | --- | --- |\n| Children | $10$ | $22$ | $32$ |\n| Adults | $41$ | $27$ | $68$ |\n| Totals | $51$ | $49$ | $100$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(100),$ we get\n\n$$\np=\\frac{10+41+27}{100}=\\frac{78}{100}=0.78.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4b1c7db9-a63f-5475-be38-0bf2636d125e"] :db/ensure [:question/validate]} {:db/id "answer-field-4b1c7db9-a63f-5475-be38-0bf2636d125e" :answer-field/id #uuid "4b1c7db9-a63f-5475-be38-0bf2636d125e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7171b77b-3a95-5010-8fc6-ab0b9e4f572b" :answer-field/choices ["answer-2a49678d-d723-5baf-a3f7-85df13a9862d" "answer-98f4c760-235f-57e5-970c-cc4ebdf54e1f" "answer-798f5e79-d365-55c8-b7b7-a04ca9d22c8f" "answer-7f2c18ee-e0db-54f6-a707-3ed8f48a6869" "answer-7171b77b-3a95-5010-8fc6-ab0b9e4f572b"] :db/ensure [:answer-field/validate]} {:db/id "answer-2a49678d-d723-5baf-a3f7-85df13a9862d" :answer/id #uuid "2a49678d-d723-5baf-a3f7-85df13a9862d" :answer/type :answer.type/math :answer/value "0.28" :db/ensure [:answer/validate]} {:db/id "answer-98f4c760-235f-57e5-970c-cc4ebdf54e1f" :answer/id #uuid "98f4c760-235f-57e5-970c-cc4ebdf54e1f" :answer/type :answer.type/math :answer/value "0.37" :db/ensure [:answer/validate]} {:db/id "answer-798f5e79-d365-55c8-b7b7-a04ca9d22c8f" :answer/id #uuid "798f5e79-d365-55c8-b7b7-a04ca9d22c8f" :answer/type :answer.type/math :answer/value "0.51" :db/ensure [:answer/validate]} {:db/id "answer-7f2c18ee-e0db-54f6-a707-3ed8f48a6869" :answer/id #uuid "7f2c18ee-e0db-54f6-a707-3ed8f48a6869" :answer/type :answer.type/math :answer/value "0.68" :db/ensure [:answer/validate]} {:db/id "answer-7171b77b-3a95-5010-8fc6-ab0b9e4f572b" :answer/id #uuid "7171b77b-3a95-5010-8fc6-ab0b9e4f572b" :answer/type :answer.type/math :answer/value "0.78" :db/ensure [:answer/validate]} {:db/id "question-7775a984-c5ac-5540-8a1b-b2aae6fb0655" :question/id #uuid "7775a984-c5ac-5540-8a1b-b2aae6fb0655" :question/math-academy-id "q-47294" :question/problem "Roger surveyed $62$ Jefferson High School students. He asked them if they like biology and chemistry. His findings are summarized in the two-way frequency table below.\n\n|  | Like biology | Doesn't like biology | Totals |\n| --- | --- | --- | --- |\n| Like chemistry | $25$ | $19$ | $44$ |\n| Doesn't like chemistry | $8$ | $10$ | $18$ |\n| Totals | $33$ | $29$ | $62$ |\n\nEdison High School has $500$ students. Assuming that the distribution of the results is the same in both high schools, determine the number of Edison High School students who like biology or chemistry but not both. Round your answer to the nearest integer." :question/worked-solution "To estimate the number of students who like biology or chemistry but not both, we\n\n- add up the numbers in the row **\"Like chemistry\"** or the column **\" Like biology\"**, but not in both, and then\n\n- divide by the total number of data points in the table.\n\n|  | Like biology | Doesn't like biology | Totals |\n| --- | --- | --- | --- |\n| Like chemistry | $25$ | $19$ | $44$ |\n| Doesn't like chemistry | $8$ | $10$ | $18$ |\n| Totals | $33$ | $29$ | $62$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(62),$ we get\n\n$$\np=\\frac{8+19}{62}=\\frac{27}{62}=0.435.\n$$\n\nThis represents the estimated probability that a randomly selected student likes biology or chemistry but not both.\n\nFinally, to find the estimated number of students of Edison High School who like biology or chemistry but not both, we multiply the total number of students in the Edison High School $(500)$ by the probability above:\n\n$$\n\\begin{aligned}n & =500\\cdot p \\\\  & =500\\cdot 0.435 \\\\  & =217.5 \\\\  & =218,\\end{aligned}\n$$\n\nrounded to the nearest integer." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-1883e150-ff1f-5b5f-b3d9-307772697e76"] :db/ensure [:question/validate]} {:db/id "answer-field-1883e150-ff1f-5b5f-b3d9-307772697e76" :answer-field/id #uuid "1883e150-ff1f-5b5f-b3d9-307772697e76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b86630e8-ba9b-59bc-8cc8-16a010d23bdb" :answer-field/choices ["answer-1b9ae188-7070-59ce-83f7-d90031a412cd" "answer-b86630e8-ba9b-59bc-8cc8-16a010d23bdb" "answer-23b47667-2432-502e-9d89-0418efac7dc4" "answer-8ab12cea-17ac-5923-b8f1-01577e5c7cb2" "answer-9ddef87b-6f35-5758-8f4e-c95aa2e3bf37"] :db/ensure [:answer-field/validate]} {:db/id "answer-1b9ae188-7070-59ce-83f7-d90031a412cd" :answer/id #uuid "1b9ae188-7070-59ce-83f7-d90031a412cd" :answer/type :answer.type/math :answer/value "205" :db/ensure [:answer/validate]} {:db/id "answer-b86630e8-ba9b-59bc-8cc8-16a010d23bdb" :answer/id #uuid "b86630e8-ba9b-59bc-8cc8-16a010d23bdb" :answer/type :answer.type/math :answer/value "218" :db/ensure [:answer/validate]} {:db/id "answer-23b47667-2432-502e-9d89-0418efac7dc4" :answer/id #uuid "23b47667-2432-502e-9d89-0418efac7dc4" :answer/type :answer.type/math :answer/value "230" :db/ensure [:answer/validate]} {:db/id "answer-8ab12cea-17ac-5923-b8f1-01577e5c7cb2" :answer/id #uuid "8ab12cea-17ac-5923-b8f1-01577e5c7cb2" :answer/type :answer.type/math :answer/value "240" :db/ensure [:answer/validate]} {:db/id "answer-9ddef87b-6f35-5758-8f4e-c95aa2e3bf37" :answer/id #uuid "9ddef87b-6f35-5758-8f4e-c95aa2e3bf37" :answer/type :answer.type/math :answer/value "250" :db/ensure [:answer/validate]} {:db/id 17592186055329 :question/problem "A group of randomly selected students from School A was asked about whether or not they use TV or the internet to access the local news. The results of the survey are summarized in the two-way frequency table below.\n\n|  | TV | No TV | Totals |\n| --- | --- | --- | --- |\n| Internet | $90$ | $15$ | $105$ |\n| No internet | $30$ | $15$ | $45$ |\n| Totals | $120$ | $30$ | $150$ |\n\nThere are $100$ students in School B. Assuming that the distribution of the results is the same for both schools, \nestimate the number of School B students that access the local news either from TV or the internet, but not both." :question/worked-solution "To estimate the probability that a randomly selected student gets the local news either from TV or the internet but not both, we\n\n- add up the numbers in the row **\"No internet\"** or the column **\"TV\"**, but not in both, and then\n\n- divide by the total number of data points in the table.\n\n|  | TV | No TV | Totals |\n| --- | --- | --- | --- |\n| Internet | $90$ | $15$ | $105$ |\n| No internet | $30$ | $15$ | $45$ |\n| Totals | $120$ | $30$ | $150$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(150),$ we get\n\n$$\np=\\frac{30+15}{150}=\\frac{45}{150}=0.3.\n$$\n\nThis represents the estimated probability that a randomly selected student gets the local news from TV or the internet but not both.\n\nFinally, to find the estimated number of students of School B that get their local news either from TV or the internet but not both, we multiply the total number of students in the school $(100)$ by the probability above:\n\n$$\n\\begin{aligned}n & =100\\cdot p \\\\  & =100\\cdot 0.3 \\\\  & =30\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186053211 :answer-field/correct 17592186053215 :db/ensure [:answer-field/validate]} {:db/id "question-d65fd340-5d3c-5485-87ce-64ffa546bd48" :question/id #uuid "d65fd340-5d3c-5485-87ce-64ffa546bd48" :question/math-academy-id "q-120744" :question/problem "A group of randomly selected customers from a certain insurance company was asked about the type of vehicle driven and whether they received a speeding ticket in the last year. The results of the survey are summarized in the two-way frequency table below.\n\n|  | SUV | Sport car | Totals |\n| --- | --- | --- | --- |\n| Speeding ticket | $80$ | $5$ | $85$ |\n| No speeding ticket | $20$ | $5$ | $25$ |\n| Totals | $100$ | $10$ | $110$ |\n\nThere are $220$ drivers in another insurance company. Assuming that the distribution of the results is the same for both companies, estimate the number of drivers in the second insurance company that drive SUV or received a speeding ticket, but not both." :question/worked-solution "To estimate the probability that a randomly selected driver drives the SUV or received a speeding ticket but not both, we\n\n- add up the numbers in the row **\"Speeding ticket\"** or the column **\"SUV\"**, but not in both, and then\n\n- divide by the total number of data points in the table.\n\n|  | SUV | Sport car | Totals |\n| --- | --- | --- | --- |\n| Speeding ticket | $80$ | $5$ | $85$ |\n| No speeding ticket | $20$ | $5$ | $25$ |\n| Totals | $100$ | $10$ | $110$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(110),$ we get\n\n$$\np=\\frac{20+5}{110}=\\frac{5}{22}.\n$$\n\nThis represents the estimated probability that a randomly selected driver drives an SUV or received a speeding ticket but not both.\n\nFinally, to find the estimated number of drivers in the second company that drive SUVs or received a speeding ticket, but not both, we multiply the total number of drivers in the company $(220)$ by the probability above:\n\n$$\n\\begin{aligned}n & =220\\cdot p \\\\  & =220\\cdot \\frac{5}{22} \\\\  & =50\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-563810e7-f31e-5609-8eea-711388584e00"] :db/ensure [:question/validate]} {:db/id "answer-field-563810e7-f31e-5609-8eea-711388584e00" :answer-field/id #uuid "563810e7-f31e-5609-8eea-711388584e00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2488f5ae-cfa6-5394-80ad-3eda46d13152" :answer-field/choices ["answer-1bcb8eb2-1560-57cf-a874-7ed572879682" "answer-aa6ac013-5d00-5a8c-8c3b-61dfe2fc8fac" "answer-2488f5ae-cfa6-5394-80ad-3eda46d13152" "answer-314daf73-8d31-5f75-8059-c0cc9efa2cb2" "answer-42cbdb5d-db43-53b8-9021-b975a8784198"] :db/ensure [:answer-field/validate]} {:db/id "answer-1bcb8eb2-1560-57cf-a874-7ed572879682" :answer/id #uuid "1bcb8eb2-1560-57cf-a874-7ed572879682" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-aa6ac013-5d00-5a8c-8c3b-61dfe2fc8fac" :answer/id #uuid "aa6ac013-5d00-5a8c-8c3b-61dfe2fc8fac" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-2488f5ae-cfa6-5394-80ad-3eda46d13152" :answer/id #uuid "2488f5ae-cfa6-5394-80ad-3eda46d13152" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "answer-314daf73-8d31-5f75-8059-c0cc9efa2cb2" :answer/id #uuid "314daf73-8d31-5f75-8059-c0cc9efa2cb2" :answer/type :answer.type/math :answer/value "55" :db/ensure [:answer/validate]} {:db/id "answer-42cbdb5d-db43-53b8-9021-b975a8784198" :answer/id #uuid "42cbdb5d-db43-53b8-9021-b975a8784198" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id 17592186055977 :tutorial/content "Sometimes, we want to find the probability that two or more events co-occur (occur together). Events like this, involving a combination of two or more events, are called **compound events**.\n\nFor instance, the $100$ members of a volleyball club were asked about their preferences between Chinese food and Italian pizza. The results of the survey are represented in the two-way frequency table below.\n\n|  | Chinese food | Italian pizza | Totals |\n| --- | --- | --- | --- |\n| Male | $20$ | $35$ | $55$ |\n| Female | $20$ | $25$ | $45$ |\n| Totals | $40$ | $60$ | $100$ |\n\nSuppose that we want to find the probability that a randomly selected club member is a male that prefers pizza. \n\nFirst, let $A$ be the event that a randomly selected member is **\"Male\"** and let $B$ be the event that a randomly selected member prefers **\"Italian pizza\"**. \n\nThe probability that $A$ *and* $B$ co-occur, denoted by $P(A\\cap B)$ and called the **intersection**, is found by identifying the intersection of these events in the table.\n\nThe number at the intersection of the column **\"Italian pizza\"** and the row **\"Male\"** is highlighted in the table below.\n\n|  | Chinese food | Italian pizza | Totals |\n| --- | --- | --- | --- |\n| Male | $20$ | $\\color{blue}35$ | $55$ |\n| Female | $20$ | $25$ | $45$ |\n| Totals | $40$ | $60$ | $100$ |\n\nDividing this number by the total number of data points in the table $(100),$ we get\n\n$$\n\\begin{aligned}P(A\\cap B) & =\\frac{35}{100} \\\\  & =0.35.\\end{aligned}\n$$\n\nThis represents the experimental probability that a randomly selected member prefers Italian pizza and is male." :db/ensure [:tutorial/validate]} {:db/id 17592186055990 :tutorial/content "Let's return to our first example, where the Volleyball club members were asked about whether they preferred Italian pizza or Chinese food. The data is shown below.\n\n|  | Chinese food | Italian pizza | Totals |\n| --- | --- | --- | --- |\n| Male | $20$ | $35$ | $55$ |\n| Female | $20$ | $25$ | $45$ |\n| Totals | $40$ | $60$ | $100$ |\n\nSuppose we want to find the probability that a randomly selected club member either prefers Chinese food *or* is female (or both).\n\nLet $A$ be the event that a randomly selected member prefers **\"Chinese food\"** and let $B$ be the event that a randomly selected member is **\"Female\"**.\n\nThe probability that $A$ *or* $B$ (or both) occurs, denoted by $P(A\\cup B)$ and called the **union**, is found by counting the number of data points in which $A$ or $B$ occurred and dividing by the total number of data points in the table.\n\nThe numbers that are in *either* the column **\"Chinese food\"** *or* the row **\"Female\"** (or both) are highlighted in the table below.\n\n|  | Chinese food | Italian pizza | Totals |\n| --- | --- | --- | --- |\n| Male | $\\color{blue}20$ | $35$ | $55$ |\n| Female | $\\color{blue}20$ | $\\color{blue}25$ | $45$ |\n| Totals | $40$ | $60$ | $100$ |\n\nAdding up these numbers and then dividing by the total number of data points in the table $(100),$ we get\n\n$$\n\\begin{aligned}P(A\\cup B) & =\\frac{20+20+25}{100} \\\\  & =\\frac{65}{100} \\\\  & =0.65.\\end{aligned}\n$$\n\nThis represents the experimental probability that a randomly selected member prefers Chinese food or is female." :db/ensure [:tutorial/validate]} {:db/id 17592186054881 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id "activity-df577f25-b0a4-5daa-82ef-951b1d2dfd83" :activity/id #uuid "df577f25-b0a4-5daa-82ef-951b1d2dfd83" :activity/title "Solving Systems of ODEs Using Variation of Parameters" :activity/type :activity.type/review :activity/scope 17592186050355 :activity/course 17592186046669 :activity/steps ["step-ba8073de-dbf8-5697-a990-a4825b3aac2c" "step-5cce2179-548a-59f3-94ad-818e4e5d8cd9" "step-51656c9a-5200-5dd2-a11d-3e8fe941feb3" "step-fe67e759-9ecb-5ecd-acd8-a273030a170d" "step-6b735c74-4427-57dc-9b20-5fac5bab4f02"] :activity/first-step "step-ba8073de-dbf8-5697-a990-a4825b3aac2c" :db/ensure [:activity/validate]} {:db/id "step-ba8073de-dbf8-5697-a990-a4825b3aac2c" :step/id #uuid "ba8073de-dbf8-5697-a990-a4825b3aac2c" :step/content 17592186483418 :step/next "step-5cce2179-548a-59f3-94ad-818e4e5d8cd9" :db/ensure [:step/validate]} {:db/id "step-5cce2179-548a-59f3-94ad-818e4e5d8cd9" :step/id #uuid "5cce2179-548a-59f3-94ad-818e4e5d8cd9" :step/content 17592186167263 :step/next "step-51656c9a-5200-5dd2-a11d-3e8fe941feb3" :db/ensure [:step/validate]} {:db/id "step-51656c9a-5200-5dd2-a11d-3e8fe941feb3" :step/id #uuid "51656c9a-5200-5dd2-a11d-3e8fe941feb3" :step/content 17592186483382 :step/next "step-fe67e759-9ecb-5ecd-acd8-a273030a170d" :db/ensure [:step/validate]} {:db/id "step-fe67e759-9ecb-5ecd-acd8-a273030a170d" :step/id #uuid "fe67e759-9ecb-5ecd-acd8-a273030a170d" :step/content 17592186311833 :step/next "step-6b735c74-4427-57dc-9b20-5fac5bab4f02" :db/ensure [:step/validate]} {:db/id "step-6b735c74-4427-57dc-9b20-5fac5bab4f02" :step/id #uuid "6b735c74-4427-57dc-9b20-5fac5bab4f02" :step/content 17592186311834 :db/ensure [:step/validate]} {:db/id 17592186175908 :knowledge-point/questions ["question-f7ee9ca4-a3f0-5a8a-a26b-4c46c8822ae6" "question-600419ab-eff5-5dfa-9145-b6a621ba7867" "question-f03fefa6-3a2e-5378-840e-6b0b6beb7bc1"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f7ee9ca4-a3f0-5a8a-a26b-4c46c8822ae6" :question/id #uuid "f7ee9ca4-a3f0-5a8a-a26b-4c46c8822ae6" :question/math-academy-id "q-47794" :question/problem "Solve the equation $\\frac{9}{6x-3}=\\frac{2}{3x+1}.$" :question/worked-solution "First, note that $x=\\frac{1}{2}$ and $x=-\\frac{1}{3}$ cannot be solutions since division by $0$ is undefined. \n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{9}{6x-3} & =\\frac{2}{3x+1} \\\\ 9\\cdot (3x+1) & =(6x-3)\\cdot 2 \\\\ 27x+9 & =12x-6\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}27x+9 & =12x-6 \\\\ 27x+9-12x & =12x-6-12x \\\\ 15x+9 & =-6 \\\\ 15x+9-9 & =-6-9 \\\\ 15x & =-15 \\\\ \\frac{15x}{15} & =\\frac{-15}{15} \\\\ x & =-1\\end{aligned}\n$$\n\nSince  $x=-1$ is different from $x=\\frac{1}{2}$ and $x=-\\frac{1}{3},$ we can accept it as a solution.\nThus, the solution is $x=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f814dc0c-188f-574f-b854-176c72a87e74"] :db/ensure [:question/validate]} {:db/id "answer-field-f814dc0c-188f-574f-b854-176c72a87e74" :answer-field/id #uuid "f814dc0c-188f-574f-b854-176c72a87e74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-174a201d-f58e-5ec3-aa26-3df65a0919fb" :answer-field/choices ["answer-174a201d-f58e-5ec3-aa26-3df65a0919fb" "answer-3fd1f6a6-e59a-5fdb-8f79-06248ac10397" "answer-6c45b276-24f3-5a57-bccd-2046b40c3894" "answer-1b9ee885-f816-536a-9a4b-66917e71b76e" "answer-a2f762a9-8f3f-5725-8c3d-a647af718df0"] :db/ensure [:answer-field/validate]} {:db/id "answer-174a201d-f58e-5ec3-aa26-3df65a0919fb" :answer/id #uuid "174a201d-f58e-5ec3-aa26-3df65a0919fb" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-3fd1f6a6-e59a-5fdb-8f79-06248ac10397" :answer/id #uuid "3fd1f6a6-e59a-5fdb-8f79-06248ac10397" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "answer-6c45b276-24f3-5a57-bccd-2046b40c3894" :answer/id #uuid "6c45b276-24f3-5a57-bccd-2046b40c3894" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{14}" :db/ensure [:answer/validate]} {:db/id "answer-1b9ee885-f816-536a-9a4b-66917e71b76e" :answer/id #uuid "1b9ee885-f816-536a-9a4b-66917e71b76e" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-a2f762a9-8f3f-5725-8c3d-a647af718df0" :answer/id #uuid "a2f762a9-8f3f-5725-8c3d-a647af718df0" :answer/type :answer.type/math :answer/value "x=\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "question-600419ab-eff5-5dfa-9145-b6a621ba7867" :question/id #uuid "600419ab-eff5-5dfa-9145-b6a621ba7867" :question/math-academy-id "q-51471" :question/problem "Solve the equation $\\frac{2}{3x+12}=\\frac{2}{x+4}.$" :question/worked-solution "First, note that $x=-4$ cannot be a solution since division by $0$ is undefined. \n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{2}{3x+12} & =\\frac{2}{x+4} \\\\ 2\\cdot (x+4) & =(3x+12)\\cdot 2 \\\\ 2x+8 & =6x+24\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}2x+8 & =6x+24 \\\\ 2x+8-24 & =6x+24-24 \\\\ 2x-16 & =6x \\\\ 2x-16-2x & =6x-2x \\\\ -16 & =4x \\\\ \\frac{-16}{4} & =\\frac{4x}{4} \\\\ -4 & =x\\end{aligned}\n$$\n\nSince $x=-4$ cannot be a solution, the equation has no solutions." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-842edd8c-d49e-5de9-8d9e-73cf9af84901"] :db/ensure [:question/validate]} {:db/id "answer-field-842edd8c-d49e-5de9-8d9e-73cf9af84901" :answer-field/id #uuid "842edd8c-d49e-5de9-8d9e-73cf9af84901" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-32f4c6f4-178d-5d4f-9cff-30346f3dab9e" :answer-field/choices ["answer-889b7794-6975-5412-ab18-7cd2f1fda6ba" "answer-fa1934be-efbe-592e-ba9b-fcbe1eb325e9" "answer-b4f50d04-a640-5bf1-aa0f-e78901fe54e3" "answer-4a7a45de-e0ec-5bc5-ba26-4cf78d2fefc9" "answer-32f4c6f4-178d-5d4f-9cff-30346f3dab9e"] :db/ensure [:answer-field/validate]} {:db/id "answer-889b7794-6975-5412-ab18-7cd2f1fda6ba" :answer/id #uuid "889b7794-6975-5412-ab18-7cd2f1fda6ba" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-fa1934be-efbe-592e-ba9b-fcbe1eb325e9" :answer/id #uuid "fa1934be-efbe-592e-ba9b-fcbe1eb325e9" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b4f50d04-a640-5bf1-aa0f-e78901fe54e3" :answer/id #uuid "b4f50d04-a640-5bf1-aa0f-e78901fe54e3" :answer/type :answer.type/math :answer/value "x=4" :db/ensure [:answer/validate]} {:db/id "answer-4a7a45de-e0ec-5bc5-ba26-4cf78d2fefc9" :answer/id #uuid "4a7a45de-e0ec-5bc5-ba26-4cf78d2fefc9" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "answer-32f4c6f4-178d-5d4f-9cff-30346f3dab9e" :answer/id #uuid "32f4c6f4-178d-5d4f-9cff-30346f3dab9e" :answer/type :answer.type/text :answer/value "No solutions" :db/ensure [:answer/validate]} {:db/id "question-f03fefa6-3a2e-5378-840e-6b0b6beb7bc1" :question/id #uuid "f03fefa6-3a2e-5378-840e-6b0b6beb7bc1" :question/math-academy-id "q-102818" :question/problem "Solve the equation $\\frac{1}{x-1}=\\frac{2}{x+3}.$" :question/worked-solution "First, note that $x=-3$ and $x=1$ cannot be solutions since division by $0$ is undefined.\n\nTo solve the equation, we first apply cross-multiplication:\n\n$$\n\\begin{aligned}\\frac{1}{x-1} & =\\frac{2}{x+3} \\\\ 1\\cdot (x+3) & =(x-1)\\cdot 2 \\\\ x+3 & =2x-2\\end{aligned}\n$$\n\nThen, we apply the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}x+3 & =2x-2 \\\\ x+3-x & =2x-2-x \\\\ 3 & =x-2 \\\\ 3+2 & =x-2+2 \\\\ 5 & =x\\end{aligned}\n$$\n\nSince $x=5$ is different from $x=-3$ and $x=1,$ we can accept it as a solution. Thus, the solution is $x=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a808e838-88e8-51e8-8659-395345d61b0f"] :db/ensure [:question/validate]} {:db/id "answer-field-a808e838-88e8-51e8-8659-395345d61b0f" :answer-field/id #uuid "a808e838-88e8-51e8-8659-395345d61b0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-672174dc-c76d-54f0-9e26-076639ae8482" :answer-field/choices ["answer-2580ada9-6aad-537f-845b-f3e63bd554dd" "answer-029cf53c-ae6d-5d8b-9043-5e9d44910d40" "answer-c1fb6cc6-e2e8-5330-99ad-14aa63b61123" "answer-1e358410-36f2-52bb-a6b8-0503c41957c0" "answer-672174dc-c76d-54f0-9e26-076639ae8482"] :db/ensure [:answer-field/validate]} {:db/id "answer-2580ada9-6aad-537f-845b-f3e63bd554dd" :answer/id #uuid "2580ada9-6aad-537f-845b-f3e63bd554dd" :answer/type :answer.type/math :answer/value "x=-1" :db/ensure [:answer/validate]} {:db/id "answer-029cf53c-ae6d-5d8b-9043-5e9d44910d40" :answer/id #uuid "029cf53c-ae6d-5d8b-9043-5e9d44910d40" :answer/type :answer.type/math :answer/value "x=-2" :db/ensure [:answer/validate]} {:db/id "answer-c1fb6cc6-e2e8-5330-99ad-14aa63b61123" :answer/id #uuid "c1fb6cc6-e2e8-5330-99ad-14aa63b61123" :answer/type :answer.type/math :answer/value "x=-7" :db/ensure [:answer/validate]} {:db/id "answer-1e358410-36f2-52bb-a6b8-0503c41957c0" :answer/id #uuid "1e358410-36f2-52bb-a6b8-0503c41957c0" :answer/type :answer.type/math :answer/value "x=3" :db/ensure [:answer/validate]} {:db/id "answer-672174dc-c76d-54f0-9e26-076639ae8482" :answer/id #uuid "672174dc-c76d-54f0-9e26-076639ae8482" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "activity-1b14901e-c955-5627-a3c0-254c47f97349" :activity/id #uuid "1b14901e-c955-5627-a3c0-254c47f97349" :activity/title "Solving Rational Equations Containing Binomials Using Cross-Multiplication" :activity/type :activity.type/review :activity/scope 17592186048144 :activity/course 17592186046647 :activity/steps ["step-544b0bbe-7699-51f8-ab7e-6267f3303aae" "step-6e6e733b-eaf0-5101-bc15-75bd30fffd8b" "step-06eb6fa1-dfb2-5b2c-acc7-dce9cf39f5b3"] :activity/first-step "step-544b0bbe-7699-51f8-ab7e-6267f3303aae" :db/ensure [:activity/validate]} {:db/id "step-544b0bbe-7699-51f8-ab7e-6267f3303aae" :step/id #uuid "544b0bbe-7699-51f8-ab7e-6267f3303aae" :step/content "question-f7ee9ca4-a3f0-5a8a-a26b-4c46c8822ae6" :step/next "step-6e6e733b-eaf0-5101-bc15-75bd30fffd8b" :db/ensure [:step/validate]} {:db/id "step-6e6e733b-eaf0-5101-bc15-75bd30fffd8b" :step/id #uuid "6e6e733b-eaf0-5101-bc15-75bd30fffd8b" :step/content "question-600419ab-eff5-5dfa-9145-b6a621ba7867" :step/next "step-06eb6fa1-dfb2-5b2c-acc7-dce9cf39f5b3" :db/ensure [:step/validate]} {:db/id "step-06eb6fa1-dfb2-5b2c-acc7-dce9cf39f5b3" :step/id #uuid "06eb6fa1-dfb2-5b2c-acc7-dce9cf39f5b3" :step/content "question-f03fefa6-3a2e-5378-840e-6b0b6beb7bc1" :db/ensure [:step/validate]} {:db/id 17592186115279 :knowledge-point/questions ["question-80a74124-ec47-55a3-9e24-4bd2a521aa8c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-80a74124-ec47-55a3-9e24-4bd2a521aa8c" :question/id #uuid "80a74124-ec47-55a3-9e24-4bd2a521aa8c" :question/math-academy-id "q-3488" :question/problem "Which of the following is equivalent to $\\frac{3{n}^{2}+15n+18}{{n}^{2}+4n+4}?$" :question/worked-solution "We factor the numerator and denominator, canceling out any common factors that appear in both.\n\n$$\n\\begin{aligned}\\frac{3{n}^{2}+15n+18}{{n}^{2}+4n+4} & =\\frac{3({n}^{2}+5n+6)}{{n}^{2}+4n+4} \\\\  & =\\frac{3(n+3)(n+2)}{(n+2)(n+2)} \\\\  & =\\frac{3(n+3)\\cancel{(n+2)}}{(n+2)\\cancel{(n+2)}} \\\\  & =\\frac{3(n+3)}{n+2} \\\\  & =\\frac{3n+9}{n+2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-136bc470-9c8a-559a-8356-694cb123166f"] :db/ensure [:question/validate]} {:db/id "answer-field-136bc470-9c8a-559a-8356-694cb123166f" :answer-field/id #uuid "136bc470-9c8a-559a-8356-694cb123166f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0cf3dbed-1703-5b05-93dc-b37b08d4a82e" :answer-field/choices ["answer-4280fe2d-0adf-5531-bf2e-d7764e07d575" "answer-39e44e38-e794-51af-ad5d-9b587ae72e0e" "answer-a441ed5a-7914-56cb-b2d9-8fa07a623a90" "answer-0cf3dbed-1703-5b05-93dc-b37b08d4a82e" "answer-42e7fc1e-cc93-5bae-9631-3b795d5b8a67"] :db/ensure [:answer-field/validate]} {:db/id "answer-4280fe2d-0adf-5531-bf2e-d7764e07d575" :answer/id #uuid "4280fe2d-0adf-5531-bf2e-d7764e07d575" :answer/type :answer.type/math :answer/value "\\frac{3(n+2)}{n+3}" :db/ensure [:answer/validate]} {:db/id "answer-39e44e38-e794-51af-ad5d-9b587ae72e0e" :answer/id #uuid "39e44e38-e794-51af-ad5d-9b587ae72e0e" :answer/type :answer.type/math :answer/value "\\frac{3n+6}{n+2}" :db/ensure [:answer/validate]} {:db/id "answer-a441ed5a-7914-56cb-b2d9-8fa07a623a90" :answer/id #uuid "a441ed5a-7914-56cb-b2d9-8fa07a623a90" :answer/type :answer.type/math :answer/value "\\frac{3n+6}{n+3}" :db/ensure [:answer/validate]} {:db/id "answer-0cf3dbed-1703-5b05-93dc-b37b08d4a82e" :answer/id #uuid "0cf3dbed-1703-5b05-93dc-b37b08d4a82e" :answer/type :answer.type/math :answer/value "\\frac{3n+9}{n+2}" :db/ensure [:answer/validate]} {:db/id "answer-42e7fc1e-cc93-5bae-9631-3b795d5b8a67" :answer/id #uuid "42e7fc1e-cc93-5bae-9631-3b795d5b8a67" :answer/type :answer.type/math :answer/value "\\frac{3n+9}{n+3}" :db/ensure [:answer/validate]} {:db/id 17592186115272 :knowledge-point/questions ["question-0c6bffa8-a78e-5e02-8975-6f49c316264d"] :db/ensure [:knowledge-point/validate]} {:db/id "question-0c6bffa8-a78e-5e02-8975-6f49c316264d" :question/id #uuid "0c6bffa8-a78e-5e02-8975-6f49c316264d" :question/math-academy-id "q-112994" :question/problem "What is $\\frac{5{h}^{2}-10h-75}{h+3}$ reduced to lowest terms?" :question/worked-solution "The numerator can be factored as\n\n$$\n5{h}^{2}-10h-75=5({h}^{2}-2h-15)=5(h-5)(h+3).\n$$\n\nCanceling out any common factors that appear in the numerator and the denominator, we get\n\n$$\n\\begin{aligned}\\frac{5{h}^{2}-10h-75}{h+3} & = \\\\ \\frac{5(h-5)(h+3)}{h+3} & = \\\\ \\frac{5(h-5)\\cancel{(h+3)}}{\\cancel{h+3}} & = \\\\ \\frac{5(h-5)}{1} & = \\\\ 5h-25 & .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7505a7c9-8965-5038-af54-42cf0716d0a0"] :db/ensure [:question/validate]} {:db/id "answer-field-7505a7c9-8965-5038-af54-42cf0716d0a0" :answer-field/id #uuid "7505a7c9-8965-5038-af54-42cf0716d0a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd4c551c-c05a-570f-9f97-6911d7e8970e" :answer-field/choices ["answer-a5c62dbc-9eb7-5b0e-9f7c-6b7a00979eee" "answer-dd4c551c-c05a-570f-9f97-6911d7e8970e" "answer-c22acf02-c6c6-5c01-be71-8571630d69d3" "answer-7a19ebb9-eb32-5f26-b024-e4e111e111e7" "answer-9a149eb4-3b76-5d09-90e7-b82fe272cdf3"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5c62dbc-9eb7-5b0e-9f7c-6b7a00979eee" :answer/id #uuid "a5c62dbc-9eb7-5b0e-9f7c-6b7a00979eee" :answer/type :answer.type/math :answer/value "5h-15" :db/ensure [:answer/validate]} {:db/id "answer-dd4c551c-c05a-570f-9f97-6911d7e8970e" :answer/id #uuid "dd4c551c-c05a-570f-9f97-6911d7e8970e" :answer/type :answer.type/math :answer/value "5h-25" :db/ensure [:answer/validate]} {:db/id "answer-c22acf02-c6c6-5c01-be71-8571630d69d3" :answer/id #uuid "c22acf02-c6c6-5c01-be71-8571630d69d3" :answer/type :answer.type/math :answer/value "\\frac{5(h+5)}{h+3}" :db/ensure [:answer/validate]} {:db/id "answer-7a19ebb9-eb32-5f26-b024-e4e111e111e7" :answer/id #uuid "7a19ebb9-eb32-5f26-b024-e4e111e111e7" :answer/type :answer.type/math :answer/value "\\frac{5(h+5)}{h-5}" :db/ensure [:answer/validate]} {:db/id "answer-9a149eb4-3b76-5d09-90e7-b82fe272cdf3" :answer/id #uuid "9a149eb4-3b76-5d09-90e7-b82fe272cdf3" :answer/type :answer.type/math :answer/value "h-15" :db/ensure [:answer/validate]} {:db/id 17592186115273 :knowledge-point/questions ["question-414107e1-417e-5cee-adda-177a3b9f7f95"] :db/ensure [:knowledge-point/validate]} {:db/id "question-414107e1-417e-5cee-adda-177a3b9f7f95" :question/id #uuid "414107e1-417e-5cee-adda-177a3b9f7f95" :question/math-academy-id "q-113009" :question/problem "Simplify $\\frac{wy+6y}{{w}^{2}+2w-24}.$" :question/worked-solution "The numerator can be factored as $wy+6y=y(w+6)$ and the denominator can be factored as ${w}^{2}+2w-24=(w+6)(w-4).$ Canceling out any common factors that appear in the numerator and the denominator, we get\n\n$$\n\\begin{aligned}\\frac{wy+6y}{{w}^{2}+2w-24} & =\\frac{y(w+6)}{(w+6)(w-4)} \\\\  & =\\frac{y\\cancel{(w+6)}}{\\cancel{(w+6)}(w-4)} \\\\  & =\\frac{y}{w-4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7460b50b-08fe-5e2c-a44b-c9f0b9e966d0"] :db/ensure [:question/validate]} {:db/id "answer-field-7460b50b-08fe-5e2c-a44b-c9f0b9e966d0" :answer-field/id #uuid "7460b50b-08fe-5e2c-a44b-c9f0b9e966d0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-bcf406c8-4db3-5b65-bc38-6eab06e49c34" :answer-field/choices ["answer-8b4ec7b5-df2a-5e2a-b909-c4a35d9c756f" "answer-d3b6ccb4-6cb2-50a8-88bd-e105ef902df7" "answer-a6b8a513-772f-5dc4-817b-22432a5926b2" "answer-bcf406c8-4db3-5b65-bc38-6eab06e49c34" "answer-80e32f2d-3c6b-5170-a45d-be7ada8fedbb"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b4ec7b5-df2a-5e2a-b909-c4a35d9c756f" :answer/id #uuid "8b4ec7b5-df2a-5e2a-b909-c4a35d9c756f" :answer/type :answer.type/math :answer/value "\\frac{w}{y+6}" :db/ensure [:answer/validate]} {:db/id "answer-d3b6ccb4-6cb2-50a8-88bd-e105ef902df7" :answer/id #uuid "d3b6ccb4-6cb2-50a8-88bd-e105ef902df7" :answer/type :answer.type/math :answer/value "\\frac{y{w}^{2}}{w-4}" :db/ensure [:answer/validate]} {:db/id "answer-a6b8a513-772f-5dc4-817b-22432a5926b2" :answer/id #uuid "a6b8a513-772f-5dc4-817b-22432a5926b2" :answer/type :answer.type/math :answer/value "\\frac{y}{w+6}" :db/ensure [:answer/validate]} {:db/id "answer-bcf406c8-4db3-5b65-bc38-6eab06e49c34" :answer/id #uuid "bcf406c8-4db3-5b65-bc38-6eab06e49c34" :answer/type :answer.type/math :answer/value "\\frac{y}{w-4}" :db/ensure [:answer/validate]} {:db/id "answer-80e32f2d-3c6b-5170-a45d-be7ada8fedbb" :answer/id #uuid "80e32f2d-3c6b-5170-a45d-be7ada8fedbb" :answer/type :answer.type/math :answer/value "\\frac{y}{w-8}" :db/ensure [:answer/validate]} {:db/id "activity-27a2bc46-a0f5-5791-9d35-ee6f833ee8a1" :activity/id #uuid "27a2bc46-a0f5-5791-9d35-ee6f833ee8a1" :activity/title "Simplifying Rational Expressions Using Polynomial Factorization" :activity/type :activity.type/review :activity/scope 17592186050323 :activity/course 17592186046647 :activity/steps ["step-4988ca31-6da1-55bf-9d02-a1ae7f0e0e80" "step-73032011-28db-5c08-842d-4e460d031593" "step-04d8a637-3615-5a68-9997-f32c9376b669"] :activity/first-step "step-4988ca31-6da1-55bf-9d02-a1ae7f0e0e80" :db/ensure [:activity/validate]} {:db/id "step-4988ca31-6da1-55bf-9d02-a1ae7f0e0e80" :step/id #uuid "4988ca31-6da1-55bf-9d02-a1ae7f0e0e80" :step/content "question-80a74124-ec47-55a3-9e24-4bd2a521aa8c" :step/next "step-73032011-28db-5c08-842d-4e460d031593" :db/ensure [:step/validate]} {:db/id "step-73032011-28db-5c08-842d-4e460d031593" :step/id #uuid "73032011-28db-5c08-842d-4e460d031593" :step/content "question-0c6bffa8-a78e-5e02-8975-6f49c316264d" :step/next "step-04d8a637-3615-5a68-9997-f32c9376b669" :db/ensure [:step/validate]} {:db/id "step-04d8a637-3615-5a68-9997-f32c9376b669" :step/id #uuid "04d8a637-3615-5a68-9997-f32c9376b669" :step/content "question-414107e1-417e-5cee-adda-177a3b9f7f95" :db/ensure [:step/validate]} {:db/id 17592186073904 :knowledge-point/questions ["question-3b1c8849-8725-5033-99b9-7b44196735cf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3b1c8849-8725-5033-99b9-7b44196735cf" :question/id #uuid "3b1c8849-8725-5033-99b9-7b44196735cf" :question/math-academy-id "q-14376" :question/problem "The point $P(-2,5)$ is reflected across the $x$-axis, shifted $3$ units down, and then reflected across the line $y=x.$ What is the resulting point?" :question/worked-solution "Let's recall the functional representations of our three transformations:\n\n- A reflection in the $x$-axis can be represented by the function \n\n$$\n(x,y)↦(x,-y).\n$$\n\n- A shift of $3$ units down can be represented by the function \n\n$$\n(x,y)↦(x,y-3).\n$$\n\n- A reflection in the line $y=x$ can be represented by the function \n\n$$\n(x,y)↦(y,x).\n$$\n\nLet's apply the given transformations to the point $P$ using our functions:\n\nFirst, we apply the reflection. The image of the point $(-2,5)$ under the reflection is\n\n$$\n(-2,5)↦(-2,-5).\n$$\n\n \n\nThen, we apply the shift. The image of the point $(-2,-5)$ under this shift is\n\n$$\n(-2,-5)↦(-2,-8).\n$$\n\nFinally, we apply the reflection in the line $y=x.$ The image of the point $(-2,-8)$ under this reflection is\n\n$$\n(-2,-8)↦(-8,-2).\n$$\n\nTherefore, the resulting point is $(-8,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-b50dca08-4713-5514-bd1f-47707336c77c"] :db/ensure [:question/validate]} {:db/id "answer-field-b50dca08-4713-5514-bd1f-47707336c77c" :answer-field/id #uuid "b50dca08-4713-5514-bd1f-47707336c77c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-efbd8051-2f04-5f8b-a0a3-fe80110c35fa" :answer-field/choices ["answer-58129d4c-4954-5229-a555-5cdc7487dfe6" "answer-efbd8051-2f04-5f8b-a0a3-fe80110c35fa" "answer-556b6199-da6f-579f-937f-8d66dce8e67b" "answer-9a286323-e88d-5db7-8196-b4a8a572b39c" "answer-f9936f46-eb9e-5009-a35f-953950a2815a"] :db/ensure [:answer-field/validate]} {:db/id "answer-58129d4c-4954-5229-a555-5cdc7487dfe6" :answer/id #uuid "58129d4c-4954-5229-a555-5cdc7487dfe6" :answer/type :answer.type/math :answer/value "(-2,8)" :db/ensure [:answer/validate]} {:db/id "answer-efbd8051-2f04-5f8b-a0a3-fe80110c35fa" :answer/id #uuid "efbd8051-2f04-5f8b-a0a3-fe80110c35fa" :answer/type :answer.type/math :answer/value "(-8,-2)" :db/ensure [:answer/validate]} {:db/id "answer-556b6199-da6f-579f-937f-8d66dce8e67b" :answer/id #uuid "556b6199-da6f-579f-937f-8d66dce8e67b" :answer/type :answer.type/math :answer/value "(-8,2)" :db/ensure [:answer/validate]} {:db/id "answer-9a286323-e88d-5db7-8196-b4a8a572b39c" :answer/id #uuid "9a286323-e88d-5db7-8196-b4a8a572b39c" :answer/type :answer.type/math :answer/value "(2,-5)" :db/ensure [:answer/validate]} {:db/id "answer-f9936f46-eb9e-5009-a35f-953950a2815a" :answer/id #uuid "f9936f46-eb9e-5009-a35f-953950a2815a" :answer/type :answer.type/math :answer/value "(8,-2)" :db/ensure [:answer/validate]} {:db/id 17592186073779 :knowledge-point/questions ["question-b4059559-692f-5333-8d82-5fcea28a66c0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-b4059559-692f-5333-8d82-5fcea28a66c0" :question/id #uuid "b4059559-692f-5333-8d82-5fcea28a66c0" :question/math-academy-id "q-45182" :question/problem "![](images/46/46387d95d8b385f618da53c48284b323bed69e547a2e9894294f03aac7fa104e.png)\n\nThe triangle shown above is rotated by ${90}^{∘}$ counterclockwise about the origin and then reflected across the $x$-axis. What is the resulting triangle?" :question/worked-solution "Let's apply the given transformation.\n\n- Rotating the triangle by ${90}^{∘}$ counterclockwise about the origin gives the following:\n\n![](images/e8/e858bc501573ce7290ae6c2c0601d1c5a03d76a44a332ac8a5588e027bc0eacc.png)\n\n- Next, we take the last result and reflect it across the $x$-axis. This gives the following:\n\n![](images/6e/6eaad9b0fc67babd22039d3c615789babd7469fc3e0822e4f585138750a6e3db.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-7f3c2607-2b6f-5905-9bf7-fdbd9f2d719e"] :db/ensure [:question/validate]} {:db/id "answer-field-7f3c2607-2b6f-5905-9bf7-fdbd9f2d719e" :answer-field/id #uuid "7f3c2607-2b6f-5905-9bf7-fdbd9f2d719e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1cf9d4a9-b836-55bd-a79f-afebcc294c33" :answer-field/choices ["answer-3b23f4ef-d25a-5f41-b151-756ffbb200c5" "answer-0fa33d3e-59a6-5e25-91da-5f65ef10c9ef" "answer-212a1beb-5cfc-5752-a017-5c89a504e3cd" "answer-1cf9d4a9-b836-55bd-a79f-afebcc294c33" "answer-ed3448a7-725e-5b3f-bfda-55749598cea0"] :db/ensure [:answer-field/validate]} {:db/id "answer-3b23f4ef-d25a-5f41-b151-756ffbb200c5" :answer/id #uuid "3b23f4ef-d25a-5f41-b151-756ffbb200c5" :answer/type :answer.type/image :answer/value "images/34/3413493e189dc774e491a7fb6a1b7c50ed4d8e3f5b5854790f34a103aea0ad3b.png" :db/ensure [:answer/validate]} {:db/id "answer-0fa33d3e-59a6-5e25-91da-5f65ef10c9ef" :answer/id #uuid "0fa33d3e-59a6-5e25-91da-5f65ef10c9ef" :answer/type :answer.type/image :answer/value "images/66/66fba3dcaa529985f8912346c11814d04bfabdd23e56ec85999c5b1810e29b32.png" :db/ensure [:answer/validate]} {:db/id "answer-212a1beb-5cfc-5752-a017-5c89a504e3cd" :answer/id #uuid "212a1beb-5cfc-5752-a017-5c89a504e3cd" :answer/type :answer.type/image :answer/value "images/78/781fe21d562d7f1dd4776e4cb2daf1b75c7961efe0e81c3a21d48a401faf3a01.png" :db/ensure [:answer/validate]} {:db/id "answer-1cf9d4a9-b836-55bd-a79f-afebcc294c33" :answer/id #uuid "1cf9d4a9-b836-55bd-a79f-afebcc294c33" :answer/type :answer.type/image :answer/value "images/7c/7c99fe0d00c7549f0449f4ef3fd5f98b7901507c8cac2712fc8ff09f2e53c357.png" :db/ensure [:answer/validate]} {:db/id "answer-ed3448a7-725e-5b3f-bfda-55749598cea0" :answer/id #uuid "ed3448a7-725e-5b3f-bfda-55749598cea0" :answer/type :answer.type/image :answer/value "images/91/91b022517d1bfcf0e32cb684d57a5b67c859632ce0b3639485986d81229537f0.png" :db/ensure [:answer/validate]} {:db/id 17592186074180 :question/problem "The point $P(5,6)$ is rotated ${90}^{∘}$ clockwise about the origin $O$ and then translated according to the function $(x,y)↦(x+k,y+k).$ If the image of $P$ under this sequence of transformations is $(12,1),$ then $k=$" :question/worked-solution "Let's apply the given transformations.\n\nA rotation of ${90}^{∘}$ clockwise about $O$ can be represented by\n\n$$\n(x,y)↦(y,-x).\n$$\n\nApplying this to the point $P,$ we get\n\n$$\n(5,6)↦(6,-5).\n$$\n\n \n\nNow, applying the translation to $(6,-5),$ we get\n\n$$\n(6,-5)↦(6+k,\\,-5+k).\n$$\n\n \n\nSince the resulting point is $(12,1),$ by equating the $x$- and $y$-coordinates, we obtain\n\n$$\n\\begin{aligned}\\{\\begin{aligned}6+k=12 \\\\ -5+k=1\\end{aligned}\\,⟹\\,k & =6.\\end{aligned}\n$$\n\nTherefore, $k=6.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186071318 :answer-field/correct 17592186071322 :db/ensure [:answer-field/validate]} {:db/id "activity-c99456de-5358-5f4a-a509-379861656be6" :activity/id #uuid "c99456de-5358-5f4a-a509-379861656be6" :activity/title "Combining Geometric Transformations" :activity/type :activity.type/review :activity/scope 17592186048906 :activity/course 17592186046647 :activity/steps ["step-db17c9b9-b4ba-501a-aed6-8fe279a39f99" "step-45f03049-efe3-5df0-b089-b7bc4f3bb0db" "step-15e09dd4-2f3f-5fc3-aa87-d06ffb45ee78"] :activity/first-step "step-db17c9b9-b4ba-501a-aed6-8fe279a39f99" :db/ensure [:activity/validate]} {:db/id "step-db17c9b9-b4ba-501a-aed6-8fe279a39f99" :step/id #uuid "db17c9b9-b4ba-501a-aed6-8fe279a39f99" :step/content "question-3b1c8849-8725-5033-99b9-7b44196735cf" :step/next "step-45f03049-efe3-5df0-b089-b7bc4f3bb0db" :db/ensure [:step/validate]} {:db/id "step-45f03049-efe3-5df0-b089-b7bc4f3bb0db" :step/id #uuid "45f03049-efe3-5df0-b089-b7bc4f3bb0db" :step/content "question-b4059559-692f-5333-8d82-5fcea28a66c0" :step/next "step-15e09dd4-2f3f-5fc3-aa87-d06ffb45ee78" :db/ensure [:step/validate]} {:db/id "step-15e09dd4-2f3f-5fc3-aa87-d06ffb45ee78" :step/id #uuid "15e09dd4-2f3f-5fc3-aa87-d06ffb45ee78" :step/content 17592186074180 :db/ensure [