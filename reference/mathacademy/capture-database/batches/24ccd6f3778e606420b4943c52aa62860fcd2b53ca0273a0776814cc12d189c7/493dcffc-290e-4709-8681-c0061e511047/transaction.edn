/validate]} {:db/id "answer-field-48974d70-1c9e-5c9e-80ca-6cce5b5076ec" :answer-field/id #uuid "48974d70-1c9e-5c9e-80ca-6cce5b5076ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ddb51433-59ad-510e-af82-051a9cf35e4a" :answer-field/choices ["answer-ad7c345a-e695-5ed5-b6bd-5dfa2536e4e9" "answer-e18fb700-f232-53e5-82ad-694ed357a2fa" "answer-e049459d-b8c3-5c4e-83d0-508fdb69662d" "answer-ddb51433-59ad-510e-af82-051a9cf35e4a" "answer-b4130463-8bbe-5db6-bc7e-cd27c66ce6d3"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad7c345a-e695-5ed5-b6bd-5dfa2536e4e9" :answer/id #uuid "ad7c345a-e695-5ed5-b6bd-5dfa2536e4e9" :answer/type :answer.type/math :answer/value "g:Q\\to Q" :db/ensure [:answer/validate]} {:db/id "answer-e18fb700-f232-53e5-82ad-694ed357a2fa" :answer/id #uuid "e18fb700-f232-53e5-82ad-694ed357a2fa" :answer/type :answer.type/math :answer/value "g:Q\\to R" :db/ensure [:answer/validate]} {:db/id "answer-e049459d-b8c3-5c4e-83d0-508fdb69662d" :answer/id #uuid "e049459d-b8c3-5c4e-83d0-508fdb69662d" :answer/type :answer.type/math :answer/value "g:R\\to (0,1)" :db/ensure [:answer/validate]} {:db/id "answer-ddb51433-59ad-510e-af82-051a9cf35e4a" :answer/id #uuid "ddb51433-59ad-510e-af82-051a9cf35e4a" :answer/type :answer.type/math :answer/value "g:R\\to Q" :db/ensure [:answer/validate]} {:db/id "answer-b4130463-8bbe-5db6-bc7e-cd27c66ce6d3" :answer/id #uuid "b4130463-8bbe-5db6-bc7e-cd27c66ce6d3" :answer/type :answer.type/math :answer/value "g:R\\to R" :db/ensure [:answer/validate]} {:db/id "question-e8bbc308-2450-589f-b174-679c413f5f6e" :question/id #uuid "e8bbc308-2450-589f-b174-679c413f5f6e" :question/math-academy-id "q-96757" :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n*\"The function $f$ maps the set $X$ to the interval from $0$ to $3$ inclusive.\"*" :question/worked-solution "The sentence *\"The function $f$ maps the set $X$ to the interval from $0$ to $3$ inclusive\"* is equivalent to the following symbolic notation:\n\n$\\,$ $f:X\\to [0,3]$\n\nHere, the domain of $f$ is $X,$ and the codomain of $f$ is $[0,3].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-502725af-4995-5bd6-9c6b-7a8e75264341"] :db/ensure [:question/validate]} {:db/id "answer-field-502725af-4995-5bd6-9c6b-7a8e75264341" :answer-field/id #uuid "502725af-4995-5bd6-9c6b-7a8e75264341" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c11a4975-eb7c-56b6-b878-768de0b61937" :answer-field/choices ["answer-7606deee-8e06-5017-9c79-13b72aeea418" "answer-ef09d351-7752-5d6b-a5ca-f6313e5527c0" "answer-c11a4975-eb7c-56b6-b878-768de0b61937" "answer-2c9b3f88-5053-5e6a-8cb8-272994ce7a20" "answer-3b69830b-65a2-5a91-b7c3-da955a137a3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-7606deee-8e06-5017-9c79-13b72aeea418" :answer/id #uuid "7606deee-8e06-5017-9c79-13b72aeea418" :answer/type :answer.type/math :answer/value "f:(0,3)\\to X" :db/ensure [:answer/validate]} {:db/id "answer-ef09d351-7752-5d6b-a5ca-f6313e5527c0" :answer/id #uuid "ef09d351-7752-5d6b-a5ca-f6313e5527c0" :answer/type :answer.type/math :answer/value "f:X\\to (0,3)" :db/ensure [:answer/validate]} {:db/id "answer-c11a4975-eb7c-56b6-b878-768de0b61937" :answer/id #uuid "c11a4975-eb7c-56b6-b878-768de0b61937" :answer/type :answer.type/math :answer/value "f:X\\to [0,3]" :db/ensure [:answer/validate]} {:db/id "answer-2c9b3f88-5053-5e6a-8cb8-272994ce7a20" :answer/id #uuid "2c9b3f88-5053-5e6a-8cb8-272994ce7a20" :answer/type :answer.type/math :answer/value "f:X\\to \\{0,3\\}" :db/ensure [:answer/validate]} {:db/id "answer-3b69830b-65a2-5a91-b7c3-da955a137a3a" :answer/id #uuid "3b69830b-65a2-5a91-b7c3-da955a137a3a" :answer/type :answer.type/math :answer/value "f:[0,3]\\to X" :db/ensure [:answer/validate]} {:db/id "question-f9c7a6ed-7bc4-5fae-bd01-cf7380224c4e" :question/id #uuid "f9c7a6ed-7bc4-5fae-bd01-cf7380224c4e" :question/math-academy-id "q-104937" :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n*\"The function $h$ maps the interval from $0$ to $1$ exclusive to the set containing the two numbers $0$ and $1$ only.\"*" :question/worked-solution "The sentence *\"The function $h$ maps the interval from $0$ to $1$ exclusive to the set containing the two numbers $0$ and $1$ only\"* is equivalent to the following symbolic notation:\n\n$\\,$ $h:(0,1)\\to \\{0,1\\}$\n\nHere, the domain of $h$ is $(0,1),$ and the codomain of $h$ is $\\{0,1\\}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7732c4e3-3161-5802-ab59-a7cdbdfc5997"] :db/ensure [:question/validate]} {:db/id "answer-field-7732c4e3-3161-5802-ab59-a7cdbdfc5997" :answer-field/id #uuid "7732c4e3-3161-5802-ab59-a7cdbdfc5997" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-541ffd3e-8a84-5a4f-bd1a-89894363b8da" :answer-field/choices ["answer-1035bbb6-7038-5b32-98d1-d43d0cee1aa3" "answer-43bcd4c6-a1f1-5472-bf3f-22916bfd9d61" "answer-541ffd3e-8a84-5a4f-bd1a-89894363b8da" "answer-e126d013-b0a4-5d2c-bf12-3c1d12a00d91" "answer-0b61bd54-1c7d-591e-939b-77de4327abc1"] :db/ensure [:answer-field/validate]} {:db/id "answer-1035bbb6-7038-5b32-98d1-d43d0cee1aa3" :answer/id #uuid "1035bbb6-7038-5b32-98d1-d43d0cee1aa3" :answer/type :answer.type/math :answer/value "h:(0,1)\\to (0,1)" :db/ensure [:answer/validate]} {:db/id "answer-43bcd4c6-a1f1-5472-bf3f-22916bfd9d61" :answer/id #uuid "43bcd4c6-a1f1-5472-bf3f-22916bfd9d61" :answer/type :answer.type/math :answer/value "h:(0,1)\\to [0,1]" :db/ensure [:answer/validate]} {:db/id "answer-541ffd3e-8a84-5a4f-bd1a-89894363b8da" :answer/id #uuid "541ffd3e-8a84-5a4f-bd1a-89894363b8da" :answer/type :answer.type/math :answer/value "h:(0,1)\\to \\{0,1\\}" :db/ensure [:answer/validate]} {:db/id "answer-e126d013-b0a4-5d2c-bf12-3c1d12a00d91" :answer/id #uuid "e126d013-b0a4-5d2c-bf12-3c1d12a00d91" :answer/type :answer.type/math :answer/value "h:\\{0,1\\}\\to (0,1)" :db/ensure [:answer/validate]} {:db/id "answer-0b61bd54-1c7d-591e-939b-77de4327abc1" :answer/id #uuid "0b61bd54-1c7d-591e-939b-77de4327abc1" :answer/type :answer.type/math :answer/value "h:\\{0,1\\}\\to \\{0,1\\}" :db/ensure [:answer/validate]} {:db/id "question-97bd3e47-4a7d-51fe-87e4-ccb53cfbd7e2" :question/id #uuid "97bd3e47-4a7d-51fe-87e4-ccb53cfbd7e2" :question/math-academy-id "q-104941" :question/problem "Which of the following is equivalent to $h(x)=2{x}^{3}-3x?$" :question/worked-solution "The notation $h(x)=2{x}^{3}-3x$ means that the function $h$ maps the element $x$ in the domain to $2{x}^{3}-3x$ in the codomain. This can also be written as\n\n$$\nh:x↦2{x}^{3}-3x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-86cbd155-e168-55e6-b312-a580ef748d0a"] :db/ensure [:question/validate]} {:db/id "answer-field-86cbd155-e168-55e6-b312-a580ef748d0a" :answer-field/id #uuid "86cbd155-e168-55e6-b312-a580ef748d0a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0aacc03f-d443-56a8-98ec-3789fe421eda" :answer-field/choices ["answer-a040e295-4426-5498-a1ec-eee2127b6a9e" "answer-783a5b80-d714-5773-9afd-24db9211e58b" "answer-554769e0-913b-5666-8b52-da7a146ba940" "answer-0aacc03f-d443-56a8-98ec-3789fe421eda" "answer-88ecda15-e589-5fe6-ad21-b805845401c9"] :db/ensure [:answer-field/validate]} {:db/id "answer-a040e295-4426-5498-a1ec-eee2127b6a9e" :answer/id #uuid "a040e295-4426-5498-a1ec-eee2127b6a9e" :answer/type :answer.type/math :answer/value "h:2{x}^{3}↦-3x" :db/ensure [:answer/validate]} {:db/id "answer-783a5b80-d714-5773-9afd-24db9211e58b" :answer/id #uuid "783a5b80-d714-5773-9afd-24db9211e58b" :answer/type :answer.type/math :answer/value "h:3x↦2{x}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-554769e0-913b-5666-8b52-da7a146ba940" :answer/id #uuid "554769e0-913b-5666-8b52-da7a146ba940" :answer/type :answer.type/math :answer/value "h:x↦-3x" :db/ensure [:answer/validate]} {:db/id "answer-0aacc03f-d443-56a8-98ec-3789fe421eda" :answer/id #uuid "0aacc03f-d443-56a8-98ec-3789fe421eda" :answer/type :answer.type/math :answer/value "h:x↦2{x}^{3}-3x" :db/ensure [:answer/validate]} {:db/id "answer-88ecda15-e589-5fe6-ad21-b805845401c9" :answer/id #uuid "88ecda15-e589-5fe6-ad21-b805845401c9" :answer/type :answer.type/math :answer/value "h:x↦{x}^{3}" :db/ensure [:answer/validate]} {:db/id "question-366b227d-9c09-5249-bc0f-cb45c09620a0" :question/id #uuid "366b227d-9c09-5249-bc0f-cb45c09620a0" :question/math-academy-id "q-96819" :question/problem "Which of the following is equivalent to $g:x↦1?$" :question/worked-solution "The notation $g:x↦1$ means that the function $g$ maps the element $x$ in the domain to $1$ in the codomain. This can also be written as\n\n$$\ng(x)=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4eb70082-dd07-5801-b800-bc795ad3795f"] :db/ensure [:question/validate]} {:db/id "answer-field-4eb70082-dd07-5801-b800-bc795ad3795f" :answer-field/id #uuid "4eb70082-dd07-5801-b800-bc795ad3795f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9b72735d-5c63-52e9-b20e-94395a94fb48" :answer-field/choices ["answer-77c0cb02-7243-5cb8-b055-248b6519b007" "answer-9b72735d-5c63-52e9-b20e-94395a94fb48" "answer-46c31195-e8be-52b6-93f1-fad3fbbeb5d7" "answer-0fb66b74-5889-5d7c-b8a3-82eac46f6c7e" "answer-dfc59561-87df-548e-b655-0825256d38e1"] :db/ensure [:answer-field/validate]} {:db/id "answer-77c0cb02-7243-5cb8-b055-248b6519b007" :answer/id #uuid "77c0cb02-7243-5cb8-b055-248b6519b007" :answer/type :answer.type/math :answer/value "g(1)=x" :db/ensure [:answer/validate]} {:db/id "answer-9b72735d-5c63-52e9-b20e-94395a94fb48" :answer/id #uuid "9b72735d-5c63-52e9-b20e-94395a94fb48" :answer/type :answer.type/math :answer/value "g(x)=1" :db/ensure [:answer/validate]} {:db/id "answer-46c31195-e8be-52b6-93f1-fad3fbbeb5d7" :answer/id #uuid "46c31195-e8be-52b6-93f1-fad3fbbeb5d7" :answer/type :answer.type/math :answer/value "g(x)=1-x" :db/ensure [:answer/validate]} {:db/id "answer-0fb66b74-5889-5d7c-b8a3-82eac46f6c7e" :answer/id #uuid "0fb66b74-5889-5d7c-b8a3-82eac46f6c7e" :answer/type :answer.type/math :answer/value "x=1" :db/ensure [:answer/validate]} {:db/id "answer-dfc59561-87df-548e-b655-0825256d38e1" :answer/id #uuid "dfc59561-87df-548e-b655-0825256d38e1" :answer/type :answer.type/math :answer/value "x=1-x" :db/ensure [:answer/validate]} {:db/id "question-af103ef7-b89b-5289-9d5d-02c1e186f66e" :question/id #uuid "af103ef7-b89b-5289-9d5d-02c1e186f66e" :question/math-academy-id "q-104951" :question/problem "![](images/6a/6ac4933860ceea29b5892d1ea38685dd7d7fbb5e1a6a48cda45b48151b35aeb1.png)\n\nConsider the function $g:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\nI. The domain of $g$ is $\\{1,2,3\\}$\n\nII. The codomain of $g$ is $\\{1,2,3\\}$\n\nIII. The range of $g$ is $\\{1,2,3\\}$" :question/worked-solution "The notation $g:X\\to Y$ means that the function $g$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $g$ is $X,$\n\n- the codomain of $g$ is $Y.$\n\nThe range of $g$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $g$ is $X=\\{1,2,3\\},$\n\n- the codomain of $g$ is $Y=\\{1,2,3,4\\},$\n\n- the range of $g$ is $\\{1,2,3\\},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements I and III are true, while statement II is false.\n\nTherefore, the correct answer \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-1b5c1a5d-7ac0-5268-a351-1c74d654d1fd"] :db/ensure [:question/validate]} {:db/id "answer-field-1b5c1a5d-7ac0-5268-a351-1c74d654d1fd" :answer-field/id #uuid "1b5c1a5d-7ac0-5268-a351-1c74d654d1fd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9ce61f7b-f3ab-56c7-96d3-2117a364b564" :answer-field/choices ["answer-0a37a47e-df4b-5a3b-b91d-251a23cdbc67" "answer-9ce61f7b-f3ab-56c7-96d3-2117a364b564" "answer-2bf5c615-bac0-5e6d-bed3-fad212104c62" "answer-84ab3d78-f997-5627-8d22-8f29bbd35fd7" "answer-1aa6843f-235e-55f5-a1d2-65b5255eca12"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a37a47e-df4b-5a3b-b91d-251a23cdbc67" :answer/id #uuid "0a37a47e-df4b-5a3b-b91d-251a23cdbc67" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-9ce61f7b-f3ab-56c7-96d3-2117a364b564" :answer/id #uuid "9ce61f7b-f3ab-56c7-96d3-2117a364b564" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-2bf5c615-bac0-5e6d-bed3-fad212104c62" :answer/id #uuid "2bf5c615-bac0-5e6d-bed3-fad212104c62" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-84ab3d78-f997-5627-8d22-8f29bbd35fd7" :answer/id #uuid "84ab3d78-f997-5627-8d22-8f29bbd35fd7" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-1aa6843f-235e-55f5-a1d2-65b5255eca12" :answer/id #uuid "1aa6843f-235e-55f5-a1d2-65b5255eca12" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-1110805d-d0df-5ae9-af4b-5eeeabf99273" :question/id #uuid "1110805d-d0df-5ae9-af4b-5eeeabf99273" :question/math-academy-id "q-96828" :question/problem "![](images/1b/1b124a0e4439f1b35affa5a38f175a151cbbad88affb12738585da8280bacb23.png)\n\nConsider the function $f:X\\to Y$ given by the mapping diagram shown above. Which of the following statements are true?\n\nI. The domain of $f$ is $\\{0,1\\}$\n\nII. The codomain of $f$ is $\\{0,1\\}$\n\nIII. The range of $f$ is $\\{0,1\\}$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nThe range of $f$ is the subset of the codomain that contains all values $y\\in Y$ that are mapped to by at least one element $x\\in X.$\n\nWith that in mind, let's inspect our diagram:\n\n- the domain of $f$ is $X=\\{0,1\\},$\n\n- the codomain of $f$ is $Y=\\{0,1,2,3\\},$\n\n- the range of $f$ is $\\{0,1\\},$ the subset of elements of $Y$ that have at least one incoming arrow.\n\nAs a result, statements I and III are true, while statement II is false.\n\nTherefore, the correct answer \"I and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-20e843ef-72f4-5f6d-8133-a40e9b75a28b"] :db/ensure [:question/validate]} {:db/id "answer-field-20e843ef-72f4-5f6d-8133-a40e9b75a28b" :answer-field/id #uuid "20e843ef-72f4-5f6d-8133-a40e9b75a28b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f4c0657f-5e00-5c2c-a966-63d4b0657c46" :answer-field/choices ["answer-fca7a609-f33e-5be9-ae87-737b69fc91e7" "answer-f4c0657f-5e00-5c2c-a966-63d4b0657c46" "answer-95810dec-fe98-5d62-b391-46de5d6c4ba9" "answer-66dc03df-3df9-5aee-880e-9b8893a454e7" "answer-dde14787-3b26-5768-9e9c-91acf6135f00"] :db/ensure [:answer-field/validate]} {:db/id "answer-fca7a609-f33e-5be9-ae87-737b69fc91e7" :answer/id #uuid "fca7a609-f33e-5be9-ae87-737b69fc91e7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-f4c0657f-5e00-5c2c-a966-63d4b0657c46" :answer/id #uuid "f4c0657f-5e00-5c2c-a966-63d4b0657c46" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-95810dec-fe98-5d62-b391-46de5d6c4ba9" :answer/id #uuid "95810dec-fe98-5d62-b391-46de5d6c4ba9" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-66dc03df-3df9-5aee-880e-9b8893a454e7" :answer/id #uuid "66dc03df-3df9-5aee-880e-9b8893a454e7" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-dde14787-3b26-5768-9e9c-91acf6135f00" :answer/id #uuid "dde14787-3b26-5768-9e9c-91acf6135f00" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186172165 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id "activity-f581d1cd-d5e5-52a7-8233-15cabecbaa60" :activity/id #uuid "f581d1cd-d5e5-52a7-8233-15cabecbaa60" :activity/title "The Singular Values of a Matrix" :activity/type :activity.type/review :activity/scope 17592186050205 :activity/course 17592186046669 :activity/steps ["step-6f93c1d3-714a-571d-89f2-1248ede639db" "step-417441ef-0974-5094-9fdd-ef33aedcf95b" "step-c3193284-a25f-5adc-93c6-8cfd1305db8b" "step-0a2276bc-3326-51a6-9c69-6590d1bce6ac" "step-57834937-e3aa-51d7-a2de-72481b9133d9"] :activity/first-step "step-6f93c1d3-714a-571d-89f2-1248ede639db" :db/ensure [:activity/validate]} {:db/id "step-6f93c1d3-714a-571d-89f2-1248ede639db" :step/id #uuid "6f93c1d3-714a-571d-89f2-1248ede639db" :step/content 17592186269243 :step/next "step-417441ef-0974-5094-9fdd-ef33aedcf95b" :db/ensure [:step/validate]} {:db/id "step-417441ef-0974-5094-9fdd-ef33aedcf95b" :step/id #uuid "417441ef-0974-5094-9fdd-ef33aedcf95b" :step/content 17592186369741 :step/next "step-c3193284-a25f-5adc-93c6-8cfd1305db8b" :db/ensure [:step/validate]} {:db/id "step-c3193284-a25f-5adc-93c6-8cfd1305db8b" :step/id #uuid "c3193284-a25f-5adc-93c6-8cfd1305db8b" :step/content 17592186400763 :step/next "step-0a2276bc-3326-51a6-9c69-6590d1bce6ac" :db/ensure [:step/validate]} {:db/id "step-0a2276bc-3326-51a6-9c69-6590d1bce6ac" :step/id #uuid "0a2276bc-3326-51a6-9c69-6590d1bce6ac" :step/content 17592186388618 :step/next "step-57834937-e3aa-51d7-a2de-72481b9133d9" :db/ensure [:step/validate]} {:db/id "step-57834937-e3aa-51d7-a2de-72481b9133d9" :step/id #uuid "57834937-e3aa-51d7-a2de-72481b9133d9" :step/content 17592186369748 :db/ensure [:step/validate]} [:db/retract 17592186084746 :answer-field/choices 17592186084747] [:db/retract 17592186084746 :answer-field/choices 17592186084748] [:db/retract 17592186084746 :answer-field/choices 17592186084749] [:db/retract 17592186084746 :answer-field/choices 17592186084750] [:db/retract 17592186084746 :answer-field/choices 17592186084751] [:db/retract 17592186081629 :answer-field/choices 17592186081632] [:db/retract 17592186081629 :answer-field/choices 17592186081633] [:db/retract 17592186081629 :answer-field/choices 17592186081634] [:db/retract 17592186081629 :answer-field/choices 17592186081630] [:db/retract 17592186081629 :answer-field/choices 17592186081631] {:db/id 17592186129309 :knowledge-point/questions ["question-21de0665-fffe-50d8-acfd-284a6430dcc9"] :db/ensure [:knowledge-point/validate]} {:db/id "question-21de0665-fffe-50d8-acfd-284a6430dcc9" :question/id #uuid "21de0665-fffe-50d8-acfd-284a6430dcc9" :question/math-academy-id "q-178587" :question/problem "$64\\times (-2)^{-3}=${{field-1}}" :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nNotice that $(-2)^{-3}=\\frac{1}{(-2)^{3}}.$ So, we obtain:\n\n$$\n\\begin{aligned}64\\times (-2)^{-3} & = \\\\ 64\\times \\frac{1}{(-2)^{3}} & = \\\\ 64\\times \\frac{1}{(-8)} & = \\\\ -\\frac{64}{8} & = \\\\ -(64÷8) & = \\\\ -8\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-63c49bf2-4fa7-5960-9c8b-b53c37923e52"] :db/ensure [:question/validate]} {:db/id "answer-field-63c49bf2-4fa7-5960-9c8b-b53c37923e52" :answer-field/id #uuid "63c49bf2-4fa7-5960-9c8b-b53c37923e52" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-fa972374-4a13-56c9-9cad-962d8ee51506" :answer-field/choices ["answer-fa972374-4a13-56c9-9cad-962d8ee51506"] :db/ensure [:answer-field/validate]} {:db/id "answer-fa972374-4a13-56c9-9cad-962d8ee51506" :answer/id #uuid "fa972374-4a13-56c9-9cad-962d8ee51506" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id 17592186088002 :question/problem "Write $-10+7y+5x=0$ in standard form." :question/worked-solution "Our goal is to write the equation in the form $ax+by=c,$ where $a,b,$ and $c$ are integers with no common factors and $a\\ge 0.$\n\nWe begin by moving all of the variables to the left-hand side and all of the constants to the right-hand side. This gives\n\n$$\n5x+7y=10.\n$$\n\nNow, $a,b,$ and $c$ are integers with no common factors, and $a\\ge 0.$ So we are done!\n\nThe standard form of the line is $5x+7y=10.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186084746 :answer-field/correct "answer-9229895d-0594-56eb-b6bb-8200027ca079" :answer-field/choices ["answer-f550dedc-bf0e-5266-888c-3e215c48f4ae" "answer-c9603c17-6eb9-5ed3-8741-ab4249868c6f" "answer-878172e5-39a1-5579-ac73-a152016732a3" "answer-9229895d-0594-56eb-b6bb-8200027ca079" "answer-58cdbd56-5509-538e-b603-fef18e91906b"] :db/ensure [:answer-field/validate]} {:db/id "answer-f550dedc-bf0e-5266-888c-3e215c48f4ae" :answer/id #uuid "f550dedc-bf0e-5266-888c-3e215c48f4ae" :answer/type :answer.type/math :answer/value "-5x+7y=10" :db/ensure [:answer/validate]} {:db/id "answer-c9603c17-6eb9-5ed3-8741-ab4249868c6f" :answer/id #uuid "c9603c17-6eb9-5ed3-8741-ab4249868c6f" :answer/type :answer.type/math :answer/value "5x+7y-10=0" :db/ensure [:answer/validate]} {:db/id "answer-878172e5-39a1-5579-ac73-a152016732a3" :answer/id #uuid "878172e5-39a1-5579-ac73-a152016732a3" :answer/type :answer.type/math :answer/value "5x+7y=-10" :db/ensure [:answer/validate]} {:db/id "answer-9229895d-0594-56eb-b6bb-8200027ca079" :answer/id #uuid "9229895d-0594-56eb-b6bb-8200027ca079" :answer/type :answer.type/math :answer/value "5x+7y=10" :db/ensure [:answer/validate]} {:db/id "answer-58cdbd56-5509-538e-b603-fef18e91906b" :answer/id #uuid "58cdbd56-5509-538e-b603-fef18e91906b" :answer/type :answer.type/math :answer/value "5x=-7y+10" :db/ensure [:answer/validate]} {:db/id 17592186152271 :knowledge-point/questions ["question-c6b59906-d6e5-5bad-9d0f-b7c18e490304"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c6b59906-d6e5-5bad-9d0f-b7c18e490304" :question/id #uuid "c6b59906-d6e5-5bad-9d0f-b7c18e490304" :question/math-academy-id "q-51850" :question/problem "If $z$ varies directly with $w$ and $z=72$ when $w=9$, find the relationship between $w$ and $z.$" :question/worked-solution "Since $z$ varies directly with $w,$ we use the equation\n\n$$\nz=kw.\n$$\n\nNext, we use the fact that $z=72$ when $w=9$ to find $k:$\n\n$$\n\\begin{aligned}72 & =9\\cdot k \\\\ \\frac{72}{9} & =k \\\\ 8 & =k\\end{aligned}\n$$\n\nTherefore, our direct variation equation is\n\n$$\nz=8w.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4f2e6ed3-eae4-566d-b1ac-521499dbb0e6"] :db/ensure [:question/validate]} {:db/id "answer-field-4f2e6ed3-eae4-566d-b1ac-521499dbb0e6" :answer-field/id #uuid "4f2e6ed3-eae4-566d-b1ac-521499dbb0e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5290e566-05b8-57a3-91e2-381dd9418d97" :answer-field/choices ["answer-cb999a89-4362-59d0-b97c-1d030c842952" "answer-cee6b386-d23f-5c89-b76f-83f2e15a81ac" "answer-1c5a0257-a0c5-59b4-81a5-a67cca57571d" "answer-5290e566-05b8-57a3-91e2-381dd9418d97" "answer-2ecb1ff6-c6a8-5900-940f-8ee305160790"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb999a89-4362-59d0-b97c-1d030c842952" :answer/id #uuid "cb999a89-4362-59d0-b97c-1d030c842952" :answer/type :answer.type/math :answer/value "z=5w" :db/ensure [:answer/validate]} {:db/id "answer-cee6b386-d23f-5c89-b76f-83f2e15a81ac" :answer/id #uuid "cee6b386-d23f-5c89-b76f-83f2e15a81ac" :answer/type :answer.type/math :answer/value "z=6w" :db/ensure [:answer/validate]} {:db/id "answer-1c5a0257-a0c5-59b4-81a5-a67cca57571d" :answer/id #uuid "1c5a0257-a0c5-59b4-81a5-a67cca57571d" :answer/type :answer.type/math :answer/value "z=7w" :db/ensure [:answer/validate]} {:db/id "answer-5290e566-05b8-57a3-91e2-381dd9418d97" :answer/id #uuid "5290e566-05b8-57a3-91e2-381dd9418d97" :answer/type :answer.type/math :answer/value "z=8w" :db/ensure [:answer/validate]} {:db/id "answer-2ecb1ff6-c6a8-5900-940f-8ee305160790" :answer/id #uuid "2ecb1ff6-c6a8-5900-940f-8ee305160790" :answer/type :answer.type/math :answer/value "z=9w" :db/ensure [:answer/validate]} {:db/id 17592186083170 :knowledge-point/questions ["question-81d71337-d62e-547f-9ba2-a1325854394f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-81d71337-d62e-547f-9ba2-a1325854394f" :question/id #uuid "81d71337-d62e-547f-9ba2-a1325854394f" :question/math-academy-id "q-214915" :question/problem "Consider the following system of equations.\n\n$$\n\\begin{aligned}\\{\\begin{aligned}-p+7q=-4 \\\\ 10p-9q=-21\\end{aligned}\\end{aligned}\n$$\n\nThe variable $p$ can be eliminated from the system using the following two steps:\n\n1\\. Multiply the first equation by $10$ and obtain\n\n  $$\n  \\begin{aligned}-10p+70q & =-40.\\end{aligned}\n  $$\n\n2\\. Add the multiplied equation to the second equation to get\n\n$\\,$\n{{field-1}}\n$=-61.$" :question/worked-solution "Let's follow the steps provided:\n\n**Step 1**: Multiplying the first equation by $10$ yields the following equivalent system:\n\n$$\n\\{\\begin{aligned}(\\,-p+7q=-4\\,)\\,\\times (10) \\\\ 10p-9q=-21\\end{aligned}\\,⟹\\,\\{\\begin{aligned}-10p+70q=-40 \\\\ 10p-9q=-21\\end{aligned}\n$$\n\n**Step 2**: Next, we add these two equations together:\n\n$$\n\\begin{aligned}-\\cancel{10p}+70q & =-40 \\\\ \\cancel{10p}-9q & =-21 \\\\ (70q-9q) & =(-40-21) \\\\ 61q & =-61\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-916e2064-2417-541d-9181-6188328022c5"] :db/ensure [:question/validate]} {:db/id "answer-field-916e2064-2417-541d-9181-6188328022c5" :answer-field/id #uuid "916e2064-2417-541d-9181-6188328022c5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-677fe6bd-dd31-5f40-9b58-25620987e35f" :answer-field/choices ["answer-677fe6bd-dd31-5f40-9b58-25620987e35f"] :db/ensure [:answer-field/validate]} {:db/id "answer-677fe6bd-dd31-5f40-9b58-25620987e35f" :answer/id #uuid "677fe6bd-dd31-5f40-9b58-25620987e35f" :answer/type :answer.type/math :answer/value "61q" :db/ensure [:answer/validate]} {:db/id 17592186138526 :knowledge-point/questions ["question-4143dbb0-9a1f-50d1-bc72-9b5c0cbd50d6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-4143dbb0-9a1f-50d1-bc72-9b5c0cbd50d6" :question/id #uuid "4143dbb0-9a1f-50d1-bc72-9b5c0cbd50d6" :question/math-academy-id "q-178628" :question/problem "What is the solution to the equation $0.6y=-4.8?$\n\nThe solution is $y=$\n{{field-1}}." :question/worked-solution "First, we multiply both sides of the equation by $10$ to get rid of the decimals:\n\n$$\n\\begin{aligned}0.6y & =-4.8 \\\\ 10\\cdot (0.6y) & =10\\cdot (-4.8) \\\\ 6y & =-48\\end{aligned}\n$$\n\nThen, we solve the equation using the multiplication principle, as usual:\n\n$$\n\\begin{aligned}6y & =-48 \\\\ \\frac{6y}{6} & =\\frac{-48}{6} \\\\ \\frac{\\cancel{6}y}{\\cancel{6}} & =-8 \\\\ y & =-8\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-56f02922-700a-5761-8857-860c35743e1f"] :db/ensure [:question/validate]} {:db/id "answer-field-56f02922-700a-5761-8857-860c35743e1f" :answer-field/id #uuid "56f02922-700a-5761-8857-860c35743e1f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-01f18fc7-eb9b-5164-88db-2455cb33f7c5" :answer-field/choices ["answer-01f18fc7-eb9b-5164-88db-2455cb33f7c5"] :db/ensure [:answer-field/validate]} {:db/id "answer-01f18fc7-eb9b-5164-88db-2455cb33f7c5" :answer/id #uuid "01f18fc7-eb9b-5164-88db-2455cb33f7c5" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id 17592186138458 :knowledge-point/questions ["question-1fe48b5d-2d75-5bc6-88de-325b6398cfcb"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1fe48b5d-2d75-5bc6-88de-325b6398cfcb" :question/id #uuid "1fe48b5d-2d75-5bc6-88de-325b6398cfcb" :question/math-academy-id "q-45925" :question/problem "For an object moving in a straight line, its acceleration is the rate of change of its speed. What are the units of acceleration in terms of meters and seconds?" :question/worked-solution "We *measure the change* in the speed, as *we change* the time. Consequently, any appropriate unit must take the form\n\n$$\n\\frac{\\text{unit of speed}}{\\text{unit of time}}.\n$$\n\nIn terms of meters and seconds, the unit for speed is $\\frac{\\text{m}}{\\text{s}},$ and the unit for time is $\\text{s}.$ Therefore, the appropriate unit for acceleration is\n\n$$\n\\frac{(\\frac{\\text{m}}{\\text{s}})}{\\text{s}}=\\frac{\\text{m}}{{\\text{s}}^{2}}.\n$$\n\nor, meters per square second." :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-7d2a0144-e2db-559d-95d4-b901779d3f75"] :db/ensure [:question/validate]} {:db/id "answer-field-7d2a0144-e2db-559d-95d4-b901779d3f75" :answer-field/id #uuid "7d2a0144-e2db-559d-95d4-b901779d3f75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-32f41347-0e90-5f70-a725-afb601591ea5" :answer-field/choices ["answer-4b47a822-0376-58c7-bf52-c9886690a3c4" "answer-32f41347-0e90-5f70-a725-afb601591ea5" "answer-0c2c01b0-418c-5e7b-bef1-9f74e8360551" "answer-8260a8d8-6aad-5a51-b1f6-e47075b8707a" "answer-e1e51680-d23b-5e4b-b480-4740a65ffc07"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b47a822-0376-58c7-bf52-c9886690a3c4" :answer/id #uuid "4b47a822-0376-58c7-bf52-c9886690a3c4" :answer/type :answer.type/math :answer/value "\\frac{\\text{m}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-32f41347-0e90-5f70-a725-afb601591ea5" :answer/id #uuid "32f41347-0e90-5f70-a725-afb601591ea5" :answer/type :answer.type/math :answer/value "\\frac{\\text{m}}{{\\text{s}}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-0c2c01b0-418c-5e7b-bef1-9f74e8360551" :answer/id #uuid "0c2c01b0-418c-5e7b-bef1-9f74e8360551" :answer/type :answer.type/math :answer/value "\\frac{\\text{s}}{{\\text{m}}^{2}}" :db/ensure [:answer/validate]} {:db/id "answer-8260a8d8-6aad-5a51-b1f6-e47075b8707a" :answer/id #uuid "8260a8d8-6aad-5a51-b1f6-e47075b8707a" :answer/type :answer.type/math :answer/value "\\frac{{\\text{m}}^{2}}{\\text{s}}" :db/ensure [:answer/validate]} {:db/id "answer-e1e51680-d23b-5e4b-b480-4740a65ffc07" :answer/id #uuid "e1e51680-d23b-5e4b-b480-4740a65ffc07" :answer/type :answer.type/math :answer/value "\\text{m}" :db/ensure [:answer/validate]} {:db/id 17592186172111 :knowledge-point/questions ["question-8404264d-3a64-5581-ad4c-0afe9c6e6c44"] :db/ensure [:knowledge-point/validate]} {:db/id "question-8404264d-3a64-5581-ad4c-0afe9c6e6c44" :question/id #uuid "8404264d-3a64-5581-ad4c-0afe9c6e6c44" :question/math-academy-id "q-78940" :question/problem "$|-\\frac{4{c}^{2}}{7}|=$" :question/worked-solution "Firstly, since $|-a|=|a|,$ we can write our expression as\n\n$$\n|\\frac{4{c}^{2}}{7}|.\n$$\n\nThen, we distribute the absolute value over the multiplication and division:\n\n$$\n\\begin{aligned}|\\frac{4{c}^{2}}{7}| & = \\\\ \\frac{|4{c}^{2}|}{|7|} & = \\\\ \\frac{4|{c}^{2}|}{|7|} & = \\\\ \\frac{4|{c}^{2}|}{7}\\end{aligned}\n$$\n\nSince ${c}^{2}\\ge 0$ for any real $c,$ we have that $|{c}^{2}|={c}^{2}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{4|{c}^{2}|}{7} & =\\frac{4{c}^{2}}{7}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-5d6de616-d83b-5377-8c79-b2dcdeb0a26b"] :db/ensure [:question/validate]} {:db/id "answer-field-5d6de616-d83b-5377-8c79-b2dcdeb0a26b" :answer-field/id #uuid "5d6de616-d83b-5377-8c79-b2dcdeb0a26b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer-field/choices ["answer-4aed9040-08cc-5807-b5a4-1787d0109cec" "answer-6effc252-b0f9-5d2b-ad31-932aa4478f40" "answer-b66c1b22-292a-59dd-be49-5eeabdfb43cc" "answer-e9c0d0b4-c3e0-5116-88df-a59415a5b128" "answer-4f24db4a-1005-5049-be48-5d4cdcd1f83c"] :db/ensure [:answer-field/validate]} {:db/id "answer-4aed9040-08cc-5807-b5a4-1787d0109cec" :answer/id #uuid "4aed9040-08cc-5807-b5a4-1787d0109cec" :answer/type :answer.type/math :answer/value "-28{c}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-6effc252-b0f9-5d2b-ad31-932aa4478f40" :answer/id #uuid "6effc252-b0f9-5d2b-ad31-932aa4478f40" :answer/type :answer.type/math :answer/value "-\\frac{4{c}^{2}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-b66c1b22-292a-59dd-be49-5eeabdfb43cc" :answer/id #uuid "b66c1b22-292a-59dd-be49-5eeabdfb43cc" :answer/type :answer.type/math :answer/value "28{c}^{2}" :db/ensure [:answer/validate]} {:db/id "answer-e9c0d0b4-c3e0-5116-88df-a59415a5b128" :answer/id #uuid "e9c0d0b4-c3e0-5116-88df-a59415a5b128" :answer/type :answer.type/math :answer/value "\\frac{-4(c)^{2}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer/id #uuid "4f24db4a-1005-5049-be48-5d4cdcd1f83c" :answer/type :answer.type/math :answer/value "\\frac{4{c}^{2}}{7}" :db/ensure [:answer/validate]} {:db/id 17592186083330 :knowledge-point/questions ["question-919304f4-9784-5406-8c58-3a53fea4edc4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-919304f4-9784-5406-8c58-3a53fea4edc4" :question/id #uuid "919304f4-9784-5406-8c58-3a53fea4edc4" :question/math-academy-id "q-43567" :question/problem "Find $\\text{LCM}(18,30).$" :question/worked-solution "To find the lowest common multiple of two numbers, we first find the prime factorization of both numbers. \n\n- We start by finding the prime factorization of $18:$ \n\n![](images/9e/9e7bddde8a287f6224b3e79f9fdacc3ac22d6db5a021b85df287e5e5fa321932.png)\n\n \nTherefore, $18=2\\cdot {3}^{2}.$\n\n- Next, we find the prime factorization of $30:$\n\n![](images/31/312d8c33355fb36260cce172ab20bf907637528d0a5d04dc4dd1eceb59d765dd.png)\n\n \nTherefore, $30=2\\cdot 3\\cdot 5.$\n\nSo, we have the following prime factorizations:\n\n$$\n\\begin{aligned}18 & =2\\cdot {3}^{2} \\\\ 30 & =2\\cdot 3\\cdot 5\\end{aligned}\n$$\n\nNow, we write down every prime factor that is shown above, and we raise each prime factor to the highest power given in either factorization:\n\n- the highest power of $2$ is $1$\n\n- the highest power of $3$ is $2$\n\n- the highest power of $5$ is $1$\n\nTherefore, the lowest common multiple of $18$ and $30$ is \n\n$$\n\\text{LCM}(18,30)=2\\cdot {3}^{2}\\cdot 5=90.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d9ca9e5c-13b4-5378-89a1-16e1132aad45"] :db/ensure [:question/validate]} {:db/id "answer-field-d9ca9e5c-13b4-5378-89a1-16e1132aad45" :answer-field/id #uuid "d9ca9e5c-13b4-5378-89a1-16e1132aad45" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4479c3ed-9983-547b-abb3-f811acaf8508" :answer-field/choices ["answer-f33995be-d5da-5fe4-8be3-3948c991c6da" "answer-09a49a6f-e4ec-5fb0-af87-0497ff08ef5c" "answer-2f77e5cf-71c2-517b-9c44-d94ee4f08168" "answer-53cd9597-c31e-5e16-b33d-d3a647a72f3a" "answer-4479c3ed-9983-547b-abb3-f811acaf8508"] :db/ensure [:answer-field/validate]} {:db/id "answer-f33995be-d5da-5fe4-8be3-3948c991c6da" :answer/id #uuid "f33995be-d5da-5fe4-8be3-3948c991c6da" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-09a49a6f-e4ec-5fb0-af87-0497ff08ef5c" :answer/id #uuid "09a49a6f-e4ec-5fb0-af87-0497ff08ef5c" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "answer-2f77e5cf-71c2-517b-9c44-d94ee4f08168" :answer/id #uuid "2f77e5cf-71c2-517b-9c44-d94ee4f08168" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-53cd9597-c31e-5e16-b33d-d3a647a72f3a" :answer/id #uuid "53cd9597-c31e-5e16-b33d-d3a647a72f3a" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "answer-4479c3ed-9983-547b-abb3-f811acaf8508" :answer/id #uuid "4479c3ed-9983-547b-abb3-f811acaf8508" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id 17592186083783 :question/problem "Captain Sparrow's ship is $150\\,\\text{km}$ away from a lighthouse, while Captain Jones' ship is at a distance of $450\\,\\text{km}$ from the same lighthouse. Assuming that the three locations form a triangle, what is the range of all possible values for the distance between the two ships?" :question/worked-solution "First, we let: \n\n- $S$ be the position of Captain Sparrow's ship\n\n- $J$ be the position of Captain Jones' ship\n\n- $L$ be the position of the lighthouse\n\nLet's draw $△SJL.$\n\n![](images/da/daa3d50135304457e258e3f702a115162a085a4c3940070b4ac3cef77d5ae748.png)\n\nWe know that\n\n$$\nSL=150\\,\\text{km},\\,JL=450\\,\\text{km}.\n$$\n\nAccording to the triangle inequality theorem,\n\n$$\n\\begin{aligned}JL-SL & <JS<JL+SL \\\\ 450-150 & <JS<450+150 \\\\ 300 & <JS<600.\\end{aligned}\n$$\n\nTherefore, the distance from Captain Sparrow's to Captain Jones' ship must be *between $300\\,\\text{km}$ and $600\\,\\text{km}$*." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186081629 :answer-field/correct "answer-095e4586-7797-5c50-acb3-59cf2d012ac1" :answer-field/choices ["answer-966587d5-4b8d-5b36-be28-5a95a82d75c5" "answer-095e4586-7797-5c50-acb3-59cf2d012ac1" "answer-9862033a-b48a-5571-b9ee-129e1361d314" "answer-238fce51-3d98-5221-a18f-c58850f70188" "answer-a5a4395a-46de-5f09-a0d7-51daf5c6e185"] :db/ensure [:answer-field/validate]} {:db/id "answer-966587d5-4b8d-5b36-be28-5a95a82d75c5" :answer/id #uuid "966587d5-4b8d-5b36-be28-5a95a82d75c5" :answer/type :answer.type/text :answer/value "between $300\\,\\text{km}$ and $400\\,\\text{km}$" :db/ensure [:answer/validate]} {:db/id "answer-095e4586-7797-5c50-acb3-59cf2d012ac1" :answer/id #uuid "095e4586-7797-5c50-acb3-59cf2d012ac1" :answer/type :answer.type/text :answer/value "between $300\\,\\text{km}$ and $600\\,\\text{km}$" :db/ensure [:answer/validate]} {:db/id "answer-9862033a-b48a-5571-b9ee-129e1361d314" :answer/id #uuid "9862033a-b48a-5571-b9ee-129e1361d314" :answer/type :answer.type/text :answer/value "between $400\\,\\text{km}$ and $600\\,\\text{km}$" :db/ensure [:answer/validate]} {:db/id "answer-238fce51-3d98-5221-a18f-c58850f70188" :answer/id #uuid "238fce51-3d98-5221-a18f-c58850f70188" :answer/type :answer.type/text :answer/value "between $400\\,\\text{km}$ and $800\\,\\text{km}$" :db/ensure [:answer/validate]} {:db/id "answer-a5a4395a-46de-5f09-a0d7-51daf5c6e185" :answer/id #uuid "a5a4395a-46de-5f09-a0d7-51daf5c6e185" :answer/type :answer.type/text :answer/value "between $600\\,\\text{km}$ and $800\\,\\text{km}$" :db/ensure [:answer/validate]} {:db/id 17592186073726 :knowledge-point/questions ["question-e0a4a8a4-751d-5872-ad1c-8d3477e4c365"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e0a4a8a4-751d-5872-ad1c-8d3477e4c365" :question/id #uuid "e0a4a8a4-751d-5872-ad1c-8d3477e4c365" :question/math-academy-id "q-148287" :question/problem "Peter pays $\\frac{3}{5}$ of a dollar for $\\frac{1}{15}$ of a pound of pumpkin seeds. How much should he pay for $3$ pounds of seeds?" :question/worked-solution "To determine how much Peter should pay for $3$ pounds of seeds, we first find the unit rate of dollars per pound and then multiply it by $3$ pounds.\n\nTo find the unit rate of dollars per pound, we divide the number of dollars, $\\frac{3}{5},$ by the number of pounds, $\\frac{1}{15},$ as follows:\n\n$$\n\\frac{3}{5}÷\\frac{1}{15}\n$$\n\nDividing one fraction by another is equivalent to multiplying the fraction by the reciprocal of the second fraction:\n\n$$\n\\begin{aligned}\\frac{3}{5}÷\\frac{1}{15} & =\\frac{3}{5}\\times \\frac{15}{1} \\\\  & =\\frac{3\\times 15}{5\\times 1} \\\\  & =\\frac{45}{5} \\\\  & =45÷5 \\\\  & =9\\end{aligned}\n$$\n\nSo, the unit rate is $9$ dollars per pound. To determine how much Peter should pay for $3$ pounds, we multiply the unit rate by $3$ pounds and get\n\n$$\n9\\times 3=27.\n$$\n\nTherefore, Peter must pay $27$ dollars for $3$ pounds of pumpkin seeds." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e291dcc7-8c1e-5891-b89d-054f30fdf260"] :db/ensure [:question/validate]} {:db/id "answer-field-e291dcc7-8c1e-5891-b89d-054f30fdf260" :answer-field/id #uuid "e291dcc7-8c1e-5891-b89d-054f30fdf260" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d5445e47-0caa-523d-a710-3fc1a4dce491" :answer-field/choices ["answer-4fd4acc3-a923-5db9-8ff0-2bb877f1bb6c" "answer-d5445e47-0caa-523d-a710-3fc1a4dce491" "answer-73f566d9-4d80-5e41-bf04-bed2d3dceb46" "answer-10817ad1-584a-5cae-9e74-85b7d8b67207" "answer-802803f5-5ea3-5767-b470-c0bd3aa61b84"] :db/ensure [:answer-field/validate]} {:db/id "answer-4fd4acc3-a923-5db9-8ff0-2bb877f1bb6c" :answer/id #uuid "4fd4acc3-a923-5db9-8ff0-2bb877f1bb6c" :answer/type :answer.type/text :answer/value "$24$ dollars" :db/ensure [:answer/validate]} {:db/id "answer-d5445e47-0caa-523d-a710-3fc1a4dce491" :answer/id #uuid "d5445e47-0caa-523d-a710-3fc1a4dce491" :answer/type :answer.type/text :answer/value "$27$ dollars" :db/ensure [:answer/validate]} {:db/id "answer-73f566d9-4d80-5e41-bf04-bed2d3dceb46" :answer/id #uuid "73f566d9-4d80-5e41-bf04-bed2d3dceb46" :answer/type :answer.type/text :answer/value "$30$ dollars" :db/ensure [:answer/validate]} {:db/id "answer-10817ad1-584a-5cae-9e74-85b7d8b67207" :answer/id #uuid "10817ad1-584a-5cae-9e74-85b7d8b67207" :answer/type :answer.type/text :answer/value "$32$ dollars" :db/ensure [:answer/validate]} {:db/id "answer-802803f5-5ea3-5767-b470-c0bd3aa61b84" :answer/id #uuid "802803f5-5ea3-5767-b470-c0bd3aa61b84" :answer/type :answer.type/text :answer/value "$35$ dollars" :db/ensure [:answer/validate]} {:db/id 17592186133850 :knowledge-point/questions ["question-fdafad3a-7759-57a9-8969-df2e3e1dfbfc"] :db/ensure [:knowledge-point/validate]} {:db/id "question-fdafad3a-7759-57a9-8969-df2e3e1dfbfc" :question/id #uuid "fdafad3a-7759-57a9-8969-df2e3e1dfbfc" :question/math-academy-id "q-44817" :question/problem "A  recording studio charges musicians an initial fee of $$80$ to record an album. The studio also charges an additional $$50$ per hour.\n\nWhat expression gives the cost, in dollars, of recording an album,  in terms of the number of hours $h$ used?" :question/worked-solution "The fixed fee for recording an album is $$80.$ Hence,  $80$ should be a constant term.\n\nNow, if $h$ is the number of hours used to record an album, the cost  for $h$ hours of a recording must be $50h$ dollars.\n\nTherefore, the expression that represents the total cost, in dollars, of recording an album will be $50h+80.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c72e6967-872e-5a8d-a85b-1b0076606cb0"] :db/ensure [:question/validate]} {:db/id "answer-field-c72e6967-872e-5a8d-a85b-1b0076606cb0" :answer-field/id #uuid "c72e6967-872e-5a8d-a85b-1b0076606cb0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5d1abfe8-147b-5dad-818f-b3e773fcec28" :answer-field/choices ["answer-9b4cd0f0-08f2-55b4-ae98-e19ad7c982e8" "answer-76ebbf98-0b4a-52d3-bc2f-d43672813fba" "answer-0d160da5-61d6-5a2e-be7c-65ff5bdb5a5f" "answer-5d1abfe8-147b-5dad-818f-b3e773fcec28" "answer-92630e05-756a-5d8e-9c72-9166455f8a5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-9b4cd0f0-08f2-55b4-ae98-e19ad7c982e8" :answ