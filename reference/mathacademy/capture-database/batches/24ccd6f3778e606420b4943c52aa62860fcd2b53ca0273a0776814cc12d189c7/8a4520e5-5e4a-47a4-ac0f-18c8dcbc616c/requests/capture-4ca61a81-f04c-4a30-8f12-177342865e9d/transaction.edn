{ is not a rhombus})∨(Q\\text{ is a rectangle})) \\\\  & ≡¬(P\\text{ is not a rhombus})∧¬(Q\\text{ is a rectangle}) \\\\  & ≡(P\\text{ is a rhombus})∧(Q\\text{ is not a rectangle}) \\\\  & ≡P\\text{ is a rhombus}\\text{ and }Q\\text{ is not a rectangle}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-9b647c49-0fad-5ace-9be0-c641fb1f8973"] :db/ensure [:question/validate]} {:db/id "answer-field-9b647c49-0fad-5ace-9be0-c641fb1f8973" :answer-field/id #uuid "9b647c49-0fad-5ace-9be0-c641fb1f8973" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-41754bbb-e135-5737-bc6c-0219d0f8458e" :answer-field/choices ["answer-20e1fa6a-4a62-5836-b4ba-11a2eded1e8d" "answer-41754bbb-e135-5737-bc6c-0219d0f8458e" "answer-3f713160-3a26-5c0b-8777-1aa7e220d24c" "answer-dae0852e-3db4-5738-b528-341b0bc199c7" "answer-203a29e8-cddb-51c2-b7aa-9c45eb2c1219"] :db/ensure [:answer-field/validate]} {:db/id "answer-20e1fa6a-4a62-5836-b4ba-11a2eded1e8d" :answer/id #uuid "20e1fa6a-4a62-5836-b4ba-11a2eded1e8d" :answer/type :answer.type/text :answer/value "$P$ is a rhombus and $Q$ is a rectangle" :db/ensure [:answer/validate]} {:db/id "answer-41754bbb-e135-5737-bc6c-0219d0f8458e" :answer/id #uuid "41754bbb-e135-5737-bc6c-0219d0f8458e" :answer/type :answer.type/text :answer/value "$P$ is a rhombus and $Q$ is not a rectangle" :db/ensure [:answer/validate]} {:db/id "answer-3f713160-3a26-5c0b-8777-1aa7e220d24c" :answer/id #uuid "3f713160-3a26-5c0b-8777-1aa7e220d24c" :answer/type :answer.type/text :answer/value "$P$ is a rhombus or $Q$ is a rectangle" :db/ensure [:answer/validate]} {:db/id "answer-dae0852e-3db4-5738-b528-341b0bc199c7" :answer/id #uuid "dae0852e-3db4-5738-b528-341b0bc199c7" :answer/type :answer.type/text :answer/value "$P$ is a rhombus or $Q$ is not a rectangle" :db/ensure [:answer/validate]} {:db/id "answer-203a29e8-cddb-51c2-b7aa-9c45eb2c1219" :answer/id #uuid "203a29e8-cddb-51c2-b7aa