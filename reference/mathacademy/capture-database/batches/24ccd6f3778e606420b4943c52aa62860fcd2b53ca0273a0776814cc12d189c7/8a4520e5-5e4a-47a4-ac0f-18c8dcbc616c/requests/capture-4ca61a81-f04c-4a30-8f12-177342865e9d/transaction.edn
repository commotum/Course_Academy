t {C}_{22}+0\\cdot {C}_{32}+0\\cdot {C}_{42} \\\\  & =7\\cdot (-1)^{2+2}\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix} \\\\  & =7\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a1a35c11-1718-5858-8f1b-dc2e223ac845"] :db/ensure [:question/validate]} {:db/id "answer-field-a1a35c11-1718-5858-8f1b-dc2e223ac845" :answer-field/id #uuid "a1a35c11-1718-5858-8f1b-dc2e223ac845" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6a1b5d04-293b-553e-972d-167baa36d535" :answer-field/choices ["answer-dce560fb-5aad-5c38-ab7a-1086c421ce9d" "answer-7a74ce83-0206-5091-9e8a-38d2087cd86a" "answer-24db72c9-9ccd-525e-a0f2-121f4fcae724" "answer-6a1b5d04-293b-553e-972d-167baa36d535" "answer-301ba18f-3157-5dcf-a476-38699ddf21de"] :db/ensure [:answer-field/validate]} {:db/id "answer-dce560fb-5aad-5c38-ab7a-1086c421ce9d" :answer/id #uuid "dce560fb-5aad-5c38-ab7a-1086c421ce9d" :answer/type :answer.type/math :answer/value "-7\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\\\ -2 & 3 & -1\\end{vmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-7a74ce83-0206-5091-9e8a-38d2087cd86a" :answer/id #uuid "7a74ce83-0206-5091-9e8a-38d2087cd86a" :answer/type :answer.type/math :answer/value "3\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ 3 & 2 & 1 \\\\ -2 & 3 & -1\\end{vmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-24db72c9-9ccd-525e-a0f2-121f4fcae724" :answer/id #uuid "24db72c9-9ccd-525e-a0f2-121f4fcae724" :answer/type :answer.type/math :answer/value "5\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ 2 & 1 & -3 \\\\ -1 & 3 & -2\\end{vmatrix}" :db/ensure [:answer/validate]} {:db/id "answer-6a1b5d04-293b-553e-972d-167baa36d535" :answer/id #uuid "6a1b5d04-293b-553e-972d-167baa36d535" :answer/type :answer.type/math :answer/value "7\\cdot \\begin{vmatrix}2 & -1 & 3 \\\\ -3 & 1 & 2 \\