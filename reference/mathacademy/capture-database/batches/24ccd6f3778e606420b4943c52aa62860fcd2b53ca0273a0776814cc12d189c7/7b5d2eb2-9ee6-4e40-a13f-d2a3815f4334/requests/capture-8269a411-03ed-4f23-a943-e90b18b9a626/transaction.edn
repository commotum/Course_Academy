6a93e2d2eb57" "answer-6585f761-41c7-50e3-9258-db39330cd34c" "answer-e18a92f3-73f9-5576-9399-10cb385c1604" "answer-306d6638-b396-5a5e-9c83-fd117fb42399" "answer-00278cbd-218b-5c7a-8dee-57905a0ca05d"] :db/ensure [:answer-field/validate]} {:db/id "answer-dae3b41a-f6fc-54c2-8c43-6a93e2d2eb57" :answer/id #uuid "dae3b41a-f6fc-54c2-8c43-6a93e2d2eb57" :answer/type :answer.type/text :answer/value "$1$ and $10$" :db/ensure [:answer/validate]} {:db/id "answer-6585f761-41c7-50e3-9258-db39330cd34c" :answer/id #uuid "6585f761-41c7-50e3-9258-db39330cd34c" :answer/type :answer.type/text :answer/value "$1$ and $11$" :db/ensure [:answer/validate]} {:db/id "answer-e18a92f3-73f9-5576-9399-10cb385c1604" :answer/id #uuid "e18a92f3-73f9-5576-9399-10cb385c1604" :answer/type :answer.type/text :answer/value "$1$ and $5$" :db/ensure [:answer/validate]} {:db/id "answer-306d6638-b396-5a5e-9c83-fd117fb42399" :answer/id #uuid "306d6638-b396-5a5e-9c83-fd117fb42399" :answer/type :answer.type/text :answer/value "$10$ and $1$" :db/ensure [:answer/validate]} {:db/id "answer-00278cbd-218b-5c7a-8dee-57905a0ca05d" :answer/id #uuid "00278cbd-218b-5c7a-8dee-57905a0ca05d" :answer/type :answer.type/text :answer/value "$2$ and $5$" :db/ensure [:answer/validate]} {:db/id "question-65b04197-0da3-5f1d-9e28-7fa4c1811bab" :question/id #uuid "65b04197-0da3-5f1d-9e28-7fa4c1811bab" :question/math-academy-id "q-92948" :question/problem "From left to right, what are the missing numbers in the following sentence?\n\nA lemonade recipe requires $\\frac{2}{7}$ cups of lemon juice for every cup of water. Therefore, the lemonade has a ratio of $\\boxed{}$ cups of lemon juice to $\\boxed{}$ cups of water." :question/worked-solution "Let's rewrite the fraction $\\frac{2}{7}$ as a ratio:\n\n$$\n2:7\n$$\n\nTherefore, the lemonade has a ratio of $2$ cups of lemon juice to $7$ cups of water." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-669e4c86-27e8-5e24-af37-37d25f296bec"] :db/ensure [:question/validate]} {:db/id "answer-field-669e4c86-27e8-5e24-af37-37d25f296bec" :answer-field/id #uuid "669e4c86-27e8-5e24-af37-37d25f296bec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0ca1dcf8-0e7a-503d-8a4d-8c393a65406e" :answer-field/choices ["answer-0ca1dcf8-0e7a-503d-8a4d-8c393a65406e" "answer-03818b6d-8ef8-5381-bb95-3faf2c77c195" "answer-e004e420-0bca-55d9-965d-02c77297b08d" "answer-67e32dab-1516-538f-9bdb-db7acb86020c" "answer-066a643c-2895-57f1-bada-289328d1a09d"] :db/ensure [:answer-field/validate]} {:db/id "answer-0ca1dcf8-0e7a-503d-8a4d-8c393a65406e" :answer/id #uuid "0ca1dcf8-0e7a-503d-8a4d-8c393a65406e" :answer/type :answer.type/text :answer/value "$2$ and $7$" :db/ensure [:answer/validate]} {:db/id "answer-03818b6d-8ef8-5381-bb95-3faf2c77c195" :answer/id #uuid "03818b6d-8ef8-5381-bb95-3faf2c77c195" :answer/type :answer.type/text :answer/value "$2$ and $9$" :db/ensure [:answer/validate]} {:db/id "answer-e004e420-0bca-55d9-965d-02c77297b08d" :answer/id #uuid "e004e420-0bca-55d9-965d-02c77297b08d" :answer/type :answer.type/text :answer/value "$7$ and $2$" :db/ensure [:answer/validate]} {:db/id "answer-67e32dab-1516-538f-9bdb-db7acb86020c" :answer/id #uuid "67e32dab-1516-538f-9bdb-db7acb86020c" :answer/type :answer.type/text :answer/value "$7$ and $9$" :db/ensure [:answer/validate]} {:db/id "answer-066a643c-2895-57f1-bada-289328d1a09d" :answer/id #uuid "066a643c-2895-57f1-bada-289328d1a09d" :answer/type :answer.type/text :answer/value "$9$ and $2$" :db/ensure [:answer/validate]} {:db/id "question-6e29d990-90ac-50f9-be81-d4fdf354bbe5" :question/id #uuid "6e29d990-90ac-50f9-be81-d4fdf354bbe5" :question/math-academy-id "q-92954" :question/problem "What is missing in the following sentence?\n\nJoanna cooks rice for lunch. According to the recipe, the ratio of cups of rice to cups of water is $2:4,$ so $\\boxed{}$ cups of rice are needed for each cup of water." :question/worked-solution "We can rewrite the ratio $2:4$ as the following fraction:\n\n$$\n\\frac{2}{4}\n$$\n\nWe can simplify the fraction by dividing the numerator and denominator by $2:$\n\n$$\n\\frac{2}{4}=\\frac{2÷2}{4÷2}=\\frac{1}{2}\n$$\n\nThis means that $\\frac{1}{2}$ cups of rice are needed for each cup of water." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4e02ca66-40fc-50dc-b8d3-e20362ff2ade"] :db/ensure [:question/validate]} {:db/id "answer-field-4e02ca66-40fc-50dc-b8d3-e20362ff2ade" :answer-field/id #uuid "4e02ca66-40fc-50dc-b8d3-e20362ff2ade" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2ecb1468-6372-55e5-9e8a-2c1fa8aa2ad0" :answer-field/choices ["answer-9dc6d91d-264a-5f71-8480-71d2ab489853" "answer-5e7b0ce8-9530-5d61-96d4-0574b74fdfe5" "answer-2ecb1468-6372-55e5-9e8a-2c1fa8aa2ad0" "answer-d8f144c8-0d43-5809-9bc2-812682e08229" "answer-760d6bd8-ec14-50fb-ab82-8c2e74383fbe"] :db/ensure [:answer-field/validate]} {:db/id "answer-9dc6d91d-264a-5f71-8480-71d2ab489853" :answer/id #uuid "9dc6d91d-264a-5f71-8480-71d2ab489853" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-5e7b0ce8-9530-5d61-96d4-0574b74fdfe5" :answer/id #uuid "5e7b0ce8-9530-5d61-96d4-0574b74fdfe5" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-2ecb1468-6372-55e5-9e8a-2c1fa8aa2ad0" :answer/id #uuid "2ecb1468-6372-55e5-9e8a-2c1fa8aa2ad0" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d8f144c8-0d43-5809-9bc2-812682e08229" :answer/id #uuid "d8f144c8-0d43-5809-9bc2-812682e08229" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-760d6bd8-ec14-50fb-ab82-8c2e74383fbe" :answer/id #uuid "760d6bd8-ec14-50fb-ab82-8c2e74383fbe" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "activity-2c4dea3d-8b57-5ab9-9660-a12ffd1d1b1f" :activity/id #uuid "2c4dea3d-8b57-5ab9-9660-a12ffd1d1b1f" :activity/title "Writing Ratios Using Fractions" :activity/type :activity.type/review :activity/scope 17592186050481 :activity/course 17592186046648 :activity/steps ["step-b18cbfc2-8ebe-5aa6-89eb-e5f978dece72" "step-e8e06912-ced5-5f44-8811-f10bdf3cd1ea" "step-3bc58804-f419-5229-8f4c-2ed5c3724d64" "step-20690718-c9fc-54b6-816b-d86290bcf4f8" "step-60822d8e-b043-5841-b4a9-fa16caad25c8"] :activity/first-step "step-b18cbfc2-8ebe-5aa6-89eb-e5f978dece72" :db/ensure [:activity/validate]} {:db/id "step-b18cbfc2-8ebe-5aa6-89eb-e5f978dece72" :step/id #uuid "b18cbfc2-8ebe-5aa6-89eb-e5f978dece72" :step/content "question-d691d9e9-ebc4-5231-9220-d7666a1593ac" :step/next "step-e8e06912-ced5-5f44-8811-f10bdf3cd1ea" :db/ensure [:step/validate]} {:db/id "step-e8e06912-ced5-5f44-8811-f10bdf3cd1ea" :step/id #uuid "e8e06912-ced5-5f44-8811-f10bdf3cd1ea" :step/content "question-98f6bb07-5c0b-539a-985d-169696ff401a" :step/next "step-3bc58804-f419-5229-8f4c-2ed5c3724d64" :db/ensure [:step/validate]} {:db/id "step-3bc58804-f419-5229-8f4c-2ed5c3724d64" :step/id #uuid "3bc58804-f419-5229-8f4c-2ed5c3724d64" :step/content "question-64676ed3-e9e9-5156-a574-3911821b3d41" :step/next "step-20690718-c9fc-54b6-816b-d86290bcf4f8" :db/ensure [:step/validate]} {:db/id "step-20690718-c9fc-54b6-816b-d86290bcf4f8" :step/id #uuid "20690718-c9fc-54b6-816b-d86290bcf4f8" :step/content "question-65b04197-0da3-5f1d-9e28-7fa4c1811bab" :step/next "step-60822d8e-b043-5841-b4a9-fa16caad25c8" :db/ensure [:step/validate]} {:db/id "step-60822d8e-b043-5841-b4a9-fa16caad25c8" :step/id #uuid "60822d8e-b043-5841-b4a9-fa16caad25c8" :step/content "question-6e29d990-90ac-50f9-be81-d4fdf354bbe5" :db/ensure [:step/validate]} {:db/id 17592186054774 :knowledge-point/questions ["question-a1334155-0338-53af-b4b4-aaee0097bc49" "question-3049a347-62dd-59fc-b924-9cdaded3eea2"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a1334155-0338-53af-b4b4-aaee0097bc49" :question/id #uuid "a1334155-0338-53af-b4b4-aaee0097bc49" :question/math-academy-id "q-52149" :question/problem "If  $f(x)={x}^{2}+2x-1$ and $g(x)={x}^{2}-x+1,$ then $f(x)+g(x)=$" :question/worked-solution "We put a plus sign between the two polynomials, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}f(x)+g(x) & = \\\\ ({x}^{2}+2x-1)+({x}^{2}-x+1) & = \\\\ {x}^{2}+2x-1+{x}^{2}-x+1 & = \\\\ (1+1){x}^{2}+(2-1)x+(-1+1) & = \\\\ 2{x}^{2}+x\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8a7113b0-a58d-57b5-a47a-af43596f7853"] :db/ensure [:question/validate]} {:db/id "answer-field-8a7113b0-a58d-57b5-a47a-af43596f7853" :answer-field/id #uuid "8a7113b0-a58d-57b5-a47a-af43596f7853" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d4bbd9a1-0041-563d-a914-532f0f7cd1d0" :answer-field/choices ["answer-d4bbd9a1-0041-563d-a914-532f0f7cd1d0" "answer-c5101782-6ba9-51e4-a135-77437e019f9a" "answer-8e5d516a-08ba-570d-8dc1-5319b30942d0" "answer-eb97ed63-c199-57e5-8df5-f83c4126e6c7" "answer-ce9eb22e-586f-5330-b915-b57b472e6c22"] :db/ensure [:answer-field/validate]} {:db/id "answer-d4bbd9a1-0041-563d-a914-532f0f7cd1d0" :answer/id #uuid "d4bbd9a1-0041-563d-a914-532f0f7cd1d0" :answer/type :answer.type/math :answer/value "2{x}^{2}+x" :db/ensure [:answer/validate]} {:db/id "answer-c5101782-6ba9-51e4-a135-77437e019f9a" :answer/id #uuid "c5101782-6ba9-51e4-a135-77437e019f9a" :answer/type :answer.type/math :answer/value "2{x}^{2}+x-1" :db/ensure [:answer/validate]} {:db/id "answer-8e5d516a-08ba-570d-8dc1-5319b30942d0" :answer/id #uuid "8e5d516a-08ba-570d-8dc1-5319b30942d0" :answer/type :answer.type/math :answer/value "2{x}^{2}-2x" :db/ensure [:answer/validate]} {:db/id "answer-eb97ed63-c199-57e5-8df5-f83c4126e6c7" :answer/id #uuid "eb97ed63-c199-57e5-8df5-f83c4126e6c7" :answer/type :answer.type/math :answer/value "2{x}^{2}-2x-1" :db/ensure [:answer/validate]} {:db/id "answer-ce9eb22e-586f-5330-b915-b57b472e6c22" :answer/id #uuid "ce9eb22e-586f-5330-b915-b57b472e6c22" :answer/type :answer.type/math :answer/value "2{x}^{2}-x" :db/ensure [:answer/validate]} {:db/id 17592186054775 :knowledge-point/questions ["question-c4fbb5a3-d0b3-5e9d-9d9e-30b9caacb035"] :db/ensure [:knowledge-point/validate]} {:db/id "question-c4fbb5a3-d0b3-5e9d-9d9e-30b9caacb035" :question/id #uuid "c4fbb5a3-d0b3-5e9d-9d9e-30b9caacb035" :question/math-academy-id "q-111161" :question/problem "Subtract $5{v}^{4}+6{v}^{3}+9$ from $2{v}^{5}+{v}^{3}+2.$" :question/worked-solution "We put a minus sign between the two polynomials, distribute it over the second polynomial, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}(2{v}^{5}+{v}^{3}+2)-(5{v}^{4}+6{v}^{3}+9) & = \\\\ 2{v}^{5}+{v}^{3}+2-5{v}^{4}-6{v}^{3}-9 & = \\\\ 2{v}^{5}-5{v}^{4}+(1-6){v}^{3}+(2-9) & = \\\\ 2{v}^{5}-5{v}^{4}-5{v}^{3}-7 & \\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-ba315b4a-2ca2-5618-87fb-ec19567b9bbd"] :db/ensure [:question/validate]} {:db/id "answer-field-ba315b4a-2ca2-5618-87fb-ec19567b9bbd" :answer-field/id #uuid "ba315b4a-2ca2-5618-87fb-ec19567b9bbd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ead2d76a-2ace-5594-bd49-b9029b20e0a5" :answer-field/choices ["answer-e68ebbcb-b8dd-5936-97df-68e5e5d343b9" "answer-97882e12-c84e-5545-b61c-5cf076b14de5" "answer-7bb8c115-71c8-52fc-b134-d94686e4b9e1" "answer-ead2d76a-2ace-5594-bd49-b9029b20e0a5" "answer-93e1a070-0be2-5ba6-acb7-6112439ed3d5"] :db/ensure [:answer-field/validate]} {:db/id "answer-e68ebbcb-b8dd-5936-97df-68e5e5d343b9" :answer/id #uuid "e68ebbcb-b8dd-5936-97df-68e5e5d343b9" :answer/type :answer.type/math :answer/value "2{v}^{4}-5{v}^{3}-5{v}^{2}-7" :db/ensure [:answer/validate]} {:db/id "answer-97882e12-c84e-5545-b61c-5cf076b14de5" :answer/id #uuid "97882e12-c84e-5545-b61c-5cf076b14de5" :answer/type :answer.type/math :answer/value "2{v}^{5}-5{v}^{3}-7" :db/ensure [:answer/validate]} {:db/id "answer-7bb8c115-71c8-52fc-b134-d94686e4b9e1" :answer/id #uuid "7bb8c115-71c8-52fc-b134-d94686e4b9e1" :answer/type :answer.type/math :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-ead2d76a-2ace-5594-bd49-b9029b20e0a5" :answer/id #uuid "ead2d76a-2ace-5594-bd49-b9029b20e0a5" :answer/type :answer.type/math :answer/value "2{v}^{5}-5{v}^{4}-5{v}^{3}-7" :db/ensure [:answer/validate]} {:db/id "answer-93e1a070-0be2-5ba6-acb7-6112439ed3d5" :answer/id #uuid "93e1a070-0be2-5ba6-acb7-6112439ed3d5" :answer/type :answer.type/math :answer/value "2{v}^{5}-5{v}^{4}-7" :db/ensure [:answer/validate]} {:db/id "question-3049a347-62dd-59fc-b924-9cdaded3eea2" :question/id #uuid "3049a347-62dd-59fc-b924-9cdaded3eea2" :question/math-academy-id "q-236407" :question/problem "Given that $f(y)={y}^{4}+3{y}^{2}-1$ and $g(y)=2{y}^{2}-3,$ write $f(y)+g(y)$ in **standard form**.\n\n$f(y)+g(y)=$\n{{field-1}}" :question/worked-solution "We put a plus sign between the two polynomials, collect like terms, and then simplify:\n\n$$\n\\begin{aligned}f(y)+g(y) & = \\\\ ({y}^{4}+3{y}^{2}-1)+(2{y}^{2}-3) & = \\\\ {y}^{4}+3{y}^{2}-1+2{y}^{2}-3 & = \\\\ {y}^{4}+(3+2){y}^{2}+(-1-3) & = \\\\ {y}^{4}+5{y}^{2}-4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a8ce49c6-f3b3-587c-9376-29dad2462846"] :db/ensure [:question/validate]} {:db/id "answer-field-a8ce49c6-f3b3-587c-9376-29dad2462846" :answer-field/id #uuid "a8ce49c6-f3b3-587c-9376-29dad2462846" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c2c0111b-77f9-5dd6-b35b-60f59cc17ed0" :answer-field/choices ["answer-c2c0111b-77f9-5dd6-b35b-60f59cc17ed0"] :db/ensure [:answer-field/validate]} {:db/id "answer-c2c0111b-77f9-5dd6-b35b-60f59cc17ed0" :answer/id #uuid "c2c0111b-77f9-5dd6-b35b-60f59cc17ed0" :answer/type :answer.type/math :answer/value "y^{4}+5y^{2}-4" :db/ensure [:answer/validate]} {:db/id "activity-73266ed4-30cb-5847-ac3d-ab851cbca830" :activity/id #uuid "73266ed4-30cb-5847-ac3d-ab851cbca830" :activity/title "Adding and Subtracting Polynomials" :activity/type :activity.type/review :activity/scope 17592186048524 :activity/course 17592186046648 :activity/steps ["step-5580cfdb-be1b-5915-8303-3905df0f17cf" "step-8b9562fb-ac19-51ea-8cfe-33ad4b3a7610" "step-1820fa64-0ab6-516c-bd75-2c95420c5d15"] :activity/first-step "step-5580cfdb-be1b-5915-8303-3905df0f17cf" :db/ensure [:activity/validate]} {:db/id "step-5580cfdb-be1b-5915-8303-3905df0f17cf" :step/id #uuid "5580cfdb-be1b-5915-8303-3905df0f17cf" :step/content "question-a1334155-0338-53af-b4b4-aaee0097bc49" :step/next "step-8b9562fb-ac19-51ea-8cfe-33ad4b3a7610" :db/ensure [:step/validate]} {:db/id "step-8b9562fb-ac19-51ea-8cfe-33ad4b3a7610" :step/id #uuid "8b9562fb-ac19-51ea-8cfe-33ad4b3a7610" :step/content "question-c4fbb5a3-d0b3-5e9d-9d9e-30b9caacb035" :step/next "step-1820fa64-0ab6-516c-bd75-2c95420c5d15" :db/ensure [:step/validate]} {:db/id "step-1820fa64-0ab6-516c-bd75-2c95420c5d15" :step/id #uuid "1820fa64-0ab6-516c-bd75-2c95420c5d15" :step/content "question-3049a347-62dd-59fc-b924-9cdaded3eea2" :db/ensure [:step/validate]} {:db/id 17592186124656 :knowledge-point/questions ["question-50860c27-301d-5231-9268-fbee285d7c09" "question-798ecbfd-5ca4-5e85-b538-375fc7b94df7"] :db/ensure [:knowledge-point/validate]} {:db/id "question-50860c27-301d-5231-9268-fbee285d7c09" :question/id #uuid "50860c27-301d-5231-9268-fbee285d7c09" :question/math-academy-id "q-37146" :question/problem "Find the global extrema of the function $f(x,y)=(x-1)^{2}+{y}^{2}$ on the closed region  $D=\\{(x,y):{x}^{2}+{y}^{2}\\le 9\\}.$ You are given that $f$ has a critical point at  $(1,0)$ and on the boundary of the region the points that could give rise to extreme values are  $(-3,0)$, and $(3,0).$" :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$ \n\n**Step 1.** Find the critical points inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/d7/d7864a36585a145e009846b23142372caeff3a68f17c9d1f7d1cf17e642f9543.png)\n\nSince the critical point $(1,0)$ lies inside $D,$ we include that point in the list of candidates for the extrema. \n\n**Step 2.** Find the points on the boundary that could give rise to extreme values.\n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(3,0),\\,(-3,0).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following:  \n\n$$\n\\begin{aligned}f(1,0) & =(1-1)^{2}+(0)^{2} \\\\  & =0 \\\\ f(3,0) & =(2)^{2}+(0)^{2} \\\\  & =4 \\\\ f(-3,0) & =(-4)^{2}+(0)^{2} \\\\  & =16\\end{aligned}\n$$\n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $0$ at the point $(1,0),$ and\n\n- $f$ attains the global maximum of $16$ at the point $(-3,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-750f6f9e-b6e0-5035-8e03-025f023dadec"] :db/ensure [:question/validate]} {:db/id "answer-field-750f6f9e-b6e0-5035-8e03-025f023dadec" :answer-field/id #uuid "750f6f9e-b6e0-5035-8e03-025f023dadec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f3c7bece-f4b8-5686-919a-a5cb331f67ba" :answer-field/choices ["answer-edc7a1cd-95f8-56b1-b089-7c0beaf8c25d" "answer-3a98d925-ab88-52f8-884f-7e6b8120f7cd" "answer-f3c7bece-f4b8-5686-919a-a5cb331f67ba" "answer-3d039668-18b1-5d4a-9869-1e01eaef1bf8" "answer-589e8125-b8d8-5115-be4b-3627bde6a5ff"] :db/ensure [:answer-field/validate]} {:db/id "answer-edc7a1cd-95f8-56b1-b089-7c0beaf8c25d" :answer/id #uuid "edc7a1cd-95f8-56b1-b089-7c0beaf8c25d" :answer/type :answer.type/text :answer/value "${f}_{min}=-2$ and ${f}_{max}=0$" :db/ensure [:answer/validate]} {:db/id "answer-3a98d925-ab88-52f8-884f-7e6b8120f7cd" :answer/id #uuid "3a98d925-ab88-52f8-884f-7e6b8120f7cd" :answer/type :answer.type/text :answer/value "${f}_{min}=-2$ and ${f}_{max}=16$" :db/ensure [:answer/validate]} {:db/id "answer-f3c7bece-f4b8-5686-919a-a5cb331f67ba" :answer/id #uuid "f3c7bece-f4b8-5686-919a-a5cb331f67ba" :answer/type :answer.type/text :answer/value "${f}_{min}=0$ and ${f}_{max}=16$" :db/ensure [:answer/validate]} {:db/id "answer-3d039668-18b1-5d4a-9869-1e01eaef1bf8" :answer/id #uuid "3d039668-18b1-5d4a-9869-1e01eaef1bf8" :answer/type :answer.type/text :answer/value "${f}_{min}=0$ and ${f}_{max}=4$" :db/ensure [:answer/validate]} {:db/id "answer-589e8125-b8d8-5115-be4b-3627bde6a5ff" :answer/id #uuid "589e8125-b8d8-5115-be4b-3627bde6a5ff" :answer/type :answer.type/text :answer/value "${f}_{min}=1$ and ${f}_{max}=4$" :db/ensure [:answer/validate]} {:db/id 17592186125035 :question/problem "Find the global extrema of the function $f(x,y)={x}^{2}+{y}^{2}-4x+4$ on the closed region $D=\\{(x,y)\\,:\\,{x}^{2}+{y}^{2}\\le 9\\}.$ You are given that the function has a critical point at $(2,0)\\in D.$" :db/ensure [:question/validate]} {:db/id "question-798ecbfd-5ca4-5e85-b538-375fc7b94df7" :question/id #uuid "798ecbfd-5ca4-5e85-b538-375fc7b94df7" :question/math-academy-id "q-83400" :question/problem "Find the global maximum of the function $f(x,y)=2{x}^{2}+{y}^{2}-4x-2y$ on the closed triangular region  $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2-x\\}.$ You're given that $f$ has a critical point at $(1,1)$ and on the boundary of the triangle the points that could give rise to extreme values are the vertices." :question/worked-solution "Since $f(x,y)$ is continuous on the closed, bounded region $D,$ the function attains a global maximum and minimum on $D.$\n\nTo find the extreme values, we follow three steps.\n\n**Step 1.** Find the critical points of $f$ that lie inside the region $D.$ \n\nTo determine the critical points, let's first sketch the region:\n\n![](images/30/30a739bfccac0a1ccc405b7ce1fd34afd46b5a2f436c852cef0bb38a13ec1e64.png)\n\n \n\nSince the point $(1,1)$ does not belong to the interior of $D$, we do not yet include it in the list of candidates for extrema (it lies on the boundary of $D,$ so we will consider it in the next step).\n\n**Step 2.** Find the points on the boundary that could give rise to extreme values. \n\nIn this case, we are *given* the points on the boundary of our region that could potentially be global extrema for $f.$ These are\n\n$$\n(0,2),\\,(2,0),\\,(0,0),\\,(1,1).\n$$\n\n**Step 3.** Evaluate $f(x,y)$ at each of the candidate points, and compare their values. \n\nEvaluating $f(x,y)$ at each of the points mentioned above, we get the following: \n\n$$\n\\begin{aligned}f(0,2) & =2(0)^{2}+(2)^{2}-4(0)-2(2) \\\\  & =4-4 \\\\  & =0 \\\\ f(2,0) & =2(2)^{2}+(0)^{2}-4(2)-2(0) \\\\  & =8-8 \\\\  & =0 \\\\ f(0,0) & =2(0)^{2}+(0)^{2}-4(0)-2(0) \\\\  & =0 \\\\ f(1,1) & =2(1)^{2}+(1)^{2}-4(1)-2(1) \\\\  & =2+1-4-2 \\\\  & =-3.\\end{aligned}\n$$\n\n \n\nTherefore, on the closed region $D,$ we have that \n\n- $f$ attains the global minimum of $-3$ at the point $(1,1),$ and\n\n- $f$ attains the global maximum of $0$ at the points $(0,0),(0,2),$ and $(2,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-585700db-4a4c-5c97-98d7-30b257ff65a1"] :db/ensure [:question/validate]} {:db/id "answer-field-585700db-4a4c-5c97-98d7-30b257ff65a1" :answer-field/id #uuid "585700db-4a4c-5c97-98d7-30b257ff65a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-42c9840a-d25c-56c5-a13d-22ba7d99829d" :answer-field/choices ["answer-fde67504-6547-54d3-949e-2a67417d8d96" "answer-42c9840a-d25c-56c5-a13d-22ba7d99829d" "answer-37223220-8ce2-5aaf-b13b-e51831642442" "answer-91ce1e4d-9d5f-507c-b1a8-339a62262fd9" "answer-4141a628-787e-59cd-9b3b-4d9ed6c8303b"] :db/ensure [:answer-field/validate]} {:db/id "answer-fde67504-6547-54d3-949e-2a67417d8d96" :answer/id #uuid "fde67504-6547-54d3-949e-2a67417d8d96" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-42c9840a-d25c-56c5-a13d-22ba7d99829d" :answer/id #uuid "42c9840a-d25c-56c5-a13d-22ba7d99829d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-37223220-8ce2-5aaf-b13b-e51831642442" :answer/id #uuid "37223220-8ce2-5aaf-b13b-e51831642442" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-91ce1e4d-9d5f-507c-b1a8-339a62262fd9" :answer/id #uuid "91ce1e4d-9d5f-507c-b1a8-339a62262fd9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-4141a628-787e-59cd-9b3b-4d9ed6c8303b" :answer/id #uuid "4141a628-787e-59cd-9b3b-4d9ed6c8303b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186354505 :question/problem "Find the global maximum of the function $f(x,y)=2{e}^{xy-x}$ on the closed triangular region  $D=\\{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 2-x\\}.$ You're given that $f$ has a critical point at $(0,1)$ and on the boundary of the triangle the points that could give rise to extreme values are the vertices and the point $(\\frac{1}{2},\\frac{3}{2}).$" :db/ensure [:question/validate]} {:db/id "activity-014bb5c2-0eb1-526d-946d-25c9eb45386c" :activity/id #uuid "014bb5c2-0eb1-526d-946d-25c9eb45386c" :activity/title "Calculating Global Extrema of Multivariable Functions" :activity/type :activity.type/review :activity/scope 17592186048450 :activity/course 17592186046660 :activity/steps ["step-13d0691c-2114-546b-9bbe-2348cd351497" "step-37a5ea02-37b7-5758-8571-8626bf94da23" "step-af6a13b7-97bf-5a56-b47d-072d6ba6485e" "step-0072a223-d977-5b15-a887-a851fc97c6d7" "step-bcac2916-b3e2-509d-93c5-20d8fd6bdd8a"] :activity/first-step "step-13d0691c-2114-546b-9bbe-2348cd351497" :db/ensure [:activity/validate]} {:db/id "step-13d0691c-2114-546b-9bbe-2348cd351497" :step/id #uuid "13d0691c-2114-546b-9bbe-2348cd351497" :step/content "question-50860c27-301d-5231-9268-fbee285d7c09" :step/next "step-37a5ea02-37b7-5758-8571-8626bf94da23" :db/ensure [:step/validate]} {:db/id "step-37a5ea02-37b7-5758-8571-8626bf94da23" :step/id #uuid "37a5ea02-37b7-5758-8571-8626bf94da23" :step/content 17592186125035 :step/next "step-af6a13b7-97bf-5a56-b47d-072d6ba6485e" :db/ensure [:step/validate]} {:db/id "step-af6a13b7-97bf-5a56-b47d-072d6ba6485e" :step/id #uuid "af6a13b7-97bf-5a56-b47d-072d6ba6485e" :step/content "question-798ecbfd-5ca4-5e85-b538-375fc7b94df7" :step/next "step-0072a223-d977-5b15-a887-a851fc97c6d7" :db/ensure [:step/validate]} {:db/id "step-0072a223-d977-5b15-a887-a851fc97c6d7" :step/id #uuid "0072a223-d977-5b15-a887-a851fc97c6d7" :step/content 17592186404350 :step/next "step-bcac2916-b3e2-509d-93c5-20d8fd6bdd8a" :db/ensure [:step/validate]} {:db/id "step-bcac2916-b3e2-509d-93c5-20d8fd6bdd8a" :step/id #uuid "bcac2916-b3e2-509d-93c5-20d8fd6bdd8a" :step/content 17592186354505 :db/ensure [:step/validate]} {:db/id 17592186157369 :knowledge-point/questions ["question-126e0a3b-1df5-561d-b629-66be47834dfa" "question-ce424fe3-1289-5449-b3af-c9a36901436b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-126e0a3b-1df5-561d-b629-66be47834dfa" :question/id #uuid "126e0a3b-1df5-561d-b629-66be47834dfa" :question/math-academy-id "q-90529" :question/problem "Given that $X$ is a continuous random variable with the following probability density function, compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}2x-4,\\, & 2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nFirst, we compute $\\text{E}[X]:$\n\n$$\n\\begin{aligned}\\text{E}[X] & ={\\int }_{2}^{3}x\\cdot (2x-4)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}(2{x}^{2}-4x)\\,\\text{d}x \\\\  & ={(\\frac{2{x}^{3}}{3}-2{x}^{2})|}_{2}^{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$\n\n \n\nThen, we compute $\\text{E}[{X}^{2}]:$\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{2}^{3}{x}^{2}\\cdot (2x-4)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}(2{x}^{3}-4{x}^{2})\\,\\text{d}x \\\\  & ={(\\frac{{x}^{4}}{2}-\\frac{4{x}^{3}}{3})|}_{2}^{3} \\\\  & =\\frac{43}{6}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{43}{6}-{(\\frac{8}{3})}^{2} \\\\  & =\\frac{1}{18}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f9a9aeae-7475-58db-b6eb-574c342ffd6f"] :db/ensure [:question/validate]} {:db/id "answer-field-f9a9aeae-7475-58db-b6eb-574c342ffd6f" :answer-field/id #uuid "f9a9aeae-7475-58db-b6eb-574c342ffd6f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-708884fe-c46f-510c-8336-9b1ff8d57dd7" :answer-field/choices ["answer-708884fe-c46f-510c-8336-9b1ff8d57dd7" "answer-f2bedab4-4484-581e-8c7f-86e59afba6ef" "answer-916cf1d3-9858-5e7a-bde5-ef0c01dfa40b" "answer-de0ca903-22de-5647-90cb-d355eba5356b" "answer-cc7730f4-2296-5da8-a7ec-104cd0811268"] :db/ensure [:answer-field/validate]} {:db/id "answer-708884fe-c46f-510c-8336-9b1ff8d57dd7" :answer/id #uuid "708884fe-c46f-510c-8336-9b1ff8d57dd7" :answer/type :answer.type/math :answer/value "\\frac{1}{18}" :db/ensure [:answer/validate]} {:db/id "answer-f2bedab4-4484-581e-8c7f-86e59afba6ef" :answer/id #uuid "f2bedab4-4484-581e-8c7f-86e59afba6ef" :answer/type :answer.type/math :answer/value "\\frac{3}{16}" :db/ensure [:answer/validate]} {:db/id "answer-916cf1d3-9858-5e7a-bde5-ef0c01dfa40b" :answer/id #uuid "916cf1d3-9858-5e7a-bde5-ef0c01dfa40b" :answer/type :answer.type/math :answer/value "\\frac{43}{6}" :db/ensure [:answer/validate]} {:db/id "answer-de0ca903-22de-5647-90cb-d355eba5356b" :answer/id #uuid "de0ca903-22de-5647-90cb-d355eba5356b" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "answer-cc7730f4-2296-5da8-a7ec-104cd0811268" :answer/id #uuid "cc7730f4-2296-5da8-a7ec-104cd0811268" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id 17592186157370 :knowledge-point/questions ["question-7ae79777-cfeb-50b2-91fa-571641f41141" "question-fe9a9f2d-c658-56d3-a233-bcc579aed36f" "question-c369ac76-b620-5984-a1bf-927bb5bda8e4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-7ae79777-cfeb-50b2-91fa-571641f41141" :question/id #uuid "7ae79777-cfeb-50b2-91fa-571641f41141" :question/math-academy-id "q-90564" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=1.9,$ compute $\\text{Var}[X].$ Round your answer to $2$ decimal places.\n\n$$\nf(x)=\\{\\begin{aligned}2{x}^{3}, & 0<x<1, \\\\ \\frac{1}{8}, & 1\\le x<5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{5}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot 2{x}^{3}\\,\\text{d}x+{\\int }_{1}^{5}{x}^{2}\\cdot \\frac{1}{8}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}2{x}^{5}\\,\\text{d}x+{\\int }_{1}^{5}\\frac{{x}^{2}}{8}\\,\\text{d}x \\\\  & ={\\frac{{x}^{6}}{3}|}_{0}^{1}+{\\frac{{x}^{3}}{24}|}_{1}^{5} \\\\  & =5.5\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =5.5-{(1.9)}^{2} \\\\  & =1.89.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ee0bda9f-4431-5acd-981b-83f88e146a0f"] :db/ensure [:question/validate]} {:db/id "answer-field-ee0bda9f-4431-5acd-981b-83f88e146a0f" :answer-field/id #uuid "ee0bda9f-4431-5acd-981b-83f88e146a0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f9e2311-3d05-5655-aec5-752bdfbf86b6" :answer-field/choices ["answer-206cf90d-4f29-55ab-9819-01d8ca172f38" "answer-3f9e2311-3d05-5655-aec5-752bdfbf86b6" "answer-cdf20927-1bb6-5558-9a95-f586e071ff7e" "answer-db3da4ad-81ab-5111-a66e-0ed1cd8ee204" "answer-7099a365-62d4-5172-aafe-41927474df4f"] :db/ensure [:answer-field/validate]} {:db/id "answer-206cf90d-4f29-55ab-9819-01d8ca172f38" :answer/id #uuid "206cf90d-4f29-55ab-9819-01d8ca172f38" :answer/type :answer.type/math :answer/value "1.74" :db/ensure [:answer/validate]} {:db/id "answer-3f9e2311-3d05-5655-aec5-752bdfbf86b6" :answer/id #uuid "3f9e2311-3d05-5655-aec5-752bdfbf86b6" :answer/type :answer.type/math :answer/value "1.89" :db/ensure [:answer/validate]} {:db/id "answer-cdf20927-1bb6-5558-9a95-f586e071ff7e" :answer/id #uuid "cdf20927-1bb6-5558-9a95-f586e071ff7e" :answer/type :answer.type/math :answer/value "2.11" :db/ensure [:answer/validate]} {:db/id "answer-db3da4ad-81ab-5111-a66e-0ed1cd8ee204" :answer/id #uuid "db3da4ad-81ab-5111-a66e-0ed1cd8ee204" :answer/type :answer.type/math :answer/value "30.25" :db/ensure [:answer/validate]} {:db/id "answer-7099a365-62d4-5172-aafe-41927474df4f" :answer/id #uuid "7099a365-62d4-5172-aafe-41927474df4f" :answer/type :answer.type/math :answer/value "5.50" :db/ensure [:answer/validate]} {:db/id "question-fe9a9f2d-c658-56d3-a233-bcc579aed36f" :question/id #uuid "fe9a9f2d-c658-56d3-a233-bcc579aed36f" :question/math-academy-id "q-107779" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=4$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{2x}{27}, & 0<x<3, \\\\ \\frac{9-x}{27}, & 3\\le x<9, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{9}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{3}^{9}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{x}^{2}\\cdot \\frac{2x}{27}\\,\\text{d}x+{\\int }_{3}^{9}{x}^{2}\\cdot \\frac{1}{27}(9-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}\\frac{2{x}^{3}}{27}\\,\\text{d}x+{\\int }_{3}^{9}\\frac{1}{27}(9{x}^{2}-{x}^{3})\\,\\text{d}x \\\\  & ={\\frac{{x}^{4}}{54}|}_{0}^{3}+{\\frac{1}{27}(3{x}^{3}-\\frac{{x}^{4}}{4})|}_{3}^{9} \\\\  & =\\frac{3}{2}+\\frac{81}{4}-\\frac{9}{4} \\\\  & =\\frac{39}{2}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{39}{2}-{4}^{2} \\\\  & =\\frac{7}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f6082ae9-a37f-5a6d-98af-d4b226bb7c29"] :db/ensure [:question/validate]} {:db/id "answer-field-f6082ae9-a37f-5a6d-98af-d4b226bb7c29" :answer-field/id #uuid "f6082ae9-a37f-5a6d-98af-d4b226bb7c29" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-325fa17b-54bd-5aa0-9e67-721dd15642fd" :answer-field/choices ["answer-2b2b313e-b6a7-568c-a875-f9db4ce39dcb" "answer-6d4e985e-cf6f-56bf-aaa1-935086b1d3e4" "answer-f1f6ae5c-8838-54ee-bde6-979554af985b" "answer-5a881950-5b53-5733-8066-0e2b41f6af6d" "answer-325fa17b-54bd-5aa0-9e67-721dd15642fd"] :db/ensure [:answer-field/validate]} {:db/id "answer-2b2b313e-b6a7-568c-a875-f9db4ce39dcb" :answer/id #uuid "2b2b313e-b6a7-568c-a875-f9db4ce39dcb" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-6d4e985e-cf6f-56bf-aaa1-935086b1d3e4" :answer/id #uuid "6d4e985e-cf6f-56bf-aaa1-935086b1d3e4" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "answer-f1f6ae5c-8838-54ee-bde6-979554af985b" :answer/id #uuid "f1f6ae5c-8838-54ee-bde6-979554af985b" :answer/type :answer.type/math :answer/value "\\frac{31}{2}" :db/ensure [:answer/validate]} {:db/id "answer-5a881950-5b53-5733-8066-0e2b41f6af6d" :answer/id #uuid "5a881950-5b53-5733-8066-0e2b41f6af6d" :answer/type :answer.type/math :answer/value "\\frac{39}{2}" :db/ensure [:answer/validate]} {:db/id "answer-325fa17b-54bd-5aa0-9e67-721dd15642fd" :answer/id #uuid "325fa17b-54bd-5aa0-9e67-721dd15642fd" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "question-ce424fe3-1289-5449-b3af-c9a36901436b" :question/id #uuid "ce424fe3-1289-5449-b3af-c9a36901436b" :question/math-academy-id "q-131166" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{3}{2},$ compute $\\text{Var}[X].$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{9}{4{x}^{3}},\\, & 1<x<3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{S}{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{2}\\cdot \\frac{9}{4{x}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{9}{4x}\\,\\text{d}x \\\\  & ={\\frac{9}{4}\\cdot \\operatorname{ln}⁡x|}_{1}^{3} \\\\  & =\\frac{9\\operatorname{ln}⁡3}{4}\\end{aligned}\n$$\n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{9\\operatorname{ln}⁡3}{4}-{(\\frac{3}{2})}^{2} \\\\  & =\\frac{9\\operatorname{ln}⁡3}{4}-\\frac{9}{4} \\\\  & =\\frac{9}{4}(\\operatorname{ln}⁡3-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b6f8a025-5440-5c77-830a-6386ff67bfed"] :db/ensure [:question/validate]} {:db/id "answer-field-b6f8a025-5440-5c77-830a-6386ff67bfed" :answer-field/id #uuid "b6f8a025-5440-5c77-830a-6386ff67bfed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-14743a6d-89dc-51f1-be5f-651e9f9685f3" :answer-field/choices ["answer-c1f044e2-04da-5e9c-8032-d7a4b80cff3a" "answer-b98a4eda-a7fb-5b36-a2ee-9c2bf3e3cb46" "answer-c3c18450-3d1d-5233-9103-20c6853cd571" "answer-14743a6d-89dc-51f1-be5f-651e9f9685f3" "answer-b67a9aef-d76c-5bab-8625-14577b91fed1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c1f044e2-04da-5e9c-8032-d7a4b80cff3a" :answer/id #uuid "c1f044e2-04da-5e9c-8032-d7a4b80cff3a" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b98a4eda-a7fb-5b36-a2ee-9c2bf3e3cb46" :answer/id #uuid "b98a4eda-a7fb-5b36-a2ee-9c2bf3e3cb46" :answer/type :answer.type/math :answer/value "\\frac{9}{2}(\\operatorname{ln}⁡3-1)" :db/ensure [:answer/validate]} {:db/id "answer-c3c18450-3d1d-5233-9103-20c6853cd571" :answer/id #uuid "c3c18450-3d1d-5233-9103-20c6853cd571" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "answer-14743a6d-89dc-51f1-be5f-651e9f9685f3" :answer/id #uuid "14743a6d-89dc-51f1-be5f-651e9f9685f3" :answer/type :answer.type/math :answer/value "\\frac{9}{4}(\\operatorname{ln}⁡3-1)" :db/ensure [:answer/validate]} {:db/id "answer-b67a9aef-d76c-5bab-8625-14577b91fed1" :answer/id #uuid "b67a9aef-d76c-5bab-8625-14577b91fed1" :answer/type :answer.type/math :answer/value "\\frac{9}{4}\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "question-c369ac76-b620-5984-a1bf-927bb5bda8e4" :question/id #uuid "c369ac76-b620-5984-a1bf-927bb5bda8e4" :question/math-academy-id "q-131261" :question/problem "The continuous random variable $X$ has the probability density function $f(x)$ stated below. Given that $\\text{E}[X]=\\frac{7}{8},$ compute $\\text{Var}[X].$ \n\n$$\nf(x)=\\{\\begin{aligned}\\frac{3}{4}, & 0<x<1 \\\\ \\frac{3(x-1)}{{x}^{5}},\\, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\n$$" :question/worked-solution "For a continuous random variable $X$ with probability density function $f(x)$ defined over a set $S,$ we can calculate the variance using the following formula:\n\n$$\n\\text{Var}[X]=\\text{E}[{X}^{2}]-\\text{E}[X]^{2}\n$$\n\n \n\nWe compute $\\text{E}[{X}^{2}],$ as follows:\n\n$$\n\\begin{aligned}\\text{E}[{X}^{2}] & ={\\int }_{0}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot f(x)\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\cdot \\frac{3}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }{x}^{2}\\cdot \\frac{3(x-1)}{{x}^{5}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{3{x}^{2}}{4}\\,\\text{d}x+{\\int }_{1}^{\\infty }\\frac{3x-3}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{{x}^{3}}{4}|}_{0}^{1}+(-\\frac{3}{x}+\\frac{3}{2{x}^{2}}){|}_{1}^{\\infty } \\\\  & =\\frac{1}{4}+3-\\frac{3}{2} \\\\  & =\\frac{7}{4}\\end{aligned}\n$$\n\n \n\nTherefore, the variance is given by\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\text{E}[{X}^{2}]-\\text{E}[X]^{2} \\\\  & =\\frac{7}{4}-{(\\frac{7}{8})}^{2} \\\\  & =\\frac{63}{64}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-cc39d208-b352-55e6-ab15-3fec98ea96ed"] :db/ensure [:question/validate]} {:db/id "answer-field-cc39d208-b352-55e6-ab15-3fec98ea96ed" :answer-field/id #uuid "cc39d208-b352-55e6-ab15-3fec98ea96ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-59e03d02-257a-5ba6-b196-538b39c66509" :answer-field/choices ["answer-2c298589-687a-53b7-a2f6-711c8b3fc022" "answer-3ed8eee1-36f5-552c-b95f-65eb970a734a" "answer-59e03d02-257a-5ba6-b196-538b39c66509" "answer-c5398c5f-3701-531a-9962-9d86c1e50901" "answer-b279e53b-ef58-5c32-bfc7-abaacf3a829d"] :db/ensure [:answer-field/validate]} {:db/id "answer-2c298589-687a-53b7-a2f6-711c8b3fc022" :answer/id #uuid "2c298589-687a-53b7-a2f6-711c8b3fc022" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-3ed8eee1-36f5-552c-b95f-65eb970a734a" :answer/id #uuid "3ed8eee1-36f5-552c-b95f-65eb970a734a" :answer/type :answer.type/math :answer/value "\\frac{49}{64}" :db/ensure [:answer/validate]} {:db/id "answer-59e03d02-257a-5ba6-b196-538b39c66509" :answer/id #uuid "59e03d02-257a-5ba6-b196-538b39c66509" :answer/type :answer.type/math :answer/value "\\frac{63}{64}" :db/ensure [:answer/validate]} {:db/id "answer-c5398c5f-3701-531a-9962-9d86c1e50901" :answer/id #uuid "c5398c5f-3701-531a-9962-9d86c1e50901" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "answer-b279e53b-ef58-5c32-bfc7-abaacf3a829d" :answer/id #uuid "b279e53b-ef58-5c32-bfc7-abaacf3a829d" :answer/type :answer.type/math :answer/value "\\frac{7}{8}" :db/ensure [:answer/validate]} {:db/id "activity-f43dd96a-540d-5f5a-b773-e86347bdd398" :activity/id #uuid "f43dd96a-540d-5f5a-b773-e86347bdd398" :activity/title "Variance of Continuous Random Variables" :activity/type :activity.type/re