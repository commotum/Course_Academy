17592186069427 :question/problem "Simplify $\\sqrt[3]{(2x-1)^{3}}.$" :question/worked-solution "The expression underneath the radical is already a perfect cube. Therefore,\n\n$$\n\\begin{aligned}\\sqrt[3]{(2x-1)^{3}} & =2x-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186067732 :answer-field/correct "answer-ac59d799-1931-5583-b314-c1e42bfc4207" :answer-field/choices ["answer-ff6818cf-aa7b-50bd-86d3-1181c9be6ac1" "answer-ac59d799-1931-5583-b314-c1e42bfc4207" "answer-c10ce8b0-b0db-5a4b-874d-d57ce77e877a"] :db/ensure [:answer-field/validate]} {:db/id "answer-ff6818cf-aa7b-50bd-86d3-1181c9be6ac1" :answer/id #uuid "ff6818cf-aa7b-50bd-86d3-1181c9be6ac1" :answer/type :answer.type/math :answer/value "2\\sqrt[3]{x}-1" :db/ensure [:answer/validate]} {:db/id "answer-ac59d799-1931-5583-b314-c1e42bfc4207" :answer/id #uuid "ac59d799-1931-5583-b314-c1e42bfc4207" :answer/type :answer.type/math :answer/value "2x-1" :db/ensure [:answer/validate]} {:db/id "answer-c10ce8b0-b0db-5a4b-874d-d57ce77e877a" :answer/id #uuid "c10ce8b0-b0db-5a4b-874d-d57ce77e877a" :answer/type :answer.type/math :answer/value "\\sqrt[3]{8x-1}" :db/ensure [:answer/validate]} {:db/id "question-fe75fff3-f9bd-5fd1-9943-ab7910546025" :question/id #uuid "fe75fff3-f9bd-5fd1-9943-ab7910546025" :question/math-academy-id "q-82158" :question/problem "Find $\\sqrt[3]{\\frac{{x}^{6}}{{p}^{6}}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{{x}^{6}}{{p}^{6}}} & = \\\\ \\sqrt[3]{(\\frac{{x}^{2}}{{p}^{2}})\\cdot (\\frac{{x}^{2}}{{p}^{2}})\\cdot (\\frac{{x}^{2}}{{p}^{2}})} & = \\\\ \\sqrt[3]{{(\\frac{{x}^{2}}{{p}^{2}})}^{3}} & = \\\\ \\frac{{x}^{2}}{{p}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-161e2489-910a-5447-9f86-73a13b031f89"] :db/ensure [:question/validate]} {:db/id "a