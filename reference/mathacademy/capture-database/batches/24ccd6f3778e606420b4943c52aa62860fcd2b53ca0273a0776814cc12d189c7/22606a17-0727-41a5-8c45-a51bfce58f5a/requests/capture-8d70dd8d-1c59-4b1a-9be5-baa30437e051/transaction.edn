/type :answer-field.type/radio :answer-field/correct "answer-f9254e00-45df-5550-b67a-ecaad9b1766d" :answer-field/choices ["answer-f9254e00-45df-5550-b67a-ecaad9b1766d" "answer-e447840d-1bbf-5c67-ad1d-7e18ce1e41dd" "answer-94c93ff0-ae60-5fef-80c9-61ef3f52219a" "answer-3bcf5ba1-fa87-5d5d-920d-971b653cb481" "answer-3e160e88-39cd-5c66-8992-88944f10f0ae"] :db/ensure [:answer-field/validate]} {:db/id "answer-f9254e00-45df-5550-b67a-ecaad9b1766d" :answer/id #uuid "f9254e00-45df-5550-b67a-ecaad9b1766d" :answer/type :answer.type/math :answer/value "(-\\infty ,-\\sqrt{2})\\cup (\\sqrt{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-e447840d-1bbf-5c67-ad1d-7e18ce1e41dd" :answer/id #uuid "e447840d-1bbf-5c67-ad1d-7e18ce1e41dd" :answer/type :answer.type/math :answer/value "(-\\infty ,-\\sqrt{2})\\cup [\\sqrt{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-94c93ff0-ae60-5fef-80c9-61ef3f52219a" :answer/id #uuid "94c93ff0-ae60-5fef-80c9-61ef3f52219a" :answer/type :answer.type/math :answer/value "(-\\infty ,\\infty ]\\cup (\\sqrt{3},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "answer-3bcf5ba1-fa87-5d5d-920d-971b653cb481" :answer/id #uuid "3bcf5ba1-fa87-5d5d-920d-971b653cb481" :answer/type :answer.type/math :answer/value "(-\\infty ,\\sqrt{2}]\\cup (\\sqrt{3},\\infty )" :db/ensure [:answer/validate]} {:db/id "answer-3e160e88-39cd-5c66-8992-88944f10f0ae" :answer/id #uuid "3e160e88-39cd-5c66-8992-88944f10f0ae" :answer/type :answer.type/math :answer/value "(-\\infty ,\\sqrt{3})\\cup (\\sqrt{2},\\infty )" :db/ensure [:answer/validate]} {:db/id "question-23a12ef5-c982-5f9f-a9b3-040c1ca03ec3" :question/id #uuid "23a12ef5-c982-5f9f-a9b3-040c1ca03ec3" :question/math-academy-id "q-102117" :question/problem "Express $(-\\infty ,-\\sqrt{2}]\\cup (-1,\\infty )$ as an inequality." :question/worked-solution "First, we graph the two intervals on a number line:\n\n![](images/65/65f772a179911c50e8159f2c24a2bfcc4a73ea00312ac84ced35627c635bc943.png)\n\nThe interval $(-\\infty ,-\\sqrt{2}]$ can be expressed as the inequality $x\\le -\\sqrt{2}.$\n\nLikewise, the interval $(-1,\\infty )$ can be expressed as the inequality $x>-1.$\n\nSo, the union of these intervals represents the compound inequality\n\n$$\nx\\le -\\sqrt{2}\\text{ or }x>-1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-35dd5252-ecb4-5ab7-9fee-887856b84d4f"] :db/ensure [:question/validate]} {:db/id "answer-field-35dd5252-ecb4-5ab7-9fee-887856b84d4f" :answer-field/id #uuid "35dd5252-ecb4-5ab7-9fee-887856b84d4f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2b52c9ee-bfd5-5b5f-ab04-aa9353b48bdc" :answer-field/choices ["answer-45a7ca98-fb26-51e1-9c49-a9036f1c4db3" "answer-7b5525d2-9f39-5e3c-bbcc-23f7c21ab500" "answer-7f940c01-971d-5e05-8515-5368e57d4c55" "answer-8eb6b56c-e9a5-5054-ba80-92bf42db3739" "answer-2b52c9ee-bfd5-5b5f-ab04-aa9353b48bdc"] :db/ensure [:answer-field/validate]} {:db/id "answer-45a7ca98-fb26-51e1-9c49-a9036f1c4db3" :answer/id #uuid "45a7ca98-fb26-51e1-9c49-a9036f1c4db3" :answer/type :answer.type/math :answer/value "-\\sqrt{2}<x\\le -1" :db/ensure [:answer/validate]} {:db/id "answer-7b5525d2-9f39-5e3c-bbcc-23f7c21ab500" :answer/id #uuid "7b5525d2-9f39-5e3c-bbcc-23f7c21ab500" :answer/type :answer.type/math :answer/value "-\\sqrt{2}\\le x<-1" :db/ensure [:answer/validate]} {:db/id "answer-7f940c01-971d-5e05-8515-5368e57d4c55" :answer/id #uuid "7f940c01-971d-5e05-8515-5368e57d4c55" :answer/type :answer.type/text :answer/value "$-\\sqrt{2}<x$ or $x>-1$" :db/ensure [:answer/validate]} {:db/id "answer-8eb6b56c-e9a5-5054-ba80-92bf42db3739" :answer/id #uuid "8eb6b56c-e9a5-5054-ba80-92bf42db3739" :answer/type :answer.type/text :answer/value "$x\\le -\\sqrt{2}$ or $-1>x$" :db/ensure [:answer/validate]} {:db/id "answer-2b52c9ee-bfd5-5b5f-ab04-aa9353b48bdc" :answer/id #uuid "2b52c9ee-bfd5-5b5f-ab04-aa9353b48bdc" :answer/type :answer.type/text :answer/value "$x\\le -\\sqrt{2}$ or $x>-1$" :db/ensure [:answer/validate]} {:db/id "question-c44a64a8-cdbe-51ac-84cd-5e8ba651f598" :question/id #uuid "c44a64a8-cdbe-51ac-84cd-5e8ba651f598" :question/math-academy-id "q-102131" :question/problem "Express $(-\\infty ,3]\\cup [6,\\infty )$ as an inequality." :question/worked-solution "First, we graph the two intervals on a number line:\n\n![](images/ec/ec4128763f85e601def705f1133bcff5cd7956cdcc10bfe438bd094a127c928a.png)\n\nThe interval $(-\\infty ,3]$ can be expressed as the inequality $x\\le 3.$\n\nLikewise, the interval $[6,\\infty )$ can be expressed as the inequality $x\\ge 6.$\n\nSo, the union of these intervals represents the compound inequality\n\n$$\nx\\le 3\\text{ or }x\\ge 6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-18f6c658-ad82-584e-82da-5182b08333d2"] :db/ensure [:question/validate]} {:db/id "answer-field-18f6c658-ad82-584e-82da-5182b08333d2" :answer-field/id #uuid "18f6c658-ad82-584e-82da-5182b08333d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8901d5b8-a296-5fa5-b047-8807d0b5213d" :answer-field/choices ["answer-21d3cac3-664e-5eec-a4a9-f1348f8d813a" "answer-122e9de8-8fd7-5239-b4e9-4f05dd907ac6" "answer-c5bb820a-dece-5f31-b89f-bb561b74daa5" "answer-150f838c-391a-5a27-8ded-eab8714b53ea" "answer-8901d5b8-a296-5fa5-b047-8807d0b5213d"] :db/ensure [:answer-field/validate]} {:db/id "answer-21d3cac3-664e-5eec-a4a9-f1348f8d813a" :answer/id #uuid "21d3cac3-664e-5eec-a4a9-f1348f8d813a" :answer/type :answer.type/math :answer/value "3<x<6" :db/ensure [:answer/validate]} {:db/id "answer-122e9de8-8fd7-5239-b4e9-4f05dd907ac6" :answer/id #uuid "122e9de8-8fd7-5239-b4e9-4f05dd907ac6" :answer/type :answer.type/math :answer/value "3\\le x\\le 6" :db/ensure [:answer/validate]} {:db/id "answer-c5bb820a-dece-5f31-b89f-bb561b74daa5" :answer/id #uuid "c5bb820a-dece-5f31-b89f-bb561b74daa5" :answer/type :answer.type/text :answer/value "$3\\le x$ or $6\\ge x$" :db/ensure [:answer/validate]} {:db/id "answer-150f838c-391a-5a27-8ded-eab8714b53ea" :answer/id #uuid "150f838c-391a-5a27-8ded-eab8714b53ea" :answer/type :answer.type/text :answer/value "$x<3$ or $x>6$" :db/ensure [:answer/validate]} {:db/id "answer-8901d5b8-a296-5fa5-b047-8807d0b5213d" :answer/id #uuid "8901d5b8-a296-5fa5-b047-8807d0b5213d" :answer/type :answer.type/text :answer/value "$x\\le 3$ or $x\\ge 6$" :db/ensure [:answer/validate]} {:db/id "question-bba53e4b-e098-5ce6-8b7e-0505b01c7d59" :question/id #uuid "bba53e4b-e098-5ce6-8b7e-0505b01c7d59" :question/math-academy-id "q-102136" :question/problem "![](images/c5/c5ec4a4b688ccd2af9cd50c6c23d919d8723969ba99dde91331fa4d74b52bc02.png)\n\nWhat is the union of the intervals shown on the number lines above?" :question/worked-solution "We have the following number lines:\n\n![](images/c5/c5ec4a4b688ccd2af9cd50c6c23d919d8723969ba99dde91331fa4d74b52bc02.png)\n\nThe union of the two intervals consists of all the points which are contained within at least one of the intervals. So, to graph the union of the two intervals, we take the graphs of the individual intervals and lay them on top of each other.\n\nThe resulting graph is as follows:\n\n![](images/71/717555d8e5ffa151e0925185f7b6bb5496a2f18210ae8bbe94f979f5a89bbbef.png)\n\nThe graph represents the interval $(-3,6].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a03fe2de-51d3-55fe-8847-f4c7c97da614"] :db/ensure [:question/validate]} {:db/id "answer-field-a03fe2de-51d3-55fe-8847-f4c7c97da614" :answer-field/id #uuid "a03fe2de-51d3-55fe-8847-f4c7c97da614" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3e9c9050-d909-5ae5-bd9e-34465964c574" :answer-field/choices ["answer-e3d5943c-d474-53f8-ac9b-add6c9d34d38" "answer-77a5ded1-62f5-5782-8d4b-ec2b9d716610" "answer-3e9c9050-d909-5ae5-bd9e-34465964c574" "answer-5c7a56ce-0b87-5ed7-92fb-c1a82c75308a" "answer-46c6