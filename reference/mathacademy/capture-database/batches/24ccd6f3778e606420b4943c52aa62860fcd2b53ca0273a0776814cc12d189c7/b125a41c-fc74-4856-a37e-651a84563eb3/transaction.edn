e189-5dcd-8b33-971f6adcaf13" :step/next "step-90dc62fe-8bb8-5997-9faa-e8e4bf923cfc" :db/ensure [:step/validate]} {:db/id "step-90dc62fe-8bb8-5997-9faa-e8e4bf923cfc" :step/id #uuid "90dc62fe-8bb8-5997-9faa-e8e4bf923cfc" :step/content "question-33438ac4-91a4-539b-acda-ce62d65ce1c2" :step/next "step-9549a907-8026-59cc-92ea-59c1ebc3209a" :db/ensure [:step/validate]} {:db/id "step-9549a907-8026-59cc-92ea-59c1ebc3209a" :step/id #uuid "9549a907-8026-59cc-92ea-59c1ebc3209a" :step/content "question-1ced6944-9e50-5164-8d33-69e2545adde3" :db/ensure [:step/validate]} {:db/id 17592186064295 :knowledge-point/questions ["question-a2700145-f14c-508c-9486-f4eea106d539"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a2700145-f14c-508c-9486-f4eea106d539" :question/id #uuid "a2700145-f14c-508c-9486-f4eea106d539" :question/math-academy-id "q-96016" :question/problem "$\\int (4-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{tanh}⁡\\theta )={sech}^{2}⁡\\theta \\,⇒\\,\\int {sech}^{2}⁡\\theta \\,\\text{d}\\theta =\\operatorname{tanh}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (4-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta  & =\\int 4\\,\\text{d}\\theta +\\int (-3{sech}^{2}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4\\int \\,\\text{d}\\theta -3\\int {sech}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =4\\theta -3\\operatorname{tanh}⁡\\theta +C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-4e18955b-050b-5a8f-9af9-f9eafd8a4e09"] :db/ensure [:question/validate]} {:db/id "answer-field-4e18955b-050b-5a8f-9af9-f9eafd8a4e09" :answer-field/id #uuid "4e18955b-050b-5a8f-9af9-f9eafd8a4e09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-de1f39e7-a858-5e32-867a-fa83afb3cc0c" :answer-field/choices ["answer-cd3bf55a-7e91-578c-ac7e-93c48a3a031c" "answer-f7abe1a8-28a1-5586-879d-579b4850ac51" "answer-415f038f-67ba-5731-a5d9-4c493aae49d7" "answer-611583f3-73a3-5910-9337-e629d7e0cca7" "answer-de1f39e7-a858-5e32-867a-fa83afb3cc0c"] :db/ensure [:answer-field/validate]} {:db/id "answer-cd3bf55a-7e91-578c-ac7e-93c48a3a031c" :answer/id #uuid "cd3bf55a-7e91-578c-ac7e-93c48a3a031c" :answer/type :answer.type/math :answer/value "4+3\\operatorname{coth}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-f7abe1a8-28a1-5586-879d-579b4850ac51" :answer/id #uuid "f7abe1a8-28a1-5586-879d-579b4850ac51" :answer/type :answer.type/math :answer/value "4-3\\operatorname{tanh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-415f038f-67ba-5731-a5d9-4c493aae49d7" :answer/id #uuid "415f038f-67ba-5731-a5d9-4c493aae49d7" :answer/type :answer.type/math :answer/value "4\\theta +3\\operatorname{tanh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-611583f3-73a3-5910-9337-e629d7e0cca7" :answer/id #uuid "611583f3-73a3-5910-9337-e629d7e0cca7" :answer/type :answer.type/math :answer/value "4\\theta -3\\operatorname{coth}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "answer-de1f39e7-a858-5e32-867a-fa83afb3cc0c" :answer/id #uuid "de1f39e7-a858-5e32-867a-fa83afb3cc0c" :answer/type :answer.type/math :answer/value "4\\theta -3\\operatorname{tanh}⁡\\theta +C" :db/ensure [:answer/validate]} {:db/id "activity-7e8bd6ba-d79f-543e-8fa1-667b1c64ec38" :activity/id #uuid "7e8bd6ba-d79f-543e-8fa1-667b1c64ec38" :activity/title "Integrating Hyperbolic Functions" :activity/type :activity.type/review :activity/scope 17592186049599 :activity/course 17592186046645 :activity/steps ["step-521b2668-06f0-5a0c-b6fd-78857ff1ecd8" "step-0e7302eb-f9b0-5746-9b38-56ab44f97bec" "step-df6d28aa-40d2-5b95-a711-dba37989fc3f" "step-b3337935-86ec-55dd-bf71-539e84f21a0e" "step-fd35000b-7e0c-574d-a60e-f261c0e0cc6c"] :activity/first-step "step-521b2668-06f0-5a0c-b6fd-78857ff1ecd8" :db/ensure [:activity/validate]} {:db/id "step-521b2668-06f0-5a0c-b6fd-78857ff1ecd8" :step/id #uuid "521b2668-06f0-5a0c-b6fd-78857ff1ecd8" :step/content 17592186360654 :step/next "step-0e7302eb-f9b0-5746-9b38-56ab44f97bec" :db/ensure [:step/validate]} {:db/id "step-0e7302eb-f9b0-5746-9b38-56ab44f97bec" :step/id #uuid "0e7302eb-f9b0-5746-9b38-56ab44f97bec" :step/content 17592186360657 :step/next "step-df6d28aa-40d2-5b95-a711-dba37989fc3f" :db/ensure [:step/validate]} {:db/id "step-df6d28aa-40d2-5b95-a711-dba37989fc3f" :step/id #uuid "df6d28aa-40d2-5b95-a711-dba37989fc3f" :step/content 17592186360660 :step/next "step-b3337935-86ec-55dd-bf71-539e84f21a0e" :db/ensure [:step/validate]} {:db/id "step-b3337935-86ec-55dd-bf71-539e84f21a0e" :step/id #uuid "b3337935-86ec-55dd-bf71-539e84f21a0e" :step/content "question-a2700145-f14c-508c-9486-f4eea106d539" :step/next "step-fd35000b-7e0c-574d-a60e-f261c0e0cc6c" :db/ensure [:step/validate]} {:db/id "step-fd35000b-7e0c-574d-a60e-f261c0e0cc6c" :step/id #uuid "fd35000b-7e0c-574d-a60e-f261c0e0cc6c" :step/content 17592186360670 :db/ensure [:step/validate]} {:db/id 17592186083186 :knowledge-point/questions ["question-b00cf238-5726-569e-8376-bed95c1380a1" "question-164d94c5-b0eb-592e-af54-44af80279820"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082942 :question/problem "Find the axis of symmetry for the parabola $y=2x^2-12x+3.$" :question/worked-solution "The equation of the axis of symmetry of the parabola $y=ax^2+bx+c$ is given by\n\n$$\nx = -\\dfrac{b}{2a}.\n$$\n\nWe substitute $a=2$ and $b=-12$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{(-12)}{2(2)} \\\\  & =-\\frac{(-12)}{4} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$" :db/ensure [:question/validate]} {:db/id 17592186083187 :knowledge-point/questions ["question-b9ff66d7-f50d-5b18-a934-a31f261f86c6" "question-64f1282c-c0b1-511f-b876-dbf03d7ec8a1" "question-c18c5b5e-e1be-5b37-80b1-242d38a7007c" "question-c719977b-e48f-55fa-971c-b6c55e94e98c"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082943 :question/problem "Find the coordinates of the vertex of the parabola $y=-x^2+4x+1.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=ax^2+bx+c$ is given by\n\n$$\nx = -\\dfrac{b}{2a}.\n$$\n\nSubstituting $a=-1$ and $b=4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{4}{2(-1)} \\\\  & =-\\frac{4}{(-2)} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=2.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we can substitute $x=2$ into the original equation:\n\n$$\n\\begin{aligned}y & =-{x}^{2}+4x+1 \\\\  & =-(2)^{2}+4(2)+1 \\\\  & =-4+8+1 \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the vertex is at $(2,5).$" :db/ensure [:question/validate]} {:db/id 17592186083188 :knowledge-point/questions ["question-c9db5029-028a-58a7-87ff-11b09d5541ba" "question-f5ac6aea-bcfe-5a0e-83c5-58a351f6e0ff"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186082944 :question/problem "The axis of symmetry of the parabola $y=0.25x^2+kx+2$ is $x=-6.$ Find the value of $k.$" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, we will set our result equal to $-6.$\n\nThe equation of the axis of symmetry of the parabola $y=ax^2+bx+c$ is given by\n\n$$\nx = -\\dfrac{b}{2a}.\n$$\n\nSubstituting $a=0.25$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(0.25)} \\\\  & =-\\frac{k}{0.5} \\\\  & =-2k.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-6,$ so we must have\n\n$$\n\\begin{aligned}-2k & =-6 \\\\ k & =3.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-b00cf238-5726-569e-8376-bed95c1380a1" :question/id #uuid "b00cf238-5726-569e-8376-bed95c1380a1" :question/math-academy-id "q-222079" :question/problem "The axis of symmetry of the parabola $y=-2{x}^{2}+10x-3$ is $x=${{field-1}}." :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=-2$ and $b=10$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{10}{2(-2)} \\\\  & =-\\frac{10}{(-4)} \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=\\frac{5}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-70a59569-7026-55cb-8f99-3bedbd6a3b2d"] :db/ensure [:question/validate]} {:db/id "answer-field-70a59569-7026-55cb-8f99-3bedbd6a3b2d" :answer-field/id #uuid "70a59569-7026-55cb-8f99-3bedbd6a3b2d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-171eba40-f441-599d-bfb0-408b5950a3c8" :answer-field/choices ["answer-171eba40-f441-599d-bfb0-408b5950a3c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-171eba40-f441-599d-bfb0-408b5950a3c8" :answer/id #uuid "171eba40-f441-599d-bfb0-408b5950a3c8" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "question-164d94c5-b0eb-592e-af54-44af80279820" :question/id #uuid "164d94c5-b0eb-592e-af54-44af80279820" :question/math-academy-id "q-222074" :question/problem "The axis of symmetry of the parabola $y={x}^{2}-8x-7$ is $x=${{field-1}}." :question/worked-solution "The equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nWe substitute $a=1$ and $b=-8$ into the formula for the axis of symmetry. This gives\n\n$$\n\\begin{aligned}x & =-\\frac{(-8)}{2(1)} \\\\  & =-\\frac{(-8)}{2} \\\\  & =\\frac{8}{2} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3633c760-2174-50b8-bdd9-56400936e54b"] :db/ensure [:question/validate]} {:db/id "answer-field-3633c760-2174-50b8-bdd9-56400936e54b" :answer-field/id #uuid "3633c760-2174-50b8-bdd9-56400936e54b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-84c34ca5-1193-5686-9946-301a71135df1" :answer-field/choices ["answer-84c34ca5-1193-5686-9946-301a71135df1"] :db/ensure [:answer-field/validate]} {:db/id "answer-84c34ca5-1193-5686-9946-301a71135df1" :answer/id #uuid "84c34ca5-1193-5686-9946-301a71135df1" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "question-b9ff66d7-f50d-5b18-a934-a31f261f86c6" :question/id #uuid "b9ff66d7-f50d-5b18-a934-a31f261f86c6" :question/math-academy-id "q-13389" :question/problem "Find the coordinates of the vertex of the parabola $y=3{x}^{2}-18x-3.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=3$ and $b=-18$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-18)}{2(3)} \\\\  & =-\\frac{(-18)}{6} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=3$ into the original equation:\n\n$$\n\\begin{aligned}y & =3{x}^{2}-18x-3 \\\\  & =3(3)^{2}-18(3)-3 \\\\  & =27-54-3 \\\\  & =-30\\end{aligned}\n$$\n\nTherefore, the vertex is at $(3,-30).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-41d9ae00-47e6-57e8-8473-e9431d4d0516"] :db/ensure [:question/validate]} {:db/id "answer-field-41d9ae00-47e6-57e8-8473-e9431d4d0516" :answer-field/id #uuid "41d9ae00-47e6-57e8-8473-e9431d4d0516" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1951579c-74ad-5682-bd29-7d5888b66e20" :answer-field/choices ["answer-de781b50-9499-5708-8264-daa411e4e82e" "answer-dc43f21f-b04f-539b-86eb-402cf598434b" "answer-d615d02b-754c-5f48-b1d2-37faddbce666" "answer-30ae8e86-f20b-5c44-ae52-552bcfa4a6a5" "answer-1951579c-74ad-5682-bd29-7d5888b66e20"] :db/ensure [:answer-field/validate]} {:db/id "answer-de781b50-9499-5708-8264-daa411e4e82e" :answer/id #uuid "de781b50-9499-5708-8264-daa411e4e82e" :answer/type :answer.type/math :answer/value "(-2,-18)" :db/ensure [:answer/validate]} {:db/id "answer-dc43f21f-b04f-539b-86eb-402cf598434b" :answer/id #uuid "dc43f21f-b04f-539b-86eb-402cf598434b" :answer/type :answer.type/math :answer/value "(-3,-30)" :db/ensure [:answer/validate]} {:db/id "answer-d615d02b-754c-5f48-b1d2-37faddbce666" :answer/id #uuid "d615d02b-754c-5f48-b1d2-37faddbce666" :answer/type :answer.type/math :answer/value "(2,-27)" :db/ensure [:answer/validate]} {:db/id "answer-30ae8e86-f20b-5c44-ae52-552bcfa4a6a5" :answer/id #uuid "30ae8e86-f20b-5c44-ae52-552bcfa4a6a5" :answer/type :answer.type/math :answer/value "(3,-10)" :db/ensure [:answer/validate]} {:db/id "answer-1951579c-74ad-5682-bd29-7d5888b66e20" :answer/id #uuid "1951579c-74ad-5682-bd29-7d5888b66e20" :answer/type :answer.type/math :answer/value "(3,-30)" :db/ensure [:answer/validate]} {:db/id "question-64f1282c-c0b1-511f-b876-dbf03d7ec8a1" :question/id #uuid "64f1282c-c0b1-511f-b876-dbf03d7ec8a1" :question/math-academy-id "q-106547" :question/problem "Find the coordinates of the vertex of the parabola $y=-2{x}^{2}+4x-9.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-2$ and $b=4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{4}{2(-2)} \\\\  & =-\\frac{4}{(-4)} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=1.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=1$ into the original equation:\n\n$$\n\\begin{aligned}y & =-2{x}^{2}+4x-9 \\\\  & =-2(1)^{2}+4(1)-9 \\\\  & =-2+4-9 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, the vertex is at $(1,-7).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c3648120-1524-5326-85d6-e4bd425ce95d"] :db/ensure [:question/validate]} {:db/id "answer-field-c3648120-1524-5326-85d6-e4bd425ce95d" :answer-field/id #uuid "c3648120-1524-5326-85d6-e4bd425ce95d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e9a12e81-19fe-549e-a419-db464988acaf" :answer-field/choices ["answer-e86b4320-c0ce-59b6-a90a-957b0210ee57" "answer-53cd59ae-04c7-5574-a3ab-30299e2c54af" "answer-61c5e162-a762-5971-bc1c-bc6dd8102883" "answer-e9a12e81-19fe-549e-a419-db464988acaf" "answer-871c2782-2277-5679-9de8-90e4bc8ef476"] :db/ensure [:answer-field/validate]} {:db/id "answer-e86b4320-c0ce-59b6-a90a-957b0210ee57" :answer/id #uuid "e86b4320-c0ce-59b6-a90a-957b0210ee57" :answer/type :answer.type/math :answer/value "(-1,-15)" :db/ensure [:answer/validate]} {:db/id "answer-53cd59ae-04c7-5574-a3ab-30299e2c54af" :answer/id #uuid "53cd59ae-04c7-5574-a3ab-30299e2c54af" :answer/type :answer.type/math :answer/value "(-1,7)" :db/ensure [:answer/validate]} {:db/id "answer-61c5e162-a762-5971-bc1c-bc6dd8102883" :answer/id #uuid "61c5e162-a762-5971-bc1c-bc6dd8102883" :answer/type :answer.type/math :answer/value "(1,-15)" :db/ensure [:answer/validate]} {:db/id "answer-e9a12e81-19fe-549e-a419-db464988acaf" :answer/id #uuid "e9a12e81-19fe-549e-a419-db464988acaf" :answer/type :answer.type/math :answer/value "(1,-7)" :db/ensure [:answer/validate]} {:db/id "answer-871c2782-2277-5679-9de8-90e4bc8ef476" :answer/id #uuid "871c2782-2277-5679-9de8-90e4bc8ef476" :answer/type :answer.type/math :answer/value "(2,-9)" :db/ensure [:answer/validate]} {:db/id "question-c18c5b5e-e1be-5b37-80b1-242d38a7007c" :question/id #uuid "c18c5b5e-e1be-5b37-80b1-242d38a7007c" :question/math-academy-id "q-106548" :question/problem "Find the coordinates of the vertex of the parabola $y=-4{x}^{2}-24x-10.$" :question/worked-solution "The vertex of the parabola lies on the axis of symmetry, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-4$ and $b=-24$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-24)}{2(-4)} \\\\  & =-\\frac{(-24)}{(-8)} \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-3.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-3$ into the original equation:\n\n$$\n\\begin{aligned}y & =-4{x}^{2}-24x-10 \\\\  & =-4(-3)^{2}-24(-3)-10 \\\\  & =-36+72-10 \\\\  & =26\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-3,26).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9031e136-f3f0-5899-8f2b-3f34c3da7fea"] :db/ensure [:question/validate]} {:db/id "answer-field-9031e136-f3f0-5899-8f2b-3f34c3da7fea" :answer-field/id #uuid "9031e136-f3f0-5899-8f2b-3f34c3da7fea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd0f143d-af04-5bca-8cf5-7e1465de78d9" :answer-field/choices ["answer-388620da-b528-5628-804b-351a30e184bd" "answer-dd0f143d-af04-5bca-8cf5-7e1465de78d9" "answer-9cddc5f1-bf50-5346-a250-f95ea0170398" "answer-7727e947-2e9c-5fb6-9177-9b23822a088a" "answer-1546d0b3-484a-554f-a971-19b0784fdf0f"] :db/ensure [:answer-field/validate]} {:db/id "answer-388620da-b528-5628-804b-351a30e184bd" :answer/id #uuid "388620da-b528-5628-804b-351a30e184bd" :answer/type :answer.type/math :answer/value "(-3,-118)" :db/ensure [:answer/validate]} {:db/id "answer-dd0f143d-af04-5bca-8cf5-7e1465de78d9" :answer/id #uuid "dd0f143d-af04-5bca-8cf5-7e1465de78d9" :answer/type :answer.type/math :answer/value "(-3,26)" :db/ensure [:answer/validate]} {:db/id "answer-9cddc5f1-bf50-5346-a250-f95ea0170398" :answer/id #uuid "9cddc5f1-bf50-5346-a250-f95ea0170398" :answer/type :answer.type/math :answer/value "(-6,-10)" :db/ensure [:answer/validate]} {:db/id "answer-7727e947-2e9c-5fb6-9177-9b23822a088a" :answer/id #uuid "7727e947-2e9c-5fb6-9177-9b23822a088a" :answer/type :answer.type/math :answer/value "(3,-118)" :db/ensure [:answer/validate]} {:db/id "answer-1546d0b3-484a-554f-a971-19b0784fdf0f" :answer/id #uuid "1546d0b3-484a-554f-a971-19b0784fdf0f" :answer/type :answer.type/math :answer/value "(3,26)" :db/ensure [:answer/validate]} {:db/id "question-c719977b-e48f-55fa-971c-b6c55e94e98c" :question/id #uuid "c719977b-e48f-55fa-971c-b6c55e94e98c" :question/math-academy-id "q-222087" :question/problem "What are the coordinates of the vertex of the parabola $y=-{x}^{2}-4x-3?$\n\nThe coordinates of the vertex are\n$($\n{{field-1}}\n,\n{{field-2}}\n$).$" :question/worked-solution "The parabola's vertex lies on the symmetry axis, so we will start by computing the axis of symmetry. \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=-1$ and $b=-4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-4)}{2(-1)} \\\\  & =-\\frac{(-4)}{(-2)} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the equation of the axis of symmetry is $x=-2.$ This also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we substitute $x=-2$ into the original equation:\n\n$$\n\\begin{aligned}y & =-{x}^{2}-4x-3 \\\\  & =-(-2)^{2}-4(-2)-3 \\\\  & =-4+8-3 \\\\  & =1\\end{aligned}\n$$\n\nTherefore, the vertex is at $(-2,1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-be93903f-e4cc-5bd7-9297-2a50a9391424" "answer-field-fcadd5db-59bd-5ad3-a766-6068d5a71afa"] :db/ensure [:question/validate]} {:db/id "answer-field-be93903f-e4cc-5bd7-9297-2a50a9391424" :answer-field/id #uuid "be93903f-e4cc-5bd7-9297-2a50a9391424" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-ad571141-274c-59a7-bbbe-0e846249ef6a" :answer-field/choices ["answer-ad571141-274c-59a7-bbbe-0e846249ef6a"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad571141-274c-59a7-bbbe-0e846249ef6a" :answer/id #uuid "ad571141-274c-59a7-bbbe-0e846249ef6a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-field-fcadd5db-59bd-5ad3-a766-6068d5a71afa" :answer-field/id #uuid "fcadd5db-59bd-5ad3-a766-6068d5a71afa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-99970142-3bb8-586f-87ca-17470f444e16" :answer-field/choices ["answer-99970142-3bb8-586f-87ca-17470f444e16"] :db/ensure [:answer-field/validate]} {:db/id "answer-99970142-3bb8-586f-87ca-17470f444e16" :answer/id #uuid "99970142-3bb8-586f-87ca-17470f444e16" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "question-c9db5029-028a-58a7-87ff-11b09d5541ba" :question/id #uuid "c9db5029-028a-58a7-87ff-11b09d5541ba" :question/math-academy-id "q-106551" :question/problem "![](images/83/830944c0cff8aa0b2f1c58c9cd2ab7ae0f2560a9aa0e244796c0814ec99fd0c3.png)\n\nFind the value of $k$ for the parabola $y=k{x}^{2}-4x-3,$ shown above." :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=2,$ we will set our result equal to $2.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=k$ and $b=-4$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{(-4)}{2(k)} \\\\  & =\\frac{4}{2k} \\\\  & =\\frac{2}{k}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=2,$ so we must have\n\n$$\n\\begin{aligned}\\frac{2}{k} & =2 \\\\ k & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f052216e-63bd-5ea7-afd7-f527cc62948f"] :db/ensure [:question/validate]} {:db/id "answer-field-f052216e-63bd-5ea7-afd7-f527cc62948f" :answer-field/id #uuid "f052216e-63bd-5ea7-afd7-f527cc62948f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b5c5638c-a1ad-5f6d-896c-f4e82582e94a" :answer-field/choices ["answer-b5c5638c-a1ad-5f6d-896c-f4e82582e94a" "answer-43802df7-8342-568c-a667-de7740556755" "answer-bbf707a4-c921-5473-a125-88998757dba5" "answer-c5d56b8c-8736-52e7-863f-fa9fbfea0bed" "answer-5e1106c4-cc4f-500d-9bf2-992f9e4be7f5"] :db/ensure [:answer-field/validate]} {:db/id "answer-b5c5638c-a1ad-5f6d-896c-f4e82582e94a" :answer/id #uuid "b5c5638c-a1ad-5f6d-896c-f4e82582e94a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-43802df7-8342-568c-a667-de7740556755" :answer/id #uuid "43802df7-8342-568c-a667-de7740556755" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-bbf707a4-c921-5473-a125-88998757dba5" :answer/id #uuid "bbf707a4-c921-5473-a125-88998757dba5" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-c5d56b8c-8736-52e7-863f-fa9fbfea0bed" :answer/id #uuid "c5d56b8c-8736-52e7-863f-fa9fbfea0bed" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-5e1106c4-cc4f-500d-9bf2-992f9e4be7f5" :answer/id #uuid "5e1106c4-cc4f-500d-9bf2-992f9e4be7f5" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "question-f5ac6aea-bcfe-5a0e-83c5-58a351f6e0ff" :question/id #uuid "f5ac6aea-bcfe-5a0e-83c5-58a351f6e0ff" :question/math-academy-id "q-222095" :question/problem "![](images/8e/8ea5d11ca8b92193517fa7082a466e2ece1f5c505e6881c70ce8ebebb5b93913.png)\n\nFind the value of $k$ for the parabola $y=5{x}^{2}+kx-8,$ shown above.\n\n$k=$\n{{field-1}}" :question/worked-solution "First, we will calculate the axis of symmetry in terms of $k.$ Then, since the graph tells us that the axis of symmetry is $x=-2,$ we will set our result equal to $-2.$ \n\nThe equation of the axis of symmetry of the parabola $y=a{x}^{2}+bx+c$ is given by\n\n$$\nx=-\\frac{b}{2a}.\n$$\n\nSubstituting $a=5$ and $b=k$ into the formula for the axis of symmetry, we get\n\n$$\n\\begin{aligned}x & =-\\frac{k}{2(5)} \\\\  & =-\\frac{k}{10}.\\end{aligned}\n$$\n\nWe already know that the axis of symmetry is $x=-2,$ so we must have\n\n$$\n\\begin{aligned}-\\frac{k}{10} & =-2 \\\\ -k & =-20 \\\\ k & =20.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-a61a87ea-3783-51c0-97b6-886a2e7f21d3"] :db/ensure [:question/validate]} {:db/id "answer-field-a61a87ea-3783-51c0-97b6-886a2e7f21d3" :answer-field/id #uuid "a61a87ea-3783-51c0-97b6-886a2e7f21d3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b6f131a8-f416-56ab-b966-abc820357c27" :answer-field/choices ["answer-b6f131a8-f416-56ab-b966-abc820357c27"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6f131a8-f416-56ab-b966-abc820357c27" :answer/id #uuid "b6f131a8-f416-56ab-b966-abc820357c27" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id 17592186084524 :tutorial/content "To determine the axis of symmetry of the parabola $y=ax^2+bx+c,$ we can use the following formula:\n\n$$\nx=-\\dfrac{b}{2a}\n$$\n\nWe'll derive this result in a separate lesson. For now, let's get some practice working with it. \n\nSuppose we want to find the axis of symmetry of the function $y=3x^2-6x+1.$ To do this, we substitute $a=3$ and $b=-6$ into the above formula, as follows:\n\n$$\n\\begin{aligned}x & =-\\frac{b}{2a} \\\\  & =-\\frac{(-6)}{2(3)} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, $x=1$ is the equation of the axis of symmetry. \n\n![](images/88/88ee917eb387ee60e67080785519ffe9cb4333adcd602a733659d0447c37f61a.png)\n\nThe vertex of the parabola lies on the axis of symmetry, so $x=1$ also represents the $x$-coordinate of the vertex. To find the $y$-coordinate of the vertex, we can substitute $x=1$ into the original equation:\n\n$$\n\\begin{aligned}y & =3{x}^{2}-6x+1 \\\\  & =3(1)^{2}-6(1)+1 \\\\  & =3-6+1 \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the vertex is at $(1,-2).$\n\n![](images/a3/a391338ffb2bddd2a58b836e328c574d348215c518b27d9886ca11a21674943a.png)" :db/ensure [:tutorial/validate]} {:db/id 17592186083410 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186198602 :question/problem "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\frac{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}}{∂x}-Q\\frac{∂g}{\\bbox[3pt,border:1pt solid black]{\\phantom{A}}}+R)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :db/ensure [:question/validate]} {:db/id 17592186278516 :question/problem "For a surface $S$ given by $x=2yz$ for $(y,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(P+\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,z+\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,y)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :db/ensure [:question/validate]} {:db/id 17592186278515 :question/problem "For a surface $S$ given by $y=-{x}^{2}z$ for $(x,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,xz+Q+\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\,{x}^{2})\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?\n\n*Hint: The orientation of $S$ should be chosen such that the unit normal vector has a positive  $j$-component.*" :db/ensure [:question/validate]} {:db/id 17592186198605 :question/problem "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\frac{∂g}{∂x}+\\bbox[3pt,border:1pt solid black]{\\phantom{A}}\\frac{∂g}{∂y}+R)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :db/ensure [:question/validate]} {:db/id 17592186204086 :knowledge-point/questions ["question-69b033a7-d872-59bc-ae3f-9a5bfb186950" "question-209023bf-0612-560b-b7ed-a33687740998"] :db/ensure [:knowledge-point/validate]} {:db/id "question-69b033a7-d872-59bc-ae3f-9a5bfb186950" :question/id #uuid "69b033a7-d872-59bc-ae3f-9a5bfb186950" :question/math-academy-id "q-264852" :question/problem "Given the quartic function $f(x;a,b,c)=a{x}^{4}+b{x}^{3}+c{x}^{2},$ compute ${∇}_{b,c}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{b,c}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{b,c}\\,f$, we take partial derivatives with respect to $b$ and $c.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂b} & =\\frac{∂}{∂b}(a{x}^{4}+b{x}^{3}+c{x}^{2})={x}^{3} \\\\ \\frac{∂f}{∂c} & =\\frac{∂}{∂c}(a{x}^{4}+b{x}^{3}+c{x}^{2})={x}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{b,c}\\,f & =[\\begin{aligned}\\frac{∂f}{∂b} \\\\ \\frac{∂f}{∂c}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}^{3} \\\\ {x}^{2}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e177c0d9-604c-50b5-9592-24314dee2a81" "answer-field-59bc1d2d-7c29-5024-8664-09afd9227859"] :db/ensure [:question/validate]} {:db/id "answer-field-e177c0d9-604c-50b5-9592-24314dee2a81" :answer-field/id #uuid "e177c0d9-604c-50b5-9592-24314dee2a81" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-032c81c6-185e-5f81-99a7-3ca194e32338" :answer-field/choices ["answer-032c81c6-185e-5f81-99a7-3ca194e32338"] :db/ensure [:answer-field/validate]} {:db/id "answer-032c81c6-185e-5f81-99a7-3ca194e32338" :answer/id #uuid "032c81c6-185e-5f81-99a7-3ca194e32338" :answer/type :answer.type/math :answer/value "x^{3}" :db/ensure [:answer/validate]} {:db/id "answer-field-59bc1d2d-7c29-5024-8664-09afd9227859" :answer-field/id #uuid "59bc1d2d-7c29-5024-8664-09afd9227859" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-9f743137-843f-59c2-bbb5-4cf9167a7f64" :answer-field/choices ["answer-9f743137-843f-59c2-bbb5-4cf9167a7f64"] :db/ensure [:answer-field/validate]} {:db/id "answer-9f743137-843f-59c2-bbb5-4cf9167a7f64" :answer/id #uuid "9f743137-843f-59c2-bbb5-4cf9167a7f64" :answer/type :answer.type/math :answer/value "x^{2}" :db/ensure [:answer/validate]} {:db/id "question-209023bf-0612-560b-b7ed-a33687740998" :question/id #uuid "209023bf-0612-560b-b7ed-a33687740998" :question/math-academy-id "q-264855" :question/problem "Given the function $f(x,y;a,b)=ax+by,$ compute ${∇}_{a,b}\\,f.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{a,b}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{a,b}\\,f$, we take partial derivatives with respect to $a$ and $b.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂a} & =\\frac{∂}{∂a}(ax+by)=x \\\\ \\frac{∂f}{∂b} & =\\frac{∂}{∂b}(ax+by)=y\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{a,b}\\,f & =[\\begin{aligned}\\frac{∂f}{∂a} \\\\ \\frac{∂f}{∂b}\\end{aligned}] \\\\  & =[\\begin{aligned}x \\\\ y\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b5d086f0-9d69-58b3-9c6b-60b0c91a8ff3" "answer-field-abbf1633-ea12-5087-9624-31bca0dfc695"] :db/ensure [:question/validate]} {:db/id "answer-field-b5d086f0-9d69-58b3-9c6b-60b0c91a8ff3" :answer-field/id #uuid "b5d086f0-9d69-58b3-9c6b-60b0c91a8ff3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-4b6c244a-b2f6-5ab8-a481-52aacac4dd91" :answer-field/choices ["answer-4b6c244a-b2f6-5ab8-a481-52aacac4dd91"] :db/ensure [:answer-field/validate]} {:db/id "answer-4b6c244a-b2f6-5ab8-a481-52aacac4dd91" :answer/id #uuid "4b6c244a-b2f6-5ab8-a481-52aacac4dd91" :answer/type :answer.type/math :answer/value "x" :db/ensure [:answer/validate]} {:db/id "answer-field-abbf1633-ea12-5087-9624-31bca0dfc695" :answer-field/id #uuid "abbf1633-ea12-5087-9624-31bca0dfc695" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-5bb37b4c-595b-5767-8df6-2c02873bec6e" :answer-field/choices ["answer-5bb37b4c-595b-5767-8df6-2c02873bec6e"] :db/ensure [:answer-field/validate]} {:db/id "answer-5bb37b4c-595b-5767-8df6-2c02873bec6e" :answer/id #uuid "5bb37b4c-595b-5767-8df6-2c02873bec6e" :answer/type :answer.type/math :answer/value "y" :db/ensure [:answer/validate]} {:db/id 17592186204087 :knowledge-point/questions ["question-1a79f623-fca8-50cb-ac85-6ca0845384fa"] :db/ensure [:knowledge-point/validate]} {:db/id "question-1a79f623-fca8-50cb-ac85-6ca0845384fa" :question/id #uuid "1a79f623-fca8-50cb-ac85-6ca0845384fa" :question/math-academy-id "q-264870" :question/problem "Given the function \n$f(x;w)=2{w}_{1}{x}_{1}-5{w}_{2}{x}_{2},$\ncompute ${∇}_{w}\\,f$ with the input $x={[\\begin{aligned}-2,\\,8\\end{aligned}]}^{T}.$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}\\,f=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "To compute ${∇}_{w}\\,f$, we take partial derivatives with respect to each component of $w.$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}(2{w}_{1}{x}_{1}-5{w}_{2}{x}_{2})=2{x}_{1} \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}(2{w}_{1}{x}_{1}-5{w}_{2}{x}_{2})=-5{x}_{2}\\end{aligned}\n$$\n\nTherefore, with $x={[\\begin{aligned}-2,\\,8\\end{aligned}]}^{T},$ we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}\\,f & =[\\begin{aligned}2{x}_{1} \\\\ -5{x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-4 \\\\ -40\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-2e7db6c9-8fee-509b-870a-3fa074ffb816" "answer-field-0520897a-4097-5830-8b06-a11b414ba8b2"] :db/ensure [:question/validate]} {:db/id "answer-field-2e7db6c9-8fee-509b-870a-3fa074ffb816" :answer-field/id #uuid "2e7db6c9-8fee-509b-870a-3fa074ffb816" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e1fdefc4-3207-5c16-8acf-87f93d20ab3d" :answer-field/choices ["answer-e1fdefc4-3207-5c16-8acf-87f93d20ab3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-e1fdefc4-3207-5c16-8acf-87f93d20ab3d" :answer/id #uuid "e1fdefc4-3207-5c16-8acf-87f93d20ab3d" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-field-0520897a-4097-5830-8b06-a11b414ba8b2" :answer-field/id #uuid "0520897a-4097-5830-8b06-a11b414ba8b2" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0a932e28-eaed-58b2-9160-b95738ec4281" :answer-field/choices ["answer-0a932e28-eaed-58b2-9160-b95738ec4281"] :db/ensure [:answer-field/validate]} {:db/id "answer-0a932e28-eaed-58b2-9160-b95738ec4281" :answer/id #uuid "0a932e28-eaed-58b2-9160-b95738ec4281" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id 17592186204088 :knowledge-point/questions ["question-892266dd-4065-579e-8406-1b3b7c58257b" "question-869ee47c-102a-5b9f-9e3a-e75445c641bf"] :db/ensure [:knowledge-point/validate]} {:db/id "question-892266dd-4065-579e-8406-1b3b7c58257b" :question/id #uuid "892266dd-4065-579e-8406-1b3b7c58257b" :question/math-academy-id "q-264885" :question/problem "Given the function $f(x,y,z)=xyz$, compute ${∇}_{x,z}({∇}_{x,z}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{x,z}({∇}_{x,z}f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we take the variable subset gradient:\n\n$$\n\\begin{aligned}{∇}_{x,z}\\,f & =[\\begin{aligned}\\frac{∂}{∂x}(xyz) \\\\ \\frac{∂}{∂z}(xyz)\\end{aligned}]=[\\begin{aligned}yz \\\\ xy\\end{aligned}]\\end{aligned}\n$$\n\nNext, we compute the second derivatives with respect to $x$ and $z$:\n\n$$\n\\begin{aligned} & \\frac{∂}{∂x}(yz)=0\\,\\, &  & \\frac{∂}{∂z}(yz)=y \\\\  & \\frac{∂}{∂x}(xy)=y\\,\\, &  & \\frac{∂}{∂z}(xy)=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{x,z}({∇}_{x,z}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂z} \\\\ \\frac{{∂}^{2}f}{∂z∂x} & \\frac{{∂}^{2}f}{∂{z}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}0 & y \\\\ y & 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b586955b-6ca9-5533-8861-e70a511d63db" "answer-field-29c11c41-4251-59f9-a07b-6dd2357b05fe" "answer-field-f507b184-60c6-57e9-b5d9-709338cca4d7" "answer-field-2fc216b1-dcc1-5053-b784-b1697b063058"] :db/ensure [:question/validate]} {:db/id "answer-field-b586955b-6ca9-5533-8861-e70a511d63db" :answer-field/id #uuid "b586955b-6ca9-5533-8861-e70a511d63db" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6988ec71-c280-5ab5-8895-24dd8a6cb7d1" :answer-field/choices ["answer-6988ec71-c280-5ab5-8895-24dd8a6cb7d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6988ec71-c280-5ab5-8895-24dd8a6cb7d1" :answer/id #uuid "6988ec71-c280-5ab5-8895-24dd8a6cb7d1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-field-29c11c41-4251-59f9-a07b-6dd2357b05fe" :answer-field/id #uuid "29c11c41-4251-59f9-a07b-6dd2357b05fe" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0b6be170-22a5-50c2-b423-ef63a5649a71" :answer-field/choices ["answer-0b6be170-22a5-50c2-b423-ef63a5649a71"] :db/ensure [:answer-field/validate]} {:db/id "answer-0b6be170-22a5-50c2-b423-ef63a5649a71" :answer/id #uuid "0b6be170-22a5-50c2-b423-ef63a5649a71" :answer/type :answer.type/math :answer/value "y" :db/ensure [:answer/validate]} {:db/id "answer-field-f507b184-60c6-57e9-b5d9-709338cca4d7" :answer-field/id #uuid "f507b184-60c6-57e9-b5d9-709338cca4d7" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-a1dbc036-af8b-5f8a-96be-7cf52a033cef" :answer-field/choices ["answer-a1dbc036-af8b-5f8a-96be-7cf52a033cef"] :db/ensure [:answer-field/validate]} {:db/id "answer-a1dbc036-af8b-5f8a-96be-7cf52a033cef" :answer/id #uuid "a1dbc036-af8b-5f8a-96be-7cf52a033cef" :answer/type :answer.type/math :answer/value "y" :db/ensure [:answer/validate]} {:db/id "answer-field-2fc216b1-dcc1-5053-b784-b1697b063058" :answer-field/id #uuid "2fc216b1-dcc1-5053-b784-b1697b063058" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-cfe611bb-4ff6-5647-a480-93c4ac02a258" :answer-field/choices ["answer-cfe611bb-4ff6-5647-a480-93c4ac02a258"] :db/ensure [:answer-field/validate]} {:db/id "answer-cfe611bb-4ff6-5647-a480-93c4ac02a258" :answer/id #uuid "cfe611bb-4ff6-5647-a480-93c4ac02a258" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "question-869ee47c-102a-5b9f-9e3a-e75445c641bf" :question/id #uuid "869ee47c-102a-5b9f-9e3a-e75445c641bf" :question/math-academy-id "q-264896" :question/problem "Given the function $f(x;w)={w}_{2}({w}_{1}{x}_{2}-{x}_{1})^{2},$ compute ${∇}_{w}({∇}_{w}\\,f).$\n\n<table align=\"center\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"35px\" rowspan=\"2\" width=\"30px\">${∇}_{w}({∇}_{w}\\,f)=\\text{ }$</td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\" width=\"30px\">$2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">$2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})$</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" :question/worked-solution "First, we compute ${∇}_{w}\\,f$:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂{w}_{1}} & =\\frac{∂}{∂{w}_{1}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2})^{2}=2{w}_{2}{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\ \\frac{∂f}{∂{w}_{2}} & =\\frac{∂}{∂{w}_{2}}({w}_{1}{x}_{1}-{w}_{2}{x}_{2})^{2}=({w}_{1}{x}_{2}-{x}_{1})^{2}\\end{aligned}\n$$\n\nNext, we compute the second derivatives:\n\n$$\n\\begin{aligned} & \\frac{{∂}^{2}f}{∂{w}_{1}^{2}}=2{w}_{2}{x}_{2}^{2}\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}}=2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\  & \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}}=2{x}_{2}({w}_{1}{x}_{2}-{x}_{1})\\,\\, &  & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}=0\\end{aligned}\n$$\n\nTherefore, we obtain the following:\n\n$$\n\\begin{aligned}{∇}_{w}({∇}_{w}\\,f) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{w}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{w}_{1}∂{w}_{2}} \\\\ \\frac{{∂}^{2}f}{∂{w}_{2}∂{w}_{1}} & \\frac{{∂}^{2}f}{∂{w}_{2}^{2}}\\end{aligned}] \\\\  & =[\\begin{aligned}2{w}_{2}{x}_{2}^{2} & 2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) \\\\ 2{x}_{2}({w}_{1}{x}_{2}-{x}_{1}) & 0\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-eaa3fc51-52ac-520e-88d7-534ea602e135" "answer-field-a75257c9-8063-572f-b90b-975bf7853ddd"] :db/ensure [:question/validate]} {:db/id "answer-field-eaa3fc51-52ac-520e-88d7-534ea602e135" :answer-field/id #uuid "eaa3fc51-52ac-520e-88d7-534ea602e135" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-d58aa4b3-dfec-58ba-9003-5a0d9d8feceb" :answer-field/choices ["answer-d58aa4b3-dfec-58ba-9003-5a0d9d8feceb"] :db/ensure [:answer-field/v