b-5a5d-b401-e3ef6ebf81f0" "answer-c3b1fbe7-7cdb-5ed8-99ad-2b8326100b37" "answer-f1bc5b75-3d67-5312-97d9-c7ca2541778d" "answer-0aa21fd6-73dc-526d-b2f6-0d0e231b3737" "answer-11b49a80-db54-5c03-9923-d5fd10202f00"] :db/ensure [:answer-field/validate]} {:db/id "answer-f23d6a4a-93cb-5a5d-b401-e3ef6ebf81f0" :answer/id #uuid "f23d6a4a-93cb-5a5d-b401-e3ef6ebf81f0" :answer/type :answer.type/text :answer/value "$0.075$ pounds" :db/ensure [:answer/validate]} {:db/id "answer-c3b1fbe7-7cdb-5ed8-99ad-2b8326100b37" :answer/id #uuid "c3b1fbe7-7cdb-5ed8-99ad-2b8326100b37" :answer/type :answer.type/text :answer/value "$0.125$ pounds" :db/ensure [:answer/validate]} {:db/id "answer-f1bc5b75-3d67-5312-97d9-c7ca2541778d" :answer/id #uuid "f1bc5b75-3d67-5312-97d9-c7ca2541778d" :answer/type :answer.type/text :answer/value "$0.150$ pounds" :db/ensure [:answer/validate]} {:db/id "answer-0aa21fd6-73dc-526d-b2f6-0d0e231b3737" :answer/id #uuid "0aa21fd6-73dc-526d-b2f6-0d0e231b3737" :answer/type :answer.type/text :answer/value "$0.210$ pounds" :db/ensure [:answer/validate]} {:db/id "answer-11b49a80-db54-5c03-9923-d5fd10202f00" :answer/id #uuid "11b49a80-db54-5c03-9923-d5fd10202f00" :answer/type :answer.type/text :answer/value "$0.250$ pound" :db/ensure [:answer/validate]} {:db/id "question-33438ac4-91a4-539b-acda-ce62d65ce1c2" :question/id #uuid "33438ac4-91a4-539b-acda-ce62d65ce1c2" :question/math-academy-id "q-91921" :question/problem "Anne needs to buy copper wire, the unit price for the copper wire is $$0.08$ per foot. How many feet of cooper wire can Anne buy with $$1?$" :question/worked-solution "We are given the unit rate of $$0.08$ per foot (dollars per foot). To find the amount of copper wire that Anne can buy for $$1,$ we need to find the unit rate in feet per dollar. So, we take the reciprocal:\n\n$$\n0.08\\,\\text{dollars per foot}\\,\\to \\,1÷0.08=12.5\\,\\text{feet per dollar}\n$$\n\nSo, the unit rate is $12.5$ feet per dollar. Therefore, Anne can buy $12.5$ feet of copper wire." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-29c8db4b-ef49-5208-8e02-dc13afc8222c"] :db/ensure [:question/validate]} {:db/id "answer-field-29c8db4b-ef49-5208-8e02-dc13afc8222c" :answer-field/id #uuid "29c8db4b-ef49-5208-8e02-dc13afc8222c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b3b53488-c4c3-5859-a2eb-1ecd284ac00a" :answer-field/choices ["answer-6c61f091-e167-5937-801b-0a7747aff68e" "answer-81fe3fe8-966b-5900-bd24-053d740450d0" "answer-89067390-efb6-59e2-8c55-037c26d4f5e8" "answer-b3b53488-c4c3-5859-a2eb-1ecd284ac00a" "answer-99bc3ec8-85e0-5692-91ac-d80fbf737d04"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c61f091-e167-5937-801b-0a7747aff68e" :answer/id #uuid "6c61f091-e167-5937-801b-0a7747aff68e" :answer/type :answer.type/text :answer/value "$10.5$ feet" :db/ensure [:answer/validate]} {:db/id "answer-81fe3fe8-966b-5900-bd24-053d740450d0" :answer/id #uuid "81fe3fe8-966b-5900-bd24-053d740450d0" :answer/type :answer.type/text :answer/value "$10.9$ feet" :db/ensure [:answer/validate]} {:db/id "answer-89067390-efb6-59e2-8c55-037c26d4f5e8" :answer/id #uuid "89067390-efb6-59e2-8c55-037c26d4f5e8" :answer/type :answer.type/text :answer/value "$11.4$ feet" :db/ensure [:answer/validate]} {:db/id "answer-b3b53488-c4c3-5859-a2eb-1ecd284ac00a" :answer/id #uuid "b3b53488-c4c3-5859-a2eb-1ecd284ac00a" :answer/type :answer.type/text :answer/value "$12.5$ feet" :db/ensure [:answer/validate]} {:db/id "answer-99bc3ec8-85e0-5692-91ac-d80fbf737d04" :answer/id #uuid "99bc3ec8-85e0-5692-91ac-d80fbf737d04" :answer/type :answer.type/text :answer/value "$8.7$ feet" :db/ensure [:answer/validate]} {:db/id "question-1ced6944-9e50-5164-8d33-69e2545adde3" :question/id #uuid "1ced6944-9e50-5164-8d33-69e2545adde3" :question/math-academy-id "q-355015" :question/problem "John wonders what bottle of juice to buy from three different types available at the convenience store:\n\n- Bottle $A$ contains $20$ ounces, and costs $$3.00\\,.$\n\n- Bottle $B$ contains $32$ ounces, and costs $$4.80\\,.$\n\n- Bottle $C$ contains $10$ ounces, and costs $$1.80\\,.$\n\nWhich bottle of juice is the best deal?" :question/worked-solution "The best deal is the one with the lowest unit price. So, we need to compute the unit prices for all three bottles. To compute the unit price, we divide the cost by the total number of ounces.\n\n- Dividing the total cost by the number of ounces in bottle $A$,  we get\n\n$$\n3.00÷20=0.15\\,.\n$$\n\nSo, the unit price of bottle $A$ is $$0.15$  per ounce.\n\n- Dividing the total cost by the number of ounces in bottle $B$,  we get\n\n$$\n4.80÷32=0.15\\,.\n$$\n\nSo, the unit price of bottle $B$ is $$0.15$  per ounce.\n\n- Dividing the total cost by the number of ounces in bottle $C$,  we get\n\n$$\n1.80÷10=0.18\\,.\n$$\n\nSo, the unit price of bottle $C$ is $$0.18$  per ounce.\n\nFrom the above, we see that bottles $A$ and $B$ have the lowest unit price. Therefore, bottles $A$ and $B$ are the best deal." :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eb5fb4d1-8797-514f-9134-467a95794481"] :db/ensure [:question/validate]} {:db/id "answer-field-eb5fb4d1-8797-514f-9134-467a95794481" :answer-field/id #uuid "eb5fb4d1-8797-514f-9134-467a95794481" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-be1d4c88-bd15-57f9-a145-2c672f0f54e8" :answer-field/choices ["answer-be1d4c88-bd15-57f9-a145-2c672f0f54e8" "answer-58c57aa2-ab46-5c5d-a839-1a086731c9b5" "answer-efeb7370-08e1-5875-a29a-51457be79925" "answer-b5be8feb-c51f-5121-b18f-aa4666bb0fc4" "answer-7938de04-9ab1-545b-b93d-28f4cff6244d"] :db/ensure [:answer-field/validate]} {:db/id "answer-be1d4c88-bd15-57f9-a145-2c672f0f54e8" :answer/id #uuid "be1d4c88-bd15-57f9-a145-2c672f0f54e8" :answer/type :answer.type/text :answer/value "$A$ and $B$ only" :db/ensure [:answer/validate]} {:db/id "answer-58c57aa2-ab46-5c