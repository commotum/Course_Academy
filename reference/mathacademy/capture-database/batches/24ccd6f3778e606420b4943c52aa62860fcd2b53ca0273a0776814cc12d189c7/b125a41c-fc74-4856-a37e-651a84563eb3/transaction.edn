ten as\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(100{x}^{2})=\\operatorname{log}⁡100+\\operatorname{log}⁡({x}^{2}).\\end{aligned}\n$$\n\nSince $100={10}^{2},$ we have\n\n$$\n\\operatorname{log}⁡100=\\operatorname{log}⁡({10}^{2})=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{log}⁡(100{x}^{2}) & =\\operatorname{log}⁡100+\\operatorname{log}⁡({x}^{2}) \\\\  & =2+\\operatorname{log}⁡({x}^{2}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-6cb60d82-ebf9-5dcc-8726-85d1f4e43c62"] :db/ensure [:question/validate]} {:db/id "answer-field-6cb60d82-ebf9-5dcc-8726-85d1f4e43c62" :answer-field/id #uuid "6cb60d82-ebf9-5dcc-8726-85d1f4e43c62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ac257b80-c474-59a8-895d-20f3d20f523e" :answer-field/choices ["answer-197e74ce-32e5-5a69-87d8-f7fbe61494be" "answer-ac257b80-c474-59a8-895d-20f3d20f523e" "answer-2f4c7963-1deb-5a29-86ed-b9412ff17c06" "answer-c1f80b35-efbd-55e9-a59e-52dc28ea93ae" "answer-882199fc-d098-5e8a-ace9-084eb555a224"] :db/ensure [:answer-field/validate]} {:db/id "answer-197e74ce-32e5-5a69-87d8-f7fbe61494be" :answer/id #uuid "197e74ce-32e5-5a69-87d8-f7fbe61494be" :answer/type :answer.type/math :answer/value "10+\\operatorname{log}⁡({x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-ac257b80-c474-59a8-895d-20f3d20f523e" :answer/id #uuid "ac257b80-c474-59a8-895d-20f3d20f523e" :answer/type :answer.type/math :answer/value "2+\\operatorname{log}⁡({x}^{2})" :db/ensure [:answer/validate]} {:db/id "answer-2f4c7963-1deb-5a29-86ed-b9412ff17c06" :answer/id #uuid "2f4c7963-1deb-5a29-86ed-b9412ff17c06" :answer/type :answer.type/math :answer/value "20+\\operatorname{log}⁡x" :db/ensure [:answer/validate]} {:db/id "answer-c1f80b35-efbd-55e9-a59e-52dc28ea93ae" :answer/id #uuid "c1f80b35-efbd-55e9-a59e-52dc28ea93ae" :answer/type :answer.type/math :answer/value "4+\\operatorname{log}⁡x" :db/ensure [:answer/valida