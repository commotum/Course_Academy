e-aad6-c400551eb4cd" :db/ensure [:step/validate]} {:db/id "step-8eb70679-39ee-53ce-aad6-c400551eb4cd" :step/id #uuid "8eb70679-39ee-53ce-aad6-c400551eb4cd" :step/content "question-f9b76f6d-a314-5376-893f-3c9706a4c31e" :step/next "step-3b3dc73d-4deb-517f-8239-1e28183ba06b" :db/ensure [:step/validate]} {:db/id "step-3b3dc73d-4deb-517f-8239-1e28183ba06b" :step/id #uuid "3b3dc73d-4deb-517f-8239-1e28183ba06b" :step/content "question-72d27b98-5424-5f73-97fc-8f2eaa4b8548" :db/ensure [:step/validate]} {:db/id 17592186078392 :knowledge-point/questions ["question-78a31293-8e99-54e0-b99f-691a4b369ca7" "question-e6b2c405-4949-514d-b4c7-24a8d0d745b1"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078250 :question/problem "Find the value of $\\cos L.$\n\n![](images/78/78416d3c8ec8a8351ecfe0a4ea81feb05cce29f55dd9ec4bc676e6363dd49ec0.png)" :question/worked-solution "Recall the definition of cosine: \n\n$$\n\\cos L = \\dfrac {\\textrm{adjacent}}{\\textrm{hypotenuse}} = \\dfrac {JL}{KL} = \\dfrac{3\\sqrt{3}}{KL}\n$$\n\nHere, we need to determine the missing side $KL.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\eqalign{\nKL &= \\sqrt{ JK^2 + JL^2 } \\\n&= \\sqrt{ (3)^2 + (3\\sqrt3)^2 } \\\n&= \\sqrt{  9 + 27 } \\\n&= \\sqrt{36}\\\n&= 6\\\n\t}\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\t\\cos L &= \\dfrac{3\\sqrt{3}}{KL} \\[5pt] \n&= \\dfrac{3\\sqrt 3}{6} \\[5pt] \n&=\\dfrac {\\sqrt 3} 2.\n}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078393 :knowledge-point/questions ["question-aec65431-c1ff-5f84-a471-b95024c34089"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078252 :question/problem "Find the sine of $\\angle Y.$\n\n![](images/e0/e0fb47c85d56c314389a0a334029b3b769f13ddcca6ab15a9021cf6361e4b1ce.png)" :question/worked-solution "Recall the definition of sine: \n\n$$\n\\sin Y = \\dfrac {\\textrm{opposite}}{\\textrm{hypotenuse}} = \\dfrac {XZ}{YZ} = \\dfrac{XZ}{61}\n$$\n\nHere, we need to determine the missing side $XZ.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\eqalign{\nXZ &= \\sqrt{ YZ^2 - XY^2 } \\\n&= \\sqrt{ 61^2 - 60^2 } \\\n&= \\sqrt{ 3721- 3600 } \\\n&= \\sqrt{121 }\\\n&= 11\n\t}\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\t\t\\sin Y&= \\dfrac{XZ}{61} = \\dfrac{11}{61}.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078394 :knowledge-point/questions ["question-7705945a-9fcd-5876-a71d-6b7d8aba9b73" "question-1fdf769a-b9f2-5675-a0ff-59f0108ca843" "question-fc60b6be-fd37-55aa-981e-4006b67e2bf9"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078254 :question/problem "Calculate $\\tan K.$\n\n![](images/fb/fbac8700b860cbe8a60f2c24a5ab7ee9e7adfda584b1077edf208b0dcd16744e.png)" :question/worked-solution "Recall the definition of tangent: \n\n$$\n\\tan K = \\dfrac {\\textrm{opposite}}{\\textrm{adjacent}} = \\dfrac {JL}{JK} = \\dfrac{JL}{7.5}\n$$\n\nHere, we need to determine the missing side $JL.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\eqalign{\nJL &= \\sqrt{ KL^2 - JK^2 } \\\n&= \\sqrt{ 12.5^2 - 7.5^2 } \\\n&= \\sqrt{ 156.25-56.25 } \\\n&= \\sqrt{100 }\\\n&= 10\n\t}\n$$\n\nTherefore,\n\n$$\n\\eqalign{\n\t\t\\tan K&= \\dfrac{JL}{7.5}\\[5pt]\n &= \\dfrac{10}{7.5}  \\[5pt]\n &=\\dfrac 4 3.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id "question-78a31293-8e99-54e0-b99f-691a4b369ca7" :question/id #uuid "78a31293-8e99-54e0-b99f-691a4b369ca7" :question/math-academy-id "q-121995" :question/problem "![](images/18/182a88f3f8f379dd35228cbb6ebe5c34d9761608a6a222710f50d8f272d3cf1e.png)\n\nCalculate $\\operatorname{cos}⁡R.$" :question/worked-solution "Recall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡R=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{QR}{PR}=\\frac{2}{PR}\n$$\n\nHere, we need to determine the missing length $PR.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}PR & =\\sqrt{P{Q}^{2}+Q{R}^{2}} \\\\  & =\\sqrt{(\\sqrt{5})^{2}+{2}^{2}} \\\\  & =\\sqrt{5+4} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡R & =\\frac{2}{PR}=\\frac{2}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0c0219dc-9ab7-51bd-a54a-d85c12bf6485"] :db/ensure [:question/validate]} {:db/id "answer-field-0c0219dc-9ab7-51bd-a54a-d85c12bf6485" :answer-field/id #uuid "0c0219dc-9ab7-51bd-a54a-d85c12bf6485" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1207c2a1-1cfe-5805-b5da-493d5d4dc80f" :answer-field/choices ["answer-6b7942ad-8b0a-561d-a64b-d2217edba6dd" "answer-5a9defc5-4f52-5829-b8db-b07e93aef54d" "answer-1207c2a1-1cfe-5805-b5da-493d5d4dc80f" "answer-4badf008-2cee-5e94-824b-287c9932a897" "answer-0add5691-f942-5b35-b192-c1da1630a40e"] :db/ensure [:answer-field/validate]} {:db/id "answer-6b7942ad-8b0a-561d-a64b-d2217edba6dd" :answer/id #uuid "6b7942ad-8b0a-561d-a64b-d2217edba6dd" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-5a9defc5-4f52-5829-b8db-b07e93aef54d" :answer/id #uuid "5a9defc5-4f52-5829-b8db-b07e93aef54d" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-1207c2a1-1cfe-5805-b5da-493d5d4dc80f" :answer/id #uuid "1207c2a1-1cfe-5805-b5da-493d5d4dc80f" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "answer-4badf008-2cee-5e94-824b-287c9932a897" :answer/id #uuid "4badf008-2cee-5e94-824b-287c9932a897" :answer/type :answer.type/math :answer/value "\\frac{3\\sqrt{5}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-0add5691-f942-5b35-b192-c1da1630a40e" :answer/id #uuid "0add5691-f942-5b35-b192-c1da1630a40e" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{3}" :db/ensure [:answer/validate]} {:db/id "question-e6b2c405-4949-514d-b4c7-24a8d0d745b1" :question/id #uuid "e6b2c405-4949-514d-b4c7-24a8d0d745b1" :question/math-academy-id "q-122005" :question/problem "In a right triangle $△LMN,$ $∠M$ is a right angle, $MN=\\sqrt{5}$ and $LM=\\sqrt{11}.$ Determine the cosine of $∠N.$" :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/df/df7dcd343dd2676cb38b7df3c2d8cb599fed45b9c0b25194609effe2bf27a6f7.png)\n\nRecall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡N=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{MN}{LN}=\\frac{\\sqrt{5}}{LN}\n$$\n\nHere, we need to determine the missing length $LN.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}LN & =\\sqrt{M{N}^{2}+L{M}^{2}} \\\\  & =\\sqrt{(\\sqrt{5})^{2}+(\\sqrt{11})^{2}} \\\\  & =\\sqrt{5+11} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡N & =\\frac{\\sqrt{5}}{LN}=\\frac{\\sqrt{5}}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-afd44c8a-35d4-5999-8bc8-aec4ecd757f7"] :db/ensure [:question/validate]} {:db/id "answer-field-afd44c8a-35d4-5999-8bc8-aec4ecd757f7" :answer-field/id #uuid "afd44c8a-35d4-5999-8bc8-aec4ecd757f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-047a8d6f-0971-5830-aa95-f722e6cf572a" :answer-field/choices ["answer-eb784457-19d3-514d-981d-cf13feed00a6" "answer-9f287caf-a6b9-5406-98e8-376345c62c95" "answer-61917919-af64-52dd-97f7-0796668d8d30" "answer-a1c442f1-f117-5be2-9dca-f353896f1aa4" "answer-047a8d6f-0971-5830-aa95-f722e6cf572a"] :db/ensure [:answer-field/validate]} {:db/id "answer-eb784457-19d3-514d-981d-cf13feed00a6" :answer/id #uuid "eb784457-19d3-514d-981d-cf13feed00a6" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-9f287caf-a6b9-5406-98e8-376345c62c95" :answer/id #uuid "9f287caf-a6b9-5406-98e8-376345c62c95" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-61917919-af64-52dd-97f7-0796668d8d30" :answer/id #uuid "61917919-af64-52dd-97f7-0796668d8d30" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-a1c442f1-f117-5be2-9dca-f353896f1aa4" :answer/id #uuid "a1c442f1-f117-5be2-9dca-f353896f1aa4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{11}}{4}" :db/ensure [:answer/validate]} {:db/id "answer-047a8d6f-0971-5830-aa95-f722e6cf572a" :answer/id #uuid "047a8d6f-0971-5830-aa95-f722e6cf572a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{4}" :db/ensure [:answer/validate]} {:db/id "question-aec65431-c1ff-5f84-a471-b95024c34089" :question/id #uuid "aec65431-c1ff-5f84-a471-b95024c34089" :question/math-academy-id "q-122045" :question/problem "In a right triangle $△FGH,$ $∠H$ is a right angle, $FH=2\\sqrt{2}$ and $FG=6.$ Find the cosine of $∠G.$" :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/e5/e585e89d11dea316c5483eeb2b2fc4750084409651ecf838e65a0d09e7bcc97f.png)\n\nRecall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡G=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{GH}{FG}=\\frac{GH}{6}\n$$\n\nHere, we need to determine the missing length $GH.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}GH & =\\sqrt{F{G}^{2}-F{H}^{2}} \\\\  & =\\sqrt{{6}^{2}-(2\\sqrt{2})^{2}} \\\\  & =\\sqrt{36-8} \\\\  & =\\sqrt{28} \\\\  & =2\\sqrt{7}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡G & =\\frac{GH}{6} \\\\  & =\\frac{2\\sqrt{7}}{6} \\\\  & =\\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8e6afa06-33da-5d44-9148-766078857a10"] :db/ensure [:question/validate]} {:db/id "answer-field-8e6afa06-33da-5d44-9148-766078857a10" :answer-field/id #uuid "8e6afa06-33da-5d44-9148-766078857a10" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f8a1f3ca-7358-58e7-9427-e7284d90f8c5" :answer-field/choices ["answer-e2cc5e62-162d-5e1f-9f7d-d682ac2eccc9" "answer-7559fa9a-aeb1-53b4-a743-b8b0a1e0597c" "answer-df818243-287d-525c-baf3-bdf1e0c459d9" "answer-f8a1f3ca-7358-58e7-9427-e7284d90f8c5" "answer-8b5c1919-5049-5ae5-89d4-605cdbb464f7"] :db/ensure [:answer-field/validate]} {:db/id "answer-e2cc5e62-162d-5e1f-9f7d-d682ac2eccc9" :answer/id #uuid "e2cc5e62-162d-5e1f-9f7d-d682ac2eccc9" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "answer-7559fa9a-aeb1-53b4-a743-b8b0a1e0597c" :answer/id #uuid "7559fa9a-aeb1-53b4-a743-b8b0a1e0597c" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-df818243-287d-525c-baf3-bdf1e0c459d9" :answer/id #uuid "df818243-287d-525c-baf3-bdf1e0c459d9" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-f8a1f3ca-7358-58e7-9427-e7284d90f8c5" :answer/id #uuid "f8a1f3ca-7358-58e7-9427-e7284d90f8c5" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8b5c1919-5049-5ae5-89d4-605cdbb464f7" :answer/id #uuid "8b5c1919-5049-5ae5-89d4-605cdbb464f7" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{7}}{6}" :db/ensure [:answer/validate]} {:db/id 17592186234385 :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/ea/ea0502e8b261358c7b55c60df02474c5b39a75cbb104d6ba3efb40300294ef56.png)\n\nRecall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡Y=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{XY}{YZ}=\\frac{XY}{7}\n$$\n\nHere, we need to determine the missing side $XY.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}XY & =\\sqrt{Y{Z}^{2}-X{Z}^{2}} \\\\  & =\\sqrt{{7}^{2}-(\\sqrt{5})^{2}} \\\\  & =\\sqrt{49-5} \\\\  & =\\sqrt{44} \\\\  & =2\\sqrt{11}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡Y & =\\frac{XY}{7}=\\frac{2\\sqrt{11}}{7}.\\end{aligned}\n$$" :question/answer-fields ["answer-field-3ccf3b06-8e27-5175-a63c-45b18215cccf"] :db/ensure [:question/validate]} {:db/id "answer-field-3ccf3b06-8e27-5175-a63c-45b18215cccf" :answer-field/id #uuid "3ccf3b06-8e27-5175-a63c-45b18215cccf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d919f955-2be1-55b1-959e-4365f6131cc0" :answer-field/choices ["answer-d919f955-2be1-55b1-959e-4365f6131cc0" "answer-248f2cde-b408-5ab0-97e4-f1139e42032a" "answer-2786aa44-fd8d-51d2-a04a-19154dd9d613" "answer-42add563-41cd-5c7b-8e51-c9a40fe536c2" "answer-b9564023-fd38-51dd-acff-be1c03307b8a"] :db/ensure [:answer-field/validate]} {:db/id "answer-d919f955-2be1-55b1-959e-4365f6131cc0" :answer/id #uuid "d919f955-2be1-55b1-959e-4365f6131cc0" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{11}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-248f2cde-b408-5ab0-97e4-f1139e42032a" :answer/id #uuid "248f2cde-b408-5ab0-97e4-f1139e42032a" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{5}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-2786aa44-fd8d-51d2-a04a-19154dd9d613" :answer/id #uuid "2786aa44-fd8d-51d2-a04a-19154dd9d613" :answer/type :answer.type/math :answer/value "\\frac{4\\sqrt{11}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-42add563-41cd-5c7b-8e51-c9a40fe536c2" :answer/id #uuid "42add563-41cd-5c7b-8e51-c9a40fe536c2" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{22}}{7}" :db/ensure [:answer/validate]} {:db/id "answer-b9564023-fd38-51dd-acff-be1c03307b8a" :answer/id #uuid "b9564023-fd38-51dd-acff-be1c03307b8a" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{7}" :db/ensure [:answer/validate]} {:db/id "question-7705945a-9fcd-5876-a71d-6b7d8aba9b73" :question/id #uuid "7705945a-9fcd-5876-a71d-6b7d8aba9b73" :question/math-academy-id "q-67554" :question/problem "![](images/de/de81dfe9ea7efd41a7ca5b576452c62491ab438dbb0b75eb7c7a6c13a903fe6f.png)\n\nDetermine the cosine of $∠Q.$" :question/worked-solution "Recall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡Q=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{QR}{PQ}=\\frac{QR}{8.5}\n$$\n\nHere, we need to determine the missing side $QR.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}QR & =\\sqrt{P{Q}^{2}-P{R}^{2}} \\\\  & =\\sqrt{(8.5)^{2}-(7.5)^{2}} \\\\  & =\\sqrt{72.25-56.25} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡Q & =\\frac{QR}{8.5} \\\\  & =\\frac{4}{8.5} \\\\  & =\\frac{40}{85} \\\\  & =\\frac{8}{17}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8d249db5-57d3-569f-92f5-17914774a070"] :db/ensure [:question/validate]} {:db/id "answer-field-8d249db5-57d3-569f-92f5-17914774a070" :answer-field/id #uuid "8d249db5-57d3-569f-92f5-17914774a070" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0de6fd12-2f07-5755-8d3a-6f1d8b0319e8" :answer-field/choices ["answer-7e77ab69-4e00-57d5-a0d0-3b4f04f4d6a4" "answer-34c6f76d-84a5-5884-8ea5-5a0513000b47" "answer-18228661-d120-5681-bd34-2bcd4f93d785" "answer-0de6fd12-2f07-5755-8d3a-6f1d8b0319e8" "answer-fc7db012-77bb-5d89-bd59-a55587f61d54"] :db/ensure [:answer-field/validate]} {:db/id "answer-7e77ab69-4e00-57d5-a0d0-3b4f04f4d6a4" :answer/id #uuid "7e77ab69-4e00-57d5-a0d0-3b4f04f4d6a4" :answer/type :answer.type/math :answer/value "\\frac{11}{15}" :db/ensure [:answer/validate]} {:db/id "answer-34c6f76d-84a5-5884-8ea5-5a0513000b47" :answer/id #uuid "34c6f76d-84a5-5884-8ea5-5a0513000b47" :answer/type :answer.type/math :answer/value "\\frac{15}{21}" :db/ensure [:answer/validate]} {:db/id "answer-18228661-d120-5681-bd34-2bcd4f93d785" :answer/id #uuid "18228661-d120-5681-bd34-2bcd4f93d785" :answer/type :answer.type/math :answer/value "\\frac{17}{21}" :db/ensure [:answer/validate]} {:db/id "answer-0de6fd12-2f07-5755-8d3a-6f1d8b0319e8" :answer/id #uuid "0de6fd12-2f07-5755-8d3a-6f1d8b0319e8" :answer/type :answer.type/math :answer/value "\\frac{8}{17}" :db/ensure [:answer/validate]} {:db/id "answer-fc7db012-77bb-5d89-bd59-a55587f61d54" :answer/id #uuid "fc7db012-77bb-5d89-bd59-a55587f61d54" :answer/type :answer.type/math :answer/value "\\frac{9}{17}" :db/ensure [:answer/validate]} {:db/id "question-1fdf769a-b9f2-5675-a0ff-59f0108ca843" :question/id #uuid "1fdf769a-b9f2-5675-a0ff-59f0108ca843" :question/math-academy-id "q-122173" :question/problem "![](images/bd/bdc0ea077dce75d6de1250ee6cf2e6dbd119b5124330c9a92edc071e475d0755.png)\n\nFind the sine of $∠U.$" :question/worked-solution "Recall the definition of sine: \n\n$$\n\\operatorname{sin}⁡U=\\frac{\\text{opposite}}{\\text{hypotenuse}}=\\frac{ST}{SU}=\\frac{ST}{12.5}\n$$\n\nHere, we need to determine the missing length $ST.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}ST & =\\sqrt{S{U}^{2}-T{U}^{2}} \\\\  & =\\sqrt{(12.5)^{2}-(7.5)^{2}} \\\\  & =\\sqrt{156.25-56.25} \\\\  & =\\sqrt{100} \\\\  & =10\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡U & =\\frac{ST}{12.5} \\\\  & =\\frac{10}{12.5} \\\\  & =\\frac{100}{125} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3a366115-f348-5b02-b72c-bbac02b13817"] :db/ensure [:question/validate]} {:db/id "answer-field-3a366115-f348-5b02-b72c-bbac02b13817" :answer-field/id #uuid "3a366115-f348-5b02-b72c-bbac02b13817" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d798b0c6-c031-55f2-9b2a-7bb43c0f75c8" :answer-field/choices ["answer-caf2e0b5-8b96-5e09-aeca-821cf0b1312d" "answer-30f116f5-65c3-5da0-b526-fc463090f7cf" "answer-4ba7de20-c492-55d4-8758-69e5179b70b1" "answer-84697758-83bc-5e35-9734-bb613b80e494" "answer-d798b0c6-c031-55f2-9b2a-7bb43c0f75c8"] :db/ensure [:answer-field/validate]} {:db/id "answer-caf2e0b5-8b96-5e09-aeca-821cf0b1312d" :answer/id #uuid "caf2e0b5-8b96-5e09-aeca-821cf0b1312d" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-30f116f5-65c3-5da0-b526-fc463090f7cf" :answer/id #uuid "30f116f5-65c3-5da0-b526-fc463090f7cf" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "answer-4ba7de20-c492-55d4-8758-69e5179b70b1" :answer/id #uuid "4ba7de20-c492-55d4-8758-69e5179b70b1" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-84697758-83bc-5e35-9734-bb613b80e494" :answer/id #uuid "84697758-83bc-5e35-9734-bb613b80e494" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d798b0c6-c031-55f2-9b2a-7bb43c0f75c8" :answer/id #uuid "d798b0c6-c031-55f2-9b2a-7bb43c0f75c8" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "question-fc60b6be-fd37-55aa-981e-4006b67e2bf9" :question/id #uuid "fc60b6be-fd37-55aa-981e-4006b67e2bf9" :question/math-academy-id "q-76563" :question/problem "In a right triangle $△OMN,$ $∠M$ is a right angle, $MN=1.8$ and $ON=3.$ Determine $\\operatorname{cos}⁡O.$" :question/worked-solution "The following triangle illustrates the information given.\n\n![](images/5c/5c980bff90a516627618909a863b4919dbb10be1b674911cae663f3f7c54f3fb.png)\n\nRecall the definition of cosine: \n\n$$\n\\operatorname{cos}⁡O=\\frac{\\text{adjacent}}{\\text{hypotenuse}}=\\frac{OM}{ON}=\\frac{OM}{3}\n$$\n\nHere, we need to determine the missing side $OM.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}OM & =\\sqrt{O{N}^{2}-M{N}^{2}} \\\\  & =\\sqrt{{3}^{2}-{1.8}^{2}} \\\\  & =\\sqrt{9-3.24} \\\\  & =\\sqrt{5.76} \\\\  & =2.4\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡O & =\\frac{OM}{3} \\\\  & =\\frac{2.4}{3} \\\\  & =\\frac{24}{30} \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9e20ba3b-2ce4-5c79-9503-04b8fbe7a3c4"] :db/ensure [:question/validate]} {:db/id "answer-field-9e20ba3b-2ce4-5c79-9503-04b8fbe7a3c4" :answer-field/id #uuid "9e20ba3b-2ce4-5c79-9503-04b8fbe7a3c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d13eb98c-1c94-5c76-9b4d-87ec446e756d" :answer-field/choices ["answer-ad6f986b-c2cd-55e4-a5d3-6fbb550bf5f2" "answer-41461aa7-43de-55b4-80f5-ac43667106ca" "answer-fb73bb44-7d7d-557b-b4d7-55b44301f620" "answer-76bffbe9-0710-5f13-8f49-ff8692ccf9d0" "answer-d13eb98c-1c94-5c76-9b4d-87ec446e756d"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad6f986b-c2cd-55e4-a5d3-6fbb550bf5f2" :answer/id #uuid "ad6f986b-c2cd-55e4-a5d3-6fbb550bf5f2" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "answer-41461aa7-43de-55b4-80f5-ac43667106ca" :answer/id #uuid "41461aa7-43de-55b4-80f5-ac43667106ca" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-fb73bb44-7d7d-557b-b4d7-55b44301f620" :answer/id #uuid "fb73bb44-7d7d-557b-b4d7-55b44301f620" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-76bffbe9-0710-5f13-8f49-ff8692ccf9d0" :answer/id #uuid "76bffbe9-0710-5f13-8f49-ff8692ccf9d0" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-d13eb98c-1c94-5c76-9b4d-87ec446e756d" :answer/id #uuid "d13eb98c-1c94-5c76-9b4d-87ec446e756d" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id 17592186078740 :question/problem "![](images/f9/f9f59d4328ad43e6e342da3cf9e87ccd5dfe33b97c46424e7fcc2b9f562fc452.png)\n\nFind the tangent of $∠N.$" :question/worked-solution "Recall the definition of tangent: \n\n$$\n\\operatorname{tan}⁡N=\\frac{\\text{opposite}}{\\text{adjacent}}=\\frac{OM}{MN}=\\frac{OM}{2.5}\n$$\n\nHere, we need to determine the missing side $OM.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}OM & =\\sqrt{O{N}^{2}-M{N}^{2}} \\\\  & =\\sqrt{{6.5}^{2}-{2.5}^{2}} \\\\  & =\\sqrt{42.25-6.25} \\\\  & =\\sqrt{36} \\\\  & =6\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡N & =\\frac{OM}{2.5} \\\\  & =\\frac{6}{2.5} \\\\  & =\\frac{60}{25} \\\\  & =\\frac{12}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186075316 :answer-field/correct 17592186075317 :db/ensure [:answer-field/validate]} {:db/id 17592186079637 :tutorial/content "Suppose that we have a right triangle $\\triangle ABC$ with legs $AC= BC = 1,$ like the one in the diagram below.\nHow can we find the value $\\sin \\theta$ if we don't know one of the relevant sides?\n\n![](images/ae/ae5157e6824fd98861194302ab912e76d9e79dade6706dfbedea97d859f18a79.png)\n\nRecall the definition of sine: \n\n$$\n\\sin \\theta = \\dfrac {\\textrm{opposite}}{\\textrm{hypotenuse}} = \\dfrac {AC}{AB} = \\dfrac 1 c\n$$\n\nHere, we need to determine the missing side $c.$ The trick is to use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}c & =\\sqrt{A{C}^{2}+B{C}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nFinally, we can finish computing the value of $\\sin\\theta\\mathbin{:}$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta  & =\\frac{1}{c}=\\frac{1}{\\sqrt{2}}=\\frac{1\\cdot \\sqrt{2}}{\\sqrt{2}\\cdot \\sqrt{2}}=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nNo matter which trigonometric function we need to find, if we are missing one of the relevant sides but we know the lengths of the other two sides, we can always use the Pythagorean Theorem." :db/ensure [:tutorial/validate]} {:db/id 17592186078657 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186373993 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $4$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=y\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot \\rho  \\\\  & ={\\rho }^{2}\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}y\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{4}{\\rho }^{4}\\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186374013 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $\\frac{1}{3}$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\frac{1}{3},\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=\\frac{yz}{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\frac{\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\cdot \\rho \\operatorname{cos}⁡ϕ}{{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}+{(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)}^{2}} \\\\  & =\\frac{{\\rho }^{2}\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ}{{\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\frac{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ}{\\operatorname{sin}⁡ϕ}\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{yz}{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ}{\\operatorname{sin}⁡ϕ}\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{1/3}{\\rho }^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186374020 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $\\sqrt{2}$ centered at the origin.\n\n![](images/6f/6f35be4fd6773149597ea8a9dc8dd234e068da3f0fd3b2df32d11c61521bed75.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{2},\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=z\\sqrt{{x}^{2}+{y}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\sqrt{(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}+(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}} \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\sqrt{{\\rho }^{2}{cos}^{2}⁡\\theta {sin}^{2}⁡ϕ+{\\rho }^{2}{sin}^{2}⁡\\theta {sin}^{2}⁡ϕ} \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\sqrt{{\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\rho \\operatorname{cos}⁡ϕ\\sqrt{{\\rho }^{2}{sin}^{2}⁡ϕ} \\\\  & ={\\rho }^{2}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}z\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{\\sqrt{2}}{\\rho }^{4}\\operatorname{cos}⁡ϕ{sin}^{2}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186374027 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $4$ centered at the origin.\n\n![](images/8c/8c803dbf5bcf6c2ece6c1c8352f96da1c88734ca1d792dd05593ac8c11527b2b.png)\n\n \n\nAs a result, we obtain that in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2},\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=2x({x}^{2}+{y}^{2}):$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ((\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}+(\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ)^{2}) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{cos}^{2}⁡\\theta {sin}^{2}⁡ϕ+{\\rho }^{2}{sin}^{2}⁡\\theta {sin}^{2}⁡ϕ) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{sin}^{2}⁡ϕ({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )) \\\\  & =2\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ({\\rho }^{2}{sin}^{2}⁡ϕ) \\\\  & =2{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}2x({x}^{2}+{y}^{2})\\,\\text{d}V & ={∭}_{Δ}2{\\rho }^{3}\\operatorname{cos}⁡\\theta {sin}^{3}⁡ϕ\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{4}2{\\rho }^{5}\\operatorname{cos}⁡\\theta {sin}^{4}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186374034 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ)\\,{\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ.\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents the sphere of radius $\\sqrt{5}$ centered at the origin. \nAs a result, in spherical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{5},\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi \\}.\n$$\n\nNext, we substitute the spherical polar coordinates into the function $f(x,y,z)=(x+z)\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}:$\n\n$$\n\\begin{aligned}f(x,y,z) & =f(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\rho \\operatorname{cos}⁡ϕ) \\\\  & =(\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ+\\rho \\operatorname{cos}⁡ϕ)\\cdot \\rho  \\\\  & ={\\rho }^{2}(\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ+\\operatorname{cos}⁡ϕ)\\end{aligned}\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}(x+z)\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}\\,\\text{d}V & ={∭}_{Δ}{\\rho }^{2}(\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ+\\operatorname{cos}⁡ϕ)\\cdot {\\rho }^{2}\\operatorname{sin}⁡ϕ\\,d\\rho \\,d\\theta \\,dϕ \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2\\pi }{\\int }_{0}^{\\sqrt{5}}{\\rho }^{4}\\operatorname{sin}⁡ϕ(\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ+\\operatorname{cos}⁡ϕ)\\,d\\rho \\,d\\theta \\,dϕ.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "activity-52142c4b-d922-5dc7-a9f1-90169d32601a" :activity/id #uuid "52142c4b-d922-5dc7-a9f1-90169d32601a" :activity/title "Triple Integrals in Spherical Polar Coordinates" :activity/type :activity.type/review :activity/scope 17592186050390 :activity/course 17592186046645 :activity/steps ["step-99ef8592-1c11-55e6-846a-92714d5fb86a" "step-5f034e45-57f6-5df9-8a2c-255a28f98f72" "step-10f035eb-b0ab-5ee9-967f-ef17a4212311" "step-baf16c0d-6cfa-53a4-beeb-71e5cac53459" "step-b46ea75f-0a72-5cb4-95a7-d7164378a0ec"] :activity/first-step "step-99ef8592-1c11-55e6-846a-92714d5fb86a" :db/ensure [:activity/validate]} {:db/id "step-99ef8592-1c11-55e6-846a-92714d5fb86a" :step/id #uuid "99ef8592-1c11-55e6-846a-92714d5fb86a" :step/content 17592186373993 :step/next "step-5f034e45-57f6-5df9-8a2c-255a28f98f72" :db/ensure [:step/validate]} {:db/id "step-5f034e45-57f6-5df9-8a2c-255a28f98f72" :step/id #uuid "5f034e45-57f6-5df9-8a2c-255a28f98f72" :step/content 17592186374013 :step/next "step-10f035eb-b0ab-5ee9-967f-ef17a4212311" :db/ensure [:step/validate]} {:db/id "step-10f035eb-b0ab-5ee9-967f-ef17a4212311" :step/id #uuid "10f035eb-b0ab-5ee9-967f-ef17a4212311" :step/content 17592186374020 :step/next "step-baf16c0d-6cfa-53a4-beeb-71e5cac53459" :db/ensure [:step/validate]} {:db/id "step-baf16c0d-6cfa-53a4-beeb-71e5cac53459" :step/id #uuid "baf16c0d-6cfa-53a4-beeb-71e5cac53459" :step/content 17592186374027 :step/next "step-b46ea75f-0a72-5cb4-95a7-d7164378a0ec" :db/ensure [:step/validate]} {:db/id "step-b46ea75f-0a72-5cb4-95a7-d7164378a0ec" :step/id #uuid "b46ea75f-0a72-5cb4-95a7-d7164378a0ec" :step/content 17592186374034 :db/ensure [:step/validate]} {:db/id 17592186172129 :knowledge-point/questions ["question-5391d4bc-fe22-5a3b-85bc-6502aec7782e" "question-34a9b0ce-4c8f-5634-aaa8-208faeda7581"] :db/ensure [:knowledge-point/validate]} {:db/id "question-5391d4bc-fe22-5a3b-85bc-6502aec7782e" :question/id #uuid "5391d4bc-fe22-5a3b-85bc-6502aec7782e" :question/math-academy-id "q-159626" :question/problem "The weights of the wooden and steel chairs produced by a furniture company have standard deviations of $2\\,\\text{lb}$ and $1\\,\\text{lb},$ respectively. The company wants to determine whether the population mean ${\\mu }_{x}$ of weights for the wooden chairs is greater than the population mean ${\\mu }_{y}$ of weights for the steel chairs. They construct a $95%$ confidence interval for the difference between the population means.\n\nGiven that the company sampled $100$ wooden chairs and $150$ steel chairs and found that their mean weights are $10\\,\\text{lb}$ and $9\\,\\text{lb},$ respectively, which of the following statements are true?\n\nI. The end-points of the $95%$ confidence interval for the difference between the population means are approximately $1\\pm 0.423.$\n\nII. All values contained within the $95%$ confidence interval are positive.\n\nIII. The confidence interval data suggests that ${\\mu }_{x}>{\\mu }_{y}.$\n\n*Hint: Given a random variable $Z∼N(0,1),$ the table below shows the $z$-scores ${z}_{p}$ such that $P(Z>{z}_{p})=p$ for some particular values of $p.$*\n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |" :question/worked-solution "Notice that \n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=10-9=1\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $95%$ confidence interval, we have \n\n$$\n\\alpha =1-0.95=0.05\\,⟹\\,\\frac{\\alpha }{2}=0.025.\n$$\n\nWe also need to find the $z$-score value ${z}_{0.025}$ such that $P(Z>{z}_{0.025})=0.025,$ where $Z∼N(0,1).$\nFrom the percentage points table of the normal distribution, we obtain that ${z}_{0.025}=1.960:$ \n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |\n\nNow, we can compute the margin of error:\n\n$$\nE=1.960\\cdot \\sqrt{\\frac{{2}^{2}}{100}+\\frac{{1}^{2}}{150}}≈0.423\n$$\n\n- **Step 3.** Construct the confidence interval:\n\n$$\n\\begin{aligned} & 1\\pm 0.423\\end{aligned}\n$$\n\nLet's now examine our statements.\n\n- Statement I is true. The end-points of our confidence interval are $1\\pm 0.423.$\n\n- Statement II is true. All values within the confidence interval are positive:\n\n$$\n(1-0.423,\\,1+0.423)=(0.577,\\,1.423)\n$$\n\n- Statement III is true. Since all values within the confidence interval are positive, this suggests that ${\\mu }_{x}>{\\mu }_{y}.$\n\nTherefore, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5298ca4d-ecde-5661-bd4e-59d6462c363f"] :db/ensure [:question/validate]} {:db/id "answer-field-5298ca4d-ecde-5661-bd4e-59d6462c363f" :answer-field/id #uuid "5298ca4d-ecde-5661-bd4e-59d6462c363f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e32bf06a-c78d-5f2e-a3f1-fa589a9d0e2f" :answer-field/choices ["answer-5ffb1421-5374-56b5-a2bb-9fb21023bbd8" "answer-e32bf06a-c78d-5f2e-a3f1-fa589a9d0e2f" "answer-f6f2e26f-5082-5bf5-b032-5423339dd37a" "answer-20a47bcb-1ece-5126-b658-82da8b2c4b4f" "answer-f66c0a76-54b6-5957-a194-faca4954715b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ffb1421-5374-56b5-a2bb-9fb21023bbd8" :answer/id #uuid "5ffb1421-5374-56b5-a2bb-9fb21023bbd8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e32bf06a-c78d-5f2e-a3f1-fa589a9d0e2f" :answer/id #uuid "e32bf06a-c78d-5f2e-a3f1-fa589a9d0e2f" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "answer-f6f2e26f-5082-5bf5-b032-5423339dd37a" :answer/id #uuid "f6f2e26f-5082-5bf5-b032-5423339dd37a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-20a47bcb-1ece-5126-b658-82da8b2c4b4f" :answer/id #uuid "20a47bcb-1ece-5126-b658-82da8b2c4b4f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-f66c0a76-54b6-5957-a194-faca4954715b" :answer/id #uuid "f66c0a76-54b6-5957-a194-faca4954715b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186172106 :knowledge-point/questions ["question-f9f98bfe-eda2-5f27-b0c5-b96f1c4792b0"] :db/ensure [:knowledge-point/validate]} {:db/id "question-f9f98bfe-eda2-5f27-b0c5-b96f1c4792b0" :question/id #uuid "f9f98bfe-eda2-5f27-b0c5-b96f1c4792b0" :question/math-academy-id "q-159634" :question/problem "Consider a sample of size ${n}_{1}=58$ from a population with standard deviation ${\\sigma }_{1}=3.4$ and a sample of size ${n}_{2}=86$ from a population with standard deviation ${\\sigma }_{2}=4.9.$ Given that the samples are independent and the sample means are ${\\overset{―}{x}}_{1}=34$ and  ${\\overset{―}{x}}_{2}=43,$ find a $95%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means.\n\n*Hint: Use the fact that $P(Z>1.96)=0.025,$ where $Z∼N(0,1).$*" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both sample sizes are \"sufficiently large,\" i.e., $\\ge 30,$ and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=34-43=-9\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $95%$ confidence interval, we have \n\n$$\n\\alpha =1-0.95=0.05\\,⟹\\,\\frac{\\alpha }{2}=0.025.\n$$\n\nWe are given that $P(Z>1.96)=0.025.$ As a result, \n\n$$\n{z}_{\\alpha /2}={z}_{0.025}=1.96.\n$$\n\nNow, we can compute the margin of error:\n\n$$\nE=1.96\\cdot \\sqrt{\\frac{{3.4}^{2}}{58}+\\frac{{4.9}^{2}}{86}}≈1.356\n$$\n\n- **Step 3.** Construct the $95%$ confidence interval for the difference between the population means:\n\n$$\n\\begin{aligned} & -9\\pm 1.356\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-21552841-7d86-5c0f-9131-48f4014f0900"] :db/ensure [:question/validate]} {:db/id "answer-field-21552841-7d86-5c0f-9131-48f4014f0900" :answer-field/id #uuid "21552841-7d86-5c0f-9131-48f4014f0900" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e593264d-28ab-56a2-a3df-c5c95f2634fe" :answer-field/choices ["answer-4afb2e10-ecca-5296-b23a-fa3c6ff59dac" "answer-fcbef54b-4be0-5d86-b67e-1f0fa388f6ce" "answer-e593264d-28ab-56a2-a3df-c5c95f2634fe" "answer-b4633134-7243-5e28-9de0-0f5355178cf1" "answer-b131442b-fa8e-59c6-a34b-54dfaa572ded"] :db/ensure [:answer-field/validate]} {:db/id "answer-4afb2e10-ecca-5296-b23a-fa3c6ff59dac" :answer/id #uuid "4afb2e10-ecca-5296-b23a-fa3c6ff59dac" :answer/type :answer.type/math :answer/value "-9\\pm 0.666" :db/ensure [:answer/validate]} {:db/id "answer-fcbef54b-4be0-5d86-b67e-1f0fa388f6ce" :answer/id #uuid "fcbef54b-4be0-5d86-b67e-1f0fa388f6ce" :answer/type :answer.type/math :answer/value "-9\\pm 0.938" :db/ensure [:answer/validate]} {:db/id "answer-e593264d-28ab-56a2-a3df-c5c95f2634fe" :answer/id #uuid "e593264d-28ab-56a2-a3df-c5c95f2634fe" :answer/type :answer.type/math :answer/value "-9\\pm 1.356" :db/ensure [:answer/validate]} {:db/id "answer-b4633134-7243-5e28-9de0-0f5355178cf1" :answer/id #uuid "b4633134-7243-5e28-9de0-0f5355178cf1" :answer/type :answer.type/math :answer/value "-9\\pm 1.563" :db/ensure [:answer/validate]} {:db/id "answer-b131442b-fa8e-59c6-a34b-54dfaa572ded" :answer/id #uuid "b131442b-fa8e-59c6-a34b-54dfaa572ded" :answer/type :answer.type/math :answer/value "-9\\pm 1.911" :db/ensure [:answer/validate]} {:db/id "question-34a9b0ce-4c8f-5634-aaa8-208faeda7581" :question/id #uuid "34a9b0ce-4c8f-5634-aaa8-208faeda7581" :question/math-academy-id "q-159641" :question/problem "It is known that the thickness of ceramic tiles from suppliers X and Y are normally distributed with standard deviations of ${\\sigma }_{x}=1.6\\,\\text{mm}$ and ${\\sigma }_{y}=1.2\\,\\text{mm},$ respectively. A construction contractor wants to determine whether the population mean ${\\mu }_{x}$ of the thickness of ceramic tiles from supplier X is greater than the population mean ${\\mu }_{y}$ of the thickness of ceramic tiles from supplier Y. He constructs a $95%$ confidence interval for the difference between the population means.\n\nGiven that the contractor sampled $20$ tiles from supplier X and $18$ tiles from supplier Y and found that their mean thicknesses are $18.8\\,\\text{mm}$ and $18.5\\,\\text{mm},$ respectively, which of the following statements are true?\n\nI. The end-points of the $95%$ confidence interval for the difference between the population means are approximately $0.3\\pm 0.894.$\n\nII. All values contained within the $95%$ confidence interval are positive.\n\nIII. The confidence interval data suggests that ${\\mu }_{x}>{\\mu }_{y}.$\n\n*Hint: Given a random variable $Z∼N(0,1),$ the table below shows the $z$-scores ${z}_{p}$ such that $P(Z>{z}_{p})=p$ for some particular values of $p.$*\n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both populations are normally distributed, and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=18.8-18.5=0.3\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $95%$ confidence interval, we have \n\n$$\n\\alpha =1-0.95=0.05\\,⟹\\,\\frac{\\alpha }{2}=0.025.\n$$\n\nWe also need to find the $z$-score value ${z}_{0.025}$ such that $P(Z>{z}_{0.025})=0.025,$ where $Z∼N(0,1).$\nFrom the percentage points table of the normal distribution, we obtain that ${z}_{0.025}=1.960:$ \n\n| $p$ | $0.100$ | $0.050$ | $0.025$ | $0.010$ | $0.005$ |\n| --- | --- | --- | --- | --- | --- |\n| ${z}_{p}$ | $1.282$ | $1.645$ | $1.960$ | $2.326$ | $2.576$ |\n\nNow, we can compute the margin of error:\n\n$$\nE=1.960\\cdot \\sqrt{\\frac{{1.6}^{2}}{20}+\\frac{{1.2}^{2}}{18}}≈0.894\n$$\n\n- **Step 3.** Construct the confidence interval:\n\n$$\n\\begin{aligned} & 0.3\\pm 0.894\\end{aligned}\n$$\n\nLet's now examine our statements.\n\n- Statement I is true. The end-points of our confidence interval are $0.3\\pm 0.894.$\n\n- Statement II is false. The confidence interval contains $0:$\n\n$$\n(0.3-0.894,\\,0.3+0.894)=(-0.594,\\,1.194)\n$$\n\n- Statement III is false. Since the confidence interval contains zero, it remains possible that ${\\mu }_{x}={\\mu }_{y}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-f24e3ec2-08cb-5869-8ee2-41217f338f4b"] :db/ensure [:question/validate]} {:db/id "answer-field-f24e3ec2-08cb-5869-8ee2-41217f338f4b" :answer-field/id #uuid "f24e3ec2-08cb-5869-8ee2-41217f338f4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d94056d5-23c1-5895-8352-362b6172cbef" :answer-field/choices ["answer-73cbb3cd-94a4-531b-8992-a4d90c29793d" "answer-d94056d5-23c1-5895-8352-362b6172cbef" "answer-a14ed575-9de2-5d57-8f0a-151dcd5cb36c" "answer-f83320d5-06d8-528d-a2fa-782e2f50780c" "answer-65f2c1af-4f10-592c-9fcf-8c3faa46018b"] :db/ensure [:answer-field/validate]} {:db/id "answer-73cbb3cd-94a4-531b-8992-a4d90c29793d" :answer/id #uuid "73cbb3cd-94a4-531b-8992-a4d90c29793d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-d94056d5-23c1-5895-8352-362b6172cbef" :answer/id #uuid "d94056d5-23c1-5895-8352-362b6172cbef" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-a14ed575-9de2-5d57-8f0a-151dcd5cb36c" :answer/id #uuid "a14ed575-9de2-5d57-8f0a-151dcd5cb36c" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-f83320d5-06d8-528d-a2fa-782e2f50780c" :answer/id #uuid "f83320d5-06d8-528d-a2fa-782e2f50780c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-65f2c1af-4f10-592c-9fcf-8c3faa46018b" :answer/id #uuid "65f2c1af-4f10-592c-9fcf-8c3faa46018b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id 17592186172105 :knowledge-point/questions ["question-12431c38-5ac6-59aa-ba15-2add6471e563" "question-db9cf9a1-6584-5405-8a36-efa72137f427"] :db/ensure [:knowledge-point/validate]} {:db/id "question-12431c38-5ac6-59aa-ba15-2add6471e563" :question/id #uuid "12431c38-5ac6-59aa-ba15-2add6471e563" :question/math-academy-id "q-159642" :question/problem "![](images/64/6486d3914bb0f7b4898220512e96630d13d2b0f4a5c1851938f98371a4c0255f.png)\n\nConsider a sample of size ${n}_{1}=30$ from a normal population with standard deviation ${\\sigma }_{1}=7$ and a sample of size ${n}_{2}=32$ from a normal population with standard deviation ${\\sigma }_{2}=12.$ Given that the samples are independent and the sample means are ${\\overset{―}{x}}_{1}=22$ and  ${\\overset{―}{x}}_{2}=16,$ find a $99%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means.\n\n*Hint: Use the fact that $P(Z>2.576)=0.005,$ where $Z∼N(0,1),$ as shown in the diagram above.*" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both populations are normally distributed, and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=22-16=6\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $99%$ confidence interval, we have \n\n$$\n\\alpha =1-0.99=0.01\\,⟹\\,\\frac{\\alpha }{2}=0.005.\n$$\n\nWe are given that $P(Z>2.576)=0.005.$ As a result, \n\n$$\n{z}_{\\alpha /2}={z}_{0.005}=2.576.\n$$\n\nNow, we can compute the margin of error:\n\n$$\nE=2.576\\cdot \\sqrt{\\frac{{7}^{2}}{30}+\\frac{{12}^{2}}{32}}≈6.380\n$$\n\n- **Step 3.** Construct the $99%$ confidence interval for the difference between the population means:\n\n$$\n\\begin{aligned} & 6\\pm 6.380\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-fe7bf0ba-27c6-5e85-90fc-d44843ac230f"] :db/ensure [:question/validate]} {:db/id "answer-field-fe7bf0ba-27c6-5e85-90fc-d44843ac230f" :answer-field/id #uuid "fe7bf0ba-27c6-5e85-90fc-d44843ac230f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec4dc5f0-036a-5939-ad15-8aa21a1aa5f8" :answer-field/choices ["answer-b62c0cb8-6799-5ac4-bb8e-3e9824262e66" "answer-ec4dc5f0-036a-5939-ad15-8aa21a1aa5f8" "answer-9dba8f44-3248-5a69-9eee-19fc5e572be6" "answer-2bb24e5f-7d8c-5eb1-90c8-8d9b94a92255" "answer-b29e678d-3c58-5275-b969-0ca48fcef8d4"] :db/ensure [:answer-field/validate]} {:db/id "answer-b62c0cb8-6799-5ac4-bb8e-3e9824262e66" :answer/id #uuid "b62c0cb8-6799-5ac4-bb8e-3e9824262e66" :answer/type :answer.type/math :answer/value "6\\pm 4.530" :db/ensure [:answer/validate]} {:db/id "answer-ec4dc5f0-036a-5939-ad15-8aa21a1aa5f8" :answer/id #uuid "ec4dc5f0-036a-5939-ad15-8aa21a1aa5f8" :answer/type :answer.type/math :answer/value "6\\pm 6.380" :db/ensure [:answer/validate]} {:db/id "answer-9dba8f44-3248-5a69-9eee-19fc5e572be6" :answer/id #uuid "9dba8f44-3248-5a69-9eee-19fc5e572be6" :answer/type :answer.type/math :answer/value "6\\pm 6.784" :db/ensure [:answer/validate]} {:db/id "answer-2bb24e5f-7d8c-5eb1-90c8-8d9b94a92255" :answer/id #uuid "2bb24e5f-7d8c-5eb1-90c8-8d9b94a92255" :answer/type :answer.type/math :answer/value "7\\pm 3.760" :db/ensure [:answer/validate]} {:db/id "answer-b29e678d-3c58-5275-b969-0ca48fcef8d4" :answer/id #uuid "b29e678d-3c58-5275-b969-0ca48fcef8d4" :answer/type :answer.type/math :answer/value "7\\pm 4.580" :db/ensure [:answer/validate]} {:db/id "question-db9cf9a1-6584-5405-8a36-efa72137f427" :question/id #uuid "db9cf9a1-6584-5405-8a36-efa72137f427" :question/math-academy-id "q-159643" :question/problem "![](images/69/693576483310a4656435ea4a3d8d9652b8de563d26a87c7c80fb902a3bef1e29.png)\n\nConsider a sample of size ${n}_{1}=32$ from a normal population with standard deviation ${\\sigma }_{1}=5$ and a sample of size ${n}_{2}=28$ from a normal population with standard deviation ${\\sigma }_{2}=7.$ Given that the samples are independent and the sample means are ${\\overset{―}{x}}_{1}=19$ and  ${\\overset{―}{x}}_{2}=11,$ find a $95%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means.\n\n*Hint: Use the fact that $P(Z>1.96)=0.025,$ where $Z∼N(0,1),$ as shown in the diagram above.*" :question/worked-solution "Notice that\n\n- the samples are independent,\n\n- both populations are normally distributed, and\n\n- both population variances are known.\n\nAs a result, given a value $\\alpha $ between $0$ and $1,$ the corresponding $[100(1-\\alpha )]%$ confidence interval for the difference ${\\mu }_{1}-{\\mu }_{2}$ between the corresponding population means can be written as\n\n$$\n({\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2})\\pm E\n$$\n\nwhere \n\n- $E={z}_{\\alpha /2}\\sqrt{\\frac{{\\sigma }_{1}^{2}}{{n}_{1}}+\\frac{{\\sigma }_{2}^{2}}{{n}_{2}}}$ is the margin of error,\n\n- ${\\overset{―}{x}}_{1}$ and ${\\overset{―}{x}}_{2}$ are the sample means, ${\\mu }_{1}$ and ${\\mu }_{2}$ are the population means, ${\\sigma }_{1}^{2}$ and ${\\sigma }_{2}^{2}$ are the population variances,  ${n}_{1}$ and ${n}_{2}$ are the sample sizes,\n\n- $P(Z>{z}_{\\alpha /2})=\\frac{\\alpha }{2}$ and $Z∼N(0,1).$\n\nNow, to construct the confidence interval, we proceed as follows:\n\n- **Step 1.** Find the point estimate:\n\n$$\n{\\overset{―}{x}}_{1}-{\\overset{―}{x}}_{2}=19-11=8\n$$\n\n- **Step 2.** Find the margin of error. Since we are interested in finding a $95%$ confidence interval, we have \n\n$$\n\\alpha =1-0.95=0.05\\,⟹\\,\\frac{\\alpha }{2}=0.025.\n$$\n\nWe are given that $P(Z>1.96)=0.025.$ As a result, \n\n$$\n{z}_{\\alpha /2}={z}_{0.025}=1.96.\n$$\n\nNow, we can compute the margin of error:\n\n$$\nE=1.96\\cdot \\sqrt{\\frac{{5}^{2}}{32}+\\frac{{7}^{2}}{28}}≈3.118\n$$\n\n- **Step 3.** Construct the $95%$ confidence interval for the difference between the population means:\n\n$$\n\\begin{aligned} & 8\\pm 3.118\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-736c5de7-2fbd-5a65-8262-e8bce4536075"] :db/ensure [:question/validate]} {:db/id "answer-field-736c5de7-2fbd-5a65-8262-e8bce4536075" :answer-field/id #uuid "736c5de7-2fbd-5a65-8262-e8bce4536075" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6e3f9768-135a-5874-97de-788770ddf0c3" :answer-field/choices ["answer-f4288d34-1117-5ed0-b243-2c2c810cc589" "answer-99447647-4006-52bb-adcd-1816c068b843" "answer-6e3f9768-135a-5874-97de-788770ddf0c3" "answer-3e34c82e-f3f4-523a-ab51-ab809db9fcc9" "answer-9eb298de-a5f9-5a47-b8be-adf5a2151ff2"] :db/ensure [:answer-field/validate]} {:db/id "answer-f4288d34-1117-5ed0-b243-2c2c810cc589" :answer/id #uuid "f4288d34-1117-5ed0-b243-2c2c810cc589" :answer/type :answer.type/math :answer/value "6\\pm 2.768" :db/ensure [:answer/validate]} {:db/id "answer-99447647-4006-52bb-adcd-1816c068b843" :answer/id #uuid "99447647-4006-52bb-adcd-1816c068b843" :answer/type :answer.type/math :answer/value "6\\pm 2.832" :db/ensure [:answer/validate]} {:db/id "answer-6e3f9768-135a-5874-97de-788770ddf0c3" :answer/id #uuid "6e3f9768-135a-5874-97de-788770ddf0c3" :answer/type :answer.type/math :answer/value "8\\pm 3.118" :db/ensure [:answer/validate]} {:db/id "answer-3e34c82e-f3f4-523a-ab51-ab809db9fcc9" :answer/id #uuid "3e34c82e-f3f4-523a-ab51-ab809db9fcc9" :answer/type :answer.type/math :answer/value "8\\pm 3.238" :db/ensure [:answer/validate]} {:db/id "answer-9eb298de-a5f9-5a47-b8be-adf5a2151ff2" :answer/id #uuid "9eb298de-a5f9-5a47-b8be-adf5a2151ff2" :answer/type :answer.type/math :answer/value "8\\pm 3.442" :db/ensure [:answer/validate]} {:db/id "activity-7e10f26f-73c5-59a7-bac0-7cdb8bdd4de0" :activity/id #uuid "7e10f26f-73c5-59a7-bac0-7cdb8bdd4de0" :activity/title "Confidence Intervals for Two Means: Known and Unequal Population Variances" :activity/type :activity.type/review :activity/scope 17592186049866 :activity/course 17592186046658 :activity/steps ["step-4d34c056-1894-58b9-beb3-f82d4263465e" "step-dd2b42e2-2329-557d-a4d3-625279cbdfe8" "step-6a0cf1ad-754a-5ce6-b1ab-f3b527efb4e9" "step-7ab50149-598b-562d-b856-92986b35c2f9" "step-ef47f619-bd0e-5e18-af22-1dd3d52f0247"] :activity/first-step "step-4d34c056-1894-58b9-beb3-f82d4263465e" :db/ensure [:activity/validate]} {:db/id "step-4d34c056-1894-58b9-beb3-f82d4263465e" :step/id #uuid "4d34c056-1894-58b9-beb3-f82d4263465e" :step/content "question-5391d4bc-fe22-5a3b-85bc-6502aec7782e" :step/next "step-dd2b42e2-2329-557d-a4d3-625279cbdfe8" :db/ensure [:step/validate]} {:db/id "step-dd2b42e2-2329-557d-a4d3-625279cbdfe8" :step/id #uuid "dd2b42e2-2329-557d-a4d3-625279cbdfe8" :step/content "question-f9f98bfe-eda2-5f27-b0c5-b96f1c4792b0" :step/next "step-6a0cf1ad-754a-5ce6-b1ab-f3b527efb4e9" :db/ensure [:step/validate]} {:db/id "step-6a0cf1ad-754a-5ce6-b1ab-f3b527efb4e9" :step/id #uuid "6a0cf1ad-754a-5ce6-b1ab-f3b527efb4e9" :step/content "question-34a9b0ce-4c8f-5634-aaa8-208faeda7581" :step/next "step-7ab50149-598b-562d-b856-92986b35c2f9" :db/ensure [:step/validate]} {:db/id "step-7ab50149-598b-562d-b856-92986b35c2f9" :step/id #uuid "7ab50149-598b-562d-b856-92986b35c2f9" :step/content "question-12431c38-5ac6-59aa-ba15-2add6471e563" :step/next "step-ef47f619-bd0e-5e18-af22-1dd3d52f0247" :db/ensure [:step/validate]} {:db/id "step-ef47f619-bd0e-5e18-af22-1dd3d52f0247" :step/id #uuid "ef47f619-bd0e-5e18-af22-1dd3d52f0247" :step/content "question-db9cf9a1-6584-5405-8a36-efa72137f427" :db/ensure [:step/validate]} {:db/id 17592186115262 :knowledge-point/questions ["question-c4f3f9b9-166f-5dd9-8c08-9d9ad8ea8dae"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115091 :question/problem "The graph of $y=f(x)$ is shown below. Sketch the graph of $y=f(-x).$\n\n![](images/ca/cafc696543afde5d9e9d6442fa7f5634269ef836d94de40dcac598611be48b8c.png)" :question/worked-solution "To obtain the graph of $y=f(-x)$ from $y=f(x),$ we need to reflect the graph over the $y$-axis. The resulting graph is shown below.\n\n![](images/58/58c9396cfec04e9b042b1dd91d75b0847e34e60fa257866e60ed1b3f37535485.png)" :db/ensure [:question/validate]} {:db/id 17592186115263 :knowledge-point/questions ["question-30ee1395-5a0d-5715-816e-6b81b1745415" "question-c1cdde3c-f636-5b56-ac5b-9b6bdec51038"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186115092 :question/problem "The point $P$ with coordinates $(1, 2)$ lies on the curve $y=f(x).$ Find a point that must lie on the graph of $y= f(-x).$" :question/worked-solution "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(1, 2)$ lies $1$ unit to the *right*  of the $y$-axis. So, after the transformation is applied and the point is reflected across the $y$-axis, this point will lie $1$ unit to the *left* of the $y$-axis.\n\nTherefore, the point $P'(-1, 2)$ must lie on the graph of $y=f(-x).$\n\n![](images/0a/0aa23b1c8182d0901e27f9d1df84c30fef44396f6787f370932569f4903fb419.png)" :db/ensure [:question/validate]} {:db/id "question-c4f3f9b9-166f-5dd9-8c08-9d9ad8ea8dae" :question/id #uuid "c4f3f9b9-166f-5dd9-8c08-9d9ad8ea8dae" :question/math-academy-id "q-17836" :question/problem "![](images/6e/6e075462cab65c4070ed285e78d71fb2fafd7bcdcb898957456e83cddbf45c18.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following is the graph of $y=f(-x)?$" :question/worked-solution "To obtain the graph of $y=f(-x)$ from $y=f(x)$, we need to reflect the graph over the $y$-axis. The resulting graph is shown below.\n\n![](images/ed/ed0d31d46df8c973f92ff5b8e23a3aaeeb782fa90c2f5abb75dcf88f2d7b7421.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f5c348f4-a62e-5a54-86d9-1566ff2e8df2"] :db/ensure [:question/validate]} {:db/id "answer-field-f5c348f4-a62e-5a54-86d9-1566ff2e8df2" :answer-field/id #uuid "f5c348f4-a62e-5a54-86d9-1566ff2e8df2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2d05fcdb-0142-59d8-b3ee-abe02d134070" :answer-field/choices ["answer-2d05fcdb-0142-59d8-b3ee-abe02d134070" "answer-9ef8d22e-95bb-5c22-b16c-da2690c7dbc4" "answer-3505c052-7a64-5367-90c4-bc030bb093a2" "answer-3c188df8-781d-5dee-8460-375dfa1cb0f5" "answer-b5a26d05-156b-50a5-b9f4-07fe554287cd"] :db/ensure [:answer-field/validate]} {:db/id "answer-2d05fcdb-0142-59d8-b3ee-abe02d134070" :answer/id #uuid "2d05fcdb-0142-59d8-b3ee-abe02d134070" :answer/type :answer.type/image :answer/value "images/31/31a7f013d7a4a13f94c2c24bbbd4bef58b9d6355e7f66e0e27784bb909e29ff1.png" :db/ensure [:answer/validate]} {:db/id "answer-9ef8d22e-95bb-5c22-b16c-da2690c7dbc4" :answer/id #uuid "9ef8d22e-95bb-5c22-b16c-da2690c7dbc4" :answer/type :answer.type/image :answer/value "images/33/33a3efa35ebb00737b8e6b89fee229209d0a6e5ea8fdf24f001153a322bd37b5.png" :db/ensure [:answer/validate]} {:db/id "answer-3505c052-7a64-5367-90c4-bc030bb093a2" :answer/id #uuid "3505c052-7a64-5367-90c4-bc030bb093a2" :answer/type :answer.type/image :answer/value "images/d0/d0319fb7f540553ccd7a1341c1dcc563ee252f246c885532014a6d5a37d23a2f.png" :db/ensure [:answer/validate]} {:db/id "answer-3c188df8-781d-5dee-8460-375dfa1cb0f5" :answer/id #uuid "3c188df8-781d-5dee-8460-375dfa1cb0f5" :answer/type :answer.type/image :answer/value "images/db/db0bc91f9c97853dc8cf2d5cc2fff3af177efc92a6a07627d2a8a9c7c0e1255c.png" :db/ensure [:answer/validate]} {:db/id "answer-b5a26d05-156b-50a5-b9f4-07fe554287cd" :answer/id #uuid "b5a26d05-156b-50a5-b9f4-07fe554287cd" :answer/type :answer.type/image :answer/value "images/f0/f09b7cace5bcc9d151cba4a8f5fcb33148419babf0015bcbc7072188f22ae523.png" :db/ensure [:answer/validate]} {:db/id 17592186115524 :question/problem "![](images/0c/0cba6f1dab79599e3a8b9aa14808e5b7e62c9ad09b64bbddfcc29d922ff64ef2.png)\n\nThe function $y=f(x)$ is shown above. Which of the following gives the plot of \n$y=f(-x)?$" :question/worked-solution "To obtain the graph of $y=f(-x)$ from $y=f(x)$, we need to reflect the graph over the $y$-axis. The resulting graph is shown below.\n\n![](images/b2/b28a22b9e8a29cb6fe862bf4f2931ea7ce25f99240db008f0f325dbc4ec645e8.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186112153 :answer-field/correct 17592186112157 :db/ensure [:answer-field/validate]} {:db/id "question-30ee1395-5a0d-5715-816e-6b81b1745415" :question/id #uuid "30ee1395-5a0d-5715-816e-6b81b1745415" :question/math-academy-id "q-78777" :question/problem "The point $Q$ with coordinates $(4,1)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(-x)?$" :question/worked-solution "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(4,1)$ lies $4$ units to the *right* from the $y$-axis. So, under the action of the transformation, this point will be reflected $4$ units to the *left* from the $y$-axis.\n\n![](images/7e/7e76fb2b9821c8bb116740381248e16d8331fbfc2cce4314984fe39bbfc723e7.png)\n\nWe conclude that the point $(-4,1)$ must lie on the graph of $y=f(-x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-2074e74d-97be-5bfc-a833-d26865f40ab6"] :db/ensure [:question/validate]} {:db/id "answer-field-2074e74d-97be-5bfc-a833-d26865f40ab6" :answer-field/id #uuid "2074e74d-97be-5bfc-a833-d26865f40ab6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-266a3a94-9341-5d63-9b57-892f33d22e6f" :answer-field/choices ["answer-06b3ac1a-dcc0-5fc7-9e0e-b95cf0154d9d" "answer-688b217d-8120-5abb-a576-b07d812af813" "answer-266a3a94-9341-5d63-9b57-892f33d22e6f" "answer-f723d0b5-fb4a-5e83-8d86-e783153aba63" "answer-23bd0993-19c8-5621-b98d-b96c1b525657"] :db/ensure [:answer-field/validate]} {:db/id "answer-06b3ac1a-dcc0-5fc7-9e0e-b95cf0154d9d" :answer/id #uuid "06b3ac1a-dcc0-5fc7-9e0e-b95cf0154d9d" :answer/type :answer.type/math :answer/value "(-1,-4)" :db/ensure [:answer/validate]} {:db/id "answer-688b217d-8120-5abb-a576-b07d812af813" :answer/id #uuid "688b217d-8120-5abb-a576-b07d812af813" :answer/type :answer.type/math :answer/value "(-4,-1)" :db/ensure [:answer/validate]} {:db/id "answer-266a3a94-9341-5d63-9b57-892f33d22e6f" :answer/id #uuid "266a3a94-9341-5d63-9b57-892f33d22e6f" :answer/type :answer.type/math :answer/value "(-4,1)" :db/ensure [:answer/validate]} {:db/id "answer-f723d0b5-fb4a-5e83-8d86-e783153aba63" :answer/id #uuid "f723d0b5-fb4a-5e83-8d86-e783153aba63" :answer/type :answer.type/math :answer/value "(1,-4)" :db/ensure [:answer/validate]} {:db/id "answer-23bd0993-19c8-5621-b98d-b96c1b525657" :answer/id #uuid "23bd0993-19c8-5621-b98d-b96c1b525657" :answer/type :answer.type/math :answer/value "(4,-1)" :db/ensure [:answer/validate]} {:db/id "question-c1cdde3c-f636-5b56-ac5b-9b6bdec51038" :question/id #uuid "c1cdde3c-f636-5b56-ac5b-9b6bdec51038" :question/math-academy-id "q-78473" :question/problem "The point $Q$ with coordinates $(2,-4)$ lies on the curve $y=f(x).$ Which of the following points must lie on $y=f(-x)?$" :question/worked-solution "The transformation $y=f(-x)$ reflects the curve $y=f(x)$ in the $y$-axis.\n\nFirst, notice that the point $P(2,-4)$ lies $2$ units to the *right* from the $y$-axis. So, under the action of the transformation, this point will be reflected $2$ units to the *left* from the $y$-axis.\n\n![](images/45/456a145820b2a36693df572b49064332a18a2e79c35f2a0e3240b9995660c9a5.png)\n\nWe conclude that the point $(-2,-4)$ must lie on the graph of $y=f(-x).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-9e8273b7-9a04-5a9b-97ef-a69e365e1149"] :db/ensure [:question/validate]} {:db/id "answer-field-9e8273b7-9a04-5a9b-97ef-a69e365e1149" :answer-field/id #uuid "9e8273b7-9a04-5a9b-97ef-a69e365e1149" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8692275b-1e6c-5d14-bc65-37dc91d04d2a" :answer-field/choices ["answer-8692275b-1e6c-5d14-bc65-37dc91d04d2a" "answer-68a79a06-cdaa-58c6-8cd8-ca2f525ebf60" "answer-b6d2a97b-618a-5fd6-ab19-bf29ab887be3" "answer-47a1c8b4-1a26-50fd-95c2-f6df96e5512f" "answer-0910428c-97d6-5bf7-babf-6c00224aacca"] :db/ensure [:answer-field/validate]} {:db/id "answer-8692275b-1e6c-5d14-bc65-37dc91d04d2a" :answer/id #uuid "8692275b-1e6c-5d14-bc65-37dc91d04d2a" :answer/type :answer.type/math :answer/value "(-2,-4)" :db/ensure [:answer/validate]} {:db/id "answer-68a79a06-cdaa-58c6-8cd8-ca2f525ebf60" :answer/id #uuid "68a79a06-cdaa-58c6-8cd8-ca2f525ebf60" :answer/type :answer.type/math :answer/value "(-2,4)" :db/ensure [:answer/validate]} {:db/id "answer-b6d2a97b-618a-5fd6-ab19-bf29ab887be3" :answer/id #uuid "b6d2a97b-618a-5fd6-ab19-bf29ab887be3" :answer/type :answer.type/math :answer/value "(-4,-2)" :db/ensure [:answer/validate]} {:db/id "answer-47a1c8b4-1a26-50fd-95c2-f6df96e5512f" :answer/id #uuid "47a1c8b4-1a26-50fd-95c2-f6df96e5512f" :answer/type :answer.type/math :answer/value "(-4,2)" :db/ensure [:answer/validate]} {:db/id "answer-0910428c-97d6-5bf7-babf-6c00224aacca" :answer/id #uuid "0910428c-97d6-5bf7-babf-6c00224aacca" :answer/type :answer.type/math :answer/value "(2,4)" :db/ensure [:answer/validate]} {:db/id 17592186116505 :tutorial/content "Consider the function $y=f(x)$ whose graph is shown below. How can we plot the graph of $y=f(-x)?$\n\n![](images/51/517dbe715d1f1e79756e6e7bd0d733cc5894f425ac02b2ac1bde2c2a33e86c8d.png)\n\nWe can use some points on the graph of $y=f(x)$ to find the corresponding points on the graphs of $y=f(-x).$\n\nFor example, let's take the point $(3,4)$. The fact that it's on the graph of $y=f(x)$ means $f(3)=4.$ Then, if $x={\\color{red}-3},$ we have\n\n$$\nf(-x) = f\\left(-({\\color{red}-3})\\right) = f(3) = 4.\n$$\n\n \n\nThis means the point $({\\color{red}3},4)$ that lies on $y=f(x)$ has a corresponding point $({\\color{red}-3},4)$ that lies on $y=f(-x).$\n\nSo, for each point on the graph of $y=f(x),$ there will be a point on the graph of $y=f(-x)$ with the *same* $y$-value and the *opposite* $x$-value:\n\n$$\n\\begin{aligned}\\text{Points on [math]y=f(x)[/math]} & \\text{Points on [math]y=f(-x)[/math]} \\\\ (-1,2) & (1,2) \\\\ (0,-1) & (0,-1) \\\\ (2,0) & (-2,0) \\\\ (3,4) & (-3,4)\\end{aligned}\n$$\n\nFinally, we can plot the points and draw the graph of $y = f(-x){:}$\n\n![](images/3a/3ae62ef6496a598d27e485990ab0d3b3cb6f23211de4a015d54614db463bb131.png)\n\nLooking back at the graph, we see that every point on the graph of $y=f(-x)$ is the **reflection across the $y$-axis** of a point on the graph of $y=f(x).$\n\nSo, the graph of $y=f(-x)$ can be obtained by reflecting the graph of $y=f(x)$ over the $y$-axis. This result holds in general." :db/ensure [:tutorial/validate]} {:db/id 17592186115419 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186198592 :question/problem "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨2x,\\,\\frac{xz}{3}-2y,\\,2z⟩\\cdot \\text{d}S\n$$\n\nwhere the parametric surface $S$ is defined by\n\n$$\nr(u,v)=⟨2u-1,\\,uv,\\,3v⟩\n$$\n\nover the domain $D=\\{(u,v)\\,:\\,0\\le u\\le 1,\\,-1\\le v\\le 2\\}.$\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨3v,\\,-6,\\,2u⟩.$*" :db/ensure [:question/validate]} [:db/retract 17592186164819 :answer-field/choices 17592186164820] [:db/retract 17592186164819 :answer-field/choices 17592186164821] [:db/retract 17592186164819 :answer-field/choices 17592186164822] [:db/retract 17592186164819 :answer-field/choices 17592186164823] [:db/retract 17592186164819 :answer-field/choices 17592186164824] {:db/id 17592186166955 :knowledge-point/questions ["question-899a46d0-c395-5e11-8fbc-04b90f756929"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186167270 :question/problem "Let $F(x)={x}^{2}-2x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{2}-2(-x)) \\\\  & =-({x}^{2}+2x) \\\\  & =-{x}^{2}-2x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164819 :answer-field/correct "answer-03bfdb40-b020-5871-af7f-669ab81b634f" :answer-field/choices ["answer-0d477725-039a-569b-974c-cc8168427bd5" "answer-03bfdb40-b020-5871-af7f-669ab81b634f" "answer-133cc9fe-58b4-5563-9de2-f20044a1ad82" "answer-a721105a-d718-5aac-86a9-455b5f022623" "answer-8d7a4ec2-f370-5681-81e3-c63a1d8a2f8b"] :db/ensure [:answer-field/validate]} {:db/id "answer-0d477725-039a-569b-974c-cc8168427bd5" :answer/id #uuid "0d477725-039a-569b-974c-cc8168427bd5" :answer/type :answer.type/math :answer/value "-{x}^{2}+2x" :db/ensure [:answer/validate]} {:db/id "answer-03bfdb40-b020-5871-af7f-669ab81b634f" :answer/id #uuid "03bfdb40-b020-5871-af7f-669ab81b634f" :answer/type :answer.type/math :answer/value "-{x}^{2}-2x" :db/ensure [:answer/validate]} {:db/id "answer-133cc9fe-58b4-5563-9de2-f20044a1ad82" :answer/id #uuid "133cc9fe-58b4-5563-9de2-f20044a1ad82" :answer/type :answer.type/math :answer/value "{x}^{2}-2x" :db/ensure [:answer/validate]} {:db/id "answer-a721105a-d718-5aac-86a9-455b5f022623" :answer/id #uuid "a721105a-d718-5aac-86a9-455b5f022623" :answer/type :answer.type/math :answer/value "|-{x}^{2}+2x|" :db/ensure [:answer/validate]} {:db/id "answer-8d7a4ec2-f370-5681-81e3-c63a1d8a2f8b" :answer/id #uuid "8d7a4ec2-f370-5681-81e3-c63a1d8a2f8b" :answer/type :answer.type/math :answer/value "|x{|}^{2}+2|x|" :db/ensure [:answer/validate]} {:db/id 17592186379595 :question/worked-solution "If $F(x)$ is defined on $x\\in [0,12),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,12), \\\\ -F(-x), & x\\in (-12,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-12,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{2}-6(-x)) \\\\  & =-({x}^{2}+6x) \\\\  & =-{x}^{2}-6x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-4) & =-(-4)^{2}-6(-4)=8.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-899a46d0-c395-5e11-8fbc-04b90f756929" :question/id #uuid "899a46d0-c395-5e11-8fbc-04b90f756929" :question/math-academy-id "q-341407" :question/problem "Let $F(x)={x}^{3}-2{x}^{2}+8$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{3}-2(-x)^{2}+8) \\\\  & =-(-{x}^{3}-2{x}^{2}+8) \\\\  & ={x}^{3}+2{x}^{2}-8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-149df211-1ed2-522f-a2c8-98bc68e1b2c6"] :db/ensure [:question/validate]} {:db/id "answer-field-149df211-1ed2-522f-a2c8-98bc68e1b2c6" :answer-field/id #uuid "149df211-1ed2-522f-a2c8-98bc68e1b2c6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ef3b5131-7b3a-5bc8-9252-83975f1ec410" :answer-field/choices ["answer-abed5605-656d-5242-a084-ad7f11b0d696" "answer-ef3b5131-7b3a-5bc8-9252-83975f1ec410" "answer-6bd683e8-a847-5e05-99c1-b681ee2fc285" "answer-a982a159-987e-5602-86d9-3a2e2fddf4d6" "answer-7027ff52-37a6-5339-8ae8-c81614622435"] :db/ensure [:answer-field/validate]} {:db/id "answer-abed5605-656d-5242-a084-ad7f11b0d696" :answer/id #uuid "abed5605-656d-5242-a084-ad7f11b0d696" :answer/type :answer.type/math :answer/value "-{x}^{3}-2{x}^{2}+8" :db/ensure [:answer/validate]} {:db/id "answer-ef3b5131-7b3a-5bc8-9252-83975f1ec410" :answer/id #uuid "ef3b5131-7b3a-5bc8-9252-83975f1ec410" :answer/type :answer.type/math :answer/value "{x}^{3}+2{x}^{2}-8" :db/ensure [:answer/validate]} {:db/id "answer-6bd683e8-a847-5e05-99c1-b681ee2fc285" :answer/id #uuid "6bd683e8-a847-5e05-99c1-b681ee2fc285" :answer/type :answer.type/math :answer/value "{x}^{3}-2{x}^{2}+8" :db/ensure [:answer/validate]} {:db/id "answer-a982a159-987e-5602-86d9-3a2e2fddf4d6" :answer/id #uuid "a982a159-987e-5602-86d9-3a2e2fddf4d6" :answer/type :answer.type/math :answer/value "|-{x}^{3}-2{x}^{2}|" :db/ensure [:answer/validate]} {:db/id "answer-7027ff52-37a6-5339-8ae8-c81614622435" :answer/id #uuid "7027ff52-37a6-5339-8ae8-c81614622435" :answer/type :answer.type/math :answer/value "|x{|}^{3}+2|x{|}^{2}" :db/ensure [:answer/validate]} {:db/id "activity-efb42fa9-f683-5c06-ac0c-717cbb8d0615" :activity/id #uuid "efb42fa9-f683-5c06-ac0c-717cbb8d0615" :activity/title "Fourier Sine Series" :activity/type :activity.type/review :activity/scope 17592186048833 :activity/course 17592186046645 :activity/steps ["step-39da7f89-1eb5-57a1-96ef-3e5ae3c5298e" "step-745e2678-3dfd-5d17-a3ad-6185ef0d904f" "step-0e3afe28-7b8e-5c73-9d90-38ba90dbb6e5" "step-bebe94fc-0239-52b8-b44d-7f460d1d5644" "step-de01dadb-e088-5a80-88fd-7569dc237f04"] :activity/first-step "step-39da7f89-1eb5-57a1-96ef-3e5ae3c5298e" :db/ensure [:activity/validate]} {:db/id "step-39da7f89-1eb5-57a1-96ef-3e5ae3c5298e" :step/id #uuid "39da7f89-1eb5-57a1-96ef-3e5ae3c5298e" :step/content 17592186167270 :step/next "step-745e2678-3dfd-5d17-a3ad-6185ef0d904f" :db/ensure [:step/validate]} {:db/id "step-745e2678-3dfd-5d17-a3ad-6185ef0d904f" :step/id #uuid "745e2678-3dfd-5d17-a3ad-6185ef0d904f" :step/content 17592186315033 :step/next "step-0e3afe28-7b8e-5c73-9d90-38ba90dbb6e5" :db/ensure [:step/validate]} {:db/id "step-0e3afe28-7b8e-5c73-9d90-38ba90dbb6e5" :step/id #uuid "0e3afe28-7b8e-5c73-9d90-38ba90dbb6e5" :step/content 17592186379595 :step/next "step-bebe94fc-0239-52b8-b44d-7f460d1d5644" :db/ensure [:step/validate]} {:db/id "step-bebe94fc-0239-52b8-b44d-7f460d1d5644" :step/id #uuid "bebe94fc-0239-52b8-b44d-7f460d1d5644" :step/content 17592186315083 :step/next "step-de01dadb-e088-5a80-88fd-7569dc237f04" :db/ensure [:step/validate]} {:db/id "step-de01dadb-e088-5a80-88fd-7569dc237f04" :step/id #uuid "de01dadb-e088-5a80-88fd-7569dc237f04" :step/content "question-899a46d0-c395-5e11-8fbc-04b90f756929" :db/ensure [:step/validate]} {:db/id 17592186078398 :knowledge-point/questions ["question-4bfcc405-f2a2-5e8e-bff5-6d6acca08903" "question-de4398c2-dc93-57fc-955e-876f667d9e66"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078264 :question/problem "Find $\\csc\\theta,$ $\\sec\\theta,$ and $\\cot\\theta$ for the triangle below.\n\n![](images/34/343917ea041d51cac38619f3577765eee7fbc3ea85e175148b6c591e11ae230b.png)" :question/worked-solution "We compute the three reciprocal trigonometric ratios as follows:\n\n$$\n\\eqalign{\n\t\t\\csc\\theta &= \\dfrac{1}{\\sin\\theta} = \\dfrac {\\text{hypotenuse}} {\\text{opposite}} = \\dfrac 5 3, \\[5pt]\n\t\t\\sec\\theta &= \\dfrac{1}{\\cos\\theta} =  \\dfrac {\\text{hypotenuse}} {\\text{adjacent}} = \\dfrac 5 4, \\[5pt]\n\t\t\\cot\\theta &= \\dfrac{1}{\\tan\\theta} = \\dfrac {\\text{adjacent}} {\\text{opposite}} = \\dfrac 4 3.\n\t}\n$$" :db/ensure [:question/validate]} {:db/id 17592186078399 :knowledge-point/questions ["question-789a361b-1deb-51ca-88a0-26707116d922" "question-9728a2a0-30c7-53d5-836b-39033ca5b896"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186078265 :question/worked-solution "Remember that $\\sec$ is the reciprocal of $\\cos.$ So first we need to compute cosine:\n\n$$\n\\cos L = \\dfrac{\\text{adjacent}}{\\text{hypotenuse}} = \\dfrac{JL}{KL} = \\dfrac{JL}{5}\n$$\n\nTo find the length $JL,$ we can use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}JL & =\\sqrt{K{L}^{2}-J{K}^{2}} \\\\  & =\\sqrt{{5}^{2}-{3}^{2}} \\\\  & =\\sqrt{25-9} \\\\  & =\\sqrt{16} \\\\  & =4\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\cos L = \\dfrac{JL}{5} = \\dfrac{4}{5},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡L & ={(\\frac{4}{5})}^{-1}=\\frac{5}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "question-4bfcc405-f2a2-5e8e-bff5-6d6acca08903" :question/id #uuid "4bfcc405-f2a2-5e8e-bff5-6d6acca08903" :question/math-academy-id "q-25070" :question/problem "![](images/6e/6eda76bbacb2cbebfe9a798b957c013dc34f684b4d866488541af759b25972b7.png)\n\n$\\operatorname{cot}⁡D=$" :question/worked-solution "We compute the cotangent of the angle $D$ as follows:\n\n$$\n\\operatorname{cot}⁡D=\\frac{\\text{adjacent}}{\\text{opposite}}=\\frac{15}{112}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-12f70ae7-825b-51a0-9a22-13ca854d1af0"] :db/ensure [:question/validate]} {:db/id "answer-field-12f70ae7-825b-51a0-9a22-13ca854d1af0" :answer-field/id #uuid "12f70ae7-825b-51a0-9a22-13ca854d1af0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b523e18b-4f49-563f-b5f9-5857eb37fb10" :answer-field/choices ["answer-a41e199f-ca14-5113-b9c2-b8e50141ee9f" "answer-a7962394-8ee4-5282-84a9-dbe8bf1bb6f8" "answer-115431ac-729e-5559-8a56-b1f21dcbb60c" "answer-b523e18b-4f49-563f-b5f9-5857eb37fb10" "answer-01908de7-7512-523d-ba70-c9c1a7ef7124"] :db/ensure [:answer-field/validate]} {:db/id "answer-a41e199f-ca14-5113-b9c2-b8e50141ee9f" :answer/id #uuid "a41e199f-ca14-5113-b9c2-b8e50141ee9f" :answer/type :answer.type/math :answer/value "\\frac{112}{113}" :db/ensure [:answer/validate]} {:db/id "answer-a7962394-8ee4-5282-84a9-dbe8bf1bb6f8" :answer/id #uuid "a7962394-8ee4-5282-84a9-dbe8bf1bb6f8" :answer/type :answer.type/math :answer/value "\\frac{112}{15}" :db/ensure [:answer/validate]} {:db/id "answer-115431ac-729e-5559-8a56-b1f21dcbb60c" :answer/id #uuid "115431ac-729e-5559-8a56-b1f21dcbb60c" :answer/type :answer.type/math :answer/value "\\frac{113}{112}" :db/ensure [:answer/validate]} {:db/id "answer-b523e18b-4f49-563f-b5f9-5857eb37fb10" :answer/id #uuid "b523e18b-4f49-563f-b5f9-5857eb37fb10" :answer/type :answer.type/math :answer/value "\\frac{15}{112}" :db/ensure [:answer/validate]} {:db/id "answer-01908de7-7512-523d-ba70-c9c1a7ef7124" :answer/id #uuid "01908de7-7512-523d-ba70-c9c1a7ef7124" :answer/type :answer.type/math :answer/value "\\frac{15}{113}" :db/ensure [:answer/validate]} {:db/id "question-de4398c2-dc93-57fc-955e-876f667d9e66" :question/id #uuid "de4398c2-dc93-57fc-955e-876f667d9e66" :question/math-academy-id "q-4650" :question/problem "![](images/7f/7f566dccaab9ea71af6fa627ce53bd400e97735d5b8c7500d63fddfdf2e7a8db.png)\n\n$\\operatorname{sec}⁡R=$" :question/worked-solution "We compute the secant of the angle $R$ as follows:\n\n$$\n\\operatorname{sec}⁡R=\\frac{\\text{hypotenuse}}{\\text{adjacent}}=\\frac{10}{6}=\\frac{5}{3}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-024c165a-c9fd-50e0-9cfb-6a88ae65e64f"] :db/ensure [:question/validate]} {:db/id "answer-field-024c165a-c9fd-50e0-9cfb-6a88ae65e64f" :answer-field/id #uuid "024c165a-c9fd-50e0-9cfb-6a88ae65e64f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-18751d4d-66c7-55dd-ab9d-0457e8043e97" :answer-field/choices ["answer-710fafca-d907-583c-aeec-b6987c81b2bb" "answer-4d9fcc09-b9d2-53dc-ba2d-c997dd3c5612" "answer-efa0d994-cbc3-50ba-9bbb-a1a4704fc3ed" "answer-6f61adb7-252c-5012-8cfe-25791dae6092" "answer-18751d4d-66c7-55dd-ab9d-0457e8043e97"] :db/ensure [:answer-field/validate]} {:db/id "answer-710fafca-d907-583c-aeec-b6987c81b2bb" :answer/id #uuid "710fafca-d907-583c-aeec-b6987c81b2bb" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-4d9fcc09-b9d2-53dc-ba2d-c997dd3c5612" :answer/id #uuid "4d9fcc09-b9d2-53dc-ba2d-c997dd3c5612" :answer/type :answer.type/math :answer/value "\\frac{3}{5}" :db/ensure [:answer/validate]} {:db/id "answer-efa0d994-cbc3-50ba-9bbb-a1a4704fc3ed" :answer/id #uuid "efa0d994-cbc3-50ba-9bbb-a1a4704fc3ed" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-6f61adb7-252c-5012-8cfe-25791dae6092" :answer/id #uuid "6f61adb7-252c-5012-8cfe-25791dae6092" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "answer-18751d4d-66c7-55dd-ab9d-0457e8043e97" :answer/id #uuid "18751d4d-66c7-55dd-ab9d-0457e8043e97" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "question-789a361b-1deb-51ca-88a0-26707116d922" :question/id #uuid "789a361b-1deb-51ca-88a0-26707116d922" :question/math-academy-id "q-65381" :question/problem "![](images/e9/e980e9415d52338c90eb5c167a32b02815237b1554f9aea06f831e88db6f3777.png)\n\n$\\operatorname{cot}⁡\\theta =$" :question/worked-solution "Remember that $cot$ is the reciprocal of $tan.$ So first we need to compute tangent:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta =\\frac{\\text{opposite}}{\\text{adjacent}}=\\frac{PR}{QR}=\\frac{3}{QR}\\end{aligned}\n$$\n\nTo find the length $QR,$ we can use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}QR & =\\sqrt{P{Q}^{2}-P{R}^{2}} \\\\  & =\\sqrt{(3\\sqrt{5})^{2}-{3}^{2}} \\\\  & =\\sqrt{45-9} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta =\\frac{3}{6}=\\frac{1}{2},\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\operatorname{cot}⁡\\theta ={(\\frac{1}{2})}^{-1}=2.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-db152ebb-c302-5112-8c45-9948cd14ca8b"] :db/ensure [:question/validate]} {:db/id "answer-field-db152ebb-c302-5112-8c45-9948cd14ca8b" :answer-field/id #uuid "db152ebb-c302-5112-8c45-9948cd14ca8b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-58e41124-d27e-5bf8-a849-55991f19b628" :answer-field/choices ["answer-58e41124-d27e-5bf8-a849-55991f19b628" "answer-bd65e325-f1b8-5c87-9662-6c18254e66f1" "answer-fadee215-c360-5052-9061-2ac46dc7f6ab" "answer-b1098335-0f3d-532a-9ba1-59d86a55f4e4" "answer-f74d244e-220f-5aa8-ba66-446e22db924d"] :db/ensure [:answer-field/validate]} {:db/id "answer-58e41124-d27e-5bf8-a849-55991f19b628" :answer/id #uuid "58e41124-d27e-5bf8-a849-55991f19b628" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-bd65e325-f1b8-5c87-9662-6c18254e66f1" :answer/id #uuid "bd65e325-f1b8-5c87-9662-6c18254e66f1" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-fadee215-c360-5052-9061-2ac46dc7f6ab" :answer/id #uuid "fadee215-c360-5052-9061-2ac46dc7f6ab" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-b1098335-0f3d-532a-9ba1-59d86a55f4e4" :answer/id #uuid "b1098335-0f3d-532a-9ba1-59d86a55f4e4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}" :db/ensure [:answer/validate]} {:db/id "answer-f74d244e-220f-5aa8-ba66-446e22db924d" :answer/id #uuid "f74d244e-220f-5aa8-ba66-446e22db924d" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "question-9728a2a0-30c7-53d5-836b-39033ca5b896" :question/id #uuid "9728a2a0-30c7-53d5-836b-39033ca5b896" :question/math-academy-id "q-122902" :question/problem "![](images/a9/a9003434f721485b5ee3eb2ed417d0c4c68514b98060f6149bc974270e55411a.png)\n\n$\\operatorname{csc}⁡P=$" :question/worked-solution "Remember that $csc$ is the reciprocal of $sin.$ So first we need to compute sine:\n\n$$\n\\operatorname{sin}⁡P=\\frac{\\text{opposite}}{\\text{hypotenuse}}=\\frac{QR}{PR}=\\frac{QR}{15}\n$$\n\nTo find the length $QR,$ we can use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}QR & =\\sqrt{P{R}^{2}-P{Q}^{2}} \\\\  & =\\sqrt{{15}^{2}-{9}^{2}} \\\\  & =\\sqrt{225-81} \\\\  & =\\sqrt{144} \\\\  & =12\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\operatorname{sin}⁡P=\\frac{QR}{15}=\\frac{12}{15}=\\frac{4}{5},\n$$\n\nand therefore\n\n$$\n\\operatorname{csc}⁡P={(\\frac{4}{5})}^{-1}=\\frac{5}{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-42169019-4c90-5f92-9ed4-0e9272ff36d7"] :db/ensure [:question/validate]} {:db/id "answer-field-42169019-4c90-5f92-9ed4-0e9272ff36d7" :answer-field/id #uuid "42169019-4c90-5f92-9ed4-0e9272ff36d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9579f35d-0a62-56c0-87be-1dce6c45f688" :answer-field/choices ["answer-fdf065d6-21d7-507f-b607-cc7b49b70a85" "answer-38ae8a7e-8879-58a2-b77d-2f1efa7ea909" "answer-9579f35d-0a62-56c0-87be-1dce6c45f688" "answer-1f66b5f8-e76f-5f77-8f96-098a448df87a" "answer-22e0ee74-658c-52fe-a2b1-2df54d380881"] :db/ensure [:answer-field/validate]} {:db/id "answer-fdf065d6-21d7-507f-b607-cc7b49b70a85" :answer/id #uuid "fdf065d6-21d7-507f-b607-cc7b49b70a85" :answer/type :answer.type/math :answer/value "\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "answer-38ae8a7e-8879-58a2-b77d-2f1efa7ea909" :answer/id #uuid "38ae8a7e-8879-58a2-b77d-2f1efa7ea909" :answer/type :answer.type/math :answer/value "\\frac{15}{7}" :db/ensure [:answer/validate]} {:db/id "answer-9579f35d-0a62-56c0-87be-1dce6c45f688" :answer/id #uuid "9579f35d-0a62-56c0-87be-1dce6c45f688" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "answer-1f66b5f8-e76f-5f77-8f96-098a448df87a" :answer/id #uuid "1f66b5f8-e76f-5f77-8f96-098a448df87a" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id "answer-22e0ee74-658c-52fe-a2b1-2df54d380881" :answer/id #uuid "22e0ee74-658c-52fe-a2b1-2df54d380881" :answer/type :answer.type/math :answer/value "\\frac{9}{5}" :db/ensure [:answer/validate]} {:db/id 17592186079643 :tutorial/content "The reciprocals of sine, cosine, and tangent are given special names:\n\n- The reciprocal of **sine** is **cosecant**, abbreviated $\\csc.$\n\n$$\n\\csc(\\theta) = \\dfrac 1 {\\sin(\\theta)} = \\dfrac 1 {\\dfrac {\\text{opposite}} {\\text{hypotenuse}}} = \\dfrac {\\text{hypotenuse}} {\\text{opposite}}\n$$\n\n- The reciprocal of **cosine** is **secant**, abbreviated $\\sec.$\n\n$$\n\\sec (\\theta) = \\dfrac 1 {\\cos(\\theta)} = \\dfrac 1 {\\dfrac {\\text{adjacent}} {\\text{hypotenuse}}} = \\dfrac {\\text{hypotenuse}} {\\text{adjacent}}\n$$\n\n- The reciprocal of **tangent** is **cotangent**, abbreviated $\\cot.$\n\n$$\n\\cot (\\theta) = \\dfrac 1 {\\tan(\\theta)} = \\dfrac 1 {\\dfrac {\\text{opposite}} {\\text{adjacent}}} = \\dfrac {\\text{adjacent}} {\\text{opposite}}\n$$\n\nLet's write down expressions for $\\csc(B),$ $\\sec(B),$ and $\\cot(B)$ for the triangle below.\n\n![](images/e9/e98dcc332739ff381e8dc43160a907e471062c5b8a75567ba7dbb8687c008efa.png)\n\n$$\n\\eqalign{\n\t\t\\csc(B) &= \\dfrac {\\text{hypotenuse}} {\\text{opposite}} = \\dfrac c b \\[5pt]\n\t\t\\sec(B) &= \\dfrac {\\text{hypotenuse}} {\\text{adjacent}} = \\dfrac c a \\[5pt]\n\t\t\\cot(B) &= \\dfrac {\\text{adjacent}} {\\text{opposite}} = \\dfrac a b \\\n\t}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186079644 :tutorial/content "If we are given two sides of a right triangle, how can we calculate the reciprocal ratios $\\sec,$ $\\csc,$ or $\\cot$ when we are missing one of the necessary sides in the ratio?\n\nThe trick here is the same that we use for finding $\\sin,$ $\\cos,$ or $\\tan\\mathbin{:}$ we use the Pythagorean theorem for finding the missing side.\n\nTo illustrate, let's calculate $\\csc L$  in the triangle below. \n\n![](images/9f/9f2e4ea4922783c84a6cb59c5e1532b726d46c9a837a5b1eaa203bbdc6cc1741.png)\n\nRemember that $\\csc$ is the reciprocal of $\\sin.$ So first we need to compute sine:\n\n$$\n\\sin L = \\dfrac{\\text{opposite}}{\\text{hypotenuse}} = \\dfrac{JK}{KL} = \\dfrac{JK}{4}\n$$\n\nTo find the length $JK,$ we can use the Pythagorean Theorem:\n\n$$\n\\begin{aligned}JK & =\\sqrt{K{L}^{2}-J{L}^{2}} \\\\  & =\\sqrt{{4}^{2}-{3}^{2}} \\\\  & =\\sqrt{16-9} \\\\  & =\\sqrt{7}\\end{aligned}\n$$\n\nSo we have\n\n$$\n\\sin L = \\dfrac{JK}{4} = \\dfrac{ \\sqrt{7} }{4},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡L & ={(\\frac{\\sqrt{7}}{4})}^{-1} \\\\  & =\\frac{4}{\\sqrt{7}} \\\\  & =\\frac{4\\cdot \\sqrt{7}}{\\sqrt{7}\\cdot \\sqrt{7}} \\\\  & =\\frac{4\\sqrt{7}}{7}.\\end{aligned}\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186078641 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186060376 :question/problem "Solve the equation $\\frac{2}{3x+2}=-\\frac{4}{x}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{2}{3}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{3x+2}{2}=-\\frac{x}{4}\n$$\n\nNext, we write both fractions using the least common denominator $4,$ as follows:\n\n$$\n\\frac{6x+4}{4}=-\\frac{x}{4}\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}4\\cdot \\frac{6x+4}{4} & =4\\cdot (-\\frac{x}{4}) \\\\ 6x+4 & =-x \\\\ 6x+x & =-4 \\\\ x & =-\\frac{4}{7}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186058878 :answer-field/correct 17592186058882 :db/ensure [:answer-field/validate]} {:db/id 17592186059707 :knowledge-point/questions ["question-9929bc33-2631-5ab2-871b-80ee305fc700"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9929bc33-2631-5ab2-871b-80ee305fc700" :question/id #uuid "9929bc33-2631-5ab2-871b-80ee305fc700" :question/math-academy-id "q-67413" :question/problem "Solve the equation $\\frac{1}{x+5}=\\frac{1}{3}.$" :question/worked-solution "First, we note that $x=-5$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x+5}{1}=\\frac{3}{1}\n$$\n\nThe above equation simplifies to\n\n$$\nx+5=3\n$$\n\nWe can now solve this equation using the addition principle:\n\n$$\n\\begin{aligned}x+5 & =3 \\\\ x+5-5 & =3-5 \\\\ x & =-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d7cb7b4d-8e3a-52e0-b39c-57977a95c75f"] :db/ensure [:question/validate]} {:db/id "answer-field-d7cb7b4d-8e3a-52e0-b39c-57977a95c75f" :answer-field/id #uuid "d7cb7b4d-8e3a-52e0-b39c-57977a95c75f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6c5af59e-eefa-5320-9d2c-7a4fb55193a3" :answer-field/choices ["answer-6c5af59e-eefa-5320-9d2c-7a4fb55193a3" "answer-30e054d1-ef35-5151-b5a6-95077b0323c2" "answer-b4e754c7-eafd-5c39-98a7-4f2732e90d24" "answer-a816dc9c-912f-5b96-8ae4-1b55000c74ac" "answer-5deed0da-0520-5246-8e6c-365d802468b5"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c5af59e-eefa-5320-9d2c-7a4fb55193a3" :answer/id #uuid "6c5af59e-eefa-5320-9d2c-7a4fb55193a3" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-30e054d1-ef35-5151-b5a6-95077b0323c2" :answer/id #uuid "30e054d1-ef35-5151-b5a6-95077b0323c2" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-b4e754c7-eafd-5c39-98a7-4f2732e90d24" :answer/id #uuid "b4e754c7-eafd-5c39-98a7-4f2732e90d24" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-a816dc9c-912f-5b96-8ae4-1b55000c74ac" :answer/id #uuid "a816dc9c-912f-5b96-8ae4-1b55000c74ac" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-5deed0da-0520-5246-8e6c-365d802468b5" :answer/id #uuid "5deed0da-0520-5246-8e6c-365d802468b5" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id 17592186059709 :knowledge-point/questions ["question-dba16e2f-f755-5c6f-b25b-801d348b9282"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dba16e2f-f755-5c6f-b25b-801d348b9282" :question/id #uuid "dba16e2f-f755-5c6f-b25b-801d348b9282" :question/math-academy-id "q-67435" :question/problem "Solve the equation $-\\frac{4}{x-2}=\\frac{1}{x-1}.$" :question/worked-solution "First, we note that\n\n- $x=2$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{x-2}{4}=\\frac{x-1}{1}\n$$\n\nNext, we write both fractions using the least common denominator, $4.$ The equation becomes\n\n$$\n-\\frac{x-2}{4}=\\frac{4x-4}{4}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(-4)\\cdot (\\frac{x-2}{-4}) & =(-4)\\cdot \\frac{4x-4}{4} \\\\ x-2 & =-4x+4 \\\\ x+4x & =4+2 \\\\ 5x & =6 \\\\ (\\frac{1}{5})\\cdot (5x) & =(\\frac{1}{5})\\cdot (6) \\\\ (\\cancel{\\frac{1}{5}})\\cdot (\\cancel{5}x) & =(\\frac{1}{5})\\cdot (6) \\\\ x & =\\frac{6}{5}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-746714c2-cc0f-5a43-9606-b934d8793273"] :db/ensure [:question/validate]} {:db/id "answer-field-746714c2-cc0f-5a43-9606-b934d8793273" :answer-field/id #uuid "746714c2-cc0f-5a43-9606-b934d8793273" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f71975b1-e674-5e94-a227-f47c16e02797" :answer-field/choices ["answer-1d56b3b6-d2ee-5a6a-ac79-f166c602aad7" "answer-684d8919-d630-53ec-be88-da83985b9cfc" "answer-5bbc6a18-26ef-5ee7-a216-046a93109cdd" "answer-adf72623-7732-5460-b0b6-5cc1011adb27" "answer-f71975b1-e674-5e94-a227-f47c16e02797"] :db/ensure [:answer-field/validate]} {:db/id "answer-1d56b3b6-d2ee-5a6a-ac79-f166c602aad7" :answer/id #uuid "1d56b3b6-d2ee-5a6a-ac79-f166c602aad7" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "answer-684d8919-d630-53ec-be88-da83985b9cfc" :answer/id #uuid "684d8919-d630-53ec-be88-da83985b9cfc" :answer/type :answer.type/math :answer/value "-\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "answer-5bbc6a18-26ef-5ee7-a216-046a93109cdd" :answer/id #uuid "5bbc6a18-26ef-5ee7-a216-046a93109cdd" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "answer-adf72623-7732-5460-b0b6-5cc1011adb27" :answer/id #uuid "adf72623-7732-5460-b0b6-5cc1011adb27" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "answer-f71975b1-e674-5e94-a227-f47c16e02797" :answer/id #uuid "f71975b1-e674-5e94-a227-f47c16e02797" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "activity-1c136286-07e7-54b0-87c2-d0c00e24e994" :activity/id #uuid "1c136286-07e7-54b0-87c2-d0c00e24e994" :activity/title "Solving Rational Equations Using the Flip Method" :activity/type :activity.type/review :activity/scope 17592186050953 :activity/course 17592186046647 :activity/steps ["step-04bd31c0-ddc2-5b9c-ad07-d73251e35927" "step-5a1efe66-123d-5aba-9cc1-514789a8cab9" "step-128aaed4-1578-549e-bc3a-0ca44706efdb"] :activity/first-step "step-04bd31c0-ddc2-5b9c-ad07-d73251e35927" :db/ensure [:activity/validate]} {:db/id "step-04bd31c0-ddc2-5b9c-ad07-d73251e35927" :step/id #uuid "04bd31c0-ddc2-5b9c-ad07-d73251e35927" :step/content 17592186060376 :step/next "step-5a1efe66-123d-5aba-9cc1-514789a8cab9" :db/ensure [:step/validate]} {:db/id "step-5a1efe66-123d-5aba-9cc1-514789a8cab9" :step/id #uuid "5a1efe66-123d-5aba-9cc1-514789a8cab9" :step/content "question-9929bc33-2631-5ab2-871b-80ee305fc700" :step/next "step-128aaed4-1578-549e-bc3a-0ca44706efdb" :db/ensure [:step/validate]} {:db/id "step-128aaed4-1578-549e-bc3a-0ca44706efdb" :step/id #uuid "128aaed4-1578-549e-bc3a-0ca44706efdb" :step/content "question-dba16e2f-f755-5c6f-b25b-801d348b9282" :db/ensure [:step/validate]} [:db/retract 17592186174130 :answer-field/choices 17592186174131] [:db/retract 17592186174130 :answer-field/choices 17592186174132] [:db/retract 17592186174130 :answer-field/choices 17592186174133] [:db/retract 17592186174130 :answer-field/choices 17592186174134] [:db/retract 17592186174130 :answer-field/choices 17592186174135] {:db/id 17592186416111 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}y(x-1)\\,dx+x(y-1)\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/b9/b95320928a5e7482f9ba2b8bb1d1499950710545b4c7273b7f70dfe5ab8c84b8.png)\n\nSince $P(x,y)=y(x-1)$ and $Q(x,y)=x(y-1),$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=x-1,\\,\\frac{∂Q}{∂x}=y-1.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}y(x-1)\\,dx+x(y-1)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}((y-1)-(x-1))\\,\\text{d}A \\\\  & ={∬}_{D}(y-x)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 4,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(y-x)\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta -r\\operatorname{cos}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{\\int }_{0}^{4}{r}^{2}(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186176485 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/45/459a51f3c408a9c647b3be6b978267a6ce724e747118fbe897275c370d2bb6d6.png)\n\nSince $P(x,y)={y}^{2}$ and $Q(x,y)=x,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=1.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}{y}^{2}\\,dx+x\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(1-2y)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(1-2y)\\,\\text{d}A & ={∬}_{Δ}(1-2\\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{\\int }_{0}^{1}r-2{r}^{2}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186387706 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}F\\cdot dr={∮}_{C}({e}^{x/4}+x{y}^{2})\\,dx+({e}^{\\operatorname{sin}⁡y}+2x)\\,dy.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/c4/c40d9fdfd10b3be4153c9c8ea3a6302af3cf0392533767313c467bdf7dcec1d7.png)\n\nSince $P(x,y)={e}^{x/4}+x{y}^{2}$ and $Q(x,y)={e}^{\\operatorname{sin}⁡y}+2x,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2xy,\\,\\frac{∂Q}{∂x}=2.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x/4}+x{y}^{2})\\,dx+({e}^{\\operatorname{sin}⁡y}+2x)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2-2xy)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 4,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(2-2xy)\\,\\text{d}A & ={∬}_{Δ}(2-2\\cdot r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}\\,{\\int }_{0}^{4}(2r-{r}^{3}\\operatorname{sin}⁡(2\\theta ))\\,dr\\,d\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186387685 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/9e/9eceb8ab173995a8325fb1a8452baaa7f1071e569391e9a49b69c047d76f3b52.png)\n\nSince $P(x,y)=\\operatorname{sin}⁡(\\operatorname{cos}⁡x)-{x}^{2}y$ and $Q(x,y)=x{y}^{2}-\\frac{1}{y+1},$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-{x}^{2},\\,\\frac{∂Q}{∂x}={y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\operatorname{sin}⁡(\\operatorname{cos}⁡x)-{x}^{2}y)\\,dx+(x{y}^{2}-\\frac{1}{y+1})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}({y}^{2}-(-{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le \\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\,{\\int }_{0}^{3}{r}^{3}\\,dr\\,d\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id 17592186176312 :question/problem "![](images/66/66ab1a3e2e7244a9b3e5fc9bda814736194c28dd9438fbb97086e99be4633261.png)\n\nEvaluate ${∮}_{C}(\\sqrt{x}-4{x}^{2}y)dx+({e}^{y}+4x{y}^{2})\\,dy,$ where the path $C$ is shown above." :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/70/709d108b2b992d1714c7c0b3bef26f52e965c2467f38d05103cd45f4f9bc821b.png)\n\nNow, since \n\n$$\nP(x,y)=\\sqrt{x}-4{x}^{2}y,\\,Q(x,y)={e}^{y}+4x{y}^{2},\n$$\n\n \n\nwe obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-4{x}^{2},\\,\\frac{∂Q}{∂x}=4{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\sqrt{x}-4{x}^{2}y)dx+({e}^{y}+4x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(4{y}^{2}-(-4{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}4({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\frac{\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}{∬}_{D}4({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}4({r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{3}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}4{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}[{r}^{4}]_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}16\\,\\text{d}\\theta  \\\\  & =16[\\theta ]_{0}^{\\pi /2} \\\\  & =16\\cdot \\frac{\\pi }{2} \\\\  & =8\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186174130 :answer-field/correct "answer-c56b99d4-e511-50b9-9301-30b784d9db25" :answer-field/choices ["answer-21230e40-c778-5976-8975-77b9141fa55d" "answer-8a7d42e8-02bc-575f-bdc0-3241bc078dad" "answer-82f5e165-d4c5-5f87-9f4c-f1a35e90641d" "answer-eae586ab-e6cd-5a7e-8c86-9db144eadecc" "answer-c56b99d4-e511-50b9-9301-30b784d9db25"] :db/ensure [:answer-field/validate]} {:db/id "answer-21230e40-c778-5976-8975-77b9141fa55d" :answer/id #uuid "21230e40-c778-5976-8975-77b9141fa55d" :answer/type :answer.type/math :answer/value "-4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-8a7d42e8-02bc-575f-bdc0-3241bc078dad" :answer/id #uuid "8a7d42e8-02bc-575f-bdc0-3241bc078dad" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-82f5e165-d4c5-5f87-9f4c-f1a35e90641d" :answer/id #uuid "82f5e165-d4c5-5f87-9f4c-f1a35e90641d" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "answer-eae586ab-e6cd-5a7e-8c86-9db144eadecc" :answer/id #uuid "eae586ab-e6cd-5a7e-8c86-9db144eadecc" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "answer-c56b99d4-e511-50b9-9301-30b784d9db25" :answer/id #uuid "c56b99d4-e511-50b9-9301-30b784d9db25" :answer/type :answer.type/math :answer/value "8\\pi " :db/ensure [:answer/validate]} [:db/retract 17592186116567 :answer-field/choices 17592186116568] [:db/retract 17592186116567 :answer-field/choices 17592186116569] [:db/retract 17592186116567 :answer-field/choices 17592186116570] [:db/retract 17592186116567 :answer-field/choices 17592186116571] [:db/retract 17592186116567 :answer-field/choices 17592186116572] [:db/retract 17592186117205 :answer-field/choices 17592186117206] [:db/retract 17592186117205 :answer-field/choices 17592186117207] [:db/retract 17592186117205 :answer-field/choices 17592186117208] [:db/retract 17592186117205 :answer-field/choices 17592186117209] [:db/retract 17592186117205 :answer-field/choices 17592186117210] {:db/id 17592186119890 :knowledge-point/questions ["question-76532f80-93cf-5f33-8bd0-322c7a249f9a" "question-3d05a680-5939-5ca9-9607-1df6158bf7b7" "question-1e1eb62e-08d0-56cd-999d-56094605f117" "question-bc3873ba-541e-5572-9cfe-0e10d2402ed6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119710 :question/problem "What is the volume of a rectangular solid that has length, width, and height of $5 \\: \\textrm{m},$ $\\sqrt3 \\: \\textrm{m},$ and $\\sqrt6 \\: \\textrm{m},$ respectively?" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV = lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=5 \\, \\textrm{m}, \\qquad w=\\sqrt3 \\, \\textrm{m}, \\qquad h=\\sqrt6 \\, \\textrm{m}\n$$\n\ninto the formula, we obtain\n\n$$\nV = 5 \\cdot \\sqrt3 \\cdot \\sqrt6 = 5\\sqrt{18} = 15\\sqrt2 \\: \\textrm{m}^3.\n$$" :db/ensure [:question/validate]} {:db/id 17592186119891 :knowledge-point/questions ["question-78b1f6d8-2df3-5686-9ee0-696c5e38afe8" "question-91cc3a07-1501-5243-8832-8d928c7de8f2" "question-90da9001-fcc8-57a5-93d8-6080245acd79"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119711 :question/problem "Determine the height of the rectangular solid below given that its volume is $700\\:\\textrm{cm}^3.$\n\n![](images/8a/8a232f69c9c6abbffcb2272d4fbd237c644273826fb46dd5742bdc07d89544cb.png)" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV = lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting\n\n$$\nV = 700, \\qquad l=14, \\qquad w=10\n$$\n\ninto the formula, we obtain the following:\n\n$$\n\\begin{aligned}700 & =14\\cdot 10\\cdot h \\\\ 700 & =140h \\\\ h & =5\\end{aligned}\n$$\n\nTherefore, the height is $5\\:\\textrm{cm}.$" :db/ensure [:question/validate]} {:db/id 17592186119892 :knowledge-point/questions ["question-90edfdf5-24c3-54cd-8862-63c978f95f47" "question-e195bf20-65ce-5bd5-85a8-c18879f5cecb" "question-014f97dd-12f1-54e9-8347-3c53a77026ab" "question-3e2801a7-e084-5269-a941-751cceb06faf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186119712 :question/worked-solution "The orange juice in the carton creates a cube. Since the height of the juice is $9\\,\\textrm{cm},$ the side length of the cube is also $9\\,\\textrm{cm}.$\n\nThe height of $9 \\: \\textrm{cm}$ shown in the diagram represents a third of the carton's height. Therefore, the height of the carton is\n\n$$\n3 \\cdot 9 = 27 \\: \\textrm{cm}.\n$$\n\nThe empty space in the carton is a rectangular prism that is $9\\:\\textrm{cm}$ long, $9\\:\\textrm{cm}$ wide, and $27 - 9 = 18\\:\\textrm{cm}$ high.\n\nWe can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV = lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=9\\,\\textrm{cm}, \\qquad w=9\\,\\textrm{cm}, \\qquad h=18\\,\\textrm{cm}\n$$\n\ninto the formula, we obtain\n\n$$\nV = 9 \\cdot 9 \\cdot 18 = 1\\,458\\:\\textrm{cm}^3.\n$$\n\nTherefore, we conclude that there is $1\\,458 \\: \\textrm{cm}^3$ of empty space in the carton." :db/ensure [:question/validate]} {:db/id "question-76532f80-93cf-5f33-8bd0-322c7a249f9a" :question/id #uuid "76532f80-93cf-5f33-8bd0-322c7a249f9a" :question/math-academy-id "q-107608" :question/problem "What is the volume of a rectangular solid that has length, width, and height of $9\\,\\text{ft},$ $4\\,\\text{ft},$ and $5\\,\\text{ft},$ respectively?" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=9\\,\\text{ft},\\,w=4\\,\\text{ft},\\,h=5\\,\\text{ft}\n$$\n\ninto the formula, we obtain\n\n$$\nV=9\\cdot 4\\cdot 5=180\\,{\\text{ft}}^{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-c18f462a-b5db-5c5d-ab5e-d0eeb12c1a68"] :db/ensure [:question/validate]} {:db/id "answer-field-c18f462a-b5db-5c5d-ab5e-d0eeb12c1a68" :answer-field/id #uuid "c18f462a-b5db-5c5d-ab5e-d0eeb12c1a68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0921fbe3-4414-5f8b-8d3b-3d693422dd1c" :answer-field/choices ["answer-a80eb636-9dce-59bf-be44-ac4978945529" "answer-36390955-f2de-55de-94fd-d9388e509dd9" "answer-0921fbe3-4414-5f8b-8d3b-3d693422dd1c" "answer-3c739d6e-3d1e-5335-8491-83c575a7a142" "answer-03cbcff4-71e6-56ed-986b-08c5097378da"] :db/ensure [:answer-field/validate]} {:db/id "answer-a80eb636-9dce-59bf-be44-ac4978945529" :answer/id #uuid "a80eb636-9dce-59bf-be44-ac4978945529" :answer/type :answer.type/math :answer/value "120\\sqrt{2}\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-36390955-f2de-55de-94fd-d9388e509dd9" :answer/id #uuid "36390955-f2de-55de-94fd-d9388e509dd9" :answer/type :answer.type/math :answer/value "135\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-0921fbe3-4414-5f8b-8d3b-3d693422dd1c" :answer/id #uuid "0921fbe3-4414-5f8b-8d3b-3d693422dd1c" :answer/type :answer.type/math :answer/value "180\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-3c739d6e-3d1e-5335-8491-83c575a7a142" :answer/id #uuid "3c739d6e-3d1e-5335-8491-83c575a7a142" :answer/type :answer.type/math :answer/value "216\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-03cbcff4-71e6-56ed-986b-08c5097378da" :answer/id #uuid "03cbcff4-71e6-56ed-986b-08c5097378da" :answer/type :answer.type/math :answer/value "36\\sqrt{5}\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "question-3d05a680-5939-5ca9-9607-1df6158bf7b7" :question/id #uuid "3d05a680-5939-5ca9-9607-1df6158bf7b7" :question/math-academy-id "q-107606" :question/problem "What is the volume of a rectangular solid that has length, width, and height of $2\\sqrt{2}\\,\\text{m},$ $4\\,\\text{m},$ and $3\\sqrt{3}\\,\\text{m},$ respectively?" :question/worked-solution "We can find the volume $V$ of the rectangular prism using the formula\n\n$$\nV=lwh,\n$$\n\nwhere $l$ is the length, $w$ is the width, and $h$ is the height of the solid.\n\nSubstituting \n\n$$\nl=2\\sqrt{2}\\,\\text{m},\\,w=4\\,\\text{m},\\,h=3\\sqrt{3}\\,\\text{m}\n$$\n\ninto the formula, we obtain\n\n$$\nV=2\\sqrt{2}\\cdot 4\\cdot 3\\sqrt{3}=24\\sqrt{6}\\,{\\text{m}}^{3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-3ad8f5b3-de32-550c-bc2b-1bd72fc02a0c"] :db/ensure [:question/validate]} {:db/id "answer-field-3ad8f5b3-de32-550c-bc2b-1bd72fc02a0c" :answer-field/id #uuid "3ad8f5b3-de32-550c-bc2b-1bd72fc02a0c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5f2a638-a6db-5c93-b667-0d33daf6af55" :answer-field/choices ["answer-be3f41bd-e03f-5f3c-adf5-43aca87d9777" "answer-fde1b598-50a6-581f-af9e-fe3b828f8b00" "answer-f5f2a638-a6