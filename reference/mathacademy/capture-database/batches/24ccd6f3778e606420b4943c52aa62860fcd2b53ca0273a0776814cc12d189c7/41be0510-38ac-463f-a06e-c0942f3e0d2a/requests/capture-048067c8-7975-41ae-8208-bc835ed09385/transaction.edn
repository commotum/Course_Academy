c56be4962" "question-1b9e5c87-171d-5626-ae59-fa7b69d9a95a"] :db/ensure [:knowledge-point/validate]} {:db/id "question-22016566-6911-5c05-b305-606b27ad2ee0" :question/id #uuid "22016566-6911-5c05-b305-606b27ad2ee0" :question/math-academy-id "q-76584" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\sqrt{3}\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{3}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{3}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{3}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{3}\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}-{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={(\\sqrt{3}\\operatorname{cos}⁡\\theta )}^{2}-{(\\sqrt{3}\\operatorname{sin}⁡\\theta )}^{2} \\\\  & =3{cos}^{2}⁡\\theta -3{sin}^{2}⁡\\theta  \\\\  & =3({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡2\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{3})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\sqrt{3})}^{2}+{0}^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}3\\operatorname{cos}⁡2\\theta \\cdot \\sqrt{3}\\cdot \\text{d}\\theta  \\\\  & =3\\sqrt{3}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-157407e8-4b6e-5f9e-8bc5-3a22df95510b"] :db/ensure [:question/validate]} {:db/id "answer-field-157407e8-4b6e-5f9e-8bc5-3a22df95510b" :answer-field/id #uuid "157407e8-4b6e-5f9e-8bc5-3a22df95510b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d5463613-7aa5-5ac0-8e87-c4d1223952c0" :answer-field/choices ["answer-aac6174e-2cde-5d16-8869-626f99dc3227" "answer-3c0f1a3a-2816-584e-a58f-1a944b890014" "answer-d5463613-7aa5-5ac0-8e87-c4d1223952c0" "answer-65217f58-febb-5f88-af93-f698f3e104ec" "answer-59542311-3beb-5ba9-afe8-6ee4234a603f"] :db/ensure [:answer-field/validate]} {:db/id "answer-aac6174e-2cde-5d16-8869-626f99dc3227" :answer/id #uuid "aac6174e-2cde-5d16-8869-626f99dc3227" :answer/type :answer.type/math :answer/value "2\\sqrt{3}{\\int }_{0}^{\\pi /4}{sin}^{2}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-3c0f1a3a-2816-584e-a58f-1a944b890014" :answer/id #uuid "3c0f1a3a-2816-584e-a58f-1a944b890014" :answer/type :answer.type/math :answer/value "3\\sqrt{2}{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡2\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-d5463613-7aa5-5ac0-8e87-c4d1223952c0" :answer/id #uuid "d5463613-7aa5-5ac0-8e87-c4d1223952c0" :answer/type :answer.type/math :answer/value "3\\sqrt{3}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡2\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-65217f58-febb-5f88-af93-f698f3e104ec" :answer/id #uuid "65217f58-febb-5f88-af93-f698f3e104ec" :answer/type :answer.type/math :answer/value "\\sqrt{2}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-59542311-3beb-5ba9-afe8-6ee4234a603f" :answer/id #uuid "59542311-3beb-5ba9-afe8-6ee4234a603f" :answer/type :answer.type/math :answer/value "\\sqrt{6}{\\int }_{0}^{\\pi /4}{cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-bcf9f8c6-5d3c-5211-90e2-bddb94921272" :question/id #uuid "bcf9f8c6-5d3c-5211-90e2-bddb94921272" :question/math-academy-id "q-76609" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=1\\,$ for $-\\frac{\\pi }{8}\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =1\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =1\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{8}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=xy(1-{x}^{2})$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot (1-{cos}^{2}⁡\\theta ) \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot {sin}^{2}⁡\\theta  \\\\  & ={sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(1)^{2}+{0}^{2}} \\\\  & =\\sqrt{1+0} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy(1-{x}^{2})\\,\\text{d}s & ={\\int }_{-\\pi /8}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-30132071-c6bc-5d04-908b-c84e3cfc46ed"] :db/ensure [:question/validate]} {:db/id "answer-field-30132071-c6bc-5d04-908b-c84e3cfc46ed" :answer-field/id #uuid "30132071-c6bc-5d04-908b-c84e3cfc46ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1a14529d-3768-5610-b079-b36a0abcae5e" :answer-field/choices ["answer-0cc074f0-8d82-55d9-960a-7332cb2a9aba" "answer-3dabd53e-5bb6-5035-b84f-4f492fd16bdb" "answer-e0fc3cdf-cbc6-5629-a612-73348098ca7d" "answer-705ccca2-e01f-5eb0-be9c-6619697c9f9b" "answer-1a14529d-3768-5610-b079-b36a0abcae5e"] :db/ensure [:answer-field/validate]} {:db/id "answer-0cc074f0-8d82-55d9-960a-7332cb2a9aba" :answer/id #uuid "0cc074f0-8d82-55d9-960a-7332cb2a9aba" :answer/type :answer.type/math :answer/value "2{\\int }_{-\\pi /8}^{\\pi /4}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-3dabd53e-5bb6-5035-b84f-4f492fd16bdb" :answer/id #uuid "3dabd53e-5bb6-5035-b84f-4f492fd16bdb" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-e0fc3cdf-cbc6-5629-a612-73348098ca7d" :answer/id #uuid "e0fc3cdf-cbc6-5629-a612-73348098ca7d" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-705ccca2-e01f-5eb0-be9c-6619697c9f9b" :answer/id #uuid "705ccca2-e01f-5eb0-be9c-6619697c9f9b" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{2}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-1a14529d-3768-5610-b079-b36a0abcae5e" :answer/id #uuid "1a14529d-3768-5610-b079-b36a0abcae5e" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /8}^{\\pi /4}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-ce434154-3398-5488-977f-b3adb13e5b25" :question/id #uuid "ce434154-3398-5488-977f-b3adb13e5b25" :question/math-academy-id "q-76607" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}xy\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=2\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =2{cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2{cos}^{2}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2{cos}^{2}⁡\\theta \\cdot 2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta  \\\\  & =4{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2\\operatorname{cos}⁡\\theta )=-2\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(2\\operatorname{cos}⁡\\theta )^{2}+(-2\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{4({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}4{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 2\\cdot \\text{d}\\theta  \\\\  & =8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-300a6c45-5c56-5b70-8220-7a36e97b7d82"] :db/ensure [:question/validate]} {:db/id "answer-field-300a6c45-5c56-5b70-8220-7a36e97b7d82" :answer-field/id #uuid "300a6c45-5c56-5b70-8220-7a36e97b7d82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8942f4a7-3e21-56af-9bb4-658bf93f6604" :answer-field/choices ["answer-ad686914-2f26-5181-bfe3-df5b8db65ff9" "answer-42db5338-1e39-52a9-9b3f-1945f45b8bf4" "answer-f5ea4357-cdc0-5451-a938-bd13cfa04e3c" "answer-66a47cde-b229-5742-a3c9-cd9a46d82b71" "answer-8942f4a7-3e21-56af-9bb4-658bf93f6604"] :db/ensure [:answer-field/validate]} {:db/id "answer-ad686914-2f26-5181-bfe3-df5b8db65ff9" :answer/id #uuid "ad686914-2f26-5181-bfe3-df5b8db65ff9" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-42db5338-1e39-52a9-9b3f-1945f45b8bf4" :answer/id #uuid "42db5338-1e39-52a9-9b3f-1945f45b8bf4" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-f5ea4357-cdc0-5451-a938-bd13cfa04e3c" :answer/id #uuid "f5ea4357-cdc0-5451-a938-bd13cfa04e3c" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-66a47cde-b229-5742-a3c9-cd9a46d82b71" :answer/id #uuid "66a47cde-b229-5742-a3c9-cd9a46d82b71" :answer/type :answer.type/math :answer/value "8{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-8942f4a7-3e21-56af-9bb4-658bf93f6604" :answer/id #uuid "8942f4a7-3e21-56af-9bb4-658bf93f6604" :answer/type :answer.type/math :answer/value "8{\\int }_{0}^{\\pi /2}{cos}^{3}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-50247cc3-8637-5b67-95c3-4cdd3dd3329e" :question/id #uuid "50247cc3-8637-5b67-95c3-4cdd3dd3329e" :question/math-academy-id "q-76582" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}(x+y)\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y={sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{sin}⁡\\theta )=\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{sin}⁡\\theta )}^{2}+{(\\operatorname{cos}⁡\\theta )}^{2}} \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-98645239-f570-5bdc-ae35-ee32a0ef62bf"] :db/ensure [:question/validate]} {:db/id "answer-field-98645239-f570-5bdc-ae35-ee32a0ef62bf" :answer-field/id #uuid "98645239-f570-5bdc-ae35-ee32a0ef62bf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-04a10cbc-62bc-52ef-9573-9bb8535117b5" :answer-field/choices ["answer-5374193f-6c53-5136-b249-4387a6f7f018" "answer-eb4fc49c-efc5-5ad5-9f98-7f2015d47df2" "answer-04a10cbc-62bc-52ef-9573-9bb8535117b5" "answer-2e04cc6e-105d-58a6-b535-adb2aa80e8fe" "answer-9a399ff3-ac04-580d-8f27-2c4ed2b64de5"] :db/ensure [:answer-field/validate]} {:db/id "answer-5374193f-6c53-5136-b249-4387a6f7f018" :answer/id #uuid "5374193f-6c53-5136-b249-4387a6f7f018" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-eb4fc49c-efc5-5ad5-9f98-7f2015d47df2" :answer/id #uuid "eb4fc49c-efc5-5ad5-9f98-7f2015d47df2" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-04a10cbc-62bc-52ef-9573-9bb8535117b5" :answer/id #uuid "04a10cbc-62bc-52ef-9573-9bb8535117b5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-2e04cc6e-105d-58a6-b535-adb2aa80e8fe" :answer/id #uuid "2e04cc6e-105d-58a6-b535-adb2aa80e8fe" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-9a399ff3-ac04-580d-8f27-2c4ed2b64de5" :answer/id #uuid "9a399ff3-ac04-580d-8f27-2c4ed2b64de5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta (\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-ee634955-812e-57a4-9691-da172190ae0a" :question/id #uuid "ee634955-812e-57a4-9691-da172190ae0a" :question/math-academy-id "q-76611" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}(x+y)^{2}\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\pi ?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & ={cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x={cos}^{2}⁡\\theta $ and $y=\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\pi .$\n\nNow, if $f(x,y)=(x+y)^{2}$, we obtain  \n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & ={({cos}^{2}⁡\\theta +\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )}^{2} \\\\  & ={(\\operatorname{cos}⁡\\theta (\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ))}^{2} \\\\  & ={cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}.\\end{aligned}\n$$\n\n \n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta )=-\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{(\\operatorname{cos}⁡\\theta )}^{2}+{(-\\operatorname{sin}⁡\\theta )}^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta } \\\\  & =\\sqrt{1} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-436cc0aa-bff3-5b92-a639-ba2e62b0da93"] :db/ensure [:question/validate]} {:db/id "answer-field-436cc0aa-bff3-5b92-a639-ba2e62b0da93" :answer-field/id #uuid "436cc0aa-bff3-5b92-a639-ba2e62b0da93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" :answer-field/choices ["answer-76d63731-dd9b-510e-8131-e402a45ba6a7" "answer-0ae41ca2-e608-5696-b440-d41c065df75e" "answer-5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" "answer-de572935-367e-52cb-8f52-f59649494fbd" "answer-082112eb-8a26-5265-b137-26bd8c295b06"] :db/ensure [:answer-field/validate]} {:db/id "answer-76d63731-dd9b-510e-8131-e402a45ba6a7" :answer/id #uuid "76d63731-dd9b-510e-8131-e402a45ba6a7" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-0ae41ca2-e608-5696-b440-d41c065df75e" :answer/id #uuid "0ae41ca2-e608-5696-b440-d41c065df75e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" :answer/id #uuid "5cbc00c8-62ae-5a6f-8037-f55f4dd09a38" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-de572935-367e-52cb-8f52-f59649494fbd" :answer/id #uuid "de572935-367e-52cb-8f52-f59649494fbd" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{sin}^{2}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "answer-082112eb-8a26-5265-b137-26bd8c295b06" :answer/id #uuid "082112eb-8a26-5265-b137-26bd8c295b06" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{sin}^{3}⁡\\theta \\,{(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )}^{2}\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "question-3ed7acf8-9750-5997-81ee-fb6a8cd2e910" :question/id #uuid "3ed7acf8-9750-5997-81ee-fb6a8cd2e910" :question/math-academy-id "q-76685" :question/problem "Evaluate the integral ${\\int }_{C}(x-y)\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=\\sqrt{\\operatorname{sin}⁡2\\theta }\\,$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }$, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)=x-y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\operatorname{cos}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta }-\\operatorname{sin}⁡\\theta \\sqrt{\\operatorname{sin}⁡2\\theta } \\\\  & =(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}{r}^{′}(\\theta ) & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{\\operatorname{sin}⁡2\\theta }) \\\\  & =\\frac{1}{2\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot (\\operatorname{cos}⁡2\\theta )\\cdot 2 \\\\  & =\\frac{\\operatorname{cos}⁡2\\theta }{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{\\operatorname{sin}⁡2\\theta +\\frac{{cos}^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{{sin}^{2}⁡2\\theta +{cos}^{2}⁡2\\theta }{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\sqrt{\\frac{1}{\\operatorname{sin}⁡2\\theta }} \\\\  & =\\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}.\\end{aligned}\n$$\n\n   \n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\sqrt{\\operatorname{sin}⁡2\\theta }\\cdot \\frac{1}{\\sqrt{\\operatorname{sin}⁡2\\theta }}\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /4} \\\\  & =(\\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{2}}{2})-(0+1) \\\\  & =\\sqrt{2}-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-015c6706-f693-57f9-9ba0-4544584eb2cc"] :db/ensure [:question/validate]} {:db/id "answer-field-015c6706-f693-57f9-9ba0-4544584eb2cc" :answer-field/id #uuid "015c6706-f693-57f9-9ba0-4544584eb2cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4e5d6c92-e2a1-55af-af72-56edfe9fbc7e" :answer-field/choices ["answer-239cca6c-804d-568c-9236-141e4ca7f897" "answer-94132ebc-7150-5f36-9359-19697117b692" "answer-7bbb07ca-e7d7-58c3-8c34-f10c0c9661fd" "answer-2e30646b-950b-5207-8b78-2d3832e125e3" "answer-4e5d6c92-e2a1-55af-af72-56edfe9fbc7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-239cca6c-804d-568c-9236-141e4ca7f897" :answer/id #uuid "239cca6c-804d-568c-9236-141e4ca7f897" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-94132ebc-7150-5f36-9359-19697117b692" :answer/id #uuid "94132ebc-7150-5f36-9359-19697117b692" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-7bbb07ca-e7d7-58c3-8c34-f10c0c9661fd" :answer/id #uuid "7bbb07ca-e7d7-58c3-8c34-f10c0c9661fd" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2e30646b-950b-5207-8b78-2d3832e125e3" :answer/id #uuid "2e30646b-950b-5207-8b78-2d3832e125e3" :answer/type :answer.type/math :answer/value "\\sqrt{2}+2" :db/ensure [:answer/validate]} {:db/id "answer-4e5d6c92-e2a1-55af-af72-56edfe9fbc7e" :answer/id #uuid "4e5d6c92-e2a1-55af-af72-56edfe9fbc7e" :answer/type :answer.type/math :answer/value "\\sqrt{2}-1" :db/ensure [:answer/validate]} {:db/id "question-7a3675b0-e883-52dd-8e3e-7330cc6b3856" :question/id #uuid "7a3675b0-e883-52dd-8e3e-7330cc6b3856" :question/math-academy-id "q-165415" :question/problem "Evaluate the integral ${\\int }_{C}{x}^{2}\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\,$ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{cos}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta }$, where $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2} \\\\  & ={cos}^{2}⁡\\theta \\sqrt[3]{{cos}^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{cos}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\cdot (-\\operatorname{sin}⁡3\\theta ) \\\\  & =-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{cos}⁡3\\theta })^{2}+{(-\\frac{\\operatorname{sin}⁡3\\theta }{\\sqrt[3]{{cos}^{2}⁡3\\theta }})}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{cos}^{2}⁡3\\theta }+\\frac{{sin}^{2}⁡3\\theta }{\\sqrt[3]{{cos}^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡3\\theta +{sin}^{2}⁡3\\theta }{\\sqrt[3]{{cos}^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{cos}^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\sqrt[3]{{cos}^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{cos}^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}{cos}^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /4}^{\\pi /4}(1+\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta +\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{-\\pi /4}^{\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{\\pi }{4}+\\frac{1}{2}-(-\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-866e10cb-7bc8-54b5-b98f-2a2d55ebe453"] :db/ensure [:question/validate]} {:db/id "answer-field-866e10cb-7bc8-54b5-b98f-2a2d55ebe453" :answer-field/id #uuid "866e10cb-7bc8-54b5-b98f-2a2d55ebe453" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a7330c13-ecf9-5fb5-8378-1f535c4f0420" :answer-field/choices ["answer-cb4e334f-cfe8-5326-92bb-f4acab21965f" "answer-5a95b8e9-6493-5f50-a29f-7ee9d41b4718" "answer-585c7fa1-6f4c-5c7c-9aa3-76aa043504d5" "answer-0a88e0b9-efe3-5c60-850b-a590ab5c7a1f" "answer-a7330c13-ecf9-5fb5-8378-1f535c4f0420"] :db/ensure [:answer-field/validate]} {:db/id "answer-cb4e334f-cfe8-5326-92bb-f4acab21965f" :answer/id #uuid "cb4e334f-cfe8-5326-92bb-f4acab21965f" :answer/type :answer.type/math :answer/value "\\frac{1+2\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-5a95b8e9-6493-5f50-a29f-7ee9d41b4718" :answer/id #uuid "5a95b8e9-6493-5f50-a29f-7ee9d41b4718" :answer/type :answer.type/math :answer/value "\\frac{1+\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-585c7fa1-6f4c-5c7c-9aa3-76aa043504d5" :answer/id #uuid "585c7fa1-6f4c-5c7c-9aa3-76aa043504d5" :answer/type :answer.type/math :answer/value "\\frac{1+\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-0a88e0b9-efe3-5c60-850b-a590ab5c7a1f" :answer/id #uuid "0a88e0b9-efe3-5c60-850b-a590ab5c7a1f" :answer/type :answer.type/math :answer/value "\\frac{2+\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-a7330c13-ecf9-5fb5-8378-1f535c4f0420" :answer/id #uuid "a7330c13-ecf9-5fb5-8378-1f535c4f0420" :answer/type :answer.type/math :answer/value "\\frac{2+\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "question-3f1c8267-786a-5d55-8970-d1a062c41c69" :question/id #uuid "3f1c8267-786a-5d55-8970-d1a062c41c69" :question/math-academy-id "q-76673" :question/problem "Evaluate the integral of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$ along the polar curve $r=1$ for $0\\le \\theta \\le \\frac{\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta $ and $y=\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, since $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\frac{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{1}{{cos}^{2}⁡\\theta } \\\\  & ={sec}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{{x}^{2}+{y}^{2}}{{x}^{2}}\\,\\text{d}s & ={\\int }_{0}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =\\operatorname{tan}⁡\\theta \\,{|}_{0}^{\\pi /4} \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-63750d47-51f3-5cdf-a76b-72522571295c"] :db/ensure [:question/validate]} {:db/id "answer-field-63750d47-51f3-5cdf-a76b-72522571295c" :answer-field/id #uuid "63750d47-51f3-5cdf-a76b-72522571295c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-404520d3-d967-5b0b-9a92-89f881bf696e" :answer-field/choices ["answer-890fe5ec-8858-5534-8b26-e75adee4e582" "answer-404520d3-d967-5b0b-9a92-89f881bf696e" "answer-e503b46f-e7bf-57d7-8559-2e0601cdad27" "answer-90adc149-a9e2-5b9c-8313-fbc0425f524a" "answer-ef25c8f6-c622-5edf-b418-bcdc116be329"] :db/ensure [:answer-field/validate]} {:db/id "answer-890fe5ec-8858-5534-8b26-e75adee4e582" :answer/id #uuid "890fe5ec-8858-5534-8b26-e75adee4e582" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-404520d3-d967-5b0b-9a92-89f881bf696e" :answer/id #uuid "404520d3-d967-5b0b-9a92-89f881bf696e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-e503b46f-e7bf-57d7-8559-2e0601cdad27" :answer/id #uuid "e503b46f-e7bf-57d7-8559-2e0601cdad27" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-90adc149-a9e2-5b9c-8313-fbc0425f524a" :answer/id #uuid "90adc149-a9e2-5b9c-8313-fbc0425f524a" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "answer-ef25c8f6-c622-5edf-b418-bcdc116be329" :answer/id #uuid "ef25c8f6-c622-5edf-b418-bcdc116be329" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id 17592186152742 :question/problem "Evaluate the integral of the function $f(x,y)=x+y$ along the polar curve $r=2$ for $-\\frac{\\pi }{4}\\le \\theta \\le 0.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le 0.$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta +2\\operatorname{sin}⁡\\theta  \\\\  & =2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ).\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,\\text{d}s & ={\\int }_{-\\pi /4}^{0}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{0}2(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\cdot 2\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{0}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ){|}_{-\\pi /4}^{0} \\\\  & =4([0-1]-[-\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2}]) \\\\  & =4(\\sqrt{2}-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186150959 :answer-field/correct "answer-35a3d662-0004-5272-8d96-ac26eddf6b34" :answer-field/choices ["answer-35a3d662-0004-5272-8d96-ac26eddf6b34" "answer-23b1763b-1b62-51fc-8c26-6f829107e1d4" "answer-1fc5a202-2d3d-51b8-8cc9-baf13d81b387"] :db/ensure [:answer-field/validate]} {:db/id "answer-35a3d662-0004-5272-8d96-ac26eddf6b34" :answer/id #uuid "35a3d662-0004-5272-8d96-ac26eddf6b34" :answer/type :answer.type/math :answer/value "4(\\sqrt{2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-23b1763b-1b62-51fc-8c26-6f829107e1d4" :answer/id #uuid "23b1763b-1b62-51fc-8c26-6f829107e1d4" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}-1" :db/ensure [:answer/validate]} {:db/id "answer-1fc5a202-2d3d-51b8-8cc9-baf13d81b387" :answer/id #uuid "1fc5a202-2d3d-51b8-8cc9-baf13d81b387" :answer/type :answer.type/math :answer/value "\\sqrt{2}+1" :db/ensure [:answer/validate]} {:db/id "question-50bd506e-5f91-5da4-a6e7-565dbeb70122" :question/id #uuid "50bd506e-5f91-5da4-a6e7-565dbeb70122" :question/math-academy-id "q-165416" :question/problem "Evaluate the integral ${\\int }_{C}{y}^{2}\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\,$ for $\\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{cos}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }, \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt[3]{\\operatorname{sin}⁡3\\theta }\\cdot \\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }.\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\operatorname{cos}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$ and $y=\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta }$, where $\\frac{\\pi }{4}\\le \\theta \\le \\frac{3\\pi }{4}.$\n\nNow, if $f(x,y)={y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\operatorname{sin}⁡\\theta \\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2} \\\\  & ={sin}^{2}⁡\\theta \\sqrt[3]{{sin}^{2}⁡3\\theta }.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt[3]{\\operatorname{sin}⁡3\\theta }) \\\\  & =3\\cdot \\frac{1}{3\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\cdot \\operatorname{cos}⁡3\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt[3]{\\operatorname{sin}⁡3\\theta })^{2}+{(\\frac{\\operatorname{cos}⁡3\\theta }{\\sqrt[3]{{sin}^{2}⁡3\\theta }})}^{2}} \\\\  & =\\sqrt{\\sqrt[3]{{sin}^{2}⁡3\\theta }+\\frac{{cos}^{2}⁡3\\theta }{\\sqrt[3]{{sin}^{4}⁡3\\theta }}} \\\\  & =\\sqrt{\\frac{{cos}^{2}⁡3\\theta +{sin}^{2}⁡3\\theta }{\\sqrt[3]{{sin}^{4}⁡3\\theta }}} \\\\  & =\\frac{1}{\\sqrt[3]{{sin}^{2}⁡3\\theta }}.\\end{aligned}\n$$\n\nFinally, we now evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,\\text{d}s & ={\\int }_{\\pi /4}^{3\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta \\sqrt[3]{{sin}^{2}⁡3\\theta }\\cdot \\frac{1}{\\sqrt[3]{{sin}^{2}⁡3\\theta }}\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{3\\pi /4}{sin}^{2}⁡\\theta \\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /4}^{3\\pi /4}(1-\\operatorname{cos}⁡2\\theta )\\text{d}\\theta  \\\\  & =\\frac{1}{2}{[\\theta -\\frac{1}{2}\\operatorname{sin}⁡2\\theta ]}_{\\pi /4}^{3\\pi /4} \\\\  & =\\frac{1}{2}(\\frac{3\\pi }{4}-\\frac{(-1)}{2}-(\\frac{\\pi }{4}-\\frac{1}{2})) \\\\  & =\\frac{2+\\pi }{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-cfa59a1c-e79f-5e55-9bec-480e8a735e4d"] :db/ensure [:question/validate]} {:db/id "answer-field-cfa59a1c-e79f-5e55-9bec-480e8a735e4d" :answer-field/id #uuid "cfa59a1c-e79f-5e55-9bec-480e8a735e4d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b297024-5803-5e1f-806e-e9147fe90127" :answer-field/choices ["answer-a33f9d01-31ec-5113-88f0-e574bdf8e345" "answer-77014ac8-9188-566a-ab76-fd0f1159cb28" "answer-f822b4a7-0b96-5267-a032-717ecb4736cb" "answer-4b297024-5803-5e1f-806e-e9147fe90127" "answer-cf548da9-86b9-58e8-bfb8-e84b31a042ef"] :db/ensure [:answer-field/validate]} {:db/id "answer-a33f9d01-31ec-5113-88f0-e574bdf8e345" :answer/id #uuid "a33f9d01-31ec-5113-88f0-e574bdf8e345" :answer/type :answer.type/math :answer/value "\\frac{1+2\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "answer-77014ac8-9188-566a-ab76-fd0f1159cb28" :answer/id #uuid "77014ac8-9188-566a-ab76-fd0f1159cb28" :answer/type :answer.type/math :answer/value "\\frac{1+2\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-f822b4a7-0b96-5267-a032-717ecb4736cb" :answer/id #uuid "f822b4a7-0b96-5267-a032-717ecb4736cb" :answer/type :answer.type/math :answer/value "\\frac{1+\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-4b297024-5803-5e1f-806e-e9147fe90127" :answer/id #uuid "4b297024-5803-5e1f-806e-e9147fe90127" :answer/type :answer.type/math :answer/value "\\frac{2+\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "answer-cf548da9-86b9-58e8-bfb8-e84b31a042ef" :answer/id #uuid "cf548da9-86b9-58e8-bfb8-e84b31a042ef" :answer/type :answer.type/math :answer/value "\\frac{4+\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "question-9c7ce8e8-7ebb-5185-86d9-47c695c84f48" :question/id #uuid "9c7ce8e8-7ebb-5185-86d9-47c695c84f48" :question/math-academy-id "q-76768" :question/problem "Evaluate the integral ${\\int }_{C}\\sqrt{x}y\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=4\\operatorname{cos}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =4{cos}^{2}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=4{cos}^{2}⁡\\theta $ and $y=4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=\\sqrt{x}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =\\sqrt{4{cos}^{2}⁡\\theta }\\cdot 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8|\\operatorname{cos}⁡\\theta |\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta  \\\\  & =8{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNotice that $|\\operatorname{cos}⁡\\theta |=\\operatorname{cos}⁡\\theta $ because $0\\le \\theta \\le \\frac{\\pi }{2}⟹\\operatorname{cos}⁡\\theta \\ge 0.$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(4\\operatorname{cos}⁡\\theta ) \\\\  & =-4\\operatorname{sin}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(4\\operatorname{cos}⁡\\theta )^{2}+(-4\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{16({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =4.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\sqrt{x}y\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}8{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot 4\\cdot \\text{d}\\theta  \\\\  & =32{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{cos}⁡\\theta ,$ $\\text{d}u=-\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}32{\\int }_{0}^{\\pi /2}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  & =32{\\int }_{1}^{0}-{u}^{2}\\,\\text{d}u \\\\  & =32{\\int }_{0}^{1}{u}^{2}\\,\\text{d}u \\\\  & =32\\cdot \\frac{1}{3}{u}^{3}{|}_{0}^{1} \\\\  & =\\frac{32}{3}({1}^{3}-{0}^{3}) \\\\  & =\\frac{32}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d82fe19b-8cd0-5df1-bf94-5bdbb9c5b9df"] :db/ensure [:question/validate]} {:db/id "answer-field-d82fe19b-8cd0-5df1-bf94-5bdbb9c5b9df" :answer-field/id #uuid "d82fe19b-8cd0-5df1-bf94-5bdbb9c5b9df" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8a580176-26a2-5536-906f-5573392c1d28" :answer-field/choices ["answer-e81cddbe-cf94-5088-b2c6-2672b342f18e" "answer-d6c54752-bf5b-5114-8706-a39bfe9f6e95" "answer-2405db00-e007-59b1-bf44-c16b5a7629f3" "answer-11a75b67-5f2f-522b-91db-f97635ae5971" "answer-8a580176-26a2-5536-906f-5573392c1d28"] :db/ensure [:answer-field/validate]} {:db/id "answer-e81cddbe-cf94-5088-b2c6-2672b342f18e" :answer/id #uuid "e81cddbe-cf94-5088-b2c6-2672b342f18e" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-d6c54752-bf5b-5114-8706-a39bfe9f6e95" :answer/id #uuid "d6c54752-bf5b-5114-8706-a39bfe9f6e95" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "answer-2405db00-e007-59b1-bf44-c16b5a7629f3" :answer/id #uuid "2405db00-e007-59b1-bf44-c16b5a7629f3" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "answer-11a75b67-5f2f-522b-91db-f97635ae5971" :answer/id #uuid "11a75b67-5f2f-522b-91db-f97635ae5971" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "answer-8a580176-26a2-5536-906f-5573392c1d28" :answer/id #uuid "8a580176-26a2-5536-906f-5573392c1d28" :answer/type :answer.type/math :answer/value "\\frac{32}{3}" :db/ensure [:answer/validate]} {:db/id 17592186152739 :question/problem "Evaluate the integral ${\\int }_{C}xy\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=5\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =5{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=5{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, if $f(x,y)=xy$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 5{sin}^{2}⁡\\theta  \\\\  & =25{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(5\\operatorname{sin}⁡\\theta ) \\\\  & =5\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(5\\operatorname{sin}⁡\\theta )^{2}+(5\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{25({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =5.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}25{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 5\\cdot \\text{d}\\theta  \\\\  & =125{\\int }_{0}^{\\pi /2}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}125{\\int }_{0}^{\\pi /2}{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =125{\\int }_{0}^{1}{u}^{3}\\,\\text{d}u \\\\  & =125\\cdot \\frac{1}{4}{u}^{4}{|}_{0}^{1} \\\\  & =\\frac{125}{4}({1}^{4}-{0}^{4}) \\\\  & =\\frac{125}{4}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186150941 :answer-field/correct 17592186150946 :db/ensure [:answer-field/validate]} {:db/id "question-eec86b54-2bc2-5f46-8f9a-0f8c56be4962" :question/id #uuid "eec86b54-2bc2-5f46-8f9a-0f8c56be4962" :question/math-academy-id "q-76769" :question/problem "Evaluate the integral ${\\int }_{C}x{y}^{2}\\,\\text{d}s$, where the curve $C$ is given in polar form by $r=3\\operatorname{sin}⁡\\theta \\,$ for $0\\le \\theta \\le \\frac{\\pi }{6}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta  \\\\  & =3{sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta $ and $y=3{sin}^{2}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{6}.$\n\nNow, if $f(x,y)=x{y}^{2}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =3\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot (3{sin}^{2}⁡\\theta )^{2} \\\\  & =27{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(3\\operatorname{sin}⁡\\theta ) \\\\  & =3\\operatorname{cos}⁡\\theta ,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(3\\operatorname{sin}⁡\\theta )^{2}+(3\\operatorname{cos}⁡\\theta )^{2}} \\\\  & =\\sqrt{9({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} \\\\  & =3.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,\\text{d}s & ={\\int }_{0}^{\\pi /6}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}27{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 3\\cdot \\text{d}\\theta  \\\\  & =81{\\int }_{0}^{\\pi /6}{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}81{\\int }_{0}^{\\pi /6}{sin}^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =81{\\int }_{0}^{1/2}{u}^{5}\\,\\text{d}u \\\\  & =81\\cdot \\frac{1}{6}{u}^{6}\\,{|}_{0}^{1/2} \\\\  & =\\frac{27}{2}((\\frac{1}{2})^{6}-{0}^{6}) \\\\  & =\\frac{27}{128}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d0754811-61f8-5b43-b64d-d1916d6e8f79"] :db/ensure [:question/validate]} {:db/id "answer-field-d0754811-61f8-5b43-b64d-d1916d6e8f79" :answer-field/id #uuid "d0754811-61f8-5b43-b64d-d1916d6e8f79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-669bf703-838e-5938-ae0d-38fb979f2c88" :answer-field/choices ["answer-669bf703-838e-5938-ae0d-38fb979f2c88" "answer-436fc72b-b372-56c4-8b22-e7ad0b501850" "answer-79e64d1a-8928-56a0-b539-e3221053a6ad" "answer-30e86b23-ab58-5191-ad26-f69ae3689883" "answer-fb8a62c2-9594-5471-887e-0b239c4e7aad"] :db/ensure [:answer-field/validate]} {:db/id "answer-669bf703-838e-5938-ae0d-38fb979f2c88" :answer/id #uuid "669bf703-838e-5938-ae0d-38fb979f2c88" :answer/type :answer.type/math :answer/value "\\frac{27}{128}" :db/ensure [:answer/validate]} {:db/id "answer-436fc72b-b372-56c4-8b22-e7ad0b501850" :answer/id #uuid "436fc72b-b372-56c4-8b22-e7ad0b501850" :answer/type :answer.type/math :answer/value "\\frac{27}{32}" :db/ensure [:answer/validate]} {:db/id "answer-79e64d1a-8928-56a0-b539-e3221053a6ad" :answer/id #uuid "79e64d1a-8928-56a0-b539-e3221053a6ad" :answer/type :answer.type/math :answer/value "\\frac{27}{64}" :db/ensure [:answer/validate]} {:db/id "answer-30e86b23-ab58-5191-ad26-f69ae3689883" :answer/id #uuid "30e86b23-ab58-5191-ad26-f69ae3689883" :answer/type :answer.type/math :answer/value "\\frac{81}{64}" :db/ensure [:answer/validate]} {:db/id "answer-fb8a62c2-9594-5471-887e-0b239c4e7aad" :answer/id #uuid "fb8a62c2-9594-5471-887e-0b239c4e7aad" :answer/type :answer.type/math :answer/value "\\frac{9}{128}" :db/ensure [:answer/validate]} {:db/id "question-1b9e5c87-171d-5626-ae59-fa7b69d9a95a" :question/id #uuid "1b9e5c87-171d-5626-ae59-fa7b69d9a95a" :question/math-academy-id "q-76766" :question/problem "Evaluate the integral of the function $f(x,y)=x{e}^{y+1}$ along the polar curve $r=2$ for $0\\le \\theta \\le \\frac{\\pi }{2}.$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =2\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=2\\operatorname{cos}⁡\\theta $ and $y=2\\operatorname{sin}⁡\\theta $, where $0\\le \\theta \\le \\frac{\\pi }{2}.$\n\nNow, since $f(x,y)=x{e}^{y+1}$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}.\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(2)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{2}^{2}+{0}^{2}} \\\\  & =2.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x{e}^{y+1}\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}\\cdot 2\\cdot \\text{d}\\theta  \\\\  & =2{\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2\\operatorname{sin}⁡\\theta +1,$ $\\text{d}u=2\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}2{\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta {e}^{2\\operatorname{sin}⁡\\theta +1}\\,\\text{d}\\theta  & =2{\\int }_{1}^{3}{e}^{u}\\,\\text{d}u \\\\  & =2{e}^{u}{|}_{1}^{3} \\\\  & =2{e}^{3}-2e \\\\  & =2e({e}^{2}-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-61a3ae46-0e2c-5017-bfca-74625ceef8e7"] :db/ensure [:question/validate]} {:db/id "answer-field-61a3ae46-0e2c-5017-bfca-74625ceef8e7" :answer-field/id #uuid "61a3ae46-0e2c-5017-bfca-74625ceef8e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-84793b57-cdb0-527c-8f47-4fc489aedbaa" :answer-field/choices ["answer-adebc696-6cad-5a00-9edf-015f1843d18f" "answer-52950150-cf38-5785-b5c4-0a95b436b499" "answer-928594cf-1e82-52f9-95c7-79551dbc7ad9" "answer-84793b57-cdb0-527c-8f47-4fc489aedbaa" "answer-2cb0f1f8-2c8c-587d-af87-78c647b1cad3"] :db/ensure [:answer-field/validate]} {:db/id "answer-adebc696-6cad-5a00-9edf-015f1843d18f" :answer/id #uuid "adebc696-6cad-5a00-9edf-015f1843d18f" :answer/type :answer.type/math :answer/value "2({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "answer-52950150-cf38-5785-b5c4-0a95b436b499" :answer/id #uuid "52950150-cf38-5785-b5c4-0a95b436b499" :answer/type :answer.type/math :answer/value "2({e}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-928594cf-1e82-52f9-95c7-79551dbc7ad9" :answer/id #uuid "928594cf-1e82-52f9-95c7-79551dbc7ad9" :answer/type :answer.type/math :answer/value "2e({e}^{2}+1)" :db/ensure [:answer/validate]} {:db/id "answer-84793b57-cdb0-527c-8f47-4fc489aedbaa" :answer/id #uuid "84793b57-cdb0-527c-8f47-4fc489aedbaa" :answer/type :answer.type/math :answer/value "2e({e}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "answer-2cb0f1f8-2c8c-587d-af87-78c647b1cad3" :answer/id #uuid "2cb0f1f8-2c8c-587d-af87-78c647b1cad3" :answer/type :answer.type/math :answer/value "{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id 17592186152335 :activity/expected-seconds 780.0 :db/ensure [:activity/validate]} {:db/id 17592186124602 :knowledge-point/questions ["question-dde0c5ba-d69f-5523-84e3-29d85ec2262a" "question-100586e5-9805-5b99-b25c-c241db3e3b53" "question-6fd075d3-5c0d-5ed0-b894-521c86e9d041"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124599 :knowledge-point/questions ["question-3a4040a9-af29-5df2-8d92-a7f8acbeb04b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-dde0c5ba-d69f-5523-84e3-29d85ec2262a" :question/id #uuid "dde0c5ba-d69f-5523-84e3-29d85ec2262a" :question/math-academy-id "q-80391" :question/problem "Consider the matrix $E=[\\begin{aligned}-32 & 40 \\\\ -30 & 38\\end{aligned}].$ You're given that ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=8$ are the eigenvalues of $E$, and\n${v}_{1}=[\\begin{aligned}4 \\\\ 3\\end{aligned}]$, ${v}_{2}=[\\begin{aligned}2 \\\\ 2\\end{aligned}]$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=E,$ where $D$ is a diagonal matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=8,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}-2 & 0 \\\\ 0 & 8\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-2,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=8.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}4 & 2 \\\\ 3 & 2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-86414dc6-5142-5c5b-92b4-cd993eb839dc"] :db/ensure [:question/validate]} {:db/id "answer-field-86414dc6-5142-5c5b-92b4-cd993eb839dc" :answer-field/id #uuid "86414dc6-5142-5c5b-92b4-cd993eb839dc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5b9fc411-d727-58c3-b130-7cb8806396aa" :answer-field/choices ["answer-5b9fc411-d727-58c3-b130-7cb8806396aa" "answer-6651a84a-abb1-53a5-8762-4f56861de479" "answer-b787992e-f51f-5213-a591-68b1b37d8b9b" "answer-85b5f122-b544-5270-a1c3-306a799a62e3" "answer-c81b241b-7949-5f59-a9cc-99f9b9e79c21"] :db/ensure [:answer-field/validate]} {:db/id "answer-5b9fc411-d727-58c3-b130-7cb8806396aa" :answer/id #uuid "5b9fc411-d727-58c3-b130-7cb8806396aa" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-2 & 0 \\\\ 0 & 8\\end{aligned}]$ and \n$P=[\\begin{aligned}4 & 2 \\\\ 3 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-6651a84a-abb1-53a5-8762-4f56861de479" :answer/id #uuid "6651a84a-abb1-53a5-8762-4f56861de479" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-2 & 8 \\\\ 0 & 0\\end{aligned}]$ and \n$P=[\\begin{aligned}4 & -2 \\\\ 3 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-b787992e-f51f-5213-a591-68b1b37d8b9b" :answer/id #uuid "b787992e-f51f-5213-a591-68b1b37d8b9b" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}2 & 0 \\\\ 0 & -8\\end{aligned}]$ and \n$P=[\\begin{aligned}3 & 2 \\\\ 4 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-85b5f122-b544-5270-a1c3-306a799a62e3" :answer/id #uuid "85b5f122-b544-5270-a1c3-306a799a62e3" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}8 & 0 \\\\ 0 & -2\\end{aligned}]$ and \n$P=[\\begin{aligned}2 & 4 \\\\ 3 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-c81b241b-7949-5f59-a9cc-99f9b9e79c21" :answer/id #uuid "c81b241b-7949-5f59-a9cc-99f9b9e79c21" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}8 & 0 \\\\ 0 & -2\\end{aligned}]$ and \n$P=[\\begin{aligned}4 & 2 \\\\ 3 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "question-100586e5-9805-5b99-b25c-c241db3e3b53" :question/id #uuid "100586e5-9805-5b99-b25c-c241db3e3b53" :question/math-academy-id "q-37632" :question/problem "Consider the matrix $B=[\\begin{aligned}5 & 3 \\\\ -4 & -3\\end{aligned}].$ You're given that ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=3$ are the eigenvalues of $B$, and\n${v}_{1}=[\\begin{aligned}-5 \\\\ 10\\end{aligned}]$, ${v}_{2}=[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ are the respective eigenvectors. Find the matrices $P$ and $D$ such that $PD{P}^{-1}=B,$ where $D$ is a diagonal  matrix." :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=3,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=-1,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=3.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}-5 & 3 \\\\ 10 & -2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f14c821e-9009-5e52-a0bb-21906b460837"] :db/ensure [:question/validate]} {:db/id "answer-field-f14c821e-9009-5e52-a0bb-21906b460837" :answer-field/id #uuid "f14c821e-9009-5e52-a0bb-21906b460837" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e8a73ef2-ec50-56f0-b4f1-bd31801ac7bd" :answer-field/choices ["answer-e8a73ef2-ec50-56f0-b4f1-bd31801ac7bd" "answer-476fd012-4ff3-5b8f-842c-88b817ba1b5a" "answer-cca8e467-abba-5462-8a16-29e9504f7afa" "answer-0fc7b182-c3fd-553c-be4d-b9112ef4c73c" "answer-cca96309-2d21-50a8-a577-57f0db5a2285"] :db/ensure [:answer-field/validate]} {:db/id "answer-e8a73ef2-ec50-56f0-b4f1-bd31801ac7bd" :answer/id #uuid "e8a73ef2-ec50-56f0-b4f1-bd31801ac7bd" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}]$ and  \n$P=[\\begin{aligned}-5 & 3 \\\\ 10 & -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-476fd012-4ff3-5b8f-842c-88b817ba1b5a" :answer/id #uuid "476fd012-4ff3-5b8f-842c-88b817ba1b5a" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-1 & 0 \\\\ 0 & 3\\end{aligned}]$ and   \n$P=[\\begin{aligned}-5 & 10 \\\\ -3 & 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-cca8e467-abba-5462-8a16-29e9504f7afa" :answer/id #uuid "cca8e467-abba-5462-8a16-29e9504f7afa" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$ and \n$P=[\\begin{aligned}3 & 5 \\\\ 2 & -10\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-0fc7b182-c3fd-553c-be4d-b9112ef4c73c" :answer/id #uuid "0fc7b182-c3fd-553c-be4d-b9112ef4c73c" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -1\\end{aligned}]$ and\n$P=[\\begin{aligned}18 & 10 \\\\ -12 & 20\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "answer-cca96309-2d21-50a8-a577-57f0db5a2285" :answer/id #uuid "cca96309-2d21-50a8-a577-57f0db5a2285" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -1\\end{aligned}]$ and  \n$P=[\\begin{aligned}-5 & -6 \\\\ 10 & 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "question-6fd075d3-5c0d-5ed0-b894-521c86e9d041" :question/id #uuid "6fd075d3-5c0d-5ed0-b894-521c86e9d041" :question/math-academy-id "q-80390" :question/problem "Consider the matrix $B$ for which ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-6$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nB=[\\begin{aligned}-2 & 1 \\\\ b & c\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & a\\end{aligned}]{[\\begin{aligned}-2 & 1 \\\\ b & c\\end{aligned}]}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-6,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}4 & 0 \\\\ 0 & -6\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=4,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=-6.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}-2 & 1 \\\\ 3 & -1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nB=[\\begin{aligned}-2 & 1 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & -6\\end{aligned}]{[\\begin{aligned}-2 & 1 \\\\ 3 & -1\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get  $a=-6,$ $b=3,$ and $c=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-0d1ee076-edf3-59a3-b4b4-741c65e4f36e"] :db/ensure [:question/validate]} {:db/id "answer-field-0d1ee076-edf3-59a3-b4b4-741c65e4f36e" :answer-field/id #uuid "0d1ee076-edf3-59a3-b4b4-741c65e4f36e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-dd070a2e-1a2a-5ae3-b78d-384a0ff8c386" :answer-field/choices ["answer-37e48fb2-660c-53b8-93a0-27743f953ddc" "answer-c00d7232-bdfa-5cfb-b569-88cbc0fac6e4" "answer-dd070a2e-1a2a-5ae3-b78d-384a0ff8c386" "answer-8bf90239-03ef-532c-98ec-7ef2aaa94acc" "answer-c9771c89-a09e-5299-9a9e-27fdcb26a027"] :db/ensure [:answer-field/validate]} {:db/id "answer-37e48fb2-660c-53b8-93a0-27743f953ddc" :answer/id #uuid "37e48fb2-660c-53b8-93a0-27743f953ddc" :answer/type :answer.type/text :answer/value "$a=-1,$ $b=3,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "answer-c00d7232-bdfa-5cfb-b569-88cbc0fac6e4" :answer/id #uuid "c00d7232-bdfa-5cfb-b569-88cbc0fac6e4" :answer/type :answer.type/text :answer/value "$a=-6,$ $b=-1,$ and $c=1$" :db/ensure [:answer/validate]} {:db/id "answer-dd070a2e-1a2a-5ae3-b78d-384a0ff8c386" :answer/id #uuid "dd070a2e-1a2a-5ae3-b78d-384a0ff8c386" :answer/type :answer.type/text :answer/value "$a=-6,$ $b=3,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "answer-8bf90239-03ef-532c-98ec-7ef2aaa94acc" :answer/id #uuid "8bf90239-03ef-532c-98ec-7ef2aaa94acc" :answer/type :answer.type/text :answer/value "$a=1,$ $b=-6,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "answer-c9771c89-a09e-5299-9a9e-27fdcb26a027" :answer/id #uuid "c9771c89-a09e-5299-9a9e-27fdcb26a027" :answer/type :answer.type/text :answer/value "$a=3,$ $b=-6,$ and $c=-1$" :db/ensure [:answer/validate]} {:db/id "question-3a4040a9-af29-5df2-8d92-a7f8acbeb04b" :question/id #uuid "3a4040a9-af29-5df2-8d92-a7f8acbeb04b" :question/math-academy-id "q-80451" :question/problem "Determine if the matrix \n$A=[\\begin{aligned}3 & -4 \\\\ 2 & -3\\end{aligned}]$ \nis diagonalizable or not, and if it is diagonalizable, find a corresponding diagonal matrix $D.$" :question/worked-solution "First, we find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0$:\n\n$$\n\\begin{aligned}|\\begin{aligned}3-\\lambda  & -4 \\\\ 2 & -3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(-3-\\lambda )-2\\cdot (-4) & =0 \\\\ {\\lambda }^{2}-1 & =0 \\\\ (\\lambda +1)(\\lambda -1) & =0\\end{aligned}\n$$\n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-1.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable.\n\nNow, we construct the diagonal matrix $D,$ as follows:\n\n$$\nD=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c4ed917e-4479-55fb-ae93-f553e926f059"] :db/ensure [:question/validate]} {:db/id "answer-field-c4ed917e-4479-55fb-ae93-f553e926f059" :answer-field/id #uuid "c4ed917e-4479-55fb-ae93-f553e926f059" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e6400608-0a28-5066-8778-f9b97a7687e6" :answer-field/choices ["answer-e6400608-0a28-5066-8778-f9b97a7687e6" "answer-310d49af-1694-516d-bd51-3515b36d8de3" "answer-7054bc25-ecf8-5bad-9c21-999a77440142" "answer-c49667d5-80f0-5ca4-aac6-19c3737abddf" "answer-89923f74-469b-51f3-b20e-5d752974d11c"] :db/ensure [:answer-field/validate]} {:db/id "answer-e6400608-0a28-5066-8778-f9b97a7687e6" :answer/id #uuid "e6400608-0a28-5066-8778-f9b97a7687e6" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-310d49af-1694-516d-bd51-3515b36d8de3" :answer/id #uuid "310d49af-1694-516d-bd51-3515b36d8de3" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}1 & 0 \\\\ 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-7054bc25-ecf8-5bad-9c21-999a77440142" :answer/id #uuid "7054bc25-ecf8-5bad-9c21-999a77440142" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-c49667d5-80f0-5ca4-aac6-19c3737abddf" :answer/id #uuid "c49667d5-80f0-5ca4-aac6-19c3737abddf" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}3 & 0 \\\\ 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "answer-89923f74-469b-51f3-b20e-5d752974d11c" :answer/id #uuid "89923f74-469b-51f3-b20e-5d752974d11c" :answer/type :answer.type/text :answer/value "$A$\n is not diagonalizable" :db/ensure [:answer/validate]} {:db/id 17592186073894 :knowledge-point/questions ["question-8252affb-ce2c-5680-9903-2378ac435a36" "question-7be9417a-a8b2-55e8-a3d3-285cb2bc9e4e"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073453 :question/problem "| $5$ | $4$ |\n| --- | --- |\n| $20$ | $\\bbox[3pt,Gainsboro]{\\color{red}?}$ |\n| $25$ | $20$ |\n\nWhat number is missing from the ratio table?" :question/worked-solution "We start with the ratio ${\\color{blue}5}:{\\color{red}4}$ and write it as a fraction:\n\n$$\n\\dfrac{\\color{blue}5}{\\color{red}4}\n$$\n\nSo the numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}4}$).\n\nWe can make a numerator of $20$ by multiplying the numerator and denominator by $4$:\n\n$$\n\\begin{aligned}\\frac{5\\times 4}{4\\times 4} & =\\frac{20}{16}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}4}$ |\n| --- | --- |\n| ${\\color{blue}20}$ | $\\bbox[3pt,Gainsboro]{\\color{red}16}$ |\n| ${\\color{blue}25}$ | ${\\color{red}20}$ |\n\nSo, the missing number is $\\color{red}16.$" :db/ensure [:question/validate]} {:db/id 17592186073895 :knowledge-point/questions ["question-dbd602d5-dd56-5f28-af09-18b7c946837e" "question-40bbff9d-d33b-5344-bec9-19d7e575474d"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073455 :question/problem "Complete the ratio table below.\n\n| $3$ | $5$ |\n| --- | --- |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $10$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $35$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $50$ |" :question/worked-solution "We start with the ratio ${\\color{blue}3}:{\\color{red}5}$ and write it as a fraction:\n\n$$\n\\dfrac{\\color{blue}3}{\\color{red}5}\n$$\n\nSo the numerator represents the left-hand entry (${\\color{blue}3}$), and the denominator represents the right-hand entry (${\\color{red}5}$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $10,$ we multiply the numerator and denominator of our fraction by $2{:}$\n\n$$\n\\dfrac{{\\color{blue}3}\\times 2}{{\\color{red}5}\\times 2} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}6}}{\\color{red}10}\n$$\n\n- To create a denominator of $35,$ we multiply the numerator and denominator of our fraction by $7{:}$\n\n$$\n\\dfrac{{\\color{blue}3}\\times 7}{{\\color{red}5}\\times 7} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}21}}{\\color{red}35}\n$$\n\n- To create a denominator of $50,$ we multiply the numerator and denominator of our fraction by $10{:}$\n\n$$\n\\dfrac{{\\color{blue}3}\\times 10}{{\\color{red}5}\\times 10} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}30}}{\\color{red}50}\n$$\n\nFinally, we fill in the ratio table:\n\n| ${\\color{blue}3}$ | ${\\color{red}5}$ |\n| --- | --- |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}6}$ | ${\\color{red}10}$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}21}$ | ${\\color{red}35}$ |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}30}$ | ${\\color{red}50}$ |" :db/ensure [:question/validate]} {:db/id 17592186073896 :knowledge-point/questions ["question-272bd94c-24fb-5dd4-a819-de450e5349fd" "question-6997b2fa-6238-5241-b0d8-8e5218a5b865"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073454 :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $6$ | $18$ |\n| --- | --- |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $24$ |\n| $20$ | $\\bbox[3pt,Gainsboro]{\\color{red}?}$ |" :question/worked-solution "We start with the ratio ${\\color{blue}6}:{\\color{red}18}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}6}}{{\\color{red}18}}\n$$\n\nSo the numerator represents the left-hand entry (${\\color{blue}6}$), and the denominator represents the right-hand entry (${\\color{red}18}$).\n\nNow we divide the numerator and the denominator by $6$ to find an equivalent ratio:\n\n$$\n\\dfrac{{\\color{blue}{6}}\\div 6}{{\\color{red}{18}}\\div 6} = \\dfrac{{\\color{blue}1}}{{\\color{red}3}}\n$$\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $24,$ we multiply the numerator and denominator of the previous fraction by $8{:}$\n\n$$\n\\dfrac{{\\color{blue}{1}}\\times 8}{{\\color{red}{3}}\\times 8} = \\dfrac{\\bbox[3pt,Gainsboro]{\\color{blue}8}}{{\\color{red}24}}\n$$\n\n- To create a numerator of $20,$ we multiply the numerator and denominator of our fraction by $20{:}$\n\n$$\n\\dfrac{{\\color{blue}{1}}\\times 20}{{\\color{red}{3}}\\times 20} = \\dfrac{{\\color{blue}20}}{\\bbox[3pt,Gainsboro]{\\color{red}60}}\n$$\n\nFinally, we fill in the ratio table:\n\n| ${\\color{blue}6}$ | ${\\color{red}18}$ |\n| --- | --- |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}8}$ | ${\\color{red}24}$ |\n| ${\\color{blue}20}$ | $\\bbox[3pt,Gainsboro]{\\color{red}60}$ |\n\nSo, from top to bottom, the missing numbers are $8$ and $60.$" :db/ensure [:question/validate]} {:db/id 17592186073897 :knowledge-point/questions ["question-dbfbb926-45f3-5b9a-aee3-a655234da83d" "question-6d7ddf31-a7e6-5f18-99b9-b50c085a5cc6"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073456 :question/problem "Harvey's parents reward him for each hour he spends helping with the housework. The following ratio table shows the number of hours of work Harvey did over the last three weeks and the corresponding rewards.\n\n| Reward (in dollars) | Hours of work |\n| --- | --- |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}?}$ | $3$ |\n| $12$ | $4$ |\n| $15$ | $\\bbox[3pt,Gainsboro]{\\color{red}?}$ |\n\nFrom top to bottom, what are the missing numbers in the ratio table?" :question/worked-solution "We start with the ratio ${\\color{blue}12}:{\\color{red}4}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}12}}{{\\color{red}4}}\n$$\n\n \n\nNow we divide the numerator and the denominator by $4$ to find an equivalent ratio:\n\n$$\n\\dfrac{{\\color{blue}{12}}\\div 4}{{\\color{red}{4}}\\div 4} = \\dfrac{{\\color{blue}3}}{{\\color{red}1}}\n$$\n\nWe can generate ratios that are equivalent to $3:1$ by finding more equivalent fractions: \n\n$$\n\\begin{aligned}\\frac{3\\times 3}{1\\times 3} & =\\frac{9}{3} \\\\ \\frac{3\\times 5}{1\\times 5} & =\\frac{15}{5}\\end{aligned}\n$$\n\nFinally, we fill in the ratio table:\n\n| Reward (in dollars) | Hours of work |\n| --- | --- |\n| $\\bbox[3pt,Gainsboro]{\\color{blue}9}$ | $3$ |\n| $12$ | $4$ |\n| $15$ | $\\bbox[3pt,Gainsboro]{\\color{red}5}$ |\n\nSo, from top to bottom, the missing numbers are $9$ and $5.$" :db/ensure [:question/validate]} {:db/id "question-8252affb-ce2c-5680-9903-2378ac435a36" :question/id #uuid "8252affb-ce2c-5680-9903-2378ac435a36" :question/math-academy-id "q-59908" :question/problem "| $4$ | $8$ |\n| --- | --- |\n| $12$ | $?$ |\n| $20$ | $40$ |\n\n$$\n\n$$\n\nWhat number is missing from the ratio table?" :question/worked-solution "We start with the ratio $4:8$ and write it as a fraction:\n\n$$\n\\frac{4}{8}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($8$).\n\nWe can make a numerator of $12$ by multiplying the numerator and denominator by $3$:\n\n$$\n\\begin{aligned}\\frac{4\\times 3}{8\\times 3} & =\\frac{12}{24}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| $4$ | $8$ |\n| --- | --- |\n| $12$ | $24$ |\n| $20$ | $40$ |\n\n$$\n\n$$\n\nSo, the missing number is $24.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c9f67718-c30c-53ea-8c6b-740f8fbb79d1"] :db/ensure [:question/validate]} {:db/id "answer-field-c9f67718-c30c-53ea-8c6b-740f8fbb79d1" :answer-field/id #uuid "c9f67718-c30c-53ea-8c6b-740f8fbb79d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-fa1fca0d-5971-54b5-9a02-2164a0393773" :answer-field/choices ["answer-4cc138c2-e90d-5f57-8ac1-8287ccae8fb6" "answer-d6760e45-5734-5f89-b9db-02339be9fc03" "answer-fa1fca0d-5971-54b5-9a02-2164a0393773" "answer-9f632e95-bd21-56d4-9e71-5831e2f4bc12" "answer-f55bf677-d168-5bf0-81b6-605b613ed5cb"] :db/ensure [:answer-field/validate]} {:db/id "answer-4cc138c2-e90d-5f57-8ac1-8287ccae8fb6" :answer/id #uuid "4cc138c2-e90d-5f57-8ac1-8287ccae8fb6" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "answer-d6760e45-5734-5f89-b9db-02339be9fc03" :answer/id #uuid "d6760e45-5734-5f89-b9db-02339be9fc03" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "answer-fa1fca0d-5971-54b5-9a02-2164a0393773" :answer/id #uuid "fa1fca0d-5971-54b5-9a02-2164a0393773" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "answer-9f632e95-bd21-56d4-9e71-5831e2f4bc12" :answer/id #uuid "9f632e95-bd21-56d4-9e71-5831e2f4bc12" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-f55bf677-d168-5bf0-81b6-605b613ed5cb" :answer/id #uuid "f55bf677-d168-5bf0-81b6-605b613ed5cb" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "question-7be9417a-a8b2-55e8-a3d3-285cb2bc9e4e" :question/id #uuid "7be9417a-a8b2-55e8-a3d3-285cb2bc9e4e" :question/math-academy-id "q-186855" :question/problem "Complete the ratio table below.\n\n| $4$ | $1$ |\n| --- | --- |\n| $16$ | {{field-1}} |\n| $20$ | {{field-2}} |\n| $28$ | {{field-3}} |" :question/worked-solution "We start with the ratio $4:1$ and write it as a fraction:\n\n$$\n\\frac{4}{1}\n$$\n\nSo the numerator represents the left-hand entry ($4$), and the denominator represents the right-hand entry ($1$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $16,$ we multiply the numerator and denominator of our fraction by $4:$\n\n$$\n\\frac{4\\times 4}{1\\times 4}=\\frac{16}{4}\n$$\n\n- To create a numerator of $20,$ we multiply the numerator and denominator of our fraction by $5:$\n\n$$\n\\frac{4\\times 5}{1\\times 5}=\\frac{20}{5}\n$$\n\n- To create a numerator of $28,$ we multiply the numerator and denominator of our fraction by $7:$\n\n$$\n\\frac{4\\times 7}{1\\times 7}=\\frac{28}{7}\n$$\n\nFinally, we fill in the ratio table:\n\n| $4$ | $1$ |\n| --- | --- |\n| $16$ | $4$ |\n| $20$ | $5$ |\n| $28$ | $7$ |\n\n$$\n\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-162dbc08-8a91-587b-910b-6ba5f6541414" "answer-field-9f720825-1327-550d-bfa6-d7ccc3f3dfa6" "answer-field-e59ddc14-0cae-59c7-a641-0d9d1cb6c80b"] :db/ensure [:question/validate]} {:db/id "answer-field-162dbc08-8a91-587b-910b-6ba5f6541414" :answer-field/id #uuid "162dbc08-8a91-587b-910b-6ba5f6541414" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-b985102f-7198-5bb1-adca-2ee25eb0d6cf" :answer-field/choices ["answer-b985102f-7198-5bb1-adca-2ee25eb0d6cf"] :db/ensure [:answer-field/validate]} {:db/id "answer-b985102f-7198-5bb1-adca-2ee25eb0d6cf" :answer/id #uuid "b985102f-7198-5bb1-adca-2ee25eb0d6cf" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "answer-field-9f720825-1327-550d-bfa6-d7ccc3f3dfa6" :answer-field/id #uuid "9f720825-1327-550d-bfa6-d7ccc3f3dfa6" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-e685455c-3081-54b9-bbdb-bb7905422163" :answer-field/choices ["answer-e685455c-3081-54b9-bbdb-bb7905422163"] :db/ensure [:answer-field/validate]} {:db/id "answer-e685455c-3081-54b9-bbdb-bb7905422163" :answer/id #uuid "e685455c-3081-54b9-bbdb-bb7905422163" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-field-e59ddc14-0cae-59c7-a641-0d9d1cb6c80b" :answer-field/id #uuid "e59ddc14-0cae-59c7-a641-0d9d1cb6c80b" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-8b1bbbd8-c453-5eb8-96c2-192aae4f03ca" :answer-field/choices ["answer-8b1bbbd8-c453-5eb8-96c2-192aae4f03ca"] :db/ensure [:answer-field/validate]} {:db/id "answer-8b1bbbd8-c453-5eb8-96c2-192aae4f03ca" :answer/id #uuid "8b1bbbd8-c453-5eb8-96c2-192aae4f03ca" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "question-dbd602d5-dd56-5f28-af09-18b7c946837e" :question/id #uuid "dbd602d5-dd56-5f28-af09-18b7c946837e" :question/math-academy-id "q-59919" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $3$ | $5$ |\n| --- | --- |\n| $12$ | $?$ |\n| $?$ | $30$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $3:5$ and write it as a fraction:\n\n$$\n\\frac{3}{5}\n$$\n\nSo the numerator represents the left-hand entry ($3$), and the denominator represents the right-hand entry ($5$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $12,$ we multiply the numerator and denominator of our fraction by $4:$\n\n$$\n\\frac{3\\times 4}{5\\times 4}=\\frac{12}{20}\n$$\n\n- To create a denominator of $30,$ we multiply the numerator and denominator of our fraction by $6:$\n\n$$\n\\frac{3\\times 6}{5\\times 6}=\\frac{18}{30}\n$$\n\nFinally, we fill in the ratio table:\n\n| $3$ | $5$ |\n| --- | --- |\n| $12$ | $20$ |\n| $18$ | $30$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $20$ and $18.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f3474f11-af66-5518-b854-1cdd4039db31"] :db/ensure [:question/validate]} {:db/id "answer-field-f3474f11-af66-5518-b854-1cdd4039db31" :answer-field/id #uuid "f3474f11-af66-5518-b854-1cdd4039db31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-1f57a605-82c6-5051-a1ba-842a49b1b335" :answer-field/choices ["answer-67a009a7-38a6-5f01-bf7a-e64f34a5eca5" "answer-28cb5c80-343b-58d3-9289-912d69ccd568" "answer-1f57a605-82c6-5051-a1ba-842a49b1b335" "answer-575dcf24-6e16-5de7-b066-f37a2862ab06" "answer-14da0cce-51ba-52e3-9233-86746af85c62"] :db/ensure [:answer-field/validate]} {:db/id "answer-67a009a7-38a6-5f01-bf7a-e64f34a5eca5" :answer/id #uuid "67a009a7-38a6-5f01-bf7a-e64f34a5eca5" :answer/type :answer.type/text :answer/value "$10$ and $15$" :db/ensure [:answer/validate]} {:db/id "answer-28cb5c80-343b-58d3-9289-912d69ccd568" :answer/id #uuid "28cb5c80-343b-58d3-9289-912d69ccd568" :answer/type :answer.type/text :answer/value "$15$ and $15$" :db/ensure [:answer/validate]} {:db/id "answer-1f57a605-82c6-5051-a1ba-842a49b1b335" :answer/id #uuid "1f57a605-82c6-5051-a1ba-842a49b1b335" :answer/type :answer.type/text :answer/value "$20$ and $18$" :db/ensure [:answer/validate]} {:db/id "answer-575dcf24-6e16-5de7-b066-f37a2862ab06" :answer/id #uuid "575dcf24-6e16-5de7-b066-f37a2862ab06" :answer/type :answer.type/text :answer/value "$20$ and $21$" :db/ensure [:answer/validate]} {:db/id "answer-14da0cce-51ba-52e3-9233-86746af85c62" :answer/id #uuid "14da0cce-51ba-52e3-9233-86746af85c62" :answer/type :answer.type/text :answer/value "$25$ and $18$" :db/ensure [:answer/validate]} {:db/id "question-40bbff9d-d33b-5344-bec9-19d7e575474d" :question/id #uuid "40bbff9d-d33b-5344-bec9-19d7e575474d" :question/math-academy-id "q-59921" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $5$ | $6$ |\n| --- | --- |\n| $?$ | $24$ |\n| $30$ | $?$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $5:6$ and write it as a fraction:\n\n$$\n\\frac{5}{6}\n$$\n\nSo the numerator represents the left-hand entry ($5$), and the denominator represents the right-hand entry ($6$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a denominator of $24,$ we multiply the numerator and denominator of our fraction by $4:$\n\n$$\n\\frac{5\\times 4}{6\\times 4}=\\frac{20}{24}\n$$\n\n- To create a numerator of $30,$ we multiply the numerator and denominator of our fraction by $6:$\n\n$$\n\\frac{5\\times 6}{6\\times 6}=\\frac{30}{36}\n$$\n\nFinally, we fill in the ratio table:\n\n| $5$ | $6$ |\n| --- | --- |\n| $20$ | $24$ |\n| $30$ | $36$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $20$ and $36.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ad0791ec-ba86-59af-80db-e0d45756c328"] :db/ensure [:question/validate]} {:db/id "answer-field-ad0791ec-ba86-59af-80db-e0d45756c328" :answer-field/id #uuid "ad0791ec-ba86-59af-80db-e0d45756c328" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4d10cdf4-6781-5eff-ace5-24389d9da09a" :answer-field/choices ["answer-79748308-7ed9-59fa-b641-d77c77cce124" "answer-b15ca865-115b-5ec5-b682-8e85963271a7" "answer-4d10cdf4-6781-5eff-ace5-24389d9da09a" "answer-610b5d00-47bf-5fde-81d4-cf9e5c20321f" "answer-9897e9a7-c28a-5174-ae10-b4cc814cf434"] :db/ensure [:answer-field/validate]} {:db/id "answer-79748308-7ed9-59fa-b641-d77c77cce124" :answer/id #uuid "79748308-7ed9-59fa-b641-d77c77cce124" :answer/type :answer.type/text :answer/value "$15$ and $18$" :db/ensure [:answer/validate]} {:db/id "answer-b15ca865-115b-5ec5-b682-8e85963271a7" :answer/id #uuid "b15ca865-115b-5ec5-b682-8e85963271a7" :answer/type :answer.type/text :answer/value "$20$ and $30$" :db/ensure [:answer/validate]} {:db/id "answer-4d10cdf4-6781-5eff-ace5-24389d9da09a" :answer/id #uuid "4d10cdf4-6781-5eff-ace5-24389d9da09a" :answer/type :answer.type/text :answer/value "$20$ and $36$" :db/ensure [:answer/validate]} {:db/id "answer-610b5d00-47bf-5fde-81d4-cf9e5c20321f" :answer/id #uuid "610b5d00-47bf-5fde-81d4-cf9e5c20321f" :answer/type :answer.type/text :answer/value "$25$ and $30$" :db/ensure [:answer/validate]} {:db/id "answer-9897e9a7-c28a-5174-ae10-b4cc814cf434" :answer/id #uuid "9897e9a7-c28a-5174-ae10-b4cc814cf434" :answer/type :answer.type/text :answer/value "$25$ and $36$" :db/ensure [:answer/validate]} {:db/id "question-272bd94c-24fb-5dd4-a819-de450e5349fd" :question/id #uuid "272bd94c-24fb-5dd4-a819-de450e5349fd" :question/math-academy-id "q-187261" :question/problem "Complete the ratio table below.\n\n| $4$ | {{field-1}} |\n| --- | --- |\n| $8$ | $24$ |\n| {{field-2}} | $27$ |" :question/worked-solution "We start with the ratio $8:24$ and write it as a fraction:\n\n$$\n\\frac{8}{24}\n$$\n\nSo the numerator represents the left-hand entry ($8$), and the denominator represents the right-hand entry ($24$).\n\nNow we divide the numerator and the denominator by $8$ to find an equivalent ratio:\n\n$$\n\\frac{8÷8}{24÷8}=\\frac{1}{3}\n$$\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $4,$ we multiply the numerator and denominator of our fraction by $4:$\n\n$$\n\\begin{aligned}\\frac{1\\times 4}{3\\times 4}=\\frac{4}{12}\\end{aligned}\n$$\n\n- To create a denominator of $27,$ we multiply the numerator and denominator of our fraction by $9:$\n\n$$\n\\begin{aligned}\\frac{1\\times 9}{3\\times 9} & =\\frac{9}{27}\\end{aligned}\n$$\n\nFinally, we fill in the ratio table:\n\n| $4$ | $12$ |\n| --- | --- |\n| $8$ | $24$ |\n| $9$ | $27$ |\n\n$$\n\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-ed832557-0285-50b8-a5d1-da04c4e2343e" "answer-field-67b9741b-a8c6-5231-90e7-2cb77a97f95d"] :db/ensure [:question/validate]} {:db/id "answer-field-ed832557-0285-50b8-a5d1-da04c4e2343e" :answer-field/id #uuid "ed832557-0285-50b8-a5d1-da04c4e2343e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-f7022bb8-c707-5b84-9636-a7fcbe183744" :answer-field/choices ["answer-f7022bb8-c707-5b84-9636-a7fcbe183744"] :db/ensure [:answer-field/validate]} {:db/id "answer-f7022bb8-c707-5b84-9636-a7fcbe183744" :answer/id #uuid "f7022bb8-c707-5b84-9636-a7fcbe183744" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "answer-field-67b9741b-a8c6-5231-90e7-2cb77a97f95d" :answer-field/id #uuid "67b9741b-a8c6-5231-90e7-2cb77a97f95d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-6a72e4bb-1ec1-57eb-a077-7a6be84fbb85" :answer-field/choices ["answer-6a72e4bb-1ec1-57eb-a077-7a6be84fbb85"] :db/ensure [:answer-field/validate]} {:db/id "answer-6a72e4bb-1ec1-57eb-a077-7a6be84fbb85" :answer/id #uuid "6a72e4bb-1ec1-57eb-a077-7a6be84fbb85" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "question-6997b2fa-6238-5241-b0d8-8e5218a5b865" :question/id #uuid "6997b2fa-6238-5241-b0d8-8e5218a5b865" :question/math-academy-id "q-59926" :question/problem "From top to bottom, what are the missing numbers in the ratio table below?\n\n| $2$ | $?$ |\n| --- | --- |\n| $?$ | $16$ |\n| $6$ | $24$ |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $6:24$ and write it as a fraction:\n\n$$\n\\frac{6}{24}\n$$\n\nSo the numerator represents the left-hand entry ($6$), and the denominator represents the right-hand entry ($24$).\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n- To create a numerator of $2,$ we divide the numerator and denominator of our fraction by $3:$\n\n$$\n\\frac{6÷3}{24÷3}=\\frac{2}{8}\n$$\n\n- To create a denominator of $16,$ we multiply the numerator and denominator of the previous fraction by $2:$\n\n$$\n\\frac{2\\times 2}{8\\times 2}=\\frac{4}{16}\n$$\n\nFinally, we fill in the ratio table:\n\n| $2$ | $8$ |\n| --- | --- |\n| $4$ | $16$ |\n| $6$ | $24$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $8$ and $4.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-9cc223b1-a51e-5700-b7e2-be0125a1cd8b"] :db/ensure [:question/validate]} {:db/id "answer-field-9cc223b1-a51e-5700-b7e2-be0125a1cd8b" :answer-field/id #uuid "9cc223b1-a51e-5700-b7e2-be0125a1cd8b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-e2e1e419-a2ab-533d-8a4a-11d178051877" :answer-field/choices ["answer-a01c7926-bbc0-5c2b-a7a7-1e039a2f7cda" "answer-6bba0edd-993f-54e4-a048-824d34e1cd48" "answer-03982a3d-b698-5cbc-9d2a-69e4fb2d8065" "answer-e2e1e419-a2ab-533d-8a4a-11d178051877" "answer-ebaceeee-c9cb-58a1-a200-48e7ba2095ab"] :db/ensure [:answer-field/validate]} {:db/id "answer-a01c7926-bbc0-5c2b-a7a7-1e039a2f7cda" :answer/id #uuid "a01c7926-bbc0-5c2b-a7a7-1e039a2f7cda" :answer/type :answer.type/text :answer/value "$1$ and $60$" :db/ensure [:answer/validate]} {:db/id "answer-6bba0edd-993f-54e4-a048-824d34e1cd48" :answer/id #uuid "6bba0edd-993f-54e4-a048-824d34e1cd48" :answer/type :answer.type/text :answer/value "$12$ and $8$" :db/ensure [:answer/validate]} {:db/id "answer-03982a3d-b698-5cbc-9d2a-69e4fb2d8065" :answer/id #uuid "03982a3d-b698-5cbc-9d2a-69e4fb2d8065" :answer/type :answer.type/text :answer/value "$3$ and $12$" :db/ensure [:answer/validate]} {:db/id "answer-e2e1e419-a2ab-533d-8a4a-11d178051877" :answer/id #uuid "e2e1e419-a2ab-533d-8a4a-11d178051877" :answer/type :answer.type/text :answer/value "$8$ and $4$" :db/ensure [:answer/validate]} {:db/id "answer-ebaceeee-c9cb-58a1-a200-48e7ba2095ab" :answer/id #uuid "ebaceeee-c9cb-58a1-a200-48e7ba2095ab" :answer/type :answer.type/text :answer/value "$8$ and $6$" :db/ensure [:answer/validate]} {:db/id "question-dbfbb926-45f3-5b9a-aee3-a655234da83d" :question/id #uuid "dbfbb926-45f3-5b9a-aee3-a655234da83d" :question/math-academy-id "q-92829" :question/problem "Liam wants to paint a fence. He knows he needs $2$ liters of paint for $32$ square meters of fence. He creates a ratio table to determine the ratio of the volume of paint to the fenced area for different quantities.\n\n| Fence area (square meters) | Paint (liters) |\n| --- | --- |\n| $32$ | $2$ |\n| $80$ | $?$ |\n| $160$ | $10$ |\n\n$$\n\n$$\n\nWhat volume of paint does Liam need to paint $80$ square meters of the fence?" :question/worked-solution "We start with the ratio $32:2$ and write it as a fraction:\n\n$$\n\\frac{32}{2}\n$$\n\nNow we divide the numerator and the denominator by $2$ to find an equivalent ratio:\n\n$$\n\\frac{32÷2}{2÷2}=\\frac{16}{1}\n$$\n\nSo the numerator represents the area of the fence in ${\\text{m}}^{2}$ ($16$), and the denominator represents the volume of paint in liters ($1$).\n\nWe can make a numerator of $80$ by multiplying the numerator and denominator by $5$:\n\n$$\n\\begin{aligned}\\frac{16\\times 5}{1\\times 5} & =\\frac{80}{5}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| Fence area (square meters) | Paint (liters) |\n| --- | --- |\n| $32$ | $2$ |\n| $80$ | $5$ |\n| $160$ | $10$ |\n\n$$\n\n$$\n\nSo, Liam needs $5$ liters of paint for $80$ square meters of the fence." :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-85127a9c-4be9-56e7-b690-1f020f8d5f28"] :db/ensure [:question/validate]} {:db/id "answer-field-85127a9c-4be9-56e7-b690-1f020f8d5f28" :answer-field/id #uuid "85127a9c-4be9-56e7-b690-1f020f8d5f28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f5e2586b-5055-5e6a-8fd8-2cfa7a0648a3" :answer-field/choices ["answer-52d99b57-1f93-5ce2-8fa0-0b81d4a6db9e" "answer-f5e2586b-5055-5e6a-8fd8-2cfa7a0648a3" "answer-b515f4a3-f4c9-5b94-bfca-1a1cd1c43525" "answer-45b1dd72-a280-5786-9c0c-78bfc1059520" "answer-ba74b686-4983-5947-8325-76e2a9877067"] :db/ensure [:answer-field/validate]} {:db/id "answer-52d99b57-1f93-5ce2-8fa0-0b81d4a6db9e" :answer/id #uuid "52d99b57-1f93-5ce2-8fa0-0b81d4a6db9e" :answer/type :answer.type/text :answer/value "$4$ liters" :db/ensure [:answer/validate]} {:db/id "answer-f5e2586b-5055-5e6a-8fd8-2cfa7a0648a3" :answer/id #uuid "f5e2586b-5055-5e6a-8fd8-2cfa7a0648a3" :answer/type :answer.type/text :answer/value "$5$ liters" :db/ensure [:answer/validate]} {:db/id "answer-b515f4a3-f4c9-5b94-bfca-1a1cd1c43525" :answer/id #uuid "b515f4a3-f4c9-5b94-bfca-1a1cd1c43525" :answer/type :answer.type/text :answer/value "$6$ liters" :db/ensure [:answer/validate]} {:db/id "answer-45b1dd72-a280-5786-9c0c-78bfc1059520" :answer/id #uuid "45b1dd72-a280-5786-9c0c-78bfc1059520" :answer/type :answer.type/text :answer/value "$7$ liters" :db/ensure [:answer/validate]} {:db/id "answer-ba74b686-4983-5947-8325-76e2a9877067" :answer/id #uuid "ba74b686-4983-5947-8325-76e2a9877067" :answer/type :answer.type/text :answer/value "$8$ liters" :db/ensure [:answer/validate]} {:db/id "question-6d7ddf31-a7e6-5f18-99b9-b50c085a5cc6" :question/id #uuid "6d7ddf31-a7e6-5f18-99b9-b50c085a5cc6" :question/math-academy-id "q-160319" :question/problem "In one hour, a crew of $4$ painters can cover $28$ square meters of a wall's surface in a newly constructed building. A construction manager has created a ratio table to determine how many square meters of the wall's surface can be covered in one hour by crews of $6$ and $9$ painters.\n\n| Painters | Square meters |\n| --- | --- |\n| $4$ | $28$ |\n| $6$ | $?$ |\n| $9$ | $?$ |\n\n$$\n\n$$\n\nFrom top to bottom, what are the missing numbers in the ratio table?" :question/worked-solution "We start with the ratio $4:28$ and write it as a fraction:\n\n$$\n\\frac{4}{28}\n$$\n\nNow we divide the numerator and the denominator by $4$ to find an equivalent ratio:\n\n$$\n\\frac{4÷4}{28÷4}=\\frac{1}{7}\n$$\n\nWe can generate ratios that are equivalent to $1:7$ by finding more equivalent fractions: \n\n$$\n\\begin{aligned}\\frac{1\\times 6}{7\\times 6} & =\\frac{6}{42} \\\\ \\frac{1\\times 9}{7\\times 9} & =\\frac{9}{63}\\end{aligned}\n$$\n\nFinally, we fill in the ratio table:\n\n| Painters | Square meters |\n| --- | --- |\n| $4$ | $28$ |\n| $6$ | $42$ |\n| $9$ | $63$ |\n\n$$\n\n$$\n\nSo, from top to bottom, the missing numbers are $42$ and $63.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-10a05c80-83c7-54ba-9f10-aa28372e02d7"] :db/ensure [:question/validate]} {:db/id "answer-field-10a05c80-83c7-54ba-9f10-aa28372e02d7" :answer-field/id #uuid "10a05c80-83c7-54ba-9f10-aa28372e02d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-afe68c59-d514-50d2-9d8b-12632db635b4" :answer-field/choices ["answer-9a0943b7-c595-5b56-9647-4cabc8022834" "answer-a5071adc-37ea-5ee5-858b-7aa3feda483b" "answer-afe68c59-d514-50d2-9d8b-12632db635b4" "answer-b34970b8-59b3-5145-81e4-7a4fb34f2df7" "answer-d56ccfda-614b-5b74-9f28-e731d102e4fa"] :db/ensure [:answer-field/validate]} {:db/id "answer-9a0943b7-c595-5b56-9647-4cabc8022834" :answer/id #uuid "9a0943b7-c595-5b56-9647-4cabc8022834" :answer/type :answer.type/text :answer/value "$36$ and $54$" :db/ensure [:answer/validate]} {:db/id "answer-a5071adc-37ea-5ee5-858b-7aa3feda483b" :answer/id #uuid "a5071adc-37ea-5ee5-858b-7aa3feda483b" :answer/type :answer.type/text :answer/value "$42$ and $56$" :db/ensure [:answer/validate]} {:db/id "answer-afe68c59-d514-50d2-9d8b-12632db635b4" :answer/id #uuid "afe68c59-d514-50d2-9d8b-12632db635b4" :answer/type :answer.type/text :answer/value "$42$ and $63$" :db/ensure [:answer/validate]} {:db/id "answer-b34970b8-59b3-5145-81e4-7a4fb34f2df7" :answer/id #uuid "b34970b8-59b3-5145-81e4-7a4fb34f2df7" :answer/type :answer.type/text :answer/value "$48$ and $72$" :db/ensure [:answer/validate]} {:db/id "answer-d56ccfda-614b-5b74-9f28-e731d102e4fa" :answer/id #uuid "d56ccfda-614b-5b74-9f28-e731d102e4fa" :answer/type :answer.type/text :answer/value "$56$ and $63$" :db/ensure [:answer/validate]} {:db/id 17592186075038 :tutorial/content "Let's take a look at the following equivalent ratios:\n\n![](images/6c/6cda61e0fbd0d9695644a29f0c6fa3478eae84cf253623da7f4b544f35873472.svg)\n\nWe can place the equivalent ratios in a **ratio table**, such as the one below. In a ratio table, each row represents a ratio.\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}\\textrm{?}}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nOne number is missing. Let's figure out what it is.\n\nWe start with the ratio ${\\color{blue}5}:{\\color{red}10},$ which is the first ratio in the table. Writing this ratio as a fraction, we have\n\n$$\n\\dfrac{{\\color{blue}5}}{{\\color{red}10}}.\n$$\n\nThe numerator represents the left-hand entry (${\\color{blue}5}$), and the denominator represents the right-hand entry (${\\color{red}10}$).\n\nTo find the missing number, we need to make a numerator of ${\\color{blue}10}.$ We can do this by multiplying the numerator and denominator by $2$:\n\n$$\n\\begin{aligned}\\frac{5\\times 2}{10\\times 2} & =\\frac{10}{20}\\end{aligned}\n$$\n\nWe now add this to our ratio table:\n\n| ${\\color{blue}5}$ | ${\\color{red}10}$ |\n| --- | --- |\n| ${\\color{blue}10}$ | $\\bbox[3pt,Gainsboro]{\\color{red}20}$ |\n| ${\\color{blue}20}$ | ${\\color{red}40}$ |\n\nSo, the missing number is $\\color{red}20.$" :db/ensure [:tutorial/validate]} {:db/id 17592186073973 :activity/expected-seconds 480.0 :db/ensure [:activity/validate]} {:db/id "activity-6a553618-5c66-5afb-86a1-1946f278abb1" :activity/id #uuid "6a553618-5c66-5afb-86a1-1946f278abb1" :activity/title "The Jacobian" :activity/type :activity.type/review :activity/scope 17592186048219 :activity/course 17592186046658 :activity/steps ["step-7c759ad4-118a-5640-8541-f043eacd3dfa" "step-f6c3f5ae-5f8f-5a7a-afc4-853d435ac787" "step-4fa42bc9-be17-531f-a7dc-f623674b521c" "step-0f09f356-128b-5de9-9495-de9456b0bf64" "step-d71e7421-f7d7-5b0d-a0cf-88887ecfeaf3"] :activity/first-step "step-7c759ad4-118a-5640-8541-f043eacd3dfa" :db/ensure [:activity/validate]} {:db/id "step-7c759ad4-118a-5640-8541-f043eacd3dfa" :step/id #uuid "7c759ad4-118a-5640-8541-f043eacd3dfa" :step/content 17592186129508 :step/next "step-f6c3f5ae-5f8f-5a7a-afc4-853d435ac787" :db/ensure [:step/validate]} {:db/id "step-f6c3f5ae-5f8f-5a7a-afc4-853d435ac787" :step/id #uuid "f6c3f5ae-5f8f-5a7a-afc4-853d435ac787" :step/content 17592186369873 :step/next "step-4fa42bc9-be17-531f-a7dc-f623674b521c" :db/ensure [:step/validate]} {:db/id "step-4fa42bc9-be17-531f-a7dc-f623674b521c" :step/id #uuid "4fa42bc9-be17-531f-a7dc-f623674b521c" :step/content 17592186281352 :step/next "step-0f09f356-128b-5de9-9495-de9456b0bf64" :db/ensure [:step/validate]} {:db/id "step-0f09f356-128b-5de9-9495-de9456b0bf64" :step/id #uuid "0f09f356-128b-5de9-9495-de9456b0bf64" :step/content 17592186281360 :step/next "step-d71e7421-f7d7-5b0d-a0cf-88887ecfeaf3" :db/ensure [:step/validate]} {:db/id "step-d71e7421-f7d7-5b0d-a0cf-88887ecfeaf3" :step/id #uuid "d71e7421-f7d7-5b0d-a0cf-88887ecfeaf3" :step/content 17592186383575 :db/ensure [:step/validate]} {:db/id 17592186147573 :knowledge-point/questions ["question-18785939-b974-5701-b389-cadf361ecc61" "question-87a9ebe9-f422-5f29-8cbc-96b3a193eef9" "question-3efa1a19-2402-5224-861f-b75cf9662684" "question-5d49f434-9d0b-5e27-b0e6-72bd037cd1ef"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147146 :question/problem "What is the missing number?\n\n$\\qquad$ ![](images/81/81b70e75c29649960c40e1fde55949f210718ebc3ea188686742605717512933.svg) of $20 = 35$" :question/worked-solution "We can write the given problem as the following product:\n\n![](images/44/44ceb7ccb604fc5f57bb5be3f77c564716f4bd9281c07d349d89fe298ae0e43a.svg)\n\nUsing the relationship between multiplication and division, we can write our problem as follows:\n![](images/5c/5c86d175be61156120db260d435e715db5b7e123a707d860a043582469ac0455.svg)\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{35}{20} = \\dfrac{35 \\times 5}{20 \\times 5} = \\dfrac{175}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\dfrac{175}{100} = 175 \\%\n$$" :db/ensure [:question/validate]} {:db/id 17592186147574 :knowledge-point/questions ["question-bbef286c-e7f0-513c-aea2-c85d78514b95" "question-c8729d6f-e93e-5d82-996f-965f9918c012"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186147147 :question/problem "If ![](images/0b/0b6591a213a91a5c24d49c3aca4f54fb5812bb64e3f0015c29be323e75484da9.svg) then ![](images/11/1165d6dd086f396f3473dd6da171256cc78ceeef91ce3d3bc128c3e82a9aafd9.svg)" :question/worked-solution "Using the relationship between multiplication and division, we can write our problem as follows:\n![](images/5e/5eabee5d5350cd0d0ab35358f35078c5e3dc1c788ac176804f62753462c2ca34.svg)\n\nWe can simplify this fraction as follows:\n\n$$\n\\dfrac{7}{35} = \\dfrac{7 \\div 7}{35 \\div 7} = \\dfrac{1}{5}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{1}{5} = \\dfrac{1 \\times 20}{5 \\times 20} = \\dfrac{20}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\dfrac{20}{100} = 20\\%\n$$" :db/ensure [:question/validate]} {:db/id "question-18785939-b974-5701-b389-cadf361ecc61" :question/id #uuid "18785939-b974-5701-b389-cadf361ecc61" :question/math-academy-id "q-185129" :question/problem "What is the missing number?\n\n{{field-1}}\n$%$ of $2=6$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 2=6\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=6÷2=\\frac{6}{2}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{6}{2}=\\frac{6\\times 50}{2\\times 50}=\\frac{300}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{300}{100}=300\\,%\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-d2170713-cf77-5b28-8eb2-0e805dae3966"] :db/ensure [:question/validate]} {:db/id "answer-field-d2170713-cf77-5b28-8eb2-0e805dae3966" :answer-field/id #uuid "d2170713-cf77-5b28-8eb2-0e805dae3966" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-2e202390-e5c9-5c4e-b2c1-1c323f0ef475" :answer-field/choices ["answer-2e202390-e5c9-5c4e-b2c1-1c323f0ef475"] :db/ensure [:answer-field/validate]} {:db/id "answer-2e202390-e5c9-5c4e-b2c1-1c323f0ef475" :answer/id #uuid "2e202390-e5c9-5c4e-b2c1-1c323f0ef475" :answer/type :answer.type/math :answer/value "300" :db/ensure [:answer/validate]} {:db/id "question-87a9ebe9-f422-5f29-8cbc-96b3a193eef9" :question/id #uuid "87a9ebe9-f422-5f29-8cbc-96b3a193eef9" :question/math-academy-id "q-60920" :question/problem "What is the missing number?\n\n$\\,$ $\\boxed{}\\,%$ of $5=3$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 5=3\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=3÷5=\\frac{3}{5}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{3}{5}=\\frac{3\\times 20}{5\\times 20}=\\frac{60}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{60}{100}=60%\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-f074260e-1161-5ec2-9b60-862ec3681ab9"] :db/ensure [:question/validate]} {:db/id "answer-field-f074260e-1161-5ec2-9b60-862ec3681ab9" :answer-field/id #uuid "f074260e-1161-5ec2-9b60-862ec3681ab9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c8ade847-5a50-56c1-b95c-3754185f0121" :answer-field/choices ["answer-d58400ea-a4d2-5e83-9e0b-4702151398e9" "answer-250b7190-cdbb-5d32-b51b-b93844676a68" "answer-4960e0dc-4a2a-5127-9a54-50c9b5898315" "answer-c8ade847-5a50-56c1-b95c-3754185f0121" "answer-7112fd4e-0fe7-50b8-acd2-d1dd64c5c185"] :db/ensure [:answer-field/validate]} {:db/id "answer-d58400ea-a4d2-5e83-9e0b-4702151398e9" :answer/id #uuid "d58400ea-a4d2-5e83-9e0b-4702151398e9" :answer/type :answer.type/math :answer/value "35" :db/ensure [:answer/validate]} {:db/id "answer-250b7190-cdbb-5d32-b51b-b93844676a68" :answer/id #uuid "250b7190-cdbb-5d32-b51b-b93844676a68" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "answer-4960e0dc-4a2a-5127-9a54-50c9b5898315" :answer/id #uuid "4960e0dc-4a2a-5127-9a54-50c9b5898315" :answer/type :answer.type/math :answer/value "45" :db/ensure [:answer/validate]} {:db/id "answer-c8ade847-5a50-56c1-b95c-3754185f0121" :answer/id #uuid "c8ade847-5a50-56c1-b95c-3754185f0121" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "answer-7112fd4e-0fe7-50b8-acd2-d1dd64c5c185" :answer/id #uuid "7112fd4e-0fe7-50b8-acd2-d1dd64c5c185" :answer/type :answer.type/math :answer/value "65" :db/ensure [:answer/validate]} {:db/id "question-3efa1a19-2402-5224-861f-b75cf9662684" :question/id #uuid "3efa1a19-2402-5224-861f-b75cf9662684" :question/math-academy-id "q-148051" :question/problem "What is the missing number?\n\n$\\,$ $\\boxed{}\\,%$ of $25=40$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 25=40\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=40÷25=\\frac{40}{25}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{40}{25}=\\frac{40\\times 4}{25\\times 4}=\\frac{160}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{160}{100}=160%\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-c5003fc5-5077-5aac-96d3-91784251d114"] :db/ensure [:question/validate]} {:db/id "answer-field-c5003fc5-5077-5aac-96d3-91784251d114" :answer-field/id #uuid "c5003fc5-5077-5aac-96d3-91784251d114" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-9e3564ce-20aa-5dd9-8582-52a7f48aa3dd" :answer-field/choices ["answer-aad92959-356f-5281-b44f-276729d69382" "answer-9e3564ce-20aa-5dd9-8582-52a7f48aa3dd" "answer-89d06a78-0268-5589-bbe5-1f803fd17784" "answer-eaef82ad-2d7a-51ac-9e84-46b14c86db3f" "answer-a4ed59b0-bae6-5f11-942c-85bfea14ce27"] :db/ensure [:answer-field/validate]} {:db/id "answer-aad92959-356f-5281-b44f-276729d69382" :answer/id #uuid "aad92959-356f-5281-b44f-276729d69382" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "answer-9e3564ce-20aa-5dd9-8582-52a7f48aa3dd" :answer/id #uuid "9e3564ce-20aa-5dd9-8582-52a7f48aa3dd" :answer/type :answer.type/math :answer/value "160" :db/ensure [:answer/validate]} {:db/id "answer-89d06a78-0268-5589-bbe5-1f803fd17784" :answer/id #uuid "89d06a78-0268-5589-bbe5-1f803fd17784" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "answer-eaef82ad-2d7a-51ac-9e84-46b14c86db3f" :answer/id #uuid "eaef82ad-2d7a-51ac-9e84-46b14c86db3f" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id "answer-a4ed59b0-bae6-5f11-942c-85bfea14ce27" :answer/id #uuid "a4ed59b0-bae6-5f11-942c-85bfea14ce27" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "question-5d49f434-9d0b-5e27-b0e6-72bd037cd1ef" :question/id #uuid "5d49f434-9d0b-5e27-b0e6-72bd037cd1ef" :question/math-academy-id "q-185118" :question/problem "What is the missing number?\n\n{{field-1}}\n$%$ of $50=6$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 50=6\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=6÷50=\\frac{6}{50}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{6}{50}=\\frac{6\\times 2}{50\\times 2}=\\frac{12}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{12}{100}=12\\,%\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-3d74afdb-af68-5e9f-b763-51f7dde7290f"] :db/ensure [:question/validate]} {:db/id "answer-field-3d74afdb-af68-5e9f-b763-51f7dde7290f" :answer-field/id #uuid "3d74afdb-af68-5e9f-b763-51f7dde7290f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-1c8ef103-7dda-5729-b76a-74b66a558bd1" :answer-field/choices ["answer-1c8ef103-7dda-5729-b76a-74b66a558bd1"] :db/ensure [:answer-field/validate]} {:db/id "answer-1c8ef103-7dda-5729-b76a-74b66a558bd1" :answer/id #uuid "1c8ef103-7dda-5729-b76a-74b66a558bd1" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "question-bbef286c-e7f0-513c-aea2-c85d78514b95" :question/id #uuid "bbef286c-e7f0-513c-aea2-c85d78514b95" :question/math-academy-id "q-185152" :question/problem "What is the missing number?\n\n$28\\,\\times $\n{{field-1}}\n$%=7$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 28=7\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=7÷28=\\frac{7}{28}\n$$\n\nWe can simplify this fraction as follows:\n\n$$\n\\frac{7}{28}=\\frac{7÷7}{28÷7}=\\frac{1}{4}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{1}{4}=\\frac{1\\times 25}{4\\times 25}=\\frac{25}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{25}{100}=25\\,%\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-173b46a0-52f2-51a5-9db7-2ae7f3e86440"] :db/ensure [:question/validate]} {:db/id "answer-field-173b46a0-52f2-51a5-9db7-2ae7f3e86440" :answer-field/id #uuid "173b46a0-52f2-51a5-9db7-2ae7f3e86440" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-c00539cb-4e19-5ee7-9dce-b65ad4e45642" :answer-field/choices ["answer-c00539cb-4e19-5ee7-9dce-b65ad4e45642"] :db/ensure [:answer-field/validate]} {:db/id "answer-c00539cb-4e19-5ee7-9dce-b65ad4e45642" :answer/id #uuid "c00539cb-4e19-5ee7-9dce-b65ad4e45642" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "question-c8729d6f-e93e-5d82-996f-965f9918c012" :question/id #uuid "c8729d6f-e93e-5d82-996f-965f9918c012" :question/math-academy-id "q-148054" :question/problem "What is the missing number?\n\n$\\,$ $\\boxed{}\\,%$ of $14=35$" :question/worked-solution "We can write the given problem as the following product:\n\n$$\n\\boxed{}\\,%\\times 14=35\n$$\n\nUsing the relationship between multiplication and division, we can write our problem as:\n\n$$\n\\boxed{}\\,%=35÷14=\\frac{35}{14}\n$$\n\nWe can simplify this fraction as follows:\n\n$$\n\\frac{35}{14}=\\frac{35÷7}{14÷7}=\\frac{5}{2}\n$$\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\frac{5}{2}=\\frac{5\\times 50}{2\\times 50}=\\frac{250}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\frac{250}{100}=250%\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ae4dbb0f-0d11-5e44-893c-bf8b0e203321"] :db/ensure [:question/validate]} {:db/id "answer-field-ae4dbb0f-0d11-5e44-893c-bf8b0e203321" :answer-field/id #uuid "ae4dbb0f-0d11-5e44-893c-bf8b0e203321" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3f731da2-101a-5cc2-bfd8-34bfd1cb8353" :answer-field/choices ["answer-edfcddf2-a4c0-5bd1-a3e4-e42049e94b1d" "answer-88cdf51f-8de3-5db3-85f6-efc273fe932e" "answer-3f731da2-101a-5cc2-bfd8-34bfd1cb8353" "answer-067991d8-b641-57f3-9108-03d53b4a6751" "answer-e4692d29-df3f-5906-be3b-0b79ffde0a74"] :db/ensure [:answer-field/validate]} {:db/id "answer-edfcddf2-a4c0-5bd1-a3e4-e42049e94b1d" :answer/id #uuid "edfcddf2-a4c0-5bd1-a3e4-e42049e94b1d" :answer/type :answer.type/math :answer/value "150" :db/ensure [:answer/validate]} {:db/id "answer-88cdf51f-8de3-5db3-85f6-efc273fe932e" :answer/id #uuid "88cdf51f-8de3-5db3-85f6-efc273fe932e" :answer/type :answer.type/math :answer/value "170" :db/ensure [:answer/validate]} {:db/id "answer-3f731da2-101a-5cc2-bfd8-34bfd1cb8353" :answer/id #uuid "3f731da2-101a-5cc2-bfd8-34bfd1cb8353" :answer/type :answer.type/math :answer/value "250" :db/ensure [:answer/validate]} {:db/id "answer-067991d8-b641-57f3-9108-03d53b4a6751" :answer/id #uuid "067991d8-b641-57f3-9108-03d53b4a6751" :answer/type :answer.type/math :answer/value "50" :db/ensure [:answer/validate]} {:db/id "answer-e4692d29-df3f-5906-be3b-0b79ffde0a74" :answer/id #uuid "e4692d29-df3f-5906-be3b-0b79ffde0a74" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id 17592186148780 :tutorial/content "If we want to find the ratio of two numbers as a percentage, we can use the relationship between multiplication and division.\n\nTo demonstrate, let's determine the missing number below.\n\n![](images/df/dfa98ca128e85d05689ed37be0f29dcc2f1f06ae5ee7c930d5ccc76c2564a736.svg)\n\nWe can interpret the word \"of\" as multiplication:\n![](images/c5/c5002766655275462fbd346ee2dfba78b1ec4b5e2a603e0e38a2d44f19708cfd.svg)\n\nNow, using the relationship between multiplication and division, we can write our problem as follows:\n![](images/72/72bd81d10d8c50b1ca5d8a9196585d3da7a5d740fd4c75a86e5cd45a87093495.svg)\n\nTo write this fraction as a percentage, we write an equivalent fraction with $100$ as the denominator:\n\n$$\n\\dfrac{7}{10} = \\dfrac{7 \\times 10}{10 \\times 10} = \\dfrac{70}{100}\n$$\n\nNow we can write this fraction as a percentage:\n\n$$\n\\dfrac{70}{100} = 70\\%\n$$\n\nTherefore, \n\n$$\n70 \\% \\,\\,\\text{of}\\,\\, 10 = 7.\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186147656 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186230290 :answer-field/choices 17592186230291] [:db/retract 17592186230290 :answer-field/choices 17592186230292] [:db/retract 17592186230290 :answer-field/choices 17592186230293] [:db/retract 17592186230290 :answer-field/choices 17592186230294] [:db/retract 17592186230285 :answer-field/choices 17592186230288] [:db/retract 17592186230285 :answer-field/choices 17592186230289] [:db/retract 17592186230285 :answer-field/choices 17592186230286] [:db/retract 17592186230285 :answer-field/choices 17592186230287] {:db/id 17592186231418 :knowledge-point/questions ["question-45c14947-ce9d-54ff-a45e-efd6339354f3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186231291 :question/problem "Consider the initial value problem\n\n$$\ny'-6y = f(x), \\qquad y(1)=4\n$$\n\nwhere $f(x)$ is a $2$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution $y_p$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution $y_p$ satisfies $y_p(1)=0.$*\n\n![](images/18/18aab597687b865d437df96ea393da00ddaa96d5729d47b4e7f56eedb71f4440.svg)" :db/ensure [:question/validate]} {:db/id 17592186231419 :knowledge-point/questions ["question-cc163f49-3433-502e-a178-2f1ecb1f8055" "question-96918677-d74f-5a11-bcee-c80ebc5a3b95"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186231293 :question/problem "$$\ny''+ 7\\pi^2 y = f(x), \\qquad y(0)=0, \\quad y'(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $4$-periodic function. Fill in the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n![](images/85/8514868423c75e8d72c5da483717e0d70d8ac2c0961484f0cf71a6f3be95c604.svg)" :db/ensure [:question/validate]} {:db/id 17592186365946 :answer-field/correct "answer-373fbf8e-f9c5-58a2-82ab-389c0f096a7e" :answer-field/choices ["answer-373fbf8e-f9c5-58a2-82ab-389c0f096a7e"] :db/ensure [:answer-field/validate]} {:db/id "answer-373fbf8e-f9c5-58a2-82ab-389c0f096a7e" :answer/id #uuid "373fbf8e-f9c5-58a2-82ab-389c0f096a7e" :answer/type :answer.type/math :answer/value "-2e^{5x-15}" :db/ensure [:answer/validate]} {:db/id 17592186365943 :answer-field/correct "answer-833af303-c46f-5b0d-8a79-139d161c6a97" :answer-field/choices ["answer-833af303-c46f-5b0d-8a79-139d161c6a97"] :db/ensure [:answer-field/validate]} {:db/id "answer-833af303-c46f-5b0d-8a79-139d161c6a97" :answer/id #uuid "833af303-c46f-5b0d-8a79-139d161c6a97" :answer/type :answer.type/math :answer/value "e^{-4x}" :db/ensure [:answer/validate]} {:db/id "question-45c14947-ce9d-54ff-a45e-efd6339354f3" :question/id #uuid "45c14947-ce9d-54ff-a45e-efd6339354f3" :question/math-academy-id "q-343941" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+4y=f(x),\\,y(2)=6\n$$\n\nwhere $f(x)$ is a $3$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(2)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+4y=0$ is \n\n$$\n{y}_{c}=A{e}^{-4x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+4y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x))\n$$\n\nNow, we apply the initial condition $y(2)=6.$ Using the hint that the particular solution part evaluates to zero at $x=2,$ we have\n\n$$\n\\begin{aligned}y(2) & =A{e}^{-4(2)}+{y}_{p}(2) \\\\ 6 & =A{e}^{-8}+0 \\\\ A & =6{e}^{8}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(6{e}^{8}){e}^{-4x}=6{e}^{8-4x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼6{e}^{8-4x}+{\\sum }_{n=1}^{\\infty }({a}_{n}cos\\,(\\frac{2\\pi n}{3}x)+{b}_{n}sin\\,(\\frac{2\\pi n}{3}x)).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-a6f760f5-5d84-52a0-b935-56a6e8048378"] :db/ensure [:question/validate]} {:db/id "answer-field-a6f760f5-5d84-52a0-b935-56a6e8048378" :answer-field/id #uuid "a6f760f5-5d84-52a0-b935-56a6e8048378" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-89a99bb2-59a1-56e7-886a-f86b8515a140" :answer-field/choices ["answer-89a99bb2-59a1-56e7-886a-f86b8515a140"] :db/ensure [:answer-field/validate]} {:db/id "answer-89a99bb2-59a1-56e7-886a-f86b8515a140" :answer/id #uuid "89a99bb2-59a1-56e7-886a-f86b8515a140" :answer/type :answer.type/math :answer/value "6e^{8-4x}" :db/ensure [:answer/validate]} {:db/id 17592186231565 :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+5y=f(x),\\,y(0)=2\n$$\n\nwhere $f(x)$ is a $2$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(0)=0.$*\n\nThe solution is \n\n$y(x)∼$  \n{{field-1}} \n$+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x))$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+5y=0$ is \n\n$$\n{y}_{c}=A{e}^{-5x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+5y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-5x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x))\n$$\n\nNow, we apply the initial condition $y(0)=2.$ Using the hint that the particular solution part evaluates to zero at $x=0,$ we have\n\n$$\n\\begin{aligned}y(0) & =A{e}^{-5(0)}+{y}_{p}(0) \\\\ 2 & =A(1)+0 \\\\ A & =2.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=2{e}^{-5x}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼2{e}^{-5x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x)).\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186230282 :answer-field/correct "answer-ce18d2d3-cbf0-5718-8403-e06f139d53eb" :answer-field/choices ["answer-ce18d2d3-cbf0-5718-8403-e06f139d53eb"] :db/ensure [:answer-field/validate]} {:db/id "answer-ce18d2d3-cbf0-5718-8403-e06f139d53eb" :answer/id #uuid "ce18d2d3-cbf0-5718-8403-e06f139d53eb" :answer/type :answer.type/math :answer/value "2e^{-5x}" :db/ensure [:answer/validate]} {:db/id 17592186231566 :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}+3y=f(x),\\,y(1)=5\n$$\n\nwhere $f(x)$ is a $2$-periodic function. Fill in the missing part in the solution of the IVP, where the infinite sum on the right-hand side below represents a particular solution ${y}_{p}$ of the differential equation.\n\n*Hint: In this specific problem, the forcing function $f(x)$ is chosen such that the particular solution ${y}_{p}$ satisfies ${y}_{p}(1)=0.$*\n\nThe solution is \n\n$y(x)∼$   \n{{field-1}} \n$+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x))$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{′}+P(x)y=f(x)$ is given by\n\n$$\ny={y}_{c}+{y}_{p},\n$$\n\nwhere ${y}_{c}$ is the general solution of the corresponding homogeneous equation, and ${y}_{p}$ is a particular solution.\n\nFirst, we find the homogeneous solution. The general solution of ${y}^{′}+3y=0$ is \n\n$$\n{y}_{c}=A{e}^{-3x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nNext, we identify the form of the general solution. Because the operator ${y}^{′}+3y$ involves a first derivative, a periodic forcing function $f(x)$ results in a particular solution containing both sine and cosine terms:\n\n$$\ny(x)∼A{e}^{-3x}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x))\n$$\n\nNow, we apply the initial condition $y(1)=5.$ Using the hint that the particular solution part evaluates to zero at $x=1,$ we have\n\n$$\n\\begin{aligned}y(1) & =A{e}^{-3(1)}+{y}_{p}(1) \\\\ 5 & =A{e}^{-3}+0 \\\\ A & =5{e}^{3}.\\end{aligned}\n$$\n\nFinally, we substitute $A$ back into the homogeneous part:\n\n$$\n{y}_{c}=(5{e}^{3}){e}^{-3x}=5{e}^{-3x+3}\n$$\n\nTherefore, the solution is\n\n$$\ny(x)∼5{e}^{-3x+3}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x)).\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186230283 :answer-field/correct "answer-05435b21-2efe-56db-979e-28b79c30b314" :answer-field/choices ["answer-05435b21-2efe-56db-979e-28b79c30b314"] :db/ensure [:answer-field/validate]} {:db/id "answer-05435b21-2efe-56db-979e-28b79c30b314" :answer/id #uuid "05435b21-2efe-56db-979e-28b79c30b314" :answer/type :answer.type/math :answer/value "5e^{-3x+3}" :db/ensure [:answer/validate]} {:db/id "question-cc163f49-3433-502e-a178-2f1ecb1f8055" :question/id #uuid "cc163f49-3433-502e-a178-2f1ecb1f8055" :question/math-academy-id "q-344038" :question/problem "$$\n{y}^{″}+3{\\pi }^{2}y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }\\,\\frac{12(-1)^{n}}{{n}^{2}{\\pi }^{3}(12-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }\\frac{12(-1)^{n}}{{n}^{2}{\\pi }^{3}(12-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+3{\\pi }^{2}=0$ gives roots $\\lambda =\\pm \\sqrt{3}\\pi \\,\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{3}\\pi x)+B\\operatorname{sin}⁡(\\sqrt{3}\\pi x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=0.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{3}\\pi \\operatorname{cos}⁡(\\sqrt{3}\\pi x)+{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n{\\pi }^{2}(12-{n}^{2})}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\n$$\n\nApplying ${y}^{′}(0)=0$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}0 & =B\\sqrt{3}\\pi +{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n{\\pi }^{2}(12-{n}^{2})} \\\\ B\\sqrt{3}\\pi  & =-{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n{\\pi }^{2}(12-{n}^{2})} \\\\ B & =-\\frac{1}{\\sqrt{3}\\pi }{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n{\\pi }^{2}(12-{n}^{2})} \\\\  & =-{\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{\\sqrt{3}{\\pi }^{3}(12-{n}^{2})} \\\\  & =-{\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{3}(-1)^{n}}{n{\\pi }^{3}(12-{n}^{2})}.\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{3}\\pi x)$, we find the missing part:\n\n$$\ny(x)∼-\\operatorname{sin}⁡(\\sqrt{3}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{3}(-1)^{n}}{n{\\pi }^{3}(12-{n}^{2})}+{\\sum }_{n=1}^{\\infty }\\,\\frac{12(-1)^{n}}{{n}^{2}{\\pi }^{3}(12-{n}^{2})}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-c62d441d-cf47-52e7-b38c-fb09c667ff01"] :db/ensure [:question/validate]} {:db/id "answer-field-c62d441d-cf47-52e7-b38c-fb09c667ff01" :answer-field/id #uuid "c62d441d-cf47-52e7-b38c-fb09c667ff01" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-985f359f-8702-569a-bb17-1736d6a27b3f" :answer-field/choices ["answer-985f359f-8702-569a-bb17-1736d6a27b3f" "answer-d1181996-5194-59b4-966f-48575fc3d5a1" "answer-30d8db51-d8e5-5c78-97de-cf185417daf6" "answer-9cdf9269-0054-577d-9b4b-61ffbea6989f"] :db/ensure [:answer-field/validate]} {:db/id "answer-985f359f-8702-569a-bb17-1736d6a27b3f" :answer/id #uuid "985f359f-8702-569a-bb17-1736d6a27b3f" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡(\\sqrt{3}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{3}(-1)^{n}}{n{\\pi }^{3}(12-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "answer-d1181996-5194-59b4-966f-48575fc3d5a1" :answer/id #uuid "d1181996-5194-59b4-966f-48575fc3d5a1" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡(\\sqrt{3}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{2\\sqrt{3}}{n{\\pi }^{3}(12-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "answer-30d8db51-d8e5-5c78-97de-cf185417daf6" :answer/id #uuid "30d8db51-d8e5-5c78-97de-cf185417daf6" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{3}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{12}{n{\\pi }^{2}(12-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id "answer-9cdf9269-0054-577d-9b4b-61ffbea6989f" :answer/id #uuid "9cdf9269-0054-577d-9b4b-61ffbea6989f" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{3}\\pi x){\\sum }_{n=1}^{\\infty }\\frac{6(-1)^{n}}{n{\\pi }^{2}(12-{n}^{2})}" :db/ensure [:answer/validate]} {:db/id 17592186231569 :question/problem "$$\n{y}^{″}+3y=f(x),\\,y(0)=5,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an even, $2\\pi $-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an even function and the differential operator contains no ${y}^{′}$ (damping) term, the particular solution inherits the symmetry and is also an even function consisting only of cosine terms. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+3=0$ gives roots $\\lambda =\\pm \\sqrt{3}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{3}x)+B\\operatorname{sin}⁡(\\sqrt{3}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\n{y}^{′}(x)∼-A\\sqrt{3}\\operatorname{sin}⁡(\\sqrt{3}x)+B\\sqrt{3}\\operatorname{cos}⁡(\\sqrt{3}x)-{\\sum }_{n=1}^{\\infty }n{a}_{n}\\operatorname{sin}⁡(nx).\n$$\n\nUsing the derivative condition ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{3}\\operatorname{sin}⁡(0)+B\\sqrt{3}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }n{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{3}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we use the condition $y(0)=5.$ With $B=0,$ the total solution is\n\n$$\ny(x)∼A\\operatorname{cos}⁡(\\sqrt{3}x)+{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx).\n$$\n\nApplying $y(0)=5$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}5 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =5-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nSubstituting $A$ back into ${y}_{c}=A\\operatorname{cos}⁡(\\sqrt{3}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{cos}⁡(\\sqrt{3}x)(5-{\\sum }_{n=0}^{\\infty }{a}_{n})+{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186230290 :answer-field/correct "answer-47e5a43d-8ef8-5767-b90a-d874596db5d5" :answer-field/choices ["answer-29890858-bb3d-5c7c-a21f-0940ee2caa33" "answer-47e5a43d-8ef8-5767-b90a-d874596db5d5" "answer-16a6db0b-9e84-5cf1-863e-3e373118b5aa" "answer-86a32374-dafa-5564-a787-d22d42029333"] :db/ensure [:answer-field/validate]} {:db/id "answer-29890858-bb3d-5c7c-a21f-0940ee2caa33" :answer/id #uuid "29890858-bb3d-5c7c-a21f-0940ee2caa33" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{3}x)(5+{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-47e5a43d-8ef8-5767-b90a-d874596db5d5" :answer/id #uuid "47e5a43d-8ef8-5767-b90a-d874596db5d5" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{3}x)(5-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-16a6db0b-9e84-5cf1-863e-3e373118b5aa" :answer/id #uuid "16a6db0b-9e84-5cf1-863e-3e373118b5aa" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{3}x)({\\sum }_{n=0}^{\\infty }{a}_{n}-5)" :db/ensure [:answer/validate]} {:db/id "answer-86a32374-dafa-5564-a787-d22d42029333" :answer/id #uuid "86a32374-dafa-5564-a787-d22d42029333" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{3}x)(5-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id 17592186231568 :question/problem "$$\n{y}^{″}+5y=f(x),\\,y(0)=0,\\,{y}^{′}(0)=4\n$$\n\nConsider the initial value problem above, where $f(x)$ is an odd, $2\\pi $-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx)\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an odd function, its Fourier series consists only of sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+5=0$ gives roots $\\lambda =\\pm \\sqrt{5}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{5}x)+B\\operatorname{sin}⁡(\\sqrt{5}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Using $y(0)=0:$\n\n$$\n\\begin{aligned}y(0) & =A\\operatorname{cos}⁡(0)+B\\operatorname{sin}⁡(0)+{y}_{p}(0) \\\\ 0 & =A(1)+0+0 \\\\ A & =0\\end{aligned}\n$$\n\nNote that ${y}_{p}(0)=0$ because the particular solution is a sine series.\n\nNext, we use the derivative condition ${y}^{′}(0)=4.$ First, we compute the derivative of the total solution (with $A=0$):\n\n$$\n{y}^{′}(x)∼B\\sqrt{5}\\operatorname{cos}⁡(\\sqrt{5}x)+{\\sum }_{n=1}^{\\infty }n{b}_{n}\\operatorname{cos}⁡(nx).\n$$\n\nApplying ${y}^{′}(0)=4$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have:\n\n$$\n\\begin{aligned}4 & =B\\sqrt{5}+{\\sum }_{n=1}^{\\infty }n{b}_{n} \\\\ B\\sqrt{5} & =4-{\\sum }_{n=1}^{\\infty }n{b}_{n} \\\\ B & =\\frac{4}{\\sqrt{5}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{5}}\\end{aligned}\n$$\n\nSubstituting $B$ back into ${y}_{c}=B\\operatorname{sin}⁡(\\sqrt{5}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{sin}⁡(\\sqrt{5}x)(\\frac{4}{\\sqrt{5}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{5}})+{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(nx).\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186230285 :answer-field/correct "answer-3a281648-1629-5ed6-a512-fcaed8c294c7" :answer-field/choices ["answer-6c6a48bc-5749-583b-bdd0-4646b17b3ccf" "answer-041cc4c1-c063-5895-b8e8-6f3e38cc53ce" "answer-730bd397-3c65-5df0-80b1-afd876a19b7e" "answer-3a281648-1629-5ed6-a512-fcaed8c294c7"] :db/ensure [:answer-field/validate]} {:db/id "answer-6c6a48bc-5749-583b-bdd0-4646b17b3ccf" :answer/id #uuid "6c6a48bc-5749-583b-bdd0-4646b17b3ccf" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{5}x)(\\frac{4}{\\sqrt{5}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{5}})" :db/ensure [:answer/validate]} {:db/id "answer-041cc4c1-c063-5895-b8e8-6f3e38cc53ce" :answer/id #uuid "041cc4c1-c063-5895-b8e8-6f3e38cc53ce" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{5}x)(4-{\\sum }_{n=1}^{\\infty }n{b}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-730bd397-3c65-5df0-80b1-afd876a19b7e" :answer/id #uuid "730bd397-3c65-5df0-80b1-afd876a19b7e" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{5}x)(\\frac{4}{\\sqrt{5}}+{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{5}})" :db/ensure [:answer/validate]} {:db/id "answer-3a281648-1629-5ed6-a512-fcaed8c294c7" :answer/id #uuid "3a281648-1629-5ed6-a512-fcaed8c294c7" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{5}x)(\\frac{4}{\\sqrt{5}}-{\\sum }_{n=1}^{\\infty }\\frac{n{b}_{n}}{\\sqrt{5}})" :db/ensure [:answer/validate]} {:db/id "question-96918677-d74f-5a11-bcee-c80ebc5a3b95" :question/id #uuid "96918677-d74f-5a11-bcee-c80ebc5a3b95" :question/math-academy-id "q-344035" :question/problem "$$\n{y}^{″}+2y=f(x),\\,y(0)=-4,\\,{y}^{′}(0)=0\n$$\n\nConsider the initial value problem above, where $f(x)$ is an even, $4$-periodic function. Select the missing part in the solution of the IVP, where the second infinite sum on the right-hand side below represents a particular solution of the differential equation.\n\n$$\ny(x)∼{{field-1}}+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x)\n$$" :question/worked-solution "Recall that the general solution of a linear differential equation of the form ${y}^{″}+{\\omega }^{2}y=f(x)$ is given by $y={y}_{c}+{y}_{p},$ where ${y}_{c}$ is the solution to the homogeneous equation and ${y}_{p}$ is a particular solution.\n\nFirst, we address the particular solution ${y}_{p}.$ Since $f(x)$ is an even function and the differential operator contains no ${y}^{′}$ (damping) term, the particular solution inherits the symmetry and is also an even function consisting only of cosine terms. This is represented by the term\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x).\n$$\n\nNext, we find the homogeneous solution. The characteristic equation ${\\lambda }^{2}+2=0$ gives roots $\\lambda =\\pm \\sqrt{2}\\text{i}.$ So, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x)+B\\operatorname{sin}⁡(\\sqrt{2}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\n{y}^{′}(x)∼-A\\sqrt{2}\\operatorname{sin}⁡(\\sqrt{2}x)+B\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}x)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}sin\\,(\\frac{n\\pi }{2}x).\n$$\n\nUsing the derivative condition ${y}^{′}(0)=0:$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{2}\\operatorname{sin}⁡(0)+B\\sqrt{2}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }\\frac{n\\pi }{2}{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{2}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we use the condition $y(0)=-4.$ With $B=0,$ the total solution is\n\n$$\ny(x)∼A\\operatorname{cos}⁡(\\sqrt{2}x)+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x).\n$$\n\nApplying $y(0)=-4$ and noting that $\\operatorname{cos}⁡(0)=1,$ we have\n\n$$\n\\begin{aligned}-4 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =-4-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nSubstituting $A$ back into ${y}_{c}=A\\operatorname{cos}⁡(\\sqrt{2}x),$ we find the missing part:\n\n$$\ny(x)∼\\operatorname{cos}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})+{\\sum }_{n=0}^{\\infty }{a}_{n}cos\\,(\\frac{n\\pi }{2}x)\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-69a096f9-2884-52fa-b0ef-ba88ca249a75"] :db/ensure [:question/validate]} {:db/id "answer-field-69a096f9-2884-52fa-b0ef-ba88ca249a75" :answer-field/id #uuid "69a096f9-2884-52fa-b0ef-ba88ca249a75" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "answer-6ef76db9-b5c3-5953-bc60-e1853032b616" :answer-field/choices ["answer-a4e1e40b-afb1-57b5-bd98-93d521a6c0e6" "answer-6ef76db9-b5c3-5953-bc60-e1853032b616" "answer-0810bb3f-c2fa-58b5-b891-5c4514181eb0" "answer-3a590d58-adcd-5aee-ba5f-885b57614221"] :db/ensure [:answer-field/validate]} {:db/id "answer-a4e1e40b-afb1-57b5-bd98-93d521a6c0e6" :answer/id #uuid "a4e1e40b-afb1-57b5-bd98-93d521a6c0e6" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)(-4+{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-6ef76db9-b5c3-5953-bc60-e1853032b616" :answer/id #uuid "6ef76db9-b5c3-5953-bc60-e1853032b616" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id "answer-0810bb3f-c2fa-58b5-b891-5c4514181eb0" :answer/id #uuid "0810bb3f-c2fa-58b5-b891-5c4514181eb0" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\sqrt{2}x)({\\sum }_{n=0}^{\\infty }{a}_{n}+4)" :db/ensure [:answer/validate]} {:db/id "answer-3a590d58-adcd-5aee-ba5f-885b57614221" :answer/id #uuid "3a590d58-adcd-5aee-ba5f-885b57614221" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\sqrt{2}x)(-4-{\\sum }_{n=0}^{\\infty }{a}_{n})" :db/ensure [:answer/validate]} {:db/id 17592186231984 :tutorial/content "We know how to find a Fourier-series particular solution $y_p$ for a periodically forced linear ODE.\nIn this topic, the new step is how to use $y_p$ to satisfy an initial condition.\n\nRecall that once a particular solution $y_p$ is chosen, the full solution has the form\n\n$$\ny = y_c + y_p,\n$$\n\nwhere $y_c$ solves the corresponding homogeneous equation.\n\nNow, suppose the IVP is given at $x=x_0{:}$\n\n$$\ny(x_0)=y_0.\n$$\n\nThen,\n\n$$\ny_0 = y_c(x_0)+y_p(x_0).\n$$\n\nA useful simplification is to choose the particular solution so that\n\n$$\ny_p(x_0)=0.\n$$\n\nIn that case, the initial condition becomes\n\n$$\ny_0 = y_c(x_0),\n$$\n\nso we can solve for the constant(s) in $y_c$ immediately (without evaluating any Fourier sums at $x_0$).\n\nOn the next slide, we’ll apply this idea in an example." :db/ensure [:tutorial/validate]} {:db/id 17592186231993 :tutorial/content "For example, consider the initial value problem\n\n$$\ny'-2y = f(x), \\qquad y(0)=3,\n$$\n\nwhere $f(x)$ is a $2$-periodic function. Suppose we choose the forcing (and hence the Fourier-series particular solution) so that\n\n$$\ny_p(0)=0.\n$$\n\nFirst, solve the homogeneous equation:\n\n$$\ny' - 2y = 0\n\\quad\\Longrightarrow\\quad\ny_c = Ae^{2x}.\n$$\n\nA $2$-periodic forcing function can be written using harmonics of frequency $\\pi$, so we may write the particular solution in the form\n\n$$\ny_p(x)=\\sum_{n=1}^\\infty \\left(a_n\\cos(n\\pi x)+b_n\\sin(n\\pi x)\\right).\n$$\n\nThus the full solution is\n\n$$\ny(x)=Ae^{2x}+\\sum_{n=1}^\\infty \\left(a_n\\cos(n\\pi x)+b_n\\sin(n\\pi x)\\right).\n$$\n\nNow apply $y(0)=3$ and use $y_p(0)=0$:\n\n$$\n\\begin{aligned}y(0) & =A{e}^{2(0)}+{y}_{p}(0) \\\\ 3 & =A(1)+0 \\\\ A & =3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ny(x)=\n3e^{2x}+\\sum_{n=1}^\\infty \\left(a_n\\cos(n\\pi x)+b_n\\sin(n\\pi x)\\right).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186231989 :tutorial/content "When we solve a second-order IVP using Fourier series, we still represent the solution in the form\n\n$$\ny = y_c + y_p,\n$$\n\nbut since the homogeneous solution has *two* constants, we use *two* conditions:\n\n$$\ny(0)=y_0\n\\qquad\\text{and}\\qquad\ny'(0)=y_1\n$$\n\nBefore we start, we can use the forcing series properties to simplify our work. For a second-order equation of the form \n\n$$\ny'' + \\omega^2 y = f(x)\n$$\n\nwith no $y'$ (damping) term, the particular solution can be simplified. Here, we have two cases:\n\n- **Case 1:** $f(x)$ is odd.\n\nIf $f(x)$ is *odd* and the equation has the form $y''+\\omega^2 y=f(x)$, then the particular solution is also *odd*, so it is a sine series:\n\n$$\ny_p(x)=\\sum_{n=1}^\\infty b_n\\sin\\left(\\dfrac{n\\pi x}{L}\\right)\n$$\n\nThis immediately gives $y_p(0)=0,$ so the condition $y(0)=y_0$ determines the cosine constant in $y_c$ without evaluating any infinite sum at $0$.\n\n- **Case 2:** $f(x)$ is even.\n\nIf $f(x)$ is *even* and the equation has the form $y''+\\omega^2 y=f(x)$, then the particular solution is also *even*, so it is a cosine series:\n\n$$\ny_p(x)=\\sum_{n=0}^\\infty a_n\\cos\\left(\\dfrac{n\\pi x}{L}\\right)\n$$\n\nHere, the derivative is a sine series:\n\n$$\ny_p'(x)=-\\sum_{n=1}^\\infty \\dfrac{a_n n\\pi}{L} \\sin\\left(\\dfrac{n\\pi x}{L}\\right)\n$$\n\nThis immediately gives $y_p'(0)=0,$ so the condition $y'(0)=y_1$ determines the sine constant in $y_c$ without evaluating any infinite sum at $0$.\n\nIn both cases, the key idea is that evaluating at $x=0$ (and differentiating once) lets the initial conditions pick off the constants in $y_c$ as cleanly as possible.\n\nLet's see how this works in practice on the next slide." :db/ensure [:tutorial/validate]} {:db/id 17592186231990 :tutorial/content "Consider the initial value problem\n\n$$\ny''+ 7y = f(x), \\qquad y(0)=3,\\quad y'(0)=0\n$$\n\nwhere $f(x)$ is an even, $2\\pi$-periodic function. Since the forcing is even and the differential operator contains no $y'$ term, we represent the particular solution as a cosine series:\n\n$$\ny_p(x)=\\sum_{n=0}^\\infty a_n\\cos(nx)\n$$\n\nNext, we solve the homogeneous equation $y''+7y=0.$ The characteristic equation is $\\lambda^2+7=0,$ so\n\n$$\ny_c=A\\cos(\\sqrt{7}x)+B\\sin(\\sqrt{7}x).\n$$\n\nTo find the unknown constants, we apply the initial conditions. Differentiating the total solution gives\n\n$$\ny'(x)=-A\\sqrt{7}\\sin(\\sqrt{7}x)+B\\sqrt{7}\\cos(\\sqrt{7}x)-\\sum_{n=1}^\\infty n a_n\\sin(nx).\n$$\n\nUsing the derivative condition $y'(0)=0{:}$\n\n$$\n\\begin{aligned}{y}^{′}(0) & =-A\\sqrt{7}\\operatorname{sin}⁡(0)+B\\sqrt{7}\\operatorname{cos}⁡(0)-{\\sum }_{n=1}^{\\infty }n{a}_{n}\\operatorname{sin}⁡(0) \\\\ 0 & =0+B\\sqrt{7}-0 \\\\ B & =0\\end{aligned}\n$$\n\nNote that because the total solution is an even function, its derivative is an odd function, which must vanish at $x=0.$\n\nNext, we apply $y(0)=3.$ With $B=0,$ the total solution is\n\n$$\ny(x)\\sim A\\cos(\\sqrt{7}x)+\\sum_{n=0}^\\infty a_n\\cos(nx).\n$$\n\nApplying $y(0)=3$ and noting that $\\cos(0)=1,$ we have\n\n$$\n\\begin{aligned}3 & =A+{\\sum }_{n=0}^{\\infty }{a}_{n} \\\\ A & =3-{\\sum }_{n=0}^{\\infty }{a}_{n}.\\end{aligned}\n$$\n\nTherefore, the solution can be written as\n\n$$\ny(x)\\sim \n\\cos(\\sqrt{7}x)\\left(3-\\sum_{n=0}^\\infty a_n\\right)\n+\\sum_{n=0}^\\infty a_n\\cos(nx).\n$$" :db/ensure [:tutorial/validate]} {:db/id 17592186231521 :activity/expected-seconds 1020.0 :db/ensure [:activity/validate]} [:db/retract 17592186318801 :answer-field/choices 17592186317794] [:db/retract 17592186318894 :answer-field/choices 17592186317980] {:db/id 17592186120352 :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 1\\end{aligned}],\\,x=[\\begin{aligned}2 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -2\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}] & =[\\begin{aligned}2 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix\n\n$$\nM=[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 2 \\\\ -2 & 1 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 \\\\ 0 & 5 & 10\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+2{x}_{2}=2 \\\\ 5{x}_{2}=10.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n{x}_{1}+2(2)=2\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=(-2)+2=0.$" :db/ensure [:question/validate]} {:db/id 17592186318801 :answer-field/choices ["answer-c5c361cd-49f5-527f-91c1-eb17cbe67bc5"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5c361cd-49f5-527f-91c1-eb17cbe67bc5" :answer/id #uuid "c5c361cd-49f5-527f-91c1-eb17cbe67bc5" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2}\\}" :db/ensure [:answer/validate]} {:db/id 17592186319175 :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}-1 \\\\ 5 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}4 \\\\ 2 \\\\ -3\\end{aligned}] & =[\\begin{aligned}6 \\\\ -8 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}-1 & 4 & 6 \\\\ 5 & 2 & -8 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{2}:={R}_{2}+5{R}_{1} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & -3 & -3\\end{aligned}] & {R}_{3}:={R}_{3}+\\frac{3}{22}{R}_{2} \\\\ ∼ & [\\begin{aligned}-1 & 4 & 6 \\\\ 0 & 22 & 22 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned}-{x}_{1}+4{x}_{2}=6 \\\\ 22{x}_{2}=22.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting this into the first equation, we obtain\n\n$$\n-{x}_{1}+4(1)=6\\,⟹\\,{x}_{1}=-2.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$ \n\nFinally, ${x}_{1}+{x}_{2}=-2+1=-1.$" :db/ensure [:question/validate]} {:db/id 17592186318894 :answer-field/choices ["answer-32fd85ec-3fca-5fdb-8d41-028482470a84"] :db/ensure [:answer-field/validate]} {:db/id "answer-32fd85ec-3fca-5fdb-8d41-028482470a84" :answer/id #uuid "32fd85ec-3fca-5fdb-8d41-028482470a84" :answer/type :answer.type/math :answer/value "x\\notin \\text{span}\\{{b}_{1},{b}_{2}\\}" :db/ensure [:answer/validate]} {:db/id 17592186119822 :knowledge-point/questions ["question-3d89aeef-7acc-5575-9764-44e144045f82" "question-e3764343-10e9-5a7d-b034-e095faf7f51c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-3d89aeef-7acc-5575-9764-44e144045f82" :question/id #uuid "3d89aeef-7acc-5575-9764-44e144045f82" :question/math-academy-id "q-75998" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}],\\,x=[\\begin{aligned}6 \\\\ 11 \\\\ 6\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that  \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]+{x}_{3}[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}6 \\\\ 11 \\\\ 6\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & 1 & 1 & 6 \\\\ 3 & 2 & 1 & 11 \\\\ 2 & 2 & -1 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & -1 & -2 & 7 \\\\ 2 & 2 & -1 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & 1 & 1 & 6 \\\\ 0 & -1 & -2 & -7 \\\\ 0 & 0 & -3 & -6\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}+{x}_{2}+{x}_{3}=6 \\\\ -{x}_{2}-2{x}_{3}=-7 \\\\ -3{x}_{3}=-6.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=2.$ Substituting this into the second   equation yields\n\n$$\n-{x}_{2}-2(2)=-7\\,⟹\\,{x}_{2}=3.\n$$\n\n Finally,  by substituting ${x}_{2}=3$ and ${x}_{3}=2$ into the first equation we obtain\n\n$$\n{x}_{1}+(3)+2=6\\,⟹\\,{x}_{1}=1.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}1 \\\\ 3 \\\\ 2\\end{aligned}].$\n\nSo, we have ${x}_{1}=1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8aa3925e-da8c-56e5-b9b6-c047f1edb4c2"] :db/ensure [:question/validate]} {:db/id "answer-field-8aa3925e-da8c-56e5-b9b6-c047f1edb4c2" :answer-field/id #uuid "8aa3925e-da8c-56e5-b9b6-c047f1edb4c2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f9fc417c-d758-5208-baf3-43da35bca066" :answer-field/choices ["answer-066bb7c4-7521-5727-993a-55db17b87282" "answer-f9fc417c-d758-5208-baf3-43da35bca066" "answer-49378edd-134f-5712-a720-7f1c131c32c8" "answer-b4852b6d-9a78-5d08-bc44-0fc169587a8b" "answer-a6f74b12-935c-5e33-a5e5-220baef222b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-066bb7c4-7521-5727-993a-55db17b87282" :answer/id #uuid "066bb7c4-7521-5727-993a-55db17b87282" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-f9fc417c-d758-5208-baf3-43da35bca066" :answer/id #uuid "f9fc417c-d758-5208-baf3-43da35bca066" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-49378edd-134f-5712-a720-7f1c131c32c8" :answer/id #uuid "49378edd-134f-5712-a720-7f1c131c32c8" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "answer-b4852b6d-9a78-5d08-bc44-0fc169587a8b" :answer/id #uuid "b4852b6d-9a78-5d08-bc44-0fc169587a8b" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-a6f74b12-935c-5e33-a5e5-220baef222b1" :answer/id #uuid "a6f74b12-935c-5e33-a5e5-220baef222b1" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/ensure [:answer/validate]} {:db/id "question-e3764343-10e9-5a7d-b034-e095faf7f51c" :question/id #uuid "e3764343-10e9-5a7d-b034-e095faf7f51c" :question/math-academy-id "q-76054" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2},{b}_{3}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}-1 \\\\ 2 \\\\ 1\\end{aligned}],\\,{b}_{3}=[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}3 \\\\ 15 \\\\ 12\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}+{x}_{3}?$" :question/worked-solution "We need to find ${x}_{1}$,  ${x}_{2}$, and ${x}_{3}$ such that\n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2}+{x}_{3}{b}_{3} & =x \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 3\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 2 \\\\ 1\\end{aligned}]+{x}_{3}[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}] & =[\\begin{aligned}3 \\\\ 15 \\\\ 12\\end{aligned}].\\end{aligned}\n$$\n\nFrom this, we get the system with the augmented matrix $M$, which we reduce using Gaussian elimination: \n\n$$\n\\begin{aligned}M= & [\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 3 & 1 & 0 & 12\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\ ∼ & [\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 0 & 4 & -3 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\ ∼ & [\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 2 & 3 & 15 \\\\ 0 & 0 & -9 & -27\\end{aligned}]\\end{aligned}\n$$\n\n  \n\nThe system is now \n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3}=3 \\\\ 2{x}_{2}+3{x}_{3}=15 \\\\ -9{x}_{3}=-27.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=3.$ Substituting this into the second   equation yields\n\n$$\n2{x}_{2}+3(3)=15\\,⟹\\,{x}_{2}=3.\n$$\n\n Finally,  by substituting ${x}_{2}=3$ and ${x}_{3}=3$ into the first equation we obtain\n\n$$\n{x}_{1}-3+3=3\\,⟹\\,{x}_{1}=3.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}3 \\\\ 3 \\\\ 3\\end{aligned}].$\n\nSo, we have \n\n$$\n{x}_{1}+{x}_{2}+{x}_{3}=3+3+3=9.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-8c6024f5-9069-597b-a291-cd59361ac136"] :db/ensure [:question/validate]} {:db/id "answer-field-8c6024f5-9069-597b-a291-cd59361ac136" :answer-field/id #uuid "8c6024f5-9069-597b-a291-cd59361ac136" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2679ade7-de7e-5ff4-88c8-94968abbecd0" :answer-field/choices ["answer-58225722-5487-53b4-b242-37a168921893" "answer-2e4e66c0-8e5c-5dff-8789-8ac0302fb04b" "answer-f7cbfdfe-250f-5f75-93f6-f1ca311bd2d2" "answer-2679ade7-de7e-5ff4-88c8-94968abbecd0" "answer-a19f8251-ccaa-52d8-8b83-bba63f64cb63"] :db/ensure [:answer-field/validate]} {:db/id "answer-58225722-5487-53b4-b242-37a168921893" :answer/id #uuid "58225722-5487-53b4-b242-37a168921893" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-2e4e66c0-8e5c-5dff-8789-8ac0302fb04b" :answer/id #uuid "2e4e66c0-8e5c-5dff-8789-8ac0302fb04b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-f7cbfdfe-250f-5f75-93f6-f1ca311bd2d2" :answer/id #uuid "f7cbfdfe-250f-5f75-93f6-f1ca311bd2d2" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "answer-2679ade7-de7e-5ff4-88c8-94968abbecd0" :answer/id #uuid "2679ade7-de7e-5ff4-88c8-94968abbecd0" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "answer-a19f8251-ccaa-52d8-8b83-bba63f64cb63" :answer/id #uuid "a19f8251-ccaa-52d8-8b83-bba63f64cb63" :answer/type :answer.type/math :answer/value "x\\notin \\text{Span}\\{{b}_{1},{b}_{2},{b}_{3}\\}" :db/ensure [:answer/validate]} {:db/id 17592186409819 :question/problem "Find the coordinates of the vector $x$ relative to the basis $B=\\{{b}_{1},{b}_{2}\\},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}],\\,x=[\\begin{aligned}-7 \\\\ -8 \\\\ 0\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{2}?$" :db/ensure [:question/validate]} {:db/id "activity-dd948f84-01c7-51cf-b5c9-f9c00a2b84b8" :activity/id #uuid "dd948f84-01c7-51cf-b5c9-f9c00a2b84b8" :activity/title "Expressing the Coordinates of a Vector in a Given Basis" :activity/type :activity.type/review :activity/scope 17592186050638 :activity/course 17592186046658 :activity/steps ["step-3d7897f3-95d9-53e4-9b05-08455a50a2b6" "step-bc51db51-8852-5a95-a4d4-b77331fb8d8a" "step-3120d902-59cf-52cd-afde-5f7a4f7e1d5f" "step-e175e73c-1506-54af-ab5d-d11256d84f83" "step-af36c254-27dd-5c17-9617-e7f9d654737f"] :activity/first-step "step-3d7897f3-95d9-53e4-9b05-08455a50a2b6" :db/ensure [:activity/validate]} {:db/id "step-3d7897f3-95d9-53e4-9b05-08455a50a2b6" :step/id #uuid "3d7897f3-95d9-53e4-9b05-08455a50a2b6" :step/content 17592186120352 :step/next "step-bc51db51-8852-5a95-a4d4-b77331fb8d8a" :db/ensure [:step/validate]} {:db/id "step-bc51db51-8852-5a95-a4d4-b77331fb8d8a" :step/id #uuid "bc51db51-8852-5a95-a4d4-b77331fb8d8a" :step/content 17592186319175 :step/next "step-3120d902-59cf-52cd-afde-5f7a4f7e1d5f" :db/ensure [:step/validate]} {:db/id "step-3120d902-59cf-52cd-afde-5f7a4f7e1d5f" :step/id #uuid "3120d902-59cf-52cd-afde-5f7a4f7e1d5f" :step/content "question-3d89aeef-7acc-5575-9764-44e144045f82" :step/next "step-e175e73c-1506-54af-ab5d-d11256d84f83" :db/ensure [:step/validate]} {:db/id "step-e175e73c-1506-54af-ab5d-d11256d84f83" :step/id #uuid "e175e73c-1506-54af-ab5d-d11256d84f83" :step/content "question-e3764343-10e9-5a7d-b034-e095faf7f51c" :step/next "step-af36c254-27dd-5c17-9617-e7f9d654737f" :db/ensure [:step/validate]} {:db/id "step-af36c254-27dd-5c17-9617-e7f9d654737f" :step/id #uuid "af36c254-27dd-5c17-9617-e7f9d654737f" :step/content 17592186409819 :db/ensure [:step/validate]} [:db/retract 17592186419574 :answer-field/choices 17592186419555] [:db/retract 17592186419574 :answer-field/choices 17592186419556] [:db/retract 17592186419574 :answer-field/choices 17592186419572] [:db/retract 17592186419574 :answer-field/choices 17592186419562] [:db/retract 17592186419574 :answer-field/choices 17592186419567] [:db/retract 17592186323413 :answer-field/choices 17592186322786] [:db/retract 17592186323413 :answer-field/choices 17592186322507] [:db/retract 17592186323413 :answer-field/choices 17592186322716] [:db/retract 17592186323413 :answer-field/choices 17592186322702] [:db/retract 17592186323413 :answer-field/choices 17592186322735] [:db/retract 17592186323602 :answer-field/choices 17592186322898] [:db/retract 17592186323602 :answer-field/choices 17592186321795] [:db/retract 17592186323602 :answer-field/choices 17592186321446] [:db/retract 17592186323602 :answer-field/choices 17592186322182] [:db/retract 17592186323602 :answer-field/choices 17592186322552] {:db/id 17592186124546 :knowledge-point/questions ["question-52f90c3e-788d-5e75-8c65-475f701ec88b" "question-e5cb0f8a-8e07-5249-bc79-49a7b77ca413"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124355 :question/problem "Consider the linear transformation \n![](images/0e/0e394f7c76e9f65e5216d627041f6a906ef2e580de85939e2d64026b82ab18ee.svg) \nand the vectors \n![](images/f1/f19b4a1174a7b45c56e02972a93fc4761dcff3dd5830b0ac1866d9f80f3bd86f.svg)\nWhich of the given vectors belong to the kernel of $\\mathbf{T}?$" :db/ensure [:question/validate]} {:db/id 17592186124518 :knowledge-point/questions ["question-d7ba141f-fb4c-5677-9c12-2cecf5acd474"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124327 :question/problem "Consider the linear transformation ![](images/39/39153d2e76108077485d1676c05530e5b4b2497d3e4efa02251bb03b198bee7e.svg) and the vector ![](images/6e/6e126f01e7689d1be0efddec49224374b09a58e1147351e8adf620d9ef062cac.svg) Find the value of $\\,k\\,$ such that $\\,\\mathbf{u}\\in\\textrm{Ker}(\\mathbf{T}).$" :question/worked-solution "A vector $\\mathbf{u}$ belongs to the kernel of a linear transformation $\\mathbf{T}$ if $\\mathbf{T}(\\mathbf{u})=\\mathbf{0}.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}3\\cdot k+12\\cdot 2-3\\cdot 6 \\\\ -2\\cdot k+4\\cdot 2-2\\cdot 6 \\\\ 6\\cdot k-3\\cdot 2+3\\cdot 6\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}3k+6 \\\\ -2k-4 \\\\ 6k+12\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\{\\begin{aligned}3k+6=0 \\\\ -2k-4=0 \\\\ 6k+12=0.\\end{aligned}\n$$\n\nThe solution to all three of these equations is $k=-2.$" :db/ensure [:question/validate]} {:db/id 17592186124516 :knowledge-point/questions ["question-f32f1d75-9b11-57ea-bfe4-1528ecbfd581" "question-8b821123-b07b-51e0-96de-b9776f35dea3"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124325 :question/problem "Consider the linear transformation ![](images/dc/dc7167e974da1de140ef435bef80635dce264d35149e4b47d11163da494f96e3.svg) Find $\\textrm{Ker}(\\mathbf{T}).$" :question/worked-solution "Finding the kernel of $\\mathbf{T}$ is equivalent to finding the null space of the standard matrix of $\\mathbf{T}.$\n\nFor the given linear transformation, the standard matrix is ![](images/ce/ceecfd6c4dd68aa7527afbee41138c1dbe0609bc9167b5cea48c0aaac1498177.svg)\n\nSetting ![](images/13/13b9be4071882f383a87df41c55302fa01fe6cdccacb93f332f9bb77420df1e6.svg) we then need to solve the equation $T\\mathbf{x}=\\mathbf{0}.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & 4 \\\\ 3 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 \\\\ 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we need to find $x$ in terms of $y.$\n\nFrom the first equation, we get \n\n$$\nx=-2y.\n$$\n\n \n\nTherefore, the kernel of the linear transformation $\\,\\mathbf{T}$ is ![](images/d3/d30f345674a0a66ef197d4d8b418604924be0c8b0f4367901ccc8d75d3901c41.svg)" :db/ensure [:question/validate]} {:db/id 17592186124517 :knowledge-point/questions ["question-1489ce7f-875c-5e62-837a-1b4169461580"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186124326 :question/problem "Given the linear transformation ![](images/57/57112e6087d2f03fe0badc3847a3257495fdb51eb4fe385be7c7a2d743fc0d45.svg) find $\\,\\textrm{nullity}(\\mathbf{T}).$" :question/worked-solution "First, we write down the standard matrix of $\\mathbf{T}\\mathbin{:}$\n\n![](images/94/94a5bcbcf9377b4cc2047b1cbab522eec499bcc5f438f6ee97e2e16e7f837b42.svg)\n\nRecall that $\\textrm{nullity}(\\mathbf{T}) = \\textrm{nullity}(T) = \\textrm{dim}(\\textrm{Null}(T)).$\n\nIn order to find $\\textrm{dim}(\\textrm{Null}(T)),$ we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & 4 & 0 \\\\ 4 & 10 & -1 \\\\ -6 & -12 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 & 0 \\\\ 0 & 2 & -1 \\\\ -6 & -12 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 & 0 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has no non-pivot columns. Therefore, \n\n$$\n\\textrm{nullity}(\\mathbf{T})=\\textrm{dim}(\\textrm{Null}(T))=0.\n$$" :db/ensure [:question/validate]} {:db/id "question-52f90c3e-788d-5e75-8c65-475f701ec88b" :question/id #uuid "52f90c3e-788d-5e75-8c65-475f701ec88b" :question/math-academy-id "q-81384" :question/problem "Consider the linear transformation \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}4x+3y \\\\ -12x-9y\\end{aligned}]$ \nand the vectors \n${v}_{1}=[\\begin{aligned}3 \\\\ 4\\end{aligned}],{v}_{2}=[\\begin{aligned}-3 \\\\ 4\\end{aligned}],{v}_{3}=[\\begin{aligned}6 \\\\ -8\\end{aligned}].$\nWhich of the given vectors belong to the kernel of $T?$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nTherefore, we need to compute $T({v}_{i})$ for each vector ${v}_{i}:$\n\n$$\n\\begin{aligned}T({v}_{1}) & =T([\\begin{aligned}3 \\\\ 4\\end{aligned}])=[\\begin{aligned}24 \\\\ -72\\end{aligned}] \\\\ T({v}_{2}) & =T([\\begin{aligned}-3 \\\\ 4\\end{aligned}])=[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ T({v}_{3}) & =T([\\begin{aligned}6 \\\\ -8\\end{aligned}])=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $\\,T({v}_{2})=T({v}_{3})=0,$ we conclude that the only vectors that belong to the kernel of $\\,T$ are $\\,{v}_{2}$ and ${v}_{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7714a9fc-9cb2-5973-a0f5-19e9eb492e4b"] :db/ensure [:question/validate]} {:db/id "answer-field-7714a9fc-9cb2-5973-a0f5-19e9eb492e4b" :answer-field/id #uuid "7714a9fc-9cb2-5973-a0f5-19e9eb492e4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-cd32bbc5-2f74-5d0f-9a57-6de98d239eca" :answer-field/choices ["answer-5a74588d-7905-5df0-b42a-f72dc5308f07" "answer-3ff79594-e24e-5762-86ab-0aeb3424c662" "answer-cd32bbc5-2f74-5d0f-9a57-6de98d239eca" "answer-e58c2082-609d-5083-974a-1c5cf03a9e8e" "answer-34110eb5-9c97-5c56-9869-82bc944c8d3b"] :db/ensure [:answer-field/validate]} {:db/id "answer-5a74588d-7905-5df0-b42a-f72dc5308f07" :answer/id #uuid "5a74588d-7905-5df0-b42a-f72dc5308f07" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "answer-3ff79594-e24e-5762-86ab-0aeb3424c662" :answer/id #uuid "3ff79594-e24e-5762-86ab-0aeb3424c662" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "answer-cd32bbc5-2f74-5d0f-9a57-6de98d239eca" :answer/id #uuid "cd32bbc5-2f74-5d0f-9a57-6de98d239eca" :answer/type :answer.type/text :answer/value "${v}_{2}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "answer-e58c2082-609d-5083-974a-1c5cf03a9e8e" :answer/id #uuid "e58c2082-609d-5083-974a-1c5cf03a9e8e" :answer/type :answer.type/text :answer/value "${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "answer-34110eb5-9c97-5c56-9869-82bc944c8d3b" :answer/id #uuid "34110eb5-9c97-5c56-9869-82bc944c8d3b" :answer/type :answer.type/text :answer/value "${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "question-e5cb0f8a-8e07-5249-bc79-49a7b77ca413" :question/id #uuid "e5cb0f8a-8e07-5249-bc79-49a7b77ca413" :question/math-academy-id "q-80663" :question/problem "Consider the linear transformation \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}3x+2y \\\\ -9x-6y\\end{aligned}]$ \nand the vectors \n${v}_{1}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}],{v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}],{v}_{3}=[\\begin{aligned}4 \\\\ -6\\end{aligned}].$\nWhich of the given vectors belong to the kernel of $T?$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nTherefore, we need to compute $T({v}_{i})$ for each vector ${v}_{i}:$\n\n$$\n\\begin{aligned}T({v}_{1}) & =T([\\begin{aligned}-2 \\\\ 3\\end{aligned}])=[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ T({v}_{2}) & =T([\\begin{aligned}-1 \\\\ 1\\end{aligned}])=[\\begin{aligned}-1 \\\\ 3\\end{aligned}] \\\\ T({v}_{3}) & =T([\\begin{aligned}4 \\\\ -6\\end{aligned}])=[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $\\,T({v}_{1})=T({v}_{3})=0,$ we conclude that the only vectors that belong to the kernel of $\\,T$ are $\\,{v}_{1}$ and ${v}_{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-8724cf4c-2634-5ef0-8c70-8b6da229c63a"] :db/ensure [:question/validate]} {:db/id "answer-field-8724cf4c-2634-5ef0-8c70-8b6da229c63a" :answer-field/id #uuid "8724cf4c-2634-5ef0-8c70-8b6da229c63a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ec4df685-2392-55ce-b95a-a28b76007ab5" :answer-field/choices ["answer-f49987ea-0169-5cab-85eb-ff1ee67fd47b" "answer-ec4df685-2392-55ce-b95a-a28b76007ab5" "answer-4a4d803c-1e53-5bf2-a8ee-8bddd3cfeb70" "answer-d64d5dc3-1705-5854-b0d1-3a1a2cbb943d" "answer-6339c59a-406d-52cf-a948-16ba1dd58aec"] :db/ensure [:answer-field/validate]} {:db/id "answer-f49987ea-0169-5cab-85eb-ff1ee67fd47b" :answer/id #uuid "f49987ea-0169-5cab-85eb-ff1ee67fd47b" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{2}$ only" :db/ensure [:answer/validate]} {:db/id "answer-ec4df685-2392-55ce-b95a-a28b76007ab5" :answer/id #uuid "ec4df685-2392-55ce-b95a-a28b76007ab5" :answer/type :answer.type/text :answer/value "${v}_{1}$ and ${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "answer-4a4d803c-1e53-5bf2-a8ee-8bddd3cfeb70" :answer/id #uuid "4a4d803c-1e53-5bf2-a8ee-8bddd3cfeb70" :answer/type :answer.type/text :answer/value "${v}_{1}$ only" :db/ensure [:answer/validate]} {:db/id "answer-d64d5dc3-1705-5854-b0d1-3a1a2cbb943d" :answer/id #uuid "d64d5dc3-1705-5854-b0d1-3a1a2cbb943d" :answer/type :answer.type/text :answer/value "${v}_{3}$ only" :db/ensure [:answer/validate]} {:db/id "answer-6339c59a-406d-52cf-a948-16ba1dd58aec" :answer/id #uuid "6339c59a-406d-52cf-a948-16ba1dd58aec" :answer/type :answer.type/text :answer/value "None of the given vectors belong to the kernel of $T$" :db/ensure [:answer/validate]} {:db/id 17592186125104 :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}4\\cdot k-2\\cdot 6 \\\\ -10\\cdot k+5\\cdot 6\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}4k-12 \\\\ -10k+30\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\{\\begin{aligned}4k-12=0 \\\\ -10k+30=0.\\end{aligned}\n$$\n\nThe solution to both of these equations is $k=3.$" :db/ensure [:question/validate]} {:db/id 17592186366358 :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}10\\cdot k+6\\cdot 5 \\\\ 25\\cdot k+15\\cdot 5\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}10k+30 \\\\ 25k+75\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\{\\begin{aligned}10k+30=0 \\\\ 25k+75=0.\\end{aligned}\n$$\n\nThe solution to both of these equations is $k=-3.$" :db/ensure [:question/validate]} {:db/id 17592186394037 :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}3\\cdot (-2)+3+3\\cdot k \\\\ 2\\cdot (-2)+3+k \\\\ -2-3+5\\cdot k\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-3+3k \\\\ -1+k \\\\ -5+5k\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\{\\begin{aligned}-3+3k=0 \\\\ -1+k=0 \\\\ -5+5k=0.\\end{aligned}\n$$\n\nThe solution to all three of these equations is $k=1.$" :db/ensure [:question/validate]} {:db/id 17592186351301 :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}-3\\cdot k+6\\cdot 2 \\\\ 2\\cdot k-4\\cdot 2\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-3k+12 \\\\ 2k-8\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\{\\begin{aligned}-3k+12=0 \\\\ 2k-8=0.\\end{aligned}\n$$\n\nThe solution to both of these equations is $k=4.$" :db/ensure [:question/validate]} {:db/id "question-d7ba141f-fb4c-5677-9c12-2cecf5acd474" :question/id #uuid "d7ba141f-fb4c-5677-9c12-2cecf5acd474" :question/math-academy-id "q-81389" :question/problem "Consider the linear transformation $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}3x+y \\\\ 15x+5y \\\\ -6x-2y\\end{aligned}]$ and the vector $\\,u=[\\begin{aligned}k \\\\ 6 \\\\ 0\\end{aligned}].$ Find the value of $\\,k\\,$ such that $\\,u\\in \\text{Ker}(T).$" :question/worked-solution "A vector $u$ belongs to the kernel of a linear transformation $T$ if $T(u)=0.$ \n\nSo, we need to solve the following equation:\n\n$$\n\\begin{aligned}T(u) & =0 \\\\ [\\begin{aligned}3\\cdot k+6 \\\\ 15\\cdot k+5\\cdot 6 \\\\ -6\\cdot k-2\\cdot 6\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}3k+6 \\\\ 15k+30 \\\\ -6k-12\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we get the system\n\n$$\n\\{\\begin{aligned}3k+6=0 \\\\ 15k+30=0 \\\\ -6k-12=0.\\end{aligned}\n$$\n\nThe solution to all three of these equations is $k=-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-8043bbfb-4ba7-5390-8582-7ad291ce380a"] :db/ensure [:question/validate]} {:db/id "answer-field-8043bbfb-4ba7-5390-8582-7ad291ce380a" :answer-field/id #uuid "8043bbfb-4ba7-5390-8582-7ad291ce380a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6b8cdcbf-ef2d-5021-bec3-b5bc3b245dd9" :answer-field/choices ["answer-00d87305-75ca-5b78-b5e8-ae68465f1ece" "answer-6b8cdcbf-ef2d-5021-bec3-b5bc3b245dd9" "answer-5f3e795c-08ca-5b60-839f-c5d60fdc4b04" "answer-ea2c4637-fa23-5b05-874b-8c92ec63e9f8" "answer-2f9b2610-7605-5718-a92d-9dfc87c5b7bd"] :db/ensure [:answer-field/validate]} {:db/id "answer-00d87305-75ca-5b78-b5e8-ae68465f1ece" :answer/id #uuid "00d87305-75ca-5b78-b5e8-ae68465f1ece" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-6b8cdcbf-ef2d-5021-bec3-b5bc3b245dd9" :answer/id #uuid "6b8cdcbf-ef2d-5021-bec3-b5bc3b245dd9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-5f3e795c-08ca-5b60-839f-c5d60fdc4b04" :answer/id #uuid "5f3e795c-08ca-5b60-839f-c5d60fdc4b04" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-ea2c4637-fa23-5b05-874b-8c92ec63e9f8" :answer/id #uuid "ea2c4637-fa23-5b05-874b-8c92ec63e9f8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "answer-2f9b2610-7605-5718-a92d-9dfc87c5b7bd" :answer/id #uuid "2f9b2610-7605-5718-a92d-9dfc87c5b7bd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "question-f32f1d75-9b11-57ea-bfe4-1528ecbfd581" :question/id #uuid "f32f1d75-9b11-57ea-bfe4-1528ecbfd581" :question/math-academy-id "q-37837" :question/problem "Consider the linear transformation $T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}2x+4y \\\\ -x+2y\\end{aligned}].$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=[\\begin{aligned}2 & 4 \\\\ -1 & 2\\end{aligned}].$\n\nSetting $x=[\\begin{aligned}x \\\\ y\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & 4 \\\\ -1 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 4 \\\\ 0 & 4\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y.$ From the second equation, we obtain $y=0.$ Substituting this into the first equation, we have $x=0.$ \n\nTherefore, the kernel of the linear transformation $T$ is $\\{[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-de328ef9-23d7-525d-a753-5f70c0536f52"] :db/ensure [:question/validate]} {:db/id "answer-field-de328ef9-23d7-525d-a753-5f70c0536f52" :answer-field/id #uuid "de328ef9-23d7-525d-a753-5f70c0536f52" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-ab5a1ea5-3e9e-5ec0-b21a-0db9baf1a4e3" :answer-field/choices ["answer-af648992-ccc2-53a1-bad7-36ea56d6dfd0" "answer-ab5a1ea5-3e9e-5ec0-b21a-0db9baf1a4e3" "answer-cf33566f-e0e1-5630-b237-43de2ee913aa" "answer-ce529969-305d-5eb3-a177-4e8966a9ad83" "answer-06604d00-4f85-5765-a7cb-500cb7224391"] :db/ensure [:answer-field/validate]} {:db/id "answer-af648992-ccc2-53a1-bad7-36ea56d6dfd0" :answer/id #uuid "af648992-ccc2-53a1-bad7-36ea56d6dfd0" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-2y \\\\ y\\end{aligned}]\\,:\\,y\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-ab5a1ea5-3e9e-5ec0-b21a-0db9baf1a4e3" :answer/id #uuid "ab5a1ea5-3e9e-5ec0-b21a-0db9baf1a4e3" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}0 \\\\ 0\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-cf33566f-e0e1-5630-b237-43de2ee913aa" :answer/id #uuid "cf33566f-e0e1-5630-b237-43de2ee913aa" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}3y \\\\ y\\end{aligned}]\\,:\\,y\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-ce529969-305d-5eb3-a177-4e8966a9ad83" :answer/id #uuid "ce529969-305d-5eb3-a177-4e8966a9ad83" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}x \\\\ -2x\\end{aligned}]\\,:\\,x\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-06604d00-4f85-5765-a7cb-500cb7224391" :answer/id #uuid "06604d00-4f85-5765-a7cb-500cb7224391" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}x \\\\ \\frac{1}{2}x\\end{aligned}]\\,:\\,x\\in R\\}" :db/ensure [:answer/validate]} {:db/id 17592186419579 :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=[\\begin{aligned}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{aligned}].$ \n\nSetting $x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}2 & 4 & -2 \\\\ -3 & -6 & 3 \\\\ 4 & 8 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(\\frac{3}{2}){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 4 & 8 & -4\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-2){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 4 & -2 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables, $y,$ and $z.$ That means we need to find $x$ in terms of $y$ and $z.$ \n\nFrom the first equation, we get \n\n$$\nx=-2y+z.\n$$\n\n  \n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{[\\begin{aligned}-2y+z \\\\ y \\\\ z\\end{aligned}]\\,:\\,y,z\\in R\\}.$" :db/ensure [:question/validate]} {:db/id 17592186419574 :answer-field/correct "answer-b52464b5-12d3-55df-8a1f-c2ec33198abb" :answer-field/choices ["answer-b52464b5-12d3-55df-8a1f-c2ec33198abb" "answer-5aa3f0cb-f552-5997-9604-53d87b356492" "answer-ce2608f3-a0b5-5f12-8da7-ae3d41d9398a" "answer-967cf1df-e3fe-5921-8f01-b706d00a2a7f" "answer-c0727ab1-37f4-52c5-b6e4-c5118fe93bbc"] :db/ensure [:answer-field/validate]} {:db/id "answer-b52464b5-12d3-55df-8a1f-c2ec33198abb" :answer/id #uuid "b52464b5-12d3-55df-8a1f-c2ec33198abb" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-2y+z \\\\ y \\\\ z\\end{aligned}]\\,:\\,y,z\\in R\\}." :db/ensure [:answer/validate]} {:db/id "answer-5aa3f0cb-f552-5997-9604-53d87b356492" :answer/id #uuid "5aa3f0cb-f552-5997-9604-53d87b356492" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-4z \\\\ y \\\\ 2z\\end{aligned}]\\,:\\,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-ce2608f3-a0b5-5f12-8da7-ae3d41d9398a" :answer/id #uuid "ce2608f3-a0b5-5f12-8da7-ae3d41d9398a" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-967cf1df-e3fe-5921-8f01-b706d00a2a7f" :answer/id #uuid "967cf1df-e3fe-5921-8f01-b706d00a2a7f" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}x \\\\ 4x+2z \\\\ z\\end{aligned}]\\,:\\,x,y\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-c0727ab1-37f4-52c5-b6e4-c5118fe93bbc" :answer/id #uuid "c0727ab1-37f4-52c5-b6e4-c5118fe93bbc" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}x \\\\ y \\\\ 4x+2y\\end{aligned}]\\,:\\,x,y\\in R\\}" :db/ensure [:answer/validate]} {:db/id "question-8b821123-b07b-51e0-96de-b9776f35dea3" :question/id #uuid "8b821123-b07b-51e0-96de-b9776f35dea3" :question/math-academy-id "q-38689" :question/problem "Consider the linear transformation $T:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]⟶[\\begin{aligned}x-2y+z \\\\ 6x-3y-3z \\\\ 0\\end{aligned}].$ Find $\\,\\text{Ker}(T).$" :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=[\\begin{aligned}1 & -2 & 1 \\\\ 6 & -3 & -3 \\\\ 0 & 0 & 0\\end{aligned}].$\n\nSetting $x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & -2 & 1 \\\\ 6 & -3 & -3 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 9 & -9 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :=\\frac{1}{9}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=z.$ Substituting these into the first equation, we have \n\n$$\nx=2y-z=2z-z=z.\n$$\n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{[\\begin{aligned}z \\\\ z \\\\ z\\end{aligned}]\\,:\\,z\\in R\\}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-b172b207-9ce8-57d0-a93f-f4bc1bd2dba7"] :db/ensure [:question/validate]} {:db/id "answer-field-b172b207-9ce8-57d0-a93f-f4bc1bd2dba7" :answer-field/id #uuid "b172b207-9ce8-57d0-a93f-f4bc1bd2dba7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-158275b9-5947-59e3-903c-3c7f779ef557" :answer-field/choices ["answer-3d771fac-20a4-5da5-9a63-f77ed82f4b7d" "answer-699e4414-d093-5419-b6dd-e106e24458a5" "answer-27f1cb64-dccf-5fab-9082-a461c30b09d4" "answer-5e8dcc3d-1404-533c-80fc-0b0be8a90ea4" "answer-158275b9-5947-59e3-903c-3c7f779ef557"] :db/ensure [:answer-field/validate]} {:db/id "answer-3d771fac-20a4-5da5-9a63-f77ed82f4b7d" :answer/id #uuid "3d771fac-20a4-5da5-9a63-f77ed82f4b7d" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-699e4414-d093-5419-b6dd-e106e24458a5" :answer/id #uuid "699e4414-d093-5419-b6dd-e106e24458a5" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-y \\\\ y \\\\ -y\\end{aligned}]\\,:\\,y\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-27f1cb64-dccf-5fab-9082-a461c30b09d4" :answer/id #uuid "27f1cb64-dccf-5fab-9082-a461c30b09d4" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-z \\\\ 2z \\\\ z\\end{aligned}]\\,:\\,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-5e8dcc3d-1404-533c-80fc-0b0be8a90ea4" :answer/id #uuid "5e8dcc3d-1404-533c-80fc-0b0be8a90ea4" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}y+z \\\\ y \\\\ z\\end{aligned}]\\,:\\,y,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-158275b9-5947-59e3-903c-3c7f779ef557" :answer/id #uuid "158275b9-5947-59e3-903c-3c7f779ef557" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}z \\\\ z \\\\ z\\end{aligned}]\\,:\\,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id 17592186323944 :question/worked-solution "Finding the kernel of $\\,T\\,$ is equivalent to finding the null space of the standard matrix of $\\,T.$\n\nFor the given linear transformation, the standard matrix is $T=[\\begin{aligned}-6 & 3 & -6 \\\\ 1 & -4 & 1 \\\\ 8 & 2 & 8\\end{aligned}].$\n\nSetting $x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}-6 & 3 & -6 \\\\ 1 & -4 & 1 \\\\ 8 & 2 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{6}{R}_{1} \\\\  & ∼[\\begin{aligned}-6 & 3 & -6 \\\\ 0 & -\\frac{7}{2} & 0 \\\\ 8 & 2 & 8\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{4}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}-6 & 3 & -6 \\\\ 0 & -\\frac{7}{2} & 0 \\\\ 0 & 6 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{12}{7}{R}_{2} \\\\  & ∼[\\begin{aligned}-6 & 3 & -6 \\\\ 0 & -\\frac{7}{2} & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=0.$ Substituting this into the first equation, we have $x=-z.$ \n\nTherefore, if $x\\in \\text{Ker}(T),$ then \n\n$$\nx=[\\begin{aligned}-z \\\\ 0 \\\\ z\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]z,\\,z\\in R.\n$$\n\nThis implies that $B=\\{[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]\\}$ is a basis of $\\text{Ker}(T).$" :db/ensure [:question/validate]} {:db/id 17592186323413 :answer-field/correct "answer-f4aaf7aa-e9a1-5334-8fb1-319f1a1174f0" :answer-field/choices ["answer-8584f93d-d159-5c71-b53d-b996bcc93b22" "answer-f4aaf7aa-e9a1-5334-8fb1-319f1a1174f0" "answer-3b540025-77b9-5bb7-9f97-3ab466aa8778" "answer-615800d5-e525-5e24-820b-a9bb8d529e22" "answer-aaeda1c4-dfae-5e5f-b5d4-3287ce85f1a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-8584f93d-d159-5c71-b53d-b996bcc93b22" :answer/id #uuid "8584f93d-d159-5c71-b53d-b996bcc93b22" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-1 \\\\ 0 \\\\ -3\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-f4aaf7aa-e9a1-5334-8fb1-319f1a1174f0" :answer/id #uuid "f4aaf7aa-e9a1-5334-8fb1-319f1a1174f0" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-3b540025-77b9-5bb7-9f97-3ab466aa8778" :answer/id #uuid "3b540025-77b9-5bb7-9f97-3ab466aa8778" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-\\frac{1}{2} \\\\ -3 \\\\ 1\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-615800d5-e525-5e24-820b-a9bb8d529e22" :answer/id #uuid "615800d5-e525-5e24-820b-a9bb8d529e22" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id "answer-aaeda1c4-dfae-5e5f-b5d4-3287ce85f1a6" :answer/id #uuid "aaeda1c4-dfae-5e5f-b5d4-3287ce85f1a6" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]\\}" :db/ensure [:answer/validate]} {:db/id 17592186323943 :question/worked-solution "Finding the kernel of $T$ is equivalent to finding the null space of the standard matrix of $T.$\n\nFror the given linear transformation, the standard matrix is $T=[\\begin{aligned}-9 & -3 & 3 \\\\ -12 & -4 & 4 \\\\ 6 & 8 & 10\\end{aligned}].$\n\nSetting $x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],$ we then need to solve the equation $Tx=0.$ First, we find reduce $T$ to row echelon form, as follows:\n\n$$\n\\begin{aligned}T & =[\\begin{aligned}-9 & -3 & 3 \\\\ -12 & -4 & 4 \\\\ 6 & 8 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{4}{3}){R}_{1} \\\\  & ∼[\\begin{aligned}-9 & -3 & 3 \\\\ 0 & 0 & 0 \\\\ 6 & 8 & 10\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{2}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}-9 & -3 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 6 & 12\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}-9 & -3 & 3 \\\\ 0 & 6 & 12 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$ and $y$, and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$\n\nFrom the second equation, we get $y=-2z.$ Substituting this into the first equation, we have \n\n$$\n\\begin{aligned}-9x-3y+3z & =0 \\\\ -9x-3(-2z)+3z & =0 \\\\ -9x+9z & =0 \\\\ x & =z\\end{aligned}\n$$\n\nTherefore, the kernel of the linear transformation $\\,T$ is $\\{[\\begin{aligned}z \\\\ -2z \\\\ z\\end{aligned}]\\,:\\,z\\in R\\}.$" :db/ensure [:question/validate]} {:db/id 17592186323602 :answer-field/correct "answer-4e5c75b7-6345-538e-96b8-2ba5d8c8cf18" :answer-field/choices ["answer-5ac4954c-967a-55e2-9e2d-f8a985c1ff0f" "answer-21fa64d5-074d-5702-bcf4-064fabb99721" "answer-4263713e-2f96-539b-8f35-ecc62bb28c5f" "answer-b4c02bca-de60-5fa3-8668-018b71b4b4ab" "answer-4e5c75b7-6345-538e-96b8-2ba5d8c8cf18"] :db/ensure [:answer-field/validate]} {:db/id "answer-5ac4954c-967a-55e2-9e2d-f8a985c1ff0f" :answer/id #uuid "5ac4954c-967a-55e2-9e2d-f8a985c1ff0f" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}-\\frac{1}{3}z \\\\ -3z \\\\ z\\end{aligned}]\\,:\\,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-21fa64d5-074d-5702-bcf4-064fabb99721" :answer/id #uuid "21fa64d5-074d-5702-bcf4-064fabb99721" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}x \\\\ x-2z \\\\ z\\end{aligned}]\\,:\\,x,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-4263713e-2f96-539b-8f35-ecc62bb28c5f" :answer/id #uuid "4263713e-2f96-539b-8f35-ecc62bb28c5f" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}x \\\\ y \\\\ 2x-3y\\end{aligned}]\\,:\\,x,y\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-b4c02bca-de60-5fa3-8668-018b71b4b4ab" :answer/id #uuid "b4c02bca-de60-5fa3-8668-018b71b4b4ab" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}y+z \\\\ y \\\\ z\\end{aligned}]\\,:\\,y,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "answer-4e5c75b7-6345-538e-96b8-2ba5d8c8cf18" :answer/id #uuid "4e5c75b7-6345-538e-96b8-2ba5d8c8cf18" :answer/type :answer.type/math :answer/value "\\{[\\begin{aligned}z \\\\ -2z \\\\ z\\end{aligned}]\\,:\\,z\\in R\\}" :db/ensure [:answer/validate]} {:db/id "question-1489ce7f-875c-5e62-837a-1b4169461580" :question/id #uuid "1489ce7f-875c-5e62-837a-1b4169461580" :question/math-academy-id "q-38677" :question/problem "Given the linear transformation $T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}0x+0y \\\\ 0x+0y\\end{aligned}],$ find  $2\\cdot \\text{nullity}(T)-4.$" :question/worked-solution "First, we write down the standard matrix of $T:$\n\n$$\nT=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nRecall that $\\text{nullity}(T)=\\text{nullity}(T)=\\text{dim}(\\text{Null}(T)).$ Notice that $T$ has $2$ non-pivot columns. \n\nTherefore, $\\text{nullity}(T)=\\text{dim}(\\text{Null}(T))=2.$\n\nFinally, we obtain\n\n$$\n2\\cdot \\text{nullity}(T)-4=2\\cdot 2-4=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-d07d81d8-068b-5704-8701-64426907bcc7"] :db/ensure [:question/validate]} {:db/id "answer-field-d07d81d8-068b-5704-8701-64426907bcc7" :answer-field/id #uuid "d07d81d8-068b-5704-8701-64426907bcc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-2baa0d4c-e9e1-57fc-98fe-318195648fbb" :answer-field/choices ["answer-9074ae70-4f70-5481-8939-b34cd328b0df" "answer-08924535-c25f-56c1-8689-8a2f419cd1a3" "answer-2baa0d4c-e9e1-57fc-98fe-318195648fbb" "answer-4a01bca2-b941-5afe-8604-e49eb8cbbbba" "answer-b4a2477e-f888-5314-962e-2dd6fd7d298b"] :db/ensure [:answer-field/validate]} {:db/id "answer-9074ae70-4f70-5481-8939-b34cd328b0df" :answer/id #uuid "9074ae70-4f70-5481-8939-b34cd328b0df" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-08924535-c25f-56c1-8689-8a2f419cd1a3" :answer/id #uuid "08924535-c25f-56c1-8689-8a2f419cd1a3" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-2baa0d4c-e9e1-57fc-98fe-318195648fbb" :answer/id #uuid "2baa0d4c-e9e1-57fc-98fe-318195648fbb" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-4a01bca2-b941-5afe-8604-e49eb8cbbbba" :answer/id #uuid "4a01bca2-b941-5afe-8604-e49eb8cbbbba" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b4a2477e-f888-5314-962e-2dd6fd7d298b" :answer/id #uuid "b4a2477e-f888-5314-962e-2dd6fd7d298b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id 17592186125782 :tutorial/content "The **kernel** of a linear transformation is the set of vectors that map to the zero vector. We define it formally as follows:\n\n*For a linear transformation $\\mathbf{T}$, the **kernel** of $\\mathbf{T}$ is the set of all the vectors $\\mathbf{u}$ such that $\\mathbf{T}(\\mathbf{u})=\\mathbf{0}.$ We can write this as*\n\n$$\n\\textrm{Ker}(\\mathbf{T}) = \\left\\{ \\;\\mathbf{u} \\;| \\; \\mathbf{T}(\\mathbf{u}) = \\mathbf{0} \\right\\}.\n$$\n\nThe diagram below shows the kernel of a linear transformation $\\mathbf{T}: V \\rightarrow V$ in a vector space $V$.\n\n![](images/05/05f8c544d55c6bb07e4063150e586f8b4a7c51a352c2ff8ddda8c4cd5047dd93.png)\n\nNotice that, because of linearity, the zero vector is always in the kernel of a linear transformation: \n\n$$\n\\mathbf{T}(\\mathbf{0})=\\mathbf{T}(0\\cdot\\mathbf{v})=0\\cdot\\mathbf{T}(\\mathbf{v})= \\mathbf 0\n$$\n\nfor any vector $\\mathbf{v}$." :db/ensure [:tutorial/validate]} {:db/id 17592186124745 :activity/expected-seconds 660.0 :db/ensure [:activity/validate]} {:db/id 17592186179741 :knowledge-point/questions ["question-442b3fed-648b-5cc8-977b-6700ae26738b"] :db/ensure [:knowledge-point/validate]} {:db/id "question-442b3fed-648b-5cc8-977b-6700ae26738b" :question/id #uuid "442b3fed-648b-5cc8-977b-6700ae26738b" :question/math-academy-id "q-125482" :question/problem "Calculate the circulation $Γ$ of the vector field $F(x,y)=\\frac{1}{y}\\,i+\\frac{1}{x}\\,j$ along the circle $C$ with equation ${x}^{2}+{y}^{2}=9$ oriented counterclockwise." :question/worked-solution "The closed curve $C$ is the circle of radius $3$ centered at the origin. It can be parameterized in the counterclockwise direction as\n\n$$\nr(t)=3\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le 2\\pi .\n$$\n\nThe circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\nSo,\n\n$$\n\\begin{aligned}F(r(t)) & =\\frac{1}{y}\\,i+\\frac{1}{x}\\,j \\\\  & =\\frac{1}{3\\operatorname{sin}⁡t}\\,i+\\frac{1}{3\\operatorname{cos}⁡t}\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j \\\\  & =-3\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\frac{1}{3\\operatorname{sin}⁡t}\\,i+\\frac{1}{3\\operatorname{cos}⁡t}\\,j)\\cdot (-3\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j) \\\\  & =\\frac{1}{3\\operatorname{sin}⁡t}\\cdot (-3\\operatorname{sin}⁡t)+\\frac{1}{3\\operatorname{cos}⁡t}\\cdot 3\\operatorname{cos}⁡t \\\\  & =-1+1 \\\\  & =0.\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\begin{aligned}Γ={∮}_{C}F\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t=0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-bbf611c1-7a64-56ff-a8ce-599f171848cc"] :db/ensure [:question/validate]} {:db/id "answer-field-bbf611c1-7a64-56ff-a8ce-599f171848cc" :answer-field/id #uuid "bbf611c1-7a64-56ff-a8ce-599f171848cc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c3275529-012a-5a31-82a4-2f28fcd1acb1" :answer-field/choices ["answer-c26f1bdf-26e0-5acd-bbc9-1a8e6be78f5f" "answer-1b7d45a6-b7b5-5b6e-a82c-a1748d83e603" "answer-c3275529-012a-5a31-82a4-2f28fcd1acb1" "answer-7e4f36c3-2d0c-50c9-a36d-272fd914e84a" "answer-ff6f64d6-184a-5394-8a28-a8c004572db7"] :db/ensure [:answer-field/validate]} {:db/id "answer-c26f1bdf-26e0-5acd-bbc9-1a8e6be78f5f" :answer/id #uuid "c26f1bdf-26e0-5acd-bbc9-1a8e6be78f5f" :answer/type :answer.type/math :answer/value "-3\\pi " :db/ensure [:answer/validate]} {:db/id "answer-1b7d45a6-b7b5-5b6e-a82c-a1748d83e603" :answer/id #uuid "1b7d45a6-b7b5-5b6e-a82c-a1748d83e603" :answer/type :answer.type/math :answer/value "-9\\pi " :db/ensure [:answer/validate]} {:db/id "answer-c3275529-012a-5a31-82a4-2f28fcd1acb1" :answer/id #uuid "c3275529-012a-5a31-82a4-2f28fcd1acb1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-7e4f36c3-2d0c-50c9-a36d-272fd914e84a" :answer/id #uuid "7e4f36c3-2d0c-50c9-a36d-272fd914e84a" :answer/type :answer.type/math :answer/value "3\\pi " :db/ensure [:answer/validate]} {:db/id "answer-ff6f64d6-184a-5394-8a28-a8c004572db7" :answer/id #uuid "ff6f64d6-184a-5394-8a28-a8c004572db7" :answer/type :answer.type/math :answer/value "9\\pi " :db/ensure [:answer/validate]} {:db/id 17592186179740 :knowledge-point/questions ["question-a9318e5b-e833-584c-92bb-558dab7e94de" "question-afd2a4b0-18e7-5bc4-9563-64bdaef16530" "question-674f4764-9a63-51ae-b803-b7fdf438bb38" "question-d78a254d-adb2-5551-a797-0a608524ca4f"] :db/ensure [:knowledge-point/validate]} {:db/id "question-a9318e5b-e833-584c-92bb-558dab7e94de" :question/id #uuid "a9318e5b-e833-584c-92bb-558dab7e94de" :question/math-academy-id "q-125640" :question/problem "![](images/a1/a1883ee3a3a99d43109bae2d2093aef35548dde9753cfb7dc19dfd77a104ec83.png)\n\nConsider the ellipse $E$ and the vector field $F,$ shown above. Let $C$ be any path where $E$ is traversed once in the counterclockwise direction. Which of the following statements are true?\n\nI. ${∮}_{C}F\\cdot \\text{d}r>0$\n\nII. ${∮}_{-C}F\\cdot \\text{d}r>0$\n\nIII. ${∮}_{C}F\\cdot \\text{d}r<0$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement III is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves counterclockwise along $C.$ \n\n![](images/85/8595904122fac3431fc959b2fa4aa5a3062bd1bffd1a391a0861fa12f2498054.png)\n\nSo, ${∮}_{C}F\\cdot \\text{d}r<0.$\n\n- Statement II is true. It's clear from the picture below that $F$ assists the motion of the particle as it moves **clockwise** along $C.$\n\n![](images/f1/f1f31f2b6eefddedc46b8e845703904c0b4566963e64a644f7a4ab32bb7240c3.png)\n\nSo, ${∮}_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-07b21c95-dc62-58a4-b763-c93eafdfda09"] :db/ensure [:question/validate]} {:db/id "answer-field-07b21c95-dc62-58a4-b763-c93eafdfda09" :answer-field/id #uuid "07b21c95-dc62-58a4-b763-c93eafdfda09" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3af01276-3947-5c77-abb0-001b7f9268cb" :answer-field/choices ["answer-74a31f1c-47e3-545d-a815-1b80644ceb5a" "answer-029ef420-9eaa-5c6d-8287-3ef33710e976" "answer-3af01276-3947-5c77-abb0-001b7f9268cb" "answer-ce1d9b86-ba57-557d-9af4-ca1029204f80" "answer-c134f711-db33-5b9e-bc96-94b44710886e"] :db/ensure [:answer-field/validate]} {:db/id "answer-74a31f1c-47e3-545d-a815-1b80644ceb5a" :answer/id #uuid "74a31f1c-47e3-545d-a815-1b80644ceb5a" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-029ef420-9eaa-5c6d-8287-3ef33710e976" :answer/id #uuid "029ef420-9eaa-5c6d-8287-3ef33710e976" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-3af01276-3947-5c77-abb0-001b7f9268cb" :answer/id #uuid "3af01276-3947-5c77-abb0-001b7f9268cb" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-ce1d9b86-ba57-557d-9af4-ca1029204f80" :answer/id #uuid "ce1d9b86-ba57-557d-9af4-ca1029204f80" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-c134f711-db33-5b9e-bc96-94b44710886e" :answer/id #uuid "c134f711-db33-5b9e-bc96-94b44710886e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-afd2a4b0-18e7-5bc4-9563-64bdaef16530" :question/id #uuid "afd2a4b0-18e7-5bc4-9563-64bdaef16530" :question/math-academy-id "q-125666" :question/problem "![](images/d0/d042734a8c7483c54795cd6ec8527b43f398cb77487d054a36b27d704f27a318.png)\n\nConsider the ellipse $E$ and the vector field $F,$ shown above. Let $C$ be any path where $E$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\nI. ${∮}_{C}F\\cdot \\text{d}r=0$\n\nII. ${∮}_{C}F\\cdot \\text{d}r<0$\n\nIII. ${∮}_{-C}F\\cdot \\text{d}r<0$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false, while statement II is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves clockwise along $C.$ \n\n![](images/f8/f8268167bb50f9d03cb38a3d505fa6b40003e307b149356089f5b0dc3dd32110.png)\n\nSo, $Γ={∮}_{C}F\\cdot \\text{d}r<0.$\n\n- Statement III is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves counterclockwise along $C.$\n\n![](images/a8/a83934aa58040b4eb2bb957d1d12caba676e306e41086480d064935eab9f1c59.png)\n\nSo, $Γ={∮}_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-e2afbdbe-c2b8-5f8b-8cd1-c52860a3b3d5"] :db/ensure [:question/validate]} {:db/id "answer-field-e2afbdbe-c2b8-5f8b-8cd1-c52860a3b3d5" :answer-field/id #uuid "e2afbdbe-c2b8-5f8b-8cd1-c52860a3b3d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-97eeaf90-7d49-5a72-b321-ee76bbb6e4a5" :answer-field/choices ["answer-40242699-9a76-5769-ad29-253e8f600b34" "answer-63642342-0ea8-5389-ae31-2bce908c8ad8" "answer-c097de0b-9eac-5b4e-97f4-50838319facf" "answer-97eeaf90-7d49-5a72-b321-ee76bbb6e4a5" "answer-90199dc9-7e02-5cd1-bdd7-df4867251c41"] :db/ensure [:answer-field/validate]} {:db/id "answer-40242699-9a76-5769-ad29-253e8f600b34" :answer/id #uuid "40242699-9a76-5769-ad29-253e8f600b34" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-63642342-0ea8-5389-ae31-2bce908c8ad8" :answer/id #uuid "63642342-0ea8-5389-ae31-2bce908c8ad8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-c097de0b-9eac-5b4e-97f4-50838319facf" :answer/id #uuid "c097de0b-9eac-5b4e-97f4-50838319facf" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-97eeaf90-7d49-5a72-b321-ee76bbb6e4a5" :answer/id #uuid "97eeaf90-7d49-5a72-b321-ee76bbb6e4a5" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-90199dc9-7e02-5cd1-bdd7-df4867251c41" :answer/id #uuid "90199dc9-7e02-5cd1-bdd7-df4867251c41" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-674f4764-9a63-51ae-b803-b7fdf438bb38" :question/id #uuid "674f4764-9a63-51ae-b803-b7fdf438bb38" :question/math-academy-id "q-125667" :question/problem "![](images/13/13e4c6a06a44099024ce91ef6c9ed4679af037c2e794351597a4d604bf39dc6f.png)\n\nConsider the ellipse $E$ and vector field $F$ shown above. Let $C$ be any path where $E$ is traversed once in the counterclockwise direction. Which of the following statements are true?\n\nI. ${∮}_{C}F\\cdot \\text{d}r=0$\n\nII. ${∮}_{C}F\\cdot \\text{d}r>0$\n\nIII. ${∮}_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement II is false. Since the force $F$ acts perpendicular to the motion of the particle as it moves around $C,$ it neither helps nor hinders its motion. \n\n![](images/63/6371bb04d33719ee18c65a92354e84be0e9077e780eac9559dcb7ec42deb8d99.png)\n\nSo, ${∮}_{C}F\\cdot \\text{d}r=0.$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ remains unchanged.\n\n![](images/0b/0bd9476fa9b19f04b40fbb9cca2986ed90495aa134307606622ef91070af19a7.png)\n\nSo, ${∮}_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-82c6016b-0343-53a1-a3ae-36d3278711ed"] :db/ensure [:question/validate]} {:db/id "answer-field-82c6016b-0343-53a1-a3ae-36d3278711ed" :answer-field/id #uuid "82c6016b-0343-53a1-a3ae-36d3278711ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-5b31d58a-98fe-5653-8b2e-f0931877d07f" :answer-field/choices ["answer-32f5e806-242d-5b1a-8886-66c2da17be28" "answer-5b31d58a-98fe-5653-8b2e-f0931877d07f" "answer-e34fc7a8-8d96-5fc5-a347-b84cc10b6757" "answer-814fc88c-5be7-5618-be65-2f99b06af468" "answer-708e66ed-fb9c-572e-9876-d3e2f4e3957c"] :db/ensure [:answer-field/validate]} {:db/id "answer-32f5e806-242d-5b1a-8886-66c2da17be28" :answer/id #uuid "32f5e806-242d-5b1a-8886-66c2da17be28" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "answer-5b31d58a-98fe-5653-8b2e-f0931877d07f" :answer/id #uuid "5b31d58a-98fe-5653-8b2e-f0931877d07f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-e34fc7a8-8d96-5fc5-a347-b84cc10b6757" :answer/id #uuid "e34fc7a8-8d96-5fc5-a347-b84cc10b6757" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-814fc88c-5be7-5618-be65-2f99b06af468" :answer/id #uuid "814fc88c-5be7-5618-be65-2f99b06af468" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-708e66ed-fb9c-572e-9876-d3e2f4e3957c" :answer/id #uuid "708e66ed-fb9c-572e-9876-d3e2f4e3957c" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "question-d78a254d-adb2-5551-a797-0a608524ca4f" :question/id #uuid "d78a254d-adb2-5551-a797-0a608524ca4f" :question/math-academy-id "q-125669" :question/problem "![](images/36/36ebce64036b7661c81aa6525c407f698375544532985175cc465ddc3ff4f5a8.png)\n\nConsider the circle $S$ and vector field $F$ shown above. Let $C$ be any path where $S$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\nI. ${∮}_{C}F\\cdot \\text{d}r=0$\n\nII. ${∮}_{-C}F\\cdot \\text{d}r=0$\n\nIII. ${∮}_{C}F\\cdot \\text{d}r>0$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement III is false. Since the force $F$ acts perpendicular to the motion of the particle as it moves around $C,$ it neither helps nor hinders its motion. \n\n![](images/c4/c498ddeae8ba4325a4a1dfc0840520c4718bb50a0600970405374dde933e1b1d.png)\n\nSo, ${∮}_{C}F\\cdot \\text{d}r=0.$\n\n- Statement II is true. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ remains unchanged.\n\n![](images/74/740429a29b5eb4b72bbfae11e08c9ac272e72e31d395b4dad2602beb4d4ba40a.png)\n\nSo, ${∮}_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-bd93af99-5bab-55c2-8a85-e0d5efec7517"] :db/ensure [:question/validate]} {:db/id "answer-field-bd93af99-5bab-55c2-8a85-e0d5efec7517" :answer-field/id #uuid "bd93af99-5bab-55c2-8a85-e0d5efec7517" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-b6715a23-2351-5f62-8ba5-ef943e459d30" :answer-field/choices ["answer-b6715a23-2351-5f62-8ba5-ef943e459d30" "answer-c19b819d-c541-51b6-a6e0-7dae5f0106b8" "answer-7ad5e1c3-fe87-52c4-9343-a5e560de27a1" "answer-7781bfa2-360a-52f2-b8a7-5fd12172c6fe" "answer-9a55b0b7-ffd1-54c4-8119-7e1a1a488949"] :db/ensure [:answer-field/validate]} {:db/id "answer-b6715a23-2351-5f62-8ba5-ef943e459d30" :answer/id #uuid "b6715a23-2351-5f62-8ba5-ef943e459d30" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "answer-c19b819d-c541-51b6-a6e0-7dae5f0106b8" :answer/id #uuid "c19b819d-c541-51b6-a6e0-7dae5f0106b8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "answer-7ad5e1c3-fe87-52c4-9343-a5e560de27a1" :answer/id #uuid "7ad5e1c3-fe87-52c4-9343-a5e560de27a1" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "answer-7781bfa2-360a-52f2-b8a7-5fd12172c6fe" :answer/id #uuid "7781bfa2-360a-52f2-b8a7-5fd12172c6fe" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "answer-9a55b0b7-ffd1-54c4-8119-7e1a1a488949" :answer/id #uuid "9a55b0b7-ffd1-54c4-8119-7e1a1a488949" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "activity-129cb966-e09b-519a-a368-62dfaa636adb" :activity/id #uuid "129cb966-e09b-519a-a368-62dfaa636adb" :activity/title "Circulation" :activity/type :activity.type/review :activity/scope 17592186050773 :activity/course 17592186046660 :activity/steps ["step-40211c38-7902-5a30-be18-54ba1e524e35" "step-79347290-b94d-53e8-a6ae-104c05d725cf" "step-48918b6d-e2d1-57bd-906d-d8cb6cd2a9dd" "step-fa7bb3f5-8a01-54f6-a7fb-3948ae86282d" "step-23ee9455-766f-5586-95a2-a9ed8dfe87ce"] :activity/first-step "step-40211c38-7902-5a30-be18-54ba1e524e35" :db/ensure [:activity/validate]} {:db/id "step-40211c38-7902-5a30-be18-54ba1e524e35" :step/id #uuid "40211c38-7902-5a30-be18-54ba1e524e35" :step/content "question-442b3fed-648b-5cc8-977b-6700ae26738b" :step/next "step-79347290-b94d-53e8-a6ae-104c05d725cf" :db/ensure [:step/validate]} {:db/id "step-79347290-b94d-53e8-a6ae-104c05d725cf" :step/id #uuid "79347290-b94d-53e8-a6ae-104c05d725cf" :step/content "question-a9318e5b-e833-584c-92bb-558dab7e94de" :step/next "step-48918b6d-e2d1-57bd-906d-d8cb6cd2a9dd" :db/ensure [:step/validate]} {:db/id "step-48918b6d-e2d1-57bd-906d-d8cb6cd2a9dd" :step/id #uuid "48918b6d-e2d1-57bd-906d-d8cb6cd2a9dd" :step/content "question-afd2a4b0-18e7-5bc4-9563-64bdaef16530" :step/next "step-fa7bb3f5-8a01-54f6-a7fb-3948ae86282d" :db/ensure [:step/validate]} {:db/id "step-fa7bb3f5-8a01-54f6-a7fb-3948ae86282d" :step/id #uuid "fa7bb3f5-8a01-54f6-a7fb-3948ae86282d" :step/content "question-674f4764-9a63-51ae-b803-b7fdf438bb38" :step/next "step-23ee9455-766f-5586-95a2-a9ed8dfe87ce" :db/ensure [:step/validate]} {:db/id "step-23ee9455-766f-5586-95a2-a9ed8dfe87ce" :step/id #uuid "23ee9455-766f-5586-95a2-a9ed8dfe87ce" :step/content "question-d78a254d-adb2-5551-a797-0a608524ca4f" :db/ensure [:step/validate]} {:db/id 17592186073883 :knowledge-point/questions ["question-c86d32ea-3b60-551a-b012-a25bf9e902f1" "question-26043956-17e4-5b29-845c-4ac503465356"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073565 :question/problem "By finding the missing values in the ratio table below, determine the graph that represents the given relationship.\n\n| $x$ | $y$ |\n| --- | --- |\n| $4$ | $2$ |\n| $8$ |  |\n|  | $6$ |" :question/worked-solution "We start with the ratio ${\\color{blue}4}:{\\color{red}2}$ and write it as a fraction:\n\n$$\n\\dfrac{{\\color{blue}4}}{{\\color{red}2}}\n$$\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n$$\n\\begin{aligned}\\frac{4\\times 2}{2\\times 2} & =\\frac{8}{4} \\\\ \\frac{4\\times 3}{2\\times 3} & =\\frac{12}{6}\\end{aligned}\n$$\n\nWe add these to our ratio table:\n\n| $x$ | $y$ |\n| --- | --- |\n| $4$ | $2$ |\n| $8$ | $4$ |\n| $12$ | $6$ |\n\nSo, we have the following ordered pairs: $(4,2),$ $(8,4),$ $(12,6).$\n\nPlotting these points on the coordinate plane and connecting them with a straight line, we get the following graph:\n\n![](images/8d/8def1b37d62f91a16109db0da3287042fe5893b97bf447e6ee16946b3f8d4bfc.png)" :db/ensure [:question/validate]} {:db/id 17592186073884 :knowledge-point/questions ["question-09704368-087d-58c9-83a5-3809f87b5870"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073566 :question/worked-solution "We see that the point $(32,20)$ lies on the graph. Let's write the ratio $32:20$ as a fraction:\n\n$$\n\\dfrac{32}{20}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $4\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{32÷4}{20÷4} & =\\frac{8}{5}\\end{aligned}\n$$\n\nSo the graph shows the ratio $\\dfrac{8}{5}.$" :db/ensure [:question/validate]} {:db/id 17592186073885 :knowledge-point/questions ["question-5486d651-e419-5bc9-92fb-f6314f16f8ec" "question-27c27f4e-31e8-5cd4-984c-7b21ba6ab49b"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186073568 :question/worked-solution "One of the points belonging to the graph is $(15,6).$\n\nLet's write the ratio $15:6$ as a fraction:\n\n$$\n\\dfrac{15}{6}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $3\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{15÷3}{6÷3} & =\\frac{5}{2}\\end{aligned}\n$$\n\nSo the ratio of flour to water is $5:2.$" :db/ensure [:question/validate]} {:db/id "question-c86d32ea-3b60-551a-b012-a25bf9e902f1" :question/id #uuid "c86d32ea-3b60-551a-b012-a25bf9e902f1" :question/math-academy-id "q-59987" :question/problem "By finding the missing values in the ratio table below, determine which of the following graphs represents the given relationship.\n\n| $x$ | $y$ |\n| --- | --- |\n| $5$ | $4$ |\n|  | $8$ |\n| $15$ |  |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $5:4$ and write it as a fraction:\n\n$$\n\\frac{5}{4}\n$$\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n$$\n\\begin{aligned}\\frac{5\\times 2}{4\\times 2} & =\\frac{10}{8} \\\\ \\frac{5\\times 3}{4\\times 3} & =\\frac{15}{12}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| $x$ | $y$ |\n| --- | --- |\n| $5$ | $4$ |\n| $10$ | $8$ |\n| $15$ | $12$ |\n\n$$\n\n$$\n\nSo, we have the following ordered pairs: $(5,4),$ $(10,8),$ $(15,12).$\n\nPlotting these points on the coordinate plane, we get:\n\n![](images/d4/d4bf54ac87bed89a5384359136feb1e5e0e090f6f7065b48ea99915f4fafdfb0.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-139b7f16-5ea6-55e2-ab57-c8a8604ce820"] :db/ensure [:question/validate]} {:db/id "answer-field-139b7f16-5ea6-55e2-ab57-c8a8604ce820" :answer-field/id #uuid "139b7f16-5ea6-55e2-ab57-c8a8604ce820" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-7f87c50d-5bbe-5291-8099-c78615d94ae9" :answer-field/choices ["answer-c8103745-4541-5078-ac87-e277c02e25b3" "answer-8f84ea47-9dff-5054-a807-e8884a1116de" "answer-363450b0-93be-5c6b-bafd-47553e06faed" "answer-66704f77-a902-52f3-b242-faddff4193f6" "answer-7f87c50d-5bbe-5291-8099-c78615d94ae9"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8103745-4541-5078-ac87-e277c02e25b3" :answer/id #uuid "c8103745-4541-5078-ac87-e277c02e25b3" :answer/type :answer.type/image :answer/value "images/31/31a2ba5b48662aeb3ccef98aeae1d04d670ca13e4b678c17d407773eebd37b40.png" :db/ensure [:answer/validate]} {:db/id "answer-8f84ea47-9dff-5054-a807-e8884a1116de" :answer/id #uuid "8f84ea47-9dff-5054-a807-e8884a1116de" :answer/type :answer.type/image :answer/value "images/3a/3a13003f8217318500d1ad2363cb65db4f48d66328fadebbb5062b398e4ca05e.png" :db/ensure [:answer/validate]} {:db/id "answer-363450b0-93be-5c6b-bafd-47553e06faed" :answer/id #uuid "363450b0-93be-5c6b-bafd-47553e06faed" :answer/type :answer.type/image :answer/value "images/6f/6f6b3b18fd4d113cff4abe043409106945f76923dca7ef08732e57cd546ad218.png" :db/ensure [:answer/validate]} {:db/id "answer-66704f77-a902-52f3-b242-faddff4193f6" :answer/id #uuid "66704f77-a902-52f3-b242-faddff4193f6" :answer/type :answer.type/image :answer/value "images/bd/bdc4e50d04c9e726669de07867ddf161ffc41d577d9eeeff167eec867651d7ad.png" :db/ensure [:answer/validate]} {:db/id "answer-7f87c50d-5bbe-5291-8099-c78615d94ae9" :answer/id #uuid "7f87c50d-5bbe-5291-8099-c78615d94ae9" :answer/type :answer.type/image :answer/value "images/d4/d4bf54ac87bed89a5384359136feb1e5e0e090f6f7065b48ea99915f4fafdfb0.png" :db/ensure [:answer/validate]} {:db/id "question-26043956-17e4-5b29-845c-4ac503465356" :question/id #uuid "26043956-17e4-5b29-845c-4ac503465356" :question/math-academy-id "q-60216" :question/problem "By finding the missing values in the ratio table below, determine which of the following graphs represents the given relationship.\n\n| $x$ | $y$ |\n| --- | --- |\n| $2$ | $1$ |\n|  | $3$ |\n| $8$ |  |\n\n$$\n\n$$" :question/worked-solution "We start with the ratio $2:1$ and write it as a fraction:\n\n$$\n\\frac{2}{1}\n$$\n\nWe can generate equivalent ratios by finding equivalent fractions:\n\n$$\n\\begin{aligned}\\frac{2\\times 3}{1\\times 3} & =\\frac{6}{3} \\\\ \\frac{2\\times 4}{1\\times 4} & =\\frac{8}{4}\\end{aligned}\n$$\n\nWe add this to our ratio table:\n\n| $x$ | $y$ |\n| --- | --- |\n| $2$ | $1$ |\n| $6$ | $3$ |\n| $8$ | $4$ |\n\n$$\n\n$$\n\nSo, we have the following ordered pairs: $(2,1),$ $(6,3),$ $(8,4).$\n\nPlotting these points on the coordinate plane, we get:\n\n![](images/67/67a63fc01a35a6f1a91153e25383b84d8b320c6c09eab2194ee39cd570ed799f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-4fdff7c3-29c6-57d5-ac8c-1a94df8a625e"] :db/ensure [:question/validate]} {:db/id "answer-field-4fdff7c3-29c6-57d5-ac8c-1a94df8a625e" :answer-field/id #uuid "4fdff7c3-29c6-57d5-ac8c-1a94df8a625e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-3b95188c-80c5-5680-b1bb-4b77ee8b29ec" :answer-field/choices ["answer-001a8d81-f5d9-5566-a1e8-0eda0971e84c" "answer-3b95188c-80c5-5680-b1bb-4b77ee8b29ec" "answer-402fba0c-aa73-5e8a-b5d3-77b9642c6934" "answer-6305a3b7-226b-53b1-8bd9-6364cfeaa024" "answer-1c57d50f-49fb-5a5c-a956-799c84c63dd6"] :db/ensure [:answer-field/validate]} {:db/id "answer-001a8d81-f5d9-5566-a1e8-0eda0971e84c" :answer/id #uuid "001a8d81-f5d9-5566-a1e8-0eda0971e84c" :answer/type :answer.type/image :answer/value "images/5f/5f3d4d4fa41ab9f8f4403189e6e032ed6c28be107fb0730c19a6c388e293007b.png" :db/ensure [:answer/validate]} {:db/id "answer-3b95188c-80c5-5680-b1bb-4b77ee8b29ec" :answer/id #uuid "3b95188c-80c5-5680-b1bb-4b77ee8b29ec" :answer/type :answer.type/image :answer/value "images/67/67a63fc01a35a6f1a91153e25383b84d8b320c6c09eab2194ee39cd570ed799f.png" :db/ensure [:answer/validate]} {:db/id "answer-402fba0c-aa73-5e8a-b5d3-77b9642c6934" :answer/id #uuid "402fba0c-aa73-5e8a-b5d3-77b9642c6934" :answer/type :answer.type/image :answer/value "images/6a/6a5d172ff94df18a8c50874a5facc83e67aa91fa6023370406f824d7320331f6.png" :db/ensure [:answer/validate]} {:db/id "answer-6305a3b7-226b-53b1-8bd9-6364cfeaa024" :answer/id #uuid "6305a3b7-226b-53b1-8bd9-6364cfeaa024" :answer/type :answer.type/image :answer/value "images/8f/8feba19e693f7a89c80722f9543b61880cb7cb0cb92e634b86599343086c318f.png" :db/ensure [:answer/validate]} {:db/id "answer-1c57d50f-49fb-5a5c-a956-799c84c63dd6" :answer/id #uuid "1c57d50f-49fb-5a5c-a956-799c84c63dd6" :answer/type :answer.type/image :answer/value "images/a2/a2fdb375ad24c522070f83eb5909a77340931466ab4c575dbbfac1246f6eaab8.png" :db/ensure [:answer/validate]} {:db/id 17592186074429 :question/problem "![](images/ff/fff2856c61220b283803ca21cacc4a47be8888d75bc6ad35df5f09a1136d4c51.png)\n\nWhat $x:y$ ratio is shown in the graph above?" :question/worked-solution "We see that the point $(3,5)$ lies on the graph. Let's write the ratio $3:5$ as a fraction:\n\n$$\n\\frac{3}{5}\n$$\n\nWe can not simplify this fraction further. Hence, we can say that the graph shows the ratio $\\frac{3}{5}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186072812 :answer-field/correct 17592186072816 :db/ensure [:answer-field/validate]} {:db/id "question-09704368-087d-58c9-83a5-3809f87b5870" :question/id #uuid "09704368-087d-58c9-83a5-3809f87b5870" :question/math-academy-id "q-93104" :question/problem "![](images/29/29aa8ec05b0299191e838f80064319f5ef1c2f70894ad34077528c925118ea31.png)\n\nWhat $x:y$ ratio is shown in the graph above?" :question/worked-solution "We see that the point $(3,4)$ lies on the graph. Let's write the ratio $3:4$ as a fraction:\n\n$$\n\\frac{3}{4}\n$$\n\nWe can not simplify this fraction further. Hence, we can say that the graph shows the ratio $3:4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-f4fd1e07-0adb-56e4-8804-d938691dda0b"] :db/ensure [:question/validate]} {:db/id "answer-field-f4fd1e07-0adb-56e4-8804-d938691dda0b" :answer-field/id #uuid "f4fd1e07-0adb-56e4-8804-d938691dda0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-093d6f1d-2d83-5f93-9fd8-7e95bbb8dad8" :answer-field/choices ["answer-8caf9774-5ba4-52f6-a1d5-322a0a1baf98" "answer-506a0893-cf7f-54b2-9a3b-e21c7908d105" "answer-1175a25c-0a97-56f3-827c-93786fe226c1" "answer-093d6f1d-2d83-5f93-9fd8-7e95bbb8dad8" "answer-0393f171-4457-5225-87a2-ffc71a1a07a6"] :db/ensure [:answer-field/validate]} {:db/id "answer-8caf9774-5ba4-52f6-a1d5-322a0a1baf98" :answer/id #uuid "8caf9774-5ba4-52f6-a1d5-322a0a1baf98" :answer/type :answer.type/math :answer/value "1:2" :db/ensure [:answer/validate]} {:db/id "answer-506a0893-cf7f-54b2-9a3b-e21c7908d105" :answer/id #uuid "506a0893-cf7f-54b2-9a3b-e21c7908d105" :answer/type :answer.type/math :answer/value "2:3" :db/ensure [:answer/validate]} {:db/id "answer-1175a25c-0a97-56f3-827c-93786fe226c1" :answer/id #uuid "1175a25c-0a97-56f3-827c-93786fe226c1" :answer/type :answer.type/math :answer/value "3:2" :db/ensure [:answer/validate]} {:db/id "answer-093d6f1d-2d83-5f93-9fd8-7e95bbb8dad8" :answer/id #uuid "093d6f1d-2d83-5f93-9fd8-7e95bbb8dad8" :answer/type :answer.type/math :answer/value "3:4" :db/ensure [:answer/validate]} {:db/id "answer-0393f171-4457-5225-87a2-ffc71a1a07a6" :answer/id #uuid "0393f171-4457-5225-87a2-ffc71a1a07a6" :answer/type :answer.type/math :answer/value "4:3" :db/ensure [:answer/validate]} {:db/id "question-5486d651-e419-5bc9-92fb-f6314f16f8ec" :question/id #uuid "5486d651-e419-5bc9-92fb-f6314f16f8ec" :question/math-academy-id "q-93311" :question/problem "![](images/89/895e7c02241a561dad88f45f67d1b52de966925bcc8ee5c7a3a840b209a1ef7c.png)\n\nDorothy is mixing red and yellow paints to make a particular shade of orange. The amount of red paint she needs for a given amount of yellow paint is shown above. In its simplest form, what is the ratio of red to yellow paint in this mix?" :question/worked-solution "One of the points belonging to the graph is $(1\\,000,200).$ Let's write the ratio $1\\,000:200$ as a fraction:\n\n$$\n\\frac{1\\,000}{200}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $200:$\n\n$$\n\\frac{1\\,000÷200}{200÷200}=\\frac{5}{1}\n$$\n\n So the ratio of red paint to yellow paint is $5:1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-911476e4-bbe7-5564-815b-0e4c85c707f3"] :db/ensure [:question/validate]} {:db/id "answer-field-911476e4-bbe7-5564-815b-0e4c85c707f3" :answer-field/id #uuid "911476e4-bbe7-5564-815b-0e4c85c707f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-c90aabe3-00da-5a03-ab00-efa95a2ab8b1" :answer-field/choices ["answer-c8532e8f-1e11-5ab5-a826-29c0b2a1b0f9" "answer-d38dddcb-1ba4-546c-9c3c-ddceea90631d" "answer-382e2ac0-f3a8-5ac4-8c61-9c2bc47cefdd" "answer-d9b631b9-b038-5761-ba16-e29cc561bd03" "answer-c90aabe3-00da-5a03-ab00-efa95a2ab8b1"] :db/ensure [:answer-field/validate]} {:db/id "answer-c8532e8f-1e11-5ab5-a826-29c0b2a1b0f9" :answer/id #uuid "c8532e8f-1e11-5ab5-a826-29c0b2a1b0f9" :answer/type :answer.type/math :answer/value "1:5" :db/ensure [:answer/validate]} {:db/id "answer-d38dddcb-1ba4-546c-9c3c-ddceea90631d" :answer/id #uuid "d38dddcb-1ba4-546c-9c3c-ddceea90631d" :answer/type :answer.type/math :answer/value "2:5" :db/ensure [:answer/validate]} {:db/id "answer-382e2ac0-f3a8-5ac4-8c61-9c2bc47cefdd" :answer/id #uuid "382e2ac0-f3a8-5ac4-8c61-9c2bc47cefdd" :answer/type :answer.type/math :answer/value "3:1" :db/ensure [:answer/validate]} {:db/id "answer-d9b631b9-b038-5761-ba16-e29cc561bd03" :answer/id #uuid "d9b631b9-b038-5761-ba16-e29cc561bd03" :answer/type :answer.type/math :answer/value "4:1" :db/ensure [:answer/validate]} {:db/id "answer-c90aabe3-00da-5a03-ab00-efa95a2ab8b1" :answer/id #uuid "c90aabe3-00da-5a03-ab00-efa95a2ab8b1" :answer/type :answer.type/math :answer/value "5:1" :db/ensure [:answer/validate]} {:db/id "question-27c27f4e-31e8-5cd4-984c-7b21ba6ab49b" :question/id #uuid "27c27f4e-31e8-5cd4-984c-7b21ba6ab49b" :question/math-academy-id "q-60321" :question/problem "![](images/7d/7dca3b5a6206733052e8f74139ca4d0cc7d6cd38d8553b1736580c5eed0c64a6.png)\n\nSteven is making french bread. The amount of water he needs for a given amount of flour is given in the graph above. In its simplest form, what is the ratio of flour to water?" :question/worked-solution "One of the points belonging to the graph is $(24,10).$\n\nLet's write the ratio $24:10$ as a fraction:\n\n$$\n\\frac{24}{10}\n$$\n\nWe can simplify this fraction by dividing both the numerator and the denominator by $2$:\n\n$$\n\\begin{aligned}\\frac{24÷2}{10÷2} & =\\frac{12}{5}\\end{aligned}\n$$\n\nSo the ratio of flour to water is $12:5$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-5c716cb7-4c1e-5533-b413-9a53c24009a1"] :db/ensure [:question/validate]} {:db/id "answer-field-5c716cb7-4c1e-5533-b413-9a53c24009a1" :answer-field/id #uuid "5c716cb7-4c1e-5533-b413-9a53c24009a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a5b831b7-7883-53e6-8753-09c2dedad2bc" :answer-field/choices ["answer-a5b831b7-7883-53e6-8753-09c2dedad2bc" "answer-c9472573-8334-5a62-867a-d019573c2dea" "answer-3bb55b77-e860-5557-9ae9-6c985751c129" "answer-980d0ed3-b054-5be0-b274-826097b2e5a9" "answer-63ef4684-36a0-54bf-909e-a48429e22e3a"] :db/ensure [:answer-field/validate]} {:db/id "answer-a5b831b7-7883-53e6-8753-09c2dedad2bc" :answer/id #uuid "a5b831b7-7883-53e6-8753-09c2dedad2bc" :answer/type :answer.type/math :answer/value "12:5" :db/ensure [:answer/validate]} {:db/id "answer-c9472573-8334-5a62-867a-d019573c2dea" :answer/id #uuid "c9472573-8334-5a62-867a-d019573c2dea" :answer/type :answer.type/math :answer/value "12:7" :db/ensure [:answer/validate]} {:db/id "answer-3bb55b77-e860-5557-9ae9-6c985751c129" :answer/id #uuid "3bb55b77-e860-5557-9ae9-6c985751c129" :answer/type :answer.type/math :answer/value "15:4" :db/ensure [:answer/validate]} {:db/id "answer-980d0ed3-b054-5be0-b274-826097b2e5a9" :answer/id #uuid "980d0ed3-b054-5be0-b274-826097b2e5a9" :answer/type :answer.type/math :answer/value "16:9" :db/ensure [:answer/validate]} {:db/id "answer-63ef4684-36a0-54bf-909e-a48429e22e3a" :answer/id #uuid "63ef4684-36a0-54bf-909e-a48429e22e3a" :answer/type :answer.type/math :answer/value "8:5" :db/ensure [:answer/validate]} {:db/id 17592186074968 :tutorial/content "Remember that we can place equivalent ratios in a ratio table, like the one below.\n\n| $\\color{blue}x$ | $\\color{red}y$ |\n| --- | --- |\n| $\\color{blue}1$ | $\\color{red}2$ |\n| $\\color{blue}2$ | $\\color{red}4$ |\n| $\\color{blue}4$ | $\\color{red}8$ |\n\nBy setting the values in the left column as $\\color{blue}x$-coordinates and the values in the right column as the corresponding $\\color{red}y$-coordinates, we can graph the points to represent a relationship between the ratios.\n\nIn this case, we have the following ordered pairs: $({\\color{blue}1},{\\color{red}2}),$ $({\\color{blue}2},{\\color{red}4}),$ $({\\color{blue}4},{\\color{red}8}).$\n\nPlotting these points on a coordinate plane, we get the following graph:\n\n![](images/0c/0c4abb8d462730ed9b532feeca1e0a800f5376a978bfc799afb9d9a927ff310d.png)\n\nConnecting the points gives us a straight line! Plotting equivalent ratios will *always* give a straight line. Furthermore, the straight line will *always* pass through the origin $(0,0).$" :db/ensure [:tutorial/validate]} {:db/id 17592186073979 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} {:db/id 17592186152295 :knowledge-point/questions ["question-705623ab-2399-5c72-afa9-e085fef85022" "question-5cc49cd7-e3e4-5fda-91a1-568bc252a9bf"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151899 :question/problem "What number is $40\\%$ greater than $360?$" :question/worked-solution "To find a number $40\\%$ *greater than* $360,$ we apply a new percentage of\n\n$$\n100\\% + 40\\% = 140\\%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n140\\% = \\dfrac{140}{100} = 1.40\n$$\n\nSo, to find a number that is $40\\%$ greater than $360,$ we multiply $360$ by $1.40{:}$\n\n$$\n1.40 \\cdot 360 = 504\n$$\n\nTherefore, the number that is $40\\%$ greater than $360$ is $504.$" :db/ensure [:question/validate]} {:db/id 17592186152296 :knowledge-point/questions ["question-d65902a0-bf9a-594a-840d-574205a14f9e" "question-93d6474a-bde5-548e-95ba-be3229625fd3" "question-46812e7d-8475-5386-b10a-611a622fce90" "question-cb30e5e3-8d9a-5b05-b36b-6bb7841ecb74"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151900 :question/worked-solution "To find the total cost after tax, we apply a $9\\%$ increase to the original price.\n\nIncreasing by $9\\%$ means that we must apply a new percentage of\n\n$$\n100\\% + 9\\% = 109\\% = 1.09\n$$\n\nNow, we multiply the original price by $1.09{:}$\n\n$$\n18 \\times 1.09 = 19.62.\n$$\n\nSo, the total cost after tax is $\\[math]19.62.$" :db/ensure [:question/validate]} {:db/id 17592186152297 :knowledge-point/questions ["question-9940990b-7568-5339-8565-7a872a78726e" "question-8b071ea5-55c1-5e38-adcd-b15bc3028d66"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151901 :question/problem "A number $x$ is $150\\%$ greater than $20.$ Find the value of $x.$" :question/worked-solution "To find a number $150\\%$ *greater than* $20,$ we apply a new percentage of  \n\n$$\n100\\% + 150\\% = 250\\%.\n$$\n\nWe begin by converting our percentage to a decimal:  \n\n$$\n250\\% = \\dfrac{250}{100} = 2.5\n$$\n\nSo, to find a number that is $150\\%$ greater than $20,$ we multiply $20$ by $2.5{:}$  \n\n$$\n2.5 \\cdot 20 = 50\n$$\n\nTherefore, $x = {50}.$" :db/ensure [:question/validate]} {:db/id 17592186152298 :knowledge-point/questions ["question-f47719f0-1c2b-56f4-84a7-999378811070" "question-102c884a-37a0-5477-a486-ce757122c1eb"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186151913 :question/worked-solution "To find this year's gym membership, we apply a $400\\%$ increase to last year's figure.\n\nIncreasing by $400\\%$ means that we must apply a new percentage of\n\n$$\n100\\% + 400\\% = 500\\%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n500\\% = \\dfrac{500}{100} = 5\n$$\n\nNow, we multiply the original amount by $5{:}$\n\n$$\n80 \\times 5 = 400\n$$\n\nSo, the gym has $\\bbox[4pt, border: 1px solid lightgray]{400}$ members this year." :db/ensure [:question/validate]} {:db/id "question-705623ab-2399-5c72-afa9-e085fef85022" :question/id #uuid "705623ab-2399-5c72-afa9-e085fef85022" :question/math-academy-id "q-326506" :question/problem "What number is $12%$ greater than $1,500?$\n\nThe increased number is\n{{field-1}}." :question/worked-solution "To find a number $12%$ *greater than* $1,500,$ we apply a new percentage of\n\n$$\n100%+12%=112%.\n$$\n\nWe convert this percentage to a decimal:\n\n$$\n112%=\\frac{112}{100}=1.12\n$$\n\nNow, we multiply the original number by $1.12:$\n\n$$\n1,500\\times 1.12=1,680\n$$\n\nSo, the number that is $12%$ greater than $1,500$ is $1,680.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-5260b4fa-7404-564c-ac41-f89db9a6d39f"] :db/ensure [:question/validate]} {:db/id "answer-field-5260b4fa-7404-564c-ac41-f89db9a6d39f" :answer-field/id #uuid "5260b4fa-7404-564c-ac41-f89db9a6d39f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "answer-0448abe2-c7e4-557c-8900-42984da500f2" :answer-field/choices ["answer-0448abe2-c7e4-557c-8900-42984da500f2"] :db/ensure [:answer-field/validate]} {:db/id "answer-0448abe2-c7e4-557c-8900-42984da500f2" :answer/id #uuid "0448abe2-c7e4-557c-8900-42984da500f2" :answer/type :answer.type/math :answer/value "1680" :db/ensure [:answer/validate]} {:db/id "question-5cc49cd7-e3e4-5fda-91a1-568bc252a9bf" :question/id #uuid "5cc49cd7-e3e4-5fda-91a1-568bc252a9bf" :question/math-academy-id "q-326497" :question/problem "What number is $45%$ greater than $220?$" :question/worked-solution "To find a number $45%$ *greater than* $220,$ we apply a new percentage of\n\n$$\n100%+45%=145%.\n$$\n\nWe begin by converting the percentage to a decimal:\n\n$$\n145%=\\frac{145}{100}=1.45\n$$\n\nSo, to find a number that is $45%$ greater than $220,$ we multiply $220$ by $1.45:$\n\n$$\n1.45\\cdot 220=319\n$$\n\nTherefore, the number that is $45%$ greater than $220$ is $319.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-7cafc2c0-50f8-57ec-bd66-70366749f43d"] :db/ensure [:question/validate]} {:db/id "answer-field-7cafc2c0-50f8-57e