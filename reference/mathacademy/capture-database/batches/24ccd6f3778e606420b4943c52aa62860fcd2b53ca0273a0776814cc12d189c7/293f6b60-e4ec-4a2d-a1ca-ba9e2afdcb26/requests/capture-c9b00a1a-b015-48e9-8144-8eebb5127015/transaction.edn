answer-670a339f-913d-513b-a28e-c0591f8a972c"] :db/ensure [:answer-field/validate]} {:db/id "answer-c5dbfb27-e377-512a-bccd-c5fa883f50ac" :answer/id #uuid "c5dbfb27-e377-512a-bccd-c5fa883f50ac" :answer/type :answer.type/math :answer/value "2\\,{\\text{in}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-3552d374-b6a6-5cb4-826e-cd13b7f14a9a" :answer/id #uuid "3552d374-b6a6-5cb4-826e-cd13b7f14a9a" :answer/type :answer.type/math :answer/value "8\\,{\\text{in}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-9187f610-fc78-5c7d-965c-d456b5009a1a" :answer/id #uuid "9187f610-fc78-5c7d-965c-d456b5009a1a" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\,{\\text{in}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-d1e17d0a-e9dc-5739-a2dd-6a5048e38238" :answer/id #uuid "d1e17d0a-e9dc-5739-a2dd-6a5048e38238" :answer/type :answer.type/math :answer/value "\\frac{1}{8}\\,{\\text{in}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-670a339f-913d-513b-a28e-c0591f8a972c" :answer/id #uuid "670a339f-913d-513b-a28e-c0591f8a972c" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\,{\\text{in}}^{3}" :db/ensure [:answer/validate]} {:db/id "question-20052714-006e-5cb8-9e42-f681fe3b072f" :question/id #uuid "20052714-006e-5cb8-9e42-f681fe3b072f" :question/math-academy-id "q-107299" :question/problem "Three identical cubic tanks can hold a combined total of $375\\,{\\text{m}}^{3}$ of water.  Find the side length of a single tank." :question/worked-solution "First, we find the volume of one tank:  \n\n$$\n\\frac{375\\,{\\text{m}}^{3}}{3}=125\\,{\\text{m}}^{3}\n$$\n\nNow, we need to find the side length of a single tank.\n\nSince the volume of a cube is \n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the length of a side, we can find $s$ as follows:\n\n$$\ns=\\sqrt[3]{V}=\\sqrt[3]{125}=5\n$$\n\nTherefore, the length of a side is $5\\,\\text{m}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-72e26c69-0806-5cf0-b6e2-a2174a616d79"] :db/ensure [:question/validate]} {:db/id "answer-field-72e26c69-0806-5cf0-b6e2-a2174a616d79" :answer-field/id #uuid "72e26c69-0806-5cf0-b6e2-a2174a616d79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-4b8621c3-6977-5948-b86c-b8688ee5238d" :answer-field/choices ["answer-cf70dc22-eb11-59a8-96a7-db0856889413" "answer-14dca489-0f91-55a0-bf68-7adcf14ccab0" "answer-11f1981b-1d53-55ce-a761-5f166e2082c8" "answer-4b8621c3-6977-5948-b86c-b8688ee5238d" "answer-5827a421-dbc9-5d85-8068-f51fdc703eb2"] :db/ensure [:answer-field/validate]} {:db/id "answer-cf70dc22-eb11-59a8-96a7-db0856889413" :answer/id #uuid "cf70dc22-eb11-59a8-96a7-db0856889413" :answer/type :answer.type/math :answer/value "125\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-14dca489-0f91-55a0-bf68-7adcf14ccab0" :answer/id #uuid "14dca489-0f91-55a0-bf68-7adcf14ccab0" :answer/type :answer.type/math :answer/value "15\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-11f1981b-1d53-55ce-a761-5f166e2082c8" :answer/id #uuid "11f1981b-1d53-55ce-a761-5f166e2082c8" :answer/type :answer.type/math :answer/value "25\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-4b8621c3-6977-5948-b86c-b8688ee5238d" :answer/id #uuid "4b8621c3-6977-5948-b86c-b8688ee5238d" :answer/type :answer.type/math :answer/value "5\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "answer-5827a421-dbc9-5d85-8068-f51fdc703eb2" :answer/id #uuid "5827a421-dbc9-5d85-8068-f51fdc703eb2" :answer/type :answer.type/math :answer/value "7\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "question-db058a82-1fa2-5274-82e0-1236f8c5f86e" :question/id #uuid "db058a82-1fa2-5274-82e0-1236f8c5f86e" :question/math-academy-id "q-107284" :question/problem "A statue is mounted on a pedestal consisting of a cubic block made of concrete. \nEach side of the cube has length  $5\\,\\text{ft}.$ \nWhat is the volume of the cube?" :question/worked-solution "We need to find the volume of a cube.\n\nThe volume $V$ of a cube can be found using the formula\n\n$$\nV={s}^{3},\n$$\n\nwhere $s$ is the side length of the cube.\n\nSubstituting $s=5\\,\\text{ft}$ into the formula, we get \n\n$$\nV={(5\\,\\text{ft})}^{3}=125\\,{\\text{ft}}^{3}.\n$$\n\nTherefore, the volume of the pedestal is $125\\,{\\text{ft}}^{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["answer-field-eea170cf-041d-5502-8a64-b7754c482b33"] :db/ensure [:question/validate]} {:db/id "answer-field-eea170cf-041d-5502-8a64-b7754c482b33" :answer-field/id #uuid "eea170cf-041d-5502-8a64-b7754c482b33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-d3e97164-f1d9-5bb8-a576-332346139f1e" :answer-field/choices ["answer-d3e97164-f1d9-5bb8-a576-332346139f1e" "answer-11990872-3a08-59a2-ae15-43f9da89dfd3" "answer-3ffb3373-35a3-5250-ada2-c24c626269af" "answer-087adab2-ea54-569c-8686-59d39bb1e022" "answer-67feacb2-a15e-5e1a-b7b8-79bd8e12be90"] :db/ensure [:answer-field/validate]} {:db/id "answer-d3e97164-f1d9-5bb8-a576-332346139f1e" :answer/id #uuid "d3e97164-f1d9-5bb8-a576-332346139f1e" :answer/type :answer.type/math :answer/value "125\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-11990872-3a08-59a2-ae15-43f9da89dfd3" :answer/id #uuid "11990872-3a08-59a2-ae15-43f9da89dfd3" :answer/type :answer.type/math :answer/value "175\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-3ffb3373-35a3-5250-ada2-c24c626269af" :answer/id #uuid "3ffb3373-35a3-5250-ada2-c24c626269af" :answer/type :answer.type/math :answer/value "25\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-087adab2-ea54-569c-8686-59d39bb1e022" :answer/id #uuid "087adab2-ea54-569c-8686-59d39bb1e022" :answer/type :answer.type/math :answer/value "50\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id "answer-67feacb2-a15e-5e1a-b7b8-79bd8e12be90" :answer/id #uuid "67feacb2-a15e-5e1a-b7b8-79bd8e12be90" :answer/type :answer.type/math :answer/value "75\\,{\\text{ft}}^{3}" :db/ensure [:answer/validate]} {:db/id 17592186111891 :tutorial/content "Suppose that we have a cube whose edges are $2\\,\\textrm{cm}$ in length, like the one shown below. \n\n![](images/b9/b974b6e782801fbe2099971afd0df9a5c6e05a10afc2ce0e4054c850088e753b.png)\n\nThe formula for the volume $V$ of a cube with sides of length $s$ is given by\n\n$$\nV = s^3.\n$$\n\nTo find the volume of this cube, we substitute $s=2 \\: \\textrm{cm}$ into the formula. This gives\n\n$$\nV = (2\\, \\textrm{cm})^3 = 8 \\text{ cm}^3 .\n$$\n\nSo the volume of the cube is $8\\,\\textrm{cm}^3.$" :db/ensure [:tutorial/validate]} {:db/id 17592186110837 :activity/expected-seconds 420.0 :db/ensure [:activity/validate]} [:db/retract 17592186175186 :answer-field/choices 17592186175188] [:db/retract 17592186175186 :answer-field/choices 17592186175189] [:db/retract 17592186175186 :answer-field/choices 17592186175190] [:db/retract 17592186175198 :answer-field/choices 17592186175200] [:db/retract 17592186175198 :answer-field/choices 17592186175203] {:db/id 17592186175950 :knowledge-point/questions ["question-9b70f694-75c4-56a5-8060-3f93ae37aa40" "question-c45730a9-37f0-5369-8e28-cf166dacf491" "question-2f5058c8-bee4-550a-9863-d36cd2227082"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175806 :question/problem "What is the sum of the series $\\dfrac{\\pi}{3} - \\dfrac{(\\pi/3)^3}{3!} + \\dfrac{(\\pi/3)^5}{5!}-\\cdots + \\dfrac{(-1)^{n}(\\pi/3)^{2n+1}}{(2n+1)!}+\\cdots\\,?$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x) = \\sin x.$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯\\,\\end{aligned}\n$$\n\nSubstituting $x=\\dfrac{\\pi}{3}$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{3}) & =\\frac{\\pi }{3}-\\frac{(\\pi /3)^{3}}{3!}+\\frac{(\\pi /3)^{5}}{5!}-⋯+\\frac{(-1)^{n}(\\pi /3)^{2n+1}}{(2n+1)!}+⋯ \\\\ \\frac{\\sqrt{3}}{2} & =\\frac{\\pi }{3}-\\frac{(\\pi /3)^{3}}{3!}+\\frac{(\\pi /3)^{5}}{5!}-⋯+\\frac{(-1)^{n}(\\pi /3)^{2n+1}}{(2n+1)!}+⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $\\dfrac{\\sqrt{3}}{2}.$" :db/ensure [:question/validate]} {:db/id 17592186175951 :knowledge-point/questions ["question-38c8627e-3005-599a-a37a-fb4e0aa52cad" "question-3922f3d0-9ec0-55ed-b2ff-7790813baa5b" "question-b939d5df-d459-5fd4-9292-d3dcc1c6afac" "question-b2664ee6-8acb-52ad-889d-ed63a283e637" "question-6b7d68eb-3099-57db-9579-cc9c26274e37"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186175807 :question/problem "Find the sum $1 - \\dfrac{9}{2!} + \\dfrac{81}{4!}-\\cdots + \\dfrac{(-1)^{n}3^{2n}}{(2n)!} \\,\\cdots \\,.$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x) = \\cos x.$ \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x=1-\\frac{1}{2!}{x}^{2}+\\frac{1}{4!}{x}^{4}-⋯+\\frac{(-1)^{n}\\,{x}^{2n}}{(2n)!}+⋯\\end{aligned}\n$$\n\nSubstituting $x=3$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(3) & =1-\\frac{{3}^{2}}{2!}+\\frac{{3}^{4}}{4!}-⋯+\\frac{(-1)^{n}{3}^{2n}}{(2n)!}\\,⋯ \\\\ \\operatorname{cos}⁡(3) & =1-\\frac{9}{2!}+\\frac{81}{4!}-⋯+\\frac{(-1)^{n}{3}^{2n}}{(2n)!}\\,⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $\\cos(3).$" :db/ensure [:question/validate]} {:db/id 17592186176508 :question/problem "What is the sum of the series $-2+\\frac{8}{3!}-\\frac{32}{5!}+⋯+\\frac{(-1)^{n}(-2)^{2n+1}}{(2n+1)!}+⋯\\,?$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x)=\\operatorname{sin}⁡x.$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯\\end{aligned}\n$$\n\nSubstituting $x=-2$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(-2) & =(-2)-\\frac{(-2)^{3}}{3!}+\\frac{(-2)^{5}}{5!}-⋯+\\frac{(-1)^{n}(-2)^{2n+1}}{(2n+1)!}+⋯ \\\\ -\\operatorname{sin}⁡2 & =-2+\\frac{8}{3!}-\\frac{32}{5!}+⋯+\\frac{(-1)^{n}(-2)^{2n+1}}{(2n+1)!}+⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $-\\operatorname{sin}⁡2.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id 17592186175186 :answer-field/correct "answer-5e61150a-84ad-5188-bc70-0933b2f92e71" :answer-field/choices ["answer-5e61150a-84ad-5188-bc70-0933b2f92e71" "answer-1c0c8ec8-308a-5fdc-8743-e14424b39b08" "answer-b1c1318f-c6a4-5e1b-8cbc-40f5c4a41b1a"] :db/ensure [:answer-field/validate]} {:db/id "answer-5e61150a-84ad-5188-bc70-0933b2f92e71" :answer/id #uuid "5e61150a-84ad-5188-bc70-0933b2f92e71" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-1c0c8ec8-308a-5fdc-8743-e14424b39b08" :answer/id #uuid "1c0c8ec8-308a-5fdc-8743-e14424b39b08" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2" :db/ensure [:answer/validate]} {:db/id "answer-b1c1318f-c6a4-5e1b-8cbc-40f5c4a41b1a" :answer/id #uuid "b1c1318f-c6a4-5e1b-8cbc-40f5c4a41b1a" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡2" :db/ensure [:answer/validate]} {:db/id "question-9b70f694-75c4-56a5-8060-3f93ae37aa40" :question/id #uuid "9b70f694-75c4-56a5-8060-3f93ae37aa40" :question/math-academy-id "q-103098" :question/problem "What is the sum of the series $\\frac{5\\pi }{6}-\\frac{(5\\pi /6)^{3}}{3!}+\\frac{(5\\pi /6)^{5}}{5!}-⋯+\\frac{(-1)^{n}(5\\pi /6)^{2n+1}}{(2n+1)!}+⋯\\,?$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x)=\\operatorname{sin}⁡x.$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯\\end{aligned}\n$$\n\nSubstituting $x=\\frac{5\\pi }{6}$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{5\\pi }{6}) & =\\frac{5\\pi }{6}-\\frac{(5\\pi /6)^{3}}{3!}+\\frac{(5\\pi /6)^{5}}{5!}-⋯+\\frac{(-1)^{n}(5\\pi /6)^{2n+1}}{(2n+1)!}+⋯ \\\\ \\frac{1}{2} & =\\frac{5\\pi }{6}-\\frac{(5\\pi /6)^{3}}{3!}+\\frac{(5\\pi /6)^{5}}{5!}-⋯+\\frac{(-1)^{n}(5\\pi /6)^{2n+1}}{(2n+1)!}+⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-ccbfad55-03ca-511b-aff7-effb313d79ab"] :db/ensure [:question/validate]} {:db/id "answer-field-ccbfad55-03ca-511b-aff7-effb313d79ab" :answer-field/id #uuid "ccbfad55-03ca-511b-aff7-effb313d79ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-8022af58-b7b6-5f7d-b6df-8a0168170bbd" :answer-field/choices ["answer-3286958d-7c74-5b1d-87b0-93f4fb2b3417" "answer-058b950b-7211-5b63-a8ef-ca5da43d6e22" "answer-d6ca12e2-aa98-5c4a-ba2d-ac826140d46c" "answer-8022af58-b7b6-5f7d-b6df-8a0168170bbd" "answer-b8c58dde-7497-55fd-9509-60437b98844f"] :db/ensure [:answer-field/validate]} {:db/id "answer-3286958d-7c74-5b1d-87b0-93f4fb2b3417" :answer/id #uuid "3286958d-7c74-5b1d-87b0-93f4fb2b3417" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-058b950b-7211-5b63-a8ef-ca5da43d6e22" :answer/id #uuid "058b950b-7211-5b63-a8ef-ca5da43d6e22" :answer/type :answer.type/math :answer/value "\\frac{1+\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-d6ca12e2-aa98-5c4a-ba2d-ac826140d46c" :answer/id #uuid "d6ca12e2-aa98-5c4a-ba2d-ac826140d46c" :answer/type :answer.type/math :answer/value "\\frac{1-\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "answer-8022af58-b7b6-5f7d-b6df-8a0168170bbd" :answer/id #uuid "8022af58-b7b6-5f7d-b6df-8a0168170bbd" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-b8c58dde-7497-55fd-9509-60437b98844f" :answer/id #uuid "b8c58dde-7497-55fd-9509-60437b98844f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id 17592186176510 :question/problem "What is the sum of the series $\\frac{\\pi }{4}-\\frac{(\\pi /4)^{3}}{3!}+\\frac{(\\pi /4)^{5}}{5!}-⋯+\\frac{(-1)^{n}(\\pi /4)^{2n+1}}{(2n+1)!}+⋯\\,?$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x)=\\operatorname{sin}⁡x.$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯\\end{aligned}\n$$\n\nSubstituting $x=\\frac{\\pi }{4}$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{\\pi }{4}) & =\\frac{\\pi }{4}-\\frac{(\\pi /4)^{3}}{3!}+\\frac{(\\pi /4)^{5}}{5!}-\\frac{(\\pi /4)^{7}}{7!}+⋯+\\frac{(-1)^{n}(\\pi /4)^{2n+1}}{(2n+1)!}+⋯ \\\\ \\frac{\\sqrt{2}}{2} & =\\frac{\\pi }{4}-\\frac{(\\pi /4)^{3}}{3!}+\\frac{(\\pi /4)^{5}}{5!}-\\frac{(\\pi /4)^{7}}{7!}+⋯+\\frac{(-1)^{n}(\\pi /4)^{2n+1}}{(2n+1)!}+⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $\\frac{\\sqrt{2}}{2}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186175198 :answer-field/correct 17592186175199 :answer-field/choices ["answer-50ea6359-ff35-5d40-ae48-09e30c47874b" "answer-aba32c7c-b27a-52b9-8eda-752f04c9f073"] :db/ensure [:answer-field/validate]} {:db/id "answer-50ea6359-ff35-5d40-ae48-09e30c47874b" :answer/id #uuid "50ea6359-ff35-5d40-ae48-09e30c47874b" :answer/type :answer.type/math :answer/value "\\frac{4}{4+\\pi }" :db/ensure [:answer/validate]} {:db/id "answer-aba32c7c-b27a-52b9-8eda-752f04c9f073" :answer/id #uuid "aba32c7c-b27a-52b9-8eda-752f04c9f073" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "question-c45730a9-37f0-5369-8e28-cf166dacf491" :question/id #uuid "c45730a9-37f0-5369-8e28-cf166dacf491" :question/math-academy-id "q-83287" :question/problem "What is the sum of the series $-3+\\frac{27}{3!}-\\frac{243}{5!}+⋯+\\frac{(-1)^{n}(-3)^{2n+1}}{(2n+1)!}+⋯\\,?$" :question/worked-solution "We recognize that the series looks similar to the Maclaurin expansion for $f(x)=\\operatorname{sin}⁡x.$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯+\\frac{(-1)^{n}{x}^{2n+1}}{(2n+1)!}+⋯\\end{aligned}\n$$\n\nSubstituting $x=-3$ into our Maclaurin expansion gives\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(-3) & =(-3)-\\frac{(-3)^{3}}{3!}+\\frac{(-3)^{5}}{5!}-⋯+\\frac{(-1)^{n}(-3)^{2n+1}}{(2n+1)!}+⋯ \\\\ -\\operatorname{sin}⁡3 & =-3+\\frac{27}{3!}-\\frac{243}{5!}+⋯+\\frac{(-1)^{n}(-3)^{2n+1}}{(2n+1)!}+⋯\\,.\\end{aligned}\n$$\n\nTherefore, the sum of the series is $-\\operatorname{sin}⁡3.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["answer-field-94017fed-3225-5f77-832c-3c6c4815c2e2"] :db/ensure [:question/validate]} {:db/id "answer-field-94017fed-3225-5f77-832c-3c6c4815c2e2" :answer-field/id #uuid "94017fed-3225-5f77-832c-3c6c4815c2e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-a53739e3-54c5-504e-b80e-c0b9e9d957ce" :answer-field/choices ["answer-a63e6faf-3df0-54ab-ad7d-d858e5ee7adc" "answer-a53739e3-54c5-504e-b80e-c0b9e9d957ce" "answer-95d5509d-8326-5478-85bd-2640737f3409" "answer-998c4330-f85f-5d8e-8754-9eafbab12bb1" "answer-4dce155a-cd12-5fa4-bab7-584e134737fe"] :db/ensure [:answer-field/validate]} {:db/id "answer-a63e6faf-3df0-54ab-ad7d-d858e5ee7adc" :answer/id #uuid "a63e6faf-3df0-54ab-ad7d-d858e5ee7adc" :answer/type :answer.type/math :answer/value "-\\operatorname{ln}⁡3" :db/ensure [:answer/validate]} {:db/id "answer-a53739e3-54c5-504e-b80e-c0b9e9d957ce" :answer/id #uuid "a53739e3-54c5-504e-b80e-c0b9e9d957ce" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡3" :db/ensure [:answer/validate]} {:db/id "answer-95d5509d-8326-5478-85bd-2640737f3409" :answer/id #uuid "95d5509d-