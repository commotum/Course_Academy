6a6-dd27260cc293"] :db/ensure [:answer-field/validate]} {:db/id "answer-72d127bd-5e0a-5c74-94ac-2c6909f28a93" :answer/id #uuid "72d127bd-5e0a-5c74-94ac-2c6909f28a93" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(2x-1)+C" :db/ensure [:answer/validate]} {:db/id "answer-60839b68-ba6a-5ca4-9372-aa8141e0fac8" :answer/id #uuid "60839b68-ba6a-5ca4-9372-aa8141e0fac8" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(x-1)+C" :db/ensure [:answer/validate]} {:db/id "answer-6a5d6620-1229-5c0a-b17a-410aefc033ef" :answer/id #uuid "6a5d6620-1229-5c0a-b17a-410aefc033ef" :answer/type :answer.type/math :answer/value "2\\operatorname{arcsch}⁡(x-1)+C" :db/ensure [:answer/validate]} {:db/id "answer-473cfe94-aab2-5f0a-860b-299dd85f38a9" :answer/id #uuid "473cfe94-aab2-5f0a-860b-299dd85f38a9" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcsch}⁡(2x-2)+C" :db/ensure [:answer/validate]} {:db/id "answer-179d2d9f-3689-587a-b6a6-dd27260cc293" :answer/id #uuid "179d2d9f-3689-587a-b6a6-dd27260cc293" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arsech}⁡(x-1)+C" :db/ensure [:answer/validate]} {:db/id 17592186167518 :question/problem "$\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}+2x+4 & =-({x}^{2}-2x-4) \\\\  & =-({x}^{2}-2\\cdot x+{1}^{2}-{1}^{2}-4) \\\\  & =-((x-1)^{2}-5) \\\\  & =5-(x-1)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}} & =\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{5-{(x-1)}^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{5-5{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{1-{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x.\\end{aligned}\n$$\n\nLet $u=\\frac{x-1}{\\sqrt{5}}.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{5}}\\,⟹\\,\\text{d}x=\\sqrt{5}\\,\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{5}}{(x-1)\\sqrt{4+2x-{x}^{2}}}\\text{d}x & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{(\\frac{x-1}{\\sqrt{5}})\\sqrt{1-{(\\frac{x-1}{\\sqrt{5}})}^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{5}}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\cdot \\sqrt{5}\\,\\text{d}u \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186166316 :answer-field/correct "answer-0b113bca-9912-5f35-96fa-95493e21f318" :answer-field/choices ["answer-6d80edc0-9454-51f1-b687-a8321c5ca78a" "answer-0b113bca-9912-5f35-96fa-95493e21f318" "answer-005434de-0921-503b-a0e7-54592318d301" "answer-3609cd87-57e2-52fc-984f-43d3f16611ad" "answer-682ec881-b5df-5663-8b1e-5632a85fd8d1"] :db/ensure [:answer-field/validate]} {:db/id "answer-6d80edc0-9454-51f1-b687-a8321c5ca78a" :answer/id #uuid "6d80edc0-9454-51f1-b687-a8321c5ca78a" :answer/type :answer.type/math :answer/value "-\\frac{1}{\\sqrt{5}}\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/ensure [:answer/validate]} {:db/id "answer-0b113bca-9912-5f35-96fa-95493e21f318" :answer/id #uuid "0b113bca-9912-5f35-96fa-95493e21f318" :answer/type :answer.type/math :answer/value "-\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/ensure [:answer/validate]} {:db/id "answer-005434de-0921-503b-a0e7-54592318d301" :answer/id #uuid "005434de-0921-503b-a0e7-54592318d301" :answer/type :answer.type/math :answer/value "-\\sqrt{5}\\operatorname{arsech}⁡(\\frac{x-1}{\\sqrt{5}})+C" :db/ensure [:answer/validate]} {:db/id "answer-3609cd87-57e2-52fc-984f-43d3f16611ad" :answer/id #uuid "3609cd87-