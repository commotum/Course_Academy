4x-3}}\\text{d}x=\\int \\frac{1}{(x+2)\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x+2.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(x+2)\\sqrt{-{x}^{2}-4x-3}}\\text{d}x & =\\int \\frac{1}{(x+2)\\sqrt{1-(x+2)^{2}}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\operatorname{arsech}⁡u+C \\\\  & =-\\operatorname{arsech}⁡(x+2)+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id 17592186165818 :answer-field/correct "answer-c31853a1-e8da-5202-9065-d951a7fc96c6" :answer-field/choices ["answer-4ef7868e-725c-539b-b28e-4d383bd7c386" "answer-7263808f-4625-51b4-92b6-c4116a2a33ce" "answer-0aafb802-86f0-5b89-a926-41ff9b53eb26" "answer-c31853a1-e8da-5202-9065-d951a7fc96c6" "answer-71bc69fb-a846-5e4b-b3dd-1c0493f3cf93"] :db/ensure [:answer-field/validate]} {:db/id "answer-4ef7868e-725c-539b-b28e-4d383bd7c386" :answer/id #uuid "4ef7868e-725c-539b-b28e-4d383bd7c386" :answer/type :answer.type/math :answer/value "-2\\operatorname{arsech}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-7263808f-4625-51b4-92b6-c4116a2a33ce" :answer/id #uuid "7263808f-4625-51b4-92b6-c4116a2a33ce" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arcsch}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-0aafb802-86f0-5b89-a926-41ff9b53eb26" :answer/id #uuid "0aafb802-86f0-5b89-a926-41ff9b53eb26" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}\\operatorname{arsech}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-c31853a1-e8da-5202-9065-d951a7fc96c6" :answer/id #uuid "c31853a1-e8da-5202-9065-d951a7fc96c6" :answer/type :answer.type/math :answer/value "-\\operatorname{arsech}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "answer-71bc69fb-a846-5e4b-b3dd-1c0493f3cf93" :answer/id #uuid "71bc69fb-a846-5e4b-b3dd-1c0493f3cf93" :answer/type :answer.type/math :answer/value "\\operatorname{arcsch}⁡(x+2)+C" :db/ensure [:answer/validate]} {:db/id "question-6858ad14-b7bc-531f-aa86-afb1603436a5" :question/id #uuid "6858ad14-b7bc-531f-aa86-afb1603436a5" :question/math-academy-id "q-97778" :question/problem "$\\int \\frac{1}{(3x-15)\\sqrt{10x-{x}^{2}-24}}\\text{d}x=$" :question/worked-solution "First, we complete the square for the argument of the square root in the denominator:\n\n$$\n\\begin{aligned}-{x}^{2}+10x-24 & =-({x}^{2}-10x+24) \\\\  & =-({x}^{2}-2\\cdot 5x+{5}^{2}-{5}^{2}+24) \\\\  & =-((x-5)^{2}-1) \\\\  & =1-(x-5)^{2}\\end{aligned}\n$$\n\nSubstituting the above into the given integral, we get\n\n$$\n\\int \\frac{1}{(3x-15)\\sqrt{10x-{x}^{2}-24}}\\text{d}x=\\frac{1}{3}\\int \\frac{1}{(x-5)\\sqrt{1-(x-5)^{2}}}\\,\\text{d}x.\n$$\n\nLet $u=x-5.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{(3x-15)\\sqrt{10x-{x}^{2}-24}}\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{(x-5)\\sqrt{1-(x-5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{u\\sqrt{1-{u}^{2}}}\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡u+C \\\\  & =-\\frac{1}{3}\\operatorname{arsech}⁡(x-5)+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["answer-field-52950305-513b-5afd-924b-10249cc71603"] :db/ensure [:question/validate]} {:db/id "answer-field-52950305-513b-5afd-924b-10249cc71603" :answer-field/id #uuid "52950305-513b-5afd-924b-10249cc71603" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-03a0fc46-b048-5a4e-895a-4978ef9feb4c" :answer-field/choices ["answer-03a0fc46-b048-5a4e-895a-4978ef9feb4c" "answer-052a6ce6-06ec-5a50-b5a8-3b1ef0e36408" "answer-06b9e609-4482-5d45-9ff1-d52de7ae485b" "answer-87a67db4-88da-5cec-af36-b1f00cf5bec6" "answer-ce39a028-f8ca-55ac-ad95-0b53b700d16b"] :db/ensure [:answer-fi